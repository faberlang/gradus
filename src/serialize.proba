# Co-located package test for serialize.fab (PML1-U7 serialization
# contract).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the versioned bytes wire format (schema
# serialize-schema-1.0.0) — dtype/shape/tensor/parameter round-trips,
# version rejection (unknown magic/schema byte), kind rejection, malformed
# payload rejection (truncation, trailing bytes, bad fields, bad tokens),
# and the wire-format lock (exact bytes for the fixed-width header).
# adfirma assertions run under the `faber test` harness (auditor-owned;
# stepper execution of genus-bearing proba code is a documented compiler-
# lane gap — the assertions are proven type-level here and at audit).

importa ex "gradus:serialize" privata serializa

# -- helpers ---------------------------------------------------------------

# Byte values → octeti wire (hand-built payloads lock the wire format).
functio bytes(lista<numerus> vals) → octeti {
    varia lista<numerus<u8>> bs ← vacua
    itera ex vals fixum v {
        bs.appende(v ↦ numerus<u8>)
    }
    fixum octeti o ← bs
    redde o
}

# Dimension vector → comma-joined textus (round-trip comparison surface).
functio forma_a_textus(lista<numerus> f) → textus {
    varia textus out ← ""
    varia numerus i ← 0
    dum i < f.longitudo() {
        si i > 0 {
            out ← out + ","
        }
        fixum numerus v ← f.accipe(i) vel 0
        out ← out + (v ↦ textus)
        i ← i + 1
    }
    redde out
}

# Flat float data → pipe-joined textus (round-trip comparison surface).
functio datos_a_textus(lista<f32> d) → textus {
    varia textus out ← ""
    varia numerus i ← 0
    dum i < d.longitudo() {
        si i > 0 {
            out ← out + "|"
        }
        fixum f32 v ← d.accipe(i) vel 0.0
        out ← out + (v ↦ textus)
        i ← i + 1
    }
    redde out
}

# dtype: serialize → deserialize → canonical nomen, or the error causa.
functio dtype_ok(textus typo) → textus {
    fac {
        fixum octeti w ← serializa.serializa_dtype(typo)
        redde serializa.deserializa_dtype(w)
    }
    cape err {
        redde serializa.causa(err)
    }
}

# dtype: deserialize a hand-built wire, or the error causa.
functio dtype_err(octeti w) → textus {
    fac {
        redde serializa.deserializa_dtype(w)
    }
    cape err {
        redde serializa.causa(err)
    }
}

# shape: serialize → deserialize → rendered shape, or the error causa.
functio shape_ok(lista<numerus> f) → textus {
    fac {
        fixum octeti w ← serializa.serializa_shape(f)
        fixum lista<numerus> back ← serializa.deserializa_shape(w)
        redde forma_a_textus(back)
    }
    cape err {
        redde serializa.causa(err)
    }
}

# shape: serialize-side rejection, or "ok" + length on success.
functio shape_ser_err(lista<numerus> f) → textus {
    fac {
        fixum octeti w ← serializa.serializa_shape(f)
        redde (w.longitudo() ↦ textus)
    }
    cape err {
        redde serializa.causa(err)
    }
}

# shape: deserialize a hand-built wire, or the error causa.
functio shape_err(octeti w) → textus {
    fac {
        fixum lista<numerus> back ← serializa.deserializa_shape(w)
        redde forma_a_textus(back)
    }
    cape err {
        redde serializa.causa(err)
    }
}

# tensor: serialize → deserialize → rendered value, or the error causa.
functio tensor_ok(lista<f32> datos, lista<numerus> forma, textus typo) → textus {
    fac {
        fixum octeti w ← serializa.serializa_tensor(datos, forma, typo)
        fixum serializa.Tensum t ← serializa.deserializa_tensor(w)
        redde t.typo() + "|" + forma_a_textus(t.figura()) + "|" + datos_a_textus(t.datos())
    }
    cape err {
        redde serializa.causa(err)
    }
}

# tensor: serialize-side rejection.
functio tensor_ser_err(lista<f32> datos, lista<numerus> forma, textus typo) → textus {
    fac {
        fixum octeti w ← serializa.serializa_tensor(datos, forma, typo)
        redde "ok"
    }
    cape err {
        redde serializa.causa(err)
    }
}

# tensor: deserialize a hand-built wire, or the error causa.
functio tensor_err(octeti w) → textus {
    fac {
        fixum serializa.Tensum t ← serializa.deserializa_tensor(w)
        redde t.typo()
    }
    cape err {
        redde serializa.causa(err)
    }
}

# parameter: serialize → deserialize → rendered value, or the error causa.
functio parametrum_ok(textus nomen, textus possessor, textus typo, lista<numerus> forma, numerus versio, textus statio, lista<f32> datos) → textus {
    fac {
        fixum octeti w ← serializa.serializa_parametrum(nomen, possessor, typo, forma, versio, statio, datos)
        fixum serializa.ParametrumWire p ← serializa.deserializa_parametrum(w)
        redde p.nomen() + "|" + p.possessor() + "|" + p.typo() + "|" + forma_a_textus(p.figura()) + "|" + (p.versio() ↦ textus) + "|" + p.statium() + "|" + datos_a_textus(p.datos())
    }
    cape err {
        redde serializa.causa(err)
    }
}

# parameter: serialize-side rejection.
functio parametrum_ser_err(textus nomen, textus possessor, textus typo, lista<numerus> forma, numerus versio, textus statio, lista<f32> datos) → textus {
    fac {
        fixum octeti w ← serializa.serializa_parametrum(nomen, possessor, typo, forma, versio, statio, datos)
        redde "ok"
    }
    cape err {
        redde serializa.causa(err)
    }
}

# parameter: deserialize a hand-built wire, or the error causa.
functio parametrum_err(octeti w) → textus {
    fac {
        fixum serializa.ParametrumWire p ← serializa.deserializa_parametrum(w)
        redde p.nomen()
    }
    cape err {
        redde serializa.causa(err)
    }
}

# -- wire format lock ------------------------------------------------------

probandum "serialize wire format" {
    proba "dtype wire is the 5-byte versioned header + tag" {
        fac {
            fixum octeti w ← serializa.serializa_dtype("f32")
            adfirma w.longitudo() ≡ 5
            adfirma (w.accipe(0) vel (0 ∷ numerus<u8>)) ≡ (0x53 ∷ numerus<u8>)
            adfirma (w.accipe(1) vel (0 ∷ numerus<u8>)) ≡ (0x46 ∷ numerus<u8>)
            adfirma (w.accipe(2) vel (0 ∷ numerus<u8>)) ≡ (0x01 ∷ numerus<u8>)
            adfirma (w.accipe(3) vel (0 ∷ numerus<u8>)) ≡ (0x01 ∷ numerus<u8>)
            adfirma (w.accipe(4) vel (0 ∷ numerus<u8>)) ≡ (0x00 ∷ numerus<u8>)
            fixum octeti u ← serializa.serializa_dtype("u8")
            adfirma (u.accipe(4) vel (0 ∷ numerus<u8>)) ≡ (0x03 ∷ numerus<u8>)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "shape wire is header + rank + 8-byte dims" {
        fac {
            fixum octeti w ← serializa.serializa_shape([2, 3])
            adfirma w.longitudo() ≡ 21
        }
        cape err {
            adfirma falsum
        }
    }
}

# -- dtype round-trip and rejection ----------------------------------------

probandum "dtype serialization" {
    proba "every dtype round-trips" {
        adfirma dtype_ok("f32") ≡ "f32"
        adfirma dtype_ok("f16") ≡ "f16"
        adfirma dtype_ok("i32") ≡ "i32"
        adfirma dtype_ok("u8") ≡ "u8"
    }

    proba "serialization rejects an unknown dtype name" {
        adfirma dtype_ok("q8") ≡ "unknown dtype name: q8"
    }

    proba "deserialization rejects an unknown schema version" {
        adfirma dtype_err(bytes([0x53, 0x46, 0x02, 0x01, 0x00])) ≡ "unknown serialize schema version"
        adfirma dtype_err(bytes([0x53, 0x46, 0x09, 0x01, 0x00])) ≡ "unknown serialize schema version"
    }

    proba "deserialization rejects unknown magic" {
        adfirma dtype_err(bytes([0x41, 0x42, 0x01, 0x01, 0x00])) ≡ "unknown serialize magic"
    }

    proba "deserialization rejects an unknown kind" {
        adfirma dtype_err(bytes([0x53, 0x46, 0x01, 0x09, 0x00])) ≡ "unknown serialize kind"
    }

    proba "deserialization rejects a truncated header" {
        adfirma dtype_err(bytes([0x53, 0x46, 0x01])) ≡ "truncated header"
        adfirma dtype_err(bytes([])) ≡ "truncated header"
    }

    proba "deserialization rejects an unknown dtype tag" {
        adfirma dtype_err(bytes([0x53, 0x46, 0x01, 0x01, 0x09])) ≡ "unknown dtype tag"
    }

    proba "deserialization rejects a malformed dtype payload" {
        adfirma dtype_err(bytes([0x53, 0x46, 0x01, 0x01, 0x00, 0x00])) ≡ "malformed dtype payload"
    }
}

# -- shape round-trip and rejection ----------------------------------------

probandum "shape serialization" {
    proba "shapes round-trip" {
        adfirma shape_ok([]) ≡ ""
        adfirma shape_ok([2]) ≡ "2"
        adfirma shape_ok([2, 3]) ≡ "2,3"
        adfirma shape_ok([1, 2, 3, 4]) ≡ "1,2,3,4"
        adfirma shape_ok([65536]) ≡ "65536"
    }

    proba "serialization rejects negative dimensions" {
        adfirma shape_ser_err([-1]) ≡ "negative dimension"
    }

    proba "dims above 65536 serialize and round-trip (no per-dimension cap)" {
        adfirma shape_ok([65537]) ≡ "65537"
        adfirma shape_ok([131072]) ≡ "131072"
        adfirma shape_ok([152064]) ≡ "152064"
    }

    proba "serialization rejects an element count above the ceiling" {
        adfirma shape_ser_err([65536, 65536]) ≡ "element count above ceiling"
    }

    proba "serialization rejects a rank above the ceiling" {
        varia lista<numerus> big ← vacua
        varia numerus k ← 0
        dum k < 65 {
            big.appende(1)
            k ← k + 1
        }
        adfirma shape_ser_err(big) ≡ "rank above ceiling"
    }

    proba "deserialization rejects an unknown schema version and kind" {
        adfirma shape_err(bytes([0x53, 0x46, 0x02, 0x02, 0x00])) ≡ "unknown serialize schema version"
        adfirma shape_err(bytes([0x53, 0x46, 0x01, 0x09, 0x00])) ≡ "unknown serialize kind"
    }

    proba "deserialization rejects a rank above the ceiling" {
        adfirma shape_err(bytes([0x53, 0x46, 0x01, 0x02, 0x41])) ≡ "rank above ceiling"
    }

    proba "deserialization rejects a negative dimension" {
        adfirma shape_err(bytes([0x53, 0x46, 0x01, 0x02, 0x01, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01])) ≡ "negative dimension"
    }

    proba "deserialization accepts a dimension above 65536" {
        adfirma shape_err(bytes([0x53, 0x46, 0x01, 0x02, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01])) ≡ "65537"
        adfirma shape_err(bytes([0x53, 0x46, 0x01, 0x02, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x52, 0x00])) ≡ "152064"
    }

    proba "deserialization rejects a malformed payload" {
        adfirma shape_err(bytes([0x53, 0x46, 0x01, 0x02, 0x01, 0x00, 0x00])) ≡ "malformed shape payload"
        adfirma shape_err(bytes([0x53, 0x46, 0x01])) ≡ "truncated header"
    }
}

# -- tensor round-trip and rejection ---------------------------------------

probandum "tensor serialization" {
    proba "tensor values round-trip" {
        adfirma tensor_ok([1.0, 2.0, 3.0, 4.0], [2, 2], "f32") ≡ "f32|2,2|1|2|3|4"
        adfirma tensor_ok([1.0, 2.0, 3.0], [3], "i32") ≡ "i32|3|1|2|3"
        adfirma tensor_ok([9.0], [], "u8") ≡ "u8||9"
        adfirma tensor_ok([1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5], [2, 2, 2], "f32") ≡ "f32|2,2,2|1.5|2.5|3.5|4.5|5.5|6.5|7.5|8.5"
    }

    proba "empty element data round-trips for a zero-dim shape" {
        adfirma tensor_ok([], [0], "f16") ≡ "f16|0|"
    }

    proba "non-finite values round-trip" {
        adfirma tensor_ok(["NaN" ↦ f32], [1], "f32") ≡ "f32|1|NaN"
    }

    proba "serialization rejects an element-count mismatch" {
        adfirma tensor_ser_err([1.0], [2], "f32") ≡ "element count mismatch"
    }

    proba "serialization rejects an unknown dtype name and a bad shape" {
        adfirma tensor_ser_err([1.0], [1], "q8") ≡ "unknown dtype name: q8"
        adfirma tensor_ser_err([1.0], [-1], "f32") ≡ "negative dimension"
    }

    proba "deserialization rejects an unknown schema version and kind" {
        adfirma tensor_err(bytes([0x53, 0x46, 0x02, 0x03, 0x00, 0x01])) ≡ "unknown serialize schema version"
        adfirma tensor_err(bytes([0x53, 0x46, 0x01, 0x09, 0x00, 0x01])) ≡ "unknown serialize kind"
    }

    proba "deserialization rejects a truncated tensor payload" {
        adfirma tensor_err(bytes([0x53, 0x46, 0x01, 0x03])) ≡ "truncated tensor payload"
    }

    proba "deserialization rejects an unknown dtype tag" {
        adfirma tensor_err(bytes([0x53, 0x46, 0x01, 0x03, 0x09, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00])) ≡ "unknown dtype tag"
    }

    proba "deserialization rejects a truncated data length" {
        adfirma tensor_err(bytes([0x53, 0x46, 0x01, 0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00])) ≡ "truncated tensor data length"
    }

    proba "deserialization rejects a malformed float token" {
        adfirma tensor_err(bytes([0x53, 0x46, 0x01, 0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x03, 0x61, 0x62, 0x63])) ≡ "malformed float token"
    }

    proba "deserialization rejects an element-count mismatch in the data" {
        adfirma tensor_err(bytes([0x53, 0x46, 0x01, 0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x03, 0x31, 0x20, 0x32])) ≡ "element count mismatch in serialized data"
    }

    proba "deserialization rejects trailing bytes" {
        adfirma tensor_err(bytes([0x53, 0x46, 0x01, 0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01, 0x31, 0x00])) ≡ "malformed tensor payload"
    }
}

# -- parameter round-trip and rejection ------------------------------------

probandum "parameter serialization" {
    proba "parameter values round-trip" {
        adfirma parametrum_ok("weight", "model.linear", "f32", [2, 2], 1, "trainable", [1.0, 2.0, 3.0, 4.0]) ≡ "weight|model.linear|f32|2,2|1|trainable|1|2|3|4"
        adfirma parametrum_ok("bias", "model", "f16", [2], 3, "frozen", [1.5, 2.5]) ≡ "bias|model|f16|2|3|frozen|1.5|2.5"
        adfirma parametrum_ok("scale", "model", "u8", [], 1, "trainable", [9.0]) ≡ "scale|model|u8||1|trainable|9"
    }

    proba "serialization rejects an empty name or owner" {
        adfirma parametrum_ser_err("", "model", "f32", [1], 1, "trainable", [1.0]) ≡ "empty parameter name"
        adfirma parametrum_ser_err("w", "", "f32", [1], 1, "trainable", [1.0]) ≡ "empty parameter owner"
    }

    proba "serialization rejects a reserved wire character in name or owner" {
        adfirma parametrum_ser_err("a/b", "model", "f32", [1], 1, "trainable", [1.0]) ≡ "reserved wire character in name or owner"
        adfirma parametrum_ser_err("w", "a/b", "f32", [1], 1, "trainable", [1.0]) ≡ "reserved wire character in name or owner"
    }

    proba "serialization rejects an invalid version" {
        adfirma parametrum_ser_err("w", "model", "f32", [1], 0, "trainable", [1.0]) ≡ "invalid parameter version"
    }

    proba "serialization rejects an unknown status" {
        adfirma parametrum_ser_err("w", "model", "f32", [1], 1, "staged", [1.0]) ≡ "unknown parameter status"
    }

    proba "serialization rejects an unknown dtype name" {
        adfirma parametrum_ser_err("w", "model", "q8", [1], 1, "trainable", [1.0]) ≡ "unknown dtype name: q8"
    }

    proba "serialization rejects a bad shape or element-count mismatch" {
        adfirma parametrum_ser_err("w", "model", "f32", [-1], 1, "trainable", [1.0]) ≡ "negative dimension"
        adfirma parametrum_ser_err("w", "model", "f32", [2], 1, "trainable", [1.0]) ≡ "element count mismatch"
    }

    proba "deserialization rejects an unknown schema version and kind" {
        adfirma parametrum_err(bytes([0x53, 0x46, 0x02, 0x04, 0x00, 0x01])) ≡ "unknown serialize schema version"
        adfirma parametrum_err(bytes([0x53, 0x46, 0x01, 0x09, 0x00, 0x01])) ≡ "unknown serialize kind"
    }

    proba "deserialization rejects a truncated parameter payload" {
        adfirma parametrum_err(bytes([0x53, 0x46, 0x01, 0x04])) ≡ "truncated parameter payload"
    }

    proba "deserialization rejects an unknown dtype tag" {
        adfirma parametrum_err(bytes([0x53, 0x46, 0x01, 0x04, 0x09, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00])) ≡ "unknown dtype tag"
    }

    proba "deserialization rejects an invalid version" {
        adfirma parametrum_err(bytes([0x53, 0x46, 0x01, 0x04, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x6d])) ≡ "invalid version in serialized parameter"
        adfirma parametrum_err(bytes([0x53, 0x46, 0x01, 0x04, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01, 0x6d])) ≡ "invalid version in serialized parameter"
    }

    proba "deserialization rejects an unknown parameter status" {
        adfirma parametrum_err(bytes([0x53, 0x46, 0x01, 0x04, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x09, 0x00, 0x00, 0x00, 0x01, 0x6d, 0x00, 0x00, 0x00, 0x01, 0x77, 0x00, 0x00, 0x00, 0x01, 0x31])) ≡ "unknown parameter status"
    }

    proba "deserialization rejects an empty owner or name" {
        adfirma parametrum_err(bytes([0x53, 0x46, 0x01, 0x04, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00])) ≡ "empty parameter owner"
    }

    proba "deserialization rejects a reserved wire character in a name" {
        adfirma parametrum_err(bytes([0x53, 0x46, 0x01, 0x04, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01, 0x6d, 0x00, 0x00, 0x00, 0x01, 0x2f, 0x00, 0x00, 0x00, 0x01, 0x31])) ≡ "reserved wire character in name or owner"
    }

    proba "deserialization rejects trailing bytes" {
        adfirma parametrum_err(bytes([0x53, 0x46, 0x01, 0x04, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01, 0x6d, 0x00, 0x00, 0x00, 0x01, 0x77, 0x00, 0x00, 0x00, 0x01, 0x31, 0x00])) ≡ "malformed parameter payload"
    }
}
