+++
locale = "en"
+++
# Co-located package tests for gradus:schedule.
#
# The oracle pins are f64 evaluations of warmup and cosine-decay formulas;
# production uses f32 and compares under the documented 5e-4 tolerance.
# Assertions execute under the faber test path; faber check type-checks them.

import from "gradus:schedule" schedule

# Renders a schedule-construction outcome as text: "ok" on success, the
# typed error's message on rejection.
fn schedule_detail(f32 rate_vertex, int warmup, int total_steps, f32 rate_end) → string {
    let _ outcome ← trap {
        schedule.construct_schedule(rate_vertex, warmup, total_steps, rate_end)
    }
    if outcome is schedule.Schedule {
        return "ok"
    }
    let schedule.ScheduleError err ← outcome
    return err.message
}

# Renders a schedule-evaluation outcome as text.
# BLOCKER (class 3, scalar narrowing): the success arm is the f32 rate —
# narrowing a trap outcome to a scalar success type is blocked (routed
# N2/N4a). Kept on do/catch. Do not convert.
fn rate_detail(schedule.Schedule s, int step) → string {
    do {
        schedule.scheduled_rate(s, step)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# ---- oracle pins (f64 evaluations of the documented schedule formulas)

# Row A: vertex 0.1, warmup 5, total 25, end 0.
#   step 1  → 0.1·1/5     = 0.02      (warmup ramp)
#   step 3  → 0.1·3/5     = 0.06      (warmup ramp)
#   step 5  → 0.1·(1+cos 0)/2 = 0.1   (boundary — continuous with the ramp)
#   step 15 → 0.1·(1+cos(π/2))/2 = 0.05 (t = 0.5)
#   step 25 → 0.1·(1+cos π)/2 = 0.0   (t = 1)
#   step 100 → 0.0                    (clamped to the horizon)
# Row B: vertex 0.2, warmup 3, total 11, end 0.05.
#   step 0  → 0.2·0/3     = 0.0       (warmup ramp)
#   step 7  → 0.05 + 0.15·(1+cos(π/2))/2 = 0.125 (t = 0.5)
# — f64 evaluations; pins for the auditor-owned runtime-evidence gate.
const f32 RATE_ORACLE_A1 = 0.02 ∷ f32

const f32 RATE_ORACLE_A3 = 0.06 ∷ f32

const f32 RATE_ORACLE_A5 = 0.1 ∷ f32

const f32 RATE_ORACLE_A15 = 0.05 ∷ f32

const f32 RATE_ORACLE_A25 = 0.0 ∷ f32

const f32 RATE_ORACLE_A100 = 0.0 ∷ f32

const f32 RATE_ORACLE_B0 = 0.0 ∷ f32

const f32 RATE_ORACLE_B7 = 0.125 ∷ f32

# Absolute tolerance for the f32 self-hosted schedule vs the f64 oracle
# pins (the loss.proba f32-vs-f64 posture; covers the cosine Taylor
# remainder over [0, π]).
const f32 RATE_TOLERANCE = 0.0005 ∷ f32

# ---- Schedule construction

test "construct_schedule builds a schedule config with full fields" {
    let _ trap_result_1 ← trap {

        let schedule.Schedule s ← schedule.construct_schedule(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        assert s.rate_vertex ≡ 0.1 ∷ f32
        assert s.warmup ≡ 5
        assert s.total_steps ≡ 25
        assert s.rate_end ≡ 0.0 ∷ f32
    }
    assert trap_result_1 is void
}

test "construct_schedule rejects a negative peak rate" {
    assert schedule_detail(0.0 - 0.1 ∷ f32, 5, 25, 0.0 ∷ f32) ≡ "invalid peak learning rate"
}

test "construct_schedule rejects a non-finite peak rate" {
    assert schedule_detail(1.0 / 0.0 ∷ f32, 5, 25, 0.0 ∷ f32) ≡ "invalid peak learning rate"
}

test "construct_schedule rejects a negative final rate" {
    assert schedule_detail(0.1 ∷ f32, 5, 25, 0.0 - 0.01 ∷ f32) ≡ "invalid final learning rate"
}

test "construct_schedule rejects a final rate above the peak" {
    assert schedule_detail(0.1 ∷ f32, 5, 25, 0.2 ∷ f32) ≡ "final learning rate above peak"
}

test "construct_schedule rejects negative warmup steps" {
    assert schedule_detail(0.1 ∷ f32, 0 - 1, 25, 0.0 ∷ f32) ≡ "negative warmup steps"
}

test "construct_schedule rejects an empty horizon" {
    assert schedule_detail(0.1 ∷ f32, 0, 0, 0.0 ∷ f32) ≡ "schedule horizon must be at least one step"
}

test "construct_schedule rejects a warmup longer than the horizon" {
    assert schedule_detail(0.1 ∷ f32, 30, 25, 0.0 ∷ f32) ≡ "warmup exceeds the schedule horizon"
}

# ---- the schedule evaluation vs the f64 oracle pins

test "row A warmup ramp matches the f64 formula (lr = vertex·step/warmup)" {
    let _ trap_result_2 ← trap {

        let schedule.Schedule s ← schedule.construct_schedule(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        let f32 l1 ← schedule.scheduled_rate(s, 1)
        let f32 l3 ← schedule.scheduled_rate(s, 3)
        assert l1.approx(RATE_ORACLE_A1, RATE_TOLERANCE)
        assert l3.approx(RATE_ORACLE_A3, RATE_TOLERANCE)
    }
    assert trap_result_2 is void
}

test "row A boundary is continuous (step == warmup is the peak lr)" {
    let _ trap_result_3 ← trap {

        let schedule.Schedule s ← schedule.construct_schedule(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        let f32 l5 ← schedule.scheduled_rate(s, 5)
        assert l5.approx(RATE_ORACLE_A5, RATE_TOLERANCE)
    }
    assert trap_result_3 is void
}

test "row A cosine decay matches the f64 formula (mid-decay and horizon)" {
    let _ trap_result_4 ← trap {

        let schedule.Schedule s ← schedule.construct_schedule(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        let f32 l15 ← schedule.scheduled_rate(s, 15)
        let f32 l25 ← schedule.scheduled_rate(s, 25)
        assert l15.approx(RATE_ORACLE_A15, RATE_TOLERANCE)
        assert l25.approx(RATE_ORACLE_A25, RATE_TOLERANCE)
    }
    assert trap_result_4 is void
}

test "row A post-horizon steps are clamped to the final lr" {
    let _ trap_result_5 ← trap {

        let schedule.Schedule s ← schedule.construct_schedule(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        let f32 l100 ← schedule.scheduled_rate(s, 100)
        assert l100.approx(RATE_ORACLE_A100, RATE_TOLERANCE)
    }
    assert trap_result_5 is void
}

test "row B (non-zero final lr) matches the f64 formula" {
    let _ trap_result_6 ← trap {

        let schedule.Schedule s ← schedule.construct_schedule(0.2 ∷ f32, 3, 11, 0.05 ∷ f32)
        let f32 l0 ← schedule.scheduled_rate(s, 0)
        let f32 l7 ← schedule.scheduled_rate(s, 7)
        assert l0.approx(RATE_ORACLE_B0, RATE_TOLERANCE)
        assert l7.approx(RATE_ORACLE_B7, RATE_TOLERANCE)
    }
    assert trap_result_6 is void
}

test "a degenerate horizon (total == warmup) is constant at the peak" {
    let _ trap_result_7 ← trap {

        let schedule.Schedule s ← schedule.construct_schedule(0.1 ∷ f32, 5, 5, 0.0 ∷ f32)
        let f32 l6 ← schedule.scheduled_rate(s, 6)
        assert l6.approx(RATE_ORACLE_A5, RATE_TOLERANCE)
    }
    assert trap_result_7 is void
}

# ---- schedule determinism + fail-closed evaluation

test "equal inputs produce equal lr (pure — no RNG, no hidden state)" {
    let _ trap_result_8 ← trap {

        let schedule.Schedule s ← schedule.construct_schedule(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        let f32 a ← schedule.scheduled_rate(s, 15)
        let f32 b ← schedule.scheduled_rate(s, 15)
        assert a ≡ b
    }
    assert trap_result_8 is void
}

test "a negative step is rejected (step counts are non-negative)" {
    let _ trap_result_9 ← trap {

        let schedule.Schedule s ← schedule.construct_schedule(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        assert rate_detail(s, 0 - 1) ≡ "schedule step must be non-negative"
    }
    assert trap_result_9 is void
}


test "the accepted constant schedule evaluates to lr 0.1 at every step" {
    let _ trap_result_10 ← trap {
        let schedule.Schedule s ← schedule.construct_schedule(0.1 ∷ f32, 0, 1, 0.1 ∷ f32)
        let f32 l0 ← schedule.scheduled_rate(s, 0)
        let f32 l50 ← schedule.scheduled_rate(s, 50)
        let f32 l99 ← schedule.scheduled_rate(s, 99)
        assert l0 ≡ 0.1 ∷ f32
        assert l50 ≡ 0.1 ∷ f32
        assert l99 ≡ 0.1 ∷ f32
    }
    assert trap_result_10 is void
}
