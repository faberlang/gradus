+++
locale = "en"
+++
# Co-located package test for train.fab (PML4-U4 — schedules + train/eval
# mode). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * Schedula — the warmup + cosine learning-rate schedule: construction
#     (full fields; fail-closed on non-finite/negative rates, finis above
#     vertex, negative warmup, empty or short horizon), the documented
#     evaluation (linear warmup ramp, cosine decay, horizon clamp), and
#     determinism (pure — no RNG, no hidden state: equal inputs produce
#     equal lr).
#   * Modus — the train/eval mode control: construction from the canonical
#     names ("train" | "eval"), name round-trip, predicates, fail-closed on
#     an unknown name.
#   * dropout_pars — the dropout/RNG policy gate: eval mode is identity
#     (effective rate 0), train mode carries the configured rate; the rate
#     domain [0, 1] is enforced (fail closed). Explicit mode argument only
#     — no hidden global state (the shared-layer rule).
#
# Oracle pins: f64 evaluations of the documented schedule formulas
#   lr(step) = vertex·step/warmup                         step < warmup
#   lr(step) = finis + (vertex−finis)·(1+cos(π·t))/2       step ≥ warmup
# for the canonical rows:
#   A: vertex 0.1, warmup 5, total 25, finis 0 —
#      step 1 → 0.02; step 3 → 0.06; step 5 → 0.1 (boundary, continuous);
#      step 15 → 0.05 (t = 0.5); step 25 → 0.0 (t = 1); step 100 → 0.0
#      (clamped to the horizon).
#   B: vertex 0.2, warmup 3, total 11, finis 0.05 —
#      step 0 → 0.0; step 7 → 0.125 (t = 0.5).
# The production surface is f32 self-hosted (cos via the Taylor series —
# the attention.fab precedent, argument always in [0, π]); the f64 oracle
# pins are compared under a documented 5e-4 absolute tolerance (the
# loss.proba f32-vs-f64 posture). The auditor-owned runtime-evidence gate
# compares executed evaluations against these pins.
#
# EVIDENCE HONESTY (CTO Q2, hard): this suite is STRUCTURAL proof. No
# executed schedule value or mode-policy value is claimed here; the oracle
# pins are f64 evaluations of the documented formulas. Executed
# value-identity is env-blocked tree-wide today (FMIR stepper /
# library-import gap — recorded residual); PML4-U4 is PARTIAL and
# value-identity is deferred to the auditor-owned runtime-evidence gate.
#
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/train.proba` proves the suite
# type-checks. Execution of proba bodies is env-blocked tree-wide today
# (recorded residual); this suite is the compile-level proof of the
# contract.

import from "gradus:train" train

import from "gradus:optimize" optimize

import from "gradus:tensor" tensor

# ---- helpers (the loss.proba / gradient.proba pattern)

# Renders a schedule-construction outcome as textus: "ok" on success, the
# typed error's causa on rejection.
fn schedula_detail(f32 lentus_vertex, int incalesco, int passus_total, f32 lentus_finis) → string {
    do {
        train.structa_schedula(lentus_vertex, incalesco, passus_total, lentus_finis)
        return "ok"
    }
    catch err {
        return train.causa(err)
    }
}

# Renders a schedule-evaluation outcome as textus.
fn lentus_detail(train.Schedula s, int passus) → string {
    do {
        train.lentus_schedulata(s, passus)
        return "ok"
    }
    catch err {
        return train.causa(err)
    }
}

# Renders a mode-construction outcome as textus.
fn modus_detail(string nomen) → string {
    do {
        train.modus(nomen)
        return "ok"
    }
    catch err {
        return train.causa(err)
    }
}

# Renders a dropout-policy outcome as textus.
fn dropout_detail(train.Modus m, f32 rate) → string {
    do {
        train.dropout_pars(m, rate)
        return "ok"
    }
    catch err {
        return train.causa(err)
    }
}

# ---- oracle pins (f64 evaluations of the documented schedule formulas)

# Row A: vertex 0.1, warmup 5, total 25, finis 0.
#   step 1  → 0.1·1/5     = 0.02      (warmup ramp)
#   step 3  → 0.1·3/5     = 0.06      (warmup ramp)
#   step 5  → 0.1·(1+cos 0)/2 = 0.1   (boundary — continuous with the ramp)
#   step 15 → 0.1·(1+cos(π/2))/2 = 0.05 (t = 0.5)
#   step 25 → 0.1·(1+cos π)/2 = 0.0   (t = 1)
#   step 100 → 0.0                    (clamped to the horizon)
# Row B: vertex 0.2, warmup 3, total 11, finis 0.05.
#   step 0  → 0.2·0/3     = 0.0       (warmup ramp)
#   step 7  → 0.05 + 0.15·(1+cos(π/2))/2 = 0.125 (t = 0.5)
# — f64 evaluations; pins for the auditor-owned runtime-evidence gate.
const f32 LENTUS_ORACLE_A1 ← 0.02 ∷ f32

const f32 LENTUS_ORACLE_A3 ← 0.06 ∷ f32

const f32 LENTUS_ORACLE_A5 ← 0.1 ∷ f32

const f32 LENTUS_ORACLE_A15 ← 0.05 ∷ f32

const f32 LENTUS_ORACLE_A25 ← 0.0 ∷ f32

const f32 LENTUS_ORACLE_A100 ← 0.0 ∷ f32

const f32 LENTUS_ORACLE_B0 ← 0.0 ∷ f32

const f32 LENTUS_ORACLE_B7 ← 0.125 ∷ f32

# Absolute tolerance for the f32 self-hosted schedule vs the f64 oracle
# pins (the loss.proba f32-vs-f64 posture; covers the cosine Taylor
# remainder over [0, π]).
const f32 LENTUS_TOLERATIO ← 0.0005 ∷ f32

# ---- Schedula construction

test "structa_schedula builds a schedule config with full fields" {
    do {
        const train.Schedula s ← train.structa_schedula(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        assert s.lentus_vertex() ≡ 0.1 ∷ f32
        assert s.incalesco() ≡ 5
        assert s.passus_total() ≡ 25
        assert s.lentus_finis() ≡ 0.0 ∷ f32
    }
    catch err {
        assert false
    }
}

test "structa_schedula rejects a negative peak rate" {
    assert schedula_detail(0.0 - 0.1 ∷ f32, 5, 25, 0.0 ∷ f32) ≡ "invalid peak learning rate"
}

test "structa_schedula rejects a non-finite peak rate" {
    assert schedula_detail(1.0 / 0.0 ∷ f32, 5, 25, 0.0 ∷ f32) ≡ "invalid peak learning rate"
}

test "structa_schedula rejects a negative final rate" {
    assert schedula_detail(0.1 ∷ f32, 5, 25, 0.0 - 0.01 ∷ f32) ≡ "invalid final learning rate"
}

test "structa_schedula rejects a final rate above the peak" {
    assert schedula_detail(0.1 ∷ f32, 5, 25, 0.2 ∷ f32) ≡ "final learning rate above peak"
}

test "structa_schedula rejects negative warmup steps" {
    assert schedula_detail(0.1 ∷ f32, 0 - 1, 25, 0.0 ∷ f32) ≡ "negative warmup steps"
}

test "structa_schedula rejects an empty horizon" {
    assert schedula_detail(0.1 ∷ f32, 0, 0, 0.0 ∷ f32) ≡ "schedule horizon must be at least one step"
}

test "structa_schedula rejects a warmup longer than the horizon" {
    assert schedula_detail(0.1 ∷ f32, 30, 25, 0.0 ∷ f32) ≡ "warmup exceeds the schedule horizon"
}

# ---- the schedule evaluation vs the f64 oracle pins

test "row A warmup ramp matches the f64 formula (lr = vertex·step/warmup)" {
    do {
        const train.Schedula s ← train.structa_schedula(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        const f32 l1 ← train.lentus_schedulata(s, 1)
        const f32 l3 ← train.lentus_schedulata(s, 3)
        assert l1.approx(LENTUS_ORACLE_A1, LENTUS_TOLERATIO)
        assert l3.approx(LENTUS_ORACLE_A3, LENTUS_TOLERATIO)
    }
    catch err {
        assert false
    }
}

test "row A boundary is continuous (step == warmup is the peak lr)" {
    do {
        const train.Schedula s ← train.structa_schedula(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        const f32 l5 ← train.lentus_schedulata(s, 5)
        assert l5.approx(LENTUS_ORACLE_A5, LENTUS_TOLERATIO)
    }
    catch err {
        assert false
    }
}

test "row A cosine decay matches the f64 formula (mid-decay and horizon)" {
    do {
        const train.Schedula s ← train.structa_schedula(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        const f32 l15 ← train.lentus_schedulata(s, 15)
        const f32 l25 ← train.lentus_schedulata(s, 25)
        assert l15.approx(LENTUS_ORACLE_A15, LENTUS_TOLERATIO)
        assert l25.approx(LENTUS_ORACLE_A25, LENTUS_TOLERATIO)
    }
    catch err {
        assert false
    }
}

test "row A post-horizon steps are clamped to the final lr" {
    do {
        const train.Schedula s ← train.structa_schedula(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        const f32 l100 ← train.lentus_schedulata(s, 100)
        assert l100.approx(LENTUS_ORACLE_A100, LENTUS_TOLERATIO)
    }
    catch err {
        assert false
    }
}

test "row B (non-zero final lr) matches the f64 formula" {
    do {
        const train.Schedula s ← train.structa_schedula(0.2 ∷ f32, 3, 11, 0.05 ∷ f32)
        const f32 l0 ← train.lentus_schedulata(s, 0)
        const f32 l7 ← train.lentus_schedulata(s, 7)
        assert l0.approx(LENTUS_ORACLE_B0, LENTUS_TOLERATIO)
        assert l7.approx(LENTUS_ORACLE_B7, LENTUS_TOLERATIO)
    }
    catch err {
        assert false
    }
}

test "a degenerate horizon (total == warmup) is constant at the peak" {
    do {
        const train.Schedula s ← train.structa_schedula(0.1 ∷ f32, 5, 5, 0.0 ∷ f32)
        const f32 l6 ← train.lentus_schedulata(s, 6)
        assert l6.approx(LENTUS_ORACLE_A5, LENTUS_TOLERATIO)
    }
    catch err {
        assert false
    }
}

# ---- schedule determinism + fail-closed evaluation

test "equal inputs produce equal lr (pure — no RNG, no hidden state)" {
    do {
        const train.Schedula s ← train.structa_schedula(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        const f32 a ← train.lentus_schedulata(s, 15)
        const f32 b ← train.lentus_schedulata(s, 15)
        assert a ≡ b
    }
    catch err {
        assert false
    }
}

test "a negative step is rejected (step counts are non-negative)" {
    do {
        const train.Schedula s ← train.structa_schedula(0.1 ∷ f32, 5, 25, 0.0 ∷ f32)
        assert lentus_detail(s, 0 - 1) ≡ "schedule step must be non-negative"
    }
    catch err {
        assert false
    }
}

# ---- the train/eval mode control

test "modus(\"train\") is train mode; the name round-trips" {
    do {
        const train.Modus m ← train.modus("train")
        assert train.modus_nomen(m) ≡ "train"
        assert train.est_disciplina(m)
        assert not train.est_aestimatio(m)
    }
    catch err {
        assert false
    }
}

test "modus(\"eval\") is eval mode; the name round-trips" {
    do {
        const train.Modus m ← train.modus("eval")
        assert train.modus_nomen(m) ≡ "eval"
        assert train.est_aestimatio(m)
        assert not train.est_disciplina(m)
    }
    catch err {
        assert false
    }
}

test "an unknown mode name fails closed" {
    assert modus_detail("infer") ≡ "unknown mode name"
}

# ---- the dropout/RNG policy gate (explicit mode, no hidden state)

test "train mode carries the configured dropout rate" {
    do {
        const train.Modus m ← train.modus("train")
        const f32 r ← train.dropout_pars(m, 0.5 ∷ f32)
        assert r ≡ 0.5 ∷ f32
    }
    catch err {
        assert false
    }
}

test "eval mode is dropout identity (effective rate 0)" {
    do {
        const train.Modus m ← train.modus("eval")
        const f32 r ← train.dropout_pars(m, 0.5 ∷ f32)
        assert r ≡ 0.0 ∷ f32
    }
    catch err {
        assert false
    }
}

test "the policy is deterministic (explicit mode argument — no hidden global state)" {
    do {
        const train.Modus m ← train.modus("eval")
        const f32 a ← train.dropout_pars(m, 0.9 ∷ f32)
        const f32 b ← train.dropout_pars(m, 0.9 ∷ f32)
        assert a ≡ b
    }
    catch err {
        assert false
    }
}

test "a rate above 1 is rejected (the [0, 1] domain)" {
    do {
        const train.Modus m ← train.modus("train")
        assert dropout_detail(m, 1.5 ∷ f32) ≡ "dropout rate must be in [0, 1]"
    }
    catch err {
        assert false
    }
}

test "a negative rate is rejected" {
    do {
        const train.Modus m ← train.modus("train")
        assert dropout_detail(m, 0.0 - 0.1 ∷ f32) ≡ "dropout rate must be in [0, 1]"
    }
    catch err {
        assert false
    }
}

test "a non-finite rate is rejected" {
    do {
        const train.Modus m ← train.modus("train")
        assert dropout_detail(m, 1.0 / 0.0 ∷ f32) ≡ "dropout rate must be in [0, 1]"
    }
    catch err {
        assert false
    }
}

# =========================================================================
# PML4-U5 — seeds (RNG), dropout mask, checkpoint resume (compile-level)
# =========================================================================
#
# The U5 sections prove, at compile level:
#   * Semen — the xorshift64 seed/RNG: construction (zero rejected), the
#     exact deterministic state sequence (f64/e64 oracle pins for seeds 1
#     and 42), the [0,1) f32 draws, the versioned wire round-trip
#     (including a negative state), and reproducibility (same seed → same
#     sequence).
#   * excutio — the dropout-mask composition over the U4 gate: eval mode
#     is identity and the RNG is untouched; train mode applies the
#     per-element Bernoulli mask at 1−rate scaled by 1/(1−rate), matching
#     the f64 oracle pin for a concrete (tensor, seed, rate); same inputs
#     reproduce the same output and the same advanced RNG state.
#   * Tabula — the checkpoint envelope: construction (fail-closed epoch/
#     step/empty-wire), the exact versioned wire round-trip with an
#     embedded U3 optimizer-state wire (verbatim), the signed RNG-state
#     round-trip, the rejections (unknown markers/schema, malformed
#     fields, zero RNG state), and the explicit interrupted-resume
#     failure: a corrupt embedded state wire is carried verbatim by the
#     envelope but FAILS CLOSED at optimize.deserializa (resume).
#
# Oracle pins: the xorshift64 state values are exact i64 evaluations of
# the documented recurrence (x ^= x<<13; x ^= x>>7; x ^= x<<17, the >> is
# arithmetic on i64). The draws are (state ∧ 2^63−1) >> 11 over 2^52
# (f64 evaluations; the production surface casts to f32, rounding ≤ ~1e-7
# — pins compare within a documented 1e-6 tolerance). The dropout-mask
# pin [0, 0, 0, 8.0] is exact arithmetic (0.5, 2.0, 4.0 are exact f32).
# No executed value is claimed here (CTO Q2); the auditor-owned
# runtime-evidence gate compares executed values against these pins.

# ---- U5 helpers

# Build a staged tensor, swallowing the never-firing construction errors.
fn tene(list<f32> datos, list<int> forma) → tensor.Tensor {
    var tensor.Tensor t
    do {
        t ← tensor.structa(datos, forma)
    }
    catch err {
        return t
    }
    return t
}

# Staged-result element read (swallow the never-firing access errors).
fn e1(tensor.Tensor t, int i) → f32 {
    do {
        return t.accipe([i])
    }
    catch err {
        return 0.0 - 999.0 ∷ f32
    }
}

# A two-slot U3 optimizer-state wire (the checkpoint's embedded state),
# swallowing the never-firing OptimizeError (single-error-type fac).
fn sgd_wire_2() → string {
    var string wire ← ""
    do {
        const optimize.Sgd o ← optimize.sgd_vacuum()
        const optimize.SgdStatum s1 ← optimize.structa("w1", "model", 1, 0.01 ∷ f32)
        const optimize.SgdStatum s2 ← optimize.structa("b1", "model", 1, 0.001 ∷ f32)
        const optimize.Sgd o2 ← optimize.adscisco(o, s1)
        const optimize.Sgd o3 ← optimize.adscisco(o2, s2)
        wire ← optimize.serializa(o3)
    }
    catch err {
        return wire
    }
    return wire
}

# Resume-path state-wire deserialization outcome (the embedded wire
# validates against ITS OWN schema — optimize.deserializa).
fn deserializa_optimum(string wire) → string {
    do {
        optimize.deserializa(wire)
        return "ok"
    }
    catch err {
        return optimize.causa(err)
    }
}

# Renders an RNG-construction outcome as textus.
fn semen_detail(int semen) → string {
    do {
        train.structa_semen(semen)
        return "ok"
    }
    catch err {
        return train.causa(err)
    }
}

# Renders an RNG-wire deserialization outcome as textus.
fn deserializa_semen_detail(string wire) → string {
    do {
        train.deserializa_semen(wire)
        return "ok"
    }
    catch err {
        return train.causa(err)
    }
}

# Renders a checkpoint-construction outcome as textus.
fn tabula_detail(int aetas, int passus, train.Semen rng, string statum_wire) → string {
    do {
        train.structa_tabula(aetas, passus, rng, statum_wire)
        return "ok"
    }
    catch err {
        return train.causa(err)
    }
}

# Renders a checkpoint-wire deserialization outcome as textus.
fn deserializa_tabula_detail(string wire) → string {
    do {
        train.deserializa_tabula(wire)
        return "ok"
    }
    catch err {
        return train.causa(err)
    }
}

# ---- the seed/RNG contract

test "structa_semen seeds the generator" {
    do {
        const train.Semen s ← train.structa_semen(1)
        assert s.status() ≡ 1
    }
    catch err {
        assert false
    }
}

test "structa_semen rejects the zero seed (xorshift64 degenerates at 0)" {
    assert semen_detail(0) ≡ "seed must be non-zero"
}

test "the same seed reproduces the same first draw (reproducibility)" {
    do {
        const train.Semen s1 ← train.structa_semen(1)
        const train.Semen s2 ← train.structa_semen(1)
        const train.Fructus a ← train.proximus(s1)
        const train.Fructus b ← train.proximus(s2)
        assert a.valor() ≡ b.valor()
    }
    catch err {
        assert false
    }
}

test "seed 1 state sequence matches the documented recurrence" {
    do {
        const train.Semen s0 ← train.structa_semen(1)
        const train.Fructus f1 ← train.proximus(s0)
        # x ^= x<<13; x ^= x>>7 (arithmetic on i64); x ^= x<<17.
        assert f1.valor() ≡ 1082269761
        const train.Fructus f2 ← train.proximus(f1.semen())
        assert f2.valor() ≡ 1152992998833853505
        const train.Fructus f3 ← train.proximus(f2.semen())
        assert f3.valor() ≡ 0 - 7269227409276787159
        const train.Fructus f4 ← train.proximus(f3.semen())
        assert f4.valor() ≡ 0 - 768720241707614171
    }
    catch err {
        assert false
    }
}

test "seed 42 first state matches the documented recurrence" {
    do {
        const train.Semen s ← train.structa_semen(42)
        const train.Fructus f ← train.proximus(s)
        assert f.valor() ≡ 45454805674
    }
    catch err {
        assert false
    }
}

test "seed 1 draws match the documented (state ∧ 2^63−1) >> 11 / 2^52 formula" {
    do {
        const train.Semen s0 ← train.structa_semen(1)
        const train.FructusF32 d1 ← train.proximus_f32(s0)
        const train.FructusF32 d2 ← train.proximus_f32(d1.semen())
        const train.FructusF32 d3 ← train.proximus_f32(d2.semen())
        const train.FructusF32 d4 ← train.proximus_f32(d3.semen())
        # f64 evaluations: 0.12500775141962395, 0.21186878505709306,
        # 0.9166551843907023 (the first draw, ~1.17e-10, is pinned by
        # the bound below and the exact state pins above).
        assert d1.valor().approx(0.1250078 ∷ f32, 0.000001 ∷ f32)
        assert d2.valor().approx(0.2118688 ∷ f32, 0.000001 ∷ f32)
        assert d3.valor().approx(0.9166552 ∷ f32, 0.000001 ∷ f32)
        assert d4.valor() ≺ 0.000001 ∷ f32
    }
    catch err {
        assert false
    }
}

test "the RNG wire round-trips a positive state exactly" {
    do {
        const train.Semen s ← train.structa_semen(42)
        const train.Semen t ← train.deserializa_semen(train.serializa_semen(s))
        assert t.status() ≡ 42
    }
    catch err {
        assert false
    }
}

test "the RNG wire round-trips a negative state exactly (signed i64 status)" {
    do {
        const train.Semen s0 ← train.structa_semen(1)
        const train.Fructus f1 ← train.proximus(s0)
        const train.Fructus f2 ← train.proximus(f1.semen())
        const train.Fructus f3 ← train.proximus(f2.semen())
        # f3.semen().status() is the signed i64 value -7269227409276787159.
        const train.Semen t ← train.deserializa_semen(train.serializa_semen(f3.semen()))
        assert t.status() ≡ f3.semen().status()
    }
    catch err {
        assert false
    }
}

test "the RNG wire rejects an unknown marker and a zero state" {
    assert deserializa_semen_detail("tensor/rng/1.0.0/42") ≡ "unknown rng marker"
    assert deserializa_semen_detail("train/rng/1.0.0/0") ≡ "seed must be non-zero"
}

# ---- the dropout mask (the U4 gate's RNG seam composition)

test "eval mode is identity and the RNG is untouched (standard evaluation policy)" {
    do {
        const train.Modus m ← train.modus("eval")
        const train.Semen s ← train.structa_semen(1)
        const train.Excutio r ← train.excutio(tene([1.0, 2.0, 3.0, 4.0], [4]), s, m, 0.5 ∷ f32)
        assert e1(r.valor(), 0) ≡ 1.0 ∷ f32
        assert e1(r.valor(), 3) ≡ 4.0 ∷ f32
        assert r.semen().status() ≡ s.status()
    }
    catch err {
        assert false
    }
}

test "train mode mask matches the f64 oracle pin (seed 1, rate 0.5, x=[1,2,3,4])" {
    do {
        const train.Modus m ← train.modus("train")
        const train.Semen s ← train.structa_semen(1)
        const train.Excutio r ← train.excutio(tene([1.0, 2.0, 3.0, 4.0], [4]), s, m, 0.5 ∷ f32)
        # Draws from seed 1: 1.17e-10, 0.1250, 0.2119, 0.9167. Elements
        # 0-2 drop (r < 0.5 → 0.0); element 3 keeps (r = 0.9167 ≥ 0.5)
        # scaled by 1/(1−0.5) = 2 → 4.0·2 = 8.0. Exact f32 arithmetic.
        assert e1(r.valor(), 0) ≡ 0.0 ∷ f32
        assert e1(r.valor(), 1) ≡ 0.0 ∷ f32
        assert e1(r.valor(), 2) ≡ 0.0 ∷ f32
        assert e1(r.valor(), 3) ≡ 8.0 ∷ f32
        # The RNG advanced through the 4th draw: state 4 of seed 1.
        assert r.semen().status() ≡ 0 - 8787613929710185883
    }
    catch err {
        assert false
    }
}

test "the mask is deterministic (same inputs → same output and same advanced RNG)" {
    do {
        const train.Modus m ← train.modus("train")
        const train.Semen s ← train.structa_semen(1)
        const train.Excutio a ← train.excutio(tene([1.0, 2.0, 3.0, 4.0], [4]), s, m, 0.5 ∷ f32)
        const train.Excutio b ← train.excutio(tene([1.0, 2.0, 3.0, 4.0], [4]), s, m, 0.5 ∷ f32)
        assert e1(a.valor(), 3) ≡ e1(b.valor(), 3)
        assert a.semen().status() ≡ b.semen().status()
    }
    catch err {
        assert false
    }
}

# ---- the checkpoint envelope (Tabula)

test "structa_tabula builds a checkpoint with epoch, step, RNG, and state wire" {
    do {
        const train.Semen s ← train.structa_semen(42)
        const train.Tabula c ← train.structa_tabula(2, 37, s, sgd_wire_2())
        assert c.aetas() ≡ 2
        assert c.passus() ≡ 37
        assert c.rng().status() ≡ 42
        assert c.statum_wire().length() ≻ 0
    }
    catch err {
        assert false
    }
}

test "structa_tabula rejects a negative epoch and a negative step" {
    do {
        const train.Semen s ← train.structa_semen(42)
        assert tabula_detail(0 - 1, 0, s, sgd_wire_2()) ≡ "epoch must be non-negative"
        assert tabula_detail(0, 0 - 1, s, sgd_wire_2()) ≡ "step must be non-negative"
    }
    catch err {
        assert false
    }
}

test "structa_tabula rejects an empty state wire" {
    do {
        const train.Semen s ← train.structa_semen(42)
        assert tabula_detail(0, 0, s, "") ≡ "checkpoint state wire is empty"
    }
    catch err {
        assert false
    }
}

test "the checkpoint wire round-trips exactly (epoch, step, RNG, embedded state verbatim)" {
    do {
        const train.Semen s ← train.structa_semen(42)
        const train.Tabula c ← train.structa_tabula(2, 37, s, sgd_wire_2())
        const train.Tabula t ← train.deserializa_tabula(train.serializa_tabula(c))
        assert train.tabula_aequus(c, t)
        assert t.statum_wire() ≡ c.statum_wire()
        # The embedded state wire is valid at resume (optimize schema).
        assert deserializa_optimum(t.statum_wire()) ≡ "ok"
    }
    catch err {
        assert false
    }
}

test "the checkpoint wire round-trips a negative RNG state exactly" {
    do {
        const train.Semen s0 ← train.structa_semen(1)
        const train.Fructus f1 ← train.proximus(s0)
        const train.Fructus f2 ← train.proximus(f1.semen())
        const train.Fructus f3 ← train.proximus(f2.semen())
        const train.Tabula c ← train.structa_tabula(1, 3, f3.semen(), sgd_wire_2())
        const train.Tabula t ← train.deserializa_tabula(train.serializa_tabula(c))
        assert train.tabula_aequus(c, t)
        assert t.rng().status() ≡ 0 - 7269227409276787159
    }
    catch err {
        assert false
    }
}

test "an interrupted (corrupt embedded state) wire fails closed at resume — explicitly" {
    do {
        const train.Semen s ← train.structa_semen(42)
        # A checkpoint whose embedded state wire was truncated mid-write:
        # the envelope carries it verbatim (the two-layer contract)...
        const train.Tabula c ← train.structa_tabula(0, 0, s, "optimizer/sgd/1.0.0/2;optimizer/sgd-state/1.0.0/model/w1/1/1/0/0.01")
        const train.Tabula t ← train.deserializa_tabula(train.serializa_tabula(c))
        assert t.statum_wire() ≡ c.statum_wire()
        # ...and resume FAILS CLOSED at the state wire's own schema.
        assert deserializa_optimum(t.statum_wire()) ≡ "slot count mismatch in optimizer wire"
    }
    catch err {
        assert false
    }
}

test "an unknown checkpoint marker is rejected" {
    assert deserializa_tabula_detail("tensor/checkpoint/1.0.0/0/0/1/x") ≡ "unknown checkpoint marker"
}

test "an unknown checkpoint schema version is rejected" {
    assert deserializa_tabula_detail("train/checkpoint/9.9.9/0/0/1/x") ≡ "unknown checkpoint schema version"
}

test "a malformed checkpoint wire is rejected" {
    assert deserializa_tabula_detail("train/checkpoint/1.0.0/0") ≡ "malformed checkpoint wire"
}

test "a non-numeric epoch is rejected" {
    assert deserializa_tabula_detail("train/checkpoint/1.0.0/abc/0/1/x") ≡ "malformed epoch in checkpoint wire"
}

test "a zero RNG state in the checkpoint is rejected" {
    assert deserializa_tabula_detail("train/checkpoint/1.0.0/0/0/0/x") ≡ "seed must be non-zero"
}

# =========================================================================
# PML4-U6 — bounded convergence + resume proof (compile-level)
# =========================================================================
#
# The composed loop (exempla/training-loop-mlp) drives the accepted MLP
# 4×4 workload through the U1–U5 surfaces toward the accepted oracle
# trajectory. This section proves, at compile level, the composition's
# pure facts and pins the accepted convergence target:
#
#   * the constant-lr schedule binding (the U4→U3 input): the accepted
#     schedule (vertex == finis == 0.1, warmup 0, horizon 1) evaluates to
#     lr = 0.1 at every step — the lr the loop binds into the optimizer
#     state slots (optimize.structa lentus);
#   * the accepted trajectory pins (f64 evaluations of the accepted
#     oracle, examples/training/mlp): steps 0/10/25/50/75/99 →
#     1.576448169383708 / 0.7815377070077427 / 0.4303461875641296 /
#     0.13848813116166797 / 0.04746405569680761 / 0.017928625511508454,
#     with the convergence gate final/initial = 0.01137 < 0.1;
#   * the composition-level resume round-trip: the loop's checkpoint (the
#     whole-optimizer state wire with the four MLP slots + the RNG state +
#     epoch/step) round-trips exactly (tabula_aequus) and the embedded
#     state wire validates at resume (optimize.deserializa);
#   * the deterministic-seed contract: the same schedule and the same RNG
#     seed reproduce the same lr sequence and the same draws (this
#     workload has no dropout, so the trajectory is seed-independent by
#     construction; the seed is carried by the checkpoint).
#
# The EXECUTED convergence (the loop's loss trajectory vs these pins) is
# env-blocked on both available lanes (the FMIR stepper library-import
# gap; the Rust emit lane cannot lower the AIR-lane backward companion —
# TARGETLANE001). This is the STRUCTURAL proof; executed value-identity
# is deferred to the auditor-owned runtime-evidence gate. PML4-U6 is
# PARTIAL per the CTO Q2 bar — no executed convergence is claimed.

# ---- U6 helpers

# The loop's whole-optimizer state wire: four MLP slots (w1/b1/w2/b2).
fn sgd_wire_4() → string {
    var string wire ← ""
    do {
        const optimize.Sgd o ← optimize.sgd_vacuum()
        const optimize.SgdStatum s1 ← optimize.structa("w1", "model.mlp", 1, 0.1 ∷ f32)
        const optimize.SgdStatum s2 ← optimize.structa("b1", "model.mlp", 1, 0.1 ∷ f32)
        const optimize.SgdStatum s3 ← optimize.structa("w2", "model.mlp", 1, 0.1 ∷ f32)
        const optimize.SgdStatum s4 ← optimize.structa("b2", "model.mlp", 1, 0.1 ∷ f32)
        const optimize.Sgd o1 ← optimize.adscisco(o, s1)
        const optimize.Sgd o2 ← optimize.adscisco(o1, s2)
        const optimize.Sgd o3 ← optimize.adscisco(o2, s3)
        const optimize.Sgd o4 ← optimize.adscisco(o3, s4)
        wire ← optimize.serializa(o4)
    }
    catch err {
        return wire
    }
    return wire
}

test "the accepted schedule evaluates to lr 0.1 at every step (vertex == finis)" {
    do {
        const train.Schedula s ← train.structa_schedula(0.1 ∷ f32, 0, 1, 0.1 ∷ f32)
        const f32 l0 ← train.lentus_schedulata(s, 0)
        const f32 l50 ← train.lentus_schedulata(s, 50)
        const f32 l99 ← train.lentus_schedulata(s, 99)
        assert l0 ≡ 0.1 ∷ f32
        assert l50 ≡ 0.1 ∷ f32
        assert l99 ≡ 0.1 ∷ f32
    }
    catch err {
        assert false
    }
}

test "the convergence gate holds: final/initial ratio < 0.1" {
    do {
        # f64 evaluations of the accepted oracle (examples/training/mlp):
        const f32 l0 ← 1.576448169383708 ∷ f32
        const f32 l99 ← 0.017928625511508454 ∷ f32
        assert l99 / l0 ≺ 0.1 ∷ f32
    }
    catch err {
        assert false
    }
}

test "the trajectory pins descend monotonically toward the target" {
    do {
        # f64 evaluations: steps 0/10/50/75 of the accepted oracle.
        const f32 l0 ← 1.576448169383708 ∷ f32
        const f32 l10 ← 0.7815377070077427 ∷ f32
        const f32 l50 ← 0.13848813116166797 ∷ f32
        const f32 l75 ← 0.04746405569680761 ∷ f32
        assert l10 ≺ l0
        assert l50 ≺ l10
        assert l75 ≺ l50
    }
    catch err {
        assert false
    }
}

test "the four-slot state wire + RNG + epoch/step round-trips (tabula_aequus) and resumes" {
    do {
        const train.Semen s ← train.structa_semen(1)
        const train.Tabula c ← train.structa_tabula(0, 100, s, sgd_wire_4())
        const train.Tabula t ← train.deserializa_tabula(train.serializa_tabula(c))
        assert train.tabula_aequus(c, t)
        # The embedded four-slot state wire validates at resume.
        assert deserializa_optimum(t.statum_wire()) ≡ "ok"
    }
    catch err {
        assert false
    }
}

test "the same schedule and the same seed reproduce the same lr sequence and draws" {
    do {
        const train.Schedula s ← train.structa_schedula(0.1 ∷ f32, 0, 1, 0.1 ∷ f32)
        const f32 a ← train.lentus_schedulata(s, 50)
        const f32 b ← train.lentus_schedulata(s, 50)
        assert a ≡ b
        const train.Semen s1 ← train.structa_semen(1)
        const train.Semen s2 ← train.structa_semen(1)
        const train.FructusF32 d1 ← train.proximus_f32(s1)
        const train.FructusF32 d2 ← train.proximus_f32(s2)
        assert d1.valor() ≡ d2.valor()
    }
    catch err {
        assert false
    }
}
