# Co-located package test for train.fab (PML4-U4 — schedules + train/eval
# mode). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * Schedula — the warmup + cosine learning-rate schedule: construction
#     (full fields; fail-closed on non-finite/negative rates, finis above
#     vertex, negative warmup, empty or short horizon), the documented
#     evaluation (linear warmup ramp, cosine decay, horizon clamp), and
#     determinism (pure — no RNG, no hidden state: equal inputs produce
#     equal lr).
#   * Modus — the train/eval mode control: construction from the canonical
#     names ("train" | "eval"), name round-trip, predicates, fail-closed on
#     an unknown name.
#   * dropout_pars — the dropout/RNG policy gate: eval mode is identity
#     (effective rate 0), train mode carries the configured rate; the rate
#     domain [0, 1] is enforced (fail closed). Explicit mode argument only
#     — no hidden global state (the shared-layer rule).
#
# Oracle pins: f64 evaluations of the documented schedule formulas
#   lr(step) = vertex·step/warmup                         step < warmup
#   lr(step) = finis + (vertex−finis)·(1+cos(π·t))/2       step ≥ warmup
# for the canonical rows:
#   A: vertex 0.1, warmup 5, total 25, finis 0 —
#      step 1 → 0.02; step 3 → 0.06; step 5 → 0.1 (boundary, continuous);
#      step 15 → 0.05 (t = 0.5); step 25 → 0.0 (t = 1); step 100 → 0.0
#      (clamped to the horizon).
#   B: vertex 0.2, warmup 3, total 11, finis 0.05 —
#      step 0 → 0.0; step 7 → 0.125 (t = 0.5).
# The production surface is f32 self-hosted (cos via the Taylor series —
# the attention.fab precedent, argument always in [0, π]); the f64 oracle
# pins are compared under a documented 5e-4 absolute tolerance (the
# loss.proba f32-vs-f64 posture). The auditor-owned runtime-evidence gate
# compares executed evaluations against these pins.
#
# EVIDENCE HONESTY (CTO Q2, hard): this suite is STRUCTURAL proof. No
# executed schedule value or mode-policy value is claimed here; the oracle
# pins are f64 evaluations of the documented formulas. Executed
# value-identity is env-blocked tree-wide today (FMIR stepper /
# library-import gap — recorded residual); PML4-U4 is PARTIAL and
# value-identity is deferred to the auditor-owned runtime-evidence gate.
#
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/train.proba` proves the suite
# type-checks. Execution of proba bodies is env-blocked tree-wide today
# (recorded residual); this suite is the compile-level proof of the
# contract.

importa ex "gradus:train" privata train
importa ex "gradus:optimize" privata optimize
importa ex "gradus:tensor" privata tensor

# ---- helpers (the loss.proba / gradient.proba pattern)

# Renders a schedule-construction outcome as textus: "ok" on success, the
# typed error's causa on rejection.
functio schedula_detail(f32 lentus_vertex, numerus incalesco, numerus passus_total, f32 lentus_finis) → textus {
    fac {
        fixum train.Schedula _ ← train.structa_schedula(lentus_vertex, incalesco, passus_total, lentus_finis)
        redde "ok"
    }
    cape err {
        redde train.causa(err)
    }
}

# Renders a schedule-evaluation outcome as textus.
functio lentus_detail(train.Schedula s, numerus passus) → textus {
    fac {
        fixum f32 _ ← train.lentus_schedulata(s, passus)
        redde "ok"
    }
    cape err {
        redde train.causa(err)
    }
}

# Renders a mode-construction outcome as textus.
functio modus_detail(textus nomen) → textus {
    fac {
        fixum train.Modus _ ← train.modus(nomen)
        redde "ok"
    }
    cape err {
        redde train.causa(err)
    }
}

# Renders a dropout-policy outcome as textus.
functio dropout_detail(train.Modus m, f32 rate) → textus {
    fac {
        fixum f32 _ ← train.dropout_pars(m, rate)
        redde "ok"
    }
    cape err {
        redde train.causa(err)
    }
}

# ---- oracle pins (f64 evaluations of the documented schedule formulas)

# Row A: vertex 0.1, warmup 5, total 25, finis 0.
#   step 1  → 0.1·1/5     = 0.02      (warmup ramp)
#   step 3  → 0.1·3/5     = 0.06      (warmup ramp)
#   step 5  → 0.1·(1+cos 0)/2 = 0.1   (boundary — continuous with the ramp)
#   step 15 → 0.1·(1+cos(π/2))/2 = 0.05 (t = 0.5)
#   step 25 → 0.1·(1+cos π)/2 = 0.0   (t = 1)
#   step 100 → 0.0                    (clamped to the horizon)
# Row B: vertex 0.2, warmup 3, total 11, finis 0.05.
#   step 0  → 0.2·0/3     = 0.0       (warmup ramp)
#   step 7  → 0.05 + 0.15·(1+cos(π/2))/2 = 0.125 (t = 0.5)
# — f64 evaluations; pins for the auditor-owned runtime-evidence gate.
fixum f32 LENTUS_ORACLE_A1 ← (0.02 ∷ f32)
fixum f32 LENTUS_ORACLE_A3 ← (0.06 ∷ f32)
fixum f32 LENTUS_ORACLE_A5 ← (0.1 ∷ f32)
fixum f32 LENTUS_ORACLE_A15 ← (0.05 ∷ f32)
fixum f32 LENTUS_ORACLE_A25 ← (0.0 ∷ f32)
fixum f32 LENTUS_ORACLE_A100 ← (0.0 ∷ f32)
fixum f32 LENTUS_ORACLE_B0 ← (0.0 ∷ f32)
fixum f32 LENTUS_ORACLE_B7 ← (0.125 ∷ f32)

# Absolute tolerance for the f32 self-hosted schedule vs the f64 oracle
# pins (the loss.proba f32-vs-f64 posture; covers the cosine Taylor
# remainder over [0, π]).
fixum f32 LENTUS_TOLERATIO ← (0.0005 ∷ f32)

# ---- Schedula construction

probandum "train schedule — construction" {
    proba "structa_schedula builds a schedule config with full fields" {
        fac {
            fixum train.Schedula s ← train.structa_schedula((0.1 ∷ f32), 5, 25, (0.0 ∷ f32))
            adfirma s.lentus_vertex() ≡ (0.1 ∷ f32)
            adfirma s.incalesco() ≡ 5
            adfirma s.passus_total() ≡ 25
            adfirma s.lentus_finis() ≡ (0.0 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "structa_schedula rejects a negative peak rate" {
        adfirma schedula_detail((0.0 - 0.1 ∷ f32), 5, 25, (0.0 ∷ f32)) ≡ "invalid peak learning rate"
    }

    proba "structa_schedula rejects a non-finite peak rate" {
        adfirma schedula_detail((1.0 / 0.0 ∷ f32), 5, 25, (0.0 ∷ f32)) ≡ "invalid peak learning rate"
    }

    proba "structa_schedula rejects a negative final rate" {
        adfirma schedula_detail((0.1 ∷ f32), 5, 25, (0.0 - 0.01 ∷ f32)) ≡ "invalid final learning rate"
    }

    proba "structa_schedula rejects a final rate above the peak" {
        adfirma schedula_detail((0.1 ∷ f32), 5, 25, (0.2 ∷ f32)) ≡ "final learning rate above peak"
    }

    proba "structa_schedula rejects negative warmup steps" {
        adfirma schedula_detail((0.1 ∷ f32), 0 - 1, 25, (0.0 ∷ f32)) ≡ "negative warmup steps"
    }

    proba "structa_schedula rejects an empty horizon" {
        adfirma schedula_detail((0.1 ∷ f32), 0, 0, (0.0 ∷ f32)) ≡ "schedule horizon must be at least one step"
    }

    proba "structa_schedula rejects a warmup longer than the horizon" {
        adfirma schedula_detail((0.1 ∷ f32), 30, 25, (0.0 ∷ f32)) ≡ "warmup exceeds the schedule horizon"
    }
}

# ---- the schedule evaluation vs the f64 oracle pins

probandum "train schedule — evaluation oracle pins" {
    proba "row A warmup ramp matches the f64 formula (lr = vertex·step/warmup)" {
        fac {
            fixum train.Schedula s ← train.structa_schedula((0.1 ∷ f32), 5, 25, (0.0 ∷ f32))
            fixum f32 l1 ← train.lentus_schedulata(s, 1)
            fixum f32 l3 ← train.lentus_schedulata(s, 3)
            adfirma l1.approximata(LENTUS_ORACLE_A1, LENTUS_TOLERATIO)
            adfirma l3.approximata(LENTUS_ORACLE_A3, LENTUS_TOLERATIO)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "row A boundary is continuous (step == warmup is the peak lr)" {
        fac {
            fixum train.Schedula s ← train.structa_schedula((0.1 ∷ f32), 5, 25, (0.0 ∷ f32))
            fixum f32 l5 ← train.lentus_schedulata(s, 5)
            adfirma l5.approximata(LENTUS_ORACLE_A5, LENTUS_TOLERATIO)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "row A cosine decay matches the f64 formula (mid-decay and horizon)" {
        fac {
            fixum train.Schedula s ← train.structa_schedula((0.1 ∷ f32), 5, 25, (0.0 ∷ f32))
            fixum f32 l15 ← train.lentus_schedulata(s, 15)
            fixum f32 l25 ← train.lentus_schedulata(s, 25)
            adfirma l15.approximata(LENTUS_ORACLE_A15, LENTUS_TOLERATIO)
            adfirma l25.approximata(LENTUS_ORACLE_A25, LENTUS_TOLERATIO)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "row A post-horizon steps are clamped to the final lr" {
        fac {
            fixum train.Schedula s ← train.structa_schedula((0.1 ∷ f32), 5, 25, (0.0 ∷ f32))
            fixum f32 l100 ← train.lentus_schedulata(s, 100)
            adfirma l100.approximata(LENTUS_ORACLE_A100, LENTUS_TOLERATIO)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "row B (non-zero final lr) matches the f64 formula" {
        fac {
            fixum train.Schedula s ← train.structa_schedula((0.2 ∷ f32), 3, 11, (0.05 ∷ f32))
            fixum f32 l0 ← train.lentus_schedulata(s, 0)
            fixum f32 l7 ← train.lentus_schedulata(s, 7)
            adfirma l0.approximata(LENTUS_ORACLE_B0, LENTUS_TOLERATIO)
            adfirma l7.approximata(LENTUS_ORACLE_B7, LENTUS_TOLERATIO)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a degenerate horizon (total == warmup) is constant at the peak" {
        fac {
            fixum train.Schedula s ← train.structa_schedula((0.1 ∷ f32), 5, 5, (0.0 ∷ f32))
            fixum f32 l6 ← train.lentus_schedulata(s, 6)
            adfirma l6.approximata(LENTUS_ORACLE_A5, LENTUS_TOLERATIO)
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- schedule determinism + fail-closed evaluation

probandum "train schedule — determinism and evaluation errors" {
    proba "equal inputs produce equal lr (pure — no RNG, no hidden state)" {
        fac {
            fixum train.Schedula s ← train.structa_schedula((0.1 ∷ f32), 5, 25, (0.0 ∷ f32))
            fixum f32 a ← train.lentus_schedulata(s, 15)
            fixum f32 b ← train.lentus_schedulata(s, 15)
            adfirma a ≡ b
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a negative step is rejected (step counts are non-negative)" {
        fac {
            fixum train.Schedula s ← train.structa_schedula((0.1 ∷ f32), 5, 25, (0.0 ∷ f32))
            adfirma lentus_detail(s, 0 - 1) ≡ "schedule step must be non-negative"
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- the train/eval mode control

probandum "train mode — construction and predicates" {
    proba "modus(\"train\") is train mode; the name round-trips" {
        fac {
            fixum train.Modus m ← train.modus("train")
            adfirma train.modus_nomen(m) ≡ "train"
            adfirma train.est_disciplina(m)
            adfirma non (train.est_aestimatio(m))
        }
        cape err {
            adfirma falsum
        }
    }

    proba "modus(\"eval\") is eval mode; the name round-trips" {
        fac {
            fixum train.Modus m ← train.modus("eval")
            adfirma train.modus_nomen(m) ≡ "eval"
            adfirma train.est_aestimatio(m)
            adfirma non (train.est_disciplina(m))
        }
        cape err {
            adfirma falsum
        }
    }

    proba "an unknown mode name fails closed" {
        adfirma modus_detail("infer") ≡ "unknown mode name"
    }
}

# ---- the dropout/RNG policy gate (explicit mode, no hidden state)

probandum "train mode — dropout policy gate" {
    proba "train mode carries the configured dropout rate" {
        fac {
            fixum train.Modus m ← train.modus("train")
            fixum f32 r ← train.dropout_pars(m, (0.5 ∷ f32))
            adfirma r ≡ (0.5 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "eval mode is dropout identity (effective rate 0)" {
        fac {
            fixum train.Modus m ← train.modus("eval")
            fixum f32 r ← train.dropout_pars(m, (0.5 ∷ f32))
            adfirma r ≡ (0.0 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the policy is deterministic (explicit mode argument — no hidden global state)" {
        fac {
            fixum train.Modus m ← train.modus("eval")
            fixum f32 a ← train.dropout_pars(m, (0.9 ∷ f32))
            fixum f32 b ← train.dropout_pars(m, (0.9 ∷ f32))
            adfirma a ≡ b
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a rate above 1 is rejected (the [0, 1] domain)" {
        fac {
            fixum train.Modus m ← train.modus("train")
            adfirma dropout_detail(m, (1.5 ∷ f32)) ≡ "dropout rate must be in [0, 1]"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a negative rate is rejected" {
        fac {
            fixum train.Modus m ← train.modus("train")
            adfirma dropout_detail(m, (0.0 - 0.1 ∷ f32)) ≡ "dropout rate must be in [0, 1]"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a non-finite rate is rejected" {
        fac {
            fixum train.Modus m ← train.modus("train")
            adfirma dropout_detail(m, (1.0 / 0.0 ∷ f32)) ≡ "dropout rate must be in [0, 1]"
        }
        cape err {
            adfirma falsum
        }
    }
}

# =========================================================================
# PML4-U5 — seeds (RNG), dropout mask, checkpoint resume (compile-level)
# =========================================================================
#
# The U5 sections prove, at compile level:
#   * Semen — the xorshift64 seed/RNG: construction (zero rejected), the
#     exact deterministic state sequence (f64/e64 oracle pins for seeds 1
#     and 42), the [0,1) f32 draws, the versioned wire round-trip
#     (including a negative state), and reproducibility (same seed → same
#     sequence).
#   * excutio — the dropout-mask composition over the U4 gate: eval mode
#     is identity and the RNG is untouched; train mode applies the
#     per-element Bernoulli mask at 1−rate scaled by 1/(1−rate), matching
#     the f64 oracle pin for a concrete (tensor, seed, rate); same inputs
#     reproduce the same output and the same advanced RNG state.
#   * Tabula — the checkpoint envelope: construction (fail-closed epoch/
#     step/empty-wire), the exact versioned wire round-trip with an
#     embedded U3 optimizer-state wire (verbatim), the signed RNG-state
#     round-trip, the rejections (unknown markers/schema, malformed
#     fields, zero RNG state), and the explicit interrupted-resume
#     failure: a corrupt embedded state wire is carried verbatim by the
#     envelope but FAILS CLOSED at optimize.deserializa (resume).
#
# Oracle pins: the xorshift64 state values are exact i64 evaluations of
# the documented recurrence (x ^= x<<13; x ^= x>>7; x ^= x<<17, the >> is
# arithmetic on i64). The draws are (state ∧ 2^63−1) >> 11 over 2^52
# (f64 evaluations; the production surface casts to f32, rounding ≤ ~1e-7
# — pins compare within a documented 1e-6 tolerance). The dropout-mask
# pin [0, 0, 0, 8.0] is exact arithmetic (0.5, 2.0, 4.0 are exact f32).
# No executed value is claimed here (CTO Q2); the auditor-owned
# runtime-evidence gate compares executed values against these pins.

# ---- U5 helpers

# Build a staged tensor, swallowing the never-firing construction errors.
functio tene(lista<f32> datos, lista<numerus> forma) → tensor.Tensor {
    varia tensor.Tensor t
    fac {
        t ← tensor.structa(datos, forma)
    }
    cape err {
        redde t
    }
    redde t
}

# Staged-result element read (swallow the never-firing access errors).
functio e1(tensor.Tensor t, numerus i) → f32 {
    fac {
        redde t.accipe([i])
    }
    cape err {
        redde (0.0 - 999.0) ∷ f32
    }
}

# A two-slot U3 optimizer-state wire (the checkpoint's embedded state),
# swallowing the never-firing OptimizeError (single-error-type fac).
functio sgd_wire_2() → textus {
    varia textus wire ← ""
    fac {
        fixum optimize.Sgd o ← optimize.sgd_vacuum()
        fixum optimize.SgdStatum s1 ← optimize.structa("w1", "model", 1, (0.01 ∷ f32))
        fixum optimize.SgdStatum s2 ← optimize.structa("b1", "model", 1, (0.001 ∷ f32))
        fixum optimize.Sgd o2 ← optimize.adscisco(o, s1)
        fixum optimize.Sgd o3 ← optimize.adscisco(o2, s2)
        wire ← optimize.serializa(o3)
    }
    cape err {
        redde wire
    }
    redde wire
}

# Resume-path state-wire deserialization outcome (the embedded wire
# validates against ITS OWN schema — optimize.deserializa).
functio deserializa_optimum(textus wire) → textus {
    fac {
        fixum optimize.Sgd _ ← optimize.deserializa(wire)
        redde "ok"
    }
    cape err {
        redde optimize.causa(err)
    }
}

# Renders an RNG-construction outcome as textus.
functio semen_detail(numerus semen) → textus {
    fac {
        fixum train.Semen _ ← train.structa_semen(semen)
        redde "ok"
    }
    cape err {
        redde train.causa(err)
    }
}

# Renders an RNG-wire deserialization outcome as textus.
functio deserializa_semen_detail(textus wire) → textus {
    fac {
        fixum train.Semen _ ← train.deserializa_semen(wire)
        redde "ok"
    }
    cape err {
        redde train.causa(err)
    }
}

# Renders a checkpoint-construction outcome as textus.
functio tabula_detail(numerus aetas, numerus passus, train.Semen rng, textus statum_wire) → textus {
    fac {
        fixum train.Tabula _ ← train.structa_tabula(aetas, passus, rng, statum_wire)
        redde "ok"
    }
    cape err {
        redde train.causa(err)
    }
}

# Renders a checkpoint-wire deserialization outcome as textus.
functio deserializa_tabula_detail(textus wire) → textus {
    fac {
        fixum train.Tabula _ ← train.deserializa_tabula(wire)
        redde "ok"
    }
    cape err {
        redde train.causa(err)
    }
}

# ---- the seed/RNG contract

probandum "train seed — Semen construction and determinism" {
    proba "structa_semen seeds the generator" {
        fac {
            fixum train.Semen s ← train.structa_semen(1)
            adfirma s.status() ≡ 1
        }
        cape err {
            adfirma falsum
        }
    }

    proba "structa_semen rejects the zero seed (xorshift64 degenerates at 0)" {
        adfirma semen_detail(0) ≡ "seed must be non-zero"
    }

    proba "the same seed reproduces the same first draw (reproducibility)" {
        fac {
            fixum train.Semen s1 ← train.structa_semen(1)
            fixum train.Semen s2 ← train.structa_semen(1)
            fixum train.Fructus a ← train.proximus(s1)
            fixum train.Fructus b ← train.proximus(s2)
            adfirma a.valor() ≡ b.valor()
        }
        cape err {
            adfirma falsum
        }
    }
}

probandum "train seed — xorshift64 state oracle pins (f64/e64 evaluations)" {
    proba "seed 1 state sequence matches the documented recurrence" {
        fac {
            fixum train.Semen s0 ← train.structa_semen(1)
            fixum train.Fructus f1 ← train.proximus(s0)
            # x ^= x<<13; x ^= x>>7 (arithmetic on i64); x ^= x<<17.
            adfirma f1.valor() ≡ 1082269761
            fixum train.Fructus f2 ← train.proximus(f1.semen())
            adfirma f2.valor() ≡ 1152992998833853505
            fixum train.Fructus f3 ← train.proximus(f2.semen())
            adfirma f3.valor() ≡ (0 - 7269227409276787159)
            fixum train.Fructus f4 ← train.proximus(f3.semen())
            adfirma f4.valor() ≡ (0 - 768720241707614171)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "seed 42 first state matches the documented recurrence" {
        fac {
            fixum train.Semen s ← train.structa_semen(42)
            fixum train.Fructus f ← train.proximus(s)
            adfirma f.valor() ≡ 45454805674
        }
        cape err {
            adfirma falsum
        }
    }
}

probandum "train seed — [0,1) draws (f64 oracle pins)" {
    proba "seed 1 draws match the documented (state ∧ 2^63−1) >> 11 / 2^52 formula" {
        fac {
            fixum train.Semen s0 ← train.structa_semen(1)
            fixum train.FructusF32 d1 ← train.proximus_f32(s0)
            fixum train.FructusF32 d2 ← train.proximus_f32(d1.semen())
            fixum train.FructusF32 d3 ← train.proximus_f32(d2.semen())
            fixum train.FructusF32 d4 ← train.proximus_f32(d3.semen())
            # f64 evaluations: 0.12500775141962395, 0.21186878505709306,
            # 0.9166551843907023 (the first draw, ~1.17e-10, is pinned by
            # the bound below and the exact state pins above).
            adfirma d1.valor().approximata((0.1250078 ∷ f32), (0.000001 ∷ f32))
            adfirma d2.valor().approximata((0.2118688 ∷ f32), (0.000001 ∷ f32))
            adfirma d3.valor().approximata((0.9166552 ∷ f32), (0.000001 ∷ f32))
            adfirma d4.valor() < (0.000001 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }
}

probandum "train seed — RNG wire round-trip" {
    proba "the RNG wire round-trips a positive state exactly" {
        fac {
            fixum train.Semen s ← train.structa_semen(42)
            fixum train.Semen t ← train.deserializa_semen(train.serializa_semen(s))
            adfirma t.status() ≡ 42
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the RNG wire round-trips a negative state exactly (signed i64 status)" {
        fac {
            fixum train.Semen s0 ← train.structa_semen(1)
            fixum train.Fructus f1 ← train.proximus(s0)
            fixum train.Fructus f2 ← train.proximus(f1.semen())
            fixum train.Fructus f3 ← train.proximus(f2.semen())
            # f3.semen().status() is the signed i64 value -7269227409276787159.
            fixum train.Semen t ← train.deserializa_semen(train.serializa_semen(f3.semen()))
            adfirma t.status() ≡ f3.semen().status()
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the RNG wire rejects an unknown marker and a zero state" {
        adfirma deserializa_semen_detail("tensor/rng/1.0.0/42") ≡ "unknown rng marker"
        adfirma deserializa_semen_detail("train/rng/1.0.0/0") ≡ "seed must be non-zero"
    }
}

# ---- the dropout mask (the U4 gate's RNG seam composition)

probandum "train dropout — excutio mask over the U4 gate" {
    proba "eval mode is identity and the RNG is untouched (standard evaluation policy)" {
        fac {
            fixum train.Modus m ← train.modus("eval")
            fixum train.Semen s ← train.structa_semen(1)
            fixum train.Excutio r ← train.excutio(tene([1.0, 2.0, 3.0, 4.0], [4]), s, m, (0.5 ∷ f32))
            adfirma e1(r.valor(), 0) ≡ (1.0 ∷ f32)
            adfirma e1(r.valor(), 3) ≡ (4.0 ∷ f32)
            adfirma r.semen().status() ≡ s.status()
        }
        cape err {
            adfirma falsum
        }
    }

    proba "train mode mask matches the f64 oracle pin (seed 1, rate 0.5, x=[1,2,3,4])" {
        fac {
            fixum train.Modus m ← train.modus("train")
            fixum train.Semen s ← train.structa_semen(1)
            fixum train.Excutio r ← train.excutio(tene([1.0, 2.0, 3.0, 4.0], [4]), s, m, (0.5 ∷ f32))
            # Draws from seed 1: 1.17e-10, 0.1250, 0.2119, 0.9167. Elements
            # 0-2 drop (r < 0.5 → 0.0); element 3 keeps (r = 0.9167 ≥ 0.5)
            # scaled by 1/(1−0.5) = 2 → 4.0·2 = 8.0. Exact f32 arithmetic.
            adfirma e1(r.valor(), 0) ≡ (0.0 ∷ f32)
            adfirma e1(r.valor(), 1) ≡ (0.0 ∷ f32)
            adfirma e1(r.valor(), 2) ≡ (0.0 ∷ f32)
            adfirma e1(r.valor(), 3) ≡ (8.0 ∷ f32)
            # The RNG advanced through the 4th draw: state 4 of seed 1.
            adfirma r.semen().status() ≡ (0 - 8787613929710185883)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the mask is deterministic (same inputs → same output and same advanced RNG)" {
        fac {
            fixum train.Modus m ← train.modus("train")
            fixum train.Semen s ← train.structa_semen(1)
            fixum train.Excutio a ← train.excutio(tene([1.0, 2.0, 3.0, 4.0], [4]), s, m, (0.5 ∷ f32))
            fixum train.Excutio b ← train.excutio(tene([1.0, 2.0, 3.0, 4.0], [4]), s, m, (0.5 ∷ f32))
            adfirma e1(a.valor(), 3) ≡ e1(b.valor(), 3)
            adfirma a.semen().status() ≡ b.semen().status()
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- the checkpoint envelope (Tabula)

probandum "train checkpoint — construction" {
    proba "structa_tabula builds a checkpoint with epoch, step, RNG, and state wire" {
        fac {
            fixum train.Semen s ← train.structa_semen(42)
            fixum train.Tabula c ← train.structa_tabula(2, 37, s, sgd_wire_2())
            adfirma c.aetas() ≡ 2
            adfirma c.passus() ≡ 37
            adfirma c.rng().status() ≡ 42
            adfirma c.statum_wire().longitudo() > 0
        }
        cape err {
            adfirma falsum
        }
    }

    proba "structa_tabula rejects a negative epoch and a negative step" {
        fac {
            fixum train.Semen s ← train.structa_semen(42)
            adfirma tabula_detail(0 - 1, 0, s, sgd_wire_2()) ≡ "epoch must be non-negative"
            adfirma tabula_detail(0, 0 - 1, s, sgd_wire_2()) ≡ "step must be non-negative"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "structa_tabula rejects an empty state wire" {
        fac {
            fixum train.Semen s ← train.structa_semen(42)
            adfirma tabula_detail(0, 0, s, "") ≡ "checkpoint state wire is empty"
        }
        cape err {
            adfirma falsum
        }
    }
}

probandum "train checkpoint — versioned wire round-trip" {
    proba "the checkpoint wire round-trips exactly (epoch, step, RNG, embedded state verbatim)" {
        fac {
            fixum train.Semen s ← train.structa_semen(42)
            fixum train.Tabula c ← train.structa_tabula(2, 37, s, sgd_wire_2())
            fixum train.Tabula t ← train.deserializa_tabula(train.serializa_tabula(c))
            adfirma train.tabula_aequus(c, t)
            adfirma t.statum_wire() ≡ c.statum_wire()
            # The embedded state wire is valid at resume (optimize schema).
            adfirma deserializa_optimum(t.statum_wire()) ≡ "ok"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the checkpoint wire round-trips a negative RNG state exactly" {
        fac {
            fixum train.Semen s0 ← train.structa_semen(1)
            fixum train.Fructus f1 ← train.proximus(s0)
            fixum train.Fructus f2 ← train.proximus(f1.semen())
            fixum train.Fructus f3 ← train.proximus(f2.semen())
            fixum train.Tabula c ← train.structa_tabula(1, 3, f3.semen(), sgd_wire_2())
            fixum train.Tabula t ← train.deserializa_tabula(train.serializa_tabula(c))
            adfirma train.tabula_aequus(c, t)
            adfirma t.rng().status() ≡ (0 - 7269227409276787159)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "an interrupted (corrupt embedded state) wire fails closed at resume — explicitly" {
        fac {
            fixum train.Semen s ← train.structa_semen(42)
            # A checkpoint whose embedded state wire was truncated mid-write:
            # the envelope carries it verbatim (the two-layer contract)...
            fixum train.Tabula c ← train.structa_tabula(0, 0, s, "optimizer/sgd/1.0.0/2;optimizer/sgd-state/1.0.0/model/w1/1/1/0/0.01")
            fixum train.Tabula t ← train.deserializa_tabula(train.serializa_tabula(c))
            adfirma t.statum_wire() ≡ c.statum_wire()
            # ...and resume FAILS CLOSED at the state wire's own schema.
            adfirma deserializa_optimum(t.statum_wire()) ≡ "slot count mismatch in optimizer wire"
        }
        cape err {
            adfirma falsum
        }
    }
}

probandum "train checkpoint — wire rejections (fail closed)" {
    proba "an unknown checkpoint marker is rejected" {
        adfirma deserializa_tabula_detail("tensor/checkpoint/1.0.0/0/0/1/x") ≡ "unknown checkpoint marker"
    }

    proba "an unknown checkpoint schema version is rejected" {
        adfirma deserializa_tabula_detail("train/checkpoint/9.9.9/0/0/1/x") ≡ "unknown checkpoint schema version"
    }

    proba "a malformed checkpoint wire is rejected" {
        adfirma deserializa_tabula_detail("train/checkpoint/1.0.0/0") ≡ "malformed checkpoint wire"
    }

    proba "a non-numeric epoch is rejected" {
        adfirma deserializa_tabula_detail("train/checkpoint/1.0.0/abc/0/1/x") ≡ "malformed epoch in checkpoint wire"
    }

    proba "a zero RNG state in the checkpoint is rejected" {
        adfirma deserializa_tabula_detail("train/checkpoint/1.0.0/0/0/0/x") ≡ "seed must be non-zero"
    }
}

# =========================================================================
# PML4-U6 — bounded convergence + resume proof (compile-level)
# =========================================================================
#
# The composed loop (exempla/training-loop-mlp) drives the accepted MLP
# 4×4 workload through the U1–U5 surfaces toward the accepted oracle
# trajectory. This section proves, at compile level, the composition's
# pure facts and pins the accepted convergence target:
#
#   * the constant-lr schedule binding (the U4→U3 input): the accepted
#     schedule (vertex == finis == 0.1, warmup 0, horizon 1) evaluates to
#     lr = 0.1 at every step — the lr the loop binds into the optimizer
#     state slots (optimize.structa lentus);
#   * the accepted trajectory pins (f64 evaluations of the accepted
#     oracle, examples/training/mlp): steps 0/10/25/50/75/99 →
#     1.576448169383708 / 0.7815377070077427 / 0.4303461875641296 /
#     0.13848813116166797 / 0.04746405569680761 / 0.017928625511508454,
#     with the convergence gate final/initial = 0.01137 < 0.1;
#   * the composition-level resume round-trip: the loop's checkpoint (the
#     whole-optimizer state wire with the four MLP slots + the RNG state +
#     epoch/step) round-trips exactly (tabula_aequus) and the embedded
#     state wire validates at resume (optimize.deserializa);
#   * the deterministic-seed contract: the same schedule and the same RNG
#     seed reproduce the same lr sequence and the same draws (this
#     workload has no dropout, so the trajectory is seed-independent by
#     construction; the seed is carried by the checkpoint).
#
# The EXECUTED convergence (the loop's loss trajectory vs these pins) is
# env-blocked on both available lanes (the FMIR stepper library-import
# gap; the Rust emit lane cannot lower the AIR-lane backward companion —
# TARGETLANE001). This is the STRUCTURAL proof; executed value-identity
# is deferred to the auditor-owned runtime-evidence gate. PML4-U6 is
# PARTIAL per the CTO Q2 bar — no executed convergence is claimed.

# ---- U6 helpers

# The loop's whole-optimizer state wire: four MLP slots (w1/b1/w2/b2).
functio sgd_wire_4() → textus {
    varia textus wire ← ""
    fac {
        fixum optimize.Sgd o ← optimize.sgd_vacuum()
        fixum optimize.SgdStatum s1 ← optimize.structa("w1", "model.mlp", 1, (0.1 ∷ f32))
        fixum optimize.SgdStatum s2 ← optimize.structa("b1", "model.mlp", 1, (0.1 ∷ f32))
        fixum optimize.SgdStatum s3 ← optimize.structa("w2", "model.mlp", 1, (0.1 ∷ f32))
        fixum optimize.SgdStatum s4 ← optimize.structa("b2", "model.mlp", 1, (0.1 ∷ f32))
        fixum optimize.Sgd o1 ← optimize.adscisco(o, s1)
        fixum optimize.Sgd o2 ← optimize.adscisco(o1, s2)
        fixum optimize.Sgd o3 ← optimize.adscisco(o2, s3)
        fixum optimize.Sgd o4 ← optimize.adscisco(o3, s4)
        wire ← optimize.serializa(o4)
    }
    cape err {
        redde wire
    }
    redde wire
}

probandum "U6 convergence — the constant-lr schedule binding (U4→U3)" {
    proba "the accepted schedule evaluates to lr 0.1 at every step (vertex == finis)" {
        fac {
            fixum train.Schedula s ← train.structa_schedula((0.1 ∷ f32), 0, 1, (0.1 ∷ f32))
            fixum f32 l0 ← train.lentus_schedulata(s, 0)
            fixum f32 l50 ← train.lentus_schedulata(s, 50)
            fixum f32 l99 ← train.lentus_schedulata(s, 99)
            adfirma l0 ≡ (0.1 ∷ f32)
            adfirma l50 ≡ (0.1 ∷ f32)
            adfirma l99 ≡ (0.1 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }
}

probandum "U6 convergence — the accepted MLP 4×4 trajectory target" {
    proba "the convergence gate holds: final/initial ratio < 0.1" {
        fac {
            # f64 evaluations of the accepted oracle (examples/training/mlp):
            fixum f32 l0 ← (1.576448169383708 ∷ f32)
            fixum f32 l99 ← (0.017928625511508454 ∷ f32)
            adfirma (l99 / l0) < (0.1 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the trajectory pins descend monotonically toward the target" {
        fac {
            # f64 evaluations: steps 0/10/50/75 of the accepted oracle.
            fixum f32 l0 ← (1.576448169383708 ∷ f32)
            fixum f32 l10 ← (0.7815377070077427 ∷ f32)
            fixum f32 l50 ← (0.13848813116166797 ∷ f32)
            fixum f32 l75 ← (0.04746405569680761 ∷ f32)
            adfirma l10 < l0
            adfirma l50 < l10
            adfirma l75 < l50
        }
        cape err {
            adfirma falsum
        }
    }
}

probandum "U6 resume — the loop's checkpoint round-trips exactly" {
    proba "the four-slot state wire + RNG + epoch/step round-trips (tabula_aequus) and resumes" {
        fac {
            fixum train.Semen s ← train.structa_semen(1)
            fixum train.Tabula c ← train.structa_tabula(0, 100, s, sgd_wire_4())
            fixum train.Tabula t ← train.deserializa_tabula(train.serializa_tabula(c))
            adfirma train.tabula_aequus(c, t)
            # The embedded four-slot state wire validates at resume.
            adfirma deserializa_optimum(t.statum_wire()) ≡ "ok"
        }
        cape err {
            adfirma falsum
        }
    }
}

probandum "U6 determinism — deterministic-seed contract" {
    proba "the same schedule and the same seed reproduce the same lr sequence and draws" {
        fac {
            fixum train.Schedula s ← train.structa_schedula((0.1 ∷ f32), 0, 1, (0.1 ∷ f32))
            fixum f32 a ← train.lentus_schedulata(s, 50)
            fixum f32 b ← train.lentus_schedulata(s, 50)
            adfirma a ≡ b
            fixum train.Semen s1 ← train.structa_semen(1)
            fixum train.Semen s2 ← train.structa_semen(1)
            fixum train.FructusF32 d1 ← train.proximus_f32(s1)
            fixum train.FructusF32 d2 ← train.proximus_f32(s2)
            adfirma d1.valor() ≡ d2.valor()
        }
        cape err {
            adfirma falsum
        }
    }
}
