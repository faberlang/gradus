+++
locale = "en"
+++
# Supported differentiation contract: `@ radix backward` on a same-package
# typed loss whose forward body composes the typed layer rows below. Calls to
# annotated layers across package boundaries are rejected by the reverse-mode
# call-graph analysis (SEM004: `namespace_missing_export`); keep the annotated
# loss and its annotated-layer composition in one package. Other constructs
# outside the compiler's admitted differentiable typed-tensor operations are
# rejected by reverse-mode validation. The generated companion's positional
# `iuncta` tuple ABI is interim until record-shaped backward lands.
#
# Existing proba coverage exercises the runtime-shape carrier, not typed
# forward/loss equality or generated companion behavior. The typed training
# examples and proba evidence for these claims are not yet present; no
# arbitrary-shape/backend identity or general numerical error bound is claimed.
# PML3-U4 — forward with and without autograd (shared-layer phase thesis)
# =========================================================================
#
# The typed layer rows are the single spelling of each layer's math. The
# typed inference forwards and annotated training losses compose those rows.
# The runtime-shape carrier remains a separate inference residual.
#
# Evidence honesty: proba and executable examples cover the stated shapes and
# runs; they do not establish arbitrary-shape/backend identity or a general
# numerical error bound.

import from "gradus:dtype" dtype

import from "gradus:nn" nn

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# GradusError — typed error vocabulary of the MLP shared forward.
# Every variant carries a text message (render via message), mirroring the
# nn/tensor/shape error contract; nn error texts are preserved verbatim.
# -------------------------------------------------------------------------

@ public
union GradusError {
    @ shared
    string message

    NegativeDimension,
    DimensionAboveLimit,
    ProductAboveLimit,
    GradusMismatch,
    ShapeMismatch,
    Incompatible,
    DtypeMismatch,
    ElementMismatch
}

@ conversion
fn from_nn_error(nn.NnError err) → GradusError {
    match err {
        case nn.NnError.NegativeDimension let message {
            return variant NegativeDimension { message = message }
        }
        case nn.NnError.DimensionAboveLimit let message {
            return variant DimensionAboveLimit { message = message }
        }
        case nn.NnError.ProductAboveLimit let message {
            return variant ProductAboveLimit { message = message }
        }
        case nn.NnError.GradusMismatch let message {
            return variant GradusMismatch { message = message }
        }
        case nn.NnError.Incompatible let message {
            return variant Incompatible { message = message }
        }
        case nn.NnError.DtypeMismatch let message {
            return variant DtypeMismatch { message = message }
        }
        case _ {
            return variant ShapeMismatch { message = err.message }
        }
    }
}



# nn.linear_carrier wrapper — gradus:nn → GradusError (message text preserved).
fn linear(tensor.NumericBlock x, tensor.NumericBlock w, tensor.NumericBlock b) → tensor.NumericBlock ⇥ GradusError {
    return nn.linear_carrier(x, w, b)
}

# nn.gelu_carrier wrapper — gradus:nn → GradusError (message text preserved).
fn gelu(tensor.NumericBlock x) → tensor.NumericBlock ⇥ GradusError {
    return nn.gelu_carrier(x)
}

# -------------------------------------------------------------------------
# forward_mlp_carrier — the SHARED forward model composition (inference path,
# bare) over the staged carrier.
#
#   x  [M,K] input;  w1 [K,H], b1 ([H] per-channel or [M,H] same-shape);
#   w2 [H,N], b2 ([N] per-channel or [M,N] same-shape).
#
#   y = linear(gelu(linear(x, w1, b1)), w2, b2)
#
# Pure value function over the staged carrier — NO autograd import, NO
# @ radix backward annotation, NO tape. Shape-generic at runtime (R3);
# the F32 row is the admitted row (nn fail-closed on any other tag).
# -------------------------------------------------------------------------

@ public
fn forward_mlp_carrier(tensor.NumericBlock x, tensor.NumericBlock w1, tensor.NumericBlock b1, tensor.NumericBlock w2, tensor.NumericBlock b2) → tensor.NumericBlock ⇥ GradusError {
    let tensor.NumericBlock h1 ← linear(x, w1, b1)
    let tensor.NumericBlock a1 ← gelu(h1)
    return linear(a1, w2, b2)
}

# -------------------------------------------------------------------------
# nil() — void residual for the companion backward ABI (the gradient.fab
# nil precedent; required by the compiler-generated backward function to
# indicate no intermediate saves from the forward pass).
# -------------------------------------------------------------------------

@ public
fn nil() → void {
    pass
}

# --- Typed air-lane layer rows (GT03): ONE spelling of each layer's math,
# shared by the typed model forwards below and by every annotated training
# forward. Same-package air calls only — cross-package air composition is
# refused by the reverse-mode call graph (docs/training-forward-contract.md).

@ radix { lane = "air" }
@ public
fn layer_linear<size M, size K, size N>(tensor<f32, [M, K]> x, tensor<f32, [K, N]> w, tensor<f32, [M, N]> b) → tensor<f32, [M, N]> {
    return (x · w) + b
}

@ radix { lane = "air" }
@ public
fn layer_linear_channel<size M, size K, size N>(tensor<f32, [M, K]> x, tensor<f32, [K, N]> w, tensor<f32, [N]> b) → tensor<f32, [M, N]> {
    return (x · w).added_bias(b)
}

@ radix { lane = "air" }
@ public
fn layer_gelu<size M, size N>(tensor<f32, [M, N]> x) → tensor<f32, [M, N]> {
    return x.gelu()
}

# forward_mlp — the SHARED typed forward (the one definition training and
# inference both use; training enters through forward_mlp_loss below, which
# composes these same layer rows). Inference callers call this from ordinary
# (non-air) code.
@ radix { lane = "air" }
@ public
fn forward_mlp<size M, size K, size H, size N>(tensor<f32, [M, K]> input, tensor<f32, [K, H]> weight1, tensor<f32, [M, H]> bias1, tensor<f32, [H, N]> weight2, tensor<f32, [M, N]> bias2) → tensor<f32, [M, N]> {
    let tensor<f32, [M, H]> h1 ← layer_linear(input, weight1, bias1)
    let tensor<f32, [M, H]> a1 ← layer_gelu(h1)
    return layer_linear(a1, weight2, bias2)
}

# forward_linear — the value-only typed forward of the single-layer linear
# model with per-channel bias (inference path; training is forward_linear_loss).
@ radix { lane = "air" }
@ public
fn forward_linear<size M, size K, size N>(tensor<f32, [M, K]> x, tensor<f32, [K, N]> w, tensor<f32, [N]> b) → tensor<f32, [M, N]> {
    return layer_linear_channel(x, w, b)
}

# -------------------------------------------------------------------------
# forward_mlp_loss — the TRAINING-path composition (the same shared layer
# rows used by typed forward_mlp, plus MSE to a scalar). The compiler
# generates forward_mlp_loss_backward FROM this forward source; consumers
# call the companion through the import boundary (SEM004):
#
#   forward_mlp_loss_backward(input, w1, b1, w2, b2, target, nil(), upstream)
#     → iuncta(grad_input, grad_w1, grad_b1, grad_w2, grad_b2, grad_target)
#
# Arithmetic == the accepted MLP exemplum (examples/training/mlp 4×4,
# per-step oracle parity): linear → GELU → linear → MSE, composed through
# the same typed layer rows as inference.
# -------------------------------------------------------------------------

@ radix { lane = "air" }
@ radix backward "forward_mlp_loss_backward"
@ public
fn forward_mlp_loss<size M, size K, size H, size N>(tensor<f32, [M, K]> input, tensor<f32, [K, H]> weight1, tensor<f32, [M, H]> bias1, tensor<f32, [H, N]> weight2, tensor<f32, [M, N]> bias2, tensor<f32, [M, N]> target) → f32 {
    let tensor<f32, [M, H]> h1 ← layer_linear(input, weight1, bias1)
    let tensor<f32, [M, H]> a1 ← layer_gelu(h1)
    let tensor<f32, [M, N]> h2b ← layer_linear(a1, weight2, bias2)
    let tensor<f32, [M, N]> resd ← h2b - target
    let tensor<f32, [M, N]> sqrd ← resd ⊙ resd
    return sqrd.mean()
}

# forward_linear_loss — the TRAINING-path composition of the linear model
# (single layer, per-channel bias) + MSE. Companion ABI:
#   forward_linear_loss_backward(input, weight, bias, target, nil(), upstream)
#     → iuncta(grad_input, grad_weight, grad_bias, grad_target)

@ radix { lane = "air" }
@ radix backward "forward_linear_loss_backward"
@ public
fn forward_linear_loss<size M, size K, size N>(tensor<f32, [M, K]> input, tensor<f32, [K, N]> weight, tensor<f32, [N]> bias, tensor<f32, [M, N]> target) → f32 {
    let tensor<f32, [M, N]> y ← layer_linear_channel(input, weight, bias)
    let tensor<f32, [M, N]> resd ← y - target
    let tensor<f32, [M, N]> sqrd ← resd ⊙ resd
    return sqrd.mean()
}
#
# PML3-U4 (production-ml-library/pml3-delivery.md) — the phase-thesis surface
# lives in this leaf: one forward model composition (linear → GELU → linear)
# that runs BARE (inference path — forward_mlp_carrier over the staged carrier,
# NO autograd surface) and THROUGH the compiler-generated backward companion
# (training path — forward_mlp_loss, @ radix backward, the accepted MLP
# arithmetic). This is the shared-layer proof of pml0-module-dag.md §4: the
# nn/attention/transformer modules stay autograd-free; training requests
# gradient construction ONLY inside the annotated function, never in
# the forward path. The gradient-module wrapper rule still holds — the
# primitives and architecture blocks leak no @ radix annotations; this leaf
# carries the ONE training-path composition (U4's explicit write scope).
