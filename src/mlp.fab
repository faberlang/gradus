+++
locale = "en"
+++
# Two-layer MLP forward and training-path companion.
#
# Public import: import from "gradus:mlp" mlp
# Depends on: gradus:nn, gradus:tensor, gradus:dtype
#
# Architectural rule: this leaf is a bare architecture composition plus a
# training companion, not an artifact surface (model/ owns stored-weight
# admission). It joins Layer 6 with attention and transformer. The
# `@ radix backward` annotation stays confined here so nn/attention/
# transformer remain autograd-free (PML3-U4).
#
# =========================================================================
# PML3-U4 — forward with and without autograd (shared-layer phase thesis)
# =========================================================================
#
# --- Contract (pml3-delivery.md PML3-U4) ---------------------------------
# One forward model composition runs identically (a) bare (inference path)
# and (b) through the existing compiler-generated backward companion
# (training path); no forward path builds a gradient tape; the shared-layer
# definition from pml0-module-dag.md §4 is implemented and tested.
#
# --- The shared layer (both paths consume the same forward semantics) -----
#   forward_mlp(x, w1, b1, w2, b2)   = linear(gelu(linear(x, w1, b1)), w2, b2)
#       over the staged carrier (gradus:tensor Tensor). The inference path
#       calls THIS bare — no gradient path, no tape, no autograd import.
#   forward_mlp_loss(input, w1, b1, w2, b2, target) = mean((mlp(input) −
#       target)²) — the SAME layer composition (linear → GELU → linear) over
#       the compiler typed-tensor surface, annotated @ radix backward. The
#       compiler generates the backward companion (forward_mlp_loss_backward)
#       FROM this forward source — the training path. The arithmetic is the
#       accepted MLP exemplum (examples/training/mlp, 4×4, per-step oracle
#       parity): no forward path ever requests gradient construction.
#
# --- Evidence honesty (CTO Q2, hard) --------------------------------------
# This surface is the STRUCTURAL proof: mlp.fab imports NO autograd module
# (no gradus:gradient, no tape); the forward path (forward_mlp) is a pure
# value function; gradient construction is requested only by the ONE
# training-path annotation. It does NOT prove runtime identity of bare
# forward vs the generated companion, companion behavior, or the numerical
# bound — library-to-library calls execute on the FMIR stepper (radix
# 43c0102ba; regression-locked by 2e8042ae7). The identity claim remains
# DEFERRED to a runtime-evidence gate (auditor-owned faber test path);
# U4 is PARTIAL.

import from "gradus:dtype" dtype

import from "gradus:nn" nn

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# GradusError — typed error vocabulary of the MLP shared forward.
# Every variant carries a text message (render via message), mirroring the
# nn/tensor/shape error contract; nn error texts are preserved verbatim.
# -------------------------------------------------------------------------

@ public { }
union GradusError {
    @ shared
    string message

    NegativeDimension,
    DimensionAboveLimit,
    ProductAboveLimit,
    GradusMismatch,
    ShapeMismatch,
    Incompatible,
    DtypeMismatch,
    ElementMismatch
}



# Map a documented nn error message text to the matching GradusError variant
# (variant identity per the nn vocabulary; the text is preserved verbatim —
# the transformer.fab _map_error pattern).
@ private { }
fn _map_error(string c) → GradusError {
    if c ≡ "negative dimension" then return variant NegativeDimension {message = c}
    if c ≡ "dimension above ceiling" then return variant DimensionAboveLimit {message = c}
    if c ≡ "element count above ceiling" then return variant ProductAboveLimit {message = c}
    if c ≡ "linear requires rank-2 input" or c ≡ "linear requires rank-2 weight" then return variant GradusMismatch {message = c}
    if c ≡ "inner dimensions mismatch" then return variant Incompatible {message = c}
    if c ≡ "dtype mismatch" or c ≡ "unsupported dtype for nn primitive" then return variant DtypeMismatch {message = c}
    return variant ShapeMismatch {message = c}
}

# nn.linear_carrier wrapper — gradus:nn → GradusError (message text preserved).
@ private { }
fn _linear(tensor.Tensor x, tensor.Tensor w, tensor.Tensor b) → tensor.Tensor ⇥ GradusError {
    do {
        return nn.linear_carrier(x, w, b)
    }
    catch err {
        throw _map_error(err.message)
    }
}

# nn.gelu wrapper — gradus:nn → GradusError (message text preserved).
@ private { }
fn _gelu(tensor.Tensor x) → tensor.Tensor ⇥ GradusError {
    do {
        return nn.gelu(x)
    }
    catch err {
        throw _map_error(err.message)
    }
}

# -------------------------------------------------------------------------
# forward_mlp — the SHARED forward model composition (inference path, bare).
#
#   x  [M,K] input;  w1 [K,H], b1 ([H] per-channel or [M,H] same-shape);
#   w2 [H,N], b2 ([N] per-channel or [M,N] same-shape).
#
#   y = linear(gelu(linear(x, w1, b1)), w2, b2)
#
# Pure value function over the staged carrier — NO autograd import, NO
# @ radix backward annotation, NO tape. Shape-generic at runtime (R3);
# the F32 row is the admitted row (nn fail-closed on any other tag).
# -------------------------------------------------------------------------

@ public { }
fn forward_mlp(tensor.Tensor x, tensor.Tensor w1, tensor.Tensor b1, tensor.Tensor w2, tensor.Tensor b2) → tensor.Tensor ⇥ GradusError {
    const tensor.Tensor h1 ← _linear(x, w1, b1)
    const tensor.Tensor a1 ← _gelu(h1)
    return _linear(a1, w2, b2)
}

# -------------------------------------------------------------------------
# nil() — void residual for the companion backward ABI (the gradient.fab
# nil precedent; required by the compiler-generated backward function to
# indicate no intermediate saves from the forward pass).
# -------------------------------------------------------------------------

@ public { }
fn nil() → void {
    pass
}

# -------------------------------------------------------------------------
# forward_mlp_loss — the TRAINING-path composition (the same shared forward
# over the compiler typed-tensor surface + MSE to a scalar). The compiler
# generates forward_mlp_loss_backward FROM this forward source; consumers
# call the companion through the import boundary (SEM004):
#
#   forward_mlp_loss_backward(input, w1, b1, w2, b2, target, nil(), upstream)
#     → iuncta(grad_input, grad_w1, grad_b1, grad_w2, grad_b2, grad_target)
#
# Arithmetic == the accepted MLP exemplum (examples/training/mlp 4×4,
# per-step oracle parity): linear → GELU → linear → MSE.
# -------------------------------------------------------------------------

@ radix { lane = "air" }
@ radix backward "forward_mlp_loss_backward"
@ public { }
fn forward_mlp_loss(tensor<f32, [4, 4]> input, tensor<f32, [4, 4]> weight1, tensor<f32, [4, 4]> bias1, tensor<f32, [4, 4]> weight2, tensor<f32, [4, 4]> bias2, tensor<f32, [4, 4]> target) → f32 {
    const _ h1 ← input · weight1
    const _ h1b ← h1 + bias1
    const _ a1 ← h1b.gelu()
    const _ h2 ← a1 · weight2
    const _ h2b ← h2 + bias2
    const _ resd ← h2b - target
    const _ sqrd ← resd ⊙ resd
    return sqrd.mean()
}
#
# PML3-U4 (production-ml-library/pml3-delivery.md) — the phase-thesis surface
# lives in this leaf: one forward model composition (linear → GELU → linear)
# that runs BARE (inference path — forward_mlp over the staged carrier, NO
# autograd surface) and THROUGH the compiler-generated backward companion
# (training path — forward_mlp_loss, @ radix backward, the accepted MLP
# arithmetic). This is the shared-layer proof of pml0-module-dag.md §4: the
# nn/attention/transformer modules stay autograd-free; training requests
# gradient construction ONLY inside the annotated function, never in
# the forward path. The gradient-module wrapper rule still holds — the
# primitives and architecture blocks leak no @ radix annotations; this leaf
# carries the ONE training-path composition (U4's explicit write scope).
