# -------------------------------------------------------------------------
# TokenizerError — typed error vocabulary of the tokenizer identity
# contract. Variant → class:
#   UnknownVersion       — unknown tokenizer identity schema version.
#   UnknownMergeKind    — un-admitted tokenizer kind (must be gpt2 / BBPE).
#   UnknownPreTokenizer         — un-admitted pre-tokenizer (must be smollm).
#   BadVocab      — vocab / merges / specials count mismatch.
#   BadDigest       — malformed vocabulary digest (not 64-hex).
#   BadEog            — malformed EOG set (must be {0, 2}).
#   IdExtra            — token id outside the admitted range [0, vocab).
#   ProbeDivergent     — probe id list diverges from the pinned fixture
#                        (a different tokenizer — must fail admission).
#   BadArtifact     — artifact tokenizer metadata is unavailable
#                        or malformed (LIB-02-U2 runtime).
#   BadMerges         — malformed merge entry in the artifact (U2).
#   UnknownId          — unknown token id in decode (out of range) (U2).
#   UnknownTrace   — display character with no byte mapping (U2).
#   BadUtf8           — byte sequence is not valid UTF-8 (U2).
#   BadWire           — malformed tokenizer identity wire form.
# -------------------------------------------------------------------------

@ public { }
union TokenizerError {
    UnknownVersion {
        string message
    },
    UnknownMergeKind {
        string message
    },
    UnknownPreTokenizer {
        string message
    },
    BadVocab {
        string message
    },
    BadDigest {
        string message
    },
    BadEog {
        string message
    },
    IdExtra {
        string message
    },
    ProbeDivergent {
        string message
    },
    BadArtifact {
        string message
    },
    BadMerges {
        string message
    },
    UnknownId {
        string message
    },
    UnknownTrace {
        string message
    },
    BadUtf8 {
        string message
    },
    BadWire {
        string message
    }
}

@ public { }
fn message(TokenizerError e) → string {
    match e {
        case UnknownVersion const message {
            return message
        }
        case UnknownMergeKind const message {
            return message
        }
        case UnknownPreTokenizer const message {
            return message
        }
        case BadVocab const message {
            return message
        }
        case BadDigest const message {
            return message
        }
        case BadEog const message {
            return message
        }
        case IdExtra const message {
            return message
        }
        case ProbeDivergent const message {
            return message
        }
        case BadArtifact const message {
            return message
        }
        case BadMerges const message {
            return message
        }
        case UnknownId const message {
            return message
        }
        case UnknownTrace const message {
            return message
        }
        case BadUtf8 const message {
            return message
        }
        case BadWire const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# TokenizerIdentity — the versioned tokenizer identity record. The
# field vocabulary mirrors the capsule's TokenizerIdentity (field 3) so
# the capsule can be built from this contract's values; the schema stamp
# makes the record versioned. Immutable — accessors only.
# -------------------------------------------------------------------------

@ public { }
class TokenizerIdentity {
    string schema
    string merge_kind
    string pre_tokenizer
    string vocab_digest
    string eog
    bool bos_free
    bool space_free

    fn schema() → string {
        return self.schema
    }

    fn merge_kind() → string {
        return self.merge_kind
    }

    fn pre_tokenizer() → string {
        return self.pre_tokenizer
    }

    fn vocab_digest() → string {
        return self.vocab_digest
    }

    fn eog() → string {
        return self.eog
    }

    fn bos_free() → bool {
        return self.bos_free
    }

    fn space_free() → bool {
        return self.space_free
    }
}

# -------------------------------------------------------------------------
# Private validation helpers. All return bool (predicates); construct and
# verify turn a falsum into the matching typed TokenizerError.
# -------------------------------------------------------------------------

# Hex-digit predicate for digest values.
@ private { }
fn _is_hex(string c) → bool {
    if ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9" then return true
    if ((((c ≡ "a" or c ≡ "b") or c ≡ "c") or c ≡ "d") or c ≡ "e") or c ≡ "f" then return true
    return false
}

# Whole-digest predicate: exactly 64 lowercase hex characters.
@ private { }
fn _hex_ok(string s) → bool {
    if s.length() ≠ 64 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _is_hex(s.get(i)) then return false
        i ← i + 1
    }
    return true
}

# Digit predicate (no negative sign — a "-" fails closed).
@ private { }
fn _is_digit(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

# EOG-set WELL-FORMEDNESS predicate: comma-separated, non-empty, strictly
# ascending, non-negative integer token ids. The EXACT pinned value {0, 2}
# is enforced separately in construct/verify (the admission-surface
# correctness fix: a well-formed-but-different set like "1,5" is a
# different tokenizer and fails closed).
@ private { }
fn _eog_ok(string eog) → bool {
    if eog.length() ≡ 0 then return false
    const list<string> partes ← eog.split(",")
    var int ultimum ← -1
    for from partes const p {
        if p.length() ≡ 0 then return false
        if p.length() ≻ 18 then return false
        var int i ← 0
        while i ≺ p.length() {
            if not _is_digit(p.get(i)) then return false
            i ← i + 1
        }
        do {
            const int v ← p ↦ int
            if v ≤ ultimum then return false
            ultimum ← v
        }
        catch err {
            return false
        }
    }
    return true
}

# Token id in range predicate: 0 ≤ id < VOCAB.
@ private { }
fn _id_in_range(int id) → bool {
    if id ≺ 0 then return false
    if id ≥ VOCAB then return false
    return true
}

# -------------------------------------------------------------------------
# probe_equal — exact id-list equality (the probe-parity predicate).
# Length + element-wise; the contract is exact match, nothing less.
# -------------------------------------------------------------------------

@ public { }
fn probe_equal(list<int> a, list<int> b) → bool {
    if a.length() ≠ b.length() then return false
    var int i ← 0
    while i ≺ a.length() {
        if a.get(i) coalesce 0 ≠ b.get(i) coalesce 0 then return false
        i ← i + 1
    }
    return true
}

# -------------------------------------------------------------------------
# probe_id — parse a comma-separated pinned id-list fixture into the id
# vector. Empty fixture → empty list (P4). Fail closed on malformed
# (non-digit / out-of-range) ids.
# -------------------------------------------------------------------------

@ public { }
fn probe_id(string pinned) → list<int> ⇥ TokenizerError {
    var list<int> out ← vacua
    if pinned.length() ≡ 0 then return out
    const list<string> partes ← pinned.split(",")
    for from partes const p {
        if p.length() ≡ 0 {
            throw variant BadWire {message = "malformed pinned id list"}
        }
        var int i ← 0
        while i ≺ p.length() {
            if not _is_digit(p.get(i)) {
                throw variant BadWire {message = "non-digit token id in pinned fixture"}
            }
            i ← i + 1
        }
        var int v ← 0
        do {
            v ← p ↦ int
        }
        catch err {
            throw variant BadWire {message = "malformed pinned id list"}
        }
        if not _id_in_range(v) {
            throw variant IdExtra {message = "token id out of range: " + p}
        }
        out.append(v)
    }
    return out
}

# -------------------------------------------------------------------------
# verify_probe — the fail-closed probe-parity admission check. Given an
# observed id list for a named pinned probe, it must match the pinned
# fixture EXACTLY; divergence fails closed with ProbeDivergent (a
# tokenizer whose ids diverge from the pinned probes is a different
# tokenizer and must fail admission — capsule contract §3.3).
# -------------------------------------------------------------------------

@ public { }
fn verify_probe(string name, list<int> observed) → bool ⇥ TokenizerError {
    const list<int> pinned ← probe_id(pinned_probe(name))
    if not probe_equal(pinned, observed) {
        throw variant ProbeDivergent {message = "tokenizer ids diverge from the pinned llama.cpp probe: " + name}
    }
    return true
}

# Pinned fixture lookup by probe name ("p1".."p11", "correctio", "brevis",
# "normale", "contextus"). Unknown name → fail closed.
@ public { }
fn pinned_probe(string name) → string ⇥ TokenizerError {
    if name ≡ "p1" then return PINNED_P1
    if name ≡ "p2" then return PINNED_P2
    if name ≡ "p4" then return PINNED_P4
    if name ≡ "p5" then return PINNED_P5
    if name ≡ "p6" then return PINNED_P6
    if name ≡ "p7" then return PINNED_P7
    if name ≡ "p8" then return PINNED_P8
    if name ≡ "p9" then return PINNED_P9
    if name ≡ "p10" then return PINNED_P10
    if name ≡ "p11" then return PINNED_P11
    if name ≡ "correctio" then return PINNED_CORRECTION
    if name ≡ "brevis" then return PINNED_BRIEF
    if name ≡ "normale" then return PINNED_NORMAL
    if name ≡ "contextus" then return PINNED_CONTEXT
    throw variant BadWire {message = "unknown pinned probe: " + name}
}

# -------------------------------------------------------------------------
# construct — the fail-closed tokenizer identity ADMISSION. Every field is
# validated against the pinned row before the identity is built; any
# violation throws the matching typed TokenizerError. Schema version
# rejection first (§5: unknown schema → typed failure before use).
# -------------------------------------------------------------------------

@ public { }
fn construct(string schema, string merge_kind, string pre_tokenizer, string vocab_digest, string eog, bool bos_free, bool space_free) → TokenizerIdentity ⇥ TokenizerError {
    if schema ≠ schema_version {
        throw variant UnknownVersion {message = "unknown tokenizer identity schema version: " + schema}
    }
    if merge_kind ≠ TOKENIZER_KIND {
        throw variant UnknownMergeKind {message = ("un-admitted tokenizer kind: " + merge_kind) + " (pinned row is gpt2 / byte-level BPE)"}
    }
    if pre_tokenizer ≠ TOKENIZER_PRE {
        throw variant UnknownPreTokenizer {message = ("un-admitted pre-tokenizer: " + pre_tokenizer) + " (pinned row is smollm)"}
    }
    if not _hex_ok(vocab_digest) {
        throw variant BadDigest {message = "malformed vocabulary digest"}
    }
    if not _eog_ok(eog) {
        throw variant BadEog {message = "malformed EOG set"}
    }
    # The exact pinned EOG value (the admission-surface correctness fix):
    # a well-formed-but-different set is a different tokenizer.
    if eog ≠ EOG {
        throw variant BadEog {message = "EOG set does not match the pinned row: " + eog}
    }
    # Pinned add-* flags are falsum ("add_bos_token = false"); the record's
    # bos_free / space_free are the POSITIVE facts (verum = BOS-free /
    # space-prefix-free). A row whose vacua flag equals the falsum add-*
    # state is NOT BOS-free / NOT space-prefix-free — fail closed (polarity
    # fix: was ≠, which inverted admission).
    if bos_free ≡ ADD_BOS {
        throw variant BadEog {message = "pinned row is BOS-free (add_bos_token = false)"}
    }
    if space_free ≡ ADD_SPACE {
        throw variant BadEog {message = "pinned row is space-prefix-free (add_space_prefix = false)"}
    }
    return TokenizerIdentity {schema = schema, merge_kind = merge_kind, pre_tokenizer = pre_tokenizer, vocab_digest = vocab_digest, eog = eog, bos_free = bos_free, space_free = space_free}
}

# -------------------------------------------------------------------------
# verify — consumer-side self-verification (self-verifying contract). Re-
# runs the admission matrix over the identity without re-deriving raw
# facts. An identity built by construct always passes; this is the
# defense-in-depth check for identities received across an owner boundary.
# -------------------------------------------------------------------------

@ public { }
fn verify(TokenizerIdentity t) → bool ⇥ TokenizerError {
    if t.schema() ≠ schema_version {
        throw variant UnknownVersion {message = "unknown tokenizer identity schema version: " + t.schema()}
    }
    if t.merge_kind() ≠ TOKENIZER_KIND {
        throw variant UnknownMergeKind {message = "un-admitted tokenizer kind: " + t.merge_kind()}
    }
    if t.pre_tokenizer() ≠ TOKENIZER_PRE {
        throw variant UnknownPreTokenizer {message = "un-admitted pre-tokenizer: " + t.pre_tokenizer()}
    }
    if not _hex_ok(t.vocab_digest()) {
        throw variant BadDigest {message = "malformed vocabulary digest"}
    }
    if not _eog_ok(t.eog()) {
        throw variant BadEog {message = "malformed EOG set"}
    }
    if t.eog() ≠ EOG {
        throw variant BadEog {message = "EOG set does not match the pinned row: " + t.eog()}
    }
    # Same polarity as construct: a vacua flag equal to the pinned falsum
    # add-* state means the row is NOT BOS-free / NOT space-prefix-free.
    if t.bos_free() ≡ ADD_BOS {
        throw variant BadEog {message = "pinned row is BOS-free"}
    }
    if t.space_free() ≡ ADD_SPACE {
        throw variant BadEog {message = "pinned row is space-prefix-free"}
    }
    return true
}

# -------------------------------------------------------------------------
# tokenizer_key — the tokenizer identity component of the KV block
# key (MD-A9 precedent). The KV key uses a collision-resistant digest over
# model bytes/version, execution configuration, tokenizer/chat-template
# and special-token policy, ... — this module owns the tokenizer identity
# component. The digest VALUE is computed by the host (no crypto in the
# language surface); this function renders the deterministic canonical
# component a host digests into the KV block key.
# -------------------------------------------------------------------------

@ public { }
fn tokenizer_key(TokenizerIdentity t) → string ⇥ TokenizerError {
    if not verify(t) {
        throw variant BadWire {message = "tokenizer identity failed verification"}
    }
    return (((((((((((("tokenizer/identity/" + t.schema()) + "/") + t.merge_kind()) + "/") + t.pre_tokenizer()) + "/") + t.vocab_digest()) + "/") + t.eog()) + "/bos-free=") + (t.bos_free() ↦ string)) + "/space-prefix-free=") + (t.space_free() ↦ string)
}

# -------------------------------------------------------------------------
# Identity wire form — the versioned tokenizer identity that crosses owner
# boundaries and participates in the KV identity key. Deserialization
# rejects an unknown schema version and un-admitted facts — fail closed,
# no best-effort partial reads (§5).
#   tokenizer/identity/<schema>/<kind>/<pre>/<vocab-digest>/<eog>
# -------------------------------------------------------------------------

@ public { }
fn serialize_identity(TokenizerIdentity t) → string ⇥ TokenizerError {
    if not verify(t) {
        throw variant BadWire {message = "tokenizer identity failed verification"}
    }
    return (((((((("tokenizer/identity/" + t.schema()) + "/") + t.merge_kind()) + "/") + t.pre_tokenizer()) + "/") + t.vocab_digest()) + "/") + t.eog()
}

@ public { }
fn deserialize_identity(string wire) → TokenizerIdentity ⇥ TokenizerError {
    const list<string> partes ← wire.split("/")
    if partes.length() ≠ 7 {
        throw variant BadWire {message = "malformed tokenizer identity wire form"}
    }
    if partes.get(0) coalesce "" ≠ "tokenizer" or partes.get(1) coalesce "" ≠ "identity" {
        throw variant BadWire {message = "unknown tokenizer identity marker"}
    }
    const string schema ← partes.get(2) coalesce ""
    if schema ≠ schema_version {
        throw variant UnknownVersion {message = "unknown tokenizer identity schema version: " + schema}
    }
    const string merge_kind ← partes.get(3) coalesce ""
    const string pre_tokenizer ← partes.get(4) coalesce ""
    const string vocab_digest ← partes.get(5) coalesce ""
    const string eog ← partes.get(6) coalesce ""
    return construct(schema, merge_kind, pre_tokenizer, vocab_digest, eog, true, true)
}

# -------------------------------------------------------------------------
# Artifact-backed byte-level BPE runtime (LIB-02-U2, GGUF-A2).
#
# The runtime consumes the vocab and merge arrays from a schema-2
# GgufManifest through the U1 accessors (texts) and implements the
# llama.cpp llm_tokenizer_bpe core at the word-level boundary:
#   * gpt2 byte-to-unicode display mapping (each UTF-8 byte of the input maps
#     to one display codepoint; the vocab/merge strings live in that space),
#   * ranked bigram merging — one merge at a time, ties broken by leftmost
#     position — matching the pinned reference queue semantics,
#   * final-piece vocab lookup with a single-byte (fallback) split,
#   * decode via the inverse display mapping, concatenating bytes and
#     decoding UTF-8.
# The pre-tokenizer is identity at this boundary (U3 composes it). No vocab
# or merge table is hard-coded here: everything comes from the manifest.
#
# -------------------------------------------------------------------------

# Byte-level BPE capability contract. The runtime only implements the gpt2
# byte-to-unicode convention, so the manifest's declared tokenizer model must
# be the byte-level family. Independent of the identity contract's pinned
# SmolLM2 kind constant (clean break posture).
const string TOKENIZER_CAPABLE ← "gpt2"

# Sentinel rank for a pair absent from the merge table (never merges).
const int MERGE_ABSENS ← 9223372036854775807

# llama.cpp llama_token_type NORMAL — the special-cache boundary: every
# vocab entry whose token_type is not NORMAL is special (the
# llama_vocab::init_special rule; U3-4).
const int KIND_NORMAL ← 1

# GGUF metadata wire type for tokenizer.ggml.add_bos_token (bool) — mirrors
# the manifest module's private GGUF_BOOL constant (7).
const int KIND_BOOL ← 7

# EOG text names (llama-vocab.cpp llm_load_vocab, pinned oracle 10150
# `dee2a846b`): every vocab token whose text is one of these names is an
# end-of-generation token (U3-5). The final name is the DeepSeek-OCR form
# with fullwidth bars and U+2581 lower-one-eighth-block separators.
const list<string> EOG_NAMES ← ["<|eot_id|>", "<|im_end|>", "<|end|>", "<|return|>", "<|call|>", "<|flush|>", "<|calls|>", "<end_of_turn>", "<|endoftext|>", "</s>", "<|eom_id|>", "<EOT>", "_<EOT>", "[EOT]", "[EOS]", "<|end_of_text|>", "<end_of_utterance>", "<eos>", "<turn|>", "<|tool_response>", "<｜end▁of▁sentence｜>", "[e~["]

# FIM token text-name fallbacks — llama.cpp only falls back to these when
# the tokenizer.ggml.fim_*_token_id metadata keys are absent.
const list<string> FIM_PAD_NAMES ← ["<|fim_pad|>", "<fim-pad>", "<fim_pad>", "<PAD>", "[PAD]"]

const list<string> FIM_REP_NAMES ← ["<|fim_repo|>", "<|repo_name|>", "<fim-repo>", "<REPO>", "<reponame>"]

const list<string> FIM_SEP_NAMES ← ["<|file_sep|>"]

# The artifact-backed runtime record. `words` is the vocab array indexed
# by token id (decode path); `vocab` is the display-token → id map and
# `concursus` the "left right" merge-pair → rank map (encode path).
# `special_texts`/`specialia_ids` are the artifact special-token cache
# (parallel lists; every non-NORMAL token_type entry, U3-4) that drives the
# parse-special on/off policy. `eog` is the artifact EOG stop set and
# `add_bos` the artifact's add_bos_token flag (U3-5). `chat_template` is
# the artifact's tokenizer.chat_template string (U3-6; absent → empty —
# no hard-coded fallback).


@ public { }
class Tokenizer {
    list<string> words
    map<string, int> vocab
    map<string, int> concursus
    list<string> special_texts
    list<int> specialia_ids
    list<int> eog
    bool add_bos
    string chat_template
    int multitudo
}

# --- Byte ↔ display-codepoint mapping (gpt2 convention) --------------------

# Byte value → display codepoint. Bytes in the printable/Latin-1 ranges map
# to themselves; the remaining 68 bytes map to 0x100+n in ascending byte
# order (0x00 → U+0100, 0x20 → U+0120, 0x7F → U+0121, …, 0xAD → U+0143).
@ private { }
fn _code_from_byte(int byte) → int ⇥ TokenizerError {
    if byte ≺ 0 or byte ≻ 255 {
        throw variant BadWire {message = "byte value outside 0..255"}
    }
    if byte ≥ 33 and byte ≤ 126 then return byte
    if byte ≥ 161 and byte ≤ 172 then return byte
    if byte ≥ 174 and byte ≤ 255 then return byte
    if byte ≤ 32 then return 256 + byte
    if byte ≤ 160 then return byte + 162
    return 323
}

# Display codepoint → byte value (inverse mapping). Unmappable codepoints
# are malformed vocab content and fail closed.
@ private { }
fn _byte_from_code(int cpt) → int ⇥ TokenizerError {
    if cpt ≥ 33 and cpt ≤ 126 then return cpt
    if cpt ≥ 161 and cpt ≤ 172 then return cpt
    if cpt ≥ 174 and cpt ≤ 255 then return cpt
    if cpt ≥ 256 and cpt ≤ 288 then return cpt - 256
    if cpt ≥ 289 and cpt ≤ 322 then return cpt - 162
    if cpt ≡ 323 then return 173
    throw variant UnknownTrace {message = ("display character has no byte mapping (codepoint " + (cpt ↦ string)) + ")"}
}

# --- Codepoint ↔ text helpers -------------------------------------------

@ private { }
fn _text_from_bytes(list<int> bs) → string ⇥ TokenizerError {
    var list<int<u8>> u8s ← vacua
    for from bs const b {
        u8s.append(b ∷ int<u8>)
    }
    const bytes o ← u8s ↦ bytes
    do {
        return o ↦ string
    }
    catch err {
        throw variant BadUtf8 {message = "display character bytes are not valid UTF-8"}
    }
    throw variant BadUtf8 {message = "unreachable display character conversion"}
}

# UTF-8 encode one codepoint to its single-character text. Display
# codepoints are ≤ 0x143, so the 1- and 2-byte arms cover the mapping; the
# longer arms keep the helper total for arbitrary vocab content.
@ private { }
fn _text_from_code(int cpt) → string ⇥ TokenizerError {
    if cpt ≺ 0 {
        throw variant BadWire {message = "negative codepoint"}
    }
    if cpt ≺ 128 then return _text_from_bytes([cpt])
    if cpt ≺ 2048 {
        const int b0 ← 192 ∨ cpt ⇒ 6
        const int b1 ← 128 ∨ cpt ∧ 63
        return _text_from_bytes([b0, b1])
    }
    if cpt ≺ 65536 {
        const int b0 ← 224 ∨ cpt ⇒ 12
        const int b1 ← 128 ∨ cpt ⇒ 6 ∧ 63
        const int b2 ← 128 ∨ cpt ∧ 63
        return _text_from_bytes([b0, b1, b2])
    }
    if cpt ≺ 1114112 {
        const int b0 ← 240 ∨ cpt ⇒ 18
        const int b1 ← 128 ∨ cpt ⇒ 12 ∧ 63
        const int b2 ← 128 ∨ cpt ⇒ 6 ∧ 63
        const int b3 ← 128 ∨ cpt ∧ 63
        return _text_from_bytes([b0, b1, b2, b3])
    }
    throw variant BadWire {message = "codepoint exceeds the Unicode range"}
}

# UTF-8 decode one character back to its codepoint. A single character is
# one to four bytes.
@ private { }
fn _code_from_trace(string c) → int ⇥ TokenizerError {
    const list<int> bs ← _number_bytes(c ↦ bytes)
    const int n ← bs.length()
    const int b0 ← bs.get(0) coalesce 0
    if n ≡ 1 then return b0
    const int b1 ← bs.get(1) coalesce 0
    if n ≡ 2 then return (b0 ∧ 31) ⇐ 6 ∨ b1 ∧ 63
    const int b2 ← bs.get(2) coalesce 0
    if n ≡ 3 then return ((b0 ∧ 15) ⇐ 12 ∨ (b1 ∧ 63) ⇐ 6) ∨ b2 ∧ 63
    const int b3 ← bs.get(3) coalesce 0
    if n ≡ 4 then return (((b0 ∧ 7) ⇐ 18 ∨ (b1 ∧ 63) ⇐ 12) ∨ (b2 ∧ 63) ⇐ 6) ∨ b3 ∧ 63
    throw variant UnknownTrace {message = "malformed display character"}
}

# Bulk bytes → byte-value bridge (the runtime's analogue of the manifest
# module's `byte-list helper`; error-free by construction — the input always
# comes from a text UTF-8 encode, so the payload carrier is a byte list).
@ private { }
fn _number_bytes(bytes o) → list<int> {
    const value v ← o ↦ value
    return v ↦ list<int>
}

# One display character (the byte-level BPE symbol for a single source byte).
@ private { }
fn _trace_from_byte(int byte) → string ⇥ TokenizerError {
    return _text_from_code(_code_from_byte(byte))
}

# --- Manifest reads and merge-table construction ---------------------------

@ private { }
fn _artifact_text(gguf_manifest.GgufManifest m, string key) → string ⇥ TokenizerError {
    do {
        return gguf_manifest.text(m, key)
    }
    catch err {
        throw variant BadArtifact {message = "tokenizer metadata is unavailable: " + gguf_manifest.message(err)}
    }
    throw variant BadArtifact {message = "unreachable tokenizer metadata read"}
}

@ private { }
fn _artifact_texts(gguf_manifest.GgufManifest m, string key) → list<string> ⇥ TokenizerError {
    do {
        return gguf_manifest.texts(m, key)
    }
    catch err {
        throw variant BadArtifact {message = "tokenizer array is unavailable: " + gguf_manifest.message(err)}
    }
    throw variant BadArtifact {message = "unreachable tokenizer array read"}
}

# tokenizer.ggml.token_type is OPTIONAL in GGUF: llama.cpp defaults absent
# types to NORMAL (→ an empty special cache). A PRESENT but malformed
# token_type fails closed.
@ private { }
fn _artifact_optional_types(gguf_manifest.GgufManifest m) → list<int> ⇥ TokenizerError {
    do {
        return gguf_manifest.numbers(m, "tokenizer.ggml.token_type")
    }
    catch err {
        const string message ← gguf_manifest.message(err)
        if message.length() ≥ 24 {
            if message.slice(0, 24) ≡ "metadata key not found: " then return vacua
        }
        throw variant BadArtifact {message = "tokenizer token_type is malformed: " + message}
    }
    throw variant BadArtifact {message = "unreachable tokenizer token_type read"}
}

# Merge-entry well-formedness: exactly "left right" with a single space
# separator and non-empty halves (llama.cpp's find_bpe_rank asserts the same
# no-space-in-token invariant).
@ private { }
fn _pair_ok(string par) → bool {
    if par.length() ≡ 0 then return false
    const list<string> partes ← par.split(" ")
    if partes.length() ≠ 2 then return false
    if (partes.get(0) coalesce "").length() ≡ 0 then return false
    if (partes.get(1) coalesce "").length() ≡ 0 then return false
    return true
}

# --- BPE merge loop (llama.cpp one-at-a-time semantics) --------------------

# Repeatedly merge the adjacent pair with the lowest merge rank (ties broken
# by the leftmost position), one occurrence per step, until no pair merges.
# Matches the pinned reference's priority-queue behavior; a fresh scan each
# step makes stale entries impossible.
@ private { }
fn _bpe_merge(map<string, int> concursus, list<string> symbola) → list<string> {
    var list<string> cur ← symbola
    while true {
        const int n ← cur.length()
        if n ≺ 2 {
            break
        }
        var int melior_rank ← MERGE_ABSENS
        var int melior_pos ← -1
        var int i ← 0
        while i + 1 ≺ n {
            const string l ← cur.get(i) coalesce ""
            const string r ← cur.get(i + 1) coalesce ""
            const int rank ← concursus.get((l + " ") + r) coalesce MERGE_ABSENS
            if rank ≺ melior_rank or (rank ≡ melior_rank and melior_pos ≥ 0) and i ≺ melior_pos {
                melior_rank ← rank
                melior_pos ← i
            }
            i ↑
        }
        if melior_pos ≺ 0 {
            break
        }
        const string cohaesum ← cur.get(melior_pos) coalesce "" + cur.get(melior_pos + 1) coalesce ""
        var list<string> next ← vacua
        var int j ← 0
        while j ≺ n {
            if j ≡ melior_pos {
                next.append(cohaesum)
                j ← j + 2
            }
            else {
                next.append(cur.get(j) coalesce "")
                j ← j + 1
            }
        }
        cur ← next
    }
    return cur
}

# --- Runtime construction, encode, decode -----------------------------------

# Build the runtime from a parsed manifest. The vocab and merge arrays come
# from the artifact; the declared model must be the byte-level BPE family.
@ public { }
fn build(gguf_manifest.GgufManifest m) → Tokenizer ⇥ TokenizerError {
    const string merge_kind ← _artifact_text(m, "tokenizer.ggml.model")
    if merge_kind ≠ TOKENIZER_CAPABLE {
        throw variant UnknownMergeKind {message = "tokenizer runtime is byte-level BPE; manifest declares: " + merge_kind}
    }
    const list<string> words ← _artifact_texts(m, "tokenizer.ggml.tokens")
    if words.length() ≡ 0 {
        throw variant BadArtifact {message = "tokenizer vocabulary is empty"}
    }
    const list<string> merges ← _artifact_texts(m, "tokenizer.ggml.merges")
    var map<string, int> vocab ← vacua
    var int i ← 0
    while i ≺ words.length() {
        vocab.put(words.get(i) coalesce "", i)
        i ↑
    }
    var map<string, int> concursus ← vacua
    var int j ← 0
    while j ≺ merges.length() {
        const string par ← merges.get(j) coalesce ""
        if not _pair_ok(par) {
            throw variant BadMerges {message = "malformed merge entry: " + par}
        }
        concursus.put(par, j)
        j ↑
    }
    # Special-token cache (U3-4): every vocab entry whose token_type is not
    # NORMAL is special (llama.cpp llama_vocab::init_special); absent
    # token_type means no specials (the reference defaults to NORMAL).
    const list<int> kinds ← _artifact_optional_types(m)
    if kinds.length() ≻ 0 and kinds.length() ≠ words.length() {
        throw variant BadArtifact {message = "tokenizer token_type length does not match the vocabulary"}
    }
    var list<string> special_texts ← vacua
    var list<int> specialia_ids ← vacua
    var int k ← 0
    while k ≺ words.length() {
        const int kind ← kinds.get(k) coalesce KIND_NORMAL
        if kind ≠ KIND_NORMAL {
            special_texts.append(words.get(k) coalesce "")
            specialia_ids.append(k)
        }
        k ↑
    }
    # EOG stop set + BOS policy (U3-5), derived from the artifact exactly
    # like llama.cpp llm_load_vocab: the declared eos id, the reference EOG
    # text names, and the FIM pad/rep/sep ids (metadata first, else the
    # text-name fallback); add_bos reads tokenizer.ggml.add_bos_token.
    # The chat template (U3-6) reads tokenizer.chat_template (absent →
    # empty, the no-template state).
    const list<int> eog ← _artifact_eog(m, words)
    const bool add_bos ← _artifact_add_bos(m)
    const string chat_template ← _artifact_chat_template(m)
    return Tokenizer {words = words, vocab = vocab, concursus = concursus, special_texts = special_texts, specialia_ids = specialia_ids, eog = eog, add_bos = add_bos, chat_template = chat_template, multitudo = words.length()}
}

# Sparse table constructor — the provider builds a runtime over the model's
# vocab/merge arrays without wrapping them in a GGUF corpus. `ids`/`tokens`
# are parallel (token `tokens[i]` lives at id `ids[i]`); `special_ids` are
# the parse-special cache (must appear in `ids`). Unmapped bytes fail
# closed at encode time (UnknownTrace).
@ public { }
fn build_tables(list<int> ids, list<string> tokens, list<string> merges, list<int> special_ids) → Tokenizer ⇥ TokenizerError {
    if ids.length() ≠ tokens.length() {
        throw variant BadArtifact {message = "tokenizer table ids and tokens are different lengths"}
    }
    if ids.length() ≡ 0 {
        throw variant BadArtifact {message = "tokenizer vocabulary is empty"}
    }
    var int max_id ← -1
    var map<int, string> per_id ← vacua
    var map<string, int> vocab ← vacua
    var int i ← 0
    while i ≺ ids.length() {
        const int id ← ids.get(i) coalesce (-1)
        if id ≺ 0 {
            throw variant IdExtra {message = "tokenizer table id is negative"}
        }
        const string token ← tokens.get(i) coalesce ""
        per_id.put(id, token)
        vocab.put(token, id)
        if id ≻ max_id {
            max_id ← id
        }
        i ↑
    }
    var list<string> words ← vacua
    var int k ← 0
    while k ≤ max_id {
        words.append(per_id.get(k) coalesce "")
        k ↑
    }
    var map<string, int> concursus ← vacua
    var int j ← 0
    while j ≺ merges.length() {
        const string par ← merges.get(j) coalesce ""
        if not _pair_ok(par) {
            throw variant BadMerges {message = "malformed merge entry: " + par}
        }
        concursus.put(par, j)
        j ↑
    }
    var list<string> special_texts ← vacua
    var list<int> specialia_ids ← vacua
    for from special_ids const sid {
        if sid ≺ 0 or sid ≻ max_id {
            throw variant BadArtifact {message = "special token id is outside the table: " + (sid ↦ string)}
        }
        const string txt ← words.get(sid) coalesce ""
        if txt.length() ≡ 0 {
            throw variant BadArtifact {message = "special token id has no table entry: " + (sid ↦ string)}
        }
        special_texts.append(txt)
        specialia_ids.append(sid)
    }
    var list<int> eog_cand ← vacua
    var int e ← 0
    while e ≺ ids.length() {
        const string v ← tokens.get(e) coalesce ""
        if _in_name(v, EOG_NAMES) {
            eog_cand.append(ids.get(e) coalesce (-1))
        }
        e ↑
    }
    return Tokenizer {words = words, vocab = vocab, concursus = concursus, special_texts = special_texts, specialia_ids = specialia_ids, eog = _sort_ascending(eog_cand), add_bos = false, chat_template = "", multitudo = words.length()}
}

# Word-level encode: UTF-8 bytes → display symbols → BPE merges → vocab ids.
# A final piece missing from the vocab falls back to its single-byte display
# characters; a missing byte token is malformed vocab and fails closed.
@ public { }
fn encode(Tokenizer t, string word) → list<int> ⇥ TokenizerError {
    const list<int> byte_values ← _number_bytes(word ↦ bytes)
    var list<string> symbola ← vacua
    for from byte_values const b {
        symbola.append(_trace_from_byte(b))
    }
    const list<string> end ← _bpe_merge(t.concursus, symbola)
    var list<int> ids ← vacua
    for from end const piece {
        const int id ← t.vocab.get(piece) coalesce (-1)
        if id ≥ 0 {
            ids.append(id)
        }
        else {
            var int i ← 0
            while i ≺ piece.length() {
                const string c ← piece.slice(i, i + 1)
                const int cid ← t.vocab.get(c) coalesce (-1)
                if cid ≺ 0 {
                    throw variant UnknownTrace {message = "byte piece missing from the vocabulary: " + c}
                }
                ids.append(cid)
                i ↑
            }
        }
    }
    return ids
}

# Word-level decode: ids → vocab display strings → inverse display mapping →
# bytes → UTF-8 text. Unknown ids, unmappable display characters, and byte
# sequences that are not valid UTF-8 fail with typed errors.
@ public { }
fn decode(Tokenizer t, list<int> ids) → string ⇥ TokenizerError {
    var list<int<u8>> bytes ← vacua
    for from ids const id {
        if id ≺ 0 or id ≥ t.multitudo {
            throw variant UnknownId {message = "token id outside the vocabulary range: " + (id ↦ string)}
        }
        const string trace ← t.words.get(id) coalesce ""
        var int i ← 0
        while i ≺ trace.length() {
            const string c ← trace.slice(i, i + 1)
            const int cpt ← _code_from_trace(c)
            const int byte ← _byte_from_code(cpt)
            bytes.append(byte ∷ int<u8>)
            i ↑
        }
    }
    const bytes o ← bytes ↦ bytes
    do {
        return o ↦ string
    }
    catch err {
        throw variant BadUtf8 {message = "decoded byte sequence is not valid UTF-8"}
    }
    throw variant BadUtf8 {message = "unreachable decode conversion"}
}

# -------------------------------------------------------------------------
# Unicode-category tables + predicates (LIB-02-U3-1, GGUF-A2).
#
# The qwen35 pre-tokenizer regex (llama-vocab.cpp LLAMA_VOCAB_PRE_TYPE_QWEN35)
# needs the character classes \p{L} (letter), \p{M} (mark), \p{N} (number),
# \s (whitespace) and the explicit CR/LF newlines. Fab has no regex engine
# and no Unicode general-category tables in the language surface, so the
# bounded-category scanner (delivery open question 1 default) expresses each
# class as a deterministic codepoint-range table covering the classes the
# two probes and the differential rows exercise. Classification runs on RAW
# input codepoints — the pre-tokenizer matches the input text before the
# byte-level BPE display mapping (a raw space is U+0020, not the display
# "Ġ" U+0120). A malformed character has no category and falls to Other —
# the same closed behavior as the reference regex leaving unmatched bytes
# to the [^\s\p{L}\p{M}\p{N}] alternative.
# -------------------------------------------------------------------------

# Scanner-relevant Unicode general categories. \p{L}/\p{M}/\p{N} come
# straight from the regex; \s is split into the explicit CR/LF newlines
# (the [\r\n] alternations) and the remaining ASCII whitespace, matching
# how the qwen35 pattern consumes each.
union UnicodeCategory {
    Letter,
    Signum,
    Number,
    Space,
    Newline,
    Other
}

# \p{L} — the letter classes the two probes and the differential rows
# exercise: Basic Latin + Latin-1 Supplement letters, the Thai block
# letters (consonants and the sara vowels, all Lo/Lm), and the CJK
# Unified Ideographs.
const list<list<int>> LETTER_TABLE ← [[65, 90], [97, 122], [192, 214], [216, 246], [248, 255], [3585, 3632], [3634, 3635], [3648, 3654], [19968, 40959]]

# \p{M} — the marks the probes exercise: the Thai vowel/tone signs (mai
# han-akat U+0E31, the sara i..phinthu signs U+0E34..U+0E3A, lakkhangyao
# U+0E45, and the tone marks U+0E47..U+0E4E), all Mn/Me.
const list<list<int>> SIGNUM_TABLE ← [[3633, 3633], [3636, 3642], [3653, 3653], [3655, 3662]]

# \p{N} — the ASCII digits the differential rows exercise plus the Thai
# digits of the same block.
const list<list<int>> NUMBER_TABLE ← [[48, 57], [3664, 3673]]

# \s minus CR/LF — the ASCII whitespace the regex's \s+ / [^\s...] and
# leading- \ ? arms consume. CR and LF are the Newline class.
const list<list<int>> SPACE_TABLE ← [[9, 9], [11, 12], [32, 32]]

# The explicit CR/LF newlines of the [\r\n] alternations.
const list<list<int>> NEWLINE_TABLE ← [[10, 10], [13, 13]]

# Inclusive-range membership over one category table.
@ private { }
fn _in_table(int cpt, list<list<int>> table) → bool {
    for from table const par {
        if cpt ≥ par.get(0) coalesce 0 and cpt ≤ par.get(1) coalesce 0 then return true
    }
    return false
}

# Classify one character into the scanner-relevant category.
@ public { }
fn category(string c) → UnicodeCategory {
    var int cpt ← -1
    do {
        cpt ← _code_from_trace(c)
    }
    catch err {
        cpt ← -1
    }
    if _in_table(cpt, LETTER_TABLE) then return Letter
    if _in_table(cpt, SIGNUM_TABLE) then return Signum
    if _in_table(cpt, NUMBER_TABLE) then return Number
    if _in_table(cpt, SPACE_TABLE) then return Space
    if _in_table(cpt, NEWLINE_TABLE) then return Newline
    return Other
}

# Category predicates (the \p{L}..[\r\n] classes the scanner composes).
@ public { }
fn is_letter(string c) → bool {
    match category(c) {
        case Letter {
            return true
        }
        case _ {
            return false
        }
    }
}

@ public { }
fn is_symbol(string c) → bool {
    match category(c) {
        case Signum {
            return true
        }
        case _ {
            return false
        }
    }
}

@ public { }
fn is_number(string c) → bool {
    match category(c) {
        case Number {
            return true
        }
        case _ {
            return false
        }
    }
}

@ public { }
fn is_space(string c) → bool {
    match category(c) {
        case Space {
            return true
        }
        case _ {
            return false
        }
    }
}

@ public { }
fn is_newline(string c) → bool {
    match category(c) {
        case Newline {
            return true
        }
        case _ {
            return false
        }
    }
}

@ public { }
fn is_other(string c) → bool {
    match category(c) {
        case Other {
            return true
        }
        case _ {
            return false
        }
    }
}

# Canonical category name for an enum value (internal name mapping).
@ private { }
fn _category_name(UnicodeCategory c) → string {
    match c {
        case Letter {
            return "littera"
        }
        case Signum {
            return "signum"
        }
        case Number {
            return "numerus"
        }
        case Space {
            return "spatium"
        }
        case Newline {
            return "novum_linea"
        }
        case Other {
            return "aliud"
        }
    }
}

# Canonical category name for one character (the proof/consumer text
# seam — text → text, no nominal types in the signature).
@ public { }
fn category_name(string c) → string {
    return _category_name(category(c))
}

# -------------------------------------------------------------------------
# qwen35 word-splitting scanner (LIB-02-U3-2 core families + LIB-02-U3-3
# edge families).
#
# The deterministic pre-tokenizer splits a raw prompt into words before the
# byte-level BPE core, mirroring llama.cpp's custom qwen35 scanner
# (unicode.cpp unicode_regex_split_custom_qwen35; llama-vocab.cpp
# LLAMA_VOCAB_PRE_TYPE_QWEN35; pinned oracle 10150 `dee2a846b`). The full
# qwen35 pattern is:
#   (?i:'s|'t|'re|'ve|'m|'ll|'d)
#   | [^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+
#   | \p{N}
#   | ?[^\s\p{L}\p{M}\p{N}]+[\r\n]*
#   | \s*[\r\n]+ | \s+(?!\S) | \s+
# The arms apply in that order (alternation order):
#   * the contraction family ('s/'t/'re/'ve/'m/'ll/'d, case-insensitive —
#     the reference lowercases the following letter),
#   * letter/mark runs with one optional leading non-CR/LF/number char
#     ([^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+),
#   * single numbers (\p{N}),
#   * punctuation/emoji/other runs with one optional leading literal space
#     and trailing CR/LF runs (?[^\s\p{L}\p{M}\p{N}]+[\r\n]*),
#   * whitespace runs (\s+ and the \s+(?!\S) trailing-run form) and newline
#     runs (\s*[\r\n]+).
# A character no family matches falls through to a single-character word
# (the reference's "no matches" arm).
#
# Reference semantics mirrored exactly:
#   * the contraction arm runs FIRST, so a "'t" following a word splits as
#     its own word ("don'ts" → "don" | "'t" | "s", not "don" | "'ts"),
#   * a letter/mark word absorbs ONE leading non-CR/LF/number char, so a
#     space or tab before a letter-run joins the word (" 你好" → one word,
#     "!hello" → one word),
#   * each digit is its own word,
#   * an "other" run takes one optional leading U+0020 and all trailing
#     CR/LF ("hello, world!" → "hello" | "," | " world" | "!", "a,!\n" →
#     "a" | ",!\n"), so a space-before-other joins the other-run ("x  ," →
#     "x" | " " | " ,"),
#   * a whitespace run of 2+ followed by a character emits all-but-one
#     whitespace as a word, leaving the last one for the next word,
#   * a whitespace run containing CR/LF consumes through the LAST CR/LF.
# Classification uses the U3-1 bounded codepoint tables (ASCII whitespace
# only; the full Unicode White_Space property is a documented boundary).
# -------------------------------------------------------------------------

# Raw text → codepoint list (one entry per character; string.slice is
# codepoint-indexed, so i advances one character per step).
@ private { }
fn _text_codes(string s) → list<int> ⇥ TokenizerError {
    var list<int> out ← vacua
    var int i ← 0
    while i ≺ s.length() {
        const string c ← s.slice(i, i + 1)
        out.append(_code_from_trace(c))
        i ← i + 1
    }
    return out
}

# Codepoint-level predicates over the U3-1 category tables.
@ private { }
fn _letter_code(int cpt) → bool {
    return _in_table(cpt, LETTER_TABLE)
}

@ private { }
fn _symbol_code(int cpt) → bool {
    return _in_table(cpt, SIGNUM_TABLE)
}

@ private { }
fn _number_code(int cpt) → bool {
    return _in_table(cpt, NUMBER_TABLE)
}

@ private { }
fn _space_code(int cpt) → bool {
    return _in_table(cpt, SPACE_TABLE)
}

@ private { }
fn _newline_code(int cpt) → bool {
    return _in_table(cpt, NEWLINE_TABLE)
}

# The reference's \s carries both ordinary whitespace and CR/LF.
@ private { }
fn _blank_code(int cpt) → bool {
    return _space_code(cpt) or _newline_code(cpt)
}

# The reference's [^\s\p{L}\p{M}\p{N}] — a character no family class
# matches (the punct/emoji/other run class, bounded tables).
@ private { }
fn _other_code(int cpt) → bool {
    return not ((((_letter_code(cpt) or _symbol_code(cpt)) or _number_code(cpt)) or _space_code(cpt)) or _newline_code(cpt))
}

# ASCII lowercasing for the contraction arm — the reference matches the
# qwen35 contraction letters case-insensitively via unicode_tolower; only
# the ASCII letters s/t/r/v/m/l/d/e are in the pattern's sets.
@ private { }
fn _small_code(int cpt) → int {
    if cpt ≥ 65 and cpt ≤ 90 then return cpt + 32
    return cpt
}

# Codepoint range → the exact source slice (rebuilds the UTF-8 bytes).
@ private { }
fn _words_from_codes(list<int> cpts, int ini, int fin) → string ⇥ TokenizerError {
    var string out ← ""
    var int i ← ini
    while i ≺ fin {
        out ← out + _text_from_code(cpts.get(i) coalesce 0)
        i ← i + 1
    }
    return out
}

# Split a raw prompt into words exactly like the pinned qwen35 scanner's
# core families. Each returned word is a slice of the input text; the U2
# word-level BPE core consumes one word at a time.
@ public { }
fn scan_words(string text) → list<string> ⇥ TokenizerError {
    const list<int> cpts ← _text_codes(text)
    const int n ← cpts.length()
    var list<string> words ← vacua
    var int pos ← 0
    while pos ≺ n {
        const int cpt ← cpts.get(pos) coalesce 0
        const int start ← pos
        # (?i:'s|'t|'re|'ve|'m|'ll|'d) — the contraction family. The
        # reference matches FIRST, lowercasing the following letter(s):
        # a 2-character word "'x" for s/t/m/d, a 3-character word "'xy"
        # for re/ve/ll.
        if cpt ≡ 39 and pos + 1 ≺ n {
            const int prox ← _small_code(cpts.get(pos + 1) coalesce 0)
            if ((prox ≡ 115 or prox ≡ 116) or prox ≡ 109) or prox ≡ 100 {
                pos ← pos + 2
                words.append(_words_from_codes(cpts, start, pos))
                continue
            }
            if pos + 2 ≺ n {
                const int prox2 ← _small_code(cpts.get(pos + 2) coalesce 0)
                if (prox ≡ 114 and prox2 ≡ 101 or prox ≡ 118 and prox2 ≡ 101) or prox ≡ 108 and prox2 ≡ 108 {
                    pos ← pos + 3
                    words.append(_words_from_codes(cpts, start, pos))
                    continue
                }
            }
        }
        # [^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+ — letter/mark run with one
        # optional leading non-CR/LF/number char.
        if (cpt ≠ 10 and cpt ≠ 13) and not _number_code(cpt) {
            var bool sequens ← false
            if pos + 1 ≺ n {
                const int prox ← cpts.get(pos + 1) coalesce 0
                sequens ← _letter_code(prox) or _symbol_code(prox)
            }
            if (_letter_code(cpt) or _symbol_code(cpt)) or sequens {
                pos ← pos + 1
                while pos ≺ n {
                    const int w ← cpts.get(pos) coalesce 0
                    if not (_letter_code(w) or _symbol_code(w)) {
                        break
                    }
                    pos ← pos + 1
                }
                words.append(_words_from_codes(cpts, start, pos))
                continue
            }
        }
        # \p{N} — one digit per word.
        if _number_code(cpt) {
            pos ← pos + 1
            words.append(_words_from_codes(cpts, start, pos))
            continue
        }
        # ?[^\s\p{L}\p{M}\p{N}]+[\r\n]* — punctuation/emoji/other run. An
        # optional leading literal space (U+0020) joins the run when the
        # following character is "other" (or the space is trailing at the
        # segment end — the reference's out-of-range next flags are "not
        # whitespace/letter/mark/number"), then the other-run, then all
        # trailing CR/LF ("x  ," → "x" | " " | " ,"; "a,!\n" → "a" |
        # ",!\n").
        var bool init_other ← false
        if cpt ≡ 32 {
            init_other ← pos + 1 ≥ n or _other_code(cpts.get(pos + 1) coalesce 0)
        }
        else {
            init_other ← _other_code(cpt)
        }
        if init_other {
            if cpt ≡ 32 {
                pos ← pos + 1
            }
            while pos ≺ n and _other_code(cpts.get(pos) coalesce 0) {
                pos ← pos + 1
            }
            while pos ≺ n {
                const int w ← cpts.get(pos) coalesce 0
                if w ≠ 10 and w ≠ 13 {
                    break
                }
                pos ← pos + 1
            }
            words.append(_words_from_codes(cpts, start, pos))
            continue
        }
        # \s family — scan the whitespace run.
        var int multi ← 0
        var int end_line ← 0
        while pos + multi ≺ n {
            const int w ← cpts.get(pos + multi) coalesce 0
            if not _blank_code(w) {
                break
            }
            if _newline_code(w) {
                end_line ← (pos + multi) + 1
            }
            multi ← multi + 1
        }
        # \s*[\r\n]+ — consume through the last CR/LF of the run.
        if end_line ≻ 0 {
            pos ← end_line
            words.append(_words_from_codes(cpts, start, pos))
            continue
        }
        # \s+(?!\S) — a run of 2+ followed by a character keeps the last
        # whitespace for the next word.
        if multi ≻ 1 and pos + multi ≺ n {
            pos ← (pos + multi) - 1
            words.append(_words_from_codes(cpts, start, pos))
            continue
        }
        # \s+ — plain whitespace run.
        if multi ≻ 0 {
            pos ← pos + multi
            words.append(_words_from_codes(cpts, start, pos))
            continue
        }
        # No family matched — single-character word (the reference's
        # "no matches" arm; every bounded-table class matches a family,
        # so this is the safety net).
        pos ← pos + 1
        words.append(_words_from_codes(cpts, start, pos))
    }
    return words
}

# SMOLLM pre-tokenizer (llama-vocab.cpp LLAMA_VOCAB_PRE_TYPE_SMOLLM):
# first isolate each `\p{N}` digit, then run the GPT-2 custom scanner on
# every remaining span (`'s|'t|'re|'ve|'m|'ll|'d| ?\p{L}+| ?\p{N}+|
# ?[^\s\p{L}\p{N}]+|\s+(?!\S)`). P1–P11 are ASCII and exercise the
# letter / other / whitespace arms; digit isolation is the SMOLLM
# difference from a bare GPT-2 pre.
@ public { }
fn scan_smollm(string text) → list<string> ⇥ TokenizerError {
    const list<int> cpts ← _text_codes(text)
    const int n ← cpts.length()
    var list<string> words ← vacua
    var int pos ← 0
    while pos ≺ n {
        if _number_code(cpts.get(pos) coalesce 0) {
            words.append(_words_from_codes(cpts, pos, pos + 1))
            pos ← pos + 1
            continue
        }
        const int start ← pos
        while pos ≺ n {
            if _number_code(cpts.get(pos) coalesce 0) {
                break
            }
            pos ← pos + 1
        }
        const list<string> partes ← _scan_gpt2_span(cpts, start, pos)
        for from partes const p {
            words.append(p)
        }
    }
    return words
}

# GPT-2 custom scanner on one [lo, hi) codepoint span (unicode.cpp
# unicode_regex_split_custom_gpt2). Contractions are case-sensitive
# lowercase; an optional leading U+0020 joins a following letter /
# number / other run; a 2+ whitespace run followed by more text emits
# all-but-last (add_space_prefix = false — P11).
@ private { }
fn _scan_gpt2_span(list<int> cpts, int lo, int hi) → list<string> ⇥ TokenizerError {
    var list<string> words ← vacua
    var int pos ← lo
    while pos ≺ hi {
        const int cpt ← cpts.get(pos) coalesce 0
        const int start ← pos
        if cpt ≡ 39 and pos + 1 ≺ hi {
            const int prox ← cpts.get(pos + 1) coalesce 0
            if ((prox ≡ 115 or prox ≡ 116) or prox ≡ 109) or prox ≡ 100 {
                pos ← pos + 2
                words.append(_words_from_codes(cpts, start, pos))
                continue
            }
            if pos + 2 ≺ hi {
                const int prox2 ← cpts.get(pos + 2) coalesce 0
                if (prox ≡ 114 and prox2 ≡ 101 or prox ≡ 118 and prox2 ≡ 101) or prox ≡ 108 and prox2 ≡ 108 {
                    pos ← pos + 3
                    words.append(_words_from_codes(cpts, start, pos))
                    continue
                }
            }
        }
        var int c2 ← cpt
        var bool in_span ← true
        if cpt ≡ 32 {
            if pos + 1 ≺ hi {
                c2 ← cpts.get(pos + 1) coalesce 0
            }
            else {
                in_span ← false
            }
        }
        if in_span and _letter_code(c2) {
            if cpt ≡ 32 {
                pos ← pos + 1
            }
            while pos ≺ hi {
                if not _letter_code(cpts.get(pos) coalesce 0) {
                    break
                }
                pos ← pos + 1
            }
            words.append(_words_from_codes(cpts, start, pos))
            continue
        }
        if in_span and _number_code(c2) {
            if cpt ≡ 32 {
                pos ← pos + 1
            }
            while pos ≺ hi {
                if not _number_code(cpts.get(pos) coalesce 0) {
                    break
                }
                pos ← pos + 1
            }
            words.append(_words_from_codes(cpts, start, pos))
            continue
        }
        if in_span and _other_code(c2) {
            if cpt ≡ 32 {
                pos ← pos + 1
            }
            while pos ≺ hi and _other_code(cpts.get(pos) coalesce 0) {
                pos ← pos + 1
            }
            words.append(_words_from_codes(cpts, start, pos))
            continue
        }
        var int multi ← 0
        while pos + multi ≺ hi {
            if not _blank_code(cpts.get(pos + multi) coalesce 0) {
                break
            }
            multi ← multi + 1
        }
        if multi ≻ 1 and pos + multi ≺ hi {
            pos ← (pos + multi) - 1
            words.append(_words_from_codes(cpts, start, pos))
            continue
        }
        if multi ≻ 0 {
            pos ← pos + multi
            words.append(_words_from_codes(cpts, start, pos))
            continue
        }
        pos ← pos + 1
        words.append(_words_from_codes(cpts, start, pos))
    }
    return words
}

# First occurrence of `quid` in `ubi` at or after `ab` (character
# indices), or -1 when absent — the reference's std::string::find.
@ private { }
fn _find(string ubi, string quid, int ab) → int {
    const int n ← ubi.length()
    const int m ← quid.length()
    if m ≡ 0 or m ≻ n then return -1
    var int i ← ab
    while i + m ≤ n {
        if ubi.slice(i, i + m) ≡ quid then return i
        i ← i + 1
    }
    return -1
}

# Scanner-split + word-level BPE encode of one plain-text slice.
# `smollm` selects the SMOLLM / GPT-2 custom scanner (provider tokenize
# route); otherwise the qwen35 scanner (existing encode_prompt path).
@ private { }
fn _encode_words_kind(Tokenizer t, string text, bool smollm) → list<int> ⇥ TokenizerError {
    var list<string> words ← vacua
    if smollm {
        words ← scan_smollm(text)
    }
    else {
        words ← scan_words(text)
    }
    var list<int> ids ← vacua
    for from words const word {
        const list<int> partes ← encode(t, word)
        for from partes const id {
            ids.append(id)
        }
    }
    return ids
}

# Shared literal path of both parse policies (qwen35 scanner).
@ private { }
fn _encode_words(Tokenizer t, string text) → list<int> ⇥ TokenizerError {
    return _encode_words_kind(t, text, false)
}

# Full-prompt encode, parse_special = falsum: the whole prompt goes
# through scanner + BPE (specials read as their literal bytes).
@ public { }
fn encode_prompt(Tokenizer t, string text) → list<int> ⇥ TokenizerError {
    return _encode_words(t, text)
}

# Full-prompt encode with an explicit scanner. `specials` splits on the
# artifact special cache first; `smollm` selects the SMOLLM scanner.
@ private { }
fn _encode_prompt_kind(Tokenizer t, string text, bool specials, bool smollm) → list<int> ⇥ TokenizerError {
    if not specials {
        return _encode_words_kind(t, text, smollm)
    }
    var list<int> ids ← vacua
    var int pos ← 0
    while pos ≺ text.length() {
        var int melior_pos ← -1
        var int melior_id ← -1
        var int melior_length ← -1
        var int i ← 0
        while i ≺ t.special_texts.length() {
            const string specialis ← t.special_texts.get(i) coalesce ""
            if specialis.length() ≻ 0 {
                const int p ← _find(text, specialis, pos)
                if p ≥ 0 and ((melior_pos ≺ 0 or p ≺ melior_pos) or p ≡ melior_pos and specialis.length() ≻ melior_length) {
                    melior_pos ← p
                    melior_id ← t.specialia_ids.get(i) coalesce (-1)
                    melior_length ← specialis.length()
                }
            }
            i ← i + 1
        }
        if melior_pos ≺ 0 {
            const list<int> partes ← _encode_words_kind(t, text.slice(pos, text.length()), smollm)
            for from partes const id {
                ids.append(id)
            }
            break
        }
        if melior_pos ≻ pos {
            const list<int> partes ← _encode_words_kind(t, text.slice(pos, melior_pos), smollm)
            for from partes const id {
                ids.append(id)
            }
        }
        ids.append(melior_id)
        pos ← melior_pos + melior_length
    }
    return ids
}

# Full-prompt encode, parse_special = verum: split the prompt on the
# artifact special cache BEFORE the scanner (llama.cpp
# split_special_tokens/find_special_token — earliest match, longest text
# on ties), emitting each special's single id and scanning each plain
# slice independently. A prompt with no specials encodes identically to
# encode_prompt.
@ public { }
fn encode_prompt_special(Tokenizer t, string text) → list<int> ⇥ TokenizerError {
    return _encode_prompt_kind(t, text, true, false)
}

# Provider encode route (G3): text → ids over the model's tables.
# SMOLLM scanner + parse-special on (llama-tokenize default; P5/P7/P8/P9).
# BOS is never prepended. Detokenize is deferred.
@ public { }
fn tokenize(Tokenizer t, string text) → list<int> ⇥ TokenizerError {
    return _encode_prompt_kind(t, text, true, true)
}

# Provider encode, parse-special off (P6 literal BPE bytes).
@ public { }
fn tokenize_literal(Tokenizer t, string text) → list<int> ⇥ TokenizerError {
    return _encode_prompt_kind(t, text, false, true)
}

# -------------------------------------------------------------------------
# EOG + BOS-free policy (LIB-02-U3-5, GGUF-A2).
#
# The runtime EOG stop set mirrors llama-vocab.cpp llm_load_vocab (pinned
# oracle 10150 `dee2a846b`): the declared tokenizer.ggml.eos_token_id is
# always a member, every vocab token whose text is in the reference EOG
# name list is a member, and the FIM pad/rep/sep ids join when the metadata
# key or a reference text-name match resolves them. For the pinned artifact
# this is exactly {248044, 248046, 248063, 248064, 248065}. The BOS policy
# reads tokenizer.ggml.add_bos_token (absent → falsum, the llama.cpp bool
# default): encode never prepends a BOS, so the falsum artifact is BOS-free
# (empty prompt → empty sequence). An artifact without EOG metadata yields
# an empty EOG set — no hard-coded SmolLM2 fallback (the stop-condition
# invariant).
# -------------------------------------------------------------------------

# Contains-check over a name list (the EOG/FIM text-name scans).
@ private { }
fn _in_name(string v, list<string> names) → bool {
    for from names const n {
        if v ≡ n then return true
    }
    return false
}

# Dedupe + ascending sort (the reference's EOG set order; -1 slots from the
# FIM fallback are dropped).
@ private { }
fn _sort_ascending(list<int> a) → list<int> {
    var list<int> out ← vacua
    for from a const v {
        if v ≺ 0 {
            continue
        }
        var bool visus ← false
        var int i ← 0
        while i ≺ out.length() {
            if out.get(i) coalesce 0 ≡ v {
                visus ← true
                break
            }
            i ← i + 1
        }
        if visus {
            continue
        }
        var int pos ← 0
        while pos ≺ out.length() {
            if out.get(pos) coalesce 0 ≻ v {
                break
            }
            pos ← pos + 1
        }
        var list<int> next ← vacua
        var int j ← 0
        while j ≺ out.length() {
            if j ≡ pos {
                next.append(v)
            }
            next.append(out.get(j) coalesce 0)
            j ← j + 1
        }
        if pos ≥ out.length() {
            next.append(v)
        }
        out ← next
    }
    return out
}

# One FIM slot: the metadata key first, else the reference text-name
# fallback (first matching vocab entry in id order). -1 when nothing
# resolves; a present-but-malformed key fails closed.
@ private { }
fn _artifact_end(gguf_manifest.GgufManifest m, list<string> words, string key, list<string> names) → int ⇥ TokenizerError {
    var int id ← -1
    var bool adest ← false
    do {
        id ← gguf_manifest.number(m, key)
        adest ← true
    }
    catch err {
        const string message ← gguf_manifest.message(err)
        if message.length() ≺ 24 or message.slice(0, 24) ≠ "metadata key not found: " {
            throw variant BadArtifact {message = "tokenizer FIM metadata is malformed: " + message}
        }
    }
    if adest {
        if id ≺ 0 or id ≥ words.length() {
            throw variant BadArtifact {message = "tokenizer FIM id is outside the vocabulary"}
        }
        return id
    }
    var int i ← 0
    while i ≺ words.length() {
        if _in_name(words.get(i) coalesce "", names) then return i
        i ← i + 1
    }
    return -1
}

# The artifact EOG set: declared eos id + the EOG-name scan + the FIM
# pad/rep/sep slots, deduped and ascending.
@ private { }
fn _artifact_eog(gguf_manifest.GgufManifest m, list<string> words) → list<int> ⇥ TokenizerError {
    var list<int> candidati ← vacua
    var int eos ← -1
    var bool eos_adest ← false
    do {
        eos ← gguf_manifest.number(m, "tokenizer.ggml.eos_token_id")
        eos_adest ← true
    }
    catch err {
        const string message ← gguf_manifest.message(err)
        if message.length() ≺ 24 or message.slice(0, 24) ≠ "metadata key not found: " {
            throw variant BadArtifact {message = "tokenizer EOG metadata is malformed: " + message}
        }
    }
    if eos_adest {
        if eos ≺ 0 or eos ≥ words.length() {
            throw variant BadArtifact {message = "tokenizer eos_token_id is outside the vocabulary"}
        }
        candidati.append(eos)
    }
    var int i ← 0
    while i ≺ words.length() {
        if _in_name(words.get(i) coalesce "", EOG_NAMES) {
            candidati.append(i)
        }
        i ← i + 1
    }
    candidati.append(_artifact_end(m, words, "tokenizer.ggml.fim_pad_token_id", FIM_PAD_NAMES))
    candidati.append(_artifact_end(m, words, "tokenizer.ggml.fim_rep_token_id", FIM_REP_NAMES))
    candidati.append(_artifact_end(m, words, "tokenizer.ggml.fim_sep_token_id", FIM_SEP_NAMES))
    return _sort_ascending(candidati)
}

# The artifact's add_bos_token (GGUF bool; absent → falsum, the llama.cpp
# kv_bool default). A present non-bool value fails closed.
@ private { }
fn _artifact_add_bos(gguf_manifest.GgufManifest m) → bool ⇥ TokenizerError {
    var gguf_manifest.GgufMetadata x ← gguf_manifest.GgufMetadata {key = "", dtype = -1, payload_wire = ||}
    var bool adest ← false
    do {
        x ← gguf_manifest.metadata(m, "tokenizer.ggml.add_bos_token")
        adest ← true
    }
    catch err {
        const string message ← gguf_manifest.message(err)
        if message.length() ≺ 24 or message.slice(0, 24) ≠ "metadata key not found: " {
            throw variant BadArtifact {message = "tokenizer.add_bos_token is malformed: " + message}
        }
    }
    if not adest then return false
    if x.dtype ≠ KIND_BOOL {
        throw variant BadArtifact {message = "tokenizer.add_bos_token is not a GGUF bool"}
    }
    const list<int> bs ← _number_bytes(x.payload_wire)
    return bs.get(0) coalesce 0 ≡ 1
}

# The artifact's chat template (U3-6). tokenizer.chat_template is OPTIONAL
# in GGUF: absent → empty string (the artifact declares no template — the
# renderer fails closed instead of inventing one). A PRESENT but malformed
# value fails closed.
@ private { }
fn _artifact_chat_template(gguf_manifest.GgufManifest m) → string ⇥ TokenizerError {
    do {
        return gguf_manifest.text(m, "tokenizer.chat_template")
    }
    catch err {
        const string message ← gguf_manifest.message(err)
        if message.length() ≥ 24 {
            if message.slice(0, 24) ≡ "metadata key not found: " then return ""
        }
        throw variant BadArtifact {message = "tokenizer.chat_template is malformed: " + message}
    }
    throw variant BadArtifact {message = "unreachable tokenizer.chat_template read"}
}

# The runtime EOG stop set (ascending; mirrors the reference's set order).
@ public { }
fn artifact_eog(Tokenizer t) → list<int> {
    return t.eog
}

# EOG-membership predicate — the runtime generation stop-policy binding
# (the artifact-set equivalent of the identity contract's is_eog).
@ public { }
fn is_artifact_eog(Tokenizer t, int id) → bool {
    for from t.eog const e {
        if id ≡ e then return true
    }
    return false
}

# The artifact's add_bos_token flag (falsum for the pinned artifact — the
# BOS-free policy: encode never prepends a BOS).
@ public { }
fn add_bos(Tokenizer t) → bool {
    return t.add_bos
}

# -------------------------------------------------------------------------
# Chat-template policy (LIB-02-U3-6, GGUF-A2).
#
# `tokenizer.chat_template` loads from artifact metadata (empty when the
# artifact declares none — the no-template state). The MINIMAL Qwen3-ChatML
# user-turn render applies the pinned shape `<|im_start|>user\n{content}
# <|im_end|>\n` — the executed subset of the artifact's Jinja template, NOT
# a universal template engine (the delivery forbids one). Full vision/tool-
# calling branches of the template are recorded, not executed (stop-
# condition scope). Rendering fails closed when the artifact declares no
# template — no hard-coded fallback (the artifact-backed invariant).
# -------------------------------------------------------------------------

# The artifact's chat template (the minimal ChatML subset the renderer
# applies; empty when the artifact declares none).
@ public { }
fn chat_template(Tokenizer t) → string {
    return t.chat_template
}

# Minimal Qwen3-ChatML user-turn render: `<|im_start|>user\n{content}
# <|im_end|>\n`. The content embeds verbatim, so encoding the rendered turn
# composes without changing the content's pinned ids (R1, U3-6 oracle).
@ public { }
fn render_user_turn(Tokenizer t, string content) → string ⇥ TokenizerError {
    if t.chat_template.length() ≡ 0 {
        throw variant BadArtifact {message = "artifact declares no chat template"}
    }
    return ("<|im_start|>user\n" + content) + "<|im_end|>\n"
}
