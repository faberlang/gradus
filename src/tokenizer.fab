# normal 202, context 2175. Token ids match the pinned llama.cpp fixture
# EXACTLY; a tokenizer whose ids diverge is a different tokenizer.
fixum textus PINNATA_CORRECTIO ← "504,2365,6354,16438,27003,690,260,23790,2767"
