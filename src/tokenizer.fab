+++
locale = "en"
+++
# Tokenizer identity — versioned contract (PML2-U4, council C8).
#
# Public import: importa ex "gradus:tokenizer" privata tokenizator
# Depends on: nothing (leaf module — self-contained like capsule.fab).
#
# --- Contract ------------------------------------------------------------
#
# Schema: tokenizer-identity-schema-1.0.0 (stamped 2026-08-08, PML2-U4).
# This module implements the PML0-U14 capsule contract field 3 — tokenizer
# identity — as the DEEPER probe-parity contract the capsule references
# ("deeper probe parity is PML2-U4's contract"; the capsule's
# IdentitasTokenizer validates identity form and admission).
#
# Tokenizer identity for the admitted row(s) is a VERSIONED contract:
#   * byte-level / BBPE per row — pinned kind gpt2 (byte-level BPE, BBPE)
#     with pre-tokenizer smollm, vocab 49152, merges 48900 (GI1 row facts);
#     the byte-level rule is that every token is raw UTF-8 bytes of the
#     source text with the gpt2 display mapping — no token is re-encoded
#     from unicode text.
#   * BOS/EOS/special-token behavior — EOG set {0, 2}, BOS-free
#     (add_bos_token = false), space-prefix-free (add_space_prefix = false),
#     special-parse on/off parity (P5 vs P6), 17 control specials (ids
#     0..=16).
#   * token ids match the pinned llama.cpp fixture EXACTLY — the pinned
#     probe lists (P1–P11) and the four workload id lists (9 / 9 / 202 /
#     2175) are embedded below as the contract fixture; a tokenizer whose
#     ids diverge from the pinned probes is a DIFFERENT tokenizer and must
#     fail admission (verifica_proba fails closed).
#
# Tokenizer identity is part of the capsule AND the KV identity key
# (MD-A9 precedent): the KV block key uses a collision-resistant digest
# over, among other facts, the tokenizer/chat-template and special-token
# policy. This module owns the tokenizer identity component of that key —
# clavis_tokenizatoris renders the deterministic canonical component a
# host digests into the KV block key. No crypto primitive exists in the
# language surface (same boundary note as capsule.fab): the digest VALUE
# is produced and verified by the admission host (pure-Rust, GI1) before
# the capsule is built; this module validates the identity claim's form
# and pinned row facts and carries the component.
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * The pinned probe lists are embedded as comma-separated textus
#     fixtures (the same form as evidence/contract-tokenize-probes.txt)
#     and parsed by proba_ida; proba asserts the parsed counts (9 / 9 /
#     202 / 2175) and exact equality against list literals.
#   * Public signatures stay on primitives plus this module's own genera
#     (IdentitasTokenizator) so the proba file-interface keeps every
#     export (WARN014 — same seam as capsule.fab / parameter.fab).
#   * Proba proof is compile-level until the FMIR stepper / faber test
#     path covers library probas (recorded capsule.fab residual); adfirma
#     assertions run under the auditor-owned `faber test` harness.
#
# --- Seams ---------------------------------------------------------------
#   * capsule.fab field 3 (IdentitasTokenizer) — identity carrier; this
#     module is the deeper probe-parity contract it references.
#   * GI1 tokenizer facts (kind/pre/vocab/merges/specials, P1–P11, the
#     four workload lists, 24-case differential) — cited read-only from
#     gi1-closeout.md + evidence/contract-tokenize-probes.txt.
#   * KV block key (MD-A9) — this module owns the tokenizer identity
#     component (clavis_tokenizatoris); the full key digest is host-side.
#   * tokenizer RUNTIME (encode text → ids) — faber-runtime owns
#     execution; this module pins and verifies the EXPECTED ids.
#
# GGUF-A2 (LIB-02): the artifact-backed byte-level BPE runtime lives in this
# module too (the runtime section at the bottom). It consumes the vocab/merge
# arrays through the schema-2 manifest accessors (gradus:model/gguf_manifest)
# and implements the llama.cpp llm_tokenizer_bpe core at the word boundary.
#
# -------------------------------------------------------------------------
# Schema and pinned-row constants. schema_versio is the public contract
# identity (tokenizer-identity-schema-1.0.0 → "1.0.0"); bump both the wire
# form and the constant on a schema change.
# -------------------------------------------------------------------------

import from "gradus:model/gguf_manifest" manifestum

const string schema_versio ← "1.0.0"

# Pinned row facts (GI1-3, read-only from gi1-closeout.md / tokenizer/mod.rs).
#
# Disposition (correctness-fix slice, 2026-08-09): the special-id facts
# (BOS_ID / EOS_ID / PAD_ID / UNK_ID), the special count (SPECIALES), and
# the merge count (MERGES) have no separate field in the
# IdentitasTokenizator record; they are enforced TRANSITIVELY — the ids by
# the pinned probe fixtures (P5 -> 1, P7 -> 2, P8 -> 0, the 17 control
# specials 0..=16) and the vocab digest, the merges by the byte-level BPE
# row facts the vocab digest and the workload id lists bind. Retained as
# the documented contract constants (explicit decision — no silent
# removal). EOG and ADD_BOS / ADD_SPATIUM ARE enforced below: the EOG set
# exactly (structa/verifica, the admission-surface correctness fix); the
# add-flags via the same structa/verifica checks.
const string TOKENIZATOR_KIND ← "gpt2"

const string TOKENIZATOR_PRE ← "smollm"

const int VOCABULUM ← 49152

const int MERGES ← 48900

const int BOS_ID ← 1

const int EOS_ID ← 2

const int PAD_ID ← 2

const int UNK_ID ← 0

const string EOG ← "0,2"

const int SPECIALES ← 17

const bool ADD_BOS ← false

const bool ADD_SPATIUM ← false

# -------------------------------------------------------------------------
# EOG-membership predicate — the generation stop-policy binding. Is the id
# in the admitted EOG set {0, 2} (the EOG constant above — structa admits
# exactly this set)? The generation loops (decode.proba / the
# token-generation exemplum) bind their stop to this predicate: generation
# terminates after the FIRST EOG token is produced — maxima_verborum is a
# ceiling, never a promise to emit exactly that many tokens (PML5-U6
# EOG-stop, CTO9-4).
# -------------------------------------------------------------------------

@ public { }
fn est_eog(int id) → bool {
    return id ≡ 0 or id ≡ 2
}

# -------------------------------------------------------------------------
# Pinned probe fixtures — the llama.cpp contract. Each is the exact
# comma-separated id list from evidence/contract-tokenize-probes.txt
# (P1–P11) or gi0-workloads.md §3 (the four workload id lists). The
# 24-case differential (llama-tokenize 10150 `dee2a846b`, vocab-only) is
# cited read-only from gi1-closeout.md — its id lists are the probe set
# below plus the differential edges, all reproduced by the runtime owner.
# -------------------------------------------------------------------------

# P1  "Hello world" (default) — [19556, 905]
const string PINNATA_P1 ← "19556,905"
# P2  same with --no-bos — identical (the tokenizer never auto-prepends BOS)
const string PINNATA_P2 ← "19556,905"
# P3  token count == 2 (P1/P2 length; no separate id list)
# P4  empty prompt — empty sequence, no BOS
const string PINNATA_P4 ← ""
# P5  "<|im_start|>" parses to BOS special id 1 (specials on)
const string PINNATA_P5 ← "1"
# P6  "<|im_start|>" as literal text with --no-parse-special (BPE bytes)
const string PINNATA_P6 ← "44,108,306,79,3738,108,46"
# P7  "<|im_end|>" parses to EOS special id 2
const string PINNATA_P7 ← "2"
# P8  "<|endoftext|>" parses to id 0
const string PINNATA_P8 ← "0"
# P9  chat-template prefix (32 ids)
const string PINNATA_P9 ← "1,9690,198,2683,359,253,5356,5646,11173,3365,3511,308,34519,28,7018,411,407,19712,8182,2,198,1,4093,198,26843,665,2,198,1,520,9531,198"
# P10 "The quick brown fox jumps over the lazy dog" (9 ids)
const string PINNATA_P10 ← "504,2365,6354,16438,27003,690,260,23790,2767"
# P11 leading-space behavior (add_space_prefix = false) — [216, 2899, 5600]
const string PINNATA_P11 ← "216,2899,5600"

