# -------------------------------------------------------------------------
# TokenizerError — typed error vocabulary of the tokenizer identity
# contract. Variant → class:
#   VersioIgnota       — unknown tokenizer identity schema version.
#   ProgeniesIgnota    — un-admitted tokenizer kind (must be gpt2 / BBPE).
#   PreIgnotus         — un-admitted pre-tokenizer (must be smollm).
#   VocabulumMala      — vocab / merges / specials count mismatch.
#   DigestioMala       — malformed vocabulary digest (not 64-hex).
#   EogMala            — malformed EOG set (must be {0, 2}).
#   IdExtra            — token id outside the admitted range [0, vocab).
#   ProbeDivergens     — probe id list diverges from the pinned fixture
#                        (a different tokenizer — must fail admission).
#   ArtificiumMala     — artifact tokenizer metadata is unavailable
#                        or malformed (LIB-02-U2 runtime).
#   MergesMala         — malformed merge entry in the artifact (U2).
#   IdIgnotum          — unknown token id in decode (out of range) (U2).
#   VestigiumIgnotum   — display character with no byte mapping (U2).
#   Utf8Mala           — byte sequence is not valid UTF-8 (U2).
#   WireMala           — malformed tokenizer identity wire form.
# -------------------------------------------------------------------------

union TokenizerError {
    VersioIgnota {
        string causa
    },
    ProgeniesIgnota {
        string causa
    },
    PreIgnotus {
        string causa
    },
    VocabulumMala {
        string causa
    },
    DigestioMala {
        string causa
    },
    EogMala {
        string causa
    },
    IdExtra {
        string causa
    },
    ProbeDivergens {
        string causa
    },
    ArtificiumMala {
        string causa
    },
    MergesMala {
        string causa
    },
    IdIgnotum {
        string causa
    },
    VestigiumIgnotum {
        string causa
    },
    Utf8Mala {
        string causa
    },
    WireMala {
        string causa
    }
}

fn causa(TokenizerError e) → string {
    match e {
        case VersioIgnota const causa {
            return causa
        }
        case ProgeniesIgnota const causa {
            return causa
        }
        case PreIgnotus const causa {
            return causa
        }
        case VocabulumMala const causa {
            return causa
        }
        case DigestioMala const causa {
            return causa
        }
        case EogMala const causa {
            return causa
        }
        case IdExtra const causa {
            return causa
        }
        case ProbeDivergens const causa {
            return causa
        }
        case ArtificiumMala const causa {
            return causa
        }
        case MergesMala const causa {
            return causa
        }
        case IdIgnotum const causa {
            return causa
        }
        case VestigiumIgnotum const causa {
            return causa
        }
        case Utf8Mala const causa {
            return causa
        }
        case WireMala const causa {
            return causa
        }
    }
}

# -------------------------------------------------------------------------
# IdentitasTokenizator — the versioned tokenizer identity record. The
# field vocabulary mirrors the capsule's IdentitasTokenizer (field 3) so
# the capsule can be built from this contract's values; the schema stamp
# makes the record versioned. Immutable — accessors only.
# -------------------------------------------------------------------------

class IdentitasTokenizator {
    string schema
    string progenies
    string pre_tokenizator
    string digestio_vocabuli
    string eog
    bool bos_vacua
    bool spatium_vacua

    fn schematis() → string {
        return self.schema
    }

    fn progenies() → string {
        return self.progenies
    }

    fn pre_tokenizator() → string {
        return self.pre_tokenizator
    }

    fn digestio_vocabuli() → string {
        return self.digestio_vocabuli
    }

    fn eog() → string {
        return self.eog
    }

    fn bos_vacua() → bool {
        return self.bos_vacua
    }

    fn spatium_vacua() → bool {
        return self.spatium_vacua
    }
}

# -------------------------------------------------------------------------
# Private validation helpers. All return bivalens (predicates); structa and
# verifica turn a falsum into the matching typed TokenizerError.
# -------------------------------------------------------------------------

# Hex-digit predicate for digest values.
@ private { }
fn _est_hex(string c) → bool {
    if ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9" then return true
    if ((((c ≡ "a" or c ≡ "b") or c ≡ "c") or c ≡ "d") or c ≡ "e") or c ≡ "f" then return true
    return false
}

# Whole-digest predicate: exactly 64 lowercase hex characters.
@ private { }
fn _hex_recta(string s) → bool {
    if s.length() ≠ 64 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _est_hex(s.get(i)) then return false
        i ← i + 1
    }
    return true
}

# Digit predicate (no negative sign — a "-" fails closed).
@ private { }
fn _est_digitum(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

# EOG-set WELL-FORMEDNESS predicate: comma-separated, non-empty, strictly
# ascending, non-negative integer token ids. The EXACT pinned value {0, 2}
# is enforced separately in structa/verifica (the admission-surface
# correctness fix: a well-formed-but-different set like "1,5" is a
# different tokenizer and fails closed).
@ private { }
fn _eog_recta(string eog) → bool {
    if eog.length() ≡ 0 then return false
    const list<string> partes ← eog.split(",")
    var int ultimum ← -1
    for from partes const p {
        if p.length() ≡ 0 then return false
        if p.length() ≻ 18 then return false
        var int i ← 0
        while i ≺ p.length() {
            if not _est_digitum(p.get(i)) then return false
            i ← i + 1
        }
        do {
            const int v ← p ↦ int
            if v ≤ ultimum then return false
            ultimum ← v
        }
        catch err {
            return false
        }
    }
    return true
}

# Token id in range predicate: 0 ≤ id < VOCABULUM.
@ private { }
fn _id_in_ambitu(int id) → bool {
    if id ≺ 0 then return false
    if id ≥ VOCABULUM then return false
    return true
}

# -------------------------------------------------------------------------
# proba_aequa — exact id-list equality (the probe-parity predicate).
# Length + element-wise; the contract is exact match, nothing less.
# -------------------------------------------------------------------------

fn proba_aequa(list<int> a, list<int> b) → bool {
    if a.length() ≠ b.length() then return false
    var int i ← 0
    while i ≺ a.length() {
        if a.get(i) coalesce 0 ≠ b.get(i) coalesce 0 then return false
        i ← i + 1
    }
    return true
}

# -------------------------------------------------------------------------
# proba_ida — parse a comma-separated pinned id-list fixture into the id
# vector. Empty fixture → empty list (P4). Fail closed on malformed
# (non-digit / out-of-range) ids.
# -------------------------------------------------------------------------

fn proba_ida(string pinnata) → list<int> ⇥ TokenizerError {
    var list<int> out ← vacua
    if pinnata.length() ≡ 0 then return out
    const list<string> partes ← pinnata.split(",")
    for from partes const p {
        if p.length() ≡ 0 {
            throw variant WireMala {causa = "malformed pinned id list"}
        }
        var int i ← 0
        while i ≺ p.length() {
            if not _est_digitum(p.get(i)) {
                throw variant WireMala {causa = "non-digit token id in pinned fixture"}
            }
            i ← i + 1
        }
        var int v ← 0
        do {
            v ← p ↦ int
        }
        catch err {
            throw variant WireMala {causa = "malformed pinned id list"}
        }
        if not _id_in_ambitu(v) {
            throw variant IdExtra {causa = "token id out of range: " + p}
        }
        out.append(v)
    }
    return out
}

# -------------------------------------------------------------------------
# verifica_proba — the fail-closed probe-parity admission check. Given an
# observed id list for a named pinned probe, it must match the pinned
# fixture EXACTLY; divergence fails closed with ProbeDivergens (a
# tokenizer whose ids diverge from the pinned probes is a different
# tokenizer and must fail admission — capsule contract §3.3).
# -------------------------------------------------------------------------

fn verifica_proba(string nomen, list<int> observata) → bool ⇥ TokenizerError {
    const list<int> pinnata ← proba_ida(pinnata_proba(nomen))
    if not proba_aequa(pinnata, observata) {
        throw variant ProbeDivergens {causa = "tokenizer ids diverge from the pinned llama.cpp probe: " + nomen}
    }
    return true
}

# Pinned fixture lookup by probe name ("p1".."p11", "correctio", "brevis",
# "normale", "contextus"). Unknown name → fail closed.
fn pinnata_proba(string nomen) → string ⇥ TokenizerError {
    if nomen ≡ "p1" then return PINNATA_P1
    if nomen ≡ "p2" then return PINNATA_P2
    if nomen ≡ "p4" then return PINNATA_P4
    if nomen ≡ "p5" then return PINNATA_P5
    if nomen ≡ "p6" then return PINNATA_P6
    if nomen ≡ "p7" then return PINNATA_P7
    if nomen ≡ "p8" then return PINNATA_P8
    if nomen ≡ "p9" then return PINNATA_P9
    if nomen ≡ "p10" then return PINNATA_P10
    if nomen ≡ "p11" then return PINNATA_P11
    if nomen ≡ "correctio" then return PINNATA_CORRECTIO
    if nomen ≡ "brevis" then return PINNATA_BREVIS
    if nomen ≡ "normale" then return PINNATA_NORMALE
    if nomen ≡ "contextus" then return PINNATA_CONTEXTUS
    throw variant WireMala {causa = "unknown pinned probe: " + nomen}
}

# -------------------------------------------------------------------------
# structa — the fail-closed tokenizer identity ADMISSION. Every field is
# validated against the pinned row before the identity is built; any
# violation throws the matching typed TokenizerError. Schema version
# rejection first (§5: unknown schema → typed failure before use).
# -------------------------------------------------------------------------

fn structa(string schema, string progenies, string pre_tokenizator, string digestio_vocabuli, string eog, bool bos_vacua, bool spatium_vacua) → IdentitasTokenizator ⇥ TokenizerError {
    if schema ≠ schema_versio {
        throw variant VersioIgnota {causa = "unknown tokenizer identity schema version: " + schema}
    }
    if progenies ≠ TOKENIZATOR_KIND {
        throw variant ProgeniesIgnota {causa = ("un-admitted tokenizer kind: " + progenies) + " (pinned row is gpt2 / byte-level BPE)"}
    }
    if pre_tokenizator ≠ TOKENIZATOR_PRE {
        throw variant PreIgnotus {causa = ("un-admitted pre-tokenizer: " + pre_tokenizator) + " (pinned row is smollm)"}
    }
    if not _hex_recta(digestio_vocabuli) {
        throw variant DigestioMala {causa = "malformed vocabulary digest"}
    }
    if not _eog_recta(eog) {
        throw variant EogMala {causa = "malformed EOG set"}
    }
    # The exact pinned EOG value (the admission-surface correctness fix):
    # a well-formed-but-different set is a different tokenizer.
    if eog ≠ EOG {
        throw variant EogMala {causa = "EOG set does not match the pinned row: " + eog}
    }
    # Pinned add-* flags are falsum ("add_bos_token = false"); the record's
    # bos_vacua / spatium_vacua are the POSITIVE facts (verum = BOS-free /
    # space-prefix-free). A row whose vacua flag equals the falsum add-*
    # state is NOT BOS-free / NOT space-prefix-free — fail closed (polarity
    # fix: was ≠, which inverted admission).
    if bos_vacua ≡ ADD_BOS {
        throw variant EogMala {causa = "pinned row is BOS-free (add_bos_token = false)"}
    }
    if spatium_vacua ≡ ADD_SPATIUM {
        throw variant EogMala {causa = "pinned row is space-prefix-free (add_space_prefix = false)"}
    }
    return IdentitasTokenizator {schema = schema, progenies = progenies, pre_tokenizator = pre_tokenizator, digestio_vocabuli = digestio_vocabuli, eog = eog, bos_vacua = bos_vacua, spatium_vacua = spatium_vacua}
}

# -------------------------------------------------------------------------
# verifica — consumer-side self-verification (self-verifying contract). Re-
# runs the admission matrix over the identity without re-deriving raw
# facts. An identity built by structa always passes; this is the
# defense-in-depth check for identities received across an owner boundary.
# -------------------------------------------------------------------------

fn verifica(IdentitasTokenizator t) → bool ⇥ TokenizerError {
    if t.schematis() ≠ schema_versio {
        throw variant VersioIgnota {causa = "unknown tokenizer identity schema version: " + t.schematis()}
    }
    if t.progenies() ≠ TOKENIZATOR_KIND {
        throw variant ProgeniesIgnota {causa = "un-admitted tokenizer kind: " + t.progenies()}
    }
    if t.pre_tokenizator() ≠ TOKENIZATOR_PRE {
        throw variant PreIgnotus {causa = "un-admitted pre-tokenizer: " + t.pre_tokenizator()}
    }
    if not _hex_recta(t.digestio_vocabuli()) {
        throw variant DigestioMala {causa = "malformed vocabulary digest"}
    }
    if not _eog_recta(t.eog()) {
        throw variant EogMala {causa = "malformed EOG set"}
    }
    if t.eog() ≠ EOG {
        throw variant EogMala {causa = "EOG set does not match the pinned row: " + t.eog()}
    }
    # Same polarity as structa: a vacua flag equal to the pinned falsum
    # add-* state means the row is NOT BOS-free / NOT space-prefix-free.
    if t.bos_vacua() ≡ ADD_BOS {
        throw variant EogMala {causa = "pinned row is BOS-free"}
    }
    if t.spatium_vacua() ≡ ADD_SPATIUM {
        throw variant EogMala {causa = "pinned row is space-prefix-free"}
    }
    return true
}

# -------------------------------------------------------------------------
# clavis_tokenizatoris — the tokenizer identity component of the KV block
# key (MD-A9 precedent). The KV key uses a collision-resistant digest over
# model bytes/version, execution configuration, tokenizer/chat-template
# and special-token policy, ... — this module owns the tokenizer identity
# component. The digest VALUE is computed by the host (no crypto in the
# language surface); this function renders the deterministic canonical
# component a host digests into the KV block key.
# -------------------------------------------------------------------------

fn clavis_tokenizatoris(IdentitasTokenizator t) → string ⇥ TokenizerError {
    if not verifica(t) {
        throw variant WireMala {causa = "tokenizer identity failed verification"}
    }
    return (((((((((((("tokenizer/identity/" + t.schematis()) + "/") + t.progenies()) + "/") + t.pre_tokenizator()) + "/") + t.digestio_vocabuli()) + "/") + t.eog()) + "/bos-free=") + (t.bos_vacua() ↦ string)) + "/space-prefix-free=") + (t.spatium_vacua() ↦ string)
}

# -------------------------------------------------------------------------
# Identity wire form — the versioned tokenizer identity that crosses owner
# boundaries and participates in the KV identity key. Deserialization
# rejects an unknown schema version and un-admitted facts — fail closed,
# no best-effort partial reads (§5).
#   tokenizer/identity/<schema>/<kind>/<pre>/<vocab-digest>/<eog>
# -------------------------------------------------------------------------

fn serializa_identitas(IdentitasTokenizator t) → string ⇥ TokenizerError {
    if not verifica(t) {
        throw variant WireMala {causa = "tokenizer identity failed verification"}
    }
    return (((((((("tokenizer/identity/" + t.schematis()) + "/") + t.progenies()) + "/") + t.pre_tokenizator()) + "/") + t.digestio_vocabuli()) + "/") + t.eog()
}

fn deserializa_identitas(string wire) → IdentitasTokenizator ⇥ TokenizerError {
    const list<string> partes ← wire.split("/")
    if partes.length() ≠ 7 {
        throw variant WireMala {causa = "malformed tokenizer identity wire form"}
    }
    if partes.get(0) coalesce "" ≠ "tokenizer" or partes.get(1) coalesce "" ≠ "identity" {
        throw variant WireMala {causa = "unknown tokenizer identity marker"}
    }
    const string schema ← partes.get(2) coalesce ""
    if schema ≠ schema_versio {
        throw variant VersioIgnota {causa = "unknown tokenizer identity schema version: " + schema}
    }
    const string progenies ← partes.get(3) coalesce ""
    const string pre_tokenizator ← partes.get(4) coalesce ""
    const string digestio_vocabuli ← partes.get(5) coalesce ""
    const string eog ← partes.get(6) coalesce ""
    return structa(schema, progenies, pre_tokenizator, digestio_vocabuli, eog, true, true)
}

# -------------------------------------------------------------------------
# Artifact-backed byte-level BPE runtime (LIB-02-U2, GGUF-A2).
#
# The runtime consumes the vocab and merge arrays from a schema-2
# ManifestumGguf through the U1 accessors (textorum) and implements the
# llama.cpp llm_tokenizer_bpe core at the word-level boundary:
#   * gpt2 byte-to-unicode display mapping (each UTF-8 byte of the input maps
#     to one display codepoint; the vocab/merge strings live in that space),
#   * ranked bigram merging — one merge at a time, ties broken by leftmost
#     position — matching the pinned reference queue semantics,
#   * final-piece vocab lookup with a single-byte (fallback) split,
#   * decode via the inverse display mapping, concatenating bytes and
#     decoding UTF-8.
# The pre-tokenizer is identity at this boundary (U3 composes it). No vocab
# or merge table is hard-coded here: everything comes from the manifest.
#
# -------------------------------------------------------------------------

# Byte-level BPE capability contract. The runtime only implements the gpt2
# byte-to-unicode convention, so the manifest's declared tokenizer model must
# be the byte-level family. Independent of the identity contract's pinned
# SmolLM2 kind constant (clean break posture).
const string TOKENIZATOR_CAPABILIS ← "gpt2"

# Sentinel rank for a pair absent from the merge table (never merges).
const int MERGE_ABSENS ← 9223372036854775807

# llama.cpp llama_token_type NORMAL — the special-cache boundary: every
# vocab entry whose token_type is not NORMAL is special (the
# llama_vocab::init_special rule; U3-4).
const int TYPI_NORMALIS ← 1

# GGUF metadata wire type for tokenizer.ggml.add_bos_token (bool) — mirrors
# the manifest module's private GGUF_BOOL constant (7).
const int TYPI_BOOL ← 7

# EOG text names (llama-vocab.cpp llm_load_vocab, pinned oracle 10150
# `dee2a846b`): every vocab token whose text is one of these names is an
# end-of-generation token (U3-5). The final name is the DeepSeek-OCR form
# with fullwidth bars and U+2581 lower-one-eighth-block separators.
const list<string> EOG_NOMINA ← ["<|eot_id|>", "<|im_end|>", "<|end|>", "<|return|>", "<|call|>", "<|flush|>", "<|calls|>", "<end_of_turn>", "<|endoftext|>", "</s>", "<|eom_id|>", "<EOT>", "_<EOT>", "[EOT]", "[EOS]", "<|end_of_text|>", "<end_of_utterance>", "<eos>", "<turn|>", "<|tool_response>", "<｜end▁of▁sentence｜>", "[e~["]

# FIM token text-name fallbacks — llama.cpp only falls back to these when
# the tokenizer.ggml.fim_*_token_id metadata keys are absent.
const list<string> FIM_PAD_NOMINA ← ["<|fim_pad|>", "<fim-pad>", "<fim_pad>", "<PAD>", "[PAD]"]

const list<string> FIM_REP_NOMINA ← ["<|fim_repo|>", "<|repo_name|>", "<fim-repo>", "<REPO>", "<reponame>"]

const list<string> FIM_SEP_NOMINA ← ["<|file_sep|>"]

# The artifact-backed runtime record. `verborum` is the vocab array indexed
# by token id (decode path); `vocabulum` is the display-token → id map and
# `concursus` the "left right" merge-pair → rank map (encode path).
# `specialia_textus`/`specialia_ids` are the artifact special-token cache
# (parallel lists; every non-NORMAL token_type entry, U3-4) that drives the
# parse-special on/off policy. `eog` is the artifact EOG stop set and
# `add_bos` the artifact's add_bos_token flag (U3-5). `chat_template` is
# the artifact's tokenizer.chat_template string (U3-6; absent → empty —
# no hard-coded fallback).

@ public { }
class Tokenizator {
    list<string> verborum
    map<string, int> vocabulum
    map<string, int> concursus
    list<string> specialia_textus
    list<int> specialia_ids
    list<int> eog
    bool add_bos
    string chat_template
    int multitudo
}

# --- Byte ↔ display-codepoint mapping (gpt2 convention) --------------------

# Byte value → display codepoint. Bytes in the printable/Latin-1 ranges map
# to themselves; the remaining 68 bytes map to 0x100+n in ascending byte
# order (0x00 → U+0100, 0x20 → U+0120, 0x7F → U+0121, …, 0xAD → U+0143).
@ private { }
fn _codicillus_ex_octeto(int byte) → int ⇥ TokenizerError {
    if byte ≺ 0 or byte ≻ 255 {
        throw variant WireMala {causa = "byte value outside 0..255"}
    }
    if byte ≥ 33 and byte ≤ 126 then return byte
    if byte ≥ 161 and byte ≤ 172 then return byte
    if byte ≥ 174 and byte ≤ 255 then return byte
    if byte ≤ 32 then return 256 + byte
    if byte ≤ 160 then return byte + 162
    return 323
}

# Display codepoint → byte value (inverse mapping). Unmappable codepoints
# are malformed vocab content and fail closed.
@ private { }
fn _octetus_ex_codicillo(int cpt) → int ⇥ TokenizerError {
    if cpt ≥ 33 and cpt ≤ 126 then return cpt
    if cpt ≥ 161 and cpt ≤ 172 then return cpt
    if cpt ≥ 174 and cpt ≤ 255 then return cpt
    if cpt ≥ 256 and cpt ≤ 288 then return cpt - 256
    if cpt ≥ 289 and cpt ≤ 322 then return cpt - 162
    if cpt ≡ 323 then return 173
    throw variant VestigiumIgnotum {causa = ("display character has no byte mapping (codepoint " + (cpt ↦ string)) + ")"}
}

# --- Codepoint ↔ textus helpers -------------------------------------------

@ private { }
fn _textus_ex_octeti(list<int> bs) → string ⇥ TokenizerError {
    var list<int<u8>> u8s ← vacua
    for from bs const b {
        u8s.append(b ∷ int<u8>)
    }
    const bytes o ← u8s ↦ bytes
    do {
        return o ↦ string
    }
    catch err {
        throw variant Utf8Mala {causa = "display character bytes are not valid UTF-8"}
    }
    throw variant Utf8Mala {causa = "unreachable display character conversion"}
}

# UTF-8 encode one codepoint to its single-character textus. Display
# codepoints are ≤ 0x143, so the 1- and 2-byte arms cover the mapping; the
# longer arms keep the helper total for arbitrary vocab content.
@ private { }
fn _textus_ex_codicillo(int cpt) → string ⇥ TokenizerError {
    if cpt ≺ 0 {
        throw variant WireMala {causa = "negative codepoint"}
    }
    if cpt ≺ 128 then return _textus_ex_octeti([cpt])
    if cpt ≺ 2048 {
        const int b0 ← 192 ∨ cpt ⇒ 6
        const int b1 ← 128 ∨ cpt ∧ 63
        return _textus_ex_octeti([b0, b1])
    }
    if cpt ≺ 65536 {
        const int b0 ← 224 ∨ cpt ⇒ 12
        const int b1 ← 128 ∨ cpt ⇒ 6 ∧ 63
        const int b2 ← 128 ∨ cpt ∧ 63
        return _textus_ex_octeti([b0, b1, b2])
    }
    if cpt ≺ 1114112 {
        const int b0 ← 240 ∨ cpt ⇒ 18
        const int b1 ← 128 ∨ cpt ⇒ 12 ∧ 63
        const int b2 ← 128 ∨ cpt ⇒ 6 ∧ 63
        const int b3 ← 128 ∨ cpt ∧ 63
        return _textus_ex_octeti([b0, b1, b2, b3])
    }
    throw variant WireMala {causa = "codepoint exceeds the Unicode range"}
}

# UTF-8 decode one character back to its codepoint. A single character is
# one to four bytes.
@ private { }
fn _codicillus_ex_vestigio(string c) → int ⇥ TokenizerError {
    const list<int> bs ← _octeti_numeri(c ↦ bytes)
    const int n ← bs.length()
    const int b0 ← bs.get(0) coalesce 0
    if n ≡ 1 then return b0
    const int b1 ← bs.get(1) coalesce 0
    if n ≡ 2 then return (b0 ∧ 31) ⇐ 6 ∨ b1 ∧ 63
    const int b2 ← bs.get(2) coalesce 0
    if n ≡ 3 then return ((b0 ∧ 15) ⇐ 12 ∨ (b1 ∧ 63) ⇐ 6) ∨ b2 ∧ 63
    const int b3 ← bs.get(3) coalesce 0
    if n ≡ 4 then return (((b0 ∧ 7) ⇐ 18 ∨ (b1 ∧ 63) ⇐ 12) ∨ (b2 ∧ 63) ⇐ 6) ∨ b3 ∧ 63
    throw variant VestigiumIgnotum {causa = "malformed display character"}
}

# Bulk octeti → byte-value bridge (the runtime's analogue of the manifest
# module's `_octeti_lista`; error-free by construction — the input always
# comes from a textus UTF-8 encode, so the valor carrier is a byte list).
@ private { }
fn _octeti_numeri(bytes o) → list<int> {
    const value v ← o ↦ value
    return v ↦ list<int>
}

# One display character (the byte-level BPE symbol for a single source byte).
@ private { }
fn _vestigium_ex_octeto(int byte) → string ⇥ TokenizerError {
    return _textus_ex_codicillo(_codicillus_ex_octeto(byte))
}

# --- Manifest reads and merge-table construction ---------------------------

@ private { }
fn _textum_artificii(manifestum.ManifestumGguf m, string clavis) → string ⇥ TokenizerError {
    do {
        return manifestum.textum(m, clavis)
    }
    catch err {
        throw variant ArtificiumMala {causa = "tokenizer metadata is unavailable: " + manifestum.causa(err)}
    }
    throw variant ArtificiumMala {causa = "unreachable tokenizer metadata read"}
}

@ private { }
fn _textorum_artificii(manifestum.ManifestumGguf m, string clavis) → list<string> ⇥ TokenizerError {
    do {
        return manifestum.textorum(m, clavis)
    }
    catch err {
        throw variant ArtificiumMala {causa = "tokenizer array is unavailable: " + manifestum.causa(err)}
    }
    throw variant ArtificiumMala {causa = "unreachable tokenizer array read"}
}

# tokenizer.ggml.token_type is OPTIONAL in GGUF: llama.cpp defaults absent
# types to NORMAL (→ an empty special cache). A PRESENT but malformed
# token_type fails closed.
@ private { }
fn _typi_artificii_optativa(manifestum.ManifestumGguf m) → list<int> ⇥ TokenizerError {
    do {
        return manifestum.numerorum(m, "tokenizer.ggml.token_type")
    }
    catch err {
        const string causa ← manifestum.causa(err)
        if causa.length() ≥ 24 {
            if causa.slice(0, 24) ≡ "metadata key not found: " then return vacua
        }
        throw variant ArtificiumMala {causa = "tokenizer token_type is malformed: " + causa}
    }
    throw variant ArtificiumMala {causa = "unreachable tokenizer token_type read"}
}

# Merge-entry well-formedness: exactly "left right" with a single space
# separator and non-empty halves (llama.cpp's find_bpe_rank asserts the same
# no-space-in-token invariant).
@ private { }
fn _par_recta(string par) → bool {
    if par.length() ≡ 0 then return false
    const list<string> partes ← par.split(" ")
    if partes.length() ≠ 2 then return false
    if (partes.get(0) coalesce "").length() ≡ 0 then return false
    if (partes.get(1) coalesce "").length() ≡ 0 then return false
    return true
}

# --- BPE merge loop (llama.cpp one-at-a-time semantics) --------------------

# Repeatedly merge the adjacent pair with the lowest merge rank (ties broken
# by the leftmost position), one occurrence per step, until no pair merges.
# Matches the pinned reference's priority-queue behavior; a fresh scan each
# step makes stale entries impossible.
@ private { }
fn _bpe_coagmenta(map<string, int> concursus, list<string> symbola) → list<string> {
    var list<string> cur ← symbola
    while true {
        const int n ← cur.length()
        if n ≺ 2 {
            break
        }
        var int melior_rank ← MERGE_ABSENS
        var int melior_pos ← -1
        var int i ← 0
        while i + 1 ≺ n {
            const string l ← cur.get(i) coalesce ""
            const string r ← cur.get(i + 1) coalesce ""
            const int rank ← concursus.get((l + " ") + r) coalesce MERGE_ABSENS
            if rank ≺ melior_rank or (rank ≡ melior_rank and melior_pos ≥ 0) and i ≺ melior_pos {
                melior_rank ← rank
                melior_pos ← i
            }
            i ↑
        }
        if melior_pos ≺ 0 {
            break
        }
        const string cohaesum ← cur.get(melior_pos) coalesce "" + cur.get(melior_pos + 1) coalesce ""
        var list<string> novum ← vacua
        var int j ← 0
        while j ≺ n {
            if j ≡ melior_pos {
                novum.append(cohaesum)
                j ← j + 2
            }
            else {
                novum.append(cur.get(j) coalesce "")
                j ← j + 1
            }
        }
        cur ← novum
    }
    return cur
}

# --- Runtime construction, encode, decode -----------------------------------

# Build the runtime from a parsed manifest. The vocab and merge arrays come
# from the artifact; the declared model must be the byte-level BPE family.
@ public { }
fn fabricare(manifestum.ManifestumGguf m) → Tokenizator ⇥ TokenizerError {
    const string progenies ← _textum_artificii(m, "tokenizer.ggml.model")
    if progenies ≠ TOKENIZATOR_CAPABILIS {
        throw variant ProgeniesIgnota {causa = "tokenizer runtime is byte-level BPE; manifest declares: " + progenies}
    }
    const list<string> verborum ← _textorum_artificii(m, "tokenizer.ggml.tokens")
    if verborum.length() ≡ 0 {
        throw variant ArtificiumMala {causa = "tokenizer vocabulary is empty"}
    }
    const list<string> merges ← _textorum_artificii(m, "tokenizer.ggml.merges")
    var map<string, int> vocabulum ← vacua
    var int i ← 0
    while i ≺ verborum.length() {
        vocabulum.put(verborum.get(i) coalesce "", i)
        i ↑
    }
    var map<string, int> concursus ← vacua
    var int j ← 0
    while j ≺ merges.length() {
        const string par ← merges.get(j) coalesce ""
        if not _par_recta(par) {
            throw variant MergesMala {causa = "malformed merge entry: " + par}
        }
        concursus.put(par, j)
        j ↑
    }
    # Special-token cache (U3-4): every vocab entry whose token_type is not
    # NORMAL is special (llama.cpp llama_vocab::init_special); absent
    # token_type means no specials (the reference defaults to NORMAL).
    const list<int> typi ← _typi_artificii_optativa(m)
    if typi.length() ≻ 0 and typi.length() ≠ verborum.length() {
        throw variant ArtificiumMala {causa = "tokenizer token_type length does not match the vocabulary"}
    }
    var list<string> specialia_textus ← vacua
    var list<int> specialia_ids ← vacua
    var int k ← 0
    while k ≺ verborum.length() {
        const int typus ← typi.get(k) coalesce TYPI_NORMALIS
        if typus ≠ TYPI_NORMALIS {
            specialia_textus.append(verborum.get(k) coalesce "")
            specialia_ids.append(k)
        }
        k ↑
    }
    # EOG stop set + BOS policy (U3-5), derived from the artifact exactly
    # like llama.cpp llm_load_vocab: the declared eos id, the reference EOG
    # text names, and the FIM pad/rep/sep ids (metadata first, else the
    # text-name fallback); add_bos reads tokenizer.ggml.add_bos_token.
    # The chat template (U3-6) reads tokenizer.chat_template (absent →
    # empty, the no-template state).
    const list<int> eog ← _eog_artificii(m, verborum)
    const bool add_bos ← _add_bos_artificii(m)
    const string chat_template ← _chat_template_artificii(m)
    return Tokenizator {verborum = verborum, vocabulum = vocabulum, concursus = concursus, specialia_textus = specialia_textus, specialia_ids = specialia_ids, eog = eog, add_bos = add_bos, chat_template = chat_template, multitudo = verborum.length()}
}

# Word-level encode: UTF-8 bytes → display symbols → BPE merges → vocab ids.
# A final piece missing from the vocab falls back to its single-byte display
# characters; a missing byte token is malformed vocab and fails closed.
@ public { }
fn encoda(Tokenizator t, string verbum) → list<int> ⇥ TokenizerError {
    const list<int> byte_valores ← _octeti_numeri(verbum ↦ bytes)
    var list<string> symbola ← vacua
    for from byte_valores const b {
        symbola.append(_vestigium_ex_octeto(b))
    }
    const list<string> finis ← _bpe_coagmenta(t.concursus, symbola)
    var list<int> ids ← vacua
    for from finis const piece {
        const int id ← t.vocabulum.get(piece) coalesce (-1)
        if id ≥ 0 {
            ids.append(id)
        }
        else {
            var int i ← 0
            while i ≺ piece.length() {
                const string c ← piece.slice(i, i + 1)
                const int cid ← t.vocabulum.get(c) coalesce (-1)
                if cid ≺ 0 {
                    throw variant VestigiumIgnotum {causa = "byte piece missing from the vocabulary: " + c}
                }
                ids.append(cid)
                i ↑
            }
        }
    }
    return ids
}

# Word-level decode: ids → vocab display strings → inverse display mapping →
# bytes → UTF-8 text. Unknown ids, unmappable display characters, and byte
# sequences that are not valid UTF-8 fail with typed errors.
@ public { }
fn decoda(Tokenizator t, list<int> ids) → string ⇥ TokenizerError {
    var list<int<u8>> bytes ← vacua
    for from ids const id {
        if id ≺ 0 or id ≥ t.multitudo {
            throw variant IdIgnotum {causa = "token id outside the vocabulary range: " + (id ↦ string)}
        }
        const string vestigium ← t.verborum.get(id) coalesce ""
        var int i ← 0
        while i ≺ vestigium.length() {
            const string c ← vestigium.slice(i, i + 1)
            const int cpt ← _codicillus_ex_vestigio(c)
            const int byte ← _octetus_ex_codicillo(cpt)
            bytes.append(byte ∷ int<u8>)
            i ↑
        }
    }
    const bytes o ← bytes ↦ bytes
    do {
        return o ↦ string
    }
    catch err {
        throw variant Utf8Mala {causa = "decoded byte sequence is not valid UTF-8"}
    }
    throw variant Utf8Mala {causa = "unreachable decode conversion"}
}

# -------------------------------------------------------------------------
# Unicode-category tables + predicates (LIB-02-U3-1, GGUF-A2).
#
# The qwen35 pre-tokenizer regex (llama-vocab.cpp LLAMA_VOCAB_PRE_TYPE_QWEN35)
# needs the character classes \p{L} (letter), \p{M} (mark), \p{N} (number),
# \s (whitespace) and the explicit CR/LF newlines. Fab has no regex engine
# and no Unicode general-category tables in the language surface, so the
# bounded-category scanner (delivery open question 1 default) expresses each
# class as a deterministic codepoint-range table covering the classes the
# two probes and the differential rows exercise. Classification runs on RAW
# input codepoints — the pre-tokenizer matches the input text before the
# byte-level BPE display mapping (a raw space is U+0020, not the display
# "Ġ" U+0120). A malformed character has no category and falls to Aliud —
# the same closed behavior as the reference regex leaving unmatched bytes
# to the [^\s\p{L}\p{M}\p{N}] alternative.
# -------------------------------------------------------------------------

# Scanner-relevant Unicode general categories. \p{L}/\p{M}/\p{N} come
# straight from the regex; \s is split into the explicit CR/LF newlines
# (the [\r\n] alternations) and the remaining ASCII whitespace, matching
# how the qwen35 pattern consumes each.
union CategoriaUnicode {
    Littera,
    Signum,
    Numerus,
    Spatium,
    NovumLinea,
    Aliud
}

# \p{L} — the letter classes the two probes and the differential rows
# exercise: Basic Latin + Latin-1 Supplement letters, the Thai block
# letters (consonants and the sara vowels, all Lo/Lm), and the CJK
# Unified Ideographs.
const list<list<int>> TABULA_LITTERAE ← [[65, 90], [97, 122], [192, 214], [216, 246], [248, 255], [3585, 3632], [3634, 3635], [3648, 3654], [19968, 40959]]

# \p{M} — the marks the probes exercise: the Thai vowel/tone signs (mai
# han-akat U+0E31, the sara i..phinthu signs U+0E34..U+0E3A, lakkhangyao
# U+0E45, and the tone marks U+0E47..U+0E4E), all Mn/Me.
const list<list<int>> TABULA_SIGNORUM ← [[3633, 3633], [3636, 3642], [3653, 3653], [3655, 3662]]

# \p{N} — the ASCII digits the differential rows exercise plus the Thai
# digits of the same block.
const list<list<int>> TABULA_NUMERORUM ← [[48, 57], [3664, 3673]]

# \s minus CR/LF — the ASCII whitespace the regex's \s+ / [^\s...] and
# leading- \ ? arms consume. CR and LF are the NovumLinea class.
const list<list<int>> TABULA_SPATIORUM ← [[9, 9], [11, 12], [32, 32]]

# The explicit CR/LF newlines of the [\r\n] alternations.
const list<list<int>> TABULA_LINEARUM ← [[10, 10], [13, 13]]

# Inclusive-range membership over one category table.
@ private { }
fn _in_tabula(int cpt, list<list<int>> tabula) → bool {
    for from tabula const par {
        if cpt ≥ par.get(0) coalesce 0 and cpt ≤ par.get(1) coalesce 0 then return true
    }
    return false
}

# Classify one character into the scanner-relevant category.
@ public { }
fn categoria(string c) → CategoriaUnicode {
    var int cpt ← -1
    do {
        cpt ← _codicillus_ex_vestigio(c)
    }
    catch err {
        cpt ← -1
    }
    if _in_tabula(cpt, TABULA_LITTERAE) then return Littera
    if _in_tabula(cpt, TABULA_SIGNORUM) then return Signum
    if _in_tabula(cpt, TABULA_NUMERORUM) then return Numerus
    if _in_tabula(cpt, TABULA_SPATIORUM) then return Spatium
    if _in_tabula(cpt, TABULA_LINEARUM) then return NovumLinea
    return Aliud
}

# Category predicates (the \p{L}..[\r\n] classes the scanner composes).
@ public { }
fn est_littera(string c) → bool {
    match categoria(c) {
        case Littera {
            return true
        }
        case _ {
            return false
        }
    }
}

@ public { }
fn est_signum(string c) → bool {
    match categoria(c) {
        case Signum {
            return true
        }
        case _ {
            return false
        }
    }
}

@ public { }
fn est_numerus(string c) → bool {
    match categoria(c) {
        case Numerus {
            return true
        }
        case _ {
            return false
        }
    }
}

@ public { }
fn est_spatium(string c) → bool {
    match categoria(c) {
        case Spatium {
            return true
        }
        case _ {
            return false
        }
    }
}

@ public { }
fn est_novum_linea(string c) → bool {
    match categoria(c) {
        case NovumLinea {
            return true
        }
        case _ {
            return false
        }
    }
}

@ public { }
fn est_aliud(string c) → bool {
    match categoria(c) {
        case Aliud {
            return true
        }
        case _ {
            return false
        }
    }
}

# Canonical category name for an enum value (internal name mapping).
@ private { }
fn _nomen_categoriae(CategoriaUnicode c) → string {
    match c {
        case Littera {
            return "littera"
        }
        case Signum {
            return "signum"
        }
        case Numerus {
            return "numerus"
        }
        case Spatium {
            return "spatium"
        }
        case NovumLinea {
            return "novum_linea"
        }
        case Aliud {
            return "aliud"
        }
    }
}

# Canonical category name for one character (the proba/consumer textus
# seam — textus → textus, no nominal types in the signature).
@ public { }
fn categoria_nomen(string c) → string {
    return _nomen_categoriae(categoria(c))
}

# -------------------------------------------------------------------------
# qwen35 word-splitting scanner (LIB-02-U3-2 core families + LIB-02-U3-3
# edge families).
#
# The deterministic pre-tokenizer splits a raw prompt into words before the
# byte-level BPE core, mirroring llama.cpp's custom qwen35 scanner
# (unicode.cpp unicode_regex_split_custom_qwen35; llama-vocab.cpp
# LLAMA_VOCAB_PRE_TYPE_QWEN35; pinned oracle 10150 `dee2a846b`). The full
# qwen35 pattern is:
#   (?i:'s|'t|'re|'ve|'m|'ll|'d)
#   | [^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+
#   | \p{N}
#   | ?[^\s\p{L}\p{M}\p{N}]+[\r\n]*
#   | \s*[\r\n]+ | \s+(?!\S) | \s+
# The arms apply in that order (alternation order):
#   * the contraction family ('s/'t/'re/'ve/'m/'ll/'d, case-insensitive —
#     the reference lowercases the following letter),
#   * letter/mark runs with one optional leading non-CR/LF/number char
#     ([^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+),
#   * single numbers (\p{N}),
#   * punctuation/emoji/other runs with one optional leading literal space
#     and trailing CR/LF runs (?[^\s\p{L}\p{M}\p{N}]+[\r\n]*),
#   * whitespace runs (\s+ and the \s+(?!\S) trailing-run form) and newline
#     runs (\s*[\r\n]+).
# A character no family matches falls through to a single-character word
# (the reference's "no matches" arm).
#
# Reference semantics mirrored exactly:
#   * the contraction arm runs FIRST, so a "'t" following a word splits as
#     its own word ("don'ts" → "don" | "'t" | "s", not "don" | "'ts"),
#   * a letter/mark word absorbs ONE leading non-CR/LF/number char, so a
#     space or tab before a letter-run joins the word (" 你好" → one word,
#     "!hello" → one word),
#   * each digit is its own word,
#   * an "other" run takes one optional leading U+0020 and all trailing
#     CR/LF ("hello, world!" → "hello" | "," | " world" | "!", "a,!\n" →
#     "a" | ",!\n"), so a space-before-other joins the other-run ("x  ," →
#     "x" | " " | " ,"),
#   * a whitespace run of 2+ followed by a character emits all-but-one
#     whitespace as a word, leaving the last one for the next word,
#   * a whitespace run containing CR/LF consumes through the LAST CR/LF.
# Classification uses the U3-1 bounded codepoint tables (ASCII whitespace
# only; the full Unicode White_Space property is a documented boundary).
# -------------------------------------------------------------------------

# Raw text → codepoint list (one entry per character; textus.sectio is
# codepoint-indexed, so i advances one character per step).
@ private { }
fn _codicilli_textus(string s) → list<int> ⇥ TokenizerError {
    var list<int> out ← vacua
    var int i ← 0
    while i ≺ s.length() {
        const string c ← s.slice(i, i + 1)
        out.append(_codicillus_ex_vestigio(c))
        i ← i + 1
    }
    return out
}

# Codepoint-level predicates over the U3-1 category tables.
@ private { }
fn _codicillus_littera(int cpt) → bool {
    return _in_tabula(cpt, TABULA_LITTERAE)
}

@ private { }
fn _codicillus_signum(int cpt) → bool {
    return _in_tabula(cpt, TABULA_SIGNORUM)
}

@ private { }
fn _codicillus_numerus(int cpt) → bool {
    return _in_tabula(cpt, TABULA_NUMERORUM)
}

@ private { }
fn _codicillus_spatium(int cpt) → bool {
    return _in_tabula(cpt, TABULA_SPATIORUM)
}

@ private { }
fn _codicillus_linea(int cpt) → bool {
    return _in_tabula(cpt, TABULA_LINEARUM)
}

# The reference's \s carries both ordinary whitespace and CR/LF.
@ private { }
fn _codicillus_album(int cpt) → bool {
    return _codicillus_spatium(cpt) or _codicillus_linea(cpt)
}

# The reference's [^\s\p{L}\p{M}\p{N}] — a character no family class
# matches (the punct/emoji/other run class, bounded tables).
@ private { }
fn _codicillus_aliud(int cpt) → bool {
    return not ((((_codicillus_littera(cpt) or _codicillus_signum(cpt)) or _codicillus_numerus(cpt)) or _codicillus_spatium(cpt)) or _codicillus_linea(cpt))
}

# ASCII lowercasing for the contraction arm — the reference matches the
# qwen35 contraction letters case-insensitively via unicode_tolower; only
# the ASCII letters s/t/r/v/m/l/d/e are in the pattern's sets.
@ private { }
fn _codicillus_parvus(int cpt) → int {
    if cpt ≥ 65 and cpt ≤ 90 then return cpt + 32
    return cpt
}

# Codepoint range → the exact source slice (rebuilds the UTF-8 bytes).
@ private { }
fn _verba_ex_codicillis(list<int> cpts, int ini, int fin) → string ⇥ TokenizerError {
    var string out ← ""
    var int i ← ini
    while i ≺ fin {
        out ← out + _textus_ex_codicillo(cpts.get(i) coalesce 0)
        i ← i + 1
    }
    return out
}

# Split a raw prompt into words exactly like the pinned qwen35 scanner's
# core families. Each returned word is a slice of the input text; the U2
# word-level BPE core consumes one word at a time.
@ public { }
fn scanna_verba(string textum) → list<string> ⇥ TokenizerError {
    const list<int> cpts ← _codicilli_textus(textum)
    const int n ← cpts.length()
    var list<string> verba ← vacua
    var int pos ← 0
    while pos ≺ n {
        const int cpt ← cpts.get(pos) coalesce 0
        const int initium ← pos
        # (?i:'s|'t|'re|'ve|'m|'ll|'d) — the contraction family. The
        # reference matches FIRST, lowercasing the following letter(s):
        # a 2-character word "'x" for s/t/m/d, a 3-character word "'xy"
        # for re/ve/ll.
        if cpt ≡ 39 and pos + 1 ≺ n {
            const int prox ← _codicillus_parvus(cpts.get(pos + 1) coalesce 0)
            if ((prox ≡ 115 or prox ≡ 116) or prox ≡ 109) or prox ≡ 100 {
                pos ← pos + 2
                verba.append(_verba_ex_codicillis(cpts, initium, pos))
                continue
            }
            if pos + 2 ≺ n {
                const int prox2 ← _codicillus_parvus(cpts.get(pos + 2) coalesce 0)
                if (prox ≡ 114 and prox2 ≡ 101 or prox ≡ 118 and prox2 ≡ 101) or prox ≡ 108 and prox2 ≡ 108 {
                    pos ← pos + 3
                    verba.append(_verba_ex_codicillis(cpts, initium, pos))
                    continue
                }
            }
        }
        # [^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+ — letter/mark run with one
        # optional leading non-CR/LF/number char.
        if (cpt ≠ 10 and cpt ≠ 13) and not _codicillus_numerus(cpt) {
            var bool sequens ← false
            if pos + 1 ≺ n {
                const int prox ← cpts.get(pos + 1) coalesce 0
                sequens ← _codicillus_littera(prox) or _codicillus_signum(prox)
            }
            if (_codicillus_littera(cpt) or _codicillus_signum(cpt)) or sequens {
                pos ← pos + 1
                while pos ≺ n {
                    const int w ← cpts.get(pos) coalesce 0
                    if not (_codicillus_littera(w) or _codicillus_signum(w)) {
                        break
                    }
                    pos ← pos + 1
                }
                verba.append(_verba_ex_codicillis(cpts, initium, pos))
                continue
            }
        }
        # \p{N} — one digit per word.
        if _codicillus_numerus(cpt) {
            pos ← pos + 1
            verba.append(_verba_ex_codicillis(cpts, initium, pos))
            continue
        }
        # ?[^\s\p{L}\p{M}\p{N}]+[\r\n]* — punctuation/emoji/other run. An
        # optional leading literal space (U+0020) joins the run when the
        # following character is "other" (or the space is trailing at the
        # segment end — the reference's out-of-range next flags are "not
        # whitespace/letter/mark/number"), then the other-run, then all
        # trailing CR/LF ("x  ," → "x" | " " | " ,"; "a,!\n" → "a" |
        # ",!\n").
        var bool init_aliud ← false
        if cpt ≡ 32 {
            init_aliud ← pos + 1 ≥ n or _codicillus_aliud(cpts.get(pos + 1) coalesce 0)
        }
        else {
            init_aliud ← _codicillus_aliud(cpt)
        }
        if init_aliud {
            if cpt ≡ 32 {
                pos ← pos + 1
            }
            while pos ≺ n and _codicillus_aliud(cpts.get(pos) coalesce 0) {
                pos ← pos + 1
            }
            while pos ≺ n {
                const int w ← cpts.get(pos) coalesce 0
                if w ≠ 10 and w ≠ 13 {
                    break
                }
                pos ← pos + 1
            }
            verba.append(_verba_ex_codicillis(cpts, initium, pos))
            continue
        }
        # \s family — scan the whitespace run.
        var int multi ← 0
        var int finis_linea ← 0
        while pos + multi ≺ n {
            const int w ← cpts.get(pos + multi) coalesce 0
            if not _codicillus_album(w) {
                break
            }
            if _codicillus_linea(w) {
                finis_linea ← (pos + multi) + 1
            }
            multi ← multi + 1
        }
        # \s*[\r\n]+ — consume through the last CR/LF of the run.
        if finis_linea ≻ 0 {
            pos ← finis_linea
            verba.append(_verba_ex_codicillis(cpts, initium, pos))
            continue
        }
        # \s+(?!\S) — a run of 2+ followed by a character keeps the last
        # whitespace for the next word.
        if multi ≻ 1 and pos + multi ≺ n {
            pos ← (pos + multi) - 1
            verba.append(_verba_ex_codicillis(cpts, initium, pos))
            continue
        }
        # \s+ — plain whitespace run.
        if multi ≻ 0 {
            pos ← pos + multi
            verba.append(_verba_ex_codicillis(cpts, initium, pos))
            continue
        }
        # No family matched — single-character word (the reference's
        # "no matches" arm; every bounded-table class matches a family,
        # so this is the safety net).
        pos ← pos + 1
        verba.append(_verba_ex_codicillis(cpts, initium, pos))
    }
    return verba
}

# First occurrence of `quid` in `ubi` at or after `ab` (character
# indices), or -1 when absent — the reference's std::string::find.
@ private { }
fn _inveni(string ubi, string quid, int ab) → int {
    const int n ← ubi.length()
    const int m ← quid.length()
    if m ≡ 0 or m ≻ n then return -1
    var int i ← ab
    while i + m ≤ n {
        if ubi.slice(i, i + m) ≡ quid then return i
        i ← i + 1
    }
    return -1
}

# Scanner-split + word-level BPE encode of one plain-text slice (the
# shared literal path of both parse policies).
@ private { }
fn _encoda_verborum(Tokenizator t, string textum) → list<int> ⇥ TokenizerError {
    const list<string> verba ← scanna_verba(textum)
    var list<int> ids ← vacua
    for from verba const verbum {
        const list<int> partes ← encoda(t, verbum)
        for from partes const id {
            ids.append(id)
        }
    }
    return ids
}

# Full-prompt encode, parse_special = falsum: the whole prompt goes
# through scanner + BPE (specials read as their literal bytes).
@ public { }
fn encoda_promptum(Tokenizator t, string textum) → list<int> ⇥ TokenizerError {
    return _encoda_verborum(t, textum)
}

# Full-prompt encode, parse_special = verum: split the prompt on the
# artifact special cache BEFORE the scanner (llama.cpp
# split_special_tokens/find_special_token — earliest match, longest text
# on ties), emitting each special's single id and scanning each plain
# slice independently. A prompt with no specials encodes identically to
# encoda_promptum.
@ public { }
fn encoda_promptum_specialia(Tokenizator t, string textum) → list<int> ⇥ TokenizerError {
    var list<int> ids ← vacua
    var int pos ← 0
    while pos ≺ textum.length() {
        var int melior_pos ← -1
        var int melior_id ← -1
        var int melior_longitudo ← -1
        var int i ← 0
        while i ≺ t.specialia_textus.length() {
            const string specialis ← t.specialia_textus.get(i) coalesce ""
            if specialis.length() ≻ 0 {
                const int p ← _inveni(textum, specialis, pos)
                if p ≥ 0 and ((melior_pos ≺ 0 or p ≺ melior_pos) or p ≡ melior_pos and specialis.length() ≻ melior_longitudo) {
                    melior_pos ← p
                    melior_id ← t.specialia_ids.get(i) coalesce (-1)
                    melior_longitudo ← specialis.length()
                }
            }
            i ← i + 1
        }
        if melior_pos ≺ 0 {
            const list<int> partes ← _encoda_verborum(t, textum.slice(pos, textum.length()))
            for from partes const id {
                ids.append(id)
            }
            break
        }
        if melior_pos ≻ pos {
            const list<int> partes ← _encoda_verborum(t, textum.slice(pos, melior_pos))
            for from partes const id {
                ids.append(id)
            }
        }
        ids.append(melior_id)
        pos ← melior_pos + melior_longitudo
    }
    return ids
}

# -------------------------------------------------------------------------
# EOG + BOS-free policy (LIB-02-U3-5, GGUF-A2).
#
# The runtime EOG stop set mirrors llama-vocab.cpp llm_load_vocab (pinned
# oracle 10150 `dee2a846b`): the declared tokenizer.ggml.eos_token_id is
# always a member, every vocab token whose text is in the reference EOG
# name list is a member, and the FIM pad/rep/sep ids join when the metadata
# key or a reference text-name match resolves them. For the pinned artifact
# this is exactly {248044, 248046, 248063, 248064, 248065}. The BOS policy
# reads tokenizer.ggml.add_bos_token (absent → falsum, the llama.cpp bool
# default): encode never prepends a BOS, so the falsum artifact is BOS-free
# (empty prompt → empty sequence). An artifact without EOG metadata yields
# an empty EOG set — no hard-coded SmolLM2 fallback (the stop-condition
# invariant).
# -------------------------------------------------------------------------

# Contains-check over a name list (the EOG/FIM text-name scans).
@ private { }
fn _in_nomine(string v, list<string> nomina) → bool {
    for from nomina const n {
        if v ≡ n then return true
    }
    return false
}

# Dedupe + ascending sort (the reference's EOG set order; -1 slots from the
# FIM fallback are dropped).
@ private { }
fn _ordo_surgens(list<int> a) → list<int> {
    var list<int> out ← vacua
    for from a const v {
        if v ≺ 0 {
            continue
        }
        var bool visus ← false
        var int i ← 0
        while i ≺ out.length() {
            if out.get(i) coalesce 0 ≡ v {
                visus ← true
                break
            }
            i ← i + 1
        }
        if visus {
            continue
        }
        var int pos ← 0
        while pos ≺ out.length() {
            if out.get(pos) coalesce 0 ≻ v {
                break
            }
            pos ← pos + 1
        }
        var list<int> novum ← vacua
        var int j ← 0
        while j ≺ out.length() {
            if j ≡ pos {
                novum.append(v)
            }
            novum.append(out.get(j) coalesce 0)
            j ← j + 1
        }
        if pos ≥ out.length() {
            novum.append(v)
        }
        out ← novum
    }
    return out
}

# One FIM slot: the metadata key first, else the reference text-name
# fallback (first matching vocab entry in id order). -1 when nothing
# resolves; a present-but-malformed key fails closed.
@ private { }
fn _fim_artificii(manifestum.ManifestumGguf m, list<string> verborum, string clavis, list<string> nomina) → int ⇥ TokenizerError {
    var int id ← -1
    var bool adest ← false
    do {
        id ← manifestum.numerum(m, clavis)
        adest ← true
    }
    catch err {
        const string causa ← manifestum.causa(err)
        if causa.length() ≺ 24 or causa.slice(0, 24) ≠ "metadata key not found: " {
            throw variant ArtificiumMala {causa = "tokenizer FIM metadata is malformed: " + causa}
        }
    }
    if adest {
        if id ≺ 0 or id ≥ verborum.length() {
            throw variant ArtificiumMala {causa = "tokenizer FIM id is outside the vocabulary"}
        }
        return id
    }
    var int i ← 0
    while i ≺ verborum.length() {
        if _in_nomine(verborum.get(i) coalesce "", nomina) then return i
        i ← i + 1
    }
    return -1
}

# The artifact EOG set: declared eos id + the EOG-name scan + the FIM
# pad/rep/sep slots, deduped and ascending.
@ private { }
fn _eog_artificii(manifestum.ManifestumGguf m, list<string> verborum) → list<int> ⇥ TokenizerError {
    var list<int> candidati ← vacua
    var int eos ← -1
    var bool eos_adest ← false
    do {
        eos ← manifestum.numerum(m, "tokenizer.ggml.eos_token_id")
        eos_adest ← true
    }
    catch err {
        const string causa ← manifestum.causa(err)
        if causa.length() ≺ 24 or causa.slice(0, 24) ≠ "metadata key not found: " {
            throw variant ArtificiumMala {causa = "tokenizer EOG metadata is malformed: " + causa}
        }
    }
    if eos_adest {
        if eos ≺ 0 or eos ≥ verborum.length() {
            throw variant ArtificiumMala {causa = "tokenizer eos_token_id is outside the vocabulary"}
        }
        candidati.append(eos)
    }
    var int i ← 0
    while i ≺ verborum.length() {
        if _in_nomine(verborum.get(i) coalesce "", EOG_NOMINA) {
            candidati.append(i)
        }
        i ← i + 1
    }
    candidati.append(_fim_artificii(m, verborum, "tokenizer.ggml.fim_pad_token_id", FIM_PAD_NOMINA))
    candidati.append(_fim_artificii(m, verborum, "tokenizer.ggml.fim_rep_token_id", FIM_REP_NOMINA))
    candidati.append(_fim_artificii(m, verborum, "tokenizer.ggml.fim_sep_token_id", FIM_SEP_NOMINA))
    return _ordo_surgens(candidati)
}

# The artifact's add_bos_token (GGUF bool; absent → falsum, the llama.cpp
# kv_bool default). A present non-bool value fails closed.
@ private { }
fn _add_bos_artificii(manifestum.ManifestumGguf m) → bool ⇥ TokenizerError {
    var manifestum.MetadatumGguf x ← manifestum.MetadatumGguf {clavis = "", typo = -1, valor_wire = ||}
    var bool adest ← false
    do {
        x ← manifestum.metadatum(m, "tokenizer.ggml.add_bos_token")
        adest ← true
    }
    catch err {
        const string causa ← manifestum.causa(err)
        if causa.length() ≺ 24 or causa.slice(0, 24) ≠ "metadata key not found: " {
            throw variant ArtificiumMala {causa = "tokenizer.add_bos_token is malformed: " + causa}
        }
    }
    if not adest then return false
    if x.typo ≠ TYPI_BOOL {
        throw variant ArtificiumMala {causa = "tokenizer.add_bos_token is not a GGUF bool"}
    }
    const list<int> bs ← _octeti_numeri(x.valor_wire)
    return bs.get(0) coalesce 0 ≡ 1
}

# The artifact's chat template (U3-6). tokenizer.chat_template is OPTIONAL
# in GGUF: absent → empty string (the artifact declares no template — the
# renderer fails closed instead of inventing one). A PRESENT but malformed
# value fails closed.
@ private { }
fn _chat_template_artificii(manifestum.ManifestumGguf m) → string ⇥ TokenizerError {
    do {
        return manifestum.textum(m, "tokenizer.chat_template")
    }
    catch err {
        const string causa ← manifestum.causa(err)
        if causa.length() ≥ 24 {
            if causa.slice(0, 24) ≡ "metadata key not found: " then return ""
        }
        throw variant ArtificiumMala {causa = "tokenizer.chat_template is malformed: " + causa}
    }
    throw variant ArtificiumMala {causa = "unreachable tokenizer.chat_template read"}
}

# The runtime EOG stop set (ascending; mirrors the reference's set order).
@ public { }
fn eog_artificii(Tokenizator t) → list<int> {
    return t.eog
}

# EOG-membership predicate — the runtime generation stop-policy binding
# (the artifact-set equivalent of the identity contract's est_eog).
@ public { }
fn est_eog_artificii(Tokenizator t, int id) → bool {
    for from t.eog const e {
        if id ≡ e then return true
    }
    return false
}

# The artifact's add_bos_token flag (falsum for the pinned artifact — the
# BOS-free policy: encode never prepends a BOS).
@ public { }
fn add_bos(Tokenizator t) → bool {
    return t.add_bos
}

# -------------------------------------------------------------------------
# Chat-template policy (LIB-02-U3-6, GGUF-A2).
#
# `tokenizer.chat_template` loads from artifact metadata (empty when the
# artifact declares none — the no-template state). The MINIMAL Qwen3-ChatML
# user-turn render applies the pinned shape `<|im_start|>user\n{content}
# <|im_end|>\n` — the executed subset of the artifact's Jinja template, NOT
# a universal template engine (the delivery forbids one). Full vision/tool-
# calling branches of the template are recorded, not executed (stop-
# condition scope). Rendering fails closed when the artifact declares no
# template — no hard-coded fallback (the artifact-backed invariant).
# -------------------------------------------------------------------------

# The artifact's chat template (the minimal ChatML subset the renderer
# applies; empty when the artifact declares none).
@ public { }
fn chat_template(Tokenizator t) → string {
    return t.chat_template
}

# Minimal Qwen3-ChatML user-turn render: `<|im_start|>user\n{content}
# <|im_end|>\n`. The content embeds verbatim, so encoding the rendered turn
# composes without changing the content's pinned ids (R1, U3-6 oracle).
@ public { }
fn redde_turnum_user(Tokenizator t, string content) → string ⇥ TokenizerError {
    if t.chat_template.length() ≡ 0 {
        throw variant ArtificiumMala {causa = "artifact declares no chat template"}
    }
    return ("<|im_start|>user\n" + content) + "<|im_end|>\n"
}
