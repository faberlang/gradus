    + "10379,1066,260,452,55,69,54,3608,10220,28,284,260,29709,988,3237,971,3608,4624,981,260,6736,17109,30,669,1157,8211,260,2609,2050,1890,42,253,6011,314,10717,618,17837,28,260,17837,359,4180,288,260,1743,28,284,260,23146,3124,314,2198,2520,1056,288,260,38448,30,1943,282,"
    + "260,14019,3301,3073,23124,940,1699,980,6177,28,975,260,2444,13281,7313,281,582,980,351,253,3600,2468,30,669,8510,314,18519,9174,588,338,6514,722,281,253,986,2468,29278,1072,441,8542,260,1743,1731,750,1542,4234,30,657,5961,805,288,1538,253,43524,1902,282,2468,1694,327,260,"
    + "26211,28,284,357,314,16551,429,7094,39799,15590,338,15121,3869,30,198"

# -------------------------------------------------------------------------
# TokenizerError — typed error vocabulary of the tokenizer identity
# contract. Variant → class:
#   VersioIgnota       — unknown tokenizer identity schema version.
#   ProgeniesIgnota    — un-admitted tokenizer kind (must be gpt2 / BBPE).
#   PreIgnotus         — un-admitted pre-tokenizer (must be smollm).
#   VocabulumMala      — vocab / merges / specials count mismatch.
#   DigestioMala       — malformed vocabulary digest (not 64-hex).
#   EogMala            — malformed EOG set (must be {0, 2}).
#   IdExtra            — token id outside the admitted range [0, vocab).
#   ProbeDivergens     — probe id list diverges from the pinned fixture
#                        (a different tokenizer — must fail admission).
#   ArtificiumMala     — artifact tokenizer metadata is unavailable
#                        or malformed (LIB-02-U2 runtime).
#   MergesMala         — malformed merge entry in the artifact (U2).
#   IdIgnotum          — unknown token id in decode (out of range) (U2).
#   VestigiumIgnotum   — display character with no byte mapping (U2).
#   Utf8Mala           — byte sequence is not valid UTF-8 (U2).
#   WireMala           — malformed tokenizer identity wire form.
# -------------------------------------------------------------------------

discretio TokenizerError {
    VersioIgnota { textus causa },
    ProgeniesIgnota { textus causa },
    PreIgnotus { textus causa },
    VocabulumMala { textus causa },
    DigestioMala { textus causa },
    EogMala { textus causa },
    IdExtra { textus causa },
    ProbeDivergens { textus causa },
    ArtificiumMala { textus causa },
    MergesMala { textus causa },
    IdIgnotum { textus causa },
    VestigiumIgnotum { textus causa },
    Utf8Mala { textus causa },
    WireMala { textus causa }
}

functio causa(TokenizerError e) → textus {
    discerne e {
        casu VersioIgnota fixum causa { redde causa }
        casu ProgeniesIgnota fixum causa { redde causa }
        casu PreIgnotus fixum causa { redde causa }
        casu VocabulumMala fixum causa { redde causa }
        casu DigestioMala fixum causa { redde causa }
        casu EogMala fixum causa { redde causa }
        casu IdExtra fixum causa { redde causa }
        casu ProbeDivergens fixum causa { redde causa }
        casu ArtificiumMala fixum causa { redde causa }
        casu MergesMala fixum causa { redde causa }
        casu IdIgnotum fixum causa { redde causa }
        casu VestigiumIgnotum fixum causa { redde causa }
        casu Utf8Mala fixum causa { redde causa }
        casu WireMala fixum causa { redde causa }
    }
}

# -------------------------------------------------------------------------
# IdentitasTokenizator — the versioned tokenizer identity record. The
# field vocabulary mirrors the capsule's IdentitasTokenizer (field 3) so
# the capsule can be built from this contract's values; the schema stamp
# makes the record versioned. Immutable — accessors only.
# -------------------------------------------------------------------------

genus IdentitasTokenizator {
    textus schema
    textus progenies
    textus pre_tokenizator
    textus digestio_vocabuli
    textus eog
    bivalens bos_vacua
    bivalens spatium_vacua

    functio schematis() → textus {
        redde ego.schema
    }

    functio progenies() → textus {
        redde ego.progenies
    }

    functio pre_tokenizator() → textus {
        redde ego.pre_tokenizator
    }

    functio digestio_vocabuli() → textus {
        redde ego.digestio_vocabuli
    }

    functio eog() → textus {
        redde ego.eog
    }

    functio bos_vacua() → bivalens {
        redde ego.bos_vacua
    }

    functio spatium_vacua() → bivalens {
        redde ego.spatium_vacua
    }
}

# -------------------------------------------------------------------------
# Private validation helpers. All return bivalens (predicates); structa and
# verifica turn a falsum into the matching typed TokenizerError.
# -------------------------------------------------------------------------

# Hex-digit predicate for digest values.
@ privata
functio _est_hex(textus c) → bivalens {
    si c ≡ "0" aut c ≡ "1" aut c ≡ "2" aut c ≡ "3" aut c ≡ "4" aut c ≡ "5" aut c ≡ "6" aut c ≡ "7" aut c ≡ "8" aut c ≡ "9" ergo redde verum
    si c ≡ "a" aut c ≡ "b" aut c ≡ "c" aut c ≡ "d" aut c ≡ "e" aut c ≡ "f" ergo redde verum
    redde falsum
}

# Whole-digest predicate: exactly 64 lowercase hex characters.
@ privata
functio _hex_recta(textus s) → bivalens {
    si s.longitudo() ≠ 64 ergo redde falsum
    varia numerus i ← 0
    dum i < s.longitudo() {
        si non (_est_hex(s.accipe(i))) ergo redde falsum
        i ← i + 1
    }
    redde verum
}

# Digit predicate (no negative sign — a "-" fails closed).
@ privata
functio _est_digitum(textus c) → bivalens {
    redde c ≡ "0" aut c ≡ "1" aut c ≡ "2" aut c ≡ "3" aut c ≡ "4" aut c ≡ "5" aut c ≡ "6" aut c ≡ "7" aut c ≡ "8" aut c ≡ "9"
}

# EOG-set WELL-FORMEDNESS predicate: comma-separated, non-empty, strictly
# ascending, non-negative integer token ids. The EXACT pinned value {0, 2}
# is enforced separately in structa/verifica (the admission-surface
# correctness fix: a well-formed-but-different set like "1,5" is a
# different tokenizer and fails closed).
@ privata
functio _eog_recta(textus eog) → bivalens {
    si eog.longitudo() ≡ 0 ergo redde falsum
    fixum lista<textus> partes ← eog.divide(",")
    varia numerus ultimum ← -1
    itera ex partes fixum p {
        si p.longitudo() ≡ 0 ergo redde falsum
        si p.longitudo() > 18 ergo redde falsum
        varia numerus i ← 0
        dum i < p.longitudo() {
            si non (_est_digitum(p.accipe(i))) ergo redde falsum
            i ← i + 1
        }
        fac {
            fixum numerus v ← p ↦ numerus
            si v ≤ ultimum ergo redde falsum
            ultimum ← v
        }
        cape err {
            redde falsum
        }
    }
    redde verum
}

# Token id in range predicate: 0 ≤ id < VOCABULUM.
@ privata
functio _id_in_ambitu(numerus id) → bivalens {
    si id < 0 ergo redde falsum
    si id ≥ VOCABULUM ergo redde falsum
    redde verum
}

# -------------------------------------------------------------------------
# proba_aequa — exact id-list equality (the probe-parity predicate).
# Length + element-wise; the contract is exact match, nothing less.
# -------------------------------------------------------------------------

functio proba_aequa(lista<numerus> a, lista<numerus> b) → bivalens {
    si a.longitudo() ≠ b.longitudo() ergo redde falsum
    varia numerus i ← 0
    dum i < a.longitudo() {
        si (a.accipe(i) vel 0) ≠ (b.accipe(i) vel 0) ergo redde falsum
        i ← i + 1
    }
    redde verum
}

# -------------------------------------------------------------------------
# proba_ida — parse a comma-separated pinned id-list fixture into the id
# vector. Empty fixture → empty list (P4). Fail closed on malformed
# (non-digit / out-of-range) ids.
# -------------------------------------------------------------------------

functio proba_ida(textus pinnata) → lista<numerus> ⇥ TokenizerError {
    varia lista<numerus> out ← vacua
    si pinnata.longitudo() ≡ 0 ergo redde out
    fixum lista<textus> partes ← pinnata.divide(",")
    itera ex partes fixum p {
        si p.longitudo() ≡ 0 ergo iace finge WireMala { causa = "malformed pinned id list" }
        varia numerus i ← 0
        dum i < p.longitudo() {
            si non (_est_digitum(p.accipe(i))) ergo iace finge WireMala { causa = "non-digit token id in pinned fixture" }
            i ← i + 1
        }
        varia numerus v ← 0
        fac {
            v ← p ↦ numerus
        }
        cape err {
            iace finge WireMala { causa = "malformed pinned id list" }
        }
        si non (_id_in_ambitu(v)) {
            iace finge IdExtra { causa = "token id out of range: " + p }
        }
        out.appende(v)
    }
    redde out
}

# -------------------------------------------------------------------------
# verifica_proba — the fail-closed probe-parity admission check. Given an
# observed id list for a named pinned probe, it must match the pinned
# fixture EXACTLY; divergence fails closed with ProbeDivergens (a
# tokenizer whose ids diverge from the pinned probes is a different
# tokenizer and must fail admission — capsule contract §3.3).
# -------------------------------------------------------------------------

functio verifica_proba(textus nomen, lista<numerus> observata) → bivalens ⇥ TokenizerError {
    fixum lista<numerus> pinnata ← proba_ida(pinnata_proba(nomen))
    si non (proba_aequa(pinnata, observata)) {
        iace finge ProbeDivergens { causa = "tokenizer ids diverge from the pinned llama.cpp probe: " + nomen }
    }
    redde verum
}

# Pinned fixture lookup by probe name ("p1".."p11", "correctio", "brevis",
# "normale", "contextus"). Unknown name → fail closed.
functio pinnata_proba(textus nomen) → textus ⇥ TokenizerError {
    si nomen ≡ "p1" ergo redde PINNATA_P1
    si nomen ≡ "p2" ergo redde PINNATA_P2
    si nomen ≡ "p4" ergo redde PINNATA_P4
    si nomen ≡ "p5" ergo redde PINNATA_P5
    si nomen ≡ "p6" ergo redde PINNATA_P6
    si nomen ≡ "p7" ergo redde PINNATA_P7
    si nomen ≡ "p8" ergo redde PINNATA_P8
    si nomen ≡ "p9" ergo redde PINNATA_P9
    si nomen ≡ "p10" ergo redde PINNATA_P10
    si nomen ≡ "p11" ergo redde PINNATA_P11
    si nomen ≡ "correctio" ergo redde PINNATA_CORRECTIO
    si nomen ≡ "brevis" ergo redde PINNATA_BREVIS
    si nomen ≡ "normale" ergo redde PINNATA_NORMALE
    si nomen ≡ "contextus" ergo redde PINNATA_CONTEXTUS
    iace finge WireMala { causa = "unknown pinned probe: " + nomen }
}

# -------------------------------------------------------------------------
# structa — the fail-closed tokenizer identity ADMISSION. Every field is
# validated against the pinned row before the identity is built; any
# violation throws the matching typed TokenizerError. Schema version
# rejection first (§5: unknown schema → typed failure before use).
# -------------------------------------------------------------------------

functio structa(
    textus schema,
    textus progenies,
    textus pre_tokenizator,
    textus digestio_vocabuli,
    textus eog,
    bivalens bos_vacua,
    bivalens spatium_vacua
) → IdentitasTokenizator ⇥ TokenizerError {
    si schema ≠ schema_versio {
        iace finge VersioIgnota { causa = "unknown tokenizer identity schema version: " + schema }
    }
    si progenies ≠ TOKENIZATOR_KIND {
        iace finge ProgeniesIgnota { causa = "un-admitted tokenizer kind: " + progenies + " (pinned row is gpt2 / byte-level BPE)" }
    }
    si pre_tokenizator ≠ TOKENIZATOR_PRE {
        iace finge PreIgnotus { causa = "un-admitted pre-tokenizer: " + pre_tokenizator + " (pinned row is smollm)" }
    }
    si non (_hex_recta(digestio_vocabuli)) {
        iace finge DigestioMala { causa = "malformed vocabulary digest" }
    }
    si non (_eog_recta(eog)) {
        iace finge EogMala { causa = "malformed EOG set" }
    }
    # The exact pinned EOG value (the admission-surface correctness fix):
    # a well-formed-but-different set is a different tokenizer.
    si eog ≠ EOG {
        iace finge EogMala { causa = "EOG set does not match the pinned row: " + eog }
    }
    # Pinned add-* flags are falsum ("add_bos_token = false"); the record's
    # bos_vacua / spatium_vacua are the POSITIVE facts (verum = BOS-free /
    # space-prefix-free). A row whose vacua flag equals the falsum add-*
    # state is NOT BOS-free / NOT space-prefix-free — fail closed (polarity
    # fix: was ≠, which inverted admission).
    si bos_vacua ≡ ADD_BOS {
        iace finge EogMala { causa = "pinned row is BOS-free (add_bos_token = false)" }
    }
    si spatium_vacua ≡ ADD_SPATIUM {
        iace finge EogMala { causa = "pinned row is space-prefix-free (add_space_prefix = false)" }
    }
    redde IdentitasTokenizator {
        schema = schema,
        progenies = progenies,
        pre_tokenizator = pre_tokenizator,
        digestio_vocabuli = digestio_vocabuli,
        eog = eog,
        bos_vacua = bos_vacua,
        spatium_vacua = spatium_vacua
    }
}

# -------------------------------------------------------------------------
# verifica — consumer-side self-verification (self-verifying contract). Re-
# runs the admission matrix over the identity without re-deriving raw
# facts. An identity built by structa always passes; this is the
# defense-in-depth check for identities received across an owner boundary.
# -------------------------------------------------------------------------

functio verifica(IdentitasTokenizator t) → bivalens ⇥ TokenizerError {
    si t.schematis() ≠ schema_versio {
        iace finge VersioIgnota { causa = "unknown tokenizer identity schema version: " + t.schematis() }
    }
    si t.progenies() ≠ TOKENIZATOR_KIND {
        iace finge ProgeniesIgnota { causa = "un-admitted tokenizer kind: " + t.progenies() }
    }
    si t.pre_tokenizator() ≠ TOKENIZATOR_PRE {
        iace finge PreIgnotus { causa = "un-admitted pre-tokenizer: " + t.pre_tokenizator() }
    }
    si non (_hex_recta(t.digestio_vocabuli())) {
        iace finge DigestioMala { causa = "malformed vocabulary digest" }
    }
    si non (_eog_recta(t.eog())) {
        iace finge EogMala { causa = "malformed EOG set" }
    }
    si t.eog() ≠ EOG {
        iace finge EogMala { causa = "EOG set does not match the pinned row: " + t.eog() }
    }
    # Same polarity as structa: a vacua flag equal to the pinned falsum
    # add-* state means the row is NOT BOS-free / NOT space-prefix-free.
    si t.bos_vacua() ≡ ADD_BOS {
        iace finge EogMala { causa = "pinned row is BOS-free" }
    }
    si t.spatium_vacua() ≡ ADD_SPATIUM {
        iace finge EogMala { causa = "pinned row is space-prefix-free" }
    }
    redde verum
}

# -------------------------------------------------------------------------
# clavis_tokenizatoris — the tokenizer identity component of the KV block
# key (MD-A9 precedent). The KV key uses a collision-resistant digest over
# model bytes/version, execution configuration, tokenizer/chat-template
# and special-token policy, ... — this module owns the tokenizer identity
# component. The digest VALUE is computed by the host (no crypto in the
# language surface); this function renders the deterministic canonical
# component a host digests into the KV block key.
# -------------------------------------------------------------------------

functio clavis_tokenizatoris(IdentitasTokenizator t) → textus ⇥ TokenizerError {
    si non (verifica(t)) {
        iace finge WireMala { causa = "tokenizer identity failed verification" }
    }
    redde "tokenizer/identity/" + t.schematis() + "/" + t.progenies() + "/" + t.pre_tokenizator() + "/" + t.digestio_vocabuli() + "/" + t.eog() + "/bos-free=" + (t.bos_vacua() ↦ textus) + "/space-prefix-free=" + (t.spatium_vacua() ↦ textus)
}

# -------------------------------------------------------------------------
# Identity wire form — the versioned tokenizer identity that crosses owner
# boundaries and participates in the KV identity key. Deserialization
# rejects an unknown schema version and un-admitted facts — fail closed,
# no best-effort partial reads (§5).
#   tokenizer/identity/<schema>/<kind>/<pre>/<vocab-digest>/<eog>
# -------------------------------------------------------------------------

functio serializa_identitas(IdentitasTokenizator t) → textus ⇥ TokenizerError {
    si non (verifica(t)) {
        iace finge WireMala { causa = "tokenizer identity failed verification" }
    }
    redde "tokenizer/identity/" + t.schematis() + "/" + t.progenies() + "/" + t.pre_tokenizator() + "/" + t.digestio_vocabuli() + "/" + t.eog()
}

functio deserializa_identitas(textus wire) → IdentitasTokenizator ⇥ TokenizerError {
    fixum lista<textus> partes ← wire.divide("/")
    si partes.longitudo() ≠ 7 {
        iace finge WireMala { causa = "malformed tokenizer identity wire form" }
    }
    si partes.accipe(0) vel "" ≠ "tokenizer" aut partes.accipe(1) vel "" ≠ "identity" {
        iace finge WireMala { causa = "unknown tokenizer identity marker" }
    }
    fixum textus schema ← partes.accipe(2) vel ""
    si schema ≠ schema_versio {
        iace finge VersioIgnota { causa = "unknown tokenizer identity schema version: " + schema }
    }
    fixum textus progenies ← partes.accipe(3) vel ""
    fixum textus pre_tokenizator ← partes.accipe(4) vel ""
    fixum textus digestio_vocabuli ← partes.accipe(5) vel ""
    fixum textus eog ← partes.accipe(6) vel ""
    redde structa(schema, progenies, pre_tokenizator, digestio_vocabuli, eog, verum, verum)
}

# -------------------------------------------------------------------------
# Artifact-backed byte-level BPE runtime (LIB-02-U2, GGUF-A2).
#
# The runtime consumes the vocab and merge arrays from a schema-2
# ManifestumGguf through the U1 accessors (textorum) and implements the
# llama.cpp llm_tokenizer_bpe core at the word-level boundary:
#   * gpt2 byte-to-unicode display mapping (each UTF-8 byte of the input maps
#     to one display codepoint; the vocab/merge strings live in that space),
#   * ranked bigram merging — one merge at a time, ties broken by leftmost
#     position — matching the pinned reference queue semantics,
#   * final-piece vocab lookup with a single-byte (fallback) split,
#   * decode via the inverse display mapping, concatenating bytes and
#     decoding UTF-8.
# The pre-tokenizer is identity at this boundary (U3 composes it). No vocab
# or merge table is hard-coded here: everything comes from the manifest.
#
# -------------------------------------------------------------------------

# Byte-level BPE capability contract. The runtime only implements the gpt2
# byte-to-unicode convention, so the manifest's declared tokenizer model must
# be the byte-level family. Independent of the identity contract's pinned
# SmolLM2 kind constant (clean break posture).
fixum textus TOKENIZATOR_CAPABILIS ← "gpt2"

# Sentinel rank for a pair absent from the merge table (never merges).
fixum numerus MERGE_ABSENS ← 9223372036854775807

# llama.cpp llama_token_type NORMAL — the special-cache boundary: every
# vocab entry whose token_type is not NORMAL is special (the
# llama_vocab::init_special rule; U3-4).
fixum numerus TYPI_NORMALIS ← 1

# GGUF metadata wire type for tokenizer.ggml.add_bos_token (bool) — mirrors
# the manifest module's private GGUF_BOOL constant (7).
fixum numerus TYPI_BOOL ← 7

# EOG text names (llama-vocab.cpp llm_load_vocab, pinned oracle 10150
# `dee2a846b`): every vocab token whose text is one of these names is an
# end-of-generation token (U3-5). The final name is the DeepSeek-OCR form
# with fullwidth bars and U+2581 lower-one-eighth-block separators.
fixum lista<textus> EOG_NOMINA ← [
    "<|eot_id|>", "<|im_end|>", "<|end|>", "<|return|>", "<|call|>",
    "<|flush|>", "<|calls|>", "<end_of_turn>", "<|endoftext|>", "</s>",
    "<|eom_id|>", "<EOT>", "_<EOT>", "[EOT]", "[EOS]",
    "<|end_of_text|>", "<end_of_utterance>", "<eos>", "<turn|>",
    "<|tool_response>", "<｜end▁of▁sentence｜>", "[e~["
]

# FIM token text-name fallbacks — llama.cpp only falls back to these when
# the tokenizer.ggml.fim_*_token_id metadata keys are absent.
fixum lista<textus> FIM_PAD_NOMINA ← ["<|fim_pad|>", "<fim-pad>", "<fim_pad>", "<PAD>", "[PAD]"]
fixum lista<textus> FIM_REP_NOMINA ← ["<|fim_repo|>", "<|repo_name|>", "<fim-repo>", "<REPO>", "<reponame>"]
fixum lista<textus> FIM_SEP_NOMINA ← ["<|file_sep|>"]

# The artifact-backed runtime record. `verborum` is the vocab array indexed
# by token id (decode path); `vocabulum` is the display-token → id map and
# `concursus` the "left right" merge-pair → rank map (encode path).
# `specialia_textus`/`specialia_ids` are the artifact special-token cache
# (parallel lists; every non-NORMAL token_type entry, U3-4) that drives the
# parse-special on/off policy. `eog` is the artifact EOG stop set and
# `add_bos` the artifact's add_bos_token flag (U3-5).
@ publica
genus Tokenizator {
    lista<textus> verborum
    tabula<textus, numerus> vocabulum
    tabula<textus, numerus> concursus
    lista<textus> specialia_textus
    lista<numerus> specialia_ids
    lista<numerus> eog
    bivalens add_bos
    numerus multitudo
}

# --- Byte ↔ display-codepoint mapping (gpt2 convention) --------------------

# Byte value → display codepoint. Bytes in the printable/Latin-1 ranges map
# to themselves; the remaining 68 bytes map to 0x100+n in ascending byte
# order (0x00 → U+0100, 0x20 → U+0120, 0x7F → U+0121, …, 0xAD → U+0143).
@ privata
functio _codicillus_ex_octeto(numerus byte) → numerus ⇥ TokenizerError {
    si byte < 0 aut byte > 255 {
        iace finge WireMala { causa = "byte value outside 0..255" }
    }
    si byte ≥ 0x21 et byte ≤ 0x7E ergo redde byte
    si byte ≥ 0xA1 et byte ≤ 0xAC ergo redde byte
    si byte ≥ 0xAE et byte ≤ 0xFF ergo redde byte
    si byte ≤ 0x20 ergo redde 256 + byte
    si byte ≤ 0xA0 ergo redde byte + 162
    redde 323
}

# Display codepoint → byte value (inverse mapping). Unmappable codepoints
# are malformed vocab content and fail closed.
@ privata
functio _octetus_ex_codicillo(numerus cpt) → numerus ⇥ TokenizerError {
    si cpt ≥ 0x21 et cpt ≤ 0x7E ergo redde cpt
    si cpt ≥ 0xA1 et cpt ≤ 0xAC ergo redde cpt
    si cpt ≥ 0xAE et cpt ≤ 0xFF ergo redde cpt
    si cpt ≥ 0x100 et cpt ≤ 0x120 ergo redde cpt - 256
    si cpt ≥ 0x121 et cpt ≤ 0x142 ergo redde cpt - 162
    si cpt ≡ 0x143 ergo redde 0xAD
    iace finge VestigiumIgnotum { causa = "display character has no byte mapping (codepoint " + (cpt ↦ textus) + ")" }
}

# --- Codepoint ↔ textus helpers -------------------------------------------

@ privata
functio _textus_ex_octeti(lista<numerus> bs) → textus ⇥ TokenizerError {
    varia lista<numerus<u8>> u8s ← vacua
    itera ex bs fixum b {
        u8s.appende(b ∷ numerus<u8>)
    }
    fixum octeti o ← u8s ↦ octeti
    fac {
        redde o ↦ textus
    }
    cape err {
        iace finge Utf8Mala { causa = "display character bytes are not valid UTF-8" }
    }
    iace finge Utf8Mala { causa = "unreachable display character conversion" }
}

# UTF-8 encode one codepoint to its single-character textus. Display
# codepoints are ≤ 0x143, so the 1- and 2-byte arms cover the mapping; the
# longer arms keep the helper total for arbitrary vocab content.
@ privata
functio _textus_ex_codicillo(numerus cpt) → textus ⇥ TokenizerError {
    si cpt < 0 {
        iace finge WireMala { causa = "negative codepoint" }
    }
    si cpt < 0x80 ergo redde _textus_ex_octeti([cpt])
    si cpt < 0x800 {
        fixum numerus b0 ← 0xC0 ∨ (cpt ⇒ 6)
        fixum numerus b1 ← 0x80 ∨ (cpt ∧ 0x3F)
        redde _textus_ex_octeti([b0, b1])
    }
    si cpt < 0x10000 {
        fixum numerus b0 ← 0xE0 ∨ (cpt ⇒ 12)
        fixum numerus b1 ← 0x80 ∨ ((cpt ⇒ 6) ∧ 0x3F)
        fixum numerus b2 ← 0x80 ∨ (cpt ∧ 0x3F)
        redde _textus_ex_octeti([b0, b1, b2])
    }
    si cpt < 0x110000 {
        fixum numerus b0 ← 0xF0 ∨ (cpt ⇒ 18)
        fixum numerus b1 ← 0x80 ∨ ((cpt ⇒ 12) ∧ 0x3F)
        fixum numerus b2 ← 0x80 ∨ ((cpt ⇒ 6) ∧ 0x3F)
        fixum numerus b3 ← 0x80 ∨ (cpt ∧ 0x3F)
        redde _textus_ex_octeti([b0, b1, b2, b3])
    }
    iace finge WireMala { causa = "codepoint exceeds the Unicode range" }
}

# UTF-8 decode one character back to its codepoint. A single character is
# one to four bytes.
@ privata
functio _codicillus_ex_vestigio(textus c) → numerus ⇥ TokenizerError {
    fixum lista<numerus> bs ← _octeti_numeri(c ↦ octeti)
    fixum numerus n ← bs.longitudo()
    fixum numerus b0 ← bs.accipe(0) vel 0
    si n ≡ 1 ergo redde b0
    fixum numerus b1 ← bs.accipe(1) vel 0
    si n ≡ 2 ergo redde ((b0 ∧ 0x1F) ⇐ 6) ∨ (b1 ∧ 0x3F)
    fixum numerus b2 ← bs.accipe(2) vel 0
    si n ≡ 3 ergo redde ((b0 ∧ 0x0F) ⇐ 12) ∨ ((b1 ∧ 0x3F) ⇐ 6) ∨ (b2 ∧ 0x3F)
    fixum numerus b3 ← bs.accipe(3) vel 0
    si n ≡ 4 ergo redde ((b0 ∧ 0x07) ⇐ 18) ∨ ((b1 ∧ 0x3F) ⇐ 12) ∨ ((b2 ∧ 0x3F) ⇐ 6) ∨ (b3 ∧ 0x3F)
    iace finge VestigiumIgnotum { causa = "malformed display character" }
}

# Bulk octeti → byte-value bridge (the runtime's analogue of the manifest
# module's `_octeti_lista`; error-free by construction — the input always
# comes from a textus UTF-8 encode, so the valor carrier is a byte list).
@ privata
functio _octeti_numeri(octeti o) → lista<numerus> {
    fixum valor v ← o ↦ valor
    redde v ↦ lista<numerus>
}

# One display character (the byte-level BPE symbol for a single source byte).
@ privata
functio _vestigium_ex_octeto(numerus byte) → textus ⇥ TokenizerError {
    redde _textus_ex_codicillo(_codicillus_ex_octeto(byte))
}

# --- Manifest reads and merge-table construction ---------------------------

@ privata
functio _textum_artificii(manifestum.ManifestumGguf m, textus clavis) → textus ⇥ TokenizerError {
    fac {
        redde manifestum.textum(m, clavis)
    }
    cape err {
        iace finge ArtificiumMala { causa = "tokenizer metadata is unavailable: " + manifestum.causa(err) }
    }
    iace finge ArtificiumMala { causa = "unreachable tokenizer metadata read" }
}

@ privata
functio _textorum_artificii(manifestum.ManifestumGguf m, textus clavis) → lista<textus> ⇥ TokenizerError {
    fac {
        redde manifestum.textorum(m, clavis)
    }
    cape err {
        iace finge ArtificiumMala { causa = "tokenizer array is unavailable: " + manifestum.causa(err) }
    }
    iace finge ArtificiumMala { causa = "unreachable tokenizer array read" }
}

# tokenizer.ggml.token_type is OPTIONAL in GGUF: llama.cpp defaults absent
# types to NORMAL (→ an empty special cache). A PRESENT but malformed
# token_type fails closed.
@ privata
functio _typi_artificii_optativa(manifestum.ManifestumGguf m) → lista<numerus> ⇥ TokenizerError {
    fac {
        redde manifestum.numerorum(m, "tokenizer.ggml.token_type")
    }
    cape err {
        fixum textus causa ← manifestum.causa(err)
        si causa.longitudo() ≥ 24 {
            si causa.sectio(0, 24) ≡ "metadata key not found: " {
                redde vacua
            }
        }
        iace finge ArtificiumMala { causa = "tokenizer token_type is malformed: " + causa }
    }
    iace finge ArtificiumMala { causa = "unreachable tokenizer token_type read" }
}

# Merge-entry well-formedness: exactly "left right" with a single space
# separator and non-empty halves (llama.cpp's find_bpe_rank asserts the same
# no-space-in-token invariant).
@ privata
functio _par_recta(textus par) → bivalens {
    si par.longitudo() ≡ 0 ergo redde falsum
    fixum lista<textus> partes ← par.divide(" ")
    si partes.longitudo() ≠ 2 ergo redde falsum
    si (partes.accipe(0) vel "").longitudo() ≡ 0 ergo redde falsum
    si (partes.accipe(1) vel "").longitudo() ≡ 0 ergo redde falsum
    redde verum
}

# --- BPE merge loop (llama.cpp one-at-a-time semantics) --------------------

# Repeatedly merge the adjacent pair with the lowest merge rank (ties broken
# by the leftmost position), one occurrence per step, until no pair merges.
# Matches the pinned reference's priority-queue behavior; a fresh scan each
# step makes stale entries impossible.
@ privata
functio _bpe_coagmenta(tabula<textus, numerus> concursus, lista<textus> symbola) → lista<textus> {
    varia lista<textus> cur ← symbola
    dum verum {
        fixum numerus n ← cur.longitudo()
        si n < 2 {
            rumpe
        }
        varia numerus melior_rank ← MERGE_ABSENS
        varia numerus melior_pos ← -1
        varia numerus i ← 0
        dum i + 1 < n {
            fixum textus l ← cur.accipe(i) vel ""
            fixum textus r ← cur.accipe(i + 1) vel ""
            fixum numerus rank ← concursus.accipe(l + " " + r) vel MERGE_ABSENS
            si rank < melior_rank aut (rank ≡ melior_rank et melior_pos ≥ 0 et i < melior_pos) {
                melior_rank ← rank
                melior_pos ← i
            }
            i ↑
        }
        si melior_pos < 0 {
            rumpe
        }
        fixum textus cohaesum ← (cur.accipe(melior_pos) vel "") + (cur.accipe(melior_pos + 1) vel "")
        varia lista<textus> novum ← vacua
        varia numerus j ← 0
        dum j < n {
            si j ≡ melior_pos {
                novum.appende(cohaesum)
                j ← j + 2
            }
            secus {
                novum.appende(cur.accipe(j) vel "")
                j ← j + 1
            }
        }
        cur ← novum
    }
    redde cur
}

# --- Runtime construction, encode, decode -----------------------------------

# Build the runtime from a parsed manifest. The vocab and merge arrays come
# from the artifact; the declared model must be the byte-level BPE family.
@ publica
functio fabricare(manifestum.ManifestumGguf m) → Tokenizator ⇥ TokenizerError {
    fixum textus progenies ← _textum_artificii(m, "tokenizer.ggml.model")
    si progenies ≠ TOKENIZATOR_CAPABILIS {
        iace finge ProgeniesIgnota { causa = "tokenizer runtime is byte-level BPE; manifest declares: " + progenies }
    }
    fixum lista<textus> verborum ← _textorum_artificii(m, "tokenizer.ggml.tokens")
    si verborum.longitudo() ≡ 0 {
        iace finge ArtificiumMala { causa = "tokenizer vocabulary is empty" }
    }
    fixum lista<textus> merges ← _textorum_artificii(m, "tokenizer.ggml.merges")
    varia tabula<textus, numerus> vocabulum ← vacua
    varia numerus i ← 0
    dum i < verborum.longitudo() {
        vocabulum.pone(verborum.accipe(i) vel "", i)
        i ↑
    }
    varia tabula<textus, numerus> concursus ← vacua
    varia numerus j ← 0
    dum j < merges.longitudo() {
        fixum textus par ← merges.accipe(j) vel ""
        si non (_par_recta(par)) {
            iace finge MergesMala { causa = "malformed merge entry: " + par }
        }
        concursus.pone(par, j)
        j ↑
    }
    # Special-token cache (U3-4): every vocab entry whose token_type is not
    # NORMAL is special (llama.cpp llama_vocab::init_special); absent
    # token_type means no specials (the reference defaults to NORMAL).
    fixum lista<numerus> typi ← _typi_artificii_optativa(m)
    si typi.longitudo() > 0 et typi.longitudo() ≠ verborum.longitudo() {
        iace finge ArtificiumMala { causa = "tokenizer token_type length does not match the vocabulary" }
    }
    varia lista<textus> specialia_textus ← vacua
    varia lista<numerus> specialia_ids ← vacua
    varia numerus k ← 0
    dum k < verborum.longitudo() {
        fixum numerus typus ← typi.accipe(k) vel TYPI_NORMALIS
        si typus ≠ TYPI_NORMALIS {
            specialia_textus.appende(verborum.accipe(k) vel "")
            specialia_ids.appende(k)
        }
        k ↑
    }
    # EOG stop set + BOS policy (U3-5), derived from the artifact exactly
    # like llama.cpp llm_load_vocab: the declared eos id, the reference EOG
    # text names, and the FIM pad/rep/sep ids (metadata first, else the
    # text-name fallback); add_bos reads tokenizer.ggml.add_bos_token.
    fixum lista<numerus> eog ← _eog_artificii(m, verborum)
    fixum bivalens add_bos ← _add_bos_artificii(m)
    redde Tokenizator {
        verborum = verborum,
        vocabulum = vocabulum,
        concursus = concursus,
        specialia_textus = specialia_textus,
        specialia_ids = specialia_ids,
        eog = eog,
        add_bos = add_bos,
        multitudo = verborum.longitudo()
    }
}

# Word-level encode: UTF-8 bytes → display symbols → BPE merges → vocab ids.
# A final piece missing from the vocab falls back to its single-byte display
# characters; a missing byte token is malformed vocab and fails closed.
@ publica
functio encoda(Tokenizator t, textus verbum) → lista<numerus> ⇥ TokenizerError {
    fixum lista<numerus> byte_valores ← _octeti_numeri(verbum ↦ octeti)
    varia lista<textus> symbola ← vacua
    itera ex byte_valores fixum b {
        symbola.appende(_vestigium_ex_octeto(b))
    }
    fixum lista<textus> finis ← _bpe_coagmenta(t.concursus, symbola)
    varia lista<numerus> ids ← vacua
    itera ex finis fixum piece {
        fixum numerus id ← t.vocabulum.accipe(piece) vel -1
        si id ≥ 0 {
            ids.appende(id)
        }
        secus {
            varia numerus i ← 0
            dum i < piece.longitudo() {
                fixum textus c ← piece.sectio(i, i + 1)
                fixum numerus cid ← t.vocabulum.accipe(c) vel -1
                si cid < 0 {
                    iace finge VestigiumIgnotum { causa = "byte piece missing from the vocabulary: " + c }
                }
                ids.appende(cid)
                i ↑
            }
        }
    }
    redde ids
}

# Word-level decode: ids → vocab display strings → inverse display mapping →
# bytes → UTF-8 text. Unknown ids, unmappable display characters, and byte
# sequences that are not valid UTF-8 fail with typed errors.
@ publica
functio decoda(Tokenizator t, lista<numerus> ids) → textus ⇥ TokenizerError {
    varia lista<numerus<u8>> bytes ← vacua
    itera ex ids fixum id {
        si id < 0 aut id ≥ t.multitudo {
            iace finge IdIgnotum { causa = "token id outside the vocabulary range: " + (id ↦ textus) }
        }
        fixum textus vestigium ← t.verborum.accipe(id) vel ""
        varia numerus i ← 0
        dum i < vestigium.longitudo() {
            fixum textus c ← vestigium.sectio(i, i + 1)
            fixum numerus cpt ← _codicillus_ex_vestigio(c)
            fixum numerus byte ← _octetus_ex_codicillo(cpt)
            bytes.appende(byte ∷ numerus<u8>)
            i ↑
        }
    }
    fixum octeti o ← bytes ↦ octeti
    fac {
        redde o ↦ textus
    }
    cape err {
        iace finge Utf8Mala { causa = "decoded byte sequence is not valid UTF-8" }
    }
    iace finge Utf8Mala { causa = "unreachable decode conversion" }
}

# -------------------------------------------------------------------------
# Unicode-category tables + predicates (LIB-02-U3-1, GGUF-A2).
#
# The qwen35 pre-tokenizer regex (llama-vocab.cpp LLAMA_VOCAB_PRE_TYPE_QWEN35)
# needs the character classes \p{L} (letter), \p{M} (mark), \p{N} (number),
# \s (whitespace) and the explicit CR/LF newlines. Fab has no regex engine
# and no Unicode general-category tables in the language surface, so the
# bounded-category scanner (delivery open question 1 default) expresses each
# class as a deterministic codepoint-range table covering the classes the
# two probes and the differential rows exercise. Classification runs on RAW
# input codepoints — the pre-tokenizer matches the input text before the
# byte-level BPE display mapping (a raw space is U+0020, not the display
# "Ġ" U+0120). A malformed character has no category and falls to Aliud —
# the same closed behavior as the reference regex leaving unmatched bytes
# to the [^\s\p{L}\p{M}\p{N}] alternative.
# -------------------------------------------------------------------------

# Scanner-relevant Unicode general categories. \p{L}/\p{M}/\p{N} come
# straight from the regex; \s is split into the explicit CR/LF newlines
# (the [\r\n] alternations) and the remaining ASCII whitespace, matching
# how the qwen35 pattern consumes each.
discretio CategoriaUnicode {
    Littera
    Signum
    Numerus
    Spatium
    NovumLinea
    Aliud
}

# \p{L} — the letter classes the two probes and the differential rows
# exercise: Basic Latin + Latin-1 Supplement letters, the Thai block
# letters (consonants and the sara vowels, all Lo/Lm), and the CJK
# Unified Ideographs.
fixum lista<lista<numerus>> TABULA_LITTERAE ← [
    [0x0041, 0x005A],
    [0x0061, 0x007A],
    [0x00C0, 0x00D6],
    [0x00D8, 0x00F6],
    [0x00F8, 0x00FF],
    [0x0E01, 0x0E30],
    [0x0E32, 0x0E33],
    [0x0E40, 0x0E46],
    [0x4E00, 0x9FFF]
]

# \p{M} — the marks the probes exercise: the Thai vowel/tone signs (mai
# han-akat U+0E31, the sara i..phinthu signs U+0E34..U+0E3A, lakkhangyao
# U+0E45, and the tone marks U+0E47..U+0E4E), all Mn/Me.
fixum lista<lista<numerus>> TABULA_SIGNORUM ← [
    [0x0E31, 0x0E31],
    [0x0E34, 0x0E3A],
    [0x0E45, 0x0E45],
    [0x0E47, 0x0E4E]
]

# \p{N} — the ASCII digits the differential rows exercise plus the Thai
# digits of the same block.
fixum lista<lista<numerus>> TABULA_NUMERORUM ← [
    [0x0030, 0x0039],
    [0x0E50, 0x0E59]
]

# \s minus CR/LF — the ASCII whitespace the regex's \s+ / [^\s...] and
# leading- \ ? arms consume. CR and LF are the NovumLinea class.
fixum lista<lista<numerus>> TABULA_SPATIORUM ← [
    [0x0009, 0x0009],
    [0x000B, 0x000C],
    [0x0020, 0x0020]
]

# The explicit CR/LF newlines of the [\r\n] alternations.
fixum lista<lista<numerus>> TABULA_LINEARUM ← [
    [0x000A, 0x000A],
    [0x000D, 0x000D]
]

# Inclusive-range membership over one category table.
@ privata
functio _in_tabula(numerus cpt, lista<lista<numerus>> tabula) → bivalens {
    itera ex tabula fixum par {
        si cpt ≥ (par.accipe(0) vel 0) et cpt ≤ (par.accipe(1) vel 0) ergo redde verum
    }
    redde falsum
}

# Classify one character into the scanner-relevant category.
@ publica
functio categoria(textus c) → CategoriaUnicode {
    varia numerus cpt ← -1
    fac {
        cpt ← _codicillus_ex_vestigio(c)
    }
    cape err {
        cpt ← -1
    }
    si _in_tabula(cpt, TABULA_LITTERAE) ergo redde Littera
    si _in_tabula(cpt, TABULA_SIGNORUM) ergo redde Signum
    si _in_tabula(cpt, TABULA_NUMERORUM) ergo redde Numerus
    si _in_tabula(cpt, TABULA_SPATIORUM) ergo redde Spatium
    si _in_tabula(cpt, TABULA_LINEARUM) ergo redde NovumLinea
    redde Aliud
}

# Category predicates (the \p{L}..[\r\n] classes the scanner composes).
@ publica
functio est_littera(textus c) → bivalens {
    discerne categoria(c) {
        casu Littera { redde verum }
        casu _ { redde falsum }
    }
}

@ publica
functio est_signum(textus c) → bivalens {
    discerne categoria(c) {
        casu Signum { redde verum }
        casu _ { redde falsum }
    }
}

@ publica
functio est_numerus(textus c) → bivalens {
    discerne categoria(c) {
        casu Numerus { redde verum }
        casu _ { redde falsum }
    }
}

@ publica
functio est_spatium(textus c) → bivalens {
    discerne categoria(c) {
        casu Spatium { redde verum }
        casu _ { redde falsum }
    }
}

@ publica
functio est_novum_linea(textus c) → bivalens {
    discerne categoria(c) {
        casu NovumLinea { redde verum }
        casu _ { redde falsum }
    }
}

@ publica
functio est_aliud(textus c) → bivalens {
    discerne categoria(c) {
        casu Aliud { redde verum }
        casu _ { redde falsum }
    }
}

# Canonical category name for an enum value (internal name mapping).
@ privata
functio _nomen_categoriae(CategoriaUnicode c) → textus {
    discerne c {
        casu Littera { redde "littera" }
        casu Signum { redde "signum" }
        casu Numerus { redde "numerus" }
        casu Spatium { redde "spatium" }
        casu NovumLinea { redde "novum_linea" }
        casu Aliud { redde "aliud" }
    }
}

# Canonical category name for one character (the proba/consumer textus
# seam — textus → textus, no nominal types in the signature).
@ publica
functio categoria_nomen(textus c) → textus {
    redde _nomen_categoriae(categoria(c))
}

# -------------------------------------------------------------------------
# qwen35 word-splitting scanner (LIB-02-U3-2 core families + LIB-02-U3-3
# edge families).
#
# The deterministic pre-tokenizer splits a raw prompt into words before the
# byte-level BPE core, mirroring llama.cpp's custom qwen35 scanner
# (unicode.cpp unicode_regex_split_custom_qwen35; llama-vocab.cpp
# LLAMA_VOCAB_PRE_TYPE_QWEN35; pinned oracle 10150 `dee2a846b`). The full
# qwen35 pattern is:
#   (?i:'s|'t|'re|'ve|'m|'ll|'d)
#   | [^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+
#   | \p{N}
#   | ?[^\s\p{L}\p{M}\p{N}]+[\r\n]*
#   | \s*[\r\n]+ | \s+(?!\S) | \s+
# The arms apply in that order (alternation order):
#   * the contraction family ('s/'t/'re/'ve/'m/'ll/'d, case-insensitive —
#     the reference lowercases the following letter),
#   * letter/mark runs with one optional leading non-CR/LF/number char
#     ([^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+),
#   * single numbers (\p{N}),
#   * punctuation/emoji/other runs with one optional leading literal space
#     and trailing CR/LF runs (?[^\s\p{L}\p{M}\p{N}]+[\r\n]*),
#   * whitespace runs (\s+ and the \s+(?!\S) trailing-run form) and newline
#     runs (\s*[\r\n]+).
# A character no family matches falls through to a single-character word
# (the reference's "no matches" arm).
#
# Reference semantics mirrored exactly:
#   * the contraction arm runs FIRST, so a "'t" following a word splits as
#     its own word ("don'ts" → "don" | "'t" | "s", not "don" | "'ts"),
#   * a letter/mark word absorbs ONE leading non-CR/LF/number char, so a
#     space or tab before a letter-run joins the word (" 你好" → one word,
#     "!hello" → one word),
#   * each digit is its own word,
#   * an "other" run takes one optional leading U+0020 and all trailing
#     CR/LF ("hello, world!" → "hello" | "," | " world" | "!", "a,!\n" →
#     "a" | ",!\n"), so a space-before-other joins the other-run ("x  ," →
#     "x" | " " | " ,"),
#   * a whitespace run of 2+ followed by a character emits all-but-one
#     whitespace as a word, leaving the last one for the next word,
#   * a whitespace run containing CR/LF consumes through the LAST CR/LF.
# Classification uses the U3-1 bounded codepoint tables (ASCII whitespace
# only; the full Unicode White_Space property is a documented boundary).
# -------------------------------------------------------------------------

# Raw text → codepoint list (one entry per character; textus.sectio is
# codepoint-indexed, so i advances one character per step).
@ privata
functio _codicilli_textus(textus s) → lista<numerus> ⇥ TokenizerError {
    varia lista<numerus> out ← vacua
    varia numerus i ← 0
    dum i < s.longitudo() {
        fixum textus c ← s.sectio(i, i + 1)
        out.appende(_codicillus_ex_vestigio(c))
        i ← i + 1
    }
    redde out
}

# Codepoint-level predicates over the U3-1 category tables.
@ privata
functio _codicillus_littera(numerus cpt) → bivalens {
    redde _in_tabula(cpt, TABULA_LITTERAE)
}

@ privata
functio _codicillus_signum(numerus cpt) → bivalens {
    redde _in_tabula(cpt, TABULA_SIGNORUM)
}

@ privata
functio _codicillus_numerus(numerus cpt) → bivalens {
    redde _in_tabula(cpt, TABULA_NUMERORUM)
}

@ privata
functio _codicillus_spatium(numerus cpt) → bivalens {
    redde _in_tabula(cpt, TABULA_SPATIORUM)
}

@ privata
functio _codicillus_linea(numerus cpt) → bivalens {
    redde _in_tabula(cpt, TABULA_LINEARUM)
}

# The reference's \s carries both ordinary whitespace and CR/LF.
@ privata
functio _codicillus_album(numerus cpt) → bivalens {
    redde _codicillus_spatium(cpt) aut _codicillus_linea(cpt)
}

# The reference's [^\s\p{L}\p{M}\p{N}] — a character no family class
# matches (the punct/emoji/other run class, bounded tables).
@ privata
functio _codicillus_aliud(numerus cpt) → bivalens {
    redde non (_codicillus_littera(cpt) aut _codicillus_signum(cpt) aut _codicillus_numerus(cpt) aut _codicillus_spatium(cpt) aut _codicillus_linea(cpt))
}

# ASCII lowercasing for the contraction arm — the reference matches the
# qwen35 contraction letters case-insensitively via unicode_tolower; only
# the ASCII letters s/t/r/v/m/l/d/e are in the pattern's sets.
@ privata
functio _codicillus_parvus(numerus cpt) → numerus {
    si cpt ≥ 0x41 et cpt ≤ 0x5A ergo redde cpt + 0x20
    redde cpt
}

# Codepoint range → the exact source slice (rebuilds the UTF-8 bytes).
@ privata
functio _verba_ex_codicillis(lista<numerus> cpts, numerus ini, numerus fin) → textus ⇥ TokenizerError {
    varia textus out ← ""
    varia numerus i ← ini
    dum i < fin {
        out ← out + _textus_ex_codicillo(cpts.accipe(i) vel 0)
        i ← i + 1
    }
    redde out
}

# Split a raw prompt into words exactly like the pinned qwen35 scanner's
# core families. Each returned word is a slice of the input text; the U2
# word-level BPE core consumes one word at a time.
@ publica
functio scanna_verba(textus textum) → lista<textus> ⇥ TokenizerError {
    fixum lista<numerus> cpts ← _codicilli_textus(textum)
    fixum numerus n ← cpts.longitudo()
    varia lista<textus> verba ← vacua
    varia numerus pos ← 0
    dum pos < n {
        fixum numerus cpt ← cpts.accipe(pos) vel 0
        fixum numerus initium ← pos
        # (?i:'s|'t|'re|'ve|'m|'ll|'d) — the contraction family. The
        # reference matches FIRST, lowercasing the following letter(s):
        # a 2-character word "'x" for s/t/m/d, a 3-character word "'xy"
        # for re/ve/ll.
        si cpt ≡ 0x27 et pos + 1 < n {
            fixum numerus prox ← _codicillus_parvus(cpts.accipe(pos + 1) vel 0)
            si prox ≡ 0x73 aut prox ≡ 0x74 aut prox ≡ 0x6D aut prox ≡ 0x64 {
                pos ← pos + 2
                verba.appende(_verba_ex_codicillis(cpts, initium, pos))
                perge
            }
            si pos + 2 < n {
                fixum numerus prox2 ← _codicillus_parvus(cpts.accipe(pos + 2) vel 0)
                si (prox ≡ 0x72 et prox2 ≡ 0x65) aut (prox ≡ 0x76 et prox2 ≡ 0x65) aut (prox ≡ 0x6C et prox2 ≡ 0x6C) {
                    pos ← pos + 3
                    verba.appende(_verba_ex_codicillis(cpts, initium, pos))
                    perge
                }
            }
        }
        # [^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+ — letter/mark run with one
        # optional leading non-CR/LF/number char.
        si cpt ≠ 0x0A et cpt ≠ 0x0D et non (_codicillus_numerus(cpt)) {
            varia bivalens sequens ← falsum
            si pos + 1 < n {
                fixum numerus prox ← cpts.accipe(pos + 1) vel 0
                sequens ← _codicillus_littera(prox) aut _codicillus_signum(prox)
            }
            si _codicillus_littera(cpt) aut _codicillus_signum(cpt) aut sequens {
                pos ← pos + 1
                dum pos < n {
                    fixum numerus w ← cpts.accipe(pos) vel 0
                    si non (_codicillus_littera(w) aut _codicillus_signum(w)) {
                        rumpe
                    }
                    pos ← pos + 1
                }
                verba.appende(_verba_ex_codicillis(cpts, initium, pos))
                perge
            }
        }
        # \p{N} — one digit per word.
        si _codicillus_numerus(cpt) {
            pos ← pos + 1
            verba.appende(_verba_ex_codicillis(cpts, initium, pos))
            perge
        }
        # ?[^\s\p{L}\p{M}\p{N}]+[\r\n]* — punctuation/emoji/other run. An
        # optional leading literal space (U+0020) joins the run when the
        # following character is "other" (or the space is trailing at the
        # segment end — the reference's out-of-range next flags are "not
        # whitespace/letter/mark/number"), then the other-run, then all
        # trailing CR/LF ("x  ," → "x" | " " | " ,"; "a,!\n" → "a" |
        # ",!\n").
        varia bivalens init_aliud ← falsum
        si cpt ≡ 0x20 {
            init_aliud ← pos + 1 ≥ n aut _codicillus_aliud(cpts.accipe(pos + 1) vel 0)
        }
        secus {
            init_aliud ← _codicillus_aliud(cpt)
        }
        si init_aliud {
            si cpt ≡ 0x20 {
                pos ← pos + 1
            }
            dum pos < n et _codicillus_aliud(cpts.accipe(pos) vel 0) {
                pos ← pos + 1
            }
            dum pos < n {
                fixum numerus w ← cpts.accipe(pos) vel 0
                si w ≠ 0x0A et w ≠ 0x0D {
                    rumpe
                }
                pos ← pos + 1
            }
            verba.appende(_verba_ex_codicillis(cpts, initium, pos))
            perge
        }
        # \s family — scan the whitespace run.
        varia numerus multi ← 0
        varia numerus finis_linea ← 0
        dum pos + multi < n {
            fixum numerus w ← cpts.accipe(pos + multi) vel 0
            si non (_codicillus_album(w)) {
                rumpe
            }
            si _codicillus_linea(w) {
                finis_linea ← pos + multi + 1
            }
            multi ← multi + 1
        }
        # \s*[\r\n]+ — consume through the last CR/LF of the run.
        si finis_linea > 0 {
            pos ← finis_linea
            verba.appende(_verba_ex_codicillis(cpts, initium, pos))
            perge
        }
        # \s+(?!\S) — a run of 2+ followed by a character keeps the last
        # whitespace for the next word.
        si multi > 1 et pos + multi < n {
            pos ← pos + multi - 1
            verba.appende(_verba_ex_codicillis(cpts, initium, pos))
            perge
        }
        # \s+ — plain whitespace run.
        si multi > 0 {
            pos ← pos + multi
            verba.appende(_verba_ex_codicillis(cpts, initium, pos))
            perge
        }
        # No family matched — single-character word (the reference's
        # "no matches" arm; every bounded-table class matches a family,
        # so this is the safety net).
        pos ← pos + 1
        verba.appende(_verba_ex_codicillis(cpts, initium, pos))
    }
    redde verba
}

# First occurrence of `quid` in `ubi` at or after `ab` (character
# indices), or -1 when absent — the reference's std::string::find.
@ privata
functio _inveni(textus ubi, textus quid, numerus ab) → numerus {
    fixum numerus n ← ubi.longitudo()
    fixum numerus m ← quid.longitudo()
    si m ≡ 0 aut m > n ergo redde -1
    varia numerus i ← ab
    dum i + m ≤ n {
        si ubi.sectio(i, i + m) ≡ quid ergo redde i
        i ← i + 1
    }
    redde -1
}

# Scanner-split + word-level BPE encode of one plain-text slice (the
# shared literal path of both parse policies).
@ privata
functio _encoda_verborum(Tokenizator t, textus textum) → lista<numerus> ⇥ TokenizerError {
    fixum lista<textus> verba ← scanna_verba(textum)
    varia lista<numerus> ids ← vacua
    itera ex verba fixum verbum {
        fixum lista<numerus> partes ← encoda(t, verbum)
        itera ex partes fixum id {
            ids.appende(id)
        }
    }
    redde ids
}

# Full-prompt encode, parse_special = falsum: the whole prompt goes
# through scanner + BPE (specials read as their literal bytes).
@ publica
functio encoda_promptum(Tokenizator t, textus textum) → lista<numerus> ⇥ TokenizerError {
    redde _encoda_verborum(t, textum)
}

# Full-prompt encode, parse_special = verum: split the prompt on the
# artifact special cache BEFORE the scanner (llama.cpp
# split_special_tokens/find_special_token — earliest match, longest text
# on ties), emitting each special's single id and scanning each plain
# slice independently. A prompt with no specials encodes identically to
# encoda_promptum.
@ publica
functio encoda_promptum_specialia(Tokenizator t, textus textum) → lista<numerus> ⇥ TokenizerError {
    varia lista<numerus> ids ← vacua
    varia numerus pos ← 0
    dum pos < textum.longitudo() {
        varia numerus melior_pos ← -1
        varia numerus melior_id ← -1
        varia numerus melior_longitudo ← -1
        varia numerus i ← 0
        dum i < t.specialia_textus.longitudo() {
            fixum textus specialis ← t.specialia_textus.accipe(i) vel ""
            si specialis.longitudo() > 0 {
                fixum numerus p ← _inveni(textum, specialis, pos)
                si p ≥ 0 et (melior_pos < 0 aut p < melior_pos aut (p ≡ melior_pos et specialis.longitudo() > melior_longitudo)) {
                    melior_pos ← p
                    melior_id ← t.specialia_ids.accipe(i) vel -1
                    melior_longitudo ← specialis.longitudo()
                }
            }
            i ← i + 1
        }
        si melior_pos < 0 {
            fixum lista<numerus> partes ← _encoda_verborum(t, textum.sectio(pos, textum.longitudo()))
            itera ex partes fixum id {
                ids.appende(id)
            }
            rumpe
        }
        si melior_pos > pos {
            fixum lista<numerus> partes ← _encoda_verborum(t, textum.sectio(pos, melior_pos))
            itera ex partes fixum id {
                ids.appende(id)
            }
        }
        ids.appende(melior_id)
        pos ← melior_pos + melior_longitudo
    }
    redde ids
}

# -------------------------------------------------------------------------
# EOG + BOS-free policy (LIB-02-U3-5, GGUF-A2).
#
# The runtime EOG stop set mirrors llama-vocab.cpp llm_load_vocab (pinned
# oracle 10150 `dee2a846b`): the declared tokenizer.ggml.eos_token_id is
# always a member, every vocab token whose text is in the reference EOG
# name list is a member, and the FIM pad/rep/sep ids join when the metadata
# key or a reference text-name match resolves them. For the pinned artifact
# this is exactly {248044, 248046, 248063, 248064, 248065}. The BOS policy
# reads tokenizer.ggml.add_bos_token (absent → falsum, the llama.cpp bool
# default): encode never prepends a BOS, so the falsum artifact is BOS-free
# (empty prompt → empty sequence). An artifact without EOG metadata yields
# an empty EOG set — no hard-coded SmolLM2 fallback (the stop-condition
# invariant).
# -------------------------------------------------------------------------

# Contains-check over a name list (the EOG/FIM text-name scans).
@ privata
functio _in_nomine(textus v, lista<textus> nomina) → bivalens {
    itera ex nomina fixum n {
        si v ≡ n ergo redde verum
    }
    redde falsum
}

# Dedupe + ascending sort (the reference's EOG set order; -1 slots from the
# FIM fallback are dropped).
@ privata
functio _ordo_surgens(lista<numerus> a) → lista<numerus> {
    varia lista<numerus> out ← vacua
    itera ex a fixum v {
        si v < 0 { perge }
        varia bivalens visus ← falsum
        varia numerus i ← 0
        dum i < out.longitudo() {
            si (out.accipe(i) vel 0) ≡ v {
                visus ← verum
                rumpe
            }
            i ← i + 1
        }
        si visus { perge }
        varia numerus pos ← 0
        dum pos < out.longitudo() {
            si (out.accipe(pos) vel 0) > v { rumpe }
            pos ← pos + 1
        }
        varia lista<numerus> novum ← vacua
        varia numerus j ← 0
        dum j < out.longitudo() {
            si j ≡ pos { novum.appende(v) }
            novum.appende(out.accipe(j) vel 0)
            j ← j + 1
        }
        si pos ≥ out.longitudo() { novum.appende(v) }
        out ← novum
    }
    redde out
}

# One FIM slot: the metadata key first, else the reference text-name
# fallback (first matching vocab entry in id order). -1 when nothing
# resolves; a present-but-malformed key fails closed.
@ privata
functio _fim_artificii(manifestum.ManifestumGguf m, lista<textus> verborum, textus clavis, lista<textus> nomina) → numerus ⇥ TokenizerError {
    varia numerus id ← -1
    varia bivalens adest ← falsum
    fac {
        id ← manifestum.numerum(m, clavis)
        adest ← verum
    }
    cape err {
        fixum textus causa ← manifestum.causa(err)
        si causa.longitudo() < 24 aut causa.sectio(0, 24) ≠ "metadata key not found: " {
            iace finge ArtificiumMala { causa = "tokenizer FIM metadata is malformed: " + causa }
        }
    }
    si adest {
        si id < 0 aut id ≥ verborum.longitudo() {
            iace finge ArtificiumMala { causa = "tokenizer FIM id is outside the vocabulary" }
        }
        redde id
    }
    varia numerus i ← 0
    dum i < verborum.longitudo() {
        si _in_nomine(verborum.accipe(i) vel "", nomina) {
            redde i
        }
        i ← i + 1
    }
    redde -1
}

# The artifact EOG set: declared eos id + the EOG-name scan + the FIM
# pad/rep/sep slots, deduped and ascending.
@ privata
functio _eog_artificii(manifestum.ManifestumGguf m, lista<textus> verborum) → lista<numerus> ⇥ TokenizerError {
    varia lista<numerus> candidati ← vacua
    varia numerus eos ← -1
    varia bivalens eos_adest ← falsum
    fac {
        eos ← manifestum.numerum(m, "tokenizer.ggml.eos_token_id")
        eos_adest ← verum
    }
    cape err {
        fixum textus causa ← manifestum.causa(err)
        si causa.longitudo() < 24 aut causa.sectio(0, 24) ≠ "metadata key not found: " {
            iace finge ArtificiumMala { causa = "tokenizer EOG metadata is malformed: " + causa }
        }
    }
    si eos_adest {
        si eos < 0 aut eos ≥ verborum.longitudo() {
            iace finge ArtificiumMala { causa = "tokenizer eos_token_id is outside the vocabulary" }
        }
        candidati.appende(eos)
    }
    varia numerus i ← 0
    dum i < verborum.longitudo() {
        si _in_nomine(verborum.accipe(i) vel "", EOG_NOMINA) {
            candidati.appende(i)
        }
        i ← i + 1
    }
    candidati.appende(_fim_artificii(m, verborum, "tokenizer.ggml.fim_pad_token_id", FIM_PAD_NOMINA))
    candidati.appende(_fim_artificii(m, verborum, "tokenizer.ggml.fim_rep_token_id", FIM_REP_NOMINA))
    candidati.appende(_fim_artificii(m, verborum, "tokenizer.ggml.fim_sep_token_id", FIM_SEP_NOMINA))
    redde _ordo_surgens(candidati)
}

# The artifact's add_bos_token (GGUF bool; absent → falsum, the llama.cpp
# kv_bool default). A present non-bool value fails closed.
@ privata
functio _add_bos_artificii(manifestum.ManifestumGguf m) → bivalens ⇥ TokenizerError {
    varia manifestum.MetadatumGguf x ← manifestum.MetadatumGguf { clavis = "", typo = -1, valor_wire = || }
    varia bivalens adest ← falsum
    fac {
        x ← manifestum.metadatum(m, "tokenizer.ggml.add_bos_token")
        adest ← verum
    }
    cape err {
        fixum textus causa ← manifestum.causa(err)
        si causa.longitudo() < 24 aut causa.sectio(0, 24) ≠ "metadata key not found: " {
            iace finge ArtificiumMala { causa = "tokenizer.add_bos_token is malformed: " + causa }
        }
    }
    si non adest { redde falsum }
    si x.typo ≠ TYPI_BOOL {
        iace finge ArtificiumMala { causa = "tokenizer.add_bos_token is not a GGUF bool" }
    }
    fixum lista<numerus> bs ← _octeti_numeri(x.valor_wire)
    redde (bs.accipe(0) vel 0) ≡ 1
}

# The runtime EOG stop set (ascending; mirrors the reference's set order).
@ publica
functio eog_artificii(Tokenizator t) → lista<numerus> {
    redde t.eog
}

# EOG-membership predicate — the runtime generation stop-policy binding
# (the artifact-set equivalent of the identity contract's est_eog).
@ publica
functio est_eog_artificii(Tokenizator t, numerus id) → bivalens {
    itera ex t.eog fixum e {
        si id ≡ e ergo redde verum
    }
    redde falsum
}

# The artifact's add_bos_token flag (falsum for the pinned artifact — the
# BOS-free policy: encode never prepends a BOS).
@ publica
functio add_bos(Tokenizator t) → bivalens {
    redde t.add_bos
}
