# Tensor-aware math foundation.
#
# Own copy — independent of Norma. Gradus is self-contained; a user of Gradus
# never imports from Norma, and vice versa.
#
# Public import: importa ex "gradus:math" privata math
# Depends on: nothing (foundation layer)
#
# Will own: scalar math helpers, shape utilities, and numeric constants needed
# across Gradus modules. Tensor-typed operations live in gradus:tensor; this
# module holds the scalar foundation those operations build on.

# Finite-difference epsilon for gradient validation.
# Default 1e-5 — small enough for local linearity, large enough to avoid
# float32 rounding error dominating the central-difference quotient.
fixum f32 epsilon ← (0.00001 ∷ f32)
