# -- elementwise -----------------------------------------------------------

test "add sums elementwise over equal shapes" {
    let _ a ← [[1.0, 2.0], [3.0, 4.0]] ↦ tf32[2, 2]
    let _ b ← [[10.0, 20.0], [30.0, 40.0]] ↦ tf32[2, 2]
    let _ r ← math.add(a, b)
    assert ((r.get([0, 0]) ⊥ 0.0) ↦ string) ≡ "11.0"
    assert ((r.get([1, 1]) ⊥ 0.0) ↦ string) ≡ "44.0"
}

test "add broadcasts a vector over a matrix" {
    let _ trap_result_41 ← trap {
        let tensor.NumericBlock r ← math.add_carrier(math.construct([1.0, 2.0, 3.0, 4.0], [2, 2]), math.construct([10.0, 20.0], [2]))
        assert r.shape ≡ ([2, 2] ↦ list<int>)
        assert elem2(r, 0, 0) ≡ "11.0"
        assert elem2(r, 0, 1) ≡ "22.0"
        assert elem2(r, 1, 0) ≡ "13.0"
        assert elem2(r, 1, 1) ≡ "24.0"
    }
    match trap_result_41 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "add broadcasts a scalar over a vector" {
    let _ trap_result_40 ← trap {
        let tensor.NumericBlock r ← math.add_carrier(math.construct([1.0, 2.0], [2]), math.construct([5.0], []))
        assert r.shape ≡ ([2] ↦ list<int>)
        assert elem1(r, 0) ≡ "6.0"
        assert elem1(r, 1) ≡ "7.0"
    }
    match trap_result_40 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "add rejects non-broadcastable shapes" {
    let _ trap_result_39 ← trap {
        let tensor.NumericBlock a ← math.construct([1.0, 2.0, 3.0, 4.0], [2, 2])
        let tensor.NumericBlock b ← math.construct([1.0, 2.0, 3.0], [3])
        assert add_detail(a, b) ≡ "shapes not broadcastable"
    }
    match trap_result_39 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

