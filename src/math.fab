+++
locale = "en"
+++
# Pure operation families — PML1-U4 (elementwise, reduce, matmul, cast,
# concat/slice) over the production tensor surface (gradus:tensor U1),
# dtype contract (gradus:dtype U2), and shape rules (gradus:shape U3).
#
# Public import: import from "gradus:math" math
# Depends on: gradus:tensor (NumericBlock), gradus:dtype (DType + cast), gradus:shape
# (broadcast / numel). DAG: math → tensor → dtype; math → shape.
#
# --- Families -------------------------------------------------------------
#
#   * construction — construct(data, shape): validated tensor construction
#     mapped onto MathError (tensor.construct remains the raw constructor),
#     so op pipelines carry one error vocabulary end to end.
#   * elementwise — typed same-shape kernel twins (add/sub/mul/div binary,
#     neg unary) plus explicit *_carrier broadcast residuals (add/sub/mul/div
#     binary, neg/abs/signum unary; the abs/signum typed twins wait on the
#     lane-abs / lane-sign method-twin admissions). Result dtype equals the
#     operand dtype; a dtype mismatch fails closed (DtypeMismatch) —
#     promotion is an explicit cast step, never implicit (capsule rule).
#     Division follows f32 semantics:
#     division by zero yields ±Inf/NaN (representable in F32), it does not
#     throw — non-finite handling is the dtype cast contract's concern.
#   * reduce — sum / mean over one axis. Axis must be in [0, rank); a
#     zero-length reduction axis fails closed (no degenerate empty sums).
#   * matmul — rank-2 x rank-2 matrix multiply ([M,K] x [K,N] → [M,N]).
#     Higher-rank batched matmul is a later admission row (R3: support rows,
#     not hard-coded generics); this row is documented here.
#   * cast — cast(t, name): elementwise value cast via the dtype contract,
#     entered by dtype NAME ("f32"/"f16"/"i32"/"u8", the serialized tag form
#     of dtype-schema-1.0.0). Result keeps the shape and takes the target
#     tag; failures are MathError.NonFinite (float→int of NaN/±Inf),
#     MathError.Overflow (overflow / above F16 max), and
#     MathError.UnknownName (unknown name) — the dtype cast rules, mapped
#     into the uniform family vocabulary.
#   * concat/slice — concatenate(parts, axis) joins tensors along one axis
#     (equal rank/dtype/shape except the axis); slice(t, axis, start,
#     end) slices along one axis with closed-open bounds [start, end).
#
# --- Contracts ------------------------------------------------------------
#
# Construction: every op returns a validated, consistent NumericBlock (valid holds,
# result shape ceiling-checked via shape.numel before allocation).
# Validation: inputs are validated fail-closed before any result is built
# (shape broadcastability, axis ranges, inner dims, dtype parity, slice
# bounds, ceilings). Error: one typed MathError vocabulary with distinct
# variants per failure class and a text message (render via math.message);
# shape-rule failures (dims/ceilings) keep their ShapeError identity mapped
# into MathError. Serialization: the op surface is the tensor construction
# contract — a result is a NumericBlock that round-trips through
# tensor.shape/dtype/valid/numel; value bytes are PML1-U7.
#
# --- Compiler-lane notes (probed 2026-08-08, faber 1.6.0-rc.1) ------------
#
#   * Cross-module enum variants cannot be referenced in library context
#     (SEM001 unknown_variant, qualified or not) — so a shape.ShapeError
#     cannot be matched here. Shape-rule failures are therefore mapped onto
#     MathError by their documented message text (shape.proba asserts those
#     strings), keeping variant identity. Residual for the compiler lane.
#   * Proba-importability: file-interface snapshots skip exports whose
#     signatures carry cross-module nominal enum types (WARN014
#     file_interface_export_skipped; e.g. tensor.construct_dtype takes
#     dtype.DType). The cast entry is therefore name-based (text), and the
#     dtype tag stays internal. Same finding already recorded for
#     construct_dtype in PML1-U2.
#   * The tensor → math import edge (U1, unused) is dropped: this module
#     now owns tensor-typed ops, so math → tensor is the live edge.
#   * Receiver-method rule (gradus AGENTS.md) yields to the delivery-assigned
#     home for this surface: the families are free functions on the staged
#     NumericBlock carrier, not class methods (the NumericBlock class lives in tensor.fab,
#     outside U4's write scope). Residual for the Mind.

import from "gradus:dtype" dtype

import from "gradus:shape" shape

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# MathError — typed error vocabulary of the pure operation families. Every
# variant carries a text message (mirror of tensor/dtype/shape).
# -------------------------------------------------------------------------


@ public
union MathError {
    @ shared
    string message

    NegativeDimension,
    DimensionAboveLimit,
    ProductAboveLimit,
    ShapeMismatch,
    GradusMismatch,
    Incompatible,
    DtypeMismatch,
    ElementMismatch,
    NonFinite,
    Overflow,
    UnknownName
}

@ conversion
fn from_shape_error(shape.ShapeError err) → MathError {
    match err {
        case shape.ShapeError.NegativeDimension const message { return variant NegativeDimension {message = message} }
        case shape.ShapeError.DimensionAboveLimit const message { return variant DimensionAboveLimit {message = message} }
        case shape.ShapeError.ProductAboveLimit const message { return variant ProductAboveLimit {message = message} }
        case shape.ShapeError.Incompatible const message { return variant Incompatible {message = message} }
        case shape.ShapeError.ElementMismatch const message { return variant ElementMismatch {message = message} }
        case _ { return variant ShapeMismatch {message = err.message} }
    }
}

@ conversion
fn from_tensor_error(tensor.TensorError err) → MathError {
    match err {
        case tensor.TensorError.ElementMismatch const message { return variant ElementMismatch {message = message} }
        case _ { return variant ShapeMismatch {message = err.message} }
    }
}

@ conversion
fn from_dtype_error(dtype.DTypeError err) → MathError {
    match err {
        case dtype.DTypeError.UnknownName const message { return variant UnknownName {message = message} }
        case dtype.DTypeError.NonFinite const message { return variant NonFinite {message = message} }
        case dtype.DTypeError.Overflow const message { return variant Overflow {message = message} }
        case _ { return variant ShapeMismatch {message = err.message} }
    }
}


# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# Broadcast two operand shapes with a typed error mapping (ShapeError →
# MathError, variant identity preserved via the documented message text).
fn _shape_broadcast(list<int> a, list<int> b) → list<int> ⇥ MathError {
    return shape.broadcast(a, b)
}

# Bounded element count of a shape, ceiling-validated (gate before any
# allocation; same fail-closed mapping as shape_broadcast).
fn _numel_valid(list<int> f) → int ⇥ MathError {
    return shape.numel(f)
}

# Operand flat index for a result flat index under right-aligned broadcast.
# result coords are decomposed right-to-left; the operand reads dims of 1 as
# coordinate 0 and missing leading dims as 0 (scalar/singleton broadcast).
fn _index_broadcast(int flat, list<int> result, list<int> shape) → int {
    const int lr ← result.length()
    const int lf ← shape.length()
    var int res ← flat
    var int out ← 0
    var int stride ← 1
    for range 0‥lr const k {
        const int dr ← result.get((lr - 1) - k) coalesce 1
        const int c ← res % dr
        var int ci ← 0
        var int df ← 1
        if k ≺ lf {
            df ← shape.get((lf - 1) - k) coalesce 1
            if df ≡ 1 {
                ci ← 0
            }
            else {
                ci ← c
            }
        }
        out ← out + ci * stride
        stride ← stride * df
        res ← res / dr
    }
    return out
}

# Source flat index for a reduce result: output flat index o (over the
# reduced shape) with reduction coordinate j along axis.
fn _index_axis(int flat, int j, list<int> f, int axis) → int {
    const int r ← f.length()
    var int p ← flat
    var int out ← 0
    var int stride ← 1
    for range 0‥r const k {
        const int idx ← (r - 1) - k
        const int dim ← f.get(idx) coalesce 1
        var int c ← 0
        if idx ≡ axis {
            c ← j
        }
        else {
            c ← p % dim
            p ← p / dim
        }
        out ← out + c * stride
        stride ← stride * dim
    }
    return out
}

# Row-major coordinate vector for a flat index (left-to-right order).
fn _coordinate(int flat, list<int> shape) → list<int> {
    const int r ← shape.length()
    var list<int> coords ← empty
    var int p ← flat
    var int total ← shape.reduce((int acc, int dim) ∴ acc * dim, 1)
    for range 0‥r const i {
        const int dim ← shape.get(i) coalesce 1
        const int stride ← total / dim
        const int c ← p / stride
        coords.append(c)
        p ← p - c * stride
        total ← stride
    }
    return coords
}

# Row-major flat index of a coordinate vector within shape, with the axis
# coordinate replaced by axis_local (concat/slice mapping).
fn _flat_axis(list<int> coords, int axis, int axis_local, list<int> shape) → int {
    const int r ← shape.length()
    var int flat ← 0
    var int stride ← 1
    for range 0‥r const k {
        const int idx ← (r - 1) - k
        const int dim ← shape.get(idx) coalesce 1
        var int c ← coords.get(idx) coalesce 0
        if idx ≡ axis {
            c ← axis_local
        }
        flat ← flat + c * stride
        stride ← stride * dim
    }
    return flat
}

# Dtype parity check — ops are fail-closed on mismatched tags; promotion is
# an explicit cast step.
fn _dtype_pair(tensor.NumericBlock a, tensor.NumericBlock b) → bool ⇥ MathError {
    require dtype.eq(a.dtype, b.dtype) throw variant DtypeMismatch {message = "dtype mismatch"}
    return true
}

# -------------------------------------------------------------------------
# Family: construction — validated tensor construction through the family
# error vocabulary. tensor.construct remains the raw validated constructor;
# this entry maps its TensorError failures onto MathError so op pipelines
# (and the family tests) carry one error type end to end. Part of the U4
# "construction/validation/error" contract for the families.
# -------------------------------------------------------------------------

@ public
fn construct(list<f32> data, list<int> shape) → tensor.NumericBlock ⇥ MathError {
    return tensor.construct(data, shape)
}

# -------------------------------------------------------------------------
# Family: elementwise.
# -------------------------------------------------------------------------

@ kernel
@ public
fn add<size M, size N>(tensor<f32, [M, N]> a, tensor<f32, [M, N]> b) → tensor<f32, [M, N]> {
    return a + b
}

# add_carrier — load-edge staged residual. Same loop as the former
# production add; not the elementwise production name (SEM005).
# Keep: broadcast reads need per-element flat-index mapping into both
# operands (_index_broadcast); no zip/map construct covers index-space
# broadcast gathers. sub/mul/div_carrier share this shape.
@ public
fn add_carrier(tensor.NumericBlock a, tensor.NumericBlock b) → tensor.NumericBlock ⇥ MathError {
    const list<int> fa ← a.shape
    const list<int> fb ← b.shape
    const list<int> fr ← _shape_broadcast(fa, fb)
    const int total ← _numel_valid(fr)
    _dtype_pair(a, b)
    var list<f32> out ← empty
    for range 0‥total const i {
        const int ia ← _index_broadcast(i, fr, fa)
        const int ib ← _index_broadcast(i, fr, fb)
        const f32 va ← a.data.get(ia) coalesce 0.0 ∷ f32
        const f32 vb ← b.data.get(ib) coalesce 0.0 ∷ f32
        out.append(va + vb)
    }
    return tensor.stage(a.dtype, fr, out)
}

@ kernel
@ public
fn sub<size M, size N>(tensor<f32, [M, N]> a, tensor<f32, [M, N]> b) → tensor<f32, [M, N]> {
    return a - b
}

# sub_carrier — load-edge staged residual (broadcast per shape.broadcast).
# Same loop as the former production sub; not the elementwise production
# name (SEM005).
@ public
fn sub_carrier(tensor.NumericBlock a, tensor.NumericBlock b) → tensor.NumericBlock ⇥ MathError {
    const list<int> fa ← a.shape
    const list<int> fb ← b.shape
    const list<int> fr ← _shape_broadcast(fa, fb)
    const int total ← _numel_valid(fr)
    _dtype_pair(a, b)
    var list<f32> out ← empty
    for range 0‥total const i {
        const int ia ← _index_broadcast(i, fr, fa)
        const int ib ← _index_broadcast(i, fr, fb)
        const f32 va ← a.data.get(ia) coalesce 0.0 ∷ f32
        const f32 vb ← b.data.get(ib) coalesce 0.0 ∷ f32
        out.append(va - vb)
    }
    return tensor.stage(a.dtype, fr, out)
}

@ kernel
@ public
fn mul<size M, size N>(tensor<f32, [M, N]> a, tensor<f32, [M, N]> b) → tensor<f32, [M, N]> {
    return a ⊙ b
}

# mul_carrier — load-edge staged residual (broadcast per shape.broadcast).
# Same loop as the former production mul; not the elementwise production
# name (SEM005).
@ public
fn mul_carrier(tensor.NumericBlock a, tensor.NumericBlock b) → tensor.NumericBlock ⇥ MathError {
    const list<int> fa ← a.shape
    const list<int> fb ← b.shape
    const list<int> fr ← _shape_broadcast(fa, fb)
    const int total ← _numel_valid(fr)
    _dtype_pair(a, b)
    var list<f32> out ← empty
    for range 0‥total const i {
        const int ia ← _index_broadcast(i, fr, fa)
        const int ib ← _index_broadcast(i, fr, fb)
        const f32 va ← a.data.get(ia) coalesce 0.0 ∷ f32
        const f32 vb ← b.data.get(ib) coalesce 0.0 ∷ f32
        out.append(va * vb)
    }
    return tensor.stage(a.dtype, fr, out)
}

@ kernel
@ public
fn div<size M, size N>(tensor<f32, [M, N]> a, tensor<f32, [M, N]> b) → tensor<f32, [M, N]> {
    # Explicit divide receiver: the same intrinsic the ⊘ glyph lowers to on
    # every other lane (mir/lower/runtime.rs HadamardDiv→divisio); the Rust
    # target admits the receiver but not the raw glyph (CODEGEN001).
    return a.divide(b)
}

# div_carrier — load-edge staged residual (broadcast per shape.broadcast).
# Same loop as the former production div; not the elementwise production
# name (SEM005).
@ public
fn div_carrier(tensor.NumericBlock a, tensor.NumericBlock b) → tensor.NumericBlock ⇥ MathError {
    const list<int> fa ← a.shape
    const list<int> fb ← b.shape
    const list<int> fr ← _shape_broadcast(fa, fb)
    const int total ← _numel_valid(fr)
    _dtype_pair(a, b)
    var list<f32> out ← empty
    for range 0‥total const i {
        const int ia ← _index_broadcast(i, fr, fa)
        const int ib ← _index_broadcast(i, fr, fb)
        const f32 va ← a.data.get(ia) coalesce 0.0 ∷ f32
        const f32 vb ← b.data.get(ib) coalesce 0.0 ∷ f32
        out.append(va / vb)
    }
    return tensor.stage(a.dtype, fr, out)
}

@ kernel
@ public
fn neg<size M, size N>(tensor<f32, [M, N]> t) → tensor<f32, [M, N]> {
    return t.negate()
}

# neg_carrier — load-edge staged residual. Same loop as the former
# production neg; not the elementwise production name (SEM005).
# data length is construct-locked to numel, so the elementwise map is exact.
@ public
fn neg_carrier(tensor.NumericBlock t) → tensor.NumericBlock ⇥ MathError {
    const list<int> f ← t.shape
    const int total ← _numel_valid(f)
    const list<f32> out ← t.data.map(f32 v ∴ 0.0 ∷ f32 - v)
    return tensor.stage(t.dtype, f, out)
}

# abs_carrier — load-edge staged residual. The typed twin is blocked at the
# lane-abs admission: tensor receivers have no abs method twin at this radix
# (SEM004 unknown_method on `.abs()`; numerus `absolutum` is scalar-only), so
# the staged walk remains the only form — reported red, not
# fallback-composed.
# elementwise map is exact (data length is construct-locked to numel).
@ public
fn abs_carrier(tensor.NumericBlock t) → tensor.NumericBlock ⇥ MathError {
    const list<int> f ← t.shape
    const int total ← _numel_valid(f)
    const list<f32> out ← t.data.map(f32 v ∴ v.abs())
    return tensor.stage(t.dtype, f, out)
}

# signum_carrier — load-edge staged residual. The typed twin is blocked at
# the lane-sign admission: tensor receivers have no sign method twin at this
# radix (SEM004 unknown_method on `.sign()`; numerus `signum` is
# scalar-only) — reported red, not fallback-composed.
#
# Elementwise sign semantics (the Absolute/Signum arm of the PML4 executed
# lane; the f32 receiver was masked on the FMIR lane by the MIR validator
# arms until radix 2df1af436, the same fix family as the rounding arm
# d0c9708fa). Semantics: the sign-bit result of the numeric intrinsic —
# +1.0 for every positive value (including +0.0), -1.0 for every negative
# value (including -0.0). Mirrors abs one-to-one.
@ public
fn signum_carrier(tensor.NumericBlock t) → tensor.NumericBlock ⇥ MathError {
    const list<int> f ← t.shape
    const int total ← _numel_valid(f)
    const list<f32> out ← t.data.map(f32 v ∴ v.sign())
    return tensor.stage(t.dtype, f, out)
}

# -------------------------------------------------------------------------
# Family: reduce (sum / mean over one axis).
# -------------------------------------------------------------------------

@ public
fn sum(tensor.NumericBlock t, int axis) → tensor.NumericBlock ⇥ MathError {
    const list<int> f ← t.shape
    const int r ← f.length()
    require r ≠ 0 throw variant GradusMismatch {message = "reduce requires rank >= 1"}
    reject (axis ≺ 0 or axis ≥ r) throw variant GradusMismatch {message = "axis out of range"}
    const int dim ← f.get(axis) coalesce 1
    require dim ≠ 0 throw variant ElementMismatch {message = "empty reduction axis"}
    # Keep: the axis-exclusion walk is index-aware (i ≠ axis); a value-only
    # filter cannot see the axis position.
    var list<int> fr ← empty
    for range 0‥r const i {
        if i ≠ axis {
            fr.append(f.get(i) coalesce 1)
        }
    }
    var list<f32> out ← empty
    const int total ← f.reduce((int acc, int d) ∴ acc * d, 1)
    const int outer ← total / dim
    # Keep: the reduction is index-space (coordinates rebuilt per j via
    # _index_axis); no list of reduced values exists to fold.
    for range 0‥outer const o {
        var f32 s ← 0.0 ∷ f32
        for range 0‥dim const j {
            const int idx ← _index_axis(o, j, f, axis)
            s ← s + t.data.get(idx) coalesce 0.0 ∷ f32
        }
        out.append(s)
    }
    return tensor.stage(t.dtype, fr, out)
}

@ public
fn mean(tensor.NumericBlock t, int axis) → tensor.NumericBlock ⇥ MathError {
    const list<int> f ← t.shape
    const int r ← f.length()
    require r ≠ 0 throw variant GradusMismatch {message = "reduce requires rank >= 1"}
    reject (axis ≺ 0 or axis ≥ r) throw variant GradusMismatch {message = "axis out of range"}
    const int dim ← f.get(axis) coalesce 1
    require dim ≠ 0 throw variant ElementMismatch {message = "empty reduction axis"}
    var list<int> fr ← empty
    for range 0‥r const i {
        if i ≠ axis {
            fr.append(f.get(i) coalesce 1)
        }
    }
    var list<f32> out ← empty
    const int total ← f.reduce((int acc, int d) ∴ acc * d, 1)
    const int outer ← total / dim
    const f32 divisor ↤ dim
    # Keep: same index-space reduction as sum; no value list to fold.
    for range 0‥outer const o {
        var f32 s ← 0.0 ∷ f32
        for range 0‥dim const j {
            const int idx ← _index_axis(o, j, f, axis)
            s ← s + t.data.get(idx) coalesce 0.0 ∷ f32
        }
        out.append(s / divisor)
    }
    return tensor.stage(t.dtype, fr, out)
}

# -------------------------------------------------------------------------
# Family: matmul (rank-2 x rank-2). Higher-rank batched matmul is a later
# admission row (R3 — support rows, not hard-coded generics).
# -------------------------------------------------------------------------

@ public
fn matmul(tensor.NumericBlock a, tensor.NumericBlock b) → tensor.NumericBlock ⇥ MathError {
    # Keep: dot products run in index space over staged carriers (flat
    # i*k+p / p*n+j addressing); the typed tensor `·` intrinsic requires
    # tensor<f32, [M, N]> operands, not NumericBlock carriers.
    const list<int> fa ← a.shape
    const list<int> fb ← b.shape
    require fa.length() ≡ 2 throw variant GradusMismatch {message = "matmul requires rank-2 operands"}
    require fb.length() ≡ 2 throw variant GradusMismatch {message = "matmul requires rank-2 operands"}
    _dtype_pair(a, b)
    const int m ← fa.get(0) coalesce 1
    const int k ← fa.get(1) coalesce 1
    const int kb ← fb.get(0) coalesce 1
    const int n ← fb.get(1) coalesce 1
    require k ≡ kb throw variant Incompatible {message = "inner dimensions mismatch"}
    const list<int> fr ← [m, n]
    _numel_valid(fr)
    var list<f32> out ← empty
    for range 0‥m const i {
        for range 0‥n const j {
            var f32 s ← 0.0 ∷ f32
            for range 0‥k const p {
                const f32 va ← a.data.get(i * k + p) coalesce 0.0 ∷ f32
                const f32 vb ← b.data.get(p * n + j) coalesce 0.0 ∷ f32
                s ← s + va * vb
            }
            out.append(s)
        }
    }
    return tensor.stage(a.dtype, fr, out)
}

# -------------------------------------------------------------------------
# Family: cast — elementwise value cast via the dtype contract, entered by
# dtype NAME (the serialized tag form, dtype-schema-1.0.0). The tag entry
# exists because a `dtype.DType` parameter would make this export
# unprobe-importable (compiler lane: file-interface skips exports carrying
# cross-module nominal enum types, WARN014). Error contract:
# MathError.NonFinite / Overflow (dtype cast rules, fail-closed) and
# UnknownName for an unknown dtype name.
# -------------------------------------------------------------------------

fn _dtype_from_name(string name) → dtype.DType ⇥ MathError {
    return dtype.from_name(name)
}

@ public
fn cast(tensor.NumericBlock t, string name) → tensor.NumericBlock ⇥ MathError {
    const dtype.DType target ← _dtype_from_name(name)
    # Keep: each element cast is failable (NonFinite/Overflow must surface
    # as MathError in first-failure order); map cannot carry the typed
    # failure boundary.
    var list<f32> out ← empty
    for from t.data const v {
        const f32 cv ← dtype.cast(v, t.dtype, target)
        out.append(cv)
    }
    return tensor.stage(target, t.shape, out)
}

# -------------------------------------------------------------------------
# Family: concat / slice.
# -------------------------------------------------------------------------

# In-bounds shape-dim read. A miss fails closed instead of coalescing to 1.
# Other math families still paper-over missing dims with coalesce 1; converting
# those ripples through reduce/broadcast/matmul and is outside this unit.
# `_coordinate` / `_flat_axis` keep coalesce-1 internally (shared helpers).
fn _shape_dim(list<int> dims, int i) → int ⇥ MathError {
    reject (i ≺ 0 or i ≥ dims.length()) throw variant GradusMismatch {message = "shape index out of range"}
    do {
        return dims.get(i)
    }
    catch err {
        throw variant GradusMismatch {message = "shape index out of range"}
    }
    throw variant GradusMismatch {message = "shape index out of range"}
}

# In-bounds tensor-list read. A miss fails closed instead of tensor.default().
fn _part_at(list<tensor.NumericBlock> parts, int i) → tensor.NumericBlock ⇥ MathError {
    reject (i ≺ 0 or i ≥ parts.length()) throw variant ElementMismatch {message = "concat index out of range"}
    do {
        return parts.get(i)
    }
    catch err {
        throw variant ElementMismatch {message = "concat index out of range"}
    }
    throw variant ElementMismatch {message = "concat index out of range"}
}

# In-bounds f32 element read. A miss fails closed instead of coalescing to 0.0.
fn _elem_at(list<f32> data, int i) → f32 ⇥ MathError {
    reject (i ≺ 0 or i ≥ data.length()) throw variant ElementMismatch {message = "element index out of range"}
    do {
        return data.get(i)
    }
    catch err {
        throw variant ElementMismatch {message = "element index out of range"}
    }
    throw variant ElementMismatch {message = "element index out of range"}
}

@ public
fn concatenate(list<tensor.NumericBlock> parts, int axis) → tensor.NumericBlock ⇥ MathError {
    require parts.length() ≠ 0 throw variant ElementMismatch {message = "empty concat list"}
    const tensor.NumericBlock first ← _part_at(parts, 0)
    const list<int> f0 ← first.shape
    const int r ← f0.length()
    require r ≠ 0 throw variant GradusMismatch {message = "concat requires rank >= 1"}
    reject (axis ≺ 0 or axis ≥ r) throw variant GradusMismatch {message = "axis out of range"}
    var list<int> axis_dims ← empty
    var list<int> offsets ← empty
    var int acc ← 0
    # Keep: each part is validated (rank/dtype/dims) before contributing
    # axis_dims/offsets; a reducer cannot carry this failable order.
    for from parts const part {
        const list<int> f ← part.shape
        require f.length() ≡ r throw variant GradusMismatch {message = "concat rank mismatch"}
        require dtype.eq(part.dtype, first.dtype) throw variant DtypeMismatch {message = "dtype mismatch"}
        for range 0‥r const k {
            const int dk ← _shape_dim(f, k)
            const int d0 ← _shape_dim(f0, k)
            reject (k ≠ axis and dk ≠ d0) throw variant Incompatible {message = "concat dimension mismatch"}
        }
        const int adim ← _shape_dim(f, axis)
        axis_dims.append(adim)
        offsets.append(acc)
        acc ← acc + adim
    }
    var list<int> fr ← empty
    for range 0‥r const k {
        var int d0 ← _shape_dim(f0, k)
        if k ≡ axis {
            d0 ← acc
        }
        fr.append(d0)
    }
    const int total ← _numel_valid(fr)
    const int nparts ← parts.length()
    var list<f32> out ← empty
    # Keep: part selection is an interval-membership scan (offset window per
    # part), not a value argmax; the gather is index-space via
    # _coordinate/_flat_axis. slice's output walk shares this shape.
    for range 0‥total const o {
        const list<int> coords ← _coordinate(o, fr)
        const int ca ← _shape_dim(coords, axis)
        var int chosen ← 0
        for range 0‥nparts const j {
            const int off ← _shape_dim(offsets, j)
            const int adim ← _shape_dim(axis_dims, j)
            if ca ≥ off and ca ≺ off + adim {
                chosen ← j
            }
        }
        const int off ← _shape_dim(offsets, chosen)
        const tensor.NumericBlock part ← _part_at(parts, chosen)
        const int idx ← _flat_axis(coords, axis, ca - off, part.shape)
        out.append(_elem_at(part.data, idx))
    }
    return tensor.stage(first.dtype, fr, out)
}

@ public
fn slice(tensor.NumericBlock t, int axis, int start, int end) → tensor.NumericBlock ⇥ MathError {
    const list<int> f ← t.shape
    const int r ← f.length()
    require r ≠ 0 throw variant GradusMismatch {message = "slice requires rank >= 1"}
    reject (axis ≺ 0 or axis ≥ r) throw variant GradusMismatch {message = "axis out of range"}
    const int dim ← _shape_dim(f, axis)
    reject ((start ≺ 0 or end ≺ start) or end ≻ dim) throw variant Incompatible {message = "slice bounds out of range"}
    const int len ← end - start
    var list<int> fr ← empty
    for range 0‥r const i {
        var int d ← _shape_dim(f, i)
        if i ≡ axis {
            d ← len
        }
        fr.append(d)
    }
    const int total ← _numel_valid(fr)
    var list<f32> out ← empty
    for range 0‥total const o {
        const list<int> coords ← _coordinate(o, fr)
        const int ca ← _shape_dim(coords, axis)
        const int idx ← _flat_axis(coords, axis, ca + start, f)
        out.append(_elem_at(t.data, idx))
    }
    return tensor.stage(t.dtype, fr, out)
}
