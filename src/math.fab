test "cast rounds float to int to nearest, ties to even, and stages f32" {
    let _ trap_result_13 ← trap {
        let tensor.NumericBlock r ← math.cast(math.construct([3.7, -3.7, 2.5], [3]), "i32")
        assert dtype.name(r.dtype) ≡ "f32"
        assert elem1(r, 0) ≡ "4.0"
        assert elem1(r, 1) ≡ "-4.0"
        assert elem1(r, 2) ≡ "2.0"
    }
    match trap_result_13 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "cast passes in-range values through and stages the result as f32" {
    let _ trap_result_12 ← trap {
        let tensor.NumericBlock r ← math.cast(math.construct([1.5], [1]), "f16")
        assert dtype.name(r.dtype) ≡ "f32"
        assert elem1(r, 0) ≡ "1.5"
    }
    match trap_result_12 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "cast rejects overflow" {
    let _ trap_result_11 ← trap {
        let tensor.NumericBlock t ← math.construct([300.0], [1])
        let tensor.NumericBlock big ← math.construct([70000.0], [1])
        assert cast_detail(t, "u8") ≡ "u8 overflow in cast"
        assert cast_detail(big, "f16") ≡ "f16 overflow in cast"
    }
    match trap_result_11 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "cast rejects non-finite values to integers" {
    let _ trap_result_10 ← trap {
        let tensor.NumericBlock t ← math.construct([1.0 / 0.0], [1])
        assert cast_detail(t, "u8") ≡ "non-finite value in cast to u8"
    }
    match trap_result_10 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "cast rejects an unknown dtype name" {
    let _ trap_result_9 ← trap {
        let tensor.NumericBlock t ← math.construct([1.0], [1])
        assert cast_detail(t, "q8") ≡ "unknown dtype name: q8"
    }
    match trap_result_9 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

# -- concat / slice --------------------------------------------------------

test "concat joins along axis 1" {
    let _ trap_result_8 ← trap {
        let list<tensor.NumericBlock> parts ← [math.construct([1.0, 2.0, 3.0, 4.0], [2, 2]), math.construct([5.0, 6.0, 7.0, 8.0], [2, 2])]
        let tensor.NumericBlock r ← math.concatenate(parts, 1)
        assert r.shape ≡ ([2, 4] ↦ list<int>)
        assert elem2(r, 0, 0) ≡ "1.0"
        assert elem2(r, 0, 2) ≡ "5.0"
        assert elem2(r, 0, 3) ≡ "6.0"
        assert elem2(r, 1, 2) ≡ "7.0"
        assert elem2(r, 1, 3) ≡ "8.0"
    }
    match trap_result_8 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "concat joins along axis 0" {
    let _ trap_result_7 ← trap {
        let list<tensor.NumericBlock> parts ← [math.construct([1.0, 2.0, 3.0], [1, 3]), math.construct([4.0, 5.0, 6.0], [1, 3])]
        let tensor.NumericBlock r ← math.concatenate(parts, 0)
        assert r.shape ≡ ([2, 3] ↦ list<int>)
        assert elem2(r, 0, 0) ≡ "1.0"
        assert elem2(r, 1, 2) ≡ "6.0"
    }
    match trap_result_7 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "concat rejects a dimension mismatch along a non-axis" {
    let _ trap_result_6 ← trap {
        let tensor.NumericBlock a ← math.construct([1.0, 2.0], [1, 2])
        let tensor.NumericBlock b ← math.construct([1.0, 2.0, 3.0], [1, 3])
        assert concat_detail([a, b], 0) ≡ "concat dimension mismatch"
    }
    match trap_result_6 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "concat rejects an empty part list" {
    let list<tensor.NumericBlock> v ← empty
    assert concat_detail(v, 0) ≡ "empty concat list"

}

