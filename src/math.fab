+++
locale = "en"
+++
# Pure operation families — PML1-U4 (elementwise, reduce, matmul, cast,
# concat/slice) over the production tensor surface (gradus:tensor U1),
# dtype contract (gradus:dtype U2), and shape rules (gradus:shape U3).
#
# Public import: importa ex "gradus:math" privata math
# Depends on: gradus:tensor (Tensor), gradus:dtype (DType + casta), gradus:shape
# (broadcastum / quantitas). DAG: math → tensor → dtype; math → shape.
#
# --- Families -------------------------------------------------------------
#
#   * construction — structa(datos, forma): validated tensor construction
#     mapped onto MathError (tensor.structa remains the raw constructor),
#     so op pipelines carry one error vocabulary end to end.
#   * elementwise — add/sub/mul/div (binary, broadcast per forma.broadcastum)
#     and neg/abs/signum (unary). Result dtype equals the operand dtype; a dtype
#     mismatch fails closed (TypoMismatch) — promotion is an explicit casta
#     step, never implicit (capsule rule). Division follows f32 semantics:
#     division by zero yields ±Inf/NaN (representable in F32), it does not
#     throw — non-finite handling is the dtype cast contract's concern.
#   * reduce — summa / media over one axis. Axis must be in [0, rank); a
#     zero-length reduction axis fails closed (no degenerate empty sums).
#   * matmul — rank-2 x rank-2 matrix multiply ([M,K] x [K,N] → [M,N]).
#     Higher-rank batched matmul is a later admission row (R3: support rows,
#     not hard-coded generics); this row is documented here.
#   * cast — casta(t, nomen): elementwise value cast via the dtype contract,
#     entered by dtype NAME ("f32"/"f16"/"i32"/"u8", the serialized tag form
#     of dtype-schema-1.0.0). Result keeps the shape and takes the target
#     tag; failures are MathError.NonFinita (float→int of NaN/±Inf),
#     MathError.Superfluitas (overflow / above F16 max), and
#     MathError.NomenIgnotum (unknown name) — the dtype cast rules, mapped
#     into the uniform family vocabulary.
#   * concat/slice — concatenatio(partes, axis) joins tensors along one axis
#     (equal rank/dtype/shape except the axis); segmentum(t, axis, initium,
#     finis) slices along one axis with closed-open bounds [initium, finis).
#
# --- Contracts ------------------------------------------------------------
#
# Construction: every op returns a validated, consistent Tensor (valet holds,
# result shape ceiling-checked via forma.quantitas before allocation).
# Validation: inputs are validated fail-closed before any result is built
# (shape broadcastability, axis ranges, inner dims, dtype parity, slice
# bounds, ceilings). Error: one typed MathError vocabulary with distinct
# variants per failure class and a textus causa (render via math.causa);
# shape-rule failures (dims/ceilings) keep their FormaError identity mapped
# into MathError. Serialization: the op surface is the tensor construction
# contract — a result is a Tensor that round-trips through
# tensor.figura/typus/valet/quantitas; value bytes are PML1-U7.
#
# --- Compiler-lane notes (probed 2026-08-08, faber 1.6.0-rc.1) ------------
#
#   * Cross-module enum variants cannot be referenced in library context
#     (SEM001 unknown_variant, qualified or not) — so a shape.FormaError
#     cannot be matched here. Shape-rule failures are therefore mapped onto
#     MathError by their documented causa text (shape.proba asserts those
#     strings), keeping variant identity. Residual for the compiler lane.
#   * Proba-importability: file-interface snapshots skip exports whose
#     signatures carry cross-module nominal discretio types (WARN014
#     file_interface_export_skipped; e.g. tensor.structa_typo takes
#     dtype.DType). The cast entry is therefore name-based (textus), and the
#     dtype tag stays internal. Same finding already recorded for
#     structa_typo in PML1-U2.
#   * The tensor → math import edge (U1, unused) is dropped: this module
#     now owns tensor-typed ops, so math → tensor is the live edge.
#   * Receiver-method rule (gradus AGENTS.md) yields to the delivery-assigned
#     home for this surface: the families are free functions on the staged
#     Tensor carrier, not genus methods (the Tensor genus lives in tensor.fab,
#     outside U4's write scope). Residual for the Mind.

import from "gradus:dtype" dtype

import from "gradus:shape" shape

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# MathError — typed error vocabulary of the pure operation families. Every
# variant carries a textus causa (mirror of tensor/dtype/shape).
# -------------------------------------------------------------------------


@ public { }
union MathError {
    DimensioNegativa {
        string message
    },
    DimensioSupraLimitem {
        string message
    },
    ProductumSupraLimitem {
        string message
    },
    FormaMismatch {
        string message
    },
    GradusMismatch {
        string message
    },
    Incompatibilis {
        string message
    },
    TypoMismatch {
        string message
    },
    ElementMismatch {
        string message
    },
    NonFinita {
        string message
    },
    Superfluitas {
        string message
    },
    NomenIgnotum {
        string message
    }
}

@ public { }
fn message(MathError e) → string {
    match e {
        case DimensioNegativa const message {
            return message
        }
        case DimensioSupraLimitem const message {
            return message
        }
        case ProductumSupraLimitem const message {
            return message
        }
        case FormaMismatch const message {
            return message
        }
        case GradusMismatch const message {
            return message
        }
        case Incompatibilis const message {
            return message
        }
        case TypoMismatch const message {
            return message
        }
        case ElementMismatch const message {
            return message
        }
        case NonFinita const message {
            return message
        }
        case Superfluitas const message {
            return message
        }
        case NomenIgnotum const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# Broadcast two operand shapes with a typed error mapping (FormaError →
# MathError, variant identity preserved via the documented causa text).
@ private { }
fn _shape_broadcast(list<int> a, list<int> b) → list<int> ⇥ MathError {
    do {
        return shape.broadcast(a, b)
    }
    catch err {
        const string c ← shape.message(err)
        if c ≡ "negative dimension" {
            throw variant DimensioNegativa {message = c}
        }
        if c ≡ "dimension above ceiling" {
            throw variant DimensioSupraLimitem {message = c}
        }
        if c ≡ "element count above ceiling" {
            throw variant ProductumSupraLimitem {message = c}
        }
        throw variant FormaMismatch {message = c}
    }
}

# Bounded element count of a shape, ceiling-validated (gate before any
# allocation; same fail-closed mapping as _forma_broadcast).
@ private { }
fn _numel_valid(list<int> f) → int ⇥ MathError {
    do {
        return shape.numel(f)
    }
    catch err {
        const string c ← shape.message(err)
        if c ≡ "negative dimension" {
            throw variant DimensioNegativa {message = c}
        }
        if c ≡ "dimension above ceiling" {
            throw variant DimensioSupraLimitem {message = c}
        }
        if c ≡ "element count above ceiling" {
            throw variant ProductumSupraLimitem {message = c}
        }
        throw variant FormaMismatch {message = c}
    }
}

# Operand flat index for a result flat index under right-aligned broadcast.
# result coords are decomposed right-to-left; the operand reads dims of 1 as
# coordinate 0 and missing leading dims as 0 (scalar/singleton broadcast).
@ private { }
fn _index_broadcast(int planus, list<int> result, list<int> forma) → int {
    const int lr ← result.length()
    const int lf ← forma.length()
    var int res ← planus
    var int out ← 0
    var int stride ← 1
    var int k ← 0
    while k ≺ lr {
        const int dr ← result.get((lr - 1) - k) coalesce 1
        const int c ← res % dr
        var int ci ← 0
        var int df ← 1
        if k ≺ lf {
            df ← forma.get((lf - 1) - k) coalesce 1
            if df ≡ 1 {
                ci ← 0
            }
            else {
                ci ← c
            }
        }
        out ← out + ci * stride
        stride ← stride * df
        res ← res / dr
        k ← k + 1
    }
    return out
}

# Source flat index for a reduce result: output flat index o (over the
# reduced shape) with reduction coordinate j along axis.
@ private { }
fn _index_axis(int planus, int j, list<int> f, int axis) → int {
    const int r ← f.length()
    var int p ← planus
    var int out ← 0
    var int stride ← 1
    var int k ← 0
    while k ≺ r {
        const int idx ← (r - 1) - k
        const int dim ← f.get(idx) coalesce 1
        var int c ← 0
        if idx ≡ axis {
            c ← j
        }
        else {
            c ← p % dim
            p ← p / dim
        }
        out ← out + c * stride
        stride ← stride * dim
        k ← k + 1
    }
    return out
}

# Row-major coordinate vector for a flat index (left-to-right order).
@ private { }
fn _coordinate(int planus, list<int> forma) → list<int> {
    const int r ← forma.length()
    var list<int> coords ← vacua
    var int p ← planus
    var int total ← 1
    for from forma const dim {
        total ← total * dim
    }
    var int i ← 0
    while i ≺ r {
        const int dim ← forma.get(i) coalesce 1
        const int stride ← total / dim
        const int c ← p / stride
        coords.append(c)
        p ← p - c * stride
        total ← stride
        i ← i + 1
    }
    return coords
}

# Row-major flat index of a coordinate vector within forma, with the axis
# coordinate replaced by axis_local (concat/slice mapping).
@ private { }
fn _flat_axis(list<int> coords, int axis, int axis_local, list<int> forma) → int {
    const int r ← forma.length()
    var int planus ← 0
    var int stride ← 1
    var int k ← 0
    while k ≺ r {
        const int idx ← (r - 1) - k
        const int dim ← forma.get(idx) coalesce 1
        var int c ← coords.get(idx) coalesce 0
        if idx ≡ axis {
            c ← axis_local
        }
        planus ← planus + c * stride
        stride ← stride * dim
        k ← k + 1
    }
    return planus
}

# Dtype parity check — ops are fail-closed on mismatched tags; promotion is
# an explicit casta step.
@ private { }
fn _dtype_pair(tensor.Tensor a, tensor.Tensor b) → bool ⇥ MathError {
    if not dtype.eq(a.dtype(), b.dtype()) {
        throw variant TypoMismatch {message = "dtype mismatch"}
    }
    return true
}

# -------------------------------------------------------------------------
# Family: construction — validated tensor construction through the family
# error vocabulary. tensor.structa remains the raw validated constructor;
# this entry maps its TensorError failures onto MathError so op pipelines
# (and the family tests) carry one error type end to end. Part of the U4
# "construction/validation/error" contract for the families.
# -------------------------------------------------------------------------

@ public { }
fn construct(list<f32> datos, list<int> forma) → tensor.Tensor ⇥ MathError {
    do {
        return tensor.construct(datos, forma)
    }
    catch err {
        const string c ← tensor.message(err)
        if c ≡ "negative dimension" {
            throw variant DimensioNegativa {message = c}
        }
        if c ≡ "element count mismatch" {
            throw variant ElementMismatch {message = c}
        }
        throw variant FormaMismatch {message = c}
    }
}

# -------------------------------------------------------------------------
# Family: elementwise.
# -------------------------------------------------------------------------

@ public { }
fn add(tensor.Tensor a, tensor.Tensor b) → tensor.Tensor ⇥ MathError {
    const list<int> fa ← a.shape()
    const list<int> fb ← b.shape()
    const list<int> fr ← _shape_broadcast(fa, fb)
    const int total ← _numel_valid(fr)
    _dtype_pair(a, b)
    var list<f32> out ← vacua
    for range 0‥total const i {
        const int ia ← _index_broadcast(i, fr, fa)
        const int ib ← _index_broadcast(i, fr, fb)
        const f32 va ← a.data.get(ia) coalesce 0.0 ∷ f32
        const f32 vb ← b.data.get(ib) coalesce 0.0 ∷ f32
        out.append(va + vb)
    }
    return tensor.Tensor {dtype = a.dtype(), shape = fr, data = out}
}

@ public { }
fn sub(tensor.Tensor a, tensor.Tensor b) → tensor.Tensor ⇥ MathError {
    const list<int> fa ← a.shape()
    const list<int> fb ← b.shape()
    const list<int> fr ← _shape_broadcast(fa, fb)
    const int total ← _numel_valid(fr)
    _dtype_pair(a, b)
    var list<f32> out ← vacua
    for range 0‥total const i {
        const int ia ← _index_broadcast(i, fr, fa)
        const int ib ← _index_broadcast(i, fr, fb)
        const f32 va ← a.data.get(ia) coalesce 0.0 ∷ f32
        const f32 vb ← b.data.get(ib) coalesce 0.0 ∷ f32
        out.append(va - vb)
    }
    return tensor.Tensor {dtype = a.dtype(), shape = fr, data = out}
}

@ public { }
fn mul(tensor.Tensor a, tensor.Tensor b) → tensor.Tensor ⇥ MathError {
    const list<int> fa ← a.shape()
    const list<int> fb ← b.shape()
    const list<int> fr ← _shape_broadcast(fa, fb)
    const int total ← _numel_valid(fr)
    _dtype_pair(a, b)
    var list<f32> out ← vacua
    for range 0‥total const i {
        const int ia ← _index_broadcast(i, fr, fa)
        const int ib ← _index_broadcast(i, fr, fb)
        const f32 va ← a.data.get(ia) coalesce 0.0 ∷ f32
        const f32 vb ← b.data.get(ib) coalesce 0.0 ∷ f32
        out.append(va * vb)
    }
    return tensor.Tensor {dtype = a.dtype(), shape = fr, data = out}
}

@ public { }
fn div(tensor.Tensor a, tensor.Tensor b) → tensor.Tensor ⇥ MathError {
    const list<int> fa ← a.shape()
    const list<int> fb ← b.shape()
    const list<int> fr ← _shape_broadcast(fa, fb)
    const int total ← _numel_valid(fr)
    _dtype_pair(a, b)
    var list<f32> out ← vacua
    for range 0‥total const i {
        const int ia ← _index_broadcast(i, fr, fa)
        const int ib ← _index_broadcast(i, fr, fb)
        const f32 va ← a.data.get(ia) coalesce 0.0 ∷ f32
        const f32 vb ← b.data.get(ib) coalesce 0.0 ∷ f32
        out.append(va / vb)
    }
    return tensor.Tensor {dtype = a.dtype(), shape = fr, data = out}
}

@ public { }
fn neg(tensor.Tensor t) → tensor.Tensor ⇥ MathError {
    const list<int> f ← t.shape()
    const int total ← _numel_valid(f)
    var list<f32> out ← vacua
    for range 0‥total const i {
        const f32 v ← t.data.get(i) coalesce 0.0 ∷ f32
        out.append(0.0 ∷ f32 - v)
    }
    return tensor.Tensor {dtype = t.dtype(), shape = f, data = out}
}

@ public { }
fn abs(tensor.Tensor t) → tensor.Tensor ⇥ MathError {
    const list<int> f ← t.shape()
    const int total ← _numel_valid(f)
    var list<f32> out ← vacua
    for range 0‥total const i {
        const f32 v ← t.data.get(i) coalesce 0.0 ∷ f32
        out.append(v.abs())
    }
    return tensor.Tensor {dtype = t.dtype(), shape = f, data = out}
}

# signum — elementwise sign (the Absolute/Signum arm of the PML4 executed
# lane; the f32 receiver was masked on the FMIR lane by the MIR validator
# arms until radix 2df1af436, the same fix family as the rounding arm
# d0c9708fa). Semantics: the sign-bit result of the numeric intrinsic —
# +1.0 for every positive value (including +0.0), -1.0 for every negative
# value (including -0.0). Mirrors abs one-to-one.
@ public { }
fn signum(tensor.Tensor t) → tensor.Tensor ⇥ MathError {
    const list<int> f ← t.shape()
    const int total ← _numel_valid(f)
    var list<f32> out ← vacua
    for range 0‥total const i {
        const f32 v ← t.data.get(i) coalesce 0.0 ∷ f32
        out.append(v.sign())
    }
    return tensor.Tensor {dtype = t.dtype(), shape = f, data = out}
}

# -------------------------------------------------------------------------
# Family: reduce (summa / media over one axis).
# -------------------------------------------------------------------------

@ public { }
fn sum(tensor.Tensor t, int axis) → tensor.Tensor ⇥ MathError {
    const list<int> f ← t.shape()
    const int r ← f.length()
    if not (not (r ≡ 0)) {
        throw variant GradusMismatch {message = "reduce requires rank >= 1"}
    }
    if not (not (axis ≺ 0 or axis ≥ r)) {
        throw variant GradusMismatch {message = "axis out of range"}
    }
    const int dim ← f.get(axis) coalesce 1
    if not (not (dim ≡ 0)) {
        throw variant ElementMismatch {message = "empty reduction axis"}
    }
    var list<int> fr ← vacua
    var int i ← 0
    while i ≺ r {
        if i ≠ axis {
            fr.append(f.get(i) coalesce 1)
        }
        i ← i + 1
    }
    var list<f32> out ← vacua
    var int total ← 1
    for from f const d {
        total ← total * d
    }
    const int outer ← total / dim
    var int o ← 0
    while o ≺ outer {
        var f32 s ← 0.0 ∷ f32
        var int j ← 0
        while j ≺ dim {
            const int idx ← _index_axis(o, j, f, axis)
            s ← s + t.data.get(idx) coalesce 0.0 ∷ f32
            j ← j + 1
        }
        out.append(s)
        o ← o + 1
    }
    return tensor.Tensor {dtype = t.dtype(), shape = fr, data = out}
}

@ public { }
fn mean(tensor.Tensor t, int axis) → tensor.Tensor ⇥ MathError {
    const list<int> f ← t.shape()
    const int r ← f.length()
    if not (not (r ≡ 0)) {
        throw variant GradusMismatch {message = "reduce requires rank >= 1"}
    }
    if not (not (axis ≺ 0 or axis ≥ r)) {
        throw variant GradusMismatch {message = "axis out of range"}
    }
    const int dim ← f.get(axis) coalesce 1
    if not (not (dim ≡ 0)) {
        throw variant ElementMismatch {message = "empty reduction axis"}
    }
    var list<int> fr ← vacua
    var int i ← 0
    while i ≺ r {
        if i ≠ axis {
            fr.append(f.get(i) coalesce 1)
        }
        i ← i + 1
    }
    var list<f32> out ← vacua
    var int total ← 1
    for from f const d {
        total ← total * d
    }
    const int outer ← total / dim
    const f32 divisor ← dim ↦ f32
    var int o ← 0
    while o ≺ outer {
        var f32 s ← 0.0 ∷ f32
        var int j ← 0
        while j ≺ dim {
            const int idx ← _index_axis(o, j, f, axis)
            s ← s + t.data.get(idx) coalesce 0.0 ∷ f32
            j ← j + 1
        }
        out.append(s / divisor)
        o ← o + 1
    }
    return tensor.Tensor {dtype = t.dtype(), shape = fr, data = out}
}

# -------------------------------------------------------------------------
# Family: matmul (rank-2 x rank-2). Higher-rank batched matmul is a later
# admission row (R3 — support rows, not hard-coded generics).
# -------------------------------------------------------------------------

@ public { }
fn matmul(tensor.Tensor a, tensor.Tensor b) → tensor.Tensor ⇥ MathError {
    const list<int> fa ← a.shape()
    const list<int> fb ← b.shape()
    if not (not (fa.length() ≠ 2)) {
        throw variant GradusMismatch {message = "matmul requires rank-2 operands"}
    }
    if not (not (fb.length() ≠ 2)) {
        throw variant GradusMismatch {message = "matmul requires rank-2 operands"}
    }
    _dtype_pair(a, b)
    const int m ← fa.get(0) coalesce 1
    const int k ← fa.get(1) coalesce 1
    const int kb ← fb.get(0) coalesce 1
    const int n ← fb.get(1) coalesce 1
    if not (not (k ≠ kb)) {
        throw variant Incompatibilis {message = "inner dimensions mismatch"}
    }
    const list<int> fr ← [m, n]
    const int total ← _numel_valid(fr)
    var list<f32> out ← vacua
    var int i ← 0
    while i ≺ m {
        var int j ← 0
        while j ≺ n {
            var f32 s ← 0.0 ∷ f32
            var int p ← 0
            while p ≺ k {
                const f32 va ← a.data.get(i * k + p) coalesce 0.0 ∷ f32
                const f32 vb ← b.data.get(p * n + j) coalesce 0.0 ∷ f32
                s ← s + va * vb
                p ← p + 1
            }
            out.append(s)
            j ← j + 1
        }
        i ← i + 1
    }
    return tensor.Tensor {dtype = a.dtype(), shape = fr, data = out}
}

# -------------------------------------------------------------------------
# Family: cast — elementwise value cast via the dtype contract, entered by
# dtype NAME (the serialized tag form, dtype-schema-1.0.0). The tag entry
# exists because a `dtype.DType` parameter would make this export
# unprobe-importable (compiler lane: file-interface skips exports carrying
# cross-module nominal discretio types, WARN014). Error contract:
# MathError.NonFinita / Superfluitas (dtype cast rules, fail-closed) and
# NomenIgnotum for an unknown dtype name.
# -------------------------------------------------------------------------

@ private { }
fn _dtype_from_name(string nomen) → dtype.DType ⇥ MathError {
    do {
        return dtype.from_name(nomen)
    }
    catch err {
        const string c ← dtype.message(err)
        throw variant NomenIgnotum {message = c}
    }
}

@ public { }
fn cast(tensor.Tensor t, string nomen) → tensor.Tensor ⇥ MathError {
    const dtype.DType scopum ← _dtype_from_name(nomen)
    var list<f32> out ← vacua
    for from t.data const v {
        do {
            const f32 cv ← dtype.cast(v, t.dtype(), scopum)
            out.append(cv)
        }
        catch err {
            const string c ← dtype.message(err)
            if c ≡ "non-finite value in cast to i32" or c ≡ "non-finite value in cast to u8" {
                throw variant NonFinita {message = c}
            }
            throw variant Superfluitas {message = c}
        }
    }
    return tensor.Tensor {dtype = scopum, shape = t.shape(), data = out}
}

# -------------------------------------------------------------------------
# Family: concat / slice.
# -------------------------------------------------------------------------

@ public { }
fn concatenate(list<tensor.Tensor> partes, int axis) → tensor.Tensor ⇥ MathError {
    if not (not (partes.length() ≡ 0)) {
        throw variant ElementMismatch {message = "empty concat list"}
    }
    const tensor.Tensor primus ← partes.get(0)
    const list<int> f0 ← primus.shape()
    const int r ← f0.length()
    if not (not (r ≡ 0)) {
        throw variant GradusMismatch {message = "concat requires rank >= 1"}
    }
    if not (not (axis ≺ 0 or axis ≥ r)) {
        throw variant GradusMismatch {message = "axis out of range"}
    }
    var list<int> axis_dims ← vacua
    var list<int> offsets ← vacua
    var int acc ← 0
    for from partes const part {
        const list<int> f ← part.shape()
        if f.length() ≠ r {
            throw variant GradusMismatch {message = "concat rank mismatch"}
        }
        if not dtype.eq(part.dtype(), primus.dtype()) {
            throw variant TypoMismatch {message = "dtype mismatch"}
        }
        var int k ← 0
        while k ≺ r {
            const int dk ← f.get(k) coalesce 1
            const int d0 ← f0.get(k) coalesce 1
            if k ≠ axis and dk ≠ d0 {
                throw variant Incompatibilis {message = "concat dimension mismatch"}
            }
            k ← k + 1
        }
        const int adim ← f.get(axis) coalesce 1
        axis_dims.append(adim)
        offsets.append(acc)
        acc ← acc + adim
    }
    var list<int> fr ← vacua
    var int k ← 0
    while k ≺ r {
        var int d0 ← f0.get(k) coalesce 1
        if k ≡ axis {
            d0 ← acc
        }
        fr.append(d0)
        k ← k + 1
    }
    const int total ← _numel_valid(fr)
    const int nparts ← partes.length()
    var list<f32> out ← vacua
    for range 0‥total const o {
        const list<int> coords ← _coordinate(o, fr)
        const int ca ← coords.get(axis) coalesce 0
        var int chosen ← 0
        var int j ← 0
        while j ≺ nparts {
            const int off ← offsets.get(j) coalesce 0
            const int adim ← axis_dims.get(j) coalesce 1
            if ca ≥ off and ca ≺ off + adim {
                chosen ← j
            }
            j ← j + 1
        }
        const int off ← offsets.get(chosen) coalesce 0
        const tensor.Tensor part ← partes.get(chosen)
        const int idx ← _flat_axis(coords, axis, ca - off, part.shape())
        out.append(part.data.get(idx) coalesce 0.0 ∷ f32)
    }
    return tensor.Tensor {dtype = primus.dtype(), shape = fr, data = out}
}

@ public { }
fn slice(tensor.Tensor t, int axis, int initium, int finis) → tensor.Tensor ⇥ MathError {
    const list<int> f ← t.shape()
    const int r ← f.length()
    if not (not (r ≡ 0)) {
        throw variant GradusMismatch {message = "slice requires rank >= 1"}
    }
    if not (not (axis ≺ 0 or axis ≥ r)) {
        throw variant GradusMismatch {message = "axis out of range"}
    }
    const int dim ← f.get(axis) coalesce 1
    if not (not ((initium ≺ 0 or finis ≺ initium) or finis ≻ dim)) {
        throw variant Incompatibilis {message = "slice bounds out of range"}
    }
    const int len ← finis - initium
    var list<int> fr ← vacua
    var int i ← 0
    while i ≺ r {
        var int d ← f.get(i) coalesce 1
        if i ≡ axis {
            d ← len
        }
        fr.append(d)
        i ← i + 1
    }
    const int total ← _numel_valid(fr)
    var list<f32> out ← vacua
    for range 0‥total const o {
        const list<int> coords ← _coordinate(o, fr)
        const int ca ← coords.get(axis) coalesce 0
        const int idx ← _flat_axis(coords, axis, ca + initium, f)
        out.append(t.data.get(idx) coalesce 0.0 ∷ f32)
    }
    return tensor.Tensor {dtype = t.dtype(), shape = fr, data = out}
}
