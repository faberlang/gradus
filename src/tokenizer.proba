# Minor fixture for the typed-error and fallback paths: vocab "a","b","c"
# plus an unmappable display char (☃ U+2603) and a lone 0xC3 byte token
# ("Ã" — invalid UTF-8 on its own); one merge "a b".
functio _corpus_minor() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> tokens ← _iunge(
        _elementum([97]),
        _iunge(_elementum([98]), _iunge(_elementum([99]), _iunge(_elementum([226, 152, 131]), _elementum([195, 131]))))
    )
    fixum lista<numerus<u8>> merges ← _elementum([97, 32, 98])
    redde _corpus_binae([103, 112, 116, 50], tokens, 5, merges, 1)
}

# A malformed merge entry (no space separator) must fail closed.
functio _corpus_merges_mala() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> tokens ← _elementum([97])
    fixum lista<numerus<u8>> merges ← _elementum([97, 98])
    redde _corpus_binae([103, 112, 116, 50], tokens, 1, merges, 1)
}

# A non-byte-level model declaration must fail the capability check.
functio _corpus_llama() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> tokens ← _elementum([97])
    fixum lista<numerus<u8>> merges ← _elementum([97, 32, 98])
    redde _corpus_binae([108, 108, 97, 109, 97], tokens, 1, merges, 1)
}

# Encode a word through the artifact-backed runtime, rendering "ok|<ids>"
# or "ERR|<causa>".
functio _encoda_resultum(manifestum.CorpusGguf corpus, textus verbum) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            fixum lista<numerus> ids ← tokenizator.encoda(t, verbum)
            varia textus out ← ""
            varia numerus i ← 0
            dum i < ids.longitudo() {
                si i > 0 ergo out ← out + ","
                out ← out + (ids.accipe(i) vel 0 ↦ textus)
                i ↑
            }
            redde "ok|" + out
        }
        cape err {
            redde "ERR|" + tokenizator.causa(err)
        }
    }
    cape err {
        redde "ERR|" + manifestum.causa(err)
    }
}

# Decode an id list through the artifact-backed runtime, rendering "ok|text"
# or "ERR|<causa>".
functio _decoda_resultum(manifestum.CorpusGguf corpus, lista<numerus> ids) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            redde "ok|" + tokenizator.decoda(t, ids)
        }
        cape err {
            redde "ERR|" + tokenizator.causa(err)
        }
    }
    cape err {
        redde "ERR|" + manifestum.causa(err)
    }
}

probandum "LIB-02-U2 artifact-backed byte-level BPE core" {
    proba "the three word-level oracle rows encode to the exact pinned ids" {
        adfirma _encoda_resultum(_corpus_principalis(), "transformers") ≡ "ok|" + PINNATA_U2_A
        adfirma _encoda_resultum(_corpus_principalis(), "สวัสดี") ≡ "ok|" + PINNATA_U2_B
        adfirma _encoda_resultum(_corpus_principalis(), "人工智能") ≡ "ok|" + PINNATA_U2_C
    }

    proba "decode of each pinned id list reproduces the exact input text" {
        adfirma _decoda_resultum(_corpus_principalis(), [4549, 382]) ≡ "ok|transformers"
        adfirma _decoda_resultum(_corpus_principalis(), [34469, 168607]) ≡ "ok|สวัสดี"
        adfirma _decoda_resultum(_corpus_principalis(), [109015]) ≡ "ok|人工智能"
    }

    proba "merge application and single-byte fallback compose on a minor corpus" {
        adfirma _encoda_resultum(_corpus_minor(), "abc") ≡ "ok|0,1,2"
        adfirma _encoda_resultum(_corpus_minor(), "ab") ≡ "ok|0,1"
        adfirma _decoda_resultum(_corpus_minor(), [0, 1, 2]) ≡ "ok|abc"
    }

    proba "unknown and out-of-range ids fail with typed errors" {
        adfirma _decoda_resultum(_corpus_minor(), [5]) ≡ "ERR|token id outside the vocabulary range: 5"
        adfirma _decoda_resultum(_corpus_minor(), [-1]) ≡ "ERR|token id outside the vocabulary range: -1"
    }

    proba "unmappable display characters fail with a typed error" {
        adfirma _decoda_resultum(_corpus_minor(), [3]) ≡ "ERR|display character has no byte mapping (codepoint 9731)"
    }

    proba "invalid UTF-8 decode output fails with a typed error" {
        adfirma _decoda_resultum(_corpus_minor(), [4]) ≡ "ERR|decoded byte sequence is not valid UTF-8"
    }

    proba "malformed merge entries fail closed at construction" {
        adfirma _encoda_resultum(_corpus_merges_mala(), "a") ≡ "ERR|malformed merge entry: ab"
    }

    proba "the runtime rejects a manifest that is not byte-level BPE" {
        adfirma _encoda_resultum(_corpus_llama(), "a") ≡ "ERR|tokenizer runtime is byte-level BPE; manifest declares: llama"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-1 — Unicode-category tables + predicates (scanner data).
#
# The qwen35 pre-tokenizer regex classes (\p{L} / \p{M} / \p{N} / \s /
# CR+LF — llama-vocab.cpp LLAMA_VOCAB_PRE_TYPE_QWEN35) expressed as the
# bounded codepoint-range tables + predicates that resolve the delivery's
# open question 1 (can Fab express the required category tables). The pins
# below classify the codepoints the two probes and the differential rows
# exercise (raw-prompt rows, never through the template).
#
# Category names: littera = \p{L}, signum = \p{M}, numerus = \p{N},
# spatium = \s minus CR/LF, novum_linea = [\r\n], aliud = the rest.
# ---------------------------------------------------------------------------

probandum "LIB-02-U3-1 Unicode-category tables + predicates" {
    proba "the delivery example rows classify to the pinned categories" {
        adfirma tokenizator.categoria_nomen("ก") ≡ "littera"
        adfirma tokenizator.categoria_nomen("า") ≡ "littera"
        adfirma tokenizator.categoria_nomen("0") ≡ "numerus"
        adfirma tokenizator.categoria_nomen(" ") ≡ "spatium"
        adfirma tokenizator.categoria_nomen("\n") ≡ "novum_linea"
        adfirma tokenizator.categoria_nomen("🎉") ≡ "aliud"
    }

    proba "Probe A Thai letters classify as letters" {
        adfirma tokenizator.categoria_nomen("ก") ≡ "littera"
        adfirma tokenizator.categoria_nomen("ส") ≡ "littera"
        adfirma tokenizator.categoria_nomen("ว") ≡ "littera"
        adfirma tokenizator.categoria_nomen("ด") ≡ "littera"
        adfirma tokenizator.categoria_nomen("ค") ≡ "littera"
        adfirma tokenizator.categoria_nomen("ร") ≡ "littera"
        adfirma tokenizator.categoria_nomen("บ") ≡ "littera"
        adfirma tokenizator.categoria_nomen("ผ") ≡ "littera"
        adfirma tokenizator.categoria_nomen("ม") ≡ "littera"
        adfirma tokenizator.categoria_nomen("ช") ≡ "littera"
        adfirma tokenizator.categoria_nomen("อ") ≡ "littera"
        adfirma tokenizator.categoria_nomen("เ") ≡ "littera"
        adfirma tokenizator.categoria_nomen("ล") ≡ "littera"
        adfirma tokenizator.categoria_nomen("ซ") ≡ "littera"
    }

    proba "Probe A Thai marks classify as marks" {
        adfirma tokenizator.categoria_nomen("ั") ≡ "signum"
        adfirma tokenizator.categoria_nomen("ี") ≡ "signum"
        adfirma tokenizator.categoria_nomen("ื") ≡ "signum"
        adfirma tokenizator.categoria_nomen("์") ≡ "signum"
    }

    proba "Probe B CJK ideographs classify as letters" {
        adfirma tokenizator.categoria_nomen("你") ≡ "littera"
        adfirma tokenizator.categoria_nomen("好") ≡ "littera"
        adfirma tokenizator.categoria_nomen("世") ≡ "littera"
        adfirma tokenizator.categoria_nomen("界") ≡ "littera"
        adfirma tokenizator.categoria_nomen("今") ≡ "littera"
        adfirma tokenizator.categoria_nomen("天") ≡ "littera"
        adfirma tokenizator.categoria_nomen("是") ≡ "littera"
        adfirma tokenizator.categoria_nomen("年") ≡ "littera"
        adfirma tokenizator.categoria_nomen("月") ≡ "littera"
        adfirma tokenizator.categoria_nomen("日") ≡ "littera"
        adfirma tokenizator.categoria_nomen("人") ≡ "littera"
        adfirma tokenizator.categoria_nomen("工") ≡ "littera"
        adfirma tokenizator.categoria_nomen("智") ≡ "littera"
        adfirma tokenizator.categoria_nomen("能") ≡ "littera"
    }

    proba "ASCII digits classify as numbers" {
        adfirma tokenizator.categoria_nomen("0") ≡ "numerus"
        adfirma tokenizator.categoria_nomen("1") ≡ "numerus"
        adfirma tokenizator.categoria_nomen("2") ≡ "numerus"
        adfirma tokenizator.categoria_nomen("3") ≡ "numerus"
        adfirma tokenizator.categoria_nomen("4") ≡ "numerus"
        adfirma tokenizator.categoria_nomen("5") ≡ "numerus"
        adfirma tokenizator.categoria_nomen("6") ≡ "numerus"
        adfirma tokenizator.categoria_nomen("7") ≡ "numerus"
        adfirma tokenizator.categoria_nomen("8") ≡ "numerus"
        adfirma tokenizator.categoria_nomen("9") ≡ "numerus"
    }

    proba "whitespace and newline split the regex whitespace class" {
        adfirma tokenizator.categoria_nomen(" ") ≡ "spatium"
        adfirma tokenizator.categoria_nomen("\t") ≡ "spatium"
        adfirma tokenizator.categoria_nomen("\n") ≡ "novum_linea"
        adfirma tokenizator.categoria_nomen("\r") ≡ "novum_linea"
    }

    proba "punctuation, emoji, and fullwidth punctuation classify as other" {
        adfirma tokenizator.categoria_nomen("🎉") ≡ "aliud"
        adfirma tokenizator.categoria_nomen("，") ≡ "aliud"
        adfirma tokenizator.categoria_nomen("！") ≡ "aliud"
        adfirma tokenizator.categoria_nomen(",") ≡ "aliud"
        adfirma tokenizator.categoria_nomen(".") ≡ "aliud"
        adfirma tokenizator.categoria_nomen("!") ≡ "aliud"
        adfirma tokenizator.categoria_nomen("'") ≡ "aliud"
    }

    proba "the predicates agree with the classifier" {
        adfirma tokenizator.est_littera("ก")
        adfirma tokenizator.est_signum("ั")
        adfirma tokenizator.est_numerus("0")
        adfirma tokenizator.est_spatium(" ")
        adfirma tokenizator.est_novum_linea("\n")
        adfirma tokenizator.est_aliud("🎉")
        adfirma non (tokenizator.est_littera("0"))
        adfirma non (tokenizator.est_numerus("ก"))
        adfirma non (tokenizator.est_spatium("\n"))
        adfirma non (tokenizator.est_novum_linea(" "))
    }

    proba "each probe-exercised character belongs to exactly one category" {
        adfirma non (tokenizator.est_signum("ก"))
        adfirma non (tokenizator.est_numerus("ก"))
        adfirma non (tokenizator.est_spatium("ก"))
        adfirma non (tokenizator.est_novum_linea("ก"))
        adfirma non (tokenizator.est_aliud("ก"))
        adfirma non (tokenizator.est_littera("ั"))
        adfirma non (tokenizator.est_numerus("ั"))
        adfirma non (tokenizator.est_littera("0"))
        adfirma non (tokenizator.est_spatium("0"))
        adfirma non (tokenizator.est_littera(" "))
        adfirma non (tokenizator.est_novum_linea(" "))
        adfirma non (tokenizator.est_littera("\n"))
        adfirma non (tokenizator.est_spatium("\n"))
        adfirma non (tokenizator.est_littera("🎉"))
        adfirma non (tokenizator.est_numerus("🎉"))
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-2 — qwen35 word-splitting scanner (core families).
#
# The qwen35 pre-tokenizer (llama-vocab.cpp LLAMA_VOCAB_PRE_TYPE_QWEN35;
# unicode.cpp unicode_regex_split_custom_qwen35, pinned oracle 10150
# `dee2a846b`) splits a prompt into words before the byte-level BPE core.
# This unit pins the CORE content families — letter/mark runs with an
# optional leading non-CR/LF/number char, single numbers, whitespace runs
# (including the trailing-run form) and newline runs. The 10 rows below are
# the delivery's word-boundary / digit / newline differential table: each
# row must split to the pinned words AND encode through scanner + BPE core
# to the exact pinned id list, and decode must round-trip the input.
#
# The fixture corpus is a structural model (same approach as U2): the pinned
# tokens sit at their pinned ids with the exact display strings, and the
# merge table carries exactly the ranked merge pairs the real BPE applies to
# each row word. No artifact bytes are committed. Word lists were derived
# from the pinned scanner; id lists are the delivery differential rows.
# ---------------------------------------------------------------------------

# Pinned word-boundary / digit / newline rows (delivery differential table).
fixum textus PINNATA_U3_2_R1 ← "4549,382,245990,220,109015"
fixum textus PINNATA_U3_2_R2 ← "4549,382,220,245990"
fixum textus PINNATA_U3_2_R3 ← "220,109266"
fixum textus PINNATA_U3_2_R4 ← "109266,220"
fixum textus PINNATA_U3_2_R5 ← "64,256,292"
fixum textus PINNATA_U3_2_R6 ← "17,15,17,21"
fixum textus PINNATA_U3_2_R7 ← "16,17,18"
fixum textus PINNATA_U3_2_R8 ← "64,198,65"
fixum textus PINNATA_U3_2_R9 ← "64,271,65"
fixum textus PINNATA_U3_2_R10 ← "64,2161"

# Scanner fixture: pinned tokens at their pinned ids (max id 245990, 245991
# entries) with a one-byte placeholder elsewhere, plus the 48 ranked merge
# pairs the real BPE applies to the row words (transformers / Ġสวัสดี /
# 你好 / 人工智能 / ĠĠ / ĊĊ / Ġb / ĉb). Pinned tokens: 15 "0", 16 "1",
# 17 "2", 18 "3", 21 "6", 64 "a", 65 "b", 198 "Ċ", 220 "Ġ", 256 "ĠĠ",
# 271 "ĊĊ", 292 "Ġb", 2161 "ĉb", 382 "ers", 4549 "transform",
# 109015 人工智能 display, 109266 你好 display, 245990 Ġสวัสดี display.
functio _corpus_scanner() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> ding ← _elementum([33])
    varia lista<numerus<u8>> tokens ← _stringarum_itera(15, ding)
    tokens ← _iunge(tokens, _elementum([48]))
    tokens ← _iunge(tokens, _elementum([49]))
    tokens ← _iunge(tokens, _elementum([50]))
    tokens ← _iunge(tokens, _elementum([51]))
    tokens ← _iunge(tokens, _stringarum_itera(2, ding))
    tokens ← _iunge(tokens, _elementum([54]))
    tokens ← _iunge(tokens, _stringarum_itera(42, ding))
    tokens ← _iunge(tokens, _elementum([97]))
    tokens ← _iunge(tokens, _elementum([98]))
    tokens ← _iunge(tokens, _stringarum_itera(132, ding))
    tokens ← _iunge(tokens, _elementum([196, 138]))
    tokens ← _iunge(tokens, _stringarum_itera(21, ding))
    tokens ← _iunge(tokens, _elementum([196, 160]))
    tokens ← _iunge(tokens, _stringarum_itera(35, ding))
    tokens ← _iunge(tokens, _elementum([196, 160, 196, 160]))
    tokens ← _iunge(tokens, _stringarum_itera(14, ding))
    tokens ← _iunge(tokens, _elementum([196, 138, 196, 138]))
    tokens ← _iunge(tokens, _stringarum_itera(20, ding))
    tokens ← _iunge(tokens, _elementum([196, 160, 98]))
    tokens ← _iunge(tokens, _stringarum_itera(89, ding))
    tokens ← _iunge(tokens, _elementum([101, 114, 115]))
    tokens ← _iunge(tokens, _stringarum_itera(1778, ding))
    tokens ← _iunge(tokens, _elementum([196, 137, 98]))
    tokens ← _iunge(tokens, _stringarum_itera(2387, ding))
    tokens ← _iunge(tokens, _elementum([116, 114, 97, 110, 115, 102, 111, 114, 109]))
    tokens ← _iunge(tokens, _stringarum_itera(104465, ding))
    tokens ← _iunge(tokens, _elementum([195,164,194,186,194,186,195,165,194,183,194,165,195,166,196,187,194,186,195,168,196,165,194,189]))
    tokens ← _iunge(tokens, _stringarum_itera(250, ding))
