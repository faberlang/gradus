describe "LIB-02-U3-7 full two-probe composition + divergence receipts" {
    test "the scanner splits both probes to the pinned words" {
        assert _scanna_resultum(PROBE_A) ≡ "ok|สวัสดีครับ| ผมชื่ออเล็กซ์"
        assert _scanna_resultum(PROBE_B) ≡ "ok|你好|，|世界|！|今天是|2|0|2|6|年|8|月|1|3|日| 🎉"
    }
    test "Probe A encodes to the exact pinned ids (composed runtime)" {
        assert _encoda_promptum_specialia_resultum(_corpus_proba_a(), PROBE_A) ≡ "ok|" + PINNATA_U3_7_PROBE_A
        assert _encoda_promptum_resultum(_corpus_proba_a(), PROBE_A) ≡ "ok|" + PINNATA_U3_7_PROBE_A
    }
    test "Probe B encodes to the exact pinned ids (composed runtime)" {
        assert _encoda_promptum_specialia_resultum(_corpus_chat(), PROBE_B) ≡ "ok|" + PINNATA_U3_7_PROBE_B
        assert _encoda_promptum_resultum(_corpus_chat(), PROBE_B) ≡ "ok|" + PINNATA_U3_7_PROBE_B
    }
    test "both probes decode back to the exact prompts" {
        assert _decoda_plena(_corpus_proba_a(), PROBE_A) ≡ "ok|" + PROBE_A
        assert _decoda_plena(_corpus_chat(), PROBE_B) ≡ "ok|" + PROBE_B
    }
    test "the probe rows are raw-prompt rows, never through the template" {
        # The raw Probe B row stays bare (18 ids) — the U3-6 R1 row wraps the
        # same ids in the ChatML user-turn and must differ from it.
        assert _encoda_promptum_specialia_resultum(_corpus_chat(), PROBE_B) ≡ "ok|" + PINNATA_U3_7_PROBE_B
        assert _encoda_promptum_specialia_resultum(_corpus_chat(), PROBE_B) ≠ "ok|" + PINNATA_U3_6_R1
    }
    test "the probe runtime is the complete composed surface (EOG/BOS/chat)" {
        assert _eog_resultum(_corpus_proba_a()) ≡ "ok|248046"
        assert _add_bos_resultum(_corpus_proba_a()) ≡ "bos-free"
        assert _chat_template_resultum(_corpus_proba_a()) ≡ "ok|" + F_TEMPLATE
    }
}
