    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 95, 116, 121, 112, 101], 9, _array(4, 248047, _chat_typi())))
