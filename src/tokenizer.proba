# Runtime EOG set as textus: "ok|<ids>" or "ERR|<causa>".
fn _eog_resultum(manifestum.CorpusGguf corpus) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            const list<int> eog ← tokenizator.eog_artificii(t)
            var string out ← ""
            var int i ← 0
            while i ≺ eog.longitudo() {
                if i ≻ 0 then out ← out + ","
                out ← out + (eog.accipe(i) coalesce 0 ↦ string)
                i ← i + 1
            }
            return "ok|" + out
        }
        catch err {
            return "ERR|" + tokenizator.causa(err)
        }
    }
    catch err {
        return "ERR|" + manifestum.causa(err)
    }
}

# EOG-membership outcome: "ok" when the id is a member, "non" otherwise.
fn _est_eog_resultum(manifestum.CorpusGguf corpus, int id) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            if tokenizator.est_eog_artificii(t, id) then return "ok"
            return "non"
        }
        catch err {
            return "ERR|" + tokenizator.causa(err)
        }
    }
    catch err {
        return "ERR|" + manifestum.causa(err)
    }
}

# add_bos outcome: "adds-bos" when verum, "bos-free" when falsum.
fn _add_bos_resultum(manifestum.CorpusGguf corpus) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            if tokenizator.add_bos(t) then return "adds-bos"
            return "bos-free"
        }
        catch err {
            return "ERR|" + tokenizator.causa(err)
        }
    }
    catch err {
        return "ERR|" + manifestum.causa(err)
    }
}

describe "LIB-02-U3-5 EOG + BOS-free policy" {
    test "the runtime EOG set is exactly the pinned artifact set" {
        assert _eog_resultum(_corpus_eog()) ≡ "ok|" + PINNATA_U3_5_EOG
    }
    test "EOG membership admits exactly the five pinned ids" {
        assert _est_eog_resultum(_corpus_eog(), 248044) ≡ "ok"
        assert _est_eog_resultum(_corpus_eog(), 248046) ≡ "ok"
        assert _est_eog_resultum(_corpus_eog(), 248063) ≡ "ok"
        assert _est_eog_resultum(_corpus_eog(), 248064) ≡ "ok"
        assert _est_eog_resultum(_corpus_eog(), 248065) ≡ "ok"
        assert _est_eog_resultum(_corpus_eog(), 248045) ≡ "non"
        assert _est_eog_resultum(_corpus_eog(), 0) ≡ "non"
        assert _est_eog_resultum(_corpus_eog(), 87) ≡ "non"
    }
    test "encode is BOS-free: empty prompt → empty sequence, x → [87]" {
        assert _encoda_promptum_resultum(_corpus_eog(), "") ≡ "ok|"
        assert _encoda_promptum_specialia_resultum(_corpus_eog(), "") ≡ "ok|"
        assert _encoda_promptum_resultum(_corpus_eog(), "x") ≡ "ok|" + PINNATA_U3_5_X
        assert _encoda_promptum_specialia_resultum(_corpus_eog(), "x") ≡ "ok|" + PINNATA_U3_5_X
    }
    test "the artifact add_bos_token = falsum is honored on the runtime surface" {
        assert _add_bos_resultum(_corpus_eog()) ≡ "bos-free"
    }
    test "an artifact without EOG metadata yields an empty EOG set (no hard-coded fallback)" {
        assert _eog_resultum(_corpus_minor()) ≡ "ok|"
        assert _est_eog_resultum(_corpus_minor(), 0) ≡ "non"
        assert _add_bos_resultum(_corpus_minor()) ≡ "bos-free"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-6 — Chat-template policy (metadata + minimal user-turn).
#
# `tokenizer.chat_template` loads from artifact metadata into the runtime
# (the U1 textum seam; absent → empty string — no hard-coded fallback), and
# the MINIMAL Qwen3-ChatML user-turn render applies the pinned shape
# `<|im_start|>user\n{content}<|im_end|>\n`. The 3 rows below are the
# delivery's chat-template differential table:
#   rendered Probe B user turn          -> R1  (parse-special on)
#   same, --no-parse-special            -> R1b (literal)
#   <|im_start|>assistant\n             -> R2
# R1 proves the ChatML path composes without changing the pinned Probe B
# ids (the 18-ids segment embeds verbatim). Full vision/tool-calling
# template branches are recorded, not executed (delivery scope matrix).
#
# The fixture corpus is a structural model (same approach as U2/U3-2..U3-5):
# the pinned tokens sit at their pinned ids with the exact display strings,
# the token_type array marks exactly the two ChatML specials CONTROL (3),
# the merge table carries exactly the ranked merge pairs the real BPE
# applies to each rendered word, and the chat_template metadata stores the
# minimal ChatML shape. A second small corpus pins R2 (assistant; its merge
# chain would collide with the user-turn corpus's "s t" entry, so the rows
# live on separate fixtures). No artifact bytes are committed.
# ---------------------------------------------------------------------------

