    merges ← _join(merges, _elementum([195, 168, 196, 165, 32, 194, 189]))
    merges ← _join(merges, _elementum([195, 166, 196, 187, 194, 186, 32, 195, 168, 196, 165, 194, 189]))
    merges ← _join(merges, _elementum([195, 164, 194, 186, 194, 186, 195, 165, 194, 183, 194, 165, 32, 195, 166, 196, 187, 194, 186, 195, 168, 196, 165, 194, 189]))
    merges ← _join(merges, _elementum([196, 160, 32, 196, 160]))
    merges ← _join(merges, _elementum([196, 138, 32, 196, 138]))
    merges ← _join(merges, _elementum([196, 160, 32, 98]))
    merges ← _join(merges, _elementum([196, 137, 32, 98]))
    return _corpus_binae([103, 112, 116, 50], tokens, 245991, merges, 48)
}

# scan_words outcome as text: "ok|<word>|<word>|..." or "ERR|<message>".
fn _scan_result(string text) → string {
    do {
        const list<string> words ← tokenizer.scan_words(text)
        var string out ← "ok"
        for from words const word {
            out ← (out + "|") + word
        }
        return out
    }
    catch err {
        return "ERR|" + tokenizer.message(err)
    }
}

# Full-prompt encode (scanner + BPE core) as text: "ok|<ids>" or "ERR|<message>".
fn _encode_prompt_result(gguf_manifest.GgufCorpus corpus, string text) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tokenizer.Tokenizer t ← tokenizer.build(m)
            const list<int> ids ← tokenizer.encode_prompt(t, text)
            var string out ← ""
            var int i ← 0
            while i ≺ ids.length() {
                if i ≻ 0 then out ← out + ","
                out ← out + (ids.get(i) coalesce 0 ↦ string)
                i ← i + 1
            }
            return "ok|" + out
        }
        catch err {
            return "ERR|" + tokenizer.message(err)
        }
    }
    catch err {
        return "ERR|" + gguf_manifest.message(err)
    }
}

# Full-prompt round-trip as text: "ok|<decoded text>" or "ERR|<message>".
fn _decode_full(gguf_manifest.GgufCorpus corpus, string text) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tokenizer.Tokenizer t ← tokenizer.build(m)
            const list<int> ids ← tokenizer.encode_prompt(t, text)
            return "ok|" + tokenizer.decode(t, ids)
        }
        catch err {
            return "ERR|" + tokenizer.message(err)
        }
    }
    catch err {
        return "ERR|" + gguf_manifest.message(err)
    }
}

describe "LIB-02-U3-2 qwen35 word-splitting scanner (core families)" {
    test "the scanner splits each word-boundary / digit / newline row to the pinned words" {
        assert _scan_result("transformers สวัสดี 人工智能") ≡ "ok|transformers| สวัสดี| 人工智能"
        assert _scan_result("transformers  สวัสดี") ≡ "ok|transformers| | สวัสดี"
        assert _scan_result(" 你好") ≡ "ok| 你好"
        assert _scan_result("你好 ") ≡ "ok|你好| "
        assert _scan_result("a   b") ≡ "ok|a|  | b"
        assert _scan_result("2026") ≡ "ok|2|0|2|6"
        assert _scan_result("123") ≡ "ok|1|2|3"
        assert _scan_result("a\nb") ≡ "ok|a|\n|b"
        assert _scan_result("a\n\nb") ≡ "ok|a|\n\n|b"
        assert _scan_result("a\tb") ≡ "ok|a|\tb"
    }
    test "whitespace and newline family edges mirror the reference scanner" {
        assert _scan_result("a  b") ≡ "ok|a| | b"
        assert _scan_result("a \nb") ≡ "ok|a| \n| b"
        assert _scan_result("a \n") ≡ "ok|a| \n"
        assert _scan_result("\n a") ≡ "ok|\n| a"
        assert _scan_result("a  \nb") ≡ "ok|a|  \n|b"
        assert _scan_result("a  ") ≡ "ok|a|  "
    }
    test "each word-boundary / digit / newline row encodes to its exact pinned ids" {
        assert _encode_prompt_result(_corpus_scanner(), "transformers สวัสดี 人工智能") ≡ "ok|" + PINNED_U3_2_R1
        assert _encode_prompt_result(_corpus_scanner(), "transformers  สวัสดี") ≡ "ok|" + PINNED_U3_2_R2
        assert _encode_prompt_result(_corpus_scanner(), " 你好") ≡ "ok|" + PINNED_U3_2_R3
        assert _encode_prompt_result(_corpus_scanner(), "你好 ") ≡ "ok|" + PINNED_U3_2_R4
        assert _encode_prompt_result(_corpus_scanner(), "a   b") ≡ "ok|" + PINNED_U3_2_R5
        assert _encode_prompt_result(_corpus_scanner(), "2026") ≡ "ok|" + PINNED_U3_2_R6
        assert _encode_prompt_result(_corpus_scanner(), "123") ≡ "ok|" + PINNED_U3_2_R7
        assert _encode_prompt_result(_corpus_scanner(), "a\nb") ≡ "ok|" + PINNED_U3_2_R8
        assert _encode_prompt_result(_corpus_scanner(), "a\n\nb") ≡ "ok|" + PINNED_U3_2_R9
        assert _encode_prompt_result(_corpus_scanner(), "a\tb") ≡ "ok|" + PINNED_U3_2_R10
    }
    test "decode round-trips each row through the scanner + BPE core" {
        assert _decode_full(_corpus_scanner(), "transformers สวัสดี 人工智能") ≡ "ok|transformers สวัสดี 人工智能"
        assert _decode_full(_corpus_scanner(), "transformers  สวัสดี") ≡ "ok|transformers  สวัสดี"
        assert _decode_full(_corpus_scanner(), " 你好") ≡ "ok| 你好"
        assert _decode_full(_corpus_scanner(), "你好 ") ≡ "ok|你好 "
        assert _decode_full(_corpus_scanner(), "a   b") ≡ "ok|a   b"
        assert _decode_full(_corpus_scanner(), "2026") ≡ "ok|2026"
        assert _decode_full(_corpus_scanner(), "123") ≡ "ok|123"
        assert _decode_full(_corpus_scanner(), "a\nb") ≡ "ok|a\nb"
        assert _decode_full(_corpus_scanner(), "a\n\nb") ≡ "ok|a\n\nb"
        assert _decode_full(_corpus_scanner(), "a\tb") ≡ "ok|a\tb"
    }
    test "a character no core family matches falls to a single-word fallthrough" {
        assert _scan_result("🎉") ≡ "ok|🎉"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-3 — qwen35 scanner edge families (punct/emoji/contractions).
#
# The remaining qwen35 regex families composed into the same scanner
# (unicode.cpp unicode_regex_split_custom_qwen35; llama-vocab.cpp
# LLAMA_VOCAB_PRE_TYPE_QWEN35, oracle 10150 `dee2a846b`):
#   * contraction family — (?i:'s|'t|'re|'ve|'m|'ll|'d), matched first,
#   * punctuation/emoji/other runs — ?[^\s\p{L}\p{M}\p{N}]+[\r\n]* with an
#     optional leading literal space and all trailing CR/LF.
# The 7 rows below are the delivery's punctuation/emoji/contraction
# differential table: each row must split to the pinned words AND encode
# through scanner + BPE core to the exact pinned id list, and decode must
# round-trip the input. The family-edge split pins (E1–E5) pin the new
# arms' semantics directly (run grouping, trailing-newline consumption,
# leading-space join, contraction precedence over the letter-run leading
# char, case-insensitive contractions).
#
# The fixture corpus is a structural model (same approach as U2/U3-2): the
# pinned tokens sit at their pinned ids with the exact display strings, and
# the merge table carries exactly the ranked merge pairs the real BPE
# applies to each row word. No artifact bytes are committed.
# ---------------------------------------------------------------------------

# Pinned punctuation/emoji/contraction rows (delivery differential table).
