    var list<int<u8>> out ← _u32_valoris_itera(248044, 1)
    out ← _iunge(out, _u32(3))
    out ← _iunge(out, _u32(1))
    out ← _iunge(out, _u32(3))
    out ← _iunge(out, _u32_valoris_itera(16, 1))
