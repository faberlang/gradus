describe "LIB-02-U3-7 full two-probe composition + divergence receipts" {
    test "the scanner splits both probes to the pinned words" {
        assert _scan_result(PROBE_A) ≡ "ok|สวัสดีครับ| ผมชื่ออเล็กซ์"
        assert _scan_result(PROBE_B) ≡ "ok|你好|，|世界|！|今天是|2|0|2|6|年|8|月|1|3|日| 🎉"
    }
    test "Probe A encodes to the exact pinned ids (composed runtime)" {
        assert _encode_prompt_special_result(_corpus_probe_a(), PROBE_A) ≡ "ok|" + PINNED_U3_7_PROBE_A
        assert _encode_prompt_result(_corpus_probe_a(), PROBE_A) ≡ "ok|" + PINNED_U3_7_PROBE_A
    }
    test "Probe B encodes to the exact pinned ids (composed runtime)" {
        assert _encode_prompt_special_result(_corpus_chat(), PROBE_B) ≡ "ok|" + PINNED_U3_7_PROBE_B
        assert _encode_prompt_result(_corpus_chat(), PROBE_B) ≡ "ok|" + PINNED_U3_7_PROBE_B
    }
    test "both probes decode back to the exact prompts" {
        assert _decode_full(_corpus_probe_a(), PROBE_A) ≡ "ok|" + PROBE_A
        assert _decode_full(_corpus_chat(), PROBE_B) ≡ "ok|" + PROBE_B
    }
    test "the probe rows are raw-prompt rows, never through the template" {
        # The raw Probe B row stays bare (18 ids) — the U3-6 R1 row wraps the
        # same ids in the ChatML user-turn and must differ from it.
        assert _encode_prompt_special_result(_corpus_chat(), PROBE_B) ≡ "ok|" + PINNED_U3_7_PROBE_B
        assert _encode_prompt_special_result(_corpus_chat(), PROBE_B) ≠ "ok|" + PINNED_U3_6_R1
    }
    test "the probe runtime is the complete composed surface (EOG/BOS/chat)" {
        assert _eog_result(_corpus_probe_a()) ≡ "ok|248046"
        assert _add_bos_result(_corpus_probe_a()) ≡ "bos-free"
        assert _chat_template_result(_corpus_probe_a()) ≡ "ok|" + F_TEMPLATE
    }
}

