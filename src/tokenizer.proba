# Minor fixture for the typed-error and fallback paths: vocab "a","b","c"
# plus an unmappable display char (☃ U+2603) and a lone 0xC3 byte token
# ("Ã" — invalid UTF-8 on its own); one merge "a b".
fn _corpus_minor() → manifestum.CorpusGguf {
    const list<int<u8>> tokens ← _iunge(_elementum([97]), _iunge(_elementum([98]), _iunge(_elementum([99]), _iunge(_elementum([226, 152, 131]), _elementum([195, 131])))))
    const list<int<u8>> merges ← _elementum([97, 32, 98])
    return _corpus_binae([103, 112, 116, 50], tokens, 5, merges, 1)
}

# A malformed merge entry (no space separator) must fail closed.
fn _corpus_merges_mala() → manifestum.CorpusGguf {
    const list<int<u8>> tokens ← _elementum([97])
    const list<int<u8>> merges ← _elementum([97, 98])
    return _corpus_binae([103, 112, 116, 50], tokens, 1, merges, 1)
}

# A non-byte-level model declaration must fail the capability check.
fn _corpus_llama() → manifestum.CorpusGguf {
    const list<int<u8>> tokens ← _elementum([97])
    const list<int<u8>> merges ← _elementum([97, 32, 98])
    return _corpus_binae([108, 108, 97, 109, 97], tokens, 1, merges, 1)
}

# Encode a word through the artifact-backed runtime, rendering "ok|<ids>"
# or "ERR|<causa>".
fn _encoda_resultum(manifestum.CorpusGguf corpus, string verbum) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            const list<int> ids ← tokenizator.encoda(t, verbum)
            var string out ← ""
            var int i ← 0
            while i ≺ ids.longitudo() {
                if i ≻ 0 then out ← out + ","
                out ← out + (ids.accipe(i) coalesce 0 ↦ string)
                i ↑
            }
            return "ok|" + out
        }
        catch err {
            return "ERR|" + tokenizator.causa(err)
        }
    }
    catch err {
        return "ERR|" + manifestum.causa(err)
    }
}

# Decode an id list through the artifact-backed runtime, rendering "ok|text"
# or "ERR|<causa>".
fn _decoda_resultum(manifestum.CorpusGguf corpus, list<int> ids) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            return "ok|" + tokenizator.decoda(t, ids)
        }
        catch err {
            return "ERR|" + tokenizator.causa(err)
        }
    }
    catch err {
        return "ERR|" + manifestum.causa(err)
    }
}

describe "LIB-02-U2 artifact-backed byte-level BPE core" {
    test "the three word-level oracle rows encode to the exact pinned ids" {
        assert _encoda_resultum(_corpus_principalis(), "transformers") ≡ "ok|" + PINNATA_U2_A
        assert _encoda_resultum(_corpus_principalis(), "สวัสดี") ≡ "ok|" + PINNATA_U2_B
        assert _encoda_resultum(_corpus_principalis(), "人工智能") ≡ "ok|" + PINNATA_U2_C
    }
    test "decode of each pinned id list reproduces the exact input text" {
        assert _decoda_resultum(_corpus_principalis(), [4549, 382]) ≡ "ok|transformers"
        assert _decoda_resultum(_corpus_principalis(), [34469, 168607]) ≡ "ok|สวัสดี"
        assert _decoda_resultum(_corpus_principalis(), [109015]) ≡ "ok|人工智能"
    }
    test "merge application and single-byte fallback compose on a minor corpus" {
        assert _encoda_resultum(_corpus_minor(), "abc") ≡ "ok|0,1,2"
        assert _encoda_resultum(_corpus_minor(), "ab") ≡ "ok|0,1"
        assert _decoda_resultum(_corpus_minor(), [0, 1, 2]) ≡ "ok|abc"
    }
    test "unknown and out-of-range ids fail with typed errors" {
        assert _decoda_resultum(_corpus_minor(), [5]) ≡ "ERR|token id outside the vocabulary range: 5"
        assert _decoda_resultum(_corpus_minor(), [-1]) ≡ "ERR|token id outside the vocabulary range: -1"
    }
    test "unmappable display characters fail with a typed error" {
        assert _decoda_resultum(_corpus_minor(), [3]) ≡ "ERR|display character has no byte mapping (codepoint 9731)"
    }
    test "invalid UTF-8 decode output fails with a typed error" {
        assert _decoda_resultum(_corpus_minor(), [4]) ≡ "ERR|decoded byte sequence is not valid UTF-8"
    }
    test "malformed merge entries fail closed at construction" {
        assert _encoda_resultum(_corpus_merges_mala(), "a") ≡ "ERR|malformed merge entry: ab"
    }
    test "the runtime rejects a manifest that is not byte-level BPE" {
        assert _encoda_resultum(_corpus_llama(), "a") ≡ "ERR|tokenizer runtime is byte-level BPE; manifest declares: llama"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-1 — Unicode-category tables + predicates (scanner data).
#
# The qwen35 pre-tokenizer regex classes (\p{L} / \p{M} / \p{N} / \s /
# CR+LF — llama-vocab.cpp LLAMA_VOCAB_PRE_TYPE_QWEN35) expressed as the
# bounded codepoint-range tables + predicates that resolve the delivery's
# open question 1 (can Fab express the required category tables). The pins
# below classify the codepoints the two probes and the differential rows
# exercise (raw-prompt rows, never through the template).
#
# Category names: littera = \p{L}, signum = \p{M}, numerus = \p{N},
# spatium = \s minus CR/LF, novum_linea = [\r\n], aliud = the rest.
# ---------------------------------------------------------------------------

describe "LIB-02-U3-1 Unicode-category tables + predicates" {
    test "the delivery example rows classify to the pinned categories" {
        assert tokenizator.categoria_nomen("ก") ≡ "littera"
        assert tokenizator.categoria_nomen("า") ≡ "littera"
        assert tokenizator.categoria_nomen("0") ≡ "numerus"
        assert tokenizator.categoria_nomen(" ") ≡ "spatium"
        assert tokenizator.categoria_nomen("\n") ≡ "novum_linea"
        assert tokenizator.categoria_nomen("🎉") ≡ "aliud"
    }
    test "Probe A Thai letters classify as letters" {
        assert tokenizator.categoria_nomen("ก") ≡ "littera"
        assert tokenizator.categoria_nomen("ส") ≡ "littera"
        assert tokenizator.categoria_nomen("ว") ≡ "littera"
        assert tokenizator.categoria_nomen("ด") ≡ "littera"
        assert tokenizator.categoria_nomen("ค") ≡ "littera"
        assert tokenizator.categoria_nomen("ร") ≡ "littera"
        assert tokenizator.categoria_nomen("บ") ≡ "littera"
        assert tokenizator.categoria_nomen("ผ") ≡ "littera"
        assert tokenizator.categoria_nomen("ม") ≡ "littera"
        assert tokenizator.categoria_nomen("ช") ≡ "littera"
        assert tokenizator.categoria_nomen("อ") ≡ "littera"
        assert tokenizator.categoria_nomen("เ") ≡ "littera"
        assert tokenizator.categoria_nomen("ล") ≡ "littera"
        assert tokenizator.categoria_nomen("ซ") ≡ "littera"
    }
    test "Probe A Thai marks classify as marks" {
        assert tokenizator.categoria_nomen("ั") ≡ "signum"
        assert tokenizator.categoria_nomen("ี") ≡ "signum"
        assert tokenizator.categoria_nomen("ื") ≡ "signum"
        assert tokenizator.categoria_nomen("์") ≡ "signum"
    }
    test "Probe B CJK ideographs classify as letters" {
        assert tokenizator.categoria_nomen("你") ≡ "littera"
        assert tokenizator.categoria_nomen("好") ≡ "littera"
        assert tokenizator.categoria_nomen("世") ≡ "littera"
        assert tokenizator.categoria_nomen("界") ≡ "littera"
        assert tokenizator.categoria_nomen("今") ≡ "littera"
        assert tokenizator.categoria_nomen("天") ≡ "littera"
        assert tokenizator.categoria_nomen("是") ≡ "littera"
        assert tokenizator.categoria_nomen("年") ≡ "littera"
        assert tokenizator.categoria_nomen("月") ≡ "littera"
        assert tokenizator.categoria_nomen("日") ≡ "littera"
        assert tokenizator.categoria_nomen("人") ≡ "littera"
        assert tokenizator.categoria_nomen("工") ≡ "littera"
        assert tokenizator.categoria_nomen("智") ≡ "littera"
        assert tokenizator.categoria_nomen("能") ≡ "littera"
    }
    test "ASCII digits classify as numbers" {
        assert tokenizator.categoria_nomen("0") ≡ "numerus"
        assert tokenizator.categoria_nomen("1") ≡ "numerus"
        assert tokenizator.categoria_nomen("2") ≡ "numerus"
        assert tokenizator.categoria_nomen("3") ≡ "numerus"
        assert tokenizator.categoria_nomen("4") ≡ "numerus"
        assert tokenizator.categoria_nomen("5") ≡ "numerus"
        assert tokenizator.categoria_nomen("6") ≡ "numerus"
        assert tokenizator.categoria_nomen("7") ≡ "numerus"
        assert tokenizator.categoria_nomen("8") ≡ "numerus"
        assert tokenizator.categoria_nomen("9") ≡ "numerus"
    }
    test "whitespace and newline split the regex whitespace class" {
        assert tokenizator.categoria_nomen(" ") ≡ "spatium"
        assert tokenizator.categoria_nomen("\t") ≡ "spatium"
        assert tokenizator.categoria_nomen("\n") ≡ "novum_linea"
        assert tokenizator.categoria_nomen("\r") ≡ "novum_linea"
    }
    test "punctuation, emoji, and fullwidth punctuation classify as other" {
        assert tokenizator.categoria_nomen("🎉") ≡ "aliud"
        assert tokenizator.categoria_nomen("，") ≡ "aliud"
        assert tokenizator.categoria_nomen("！") ≡ "aliud"
        assert tokenizator.categoria_nomen(",") ≡ "aliud"
        assert tokenizator.categoria_nomen(".") ≡ "aliud"
        assert tokenizator.categoria_nomen("!") ≡ "aliud"
        assert tokenizator.categoria_nomen("'") ≡ "aliud"
    }
    test "the predicates agree with the classifier" {
        assert tokenizator.est_littera("ก")
        assert tokenizator.est_signum("ั")
        assert tokenizator.est_numerus("0")
        assert tokenizator.est_spatium(" ")
        assert tokenizator.est_novum_linea("\n")
        assert tokenizator.est_aliud("🎉")
        assert not (tokenizator.est_littera("0"))
        assert not (tokenizator.est_numerus("ก"))
        assert not (tokenizator.est_spatium("\n"))
        assert not (tokenizator.est_novum_linea(" "))
    }
    test "each probe-exercised character belongs to exactly one category" {
        assert not (tokenizator.est_signum("ก"))
        assert not (tokenizator.est_numerus("ก"))
        assert not (tokenizator.est_spatium("ก"))
        assert not (tokenizator.est_novum_linea("ก"))
        assert not (tokenizator.est_aliud("ก"))
        assert not (tokenizator.est_littera("ั"))
        assert not (tokenizator.est_numerus("ั"))
        assert not (tokenizator.est_littera("0"))
        assert not (tokenizator.est_spatium("0"))
        assert not (tokenizator.est_littera(" "))
        assert not (tokenizator.est_novum_linea(" "))
        assert not (tokenizator.est_littera("\n"))
        assert not (tokenizator.est_spatium("\n"))
        assert not (tokenizator.est_littera("🎉"))
        assert not (tokenizator.est_numerus("🎉"))
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-2 — qwen35 word-splitting scanner (core families).
#
# The qwen35 pre-tokenizer (llama-vocab.cpp LLAMA_VOCAB_PRE_TYPE_QWEN35;
# unicode.cpp unicode_regex_split_custom_qwen35, pinned oracle 10150
# `dee2a846b`) splits a prompt into words before the byte-level BPE core.
# This unit pins the CORE content families — letter/mark runs with an
# optional leading non-CR/LF/number char, single numbers, whitespace runs
# (including the trailing-run form) and newline runs. The 10 rows below are
# the delivery's word-boundary / digit / newline differential table: each
# row must split to the pinned words AND encode through scanner + BPE core
# to the exact pinned id list, and decode must round-trip the input.
#
# The fixture corpus is a structural model (same approach as U2): the pinned
# tokens sit at their pinned ids with the exact display strings, and the
# merge table carries exactly the ranked merge pairs the real BPE applies to
# each row word. No artifact bytes are committed. Word lists were derived
# from the pinned scanner; id lists are the delivery differential rows.
# ---------------------------------------------------------------------------

