# chat_template metadata value as text: "ok|<template>" or "ERR|<message>".
fn _chat_template_result(gguf_manifest.GgufCorpus corpus) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tokenizer.Tokenizer t ← tokenizer.build(m)
            return "ok|" + tokenizer.chat_template(t)
        }
        catch err {
            return "ERR|" + tokenizer.message(err)
        }
    }
    catch err {
        return "ERR|" + gguf_manifest.message(err)
    }
}

# Minimal user-turn render as text: "ok|<rendered>" or "ERR|<message>".
fn _render_result(gguf_manifest.GgufCorpus corpus, string content) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tokenizer.Tokenizer t ← tokenizer.build(m)
            return "ok|" + tokenizer.render_user_turn(t, content)
        }
        catch err {
            return "ERR|" + tokenizer.message(err)
        }
    }
    catch err {
        return "ERR|" + gguf_manifest.message(err)
    }
}

# Sublist equality: a[ini .. ini + b.length()) matches b element-wise.
fn _sublist_equal(list<int> a, int ini, list<int> b) → bool {
    if ini + b.length() ≻ a.length() then return false
    var int i ← 0
    while i ≺ b.length() {
        if (a.get(ini + i) coalesce 0) ≠ (b.get(i) coalesce 0) then return false
        i ← i + 1
    }
    return true
}

describe "LIB-02-U3-6 chat-template policy (metadata + minimal user-turn)" {
    test "tokenizer.chat_template loads from the artifact metadata" {
        assert _chat_template_result(_corpus_chat()) ≡ "ok|" + F_TEMPLATE
    }
    test "the minimal user-turn render applies the pinned ChatML shape" {
        assert _render_result(_corpus_chat(), PROBE_B) ≡ "ok|<|im_start|>user\n你好，世界！今天是2026年8月13日 🎉<|im_end|>\n"
    }
    test "the rendered user turn encodes to the exact pinned ids (R1, parse-special on)" {
        assert _encode_prompt_special_result(_corpus_chat(), ("<|im_start|>user\n" + PROBE_B) + "<|im_end|>\n") ≡ "ok|" + PINNED_U3_6_R1
    }
    test "the rendered user turn encodes to the exact pinned ids (R1b, no-parse-special literal)" {
        assert _encode_prompt_result(_corpus_chat(), ("<|im_start|>user\n" + PROBE_B) + "<|im_end|>\n") ≡ "ok|" + PINNED_U3_6_R1B
    }
    test "the assistant turn prefix encodes to the exact pinned ids (R2)" {
        assert _encode_prompt_special_result(_corpus_chat_assistant(), "<|im_start|>assistant\n") ≡ "ok|" + PINNED_U3_6_R2
    }
    test "the ChatML path composes without changing the pinned Probe B ids" {
        const string r ← _encode_prompt_special_result(_corpus_chat(), ("<|im_start|>user\n" + PROBE_B) + "<|im_end|>\n")
        assert r ≡ "ok|" + PINNED_U3_6_R1
        do {
            const list<int> ids ← tokenizer.probe_id(r.slice(3, r.length()))
            const list<int> probe_b ← tokenizer.probe_id(PINNED_U3_6_PROBE_B)
            assert ids.length() ≡ 23
            assert (ids.get(0) coalesce 0) ≡ 248045
            assert (ids.get(1) coalesce 0) ≡ 846
            assert (ids.get(2) coalesce 0) ≡ 198
            assert (ids.get(21) coalesce 0) ≡ 248046
            assert (ids.get(22) coalesce 0) ≡ 198
            assert _sublist_equal(ids, 3, probe_b)
        }
        catch err {
            assert false
        }
    }
    test "an artifact without a chat template fails the render closed (no hard-coded fallback)" {
        assert _chat_template_result(_corpus_minor()) ≡ "ok|"
        assert _render_result(_corpus_minor(), "x") ≡ "ERR|artifact declares no chat template"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-7 — Full two-probe composition + divergence receipts.
#
# The complete composed runtime (qwen35 scanner + BPE core + special policy +
# EOG/BOS + chat policy, LIB-02-U3-1..U3-6) encodes Probe A and Probe B to
# the exact pinned id lists and decodes them back to the exact prompts. Probe
# rows are raw-prompt rows, never through the template (the rendered-turn
# path is proven separately by U3-6's R1/R1b/R2 rows). Probe A runs on its
# own structural fixture (pinned tokens at their pinned ids, the exact ranked
# merge pairs the real BPE applies, re-derived against oracle 10150
# `dee2a846b` on the target artifact); Probe B reuses the U3-6 chat fixture
# whose words already sit at the pinned ids. Divergence receipts (fixture
# doc `fixtures/tokenizer/pinned-probe-oracle.md`) name the first divergent
# probe id or decoded character and route the repair (campaign rule 5).
# ---------------------------------------------------------------------------

