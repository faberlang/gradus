# scanna_verba outcome as textus: "ok|<word>|<word>|..." or "ERR|<causa>".
fn _scanna_resultum(string textum) → string {
    do {
        const list<string> verba ← tokenizator.scanna_verba(textum)
        var string out ← "ok"
        for from verba const verbum {
            out ← (out + "|") + verbum
        }
        return out
    }
    catch err {
        return "ERR|" + tokenizator.causa(err)
    }
}

# Full-prompt encode (scanner + BPE core) as textus: "ok|<ids>" or "ERR|<causa>".
fn _encoda_promptum_resultum(manifestum.CorpusGguf corpus, string textum) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            const list<int> ids ← tokenizator.encoda_promptum(t, textum)
            var string out ← ""
            var int i ← 0
            while i ≺ ids.longitudo() {
                if i ≻ 0 then out ← out + ","
                out ← out + (ids.accipe(i) coalesce 0 ↦ string)
                i ← i + 1
            }
            return "ok|" + out
        }
        catch err {
            return "ERR|" + tokenizator.causa(err)
        }
    }
    catch err {
        return "ERR|" + manifestum.causa(err)
    }
}

# Full-prompt round-trip as textus: "ok|<decoded text>" or "ERR|<causa>".
fn _decoda_plena(manifestum.CorpusGguf corpus, string textum) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            const list<int> ids ← tokenizator.encoda_promptum(t, textum)
            return "ok|" + tokenizator.decoda(t, ids)
        }
        catch err {
            return "ERR|" + tokenizator.causa(err)
        }
    }
    catch err {
        return "ERR|" + manifestum.causa(err)
    }
}

describe "LIB-02-U3-2 qwen35 word-splitting scanner (core families)" {
    test "the scanner splits each word-boundary / digit / newline row to the pinned words" {
        assert _scanna_resultum("transformers สวัสดี 人工智能") ≡ "ok|transformers| สวัสดี| 人工智能"
        assert _scanna_resultum("transformers  สวัสดี") ≡ "ok|transformers| | สวัสดี"
        assert _scanna_resultum(" 你好") ≡ "ok| 你好"
        assert _scanna_resultum("你好 ") ≡ "ok|你好| "
        assert _scanna_resultum("a   b") ≡ "ok|a|  | b"
        assert _scanna_resultum("2026") ≡ "ok|2|0|2|6"
        assert _scanna_resultum("123") ≡ "ok|1|2|3"
        assert _scanna_resultum("a\nb") ≡ "ok|a|\n|b"
        assert _scanna_resultum("a\n\nb") ≡ "ok|a|\n\n|b"
        assert _scanna_resultum("a\tb") ≡ "ok|a|\tb"
    }
    test "whitespace and newline family edges mirror the reference scanner" {
        assert _scanna_resultum("a  b") ≡ "ok|a| | b"
        assert _scanna_resultum("a \nb") ≡ "ok|a| \n| b"
        assert _scanna_resultum("a \n") ≡ "ok|a| \n"
        assert _scanna_resultum("\n a") ≡ "ok|\n| a"
        assert _scanna_resultum("a  \nb") ≡ "ok|a|  \n|b"
        assert _scanna_resultum("a  ") ≡ "ok|a|  "
    }
    test "each word-boundary / digit / newline row encodes to its exact pinned ids" {
        assert _encoda_promptum_resultum(_corpus_scanner(), "transformers สวัสดี 人工智能") ≡ "ok|" + PINNATA_U3_2_R1
        assert _encoda_promptum_resultum(_corpus_scanner(), "transformers  สวัสดี") ≡ "ok|" + PINNATA_U3_2_R2
        assert _encoda_promptum_resultum(_corpus_scanner(), " 你好") ≡ "ok|" + PINNATA_U3_2_R3
        assert _encoda_promptum_resultum(_corpus_scanner(), "你好 ") ≡ "ok|" + PINNATA_U3_2_R4
        assert _encoda_promptum_resultum(_corpus_scanner(), "a   b") ≡ "ok|" + PINNATA_U3_2_R5
        assert _encoda_promptum_resultum(_corpus_scanner(), "2026") ≡ "ok|" + PINNATA_U3_2_R6
        assert _encoda_promptum_resultum(_corpus_scanner(), "123") ≡ "ok|" + PINNATA_U3_2_R7
        assert _encoda_promptum_resultum(_corpus_scanner(), "a\nb") ≡ "ok|" + PINNATA_U3_2_R8
        assert _encoda_promptum_resultum(_corpus_scanner(), "a\n\nb") ≡ "ok|" + PINNATA_U3_2_R9
        assert _encoda_promptum_resultum(_corpus_scanner(), "a\tb") ≡ "ok|" + PINNATA_U3_2_R10
    }
    test "decode round-trips each row through the scanner + BPE core" {
        assert _decoda_plena(_corpus_scanner(), "transformers สวัสดี 人工智能") ≡ "ok|transformers สวัสดี 人工智能"
        assert _decoda_plena(_corpus_scanner(), "transformers  สวัสดี") ≡ "ok|transformers  สวัสดี"
        assert _decoda_plena(_corpus_scanner(), " 你好") ≡ "ok| 你好"
        assert _decoda_plena(_corpus_scanner(), "你好 ") ≡ "ok|你好 "
        assert _decoda_plena(_corpus_scanner(), "a   b") ≡ "ok|a   b"
        assert _decoda_plena(_corpus_scanner(), "2026") ≡ "ok|2026"
        assert _decoda_plena(_corpus_scanner(), "123") ≡ "ok|123"
        assert _decoda_plena(_corpus_scanner(), "a\nb") ≡ "ok|a\nb"
        assert _decoda_plena(_corpus_scanner(), "a\n\nb") ≡ "ok|a\n\nb"
        assert _decoda_plena(_corpus_scanner(), "a\tb") ≡ "ok|a\tb"
    }
    test "a character no core family matches falls to a single-word fallthrough" {
        assert _scanna_resultum("🎉") ≡ "ok|🎉"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-3 — qwen35 scanner edge families (punct/emoji/contractions).
#
# The remaining qwen35 regex families composed into the same scanner
# (unicode.cpp unicode_regex_split_custom_qwen35; llama-vocab.cpp
# LLAMA_VOCAB_PRE_TYPE_QWEN35, oracle 10150 `dee2a846b`):
#   * contraction family — (?i:'s|'t|'re|'ve|'m|'ll|'d), matched first,
#   * punctuation/emoji/other runs — ?[^\s\p{L}\p{M}\p{N}]+[\r\n]* with an
#     optional leading literal space and all trailing CR/LF.
# The 7 rows below are the delivery's punctuation/emoji/contraction
# differential table: each row must split to the pinned words AND encode
# through scanner + BPE core to the exact pinned id list, and decode must
# round-trip the input. The family-edge split pins (E1–E5) pin the new
# arms' semantics directly (run grouping, trailing-newline consumption,
# leading-space join, contraction precedence over the letter-run leading
# char, case-insensitive contractions).
#
# The fixture corpus is a structural model (same approach as U2/U3-2): the
# pinned tokens sit at their pinned ids with the exact display strings, and
# the merge table carries exactly the ranked merge pairs the real BPE
# applies to each row word. No artifact bytes are committed.
# ---------------------------------------------------------------------------

