    return [60, 124, 105, 109, 95, 115, 116, 97, 114, 116, 124, 62, 117, 115, 101, 114, 10, 123, 123, 32, 99, 111, 110, 116, 101, 110, 116, 32, 125, 125, 60, 124, 105, 109, 95, 101, 110, 100, 124, 62, 10]
}

fn _corpus_chat() → manifestum.CorpusGguf {
    var list<int<u8>> table ← _iunge(_iunge([71, 71, 85, 70], _u32(3)), _iunge(_u64(0), _u64(5)))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 111, 100, 101, 108], 8, _elementum([103, 112, 116, 50])))
