# Minor fixture for the typed-error and fallback paths: vocab "a","b","c"
# plus an unmappable display char (☃ U+2603) and a lone 0xC3 byte token
# ("Ã" — invalid UTF-8 on its own); one merge "a b".
fn _corpus_minor() → gguf_manifest.GgufCorpus {
    const list<int<u8>> tokens ← _join(_elementum([97]), _join(_elementum([98]), _join(_elementum([99]), _join(_elementum([226, 152, 131]), _elementum([195, 131])))))
    const list<int<u8>> merges ← _elementum([97, 32, 98])
    return _corpus_binae([103, 112, 116, 50], tokens, 5, merges, 1)
}

# A malformed merge entry (no space separator) must fail closed.
fn _corpus_bad_merges() → gguf_manifest.GgufCorpus {
    const list<int<u8>> tokens ← _elementum([97])
    const list<int<u8>> merges ← _elementum([97, 98])
    return _corpus_binae([103, 112, 116, 50], tokens, 1, merges, 1)
}

# A non-byte-level model declaration must fail the capability check.
fn _corpus_llama() → gguf_manifest.GgufCorpus {
    const list<int<u8>> tokens ← _elementum([97])
    const list<int<u8>> merges ← _elementum([97, 32, 98])
    return _corpus_binae([108, 108, 97, 109, 97], tokens, 1, merges, 1)
}

# Encode a word through the artifact-backed runtime, rendering "ok|<ids>"
# or "ERR|<message>".
fn _encode_result(gguf_manifest.GgufCorpus corpus, string word) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tokenizer.Tokenizer t ← tokenizer.build(m)
            const list<int> ids ← tokenizer.encode(t, word)
            var string out ← ""
            var int i ← 0
            while i ≺ ids.length() {
                if i ≻ 0 then out ← out + ","
                out ← out + (ids.get(i) coalesce 0 ↦ string)
                i ↑
            }
            return "ok|" + out
        }
        catch err {
            return "ERR|" + tokenizer.message(err)
        }
    }
    catch err {
        return "ERR|" + gguf_manifest.message(err)
    }
}

# Decode an id list through the artifact-backed runtime, rendering "ok|text"
# or "ERR|<message>".
fn _decode_result(gguf_manifest.GgufCorpus corpus, list<int> ids) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tokenizer.Tokenizer t ← tokenizer.build(m)
            return "ok|" + tokenizer.decode(t, ids)
        }
        catch err {
            return "ERR|" + tokenizer.message(err)
        }
    }
    catch err {
        return "ERR|" + gguf_manifest.message(err)
    }
}

describe "LIB-02-U2 artifact-backed byte-level BPE core" {
    test "the three word-level oracle rows encode to the exact pinned ids" {
        assert _encode_result(_corpus_principalis(), "transformers") ≡ "ok|" + PINNED_U2_A
        assert _encode_result(_corpus_principalis(), "สวัสดี") ≡ "ok|" + PINNED_U2_B
        assert _encode_result(_corpus_principalis(), "人工智能") ≡ "ok|" + PINNED_U2_C
    }
    test "decode of each pinned id list reproduces the exact input text" {
        assert _decode_result(_corpus_principalis(), [4549, 382]) ≡ "ok|transformers"
        assert _decode_result(_corpus_principalis(), [34469, 168607]) ≡ "ok|สวัสดี"
        assert _decode_result(_corpus_principalis(), [109015]) ≡ "ok|人工智能"
    }
    test "merge application and single-byte fallback compose on a minor corpus" {
        assert _encode_result(_corpus_minor(), "abc") ≡ "ok|0,1,2"
        assert _encode_result(_corpus_minor(), "ab") ≡ "ok|0,1"
        assert _decode_result(_corpus_minor(), [0, 1, 2]) ≡ "ok|abc"
    }
    test "unknown and out-of-range ids fail with typed errors" {
        assert _decode_result(_corpus_minor(), [5]) ≡ "ERR|token id outside the vocabulary range: 5"
        assert _decode_result(_corpus_minor(), [-1]) ≡ "ERR|token id outside the vocabulary range: -1"
    }
    test "unmappable display characters fail with a typed error" {
        assert _decode_result(_corpus_minor(), [3]) ≡ "ERR|display character has no byte mapping (codepoint 9731)"
    }
    test "invalid UTF-8 decode output fails with a typed error" {
        assert _decode_result(_corpus_minor(), [4]) ≡ "ERR|decoded byte sequence is not valid UTF-8"
    }
    test "malformed merge entries fail closed at construction" {
        assert _encode_result(_corpus_bad_merges(), "a") ≡ "ERR|malformed merge entry: ab"
    }
    test "the runtime rejects a manifest that is not byte-level BPE" {
        assert _encode_result(_corpus_llama(), "a") ≡ "ERR|tokenizer runtime is byte-level BPE; manifest declares: llama"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-1 — Unicode-category tables + predicates (scanner data).
#
# The qwen35 pre-tokenizer regex classes (\p{L} / \p{M} / \p{N} / \s /
# CR+LF — llama-vocab.cpp LLAMA_VOCAB_PRE_TYPE_QWEN35) expressed as the
# bounded codepoint-range tables + predicates that resolve the delivery's
# open question 1 (can Fab express the required category tables). The pins
# below classify the codepoints the two probes and the differential rows
# exercise (raw-prompt rows, never through the template).
#
# Category identifiers: Letter = \p{L}, Signum = \p{M}, Number = \p{N},
# Space = \s minus CR/LF, Newline = [\r\n], Other = the rest.
# Wire names (OQ3 pin): "littera", "signum", "numerus", "spatium",
# "novum_linea", "aliud".
# ---------------------------------------------------------------------------

describe "LIB-02-U3-1 Unicode-category tables + predicates" {
    test "the delivery example rows classify to the pinned categories" {
        assert tokenizer.category_name("ก") ≡ "littera"
        assert tokenizer.category_name("า") ≡ "littera"
        assert tokenizer.category_name("0") ≡ "numerus"
        assert tokenizer.category_name(" ") ≡ "spatium"
        assert tokenizer.category_name("\n") ≡ "novum_linea"
        assert tokenizer.category_name("🎉") ≡ "aliud"
    }
    test "Probe A Thai letters classify as letters" {
        assert tokenizer.category_name("ก") ≡ "littera"
        assert tokenizer.category_name("ส") ≡ "littera"
        assert tokenizer.category_name("ว") ≡ "littera"
        assert tokenizer.category_name("ด") ≡ "littera"
        assert tokenizer.category_name("ค") ≡ "littera"
        assert tokenizer.category_name("ร") ≡ "littera"
        assert tokenizer.category_name("บ") ≡ "littera"
        assert tokenizer.category_name("ผ") ≡ "littera"
        assert tokenizer.category_name("ม") ≡ "littera"
        assert tokenizer.category_name("ช") ≡ "littera"
        assert tokenizer.category_name("อ") ≡ "littera"
        assert tokenizer.category_name("เ") ≡ "littera"
        assert tokenizer.category_name("ล") ≡ "littera"
        assert tokenizer.category_name("ซ") ≡ "littera"
    }
    test "Probe A Thai marks classify as marks" {
        assert tokenizer.category_name("ั") ≡ "signum"
        assert tokenizer.category_name("ี") ≡ "signum"
        assert tokenizer.category_name("ื") ≡ "signum"
        assert tokenizer.category_name("์") ≡ "signum"
    }
    test "Probe B CJK ideographs classify as letters" {
        assert tokenizer.category_name("你") ≡ "littera"
        assert tokenizer.category_name("好") ≡ "littera"
        assert tokenizer.category_name("世") ≡ "littera"
        assert tokenizer.category_name("界") ≡ "littera"
        assert tokenizer.category_name("今") ≡ "littera"
        assert tokenizer.category_name("天") ≡ "littera"
        assert tokenizer.category_name("是") ≡ "littera"
        assert tokenizer.category_name("年") ≡ "littera"
        assert tokenizer.category_name("月") ≡ "littera"
        assert tokenizer.category_name("日") ≡ "littera"
        assert tokenizer.category_name("人") ≡ "littera"
        assert tokenizer.category_name("工") ≡ "littera"
        assert tokenizer.category_name("智") ≡ "littera"
        assert tokenizer.category_name("能") ≡ "littera"
    }
    test "ASCII digits classify as numbers" {
        assert tokenizer.category_name("0") ≡ "numerus"
        assert tokenizer.category_name("1") ≡ "numerus"
        assert tokenizer.category_name("2") ≡ "numerus"
        assert tokenizer.category_name("3") ≡ "numerus"
        assert tokenizer.category_name("4") ≡ "numerus"
        assert tokenizer.category_name("5") ≡ "numerus"
        assert tokenizer.category_name("6") ≡ "numerus"
        assert tokenizer.category_name("7") ≡ "numerus"
        assert tokenizer.category_name("8") ≡ "numerus"
        assert tokenizer.category_name("9") ≡ "numerus"
    }
    test "whitespace and newline split the regex whitespace class" {
        assert tokenizer.category_name(" ") ≡ "spatium"
        assert tokenizer.category_name("\t") ≡ "spatium"
        assert tokenizer.category_name("\n") ≡ "novum_linea"
        assert tokenizer.category_name("\r") ≡ "novum_linea"
    }
    test "punctuation, emoji, and fullwidth punctuation classify as other" {
        assert tokenizer.category_name("🎉") ≡ "aliud"
        assert tokenizer.category_name("，") ≡ "aliud"
        assert tokenizer.category_name("！") ≡ "aliud"
        assert tokenizer.category_name(",") ≡ "aliud"
        assert tokenizer.category_name(".") ≡ "aliud"
        assert tokenizer.category_name("!") ≡ "aliud"
        assert tokenizer.category_name("'") ≡ "aliud"
    }
    test "the predicates agree with the classifier" {
        assert tokenizer.is_letter("ก")
        assert tokenizer.is_symbol("ั")
        assert tokenizer.is_number("0")
        assert tokenizer.is_space(" ")
        assert tokenizer.is_newline("\n")
        assert tokenizer.is_other("🎉")
        assert not (tokenizer.is_letter("0"))
        assert not (tokenizer.is_number("ก"))
        assert not (tokenizer.is_space("\n"))
        assert not (tokenizer.is_newline(" "))
    }
    test "each probe-exercised character belongs to exactly one category" {
        assert not (tokenizer.is_symbol("ก"))
        assert not (tokenizer.is_number("ก"))
        assert not (tokenizer.is_space("ก"))
        assert not (tokenizer.is_newline("ก"))
        assert not (tokenizer.is_other("ก"))
        assert not (tokenizer.is_letter("ั"))
        assert not (tokenizer.is_number("ั"))
        assert not (tokenizer.is_letter("0"))
        assert not (tokenizer.is_space("0"))
        assert not (tokenizer.is_letter(" "))
        assert not (tokenizer.is_newline(" "))
        assert not (tokenizer.is_letter("\n"))
        assert not (tokenizer.is_space("\n"))
        assert not (tokenizer.is_letter("🎉"))
        assert not (tokenizer.is_number("🎉"))
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-2 — qwen35 word-splitting scanner (core families).
#
# The qwen35 pre-tokenizer (llama-vocab.cpp LLAMA_VOCAB_PRE_TYPE_QWEN35;
# unicode.cpp unicode_regex_split_custom_qwen35, pinned oracle 10150
# `dee2a846b`) splits a prompt into words before the byte-level BPE core.
# This unit pins the CORE content families — letter/mark runs with an
# optional leading non-CR/LF/number char, single numbers, whitespace runs
# (including the trailing-run form) and newline runs. The 10 rows below are
# the delivery's word-boundary / digit / newline differential table: each
# row must split to the pinned words AND encode through scanner + BPE core
# to the exact pinned id list, and decode must round-trip the input.
#
# The fixture corpus is a structural model (same approach as U2): the pinned
# tokens sit at their pinned ids with the exact display strings, and the
# merge table carries exactly the ranked merge pairs the real BPE applies to
# each row word. No artifact bytes are committed. Word lists were derived
# from the pinned scanner; id lists are the delivery differential rows.
# ---------------------------------------------------------------------------

