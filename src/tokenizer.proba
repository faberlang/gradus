probandum "LIB-02-U3-3 qwen35 scanner edge families (punct/emoji/contractions)" {
    proba "the scanner splits each edge row to the pinned words" {
        adfirma _scanna_resultum("hello, world!") ≡ "ok|hello|,| world|!"
        adfirma _scanna_resultum("🎉🎉") ≡ "ok|🎉🎉"
        adfirma _scanna_resultum("!hello") ≡ "ok|!hello"
        adfirma _scanna_resultum("don't") ≡ "ok|don|'t"
        adfirma _scanna_resultum("it's") ≡ "ok|it|'s"
        adfirma _scanna_resultum("I'm") ≡ "ok|I|'m"
        adfirma _scanna_resultum("you've") ≡ "ok|you|'ve"
    }

    proba "punct/emoji runs group with an optional leading space" {
        adfirma _scanna_resultum("hello!!") ≡ "ok|hello|!!"
        adfirma _scanna_resultum("a,!\n") ≡ "ok|a|,!\n"
        adfirma _scanna_resultum("x  ,") ≡ "ok|x| | ,"
        adfirma _scanna_resultum("  ,") ≡ "ok| | ,"
    }

    proba "the contraction family wins over the letter-run leading char" {
        adfirma _scanna_resultum("don'ts") ≡ "ok|don|'t|s"
        adfirma _scanna_resultum("it'sx") ≡ "ok|it|'s|x"
        adfirma _scanna_resultum("DON'T") ≡ "ok|DON|'T"
        adfirma _scanna_resultum("I'VE") ≡ "ok|I|'VE"
    }

    proba "each edge row encodes to its exact pinned ids" {
        adfirma _encoda_promptum_resultum(_corpus_scanner_edges(), "hello, world!") ≡ "ok|" + PINNATA_U3_3_P1
        adfirma _encoda_promptum_resultum(_corpus_scanner_edges(), "🎉🎉") ≡ "ok|" + PINNATA_U3_3_P2
        adfirma _encoda_promptum_resultum(_corpus_scanner_edges(), "!hello") ≡ "ok|" + PINNATA_U3_3_P3
        adfirma _encoda_promptum_resultum(_corpus_scanner_edges(), "don't") ≡ "ok|" + PINNATA_U3_3_C1
        adfirma _encoda_promptum_resultum(_corpus_scanner_edges(), "it's") ≡ "ok|" + PINNATA_U3_3_C2
        adfirma _encoda_promptum_resultum(_corpus_scanner_edges(), "I'm") ≡ "ok|" + PINNATA_U3_3_C3
        adfirma _encoda_promptum_resultum(_corpus_scanner_edges(), "you've") ≡ "ok|" + PINNATA_U3_3_C4
    }

    proba "decode round-trips each edge row through the scanner + BPE core" {
        adfirma _decoda_plena(_corpus_scanner_edges(), "hello, world!") ≡ "ok|hello, world!"
        adfirma _decoda_plena(_corpus_scanner_edges(), "🎉🎉") ≡ "ok|🎉🎉"
        adfirma _decoda_plena(_corpus_scanner_edges(), "!hello") ≡ "ok|!hello"
        adfirma _decoda_plena(_corpus_scanner_edges(), "don't") ≡ "ok|don't"
        adfirma _decoda_plena(_corpus_scanner_edges(), "it's") ≡ "ok|it's"
        adfirma _decoda_plena(_corpus_scanner_edges(), "I'm") ≡ "ok|I'm"
        adfirma _decoda_plena(_corpus_scanner_edges(), "you've") ≡ "ok|you've"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-4 — Special-token policy (parse on/off + embedded).
#
# The artifact's special cache (derived from `tokenizer.ggml.token_type` —
# every non-NORMAL entry, the llama.cpp llama_vocab::init_special rule) drives
# parse-special on/off: specials inside text resolve to their single ids when
# parsed (`encoda_promptum_specialia`), and to literal BPE bytes when
# parse_special = falsum (`encoda_promptum`), including embedded specials.
# The 8 rows below are the delivery's special-token probes:
#   <|im_start|>  -> [248045] parsed / [27, 91, 316, 4747, 91, 29] literal
#   <|im_end|>    -> [248046] parsed / [27, 91, 316, 6018, 91, 29] literal
#   <|endoftext|> -> [248044] parsed / [27, 91, 8426, 703, 419, 91, 29] literal
#   a<|im_end|>b  -> [64, 248046, 65] parsed / [64, 27, 91, 316, 6018, 91, 29, 65] literal
# The scanner splits the literal forms as <| im _start |> (and <| im _end |>
# / <| endoftext |> / a <| im _end |> b — the letter-run arm absorbs the
# leading underscore), so the literal rows exercise the same families as
# U3-2/U3-3.
#
# The fixture corpus is a structural model (same approach as U2/U3-2/U3-3):
# the pinned tokens sit at their pinned ids with the exact display strings,
# the token_type array marks exactly the three specials CONTROL (3), and the
# merge table carries exactly the ranked merge pairs the real BPE applies to
# each row word. No artifact bytes are committed.
# ---------------------------------------------------------------------------

fixum textus PINNATA_U3_4_A ← "248045"
fixum textus PINNATA_U3_4_B ← "27,91,316,4747,91,29"
fixum textus PINNATA_U3_4_C ← "248046"
fixum textus PINNATA_U3_4_D ← "27,91,316,6018,91,29"
fixum textus PINNATA_U3_4_E ← "248044"
fixum textus PINNATA_U3_4_F ← "27,91,8426,703,419,91,29"
fixum textus PINNATA_U3_4_G ← "64,248046,65"
fixum textus PINNATA_U3_4_H ← "64,27,91,316,6018,91,29,65"

# Repeat one u32 value `count` times (the token_type fixture array).
functio _u32_valoris_itera(numerus count, numerus v) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> u ← _u32(v)
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < count {
        itera ex u fixum b { out.appende(b) }
        i ↑
    }
    redde out
}

# Special fixture: pinned tokens at their pinned ids (max id 248046, 248047
# entries) with a "!" placeholder elsewhere. Pinned tokens: 27 "<", 29 ">",
# 64 "a", 65 "b", 91 "|", 316 "im", 419 "text", 703 "of", 4747 "_start",
# 6018 "_end", 8426 "end", and the three specials at 248044 "<|endoftext|>",
# 248045 "<|im_start|>", 248046 "<|im_end|>".
functio _specialia_tokens() → lista<numerus<u8>> {
    fixum lista<numerus<u8>> ding ← _elementum([33])
    varia lista<numerus<u8>> tokens ← _stringarum_itera(27, ding)
    tokens ← _iunge(tokens, _elementum([60]))
    tokens ← _iunge(tokens, _stringarum_itera(1, ding))
    tokens ← _iunge(tokens, _elementum([62]))
    tokens ← _iunge(tokens, _stringarum_itera(34, ding))
    tokens ← _iunge(tokens, _elementum([97]))
    tokens ← _iunge(tokens, _elementum([98]))
    tokens ← _iunge(tokens, _stringarum_itera(25, ding))
    tokens ← _iunge(tokens, _elementum([124]))
    tokens ← _iunge(tokens, _stringarum_itera(224, ding))
    tokens ← _iunge(tokens, _elementum([105, 109]))
    tokens ← _iunge(tokens, _stringarum_itera(102, ding))
    tokens ← _iunge(tokens, _elementum([116, 101, 120, 116]))
    tokens ← _iunge(tokens, _stringarum_itera(283, ding))
    tokens ← _iunge(tokens, _elementum([111, 102]))
    tokens ← _iunge(tokens, _stringarum_itera(4043, ding))
    tokens ← _iunge(tokens, _elementum([95, 115, 116, 97, 114, 116]))
    tokens ← _iunge(tokens, _stringarum_itera(1270, ding))
    tokens ← _iunge(tokens, _elementum([95, 101, 110, 100]))
    tokens ← _iunge(tokens, _stringarum_itera(2407, ding))
    tokens ← _iunge(tokens, _elementum([101, 110, 100]))
    tokens ← _iunge(tokens, _stringarum_itera(239617, ding))
    tokens ← _iunge(tokens, _elementum([60, 124, 101, 110, 100, 111, 102, 116, 101, 120, 116, 124, 62]))
    tokens ← _iunge(tokens, _elementum([60, 124, 105, 109, 95, 115, 116, 97, 114, 116, 124, 62]))
    tokens ← _iunge(tokens, _elementum([60, 124, 105, 109, 95, 101, 110, 100, 124, 62]))
    redde tokens
}

# token_type fixture: NORMAL (1) everywhere, CONTROL (3) at the three
# special ids (248044..248046).
functio _specialia_typi() → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← _u32_valoris_itera(248044, 1)
    out ← _iunge(out, _u32(3))
    out ← _iunge(out, _u32(3))
    out ← _iunge(out, _u32(3))
    redde out
}

# The 13 ranked merge pairs the literal BPE applies to the probe words.
functio _specialia_merges() → lista<numerus<u8>> {
    varia lista<numerus<u8>> merges ← _elementum([105, 32, 109])
    merges ← _iunge(merges, _elementum([115, 32, 116]))
    merges ← _iunge(merges, _elementum([115, 116, 32, 97]))
    merges ← _iunge(merges, _elementum([115, 116, 97, 32, 114]))
    merges ← _iunge(merges, _elementum([115, 116, 97, 114, 32, 116]))
    merges ← _iunge(merges, _elementum([95, 32, 115, 116, 97, 114, 116]))
    merges ← _iunge(merges, _elementum([101, 32, 110]))
    merges ← _iunge(merges, _elementum([101, 110, 32, 100]))
    merges ← _iunge(merges, _elementum([95, 32, 101, 110, 100]))
    merges ← _iunge(merges, _elementum([111, 32, 102]))
    merges ← _iunge(merges, _elementum([116, 32, 101]))
    merges ← _iunge(merges, _elementum([116, 101, 32, 120]))
    merges ← _iunge(merges, _elementum([116, 101, 120, 32, 116]))
    redde merges
}

functio _corpus_specialia() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _iunge(_iunge([0x47, 0x47, 0x55, 0x46], _u32(3)), _iunge(_u64(0), _u64(4)))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 111, 100, 101, 108], 8, _elementum([103, 112, 116, 50])))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115], 9, _array(8, 248047, _specialia_tokens())))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 95, 116, 121, 112, 101], 9, _array(4, 248047, _specialia_typi())))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 101, 114, 103, 101, 115], 9, _array(8, 13, _specialia_merges())))
    redde _plenum(table, 32, 0)
}

# Parse-special-on full-prompt encode as textus: "ok|<ids>" or "ERR|<causa>".
functio _encoda_promptum_specialia_resultum(manifestum.CorpusGguf corpus, textus textum) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            fixum lista<numerus> ids ← tokenizator.encoda_promptum_specialia(t, textum)
            varia textus out ← ""
            varia numerus i ← 0
            dum i < ids.longitudo() {
                si i > 0 ergo out ← out + ","
                out ← out + (ids.accipe(i) vel 0 ↦ textus)
                i ← i + 1
            }
            redde "ok|" + out
        }
        cape err {
            redde "ERR|" + tokenizator.causa(err)
        }
    }
    cape err {
        redde "ERR|" + manifestum.causa(err)
    }
}

probandum "LIB-02-U3-4 special-token policy (parse on/off + embedded)" {
    proba "each special-token probe row encodes to its exact pinned ids" {
        adfirma _encoda_promptum_specialia_resultum(_corpus_specialia(), "<|im_start|>") ≡ "ok|" + PINNATA_U3_4_A
        adfirma _encoda_promptum_resultum(_corpus_specialia(), "<|im_start|>") ≡ "ok|" + PINNATA_U3_4_B
        adfirma _encoda_promptum_specialia_resultum(_corpus_specialia(), "<|im_end|>") ≡ "ok|" + PINNATA_U3_4_C
        adfirma _encoda_promptum_resultum(_corpus_specialia(), "<|im_end|>") ≡ "ok|" + PINNATA_U3_4_D
        adfirma _encoda_promptum_specialia_resultum(_corpus_specialia(), "<|endoftext|>") ≡ "ok|" + PINNATA_U3_4_E
        adfirma _encoda_promptum_resultum(_corpus_specialia(), "<|endoftext|>") ≡ "ok|" + PINNATA_U3_4_F
    }

    proba "embedded specials parse to their single id between the surrounding words" {
        adfirma _encoda_promptum_specialia_resultum(_corpus_specialia(), "a<|im_end|>b") ≡ "ok|" + PINNATA_U3_4_G
        adfirma _encoda_promptum_resultum(_corpus_specialia(), "a<|im_end|>b") ≡ "ok|" + PINNATA_U3_4_H
    }

    proba "parse-special on equals off when the prompt has no specials" {
        adfirma _encoda_promptum_specialia_resultum(_corpus_specialia(), "ab") ≡ _encoda_promptum_resultum(_corpus_specialia(), "ab")
        adfirma _encoda_promptum_specialia_resultum(_corpus_specialia(), "ab") ≡ "ok|64,65"
    }

    proba "decode round-trips the literal rows and the special ids" {
        adfirma _decoda_plena(_corpus_specialia(), "<|im_start|>") ≡ "ok|<|im_start|>"
        adfirma _decoda_plena(_corpus_specialia(), "a<|im_end|>b") ≡ "ok|a<|im_end|>b"
        adfirma _decoda_resultum(_corpus_specialia(), [248045]) ≡ "ok|<|im_start|>"
        adfirma _decoda_resultum(_corpus_specialia(), [248044]) ≡ "ok|<|endoftext|>"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-5 — EOG + BOS-free policy.
#
# The runtime derives the EOG stop set from the artifact exactly like the
# pinned llama.cpp reference (llama-vocab.cpp llm_load_vocab, oracle 10150
# `dee2a846b`): the declared tokenizer.ggml.eos_token_id, every vocab token
# whose text is in the reference EOG name list (<|endoftext|>, <|im_end|>,
# ...), and the FIM pad/rep/sep ids (metadata key first, else the reference
# text-name fallback). For the pinned artifact this yields exactly
# {248044, 248046, 248063, 248064, 248065}. The BOS-free policy honors the
# artifact's tokenizer.ggml.add_bos_token = falsum: encode never prepends a
# BOS, so the empty prompt encodes to [] and "x" to [87].
#
# The fixture corpus mirrors the artifact's shape: "x" at id 87, the five
# EOG tokens at their pinned ids with their exact texts, eos_token_id =
# 248046 and add_bos_token = falsum in the metadata, and no other token
# whose text is an EOG/FIM name. No artifact bytes are committed.
# ---------------------------------------------------------------------------

fixum textus PINNATA_U3_5_X ← "87"
fixum textus PINNATA_U3_5_EOG ← "248044,248046,248063,248064,248065"

# EOG fixture: "x" at id 87, the five EOG tokens at their pinned ids
# (max id 248065 → 248066 entries), "!" placeholder elsewhere. Pinned
# tokens: 87 "x", 248044 "<|endoftext|>", 248046 "<|im_end|>",
# 248063 "<|fim_pad|>", 248064 "<|repo_name|>", 248065 "<|file_sep|>".
functio _eog_tokens() → lista<numerus<u8>> {
    fixum lista<numerus<u8>> ding ← _elementum([33])
    varia lista<numerus<u8>> tokens ← _stringarum_itera(87, ding)
    tokens ← _iunge(tokens, _elementum([120]))
    tokens ← _iunge(tokens, _stringarum_itera(247956, ding))
    tokens ← _iunge(tokens, _elementum([60, 124, 101, 110, 100, 111, 102, 116, 101, 120, 116, 124, 62]))
    tokens ← _iunge(tokens, _elementum([33]))
    tokens ← _iunge(tokens, _elementum([60, 124, 105, 109, 95, 101, 110, 100, 124, 62]))
    tokens ← _iunge(tokens, _stringarum_itera(16, ding))
    tokens ← _iunge(tokens, _elementum([60, 124, 102, 105, 109, 95, 112, 97, 100, 124, 62]))
    tokens ← _iunge(tokens, _elementum([60, 124, 114, 101, 112, 111, 95, 110, 97, 109, 101, 124, 62]))
    tokens ← _iunge(tokens, _elementum([60, 124, 102, 105, 108, 101, 95, 115, 101, 112, 124, 62]))
    redde tokens
}

# token_type fixture: NORMAL (1) everywhere, CONTROL (3) at the five EOG ids.
functio _eog_typi() → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← _u32_valoris_itera(248044, 1)
    out ← _iunge(out, _u32(3))
    out ← _iunge(out, _u32(1))
    out ← _iunge(out, _u32(3))
    out ← _iunge(out, _u32_valoris_itera(16, 1))
    out ← _iunge(out, _u32(3))
    out ← _iunge(out, _u32(3))
    out ← _iunge(out, _u32(3))
    redde out
}

functio _corpus_eog() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _iunge(_iunge([0x47, 0x47, 0x55, 0x46], _u32(3)), _iunge(_u64(0), _u64(6)))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 111, 100, 101, 108], 8, _elementum([103, 112, 116, 50])))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115], 9, _array(8, 248066, _eog_tokens())))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 95, 116, 121, 112, 101], 9, _array(4, 248066, _eog_typi())))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 101, 114, 103, 101, 115], 9, _array(8, 0, [])))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 101, 111, 115, 95, 116, 111, 107, 101, 110, 95, 105, 100], 4, _u32(248046)))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 97, 100, 100, 95, 98, 111, 115, 95, 116, 111, 107, 101, 110], 7, [0 ∷ numerus<u8>]))
    redde _plenum(table, 32, 0)
}

# Runtime EOG set as textus: "ok|<ids>" or "ERR|<causa>".
functio _eog_resultum(manifestum.CorpusGguf corpus) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            fixum lista<numerus> eog ← tokenizator.eog_artificii(t)
            varia textus out ← ""
            varia numerus i ← 0
            dum i < eog.longitudo() {
                si i > 0 ergo out ← out + ","
                out ← out + (eog.accipe(i) vel 0 ↦ textus)
                i ← i + 1
            }
            redde "ok|" + out
        }
        cape err {
            redde "ERR|" + tokenizator.causa(err)
        }
    }
    cape err {
        redde "ERR|" + manifestum.causa(err)
    }
}

# EOG-membership outcome: "ok" when the id is a member, "non" otherwise.
functio _est_eog_resultum(manifestum.CorpusGguf corpus, numerus id) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            si tokenizator.est_eog_artificii(t, id) ergo redde "ok"
            redde "non"
        }
        cape err {
            redde "ERR|" + tokenizator.causa(err)
        }
    }
    cape err {
        redde "ERR|" + manifestum.causa(err)
    }
}

# add_bos outcome: "adds-bos" when verum, "bos-free" when falsum.
functio _add_bos_resultum(manifestum.CorpusGguf corpus) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            si tokenizator.add_bos(t) ergo redde "adds-bos"
            redde "bos-free"
        }
        cape err {
            redde "ERR|" + tokenizator.causa(err)
        }
    }
    cape err {
        redde "ERR|" + manifestum.causa(err)
    }
}

probandum "LIB-02-U3-5 EOG + BOS-free policy" {
    proba "the runtime EOG set is exactly the pinned artifact set" {
        adfirma _eog_resultum(_corpus_eog()) ≡ "ok|" + PINNATA_U3_5_EOG
    }

    proba "EOG membership admits exactly the five pinned ids" {
        adfirma _est_eog_resultum(_corpus_eog(), 248044) ≡ "ok"
        adfirma _est_eog_resultum(_corpus_eog(), 248046) ≡ "ok"
        adfirma _est_eog_resultum(_corpus_eog(), 248063) ≡ "ok"
        adfirma _est_eog_resultum(_corpus_eog(), 248064) ≡ "ok"
        adfirma _est_eog_resultum(_corpus_eog(), 248065) ≡ "ok"
        adfirma _est_eog_resultum(_corpus_eog(), 248045) ≡ "non"
        adfirma _est_eog_resultum(_corpus_eog(), 0) ≡ "non"
        adfirma _est_eog_resultum(_corpus_eog(), 87) ≡ "non"
    }

    proba "encode is BOS-free: empty prompt → empty sequence, x → [87]" {
        adfirma _encoda_promptum_resultum(_corpus_eog(), "") ≡ "ok|"
        adfirma _encoda_promptum_specialia_resultum(_corpus_eog(), "") ≡ "ok|"
        adfirma _encoda_promptum_resultum(_corpus_eog(), "x") ≡ "ok|" + PINNATA_U3_5_X
        adfirma _encoda_promptum_specialia_resultum(_corpus_eog(), "x") ≡ "ok|" + PINNATA_U3_5_X
    }

    proba "the artifact add_bos_token = falsum is honored on the runtime surface" {
        adfirma _add_bos_resultum(_corpus_eog()) ≡ "bos-free"
    }

    proba "an artifact without EOG metadata yields an empty EOG set (no hard-coded fallback)" {
        adfirma _eog_resultum(_corpus_minor()) ≡ "ok|"
        adfirma _est_eog_resultum(_corpus_minor(), 0) ≡ "non"
        adfirma _add_bos_resultum(_corpus_minor()) ≡ "bos-free"
    }
}
