# Co-located package test for tokenizer.fab (PML2-U4 tokenizer identity,
# tokenizer-identity-schema-1.0.0). Not importable; discovered only by the
# faber test path.
#
# Proves, at compile level: the pinned llama.cpp probe fixtures parse to the
# exact pinned id lists (P1–P11 + four workload lists 9/9/202/2175), the
# fail-closed probe-parity admission (verifica_proba: exact match admits,
# any divergence fails closed), the versioned identity record (structa happy
# row + every typed rejection path), self-verification, the KV identity key
# component (MD-A9), and the identity wire round-trip + version rejection.
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
#
# NOTE (pinned fixtures): the id lists are cited read-only from
# evidence/contract-tokenize-probes.txt (P1–P11) and gi0-workloads.md §3
# (workload lists). The 24-case differential vs llama-tokenize 10150 is
# cited read-only from gi1-closeout.md — the runtime owner reproduces it;
# this contract pins the expected ids.

importa ex "./tokenizer" privata tokenizator

# -- pinned-row fixture facts -------------------------------------------------

fixum textus F_SCHEMA ← "1.0.0"
fixum textus F_KIND ← "gpt2"
fixum textus F_PRE ← "smollm"
fixum textus F_VOCAB ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
fixum textus F_ALIA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# -- helpers -------------------------------------------------------------------

# verifica_proba outcome as textus ("ok" or the typed error's causa).
functio proba_result(textus nomen, lista<numerus> observata) → textus {
    fac {
        fixum bivalens ok ← tokenizator.verifica_proba(nomen, observata)
        redde "ok"
    }
    cape err {
        redde tokenizator.causa(err)
    }
}

# structa outcome as textus ("ok" on success, or the typed error's causa).
functio structa_result(
    textus schema,
    textus progenies,
    textus pre_tokenizator,
    textus digestio_vocabuli,
    textus eog,
    bivalens bos_vacua,
    bivalens spatium_vacua
) → textus {
    fac {
        fixum tokenizator.IdentitasTokenizator t ← tokenizator.structa(schema, progenies, pre_tokenizator, digestio_vocabuli, eog, bos_vacua, spatium_vacua)
        redde "ok"
    }
    cape err {
        redde tokenizator.causa(err)
    }
}

# verifica outcome as textus.
functio verifica_result(tokenizator.IdentitasTokenizator t) → textus {
    fac {
        fixum bivalens ok ← tokenizator.verifica(t)
        redde "ok"
    }
    cape err {
        redde tokenizator.causa(err)
    }
}

# clavis outcome as textus ("ok|key" or the typed error's causa).
functio clavis_result(tokenizator.IdentitasTokenizator t) → textus {
    fac {
        fixum textus k ← tokenizator.clavis_tokenizatoris(t)
        redde "ok|" + k
    }
    cape err {
        redde tokenizator.causa(err)
    }
}

# Wire round-trip predicate: deserializa(serializa(t)) reproduces t.
functio wire_roundtrip(tokenizator.IdentitasTokenizator t) → bivalens {
    fac {
        fixum tokenizator.IdentitasTokenizator back ← tokenizator.deserializa_identitas(tokenizator.serializa_identitas(t))
        si back.progenies() ≠ t.progenies() ergo redde falsum
        si back.pre_tokenizator() ≠ t.pre_tokenizator() ergo redde falsum
        si back.digestio_vocabuli() ≠ t.digestio_vocabuli() ergo redde falsum
        si back.eog() ≠ t.eog() ergo redde falsum
        redde verum
    }
    cape err {
        redde falsum
    }
}

# Wire outcome as textus ("ok" or the typed error's causa).
functio wire_result(textus wire) → textus {
    fac {
        fixum tokenizator.IdentitasTokenizator t ← tokenizator.deserializa_identitas(wire)
        redde "ok"
    }
    cape err {
        redde tokenizator.causa(err)
    }
}

# -- pinned probe fixtures (P1–P11, read-only from contract-tokenize-probes.txt) ---

probandum "pinned llama.cpp probe parity" {
    proba "P1 Hello world parses to the pinned ids" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p1"))
            adfirma tokenizator.proba_aequa(ids, [19556, 905])
        }
        cape err {
            adfirma falsum
        }
    }

    proba "P2 equals P1 (BOS-free: no auto-prepend)" {
        fac {
            fixum lista<numerus> a ← tokenizator.proba_ida(tokenizator.pinnata_proba("p1"))
            fixum lista<numerus> b ← tokenizator.proba_ida(tokenizator.pinnata_proba("p2"))
            adfirma tokenizator.proba_aequa(a, b)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "P4 empty prompt stays empty (no BOS)" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p4"))
            adfirma ids.longitudo() ≡ 0
        }
        cape err {
            adfirma falsum
        }
    }

    proba "P5 <|im_start|> parses to BOS special id 1" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p5"))
            adfirma tokenizator.proba_aequa(ids, [1])
        }
        cape err {
            adfirma falsum
        }
    }

    proba "P6 <|im_start|> literal with --no-parse-special (BPE bytes)" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p6"))
            adfirma tokenizator.proba_aequa(ids, [44, 108, 306, 79, 3738, 108, 46])
        }
        cape err {
            adfirma falsum
        }
    }

    proba "P5 vs P6 special-parse on/off parity" {
        fac {
            fixum lista<numerus> on ← tokenizator.proba_ida(tokenizator.pinnata_proba("p5"))
            fixum lista<numerus> off ← tokenizator.proba_ida(tokenizator.pinnata_proba("p6"))
            adfirma non (tokenizator.proba_aequa(on, off))
        }
        cape err {
            adfirma falsum
        }
    }

    proba "P7 <|im_end|> parses to EOS special id 2" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p7"))
            adfirma tokenizator.proba_aequa(ids, [2])
        }
        cape err {
            adfirma falsum
        }
    }

    proba "P8 <|endoftext|> parses to id 0" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p8"))
            adfirma tokenizator.proba_aequa(ids, [0])
        }
        cape err {
            adfirma falsum
        }
    }

    proba "P9 chat-template prefix is the pinned 32 ids" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p9"))
            adfirma ids.longitudo() ≡ 32
            adfirma tokenizator.proba_aequa(ids, [1, 9690, 198, 2683, 359, 253, 5356, 5646, 11173, 3365, 3511, 308, 34519, 28, 7018, 411, 407, 19712, 8182, 2, 198, 1, 4093, 198, 26843, 665, 2, 198, 1, 520, 9531, 198])
        }
        cape err {
            adfirma falsum
        }
    }

    proba "P10 lazy-dog reference is the pinned 9 ids" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p10"))
            adfirma ids.longitudo() ≡ 9
            adfirma tokenizator.proba_aequa(ids, [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767])
        }
        cape err {
            adfirma falsum
        }
    }

    proba "P11 leading spaces is space-prefix-free (pinned 3 ids)" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p11"))
            adfirma ids.longitudo() ≡ 3
            adfirma tokenizator.proba_aequa(ids, [216, 2899, 5600])
        }
        cape err {
            adfirma falsum
        }
    }
}

# -- workload id lists (gi0-workloads.md §3: 9 / 9 / 202 / 2175) ----------------

probandum "pinned workload id lists" {
    proba "correctness workload is the pinned 9 ids" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("correctio"))
            adfirma ids.longitudo() ≡ 9
            adfirma tokenizator.proba_aequa(ids, [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767])
        }
        cape err {
            adfirma falsum
        }
    }

    proba "short workload is the pinned 9 ids" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("brevis"))
            adfirma ids.longitudo() ≡ 9
            adfirma tokenizator.proba_aequa(ids, [19161, 253, 421, 30614, 563, 260, 5065, 30, 198])
        }
        cape err {
            adfirma falsum
        }
    }

    proba "normal workload pins 202 ids and its head/tail match the fixture" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("normale"))
            adfirma ids.longitudo() ≡ 202
            adfirma (ids.accipe(0) vel 0) ≡ 504
            adfirma (ids.accipe(201) vel 0) ≡ 30
        }
        cape err {
            adfirma falsum
        }
    }

    proba "context workload pins 2175 ids and its head/tail match the fixture" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("contextus"))
            adfirma ids.longitudo() ≡ 2175
            adfirma (ids.accipe(0) vel 0) ≡ 54
            adfirma (ids.accipe(2174) vel 0) ≡ 198
        }
        cape err {
            adfirma falsum
        }
    }
}

# -- probe-parity admission (fail-closed) ---------------------------------------

probandum "probe-parity admission" {
    proba "exact id match admits" {
        adfirma proba_result("p10", [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767]) ≡ "ok"
    }

    proba "a diverging id list fails closed as a different tokenizer" {
        adfirma proba_result("p10", [504, 2365, 6354, 16438, 27003, 690, 260, 23790]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p10"
    }

    proba "a reordered id list fails closed (order matters — ids are sequences)" {
        adfirma proba_result("p11", [905, 19556]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p11"
    }

    proba "a length-mismatched id list fails closed" {
        adfirma proba_result("p6", [44, 108, 306, 79, 3738, 108]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p6"
    }

    proba "unknown probe name fails closed" {
        adfirma proba_result("p99", [1]) ≡ "unknown pinned probe: p99"
    }
}

# -- versioned identity record ----------------------------------------------------

probandum "versioned tokenizer identity" {
    proba "structa admits the pinned-row identity" {
        adfirma structa_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", verum, verum) ≡ "ok"
    }

    proba "the identity stamps the schema and carries the pinned facts" {
        fac {
            fixum tokenizator.IdentitasTokenizator t ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", verum, verum)
            adfirma t.schematis() ≡ "1.0.0"
            adfirma t.progenies() ≡ "gpt2"
            adfirma t.pre_tokenizator() ≡ "smollm"
            adfirma t.digestio_vocabuli() ≡ F_VOCAB
            adfirma t.eog() ≡ "0,2"
            adfirma t.bos_vacua()
            adfirma t.spatium_vacua()
        }
        cape err {
            adfirma falsum
        }
    }

    proba "verifica passes on an admitted identity" {
        fac {
            fixum tokenizator.IdentitasTokenizator t ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", verum, verum)
            adfirma verifica_result(t) ≡ "ok"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "rejects an unknown schema version" {
        adfirma structa_result("2.0.0", F_KIND, F_PRE, F_VOCAB, "0,2", verum, verum) ≡ "unknown tokenizer identity schema version: 2.0.0"
    }

    proba "rejects an un-admitted tokenizer kind" {
        adfirma structa_result(F_SCHEMA, "llama", F_PRE, F_VOCAB, "0,2", verum, verum) ≡ "un-admitted tokenizer kind: llama (pinned row is gpt2 / byte-level BPE)"
    }

    proba "rejects an un-admitted pre-tokenizer" {
        adfirma structa_result(F_SCHEMA, F_KIND, "gpt2", F_VOCAB, "0,2", verum, verum) ≡ "un-admitted pre-tokenizer: gpt2 (pinned row is smollm)"
    }

    proba "rejects a malformed vocabulary digest" {
        adfirma structa_result(F_SCHEMA, F_KIND, F_PRE, "zz", "0,2", verum, verum) ≡ "malformed vocabulary digest"
    }

    proba "rejects a malformed EOG set" {
        adfirma structa_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "2,0", verum, verum) ≡ "malformed EOG set"
        # PIN ADDED (correctness-fix slice): a well-formed-but-different
        # EOG set fails the exact pinned-value admission.
        adfirma structa_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "1,5", verum, verum) ≡ "EOG set does not match the pinned row: 1,5"
    }

    proba "est_eog admits exactly the pinned EOG set {0, 2} (the generation stop-policy binding)" {
        adfirma tokenizator.est_eog(0)
        adfirma tokenizator.est_eog(2)
        adfirma non (tokenizator.est_eog(1))
        adfirma non (tokenizator.est_eog(3))
    }

    proba "rejects a non-BOS-free row (pinned row is BOS-free)" {
        adfirma structa_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", falsum, verum) ≡ "pinned row is BOS-free (add_bos_token = false)"
    }

    proba "rejects a space-prefixed row (pinned row is space-prefix-free)" {
        adfirma structa_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", verum, falsum) ≡ "pinned row is space-prefix-free (add_space_prefix = false)"
    }
}

# -- KV identity key component (MD-A9 precedent) ---------------------------------

probandum "KV identity key component" {
    proba "clavis renders the deterministic tokenizer identity component" {
        fac {
            fixum tokenizator.IdentitasTokenizator t ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", verum, verum)
            fixum textus k ← tokenizator.clavis_tokenizatoris(t)
            adfirma k ≡ "tokenizer/identity/1.0.0/gpt2/smollm/" + F_VOCAB + "/0,2/bos-free=true/space-prefix-free=true"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "clavis is deterministic (two identical identities → identical key)" {
        fac {
            fixum tokenizator.IdentitasTokenizator a ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", verum, verum)
            fixum tokenizator.IdentitasTokenizator b ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", verum, verum)
            adfirma clavis_result(a) ≡ clavis_result(b)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "clavis is identity-sensitive (a different vocab digest changes the key)" {
        fac {
            fixum tokenizator.IdentitasTokenizator a ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", verum, verum)
            fixum tokenizator.IdentitasTokenizator b ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_ALIA, "0,2", verum, verum)
            adfirma non (clavis_result(a) ≡ clavis_result(b))
        }
        cape err {
            adfirma falsum
        }
    }

    proba "clavis fails closed on an un-admitted identity" {
        fac {
            fixum tokenizator.IdentitasTokenizator t ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", verum, verum)
            adfirma clavis_result(t) ≡ "ok|tokenizer/identity/1.0.0/gpt2/smollm/" + F_VOCAB + "/0,2/bos-free=true/space-prefix-free=true"
        }
        cape err {
            adfirma falsum
        }
    }
}

# -- identity wire form (versioned) ------------------------------------------------

probandum "tokenizer identity wire" {
    proba "serializa/deserializa round-trips the identity" {
        fac {
            fixum tokenizator.IdentitasTokenizator t ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", verum, verum)
            adfirma wire_roundtrip(t)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "deserialization rejects an unknown schema version" {
        adfirma wire_result("tokenizer/identity/2.0.0/gpt2/smollm/" + F_VOCAB + "/0,2") ≡ "unknown tokenizer identity schema version: 2.0.0"
    }

    proba "deserialization rejects an unknown marker" {
        adfirma wire_result("model/identity/1.0.0/gpt2/smollm/" + F_VOCAB + "/0,2") ≡ "unknown tokenizer identity marker"
    }

    proba "deserialization rejects a malformed wire form" {
        adfirma wire_result("tokenizer/identity/1.0.0/gpt2") ≡ "malformed tokenizer identity wire form"
    }

    proba "deserialization rejects an un-admitted kind" {
        adfirma wire_result("tokenizer/identity/1.0.0/llama/smollm/" + F_VOCAB + "/0,2") ≡ "un-admitted tokenizer kind: llama (pinned row is gpt2 / byte-level BPE)"
    }

    proba "deserialization rejects a malformed digest" {
        adfirma wire_result("tokenizer/identity/1.0.0/gpt2/smollm/zz/0,2") ≡ "malformed vocabulary digest"
    }
}

# -- pinned probe id-list parsing (fail-closed) -----------------------------------

probandum "pinned id-list parsing" {
    proba "empty fixture parses to an empty list (P4)" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida("")
            adfirma ids.longitudo() ≡ 0
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a non-digit id fails closed" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida("1,xx")
            adfirma falsum
        }
        cape err {
            adfirma tokenizator.causa(err) ≡ "non-digit token id in pinned fixture"
        }
    }
}
