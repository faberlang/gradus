    merges ← _iunge(merges, _elementum([101, 110, 32, 100]))
    merges ← _iunge(merges, _elementum([95, 32, 101, 110, 100]))
    merges ← _iunge(merges, _elementum([111, 32, 102]))
    merges ← _iunge(merges, _elementum([116, 32, 101]))
    merges ← _iunge(merges, _elementum([116, 101, 32, 120]))
    merges ← _iunge(merges, _elementum([116, 101, 120, 32, 116]))
    return merges
}

fn _corpus_specialia() → manifestum.CorpusGguf {
    var list<int<u8>> table ← _iunge(_iunge([71, 71, 85, 70], _u32(3)), _iunge(_u64(0), _u64(4)))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 111, 100, 101, 108], 8, _elementum([103, 112, 116, 50])))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115], 9, _array(8, 248047, _specialia_tokens())))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 95, 116, 121, 112, 101], 9, _array(4, 248047, _specialia_typi())))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 101, 114, 103, 101, 115], 9, _array(8, 13, _specialia_merges())))
    return _plenum(table, 32, 0)
}

# Parse-special-on full-prompt encode as textus: "ok|<ids>" or "ERR|<causa>".
fn _encoda_promptum_specialia_resultum(manifestum.CorpusGguf corpus, string textum) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            const list<int> ids ← tokenizator.encoda_promptum_specialia(t, textum)
            var string out ← ""
            var int i ← 0
            while i ≺ ids.longitudo() {
                if i ≻ 0 then out ← out + ","
                out ← out + (ids.accipe(i) coalesce 0 ↦ string)
                i ← i + 1
            }
            return "ok|" + out
        }
        catch err {
            return "ERR|" + tokenizator.causa(err)
        }
    }
    catch err {
        return "ERR|" + manifestum.causa(err)
    }
}

describe "LIB-02-U3-4 special-token policy (parse on/off + embedded)" {
    test "each special-token probe row encodes to its exact pinned ids" {
        assert _encoda_promptum_specialia_resultum(_corpus_specialia(), "<|im_start|>") ≡ "ok|" + PINNATA_U3_4_A
        assert _encoda_promptum_resultum(_corpus_specialia(), "<|im_start|>") ≡ "ok|" + PINNATA_U3_4_B
        assert _encoda_promptum_specialia_resultum(_corpus_specialia(), "<|im_end|>") ≡ "ok|" + PINNATA_U3_4_C
        assert _encoda_promptum_resultum(_corpus_specialia(), "<|im_end|>") ≡ "ok|" + PINNATA_U3_4_D
        assert _encoda_promptum_specialia_resultum(_corpus_specialia(), "<|endoftext|>") ≡ "ok|" + PINNATA_U3_4_E
        assert _encoda_promptum_resultum(_corpus_specialia(), "<|endoftext|>") ≡ "ok|" + PINNATA_U3_4_F
    }
    test "embedded specials parse to their single id between the surrounding words" {
        assert _encoda_promptum_specialia_resultum(_corpus_specialia(), "a<|im_end|>b") ≡ "ok|" + PINNATA_U3_4_G
        assert _encoda_promptum_resultum(_corpus_specialia(), "a<|im_end|>b") ≡ "ok|" + PINNATA_U3_4_H
    }
    test "parse-special on equals off when the prompt has no specials" {
        assert _encoda_promptum_specialia_resultum(_corpus_specialia(), "ab") ≡ _encoda_promptum_resultum(_corpus_specialia(), "ab")
        assert _encoda_promptum_specialia_resultum(_corpus_specialia(), "ab") ≡ "ok|64,65"
    }
    test "decode round-trips the literal rows and the special ids" {
        assert _decoda_plena(_corpus_specialia(), "<|im_start|>") ≡ "ok|<|im_start|>"
        assert _decoda_plena(_corpus_specialia(), "a<|im_end|>b") ≡ "ok|a<|im_end|>b"
        assert _decoda_resultum(_corpus_specialia(), [248045]) ≡ "ok|<|im_start|>"
        assert _decoda_resultum(_corpus_specialia(), [248044]) ≡ "ok|<|endoftext|>"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-5 — EOG + BOS-free policy.
#
# The runtime derives the EOG stop set from the artifact exactly like the
# pinned llama.cpp reference (llama-vocab.cpp llm_load_vocab, oracle 10150
# `dee2a846b`): the declared tokenizer.ggml.eos_token_id, every vocab token
# whose text is in the reference EOG name list (<|endoftext|>, <|im_end|>,
# ...), and the FIM pad/rep/sep ids (metadata key first, else the reference
# text-name fallback). For the pinned artifact this yields exactly
# {248044, 248046, 248063, 248064, 248065}. The BOS-free policy honors the
# artifact's tokenizer.ggml.add_bos_token = falsum: encode never prepends a
# BOS, so the empty prompt encodes to [] and "x" to [87].
#
# The fixture corpus mirrors the artifact's shape: "x" at id 87, the five
# EOG tokens at their pinned ids with their exact texts, eos_token_id =
# 248046 and add_bos_token = falsum in the metadata, and no other token
# whose text is an EOG/FIM name. No artifact bytes are committed.
# ---------------------------------------------------------------------------

const string PINNATA_U3_5_X ← "87"
const string PINNATA_U3_5_EOG ← "248044,248046,248063,248064,248065"

# EOG fixture: "x" at id 87, the five EOG tokens at their pinned ids
# (max id 248065 → 248066 entries), "!" placeholder elsewhere. Pinned
# tokens: 87 "x", 248044 "<|endoftext|>", 248046 "<|im_end|>",
# 248063 "<|fim_pad|>", 248064 "<|repo_name|>", 248065 "<|file_sep|>".
