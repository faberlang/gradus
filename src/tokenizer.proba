    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 101, 111, 115, 95, 116, 111, 107, 101, 110, 95, 105, 100], 4, _u32(248046)))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 97, 100, 100, 95, 98, 111, 115, 95, 116, 111, 107, 101, 110], 7, [0 ∷ int<u8>]))
    return _plenum(table, 32, 0)
