# scanna_verba outcome as textus: "ok|<word>|<word>|..." or "ERR|<causa>".
functio _scanna_resultum(textus textum) → textus {
    fac {
        fixum lista<textus> verba ← tokenizator.scanna_verba(textum)
        varia textus out ← "ok"
        itera ex verba fixum verbum {
            out ← out + "|" + verbum
        }
        redde out
    }
    cape err {
        redde "ERR|" + tokenizator.causa(err)
    }
}

# Full-prompt encode (scanner + BPE core) as textus: "ok|<ids>" or "ERR|<causa>".
functio _encoda_promptum_resultum(manifestum.CorpusGguf corpus, textus textum) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            fixum lista<numerus> ids ← tokenizator.encoda_promptum(t, textum)
            varia textus out ← ""
            varia numerus i ← 0
            dum i < ids.longitudo() {
                si i > 0 ergo out ← out + ","
                out ← out + (ids.accipe(i) vel 0 ↦ textus)
                i ← i + 1
            }
            redde "ok|" + out
        }
        cape err {
            redde "ERR|" + tokenizator.causa(err)
        }
    }
    cape err {
        redde "ERR|" + manifestum.causa(err)
    }
}

# Full-prompt round-trip as textus: "ok|<decoded text>" or "ERR|<causa>".
functio _decoda_plena(manifestum.CorpusGguf corpus, textus textum) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            fixum lista<numerus> ids ← tokenizator.encoda_promptum(t, textum)
            redde "ok|" + tokenizator.decoda(t, ids)
        }
        cape err {
            redde "ERR|" + tokenizator.causa(err)
        }
    }
    cape err {
        redde "ERR|" + manifestum.causa(err)
    }
}

probandum "LIB-02-U3-2 qwen35 word-splitting scanner (core families)" {
    proba "the scanner splits each word-boundary / digit / newline row to the pinned words" {
        adfirma _scanna_resultum("transformers สวัสดี 人工智能") ≡ "ok|transformers| สวัสดี| 人工智能"
        adfirma _scanna_resultum("transformers  สวัสดี") ≡ "ok|transformers| | สวัสดี"
        adfirma _scanna_resultum(" 你好") ≡ "ok| 你好"
        adfirma _scanna_resultum("你好 ") ≡ "ok|你好| "
        adfirma _scanna_resultum("a   b") ≡ "ok|a|  | b"
        adfirma _scanna_resultum("2026") ≡ "ok|2|0|2|6"
        adfirma _scanna_resultum("123") ≡ "ok|1|2|3"
        adfirma _scanna_resultum("a\nb") ≡ "ok|a|\n|b"
        adfirma _scanna_resultum("a\n\nb") ≡ "ok|a|\n\n|b"
        adfirma _scanna_resultum("a\tb") ≡ "ok|a|\tb"
    }

    proba "whitespace and newline family edges mirror the reference scanner" {
        adfirma _scanna_resultum("a  b") ≡ "ok|a| | b"
        adfirma _scanna_resultum("a \nb") ≡ "ok|a| \n| b"
        adfirma _scanna_resultum("a \n") ≡ "ok|a| \n"
        adfirma _scanna_resultum("\n a") ≡ "ok|\n| a"
        adfirma _scanna_resultum("a  \nb") ≡ "ok|a|  \n|b"
        adfirma _scanna_resultum("a  ") ≡ "ok|a|  "
    }

    proba "each word-boundary / digit / newline row encodes to its exact pinned ids" {
        adfirma _encoda_promptum_resultum(_corpus_scanner(), "transformers สวัสดี 人工智能") ≡ "ok|" + PINNATA_U3_2_R1
        adfirma _encoda_promptum_resultum(_corpus_scanner(), "transformers  สวัสดี") ≡ "ok|" + PINNATA_U3_2_R2
        adfirma _encoda_promptum_resultum(_corpus_scanner(), " 你好") ≡ "ok|" + PINNATA_U3_2_R3
        adfirma _encoda_promptum_resultum(_corpus_scanner(), "你好 ") ≡ "ok|" + PINNATA_U3_2_R4
        adfirma _encoda_promptum_resultum(_corpus_scanner(), "a   b") ≡ "ok|" + PINNATA_U3_2_R5
        adfirma _encoda_promptum_resultum(_corpus_scanner(), "2026") ≡ "ok|" + PINNATA_U3_2_R6
        adfirma _encoda_promptum_resultum(_corpus_scanner(), "123") ≡ "ok|" + PINNATA_U3_2_R7
        adfirma _encoda_promptum_resultum(_corpus_scanner(), "a\nb") ≡ "ok|" + PINNATA_U3_2_R8
        adfirma _encoda_promptum_resultum(_corpus_scanner(), "a\n\nb") ≡ "ok|" + PINNATA_U3_2_R9
        adfirma _encoda_promptum_resultum(_corpus_scanner(), "a\tb") ≡ "ok|" + PINNATA_U3_2_R10
    }

    proba "decode round-trips each row through the scanner + BPE core" {
        adfirma _decoda_plena(_corpus_scanner(), "transformers สวัสดี 人工智能") ≡ "ok|transformers สวัสดี 人工智能"
        adfirma _decoda_plena(_corpus_scanner(), "transformers  สวัสดี") ≡ "ok|transformers  สวัสดี"
        adfirma _decoda_plena(_corpus_scanner(), " 你好") ≡ "ok| 你好"
        adfirma _decoda_plena(_corpus_scanner(), "你好 ") ≡ "ok|你好 "
        adfirma _decoda_plena(_corpus_scanner(), "a   b") ≡ "ok|a   b"
        adfirma _decoda_plena(_corpus_scanner(), "2026") ≡ "ok|2026"
        adfirma _decoda_plena(_corpus_scanner(), "123") ≡ "ok|123"
        adfirma _decoda_plena(_corpus_scanner(), "a\nb") ≡ "ok|a\nb"
        adfirma _decoda_plena(_corpus_scanner(), "a\n\nb") ≡ "ok|a\n\nb"
        adfirma _decoda_plena(_corpus_scanner(), "a\tb") ≡ "ok|a\tb"
    }

    proba "a character no core family matches falls to a single-word fallthrough" {
        adfirma _scanna_resultum("🎉") ≡ "ok|🎉"
    }
}
