describe "LIB-02-U3-3 qwen35 scanner edge families (punct/emoji/contractions)" {
    test "the scanner splits each edge row to the pinned words" {
        assert _scan_result("hello, world!") ≡ "ok|hello|,| world|!"
        assert _scan_result("🎉🎉") ≡ "ok|🎉🎉"
        assert _scan_result("!hello") ≡ "ok|!hello"
        assert _scan_result("don't") ≡ "ok|don|'t"
        assert _scan_result("it's") ≡ "ok|it|'s"
        assert _scan_result("I'm") ≡ "ok|I|'m"
        assert _scan_result("you've") ≡ "ok|you|'ve"
    }
    test "punct/emoji runs group with an optional leading space" {
        assert _scan_result("hello!!") ≡ "ok|hello|!!"
        assert _scan_result("a,!\n") ≡ "ok|a|,!\n"
        assert _scan_result("x  ,") ≡ "ok|x| | ,"
        assert _scan_result("  ,") ≡ "ok| | ,"
    }
    test "the contraction family wins over the letter-run leading char" {
        assert _scan_result("don'ts") ≡ "ok|don|'t|s"
        assert _scan_result("it'sx") ≡ "ok|it|'s|x"
        assert _scan_result("DON'T") ≡ "ok|DON|'T"
        assert _scan_result("I'VE") ≡ "ok|I|'VE"
    }
    test "each edge row encodes to its exact pinned ids" {
        assert _encode_prompt_result(_corpus_scanner_edges(), "hello, world!") ≡ "ok|" + PINNED_U3_3_P1
        assert _encode_prompt_result(_corpus_scanner_edges(), "🎉🎉") ≡ "ok|" + PINNED_U3_3_P2
        assert _encode_prompt_result(_corpus_scanner_edges(), "!hello") ≡ "ok|" + PINNED_U3_3_P3
        assert _encode_prompt_result(_corpus_scanner_edges(), "don't") ≡ "ok|" + PINNED_U3_3_C1
        assert _encode_prompt_result(_corpus_scanner_edges(), "it's") ≡ "ok|" + PINNED_U3_3_C2
        assert _encode_prompt_result(_corpus_scanner_edges(), "I'm") ≡ "ok|" + PINNED_U3_3_C3
        assert _encode_prompt_result(_corpus_scanner_edges(), "you've") ≡ "ok|" + PINNED_U3_3_C4
    }
    test "decode round-trips each edge row through the scanner + BPE core" {
        assert _decode_full(_corpus_scanner_edges(), "hello, world!") ≡ "ok|hello, world!"
        assert _decode_full(_corpus_scanner_edges(), "🎉🎉") ≡ "ok|🎉🎉"
        assert _decode_full(_corpus_scanner_edges(), "!hello") ≡ "ok|!hello"
        assert _decode_full(_corpus_scanner_edges(), "don't") ≡ "ok|don't"
        assert _decode_full(_corpus_scanner_edges(), "it's") ≡ "ok|it's"
        assert _decode_full(_corpus_scanner_edges(), "I'm") ≡ "ok|I'm"
        assert _decode_full(_corpus_scanner_edges(), "you've") ≡ "ok|you've"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-4 — Special-token policy (parse on/off + embedded).
#
# The artifact's special cache (derived from `tokenizer.ggml.token_type` —
# every non-NORMAL entry, the llama.cpp llama_vocab::init_special rule) drives
# parse-special on/off: specials inside text resolve to their single ids when
# parsed (`encode_prompt_special`), and to literal BPE bytes when
# parse_special = falsum (`encode_prompt`), including embedded specials.
# The 8 rows below are the delivery's special-token probes:
#   <|im_start|>  -> [248045] parsed / [27, 91, 316, 4747, 91, 29] literal
#   <|im_end|>    -> [248046] parsed / [27, 91, 316, 6018, 91, 29] literal
#   <|endoftext|> -> [248044] parsed / [27, 91, 8426, 703, 419, 91, 29] literal
#   a<|im_end|>b  -> [64, 248046, 65] parsed / [64, 27, 91, 316, 6018, 91, 29, 65] literal
# The scanner splits the literal forms as <| im _start |> (and <| im _end |>
# / <| endoftext |> / a <| im _end |> b — the letter-run arm absorbs the
# leading underscore), so the literal rows exercise the same families as
# U3-2/U3-3.
#
# The fixture corpus is a structural model (same approach as U2/U3-2/U3-3):
# the pinned tokens sit at their pinned ids with the exact display strings,
# the token_type array marks exactly the three specials CONTROL (3), and the
# merge table carries exactly the ranked merge pairs the real BPE applies to
# each row word. No artifact bytes are committed.
# ---------------------------------------------------------------------------

const string PINNED_U3_4_A ← "248045"
const string PINNED_U3_4_B ← "27,91,316,4747,91,29"
const string PINNED_U3_4_C ← "248046"
const string PINNED_U3_4_D ← "27,91,316,6018,91,29"
const string PINNED_U3_4_E ← "248044"
const string PINNED_U3_4_F ← "27,91,8426,703,419,91,29"
const string PINNED_U3_4_G ← "64,248046,65"
const string PINNED_U3_4_H ← "64,27,91,316,6018,91,29,65"

# Repeat one u32 value `count` times (the token_type fixture array).
fn _u32_values_repeat(int count, int v) → list<int<u8>> {
    const list<int<u8>> u ← _u32(v)
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ count {
        for from u const b {
            out.append(b)
        }
        i ↑
    }
    return out
}

# Special fixture: pinned tokens at their pinned ids (max id 248046, 248047
# entries) with a "!" placeholder elsewhere. Pinned tokens: 27 "<", 29 ">",
# 64 "a", 65 "b", 91 "|", 316 "im", 419 "text", 703 "of", 4747 "_start",
# 6018 "_end", 8426 "end", and the three specials at 248044 "<|endoftext|>",
# 248045 "<|im_start|>", 248046 "<|im_end|>".
fn _special_tokens() → list<int<u8>> {
    const list<int<u8>> ding ← _elementum([33])
    var list<int<u8>> tokens ← _stringarum_itera(27, ding)
    tokens ← _join(tokens, _elementum([60]))
    tokens ← _join(tokens, _stringarum_itera(1, ding))
    tokens ← _join(tokens, _elementum([62]))
    tokens ← _join(tokens, _stringarum_itera(34, ding))
    tokens ← _join(tokens, _elementum([97]))
    tokens ← _join(tokens, _elementum([98]))
    tokens ← _join(tokens, _stringarum_itera(25, ding))
    tokens ← _join(tokens, _elementum([124]))
    tokens ← _join(tokens, _stringarum_itera(224, ding))
    tokens ← _join(tokens, _elementum([105, 109]))
    tokens ← _join(tokens, _stringarum_itera(102, ding))
    tokens ← _join(tokens, _elementum([116, 101, 120, 116]))
    tokens ← _join(tokens, _stringarum_itera(283, ding))
    tokens ← _join(tokens, _elementum([111, 102]))
    tokens ← _join(tokens, _stringarum_itera(4043, ding))
    tokens ← _join(tokens, _elementum([95, 115, 116, 97, 114, 116]))
    tokens ← _join(tokens, _stringarum_itera(1270, ding))
    tokens ← _join(tokens, _elementum([95, 101, 110, 100]))
    tokens ← _join(tokens, _stringarum_itera(2407, ding))
    tokens ← _join(tokens, _elementum([101, 110, 100]))
    tokens ← _join(tokens, _stringarum_itera(239617, ding))
    tokens ← _join(tokens, _elementum([60, 124, 101, 110, 100, 111, 102, 116, 101, 120, 116, 124, 62]))
    tokens ← _join(tokens, _elementum([60, 124, 105, 109, 95, 115, 116, 97, 114, 116, 124, 62]))
    tokens ← _join(tokens, _elementum([60, 124, 105, 109, 95, 101, 110, 100, 124, 62]))
    return tokens
}

# token_type fixture: NORMAL (1) everywhere, CONTROL (3) at the three
# special ids (248044..248046).
fn _special_kinds() → list<int<u8>> {
    var list<int<u8>> out ← _u32_values_repeat(248044, 1)
    out ← _join(out, _u32(3))
    out ← _join(out, _u32(3))
    out ← _join(out, _u32(3))
    return out
}

# The 13 ranked merge pairs the literal BPE applies to the probe words.
fn _special_merges() → list<int<u8>> {
    var list<int<u8>> merges ← _elementum([105, 32, 109])
    merges ← _join(merges, _elementum([115, 32, 116]))
    merges ← _join(merges, _elementum([115, 116, 32, 97]))
    merges ← _join(merges, _elementum([115, 116, 97, 32, 114]))
    merges ← _join(merges, _elementum([115, 116, 97, 114, 32, 116]))
    merges ← _join(merges, _elementum([95, 32, 115, 116, 97, 114, 116]))
    merges ← _join(merges, _elementum([101, 32, 110]))
    merges ← _join(merges, _elementum([101, 110, 32, 100]))
    merges ← _join(merges, _elementum([95, 32, 101, 110, 100]))
    merges ← _join(merges, _elementum([111, 32, 102]))
    merges ← _join(merges, _elementum([116, 32, 101]))
    merges ← _join(merges, _elementum([116, 101, 32, 120]))
    merges ← _join(merges, _elementum([116, 101, 120, 32, 116]))
    return merges
}

fn _corpus_specials() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _join(_join([71, 71, 85, 70], _u32(3)), _join(_u64(0), _u64(4)))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 111, 100, 101, 108], 8, _elementum([103, 112, 116, 50])))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115], 9, _array(8, 248047, _special_tokens())))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 95, 116, 121, 112, 101], 9, _array(4, 248047, _special_kinds())))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 101, 114, 103, 101, 115], 9, _array(8, 13, _special_merges())))
    return _plenum(table, 32, 0)
}

# Parse-special-on full-prompt encode as text: "ok|<ids>" or "ERR|<message>".
fn _encode_prompt_special_result(gguf_manifest.GgufCorpus corpus, string text) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tokenizer.Tokenizer t ← tokenizer.build(m)
            const list<int> ids ← tokenizer.encode_prompt_special(t, text)
            var string out ← ""
            var int i ← 0
            while i ≺ ids.length() {
                if i ≻ 0 then out ← out + ","
                out ← out + (ids.get(i) coalesce 0 ↦ string)
                i ← i + 1
            }
            return "ok|" + out
        }
        catch err {
            return "ERR|" + tokenizer.message(err)
        }
    }
    catch err {
        return "ERR|" + gguf_manifest.message(err)
    }
}

describe "LIB-02-U3-4 special-token policy (parse on/off + embedded)" {
    test "each special-token probe row encodes to its exact pinned ids" {
        assert _encode_prompt_special_result(_corpus_specials(), "<|im_start|>") ≡ "ok|" + PINNED_U3_4_A
        assert _encode_prompt_result(_corpus_specials(), "<|im_start|>") ≡ "ok|" + PINNED_U3_4_B
        assert _encode_prompt_special_result(_corpus_specials(), "<|im_end|>") ≡ "ok|" + PINNED_U3_4_C
        assert _encode_prompt_result(_corpus_specials(), "<|im_end|>") ≡ "ok|" + PINNED_U3_4_D
        assert _encode_prompt_special_result(_corpus_specials(), "<|endoftext|>") ≡ "ok|" + PINNED_U3_4_E
        assert _encode_prompt_result(_corpus_specials(), "<|endoftext|>") ≡ "ok|" + PINNED_U3_4_F
    }
    test "embedded specials parse to their single id between the surrounding words" {
        assert _encode_prompt_special_result(_corpus_specials(), "a<|im_end|>b") ≡ "ok|" + PINNED_U3_4_G
        assert _encode_prompt_result(_corpus_specials(), "a<|im_end|>b") ≡ "ok|" + PINNED_U3_4_H
    }
    test "parse-special on equals off when the prompt has no specials" {
        assert _encode_prompt_special_result(_corpus_specials(), "ab") ≡ _encode_prompt_result(_corpus_specials(), "ab")
        assert _encode_prompt_special_result(_corpus_specials(), "ab") ≡ "ok|64,65"
    }
    test "decode round-trips the literal rows and the special ids" {
        assert _decode_full(_corpus_specials(), "<|im_start|>") ≡ "ok|<|im_start|>"
        assert _decode_full(_corpus_specials(), "a<|im_end|>b") ≡ "ok|a<|im_end|>b"
        assert _decode_result(_corpus_specials(), [248045]) ≡ "ok|<|im_start|>"
        assert _decode_result(_corpus_specials(), [248044]) ≡ "ok|<|endoftext|>"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-5 — EOG + BOS-free policy.
#
# The runtime derives the EOG stop set from the artifact exactly like the
# pinned llama.cpp reference (llama-vocab.cpp llm_load_vocab, oracle 10150
# `dee2a846b`): the declared tokenizer.ggml.eos_token_id, every vocab token
# whose text is in the reference EOG name list (<|endoftext|>, <|im_end|>,
# ...), and the FIM pad/rep/sep ids (metadata key first, else the reference
# text-name fallback). For the pinned artifact this yields exactly
# {248044, 248046, 248063, 248064, 248065}. The BOS-free policy honors the
# artifact's tokenizer.ggml.add_bos_token = falsum: encode never prepends a
# BOS, so the empty prompt encodes to [] and "x" to [87].
#
# The fixture corpus mirrors the artifact's shape: "x" at id 87, the five
# EOG tokens at their pinned ids with their exact texts, eos_token_id =
# 248046 and add_bos_token = falsum in the metadata, and no other token
# whose text is an EOG/FIM name. No artifact bytes are committed.
# ---------------------------------------------------------------------------

const string PINNED_U3_5_X ← "87"
const string PINNED_U3_5_EOG ← "248044,248046,248063,248064,248065"

# EOG fixture: "x" at id 87, the five EOG tokens at their pinned ids
# (max id 248065 → 248066 entries), "!" placeholder elsewhere. Pinned
# tokens: 87 "x", 248044 "<|endoftext|>", 248046 "<|im_end|>",
# 248063 "<|fim_pad|>", 248064 "<|repo_name|>", 248065 "<|file_sep|>".
fn _eog_tokens() → list<int<u8>> {
    const list<int<u8>> ding ← _elementum([33])
    var list<int<u8>> tokens ← _stringarum_itera(87, ding)
    tokens ← _join(tokens, _elementum([120]))
    tokens ← _join(tokens, _stringarum_itera(247956, ding))
    tokens ← _join(tokens, _elementum([60, 124, 101, 110, 100, 111, 102, 116, 101, 120, 116, 124, 62]))
    tokens ← _join(tokens, _elementum([33]))
    tokens ← _join(tokens, _elementum([60, 124, 105, 109, 95, 101, 110, 100, 124, 62]))
    tokens ← _join(tokens, _stringarum_itera(16, ding))
    tokens ← _join(tokens, _elementum([60, 124, 102, 105, 109, 95, 112, 97, 100, 124, 62]))
    tokens ← _join(tokens, _elementum([60, 124, 114, 101, 112, 111, 95, 110, 97, 109, 101, 124, 62]))
    tokens ← _join(tokens, _elementum([60, 124, 102, 105, 108, 101, 95, 115, 101, 112, 124, 62]))
    return tokens
}

# token_type fixture: NORMAL (1) everywhere, CONTROL (3) at the five EOG ids.
fn _eog_kinds() → list<int<u8>> {
    var list<int<u8>> out ← _u32_values_repeat(248044, 1)
    out ← _join(out, _u32(3))
    out ← _join(out, _u32(1))
    out ← _join(out, _u32(3))
    out ← _join(out, _u32_values_repeat(16, 1))
    out ← _join(out, _u32(3))
    out ← _join(out, _u32(3))
    out ← _join(out, _u32(3))
    return out
}

fn _corpus_eog() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _join(_join([71, 71, 85, 70], _u32(3)), _join(_u64(0), _u64(6)))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 111, 100, 101, 108], 8, _elementum([103, 112, 116, 50])))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115], 9, _array(8, 248066, _eog_tokens())))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 95, 116, 121, 112, 101], 9, _array(4, 248066, _eog_kinds())))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 101, 114, 103, 101, 115], 9, _array(8, 0, [])))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 101, 111, 115, 95, 116, 111, 107, 101, 110, 95, 105, 100], 4, _u32(248046)))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 97, 100, 100, 95, 98, 111, 115, 95, 116, 111, 107, 101, 110], 7, [0 ∷ int<u8>]))
    return _plenum(table, 32, 0)
}

# Runtime EOG set as text: "ok|<ids>" or "ERR|<message>".
fn _eog_result(gguf_manifest.GgufCorpus corpus) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tokenizer.Tokenizer t ← tokenizer.build(m)
            const list<int> eog ← tokenizer.artifact_eog(t)
            var string out ← ""
            var int i ← 0
            while i ≺ eog.length() {
                if i ≻ 0 then out ← out + ","
                out ← out + (eog.get(i) coalesce 0 ↦ string)
                i ← i + 1
            }
            return "ok|" + out
        }
        catch err {
            return "ERR|" + tokenizer.message(err)
        }
    }
    catch err {
        return "ERR|" + gguf_manifest.message(err)
    }
}

# EOG-membership outcome: "ok" when the id is a member, "non" otherwise.
fn _is_eog_result(gguf_manifest.GgufCorpus corpus, int id) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tokenizer.Tokenizer t ← tokenizer.build(m)
            if tokenizer.is_artifact_eog(t, id) then return "ok"
            return "non"
        }
        catch err {
            return "ERR|" + tokenizer.message(err)
        }
    }
    catch err {
        return "ERR|" + gguf_manifest.message(err)
    }
}

# add_bos outcome: "adds-bos" when verum, "bos-free" when falsum.
fn _add_bos_result(gguf_manifest.GgufCorpus corpus) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tokenizer.Tokenizer t ← tokenizer.build(m)
            if tokenizer.add_bos(t) then return "adds-bos"
            return "bos-free"
        }
        catch err {
            return "ERR|" + tokenizer.message(err)
        }
    }
    catch err {
        return "ERR|" + gguf_manifest.message(err)
    }
}

describe "LIB-02-U3-5 EOG + BOS-free policy" {
    test "the runtime EOG set is exactly the pinned artifact set" {
        assert _eog_result(_corpus_eog()) ≡ "ok|" + PINNED_U3_5_EOG
    }
    test "EOG membership admits exactly the five pinned ids" {
        assert _is_eog_result(_corpus_eog(), 248044) ≡ "ok"
        assert _is_eog_result(_corpus_eog(), 248046) ≡ "ok"
        assert _is_eog_result(_corpus_eog(), 248063) ≡ "ok"
        assert _is_eog_result(_corpus_eog(), 248064) ≡ "ok"
        assert _is_eog_result(_corpus_eog(), 248065) ≡ "ok"
        assert _is_eog_result(_corpus_eog(), 248045) ≡ "non"
        assert _is_eog_result(_corpus_eog(), 0) ≡ "non"
        assert _is_eog_result(_corpus_eog(), 87) ≡ "non"
    }
    test "encode is BOS-free: empty prompt → empty sequence, x → [87]" {
        assert _encode_prompt_result(_corpus_eog(), "") ≡ "ok|"
        assert _encode_prompt_special_result(_corpus_eog(), "") ≡ "ok|"
        assert _encode_prompt_result(_corpus_eog(), "x") ≡ "ok|" + PINNED_U3_5_X
        assert _encode_prompt_special_result(_corpus_eog(), "x") ≡ "ok|" + PINNED_U3_5_X
    }
    test "the artifact add_bos_token = falsum is honored on the runtime surface" {
        assert _add_bos_result(_corpus_eog()) ≡ "bos-free"
    }
    test "an artifact without EOG metadata yields an empty EOG set (no hard-coded fallback)" {
        assert _eog_result(_corpus_minor()) ≡ "ok|"
        assert _is_eog_result(_corpus_minor(), 0) ≡ "non"
        assert _add_bos_result(_corpus_minor()) ≡ "bos-free"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-6 — Chat-template policy (metadata + minimal user-turn).
#
# `tokenizer.chat_template` loads from artifact metadata into the runtime
# (the U1 text seam; absent → empty string — no hard-coded fallback), and
# the MINIMAL Qwen3-ChatML user-turn render applies the pinned shape
# `<|im_start|>user\n{content}<|im_end|>\n`. The 3 rows below are the
# delivery's chat-template differential table:
#   rendered Probe B user turn          -> R1  (parse-special on)
#   same, --no-parse-special            -> R1b (literal)
#   <|im_start|>assistant\n             -> R2
# R1 proves the ChatML path composes without changing the pinned Probe B
# ids (the 18-ids segment embeds verbatim). Full vision/tool-calling
# template branches are recorded, not executed (delivery scope matrix).
#
# The fixture corpus is a structural model (same approach as U2/U3-2..U3-5):
# the pinned tokens sit at their pinned ids with the exact display strings,
# the token_type array marks exactly the two ChatML specials CONTROL (3),
# the merge table carries exactly the ranked merge pairs the real BPE
# applies to each rendered word, and the chat_template metadata stores the
# minimal ChatML shape. A second small corpus pins R2 (assistant; its merge
# chain would collide with the user-turn corpus's "s t" entry, so the rows
# live on separate fixtures). No artifact bytes are committed.
# ---------------------------------------------------------------------------

const string PINNED_U3_6_R1 ← "248045,846,198,109266,3709,96748,6115,113128,17,15,17,21,95859,23,96212,16,18,95971,10838,236,231,248046,198"
