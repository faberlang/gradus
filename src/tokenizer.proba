+++
locale = "en"
+++
# Co-located package test for tokenizer.fab (PML2-U4 tokenizer identity,
# tokenizer-identity-schema-1.0.0). Not importable; discovered only by the
# faber test path.
#
# Proves, at compile level: the pinned llama.cpp probe fixtures parse to the
# exact pinned id lists (P1–P11 + four workload lists 9/9/202/2175), the
# fail-closed probe-parity admission (verifica_proba: exact match admits,
# any divergence fails closed), the versioned identity record (structa happy
# row + every typed rejection path), self-verification, the KV identity key
# component (MD-A9), and the identity wire round-trip + version rejection.
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
#
# NOTE (pinned fixtures): the id lists are cited read-only from
# evidence/contract-tokenize-probes.txt (P1–P11) and gi0-workloads.md §3
# (workload lists). The 24-case differential vs llama-tokenize 10150 is
# cited read-only from gi1-closeout.md — the runtime owner reproduces it;
# this contract pins the expected ids.

import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" manifestum
import from "gradus:tokenizer" tokenizator

# -- pinned-row fixture facts -------------------------------------------------

const string F_SCHEMA ← "1.0.0"
const string F_KIND ← "gpt2"
const string F_PRE ← "smollm"
const string F_VOCAB ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
const string F_ALIA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# -- helpers -------------------------------------------------------------------

# verifica_proba outcome as textus ("ok" or the typed error's causa).
fn proba_result(string nomen, list<int> observata) → string {
    do {
        const bool ok ← tokenizator.verifica_proba(nomen, observata)
        return "ok"
    }
    catch err {
        return tokenizator.causa(err)
    }
}

# structa outcome as textus ("ok" on success, or the typed error's causa).
fn structa_result(string schema, string progenies, string pre_tokenizator, string digestio_vocabuli, string eog, bool bos_vacua, bool spatium_vacua) → string {
    do {
        const tokenizator.IdentitasTokenizator t ← tokenizator.structa(schema, progenies, pre_tokenizator, digestio_vocabuli, eog, bos_vacua, spatium_vacua)
        return "ok"
    }
    catch err {
        return tokenizator.causa(err)
    }
}

# verifica outcome as textus.
fn verifica_result(tokenizator.IdentitasTokenizator t) → string {
    do {
        const bool ok ← tokenizator.verifica(t)
        return "ok"
    }
    catch err {
        return tokenizator.causa(err)
    }
}

# clavis outcome as textus ("ok|key" or the typed error's causa).
fn clavis_result(tokenizator.IdentitasTokenizator t) → string {
    do {
        const string k ← tokenizator.clavis_tokenizatoris(t)
        return "ok|" + k
    }
    catch err {
        return tokenizator.causa(err)
    }
}

# Wire round-trip predicate: deserializa(serializa(t)) reproduces t.
fn wire_roundtrip(tokenizator.IdentitasTokenizator t) → bool {
    do {
        const tokenizator.IdentitasTokenizator back ← tokenizator.deserializa_identitas(tokenizator.serializa_identitas(t))
        if back.progenies() ≠ t.progenies() then return false
        if back.pre_tokenizator() ≠ t.pre_tokenizator() then return false
        if back.digestio_vocabuli() ≠ t.digestio_vocabuli() then return false
        if back.eog() ≠ t.eog() then return false
        return true
    }
    catch err {
        return false
    }
}

# Wire outcome as textus ("ok" or the typed error's causa).
fn wire_result(string wire) → string {
    do {
        const tokenizator.IdentitasTokenizator t ← tokenizator.deserializa_identitas(wire)
        return "ok"
    }
    catch err {
        return tokenizator.causa(err)
    }
}

# -- pinned probe fixtures (P1–P11, read-only from contract-tokenize-probes.txt) ---

describe "pinned llama.cpp probe parity" {
    test "P1 Hello world parses to the pinned ids" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p1"))
            assert tokenizator.proba_aequa(ids, [19556, 905])
        }
        catch err {
            assert false
        }
    }
    test "P2 equals P1 (BOS-free: no auto-prepend)" {
        do {
            const list<int> a ← tokenizator.proba_ida(tokenizator.pinnata_proba("p1"))
            const list<int> b ← tokenizator.proba_ida(tokenizator.pinnata_proba("p2"))
            assert tokenizator.proba_aequa(a, b)
        }
        catch err {
            assert false
        }
    }
    test "P4 empty prompt stays empty (no BOS)" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p4"))
            assert ids.longitudo() ≡ 0
        }
        catch err {
            assert false
        }
    }
    test "P5 <|im_start|> parses to BOS special id 1" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p5"))
            assert tokenizator.proba_aequa(ids, [1])
        }
        catch err {
            assert false
        }
    }
    test "P6 <|im_start|> literal with --no-parse-special (BPE bytes)" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p6"))
            assert tokenizator.proba_aequa(ids, [44, 108, 306, 79, 3738, 108, 46])
        }
        catch err {
            assert false
        }
    }
    test "P5 vs P6 special-parse on/off parity" {
        do {
            const list<int> on ← tokenizator.proba_ida(tokenizator.pinnata_proba("p5"))
            const list<int> off ← tokenizator.proba_ida(tokenizator.pinnata_proba("p6"))
            assert not (tokenizator.proba_aequa(on, off))
        }
        catch err {
            assert false
        }
    }
    test "P7 <|im_end|> parses to EOS special id 2" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p7"))
            assert tokenizator.proba_aequa(ids, [2])
        }
        catch err {
            assert false
        }
    }
    test "P8 <|endoftext|> parses to id 0" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p8"))
            assert tokenizator.proba_aequa(ids, [0])
        }
        catch err {
            assert false
        }
    }
    test "P9 chat-template prefix is the pinned 32 ids" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p9"))
            assert ids.longitudo() ≡ 32
            assert tokenizator.proba_aequa(ids, [1, 9690, 198, 2683, 359, 253, 5356, 5646, 11173, 3365, 3511, 308, 34519, 28, 7018, 411, 407, 19712, 8182, 2, 198, 1, 4093, 198, 26843, 665, 2, 198, 1, 520, 9531, 198])
        }
        catch err {
            assert false
        }
    }
    test "P10 lazy-dog reference is the pinned 9 ids" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p10"))
            assert ids.longitudo() ≡ 9
            assert tokenizator.proba_aequa(ids, [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767])
        }
        catch err {
            assert false
        }
    }
    test "P11 leading spaces is space-prefix-free (pinned 3 ids)" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("p11"))
            assert ids.longitudo() ≡ 3
            assert tokenizator.proba_aequa(ids, [216, 2899, 5600])
        }
        catch err {
            assert false
        }
    }
}

# -- workload id lists (gi0-workloads.md §3: 9 / 9 / 202 / 2175) ----------------

describe "pinned workload id lists" {
    test "correctness workload is the pinned 9 ids" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("correctio"))
            assert ids.longitudo() ≡ 9
            assert tokenizator.proba_aequa(ids, [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767])
        }
        catch err {
            assert false
        }
    }
    test "short workload is the pinned 9 ids" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("brevis"))
            assert ids.longitudo() ≡ 9
            assert tokenizator.proba_aequa(ids, [19161, 253, 421, 30614, 563, 260, 5065, 30, 198])
        }
        catch err {
            assert false
        }
    }
    test "normal workload pins 202 ids and its head/tail match the fixture" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("normale"))
            assert ids.longitudo() ≡ 202
            assert (ids.accipe(0) coalesce 0) ≡ 504
            assert (ids.accipe(201) coalesce 0) ≡ 30
        }
        catch err {
            assert false
        }
    }
    test "context workload pins 2175 ids and its head/tail match the fixture" {
        do {
            const list<int> ids ← tokenizator.proba_ida(tokenizator.pinnata_proba("contextus"))
            assert ids.longitudo() ≡ 2175
            assert (ids.accipe(0) coalesce 0) ≡ 54
            assert (ids.accipe(2174) coalesce 0) ≡ 198
        }
        catch err {
            assert false
        }
    }
}

# -- probe-parity admission (fail-closed) ---------------------------------------

describe "probe-parity admission" {
    test "exact id match admits" {
        assert proba_result("p10", [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767]) ≡ "ok"
    }
    test "a diverging id list fails closed as a different tokenizer" {
        assert proba_result("p10", [504, 2365, 6354, 16438, 27003, 690, 260, 23790]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p10"
    }
    test "a reordered id list fails closed (order matters — ids are sequences)" {
        assert proba_result("p11", [905, 19556]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p11"
    }
    test "a length-mismatched id list fails closed" {
        assert proba_result("p6", [44, 108, 306, 79, 3738, 108]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p6"
    }
    test "unknown probe name fails closed" {
        assert proba_result("p99", [1]) ≡ "unknown pinned probe: p99"
    }
}

# -- versioned identity record ----------------------------------------------------

describe "versioned tokenizer identity" {
    test "structa admits the pinned-row identity" {
        assert structa_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true) ≡ "ok"
    }
    test "the identity stamps the schema and carries the pinned facts" {
        do {
            const tokenizator.IdentitasTokenizator t ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            assert t.schematis() ≡ "1.0.0"
            assert t.progenies() ≡ "gpt2"
            assert t.pre_tokenizator() ≡ "smollm"
            assert t.digestio_vocabuli() ≡ F_VOCAB
            assert t.eog() ≡ "0,2"
            assert t.bos_vacua()
            assert t.spatium_vacua()
        }
        catch err {
            assert false
        }
    }
    test "verifica passes on an admitted identity" {
        do {
            const tokenizator.IdentitasTokenizator t ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            assert verifica_result(t) ≡ "ok"
        }
        catch err {
            assert false
        }
    }
    test "rejects an unknown schema version" {
        assert structa_result("2.0.0", F_KIND, F_PRE, F_VOCAB, "0,2", true, true) ≡ "unknown tokenizer identity schema version: 2.0.0"
    }
    test "rejects an un-admitted tokenizer kind" {
        assert structa_result(F_SCHEMA, "llama", F_PRE, F_VOCAB, "0,2", true, true) ≡ "un-admitted tokenizer kind: llama (pinned row is gpt2 / byte-level BPE)"
    }
    test "rejects an un-admitted pre-tokenizer" {
        assert structa_result(F_SCHEMA, F_KIND, "gpt2", F_VOCAB, "0,2", true, true) ≡ "un-admitted pre-tokenizer: gpt2 (pinned row is smollm)"
    }
    test "rejects a malformed vocabulary digest" {
        assert structa_result(F_SCHEMA, F_KIND, F_PRE, "zz", "0,2", true, true) ≡ "malformed vocabulary digest"
    }
    test "rejects a malformed EOG set" {
        assert structa_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "2,0", true, true) ≡ "malformed EOG set"
        # PIN ADDED (correctness-fix slice): a well-formed-but-different
        # EOG set fails the exact pinned-value admission.
        assert structa_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "1,5", true, true) ≡ "EOG set does not match the pinned row: 1,5"
    }
    test "est_eog admits exactly the pinned EOG set {0, 2} (the generation stop-policy binding)" {
        assert tokenizator.est_eog(0)
        assert tokenizator.est_eog(2)
        assert not (tokenizator.est_eog(1))
        assert not (tokenizator.est_eog(3))
    }
    test "rejects a non-BOS-free row (pinned row is BOS-free)" {
        assert structa_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", false, true) ≡ "pinned row is BOS-free (add_bos_token = false)"
    }
    test "rejects a space-prefixed row (pinned row is space-prefix-free)" {
        assert structa_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, false) ≡ "pinned row is space-prefix-free (add_space_prefix = false)"
    }
}

# -- KV identity key component (MD-A9 precedent) ---------------------------------

describe "KV identity key component" {
    test "clavis renders the deterministic tokenizer identity component" {
        do {
            const tokenizator.IdentitasTokenizator t ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            const string k ← tokenizator.clavis_tokenizatoris(t)
            assert k ≡ ("tokenizer/identity/1.0.0/gpt2/smollm/" + F_VOCAB) + "/0,2/bos-free=true/space-prefix-free=true"
        }
        catch err {
            assert false
        }
    }
    test "clavis is deterministic (two identical identities → identical key)" {
        do {
            const tokenizator.IdentitasTokenizator a ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            const tokenizator.IdentitasTokenizator b ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            assert clavis_result(a) ≡ clavis_result(b)
        }
        catch err {
            assert false
        }
    }
    test "clavis is identity-sensitive (a different vocab digest changes the key)" {
        do {
            const tokenizator.IdentitasTokenizator a ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            const tokenizator.IdentitasTokenizator b ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_ALIA, "0,2", true, true)
            assert not (clavis_result(a) ≡ clavis_result(b))
        }
        catch err {
            assert false
        }
    }
    test "clavis fails closed on an un-admitted identity" {
        do {
            const tokenizator.IdentitasTokenizator t ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            assert clavis_result(t) ≡ ("ok|tokenizer/identity/1.0.0/gpt2/smollm/" + F_VOCAB) + "/0,2/bos-free=true/space-prefix-free=true"
        }
        catch err {
            assert false
        }
    }
}

# -- identity wire form (versioned) ------------------------------------------------

describe "tokenizer identity wire" {
    test "serializa/deserializa round-trips the identity" {
        do {
            const tokenizator.IdentitasTokenizator t ← tokenizator.structa(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            assert wire_roundtrip(t)
        }
        catch err {
            assert false
        }
    }
    test "deserialization rejects an unknown schema version" {
        assert wire_result(("tokenizer/identity/2.0.0/gpt2/smollm/" + F_VOCAB) + "/0,2") ≡ "unknown tokenizer identity schema version: 2.0.0"
    }
    test "deserialization rejects an unknown marker" {
        assert wire_result(("model/identity/1.0.0/gpt2/smollm/" + F_VOCAB) + "/0,2") ≡ "unknown tokenizer identity marker"
    }
    test "deserialization rejects a malformed wire form" {
        assert wire_result("tokenizer/identity/1.0.0/gpt2") ≡ "malformed tokenizer identity wire form"
    }
    test "deserialization rejects an un-admitted kind" {
        assert wire_result(("tokenizer/identity/1.0.0/llama/smollm/" + F_VOCAB) + "/0,2") ≡ "un-admitted tokenizer kind: llama (pinned row is gpt2 / byte-level BPE)"
    }
    test "deserialization rejects a malformed digest" {
        assert wire_result("tokenizer/identity/1.0.0/gpt2/smollm/zz/0,2") ≡ "malformed vocabulary digest"
    }
}

# -- pinned probe id-list parsing (fail-closed) -----------------------------------

describe "pinned id-list parsing" {
    test "empty fixture parses to an empty list (P4)" {
        do {
            const list<int> ids ← tokenizator.proba_ida("")
            assert ids.longitudo() ≡ 0
        }
        catch err {
            assert false
        }
    }
    test "a non-digit id fails closed" {
        do {
            const list<int> ids ← tokenizator.proba_ida("1,xx")
            assert false
        }
        catch err {
            assert tokenizator.causa(err) ≡ "non-digit token id in pinned fixture"
        }
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U2 — artifact-backed byte-level BPE core (word-level oracle).
#
# The three word-level differential rows pinned by the delivery oracle
# (llama-tokenize 10150 `dee2a846b` on Qwen3.6-35B-A3B-UD-Q4_K_M.gguf):
#   transformers -> [4549, 382]
#   สวัสดี       -> [34469, 168607]
#   人工智能      -> [109015]
#
# No artifact bytes are committed. The fixture corpora below are structural
# models of those rows: the pinned tokens sit at their pinned ids in the vocab
# array and the merge table carries exactly the ranked merge pairs the real
# BPE applies to the three words (cited from the delivery oracle; the exact
# merge sequences were re-derived against the pinned tool). U1 pins the
# artifact counts (248320 tokens / 247587 merges / special ids) as the input
# contract on its own fixture corpus.
# ---------------------------------------------------------------------------

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Pinned word-level id lists (the delivery oracle rows).
const string PINNATA_U2_A ← "4549,382"
const string PINNATA_U2_B ← "34469,168607"
const string PINNATA_U2_C ← "109015"

# -- GGUF wire builders (structural corpus; the builder stays in byte space
# -- because the package proba surface has no textus→octeti extraction arm).

fn _u32(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>]
}

fn _u64(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>, ((n ⇒ 32) % 256) ∷ int<u8>, ((n ⇒ 40) % 256) ∷ int<u8>, ((n ⇒ 48) % 256) ∷ int<u8>, ((n ⇒ 56) % 256) ∷ int<u8>]
}

fn _iunge(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    for from a const x {
        out.appende(x)
    }
    for from b const x {
        out.appende(x)
    }
    return out
}

# GGUF string element encoding: u64 length + UTF-8 bytes.
fn _elementum(list<int<u8>> bytes) → list<int<u8>> {
    return _iunge(_u64(bytes.longitudo()), bytes)
}

# Repeat one string element encoding `count` times (fixture vocab padding).
fn _stringarum_itera(int count, list<int<u8>> bytes) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ count {
        for from bytes const b {
            out.appende(b)
        }
        i ↑
    }
    return out
}

fn _kv_bytes(list<int<u8>> key, int typo, list<int<u8>> value) → list<int<u8>> {
    return _iunge(_iunge(_elementum(key), _u32(typo)), value)
}

fn _array(int typo, int count, list<int<u8>> value) → list<int<u8>> {
    return _iunge(_iunge(_u32(typo), _u64(count)), value)
}

fn _cum_padding(list<int<u8>> table, int concordatio, int total, bool extra_data) → manifestum.CorpusGguf {
    const int data_offset ← (((table.longitudo() + concordatio) - 1) / concordatio) * concordatio
    var list<int<u8>> b ← table
    while b.longitudo() ≺ data_offset {
        b.appende(0 ∷ int<u8>)
    }
    if extra_data {
        b.appende(0 ∷ int<u8>)
    }
    # Explicit conversio: the type-directed `fixum octeti o ← b` form lowers
    # to an identity at runtime and the stepper panics on lists built through
    # the _iunge chain ("octeti conversio carried a non-octeti value").
    const bytes o ← b ↦ octeti
    return manifestum.CorpusGguf { map = o, longitudo_artifacti = total, identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = total } }
}

fn _plenum(list<int<u8>> table, int concordatio, int payload) → manifestum.CorpusGguf {
    const int data_offset ← (((table.longitudo() + concordatio) - 1) / concordatio) * concordatio
    return _cum_padding(table, concordatio, data_offset + payload, false)
}

# Corpus with a tokenizer model declaration, a tokens array and a merges
# array. The three metadata keys are fixed byte spellings.
fn _corpus_binae(list<int<u8>> modelum, list<int<u8>> tokens, int tokenum, list<int<u8>> merges, int mergum) → manifestum.CorpusGguf {
    var list<int<u8>> table ← _iunge(_iunge([71, 71, 85, 70], _u32(3)), _iunge(_u64(0), _u64(3)))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 111, 100, 101, 108], 8, _elementum(modelum)))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115], 9, _array(8, tokenum, tokens)))
    table ← _iunge(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 101, 114, 103, 101, 115], 9, _array(8, mergum, merges)))
    return _plenum(table, 32, 0)
}

# Main fixture: the pinned tokens at their pinned ids (max id 168607 →
# 168608 vocab entries) with a one-byte placeholder elsewhere, plus the exact
# ranked merge pairs the real BPE applies to the three words (31 entries).
fn _corpus_principalis() → manifestum.CorpusGguf {
    const list<int<u8>> ding ← _elementum([33])
    var list<int<u8>> tokens ← _stringarum_itera(382, ding)
    tokens ← _iunge(tokens, _elementum([101, 114, 115]))
    tokens ← _iunge(tokens, _stringarum_itera(4166, ding))
