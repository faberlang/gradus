+++
locale = "en"
+++
# Co-located package test for tokenizer.fab (PML2-U4 tokenizer identity,
# tokenizer-identity-schema-1.0.0). Not importable; discovered only by the
# faber test path.
#
# Proves, at compile level: the pinned llama.cpp probe fixtures parse to the
# exact pinned id lists (P1–P11 + four workload lists 9/9/202/2175), the
# fail-closed probe-parity admission (verify_probe: exact match admits,
# any divergence fails closed), the versioned identity record (construct happy
# row + every typed rejection path), self-verification, the KV identity key
# component (MD-A9), the identity wire round-trip + version rejection, and
# the G3 runtime BBPE encoder (tokenize over SmolLM2 tables produces the
# pinned P1–P11 ids; unmapped bytes fail closed).
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
#
# NOTE (pinned fixtures): the id lists are cited read-only from
# evidence/contract-tokenize-probes.txt (P1–P11) and gi0-workloads.md §3
# (workload lists). The 24-case differential vs llama-tokenize 10150 is
# cited read-only from gi1-closeout.md — the runtime owner reproduces it;
# this contract pins the expected ids.

import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" gguf_manifest
import from "gradus:tokenizer" tokenizer

# -- pinned-row fixture facts -------------------------------------------------

const string F_SCHEMA ← "1.0.0"
const string F_KIND ← "gpt2"
const string F_PRE ← "smollm"
const string F_VOCAB ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
const string F_ALIA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# -- helpers -------------------------------------------------------------------

# verify_probe outcome as text ("ok" or the typed error's message).
fn probe_result(string name, list<int> observed) → string {
    do {
        const bool ok ← tokenizer.verify_probe(name, observed)
        return "ok"
    }
    catch err {
        return tokenizer.message(err)
    }
}

# construct outcome as text ("ok" on success, or the typed error's message).
fn construct_result(string schema, string merge_kind, string pre_tokenizer, string vocab_digest, string eog, bool bos_free, bool space_free) → string {
    do {
        const tokenizer.TokenizerIdentity t ← tokenizer.construct(schema, merge_kind, pre_tokenizer, vocab_digest, eog, bos_free, space_free)
        return "ok"
    }
    catch err {
        return tokenizer.message(err)
    }
}

# verify outcome as text.
fn verify_result(tokenizer.TokenizerIdentity t) → string {
    do {
        const bool ok ← tokenizer.verify(t)
        return "ok"
    }
    catch err {
        return tokenizer.message(err)
    }
}

# key outcome as text ("ok|key" or the typed error's message).
fn tokenizer_key_result(tokenizer.TokenizerIdentity t) → string {
    do {
        const string k ← tokenizer.tokenizer_key(t)
        return "ok|" + k
    }
    catch err {
        return tokenizer.message(err)
    }
}

# Wire round-trip predicate: deserialize(serializa(t)) reproduces t.
fn wire_roundtrip(tokenizer.TokenizerIdentity t) → bool {
    do {
        const tokenizer.TokenizerIdentity back ← tokenizer.deserialize_identity(tokenizer.serialize_identity(t))
        if back.merge_kind() ≠ t.merge_kind() then return false
        if back.pre_tokenizer() ≠ t.pre_tokenizer() then return false
        if back.vocab_digest() ≠ t.vocab_digest() then return false
        if back.eog() ≠ t.eog() then return false
        return true
    }
    catch err {
        return false
    }
}

# Wire outcome as text ("ok" or the typed error's message).
fn wire_result(string wire) → string {
    do {
        const tokenizer.TokenizerIdentity t ← tokenizer.deserialize_identity(wire)
        return "ok"
    }
    catch err {
        return tokenizer.message(err)
    }
}

# -- pinned probe fixtures (P1–P11, read-only from contract-tokenize-probes.txt) ---

describe "pinned llama.cpp probe parity" {
    test "P1 Hello world parses to the pinned ids" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("p1"))
            assert tokenizer.probe_equal(ids, [19556, 905])
        }
        catch err {
            assert false
        }
    }
    test "P2 equals P1 (BOS-free: no auto-prepend)" {
        do {
            const list<int> a ← tokenizer.probe_id(tokenizer.pinned_probe("p1"))
            const list<int> b ← tokenizer.probe_id(tokenizer.pinned_probe("p2"))
            assert tokenizer.probe_equal(a, b)
        }
        catch err {
            assert false
        }
    }
    test "P4 empty prompt stays empty (no BOS)" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("p4"))
            assert ids.length() ≡ 0
        }
        catch err {
            assert false
        }
    }
    test "P5 <|im_start|> parses to BOS special id 1" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("p5"))
            assert tokenizer.probe_equal(ids, [1])
        }
        catch err {
            assert false
        }
    }
    test "P6 <|im_start|> literal with --no-parse-special (BPE bytes)" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("p6"))
            assert tokenizer.probe_equal(ids, [44, 108, 306, 79, 3738, 108, 46])
        }
        catch err {
            assert false
        }
    }
    test "P5 vs P6 special-parse on/off parity" {
        do {
            const list<int> on ← tokenizer.probe_id(tokenizer.pinned_probe("p5"))
            const list<int> off ← tokenizer.probe_id(tokenizer.pinned_probe("p6"))
            assert not (tokenizer.probe_equal(on, off))
        }
        catch err {
            assert false
        }
    }
    test "P7 <|im_end|> parses to EOS special id 2" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("p7"))
            assert tokenizer.probe_equal(ids, [2])
        }
        catch err {
            assert false
        }
    }
    test "P8 <|endoftext|> parses to id 0" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("p8"))
            assert tokenizer.probe_equal(ids, [0])
        }
        catch err {
            assert false
        }
    }
    test "P9 chat-template prefix is the pinned 32 ids" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("p9"))
            assert ids.length() ≡ 32
            assert tokenizer.probe_equal(ids, [1, 9690, 198, 2683, 359, 253, 5356, 5646, 11173, 3365, 3511, 308, 34519, 28, 7018, 411, 407, 19712, 8182, 2, 198, 1, 4093, 198, 26843, 665, 2, 198, 1, 520, 9531, 198])
        }
        catch err {
            assert false
        }
    }
    test "P10 lazy-dog reference is the pinned 9 ids" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("p10"))
            assert ids.length() ≡ 9
            assert tokenizer.probe_equal(ids, [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767])
        }
        catch err {
            assert false
        }
    }
    test "P11 leading spaces is space-prefix-free (pinned 3 ids)" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("p11"))
            assert ids.length() ≡ 3
            assert tokenizer.probe_equal(ids, [216, 2899, 5600])
        }
        catch err {
            assert false
        }
    }
}

# -- workload id lists (gi0-workloads.md §3: 9 / 9 / 202 / 2175) ----------------

describe "pinned workload id lists" {
    test "correctness workload is the pinned 9 ids" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("correctio"))
            assert ids.length() ≡ 9
            assert tokenizer.probe_equal(ids, [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767])
        }
        catch err {
            assert false
        }
    }
    test "short workload is the pinned 9 ids" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("brevis"))
            assert ids.length() ≡ 9
            assert tokenizer.probe_equal(ids, [19161, 253, 421, 30614, 563, 260, 5065, 30, 198])
        }
        catch err {
            assert false
        }
    }
    test "normal workload pins 202 ids and its head/tail match the fixture" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("normale"))
            assert ids.length() ≡ 202
            assert (ids.get(0) coalesce 0) ≡ 504
            assert (ids.get(201) coalesce 0) ≡ 30
        }
        catch err {
            assert false
        }
    }
    test "context workload pins 2175 ids and its head/tail match the fixture" {
        do {
            const list<int> ids ← tokenizer.probe_id(tokenizer.pinned_probe("contextus"))
            assert ids.length() ≡ 2175
            assert (ids.get(0) coalesce 0) ≡ 54
            assert (ids.get(2174) coalesce 0) ≡ 198
        }
        catch err {
            assert false
        }
    }
}

# -- probe-parity admission (fail-closed) ---------------------------------------

describe "probe-parity admission" {
    test "exact id match admits" {
        assert probe_result("p10", [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767]) ≡ "ok"
    }
    test "a diverging id list fails closed as a different tokenizer" {
        assert probe_result("p10", [504, 2365, 6354, 16438, 27003, 690, 260, 23790]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p10"
    }
    test "a reordered id list fails closed (order matters — ids are sequences)" {
        assert probe_result("p11", [905, 19556]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p11"
    }
    test "a length-mismatched id list fails closed" {
        assert probe_result("p6", [44, 108, 306, 79, 3738, 108]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p6"
    }
    test "unknown probe name fails closed" {
        assert probe_result("p99", [1]) ≡ "unknown pinned probe: p99"
    }
}

# -- versioned identity record ----------------------------------------------------

describe "versioned tokenizer identity" {
    test "construct admits the pinned-row identity" {
        assert construct_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true) ≡ "ok"
    }
    test "the identity stamps the schema and carries the pinned facts" {
        do {
            const tokenizer.TokenizerIdentity t ← tokenizer.construct(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            assert t.schema() ≡ "1.0.0"
            assert t.merge_kind() ≡ "gpt2"
            assert t.pre_tokenizer() ≡ "smollm"
            assert t.vocab_digest() ≡ F_VOCAB
            assert t.eog() ≡ "0,2"
            assert t.bos_free()
            assert t.space_free()
        }
        catch err {
            assert false
        }
    }
    test "verify passes on an admitted identity" {
        do {
            const tokenizer.TokenizerIdentity t ← tokenizer.construct(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            assert verify_result(t) ≡ "ok"
        }
        catch err {
            assert false
        }
    }
    test "rejects an unknown schema version" {
        assert construct_result("2.0.0", F_KIND, F_PRE, F_VOCAB, "0,2", true, true) ≡ "unknown tokenizer identity schema version: 2.0.0"
    }
    test "rejects an un-admitted tokenizer kind" {
        assert construct_result(F_SCHEMA, "llama", F_PRE, F_VOCAB, "0,2", true, true) ≡ "un-admitted tokenizer kind: llama (pinned row is gpt2 / byte-level BPE)"
    }
    test "rejects an un-admitted pre-tokenizer" {
        assert construct_result(F_SCHEMA, F_KIND, "gpt2", F_VOCAB, "0,2", true, true) ≡ "un-admitted pre-tokenizer: gpt2 (pinned row is smollm)"
    }
    test "rejects a malformed vocabulary digest" {
        assert construct_result(F_SCHEMA, F_KIND, F_PRE, "zz", "0,2", true, true) ≡ "malformed vocabulary digest"
    }
    test "rejects a malformed EOG set" {
        assert construct_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "2,0", true, true) ≡ "malformed EOG set"
        # PIN ADDED (correctness-fix slice): a well-formed-but-different
        # EOG set fails the exact pinned-value admission.
        assert construct_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "1,5", true, true) ≡ "EOG set does not match the pinned row: 1,5"
    }
    test "is_eog admits exactly the pinned EOG set {0, 2} (the generation stop-policy binding)" {
        assert tokenizer.is_eog(0)
        assert tokenizer.is_eog(2)
        assert not (tokenizer.is_eog(1))
        assert not (tokenizer.is_eog(3))
    }
    test "rejects a non-BOS-free row (pinned row is BOS-free)" {
        assert construct_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", false, true) ≡ "pinned row is BOS-free (add_bos_token = false)"
    }
    test "rejects a space-prefixed row (pinned row is space-prefix-free)" {
        assert construct_result(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, false) ≡ "pinned row is space-prefix-free (add_space_prefix = false)"
    }
}

# -- KV identity key component (MD-A9 precedent) ---------------------------------

describe "KV identity key component" {
    test "tokenizer_key renders the deterministic tokenizer identity component" {
        do {
            const tokenizer.TokenizerIdentity t ← tokenizer.construct(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            const string k ← tokenizer.tokenizer_key(t)
            assert k ≡ ("tokenizer/identity/1.0.0/gpt2/smollm/" + F_VOCAB) + "/0,2/bos-free=true/space-prefix-free=true"
        }
        catch err {
            assert false
        }
    }
    test "tokenizer_key is deterministic (two identical identities → identical key)" {
        do {
            const tokenizer.TokenizerIdentity a ← tokenizer.construct(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            const tokenizer.TokenizerIdentity b ← tokenizer.construct(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            assert tokenizer_key_result(a) ≡ tokenizer_key_result(b)
        }
        catch err {
            assert false
        }
    }
    test "tokenizer_key is identity-sensitive (a different vocab digest changes the key)" {
        do {
            const tokenizer.TokenizerIdentity a ← tokenizer.construct(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            const tokenizer.TokenizerIdentity b ← tokenizer.construct(F_SCHEMA, F_KIND, F_PRE, F_ALIA, "0,2", true, true)
            assert not (tokenizer_key_result(a) ≡ tokenizer_key_result(b))
        }
        catch err {
            assert false
        }
    }
    test "tokenizer_key fails closed on an un-admitted identity" {
        do {
            const tokenizer.TokenizerIdentity t ← tokenizer.construct(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            assert tokenizer_key_result(t) ≡ ("ok|tokenizer/identity/1.0.0/gpt2/smollm/" + F_VOCAB) + "/0,2/bos-free=true/space-prefix-free=true"
        }
        catch err {
            assert false
        }
    }
}

# -- identity wire form (versioned) ------------------------------------------------

describe "tokenizer identity wire" {
    test "serialize/deserialize round-trips the identity" {
        do {
            const tokenizer.TokenizerIdentity t ← tokenizer.construct(F_SCHEMA, F_KIND, F_PRE, F_VOCAB, "0,2", true, true)
            assert wire_roundtrip(t)
        }
        catch err {
            assert false
        }
    }
    test "deserialization rejects an unknown schema version" {
        assert wire_result(("tokenizer/identity/2.0.0/gpt2/smollm/" + F_VOCAB) + "/0,2") ≡ "unknown tokenizer identity schema version: 2.0.0"
    }
    test "deserialization rejects an unknown marker" {
        assert wire_result(("model/identity/1.0.0/gpt2/smollm/" + F_VOCAB) + "/0,2") ≡ "unknown tokenizer identity marker"
    }
    test "deserialization rejects a malformed wire form" {
        assert wire_result("tokenizer/identity/1.0.0/gpt2") ≡ "malformed tokenizer identity wire form"
    }
    test "deserialization rejects an un-admitted kind" {
        assert wire_result(("tokenizer/identity/1.0.0/llama/smollm/" + F_VOCAB) + "/0,2") ≡ "un-admitted tokenizer kind: llama (pinned row is gpt2 / byte-level BPE)"
    }
    test "deserialization rejects a malformed digest" {
        assert wire_result("tokenizer/identity/1.0.0/gpt2/smollm/zz/0,2") ≡ "malformed vocabulary digest"
    }
}

# -- pinned probe id-list parsing (fail-closed) -----------------------------------

describe "pinned id-list parsing" {
    test "empty fixture parses to an empty list (P4)" {
        do {
            const list<int> ids ← tokenizer.probe_id("")
            assert ids.length() ≡ 0
        }
        catch err {
            assert false
        }
    }
    test "a non-digit id fails closed" {
        do {
            const list<int> ids ← tokenizer.probe_id("1,xx")
            assert false
        }
        catch err {
            assert tokenizer.message(err) ≡ "non-digit token id in pinned fixture"
        }
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U2 — artifact-backed byte-level BPE core (word-level oracle).
#
# The three word-level differential rows pinned by the delivery oracle
# (llama-tokenize 10150 `dee2a846b` on Qwen3.6-35B-A3B-UD-Q4_K_M.gguf):
#   transformers -> [4549, 382]
#   สวัสดี       -> [34469, 168607]
#   人工智能      -> [109015]
#
# No artifact bytes are committed. The fixture corpora below are structural
# models of those rows: the pinned tokens sit at their pinned ids in the vocab
# array and the merge table carries exactly the ranked merge pairs the real
# BPE applies to the three words (cited from the delivery oracle; the exact
# merge sequences were re-derived against the pinned tool). U1 pins the
# artifact counts (248320 tokens / 247587 merges / special ids) as the input
# contract on its own fixture corpus.
# ---------------------------------------------------------------------------

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Pinned word-level id lists (the delivery oracle rows).
const string PINNED_U2_A ← "4549,382"
const string PINNED_U2_B ← "34469,168607"
const string PINNED_U2_C ← "109015"

# -- GGUF wire builders (structural corpus; the builder stays in byte space
# -- because the package .proba surface has no text→bytes extraction arm).

fn _u32(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>]
}

fn _u64(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>, ((n ⇒ 32) % 256) ∷ int<u8>, ((n ⇒ 40) % 256) ∷ int<u8>, ((n ⇒ 48) % 256) ∷ int<u8>, ((n ⇒ 56) % 256) ∷ int<u8>]
}

fn _join(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

# GGUF string element encoding: u64 length + UTF-8 bytes.
fn _elementum(list<int<u8>> bytes) → list<int<u8>> {
    return _join(_u64(bytes.length()), bytes)
}

# Repeat one string element encoding `count` times (fixture vocab padding).
fn _stringarum_itera(int count, list<int<u8>> bytes) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ count {
        for from bytes const b {
            out.append(b)
        }
        i ↑
    }
    return out
}

fn _kv_bytes(list<int<u8>> key, int kind, list<int<u8>> value) → list<int<u8>> {
    return _join(_join(_elementum(key), _u32(kind)), value)
}

fn _array(int kind, int count, list<int<u8>> value) → list<int<u8>> {
    return _join(_join(_u32(kind), _u64(count)), value)
}

fn _cum_padding(list<int<u8>> table, int alignment, int total, bool extra_data) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    if extra_data {
        b.append(0 ∷ int<u8>)
    }
    # Explicit conversion: the type-directed `const bytes o ← b` form lowers
    # to an identity at runtime and the stepper panics on lists built through
    # the _join chain ("bytes conversion carried a non-bytes value").
    const bytes o ← b ↦ bytes
    return gguf_manifest.GgufCorpus { table = o, artifact_length = total, identity = artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = total } }
}

fn _plenum(list<int<u8>> table, int alignment, int payload) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    return _cum_padding(table, alignment, data_offset + payload, false)
}

# Corpus with a tokenizer model declaration, a tokens array and a merges
# array. The three metadata keys are fixed byte spellings.
fn _corpus_binae(list<int<u8>> modelum, list<int<u8>> tokens, int token_count, list<int<u8>> merges, int mergum) → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _join(_join([71, 71, 85, 70], _u32(3)), _join(_u64(0), _u64(3)))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 111, 100, 101, 108], 8, _elementum(modelum)))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115], 9, _array(8, token_count, tokens)))
    table ← _join(table, _kv_bytes([116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 101, 114, 103, 101, 115], 9, _array(8, mergum, merges)))
    return _plenum(table, 32, 0)
}

# Main fixture: the pinned tokens at their pinned ids (max id 168607 →
# 168608 vocab entries) with a one-byte placeholder elsewhere, plus the exact
# ranked merge pairs the real BPE applies to the three words (31 entries).
fn _corpus_principalis() → gguf_manifest.GgufCorpus {
    const list<int<u8>> ding ← _elementum([33])
    var list<int<u8>> tokens ← _stringarum_itera(382, ding)
    tokens ← _join(tokens, _elementum([101, 114, 115]))
    tokens ← _join(tokens, _stringarum_itera(4166, ding))
    tokens ← _join(tokens, _elementum([116, 114, 97, 110, 115, 102, 111, 114, 109]))
    tokens ← _join(tokens, _stringarum_itera(29919, ding))
    tokens ← _join(tokens, _elementum([195, 160, 194, 184, 194, 170]))
    tokens ← _join(tokens, _stringarum_itera(74545, ding))
    tokens ← _join(tokens, _elementum([195, 164, 194, 186, 194, 186, 195, 165, 194, 183, 194, 165, 195, 166, 196, 187, 194, 186, 195, 168, 196, 165, 194, 189]))
    tokens ← _join(tokens, _stringarum_itera(59591, ding))
    tokens ← _join(tokens, _elementum([195, 160, 194, 184, 194, 167, 195, 160, 194, 184, 194, 177, 195, 160, 194, 184, 194, 170, 195, 160, 194, 184, 196, 182, 195, 160, 194, 184, 194, 181]))
    var list<int<u8>> merges ← _elementum([101, 32, 114])
    merges ← _join(merges, _elementum([111, 32, 114]))
