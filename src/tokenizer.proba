# chat_template metadata value as textus: "ok|<template>" or "ERR|<causa>".
fn _chat_template_resultum(manifestum.CorpusGguf corpus) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            return "ok|" + tokenizator.chat_template(t)
        }
        catch err {
            return "ERR|" + tokenizator.causa(err)
        }
    }
    catch err {
        return "ERR|" + manifestum.causa(err)
    }
}

# Minimal user-turn render as textus: "ok|<rendered>" or "ERR|<causa>".
fn _redde_resultum(manifestum.CorpusGguf corpus, string content) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tokenizator.Tokenizator t ← tokenizator.fabricare(m)
            return "ok|" + tokenizator.redde_turnum_user(t, content)
        }
        catch err {
            return "ERR|" + tokenizator.causa(err)
        }
    }
    catch err {
        return "ERR|" + manifestum.causa(err)
    }
}

# Sublist equality: a[ini .. ini + b.longitudo()) matches b element-wise.
fn _sublista_aequa(list<int> a, int ini, list<int> b) → bool {
    if ini + b.longitudo() ≻ a.longitudo() then return false
    var int i ← 0
    while i ≺ b.longitudo() {
        if (a.accipe(ini + i) coalesce 0) ≠ (b.accipe(i) coalesce 0) then return false
        i ← i + 1
    }
    return true
}

describe "LIB-02-U3-6 chat-template policy (metadata + minimal user-turn)" {
    test "tokenizer.chat_template loads from the artifact metadata" {
        assert _chat_template_resultum(_corpus_chat()) ≡ "ok|" + F_TEMPLATE
    }
    test "the minimal user-turn render applies the pinned ChatML shape" {
        assert _redde_resultum(_corpus_chat(), PROBE_B) ≡ "ok|<|im_start|>user\n你好，世界！今天是2026年8月13日 🎉<|im_end|>\n"
    }
    test "the rendered user turn encodes to the exact pinned ids (R1, parse-special on)" {
        assert _encoda_promptum_specialia_resultum(_corpus_chat(), ("<|im_start|>user\n" + PROBE_B) + "<|im_end|>\n") ≡ "ok|" + PINNATA_U3_6_R1
    }
    test "the rendered user turn encodes to the exact pinned ids (R1b, no-parse-special literal)" {
        assert _encoda_promptum_resultum(_corpus_chat(), ("<|im_start|>user\n" + PROBE_B) + "<|im_end|>\n") ≡ "ok|" + PINNATA_U3_6_R1B
    }
    test "the assistant turn prefix encodes to the exact pinned ids (R2)" {
        assert _encoda_promptum_specialia_resultum(_corpus_chat_assistant(), "<|im_start|>assistant\n") ≡ "ok|" + PINNATA_U3_6_R2
    }
    test "the ChatML path composes without changing the pinned Probe B ids" {
        const string r ← _encoda_promptum_specialia_resultum(_corpus_chat(), ("<|im_start|>user\n" + PROBE_B) + "<|im_end|>\n")
        assert r ≡ "ok|" + PINNATA_U3_6_R1
        const list<int> ids ← tokenizator.proba_ida(r.sectio(3, r.longitudo()))
        const list<int> probe_b ← tokenizator.proba_ida(PINNATA_U3_6_PROBE_B)
        assert ids.longitudo() ≡ 23
        assert (ids.accipe(0) coalesce 0) ≡ 248045
        assert (ids.accipe(1) coalesce 0) ≡ 846
        assert (ids.accipe(2) coalesce 0) ≡ 198
        assert (ids.accipe(21) coalesce 0) ≡ 248046
        assert (ids.accipe(22) coalesce 0) ≡ 198
        assert _sublista_aequa(ids, 3, probe_b)
    }
    test "an artifact without a chat template fails the render closed (no hard-coded fallback)" {
        assert _chat_template_resultum(_corpus_minor()) ≡ "ok|"
        assert _redde_resultum(_corpus_minor(), "x") ≡ "ERR|artifact declares no chat template"
    }
}

# ---------------------------------------------------------------------------
# LIB-02-U3-7 — Full two-probe composition + divergence receipts.
#
# The complete composed runtime (qwen35 scanner + BPE core + special policy +
# EOG/BOS + chat policy, LIB-02-U3-1..U3-6) encodes Probe A and Probe B to
# the exact pinned id lists and decodes them back to the exact prompts. Probe
# rows are raw-prompt rows, never through the template (the rendered-turn
# path is proven separately by U3-6's R1/R1b/R2 rows). Probe A runs on its
# own structural fixture (pinned tokens at their pinned ids, the exact ranked
# merge pairs the real BPE applies, re-derived against oracle 10150
# `dee2a846b` on the target artifact); Probe B reuses the U3-6 chat fixture
# whose words already sit at the pinned ids. Divergence receipts (fixture
# doc `fixtures/tokenizer/pinned-probe-oracle.md`) name the first divergent
# probe id or decoded character and route the repair (campaign rule 5).
# ---------------------------------------------------------------------------

