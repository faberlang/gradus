+++
locale = "en"
+++
# Loss functions facade.
#
# Public import: import from "gradus:loss" loss
#
# Production loss surface.
#
# A loss is a differentiable function, not an optimization concern. This
# module must not import from gradus:optimize or gradus:nn. No module owns a
# backend or device handle.
#
# Shape-generic loss functions over the staged tensor carrier
# (gradus:tensor NumericBlock): mse and cross_entropy. They use the staged carrier
# (runtime shapes), so their shapes are runtime facts (R3: no one-row/
# one-shape narrowing in the public API). Every failure is a typed LossError
# with a text message.
#
# The three admitted fixed-shape MSE rows above are preserved as the admitted
# caller surface; their formula is exactly the general mse() over the same
# element arithmetic (mean((p − t)²)) — one documented formula, two entry
# styles. New callers use the tensor-surface functions.
#
# --- Formulas (matching the accepted GPU-training proofs) -----------------
#   mse(p, t)        = mean((p − t)²) over all elements — the loss of the
#                      linear-regression (2×2), MLP (4×4), and BERT-tiny
#                      (2×8) training proofs.
#   cross_entropy    = mean over rows of (logsumexp(logits_row) −
#                      logits_row[target]) — the classification / next-token
#                      path. logsumexp uses the numerically stabilized form
#                      max + ln(Σ_c exp(z_c − max)); exp via the base-e
#                      exponentiation with a sign split so power is only
#                      ever called with a non-negative exponent (the accepted
#                      GELU tanh precedent), ln self-hosted by range
#                      reduction + the atanh series (no scalar log builtin
#                      exists in the compiler surface).
#
# --- Determinism contract -----------------------------------------------
# Both losses are pure, deterministic functions: no RNG, no global state, no
# hidden reduction order. Iteration is fixed row-major over the flat storage,
# so equal inputs produce bit-identical outputs. A training run seeded with
# the same data therefore reproduces identical losses; seed and checkpoint
# machinery belongs to gradus:train.
#
# --- Non-finite handling (capsule rule — fail closed, no silent tolerance) -
# Any non-finite (NaN/±Inf) value in an input fails closed with
# LossError.NonFinite before any arithmetic. Division by zero cannot occur:
# empty inputs (0 elements / 0 rows / 0 classes) fail closed first.
#
# --- Compiler-boundary notes ----------------------------------------------
#   * The staged carrier (runtime shape) exists precisely so shape-generic
#     library functions typecheck in library context (SEM014 holes do not
#     unify); this surface follows the PML3 nn/math precedent.
#   * Cross-entropy numerics: the CPU reference evaluates the documented
#     formulas in f64; this surface is f32 self-hosted. The co-located
#     proba pins the f64 oracle values within a documented 5e-4 absolute
#     tolerance (approx), matching the nn/attention/transformer
#     posture. Library-to-library calls execute on the FMIR stepper (radix
#     43c0102ba; regression-locked by 2e8042ae7); this proba remains the
#     compile-level proof of the same contract.
#
# --- Seams ----------------------------------------------------------------
#   * optimizer state, schedules, train/eval mode, metrics, and seeds (RNG)
#     belong to gradus:optimize / gradus:train. This module must not import
#     from either package.

import from "gradus:dtype" dtype

import from "gradus:shape" shape

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# LossError — typed error vocabulary of the loss surface. Every variant
# carries a text message (render via message), mirroring the tensor/shape/
# dtype/math/nn error contract.
# -------------------------------------------------------------------------


@ public
union LossError {
    @ shared
    string message

    @ conversion shape.ShapeError err {
        match err {
            case shape.ShapeError.NegativeDimension const message { return variant NegativeDimension {message = message} }
            case shape.ShapeError.DimensionAboveLimit const message { return variant DimensionAboveLimit {message = message} }
            case shape.ShapeError.ProductAboveLimit const message { return variant ProductAboveLimit {message = message} }
            case shape.ShapeError.Incompatible const message { return variant Incompatible {message = message} }
            case shape.ShapeError.ElementMismatch const message { return variant ElementMismatch {message = message} }
            case _ { return variant ShapeMismatch {message = err.message} }
        }
    }

    NegativeDimension,
    DimensionAboveLimit,
    ProductAboveLimit,
    GradusMismatch,
    ShapeMismatch,
    DtypeMismatch,
    ElementMismatch,
    Incompatible,
    NonFinite
}



# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# Bounded element count with the module's typed error mapping (ShapeError →
# LossError).
fn _numel_valid(list<int> f) → int ⇥ LossError {
    return shape.numel(f)
}

# Dtype parity + F32 gate for the pair losses (mse). Promotion is an
# explicit cast step, never implicit; only the F32 row is admitted.
fn _dtype_pair(tensor.NumericBlock a, tensor.NumericBlock b) → bool ⇥ LossError {
    const string ta ← dtype.name(a.dtype())
    const string tb ← dtype.name(b.dtype())
    require ta ≡ tb throw variant DtypeMismatch {message = "dtype mismatch"}
    require ta ≡ "f32" throw variant DtypeMismatch {message = "unsupported dtype for loss"}
    return true
}

# F32-only gate for the unary-tag loss (cross_entropy logits).
fn _dtype_f32(tensor.NumericBlock t) → bool ⇥ LossError {
    require dtype.name(t.dtype()) ≡ "f32" throw variant DtypeMismatch {message = "unsupported dtype for loss"}
    return true
}

# e^x via the base-e exponentiation with a sign split: power is only
# ever called with a non-negative exponent (1/e^{−x} for x < 0), matching
# the accepted GELU tanh precedent — no negative-power runtime claim.
const f32 E ← 2.718281828459045 ∷ f32

const f32 LN_2 ← 0.6931471805599453 ∷ f32

fn _exp(f32 x) → f32 {
    if x ≥ 0.0 then return E.power(x)
    return 1.0 / E.power(-x)
}

# ln(x) for x > 0 (callers guarantee x > 0): range-reduce x into [1, 2) by
# repeated halving/doubling, then the atanh series ln(m) = 2·Σ y^(2n+1)/(2n+1)
# with y = (m−1)/(m+1) ∈ [0, 1/3). 16 terms leave the remainder below f32
# epsilon; the k·ln(2) correction is exact to f32.
fn _log(f32 x) → f32 {
    var f32 m ← x
    var int k ← 0
    while m ≻ 2.0 {
        m ← m / 2.0
        k ← k + 1
    }
    while m ≺ 1.0 {
        m ← m * 2.0
        k ← k - 1
    }
    var f32 y ← (m - 1.0) / (m + 1.0)
    var f32 y2 ← y * y
    var f32 term ← y
    var f32 sum ← y
    for range 1‥16 const n {
        term ← term * y2
        sum ← sum + term / ((2 * n + 1) ↦ f32)
    }
    return 2.0 * sum + (k ↦ f32) * LN_2
}

# -------------------------------------------------------------------------
# Family: mse — mean((prediction − target)²) over the staged carrier.
# Any shape (the admitted 2×2 / 4×4 / 2×8 rows included); the shape must
# match, both operands must be F32-tagged, and every input value must be
# finite (fail closed). Deterministic: fixed row-major iteration, no RNG.
# -------------------------------------------------------------------------

@ public
fn mse(tensor.NumericBlock prediction, tensor.NumericBlock target) → f32 ⇥ LossError {
    const list<int> fp ← prediction.shape()
    const list<int> ft ← target.shape()
    require fp ≡ ft throw variant ShapeMismatch {message = "prediction and target shapes differ"}
    _dtype_pair(prediction, target)
    const int total ← _numel_valid(fp)
    require total ≠ 0 throw variant ElementMismatch {message = "empty loss input"}
    for from prediction.data const v {
        require dtype.finite(v) throw variant NonFinite {message = "non-finite prediction"}
    }
    for from target.data const v {
        require dtype.finite(v) throw variant NonFinite {message = "non-finite target"}
    }
    var f32 acc ← 0.0 ∷ f32
    for range 0‥total const i {
        const f32 p ← prediction.data.get(i) coalesce 0.0 ∷ f32
        const f32 t ← target.data.get(i) coalesce 0.0 ∷ f32
        const f32 d ← p - t
        acc ← acc + d * d
    }
    return acc / (total ↦ f32)
}

# -------------------------------------------------------------------------
# Family: cross_entropy — mean over rows of (logsumexp(logits_row) −
# logits_row[target]) over the staged carrier. The classification /
# next-token path: logits are rank-2 [N, C] F32; target is rank-1 [N]
# I32-tagged class indices (the integer domain of the dtype lattice). Row
# logsumexp uses the stabilized max + ln(Σ exp(z − max)) form. Labels must
# be exact integers in [0, C) and all inputs finite (fail closed).
# Deterministic: fixed row-major iteration, no RNG.
# -------------------------------------------------------------------------

@ public
fn cross_entropy(tensor.NumericBlock logits, tensor.NumericBlock target) → f32 ⇥ LossError {
    const list<int> fl ← logits.shape()
    require fl.length() ≡ 2 throw variant GradusMismatch {message = "cross_entropy requires rank-2 logits"}
    _dtype_f32(logits)
    require dtype.name(target.dtype()) ≡ "i32" throw variant DtypeMismatch {message = "cross_entropy target must be i32 class indices"}
    const int n ← fl.get(0) coalesce 1
    const int c ← fl.get(1) coalesce 1
    require n ≠ 0 throw variant ElementMismatch {message = "empty batch"}
    require c ≠ 0 throw variant ElementMismatch {message = "empty class axis"}
    const list<int> ft ← target.shape()
    require ft.length() ≡ 1 throw variant GradusMismatch {message = "cross_entropy target must be rank-1"}
    require ft.get(0) coalesce 1 ≡ n throw variant ShapeMismatch {message = "target length does not match logits rows"}
    const int total ← _numel_valid(fl)
    const int rows ← total / c
    for from logits.data const v {
        require dtype.finite(v) throw variant NonFinite {message = "non-finite logits"}
    }
    var f32 acc ← 0.0 ∷ f32
    for range 0‥rows const row {
        const f32 lbl ← target.data.get(row) coalesce 0.0 ∷ f32
        require dtype.finite(lbl) throw variant NonFinite {message = "non-finite target"}
        const int k ← lbl.truncate()
        require (k ↦ f32) ≡ lbl throw variant Incompatible {message = "target must be integer class indices"}
        require not (k ≺ 0 or k ≥ c) throw variant Incompatible {message = "target class out of range"}
        var f32 max ← logits.data.get(row * c) coalesce 0.0 ∷ f32
        for range 1‥c const j {
            const f32 z ← logits.data.get(row * c + j) coalesce 0.0 ∷ f32
            if z ≻ max {
                max ← z
            }
        }
        var f32 s ← 0.0 ∷ f32
        for range 0‥c const jj {
            const f32 z ← logits.data.get(row * c + jj) coalesce 0.0 ∷ f32
            s ← s + _exp(z - max)
        }
        const f32 lse ← max + _log(s)
        const f32 zk ← logits.data.get(row * c + k) coalesce 0.0 ∷ f32
        acc ← acc + (lse - zk)
    }
    return acc / (rows ↦ f32)
}

# -------------------------------------------------------------------------
# mse_2x2 — mean((prediction − target)²) (2×2 f32, linear-regression shape)
# -------------------------------------------------------------------------

@ kernel
@ public
fn mse_2x2(tensor<f32, [2, 2]> prediction, tensor<f32, [2, 2]> target) → f32 {
    const _ residual ← prediction - target
    const _ squared ← residual ⊙ residual
    return squared.mean()
}

# -------------------------------------------------------------------------
# mse_4x4 — mean((prediction − target)²) (4×4 f32, MLP shape)
# -------------------------------------------------------------------------

@ kernel
@ public
fn mse_4x4(tensor<f32, [4, 4]> prediction, tensor<f32, [4, 4]> target) → f32 {
    const _ residual ← prediction - target
    const _ squared ← residual ⊙ residual
    return squared.mean()
}

# -------------------------------------------------------------------------
# mse_2x8 — mean((prediction − target)²) (2×8 f32, BERT-tiny shape)
# -------------------------------------------------------------------------

@ kernel
@ public
fn mse_2x8(tensor<f32, [2, 8]> prediction, tensor<f32, [2, 8]> target) → f32 {
    const _ residual ← prediction - target
    const _ squared ← residual ⊙ residual
    return squared.mean()
}
