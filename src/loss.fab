# Loss functions facade.
#
# Public import: importa ex "gradus:loss" privata loss
#
# S4-A (gpu-training-lowering stage-4-delivery.md): first concrete
# static-shape loss — MSE, bounded to the first two callers (linear
# regression 2×2, MLP 4×4).
#
# S6-G1 (gpu-training-lowering stage-6-delivery.md): BERT-tiny shape —
# mse_2x8.
#
# Architectural rule: a loss is a differentiable function, not an optimization
# concern. This module must not import from gradus:optimize or gradus:nn.
# No module owns a backend or device handle.
#
# PML0-U3 ledger disposition (pml0-proof-api-ledger.md, gradus 33df687) —
# executed at PML1-U6: all three fixed-shape losses are ADMITTED as
# caller-backed public API (grep-verified live callers in package code):
#   mse_2x2 row 7 — examples/training/linear-regression/src/train.fab:94
#   mse_4x4 row 8 — examples/training/mlp/src/train.fab:153
#   mse_2x8 row 9 — bert-tiny-fragment train.fab:375;
#                   bert-gradus-probe train.fab:356,373

# -------------------------------------------------------------------------
# mse_2x2 — mean((prediction − target)²) (2×2 f32, linear-regression shape)
# -------------------------------------------------------------------------

functio mse_2x2(
    tensor<f32, [2,2]> prediction,
    tensor<f32, [2,2]> target
) → f32 {
    fixum tensor<f32, [2,2]> residual ← prediction.subtrahe(target)
    fixum tensor<f32, [2,2]> squared  ← residual.multiplica(residual)
    redde squared.media()
}

# -------------------------------------------------------------------------
# mse_4x4 — mean((prediction − target)²) (4×4 f32, MLP shape)
# -------------------------------------------------------------------------

functio mse_4x4(
    tensor<f32, [4,4]> prediction,
    tensor<f32, [4,4]> target
) → f32 {
    fixum tensor<f32, [4,4]> residual ← prediction.subtrahe(target)
    fixum tensor<f32, [4,4]> squared  ← residual.multiplica(residual)
    redde squared.media()
}

# -------------------------------------------------------------------------
# mse_2x8 — mean((prediction − target)²) (2×8 f32, BERT-tiny shape)
# -------------------------------------------------------------------------

functio mse_2x8(
    tensor<f32, [2,8]> prediction,
    tensor<f32, [2,8]> target
) → f32 {
    fixum tensor<f32, [2,8]> residual ← prediction.subtrahe(target)
    fixum tensor<f32, [2,8]> squared  ← residual.multiplica(residual)
    redde squared.media()
}
