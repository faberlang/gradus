+++
locale = "en"
+++
# Co-located package test for tensor.fab (PML1-U1 tensor public contract).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: construction (structa / impleta), validation
# (negative dimension, element-count mismatch), element access (value read,
# out-of-bounds, rank mismatch), and shape/dtype introspection (figura,
# gradus, quantitas, typus, valet). adfirma assertions run under the
# cargo-backed `faber test` harness (auditor-owned); `faber check` proves
# the whole surface type-checks.
import from "gradus:tensor" tensor

import from "gradus:dtype" dtype

# -- helpers ---------------------------------------------------------------

# DType is a cross-module tag (U2 moved the seam to gradus:dtype; the tensor
# module consumes it via factories). The discerne needs a catchall for the
# 4-variant enum (F32/F16/I32/U8).
fn dtype_is_f32(dtype.DType t) → bool {
    match t {
        case dtype.F32 {
            return true
        }
        case _ {
            return false
        }
    }
}

fn accipe_result(tensor.Tensor t, list<int> indices) → string {
    do {
        const f32 v ← t.accipe(indices)
        return v.to_textus()
    }
    catch err {
        return tensor.causa(err)
    }
}

# -- construction ----------------------------------------------------------

test "structa builds a tensor from data and shape" {
    do {
        const tensor.Tensor t ← tensor.structa([1.0, 2.0, 3.0, 4.0], [2, 2])
        assert t.valet()
        assert t.figura() ≡ [2, 2]
        assert t.gradus() ≡ 2
        assert t.quantitas() ≡ 4
        assert dtype_is_f32(t.typus())
    }
    catch err {
        assert false
    }
}

test "structa rejects a negative dimension" {
    do {
        tensor.structa([1.0, 2.0, 3.0, 4.0], [2, -2])
        assert false
    }
    catch err {
        assert tensor.causa(err) ≡ "negative dimension"
    }
}

test "structa rejects an element-count mismatch" {
    do {
        tensor.structa([1.0, 2.0], [2, 2])
        assert false
    }
    catch err {
        assert tensor.causa(err) ≡ "element count mismatch"
    }
}

test "impleta fills every element" {
    do {
        const tensor.Tensor t ← tensor.impleta([2, 3], 7.0)
        assert t.valet()
        assert t.quantitas() ≡ 6
        assert t.accipe([0, 0]) ≡ 7.0 ∷ f32
        assert t.accipe([1, 2]) ≡ 7.0 ∷ f32
    }
    catch err {
        assert false
    }
}

test "impleta rejects a negative dimension" {
    do {
        tensor.impleta([1, -1], 1.0)
        assert false
    }
    catch err {
        assert tensor.causa(err) ≡ "negative dimension"
    }
}

# -- element access ---------------------------------------------------------

test "accipe reads row-major values" {
    do {
        const tensor.Tensor t ← tensor.structa([1.0, 2.0, 3.0, 4.0], [2, 2])
        assert t.accipe([0, 0]) ≡ 1.0 ∷ f32
        assert t.accipe([0, 1]) ≡ 2.0 ∷ f32
        assert t.accipe([1, 0]) ≡ 3.0 ∷ f32
        assert t.accipe([1, 1]) ≡ 4.0 ∷ f32
    }
    catch err {
        assert false
    }
}

test "accipe rejects an out-of-bounds index" {
    do {
        const tensor.Tensor t ← tensor.structa([1.0, 2.0, 3.0, 4.0], [2, 2])
        assert accipe_result(t, [2, 0]) ≡ "index out of bounds"
        assert accipe_result(t, [0, 5]) ≡ "index out of bounds"
    }
    catch err {
        assert false
    }
}

test "accipe rejects a negative index" {
    do {
        const tensor.Tensor t ← tensor.structa([1.0, 2.0, 3.0, 4.0], [2, 2])
        assert accipe_result(t, [-1, 0]) ≡ "negative index"
    }
    catch err {
        assert false
    }
}

test "accipe rejects a rank mismatch" {
    do {
        const tensor.Tensor t ← tensor.structa([1.0, 2.0, 3.0, 4.0], [2, 2])
        assert accipe_result(t, [0]) ≡ "index rank mismatch"
        assert accipe_result(t, [0, 0, 0]) ≡ "index rank mismatch"
    }
    catch err {
        assert false
    }
}
