# Co-located package test for tensor.fab (PML1-U1 tensor public contract).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: construction (structa / impleta), validation
# (negative dimension, element-count mismatch), element access (value read,
# out-of-bounds, rank mismatch), and shape/dtype introspection (figura,
# gradus, quantitas, typus, valet). adfirma assertions run under the
# cargo-backed `faber test` harness (auditor-owned); `faber check` proves
# the whole surface type-checks.
importa ex "gradus:tensor" privata tensor
importa ex "gradus:dtype" privata dtype

# -- helpers ---------------------------------------------------------------

# DType is a cross-module tag (U2 moved the seam to gradus:dtype; the tensor
# module consumes it via factories). The discerne needs a catchall for the
# 4-variant enum (F32/F16/I32/U8).
functio dtype_is_f32(dtype.DType t) → bivalens {
    discerne t {
        casu F32 { redde verum }
        ceterum { redde falsum }
    }
}

functio accipe_result(tensor.Tensor t, lista<numerus> indices) → textus {
    fac {
        fixum f32 v ← t.accipe(indices)
        redde v.to_textus()
    }
    cape err {
        redde tensor.causa(err)
    }
}

# -- construction ----------------------------------------------------------

probandum "tensor construction" {
    proba "structa builds a tensor from data and shape" {
        fac {
            fixum tensor.Tensor t ← tensor.structa([1.0, 2.0, 3.0, 4.0], [2, 2])
            adfirma t.valet()
            adfirma t.figura() ≡ [2, 2]
            adfirma t.gradus() ≡ 2
            adfirma t.quantitas() ≡ 4
            adfirma dtype_is_f32(t.typus())
        }
        cape err {
            adfirma falsum
        }
    }

    proba "structa rejects a negative dimension" {
        fac {
            tensor.structa([1.0, 2.0, 3.0, 4.0], [2, -2])
            adfirma falsum
        }
        cape err {
            adfirma tensor.causa(err) ≡ "negative dimension"
        }
    }

    proba "structa rejects an element-count mismatch" {
        fac {
            tensor.structa([1.0, 2.0], [2, 2])
            adfirma falsum
        }
        cape err {
            adfirma tensor.causa(err) ≡ "element count mismatch"
        }
    }

    proba "impleta fills every element" {
        fac {
            fixum tensor.Tensor t ← tensor.impleta([2, 3], 7.0)
            adfirma t.valet()
            adfirma t.quantitas() ≡ 6
            adfirma t.accipe([0, 0]) ≡ (7.0 ∷ f32)
            adfirma t.accipe([1, 2]) ≡ (7.0 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "impleta rejects a negative dimension" {
        fac {
            tensor.impleta([1, -1], 1.0)
            adfirma falsum
        }
        cape err {
            adfirma tensor.causa(err) ≡ "negative dimension"
        }
    }
}

# -- element access ---------------------------------------------------------

probandum "tensor element access" {
    proba "accipe reads row-major values" {
        fac {
            fixum tensor.Tensor t ← tensor.structa([1.0, 2.0, 3.0, 4.0], [2, 2])
            adfirma t.accipe([0, 0]) ≡ (1.0 ∷ f32)
            adfirma t.accipe([0, 1]) ≡ (2.0 ∷ f32)
            adfirma t.accipe([1, 0]) ≡ (3.0 ∷ f32)
            adfirma t.accipe([1, 1]) ≡ (4.0 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "accipe rejects an out-of-bounds index" {
        fac {
            fixum tensor.Tensor t ← tensor.structa([1.0, 2.0, 3.0, 4.0], [2, 2])
            adfirma accipe_result(t, [2, 0]) ≡ "index out of bounds"
            adfirma accipe_result(t, [0, 5]) ≡ "index out of bounds"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "accipe rejects a negative index" {
        fac {
            fixum tensor.Tensor t ← tensor.structa([1.0, 2.0, 3.0, 4.0], [2, 2])
            adfirma accipe_result(t, [-1, 0]) ≡ "negative index"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "accipe rejects a rank mismatch" {
        fac {
            fixum tensor.Tensor t ← tensor.structa([1.0, 2.0, 3.0, 4.0], [2, 2])
            adfirma accipe_result(t, [0]) ≡ "index rank mismatch"
            adfirma accipe_result(t, [0, 0, 0]) ≡ "index rank mismatch"
        }
        cape err {
            adfirma falsum
        }
    }
}
