+++
locale = "en"
+++
# Co-located package test for tensor.fab (PML1-U1 tensor public contract).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: construction (construct / fill), validation
# (negative dimension, element-count mismatch), element access (value read,
# out-of-bounds, rank mismatch), and shape/dtype introspection (shape,
# rank, numel, dtype, valid). assert assertions run under the
# cargo-backed `faber test` harness (auditor-owned); `faber check` proves
# the whole surface type-checks.
import from "gradus:tensor" tensor

import from "gradus:dtype" dtype

# -- helpers ---------------------------------------------------------------

# DType is a cross-module tag (U2 moved the seam to gradus:dtype; the tensor
# module consumes it via factories). The match needs a catchall for the
# 4-variant enum (F32/F16/I32/U8).
fn dtype_is_f32(dtype.DType t) → bool {
    match t {
        case dtype.F32 {
            return true
        }
        case _ {
            return false
        }
    }
}

fn get_result(tensor.NumericBlock t, list<int> indices) → string {
    do {
        const f32 v ← t.get(indices)
        return v.to_textus()
    }
    catch err {
        return err.message
    }
}

# -- construction ----------------------------------------------------------

test "construct builds a tensor from data and shape" {
    do {
        const tensor.NumericBlock t ← tensor.construct([1.0, 2.0, 3.0, 4.0], [2, 2])
        assert t.valid()
        assert t.shape() ≡ ([2, 2] ↦ list<int>)
        assert t.rank() ≡ 2
        assert t.numel() ≡ 4
        assert dtype_is_f32(t.dtype())
    }
    catch err {
        assert false
    }
}

test "construct rejects a negative dimension" {
    do {
        tensor.construct([1.0, 2.0, 3.0, 4.0], [2, -2])
        assert false
    }
    catch err {
        assert err.message ≡ "negative dimension"
    }
}

test "construct rejects an element-count mismatch" {
    do {
        tensor.construct([1.0, 2.0], [2, 2])
        assert false
    }
    catch err {
        assert err.message ≡ "element count mismatch"
    }
}

test "default is the varia placeholder (empty, not valid)" {
    const tensor.NumericBlock t ← tensor.default()
    assert t.shape().length() ≡ 0
    assert t.numel() ≡ 1
    assert not t.valid()
    assert dtype_is_f32(t.dtype())
}

test "fill fills every element" {
    do {
        const tensor.NumericBlock t ← tensor.fill([2, 3], 7.0)
        assert t.valid()
        assert t.numel() ≡ 6
        assert t.get([0, 0]) ≡ 7.0 ∷ f32
        assert t.get([1, 2]) ≡ 7.0 ∷ f32
    }
    catch err {
        assert false
    }
}

test "fill rejects a negative dimension" {
    do {
        tensor.fill([1, -1], 1.0)
        assert false
    }
    catch err {
        assert err.message ≡ "negative dimension"
    }
}

# -- element access ---------------------------------------------------------

test "get reads row-major values" {
    do {
        const tensor.NumericBlock t ← tensor.construct([1.0, 2.0, 3.0, 4.0], [2, 2])
        assert t.get([0, 0]) ≡ 1.0 ∷ f32
        assert t.get([0, 1]) ≡ 2.0 ∷ f32
        assert t.get([1, 0]) ≡ 3.0 ∷ f32
        assert t.get([1, 1]) ≡ 4.0 ∷ f32
    }
    catch err {
        assert false
    }
}

test "get rejects an out-of-bounds index" {
    do {
        const tensor.NumericBlock t ← tensor.construct([1.0, 2.0, 3.0, 4.0], [2, 2])
        assert get_result(t, [2, 0]) ≡ "index out of bounds"
        assert get_result(t, [0, 5]) ≡ "index out of bounds"
    }
    catch err {
        assert false
    }
}

test "get rejects a negative index" {
    do {
        const tensor.NumericBlock t ← tensor.construct([1.0, 2.0, 3.0, 4.0], [2, 2])
        assert get_result(t, [-1, 0]) ≡ "negative index"
    }
    catch err {
        assert false
    }
}

test "get rejects a rank mismatch" {
    do {
        const tensor.NumericBlock t ← tensor.construct([1.0, 2.0, 3.0, 4.0], [2, 2])
        assert get_result(t, [0]) ≡ "index rank mismatch"
        assert get_result(t, [0, 0, 0]) ≡ "index rank mismatch"
    }
    catch err {
        assert false
    }
}
