+++
locale = "en"
+++
# Decode-token composition (A1-PORT-2): ONE token of a llama-family decoder as a
# chain of `decode_step` lane-kernel launches, with no host touch of the hidden
# state or the K/V caches between launches.
#
# Public import: import from "gradus:decode_token" dt
#
#   embed_step   token id -> hidden[D]           (1 launch)
#   layer_step   one transformer layer           (22 launches)
#   head_step    final norm + tied lm_head       (3 launches)  -> logits[V]
#   argmax_host  greedy pick of a logits tensor  (host scan)
#
# These allocate scratch inside the generic function, which `--strict-engine` refuses
# and which makes every kernel-written scratch tensor an observation point (a
# download and a blocking wait per launch). The wide path further down is the
# strict-engine route: `embed_wide`, `layer_wide`, `head_step_wide`, with the token
# picked on the device by `decode_step.argmax_token`.
#
# A 32-layer token on the serial path is 1 + 32 * 22 + 3 + 1 = 709 launches. Layer
# launch order (22 launches):
#   rms_stats, rms_apply (attn norm); gemv_lane x3 (q, k, v); rope_half or rope_pairs x2;
#   kv_write x2; attn_scores; softmax_stats; softmax_apply; attn_context;
#   gemv_lane (o); residual_add; rms_stats, rms_apply (ffn norm);
#   gemv_lane x2 (gate, up); swiglu; gemv_lane (down); residual_add.
#
# The layer loop and the per-layer weight lists live in the CALLER, not here:
# a `list<tensor<f32, [N, K]>>` whose extents are run-time sizes cannot cross a
# generic host call today (`invalid MIR: call argument type mismatch`, expected
# `FunctionParameterAxis` extents against the caller's `ScalarBinding` extents),
# so a gradus-side `token_step(list, ...)` is not expressible; each layer's
# tensors pass as plain arguments instead.
#
# K/V cache protocol: `kv_write` updates the selected row in each mutable
# stream cache. There is one K cache and one V cache per layer and stream.
#
# Weights are laid out [out, in] (a GGUF `[ne1, ne0]` row-major matrix).
# `pos`, dimensions, GQA group and head_dim are `i32` arguments (no `int ↦ i32`
# outside main; see decode_step.fab).

import from "gradus:decode_step" ds

# hidden[D] <- embed[ids[0], :]
@ public
fn embed_step<size V, size D>(tensor<f32, [V, D]> embed, tensor<i32, [1]> ids, mut tensor<f32, [D]> hidden) → void {
    mut tensor<f32, [D]> dom ← tf32[D] {}
    ds.gather_row(dom, embed, ids, mut hidden)
}

# One layer: hout = layer(hin) at position `pos`. `prope` picks the RoPE
# convention and the caller always passes it: 0 = rotate-half pairs (j, j + span)
# (`rope_half`, NEOX), 1 = consecutive pairs (2p, 2p + 1) (`rope_pairs`, llama.cpp
# NORM, the layout of llama-arch GGUF q/k weights). `hdom` is a zero [H] tensor (the
# row domain of the softmax statistics launch; it also carries the head count).
@ public
fn layer_step<size D, size QD, size KVD, size F, size H, size C>(
    tensor<f32, [H]> hdom,
    tensor<f32, [D]> hin,
    mut tensor<f32, [D]> hout,
    tensor<f32, [D]> anorm,
    tensor<f32, [QD, D]> wq,
    tensor<f32, [KVD, D]> wk,
    tensor<f32, [KVD, D]> wv,
    tensor<f32, [D, QD]> wo,
    tensor<f32, [D]> fnorm,
    tensor<f32, [F, D]> wg,
    tensor<f32, [F, D]> wu,
    tensor<f32, [D, F]> wd,
    mut tensor<f32, [C, KVD]> kin,
    mut tensor<f32, [C, KVD]> vin,
    i32 pos,
    i32 pd,
    i32 pqd,
    i32 pf,
    i32 pc,
    i32 pdh,
    i32 pspan,
    i32 pgroup,
    f32 peps,
    f32 plntheta,
    f32 pscale,
    i32 prope
) → void {
    mut tensor<f32, [1]> dom1 ← tf32[1] {}
    mut tensor<f32, [1]> st1 ← tf32[1] {}
    mut tensor<f32, [D]> an ← tf32[D] {}
    ds.rms_stats(dom1, hin, mut st1, pd, peps)
    ds.rms_apply(hin, st1, anorm, mut an)

    mut tensor<f32, [QD]> qdom ← tf32[QD] {}
    mut tensor<f32, [KVD]> kvdom ← tf32[KVD] {}
    mut tensor<f32, [QD]> q ← tf32[QD] {}
    mut tensor<f32, [KVD]> k ← tf32[KVD] {}
    mut tensor<f32, [KVD]> v ← tf32[KVD] {}
    ds.gemv_lane(qdom, wq, an, mut q, pd)
    ds.gemv_lane(kvdom, wk, an, mut k, pd)
    ds.gemv_lane(kvdom, wv, an, mut v, pd)

    mut tensor<f32, [QD]> qr ← tf32[QD] {}
    mut tensor<f32, [KVD]> kr ← tf32[KVD] {}
    if prope ≡ 1 {
        ds.rope_pairs(q, mut qr, pos, pspan, plntheta)
        ds.rope_pairs(k, mut kr, pos, pspan, plntheta)
    }
    else {
        ds.rope_half(q, mut qr, pos, pspan, plntheta)
        ds.rope_half(k, mut kr, pos, pspan, plntheta)
    }
    ds.kv_write(mut kin, kr, pos)
    ds.kv_write(mut vin, v, pos)

    mut tensor<f32, [H, C]> hc ← tf32[H, C] {}
    mut tensor<f32, [H, C]> sc ← tf32[H, C] {}
    mut tensor<f32, [H]> mx ← tf32[H] {}
    mut tensor<f32, [H]> sm ← tf32[H] {}
    mut tensor<f32, [H, C]> pr ← tf32[H, C] {}
    mut tensor<f32, [QD]> ctx ← tf32[QD] {}
    ds.attn_scores(hc, qr, kin, mut sc, pos, pgroup, pdh, pscale)
    ds.softmax_stats(hdom, sc, mut mx, mut sm, pc)
    ds.softmax_apply(sc, mx, sm, mut pr)
    ds.attn_context(qdom, pr, vin, mut ctx, pos, pgroup, pdh)

    mut tensor<f32, [D]> ddom ← tf32[D] {}
    mut tensor<f32, [D]> ao ← tf32[D] {}
    mut tensor<f32, [D]> h1 ← tf32[D] {}
    ds.gemv_lane(ddom, wo, ctx, mut ao, pqd)
    ds.residual_add(hin, ao, mut h1)

    mut tensor<f32, [D]> fnx ← tf32[D] {}
    ds.rms_stats(dom1, h1, mut st1, pd, peps)
    ds.rms_apply(h1, st1, fnorm, mut fnx)

    mut tensor<f32, [F]> fdom ← tf32[F] {}
    mut tensor<f32, [F]> gate ← tf32[F] {}
    mut tensor<f32, [F]> up ← tf32[F] {}
    mut tensor<f32, [F]> act ← tf32[F] {}
    mut tensor<f32, [D]> down ← tf32[D] {}
    ds.gemv_lane(fdom, wg, fnx, mut gate, pd)
    ds.gemv_lane(fdom, wu, fnx, mut up, pd)
    ds.swiglu(gate, up, mut act)
    ds.gemv_lane(ddom, wd, act, mut down, pf)
    ds.residual_add(h1, down, mut hout)
}

# logits[V] = embed @ rmsnorm(hidden) (tied lm_head: `embed` is the token table).
@ public
fn head_step<size V, size D>(tensor<f32, [D]> hidden, tensor<f32, [D]> onorm, tensor<f32, [V, D]> embed, mut tensor<f32, [V]> logits, i32 pd, f32 peps) → void {
    mut tensor<f32, [1]> dom1 ← tf32[1] {}
    mut tensor<f32, [1]> st1 ← tf32[1] {}
    mut tensor<f32, [D]> hn ← tf32[D] {}
    mut tensor<f32, [V]> vdom ← tf32[V] {}
    ds.rms_stats(dom1, hidden, mut st1, pd, peps)
    ds.rms_apply(hidden, st1, onorm, mut hn)
    ds.gemv_lane(vdom, embed, hn, mut logits, pd)
}

# ---------------------------------------------------------------------------
# Wide path (strict-engine safe): 17 launches per layer, every projection one `⇇ ·`
# GEMV (`decode_step.gemv`), and no allocation inside the generic functions (a generic
# host function that allocates `tf32[D] {}` is refused by `--strict-engine`). The
# query, key and value weights are stacked row-wise into one [R, D] matrix, and the
# gate and up weights into one [G, D] (`decode_step.stack_rows3` / `stack_rows2`, at
# load), so each group is one GEMV over its RMSNorm'd input. The CALLER owns every
# scratch tensor and the caches `kin` / `vin` and allocates each once; kernel outputs
# stay device-resident until the host reads them.
#
# Attention is the masked scores, the language's row softmax, and a context sum split
# over S lanes per output (radix corpus/inference decode-layer): no lane walks the
# whole context, so a long context costs bandwidth, not one lane's serial loop.
#
# Shapes: D hidden, QD query width, KVD key/value width, F ffn width, H query heads,
# C cache rows, R = QD + 2 * KVD, G = 2 * F, Q partial sums for RMSNorm (32), S context
# parts per attention output (16).
# Scratch:
#   rp [Q]   xn [D]   qkvr [R]   qkv [R]   kvdom [KVD] (zeros)   sc [H, C]   pr [H, C]
#   cpart [S, QD]   ctx [QD]   ao [D]   h1 [D]   gu [G]   act [F]   dn [D]
# `head_step_wide` also takes xn [D], the normalized hidden state.
# `pqd` / `pkvd` are QD / KVD, `pdh` the head width, `pgroup` = QD / KVD, `prope` the
# RoPE pair convention (as in `layer_step`), `pos` the token position.
# ---------------------------------------------------------------------------

# One layer: hout = layer(hin) at position `pos`, in 17 launches.
@ public
fn layer_wide<size D, size QD, size KVD, size F, size H, size C, size Q, size R, size G, size S>(
    tensor<f32, [D]> hin,
    mut tensor<f32, [D]> hout,
    tensor<f32, [D]> anorm,
    tensor<f32, [R, D]> wqkv,
    tensor<f32, [D, QD]> wo,
    tensor<f32, [D]> fnorm,
    tensor<f32, [G, D]> wgu,
    tensor<f32, [D, F]> wd,
    mut tensor<f32, [C, KVD]> kin,
    mut tensor<f32, [C, KVD]> vin,
    mut tensor<f32, [Q]> rp,
    mut tensor<f32, [D]> xn,
    mut tensor<f32, [R]> qkvr,
    mut tensor<f32, [R]> qkv,
    tensor<f32, [KVD]> kvdom,
    mut tensor<f32, [H, C]> sc,
    mut tensor<f32, [H, C]> pr,
    mut tensor<f32, [S, QD]> cpart,
    mut tensor<f32, [QD]> ctx,
    mut tensor<f32, [D]> ao,
    mut tensor<f32, [D]> h1,
    mut tensor<f32, [G]> gu,
    mut tensor<f32, [F]> act,
    mut tensor<f32, [D]> dn,
    i32 pos,
    i32 pqd,
    i32 pkvd,
    i32 pdh,
    i32 pgroup,
    i32 prope,
    f32 peps,
    f32 plntheta,
    f32 pscale
) → void {
    ds.rms_part(hin, mut rp)
    ds.rms_apply_part(hin, rp, anorm, mut xn, peps)
    ds.gemv(wqkv, xn, mut qkvr)
    ds.qkv_rope(qkvr, mut qkv, pos, pqd, pkvd, pdh, plntheta, prope)
    ds.kv_write_wide(kvdom, qkv, mut kin, mut vin, pos, pqd)
    ds.scores_masked(qkv, kin, mut sc, pos, pdh, pgroup, pscale)
    ds.row_softmax(sc, mut pr)
    ds.context_part(pr, vin, mut cpart, pos, pdh, pgroup)
    ds.context_fin(cpart, mut ctx)
    ds.gemv(wo, ctx, mut ao)
    ds.residual_add(hin, ao, mut h1)
    ds.rms_part(h1, mut rp)
    ds.rms_apply_part(h1, rp, fnorm, mut xn, peps)
    ds.gemv(wgu, xn, mut gu)
    ds.swiglu_stacked(gu, mut act)
    ds.gemv(wd, act, mut dn)
    ds.residual_add(h1, dn, mut hout)
}

# hidden[D] <- embed[ids[0], :] (the id is read on the device).
@ public
fn embed_wide<size V, size D>(tensor<f32, [V, D]> embed, tensor<i32, [1]> ids, mut tensor<f32, [D]> hidden) → void {
    ds.gather_wide(embed, ids, mut hidden)
}

# logits[V] = embed @ rmsnorm(hidden): the final norm, then the tied lm_head GEMV.
@ public
fn head_step_wide<size V, size D, size Q>(tensor<f32, [D]> hidden, tensor<f32, [D]> onorm, tensor<f32, [V, D]> embed, mut tensor<f32, [Q]> rp, mut tensor<f32, [D]> xn, mut tensor<f32, [V]> logits, f32 peps) → void {
    ds.rms_part(hidden, mut rp)
    ds.rms_apply_part(hidden, rp, onorm, mut xn, peps)
    ds.gemv(embed, xn, mut logits)
}

# Greedy pick on the host: the index of the largest logit (first on ties). The wide
# path uses `decode_step.argmax_token` instead, which leaves the id on the device.
@ public
fn argmax_host<size V>(tensor<f32, [V]> logits) → int {
    mut int best ← 0
    mut f32 top ← logits[[0]]
    for range 1 ‥ V let i {
        if logits[[i]] ≻ top {
            top ← logits[[i]]
            best ← i
        }
    }
    return best
}
