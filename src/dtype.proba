# Co-located package test for dtype.fab (PML1-U2 dtype system).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the tag contract (nomen/ex_nomine/amplitudo +
# factories), serialization round-trip + version/tag rejection, the
# promotion and narrowing tables, cast (identity/promotion/round), overflow
# rejection, and non-finite rejection. adfirma assertions run under the
# cargo-backed `faber test` harness (auditor-owned); `faber check` proves
# the whole surface type-checks.
#
# NOTE (compiler lane): the tensor-side seam (structa_typo, which takes a
# dtype.DType parameter) is not probe-importable — the file-interface
# snapshot skips exports carrying cross-module nominal types
# (NominalIdentityUnknown, WARN014). The seam construction test therefore
# lives on the tensor side; dtype.proba proves the contract itself.

importa ex "./dtype" privata dtype

# -- helpers ---------------------------------------------------------------

# Renders a cast outcome as textus: the value on success, the typed error's
# causa on rejection. Lets every cast proba assert a single string.
functio casta_result(f32 valor, dtype.DType a, dtype.DType b) → textus {
    fac {
        fixum f32 v ← dtype.casta(valor, a, b)
        redde v.to_textus()
    }
    cape err {
        redde dtype.causa(err)
    }
}

# Renders a name parse as textus: the canonical nomen on success, the
# typed error's causa on rejection.
functio nomen_of(textus s) → textus {
    fac {
        fixum dtype.DType t ← dtype.ex_nomine(s)
        redde dtype.nomen(t)
    }
    cape err {
        redde dtype.causa(err)
    }
}

# Renders a deserialization as textus: the canonical nomen on success, the
# typed error's causa on rejection.
functio deserializa_result(textus s) → textus {
    fac {
        fixum dtype.DType t ← dtype.deserializa(s)
        redde dtype.nomen(t)
    }
    cape err {
        redde dtype.causa(err)
    }
}

# -- tag contract ----------------------------------------------------------

probandum "dtype tag contract" {
    proba "nomen names every dtype" {
        adfirma dtype.nomen(dtype.f32()) ≡ "f32"
        adfirma dtype.nomen(dtype.f16()) ≡ "f16"
        adfirma dtype.nomen(dtype.i32()) ≡ "i32"
        adfirma dtype.nomen(dtype.u8()) ≡ "u8"
    }

    proba "ex_nomine round-trips every dtype" {
        adfirma nomen_of("f32") ≡ "f32"
        adfirma nomen_of("f16") ≡ "f16"
        adfirma nomen_of("i32") ≡ "i32"
        adfirma nomen_of("u8") ≡ "u8"
    }

    proba "ex_nomine rejects an unknown name" {
        adfirma nomen_of("q8") ≡ "unknown dtype name: q8"
    }

    proba "amplitudo reports the element width" {
        adfirma dtype.amplitudo(dtype.f32()) ≡ 4
        adfirma dtype.amplitudo(dtype.f16()) ≡ 2
        adfirma dtype.amplitudo(dtype.i32()) ≡ 4
        adfirma dtype.amplitudo(dtype.u8()) ≡ 1
    }
}

# -- serialization ---------------------------------------------------------

probandum "dtype serialization" {
    proba "serialize round-trips every dtype" {
        adfirma deserializa_result(dtype.serializa(dtype.f32())) ≡ "f32"
        adfirma deserializa_result(dtype.serializa(dtype.f16())) ≡ "f16"
        adfirma deserializa_result(dtype.serializa(dtype.i32())) ≡ "i32"
        adfirma deserializa_result(dtype.serializa(dtype.u8())) ≡ "u8"
    }

    proba "deserialization rejects an unknown schema version" {
        adfirma deserializa_result("dtype/2.0.0/f32") ≡ "unknown dtype schema version"
        adfirma deserializa_result("dtype/0.9.0/f16") ≡ "unknown dtype schema version"
    }

    proba "deserialization rejects an unknown marker and unknown tag" {
        adfirma deserializa_result("tensor/1.0.0/f32") ≡ "unknown dtype marker"
        adfirma deserializa_result("dtype/1.0.0/q8") ≡ "unknown dtype name: q8"
    }

    proba "deserialization rejects a malformed payload" {
        adfirma deserializa_result("dtype/1.0.0") ≡ "malformed dtype serialization"
    }
}

# -- promotion and narrowing tables ----------------------------------------

probandum "dtype promotion table" {
    proba "promotions hold" {
        adfirma dtype.promovet(dtype.f16(), dtype.f32())
        adfirma dtype.promovet(dtype.u8(), dtype.f32())
        adfirma dtype.promovet(dtype.u8(), dtype.i32())
        adfirma dtype.promovet(dtype.u8(), dtype.f16())
        adfirma dtype.promovet(dtype.f32(), dtype.f32())
    }

    proba "narrowing pairs are not promotions" {
        adfirma non (dtype.promovet(dtype.f32(), dtype.f16()))
        adfirma non (dtype.promovet(dtype.f32(), dtype.i32()))
        adfirma non (dtype.promovet(dtype.f32(), dtype.u8()))
        adfirma non (dtype.promovet(dtype.f16(), dtype.i32()))
        adfirma non (dtype.promovet(dtype.f16(), dtype.u8()))
        adfirma non (dtype.promovet(dtype.i32(), dtype.f32()))
        adfirma non (dtype.promovet(dtype.i32(), dtype.f16()))
        adfirma non (dtype.promovet(dtype.i32(), dtype.u8()))
    }
}

probandum "dtype narrowing table" {
    proba "narrowing pairs hold" {
        adfirma dtype.angusta(dtype.f32(), dtype.f16())
        adfirma dtype.angusta(dtype.f32(), dtype.i32())
        adfirma dtype.angusta(dtype.f32(), dtype.u8())
        adfirma dtype.angusta(dtype.f16(), dtype.i32())
        adfirma dtype.angusta(dtype.f16(), dtype.u8())
        adfirma dtype.angusta(dtype.i32(), dtype.f32())
        adfirma dtype.angusta(dtype.i32(), dtype.f16())
        adfirma dtype.angusta(dtype.i32(), dtype.u8())
    }

    proba "promotion and identity pairs are not narrowing" {
        adfirma non (dtype.angusta(dtype.u8(), dtype.i32()))
        adfirma non (dtype.angusta(dtype.u8(), dtype.f32()))
        adfirma non (dtype.angusta(dtype.u8(), dtype.f16()))
        adfirma non (dtype.angusta(dtype.f16(), dtype.f32()))
        adfirma non (dtype.angusta(dtype.f32(), dtype.f32()))
    }
}

# -- cast ------------------------------------------------------------------

probandum "dtype cast" {
    proba "identity and promotion pass through exactly" {
        adfirma casta_result(4.5, dtype.f32(), dtype.f32()) ≡ "4.5"
        adfirma casta_result(3.5, dtype.f16(), dtype.f32()) ≡ "3.5"
        adfirma casta_result(255.0, dtype.u8(), dtype.i32()) ≡ "255"
        adfirma casta_result(255.0, dtype.u8(), dtype.f32()) ≡ "255"
    }

    proba "float-to-int rounds half away from zero" {
        adfirma casta_result(3.7, dtype.f32(), dtype.i32()) ≡ "4"
        adfirma casta_result(-3.7, dtype.f32(), dtype.i32()) ≡ "-4"
        adfirma casta_result(2.5, dtype.f32(), dtype.i32()) ≡ "3"
        adfirma casta_result(1.5, dtype.f32(), dtype.i32()) ≡ "2"
        adfirma casta_result(3.7, dtype.f32(), dtype.u8()) ≡ "4"
    }

    proba "cast to f16 passes in-range values" {
        adfirma casta_result(1.5, dtype.f32(), dtype.f16()) ≡ "1.5"
        adfirma casta_result(65504.0, dtype.f32(), dtype.f16()) ≡ "65504"
    }

    proba "int-to-float narrowing rounds precision" {
        adfirma casta_result(7.0, dtype.i32(), dtype.f32()) ≡ "7"
    }

    proba "cast rejects overflow" {
        adfirma casta_result(70000.0, dtype.f32(), dtype.f16()) ≡ "f16 overflow in cast"
        adfirma casta_result(300.0, dtype.f32(), dtype.u8()) ≡ "u8 overflow in cast"
        adfirma casta_result(-1.0, dtype.f32(), dtype.u8()) ≡ "u8 overflow in cast"
        adfirma casta_result(3.0e10, dtype.f32(), dtype.i32()) ≡ "i32 overflow in cast"
        adfirma casta_result(-3.0e10, dtype.f32(), dtype.i32()) ≡ "i32 overflow in cast"
    }

    proba "cast rejects non-finite values to integers" {
        adfirma casta_result(1.0 / 0.0, dtype.f32(), dtype.i32()) ≡ "non-finite value in cast to i32"
        adfirma casta_result(1.0 / 0.0, dtype.f32(), dtype.u8()) ≡ "non-finite value in cast to u8"
    }

    proba "non-finite detection" {
        adfirma dtype.finita(3.5)
        adfirma non (dtype.finita(1.0 / 0.0))
    }
}
