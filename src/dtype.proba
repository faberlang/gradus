+++
locale = "en"
+++
# Co-located package test for dtype.fab (PML1-U2 dtype system).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the tag contract (name/ex_nomine/width +
# factories), serialization round-trip + version/tag rejection, the
# promotion and narrowing tables, cast (identity/promotion/round), overflow
# rejection, and non-finite rejection. assert assertions run under the
# cargo-backed `faber test` harness (auditor-owned); `faber check` proves
# the whole surface type-checks.
#
# NOTE (compiler lane): the tensor-side seam (construct_dtype, which takes a
# dtype.DType parameter) is not probe-importable — the file-interface
# snapshot skips exports carrying cross-module nominal types
# (NominalIdentityUnknown, WARN014). The seam construction test therefore
# lives on the tensor side; dtype.proba proves the contract itself.

import from "gradus:dtype" dtype

# -- helpers ---------------------------------------------------------------

# Renders a cast outcome as text: the value on success, the typed error's
# message on rejection. Lets every cast proba assert a single string.
# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.

fn cast_result(f32 payload, dtype.DType a, dtype.DType b) → string {
    do {
        const f32 v ← dtype.cast(payload, a, b)
        return v.to_textus()
    }
    catch err {
        return err.message
    }
}

# Renders a name parse as text: the canonical name on success, the
# typed error's message on rejection.
# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.

fn name_of(string s) → string {
    do {
        const dtype.DType t ← dtype.from_name(s)
        return dtype.name(t)
    }
    catch err {
        return err.message
    }
}

# Renders a deserialization as text: the canonical name on success, the
# typed error's message on rejection.
# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.

fn deserialize_result(string s) → string {
    do {
        const dtype.DType t ← dtype.deserialize(s)
        return dtype.name(t)
    }
    catch err {
        return err.message
    }
}

# -- tag contract ----------------------------------------------------------

test "eq is PartialEq on the four tags" {
    assert dtype.eq(dtype.f32(), dtype.f32())
    assert dtype.eq(dtype.f16(), dtype.f16())
    assert dtype.eq(dtype.i32(), dtype.i32())
    assert dtype.eq(dtype.u8(), dtype.u8())
    assert not dtype.eq(dtype.f32(), dtype.f16())
    assert not dtype.eq(dtype.f32(), dtype.i32())
    assert not dtype.eq(dtype.f32(), dtype.u8())
    assert not dtype.eq(dtype.f16(), dtype.i32())
    assert not dtype.eq(dtype.f16(), dtype.u8())
    assert not dtype.eq(dtype.i32(), dtype.u8())
}

test "name names every dtype" {
    assert dtype.name(dtype.f32()) ≡ "f32"
    assert dtype.name(dtype.f16()) ≡ "f16"
    assert dtype.name(dtype.i32()) ≡ "i32"
    assert dtype.name(dtype.u8()) ≡ "u8"
}

test "ex_nomine round-trips every dtype" {
    assert name_of("f32") ≡ "f32"
    assert name_of("f16") ≡ "f16"
    assert name_of("i32") ≡ "i32"
    assert name_of("u8") ≡ "u8"
}

test "ex_nomine rejects an unknown name" {
    assert name_of("q8") ≡ "unknown dtype name: q8"
}

test "width reports the element width" {
    assert dtype.width(dtype.f32()) ≡ 4
    assert dtype.width(dtype.f16()) ≡ 2
    assert dtype.width(dtype.i32()) ≡ 4
    assert dtype.width(dtype.u8()) ≡ 1
}

# -- serialization ---------------------------------------------------------

test "serialize round-trips every dtype" {
    assert deserialize_result(dtype.serialize(dtype.f32())) ≡ "f32"
    assert deserialize_result(dtype.serialize(dtype.f16())) ≡ "f16"
    assert deserialize_result(dtype.serialize(dtype.i32())) ≡ "i32"
    assert deserialize_result(dtype.serialize(dtype.u8())) ≡ "u8"
}

test "deserialization rejects an unknown schema version" {
    assert deserialize_result("dtype/2.0.0/f32") ≡ "unknown dtype schema version"
    assert deserialize_result("dtype/0.9.0/f16") ≡ "unknown dtype schema version"
}

test "deserialization rejects an unknown marker and unknown tag" {
    assert deserialize_result("tensor/1.0.0/f32") ≡ "unknown dtype marker"
    assert deserialize_result("dtype/1.0.0/q8") ≡ "unknown dtype name: q8"
}

test "deserialization rejects a malformed payload" {
    assert deserialize_result("dtype/1.0.0") ≡ "malformed dtype serialization"
}

# -- promotion and narrowing tables ----------------------------------------

test "promotions hold" {
    assert dtype.promote(dtype.f16(), dtype.f32())
    assert dtype.promote(dtype.u8(), dtype.f32())
    assert dtype.promote(dtype.u8(), dtype.i32())
    assert dtype.promote(dtype.u8(), dtype.f16())
    assert dtype.promote(dtype.f32(), dtype.f32())
}

test "narrowing pairs are not promotions" {
    assert not dtype.promote(dtype.f32(), dtype.f16())
    assert not dtype.promote(dtype.f32(), dtype.i32())
    assert not dtype.promote(dtype.f32(), dtype.u8())
    assert not dtype.promote(dtype.f16(), dtype.i32())
    assert not dtype.promote(dtype.f16(), dtype.u8())
    assert not dtype.promote(dtype.i32(), dtype.f32())
    assert not dtype.promote(dtype.i32(), dtype.f16())
    assert not dtype.promote(dtype.i32(), dtype.u8())
}

test "narrowing pairs hold" {
    assert dtype.narrow(dtype.f32(), dtype.f16())
    assert dtype.narrow(dtype.f32(), dtype.i32())
    assert dtype.narrow(dtype.f32(), dtype.u8())
    assert dtype.narrow(dtype.f16(), dtype.i32())
    assert dtype.narrow(dtype.f16(), dtype.u8())
    assert dtype.narrow(dtype.i32(), dtype.f32())
    assert dtype.narrow(dtype.i32(), dtype.f16())
    assert dtype.narrow(dtype.i32(), dtype.u8())
}

test "promotion and identity pairs are not narrowing" {
    assert not dtype.narrow(dtype.u8(), dtype.i32())
    assert not dtype.narrow(dtype.u8(), dtype.f32())
    assert not dtype.narrow(dtype.u8(), dtype.f16())
    assert not dtype.narrow(dtype.f16(), dtype.f32())
    assert not dtype.narrow(dtype.f32(), dtype.f32())
}

# -- cast ------------------------------------------------------------------

test "identity and promotion pass through exactly" {
    assert cast_result(4.5, dtype.f32(), dtype.f32()) ≡ "4.5"
    assert cast_result(3.5, dtype.f16(), dtype.f32()) ≡ "3.5"
    assert cast_result(255.0, dtype.u8(), dtype.i32()) ≡ "255"
    assert cast_result(255.0, dtype.u8(), dtype.f32()) ≡ "255"
}

test "float-to-int rounds half away from zero" {
    assert cast_result(3.7, dtype.f32(), dtype.i32()) ≡ "4"
    assert cast_result(-3.7, dtype.f32(), dtype.i32()) ≡ "-4"
    assert cast_result(2.5, dtype.f32(), dtype.i32()) ≡ "3"
    assert cast_result(1.5, dtype.f32(), dtype.i32()) ≡ "2"
    assert cast_result(3.7, dtype.f32(), dtype.u8()) ≡ "4"
}

test "cast to f16 passes in-range values" {
    assert cast_result(1.5, dtype.f32(), dtype.f16()) ≡ "1.5"
    assert cast_result(65504.0, dtype.f32(), dtype.f16()) ≡ "65504"
}

test "int-to-float narrowing rounds precision" {
    assert cast_result(7.0, dtype.i32(), dtype.f32()) ≡ "7"
}

test "cast rejects overflow" {
    assert cast_result(70000.0, dtype.f32(), dtype.f16()) ≡ "f16 overflow in cast"
    assert cast_result(300.0, dtype.f32(), dtype.u8()) ≡ "u8 overflow in cast"
    assert cast_result(-1.0, dtype.f32(), dtype.u8()) ≡ "u8 overflow in cast"
    assert cast_result(30000000000.0, dtype.f32(), dtype.i32()) ≡ "i32 overflow in cast"
    assert cast_result(-30000000000.0, dtype.f32(), dtype.i32()) ≡ "i32 overflow in cast"
}

test "cast rejects non-finite values to integers" {
    assert cast_result(1.0 / 0.0, dtype.f32(), dtype.i32()) ≡ "non-finite value in cast to i32"
    assert cast_result(1.0 / 0.0, dtype.f32(), dtype.u8()) ≡ "non-finite value in cast to u8"
}

test "non-finite detection" {
    assert dtype.finite(3.5)
    assert not dtype.finite(1.0 / 0.0)
}
