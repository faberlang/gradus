# =============================================================================
# Port generation — the A1 greedy decode loop on the gradus decode-token launches
# =============================================================================
#
# Given the bulk-loaded `port.PortWeights` (port_weights.fab), the prompt token
# ids, a new-token ceiling and the stop policy, this module runs
#
#   prefill   each prompt token, one at a time, through embed_step + 32 x
#             layer_step; head_step only after the LAST prompt token
#   decode    head_step -> host scan of the logits -> the chosen id is appended
#             and fed back, until an EOG id (stop) or the ceiling (length)
#
# The structure is the proven `drive` of radix/acceptance/a1-token-step: per
# layer weight tensors passed as plain arguments, the K/V caches held as
# ping-pong pairs `tensor<f32, [C, 320]>` (a tensor cannot be both read and
# `mut`; the roles swap every token), a run-time cache extent
# `const size C ← c`, `pos` an i32, and the caches only ever passed to launches
# (never indexed, flattened or copied on the host). The caches are allocated
# once per call, so a request owns a fresh pair per layer.
#
# The loop is `port_generate_sampled` below; the pure parts it uses are above it and
# are covered by the tests at the end of the pure section.
#
# The per-token host read is, in the plain stop-policy path, only the 256 chunk
# pairs of the device `argmax_chunks` kernel (P = 256 chunks of 192 logits; the
# host scans 256 pairs, not 49,152 logits). Under ignore_eos it is the native
# argmax of the masked logits, and under `trace` the full-vocabulary scan that
# also yields the top two ids and logits.
#
# Greedy by default; `port_generate_sampled` adds the seeded sampled choice. The
# finish reasons are `stop` (an EOG id was chosen; the EOG id is part of the
# returned ids, as in the host path) and `length`.
# =============================================================================

import from "gradus:decode_token" dt
import from "gradus:decode_step" ds
import from "gradus:sampling" sampling
import from "gradus:train" train

import from "./port_weights" port

@ public
class PortResult {
    var list<int> ids
    var string finish
}

@ public
class PortTop {
    var int id1
    var f32 val1
    var int id2
    var f32 val2
}

# ---------------------------------------------------------------------------
# Pure parts
# ---------------------------------------------------------------------------

# K/V cache capacity for one request: the context limit, or the prompt plus
# the new-token ceiling when that is smaller. At least 1.
@ public
fn port_capacity(int context, int prompt_len, int max_new) → int {
    const int want ← prompt_len + max_new
    var int cap ← want
    if context ≺ want {
        cap ← context
    }
    if cap ≺ 1 {
        return 1
    }
    return cap
}

# The finish reason of a run: `stop` when it ended on an EOG id, else `length`.
@ public
fn port_finish(bool hit_eog) → string {
    if hit_eog {
        return "stop"
    }
    return "length"
}

# Whether the loop ends after choosing a token: an EOG id under the stop
# policy, the new-token ceiling, or no cache row left to feed the token into.
@ public
fn port_ends(bool stop_on_eog, bool is_eog, int generated, int max_new, int next_pos, int capacity) → bool {
    if stop_on_eog and is_eog {
        return true
    }
    if generated ≥ max_new {
        return true
    }
    return next_pos ≥ capacity
}

# The oracle trace line for one generated step.
@ public
fn port_trace_line(int step, int id, int id1, f32 val1, int id2, f32 val2) → string {
    return "trace step=" + (step ↦ string) + " id=" + (id ↦ string) + " top1=" + (id1 ↦ string) + ":" + (val1 ↦ string) + " top2=" + (id2 ↦ string) + ":" + (val2 ↦ string)
}

# int -> i32 outside main is failable; the values here are always in range.
@ public
fn port_i32(int x) → i32 {
    return x ↦ i32 ⊥ (0 ∷ i32)
}

fn port_skipped(list<int> skip, int id) → bool {
    return id ∈ skip
}

# Full-vocabulary scan: the largest and second largest logit (first index
# wins ties), skipping the ids in `skip` (the EOG ids under ignore_eos).
@ public
fn port_scan(tensor<f32, [49152]> logits, list<int> skip) → PortTop {
    var int id1 ← -1
    var f32 val1 ← 0.0 ∷ f32
    var int id2 ← -1
    var f32 val2 ← 0.0 ∷ f32
    const bool masked ← skip.length() ≻ 0
    var int i ← 0
    while i ≺ 49152 {
        if masked and port_skipped(skip, i) {
            i ← i + 1
        } else {
            const f32 x ← logits[[i]]
            if id1 ≺ 0 or x ≻ val1 {
                id2 ← id1
                val2 ← val1
                id1 ← i
                val1 ← x
            } elif id2 ≺ 0 or x ≻ val2 {
                id2 ← i
                val2 ← x
            }
            i ← i + 1
        }
    }
    return PortTop { id1 = id1, val1 = val1, id2 = id2, val2 = val2 }
}

# Sets the ids in `skip` (the EOG ids under ignore_eos) to the lowest f32, so
# they never win the argmax. Overwrites `logits`: the caller's next head_step
# rewrites the whole vector.
@ public
fn port_mask(mut tensor<f32, [49152]> logits, list<int> skip) → void {
    const f32 lowest ← -3.4028235e38 ∷ f32
    var int k ← 0
    while k ≺ skip.length() {
        logits[[skip.get(k) coalesce 0]] ← lowest
        k ← k + 1
    }
}

# The greedy choice without the trace evidence: the native argmax of the host
# logits (the lowest index wins ties, as in `port_scan` and llama.cpp's greedy
# sampler). Not `mut`: a `return reduce` over a `mut` parameter is rejected at
# run time (invalid MIR, no-value return), so the masking is `port_mask`.
@ public
fn port_argmax(tensor<f32, [49152]> logits) → int {
    return reduce via argmax from logits at [i] coalesce 0
}

# The host half of the chunked argmax: the best (value, global index) pair of
# each of the 256 chunks of 192 logits, scanned in ascending chunk order with a
# strict `>`. Chunks are contiguous and ascending and the device kernel keeps the
# first index inside a chunk, so the lowest global index wins ties, as in
# `port_argmax` and `port_scan`. The indices are f32 (exact below 2^24).
@ public
fn port_chunk_pick(tensor<f32, [256]> vals, tensor<f32, [256]> idxs) → int {
    var f32 top ← vals[[0]]
    var int best ← idxs[[0]] ↦ int via Trunc ⊥ 0
    var int p ← 1
    while p ≺ 256 {
        if vals[[p]] ≻ top {
            top ← vals[[p]]
            best ← idxs[[p]] ↦ int via Trunc ⊥ 0
        }
        p ← p + 1
    }
    return best
}

# Candidate logits and their vocabulary ids for the sampled path.
@ public
class PortCandidates {
    var list<f32> values
    var list<int> ids
}

# The repetition penalty on the host logits, before the device narrowing (it
# changes the ranking). The llama rule of `sampling.repetition_penalty`: a
# positive logit is divided, a non-positive one multiplied, and an id repeated
# in `history` is penalised once per occurrence. `history` holds the generated
# ids only (the prompt is not in it) and every id lies in [0, 49152).
@ public
fn port_penalize(mut tensor<f32, [49152]> logits, list<int> history, f32 penalty) → void {
    var int k ← 0
    while k ≺ history.length() {
        const int id ← history.get(k) coalesce 0
        const f32 w ← logits[[id]]
        if w ≻ 0.0 {
            logits[[id]] ← w / penalty
        } else {
            logits[[id]] ← w * penalty
        }
        k ← k + 1
    }
}

# The ignore_eos mask of the sampled path: the ids in `skip` are set to -1e9,
# not the lowest f32 of `port_mask`, which becomes -inf after the temperature
# division or the penalty and is rejected by `sampling.require_logits`.
@ public
fn port_mask_ignore(mut tensor<f32, [49152]> logits, list<int> skip) → void {
    const f32 floor ← -1000000000.0 ∷ f32
    var int k ← 0
    while k ≺ skip.length() {
        logits[[skip.get(k) coalesce 0]] ← floor
        k ← k + 1
    }
}

# The per-chunk top-M (value, global index) pairs read back from the device
# (indices are f32, exact below 2^24), as the candidate list in ascending
# vocabulary-id order: the order `sampling.sample_candidates` needs so its
# float sums run in the full-list order. The pairs come chunk by chunk, so the
# input is nearly sorted by id and the stable insertion sort is cheap. A slot
# the kernel left unfilled (a chunk with fewer than M elements) carries the
# value -3.4028235e38 and the index -1.0; the INDEX is the marker, not the
# value (a real logit can be very negative), so every pair with a negative
# index is dropped.
@ public
fn port_candidates(tensor<f32, [4096]> vals, tensor<f32, [4096]> idxs) → PortCandidates {
    var list<f32> values ← empty
    var list<int> ids ← empty
    var int i ← 0
    while i ≺ 4096 {
        const int id ← idxs[[i]] ↦ int via Trunc ⊥ -1
        if id ≥ 0 {
            const int n ← ids.length()
            values.append(vals[[i]])
            ids.append(id)
            var int j ← n
            while j ≻ 0 and (ids.get(j - 1) coalesce 0) ≻ id {
                ids[j] ← ids.get(j - 1) coalesce 0
                values[j] ← values.get(j - 1) coalesce (0.0 ∷ f32)
                ids[j - 1] ← id
                values[j - 1] ← vals[[i]]
                j ← j - 1
            }
        }
        i ← i + 1
    }
    return PortCandidates { values = values, ids = ids }
}

# Whether the kept set of a top-p or min-p filter is provably exact: its lowest
# kept logit must be strictly greater than `chunk_floor`, the largest per-chunk
# M-th value, since an element a chunk did not return is at most that floor.
@ public
fn port_exact(f32 kept_min, f32 chunk_floor) → bool {
    return kept_min ≻ chunk_floor
}

# ---------------------------------------------------------------------------
# The branch decision of the sampled path (pure; the device launch is not)
# ---------------------------------------------------------------------------

# Per-chunk candidates the device returns (topm_chunks M).
@ public
fn port_topm() → int {
    return 16
}

# The choice of a step: "greedy" (temperature <= 0; every other knob, the
# repetition penalty included, is ignored, as in `sampling.sample`),
# "candidates" (sampled from the device per-chunk top-M) or "full" (sampled from
# the full logits read to the host). The candidate set holds the global top-k
# only for 1 <= top_k <= M, and a sampled path with top_k == 0 or top_k > M needs
# the whole distribution (softmax denominators, top-p/min-p over the tail), so
# those take the full-logits fallback, still on the Metal logits.
@ public
fn port_branch(sampling.Config c) → string {
    if c.temperature ≤ 0.0 {
        return "greedy"
    }
    if c.top_k ≥ 1 and c.top_k ≤ port_topm() {
        return "candidates"
    }
    return "full"
}

# The `[256, 16]` device output (chunk-major) as the flat `[4096]` tensor that
# `port_candidates` reads: element p * 16 + m is chunk p, rank m.
@ public
fn port_flatten(tensor<f32, [256, 16]> src) → tensor<f32, [4096]> {
    var tensor<f32, [4096]> flat ← tf32[4096] {}
    var int p ← 0
    while p ≺ 256 {
        var int m ← 0
        while m ≺ 16 {
            flat[[p * 16 + m]] ← src[[p, m]]
            m ← m + 1
        }
        p ← p + 1
    }
    return flat
}

# The host logits as a list, for the full-logits fallback of `sampling.sample`.
@ public
fn port_logits_list(tensor<f32, [49152]> logits) → list<f32> {
    var list<f32> out ← empty
    var int i ← 0
    while i ≺ 49152 {
        out.append(logits[[i]])
        i ← i + 1
    }
    return out
}

# ---------------------------------------------------------------------------
# Helpers of the decode loop (the loop itself is `port_generate_sampled` below)
# ---------------------------------------------------------------------------

@ public
fn port_progress(string text) → void {
    port.port_warn("port: " + text)
}

# The masked set for the choice: empty under the stop policy (nothing is
# skipped), the EOG ids under ignore_eos.
@ public
fn if_skip(bool stop_on_eog, list<int> eog_ids) → list<int> {
    if stop_on_eog {
        return []
    }
    return eog_ids
}

# ---------------------------------------------------------------------------
# Tests (pure parts)
# ---------------------------------------------------------------------------

describe "port generate capacity" tag "inferentia" {
    test "capacity is the prompt plus the ceiling when that fits the context" {
        assert port_capacity(8192, 25, 64) ≡ 89
        assert port_capacity(8192, 9, 32) ≡ 41
    }
    test "capacity is clamped to the context limit" {
        assert port_capacity(50, 25, 64) ≡ 50
    }
    test "capacity is at least one row" {
        assert port_capacity(0, 0, 0) ≡ 1
    }
}

describe "port generate stop policy" tag "inferentia" {
    test "finish reasons are stop and length" {
        assert port_finish(true) ≡ "stop"
        assert port_finish(false) ≡ "length"
    }
    test "an EOG id ends the run under the stop policy" {
        assert port_ends(true, true, 2, 32, 11, 41)
    }
    test "an EOG id does not end the run under ignore_eos" {
        assert not port_ends(false, true, 2, 32, 11, 41)
    }
    test "the ceiling ends the run" {
        assert port_ends(true, false, 32, 32, 41, 100)
    }
    test "a full cache ends the run" {
        assert port_ends(true, false, 3, 32, 41, 41)
    }
    test "an ordinary token continues" {
        assert not port_ends(true, false, 3, 32, 12, 41)
    }
    test "the masked set is empty under the stop policy" {
        assert if_skip(true, [2, 0]).length() ≡ 0
        assert if_skip(false, [2, 0]).length() ≡ 2
    }
}

describe "port generate trace line" tag "inferentia" {
    test "the line carries the step, the chosen id and the top two logits" {
        assert port_trace_line(0, 30, 30, 12.5 ∷ f32, 1270, 9.25 ∷ f32) ≡ "trace step=0 id=30 top1=30:12.5 top2=1270:9.25"
    }
}

describe "port generate argmax" tag "inferentia" {
    test "the native argmax picks the largest with the first index winning ties" {
        var tensor<f32, [49152]> t ← tf32[49152] {}
        t[[7]] ← 3.0 ∷ f32
        t[[9]] ← 3.0 ∷ f32
        t[[40000]] ← 1.0 ∷ f32
        port_mask(mut t, [])
        assert port_argmax(t) ≡ 7
    }
    test "skipped ids never win the native argmax" {
        var tensor<f32, [49152]> t ← tf32[49152] {}
        t[[7]] ← 5.0 ∷ f32
        t[[9]] ← 3.0 ∷ f32
        port_mask(mut t, [7])
        assert port_argmax(t) ≡ 9
    }
}

describe "port generate chunk pick" tag "inferentia" {
    test "the largest chunk value wins and its global index is returned" {
        var tensor<f32, [256]> v ← tf32[256] {}
        var tensor<f32, [256]> x ← tf32[256] {}
        v[[3]] ← 2.0 ∷ f32
        x[[3]] ← 700.0 ∷ f32
        v[[200]] ← 9.0 ∷ f32
        x[[200]] ← 49151.0 ∷ f32
        assert port_chunk_pick(v, x) ≡ 49151
    }
    test "equal chunk values keep the lowest chunk, hence the lowest index" {
        var tensor<f32, [256]> v ← tf32[256] {}
        var tensor<f32, [256]> x ← tf32[256] {}
        v[[5]] ← 4.0 ∷ f32
        x[[5]] ← 960.0 ∷ f32
        v[[6]] ← 4.0 ∷ f32
        x[[6]] ← 1152.0 ∷ f32
        assert port_chunk_pick(v, x) ≡ 960
    }
    test "all chunks equal picks the first chunk" {
        var tensor<f32, [256]> v ← tf32[256] {}
        var tensor<f32, [256]> x ← tf32[256] {}
        x[[0]] ← 0.0 ∷ f32
        x[[1]] ← 192.0 ∷ f32
        assert port_chunk_pick(v, x) ≡ 0
    }
}

describe "port generate sampling helpers" tag "inferentia" {
    test "the penalty divides positive logits and multiplies non-positive ones" {
        var tensor<f32, [49152]> t ← tf32[49152] {}
        t[[3]] ← 4.0 ∷ f32
        t[[5]] ← -2.0 ∷ f32
        t[[8]] ← 6.0 ∷ f32
        port_penalize(mut t, [3, 5], 2.0 ∷ f32)
        assert t[[3]] ≡ (2.0 ∷ f32)
        assert t[[5]] ≡ (-4.0 ∷ f32)
        assert t[[8]] ≡ (6.0 ∷ f32)
    }
    test "a repeated history id is penalised repeatedly" {
        var tensor<f32, [49152]> t ← tf32[49152] {}
        t[[3]] ← 8.0 ∷ f32
        port_penalize(mut t, [3, 3], 2.0 ∷ f32)
        assert t[[3]] ≡ (2.0 ∷ f32)
    }
    test "an empty history leaves the logits unchanged" {
        var tensor<f32, [49152]> t ← tf32[49152] {}
        t[[3]] ← 4.0 ∷ f32
        port_penalize(mut t, [], 2.0 ∷ f32)
        assert t[[3]] ≡ (4.0 ∷ f32)
    }
    test "the ignore mask sets the skipped ids to minus 1e9 and nothing else" {
        var tensor<f32, [49152]> t ← tf32[49152] {}
        t[[7]] ← 5.0 ∷ f32
        t[[9]] ← 3.0 ∷ f32
        port_mask_ignore(mut t, [7])
        assert t[[7]] ≡ (-1000000000.0 ∷ f32)
        assert t[[9]] ≡ (3.0 ∷ f32)
    }
    test "candidates keep an already ascending order with their values" {
        var tensor<f32, [4096]> v ← tf32[4096] {}
        var tensor<f32, [4096]> x ← tf32[4096] {}
        var int k ← 0
        while k ≺ 4096 {
            v[[k]] ← ((4095 - k) ↦ f32 ⊥ (0.0 ∷ f32))
            x[[k]] ← (k ↦ f32 ⊥ (0.0 ∷ f32))
            k ← k + 1
        }
        const PortCandidates c ← port_candidates(v, x)
        assert c.ids.length() ≡ 4096
        assert c.values.length() ≡ 4096
        assert c.ids.get(0) coalesce -1 ≡ 0
        assert c.ids.get(4095) coalesce -1 ≡ 4095
        assert c.values.get(0) coalesce (-1.0 ∷ f32) ≡ (4095.0 ∷ f32)
        assert c.values.get(4095) coalesce (-1.0 ∷ f32) ≡ (0.0 ∷ f32)
        assert c.ids.get(100) coalesce -1 ≡ 100
        assert c.values.get(100) coalesce (-1.0 ∷ f32) ≡ (3995.0 ∷ f32)
    }
    test "chunk-ordered pairs sort within the chunk by id" {
        var tensor<f32, [4096]> v ← tf32[4096] {}
        var tensor<f32, [4096]> x ← tf32[4096] {}
        var int k ← 0
        while k ≺ 4096 {
            x[[k]] ← ((k / 16) * 192 + 15 - (k % 16)) ↦ f32 ⊥ (0.0 ∷ f32)
            v[[k]] ← (k % 16) ↦ f32 ⊥ (0.0 ∷ f32)
            k ← k + 1
        }
        const PortCandidates c ← port_candidates(v, x)
        assert c.ids.get(0) coalesce -1 ≡ 0
        assert c.ids.get(15) coalesce -1 ≡ 15
        assert c.values.get(0) coalesce (-1.0 ∷ f32) ≡ (15.0 ∷ f32)
        assert c.ids.get(16) coalesce -1 ≡ 192
        assert c.ids.get(4095) coalesce -1 ≡ 255 * 192 + 15
    }
    test "unfilled slots (index -1) are dropped and the real pairs sort by id" {
        var tensor<f32, [4096]> v ← tf32[4096] {}
        var tensor<f32, [4096]> x ← tf32[4096] {}
        var int k ← 0
        while k ≺ 4096 {
            v[[k]] ← -3.4028235e38 ∷ f32
            x[[k]] ← -1.0 ∷ f32
            k ← k + 1
        }
        v[[0]] ← 2.0 ∷ f32
        x[[0]] ← 300.0 ∷ f32
        v[[1]] ← -3.4028235e38 ∷ f32
        x[[1]] ← 5.0 ∷ f32
        v[[17]] ← 7.0 ∷ f32
        x[[17]] ← 100.0 ∷ f32
        const PortCandidates c ← port_candidates(v, x)
        assert c.ids.length() ≡ 3
        assert c.values.length() ≡ 3
        assert c.ids.get(0) coalesce -1 ≡ 5
        assert c.values.get(0) coalesce (0.0 ∷ f32) ≡ (-3.4028235e38 ∷ f32)
        assert c.ids.get(1) coalesce -1 ≡ 100
        assert c.values.get(1) coalesce (0.0 ∷ f32) ≡ (7.0 ∷ f32)
        assert c.ids.get(2) coalesce -1 ≡ 300
        assert c.values.get(2) coalesce (0.0 ∷ f32) ≡ (2.0 ∷ f32)
    }
    test "only unfilled slots give empty lists" {
        var tensor<f32, [4096]> v ← tf32[4096] {}
        var tensor<f32, [4096]> x ← tf32[4096] {}
        var int k ← 0
        while k ≺ 4096 {
            v[[k]] ← -3.4028235e38 ∷ f32
            x[[k]] ← -1.0 ∷ f32
            k ← k + 1
        }
        const PortCandidates c ← port_candidates(v, x)
        assert c.ids.length() ≡ 0
        assert c.values.length() ≡ 0
    }
    test "the kept set is exact only when its minimum beats the chunk floor" {
        assert port_exact(3.0 ∷ f32, 2.0 ∷ f32)
        assert not port_exact(2.0 ∷ f32, 2.0 ∷ f32)
        assert not port_exact(1.0 ∷ f32, 2.0 ∷ f32)
    }
}

describe "port generate sampled branch" tag "inferentia" {
    test "temperature zero is greedy whatever the other knobs say" {
        const sampling.Config c ← sampling.Config { temperature = 0.0 ∷ f32, top_k = 8, top_p = 0.9 ∷ f32, min_p = 0.1 ∷ f32, repetition_penalty = 1.3 ∷ f32 }
        assert port_branch(c) ≡ "greedy"
    }
    test "a top_k within the per-chunk M samples from the candidates" {
        const sampling.Config a ← sampling.Config { temperature = 0.8 ∷ f32, top_k = 1, top_p = 1.0 ∷ f32, min_p = 0.0 ∷ f32, repetition_penalty = 1.0 ∷ f32 }
        const sampling.Config b ← sampling.Config { temperature = 0.8 ∷ f32, top_k = 16, top_p = 0.95 ∷ f32, min_p = 0.05 ∷ f32, repetition_penalty = 1.1 ∷ f32 }
        assert port_branch(a) ≡ "candidates"
        assert port_branch(b) ≡ "candidates"
    }
    test "top_k zero or above M takes the full-logits fallback" {
        const sampling.Config a ← sampling.Config { temperature = 0.8 ∷ f32, top_k = 0, top_p = 1.0 ∷ f32, min_p = 0.0 ∷ f32, repetition_penalty = 1.0 ∷ f32 }
        const sampling.Config b ← sampling.Config { temperature = 0.8 ∷ f32, top_k = 17, top_p = 1.0 ∷ f32, min_p = 0.0 ∷ f32, repetition_penalty = 1.0 ∷ f32 }
        const sampling.Config d ← sampling.Config { temperature = 1.0 ∷ f32, top_k = 0, top_p = 0.9 ∷ f32, min_p = 0.0 ∷ f32, repetition_penalty = 1.0 ∷ f32 }
        assert port_branch(a) ≡ "full"
        assert port_branch(b) ≡ "full"
        assert port_branch(d) ≡ "full"
    }
    test "flatten lays the chunk-major output out as chunk * 16 + rank" {
        var tensor<f32, [256, 16]> src ← tf32[256, 16] {}
        src[[0, 0]] ← 1.0 ∷ f32
        src[[0, 15]] ← 2.0 ∷ f32
        src[[1, 0]] ← 3.0 ∷ f32
        src[[255, 15]] ← 4.0 ∷ f32
        const tensor<f32, [4096]> flat ← port_flatten(src)
        assert flat[[0]] ≡ (1.0 ∷ f32)
        assert flat[[15]] ≡ (2.0 ∷ f32)
        assert flat[[16]] ≡ (3.0 ∷ f32)
        assert flat[[4095]] ≡ (4.0 ∷ f32)
        assert flat[[17]] ≡ (0.0 ∷ f32)
    }
    test "the logits list copies the tensor in order" {
        var tensor<f32, [49152]> t ← tf32[49152] {}
        t[[0]] ← 1.5 ∷ f32
        t[[49151]] ← -2.5 ∷ f32
        const list<f32> l ← port_logits_list(t)
        assert l.length() ≡ 49152
        assert l.get(0) coalesce (0.0 ∷ f32) ≡ (1.5 ∷ f32)
        assert l.get(49151) coalesce (0.0 ∷ f32) ≡ (-2.5 ∷ f32)
    }
    test "the candidate path equals the full path for a top_k within M" {
        # 4 chunk-style pairs in id order; ids 1, 3, 5, 9 hold the logits, all
        # other vocabulary positions are dropped (exact 0.0 after top_k).
        const sampling.Config c ← sampling.Config { temperature = 0.7 ∷ f32, top_k = 3, top_p = 1.0 ∷ f32, min_p = 0.0 ∷ f32, repetition_penalty = 1.0 ∷ f32 }
        const train.Seed s ← train.Seed { status = 7 }
        var tensor<f32, [4096]> v ← tf32[4096] {}
        var tensor<f32, [4096]> x ← tf32[4096] {}
        var int k ← 0
        while k ≺ 4096 {
            v[[k]] ← -3.4028235e38 ∷ f32
            x[[k]] ← -1.0 ∷ f32
            k ← k + 1
        }
        v[[0]] ← 2.0 ∷ f32
        x[[0]] ← 9.0 ∷ f32
        v[[1]] ← 4.0 ∷ f32
        x[[1]] ← 1.0 ∷ f32
        v[[2]] ← 3.0 ∷ f32
        x[[2]] ← 5.0 ∷ f32
        v[[3]] ← 1.0 ∷ f32
        x[[3]] ← 3.0 ∷ f32
        const PortCandidates cand ← port_candidates(v, x)
        var tensor<f32, [49152]> full ← tf32[49152] {}
        full[[1]] ← 4.0 ∷ f32
        full[[3]] ← 1.0 ∷ f32
        full[[5]] ← 3.0 ∷ f32
        full[[9]] ← 2.0 ∷ f32
        const sampling.Sampler a ← sampling.sample_candidates(cand.values, cand.ids, c, [], s) ⊥ sampling.Sampler { token_id = -1, seed = s }
        const sampling.Sampler b ← sampling.sample(port_logits_list(full), c, [], s) ⊥ sampling.Sampler { token_id = -2, seed = s }
        assert a.token_id ≡ b.token_id
        assert a.seed.status ≡ b.seed.status
    }
}

describe "port generate scan" tag "inferentia" {
    test "the scan picks the top two with the first index winning ties" {
        var tensor<f32, [49152]> t ← tf32[49152] {}
        t[[7]] ← 3.0 ∷ f32
        t[[9]] ← 3.0 ∷ f32
        t[[40000]] ← 1.0 ∷ f32
        const PortTop top ← port_scan(t, [])
        assert top.id1 ≡ 7
        assert top.id2 ≡ 9
    }
    test "skipped ids never win" {
        var tensor<f32, [49152]> t ← tf32[49152] {}
        t[[7]] ← 5.0 ∷ f32
        t[[9]] ← 3.0 ∷ f32
        t[[11]] ← 2.0 ∷ f32
        const PortTop top ← port_scan(t, [7])
        assert top.id1 ≡ 9
        assert top.id2 ≡ 11
    }
}

# Generation. `prompt` must hold at least one id and fewer than `context`;
# `max_new` >= 1; the caller validates both (main.fab). `eog_ids` is the admitted
# tokenizer's EOG set; with `stop_on_eog` false the EOG ids are masked out of the
# choice (the ignore_eos policy). `sconf` and `seed` select the choice per step
# (`port_branch`): temperature <= 0 keeps the three greedy branches; otherwise a
# seeded draw (one `next_f32` per generated token) from the device per-chunk
# top-M candidates, or from the full logits read to the host when
# `port_branch` says "full". The repetition history is the generated ids only.
@ public
fn port_generate_sampled(port.PortWeights w, list<int> prompt, int max_new, list<int> eog_ids, bool stop_on_eog, int context, bool trace, sampling.Config sconf, train.Seed seed) → PortResult ⇥ sampling.SamplingError {
    const int np ← prompt.length()
    const int c ← port_capacity(context, np, max_new)
    const size C ← c
    const i32 pd ← port_i32(960)
    const i32 pqd ← port_i32(960)
    const i32 pf ← port_i32(2560)
    const i32 pdh ← port_i32(64)
    const i32 pspan ← port_i32(32)
    const i32 pgroup ← port_i32(3)
    # The GGUF q/k weights are stored for llama.cpp's NORM rope (consecutive pairs
    # (2p, 2p + 1)): rope convention 1 (gradus `rope_pairs`), weights used as stored.
    const i32 prope ← port_i32(1)
    const i32 pc ← port_i32(c)
    const f32 eps ← 0.00001 ∷ f32
    const f32 lntheta ← 11.512925 ∷ f32
    const f32 attscale ← 0.125 ∷ f32

    var list<tensor<f32, [C, 320]>> ka ← empty
    var list<tensor<f32, [C, 320]>> kb ← empty
    var list<tensor<f32, [C, 320]>> va ← empty
    var list<tensor<f32, [C, 320]>> vb ← empty
    var int l ← 0
    while l ≺ port.PORT_LAYERS {
        var tensor<f32, [C, 320]> c1 ← tf32[C, 320] {}
        var tensor<f32, [C, 320]> c2 ← tf32[C, 320] {}
        var tensor<f32, [C, 320]> c3 ← tf32[C, 320] {}
        var tensor<f32, [C, 320]> c4 ← tf32[C, 320] {}
        ka.append(c1)
        kb.append(c2)
        va.append(c3)
        vb.append(c4)
        l ← l + 1
    }

    const tensor<f32, [49152, 960]> emb ← w.embed
    const tensor<f32, [960]> onorm ← w.out_norm
    var tensor<f32, [15]> hdom ← tf32[15] {}
    var tensor<i32, [1]> ids ← tensor<i32, [1]> {}
    var tensor<f32, [49152]> logits ← tf32[49152] {}
    # The chunked device argmax (plain stop-policy path): P = 256 chunks of 192.
    const i32 pchunk ← port_i32(192)
    var tensor<f32, [256]> cdom ← tf32[256] {}
    var tensor<f32, [256]> cval ← tf32[256] {}
    var tensor<f32, [256]> cidx ← tf32[256] {}
    # The device per-chunk top-M (sampled path): launch domain [P, M] = [256, 16].
    const string branch ← port_branch(sconf)
    var tensor<f32, [256, 16]> tmdom ← tf32[256, 16] {}
    var tensor<f32, [256, 16]> tmval ← tf32[256, 16] {}
    var tensor<f32, [256, 16]> tmidx ← tf32[256, 16] {}
    var train.Seed rng ← copy seed
    var list<int> out ← []
    var string finish ← "length"
    var bool done ← false
    var int t ← 0
    var int cur ← prompt.get(0) coalesce 0
    var i32 pos ← 0
    const list<int> skip ← if_skip(stop_on_eog, eog_ids)
    port_progress("prefill-start prompt=" + (np ↦ string) + " capacity=" + (c ↦ string))
    while not done {
        ids[0] ← port_i32(cur)
        var tensor<f32, [960]> hcur ← tf32[960] {}
        dt.embed_step(emb, ids, mut hcur)
        var int ll ← 0
        while ll ≺ port.PORT_LAYERS {
            const port.PortLayer pl ← w.layers[ll]
            const tensor<f32, [960]> lan ← pl.attn_norm
            const tensor<f32, [960, 960]> lq ← pl.wq
            const tensor<f32, [320, 960]> lk ← pl.wk
            const tensor<f32, [320, 960]> lv ← pl.wv
            const tensor<f32, [960, 960]> lo ← pl.wo
            const tensor<f32, [960]> lfn ← pl.ffn_norm
            const tensor<f32, [2560, 960]> lg ← pl.wg
            const tensor<f32, [2560, 960]> lu ← pl.wu
            const tensor<f32, [960, 2560]> ld ← pl.wd
            var tensor<f32, [960]> hn ← tf32[960] {}
            var tensor<f32, [C, 320]> kin ← ka[ll]
            var tensor<f32, [C, 320]> kout ← kb[ll]
            var tensor<f32, [C, 320]> vin ← va[ll]
            var tensor<f32, [C, 320]> vout ← vb[ll]
            if t % 2 ≡ 1 {
                kin ← kb[ll]
                kout ← ka[ll]
                vin ← vb[ll]
                vout ← va[ll]
            }
            dt.layer_step(hdom, hcur, mut hn, lan, lq, lk, lv, lo, lfn, lg, lu, ld, kin, mut kout, vin, mut vout, pos, pd, pqd, pf, pc, pdh, pspan, pgroup, eps, lntheta, attscale, prope)
            hcur ← hn
            ll ← ll + 1
        }
        if t ≥ np - 1 {
            dt.head_step(hcur, onorm, emb, mut logits, pd, eps)
            var int chosen ← 0
            const int step ← out.length()
            if branch ≡ "candidates" {
                # EOG mask first (-1e9), then the penalty on the device logits, so the
                # ranking narrowed on the device is the penalised one; the history
                # passed to the sampler is therefore empty (no second penalty).
                port_mask_ignore(mut logits, skip)
                port_penalize(mut logits, out, sconf.repetition_penalty)
                ds.topm_chunks(tmdom, logits, mut tmval, mut tmidx, pchunk)
                const PortCandidates cand ← port_candidates(port_flatten(tmval), port_flatten(tmidx))
                const sampling.Sampler pick ← sampling.sample_candidates(cand.values, cand.ids, sconf, [], rng)
                chosen ← pick.token_id
                rng ← pick.seed
            } elif branch ≡ "full" {
                # Full-logits fallback: `sampling.sample` applies the penalty itself.
                port_mask_ignore(mut logits, skip)
                const sampling.Sampler pick ← sampling.sample(port_logits_list(logits), sconf, out, rng)
                chosen ← pick.token_id
                rng ← pick.seed
            } elif trace {
                const PortTop top ← port_scan(logits, skip)
                chosen ← top.id1
                port.port_warn(port_trace_line(step, chosen, top.id1, top.val1, top.id2, top.val2))
            } elif stop_on_eog {
                ds.argmax_chunks(cdom, logits, mut cval, mut cidx, pchunk)
                chosen ← port_chunk_pick(cval, cidx)
            } else {
                port_mask(mut logits, skip)
                chosen ← port_argmax(logits)
            }
            out.append(chosen)
            if step ≡ 0 {
                port_progress("decode-start")
            }
            const bool hit ← stop_on_eog and (chosen ∈ eog_ids)
            if port_ends(stop_on_eog, chosen ∈ eog_ids, out.length(), max_new, t + 1, c) {
                done ← true
                finish ← port_finish(hit)
            } else {
                cur ← chosen
            }
        } else {
            cur ← prompt.get(t + 1) coalesce 0
        }
        t ← t + 1
        pos ← pos + 1
    }
    port_progress("decode-done tokens=" + (out.length() ↦ string))
    return PortResult { ids = out, finish = finish }
}
