# =============================================================================
# Process I/O — stdout, stderr and the exit code
# =============================================================================
#
# Console writes report on the error channel (IoFault). A broken stdout or
# stderr is a trap: this program does not outlive it.

import from "norma:console" console
import from "norma:process" proc

# Write text to stdout without a trailing newline.
@ public
fn stdout_write(string text) → void {
    do {
        console.write_partial(text)
    }
    catch err {
        panic "stdout write failed: §"(err)
    }
}

# Write a line to stderr.
@ public
fn stderr_write(string line) → void {
    do {
        console.warn_line(line)
    }
    catch err {
        panic "stderr write failed: §"(err)
    }
}

# D5 exit-code delivery: terminate the process with the given code (0 clean
# shutdown, 2 admission/load failure at shutdown). The route is the language's
# process-exit primitive (`norma:process` `exit_process`); it never returns on
# success.
@ public
fn exit_with(int code) → void {
    proc.exit_process(code)
}
