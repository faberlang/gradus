+++ toml
locale = "en"

+++ faber
import from "gradus:speculative"

# Deterministic context-lookup search contract — SD4-U1.
#
# Public import: import from "gradus:context_lookup" context_lookup
#
# This leaf freezes the pure search boundaries consumed by the provider in
# SD4-U2 and implements the deterministic provider. It searches only request
# token ids and never inspects generation, cache, sampler, or model state. The
# caller supplies max_block from the already-admitted AccelerationPolicy; it is
# not a new policy or wire field.
#
# A usable lookup context has at least two tokens. The final token cannot be a
# match because a match must have one following source token to begin the
# candidate extension. Search suffix lengths are considered from
# min(max_block, tokens_available - 1) down to one. Candidate extension is
# clamped by max_block and the end of the available context.

const string CONTRACT_VERSION = "1.0.0"

const int MIN_SUFFIX_LENGTH = 1

@ public
class LookupBounds {
    mut int max_block
    mut int tokens_available
    mut int window_maximum
}

# Placeholder for `var LookupBounds` bindings. Not valid search state.
@ public
fn default() → LookupBounds {
    return LookupBounds { max_block = 0, tokens_available = 0, window_maximum = 0 }
}

@ public
fn contract_version() → string {
    return CONTRACT_VERSION
}

@ public
fn minimum_suffix_length() → int {
    return MIN_SUFFIX_LENGTH
}

# Construct the admitted search bounds. `max_block` is the existing policy
# maximum and `tokens_available` is prompt plus accepted history. No independent
# lookup window is admitted.
@ public
fn construct_bounds(int max_block, int tokens_available) → LookupBounds ⇥ speculative.SpeculativeError {
    require max_block ≥ MIN_SUFFIX_LENGTH throw variant speculative.InvalidBlockSize { message = "lookup maximum block size must be at least one" }

    require tokens_available ≥ 2 throw variant speculative.MalformedRequest { message = "context lookup requires at least two context tokens" }

    let int available_window ← tokens_available - MIN_SUFFIX_LENGTH
    mut int window ← max_block

    if window ≻ available_window {
        window ← available_window
    }

    return LookupBounds { max_block = max_block, tokens_available = tokens_available, window_maximum = window }
}

# Validate both constructed and manually-bound values before any helper uses
# them. A malformed bound never silently becomes an empty proposal.
fn validate_bounds(LookupBounds bounds) → void ⇥ speculative.SpeculativeError {
    require bounds.max_block ≥ MIN_SUFFIX_LENGTH throw variant speculative.InvalidBlockSize { message = "lookup maximum block size must be at least one" }

    require bounds.tokens_available ≥ 2 throw variant speculative.MalformedRequest { message = "context lookup requires at least two context tokens" }

    require bounds.window_maximum ≥ MIN_SUFFIX_LENGTH throw variant speculative.MalformedRequest { message = "lookup window maximum must be at least one" }

    require bounds.window_maximum ≤ bounds.max_block throw variant speculative.MalformedRequest { message = "lookup window exceeds policy maximum" }

    require bounds.window_maximum ≤ bounds.tokens_available - MIN_SUFFIX_LENGTH throw variant speculative.MalformedRequest { message = "lookup window exceeds available context" }
}

# Enumerate every suffix length admitted by the frozen window rule. The
# provider owns matching those lengths; this helper only freezes their order.
@ public
fn suffix_lengths(LookupBounds bounds) → list<int> ⇥ speculative.SpeculativeError {
    validate_bounds(bounds)
    mut list<int> lengths ← empty
    mut int length ← bounds.window_maximum

    while length ≥ MIN_SUFFIX_LENGTH {
        lengths.append(length)
        length ← length - 1
    }

    return lengths
}

# Return the source index immediately after a match, admitting only a match
# with a following token available for candidate extension.
@ public
fn following_source_index(LookupBounds bounds, int source_offset, int match_length) → int ⇥ speculative.SpeculativeError {
    validate_bounds(bounds)

    require source_offset ≥ 0 throw variant speculative.MalformedRequest { message = "match source offset must be non-negative" }

    require match_length ≥ MIN_SUFFIX_LENGTH throw variant speculative.MalformedRequest { message = "match length must be at least one" }

    let int following ← source_offset + match_length

    require following ≺ bounds.tokens_available throw variant speculative.MalformedRequest { message = "match must have a following source token" }

    return following
}

# Bound the candidate extension after a matched suffix. The count includes the
# required following token and is limited by both the policy maximum and the
# remaining context after the match.
@ public
fn extension_length(LookupBounds bounds, int source_offset, int match_length) → int ⇥ speculative.SpeculativeError {
    let int following ← following_source_index(bounds, source_offset, match_length)
    let int available ← bounds.tokens_available - following
    mut int extension ← bounds.max_block

    if extension ≻ available {
        extension ← available
    }

    require extension ≥ MIN_SUFFIX_LENGTH throw variant speculative.MalformedRequest { message = "match has no candidate extension" }

    return extension
}

# Empty lookup is the seam's ordinary no-draft fallback, not an error and not
# an acceleration claim. The provider may use this without touching any state.
@ public
fn empty_proposal() → speculative.ProviderResult {
    return speculative.no_draft()
}

@ public
fn fallback_kind() → string {
    return speculative.result_kind(empty_proposal())
}

# Validate the only request state the provider is allowed to inspect. The
# request constructor normally establishes these facts, but a provider must
# reject manually-bound malformed values rather than silently downgrading.
fn validate_request(speculative.ProviderRequest request) → void ⇥ speculative.SpeculativeError {
    require request.block_size ≥ MIN_SUFFIX_LENGTH throw variant speculative.InvalidBlockSize { message = "provider block size must be at least one" }

    for from request.prompt let token {
        require token ≥ 0 throw variant speculative.MalformedRequest { message = "token id must be non-negative" }
    }

    for from request.history let token {
        require token ≥ 0 throw variant speculative.MalformedRequest { message = "token id must be non-negative" }
    }
}

# Make one owned context view. Prompt precedes accepted history, and no other
# request, candidate, cache, or generation state can enter this list.
fn context_of(speculative.ProviderRequest request) → list<int> {
    mut list<int> context ← empty

    for from request.prompt let token {
        context.append(token)
    }

    for from request.history let token {
        context.append(token)
    }

    return context
}

# Compare a source occurrence with the final context suffix by token id. This
# intentionally performs no text conversion or normalization.
fn matches_suffix(list<int> context, int source_offset, int match_length) → bool {
    let int suffix_start ← context.length() - match_length

    for range 0 ‥ match_length let i {
        let int source_token ← context.get(source_offset + i) coalesce (0 - 1)
        let int suffix_token ← context.get(suffix_start + i) coalesce (0 - 1)

        if source_token ≢ suffix_token then return false
    }

    return true
}

# Find the earliest usable occurrence for one suffix length. The final context
# position is excluded as a match end by the following-token rule.
fn first_match(list<int> context, int match_length) → int {
    let int source_limit ← context.length() - match_length

    for range 0 ‥ source_limit let source_offset {
        if matches_suffix(context, source_offset, match_length) then return source_offset
    }

    return 0 - 1
}

# Copy the source tokens immediately following a match, bounded by the
# request's authorized candidate block and available context.
fn candidate_extension(list<int> context, int source_offset, int match_length, int extension) → list<int> {
    mut list<int> candidates ← empty
    let int following ← source_offset + match_length

    for range 0 ‥ extension let i {
        candidates.append(context.get(following + i) coalesce (0 - 1))
    }

    return candidates
}

# Deterministic context-only provider. Equal ProviderRequests produce equal
# ProviderResults: only the copied prompt/history token ids and block size are
# read, and no sampler, train, cache, or generation surface is imported.
@ public
fn propose(speculative.ProviderRequest request) → speculative.ProviderResult ⇥ speculative.SpeculativeError {
    validate_request(request)
    let list<int> context ← context_of(request)

    if context.length() ≺ 2 then return speculative.no_draft()

    let LookupBounds bounds ← construct_bounds(request.block_size, context.length())
    let list<int> lengths ← suffix_lengths(bounds)

    for from lengths let match_length {
        let int source_offset ← first_match(context, match_length)

        if source_offset ≥ 0 {
            let int extension ← extension_length(bounds, source_offset, match_length)
            let list<int> candidates ← candidate_extension(context, source_offset, match_length, extension)
            let speculative.CandidateProvenance provenance ← speculative.construct_provenance(speculative.context_lookup_source(), source_offset, match_length)
            return speculative.construct_candidates(request, candidates, provenance)
        }
    }

    return speculative.no_draft()
}

+++ faber test
# Co-located package tests for the SD4-U1 context-lookup search contract.
# These rows prove only the typed bounds and fallback semantics. Matching and
# candidate construction belong to SD4-U2; this file contains no search loop.

import from "gradus:context_lookup" context_lookup
import from "gradus:speculative" speculative

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.
fn bounds_detail(int max_block, int tokens_available) → string {
    do {
        let context_lookup.LookupBounds ? ← context_lookup.construct_bounds(max_block, tokens_available)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# BLOCKER (F2, funnel 7ec5e484): consume helper returns the success value,
# so the trap form needs outcome narrowing — hard-blocked ("projection
# base", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not convert.
fn suffix_detail(context_lookup.LookupBounds bounds) → list<int> {
    do {
        return context_lookup.suffix_lengths(bounds)
    }
    catch err {
        return empty
    }
}

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base", MIR repair 2d5b7789 not
# landed). Kept on do/catch. Do not convert.
fn following_detail(context_lookup.LookupBounds bounds, int source_offset, int match_length) → string {
    do {
        let int ? ← context_lookup.following_source_index(bounds, source_offset, match_length)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base", MIR repair 2d5b7789 not
# landed). Kept on do/catch. Do not convert.
fn extension_detail(context_lookup.LookupBounds bounds, int source_offset, int match_length) → string {
    do {
        let int extension ← context_lookup.extension_length(bounds, source_offset, match_length)
        return extension ↦ string
    }
    catch err {
        return err.message
    }
}

describe "SD4-U1 — context-lookup search contract" {
    test "window maximum honors policy maximum and available-context cap" {
        let _ trap_result_13 ← trap {
            let context_lookup.LookupBounds policy_cap ← context_lookup.construct_bounds(8, 12)
            let context_lookup.LookupBounds context_cap ← context_lookup.construct_bounds(8, 5)
            let context_lookup.LookupBounds narrow_policy ← context_lookup.construct_bounds(3, 20)
            assert policy_cap.window_maximum ≡ 8
            assert context_cap.window_maximum ≡ 4
            assert narrow_policy.window_maximum ≡ 3
        }
        match trap_result_13 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }

    test "suffix lengths enumerate downward to one" {
        let _ trap_result_12 ← trap {
            let context_lookup.LookupBounds bounds ← context_lookup.construct_bounds(5, 20)
            assert context_lookup.minimum_suffix_length() ≡ 1
            assert suffix_detail(bounds) ≡ ([5, 4, 3, 2, 1] ↦ list<int>)
        }
        match trap_result_12 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }

    test "a match at the context tail is rejected without a following token" {
        let _ trap_result_11 ← trap {
            let context_lookup.LookupBounds bounds ← context_lookup.construct_bounds(8, 5)
            assert following_detail(bounds, 4, 1) ≡ "match must have a following source token"
            assert following_detail(bounds, 3, 2) ≡ "match must have a following source token"
            assert following_detail(bounds, 0, 1) ≡ "ok"
        }
        match trap_result_11 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }

    test "candidate extension clamps at policy maximum and context end" {
        let _ trap_result_10 ← trap {
            let context_lookup.LookupBounds policy_cap ← context_lookup.construct_bounds(3, 10)
            let context_lookup.LookupBounds context_cap ← context_lookup.construct_bounds(9, 6)
            assert extension_detail(policy_cap, 1, 2) ≡ "3"
            assert extension_detail(context_cap, 1, 1) ≡ "4"
        }
        match trap_result_10 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }

    test "empty context and undersized lookup bounds reject through the seam vocabulary" {
        assert bounds_detail(8, 0) ≡ "context lookup requires at least two context tokens"
        assert bounds_detail(8, 1) ≡ "context lookup requires at least two context tokens"
        assert bounds_detail(0, 8) ≡ "lookup maximum block size must be at least one"
    }

    test "malformed bound state and malformed matches reject instead of downgrading" {
        assert following_detail(context_lookup.default(), 0, 1) ≡ "lookup maximum block size must be at least one"
        let _ trap_result_9 ← trap {
            let context_lookup.LookupBounds bounds ← context_lookup.construct_bounds(4, 8)
            assert following_detail(bounds, -1, 1) ≡ "match source offset must be non-negative"
            assert following_detail(bounds, 0, 0) ≡ "match length must be at least one"
        }
        match trap_result_9 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }

    test "empty lookup is the ordinary typed no-draft fallback" {
        let speculative.ProviderResult result ← context_lookup.empty_proposal()
        assert speculative.is_no_draft(result)
        assert context_lookup.fallback_kind() ≡ "no_draft"
        assert speculative.candidate_ids(result).length() ≡ 0
    }
}

# BLOCKER (Z1, funnel 7ec5e484): or_default rewrite would add SEM010 sites
# (check-signature change); the trap form needs narrowing (hard-blocked,
# MIR repair 2d5b7789 not landed). Kept on do/catch. Do not convert.
fn request_p(list<int> prompt, list<int> history, int block_size) → speculative.ProviderRequest {
    return speculative.construct_request(prompt, history, block_size, 1, block_size) ⊥ speculative.default()
}

describe "SD4-U2 — deterministic context-only provider" {
    test "repeated identical requests return identical candidates and metadata" {
        let speculative.ProviderRequest request ← request_p([1, 2, 3, 1, 2, 3], empty, 3)
        let _ trap_result_8 ← trap {
            let speculative.ProviderResult first ← context_lookup.propose(request)
            let speculative.ProviderResult second ← context_lookup.propose(request)
            assert speculative.result_equal(first, second)
            assert speculative.candidate_ids(first) ≡ ([1, 2, 3] ↦ list<int>)
            let speculative.CandidateProvenance metadata ← speculative.candidate_provenance(first)
            assert metadata.source ≡ "context_lookup"
            assert metadata.source_offset ≡ 0
            assert metadata.match_length ≡ 3
        }
        match trap_result_8 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }

    test "longest matching suffix wins before any shorter match" {
        let speculative.ProviderRequest request ← request_p([1, 2, 3, 1, 2, 3], empty, 3)
        let _ trap_result_7 ← trap {
            let speculative.ProviderResult result ← context_lookup.propose(request)
            let speculative.CandidateProvenance metadata ← speculative.candidate_provenance(result)
            assert metadata.match_length ≡ 3
            assert metadata.source_offset ≡ 0
            assert speculative.candidate_ids(result) ≡ ([1, 2, 3] ↦ list<int>)
        }
        match trap_result_7 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }

    test "equal-length matches choose the lowest source offset" {
        let speculative.ProviderRequest request ← request_p([5, 6, 5, 6, 5, 6], empty, 2)
        let _ trap_result_6 ← trap {
            let speculative.ProviderResult result ← context_lookup.propose(request)
            let speculative.CandidateProvenance metadata ← speculative.candidate_provenance(result)
            assert metadata.match_length ≡ 2
            assert metadata.source_offset ≡ 0
            assert speculative.candidate_ids(result) ≡ ([5, 6] ↦ list<int>)
        }
        match trap_result_6 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }

    test "window and candidate limits clamp the lookup result" {
        let speculative.ProviderRequest request ← request_p([9, 8, 7, 9, 8, 7], empty, 2)
        let _ trap_result_5 ← trap {
            let speculative.ProviderResult result ← context_lookup.propose(request)
            let speculative.CandidateProvenance metadata ← speculative.candidate_provenance(result)
            assert metadata.match_length ≡ 2
            assert metadata.source_offset ≡ 1
            assert speculative.candidate_ids(result) ≡ ([9, 8] ↦ list<int>)
            assert speculative.candidate_ids(result).length() ≤ request.block_size
        }
        match trap_result_5 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }

    test "prompt plus accepted history is the only searchable context" {
        let speculative.ProviderRequest request ← request_p([4, 5], [4, 5], 2)
        let _ trap_result_4 ← trap {
            let speculative.ProviderResult result ← context_lookup.propose(request)
            let speculative.CandidateProvenance metadata ← speculative.candidate_provenance(result)
            assert metadata.source_offset ≡ 0
            assert metadata.match_length ≡ 2
            assert speculative.candidate_ids(result) ≡ ([4, 5] ↦ list<int>)
        }
        match trap_result_4 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }

    test "an absent occurrence returns the ordinary no-draft result" {
        let speculative.ProviderRequest request ← request_p([10, 11, 12], empty, 2)
        let _ trap_result_3 ← trap {
            let speculative.ProviderResult result ← context_lookup.propose(request)
            assert speculative.is_no_draft(result)
            assert speculative.candidate_ids(result).length() ≡ 0
        }
        match trap_result_3 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }

    test "short contexts return no-draft and malformed token state rejects" {
        let speculative.ProviderRequest empty_request ← request_p(empty, empty, 2)
        let _ trap_result_2 ← trap {
            assert speculative.is_no_draft(context_lookup.propose(empty_request))
        }
        match trap_result_2 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
        # BLOCKER (F1, funnel 7ec5e484): assert-on-error row needs
        # `err.message` after catch — narrowing family, hard-blocked
        # ("projection base", MIR repair 2d5b7789 not landed). Kept on
        # do/catch. Do not convert.
        do {
            let speculative.ProviderResult ? ← context_lookup.propose(speculative.default())
            assert false
        }
        catch err {
            assert err.message ≡ "provider block size must be at least one"
        }
    }

    test "propose leaves the request unchanged and imports no sampler or train surface" {
        let speculative.ProviderRequest request ← request_p([7, 8, 7, 8], [9], 2)
        let speculative.ProviderRequest before ← request
        do {
            let speculative.ProviderResult ? ← context_lookup.propose(request)
            assert speculative.request_equal(request, before)
            assert request.prompt ≡ before.prompt
            assert request.history ≡ before.history
            assert request.block_size ≡ before.block_size
        }
        catch err {
            assert false
        }
    }
}

describe "SD4-U4 — no-match fallback carries no acceleration provenance" {
    test "a no-draft fallback exposes no candidate provenance to claim" {
        let speculative.ProviderRequest request ← request_p([10, 11, 12], empty, 2)
        # BLOCKER (F1, funnel 7ec5e484): assert-on-error row needs
        # `err.message` after catch — narrowing family, hard-blocked
        # ("projection base", MIR repair 2d5b7789 not landed). Kept on
        # do/catch. Do not convert.
        let _ trap_result_1 ← trap {
            let speculative.ProviderResult result ← context_lookup.propose(request)
            assert speculative.is_no_draft(result)
            do {
                let speculative.CandidateProvenance ? ← speculative.candidate_provenance(result)
                assert false
            }
            catch err {
                assert err.message ≡ "no-draft result has no provenance"
            }
        }
        match trap_result_1 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
}
