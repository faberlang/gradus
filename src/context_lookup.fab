+++
locale = "en"
+++
import from "gradus:speculative" speculative

# Deterministic context-lookup search contract — SD4-U1.
#
# Public import: import from "gradus:context_lookup" context_lookup
#
# This leaf freezes the pure search boundaries consumed by the provider in
# SD4-U2. It deliberately does not search for matches or inspect generation,
# cache, sampler, or model state. The caller supplies max_block from the
# already-admitted AccelerationPolicy; it is not a new policy or wire field.
#
# A usable lookup context has at least two tokens. The final token cannot be a
# match because a match must have one following source token to begin the
# candidate extension. Search suffix lengths are considered from
# min(max_block, tokens_available - 1) down to one. Candidate extension is
# clamped by max_block and the end of the available context.

const string CONTRACT_VERSION ← "1.0.0"
const int MIN_SUFFIX_LENGTH ← 1

@ public { }
class LookupBounds {
    int max_block
    int tokens_available
    int window_maximum

    fn max_block() → int {
        return self.max_block
    }

    fn tokens_available() → int {
        return self.tokens_available
    }

    fn window_maximum() → int {
        return self.window_maximum
    }
}

# Placeholder for `var LookupBounds` bindings. Not valid search state.
@ public { }
fn default() → LookupBounds {
    return LookupBounds {max_block = 0, tokens_available = 0, window_maximum = 0}
}

@ public { }
fn contract_version() → string {
    return CONTRACT_VERSION
}

@ public { }
fn minimum_suffix_length() → int {
    return MIN_SUFFIX_LENGTH
}

# Construct the admitted search bounds. `max_block` is the existing policy
# maximum and `tokens_available` is prompt plus accepted history. No independent
# lookup window is admitted.
@ public { }
fn construct_bounds(int max_block, int tokens_available) → LookupBounds ⇥ speculative.SpeculativeError {
    require max_block ≥ MIN_SUFFIX_LENGTH throw variant speculative.InvalidBlockSize {message = "lookup maximum block size must be at least one"}
    require tokens_available ≥ 2 throw variant speculative.MalformedRequest {message = "context lookup requires at least two context tokens"}
    const int available_window ← tokens_available - MIN_SUFFIX_LENGTH
    var int window ← max_block
    if window ≻ available_window {
        window ← available_window
    }
    return LookupBounds {max_block = max_block, tokens_available = tokens_available, window_maximum = window}
}

# Validate both constructed and manually-bound values before any helper uses
# them. A malformed bound never silently becomes an empty proposal.
@ private { }
fn _validate_bounds(LookupBounds bounds) → void ⇥ speculative.SpeculativeError {
    require bounds.max_block() ≥ MIN_SUFFIX_LENGTH throw variant speculative.InvalidBlockSize {message = "lookup maximum block size must be at least one"}
    require bounds.tokens_available() ≥ 2 throw variant speculative.MalformedRequest {message = "context lookup requires at least two context tokens"}
    require bounds.window_maximum() ≥ MIN_SUFFIX_LENGTH throw variant speculative.MalformedRequest {message = "lookup window maximum must be at least one"}
    require bounds.window_maximum() ≤ bounds.max_block() throw variant speculative.MalformedRequest {message = "lookup window exceeds policy maximum"}
    require bounds.window_maximum() ≤ bounds.tokens_available() - MIN_SUFFIX_LENGTH throw variant speculative.MalformedRequest {message = "lookup window exceeds available context"}
}

# Enumerate every suffix length admitted by the frozen window rule. The
# provider owns matching those lengths; this helper only freezes their order.
@ public { }
fn suffix_lengths(LookupBounds bounds) → list<int> ⇥ speculative.SpeculativeError {
    _validate_bounds(bounds)
    var list<int> lengths ← empty
    var int length ← bounds.window_maximum()
    while length ≥ MIN_SUFFIX_LENGTH {
        lengths.append(length)
        length ← length - 1
    }
    return lengths
}

# Return the source index immediately after a match, admitting only a match
# with a following token available for candidate extension.
@ public { }
fn following_source_index(LookupBounds bounds, int source_offset, int match_length) → int ⇥ speculative.SpeculativeError {
    _validate_bounds(bounds)
    require source_offset ≥ 0 throw variant speculative.MalformedRequest {message = "match source offset must be non-negative"}
    require match_length ≥ MIN_SUFFIX_LENGTH throw variant speculative.MalformedRequest {message = "match length must be at least one"}
    const int following ← source_offset + match_length
    require following ≺ bounds.tokens_available() throw variant speculative.MalformedRequest {message = "match must have a following source token"}
    return following
}

# Bound the candidate extension after a matched suffix. The count includes the
# required following token and is limited by both the policy maximum and the
# remaining context after the match.
@ public { }
fn extension_length(LookupBounds bounds, int source_offset, int match_length) → int ⇥ speculative.SpeculativeError {
    const int following ← following_source_index(bounds, source_offset, match_length)
    const int available ← bounds.tokens_available() - following
    var int extension ← bounds.max_block()
    if extension ≻ available {
        extension ← available
    }
    require extension ≥ MIN_SUFFIX_LENGTH throw variant speculative.MalformedRequest {message = "match has no candidate extension"}
    return extension
}

# Empty lookup is the seam's ordinary no-draft fallback, not an error and not
# an acceleration claim. The provider may use this without touching any state.
@ public { }
fn empty_proposal() → speculative.ProviderResult {
    return speculative.no_draft()
}

@ public { }
fn fallback_kind() → string {
    return speculative.result_kind(empty_proposal())
}
