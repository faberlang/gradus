# =============================================================================
# Pinned row — the SmolLM2-360M-Instruct F32 facts every admission is bound to
# =============================================================================
#
# One model row is verified, so its facts are module constants rather than
# configuration: the identity served on /model, the whole-file digest, the GGUF
# structure counts `gguf.admit` enforces, and the frozen fixture prompt.
# Nothing here reads a file.

# ---------------------------------------------------------------------------
# Identity (i1-discovery §2.1 identity table; D3 /model schema)
# ---------------------------------------------------------------------------

@ public
const string PINNED_NAME = "SmolLM2-360M-Instruct-F32"

@ public
const string PINNED_ARCHITECTURE = "llama"

@ public
const string PINNED_QUANTIZATION = "f32"

@ public
const int PINNED_FILE_SIZE = 1449071040

@ public
const int PINNED_VOCAB_SIZE = 49152

# The context length; `--context 0` derives this.
@ public
const int PINNED_CONTEXT_LENGTH = 8192

# SHA-256 of the whole pinned file.
@ public
const string PINNED_DIGEST = "07735177a3542cbc0b0665051ce1922b55c4c9698de65131e65f2aea87a935e0"

# The header prefix [0, PINNED_DATA_OFFSET) holds everything the manifest
# authority inspects; the tensor data starts there.
@ public
const int PINNED_DATA_OFFSET = 1786560

# ---------------------------------------------------------------------------
# GGUF structure counts (GGUF v3: 30 KV, 290 tensors, all F32,
# general.file_type 0, tokenizer padding id 0), as `gguf.admit` takes them.
# ---------------------------------------------------------------------------

@ public
const int PINNED_KV_COUNT = 30

@ public
const int PINNED_TENSOR_COUNT = 290

@ public
const int PINNED_ELEMENT_COUNT = 361821120

@ public
const int PINNED_F32_TENSORS = 290

@ public
const int PINNED_Q4K_TENSORS = 0

@ public
const int PINNED_Q5_TENSORS = 0

@ public
const int PINNED_Q6_TENSORS = 0

@ public
const int PINNED_Q8_TENSORS = 0

@ public
const int PINNED_FILE_TYPE = 0

@ public
const int PINNED_PAD_ID = 0

# ---------------------------------------------------------------------------
# The frozen fixture prompt (i1-discovery §6.1) and its token ids (P10): the
# default `live` prompt and the oracle for the tokenizer.
# ---------------------------------------------------------------------------

@ public
const string FROZEN_PROMPT = "The quick brown fox jumps over the lazy dog"

@ public
const list<int> FROZEN_PROMPT_IDS = [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767]

# The F32 greedy references are the A1 oracle's (tests/oracle/a1_oracle.py); the
# former 16-token golden was Q4_K_M evidence and is retired.
