# ---------------------------------------------------------------------------
# Minimal product-owned JSON parser (D3 exception: norma:json is deferred;
# the second-caller rule triggers the Norma codec delivery). Bounded to the
# fixed /generate schema: one flat object whose values are strings or
# numbers. The common string escapes are decoded; \uXXXX is rejected with a
# typed cause (documented bound). Numbers are bounded (int-form ≤ 18 digits,
# float-form ≤ 24 chars); out-of-range values fail closed with a typed cause.
# ---------------------------------------------------------------------------

class JsonCursor {
    mut string text
    mut int pos
}

# kind: 1 = string, 2 = integer, 3 = float; 0 = error.
class JsonScalar {
    mut bool ok
    mut string error
    mut int kind
    mut string text
    mut int int_value
    mut float float_value
    mut int pos
}

fn json_fail(string error, int pos) → JsonScalar {
    return JsonScalar { ok = false, error = error, kind = 0, text = "", int_value = 0, float_value = 0.0, pos = pos }
}

# One UTF-8 character at the cursor ("" past the end).
fn json_char(JsonCursor c) → string {
    let int len ← c.text.length()
    if c.pos ≥ len { return "" }
    return (c.text.slice(c.pos, c.pos + 1) ⊥ "")
}

fn json_skip_ws(JsonCursor c) → JsonCursor {
    mut JsonCursor out ← copy c
    mut bool go ← true
    while go {
        let string ch ← json_char(out)
        if ch ≡ " " or ch ≡ "\t" or ch ≡ "\n" or ch ≡ "\r" {
            out ← JsonCursor { text = out.text, pos = out.pos + 1 }
        } else {
            go ← false
        }
    }
    return out
}

fn json_is_digit(string ch) → bool {
    return (ch ≡ "0") or (ch ≡ "1") or (ch ≡ "2") or (ch ≡ "3") or (ch ≡ "4") or (ch ≡ "5") or (ch ≡ "6") or (ch ≡ "7") or (ch ≡ "8") or (ch ≡ "9")
}

# Parse a JSON string starting at the opening quote.
fn json_parse_string(JsonCursor c) → JsonScalar {
    mut JsonCursor cur ← JsonCursor { text = c.text, pos = c.pos + 1 }
    mut string out ← ""
    mut bool done ← false
    mut string err ← ""
    while (not done) and (err ≡ "") {
        let string ch ← json_char(cur)
        if ch ≡ "" {
            err ← "malformed JSON: unterminated string"
        } elif ch ≡ "\"" {
            done ← true
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        } elif ch ≡ "\\" {
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            let string esc ← json_char(cur)
            if esc ≡ "" {
                err ← "malformed JSON: unterminated string"
            } elif esc ≡ "\"" {
                out ← out + "\""
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "\\" {
                out ← out + "\\"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "/" {
                out ← out + "/"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "b" {
                out ← out + "\u{8}"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "f" {
                out ← out + "\u{c}"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "n" {
                out ← out + "\n"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "r" {
                out ← out + "\r"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "t" {
                out ← out + "\t"
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } elif esc ≡ "u" {
                err ← "malformed JSON: \\uXXXX escapes are not supported by the minimal I1 JSON parser"
            } else {
                err ← "malformed JSON: unknown escape \\" + esc
            }
        } else {
            out ← out + ch
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        }
    }
    return JsonScalar { ok = err ≡ "", error = err, kind = 1, text = out, int_value = 0, float_value = 0.0, pos = cur.pos }
}

# Parse a JSON number starting at '-' or a digit. Integer-form numbers (no
# '.', 'e', 'E') parse as int; float-form numbers parse as float.
fn json_parse_number(JsonCursor c) → JsonScalar {
    let string body_text ← c.text
    let int start ← c.pos
    mut JsonCursor cur ← copy c
    if json_char(cur) ≡ "-" {
        cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
    }
    mut bool digits ← false
    mut bool go ← true
    while go {
        let string ch ← json_char(cur)
        if json_is_digit(ch) {
            digits ← true
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        } else {
            go ← false
        }
    }
    if not digits {
        return json_fail("malformed JSON: invalid number", start)
    }
    mut bool is_float ← false
    if json_char(cur) ≡ "." {
        is_float ← true
        cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        mut bool frac ← false
        go ← true
        while go {
            let string ch ← json_char(cur)
            if json_is_digit(ch) {
                frac ← true
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } else {
                go ← false
            }
        }
        if not frac {
            return json_fail("malformed JSON: invalid fraction", cur.pos)
        }
    }
    let string e_ch ← json_char(cur)
    if e_ch ≡ "e" or e_ch ≡ "E" {
        is_float ← true
        cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        let string sign ← json_char(cur)
        if sign ≡ "+" or sign ≡ "-" {
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        }
        mut bool exp ← false
        go ← true
        while go {
            let string ch ← json_char(cur)
            if json_is_digit(ch) {
                exp ← true
                cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            } else {
                go ← false
            }
        }
        if not exp {
            return json_fail("malformed JSON: invalid exponent", cur.pos)
        }
    }
    let int token_len ← cur.pos - start
    if (not is_float) and (token_len ≻ 18) {
        return json_fail("malformed JSON: integer out of range", cur.pos)
    }
    if is_float and (token_len ≻ 24) {
        return json_fail("malformed JSON: number too long", cur.pos)
    }
    let string token ← (body_text.slice(start, cur.pos) ⊥ "")
    if is_float {
        let float fv ← token ↦ float ⊥ 0.0
        return JsonScalar { ok = true, error = "", kind = 3, text = token, int_value = 0, float_value = fv, pos = cur.pos }
    }
    let int iv ← token ↦ int ⊥ 0
    return JsonScalar { ok = true, error = "", kind = 2, text = token, int_value = iv, float_value = 0.0, pos = cur.pos }
}

# Parse a /generate request body (D3) into the fixed schema. Unknown fields,
# duplicate fields, wrong types, and malformed JSON reject with typed causes.
fn json_parse_generate_body(string body) → GenerateRequest {
    let string body_text ← body
    let JsonCursor start ← JsonCursor { text = body_text, pos = 0 }
    mut JsonCursor cur ← json_skip_ws(start)
    if json_char(cur) ≢ "{" {
        return rejected_generate_request("malformed JSON: expected an object")
    }
    cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }

    mut GenerateRequest out ← fresh_generate_request()
    mut bool go ← true
    mut bool after_comma ← false
    while go {
        cur ← json_skip_ws(cur)
        let string key_start ← json_char(cur)
        if key_start ≡ "}" {
            # A `}` directly after `{` is the empty object; a `}` after a
            # comma is a trailing-comma reject (fail closed).
            if after_comma {
                return rejected_generate_request("malformed JSON: trailing comma")
            }
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            go ← false
            break
        }
        if key_start ≢ "\"" {
            return rejected_generate_request("malformed JSON: expected a field name")
        }
        let JsonScalar key ← json_parse_string(cur)
        if not key.ok {
            return rejected_generate_request(key.error)
        }
        let string fname ← key.text
        cur ← json_skip_ws(JsonCursor { text = cur.text, pos = key.pos })
        if json_char(cur) ≢ ":" {
            return rejected_generate_request("malformed JSON: expected ':' after field '" + fname + "'")
        }
        cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
        cur ← json_skip_ws(cur)

        let string vch ← json_char(cur)
        mut JsonScalar val ← json_fail("malformed JSON: unexpected value", cur.pos)
        if vch ≡ "\"" {
            val ← json_parse_string(cur)
        } elif vch ≡ "-" or json_is_digit(vch) {
            val ← json_parse_number(cur)
        } else {
            return rejected_generate_request("field '" + fname + "': value must be a JSON string or number (minimal I1 parser)")
        }
        if not val.ok {
            return rejected_generate_request(val.error)
        }
        cur ← json_skip_ws(JsonCursor { text = cur.text, pos = val.pos })

        # Dispatch the fixed /generate schema. Unknown fields are reject rows
        # mirroring the gradus imperium_admissum vocabulary (never silently
        # ignored); duplicates fail closed too.
        if fname ≡ "prompt" {
            if out.has_prompt {
                return rejected_generate_request("duplicate field 'prompt'")
            }
            if val.kind ≢ 1 {
                return rejected_generate_request("field 'prompt' must be a JSON string")
            }
            if val.text ≡ "" {
                return rejected_generate_request("field 'prompt' must not be empty")
            }
            out ← generate_request_with_prompt(out, val.text)
        } elif fname ≡ "max_tokens" {
            if out.has_max_tokens {
                return rejected_generate_request("duplicate field 'max_tokens'")
            }
            if val.kind ≢ 2 {
                return rejected_generate_request("field 'max_tokens' must be an integer")
            }
            out ← generate_request_with_max_tokens(out, val.int_value)
        } elif fname ≡ "max_prompt" {
            if out.has_max_prompt {
                return rejected_generate_request("duplicate field 'max_prompt'")
            }
            if val.kind ≢ 2 {
                return rejected_generate_request("field 'max_prompt' must be an integer")
            }
            out ← generate_request_with_max_prompt(out, val.int_value)
        } elif fname ≡ "temperature" {
            if out.has_temperature {
                return rejected_generate_request("duplicate field 'temperature'")
            }
            if (val.kind ≢ 2) and (val.kind ≢ 3) {
                return rejected_generate_request("field 'temperature' must be a JSON number")
            }
            let float tv ← if_float(val.kind ≡ 2, (val.int_value ↦ float), val.float_value)
            out ← generate_request_with_temperature(out, tv)
        } elif fname ≡ "top_k" {
            if out.has_top_k {
                return rejected_generate_request("duplicate field 'top_k'")
            }
            if val.kind ≢ 2 {
                return rejected_generate_request("field 'top_k' must be an integer")
            }
            out ← generate_request_with_top_k(out, val.int_value)
        } elif fname ≡ "top_p" {
            if out.has_top_p {
                return rejected_generate_request("duplicate field 'top_p'")
            }
            if (val.kind ≢ 2) and (val.kind ≢ 3) {
                return rejected_generate_request("field 'top_p' must be a JSON number")
            }
            let float pv ← if_float(val.kind ≡ 2, (val.int_value ↦ float), val.float_value)
            out ← generate_request_with_top_p(out, pv)
        } elif fname ≡ "min_p" {
            if out.has_min_p {
                return rejected_generate_request("duplicate field 'min_p'")
            }
            if (val.kind ≢ 2) and (val.kind ≢ 3) {
                return rejected_generate_request("field 'min_p' must be a JSON number")
            }
            let float mv ← if_float(val.kind ≡ 2, (val.int_value ↦ float), val.float_value)
            out ← generate_request_with_min_p(out, mv)
        } elif fname ≡ "repeat_penalty" {
            if out.has_repeat_penalty {
                return rejected_generate_request("duplicate field 'repeat_penalty'")
            }
            if (val.kind ≢ 2) and (val.kind ≢ 3) {
                return rejected_generate_request("field 'repeat_penalty' must be a JSON number")
            }
            let float rv ← if_float(val.kind ≡ 2, (val.int_value ↦ float), val.float_value)
            out ← generate_request_with_repeat_penalty(out, rv)
        } elif fname ≡ "seed" {
            if out.has_seed {
                return rejected_generate_request("duplicate field 'seed'")
            }
            if val.kind ≢ 2 {
                return rejected_generate_request("field 'seed' must be an integer")
            }
            out ← generate_request_with_seed(out, val.int_value)
        } else {
            return rejected_generate_request("unknown field '" + fname + "' (imperium_admissum reject — never silently ignored)")
        }

        cur ← json_skip_ws(cur)
        let string sep ← json_char(cur)
        if sep ≡ "," {
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            after_comma ← true
        } elif sep ≡ "}" {
            cur ← JsonCursor { text = cur.text, pos = cur.pos + 1 }
            after_comma ← false
            go ← false
        } else {
            return rejected_generate_request("malformed JSON: expected ',' or '}'")
        }
    }

    # No trailing content allowed.
    let JsonCursor end ← json_skip_ws(cur)
    if end.pos ≺ body_text.length() {
        return rejected_generate_request("malformed JSON: trailing content after object")
    }
    if not out.has_prompt {
        return rejected_generate_request("missing required field 'prompt'")
    }
    return out
}

# Value-preserving picks (the toolchain has no inline if-expression).
fn if_int(bool cond, int a, int b) → int {
    if cond { return a }
    return b
}

fn if_float(bool cond, float a, float b) → float {
    if cond { return a }
    return b
}

# ---------------------------------------------------------------------------
# Generation config (the nine gradus GeneratioConfigura fields, D2/D4)
# ---------------------------------------------------------------------------

class GenerateConfig {
    mut int contextus
    mut int magna_promptus
    mut int maxima_verborum
    mut int semen
    mut float temperatura
    mut int top_k
    mut float top_p
    mut float min_p
    mut float poena_repetitionis
}

# The effective prompt-token admission bound: the configured --max-prompt, or
# the model context limit when unset (0 sentinel, same convention as context).
fn effective_max_prompt(ServeConfig server) → int {
    return if_int(server.max_prompt ≡ 0, model_context_limit(), server.max_prompt)
}

# The effective live prompt: the --prompt text, or the frozen fixture when
# unset (the parser rejects an empty --prompt, so "" is a safe sentinel).
fn effective_prompt(ServeConfig server) → string {
    if server.prompt ≢ "" { return server.prompt }
    return frozen_prompt_text()
}

# D2 precedence: body fields override server flags, flags override defaults.
# `magna_promptus` is the prompt-token admission bound, not a request batch:
# the engine rejects any prompt longer than it with "prompt length exceeds
# max_prompt" (gradus generation/dense.fab:237).
fn build_generate_config(GenerateRequest req, ServeConfig server) → GenerateConfig {
    let int contextus ← if_int(server.context ≡ 0, model_context_limit(), server.context)
    let int magna_promptus ← if_int(req.has_max_prompt, req.max_prompt, effective_max_prompt(server))
    let int maxima ← if_int(req.has_max_tokens, req.max_tokens, server.max_tokens)
    let int seed ← if_int(req.has_seed, req.seed, server.seed)
    let float temperatura ← if_float(req.has_temperature, req.temperature, 0.0)
    let int top_k ← if_int(req.has_top_k, req.top_k, 0)
    let float top_p ← if_float(req.has_top_p, req.top_p, 1.0)
    let float min_p ← if_float(req.has_min_p, req.min_p, 0.0)
    let float poena ← if_float(req.has_repeat_penalty, req.repeat_penalty, 1.0)
    return GenerateConfig {
        contextus = contextus,
        magna_promptus = magna_promptus,
        maxima_verborum = maxima,
        semen = seed,
        temperatura = temperatura,
        top_k = top_k,
        top_p = top_p,
        min_p = min_p,
        poena_repetitionis = poena
    }
}

# ---------------------------------------------------------------------------
# Prompt encode (the "encode" phase of the generation pipeline)
# ---------------------------------------------------------------------------

class EncodeResult {
    mut bool ok
    mut string error
    mut list<int> ids
}

# Text → token ids (the "encode" phase) through the admitted model's real
# G3 tokenizer (carried on ResidentModel). `tokenizator.tokenize` is the
# provider encode route — SMOLLM scanner + parse-special on. A typed
# TokenizerError fails closed with its message; the request path maps that
# to 400.
#
# The catch arm stays straight-line: the MIR stepper (`faber test`) cannot
# lower a conditional inside a `cape` block that wraps a library-provider
# call (recorded toolchain limitation, cf. BD-3).
fn encode_prompt(tokenizator.Tokenizer tok, string prompt) → EncodeResult {
    do {
        let list<int> ids ← tokenizator.tokenize(tok, prompt)
        return EncodeResult { ok = true, error = "", ids = ids }
    }
    catch err {
        return EncodeResult { ok = false, error = "prompt encode failed: " + err.message, ids = [] }
    }
}

# ---------------------------------------------------------------------------
# Response assembly (D3) + error classification
# ---------------------------------------------------------------------------

# Ids → detokenized text (G3 `tokenizator.decode` over the admitted
# tokenizer). Decode happens before any response body is assembled or any
# stream is opened: a typed TokenizerError fails closed with its message
# instead of emitting a partial body. The id list in `tokens` stays the
# machine surface.
#
# Straight-line catch arm for the same BD-3 stepper constraint as
# encode_prompt.
class DecodeResult {
    mut bool ok
    mut string error
    mut string text
}

fn tokens_text(tokenizator.Tokenizer tok, list<int> tokens) → DecodeResult {
    do {
        return DecodeResult { ok = true, error = "", text = tokenizator.decode(tok, tokens) }
    }
    catch err {
        return DecodeResult { ok = false, error = "token decode failed: " + err.message, text = "" }
    }
}

fn tokens_json(list<int> tokens) → string {
    mut string out ← "["
    mut int i ← 0
    while i ≺ tokens.length() {
        if i ≻ 0 { out ← out + "," }
        let int t ← tokens.get(i) coalesce 0
        out ← out + (t ↦ string)
        i ← i + 1
    }
    return out + "]"
}

# D3 finish_reason: "length" at max_tokens; "eos" when the engine stopped
# early at an admitted tokenizer EOG id (the pinned engine excludes EOG ids
# from the top-1 surface, so with the frozen row the ceiling always binds).
fn finish_reason(int generated, int max_tokens) → string {
    if generated ≥ max_tokens { return "length" }
    return "eos"
}

# The /generate response body. `model` carries the minimal identity facts
# held by this server (sha256 + path); the full /model identity surface is
# U3 (not yet landed). `text` is the pre-decoded detokenized string (the
# caller fails closed before assembly); `tokens` keeps the machine surface.
fn generate_response_body(ServerState st, string text, list<int> tokens, list<int> prompt_ids, int max_tokens) → string {
    let int pn ← prompt_ids.length()
    let int cn ← tokens.length()
    let int total ← pn + cn
    let string reason ← finish_reason(cn, max_tokens)
    return "{\"model\":{\"sha256\":\"" + json_escape(st.sha256) + "\",\"path\":\"" + json_escape(st.model_path) + "\"},\"text\":\"" + json_escape(text) + "\",\"tokens\":" + tokens_json(tokens) + ",\"finish_reason\":\"" + reason + "\",\"usage\":{\"prompt_tokens\":" + (pn ↦ string) + ",\"completion_tokens\":" + (cn ↦ string) + ",\"total_tokens\":" + (total ↦ string) + "}}"
}

# JSON-string escape for health/error/generate bodies (typed causes carry
# quotes, e.g. unknown config field "bogus"; a configured model path may
# carry backslashes; decoded model text carries arbitrary control bytes).
# JSON requires every U+0000..U+001F code point escaped. A replace chain
# cannot express that: it saw only the named controls, so \b, \f, \v and the
# rest of the C0 range went out raw and a one-byte vocab token produced
# invalid JSON (S-F5). The escape set and short forms mirror the canonical
# serializer (`norma:json/lexer` escape_char/control_escape).
fn json_escape(string s) → string {
    mut string out ← ""
    mut int i ← 0
    while i ≺ s.length() {
        out ← out + json_escape_char((s.slice(i, i + 1) ⊥ ""))
        i ← i + 1
    }
    return out
}

# One character as an escaped fragment. A character is a length-1 string, so
# the C0 test reads its single UTF-8 byte; multi-byte characters pass
# through unchanged.
fn json_escape_char(string c) → string {
    if c ≡ "\\" { return "\\\\" }
    if c ≡ "\"" { return "\\\"" }
    if c ≡ "\n" { return "\\n" }
    if c ≡ "\r" { return "\\r" }
    if c ≡ "\t" { return "\\t" }
    let list<b8> encoded ← c ↦ list<b8>
    if encoded.length() ≡ 1 {
        let int code ← (encoded.get(0) coalesce (0x00 ∷ b8)) ↦ u8 ↦ int
        if code ≡ 8 { return "\\b" }
        if code ≡ 12 { return "\\f" }
        if code ≺ 32 {
            return "\\u00" + json_hex_digit(code / 16) + json_hex_digit(code % 16)
        }
    }
    return c
}

fn json_hex_digit(int digit) → string {
    return ("0123456789abcdef".slice(digit, digit + 1) ⊥ "")
}

fn error_body(string error) → string {
    return "{\"error\":\"" + json_escape(error) + "\"}"
}

# D3: 503 before ready carries the state.
fn state_body(ServerState st) → string {
    return "{\"state\":\"" + st.state + "\",\"error\":\"" + json_escape(st.error_text) + "\"}"
}

# G2 generate / construct_generation error → HTTP status. Request-side
# causes are the typed ConfiguraInvalida rows (field domains, prompt fit,
# the context cursor). Engine-side failures (prefill/forward/decode) are 500.
fn classify_generate_error(string err) → int {
    if err.starts_with("maximum generated tokens") or err.starts_with("needs at least one prompt token") or err.starts_with("prompt length") or err.starts_with("seed must") or err.starts_with("temperature must") or err.starts_with("top-p must") or err.starts_with("top-k must") or err.starts_with("min-p must") or err.starts_with("repetition penalty") or err.starts_with("context length") or err.starts_with("prompt batch") or err.starts_with("malformed generation") or err.starts_with("unsupported generation") or err.starts_with("unknown generation") {
        return 400
    }
    return 500
}

# Request-body extraction. The provider delivers the body as text; a value
# carrying a `list<b8>` is also accepted and decoded with `value ↦ list<b8>`
# then `list<b8> ↦ string` (UTF-8). A string value is taken as-is. The gap
# marker is only for a failed byte→text decode (invalid UTF-8).
fn request_body_text(value body_value) → string {
    if body_value is string {
        return body_value ↦ string ⊥ body_read_gap_marker()
    }
    let list<b8> raw ← body_value ↦ list<b8> ⊥ ||
    return raw ↦ string ⊥ body_read_gap_marker()
}

fn request_body_from_raw(value request) → string {
    if request is map<string, value> {
        # Guarded by the `is` test, so the default never applies.
        let map<string, value> tab ← request ↦ map<string, value> ⊥ empty
        return request_body_text(tab.get("body"))
    }
    return body_read_gap_marker()
}

# ---------------------------------------------------------------------------
# Host provider routes through `norma:http/server` (H6).
# ---------------------------------------------------------------------------

fn json_headers() → headers.Headers {
    mut headers.Headers head ← headers.empty()
    if head.append("content-type", "application/json") {
    }
    return head
}

# A reply that cannot be written (the peer went away) drops that one request:
# it is logged and the serve loop continues.
fn reply_json(server.Incoming incoming, int status, string body) → void {
    do {
        server.reply(incoming, status, json_headers(), body)
    }
    catch err {
        stderr_write("inferentia: reply dropped: §\n"(err))
    }
}

fn wants_sse(server.Incoming incoming) → bool {
    let string ∪ none accept ← incoming.req.header("accept")
    if accept not is none {
        let string a ← accept ↦ string
        if a.contains("text/event-stream") {
            return true
        }
    }
    let string ∪ none stream ← incoming.req.query_field("stream")
    if stream not is none {
        let string s ← stream ↦ string
        if s ≡ "1" or s ≡ "true" {
            return true
        }
    }
    return false
}

# One SSE event written and flushed to the open response. false when the peer
# went away (the write failed): the decode loop then ends the generation.
fn send_sse_event(server.Stream stream, string name, string data) → bool {
    do {
        let sse.Event ev ← sse.Event { name = name, data = data, id = "", retry = "" }
        server.send_event(stream, ev)
        return true
    }
    catch err {
        stderr_write("inferentia: stream dropped: §\n"(err))
        return false
    }
}

# The `token` event of one chosen id: the decode-loop sink of a streamed run.
fn send_token_event(server.Stream stream, int id) → bool {
    return send_sse_event(stream, "token", id ↦ string)
}

# Stream one /generate over SSE. Request validation runs before the stream
# opens, so a rejected request is still a JSON 4xx. Then the response opens, the
# decode loop writes one `token` event per chosen id between decode steps (each
# flushed to the client as it is written), and the stream ends with a `done`
# event carrying the JSON body, or an `error` event if generation or detokenize
# fails after the stream is open (the status line has already gone out).
fn stream_generate(server.Incoming incoming, ServerState st, GenerateConfig cfg, list<int> prompt_ids, ResidentModel model, port.PortWeights weights) → void {
    do {
        check_generate_port(cfg, prompt_ids, model)
    }
    catch err {
        reply_json(incoming, classify_generate_error(err.message), error_body(err.message))
        return
    }
    do {
        let server.Stream stream ← server.open_sse(incoming)
        if stream_run(stream, st, cfg, prompt_ids, model, weights) {
            server.finish_stream(stream, server.keep_alive(incoming.req.headers))
        }
    }
    catch err {
        stderr_write("inferentia: stream dropped: §\n"(err))
    }
}

# The decode loop of one open stream. true when the stream is still writable,
# so the caller may finish it; false once a write failed.
fn stream_run(server.Stream stream, ServerState st, GenerateConfig cfg, list<int> prompt_ids, ResidentModel model, port.PortWeights weights) → bool {
    let (int) → bool sink ← int t ∴ send_token_event(stream, t)
    do {
        let pgen.PortResult run ← run_generate_port(cfg, prompt_ids, model, weights, decoder.eog_stop(), false, sink)
        if st.cancelled {
            return send_sse_event(stream, "error", error_body("generation cancelled (shutdown)"))
        }
        let DecodeResult dec ← tokens_text(model.tokenizer, run.ids)
        if dec.ok {
            return send_sse_event(stream, "done", generate_response_body(st, dec.text, run.ids, prompt_ids, cfg.maxima_verborum))
        }
        return send_sse_event(stream, "error", error_body(dec.error))
    }
    catch err {
        return send_sse_event(stream, "error", error_body(err.message))
    }
    return false
}

# Write text to stdout without a trailing newline. Console writes report on
# the error channel (IoFault); a broken stdout is a trap.
fn stdout_write(string text) → void {
    do {
        console.write_partial(text)
    }
    catch err {
        panic "stdout write failed: §"(err)
    }
}

# Write a line to stderr.
fn stderr_write(string text) → void {
    port.port_warn(text)
}

# D5 exit-code delivery: terminate the process with the given code (0 clean
# shutdown, 2 admission/load failure at shutdown). The route is the language's
# process-exit primitive (`norma:process` `exit_process`); never returns on success — the
# generated wrapper panics if it returns.
fn exit_with(int code) → void {
    proc.exit_process(code)
}

# ---------------------------------------------------------------------------
# Gradus provider composition (ruling 2615e6a9)
#
# Admit: path → norma:crypto digest + header-prefix read → gguf.admit (pinned SmolLM2
# counts). Tokenize: G3. Generate: G2 generate_dense_with_stop over a resident dense engine.
# ---------------------------------------------------------------------------

# Pinned SmolLM2-360M-Instruct F32 row counts (GGUF v3: 30 KV, 290 tensors,
# all F32, general.file_type 0, tokenizer padding id 0).
fn pinned_expect_kv() → int { return 30 }
fn pinned_expect_tensors() → int { return 290 }
fn pinned_expect_elements() → int { return 361821120 }
fn pinned_expect_f32() → int { return 290 }
fn pinned_expect_q4k() → int { return 0 }
fn pinned_expect_q5() → int { return 0 }
fn pinned_expect_q6() → int { return 0 }
fn pinned_expect_q8() → int { return 0 }
fn pinned_expect_file_type() → int { return 0 }
fn pinned_expect_pad_id() → int { return 0 }

# Host I/O reports on the error channel (IoFault, no message text);
# admit_model's catch maps it into BadCapsule.
#
# The whole-file SHA-256 is Norma's streaming `crypto.digest_file`; memory use
# does not grow with the file size, and an I/O failure crosses as an IoFault.
fn host_digestio(string path) → string ⇥ fault.IoFault {
    return crypto.digest_file(path)
}

fn host_mensura(string path) → int ⇥ fault.IoFault {
    return fsys.byte_length(path)
}

# The header prefix [0, length): everything the manifest authority inspects.
fn host_prefix(string path, int length) → list<u8> ⇥ fault.IoFault {
    let list<b8> raw ← fsys.read_range(path, 0, length)
    let list<u8> prefix ← raw ↦ list<u8>
    return prefix
}

# Admission ceiling for the artifact: the pinned row's exact byte length
# (S-F3 / G1-U8). Derived from the pinned size, never a new hardcoded cap.
fn model_size_ceiling() → int {
    return model_file_size_bytes()
}

# Size gate for admit_model: the refusal diagnostic when `observed` exceeds
# the ceiling, null when the path may be admitted. Pure so the admission
# rows can feed it sizes as inputs.
fn check_admission_size(int observed) → string ∪ none {
    if observed ≻ model_size_ceiling() {
        return "model byte length " + (observed ↦ string) + " exceeds the admission ceiling " + (model_size_ceiling() ↦ string)
    }
    return null
}

# The admitted digest plus the manifest gradus inspected while admitting it:
# the header is parsed once, here, and the manifest is passed on.
class AdmittedModel {
    mut string sha
    mut gguf_manifest.GgufManifest manifest
}

# Path → host stat + digest + header prefix → gradus admit. Returns the carried
# digest and the inspected manifest (identity {sha-256, digest, artifact length}). The stat runs first and the ceiling gate refuses an over-ceiling path
# before anything is read (G1-U8); only the header prefix [0, data offset) is
# read, never the tensor data, and the stat length is the artifact length the
# digest covers.
fn admit_model(string path) → AdmittedModel ⇥ gguf.GgufError {
    mut string digest ← ""
    mut list<u8> prefix ← []
    mut int observed ← 0
    mut string ∪ none size_refusal ← null
    do {
        observed ← host_mensura(path)
        size_refusal ← check_admission_size(observed)
        if size_refusal is none and observed ≺ pinned_data_offset() {
            size_refusal ← "model byte length " + (observed ↦ string) + " is shorter than the pinned header prefix " + (pinned_data_offset() ↦ string)
        }
        if size_refusal is none {
            digest ← host_digestio(path)
            prefix ← host_prefix(path, pinned_data_offset())
        }
    }
    catch err {
        throw variant BadCapsule { message = "§"(err) }
    }
    if size_refusal not is none {
        throw variant BadCapsule { message = size_refusal coalesce "" }
    }
    let gguf.Admission admission ← gguf.admit_with_manifest(prefix, digest, observed, pinned_expect_file_type(), pinned_expect_pad_id(), pinned_expect_kv(), pinned_expect_tensors(), pinned_expect_elements(), pinned_expect_f32(), pinned_expect_q4k(), pinned_expect_q5(), pinned_expect_q6(), pinned_expect_q8())
    return AdmittedModel { sha = admission.cap.digest(), manifest = admission.manifest }
}

fn to_generation_config(GenerateConfig cfg, list<int> eog_ids) → config.GenerationConfig ⇥ config.GenerationError {
    return config.construct_generation(cfg.contextus, cfg.magna_promptus, cfg.maxima_verborum, cfg.semen, cfg.temperatura ↦ f32, cfg.top_k, cfg.top_p ↦ f32, cfg.min_p ↦ f32, cfg.poena_repetitionis ↦ f32, eog_ids)
}

# The admitted G3 tokenizer for /generate (built once after admit). The
# tokenizer carried here is the one built from the admitted manifest — the
# same tables the EOG stop set came from. The weights are not here: they live
# in `port.PortWeights`, loaded once and passed beside this record.
class ResidentModel {
    mut gguf_manifest.GgufManifest manifest
    mut tokenizator.Tokenizer tokenizer
    mut list<int> eog_ids
}

fn empty_manifest() → gguf_manifest.GgufManifest {
    return gguf_manifest.GgufManifest {
        identity = artifact.ContentIdentity { algorithm = "sha-256", digest = "", length = 0 },
        version = 0,
        alignment = 0,
        data_start = 0,
        artifact_length = 0,
        metadata = [],
        tensors = []
    }
}

# A manifest that carries only the admitted identity (digest + artifact length):
# what the load-time identity re-check reads.
fn identity_manifest(string sha, int length) → gguf_manifest.GgufManifest {
    return gguf_manifest.GgufManifest {
        identity = artifact.ContentIdentity { algorithm = "sha-256", digest = sha, length = length },
        version = 0,
        alignment = 0,
        data_start = 0,
        artifact_length = length,
        metadata = [],
        tensors = []
    }
}

# The unready placeholder tokenizer: empty tables. `build_tables` rejects
# an empty vocabulary, so the placeholder is the class literal; any encode
# against it fails closed with a typed UnknownTrace cause (never read on
# the serve path — /generate is 503-gated before ready).
fn empty_tokenizer() → tokenizator.Tokenizer {
    mut map<string, int> no_vocab ← empty
    mut map<string, int> no_merges ← empty
    return tokenizator.Tokenizer {
        words = [],
        vocab = no_vocab,
        concursus = no_merges,
        special_texts = [],
        specialia_ids = [],
        eog = [],
        add_bos = false,
        chat_template = "",
        multitudo = 0
    }
}

fn empty_resident() → ResidentModel {
    return ResidentModel {
        manifest = empty_manifest(),
        tokenizer = empty_tokenizer(),
        eog_ids = []
    }
}

# ---------------------------------------------------------------------------
# I-live — one-shot generate on an admitted GGUF
#
# Serve loads the port weights once and decodes every /generate from them
# with an explicit StopPolicy (default eog_stop). live is the composed
# provider run: admit → inspect → G3 tokenizer tables → port weights →
# port decode (eog_stop by default; --ignore-eos selects ignore_eos). There
# is no host-side CPU path: CPU inference is the same kernels under
# `faber run --device cpu` (several cores) or `--device reference` (one core,
# the oracle).
# ---------------------------------------------------------------------------

fn pinned_digest() → string {
    return "07735177a3542cbc0b0665051ce1922b55c4c9698de65131e65f2aea87a935e0"
}

fn pinned_data_offset() → int {
    return 1786560
}

# NOTE: the former 16-token ignore_eos golden was Q4_K_M evidence (U5
# record.json); it does not describe the F32 row and is retired. The F32
# references are the A1 oracle's (tests/oracle/a1_oracle.py).

fn live_file_size(string path) → int ⇥ fault.IoFault {
    return fsys.byte_length(path)
}

fn live_read_range(string path, int start, int length) → list<b8> ⇥ fault.IoFault {
    return fsys.read_range(path, start, length)
}

# The bounds-checked byte source for the manifest reader and the port loader.
# An I/O fault surfaces as BadSource carrying the fault's rendering.
fn live_range(string path, int total, int initium, int longitudo) → list<b8> ⇥ gguf_manifest.GgufManifestError {
    if initium ≺ 0 or longitudo ≺ 0 or initium ≻ total - longitudo {
        throw variant BadSource { message = "range request exceeds the artifact" }
    }
    mut list<b8> raw ← []
    do {
        raw ← live_read_range(path, initium, longitudo)
    }
    catch err {
        throw variant BadSource { message = "range read failed: §"(err) }
    }
    if raw.length() ≢ longitudo {
        throw variant BadSource { message = "short range read" }
    }
    return raw
}

fn live_ids_text(list<int> ids) → string {
    mut string out ← "["
    mut int i ← 0
    while i ≺ ids.length() {
        if i ≻ 0 { out ← out + ", " }
        out ← out + ((ids.get(i) coalesce 0) ↦ string)
        i ← i + 1
    }
    return out + "]"
}

# Space-joined ids for the one-shot `ids=` line (recipes grep `^ids=30 2`).
fn live_ids_flat(list<int> ids) → string {
    mut string out ← ""
    mut int i ← 0
    while i ≺ ids.length() {
        if i ≻ 0 { out ← out + " " }
        out ← out + ((ids.get(i) coalesce 0) ↦ string)
        i ← i + 1
    }
    return out
}

fn live_first_divergence(list<int> observed, list<int> golden) → string {
    mut int i ← 0
    let int n ← observed.length()
    let int g ← golden.length()
    let int lim ← if_int(n ≺ g, n, g)
    while i ≺ lim {
        let int a ← observed.get(i) coalesce -1
        let int b ← golden.get(i) coalesce -2
        if a ≢ b {
            return "index " + (i ↦ string) + ": observed " + (a ↦ string) + " vs golden " + (b ↦ string)
        }
        i ← i + 1
    }
    if n ≢ g {
        return "length " + (n ↦ string) + " vs golden " + (g ↦ string)
    }
    return "none"
}

fn live_requested(list<string> argv) → bool {
    mut int i ← 0
    while i ≺ argv.length() {
        let string arg ← argv.get(i) coalesce ""
        if arg ≡ "live" { return true }
        i ← i + 1
    }
    return false
}

fn live_build_tokenizer(gguf_manifest.GgufManifest m) → tokenizator.Tokenizer {
    do {
        return tokenizator.build(m)
    }
    catch err {
        panic "G3 tokenizer tables failed: " + err.message
    }
}

fn live_tokenize(tokenizator.Tokenizer tok, string prompt) → list<int> {
    do {
        return tokenizator.tokenize(tok, prompt)
    }
    catch err {
        panic "G3 tokenize failed: " + err.message
    }
}

# Generated ids → decoded text through the admitted tokenizer (`tokenizator.decode`).
# A typed TokenizerError fails closed — no placeholder or partial text.
# Straight-line catch arm for the BD-3 stepper constraint.
fn live_decode(tokenizator.Tokenizer tok, list<int> tokens) → string {
    do {
        return tokenizator.decode(tok, tokens)
    }
    catch err {
        panic "G3 decode failed: " + err.message
    }
}

# The live stop policy: default eog_stop; --ignore-eos runs to the
# --max-tokens ceiling (the 16-token golden's stop).
fn live_stop_policy(bool ignore_eos) → decoder.StopPolicy {
    if ignore_eos { return decoder.ignore_eos() }
    return decoder.eog_stop()
}

# Pinned-row digest gate for serve admission (S-F1): the refusal diagnostic
# when the admitted digest is not the pinned row's, null when it is. `serve`
# runs this before the operator pin, so the structural admission contract
# (`gguf.admit` is pinned to the SmolLM2 row) is always bound to one verified
# file identity — the binding `live_run` has always applied. Pure so the
# serve rows can feed digests as inputs.
fn check_pinned_digest(string admitted) → string ∪ none {
    if admitted ≢ pinned_digest() {
        return "model digest " + admitted + " is not the pinned row digest " + pinned_digest()
    }
    return null
}

# Operator digest gate for serve admission (G1-U9): the refusal diagnostic
# when the admitted digest does not match the operator-supplied
# --expected-digest, null when admission proceeds. An empty expected means
# unset — the flag adds no constraint of its own; the pinned-row binding is
# `check_pinned_digest` above. Pure so the serve rows can feed digests as
# inputs.
fn check_expected_digest(string admitted, string expected) → string ∪ none {
    if expected ≡ "" {
        return null
    }
    if admitted ≡ expected {
        return null
    }
    return "model digest " + admitted + " does not match --expected-digest " + expected
}

# Materialization re-verify (G1-U9): the file is re-digested at load time,
# after admission, so a swap between admit and load cannot serve swapped
# weights. The refusal covers the admit → load TOCTOU (materialized ≠
# admitted) and the --expected-digest pin carried from serve; null lets
# the weights are read. Pure so the rows feed digests as inputs.
fn check_materialized_digest(string admitted, string materialized, string expected) → string ∪ none {
    if materialized ≢ admitted {
        return "model changed between admission and materialization: admitted=" + admitted + " materialized=" + materialized
    }
    if expected ≢ "" and materialized ≢ expected {
        return "materialized digest " + materialized + " does not match --expected-digest " + expected
    }
    return null
}

# A1 port load (U-G): every tensor read once and reinterpreted in bulk as a
# literal-shape tensor (`raw ↦ tensor<f32, [N, K]> via Le`). `path` and the
# bounds-checked `live_range` are the byte source; the shapes, names and the
# BadBounds/UnknownLayout refusals live in port_weights.fab.
fn load_port_weights(string path, gguf_manifest.GgufManifest admitted) → port.PortWeights ⇥ gguf_manifest.GgufManifestError {
    mut int total ← 0
    do {
        total ← live_file_size(path)
    }
    catch err {
        throw variant BadSource { message = "length read failed: §"(err) }
    }
    return port.load_weights(
        (int initium, int longitudo) → list<b8> ⇥ gguf_manifest.GgufManifestError ∴ live_range(path, total, initium, longitudo),
        admitted
    )
}

# Load-time length guard for the port path (A1 one-manifest). It is an
# ADDITIONAL cheap check on top of the load-time digest (verify_load_digest),
# never a replacement for it: the manifest was inspected for the admitted
# digest, and the file's current byte length equals the admitted length, checked
# before and again after the weights are read. A same-size content swap is the
# digest's job. Pure so the rows can feed sizes and digests as inputs.
fn check_load_identity(string sha, gguf_manifest.GgufManifest admitted, int observed) → string ∪ none {
    if admitted.identity.digest ≢ sha {
        return "model changed between admission and materialization: admitted=" + sha + " manifest=" + admitted.identity.digest
    }
    if observed ≢ admitted.artifact_length {
        return "model changed between admission and materialization: admitted length=" + (admitted.artifact_length ↦ string) + " observed length=" + (observed ↦ string)
    }
    return null
}

fn refuse_load_identity(string sha, gguf_manifest.GgufManifest admitted, string path) → void ⇥ gguf.GgufError {
    mut int observed ← 0
    do {
        observed ← live_file_size(path)
    }
    catch err {
        throw variant BadCapsule { message = "§"(err) }
    }
    let string ∪ none refusal ← check_load_identity(sha, admitted, observed)
    if refusal not is none {
        throw variant BadCapsule { message = refusal coalesce "" }
    }
}

# Materialization re-verify (G1-U9): the file is re-digested at load time,
# after admission and before any weight is read, and must equal the admitted
# sha (and --expected-digest when set), so a swap between admit and load -
# including a same-size content swap - cannot serve swapped weights.
fn verify_load_digest(string path, string sha, string expected_digest) → void ⇥ gguf.GgufError {
    mut string materialized ← ""
    do {
        materialized ← host_digestio(path)
    }
    catch err {
        throw variant BadCapsule { message = "§"(err) }
    }
    let string ∪ none refusal ← check_materialized_digest(sha, materialized, expected_digest)
    if refusal not is none {
        throw variant BadCapsule { message = refusal coalesce "" }
    }
}

# The port path's digest-bound entry: the manifest is the one inspected from
# the admitted header prefix (passed in, never re-parsed). Length guard, then
# the load-time digest re-verify, then the weights, then the length guard
# again.
fn load_port_model(string path, string sha, string expected_digest, gguf_manifest.GgufManifest admitted) → port.PortWeights ⇥ gguf.GgufError {
    refuse_load_identity(sha, admitted, path)
    verify_load_digest(path, sha, expected_digest)
    let port.PortWeights loaded ← load_port_weights_as_capsula(path, admitted)
    refuse_load_identity(sha, admitted, path)
    return loaded
}

# load_port_weights with its manifest-side refusals mapped into BadCapsule.
fn load_port_weights_as_capsula(string path, gguf_manifest.GgufManifest admitted) → port.PortWeights ⇥ gguf.GgufError {
    do {
        return load_port_weights(path, admitted)
    }
    catch err {
        throw variant BadCapsule { message = err.message }
    }
}

# The port path's request validation (the same gradus reject rows and prompt
# fit causes as generate_dense_with_stop) followed by the decode
# loop (greedy at temperature 0, seeded sampling otherwise, with the request's
# sampling Config and Seed). A fresh pair of K/V caches is allocated per call inside
# port_generate_sampled; the weights are the resident ones.
fn check_generate_port(GenerateConfig cfg, list<int> ids, ResidentModel model) → void ⇥ config.GenerationError {
    let config.GenerationConfig g ← to_generation_config(cfg, model.eog_ids)
    require ids.length() ≥ 1 throw variant config.GenerationError.InvalidConfig { message = "needs at least one prompt token" }
    require ids.length() ≤ g.max_prompt throw variant config.GenerationError.InvalidConfig { message = "prompt length exceeds max_prompt" }
    require ids.length() ≺ g.context throw variant config.GenerationError.InvalidConfig { message = "prompt length does not fit context" }
}

# The sink of a run that streams nothing: every id is wanted.
fn discard_token(int id) → bool {
    return true
}

# `on_token` receives each chosen id between decode steps (see port_generate_sampled).
fn run_generate_port(GenerateConfig cfg, list<int> ids, ResidentModel model, port.PortWeights weights, decoder.StopPolicy stop, bool trace, (int) → bool on_token) → pgen.PortResult ⇥ config.GenerationError {
    check_generate_port(cfg, ids, model)
    let config.GenerationConfig g ← to_generation_config(cfg, model.eog_ids)
    let sampling.Config sconf ← config.config(g)
    let train.Seed seed ← config.seed(g)
    do {
        return pgen.port_generate_sampled(weights, ids, cfg.maxima_verborum, model.eog_ids, decoder.stops_on_eog(stop), cfg.contextus, trace, sconf, seed, on_token)
    }
    catch err {
        throw variant config.GenerationError.InvalidConfig { message = err.message }
    }
    throw variant config.GenerationError.InvalidConfig { message = "unreachable" }
}

# The admitted manifest, the tokenizer built once from it, and its EOG set.
fn port_resident(gguf_manifest.GgufManifest admitted, tokenizator.Tokenizer tok) → ResidentModel {
    return ResidentModel {
        manifest = admitted,
        tokenizer = tok,
        eog_ids = tokenizator.artifact_eog(tok)
    }
}

fn print_port_result(tokenizator.Tokenizer tok, pgen.PortResult res) → void {
    stdout_write("ids=" + live_ids_flat(res.ids) + "\n")
    stdout_write("text=" + live_decode(tok, res.ids) + "\n")
    stdout_write("finish=" + res.finish + "\n")
}

# The one-shot: digest-bound bulk weight load, then the port decode loop. `--trace` prints one stderr trace line per generated step.
fn live_run_port(ServeConfig serve_config, string sha, gguf_manifest.GgufManifest admitted, tokenizator.Tokenizer tok, list<int> prompt_ids) → void {
    let ResidentModel model ← port_resident(admitted, tok)
    let GenerateConfig cfg ← GenerateConfig {
        contextus = model_context_limit(),
        magna_promptus = effective_max_prompt(serve_config),
        maxima_verborum = serve_config.max_tokens,
        semen = serve_config.seed,
        temperatura = 0.0,
        top_k = 0,
        top_p = 1.0,
        min_p = 0.0,
        poena_repetitionis = 1.0
    }
    let decoder.StopPolicy stop ← live_stop_policy(serve_config.ignore_eos)
    stderr_write("port: load-start\n")
    let port.PortWeights weights ← live_load_port(serve_config, sha, admitted)
    stderr_write("port: load-done\n")
    let pgen.PortResult res ← live_port_generate(cfg, prompt_ids, model, weights, stop, serve_config.trace)
    print_port_result(tok, res)
}

fn live_load_port(ServeConfig serve_config, string sha, gguf_manifest.GgufManifest admitted) → port.PortWeights {
    do {
        return load_port_model(serve_config.model, sha, serve_config.expected_digest, admitted)
    }
    catch err {
        panic "port load failed: " + err.message
    }
}

fn live_port_generate(GenerateConfig cfg, list<int> ids, ResidentModel model, port.PortWeights weights, decoder.StopPolicy stop, bool trace) → pgen.PortResult {
    do {
        return run_generate_port(cfg, ids, model, weights, stop, trace, discard_token)
    }
    catch err {
        panic "port generate failed: " + err.message
    }
}

fn live_run(ServeConfig serve_config) → void {
    stdout_write("inferentia live: admit + G3 tokenizer + port decode\n")
    stdout_write("model.path=" + serve_config.model + "\n")

    mut string sha ← ""
    mut gguf_manifest.GgufManifest admitted ← empty_manifest()
    do {
        let AdmittedModel am ← admit_model(serve_config.model)
        sha ← am.sha
        admitted ← am.manifest
    }
    catch err {
        panic "admit failed: " + err.message
    }
    stdout_write("admit.sha256=" + sha + "\n")
    if sha ≢ pinned_digest() {
        panic "admit digest mismatch: observed=" + sha + " expected=" + pinned_digest()
    }

    mut int total ← 0
    do {
        total ← live_file_size(serve_config.model)
    }
    catch err {
        panic "model length read failed: §"(err)
    }
    stdout_write("model.bytes=" + (total ↦ string) + "\n")

    stdout_write("manifest.data_offset=" + (admitted.data_start ↦ string) + "\n")

    let tokenizator.Tokenizer tok ← live_build_tokenizer(admitted)
    stdout_write("tokenizer.vocab=" + (tok.multitudo ↦ string) + "\n")

    let string prompt_text ← effective_prompt(serve_config)
    let list<int> prompt_ids ← live_tokenize(tok, prompt_text)
    stdout_write("prompt.ids=" + live_ids_text(prompt_ids) + "\n")
    if prompt_text ≡ frozen_prompt_text() {
        stdout_write("prompt.golden=" + live_ids_text(frozen_prompt_ids()) + "\n")
        if live_first_divergence(prompt_ids, frozen_prompt_ids()) ≢ "none" {
            panic "G3 tokenize diverged from pinned P10: " + live_first_divergence(prompt_ids, frozen_prompt_ids())
        }
    }

    stdout_write("backend=" + serve_config.backend + "\n")
    live_run_port(serve_config, sha, admitted, tok, prompt_ids)
}

# ---------------------------------------------------------------------------
# Usage errors (D5): detected before any listen, non-zero exit.
# ---------------------------------------------------------------------------
fn usage_error(string message) → never {
    stderr_write("error: " + message)
    panic "usage error"
}

# ---------------------------------------------------------------------------
# CLI parsing (D1)
# ---------------------------------------------------------------------------

# Parse a base-10 integer; -1 when the text is not a valid integer.
# (-1 is never a legal value for any D1 numeric option.)
fn parse_int(string raw) → int {
    return raw ↦ int ⊥ -1
}

# The D1 `serve` syntax, printed on `--help`.
fn print_help() → void {
    stdout_write("Usage: inferentia <serve|live> [OPTIONS]\n")
    stdout_write("\n")
    stdout_write("Local-first GGUF inference server written in Faber\n")
    stdout_write("\n")
    stdout_write("Commands:\n")
    stdout_write("  serve                     Bind the HTTP server (U1–U4)\n")
    stdout_write("  live                      One-shot prompt in, decoded ids + text out\n")
    stdout_write("\n")
    stdout_write("Options:\n")
    stdout_write("  -m, --model <PATH>        Path to the GGUF model file (required)\n")
    stdout_write("      --prompt <TEXT>       Live one-shot prompt text (default: frozen fixture)\n")
    stdout_write("      --expected-digest <SHA256>  Serve: require the admitted sha256 to match (default: unset)\n")
    stdout_write("      --ignore-eos          Live: generate past EOG until --max-tokens\n")
    stdout_write("      --backend <metal>     Generation path (default and only value: metal = the gradus\n")
    stdout_write("                            decode-token launches; the device is chosen by how the program\n")
    stdout_write("                            is run: `faber run --device metal|cpu|reference`)\n")
    stdout_write("      --trace               Live: one stderr trace line per generated step\n")
    stdout_write("      --host <HOST>         Bind host (loopback only; default: 127.0.0.1)\n")
    stdout_write("      --port <PORT>         Bind port (default: 8080; 0 = ephemeral)\n")
    stdout_write("      --max-tokens <N>      Default output token ceiling (default: 32)\n")
    stdout_write("      --max-prompt <N>      Prompt-token admission bound (default: model limit)\n")
    stdout_write("      --context <N>         Session context ceiling (default: model limit)\n")
    stdout_write("      --seed <N>            Deterministic seed (default: 1)\n")
    stdout_write("      --log-level <LEVEL>   stderr verbosity: info|warn|error (default: info)\n")
    stdout_write("  -h, --help                Print help\n")
    stdout_write("      --version             Print version\n")
}

# Parse argv (the program arguments only: the program name is not an
# argument) into a ServeConfig. Every usage error exits before returning.
fn parse_cli(list<string> argv) → ServeConfig {
    mut ServeConfig config ← ServeConfig { model = "", host = "127.0.0.1", port = 8080, max_tokens = 32, max_prompt = 0, context = 0, seed = 1, log_level = "info", prompt = "", expected_digest = "", ignore_eos = false, trace = false, backend = "metal" }
    mut string subcommand ← ""
    mut int i ← 0

    while i ≺ argv.length() {
        let string arg ← argv.get(i) coalesce ""
        if arg ≡ "--help" or arg ≡ "-h" {
            print_help()
            panic "help requested"
        }
        elif arg ≡ "--version" {
            stdout_write("inferentia 0.1.0\n")
            panic "version requested"
        }
        elif arg ≡ "--model" or arg ≡ "-m" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --model")
            config.model ← argv.get(i) coalesce ""
        }
        elif arg ≡ "--host" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --host")
            config.host ← argv.get(i) coalesce ""
        }
        elif arg ≡ "--port" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --port")
            let string raw ← argv.get(i) coalesce ""
            let int port ← parse_int(raw)
            if port ≺ 0 or port ≻ 65535 then usage_error("invalid port '" + raw + "' (expected 0..=65535)")
            config.port ← port
        }
        elif arg ≡ "--max-tokens" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --max-tokens")
            let string raw ← argv.get(i) coalesce ""
            let int value ← parse_int(raw)
            if value ≺ 1 then usage_error("invalid max-tokens '" + raw + "' (expected >= 1)")
            config.max_tokens ← value
        }
        elif arg ≡ "--max-prompt" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --max-prompt")
            let string raw ← argv.get(i) coalesce ""
            let int value ← parse_int(raw)
            if value ≺ 1 then usage_error("invalid max-prompt '" + raw + "' (expected >= 1)")
            config.max_prompt ← value
        }
        elif arg ≡ "--context" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --context")
            let string raw ← argv.get(i) coalesce ""
            let int value ← parse_int(raw)
            if value ≺ 1 then usage_error("invalid context '" + raw + "' (expected >= 1)")
            config.context ← value
        }
        elif arg ≡ "--seed" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --seed")
            let string raw ← argv.get(i) coalesce ""
            let int value ← parse_int(raw)
            if value ≺ 1 then usage_error("invalid seed '" + raw + "' (expected >= 1)")
            config.seed ← value
        }
        elif arg ≡ "--log-level" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --log-level")
            let string raw ← argv.get(i) coalesce ""
            if (raw ≡ "info") or (raw ≡ "warn") or (raw ≡ "error") {
                config.log_level ← raw
            } else {
                usage_error("invalid log-level '" + raw + "' (expected info|warn|error)")
            }
        }
        elif arg ≡ "--expected-digest" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --expected-digest")
            config.expected_digest ← argv.get(i) coalesce ""
        }
        elif arg ≡ "--prompt" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --prompt")
            let string raw ← argv.get(i) coalesce ""
            if raw ≡ "" then usage_error("invalid prompt '' (expected non-empty text)")
            config.prompt ← raw
        }
        elif arg ≡ "--ignore-eos" {
            config.ignore_eos ← true
        }
        elif arg ≡ "--trace" {
            config.trace ← true
        }
        elif arg ≡ "--backend" {
            i ← i + 1
            if i ≥ argv.length() then usage_error("missing value for --backend")
            let string raw ← argv.get(i) coalesce ""
            if raw ≡ "metal" {
                config.backend ← raw
            } else {
                usage_error("invalid backend '" + raw + "' (expected metal; CPU inference is `faber run --device cpu` or `--device reference` on the same kernels)")
            }
        }
        elif arg.starts_with("-") and arg.length() ≻ 1 {
            usage_error("unknown option '" + arg + "'")
        }
        else {
            if subcommand ≡ "" {
                subcommand ← arg
            } else {
                usage_error("unexpected operand '" + arg + "'")
            }
        }
        i ← i + 1
    }

    if subcommand ≡ "" then usage_error("missing subcommand 'serve' or 'live'")
    if subcommand ≡ "serve" or subcommand ≡ "live" {
        # serve: HTTP (U1–U4). live: one-shot generate_dense (I-live).
    } else {
        usage_error("unknown subcommand '" + subcommand + "'")
    }
    if config.model ≡ "" then usage_error("missing required option --model")

    return config
}

# ---------------------------------------------------------------------------
# Server loop + health lifecycle (U1 listener, U2 admission + states)
# ---------------------------------------------------------------------------

# The /health body per D3. The model identity on ready carries the verified
# whole-file SHA-256 (the only identity fact the BD-2 admit route returns) and
# the configured path; on failed it carries the typed cause. Every string
# value is JSON-escaped so a configured path or a typed error can never
# produce invalid JSON.
# Note: the D3 `pid` field is not served — the toolchain has no process-
# identity call form (empty-opener routes fail codegen; recorded gap).
fn health_body(ServerState st) → string {
    if st.state ≡ "starting" {
        return "{\"state\":\"starting\",\"model\":null}"
    }
    if st.state ≡ "failed" {
        return "{\"state\":\"failed\",\"model\":{\"error\":\"" + json_escape(st.error_text) + "\"}}"
    }
    return "{\"state\":\"ready\",\"model\":{\"sha256\":\"" + json_escape(st.sha256) + "\",\"path\":\"" + json_escape(st.model_path) + "\"}}"
}

# ---------------------------------------------------------------------------
# U3 — /model endpoint
#
# The pinned-row identity facts (i1-discovery §2.1 identity table; D3 schema).
# `sha256` is the one runtime fact — from the BD-2 admit route, held in
# ServerState. Every other field is a documented constant for the pinned
# SmolLM2-360M-Instruct-F32 row; `max_output_tokens` is the server default
# (D2 precedence — the configured `--max-tokens` value, not a per-request
# value). Field order is the D3 order: name, architecture, quantization,
# file_size_bytes, sha256, context_length, vocab_size, max_output_tokens,
# backend.
# ---------------------------------------------------------------------------
fn model_identity_name() → string {
    return "SmolLM2-360M-Instruct-F32"
}

fn model_architecture() → string {
    return "llama"
}

fn model_quantization() → string {
    return "f32"
}

fn model_file_size_bytes() → int {
    return 1449071040
}

fn model_vocab_size() → int {
    return 49152
}

# The selected generation backend, as served in the /model body. `--backend`
# accepts "metal" only (parse_cli), the gradus decode-token launches; the
# device they run on is chosen by `faber run --device`.
fn model_backend(string selected) → string {
    return selected
}

# The /model response body (D3 exact schema). `sha256` is JSON-escaped for
# consistency with the other identity bodies (hex, so normally a no-op).
fn model_body(ServerState st, int max_output_tokens, string backend) → string {
    return "{\"name\":\"" + model_identity_name() + "\",\"architecture\":\"" + model_architecture() + "\",\"quantization\":\"" + model_quantization() + "\",\"file_size_bytes\":" + (model_file_size_bytes() ↦ string) + ",\"sha256\":\"" + json_escape(st.sha256) + "\",\"context_length\":" + (model_context_limit() ↦ string) + ",\"vocab_size\":" + (model_vocab_size() ↦ string) + ",\"max_output_tokens\":" + (max_output_tokens ↦ string) + ",\"backend\":\"" + model_backend(backend) + "\"}"
}

# D3: 503 before ready / on failure carries the minimal state body
# (`{"state":"starting"|"failed"}` — the typed cause is served by /health).
fn model_unready_body(ServerState st) → string {
    return "{\"state\":\"" + st.state + "\"}"
}

# Handle a /model request (U3). The pipeline: method gate → state gate →
# response assembly. GET is the only method (D3); any other method is a
# reject. Before ready the endpoint answers 503 with the state; on ready it
# answers 200 with the exact pinned identity body.
fn handle_model(server.Incoming incoming, ServerState st, ServeConfig config) → void {
    if incoming.req.method ≢ "GET" {
        reply_json(incoming, 400, error_body("method must be GET for /model"))
        return
    }
    if st.state ≢ "ready" {
        reply_json(incoming, 503, model_unready_body(st))
        return
    }
    reply_json(incoming, 200, model_body(st, config.max_tokens, config.backend))
}

# Pre-encode prompt-length gate (S-F4 / B5-U2): before this gate the only
# prompt bound was the token-level max_prompt, enforced at generation — after
# encode. The gate is a text-length bound in the runtime string-length unit;
# the HTTP body cap stays the outer bound and max_prompt keeps its
# post-encode generation meaning.
const int MAX_PROMPT_LENGTH = 65536

# Size gate for the /generate prompt: the refusal diagnostic when the prompt
# exceeds MAX_PROMPT_LENGTH, null when the prompt may flow to encode. Pure so
# the gate rows can feed it prompts as inputs.
fn check_prompt_length(string prompt) → string ∪ none {
    if prompt.length() ≻ MAX_PROMPT_LENGTH {
        return "prompt length " + (prompt.length() ↦ string) + " exceeds the bound " + (MAX_PROMPT_LENGTH ↦ string)
    }
    return null
}

# Exact-length ASCII prompt for the gate rows; doubling keeps the build short
# and slice trims to the requested length.
fn prompt_of_length(int n) → string {
    mut string p ← "a"
    while p.length() ≺ n {
        p ← p + p
    }
    return (p.slice(0, n) ⊥ "")
}

# Handle a /generate request (U4). The pipeline: method gate → state gate →
# cancellation checkpoint → body read → minimal JSON parse → prompt-length
# gate → cancellation checkpoint → encode → engine generate (prefill + greedy
# decode with the admitted tokenizer EOG stop set and the max_tokens budget)
# → response assembly. Domain validation (the gradus reject rows) is enforced
# by the engine with typed causes; this unit maps them to 400/500.
fn handle_generate(server.Incoming incoming, value raw, ServerState st, ServeConfig config, ResidentModel model, list<port.PortWeights> ports) → void {
    # Method gate: /generate is POST (D3).
    if incoming.req.method ≢ "POST" {
        reply_json(incoming, 400, error_body("method must be POST for /generate"))
        return
    }
    # State gate: 503 before ready (D3).
    if st.state ≢ "ready" {
        reply_json(incoming, 503, state_body(st))
        return
    }
    # Cancellation checkpoint (D6 seam; no signal source is wired yet — the
    # native host has no processus signal route, a recorded U6 gap).
    if st.cancelled {
        reply_json(incoming, 503, error_body("generation cancelled (shutdown)"))
        return
    }
    # Body from the raw accept value (Incoming.req.body keeps text only in
    # server.body_text); `request_body_text` also reads a `list<b8>` body.
    let string body ← request_body_from_raw(raw)
    if body ≡ body_read_gap_marker() {
        reply_json(incoming, 500, error_body("request body unavailable: bytes→text decode failed"))
        return
    }
    # Minimal product JSON parse (D3).
    let GenerateRequest parsed ← json_parse_generate_body(body)
    if not parsed.ok {
        reply_json(incoming, 400, error_body(parsed.error))
        return
    }
    # Pre-encode prompt-length gate (S-F4): reject over-bound prompts before
    # the encode call; in-bound requests take the same path as before.
    let string ∪ none too_long ← check_prompt_length(parsed.prompt)
    if too_long not is none {
        reply_json(incoming, 400, error_body(too_long coalesce ""))
        return
    }
    if st.cancelled {
        reply_json(incoming, 503, error_body("generation cancelled (shutdown)"))
        return
    }
    # Encode: text → token ids through the admitted model's real G3
    # tokenizer (the tables loaded with the resident weights).
    let EncodeResult enc ← encode_prompt(model.tokenizer, parsed.prompt)
    if not enc.ok {
        reply_json(incoming, 400, error_body(enc.error))
        return
    }
    let GenerateConfig cfg ← build_generate_config(parsed, config)
    if wants_sse(incoming) {
        stream_generate(incoming, st, cfg, enc.ids, model, ports[0])
        return
    }
    do {
        let pgen.PortResult run ← run_generate_port(cfg, enc.ids, model, ports[0], decoder.eog_stop(), false, discard_token)
        let list<int> tokens ← run.ids
        # Cancellation checkpoint after decode (D6 seam).
        if st.cancelled {
            reply_json(incoming, 503, error_body("generation cancelled (shutdown)"))
        } else {
            # Detokenize before any body assembly: a typed decode failure fails
            # closed instead of emitting a partial body.
            let DecodeResult dec ← tokens_text(model.tokenizer, tokens)
            if not dec.ok {
                reply_json(incoming, classify_generate_error(dec.error), error_body(dec.error))
            } else {
                reply_json(incoming, 200, generate_response_body(st, dec.text, tokens, enc.ids, cfg.maxima_verborum))
            }
        }
    }
    catch err {
        let string cause ← err.message
        let int code ← classify_generate_error(cause)
        reply_json(incoming, code, error_body(cause))
    }
}

# Respond to one request carrier. /health is always 200 once the listener is
# up; /generate is the U4 endpoint; any other path is 404 (D3).
fn handle_request(value request, ServerState st, ServeConfig config, ResidentModel model, list<port.PortWeights> ports) → void {
    if request is map<string, value> {
        let server.Incoming incoming ← server.incoming_of(request)
        let string path ← incoming.req.path
        if path ≡ "/health" {
            reply_json(incoming, 200, health_body(st))
        } elif path ≡ "/model" {
            handle_model(incoming, st, config)
        } elif path ≡ "/generate" {
            handle_generate(incoming, request, st, config, model, ports)
        } else {
            reply_json(incoming, 404, "not found")
        }
    }
}

# Does this accept fault end the loop? A stopped listener is Closed and a
# cancelled accept is Cancelled; every other fault is request-level.
fn accept_fault_ends(fault.IoFault f) → bool {
    match f {
        case fault.IoFault.Closed let path {
            return true
        }
        case fault.IoFault.Cancelled let path {
            return true
        }
        default {
            return false
        }
    }
}

# Accept-loop step: keep serving unless the listener was stopped or the
# accept was cancelled; log other request-level rejects (oversize body,
# malformed request) and continue. A stopped listener ends the loop (D6).
fn accept_loop_step(bool serving, fault.IoFault err) → bool {
    if accept_fault_ends(err) {
        return false
    }
    stderr_write("inferentia: request dropped at accept: §\n"(err))
    return serving
}

# Bind the listener. A bind fault is a trap, as an unbindable port was before
# faults had a channel: the process cannot serve.
fn bind_listener(int port_number) → server.Listener {
    do {
        return server.bind(port_number)
    }
    catch err {
        panic "listener bind failed: §"(err)
    }
}

# Serve's single resident port load: the weights wrapped in a one-element list
# (the unready state passes an empty list, so no placeholder weights exist).
fn port_serve_load(ServeConfig config, string sha, gguf_manifest.GgufManifest admitted) → list<port.PortWeights> ⇥ gguf.GgufError {
    let port.PortWeights weights ← load_port_model(config.model, sha, config.expected_digest, admitted)
    return [weights]
}

fn serve(ServeConfig config) → void {
    # U2 admission ordering: bind first, then admit BEFORE any allocation.
    # admit computes the whole-file digest and pins the pinned-row structure
    # (BD-2 gate); serve then binds that digest to the pinned row (S-F1) and
    # to any operator --expected-digest, and load_resident_model re-verifies
    # at materialization (admit → load TOCTOU). Weight materialization is out
    # of this path: never forward/generate.
    let server.Listener listener ← bind_listener(config.port)
    stderr_write("inferentia: listening on 127.0.0.1:" + (config.port ↦ string) + "\n")

    mut ServerState state ← new_state(config.model)
    mut gguf_manifest.GgufManifest served_manifest ← empty_manifest()
    do {
        let AdmittedModel am ← admit_model(state.model_path)
        let string sha ← am.sha
        served_manifest ← am.manifest
        let string ∪ none pin_refusal ← check_pinned_digest(sha)
        if pin_refusal not is none {
            throw variant BadCapsule { message = pin_refusal coalesce "" }
        }
        let string ∪ none digest_refusal ← check_expected_digest(sha, config.expected_digest)
        if digest_refusal not is none {
            throw variant BadCapsule { message = digest_refusal coalesce "" }
        }
        state ← admitted(state, sha)
        stderr_write("inferentia: model admitted (sha256 " + sha + ")\n")
    }
    catch err {
        let string cause ← err.message
        state ← failed(state, cause)
        stderr_write("inferentia: admission failed: " + cause + "\n")
    }

    # U4 generation readiness: load the port weights exactly once and keep
    # them resident; every /generate reuses them with a fresh K/V cache pair.
    # A failed load is an admission/load failure (D5 → exit 2): the load
    # re-verifies the digest at materialization (admit → load TOCTOU), so a
    # file swapped between admit and load throws into the failed state here.
    mut ResidentModel resident ← empty_resident()
    mut list<port.PortWeights> ports ← []
    if state.state ≡ "ready" {
        # The bulk port weights load ONCE here (digest-bound: admit digest,
        # re-digested at load, length guarded); every /generate reuses them.
        do {
            ports ← port_serve_load(config, state.sha256, served_manifest)
            resident ← port_resident(served_manifest, live_build_tokenizer(served_manifest))
            stderr_write("inferentia: model loaded once (resident) - generation ready\n")
        }
        catch err {
            state ← failed(state, "model load failed: " + err.message)
            stderr_write("inferentia: model load failed: " + err.message + "\n")
        }
    }

    mut bool serving ← true
    while serving {
        do {
            let value request ← server.accept(listener.handle)
            handle_request(request, state, config, resident, ports)
        }
        catch err {
            # A request-level reject (oversize body, malformed request) must
            # not end the serve loop; only a stopped/cancelled listener does.
            # The decision lives in a helper: the MIR stepper (`faber test`)
            # cannot lower a conditional inside a `cape` block that wraps a
            # local call into a host route (recorded toolchain limitation).
            serving ← accept_loop_step(serving, err)
        }
    }

    # Loop-end shutdown path (reachable when the listener stops / accept is
    # cancelled). The D5 exit-code decision maps failed admission to exit 2
    # and successful admission / clean shutdown to exit 0; the code is
    # DELIVERED to the process via the processus:exi primitive (exit_with).
    # The loop-end trigger (SIGTERM → http:stop) is the recorded U6 signal
    # gap: with no signal route wired, SIGTERM kills the process by signal
    # (observed exit 143) and this loop-end path is not reached. The
    # executable exit-code proof for the harness paths runs under
    # tests/admission-gate/ and tests/process-exit/.
    stderr_write("inferentia: shutting down (exit code " + (exit_code_for(state.state) ↦ string) + ")\n")
    exit_with(exit_code_for(state.state))
}

# ---------------------------------------------------------------------------
# Entry
# ---------------------------------------------------------------------------
main args argv {
    let ServeConfig config ← parse_cli(argv)
    if live_requested(argv) {
        live_run(config)
    } else {
        serve(config)
    }
}

# ---------------------------------------------------------------------------
# Tests (pure parse + lifecycle logic; process-exit statuses are proven by the
# product binary under tests/process-exit/ — blocked on the scoped native-host
# processus:exi runtime fix — and by the admission-gate harness under
# tests/admission-gate/; the provider-touching admission path is executed by
# the admission-gate harness and proven by the in-tree BD-2 probe)
# ---------------------------------------------------------------------------
describe "serve cli parse" tag "inferentia" {
    test "documented constants apply when no server flags are given" {
        let ServeConfig cfg ← parse_cli(["serve", "--model", "/tmp/model.gguf"])
        assert cfg.host ≡ "127.0.0.1"
        assert cfg.port ≡ 8080
        assert cfg.max_tokens ≡ 32
        assert cfg.max_prompt ≡ 0
        assert cfg.seed ≡ 1
        assert cfg.log_level ≡ "info"
        assert cfg.model ≡ "/tmp/model.gguf"
    }
    test "server flags override documented constants" {
        let ServeConfig cfg ← parse_cli(["serve", "--model", "/tmp/model.gguf", "--port", "9090", "--max-tokens", "16", "--max-prompt", "2048", "--seed", "7", "--host", "127.0.0.1", "--log-level", "warn"])
        assert cfg.port ≡ 9090
        assert cfg.max_tokens ≡ 16
        assert cfg.max_prompt ≡ 2048
        assert cfg.seed ≡ 7
        assert cfg.host ≡ "127.0.0.1"
        assert cfg.log_level ≡ "warn"
    }
    test "port zero is ephemeral" {
        let ServeConfig cfg ← parse_cli(["serve", "--model", "/tmp/model.gguf", "--port", "0"])
        assert cfg.port ≡ 0
    }
    test "short model flag binds the same option" {
        let ServeConfig cfg ← parse_cli(["serve", "-m", "/tmp/model.gguf"])
        assert cfg.model ≡ "/tmp/model.gguf"
    }
    test "live subcommand accepts the model path" {
        let ServeConfig cfg ← parse_cli(["live", "--model", "/tmp/model.gguf"])
        assert cfg.model ≡ "/tmp/model.gguf"
        assert live_requested(["live", "--model", "/tmp/model.gguf"])
        assert not live_requested(["serve", "--model", "/tmp/model.gguf"])
    }
    test "context is unset until a flag provides it" {
        let ServeConfig cfg ← parse_cli(["serve", "--model", "/tmp/model.gguf"])
        assert cfg.context ≡ 0
        let ServeConfig cfg2 ← parse_cli(["serve", "--model", "/tmp/model.gguf", "--context", "4096"])
        assert cfg2.context ≡ 4096
    }
    test "max prompt is unset until a flag provides it" {
        let ServeConfig cfg ← parse_cli(["serve", "--model", "/tmp/model.gguf"])
        assert cfg.max_prompt ≡ 0
        let ServeConfig cfg2 ← parse_cli(["serve", "--model", "/tmp/model.gguf", "--max-prompt", "2048"])
        assert cfg2.max_prompt ≡ 2048
    }
    test "live prompt flag binds text; ignore-eos defaults off" {
        let ServeConfig cfg ← parse_cli(["live", "--model", "/tmp/model.gguf", "--prompt", "hello world"])
        assert cfg.prompt ≡ "hello world"
        assert not cfg.ignore_eos
        assert effective_prompt(cfg) ≡ "hello world"
    }
    test "live defaults select the frozen fixture prompt" {
        let ServeConfig cfg ← parse_cli(["live", "--model", "/tmp/model.gguf"])
        assert cfg.prompt ≡ ""
        assert not cfg.ignore_eos
        assert effective_prompt(cfg) ≡ frozen_prompt_text()
    }
    test "ignore-eos flag parses on" {
        let ServeConfig cfg ← parse_cli(["live", "--model", "/tmp/model.gguf", "--ignore-eos"])
        assert cfg.ignore_eos
        assert effective_prompt(cfg) ≡ frozen_prompt_text()
    }
}
describe "backend selection cli parse" tag "inferentia" {
    test "the backend defaults to metal and trace is off" {
        let ServeConfig cfg ← parse_cli(["live", "--model", "/tmp/model.gguf"])
        assert cfg.backend ≡ "metal"
        assert not cfg.trace
    }
    test "--backend metal selects the port path" {
        let ServeConfig cfg ← parse_cli(["serve", "--model", "/tmp/model.gguf", "--backend", "metal"])
        assert cfg.backend ≡ "metal"
        assert model_backend(cfg.backend) ≡ "metal"
    }
    test "--trace switches the trace on" {
        let ServeConfig cfg ← parse_cli(["live", "--model", "/tmp/model.gguf", "--backend", "metal", "--trace"])
        assert cfg.backend ≡ "metal"
        assert cfg.trace
    }
}
describe "health lifecycle" tag "inferentia" {
    test "state starts starting before admission" {
        let ServerState st ← new_state("/models/x.gguf")
        assert st.state ≡ "starting"
        assert st.sha256 ≡ ""
        assert st.error_text ≡ ""
    }
    test "admission success transitions to ready with model identity" {
        let ServerState st ← admitted(new_state("/models/x.gguf"), "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2")
        assert st.state ≡ "ready"
        assert st.sha256 ≡ "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2"
        assert st.error_text ≡ ""
        assert st.model_path ≡ "/models/x.gguf"
    }
    test "admission failure transitions to failed with typed error" {
        let ServerState st ← failed(new_state("/missing.gguf"), "io error: No such file")
        assert st.state ≡ "failed"
        assert st.error_text ≡ "io error: No such file"
    }
    test "health body starting" {
        let ServerState st ← new_state("/models/x.gguf")
        assert health_body(st) ≡ "{\"state\":\"starting\",\"model\":null}"
    }
    test "health body ready carries model identity" {
        let ServerState st ← admitted(new_state("/models/x.gguf"), "2fa3f013")
        assert health_body(st) ≡ "{\"state\":\"ready\",\"model\":{\"sha256\":\"2fa3f013\",\"path\":\"/models/x.gguf\"}}"
    }
    test "health body failed carries typed cause" {
        let ServerState st ← failed(new_state("/missing.gguf"), "io error: No such file")
        assert health_body(st) ≡ "{\"state\":\"failed\",\"model\":{\"error\":\"io error: No such file\"}}"
    }
    test "json escape leaves plain text unchanged" {
        assert json_escape("plain text") ≡ "plain text"
    }
    test "json escape escapes quotes and backslashes backslash-first" {
        # The order matters: backslashes first, then quotes — the reverse
        # order would double the inserted backslashes and leave the quote
        # unescaped. `a"b\c` carries both characters.
        assert json_escape("a\"b\\c") ≡ "a\\\"b\\\\c"
    }
    test "json escape escapes control characters" {
        assert json_escape("line1\nline2\tend") ≡ "line1\\nline2\\tend"
    }
    test "json escape maps the remaining C0 controls to escapes and \\u00XX" {
        # S-F5: \b, \f, \v and the rest of U+0000..U+001F were emitted raw, so
        # a one-byte vocab token produced invalid JSON. The fixtures are
        # byte-built: a source `\b` / `\f` is not the C0 character.
        assert json_escape(([8] ↦ list<b8>) ↦ string ⊥ "") ≡ "\\b"
        assert json_escape(([12] ↦ list<b8>) ↦ string ⊥ "") ≡ "\\f"
        assert json_escape(([1] ↦ list<b8>) ↦ string ⊥ "") ≡ "\\u0001"
        assert json_escape(([31] ↦ list<b8>) ↦ string ⊥ "") ≡ "\\u001f"
        assert json_escape("λ") ≡ "λ"
    }
    test "health body ready escapes quotes and backslashes in the path" {
        let ServerState st ← admitted(new_state("/models/a\"b\\c.gguf"), "2fa3f013")
        assert health_body(st) ≡ "{\"state\":\"ready\",\"model\":{\"sha256\":\"2fa3f013\",\"path\":\"/models/a\\\"b\\\\c.gguf\"}}"
    }
    test "health body ready escapes control characters in the path" {
        let ServerState st ← admitted(new_state("/models/x\nline.gguf"), "2fa3f013")
        assert health_body(st) ≡ "{\"state\":\"ready\",\"model\":{\"sha256\":\"2fa3f013\",\"path\":\"/models/x\\nline.gguf\"}}"
    }
    test "health body failed escapes quotes and backslashes in the error" {
        let ServerState st ← failed(new_state("/missing.gguf"), "io error: \"boom\" at \\tmp\\x")
        assert health_body(st) ≡ "{\"state\":\"failed\",\"model\":{\"error\":\"io error: \\\"boom\\\" at \\\\tmp\\\\x\"}}"
    }
    test "exit code decision maps failed to 2" {
        assert exit_code_for("failed") ≡ 2
        assert exit_code_for("ready") ≡ 0
        assert exit_code_for("starting") ≡ 0
    }
}
describe "generate request JSON parse" tag "inferentia" {
    test "frozen fixture request parses to the pinned fields" {
        let GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"The quick brown fox jumps over the lazy dog\",\"max_tokens\":16,\"temperature\":0.0,\"top_k\":0,\"top_p\":1.0,\"min_p\":0.0,\"repeat_penalty\":1.0,\"seed\":1}")
        assert req.ok
        assert req.prompt ≡ "The quick brown fox jumps over the lazy dog"
        assert req.has_prompt
        assert req.has_max_tokens
        assert req.max_tokens ≡ 16
        assert req.has_temperature
        assert req.temperature ≡ 0.0
        assert (req.has_top_k) and (req.top_k ≡ 0)
        assert (req.has_top_p) and (req.top_p ≡ 1.0)
        assert (req.has_min_p) and (req.min_p ≡ 0.0)
        assert (req.has_repeat_penalty) and (req.repeat_penalty ≡ 1.0)
        assert (req.has_seed) and (req.seed ≡ 1)
    }
    test "minimal request parses with optional fields absent" {
        let GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"The quick brown fox jumps over the lazy dog\"}")
        assert req.ok
        assert req.prompt ≡ "The quick brown fox jumps over the lazy dog"
        assert not req.has_max_tokens
        assert not req.has_max_prompt
        assert not req.has_temperature
        assert not req.has_seed
    }
    test "unknown field is an imperium_admissum reject row" {
        let GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"hi\",\"bogus\":1}")
        assert not req.ok
        assert req.error.contains("unknown field 'bogus'")
        assert req.error.contains("imperium_admissum")
    }
    test "empty prompt is rejected" {
        let GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"\"}")
        assert not req.ok
        assert req.error.contains("must not be empty")
    }
    test "missing prompt is rejected" {
        let GenerateRequest req ← json_parse_generate_body("{\"max_tokens\":4}")
        assert not req.ok
        assert req.error.contains("missing required field 'prompt'")
    }
    test "malformed JSON is rejected with a typed cause" {
        assert not (json_parse_generate_body("")).ok
        assert not (json_parse_generate_body("not json")).ok
        assert not (json_parse_generate_body("{\"prompt\":")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\"} trailing")).ok
        assert not (json_parse_generate_body("{\"prompt\" \"hi\"}")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",}")).ok
    }
    test "wrong field types are rejected" {
        assert not (json_parse_generate_body("{\"prompt\":42}")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",\"max_tokens\":16.5}")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",\"max_tokens\":\"x\"}")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",\"max_prompt\":\"x\"}")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",\"seed\":true}")).ok
    }
    test "duplicate fields are rejected" {
        let GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"a\",\"prompt\":\"b\"}")
        assert not req.ok
        assert req.error.contains("duplicate field")
    }
    test "max_prompt body field parses and rejects bad shapes" {
        let GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"hi\",\"max_prompt\":128}")
        assert req.ok
        assert (req.has_max_prompt) and (req.max_prompt ≡ 128)
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",\"max_prompt\":1.5}")).ok
        assert not (json_parse_generate_body("{\"prompt\":\"hi\",\"max_prompt\":4,\"max_prompt\":8}")).ok
    }
    test "whitespace and integer-form floats are tolerated" {
        let GenerateRequest req ← json_parse_generate_body("  { \"prompt\" : \"hi\" , \"max_tokens\" : 4 , \"temperature\" : 1 }  ")
        assert req.ok
        assert req.prompt ≡ "hi"
        assert req.max_tokens ≡ 4
        assert (req.has_temperature) and (req.temperature ≡ 1.0)
    }
    test "escapes decode in string values" {
        let GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"a\\nb\\tc\\\"d\"}")
        assert req.ok
        assert req.prompt ≡ "a\nb\tc\"d"
    }
    test "unsupported unicode escape is rejected with a typed cause" {
        let GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"a\\u0041\"}")
        assert not req.ok
        assert req.error.contains("\\uXXXX escapes are not supported")
    }
}
describe "generate config precedence" tag "inferentia" {
    test "body overrides server flag overrides default" {
        let ServeConfig server ← ServeConfig { model = "/m.gguf", host = "127.0.0.1", port = 8080, max_tokens = 32, max_prompt = 0, context = 0, seed = 1, log_level = "info", prompt = "", expected_digest = "", ignore_eos = false, trace = false, backend = "metal" }
        let GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"x\",\"max_tokens\":8,\"seed\":3}")
        let GenerateConfig cfg ← build_generate_config(req, server)
        assert cfg.contextus ≡ 8192
        assert cfg.maxima_verborum ≡ 8
        assert cfg.semen ≡ 3
        assert cfg.magna_promptus ≡ 8192
        assert cfg.temperatura ≡ 0.0
        assert cfg.top_k ≡ 0
        assert cfg.top_p ≡ 1.0
        assert cfg.min_p ≡ 0.0
        assert cfg.poena_repetitionis ≡ 1.0
    }
    test "absent body fields inherit the server flags" {
        let ServeConfig server ← ServeConfig { model = "/m.gguf", host = "127.0.0.1", port = 8080, max_tokens = 16, max_prompt = 1024, context = 4096, seed = 7, log_level = "info", prompt = "", expected_digest = "", ignore_eos = false, trace = false, backend = "metal" }
        let GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"x\"}")
        let GenerateConfig cfg ← build_generate_config(req, server)
        assert cfg.contextus ≡ 4096
        assert cfg.maxima_verborum ≡ 16
        assert cfg.magna_promptus ≡ 1024
        assert cfg.semen ≡ 7
        assert cfg.temperatura ≡ 0.0
        assert cfg.top_p ≡ 1.0
        assert cfg.poena_repetitionis ≡ 1.0
    }
    test "body max_prompt overrides the server flag" {
        let ServeConfig server ← ServeConfig { model = "/m.gguf", host = "127.0.0.1", port = 8080, max_tokens = 16, max_prompt = 1024, context = 4096, seed = 7, log_level = "info", prompt = "", expected_digest = "", ignore_eos = false, trace = false, backend = "metal" }
        let GenerateRequest req ← json_parse_generate_body("{\"prompt\":\"x\",\"max_prompt\":256}")
        let GenerateConfig cfg ← build_generate_config(req, server)
        assert cfg.magna_promptus ≡ 256
    }
}
# Test fixture tokenizer: a minimal byte-level BPE table (ids 0..2, one
# merge "a b" → "ab") built through the same public table constructor the
# artifact path uses.
fn table_tokenizer() → tokenizator.Tokenizer {
    do {
        return tokenizator.build_tables([0, 1, 2], ["a", "b", "ab"], ["a b"], [])
    }
    catch err {
        panic "test tokenizer tables failed: " + err.message
    }
}

describe "prompt encode" tag "inferentia" {
    test "table-built tokenizer encodes through G3 tokenize" {
        let EncodeResult enc ← encode_prompt(table_tokenizer(), "ab")
        assert enc.ok
        let int n ← enc.ids.length()
        assert n ≡ 1
        let int first ← enc.ids.get(0) coalesce 0
        assert first ≡ 2
    }
    test "empty-table tokenizer fails closed with the typed cause" {
        let EncodeResult enc ← encode_prompt(empty_tokenizer(), "some other text")
        assert not enc.ok
        assert enc.error.contains("prompt encode failed")
    }
}
describe "generate error classification" tag "inferentia" {
    test "gradus reject-row causes map to 400" {
        assert classify_generate_error("maximum generated tokens must fit within the context") ≡ 400
        assert classify_generate_error("malformed generation config wire") ≡ 400
        assert classify_generate_error("prompt length does not fit context") ≡ 400
        assert classify_generate_error("needs at least one prompt token") ≡ 400
        assert classify_generate_error("seed must be at least one") ≡ 400
        assert classify_generate_error("temperature must be non-negative") ≡ 400
    }
    test "engine-side failures map to 500" {
        assert classify_generate_error("prefill failed: op mismatch") ≡ 500
        assert classify_generate_error("decode failed: layout") ≡ 500
        assert classify_generate_error("pinned model unavailable") ≡ 500
        assert classify_generate_error("") ≡ 500
    }
}

describe "generate response" tag "inferentia" {
    test "finish reason is length at the budget and eos below it" {
        assert finish_reason(16, 16) ≡ "length"
        assert finish_reason(5, 16) ≡ "eos"
        assert finish_reason(0, 1) ≡ "eos"
    }
    test "tokens text decodes through the tokenizer" {
        let DecodeResult joined ← tokens_text(table_tokenizer(), [0, 1])
        assert joined.ok
        assert joined.text ≡ "ab"
        let DecodeResult empty ← tokens_text(table_tokenizer(), [])
        assert empty.ok
        assert empty.text ≡ ""
    }
    test "out-of-range token id fails closed with the typed cause" {
        let DecodeResult dec ← tokens_text(table_tokenizer(), [7])
        assert not dec.ok
        assert dec.error.contains("token id outside the vocabulary range")
    }
    test "tokens json machine surface" {
        let list<int> tokens ← [30, 198, 198]
        assert tokens_json(tokens) ≡ "[30,198,198]"
        let list<int> empty ← []
        assert tokens_json(empty) ≡ "[]"
    }
    test "generate response body shape" {
        let ServerState st ← admitted(new_state("/models/x.gguf"), "2fa3f013")
        let list<int> tokens ← [2, 0, 1]
        let list<int> prompt_ids ← [504, 2365]
        let string body ← generate_response_body(st, "abab", tokens, prompt_ids, 16)
        assert body.contains("\"model\"")
        assert body.contains("\"text\":\"abab\"")
        assert body.contains("\"tokens\":[2,0,1]")
        assert body.contains("\"finish_reason\":\"eos\"")
        assert body.contains("\"usage\":{\"prompt_tokens\":2,\"completion_tokens\":3,\"total_tokens\":5}")
    }
    test "generate response body escapes decoded text" {
        let ServerState st ← admitted(new_state("/models/x.gguf"), "2fa3f013")
        let string body ← generate_response_body(st, "a\"b", [0], [1], 1)
        assert body.contains("\"text\":\"a\\\"b\"")
    }
    test "error body escapes embedded quotes" {
        let string body ← error_body("malformed generation config wire")
        assert body ≡ "{\"error\":\"malformed generation config wire\"}"
    }
    test "fixture EOG stop set is pinned to {0,2}" {
        # This is a fixture oracle only. Production generation receives its
        # set from the admitted tokenizer metadata in ResidentModel.
        let list<int> eog ← [0, 2]
        let int n ← eog.length()
        assert n ≡ 2
        let int first ← eog.get(0) coalesce -1
        let int second ← eog.get(1) coalesce -1
        assert (first ≡ 0) and (second ≡ 2)
    }
}
describe "model endpoint" tag "inferentia" {
    test "pinned identity constants match the discovery facts" {
        assert model_identity_name() ≡ "SmolLM2-360M-Instruct-F32"
        assert model_architecture() ≡ "llama"
        assert model_quantization() ≡ "f32"
        assert model_file_size_bytes() ≡ 1449071040
        assert model_vocab_size() ≡ 49152
        assert model_backend("metal") ≡ "metal"
        assert model_context_limit() ≡ 8192
    }
    test "model body matches the committed expected body at the server default" {
        # Exact D3 wire format (field order, no whitespace) — the same literal
        # committed as tests/model-gate/expected-model-body.json, which the
        # live curl proof diffs against.
        let ServerState st ← admitted(new_state("/Users/ianzepp/ai/models/SmolLM2-360M-Instruct-f32.gguf"), "07735177a3542cbc0b0665051ce1922b55c4c9698de65131e65f2aea87a935e0")
        assert model_body(st, 32, "metal") ≡ "{\"name\":\"SmolLM2-360M-Instruct-F32\",\"architecture\":\"llama\",\"quantization\":\"f32\",\"file_size_bytes\":1449071040,\"sha256\":\"07735177a3542cbc0b0665051ce1922b55c4c9698de65131e65f2aea87a935e0\",\"context_length\":8192,\"vocab_size\":49152,\"max_output_tokens\":32,\"backend\":\"metal\"}"
    }
    test "model body reports the selected backend" {
        let ServerState st ← admitted(new_state("/m.gguf"), "2fa3f013")
        assert model_body(st, 32, "metal").contains("\"backend\":\"metal\"")
    }
    test "model body reflects the configured max_output_tokens" {
        let ServerState st ← admitted(new_state("/m.gguf"), "2fa3f013")
        assert model_body(st, 16, "metal").contains("\"max_output_tokens\":16")
        assert model_body(st, 1, "metal").contains("\"max_output_tokens\":1")
    }
    test "model unready body carries the state" {
        assert model_unready_body(new_state("/m.gguf")) ≡ "{\"state\":\"starting\"}"
        let ServerState st ← failed(new_state("/m.gguf"), "io error: No such file")
        assert model_unready_body(st) ≡ "{\"state\":\"failed\"}"
    }
    test "model body escapes the admitted sha256" {
        # json_escape is applied to the sha256 (a no-op for hex, but the body
        # stays valid JSON under any future identity source).
        let ServerState st ← admitted(new_state("/m.gguf"), "a\"b")
        assert model_body(st, 32, "metal").contains("\"sha256\":\"a\\\"b\"")
    }
}
describe "admission size ceiling" tag "inferentia" {
    test "pinned row size passes the ceiling gate" {
        # The gate is pure so the rows feed sizes as inputs: admission refuses
        # an over-ceiling path before any byte is read (admit_model only reaches
        # the read when the gate returns null), and the pinned size passes.
        assert check_admission_size(model_file_size_bytes()) is none
        assert model_size_ceiling() ≡ model_file_size_bytes()
    }
    test "one byte over the pinned size is refused with the size diagnostic" {
        let string ∪ none refusal ← check_admission_size(model_file_size_bytes() + 1)
        assert refusal not is none
        assert (refusal coalesce "").contains((model_file_size_bytes() + 1) ↦ string)
        assert (refusal coalesce "").contains(model_file_size_bytes() ↦ string)
    }
}
describe "generate prompt length gate" tag "inferentia" {
    test "in-bound prompt passes the gate" {
        assert check_prompt_length("hello") is none
    }
    test "prompt at the bound passes the gate" {
        assert check_prompt_length(prompt_of_length(MAX_PROMPT_LENGTH)) is none
    }
    test "prompt one over the bound is refused with the size diagnostic" {
        let int n ← MAX_PROMPT_LENGTH + 1
        let string ∪ none refusal ← check_prompt_length(prompt_of_length(n))
        assert refusal not is none
        assert (refusal coalesce "").contains(n ↦ string)
        assert (refusal coalesce "").contains(MAX_PROMPT_LENGTH ↦ string)
    }
}
describe "http module" tag "inferentia" {
    test "server genera import from norma:http/server" {
        let server.Listener listener ← server.Listener { handle = 1 }
        let server.Incoming incoming ← server.Incoming {
            id = "http-1",
            connection = 2,
            req = httpreq.Request { method = "GET", path = "/health", query = "", body = "" }
        }
        assert listener.handle ≡ 1
        assert incoming.id ≡ "http-1"
        assert incoming.connection ≡ 2
        assert not wants_sse(incoming)
    }
    test "string valor body extracts as text" {
        assert request_body_text("{\"prompt\":\"hi\"}" ↦ value) ≡ "{\"prompt\":\"hi\"}"
    }
    test "list<b8> value body extracts as UTF-8 text" {
        let list<b8> payload ← "{\"prompt\":\"hi\"}" ↦ list<b8>
        let value v ← payload ↦ value
        assert request_body_text(v) ≡ "{\"prompt\":\"hi\"}"
    }
    test "json headers carry content-type" {
        let headers.Headers head ← json_headers()
        let string ∪ none ct ← head.get("content-type")
        assert ct not is none
        assert (ct ↦ string) ≡ "application/json"
    }
    test "incoming_of splits stream query and wants sse" {
        mut map<string, value> raw ← {}
        raw.put("id", "http-1" ↦ value)
        raw.put("connection", 1 ↦ value)
        raw.put("method", "POST" ↦ value)
        raw.put("path", "/generate?stream=1" ↦ value)
        let list<value> hdrs ← []
        raw.put("headers", hdrs ↦ value)
        raw.put("body", "" ↦ value)
        let server.Incoming incoming ← server.incoming_of(raw ↦ value)
        assert incoming.req.path ≡ "/generate"
        assert wants_sse(incoming)
    }
    test "accept text/event-stream wants sse" {
        mut map<string, value> raw ← {}
        raw.put("id", "http-1" ↦ value)
        raw.put("connection", 1 ↦ value)
        raw.put("method", "POST" ↦ value)
        raw.put("path", "/generate" ↦ value)
        mut map<string, value> row ← {}
        row.put("name", "Accept" ↦ value)
        row.put("value", "text/event-stream" ↦ value)
        mut list<value> hdrs ← []
        hdrs.append(row ↦ value)
        raw.put("headers", hdrs ↦ value)
        raw.put("body", "" ↦ value)
        let server.Incoming incoming ← server.incoming_of(raw ↦ value)
        assert wants_sse(incoming)
    }
}
# Scratch-file helpers for the load-digest rows: Norma fs reports on the error
# channel, and a scratch file that cannot be written is a failed row.
fn scratch_write(string path, list<b8> data) → void {
    do {
        fsys.write_bytes(path, data)
    }
    catch err {
        panic "scratch write failed: §"(err)
    }
}

fn scratch_delete(string path) → void {
    do {
        fsys.delete(path)
    }
    catch err {
        panic "scratch delete failed: §"(err)
    }
}

fn scratch_length(string path) → int {
    do {
        return fsys.byte_length(path)
    }
    catch err {
        panic "scratch length failed: §"(err)
    }
}

describe "serve admission digest" tag "inferentia" {
    test "the pinned row digest passes the serve admission pin" {
        assert check_pinned_digest(pinned_digest()) is none
    }
    test "a digest that is not the pinned row is refused on serve" {
        # S-F1: serve binds admission to the pinned row like live_run, so a
        # structure-valid file with other weights never reaches `ready`.
        let string ∪ none refusal ← check_pinned_digest("0000f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2")
        assert refusal not is none
        assert (refusal coalesce "").contains("0000f013")
        assert (refusal coalesce "").contains(pinned_digest())
    }
    test "unset flag adds no operator pin of its own" {
        # Default unset (G1-U9 clause 1): the flag adds no constraint; the
        # pinned-row binding is the separate check_pinned_digest gate above.
        let ServeConfig cfg ← parse_cli(["serve", "--model", "/tmp/model.gguf"])
        assert cfg.expected_digest ≡ ""
        assert check_expected_digest("2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2", cfg.expected_digest) is none
        assert check_expected_digest("0000f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2", cfg.expected_digest) is none
    }
    test "set flag binds from the cli" {
        let ServeConfig cfg ← parse_cli(["serve", "--model", "/tmp/model.gguf", "--expected-digest", "2fa3f013"])
        assert cfg.expected_digest ≡ "2fa3f013"
    }
    test "matching digest passes the admission gate" {
        assert check_expected_digest("2fa3f013", "2fa3f013") is none
    }
    test "mismatching digest is refused with the pin diagnostic" {
        # Clause 2: the refusal is the thrown cause, which serve's catch maps
        # into the failed state — admission never reaches `ready`, so the
        # model is never served and there is no panic path.
        let string ∪ none refusal ← check_expected_digest("aaaa", "bbbb")
        assert refusal not is none
        assert (refusal coalesce "").contains("aaaa")
        assert (refusal coalesce "").contains("bbbb")
    }
    test "file swapped between admit and materialization is caught" {
        # Clause 3: the re-verify at load time compares against the admitted
        # sha, so swapped bytes throw before load_resident_weights reads.
        let string ∪ none refusal ← check_materialized_digest("admitted-sha", "swapped-sha", "")
        assert refusal not is none
        assert (refusal coalesce "").contains("admitted-sha")
        assert (refusal coalesce "").contains("swapped-sha")
    }
    test "materialized digest equal to admitted passes, with or without the flag" {
        assert check_materialized_digest("same-sha", "same-sha", "") is none
        assert check_materialized_digest("same-sha", "same-sha", "same-sha") is none
    }
    test "materialized digest mismatching the flag is caught" {
        let string ∪ none refusal ← check_materialized_digest("same-sha", "same-sha", "flag-sha")
        assert refusal not is none
        assert (refusal coalesce "").contains("flag-sha")
    }
    test "load length guard: matching digest and length pass" {
        let gguf_manifest.GgufManifest m ← identity_manifest("admitted-sha", 1449071040)
        assert check_load_identity("admitted-sha", m, 1449071040) is none
    }
    test "load length guard: a manifest inspected for another digest is refused" {
        let gguf_manifest.GgufManifest m ← identity_manifest("other-sha", 1449071040)
        let string ∪ none refusal ← check_load_identity("admitted-sha", m, 1449071040)
        assert refusal not is none
        assert (refusal coalesce "").contains("admitted-sha")
        assert (refusal coalesce "").contains("other-sha")
    }
    test "load length guard: a file whose length changed since admission is refused" {
        let gguf_manifest.GgufManifest m ← identity_manifest("admitted-sha", 1449071040)
        let string ∪ none shorter ← check_load_identity("admitted-sha", m, 1449071039)
        assert shorter not is none
        assert (shorter coalesce "").contains("1449071039")
        let string ∪ none longer ← check_load_identity("admitted-sha", m, 1449071041)
        assert longer not is none
    }
    test "load digest: a same-length content swap is refused at load" {
        # The length guard alone cannot see this; only the load-time digest does.
        let string path ← "/tmp/inferentia-load-digest-swap.bin"
        scratch_write(path, [1, 2, 3, 4] ↦ list<b8>)
        mut string admitted_sha ← ""
        do {
            admitted_sha ← host_digestio(path)
        }
        catch err {
            panic "digest failed: §"(err)
        }
        mut bool same_ok ← false
        do {
            verify_load_digest(path, admitted_sha, "")
            same_ok ← true
        }
        catch err {
            same_ok ← false
        }
        assert same_ok
        scratch_write(path, [1, 2, 3, 5] ↦ list<b8>)
        assert scratch_length(path) ≡ 4
        mut string cause ← ""
        do {
            verify_load_digest(path, admitted_sha, "")
        }
        catch err {
            cause ← err.message
        }
        scratch_delete(path)
        assert cause.contains("model changed between admission and materialization")
    }
    test "load digest: the operator pin binds the load-time digest" {
        let string path ← "/tmp/inferentia-load-digest-pin.bin"
        scratch_write(path, [9, 9, 9, 9] ↦ list<b8>)
        mut string sha ← ""
        do {
            sha ← host_digestio(path)
        }
        catch err {
            panic "digest failed: §"(err)
        }
        mut string cause ← ""
        do {
            verify_load_digest(path, sha, "flag-sha")
        }
        catch err {
            cause ← err.message
        }
        scratch_delete(path)
        assert cause.contains("flag-sha")
    }
}
