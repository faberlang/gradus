# =============================================================================
# Inferentia — local GGUF inference server (I1 U1 + U2 + U3 + U4)
# =============================================================================
#
# U1 scope: `serve` CLI parsing (D1), configuration precedence (D2), and host
# bootstrap — bind a loopback listener, answer `/health`, and exit on usage
# errors before any listener binds.
#
# U3 scope: the `/model` endpoint — the pinned-row identity facts (D3 schema)
# assembled from the BD-2 admit sha256 + documented constants, with 503 before
# ready.
#
# U2 scope: admission at startup + health lifecycle — the listener binds
# first, `admit` runs before any allocation, and `/health` serves
# `starting` → `ready` (with model identity) or `failed` (with the typed
# cause). No weight materialization happens on this path: only the
# admission contract (the whole-file digest + the header-prefix read →
# `gradus:model/gguf` admit) is called; `forward` / `generate` are never invoked here.
#
# U4 scope: the `/generate` endpoint — request parse (minimal product JSON
# per D3), field validation via the gradus reject rows (imperium_admissum,
# enforced with typed causes), the generation pipeline
# (encode → the port decode loop: prefill + decode with the admitted tokenizer
# EOG stop set and the max_tokens budget), cancellation checkpoints (D6 seam),
# and the resident-model proof (weights load exactly once; stderr records the
# single load). The decode loop lives in port_generate.fab. Default stop is
# `eog_stop()` (D4). This unit owns the request pipeline around it.
#
# I-live: `inferentia live --model <PATH> [--prompt TEXT]` admits the GGUF
# through `gguf.admit`, loads G3 tokenizer tables via `tokenizator.build`,
# loads the SmolLM2 port weights, and one-shot generates the given prompt
# (default: the frozen fixture) through the port decode loop, printing `ids=`
# (space-joined), the decoded `text=` and `finish=`. Default stop is
# eog_stop; --ignore-eos selects ignore_eos.
#
# HTTP serving goes through `norma:http/server` (bind / accept / reply /
# open_sse). Request bodies arrive as a value carrying list<b8>; `value ↦
# list<b8>` then `list<b8> ↦ string` extracts UTF-8 JSON. `/generate` answers
# JSON by default. `Accept: text/event-stream` or `?stream=1` emits one SSE
# event per token, written to the open response as each token is generated.
#
# Generation (A1): the gradus decode-token launches (bulk F32 weight load, K/V
# caches updated in place). The kernels run on whatever device the program is started
# on: `faber run --device metal <inferentia> -- live ...` for the GPU,
# `--device cpu` (several cores) or `--device reference` (one core, the oracle)
# for the same kernels on the CPU; without `--device`, a launch is refused.
# Inferentia has no CPU backend of its own. `--backend metal` is the only
# accepted value and names the kernel route, not the device. The `/model` body
# reports it. `live --trace` prints one `trace step=...` stderr line per
# generated step (the oracle input).
#
# The generated CLI framework is not used: its help/parse errors exit 0/2 and
# cannot carry the D5 usage-error exit, so argv is parsed in this unit and
# every usage error is detected before the listener binds.

import from "norma:console" console
import from "norma:crypto" crypto
import from "norma:fault" fault
import from "norma:fs" fsys
import from "norma:process" proc
import from "norma:http/headers" headers
import from "norma:http/request" httpreq
import from "norma:http/server" server
import from "norma:http/sse" sse

import from "gradus:generation/config" config
import from "gradus:generation/decoder" decoder
import from "gradus:model/artifact" artifact
import from "gradus:model/gguf" gguf
import from "gradus:model/gguf_manifest" gguf_manifest
import from "gradus:sampling" sampling
import from "gradus:tokenizer/bpe" tokenizator
import from "gradus:train" train

import from "./port_generate" pgen
import from "./port_weights" port

# ---------------------------------------------------------------------------
# Serve configuration (D1 syntax + D2 precedence)
#
# Documented constants are the defaults; server flags override them. `context`
# uses 0 as the "derive from the model's context_length" sentinel (the model is
# admitted at startup); an explicit `--context 0` is rejected as a config error.
# `max_prompt` uses the same 0 sentinel (default: the model context limit).
# ---------------------------------------------------------------------------
class ServeConfig {
    mut string model
    mut string host
    mut int port
    mut int max_tokens
    mut int max_prompt
    mut int context
    mut int seed
    mut string log_level
    mut string prompt
    mut string expected_digest
    mut bool ignore_eos
    mut bool trace
    mut string backend
}

# ---------------------------------------------------------------------------
# Admission lifecycle state (D3 health states: starting | ready | failed)
# ---------------------------------------------------------------------------

class ServerState {
    mut string state
    mut string sha256
    mut string error_text
    mut string model_path
    mut bool cancelled
}

# A fresh state is `starting` until admission runs (bind → admit → allocate).
fn new_state(string model_path) → ServerState {
    return ServerState { state = "starting", sha256 = "", error_text = "", model_path = model_path, cancelled = false }
}

# Functional transitions — Faber class parameters have value semantics, so a
# transition returns a new state instead of mutating in place.
fn admitted(ServerState st, string sha) → ServerState {
    return ServerState { state = "ready", sha256 = sha, error_text = st.error_text, model_path = st.model_path, cancelled = st.cancelled }
}

fn failed(ServerState st, string error) → ServerState {
    return ServerState { state = "failed", sha256 = st.sha256, error_text = error, model_path = st.model_path, cancelled = st.cancelled }
}

# D5 exit-code decision: 0 clean shutdown, 2 admission/load failure.
fn exit_code_for(string state) → int {
    if state ≡ "failed" { return 2 }
    return 0
}

# ---------------------------------------------------------------------------
# U4 — /generate endpoint
#
# The pinned facts and the fixed schema below come from i1-discovery §6.1 /
# i1-delivery D3/D4. The gradus GeneratioConfigura contract
# (gradus/src/generation.fab) is the single authority for the generation
# config surface: unknown fields and out-of-domain values are reject rows
# (imperium_admissum), enforced by the pinned engine with typed causes —
# this unit never re-implements them.
# ---------------------------------------------------------------------------

# The frozen fixture prompt text (i1-discovery §6.1) — the only prompt the
# encode step can serve until the BD-1 tokenizer encoder lands.
fn frozen_prompt_text() → string {
    return "The quick brown fox jumps over the lazy dog"
}

# The frozen fixture's pinned token ids (P10).
fn frozen_prompt_ids() → list<int> {
    return [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767]
}

# The pinned row's context length (SmolLM2-360M; --context 0 derives this).
fn model_context_limit() → int {
    return 8192
}

# The marker `request_body_text` returns when bytes→text decode fails
# (invalid UTF-8). It is not valid JSON (non-ASCII delimiters), so it cannot
# collide with a real request. (Functions, not top-level fixum — generated
# consts cannot own String in this toolchain.)
fn body_read_gap_marker() → string {
    return "⟪BODY-READ-GAP⟫"
}

# The parsed /generate request (D3). Presence flags implement D2 precedence:
# an absent body field inherits the server flag, then the documented default.
class GenerateRequest {
    mut bool ok
    mut string error
    mut string prompt
    mut bool has_prompt
    mut bool has_max_tokens
    mut int max_tokens
    mut bool has_max_prompt
    mut int max_prompt
    mut bool has_temperature
    mut float temperature
    mut bool has_top_k
    mut int top_k
    mut bool has_top_p
    mut float top_p
    mut bool has_min_p
    mut float min_p
    mut bool has_repeat_penalty
    mut float repeat_penalty
    mut bool has_seed
    mut int seed
}

# A fresh empty request (all flags off; `ok` set true — the caller's error
# path builds its own rejected request).
fn fresh_generate_request() → GenerateRequest {
    return GenerateRequest {
        ok = true, error = "", prompt = "", has_prompt = false,
        has_max_tokens = false, max_tokens = 0,
        has_max_prompt = false, max_prompt = 0,
        has_temperature = false, temperature = 0.0,
        has_top_k = false, top_k = 0,
        has_top_p = false, top_p = 0.0,
        has_min_p = false, min_p = 0.0,
        has_repeat_penalty = false, repeat_penalty = 0.0,
        has_seed = false, seed = 0
    }
}

fn rejected_generate_request(string error) → GenerateRequest {
    return GenerateRequest {
        ok = false, error = error, prompt = "", has_prompt = false,
        has_max_tokens = false, max_tokens = 0,
        has_max_prompt = false, max_prompt = 0,
        has_temperature = false, temperature = 0.0,
        has_top_k = false, top_k = 0,
        has_top_p = false, top_p = 0.0,
        has_min_p = false, min_p = 0.0,
        has_repeat_penalty = false, repeat_penalty = 0.0,
        has_seed = false, seed = 0
    }
}

fn generate_request_with_prompt(GenerateRequest r, string v) → GenerateRequest {
    return GenerateRequest { ok = r.ok, error = r.error, prompt = v, has_prompt = true,
        has_max_tokens = r.has_max_tokens, max_tokens = r.max_tokens,
        has_max_prompt = r.has_max_prompt, max_prompt = r.max_prompt,
        has_temperature = r.has_temperature, temperature = r.temperature,
        has_top_k = r.has_top_k, top_k = r.top_k,
        has_top_p = r.has_top_p, top_p = r.top_p,
        has_min_p = r.has_min_p, min_p = r.min_p,
        has_repeat_penalty = r.has_repeat_penalty, repeat_penalty = r.repeat_penalty,
        has_seed = r.has_seed, seed = r.seed }
}

fn generate_request_with_max_tokens(GenerateRequest r, int v) → GenerateRequest {
    return GenerateRequest { ok = r.ok, error = r.error, prompt = r.prompt, has_prompt = r.has_prompt,
        has_max_tokens = true, max_tokens = v,
        has_max_prompt = r.has_max_prompt, max_prompt = r.max_prompt,
        has_temperature = r.has_temperature, temperature = r.temperature,
        has_top_k = r.has_top_k, top_k = r.top_k,
        has_top_p = r.has_top_p, top_p = r.top_p,
        has_min_p = r.has_min_p, min_p = r.min_p,
        has_repeat_penalty = r.has_repeat_penalty, repeat_penalty = r.repeat_penalty,
        has_seed = r.has_seed, seed = r.seed }
}

fn generate_request_with_max_prompt(GenerateRequest r, int v) → GenerateRequest {
    return GenerateRequest { ok = r.ok, error = r.error, prompt = r.prompt, has_prompt = r.has_prompt,
        has_max_tokens = r.has_max_tokens, max_tokens = r.max_tokens,
        has_max_prompt = true, max_prompt = v,
        has_temperature = r.has_temperature, temperature = r.temperature,
