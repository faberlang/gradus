+++ toml
locale = "en"

+++ faber
# Candidate-provider seam — SD0-U3 (speculative-decode-contract).
#
# Public import: import from "gradus:speculative" speculative
#
# Depends on gradus:generation/config for the admission contract. AccelerationPolicy
# block-size bounds (gradus:generation/config, SD0-U2) remain the authority the
# provider request constructor consumes as primitive min/max; this leaf does
# not import cache or any device surface.
#
# --- Contract ------------------------------------------------------------
#
# The context-lookup goal implements one provider against this seam
# without touching generation or cache contracts. SD0 freezes the types
# and purity rules. It does not implement search, draft, or lookup.
#
# Provider request:
#   prompt      — tokenized prompt context (token ids, each ≥ 0)
#   history     — accepted generation history (token ids, each ≥ 0)
#   block_size  — requested candidate block length, inside the policy
#                  bounds [min_block, max_block] supplied by the caller
#                  from AccelerationPolicy
#
# Provider result:
#   candidates  — nonempty candidate token ids + provenance, with
#                  1 ≤ ids.length() ≤ request.block_size
#   no_draft    — typed no-candidate / no-draft; ordinary empty proposal
#                  (plain target-step fallback). Not an error.
#
# Provenance (admitted source is context_lookup only):
#   source         — "context_lookup"
#   source_offset  — ≥ 0; earliest source position of the match
#   match_length   — ≥ 1; suffix length that produced the candidates
#
# Purity: a provider is a pure function of a ProviderRequest. Equal
# requests produce equal results. The function consumes no RNG, mutates
# no cache, history, or generation state, and does not inspect unaccepted
# candidate tokens. This module has no propose implementation.
#
# Malformed requests and out-of-policy block sizes reject through typed
# SpeculativeError. Unknown provenance sources reject. Empty candidate
# lists are constructed with no_draft(), not construct_candidates.
#
# --- Seams ---------------------------------------------------------------
#   * greedy first-divergence acceptance and sampled typed reject — SD0-U4
#   * context-lookup search policy and propose implementation — SD4
#   * cache branch/commit — SD1 (kv-cache-branching)

import from "gradus:generation/config" let generation

# The sole admitted candidate source for this campaign.
const string SOURCE_CONTEXT_LOOKUP = "context_lookup"

# -------------------------------------------------------------------------
# SpeculativeError — typed vocabulary of the candidate-provider seam.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------

@ public
union SpeculativeError {
    @ shared
    string message

    InvalidBlockSize,
    MalformedRequest,
    MalformedResult,
    InvalidProvenance,
    PolicyDisabled,
    PolicyMismatch,
    SampledAccelerationRejected
}

# -------------------------------------------------------------------------
# GreedyAcceptance — the pure target/candidate comparison result.
# -------------------------------------------------------------------------

# `divergence_index` is -1 when every candidate token has an equal target
# token. A shorter target diverges at its length because the missing target
# token cannot admit the candidate at that position. The oracle compares only
# candidate positions; extra target tokens are outside the candidate block.
@ public
class GreedyAcceptance {
    mut int accepted_prefix
    mut int divergence
}

@ public
fn default_acceptance() → GreedyAcceptance {
    return GreedyAcceptance { accepted_prefix = 0, divergence = -1 }
}

@ public
fn acceptance_equal(GreedyAcceptance a, GreedyAcceptance b) → bool {
    if a.accepted_prefix ≢ b.accepted_prefix then return false

    return a.divergence ≡ b.divergence
}

# First-divergence oracle for greedy acceptance. Both lists are token ids;
# no target logits, provider, cache, RNG, or generation state enters this
# function. Equal candidate positions are admitted until the first mismatch.
@ public
fn first_divergence(list<int> target_ids, list<int> candidate_ids) → GreedyAcceptance ⇥ SpeculativeError {
    require_token_ids(target_ids)
    require_token_ids(candidate_ids)
    mut int bound ← target_ids.length()

    if candidate_ids.length() ≺ bound {
        bound ← candidate_ids.length()
    }

    for range 0 ‥ bound let i {
        if target_ids.get(i) coalesce (-1) ≢ candidate_ids.get(i) coalesce (-1) then return GreedyAcceptance { accepted_prefix = i, divergence = i }
    }

    if bound ≺ candidate_ids.length() then return GreedyAcceptance { accepted_prefix = bound, divergence = bound }

    return GreedyAcceptance { accepted_prefix = bound, divergence = -1 }
}

# -------------------------------------------------------------------------
# Admission — greedy acceleration only.
# -------------------------------------------------------------------------

@ public
union AdmissionResult {
    AdmittedGreedy
}

@ public
fn admitted_greedy() → AdmissionResult {
    return variant AdmittedGreedy
}

@ public
fn admission_kind(AdmissionResult a) → string {
    match a {
        case AdmittedGreedy {
            return "admitted-greedy"
        }
    }
}

# Admission is a pure gate before any future provider, branch, or sampling
# call. The caller supplies the selected policy and the GenerationConfig;
# both must agree on the enabled policy. Temperature > 0, top-k > 0,
# 0 < top-p < 1, or min-p > 0 selects sampled behavior and returns the one
# typed reject before an RNG or history can be observed or changed.
#
# Future sampled-mode proof obligations (not admitted here): name the
# generation/history/RNG transaction owner, prove pathwise identity against
# the dense baseline, and establish branch creation only after that proof.
@ public
fn admit_greedy(generation.AccelerationPolicy policy, generation.GenerationConfig g) → AdmissionResult ⇥ SpeculativeError {
    require generation.acceleration_mode_name(policy.mode) ≡ "context_lookup" throw variant PolicyDisabled { message = "acceleration policy is disabled" }

    require generation.acceleration_equal(policy, g.acceleration) throw variant PolicyMismatch { message = "acceleration policy does not match generation config" }

    if g.temperature ≻ 0.0 or g.top_k ≻ 0 or g.top_p ≻ 0.0 and g.top_p ≺ 1.0 or g.min_p ≻ 0.0 {
        throw variant SampledAccelerationRejected { message = "sampled acceleration is not supported" }
    }

    return variant AdmittedGreedy
}

# -------------------------------------------------------------------------
# ProviderRequest — tokenized prompt, accepted history, authorized block.
# -------------------------------------------------------------------------

@ public
class ProviderRequest {
    mut list<int> prompt
    mut list<int> history
    mut int block_size
}

# Placeholder for `var ProviderRequest` bindings. Zero block size is not
# a valid request; the caller overwrites it, or returns it from an
# unreachable cape arm.
@ public
fn default() → ProviderRequest {
    return ProviderRequest { prompt = empty, history = empty, block_size = 0 }
}

@ public
fn request_equal(ProviderRequest a, ProviderRequest b) → bool {
    if not (a.prompt ≡ b.prompt) then return false

    if not (a.history ≡ b.history) then return false

    if a.block_size ≢ b.block_size then return false

    return true
}

fn require_token_ids(list<int> ids) → void ⇥ SpeculativeError {
    for from ids let t {
        require t ≥ 0 throw variant MalformedRequest { message = "token id must be non-negative" }
    }
}

# Construct a provider request. min_block / max_block are the
# AccelerationPolicy bounds (SD0-U2). The requested block_size must lie
# in that closed interval. Prompt and history may be empty; a later
# provider returns no_draft for empty context.
@ public
fn construct_request(list<int> prompt, list<int> history, int block_size, int min_block, int max_block) → ProviderRequest ⇥ SpeculativeError {
    require min_block ≥ 1 throw variant InvalidBlockSize { message = "policy block size must be at least one" }

    require max_block ≥ 1 throw variant InvalidBlockSize { message = "policy block size must be at least one" }

    require min_block ≤ max_block throw variant InvalidBlockSize { message = "policy block size minimum must not exceed the maximum" }

    require block_size ≥ min_block throw variant InvalidBlockSize { message = "requested block size is outside the policy bounds" }

    require block_size ≤ max_block throw variant InvalidBlockSize { message = "requested block size is outside the policy bounds" }

    require_token_ids(prompt)
    require_token_ids(history)
    return ProviderRequest { prompt = prompt, history = history, block_size = block_size }
}

# -------------------------------------------------------------------------
# CandidateProvenance — search metadata carried with a candidate block.
# Lookup owns how these fields are chosen; the seam only admits the
# context_lookup source and the non-negative offset / positive length.
# -------------------------------------------------------------------------

@ public
class CandidateProvenance {
    mut string source
    mut int source_offset
    mut int match_length
}

@ public
fn default_provenance() → CandidateProvenance {
    return CandidateProvenance { source = "", source_offset = 0, match_length = 0 }
}

@ public
fn context_lookup_source() → string {
    return SOURCE_CONTEXT_LOOKUP
}

@ public
fn provenance_equal(CandidateProvenance a, CandidateProvenance b) → bool {
    if a.source ≢ b.source then return false

    if a.source_offset ≢ b.source_offset then return false

    if a.match_length ≢ b.match_length then return false

    return true
}

@ public
fn construct_provenance(string source, int source_offset, int match_length) → CandidateProvenance ⇥ SpeculativeError {
    require source ≡ SOURCE_CONTEXT_LOOKUP throw variant InvalidProvenance { message = "unknown candidate source" }

    require source_offset ≥ 0 throw variant InvalidProvenance { message = "source offset must be non-negative" }

    require match_length ≥ 1 throw variant InvalidProvenance { message = "match length must be at least one" }

    return CandidateProvenance { source = source, source_offset = source_offset, match_length = match_length }
}

# -------------------------------------------------------------------------
# ProviderResult — candidate ids + provenance, or a typed no-draft.
# Cross-module consumers use the factories and accessors; they cannot
# match imported variants (SEM001).
# -------------------------------------------------------------------------

@ public
union ProviderResult {
    Candidates {
        list<int> ids
        CandidateProvenance provenance
    },
    NoDraft
}

@ public
fn no_draft() → ProviderResult {
    return variant NoDraft
}

@ public
fn is_no_draft(ProviderResult r) → bool {
    match r {
        case NoDraft {
            return true
        }
        case Candidates let ids, provenance {
            return false
        }
    }
}

@ public
fn result_kind(ProviderResult r) → string {
    match r {
        case NoDraft {
            return "no_draft"
        }
        case Candidates let ids, provenance {
            return "candidates"
        }
    }
}

@ public
fn candidate_ids(ProviderResult r) → list<int> {
    match r {
        case NoDraft {
            return empty
        }
        case Candidates let ids, provenance {
            return ids
        }
    }
}

@ public
fn candidate_provenance(ProviderResult r) → CandidateProvenance ⇥ SpeculativeError {
    match r {
        case NoDraft {
            throw variant MalformedResult { message = "no-draft result has no provenance" }
        }
        case Candidates let ids, provenance {
            return provenance
        }
    }
}

@ public
fn result_equal(ProviderResult a, ProviderResult b) → bool {
    match a {
        case NoDraft {
            return is_no_draft(b)
        }
        case Candidates let ids_a, provenance_a {
            match b {
                case NoDraft {
                    return false
                }
                case Candidates let ids_b, provenance_b {
                    if not (ids_a ≡ ids_b) then return false

                    return provenance_equal(provenance_a, provenance_b)
                }
            }
        }
    }
}

# Bind candidate ids to a request. Empty ids are a typed no-draft via
# no_draft(), not this constructor. Length may be shorter than the
# requested block (available context) but must not exceed it.
@ public
fn construct_candidates(ProviderRequest request, list<int> ids, CandidateProvenance provenance) → ProviderResult ⇥ SpeculativeError {
    require ids.length() ≥ 1 throw variant MalformedResult { message = "candidate list must not be empty" }

    require ids.length() ≤ request.block_size throw variant MalformedResult { message = "candidate count exceeds the requested block size" }

    for from ids let t {
        require t ≥ 0 throw variant MalformedResult { message = "candidate token id must be non-negative" }
    }

    require provenance.source ≡ SOURCE_CONTEXT_LOOKUP throw variant InvalidProvenance { message = "unknown candidate source" }

    return variant Candidates { ids = ids, provenance = provenance }
}

+++ faber test
# Co-located package test for speculative.fab (SD0-U3 provider seam +
# SD0-U4 acceptance contract). Not importable; discovered only by the faber
# test path.
#
# Proves, at compile level:
#   * a ProviderRequest carries tokenized prompt context, accepted
#     generation history, and a requested block size inside the policy
#     bounds; out-of-policy block sizes and malformed requests reject
#     through typed SpeculativeError.
#   * a ProviderResult is candidate ids + provenance, or a typed
#     no-draft (no-candidate); empty lookup is not an error.
#   * provenance admits only the context_lookup source; unknown source,
#     negative offset, and zero match length reject.
#   * the greedy oracle returns the accepted prefix and first divergence,
#     with -1 denoting no divergence.
#   * the enabled-policy admission gate admits only greedy configs and
#     gives the same typed reject for every active sampling knob. The gate
#     has no provider, RNG, cache, or history argument and therefore cannot
#     mutate those values before rejection.
#
# First-failing oracle: the SD0-U4 sampled-reject row.
#
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/speculative.proba` proves the suite
# type-checks. This suite remains compile-level proof; no search or
# executed lookup is claimed here.

import from "gradus:speculative" speculative
import from "gradus:random" random
import from "gradus:generation/config" config


# Renders a request-construction outcome as text.
fn request_detail(list<int> prompt, list<int> history, int block_size, int min_block, int max_block) → string {
    let _ outcome ← trap {
        speculative.construct_request(prompt, history, block_size, min_block, max_block)
    }
    match outcome {
        case returned let value {
            return "ok"
        }
        case thrown let err {
            return err.message
        }
    }
}

# Renders a provenance-construction outcome as text.
fn provenance_detail(string source, int source_offset, int match_length) → string {
    let _ outcome ← trap {
        speculative.construct_provenance(source, source_offset, match_length)
    }
    match outcome {
        case returned let value {
            return "ok"
        }
        case thrown let err {
            return err.message
        }
    }
}

# Renders a candidate-binding outcome as text.
fn candidates_detail(speculative.ProviderRequest request, list<int> ids, speculative.CandidateProvenance provenance) → string {
    let _ outcome ← trap {
        speculative.construct_candidates(request, ids, provenance)
    }
    match outcome {
        case returned let value {
            return "ok"
        }
        case thrown let err {
            return err.message
        }
    }
}

# A valid in-bounds request (policy bounds 2–8, requested block 4).
fn request_p() → speculative.ProviderRequest {
    return speculative.construct_request([10, 11, 12], [13], 4, 2, 8) ⊥ speculative.default()
}

# A valid context_lookup provenance.
fn provenance_p() → speculative.CandidateProvenance {
    return speculative.construct_provenance(speculative.context_lookup_source(), 0, 2) ⊥ speculative.default_provenance()
}

describe "SD0-U3 — candidate-provider seam" {
    test "a request with block size outside the policy bounds is a typed reject" {
        assert request_detail([10, 11, 12], [13], 16, 2, 8) ≡ "requested block size is outside the policy bounds"
        assert request_detail([10, 11, 12], [13], 1, 2, 8) ≡ "requested block size is outside the policy bounds"
        assert request_detail([10, 11, 12], [13], 0, 2, 8) ≡ "requested block size is outside the policy bounds"
        assert request_detail([10, 11, 12], [13], 9, 2, 8) ≡ "requested block size is outside the policy bounds"
    }
    test "a request at each policy bound is admitted" {
        let _ trap_result_1 ← trap {

            let speculative.ProviderRequest lo ← speculative.construct_request([10], empty, 2, 2, 8)
            let speculative.ProviderRequest hi ← speculative.construct_request([10], empty, 8, 2, 8)
            assert lo.block_size ≡ 2
            assert hi.block_size ≡ 8
            assert request_detail([10], empty, 4, 2, 8) ≡ "ok"
        }
        match trap_result_1 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
    test "invalid policy bounds reject before the requested size is admitted" {
        assert request_detail([10], empty, 1, 0, 8) ≡ "policy block size must be at least one"
        assert request_detail([10], empty, 1, 1, 0) ≡ "policy block size must be at least one"
        assert request_detail([10], empty, 4, 8, 2) ≡ "policy block size minimum must not exceed the maximum"
    }
    test "negative token ids in prompt or history are a malformed request" {
        assert request_detail([10, -1], [13], 4, 2, 8) ≡ "token id must be non-negative"
        assert request_detail([10], [-2], 4, 2, 8) ≡ "token id must be non-negative"
    }
    test "a valid request stores prompt, history, and authorized block size" {
        let _ trap_result_2 ← trap {

            let speculative.ProviderRequest r ← speculative.construct_request([10, 11, 12], [13, 14], 4, 2, 8)
            assert r.prompt ≡ ([10, 11, 12] ↦ list<int>)
            assert r.history ≡ ([13, 14] ↦ list<int>)
            assert r.block_size ≡ 4
            assert speculative.request_equal(r, request_p()) ≡ false
        }
        match trap_result_2 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
    test "empty prompt and empty history are a valid request" {
        let _ trap_result_3 ← trap {

            let speculative.ProviderRequest r ← speculative.construct_request(empty, empty, 1, 1, 1)
            assert r.prompt.length() ≡ 0
            assert r.history.length() ≡ 0
            assert r.block_size ≡ 1
        }
        match trap_result_3 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
    test "equal requests compare equal (constructor determinism)" {
        let _ trap_result_4 ← trap {

            let speculative.ProviderRequest a ← speculative.construct_request([10, 11], [12], 3, 1, 8)
            let speculative.ProviderRequest b ← speculative.construct_request([10, 11], [12], 3, 1, 8)
            assert speculative.request_equal(a, b)
        }
        match trap_result_4 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
    test "no_draft is a typed no-candidate result, not an error" {
        let speculative.ProviderResult r ← speculative.no_draft()
        assert speculative.is_no_draft(r)
        assert speculative.result_kind(r) ≡ "no_draft"
        assert speculative.candidate_ids(r).length() ≡ 0
        assert speculative.result_equal(r, speculative.no_draft())
    }
    test "construct_candidates binds ids and context_lookup provenance" {
        let _ trap_result_5 ← trap {

            let speculative.ProviderRequest req ← request_p()
            let speculative.CandidateProvenance p ← provenance_p()
            let speculative.ProviderResult r ← speculative.construct_candidates(req, [21, 22], p)
            assert not (speculative.is_no_draft(r))
            assert speculative.result_kind(r) ≡ "candidates"
            assert speculative.candidate_ids(r) ≡ ([21, 22] ↦ list<int>)
            let speculative.CandidateProvenance got ← speculative.candidate_provenance(r)
            assert got.source ≡ speculative.context_lookup_source()
            assert got.source_offset ≡ 0
            assert got.match_length ≡ 2
            assert speculative.provenance_equal(got, p)
        }
        match trap_result_5 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
    test "a shorter-than-block candidate list is admitted" {
        let _ trap_result_6 ← trap {

            let speculative.ProviderRequest req ← request_p()
            let speculative.ProviderResult r ← speculative.construct_candidates(req, [21], provenance_p())
            assert speculative.candidate_ids(r).length() ≡ 1
            assert speculative.candidate_ids(r).length() ≺ req.block_size
        }
        match trap_result_6 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
    test "empty or oversize candidate lists reject" {
        assert candidates_detail(request_p(), empty, provenance_p()) ≡ "candidate list must not be empty"
        assert candidates_detail(request_p(), [1, 2, 3, 4, 5], provenance_p()) ≡ "candidate count exceeds the requested block size"
    }
    test "a negative candidate token id rejects" {
        assert candidates_detail(request_p(), [21, -1], provenance_p()) ≡ "candidate token id must be non-negative"
    }
    test "unknown provenance source, negative offset, and zero match length reject" {
        assert provenance_detail("draft_model", 0, 2) ≡ "unknown candidate source"
        assert provenance_detail(speculative.context_lookup_source(), -1, 2) ≡ "source offset must be non-negative"
        assert provenance_detail(speculative.context_lookup_source(), 0, 0) ≡ "match length must be at least one"
    }
    test "candidate_provenance on a no-draft result is a typed reject" {
        let _ outcome ← trap {

            let speculative.CandidateProvenance ? ← speculative.candidate_provenance(speculative.no_draft())
            assert false
        }
        match outcome {
            case thrown let err {
                assert err.message ≡ "no-draft result has no provenance"
            }
            case returned let ? {
                assert false
            }
        }
    }
    test "candidates and no-draft results do not compare equal" {
        let _ trap_result_7 ← trap {

            let speculative.ProviderResult drafted ← speculative.construct_candidates(request_p(), [21, 22], provenance_p())
            assert not (speculative.result_equal(drafted, speculative.no_draft()))
            assert speculative.result_equal(drafted, drafted)
        }
        match trap_result_7 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
}

# ---- SD0-U4 fixtures

fn lookup_policy_p() → config.AccelerationPolicy {
    return config.construct_acceleration("1.0.0", config.acceleration_context_lookup(), 2, 8) ⊥ config.default_acceleration()
}

fn config_with_sampling(f32 temperature, int top_k, f32 top_p, f32 min_p) → config.GenerationConfig {
    return config.construct_generation_with_policy(1024, 1, 128, 42, temperature, top_k, top_p, min_p, 1.0 ∷ f32, [0, 2], lookup_policy_p()) ⊥ config.default()
}

# BLOCKER (by shape, narrowing-to-call at MIR link): the success arm passes
# the narrowed AdmissionResult into admission_kind — `call argument type
# mismatch (expected Enum, got Union)` at package MIR test link, so the
# trap shape cannot express the success arm. Kept on do/catch. Do not
# convert.
fn admission_detail(config.AccelerationPolicy policy, config.GenerationConfig g) → string {
    do {
        let speculative.AdmissionResult a ← speculative.admit_greedy(policy, g)
        return speculative.admission_kind(a)
    }
    catch err {
        return err.message
    }
}

describe "SD0-U4 — greedy acceptance and sampled admission" {
    test "a fully matching candidate block is accepted with no divergence" {
        let _ trap_result_8 ← trap {

            let speculative.GreedyAcceptance a ← speculative.first_divergence([10, 11, 12], [10, 11])
            assert a.accepted_prefix ≡ 2
            assert a.divergence ≡ (0 - 1)
        }
        match trap_result_8 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
    test "the first mismatching candidate is rejected at its index" {
        let _ trap_result_9 ← trap {

            let speculative.GreedyAcceptance a ← speculative.first_divergence([10, 11, 12], [10, 99, 12])
            assert a.accepted_prefix ≡ 1
            assert a.divergence ≡ 1
        }
        match trap_result_9 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
    test "a candidate without a target token diverges at the target length" {
        let _ trap_result_10 ← trap {

            let speculative.GreedyAcceptance a ← speculative.first_divergence([10], [10, 11])
            assert a.accepted_prefix ≡ 1
            assert a.divergence ≡ 1
        }
        match trap_result_10 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
    test "a disabled policy rejects acceleration admission" {
        let _ trap_result_11 ← trap {

            let config.GenerationConfig g ← config.construct_generation(1024, 1, 128, 42, 0.0 ∷ f32, 0, 1.0 ∷ f32, 0.0 ∷ f32, 1.0 ∷ f32, [0, 2])
            assert admission_detail(config.default_acceleration(), g) ≡ "acceleration policy is disabled"
        }
        match trap_result_11 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
    test "a greedy context lookup request is admitted" {
        assert admission_detail(lookup_policy_p(), config_with_sampling(0.0 ∷ f32, 0, 1.0 ∷ f32, 0.0 ∷ f32)) ≡ "admitted-greedy"
    }
    test "every active sampling knob returns the same typed reject" {
        let config.AccelerationPolicy policy ← lookup_policy_p()
        let string by_temperature ← admission_detail(policy, config_with_sampling(0.8 ∷ f32, 0, 1.0 ∷ f32, 0.0 ∷ f32))
        let string by_top_k ← admission_detail(policy, config_with_sampling(0.0 ∷ f32, 5, 1.0 ∷ f32, 0.0 ∷ f32))
        let string by_top_p ← admission_detail(policy, config_with_sampling(0.0 ∷ f32, 0, 0.9 ∷ f32, 0.0 ∷ f32))
        let string by_min_p ← admission_detail(policy, config_with_sampling(0.0 ∷ f32, 0, 1.0 ∷ f32, 0.05 ∷ f32))
        assert by_temperature ≡ "sampled acceleration is not supported"
        assert by_top_k ≡ by_temperature
        assert by_top_p ≡ by_temperature
        assert by_min_p ≡ by_temperature
    }
    test "sampled rejection leaves the supplied seed and history untouched" {
        let _ trap_result_12 ← trap {

            let random.Seed before ← random.construct_seed(42)
            let random.Seed after ← before
            let list<int> history_before ← [7, 8, 9]
            let list<int> history_after ← history_before
            let string reject ← admission_detail(lookup_policy_p(), config_with_sampling(0.8 ∷ f32, 0, 1.0 ∷ f32, 0.0 ∷ f32))
            assert reject ≡ "sampled acceleration is not supported"
            assert after.status ≡ before.status
            assert history_after ≡ history_before
        }
        match trap_result_12 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
}
