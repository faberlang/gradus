# =============================================================================
# State — the admission lifecycle behind /health (starting | ready | failed)
# =============================================================================
#
# D3 health states. A fresh state is `starting` until admission runs
# (bind → admit → allocate); admission moves it to `ready` or `failed`.

@ public
enum Phase {
    Starting,
    Ready,
    Failed
}

@ public
class ServerState {
    mut Phase phase
    mut string sha256 = ""
    mut string error_text = ""
    mut string model_path
    mut bool cancelled = false
}

# The wire name of a phase, as /health and /model serve it.
@ public
fn phase_name(Phase phase) → string {
    match phase {
        case Starting {
            return "starting"
        }
        case Ready {
            return "ready"
        }
        case Failed {
            return "failed"
        }
    }
}

@ public
fn new_state(string model_path) → ServerState {
    return ServerState { phase = Phase.Starting, model_path = model_path }
}

# Transitions return a new state; the caller rebinds.
@ public
fn admitted_state(ServerState st, string sha) → ServerState {
    return ServerState { phase = Phase.Ready, sha256 = sha } from st
}

@ public
fn failed_state(ServerState st, string error) → ServerState {
    return ServerState { phase = Phase.Failed, error_text = error } from st
}

# D5 exit-code decision: 0 clean shutdown, 2 admission/load failure.
@ public
fn exit_code_for(Phase phase) → int {
    return phase ≡ Phase.Failed ✓ 2 ✗ 0
}

describe "health lifecycle" tag "inferentia" {
    test "state starts starting before admission" {
        let ServerState st ← new_state("/models/x.gguf")
        assert st.phase ≡ Phase.Starting
        assert st.sha256 ≡ ""
        assert st.error_text ≡ ""
    }
    test "admission success transitions to ready with model identity" {
        let ServerState st ← admitted_state(new_state("/models/x.gguf"), "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2")
        assert st.phase ≡ Phase.Ready
        assert st.sha256 ≡ "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2"
        assert st.error_text ≡ ""
        assert st.model_path ≡ "/models/x.gguf"
    }
    test "admission failure transitions to failed with typed error" {
        let ServerState st ← failed_state(new_state("/missing.gguf"), "io error: No such file")
        assert st.phase ≡ Phase.Failed
        assert st.error_text ≡ "io error: No such file"
        assert st.model_path ≡ "/missing.gguf"
    }
    test "a failure keeps the digest admitted before it" {
        let ServerState ready ← admitted_state(new_state("/m.gguf"), "2fa3f013")
        let ServerState st ← failed_state(ready, "model load failed")
        assert st.phase ≡ Phase.Failed
        assert st.sha256 ≡ "2fa3f013"
    }
    test "phase names are the wire states" {
        assert phase_name(Phase.Starting) ≡ "starting"
        assert phase_name(Phase.Ready) ≡ "ready"
        assert phase_name(Phase.Failed) ≡ "failed"
    }
    test "exit code decision maps failed to 2" {
        assert exit_code_for(Phase.Failed) ≡ 2
        assert exit_code_for(Phase.Ready) ≡ 0
        assert exit_code_for(Phase.Starting) ≡ 0
    }
}
