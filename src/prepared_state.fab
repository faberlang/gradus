+++
locale = "en"
+++
# Canonical prepared identity — PP-U1 (prepared-prefix-state spine, SD5).
# The first unit of the goal: the typed record that NAMES a prepared
# prefix state. PP-U2 adds the typed prepared payload and binding, PP-U3
# the attach/continue operations — both land in this same leaf later.
#
# Public import: import from "gradus:prepared_state" prepared_state
# Depends on: gradus:tokenizer (the typed tokenizer identity component).
#
# Extends the CacheIdentity precedent (cache.fab:505-632) without editing
# it: a versioned typed record, field-wise equality, a versioned wire
# that round-trips exactly, fail-closed deserialization, and a documented
# "-" sentinel for empty wire segments.
#
# --- Component ownership -----------------------------------------------
#   * content — the EXACT canonical token prefix (list<int> plus the
#     derived length). The lookup digest is an opaque host/provider
#     passthrough: gradus never computes it, and it is NEVER
#     equality-authoritative (differing tokens / same digest is unequal;
#     same tokens / differing digest is equal).
#   * model / capsule identity — model name and model_version strings.
#   * execution config — the state-producing config string only.
#     Sampling-only fields are excluded by construction: they are not
#     part of this record at all.
#   * tokenizer identity — the typed gradus:tokenizer TokenizerIdentity
#     record. This leaf binds the typed value: semantic admission of
#     tokenizer facts (pinned row, digest shape) stays in
#     gradus:tokenizer's own construct/verify — it is never re-run or
#     re-owned here. Only structural facts (non-empty, wire-safe fields)
#     are checked at this boundary.
#   * position — the exact consumed range [start, next) and the next
#     position; next ≡ start + prefix length holds structurally.
#
# --- Wire form ----------------------------------------------------------
#   prepared-state/identity/<schema>|<model>|<model_version>|<config>
#     |<tok schema>|<tok kind>|<tok pre>|<tok vocab-digest>|<tok eog>
#     |<tok bos-free>|<tok space-free>|<prefix or ->|<digest or ->
#     |<start>|<next>
# The "|" field separator keeps every free-text field one segment; "|" is
# therefore reserved in every free-text field. The tokenizer component
# embeds the typed record's own fields (never a second canonical
# tokenizer wire). The empty prefix and the empty digest serialize as
# "-". Deserialization is fail-closed: unknown marker, unknown schema
# version, wrong segment count, empty or malformed fields, and an
# inconsistent consumed range all reject typed.
#
# --- Architectural rule -------------------------------------------------
# No registry, no retention, no auth, no tenant, no device handle; no
# model/dense/generation import; no cryptographic digest computation
# (the digest is passthrough input only).

import from "gradus:tokenizer" tokenizer

# The prepared identity wire schema version.
const string identity_schema_version ← "1.0.0"

# The wire field separator (reserved in every free-text field) and the
# documented empty-segment sentinel.
const string IDENTITY_SEPARATOR ← "|"

const string IDENTITY_EMPTY ← "-"

@ public { }
union PreparedStateError {
    BadWire {
        string message
    },
    UnknownVersion {
        string message
    },
    InvalidIdentity {
        string message
    }
}

@ public { }
fn message(PreparedStateError e) → string {
    match e {
        case BadWire const message {
            return message
        }
        case UnknownVersion const message {
            return message
        }
        case InvalidIdentity const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# PreparedIdentity — the canonical prepared identity record (PP-U1).
# Immutable value; accessors only. position_next is derived so the
# consumed range always binds the exact prefix length.
# -------------------------------------------------------------------------

@ public { }
class PreparedIdentity {
    string model
    string model_version
    string config
    tokenizer.TokenizerIdentity tokenizer_identity
    list<int> prefix
    string lookup_digest
    int position_start

    fn model() → string {
        return self.model
    }

    fn model_version() → string {
        return self.model_version
    }

    fn config() → string {
        return self.config
    }

    fn tokenizer_identity() → tokenizer.TokenizerIdentity {
        return self.tokenizer_identity
    }

    fn prefix() → list<int> {
        return self.prefix
    }

    fn length() → int {
        return self.prefix.length()
    }

    fn lookup_digest() → string {
        return self.lookup_digest
    }

    fn position_start() → int {
        return self.position_start
    }

    fn position_next() → int {
        return self.position_start + self.prefix.length()
    }
}

# -------------------------------------------------------------------------
# Private validation helpers (the cache.fab pattern).
# -------------------------------------------------------------------------

# Digit predicate (no negative sign — a "-" fails closed).
@ private { }
fn _digit(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    for range 0‥s.length() const i {
        if not _digit(s.get(i) ↦ string) then return false
    }
    return true
}

# Free-text fields may not contain the wire field separator.
@ private { }
fn _wire_safe(string s) → bool {
    for range 0‥s.length() const i {
        if (s.get(i) ↦ string) ≡ IDENTITY_SEPARATOR then return false
    }
    return true
}

# Field-wise tokenizer identity equality (the typed component).
@ private { }
fn _tokenizer_equal(tokenizer.TokenizerIdentity a, tokenizer.TokenizerIdentity b) → bool {
    if a.schema() ≠ b.schema() then return false
    if a.merge_kind() ≠ b.merge_kind() then return false
    if a.pre_tokenizer() ≠ b.pre_tokenizer() then return false
    if a.vocab_digest() ≠ b.vocab_digest() then return false
    if a.eog() ≠ b.eog() then return false
    if a.bos_free() ≠ b.bos_free() then return false
    if a.space_free() ≠ b.space_free() then return false
    return true
}

# Element-wise prefix equality.
@ private { }
fn _prefix_equal(list<int> a, list<int> b) → bool {
    if a.length() ≠ b.length() then return false
    for range 0‥a.length() const i {
        if (a.get(i) coalesce 0) ≠ (b.get(i) coalesce 0) then return false
    }
    return true
}

# -------------------------------------------------------------------------
# construct — the fail-closed prepared identity admission. Free-text
# fields (model/version/config/digest and the tokenizer component's
# string fields) must be non-empty where the wire requires content and
# wire-safe; token ids must be non-negative; the start position must be
# non-negative. Semantic tokenizer admission is gradus:tokenizer's own
# authority and is not re-run here.
# -------------------------------------------------------------------------

@ public { }
fn construct(string model, string model_version, string config, tokenizer.TokenizerIdentity tok, list<int> prefix, string lookup_digest, int position_start) → PreparedIdentity ⇥ PreparedStateError {
    require model.length() ≠ 0 throw variant InvalidIdentity {message = "empty model name in prepared identity"}
    require model_version.length() ≠ 0 throw variant InvalidIdentity {message = "empty model version in prepared identity"}
    require config.length() ≠ 0 throw variant InvalidIdentity {message = "empty execution config in prepared identity"}
    require _wire_safe(model) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(model_version) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(config) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(lookup_digest) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require tok.schema().length() ≠ 0 throw variant InvalidIdentity {message = "empty tokenizer schema in prepared identity"}
    require tok.merge_kind().length() ≠ 0 throw variant InvalidIdentity {message = "empty tokenizer kind in prepared identity"}
    require tok.pre_tokenizer().length() ≠ 0 throw variant InvalidIdentity {message = "empty pre-tokenizer in prepared identity"}
    require tok.vocab_digest().length() ≠ 0 throw variant InvalidIdentity {message = "empty tokenizer vocabulary digest in prepared identity"}
    require tok.eog().length() ≠ 0 throw variant InvalidIdentity {message = "empty tokenizer EOG set in prepared identity"}
    require _wire_safe(tok.schema()) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(tok.merge_kind()) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(tok.pre_tokenizer()) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(tok.vocab_digest()) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(tok.eog()) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    for from prefix const token_id {
        require token_id ≥ 0 throw variant InvalidIdentity {message = "token id below zero in prepared prefix"}
    }
    require position_start ≥ 0 throw variant InvalidIdentity {message = "negative start position in prepared identity"}
    return PreparedIdentity {model = model, model_version = model_version, config = config, tokenizer_identity = tok, prefix = prefix, lookup_digest = lookup_digest, position_start = position_start}
}

# -------------------------------------------------------------------------
# prepared_identity_equal — field-wise equality over every component
# EXCEPT the lookup digest: the digest is passthrough input and is never
# equality-authoritative (the exact token prefix decides).
# -------------------------------------------------------------------------

@ public { }
fn prepared_identity_equal(PreparedIdentity a, PreparedIdentity b) → bool {
    if a.model() ≠ b.model() then return false
    if a.model_version() ≠ b.model_version() then return false
    if a.config() ≠ b.config() then return false
    if not _tokenizer_equal(a.tokenizer_identity(), b.tokenizer_identity()) then return false
    if not _prefix_equal(a.prefix(), b.prefix()) then return false
    if a.position_start() ≠ b.position_start() then return false
    if a.position_next() ≠ b.position_next() then return false
    return true
}

# -------------------------------------------------------------------------
# Identity wire — versioned, exact round-trip (the cache.fab precedent).
# The marker segment carries the schema; fields are "|" separated. The
# tokenizer component embeds the typed record's own fields — never a
# second canonical tokenizer wire (gradus:tokenizer owns that form).
# -------------------------------------------------------------------------

@ public { }
fn serialize_identity(PreparedIdentity i) → string ⇥ PreparedStateError {
    var string prefix_text ← ""
    for range 0‥i.length() const k {
        if k ≻ 0 {
            prefix_text ← prefix_text + ","
        }
        prefix_text ← prefix_text + (i.prefix().get(k) coalesce 0 ↦ string)
    }
    if prefix_text.length() ≡ 0 {
        prefix_text ← IDENTITY_EMPTY
    }
    var string digest ← i.lookup_digest()
    if digest.length() ≡ 0 {
        digest ← IDENTITY_EMPTY
    }
    const tokenizer.TokenizerIdentity tok ← i.tokenizer_identity()
    return "prepared-state/identity/§|§|§|§|§|§|§|§|§|§|§|§|§|§|§"(identity_schema_version, i.model(), i.model_version(), i.config(), tok.schema(), tok.merge_kind(), tok.pre_tokenizer(), tok.vocab_digest(), tok.eog(), tok.bos_free() ↦ string, tok.space_free() ↦ string, prefix_text, digest, i.position_start() ↦ string, i.position_next() ↦ string)
}

@ public { }
fn deserialize_identity(string wire) → PreparedIdentity ⇥ PreparedStateError {
    const list<string> parts ← wire.split(IDENTITY_SEPARATOR)
    require parts.length() ≡ 15 throw variant BadWire {message = "malformed prepared identity wire"}
    const list<string> marker ← (parts.get(0) coalesce "").split("/")
    require marker.length() ≡ 3 throw variant BadWire {message = "unknown prepared-state marker"}
    require marker.get(0) coalesce "" ≡ "prepared-state" throw variant BadWire {message = "unknown prepared-state marker"}
    require marker.get(1) coalesce "" ≡ "identity" throw variant BadWire {message = "unknown prepared-state marker"}
    require marker.get(2) coalesce "" ≡ identity_schema_version throw variant UnknownVersion {message = "unknown prepared-state identity schema version"}
    const string model ← parts.get(1) coalesce ""
    const string model_version ← parts.get(2) coalesce ""
    const string config ← parts.get(3) coalesce ""
    require model.length() ≠ 0 throw variant BadWire {message = "empty model name in prepared identity"}
    require model_version.length() ≠ 0 throw variant BadWire {message = "empty model version in prepared identity"}
    require config.length() ≠ 0 throw variant BadWire {message = "empty execution config in prepared identity"}
    const string tok_schema ← parts.get(4) coalesce ""
    const string tok_kind ← parts.get(5) coalesce ""
    const string tok_pre ← parts.get(6) coalesce ""
    const string tok_vocab ← parts.get(7) coalesce ""
    const string tok_eog ← parts.get(8) coalesce ""
    const string tok_bos_text ← parts.get(9) coalesce ""
    const string tok_space_text ← parts.get(10) coalesce ""
    require tok_schema.length() ≠ 0 throw variant BadWire {message = "empty tokenizer schema in prepared identity wire"}
    require tok_kind.length() ≠ 0 throw variant BadWire {message = "empty tokenizer kind in prepared identity wire"}
    require tok_pre.length() ≠ 0 throw variant BadWire {message = "empty pre-tokenizer in prepared identity wire"}
    require tok_vocab.length() ≠ 0 throw variant BadWire {message = "empty tokenizer vocabulary digest in prepared identity wire"}
    require tok_eog.length() ≠ 0 throw variant BadWire {message = "empty tokenizer EOG set in prepared identity wire"}
    require tok_bos_text ≡ "true" or tok_bos_text ≡ "false" throw variant BadWire {message = "malformed tokenizer boolean in prepared identity wire"}
    require tok_space_text ≡ "true" or tok_space_text ≡ "false" throw variant BadWire {message = "malformed tokenizer boolean in prepared identity wire"}
    const bool tok_bos ← tok_bos_text ≡ "true"
    const bool tok_space ← tok_space_text ≡ "true"
    const tokenizer.TokenizerIdentity tok ← tokenizer.TokenizerIdentity {schema = tok_schema, merge_kind = tok_kind, pre_tokenizer = tok_pre, vocab_digest = tok_vocab, eog = tok_eog, bos_free = tok_bos, space_free = tok_space}
    var string prefix_text ← parts.get(11) coalesce ""
    if prefix_text ≡ IDENTITY_EMPTY {
        prefix_text ← ""
    }
    var list<int> prefix ← empty
    if prefix_text.length() ≠ 0 {
        const list<string> ids ← prefix_text.split(",")
        for from ids const id_text {
            require _numeric(id_text) throw variant BadWire {message = "malformed token id in prepared identity wire"}
            var int id ← 0
            do {
                id ↤ id_text
            }
            catch err {
                throw variant BadWire {message = "malformed token id in prepared identity wire"}
            }
            prefix.append(id)
        }
    }
    var string digest ← parts.get(12) coalesce ""
    if digest ≡ IDENTITY_EMPTY {
        digest ← ""
    }
    const string start_text ← parts.get(13) coalesce ""
    const string next_text ← parts.get(14) coalesce ""
    require _numeric(start_text) throw variant BadWire {message = "malformed start position in prepared identity wire"}
    require _numeric(next_text) throw variant BadWire {message = "malformed next position in prepared identity wire"}
    var int position_start ← 0
    do {
        position_start ↤ start_text
    }
    catch err {
        throw variant BadWire {message = "malformed start position in prepared identity wire"}
    }
    var int position_next ← 0
    do {
        position_next ↤ next_text
    }
    catch err {
        throw variant BadWire {message = "malformed next position in prepared identity wire"}
    }
    require position_next ≡ position_start + prefix.length() throw variant BadWire {message = "inconsistent consumed range in prepared identity wire"}
    return construct(model, model_version, config, tok, prefix, digest, position_start)
}
