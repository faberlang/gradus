+++
locale = "en"
+++
# Canonical prepared identity + typed prepared state — PP-U1/PP-U2
# (prepared-prefix-state spine, SD5). PP-U1 names a prepared prefix state
# (the canonical identity); PP-U2 adds the typed prepared payload and its
# binding below. PP-U3a adds the attach admission in this same leaf;
# PP-U3b adds the longest-prefix attach selection; U4's continuation
# follows here too.
#
# Public import: import from "gradus:prepared_state" prepared_state
# Depends on: gradus:tokenizer (the typed tokenizer identity component),
#   gradus:cache (the dense KV payload family — list<kv.KVCache>).
#
# Extends the CacheIdentity precedent (cache.fab:505-632) without editing
# it: a versioned typed record, field-wise equality, a versioned wire
# that round-trips exactly, fail-closed deserialization, and a documented
# "-" sentinel for empty wire segments.
#
# --- Component ownership -----------------------------------------------
#   * content — the EXACT canonical token prefix (list<int> plus the
#     derived length). The lookup digest is an opaque host/provider
#     passthrough: gradus never computes it, and it is NEVER
#     equality-authoritative (differing tokens / same digest is unequal;
#     same tokens / differing digest is equal).
#   * model / capsule identity — model name and model_version strings.
#   * execution config — the state-producing config string only.
#     Sampling-only fields are excluded by construction: they are not
#     part of this record at all.
#   * tokenizer identity — the typed gradus:tokenizer TokenizerIdentity
#     record. This leaf binds the typed value: semantic admission of
#     tokenizer facts (pinned row, digest shape) stays in
#     gradus:tokenizer's own construct/verify — it is never re-run or
#     re-owned here. Only structural facts (non-empty, wire-safe fields)
#     are checked at this boundary.
#   * position — the exact consumed range [start, next) and the next
#     position; next ≡ start + prefix length holds structurally.
#
# --- Wire form ----------------------------------------------------------
#   prepared-state/identity/<schema>|<model>|<model_version>|<config>
#     |<tok schema>|<tok kind>|<tok pre>|<tok vocab-digest>|<tok eog>
#     |<tok bos-free>|<tok space-free>|<prefix or ->|<digest or ->
#     |<start>|<next>
# The "|" field separator keeps every free-text field one segment; "|" is
# therefore reserved in every free-text field. The tokenizer component
# embeds the typed record's own fields (never a second canonical
# tokenizer wire). The empty prefix and the empty digest serialize as
# "-". Deserialization is fail-closed: unknown marker, unknown schema
# version, wrong segment count, empty or malformed fields, and an
# inconsistent consumed range all reject typed.
#
# --- Architectural rule -------------------------------------------------
# No registry, no retention, no auth, no tenant, no device handle; no
# model/dense/generation import; no cryptographic digest computation
# (the digest is passthrough input only).

import from "gradus:tokenizer" tokenizer

import from "gradus:cache" kv

# The prepared identity wire schema version.
const string identity_schema_version ← "1.0.0"

# The wire field separator (reserved in every free-text field) and the
# documented empty-segment sentinel.
const string IDENTITY_SEPARATOR ← "|"

const string IDENTITY_EMPTY ← "-"

@ public
union PreparedStateError {
    @ shared
    string message

    BadWire,
    UnknownVersion,
    InvalidIdentity,
    PayloadMismatch
}



# -------------------------------------------------------------------------
# PreparedIdentity — the canonical prepared identity record (PP-U1).
# Immutable value; accessors only. position_next is derived so the
# consumed range always binds the exact prefix length.
# -------------------------------------------------------------------------

@ public
class PreparedIdentity {
    string model
    string model_version
    string config
    tokenizer.TokenizerIdentity tokenizer_identity
    list<int> prefix
    string lookup_digest
    int position_start

    fn model() → string {
        return self.model
    }

    fn model_version() → string {
        return self.model_version
    }

    fn config() → string {
        return self.config
    }

    fn tokenizer_identity() → tokenizer.TokenizerIdentity {
        return self.tokenizer_identity
    }

    fn prefix() → list<int> {
        return self.prefix
    }

    fn length() → int {
        return self.prefix.length()
    }

    fn lookup_digest() → string {
        return self.lookup_digest
    }

    fn position_start() → int {
        return self.position_start
    }

    fn position_next() → int {
        return self.position_start + self.prefix.length()
    }
}

# -------------------------------------------------------------------------
# Private validation helpers (the cache.fab pattern).
# -------------------------------------------------------------------------

# Digit predicate (no negative sign — a "-" fails closed).
fn _digit(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

fn _numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    for from s const c {
        if not _digit(c ↦ string) then return false
    }
    return true
}

# Free-text fields may not contain the wire field separator.
fn _wire_safe(string s) → bool {
    for from s const c {
        if (c ↦ string) ≡ IDENTITY_SEPARATOR then return false
    }
    return true
}

# Field-wise tokenizer identity equality (the typed component).
fn _tokenizer_equal(tokenizer.TokenizerIdentity a, tokenizer.TokenizerIdentity b) → bool {
    if a.schema() ≠ b.schema() then return false
    if a.merge_kind() ≠ b.merge_kind() then return false
    if a.pre_tokenizer() ≠ b.pre_tokenizer() then return false
    if a.vocab_digest() ≠ b.vocab_digest() then return false
    if a.eog() ≠ b.eog() then return false
    if a.bos_free() ≠ b.bos_free() then return false
    if a.space_free() ≠ b.space_free() then return false
    return true
}

# Element-wise prefix equality.
fn _prefix_equal(list<int> a, list<int> b) → bool {
    if a.length() ≠ b.length() then return false
    # legacy-L2: flat list carriers — parallel prefix comparison requires indexed access; retain bounded walk.
    for range 0‥a.length() const i {
        if (a.get(i) coalesce 0) ≠ (b.get(i) coalesce 0) then return false
    }
    return true
}

# -------------------------------------------------------------------------
# construct — the fail-closed prepared identity admission. Free-text
# fields (model/version/config/digest and the tokenizer component's
# string fields) must be non-empty where the wire requires content and
# wire-safe; token ids must be non-negative; the start position must be
# non-negative. Semantic tokenizer admission is gradus:tokenizer's own
# authority and is not re-run here.
# -------------------------------------------------------------------------

@ public
fn construct(string model, string model_version, string config, tokenizer.TokenizerIdentity tok, list<int> prefix, string lookup_digest, int position_start) → PreparedIdentity ⇥ PreparedStateError {
    require model.length() ≠ 0 throw variant InvalidIdentity {message = "empty model name in prepared identity"}
    require model_version.length() ≠ 0 throw variant InvalidIdentity {message = "empty model version in prepared identity"}
    require config.length() ≠ 0 throw variant InvalidIdentity {message = "empty execution config in prepared identity"}
    require _wire_safe(model) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(model_version) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(config) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(lookup_digest) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require tok.schema().length() ≠ 0 throw variant InvalidIdentity {message = "empty tokenizer schema in prepared identity"}
    require tok.merge_kind().length() ≠ 0 throw variant InvalidIdentity {message = "empty tokenizer kind in prepared identity"}
    require tok.pre_tokenizer().length() ≠ 0 throw variant InvalidIdentity {message = "empty pre-tokenizer in prepared identity"}
    require tok.vocab_digest().length() ≠ 0 throw variant InvalidIdentity {message = "empty tokenizer vocabulary digest in prepared identity"}
    require tok.eog().length() ≠ 0 throw variant InvalidIdentity {message = "empty tokenizer EOG set in prepared identity"}
    require _wire_safe(tok.schema()) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(tok.merge_kind()) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(tok.pre_tokenizer()) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(tok.vocab_digest()) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    require _wire_safe(tok.eog()) throw variant InvalidIdentity {message = "reserved wire character in prepared identity"}
    for from prefix const token_id {
        require token_id ≥ 0 throw variant InvalidIdentity {message = "token id below zero in prepared prefix"}
    }
    require position_start ≥ 0 throw variant InvalidIdentity {message = "negative start position in prepared identity"}
    return PreparedIdentity {model = model, model_version = model_version, config = config, tokenizer_identity = tok, prefix = prefix, lookup_digest = lookup_digest, position_start = position_start}
}

# -------------------------------------------------------------------------
# prepared_identity_equal — field-wise equality over every component
# EXCEPT the lookup digest: the digest is passthrough input and is never
# equality-authoritative (the exact token prefix decides).
# -------------------------------------------------------------------------

@ public
fn prepared_identity_equal(PreparedIdentity a, PreparedIdentity b) → bool {
    if a.model() ≠ b.model() then return false
    if a.model_version() ≠ b.model_version() then return false
    if a.config() ≠ b.config() then return false
    if not _tokenizer_equal(a.tokenizer_identity(), b.tokenizer_identity()) then return false
    if not _prefix_equal(a.prefix(), b.prefix()) then return false
    if a.position_start() ≠ b.position_start() then return false
    if a.position_next() ≠ b.position_next() then return false
    return true
}

# -------------------------------------------------------------------------
# Identity wire — versioned, exact round-trip (the cache.fab precedent).
# The marker segment carries the schema; fields are "|" separated. The
# tokenizer component embeds the typed record's own fields — never a
# second canonical tokenizer wire (gradus:tokenizer owns that form).
# -------------------------------------------------------------------------

@ public
fn serialize_identity(PreparedIdentity i) → string ⇥ PreparedStateError {
    var string prefix_text ← ""
    var bool first ← true
    for from i.prefix() const token_id {
        if not first {
            prefix_text ← prefix_text + ","
        }
        prefix_text ← prefix_text + (token_id ↦ string)
        first ← false
    }
    if prefix_text.length() ≡ 0 {
        prefix_text ← IDENTITY_EMPTY
    }
    var string digest ← i.lookup_digest()
    if digest.length() ≡ 0 {
        digest ← IDENTITY_EMPTY
    }
    const tokenizer.TokenizerIdentity tok ← i.tokenizer_identity()
    return "prepared-state/identity/§|§|§|§|§|§|§|§|§|§|§|§|§|§|§"(identity_schema_version, i.model(), i.model_version(), i.config(), tok.schema(), tok.merge_kind(), tok.pre_tokenizer(), tok.vocab_digest(), tok.eog(), tok.bos_free() ↦ string, tok.space_free() ↦ string, prefix_text, digest, i.position_start() ↦ string, i.position_next() ↦ string)
}

@ public
fn deserialize_identity(string wire) → PreparedIdentity ⇥ PreparedStateError {
    const list<string> parts ← wire.split(IDENTITY_SEPARATOR)
    require parts.length() ≡ 15 throw variant BadWire {message = "malformed prepared identity wire"}
    const list<string> marker ← (parts.get(0) coalesce "").split("/")
    require marker.length() ≡ 3 throw variant BadWire {message = "unknown prepared-state marker"}
    require marker.get(0) coalesce "" ≡ "prepared-state" throw variant BadWire {message = "unknown prepared-state marker"}
    require marker.get(1) coalesce "" ≡ "identity" throw variant BadWire {message = "unknown prepared-state marker"}
    require marker.get(2) coalesce "" ≡ identity_schema_version throw variant UnknownVersion {message = "unknown prepared-state identity schema version"}
    const string model ← parts.get(1) coalesce ""
    const string model_version ← parts.get(2) coalesce ""
    const string config ← parts.get(3) coalesce ""
    require model.length() ≠ 0 throw variant BadWire {message = "empty model name in prepared identity"}
    require model_version.length() ≠ 0 throw variant BadWire {message = "empty model version in prepared identity"}
    require config.length() ≠ 0 throw variant BadWire {message = "empty execution config in prepared identity"}
    const string tok_schema ← parts.get(4) coalesce ""
    const string tok_kind ← parts.get(5) coalesce ""
    const string tok_pre ← parts.get(6) coalesce ""
    const string tok_vocab ← parts.get(7) coalesce ""
    const string tok_eog ← parts.get(8) coalesce ""
    const string tok_bos_text ← parts.get(9) coalesce ""
    const string tok_space_text ← parts.get(10) coalesce ""
    require tok_schema.length() ≠ 0 throw variant BadWire {message = "empty tokenizer schema in prepared identity wire"}
    require tok_kind.length() ≠ 0 throw variant BadWire {message = "empty tokenizer kind in prepared identity wire"}
    require tok_pre.length() ≠ 0 throw variant BadWire {message = "empty pre-tokenizer in prepared identity wire"}
    require tok_vocab.length() ≠ 0 throw variant BadWire {message = "empty tokenizer vocabulary digest in prepared identity wire"}
    require tok_eog.length() ≠ 0 throw variant BadWire {message = "empty tokenizer EOG set in prepared identity wire"}
    require tok_bos_text ≡ "true" or tok_bos_text ≡ "false" throw variant BadWire {message = "malformed tokenizer boolean in prepared identity wire"}
    require tok_space_text ≡ "true" or tok_space_text ≡ "false" throw variant BadWire {message = "malformed tokenizer boolean in prepared identity wire"}
    const bool tok_bos ← tok_bos_text ≡ "true"
    const bool tok_space ← tok_space_text ≡ "true"
    const tokenizer.TokenizerIdentity tok ← tokenizer.TokenizerIdentity {schema = tok_schema, merge_kind = tok_kind, pre_tokenizer = tok_pre, vocab_digest = tok_vocab, eog = tok_eog, bos_free = tok_bos, space_free = tok_space}
    var string prefix_text ← parts.get(11) coalesce ""
    if prefix_text ≡ IDENTITY_EMPTY {
        prefix_text ← ""
    }
    var list<int> prefix ← empty
    if prefix_text.length() ≠ 0 {
        const list<string> ids ← prefix_text.split(",")
        for from ids const id_text {
            require _numeric(id_text) throw variant BadWire {message = "malformed token id in prepared identity wire"}
            var int id ← 0
            do {
                id ↤ id_text
            }
            catch err {
                throw variant BadWire {message = "malformed token id in prepared identity wire"}
            }
            prefix.append(id)
        }
    }
    var string digest ← parts.get(12) coalesce ""
    if digest ≡ IDENTITY_EMPTY {
        digest ← ""
    }
    const string start_text ← parts.get(13) coalesce ""
    const string next_text ← parts.get(14) coalesce ""
    require _numeric(start_text) throw variant BadWire {message = "malformed start position in prepared identity wire"}
    require _numeric(next_text) throw variant BadWire {message = "malformed next position in prepared identity wire"}
    var int position_start ← 0
    do {
        position_start ↤ start_text
    }
    catch err {
        throw variant BadWire {message = "malformed start position in prepared identity wire"}
    }
    var int position_next ← 0
    do {
        position_next ↤ next_text
    }
    catch err {
        throw variant BadWire {message = "malformed next position in prepared identity wire"}
    }
    require position_next ≡ position_start + prefix.length() throw variant BadWire {message = "inconsistent consumed range in prepared identity wire"}
    return construct(model, model_version, config, tok, prefix, digest, position_start)
}

# =========================================================================
# PP-U2 — typed prepared state (dense KV + architecture-declared state
# families) and payload binding.
#
# The complete prepared-state VALUE: the PP-U1 canonical identity plus
# the dense KV payload (the list<kv.KVCache> / KVCheckpoint family —
# per-layer caches sharing one cache identity and one accepted prefix)
# plus architecture-DECLARED slot families for recurrent / SSM / conv
# state. The declarations carry NO state: no shape, no tensor, no math —
# MODEL-03 (M3-U2) owns the executed state design; hybrid payloads
# populate these slots when that lands (PP-U4b). The dense payload is
# fully constructible today (an empty declaration list is valid).
#
# Semantics:
#   * reset mirrors kv.KVCache.reset — payload cleared, identity and
#     capacity retained, generation advanced by 1 (per-layer caches
#     reset the same way);
#   * copy gives value independence — the copied state owns fresh
#     payload/slot lists, so mutating the copy never touches the
#     original;
#   * payload binding covers canonical identity plus payload
#     shape/content — layers must share one cache identity and one
#     generation, carry exactly the identity's position count, and hold
#     exactly the canonical token history; any mismatch rejects typed
#     (PayloadMismatch) before any attach exists to consume it.
#
# Same architectural rule as PP-U1: no registry, no retention, no auth,
# no tenant, no device handle, no hidden global; no model/dense/
# generation import.
# =========================================================================

# The three declared state families. Names only — deliberately not an
# enum and not shaped: MODEL-03's typed state values (M3-U2) remain the
# sole design authority for what each family carries.
@ public
fn state_family_recurrent() → string {
    return "recurrent"
}

@ public
fn state_family_ssm() → string {
    return "ssm"
}

@ public
fn state_family_conv() → string {
    return "conv"
}

fn _known_state_family(string family) → bool {
    return ((family ≡ state_family_recurrent() or family ≡ state_family_ssm()) or family ≡ state_family_conv())
}

# -------------------------------------------------------------------------
# DeclaredStateSlot — one architecture-declared state-family slot.
# Family name + layer index; nothing else. Declared only (see above).
# -------------------------------------------------------------------------

@ public
class DeclaredStateSlot {
    string family
    int layer

    # The declared family name (recurrent / ssm / conv).
    fn family() → string {
        return self.family
    }

    # The declared layer index that will carry the family's state.
    fn layer() → int {
        return self.layer
    }
}

# -------------------------------------------------------------------------
# PreparedState — the complete typed prepared-state value (PP-U2).
# Immutable value; accessors plus the reset/copy/bind operations below.
# generation starts at 1 and advances on reset (the KVCache.version
# mirror at the whole-state level).
# -------------------------------------------------------------------------

@ public
class PreparedState {
    PreparedIdentity identity
    list<kv.KVCache> kv_layers
    list<DeclaredStateSlot> declared_slots
    int generation

    # The canonical prepared identity (PP-U1).
    fn identity() → PreparedIdentity {
        return self.identity
    }

    # The dense KV payload — one cache per layer (the KVCheckpoint family).
    fn kv_layers() → list<kv.KVCache> {
        return self.kv_layers
    }

    # Payload layer count.
    fn layer_count() → int {
        return self.kv_layers.length()
    }

    # The architecture-declared state-family slots (declared only).
    fn declared_slots() → list<DeclaredStateSlot> {
        return self.declared_slots
    }

    # Declared slot count.
    fn declared_slot_count() → int {
        return self.declared_slots.length()
    }

    # Whole-state generation (starts 1; advances on reset).
    fn generation() → int {
        return self.generation
    }
}

# -------------------------------------------------------------------------
# Private copy/equality helpers (the cache_branch pattern).
# -------------------------------------------------------------------------

fn _copy_kv_layers(list<kv.KVCache> layers) → list<kv.KVCache> {
    var list<kv.KVCache> out ← empty
    for from layers const layer {
        out.append(layer)
    }
    return out
}

fn _copy_slots(list<DeclaredStateSlot> slots) → list<DeclaredStateSlot> {
    var list<DeclaredStateSlot> out ← empty
    for from slots const slot {
        out.append(slot)
    }
    return out
}

fn _slot_list_equal(list<DeclaredStateSlot> a, list<DeclaredStateSlot> b) → bool {
    if a.length() ≠ b.length() then return false
    # legacy-L2: flat list carriers — parallel slot comparison requires indexed access; retain bounded walk.
    for range 0‥a.length() const i {
        const DeclaredStateSlot left ← a.get(i) coalesce DeclaredStateSlot {family = "", layer = 0-1}
        const DeclaredStateSlot right ← b.get(i) coalesce DeclaredStateSlot {family = "", layer = 0-1}
        if left.family() ≠ right.family() then return false
        if left.layer() ≠ right.layer() then return false
    }
    return true
}

# Payload shape/content validation against one canonical identity: at
# least one layer, all layers share one cache identity and one
# generation, every layer carries exactly the identity's position count
# (shape), and every layer's token history is exactly the canonical
# prefix (content).
fn _payload_matches(PreparedIdentity i, list<kv.KVCache> layers) → bool ⇥ PreparedStateError {
    require layers.length() ≥ 1 throw variant PayloadMismatch {message = "prepared state requires at least one KV layer"}
    const kv.KVCache first ← layers.get(0) coalesce kv.default()
    const kv.CacheIdentity identity ← kv.cache_identity(first)
    for from layers const layer {
        require kv.cache_identity_equal(kv.cache_identity(layer), identity) throw variant PayloadMismatch {message = "prepared state layers do not share one cache identity"}
        require layer.version() ≡ first.version() throw variant PayloadMismatch {message = "prepared state layers do not share one generation"}
        require layer.length() ≡ i.length() throw variant PayloadMismatch {message = "payload position count does not match the prepared identity"}
        require _prefix_equal(i.prefix(), layer.history()) throw variant PayloadMismatch {message = "payload token history does not match the prepared identity"}
    }
    return true
}

# -------------------------------------------------------------------------
# construct_state — the fail-closed prepared-state admission. The KV
# payload must bind the canonical identity (shape + content, above);
# declared slots must name a known family, a non-negative layer, and no
# duplicate (family, layer) pair. The state copies its payload and slot
# lists so caller-owned lists are never aliased.
# -------------------------------------------------------------------------

@ public
fn construct_state(PreparedIdentity i, list<kv.KVCache> layers, list<DeclaredStateSlot> slots) → PreparedState ⇥ PreparedStateError {
    _payload_matches(i, layers)
    for from slots const slot {
        require _known_state_family(slot.family()) throw variant PayloadMismatch {message = "unknown declared state family"}
        require slot.layer() ≥ 0 throw variant PayloadMismatch {message = "declared state slot layer below zero"}
    }
    # legacy-L2: flat list carrier — duplicate detection compares indexed slot pairs; retain nested bounded walks.
    for range 0‥slots.length() const a {
        for range 0‥slots.length() const b {
            if a ≠ b {
                const DeclaredStateSlot left ← slots.get(a) coalesce DeclaredStateSlot {family = "", layer = 0-1}
                const DeclaredStateSlot right ← slots.get(b) coalesce DeclaredStateSlot {family = "", layer = 0-1}
                require (left.family() ≠ right.family()) or (left.layer() ≠ right.layer()) throw variant PayloadMismatch {message = "duplicate declared state slot"}
            }
        }
    }
    return PreparedState {identity = i, kv_layers = _copy_kv_layers(layers), declared_slots = _copy_slots(slots), generation = 1}
}

# -------------------------------------------------------------------------
# state_equal — field-wise value equality over identity, payload,
# declared slots, and generation (the PP-U2 equality PP-U3b's
# immutability rows consume).
# -------------------------------------------------------------------------

@ public
fn state_equal(PreparedState a, PreparedState b) → bool {
    if a.generation() ≠ b.generation() then return false
    if not prepared_identity_equal(a.identity(), b.identity()) then return false
    if a.kv_layers().length() ≠ b.kv_layers().length() then return false
    # legacy-L2: flat list carriers — parallel KV-layer equality requires indexed access; retain bounded walk.
    for range 0‥a.kv_layers().length() const i {
        const kv.KVCache left ← a.kv_layers().get(i) coalesce kv.default()
        const kv.KVCache right ← b.kv_layers().get(i) coalesce kv.default()
        if not kv.cache_equal(left, right) then return false
    }
    if not _slot_list_equal(a.declared_slots(), b.declared_slots()) then return false
    return true
}

# -------------------------------------------------------------------------
# copy_state — value independence. The copy owns fresh payload and slot
# lists (identity and per-layer cache values are never mutated in
# place anywhere in this family), so mutating the copy's lists leaves
# the original equal to itself.
# -------------------------------------------------------------------------

@ public
fn copy_state(PreparedState s) → PreparedState {
    return PreparedState {identity = s.identity(), kv_layers = _copy_kv_layers(s.kv_layers()), declared_slots = _copy_slots(s.declared_slots()), generation = s.generation()}
}

# -------------------------------------------------------------------------
# reset_state — the KVCache.reset mirror at the whole-state level: every
# KV layer resets (empty history, empty K/V, identity and immutable
# capacity retained, per-layer generation advanced), declared slots are
# retained (architecture facts, not payload), the canonical identity is
# retained, and the whole-state generation advances by 1. The cleared
# payload therefore no longer binds the retained identity — binding the
# reset state against that identity rejects typed (below), which is the
# intended post-reset contract.
# -------------------------------------------------------------------------

@ public
fn reset_state(PreparedState s) → PreparedState ⇥ PreparedStateError {
    var list<kv.KVCache> cleared ← empty
    for from s.kv_layers() const layer {
        var kv.KVCache fresh ← kv.default()
        do {
            fresh ← kv.reset(layer)
        }
        catch err {
            throw variant PayloadMismatch {message = "prepared KV layer failed to reset"}
        }
        cleared.append(fresh)
    }
    return PreparedState {identity = s.identity(), kv_layers = cleared, declared_slots = _copy_slots(s.declared_slots()), generation = s.generation() + 1}
}

# =========================================================================
# PP-U3a — attach admission: identity + payload-binding reject.
#
# Before any continuation exists to consume a candidate, admit_candidate
# rejects every candidate whose canonical identity (content / model /
# model_version / config / tokenizer / position — the PP-U1 components)
# or whose payload binding (identity + payload shape/content — the PP-U2
# typed state) does not match the request. Every mismatch is a typed
# PreparedStateError and leaves the input snapshot unchanged (the state
# is an immutable value; nothing is cleared, mutated, or retained on
# reject). All-matching candidates pass admission unchanged. The lookup
# digest stays passthrough (never admission-authoritative). Prefix
# selection (U3b) and continuation execution (U4a/U4b) are NOT here.
#
# Same architectural rule: no registry, no retention, no auth, no
# tenant, no device handle, no model/dense/generation import.
# =========================================================================

# -------------------------------------------------------------------------
# admit_candidate — the fail-closed attach admission. Component checks
# are ordered model → model_version → config → tokenizer → content →
# position, each with its own typed rejection message; the payload
# binding (the PP-U2 shape/content contract) is re-checked against the
# request identity last. On success the candidate is returned unchanged.
# -------------------------------------------------------------------------

@ public
fn admit_candidate(PreparedState candidate, PreparedIdentity request) → PreparedState ⇥ PreparedStateError {
    const PreparedIdentity i ← candidate.identity()
    require i.model() ≡ request.model() throw variant PayloadMismatch {message = "attach admission rejects: model mismatch"}
    require i.model_version() ≡ request.model_version() throw variant PayloadMismatch {message = "attach admission rejects: model_version mismatch"}
    require i.config() ≡ request.config() throw variant PayloadMismatch {message = "attach admission rejects: config mismatch"}
    require _tokenizer_equal(i.tokenizer_identity(), request.tokenizer_identity()) throw variant PayloadMismatch {message = "attach admission rejects: tokenizer mismatch"}
    require _prefix_equal(i.prefix(), request.prefix()) throw variant PayloadMismatch {message = "attach admission rejects: content mismatch"}
    require i.position_start() ≡ request.position_start() throw variant PayloadMismatch {message = "attach admission rejects: position mismatch"}
    require i.position_next() ≡ request.position_next() throw variant PayloadMismatch {message = "attach admission rejects: position mismatch"}
    _payload_matches(request, candidate.kv_layers())
    return candidate
}

# -------------------------------------------------------------------------
# bind_payload — the payload binding (PP-U2): bind a prepared state to a
# request's canonical identity. Rejects typed BEFORE any attach exists to
# consume it when (a) the canonical identity does not match the request,
# or (b) the payload's shape/content does not match the identity. On
# success the state is returned unchanged (bound).
# -------------------------------------------------------------------------

@ public
fn bind_payload(PreparedState s, PreparedIdentity request) → PreparedState ⇥ PreparedStateError {
    require prepared_identity_equal(s.identity(), request) throw variant PayloadMismatch {message = "prepared identity does not match the bind request"}
    _payload_matches(request, s.kv_layers())
    return s
}

# =========================================================================
# PP-U3b — longest-prefix attach: selection, tie, independent
# continuation.
#
# attach consumes the caller-declared candidate list (the authorized
# set — candidate authorization policy is NOT here) plus the request's
# canonical identity. Among candidates that bind the request's model /
# model_version / config / tokenizer / start position and whose EXACT
# canonical token prefix is a prefix of the request's canonical token
# sequence (payload bound to the candidate's own identity, per PP-U2),
# attach selects the longest exact prefix. Equal-length ties resolve
# deterministically: the LOWEST declared source order (the earliest
# position in the caller's candidate list) wins, repeatably.
#
# The returned continuation is an independent value: the selected
# candidate's state copied fresh (PP-U2 copy semantics), plus the
# consumed prefix length. The continuation carries the candidate's own
# canonical identity (it consumed exactly that prefix, at the request's
# start position). The candidate snapshots are immutable — nothing in
# this path mutates, clears, resets, or retains any candidate.
#
# Same architectural rule: no registry, no retention, no auth, no
# tenant, no device handle, no model/dense/generation import.
# =========================================================================

# -------------------------------------------------------------------------
# AttachResult — the continuation outcome: the independent continuation
# state plus the consumed prefix length (≡ the continuation identity's
# own prefix length and position_next − position_start).
# -------------------------------------------------------------------------

@ public
class AttachResult {
    PreparedState state
    int consumed

    # The independent continuation state (a fresh copy of the selected
    # candidate; identity = the selected candidate's canonical identity).
    fn state() → PreparedState {
        return self.state
    }

    # The consumed prefix length (exact token count taken from the
    # request's canonical sequence).
    fn consumed() → int {
        return self.consumed
    }
}

# A structurally inert placeholder (never returned; only seeds the
# selection scan below).
fn _attach_placeholder() → PreparedState {
    const tokenizer.TokenizerIdentity inert ← tokenizer.TokenizerIdentity {schema = "", merge_kind = "", pre_tokenizer = "", vocab_digest = "", eog = "", bos_free = false, space_free = false}
    const PreparedIdentity empty_identity ← PreparedIdentity {model = "", model_version = "", config = "", tokenizer_identity = inert, prefix = empty, lookup_digest = "", position_start = 0}
    return PreparedState {identity = empty_identity, kv_layers = empty, declared_slots = empty, generation = 0}
}

# Element-wise exact-prefix predicate: `part` is an exact prefix of
# `whole` (same tokens at every shared position; length ≤).
fn _is_prefix_of(list<int> part, list<int> whole) → bool {
    if part.length() ≻ whole.length() then return false
    # legacy-L2: flat list carriers — prefix comparison requires aligned indexed access; retain bounded walk.
    for range 0‥part.length() const i {
        if (part.get(i) coalesce 0) ≠ (whole.get(i) coalesce 0) then return false
    }
    return true
}

# The PP-U2 payload binding as a predicate (the candidate's payload must
# bind the candidate's OWN canonical identity — never the request's,
# which may carry a longer prefix).
fn _payload_bound(PreparedState s) → bool {
    do {
        _payload_matches(s.identity(), s.kv_layers())
        return true
    }
    catch err {
        return false
    }
}

# One candidate is attachable to the request when every identity
# component except content matches exactly (model → model_version →
# config → tokenizer → start position — the U3a component order), the
# candidate's canonical tokens are an exact prefix of the request's
# canonical tokens, and the payload binds the candidate's own identity.
# The lookup digest stays passthrough (never selection-authoritative).
fn _attachable(PreparedState candidate, PreparedIdentity request) → bool {
    const PreparedIdentity i ← candidate.identity()
    if i.model() ≠ request.model() then return false
    if i.model_version() ≠ request.model_version() then return false
    if i.config() ≠ request.config() then return false
    if not _tokenizer_equal(i.tokenizer_identity(), request.tokenizer_identity()) then return false
    if i.position_start() ≠ request.position_start() then return false
    if not _is_prefix_of(i.prefix(), request.prefix()) then return false
    return _payload_bound(candidate)
}

# -------------------------------------------------------------------------
# attach — the longest-exact-prefix selection. Scans the caller's
# declared order; replaces the best candidate only on a STRICTLY longer
# exact prefix, so equal-length ties keep the lowest declared source
# order and repeated calls repeat the same selection. Rejects typed
# when no candidate is attachable. The returned state is a fresh copy
# (independent continuation); no candidate is touched.
# -------------------------------------------------------------------------

@ public
fn attach(list<PreparedState> candidates, PreparedIdentity request) → AttachResult ⇥ PreparedStateError {
    require candidates.length() ≥ 1 throw variant PayloadMismatch {message = "attach requires at least one declared candidate"}
    var bool found ← false
    var int best_len ← 0
    var PreparedState best ← _attach_placeholder()
    for from candidates const candidate {
        if _attachable(candidate, request) {
            const int len ← candidate.identity().length()
            if (not found) or (len ≻ best_len) {
                found ← true
                best_len ← len
                best ← candidate
            }
        }
    }
    require found throw variant PayloadMismatch {message = "attach found no prepared prefix of the request"}
    return AttachResult {state = copy_state(best), consumed = best_len}
}

# =========================================================================
# PP-U4a — dense continuation compose seam (suffix-only warm run → the
# complete NEXT prepared state).
#
# continue_state composes the next prepared state from a prepared state,
# the continuation suffix, and the dense seam's updated per-layer payload
# (the decode_block output over the suffix). Running the suffix is the
# CALLER's step: this leaf imports no model/dense/generation surface
# (the architectural rule above holds), so the seam stays a pure compose
# over typed payloads.
#
# Fail-closed on: empty suffix, a negative suffix token id, a layer-count
# mismatch, an unbound base payload, a layer that does not carry the
# prepared cache identity, or a payload that does not extend the prepared
# prefix by exactly the suffix (length and token history both bind). The
# next state's canonical identity extends the base prefix by the suffix
# at the same start position (position_next advances by the suffix
# length); the lookup digest stays passthrough (carried unchanged);
# declared slots and whole-state generation are retained (a continuation
# is not a reset); the payload is re-bound to the next identity (the
# PP-U2 shape/content contract). The input state is an immutable value —
# nothing is mutated, cleared, or retained.
# =========================================================================

# Stable cache-identity predicate (model / version / config /
# tokenizer / layer set / dtype / layout): unlike kv.cache_identity this
# excludes history and position, which a continuation legitimately
# extends. Derived per-field — cache_identity itself embeds the token
# history, so it never compares equal across a write.
fn _cache_lineage_equal(kv.KVCache a, kv.KVCache b) → bool {
    if a.model() ≠ b.model() then return false
    if a.model_version() ≠ b.model_version() then return false
    if a.config() ≠ b.config() then return false
    if a.tokenizer() ≠ b.tokenizer() then return false
    if a.layers() ≠ b.layers() then return false
    if a.dtype() ≠ b.dtype() then return false
    if a.layout() ≠ b.layout() then return false
    return true
}

@ public
fn continue_state(PreparedState s, list<int> suffix, list<kv.KVCache> next_layers) → PreparedState ⇥ PreparedStateError {
    require suffix.length() ≥ 1 throw variant PayloadMismatch {message = "continuation suffix must be non-empty"}
    for from suffix const token_id {
        require token_id ≥ 0 throw variant PayloadMismatch {message = "token id below zero in continuation suffix"}
    }
    require next_layers.length() ≡ s.layer_count() throw variant PayloadMismatch {message = "continuation layer count does not match the prepared state"}
    _payload_matches(s.identity(), s.kv_layers())
    var list<int> extended ← empty
    for from s.identity().prefix() const token_id {
        extended.append(token_id)
    }
    for from suffix const token_id {
        extended.append(token_id)
    }
    # legacy-L2: flat list carriers — parallel continuation layers require indexed access; retain bounded walk.
    for range 0‥next_layers.length() const i {
        const kv.KVCache base ← s.kv_layers().get(i) coalesce kv.default()
        const kv.KVCache after ← next_layers.get(i) coalesce kv.default()
        require _cache_lineage_equal(base, after) throw variant PayloadMismatch {message = "continuation layers do not share the prepared cache identity"}
        require after.length() ≡ base.length() + suffix.length() throw variant PayloadMismatch {message = "continuation payload does not extend the prepared prefix"}
        require _prefix_equal(after.history(), extended) throw variant PayloadMismatch {message = "continuation payload does not extend the prepared prefix"}
    }
    const PreparedIdentity next_identity ← construct(s.identity().model(), s.identity().model_version(), s.identity().config(), s.identity().tokenizer_identity(), extended, s.identity().lookup_digest(), s.identity().position_start())
    _payload_matches(next_identity, next_layers)
    return PreparedState {identity = next_identity, kv_layers = _copy_kv_layers(next_layers), declared_slots = _copy_slots(s.declared_slots()), generation = s.generation()}
}
