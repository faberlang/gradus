+++
locale = "en"
+++
# Co-located package test for generation.fab (PML5-U4 —
# generation-configuration contract). Not importable; discovered only by
# the faber test path.
#
# Proves, at compile level:
#   * the nine-field contract: supported values + defaults
#     (generatio_defecta) + validation (fail-closed causa identity per
#     field — the single authority's validation runs at construction AND
#     deserialization).
#   * the deterministic mapping: configura(g) projects the five sampling
#     fields exactly onto the U3 Configura; semen(g) projects the seed
#     onto the U5 Semen — exact pins.
#   * the reject-row matrix: the declared supported surface
#     (imperia_subsidia) admits exactly the nine fields; every
#     llama.cpp-style control outside it is an EXPLICIT reject row
#     (imperium_admissum → false, pinned row by row) — never silently
#     ignored. The versioned wire carries exactly the nine fields; an
#     extra field breaks the parse.
#   * the versioned wire round-trip (exact string + exact field
#     reconstruction) and the fail-closed wire rejections.
#   * determinism — equal configs map to equal Configura/Semen values.
#
# Oracle pins: the mapping is a pure projection, so the pins are EXACT
# (field values, the Configura projection, the Semen status, the exact
# wire form). No executed value is claimed (CTO Q2); the auditor-owned
# runtime-evidence gate compares executed mapping against these pins.
#
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/generation.proba` proves the suite
# type-checks. Execution of proba bodies is env-blocked tree-wide today
# (recorded residual); this suite is the compile-level proof of the
# contract.

import from "gradus:generation" generatio
import from "gradus:sampling" sampling
import from "gradus:train" train
import from "gradus:decode" decode

# ---- helpers (the loss.proba pattern)

# The reference config (context 1024, batch 1, max 128, seed 42,
# temperature 0.8, top-k 5, top-p 0.9, min-p 0.05, penalty 1.2).
fn config_p() → generatio.GenerationConfig {
    var generatio.GenerationConfig g
    do {
        g ← generatio.construct_generation(1024, 1, 128, 42, (0.8 ∷ f32), 5, (0.9 ∷ f32), (0.05 ∷ f32), (1.2 ∷ f32))
    }
    catch err {
        return g
    }
    return g
}

# Renders a construction outcome as textus.
fn structa_detail(int context, int max_prompt, int max_tokens, int seed, f32 temperature, int top_k, f32 top_p, f32 min_p, f32 poena) → string {
    do {
        const generatio.GenerationConfig _ ← generatio.construct_generation(context, max_prompt, max_tokens, seed, temperature, top_k, top_p, min_p, poena)
        return "ok"
    }
    catch err {
        return generatio.message(err)
    }
}

# Renders a wire-deserialization outcome as textus.
fn deserializa_detail(string wire) → string {
    do {
        const generatio.GenerationConfig _ ← generatio.deserialize_generation(wire)
        return "ok"
    }
    catch err {
        return generatio.message(err)
    }
}

# Wire round-trip predicate.
fn roundtrip(generatio.GenerationConfig g) → bool {
    do {
        const generatio.GenerationConfig h ← generatio.deserialize_generation(generatio.serialize_generation(g))
        return generatio.generation_equal(g, h)
    }
    catch err {
        return false
    }
}

# ---- construction: supported values + validation

describe "generation config — construction" {
    test "construct_generation builds the full nine-field config" {
        do {
            const generatio.GenerationConfig g ← config_p()
            assert g.context() ≡ 1024
            assert g.max_prompt() ≡ 1
            assert g.max_tokens() ≡ 128
            assert g.seed() ≡ 42
            assert g.temperature() ≡ (0.8 ∷ f32)
            assert g.top_k() ≡ 5
            assert g.top_p() ≡ (0.9 ∷ f32)
            assert g.min_p() ≡ (0.05 ∷ f32)
            assert g.repetition_penalty() ≡ (1.2 ∷ f32)
        }
        catch err {
            assert false
        }
    }
    test "generation_failure gives the neutral sampling defaults" {
        do {
            const generatio.GenerationConfig g ← generatio.generation_failure(1024, 1, 128, 42)
            assert g.context() ≡ 1024
            assert g.max_prompt() ≡ 1
            assert g.max_tokens() ≡ 128
            assert g.seed() ≡ 42
            assert g.temperature() ≡ (1.0 ∷ f32)
            assert g.top_k() ≡ 0
            assert g.top_p() ≡ (1.0 ∷ f32)
            assert g.min_p() ≡ (0.0 ∷ f32)
            assert g.repetition_penalty() ≡ (1.0 ∷ f32)
        }
        catch err {
            assert false
        }
    }
    test "the per-field validation fails closed" {
        assert structa_detail(0, 1, 128, 42, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "context length must be at least one"
        assert structa_detail(1024, 0, 128, 42, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "prompt batch size must be at least one"
        assert structa_detail(1024, 1, 0, 42, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "maximum generated tokens must be at least one"
        assert structa_detail(64, 1, 128, 42, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "maximum generated tokens must fit within the context"
        assert structa_detail(1024, 1, 128, 0, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "seed must be at least one"
        assert structa_detail(1024, 1, 128, 42, (0.0 - 1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "temperature must be non-negative"
        assert structa_detail(1024, 1, 128, 42, (1.0 ∷ f32), 0 - 1, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "top-k must be non-negative"
        assert structa_detail(1024, 1, 128, 42, (1.0 ∷ f32), 0, (1.5 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "top-p must be within [0, 1]"
        assert structa_detail(1024, 1, 128, 42, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 - 0.1 ∷ f32), (1.0 ∷ f32)) ≡ "min-p must be within [0, 1]"
        assert structa_detail(1024, 1, 128, 42, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (0.9 ∷ f32)) ≡ "repetition penalty must be at least one"
    }
}

# ---- the deterministic mapping (exact pins)

describe "generation config — deterministic mapping" {
    test "config projects the five sampling fields exactly onto the U3 Config" {
        do {
            const sampling.Config c ← generatio.config(config_p())
            assert c.temperature() ≡ (0.8 ∷ f32)
            assert c.top_k() ≡ 5
            assert c.top_p() ≡ (0.9 ∷ f32)
            assert c.min_p() ≡ (0.05 ∷ f32)
            assert c.repetition_penalty() ≡ (1.2 ∷ f32)
        }
        catch err {
            assert false
        }
    }
    test "seed projects the seed exactly onto the U5 Semen" {
        do {
            const train.Seed s ← generatio.seed(config_p())
            assert s.status() ≡ 42
        }
        catch err {
            assert false
        }
    }
    test "the mapping is deterministic (equal configs map to equal values)" {
        do {
            const sampling.Config a ← generatio.config(config_p())
            const sampling.Config b ← generatio.config(config_p())
            const train.Seed s1 ← generatio.seed(config_p())
            const train.Seed s2 ← generatio.seed(config_p())
            assert a.temperature() ≡ b.temperature()
            assert s1.status() ≡ s2.status()
        }
        catch err {
            assert false
        }
    }
}

# ---- the reject-row matrix (single authority — never silently ignored)

describe "generation config — supported surface and reject rows" {
    test "support_flags declares exactly the nine supported fields" {
        do {
            const list<string> subsidia ← generatio.support_flags()
            assert subsidia.length() ≡ 9
            assert generatio.admitted_features("context")
            assert generatio.admitted_features("max_prompt")
            assert generatio.admitted_features("max_tokens")
            assert generatio.admitted_features("seed")
            assert generatio.admitted_features("temperature")
            assert generatio.admitted_features("top_k")
            assert generatio.admitted_features("top_p")
            assert generatio.admitted_features("min_p")
            assert generatio.admitted_features("repetition_penalty")
        }
        catch err {
            assert false
        }
    }
    test "unsupported llama.cpp-style controls are EXPLICIT reject rows" {
        assert not (generatio.admitted_features("repeat_last_n"))
        assert not (generatio.admitted_features("presence_penalty"))
        assert not (generatio.admitted_features("frequency_penalty"))
        assert not (generatio.admitted_features("mirostat"))
        assert not (generatio.admitted_features("grammar"))
        assert not (generatio.admitted_features("json_schema"))
        assert not (generatio.admitted_features("logit_bias"))
        assert not (generatio.admitted_features("typical_p"))
        assert not (generatio.admitted_features("tfs_z"))
        assert not (generatio.admitted_features("samplers"))
        assert not (generatio.admitted_features("penalize_nl"))
        assert not (generatio.admitted_features("logprobs"))
    }
}

# ---- the versioned wire

describe "generation config — versioned wire" {
    test "the wire round-trips exactly and matches the exact form" {
        do {
            const generatio.GenerationConfig g ← config_p()
            assert roundtrip(g)
            assert generatio.serialize_generation(g) ≡ "generation/config/1.0.0/1024/1/128/42/0.8/5/0.9/0.05/1.2"
        }
        catch err {
            assert false
        }
    }
    test "the wire rejects unknown markers, schema, malformed fields, and extra fields" {
        assert deserializa_detail("tensor/config/1.0.0/1024/1/128/42/0.8/5/0.9/0.05/1.2") ≡ "unknown generation marker"
        assert deserializa_detail("generation/config/9.9.9/1024/1/128/42/0.8/5/0.9/0.05/1.2") ≡ "unknown generation schema version"
        assert deserializa_detail("generation/config/1.0.0/1024/1/128/42/0.8/5/0.9/0.05") ≡ "malformed generation config wire"
        assert deserializa_detail("generation/config/1.0.0/1024/1/128/42/0.8/5/0.9/0.05/1.2/extra") ≡ "malformed generation config wire"
        assert deserializa_detail("generation/config/1.0.0/0/1/128/42/0.8/5/0.9/0.05/1.2") ≡ "context length must be at least one"
        assert deserializa_detail("generation/config/1.0.0/1024/1/128/0/0.8/5/0.9/0.05/1.2") ≡ "seed must be at least one"
        assert deserializa_detail("generation/config/1.0.0/1024/1/128/42/not-a-float/5/0.9/0.05/1.2") ≡ "malformed temperature in generation wire"
    }
    test "a deserialized config re-validates every field (the single authority)" {
        do {
            # An out-of-range field in the wire fails closed at structa.
            assert deserializa_detail("generation/config/1.0.0/64/1/128/42/0.8/5/0.9/0.05/1.2") ≡ "maximum generated tokens must fit within the context"
        }
        catch err {
            assert false
        }
    }
}

# =========================================================================
# PML5-U5 — the generation cursor (context-limit wiring, reject policy)
# =========================================================================

# ---- helpers

# The pinned generation config: context 4, prompt batch 1, max tokens 2,
# seed A, neutral sampling defaults.
fn config_g() → generatio.GenerationConfig {
    var generatio.GenerationConfig g
    do {
        g ← generatio.construct_generation(4, 1, 2, 1234567890123456789, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32))
        return g
    }
    catch err {
        return g
    }
    return g
}

# A fresh cursor (swallow never-firing errors).
fn cursor_fresh_p(generatio.GenerationConfig g) → generatio.GenerationCursor {
    var generatio.GenerationCursor c
    do {
        c ← generatio.fresh_cursor(g)
        return c
    }
    catch err {
        return c
    }
    return c
}

# Renders a cursor-advance outcome as textus.
fn progredere_detail(generatio.GenerationConfig g, generatio.GenerationCursor c) → string {
    do {
        const generatio.GenerationCursor _ ← generatio.cursor_advance(g, c)
        return "ok"
    }
    catch err {
        return generatio.message(err)
    }
}

# ---- the cursor: reset, limits, policy

describe "generation — the cursor (PML5-U5 context-limit wiring)" {
    test "fresh_cursor starts at position 0 with count 0 over the config context" {
        do {
            const generatio.GenerationCursor c ← cursor_fresh_p(config_g())
            assert c.session().position() ≡ 0
            assert c.session().context() ≡ 4
            assert c.emitted() ≡ 0
        }
        catch err {
            assert false
        }
    }
    test "cursor_advance advances the position and the count together" {
        do {
            const generatio.GenerationCursor c0 ← cursor_fresh_p(config_g())
            const generatio.GenerationCursor c1 ← generatio.cursor_advance(config_g(), c0)
            assert c1.session().position() ≡ 1
            assert c1.emitted() ≡ 1
        }
        catch err {
            assert false
        }
    }
    test "token_allowed is true within the limits and false at the max-tokens limit" {
        do {
            const generatio.GenerationCursor c0 ← cursor_fresh_p(config_g())
            const generatio.GenerationCursor c1 ← generatio.cursor_advance(config_g(), c0)
            const generatio.GenerationCursor c2 ← generatio.cursor_advance(config_g(), c1)
            assert generatio.token_allowed(config_g(), c0) ≡ true
            assert generatio.token_allowed(config_g(), c1) ≡ true
            # c2 has prolata 2 == maxima_verborum 2 -> not allowed.
            assert generatio.token_allowed(config_g(), c2) ≡ false
        }
        catch err {
            assert false
        }
    }
    test "cursor_advance REJECTS at the max-tokens limit (reject, never truncate)" {
        do {
            const generatio.GenerationCursor c0 ← cursor_fresh_p(config_g())
            const generatio.GenerationCursor c1 ← generatio.cursor_advance(config_g(), c0)
            const generatio.GenerationCursor c2 ← generatio.cursor_advance(config_g(), c1)
            assert progredere_detail(config_g(), c2) ≡ "maximum generated tokens reached"
        }
        catch err {
            assert false
        }
    }
    test "cursor_advance REJECTS at the context limit (the defensive guard)" {
        do {
            # A boundary state: position == contextus 4 with the count below
            # the max-tokens limit. With maxima <= contextus (the U4
            # validation) the max-tokens bound is the binding constraint in
            # ordinary progression; the context rejection is the fail-closed
            # guard and is probe-pinned at this boundary state.
            const generatio.GenerationCursor at_limit ← generatio.GenerationCursor { session = decode.Session { position = 4, context = 4 }, emitted = 0 }
            assert progredere_detail(config_g(), at_limit) ≡ "context limit reached"
        }
        catch err {
            assert false
        }
    }
    test "cursor_reset resets the cursor to the fresh state (context preserved)" {
        do {
            const generatio.GenerationCursor c0 ← cursor_fresh_p(config_g())
            const generatio.GenerationCursor c1 ← generatio.cursor_advance(config_g(), c0)
            const generatio.GenerationCursor r ← generatio.cursor_reset(c1)
            assert r.session().position() ≡ 0
            assert r.session().context() ≡ 4
            assert r.emitted() ≡ 0
        }
        catch err {
            assert false
        }
    }
}
