# Co-located package test for generation.fab (PML5-U4 —
# generation-configuration contract). Not importable; discovered only by
# the faber test path.
#
# Proves, at compile level:
#   * the nine-field contract: supported values + defaults
#     (generatio_defecta) + validation (fail-closed causa identity per
#     field — the single authority's validation runs at construction AND
#     deserialization).
#   * the deterministic mapping: configura(g) projects the five sampling
#     fields exactly onto the U3 Configura; semen(g) projects the seed
#     onto the U5 Semen — exact pins.
#   * the reject-row matrix: the declared supported surface
#     (imperia_subsidia) admits exactly the nine fields; every
#     llama.cpp-style control outside it is an EXPLICIT reject row
#     (imperium_admissum → false, pinned row by row) — never silently
#     ignored. The versioned wire carries exactly the nine fields; an
#     extra field breaks the parse.
#   * the versioned wire round-trip (exact string + exact field
#     reconstruction) and the fail-closed wire rejections.
#   * determinism — equal configs map to equal Configura/Semen values.
#
# Oracle pins: the mapping is a pure projection, so the pins are EXACT
# (field values, the Configura projection, the Semen status, the exact
# wire form). No executed value is claimed (CTO Q2); the auditor-owned
# runtime-evidence gate compares executed mapping against these pins.
#
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/generation.proba` proves the suite
# type-checks. Execution of proba bodies is env-blocked tree-wide today
# (recorded residual); this suite is the compile-level proof of the
# contract.

importa ex "gradus:generation" generatio
importa ex "gradus:sampling" sampling
importa ex "gradus:train" train
importa ex "gradus:decode" decode

# ---- helpers (the loss.proba pattern)

# The reference config (context 1024, batch 1, max 128, seed 42,
# temperature 0.8, top-k 5, top-p 0.9, min-p 0.05, penalty 1.2).
functio config_p() → generatio.GeneratioConfigura {
    varia generatio.GeneratioConfigura g
    fac {
        g ← generatio.structa_generatio(1024, 1, 128, 42,
                                        (0.8 ∷ f32), 5, (0.9 ∷ f32), (0.05 ∷ f32), (1.2 ∷ f32))
    }
    cape err {
        redde g
    }
    redde g
}

# Renders a construction outcome as textus.
functio structa_detail(numerus contextus, numerus magna_promptus, numerus maxima_verborum, numerus semen, f32 temperatura, numerus top_k, f32 top_p, f32 min_p, f32 poena) → textus {
    fac {
        fixum generatio.GeneratioConfigura _ ← generatio.structa_generatio(contextus, magna_promptus, maxima_verborum, semen, temperatura, top_k, top_p, min_p, poena)
        redde "ok"
    }
    cape err {
        redde generatio.causa(err)
    }
}

# Renders a wire-deserialization outcome as textus.
functio deserializa_detail(textus wire) → textus {
    fac {
        fixum generatio.GeneratioConfigura _ ← generatio.deserializa_generatio(wire)
        redde "ok"
    }
    cape err {
        redde generatio.causa(err)
    }
}

# Wire round-trip predicate.
functio roundtrip(generatio.GeneratioConfigura g) → bivalens {
    fac {
        fixum generatio.GeneratioConfigura h ← generatio.deserializa_generatio(generatio.serializa_generatio(g))
        redde generatio.generatio_aequus(g, h)
    }
    cape err {
        redde falsum
    }
}

# ---- construction: supported values + validation

probandum "generation config — construction" {
    proba "structa_generatio builds the full nine-field config" {
        fac {
            fixum generatio.GeneratioConfigura g ← config_p()
            adfirma g.contextus() ≡ 1024
            adfirma g.magna_promptus() ≡ 1
            adfirma g.maxima_verborum() ≡ 128
            adfirma g.semen() ≡ 42
            adfirma g.temperatura() ≡ (0.8 ∷ f32)
            adfirma g.top_k() ≡ 5
            adfirma g.top_p() ≡ (0.9 ∷ f32)
            adfirma g.min_p() ≡ (0.05 ∷ f32)
            adfirma g.poena_repetitionis() ≡ (1.2 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "generatio_defecta gives the neutral sampling defaults" {
        fac {
            fixum generatio.GeneratioConfigura g ← generatio.generatio_defecta(1024, 1, 128, 42)
            adfirma g.contextus() ≡ 1024
            adfirma g.magna_promptus() ≡ 1
            adfirma g.maxima_verborum() ≡ 128
            adfirma g.semen() ≡ 42
            adfirma g.temperatura() ≡ (1.0 ∷ f32)
            adfirma g.top_k() ≡ 0
            adfirma g.top_p() ≡ (1.0 ∷ f32)
            adfirma g.min_p() ≡ (0.0 ∷ f32)
            adfirma g.poena_repetitionis() ≡ (1.0 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the per-field validation fails closed" {
        adfirma structa_detail(0, 1, 128, 42, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "context length must be at least one"
        adfirma structa_detail(1024, 0, 128, 42, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "prompt batch size must be at least one"
        adfirma structa_detail(1024, 1, 0, 42, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "maximum generated tokens must be at least one"
        adfirma structa_detail(64, 1, 128, 42, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "maximum generated tokens must fit within the context"
        adfirma structa_detail(1024, 1, 128, 0, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "seed must be at least one"
        adfirma structa_detail(1024, 1, 128, 42, (0.0 - 1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "temperature must be non-negative"
        adfirma structa_detail(1024, 1, 128, 42, (1.0 ∷ f32), 0 - 1, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "top-k must be non-negative"
        adfirma structa_detail(1024, 1, 128, 42, (1.0 ∷ f32), 0, (1.5 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32)) ≡ "top-p must be within [0, 1]"
        adfirma structa_detail(1024, 1, 128, 42, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 - 0.1 ∷ f32), (1.0 ∷ f32)) ≡ "min-p must be within [0, 1]"
        adfirma structa_detail(1024, 1, 128, 42, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (0.9 ∷ f32)) ≡ "repetition penalty must be at least one"
    }
}

# ---- the deterministic mapping (exact pins)

probandum "generation config — deterministic mapping" {
    proba "configura projects the five sampling fields exactly onto the U3 Configura" {
        fac {
            fixum sampling.Configura c ← generatio.configura(config_p())
            adfirma c.temperatura() ≡ (0.8 ∷ f32)
            adfirma c.top_k() ≡ 5
            adfirma c.top_p() ≡ (0.9 ∷ f32)
            adfirma c.min_p() ≡ (0.05 ∷ f32)
            adfirma c.poena_repetitionis() ≡ (1.2 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "semen projects the seed exactly onto the U5 Semen" {
        fac {
            fixum train.Semen s ← generatio.semen(config_p())
            adfirma s.status() ≡ 42
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the mapping is deterministic (equal configs map to equal values)" {
        fac {
            fixum sampling.Configura a ← generatio.configura(config_p())
            fixum sampling.Configura b ← generatio.configura(config_p())
            fixum train.Semen s1 ← generatio.semen(config_p())
            fixum train.Semen s2 ← generatio.semen(config_p())
            adfirma a.temperatura() ≡ b.temperatura()
            adfirma s1.status() ≡ s2.status()
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- the reject-row matrix (single authority — never silently ignored)

probandum "generation config — supported surface and reject rows" {
    proba "imperia_subsidia declares exactly the nine supported fields" {
        fac {
            fixum lista<textus> subsidia ← generatio.imperia_subsidia()
            adfirma subsidia.longitudo() ≡ 9
            adfirma generatio.imperium_admissum("contextus")
            adfirma generatio.imperium_admissum("magna_promptus")
            adfirma generatio.imperium_admissum("maxima_verborum")
            adfirma generatio.imperium_admissum("semen")
            adfirma generatio.imperium_admissum("temperatura")
            adfirma generatio.imperium_admissum("top_k")
            adfirma generatio.imperium_admissum("top_p")
            adfirma generatio.imperium_admissum("min_p")
            adfirma generatio.imperium_admissum("poena_repetitionis")
        }
        cape err {
            adfirma falsum
        }
    }

    proba "unsupported llama.cpp-style controls are EXPLICIT reject rows" {
        adfirma non (generatio.imperium_admissum("repeat_last_n"))
        adfirma non (generatio.imperium_admissum("presence_penalty"))
        adfirma non (generatio.imperium_admissum("frequency_penalty"))
        adfirma non (generatio.imperium_admissum("mirostat"))
        adfirma non (generatio.imperium_admissum("grammar"))
        adfirma non (generatio.imperium_admissum("json_schema"))
        adfirma non (generatio.imperium_admissum("logit_bias"))
        adfirma non (generatio.imperium_admissum("typical_p"))
        adfirma non (generatio.imperium_admissum("tfs_z"))
        adfirma non (generatio.imperium_admissum("samplers"))
        adfirma non (generatio.imperium_admissum("penalize_nl"))
        adfirma non (generatio.imperium_admissum("logprobs"))
    }
}

# ---- the versioned wire

probandum "generation config — versioned wire" {
    proba "the wire round-trips exactly and matches the exact form" {
        fac {
            fixum generatio.GeneratioConfigura g ← config_p()
            adfirma roundtrip(g)
            adfirma generatio.serializa_generatio(g) ≡ "generation/config/1.0.0/1024/1/128/42/0.8/5/0.9/0.05/1.2"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the wire rejects unknown markers, schema, malformed fields, and extra fields" {
        adfirma deserializa_detail("tensor/config/1.0.0/1024/1/128/42/0.8/5/0.9/0.05/1.2") ≡ "unknown generation marker"
        adfirma deserializa_detail("generation/config/9.9.9/1024/1/128/42/0.8/5/0.9/0.05/1.2") ≡ "unknown generation schema version"
        adfirma deserializa_detail("generation/config/1.0.0/1024/1/128/42/0.8/5/0.9/0.05") ≡ "malformed generation config wire"
        adfirma deserializa_detail("generation/config/1.0.0/1024/1/128/42/0.8/5/0.9/0.05/1.2/extra") ≡ "malformed generation config wire"
        adfirma deserializa_detail("generation/config/1.0.0/0/1/128/42/0.8/5/0.9/0.05/1.2") ≡ "context length must be at least one"
        adfirma deserializa_detail("generation/config/1.0.0/1024/1/128/0/0.8/5/0.9/0.05/1.2") ≡ "seed must be at least one"
        adfirma deserializa_detail("generation/config/1.0.0/1024/1/128/42/not-a-float/5/0.9/0.05/1.2") ≡ "malformed temperature in generation wire"
    }

    proba "a deserialized config re-validates every field (the single authority)" {
        fac {
            # An out-of-range field in the wire fails closed at structa.
            adfirma deserializa_detail("generation/config/1.0.0/64/1/128/42/0.8/5/0.9/0.05/1.2") ≡ "maximum generated tokens must fit within the context"
        }
        cape err {
            adfirma falsum
        }
    }
}

# =========================================================================
# PML5-U5 — the generation cursor (context-limit wiring, reject policy)
# =========================================================================

# ---- helpers

# The pinned generation config: context 4, prompt batch 1, max tokens 2,
# seed A, neutral sampling defaults.
functio config_g() → generatio.GeneratioConfigura {
    varia generatio.GeneratioConfigura g
    fac {
        g ← generatio.structa_generatio(4, 1, 2, 1234567890123456789, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32))
        redde g
    }
    cape err {
        redde g
    }
    redde g
}

# A fresh cursor (swallow never-firing errors).
functio cursor_fresh_p(generatio.GeneratioConfigura g) → generatio.GenereCursor {
    varia generatio.GenereCursor c
    fac {
        c ← generatio.cursor_fresh(g)
        redde c
    }
    cape err {
        redde c
    }
    redde c
}

# Renders a cursor-advance outcome as textus.
functio progredere_detail(generatio.GeneratioConfigura g, generatio.GenereCursor c) → textus {
    fac {
        fixum generatio.GenereCursor _ ← generatio.cursor_progredere(g, c)
        redde "ok"
    }
    cape err {
        redde generatio.causa(err)
    }
}

# ---- the cursor: reset, limits, policy

probandum "generation — the cursor (PML5-U5 context-limit wiring)" {
    proba "cursor_fresh starts at position 0 with count 0 over the config context" {
        fac {
            fixum generatio.GenereCursor c ← cursor_fresh_p(config_g())
            adfirma c.sessio().positio() ≡ 0
            adfirma c.sessio().contextus() ≡ 4
            adfirma c.prolata() ≡ 0
        }
        cape err {
            adfirma falsum
        }
    }

    proba "cursor_progredere advances the position and the count together" {
        fac {
            fixum generatio.GenereCursor c0 ← cursor_fresh_p(config_g())
            fixum generatio.GenereCursor c1 ← generatio.cursor_progredere(config_g(), c0)
            adfirma c1.sessio().positio() ≡ 1
            adfirma c1.prolata() ≡ 1
        }
        cape err {
            adfirma falsum
        }
    }

    proba "verbum_licet is true within the limits and false at the max-tokens limit" {
        fac {
            fixum generatio.GenereCursor c0 ← cursor_fresh_p(config_g())
            fixum generatio.GenereCursor c1 ← generatio.cursor_progredere(config_g(), c0)
            fixum generatio.GenereCursor c2 ← generatio.cursor_progredere(config_g(), c1)
            adfirma generatio.verbum_licet(config_g(), c0) ≡ verum
            adfirma generatio.verbum_licet(config_g(), c1) ≡ verum
            # c2 has prolata 2 == maxima_verborum 2 -> not allowed.
            adfirma generatio.verbum_licet(config_g(), c2) ≡ falsum
        }
        cape err {
            adfirma falsum
        }
    }

    proba "cursor_progredere REJECTS at the max-tokens limit (reject, never truncate)" {
        fac {
            fixum generatio.GenereCursor c0 ← cursor_fresh_p(config_g())
            fixum generatio.GenereCursor c1 ← generatio.cursor_progredere(config_g(), c0)
            fixum generatio.GenereCursor c2 ← generatio.cursor_progredere(config_g(), c1)
            adfirma progredere_detail(config_g(), c2) ≡ "maximum generated tokens reached"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "cursor_progredere REJECTS at the context limit (the defensive guard)" {
        fac {
            # A boundary state: position == contextus 4 with the count below
            # the max-tokens limit. With maxima <= contextus (the U4
            # validation) the max-tokens bound is the binding constraint in
            # ordinary progression; the context rejection is the fail-closed
            # guard and is probe-pinned at this boundary state.
            fixum generatio.GenereCursor at_limit ← generatio.GenereCursor { sessio = decode.Sessio { positio = 4, contextus = 4 }, prolata = 0 }
            adfirma progredere_detail(config_g(), at_limit) ≡ "context limit reached"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "cursor_redintegra resets the cursor to the fresh state (context preserved)" {
        fac {
            fixum generatio.GenereCursor c0 ← cursor_fresh_p(config_g())
            fixum generatio.GenereCursor c1 ← generatio.cursor_progredere(config_g(), c0)
            fixum generatio.GenereCursor r ← generatio.cursor_redintegra(c1)
            adfirma r.sessio().positio() ≡ 0
            adfirma r.sessio().contextus() ≡ 4
            adfirma r.prolata() ≡ 0
        }
        cape err {
            adfirma falsum
        }
    }
}
