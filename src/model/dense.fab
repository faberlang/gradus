+++
locale = "en"
+++
# REF-01-U1.8 — dense model assembly (gradus:model/dense).
#
# Public import: import from "gradus:model/dense" dense
# Depends on: gradus:attention (RopeConfig), gradus:tensor (staged
#   carrier), gradus:transformer (dense_block, REF-01-U1.5), gradus:nn
#   (rmsnorm / linear rows, REF-01-U1.1 / the PML3 surface).
#
# The complete ordered dense forward graph:
#   embedding gather → N ordered U1.5 blocks → final RMSNorm → output
#   projection,
# assembled from the typed architecture config and materialized tensor
# views via canonical names. The caller supplies a resolver (`source`) that
# returns the materialized STORED-weight view for one canonical tensor name
# (model.embed_tokens, model.layers.{N}.input_layernorm,
# .self_attn.{q,k,v,o}_proj, optional .self_attn.{q,k,v}_proj.bias,
# .post_attention_layernorm, .mlp.{gate,up,down}_proj,
# model.norm, lm_head) plus a layer index — the GGUF/A1b descriptor layout
# (token_embd.weight is [D, V] in the GGUF/ggml descriptor — dim0 = D
# innermost, so the stored f32 buffer is already token-major). The
# assembly gathers at index [token * D + d] without a data transpose, and
# materializes a true row-major [D, V] only for a TIED lm_head; an UNTIED
# row resolves lm_head separately. Zero per-row special-case constants:
# every shape derives from the config and the runtime tensors.
#
# Fails closed with typed diagnostics on: an unknown/missing canonical
# tensor (resolver throw → MissingTensor), an invalid
# architecture config (BadConfig), a shape that contradicts the config
# (BadShape), and token ids outside the embedding vocabulary
# (TerminusExcedit). Sub-call errors from nn / transformer / tensor are
# mapped into BadShape preserving the documented message text.
#
# The F32 row is the admitted row (the composed rows' contract). The
# surface is forward-only: no autograd import, no gradient path.

import from "gradus:attention" attention

import from "gradus:cache" kv

import from "gradus:nn" nn

import from "gradus:tensor" tensor

import from "gradus:transformer" transformer

# -------------------------------------------------------------------------
# DenseConfig — the typed dense architecture config the assembly is
# built from. `ligatum` records tied embeddings (lm_head shares the
# embedding tensor). No per-row constants: the head counts and dims are
# carried here and every shape is validated against them.
# -------------------------------------------------------------------------


@ public { }
class DenseConfig {
    int layers
    int heads
    int kv_heads
    int head_dim
    int hidden_dim
    int vocab
    bool tied
}

# Resolver: (string, int) → tensor.Tensor ⇥ DenseError. Success returns the
# materialized stored-weight view; throw is MissingTensor (or another
# DenseError). Optional Q/K/V bias lookups catch a throw and keep the
# zero-bias contract.

# -------------------------------------------------------------------------
# DenseError — typed error vocabulary of the dense assembly. Every variant
# carries a text message (render via message).
# -------------------------------------------------------------------------


@ public { }
union DenseError {
    MissingTensor {
        string message
    },
    BadConfig {
        string message
    },
    BadShape {
        string message
    },
    TerminusExcedit {
        string message
    }
}

@ public { }
fn message(DenseError e) → string {
    match e {
        case MissingTensor const message {
            return message
        }
        case BadConfig const message {
            return message
        }
        case BadShape const message {
            return message
        }
        case TerminusExcedit const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# Private helpers — each wraps a primitive sub-call or an assembly step and
# maps its failure into DenseError preserving the documented message text.
# -------------------------------------------------------------------------

# Resolve one canonical tensor; a resolver throw is the DenseError channel.
@ private { }
fn _source((string, int) → tensor.Tensor ⇥ DenseError source, string name, int layer) → tensor.Tensor ⇥ DenseError {
    return source(name, layer)
}

# Shape render for diagnostics (no lista→text cast exists).
@ private { }
fn _shape_text(list<int> f) → string {
    var string out ← ""
    const int n ← f.length()
    var int i ← 0
    while i ≺ n {
        if i ≻ 0 {
            out ← out + ","
        }
        out ← out + (f.get(i) coalesce 0 ↦ string)
        i ← i + 1
    }
    return out
}

# Validate a canonical tensor's runtime shape against the config-derived
# expectation; passes the tensor through on success.
@ private { }
fn _shape(tensor.Tensor t, string name, list<int> expected) → tensor.Tensor ⇥ DenseError {
    const list<int> f ← t.shape()
    require f ≡ expected throw variant BadShape {message = (((("canonical tensor " + name) + " has shape ") + _shape_text(f)) + ", expected ") + _shape_text(expected)}
    return t
}

# Reinterpret a stored [D, V] ggml embedding as token-major [V, D] without
# permuting data. GGUF dim0 = D is innermost, so the flat buffer is already
# data[token * D + d].
@ private { }
fn _token_major_view(tensor.Tensor t) → tensor.Tensor ⇥ DenseError {
    const list<int> f ← t.shape()
    require f.length() ≡ 2 throw variant BadShape {message = "embedding must be rank 2"}
    const int hidden ← f.get(0) coalesce 1
    const int vocab ← f.get(1) coalesce 1
    do {
        return tensor.construct(t.data, [vocab, hidden])
    }
    catch err {
        throw variant BadShape {message = tensor.message(err)}
    }
}

# Rank-2 transpose [rows, cols] → [cols, rows] (math has no transpose; a
# TIED lm_head needs the true row-major [D, V] from the token-major view).
@ private { }
fn _transpose(tensor.Tensor t) → tensor.Tensor ⇥ DenseError {
    const list<int> f ← t.shape()
    require f.length() ≡ 2 throw variant BadShape {message = "embedding must be rank 2"}
    const int rows ← f.get(0) coalesce 1
    const int cols ← f.get(1) coalesce 1
    var list<f32> out ← empty
    var int j ← 0
    while j ≺ cols {
        var int i ← 0
        while i ≺ rows {
            out.append(t.data.get(i * cols + j) coalesce 0.0 ∷ f32)
            i ← i + 1
        }
        j ← j + 1
    }
    do {
        return tensor.construct(out, [cols, rows])
    }
    catch err {
        throw variant BadShape {message = tensor.message(err)}
    }
}

# Embedding gather: token-major embed [V, D] → rows for the token ids.
@ private { }
fn _collect(tensor.Tensor embed, list<int> tokens) → tensor.Tensor ⇥ DenseError {
    const list<int> fe ← embed.shape()
    require fe.length() ≡ 2 throw variant BadShape {message = "embedding must be rank 2"}
    const int v ← fe.get(0) coalesce 1
    const int d ← fe.get(1) coalesce 1
    var list<f32> out ← empty
    for from tokens const tok {
        require not (tok ≺ 0 or tok ≥ v) throw variant TerminusExcedit {message = "token id out of range for the embedding"}
        for range 0‥d const j {
            out.append(embed.data.get(tok * d + j) coalesce 0.0 ∷ f32)
        }
    }
    const list<int> ft ← [tokens.length(), d]
    do {
        return tensor.construct(out, ft)
    }
    catch err {
        throw variant BadShape {message = tensor.message(err)}
    }
}

# Same-shape zero bias [T, N] for one linear row: the executed bias
# contract of the composed surface (per-channel [N] against [M, N] needs
# singleton broadcast, which shape.broadcast rejects at runtime — the
# recorded broadcast rank-mismatch constraint, dense-swiglu precedent).
@ private { }
fn _no_bias(tensor.Tensor x, tensor.Tensor w) → tensor.Tensor ⇥ DenseError {
    const list<int> fx ← x.shape()
    const list<int> fw ← w.shape()
    require fx.length() ≡ 2 throw variant BadShape {message = "block input must be rank 2"}
    require fw.length() ≡ 2 throw variant BadShape {message = "block weight must be rank 2"}
    const int t ← fx.get(0) coalesce 1
    const int n ← fw.get(1) coalesce 1
    do {
        return tensor.fill([t, n], 0.0 ∷ f32)
    }
    catch err {
        throw variant BadShape {message = tensor.message(err)}
    }
}

# Tile a per-channel bias [N] across T rows into the same-shape [T, N]
# contract nn.linear actually executes (broadcast of [N] onto [T, N] is
# rejected — see _no_bias). A already-shaped [T, N] view is passed through.
@ private { }
fn _channel_to_rows(tensor.Tensor x, tensor.Tensor w, tensor.Tensor b) → tensor.Tensor ⇥ DenseError {
    const list<int> fx ← x.shape()
    const list<int> fw ← w.shape()
    require fx.length() ≡ 2 throw variant BadShape {message = "block input must be rank 2"}
    require fw.length() ≡ 2 throw variant BadShape {message = "block weight must be rank 2"}
    const int t ← fx.get(0) coalesce 1
    const int n ← fw.get(1) coalesce 1
    const list<int> fb ← b.shape()
    if fb.length() ≡ 2 {
        if (fb.get(0) coalesce 0) ≡ t and (fb.get(1) coalesce 0) ≡ n {
            return b
        }
        throw variant BadShape {message = "attention bias does not match output shape"}
    }
    require not (fb.length() ≠ 1 or (fb.get(0) coalesce 0) ≠ n) throw variant BadShape {message = "attention bias must be per-channel [N] or [T, N]"}
    var list<f32> out ← empty
    var int i ← 0
    while i ≺ t {
        var int j ← 0
        while j ≺ n {
            out.append(b.data.get(j) coalesce 0.0 ∷ f32)
            j ← j + 1
        }
        i ← i + 1
    }
    do {
        return tensor.construct(out, [t, n])
    }
    catch err {
        throw variant BadShape {message = tensor.message(err)}
    }
}

# Optional Q/K/V bias: a resolver miss (SmolLM2 / U1.8 synthetic rows)
# stays on the verified zero-bias contract. A hit (Qwen2.5 attn_{q,k,v}.bias)
# is applied after the linear and before RoPE (q/k) or cache-write (v).
@ private { }
fn _attn_bias((string, int) → tensor.Tensor ⇥ DenseError source, string name, int layer, tensor.Tensor x, tensor.Tensor w) → tensor.Tensor ⇥ DenseError {
    var tensor.Tensor b ← tensor.default()
    var bool hit ← false
    do {
        b ← source(name, layer)
        hit ← true
    }
    catch err {
        hit ← false
    }
    if not hit {
        return _no_bias(x, w)
    }
    return _channel_to_rows(x, w, b)
}

# rmsnorm wrapper — nn.rmsnorm → DenseError (message text preserved).
@ private { }
fn _rmsnorm(tensor.Tensor x, tensor.Tensor s, f32 epsilon) → tensor.Tensor ⇥ DenseError {
    do {
        return nn.rmsnorm(x, s, epsilon)
    }
    catch err {
        throw variant BadShape {message = nn.message(err)}
    }
}

# linear wrapper — nn.linear_carrier → DenseError (message text preserved).
@ private { }
fn _linear(tensor.Tensor x, tensor.Tensor w, tensor.Tensor b) → tensor.Tensor ⇥ DenseError {
    do {
        return nn.linear_carrier(x, w, b)
    }
    catch err {
        throw variant BadShape {message = nn.message(err)}
    }
}

# dense_block wrapper — transformer.dense_block → DenseError (message text
# preserved).
@ private { }
fn _block(tensor.Tensor x, tensor.Tensor ln1_s, f32 epsilon, tensor.Tensor wq, tensor.Tensor bq, tensor.Tensor wk, tensor.Tensor bk, tensor.Tensor wv, tensor.Tensor bv, tensor.Tensor wo, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, attention.RopeConfig cfg, tensor.Tensor ln2_s, tensor.Tensor wg, tensor.Tensor bg, tensor.Tensor wu, tensor.Tensor bu, tensor.Tensor wd, tensor.Tensor bd) → tensor.Tensor ⇥ DenseError {
    do {
        return transformer.dense_block(x, ln1_s, epsilon, wq, bq, wk, bk, wv, bv, wo, num_heads, num_kv_heads, scale, positions, rope_dim, cfg, ln2_s, wg, bg, wu, bu, wd, bd)
    }
    catch err {
        throw variant BadShape {message = transformer.message(err)}
    }
}

@ private { }
fn _block_cached(tensor.Tensor x, tensor.Tensor ln1_s, f32 epsilon, tensor.Tensor wq, tensor.Tensor bq, tensor.Tensor wk, tensor.Tensor bk, tensor.Tensor wv, tensor.Tensor bv, tensor.Tensor wo, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, attention.RopeConfig cfg, tensor.Tensor ln2_s, tensor.Tensor wg, tensor.Tensor bg, tensor.Tensor wu, tensor.Tensor bu, tensor.Tensor wd, tensor.Tensor bd, kv.KVCache layer, list<int> tokens) → transformer.CachedBlock ⇥ DenseError {
    do {
        return transformer.dense_block_cached(x, ln1_s, epsilon, wq, bq, wk, bk, wv, bv, wo, num_heads, num_kv_heads, scale, positions, rope_dim, cfg, ln2_s, wg, bg, wu, bu, wd, bd, layer, tokens)
    }
    catch err {
        throw variant BadShape {message = transformer.message(err)}
    }
}



# -------------------------------------------------------------------------
# forward — the complete ordered dense forward graph.
#
#   cfg        the typed architecture config (heads, layers, dims, vocab,
#              tie status)
#   source       canonical tensor-name → materialized stored-weight view
#   tokens     token ids [T] (embedding gather)
#   epsilon    RMSNorm epsilon (llama default 1e-5)
#   scale      dk scaling factor (1/sqrt(head_dim))
#   positions  RoPE positions, one per token
#   rope_dim   RoPE rotation width (≤ head_dim)
#   rope_cfg   the U1.3 configurable RoPE (base, scale, pair policy)
#
# Returns the logits [T, V]. Shape-generic at runtime (R3): no per-row
# special-case constants; every shape derives from cfg and the runtime
# tensors.
# -------------------------------------------------------------------------

@ public { }
fn forward(DenseConfig cfg, (string, int) → tensor.Tensor ⇥ DenseError source, list<int> tokens, f32 epsilon, f32 scale, list<int> positions, int rope_dim, attention.RopeConfig rope_cfg) → tensor.Tensor ⇥ DenseError {
    require cfg.layers ≥ 1 throw variant BadConfig {message = "layer count must be at least 1"}
    require cfg.heads ≥ 1 throw variant BadConfig {message = "head count must be at least 1"}
    require not (cfg.kv_heads ≺ 1 or cfg.kv_heads ≻ cfg.heads) throw variant BadConfig {message = "KV head count must be between 1 and the head count"}
    require cfg.heads % cfg.kv_heads ≡ 0 throw variant BadConfig {message = "head count must be a multiple of the KV head count"}
    require cfg.head_dim ≥ 1 throw variant BadConfig {message = "head dim must be at least 1"}
    require cfg.hidden_dim ≥ 1 throw variant BadConfig {message = "hidden dim must be at least 1"}
    require cfg.vocab ≥ 1 throw variant BadConfig {message = "vocabulary size must be at least 1"}
    require tokens.length() ≥ 1 throw variant BadConfig {message = "token sequence must be non-empty"}
    require positions.length() ≡ tokens.length() throw variant BadConfig {message = "positions must match the token count"}

    # Embedding: the resolver returns the stored [D, V] GGUF/A1b descriptor
    # (ggml dim0 = D innermost). The buffer is already token-major — gather
    # at [token * D + d], no data transpose. A TIED lm_head later transposes
    # this view into true row-major [D, V] for the output linear.
    const tensor.Tensor embed ← _source(source, "model.embed_tokens", 0)
    _shape(embed, "model.embed_tokens", [cfg.hidden_dim, cfg.vocab])
    const tensor.Tensor embed_v ← _token_major_view(embed)
    const tensor.Tensor x ← _collect(embed_v, tokens)

    # N ordered U1.5 blocks. Every weight is resolved by its canonical name
    # at the current layer index; every shape is validated against the
    # config (the MLP hidden width derives from the gate/up width at
    # runtime). Q/K/V bias is optional: present Qwen2 tensors are tiled
    # onto [T, N] and added after the linear (before RoPE for q/k, before
    # cache-write for v). A resolver miss keeps the U1.8 zero-bias
    # contract. MLP / output biases stay synthesized zeros.
    const int qwidth ← cfg.heads * cfg.head_dim
    const int kwidth ← cfg.kv_heads * cfg.head_dim
    var tensor.Tensor h ← x
    var int layer ← 0
    while layer ≺ cfg.layers {
        const string prefix ← "model.layers." + (layer ↦ string)
        const tensor.Tensor ln1_s ← _source(source, prefix + ".input_layernorm", layer)
        const tensor.Tensor wq ← _source(source, prefix + ".self_attn.q_proj", layer)
        const tensor.Tensor wk ← _source(source, prefix + ".self_attn.k_proj", layer)
        const tensor.Tensor wv ← _source(source, prefix + ".self_attn.v_proj", layer)
        const tensor.Tensor wo ← _source(source, prefix + ".self_attn.o_proj", layer)
        const tensor.Tensor ln2_s ← _source(source, prefix + ".post_attention_layernorm", layer)
        const tensor.Tensor wg ← _source(source, prefix + ".mlp.gate_proj", layer)
        const tensor.Tensor wu ← _source(source, prefix + ".mlp.up_proj", layer)
        const tensor.Tensor wd ← _source(source, prefix + ".mlp.down_proj", layer)
        _shape(ln1_s, prefix + ".input_layernorm", [cfg.hidden_dim])
        _shape(wq, prefix + ".self_attn.q_proj", [cfg.hidden_dim, qwidth])
        _shape(wk, prefix + ".self_attn.k_proj", [cfg.hidden_dim, kwidth])
        _shape(wv, prefix + ".self_attn.v_proj", [cfg.hidden_dim, kwidth])
        _shape(wo, prefix + ".self_attn.o_proj", [qwidth, qwidth])
        _shape(ln2_s, prefix + ".post_attention_layernorm", [cfg.hidden_dim])
        const list<int> fwg ← wg.shape()
        require fwg.length() ≡ 2 throw variant BadShape {message = ("canonical tensor " + prefix) + ".mlp.gate_proj must be rank 2"}
        const int f ← fwg.get(1) coalesce 1
        _shape(wu, prefix + ".mlp.up_proj", [cfg.hidden_dim, f])
        _shape(wd, prefix + ".mlp.down_proj", [f, cfg.hidden_dim])
        const tensor.Tensor bq ← _attn_bias(source, prefix + ".self_attn.q_proj.bias", layer, h, wq)
        const tensor.Tensor bk ← _attn_bias(source, prefix + ".self_attn.k_proj.bias", layer, h, wk)
        const tensor.Tensor bv ← _attn_bias(source, prefix + ".self_attn.v_proj.bias", layer, h, wv)
        const tensor.Tensor bg ← _no_bias(h, wg)
        const tensor.Tensor bu ← _no_bias(h, wu)
        const tensor.Tensor bd ← _no_bias(h, wd)
        h ← _block(h, ln1_s, epsilon, wq, bq, wk, bk, wv, bv, wo, cfg.heads, cfg.kv_heads, scale, positions, rope_dim, rope_cfg, ln2_s, wg, bg, wu, bu, wd, bd)
        layer ← layer + 1
    }

    # Final RMSNorm.
    const tensor.Tensor norm_s ← _source(source, "model.norm", 0)
    _shape(norm_s, "model.norm", [cfg.hidden_dim])
    const tensor.Tensor hn ← _rmsnorm(h, norm_s, epsilon)

    # Output projection. A TIED lm_head transposes the token-major embed
    # view into true row-major [D, V] (the linear [in, out] layout); an
    # UNTIED row resolves lm_head as its own canonical tensor.
    var tensor.Tensor w_head ← _transpose(embed_v)
    if not cfg.tied {
        w_head ← _source(source, "lm_head", 0)
        _shape(w_head, "lm_head", [cfg.hidden_dim, cfg.vocab])
    }
    const tensor.Tensor b_head ← _no_bias(hn, w_head)
    return _linear(hn, w_head, b_head)
}

# -------------------------------------------------------------------------
# decode_step — ONE incremental dense decode over the per-layer KV cache.
# Token id + position + one cache per layer in → logits [1, V] + updated
# caches. Each layer's attention reads that layer's cached K/V and writes
# the new position. empty_caches builds the starting state from a
# KVStructure (one empty KVCache per KV layer).
# -------------------------------------------------------------------------

@ public { }
class DenseStep {
    tensor.Tensor logits
    list<kv.KVCache> layers

    fn logits() → tensor.Tensor {
        return self.logits
    }

    fn layers() → list<kv.KVCache> {
        return self.layers
    }
}

@ public { }
fn default_step() → DenseStep {
    return DenseStep {logits = tensor.default(), layers = empty}
}

@ public { }
fn empty_caches(kv.KVStructure structure, string model, string model_version, string config, string tokenizer) → list<kv.KVCache> ⇥ DenseError {
    do {
        return kv.empty_layers(structure, model, model_version, config, tokenizer)
    }
    catch err {
        throw variant BadConfig {message = kv.message(err)}
    }
}

@ public { }
fn decode_step(DenseConfig cfg, (string, int) → tensor.Tensor ⇥ DenseError source, int token_id, int position, f32 epsilon, f32 scale, int rope_dim, attention.RopeConfig rope_cfg, list<kv.KVCache> layers) → DenseStep ⇥ DenseError {
    require cfg.layers ≥ 1 throw variant BadConfig {message = "layer count must be at least 1"}
    require cfg.heads ≥ 1 throw variant BadConfig {message = "head count must be at least 1"}
    require not (cfg.kv_heads ≺ 1 or cfg.kv_heads ≻ cfg.heads) throw variant BadConfig {message = "KV head count must be between 1 and the head count"}
    require cfg.heads % cfg.kv_heads ≡ 0 throw variant BadConfig {message = "head count must be a multiple of the KV head count"}
    require cfg.head_dim ≥ 1 throw variant BadConfig {message = "head dim must be at least 1"}
    require cfg.hidden_dim ≥ 1 throw variant BadConfig {message = "hidden dim must be at least 1"}
    require cfg.vocab ≥ 1 throw variant BadConfig {message = "vocabulary size must be at least 1"}
    require not (token_id ≺ 0 or token_id ≥ cfg.vocab) throw variant TerminusExcedit {message = "token id out of range for the embedding"}
    require position ≥ 0 throw variant BadConfig {message = "position must be non-negative"}
    require layers.length() ≡ cfg.layers throw variant BadConfig {message = "cache layer count must equal the model layer count"}

    const tensor.Tensor embed ← _source(source, "model.embed_tokens", 0)
    _shape(embed, "model.embed_tokens", [cfg.hidden_dim, cfg.vocab])
    const tensor.Tensor embed_v ← _token_major_view(embed)
    const tensor.Tensor x ← _collect(embed_v, [token_id])

    const int qwidth ← cfg.heads * cfg.head_dim
    const int kwidth ← cfg.kv_heads * cfg.head_dim
    const list<int> positions ← [position]
    const list<int> tokens ← [token_id]
    var tensor.Tensor h ← x
    var list<kv.KVCache> next ← empty
    var int layer ← 0
    while layer ≺ cfg.layers {
        const string prefix ← "model.layers." + (layer ↦ string)
        const tensor.Tensor ln1_s ← _source(source, prefix + ".input_layernorm", layer)
        const tensor.Tensor wq ← _source(source, prefix + ".self_attn.q_proj", layer)
        const tensor.Tensor wk ← _source(source, prefix + ".self_attn.k_proj", layer)
        const tensor.Tensor wv ← _source(source, prefix + ".self_attn.v_proj", layer)
        const tensor.Tensor wo ← _source(source, prefix + ".self_attn.o_proj", layer)
        const tensor.Tensor ln2_s ← _source(source, prefix + ".post_attention_layernorm", layer)
        const tensor.Tensor wg ← _source(source, prefix + ".mlp.gate_proj", layer)
        const tensor.Tensor wu ← _source(source, prefix + ".mlp.up_proj", layer)
        const tensor.Tensor wd ← _source(source, prefix + ".mlp.down_proj", layer)
        _shape(ln1_s, prefix + ".input_layernorm", [cfg.hidden_dim])
        _shape(wq, prefix + ".self_attn.q_proj", [cfg.hidden_dim, qwidth])
        _shape(wk, prefix + ".self_attn.k_proj", [cfg.hidden_dim, kwidth])
        _shape(wv, prefix + ".self_attn.v_proj", [cfg.hidden_dim, kwidth])
        _shape(wo, prefix + ".self_attn.o_proj", [qwidth, qwidth])
        _shape(ln2_s, prefix + ".post_attention_layernorm", [cfg.hidden_dim])
        const list<int> fwg ← wg.shape()
        require fwg.length() ≡ 2 throw variant BadShape {message = ("canonical tensor " + prefix) + ".mlp.gate_proj must be rank 2"}
        const int f ← fwg.get(1) coalesce 1
        _shape(wu, prefix + ".mlp.up_proj", [cfg.hidden_dim, f])
        _shape(wd, prefix + ".mlp.down_proj", [f, cfg.hidden_dim])
        const tensor.Tensor bq ← _attn_bias(source, prefix + ".self_attn.q_proj.bias", layer, h, wq)
        const tensor.Tensor bk ← _attn_bias(source, prefix + ".self_attn.k_proj.bias", layer, h, wk)
        const tensor.Tensor bv ← _attn_bias(source, prefix + ".self_attn.v_proj.bias", layer, h, wv)
        const tensor.Tensor bg ← _no_bias(h, wg)
        const tensor.Tensor bu ← _no_bias(h, wu)
        const tensor.Tensor bd ← _no_bias(h, wd)
        const kv.KVCache cache ← layers.get(layer) coalesce kv.default()
        const transformer.CachedBlock block ← _block_cached(h, ln1_s, epsilon, wq, bq, wk, bk, wv, bv, wo, cfg.heads, cfg.kv_heads, scale, positions, rope_dim, rope_cfg, ln2_s, wg, bg, wu, bu, wd, bd, cache, tokens)
        h ← block.output()
        next.append(block.state())
        layer ← layer + 1
    }

    const tensor.Tensor norm_s ← _source(source, "model.norm", 0)
    _shape(norm_s, "model.norm", [cfg.hidden_dim])
    const tensor.Tensor hn ← _rmsnorm(h, norm_s, epsilon)
    var tensor.Tensor w_head ← _transpose(embed_v)
    if not cfg.tied {
        w_head ← _source(source, "lm_head", 0)
        _shape(w_head, "lm_head", [cfg.hidden_dim, cfg.vocab])
    }
    const tensor.Tensor b_head ← _no_bias(hn, w_head)
    return DenseStep {logits = _linear(hn, w_head, b_head), layers = next}
}
