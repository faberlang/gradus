+++
locale = "en"
+++
# REF-01-U1.8 — dense model assembly (gradus:model/dense).
#
# Public import: importa ex "gradus:model/dense" dense
# Depends on: gradus:attention (RopeConfigura), gradus:tensor (staged
#   carrier), gradus:transformer (dense_block, REF-01-U1.5), gradus:nn
#   (rmsnorm / linear rows, REF-01-U1.1 / the PML3 surface).
#
# The complete ordered dense forward graph:
#   embedding gather → N ordered U1.5 blocks → final RMSNorm → output
#   projection,
# assembled from the typed architecture config and materialized tensor
# views via canonical names. The caller supplies a resolver (`fons`) that
# returns the materialized STORED-weight view for one canonical tensor name
# (model.embed_tokens, model.layers.{N}.input_layernorm,
# .self_attn.{q,k,v,o}_proj, .post_attention_layernorm, .mlp.{gate,up,down}_proj,
# model.norm, lm_head) plus a layer index — the GGUF/A1b descriptor layout
# (token_embd.weight is [D, V]). The assembly transposes the embedding for
# the token-major gather and reuses it directly for a TIED lm_head; an
# UNTIED row resolves lm_head separately. Zero per-row special-case
# constants: every shape derives from the config and the runtime tensors.
#
# Fails closed with typed diagnostics on: an unknown/missing canonical
# tensor (resolver successus = falsum → TensorAbsens), an invalid
# architecture config (ConfiguraMala), a shape that contradicts the config
# (FormaMala), and token ids outside the embedding vocabulary
# (TerminusExcedit). Sub-call errors from nn / transformer / tensor are
# mapped into FormaMala preserving the documented causa text.
#
# The F32 row is the admitted row (the composed rows' contract). The
# surface is forward-only: no autograd import, no gradient path.

import from "gradus:attention" attention

import from "gradus:nn" nn

import from "gradus:tensor" tensor

import from "gradus:transformer" transformer

# -------------------------------------------------------------------------
# ConfiguraDensa — the typed dense architecture config the assembly is
# built from. `ligatum` records tied embeddings (lm_head shares the
# embedding tensor). No per-row constants: the head counts and dims are
# carried here and every shape is validated against them.
# -------------------------------------------------------------------------


@ public { }
class ConfiguraDensa {
    int strata
    int capita
    int capita_kv
    int dimensio_capitis
    int dimensio_occulta
    int vocabulum
    bool ligatum
}

# One resolver answer: successus = verum carries the materialized
# stored-weight view for the requested canonical tensor; successus = falsum
# carries the causa (the assembly maps it into TensorAbsens). The LectioFontis
# seam pattern (gguf_manifest), so the consumer closure never needs to
# construct the module's typed error.

@ public { }
class Repertum {
    bool successus
    tensor.Tensor tensorem
    string causa
}

# -------------------------------------------------------------------------
# DenseError — typed error vocabulary of the dense assembly. Every variant
# carries a textus causa (render via causa).
# -------------------------------------------------------------------------


@ public { }
union DenseError {
    TensorAbsens {
        string causa
    },
    ConfiguraMala {
        string causa
    },
    FormaMala {
        string causa
    },
    TerminusExcedit {
        string causa
    }
}

@ public { }
fn causa(DenseError e) → string {
    match e {
        case TensorAbsens const causa {
            return causa
        }
        case ConfiguraMala const causa {
            return causa
        }
        case FormaMala const causa {
            return causa
        }
        case TerminusExcedit const causa {
            return causa
        }
    }
}

# -------------------------------------------------------------------------
# Private helpers — each wraps a primitive sub-call or an assembly step and
# maps its failure into DenseError preserving the documented causa text.
# -------------------------------------------------------------------------

# Resolve one canonical tensor; a resolver failure becomes TensorAbsens
# carrying the resolver's causa verbatim.
@ private { }
fn _fons((string, int) → Repertum fons, string nomen, int stratum) → tensor.Tensor ⇥ DenseError {
    const Repertum r ← fons(nomen, stratum)
    if r.successus then return r.tensorem
    throw variant TensorAbsens {causa = r.causa}
}

# Shape render for diagnostics (no lista→textus cast exists).
@ private { }
fn _forma_textus(list<int> f) → string {
    var string out ← ""
    const int n ← f.length()
    var int i ← 0
    while i ≺ n {
        if i ≻ 0 {
            out ← out + ","
        }
        out ← out + (f.get(i) coalesce 0 ↦ string)
        i ← i + 1
    }
    return out
}

# Validate a canonical tensor's runtime shape against the config-derived
# expectation; passes the tensor through on success.
@ private { }
fn _forma(tensor.Tensor t, string nomen, list<int> expectata) → tensor.Tensor ⇥ DenseError {
    const list<int> f ← t.figura()
    if f ≠ expectata {
        throw variant FormaMala {causa = (((("canonical tensor " + nomen) + " has shape ") + _forma_textus(f)) + ", expected ") + _forma_textus(expectata)}
    }
    return t
}

# Rank-2 transpose [rows, cols] → [cols, rows] (math has no transpose; the
# embedding gather needs the token-major view).
@ private { }
fn _transpone(tensor.Tensor t) → tensor.Tensor ⇥ DenseError {
    const list<int> f ← t.figura()
    if f.length() ≠ 2 {
        throw variant FormaMala {causa = "embedding must be rank 2"}
    }
    const int rows ← f.get(0) coalesce 1
    const int cols ← f.get(1) coalesce 1
    var list<f32> out ← vacua
    var int j ← 0
    while j ≺ cols {
        var int i ← 0
        while i ≺ rows {
            out.append(t.datos.get(i * cols + j) coalesce 0.0 ∷ f32)
            i ← i + 1
        }
        j ← j + 1
    }
    do {
        return tensor.structa(out, [cols, rows])
    }
    catch err {
        throw variant FormaMala {causa = tensor.causa(err)}
    }
}

# Embedding gather: token-major embed [V, D] → rows for the token ids.
@ private { }
fn _collige(tensor.Tensor embed, list<int> tokens) → tensor.Tensor ⇥ DenseError {
    const list<int> fe ← embed.figura()
    if fe.length() ≠ 2 {
        throw variant FormaMala {causa = "embedding must be rank 2"}
    }
    const int v ← fe.get(0) coalesce 1
    const int d ← fe.get(1) coalesce 1
    var list<f32> out ← vacua
    for from tokens const tok {
        if tok ≺ 0 or tok ≥ v {
            throw variant TerminusExcedit {causa = "token id out of range for the embedding"}
        }
        for range 0‥d const j {
            out.append(embed.datos.get(tok * d + j) coalesce 0.0 ∷ f32)
        }
    }
    const list<int> ft ← [tokens.length(), d]
    do {
        return tensor.structa(out, ft)
    }
    catch err {
        throw variant FormaMala {causa = tensor.causa(err)}
    }
}

# Same-shape zero bias [T, N] for one linear row: the executed bias
# contract of the composed surface (per-channel [N] against [M, N] needs
# singleton broadcast, which forma.broadcastum rejects at runtime — the
# recorded broadcastum rank-mismatch constraint, dense-swiglu precedent).
@ private { }
fn _nullum_bias(tensor.Tensor x, tensor.Tensor w) → tensor.Tensor ⇥ DenseError {
    const list<int> fx ← x.figura()
    const list<int> fw ← w.figura()
    if fx.length() ≠ 2 {
        throw variant FormaMala {causa = "block input must be rank 2"}
    }
    if fw.length() ≠ 2 {
        throw variant FormaMala {causa = "block weight must be rank 2"}
    }
    const int t ← fx.get(0) coalesce 1
    const int n ← fw.get(1) coalesce 1
    do {
        return tensor.impleta([t, n], 0.0 ∷ f32)
    }
    catch err {
        throw variant FormaMala {causa = tensor.causa(err)}
    }
}

# rmsnorm wrapper — nn.rmsnorm → DenseError (causa text preserved).
@ private { }
fn _rmsnorm(tensor.Tensor x, tensor.Tensor s, f32 epsilon) → tensor.Tensor ⇥ DenseError {
    do {
        return nn.rmsnorm(x, s, epsilon)
    }
    catch err {
        throw variant FormaMala {causa = nn.causa(err)}
    }
}

# linear wrapper — nn.linear → DenseError (causa text preserved).
@ private { }
fn _linear(tensor.Tensor x, tensor.Tensor w, tensor.Tensor b) → tensor.Tensor ⇥ DenseError {
    do {
        return nn.linear(x, w, b)
    }
    catch err {
        throw variant FormaMala {causa = nn.causa(err)}
    }
}

# dense_block wrapper — transformer.dense_block → DenseError (causa text
# preserved).
@ private { }
fn _block(tensor.Tensor x, tensor.Tensor ln1_s, f32 epsilon, tensor.Tensor wq, tensor.Tensor bq, tensor.Tensor wk, tensor.Tensor bk, tensor.Tensor wv, tensor.Tensor bv, tensor.Tensor wo, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, attention.RopeConfigura cfg, tensor.Tensor ln2_s, tensor.Tensor wg, tensor.Tensor bg, tensor.Tensor wu, tensor.Tensor bu, tensor.Tensor wd, tensor.Tensor bd) → tensor.Tensor ⇥ DenseError {
    do {
        return transformer.dense_block(x, ln1_s, epsilon, wq, bq, wk, bk, wv, bv, wo, num_heads, num_kv_heads, scale, positions, rope_dim, cfg, ln2_s, wg, bg, wu, bu, wd, bd)
    }
    catch err {
        throw variant FormaMala {causa = transformer.causa(err)}
    }
}

# -------------------------------------------------------------------------
# praevideo — the complete ordered dense forward graph.
#
#   cfg        the typed architecture config (heads, layers, dims, vocab,
#              tie status)
#   fons       canonical tensor-name → materialized stored-weight view
#   tokens     token ids [T] (embedding gather)
#   epsilon    RMSNorm epsilon (llama default 1e-5)
#   scale      dk scaling factor (1/sqrt(head_dim))
#   positions  RoPE positions, one per token
#   rope_dim   RoPE rotation width (≤ head_dim)
#   rope_cfg   the U1.3 configurable RoPE (base, scale, pair policy)
#
# Returns the logits [T, V]. Shape-generic at runtime (R3): no per-row
# special-case constants; every shape derives from cfg and the runtime
# tensors.
# -------------------------------------------------------------------------

@ public { }
fn praevideo(ConfiguraDensa cfg, (string, int) → Repertum fons, list<int> tokens, f32 epsilon, f32 scale, list<int> positions, int rope_dim, attention.RopeConfigura rope_cfg) → tensor.Tensor ⇥ DenseError {
    if cfg.strata ≺ 1 {
        throw variant ConfiguraMala {causa = "layer count must be at least 1"}
    }
    if cfg.capita ≺ 1 {
        throw variant ConfiguraMala {causa = "head count must be at least 1"}
    }
    if cfg.capita_kv ≺ 1 or cfg.capita_kv ≻ cfg.capita {
        throw variant ConfiguraMala {causa = "KV head count must be between 1 and the head count"}
    }
    if cfg.capita % cfg.capita_kv ≠ 0 {
        throw variant ConfiguraMala {causa = "head count must be a multiple of the KV head count"}
    }
    if cfg.dimensio_capitis ≺ 1 {
        throw variant ConfiguraMala {causa = "head dim must be at least 1"}
    }
    if cfg.dimensio_occulta ≺ 1 {
        throw variant ConfiguraMala {causa = "hidden dim must be at least 1"}
    }
    if cfg.vocabulum ≺ 1 {
        throw variant ConfiguraMala {causa = "vocabulary size must be at least 1"}
    }
    if tokens.length() ≺ 1 {
        throw variant ConfiguraMala {causa = "token sequence must be non-empty"}
    }
    if positions.length() ≠ tokens.length() {
        throw variant ConfiguraMala {causa = "positions must match the token count"}
    }

    # Embedding: the resolver returns the stored [D, V] view (the GGUF/A1b
    # descriptor layout); transpose for the token-major gather. A TIED
    # lm_head later reuses this stored view directly.
    const tensor.Tensor embed ← _fons(fons, "model.embed_tokens", 0)
    _forma(embed, "model.embed_tokens", [cfg.dimensio_occulta, cfg.vocabulum])
    const tensor.Tensor embed_v ← _transpone(embed)
    const tensor.Tensor x ← _collige(embed_v, tokens)

    # N ordered U1.5 blocks. Every weight is resolved by its canonical name
    # at the current layer index; every shape is validated against the
    # config (the MLP hidden width derives from the gate/up width at
    # runtime). The biases are synthesized zero same-shape tensors (the
    # composed rows carry no bias weights).
    const int qwidth ← cfg.capita * cfg.dimensio_capitis
    const int kwidth ← cfg.capita_kv * cfg.dimensio_capitis
    var tensor.Tensor h ← x
    var int stratum ← 0
    while stratum ≺ cfg.strata {
        const string prefix ← "model.layers." + (stratum ↦ string)
        const tensor.Tensor ln1_s ← _fons(fons, prefix + ".input_layernorm", stratum)
        const tensor.Tensor wq ← _fons(fons, prefix + ".self_attn.q_proj", stratum)
        const tensor.Tensor wk ← _fons(fons, prefix + ".self_attn.k_proj", stratum)
        const tensor.Tensor wv ← _fons(fons, prefix + ".self_attn.v_proj", stratum)
        const tensor.Tensor wo ← _fons(fons, prefix + ".self_attn.o_proj", stratum)
        const tensor.Tensor ln2_s ← _fons(fons, prefix + ".post_attention_layernorm", stratum)
        const tensor.Tensor wg ← _fons(fons, prefix + ".mlp.gate_proj", stratum)
        const tensor.Tensor wu ← _fons(fons, prefix + ".mlp.up_proj", stratum)
        const tensor.Tensor wd ← _fons(fons, prefix + ".mlp.down_proj", stratum)
        _forma(ln1_s, prefix + ".input_layernorm", [cfg.dimensio_occulta])
        _forma(wq, prefix + ".self_attn.q_proj", [cfg.dimensio_occulta, qwidth])
        _forma(wk, prefix + ".self_attn.k_proj", [cfg.dimensio_occulta, kwidth])
        _forma(wv, prefix + ".self_attn.v_proj", [cfg.dimensio_occulta, kwidth])
        _forma(wo, prefix + ".self_attn.o_proj", [qwidth, qwidth])
        _forma(ln2_s, prefix + ".post_attention_layernorm", [cfg.dimensio_occulta])
        const list<int> fwg ← wg.figura()
        if fwg.length() ≠ 2 {
            throw variant FormaMala {causa = ("canonical tensor " + prefix) + ".mlp.gate_proj must be rank 2"}
        }
        const int f ← fwg.get(1) coalesce 1
        _forma(wu, prefix + ".mlp.up_proj", [cfg.dimensio_occulta, f])
        _forma(wd, prefix + ".mlp.down_proj", [f, cfg.dimensio_occulta])
        const tensor.Tensor bq ← _nullum_bias(h, wq)
        const tensor.Tensor bk ← _nullum_bias(h, wk)
        const tensor.Tensor bv ← _nullum_bias(h, wv)
        const tensor.Tensor bg ← _nullum_bias(h, wg)
        const tensor.Tensor bu ← _nullum_bias(h, wu)
        const tensor.Tensor bd ← _nullum_bias(h, wd)
        h ← _block(h, ln1_s, epsilon, wq, bq, wk, bk, wv, bv, wo, cfg.capita, cfg.capita_kv, scale, positions, rope_dim, rope_cfg, ln2_s, wg, bg, wu, bu, wd, bd)
        stratum ← stratum + 1
    }

    # Final RMSNorm.
    const tensor.Tensor norm_s ← _fons(fons, "model.norm", 0)
    _forma(norm_s, "model.norm", [cfg.dimensio_occulta])
    const tensor.Tensor hn ← _rmsnorm(h, norm_s, epsilon)

    # Output projection. A TIED lm_head reuses the stored embedding view
    # (already [D, V] — the linear [in, out] layout); an UNTIED row resolves
    # lm_head as its own canonical tensor.
    var tensor.Tensor w_head ← embed
    if not cfg.ligatum {
        w_head ← _fons(fons, "lm_head", 0)
        _forma(w_head, "lm_head", [cfg.dimensio_occulta, cfg.vocabulum])
    }
    const tensor.Tensor b_head ← _nullum_bias(hn, w_head)
    return _linear(hn, w_head, b_head)
}
