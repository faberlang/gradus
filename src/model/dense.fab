+++
locale = "en"
+++
# Dense model assembly (gradus:model/dense).
#
# Public import: import from "gradus:model/dense" dense
# Depends on: gradus:attention (RopeConfig), gradus:tensor (staged
#   carrier), gradus:transformer (dense_block), gradus:nn (rmsnorm / linear
#   rows).
#
# The complete ordered dense forward graph:
#   embedding gather → N ordered dense blocks → final RMSNorm → output
#   projection,
# assembled from the typed architecture config and materialized tensor
# views via canonical names. The caller supplies a resolver (`source`) that
# returns the materialized STORED-weight view for one canonical tensor name
# (model.embed_tokens, model.layers.{N}.input_layernorm,
# .self_attn.{q,k,v,o}_proj, optional .self_attn.{q,k,v}_proj.bias,
# .post_attention_layernorm, .mlp.{gate,up,down}_proj,
# model.norm, lm_head) plus a layer index — the GGUF/A1b descriptor layout
# (token_embd.weight is [D, V] in the GGUF/ggml descriptor — dim0 = D
# innermost, so the stored f32 buffer is already token-major). The
# assembly gathers at index [token * D + d] without a data transpose, and
# materializes a true row-major [D, V] only for a TIED lm_head; an UNTIED
# row resolves lm_head separately. Zero per-row special-case constants:
# every shape derives from the config and the runtime tensors.
#
# Fails closed with typed diagnostics on: an unknown/missing canonical
# tensor (resolver throw → MissingTensor), an invalid
# architecture config (BadConfig), a shape that contradicts the config
# (BadShape), token ids outside the embedding vocabulary
# (IndexOutOfBounds), cache overflow (Overflow), and a write that is not
# the shared prefix length (Gap). Sub-call errors from nn / transformer /
# tensor are mapped into BadShape preserving the documented message
# text, except cache overflow and gap, which keep their variants.
#
# KV-A A3 — dense logical prefill/decode composition. All layers start at
# one shared prefix and advance together. Prefill writes the prompt at
# prefix 0. Decode writes one row at position == cache.length(). Overflow
# and gap reject before the cached block runs, so those cache variants
# reach the caller instead of a shape mismatch.
#
# The surface is forward-only: no autograd import, no gradient path.
#
# --- Speculative rollback boundary (SD1) ---------------------------------
# When the dense route participates in speculative cache rollback, the
# contract is value-level: checkpoint the all-layer cache, evaluate a private
# branch, and atomically commit the accepted prefix as a fresh state. Never
# implement rollback by naively trimming or mutating a shared cache. Physical
# allocation, residency, quantization, and scheduling stay outside this
# contract; this module carries no physical device handles.

import from "gradus:attention/rope" rope

import from "gradus:cache/kv" kv

import from "gradus:cache/structure" structure

import from "gradus:nn" nn

import from "gradus:tensor" tensor

import from "gradus:transformer" transformer

# -------------------------------------------------------------------------
# DenseConfig — the typed dense architecture config the assembly is
# built from. `tied` records tied embeddings (lm_head shares the
# embedding tensor). No per-row constants: the head counts and dims are
# carried here and every shape is validated against them.
# -------------------------------------------------------------------------

@ public
class DenseConfig {
    mut int layers
    mut int heads
    mut int kv_heads
    mut int head_dim
    mut int hidden_dim
    mut int vocab
    mut bool tied
}

# DenseLayer / DenseModel — materialized F32 compute weights. Encoded model
# storage and arbitrary representation identity live in gradus:storage and
# gradus:model/tensor_view; `load` is the explicit decode-to-F32 boundary.
# Size parameters are the admitted geometry (D hidden, V vocab, Q = H·d,
# K = KV·d, F MLP). Optional Q/K/V bias is zeros + present=false when the
# resolver misses.

@ public
class DenseLayer<size D, size Q, size K, size F> {
    mut tensor<f32, [D]> ln1
    mut tensor<f32, [D, Q]> wq
    mut tensor<f32, [Q]> bq
    mut bool has_bq
    mut tensor<f32, [D, K]> wk
    mut tensor<f32, [K]> bk
    mut bool has_bk
    mut tensor<f32, [D, K]> wv
    mut tensor<f32, [K]> bv
    mut bool has_bv
    mut tensor<f32, [Q, D]> wo
    mut tensor<f32, [D]> ln2
    mut tensor<f32, [D, F]> wg
    mut tensor<f32, [D, F]> wu
    mut tensor<f32, [F, D]> wd
}

@ public
class DenseModel<size D, size V, size Q, size K, size F> {
    mut DenseConfig cfg
    mut tensor<f32, [D, V]> embed
    mut tensor<f32, [V, D]> embed_tokens
    mut tensor<f32, [D]> norm
    mut tensor<f32, [D, V]> w_head
    mut list<DenseLayer<D, Q, K, F>> layers
}

class BiasBag {
    mut tensor.NumericBlock value
    mut bool present
}

# Resolver: (string, int) → tensor.NumericBlock ⇥ DenseError. Success returns the
# materialized stored-weight view; throw is MissingTensor (or another
# DenseError). Optional Q/K/V bias lookups catch a throw and keep the
# absent-bias contract (rank-0 empty; nn.linear_carrier skips the add).

# -------------------------------------------------------------------------
# DenseError — typed error vocabulary of the dense assembly. Every variant
# carries a text message (render via message).
# -------------------------------------------------------------------------

@ public
union DenseError {
    @ shared
    string message

    MissingTensor,
    BadConfig,
    BadShape,
    IndexOutOfBounds,
    Overflow,
    Gap,
    TensorFailure {
        tensor.TensorError inner
    },
    NnFailure {
        nn.NnError inner
    },
    TransformerFailure {
        transformer.TransformerError inner
    },
    CacheFailure {
        kv.CacheError inner
    }
}

@ conversion
fn from_tensor_error(tensor.TensorError err) → DenseError {
    return variant TensorFailure {message = err.message, inner = err}
}

@ conversion
fn from_nn_error(nn.NnError err) → DenseError {
    match err {
        case nn.NnError.IndexOutOfBounds let message { return variant IndexOutOfBounds {message = message} }
        case _ { return variant NnFailure {message = err.message, inner = err} }
    }
}

@ conversion
fn from_transformer_error(transformer.TransformerError err) → DenseError {
    return variant TransformerFailure {message = err.message, inner = err}
}

@ conversion
fn from_kv_cache_error(kv.CacheError err) → DenseError {
    return variant CacheFailure {message = err.message, inner = err}
}

# -------------------------------------------------------------------------
# Private helpers — each wraps a primitive sub-call or an assembly step and
# maps its failure into DenseError preserving the documented message text.
# -------------------------------------------------------------------------

# Shape render for diagnostics (no lista→text cast exists).
fn shape_text(list<int> f) → string {
    mut string out ← ""
    mut bool first ← true
    for from f let dim {
        if not first {
            out ← out + ","
        }
        first ← false
        out ← out + (dim ↦ string)
    }
    return out
}

# Validate a canonical tensor's runtime shape against the config-derived
# expectation; passes the tensor through on success.
fn shape(tensor.NumericBlock t, string name, list<int> expected) → tensor.NumericBlock ⇥ DenseError {
    let list<int> f ← t.shape
    require f ≡ expected throw variant BadShape {message = "canonical tensor § has shape §, expected §"(name, shape_text(f), shape_text(expected))}
    return t
}

# Reinterpret a stored [D, V] ggml embedding as token-major [V, D] without
# permuting data. GGUF dim0 = D is innermost, so the flat buffer is already
# data[token * D + d].
fn token_major_view(tensor.NumericBlock t) → tensor.NumericBlock ⇥ DenseError {
    let list<int> f ← t.shape
    require f.length() ≡ 2 throw variant BadShape {message = "embedding must be rank 2"}
    let int hidden ← f.get(0) coalesce 1
    let int vocab ← f.get(1) coalesce 1
    return tensor.construct(t.data, [vocab, hidden])
}

# Rank-2 transpose [rows, cols] → [cols, rows]. A TIED lm_head needs the
# true row-major [D, V] from the token-major view. Typed routes use
# `.transpose()`; a bag cannot pin runtime [rows, cols] (SEM014).
fn transpose(tensor.NumericBlock t) → tensor.NumericBlock ⇥ DenseError {
    return nn.transpose_carrier(t)
}

# Embedding gather: token-major embed [V, D] → rows for the token ids.
fn collect(tensor.NumericBlock embed, list<int> tokens) → tensor.NumericBlock ⇥ DenseError {
    return nn.gather_carrier(embed, tokens)
}

# The staged gather stays at the carrier boundary; typed shape pins happen
# only after the generic model loader has resolved a concrete tensor view.

# Absent bias: rank-0 empty carrier. nn.linear_carrier treats this as
# y = x·w (no [T, N] zero fill, no full add).
fn no_bias() → tensor.NumericBlock {
    return tensor.default()
}

# Pass a per-channel bias [N] through (nn.linear_carrier adds [N] against
# [T, N] via right-aligned broadcast — no [T, N] tile). An already-shaped
# [T, N] view is also passed through.
fn channel_to_rows(tensor.NumericBlock x, tensor.NumericBlock w, tensor.NumericBlock b) → tensor.NumericBlock ⇥ DenseError {
    let list<int> fx ← x.shape
    let list<int> fw ← w.shape
    require fx.length() ≡ 2 throw variant BadShape {message = "block input must be rank 2"}
    require fw.length() ≡ 2 throw variant BadShape {message = "block weight must be rank 2"}
    let int t ← fx.get(0) coalesce 1
    let int n ← fw.get(1) coalesce 1
    let list<int> fb ← b.shape
    if fb.length() ≡ 2 {
        if (fb.get(0) coalesce 0) ≡ t and (fb.get(1) coalesce 0) ≡ n {
            return b
        }
        throw variant BadShape {message = "attention bias does not match output shape"}
    }
    reject (fb.length() ≢ 1 or (fb.get(0) coalesce 0) ≢ n) throw variant BadShape {message = "attention bias must be per-channel [N] or [T, N]"}
    return b
}

# Optional Q/K/V bias: a resolver miss stays on the absent-bias contract. A
# hit (a model's attn_{q,k,v}.bias)
# is applied after the linear and before RoPE (q/k) or cache-write (v).
fn attn_bias((string, int) → tensor.NumericBlock ⇥ DenseError source, string name, int layer, tensor.NumericBlock x, tensor.NumericBlock w) → tensor.NumericBlock ⇥ DenseError {
    mut tensor.NumericBlock b ← tensor.default()
    mut bool hit ← false
    do {
        b ← source(name, layer)
        hit ← true
    }
    catch err {
        hit ← false
    }
    if not hit {
        return no_bias()
    }
    return channel_to_rows(x, w, b)
}

# rmsnorm wrapper — nn.rmsnorm → DenseError (message text preserved).
fn rmsnorm(tensor.NumericBlock x, tensor.NumericBlock s, f32 epsilon) → tensor.NumericBlock ⇥ DenseError {
    return nn.rmsnorm_carrier(x, s, epsilon)
}

# linear wrapper — nn.linear_carrier → DenseError (message text preserved).
fn linear(tensor.NumericBlock x, tensor.NumericBlock w, tensor.NumericBlock b) → tensor.NumericBlock ⇥ DenseError {
    return nn.linear_carrier(x, w, b)
}

# dense_block wrapper — transformer.dense_block → DenseError (message text
# preserved).
fn block(tensor.NumericBlock x, list<int> positions, transformer.DenseAttentionWeights attention_weights, transformer.DenseAttentionConfig attention_config, transformer.DenseMlpWeights mlp_weights, transformer.DenseNormConfig norm_config) → tensor.NumericBlock ⇥ DenseError {
    return transformer.dense_block(x, positions, attention_weights, attention_config, mlp_weights, norm_config)
}

# Cache overflow/gap keep their variants. The attention wrapper remaps
# kv.extend failures to a shape mismatch; restore the A1 variants so the
# dense caller sees Overflow and Gap.
fn map_cached(string c) → DenseError {
    switch c {
        case "cache overflow" { return variant Overflow {message = c} }
        case "cache write leaves a gap" { return variant Gap {message = c} }
        default { return variant BadShape {message = c} }
    }
}

# Every layer must share one prefix length before a cached step.
fn shared_prefix(list<kv.KVCache> layers) → int ⇥ DenseError {
    let kv.KVCache first ← layers.get(0) coalesce kv.default()
    let int prefix ← first.length()
    for from layers let layer {
        require layer.length() ≡ prefix throw variant Gap {message = "cache write leaves a gap"}
    }
    return prefix
}

# Admit `added` new rows against each layer's immutable capacity.
fn admit_cached(list<kv.KVCache> layers, int added) → bool ⇥ DenseError {
    for from layers let layer {
        require layer.length() + added ≤ layer.capacity throw variant Overflow {message = "cache overflow"}
    }
    return true
}

fn block_cached(tensor.NumericBlock x, list<int> positions, kv.KVCache layer, list<int> tokens, transformer.DenseAttentionWeights attention_weights, transformer.DenseAttentionConfig attention_config, transformer.DenseMlpWeights mlp_weights, transformer.DenseNormConfig norm_config) → transformer.CachedBlock ⇥ DenseError {
    do {
        return transformer.dense_block_cached(x, positions, layer, tokens, attention_weights, attention_config, mlp_weights, norm_config)
    }
    catch err {
        throw map_cached(err.message)
    }
}

fn require_cfg(DenseConfig cfg) → bool ⇥ DenseError {
    require cfg.layers ≥ 1 throw variant BadConfig {message = "layer count must be at least 1"}
    require cfg.heads ≥ 1 throw variant BadConfig {message = "head count must be at least 1"}
    reject (cfg.kv_heads ≺ 1 or cfg.kv_heads ≻ cfg.heads) throw variant BadConfig {message = "KV head count must be between 1 and the head count"}
    require cfg.heads % cfg.kv_heads ≡ 0 throw variant BadConfig {message = "head count must be a multiple of the KV head count"}
    require cfg.head_dim ≥ 1 throw variant BadConfig {message = "head dim must be at least 1"}
    require cfg.hidden_dim ≥ 1 throw variant BadConfig {message = "hidden dim must be at least 1"}
    require cfg.vocab ≥ 1 throw variant BadConfig {message = "vocabulary size must be at least 1"}
    return true
}

fn zeros_rank1(int n) → tensor.NumericBlock ⇥ DenseError {
    mut list<f32> out ← empty
    for range 0‥n let i {
        out.append(0.0 ∷ f32)
    }
    return tensor.construct(out, [n])
}

fn pin_rank1<size N>(tensor.NumericBlock t, string name, list<int> expected) → tensor<f32, [N]> ⇥ DenseError {
    shape(t, name, expected)
    do {
        return t.data ↦ tensor<f32, [N]>
    }
    catch conv {
        throw variant BadShape {message = "canonical tensor § pin failed"(name)}
    }
}

fn pin_rank2<size A, size B>(tensor.NumericBlock t, string name, list<int> expected) → tensor<f32, [A, B]> ⇥ DenseError {
    shape(t, name, expected)
    do {
        return t.data ↦ tensor<f32, [A, B]>
    }
    catch conv {
        throw variant BadShape {message = "canonical tensor § pin failed"(name)}
    }
}

fn pin_same<size A, size B>(tensor.NumericBlock t, string name) → tensor<f32, [A, B]> ⇥ DenseError {
    do {
        return t.data ↦ tensor<f32, [A, B]>
    }
    catch conv {
        throw variant BadShape {message = "canonical tensor § pin failed"(name)}
    }
}

fn pin_same_rank1<size N>(tensor.NumericBlock t, string name) → tensor<f32, [N]> ⇥ DenseError {
    do {
        return t.data ↦ tensor<f32, [N]>
    }
    catch conv {
        throw variant BadShape {message = "canonical tensor § pin failed"(name)}
    }
}

fn optional_bias((string, int) → tensor.NumericBlock ⇥ DenseError source, string name, int layer, int n) → BiasBag ⇥ DenseError {
    mut tensor.NumericBlock b ← zeros_rank1(n)
    mut bool hit ← false
    do {
        b ← source(name, layer)
        hit ← true
    }
    catch err {
        hit ← false
    }
    if hit {
        shape(b, name, [n])
    }
    return BiasBag {value = b, present = hit}
}

# load — resolver → pinned DenseModel. Layer pins stay in this function so
# D/Q/K/F unify (size params cannot be forwarded as explicit generic
# arguments).
@ public
fn load<size D, size V, size Q, size K, size F>(DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ DenseError source) → DenseModel<D, V, Q, K, F> ⇥ DenseError {
    # --- config (fail closed) ---------------------------------------------
    require_cfg(cfg)
    let int qwidth ← cfg.heads * cfg.head_dim
    let int kwidth ← cfg.kv_heads * cfg.head_dim

    # --- embed pin --------------------------------------------------------
    let tensor.NumericBlock embed_b ← source("model.embed_tokens", 0)
    let tensor<f32, [D, V]> embed ← pin_rank2(embed_b, "model.embed_tokens", [cfg.hidden_dim, cfg.vocab])
    let tensor<f32, [V, D]> embed_tokens ← pin_same(embed_b, "model.embed_tokens")

    # --- per-layer pins ---------------------------------------------------
    mut list<DenseLayer<D, Q, K, F>> layers ← empty
    for range 0‥cfg.layers let layer {
        let string prefix ← "model.layers.§"(layer ↦ string)

        # --- resolve stored weights ---------------------------------------
        let tensor.NumericBlock ln1_s ← source(prefix + ".input_layernorm", layer)
        let tensor.NumericBlock wq ← source(prefix + ".self_attn.q_proj", layer)
        let tensor.NumericBlock wk ← source(prefix + ".self_attn.k_proj", layer)
        let tensor.NumericBlock wv ← source(prefix + ".self_attn.v_proj", layer)
        let tensor.NumericBlock wo ← source(prefix + ".self_attn.o_proj", layer)
        let tensor.NumericBlock ln2_s ← source(prefix + ".post_attention_layernorm", layer)
        let tensor.NumericBlock wg ← source(prefix + ".mlp.gate_proj", layer)
        let tensor.NumericBlock wu ← source(prefix + ".mlp.up_proj", layer)
        let tensor.NumericBlock wd ← source(prefix + ".mlp.down_proj", layer)

        # --- pin against cfg ----------------------------------------------
        let tensor<f32, [D]> ln1 ← pin_rank1(ln1_s, prefix + ".input_layernorm", [cfg.hidden_dim])
        let tensor<f32, [D, Q]> wq_t ← pin_rank2(wq, prefix + ".self_attn.q_proj", [cfg.hidden_dim, qwidth])
        let tensor<f32, [D, K]> wk_t ← pin_rank2(wk, prefix + ".self_attn.k_proj", [cfg.hidden_dim, kwidth])
        let tensor<f32, [D, K]> wv_t ← pin_rank2(wv, prefix + ".self_attn.v_proj", [cfg.hidden_dim, kwidth])
        let tensor<f32, [Q, D]> wo_t ← pin_rank2(wo, prefix + ".self_attn.o_proj", [qwidth, cfg.hidden_dim])
        let tensor<f32, [D]> ln2 ← pin_rank1(ln2_s, prefix + ".post_attention_layernorm", [cfg.hidden_dim])
        let list<int> fwg ← wg.shape
        require fwg.length() ≡ 2 throw variant BadShape {message = "canonical tensor §.mlp.gate_proj must be rank 2"(prefix)}
        let int f ← fwg.get(1) coalesce 1
        let tensor<f32, [D, F]> wg_t ← pin_rank2(wg, prefix + ".mlp.gate_proj", [cfg.hidden_dim, f])
        let tensor<f32, [D, F]> wu_t ← pin_rank2(wu, prefix + ".mlp.up_proj", [cfg.hidden_dim, f])
        let tensor<f32, [F, D]> wd_t ← pin_rank2(wd, prefix + ".mlp.down_proj", [f, cfg.hidden_dim])

        # --- optional Q/K/V bias ------------------------------------------
        let BiasBag bq_bag ← optional_bias(source, prefix + ".self_attn.q_proj.bias", layer, qwidth)
        let tensor<f32, [Q]> bq ← pin_same_rank1(bq_bag.value, prefix + ".self_attn.q_proj.bias")
        let BiasBag bk_bag ← optional_bias(source, prefix + ".self_attn.k_proj.bias", layer, kwidth)
        let tensor<f32, [K]> bk ← pin_same_rank1(bk_bag.value, prefix + ".self_attn.k_proj.bias")
        let BiasBag bv_bag ← optional_bias(source, prefix + ".self_attn.v_proj.bias", layer, kwidth)
        let tensor<f32, [K]> bv ← pin_same_rank1(bv_bag.value, prefix + ".self_attn.v_proj.bias")

        # --- append layer -------------------------------------------------
        layers.append(DenseLayer {ln1 = ln1, wq = wq_t, bq = bq, has_bq = bq_bag.present, wk = wk_t, bk = bk, has_bk = bk_bag.present, wv = wv_t, bv = bv, has_bv = bv_bag.present, wo = wo_t, ln2 = ln2, wg = wg_t, wu = wu_t, wd = wd_t})
    }

    # --- final norm + lm_head ---------------------------------------------
    let tensor.NumericBlock norm_b ← source("model.norm", 0)
    let tensor<f32, [D]> norm ← pin_rank1(norm_b, "model.norm", [cfg.hidden_dim])
    mut tensor<f32, [D, V]> w_head ← embed_tokens.transpose().materialize()
    if not cfg.tied {
        let tensor.NumericBlock head_b ← source("lm_head", 0)
        w_head ← pin_rank2(head_b, "lm_head", [cfg.hidden_dim, cfg.vocab])
    }

    # --- construct model --------------------------------------------------
    return DenseModel {cfg = cfg, embed = embed, embed_tokens = embed_tokens, norm = norm, w_head = w_head, layers = layers}
}

# -------------------------------------------------------------------------
# forward — the complete ordered dense forward graph.
#
#   cfg        the typed architecture config (heads, layers, dims, vocab,
#              tie status)
#   source       canonical tensor-name → materialized stored-weight view
#   tokens     token ids [T] (embedding gather)
#   epsilon    RMSNorm epsilon (llama default 1e-5)
#   scale      dk scaling factor (1/sqrt(head_dim))
#   positions  RoPE positions, one per token
#   rope_dim   RoPE rotation width (≤ head_dim)
#   rope_cfg   the U1.3 configurable RoPE (base, scale, pair policy)
#
# Returns the logits [T, V]. Shape-generic at runtime (R3): no per-row
# special-case constants; every shape derives from cfg and the runtime
# tensors.
# -------------------------------------------------------------------------

@ public
fn forward(DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ DenseError source, list<int> tokens, f32 epsilon, f32 scale, list<int> positions, int rope_dim, rope.RopeConfig rope_cfg) → tensor.NumericBlock ⇥ DenseError {
    # --- config + sequence (fail closed) ----------------------------------
    require_cfg(cfg)
    require tokens.length() ≥ 1 throw variant BadConfig {message = "token sequence must be non-empty"}
    require positions.length() ≡ tokens.length() throw variant BadConfig {message = "positions must match the token count"}

    # --- embed gather (token-major view; tied head transposes later) ------
    let tensor.NumericBlock embed ← source("model.embed_tokens", 0)
    shape(embed, "model.embed_tokens", [cfg.hidden_dim, cfg.vocab])
    let tensor.NumericBlock embed_v ← token_major_view(embed)

    # --- per-layer blocks -------------------------------------------------
    let int qwidth ← cfg.heads * cfg.head_dim
    let int kwidth ← cfg.kv_heads * cfg.head_dim
    mut tensor.NumericBlock h ← collect(embed_v, tokens)
    for range 0‥cfg.layers let layer {
        let string prefix ← "model.layers.§"(layer ↦ string)

        # --- resolve stored weights ---------------------------------------
        let tensor.NumericBlock ln1_s ← source(prefix + ".input_layernorm", layer)
        let tensor.NumericBlock wq ← source(prefix + ".self_attn.q_proj", layer)
        let tensor.NumericBlock wk ← source(prefix + ".self_attn.k_proj", layer)
        let tensor.NumericBlock wv ← source(prefix + ".self_attn.v_proj", layer)
        let tensor.NumericBlock wo ← source(prefix + ".self_attn.o_proj", layer)
        let tensor.NumericBlock ln2_s ← source(prefix + ".post_attention_layernorm", layer)
        let tensor.NumericBlock wg ← source(prefix + ".mlp.gate_proj", layer)
        let tensor.NumericBlock wu ← source(prefix + ".mlp.up_proj", layer)
        let tensor.NumericBlock wd ← source(prefix + ".mlp.down_proj", layer)

        # --- shape contract against cfg -----------------------------------
        shape(ln1_s, prefix + ".input_layernorm", [cfg.hidden_dim])
        shape(wq, prefix + ".self_attn.q_proj", [cfg.hidden_dim, qwidth])
        shape(wk, prefix + ".self_attn.k_proj", [cfg.hidden_dim, kwidth])
        shape(wv, prefix + ".self_attn.v_proj", [cfg.hidden_dim, kwidth])
        shape(wo, prefix + ".self_attn.o_proj", [qwidth, qwidth])
        shape(ln2_s, prefix + ".post_attention_layernorm", [cfg.hidden_dim])
        let list<int> fwg ← wg.shape
        require fwg.length() ≡ 2 throw variant BadShape {message = "canonical tensor §.mlp.gate_proj must be rank 2"(prefix)}
        let int f ← fwg.get(1) coalesce 1
        shape(wu, prefix + ".mlp.up_proj", [cfg.hidden_dim, f])
        shape(wd, prefix + ".mlp.down_proj", [f, cfg.hidden_dim])

        # --- optional Q/K/V bias (MLP / output stay absent) ---------------
        let tensor.NumericBlock bq ← attn_bias(source, prefix + ".self_attn.q_proj.bias", layer, h, wq)
        let tensor.NumericBlock bk ← attn_bias(source, prefix + ".self_attn.k_proj.bias", layer, h, wk)
        let tensor.NumericBlock bv ← attn_bias(source, prefix + ".self_attn.v_proj.bias", layer, h, wv)
        let tensor.NumericBlock bg ← no_bias()
        let tensor.NumericBlock bu ← no_bias()
        let tensor.NumericBlock bd ← no_bias()

        # --- pack and apply the block -------------------------------------
        let transformer.DenseAttentionWeights attention_weights ← transformer.DenseAttentionWeights {wq = wq, bq = bq, wk = wk, bk = bk, wv = wv, bv = bv, wo = wo}
        let transformer.DenseAttentionConfig attention_config ← transformer.DenseAttentionConfig {num_heads = cfg.heads, num_kv_heads = cfg.kv_heads, scale = scale, rope_dim = rope_dim, rope_config = rope_cfg}
        let transformer.DenseMlpWeights mlp_weights ← transformer.DenseMlpWeights {wg = wg, bg = bg, wu = wu, bu = bu, wd = wd, bd = bd}
        let transformer.DenseNormConfig norm_config ← transformer.DenseNormConfig {ln1_s = ln1_s, ln2_s = ln2_s, epsilon = epsilon}
        h ← block(h, positions, attention_weights, attention_config, mlp_weights, norm_config)
    }

    # --- final RMSNorm ----------------------------------------------------
    let tensor.NumericBlock norm_s ← source("model.norm", 0)
    shape(norm_s, "model.norm", [cfg.hidden_dim])
    let tensor.NumericBlock hn ← rmsnorm(h, norm_s, epsilon)

    # --- output projection (tied transpose / untied lm_head) --------------
    mut tensor.NumericBlock w_head ← transpose(embed_v)
    if not cfg.tied {
        w_head ← source("lm_head", 0)
        shape(w_head, "lm_head", [cfg.hidden_dim, cfg.vocab])
    }
    let tensor.NumericBlock b_head ← no_bias()
    return linear(hn, w_head, b_head)
}

# -------------------------------------------------------------------------
# decode_step — ONE incremental dense decode over the per-layer KV cache.
# Token id + position + one cache per layer in → logits [1, V] + updated
# caches. All layers must share one prefix L; position must equal L
# (write_position = prefix_before). Overflow and gap reject before the
# cached block. Each layer then writes the same new row and advances
# together. empty_caches builds the starting state from a KVStructure
# (one empty KVCache per KV layer).
# -------------------------------------------------------------------------

@ public
class DenseStep {
    mut tensor.NumericBlock logits
    mut list<kv.KVCache> layers
}

@ public
fn default_step() → DenseStep {
    return DenseStep {logits = tensor.default(), layers = empty}
}

@ public
fn empty_caches(structure.KVStructure structure, string model, string model_version, string config, string tokenizer) → list<kv.KVCache> ⇥ DenseError {
    return structure.empty_layers(structure, model, model_version, config, tokenizer)
}

@ public
fn decode_step(DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ DenseError source, int token_id, int position, f32 epsilon, f32 scale, int rope_dim, rope.RopeConfig rope_cfg, list<kv.KVCache> layers) → DenseStep ⇥ DenseError {
    # --- config + cache (fail closed) -------------------------------------
    require_cfg(cfg)
    reject (token_id ≺ 0 or token_id ≥ cfg.vocab) throw variant IndexOutOfBounds {message = "token id out of range for the embedding"}
    require position ≥ 0 throw variant BadConfig {message = "position must be non-negative"}
    require layers.length() ≡ cfg.layers throw variant BadConfig {message = "cache layer count must equal the model layer count"}
    let int prefix_before ← shared_prefix(layers)
    require position ≡ prefix_before throw variant Gap {message = "position must equal the cache length"}
    admit_cached(layers, 1)

    # --- embed gather -----------------------------------------------------
    let tensor.NumericBlock embed ← source("model.embed_tokens", 0)
    shape(embed, "model.embed_tokens", [cfg.hidden_dim, cfg.vocab])
    let tensor.NumericBlock embed_v ← token_major_view(embed)

    # --- per-layer cached blocks ------------------------------------------
    let int qwidth ← cfg.heads * cfg.head_dim
    let int kwidth ← cfg.kv_heads * cfg.head_dim
    let list<int> positions ← [position]
    let list<int> tokens ← [token_id]
    mut tensor.NumericBlock h ← collect(embed_v, [token_id])
    mut list<kv.KVCache> next ← empty
    for range 0‥cfg.layers let layer {
        let string prefix ← "model.layers.§"(layer ↦ string)

        # --- resolve stored weights ---------------------------------------
        let tensor.NumericBlock ln1_s ← source(prefix + ".input_layernorm", layer)
        let tensor.NumericBlock wq ← source(prefix + ".self_attn.q_proj", layer)
        let tensor.NumericBlock wk ← source(prefix + ".self_attn.k_proj", layer)
        let tensor.NumericBlock wv ← source(prefix + ".self_attn.v_proj", layer)
        let tensor.NumericBlock wo ← source(prefix + ".self_attn.o_proj", layer)
        let tensor.NumericBlock ln2_s ← source(prefix + ".post_attention_layernorm", layer)
        let tensor.NumericBlock wg ← source(prefix + ".mlp.gate_proj", layer)
        let tensor.NumericBlock wu ← source(prefix + ".mlp.up_proj", layer)
        let tensor.NumericBlock wd ← source(prefix + ".mlp.down_proj", layer)

        # --- shape contract against cfg -----------------------------------
        shape(ln1_s, prefix + ".input_layernorm", [cfg.hidden_dim])
        shape(wq, prefix + ".self_attn.q_proj", [cfg.hidden_dim, qwidth])
        shape(wk, prefix + ".self_attn.k_proj", [cfg.hidden_dim, kwidth])
        shape(wv, prefix + ".self_attn.v_proj", [cfg.hidden_dim, kwidth])
        shape(wo, prefix + ".self_attn.o_proj", [qwidth, qwidth])
        shape(ln2_s, prefix + ".post_attention_layernorm", [cfg.hidden_dim])
        let list<int> fwg ← wg.shape
        require fwg.length() ≡ 2 throw variant BadShape {message = "canonical tensor §.mlp.gate_proj must be rank 2"(prefix)}
        let int f ← fwg.get(1) coalesce 1
        shape(wu, prefix + ".mlp.up_proj", [cfg.hidden_dim, f])
        shape(wd, prefix + ".mlp.down_proj", [f, cfg.hidden_dim])

        # --- optional Q/K/V bias (MLP / output stay absent) ---------------
        let tensor.NumericBlock bq ← attn_bias(source, prefix + ".self_attn.q_proj.bias", layer, h, wq)
        let tensor.NumericBlock bk ← attn_bias(source, prefix + ".self_attn.k_proj.bias", layer, h, wk)
        let tensor.NumericBlock bv ← attn_bias(source, prefix + ".self_attn.v_proj.bias", layer, h, wv)
        let tensor.NumericBlock bg ← no_bias()
        let tensor.NumericBlock bu ← no_bias()
        let tensor.NumericBlock bd ← no_bias()

        # --- pack and apply the cached block ------------------------------
        let kv.KVCache cache ← layers.get(layer) coalesce kv.default()
        let transformer.DenseAttentionWeights attention_weights ← transformer.DenseAttentionWeights {wq = wq, bq = bq, wk = wk, bk = bk, wv = wv, bv = bv, wo = wo}
        let transformer.DenseAttentionConfig attention_config ← transformer.DenseAttentionConfig {num_heads = cfg.heads, num_kv_heads = cfg.kv_heads, scale = scale, rope_dim = rope_dim, rope_config = rope_cfg}
        let transformer.DenseMlpWeights mlp_weights ← transformer.DenseMlpWeights {wg = wg, bg = bg, wu = wu, bu = bu, wd = wd, bd = bd}
        let transformer.DenseNormConfig norm_config ← transformer.DenseNormConfig {ln1_s = ln1_s, ln2_s = ln2_s, epsilon = epsilon}
        let transformer.CachedBlock block ← block_cached(h, positions, cache, tokens, attention_weights, attention_config, mlp_weights, norm_config)
        h ← block.output
        next.append(block.state)
    }

    # --- final RMSNorm ----------------------------------------------------
    let tensor.NumericBlock norm_s ← source("model.norm", 0)
    shape(norm_s, "model.norm", [cfg.hidden_dim])
    let tensor.NumericBlock hn ← rmsnorm(h, norm_s, epsilon)

    # --- output projection (tied transpose / untied lm_head) --------------
    mut tensor.NumericBlock w_head ← transpose(embed_v)
    if not cfg.tied {
        w_head ← source("lm_head", 0)
        shape(w_head, "lm_head", [cfg.hidden_dim, cfg.vocab])
    }
    let tensor.NumericBlock b_head ← no_bias()
    return DenseStep {logits = linear(hn, w_head, b_head), layers = next}
}

# -------------------------------------------------------------------------
# decode_block — multi-row incremental dense decode over a non-empty
# per-layer KV cache. Candidate token ids + one cache per layer in → logits
# [T, V] + updated caches. All layers share one prefix L; the rows are
# written at absolute positions L..L+T-1 and each causal row sees the
# accepted prefix plus the candidate rows through its own position. This is
# the additive SD2 seam; decode_step and prefill_cached retain their
# respective scalar and empty-prefix contracts.
# -------------------------------------------------------------------------

@ public
fn decode_block(DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ DenseError source, list<int> tokens, f32 epsilon, f32 scale, int rope_dim, rope.RopeConfig rope_cfg, list<kv.KVCache> layers) → DenseStep ⇥ DenseError {
    # --- config + cache (fail closed) -------------------------------------
    require_cfg(cfg)
    require tokens.length() ≥ 1 throw variant BadConfig {message = "token sequence must be non-empty"}
    require layers.length() ≡ cfg.layers throw variant BadConfig {message = "cache layer count must equal the model layer count"}
    for from tokens let token_id {
        reject (token_id ≺ 0 or token_id ≥ cfg.vocab) throw variant IndexOutOfBounds {message = "token id out of range for the embedding"}
    }
    let int prefix_before ← shared_prefix(layers)
    require prefix_before ≥ 1 throw variant Gap {message = "cache write leaves a gap"}
    admit_cached(layers, tokens.length())

    # --- embed gather -----------------------------------------------------
    let tensor.NumericBlock embed ← source("model.embed_tokens", 0)
    shape(embed, "model.embed_tokens", [cfg.hidden_dim, cfg.vocab])
    let tensor.NumericBlock embed_v ← token_major_view(embed)

    # --- per-layer cached blocks ------------------------------------------
    let int qwidth ← cfg.heads * cfg.head_dim
    let int kwidth ← cfg.kv_heads * cfg.head_dim
    mut list<int> positions ← empty
    for range prefix_before‥(prefix_before + tokens.length()) let i {
        positions.append(i)
    }
    mut tensor.NumericBlock h ← collect(embed_v, tokens)
    mut list<kv.KVCache> next ← empty
    for range 0‥cfg.layers let layer {
        let string prefix ← "model.layers.§"(layer ↦ string)

        # --- resolve stored weights ---------------------------------------
        let tensor.NumericBlock ln1_s ← source(prefix + ".input_layernorm", layer)
        let tensor.NumericBlock wq ← source(prefix + ".self_attn.q_proj", layer)
        let tensor.NumericBlock wk ← source(prefix + ".self_attn.k_proj", layer)
        let tensor.NumericBlock wv ← source(prefix + ".self_attn.v_proj", layer)
        let tensor.NumericBlock wo ← source(prefix + ".self_attn.o_proj", layer)
        let tensor.NumericBlock ln2_s ← source(prefix + ".post_attention_layernorm", layer)
        let tensor.NumericBlock wg ← source(prefix + ".mlp.gate_proj", layer)
        let tensor.NumericBlock wu ← source(prefix + ".mlp.up_proj", layer)
        let tensor.NumericBlock wd ← source(prefix + ".mlp.down_proj", layer)

        # --- shape contract against cfg -----------------------------------
        shape(ln1_s, prefix + ".input_layernorm", [cfg.hidden_dim])
        shape(wq, prefix + ".self_attn.q_proj", [cfg.hidden_dim, qwidth])
        shape(wk, prefix + ".self_attn.k_proj", [cfg.hidden_dim, kwidth])
        shape(wv, prefix + ".self_attn.v_proj", [cfg.hidden_dim, kwidth])
        shape(wo, prefix + ".self_attn.o_proj", [qwidth, qwidth])
        shape(ln2_s, prefix + ".post_attention_layernorm", [cfg.hidden_dim])
        let list<int> fwg ← wg.shape
        require fwg.length() ≡ 2 throw variant BadShape {message = "canonical tensor §.mlp.gate_proj must be rank 2"(prefix)}
        let int f ← fwg.get(1) coalesce 1
        shape(wu, prefix + ".mlp.up_proj", [cfg.hidden_dim, f])
        shape(wd, prefix + ".mlp.down_proj", [f, cfg.hidden_dim])

        # --- optional Q/K/V bias (MLP / output stay absent) ---------------
        let tensor.NumericBlock bq ← attn_bias(source, prefix + ".self_attn.q_proj.bias", layer, h, wq)
        let tensor.NumericBlock bk ← attn_bias(source, prefix + ".self_attn.k_proj.bias", layer, h, wk)
        let tensor.NumericBlock bv ← attn_bias(source, prefix + ".self_attn.v_proj.bias", layer, h, wv)
        let tensor.NumericBlock bg ← no_bias()
        let tensor.NumericBlock bu ← no_bias()
        let tensor.NumericBlock bd ← no_bias()

        # --- pack and apply the cached block ------------------------------
        let kv.KVCache cache ← layers.get(layer) coalesce kv.default()
        let transformer.DenseAttentionWeights attention_weights ← transformer.DenseAttentionWeights {wq = wq, bq = bq, wk = wk, bk = bk, wv = wv, bv = bv, wo = wo}
        let transformer.DenseAttentionConfig attention_config ← transformer.DenseAttentionConfig {num_heads = cfg.heads, num_kv_heads = cfg.kv_heads, scale = scale, rope_dim = rope_dim, rope_config = rope_cfg}
        let transformer.DenseMlpWeights mlp_weights ← transformer.DenseMlpWeights {wg = wg, bg = bg, wu = wu, bu = bu, wd = wd, bd = bd}
        let transformer.DenseNormConfig norm_config ← transformer.DenseNormConfig {ln1_s = ln1_s, ln2_s = ln2_s, epsilon = epsilon}
        let transformer.CachedBlock block ← block_cached(h, positions, cache, tokens, attention_weights, attention_config, mlp_weights, norm_config)
        h ← block.output
        next.append(block.state)
    }

    # --- final RMSNorm ----------------------------------------------------
    let tensor.NumericBlock norm_s ← source("model.norm", 0)
    shape(norm_s, "model.norm", [cfg.hidden_dim])
    let tensor.NumericBlock hn ← rmsnorm(h, norm_s, epsilon)

    # --- output projection (tied transpose / untied lm_head) --------------
    mut tensor.NumericBlock w_head ← transpose(embed_v)
    if not cfg.tied {
        w_head ← source("lm_head", 0)
        shape(w_head, "lm_head", [cfg.hidden_dim, cfg.vocab])
    }
    let tensor.NumericBlock b_head ← no_bias()
    return DenseStep {logits = linear(hn, w_head, b_head), layers = next}
}

# -------------------------------------------------------------------------
# prefill_cached — batched dense prefill over the per-layer KV caches.
# Frozen coordinates: prefix_before = 0, query_rows = T, write_range =
# [0, T). All layers must share that empty prefix and advance together.
# Overflow and gap reject before the cached block. The returned logits
# retain every prompt row so the generation caller can select the final
# row without re-running it.
# -------------------------------------------------------------------------

@ public
fn prefill_cached(DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ DenseError source, list<int> tokens, f32 epsilon, f32 scale, int rope_dim, rope.RopeConfig rope_cfg, list<kv.KVCache> layers) → DenseStep ⇥ DenseError {
    # --- config + cache (fail closed) -------------------------------------
    require_cfg(cfg)
    require tokens.length() ≥ 1 throw variant BadConfig {message = "token sequence must be non-empty"}
    require layers.length() ≡ cfg.layers throw variant BadConfig {message = "cache layer count must equal the model layer count"}
    for from tokens let token_id {
        reject (token_id ≺ 0 or token_id ≥ cfg.vocab) throw variant IndexOutOfBounds {message = "token id out of range for the embedding"}
    }
    let int prefix_before ← shared_prefix(layers)
    require prefix_before ≡ 0 throw variant Gap {message = "cache write leaves a gap"}
    admit_cached(layers, tokens.length())

    # --- embed gather -----------------------------------------------------
    let tensor.NumericBlock embed ← source("model.embed_tokens", 0)
    shape(embed, "model.embed_tokens", [cfg.hidden_dim, cfg.vocab])
    let tensor.NumericBlock embed_v ← token_major_view(embed)

    # --- per-layer cached blocks ------------------------------------------
    let int qwidth ← cfg.heads * cfg.head_dim
    let int kwidth ← cfg.kv_heads * cfg.head_dim
    mut list<int> positions ← empty
    for range 0‥tokens.length() let i {
        positions.append(i)
    }
    mut tensor.NumericBlock h ← collect(embed_v, tokens)
    mut list<kv.KVCache> next ← empty
    for range 0‥cfg.layers let layer {
        let string prefix ← "model.layers.§"(layer ↦ string)

        # --- resolve stored weights ---------------------------------------
        let tensor.NumericBlock ln1_s ← source(prefix + ".input_layernorm", layer)
        let tensor.NumericBlock wq ← source(prefix + ".self_attn.q_proj", layer)
        let tensor.NumericBlock wk ← source(prefix + ".self_attn.k_proj", layer)
        let tensor.NumericBlock wv ← source(prefix + ".self_attn.v_proj", layer)
        let tensor.NumericBlock wo ← source(prefix + ".self_attn.o_proj", layer)
        let tensor.NumericBlock ln2_s ← source(prefix + ".post_attention_layernorm", layer)
        let tensor.NumericBlock wg ← source(prefix + ".mlp.gate_proj", layer)
        let tensor.NumericBlock wu ← source(prefix + ".mlp.up_proj", layer)
        let tensor.NumericBlock wd ← source(prefix + ".mlp.down_proj", layer)

        # --- shape contract against cfg -----------------------------------
        shape(ln1_s, prefix + ".input_layernorm", [cfg.hidden_dim])
        shape(wq, prefix + ".self_attn.q_proj", [cfg.hidden_dim, qwidth])
        shape(wk, prefix + ".self_attn.k_proj", [cfg.hidden_dim, kwidth])
        shape(wv, prefix + ".self_attn.v_proj", [cfg.hidden_dim, kwidth])
        shape(wo, prefix + ".self_attn.o_proj", [qwidth, qwidth])
        shape(ln2_s, prefix + ".post_attention_layernorm", [cfg.hidden_dim])
        let list<int> fwg ← wg.shape
        require fwg.length() ≡ 2 throw variant BadShape {message = "canonical tensor §.mlp.gate_proj must be rank 2"(prefix)}
        let int f ← fwg.get(1) coalesce 1
        shape(wu, prefix + ".mlp.up_proj", [cfg.hidden_dim, f])
        shape(wd, prefix + ".mlp.down_proj", [f, cfg.hidden_dim])

        # --- optional Q/K/V bias (MLP / output stay absent) ---------------
        let tensor.NumericBlock bq ← attn_bias(source, prefix + ".self_attn.q_proj.bias", layer, h, wq)
        let tensor.NumericBlock bk ← attn_bias(source, prefix + ".self_attn.k_proj.bias", layer, h, wk)
        let tensor.NumericBlock bv ← attn_bias(source, prefix + ".self_attn.v_proj.bias", layer, h, wv)
        let tensor.NumericBlock bg ← no_bias()
        let tensor.NumericBlock bu ← no_bias()
        let tensor.NumericBlock bd ← no_bias()

        # --- pack and apply the cached block ------------------------------
        let kv.KVCache cache ← layers.get(layer) coalesce kv.default()
        let transformer.DenseAttentionWeights attention_weights ← transformer.DenseAttentionWeights {wq = wq, bq = bq, wk = wk, bk = bk, wv = wv, bv = bv, wo = wo}
        let transformer.DenseAttentionConfig attention_config ← transformer.DenseAttentionConfig {num_heads = cfg.heads, num_kv_heads = cfg.kv_heads, scale = scale, rope_dim = rope_dim, rope_config = rope_cfg}
        let transformer.DenseMlpWeights mlp_weights ← transformer.DenseMlpWeights {wg = wg, bg = bg, wu = wu, bu = bu, wd = wd, bd = bd}
        let transformer.DenseNormConfig norm_config ← transformer.DenseNormConfig {ln1_s = ln1_s, ln2_s = ln2_s, epsilon = epsilon}
        let transformer.CachedBlock block ← block_cached(h, positions, cache, tokens, attention_weights, attention_config, mlp_weights, norm_config)
        h ← block.output
        next.append(block.state)
    }

    # --- final RMSNorm ----------------------------------------------------
    let tensor.NumericBlock norm_s ← source("model.norm", 0)
    shape(norm_s, "model.norm", [cfg.hidden_dim])
    let tensor.NumericBlock hn ← rmsnorm(h, norm_s, epsilon)

    # --- output projection (tied transpose / untied lm_head) --------------
    mut tensor.NumericBlock w_head ← transpose(embed_v)
    if not cfg.tied {
        w_head ← source("lm_head", 0)
        shape(w_head, "lm_head", [cfg.hidden_dim, cfg.vocab])
    }
    let tensor.NumericBlock b_head ← no_bias()
    return DenseStep {logits = linear(hn, w_head, b_head), layers = next}
}
