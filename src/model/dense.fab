+++
locale = "en"
+++
# REF-01-U1.8 — dense model assembly (gradus:model/dense).
#
# Public import: importa ex "gradus:model/dense" dense
# Depends on: gradus:attention (RopeConfigura), gradus:tensor (staged
#   carrier), gradus:transformer (dense_block, REF-01-U1.5), gradus:nn
#   (rmsnorm / linear rows, REF-01-U1.1 / the PML3 surface).
#
# The complete ordered dense forward graph:
#   embedding gather → N ordered U1.5 blocks → final RMSNorm → output
#   projection,
# assembled from the typed architecture config and materialized tensor
# views via canonical names. The caller supplies a resolver (`fons`) that
# returns the materialized STORED-weight view for one canonical tensor name
# (model.embed_tokens, model.layers.{N}.input_layernorm,
# .self_attn.{q,k,v,o}_proj, .post_attention_layernorm, .mlp.{gate,up,down}_proj,
# model.norm, lm_head) plus a layer index — the GGUF/A1b descriptor layout
# (token_embd.weight is [D, V] in the GGUF/ggml descriptor — dim0 = D
# innermost, so the stored f32 buffer is already token-major). The
# assembly gathers at index [token * D + d] without a data transpose, and
# materializes a true row-major [D, V] only for a TIED lm_head; an UNTIED
# row resolves lm_head separately. Zero per-row special-case constants:
# every shape derives from the config and the runtime tensors.
#
# Fails closed with typed diagnostics on: an unknown/missing canonical
# tensor (resolver successus = falsum → TensorAbsens), an invalid
# architecture config (ConfiguraMala), a shape that contradicts the config
# (FormaMala), and token ids outside the embedding vocabulary
# (TerminusExcedit). Sub-call errors from nn / transformer / tensor are
# mapped into FormaMala preserving the documented causa text.
#
# The F32 row is the admitted row (the composed rows' contract). The
# surface is forward-only: no autograd import, no gradient path.

import from "gradus:attention" attention

import from "gradus:nn" nn

import from "gradus:tensor" tensor

import from "gradus:transformer" transformer

# -------------------------------------------------------------------------
# ConfiguraDensa — the typed dense architecture config the assembly is
# built from. `ligatum` records tied embeddings (lm_head shares the
# embedding tensor). No per-row constants: the head counts and dims are
# carried here and every shape is validated against them.
# -------------------------------------------------------------------------


@ public { }
class DenseConfig {
    int layers
    int heads
    int kv_heads
    int head_dim
    int hidden_dim
    int vocab
    bool tied
}

# One resolver answer: successus = verum carries the materialized
# stored-weight view for the requested canonical tensor; successus = falsum
# carries the causa (the assembly maps it into TensorAbsens). The LectioFontis
# seam pattern (gguf_manifest), so the consumer closure never needs to
# construct the module's typed error.

@ public { }
class Lookup {
    bool successus
    tensor.Tensor tensorem
    string message
}

# -------------------------------------------------------------------------
# DenseError — typed error vocabulary of the dense assembly. Every variant
# carries a textus causa (render via causa).
# -------------------------------------------------------------------------


@ public { }
union DenseError {
    TensorAbsens {
        string message
    },
    ConfiguraMala {
        string message
    },
    FormaMala {
        string message
    },
    TerminusExcedit {
        string message
    }
}

@ public { }
fn message(DenseError e) → string {
    match e {
        case TensorAbsens const causa {
            return causa
        }
        case ConfiguraMala const causa {
            return causa
        }
        case FormaMala const causa {
            return causa
        }
        case TerminusExcedit const causa {
            return causa
        }
    }
}

# -------------------------------------------------------------------------
# Private helpers — each wraps a primitive sub-call or an assembly step and
# maps its failure into DenseError preserving the documented causa text.
# -------------------------------------------------------------------------

# Resolve one canonical tensor; a resolver failure becomes TensorAbsens
# carrying the resolver's causa verbatim.
@ private { }
fn _source((string, int) → Lookup fons, string nomen, int stratum) → tensor.Tensor ⇥ DenseError {
    const Lookup r ← fons(nomen, stratum)
    if r.successus then return r.tensorem
    throw variant TensorAbsens {message = r.message}
}

# Shape render for diagnostics (no lista→textus cast exists).
@ private { }
fn _shape_text(list<int> f) → string {
    var string out ← ""
    const int n ← f.length()
    var int i ← 0
    while i ≺ n {
        if i ≻ 0 {
            out ← out + ","
        }
        out ← out + (f.get(i) coalesce 0 ↦ string)
        i ← i + 1
    }
    return out
}

# Validate a canonical tensor's runtime shape against the config-derived
# expectation; passes the tensor through on success.
@ private { }
fn _shape(tensor.Tensor t, string nomen, list<int> expectata) → tensor.Tensor ⇥ DenseError {
    const list<int> f ← t.shape()
    if f ≠ expectata {
        throw variant FormaMala {message = (((("canonical tensor " + nomen) + " has shape ") + _shape_text(f)) + ", expected ") + _shape_text(expectata)}
    }
    return t
}

# Reinterpret a stored [D, V] ggml embedding as token-major [V, D] without
# permuting data. GGUF dim0 = D is innermost, so the flat buffer is already
# data[token * D + d].
@ private { }
fn _token_major_view(tensor.Tensor t) → tensor.Tensor ⇥ DenseError {
    const list<int> f ← t.shape()
    if f.length() ≠ 2 {
        throw variant FormaMala {message = "embedding must be rank 2"}
    }
    const int hidden ← f.get(0) coalesce 1
    const int vocab ← f.get(1) coalesce 1
    do {
        return tensor.construct(t.data, [vocab, hidden])
    }
    catch err {
        throw variant FormaMala {message = tensor.message(err)}
    }
}

# Rank-2 transpose [rows, cols] → [cols, rows] (math has no transpose; a
# TIED lm_head needs the true row-major [D, V] from the token-major view).
@ private { }
fn _transpose(tensor.Tensor t) → tensor.Tensor ⇥ DenseError {
    const list<int> f ← t.shape()
    if f.length() ≠ 2 {
        throw variant FormaMala {message = "embedding must be rank 2"}
    }
    const int rows ← f.get(0) coalesce 1
    const int cols ← f.get(1) coalesce 1
    var list<f32> out ← vacua
    var int j ← 0
    while j ≺ cols {
        var int i ← 0
        while i ≺ rows {
            out.append(t.data.get(i * cols + j) coalesce 0.0 ∷ f32)
            i ← i + 1
        }
        j ← j + 1
    }
    do {
        return tensor.construct(out, [cols, rows])
    }
    catch err {
        throw variant FormaMala {message = tensor.message(err)}
    }
}

# Embedding gather: token-major embed [V, D] → rows for the token ids.
@ private { }
fn _collect(tensor.Tensor embed, list<int> tokens) → tensor.Tensor ⇥ DenseError {
    const list<int> fe ← embed.shape()
    if fe.length() ≠ 2 {
        throw variant FormaMala {message = "embedding must be rank 2"}
    }
    const int v ← fe.get(0) coalesce 1
    const int d ← fe.get(1) coalesce 1
    var list<f32> out ← vacua
    for from tokens const tok {
        if tok ≺ 0 or tok ≥ v {
            throw variant TerminusExcedit {message = "token id out of range for the embedding"}
        }
        for range 0‥d const j {
            out.append(embed.data.get(tok * d + j) coalesce 0.0 ∷ f32)
        }
    }
    const list<int> ft ← [tokens.length(), d]
    do {
        return tensor.construct(out, ft)
    }
    catch err {
        throw variant FormaMala {message = tensor.message(err)}
    }
}

# Same-shape zero bias [T, N] for one linear row: the executed bias
# contract of the composed surface (per-channel [N] against [M, N] needs
# singleton broadcast, which forma.broadcastum rejects at runtime — the
# recorded broadcastum rank-mismatch constraint, dense-swiglu precedent).
@ private { }
fn _no_bias(tensor.Tensor x, tensor.Tensor w) → tensor.Tensor ⇥ DenseError {
    const list<int> fx ← x.shape()
    const list<int> fw ← w.shape()
    if fx.length() ≠ 2 {
        throw variant FormaMala {message = "block input must be rank 2"}
    }
    if fw.length() ≠ 2 {
        throw variant FormaMala {message = "block weight must be rank 2"}
    }
    const int t ← fx.get(0) coalesce 1
    const int n ← fw.get(1) coalesce 1
    do {
        return tensor.fill([t, n], 0.0 ∷ f32)
    }
    catch err {
        throw variant FormaMala {message = tensor.message(err)}
    }
}

# rmsnorm wrapper — nn.rmsnorm → DenseError (causa text preserved).
@ private { }
fn _rmsnorm(tensor.Tensor x, tensor.Tensor s, f32 epsilon) → tensor.Tensor ⇥ DenseError {
    do {
        return nn.rmsnorm(x, s, epsilon)
    }
    catch err {
        throw variant FormaMala {message = nn.message(err)}
    }
}

# linear wrapper — nn.linear → DenseError (causa text preserved).
@ private { }
fn _linear(tensor.Tensor x, tensor.Tensor w, tensor.Tensor b) → tensor.Tensor ⇥ DenseError {
    do {
        return nn.linear(x, w, b)
    }
    catch err {
        throw variant FormaMala {message = nn.message(err)}
    }
}

# dense_block wrapper — transformer.dense_block → DenseError (causa text
# preserved).
@ private { }
fn _block(tensor.Tensor x, tensor.Tensor ln1_s, f32 epsilon, tensor.Tensor wq, tensor.Tensor bq, tensor.Tensor wk, tensor.Tensor bk, tensor.Tensor wv, tensor.Tensor bv, tensor.Tensor wo, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, attention.RopeConfig cfg, tensor.Tensor ln2_s, tensor.Tensor wg, tensor.Tensor bg, tensor.Tensor wu, tensor.Tensor bu, tensor.Tensor wd, tensor.Tensor bd) → tensor.Tensor ⇥ DenseError {
    do {
        return transformer.dense_block(x, ln1_s, epsilon, wq, bq, wk, bk, wv, bv, wo, num_heads, num_kv_heads, scale, positions, rope_dim, cfg, ln2_s, wg, bg, wu, bu, wd, bd)
    }
    catch err {
        throw variant FormaMala {message = transformer.message(err)}
    }
}

# -------------------------------------------------------------------------
# praevideo — the complete ordered dense forward graph.
#
#   cfg        the typed architecture config (heads, layers, dims, vocab,
#              tie status)
#   fons       canonical tensor-name → materialized stored-weight view
#   tokens     token ids [T] (embedding gather)
#   epsilon    RMSNorm epsilon (llama default 1e-5)
#   scale      dk scaling factor (1/sqrt(head_dim))
#   positions  RoPE positions, one per token
#   rope_dim   RoPE rotation width (≤ head_dim)
#   rope_cfg   the U1.3 configurable RoPE (base, scale, pair policy)
#
# Returns the logits [T, V]. Shape-generic at runtime (R3): no per-row
# special-case constants; every shape derives from cfg and the runtime
# tensors.
# -------------------------------------------------------------------------

@ public { }
fn forward(DenseConfig cfg, (string, int) → Lookup fons, list<int> tokens, f32 epsilon, f32 scale, list<int> positions, int rope_dim, attention.RopeConfig rope_cfg) → tensor.Tensor ⇥ DenseError {
    if cfg.layers ≺ 1 {
        throw variant ConfiguraMala {message = "layer count must be at least 1"}
    }
    if cfg.heads ≺ 1 {
        throw variant ConfiguraMala {message = "head count must be at least 1"}
    }
    if cfg.kv_heads ≺ 1 or cfg.kv_heads ≻ cfg.heads {
        throw variant ConfiguraMala {message = "KV head count must be between 1 and the head count"}
    }
    if cfg.heads % cfg.kv_heads ≠ 0 {
        throw variant ConfiguraMala {message = "head count must be a multiple of the KV head count"}
    }
    if cfg.head_dim ≺ 1 {
        throw variant ConfiguraMala {message = "head dim must be at least 1"}
    }
    if cfg.hidden_dim ≺ 1 {
        throw variant ConfiguraMala {message = "hidden dim must be at least 1"}
    }
    if cfg.vocab ≺ 1 {
        throw variant ConfiguraMala {message = "vocabulary size must be at least 1"}
    }
    if tokens.length() ≺ 1 {
        throw variant ConfiguraMala {message = "token sequence must be non-empty"}
    }
    if positions.length() ≠ tokens.length() {
        throw variant ConfiguraMala {message = "positions must match the token count"}
    }

    # Embedding: the resolver returns the stored [D, V] GGUF/A1b descriptor
    # (ggml dim0 = D innermost). The buffer is already token-major — gather
    # at [token * D + d], no data transpose. A TIED lm_head later transposes
    # this view into true row-major [D, V] for the output linear.
    const tensor.Tensor embed ← _source(fons, "model.embed_tokens", 0)
    _shape(embed, "model.embed_tokens", [cfg.hidden_dim, cfg.vocab])
    const tensor.Tensor embed_v ← _token_major_view(embed)
    const tensor.Tensor x ← _collect(embed_v, tokens)

    # N ordered U1.5 blocks. Every weight is resolved by its canonical name
    # at the current layer index; every shape is validated against the
    # config (the MLP hidden width derives from the gate/up width at
    # runtime). The biases are synthesized zero same-shape tensors (the
    # composed rows carry no bias weights).
    const int qwidth ← cfg.heads * cfg.head_dim
    const int kwidth ← cfg.kv_heads * cfg.head_dim
    var tensor.Tensor h ← x
    var int stratum ← 0
    while stratum ≺ cfg.layers {
        const string prefix ← "model.layers." + (stratum ↦ string)
        const tensor.Tensor ln1_s ← _source(fons, prefix + ".input_layernorm", stratum)
        const tensor.Tensor wq ← _source(fons, prefix + ".self_attn.q_proj", stratum)
        const tensor.Tensor wk ← _source(fons, prefix + ".self_attn.k_proj", stratum)
        const tensor.Tensor wv ← _source(fons, prefix + ".self_attn.v_proj", stratum)
        const tensor.Tensor wo ← _source(fons, prefix + ".self_attn.o_proj", stratum)
        const tensor.Tensor ln2_s ← _source(fons, prefix + ".post_attention_layernorm", stratum)
        const tensor.Tensor wg ← _source(fons, prefix + ".mlp.gate_proj", stratum)
        const tensor.Tensor wu ← _source(fons, prefix + ".mlp.up_proj", stratum)
        const tensor.Tensor wd ← _source(fons, prefix + ".mlp.down_proj", stratum)
        _shape(ln1_s, prefix + ".input_layernorm", [cfg.hidden_dim])
        _shape(wq, prefix + ".self_attn.q_proj", [cfg.hidden_dim, qwidth])
        _shape(wk, prefix + ".self_attn.k_proj", [cfg.hidden_dim, kwidth])
        _shape(wv, prefix + ".self_attn.v_proj", [cfg.hidden_dim, kwidth])
        _shape(wo, prefix + ".self_attn.o_proj", [qwidth, qwidth])
        _shape(ln2_s, prefix + ".post_attention_layernorm", [cfg.hidden_dim])
        const list<int> fwg ← wg.shape()
        if fwg.length() ≠ 2 {
            throw variant FormaMala {message = ("canonical tensor " + prefix) + ".mlp.gate_proj must be rank 2"}
        }
        const int f ← fwg.get(1) coalesce 1
        _shape(wu, prefix + ".mlp.up_proj", [cfg.hidden_dim, f])
        _shape(wd, prefix + ".mlp.down_proj", [f, cfg.hidden_dim])
        const tensor.Tensor bq ← _no_bias(h, wq)
        const tensor.Tensor bk ← _no_bias(h, wk)
        const tensor.Tensor bv ← _no_bias(h, wv)
        const tensor.Tensor bg ← _no_bias(h, wg)
        const tensor.Tensor bu ← _no_bias(h, wu)
        const tensor.Tensor bd ← _no_bias(h, wd)
        h ← _block(h, ln1_s, epsilon, wq, bq, wk, bk, wv, bv, wo, cfg.heads, cfg.kv_heads, scale, positions, rope_dim, rope_cfg, ln2_s, wg, bg, wu, bu, wd, bd)
        stratum ← stratum + 1
    }

    # Final RMSNorm.
    const tensor.Tensor norm_s ← _source(fons, "model.norm", 0)
    _shape(norm_s, "model.norm", [cfg.hidden_dim])
    const tensor.Tensor hn ← _rmsnorm(h, norm_s, epsilon)

    # Output projection. A TIED lm_head transposes the token-major embed
    # view into true row-major [D, V] (the linear [in, out] layout); an
    # UNTIED row resolves lm_head as its own canonical tensor.
    var tensor.Tensor w_head ← _transpose(embed_v)
    if not cfg.tied {
        w_head ← _source(fons, "lm_head", 0)
        _shape(w_head, "lm_head", [cfg.hidden_dim, cfg.vocab])
    }
    const tensor.Tensor b_head ← _no_bias(hn, w_head)
    return _linear(hn, w_head, b_head)
}
