# REF-01-U1.8 — dense model assembly (gradus:model/dense).
#
# Public import: importa ex "gradus:model/dense" dense
# Depends on: gradus:attention (RopeConfigura), gradus:tensor (staged
#   carrier), gradus:transformer (dense_block, REF-01-U1.5), gradus:nn
#   (rmsnorm / linear rows, REF-01-U1.1 / the PML3 surface).
#
# The complete ordered dense forward graph:
#   embedding gather → N ordered U1.5 blocks → final RMSNorm → output
#   projection,
# assembled from the typed architecture config and materialized tensor
# views via canonical names. The caller supplies a resolver (`fons`) that
# returns the materialized STORED-weight view for one canonical tensor name
# (model.embed_tokens, model.layers.{N}.input_layernorm,
# .self_attn.{q,k,v,o}_proj, .post_attention_layernorm, .mlp.{gate,up,down}_proj,
# model.norm, lm_head) plus a layer index — the GGUF/A1b descriptor layout
# (token_embd.weight is [D, V]). The assembly transposes the embedding for
# the token-major gather and reuses it directly for a TIED lm_head; an
# UNTIED row resolves lm_head separately. Zero per-row special-case
# constants: every shape derives from the config and the runtime tensors.
#
# Fails closed with typed diagnostics on: an unknown/missing canonical
# tensor (resolver successus = falsum → TensorAbsens), an invalid
# architecture config (ConfiguraMala), a shape that contradicts the config
# (FormaMala), and token ids outside the embedding vocabulary
# (TerminusExcedit). Sub-call errors from nn / transformer / tensor are
# mapped into FormaMala preserving the documented causa text.
#
# The F32 row is the admitted row (the composed rows' contract). The
# surface is forward-only: no autograd import, no gradient path.

importa ex "gradus:attention" attention
importa ex "gradus:nn" nn
importa ex "gradus:tensor" tensor
importa ex "gradus:transformer" transformer

# -------------------------------------------------------------------------
# ConfiguraDensa — the typed dense architecture config the assembly is
# built from. `ligatum` records tied embeddings (lm_head shares the
# embedding tensor). No per-row constants: the head counts and dims are
# carried here and every shape is validated against them.
# -------------------------------------------------------------------------

@ publica
genus ConfiguraDensa {
    numerus strata
    numerus capita
    numerus capita_kv
    numerus dimensio_capitis
    numerus dimensio_occulta
    numerus vocabulum
    bivalens ligatum
}

# One resolver answer: successus = verum carries the materialized
# stored-weight view for the requested canonical tensor; successus = falsum
# carries the causa (the assembly maps it into TensorAbsens). The LectioFontis
# seam pattern (gguf_manifest), so the consumer closure never needs to
# construct the module's typed error.
@ publica
genus Repertum {
    bivalens successus
    tensor.Tensor tensorem
    textus causa
}

# -------------------------------------------------------------------------
# DenseError — typed error vocabulary of the dense assembly. Every variant
# carries a textus causa (render via causa).
# -------------------------------------------------------------------------

@ publica
discretio DenseError {
    TensorAbsens { textus causa }
    ConfiguraMala { textus causa }
    FormaMala { textus causa }
    TerminusExcedit { textus causa }
}

@ publica
functio causa(DenseError e) → textus {
    discerne e {
        casu TensorAbsens fixum causa { redde causa }
        casu ConfiguraMala fixum causa { redde causa }
        casu FormaMala fixum causa { redde causa }
        casu TerminusExcedit fixum causa { redde causa }
    }
}

# -------------------------------------------------------------------------
# Private helpers — each wraps a primitive sub-call or an assembly step and
# maps its failure into DenseError preserving the documented causa text.
# -------------------------------------------------------------------------

# Resolve one canonical tensor; a resolver failure becomes TensorAbsens
# carrying the resolver's causa verbatim.
@ privata
functio _fons((textus, numerus) → Repertum fons, textus nomen, numerus stratum) → tensor.Tensor ⇥ DenseError {
    fixum Repertum r ← fons(nomen, stratum)
    si r.successus {
        redde r.tensorem
    }
    iace finge TensorAbsens { causa = r.causa }
}

# Shape render for diagnostics (no lista→textus cast exists).
@ privata
functio _forma_textus(lista<numerus> f) → textus {
    varia textus out ← ""
    fixum numerus n ← f.longitudo()
    varia numerus i ← 0
    dum i < n {
        si i > 0 {
            out ← out + ","
        }
        out ← out + ((f.accipe(i) vel 0) ↦ textus)
        i ← i + 1
    }
    redde out
}

# Validate a canonical tensor's runtime shape against the config-derived
# expectation; passes the tensor through on success.
@ privata
functio _forma(tensor.Tensor t, textus nomen, lista<numerus> expectata) → tensor.Tensor ⇥ DenseError {
    fixum lista<numerus> f ← t.figura()
    si f ≠ expectata {
        iace finge FormaMala { causa = "canonical tensor " + nomen + " has shape " + _forma_textus(f) + ", expected " + _forma_textus(expectata) }
    }
    redde t
}

# Rank-2 transpose [rows, cols] → [cols, rows] (math has no transpose; the
# embedding gather needs the token-major view).
@ privata
functio _transpone(tensor.Tensor t) → tensor.Tensor ⇥ DenseError {
    fixum lista<numerus> f ← t.figura()
    si f.longitudo() ≠ 2 {
        iace finge FormaMala { causa = "embedding must be rank 2" }
    }
    fixum numerus rows ← f.accipe(0) vel 1
    fixum numerus cols ← f.accipe(1) vel 1
    varia lista<f32> out ← vacua
    varia numerus j ← 0
    dum j < cols {
        varia numerus i ← 0
        dum i < rows {
            out.appende(t.datos.accipe(i * cols + j) vel (0.0 ∷ f32))
            i ← i + 1
        }
        j ← j + 1
    }
    fac {
        redde tensor.structa(out, [cols, rows])
    }
    cape err {
        iace finge FormaMala { causa = tensor.causa(err) }
    }
}

# Embedding gather: token-major embed [V, D] → rows for the token ids.
@ privata
functio _collige(tensor.Tensor embed, lista<numerus> tokens) → tensor.Tensor ⇥ DenseError {
    fixum lista<numerus> fe ← embed.figura()
    si fe.longitudo() ≠ 2 {
        iace finge FormaMala { causa = "embedding must be rank 2" }
    }
    fixum numerus v ← fe.accipe(0) vel 1
    fixum numerus d ← fe.accipe(1) vel 1
    varia lista<f32> out ← vacua
    itera ex tokens fixum tok {
        si tok < 0 aut tok ≥ v {
            iace finge TerminusExcedit { causa = "token id out of range for the embedding" }
        }
        itera ab 0‥d fixum j {
            out.appende(embed.datos.accipe(tok * d + j) vel (0.0 ∷ f32))
        }
    }
    fixum lista<numerus> ft ← [tokens.longitudo(), d]
    fac {
        redde tensor.structa(out, ft)
    }
    cape err {
        iace finge FormaMala { causa = tensor.causa(err) }
    }
}

# Same-shape zero bias [T, N] for one linear row: the executed bias
# contract of the composed surface (per-channel [N] against [M, N] needs
# singleton broadcast, which forma.broadcastum rejects at runtime — the
# recorded broadcastum rank-mismatch constraint, dense-swiglu precedent).
@ privata
functio _nullum_bias(tensor.Tensor x, tensor.Tensor w) → tensor.Tensor ⇥ DenseError {
    fixum lista<numerus> fx ← x.figura()
    fixum lista<numerus> fw ← w.figura()
    si fx.longitudo() ≠ 2 {
        iace finge FormaMala { causa = "block input must be rank 2" }
    }
    si fw.longitudo() ≠ 2 {
        iace finge FormaMala { causa = "block weight must be rank 2" }
    }
    fixum numerus t ← fx.accipe(0) vel 1
    fixum numerus n ← fw.accipe(1) vel 1
    fac {
        redde tensor.impleta([t, n], (0.0 ∷ f32))
    }
    cape err {
        iace finge FormaMala { causa = tensor.causa(err) }
    }
}

# rmsnorm wrapper — nn.rmsnorm → DenseError (causa text preserved).
@ privata
functio _rmsnorm(tensor.Tensor x, tensor.Tensor s, f32 epsilon) → tensor.Tensor ⇥ DenseError {
    fac {
        redde nn.rmsnorm(x, s, epsilon)
    }
    cape err {
        iace finge FormaMala { causa = nn.causa(err) }
    }
}

# linear wrapper — nn.linear → DenseError (causa text preserved).
@ privata
functio _linear(tensor.Tensor x, tensor.Tensor w, tensor.Tensor b) → tensor.Tensor ⇥ DenseError {
    fac {
        redde nn.linear(x, w, b)
    }
    cape err {
        iace finge FormaMala { causa = nn.causa(err) }
    }
}

# dense_block wrapper — transformer.dense_block → DenseError (causa text
# preserved).
@ privata
functio _block(
    tensor.Tensor x,
    tensor.Tensor ln1_s, f32 epsilon,
    tensor.Tensor wq, tensor.Tensor bq,
    tensor.Tensor wk, tensor.Tensor bk,
    tensor.Tensor wv, tensor.Tensor bv,
    tensor.Tensor wo,
    numerus num_heads, numerus num_kv_heads, f32 scale,
    lista<numerus> positions, numerus rope_dim, attention.RopeConfigura cfg,
    tensor.Tensor ln2_s,
    tensor.Tensor wg, tensor.Tensor bg,
    tensor.Tensor wu, tensor.Tensor bu,
    tensor.Tensor wd, tensor.Tensor bd
) → tensor.Tensor ⇥ DenseError {
    fac {
        redde transformer.dense_block(x, ln1_s, epsilon, wq, bq, wk, bk, wv, bv, wo, num_heads, num_kv_heads, scale, positions, rope_dim, cfg, ln2_s, wg, bg, wu, bu, wd, bd)
    }
    cape err {
        iace finge FormaMala { causa = transformer.causa(err) }
    }
}

# -------------------------------------------------------------------------
# praevideo — the complete ordered dense forward graph.
#
#   cfg        the typed architecture config (heads, layers, dims, vocab,
#              tie status)
#   fons       canonical tensor-name → materialized stored-weight view
#   tokens     token ids [T] (embedding gather)
#   epsilon    RMSNorm epsilon (llama default 1e-5)
#   scale      dk scaling factor (1/sqrt(head_dim))
#   positions  RoPE positions, one per token
#   rope_dim   RoPE rotation width (≤ head_dim)
#   rope_cfg   the U1.3 configurable RoPE (base, scale, pair policy)
#
# Returns the logits [T, V]. Shape-generic at runtime (R3): no per-row
# special-case constants; every shape derives from cfg and the runtime
# tensors.
# -------------------------------------------------------------------------

@ publica
functio praevideo(
    ConfiguraDensa cfg,
    (textus, numerus) → Repertum fons,
    lista<numerus> tokens,
    f32 epsilon,
    f32 scale,
    lista<numerus> positions,
    numerus rope_dim,
    attention.RopeConfigura rope_cfg
) → tensor.Tensor ⇥ DenseError {
    si cfg.strata < 1 {
        iace finge ConfiguraMala { causa = "layer count must be at least 1" }
    }
    si cfg.capita < 1 {
        iace finge ConfiguraMala { causa = "head count must be at least 1" }
    }
    si cfg.capita_kv < 1 aut cfg.capita_kv > cfg.capita {
        iace finge ConfiguraMala { causa = "KV head count must be between 1 and the head count" }
    }
    si cfg.capita % cfg.capita_kv ≠ 0 {
        iace finge ConfiguraMala { causa = "head count must be a multiple of the KV head count" }
    }
    si cfg.dimensio_capitis < 1 {
        iace finge ConfiguraMala { causa = "head dim must be at least 1" }
    }
    si cfg.dimensio_occulta < 1 {
        iace finge ConfiguraMala { causa = "hidden dim must be at least 1" }
    }
    si cfg.vocabulum < 1 {
        iace finge ConfiguraMala { causa = "vocabulary size must be at least 1" }
    }
    si tokens.longitudo() < 1 {
        iace finge ConfiguraMala { causa = "token sequence must be non-empty" }
    }
    si positions.longitudo() ≠ tokens.longitudo() {
        iace finge ConfiguraMala { causa = "positions must match the token count" }
    }

    # Embedding: the resolver returns the stored [D, V] view (the GGUF/A1b
    # descriptor layout); transpose for the token-major gather. A TIED
    # lm_head later reuses this stored view directly.
    fixum tensor.Tensor embed ← _fons(fons, "model.embed_tokens", 0)
    fixum tensor.Tensor _ ← _forma(embed, "model.embed_tokens", [cfg.dimensio_occulta, cfg.vocabulum])
    fixum tensor.Tensor embed_v ← _transpone(embed)
    fixum tensor.Tensor x ← _collige(embed_v, tokens)

    # N ordered U1.5 blocks. Every weight is resolved by its canonical name
    # at the current layer index; every shape is validated against the
    # config (the MLP hidden width derives from the gate/up width at
    # runtime). The biases are synthesized zero same-shape tensors (the
    # composed rows carry no bias weights).
    fixum numerus qwidth ← cfg.capita * cfg.dimensio_capitis
    fixum numerus kwidth ← cfg.capita_kv * cfg.dimensio_capitis
    varia tensor.Tensor h ← x
    varia numerus stratum ← 0
    dum stratum < cfg.strata {
        fixum textus prefix ← "model.layers." + (stratum ↦ textus)
        fixum tensor.Tensor ln1_s ← _fons(fons, prefix + ".input_layernorm", stratum)
        fixum tensor.Tensor wq ← _fons(fons, prefix + ".self_attn.q_proj", stratum)
        fixum tensor.Tensor wk ← _fons(fons, prefix + ".self_attn.k_proj", stratum)
        fixum tensor.Tensor wv ← _fons(fons, prefix + ".self_attn.v_proj", stratum)
        fixum tensor.Tensor wo ← _fons(fons, prefix + ".self_attn.o_proj", stratum)
        fixum tensor.Tensor ln2_s ← _fons(fons, prefix + ".post_attention_layernorm", stratum)
        fixum tensor.Tensor wg ← _fons(fons, prefix + ".mlp.gate_proj", stratum)
        fixum tensor.Tensor wu ← _fons(fons, prefix + ".mlp.up_proj", stratum)
        fixum tensor.Tensor wd ← _fons(fons, prefix + ".mlp.down_proj", stratum)

        fixum tensor.Tensor _ ← _forma(ln1_s, prefix + ".input_layernorm", [cfg.dimensio_occulta])
        fixum tensor.Tensor _ ← _forma(wq, prefix + ".self_attn.q_proj", [cfg.dimensio_occulta, qwidth])
        fixum tensor.Tensor _ ← _forma(wk, prefix + ".self_attn.k_proj", [cfg.dimensio_occulta, kwidth])
        fixum tensor.Tensor _ ← _forma(wv, prefix + ".self_attn.v_proj", [cfg.dimensio_occulta, kwidth])
        fixum tensor.Tensor _ ← _forma(wo, prefix + ".self_attn.o_proj", [qwidth, qwidth])
        fixum tensor.Tensor _ ← _forma(ln2_s, prefix + ".post_attention_layernorm", [cfg.dimensio_occulta])
        fixum lista<numerus> fwg ← wg.figura()
        si fwg.longitudo() ≠ 2 {
            iace finge FormaMala { causa = "canonical tensor " + prefix + ".mlp.gate_proj must be rank 2" }
        }
        fixum numerus f ← fwg.accipe(1) vel 1
        fixum tensor.Tensor _ ← _forma(wu, prefix + ".mlp.up_proj", [cfg.dimensio_occulta, f])
        fixum tensor.Tensor _ ← _forma(wd, prefix + ".mlp.down_proj", [f, cfg.dimensio_occulta])

        fixum tensor.Tensor bq ← _nullum_bias(h, wq)
        fixum tensor.Tensor bk ← _nullum_bias(h, wk)
        fixum tensor.Tensor bv ← _nullum_bias(h, wv)
        fixum tensor.Tensor bg ← _nullum_bias(h, wg)
        fixum tensor.Tensor bu ← _nullum_bias(h, wu)
        fixum tensor.Tensor bd ← _nullum_bias(h, wd)

        h ← _block(h, ln1_s, epsilon, wq, bq, wk, bk, wv, bv, wo, cfg.capita, cfg.capita_kv, scale, positions, rope_dim, rope_cfg, ln2_s, wg, bg, wu, bu, wd, bd)
        stratum ← stratum + 1
    }

    # Final RMSNorm.
    fixum tensor.Tensor norm_s ← _fons(fons, "model.norm", 0)
    fixum tensor.Tensor _ ← _forma(norm_s, "model.norm", [cfg.dimensio_occulta])
    fixum tensor.Tensor hn ← _rmsnorm(h, norm_s, epsilon)

    # Output projection. A TIED lm_head reuses the stored embedding view
    # (already [D, V] — the linear [in, out] layout); an UNTIED row resolves
    # lm_head as its own canonical tensor.
    varia tensor.Tensor w_head ← embed
    si non cfg.ligatum {
        w_head ← _fons(fons, "lm_head", 0)
        fixum tensor.Tensor _ ← _forma(w_head, "lm_head", [cfg.dimensio_occulta, cfg.vocabulum])
    }
    fixum tensor.Tensor b_head ← _nullum_bias(hn, w_head)
    redde _linear(hn, w_head, b_head)
}
