+++
locale = "en"
+++
# CPU decoding of the currently supported GGML block types (PML2-U5 C3,
# extended by GGUF-A3 C1 and W1-U3). Encoded model storage remains open: this
# module decodes only the representations it explicitly understands.
#
# Public import: import from "gradus:model/dequant" dequant
# Depends on: gradus:dtype (compute widths), gradus:storage (open
# representation identity).
#
# --- Contract ------------------------------------------------------------
#
# Re-expression port (Rust -> Faber) of faber-runtime/src/dequant.rs — the
# GI2-1 CPU decode core for the admitted SmolLM2-360M-Instruct Q4_K_M row.
# The Rust original is the migration ORACLE (decision pml0-admission-
# migration-decision.md §3.1/§3.2): its tests, fixtures, and pinned-row
# facts are the acceptance target for this port, and this module mirrors
# the dequant trio member 1:1. Supporting surfaces (QuantizedTensorLayout,
# TensorView) stay with their GI owners per §1 — this module owns the
# decode MATH only: supported GGML block bytes in, explicitly decoded F32
# logical elements out, fail closed.
#
# CONTRACT — semantics match llama.cpp exactly (`ggml/src/ggml-quants.c`,
# commit `a957b7747` at the pinned checkout): GGML half->f32 (exact
# IEEE-754 binary16->binary32), integer qs, per-block scale/min/dmin/kscale
# application (`dequantize_row_q5_0`, `dequantize_row_q8_0`,
# `dequantize_row_q4_K`, `dequantize_row_q5_K`, `dequantize_row_q6_K` +
# `get_scale_min_k4`, the f16 row conversion for GGML_F16 via `_half`,
# and the bf16 row conversion for GGML_BF16).
# Dequant is exact integer/half math: all arithmetic is plain IEEE-754 f32
# in the same operation order as the C kernels, so outputs are bit-exact
# against the independent reference
# (`radix/docs/factory/gpu-inference-gguf/evidence/gi2-dequant-reference.py`
# and its committed goldens `gi2-dequant-goldens.json`, cited read-only).
#
# FAIL CLOSED:
#   * unknown / unsupported representation -> UnsupportedRepresentation
#     before any byte is touched (the current decoder set is {F32, F16,
#     BF16, Q5_0, Q8_0, Q4_K, Q5_K, Q6_K});
#   * a block whose byte length is not the layout's block_bytes ->
#     BadBlock (oracle RowBytesMismatch analog);
#   * a row whose byte length is not a whole multiple of block_bytes ->
#     BadOrder (oracle BlockBytesMismatch analog);
#   * NaN halves fail closed (BadPayload): the pinned row has none, and a
#     NaN half is malformed data — no bit pattern is smuggled into the
#     dequant output; NaN bf16 values fail closed the same way.
#
# Tensor-level coverage gating (GI1-4 residual: `coverage_ok()` +
# `per_tensor_covered`) is enforced by the admission rows (gguf.fab /
# safetensors.fab) at capsule construction, not re-derived here — this
# module consumes already-validated byte payloads.
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * Proba proof is compile-level until the FMIR stepper / faber test path
#     covers library probas (recorded capsule.fab residual); assert
#     assertions run under the auditor-owned `faber test` harness.
#   * Public signatures stay on primitives plus this module's own DequantError
#     so the proba file-interface keeps every export (WARN014 — same seam as
#     capsule.fab U1).
#
# --- Seams ---------------------------------------------------------------
#   * oracle + goldens: faber-runtime/src/dequant.rs, gi2-dequant-goldens.json
#     (read-only; bit-exact comparison is the auditor-owned test path).
#   * tensor-level coverage gate: gguf.fab / safetensors.fab admission.
#   * tokenizer probe parity (P1–P11, workload id lists) — gradus:tokenizer.
#   * negative-matrix conformance suite across U2/U3/U4 — PML2-U6.

import from "gradus:dtype" dtype

import from "gradus:storage" storage

# -------------------------------------------------------------------------
# Pinned GGML block layouts mirror gguf.fab / capsule.fab and the pinned
# toolchain (ggml.h @ a957b7747). Raw wire ids become an open
# `storage.Representation`; only the private decode dispatch uses a closed
# implementation enum for the subset with an F32 decoder.
# -------------------------------------------------------------------------

enum DecodeKind {
    F32 = 0,
    F16 = 1,
    Q5_0 = 6,
    Q8_0 = 8,
    Q4_K = 12,
    Q5_K = 13,
    Q6_K = 14,
    BF16 = 30
}

const int F32_ELEMENTS ← 1

const int F16_ELEMENTS ← 1

const int BF16_ELEMENTS ← 1

const int Q5_0_ELEMENTS ← 32

const int Q5_0_BYTES ← 22

const int Q8_0_ELEMENTS ← 32

const int Q8_0_BYTES ← 34

const int Q4_K_ELEMENTS ← 256

const int Q4_K_BYTES ← 144

const int Q5_K_ELEMENTS ← 256

const int Q5_K_BYTES ← 176

const int Q6_K_ELEMENTS ← 256

const int Q6_K_BYTES ← 210

# -------------------------------------------------------------------------
# DequantError — typed fail-closed diagnostics of the dequant boundary.
# Variant -> class:
#   UnsupportedRepresentation — unknown or unsupported storage identity.
#   BadBlock  — block byte length != the layout's block_bytes.
#   BadOrder      — row byte length not a multiple of block_bytes.
#   BadPayload     — malformed value (NaN half) fails closed.
# The public surface carries @ public (the post-visibility-flip compiler
# treats unmarked top-level names as module-private); the admitted set and
# every codec below stay importable by the proba and package consumers.
# -------------------------------------------------------------------------


@ public
union DequantError {
    @ shared
    string message

    UnsupportedRepresentation,
    BadBlock,
    BadOrder,
    BadPayload
}



# -------------------------------------------------------------------------
# Private byte readers (bounds-checked on read; the admission rows have
# already validated the enclosing payload).
# -------------------------------------------------------------------------

fn _byte(list<int<u8>> b, int off) → int {
    return b.get(off) coalesce 0 ∷ int<u8> ↦ int
}

# Unsigned byte -> signed i8 value.
fn _i8(int v) → int {
    if v ≥ 128 then return v - 256
    return v
}

# Compute 2^n via repeated multiplication/division. n range: [-127, 128]
# — matches the IEEE-754 exponent spans this module needs.
fn _power_two(int n) → float {
    var float result ← 1.0
    if n ≥ 0 {
        for range 0‥n const i {
            result ← result * 2.0
        }
    }
    else {
        for range n‥0 const i {
            result ← result / 2.0
        }
    }
    return result
}

# -------------------------------------------------------------------------
# GGML half (binary16) -> exact f32 VALUE through the language row chain
# (`int<u16, Le>` window -> `float<f16, Bits>` reinterpretation -> exact
# widen to f32; bit-identical for every half including subnormals and
# ±inf). Fail closed on NaN halves: the gate reads the exponent/mantissa
# fields of the u16 window because the runner's float `≠` is NaN-total
# (`value ≠ value` never fires there) — a NaN half is malformed data.
# -------------------------------------------------------------------------

fn _half(list<int<u8>> b, int off) → f32 ⇥ DequantError {
    const bytes buf ← b
    const int bits ← buf[off‥off+2] ↦ int<u16, Le> ↦ int
    if (bits ⇒ 10) % 32 ≡ 31 {
        if bits % 1024 ≠ 0 {
            throw variant BadPayload {message = "NaN half in dequant block"}
        }
    }
    return buf[off‥off+2] ↦ int<u16, Le> ↦ float<f16, Bits> ↦ float<f32>
}

# GGML bf16 -> exact f32 VALUE. bf16 is sign(1) / exponent(8, bias 127) /
# mantissa(7): value-arithmetic decode through the `_power_two` seam
# (bit-exact for every finite bf16, which is exactly representable in f32). ±inf via f64 overflow narrowing; NaN fails closed.
fn _bfloat16(list<int<u8>> b, int off) → f32 ⇥ DequantError {
    const bytes buf ← b
    const int bits ← buf[off‥off+2] ↦ int<u16, Le> ↦ int
    const int sign ← (bits ⇒ 15) % 2
    const int exp ← (bits ⇒ 7) % 256
    const int frac ← bits % 128
    var float sign_factor ← 1.0
    if sign ≠ 0 {
        sign_factor ← -1.0
    }
    if exp ≡ 0 {
        if frac ≡ 0 {
            # ±0 (subnormal zero)
            return sign_factor * 0.0 ↦ f32
        }
        # Subnormal: ±frac × 2^-126 × 2^-7
        const float power ← _power_two(-126)
        return (sign_factor * power) * ((frac ↦ float) / 128.0) ↦ f32
    }
    if exp ≡ 255 {
        if frac ≡ 0 {
            # ±inf via f64 overflow -> f32 narrowing.
            const float power ← _power_two(128)
            return (sign_factor * power) * 2.0 ↦ f32
        }
        throw variant BadPayload {message = "NaN bf16 value in dequant block"}
    }

    # Normal: ±2^(e-127) × (1 + frac/128)
    const float power ← _power_two(exp - 127)
    const float frac_ratio ← (frac ↦ float) / 128.0
    return (sign_factor * power) * (1.0 + frac_ratio) ↦ f32
}

# -------------------------------------------------------------------------
# Block kernels — mirror dequant.rs / llama.cpp exactly (same operation
# order; all arithmetic in f32).
# -------------------------------------------------------------------------

# `block_q8_0`: d (half) + qs[32] int8 -> y[j] = qs[j] * d.
fn _dequant_q8_0(list<int<u8>> b) → list<f32> ⇥ DequantError {
    const f32 d ← _half(b, 0)
    var list<f32> y ← empty
    for range 0‥32 const j {
        y.append((_i8(_byte(b, 2 + j)) ↦ f32) * d)
    }
    return y
}

# `block_q5_0`: d (half) + qh[4] bitmask + qs[16] nibbles. Output order
# matches llama.cpp: y[0..16] from the low nibbles, y[16..32] from the
# high nibbles (two 16-elem runs, appended in that order).
fn _dequant_q5_0(list<int<u8>> b) → list<f32> ⇥ DequantError {
    const f32 d ← _half(b, 0)
    const bytes buf ← b
    const int qh ← buf[2‥6] ↦ int<u32, Le> ↦ int
    var list<f32> low ← empty
    var list<f32> high ← empty
    for range 0‥16 const j {
        # xh_0 = ((qh >> j) << 4) & 0x10 ; xh_1 = (qh >> (j+12)) & 0x10
        const int xh_0 ← ((qh ⇒ j) % 2) * 16
        const int xh_1 ← ((qh ⇒ j + 16) % 2) * 16
        const int qs ← _byte(b, 6 + j)
        const int x0 ← (qs % 16 ∨ xh_0) - 16
        const int x1 ← ((qs ⇒ 4) % 16 ∨ xh_1) - 16
        low.append((x0 ↦ f32) * d)
        high.append((x1 ↦ f32) * d)
    }
    var list<f32> y ← empty
    for from low const v {
        y.append(v)
    }
    for from high const v {
        y.append(v)
    }
    return y
}

# `get_scale_min_k4` (llama.cpp ggml-quants.c): 6-bit scale + 6-bit min
# from scales[K_SCALE_SIZE = 12]. The scales array lives at block offset 4
# (the caller's `b`); indexes are relative to that array. Returns (sc, m).
# For index >= 4 the high-bit halves are 2 bits each: `(scales[j-4] >> 6)
# << 4` / `(scales[j] >> 6) << 4` — kept as `% 4` so both bits survive.
# `@ internal` (not `@ private`): the merged FMIR image drops field metadata
# for package-private structs that stay reachable in a merged program; the
# internal tier keeps the struct's field surface in the image while holding
# its name out of the exported package surface.

@ internal { }
class MinScale {
    int sc
    int m
}

fn _min_scale_k4(int index, list<int<u8>> b) → MinScale {
    if index ≺ 4 then return MinScale {sc = _byte(b, 4 + index) % 64, m = _byte(b, 8 + index) % 64}
    const int sc ← _byte(b, 8 + index) % 16 ∨ ((_byte(b, index) ⇒ 6) % 4) * 16
    const int m ← (_byte(b, 8 + index) ⇒ 4) % 16 ∨ ((_byte(b, 4 + index) ⇒ 6) % 4) * 16
    return MinScale {sc = sc, m = m}
}

# `block_q4_K`: d, dmin (halves), scales[12], qs[128]. Per 64-element
# sub-block pair: d1 = d·sc(is), m1 = dmin·m(is), d2 = d·sc(is+1),
# m2 = dmin·m(is+1); y = d1·(qs&0xF) − m1 for 32 elements, then
# y = d2·(qs>>4) − m2 for 32. Output per chunk is one 64-elem run:
# first the 32 low-nibble values, then the 32 high-nibble values.
fn _dequant_q4_k(list<int<u8>> b) → list<f32> ⇥ DequantError {
    # --- block header (d/dmin halves) -------------------------------------
    const f32 d ← _half(b, 0)
    const f32 dmin ← _half(b, 2)
    var list<f32> y ← empty
    var int idx ← 0
    var int qoff ← 0

    # --- per-chunk sub-block pair (scales + decode) -----------------------
    for range 0‥4 const chunk {
        const MinScale sm0 ← _min_scale_k4(idx, b)
        const f32 d1 ← d * (sm0.sc ↦ f32)
        const f32 m1 ← dmin * (sm0.m ↦ f32)
        const MinScale sm1 ← _min_scale_k4(idx + 1, b)
        const f32 d2 ← d * (sm1.sc ↦ f32)
        const f32 m2 ← dmin * (sm1.m ↦ f32)
        var list<f32> low ← empty
        var list<f32> high ← empty

        # --- 32-elem low + high nibble decode -----------------------------
        for range 0‥32 const l {
            const int qs ← _byte(b, (16 + qoff) + l)
            low.append(d1 * (qs % 16 ↦ f32) - m1)
            high.append(d2 * ((qs ⇒ 4) % 16 ↦ f32) - m2)
        }
        for from low const v {
            y.append(v)
        }
        for from high const v {
            y.append(v)
        }
        qoff ← qoff + 32
        idx ← idx + 2
    }
    return y
}

# `block_q5_K`: d, dmin (halves), scales[12], qh[32] high bits, qs[128]
# nibbles. Per 64-element sub-block pair: d1 = d·sc(is), m1 = dmin·m(is),
# d2 = d·sc(is+1), m2 = dmin·m(is+1); the qh byte at index l supplies the
# 5th bit of each nibble (bit 2c for the low nibble, bit 2c+1 for the high
# nibble, c = chunk index). y = d1·qs16 − m1 for 32 elements, then
# y = d2·qs16 − m2 for 32 — same output order as llama.cpp's
# `dequantize_row_q5_K` (two 32-elem runs per chunk, low then high).
fn _dequant_q5_k(list<int<u8>> b) → list<f32> ⇥ DequantError {
    # --- block header (d/dmin halves) -------------------------------------
    const f32 d ← _half(b, 0)
    const f32 dmin ← _half(b, 2)
    var list<f32> y ← empty
    var int idx ← 0
    var int qoff ← 0

    # --- per-chunk sub-block pair (scales + qh decode) --------------------
    for range 0‥4 const chunk {
        const MinScale sm0 ← _min_scale_k4(idx, b)
        const f32 d1 ← d * (sm0.sc ↦ f32)
        const f32 m1 ← dmin * (sm0.m ↦ f32)
        const MinScale sm1 ← _min_scale_k4(idx + 1, b)
        const f32 d2 ← d * (sm1.sc ↦ f32)
        const f32 m2 ← dmin * (sm1.m ↦ f32)
        var list<f32> low ← empty
        var list<f32> high ← empty

        # --- 32-elem low + high nibble decode -----------------------------
        for range 0‥32 const l {
            const int qs ← _byte(b, (48 + qoff) + l)
            const int qh ← _byte(b, 16 + l)
            # 5th bits: bit 2c (low nibble) / bit 2c+1 (high nibble).
            const int hi_lo ← ((qh ⇒ 2 * chunk) % 2) * 16
            const int hi_hi ← ((qh ⇒ 2 * chunk + 1) % 2) * 16
            const int qs16_lo ← qs % 16 ∨ hi_lo
            const int qs16_hi ← (qs ⇒ 4) % 16 ∨ hi_hi
            low.append(d1 * (qs16_lo ↦ f32) - m1)
            high.append(d2 * (qs16_hi ↦ f32) - m2)
        }
        for from low const v {
            y.append(v)
        }
        for from high const v {
            y.append(v)
        }
        qoff ← qoff + 32
        idx ← idx + 2
    }
    return y
}

# `block_q6_K`: ql[128] low nibbles, qh[64] high bits, scales[16] int8,
# d (half) at byte offset 208. Output order matches llama.cpp: within
# each 128-element group the four quants are written at strides 0/32/64/96
# over l — one 32-elem run per stride, appended in stride order.
fn _dequant_q6_k(list<int<u8>> b) → list<f32> ⇥ DequantError {
    # --- block scale d (byte 208) -----------------------------------------
    const f32 d ← _half(b, 208)
    var list<f32> y ← empty

    # --- per-128 group (offsets + quants q1..q4) --------------------------
    for range 0‥2 const n {
        const int sc_base ← n * 8
        const int ql_off ← n * 64
        const int qh_off ← n * 32
        var list<f32> q1s ← empty
        var list<f32> q2s ← empty
        var list<f32> q3s ← empty
        var list<f32> q4s ← empty

        # --- 32-elem quants q1..q4 (scales + -32) -------------------------
        for range 0‥32 const l {
            const int idx ← l / 16
            const int ql_lo ← _byte(b, ql_off + l)
            const int ql_hi ← _byte(b, (ql_off + l) + 32)
            const int qh ← _byte(b, (128 + qh_off) + l)
            # q1..q4: low/high nibbles + 2-bit high groups, then -32.
            const int q1 ← (ql_lo % 16 ∨ (qh % 4) * 16) - 32
            const int q2 ← (ql_hi % 16 ∨ ((qh ⇒ 2) % 4) * 16) - 32
            const int q3 ← ((ql_lo ⇒ 4) % 16 ∨ ((qh ⇒ 4) % 4) * 16) - 32
            const int q4 ← ((ql_hi ⇒ 4) % 16 ∨ ((qh ⇒ 6) % 4) * 16) - 32
            const f32 sc0 ← _i8(_byte(b, ((192 + sc_base) + idx) + 0)) ↦ f32
            const f32 sc2 ← _i8(_byte(b, ((192 + sc_base) + idx) + 2)) ↦ f32
            const f32 sc4 ← _i8(_byte(b, ((192 + sc_base) + idx) + 4)) ↦ f32
            const f32 sc6 ← _i8(_byte(b, ((192 + sc_base) + idx) + 6)) ↦ f32
            # Same left-associative f32 multiplication order as the C
            # kernels ((d * sc) * q), so outputs are bit-exact.
            q1s.append((d * sc0) * (q1 ↦ f32))
            q2s.append((d * sc2) * (q2 ↦ f32))
            q3s.append((d * sc4) * (q3 ↦ f32))
            q4s.append((d * sc6) * (q4 ↦ f32))
        }
        for from q1s const v {
            y.append(v)
        }
        for from q2s const v {
            y.append(v)
        }
        for from q3s const v {
            y.append(v)
        }
        for from q4s const v {
            y.append(v)
        }
    }
    return y
}

# F32 scalar block: bit-exact passthrough of the 4 little-endian bytes via
# the language endian-read form (bit-identical for every pattern, NaN
# payloads included).
fn _dequant_f32(list<int<u8>> b) → list<f32> ⇥ DequantError {
    const bytes buf ← b
    var list<f32> y ← empty
    y.append(buf[0‥4] ↦ float<f32, Le>)
    return y
}

# F16 scalar block: one IEEE binary16 value (2 LE bytes) -> exact f32
# value. Reuses `_half` — the same NativeF16Convert decode the Q-block
# scales already use (bit-exact for every finite half).
fn _dequant_f16(list<int<u8>> b) → list<f32> ⇥ DequantError {
    var list<f32> y ← empty
    y.append(_half(b, 0))
    return y
}

# BF16 scalar block: one bf16 value (2 LE bytes) -> exact f32 value.
fn _dequant_bf16(list<int<u8>> b) → list<f32> ⇥ DequantError {
    var list<f32> y ← empty
    y.append(_bfloat16(b, 0))
    return y
}

# -------------------------------------------------------------------------
# Wire identity — raw GGML ids become open representations and remain
# inspectable even when this module has no decoder for them. Decoding fails
# closed at the explicit representation boundary below.
# -------------------------------------------------------------------------

@ public
fn representation_for(int raw) → storage.Representation {
    return storage.ggml_representation(raw)
}

fn _decode_kind(storage.Representation representation) → DecodeKind ⇥ DequantError {
    require representation.namespace ≡ "ggml" throw variant UnsupportedRepresentation {message = "unsupported numeric representation: §"(storage.identity(representation))}
    const int raw ← representation.code
    switch raw {
        case 0 { return DecodeKind.F32 }
        case 1 { return DecodeKind.F16 }
        case 6 { return DecodeKind.Q5_0 }
        case 8 { return DecodeKind.Q8_0 }
        case 12 { return DecodeKind.Q4_K }
        case 13 { return DecodeKind.Q5_K }
        case 14 { return DecodeKind.Q6_K }
        case 30 { return DecodeKind.BF16 }
        default { throw variant UnsupportedRepresentation {message = "unsupported GGML representation: §"(storage.identity(representation))} }
    }
}

# -------------------------------------------------------------------------
# Layout facts (block elements / block bytes per supported type). Exhaustive
# matching is deliberate: adding a decoder requires an explicit implementation
# decision, while unknown representations remain preservable in storage.
# -------------------------------------------------------------------------

@ public
fn block_elements(storage.Representation representation) → int ⇥ DequantError {
    const DecodeKind kind ← _decode_kind(representation)
    match kind {
        case DecodeKind.F32 { return F32_ELEMENTS }
        case DecodeKind.F16 { return F16_ELEMENTS }
        case DecodeKind.BF16 { return BF16_ELEMENTS }
        case DecodeKind.Q5_0 { return Q5_0_ELEMENTS }
        case DecodeKind.Q8_0 { return Q8_0_ELEMENTS }
        case DecodeKind.Q4_K { return Q4_K_ELEMENTS }
        case DecodeKind.Q5_K { return Q5_K_ELEMENTS }
        case DecodeKind.Q6_K { return Q6_K_ELEMENTS }
    }
}

@ public
fn block_bytes(storage.Representation representation) → int ⇥ DequantError {
    const DecodeKind kind ← _decode_kind(representation)
    return _block_bytes_kind(kind)
}

fn _block_bytes_kind(DecodeKind kind) → int {
    match kind {
        case DecodeKind.F32 { return dtype.width(dtype.f32()) }
        case DecodeKind.F16 { return dtype.width(dtype.f16()) }
        case DecodeKind.BF16 { return dtype.width(dtype.bf16()) }
        case DecodeKind.Q5_0 { return Q5_0_BYTES }
        case DecodeKind.Q8_0 { return Q8_0_BYTES }
        case DecodeKind.Q4_K { return Q4_K_BYTES }
        case DecodeKind.Q5_K { return Q5_K_BYTES }
        case DecodeKind.Q6_K { return Q6_K_BYTES }
    }
}

# -------------------------------------------------------------------------
# _decode_block — decode ONE supported GGML block to explicitly decoded F32
# logical elements. Representation admission has already happened; only the
# block byte-length gate remains at this seam.
# -------------------------------------------------------------------------

fn _decode_block(DecodeKind kind, list<int<u8>> blocks) → list<f32> ⇥ DequantError {
    const int nbytes ← _block_bytes_kind(kind)
    require blocks.length() ≡ nbytes throw variant BadBlock {message = "block byte length mismatch"}
    match kind {
        case DecodeKind.F32 { return _dequant_f32(blocks) }
        case DecodeKind.F16 { return _dequant_f16(blocks) }
        case DecodeKind.BF16 { return _dequant_bf16(blocks) }
        case DecodeKind.Q5_0 { return _dequant_q5_0(blocks) }
        case DecodeKind.Q8_0 { return _dequant_q8_0(blocks) }
        case DecodeKind.Q4_K { return _dequant_q4_k(blocks) }
        case DecodeKind.Q5_K { return _dequant_q5_k(blocks) }
        case DecodeKind.Q6_K { return _dequant_q6_k(blocks) }
    }
}

# Convert the opaque byte carrier only at the arithmetic decoder boundary.
# Storage callers retain their original `bytes`; this list is an internal
# transient for the existing scalar decoder implementation.
fn _byte_list(bytes input) → list<int<u8>> {
    var list<int<u8>> out ← empty
    for from input const byte {
        out.append(byte ∷ int<u8>)
    }
    return out
}

# -------------------------------------------------------------------------
# Byte conversion is intentionally only encoded-bytes → byte-list for the
# decoder's arithmetic. The storage boundary itself remains `bytes`.
# -------------------------------------------------------------------------

@ public
fn decode_block_f32(storage.Representation representation, bytes block) → list<f32> ⇥ DequantError {
    const DecodeKind kind ← _decode_kind(representation)
    const list<int<u8>> encoded ← _byte_list(block)
    return _decode_block(kind, encoded)
}

# -------------------------------------------------------------------------
# decode_order_f32 — decode a packed row (blocks × block_bytes, the GGUF
# data-region payload of one supported tensor) to explicitly decoded F32
# logical elements, in GGUF block order. Unknown representations remain
# available to storage callers but fail closed here.
# -------------------------------------------------------------------------

@ public
fn decode_order_f32(storage.Representation representation, bytes payload) → list<f32> ⇥ DequantError {
    const DecodeKind kind ← _decode_kind(representation)
    const list<int<u8>> encoded ← _byte_list(payload)
    # --- row alignment gate (fail closed) ---------------------------------
    const int nbytes ← block_bytes(representation)
    require encoded.length() % nbytes ≡ 0 throw variant BadOrder {message = "row byte length not a multiple of block_bytes"}

    # --- per-block decode (GGUF block order) ------------------------------
    var list<f32> y ← empty
    var int off ← 0
    while off ≺ encoded.length() {
        var list<int<u8>> blocks ← empty
        for range 0‥nbytes const i {
            blocks.append(encoded.get(off + i) coalesce 0 ∷ int<u8>)
        }
        const list<f32> g ← _decode_block(kind, blocks)
        for from g const v {
            y.append(v)
        }
        off ← off + nbytes
    }
    return y
}
