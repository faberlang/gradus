+++ toml
locale = "en"

+++ faber
# CPU decoding of the currently supported GGML block types (PML2-U5 C3,
# extended by GGUF-A3 C1 and W1-U3). Encoded model storage remains open: this
# module decodes only the representations it explicitly understands.
#
# Public import: import from "gradus:model/dequant" dequant
# Depends on: gradus:dtype (compute widths), gradus:storage (open
# representation identity).
#
# --- Contract ------------------------------------------------------------
#
# Re-expression port (Rust -> Faber) of faber-runtime/src/dequant.rs — the
# GI2-1 CPU decode core for the admitted SmolLM2-360M-Instruct Q4_K_M row.
# The Rust original is the migration ORACLE (decision pml0-admission-
# migration-decision.md §3.1/§3.2): its tests, fixtures, and pinned-row
# facts are the acceptance target for this port, and this module mirrors
# the dequant trio member 1:1. Supporting surfaces (QuantizedTensorLayout,
# TensorView) stay with their GI owners per §1 — this module owns the
# decode MATH only: supported GGML block bytes in, explicitly decoded F32
# logical elements out, fail closed.
#
# CONTRACT — semantics match llama.cpp exactly (`ggml/src/ggml-quants.c`,
# commit `a957b7747` at the pinned checkout): GGML half->f32 (exact
# IEEE-754 binary16->binary32), integer qs, per-block scale/min/dmin/kscale
# application (`dequantize_row_q5_0`, `dequantize_row_q8_0`,
# `dequantize_row_q4_K`, `dequantize_row_q5_K`, `dequantize_row_q6_K` +
# `get_scale_min_k4`, the f16 row conversion for GGML_F16 via `half`,
# and the bf16 row conversion for GGML_BF16).
# Dequant is exact integer/half math: all arithmetic is plain IEEE-754 f32
# in the same operation order as the C kernels, so outputs are bit-exact
# against the independent reference
# (`radix/docs/factory/gpu-inference-gguf/evidence/gi2-dequant-reference.py`
# and its committed goldens `gi2-dequant-goldens.json`, cited read-only).
#
# FAIL CLOSED:
#   * unknown / unsupported representation -> UnsupportedRepresentation
#     before any byte is touched (the current decoder set is {F32, F16,
#     BF16, Q5_0, Q8_0, Q4_K, Q5_K, Q6_K});
#   * a block whose byte length is not the layout's block_bytes ->
#     BadBlock (oracle RowBytesMismatch analog);
#   * a row whose byte length is not a whole multiple of block_bytes ->
#     BadOrder (oracle BlockBytesMismatch analog);
#   * NaN halves fail closed (BadPayload): the pinned row has none, and a
#     NaN half is malformed data — no bit pattern is smuggled into the
#     dequant output; NaN bf16 values fail closed the same way.
#
# Tensor-level coverage gating (GI1-4 residual: `coverage_ok()` +
# `per_tensor_covered`) is enforced by the admission rows (gguf.fab /
# safetensors.fab) at capsule construction, not re-derived here — this
# module consumes already-validated byte payloads.
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * Proba proof is compile-level until the FMIR stepper / faber test path
#     covers library probas (recorded capsule.fab residual); assert
#     assertions run under the auditor-owned `faber test` harness.
#   * Public signatures stay on primitives plus this module's own DequantError
#     so the proba file-interface keeps every export (WARN014 — same seam as
#     capsule.fab U1).
#
# --- Seams ---------------------------------------------------------------
#   * oracle + goldens: faber-runtime/src/dequant.rs, gi2-dequant-goldens.json
#     (read-only; bit-exact comparison is the auditor-owned test path).
#   * tensor-level coverage gate: gguf.fab / safetensors.fab admission.
#   * tokenizer probe parity (P1–P11, workload id lists) — gradus:tokenizer.
#   * negative-matrix conformance suite across U2/U3/U4 — PML2-U6.

import from "gradus:dtype"

import from "gradus:storage"

# -------------------------------------------------------------------------
# Pinned GGML block layouts mirror gguf.fab / capsule.fab and the pinned
# toolchain (ggml.h @ a957b7747). Raw wire ids become an open
# `storage.Representation`; only the private decode dispatch uses a closed
# implementation enum for the subset with an F32 decoder.
# -------------------------------------------------------------------------

enum DecodeKind {
    F32 = 0,
    F16 = 1,
    Q4_1 = 3,
    Q5_0 = 6,
    Q8_0 = 8,
    Q4_K = 12,
    Q5_K = 13,
    Q6_K = 14,
    IQ4_NL = 20,
    BF16 = 30
}

const int F32_ELEMENTS = 1

const int F16_ELEMENTS = 1

const int BF16_ELEMENTS = 1

const int Q4_1_ELEMENTS = 32

const int Q4_1_BYTES = 20

const int Q5_0_ELEMENTS = 32

const int Q5_0_BYTES = 22

const int Q8_0_ELEMENTS = 32

const int Q8_0_BYTES = 34

const int IQ4_NL_ELEMENTS = 32

const int IQ4_NL_BYTES = 18

const int Q4_K_ELEMENTS = 256

const int Q4_K_BYTES = 144

const int Q5_K_ELEMENTS = 256

const int Q5_K_BYTES = 176

const int Q6_K_ELEMENTS = 256

const int Q6_K_BYTES = 210

# -------------------------------------------------------------------------
# DequantError — typed fail-closed diagnostics of the dequant boundary.
# Variant -> class:
#   UnsupportedRepresentation — unknown or unsupported storage identity.
#   BadBlock  — block byte length != the layout's block_bytes.
#   BadOrder      — row byte length not a multiple of block_bytes.
#   BadPayload     — malformed value (NaN half) fails closed.
# The public surface carries @ public (the post-visibility-flip compiler
# treats unmarked top-level names as module-private); the admitted set and
# every codec below stay importable by the proba and package consumers.
# -------------------------------------------------------------------------


@ public
union DequantError {
    @ shared
    string message

    UnsupportedRepresentation,
    BadBlock,
    BadOrder,
    BadPayload
}

# -------------------------------------------------------------------------
# Private byte readers (bounds-checked on read; the admission rows have
# already validated the enclosing payload).
# -------------------------------------------------------------------------

fn byte_at(list<u8> b, int off) → int {
    return b.get(off) coalesce 0 ∷ u8 ↦ int
}

# Unsigned byte -> signed i8 value.
fn i8(int v) → int {
    if v ≥ 128 then return v - 256

    return v
}

# Compute 2^n via repeated multiplication/division. n range: [-127, 128]
# — matches the IEEE-754 exponent spans this module needs.
fn power_two(int n) → float {
    mut float result ← 1.0

    if n ≥ 0 {
        for range 0 ‥ n let i {
            result ← result * 2.0
        }
    }
    else {
        for range n ‥ 0 let i {
            result ← result / 2.0
        }
    }

    return result
}

# -------------------------------------------------------------------------
# GGML half (binary16) -> exact f32 VALUE through the language row chain
# (`u16 via Le` window -> `b16` bit pattern -> `f16` reinterpretation -> exact
# widen to f32; bit-identical for every half including subnormals and
# ±inf). Fail closed on NaN halves: the gate reads the exponent/mantissa
# fields of the u16 window because the runner's float `≢` is NaN-total
# (`value ≢ value` never fires there) — a NaN half is malformed data.
# -------------------------------------------------------------------------

fn half(list<u8> b, int off) → f32 ⇥ DequantError {
    let list<b8> buf ↤ b
    let int bits ← (buf[off ‥ off + 2] ↦ u16 via Le) ↦ int

    if (bits ⇒ 10) % 32 ≡ 31 {
        if bits % 1024 ≢ 0 {
            throw variant BadPayload { message = "NaN half in dequant block" }
        }
    }

    return (((buf[off ‥ off + 2] ↦ u16 via Le) ↦ b16) ↦ f16) ↦ f32
}

# GGML bf16 -> exact f32 VALUE. bf16 is sign(1) / exponent(8, bias 127) /
# mantissa(7): value-arithmetic decode through the `power_two` seam
# (bit-exact for every finite bf16, which is exactly representable in f32). ±inf via f64 overflow narrowing; NaN fails closed.
fn bfloat16(list<u8> b, int off) → f32 ⇥ DequantError {
    let list<b8> buf ↤ b
    let int bits ← (buf[off ‥ off + 2] ↦ u16 via Le) ↦ int
    let int sign ← (bits ⇒ 15) % 2
    let int exp ← (bits ⇒ 7) % 256
    let int frac ← bits % 128
    mut float sign_factor ← 1.0

    if sign ≢ 0 {
        sign_factor ← -1.0
    }

    if exp ≡ 0 {
        if frac ≡ 0 {
            # ±0 (subnormal zero)
            return sign_factor * 0.0 ↦ f32
        }

        # Subnormal: ±frac × 2^-126 × 2^-7
        let float power ← power_two(-126)
        return sign_factor * power * ((frac ↦ float) / 128.0) ↦ f32
    }

    if exp ≡ 255 {
        if frac ≡ 0 {
            # ±inf via f64 overflow -> f32 narrowing.
            let float power ← power_two(128)
            return sign_factor * power * 2.0 ↦ f32
        }

        throw variant BadPayload { message = "NaN bf16 value in dequant block" }
    }

    # Normal: ±2^(e-127) × (1 + frac/128)
    let float power ← power_two(exp - 127)
    let float frac_ratio ← (frac ↦ float) / 128.0
    return sign_factor * power * (1.0 + frac_ratio) ↦ f32
}

# -------------------------------------------------------------------------
# Block kernels — mirror dequant.rs / llama.cpp exactly (same operation
# order; all arithmetic in f32).
# -------------------------------------------------------------------------

# `block_q8_0`: d (half) + qs[32] int8 -> y[j] = qs[j] * d.
fn dequant_q8_0(list<u8> b) → list<f32> ⇥ DequantError {
    let f32 d ← half(b, 0)
    mut list<f32> y ← empty

    for range 0 ‥ 32 let j {
        y.append((i8(byte_at(b, 2 + j)) ↦ f32) * d)
    }

    return y
}

# `block_q4_1`: d (half) + m (half) + qs[16] nibbles. Output order matches
# llama.cpp: y[0..16] from low nibbles, y[16..32] from high nibbles.
fn dequant_q4_1(list<u8> b) → list<f32> ⇥ DequantError {
    let f32 d ← half(b, 0)
    let f32 m ← half(b, 2)
    mut list<f32> low ← empty
    mut list<f32> high ← empty

    for range 0 ‥ 16 let j {
        let int qs ← byte_at(b, 4 + j)
        let int x0 ← qs % 16
        let int x1 ← (qs ⇒ 4) % 16
        low.append((x0 ↦ f32) * d + m)
        high.append((x1 ↦ f32) * d + m)
    }

    mut list<f32> y ← empty

    for from low let v {
        y.append(v)
    }

    for from high let v {
        y.append(v)
    }

    return y
}

const list<int> KVALUES_IQ4NL = [-127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113]

# `block_iq4_nl`: d (half) + qs[16] nibbles into `kvalues_iq4nl`. Output
# order matches llama.cpp: y[0..16] from low nibbles, y[16..32] from high.
fn dequant_iq4_nl(list<u8> b) → list<f32> ⇥ DequantError {
    let f32 d ← half(b, 0)
    mut list<f32> low ← empty
    mut list<f32> high ← empty

    for range 0 ‥ 16 let j {
        let int qs ← byte_at(b, 2 + j)
        let int k0 ← KVALUES_IQ4NL[qs % 16]
        let int k1 ← KVALUES_IQ4NL[(qs ⇒ 4) % 16]
        low.append(d * (k0 ↦ f32))
        high.append(d * (k1 ↦ f32))
    }

    mut list<f32> y ← empty

    for from low let v {
        y.append(v)
    }

    for from high let v {
        y.append(v)
    }

    return y
}

# `block_q5_0`: d (half) + qh[4] bitmask + qs[16] nibbles. Output order
# matches llama.cpp: y[0..16] from the low nibbles, y[16..32] from the
# high nibbles (two 16-elem runs, appended in that order).
fn dequant_q5_0(list<u8> b) → list<f32> ⇥ DequantError {
    let f32 d ← half(b, 0)
    let list<b8> buf ↤ b
    let int qh ← (buf[2 ‥ 6] ↦ u32 via Le) ↦ int
    mut list<f32> low ← empty
    mut list<f32> high ← empty

    for range 0 ‥ 16 let j {
        # xh_0 = ((qh >> j) << 4) & 0x10 ; xh_1 = (qh >> (j+12)) & 0x10
        let int xh_0 ← (qh ⇒ j) % 2 * 16
        let int xh_1 ← (qh ⇒ j + 16) % 2 * 16
        let int qs ← byte_at(b, 6 + j)
        let int x0 ← (qs % 16 ∨ xh_0) - 16
        let int x1 ← ((qs ⇒ 4) % 16 ∨ xh_1) - 16
        low.append((x0 ↦ f32) * d)
        high.append((x1 ↦ f32) * d)
    }

    mut list<f32> y ← empty

    for from low let v {
        y.append(v)
    }

    for from high let v {
        y.append(v)
    }

    return y
}

# `get_scale_min_k4` (llama.cpp ggml-quants.c): 6-bit scale + 6-bit min
# from scales[K_SCALE_SIZE = 12]. The scales array lives at block offset 4
# (the caller's `b`); indexes are relative to that array. Returns (sc, m).
# For index >= 4 the high-bit halves are 2 bits each: `(scales[j-4] >> 6)
# << 4` / `(scales[j] >> 6) << 4` — kept as `% 4` so both bits survive.
# `@ internal` (not `@ private`): the merged FMIR image drops field metadata
# for package-private structs that stay reachable in a merged program; the
# internal tier keeps the struct's field surface in the image while holding
# its name out of the exported package surface.

@ internal
class MinScale {
    mut int sc
    mut int m
}

fn min_scale_k4(int index, list<u8> b) → MinScale {
    if index ≺ 4 then return MinScale { sc = byte_at(b, 4 + index) % 64, m = byte_at(b, 8 + index) % 64 }

    let int sc ← byte_at(b, 8 + index) % 16 ∨ (byte_at(b, index) ⇒ 6) % 4 * 16
    let int m ← (byte_at(b, 8 + index) ⇒ 4) % 16 ∨ (byte_at(b, 4 + index) ⇒ 6) % 4 * 16
    return MinScale { sc = sc, m = m }
}

# `block_q4_K`: d, dmin (halves), scales[12], qs[128]. Per 64-element
# sub-block pair: d1 = d·sc(is), m1 = dmin·m(is), d2 = d·sc(is+1),
# m2 = dmin·m(is+1); y = d1·(qs&0xF) − m1 for 32 elements, then
# y = d2·(qs>>4) − m2 for 32. Output per chunk is one 64-elem run:
# first the 32 low-nibble values, then the 32 high-nibble values.
fn dequant_q4_k(list<u8> b) → list<f32> ⇥ DequantError {
    # --- block header (d/dmin halves) -------------------------------------
    let f32 d ← half(b, 0)
    let f32 dmin ← half(b, 2)
    mut list<f32> y ← empty
    mut int idx ← 0
    mut int qoff ← 0

    # --- per-chunk sub-block pair (scales + decode) -----------------------
    for range 0 ‥ 4 let chunk {
        let MinScale sm0 ← min_scale_k4(idx, b)
        let f32 d1 ← d * (sm0.sc ↦ f32)
        let f32 m1 ← dmin * (sm0.m ↦ f32)
        let MinScale sm1 ← min_scale_k4(idx + 1, b)
        let f32 d2 ← d * (sm1.sc ↦ f32)
        let f32 m2 ← dmin * (sm1.m ↦ f32)
        mut list<f32> low ← empty
        mut list<f32> high ← empty

        # --- 32-elem low + high nibble decode -----------------------------
        for range 0 ‥ 32 let l {
            let int qs ← byte_at(b, 16 + qoff + l)
            low.append(d1 * (qs % 16 ↦ f32) - m1)
            high.append(d2 * ((qs ⇒ 4) % 16 ↦ f32) - m2)
        }

        for from low let v {
            y.append(v)
        }

        for from high let v {
            y.append(v)
        }

        qoff ← qoff + 32
        idx ← idx + 2
    }

    return y
}

# `block_q5_K`: d, dmin (halves), scales[12], qh[32] high bits, qs[128]
# nibbles. Per 64-element sub-block pair: d1 = d·sc(is), m1 = dmin·m(is),
# d2 = d·sc(is+1), m2 = dmin·m(is+1); the qh byte at index l supplies the
# 5th bit of each nibble (bit 2c for the low nibble, bit 2c+1 for the high
# nibble, c = chunk index). y = d1·qs16 − m1 for 32 elements, then
# y = d2·qs16 − m2 for 32 — same output order as llama.cpp's
# `dequantize_row_q5_K` (two 32-elem runs per chunk, low then high).
fn dequant_q5_k(list<u8> b) → list<f32> ⇥ DequantError {
    # --- block header (d/dmin halves) -------------------------------------
    let f32 d ← half(b, 0)
    let f32 dmin ← half(b, 2)
    mut list<f32> y ← empty
    mut int idx ← 0
    mut int qoff ← 0

    # --- per-chunk sub-block pair (scales + qh decode) --------------------
    for range 0 ‥ 4 let chunk {
        let MinScale sm0 ← min_scale_k4(idx, b)
        let f32 d1 ← d * (sm0.sc ↦ f32)
        let f32 m1 ← dmin * (sm0.m ↦ f32)
        let MinScale sm1 ← min_scale_k4(idx + 1, b)
        let f32 d2 ← d * (sm1.sc ↦ f32)
        let f32 m2 ← dmin * (sm1.m ↦ f32)
        mut list<f32> low ← empty
        mut list<f32> high ← empty

        # --- 32-elem low + high nibble decode -----------------------------
        for range 0 ‥ 32 let l {
            let int qs ← byte_at(b, 48 + qoff + l)
            let int qh ← byte_at(b, 16 + l)
            # 5th bits: bit 2c (low nibble) / bit 2c+1 (high nibble).
            let int hi_lo ← (qh ⇒ 2 * chunk) % 2 * 16
            let int hi_hi ← (qh ⇒ 2 * chunk + 1) % 2 * 16
            let int qs16_lo ← qs % 16 ∨ hi_lo
            let int qs16_hi ← (qs ⇒ 4) % 16 ∨ hi_hi
            low.append(d1 * (qs16_lo ↦ f32) - m1)
            high.append(d2 * (qs16_hi ↦ f32) - m2)
        }

        for from low let v {
            y.append(v)
        }

        for from high let v {
            y.append(v)
        }

        qoff ← qoff + 32
        idx ← idx + 2
    }

    return y
}

# `block_q6_K`: ql[128] low nibbles, qh[64] high bits, scales[16] int8,
# d (half) at byte offset 208. Output order matches llama.cpp: within
# each 128-element group the four quants are written at strides 0/32/64/96
# over l — one 32-elem run per stride, appended in stride order.
fn dequant_q6_k(list<u8> b) → list<f32> ⇥ DequantError {
    # --- block scale d (byte 208) -----------------------------------------
    let f32 d ← half(b, 208)
    mut list<f32> y ← empty

    # --- per-128 group (offsets + quants q1..q4) --------------------------
    for range 0 ‥ 2 let n {
        let int sc_base ← n * 8
        let int ql_off ← n * 64
        let int qh_off ← n * 32
        mut list<f32> q1s ← empty
        mut list<f32> q2s ← empty
        mut list<f32> q3s ← empty
        mut list<f32> q4s ← empty

        # --- 32-elem quants q1..q4 (scales + -32) -------------------------
        for range 0 ‥ 32 let l {
            let int idx ← l / 16
            let int ql_lo ← byte_at(b, ql_off + l)
            let int ql_hi ← byte_at(b, ql_off + l + 32)
            let int qh ← byte_at(b, 128 + qh_off + l)
            # q1..q4: low/high nibbles + 2-bit high groups, then -32.
            let int q1 ← (ql_lo % 16 ∨ qh % 4 * 16) - 32
            let int q2 ← (ql_hi % 16 ∨ (qh ⇒ 2) % 4 * 16) - 32
            let int q3 ← ((ql_lo ⇒ 4) % 16 ∨ (qh ⇒ 4) % 4 * 16) - 32
            let int q4 ← ((ql_hi ⇒ 4) % 16 ∨ (qh ⇒ 6) % 4 * 16) - 32
            let f32 sc0 ← i8(byte_at(b, 192 + sc_base + idx + 0)) ↦ f32
            let f32 sc2 ← i8(byte_at(b, 192 + sc_base + idx + 2)) ↦ f32
            let f32 sc4 ← i8(byte_at(b, 192 + sc_base + idx + 4)) ↦ f32
            let f32 sc6 ← i8(byte_at(b, 192 + sc_base + idx + 6)) ↦ f32
            # Same left-associative f32 multiplication order as the C
            # kernels ((d * sc) * q), so outputs are bit-exact.
            q1s.append(d * sc0 * (q1 ↦ f32))
            q2s.append(d * sc2 * (q2 ↦ f32))
            q3s.append(d * sc4 * (q3 ↦ f32))
            q4s.append(d * sc6 * (q4 ↦ f32))
        }

        for from q1s let v {
            y.append(v)
        }

        for from q2s let v {
            y.append(v)
        }

        for from q3s let v {
            y.append(v)
        }

        for from q4s let v {
            y.append(v)
        }
    }

    return y
}

# F32 scalar block: bit-exact passthrough of the 4 little-endian bytes via
# the language endian-read form (bit-identical for every pattern, NaN
# payloads included).
fn dequant_f32(list<u8> b) → list<f32> ⇥ DequantError {
    let list<b8> buf ↤ b
    mut list<f32> y ← empty
    y.append(buf[0 ‥ 4] ↦ f32 via Le)
    return y
}

# F16 scalar block: one IEEE binary16 value (2 LE bytes) -> exact f32
# value. Reuses `half` — the same NativeF16Convert decode the Q-block
# scales already use (bit-exact for every finite half).
fn dequant_f16(list<u8> b) → list<f32> ⇥ DequantError {
    mut list<f32> y ← empty
    y.append(half(b, 0))
    return y
}

# BF16 scalar block: one bf16 value (2 LE bytes) -> exact f32 value.
fn dequant_bf16(list<u8> b) → list<f32> ⇥ DequantError {
    mut list<f32> y ← empty
    y.append(bfloat16(b, 0))
    return y
}

# -------------------------------------------------------------------------
# Wire identity — raw GGML ids become open representations and remain
# inspectable even when this module has no decoder for them. Decoding fails
# closed at the explicit representation boundary below.
# -------------------------------------------------------------------------

@ public
fn representation_for(int raw) → storage.Representation {
    return storage.ggml_representation(raw)
}

fn decode_kind(storage.Representation representation) → DecodeKind ⇥ DequantError {
    require representation.namespace ≡ "ggml" throw variant UnsupportedRepresentation { message = "unsupported numeric representation: §"(storage.identity(representation)) }

    let int raw ← representation.code

    switch raw {
        case 0 {
            return DecodeKind.F32
        }
        case 1 {
            return DecodeKind.F16
        }
        case 3 {
            return DecodeKind.Q4_1
        }
        case 6 {
            return DecodeKind.Q5_0
        }
        case 8 {
            return DecodeKind.Q8_0
        }
        case 12 {
            return DecodeKind.Q4_K
        }
        case 13 {
            return DecodeKind.Q5_K
        }
        case 14 {
            return DecodeKind.Q6_K
        }
        case 20 {
            return DecodeKind.IQ4_NL
        }
        case 30 {
            return DecodeKind.BF16
        }
        default {
            throw variant UnsupportedRepresentation { message = "unsupported GGML representation: §"(storage.identity(representation)) }
        }
    }
}

# -------------------------------------------------------------------------
# Layout facts (block elements / block bytes per supported type). Exhaustive
# matching is deliberate: adding a decoder requires an explicit implementation
# decision, while unknown representations remain preservable in storage.
# -------------------------------------------------------------------------

@ public
fn block_elements(storage.Representation representation) → int ⇥ DequantError {
    let DecodeKind kind ← decode_kind(representation)

    match kind {
        case DecodeKind.F32 {
            return F32_ELEMENTS
        }
        case DecodeKind.F16 {
            return F16_ELEMENTS
        }
        case DecodeKind.BF16 {
            return BF16_ELEMENTS
        }
        case DecodeKind.Q4_1 {
            return Q4_1_ELEMENTS
        }
        case DecodeKind.Q5_0 {
            return Q5_0_ELEMENTS
        }
        case DecodeKind.Q8_0 {
            return Q8_0_ELEMENTS
        }
        case DecodeKind.Q4_K {
            return Q4_K_ELEMENTS
        }
        case DecodeKind.Q5_K {
            return Q5_K_ELEMENTS
        }
        case DecodeKind.Q6_K {
            return Q6_K_ELEMENTS
        }
        case DecodeKind.IQ4_NL {
            return IQ4_NL_ELEMENTS
        }
    }
}

@ public
fn block_bytes(storage.Representation representation) → int ⇥ DequantError {
    let DecodeKind kind ← decode_kind(representation)
    return block_bytes_kind(kind)
}

fn block_bytes_kind(DecodeKind kind) → int {
    match kind {
        case DecodeKind.F32 {
            return dtype.width(dtype.f32())
        }
        case DecodeKind.F16 {
            return dtype.width(dtype.f16())
        }
        case DecodeKind.BF16 {
            return dtype.width(dtype.bf16())
        }
        case DecodeKind.Q4_1 {
            return Q4_1_BYTES
        }
        case DecodeKind.Q5_0 {
            return Q5_0_BYTES
        }
        case DecodeKind.Q8_0 {
            return Q8_0_BYTES
        }
        case DecodeKind.Q4_K {
            return Q4_K_BYTES
        }
        case DecodeKind.Q5_K {
            return Q5_K_BYTES
        }
        case DecodeKind.Q6_K {
            return Q6_K_BYTES
        }
        case DecodeKind.IQ4_NL {
            return IQ4_NL_BYTES
        }
    }
}

# -------------------------------------------------------------------------
# decode_block — decode ONE supported GGML block to explicitly decoded F32
# logical elements. Representation admission has already happened; only the
# block byte-length gate remains at this seam.
# -------------------------------------------------------------------------

fn decode_block(DecodeKind kind, list<u8> blocks) → list<f32> ⇥ DequantError {
    let int nbytes ← block_bytes_kind(kind)

    require blocks.length() ≡ nbytes throw variant BadBlock { message = "block byte length mismatch" }

    match kind {
        case DecodeKind.F32 {
            return dequant_f32(blocks)
        }
        case DecodeKind.F16 {
            return dequant_f16(blocks)
        }
        case DecodeKind.BF16 {
            return dequant_bf16(blocks)
        }
        case DecodeKind.Q4_1 {
            return dequant_q4_1(blocks)
        }
        case DecodeKind.Q5_0 {
            return dequant_q5_0(blocks)
        }
        case DecodeKind.Q8_0 {
            return dequant_q8_0(blocks)
        }
        case DecodeKind.Q4_K {
            return dequant_q4_k(blocks)
        }
        case DecodeKind.Q5_K {
            return dequant_q5_k(blocks)
        }
        case DecodeKind.Q6_K {
            return dequant_q6_k(blocks)
        }
        case DecodeKind.IQ4_NL {
            return dequant_iq4_nl(blocks)
        }
    }
}

# Convert the opaque byte carrier only at the arithmetic decoder boundary.
# Storage callers retain their original `bytes`; this list is an internal
# transient for the existing scalar decoder implementation.
fn byte_list(list<b8> input) → list<u8> {
    return input ↦ list<u8>
}

# -------------------------------------------------------------------------
# Byte conversion is intentionally only encoded-bytes → byte-list for the
# decoder's arithmetic. The storage boundary itself remains `bytes`.
# -------------------------------------------------------------------------

@ public
fn decode_block_f32(storage.Representation representation, list<b8> block) → list<f32> ⇥ DequantError {
    let DecodeKind kind ← decode_kind(representation)
    let list<u8> encoded ← byte_list(block)
    return decode_block(kind, encoded)
}

# -------------------------------------------------------------------------
# decode_order_f32 — decode a packed row (blocks × block_bytes, the GGUF
# data-region payload of one supported tensor) to explicitly decoded F32
# logical elements, in GGUF block order. Unknown representations remain
# available to storage callers but fail closed here.
# -------------------------------------------------------------------------

@ public
fn decode_order_f32(storage.Representation representation, list<b8> payload) → list<f32> ⇥ DequantError {
    let DecodeKind kind ← decode_kind(representation)
    let list<u8> encoded ← byte_list(payload)
    # --- row alignment gate (fail closed) ---------------------------------
    let int nbytes ← block_bytes(representation)

    require encoded.length() % nbytes ≡ 0 throw variant BadOrder { message = "row byte length not a multiple of block_bytes" }

    # --- per-block decode (GGUF block order) ------------------------------
    mut list<f32> y ← empty
    mut int off ← 0

    while off ≺ encoded.length() {
        mut list<u8> blocks ← empty

        for range 0 ‥ nbytes let i {
            blocks.append(encoded.get(off + i) coalesce 0 ∷ u8)
        }

        let list<f32> g ← decode_block(kind, blocks)

        for from g let v {
            y.append(v)
        }

        off ← off + nbytes
    }

    return y
}

+++ faber test
# Co-located package test for dequant.fab (PML2-U5 — CPU decode of the
# currently supported GGML representations; extended by GGUF-A3 C1 and
# W1-U3 with F16).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: supported-representation layout facts (block
# elements/bytes per type), open identity admission, explicit decoder failure
# for unsupported representations, block byte-length mismatch, row byte-length
# mismatch, NaN half/bf16, per-block element counts for the eight supported
# representations, the F16 native convert vs the independent f64 oracle, and
# row decoding over a multi-block payload. assert assertions run under the cargo-backed
# `faber test` harness (auditor-owned); `faber check` proves the whole
# surface type-checks.
#
# NOTE (pinned fixtures): the block bytes below are REAL blocks of the
# admitted pinned row (SmolLM2-360M-Instruct Q4_K_M) taken read-only from
# `radix/docs/factory/gpu-inference-gguf/evidence/gi2-dequant-goldens.json`
# (cpu-oracle goldens; `ggml/src/ggml-quants.c @ a957b7747`), plus the
# deterministic BF16/Q5_K blocks from the A3 union-set goldens
# (`fixtures/gguf/gguf-dequant-goldens.json`, schema
# `gguf-dequant-goldens-v2`) and the W1-U3 F16 IEEE binary16 pins (1.0 /
# max-finite). Every finite F16 is exactly representable in f32, so the
# f64-oracle values compare with `≡`. The numeric comparison for the
# quantized rows remains the auditor-owned execution path; this proba pins
# the STRUCTURE (element counts, byte lengths, error classes), the F16
# f64-oracle values, and the supported decoder layout facts.

import from "gradus:model/dequant" dequant

import from "gradus:storage" storage

# -- pinned block fixtures (real pinned-row blocks from the goldens) ------
#
# Why: a bare call in a static initializer is SEM060 (static_initializer_not_constant,
# by ruling); each fixture runs the pure local byte helpers inside `comptime { ... }`.

# F32 output_norm.weight block 0 (4 bytes).
const list<u8> F32_BLOCK = comptime { return bytes_of([0, 0, 166, 63]) }

# F16 (GGML_F16 = 1) IEEE binary16 blocks. "one" (0x3c00 = 1.0) and
# "max-finite" (0x7bff = 65504.0), each 2 LE bytes. Values are the
# independent f64 oracle (every finite binary16 is exact in f32).
const list<u8> F16_ONE_BLOCK = comptime { return bytes_of([0, 60]) }

const list<u8> F16_MAX_BLOCK = comptime { return bytes_of([255, 123]) }

# BF16 (GGML_BF16 = 30) deterministic blocks from the A3 union goldens.
# "one" (0x3f80) and "max-finite" (0x7f7f), each 2 bytes.
const list<u8> BF16_ONE_BLOCK = comptime { return bytes_of([128, 63]) }

const list<u8> BF16_MAX_BLOCK = comptime { return bytes_of([127, 127]) }

# Q5_0 blk.0.attn_q.weight block 0 (22 bytes).
const list<u8> Q5_0_BLOCK = comptime { return bytes_of([8, 43, 119, 109, 62, 184, 32, 0, 33, 111, 51, 16, 208, 254, 228, 14, 240, 50, 28, 17, 242, 10]) }

# Q8_0 blk.0.attn_v.weight block 0 (34 bytes).
const list<u8> Q8_0_BLOCK = comptime { return bytes_of([127, 19, 178, 239, 0, 129, 207, 249, 10, 3, 22, 207, 199, 10, 234, 132, 26, 233, 8, 241, 51, 13, 24, 225, 205, 206, 35, 9, 255, 237, 15, 51, 235, 168]) }

# Q4_K blk.3.ffn_down.weight block 0 (144 bytes).
const list<u8> Q4_K_BLOCK = comptime { return bytes_of([211, 19, 6, 31, 238, 238, 235, 177, 222, 234, 231, 244, 240, 220, 159, 186, 97, 100, 144, 165, 52, 118, 72, 149, 16, 60, 69, 242, 160, 117, 80, 24, 182, 37, 112, 72, 7, 231, 85, 117, 166, 35, 133, 55, 207, 85, 138, 139, 199, 178, 69, 190, 106, 82, 158, 227, 54, 168, 247, 162, 64, 165, 246, 111, 99, 102, 146, 73, 98, 72, 164, 233, 136, 84, 35, 124, 104, 144, 183, 6, 248, 89, 70, 77, 75, 118, 207, 143, 128, 105, 56, 134, 81, 173, 249, 12, 29, 152, 122, 138, 124, 121, 118, 154, 102, 72, 42, 108, 140, 132, 119, 174, 182, 184, 233, 215, 249, 145, 197, 198, 28, 100, 147, 181, 182, 87, 147, 132, 202, 182, 88, 165, 135, 213, 200, 242, 87, 64, 134, 134, 175, 154, 120, 8]) }

# Q5_K (GGML_Q5_K = 13) deterministic blocks from the A3 union goldens:
# "max-scale-ones" (d = 65504, dmin = -0.0, scales all 0x3f, qh/qs all
# ones) and "negative-d-highbits" (negative d, scale high-bit paths), each
# 176 bytes.
const list<u8> Q5_K_MAX_BLOCK = comptime { return add(add(add(bytes_of([255, 123, 0, 128]), repeat(63, 12)), repeat(255, 32)), repeat(255, 128)) }

const list<u8> Q5_K_HIGH_BLOCK = comptime { return add(add(bytes_of([0, 188, 0, 60, 255, 127, 191, 63, 60, 45, 30, 15, 63, 42, 21, 0]), repeat(255, 32)), repeat_order([0, 17, 34, 51], 32)) }

# Q6_K blk.0.ffn_down.weight block 0 (210 bytes).
const list<u8> Q6_K_BLOCK = comptime { return bytes_of([113, 120, 48, 26, 253, 99, 58, 251, 166, 32, 168, 217, 201, 249, 47, 200, 4, 194, 175, 244, 204, 57, 245, 253, 211, 250, 7, 254, 125, 60, 225, 222, 2, 42, 109, 248, 105, 64, 207, 51, 102, 53, 8, 188, 140, 17, 172, 178, 160, 175, 136, 104, 215, 71, 28, 27, 196, 7, 164, 93, 45, 180, 46, 17, 67, 80, 29, 121, 8, 71, 7, 235, 1, 188, 217, 125, 94, 215, 178, 138, 115, 34, 222, 156, 129, 177, 161, 13, 65, 139, 99, 91, 189, 156, 5, 181, 225, 121, 50, 146, 65, 127, 208, 9, 54, 133, 158, 153, 221, 72, 5, 224, 245, 162, 19, 143, 5, 104, 48, 107, 218, 64, 65, 80, 163, 135, 31, 229, 47, 115, 74, 76, 230, 118, 161, 201, 168, 236, 148, 136, 170, 194, 229, 88, 97, 217, 149, 169, 82, 218, 134, 18, 77, 201, 1, 233, 90, 68, 152, 168, 230, 116, 58, 89, 74, 153, 162, 87, 178, 199, 76, 176, 106, 71, 29, 32, 110, 153, 89, 97, 46, 80, 153, 197, 87, 154, 78, 82, 141, 78, 233, 102, 61, 131, 174, 66, 69, 60, 178, 128, 63, 161, 207, 92, 176, 48, 67, 117, 103, 135]) }

# -- byte-list helpers ----------------------------------------------------

fn bytes_of(list<int> vals) → list<u8> {
    mut list<u8> bs ← empty
    for from vals let v {
        bs.append(v ↦ u8 ⊥ 0)
    }
    return bs
}

fn bytes_from(list<u8> vals) → list<b8> {
    return vals ↦ list<b8>
}

fn representation(int raw) → storage.Representation {
    return dequant.representation_for(raw)
}

# Concatenate two byte lists (row assembly for the multi-block probes).
fn add(list<u8> a, list<u8> b) → list<u8> {
    mut list<u8> out ← empty
    for from a let byte {
        out.append(byte)
    }
    for from b let byte {
        out.append(byte)
    }
    return out
}

# Repeat one byte value n times (block-fixture assembly).
fn repeat(int v, int n) → list<u8> {
    mut list<u8> out ← empty
    for range 0‥n let i {
        out.append((v % 256) ↦ u8)
    }
    return out
}

# Repeat a byte pattern n times (block-fixture assembly).
fn repeat_order(list<int> pat, int n) → list<u8> {
    mut list<u8> out ← empty
    for range 0‥n let i {
        for from pat let v {
            out.append((v % 256) ↦ u8)
        }
    }
    return out
}

# -- outcome helpers ------------------------------------------------------

# Raw wire ids become open representations at the identity seam. The decoder
# receives that representation explicitly and rejects only when it has no
# implementation for the identity.
fn admission_result(int raw) → string {
    let storage.Representation ? ← dequant.representation_for(raw)
    return "ok"
}

# decode_block_f32 outcome as text ("ok" or the typed error's message).
fn block_result(storage.Representation kind, list<u8> blocks) → string {
    do {
        dequant.decode_block_f32(kind, bytes_from(blocks))
        return "ok"
    }
    catch err {
        return err.message
    }
}

# decode_order_f32 outcome as text ("ok" or the typed error's message).
fn order_result(storage.Representation kind, list<u8> bytes) → string {
    do {
        dequant.decode_order_f32(kind, bytes_from(bytes))
        return "ok"
    }
    catch err {
        return err.message
    }
}

# Element count of a successful F32 block decode (0 on error).
fn block_elements(storage.Representation kind, list<u8> blocks) → int {
    do {
        let list<f32> out ← dequant.decode_block_f32(kind, bytes_from(blocks))
        return out.length()
    }
    catch err {
        return 0
    }
}

# Element count of a successful F32 row decode (0 on error).
fn element_order(storage.Representation kind, list<u8> bytes) → int {
    do {
        let list<f32> out ← dequant.decode_order_f32(kind, bytes_from(bytes))
        return out.length()
    }
    catch err {
        return 0
    }
}

# First f32 of a successful block decode (0.0 on error). Used by the
# F16 f64-oracle pins — every finite binary16 is exact in f32.
fn block_payload(storage.Representation kind, list<u8> blocks) → f32 {
    do {
        let list<f32> out ← dequant.decode_block_f32(kind, bytes_from(blocks))
        return out.get(0) coalesce 0.0 ∷ f32
    }
    catch err {
        return 0.0 ∷ f32
    }
}

fn geometry_elements(storage.Representation kind) → int {
    do {
        return dequant.block_elements(kind)
    }
    catch err {
        return 0
    }
}

fn geometry_bytes(storage.Representation kind) → int {
    do {
        return dequant.block_bytes(kind)
    }
    catch err {
        return 0
    }
}

# -- layout facts ---------------------------------------------------------

test "decodes the eight supported GGML representations with their block layouts" {
    assert geometry_elements(representation(0)) ≡ 1
    assert geometry_bytes(representation(0)) ≡ 4
    assert geometry_elements(representation(1)) ≡ 1
    assert geometry_bytes(representation(1)) ≡ 2
    assert geometry_elements(representation(30)) ≡ 1
    assert geometry_bytes(representation(30)) ≡ 2
    assert geometry_elements(representation(6)) ≡ 32
    assert geometry_bytes(representation(6)) ≡ 22
    assert geometry_elements(representation(8)) ≡ 32
    assert geometry_bytes(representation(8)) ≡ 34
    assert geometry_elements(representation(12)) ≡ 256
    assert geometry_bytes(representation(12)) ≡ 144
    assert geometry_elements(representation(13)) ≡ 256
    assert geometry_bytes(representation(13)) ≡ 176
    assert geometry_elements(representation(14)) ≡ 256
    assert geometry_bytes(representation(14)) ≡ 210
}

test "unknown and unsupported ids survive identity admission" {
    assert admission_result(2) ≡ "ok"
    assert admission_result(15) ≡ "ok"
    assert admission_result(4096) ≡ "ok"
    assert block_result(representation(2), bytes_of([0])) ≡ "unsupported GGML representation: ggml/unspecified/q4_0/2"
}

# -- block decode (pinned-row blocks, element-count structure) -------------

test "F32 block yields one f32 element" {
    assert block_elements(representation(0), F32_BLOCK) ≡ 1
}

test "F16 block yields one f32 element matching the f64 oracle" {
    assert block_elements(representation(1), F16_ONE_BLOCK) ≡ 1
    assert block_elements(representation(1), F16_MAX_BLOCK) ≡ 1
    assert block_payload(representation(1), F16_ONE_BLOCK) ≡ 1.0 ∷ f32
    assert block_payload(representation(1), F16_MAX_BLOCK) ≡ 65504.0 ∷ f32
}

test "BF16 block yields one f32 element matching the bf16 oracle" {
    assert block_elements(representation(30), BF16_ONE_BLOCK) ≡ 1
    assert block_elements(representation(30), BF16_MAX_BLOCK) ≡ 1
    # Every finite bf16 is exactly representable in f32: 0x3f80 = 1.0,
    # 0x7f7f = max-finite (2 - 2^-7) * 2^127.
    assert block_payload(representation(30), BF16_ONE_BLOCK) ≡ 1.0 ∷ f32
    assert block_payload(representation(30), BF16_MAX_BLOCK) ≡ 3.3895313892515355e38 ∷ f32
    # Negative normal: 0xbf80 = -1.0.
    let list<u8> bf16_neg ← bytes_of([128, 191])
    assert block_payload(representation(30), bf16_neg) ≡ -1.0 ∷ f32
}

test "Q4_1 block yields 32 f32 elements" {
    let list<u8> q4_1_blk ← bytes_of([0, 60, 0, 192, 240, 225, 210, 195, 180, 165, 150, 135, 120, 105, 90, 75, 60, 45, 30, 15])
    assert block_elements(representation(3), q4_1_blk) ≡ 32
}

test "Q5_0 block yields 32 f32 elements" {
    assert block_elements(representation(6), Q5_0_BLOCK) ≡ 32
}

test "Q8_0 block yields 32 f32 elements" {
    assert block_elements(representation(8), Q8_0_BLOCK) ≡ 32
}

test "IQ4_NL block yields 32 f32 elements" {
    let list<u8> iq4_nl_blk ← bytes_of([0, 60, 240, 225, 210, 195, 180, 165, 150, 135, 120, 105, 90, 75, 60, 45, 30, 15])
    assert block_elements(representation(20), iq4_nl_blk) ≡ 32
}

test "Q4_K block yields 256 f32 elements" {
    assert block_elements(representation(12), Q4_K_BLOCK) ≡ 256
}

test "Q5_K block yields 256 f32 elements" {
    assert block_elements(representation(13), Q5_K_MAX_BLOCK) ≡ 256
    assert block_elements(representation(13), Q5_K_HIGH_BLOCK) ≡ 256
}

test "Q6_K block yields 256 f32 elements" {
    assert block_elements(representation(14), Q6_K_BLOCK) ≡ 256
}

# -- fail-closed gates ----------------------------------------------------

test "block byte-length mismatch fails closed" {
    # Q8_0 block trimmed to 33 bytes.
    let list<u8> trim ← excerpt(Q8_0_BLOCK, 33)
    assert block_result(representation(8), trim) ≡ "block byte length mismatch"
    # Q5_K block trimmed to 175 bytes.
    let list<u8> trim_q5k ← excerpt(Q5_K_MAX_BLOCK, 175)
    assert block_result(representation(13), trim_q5k) ≡ "block byte length mismatch"
    # BF16 block padded to 3 bytes.
    let list<u8> pad_bf16 ← add(BF16_ONE_BLOCK, bytes_of([0]))
    assert block_result(representation(30), pad_bf16) ≡ "block byte length mismatch"
    # F16 block padded to 3 bytes.
    let list<u8> pad_f16 ← add(F16_ONE_BLOCK, bytes_of([0]))
    assert block_result(representation(1), pad_f16) ≡ "block byte length mismatch"
}

test "NaN f16 half fails closed" {
    # IEEE binary16 quiet NaN (0x7e00): dequant must not smuggle a NaN into f32.
    let list<u8> nan_f16 ← bytes_of([0, 126])
    assert block_result(representation(1), nan_f16) ≡ "NaN half in dequant block"
}

test "NaN bf16 value fails closed" {
    # bf16 quiet NaN (0x7fc1): dequant must not smuggle a NaN into f32.
    let list<u8> nan_bf16 ← bytes_of([193, 127])
    assert block_result(representation(30), nan_bf16) ≡ "NaN bf16 value in dequant block"
}

test "row byte-length mismatch fails closed" {
    # Q4_K block (144 B) with one extra byte appended.
    let list<u8> padded ← add(Q4_K_BLOCK, bytes_of([0]))
    assert order_result(representation(12), padded) ≡ "row byte length not a multiple of block_bytes"
    # Q5_K block (176 B) with one extra byte appended.
    let list<u8> padded_q5k ← add(Q5_K_MAX_BLOCK, bytes_of([0]))
    assert order_result(representation(13), padded_q5k) ≡ "row byte length not a multiple of block_bytes"
}

# -- row decode ------------------------------------------------------------

test "two-block Q8_0 row yields 64 f32 elements" {
    let list<u8> row ← add(Q8_0_BLOCK, Q8_0_BLOCK)
    assert element_order(representation(8), row) ≡ 64
}

test "two-block F32 row yields 2 f32 elements" {
    let list<u8> row ← add(F32_BLOCK, F32_BLOCK)
    assert element_order(representation(0), row) ≡ 2
}

test "two-block F16 row yields 2 f32 elements" {
    let list<u8> row ← add(F16_ONE_BLOCK, F16_MAX_BLOCK)
    assert element_order(representation(1), row) ≡ 2
}

test "two-block BF16 row yields 2 f32 elements" {
    let list<u8> row ← add(BF16_ONE_BLOCK, BF16_MAX_BLOCK)
    assert element_order(representation(30), row) ≡ 2
}

test "row element count equals blocks × block elements" {
    let list<u8> row ← add(Q6_K_BLOCK, add(Q6_K_BLOCK, Q6_K_BLOCK))
    assert element_order(representation(14), row) ≡ 3 * geometry_elements(representation(14))
    let list<u8> row_q5k ← add(Q5_K_MAX_BLOCK, Q5_K_HIGH_BLOCK)
    assert element_order(representation(13), row_q5k) ≡ 2 * geometry_elements(representation(13))
}

# Sub-list helper for the trimmed-block probe.
fn excerpt(list<u8> b, int n) → list<u8> {
    mut list<u8> out ← empty
    for range 0‥n let i {
        out.append(b.get(i) coalesce 0 ∷ u8)
    }
    return out
}
