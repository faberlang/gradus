+++
locale = "en"
+++
# Admitted-model capsule — typed model identity handoff (PML2-U1, council C8).
#
# Public import: importa ex "gradus:model/capsule" capsula
# Depends on: gradus:model/artifact (pathless content identity),
#             gradus:model/gguf_manifest (GGUF per-format manifest, read-only).
#
# --- Contract ------------------------------------------------------------
#
# Schema: capsule-schema-2.0.0 (A1C-M1, GGUF-A1c clean break). Supersedes
# capsule-schema-1.0.0, which is retired as of 2026-08-13.
#
# The capsule is the typed handoff of model identity across owner
# boundaries: it is the only value that carries a model's identity from the
# owner of admission (Gradus) to every downstream owner (faber-runtime,
# hosts, product surfaces). Schema 2 carries exactly two value groups:
#
#   identitas (artifact.IdentitasContenuti)
#     — pathless content identity: named digest algorithm, whole-artifact
#       digest value, byte length. No path, no URL, no reader, no file
#       handle, no device object, and no payload.
#   manifestum (Manifesta)
#     — one per-format manifest: manifestum.ManifestumGguf (imported
#       read-only from gradus:model/gguf_manifest) for GGUF rows, or
#       ManifestumSafetensors (defined in this module) for Safetensors
#       rows. Per-tensor storage lives in the manifest descriptors
#       (LayoutGgml / dtype + data offsets), so mixed F32/quantized and
#       rank-3 layouts are representable. There is no single global
#       quantization row, no byte ownership, and no provenance path.
#
# TRUST ANCHORS: raw bytes and paths are NOT trust anchors. A file path is
# a locator, not an identity; raw model bytes have no identity until a
# typed admission produces a capsule. Only the capsule carries identity
# across Gradus <-> faber-runtime/hosts. Consumers never reconstruct
# identity from a path, filename, or naming convention.
#
# Schema 1 is RETIRED at this boundary. The schema-2 constructor has no
# schema-1 signature (a schema-1 call site fails to compile); verifica
# rejects a schema-1-stamped capsule; deserializa_identitas rejects a
# schema-1 wire form. Every entry point rejects a schema-1 stamp with the
# typed error AdmissionError.SchemaVetus. A consumer that receives a
# capsule (or identity wire form) whose schema version it does not know
# must reject it — no best-effort partial reads, no silent tolerance
# (VersioIgnota).
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * The language surface has no cryptographic digest primitive, so the
#     digest VALUE is produced and verified by the admission host (pure-
#     Rust, per GI1) before the capsule is built. This module validates
#     the claim's admitted algorithm, hex form, and positive length and
#     re-checks the carried manifest's consistency with that identity.
#   * Public names carry @ publica: the post-visibility-flip compiler
#     treats unmarked top-level names as module-private, and the schema-2
#     surface must be importable by the same-package callers
#     (gguf.fab, safetensors.fab) and proba consumers. Genuinely private
#     helpers stay @ privata.
#   * The GGUF manifest genus (manifestum.ManifestumGguf) is imported
#     read-only; its public names are @ publica (V-GGUFM/M8R4 closure),
#     so the Gguf union variant and the manifestum_gguf wrapper import
#     cleanly. gguf_manifest stays the single GGUF parser authority.
#   * Proba proof is compile-level until the FMIR stepper / faber test
#     path covers library probas (recorded serialize.proba residual):
#     capsule.proba is asserted via faber check; executed assertion runs
#     are deferred to the aggregate gate (A1C-M8).
#
# --- Seams ---------------------------------------------------------------
#   * concrete GGUF/Safetensors rows → capsule — gguf.fab (A1C-M2),
#     safetensors.fab (A1C-M3), the only constructor callers.
#   * per-format parsing — gradus:model/gguf_manifest (GGUF authority),
#     the safetensors header walk (safetensors.fab).
#   * digest computation — the admission host (pure-Rust, GI1).
#   * physical upload/device residency — hosts; paths/config — apps.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" manifestum

# -------------------------------------------------------------------------
# Schema and admitted-fact constants. schema_versio is the public contract
# identity (capsule-schema-2.0.0 → "2.0.0"); bump both the wire form and
# the constant on a schema change.
# -------------------------------------------------------------------------


const string schema_versio ← "2.0.0"

# Admitted digest algorithm (§3.2 — default sha-256; extensible per R3).

const string DIGESTUM_SHA256 ← "sha-256"

# The retired schema-1 stamp, named explicitly by SchemaVetus.

const string SCHEMA_VETUS ← "1.0.0"

# -------------------------------------------------------------------------
# AdmissionError — typed error vocabulary of the capsule contract. Every
# variant carries a textus causa (render via causa). Variant → class:
#   VersioIgnota      — unknown capsule schema version (reject, no partial
#                       reads).
#   SchemaVetus       — schema-1 capsule / wire form rejected at the
#                       schema-2 boundary (schema 1 is retired).
#   AlgorithmusIgnotus— un-admitted digest algorithm.
#   DigestioMala      — malformed digest value (format / length / charset)
#                       or a digest mismatch on verification.
#   ManifestumMala    — malformed per-format manifest: an empty or
#                       non-matching format/version, an artifact-length
#                       mismatch, an invalid byte length, a malformed
#                       tensor descriptor, or a manifest inconsistent with
#                       the carried identity.
#   WireMala          — malformed capsule identity wire form.
# -------------------------------------------------------------------------


@ public { }
union AdmissionError {
    VersioIgnota {
        string causa
    },
    SchemaVetus {
        string causa
    },
    AlgorithmusIgnotus {
        string causa
    },
    DigestioMala {
        string causa
    },
    ManifestumMala {
        string causa
    },
    WireMala {
        string causa
    }
}

@ public { }
fn causa(AdmissionError e) → string {
    match e {
        case VersioIgnota const causa {
            return causa
        }
        case SchemaVetus const causa {
            return causa
        }
        case AlgorithmusIgnotus const causa {
            return causa
        }
        case DigestioMala const causa {
            return causa
        }
        case ManifestumMala const causa {
            return causa
        }
        case WireMala const causa {
            return causa
        }
    }
}

# -------------------------------------------------------------------------
# The Safetensors manifest genera (A1C-M1, D1/D4): format/version + header
# metadata + per-tensor descriptors (name, dtype, shape, data offsets),
# mirroring manifestum.ManifestumGguf's descriptor style. These are
# same-module carriers; the capsule is the only value built by admission,
# and none of these genera expose mutators.
# -------------------------------------------------------------------------


@ public { }
class MetadatumSafetensori {
    string clavis
    string valor

    # Metadata key (e.g. "format.name").
    fn clavis() → string {
        return self.clavis
    }

    # Metadata value (verbatim header string).
    fn valor() → string {
        return self.valor
    }
}

@ public { }
class DescriptioTensorisSafetensori {
    string nomen
    string typo
    list<int> forma
    int initium
    int finis
    int elementa

    # Tensor name (e.g. "model.embed_tokens.weight").
    fn nomen() → string {
        return self.nomen
    }

    # Stored dtype name (structural fixture row: "F32").
    fn typo() → string {
        return self.typo
    }

    # Logical shape (row-major dimensions).
    fn forma() → list<int> {
        return self.forma
    }

    # Data offset (relative to the data-region start), inclusive.
    fn initium() → int {
        return self.initium
    }

    # Exclusive data end (relative to the data-region start).
    fn finis() → int {
        return self.finis
    }

    # Logical element count (product of the shape).
    fn elementa() → int {
        return self.elementa
    }
}

@ public { }
class ManifestumSafetensors {
    string formatum
    string versio
    int longitudo_artifacti
    int longitudo_datorum
    list<MetadatumSafetensori> metadata
    list<DescriptioTensorisSafetensori> tensores

    # Format name (pinned row: "safetensors").
    fn formatum() → string {
        return self.formatum
    }

    # Header format version (pinned row: "1.0.0").
    fn versio() → string {
        return self.versio
    }

    # Whole-artifact byte length (must equal the capsule identity length).
    fn longitudo_artefacti() → int {
        return self.longitudo_artifacti
    }

    # Data-region byte length (offsets are relative to its start).
    fn longitudo_datorum() → int {
        return self.longitudo_datorum
    }

    # Header metadata entry count.
    fn metadatorum_numerus() → int {
        return self.metadata.length()
    }

    # Tensor descriptor count.
    fn tensorum_numerus() → int {
        return self.tensores.length()
    }

    # Indexed header metadata entry (bounds-checked).
    fn metadatum(int i) → MetadatumSafetensori ⇥ AdmissionError {
        if i ≺ 0 or i ≥ self.metadata.length() {
            throw variant ManifestumMala {causa = "metadata index out of bounds"}
        }
        return self.metadata.get(i) coalesce MetadatumSafetensori {clavis = "", valor = ""}
    }

    # Indexed tensor descriptor (bounds-checked).
    fn descriptio(int i) → DescriptioTensorisSafetensori ⇥ AdmissionError {
        if i ≺ 0 or i ≥ self.tensores.length() {
            throw variant ManifestumMala {causa = "tensor descriptor index out of bounds"}
        }
        return self.tensores.get(i) coalesce DescriptioTensorisSafetensori {nomen = "", typo = "", forma = [], initium = -1, finis = -1, elementa = -1}
    }
}

# -------------------------------------------------------------------------
# Manifesta — the per-format manifest carrier. A capsule holds exactly one
# manifest: ManifestumGguf for a GGUF row or ManifestumSafetensors for a
# Safetensors row. The two wrappers below are the only construction entry
# points (a caller never pattern-builds a variant directly).
# -------------------------------------------------------------------------


@ public { }
union Manifesta {
    Gguf {
        manifestum.ManifestumGguf gguf
    },
    Safetensors {
        ManifestumSafetensors saf
    }
}

# Wrap a GGUF manifest into the capsule's per-format carrier.
@ public { }
fn manifestum_gguf(manifestum.ManifestumGguf m) → Manifesta {
    return variant Gguf {gguf = m}
}

# Wrap a Safetensors manifest into the capsule's per-format carrier.
@ public { }
fn manifestum_safetensors(ManifestumSafetensors m) → Manifesta {
    return variant Safetensors {saf = m}
}

# -------------------------------------------------------------------------
# Capsula — the admitted-model capsule. Constructed only by
# structa_manifestum (the fail-closed admission); exposes projections only
# (immutable).
# -------------------------------------------------------------------------


@ public { }
class Capsula {
    string schema
    artifact.IdentitasContenuti identitas
    Manifesta manifestum

    # Schema version this capsule conforms to (capsule-schema-2.0.0).
    fn schematis() → string {
        return self.schema
    }

    # The pathless content identity (algorithm + digest + byte length).
    fn identitas_artificii() → artifact.IdentitasContenuti {
        return self.identitas
    }

    # Named digest algorithm.
    fn algorithmus() → string {
        return self.identitas.algorithmus
    }

    # Whole-artifact digest value (hex).
    fn digestio() → string {
        return self.identitas.digestio
    }

    # Recorded artifact byte length.
    fn longitudo() → int {
        return self.identitas.longitudo
    }

    # Per-format manifest family: "gguf" or "safetensors".
    fn formatum() → string {
        match self.manifestum {
            case Gguf const gguf {
                return "gguf"
            }
            case Safetensors const saf {
                return "safetensors"
            }
        }
    }

    # Tensor descriptor count across the carried manifest.
    fn tensorum_numerus() → int {
        match self.manifestum {
            case Gguf const gguf {
                return gguf.tensores.length()
            }
            case Safetensors const saf {
                return saf.tensores.length()
            }
        }
    }

    # The GGUF manifest when this capsule holds a GGUF row, else nihil.
    fn manifestum_gguf() → manifestum.ManifestumGguf ∪ null {
        match self.manifestum {
            case Gguf const gguf {
                return gguf
            }
            case Safetensors const saf {
                return null
            }
        }
    }

    # The Safetensors manifest when this capsule holds a Safetensors row,
    # else nihil.
    fn manifestum_safetensors() → ManifestumSafetensors ∪ null {
        match self.manifestum {
            case Gguf const gguf {
                return null
            }
            case Safetensors const saf {
                return saf
            }
        }
    }

    # The schema-versioned identity record (the cross-boundary handoff).
    fn identia() → Identitas {
        return Identitas {schema = self.schema, algorithmus = self.identitas.algorithmus, digestio = self.identitas.digestio, longitudo_bytes = self.identitas.longitudo}
    }
}

# -------------------------------------------------------------------------
# Identitas — the schema-versioned identity record. This is the compact
# identity form that crosses owner boundaries (manifests, receipts, packet
# fields); it carries the identity-bearing fields only, never the bytes and
# never a provenance path (a path is a locator, not identity).
# -------------------------------------------------------------------------


@ public { }
class Identitas {
    string schema
    string algorithmus
    string digestio
    int longitudo_bytes

    # Capsule schema version this identity conforms to.
    fn schematis() → string {
        return self.schema
    }

    # Named digest algorithm.
    fn algorithmus() → string {
        return self.algorithmus
    }

    # Whole-artifact digest value (hex).
    fn digestio() → string {
        return self.digestio
    }

    # Recorded artifact byte length.
    fn longitudo_bytes() → int {
        return self.longitudo_bytes
    }
}

# Identity equality — the round-trip predicate of the identity wire form.
# Compares identity-bearing fields ONLY: never the provenance path and
# never the manifest contents (identity is the digest, not the payload).
@ public { }
fn identitas_aequus(Identitas a, Identitas b) → bool {
    if a.schematis() ≠ b.schematis() then return false
    if a.algorithmus() ≠ b.algorithmus() then return false
    if a.digestio() ≠ b.digestio() then return false
    if a.longitudo_bytes() ≠ b.longitudo_bytes() then return false
    return true
}

# -------------------------------------------------------------------------
# Private validation helpers. All return bivalens (predicates);
# structa_manifestum and verifica turn a falsum into the matching typed
# AdmissionError.
# -------------------------------------------------------------------------

# Hex-digit predicate for digest values.
@ private { }
fn _est_hex(string c) → bool {
    if ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9" then return true
    if ((((c ≡ "a" or c ≡ "b") or c ≡ "c") or c ≡ "d") or c ≡ "e") or c ≡ "f" then return true
    return false
}

# Whole-digest predicate: exactly 64 lowercase hex characters (sha-256 hex
# width; the contract's pinned rows are lowercase hex).
@ private { }
fn _hex_recta(string s) → bool {
    if s.length() ≠ 64 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _est_hex(s.get(i)) then return false
        i ← i + 1
    }
    return true
}

# Digit predicate for wire integer fields (no negative sign — a "-" fails
# closed).
@ private { }
fn _est_digitum(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

# Safetensors tensor-descriptor predicate: non-empty name and dtype, a
# positive element count that exactly equals the checked shape product, and
# a non-negative, ordered, in-bounds data range.
@ private { }
fn _descriptio_recta(DescriptioTensorisSafetensori t, int longitudo_datorum) → bool {
    if t.nomen.length() ≡ 0 then return false
    if t.typo.length() ≡ 0 then return false
    if t.elementa ≺ 1 then return false
    if t.forma.length() ≡ 0 then return false
    var int product ← 1
    for from t.forma const dim {
        if dim ≺ 1 then return false
        if product ≻ 1000000000 / dim then return false
        product ← product * dim
    }
    if product ≠ t.elementa then return false
    if t.initium ≺ 0 then return false
    if t.finis ≤ t.initium then return false
    if t.finis ≻ longitudo_datorum then return false
    return true
}

# Per-format manifest predicate: the manifest family is consistent with the
# carried content identity. A GGUF manifest must carry the same identity
# and the same artifact length; a Safetensors manifest must carry the
# pinned format name, a non-empty version, a data region within the
# artifact, the same artifact length, and well-formed tensor descriptors.
@ private { }
fn _manifestum_recta(Manifesta m, artifact.IdentitasContenuti id) → bool {
    match m {
        case Gguf const gguf {
            if gguf.identitas.algorithmus ≠ id.algorithmus then return false
            if gguf.identitas.digestio ≠ id.digestio then return false
            if gguf.identitas.longitudo ≠ id.longitudo then return false
            if gguf.longitudo_artifacti ≠ id.longitudo then return false
            return true
        }
        case Safetensors const saf {
            if saf.formatum ≠ "safetensors" then return false
            if saf.versio.length() ≡ 0 then return false
            if saf.longitudo_datorum ≺ 1 then return false
            if saf.longitudo_datorum ≻ saf.longitudo_artifacti then return false
            if saf.longitudo_artifacti ≠ id.longitudo then return false
            for from saf.tensores const t {
                if not _descriptio_recta(t, saf.longitudo_datorum) then return false
            }
            return true
        }
    }
}

# -------------------------------------------------------------------------
# structa_manifestum — the fail-closed ADMISSION. The capsule can only be
# produced by this constructor; the schema stamp, the content identity, and
# the carried manifest are validated before the capsule is built, and any
# violation throws the matching typed AdmissionError. A schema-1 stamp is
# rejected with SchemaVetus; a schema-1 call site additionally fails to
# compile because no schema-1 constructor signature exists.
# -------------------------------------------------------------------------

@ public { }
fn structa_manifestum(string schema, artifact.IdentitasContenuti identitas, Manifesta manifestum) → Capsula ⇥ AdmissionError {
    # Schema rejection — a capsule is always stamped with the schema it
    # conforms to; schema 1 is retired, anything else is unknown (§5).
    if schema ≡ SCHEMA_VETUS {
        throw variant SchemaVetus {causa = "schema 1 is retired — capsule schema is 2.0.0"}
    }
    if schema ≠ schema_versio {
        throw variant VersioIgnota {causa = "unknown capsule schema version: " + schema}
    }
    # Content identity — admitted algorithm + well-formed whole-artifact
    # digest (value computed and verified host-side at admission, per GI1;
    # the claim's form and algorithm are re-checked here).
    if identitas.algorithmus ≠ DIGESTUM_SHA256 {
        throw variant AlgorithmusIgnotus {causa = "unknown digest algorithm: " + identitas.algorithmus}
    }
    if not _hex_recta(identitas.digestio) {
        throw variant DigestioMala {causa = "malformed digest value"}
    }
    if identitas.longitudo ≤ 0 {
        throw variant ManifestumMala {causa = "invalid artifact byte length"}
    }
    # Per-format manifest — consistent with the identity, well-formed.
    if not _manifestum_recta(manifestum, identitas) {
        throw variant ManifestumMala {causa = "manifestum is inconsistent with the artifact identity"}
    }
    return Capsula {schema = schema, identitas = identitas, manifestum = manifestum}
}

# -------------------------------------------------------------------------
# verifica — consumer-side self-verification (§1: self-verifying). Re-runs
# the admission matrix over a capsule without re-parsing raw model bytes, so
# a consumer can re-check identity from the capsule alone. A capsule built
# by structa_manifestum always passes (construction is fail-closed); this is
# the defense-in-depth check for capsules received across an owner
# boundary, and it rejects a schema-1 stamp with SchemaVetus.
# -------------------------------------------------------------------------

@ public { }
fn verifica(Capsula c) → bool ⇥ AdmissionError {
    if c.schema ≡ SCHEMA_VETUS {
        throw variant SchemaVetus {causa = "schema 1 is retired — capsule schema is 2.0.0"}
    }
    if c.schema ≠ schema_versio {
        throw variant VersioIgnota {causa = "unknown capsule schema version: " + c.schema}
    }
    if c.identitas.algorithmus ≠ DIGESTUM_SHA256 {
        throw variant AlgorithmusIgnotus {causa = "unknown digest algorithm: " + c.identitas.algorithmus}
    }
    if not _hex_recta(c.identitas.digestio) {
        throw variant DigestioMala {causa = "malformed digest value"}
    }
    if c.identitas.longitudo ≤ 0 {
        throw variant ManifestumMala {causa = "invalid artifact byte length"}
    }
    if not _manifestum_recta(c.manifestum, c.identitas) {
        throw variant ManifestumMala {causa = "manifestum is inconsistent with the artifact identity"}
    }
    return true
}

# Identity verification against an independently known digest (§3.2:
# identity verifies BEFORE any downstream selection, load, or backend
# binding; mismatch → fail closed with a typed error, no CPU fallback).
@ public { }
fn verifica_contra(Capsula c, string expectatum) → bool ⇥ AdmissionError {
    if not verifica(c) {
        throw variant ManifestumMala {causa = "capsule failed verification"}
    }
    if c.identitas.digestio ≠ expectatum {
        throw variant DigestioMala {causa = "digest mismatch — capsule does not match the expected artifact"}
    }
    return true
}

# -------------------------------------------------------------------------
# Identity wire form — the schema-versioned identity that crosses owner
# boundaries (manifest / receipt / packet fields reference it; downstream
# binds on the digest). The wire NEVER carries the bytes and NEVER carries
# the provenance path — identity is derived only from the capsule's own
# identity fields.
#
#   capsule/identity/<schema>/<algo>/<digest>/<byte_len>
#
# Deserialization rejects an unknown schema version, the retired schema-1
# stamp (SchemaVetus), an unknown marker, an un-admitted algorithm, a
# malformed digest, and a non-numeric or non-positive byte length — fail
# closed, no best-effort partial reads (§5).
# -------------------------------------------------------------------------

@ public { }
fn serializa_identitas(Capsula c) → string ⇥ AdmissionError {
    if not verifica(c) {
        throw variant ManifestumMala {causa = "capsule failed verification"}
    }
    return (((((("capsule/identity/" + c.schema) + "/") + c.identitas.algorithmus) + "/") + c.identitas.digestio) + "/") + (c.identitas.longitudo ↦ string)
}

# Parses a wire integer field (digits only, length-capped to guard the
# numerus carrier).
@ private { }
fn _parsa(string s) → int ⇥ AdmissionError {
    if s.length() ≡ 0 {
        throw variant WireMala {causa = "malformed numeric field"}
    }
    if s.length() ≻ 18 {
        throw variant WireMala {causa = "numeric field above the integer carrier"}
    }
    var int i ← 0
    while i ≺ s.length() {
        if not _est_digitum(s.get(i)) {
            throw variant WireMala {causa = "malformed numeric field"}
        }
        i ← i + 1
    }
    do {
        const int v ← s ↦ int
        return v
    }
    catch err {
        throw variant WireMala {causa = "malformed numeric field"}
    }
    throw variant WireMala {causa = "unreachable"}
}

@ public { }
fn deserializa_identitas(string wire) → Identitas ⇥ AdmissionError {
    const list<string> partes ← wire.split("/")
    if (partes.length() ≺ 2 or partes.get(0) coalesce "" ≠ "capsule") or partes.get(1) coalesce "" ≠ "identity" {
        throw variant WireMala {causa = "unknown capsule identity marker"}
    }
    # The retired schema-1 wire form carried seven fields (9 segments);
    # name it explicitly rather than reporting a malformed shape.
    if partes.length() ≡ 9 {
        if partes.get(2) coalesce "" ≡ SCHEMA_VETUS {
            throw variant SchemaVetus {causa = "schema 1 is retired — capsule schema is 2.0.0"}
        }
        throw variant WireMala {causa = "malformed capsule identity wire form"}
    }
    if partes.length() ≠ 6 {
        throw variant WireMala {causa = "malformed capsule identity wire form"}
    }
    const string schema ← partes.get(2) coalesce ""
    if schema ≡ SCHEMA_VETUS {
        throw variant SchemaVetus {causa = "schema 1 is retired — capsule schema is 2.0.0"}
    }
    if schema ≠ schema_versio {
        throw variant VersioIgnota {causa = "unknown capsule schema version: " + schema}
    }
    const string algorithmus ← partes.get(3) coalesce ""
    if algorithmus ≠ DIGESTUM_SHA256 {
        throw variant AlgorithmusIgnotus {causa = "unknown digest algorithm: " + algorithmus}
    }
    const string digestio ← partes.get(4) coalesce ""
    if not _hex_recta(digestio) {
        throw variant DigestioMala {causa = "malformed digest value"}
    }
    const int longitudo ← _parsa(partes.get(5) coalesce "")
    if longitudo ≺ 1 {
        throw variant WireMala {causa = "invalid byte length in capsule identity"}
    }
    return Identitas {schema = schema, algorithmus = algorithmus, digestio = digestio, longitudo_bytes = longitudo}
}
