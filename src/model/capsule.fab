+++ toml
locale = "en"

+++ faber
# Admitted-model capsule — typed model identity handoff (PML2-U1, council C8).
#
# Public import: import from "gradus:model/capsule" capsule
# Depends on: gradus:model/artifact (pathless content identity),
#             gradus:model/gguf_manifest (GGUF per-format manifest, read-only).
#
# --- Contract ------------------------------------------------------------
#
# Schema: capsule-schema-2.0.0 (A1C-M1, GGUF-A1c clean break). Supersedes
# capsule-schema-1.0.0, which is retired as of 2026-08-13.
#
# The capsule is the typed handoff of model identity across owner
# boundaries: it is the only value that carries a model's identity from the
# owner of admission (Gradus) to every downstream owner (faber-runtime,
# hosts, product surfaces). Schema 2 carries exactly two value groups:
#
#   identity (artifact.ContentIdentity)
#     — pathless content identity: named digest algorithm, whole-artifact
#       digest value, byte length. No path, no URL, no reader, no file
#       handle, no device object, and no payload.
#   manifest (Manifest)
#     — one per-format manifest: gguf_manifest.GgufManifest (imported
#       read-only from gradus:model/gguf_manifest) for GGUF rows, or
#       SafetensorsManifest (defined in this module) for Safetensors
#       rows. Per-tensor storage lives in the manifest descriptors
#       (GgmlLayout / dtype + data offsets), so mixed F32/quantized and
#       rank-3 layouts are representable. There is no single global
#       quantization row, no byte ownership, and no provenance path.
#
# TRUST ANCHORS: raw bytes and paths are NOT trust anchors. A file path is
# a locator, not an identity; raw model bytes have no identity until a
# typed admission produces a capsule. Only the capsule carries identity
# across Gradus <-> faber-runtime/hosts. Consumers never reconstruct
# identity from a path, filename, or naming convention.
#
# Schema 1 is RETIRED at this boundary. The schema-2 constructor has no
# schema-1 signature (a schema-1 call site fails to compile); verify
# rejects a schema-1-stamped capsule; deserialize_identity rejects a
# schema-1 wire form. Every entry point rejects a schema-1 stamp with the
# typed error AdmissionError.RetiredSchema. A consumer that receives a
# capsule (or identity wire form) whose schema version it does not know
# must reject it — no best-effort partial reads, no silent tolerance
# (UnknownVersion).
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * The language surface has no cryptographic digest primitive, so the
#     digest VALUE is produced and verified by the admission host (pure-
#     Rust, per GI1) before the capsule is built. This module validates
#     the claim's admitted algorithm, hex form, and positive length and
#     re-checks the carried manifest's consistency with that identity.
#   * Public names carry @ public: the post-visibility-flip compiler
#     treats unmarked top-level names as module-private, and the schema-2
#     surface must be importable by the same-package callers
#     (gguf.fab, safetensors.fab) and proba consumers. Genuinely private
#     helpers stay @ private.
#   * The GGUF manifest genus (gguf_manifest.GgufManifest) is imported
#     read-only; its public names are @ public (V-GGUFM/M8R4 closure),
#     so the Gguf union variant and the gguf_manifest wrapper import
#     cleanly. gguf_manifest stays the single GGUF parser authority.
#   * Proba proof is compile-level until the FMIR stepper / faber test
#     path covers library probas (recorded serialize.proba residual):
#     capsule.proba is asserted via faber check; executed assertion runs
#     are deferred to the aggregate gate (A1C-M8).
#
# --- Seams ---------------------------------------------------------------
#   * concrete GGUF/Safetensors rows → capsule — gguf.fab (A1C-M2),
#     safetensors.fab (A1C-M3), the only constructor callers.
#   * per-format parsing — gradus:model/gguf_manifest (GGUF authority),
#     the safetensors header walk (safetensors.fab).
#   * digest computation — the admission host (pure-Rust, GI1).
#   * physical upload/device residency — hosts; paths/config — apps.

import from "gradus:model/artifact"
import from "gradus:model/bundle"

const int INTEGER_MAX = 9223372036854775807

import from "gradus:model/gguf_manifest"

# -------------------------------------------------------------------------
# Schema and admitted-fact constants. schema_version is the public contract
# identity (capsule-schema-2.0.0 → "2.0.0"); bump both the wire form and
# the constant on a schema change.
# -------------------------------------------------------------------------


@ public
const string schema_version = "2.0.0"

@ public
fn schema_version_text() → string {
    return schema_version
}

# Admitted digest algorithm (§3.2 — default sha-256; extensible per R3).

const string DIGEST_SHA256 = "sha-256"

# The retired schema-1 stamp, named explicitly by RetiredSchema.

const string SCHEMA_RETIRED = "1.0.0"

# -------------------------------------------------------------------------
# AdmissionError — typed error vocabulary of the capsule contract. Every
# variant carries a text message (render via message). Variant → class:
#   UnknownVersion   — unknown capsule schema version (reject, no partial
#                      reads).
#   RetiredSchema    — schema-1 capsule / wire form rejected at the
#                      schema-2 boundary (schema 1 is retired).
#   UnknownAlgorithm — un-admitted digest algorithm.
#   BadDigest        — malformed digest value (format / length / charset)
#                      or a digest mismatch on verification.
#   BadManifest      — malformed per-format manifest: an empty or
#                      non-matching format/version, an artifact-length
#                      mismatch, an invalid byte length, a malformed
#                      tensor descriptor, or a manifest inconsistent with
#                      the carried identity.
#   BadWire          — malformed capsule identity wire form.
# -------------------------------------------------------------------------


@ public
union AdmissionError {
    @ shared
    string message

    UnknownVersion,
    RetiredSchema,
    UnknownAlgorithm,
    BadDigest,
    BadManifest,
    BadWire
}

# -------------------------------------------------------------------------
# The Safetensors manifest genera (A1C-M1, D1/D4): format/version + header
# metadata + per-tensor descriptors (name, dtype, shape, data offsets),
# mirroring gguf_manifest.GgufManifest's descriptor style. These are
# same-module carriers; the capsule is the only value built by admission,
# and none of these genera expose mutators.
# -------------------------------------------------------------------------


@ public
class SafetensorsMetadata {
    mut string key
    # Verbatim header string; not parsed.
    mut string payload
}

@ public
class SafetensorsTensorDescriptor {
    mut string name
    mut string dtype
    # Row-major dimensions.
    mut list<int> shape
    # Inclusive offset relative to the data-region start.
    mut int start
    # Exclusive end relative to the data-region start.
    mut int end
    # Product of the shape.
    mut int elements
}

@ public
class SafetensorsManifest {
    mut string format
    mut string version
    # Must equal the capsule identity length.
    mut int artifact_length
    # Offsets in the tensor table are relative to this region's start.
    mut int data_length
    mut list<SafetensorsMetadata> metadata
    mut list<SafetensorsTensorDescriptor> tensors

    fn metadata_count() → int {
        return self.metadata.length()
    }

    fn tensor_count() → int {
        return self.tensors.length()
    }

    fn metadata(int i) → SafetensorsMetadata ⇥ AdmissionError {
        require i ≥ 0 throw variant BadManifest { message = "metadata index out of bounds" }

        require i ≺ self.metadata.length() throw variant BadManifest { message = "metadata index out of bounds" }

        return self.metadata.get(i) coalesce SafetensorsMetadata { key = "", payload = "" }
    }

    fn description(int i) → SafetensorsTensorDescriptor ⇥ AdmissionError {
        require i ≥ 0 throw variant BadManifest { message = "tensor descriptor index out of bounds" }

        require i ≺ self.tensors.length() throw variant BadManifest { message = "tensor descriptor index out of bounds" }

        return self.tensors.get(i) coalesce SafetensorsTensorDescriptor { name = "", dtype = "", shape = [], start = -1, end = -1, elements = -1 }
    }
}

# -------------------------------------------------------------------------
# Manifest — the per-format manifest carrier. A capsule holds exactly one
# manifest: GgufManifest for a GGUF row or SafetensorsManifest for a
# Safetensors row. The two wrappers below are the only construction entry
# points (a caller never pattern-builds a variant directly).
# -------------------------------------------------------------------------


@ public
union Manifest {
    Gguf {
        gguf_manifest.GgufManifest gguf
    },
    Safetensors {
        SafetensorsManifest saf
    }
}

# Wrap a GGUF manifest into the capsule's per-format carrier.
@ public
fn from_gguf(gguf_manifest.GgufManifest m) → Manifest {
    return variant Gguf { gguf = m }
}

# Wrap a Safetensors manifest into the capsule's per-format carrier.
@ public
fn safetensors_manifest(SafetensorsManifest m) → Manifest {
    return variant Safetensors { saf = m }
}

# -------------------------------------------------------------------------
# Capsule — the admitted-model capsule. Constructed only by
# construct_manifest (the fail-closed admission); exposes projections only
# (immutable).
# -------------------------------------------------------------------------


@ public
class Capsule {
    mut string schema
    # Pathless content identity (algorithm + digest + byte length).
    mut artifact.ContentIdentity identity
    mut Manifest manifest

    fn algorithm() → string {
        return self.identity.algorithm
    }

    fn digest() → string {
        return self.identity.digest
    }

    fn length() → int {
        return self.identity.length
    }

    # Per-format family: "gguf" or "safetensors".
    fn format() → string {
        match self.manifest {
            case Gguf let gguf {
                return "gguf"
            }
            case Safetensors let saf {
                return "safetensors"
            }
        }
    }

    fn tensor_count() → int {
        match self.manifest {
            case Gguf let gguf {
                return gguf.tensors.length()
            }
            case Safetensors let saf {
                return saf.tensors.length()
            }
        }
    }

    # The GGUF manifest when this capsule holds a GGUF row, else null.
    fn gguf_manifest() → gguf_manifest.GgufManifest ∪ none {
        match self.manifest {
            case Gguf let gguf {
                return gguf
            }
            case Safetensors let saf {
                return null
            }
        }
    }

    # The Safetensors manifest when this capsule holds a Safetensors row,
    # else null.
    fn safetensors_manifest() → SafetensorsManifest ∪ none {
        match self.manifest {
            case Gguf let gguf {
                return null
            }
            case Safetensors let saf {
                return saf
            }
        }
    }

    # The schema-versioned identity record (the cross-boundary handoff).
    fn identity() → Identity {
        return Identity { schema = self.schema, algorithm = self.identity.algorithm, digest = self.identity.digest, byte_length = self.identity.length }
    }
}

# -------------------------------------------------------------------------
# Identity — the schema-versioned identity record. This is the compact
# identity form that crosses owner boundaries (manifests, receipts, packet
# fields); it carries the identity-bearing fields only, never the bytes and
# never a provenance path (a path is a locator, not identity).
# -------------------------------------------------------------------------


@ public
class Identity {
    mut string schema
    mut string algorithm
    mut string digest
    mut int byte_length
}

# -------------------------------------------------------------------------
# Private validation helpers. Predicates return bool; admit turns a false
# into the matching typed AdmissionError for construct_manifest and verify.
# -------------------------------------------------------------------------

# Digit predicate for wire integer fields (no negative sign — a "-" fails
# closed).
fn is_digit(string c) → bool {
    return "0123456789".contains(c)
}

# Hex-digit predicate for digest values (lowercase only).
fn is_hex(string c) → bool {
    return "0123456789abcdef".contains(c)
}

# Whole-digest predicate: exactly 64 lowercase hex characters (sha-256 hex
# width; the contract's pinned rows are lowercase hex).
fn hex_ok(string s) → bool {
    if s.length() ≢ 64 then return false

    for range 0 ‥ s.length() let i {
        # string.get is a 1-char value; it does not ≡ a character literal until converted.
        if not is_hex(s.get(i) ↦ string) then return false
    }

    return true
}

# Safetensors tensor-descriptor predicate: non-empty name and dtype, a
# positive element count that equals 1 for 0-D scalars or the checked shape
# product otherwise, and a non-negative, ordered, in-bounds data range.
fn description_ok(SafetensorsTensorDescriptor t, int data_length) → bool {
    if t.name.length() ≡ 0 then return false

    if t.dtype.length() ≡ 0 then return false

    if t.elements ≺ 1 then return false

    mut int product ← 1

    for from t.shape let dim {
        if dim ≺ 1 then return false

        if product ≻ INTEGER_MAX / dim then return false

        product ← product * dim
    }

    if product ≢ t.elements then return false

    if t.start ≺ 0 then return false

    if t.end ≤ t.start then return false

    if t.end ≻ data_length then return false

    return true
}

# Per-format manifest predicate: the manifest family is consistent with the
# carried content identity. A GGUF manifest must carry the same identity
# and the same artifact length; a Safetensors manifest must carry the
# pinned format name, a non-empty version, a data region within the
# artifact, the same artifact length, and well-formed tensor descriptors.
fn manifest_ok(Manifest m, artifact.ContentIdentity id) → bool {
    match m {
        case Gguf let gguf {
            if gguf.identity.algorithm ≢ id.algorithm then return false

            if gguf.identity.digest ≢ id.digest then return false

            if gguf.identity.length ≢ id.length then return false

            if gguf.artifact_length ≢ id.length then return false

            return true
        }
        case Safetensors let saf {
            if saf.format ≢ "safetensors" then return false

            if saf.version.length() ≡ 0 then return false

            if saf.data_length ≺ 1 then return false

            if saf.data_length ≻ saf.artifact_length then return false

            if saf.artifact_length ≢ id.length then return false

            for from saf.tensors let t {
                if not description_ok(t, saf.data_length) then return false
            }

            return true
        }
    }
}

# Fail-closed admission matrix: schema stamp, content-identity form, and
# per-format manifest consistency. construct_manifest and verify both run
# this; verify is defense-in-depth for capsules received across an owner
# boundary. Schema 1 is retired; anything else unknown is rejected (§5).
# The digest VALUE is computed host-side (GI1); this re-checks the claim's
# admitted algorithm, hex form, and positive length.
fn admit(string schema, artifact.ContentIdentity identity, Manifest manifest) → void ⇥ AdmissionError {
    # --- schema stamp (fail closed) ---------------------------------------
    require schema ≢ SCHEMA_RETIRED throw variant RetiredSchema { message = "schema 1 is retired — capsule schema is 2.0.0" }

    require schema ≡ schema_version throw variant UnknownVersion { message = "unknown capsule schema version: §"(schema) }

    # --- content-identity form (fail closed) ------------------------------
    require identity.algorithm ≡ DIGEST_SHA256 throw variant UnknownAlgorithm { message = "unknown digest algorithm: §"(identity.algorithm) }

    require hex_ok(identity.digest) throw variant BadDigest { message = "malformed digest value" }

    require identity.length ≻ 0 throw variant BadManifest { message = "invalid artifact byte length" }

    # --- per-format manifest consistency ----------------------------------
    require manifest_ok(manifest, identity) throw variant BadManifest { message = "manifest is inconsistent with the artifact identity" }
}

# -------------------------------------------------------------------------
# construct_manifest — the fail-closed ADMISSION. The capsule can only be
# produced by this constructor; the schema stamp, the content identity, and
# the carried manifest are validated before the capsule is built, and any
# violation throws the matching typed AdmissionError. A schema-1 stamp is
# rejected with RetiredSchema; a schema-1 call site additionally fails to
# compile because no schema-1 constructor signature exists.
# -------------------------------------------------------------------------

@ public
fn construct_manifest(string schema, artifact.ContentIdentity identity, Manifest manifest) → Capsule ⇥ AdmissionError {
    admit(schema, identity, manifest)
    return Capsule { schema = schema, identity = identity, manifest = manifest }
}

# -------------------------------------------------------------------------
# verify — consumer-side self-verification (§1: self-verifying). Re-runs
# the admission matrix over a capsule without re-parsing raw model bytes, so
# a consumer can re-check identity from the capsule alone. A capsule built
# by construct_manifest always passes (construction is fail-closed); this is
# the defense-in-depth check for capsules received across an owner
# boundary, and it rejects a schema-1 stamp with RetiredSchema.
# -------------------------------------------------------------------------

@ public
fn verify(Capsule c) → bool ⇥ AdmissionError {
    admit(c.schema, c.identity, c.manifest)
    return true
}

# Identity verification against an independently known digest (§3.2:
# identity verifies BEFORE any downstream selection, load, or backend
# binding; mismatch → fail closed with a typed error, no CPU fallback).
@ public
fn verify_against(Capsule c, string expected) → bool ⇥ AdmissionError {
    require verify(c) throw variant BadManifest { message = "capsule failed verification" }

    require c.identity.digest ≡ expected throw variant BadDigest { message = "digest mismatch — capsule does not match the expected artifact" }

    return true
}

# -------------------------------------------------------------------------
# Identity wire form — the schema-versioned identity that crosses owner
# boundaries (manifest / receipt / packet fields reference it; downstream
# binds on the digest). The wire NEVER carries the bytes and NEVER carries
# the provenance path — identity is derived only from the capsule's own
# identity fields.
#
#   capsule/identity/<schema>/<algo>/<digest>/<byte_len>
#
# Deserialization rejects an unknown schema version, the retired schema-1
# stamp (RetiredSchema), an unknown marker, an un-admitted algorithm, a
# malformed digest, and a non-numeric or non-positive byte length — fail
# closed, no best-effort partial reads (§5).
# -------------------------------------------------------------------------

@ public
fn serialize_identity(Capsule c) → string ⇥ AdmissionError {
    require verify(c) throw variant BadManifest { message = "capsule failed verification" }

    return "capsule/identity/§/§/§/§"(c.schema, c.identity.algorithm, c.identity.digest, c.identity.length ↦ string)
}

# Parses a wire integer field (digits only, length-capped to guard the
# number carrier).
fn parse(string s) → int ⇥ AdmissionError {
    require s.length() ≢ 0 throw variant BadWire { message = "malformed numeric field" }

    require s.length() ≤ 18 throw variant BadWire { message = "numeric field above the integer carrier" }

    for range 0 ‥ s.length() let i {
        require is_digit(s.get(i) ↦ string) throw variant BadWire { message = "malformed numeric field" }
    }

    do {
        let int v ↤ s
        return v
    }
    catch err {
        throw variant BadWire { message = "malformed numeric field" }
    }

    throw variant BadWire { message = "malformed numeric field" }
}

@ public
fn deserialize_identity(string wire) → Identity ⇥ AdmissionError {
    # --- marker + segment shape (fail closed) -----------------------------
    let list<string> partes ← wire.split("/")

    require partes.length() ≥ 2 throw variant BadWire { message = "unknown capsule identity marker" }

    require partes.get(0) coalesce "" ≡ "capsule" throw variant BadWire { message = "unknown capsule identity marker" }

    require partes.get(1) coalesce "" ≡ "identity" throw variant BadWire { message = "unknown capsule identity marker" }

    # The retired schema-1 wire form carried seven fields (9 segments);
    # name it explicitly rather than reporting a malformed shape.
    if partes.length() ≡ 9 {
        require partes.get(2) coalesce "" ≢ SCHEMA_RETIRED throw variant RetiredSchema { message = "schema 1 is retired — capsule schema is 2.0.0" }

        throw variant BadWire { message = "malformed capsule identity wire form" }
    }

    require partes.length() ≡ 6 throw variant BadWire { message = "malformed capsule identity wire form" }

    # --- identity fields (fail closed) ------------------------------------
    let string schema ← partes.get(2) coalesce ""

    require schema ≢ SCHEMA_RETIRED throw variant RetiredSchema { message = "schema 1 is retired — capsule schema is 2.0.0" }

    require schema ≡ schema_version throw variant UnknownVersion { message = "unknown capsule schema version: §"(schema) }

    let string algorithm ← partes.get(3) coalesce ""

    require algorithm ≡ DIGEST_SHA256 throw variant UnknownAlgorithm { message = "unknown digest algorithm: §"(algorithm) }

    let string digest ← partes.get(4) coalesce ""

    require hex_ok(digest) throw variant BadDigest { message = "malformed digest value" }

    let int length ← parse(partes.get(5) coalesce "")

    require length ≥ 1 throw variant BadWire { message = "invalid byte length in capsule identity" }

    # --- construct --------------------------------------------------------
    return Identity { schema = schema, algorithm = algorithm, digest = digest, byte_length = length }
}

# Project an admitted single-file Capsule onto a single-member ModelBundle.
@ public
fn to_bundle(Capsule c) → bundle.ModelBundle ⇥ AdmissionError {
    verify(c)

    do {
        match c.manifest {
            case Gguf let gguf {
                return bundle.gguf_single(c.identity)
            }
            case Safetensors let saf {
                return bundle.safetensors_unindexed([c.identity], null, null, null, null, null)
            }
        }
    }
    catch err {
        throw variant BadManifest { message = err.message }
    }
}

# Reconstruct a single-file Capsule from a single-member ModelBundle and its
# parsed per-format Manifest. Fails closed on multi-shard/multi-member
# bundles, auxiliary members (config, quant_config, shard_index, tokenizer),
# indexed shard maps, or container kind mismatch.
@ public
fn from_single_member_bundle(bundle.ModelBundle b, Manifest m) → Capsule ⇥ AdmissionError {
    require b.backbone_shards.length() ≡ 1 throw variant BadManifest { message = "from_single_member_bundle requires exactly 1 backbone shard" }
    require b.drafter is none and b.vision is none throw variant BadManifest { message = "from_single_member_bundle rejects multi-role bundles" }
    require b.config is none and b.quant_config is none and b.shard_index is none and b.tokenizer is none throw variant BadManifest { message = "from_single_member_bundle rejects auxiliary bundle members (config, quant_config, shard_index, tokenizer)" }

    match b.shard_map {
        case bundle.ShardMapping.Indexed let ? {
            throw variant BadManifest { message = "from_single_member_bundle rejects indexed shard maps" }
        }
        case bundle.ShardMapping.Unindexed let shard_count {
            require shard_count ≡ 1 throw variant BadManifest { message = "from_single_member_bundle requires single-shard unindexed mapping" }
        }
    }

    let bundle.BundleMember bb ← b.backbone_shards[0]
    require bb.shard_index ≡ 0 throw variant BadManifest { message = "from_single_member_bundle requires shard_index 0" }

    match m {
        case Gguf let gguf {
            require bundle.container_name(b.primary_container) ≡ "gguf" and bundle.container_name(bb.container) ≡ "gguf" throw variant BadManifest { message = "bundle member container is not GGUF" }
        }
        case Safetensors let saf {
            require bundle.container_name(b.primary_container) ≡ "safetensors" and bundle.container_name(bb.container) ≡ "safetensors" throw variant BadManifest { message = "bundle member container is not Safetensors" }
        }
    }

    return construct_manifest(schema_version, bb.identity, m)
}

+++ faber test
# Co-located package test for capsule.fab (PML2-U1 admitted-model capsule,
# capsule-schema-2.0.0, A1C-M1).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the fail-closed schema-2 admission constructor
# (happy row + every typed rejection path), the schema-2 capsule surface
# (pathless content identity + per-format manifest with per-tensor
# descriptors), self-verification, the schema-versioned identity wire
# round-trip, and the schema-1 rejection at the boundary (RetiredSchema).
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned; compile-level until the FMIR stepper / faber test path
# covers library probas — recorded serialize.proba residual); `faber check`
# proves the whole surface type-checks.
#
# NOTE (pinned-row fixtures): the digest values are format-valid 64-hex
# fixtures (the value's SHA-256 computation is host-side per the module
# header). The Safetensors row is the structural F32 fixture row of
# fixtures/safetensors (smollm2-360m-scaled-row shape names), scaled to the
# rule set: two F32 tensors whose ranges tile the data region exactly.

import from "gradus:model/capsule" capsule

import from "gradus:model/artifact" artifact
import from "gradus:model/bundle" bundle

# -- pinned fixture facts (structural Safetensors row) ----------------------

const string F_SCHEMA = "2.0.0"

const string F_ALGO = "sha-256"

const string F_DIGEST = "2fa3f01300000000000000000000000000000000000000000000000000bac9c2"

const string F_ALT_DIGEST = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const int F_LENGTH = 1024

const int F_DATA = 160

# -- helpers ---------------------------------------------------------------

# The pathless content identity carried by every admitted fixture.
fn identity_fixture() → artifact.ContentIdentity {
    return artifact.ContentIdentity {algorithm = F_ALGO, digest = F_DIGEST, length = F_LENGTH}
}

# An identity with caller-supplied fields (fail-closed cases).
fn identity_variant(string algorithm, string digest, int length) → artifact.ContentIdentity {
    return artifact.ContentIdentity {algorithm = algorithm, digest = digest, length = length}
}

# A Safetensors tensor descriptor.
fn description(string name, string kind, list<int> shape, int start, int end, int elements) → capsule.SafetensorsTensorDescriptor {
    return capsule.SafetensorsTensorDescriptor {name = name, dtype = kind, shape = shape, start = start, end = end, elements = elements}
}

# The two-descriptor F32 fixture row (ranges tile the 160-byte data region).
fn tensors_fixture() → list<capsule.SafetensorsTensorDescriptor> {
    return [description("model.embed_tokens.weight", "F32", [8, 4], 0, 128, 32), description("model.norm.weight", "F32", [8], 128, 160, 8)]
}

# The well-formed Safetensors manifest (format/version + metadata + tensors).
fn manifest_fixture() → capsule.SafetensorsManifest {
    return capsule.SafetensorsManifest {format = "safetensors", version = "1.0.0", artifact_length = F_LENGTH, data_length = F_DATA, metadata = [capsule.SafetensorsMetadata {key = "format.name", payload = "safetensors"}], tensors = tensors_fixture()}
}

# A manifest with caller-supplied fields (fail-closed cases).
fn manifest_variant(string format, string version, int artifact_length, int data_length, list<capsule.SafetensorsTensorDescriptor> tensors) → capsule.SafetensorsManifest {
    return capsule.SafetensorsManifest {format = format, version = version, artifact_length = artifact_length, data_length = data_length, metadata = [], tensors = tensors}
}

# Renders an admission outcome as text: "ok" on success, the typed
# error's message on rejection.
fn construct_result(string schema, artifact.ContentIdentity id, capsule.SafetensorsManifest m) → string {
    do {
        let capsule.Capsule c ← capsule.construct_manifest(schema, id, capsule.safetensors_manifest(m))
        if c.schema ≡ schema then return "ok"
        return "unexpected schema stamp"
    }
    catch err {
        return err.message
    }
}

# Verify outcome as text.
fn verify_result(capsule.Capsule c) → string {
    do {
        let bool ok ← capsule.verify(c)
        if ok then return "ok"
        return "verification failed"
    }
    catch err {
        return err.message
    }
}

# Identity verification against an expected digest, as text.
fn against_result(capsule.Capsule c, string expected) → string {
    do {
        let bool ok ← capsule.verify_against(c, expected)
        if ok then return "ok"
        return "verification failed"
    }
    catch err {
        return err.message
    }
}

# Identity wire outcome as text ("ok" or the typed error's message).
fn identity_wire_result(string wire) → string {
    do {
        let capsule.Identity i ← capsule.deserialize_identity(wire)
        if i.schema ≡ "2.0.0" then return "ok"
        return "unexpected schema"
    }
    catch err {
        return err.message
    }
}

# Identity round-trip predicate: deserialize(serializa(c)).identity() ≡
# c.identity() by identity_equal.
fn roundtrip(capsule.Capsule c) → bool {
    do {
        let capsule.Identity i ← capsule.deserialize_identity(capsule.serialize_identity(c))
        return c.identity() ≡ i
    }
    catch err {
        return false
    }
}

# Hand-built schema-1-stamped capsule. construct_manifest can never produce
# it (schema 1 is rejected at admission), so it is built directly here to
# prove verify's boundary rejects the retired stamp with RetiredSchema.
fn capsule_schema_retired() → capsule.Capsule {
    return capsule.Capsule {schema = "1.0.0", identity = identity_fixture(), manifest = capsule.safetensors_manifest(manifest_fixture())}
}

# The schema-2 wire for the pinned identity.
fn wire_fixture() → string {
    return "capsule/identity/§/§/§/§"(F_SCHEMA, F_ALGO, F_DIGEST, F_LENGTH ↦ string)
}

# -- admission (happy row) --------------------------------------------------

test "admission admits the schema-2 safetensors capsule" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_fixture()) ≡ "ok"
}

test "the capsule stamps schema 2.0.0 and carries identity and manifest" {
    do {
        let capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        # Schema stamp (capsule-schema-2.0.0).
        assert c.schema ≡ "2.0.0"
        # Pathless content identity.
        assert c.algorithm() ≡ "sha-256"
        assert c.digest() ≡ F_DIGEST
        assert c.length() ≡ F_LENGTH
        # Per-format manifest.
        assert c.format() ≡ "safetensors"
        # The compact schema-versioned identity record.
        assert c.identity().schema ≡ "2.0.0"
        assert c.identity().algorithm ≡ "sha-256"
        assert c.identity().digest ≡ F_DIGEST
        assert c.identity().byte_length ≡ F_LENGTH
    }
    catch err {
        assert false
    }
}

test "verify passes on an admitted capsule" {
    do {
        let capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        assert verify_result(c) ≡ "ok"
    }
    catch err {
        assert false
    }
}

test "the capsule carries the safetensors manifest" {
    do {
        let capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        assert c.safetensors_manifest() not is none
    }
    catch err {
        assert false
    }
}

test "per-tensor descriptors are visible in the safetensors manifest" {
    do {
        let capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        assert c.tensor_count() ≡ 2
        let capsule.SafetensorsTensorDescriptor d0 ← manifest_fixture().description(0)
        assert d0.name ≡ "model.embed_tokens.weight"
        assert d0.dtype ≡ "F32"
        assert d0.elements ≡ 32
        let capsule.SafetensorsTensorDescriptor d1 ← manifest_fixture().description(1)
        assert d1.name ≡ "model.norm.weight"
        assert d1.elements ≡ 8
        let capsule.SafetensorsMetadata meta ← manifest_fixture().metadata(0)
        assert meta.key ≡ "format.name"
        assert meta.payload ≡ "safetensors"
        assert manifest_fixture().tensor_count() ≡ 2
    }
    catch err {
        assert false
    }
}

test "identity verifies against the expected digest and fails closed on a mismatch" {
    do {
        let capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        assert against_result(c, F_DIGEST) ≡ "ok"
        assert against_result(c, F_ALT_DIGEST) ≡ "digest mismatch — capsule does not match the expected artifact"
    }
    catch err {
        assert false
    }
}

test "the identity record round-trips the wire form" {
    do {
        let capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        assert roundtrip(c)
        assert identity_wire_result(wire_fixture()) ≡ "ok"
    }
    catch err {
        assert false
    }
}

test "a different digest changes the identity" {
    do {
        let capsule.Capsule a ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        let capsule.Capsule b ← capsule.construct_manifest(F_SCHEMA, identity_variant(F_ALGO, F_ALT_DIGEST, F_LENGTH), capsule.safetensors_manifest(manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, tensors_fixture())))
        assert a.identity() ≡ a.identity()
        assert a.identity() ≢ b.identity()
    }
    catch err {
        assert false
    }
}

# -- schema-1 rejection at the boundary (RetiredSchema) -----------------------

test "construct_manifest rejects a schema-1 stamp" {
    assert construct_result("1.0.0", identity_fixture(), manifest_fixture()) ≡ "schema 1 is retired — capsule schema is 2.0.0"
}

test "verify rejects a schema-1-stamped capsule" {
    assert verify_result(capsule_schema_retired()) ≡ "schema 1 is retired — capsule schema is 2.0.0"
}

test "deserialization rejects a schema-1-stamped wire" {
    assert identity_wire_result("capsule/identity/1.0.0/sha-256/§/§"(F_DIGEST, F_LENGTH ↦ string)) ≡ "schema 1 is retired — capsule schema is 2.0.0"
}

test "deserialization rejects the retired 9-segment schema-1 wire" {
    assert identity_wire_result("capsule/identity/1.0.0/sha-256/§/4/q4_k/llama/16"(F_DIGEST)) ≡ "schema 1 is retired — capsule schema is 2.0.0"
}

# -- fail-closed construction (error paths) ---------------------------------

test "rejects an unknown schema version" {
    assert construct_result("3.0.0", identity_fixture(), manifest_fixture()) ≡ "unknown capsule schema version: 3.0.0"
}

test "rejects an un-admitted digest algorithm" {
    assert construct_result(F_SCHEMA, identity_variant("md5", F_DIGEST, F_LENGTH), manifest_fixture()) ≡ "unknown digest algorithm: md5"
}

test "rejects a short digest value" {
    assert construct_result(F_SCHEMA, identity_variant(F_ALGO, "abc", F_LENGTH), manifest_fixture()) ≡ "malformed digest value"
}

test "rejects a non-hex digest value" {
    assert construct_result(F_SCHEMA, identity_variant(F_ALGO, "zzzzzzzz00000000000000000000000000000000000000000000000000bac9c2", F_LENGTH), manifest_fixture()) ≡ "malformed digest value"
}

test "rejects a non-positive artifact byte length" {
    assert construct_result(F_SCHEMA, identity_variant(F_ALGO, F_DIGEST, 0), manifest_fixture()) ≡ "invalid artifact byte length"
}

test "rejects a manifest whose artifact length does not match the identity" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", 2048, F_DATA, tensors_fixture())) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a non-safetensors format name" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("gguf", "1.0.0", F_LENGTH, F_DATA, tensors_fixture())) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects an empty format name" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("", "1.0.0", F_LENGTH, F_DATA, tensors_fixture())) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects an empty format version" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "", F_LENGTH, F_DATA, tensors_fixture())) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects an empty data region" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, 0, [])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a data region larger than the artifact" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, 2048, tensors_fixture())) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects an empty tensor name" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("", "F32", [8, 4], 0, 128, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects an empty tensor dtype" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "", [8, 4], 0, 128, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a zero-element tensor" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [8, 4], 0, 128, 0)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects an empty tensor shape" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [], 0, 128, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a negative tensor dimension" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [8, -4], 0, 128, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a tensor whose element count does not match the shape" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [8, 4], 0, 128, 31)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a negative tensor data offset" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [8, 4], -1, 128, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a reversed tensor data range" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [8, 4], 128, 128, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a tensor range beyond the data region" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [8, 4], 0, 161, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

# -- schema-versioned identity wire -----------------------------------------

test "deserialization rejects an unknown schema version" {
    assert identity_wire_result("capsule/identity/3.0.0/sha-256/§/§"(F_DIGEST, F_LENGTH ↦ string)) ≡ "unknown capsule schema version: 3.0.0"
}

test "deserialization rejects an unknown marker" {
    assert identity_wire_result("model/identity/2.0.0/sha-256/§/§"(F_DIGEST, F_LENGTH ↦ string)) ≡ "unknown capsule identity marker"
}

test "deserialization rejects a malformed wire form" {
    assert identity_wire_result("capsule/identity/2.0.0/sha-256") ≡ "malformed capsule identity wire form"
}

test "deserialization rejects a 9-segment non-schema-1 wire" {
    assert identity_wire_result("capsule/identity/3.0.0/sha-256/§/4/q4_k/llama/16"(F_DIGEST)) ≡ "malformed capsule identity wire form"
}

test "deserialization rejects an un-admitted digest algorithm" {
    assert identity_wire_result("capsule/identity/2.0.0/md5/§/§"(F_DIGEST, F_LENGTH ↦ string)) ≡ "unknown digest algorithm: md5"
}

test "deserialization rejects a malformed digest" {
    assert identity_wire_result("capsule/identity/2.0.0/sha-256/zz/§"(F_LENGTH ↦ string)) ≡ "malformed digest value"
}

test "deserialization rejects a non-numeric byte length" {
    assert identity_wire_result("capsule/identity/2.0.0/sha-256/§/many"(F_DIGEST)) ≡ "malformed numeric field"
}

test "deserialization rejects a non-positive byte length" {
    assert identity_wire_result("capsule/identity/2.0.0/sha-256/§/0"(F_DIGEST)) ≡ "invalid byte length in capsule identity"
}

test "to_bundle and from_single_member_bundle round-trip single-file safetensors capsule" {
    do {
        let capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        let bundle.ModelBundle b ← capsule.to_bundle(c)
        assert b.backbone_shards.length() ≡ 1
        assert b.backbone_shards[0].identity.digest ≡ F_DIGEST
        assert bundle.container_name(b.primary_container) ≡ "safetensors"

        let capsule.Capsule round ← capsule.from_single_member_bundle(b, capsule.safetensors_manifest(manifest_fixture()))
        assert c.identity() ≡ round.identity()
        assert round.tensor_count() ≡ 2

        # Retired schema-1 capsule fails closed in to_bundle
        mut bool caught_retired ← false
        do {
            capsule.to_bundle(capsule_schema_retired())
        }
        catch err {
            caught_retired ← true
        }
        assert caught_retired

        # Multi-shard bundle fails closed in from_single_member_bundle
        mut bool caught_multi ← false
        do {
            let bundle.ModelBundle multi ← bundle.safetensors_unindexed([identity_fixture(), identity_variant(F_ALGO, F_ALT_DIGEST, F_LENGTH)], null, null, null, null, null)
            do {
                capsule.from_single_member_bundle(multi, capsule.safetensors_manifest(manifest_fixture()))
            }
            catch err {
                caught_multi ← true
            }
        }
        catch err {
            assert false
        }
        assert caught_multi
    }
    catch err {
        assert false
    }
}

test "admits 0-D scalar descriptors and rejects non-unit scalar element count" {
    let list<capsule.SafetensorsTensorDescriptor> scalars ← [
        description("model.layers.0.self_attn.q_proj.global_scale", "F32", [], 0, 4, 1),
        description("model.layers.0.self_attn.q_proj._amax", "F32", [], 4, 8, 1),
        description("model.layers.0.self_attn.q_proj._outer_scale_denominator", "F32", [], 8, 12, 1)
    ]
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, 12, scalars)) ≡ "ok"
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, 12, [description("global_scale", "F32", [], 0, 8, 2)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "from_single_member_bundle rejects auxiliary bundle members and indexed shard maps" {
    let artifact.ContentIdentity bb_id ← identity_fixture()
    let artifact.ContentIdentity aux_id ← identity_variant(F_ALGO, F_ALT_DIGEST, 256)
    let capsule.Manifest m ← capsule.safetensors_manifest(manifest_fixture())
    do {
        let list<bundle.ModelBundle> rejected ← [
            bundle.safetensors_unindexed([bb_id], aux_id, null, null, null, null),
            bundle.safetensors_unindexed([bb_id], null, aux_id, null, null, null),
            bundle.safetensors_unindexed([bb_id], null, null, aux_id, null, null),
            bundle.safetensors_indexed([bb_id], aux_id, [bundle.ShardEntry { tensor_name = "w", shard_index = 0 }], null, null, null, null, null)
        ]

        for from rejected let bad_b {
            mut bool caught ← false
            do {
                capsule.from_single_member_bundle(bad_b, m)
            }
            catch err {
                caught ← true
            }
            assert caught
        }

        let bundle.BundleMember bb_member ← bundle.BundleMember { role = variant bundle.MemberRole.Backbone, container = variant bundle.ContainerKind.Safetensors, shard_index = 0, identity = bb_id }
        let bundle.ModelBundle indexed_only ← bundle.ModelBundle { schema = bundle.BUNDLE_SCHEMA, primary_container = variant bundle.ContainerKind.Safetensors, backbone_shards = [bb_member], drafter = null, vision = null, config = null, quant_config = null, shard_index = null, tokenizer = null, shard_map = variant bundle.ShardMapping.Indexed { entries = [bundle.ShardEntry { tensor_name = "w", shard_index = 0 }] } }
        mut string indexed_msg ← ""
        do {
            capsule.from_single_member_bundle(indexed_only, m)
        }
        catch err {
            indexed_msg ← err.message
        }
        assert indexed_msg ≡ "from_single_member_bundle rejects indexed shard maps"
    }
    catch err {
        assert false
    }
}
