locale = "en"
+++
# GEA2-U2 — nine typed F32 layer-0 block tensor views.
#
# This is the model-to-kernel admission seam. The source adapter reads one
# bounded absolute range and supplies its identity claims; this module retains
# only typed resident bytes and manifest facts. It has no path, reader,
# container, GGUF parser, or physical-device input.
#
# Every expected shape, range, and tensor digest below is copied from the
# frozen U1 manifest:
# radix/docs/factory/gpu-execution-architecture/evidence/gea2-input-manifest.json
# The logical shapes are the manifest's [out,in] boundary shapes, not the
# GGUF header's [in,out] dimension order.

import from "gradus:dtype" dtype

const int GEA2_ARTIFACT_LENGTH ← 1449071552
const string GEA2_ARTIFACT_DIGEST ← "4d10b02ea1b189cb9637b39ba1543c61f69a8766099076880888f4443754e128"

const string ATTN_NORM_CANONICAL ← "model.layers.0.input_layernorm"
const string ATTN_NORM_NAME ← "blk.0.attn_norm.weight"
const string ATTN_NORM_DIGEST ← "f1077466ee135619bae393981be53aede4475b22d2c9c1023a1c06e09703a42a"
const int ATTN_NORM_START ← 190530752
const int ATTN_NORM_END ← 190534592
const int ATTN_NORM_VALUES ← 960
const int ATTN_NORM_BYTES ← 3840

const string ATTN_Q_CANONICAL ← "model.layers.0.self_attn.q_proj"
const string ATTN_Q_NAME ← "blk.0.attn_q.weight"
const string ATTN_Q_DIGEST ← "783f85f80cd7334380d28c67972f3c253f64d47f9ff46cae99803a9d5a2890af"
const int ATTN_Q_START ← 224944832
const int ATTN_Q_END ← 228631232
const int ATTN_Q_VALUES ← 921600
const int ATTN_Q_BYTES ← 3686400

const string ATTN_K_CANONICAL ← "model.layers.0.self_attn.k_proj"
const string ATTN_K_NAME ← "blk.0.attn_k.weight"
const string ATTN_K_DIGEST ← "4a18b2fd9145b62c8c64a90bbac3dd2253243174d8d59b4910054c007f14a5f6"
const int ATTN_K_START ← 220029632
const int ATTN_K_END ← 221258432
const int ATTN_K_VALUES ← 307200
const int ATTN_K_BYTES ← 1228800

const string ATTN_V_CANONICAL ← "model.layers.0.self_attn.v_proj"
const string ATTN_V_NAME ← "blk.0.attn_v.weight"
const string ATTN_V_DIGEST ← "ff7bb3f6c066a4d125038f3a6b392d1a6fecd8942c6d9894692f714ea2564f34"
const int ATTN_V_START ← 228631232
const int ATTN_V_END ← 229860032
const int ATTN_V_VALUES ← 307200
const int ATTN_V_BYTES ← 1228800

const string ATTN_OUTPUT_CANONICAL ← "model.layers.0.self_attn.o_proj"
const string ATTN_OUTPUT_NAME ← "blk.0.attn_output.weight"
const string ATTN_OUTPUT_DIGEST ← "bdc80e98f5b7b9281bb78fd3c0490f8475ad3d834ece57c2bf9f2e5643a97700"
const int ATTN_OUTPUT_START ← 221258432
const int ATTN_OUTPUT_END ← 224944832
const int ATTN_OUTPUT_VALUES ← 921600
const int ATTN_OUTPUT_BYTES ← 3686400

const string FFN_NORM_CANONICAL ← "model.layers.0.post_attention_layernorm"
const string FFN_NORM_NAME ← "blk.0.ffn_norm.weight"
const string FFN_NORM_DIGEST ← "0a595048029b833cb8d7cced9f3e29f9ed942d743bef11ec0f5c0e6d1da3a598"
const int FFN_NORM_START ← 220025792
const int FFN_NORM_END ← 220029632
const int FFN_NORM_VALUES ← 960
const int FFN_NORM_BYTES ← 3840

const string FFN_GATE_CANONICAL ← "model.layers.0.mlp.gate_proj"
const string FFN_GATE_NAME ← "blk.0.ffn_gate.weight"
const string FFN_GATE_DIGEST ← "068c53d3d878f9264fd55232146b6e6a4dd2a87c90ccbd247750d1ae6673bbfb"
const int FFN_GATE_START ← 200364992
const int FFN_GATE_END ← 210195392
const int FFN_GATE_VALUES ← 2457600
const int FFN_GATE_BYTES ← 9830400

const string FFN_UP_CANONICAL ← "model.layers.0.mlp.up_proj"
const string FFN_UP_NAME ← "blk.0.ffn_up.weight"
const string FFN_UP_DIGEST ← "0af2dc00406730a736faa35e64712f2c545fee7257874d7173630a9b6d34b3c4"
const int FFN_UP_START ← 210195392
const int FFN_UP_END ← 220025792
const int FFN_UP_VALUES ← 2457600
const int FFN_UP_BYTES ← 9830400

const string FFN_DOWN_CANONICAL ← "model.layers.0.mlp.down_proj"
const string FFN_DOWN_NAME ← "blk.0.ffn_down.weight"
const string FFN_DOWN_DIGEST ← "dd0c22d4f1fba3cfa43a429548b09d237c25b8ec94701ac6f8d23fe4d56108e9"
const int FFN_DOWN_START ← 190534592
const int FFN_DOWN_END ← 200364992
const int FFN_DOWN_VALUES ← 2457600
const int FFN_DOWN_BYTES ← 9830400

@ public
class F32BlockView {
    string canonical_name
    string tensor_name
    dtype.DType dtype_tag
    list<int> shape
    int values
    int absolute_start
    int absolute_end
    int byte_length
    int artifact_length
    string artifact_digest
    string tensor_digest
    bytes payload

    fn canonical_name() → string {
        return self.canonical_name
    }

    fn tensor_name() → string {
        return self.tensor_name
    }

    fn dtype() → dtype.DType {
        return self.dtype_tag
    }

    fn shape() → list<int> {
        return self.shape
    }

    fn values() → int {
        return self.values
    }

    fn absolute_start() → int {
        return self.absolute_start
    }

    fn absolute_end() → int {
        return self.absolute_end
    }

    fn byte_length() → int {
        return self.byte_length
    }

    fn artifact_length() → int {
        return self.artifact_length
    }

    fn artifact_digest() → string {
        return self.artifact_digest
    }

    fn tensor_digest() → string {
        return self.tensor_digest
    }

    fn payload() → bytes {
        return self.payload
    }
}

@ public
union BlockViewError {
    @ shared
    string message

    BadName,
    BadDtype,
    BadShape,
    BadRange,
    BadDigest,
    BadPayload
}

fn _shape_matches(list<int> actual, list<int> expected) → bool {
    if actual.length() ≠ expected.length() then return false
    for range 0‥expected.length() const i {
        if actual.get(i) coalesce (-1) ≠ expected.get(i) coalesce (-1) then return false
    }
    return true
}

fn _range_matches(int start, int end, int expected_start, int expected_end, int expected_bytes, bytes payload) → bool {
    if start ≺ 0 then return false
    if end ≤ start then return false
    if start ≠ expected_start or end ≠ expected_end then return false
    if end - start ≠ expected_bytes then return false
    if payload.length() ≠ expected_bytes then return false
    return true
}

fn _admit(string canonical_name, string tensor_name, list<int> expected_shape, int expected_values, int expected_start, int expected_end, int expected_bytes, string expected_tensor_digest, bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32BlockView ⇥ BlockViewError {
    # --- artifact identity (fail closed) ----------------------------------
    require artifact_length ≡ GEA2_ARTIFACT_LENGTH throw variant BadRange {message = "GEA2 source artifact length does not match the frozen F32 GGUF"}
    require artifact_digest ≡ GEA2_ARTIFACT_DIGEST throw variant BadDigest {message = "GEA2 source artifact digest does not match the frozen F32 GGUF"}

    # --- tensor row identity + geometry (fail closed) ---------------------
    require tensor_digest ≡ expected_tensor_digest throw variant BadDigest {message = "GEA2 tensor digest does not match the frozen manifest row"}
    require _shape_matches(shape, expected_shape) throw variant BadShape {message = "GEA2 block tensor shape does not match the frozen manifest row"}
    require _range_matches(absolute_start, absolute_end, expected_start, expected_end, expected_bytes, payload) throw variant BadRange {message = "GEA2 block tensor range does not match the frozen manifest row"}
    require expected_values * dtype.width(dtype.f32()) ≡ expected_bytes throw variant BadPayload {message = "GEA2 F32 block tensor byte geometry is inconsistent"}
    return F32BlockView {canonical_name = canonical_name, tensor_name = tensor_name, dtype_tag = dtype.f32(), shape = shape, values = expected_values, absolute_start = absolute_start, absolute_end = absolute_end, byte_length = payload.length(), artifact_length = artifact_length, artifact_digest = artifact_digest, tensor_digest = tensor_digest, payload = payload}
}

# Each constructor is a separate typed admission function. The caller supplies
# only the bounded range bytes, absolute range, logical shape, and host-verified
# identity claims; names, dtype, and expected geometry are fixed here.
@ public
fn admit_attn_norm(bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32BlockView ⇥ BlockViewError {
    return _admit(ATTN_NORM_CANONICAL, ATTN_NORM_NAME, [960], ATTN_NORM_VALUES, ATTN_NORM_START, ATTN_NORM_END, ATTN_NORM_BYTES, ATTN_NORM_DIGEST, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_attn_q(bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32BlockView ⇥ BlockViewError {
    return _admit(ATTN_Q_CANONICAL, ATTN_Q_NAME, [960, 960], ATTN_Q_VALUES, ATTN_Q_START, ATTN_Q_END, ATTN_Q_BYTES, ATTN_Q_DIGEST, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_attn_k(bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32BlockView ⇥ BlockViewError {
    return _admit(ATTN_K_CANONICAL, ATTN_K_NAME, [320, 960], ATTN_K_VALUES, ATTN_K_START, ATTN_K_END, ATTN_K_BYTES, ATTN_K_DIGEST, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_attn_v(bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32BlockView ⇥ BlockViewError {
    return _admit(ATTN_V_CANONICAL, ATTN_V_NAME, [320, 960], ATTN_V_VALUES, ATTN_V_START, ATTN_V_END, ATTN_V_BYTES, ATTN_V_DIGEST, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_attn_output(bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32BlockView ⇥ BlockViewError {
    return _admit(ATTN_OUTPUT_CANONICAL, ATTN_OUTPUT_NAME, [960, 960], ATTN_OUTPUT_VALUES, ATTN_OUTPUT_START, ATTN_OUTPUT_END, ATTN_OUTPUT_BYTES, ATTN_OUTPUT_DIGEST, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_ffn_norm(bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32BlockView ⇥ BlockViewError {
    return _admit(FFN_NORM_CANONICAL, FFN_NORM_NAME, [960], FFN_NORM_VALUES, FFN_NORM_START, FFN_NORM_END, FFN_NORM_BYTES, FFN_NORM_DIGEST, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_ffn_gate(bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32BlockView ⇥ BlockViewError {
    return _admit(FFN_GATE_CANONICAL, FFN_GATE_NAME, [2560, 960], FFN_GATE_VALUES, FFN_GATE_START, FFN_GATE_END, FFN_GATE_BYTES, FFN_GATE_DIGEST, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_ffn_up(bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32BlockView ⇥ BlockViewError {
    return _admit(FFN_UP_CANONICAL, FFN_UP_NAME, [2560, 960], FFN_UP_VALUES, FFN_UP_START, FFN_UP_END, FFN_UP_BYTES, FFN_UP_DIGEST, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_ffn_down(bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32BlockView ⇥ BlockViewError {
    return _admit(FFN_DOWN_CANONICAL, FFN_DOWN_NAME, [960, 2560], FFN_DOWN_VALUES, FFN_DOWN_START, FFN_DOWN_END, FFN_DOWN_BYTES, FFN_DOWN_DIGEST, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

fn _validate_known(F32BlockView view, string expected_canonical, string expected_name, list<int> expected_shape, int expected_values, int expected_start, int expected_end, int expected_bytes, int expected_artifact_length, string expected_digest) → void ⇥ BlockViewError {
    # --- identity + dtype (fail closed) -----------------------------------
    require view.canonical_name() ≡ expected_canonical throw variant BadName {message = "GEA2 block view canonical identity does not match its admission row"}
    require view.tensor_name() ≡ expected_name throw variant BadName {message = "GEA2 block view tensor identity does not match its admission row"}
    require dtype.eq(view.dtype(), dtype.f32()) throw variant BadDtype {message = "GEA2 block view is not F32"}

    # --- shape + range (fail closed) --------------------------------------
    require _shape_matches(view.shape(), expected_shape) throw variant BadShape {message = "GEA2 block view shape does not match its admission row"}
    require view.values() ≡ expected_values throw variant BadShape {message = "GEA2 block view value count does not match its admission row"}
    require view.absolute_start() ≡ expected_start and view.absolute_end() ≡ expected_end throw variant BadRange {message = "GEA2 block view absolute range does not match its admission row"}
    require view.byte_length() ≡ expected_bytes throw variant BadRange {message = "GEA2 block view byte length does not match its admission row"}
    require view.payload().length() ≡ expected_bytes throw variant BadPayload {message = "GEA2 block view payload is not the admitted bounded range"}
    require view.artifact_length() ≡ expected_artifact_length throw variant BadRange {message = "GEA2 block view artifact length does not match the frozen F32 GGUF"}

    # --- digest facts (fail closed) ---------------------------------------
    require view.artifact_digest() ≡ GEA2_ARTIFACT_DIGEST throw variant BadDigest {message = "GEA2 block view artifact digest does not match the frozen F32 GGUF"}
    require view.tensor_digest() ≡ expected_digest throw variant BadDigest {message = "GEA2 block view tensor digest does not match its admission row"}
}

# Ordinary host validation before a view crosses into a device entry. The
# device body receives only the already-validated F32 resident view.
@ public
fn validate(F32BlockView view) → void ⇥ BlockViewError {
    if view.tensor_name() ≡ ATTN_NORM_NAME then return _validate_known(view, ATTN_NORM_CANONICAL, ATTN_NORM_NAME, [960], ATTN_NORM_VALUES, ATTN_NORM_START, ATTN_NORM_END, ATTN_NORM_BYTES, GEA2_ARTIFACT_LENGTH, ATTN_NORM_DIGEST)
    if view.tensor_name() ≡ ATTN_Q_NAME then return _validate_known(view, ATTN_Q_CANONICAL, ATTN_Q_NAME, [960, 960], ATTN_Q_VALUES, ATTN_Q_START, ATTN_Q_END, ATTN_Q_BYTES, GEA2_ARTIFACT_LENGTH, ATTN_Q_DIGEST)
    if view.tensor_name() ≡ ATTN_K_NAME then return _validate_known(view, ATTN_K_CANONICAL, ATTN_K_NAME, [320, 960], ATTN_K_VALUES, ATTN_K_START, ATTN_K_END, ATTN_K_BYTES, GEA2_ARTIFACT_LENGTH, ATTN_K_DIGEST)
    if view.tensor_name() ≡ ATTN_V_NAME then return _validate_known(view, ATTN_V_CANONICAL, ATTN_V_NAME, [320, 960], ATTN_V_VALUES, ATTN_V_START, ATTN_V_END, ATTN_V_BYTES, GEA2_ARTIFACT_LENGTH, ATTN_V_DIGEST)
    if view.tensor_name() ≡ ATTN_OUTPUT_NAME then return _validate_known(view, ATTN_OUTPUT_CANONICAL, ATTN_OUTPUT_NAME, [960, 960], ATTN_OUTPUT_VALUES, ATTN_OUTPUT_START, ATTN_OUTPUT_END, ATTN_OUTPUT_BYTES, GEA2_ARTIFACT_LENGTH, ATTN_OUTPUT_DIGEST)
    if view.tensor_name() ≡ FFN_NORM_NAME then return _validate_known(view, FFN_NORM_CANONICAL, FFN_NORM_NAME, [960], FFN_NORM_VALUES, FFN_NORM_START, FFN_NORM_END, FFN_NORM_BYTES, GEA2_ARTIFACT_LENGTH, FFN_NORM_DIGEST)
    if view.tensor_name() ≡ FFN_GATE_NAME then return _validate_known(view, FFN_GATE_CANONICAL, FFN_GATE_NAME, [2560, 960], FFN_GATE_VALUES, FFN_GATE_START, FFN_GATE_END, FFN_GATE_BYTES, GEA2_ARTIFACT_LENGTH, FFN_GATE_DIGEST)
    if view.tensor_name() ≡ FFN_UP_NAME then return _validate_known(view, FFN_UP_CANONICAL, FFN_UP_NAME, [2560, 960], FFN_UP_VALUES, FFN_UP_START, FFN_UP_END, FFN_UP_BYTES, GEA2_ARTIFACT_LENGTH, FFN_UP_DIGEST)
    if view.tensor_name() ≡ FFN_DOWN_NAME then return _validate_known(view, FFN_DOWN_CANONICAL, FFN_DOWN_NAME, [960, 2560], FFN_DOWN_VALUES, FFN_DOWN_START, FFN_DOWN_END, FFN_DOWN_BYTES, GEA2_ARTIFACT_LENGTH, FFN_DOWN_DIGEST)
    throw variant BadName {message = "GEA2 block view tensor is not one of the nine frozen layer-0 rows"}
}
