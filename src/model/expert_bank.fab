@ public
fn dispatch_routed_matvec_ga_u32_bf16<size E, size Out, size PackedIn, size Groups, size In>(BankedMatrixSpec spec, tensor<u32, [E, Out, PackedIn]> weight, tensor<bf16, [E, Out, Groups]> scales, tensor<bf16, [E, Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, int expert_idx) → void ⇥ ExpertBankError {
