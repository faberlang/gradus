@ public
kernel routed_expert_matvec_ggml_q4_k<size E, size Out, size RowBytes, size In>(tensor<u8, [E, Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx) → void {
    for from y at [row] thread lane let e {
        if expert_idx ≥ 0 and expert_idx ≺ E {
            let i32 row_block_limit ← RowBytes / 144
            let i32 in_block_limit ← In / 256
            mut f32 acc ← 0.0 ∷ f32

            for range 0 ‥ row_block_limit let b {
                if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                    let i32 base ← b * 144
                    let i32 d_lo ← (raw_blocks[[expert_idx, row, base]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 d_hi ← (raw_blocks[[expert_idx, row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 d ← ((((d_lo + d_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 dm_lo ← (raw_blocks[[expert_idx, row, base + 2]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 dm_hi ← (raw_blocks[[expert_idx, row, base + 3]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 dmin ← ((((dm_lo + dm_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 x_base ← b * 256
                    for exclusive 4 let chunk {
                        let i32 idx0 ← chunk * 2
                        let i32 idx1 ← idx0 + 1

                        mut i32 sc0 ← 0
                        mut i32 m0 ← 0
                        if idx0 ≺ 4 {
                            sc0 ← (raw_blocks[[expert_idx, row, base + 4 + idx0]] ↦ i32 ⊥ 0) ∧ 63
                            m0 ← (raw_blocks[[expert_idx, row, base + 8 + idx0]] ↦ i32 ⊥ 0) ∧ 63
                        }
                        else {
                            let i32 s_hi ← raw_blocks[[expert_idx, row, base + 8 + idx0]] ↦ i32 ⊥ 0
                            let i32 s_lo ← raw_blocks[[expert_idx, row, base + idx0]] ↦ i32 ⊥ 0
                            let i32 m_lo ← raw_blocks[[expert_idx, row, base + 4 + idx0]] ↦ i32 ⊥ 0
                            sc0 ← (s_hi ∧ 15) + (((s_lo ⇒ 6) ∧ 3) * 16)
                            m0 ← ((s_hi ⇒ 4) ∧ 15) + (((m_lo ⇒ 6) ∧ 3) * 16)
                        }

                        mut i32 sc1 ← 0
                        mut i32 m1 ← 0
                        if idx1 ≺ 4 {
                            sc1 ← (raw_blocks[[expert_idx, row, base + 4 + idx1]] ↦ i32 ⊥ 0) ∧ 63
                            m1 ← (raw_blocks[[expert_idx, row, base + 8 + idx1]] ↦ i32 ⊥ 0) ∧ 63
                        }
                        else {
                            let i32 s_hi ← raw_blocks[[expert_idx, row, base + 8 + idx1]] ↦ i32 ⊥ 0
                            let i32 s_lo ← raw_blocks[[expert_idx, row, base + idx1]] ↦ i32 ⊥ 0
                            let i32 m_lo ← raw_blocks[[expert_idx, row, base + 4 + idx1]] ↦ i32 ⊥ 0
                            sc1 ← (s_hi ∧ 15) + (((s_lo ⇒ 6) ∧ 3) * 16)
                            m1 ← ((s_hi ⇒ 4) ∧ 15) + (((m_lo ⇒ 6) ∧ 3) * 16)
                        }

                        let f32 d1 ← d * (sc0 ↦ f32)
                        let f32 m1f ← dmin * (m0 ↦ f32)
                        let f32 d2 ← d * (sc1 ↦ f32)
                        let f32 m2f ← dmin * (m1 ↦ f32)
                        let i32 qoff ← chunk * 32
                        let i32 cx_base ← x_base + chunk * 64

                        for exclusive 32 let l {
                            let i32 qs ← (raw_blocks[[expert_idx, row, base + 16 + qoff + l]] ↦ i32 ⊥ 0) ∧ 255
                            let f32 w0 ← d1 * ((qs ∧ 15) ↦ f32) - m1f
                            let f32 w1 ← d2 * (((qs ⇒ 4) ∧ 15) ↦ f32) - m2f
                            acc ← acc + w0 * x[[cx_base + l]] + w1 * x[[cx_base + 32 + l]]
                        }
                    }
                }
            }

            y[[row]] ← acc
        }
    }
}

