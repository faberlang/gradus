    let PackKind pk ← spec_pack_kind(spec)
    match pk {
        case PackU8 {}
        default { throw variant BadBinding { message = "expected U8-packed DualScaledFp4 BankedMatrixSpec" } }
    }
    require outer_scale_denominator ≻ 0.0 throw variant BadConfig { message = "outer_scale_denominator must be positive" }
    require spec.expert_count ≡ E and spec.out_features ≡ Out and spec.in_features ≡ In and spec.packed_cols ≡ PackedIn and spec.group_cols ≡ Groups throw variant BadShape { message = "shape mismatch in dispatch_routed_matvec_dual_scaled_fp4_modelopt_u8" }
    require expert_idx ≥ 0 and expert_idx ≺ E throw variant BadShape { message = "expert_idx out of bounds" }
    fp4.routed_expert_matvec_modelopt_u8<size E, size Out, size PackedIn, size Groups, size In>(weight, scales, amax, x, mut y, expert_idx ↦ i32 ⊥ 0, outer_scale_denominator, spec.group_size ↦ i32 ⊥ 16)
}

