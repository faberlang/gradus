    require spec.expert_count ≡ E and spec.out_features ≡ Out and spec.in_features ≡ In and spec.packed_cols ≡ PackedIn and spec.group_cols ≡ Groups throw variant BadShape { message = "shape mismatch in dispatch_routed_matvec_ga_u32_bf16" }
