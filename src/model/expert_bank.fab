    require expert_idx ≥ 0 and expert_idx ≺ E throw variant BadShape { message = "expert_idx out of bounds" }
    routed_expert_matvec_ga_u8<size E, size Out, size PackedIn, size Groups, size In>(weight, scales, biases, x, mut y, expert_idx ↦ i32 ⊥ 0, spec.bits ↦ i32 ⊥ 4, spec.group_size ↦ i32 ⊥ 64)
