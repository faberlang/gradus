                        mut i32 m0 ← 0
                        if idx0 ≺ 4 {
                            sc0 ← (raw_blocks[[expert_idx, row, base + 4 + idx0]] ↦ i32 ⊥ 0) ∧ 63
                            m0 ← (raw_blocks[[expert_idx, row, base + 8 + idx0]] ↦ i32 ⊥ 0) ∧ 63
                        }
                        else {
                            let i32 s_hi ← raw_blocks[[expert_idx, row, base + 8 + idx0]] ↦ i32 ⊥ 0
                            let i32 s_lo ← raw_blocks[[expert_idx, row, base + idx0]] ↦ i32 ⊥ 0
                            let i32 m_lo ← raw_blocks[[expert_idx, row, base + 4 + idx0]] ↦ i32 ⊥ 0
                            sc0 ← (s_hi ∧ 15) + (((s_lo ⇒ 6) ∧ 3) * 16)
                            m0 ← ((s_hi ⇒ 4) ∧ 15) + (((m_lo ⇒ 6) ∧ 3) * 16)
                        }

