+++ toml
locale = "en"

+++ faber
# ExpertBank — typed 3D banked MoE operator, routing variants, and packed
# device contractions (issue #104, zero NumericBlock).
#
# Public import: import from "gradus:model/expert_bank" let expert_bank
# Depends on: gradus:dtype, gradus:model/bundle, gradus:model/dequant,
#   gradus:model/tensor_directory, gradus:quant/group_affine, gradus:storage.
#
# --- Contract ------------------------------------------------------------
#
# 1. Binds 3D banked expert tensors [E, Out, In] per layer from
#    TensorDirectory so different layers (e.g. Inkling L0-19 vs L20-23) can
#    hold different quantization schemes (DenseF32/DenseBf16/DenseF16,
#    GroupAffineU32/GroupAffineU8, GgmlBlock*, BlockFp8, DualScaledFp4)
#    behind one ExpertBank interface.
# 2. Supports both split (gate_proj / up_proj / down_proj) and fused
#    (gate_up_proj / down_proj, or LoadView.FusedGateUpSplit) layouts.
# 3. Implements Inkling, Flint, and Qwen3.6 routing + shared-expert variants
#    with deterministic ascending-index tie breaking and ascending-expert-
#    index accumulation.
# 4. Provides exact reference decode/eval for B=1 and B=C, and packed device
#    @ kernel contractions (routed_expert_matvec for B=1 and
#    routed_expert_matmul for B=C) covering Dense F32 and GroupAffine u32/u8.

import from "gradus:dtype" let dtype
import from "gradus:model/bundle" let bundle
import from "gradus:model/dequant" let dequant
import from "gradus:model/tensor_directory" let td
import from "gradus:quant/block_fp8" let bf8
import from "gradus:quant/dual_scaled_fp4" let fp4
import from "gradus:quant/group_affine" let ga
import from "gradus:storage" let storage

@ public
union ExpertBankError {
    @ shared
    string message

    BadBinding,
    UnsupportedFormat,
    BadShape,
    BadConfig,
    NonFinite,
    DirectoryFailure {
        td.DirectoryError inner
    },
    GroupAffineFailure {
        ga.GroupAffineError inner
    },
    BlockFp8Failure {
        bf8.BlockFp8Error inner
    },
    DualScaledFp4Failure {
        fp4.DualScaledFp4Error inner
    },
    DequantFailure {
        dequant.DequantError inner
    }
}

@ conversion
fn from_directory_error(td.DirectoryError err) → ExpertBankError {
    return variant DirectoryFailure { message = err.message, inner = err }
}

@ conversion
fn from_group_affine_error(ga.GroupAffineError err) → ExpertBankError {
    return variant GroupAffineFailure { message = err.message, inner = err }
}

@ conversion
fn from_block_fp8_error(bf8.BlockFp8Error err) → ExpertBankError {
    return variant BlockFp8Failure { message = err.message, inner = err }
}

@ conversion
fn from_dual_scaled_fp4_error(fp4.DualScaledFp4Error err) → ExpertBankError {
    return variant DualScaledFp4Failure { message = err.message, inner = err }
}

@ conversion
fn from_dequant_error(dequant.DequantError err) → ExpertBankError {
    return variant DequantFailure { message = err.message, inner = err }
}

@ public
union ExpertWeightKind {
    DenseF32,
    DenseBf16,
    DenseF16,
    GgmlBlockQ8_0,
    GgmlBlockQ4_1,
    GgmlBlockQ5_0,
    GgmlBlockIQ4_NL,
    GgmlBlockQ4_K,
    GgmlBlockQ5_K,
    GgmlBlockQ6_K,
    GroupAffineU32,
    GroupAffineU8,
    BlockFp8,
    DualScaledFp4
}

@ public
class ExpertQuantHint {
    let string ∪ none mode
    let int ∪ none bits
    let int ∪ none group_size
}

@ public
fn default_quant_hint() → ExpertQuantHint {
    return ExpertQuantHint { mode = null, bits = null, group_size = null }
}

@ public
union PackKind {
    PackDense,
    PackU8,
    PackU32
}

@ public
union ExpertActivation {
    Swiglu,
    Situ {
        f32 gate_cap
        f32 up_cap
    }
}

@ public
class BankedMatrixSpec {
    let ExpertWeightKind kind
    let int expert_count
    let int out_features
    let int in_features
    let int bits
    let int group_size
    let int packed_cols
    let int group_cols
    let int block_rows = 0
    let int block_cols = 0
    let PackKind ∪ none pack = null
    let string scales_dtype = "F32"
    let bool has_modelopt_amax = false
}

@ public
fn spec_pack_kind(BankedMatrixSpec spec) → PackKind {
    if spec.pack not is none {
        return spec.pack coalesce variant PackKind.PackDense
    }
    match spec.kind {
        case ExpertWeightKind.GroupAffineU32 {
            return variant PackKind.PackU32
        }
        case ExpertWeightKind.GroupAffineU8 {
            return variant PackKind.PackU8
        }
        case ExpertWeightKind.BlockFp8 {
            if spec.packed_cols ≻ 0 and spec.in_features ≡ spec.packed_cols * 4 {
                return variant PackKind.PackU32
            }
            return variant PackKind.PackU8
        }
        case ExpertWeightKind.DualScaledFp4 {
            if spec.packed_cols ≻ 0 and spec.in_features ≡ spec.packed_cols * 8 {
                return variant PackKind.PackU32
            }
            return variant PackKind.PackU8
        }
        case ExpertWeightKind.DenseF32 {}
        case ExpertWeightKind.DenseBf16 {}
        case ExpertWeightKind.DenseF16 {}
        default {
            return variant PackKind.PackU8
        }
    }
    return variant PackKind.PackDense
}

@ public
union ExpertBankLayout {
    SplitGateUp {
        BankedMatrixSpec gate
        BankedMatrixSpec up
        BankedMatrixSpec down
    },
    FusedGateUp {
        BankedMatrixSpec gate_up
        int gate_rows
        int up_rows
        BankedMatrixSpec down
    }
}

@ public
class ExpertBank {
    let int expert_count
    let int hidden_size
    let int intermediate_size
    let ExpertBankLayout layout
    let bool has_router_bias
    let int shared_expert_count
    let ExpertActivation ∪ none activation = null
}

@ public
fn bank_activation(ExpertBank bank) → ExpertActivation {
    return bank.activation coalesce variant ExpertActivation.Swiglu
}

@ public
fn with_activation(ExpertBank bank, ExpertActivation act) → ExpertBank {
    return ExpertBank {
        expert_count = bank.expert_count,
        hidden_size = bank.hidden_size,
        intermediate_size = bank.intermediate_size,
        layout = bank.layout,
        has_router_bias = bank.has_router_bias,
        shared_expert_count = bank.shared_expert_count,
        activation = act
    }
}

# -------------------------------------------------------------------------
# 3D Banked Tensor Binding from TensorDirectory
# -------------------------------------------------------------------------

fn is_ggml_block_dtype(string raw_dtype) → bool {
    return raw_dtype ≡ "Q8_0" or raw_dtype ≡ "Q4_1" or raw_dtype ≡ "Q5_0" or raw_dtype ≡ "IQ4_NL" or raw_dtype ≡ "Q4_K" or raw_dtype ≡ "Q5_K" or raw_dtype ≡ "Q6_K"
}

fn ggml_kind_for(string raw_dtype) → ExpertWeightKind ⇥ ExpertBankError {
    switch raw_dtype {
        case "Q8_0" {
            return variant ExpertWeightKind.GgmlBlockQ8_0
        }
        case "Q4_1" {
            return variant ExpertWeightKind.GgmlBlockQ4_1
        }
        case "Q5_0" {
            return variant ExpertWeightKind.GgmlBlockQ5_0
        }
        case "IQ4_NL" {
            return variant ExpertWeightKind.GgmlBlockIQ4_NL
        }
        case "Q4_K" {
            return variant ExpertWeightKind.GgmlBlockQ4_K
        }
        case "Q5_K" {
            return variant ExpertWeightKind.GgmlBlockQ5_K
        }
        case "Q6_K" {
            return variant ExpertWeightKind.GgmlBlockQ6_K
        }
        default {
            throw variant UnsupportedFormat { message = "unsupported GGML block dtype: §"(raw_dtype) }
        }
    }
}

fn ggml_block_elements(ExpertWeightKind kind) → int ⇥ ExpertBankError {
    match kind {
        case ExpertWeightKind.GgmlBlockQ8_0 {
            return 32
        }
        case ExpertWeightKind.GgmlBlockQ4_1 {
            return 32
        }
        case ExpertWeightKind.GgmlBlockQ5_0 {
            return 32
        }
        case ExpertWeightKind.GgmlBlockIQ4_NL {
            return 32
        }
        case ExpertWeightKind.GgmlBlockQ4_K {
            return 256
        }
        case ExpertWeightKind.GgmlBlockQ5_K {
            return 256
        }
        case ExpertWeightKind.GgmlBlockQ6_K {
            return 256
        }
        default {
            throw variant UnsupportedFormat { message = "not a GGML block kind" }
        }
    }
}

fn ggml_block_bytes(ExpertWeightKind kind) → int ⇥ ExpertBankError {
    match kind {
        case ExpertWeightKind.GgmlBlockQ8_0 {
            return 34
        }
        case ExpertWeightKind.GgmlBlockQ4_1 {
            return 20
        }
        case ExpertWeightKind.GgmlBlockQ5_0 {
            return 22
        }
        case ExpertWeightKind.GgmlBlockIQ4_NL {
            return 18
        }
        case ExpertWeightKind.GgmlBlockQ4_K {
            return 144
        }
        case ExpertWeightKind.GgmlBlockQ5_K {
            return 176
        }
        case ExpertWeightKind.GgmlBlockQ6_K {
            return 210
        }
        default {
            throw variant UnsupportedFormat { message = "not a GGML block kind" }
        }
    }
}

fn ggml_representation(ExpertWeightKind kind) → storage.Representation ⇥ ExpertBankError {
    match kind {
        case ExpertWeightKind.GgmlBlockQ8_0 {
            return storage.ggml_representation(8)
        }
        case ExpertWeightKind.GgmlBlockQ4_1 {
            return storage.ggml_representation(3)
        }
        case ExpertWeightKind.GgmlBlockQ5_0 {
            return storage.ggml_representation(6)
        }
        case ExpertWeightKind.GgmlBlockIQ4_NL {
            return storage.ggml_representation(20)
        }
        case ExpertWeightKind.GgmlBlockQ4_K {
            return storage.ggml_representation(12)
        }
        case ExpertWeightKind.GgmlBlockQ5_K {
            return storage.ggml_representation(13)
        }
        case ExpertWeightKind.GgmlBlockQ6_K {
            return storage.ggml_representation(14)
        }
        default {
            throw variant UnsupportedFormat { message = "not a GGML block kind" }
        }
    }
}

fn dense_kind_for(string raw_dtype) → ExpertWeightKind ⇥ ExpertBankError {
    switch raw_dtype {
        case "F32" {
            return variant ExpertWeightKind.DenseF32
        }
        case "BF16" {
            return variant ExpertWeightKind.DenseBf16
        }
        case "F16" {
            return variant ExpertWeightKind.DenseF16
        }
        default {
            throw variant UnsupportedFormat { message = "unsupported dense dtype: §"(raw_dtype) }
        }
    }
}

class BankedAffineGeom {
    let int group_size
    let int bits
}

fn affine_bits_valid(int bits, bool is_u8) → bool {
    if is_u8 {
        return bits ≡ 4 or bits ≡ 8
    }
    return bits ≡ 4 or bits ≡ 6 or bits ≡ 8
}

fn hint_allows_affine(ExpertQuantHint hint) → bool {
    if hint.mode is string {
        let string hm ← hint.mode coalesce ""
        return hm ≡ "affine" or hm ≡ "group_affine"
    }
    return true
}

fn resolve_banked_affine_geom(int bits_per_group, bool is_u8, ExpertQuantHint hint) → BankedAffineGeom ⇥ ExpertBankError {
    if hint_allows_affine(hint) {
        if hint.group_size is int and hint.bits is int {
            let int hg ← hint.group_size coalesce 0
            let int hb ← hint.bits coalesce 0
            if hg ≥ 1 and affine_bits_valid(hb, is_u8) and hg * hb ≡ bits_per_group {
                return BankedAffineGeom { group_size = hg, bits = hb }
            }
        }
        elif hint.group_size is int {
            let int hg ← hint.group_size coalesce 0
            if hg ≥ 1 and bits_per_group % hg ≡ 0 {
                let int b ← bits_per_group / hg
                if affine_bits_valid(b, is_u8) {
                    return BankedAffineGeom { group_size = hg, bits = b }
                }
            }
        }
        elif hint.bits is int {
            let int hb ← hint.bits coalesce 0
            if affine_bits_valid(hb, is_u8) and bits_per_group % hb ≡ 0 {
                return BankedAffineGeom { group_size = bits_per_group / hb, bits = hb }
            }
        }
    }

    let list<int> candidates ← [64, 32, 128, 16, 256, 8, 4]
    for from candidates let gs {
        if bits_per_group % gs ≡ 0 {
            let int b ← bits_per_group / gs
            if affine_bits_valid(b, is_u8) {
                return BankedAffineGeom { group_size = gs, bits = b }
            }
        }
    }

    throw variant BadShape { message = "unable to infer valid banked GroupAffine group_size and bits for bits_per_group=§"(bits_per_group ↦ string) }
}

fn bind_banked_group_affine(td.DirectoryEntry weight, td.DirectoryEntry scales, td.DirectoryEntry biases, ExpertQuantHint hint) → BankedMatrixSpec ⇥ ExpertBankError {
    let int expert_count ← weight.shape.get(0) coalesce 0
    let int out_features ← weight.shape.get(1) coalesce 0
    let int packed_cols ← weight.shape.get(2) coalesce 0

    require scales.shape.length() ≡ 3 and biases.shape.length() ≡ 3 throw variant BadShape { message = "banked scales and biases must be rank-3" }

    let int s_e ← scales.shape.get(0) coalesce 0
    let int s_rows ← scales.shape.get(1) coalesce 0
    let int group_cols ← scales.shape.get(2) coalesce 0
    let int b_e ← biases.shape.get(0) coalesce 0
    let int b_rows ← biases.shape.get(1) coalesce 0
    let int b_cols ← biases.shape.get(2) coalesce 0

    require s_e ≡ expert_count and b_e ≡ expert_count and s_rows ≡ out_features and b_rows ≡ out_features and b_cols ≡ group_cols and group_cols ≥ 1 throw variant BadShape { message = "banked scales/biases shape mismatch against weight" }
    require scales.raw_dtype ≡ biases.raw_dtype and (scales.raw_dtype ≡ "F32" or scales.raw_dtype ≡ "BF16" or scales.raw_dtype ≡ "F16") throw variant UnsupportedFormat { message = "banked scales/biases dtype must match and be F32, BF16, or F16, got §/§"(scales.raw_dtype, biases.raw_dtype) }

    mut int pack_width ← 32
    mut ga.PackKind ga_pack ← variant ga.PackKind.PackU32
    mut PackKind bank_pack ← variant PackKind.PackU32
    mut ExpertWeightKind kind ← variant ExpertWeightKind.GroupAffineU32
    mut bool is_u8 ← false

    if weight.raw_dtype ≡ "U32" {
        pack_width ← 32
        ga_pack ← variant ga.PackKind.PackU32
        bank_pack ← variant PackKind.PackU32
        kind ← variant ExpertWeightKind.GroupAffineU32
        is_u8 ← false
    }
    elif weight.raw_dtype ≡ "U8" {
        pack_width ← 8
        ga_pack ← variant ga.PackKind.PackU8
        bank_pack ← variant PackKind.PackU8
        kind ← variant ExpertWeightKind.GroupAffineU8
        is_u8 ← true
    }
    else {
        throw variant UnsupportedFormat { message = "GroupAffine banked weight dtype must be U32 or U8, got §"(weight.raw_dtype) }
    }

    let int total_bits ← packed_cols * pack_width
    require total_bits % group_cols ≡ 0 throw variant BadShape { message = "packed GroupAffine banked bit width not divisible by group_cols" }

    let int bits_per_group ← total_bits / group_cols
    let BankedAffineGeom geom ← resolve_banked_affine_geom(bits_per_group, is_u8, hint)
    let int in_features ← group_cols * geom.group_size
    mut ga.ScaleDtype sd ← variant ga.ScaleDtype.ScaleF32
    if scales.raw_dtype ≡ "BF16" {
        sd ← variant ga.ScaleDtype.ScaleBf16
    }
    elif scales.raw_dtype ≡ "F16" {
        sd ← variant ga.ScaleDtype.ScaleF16
    }
    let ga.GroupAffineSpec spec ← ga.admit_spec_with_scale(out_features, in_features, geom.bits, geom.group_size, ga_pack, sd)
    return BankedMatrixSpec { kind = kind, expert_count = expert_count, out_features = spec.out_features, in_features = spec.in_features, bits = spec.bits, group_size = spec.group_size, packed_cols = spec.packed_cols, group_cols = spec.group_cols, block_rows = 1, block_cols = spec.group_size, pack = bank_pack, scales_dtype = scales.raw_dtype }
}

fn validate_scalar_or_per_expert(td.DirectoryEntry entry, int expert_count, string label) → bool ⇥ ExpertBankError {
    if entry.shape.length() ≡ 0 {
        return false
    }
    if entry.shape.length() ≡ 1 {
        let int d0 ← entry.shape[0]
        require d0 ≡ 1 or d0 ≡ expert_count throw variant BadShape { message = "§ shape length § does not match scalar or expert_count §"(label, d0 ↦ string, expert_count ↦ string) }
        return d0 ≡ expert_count and expert_count ≻ 1
    }
    let int d0 ← entry.shape[0]
    require d0 ≡ 1 or d0 ≡ expert_count throw variant BadShape { message = "§ leading dim § does not match scalar or expert_count §"(label, d0 ↦ string, expert_count ↦ string) }
    for range 1 ‥ entry.shape.length() let idx {
        require entry.shape[idx] ≡ 1 throw variant BadShape { message = "§ trailing dimensions must be 1"(label) }
    }
    return d0 ≡ expert_count and expert_count ≻ 1
}

fn bind_banked_dual_scaled_fp4(td.DirectoryEntry weight, td.DirectoryEntry scales, td.DirectoryEntry ∪ none maybe_global, td.DirectoryEntry ∪ none maybe_amax, td.DirectoryEntry ∪ none maybe_denom, ExpertQuantHint hint) → BankedMatrixSpec ⇥ ExpertBankError {
    let int expert_count ← weight.shape.get(0) coalesce 0
    let int out_features ← weight.shape.get(1) coalesce 0
    let int packed_cols ← weight.shape.get(2) coalesce 0

    require scales.shape.length() ≡ 3 throw variant BadShape { message = "DualScaledFp4 scales must be rank-3" }
    require (scales.shape[0] ≡ expert_count) and (scales.shape[1] ≡ out_features) throw variant BadShape { message = "DualScaledFp4 scales expert/row mismatch" }

    mut bool has_modelopt_amax ← false
    if maybe_global is td.DirectoryEntry {
        validate_scalar_or_per_expert(maybe_global, expert_count, "DualScaledFp4 global_scale")
    }
    elif maybe_amax is td.DirectoryEntry and maybe_denom is td.DirectoryEntry {
        validate_scalar_or_per_expert(maybe_amax, expert_count, "ModelOpt DualScaledFp4 amax")
        validate_scalar_or_per_expert(maybe_denom, expert_count, "ModelOpt DualScaledFp4 outer_scale_denominator")
        has_modelopt_amax ← true
    }
    else {
        throw variant BadBinding { message = "DualScaledFp4 requires global_scale or ModelOpt amax + outer_scale_denominator" }
    }

    let int group_cols ← scales.shape.get(2) coalesce 0
    require group_cols ≥ 1 throw variant BadShape { message = "DualScaledFp4 group_cols must be positive" }

    mut PackKind bank_pack ← variant PackKind.PackU8
    mut fp4.PackKind fp4_pack ← variant fp4.PackKind.PackU8
    mut int in_features ← packed_cols * 2

    if weight.raw_dtype ≡ "U8" {
        bank_pack ← variant PackKind.PackU8
        fp4_pack ← variant fp4.PackKind.PackU8
        in_features ← packed_cols * 2
    }
    elif weight.raw_dtype ≡ "U32" {
        bank_pack ← variant PackKind.PackU32
        fp4_pack ← variant fp4.PackKind.PackU32
        in_features ← packed_cols * 8
    }
    else {
        throw variant UnsupportedFormat { message = "DualScaledFp4 weight dtype must be U8 or U32, got §"(weight.raw_dtype) }
    }

    require in_features % group_cols ≡ 0 throw variant BadShape { message = "DualScaledFp4 in_features not divisible by scale group_cols" }
    let int group_size ← in_features / group_cols
    let fp4.DualScaledFp4Spec spec ← fp4.admit_spec(out_features, in_features, group_size, fp4_pack)
    return BankedMatrixSpec { kind = variant ExpertWeightKind.DualScaledFp4, expert_count = expert_count, out_features = spec.out_features, in_features = spec.in_features, bits = 4, group_size = spec.group_size, packed_cols = spec.packed_cols, group_cols = spec.group_cols, block_rows = 1, block_cols = spec.group_size, pack = bank_pack, scales_dtype = scales.raw_dtype, has_modelopt_amax = has_modelopt_amax }
}

fn is_fp8_weight_dtype(string raw_dtype) → bool {
    return raw_dtype ≡ "F8_E4M3" or raw_dtype ≡ "FP8_E4M3" or raw_dtype ≡ "E4M3"
}

fn bind_banked_block_fp8(td.DirectoryEntry weight, td.DirectoryEntry ∪ none maybe_scales, ExpertQuantHint hint) → BankedMatrixSpec ⇥ ExpertBankError {
    let int expert_count ← weight.shape.get(0) coalesce 0
    let int out_features ← weight.shape.get(1) coalesce 0
    let int packed_cols ← weight.shape.get(2) coalesce 0

    mut PackKind bank_pack ← variant PackKind.PackU8
    mut bf8.PackKind bf8_pack ← variant bf8.PackKind.PackU8
    mut int in_features ← packed_cols

    if is_fp8_weight_dtype(weight.raw_dtype) or weight.raw_dtype ≡ "U8" {
        bank_pack ← variant PackKind.PackU8
        bf8_pack ← variant bf8.PackKind.PackU8
        in_features ← packed_cols
    }
    elif weight.raw_dtype ≡ "U32" {
        bank_pack ← variant PackKind.PackU32
        bf8_pack ← variant bf8.PackKind.PackU32
        in_features ← packed_cols * 4
    }
    else {
        throw variant UnsupportedFormat { message = "BlockFp8 weight dtype must be F8_E4M3, U8, or U32, got §"(weight.raw_dtype) }
    }

    if maybe_scales is td.DirectoryEntry {
        require maybe_scales.shape.length() ≡ 3 throw variant BadShape { message = "BlockFp8 banked scales must be rank-3" }
        require maybe_scales.shape[0] ≡ expert_count throw variant BadShape { message = "BlockFp8 scales expert_count mismatch" }
        require maybe_scales.raw_dtype ≡ "U8" or maybe_scales.raw_dtype ≡ "F32" throw variant UnsupportedFormat { message = "BlockFp8 scales dtype must be U8 or F32, got §"(maybe_scales.raw_dtype) }

        let int scale_rows ← maybe_scales.shape[1]
        let int scale_cols ← maybe_scales.shape[2]
        require scale_rows ≥ 1 and scale_cols ≥ 1 throw variant BadShape { message = "BlockFp8 scales must have positive extents" }
        require out_features % scale_rows ≡ 0 throw variant BadShape { message = "BlockFp8 out_features not divisible by scale_rows" }
        require in_features % scale_cols ≡ 0 throw variant BadShape { message = "BlockFp8 in_features not divisible by scale_cols" }

        let int block_rows ← out_features / scale_rows
        let int block_cols ← in_features / scale_cols
        let bf8.BlockFp8Spec spec ← bf8.admit_spec(out_features, in_features, block_rows, block_cols, bf8_pack)
        return BankedMatrixSpec { kind = variant ExpertWeightKind.BlockFp8, expert_count = expert_count, out_features = spec.out_features, in_features = spec.in_features, bits = 8, group_size = spec.block_cols, packed_cols = spec.packed_cols, group_cols = spec.scale_cols, block_rows = spec.block_rows, block_cols = spec.block_cols, pack = bank_pack, scales_dtype = maybe_scales.raw_dtype }
    }

    require is_fp8_weight_dtype(weight.raw_dtype) throw variant BadBinding { message = "BlockFp8 U8/U32 storage requires a scales tensor" }
    let bf8.BlockFp8Spec spec ← bf8.admit_spec(out_features, in_features, out_features, in_features, bf8_pack)
    return BankedMatrixSpec { kind = variant ExpertWeightKind.BlockFp8, expert_count = expert_count, out_features = spec.out_features, in_features = spec.in_features, bits = 8, group_size = spec.block_cols, packed_cols = spec.packed_cols, group_cols = spec.scale_cols, block_rows = spec.block_rows, block_cols = spec.block_cols, pack = bank_pack, scales_dtype = "NONE" }
}

fn resolve_banked_scales_sibling(td.TensorDirectory dir, bundle.MemberRole role, string module_prefix, td.DirectoryEntry ∪ none sib_scales) → td.DirectoryEntry ∪ none ⇥ ExpertBankError {
    if sib_scales is td.DirectoryEntry {
        return sib_scales
    }
    if td.has_tensor(dir, role, "§.weight_scale_inv"(module_prefix)) {
        return td.lookup(dir, role, "§.weight_scale_inv"(module_prefix))
    }
    return null
}

@ public
fn bind_matrix_with_config(td.TensorDirectory dir, bundle.MemberRole role, string module_prefix, ExpertQuantHint hint) → BankedMatrixSpec ⇥ ExpertBankError {
    let td.SiblingSet sib ← td.siblings(dir, role, module_prefix)
    let td.DirectoryEntry weight ← sib.weight

    require weight.shape.length() ≡ 3 throw variant BadShape { message = "banked expert weight must be rank-3" }

    let int dim0 ← weight.shape.get(0) coalesce 0
    let int dim1 ← weight.shape.get(1) coalesce 0
    let int dim2 ← weight.shape.get(2) coalesce 0
    require dim0 ≥ 1 and dim1 ≥ 1 and dim2 ≥ 1 throw variant BadShape { message = "banked expert weight must have positive extents" }

    let td.DirectoryEntry ∪ none maybe_scales ← resolve_banked_scales_sibling(dir, role, module_prefix, sib.scales)
    let td.DirectoryEntry ∪ none maybe_biases ← sib.biases
    let td.DirectoryEntry ∪ none maybe_global ← sib.global_scale
    let td.DirectoryEntry ∪ none maybe_amax ← sib.amax
    let td.DirectoryEntry ∪ none maybe_denom ← sib.outer_scale_denominator

    # 1. DualScaledFp4: .weight + .scales + (.global_scale | .amax + .outer_scale_denominator)
    if maybe_scales is td.DirectoryEntry and (maybe_global is td.DirectoryEntry or (maybe_amax is td.DirectoryEntry and maybe_denom is td.DirectoryEntry)) {
        return bind_banked_dual_scaled_fp4(weight, maybe_scales, maybe_global, maybe_amax, maybe_denom, hint)
    }

    # 2. GroupAffine: .weight + .scales + .biases
    if maybe_scales is td.DirectoryEntry and maybe_biases is td.DirectoryEntry {
        return bind_banked_group_affine(weight, maybe_scales, maybe_biases, hint)
    }

    # 3. BlockFp8: F8_E4M3 / FP8_E4M3 / E4M3 or U8 / U32 with scales-only sibling
    if is_fp8_weight_dtype(weight.raw_dtype) or ((weight.raw_dtype ≡ "U8" or weight.raw_dtype ≡ "U32") and maybe_scales is td.DirectoryEntry) {
        return bind_banked_block_fp8(weight, maybe_scales, hint)
    }

    # GGUF stores 3D banked weights in ne order [ne0 = in_features, ne1 = out_features, ne2 = expert_count],
    # whereas Safetensors stores [expert_count, out_features, in_features].
    mut int expert_count ← dim0
    mut int out_features ← dim1
    mut int in_features ← dim2
    match weight.container {
        case bundle.ContainerKind.Gguf {
            in_features ← dim0
            out_features ← dim1
            expert_count ← dim2
        }
        case bundle.ContainerKind.Safetensors {}
    }

    # 4. GgmlBlock: single GGML block tensor
    if is_ggml_block_dtype(weight.raw_dtype) {
        let ExpertWeightKind kind ← ggml_kind_for(weight.raw_dtype)
        let int block_elems ← ggml_block_elements(kind)
        require in_features % block_elems ≡ 0 throw variant BadShape { message = "GGML banked weight in_features must be divisible by block element count" }
        return BankedMatrixSpec { kind = kind, expert_count = expert_count, out_features = out_features, in_features = in_features, bits = 0, group_size = 0, packed_cols = 0, group_cols = 0, block_rows = 1, block_cols = block_elems, pack = variant PackKind.PackU8 }
    }

    # 5. Dense: F32 / BF16 / F16
    let ExpertWeightKind kind ← dense_kind_for(weight.raw_dtype)
    return BankedMatrixSpec { kind = kind, expert_count = expert_count, out_features = out_features, in_features = in_features, bits = 0, group_size = 0, packed_cols = 0, group_cols = 0, pack = variant PackKind.PackDense }
}

@ public
fn bind_split(td.TensorDirectory dir, bundle.MemberRole role, string gate_prefix, string up_prefix, string down_prefix, ExpertQuantHint hint, bool has_router_bias, int shared_expert_count) → ExpertBank ⇥ ExpertBankError {
    let BankedMatrixSpec gate ← bind_matrix_with_config(dir, role, gate_prefix, hint)
    let BankedMatrixSpec up ← bind_matrix_with_config(dir, role, up_prefix, hint)
    let BankedMatrixSpec down ← bind_matrix_with_config(dir, role, down_prefix, hint)

    require gate.expert_count ≡ up.expert_count and gate.expert_count ≡ down.expert_count throw variant BadShape { message = "gate/up/down expert_count mismatch" }
    require gate.out_features ≡ up.out_features throw variant BadShape { message = "gate/up intermediate_size mismatch" }
    require gate.in_features ≡ up.in_features and gate.in_features ≡ down.out_features throw variant BadShape { message = "gate/up/down hidden_size mismatch" }
    require down.in_features ≡ gate.out_features throw variant BadShape { message = "down in_features must match intermediate_size" }
    require shared_expert_count ≥ 0 throw variant BadConfig { message = "shared_expert_count must be non-negative" }

    return ExpertBank { expert_count = gate.expert_count, hidden_size = gate.in_features, intermediate_size = gate.out_features, layout = variant ExpertBankLayout.SplitGateUp { gate = gate, up = up, down = down }, has_router_bias = has_router_bias, shared_expert_count = shared_expert_count }
}

@ public
fn bind_fused(td.TensorDirectory dir, bundle.MemberRole role, string gate_up_prefix, string down_prefix, ExpertQuantHint hint, bool has_router_bias, int shared_expert_count) → ExpertBank ⇥ ExpertBankError {
    let td.SiblingSet gu_sib ← td.siblings(dir, role, gate_up_prefix)
    let td.DirectoryEntry gate_up_entry ← gu_sib.weight
    let BankedMatrixSpec gate_up ← bind_matrix_with_config(dir, role, gate_up_prefix, hint)
    let BankedMatrixSpec down ← bind_matrix_with_config(dir, role, down_prefix, hint)

    require gate_up.expert_count ≡ down.expert_count throw variant BadShape { message = "gate_up/down expert_count mismatch" }
    require gate_up.in_features ≡ down.out_features throw variant BadShape { message = "gate_up/down hidden_size mismatch" }
    require shared_expert_count ≥ 0 throw variant BadConfig { message = "shared_expert_count must be non-negative" }

    mut int gate_rows ← 0
    mut int up_rows ← 0

    match gate_up_entry.view {
        case FusedGateUpSplit let g_rows, u_rows, ? {
            require g_rows + u_rows ≡ gate_up.out_features throw variant BadShape { message = "FusedGateUpSplit rows do not sum to gate_up out_features" }
            gate_rows ← g_rows
            up_rows ← u_rows
        }
        default {
            require gate_up.out_features % 2 ≡ 0 throw variant BadShape { message = "fused gate_up out_features must be even" }
            gate_rows ← gate_up.out_features / 2
            up_rows ← gate_up.out_features / 2
        }
    }

    require gate_rows ≡ up_rows and down.in_features ≡ gate_rows throw variant BadShape { message = "fused gate_up split must match down in_features" }

    return ExpertBank { expert_count = gate_up.expert_count, hidden_size = gate_up.in_features, intermediate_size = gate_rows, layout = variant ExpertBankLayout.FusedGateUp { gate_up = gate_up, gate_rows = gate_rows, up_rows = up_rows, down = down }, has_router_bias = has_router_bias, shared_expert_count = shared_expert_count }
}

@ public
fn bind_auto(td.TensorDirectory dir, bundle.MemberRole role, string moe_prefix, ExpertQuantHint hint, int shared_expert_count) → ExpertBank ⇥ ExpertBankError {
    let bool has_bias ← td.has_tensor(dir, role, "§.gate.e_score_correction_bias"(moe_prefix)) or td.has_tensor(dir, role, "§.router.e_score_correction_bias"(moe_prefix)) or td.has_tensor(dir, role, "§.ffn_gate_inp.bias"(moe_prefix))

    let string split_gate ← "§.gate_proj"(moe_prefix)
    let string split_up ← "§.up_proj"(moe_prefix)
    let string down ← "§.down_proj"(moe_prefix)

    if td.has_tensor(dir, role, "§.weight"(split_gate)) and td.has_tensor(dir, role, "§.weight"(split_up)) {
        return bind_split(dir, role, split_gate, split_up, down, hint, has_bias, shared_expert_count)
    }

    let string gguf_gate ← "§.ffn_gate_exps"(moe_prefix)
    let string gguf_up ← "§.ffn_up_exps"(moe_prefix)
    let string gguf_down ← "§.ffn_down_exps"(moe_prefix)
    if td.has_tensor(dir, role, "§.weight"(gguf_gate)) and td.has_tensor(dir, role, "§.weight"(gguf_up)) {
        return bind_split(dir, role, gguf_gate, gguf_up, gguf_down, hint, has_bias, shared_expert_count)
    }

    let string fused_gu ← "§.gate_up_proj"(moe_prefix)
    if td.has_tensor(dir, role, "§.weight"(fused_gu)) or td.has_tensor(dir, role, "§.w13_weight"(moe_prefix)) or td.has_tensor(dir, role, "§.w13.weight"(moe_prefix)) {
        return bind_fused(dir, role, fused_gu, down, hint, has_bias, shared_expert_count)
    }

    let string gguf_gu ← "§.ffn_gate_up_exps"(moe_prefix)
    if td.has_tensor(dir, role, "§.weight"(gguf_gu)) {
        return bind_fused(dir, role, gguf_gu, gguf_down, hint, has_bias, shared_expert_count)
    }

    throw variant BadBinding { message = "no split gate_proj/up_proj, raw HF w13_weight, GGUF ffn_*_exps, or fused gate_up_proj found under §"(moe_prefix) }
}

@ public
fn bind_auto_with_activation(td.TensorDirectory dir, bundle.MemberRole role, string moe_prefix, ExpertQuantHint hint, int shared_expert_count, ExpertActivation act) → ExpertBank ⇥ ExpertBankError {
    let ExpertBank base ← bind_auto(dir, role, moe_prefix, hint, shared_expert_count)
    return with_activation(base, act)
}

# -------------------------------------------------------------------------
# Routing + Shared-Expert Variants (Zero NumericBlock)
# -------------------------------------------------------------------------

@ public
union RouterGating {
    Sigmoid,
    Softmax
}

@ public
class RouterConfig {
    let RouterGating gating
    let int expert_count
    let int top_k
    let bool norm_topk_prob
    let f32 route_scale
    let int shared_expert_count
    let bool use_correction_bias
}

@ public
fn inkling_router_config() → RouterConfig {
    return RouterConfig { gating = variant RouterGating.Sigmoid, expert_count = 128, top_k = 8, norm_topk_prob = true, route_scale = 8.0 ∷ f32, shared_expert_count = 0, use_correction_bias = true }
}

@ public
fn flint_router_config() → RouterConfig {
    return RouterConfig { gating = variant RouterGating.Sigmoid, expert_count = 256, top_k = 6, norm_topk_prob = true, route_scale = 1.0 ∷ f32, shared_expert_count = 2, use_correction_bias = false }
}

@ public
fn qwen36_router_config() → RouterConfig {
    return RouterConfig { gating = variant RouterGating.Softmax, expert_count = 256, top_k = 8, norm_topk_prob = true, route_scale = 1.0 ∷ f32, shared_expert_count = 1, use_correction_bias = false }
}

@ public
class RouteSelection {
    let list<int> indices
    let list<f32> weights
    let list<f32> scores
}

fn validate_router_config(RouterConfig cfg) → void ⇥ ExpertBankError {
    require cfg.expert_count ≥ 1 throw variant BadConfig { message = "expert_count must be at least 1" }
    require cfg.top_k ≥ 1 and cfg.top_k ≤ cfg.expert_count throw variant BadConfig { message = "top_k must be in 1..expert_count" }
    require cfg.shared_expert_count ≥ 0 throw variant BadConfig { message = "shared_expert_count must be non-negative" }
    require dtype.finite(cfg.route_scale) and cfg.route_scale ≻ 0.0 throw variant BadConfig { message = "route_scale must be finite and positive" }
}

fn compute_softmax(list<f32> logits) → list<f32> ⇥ ExpertBankError {
    mut f32 max_val ← logits[0]
    for range 1 ‥ logits.length() let i {
        if logits[i] ≻ max_val {
            max_val ← logits[i]
        }
    }

    mut list<f32> exps ← empty
    mut f32 total ← 0.0 ∷ f32
    for from logits let v {
        let f32 e ← (v - max_val).exp()
        require dtype.finite(e) throw variant NonFinite { message = "softmax produced non-finite exponent" }
        exps.append(e)
        total ← total + e
    }

    require dtype.finite(total) and total ≻ 0.0 throw variant NonFinite { message = "softmax normalizer is non-finite or zero" }

    mut list<f32> probs ← empty
    for from exps let e {
        probs.append(e / total)
    }
    return probs
}

fn compute_sigmoid(list<f32> logits) → list<f32> ⇥ ExpertBankError {
    mut list<f32> scores ← empty
    for from logits let v {
        let f32 s ← sigmoid v
        require dtype.finite(s) throw variant NonFinite { message = "sigmoid gating produced non-finite score" }
        scores.append(s)
    }
    return scores
}

fn best_unselected_index(list<f32> scores, list<int> selected) → int {
    mut int best ← -1
    for exclusive scores.length() let i {
        if i ∉ selected {
            if best ≺ 0 {
                best ← i
            }
            else {
                let f32 cand ← scores[i]
                let f32 inc ← scores[best]
                if cand ≻ inc or (cand ≡ inc and i ≺ best) {
                    best ← i
                }
            }
        }
    }
    return best
}

fn sort_ascending_experts(mut list<int> indices, mut list<f32> weights) → void {
    let int n ← indices.length()
    for range 1 ‥ n let i {
        let int key_idx ← indices[i]
        let f32 key_w ← weights[i]
        mut int j ← i - 1
        while j ≥ 0 and indices[j] ≻ key_idx {
            indices[j + 1] ← indices[j]
            weights[j + 1] ← weights[j]
            j ← j - 1
        }
        indices[j + 1] ← key_idx
        weights[j + 1] ← key_w
    }
}

@ public
fn route_token(RouterConfig cfg, list<f32> logits, list<f32> correction_bias) → RouteSelection ⇥ ExpertBankError {
    validate_router_config(cfg)
    require logits.length() ≡ cfg.expert_count throw variant BadShape { message = "router logits length must match expert_count" }

    for from logits let v {
        require dtype.finite(v) throw variant NonFinite { message = "router logits contain non-finite value" }
    }

    if cfg.use_correction_bias {
        require correction_bias.length() ≡ cfg.expert_count throw variant BadShape { message = "e_score_correction_bias length must match expert_count" }
        for from correction_bias let b {
            require dtype.finite(b) throw variant NonFinite { message = "e_score_correction_bias contains non-finite value" }
        }
    }

    mut list<f32> scores ← empty
    match cfg.gating {
        case Sigmoid {
            scores ← compute_sigmoid(logits)
        }
        case Softmax {
            scores ← compute_softmax(logits)
        }
    }

    mut list<f32> sel_scores ← empty
    if cfg.use_correction_bias {
        for exclusive cfg.expert_count let i {
            sel_scores.append(scores[i] + correction_bias[i])
        }
    }
    else {
        for from scores let s {
            sel_scores.append(s)
        }
    }

    mut list<int> indices ← empty
    mut list<f32> raw_weights ← empty
    mut f32 selected_sum ← 0.0 ∷ f32

    for exclusive cfg.top_k {
        let int idx ← best_unselected_index(sel_scores, indices)
        require idx ≥ 0 throw variant BadConfig { message = "router top-k selection failed" }
        let f32 w ← scores[idx]
        indices.append(idx)
        raw_weights.append(w)
        selected_sum ← selected_sum + w
    }

    mut list<f32> weights ← empty
    if cfg.norm_topk_prob {
        require dtype.finite(selected_sum) and selected_sum ≻ 0.0 throw variant NonFinite { message = "selected router weights sum must be positive and finite" }
        for from raw_weights let w {
            weights.append((w / selected_sum) * cfg.route_scale)
        }
    }
    else {
        for from raw_weights let w {
            weights.append(w * cfg.route_scale)
        }
    }

    sort_ascending_experts(mut indices, mut weights)
    return RouteSelection { indices = indices, weights = weights, scores = scores }
}

@ public
fn route_batch(RouterConfig cfg, int batch_size, list<f32> logits_flat, list<f32> correction_bias) → list<RouteSelection> ⇥ ExpertBankError {
    require batch_size ≥ 1 throw variant BadShape { message = "batch_size must be at least 1" }
    require logits_flat.length() ≡ batch_size * cfg.expert_count throw variant BadShape { message = "batched router logits length mismatch" }

    mut list<RouteSelection> out ← empty
    for exclusive batch_size let b {
        let int start ← b * cfg.expert_count
        mut list<f32> row ← empty
        for exclusive cfg.expert_count let e {
            row.append(logits_flat[start + e])
        }
        out.append(route_token(cfg, row, correction_bias))
    }
    return out
}

# -------------------------------------------------------------------------
# Reference Decode / Eval (B=1 and B=C, Zero NumericBlock)
# -------------------------------------------------------------------------

@ public
union BankedPayload {
    DenseBankPayload {
        list<f32> weight
    },
    GroupAffineU32BankPayload {
        list<u32> weight
        list<f32> scales
        list<f32> biases
    },
    GroupAffineU8BankPayload {
        list<u8> weight
        list<f32> scales
        list<f32> biases
    },
    GroupAffineU32Bf16BankPayload {
        list<u32> weight
        list<bf16> scales
        list<bf16> biases
    },
    GroupAffineU8Bf16BankPayload {
        list<u8> weight
        list<bf16> scales
        list<bf16> biases
    },
    GroupAffineU32F16BankPayload {
        list<u32> weight
        list<f16> scales
        list<f16> biases
    },
    GroupAffineU8F16BankPayload {
        list<u8> weight
        list<f16> scales
        list<f16> biases
    },
    BlockFp8U8BankPayload {
        list<u8> weight
        list<u8> scales
        list<f32> f32_scales
    },
    BlockFp8U32BankPayload {
        list<u32> weight
        list<u8> scales
        list<f32> f32_scales
    },
    DualScaledFp4U8BankPayload {
        list<u8> weight
        list<u8> scales
        list<f32> expert_global_scales
    },
    DualScaledFp4U32BankPayload {
        list<u32> weight
        list<u8> scales
        list<f32> expert_global_scales
    },
    GgmlBlockBankPayload {
        list<u8> raw_blocks
    }
}

@ public
class SharedExpertPayload {
    let BankedMatrixSpec gate_spec
    let BankedPayload gate_payload
    let BankedMatrixSpec up_spec
    let BankedPayload up_payload
    let BankedMatrixSpec down_spec
    let BankedPayload down_payload
    let list<f32> gate_scalar_weight
}

fn unpack_u32_at(list<u32> weight, int w_base, int j, int bits) → int {
    let int bit_pos ← j * bits
    let int word_idx ← bit_pos / 32
    let int shift ← bit_pos % 32
    let int w0 ← weight[w_base + word_idx] ↦ int

    if bits ≡ 8 {
        return (w0 ⇒ shift) % 256
    }

    if bits ≡ 4 {
        return (w0 ⇒ shift) % 16
    }

    if shift ≤ 26 {
        return (w0 ⇒ shift) % 64
    }

    let int w1 ← weight[w_base + word_idx + 1] ↦ int
    let int lo ← w0 ⇒ shift
    let int hi ← w1 ⇐ (32 - shift)
    return (lo ∨ hi) % 64
}

fn unpack_u8_at(list<u8> weight, int w_base, int j, int bits) → int {
    if bits ≡ 8 {
        return weight[w_base + j] ↦ int
    }

    let int b ← weight[w_base + j / 2] ↦ int
    let int shift ← (j % 2) * 4
    return (b ⇒ shift) % 16
}

fn float_list_to_f32<float F>(list<F> items) → list<f32> {
    mut list<f32> out ← empty
    for from items let v {
        out.append(v ↦ f32)
    }
    return out
}

fn eval_ga_u32_slice(BankedMatrixSpec spec, list<u32> weight, list<f32> scales, list<f32> biases, int expert_idx, int row_offset, int row_count, list<f32> x) → list<f32> ⇥ ExpertBankError {
    match spec.kind {
        case GroupAffineU32 {}
        default {
            throw variant BadBinding { message = "BankedMatrixSpec kind does not match GroupAffineU32" }
        }
    }
    require weight.length() ≡ spec.expert_count * spec.out_features * spec.packed_cols throw variant BadShape { message = "u32 banked weight length mismatch" }
    require scales.length() ≡ spec.expert_count * spec.out_features * spec.group_cols throw variant BadShape { message = "u32 banked scales length mismatch" }
    require biases.length() ≡ spec.expert_count * spec.out_features * spec.group_cols throw variant BadShape { message = "u32 banked biases length mismatch" }

    mut list<f32> y ← empty
    let int e_w_base ← expert_idx * spec.out_features * spec.packed_cols
    let int e_g_base ← expert_idx * spec.out_features * spec.group_cols
    for exclusive row_count let rr {
        let int r ← row_offset + rr
        let int w_base ← e_w_base + r * spec.packed_cols
        let int g_base ← e_g_base + r * spec.group_cols
        mut f32 acc ← 0.0 ∷ f32
        for exclusive spec.in_features let j {
            let int q ← unpack_u32_at(weight, w_base, j, spec.bits)
            let int g ← j / spec.group_size
            let f32 w ← (q ↦ f32) * scales[g_base + g] + biases[g_base + g]
            acc ← acc + w * x[j]
        }
        y.append(acc)
    }
    return y
}

fn eval_ga_u8_slice(BankedMatrixSpec spec, list<u8> weight, list<f32> scales, list<f32> biases, int expert_idx, int row_offset, int row_count, list<f32> x) → list<f32> ⇥ ExpertBankError {
    match spec.kind {
        case GroupAffineU8 {}
        default {
            throw variant BadBinding { message = "BankedMatrixSpec kind does not match GroupAffineU8" }
        }
    }
    require weight.length() ≡ spec.expert_count * spec.out_features * spec.packed_cols throw variant BadShape { message = "u8 banked weight length mismatch" }
    require scales.length() ≡ spec.expert_count * spec.out_features * spec.group_cols throw variant BadShape { message = "u8 banked scales length mismatch" }
    require biases.length() ≡ spec.expert_count * spec.out_features * spec.group_cols throw variant BadShape { message = "u8 banked biases length mismatch" }

    mut list<f32> y ← empty
    let int e_w_base ← expert_idx * spec.out_features * spec.packed_cols
    let int e_g_base ← expert_idx * spec.out_features * spec.group_cols
    for exclusive row_count let rr {
        let int r ← row_offset + rr
        let int w_base ← e_w_base + r * spec.packed_cols
        let int g_base ← e_g_base + r * spec.group_cols
        mut f32 acc ← 0.0 ∷ f32
        for exclusive spec.in_features let j {
            let int q ← unpack_u8_at(weight, w_base, j, spec.bits)
            let int g ← j / spec.group_size
            let f32 w ← (q ↦ f32) * scales[g_base + g] + biases[g_base + g]
            acc ← acc + w * x[j]
        }
        y.append(acc)
    }
    return y
}

fn effective_block_rows(BankedMatrixSpec spec) → int {
    return (spec.block_rows ≥ 1) ✓ spec.block_rows ✗ 1
}

fn effective_block_cols(BankedMatrixSpec spec) → int {
    if spec.block_cols ≥ 1 {
        return spec.block_cols
    }
    return (spec.group_size ≥ 1) ✓ spec.group_size ✗ spec.in_features
}

fn resolve_expert_global_scale(list<f32> gs_list, int expert_count, int expert_idx) → f32 ⇥ ExpertBankError {
    require gs_list.length() ≡ 1 or gs_list.length() ≡ expert_count throw variant BadShape { message = "DualScaledFp4 expert_global_scales length mismatch" }
    return (gs_list.length() ≡ 1) ✓ gs_list[0] ✗ gs_list[expert_idx]
}

fn slice_u8_rows(list<u8> src, int expert_idx, int total_rows, int cols, int row_offset, int row_count) → list<u8> {
    mut list<u8> out ← empty
    let int base ← (expert_idx * total_rows + row_offset) * cols
    let int count ← row_count * cols
    for exclusive count let i {
        out.append(src[base + i])
    }
    return out
}

fn slice_u32_rows(list<u32> src, int expert_idx, int total_rows, int cols, int row_offset, int row_count) → list<u32> {
    mut list<u32> out ← empty
    let int base ← (expert_idx * total_rows + row_offset) * cols
    let int count ← row_count * cols
    for exclusive count let i {
        out.append(src[base + i])
    }
    return out
}

fn slice_f32_rows(list<f32> src, int expert_idx, int total_rows, int cols, int row_offset, int row_count) → list<f32> {
    mut list<f32> out ← empty
    let int base ← (expert_idx * total_rows + row_offset) * cols
    let int count ← row_count * cols
    for exclusive count let i {
        out.append(src[base + i])
    }
    return out
}

@ public
fn ref_expert_matvec_slice(BankedMatrixSpec spec, BankedPayload payload, int expert_idx, int row_offset, int row_count, list<f32> x) → list<f32> ⇥ ExpertBankError {
    require expert_idx ≥ 0 and expert_idx ≺ spec.expert_count throw variant BadShape { message = "expert_idx out of bounds" }
    require row_offset ≥ 0 and row_count ≥ 1 and row_offset + row_count ≤ spec.out_features throw variant BadShape { message = "row slice out of bounds" }
    require x.length() ≡ spec.in_features throw variant BadShape { message = "input vector length mismatch" }

    mut list<f32> y ← empty

    match payload {
        case DenseBankPayload let weight {
            match spec.kind {
                case DenseF32 {}
                case DenseBf16 {}
                case DenseF16 {}
                default {
                    throw variant BadBinding { message = "BankedMatrixSpec kind does not match DenseBankPayload" }
                }
            }
            require weight.length() ≡ spec.expert_count * spec.out_features * spec.in_features throw variant BadShape { message = "dense banked weight length mismatch" }

            let int e_base ← expert_idx * spec.out_features * spec.in_features
            for exclusive row_count let rr {
                let int r ← row_offset + rr
                let int w_base ← e_base + r * spec.in_features
                mut f32 acc ← 0.0 ∷ f32
                for exclusive spec.in_features let j {
                    acc ← acc + weight[w_base + j] * x[j]
                }
                y.append(acc)
            }
        }
        case GroupAffineU32BankPayload let weight, scales, biases {
            return eval_ga_u32_slice(spec, weight, scales, biases, expert_idx, row_offset, row_count, x)
        }
        case GroupAffineU8BankPayload let weight, scales, biases {
            return eval_ga_u8_slice(spec, weight, scales, biases, expert_idx, row_offset, row_count, x)
        }
        case GroupAffineU32Bf16BankPayload let weight, scales, biases {
            return eval_ga_u32_slice(spec, weight, float_list_to_f32<bf16>(scales), float_list_to_f32<bf16>(biases), expert_idx, row_offset, row_count, x)
        }
        case GroupAffineU8Bf16BankPayload let weight, scales, biases {
            return eval_ga_u8_slice(spec, weight, float_list_to_f32<bf16>(scales), float_list_to_f32<bf16>(biases), expert_idx, row_offset, row_count, x)
        }
        case GroupAffineU32F16BankPayload let weight, scales, biases {
            return eval_ga_u32_slice(spec, weight, float_list_to_f32<f16>(scales), float_list_to_f32<f16>(biases), expert_idx, row_offset, row_count, x)
        }
        case GroupAffineU8F16BankPayload let weight, scales, biases {
            return eval_ga_u8_slice(spec, weight, float_list_to_f32<f16>(scales), float_list_to_f32<f16>(biases), expert_idx, row_offset, row_count, x)
        }
        case BlockFp8U8BankPayload let weight, scales, f32_scales {
            match spec.kind {
                case BlockFp8 {}
                default {
                    throw variant BadBinding { message = "BankedMatrixSpec kind does not match BlockFp8U8BankPayload" }
                }
            }
            let int br ← effective_block_rows(spec)
            let int bc ← effective_block_cols(spec)
            let int scale_rows ← spec.out_features / br
            let int scale_cols ← spec.group_cols ≥ 1 ✓ spec.group_cols ✗ (spec.in_features / bc)
            require weight.length() ≡ spec.expert_count * spec.out_features * spec.in_features throw variant BadShape { message = "BlockFp8 U8 banked weight length mismatch" }
            let list<u8> w_slice ← slice_u8_rows(weight, expert_idx, spec.out_features, spec.in_features, row_offset, row_count)
            mut list<f32> w_dense ← empty
            if spec.scales_dtype ≡ "NONE" {
                w_dense ← bf8.ref_dequantize_u8_unscaled(row_count, spec.in_features, w_slice)
            }
            else {
                require row_offset % br ≡ 0 and row_count % br ≡ 0 throw variant BadShape { message = "BlockFp8 slice must align with block_rows" }
                let int sr_off ← row_offset / br
                let int sr_cnt ← row_count / br
                let bf8.BlockFp8Spec bspec ← bf8.admit_spec(row_count, spec.in_features, br, bc, variant bf8.PackKind.PackU8)
                if spec.scales_dtype ≡ "F32" {
                    require f32_scales.length() ≡ spec.expert_count * scale_rows * scale_cols throw variant BadShape { message = "BlockFp8 F32 scales length mismatch" }
                    let list<f32> s_slice ← slice_f32_rows(f32_scales, expert_idx, scale_rows, scale_cols, sr_off, sr_cnt)
                    w_dense ← bf8.ref_dequantize_u8_f32(bspec, w_slice, s_slice)
                }
                else {
                    require scales.length() ≡ spec.expert_count * scale_rows * scale_cols throw variant BadShape { message = "BlockFp8 U8 scales length mismatch" }
                    let list<u8> s_slice ← slice_u8_rows(scales, expert_idx, scale_rows, scale_cols, sr_off, sr_cnt)
                    w_dense ← bf8.ref_dequantize_u8(bspec, w_slice, s_slice)
                }
            }
            return bf8.ref_matvec(row_count, spec.in_features, w_dense, x)
        }
        case BlockFp8U32BankPayload let weight, scales, f32_scales {
            match spec.kind {
                case BlockFp8 {}
                default {
                    throw variant BadBinding { message = "BankedMatrixSpec kind does not match BlockFp8U32BankPayload" }
                }
            }
            let int br ← effective_block_rows(spec)
            let int bc ← effective_block_cols(spec)
            let int scale_rows ← spec.out_features / br
            let int scale_cols ← spec.group_cols ≥ 1 ✓ spec.group_cols ✗ (spec.in_features / bc)
            let int packed_cols ← spec.packed_cols ≥ 1 ✓ spec.packed_cols ✗ (spec.in_features / 4)
            require weight.length() ≡ spec.expert_count * spec.out_features * packed_cols throw variant BadShape { message = "BlockFp8 U32 banked weight length mismatch" }
            require row_offset % br ≡ 0 and row_count % br ≡ 0 throw variant BadShape { message = "BlockFp8 slice must align with block_rows" }
            let int sr_off ← row_offset / br
            let int sr_cnt ← row_count / br
            let list<u32> w_slice ← slice_u32_rows(weight, expert_idx, spec.out_features, packed_cols, row_offset, row_count)
            let bf8.BlockFp8Spec bspec ← bf8.admit_spec(row_count, spec.in_features, br, bc, variant bf8.PackKind.PackU32)
            mut list<f32> w_dense ← empty
            if spec.scales_dtype ≡ "F32" {
                require f32_scales.length() ≡ spec.expert_count * scale_rows * scale_cols throw variant BadShape { message = "BlockFp8 F32 scales length mismatch" }
                let list<f32> s_slice ← slice_f32_rows(f32_scales, expert_idx, scale_rows, scale_cols, sr_off, sr_cnt)
                w_dense ← bf8.ref_dequantize_u32_f32(bspec, w_slice, s_slice)
            }
            else {
                require scales.length() ≡ spec.expert_count * scale_rows * scale_cols throw variant BadShape { message = "BlockFp8 U8 scales length mismatch" }
                let list<u8> s_slice ← slice_u8_rows(scales, expert_idx, scale_rows, scale_cols, sr_off, sr_cnt)
                w_dense ← bf8.ref_dequantize_u32(bspec, w_slice, s_slice)
            }
            return bf8.ref_matvec(row_count, spec.in_features, w_dense, x)
        }
        case DualScaledFp4U8BankPayload let weight, scales, expert_global_scales {
            match spec.kind {
                case DualScaledFp4 {}
                default {
                    throw variant BadBinding { message = "BankedMatrixSpec kind does not match DualScaledFp4U8BankPayload" }
                }
            }
            require weight.length() ≡ spec.expert_count * spec.out_features * spec.packed_cols throw variant BadShape { message = "DualScaledFp4 U8 banked weight length mismatch" }
            require scales.length() ≡ spec.expert_count * spec.out_features * spec.group_cols throw variant BadShape { message = "DualScaledFp4 U8 banked scales length mismatch" }
            let f32 gs ← resolve_expert_global_scale(expert_global_scales, spec.expert_count, expert_idx)
            let list<u8> w_slice ← slice_u8_rows(weight, expert_idx, spec.out_features, spec.packed_cols, row_offset, row_count)
            let list<u8> s_slice ← slice_u8_rows(scales, expert_idx, spec.out_features, spec.group_cols, row_offset, row_count)
            let fp4.DualScaledFp4Spec fspec ← fp4.admit_spec(row_count, spec.in_features, spec.group_size, variant fp4.PackKind.PackU8)
            let list<f32> w_dense ← fp4.ref_dequantize_u8(fspec, w_slice, s_slice, gs)
            return fp4.ref_matvec(row_count, spec.in_features, w_dense, x)
        }
        case DualScaledFp4U32BankPayload let weight, scales, expert_global_scales {
            match spec.kind {
                case DualScaledFp4 {}
                default {
                    throw variant BadBinding { message = "BankedMatrixSpec kind does not match DualScaledFp4U32BankPayload" }
                }
            }
            require weight.length() ≡ spec.expert_count * spec.out_features * spec.packed_cols throw variant BadShape { message = "DualScaledFp4 U32 banked weight length mismatch" }
            require scales.length() ≡ spec.expert_count * spec.out_features * spec.group_cols throw variant BadShape { message = "DualScaledFp4 U32 banked scales length mismatch" }
            let f32 gs ← resolve_expert_global_scale(expert_global_scales, spec.expert_count, expert_idx)
            let list<u32> w_slice ← slice_u32_rows(weight, expert_idx, spec.out_features, spec.packed_cols, row_offset, row_count)
            let list<u8> s_slice ← slice_u8_rows(scales, expert_idx, spec.out_features, spec.group_cols, row_offset, row_count)
            let fp4.DualScaledFp4Spec fspec ← fp4.admit_spec(row_count, spec.in_features, spec.group_size, variant fp4.PackKind.PackU32)
            let list<f32> w_dense ← fp4.ref_dequantize_u32(fspec, w_slice, s_slice, gs)
            return fp4.ref_matvec(row_count, spec.in_features, w_dense, x)
        }
        case GgmlBlockBankPayload let raw_blocks {
            let int block_elems ← ggml_block_elements(spec.kind)
            let int block_bytes ← ggml_block_bytes(spec.kind)
            let int total_blocks ← spec.in_features / block_elems
            let int row_bytes ← total_blocks * block_bytes
            require raw_blocks.length() ≡ spec.expert_count * spec.out_features * row_bytes throw variant BadShape { message = "GGML banked raw_blocks length mismatch" }

            let storage.Representation rep ← ggml_representation(spec.kind)
            let int e_base ← expert_idx * spec.out_features * row_bytes
            for exclusive row_count let rr {
                let int r ← row_offset + rr
                let int r_base ← e_base + r * row_bytes
                mut f32 acc ← 0.0 ∷ f32
                for exclusive total_blocks let b {
                    let int b_base ← r_base + b * block_bytes
                    mut list<u8> block_slice ← empty
                    for exclusive block_bytes let bi {
                        block_slice.append(raw_blocks[b_base + bi])
                    }
                    let list<f32> decoded ← dequant.decode_block_u8(rep, block_slice)
                    let int x_base ← b * block_elems
                    for exclusive block_elems let k {
                        acc ← acc + decoded[k] * x[x_base + k]
                    }
                }
                y.append(acc)
            }
        }
    }

    return y
}

@ public
fn ref_expert_matvec(BankedMatrixSpec spec, BankedPayload payload, int expert_idx, list<f32> x) → list<f32> ⇥ ExpertBankError {
    return ref_expert_matvec_slice(spec, payload, expert_idx, 0, spec.out_features, x)
}

fn swiglu_list(list<f32> gate, list<f32> up) → list<f32> {
    mut list<f32> out ← empty
    for exclusive gate.length() let i {
        let f32 g ← gate[i]
        let f32 act ← g * (sigmoid g)
        out.append(act * up[i])
    }
    return out
}

@ public
fn situ_list(list<f32> gate, list<f32> up, f32 gate_cap, f32 up_cap) → list<f32> {
    mut list<f32> out ← empty
    for exclusive gate.length() let i {
        mut f32 g ← gate[i]
        if gate_cap ≻ (0.0 ∷ f32) {
            g ← gate_cap * (g / gate_cap).tanh()
        }
        mut f32 u ← up[i]
        if up_cap ≻ (0.0 ∷ f32) {
            u ← up_cap * (u / up_cap).tanh()
        }
        let f32 act ← g * (sigmoid g)
        out.append(act * u)
    }
    return out
}

fn apply_activation_list(ExpertBank bank, list<f32> gate, list<f32> up) → list<f32> {
    let ExpertActivation act ← bank_activation(bank)
    match act {
        case Swiglu {
            return swiglu_list(gate, up)
        }
        case Situ let gate_cap, up_cap {
            return situ_list(gate, up, gate_cap, up_cap)
        }
    }
}

fn eval_single_routed_expert(ExpertBank bank, BankedPayload gate_or_fused, BankedPayload up_or_empty, BankedPayload down, int expert_idx, list<f32> x) → list<f32> ⇥ ExpertBankError {
    match bank.layout {
        case SplitGateUp let gate_spec, up_spec, down_spec {
            let list<f32> g ← ref_expert_matvec(gate_spec, gate_or_fused, expert_idx, x)
            let list<f32> u ← ref_expert_matvec(up_spec, up_or_empty, expert_idx, x)
            let list<f32> h ← apply_activation_list(bank, g, u)
            return ref_expert_matvec(down_spec, down, expert_idx, h)
        }
        case FusedGateUp let gu_spec, gate_rows, up_rows, down_spec {
            let list<f32> g ← ref_expert_matvec_slice(gu_spec, gate_or_fused, expert_idx, 0, gate_rows, x)
            let list<f32> u ← ref_expert_matvec_slice(gu_spec, gate_or_fused, expert_idx, gate_rows, up_rows, x)
            let list<f32> h ← apply_activation_list(bank, g, u)
            return ref_expert_matvec(down_spec, down, expert_idx, h)
        }
    }
}

fn eval_shared_expert(ExpertBank bank, SharedExpertPayload se, list<f32> x) → list<f32> ⇥ ExpertBankError {
    let list<f32> g ← ref_expert_matvec(se.gate_spec, se.gate_payload, 0, x)
    let list<f32> u ← ref_expert_matvec(se.up_spec, se.up_payload, 0, x)
    let list<f32> h ← apply_activation_list(bank, g, u)
    let list<f32> out ← ref_expert_matvec(se.down_spec, se.down_payload, 0, h)

    if se.gate_scalar_weight.length() ≡ 0 {
        return out
    }

    require se.gate_scalar_weight.length() ≡ x.length() throw variant BadShape { message = "shared expert gate scalar weight length mismatch" }
    mut f32 dot ← 0.0 ∷ f32
    for exclusive x.length() let j {
        dot ← dot + se.gate_scalar_weight[j] * x[j]
    }
    let f32 scale ← sigmoid dot
    mut list<f32> scaled ← empty
    for from out let v {
        scaled.append(v * scale)
    }
    return scaled
}

@ public
fn ref_eval_token(ExpertBank bank, BankedPayload gate_or_fused, BankedPayload up_or_empty, BankedPayload down, RouteSelection sel, list<f32> x, list<SharedExpertPayload> shared_experts) → list<f32> ⇥ ExpertBankError {
    require x.length() ≡ bank.hidden_size throw variant BadShape { message = "input hidden vector length mismatch" }
    require sel.indices.length() ≡ sel.weights.length() and sel.indices.length() ≥ 1 throw variant BadConfig { message = "RouteSelection indices/weights mismatch" }
    require shared_experts.length() ≡ bank.shared_expert_count throw variant BadConfig { message = "shared_experts count mismatch" }

    mut list<int> ord_idx ← empty
    mut list<f32> ord_w ← empty
    for exclusive sel.indices.length() let i {
        ord_idx.append(sel.indices[i])
        ord_w.append(sel.weights[i])
    }
    sort_ascending_experts(mut ord_idx, mut ord_w)

    mut list<f32> acc ← empty
    for exclusive bank.hidden_size {
        acc.append(0.0 ∷ f32)
    }

    for exclusive ord_idx.length() let k {
        let int e_idx ← ord_idx[k]
        let f32 w ← ord_w[k]
        let list<f32> e_out ← eval_single_routed_expert(bank, gate_or_fused, up_or_empty, down, e_idx, x)
        for exclusive bank.hidden_size let d {
            acc[d] ← acc[d] + w * e_out[d]
        }
    }

    for from shared_experts let se {
        let list<f32> s_out ← eval_shared_expert(bank, se, x)
        require s_out.length() ≡ bank.hidden_size throw variant BadShape { message = "shared expert output dimension mismatch" }
        for exclusive bank.hidden_size let d {
            acc[d] ← acc[d] + s_out[d]
        }
    }

    return acc
}

@ public
fn ref_eval_batch(ExpertBank bank, BankedPayload gate_or_fused, BankedPayload up_or_empty, BankedPayload down, list<RouteSelection> selections, int batch_size, list<f32> x_flat, list<SharedExpertPayload> shared_experts) → list<f32> ⇥ ExpertBankError {
    require batch_size ≥ 1 throw variant BadShape { message = "batch_size must be at least 1" }
    require selections.length() ≡ batch_size throw variant BadShape { message = "selections length must match batch_size" }
    require x_flat.length() ≡ batch_size * bank.hidden_size throw variant BadShape { message = "x_flat length mismatch" }

    mut list<f32> out_flat ← empty
    for exclusive batch_size let b {
        let int base ← b * bank.hidden_size
        mut list<f32> x_row ← empty
        for exclusive bank.hidden_size let d {
            x_row.append(x_flat[base + d])
        }
        let list<f32> y_row ← ref_eval_token(bank, gate_or_fused, up_or_empty, down, selections[b], x_row, shared_experts)
        for from y_row let v {
            out_flat.append(v)
        }
    }
    return out_flat
}

# -------------------------------------------------------------------------
# Device @ kernel Contractions (B=1 matvec and B=C matmul)
# -------------------------------------------------------------------------

@ public
kernel routed_expert_matvec_dense<size E, size Out, size In>(tensor<f32, [E, Out, In]> weight, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx) → void {
    for from y at [row] thread lane let e {
        if expert_idx ≥ 0 and expert_idx ≺ E {
            mut f32 acc ← 0.0 ∷ f32

            for exclusive In let j {
                acc ← acc + weight[[expert_idx, row, j]] * x[[j]]
            }

            y[[row]] ← acc
        }
    }
}

@ public
kernel routed_expert_matvec_ga_u32<size E, size Out, size PackedIn, size Groups, size In>(tensor<u32, [E, Out, PackedIn]> weight, tensor<f32, [E, Out, Groups]> scales, tensor<f32, [E, Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx, i32 bits, i32 group_size) → void {
    for from y at [row] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 and bits ≥ 4 and bits ≤ 8 and expert_idx ≥ 0 and expert_idx ≺ E {
            mut f32 acc ← 0.0 ∷ f32

            for exclusive In let j {
                let i32 g ← j / group_size
                let f32 s ← scales[[expert_idx, row, g]]
                let f32 b ← biases[[expert_idx, row, g]]
                let i64 bit_pos ← j * bits
                let i64 word_idx ← bit_pos / 32
                let i64 shift ← bit_pos % 32
                let u32 w0 ← weight[[expert_idx, row, word_idx]]
                mut u32 q ← 0 ∷ u32

                if bits ≡ 8 {
                    if shift ≡ 0 {
                        q ← w0 ∧ (255 ∷ u32)
                    }
                    elif shift ≡ 8 {
                        q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                    }
                    elif shift ≡ 16 {
                        q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                    }
                    else {
                        q ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)
                    }
                }
                elif bits ≡ 4 {
                    if shift ≡ 0 {
                        q ← w0 ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 4 {
                        q ← (w0 ⇒ (4 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 8 {
                        q ← (w0 ⇒ (8 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 12 {
                        q ← (w0 ⇒ (12 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 16 {
                        q ← (w0 ⇒ (16 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 20 {
                        q ← (w0 ⇒ (20 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 24 {
                        q ← (w0 ⇒ (24 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    else {
                        q ← (w0 ⇒ (28 ∷ u32)) ∧ (15 ∷ u32)
                    }
                }
                else {
                    if shift ≡ 0 {
                        q ← w0 ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 2 {
                        q ← (w0 ⇒ (2 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 4 {
                        q ← (w0 ⇒ (4 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 6 {
                        q ← (w0 ⇒ (6 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 8 {
                        q ← (w0 ⇒ (8 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 10 {
                        q ← (w0 ⇒ (10 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 12 {
                        q ← (w0 ⇒ (12 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 14 {
                        q ← (w0 ⇒ (14 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 16 {
                        q ← (w0 ⇒ (16 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 18 {
                        q ← (w0 ⇒ (18 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 20 {
                        q ← (w0 ⇒ (20 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 22 {
                        q ← (w0 ⇒ (22 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 24 {
                        q ← (w0 ⇒ (24 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 26 {
                        q ← (w0 ⇒ (26 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 28 {
                        let u32 w1 ← weight[[expert_idx, row, word_idx + 1]]
                        let u32 lo ← w0 ⇒ (28 ∷ u32)
                        let u32 hi ← (w1 ∧ (3 ∷ u32)) * (16 ∷ u32)
                        q ← lo + hi
                    }
                    else {
                        let u32 w1 ← weight[[expert_idx, row, word_idx + 1]]
                        let u32 lo ← w0 ⇒ (30 ∷ u32)
                        let u32 hi ← (w1 ∧ (15 ∷ u32)) * (4 ∷ u32)
                        q ← lo + hi
                    }
                }

                let f32 w ← (q ↦ f32) * s + b
                acc ← acc + w * x[[j]]
            }

            y[[row]] ← acc
        }
    }
}

@ public
kernel routed_expert_matvec_ga_u8<size E, size Out, size PackedIn, size Groups, size In>(tensor<u8, [E, Out, PackedIn]> weight, tensor<f32, [E, Out, Groups]> scales, tensor<f32, [E, Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx, i32 bits, i32 group_size) → void {
    for from y at [row] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 and expert_idx ≥ 0 and expert_idx ≺ E {
            mut f32 acc ← 0.0 ∷ f32

