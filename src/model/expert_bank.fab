@ public
kernel routed_expert_matmul_ggml_q5_k<size B, size E, size Out, size Blocks, size RowBytes, size In>(tensor<u8, [E, Out, RowBytes]> raw_blocks, tensor<f32, [B, In]> x, tensor<i32, [B]> expert_indices, mut tensor<f32, [B, Out]> y) → void {
    for from y at [bi, row] thread lane let e {
        let i32 ee ← expert_indices[[bi]]
        if ee ≥ 0 and ee ≺ E {
            let i32 row_block_limit ← RowBytes / 176
            let i32 in_block_limit ← In / 256
            mut f32 acc ← 0.0 ∷ f32

            for exclusive Blocks let b {
                if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                    let i32 base ← b * 176
                    let i32 d_lo ← (raw_blocks[[ee, row, base]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 d_hi ← (raw_blocks[[ee, row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 d ← ((((d_lo + d_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 dm_lo ← (raw_blocks[[ee, row, base + 2]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 dm_hi ← (raw_blocks[[ee, row, base + 3]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 dmin ← ((((dm_lo + dm_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 x_base ← b * 256
                    for exclusive 4 let chunk {
                        let i32 idx0 ← chunk * 2
                        let i32 idx1 ← idx0 + 1

                        mut i32 sc0 ← 0
                        mut i32 m0 ← 0
                        if idx0 ≺ 4 {
                            sc0 ← (raw_blocks[[ee, row, base + 4 + idx0]] ↦ i32 ⊥ 0) ∧ 63
                            m0 ← (raw_blocks[[ee, row, base + 8 + idx0]] ↦ i32 ⊥ 0) ∧ 63
                        }
                        else {
                            let i32 s_hi ← raw_blocks[[ee, row, base + 8 + idx0]] ↦ i32 ⊥ 0
                            let i32 s_lo ← raw_blocks[[ee, row, base + idx0]] ↦ i32 ⊥ 0
                            let i32 m_lo ← raw_blocks[[ee, row, base + 4 + idx0]] ↦ i32 ⊥ 0
                            sc0 ← (s_hi ∧ 15) + (((s_lo ⇒ 6) ∧ 3) * 16)
                            m0 ← ((s_hi ⇒ 4) ∧ 15) + (((m_lo ⇒ 6) ∧ 3) * 16)
                        }

                        mut i32 sc1 ← 0
                        mut i32 m1 ← 0
                        if idx1 ≺ 4 {
                            sc1 ← (raw_blocks[[ee, row, base + 4 + idx1]] ↦ i32 ⊥ 0) ∧ 63
                            m1 ← (raw_blocks[[ee, row, base + 8 + idx1]] ↦ i32 ⊥ 0) ∧ 63
                        }
                        else {
                            let i32 s_hi ← raw_blocks[[ee, row, base + 8 + idx1]] ↦ i32 ⊥ 0
                            let i32 s_lo ← raw_blocks[[ee, row, base + idx1]] ↦ i32 ⊥ 0
                            let i32 m_lo ← raw_blocks[[ee, row, base + 4 + idx1]] ↦ i32 ⊥ 0
                            sc1 ← (s_hi ∧ 15) + (((s_lo ⇒ 6) ∧ 3) * 16)
                            m1 ← ((s_hi ⇒ 4) ∧ 15) + (((m_lo ⇒ 6) ∧ 3) * 16)
                        }

                        let f32 d1 ← d * (sc0 ↦ f32)
                        let f32 m1f ← dmin * (m0 ↦ f32)
                        let f32 d2 ← d * (sc1 ↦ f32)
                        let f32 m2f ← dmin * (m1 ↦ f32)
                        let i32 qoff ← chunk * 32
                        let i32 cx_base ← x_base + chunk * 64

                        for exclusive 32 let l {
                            let i32 qs ← (raw_blocks[[ee, row, base + 48 + qoff + l]] ↦ i32 ⊥ 0) ∧ 255
                            let i32 qh ← (raw_blocks[[ee, row, base + 16 + l]] ↦ i32 ⊥ 0) ∧ 255
                            mut i32 qh_sh ← qh
                            if chunk ≡ 1 { qh_sh ← qh ⇒ 2 }
                            elif chunk ≡ 2 { qh_sh ← qh ⇒ 4 }
                            elif chunk ≡ 3 { qh_sh ← qh ⇒ 6 }
                            let i32 hi_lo ← (qh_sh ∧ 1) * 16
                            let i32 hi_hi ← ((qh_sh ⇒ 1) ∧ 1) * 16
                            let i32 q_lo ← (qs ∧ 15) + hi_lo
                            let i32 q_hi ← ((qs ⇒ 4) ∧ 15) + hi_hi
                            let f32 w0 ← d1 * (q_lo ↦ f32) - m1f
                            let f32 w1 ← d2 * (q_hi ↦ f32) - m2f
                            acc ← acc + w0 * x[[bi, cx_base + l]] + w1 * x[[bi, cx_base + 32 + l]]
                        }
                    }
                }
            }

            y[[bi, row]] ← acc
        }
    }
}

@ public
kernel routed_expert_matvec_ggml_q6_k<size E, size Out, size Blocks, size RowBytes, size In>(tensor<u8, [E, Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx) → void {
    for from y at [row] thread lane let e {
        if expert_idx ≥ 0 and expert_idx ≺ E {
            let i32 row_block_limit ← RowBytes / 210
            let i32 in_block_limit ← In / 256
            mut f32 acc ← 0.0 ∷ f32

            for exclusive Blocks let b {
                if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                    let i32 base ← b * 210
                    let i32 d_lo ← (raw_blocks[[expert_idx, row, base + 208]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 d_hi ← (raw_blocks[[expert_idx, row, base + 209]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 d ← ((((d_lo + d_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 x_base ← b * 256
                    for exclusive 2 let n {
                        let i32 sc_base ← n * 8
                        let i32 ql_off ← n * 64
                        let i32 qh_off ← n * 32
                        let i32 y_off ← x_base + n * 128

                        for exclusive 32 let l {
                            let i32 idx ← l / 16
                            let i32 ql_lo ← (raw_blocks[[expert_idx, row, base + ql_off + l]] ↦ i32 ⊥ 0) ∧ 255
                            let i32 ql_hi ← (raw_blocks[[expert_idx, row, base + ql_off + l + 32]] ↦ i32 ⊥ 0) ∧ 255
                            let i32 qh ← (raw_blocks[[expert_idx, row, base + 128 + qh_off + l]] ↦ i32 ⊥ 0) ∧ 255

                            let i32 q1 ← ((ql_lo ∧ 15) + ((qh ∧ 3) * 16)) - 32
                            let i32 q2 ← ((ql_hi ∧ 15) + (((qh ⇒ 2) ∧ 3) * 16)) - 32
                            let i32 q3 ← (((ql_lo ⇒ 4) ∧ 15) + (((qh ⇒ 4) ∧ 3) * 16)) - 32
                            let i32 q4 ← (((ql_hi ⇒ 4) ∧ 15) + (((qh ⇒ 6) ∧ 3) * 16)) - 32

                            let i32 s0_u ← (raw_blocks[[expert_idx, row, base + 192 + sc_base + idx]] ↦ i32 ⊥ 0) ∧ 255
                            let i32 s2_u ← (raw_blocks[[expert_idx, row, base + 192 + sc_base + idx + 2]] ↦ i32 ⊥ 0) ∧ 255
                            let i32 s4_u ← (raw_blocks[[expert_idx, row, base + 192 + sc_base + idx + 4]] ↦ i32 ⊥ 0) ∧ 255
                            let i32 s6_u ← (raw_blocks[[expert_idx, row, base + 192 + sc_base + idx + 6]] ↦ i32 ⊥ 0) ∧ 255

                            let i32 s0 ← s0_u ≥ 128 ✓ s0_u - 256 ✗ s0_u
                            let i32 s2 ← s2_u ≥ 128 ✓ s2_u - 256 ✗ s2_u
                            let i32 s4 ← s4_u ≥ 128 ✓ s4_u - 256 ✗ s4_u
                            let i32 s6 ← s6_u ≥ 128 ✓ s6_u - 256 ✗ s6_u

                            let f32 w1 ← d * (s0 ↦ f32) * (q1 ↦ f32)
                            let f32 w2 ← d * (s2 ↦ f32) * (q2 ↦ f32)
                            let f32 w3 ← d * (s4 ↦ f32) * (q3 ↦ f32)
                            let f32 w4 ← d * (s6 ↦ f32) * (q4 ↦ f32)

                            acc ← acc + w1 * x[[y_off + l]] + w2 * x[[y_off + l + 32]] + w3 * x[[y_off + l + 64]] + w4 * x[[y_off + l + 96]]
                        }
                    }
                }
            }

            y[[row]] ← acc
        }
    }
}

@ public
kernel routed_expert_matmul_ggml_q6_k<size B, size E, size Out, size Blocks, size RowBytes, size In>(tensor<u8, [E, Out, RowBytes]> raw_blocks, tensor<f32, [B, In]> x, tensor<i32, [B]> expert_indices, mut tensor<f32, [B, Out]> y) → void {
    for from y at [bi, row] thread lane let e {
        let i32 ee ← expert_indices[[bi]]
        if ee ≥ 0 and ee ≺ E {
            let i32 row_block_limit ← RowBytes / 210
            let i32 in_block_limit ← In / 256
            mut f32 acc ← 0.0 ∷ f32

            for exclusive Blocks let b {
                if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                    let i32 base ← b * 210
                    let i32 d_lo ← (raw_blocks[[ee, row, base + 208]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 d_hi ← (raw_blocks[[ee, row, base + 209]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 d ← ((((d_lo + d_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 x_base ← b * 256
                    for exclusive 2 let n {
                        let i32 sc_base ← n * 8
                        let i32 ql_off ← n * 64
                        let i32 qh_off ← n * 32
                        let i32 y_off ← x_base + n * 128

                        for exclusive 32 let l {
                            let i32 idx ← l / 16
                            let i32 ql_lo ← (raw_blocks[[ee, row, base + ql_off + l]] ↦ i32 ⊥ 0) ∧ 255
                            let i32 ql_hi ← (raw_blocks[[ee, row, base + ql_off + l + 32]] ↦ i32 ⊥ 0) ∧ 255
                            let i32 qh ← (raw_blocks[[ee, row, base + 128 + qh_off + l]] ↦ i32 ⊥ 0) ∧ 255

                            let i32 q1 ← ((ql_lo ∧ 15) + ((qh ∧ 3) * 16)) - 32
                            let i32 q2 ← ((ql_hi ∧ 15) + (((qh ⇒ 2) ∧ 3) * 16)) - 32
                            let i32 q3 ← (((ql_lo ⇒ 4) ∧ 15) + (((qh ⇒ 4) ∧ 3) * 16)) - 32
                            let i32 q4 ← (((ql_hi ⇒ 4) ∧ 15) + (((qh ⇒ 6) ∧ 3) * 16)) - 32

                            let i32 s0_u ← (raw_blocks[[ee, row, base + 192 + sc_base + idx]] ↦ i32 ⊥ 0) ∧ 255
                            let i32 s2_u ← (raw_blocks[[ee, row, base + 192 + sc_base + idx + 2]] ↦ i32 ⊥ 0) ∧ 255
                            let i32 s4_u ← (raw_blocks[[ee, row, base + 192 + sc_base + idx + 4]] ↦ i32 ⊥ 0) ∧ 255
                            let i32 s6_u ← (raw_blocks[[ee, row, base + 192 + sc_base + idx + 6]] ↦ i32 ⊥ 0) ∧ 255

                            let i32 s0 ← s0_u ≥ 128 ✓ s0_u - 256 ✗ s0_u
                            let i32 s2 ← s2_u ≥ 128 ✓ s2_u - 256 ✗ s2_u
                            let i32 s4 ← s4_u ≥ 128 ✓ s4_u - 256 ✗ s4_u
                            let i32 s6 ← s6_u ≥ 128 ✓ s6_u - 256 ✗ s6_u

                            let f32 w1 ← d * (s0 ↦ f32) * (q1 ↦ f32)
                            let f32 w2 ← d * (s2 ↦ f32) * (q2 ↦ f32)
                            let f32 w3 ← d * (s4 ↦ f32) * (q3 ↦ f32)
                            let f32 w4 ← d * (s6 ↦ f32) * (q4 ↦ f32)

                            acc ← acc + w1 * x[[bi, y_off + l]] + w2 * x[[bi, y_off + l + 32]] + w3 * x[[bi, y_off + l + 64]] + w4 * x[[bi, y_off + l + 96]]
                        }
                    }
                }
            }

            y[[bi, row]] ← acc
        }
    }
}

# -------------------------------------------------------------------------
# Typed Host Dispatchers for Device Contractions
# -------------------------------------------------------------------------

@ public
fn dispatch_routed_matvec_dense<size E, size Out, size In>(BankedMatrixSpec spec, tensor<f32, [E, Out, In]> weight, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, int expert_idx) → void ⇥ ExpertBankError {
    match spec.kind {
        case DenseF32 {}
        default {
            throw variant BadBinding { message = "expected DenseF32 BankedMatrixSpec" }
        }
    }
    require spec.expert_count ≡ E and spec.out_features ≡ Out and spec.in_features ≡ In throw variant BadShape { message = "shape mismatch in dispatch_routed_matvec_dense" }
    require expert_idx ≥ 0 and expert_idx ≺ E throw variant BadShape { message = "expert_idx out of bounds" }
    routed_expert_matvec_dense<size E, size Out, size In>(weight, x, mut y, expert_idx ↦ i32 ⊥ 0)
}

@ public
fn dispatch_routed_matvec_ga_u32<size E, size Out, size PackedIn, size Groups, size In>(BankedMatrixSpec spec, tensor<u32, [E, Out, PackedIn]> weight, tensor<f32, [E, Out, Groups]> scales, tensor<f32, [E, Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, int expert_idx) → void ⇥ ExpertBankError {
    match spec.kind {
        case GroupAffineU32 {}
        default {
            throw variant BadBinding { message = "expected GroupAffineU32 BankedMatrixSpec" }
        }
    }
    require spec.expert_count ≡ E and spec.out_features ≡ Out and spec.in_features ≡ In and spec.packed_cols ≡ PackedIn and spec.group_cols ≡ Groups throw variant BadShape { message = "shape mismatch in dispatch_routed_matvec_ga_u32" }
    require expert_idx ≥ 0 and expert_idx ≺ E throw variant BadShape { message = "expert_idx out of bounds" }
    routed_expert_matvec_ga_u32<size E, size Out, size PackedIn, size Groups, size In>(weight, scales, biases, x, mut y, expert_idx ↦ i32 ⊥ 0, spec.bits ↦ i32 ⊥ 8, spec.group_size ↦ i32 ⊥ 64)
}

