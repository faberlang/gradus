@ public
kernel routed_expert_matvec_ga_u32_f16<size E, size Out, size PackedIn, size Groups, size In>(tensor<u32, [E, Out, PackedIn]> weight, tensor<f16, [E, Out, Groups]> scales, tensor<f16, [E, Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx, i32 bits, i32 group_size) → void {
    for from y at [row] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 and (bits ≡ 4 or bits ≡ 6 or bits ≡ 8) and expert_idx ≥ 0 and expert_idx ≺ E and In ≤ 200000000 {
            let i32 n_groups ← In / group_size
            mut f32 acc ← 0.0 ∷ f32

            for exclusive n_groups let g {
                let f32 s ← scales[[expert_idx, row, g]] ↦ f32
                let f32 b ← biases[[expert_idx, row, g]] ↦ f32
                let i32 j_base ← g * group_size

                for exclusive group_size let k {
                    let i32 j ← j_base + k
                    let i32 bit_pos ← j * bits
                    let i32 word_idx ← bit_pos / 32
                    let i32 shift ← bit_pos % 32
                    let u32 w0 ← weight[[expert_idx, row, word_idx]]
                    mut u32 q ← 0 ∷ u32

                    if bits ≡ 8 {
                        if shift ≡ 0 { q ← w0 ∧ (255 ∷ u32) }
                        elif shift ≡ 8 { q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32) }
                        elif shift ≡ 16 { q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32) }
                        else { q ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32) }
                    }
                    elif bits ≡ 4 {
                        if shift ≡ 0 { q ← w0 ∧ (15 ∷ u32) }
                        elif shift ≡ 4 { q ← (w0 ⇒ (4 ∷ u32)) ∧ (15 ∷ u32) }
                        elif shift ≡ 8 { q ← (w0 ⇒ (8 ∷ u32)) ∧ (15 ∷ u32) }
                        elif shift ≡ 12 { q ← (w0 ⇒ (12 ∷ u32)) ∧ (15 ∷ u32) }
                        elif shift ≡ 16 { q ← (w0 ⇒ (16 ∷ u32)) ∧ (15 ∷ u32) }
                        elif shift ≡ 20 { q ← (w0 ⇒ (20 ∷ u32)) ∧ (15 ∷ u32) }
                        elif shift ≡ 24 { q ← (w0 ⇒ (24 ∷ u32)) ∧ (15 ∷ u32) }
                        else { q ← (w0 ⇒ (28 ∷ u32)) ∧ (15 ∷ u32) }
                    }
                    else {
                        if shift ≡ 0 { q ← w0 ∧ (63 ∷ u32) }
                        elif shift ≡ 2 { q ← (w0 ⇒ (2 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 4 { q ← (w0 ⇒ (4 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 6 { q ← (w0 ⇒ (6 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 8 { q ← (w0 ⇒ (8 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 10 { q ← (w0 ⇒ (10 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 12 { q ← (w0 ⇒ (12 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 14 { q ← (w0 ⇒ (14 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 16 { q ← (w0 ⇒ (16 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 18 { q ← (w0 ⇒ (18 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 20 { q ← (w0 ⇒ (20 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 22 { q ← (w0 ⇒ (22 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 24 { q ← (w0 ⇒ (24 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 26 { q ← (w0 ⇒ (26 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 28 {
                            let u32 w1 ← weight[[expert_idx, row, word_idx + 1]]
                            let u32 lo ← w0 ⇒ (28 ∷ u32)
                            let u32 hi ← (w1 ∧ (3 ∷ u32)) * (16 ∷ u32)
                            q ← lo + hi
                        }
                        else {
                            let u32 w1 ← weight[[expert_idx, row, word_idx + 1]]
                            let u32 lo ← w0 ⇒ (30 ∷ u32)
                            let u32 hi ← (w1 ∧ (15 ∷ u32)) * (4 ∷ u32)
                            q ← lo + hi
                        }
                    }

                    let f32 w ← (q ↦ f32) * s + b
                    acc ← acc + w * x[[j]]
                }
            }

            y[[row]] ← acc
        }
    }
}

@ public
kernel routed_expert_matmul_ga_u32_f16<size B, size E, size Out, size PackedIn, size Groups, size In>(tensor<u32, [E, Out, PackedIn]> weight, tensor<f16, [E, Out, Groups]> scales, tensor<f16, [E, Out, Groups]> biases, tensor<f32, [B, In]> x, tensor<i32, [B]> expert_indices, mut tensor<f32, [B, Out]> y, i32 bits, i32 group_size) → void {
    for from y at [bi, rr] thread lane let e {
        let i32 ee ← expert_indices[[bi]]
        if group_size ≥ 1 and group_size ≤ 4096 and (bits ≡ 4 or bits ≡ 6 or bits ≡ 8) and ee ≥ 0 and ee ≺ E and In ≤ 200000000 {
            let i32 n_groups ← In / group_size
            mut f32 acc ← 0.0 ∷ f32

            for exclusive n_groups let g {
                let f32 s ← scales[[ee, rr, g]] ↦ f32
                let f32 b ← biases[[ee, rr, g]] ↦ f32
                let i32 j_base ← g * group_size

                for exclusive group_size let k {
                    let i32 j ← j_base + k
                    let i32 bit_pos ← j * bits
                    let i32 word_idx ← bit_pos / 32
                    let i32 shift ← bit_pos % 32
                    let u32 w0 ← weight[[ee, rr, word_idx]]
                    mut u32 q ← 0 ∷ u32

                    if bits ≡ 8 {
                        if shift ≡ 0 { q ← w0 ∧ (255 ∷ u32) }
                        elif shift ≡ 8 { q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32) }
                        elif shift ≡ 16 { q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32) }
                        else { q ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32) }
                    }
                    elif bits ≡ 4 {
                        if shift ≡ 0 { q ← w0 ∧ (15 ∷ u32) }
                        elif shift ≡ 4 { q ← (w0 ⇒ (4 ∷ u32)) ∧ (15 ∷ u32) }
                        elif shift ≡ 8 { q ← (w0 ⇒ (8 ∷ u32)) ∧ (15 ∷ u32) }
                        elif shift ≡ 12 { q ← (w0 ⇒ (12 ∷ u32)) ∧ (15 ∷ u32) }
                        elif shift ≡ 16 { q ← (w0 ⇒ (16 ∷ u32)) ∧ (15 ∷ u32) }
                        elif shift ≡ 20 { q ← (w0 ⇒ (20 ∷ u32)) ∧ (15 ∷ u32) }
                        elif shift ≡ 24 { q ← (w0 ⇒ (24 ∷ u32)) ∧ (15 ∷ u32) }
                        else { q ← (w0 ⇒ (28 ∷ u32)) ∧ (15 ∷ u32) }
                    }
                    else {
                        if shift ≡ 0 { q ← w0 ∧ (63 ∷ u32) }
                        elif shift ≡ 2 { q ← (w0 ⇒ (2 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 4 { q ← (w0 ⇒ (4 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 6 { q ← (w0 ⇒ (6 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 8 { q ← (w0 ⇒ (8 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 10 { q ← (w0 ⇒ (10 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 12 { q ← (w0 ⇒ (12 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 14 { q ← (w0 ⇒ (14 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 16 { q ← (w0 ⇒ (16 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 18 { q ← (w0 ⇒ (18 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 20 { q ← (w0 ⇒ (20 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 22 { q ← (w0 ⇒ (22 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 24 { q ← (w0 ⇒ (24 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 26 { q ← (w0 ⇒ (26 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 28 {
                            let u32 w1 ← weight[[ee, rr, word_idx + 1]]
                            let u32 lo ← w0 ⇒ (28 ∷ u32)
                            let u32 hi ← (w1 ∧ (3 ∷ u32)) * (16 ∷ u32)
                            q ← lo + hi
                        }
                        else {
                            let u32 w1 ← weight[[ee, rr, word_idx + 1]]
                            let u32 lo ← w0 ⇒ (30 ∷ u32)
                            let u32 hi ← (w1 ∧ (15 ∷ u32)) * (4 ∷ u32)
                            q ← lo + hi
                        }
                    }

                    let f32 w ← (q ↦ f32) * s + b
                    acc ← acc + w * x[[bi, j]]
                }
            }

            y[[bi, rr]] ← acc
        }
    }
}

@ public
kernel routed_expert_matvec_ga_u8_f16<size E, size Out, size PackedIn, size Groups, size In>(tensor<u8, [E, Out, PackedIn]> weight, tensor<f16, [E, Out, Groups]> scales, tensor<f16, [E, Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx, i32 bits, i32 group_size) → void {
    for from y at [row] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 and (bits ≡ 4 or bits ≡ 8) and expert_idx ≥ 0 and expert_idx ≺ E and In ≤ 200000000 {
            let i32 n_groups ← In / group_size
            mut f32 acc ← 0.0 ∷ f32

            for exclusive n_groups let g {
                let f32 s ← scales[[expert_idx, row, g]] ↦ f32
                let f32 b ← biases[[expert_idx, row, g]] ↦ f32
                let i32 j_base ← g * group_size

                for exclusive group_size let k {
                    let i32 j ← j_base + k
                    mut u8 q ← 0 ∷ u8
                    if bits ≡ 8 {
                        q ← weight[[expert_idx, row, j]]
                    }
                    else {
                        let u8 packed ← weight[[expert_idx, row, j / 2]]
                        if j % 2 ≡ 0 { q ← packed ∧ (15 ∷ u8) }
                        else { q ← (packed ⇒ (4 ∷ u8)) ∧ (15 ∷ u8) }
                    }
                    let f32 w ← (q ↦ f32) * s + b
                    acc ← acc + w * x[[j]]
                }
            }

            y[[row]] ← acc
        }
    }
}

@ public
kernel routed_expert_matmul_ga_u8_f16<size B, size E, size Out, size PackedIn, size Groups, size In>(tensor<u8, [E, Out, PackedIn]> weight, tensor<f16, [E, Out, Groups]> scales, tensor<f16, [E, Out, Groups]> biases, tensor<f32, [B, In]> x, tensor<i32, [B]> expert_indices, mut tensor<f32, [B, Out]> y, i32 bits, i32 group_size) → void {
    for from y at [bi, rr] thread lane let e {
        let i32 ee ← expert_indices[[bi]]
        if group_size ≥ 1 and group_size ≤ 4096 and (bits ≡ 4 or bits ≡ 8) and ee ≥ 0 and ee ≺ E and In ≤ 200000000 {
            let i32 n_groups ← In / group_size
            mut f32 acc ← 0.0 ∷ f32

            for exclusive n_groups let g {
                let f32 s ← scales[[ee, rr, g]] ↦ f32
                let f32 b ← biases[[ee, rr, g]] ↦ f32
                let i32 j_base ← g * group_size

                for exclusive group_size let k {
                    let i32 j ← j_base + k
                    mut u8 q ← 0 ∷ u8
                    if bits ≡ 8 {
                        q ← weight[[ee, rr, j]]
                    }
                    else {
                        let u8 packed ← weight[[ee, rr, j / 2]]
                        if j % 2 ≡ 0 { q ← packed ∧ (15 ∷ u8) }
                        else { q ← (packed ⇒ (4 ∷ u8)) ∧ (15 ∷ u8) }
                    }
                    let f32 w ← (q ↦ f32) * s + b
                    acc ← acc + w * x[[bi, j]]
                }
            }

            y[[bi, rr]] ← acc
        }
    }
}

@ public
kernel routed_expert_situ<size F>(tensor<f32, [F]> gate, tensor<f32, [F]> up, mut tensor<f32, [F]> out, f32 gate_cap, f32 up_cap) → void {
    for from out at [i] thread lane let e {
        mut f32 g ← gate[[i]]
        if gate_cap ≻ (0.0 ∷ f32) {
            g ← gate_cap * (g / gate_cap).tanh()
        }
        mut f32 u ← up[[i]]
        if up_cap ≻ (0.0 ∷ f32) {
            u ← up_cap * (u / up_cap).tanh()
        }
        let f32 act ← g / ((1.0 ∷ f32) + (-g).exp())
        out[[i]] ← act * u
    }
}

@ public
kernel routed_expert_situ_batch<size B, size F>(tensor<f32, [B, F]> gate, tensor<f32, [B, F]> up, mut tensor<f32, [B, F]> out, f32 gate_cap, f32 up_cap) → void {
    for from out at [bi, i] thread lane let e {
        mut f32 g ← gate[[bi, i]]
        if gate_cap ≻ (0.0 ∷ f32) {
            g ← gate_cap * (g / gate_cap).tanh()
        }
        mut f32 u ← up[[bi, i]]
        if up_cap ≻ (0.0 ∷ f32) {
            u ← up_cap * (u / up_cap).tanh()
        }
        let f32 act ← g / ((1.0 ∷ f32) + (-g).exp())
        out[[bi, i]] ← act * u
    }
}

@ public
kernel routed_expert_matvec_ggml_q8_0<size E, size Out, size Blocks, size RowBytes, size In>(tensor<u8, [E, Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx) → void {
    for from y at [row] thread lane let e {
        if expert_idx ≥ 0 and expert_idx ≺ E {
            let i32 row_block_limit ← RowBytes / 34
            let i32 in_block_limit ← In / 32
            mut f32 acc ← 0.0 ∷ f32

            for exclusive Blocks let b {
                if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                    let i32 base ← b * 34
                    let i32 lo ← (raw_blocks[[expert_idx, row, base]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 hi ← (raw_blocks[[expert_idx, row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 d ← ((((lo + hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 x_base ← b * 32
                    for exclusive 32 let k {
                        let i32 q_u ← raw_blocks[[expert_idx, row, base + 2 + k]] ↦ i32 ⊥ 0
                        mut i32 q_s ← q_u
                        if q_u ≥ 128 { q_s ← q_u - 256 }
                        acc ← acc + ((q_s ↦ f32) * d) * x[[x_base + k]]
                    }
                }
            }

            y[[row]] ← acc
        }
    }
}

@ public
kernel routed_expert_matmul_ggml_q8_0<size B, size E, size Out, size Blocks, size RowBytes, size In>(tensor<u8, [E, Out, RowBytes]> raw_blocks, tensor<f32, [B, In]> x, tensor<i32, [B]> expert_indices, mut tensor<f32, [B, Out]> y) → void {
    for from y at [bi, row] thread lane let e {
        let i32 ee ← expert_indices[[bi]]
        if ee ≥ 0 and ee ≺ E {
            let i32 row_block_limit ← RowBytes / 34
            let i32 in_block_limit ← In / 32
            mut f32 acc ← 0.0 ∷ f32

            for exclusive Blocks let b {
                if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                    let i32 base ← b * 34
                    let i32 lo ← (raw_blocks[[ee, row, base]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 hi ← (raw_blocks[[ee, row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 d ← ((((lo + hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 x_base ← b * 32
                    for exclusive 32 let k {
                        let i32 q_u ← raw_blocks[[ee, row, base + 2 + k]] ↦ i32 ⊥ 0
                        mut i32 q_s ← q_u
                        if q_u ≥ 128 { q_s ← q_u - 256 }
                        acc ← acc + ((q_s ↦ f32) * d) * x[[bi, x_base + k]]
                    }
                }
            }

            y[[bi, row]] ← acc
        }
    }
}

@ public
kernel routed_expert_matvec_ggml_q4_1<size E, size Out, size Blocks, size RowBytes, size In>(tensor<u8, [E, Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx) → void {
    for from y at [row] thread lane let e {
        if expert_idx ≥ 0 and expert_idx ≺ E {
            let i32 row_block_limit ← RowBytes / 20
            let i32 in_block_limit ← In / 32
            mut f32 acc ← 0.0 ∷ f32

            for exclusive Blocks let b {
                if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                    let i32 base ← b * 20
                    let i32 d_lo ← (raw_blocks[[expert_idx, row, base]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 d_hi ← (raw_blocks[[expert_idx, row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 d ← ((((d_lo + d_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 m_lo ← (raw_blocks[[expert_idx, row, base + 2]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 m_hi ← (raw_blocks[[expert_idx, row, base + 3]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 m ← ((((m_lo + m_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 x_base ← b * 32
                    for exclusive 16 let j {
                        let i32 qs ← (raw_blocks[[expert_idx, row, base + 4 + j]] ↦ i32 ⊥ 0) ∧ 255
                        let f32 w0 ← ((qs ∧ 15) ↦ f32) * d + m
                        let f32 w1 ← (((qs ⇒ 4) ∧ 15) ↦ f32) * d + m
                        acc ← acc + w0 * x[[x_base + j]] + w1 * x[[x_base + 16 + j]]
                    }
                }
            }

            y[[row]] ← acc
        }
    }
}

@ public
kernel routed_expert_matmul_ggml_q4_1<size B, size E, size Out, size Blocks, size RowBytes, size In>(tensor<u8, [E, Out, RowBytes]> raw_blocks, tensor<f32, [B, In]> x, tensor<i32, [B]> expert_indices, mut tensor<f32, [B, Out]> y) → void {
    for from y at [bi, row] thread lane let e {
        let i32 ee ← expert_indices[[bi]]
        if ee ≥ 0 and ee ≺ E {
            let i32 row_block_limit ← RowBytes / 20
            let i32 in_block_limit ← In / 32
            mut f32 acc ← 0.0 ∷ f32

            for exclusive Blocks let b {
                if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                    let i32 base ← b * 20
                    let i32 d_lo ← (raw_blocks[[ee, row, base]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 d_hi ← (raw_blocks[[ee, row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 d ← ((((d_lo + d_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 m_lo ← (raw_blocks[[ee, row, base + 2]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 m_hi ← (raw_blocks[[ee, row, base + 3]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 m ← ((((m_lo + m_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 x_base ← b * 32
                    for exclusive 16 let j {
                        let i32 qs ← (raw_blocks[[ee, row, base + 4 + j]] ↦ i32 ⊥ 0) ∧ 255
                        let f32 w0 ← ((qs ∧ 15) ↦ f32) * d + m
                        let f32 w1 ← (((qs ⇒ 4) ∧ 15) ↦ f32) * d + m
                        acc ← acc + w0 * x[[bi, x_base + j]] + w1 * x[[bi, x_base + 16 + j]]
                    }
                }
            }

            y[[bi, row]] ← acc
        }
    }
}

@ public
kernel routed_expert_matvec_ggml_q5_0<size E, size Out, size Blocks, size RowBytes, size In>(tensor<u8, [E, Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx) → void {
    for from y at [row] thread lane let e {
        if expert_idx ≥ 0 and expert_idx ≺ E {
            let i32 row_block_limit ← RowBytes / 22
            let i32 in_block_limit ← In / 32
            mut f32 acc ← 0.0 ∷ f32

            for exclusive Blocks let b {
                if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                    let i32 base ← b * 22
                    let i32 lo ← (raw_blocks[[expert_idx, row, base]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 hi ← (raw_blocks[[expert_idx, row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 d ← ((((lo + hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 x_base ← b * 32
                    for exclusive 16 let j {
                        let i32 qh_lo_b ← (raw_blocks[[expert_idx, row, base + 2 + (j / 8)]] ↦ i32 ⊥ 0) ∧ 255
                        let i32 qh_hi_b ← (raw_blocks[[expert_idx, row, base + 4 + (j / 8)]] ↦ i32 ⊥ 0) ∧ 255
                        let i32 bit_pos ← j % 8
                        mut i32 qh_lo_sh ← qh_lo_b
                        mut i32 qh_hi_sh ← qh_hi_b
                        if bit_pos ≡ 1 {
                            qh_lo_sh ← qh_lo_b ⇒ 1
                            qh_hi_sh ← qh_hi_b ⇒ 1
                        }
                        elif bit_pos ≡ 2 {
                            qh_lo_sh ← qh_lo_b ⇒ 2
                            qh_hi_sh ← qh_hi_b ⇒ 2
                        }
                        elif bit_pos ≡ 3 {
                            qh_lo_sh ← qh_lo_b ⇒ 3
                            qh_hi_sh ← qh_hi_b ⇒ 3
                        }
                        elif bit_pos ≡ 4 {
                            qh_lo_sh ← qh_lo_b ⇒ 4
                            qh_hi_sh ← qh_hi_b ⇒ 4
                        }
                        elif bit_pos ≡ 5 {
                            qh_lo_sh ← qh_lo_b ⇒ 5
                            qh_hi_sh ← qh_hi_b ⇒ 5
                        }
                        elif bit_pos ≡ 6 {
                            qh_lo_sh ← qh_lo_b ⇒ 6
                            qh_hi_sh ← qh_hi_b ⇒ 6
                        }
                        elif bit_pos ≡ 7 {
                            qh_lo_sh ← qh_lo_b ⇒ 7
                            qh_hi_sh ← qh_hi_b ⇒ 7
                        }
                        let i32 xh_0 ← (qh_lo_sh ∧ 1) * 16
                        let i32 xh_1 ← (qh_hi_sh ∧ 1) * 16
                        let i32 qs ← (raw_blocks[[expert_idx, row, base + 6 + j]] ↦ i32 ⊥ 0) ∧ 255
                        let i32 x0 ← ((qs ∧ 15) + xh_0) - 16
                        let i32 x1 ← (((qs ⇒ 4) ∧ 15) + xh_1) - 16
                        acc ← acc + ((x0 ↦ f32) * d) * x[[x_base + j]] + ((x1 ↦ f32) * d) * x[[x_base + 16 + j]]
                    }
                }
            }

            y[[row]] ← acc
        }
    }
}

@ public
kernel routed_expert_matmul_ggml_q5_0<size B, size E, size Out, size Blocks, size RowBytes, size In>(tensor<u8, [E, Out, RowBytes]> raw_blocks, tensor<f32, [B, In]> x, tensor<i32, [B]> expert_indices, mut tensor<f32, [B, Out]> y) → void {
    for from y at [bi, row] thread lane let e {
        let i32 ee ← expert_indices[[bi]]
        if ee ≥ 0 and ee ≺ E {
            let i32 row_block_limit ← RowBytes / 22
            let i32 in_block_limit ← In / 32
            mut f32 acc ← 0.0 ∷ f32

            for exclusive Blocks let b {
                if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                    let i32 base ← b * 22
                    let i32 lo ← (raw_blocks[[ee, row, base]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 hi ← (raw_blocks[[ee, row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                    let f32 d ← ((((lo + hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                    let i32 x_base ← b * 32
                    for exclusive 16 let j {
                        let i32 qh_lo_b ← (raw_blocks[[ee, row, base + 2 + (j / 8)]] ↦ i32 ⊥ 0) ∧ 255
                        let i32 qh_hi_b ← (raw_blocks[[ee, row, base + 4 + (j / 8)]] ↦ i32 ⊥ 0) ∧ 255
                        let i32 bit_pos ← j % 8
                        mut i32 qh_lo_sh ← qh_lo_b
                        mut i32 qh_hi_sh ← qh_hi_b
                        if bit_pos ≡ 1 {
                            qh_lo_sh ← qh_lo_b ⇒ 1
                            qh_hi_sh ← qh_hi_b ⇒ 1
                        }
                        elif bit_pos ≡ 2 {
                            qh_lo_sh ← qh_lo_b ⇒ 2
                            qh_hi_sh ← qh_hi_b ⇒ 2
                        }
                        elif bit_pos ≡ 3 {
                            qh_lo_sh ← qh_lo_b ⇒ 3
                            qh_hi_sh ← qh_hi_b ⇒ 3
                        }
                        elif bit_pos ≡ 4 {
                            qh_lo_sh ← qh_lo_b ⇒ 4
                            qh_hi_sh ← qh_hi_b ⇒ 4
                        }
                        elif bit_pos ≡ 5 {
                            qh_lo_sh ← qh_lo_b ⇒ 5
                            qh_hi_sh ← qh_hi_b ⇒ 5
                        }
                        elif bit_pos ≡ 6 {
                            qh_lo_sh ← qh_lo_b ⇒ 6
                            qh_hi_sh ← qh_hi_b ⇒ 6
                        }
                        elif bit_pos ≡ 7 {
                            qh_lo_sh ← qh_lo_b ⇒ 7
                            qh_hi_sh ← qh_hi_b ⇒ 7
                        }
                        let i32 xh_0 ← (qh_lo_sh ∧ 1) * 16
                        let i32 xh_1 ← (qh_hi_sh ∧ 1) * 16
                        let i32 qs ← (raw_blocks[[ee, row, base + 6 + j]] ↦ i32 ⊥ 0) ∧ 255
                        let i32 x0 ← ((qs ∧ 15) + xh_0) - 16
                        let i32 x1 ← (((qs ⇒ 4) ∧ 15) + xh_1) - 16
                        acc ← acc + ((x0 ↦ f32) * d) * x[[bi, x_base + j]] + ((x1 ↦ f32) * d) * x[[bi, x_base + 16 + j]]
                    }
                }
            }

            y[[bi, row]] ← acc
        }
    }
}

