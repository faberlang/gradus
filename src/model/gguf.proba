+++
locale = "la"
+++
# Co-located package test for gguf.fab (PML2-U3 — GGUF row admission,
# capsule-schema-2.0.0, A1C-M2).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the fail-closed schema-2 GGUF admission (legal
# fixture → schema-2 capsule with pathless content identity + GGUF
# manifest), the typed rejection matrix across the pinned one-row contract
# (format/version/header, counts, metadata keys and pinned values, tensor
# shapes/offsets, coverage), and the authority boundary (wire/format
# rejections carry the manifestum authority's typed causa). adfirma
# assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
#
# NOTE (pinned-row facts): the pinned-row facts (byte length 270,590,880;
# tensor count 290; total elements 361,821,120; per-type counts F32 65 /
# Q4_K 16 / Q5_0 176 / Q6_K 16 / Q8_0 17; digest prefix 2fa3f013…bac9c2;
# metadata KV count 37; file_type 15; quantization version 2) are cited
# read-only from gi0-model-contract v1.0.0 / gi1-closeout.md. The LEGAL
# fixture is a scaled STRUCTURAL replica of the pinned row: the same
# admitted metadata values (arch llama / 32 / 8192 / 49152 / 960, gpt2 /
# smollm tokenizer, file_type 15, quant version 2, aligned 32) with a
# scaled tensor inventory (3 tensors: Q8_0 + F32 + Q4_K, exact block
# layouts). The whole-file SHA-256 is computed by the admission host
# (capsule.fab boundary) — the proba passes format-valid hex fixtures; the
# digest VALUE is asserted as carried identity.

importa ex "gradus:model/gguf" gguf
importa ex "gradus:model/capsule" capsula

# -- fixture contract (scaled structural replica of the pinned row) -------
# F_DIGEST is the real whole-file SHA-256 of the generated fixture
# `fixtures/gguf/smollm2-360m-scaled-row.gguf` (oracle, gguf-row-oracle.md;
# recompute with `shasum -a 256` — a re-pin is an operator decision). The
# pinned row's own digest is 2fa3f013…bac9c2 (gi1-closeout, read-only);
# the scaled fixture has its own hash and its own identity.
fixum textus F_DIGEST ← "d89c9ef917158bfb5600f417020479499c6c042f728e9a29c8457a6b1a8f0974"
fixum textus F_ALIA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
fixum numerus F_KV ← 18
fixum numerus F_TENSORES ← 3
fixum numerus F_ELEMENTA ← 4624
fixum numerus F_F32 ← 1
fixum numerus F_Q4K ← 1
fixum numerus F_Q5 ← 0
fixum numerus F_Q6 ← 0
fixum numerus F_Q8 ← 1

# The GGUF magic, as bytes.
functio magica() → lista<numerus<u8>> {
    redde bytes([0x47, 0x47, 0x55, 0x46])
}

# The 15 identity-bearing required keys + 3 optional admitted keys. KV
# codec: "key;type;value" (type s=string, u=u32, b=bool, as=array[string]).
fixum lista<textus> LEGAL_KVS ← [
    "general.architecture;s;llama",
    "general.file_type;u;15",
    "general.quantization_version;u;2",
    "llama.block_count;u;32",
    "llama.context_length;u;8192",
    "llama.vocab_size;u;49152",
    "llama.embedding_length;u;960",
    "tokenizer.ggml.model;s;gpt2",
    "tokenizer.ggml.pre;s;smollm",
    "tokenizer.ggml.bos_token_id;u;1",
    "tokenizer.ggml.eos_token_id;u;2",
    "tokenizer.ggml.padding_token_id;u;2",
    "tokenizer.ggml.unknown_token_id;u;0",
    "tokenizer.ggml.add_bos_token;b;0",
    "tokenizer.ggml.add_space_prefix;b;0",
    "general.name;s;smollm2-fixture",
    "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM",
    "general.languages;as;en"
]

# Tensor codec: "name;type;d1,d2;offset" (offset auto = cumulative, or a
# literal relative offset for offset mutants). Q8_0 [32,16] = 512 elems =
# 544 B; F32 [16] = 64 B; Q4_K [256,16] = 4096 elems = 2304 B; total
# 2912 B, all 32-multiples (pinned-row property).
fixum lista<textus> LEGAL_TENSORES ← [
    "token_embd.weight;8;32,16;auto",
    "blk.0.attn_norm.weight;0;16;auto",
    "blk.0.ffn_down.weight;12;256,16;auto"
]

# -- byte helpers ---------------------------------------------------------

functio bytes(lista<numerus> vals) → lista<numerus<u8>> {
    varia lista<numerus<u8>> bs ← vacua
    itera ex vals fixum v {
        bs.appende(v ↦ numerus<u8>)
    }
    redde bs
}

functio octeti_bytes(textus s) → lista<numerus<u8>> {
    fixum octeti o ← s ↦ octeti
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < o.longitudo() {
        out.appende(o.accipe(i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    redde out
}

functio add(lista<numerus<u8>> acc, lista<numerus<u8>> piece) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    itera ex acc fixum byte {
        out.appende(byte)
    }
    itera ex piece fixum byte {
        out.appende(byte)
    }
    redde out
}

functio u32_le(numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    out.appende((n ⇒ 0) ↦ numerus<u8>)
    out.appende((n ⇒ 8) ↦ numerus<u8>)
    out.appende((n ⇒ 16) ↦ numerus<u8>)
    out.appende((n ⇒ 24) ↦ numerus<u8>)
    redde out
}

functio u64_le(numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    out.appende((n ⇒ 0) ↦ numerus<u8>)
    out.appende((n ⇒ 8) ↦ numerus<u8>)
    out.appende((n ⇒ 16) ↦ numerus<u8>)
    out.appende((n ⇒ 24) ↦ numerus<u8>)
    out.appende((n ⇒ 32) ↦ numerus<u8>)
    out.appende((n ⇒ 40) ↦ numerus<u8>)
    out.appende((n ⇒ 48) ↦ numerus<u8>)
    out.appende((n ⇒ 56) ↦ numerus<u8>)
    redde out
}

functio stringa(textus s) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← u64_le(s.longitudo())
    varia lista<numerus<u8>> body ← octeti_bytes(s)
    itera ex body fixum byte {
        out.appende(byte)
    }
    redde out
}

# textus → numerus (well-formed fixture strings; 0 on malformed).
functio numerus_a(textus s) → numerus {
    fac {
        fixum numerus v ← s ↦ numerus
        redde v
    }
    cape err {
        redde 0
    }
}

functio repetitio(textus s, numerus n) → textus {
    varia textus out ← ""
    varia numerus i ← 0
    dum i < n {
        out ← out + s
        i ← i + 1
    }
    redde out
}

# -- GGUF builders --------------------------------------------------------

# "key;type;value" → KV bytes (string | u32 | bool | array-of-string).
functio codex_kv(textus codex) → lista<numerus<u8>> {
    fixum lista<textus> partes ← codex.divide(";")
    fixum textus clavis ← partes.accipe(0) vel ""
    fixum textus typo ← partes.accipe(1) vel ""
    fixum textus valor ← partes.accipe(2) vel ""
    varia lista<numerus<u8>> out ← stringa(clavis)
    si typo ≡ "s" {
        out ← add(out, u32_le(8))
        out ← add(out, stringa(valor))
    }
    si typo ≡ "u" {
        out ← add(out, u32_le(4))
        out ← add(out, u32_le(numerus_a(valor)))
    }
    si typo ≡ "b" {
        out ← add(out, u32_le(7))
        si valor ≡ "1" {
            out.appende(1 ↦ numerus<u8>)
        }
        secus {
            out.appende(0 ↦ numerus<u8>)
        }
    }
    si typo ≡ "as" {
        out ← add(out, u32_le(9))
        out ← add(out, u32_le(8))
        fixum lista<textus> elems ← valor.divide(",")
        out ← add(out, u64_le(elems.longitudo()))
        itera ex elems fixum e {
            out ← add(out, stringa(e))
        }
    }
    redde out
}

# "name;type;d1,d2;offset" → tensor-info bytes (offset relative to the
# data-section start; auto = running cumulative).
functio codex_tensor(textus codex, numerus cursus) → lista<numerus<u8>> {
    fixum lista<textus> partes ← codex.divide(";")
    fixum textus nomen ← partes.accipe(0) vel ""
    fixum textus typo ← partes.accipe(1) vel ""
    fixum textus forma ← partes.accipe(2) vel ""
    fixum textus offset_s ← partes.accipe(3) vel "auto"
    varia lista<numerus<u8>> out ← stringa(nomen)
    fixum lista<textus> dims ← forma.divide(",")
    out ← add(out, u32_le(dims.longitudo()))
    itera ex dims fixum dd {
        out ← add(out, u64_le(numerus_a(dd)))
    }
    out ← add(out, u32_le(numerus_a(typo)))
    varia numerus off_val ← cursus
    si offset_s ≠ "auto" {
        off_val ← numerus_a(offset_s)
    }
    out ← add(out, u64_le(off_val))
    redde out
}

# Flat byte size of a tensor (block layout mirrors the admitted GGML
# table: F32 1/4, Q5_0 32/22, Q8_0 32/34, Q4_K 256/144, Q6_K 256/210).
functio tensor_magnitudo(textus codex) → numerus {
    fixum lista<textus> partes ← codex.divide(";")
    fixum numerus typo ← numerus_a(partes.accipe(1) vel "")
    fixum lista<textus> dims ← (partes.accipe(2) vel "").divide(",")
    varia numerus nelems ← 1
    itera ex dims fixum dd {
        nelems ← nelems * numerus_a(dd)
    }
    varia numerus blocci ← 1
    si typo ≡ 0 { blocci ← 1 }
    si typo ≡ 6 { blocci ← 32 }
    si typo ≡ 8 { blocci ← 32 }
    si typo ≡ 12 { blocci ← 256 }
    si typo ≡ 14 { blocci ← 256 }
    varia numerus octeti ← 1
    si typo ≡ 0 { octeti ← 4 }
    si typo ≡ 6 { octeti ← 22 }
    si typo ≡ 8 { octeti ← 34 }
    si typo ≡ 12 { octeti ← 144 }
    si typo ≡ 14 { octeti ← 210 }
    redde (nelems / blocci) * octeti
}

# Full GGUF v3 file from codec lists. extra_data appends trailing bytes to
# the data region (coverage mutants). Data section starts at align32(end
# of the tensor table); tensor offsets are cumulative relative.
functio aedifica(
    lista<numerus<u8>> magica,
    numerus versio,
    lista<textus> kvs,
    lista<textus> tensores,
    numerus extra_data
) → lista<numerus<u8>> {
    varia lista<numerus<u8>> f ← vacua
    itera ex magica fixum byte {
        f.appende(byte)
    }
    f ← add(f, u32_le(versio))
    f ← add(f, u64_le(tensores.longitudo()))
    f ← add(f, u64_le(kvs.longitudo()))
    itera ex kvs fixum k {
        f ← add(f, codex_kv(k))
    }
    # Tensor info table (offsets cumulative relative to data start).
    varia numerus cursus ← 0
    itera ex tensores fixum tt {
        f ← add(f, codex_tensor(tt, cursus))
        cursus ← cursus + tensor_magnitudo(tt)
    }
    # Data section at align32(end of table): pad bytes mirror the GGUF
    # writer and gen_fixture.py.
    fixum numerus finis_mensae ← f.longitudo()
    varia numerus data_inceptum ← finis_mensae
    si data_inceptum % 32 ≠ 0 {
        fixum numerus pad ← 32 - data_inceptum % 32
        varia numerus p ← 0
        dum p < pad {
            f.appende(0 ↦ numerus<u8>)
            p ← p + 1
        }
        data_inceptum ← data_inceptum + pad
    }
    varia numerus tot ← 0
    itera ex tensores fixum tt {
        tot ← tot + tensor_magnitudo(tt)
    }
    # Deterministic data pattern (mirrors gen_fixture.py): byte k of the
    # data region = (k*13 + 7) mod 256. Data content is not semantically
    # inspected by admission; the pattern makes the fixture byte-stable.
    varia numerus z ← 0
    dum z < tot + extra_data {
        f.appende(((z * 13 + 7) % 256) ↦ numerus<u8>)
        z ← z + 1
    }
    redde f
}

# The pinned legal fixture (scaled structural replica).
functio legitima() → lista<numerus<u8>> {
    redde aedifica(magica(), 3, LEGAL_KVS, LEGAL_TENSORES, 0)
}

# List replacement / removal for mutants.
functio repone(lista<textus> xs, textus veterem, textus novam) → lista<textus> {
    varia lista<textus> out ← vacua
    itera ex xs fixum x {
        si x ≡ veterem {
            out.appende(novam)
        }
        secus {
            out.appende(x)
        }
    }
    redde out
}

functio demptio(lista<textus> xs, textus veterem) → lista<textus> {
    varia lista<textus> out ← vacua
    itera ex xs fixum x {
        si x ≠ veterem {
            out.appende(x)
        }
    }
    redde out
}

# Byte mutation / truncation.
functio muta(lista<numerus<u8>> b, numerus off, numerus valor) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < b.longitudo() {
        si i ≡ off {
            out.appende(valor ↦ numerus<u8>)
        }
        secus {
            out.appende(b.accipe(i) vel (0 ∷ numerus<u8>))
        }
        i ← i + 1
    }
    redde out
}

functio excerpe(lista<numerus<u8>> b, numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < n {
        out.appende(b.accipe(i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    redde out
}

# -- admission outcome helpers --------------------------------------------

# Renders an admission outcome as textus ("ok" or the typed error's causa).
functio admissio_result(
    lista<numerus<u8>> bytes_f,
    textus digestio,
    numerus expectatum_kv,
    numerus expectatum_tensorum,
    numerus expectatum_elementa,
    numerus expectatum_f32,
    numerus expectatum_q4k,
    numerus expectatum_q5,
    numerus expectatum_q6,
    numerus expectatum_q8
) → textus {
    fac {
        fixum capsula.Capsula c ← gguf.admit(bytes_f, digestio, expectatum_kv, expectatum_tensorum, expectatum_elementa, expectatum_f32, expectatum_q4k, expectatum_q5, expectatum_q6, expectatum_q8)
        redde "ok"
    }
    cape err {
        redde gguf.causa(err)
    }
}

# Admission with the legal fixture's contract.
functio admissio_legitima(lista<numerus<u8>> bytes_f) → textus {
    redde admissio_result(bytes_f, F_DIGEST, F_KV, F_TENSORES, F_ELEMENTA, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
}

# Capsule-level verification outcomes ("ok" | the typed error's causa).
# Each helper wraps a single-error-type failable call so the happy-row
# probes keep one error class per fac/cape block (AdmissionError here —
# SEM010 hazard avoided; same seam as capsule.proba).
functio verifica_result(capsula.Capsula c) → textus {
    fac {
        fixum bivalens ok ← capsula.verifica(c)
        redde "ok"
    }
    cape err {
        redde "rejected"
    }
}

functio contra_result(capsula.Capsula c, textus expectatum) → textus {
    fac {
        fixum bivalens ok ← capsula.verifica_contra(c, expectatum)
        redde "ok"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Identity-wire round-trip against the oracle wire form (single error
# class: AdmissionError from serializa/deserializa).
functio roundtrip_oraculi(capsula.Capsula c, textus expectatum_wire) → bivalens {
    fac {
        fixum textus wire ← capsula.serializa_identitas(c)
        si wire ≠ expectatum_wire ergo redde falsum
        fixum capsula.Identitas i ← capsula.deserializa_identitas(wire)
        redde capsula.identitas_aequus(c.identia(), i)
    }
    cape err {
        redde falsum
    }
}

# -- happy path: the pinned legal fixture → schema-2 capsule --------------

probandum "gguf admission happy row" {
    proba "admission admits the pinned legal fixture" {
        fac {
            fixum capsula.Capsula c ← gguf.admit(legitima(), F_DIGEST, F_KV, F_TENSORES, F_ELEMENTA, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            # Schema stamp (capsule-schema-2.0.0).
            adfirma c.schematis() ≡ "2.0.0"
            # Pathless content identity (whole-file digest, host-computed;
            # the oracle value d89c9ef9…8f0974 of the pinned legal fixture
            # is carried, never recomputed by the parser).
            adfirma c.algorithmus() ≡ "sha-256"
            adfirma c.digestio() ≡ F_DIGEST
            adfirma c.longitudo() ≡ legitima().longitudo()
            # Per-format manifest (GGUF).
            adfirma c.formatum() ≡ "gguf"
            adfirma c.tensorum_numerus() ≡ 3
            adfirma c.manifestum_gguf() non est nihil
            # The compact schema-versioned identity record.
            adfirma c.identia().schematis() ≡ "2.0.0"
            adfirma c.identia().digestio() ≡ F_DIGEST
            adfirma c.identia().longitudo_bytes() ≡ legitima().longitudo()
        }
        cape err {
            adfirma falsum
        }
    }

    proba "verifica passes and verifica_contra matches the pinned digest" {
        fac {
            fixum capsula.Capsula c ← gguf.admit(legitima(), F_DIGEST, F_KV, F_TENSORES, F_ELEMENTA, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            adfirma verifica_result(c) ≡ "ok"
            adfirma contra_result(c, F_DIGEST) ≡ "ok"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the capsule identity matches the pinned-row oracle" {
        fac {
            fixum capsula.Capsula c ← gguf.admit(legitima(), F_DIGEST, F_KV, F_TENSORES, F_ELEMENTA, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            fixum numerus fl ← legitima().longitudo()
            # Oracle: capsule/identity/<schema>/sha-256/<digest>/<len> — the
            # fixture's oracle digest d89c9ef9…8f0974 is carried, never
            # reconstructed from the path (there is no path in schema 2).
            fixum textus wire ← "capsule/identity/2.0.0/sha-256/" + F_DIGEST + "/" + (fl ↦ textus)
            adfirma roundtrip_oraculi(c, wire)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "verifica_contra rejects a digest mismatch" {
        fac {
            fixum capsula.Capsula c ← gguf.admit(legitima(), F_DIGEST, F_KV, F_TENSORES, F_ELEMENTA, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            adfirma contra_result(c, F_ALIA) ≡ "digest mismatch — capsule does not match the expected artifact"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the data region tiles exactly (coverage_ok)" {
        # 2912 bytes of tensor data = 544 (Q8_0) + 64 (F32) + 2304 (Q4_K);
        # the fixture's data length equals file length minus data start.
        fac {
            fixum capsula.Capsula c ← gguf.admit(legitima(), F_DIGEST, F_KV, F_TENSORES, F_ELEMENTA, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            adfirma c.longitudo() ≡ legitima().longitudo()
            adfirma c.tensorum_numerus() ≡ 3
        }
        cape err {
            adfirma falsum
        }
    }
}

# -- negative matrix: format / version / header / counts ------------------

probandum "gguf negative matrix — format, version, counts" {
    proba "rejects bad magic" {
        adfirma admissio_legitima(aedifica(bytes([0x47, 0x47, 0x55, 0x58]), 3, LEGAL_KVS, LEGAL_TENSORES, 0)) ≡ "not a GGUF file — bad magic"
    }

    proba "rejects an unsupported GGUF version" {
        adfirma admissio_legitima(aedifica(magica(), 4, LEGAL_KVS, LEGAL_TENSORES, 0)) ≡ "unsupported GGUF version: 4"
    }

    proba "rejects a truncated header" {
        adfirma admissio_legitima(bytes([0x47, 0x47, 0x55, 0x46, 0, 0, 0, 3, 0, 0])) ≡ "truncated gguf header"
    }

    proba "rejects a u64 field above the integer carrier" {
        # Byte 15 = top byte of the tensor-count u64 (LE); 0xFF ≥ 2^63.
        adfirma admissio_legitima(muta(legitima(), 15, 255)) ≡ "GGUF UINT64 value exceeds the numerus carrier"
    }

    proba "rejects a metadata KV count mismatch" {
        adfirma admissio_result(legitima(), F_DIGEST, 17, F_TENSORES, F_ELEMENTA, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "metadata KV count mismatch"
    }

    proba "rejects a tensor count mismatch" {
        adfirma admissio_result(legitima(), F_DIGEST, F_KV, 2, F_ELEMENTA, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "tensor count mismatch"
    }

    proba "rejects expected kv count outside the admitted range" {
        adfirma admissio_result(legitima(), F_DIGEST, 0, F_TENSORES, F_ELEMENTA, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "expected kv count outside the admitted range"
    }

    proba "rejects expected tensor count outside the admitted range" {
        adfirma admissio_result(legitima(), F_DIGEST, F_KV, 100000, F_ELEMENTA, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "expected tensor count outside the admitted range"
    }

    proba "rejects expected element count above the ceiling" {
        adfirma admissio_result(legitima(), F_DIGEST, F_KV, F_TENSORES, 2000000000, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "expected element count outside the admitted range"
    }

    proba "rejects per-type counts that do not sum to the tensor count" {
        adfirma admissio_result(legitima(), F_DIGEST, F_KV, F_TENSORES, F_ELEMENTA, 2, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "expected tensor type counts do not sum to the tensor count"
    }
}

# -- negative matrix: metadata keys and values ----------------------------

probandum "gguf negative matrix — metadata" {
    proba "rejects an unknown metadata key" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.name;s;smollm2-fixture", "evil.key;s;x"), LEGAL_TENSORES, 0)) ≡ "unknown metadata key"
    }

    proba "rejects a duplicate metadata key" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM", "general.name;s;dup"), LEGAL_TENSORES, 0)) ≡ "duplicate GGUF metadata key: general.name"
    }

    proba "rejects a missing required key" {
        adfirma admissio_result(aedifica(magica(), 3, demptio(LEGAL_KVS, "general.architecture;s;llama"), LEGAL_TENSORES, 0), F_DIGEST, 17, F_TENSORES, F_ELEMENTA, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "missing required metadata key: general.architecture"
    }

    proba "rejects an architecture mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.architecture;s;llama", "general.architecture;s;qwen2"), LEGAL_TENSORES, 0)) ≡ "architecture mismatch"
    }

    proba "rejects a layer count mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.block_count;u;32", "llama.block_count;u;16"), LEGAL_TENSORES, 0)) ≡ "layer count mismatch"
    }

    proba "rejects a context length mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.context_length;u;8192", "llama.context_length;u;4096"), LEGAL_TENSORES, 0)) ≡ "context length mismatch"
    }

    proba "rejects a vocabulary size mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.vocab_size;u;49152", "llama.vocab_size;u;32000"), LEGAL_TENSORES, 0)) ≡ "vocabulary size mismatch"
    }

    proba "rejects an embedding size mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.embedding_length;u;960", "llama.embedding_length;u;512"), LEGAL_TENSORES, 0)) ≡ "embedding size mismatch"
    }

    proba "rejects a file type mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.file_type;u;15", "general.file_type;u;14"), LEGAL_TENSORES, 0)) ≡ "file type mismatch"
    }

    proba "rejects a quantization version mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.quantization_version;u;2", "general.quantization_version;u;1"), LEGAL_TENSORES, 0)) ≡ "quantization version mismatch"
    }

    proba "rejects a tokenizer model mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.model;s;gpt2", "tokenizer.ggml.model;s;tiktoken"), LEGAL_TENSORES, 0)) ≡ "tokenizer model mismatch"
    }

    proba "rejects a pre-tokenizer mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.pre;s;smollm", "tokenizer.ggml.pre;s;o200k"), LEGAL_TENSORES, 0)) ≡ "tokenizer pre-tokenizer mismatch"
    }

    proba "rejects a bos token id mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.bos_token_id;u;1", "tokenizer.ggml.bos_token_id;u;0"), LEGAL_TENSORES, 0)) ≡ "bos token id mismatch"
    }

    proba "rejects an eos token id mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.eos_token_id;u;2", "tokenizer.ggml.eos_token_id;u;1"), LEGAL_TENSORES, 0)) ≡ "eos token id mismatch"
    }

    proba "rejects a padding token id mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.padding_token_id;u;2", "tokenizer.ggml.padding_token_id;u;3"), LEGAL_TENSORES, 0)) ≡ "padding token id mismatch"
    }

    proba "rejects an unknown token id mismatch" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.unknown_token_id;u;0", "tokenizer.ggml.unknown_token_id;u;5"), LEGAL_TENSORES, 0)) ≡ "unknown token id mismatch"
    }

    proba "rejects add_bos_token set" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.add_bos_token;b;0", "tokenizer.ggml.add_bos_token;b;1"), LEGAL_TENSORES, 0)) ≡ "add_bos_token mismatch"
    }

    proba "rejects add_space_prefix set" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.add_space_prefix;b;0", "tokenizer.ggml.add_space_prefix;b;1"), LEGAL_TENSORES, 0)) ≡ "add_space_prefix mismatch"
    }

    proba "rejects a wrong metadata value type" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.file_type;u;15", "general.file_type;s;15"), LEGAL_TENSORES, 0)) ≡ "metadata value is not an unsigned integer"
    }

    proba "rejects a metadata key above the 128-byte ceiling" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.name;s;smollm2-fixture", repetitio("k", 130) + ";s;x"), LEGAL_TENSORES, 0)) ≡ "metadata key exceeds the 128-byte ceiling"
    }

    proba "rejects a string value above the authority text limit" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM", "tokenizer.chat_template;s;" + repetitio("v", 1048577)), LEGAL_TENSORES, 0)) ≡ "GGUF string exceeds the bounded text limit"
    }
}

# -- negative matrix: tensors, offsets, shapes, coverage ------------------

probandum "gguf negative matrix — tensors, offsets, shapes" {
    proba "rejects an unknown ggml tensor type" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "token_embd.weight;8;32,16;auto", "token_embd.weight;2;32,16;auto"), 0)) ≡ "unknown ggml tensor type"
    }

    proba "rejects an unsupported tensor rank" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;4,4,2;auto"), 0)) ≡ "unsupported tensor rank"
    }

    proba "rejects a dimension above the 65536 ceiling" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "token_embd.weight;8;32,16;auto", "token_embd.weight;8;65568,1;auto"), 0)) ≡ "invalid tensor dimension"
    }

    proba "rejects a zero dimension" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;0;auto"), 0)) ≡ "tensor dimension is outside the bounded range"
    }

    proba "rejects a tensor whose first dimension is not a complete GGML block" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "token_embd.weight;8;32,16;auto", "token_embd.weight;8;8,7;auto"), 0)) ≡ "tensor first dimension is not a complete GGML block"
    }

    proba "rejects overlapping/duplicate tensor offsets" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;16;300"), 0)) ≡ "known GGML tensor ranges overlap"
    }

    proba "rejects overlapping/duplicate tensor offsets at the data start" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;16;0"), 0)) ≡ "known GGML tensor ranges overlap"
    }

    proba "rejects a duplicate tensor name" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "token_embd.weight;8;32,16;auto"), 0)) ≡ "duplicate GGUF tensor name: token_embd.weight"
    }

    proba "rejects an empty tensor name" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", ";0;16;auto"), 0)) ≡ "empty tensor name"
    }

    proba "rejects a tensor name above the 128-byte ceiling" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", repetitio("w", 130) + ";0;16;auto"), 0)) ≡ "tensor name exceeds the 128-byte ceiling"
    }

    proba "rejects a total element count mismatch" {
        adfirma admissio_result(legitima(), F_DIGEST, F_KV, F_TENSORES, 4625, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "total element count mismatch"
    }

    proba "rejects a per-type tensor count mismatch" {
        adfirma admissio_result(legitima(), F_DIGEST, F_KV, F_TENSORES, F_ELEMENTA, F_F32, F_Q4K, 1, F_Q6, F_Q8) ≡ "tensor type count mismatch"
    }

    proba "rejects a truncated data region" {
        adfirma admissio_legitima(excerpe(legitima(), legitima().longitudo() - 100)) ≡ "known GGML tensor range exceeds the artifact"
    }

    proba "rejects trailing bytes in the data region" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, LEGAL_TENSORES, 100)) ≡ "data region does not tile exactly"
    }

    proba "rejects a truncated tensor table" {
        # Header + one KV + a partial tensor entry (name only, no fields).
        varia lista<numerus<u8>> f ← vacua
        itera ex magica() fixum byte {
            f.appende(byte)
        }
        f ← add(f, u32_le(3))
        f ← add(f, u64_le(1))
        f ← add(f, u64_le(1))
        f ← add(f, codex_kv("general.architecture;s;llama"))
        f ← add(f, stringa("a.b"))
        adfirma admissio_result(f, F_DIGEST, 1, 1, 1, 1, 0, 0, 0, 0) ≡ "range source failed: range read beyond the supplied bytes"
    }
}
