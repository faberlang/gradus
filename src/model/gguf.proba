+++
locale = "en"
+++
# Co-located package test for gguf.fab (PML2-U3 — GGUF row admission,
# capsule-schema-2.0.0, A1C-M2).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the fail-closed schema-2 GGUF admission (legal
# fixture → schema-2 capsule with pathless content identity + GGUF
# manifest), the typed rejection matrix across the pinned one-row contract
# (format/version/header, counts, metadata keys and pinned values, tensor
# shapes/offsets, coverage), and the authority boundary (wire/format
# rejections carry the manifest authority's typed message). assert
# assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
#
# NOTE (pinned-row facts): the pinned-row facts (byte length 270,590,880;
# tensor count 290; total elements 361,821,120; per-type counts F32 65 /
# Q4_K 16 / Q5_0 176 / Q6_K 16 / Q8_0 17; digest prefix 2fa3f013…bac9c2;
# metadata KV count 37; file_type 15; quantization version 2) are cited
# read-only from gi0-model-contract v1.0.0 / gi1-closeout.md. The LEGAL
# fixture is a scaled STRUCTURAL replica of the pinned row: the same
# admitted metadata values (arch llama / 32 / 8192 / 49152 / 960, gpt2 /
# smollm tokenizer, file_type 15, quant version 2, aligned 32) with a
# scaled tensor inventory (3 tensors: Q8_0 + F32 + Q4_K, exact block
# layouts). The whole-file SHA-256 is computed by the admission host
# (capsule.fab boundary) — the proba passes format-valid hex fixtures; the
# digest VALUE is asserted as carried identity.

import from "gradus:model/gguf" gguf
import from "gradus:model/capsule" capsule
import from "gradus:model/gguf_manifest" gguf_manifest
import from "gradus:model/artifact" artifact

# -- fixture contract (scaled structural replica of the pinned row) -------
# F_DIGEST is the real whole-file SHA-256 of the generated fixture
# `fixtures/gguf/smollm2-360m-scaled-row.gguf` (oracle, gguf-row-oracle.md;
# recompute with `shasum -a 256` — a re-pin is an operator decision). The
# pinned row's own digest is 2fa3f013…bac9c2 (gi1-closeout, read-only);
# the scaled fixture has its own hash and its own identity.
const string F_DIGEST = "d89c9ef917158bfb5600f417020479499c6c042f728e9a29c8457a6b1a8f0974"
const string F_ALT_DIGEST = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
const int F_KV = 18
const int F_TENSORS = 3
const int F_ELEMENTS = 4624
const int F_F32 = 1
const int F_Q4K = 1
const int F_Q5 = 0
const int F_Q6 = 0
const int F_Q8 = 1

# The GGUF magic, as bytes.
fn magica() → list<u8> {
    return bytes_of([71, 71, 85, 70])
}

# The 15 identity-bearing required keys + 3 optional admitted keys. KV
# codec: "key;type;value" (type s=string, u=u32, b=bool, as=array[string]).
const list<string> LEGAL_KVS = ["general.architecture;s;llama", "general.file_type;u;15", "general.quantization_version;u;2", "llama.block_count;u;32", "llama.context_length;u;8192", "llama.vocab_size;u;49152", "llama.embedding_length;u;960", "tokenizer.ggml.model;s;gpt2", "tokenizer.ggml.pre;s;smollm", "tokenizer.ggml.bos_token_id;u;1", "tokenizer.ggml.eos_token_id;u;2", "tokenizer.ggml.padding_token_id;u;2", "tokenizer.ggml.unknown_token_id;u;0", "tokenizer.ggml.add_bos_token;b;0", "tokenizer.ggml.add_space_prefix;b;0", "general.name;s;smollm2-fixture", "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM", "general.languages;as;en"]

# NumericBlock codec: "name;type;d1,d2;offset" (offset auto = cumulative, or a
# literal relative offset for offset mutants). Q8_0 [32,16] = 512 elems =
# 544 B; F32 [16] = 64 B; Q4_K [256,16] = 4096 elems = 2304 B; total
# 2912 B, all 32-multiples (pinned-row property).
const list<string> LEGAL_TENSORS = ["token_embd.weight;8;32,16;auto", "blk.0.attn_norm.weight;0;16;auto", "blk.0.ffn_down.weight;12;256,16;auto"]

# -- byte helpers ---------------------------------------------------------

fn bytes_of(list<int> vals) → list<u8> {
    var list<u8> bs ← empty
    for from vals const v {
        bs.append(v ↦ u8 ⊥ 0)
    }
    return bs
}

fn bytes_bytes(string s) → list<u8> {
    const bytes o ↤ s
    var list<u8> out ← empty
    for range 0‥o.length() const i {
        out.append(o.get(i) coalesce (0 ∷ u8))
    }
    return out
}

fn add(list<u8> acc, list<u8> piece) → list<u8> {
    var list<u8> out ← empty
    for from acc const byte {
        out.append(byte)
    }
    for from piece const byte {
        out.append(byte)
    }
    return out
}

fn u32_le(int n) → list<u8> {
    var list<u8> out ← empty
    out.append(((n ⇒ 0) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 8) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 16) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 24) ↦ wrapping<u8>) ↦ u8)
    return out
}

fn u64_le(int n) → list<u8> {
    var list<u8> out ← empty
    out.append(((n ⇒ 0) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 8) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 16) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 24) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 32) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 40) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 48) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 56) ↦ wrapping<u8>) ↦ u8)
    return out
}

fn stringa(string s) → list<u8> {
    var list<u8> out ← u64_le(s.length())
    var list<u8> body ← bytes_bytes(s)
    for from body const byte {
        out.append(byte)
    }
    return out
}

# text → number (well-formed fixture strings; 0 on malformed).
fn number_a(string s) → int {
    do {
        const int v ↤ s
        return v
    }
    catch err {
        return 0
    }
}

fn repeat(string s, int n) → string {
    var string out ← ""
    for range 0‥n const i {
        out ← out + s
    }
    return out
}

# -- GGUF builders --------------------------------------------------------

# "key;type;value" → KV bytes (string | u32 | bool | array-of-string).
fn kv_code(string code) → list<u8> {
    const list<string> partes ← code.split(";")
    const string key ← partes.get(0) coalesce ""
    const string kind ← partes.get(1) coalesce ""
    const string payload ← partes.get(2) coalesce ""
    var list<u8> out ← stringa(key)
    if kind ≡ "s" {
        out ← add(out, u32_le(8))
        out ← add(out, stringa(payload))
    }
    if kind ≡ "u" {
        out ← add(out, u32_le(4))
        out ← add(out, u32_le(number_a(payload)))
    }
    if kind ≡ "b" {
        out ← add(out, u32_le(7))
        if payload ≡ "1" {
            out.append(1 ↦ u8)
        }
        else {
            out.append(0 ↦ u8)
        }
    }
    if kind ≡ "as" {
        out ← add(out, u32_le(9))
        out ← add(out, u32_le(8))
        const list<string> elems ← payload.split(",")
        out ← add(out, u64_le(elems.length()))
        for from elems const e {
            out ← add(out, stringa(e))
        }
    }
    return out
}

# "name;type;d1,d2;offset" → tensor-info bytes (offset relative to the
# data-section start; auto = running cumulative).
fn code_tensor(string code, int cursor) → list<u8> {
    const list<string> partes ← code.split(";")
    const string name ← partes.get(0) coalesce ""
    const string kind ← partes.get(1) coalesce ""
    const string shape ← partes.get(2) coalesce ""
    const string offset_s ← partes.get(3) coalesce "auto"
    var list<u8> out ← stringa(name)
    const list<string> dims ← shape.split(",")
    out ← add(out, u32_le(dims.length()))
    for from dims const dd {
        out ← add(out, u64_le(number_a(dd)))
    }
    out ← add(out, u32_le(number_a(kind)))
    var int off_val ← cursor
    if offset_s ≠ "auto" {
        off_val ← number_a(offset_s)
    }
    out ← add(out, u64_le(off_val))
    return out
}

# Flat byte size of a tensor (block layout mirrors the admitted GGML
# table: F32 1/4, Q5_0 32/22, Q8_0 32/34, Q4_K 256/144, Q6_K 256/210).
fn tensor_extent(string code) → int {
    const list<string> partes ← code.split(";")
    const int kind ← number_a(partes.get(1) coalesce "")
    const list<string> dims ← (partes.get(2) coalesce "").split(",")
    var int nelems ← 1
    for from dims const dd {
        nelems ← nelems * number_a(dd)
    }
    var int blocks ← 1
    if kind ≡ 0 {
        blocks ← 1
    }
    if kind ≡ 6 {
        blocks ← 32
    }
    if kind ≡ 8 {
        blocks ← 32
    }
    if kind ≡ 12 {
        blocks ← 256
    }
    if kind ≡ 14 {
        blocks ← 256
    }
    var int bytes ← 1
    if kind ≡ 0 {
        bytes ← 4
    }
    if kind ≡ 6 {
        bytes ← 22
    }
    if kind ≡ 8 {
        bytes ← 34
    }
    if kind ≡ 12 {
        bytes ← 144
    }
    if kind ≡ 14 {
        bytes ← 210
    }
    return (nelems / blocks) * bytes
}

# Full GGUF v3 file from codec lists. extra_data appends trailing bytes to
# the data region (coverage mutants). Data section starts at align32(end
# of the tensor table); tensor offsets are cumulative relative.
fn aedifica(list<u8> magica, int version, list<string> kvs, list<string> tensors, int extra_data) → list<u8> {
    var list<u8> f ← empty
    for from magica const byte {
        f.append(byte)
    }
    f ← add(f, u32_le(version))
    f ← add(f, u64_le(tensors.length()))
    f ← add(f, u64_le(kvs.length()))
    for from kvs const k {
        f ← add(f, kv_code(k))
    }
    # NumericBlock info table (offsets cumulative relative to data start).
    var int cursor ← 0
    for from tensors const tt {
        f ← add(f, code_tensor(tt, cursor))
        cursor ← cursor + tensor_extent(tt)
    }
    # Data section at align32(end of table): pad bytes mirror the GGUF
    # writer and gen_fixture.py.
    const int table_end ← f.length()
    var int data_start ← table_end
    if data_start % 32 ≠ 0 {
        const int pad ← 32 - data_start % 32
        var int p ← 0
        while p ≺ pad {
            f.append(0 ↦ u8)
            p ← p + 1
        }
        data_start ← data_start + pad
    }
    var int tot ← 0
    for from tensors const tt {
        tot ← tot + tensor_extent(tt)
    }
    # Deterministic data pattern (mirrors gen_fixture.py): byte k of the
    # data region = (k*13 + 7) mod 256. Data content is not semantically
    # inspected by admission; the pattern makes the fixture byte-stable.
    var int z ← 0
    while z ≺ tot + extra_data {
        f.append(((z * 13 + 7) % 256) ↦ u8)
        z ← z + 1
    }
    return f
}

# The pinned legal fixture (scaled structural replica).
fn legal() → list<u8> {
    return aedifica(magica(), 3, LEGAL_KVS, LEGAL_TENSORS, 0)
}

# List replacement / removal for mutants.
fn repone(list<string> xs, string veterem, string novam) → list<string> {
    var list<string> out ← empty
    for from xs const x {
        if x ≡ veterem {
            out.append(novam)
        }
        else {
            out.append(x)
        }
    }
    return out
}

fn demptio(list<string> xs, string veterem) → list<string> {
    var list<string> out ← empty
    for from xs const x {
        if x ≠ veterem {
            out.append(x)
        }
    }
    return out
}

# Byte mutation / truncation.
fn mutate(list<u8> b, int off, int payload) → list<u8> {
    var list<u8> out ← empty
    for range 0‥b.length() const i {
        if i ≡ off {
            out.append(payload ↦ u8 ⊥ 0)
        }
        else {
            out.append(b.get(i) coalesce (0 ∷ u8))
        }
    }
    return out
}

fn excerpt(list<u8> b, int n) → list<u8> {
    var list<u8> out ← empty
    for range 0‥n const i {
        out.append(b.get(i) coalesce (0 ∷ u8))
    }
    return out
}

# -- admission outcome helpers --------------------------------------------

# Renders an admission outcome as text ("ok" or the typed error's message).
fn admission_result(list<u8> bytes_f, string digest, int expected_kv, int expected_tensors, int expected_elements, int expected_f32, int expected_q4k, int expected_q5, int expected_q6, int expected_q8) → string {
    do {
        const capsule.Capsule c ← gguf.admit(bytes_f, digest, bytes_f.length(), 15, 2, expected_kv, expected_tensors, expected_elements, expected_f32, expected_q4k, expected_q5, expected_q6, expected_q8)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# Admission with the legal fixture's contract.
fn legal_admission(list<u8> bytes_f) → string {
    return admission_result(bytes_f, F_DIGEST, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
}

# Capsule-level verification outcomes ("ok" | the typed error's message).
# Each helper wraps a single-error-type failable call so the happy-row
# probes keep one error class per fac/cape block (AdmissionError here —
# SEM010 hazard avoided; same seam as capsule.proba).
fn verify_result(capsule.Capsule c) → string {
    do {
        const bool ok ← capsule.verify(c)
        return "ok"
    }
    catch err {
        return "rejected"
    }
}

fn against_result(capsule.Capsule c, string expected) → string {
    do {
        const bool ok ← capsule.verify_against(c, expected)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# Identity-wire round-trip against the oracle wire form (single error
# class: AdmissionError from serializa/deserialize).
fn roundtrip_oraculi(capsule.Capsule c, string expected_wire) → bool {
    do {
        const string wire ← capsule.serialize_identity(c)
        if wire ≠ expected_wire then return false
        const capsule.Identity i ← capsule.deserialize_identity(wire)
        return capsule.identity_equal(c.identity(), i)
    }
    catch err {
        return false
    }
}

# -- happy path: the pinned legal fixture → schema-2 capsule --------------

describe "gguf admission happy row" {
    test "admission admits the pinned legal fixture" {
        do {
            const capsule.Capsule c ← gguf.admit(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            # Schema stamp (capsule-schema-2.0.0).
            assert c.schema ≡ "2.0.0"
            # Pathless content identity (whole-file digest, host-computed;
            # the oracle value d89c9ef9…8f0974 of the pinned legal fixture
            # is carried, never recomputed by the parser).
            assert c.algorithm() ≡ "sha-256"
            assert c.digest() ≡ F_DIGEST
            assert c.length() ≡ legal().length()
            # Per-format manifest (GGUF).
            assert c.format() ≡ "gguf"
            assert c.tensor_count() ≡ 3
            # The compact schema-versioned identity record.
            assert c.identity().schema ≡ "2.0.0"
            assert c.identity().digest ≡ F_DIGEST
            assert c.identity().byte_length ≡ legal().length()
        }
        catch err {
            assert false
        }
    }
    test "verify passes and verify_against matches the pinned digest" {
        do {
            const capsule.Capsule c ← gguf.admit(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            assert verify_result(c) ≡ "ok"
            assert against_result(c, F_DIGEST) ≡ "ok"
        }
        catch err {
            assert false
        }
    }
    test "the capsule identity matches the pinned-row oracle" {
        do {
            const capsule.Capsule c ← gguf.admit(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            const int fl ← legal().length()
            # Oracle: capsule/identity/<schema>/sha-256/<digest>/<len> — the
            # fixture's oracle digest d89c9ef9…8f0974 is carried, never
            # reconstructed from the path (there is no path in schema 2).
            const string wire ← "capsule/identity/2.0.0/sha-256/§/§"(F_DIGEST, fl ↦ string)
            assert roundtrip_oraculi(c, wire)
        }
        catch err {
            assert false
        }
    }
    test "verify_against rejects a digest mismatch" {
        do {
            const capsule.Capsule c ← gguf.admit(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            assert against_result(c, F_ALT_DIGEST) ≡ "digest mismatch — capsule does not match the expected artifact"
        }
        catch err {
            assert false
        }
    }
    test "the data region tiles exactly (coverage_ok)" {
        # 2912 bytes of tensor data = 544 (Q8_0) + 64 (F32) + 2304 (Q4_K);
        # the fixture's data length equals file length minus data start.
        do {
            const capsule.Capsule c ← gguf.admit(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            assert c.length() ≡ legal().length()
            assert c.tensor_count() ≡ 3
        }
        catch err {
            assert false
        }
    }
}

# -- negative matrix: format / version / header / counts ------------------

describe "gguf negative matrix — format, version, counts" {
    test "rejects bad magic" {
        assert legal_admission(aedifica(bytes_of([71, 71, 85, 88]), 3, LEGAL_KVS, LEGAL_TENSORS, 0)) ≡ "not a GGUF file — bad magic"
    }
    test "rejects an unsupported GGUF version" {
        assert legal_admission(aedifica(magica(), 4, LEGAL_KVS, LEGAL_TENSORS, 0)) ≡ "unsupported GGUF version: 4"
    }
    test "rejects a truncated header" {
        assert legal_admission(bytes_of([71, 71, 85, 70, 0, 0, 0, 3, 0, 0])) ≡ "truncated gguf header"
    }
    test "rejects a u64 field above the integer carrier" {
        # Byte 15 = top byte of the tensor-count u64 (LE); 0xFF ≥ 2^63.
        assert legal_admission(mutate(legal(), 15, 255)) ≡ "GGUF UINT64 value exceeds the numeric carrier"
    }
    test "rejects a metadata KV count mismatch" {
        assert admission_result(legal(), F_DIGEST, 17, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "metadata KV count mismatch"
    }
    test "rejects a tensor count mismatch" {
        assert admission_result(legal(), F_DIGEST, F_KV, 2, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, 0) ≡ "tensor count mismatch"
    }
    test "rejects expected kv count outside the admitted range" {
        assert admission_result(legal(), F_DIGEST, 0, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "expected kv count outside the admitted range"
    }
    test "rejects expected tensor count outside the admitted range" {
        assert admission_result(legal(), F_DIGEST, F_KV, 100000, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "expected tensor count outside the admitted range"
    }
    test "treats a large expected element count as a caller fact" {
        assert admission_result(legal(), F_DIGEST, F_KV, F_TENSORS, 2000000000, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "total element count mismatch"
    }
    test "rejects per-type counts that do not sum to the tensor count" {
        assert admission_result(legal(), F_DIGEST, F_KV, F_TENSORS, F_ELEMENTS, 2, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "expected tensor type counts do not sum to the tensor count"
    }
}

# -- negative matrix: metadata keys and values ----------------------------

describe "gguf negative matrix — metadata" {
    test "rejects an unknown metadata key" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "general.name;s;smollm2-fixture", "evil.key;s;x"), LEGAL_TENSORS, 0)) ≡ "unknown metadata key"
    }
    test "rejects a duplicate metadata key" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM", "general.name;s;dup"), LEGAL_TENSORS, 0)) ≡ "duplicate GGUF metadata key: general.name"
    }
    test "rejects a missing required key" {
        assert admission_result(aedifica(magica(), 3, demptio(LEGAL_KVS, "general.architecture;s;llama"), LEGAL_TENSORS, 0), F_DIGEST, 17, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "missing required metadata key: general.architecture"
    }
    test "rejects an architecture mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "general.architecture;s;llama", "general.architecture;s;qwen2"), LEGAL_TENSORS, 0)) ≡ "architecture mismatch"
    }
    test "rejects a layer count mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.block_count;u;32", "llama.block_count;u;16"), LEGAL_TENSORS, 0)) ≡ "layer count mismatch"
    }
    test "rejects a context length mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.context_length;u;8192", "llama.context_length;u;4096"), LEGAL_TENSORS, 0)) ≡ "context length mismatch"
    }
    test "rejects a vocabulary size mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.vocab_size;u;49152", "llama.vocab_size;u;32000"), LEGAL_TENSORS, 0)) ≡ "vocabulary size mismatch"
    }
    test "rejects an embedding size mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.embedding_length;u;960", "llama.embedding_length;u;512"), LEGAL_TENSORS, 0)) ≡ "embedding size mismatch"
    }
    test "rejects a file type mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "general.file_type;u;15", "general.file_type;u;14"), LEGAL_TENSORS, 0)) ≡ "file type mismatch"
    }
    test "rejects a quantization version mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "general.quantization_version;u;2", "general.quantization_version;u;1"), LEGAL_TENSORS, 0)) ≡ "quantization version mismatch"
    }
    test "rejects a tokenizer model mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.model;s;gpt2", "tokenizer.ggml.model;s;tiktoken"), LEGAL_TENSORS, 0)) ≡ "tokenizer model mismatch"
    }
    test "rejects a pre-tokenizer mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.pre;s;smollm", "tokenizer.ggml.pre;s;o200k"), LEGAL_TENSORS, 0)) ≡ "tokenizer pre-tokenizer mismatch"
    }
    test "rejects a bos token id mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.bos_token_id;u;1", "tokenizer.ggml.bos_token_id;u;0"), LEGAL_TENSORS, 0)) ≡ "bos token id mismatch"
    }
    test "rejects an eos token id mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.eos_token_id;u;2", "tokenizer.ggml.eos_token_id;u;1"), LEGAL_TENSORS, 0)) ≡ "eos token id mismatch"
    }
    test "rejects a padding token id mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.padding_token_id;u;2", "tokenizer.ggml.padding_token_id;u;3"), LEGAL_TENSORS, 0)) ≡ "padding token id mismatch"
    }
    test "rejects an unknown token id mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.unknown_token_id;u;0", "tokenizer.ggml.unknown_token_id;u;5"), LEGAL_TENSORS, 0)) ≡ "unknown token id mismatch"
    }
    test "rejects add_bos_token set" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.add_bos_token;b;0", "tokenizer.ggml.add_bos_token;b;1"), LEGAL_TENSORS, 0)) ≡ "add_bos_token mismatch"
    }
    test "rejects add_space_prefix set" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.add_space_prefix;b;0", "tokenizer.ggml.add_space_prefix;b;1"), LEGAL_TENSORS, 0)) ≡ "add_space_prefix mismatch"
    }
    test "rejects a wrong metadata value type" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "general.file_type;u;15", "general.file_type;s;15"), LEGAL_TENSORS, 0)) ≡ "metadata value is not an unsigned integer"
    }
    test "rejects a metadata key above the 128-byte ceiling" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "general.name;s;smollm2-fixture", repeat("k", 130) + ";s;x"), LEGAL_TENSORS, 0)) ≡ "metadata key exceeds the 128-byte ceiling"
    }
    test "rejects a string value above the authority text limit" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM", "tokenizer.chat_template;s;§"(repeat("v", 1048577))), LEGAL_TENSORS, 0)) ≡ "GGUF string exceeds the bounded text limit"
    }
}

# -- negative matrix: tensors, offsets, shapes, coverage ------------------

describe "gguf negative matrix — tensors, offsets, shapes" {
    test "rejects an unknown ggml tensor type" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "token_embd.weight;8;32,16;auto", "token_embd.weight;2;32,16;auto"), 0)) ≡ "unknown ggml tensor type"
    }
    test "rejects an unsupported tensor rank" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;4,4,2;auto"), 0)) ≡ "unsupported tensor rank"
    }
    test "rejects a zero dimension" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;0;auto"), 0)) ≡ "tensor dimension must be positive"
    }
    test "rejects a tensor whose first dimension is not a complete GGML block" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "token_embd.weight;8;32,16;auto", "token_embd.weight;8;8,7;auto"), 0)) ≡ "tensor first dimension is not a complete GGML block"
    }
    test "rejects overlapping/duplicate tensor offsets" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;16;300"), 0)) ≡ "known GGML tensor ranges overlap"
    }
    test "rejects overlapping/duplicate tensor offsets at the data start" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;16;0"), 0)) ≡ "known GGML tensor ranges overlap"
    }
    test "rejects a duplicate tensor name" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", "token_embd.weight;8;32,16;auto"), 0)) ≡ "duplicate GGUF tensor name: token_embd.weight"
    }
    test "rejects an empty tensor name" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", ";0;16;auto"), 0)) ≡ "empty tensor name"
    }
    test "rejects a tensor name above the 128-byte ceiling" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", repeat("w", 130) + ";0;16;auto"), 0)) ≡ "tensor name exceeds the 128-byte ceiling"
    }
    test "rejects a total element count mismatch" {
        assert admission_result(legal(), F_DIGEST, F_KV, F_TENSORS, 4625, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "total element count mismatch"
    }
    test "rejects a per-type tensor count mismatch" {
        assert admission_result(legal(), F_DIGEST, F_KV, F_TENSORS, F_ELEMENTS, F_F32, 0, 1, F_Q6, F_Q8) ≡ "tensor type count mismatch"
    }
    test "rejects a truncated data region" {
        assert legal_admission(excerpt(legal(), legal().length() - 100)) ≡ "known GGML tensor range exceeds the artifact"
    }
    test "rejects trailing bytes in the data region" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, LEGAL_TENSORS, 100)) ≡ "data region does not tile exactly"
    }
    test "rejects a truncated tensor table" {
        # Header + one KV + a partial tensor entry (name only, no fields).
        var list<u8> f ← empty
        for from magica() const byte {
            f.append(byte)
        }
        f ← add(f, u32_le(3))
        f ← add(f, u64_le(1))
        f ← add(f, u64_le(1))
        f ← add(f, kv_code("general.architecture;s;llama"))
        f ← add(f, stringa("a.b"))
        assert admission_result(f, F_DIGEST, 1, 1, 1, 1, 0, 0, 0, 0) ≡ "range source request exceeds the artifact"
    }
}

# -- header-prefix admission: explicit artifact length --------------------
# F32-shaped fixture: file_type 0, padding id 0, the two optional attention
# keys, and two F32 tensors (512 + 16 elements, 2112 data bytes).
const list<string> F32_TENSORS = ["token_embd.weight;0;32,16;auto", "blk.0.attn_norm.weight;0;16;auto"]
const string F32_DIGEST = "07735177a3542cbc0b0665051ce1922b55c4c9698de65131e65f2aea87a935e0"

fn f32_kvs() → list<string> {
    var list<string> kvs ← repone(LEGAL_KVS, "general.file_type;u;15", "general.file_type;u;0")
    kvs ← repone(kvs, "tokenizer.ggml.padding_token_id;u;2", "tokenizer.ggml.padding_token_id;u;0")
    kvs.append("llama.attention.key_length;u;64")
    kvs.append("llama.attention.value_length;u;64")
    return kvs
}

fn f32_file() → list<u8> {
    return aedifica(magica(), 3, f32_kvs(), F32_TENSORS, 0)
}

# The header prefix: everything before the data region.
fn f32_prefix() → list<u8> {
    return excerpt(f32_file(), f32_file().length() - 2112)
}

fn prefix_result(list<u8> prefix, int artifact_length, int file_type, int pad_id) → string {
    do {
        const capsule.Capsule c ← gguf.admit(prefix, F32_DIGEST, artifact_length, file_type, pad_id, 20, 2, 528, 2, 0, 0, 0, 0)
        return "ok"
    }
    catch err {
        return err.message
    }
}

describe "gguf header-prefix admission" {
    test "the whole F32-shaped file admits with file type 0 and pad id 0" {
        assert prefix_result(f32_file(), f32_file().length(), 0, 0) ≡ "ok"
    }
    test "a header prefix admits against the whole-file artifact length" {
        assert prefix_result(f32_prefix(), f32_file().length(), 0, 0) ≡ "ok"
        do {
            const capsule.Capsule c ← gguf.admit(f32_prefix(), F32_DIGEST, f32_file().length(), 0, 0, 20, 2, 528, 2, 0, 0, 0, 0)
            assert c.length() ≡ f32_file().length()
            assert c.tensor_count() ≡ 2
        }
        catch err {
            assert false
        }
    }
    test "a tensor range beyond the artifact length is refused" {
        assert prefix_result(f32_prefix(), f32_file().length() - 100, 0, 0) ≡ "known GGML tensor range exceeds the artifact"
    }
    test "a data region longer than the tensors is refused" {
        assert prefix_result(f32_prefix(), f32_file().length() + 32, 0, 0) ≡ "data region does not tile exactly"
    }
    test "a prefix that ends inside the tensor table fails closed past the prefix" {
        assert prefix_result(excerpt(f32_prefix(), f32_prefix().length() - 40), f32_file().length(), 0, 0) ≡ "range read beyond the supplied bytes"
    }
    test "an artifact length shorter than the supplied bytes is refused" {
        assert prefix_result(f32_file(), f32_file().length() - 1, 0, 0) ≡ "artifact length is shorter than the supplied bytes"
    }
    test "the expected file type and pad id are enforced" {
        assert prefix_result(f32_prefix(), f32_file().length(), 15, 0) ≡ "file type mismatch"
        assert prefix_result(f32_prefix(), f32_file().length(), 0, 2) ≡ "padding token id mismatch"
    }
}

# -- admit_with_manifest: the manifest rides with the capsule --------------

# Range source over the supplied bytes (the same shape admit hands the
# authority); a read beyond the bytes fails the read.
fn manifest_source(list<u8> b, int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    reject ((start ≺ 0 or length ≺ 0) or start ≻ b.length() - length) throw variant BadSource {message = "range read beyond the supplied bytes"}
    const list<u8> segment ← b.slice(start, start + length)
    return segment ↦ bytes
}

# The fixture's manifest straight from the authority, with admit's identity.
# A failed inspect yields a version -1 marker the rows assert against, so
# each row's do-block keeps one error class (SEM010).
fn authority_manifest(list<u8> b) → gguf_manifest.GgufManifest {
    const artifact.ContentIdentity identity ← artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = b.length()}
    do {
        return gguf_manifest.inspect((int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ manifest_source(b, start, length), b.length(), identity)
    }
    catch err {
        return gguf_manifest.GgufManifest {identity = identity, version = -1, alignment = 0, data_start = 0, artifact_length = 0, metadata = [], tensors = []}
    }
}

# Outcome of the new entry with the legal fixture's contract.
fn with_manifest_result(list<u8> b, int artifact_length, int expected_tensors) → string {
    do {
        const gguf.Admission a ← gguf.admit_with_manifest(b, F_DIGEST, artifact_length, 15, 2, F_KV, expected_tensors, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
        return "ok"
    }
    catch err {
        return err.message
    }
}

describe "gguf admit_with_manifest" {
    test "the returned manifest equals the authority's inspect of the same bytes" {
        do {
            const gguf.Admission a ← gguf.admit_with_manifest(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            const gguf_manifest.GgufManifest want ← authority_manifest(legal())
            assert want.version ≡ 3
            const gguf_manifest.GgufManifest got ← a.manifest
            assert got.identity.algorithm ≡ want.identity.algorithm
            assert got.identity.digest ≡ want.identity.digest
            assert got.identity.length ≡ want.identity.length
            assert got.version ≡ want.version
            assert got.alignment ≡ want.alignment
            assert got.data_start ≡ want.data_start
            assert got.artifact_length ≡ want.artifact_length
            assert got.metadata.length() ≡ want.metadata.length()
            assert got.tensors.length() ≡ want.tensors.length()
            assert got.metadata.length() ≡ F_KV
            assert got.tensors.length() ≡ F_TENSORS
            for range 0‥want.metadata.length() const i {
                assert got.metadata[i].key ≡ want.metadata[i].key
                assert got.metadata[i].dtype ≡ want.metadata[i].dtype
            }
            for range 0‥want.tensors.length() const i {
                assert got.tensors[i].name ≡ want.tensors[i].name
                assert got.tensors[i].dtype_ggml ≡ want.tensors[i].dtype_ggml
                assert got.tensors[i].elements ≡ want.tensors[i].elements
                assert got.tensors[i].relative_offset ≡ want.tensors[i].relative_offset
            }
        }
        catch err {
            assert false
        }
    }
    test "the returned capsule equals what admit returns for the same input" {
        do {
            const gguf.Admission a ← gguf.admit_with_manifest(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            const capsule.Capsule c ← gguf.admit(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            assert a.cap.schema ≡ c.schema
            assert a.cap.digest() ≡ c.digest()
            assert a.cap.length() ≡ c.length()
            assert a.cap.format() ≡ c.format()
            assert a.cap.tensor_count() ≡ c.tensor_count()
            assert capsule.identity_equal(a.cap.identity(), c.identity())
        }
        catch err {
            assert false
        }
    }
    test "the manifest identity is the admitted digest and artifact length" {
        do {
            const gguf.Admission a ← gguf.admit_with_manifest(f32_prefix(), F32_DIGEST, f32_file().length(), 0, 0, 20, 2, 528, 2, 0, 0, 0, 0)
            assert a.manifest.identity.algorithm ≡ "sha-256"
            assert a.manifest.identity.digest ≡ F32_DIGEST
            assert a.manifest.identity.length ≡ f32_file().length()
            assert a.manifest.artifact_length ≡ f32_file().length()
        }
        catch err {
            assert false
        }
    }
    test "rejects a truncated header" {
        assert with_manifest_result(bytes_of([71, 71, 85, 70, 0, 0, 0, 3, 0, 0]), 10, F_TENSORS) ≡ "truncated gguf header"
    }
    test "rejects bad magic" {
        const list<u8> bad ← aedifica(bytes_of([71, 71, 85, 88]), 3, LEGAL_KVS, LEGAL_TENSORS, 0)
        assert with_manifest_result(bad, bad.length(), F_TENSORS) ≡ "not a GGUF file — bad magic"
    }
    test "rejects an artifact length shorter than the supplied bytes" {
        assert with_manifest_result(legal(), legal().length() - 1, F_TENSORS) ≡ "artifact length is shorter than the supplied bytes"
    }
    test "rejects a tensor count mismatch" {
        assert with_manifest_result(legal(), legal().length(), 2) ≡ "expected tensor type counts do not sum to the tensor count"
    }
    test "rejects a data region that does not tile to the artifact length" {
        assert with_manifest_result(legal(), legal().length() + 32, F_TENSORS) ≡ "data region does not tile exactly"
    }
}
