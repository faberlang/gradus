+++ toml
locale = "en"

+++ faber
# ModelConfig — fail-closed JSON parser for HuggingFace/MLX `config.json` and
# `quant_config` artifacts (unblocks Slice A #52 and heterogeneous models).
#
# Public import: import from "gradus:model/config" cfg
#
# --- Contract ------------------------------------------------------------
#
# Parses standard `config.json` and `quantization` / `hf_quant_config.json`
# payloads into typed `ModelConfig` and `QuantConfig` records without
# hardcoding model dimensions. Unknown fields (such as `architectures`,
# `torch_dtype`, `rope_scaling`, etc.) are safely skipped so real HF/MLX
# configs admit directly, while malformed JSON, missing required fields, or
# non-positive dimensions fail closed.

@ public
union ConfigError {
    @ shared
    string message

    BadJson,
    MissingField,
    BadType,
    BadValue
}

@ public
class QuantConfig {
    let string ∪ none mode
    let int ∪ none bits
    let int ∪ none group_size
}

@ public
class TensorQuantOverride {
    let string pattern
    let string ∪ none quant_algo
    let int ∪ none bits
    let int ∪ none group_size
    let bool excluded = false
}

@ public
class HfQuantConfig {
    let QuantConfig base
    let list<string> exclude_modules = []
    let list<TensorQuantOverride> overrides = []
}

@ public
class ModelConfig {
    let string model_type
    let int hidden_size
    let int num_hidden_layers
    let int num_attention_heads
    let int num_key_value_heads
    let int head_dim
    let int intermediate_size
    let int vocab_size
    let int max_position_embeddings
    let f32 rms_norm_eps
    let f32 rope_theta
    let bool tie_word_embeddings
    let int ∪ none sliding_window
    let int ∪ none full_attention_interval
    let list<string> layer_types
    let list<bool> rope_pattern
    let int kv_key_bits
    let int kv_value_bits
    let int kv_group_size
    let QuantConfig ∪ none quantization
    # Flint optional fields
    let list<int> mlp_only_layers = []
    let int ∪ none leading_dense_block_count = null
    let string ∪ none softmax_type = null
    let int ∪ none num_local_experts = null
    let int ∪ none num_experts_per_tok = null
    let int ∪ none num_shared_experts = null
    let string ∪ none expert_gating_func = null
    let bool ∪ none norm_topk_prob = null
    # Qwen3.6 optional fields
    let list<int> rope_dimension_sections = []
    let int ∪ none ssm_conv_kernel = null
    let int ∪ none ssm_state_size = null
    let int ∪ none ssm_group_count = null
    let int ∪ none ssm_time_step_rank = null
    let int ∪ none ssm_inner_size = null
    # Inkling optional fields
    let int ∪ none loop_core_start = null
    let int ∪ none loop_core_end = null
    let int ∪ none loop_num_passes = null
    let int ∪ none loop_gate_rank = null
    let bool is_varloop = false
    let int ∪ none n_layers_per_attn_res_block = null
    let int ∪ none unpadded_vocab_size = null
    let f32 ∪ none mlp_gate_softcap = null
    let f32 ∪ none mlp_up_softcap = null
    let f32 ∪ none final_logit_softcap = null
    # DFlash optional fields
    let list<int> target_layers = []
    let int ∪ none block_size = null
    let bool has_markov_context = false
    # MoE / Qwen2.5 / Inkling / Quantization optional fields
    let int ∪ none moe_intermediate_size = null
    let int ∪ none shared_expert_intermediate_size = null
    let f32 ∪ none route_scale = null
    let bool ∪ none attention_bias = null
    let bool ∪ none qkv_bias = null
    let HfQuantConfig ∪ none hf_quantization = null
}

# -------------------------------------------------------------------------
# Minimal fail-closed JSON parser
# -------------------------------------------------------------------------

class JsonEntry {
    let string key
    let JsonValue val
}

union JsonValue {
    JNull,
    JBool {
        bool value
    },
    JNum {
        string raw
    },
    JStr {
        string value
    },
    JArr {
        list<JsonValue> items
    },
    JObj {
        list<JsonEntry> entries
    }
}

class ParseResult {
    let JsonValue val
    let int next_pos
}

class StrResult {
    let string text
    let int next_pos
}

fn is_ws(string ch) → bool {
    return ch ≡ " " or ch ≡ "\n" or ch ≡ "\r" or ch ≡ "\t"
}

fn is_digit(string ch) → bool {
    return ch ≡ "0" or ch ≡ "1" or ch ≡ "2" or ch ≡ "3" or ch ≡ "4" or ch ≡ "5" or ch ≡ "6" or ch ≡ "7" or ch ≡ "8" or ch ≡ "9"
}

fn is_hex(string ch) → bool {
    return is_digit(ch) or ch ≡ "a" or ch ≡ "b" or ch ≡ "c" or ch ≡ "d" or ch ≡ "e" or ch ≡ "f" or ch ≡ "A" or ch ≡ "B" or ch ≡ "C" or ch ≡ "D" or ch ≡ "E" or ch ≡ "F"
}

fn skip_ws(string src, int start) → int {
    mut int i ← start
    let int n ← src.length()
    while i ≺ n {
        let string ch ← src.slice(i, i + 1)
        if is_ws(ch) {
            i ← i + 1
        }
        else {
            return i
        }
    }
    return i
}

fn hex_val(string ch) → int ⇥ ConfigError {
    let string lower ← "0123456789abcdef"
    let string upper ← "0123456789ABCDEF"
    for exclusive 16 let idx {
        if lower.slice(idx, idx + 1) ≡ ch or upper.slice(idx, idx + 1) ≡ ch {
            return idx
        }
    }
    throw variant BadJson { message = "invalid hex digit in \\uXXXX escape" }
}

fn decode_hex4(string src, int start) → int ⇥ ConfigError {
    mut int acc ← 0
    for exclusive 4 let h {
        let int d ← hex_val(src.slice(start + h, start + h + 1))
        acc ← acc * 16 + d
    }
    return acc
}

fn encode_codepoint_utf8(int cp) → string ⇥ ConfigError {
    mut list<b8> bytes ← empty
    if cp ≤ 0x7F {
        bytes.append((cp ↦ u8 ⊥ (0 ∷ u8)) ↦ b8)
    }
    elif cp ≤ 0x7FF {
        bytes.append(((0xC0 ∨ (cp ⇒ 6)) ↦ u8 ⊥ (0 ∷ u8)) ↦ b8)
        bytes.append(((0x80 ∨ (cp ∧ 0x3F)) ↦ u8 ⊥ (0 ∷ u8)) ↦ b8)
    }
    elif cp ≤ 0xFFFF {
        bytes.append(((0xE0 ∨ (cp ⇒ 12)) ↦ u8 ⊥ (0 ∷ u8)) ↦ b8)
        bytes.append(((0x80 ∨ ((cp ⇒ 6) ∧ 0x3F)) ↦ u8 ⊥ (0 ∷ u8)) ↦ b8)
        bytes.append(((0x80 ∨ (cp ∧ 0x3F)) ↦ u8 ⊥ (0 ∷ u8)) ↦ b8)
    }
    else {
        bytes.append(((0xF0 ∨ (cp ⇒ 18)) ↦ u8 ⊥ (0 ∷ u8)) ↦ b8)
        bytes.append(((0x80 ∨ ((cp ⇒ 12) ∧ 0x3F)) ↦ u8 ⊥ (0 ∷ u8)) ↦ b8)
        bytes.append(((0x80 ∨ ((cp ⇒ 6) ∧ 0x3F)) ↦ u8 ⊥ (0 ∷ u8)) ↦ b8)
        bytes.append(((0x80 ∨ (cp ∧ 0x3F)) ↦ u8 ⊥ (0 ∷ u8)) ↦ b8)
    }
    do {
        return bytes ↦ string
    }
    catch err {
        throw variant BadJson { message = "invalid UTF-8 code point in \\uXXXX escape" }
    }
}

fn parse_json_string(string src, int start) → StrResult ⇥ ConfigError {
    let int n ← src.length()
    require start ≺ n throw variant BadJson { message = "unexpected end of input while reading string" }
    let string q ← src.slice(start, start + 1)
    require q ≡ "\"" throw variant BadJson { message = "expected '\"' to start JSON string" }

    mut int i ← start + 1
    mut string out ← ""
    while i ≺ n {
        let string ch ← src.slice(i, i + 1)
        if ch ≡ "\"" {
            return StrResult { text = out, next_pos = i + 1 }
        }
        if ch ≡ "\\" {
            i ← i + 1
            require i ≺ n throw variant BadJson { message = "unterminated escape sequence in JSON string" }
            let string esc ← src.slice(i, i + 1)
            if esc ≡ "\"" or esc ≡ "\\" or esc ≡ "/" {
                out ← out + esc
                i ← i + 1
            }
            elif esc ≡ "n" {
                out ← out + "\n"
                i ← i + 1
            }
            elif esc ≡ "r" {
                out ← out + "\r"
                i ← i + 1
            }
            elif esc ≡ "t" {
                out ← out + "\t"
                i ← i + 1
            }
            elif esc ≡ "b" {
                out ← out + "\u{08}"
                i ← i + 1
            }
            elif esc ≡ "f" {
                out ← out + "\u{0C}"
                i ← i + 1
            }
            elif esc ≡ "u" {
                require i + 4 ≺ n throw variant BadJson { message = "truncated \\uXXXX escape in JSON string" }
                let int code1 ← decode_hex4(src, i + 1)
                if code1 ≥ 0xD800 and code1 ≤ 0xDBFF {
                    require i + 10 ≺ n throw variant BadJson { message = "unpaired high surrogate in JSON string" }
                    let string next_esc ← src.slice(i + 5, i + 7)
                    require next_esc ≡ "\\u" throw variant BadJson { message = "expected low surrogate \\uXXXX after high surrogate" }
                    let int code2 ← decode_hex4(src, i + 7)
                    require code2 ≥ 0xDC00 and code2 ≤ 0xDFFF throw variant BadJson { message = "invalid low surrogate in JSON string" }
                    let int cp ← 0x10000 + ((code1 - 0xD800) ⇐ 10) + (code2 - 0xDC00)
                    out ← out + encode_codepoint_utf8(cp)
                    i ← i + 11
                }
                else {
                    require code1 ≺ 0xDC00 or code1 ≻ 0xDFFF throw variant BadJson { message = "unpaired low surrogate in JSON string" }
                    out ← out + encode_codepoint_utf8(code1)
                    i ← i + 5
                }
            }
            else {
                throw variant BadJson { message = "invalid escape character in JSON string" }
            }
        }
        else {
            out ← out + ch
            i ← i + 1
        }
    }

    throw variant BadJson { message = "unterminated JSON string" }
}

fn parse_json_number(string src, int start) → ParseResult ⇥ ConfigError {
    let int n ← src.length()
    mut int i ← start
    if i ≺ n and src.slice(i, i + 1) ≡ "-" {
        i ← i + 1
    }
    require i ≺ n and is_digit(src.slice(i, i + 1)) throw variant BadJson { message = "invalid JSON number" }

    if src.slice(i, i + 1) ≡ "0" {
        i ← i + 1
    }
    else {
        while i ≺ n and is_digit(src.slice(i, i + 1)) {
            i ← i + 1
        }
    }

    if i ≺ n and src.slice(i, i + 1) ≡ "." {
        i ← i + 1
        require i ≺ n and is_digit(src.slice(i, i + 1)) throw variant BadJson { message = "expected digit after decimal point in JSON number" }
        while i ≺ n and is_digit(src.slice(i, i + 1)) {
            i ← i + 1
        }
    }

    if i ≺ n {
        let string exp_ch ← src.slice(i, i + 1)
        if exp_ch ≡ "e" or exp_ch ≡ "E" {
            i ← i + 1
            if i ≺ n {
                let string sign_ch ← src.slice(i, i + 1)
                if sign_ch ≡ "+" or sign_ch ≡ "-" {
                    i ← i + 1
                }
            }
            require i ≺ n and is_digit(src.slice(i, i + 1)) throw variant BadJson { message = "expected exponent digit in JSON number" }
            while i ≺ n and is_digit(src.slice(i, i + 1)) {
                i ← i + 1
            }
        }
    }

    let string raw ← src.slice(start, i)
    return ParseResult { val = variant JsonValue.JNum { raw = raw }, next_pos = i }
}

fn parse_json_value(string src, int start) → ParseResult ⇥ ConfigError {
    let int i ← skip_ws(src, start)
    let int n ← src.length()
    require i ≺ n throw variant BadJson { message = "unexpected end of JSON input" }

    let string ch ← src.slice(i, i + 1)
    if ch ≡ "\"" {
        let StrResult sr ← parse_json_string(src, i)
        return ParseResult { val = variant JsonValue.JStr { value = sr.text }, next_pos = sr.next_pos }
    }
    if ch ≡ "{" {
        return parse_json_object(src, i)
    }
    if ch ≡ "[" {
        return parse_json_array(src, i)
    }
    if ch ≡ "t" {
        require i + 4 ≤ n and src.slice(i, i + 4) ≡ "true" throw variant BadJson { message = "invalid literal in JSON" }
        return ParseResult { val = variant JsonValue.JBool { value = true }, next_pos = i + 4 }
    }
    if ch ≡ "f" {
        require i + 5 ≤ n and src.slice(i, i + 5) ≡ "false" throw variant BadJson { message = "invalid literal in JSON" }
        return ParseResult { val = variant JsonValue.JBool { value = false }, next_pos = i + 5 }
    }
    if ch ≡ "n" {
        require i + 4 ≤ n and src.slice(i, i + 4) ≡ "null" throw variant BadJson { message = "invalid literal in JSON" }
        return ParseResult { val = variant JsonValue.JNull, next_pos = i + 4 }
    }
    if ch ≡ "-" or is_digit(ch) {
        return parse_json_number(src, i)
    }

    throw variant BadJson { message = "unexpected character in JSON: §"(ch) }
}

fn parse_json_array(string src, int start) → ParseResult ⇥ ConfigError {
    let int n ← src.length()
    mut int i ← skip_ws(src, start + 1)
    mut list<JsonValue> items ← empty

    if i ≺ n and src.slice(i, i + 1) ≡ "]" {
        return ParseResult { val = variant JsonValue.JArr { items = items }, next_pos = i + 1 }
    }

    while i ≺ n {
        let ParseResult elem ← parse_json_value(src, i)
        items.append(elem.val)
        i ← skip_ws(src, elem.next_pos)
        require i ≺ n throw variant BadJson { message = "unterminated JSON array" }
        let string sep ← src.slice(i, i + 1)
        if sep ≡ "]" {
            return ParseResult { val = variant JsonValue.JArr { items = items }, next_pos = i + 1 }
        }
        require sep ≡ "," throw variant BadJson { message = "expected ',' or ']' in JSON array" }
        i ← skip_ws(src, i + 1)
    }

    throw variant BadJson { message = "unterminated JSON array" }
}

fn parse_json_object(string src, int start) → ParseResult ⇥ ConfigError {
    let int n ← src.length()
    mut int i ← skip_ws(src, start + 1)
    mut list<JsonEntry> entries ← empty

    if i ≺ n and src.slice(i, i + 1) ≡ "}" {
        return ParseResult { val = variant JsonValue.JObj { entries = entries }, next_pos = i + 1 }
    }

    while i ≺ n {
        let StrResult key_res ← parse_json_string(src, i)
        i ← skip_ws(src, key_res.next_pos)
        require i ≺ n and src.slice(i, i + 1) ≡ ":" throw variant BadJson { message = "expected ':' after JSON object key" }
        let ParseResult val_res ← parse_json_value(src, i + 1)
        entries.append(JsonEntry { key = key_res.text, val = val_res.val })
        i ← skip_ws(src, val_res.next_pos)
        require i ≺ n throw variant BadJson { message = "unterminated JSON object" }
        let string sep ← src.slice(i, i + 1)
        if sep ≡ "}" {
            return ParseResult { val = variant JsonValue.JObj { entries = entries }, next_pos = i + 1 }
        }
        require sep ≡ "," throw variant BadJson { message = "expected ',' or '}' in JSON object" }
        i ← skip_ws(src, i + 1)
    }

    throw variant BadJson { message = "unterminated JSON object" }
}

fn parse_root_object(string src) → list<JsonEntry> ⇥ ConfigError {
    let ParseResult res ← parse_json_value(src, 0)
    let int tail ← skip_ws(src, res.next_pos)
    require tail ≡ src.length() throw variant BadJson { message = "trailing characters after JSON root object" }
    match res.val {
        case JObj let entries {
            return entries
        }
        default {
            throw variant BadType { message = "JSON root must be an object" }
        }
    }
}

# -------------------------------------------------------------------------
# Typed field extraction helpers
# -------------------------------------------------------------------------

fn find_field(list<JsonEntry> entries, string key) → JsonValue {
    mut JsonValue found ← variant JsonValue.JNull
    for from entries let e {
        if e.key ≡ key {
            found ← e.val
        }
    }
    return found
}

fn parse_int_raw(string raw, string field_name) → int ⇥ ConfigError {
    do {
        return raw ↦ int
    }
    catch err {
        throw variant BadValue { message = "invalid integer for '§': §"(field_name, raw) }
    }
}

fn parse_f32_raw(string raw, string field_name) → f32 ⇥ ConfigError {
    do {
        return raw ↦ f32
    }
    catch err {
        throw variant BadValue { message = "invalid float for '§': §"(field_name, raw) }
    }
}

fn get_opt_string(list<JsonEntry> entries, string key) → string ∪ none ⇥ ConfigError {
    let JsonValue v ← find_field(entries, key)
    match v {
        case JNull {
            return null
        }
        case JStr let value {
            return value
        }
        default {
            throw variant BadType { message = "field '§' must be a string"(key) }
        }
    }
}

fn get_req_string(list<JsonEntry> entries, string key) → string ⇥ ConfigError {
    let string ∪ none v ← get_opt_string(entries, key)
    if v is string {
        require v.length() ≥ 1 throw variant BadValue { message = "field '§' must be non-empty"(key) }
        return v
    }
    throw variant MissingField { message = "missing required string field '§'"(key) }
}

fn get_opt_int(list<JsonEntry> entries, string key) → int ∪ none ⇥ ConfigError {
    let JsonValue v ← find_field(entries, key)
    match v {
        case JNull {
            return null
        }
        case JNum let raw {
            return parse_int_raw(raw, key)
        }
        default {
            throw variant BadType { message = "field '§' must be an integer"(key) }
        }
    }
}

fn get_req_pos_int(list<JsonEntry> entries, string key) → int ⇥ ConfigError {
    let int ∪ none v ← get_opt_int(entries, key)
    if v is int {
        let int val ← v coalesce 0
        require val ≥ 1 throw variant BadValue { message = "field '§' must be positive"(key) }
        return val
    }
    throw variant MissingField { message = "missing required integer field '§'"(key) }
}

fn get_opt_f32(list<JsonEntry> entries, string key) → f32 ∪ none ⇥ ConfigError {
    let JsonValue v ← find_field(entries, key)
    match v {
        case JNull {
            return null
        }
        case JNum let raw {
            return parse_f32_raw(raw, key)
        }
        default {
            throw variant BadType { message = "field '§' must be a number"(key) }
        }
    }
}

fn get_opt_bool(list<JsonEntry> entries, string key) → bool ∪ none ⇥ ConfigError {
    let JsonValue v ← find_field(entries, key)
    match v {
        case JNull {
            return null
        }
        case JBool let value {
            return value
        }
        default {
            throw variant BadType { message = "field '§' must be a boolean"(key) }
        }
    }
}

fn get_opt_string_list(list<JsonEntry> entries, string key) → list<string> ⇥ ConfigError {
    let JsonValue v ← find_field(entries, key)
    mut list<string> out ← empty
    match v {
        case JNull {
            return out
        }
        case JArr let items {
            for from items let item {
                match item {
                    case JStr let s {
                        out.append(s)
                    }
                    default {
                        throw variant BadType { message = "array '§' must contain strings"(key) }
                    }
                }
            }
            return out
        }
        default {
            throw variant BadType { message = "field '§' must be an array of strings"(key) }
        }
    }
}

fn get_opt_bool_list(list<JsonEntry> entries, string key) → list<bool> ⇥ ConfigError {
    let JsonValue v ← find_field(entries, key)
    mut list<bool> out ← empty
    match v {
        case JNull {
            return out
        }
        case JArr let items {
            for from items let item {
                match item {
                    case JBool let b {
                        out.append(b)
                    }
                    default {
                        throw variant BadType { message = "array '§' must contain booleans"(key) }
                    }
                }
            }
            return out
        }
        default {
            throw variant BadType { message = "field '§' must be an array of booleans"(key) }
        }
    }
}

fn get_opt_int_list(list<JsonEntry> entries, string key) → list<int> ⇥ ConfigError {
    let JsonValue v ← find_field(entries, key)
    mut list<int> out ← empty
    match v {
        case JNull {
            return out
        }
        case JArr let items {
            for from items let item {
                match item {
                    case JNum let raw {
                        out.append(parse_int_raw(raw, key))
                    }
                    default {
                        throw variant BadType { message = "array '§' must contain integers"(key) }
                    }
                }
            }
            return out
        }
        default {
            throw variant BadType { message = "field '§' must be an array of integers"(key) }
        }
    }
}

fn extract_quant_config(list<JsonEntry> entries) → QuantConfig ⇥ ConfigError {
    mut string ∪ none mode ← get_opt_string(entries, "mode")
    if mode is none {
        mode ← get_opt_string(entries, "quant_method")
    }
    if mode is none {
        mode ← get_opt_string(entries, "quant_algo")
    }
    let int ∪ none bits ← get_opt_int(entries, "bits")
    if bits is int {
        let int b ← bits coalesce 0
        require b ≥ 1 throw variant BadValue { message = "quantization.bits must be positive" }
    }
    let int ∪ none group_size ← get_opt_int(entries, "group_size")
    if group_size is int {
        let int g ← group_size coalesce 0
        require g ≥ 1 throw variant BadValue { message = "quantization.group_size must be positive" }
    }
    return QuantConfig { mode = mode, bits = bits, group_size = group_size }
}

fn parse_override_entry(string pattern, JsonValue val) → TensorQuantOverride ⇥ ConfigError {
    match val {
        case JStr let algo {
            let bool is_none ← algo ≡ "NONE" or algo ≡ "none"
            return TensorQuantOverride { pattern = pattern, quant_algo = algo, bits = null, group_size = null, excluded = is_none }
        }
        case JBool let b {
            if b {
                return TensorQuantOverride { pattern = pattern, quant_algo = null, bits = null, group_size = null, excluded = false }
            }
            return TensorQuantOverride { pattern = pattern, quant_algo = "NONE", bits = null, group_size = null, excluded = true }
        }
        case JObj let sub {
            mut string ∪ none algo ← get_opt_string(sub, "quant_algo")
            if algo is none {
                algo ← get_opt_string(sub, "mode")
            }
            if algo is none {
                algo ← get_opt_string(sub, "quant_method")
            }
            let int ∪ none bits ← get_opt_int(sub, "bits")
            let int ∪ none group_size ← get_opt_int(sub, "group_size")
            let bool excluded ← get_opt_bool(sub, "excluded") coalesce ((algo coalesce "") ≡ "NONE")
            return TensorQuantOverride { pattern = pattern, quant_algo = algo, bits = bits, group_size = group_size, excluded = excluded }
        }
        default {
            throw variant BadType { message = "quant override for '§' must be a string, bool, or object"(pattern) }
        }
    }
}

fn append_overrides_from(mut list<TensorQuantOverride> out, list<JsonEntry> entries, string key) → void ⇥ ConfigError {
    let JsonValue v ← find_field(entries, key)
    match v {
        case JNull {
            pass
        }
        case JObj let items {
            for from items let item {
                out.append(parse_override_entry(item.key, item.val))
            }
        }
        default {
            throw variant BadType { message = "field '§' must be an object"(key) }
        }
    }
}

fn is_quant_metadata_key(string key) → bool {
    return key ≡ "mode" or key ≡ "quant_method" or key ≡ "quant_algo" or key ≡ "bits" or key ≡ "group_size" or key ≡ "exclude_modules" or key ≡ "modules_to_not_convert" or key ≡ "quantized_layers" or key ≡ "per_tensor_overrides" or key ≡ "overrides" or key ≡ "producer" or key ≡ "config_groups" or key ≡ "kv_cache_scheme" or key ≡ "ignore" or key ≡ "format" or key ≡ "version" or key ≡ "quant_type" or key ≡ "backend" or key ≡ "pack_dtype" or key ≡ "checkpoint_format" or key ≡ "sym" or key ≡ "desc_act" or key ≡ "true_sequential" or key ≡ "zero_point" or key ≡ "static_groups" or key ≡ "is_dynamic" or key ≡ "damp_percent"
}

fn extract_hf_quant_config(list<JsonEntry> q_entries) → HfQuantConfig ⇥ ConfigError {
    let QuantConfig base ← extract_quant_config(q_entries)
    mut list<string> exclude_modules ← get_opt_string_list(q_entries, "exclude_modules")
    let list<string> not_conv ← get_opt_string_list(q_entries, "modules_to_not_convert")
    for from not_conv let m {
        if m ∉ exclude_modules then exclude_modules.append(m)
    }

    mut list<TensorQuantOverride> overrides ← empty
    append_overrides_from(mut overrides, q_entries, "quantized_layers")
    append_overrides_from(mut overrides, q_entries, "per_tensor_overrides")
    append_overrides_from(mut overrides, q_entries, "overrides")

    # Inline MLX per-module overrides placed directly inside `"quantization"`
    # (e.g. `"model.layers.0.self_attn.q_proj": {"bits": 8, "group_size": 64}`
    # or `"lm_head": false`).
    for from q_entries let item {
        if not is_quant_metadata_key(item.key) {
            match item.val {
                case JObj let ? {
                    overrides.append(parse_override_entry(item.key, item.val))
                }
                case JBool let ? {
                    overrides.append(parse_override_entry(item.key, item.val))
                }
                case JStr let s {
                    if s ≡ "NONE" or s ≡ "none" or item.key.contains(".") {
                        overrides.append(parse_override_entry(item.key, item.val))
                    }
                }
                default {
                    pass
                }
            }
        }
    }

    return HfQuantConfig { base = base, exclude_modules = exclude_modules, overrides = overrides }
}

fn match_wildcard(string pattern, string name) → bool {
    let int p_len ← pattern.length()
    let int n_len ← name.length()
    mut int pi ← 0
    mut int ni ← 0
    mut int star_pi ← -1
    mut int match_ni ← 0

    while ni ≺ n_len {
        if pi ≺ p_len and pattern.slice(pi, pi + 1) ≡ name.slice(ni, ni + 1) {
            pi ↑
            ni ↑
        }
        elif pi ≺ p_len and pattern.slice(pi, pi + 1) ≡ "*" {
            star_pi ← pi
            match_ni ← ni
            pi ↑
        }
        elif star_pi ≥ 0 {
            pi ← star_pi + 1
            match_ni ↑
            ni ← match_ni
        }
        else {
            return false
        }
    }

    while pi ≺ p_len and pattern.slice(pi, pi + 1) ≡ "*" {
        pi ↑
    }

    return pi ≡ p_len
}

fn last_dot_index(string s) → int {
    mut int idx ← -1
    for exclusive s.length() let i {
        if s.slice(i, i + 1) ≡ "." {
            idx ← i
        }
    }
    return idx
}

fn match_module_or_tensor(string pattern, string tensor_name) → bool {
    if match_wildcard(pattern, tensor_name) then return true

    let int dot ← last_dot_index(tensor_name)
    if dot ≻ 0 {
        let string mod_part ← tensor_name.slice(0, dot)
        if match_wildcard(pattern, mod_part) then return true

        if mod_part.length() ≻ 7 and mod_part.slice(mod_part.length() - 7, mod_part.length()) ≡ ".weight" {
            if match_wildcard(pattern, mod_part.slice(0, mod_part.length() - 7)) then return true
        }
    }

    return false
}

# -------------------------------------------------------------------------
# Public entry points
# -------------------------------------------------------------------------

@ public
fn parse_quant_config(string json_text) → QuantConfig ⇥ ConfigError {
    let list<JsonEntry> entries ← parse_root_object(json_text)
    return extract_quant_config(entries)
}

@ public
fn parse_hf_quant_config(string json_text) → HfQuantConfig ⇥ ConfigError {
    let list<JsonEntry> root ← parse_root_object(json_text)
    ref list<JsonEntry> q_entries ← root
    let JsonValue nested ← find_field(root, "quantization")
    match nested {
        case JNull {
            let JsonValue qc ← find_field(root, "quantization_config")
            match qc {
                case JNull {
                    pass
                }
                case JObj let sub_qc {
                    q_entries ← sub_qc
                }
                default {
                    throw variant BadType { message = "quantization_config must be a JSON object" }
                }
            }
        }
        case JObj let sub {
            q_entries ← sub
        }
        default {
            throw variant BadType { message = "quantization must be a JSON object" }
        }
    }

    return extract_hf_quant_config(q_entries)
}

@ public
fn resolve_tensor_quant(HfQuantConfig cfg, string tensor_name) → TensorQuantOverride ∪ none {
    for from cfg.overrides let ov {
        if match_module_or_tensor(ov.pattern, tensor_name) then return ov
    }

    for from cfg.exclude_modules let ex {
        if match_module_or_tensor(ex, tensor_name) {
            return TensorQuantOverride { pattern = ex, quant_algo = "NONE", bits = null, group_size = null, excluded = true }
        }
    }

    return null
}

@ public
fn parse_json(string json_text) → ModelConfig ⇥ ConfigError {
    let list<JsonEntry> entries ← parse_root_object(json_text)

    let string model_type ← get_req_string(entries, "model_type")
    let int hidden_size ← get_req_pos_int(entries, "hidden_size")
    let int num_hidden_layers ← get_req_pos_int(entries, "num_hidden_layers")
    let int num_attention_heads ← get_req_pos_int(entries, "num_attention_heads")
    let int ∪ none dense_intermediate ← get_opt_int(entries, "intermediate_size")
    if dense_intermediate is int {
        let int val ← dense_intermediate coalesce 0
        require val ≥ 1 throw variant BadValue { message = "field 'intermediate_size' must be positive" }
    }
    let int ∪ none moe_intermediate_size ← get_opt_int(entries, "moe_intermediate_size")
    if moe_intermediate_size is int {
        let int val ← moe_intermediate_size coalesce 0
        require val ≥ 1 throw variant BadValue { message = "field 'moe_intermediate_size' must be positive" }
    }
    let int ∪ none shared_expert_intermediate_size ← get_opt_int(entries, "shared_expert_intermediate_size")
    if shared_expert_intermediate_size is int {
        let int val ← shared_expert_intermediate_size coalesce 0
        require val ≥ 1 throw variant BadValue { message = "field 'shared_expert_intermediate_size' must be positive" }
    }
    require dense_intermediate is int or moe_intermediate_size is int or shared_expert_intermediate_size is int throw variant MissingField { message = "missing required integer field 'intermediate_size'" }
    let int intermediate_size ← dense_intermediate coalesce 0
    let int vocab_size ← get_req_pos_int(entries, "vocab_size")

    let int num_key_value_heads ← get_opt_int(entries, "num_key_value_heads") coalesce num_attention_heads
    require num_key_value_heads ≥ 1 throw variant BadValue { message = "num_key_value_heads must be positive" }
    require num_attention_heads % num_key_value_heads ≡ 0 throw variant BadValue { message = "num_attention_heads must be divisible by num_key_value_heads" }

    let int ∪ none explicit_head_dim ← get_opt_int(entries, "head_dim")
    mut int head_dim ← 0
    if explicit_head_dim is int {
        head_dim ← explicit_head_dim coalesce 0
    }
    else {
        require hidden_size % num_attention_heads ≡ 0 throw variant BadValue { message = "hidden_size must be divisible by num_attention_heads when head_dim is omitted" }
        head_dim ← hidden_size / num_attention_heads
    }
    require head_dim ≥ 1 throw variant BadValue { message = "head_dim must be positive" }

    let int max_position_embeddings ← get_opt_int(entries, "max_position_embeddings") coalesce 2048
    require max_position_embeddings ≥ 1 throw variant BadValue { message = "max_position_embeddings must be positive" }

    let f32 rms_norm_eps ← get_opt_f32(entries, "rms_norm_eps") coalesce (1.0e-5 ∷ f32)
    let f32 rope_theta ← get_opt_f32(entries, "rope_theta") coalesce (10000.0 ∷ f32)
    let bool tie_word_embeddings ← get_opt_bool(entries, "tie_word_embeddings") coalesce true
    mut int ∪ none sliding_window ← get_opt_int(entries, "sliding_window")
    if sliding_window is none {
        sliding_window ← get_opt_int(entries, "sliding_window_size")
    }
    let int ∪ none full_attention_interval ← get_opt_int(entries, "full_attention_interval")
    let list<string> layer_types ← get_opt_string_list(entries, "layer_types")
    let list<bool> rope_pattern ← get_opt_bool_list(entries, "rope_pattern")
    let int kv_key_bits ← get_opt_int(entries, "kv_key_bits") coalesce 0
    let int kv_value_bits ← get_opt_int(entries, "kv_value_bits") coalesce 0
    let int kv_group_size ← get_opt_int(entries, "kv_group_size") coalesce 0
    let bool ∪ none attention_bias ← get_opt_bool(entries, "attention_bias")
    let bool ∪ none qkv_bias ← get_opt_bool(entries, "qkv_bias")

    # Flint optional fields
    let list<int> mlp_only_layers ← get_opt_int_list(entries, "mlp_only_layers")
    let int ∪ none leading_dense_block_count ← get_opt_int(entries, "leading_dense_block_count")
    let string ∪ none softmax_type ← get_opt_string(entries, "softmax_type")
    mut int ∪ none num_local_experts ← get_opt_int(entries, "num_local_experts")
    if num_local_experts is none {
        num_local_experts ← get_opt_int(entries, "num_experts")
    }
    let int ∪ none num_experts_per_tok ← get_opt_int(entries, "num_experts_per_tok")
    let int ∪ none num_shared_experts ← get_opt_int(entries, "num_shared_experts")
    let string ∪ none expert_gating_func ← get_opt_string(entries, "expert_gating_func")
    let bool ∪ none norm_topk_prob ← get_opt_bool(entries, "norm_topk_prob")

    # Qwen3.6 optional fields
    let list<int> rope_dimension_sections ← get_opt_int_list(entries, "rope_dimension_sections")
    mut int ∪ none ssm_conv_kernel ← get_opt_int(entries, "ssm_conv_kernel")
    if ssm_conv_kernel is none {
        ssm_conv_kernel ← get_opt_int(entries, "linear_conv_kernel_dim")
    }
    let int ∪ none ssm_state_size ← get_opt_int(entries, "ssm_state_size")
    let int ∪ none ssm_group_count ← get_opt_int(entries, "ssm_group_count")
    let int ∪ none ssm_time_step_rank ← get_opt_int(entries, "ssm_time_step_rank")
    let int ∪ none ssm_inner_size ← get_opt_int(entries, "ssm_inner_size")

    # Inkling optional fields (supports nested "loop_config" and flat loop_core_* fallback)
    mut int ∪ none loop_core_start ← null
    mut int ∪ none loop_core_end ← null
    mut int ∪ none loop_num_passes ← null
    mut int ∪ none loop_gate_rank ← null
    mut bool ∪ none loop_varloop ← null
    let JsonValue loop_cfg_val ← find_field(entries, "loop_config")
    match loop_cfg_val {
        case JNull {
            pass
        }
        case JObj let lc_entries {
            loop_core_start ← get_opt_int(lc_entries, "core_start")
            loop_core_end ← get_opt_int(lc_entries, "core_end")
            loop_num_passes ← get_opt_int(lc_entries, "num_passes")
            loop_gate_rank ← get_opt_int(lc_entries, "gate_rank")
            loop_varloop ← get_opt_bool(lc_entries, "is_varloop")
        }
        default {
            throw variant BadType { message = "field 'loop_config' must be a JSON object" }
        }
    }
    if loop_core_start is none {
        loop_core_start ← get_opt_int(entries, "loop_core_start")
    }
    if loop_core_end is none {
        loop_core_end ← get_opt_int(entries, "loop_core_end")
    }
    if loop_num_passes is none {
        loop_num_passes ← get_opt_int(entries, "loop_num_passes")
    }
    if loop_gate_rank is none {
        loop_gate_rank ← get_opt_int(entries, "loop_gate_rank")
    }
    if loop_varloop is none {
        loop_varloop ← get_opt_bool(entries, "is_varloop")
    }
    let bool is_varloop ← loop_varloop coalesce false
    let f32 ∪ none route_scale ← get_opt_f32(entries, "route_scale")
    let int ∪ none n_layers_per_attn_res_block ← get_opt_int(entries, "n_layers_per_attn_res_block")
    let int ∪ none unpadded_vocab_size ← get_opt_int(entries, "unpadded_vocab_size")
    let f32 ∪ none mlp_gate_softcap ← get_opt_f32(entries, "mlp_gate_softcap")
    let f32 ∪ none mlp_up_softcap ← get_opt_f32(entries, "mlp_up_softcap")
    let f32 ∪ none final_logit_softcap ← get_opt_f32(entries, "final_logit_softcap")

    # DFlash optional fields
    mut list<int> target_layers ← get_opt_int_list(entries, "target_layers")
    if target_layers.length() ≡ 0 {
        target_layers ← get_opt_int_list(entries, "dflash_target_layers")
    }
    let int ∪ none block_size ← get_opt_int(entries, "block_size")
    let bool has_markov_context ← get_opt_bool(entries, "has_markov_context") coalesce false

    mut JsonValue quant_val ← find_field(entries, "quantization")
    match quant_val {
        case JNull {
            quant_val ← find_field(entries, "quantization_config")
        }
        default {
            pass
        }
    }
    mut QuantConfig ∪ none quantization ← null
    mut HfQuantConfig ∪ none hf_quantization ← null
    match quant_val {
        case JNull {
            quantization ← null
            hf_quantization ← null
        }
        case JObj let q_entries {
            quantization ← extract_quant_config(q_entries)
            hf_quantization ← extract_hf_quant_config(q_entries)
        }
        default {
            throw variant BadType { message = "quantization must be a JSON object" }
        }
    }

    return ModelConfig { model_type = model_type, hidden_size = hidden_size, num_hidden_layers = num_hidden_layers, num_attention_heads = num_attention_heads, num_key_value_heads = num_key_value_heads, head_dim = head_dim, intermediate_size = intermediate_size, vocab_size = vocab_size, max_position_embeddings = max_position_embeddings, rms_norm_eps = rms_norm_eps, rope_theta = rope_theta, tie_word_embeddings = tie_word_embeddings, sliding_window = sliding_window, full_attention_interval = full_attention_interval, layer_types = layer_types, rope_pattern = rope_pattern, kv_key_bits = kv_key_bits, kv_value_bits = kv_value_bits, kv_group_size = kv_group_size, quantization = quantization, mlp_only_layers = mlp_only_layers, leading_dense_block_count = leading_dense_block_count, softmax_type = softmax_type, num_local_experts = num_local_experts, num_experts_per_tok = num_experts_per_tok, num_shared_experts = num_shared_experts, expert_gating_func = expert_gating_func, norm_topk_prob = norm_topk_prob, rope_dimension_sections = rope_dimension_sections, ssm_conv_kernel = ssm_conv_kernel, ssm_state_size = ssm_state_size, ssm_group_count = ssm_group_count, ssm_time_step_rank = ssm_time_step_rank, ssm_inner_size = ssm_inner_size, loop_core_start = loop_core_start, loop_core_end = loop_core_end, loop_num_passes = loop_num_passes, loop_gate_rank = loop_gate_rank, is_varloop = is_varloop, n_layers_per_attn_res_block = n_layers_per_attn_res_block, unpadded_vocab_size = unpadded_vocab_size, mlp_gate_softcap = mlp_gate_softcap, mlp_up_softcap = mlp_up_softcap, final_logit_softcap = final_logit_softcap, target_layers = target_layers, block_size = block_size, has_markov_context = has_markov_context, moe_intermediate_size = moe_intermediate_size, shared_expert_intermediate_size = shared_expert_intermediate_size, route_scale = route_scale, attention_bias = attention_bias, qkv_bias = qkv_bias, hf_quantization = hf_quantization }
}

@ public
fn parse_bytes(list<b8> raw) → ModelConfig ⇥ ConfigError {
    mut string text ← ""
    do {
        text ← raw ↦ string
    }
    catch err {
        throw variant BadJson { message = "config is not valid UTF-8" }
    }
    return parse_json(text)
}

+++ faber test
import from "gradus:model/config" let cfg

fn parse_error(string json_text) → string {
    do {
        cfg.parse_json(json_text)
        return "ok"
    }
    catch err {
        return err.message
    }
}

test "ModelConfig parses SmolLM2-135M-Instruct-8bit config.json" {
    let string raw ← "{\"architectures\": [\"LlamaForCausalLM\"], \"model_type\": \"llama\", \"hidden_size\": 576, \"num_hidden_layers\": 30, \"num_attention_heads\": 9, \"num_key_value_heads\": 3, \"intermediate_size\": 1536, \"vocab_size\": 49152, \"max_position_embeddings\": 8192, \"rms_norm_eps\": 1e-05, \"rope_theta\": 100000.0, \"tie_word_embeddings\": true, \"quantization\": {\"group_size\": 64, \"bits\": 8}}"
    do {
        let cfg.ModelConfig c ← cfg.parse_json(raw)
        assert c.model_type ≡ "llama"
        assert c.hidden_size ≡ 576
        assert c.num_hidden_layers ≡ 30
        assert c.num_attention_heads ≡ 9
        assert c.num_key_value_heads ≡ 3
        assert c.head_dim ≡ 64
        assert c.intermediate_size ≡ 1536
        assert c.vocab_size ≡ 49152
        assert c.max_position_embeddings ≡ 8192
        assert c.rms_norm_eps ≻ (0.0 ∷ f32) and c.rms_norm_eps ≺ (1.0e-4 ∷ f32)
        assert c.rope_theta ≻ (99999.0 ∷ f32) and c.rope_theta ≺ (100001.0 ∷ f32)
        assert c.tie_word_embeddings ≡ true
        let cfg.QuantConfig ∪ none maybe_q ← c.quantization
        assert maybe_q is cfg.QuantConfig
        if maybe_q is cfg.QuantConfig {
            assert (maybe_q.bits coalesce 0) ≡ 8
            assert (maybe_q.group_size coalesce 0) ≡ 64
        }
    }
    catch err {
        assert false
    }
}

test "ModelConfig parses Flint-style pattern tables, KV-quant, and stale mode hints" {
    let string raw ← "{\"model_type\": \"flint\", \"hidden_size\": 2048, \"num_hidden_layers\": 49, \"num_attention_heads\": 32, \"num_key_value_heads\": 4, \"head_dim\": 128, \"intermediate_size\": 1024, \"vocab_size\": 150144, \"tie_word_embeddings\": false, \"sliding_window\": 513, \"layer_types\": [\"full_attention\", \"sliding_attention\"], \"rope_pattern\": [false, true], \"kv_key_bits\": 8, \"kv_value_bits\": 8, \"kv_group_size\": 64, \"quantization\": {\"mode\": \"nvfp4\", \"bits\": 4, \"group_size\": 64}}"
    do {
        let cfg.ModelConfig c ← cfg.parse_json(raw)
        assert c.model_type ≡ "flint"
        assert c.head_dim ≡ 128
        assert c.tie_word_embeddings ≡ false
        assert (c.sliding_window coalesce 0) ≡ 513
        assert c.layer_types.length() ≡ 2
        assert c.layer_types[0] ≡ "full_attention"
        assert c.rope_pattern.length() ≡ 2
        assert c.rope_pattern[0] ≡ false
        assert c.rope_pattern[1] ≡ true
        assert c.kv_key_bits ≡ 8
        assert c.kv_value_bits ≡ 8
        assert c.kv_group_size ≡ 64
        let cfg.QuantConfig ∪ none maybe_q ← c.quantization
        assert maybe_q is cfg.QuantConfig
        if maybe_q is cfg.QuantConfig {
            assert (maybe_q.mode coalesce "") ≡ "nvfp4"
            assert (maybe_q.bits coalesce 0) ≡ 4
            assert (maybe_q.group_size coalesce 0) ≡ 64
        }
    }
    catch err {
        assert false
    }
}

test "ModelConfig parse_quant_config and fail-closed errors" {
    do {
        let cfg.QuantConfig q ← cfg.parse_quant_config("{\"quant_method\": \"fp4\", \"bits\": 4, \"group_size\": 16}")
        assert (q.mode coalesce "") ≡ "fp4"
        assert (q.bits coalesce 0) ≡ 4
        assert (q.group_size coalesce 0) ≡ 16
    }
    catch err {
        assert false
    }

    assert parse_error("[]") ≢ "ok"
    assert parse_error("{\"model_type\": \"llama\"}") ≢ "ok"
    assert parse_error("{\"model_type\": \"llama\", \"hidden_size\": 0, \"num_hidden_layers\": 1, \"num_attention_heads\": 1, \"intermediate_size\": 1, \"vocab_size\": 1}") ≢ "ok"
    assert parse_error("{bad") ≢ "ok"
}

test "ModelConfig decodes \\uXXXX and surrogate pair escapes" {
    let string raw ← "{\"model_type\": \"\\u0063lama-\\uD83D\\uDE00\", \"hidden_size\": 64, \"num_hidden_layers\": 1, \"num_attention_heads\": 2, \"intermediate_size\": 128, \"vocab_size\": 256}"
    do {
        let cfg.ModelConfig c ← cfg.parse_json(raw)
        assert c.model_type ≡ "clama-😀"
    }
    catch err {
        assert false
    }
}

test "ModelConfig parses Flint, Qwen3.6, Inkling, and DFlash extended fields" {
    let string raw ← "{\"model_type\": \"inkling\", \"hidden_size\": 2048, \"num_hidden_layers\": 40, \"num_attention_heads\": 16, \"num_key_value_heads\": 2, \"head_dim\": 256, \"intermediate_size\": 512, \"vocab_size\": 248320, \"mlp_only_layers\": [0, 1], \"leading_dense_block_count\": 2, \"softmax_type\": \"zero_sink\", \"num_local_experts\": 256, \"num_experts_per_tok\": 8, \"num_shared_experts\": 1, \"expert_gating_func\": \"softmax\", \"norm_topk_prob\": true, \"rope_dimension_sections\": [11, 11, 10, 0], \"ssm_conv_kernel\": 4, \"ssm_state_size\": 128, \"ssm_group_count\": 16, \"ssm_time_step_rank\": 32, \"ssm_inner_size\": 4096, \"loop_core_start\": 4, \"loop_core_end\": 12, \"loop_num_passes\": 3, \"loop_gate_rank\": 64, \"is_varloop\": true, \"n_layers_per_attn_res_block\": 4, \"unpadded_vocab_size\": 200058, \"mlp_gate_softcap\": 15.0, \"mlp_up_softcap\": 15.0, \"final_logit_softcap\": 30.0, \"target_layers\": [3, 7, 11], \"block_size\": 16, \"has_markov_context\": true}"
    do {
        let cfg.ModelConfig c ← cfg.parse_json(raw)
        assert c.mlp_only_layers.length() ≡ 2 and c.mlp_only_layers[1] ≡ 1
        assert (c.leading_dense_block_count coalesce 0) ≡ 2
        assert (c.softmax_type coalesce "") ≡ "zero_sink"
        assert (c.num_local_experts coalesce 0) ≡ 256
        assert (c.num_experts_per_tok coalesce 0) ≡ 8
        assert (c.num_shared_experts coalesce 0) ≡ 1
        assert (c.expert_gating_func coalesce "") ≡ "softmax"
        assert (c.norm_topk_prob coalesce false) ≡ true

        assert c.rope_dimension_sections.length() ≡ 4 and c.rope_dimension_sections[0] ≡ 11
        assert (c.ssm_conv_kernel coalesce 0) ≡ 4
        assert (c.ssm_state_size coalesce 0) ≡ 128
        assert (c.ssm_group_count coalesce 0) ≡ 16
        assert (c.ssm_time_step_rank coalesce 0) ≡ 32
        assert (c.ssm_inner_size coalesce 0) ≡ 4096

        assert (c.loop_core_start coalesce 0) ≡ 4
        assert (c.loop_core_end coalesce 0) ≡ 12
        assert (c.loop_num_passes coalesce 0) ≡ 3
        assert (c.loop_gate_rank coalesce 0) ≡ 64
        assert c.is_varloop ≡ true
        assert (c.n_layers_per_attn_res_block coalesce 0) ≡ 4
        assert (c.unpadded_vocab_size coalesce 0) ≡ 200058
        assert (c.final_logit_softcap coalesce (0.0 ∷ f32)) ≻ (29.0 ∷ f32)

        assert c.target_layers.length() ≡ 3 and c.target_layers[2] ≡ 11
        assert (c.block_size coalesce 0) ≡ 16
        assert c.has_markov_context ≡ true
    }
    catch err {
        assert false
    }
}

test "ModelConfig parse_hf_quant_config parses ModelOpt overrides and exclusions" {
    let string raw ← "{\"producer\": {\"name\": \"modelopt\"}, \"quantization\": {\"quant_algo\": \"NVFP4\", \"group_size\": 16, \"exclude_modules\": [\"lm_head\", \"*mlp.gate*\"], \"quantized_layers\": {\"model.layers.0.self_attn.q_proj\": {\"quant_algo\": \"FP8\", \"bits\": 8}, \"model.layers.0.mlp.down_proj\": \"NONE\"}}}"
    do {
        let cfg.HfQuantConfig hq ← cfg.parse_hf_quant_config(raw)
        assert (hq.base.mode coalesce "") ≡ "NVFP4"
        assert (hq.base.group_size coalesce 0) ≡ 16
        assert hq.exclude_modules.length() ≡ 2
        assert hq.overrides.length() ≡ 2

        let cfg.TensorQuantOverride ∪ none q_ov ← cfg.resolve_tensor_quant(hq, "model.layers.0.self_attn.q_proj.weight")
        assert q_ov is cfg.TensorQuantOverride
        if q_ov is cfg.TensorQuantOverride {
            assert (q_ov.quant_algo coalesce "") ≡ "FP8"
            assert not q_ov.excluded
        }

        let cfg.TensorQuantOverride ∪ none d_ov ← cfg.resolve_tensor_quant(hq, "model.layers.0.mlp.down_proj.weight")
        assert d_ov is cfg.TensorQuantOverride
        if d_ov is cfg.TensorQuantOverride {
            assert d_ov.excluded
        }

        let cfg.TensorQuantOverride ∪ none gate_ov ← cfg.resolve_tensor_quant(hq, "model.layers.1.mlp.gate.weight")
        assert gate_ov is cfg.TensorQuantOverride
        if gate_ov is cfg.TensorQuantOverride {
            assert gate_ov.excluded
        }

        assert cfg.resolve_tensor_quant(hq, "model.layers.1.self_attn.v_proj.weight") is none
    }
    catch err {
        assert false
    }
}

test "ModelConfig parses Inkling nested loop_config, Flint MoE without intermediate_size, Qwen2.5 biases, and MLX inline quant overrides" {
    let string inkling_raw ← «{"model_type": "inkling", "hidden_size": 1024, "num_hidden_layers": 20, "num_attention_heads": 8, "num_key_value_heads": 2, "head_dim": 128, "intermediate_size": 2816, "vocab_size": 201024, "unpadded_vocab_size": 200058, "route_scale": 8.0, "n_layers_per_attn_res_block": 4, "loop_config": {"core_start": 2, "core_end": 18, "num_passes": 4, "gate_rank": 64, "is_varloop": true}, "quantization": {"bits": 4, "group_size": 64, "model.layers.0.self_attn.q_proj": {"bits": 8, "group_size": 64}, "lm_head": false}}»
    let string flint_raw ← «{"model_type": "flint", "hidden_size": 2048, "num_hidden_layers": 49, "num_attention_heads": 32, "num_key_value_heads": 4, "head_dim": 128, "moe_intermediate_size": 512, "shared_expert_intermediate_size": 1024, "vocab_size": 150144, "sliding_window_size": 513, "num_local_experts": 256, "num_experts_per_tok": 6}»
    let string qwen25_raw ← «{"model_type": "qwen2", "hidden_size": 896, "num_hidden_layers": 24, "num_attention_heads": 14, "num_key_value_heads": 2, "intermediate_size": 4864, "vocab_size": 151936, "attention_bias": true, "qkv_bias": true}»

    do {
        let cfg.ModelConfig ink ← cfg.parse_json(inkling_raw)
        assert (ink.loop_core_start coalesce -1) ≡ 2
        assert (ink.loop_core_end coalesce -1) ≡ 18
        assert (ink.loop_num_passes coalesce -1) ≡ 4
        assert (ink.loop_gate_rank coalesce -1) ≡ 64
        assert ink.is_varloop ≡ true
        assert (ink.route_scale coalesce (0.0 ∷ f32)) ≻ (7.9 ∷ f32) and (ink.route_scale coalesce (0.0 ∷ f32)) ≺ (8.1 ∷ f32)
        let cfg.HfQuantConfig ∪ none maybe_hq ← ink.hf_quantization
        assert maybe_hq is cfg.HfQuantConfig
        if maybe_hq is cfg.HfQuantConfig {
            let cfg.TensorQuantOverride ∪ none q_ov ← cfg.resolve_tensor_quant(maybe_hq, "model.layers.0.self_attn.q_proj.weight")
            assert q_ov is cfg.TensorQuantOverride
            if q_ov is cfg.TensorQuantOverride {
                assert (q_ov.bits coalesce 0) ≡ 8
                assert not q_ov.excluded
            }
            let cfg.TensorQuantOverride ∪ none head_ov ← cfg.resolve_tensor_quant(maybe_hq, "lm_head.weight")
            assert head_ov is cfg.TensorQuantOverride
            if head_ov is cfg.TensorQuantOverride {
                assert head_ov.excluded
            }
        }

        let cfg.ModelConfig flint ← cfg.parse_json(flint_raw)
        assert flint.intermediate_size ≡ 0
        assert (flint.moe_intermediate_size coalesce 0) ≡ 512
        assert (flint.shared_expert_intermediate_size coalesce 0) ≡ 1024
        assert (flint.sliding_window coalesce 0) ≡ 513

        let cfg.ModelConfig q25 ← cfg.parse_json(qwen25_raw)
        assert (q25.attention_bias coalesce false) ≡ true
        assert (q25.qkv_bias coalesce false) ≡ true
    }
    catch err {
        assert false
    }
}

test "ModelConfig resolve_tensor_quant supports middle wildcards and avoids non-wildcard substring matches" {
    let string raw ← «{"quantization": {"bits": 4, "group_size": 64, "exclude_modules": ["mlp.gate"], "model.layers.*.self_attn.q_proj": {"bits": 8, "group_size": 64}}}»
    do {
        let cfg.HfQuantConfig hq ← cfg.parse_hf_quant_config(raw)

        # Middle wildcard matches layer 0..N q_proj, rejects k_proj
        let cfg.TensorQuantOverride ∪ none q7 ← cfg.resolve_tensor_quant(hq, "model.layers.7.self_attn.q_proj.weight")
        assert q7 is cfg.TensorQuantOverride
        assert cfg.resolve_tensor_quant(hq, "model.layers.7.self_attn.k_proj.weight") is none

        # Exact non-wildcard "mlp.gate" must NOT substring-match "mlp.gate_proj.weight" or "model.layers.0.mlp.gate.weight"
        assert cfg.resolve_tensor_quant(hq, "mlp.gate_proj.weight") is none
        assert cfg.resolve_tensor_quant(hq, "mlp.gate_proj") is none
        assert cfg.resolve_tensor_quant(hq, "model.layers.0.mlp.gate.weight") is none
        assert cfg.resolve_tensor_quant(hq, "mlp.gate.weight") is cfg.TensorQuantOverride
    }
    catch err {
        assert false
    }
}
