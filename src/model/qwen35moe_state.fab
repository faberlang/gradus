+++ toml
locale = "en"

+++ faber
# qwen35moe hybrid state package map.
#
# Public import: import from "gradus:model/qwen35moe_state" state
# Prefer leaves:
#   gradus:model/qwen35moe_state/schedule     layer kinds and schedule
#   gradus:model/qwen35moe_state/session      conv/recurrent/KV session
#   gradus:model/qwen35moe_state/linear_attn  Gated DeltaNet path
#   gradus:model/qwen35moe_state/full_attn    full-attention KV path
#
# This file holds no genera. Import the leaf that owns the type.

import from "gradus:model/qwen35moe_state/schedule"

import from "gradus:model/qwen35moe_state/session"

import from "gradus:model/qwen35moe_state/linear_attn"

import from "gradus:model/qwen35moe_state/full_attn"

+++ faber test
# MODEL-03 proba: hybrid SSM/attention state (schedule derivation, state
# value construction/equality, the delta rule core, multi-section RoPE
# pair law, prefill/incremental equivalence, reset/replay determinism,
# identity round-trip). Executed rows run on deterministic synthetic
# weights; the real-artifact executed proof lives in
# exempla/qwen35moe-layer-probe (per-layer oracle agreement).

import from "gradus:model/qwen35moe" let qwen35moe
import from "gradus:tensor" let tensor
import from "gradus:model/qwen35moe_state/schedule" let schedule
import from "gradus:model/qwen35moe_state/session" let session
import from "gradus:model/qwen35moe_state/linear_attn" let linear_attn
import from "gradus:model/qwen35moe_state/full_attn" let full_attn
import from "gradus:model/schedule" let model_schedule

# Synthetic configurations mirroring the frozen qwen35moe row (41 blocks)
# and the two local 40-block rows (no NextN block), so schedule derivation
# holds for every admitted local qwen35moe artifact shape.
fn config(int block_count, int nextn_layers) → qwen35moe.Qwen35moeConfig {
    return qwen35moe.Qwen35moeConfig {
        architecture = "qwen35moe",
        file_type = 15,
        quantization_version = 2,
        block_count = block_count,
        context_length = 262144,
        embedding_length = 2048,
        head_count = 16,
        head_count_kv = 2,
        key_length = 256,
        value_length = 256,
        rms_norm_epsilon = 0.000001 ∷ f32,
        freq_base = 10000000.0 ∷ f32,
        rope_dimension_count = 64,
        rope_sections = [11, 11, 10, 0],
        expert_count = 256,
        expert_used_count = 8,
        expert_ffn_length = 512,
        shared_ffn_length = 512,
        conv_kernel = 4,
        state_size = 128,
        group_count = 16,
        gradus_temporis = 32,
        inner_size = 4096,
        full_attention_interval = 4,
        nextn_predict_layers = nextn_layers,
        tokenizer_model = "gpt2",
        tokenizer_pre = "qwen35",
        token_count = 248320,
        token_type_count = 248320,
        merge_count = 247587,
        eos_token_id = 248046,
        padding_token_id = 248055,
        bos_token_id = 248044,
        add_bos_token = false
    }
}

# Mid-size row for the budget-bound linear-attention rows: same field
# relationships as the pinned row (inner_size = gradus_temporis *
# state_size so head_v_dim = key_dim, conv_kernel 4) at 1/16 scale.
fn mid_dimensions() → tuple<int, int, int, int, int, int> {
    # embd, conv_kernel, state, group, temporis, inner
    return tuple<int, int, int, int, int, int> [64, 4, 16, 4, 8, 128]
}

fn mid_config() → qwen35moe.Qwen35moeConfig {
    let qwen35moe.Qwen35moeConfig c ← config(41, 1)
    let tuple<int, int, int, int, int, int> d ← mid_dimensions()
    return qwen35moe.Qwen35moeConfig {
        architecture = c.architecture,
        file_type = c.file_type,
        quantization_version = c.quantization_version,
        block_count = c.block_count,
        context_length = c.context_length,
        embedding_length = d[0],
        head_count = c.head_count,
        head_count_kv = c.head_count_kv,
        key_length = c.key_length,
        value_length = c.value_length,
        rms_norm_epsilon = c.rms_norm_epsilon,
        freq_base = c.freq_base,
        rope_dimension_count = c.rope_dimension_count,
        rope_sections = c.rope_sections,
        expert_count = c.expert_count,
        expert_used_count = c.expert_used_count,
        expert_ffn_length = c.expert_ffn_length,
        shared_ffn_length = c.shared_ffn_length,
        conv_kernel = d[1],
        state_size = d[2],
        group_count = d[3],
        gradus_temporis = d[4],
        inner_size = d[5],
        full_attention_interval = c.full_attention_interval,
        nextn_predict_layers = c.nextn_predict_layers,
        tokenizer_model = c.tokenizer_model,
        tokenizer_pre = c.tokenizer_pre,
        token_count = c.token_count,
        token_type_count = c.token_type_count,
        merge_count = c.merge_count,
        eos_token_id = c.eos_token_id,
        padding_token_id = c.padding_token_id,
        bos_token_id = c.bos_token_id,
        add_bos_token = c.add_bos_token
    }
}

fn mid_embd() → int {
    let tuple<int, int, int, int, int, int> d ← mid_dimensions()
    return d[0]
}

# Config-derived carrier shapes for the mid row (the module checks every
# returned shape against its own expectation).
fn mid_carrier_shape(string name) → list<int> {
    let tuple<int, int, int, int, int, int> d ← mid_dimensions()
    let int embd ← d[0]
    let int conv_kernel ← d[1]
    let int state ← d[2]
    let int group ← d[3]
    let int temporis ← d[4]
    let int inner ← d[5]
    let int conv_channels ← inner + 2 * group * state
    let int head_v_dim ← inner / temporis
    if ends_with(name, ".attn_norm") {
        return [embd]
    }
    if ends_with(name, ".attn_qkv") {
        return [conv_channels, embd]
    }
    if ends_with(name, ".attn_gate") {
        return [inner, embd]
    }
    if ends_with(name, ".ssm_conv1d") {
        return [conv_channels, conv_kernel]
    }
    if ends_with(name, ".ssm_dt") {
        return [temporis]
    }
    if ends_with(name, ".ssm_a") {
        return [temporis]
    }
    if ends_with(name, ".ssm_beta") {
        return [temporis, embd]
    }
    if ends_with(name, ".ssm_alpha") {
        return [temporis, embd]
    }
    if ends_with(name, ".ssm_norm") {
        return [head_v_dim]
    }
    if ends_with(name, ".ssm_out") {
        return [embd, inner]
    }
    return [1]
}

fn mid_window(string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError {
    do {
        return tensor.construct(fill(length, 7), mid_carrier_shape(name))
    }
    catch err {
        throw variant BadWindow {message = "mid-row synthetic carrier failed"}
    }
}

fn pinned_config() → qwen35moe.Qwen35moeConfig {
    return config(41, 1)
}

fn heretic_config() → qwen35moe.Qwen35moeConfig {
    return config(40, 0)
}

# Minimal config for hand-computed recurrence rows: a 1-head, 2x2-cell
# recurrent state so the delta rule can be asserted cell by cell. All other
# fields mirror the pinned row (fresh_recurrent_state reads only
# gradus_temporis and state_size).
fn small_config() → qwen35moe.Qwen35moeConfig {
    return qwen35moe.Qwen35moeConfig {
        architecture = "qwen35moe",
        file_type = 15,
        quantization_version = 2,
        block_count = 41,
        context_length = 262144,
        embedding_length = 2048,
        head_count = 16,
        head_count_kv = 2,
        key_length = 256,
        value_length = 256,
        rms_norm_epsilon = 0.000001 ∷ f32,
        freq_base = 10000000.0 ∷ f32,
        rope_dimension_count = 64,
        rope_sections = [11, 11, 10, 0],
        expert_count = 256,
        expert_used_count = 8,
        expert_ffn_length = 512,
        shared_ffn_length = 512,
        conv_kernel = 4,
        state_size = 2,
        group_count = 16,
        gradus_temporis = 1,
        inner_size = 4096,
        full_attention_interval = 4,
        nextn_predict_layers = 1,
        tokenizer_model = "gpt2",
        tokenizer_pre = "qwen35",
        token_count = 248320,
        token_type_count = 248320,
        merge_count = 247587,
        eos_token_id = 248046,
        padding_token_id = 248055,
        bos_token_id = 248044,
        add_bos_token = false
    }
}

# Deterministic synthetic weights: a fixed pseudo-random row derived from
# the requested length, so the executed rows need no artifact. The value
# scale is deliberately small (≈ ±0.30): at the naive ±3 magnitude the
# alpha/dt gate path reaches softplus(alpha + dt_bias) * a ≈ ±670 and
# exp(decay) legitimately overflows f32 — the module's loud trap is correct
# behavior (FORK-2), and the out-of-distribution weights, not the module,
# are the defect, so the harness keeps the gate path inside the model's
# trained operating range. The linear-attention executed rows run on a
# mid-size row (`mid_config`): at pinned dimensions one
# `linear_attention` window costs ≈33.5M projection inner steps per token,
# so the prefill-equivalence and replay rows exceed the runner's fixed
# 100,000,000-step interpreter budget — a harness artifact, not module
# behavior (the budget trap is the runner's loud guard, kept). The
# pinned-shape executed proof lives in exempla/qwen35moe-layer-probe
# against the llama.cpp oracle dump; the mid-size rows here prove the same
# prefill≡incremental and replay properties of the same code paths.
fn fill(int count, int seed) → list<f32> {
    mut list<f32> out ← empty
    mut int h ← seed
    for range 0‥count {
        h ← (h * 1103515245 + 12345) % 2147483647
        if h ≺ 0 {
            h ← -h
        }
        let int m ← h % 2000 - 1000
        out.append((m ↦ f32) / 3310.0)
    }
    return out
}

fn ends_with(string s, string suffix) → bool {
    if s.length() ≺ suffix.length() {
        return false
    }
    # in range: suffix.length() ≤ s.length() is checked above.
    return s.slice(s.length() - suffix.length(), s.length()) ≡ suffix
}

# Carrier shape per canonical base name (the module checks the returned
# shape, so this mapping is the test adapter's declaration).
fn carrier_shape(string name) → list<int> {
    if ends_with(name, ".attn_norm") {
        return [2048]
    }
    if ends_with(name, ".attn_qkv") {
        return [8192, 2048]
    }
    if ends_with(name, ".attn_gate") {
        return [4096, 2048]
    }
    if ends_with(name, ".ssm_conv1d") {
        return [8192, 4]
    }
    if ends_with(name, ".ssm_dt") {
        return [32]
    }
    if ends_with(name, ".ssm_a") {
        return [32]
    }
    if ends_with(name, ".ssm_beta") {
        return [32, 2048]
    }
    if ends_with(name, ".ssm_alpha") {
        return [32, 2048]
    }
    if ends_with(name, ".ssm_norm") {
        return [128]
    }
    if ends_with(name, ".ssm_out") {
        return [2048, 4096]
    }
    if ends_with(name, ".attn_q") {
        return [8192, 2048]
    }
    if ends_with(name, ".attn_k") {
        return [512, 2048]
    }
    if ends_with(name, ".attn_v") {
        return [512, 2048]
    }
    if ends_with(name, ".attn_q_norm") {
        return [256]
    }
    if ends_with(name, ".attn_k_norm") {
        return [256]
    }
    if ends_with(name, ".attn_output") {
        return [2048, 4096]
    }
    return [length_of(name)]
}

fn length_of(string name) → int {
    return 1
}

fn synthetic_window(string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError {
    do {
        return tensor.construct(fill(length, 7), carrier_shape(name))
    }
    catch err {
        throw variant BadWindow {message = "synthetic carrier failed"}
    }
}

fn kind_name(schedule.Qwen35moeSchedule s, int block) → string {
    do {
        return schedule.layer_kind_name(schedule.layer_kind(s, block))
    }
    catch err {
        return "error"
    }
}

fn linear_index(schedule.Qwen35moeSchedule s, int block) → int {
    do {
        return schedule.linear_index(s, block)
    }
    catch err {
        return -1
    }
}

fn attention_index(schedule.Qwen35moeSchedule s, int block) → int {
    do {
        return schedule.attention_index(s, block)
    }
    catch err {
        return -1
    }
}

test "schedule derivation on the pinned 41-block row" {
    do {
    let schedule.Qwen35moeSchedule s ← schedule.schedule(pinned_config())
    assert s.trunk_layers ≡ 40
    assert s.linear_layers ≡ 30
    assert s.full_layers ≡ 10
    assert s.nextn_layers ≡ 1
    assert kind_name(s, 0) ≡ "linear_attention"
    assert kind_name(s, 2) ≡ "linear_attention"
    assert kind_name(s, 3) ≡ "full_attention"
    assert kind_name(s, 4) ≡ "linear_attention"
    assert kind_name(s, 7) ≡ "full_attention"
    assert kind_name(s, 38) ≡ "linear_attention"
    assert kind_name(s, 39) ≡ "full_attention"
    assert kind_name(s, 40) ≡ "nextn"
    assert schedule.is_trunk(s, 39)
    assert not schedule.is_trunk(s, 40)
    assert linear_index(s, 0) ≡ 0
    assert linear_index(s, 1) ≡ 1
    assert linear_index(s, 4) ≡ 3
    assert attention_index(s, 3) ≡ 0
    assert attention_index(s, 39) ≡ 9
    }
    catch err {
        assert false
    }
}

test "schedule derivation on the 40-block rows (heretic/ornith shape)" {
    do {
    let schedule.Qwen35moeSchedule s ← schedule.schedule(heretic_config())
    assert s.trunk_layers ≡ 40
    assert s.linear_layers ≡ 30
    assert s.full_layers ≡ 10
    assert s.nextn_layers ≡ 0
    assert kind_name(s, 39) ≡ "full_attention"
    assert schedule.is_trunk(s, 39)
    }
    catch err {
        assert false
    }
}

test "schedule bounds fail closed" {
    do {
        let schedule.Qwen35moeSchedule s ← schedule.schedule(pinned_config())
        assert kind_name(s, 41) ≡ "error"
        assert kind_name(s, -1) ≡ "error"
        assert linear_index(s, 3) ≡ -1
        assert attention_index(s, 0) ≡ -1
    }
    catch err {
        assert false
    }
}

test "fresh state values are empty and typed per family" {
    do {
    let qwen35moe.Qwen35moeConfig c ← pinned_config()
    let session.ConvState conv ← session.fresh_conv_state(c)
    assert conv.kernel ≡ 3
    assert conv.channels_count ≡ 8192
    assert conv.channels.length() ≡ 3 * 8192
    for range 0‥conv.channels.length() let i {
        assert conv.channels.get(i) coalesce 1.0 ∷ f32 ≡ 0.0 ∷ f32
    }
    let session.RecurrentState recurrent ← session.fresh_recurrent_state(c)
    assert recurrent.value_heads ≡ 32
    assert recurrent.key_dim ≡ 128
    assert recurrent.value_dim ≡ 128
    assert recurrent.cells.length() ≡ 32 * 128 * 128
    for range 0‥recurrent.cells.length() let i {
        assert recurrent.cells.get(i) coalesce 1.0 ∷ f32 ≡ 0.0 ∷ f32
    }
    let session.KeyValueState kv ← session.fresh_kv_state(c, 16)
    assert kv.kv_heads ≡ 2
    assert kv.key_dim ≡ 256
    assert kv.value_dim ≡ 256
    assert kv.length ≡ 0
    assert kv.capacity ≡ 16
    assert kv.keys.length() ≡ 0
    assert kv.values.length() ≡ 0
    }
    catch err {
        assert false
    }
}

test "state families stay separate and equality is family-wise" {
    do {
    let qwen35moe.Qwen35moeConfig c ← pinned_config()
    let session.ConvState a ← session.fresh_conv_state(c)
    let session.ConvState b ← session.fresh_conv_state(c)
    assert session.conv_equal(a, b)
    let session.RecurrentState r ← session.fresh_recurrent_state(c)
    let session.KeyValueState kv ← session.fresh_kv_state(c, 4)
    assert session.recurrent_equal(r, r)
    assert session.kv_equal(kv, kv)
    }
    catch err {
        assert false
    }
}

test "session identity round-trips and covers the required fields" {
    do {
    let qwen35moe.Qwen35moeConfig c ← pinned_config()
    let session.HybridSession<8, 1, 4, 3, 4, 2, 2> s ← session.fresh_session<size 8, size 1, size 4, size 3, size 4, size 2, size 2>(c)
    let string wire ← session.session_identity_key(s)
    let session.HybridSession<8, 1, 4, 3, 4, 2, 2> parsed ← session.deserialize_session_identity<size 8, size 1, size 4, size 3, size 4, size 2, size 2>(wire)
    assert session.session_identity_key(parsed) ≡ wire
    assert wire.slice(0, 30) ≡ "qwen35moe-state/identity/1.0.0"
    assert s.generation ≡ 0
    assert s.arenas.kv.full_kv.slot_ids.length() ≡ 10
    assert s.arenas.conv.slot_ids.length() ≡ 30
    assert s.arenas.recurrent.slot_ids.length() ≡ 30
    }
    catch err {
        assert false
    }
}

test "reset returns a fresh session with the same identity" {
    do {
    let qwen35moe.Qwen35moeConfig c ← pinned_config()
    let session.HybridSession<8, 1, 4, 3, 4, 2, 2> s ← session.fresh_session<size 8, size 1, size 4, size 3, size 4, size 2, size 2>(c)
    let session.HybridSession<8, 1, 4, 3, 4, 2, 2> again ← session.reset_session(s)
    assert session.session_identity_key(again) ≡ session.session_identity_key(s)
    assert session.session_state_equal(again, s)
    assert again.generation ≡ 0
    mut session.HybridSession<8, 1, 4, 3, 4, 2, 2> mutated ← session.fresh_session<size 8, size 1, size 4, size 3, size 4, size 2, size 2>(c)
    mutated.arenas.conv.buffers[0][[0, 0]] ← 1.5 ∷ f32
    assert not session.session_state_equal(mutated, s)
    let session.HybridSession<8, 1, 4, 3, 4, 2, 2> cleared ← session.reset_session(mutated)
    assert session.session_state_equal(cleared, s)
    }
    catch err {
        assert false
    }
}

test "rope rotation preserves pair norms over the multi-section series" {
    # Pair j of a head row is (element j, element j + dims/2) with angle
    # theta_j = pos * base^(-2j/dims); sections [11, 11, 10, 0] cover the
    # pairs and every section reads the text position on this row.
    let list<f32> head ← [1.0 ∷ f32, 0.0 ∷ f32, 0.5 ∷ f32, -0.5 ∷ f32, 2.0 ∷ f32, 0.25 ∷ f32, -1.0 ∷ f32, 1.0 ∷ f32]
    do {
    let list<f32> turned ← session.rope_head(head, 8, 4, 10000000.0 ∷ f32, [1, 1, 1, 1, 0, 0, 0, 0], 3, 8)
    assert turned.length() ≡ 8
    let f32 n_before ← (head.get(0) coalesce 0.0 ∷ f32) * (head.get(0) coalesce 0.0 ∷ f32) + (head.get(4) coalesce 0.0 ∷ f32) * (head.get(4) coalesce 0.0 ∷ f32)
    let f32 n_after ← (turned.get(0) coalesce 0.0 ∷ f32) * (turned.get(0) coalesce 0.0 ∷ f32) + (turned.get(4) coalesce 0.0 ∷ f32) * (turned.get(4) coalesce 0.0 ∷ f32)
    assert (n_before - n_after).abs() ≺ 0.0001 ∷ f32
    }
    catch err {
        assert false
    }
}

test "the delta rule core matches a hand-computed 2-cell update" {
    let qwen35moe.Qwen35moeConfig c ← small_config()
    let session.RecurrentState s0 ← session.fresh_recurrent_state(c)
    let list<f32> q ← [1.0 ∷ f32, 0.0 ∷ f32]
    let list<f32> k ← [0.0 ∷ f32, 1.0 ∷ f32]
    let list<f32> v ← [2.0 ∷ f32, 4.0 ∷ f32]
    do {
    let session.RecurrentState s1 ← session.recurrent_update(s0, q, k, v, 0.0 ∷ f32, 1.0 ∷ f32, 0)
    # Zero state, g = 0, beta = 1: delta = v, so the state becomes
    # M[j][i] = k[i] * v[j] (cell (j, i) = S[i][j] — the comparator's
    # transposed layout, ggml_compute_forward_gated_delta_net).
    assert (s1.cells.get(0 * 2 + 0) coalesce 9.0 ∷ f32) ≡ 0.0 ∷ f32
    assert (s1.cells.get(0 * 2 + 1) coalesce 9.0 ∷ f32) ≡ 2.0 ∷ f32
    assert (s1.cells.get(1 * 2 + 0) coalesce 9.0 ∷ f32) ≡ 0.0 ∷ f32
    assert (s1.cells.get(1 * 2 + 1) coalesce 9.0 ∷ f32) ≡ 4.0 ∷ f32
    # Output read: out[j] = (Σ_i M[j][i] * q[i]) / sqrt(dim). With the
    # declared q = [1, 0] the read is degenerate (k·q = 0), so exercise the
    # row read with a q parallel to k: out = [2, 4] / sqrt(2).
    let list<f32> out ← session.recurrent_output(s1, [0.0 ∷ f32, 1.0 ∷ f32], 0)
    assert ((out.get(0) coalesce 9.0 ∷ f32) - 2.0 * (0.7071067811865476 ∷ f32)).abs() ≺ 0.000001 ∷ f32
    assert ((out.get(1) coalesce 9.0 ∷ f32) - 4.0 * (0.7071067811865476 ∷ f32)).abs() ≺ 0.000001 ∷ f32
    }
    catch err {
        assert false
    }
}

test "linear attention prefill equals incremental one-token steps" {
    let qwen35moe.Qwen35moeConfig c ← mid_config()
    let int embd ← mid_embd()
    let list<f32> rows ← fill(3 * embd, 11)
    do {
    let linear_attn.LinearAttentionOutcome batch ← linear_attn.linear_attention(rows, 0, session.fresh_conv_state(c), session.fresh_recurrent_state(c), (string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ mid_window(name, start, length), c)
    mut session.ConvState conv ← session.fresh_conv_state(c)
    mut session.RecurrentState recurrent ← session.fresh_recurrent_state(c)
    mut list<f32> outputs ← empty
    for range 0‥3 let t {
        mut list<f32> one ← empty
        for range 0‥embd let d {
            one.append(rows.get(t * embd + d) coalesce 0.0 ∷ f32)
        }
        let linear_attn.LinearAttentionOutcome step ← linear_attn.linear_attention_step(one, 0, conv, recurrent, (string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ mid_window(name, start, length), c)
        conv ← step.conv
        recurrent ← step.recurrent
        for range 0‥embd let d {
            outputs.append(step.out.get(d) coalesce 0.0 ∷ f32)
        }
    }
    assert batch.out.length() ≡ outputs.length()
    mut f32 worst ← 0.0 ∷ f32
    for range 0‥outputs.length() let i {
        let f32 d ← ((batch.out.get(i) coalesce 0.0 ∷ f32) - (outputs.get(i) coalesce 0.0 ∷ f32)).abs()
        if d ≻ worst {
            worst ← d
        }
    }
    assert worst ≺ 0.000001 ∷ f32
    assert session.conv_equal(batch.conv, conv)
    assert session.recurrent_equal(batch.recurrent, recurrent)
    }
    catch err {
        assert false
    }
}

test "full attention prefill equals incremental one-token steps" {
    let qwen35moe.Qwen35moeConfig c ← pinned_config()
    let list<f32> rows ← fill(3 * 2048, 13)
    do {
    let full_attn.FullAttentionOutcome batch ← full_attn.full_attention(rows, 3, session.fresh_kv_state(c, 8), 0, (string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ synthetic_window(name, start, length), c)
    mut session.KeyValueState kv ← session.fresh_kv_state(c, 8)
    mut list<f32> outputs ← empty
    for range 0‥3 let t {
        mut list<f32> one ← empty
        for range 0‥2048 let d {
            one.append(rows.get(t * 2048 + d) coalesce 0.0 ∷ f32)
        }
        let full_attn.FullAttentionOutcome step ← full_attn.full_attention_step(one, 3, kv, t, (string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ synthetic_window(name, start, length), c)
        kv ← step.kv
        for range 0‥2048 let d {
            outputs.append(step.out.get(d) coalesce 0.0 ∷ f32)
        }
    }
    assert batch.out.length() ≡ 3 * 2048
    assert batch.out.length() ≡ outputs.length()
    mut f32 worst ← 0.0 ∷ f32
    for range 0‥outputs.length() let i {
        let f32 d ← ((batch.out.get(i) coalesce 0.0 ∷ f32) - (outputs.get(i) coalesce 0.0 ∷ f32)).abs()
        if d ≻ worst {
            worst ← d
        }
    }
    assert worst ≺ 0.000001 ∷ f32
    assert session.kv_equal(batch.kv, kv)
    }
    catch err {
        assert false
    }
}

test "replay is deterministic across fresh sessions" {
    let qwen35moe.Qwen35moeConfig c ← mid_config()
    let int embd ← mid_embd()
    let list<f32> rows ← fill(embd, 17)
    do {
    let linear_attn.LinearAttentionOutcome first ← linear_attn.linear_attention_step(rows, 0, session.fresh_conv_state(c), session.fresh_recurrent_state(c), (string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ mid_window(name, start, length), c)
    let linear_attn.LinearAttentionOutcome second ← linear_attn.linear_attention_step(rows, 0, session.fresh_conv_state(c), session.fresh_recurrent_state(c), (string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ mid_window(name, start, length), c)
    assert first.out ≡ second.out
    assert session.conv_equal(first.conv, second.conv)
    assert session.recurrent_equal(first.recurrent, second.recurrent)
    }
    catch err {
        assert false
    }
}

test "schedule precomputes the linear and full slot index arrays" {
    do {
    let schedule.Qwen35moeSchedule s ← schedule.schedule(pinned_config())
    assert s.linear_slots.length() ≡ 41
    assert s.full_slots.length() ≡ 41
    assert (s.linear_slots.get(0) coalesce -2) ≡ 0
    assert (s.linear_slots.get(38) coalesce -2) ≡ 29
    assert (s.linear_slots.get(3) coalesce -2) ≡ -1
    assert (s.linear_slots.get(39) coalesce -2) ≡ -1
    assert (s.linear_slots.get(40) coalesce -2) ≡ -1
    assert (s.full_slots.get(3) coalesce -2) ≡ 0
    assert (s.full_slots.get(39) coalesce -2) ≡ 9
    assert (s.full_slots.get(0) coalesce -2) ≡ -1
    assert (s.full_slots.get(40) coalesce -2) ≡ -1
    let schedule.Qwen35moeSchedule h ← schedule.schedule(heretic_config())
    assert h.linear_slots.length() ≡ 40
    assert h.full_slots.length() ≡ 40
    assert (h.linear_slots.get(39) coalesce -2) ≡ -1
    assert (h.full_slots.get(39) coalesce -2) ≡ 9
    }
    catch err {
        assert false
    }
}

# Mid-size full-attention row for the budget-bound prepared-path rows:
# pinned-row field relationships (rope dims <= head dim, GQA heads/kv
# heads) at small widths.
fn mid_full_config() → qwen35moe.Qwen35moeConfig {
    let qwen35moe.Qwen35moeConfig c ← config(41, 1)
    return qwen35moe.Qwen35moeConfig {
        architecture = c.architecture,
        file_type = c.file_type,
        quantization_version = c.quantization_version,
        block_count = c.block_count,
        context_length = c.context_length,
        embedding_length = 64,
        head_count = 4,
        head_count_kv = 2,
        key_length = 32,
        value_length = 32,
        rms_norm_epsilon = c.rms_norm_epsilon,
        freq_base = c.freq_base,
        rope_dimension_count = 16,
        rope_sections = [4, 4, 4, 4],
        expert_count = c.expert_count,
        expert_used_count = c.expert_used_count,
        expert_ffn_length = c.expert_ffn_length,
        shared_ffn_length = c.shared_ffn_length,
        conv_kernel = c.conv_kernel,
        state_size = c.state_size,
        group_count = c.group_count,
        gradus_temporis = c.gradus_temporis,
        inner_size = c.inner_size,
        full_attention_interval = c.full_attention_interval,
        nextn_predict_layers = c.nextn_predict_layers,
        tokenizer_model = c.tokenizer_model,
        tokenizer_pre = c.tokenizer_pre,
        token_count = c.token_count,
        token_type_count = c.token_type_count,
        merge_count = c.merge_count,
        eos_token_id = c.eos_token_id,
        padding_token_id = c.padding_token_id,
        bos_token_id = c.bos_token_id,
        add_bos_token = c.add_bos_token
    }
}

# Carrier shapes for the mid full-attention row (the module checks every
# returned shape against its own expectation).
fn mid_full_carrier_shape(string name) → list<int> {
    if ends_with(name, ".attn_norm") {
        return [64]
    }
    if ends_with(name, ".attn_q") {
        return [256, 64]
    }
    if ends_with(name, ".attn_k") {
        return [64, 64]
    }
    if ends_with(name, ".attn_v") {
        return [64, 64]
    }
    if ends_with(name, ".attn_q_norm") {
        return [32]
    }
    if ends_with(name, ".attn_k_norm") {
        return [32]
    }
    if ends_with(name, ".attn_output") {
        return [64, 128]
    }
    return [1]
}

fn mid_full_window(string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError {
    do {
        return tensor.construct(fill(length, 7), mid_full_carrier_shape(name))
    }
    catch err {
        throw variant BadWindow {message = "mid-row synthetic carrier failed"}
    }
}

# Issue #79 lean-path rows: the prepared entry points read and validate the
# weight windows once (prepare), then reproduce the traced window path
# bit-for-bit while allocating no trace buffers.
test "linear attention prepared matches the traced path without trace buffers" {
    let qwen35moe.Qwen35moeConfig c ← mid_config()
    let int embd ← mid_embd()
    let list<f32> rows ← fill(embd, 19)
    do {
    let linear_attn.LinearAttentionOutcome traced ← linear_attn.linear_attention_step(rows, 0, session.fresh_conv_state(c), session.fresh_recurrent_state(c), (string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ mid_window(name, start, length), c)
    let linear_attn.LinearAttentionWeights weights ← linear_attn.prepare_linear_attention((string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ mid_window(name, start, length), 0, c)
    let linear_attn.LinearAttentionOutcome lean ← linear_attn.linear_attention_step_prepared(rows, session.fresh_conv_state(c), session.fresh_recurrent_state(c), weights, c)
    assert lean.out ≡ traced.out
    assert session.conv_equal(lean.conv, traced.conv)
    assert session.recurrent_equal(lean.recurrent, traced.recurrent)
    assert lean.trace.normed.length() ≡ 0
    assert lean.trace.qkv_mixed.length() ≡ 0
    assert lean.trace.core_out.length() ≡ 0
    assert lean.trace.final_output.length() ≡ 0
    assert traced.trace.normed.length() ≡ embd
    assert traced.trace.core_out.length() ≡ 8 * 16
    }
    catch err {
        assert false
    }
}

test "full attention prepared matches the traced path without trace buffers" {
    let qwen35moe.Qwen35moeConfig c ← mid_full_config()
    let list<f32> rows ← fill(2 * 64, 23)
    do {
    let full_attn.FullAttentionOutcome traced ← full_attn.full_attention(rows, 3, session.fresh_kv_state(c, 8), 0, (string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ mid_full_window(name, start, length), c)
    let full_attn.FullAttentionWeights weights ← full_attn.prepare_full_attention((string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ mid_full_window(name, start, length), 3, c)
    let full_attn.FullAttentionOutcome lean ← full_attn.full_attention_prepared(rows, session.fresh_kv_state(c, 8), 0, weights, c)
    assert lean.out ≡ traced.out
    assert session.kv_equal(lean.kv, traced.kv)
    assert lean.trace.normed.length() ≡ 0
    assert lean.trace.q_normed.length() ≡ 0
    assert lean.trace.k_normed.length() ≡ 0
    assert lean.trace.softmax.length() ≡ 0
    assert traced.trace.softmax.length() ≡ 2 * 4 * 2
    assert traced.trace.q_normed.length() ≡ 2 * 4 * 32
    }
    catch err {
        assert false
    }
}

test "session_kv_equal compares active [0..length) rows only and ignores dirty tail rows" {
    do {
        let qwen35moe.Qwen35moeConfig c ← pinned_config()
        mut session.HybridSession<8, 1, 4, 3, 4, 2, 2> a ← session.fresh_session<size 8, size 1, size 4, size 3, size 4, size 2, size 2>(c)
        mut session.HybridSession<8, 1, 4, 3, 4, 2, 2> b ← session.fresh_session<size 8, size 1, size 4, size 3, size 4, size 2, size 2>(c)

        for exclusive 4 let j {
            let f32 kv ← (j + 1) ↦ f32
            let f32 vv ← ((j + 1) * 10) ↦ f32
            a.arenas.kv.full_kv.keys[0][[0, j]] ← kv
            a.arenas.kv.full_kv.values[0][[0, j]] ← vv
            b.arenas.kv.full_kv.keys[0][[0, j]] ← kv
            b.arenas.kv.full_kv.values[0][[0, j]] ← vv
            # Simulate dirty rolled-back tail rows [1..3) on session `a` only.
            a.arenas.kv.full_kv.keys[0][[1, j]] ← 99.0 ∷ f32
            a.arenas.kv.full_kv.values[0][[2, j]] ← -77.0 ∷ f32
        }
        a.arenas.kv.full_kv.lengths[0] ← 1
        b.arenas.kv.full_kv.lengths[0] ← 1

        # Active [0..1) equals, dirty tail [1..8) ignored.
        assert session.session_kv_equal(a.arenas.kv, b.arenas.kv)
        assert session.session_state_equal(a, b)

        # Mutating an active row invalidates equality.
        a.arenas.kv.full_kv.keys[0][[0, 0]] ← -1.0 ∷ f32
        assert not session.session_kv_equal(a.arenas.kv, b.arenas.kv)
    }
    catch err {
        assert false
    }
}

test "deserialize_session_identity reads rope_sections and conv history length from wire metadata" {
    let qwen35moe.Qwen35moeConfig base ← mid_full_config()
    let qwen35moe.Qwen35moeConfig custom ← qwen35moe.Qwen35moeConfig {
        architecture = base.architecture,
        file_type = base.file_type,
        quantization_version = base.quantization_version,
        block_count = base.block_count,
        context_length = base.context_length,
        embedding_length = base.embedding_length,
        head_count = base.head_count,
        head_count_kv = base.head_count_kv,
        key_length = base.key_length,
        value_length = base.value_length,
        rms_norm_epsilon = base.rms_norm_epsilon,
        freq_base = base.freq_base,
        rope_dimension_count = base.rope_dimension_count,
        rope_sections = [4, 4, 4, 4],
        expert_count = base.expert_count,
        expert_used_count = base.expert_used_count,
        expert_ffn_length = base.expert_ffn_length,
        shared_ffn_length = base.shared_ffn_length,
        conv_kernel = 2,
        state_size = base.state_size,
        group_count = base.group_count,
        gradus_temporis = base.gradus_temporis,
        inner_size = base.inner_size,
        full_attention_interval = base.full_attention_interval,
        nextn_predict_layers = base.nextn_predict_layers,
        tokenizer_model = base.tokenizer_model,
        tokenizer_pre = base.tokenizer_pre,
        token_count = base.token_count,
        token_type_count = base.token_type_count,
        merge_count = base.merge_count,
        eos_token_id = base.eos_token_id,
        padding_token_id = base.padding_token_id,
        bos_token_id = base.bos_token_id,
        add_bos_token = base.add_bos_token
    }
    do {
        # ConvRows is 3, while conv_kernel = 2 gives conv history length 1.
        let session.HybridSession<8, 1, 4, 3, 4, 2, 2> s ← session.fresh_session<size 8, size 1, size 4, size 3, size 4, size 2, size 2>(custom)
        assert s.arenas.conv.history_len ≡ 1
        let string wire ← session.session_identity_key(s)
        let session.HybridSession<8, 1, 4, 3, 4, 2, 2> parsed ← session.deserialize_session_identity<size 8, size 1, size 4, size 3, size 4, size 2, size 2>(wire)
        assert parsed.arenas.conv.history_len ≡ 1
        let model_schedule.LayerSpec layer3 ← parsed.arenas.kv.sched.layers[3]
        match layer3.rope {
            case model_schedule.RopeKind.Sectional let secs {
                assert secs ≡ ([4, 4, 4, 4] ↦ list<int>)
            }
            default {
                assert false
            }
        }
        assert session.session_identity_key(parsed) ≡ wire

        # Missing rope_sections in execution_config fails closed.
        mut bool rejected_missing_sections ← false
        do {
            let _ bad ← session.deserialize_session_identity<size 8, size 1, size 4, size 3, size 4, size 2, size 2>(wire.replace(":sections=4,4,4,4", ""))
            assert false
        }
        catch err {
            rejected_missing_sections ← true
        }
        assert rejected_missing_sections

        # Conv history length exceeding ConvRows fails closed.
        mut bool rejected_bad_conv ← false
        do {
            let _ bad ← session.deserialize_session_identity<size 8, size 1, size 4, size 3, size 4, size 2, size 2>(wire.replace("conv=1x", "conv=9x"))
            assert false
        }
        catch err {
            rejected_bad_conv ← true
        }
        assert rejected_bad_conv
    }
    catch err {
        assert false
    }
}
