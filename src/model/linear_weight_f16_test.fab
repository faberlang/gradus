+++ toml
locale = "en"

+++ faber test
# Co-located package tests for LinearWeight GroupAffine native f16 scales and
# biases matvec, split-K, and matmul dispatchers against host reference. Split
# from linear_weight.fab to keep each test module under the 64-entry generic
# monomorphization cap.

import from "gradus:model/linear_weight" let lw

fn close(f32 a, f32 b) → bool {
    let f32 diff ← (a - b).abs()
    let f32 tol ← (1.0e-4 ∷ f32) + (1.0e-3 ∷ f32) * b.abs()
    return diff ≤ tol
}

test "LinearWeight host and device GroupAffine F16 scales/biases agree on U32 and U8" {
    let list<f32> x4 ← [1.0, -1.0, 2.0, 0.5]
    let list<f32> x2x4 ← [1.0, -1.0, 2.0, 0.5, -0.5, 1.5, -1.0, 2.0]
    let list<f16> f16_s ← [(0.5 ∷ f32) ↦ f16, (2.0 ∷ f32) ↦ f16]
    let list<f16> f16_b ← [(-1.0 ∷ f32) ↦ f16, (0.25 ∷ f32) ↦ f16]
    let list<f32> no_bias ← empty

    do {
        let lw.LinearWeight lw_u32 ← lw.LinearWeight { kind = variant lw.LinearWeightKind.GroupAffineU32, out_features = 1, in_features = 4, bits = 8, group_size = 2, packed_cols = 1, group_cols = 2, has_bias = false, scales_dtype = "F16" }
        let lw.LinearWeight lw_u8 ← lw.LinearWeight { kind = variant lw.LinearWeightKind.GroupAffineU8, out_features = 1, in_features = 4, bits = 4, group_size = 2, packed_cols = 2, group_cols = 2, has_bias = false, scales_dtype = "F16" }
        let list<f32> y32_host ← lw.linear_matvec(lw_u32, variant lw.WeightPayload.GroupAffineU32F16Payload { weight = [0x04030201 ∷ u32], scales = f16_s, biases = f16_b, bias = no_bias }, x4)
        let list<f32> y8_host ← lw.linear_matvec(lw_u8, variant lw.WeightPayload.GroupAffineU8F16Payload { weight = [0x21 ∷ u8, 0x43 ∷ u8], scales = f16_s, biases = f16_b, bias = no_bias }, x4)
        assert close(y32_host[0], 16.125)
        assert close(y8_host[0], 16.125)

        mut tensor<u32, [1, 1]> w32_t ← tu32[1, 1] {}
        w32_t[[0, 0]] ← 0x04030201 ∷ u32
        mut tensor<u8, [1, 2]> w8_t ← tu8[1, 2] {}
        w8_t[[0, 0]] ← 0x21 ∷ u8
        w8_t[[0, 1]] ← 0x43 ∷ u8
        mut tensor<f16, [1, 2]> s_t ← tf16[1, 2] {}
        mut tensor<f16, [1, 2]> b_t ← tf16[1, 2] {}
        s_t[[0, 0]] ← f16_s[0]
        s_t[[0, 1]] ← f16_s[1]
        b_t[[0, 0]] ← f16_b[0]
        b_t[[0, 1]] ← f16_b[1]
        mut tensor<f32, [4]> x_t ← tf32[4] {}
        mut tensor<f32, [2, 4]> x_mat ← tf32[2, 4] {}
        for exclusive 4 let j {
            x_t[[j]] ← x4[j]
            x_mat[[0, j]] ← x2x4[j]
            x_mat[[1, j]] ← x2x4[4 + j]
        }

        mut tensor<f32, [1]> y_dev ← tf32[1] {}
        mut tensor<f32, [1, 2]> partials ← tf32[1, 2] {}
        mut tensor<f32, [2, 1]> y_mat ← tf32[2, 1] {}

        lw.dispatch_group_affine_u32_f16<size 1, size 1, size 2, size 4>(lw_u32, w32_t, s_t, b_t, x_t, mut y_dev)
        assert close(y_dev[[0]], y32_host[0])
        lw.dispatch_group_affine_u32_f16_splitk<size 1, size 1, size 2, size 4, size 2>(lw_u32, w32_t, s_t, b_t, x_t, mut partials, mut y_dev)
        assert close(y_dev[[0]], y32_host[0])
        lw.dispatch_group_affine_u32_f16_matmul<size 2, size 1, size 1, size 2, size 4>(lw_u32, w32_t, s_t, b_t, x_mat, mut y_mat)
        assert close(y_mat[[0, 0]], y32_host[0])

        lw.dispatch_group_affine_u8_f16<size 1, size 2, size 2, size 4>(lw_u8, w8_t, s_t, b_t, x_t, mut y_dev)
        assert close(y_dev[[0]], y8_host[0])
        lw.dispatch_group_affine_u8_f16_splitk<size 1, size 2, size 2, size 4, size 2>(lw_u8, w8_t, s_t, b_t, x_t, mut partials, mut y_dev)
        assert close(y_dev[[0]], y8_host[0])
        lw.dispatch_group_affine_u8_f16_matmul<size 2, size 1, size 2, size 2, size 4>(lw_u8, w8_t, s_t, b_t, x_mat, mut y_mat)
        assert close(y_mat[[0, 0]], y8_host[0])
    }
    catch err {
        assert false
    }
}
