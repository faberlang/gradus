+++
locale = "en"
+++
# REF-01-U1.7 — typed `qwen2` (Qwen2.5) architecture adapter, descriptor
# resolution pins.
#
# The proba pins each canonical dense tensor name to the exact manifest
# descriptor facts (GGUF name, shape, layout) the GGUF-A1b inspect surface
# reports for the pinned Qwen2.5-0.5B row, plus the qwen2 deltas (tie status
# read from the tensor set, GQA head config, rope_theta 1000000) and the
# fail-closed rejection rows. Like the A1b precedent, `faber check` proves
# the builders, parse calls, returned-field access, and typed-error branches
# type-check; the current imported-library `faber test` route is
# provider-blocked, so this file makes no executed-value claim. The executed
# proof lives in exempla/dense-qwen2-adapter.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" gguf_manifest

import from "gradus:model/dense_qwen2" dense_qwen2

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn _u8(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>]
}

fn _u16(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>]
}

fn _u32(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>]
}

fn _u64(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>, ((n ⇒ 32) % 256) ∷ int<u8>, ((n ⇒ 40) % 256) ∷ int<u8>, ((n ⇒ 48) % 256) ∷ int<u8>, ((n ⇒ 56) % 256) ∷ int<u8>]
}

fn _join(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← empty
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

# Fixture byte encoding for the finite ASCII keys/values this builder uses.
fn _text_bytes(string s) → list<int<u8>> {
    if s ≡ "general.architecture" then return [103, 101, 110, 101, 114, 97, 108, 46, 97, 114, 99, 104, 105, 116, 101, 99, 116, 117, 114, 101]
    if s ≡ "qwen2" then return [113, 119, 101, 110, 50]
    if s ≡ "llama" then return [108, 108, 97, 109, 97]
    if s ≡ "qwen2.block_count" then return [113, 119, 101, 110, 50, 46, 98, 108, 111, 99, 107, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen2.attention.head_count" then return [113, 119, 101, 110, 50, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 104, 101, 97, 100, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen2.attention.head_count_kv" then return [113, 119, 101, 110, 50, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 104, 101, 97, 100, 95, 99, 111, 117, 110, 116, 95, 107, 118]
    if s ≡ "qwen2.embedding_length" then return [113, 119, 101, 110, 50, 46, 101, 109, 98, 101, 100, 100, 105, 110, 103, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "output_norm.weight" then return [111, 117, 116, 112, 117, 116, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "output.weight" then return [111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_norm.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_q.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_k.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 107, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_v.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 118, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_q.bias" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 98, 105, 97, 115]
    if s ≡ "blk.0.attn_k.bias" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 107, 46, 98, 105, 97, 115]
    if s ≡ "blk.0.attn_v.bias" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 118, 46, 98, 105, 97, 115]
    if s ≡ "blk.0.attn_output.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_norm.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_gate.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 103, 97, 116, 101, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_up.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 117, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_down.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 100, 111, 119, 110, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.23.attn_norm.weight" then return [98, 108, 107, 46, 50, 51, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.23.attn_q.weight" then return [98, 108, 107, 46, 50, 51, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.23.ffn_down.weight" then return [98, 108, 107, 46, 50, 51, 46, 102, 102, 110, 95, 100, 111, 119, 110, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.24.attn_norm.weight" then return [98, 108, 107, 46, 50, 52, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    return []
}

fn _str(string s) → list<int<u8>> {
    const list<int<u8>> b ← _text_bytes(s)
    return _join(_u64(b.length()), b)
}

fn _kv(string key, int kind, list<int<u8>> value) → list<int<u8>> {
    return _join(_join(_str(key), _u32(kind)), value)
}

fn _tensor(string name, list<int> shape, int kind, int offset) → list<int<u8>> {
    var list<int<u8>> out ← _join(_str(name), _u32(shape.length()))
    for from shape const dim {
        out ← _join(out, _u64(dim))
    }
    return _join(_join(out, _u32(kind)), _u64(offset))
}

fn _header(int tensors, int metadata) → list<int<u8>> {
    return _join(_join([71, 71, 85, 70], _u32(3)), _join(_u64(tensors), _u64(metadata)))
}

fn _bytes(list<int<u8>> b) → bytes {
    var bytes o ← ||
    for from b const x {
        o.append(x)
    }
    return o
}

fn _corpus(list<int<u8>> table, int alignment, int payload) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← _bytes(b)
    return gguf_manifest.GgufCorpus {table = o, artifact_length = data_offset + payload, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = data_offset + payload}}
}

# Known GGML payload byte length for the fixture types (mirrors the A1a
# fixture geometry; the manifest layout() facts are asserted separately).
fn _payload_length(int kind, list<int> shape) → int {
    var int elements ← 1
    for from shape const d {
        elements ← elements * d
    }
    if kind ≡ 0 then return elements * 4
    if kind ≡ 6 then return (elements / 32) * 22
    if kind ≡ 8 then return (elements / 32) * 34
    if kind ≡ 12 then return (elements / 256) * 144
    if kind ≡ 14 then return (elements / 256) * 210
    return 0
}

# Synthetic qwen2 manifest with the canonical tensor table for the pinned
# Qwen2.5-0.5B row: layer 0 full + layer 23 boundary, tied embeddings (no
# output.weight). Shapes/types mirror the A1b inspect surface facts.
fn _qwen2_ligata() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(17, 5)
    table ← _join(table, _kv("general.architecture", 8, _str("qwen2")))
    table ← _join(table, _kv("qwen2.block_count", 4, _u32(24)))
    table ← _join(table, _kv("qwen2.attention.head_count", 4, _u32(14)))
    table ← _join(table, _kv("qwen2.attention.head_count_kv", 4, _u32(2)))
    table ← _join(table, _kv("qwen2.embedding_length", 4, _u32(896)))
    var int off ← 0
    table ← _join(table, _tensor("token_embd.weight", [896, 151936], 8, off))
    off ← off + _payload_length(8, [896, 151936])
    table ← _join(table, _tensor("output_norm.weight", [896], 0, off))
    off ← off + _payload_length(0, [896])
    table ← _join(table, _tensor("blk.0.attn_norm.weight", [896], 0, off))
    off ← off + _payload_length(0, [896])
    table ← _join(table, _tensor("blk.0.attn_q.weight", [896, 896], 6, off))
    off ← off + _payload_length(6, [896, 896])
    table ← _join(table, _tensor("blk.0.attn_k.weight", [896, 128], 6, off))
    off ← off + _payload_length(6, [896, 128])
    table ← _join(table, _tensor("blk.0.attn_v.weight", [896, 128], 8, off))
    off ← off + _payload_length(8, [896, 128])
    table ← _join(table, _tensor("blk.0.attn_q.bias", [896], 0, off))
    off ← off + _payload_length(0, [896])
    table ← _join(table, _tensor("blk.0.attn_k.bias", [128], 0, off))
    off ← off + _payload_length(0, [128])
    table ← _join(table, _tensor("blk.0.attn_v.bias", [128], 0, off))
    off ← off + _payload_length(0, [128])
    table ← _join(table, _tensor("blk.0.attn_output.weight", [896, 896], 6, off))
    off ← off + _payload_length(6, [896, 896])
    table ← _join(table, _tensor("blk.0.ffn_norm.weight", [896], 0, off))
    off ← off + _payload_length(0, [896])
    table ← _join(table, _tensor("blk.0.ffn_gate.weight", [896, 4864], 6, off))
    off ← off + _payload_length(6, [896, 4864])
    table ← _join(table, _tensor("blk.0.ffn_up.weight", [896, 4864], 6, off))
    off ← off + _payload_length(6, [896, 4864])
    table ← _join(table, _tensor("blk.0.ffn_down.weight", [4864, 896], 14, off))
    off ← off + _payload_length(14, [4864, 896])
    table ← _join(table, _tensor("blk.23.attn_norm.weight", [896], 0, off))
    off ← off + _payload_length(0, [896])
    table ← _join(table, _tensor("blk.23.attn_q.weight", [896, 896], 6, off))
    off ← off + _payload_length(6, [896, 896])
    table ← _join(table, _tensor("blk.23.ffn_down.weight", [4864, 896], 12, off))
    off ← off + _payload_length(12, [4864, 896])
    return _corpus(table, 32, off)
}

# Untied variant: the same canonical table plus output.weight.
fn _qwen2_soluta() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(18, 5)
    table ← _join(table, _kv("general.architecture", 8, _str("qwen2")))
    table ← _join(table, _kv("qwen2.block_count", 4, _u32(24)))
    table ← _join(table, _kv("qwen2.attention.head_count", 4, _u32(14)))
    table ← _join(table, _kv("qwen2.attention.head_count_kv", 4, _u32(2)))
    table ← _join(table, _kv("qwen2.embedding_length", 4, _u32(896)))
    var int off ← 0
    table ← _join(table, _tensor("token_embd.weight", [896, 151936], 8, off))
    off ← off + _payload_length(8, [896, 151936])
    table ← _join(table, _tensor("output_norm.weight", [896], 0, off))
    off ← off + _payload_length(0, [896])
    table ← _join(table, _tensor("blk.0.attn_norm.weight", [896], 0, off))
    off ← off + _payload_length(0, [896])
    table ← _join(table, _tensor("blk.0.attn_q.weight", [896, 896], 6, off))
    off ← off + _payload_length(6, [896, 896])
    table ← _join(table, _tensor("blk.0.attn_k.weight", [896, 128], 6, off))
    off ← off + _payload_length(6, [896, 128])
    table ← _join(table, _tensor("blk.0.attn_v.weight", [896, 128], 8, off))
    off ← off + _payload_length(8, [896, 128])
    table ← _join(table, _tensor("blk.0.attn_q.bias", [896], 0, off))
    off ← off + _payload_length(0, [896])
    table ← _join(table, _tensor("blk.0.attn_k.bias", [128], 0, off))
    off ← off + _payload_length(0, [128])
    table ← _join(table, _tensor("blk.0.attn_v.bias", [128], 0, off))
    off ← off + _payload_length(0, [128])
    table ← _join(table, _tensor("blk.0.attn_output.weight", [896, 896], 6, off))
    off ← off + _payload_length(6, [896, 896])
    table ← _join(table, _tensor("blk.0.ffn_norm.weight", [896], 0, off))
    off ← off + _payload_length(0, [896])
    table ← _join(table, _tensor("blk.0.ffn_gate.weight", [896, 4864], 6, off))
    off ← off + _payload_length(6, [896, 4864])
    table ← _join(table, _tensor("blk.0.ffn_up.weight", [896, 4864], 6, off))
    off ← off + _payload_length(6, [896, 4864])
    table ← _join(table, _tensor("blk.0.ffn_down.weight", [4864, 896], 14, off))
    off ← off + _payload_length(14, [4864, 896])
    table ← _join(table, _tensor("output.weight", [896, 151936], 8, off))
    off ← off + _payload_length(8, [896, 151936])
    return _corpus(table, 32, off)
}

# Rejection corpus: architecture is llama, not qwen2.
fn _llama() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(1, 1)
    table ← _join(table, _kv("general.architecture", 8, _str("llama")))
    table ← _join(table, _tensor("token_embd.weight", [960, 49152], 8, 0))
    return _corpus(table, 32, _payload_length(8, [960, 49152]))
}

# Resolution render: gguf-name/shape/layout or a typed error.
fn _resolve_render(gguf_manifest.GgufCorpus corpus, string name) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const dense_qwen2.DenseQwen2Config cfg ← dense_qwen2.config(m)
            const gguf_manifest.GgufTensorDescriptor t ← dense_qwen2.resolve(cfg, m, name)
            return dense_qwen2.render_description(t)
        }
        catch err {
            return err.message
        }
    }
    catch err {
        return err.message
    }
}

fn _config_render(gguf_manifest.GgufCorpus corpus) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const dense_qwen2.DenseQwen2Config cfg ← dense_qwen2.config(m)
            return ((((((((((((((cfg.layers ↦ string) + "/") + (cfg.heads ↦ string)) + "/") + (cfg.kv_heads ↦ string)) + "/") + (cfg.head_dim ↦ string)) + "/") + (cfg.hidden_dim ↦ string)) + "/") + (cfg.vocab ↦ string)) + "/") + (cfg.theta ↦ string)) + "/") + (cfg.tied ↦ string)
        }
        catch err {
            return err.message
        }
    }
    catch err {
        return err.message
    }
}

test "freezes the Qwen2.5-0.5B architecture config from the manifest" {
    assert _config_render(_qwen2_ligata()) ≡ "24/14/2/64/896/151936/1000000/true"
    assert _config_render(_qwen2_soluta()) ≡ "24/14/2/64/896/151936/1000000/false"
}

test "resolves every canonical tensor name to the exact A1b descriptor facts" {
    assert _resolve_render(_qwen2_ligata(), "model.embed_tokens") ≡ "token_embd.weight/896,151936/known/32"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.input_layernorm") ≡ "blk.0.attn_norm.weight/896/known/1"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.q_proj") ≡ "blk.0.attn_q.weight/896,896/known/32"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.k_proj") ≡ "blk.0.attn_k.weight/896,128/known/32"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.v_proj") ≡ "blk.0.attn_v.weight/896,128/known/32"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.q_proj.bias") ≡ "blk.0.attn_q.bias/896/known/1"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.k_proj.bias") ≡ "blk.0.attn_k.bias/128/known/1"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.v_proj.bias") ≡ "blk.0.attn_v.bias/128/known/1"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.o_proj") ≡ "blk.0.attn_output.weight/896,896/known/32"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.post_attention_layernorm") ≡ "blk.0.ffn_norm.weight/896/known/1"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.mlp.gate_proj") ≡ "blk.0.ffn_gate.weight/896,4864/known/32"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.mlp.up_proj") ≡ "blk.0.ffn_up.weight/896,4864/known/32"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.mlp.down_proj") ≡ "blk.0.ffn_down.weight/4864,896/known/256"
    assert _resolve_render(_qwen2_ligata(), "model.layers.23.input_layernorm") ≡ "blk.23.attn_norm.weight/896/known/1"
    assert _resolve_render(_qwen2_ligata(), "model.layers.23.self_attn.q_proj") ≡ "blk.23.attn_q.weight/896,896/known/32"
    assert _resolve_render(_qwen2_ligata(), "model.layers.23.mlp.down_proj") ≡ "blk.23.ffn_down.weight/4864,896/known/256"
    assert _resolve_render(_qwen2_ligata(), "model.norm") ≡ "output_norm.weight/896/known/1"
}

test "resolves lm_head from the tensor set: tied row → token_embd, untied row → output" {
    assert _resolve_render(_qwen2_ligata(), "lm_head") ≡ "token_embd.weight/896,151936/known/32"
    assert _resolve_render(_qwen2_soluta(), "lm_head") ≡ "output.weight/896,151936/known/32"
}

test "fails closed on unknown canonical names, layer range, and missing tensors" {
    assert _resolve_render(_qwen2_ligata(), "model.foo") ≡ "unknown canonical qwen2 tensor name: model.foo"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.x_proj") ≡ "unknown canonical qwen2 layer tensor suffix: .self_attn.x_proj"
    assert _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.o_proj.bias") ≡ "unknown canonical qwen2 layer tensor suffix: .self_attn.o_proj.bias"
    assert _resolve_render(_qwen2_ligata(), "model.layers.24.input_layernorm") ≡ "layer index out of range for canonical tensor: model.layers.24.input_layernorm"
    assert _resolve_render(_qwen2_ligata(), "model.layers.1.input_layernorm") ≡ "canonical model.layers.1.input_layernorm missing from manifest: blk.1.attn_norm.weight"
}

test "rejects a non-qwen2 manifest with the architecture diagnostic" {
    assert _config_render(_llama()) ≡ "architecture is not qwen2: llama"
}
