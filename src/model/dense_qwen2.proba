# REF-01-U1.7 — typed `qwen2` (Qwen2.5) architecture adapter, descriptor
# resolution pins.
#
# The proba pins each canonical dense tensor name to the exact manifest
# descriptor facts (GGUF name, shape, layout) the GGUF-A1b inspect surface
# reports for the pinned Qwen2.5-0.5B row, plus the qwen2 deltas (tie status
# read from the tensor set, GQA head config, rope_theta 1000000) and the
# fail-closed rejection rows. Like the A1b precedent, `faber check` proves
# the builders, parse calls, returned-field access, and typed-error branches
# type-check; the current imported-library `faber test` route is
# provider-blocked, so this file makes no executed-value claim. The executed
# proof lives in exempla/dense-qwen2-adapter.

importa ex "gradus:model/artifact" artifact
importa ex "gradus:model/gguf_manifest" manifestum
importa ex "gradus:model/dense_qwen2" dense_qwen2

fixum textus F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

functio _u8(numerus n) → lista<numerus<u8>> {
    redde [(n % 256) ∷ numerus<u8>]
}

functio _u16(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>
    ]
}

functio _u32(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>,
        ((n ⇒ 16) % 256) ∷ numerus<u8>,
        ((n ⇒ 24) % 256) ∷ numerus<u8>
    ]
}

functio _u64(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>,
        ((n ⇒ 16) % 256) ∷ numerus<u8>,
        ((n ⇒ 24) % 256) ∷ numerus<u8>,
        ((n ⇒ 32) % 256) ∷ numerus<u8>,
        ((n ⇒ 40) % 256) ∷ numerus<u8>,
        ((n ⇒ 48) % 256) ∷ numerus<u8>,
        ((n ⇒ 56) % 256) ∷ numerus<u8>
    ]
}

functio _iunge(lista<numerus<u8>> a, lista<numerus<u8>> b) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    itera ex a fixum x { out.appende(x) }
    itera ex b fixum x { out.appende(x) }
    redde out
}

# Fixture byte encoding for the finite ASCII keys/values this builder uses.
functio _textus_bytes(textus s) → lista<numerus<u8>> {
    si s ≡ "general.architecture" ergo redde [103,101,110,101,114,97,108,46,97,114,99,104,105,116,101,99,116,117,114,101]
    si s ≡ "qwen2" ergo redde [113,119,101,110,50]
    si s ≡ "llama" ergo redde [108,108,97,109,97]
    si s ≡ "qwen2.block_count" ergo redde [113,119,101,110,50,46,98,108,111,99,107,95,99,111,117,110,116]
    si s ≡ "qwen2.attention.head_count" ergo redde [113,119,101,110,50,46,97,116,116,101,110,116,105,111,110,46,104,101,97,100,95,99,111,117,110,116]
    si s ≡ "qwen2.attention.head_count_kv" ergo redde [113,119,101,110,50,46,97,116,116,101,110,116,105,111,110,46,104,101,97,100,95,99,111,117,110,116,95,107,118]
    si s ≡ "qwen2.embedding_length" ergo redde [113,119,101,110,50,46,101,109,98,101,100,100,105,110,103,95,108,101,110,103,116,104]
    si s ≡ "token_embd.weight" ergo redde [116,111,107,101,110,95,101,109,98,100,46,119,101,105,103,104,116]
    si s ≡ "output_norm.weight" ergo redde [111,117,116,112,117,116,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ "output.weight" ergo redde [111,117,116,112,117,116,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_norm.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_q.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,113,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_k.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,107,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_v.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,118,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_output.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,111,117,116,112,117,116,46,119,101,105,103,104,116]
    si s ≡ "blk.0.ffn_norm.weight" ergo redde [98,108,107,46,48,46,102,102,110,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ "blk.0.ffn_gate.weight" ergo redde [98,108,107,46,48,46,102,102,110,95,103,97,116,101,46,119,101,105,103,104,116]
    si s ≡ "blk.0.ffn_up.weight" ergo redde [98,108,107,46,48,46,102,102,110,95,117,112,46,119,101,105,103,104,116]
    si s ≡ "blk.0.ffn_down.weight" ergo redde [98,108,107,46,48,46,102,102,110,95,100,111,119,110,46,119,101,105,103,104,116]
    si s ≡ "blk.23.attn_norm.weight" ergo redde [98,108,107,46,50,51,46,97,116,116,110,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ "blk.23.attn_q.weight" ergo redde [98,108,107,46,50,51,46,97,116,116,110,95,113,46,119,101,105,103,104,116]
    si s ≡ "blk.23.ffn_down.weight" ergo redde [98,108,107,46,50,51,46,102,102,110,95,100,111,119,110,46,119,101,105,103,104,116]
    si s ≡ "blk.24.attn_norm.weight" ergo redde [98,108,107,46,50,52,46,97,116,116,110,95,110,111,114,109,46,119,101,105,103,104,116]
    redde []
}

functio _str(textus s) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> b ← _textus_bytes(s)
    redde _iunge(_u64(b.longitudo()), b)
}

functio _kv(textus key, numerus typo, lista<numerus<u8>> value) → lista<numerus<u8>> {
    redde _iunge(_iunge(_str(key), _u32(typo)), value)
}

functio _tensor(textus name, lista<numerus> forma, numerus typo, numerus offset) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← _iunge(_str(name), _u32(forma.longitudo()))
    itera ex forma fixum dim { out ← _iunge(out, _u64(dim)) }
    redde _iunge(_iunge(out, _u32(typo)), _u64(offset))
}

functio _caput(numerus tensorum, numerus metadata) → lista<numerus<u8>> {
    redde _iunge(
        _iunge([0x47, 0x47, 0x55, 0x46], _u32(3)),
        _iunge(_u64(tensorum), _u64(metadata))
    )
}

functio _octeti(lista<numerus<u8>> b) → octeti {
    varia octeti o ← ||
    itera ex b fixum x { o.appende(x) }
    redde o
}

functio _corpus(lista<numerus<u8>> table, numerus concordatio, numerus payload) → manifestum.CorpusGguf {
    fixum numerus data_offset ← ((table.longitudo() + concordatio - 1) / concordatio) * concordatio
    varia lista<numerus<u8>> b ← table
    dum b.longitudo() < data_offset { b.appende(0 ∷ numerus<u8>) }
    fixum octeti o ← _octeti(b)
    redde manifestum.CorpusGguf {
        tabula = o,
        longitudo_artifacti = data_offset + payload,
        identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = data_offset + payload }
    }
}

# Known GGML payload byte length for the fixture types (mirrors the A1a
# fixture geometry; the manifest layout() facts are asserted separately).
functio _longitudo_payloadis(numerus typo, lista<numerus> forma) → numerus {
    varia numerus elementa ← 1
    itera ex forma fixum d { elementa ← elementa * d }
    si typo ≡ 0 ergo redde elementa * 4
    si typo ≡ 6 ergo redde (elementa / 32) * 22
    si typo ≡ 8 ergo redde (elementa / 32) * 34
    si typo ≡ 12 ergo redde (elementa / 256) * 144
    si typo ≡ 14 ergo redde (elementa / 256) * 210
    redde 0
}

# Synthetic qwen2 manifest with the canonical tensor table for the pinned
# Qwen2.5-0.5B row: layer 0 full + layer 23 boundary, tied embeddings (no
# output.weight). Shapes/types mirror the A1b inspect surface facts.
functio _qwen2_ligata() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(14, 5)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen2")))
    table ← _iunge(table, _kv("qwen2.block_count", 4, _u32(24)))
    table ← _iunge(table, _kv("qwen2.attention.head_count", 4, _u32(14)))
    table ← _iunge(table, _kv("qwen2.attention.head_count_kv", 4, _u32(2)))
    table ← _iunge(table, _kv("qwen2.embedding_length", 4, _u32(896)))
    varia numerus off ← 0
    table ← _iunge(table, _tensor("token_embd.weight", [896, 151936], 8, off))
    off ← off + _longitudo_payloadis(8, [896, 151936])
    table ← _iunge(table, _tensor("output_norm.weight", [896], 0, off))
    off ← off + _longitudo_payloadis(0, [896])
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [896], 0, off))
    off ← off + _longitudo_payloadis(0, [896])
    table ← _iunge(table, _tensor("blk.0.attn_q.weight", [896, 896], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 896])
    table ← _iunge(table, _tensor("blk.0.attn_k.weight", [896, 128], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 128])
    table ← _iunge(table, _tensor("blk.0.attn_v.weight", [896, 128], 8, off))
    off ← off + _longitudo_payloadis(8, [896, 128])
    table ← _iunge(table, _tensor("blk.0.attn_output.weight", [896, 896], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 896])
    table ← _iunge(table, _tensor("blk.0.ffn_norm.weight", [896], 0, off))
    off ← off + _longitudo_payloadis(0, [896])
    table ← _iunge(table, _tensor("blk.0.ffn_gate.weight", [896, 4864], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 4864])
    table ← _iunge(table, _tensor("blk.0.ffn_up.weight", [896, 4864], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 4864])
    table ← _iunge(table, _tensor("blk.0.ffn_down.weight", [4864, 896], 14, off))
    off ← off + _longitudo_payloadis(14, [4864, 896])
    table ← _iunge(table, _tensor("blk.23.attn_norm.weight", [896], 0, off))
    off ← off + _longitudo_payloadis(0, [896])
    table ← _iunge(table, _tensor("blk.23.attn_q.weight", [896, 896], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 896])
    table ← _iunge(table, _tensor("blk.23.ffn_down.weight", [4864, 896], 12, off))
    off ← off + _longitudo_payloadis(12, [4864, 896])
    redde _corpus(table, 32, off)
}

# Untied variant: the same canonical table plus output.weight.
functio _qwen2_soluta() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(15, 5)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen2")))
    table ← _iunge(table, _kv("qwen2.block_count", 4, _u32(24)))
    table ← _iunge(table, _kv("qwen2.attention.head_count", 4, _u32(14)))
    table ← _iunge(table, _kv("qwen2.attention.head_count_kv", 4, _u32(2)))
    table ← _iunge(table, _kv("qwen2.embedding_length", 4, _u32(896)))
    varia numerus off ← 0
    table ← _iunge(table, _tensor("token_embd.weight", [896, 151936], 8, off))
    off ← off + _longitudo_payloadis(8, [896, 151936])
    table ← _iunge(table, _tensor("output_norm.weight", [896], 0, off))
    off ← off + _longitudo_payloadis(0, [896])
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [896], 0, off))
    off ← off + _longitudo_payloadis(0, [896])
    table ← _iunge(table, _tensor("blk.0.attn_q.weight", [896, 896], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 896])
    table ← _iunge(table, _tensor("blk.0.attn_k.weight", [896, 128], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 128])
    table ← _iunge(table, _tensor("blk.0.attn_v.weight", [896, 128], 8, off))
    off ← off + _longitudo_payloadis(8, [896, 128])
    table ← _iunge(table, _tensor("blk.0.attn_output.weight", [896, 896], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 896])
    table ← _iunge(table, _tensor("blk.0.ffn_norm.weight", [896], 0, off))
    off ← off + _longitudo_payloadis(0, [896])
    table ← _iunge(table, _tensor("blk.0.ffn_gate.weight", [896, 4864], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 4864])
    table ← _iunge(table, _tensor("blk.0.ffn_up.weight", [896, 4864], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 4864])
    table ← _iunge(table, _tensor("blk.0.ffn_down.weight", [4864, 896], 14, off))
    off ← off + _longitudo_payloadis(14, [4864, 896])
    table ← _iunge(table, _tensor("output.weight", [896, 151936], 8, off))
    off ← off + _longitudo_payloadis(8, [896, 151936])
    redde _corpus(table, 32, off)
}

# Rejection corpus: architecture is llama, not qwen2.
functio _llama() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 1)
    table ← _iunge(table, _kv("general.architecture", 8, _str("llama")))
    table ← _iunge(table, _tensor("token_embd.weight", [960, 49152], 8, 0))
    redde _corpus(table, 32, _longitudo_payloadis(8, [960, 49152]))
}

# Resolution render: gguf-name/shape/layout or a typed error.
functio _resolve_render(manifestum.CorpusGguf corpus, textus nomen) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum dense_qwen2.ConfiguraDensaQwen2 cfg ← dense_qwen2.configura(m)
            fixum manifestum.DescriptioTensorisGguf t ← dense_qwen2.resolve(cfg, m, nomen)
            redde dense_qwen2.descriptio_render(t)
        }
        cape err { redde dense_qwen2.causa(err) }
    }
    cape err { redde manifestum.causa(err) }
}

functio _configura_render(manifestum.CorpusGguf corpus) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum dense_qwen2.ConfiguraDensaQwen2 cfg ← dense_qwen2.configura(m)
            redde (cfg.strata ↦ textus) + "/" + (cfg.capita ↦ textus) + "/" + (cfg.capita_kv ↦ textus) + "/" + (cfg.dimensio_capitis ↦ textus) + "/" + (cfg.dimensio_occulta ↦ textus) + "/" + (cfg.vocabulum ↦ textus) + "/" + (cfg.theta ↦ textus) + "/" + (cfg.ligatum ↦ textus)
        }
        cape err { redde dense_qwen2.causa(err) }
    }
    cape err { redde manifestum.causa(err) }
}

probandum "REF-01-U1.7 qwen2 architecture adapter descriptor resolution" {
    proba "freezes the Qwen2.5-0.5B architecture config from the manifest" {
        adfirma _configura_render(_qwen2_ligata()) ≡ "24/14/2/64/896/151936/1000000/true"
        adfirma _configura_render(_qwen2_soluta()) ≡ "24/14/2/64/896/151936/1000000/false"
    }

    proba "resolves every canonical tensor name to the exact A1b descriptor facts" {
        adfirma _resolve_render(_qwen2_ligata(), "model.embed_tokens") ≡ "token_embd.weight/896,151936/known/32"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.0.input_layernorm") ≡ "blk.0.attn_norm.weight/896/known/1"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.q_proj") ≡ "blk.0.attn_q.weight/896,896/known/32"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.k_proj") ≡ "blk.0.attn_k.weight/896,128/known/32"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.v_proj") ≡ "blk.0.attn_v.weight/896,128/known/32"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.o_proj") ≡ "blk.0.attn_output.weight/896,896/known/32"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.0.post_attention_layernorm") ≡ "blk.0.ffn_norm.weight/896/known/1"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.0.mlp.gate_proj") ≡ "blk.0.ffn_gate.weight/896,4864/known/32"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.0.mlp.up_proj") ≡ "blk.0.ffn_up.weight/896,4864/known/32"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.0.mlp.down_proj") ≡ "blk.0.ffn_down.weight/4864,896/known/256"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.23.input_layernorm") ≡ "blk.23.attn_norm.weight/896/known/1"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.23.self_attn.q_proj") ≡ "blk.23.attn_q.weight/896,896/known/32"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.23.mlp.down_proj") ≡ "blk.23.ffn_down.weight/4864,896/known/256"
        adfirma _resolve_render(_qwen2_ligata(), "model.norm") ≡ "output_norm.weight/896/known/1"
    }

    proba "resolves lm_head from the tensor set: tied row → token_embd, untied row → output" {
        adfirma _resolve_render(_qwen2_ligata(), "lm_head") ≡ "token_embd.weight/896,151936/known/32"
        adfirma _resolve_render(_qwen2_soluta(), "lm_head") ≡ "output.weight/896,151936/known/32"
    }

    proba "fails closed on unknown canonical names, layer range, and missing tensors" {
        adfirma _resolve_render(_qwen2_ligata(), "model.foo") ≡ "unknown canonical qwen2 tensor name: model.foo"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.x_proj") ≡ "unknown canonical qwen2 layer tensor suffix: .self_attn.x_proj"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.24.input_layernorm") ≡ "layer index out of range for canonical tensor: model.layers.24.input_layernorm"
        adfirma _resolve_render(_qwen2_ligata(), "model.layers.1.input_layernorm") ≡ "canonical model.layers.1.input_layernorm missing from manifest: blk.1.attn_norm.weight"
    }

    proba "rejects a non-qwen2 manifest with the architecture diagnostic" {
        adfirma _configura_render(_llama()) ≡ "architecture is not qwen2: llama"
    }
}
