test "TensorDirectory LoadView AttnResQuery, FuseWeight, and apply_load_view_f32" {
    do {
        let list<f32> gate_up ← [1.0 ∷ f32, 2.0 ∷ f32, 3.0 ∷ f32, 4.0 ∷ f32, 5.0 ∷ f32, 6.0 ∷ f32]
        let list<f32> gate_only ← td.apply_load_view_f32(variant td.LoadView.FusedGateUpSplit { gate_rows = 2, up_rows = 1, select_up = false }, [3, 2], gate_up)
        assert gate_only.length() ≡ 4
        assert gate_only[0] ≡ (1.0 ∷ f32) and gate_only[3] ≡ (4.0 ∷ f32)

        let list<f32> up_only ← td.apply_load_view_f32(variant td.LoadView.FusedGateUpSplit { gate_rows = 2, up_rows = 1, select_up = true }, [3, 2], gate_up)
        assert up_only.length() ≡ 2
        assert up_only[0] ≡ (5.0 ∷ f32) and up_only[1] ≡ (6.0 ∷ f32)

        let list<f32> q1d ← [0.25 ∷ f32, 0.5 ∷ f32]
        let list<f32> q_exp ← td.apply_load_view_f32(variant td.LoadView.AttnResQuery { head_rows = 3, hidden_dim = 2 }, [2], q1d)
        assert q_exp.length() ≡ 6
        assert q_exp[4] ≡ (0.25 ∷ f32) and q_exp[5] ≡ (0.5 ∷ f32)

        let list<int> q_shape ← td.view_shape(variant td.LoadView.AttnResQuery { head_rows = 3, hidden_dim = 2 }, [2])
        assert q_shape.length() ≡ 2 and q_shape[0] ≡ 3 and q_shape[1] ≡ 2

        let list<f32> fw ← [
            0.0 ∷ f32, 0.0 ∷ f32, 0.0 ∷ f32, 0.0 ∷ f32,
            1.0 ∷ f32, 2.0 ∷ f32, 3.0 ∷ f32, 4.0 ∷ f32,
            0.0 ∷ f32, 0.0 ∷ f32, 0.0 ∷ f32, 0.0 ∷ f32,
            2.0 ∷ f32, 2.0 ∷ f32, 2.0 ∷ f32, 2.0 ∷ f32
        ]
        let list<int> fw_shape ← td.view_shape(variant td.LoadView.FuseWeight { rows = 4, taps = 4 }, [4, 4])
        assert fw_shape.length() ≡ 2 and fw_shape[0] ≡ 4 and fw_shape[1] ≡ 4
        let list<f32> fw_out ← td.apply_load_view_f32(variant td.LoadView.FuseWeight { rows = 4, taps = 4 }, [4, 4], fw)
        assert fw_out.length() ≡ 16
        assert fw_out[0] ≻ (0.24 ∷ f32) and fw_out[0] ≺ (0.26 ∷ f32)
        assert fw_out[7] ≻ fw_out[6] and fw_out[6] ≻ fw_out[5] and fw_out[5] ≻ fw_out[4]
        assert (fw_out[4] + fw_out[5] + fw_out[6] + fw_out[7]) ≻ (0.999 ∷ f32) and (fw_out[4] + fw_out[5] + fw_out[6] + fw_out[7]) ≺ (1.001 ∷ f32)

        # AttnResQuery [D, 3] -> [3, D] transpose
        let list<f32> q_d3 ← [1.0 ∷ f32, 10.0 ∷ f32, 100.0 ∷ f32, 2.0 ∷ f32, 20.0 ∷ f32, 200.0 ∷ f32]
        let list<f32> q_3d ← td.apply_load_view_f32(variant td.LoadView.AttnResQuery { head_rows = 3, hidden_dim = 2 }, [2, 3], q_d3)
        assert q_3d.length() ≡ 6
        assert q_3d[0] ≡ (1.0 ∷ f32) and q_3d[1] ≡ (2.0 ∷ f32)
        assert q_3d[2] ≡ (10.0 ∷ f32) and q_3d[3] ≡ (20.0 ∷ f32)
        assert q_3d[4] ≡ (100.0 ∷ f32) and q_3d[5] ≡ (200.0 ∷ f32)

        # Conv1dLayout transpose [C, K] -> [K, C] + kernel tap flip
        let list<f32> conv_ck ← [1.0 ∷ f32, 2.0 ∷ f32, 3.0 ∷ f32, 4.0 ∷ f32, 5.0 ∷ f32, 6.0 ∷ f32]
        let list<int> conv_kc_shape ← td.view_shape(variant td.LoadView.Conv1dLayout { channels = 2, kernel_size = 3, transpose_to_kc = true, flip_kernel = true }, [2, 3])
        assert conv_kc_shape[0] ≡ 3 and conv_kc_shape[1] ≡ 2
        let list<f32> conv_kc ← td.apply_load_view_f32(variant td.LoadView.Conv1dLayout { channels = 2, kernel_size = 3, transpose_to_kc = true, flip_kernel = true }, [2, 3], conv_ck)
        assert conv_kc[0] ≡ (3.0 ∷ f32) and conv_kc[1] ≡ (6.0 ∷ f32) and conv_kc[4] ≡ (1.0 ∷ f32) and conv_kc[5] ≡ (4.0 ∷ f32)

        # FusedGateUpInterleaved extracts alternating gate/up rows
        let list<f32> gu_inter ← [10.0 ∷ f32, 11.0 ∷ f32, 20.0 ∷ f32, 21.0 ∷ f32, 30.0 ∷ f32, 31.0 ∷ f32, 40.0 ∷ f32, 41.0 ∷ f32]
        let list<f32> g_rows ← td.apply_load_view_f32(variant td.LoadView.FusedGateUpInterleaved { gate_rows = 2, up_rows = 2, select_up = false }, [4, 2], gu_inter)
        let list<f32> u_rows ← td.apply_load_view_f32(variant td.LoadView.FusedGateUpInterleaved { gate_rows = 2, up_rows = 2, select_up = true }, [4, 2], gu_inter)
        assert g_rows[0] ≡ (10.0 ∷ f32) and g_rows[2] ≡ (30.0 ∷ f32)
        assert u_rows[0] ≡ (20.0 ∷ f32) and u_rows[2] ≡ (40.0 ∷ f32)
    }
    catch err {
        assert false
    }
}

test "TensorDirectory ModelOpt w13_weight/w2_weight siblings, GGUF MoE/sinks/norm canonicalization, and strict indexed/length validation" {
    # GGUF canonicalization
    assert td.canonicalize_gguf_name("blk.0.ffn_gate_exps.weight") ≡ "model.layers.0.mlp.experts.gate_proj.weight"
    assert td.canonicalize_gguf_name("blk.1.ffn_up_exps.weight") ≡ "model.layers.1.mlp.experts.up_proj.weight"
    assert td.canonicalize_gguf_name("blk.2.ffn_down_exps.weight") ≡ "model.layers.2.mlp.experts.down_proj.weight"
    assert td.canonicalize_gguf_name("blk.3.ffn_gate_up_exps.weight") ≡ "model.layers.3.mlp.experts.gate_up_proj.weight"
    assert td.canonicalize_gguf_name("blk.4.ffn_gate_inp.weight") ≡ "model.layers.4.mlp.gate.weight"
    assert td.canonicalize_gguf_name("blk.5.post_attention_norm.weight") ≡ "model.layers.5.post_attention_layernorm.weight"
    assert td.canonicalize_gguf_name("blk.6.attn_q_norm.weight") ≡ "model.layers.6.self_attn.q_norm.weight"
    assert td.canonicalize_gguf_name("blk.6.attn_k_norm.weight") ≡ "model.layers.6.self_attn.k_norm.weight"
    assert td.canonicalize_gguf_name("blk.7.attn_sinks.weight") ≡ "model.layers.7.self_attn.sinks.weight"
    assert td.canonicalize_gguf_name("blk.7.softmax_offset") ≡ "model.layers.7.self_attn.softmax_offset"

    let artifact.ContentIdentity bb_id ← id_with("f", 4096)
    let bundle.ModelBundle b ← mk_unindexed([bb_id], null, null, null)
    do {
        # Raw HF ModelOpt w13_weight / w2_weight + _scale + _amax + _outer_scale_denominator
        let capsule.SafetensorsManifest m ← st_manifest(4096, 2048, [
            st_desc("model.layers.0.mlp.experts.w13_weight", "U8", [128, 512, 1024], 0, 512, 67108864),
            st_desc("model.layers.0.mlp.experts.w13_weight._scale", "U8", [128, 512, 64], 512, 768, 4194304),
            st_desc("model.layers.0.mlp.experts.w13_weight._amax", "F32", [1], 768, 772, 1),
            st_desc("model.layers.0.mlp.experts.w13_weight._outer_scale_denominator", "F32", [1], 772, 776, 1),
            st_desc("model.layers.0.mlp.experts.w2_weight", "U8", [128, 1024, 256], 776, 1288, 33554432),
            st_desc("model.layers.0.mlp.experts.w2_weight._scale", "U8", [128, 1024, 16], 1288, 1544, 2097152)
        ])
        let td.TensorDirectory dir ← td.build(b, [
            variant td.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = m }
        ], [], [])

        let td.SiblingSet w13 ← td.siblings(dir, variant bundle.MemberRole.Backbone, "model.layers.0.mlp.experts.gate_up_proj")
        assert w13.weight.source_name ≡ "model.layers.0.mlp.experts.w13_weight"
        assert w13.scales not is none
        assert w13.amax not is none
        assert w13.outer_scale_denominator not is none

        let td.SiblingSet w2 ← td.siblings(dir, variant bundle.MemberRole.Backbone, "model.layers.0.mlp.experts.w2")
        assert w2.weight.source_name ≡ "model.layers.0.mlp.experts.w2_weight"
        assert w2.scales not is none

        # Reject Safetensors artifact_length < member.identity.length (strict equality)
        mut bool caught_len ← false
        do {
            let capsule.SafetensorsManifest short_m ← st_manifest(2048, 1024, [st_desc("w", "F32", [4], 0, 16, 4)])
            td.build(b, [variant td.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = short_m }], [], [])
        }
        catch err {
            caught_len ← true
        }
        assert caught_len

        # Reject ShardMapping.Indexed when an indexed tensor is missing from ingested shards
        let bundle.ModelBundle idx_b ← mk_indexed([bb_id], id_with("e", 128), [
            bundle.ShardEntry { tensor_name = "present.weight", shard_index = 0 },
            bundle.ShardEntry { tensor_name = "missing.weight", shard_index = 0 }
        ])
        mut bool caught_missing ← false
        do {
            let capsule.SafetensorsManifest partial_m ← st_manifest(4096, 1024, [st_desc("present.weight", "F32", [4], 0, 16, 4)])
            td.build(idx_b, [variant td.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = partial_m }], [], [])
        }
        catch err {
            caught_missing ← true
        }
        assert caught_missing

        # Reject GgufManifest containing GgmlLayout.Unknown
        let artifact.ContentIdentity gguf_id ← id_with("c", 4096)
        mut bundle.ModelBundle ∪ none maybe_gguf_b ← null
        do {
            maybe_gguf_b ← bundle.gguf_single(gguf_id)
        }
        catch err {
            assert false
        }
        if maybe_gguf_b is none {
            assert false
        }
        else {
            let bundle.ModelBundle gguf_b ← maybe_gguf_b
            let gguf_manifest.GgufManifest bad_gm ← gguf_manifest.GgufManifest {
                identity = gguf_id,
                version = 3,
                alignment = 32,
                data_start = 128,
                artifact_length = 4096,
                metadata = [],
                tensors = [
                    gguf_manifest.GgufTensorDescriptor {
                        name = "token_embd.weight",
                        shape = [2048, 248320],
                        dtype_ggml = 999,
                        representation = storage.representation("ggml", "unknown", "unspecified", 999),
                        relative_offset = 0,
                        elements = 508559360,
                        layout = variant gguf_manifest.GgmlLayout.Unknown { dtype = 999 },
                        block = storage.BlockMetadata { known = false, elements_per_block = 0, bytes_per_block = 0, block_count = 0, byte_length = 0 }
                    }
                ]
            }
            mut bool caught_unknown_ggml ← false
            do {
                td.build(gguf_b, [variant td.ShardSource.GgufSource { role = variant bundle.MemberRole.Backbone, manifest = bad_gm }], [], [])
            }
            catch err {
                caught_unknown_ggml ← true
            }
            assert caught_unknown_ggml
        }
    }
    catch err {
        assert false
    }
}
