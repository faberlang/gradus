# Safetensors row admission — one pinned Safetensors row parses into the
# admitted-model capsule, fail-closed (PML2-U2, Lane 1).
#
# Public import: importa ex "gradus:model/safetensors" privata safetensors
# Depends on: gradus:model/capsule (the PML2-U1 admitted-model capsule,
# capsule-schema-1.0.0). This module is the U2 seam: raw Safetensors bytes
# in -> capsula.Capsula out. Raw bytes and paths are NEVER trust anchors
# (capsule contract, council C8) — only the capsule carries identity.

importa ex "gradus:model/capsule" privata capsula
#
# --- Contract ------------------------------------------------------------
#
# One Safetensors row is admitted: the pinned scaled row of
# fixtures/safetensors/safetensors-row-oracle.md (smollm2-360m-scaled-row),
# a structural stand-in for the SmolLM2-360M-Instruct row of
# gi0-model-contract 1.0.0. The row facts (arch llama/dense, gpt2/smollm
# tokenizer identity, F32-only tensor table, ceilings) are pinned below as
# constants; ANY deviation fails closed with a typed SafetensorError before
# any allocation sized by an attacker-controlled count. The capsule
# certifies exactly the row this module admitted; the digest VALUE is
# host-computed and passed in (the language surface has no digest
# primitive — capsule.fab header, GI1 boundary), its form is validated
# here and its correctness re-verifiable via capsule.verifica_contra.
#
# Container facts (Safetensors reference format): an 8-byte little-endian
# u64 header_size INCLUDES the 8-byte prefix; the JSON header occupies
# [8, header_size); the data region starts at header_size (8-aligned) and
# tensor data_offsets are relative to it. The pinned row's data region
# tiles exactly (coverage true): intervals are non-overlapping and their
# total length equals the data-region length, so no gap/overlap/misalignment
# can be admitted (capsule BytesValida.opertum = true).
#
# Typed error vocabulary (SafetensorError, variant -> class):
#   FormaMala       — container/JSON format violations (truncation,
#                     non-JSON, non-object header, format-name mismatch,
#                     malformed members/separators).
#   VersioIgnota    — unsupported pinned row version.
#   ArchitecturaMala— architecture facts mismatch (or tensor outside the
#                     admitted row / tensor-table mismatch).
#   TypoIgnotum     — unsupported tensor dtype.
#   OffscetaMala    — data-offset violations (bounds, 8-byte misalignment,
#                     duplicate tensor name, overlapping regions, gapped /
#                     non-tiling data region).
#   FiguraMala      — shape violations (non-positive dim, shape mismatch,
#                     shape/offset byte-length inconsistency).
#   TokenizerMala   — tokenizer identity mismatch (kind / pre-tokenizer /
#                     EOG set / BOS-free / space-prefix-free facts).
#   LimitesMala     — ceilings: header size, token count, metadata KV
#                     count, tensor count, name length, dimension size,
#                     total elements.
#   DigestioMala    — malformed digest claim (row digest or vocab digest).
#   MerciumMala     — metadata structure violations (missing __metadata__,
#                     missing required key, non-string metadata value).
#   IngressioMala   — the capsule constructor rejected the validated row
#                     (defense-in-depth; should not fire on admitted rows).
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * Cross-module enum variants are unsupported (SEM002/SEM041), so this
#     module defines its OWN typed error vocabulary (above) mirroring the
#     capsule's AdmissionError classes, and renders capsule errors via
#     capsula.causa on conversion.
#   * The language has no codepoint/ord intrinsic: a \uXXXX escape is
#     form-validated (4 hex digits) but preserved VERBATIM in the token
#     value. Every pinned row constant is pure ASCII, so any escape in an
#     admitted-relevant field changes the compared value and fails closed;
#     ignored fields carry the verbatim token (documented, fail-closed).
#   * Proba proof is compile-level (`faber check src/model/safetensors.proba`):
#     execution (`faber test`) is blocked tree-wide by the missing locale
#     pack (radix/stdlib/reader/la/pack.toml) and the recorded FMIR
#     stepper limitation (see capsule.proba header). The proba reconstructs
#     the pinned fixture bytes from the same JSON + data pattern as the
#     committed generator, so the oracle hash binds both.
#
# --- Seams ---------------------------------------------------------------
#   * GGUF row admission (parallel U3, hand-4) — disjoint format file.
#   * tokenizer probe parity (P1–P11, vocab digest execution) — PML2-U4.
#   * norma:model + GI1 admission migration (no dual authority) — PML2-U5.
#   * digest computation — the admission host (pure-Rust, GI1).
#   * forward architectures / new rows — PML3 (R3: the pinned constants
#     below are the one place a second row extends).

# -------------------------------------------------------------------------
# Pinned row constants (R3: extend here for a second row). Mirror values of
# the capsule contract where the capsule checks form (schema, digest
# algorithm, quantization row, ceilings).
# -------------------------------------------------------------------------

# Capsule contract mirrors (capsule-schema-1.0.0 / sha-256 / f32 1-4-32).
fixum textus CAPSULA_SCHEMA ← "1.0.0"
fixum textus DIGESTUM_SHA256 ← "sha-256"
fixum textus QUANTIZATIO_F32 ← "f32"
fixum numerus F32_ELEMENTA ← 1
fixum numerus F32_OCTETI ← 4
fixum numerus CONCORDATIO_QUANTIZATIO ← 32

# Pinned row facts (oracle doc; gi0-model-contract 1.0.0 sources).
fixum textus ROW_FORMAT_NOMEN ← "safetensors"
fixum textus ROW_FORMAT_VERSIO ← "1.0.0"
fixum textus ARCH_IDENTIFICATOR ← "llama"
fixum textus ARCH_DENSITAS ← "dense"
fixum numerus ARCH_STRATA ← 1
fixum textus ARCH_CONTEXTUS ← "2048"
fixum textus TOKENIZATOR_PROGENIES ← "gpt2"
fixum textus TOKENIZATOR_PRE ← "smollm"
fixum textus TOKENIZATOR_EOG ← "0,2"
fixum textus TOKENIZATOR_BOS ← "true"
fixum textus TOKENIZATOR_SPATIUM ← "true"
fixum textus DTYPE_F32 ← "F32"

# Metadata keys the pinned row must carry in __metadata__.
fixum textus K_FORMAT_NOMEN ← "format.name"
fixum textus K_FORMAT_VERSIO ← "format.version"
fixum textus K_ARCH ← "model.arch"
fixum textus K_DENSITAS ← "model.density"
fixum textus K_STRATA ← "model.layers"
fixum textus K_CONTEXTUS ← "model.context"
fixum textus K_PROGENIES ← "tokenizer.model"
fixum textus K_PRE ← "tokenizer.pre"
fixum textus K_VOCAB ← "tokenizer.vocab_digest"
fixum textus K_EOG ← "tokenizer.eog"
fixum textus K_BOS ← "tokenizer.bos_free"
fixum textus K_SPATIUM ← "tokenizer.space_prefix_free"

# Row ceilings (validated BEFORE any count-driven work; the capsule's
# Limites mirror). Safetensors alignment is 8 bytes; the capsule's
# quantization descriptor alignment (32) is the GGML block mirror — two
# distinct notions, both checked.
fixum numerus CONCORDATIO_FABRICA ← 8
fixum numerus CAPUT_LIMES ← 1048576
fixum numerus TOKENS_LIMES ← 4096
fixum numerus KV_LIMES ← 64
fixum numerus TENSORES_LIMES ← 16
fixum numerus NOMEN_LIMES ← 128
fixum numerus DIMENSI_LIMES ← 65536
fixum numerus ELEMENTA_LIMES ← 1000000000
fixum numerus TEXTUS_LIMES ← 4096
fixum numerus ARRAY_LIMES ← 16

# The admitted tensor table (name + expected shape). The proba and the
# committed fixture generator must agree byte-for-byte on the row.
fixum lista<textus> EXPECTATI_NOMINA ← [
    "model.embed_tokens.weight",
    "model.norm.weight",
    "model.layers.0.self_attn.q_proj.weight",
    "model.layers.0.self_attn.v_proj.weight",
    "model.layers.0.mlp.down_proj.weight"
]
fixum lista<lista<numerus>> EXPECTATAE_FORMAE ← [[8, 4], [8], [8, 8], [8, 4], [4, 8]]

# -------------------------------------------------------------------------
# SafetensorError — typed error vocabulary (variant -> class above).
# -------------------------------------------------------------------------

discretio SafetensorError {
    FormaMala { textus causa },
    VersioIgnota { textus causa },
    ArchitecturaMala { textus causa },
    TypoIgnotum { textus causa },
    OffscetaMala { textus causa },
    FiguraMala { textus causa },
    TokenizerMala { textus causa },
    LimitesMala { textus causa },
    DigestioMala { textus causa },
    MerciumMala { textus causa },
    IngressioMala { textus causa }
}

functio causa(SafetensorError e) → textus {
    discerne e {
        casu FormaMala fixum causa { redde causa }
        casu VersioIgnota fixum causa { redde causa }
        casu ArchitecturaMala fixum causa { redde causa }
        casu TypoIgnotum fixum causa { redde causa }
        casu OffscetaMala fixum causa { redde causa }
        casu FiguraMala fixum causa { redde causa }
        casu TokenizerMala fixum causa { redde causa }
        casu LimitesMala fixum causa { redde causa }
        casu DigestioMala fixum causa { redde causa }
        casu MerciumMala fixum causa { redde causa }
        casu IngressioMala fixum causa { redde causa }
    }
}

# -------------------------------------------------------------------------
# Same-module carriers (the walkers build these; all fields are module-
# internal). Public surface stays on primitives + capsula.Capsula so the
# proba file-interface keeps every export (WARN014 seam, same as
# parameter/serialize/capsule).
# -------------------------------------------------------------------------

# A JSON token: typo 0..10 = { } [ ] : , string number true false null.
genus Tokenum {
    numerus typo
    textus valor
}

# Extracted row structure after the header walk.
genus Structura {
    lista<textus> meta_claves
    lista<textus> meta_valores
    lista<textus> nomina
    lista<textus> dtypi
    lista<lista<numerus>> formae
    lista<numerus> initii
    lista<numerus> finis
}

# String-lexer result: new index + decoded value.
genus Stringum {
    numerus pos
    textus valor
}

# Metadata-object parse result.
genus MetaCursus {
    numerus pos
    lista<textus> claves
    lista<textus> valores
}

# Tensor-descriptor parse result.
genus TensorCursus {
    numerus pos
    textus typo
    lista<numerus> forma
    numerus initium
    numerus finis
}

# Number-array parse result.
genus NumeriCursus {
    numerus pos
    lista<numerus> valores
}

# Container-header parse result (header_size includes the 8-byte prefix).
genus CaputCursus {
    numerus caput
    textus textus
}

# -------------------------------------------------------------------------
# Character / value predicates (self-contained copies per leaf-module
# convention — the capsule's _est_hex/_hex_recta are module-private).
# -------------------------------------------------------------------------

@ privata
functio _est_digitum(textus c) → bivalens {
    redde c ≡ "0" aut c ≡ "1" aut c ≡ "2" aut c ≡ "3" aut c ≡ "4" aut c ≡ "5" aut c ≡ "6" aut c ≡ "7" aut c ≡ "8" aut c ≡ "9"
}

@ privata
functio _est_hex(textus c) → bivalens {
    si c ≡ "0" aut c ≡ "1" aut c ≡ "2" aut c ≡ "3" aut c ≡ "4" aut c ≡ "5" aut c ≡ "6" aut c ≡ "7" aut c ≡ "8" aut c ≡ "9" ergo redde verum
    si c ≡ "a" aut c ≡ "b" aut c ≡ "c" aut c ≡ "d" aut c ≡ "e" aut c ≡ "f" ergo redde verum
    redde falsum
}

@ privata
functio _est_sponte(textus c) → bivalens {
    redde c ≡ " " aut c ≡ "\t" aut c ≡ "\n" aut c ≡ "\r"
}

# Whole-digest predicate: exactly 64 lowercase hex characters.
@ privata
functio _hex_recta(textus s) → bivalens {
    si s.longitudo() ≠ 64 ergo redde falsum
    varia numerus i ← 0
    dum i < s.longitudo() {
        si non (_est_hex(s.sectio(i, i + 1))) ergo redde falsum
        i ← i + 1
    }
    redde verum
}

# -------------------------------------------------------------------------
# Byte-level helpers (Safetensors container).
# -------------------------------------------------------------------------

# 8-byte little-endian read at offset (bounds validated by callers).
@ privata
functio _le8(lista<numerus<u8>> b, numerus off) → numerus {
    fixum numerus r0 ← (b.accipe(off + 0) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r1 ← (b.accipe(off + 1) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r2 ← (b.accipe(off + 2) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r3 ← (b.accipe(off + 3) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r4 ← (b.accipe(off + 4) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r5 ← (b.accipe(off + 5) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r6 ← (b.accipe(off + 6) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r7 ← (b.accipe(off + 7) vel (0 ∷ numerus<u8>)) ↦ numerus
    redde r0 ∨ (r1 ⇐ 8) ∨ (r2 ⇐ 16) ∨ (r3 ⇐ 24) ∨ (r4 ⇐ 32) ∨ (r5 ⇐ 40) ∨ (r6 ⇐ 48) ∨ (r7 ⇐ 56)
}

# Container-header validation: the 8-byte LE header_size (which includes
# the prefix), bounds, 8-byte alignment, UTF-8 header textus extraction.
# Ceilings are checked BEFORE the header slice is materialized.
@ privata
functio _caput(lista<numerus<u8>> corpus) → CaputCursus ⇥ SafetensorError {
    si corpus.longitudo() < 8 {
        iace finge FormaMala { causa = "truncated safetensors header prefix" }
    }
    fixum numerus caput ← _le8(corpus, 0)
    si caput < 8 {
        iace finge FormaMala { causa = "invalid safetensors header size" }
    }
    si caput > CAPUT_LIMES {
        iace finge LimitesMala { causa = "header size above ceiling" }
    }
    si caput > corpus.longitudo() {
        iace finge FormaMala { causa = "truncated header — header size beyond file" }
    }
    si caput % CONCORDATIO_FABRICA ≠ 0 {
        iace finge FormaMala { causa = "misaligned safetensors header (not 8-byte aligned)" }
    }
    varia lista<numerus<u8>> sub ← vacua
    varia numerus i ← 8
    dum i < caput {
        sub.appende(corpus.accipe(i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    fixum octeti o ← sub
    fac {
        fixum textus t ← o ↦ textus
        redde CaputCursus { caput = caput, textus = t }
    }
    cape err {
        iace finge FormaMala { causa = "header is not valid UTF-8" }
    }
}

# -------------------------------------------------------------------------
# JSON tokenizer (strict lexical validation of the header).
# -------------------------------------------------------------------------

# Parse a JSON string starting at index i (the opening quote). Handles the
# standard escapes; \uXXXX is form-validated (4 hex digits) and preserved
# verbatim (no codepoint intrinsic — compiler-boundary note above).
@ privata
functio _lege_string(textus h, numerus i) → Stringum ⇥ SafetensorError {
    varia textus valor ← ""
    varia numerus pos ← i + 1
    dum pos < h.longitudo() {
        fixum textus c ← h.sectio(pos, pos + 1)
        si c ≡ "\"" {
            redde Stringum { pos = pos + 1, valor = valor }
        }
        si c ≡ "\\" {
            si pos + 1 ≥ h.longitudo() {
                iace finge FormaMala { causa = "unterminated string escape" }
            }
            fixum textus e ← h.sectio(pos + 1, pos + 2)
            si e ≡ "\"" {
                valor ← valor + "\""
                pos ← pos + 2
            }
            sin e ≡ "\\" {
                valor ← valor + "\\"
                pos ← pos + 2
            }
            sin e ≡ "/" {
                valor ← valor + "/"
                pos ← pos + 2
            }
            sin e ≡ "n" {
                valor ← valor + "\n"
                pos ← pos + 2
            }
            sin e ≡ "r" {
                valor ← valor + "\r"
                pos ← pos + 2
            }
            sin e ≡ "t" {
                valor ← valor + "\t"
                pos ← pos + 2
            }
            sin e ≡ "b" {
                valor ← valor + "\u{08}"
                pos ← pos + 2
            }
            sin e ≡ "f" {
                valor ← valor + "\u{0C}"
                pos ← pos + 2
            }
            sin e ≡ "u" {
                si pos + 5 ≥ h.longitudo() {
                    iace finge FormaMala { causa = "truncated \\u escape" }
                }
                fixum textus quad ← h.sectio(pos + 2, pos + 6)
                varia numerus j ← 0
                dum j < 4 {
                    si non (_est_hex(quad.sectio(j, j + 1))) {
                        iace finge FormaMala { causa = "malformed \\u escape" }
                    }
                    j ← j + 1
                }
                valor ← valor + "\\u" + quad
                pos ← pos + 6
            }
            secus {
                iace finge FormaMala { causa = "unknown string escape" }
            }
        }
        secus {
            si c ≡ "\n" aut c ≡ "\r" aut c ≡ "\t" aut c ≡ "\u{08}" aut c ≡ "\u{0C}" {
                iace finge FormaMala { causa = "unescaped control character in string" }
            }
            valor ← valor + c
            pos ← pos + 1
        }
    }
    iace finge FormaMala { causa = "unterminated string" }
}

# Parse a JSON number starting at index i (digit or minus). Returns the
# raw number textus (JSON grammar: -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?).
@ privata
functio _lege_number(textus h, numerus i) → Stringum ⇥ SafetensorError {
    varia numerus pos ← i
    si h.sectio(pos, pos + 1) ≡ "-" {
        pos ← pos + 1
        si pos ≥ h.longitudo() {
            iace finge FormaMala { causa = "malformed number" }
        }
    }
    si h.sectio(pos, pos + 1) ≡ "0" {
        pos ← pos + 1
        si pos < h.longitudo() et _est_digitum(h.sectio(pos, pos + 1)) {
            iace finge FormaMala { causa = "malformed number" }
        }
    }
    sin _est_digitum(h.sectio(pos, pos + 1)) {
        dum pos < h.longitudo() et _est_digitum(h.sectio(pos, pos + 1)) {
            pos ← pos + 1
        }
    }
    secus {
        iace finge FormaMala { causa = "malformed number" }
    }
    si pos < h.longitudo() et h.sectio(pos, pos + 1) ≡ "." {
        pos ← pos + 1
        si pos ≥ h.longitudo() aut non (_est_digitum(h.sectio(pos, pos + 1))) {
            iace finge FormaMala { causa = "malformed number" }
        }
        dum pos < h.longitudo() et _est_digitum(h.sectio(pos, pos + 1)) {
            pos ← pos + 1
        }
    }
    si pos < h.longitudo() et (h.sectio(pos, pos + 1) ≡ "e" aut h.sectio(pos, pos + 1) ≡ "E") {
        pos ← pos + 1
        si pos < h.longitudo() et (h.sectio(pos, pos + 1) ≡ "+" aut h.sectio(pos, pos + 1) ≡ "-") {
            pos ← pos + 1
        }
        si pos ≥ h.longitudo() aut non (_est_digitum(h.sectio(pos, pos + 1))) {
            iace finge FormaMala { causa = "malformed number" }
        }
        dum pos < h.longitudo() et _est_digitum(h.sectio(pos, pos + 1)) {
            pos ← pos + 1
        }
    }
    redde Stringum { pos = pos, valor = h.sectio(i, pos) }
}

# Tokenize the whole header (strict lexical validation, bounded token
# count — checked before more tokens are appended).
@ privata
functio _scander(textus h) → lista<Tokenum> ⇥ SafetensorError {
    varia lista<Tokenum> tks ← vacua
    varia numerus pos ← 0
    dum pos < h.longitudo() {
        fixum textus c ← h.sectio(pos, pos + 1)
        si _est_sponte(c) {
            pos ← pos + 1
        }
        sin c ≡ "{" {
            tks.appende(Tokenum { typo = 0, valor = "{" })
            pos ← pos + 1
        }
        sin c ≡ "}" {
            tks.appende(Tokenum { typo = 1, valor = "}" })
            pos ← pos + 1
        }
        sin c ≡ "[" {
            tks.appende(Tokenum { typo = 2, valor = "[" })
            pos ← pos + 1
        }
        sin c ≡ "]" {
            tks.appende(Tokenum { typo = 3, valor = "]" })
            pos ← pos + 1
        }
        sin c ≡ ":" {
            tks.appende(Tokenum { typo = 4, valor = ":" })
            pos ← pos + 1
        }
        sin c ≡ "," {
            tks.appende(Tokenum { typo = 5, valor = "," })
            pos ← pos + 1
        }
        sin c ≡ "\"" {
            fixum Stringum s ← _lege_string(h, pos)
            tks.appende(Tokenum { typo = 6, valor = s.valor })
            pos ← s.pos
        }
        sin _est_digitum(c) aut c ≡ "-" {
            fixum Stringum n ← _lege_number(h, pos)
            tks.appende(Tokenum { typo = 7, valor = n.valor })
            pos ← n.pos
        }
        sin c ≡ "t" {
            si h.sectio(pos, pos + 4) ≡ "true" {
                tks.appende(Tokenum { typo = 8, valor = "true" })
                pos ← pos + 4
            }
            secus {
                iace finge FormaMala { causa = "malformed literal" }
            }
        }
        sin c ≡ "f" {
            si h.sectio(pos, pos + 5) ≡ "false" {
                tks.appende(Tokenum { typo = 9, valor = "false" })
                pos ← pos + 5
            }
            secus {
                iace finge FormaMala { causa = "malformed literal" }
            }
        }
        sin c ≡ "n" {
            si h.sectio(pos, pos + 4) ≡ "null" {
                tks.appende(Tokenum { typo = 10, valor = "null" })
                pos ← pos + 4
            }
            secus {
                iace finge FormaMala { causa = "malformed literal" }
            }
        }
        secus {
            iace finge FormaMala { causa = "unexpected character in header" }
        }
        si tks.longitudo() > TOKENS_LIMES {
            iace finge LimitesMala { causa = "header token count above ceiling" }
        }
    }
    redde tks
}

# -------------------------------------------------------------------------
# JSON structural walk (strict grammar validation + pinned-row extraction).
# -------------------------------------------------------------------------

@ privata
functio _typo(lista<Tokenum> tks, numerus i) → numerus {
    fixum Tokenum t ← tks.accipe(i) vel Tokenum { typo = -1, valor = "" }
    redde t.typo
}

@ privata
functio _valor(lista<Tokenum> tks, numerus i) → textus {
    fixum Tokenum t ← tks.accipe(i) vel Tokenum { typo = -1, valor = "" }
    redde t.valor
}

# Integer-valued JSON number -> numerus (digits only, length-capped). A
# fractional/exponent number is not a valid shape dim or offset.
@ privata
functio _parsa_integrum(textus raw) → numerus ⇥ SafetensorError {
    si raw.longitudo() ≡ 0 {
        iace finge FormaMala { causa = "malformed integer" }
    }
    si raw.longitudo() > 18 {
        iace finge FormaMala { causa = "integer above the numeric carrier" }
    }
    varia numerus i ← 0
    dum i < raw.longitudo() {
        si non (_est_digitum(raw.sectio(i, i + 1))) {
            iace finge FormaMala { causa = "non-integer value" }
        }
        i ← i + 1
    }
    fac {
        fixum numerus v ← raw ↦ numerus
        redde v
    }
    cape err {
        iace finge FormaMala { causa = "malformed integer" }
    }
}

# Parse a JSON array of integers starting at pos (token typo 2). Bounded
# array length (shape rank / offsets / any numeric array).
@ privata
functio _parsa_numerorum(lista<Tokenum> tks, numerus pos) → NumeriCursus ⇥ SafetensorError {
    si _typo(tks, pos) ≠ 2 {
        iace finge FormaMala { causa = "expected an integer array" }
    }
    varia numerus p ← pos + 1
    varia lista<numerus> valores ← vacua
    dum p < tks.longitudo() {
        si _typo(tks, p) ≡ 3 {
            p ← p + 1
            redde NumeriCursus { pos = p, valores = valores }
        }
        si _typo(tks, p) ≠ 7 {
            iace finge FormaMala { causa = "array must contain only integers" }
        }
        valores.appende(_parsa_integrum(_valor(tks, p)))
        p ← p + 1
        si valores.longitudo() > ARRAY_LIMES {
            iace finge LimitesMala { causa = "array above length ceiling" }
        }
        si p ≥ tks.longitudo() {
            iace finge FormaMala { causa = "unterminated array" }
        }
        si _typo(tks, p) ≡ 5 {
            p ← p + 1
            si p ≥ tks.longitudo() aut _typo(tks, p) ≡ 3 {
                iace finge FormaMala { causa = "trailing comma in array" }
            }
        }
        sin _typo(tks, p) ≠ 3 {
            iace finge FormaMala { causa = "malformed array separator" }
        }
    }
    iace finge FormaMala { causa = "unterminated array" }
}

# Parse the __metadata__ object: a flat string->string table. KV count is
# bounded while collecting (ceiling before the walk grows further).
@ privata
functio _parsa_meta(lista<Tokenum> tks, numerus pos) → MetaCursus ⇥ SafetensorError {
    si _typo(tks, pos) ≠ 0 {
        iace finge MerciumMala { causa = "metadata must be a JSON object" }
    }
    varia numerus p ← pos + 1
    varia lista<textus> claves ← vacua
    varia lista<textus> valores ← vacua
    dum p < tks.longitudo() {
        si _typo(tks, p) ≡ 1 {
            p ← p + 1
            redde MetaCursus { pos = p, claves = claves, valores = valores }
        }
        si _typo(tks, p) ≠ 6 {
            iace finge MerciumMala { causa = "malformed metadata member" }
        }
        fixum textus clavis ← _valor(tks, p)
        p ← p + 1
        si _typo(tks, p) ≠ 4 {
            iace finge MerciumMala { causa = "missing colon in metadata" }
        }
        p ← p + 1
        si _typo(tks, p) ≠ 6 {
            iace finge MerciumMala { causa = "metadata value must be a string" }
        }
        fixum textus valor ← _valor(tks, p)
        p ← p + 1
        claves.appende(clavis)
        valores.appende(valor)
        si claves.longitudo() > KV_LIMES {
            iace finge LimitesMala { causa = "metadata KV count above ceiling" }
        }
        si p ≥ tks.longitudo() {
            iace finge MerciumMala { causa = "unterminated metadata object" }
        }
        si _typo(tks, p) ≡ 5 {
            p ← p + 1
            si p ≥ tks.longitudo() aut _typo(tks, p) ≡ 1 {
                iace finge MerciumMala { causa = "trailing comma in metadata" }
            }
        }
        sin _typo(tks, p) ≠ 1 {
            iace finge MerciumMala { causa = "malformed metadata separator" }
        }
    }
    iace finge MerciumMala { causa = "unterminated metadata object" }
}

# Parse one tensor descriptor: {"dtype": "...", "shape": [...],
# "data_offsets": [begin, end]}. Unknown members, duplicates, and missing
# members fail closed.
@ privata
functio _parsa_tensoris(lista<Tokenum> tks, numerus pos, textus nomen) → TensorCursus ⇥ SafetensorError {
    si _typo(tks, pos) ≠ 0 {
        iace finge FormaMala { causa = "tensor descriptor must be an object: " + nomen }
    }
    varia numerus p ← pos + 1
    varia bivalens dtype_visus ← falsum
    varia bivalens forma_visa ← falsum
    varia bivalens offsceta_visa ← falsum
    varia textus typo ← ""
    varia lista<numerus> forma ← vacua
    varia numerus initium ← 0
    varia numerus finis ← 0
    dum p < tks.longitudo() {
        si _typo(tks, p) ≡ 1 {
            p ← p + 1
            si non dtype_visus {
                iace finge FormaMala { causa = "missing dtype in tensor descriptor: " + nomen }
            }
            si non forma_visa {
                iace finge FormaMala { causa = "missing shape in tensor descriptor: " + nomen }
            }
            si non offsceta_visa {
                iace finge FormaMala { causa = "missing data_offsets in tensor descriptor: " + nomen }
            }
            redde TensorCursus { pos = p, typo = typo, forma = forma, initium = initium, finis = finis }
        }
        si _typo(tks, p) ≠ 6 {
            iace finge FormaMala { causa = "malformed tensor descriptor member" }
        }
        fixum textus clavis ← _valor(tks, p)
        p ← p + 1
        si _typo(tks, p) ≠ 4 {
            iace finge FormaMala { causa = "missing colon in tensor descriptor" }
        }
        p ← p + 1
        si clavis ≡ "dtype" {
            si dtype_visus {
                iace finge FormaMala { causa = "duplicate dtype in tensor descriptor" }
            }
            si _typo(tks, p) ≠ 6 {
                iace finge FormaMala { causa = "dtype must be a string" }
            }
            typo ← _valor(tks, p)
            p ← p + 1
            dtype_visus ← verum
        }
        sin clavis ≡ "shape" {
            si forma_visa {
                iace finge FormaMala { causa = "duplicate shape in tensor descriptor" }
            }
            fixum NumeriCursus nc ← _parsa_numerorum(tks, p)
            p ← nc.pos
            forma ← nc.valores
            forma_visa ← verum
        }
        sin clavis ≡ "data_offsets" {
            si offsceta_visa {
                iace finge FormaMala { causa = "duplicate data_offsets in tensor descriptor" }
            }
            fixum NumeriCursus oc ← _parsa_numerorum(tks, p)
            p ← oc.pos
            si oc.valores.longitudo() ≠ 2 {
                iace finge OffscetaMala { causa = "data_offsets must have exactly 2 values: " + nomen }
            }
            initium ← oc.valores.accipe(0) vel -1
            finis ← oc.valores.accipe(1) vel -1
            offsceta_visa ← verum
        }
        secus {
            iace finge FormaMala { causa = "unknown member in tensor descriptor: " + clavis }
        }
        si p ≥ tks.longitudo() {
            iace finge FormaMala { causa = "unterminated tensor descriptor" }
        }
        si _typo(tks, p) ≡ 5 {
            p ← p + 1
            si p ≥ tks.longitudo() aut _typo(tks, p) ≡ 1 {
                iace finge FormaMala { causa = "trailing comma in tensor descriptor" }
            }
        }
        sin _typo(tks, p) ≠ 1 {
            iace finge FormaMala { causa = "malformed tensor descriptor separator" }
        }
    }
    iace finge FormaMala { causa = "unterminated tensor descriptor" }
}

# Walk the token stream: top-level must be a single JSON object whose
# members are __metadata__ (exactly once) plus tensor entries. Every value
# sits in a pinned context, so the whole header is strictly validated and
# the pinned fields are extracted. Count ceilings are enforced WHILE
# collecting (before any count-driven work downstream).
@ privata
functio _perambulare(lista<Tokenum> tks) → Structura ⇥ SafetensorError {
    si tks.longitudo() ≡ 0 {
        iace finge FormaMala { causa = "empty header" }
    }
    si _typo(tks, 0) ≠ 0 {
        iace finge FormaMala { causa = "header is not a JSON object" }
    }
    varia numerus pos ← 1
    varia bivalens meta_visa ← falsum
    varia lista<textus> meta_claves ← vacua
    varia lista<textus> meta_valores ← vacua
    varia lista<textus> nomina ← vacua
    varia lista<textus> dtypi ← vacua
    varia lista<lista<numerus>> formae ← vacua
    varia lista<numerus> initii ← vacua
    varia lista<numerus> finis ← vacua
    dum pos < tks.longitudo() {
        si _typo(tks, pos) ≡ 1 {
            pos ← pos + 1
            redde Structura {
                meta_claves = meta_claves,
                meta_valores = meta_valores,
                nomina = nomina,
                dtypi = dtypi,
                formae = formae,
                initii = initii,
                finis = finis
            }
        }
        si _typo(tks, pos) ≠ 6 {
            iace finge FormaMala { causa = "malformed header member" }
        }
        fixum textus clavis ← _valor(tks, pos)
        pos ← pos + 1
        si _typo(tks, pos) ≠ 4 {
            iace finge FormaMala { causa = "missing colon in header" }
        }
        pos ← pos + 1
        si clavis ≡ "__metadata__" {
            si meta_visa {
                iace finge MerciumMala { causa = "duplicate __metadata__" }
            }
            meta_visa ← verum
            fixum MetaCursus m ← _parsa_meta(tks, pos)
            pos ← m.pos
            meta_claves ← m.claves
            meta_valores ← m.valores
        }
        secus {
            si nomina.longitudo() ≥ TENSORES_LIMES {
                iace finge LimitesMala { causa = "tensor count above ceiling" }
            }
            si clavis.longitudo() > NOMEN_LIMES {
                iace finge LimitesMala { causa = "tensor name above length ceiling" }
            }
            fixum TensorCursus t ← _parsa_tensoris(tks, pos, clavis)
            pos ← t.pos
            nomina.appende(clavis)
            dtypi.appende(t.typo)
            formae.appende(t.forma)
            initii.appende(t.initium)
            finis.appende(t.finis)
        }
        si pos ≥ tks.longitudo() {
            iace finge FormaMala { causa = "unterminated header object" }
        }
        si _typo(tks, pos) ≡ 5 {
            pos ← pos + 1
            si pos ≥ tks.longitudo() aut _typo(tks, pos) ≡ 1 {
                iace finge FormaMala { causa = "trailing comma in header" }
            }
        }
        sin _typo(tks, pos) ≠ 1 {
            iace finge FormaMala { causa = "malformed header separator" }
        }
    }
    iace finge FormaMala { causa = "unterminated header object" }
}

# -------------------------------------------------------------------------
# Row validation helpers.
# -------------------------------------------------------------------------

# Metadata lookup by key (union; caller unwraps with vel).
@ privata
functio _meta_quaero(lista<textus> claves, lista<textus> valores, textus clavis) → textus ∪ nihil {
    itera ab 0‥claves.longitudo() fixum i {
        si claves.accipe(i) vel "" ≡ clavis {
            redde valores.accipe(i) vel ""
        }
    }
    redde nihil
}

# Required metadata value; a missing key is a metadata-structure error.
@ privata
functio _meta_exige(lista<textus> claves, lista<textus> valores, textus clavis) → textus ⇥ SafetensorError {
    fixum textus ∪ nihil v ← _meta_quaero(claves, valores, clavis)
    si v non est nihil ergo redde v vel ""
    iace finge MerciumMala { causa = "missing required metadata key: " + clavis }
}

# Index of a tensor name in the admitted table, or -1.
@ privata
functio _inveni_nomen(textus nomen) → numerus {
    itera ab 0‥EXPECTATI_NOMINA.longitudo() fixum i {
        si EXPECTATI_NOMINA.accipe(i) vel "" ≡ nomen {
            redde i
        }
    }
    redde -1
}

# Element-count product with checked multiply and per-dimension bounds
# (mirror of shape U3 / serialize._quantitas). Ceilings are validated
# before the product drives anything.
@ privata
functio _quantitas(lista<numerus> forma) → numerus ⇥ SafetensorError {
    si forma.longitudo() < 1 {
        iace finge FiguraMala { causa = "empty shape" }
    }
    varia numerus product ← 1
    itera ex forma fixum dim {
        si dim < 1 {
            iace finge FiguraMala { causa = "non-positive dimension" }
        }
        si dim > DIMENSI_LIMES {
            iace finge LimitesMala { causa = "dimension above ceiling" }
        }
        si product > ELEMENTA_LIMES / dim {
            iace finge LimitesMala { causa = "element count above ceiling" }
        }
        product ← product * dim
    }
    redde product
}

# Shape equality (element-wise; lists have no built-in equality).
@ privata
functio _formae_aequae(lista<numerus> a, lista<numerus> b) → bivalens {
    si a.longitudo() ≠ b.longitudo() ergo redde falsum
    itera ab 0‥a.longitudo() fixum i {
        si (a.accipe(i) vel -1) ≠ (b.accipe(i) vel -1) ergo redde falsum
    }
    redde verum
}

# -------------------------------------------------------------------------
# admittas — the fail-closed ADMISSION. One Safetensors row in, one
# capsula.Capsula out. Every count/offset/length is bounds-checked before
# any work sized by it; every dimension of the pinned row (format, version,
# architecture, dtype, offsets, shapes, tokenizer identity, ceilings) is
# validated before the capsule is built. The digestio is the host-verified
# whole-file digest claim (form-validated here; correctness re-verifiable
# via capsule.verifica_contra).
# -------------------------------------------------------------------------

functio admittas(lista<numerus<u8>> corpus, textus digestio, textus semita) → capsula.Capsula ⇥ SafetensorError {
    # -- container (format) ----------------------------------------------
    fixum CaputCursus cc ← _caput(corpus)
    fixum numerus caput ← cc.caput
    fixum textus caput_textus ← cc.textus
    fixum numerus data_longitudo ← corpus.longitudo() - caput

    # -- header parse + pinned extraction --------------------------------
    fixum lista<Tokenum> tks ← _scander(caput_textus)
    fixum Structura st ← _perambulare(tks)

    # -- metadata facts (format / version / arch / tokenizer) ------------
    fixum textus format_nomen ← _meta_exige(st.meta_claves, st.meta_valores, K_FORMAT_NOMEN)
    fixum textus format_versio ← _meta_exige(st.meta_claves, st.meta_valores, K_FORMAT_VERSIO)
    fixum textus arch ← _meta_exige(st.meta_claves, st.meta_valores, K_ARCH)
    fixum textus densitas ← _meta_exige(st.meta_claves, st.meta_valores, K_DENSITAS)
    fixum textus strata_textus ← _meta_exige(st.meta_claves, st.meta_valores, K_STRATA)
    fixum textus contextus ← _meta_exige(st.meta_claves, st.meta_valores, K_CONTEXTUS)
    fixum textus progenies ← _meta_exige(st.meta_claves, st.meta_valores, K_PROGENIES)
    fixum textus pre ← _meta_exige(st.meta_claves, st.meta_valores, K_PRE)
    fixum textus vocab_digestio ← _meta_exige(st.meta_claves, st.meta_valores, K_VOCAB)
    fixum textus eog ← _meta_exige(st.meta_claves, st.meta_valores, K_EOG)
    fixum textus bos ← _meta_exige(st.meta_claves, st.meta_valores, K_BOS)
    fixum textus spatium ← _meta_exige(st.meta_claves, st.meta_valores, K_SPATIUM)

    si format_nomen ≠ ROW_FORMAT_NOMEN {
        iace finge FormaMala { causa = "unsupported safetensors format: " + format_nomen }
    }
    si format_versio ≠ ROW_FORMAT_VERSIO {
        iace finge VersioIgnota { causa = "unsupported safetensors row version: " + format_versio }
    }
    si arch ≠ ARCH_IDENTIFICATOR aut densitas ≠ ARCH_DENSITAS aut strata_textus ≠ (ARCH_STRATA ↦ textus) aut contextus ≠ ARCH_CONTEXTUS {
        iace finge ArchitecturaMala { causa = "architecture mismatch" }
    }
    si progenies ≠ TOKENIZATOR_PROGENIES aut pre ≠ TOKENIZATOR_PRE aut eog ≠ TOKENIZATOR_EOG aut bos ≠ TOKENIZATOR_BOS aut spatium ≠ TOKENIZATOR_SPATIUM {
        iace finge TokenizerMala { causa = "tokenizer identity mismatch" }
    }
    si non (_hex_recta(vocab_digestio)) {
        iace finge DigestioMala { causa = "malformed vocabulary digest" }
    }
    si non (_hex_recta(digestio)) {
        iace finge DigestioMala { causa = "malformed digest value" }
    }

    # -- tensor table (dtype / shapes / ceilings / offsets / coverage) ---
    fixum numerus n ← st.nomina.longitudo()
    si n ≠ EXPECTATI_NOMINA.longitudo() {
        iace finge ArchitecturaMala { causa = "tensor count mismatch" }
    }
    # duplicate names — a duplicate tensor is a malformed row.
    itera ab 0‥n fixum i {
        itera ab 0‥n fixum j {
            si i < j et (st.nomina.accipe(i) vel "") ≡ (st.nomina.accipe(j) vel "") {
                iace finge OffscetaMala { causa = "duplicate tensor name: " + (st.nomina.accipe(i) vel "") }
            }
        }
    }
    varia numerus elementa_totalia ← 0
    varia numerus sum_longitudinum ← 0
    itera ab 0‥n fixum i {
        fixum textus nomen ← st.nomina.accipe(i) vel ""
        fixum textus typo ← st.dtypi.accipe(i) vel ""
        fixum lista<numerus> forma ← st.formae.accipe(i) vel []
        fixum numerus initium ← st.initii.accipe(i) vel -1
        fixum numerus finis ← st.finis.accipe(i) vel -1
        fixum numerus idx ← _inveni_nomen(nomen)
        si idx < 0 {
            iace finge ArchitecturaMala { causa = "tensor not in admitted row: " + nomen }
        }
        si typo ≠ DTYPE_F32 {
            iace finge TypoIgnotum { causa = "unsupported dtype: " + typo + " for " + nomen }
        }
        fixum numerus elementa ← _quantitas(forma)
        fixum lista<numerus> expectata ← EXPECTATAE_FORMAE.accipe(idx) vel []
        si non (_formae_aequae(forma, expectata)) {
            iace finge FiguraMala { causa = "shape mismatch for " + nomen }
        }
        # F32: 4 bytes per element; the offsets must agree with the shape.
        si finis - initium ≠ elementa * F32_OCTETI {
            iace finge FiguraMala { causa = "shape/offset inconsistency for " + nomen }
        }
        si initium < 0 aut finis ≤ initium {
            iace finge OffscetaMala { causa = "malformed data offsets for " + nomen }
        }
        si finis > data_longitudo {
            iace finge OffscetaMala { causa = "data region truncated — tensor extends beyond file: " + nomen }
        }
        si initium % CONCORDATIO_FABRICA ≠ 0 {
            iace finge OffscetaMala { causa = "misaligned tensor data offset: " + nomen }
        }
        elementa_totalia ← elementa_totalia + elementa
        sum_longitudinum ← sum_longitudinum + (finis - initium)
        si elementa_totalia > ELEMENTA_LIMES {
            iace finge LimitesMala { causa = "total element count above ceiling" }
        }
    }
    # pairwise overlap — intervals must not intersect (O(n²), n ≤ 16).
    itera ab 0‥n fixum i {
        itera ab 0‥n fixum j {
            si i ≠ j {
                fixum numerus ai ← st.initii.accipe(i) vel -1
                fixum numerus bi ← st.finis.accipe(i) vel -1
                fixum numerus aj ← st.initii.accipe(j) vel -1
                fixum numerus bj ← st.finis.accipe(j) vel -1
                si bi > aj et bj > ai {
                    iace finge OffscetaMala { causa = "overlapping tensor data regions" }
                }
            }
        }
    }
    # exact tiling: non-overlapping intervals with total length == data
    # region length within [0, data_len] cover the region exactly.
    si sum_longitudinum ≠ data_longitudo {
        iace finge OffscetaMala { causa = "data region does not tile exactly" }
    }

    # -- capsule construction (the admission target, C8) ------------------
    fac {
        fixum capsula.Capsula c ← capsula.structa(
            CAPSULA_SCHEMA,
            corpus,
            verum,
            DIGESTUM_SHA256,
            digestio,
            progenies,
            pre,
            vocab_digestio,
            eog,
            verum,
            verum,
            QUANTIZATIO_F32,
            F32_ELEMENTA,
            F32_OCTETI,
            CONCORDATIO_QUANTIZATIO,
            corpus.longitudo(),
            st.meta_claves.longitudo(),
            n,
            NOMEN_LIMES,
            DIMENSI_LIMES,
            elementa_totalia,
            TEXTUS_LIMES,
            arch,
            densitas,
            ARCH_STRATA,
            contextus,
            semita
        )
        redde c
    }
    cape err {
        iace finge IngressioMala { causa = "capsule admission rejected: " + capsula.causa(err) }
    }
}
