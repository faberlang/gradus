+++
locale = "en"
+++
# Safetensors format admission — any structurally valid Safetensors container
# parses into the admitted-model capsule, fail-closed.
#
# Public import: import from "gradus:model/safetensors" safetensors
# Depends on: gradus:model/capsule (the PML2-U1 admitted-model capsule,
# capsule-schema-2.0.0) and gradus:model/artifact (pathless content
# identity). This module is the U2 seam: raw Safetensors bytes in ->
# capsule.Capsule out. Raw bytes and paths are NEVER trust anchors
# (capsule contract, council C8) — only the capsule carries identity.

import from "gradus:model/artifact" artifact

import from "gradus:model/capsule" capsule

import from "gradus:dtype" dtype
#
# --- Contract ------------------------------------------------------------
#
# The public `admit` entry is format-only. It does not identify an
# architecture, tokenizer, model revision, or qualification row. A model
# adapter can apply those facts after parsing. The digest value is
# host-computed and passed in (the language surface has no digest primitive);
# its form is validated here and its correctness remains re-verifiable via
# capsule.verify_against.
#
# Container facts (Safetensors reference format, README "Format":
# https://github.com/huggingface/safetensors/blob/main/README.md#format):
# the 8-byte little-endian u64 N is the JSON header length only, excluding
# the prefix; the JSON header occupies [8, 8 + N), and the data region
# starts at 8 + N. Tensor data_offsets are relative to the data region.
# Intervals must be in bounds and non-overlapping; unused bytes between
# tensor regions are allowed by the format.
#
# Typed error vocabulary (SafetensorError, variant -> class):
#   BadFormat        — container/JSON format violations (truncation,
#                      non-JSON, non-object header, malformed members, or
#                      malformed separators).
#   UnknownDtype     — unsupported dtype at the materialization handoff.
#   BadOffset        — data-offset violations (bounds, duplicate tensor name,
#                      or overlapping regions).
#   BadShape         — shape violations (non-positive dimensions or
#                      shape/offset byte-length inconsistency).
#   BadBounds        — ceilings: header size, token count, metadata KV
#                      count, tensor count, name length, dimension size,
#                      total elements.
#   BadDigest        — malformed artifact digest claim.
#   BadMetadata      — metadata structure violations (non-object metadata,
#                      malformed members/separators, or non-string value).
#   BadAdmission     — the capsule constructor rejected the validated row
#                      (defense-in-depth; should not fire on admitted rows).
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * Cross-module enum variants are unsupported (SEM002/SEM041), so this
#     module defines its OWN typed error vocabulary (above) mirroring the
#     capsule's AdmissionError classes, and renders capsule errors via
#     capsule.message on conversion.
#   * The language has no codepoint/ord intrinsic: a \uXXXX escape is
#     form-validated (4 hex digits) but preserved verbatim in the token
#     value. Header metadata and names retain that spelling in the manifest;
#     structural validation does not assign model meaning to either field.
#   * Proba proof is compile-level (`faber check src/model/safetensors.proba`):
#     execution (`faber test`) is blocked tree-wide by the missing locale
#     pack (radix/stdlib/reader/la/pack.toml) and the recorded FMIR
#     stepper limitation (see capsule.proba header). The proba reconstructs
#     a local format-valid JSON + data pattern.
#
# --- Seams ---------------------------------------------------------------
#   * GGUF row admission (parallel U3, hand-4) — disjoint format file.
#   * tokenizer and architecture identity — downstream model adapters.
#   * bundle identity and shard resolution — downstream model admission.
#   * digest computation — the admission host (pure-Rust, GI1).
#   * forward architectures / model rows — downstream adapters.

# -------------------------------------------------------------------------
# Generic parser constants. These are resource-safety bounds, not model
# shapes, artifact identities, or qualification facts.
# -------------------------------------------------------------------------

# Capsule contract mirror (capsule-schema-2.0.0 / sha-256). The parser keeps
# the format identity separate from architecture and quantization policy.
const string DIGEST_SHA256 = "sha-256"

# Generic parser ceilings (resource safety only; no model or artifact facts).
const int HEADER_LIMIT = 104857600

const int TOKEN_LIMIT = 1048576

const int KV_LIMIT = 65536

const int TENSOR_LIMIT = 65536

const int NAME_LIMIT = 4096

const int ARRAY_LIMIT = 1024

# Faber's signed integer ceiling. This is the only bound applied to shape
# products and aggregate element counts; the format parser does not impose a
# model-size policy.
const int MAX_NUMBER = 9223372036854775807

# -------------------------------------------------------------------------
# SafetensorError — typed error vocabulary (variant -> class above). The
# module's public surface (SafetensorError, message, admit) is marked
# @ public so the proba and the conformance suite can import it under the
# post-visibility-flip compiler (frozen entry behavior).
# -------------------------------------------------------------------------


@ public
union SafetensorError {
    @ shared
    string message

    BadFormat,
    UnknownDtype,
    BadOffset,
    BadShape,
    BadBounds,
    BadDigest,
    BadMetadata,
    BadAdmission
}



# Pathless, bounded handoff from a selected Safetensors descriptor.
# The source adapter owns header parsing and range reads. This value carries
# only the already-declared tensor bytes and range facts needed by a consumer.
@ public
class SelectedTensor {
    mut string name
    mut dtype.DType dtype_tag
    mut list<int> shape
    mut string artifact_digest
    mut int artifact_length
    mut int data_start
    mut int relative_start
    mut int relative_end
    mut int absolute_start
    mut list<b8> payload


    fn byte_length() → int {
        return self.payload.length()
    }
}

# -------------------------------------------------------------------------
# Same-module carriers (the walkers build these; all fields are module-
# internal). Public surface stays on primitives + capsule.Capsule so the
# proba file-interface keeps every export (WARN014 seam, same as
# parameter/serialize/capsule).
# -------------------------------------------------------------------------

# A JSON token: kind 0..10 = { } [ ] : , string number true false null.
class Token {
    mut int kind
    mut string payload
}

# Extracted row structure after the header walk.
class Structure {
    mut list<string> meta_keys
    mut list<string> meta_values
    mut list<string> names
    mut list<string> dtypes
    mut list<list<int>> shapes
    mut list<int> starts
    mut list<int> end
}

# String-lexer result: new index + decoded value.
class StringValue {
    mut int pos
    mut string payload
}

# Metadata-object parse result.
class MetadataCursor {
    mut int pos
    mut list<string> keys
    mut list<string> values
}

# Tensor-descriptor parse result.
class TensorCursor {
    mut int pos
    mut string dtype
    mut list<int> shape
    mut int start
    mut int end
}

# Tensor range used only for ordered overlap validation.
class TensorRange {
    mut int start
    mut int end
}

# Number-array parse result.
class NumberCursor {
    mut int pos
    mut list<int> values
}

# Container-header parse result (header is the JSON-only length N).
class HeaderCursor {
    mut int header
    mut string text
}

# One lexer step: the tokens it emits (none for whitespace) and the index just
# past the text it consumed.
class Step {
    mut list<Token> tokens
    mut int end
}

# -------------------------------------------------------------------------
# Character classes over UTF-32 scalars. The header text is scanned as a list
# of Unicode scalars (`text ↦ list<b32> ↦ list<u32>`), and every token payload
# is the bulk conversion of a scalar slice back to a string.
# -------------------------------------------------------------------------

fn is_digit(u32 c) → bool {
    return c ≥ 48 and c ≤ 57
}

# Lowercase hex digit (the digest and \u escape alphabet).
fn is_hex(u32 c) → bool {
    return is_digit(c) or (c ≥ 97 and c ≤ 102)
}

# JSON whitespace between tokens.
fn is_blank(u32 c) → bool {
    return c ≡ 32 or c ≡ 9 or c ≡ 10 or c ≡ 13
}

# A string body scalar that needs no escape: not the quote, not the backslash,
# and not one of the five control characters the reader rejects.
fn is_plain(u32 c) → bool {
    return c ≢ 34 and c ≢ 92 and c ≢ 10 and c ≢ 13 and c ≢ 9 and c ≢ 8 and c ≢ 12
}

# Whole-digest predicate: exactly 64 lowercase hex characters.
fn hex_ok(string s) → bool {
    let list<u32> cps ← s ↦ list<b32> ↦ list<u32>
    return cps.length() ≡ 64 and cps.all((u32 c) → bool ∴ is_hex(c))
}

# The index where the run of scalars satisfying `keep` that starts at `from`
# ends, or `to` when the run reaches it. `from` never exceeds `to`.
fn run_end(list<u32> cps, int from, int to, (u32) → bool keep) → int {
    for range from ‥ to let i {
        if not keep(cps[i]) then return i
    }
    return to
}

# The text of scalars [lo, hi).
fn piece(list<b32> raw, int lo, int hi) → string ⇥ SafetensorError {
    do {
        return raw[lo ‥ hi] ↦ string
    }
    catch err {
        throw variant BadFormat { message = "header span is not valid text" }
    }
}

# -------------------------------------------------------------------------
# Byte-level helpers (Safetensors container).
# -------------------------------------------------------------------------

# Little-endian u64 from the first 8 bytes of a list.
fn u64_le(list<u8> b) → int ⇥ SafetensorError {
    require b.length() ≥ 8 throw variant BadFormat { message = "truncated safetensors header prefix" }
    require b[7] ≺ 128 throw variant BadBounds { message = "header size above the numeric carrier" }
    do {
        return b[0 ‥ 8] ↦ list<b8> ↦ u64 via Le ↦ int
    }
    catch err {
        throw variant BadFormat { message = "truncated safetensors header prefix" }
    }
}

# Container-header validation: the 8-byte LE N is the JSON-only header
# length, followed by bounds and UTF-8 header extraction. N need not be
# aligned; data starts immediately after the N header bytes.
# Ceilings are checked BEFORE the header slice is materialized.
fn header(list<u8> corpus) → HeaderCursor ⇥ SafetensorError {
    # --- header length + bounds (fail closed) -----------------------------
    let int header ← u64_le(corpus)
    require header ≥ 1 throw variant BadFormat { message = "invalid safetensors header size" }
    require header ≤ HEADER_LIMIT throw variant BadBounds { message = "header size above ceiling" }
    require 8 + header ≤ corpus.length() throw variant BadFormat { message = "truncated header — header size beyond file" }
    # --- header slice + UTF-8 extraction ----------------------------------
    do {
        return HeaderCursor { header = header, text = corpus[8 ‥ 8 + header] ↦ list<b8> ↦ string }
    }
    catch err {
        throw variant BadFormat { message = "header is not valid UTF-8" }
    }
}

# -------------------------------------------------------------------------
# JSON tokenizer (strict lexical validation of the header).
# -------------------------------------------------------------------------

# The text a simple escape stands for, or none for an unknown escape letter
# (\u is handled by the reader: it is form-validated and kept verbatim).
fn escape_text(u32 e) → string ∪ none {
    switch e {
        case 34 {
            return «"»
        }
        case 92 {
            return "\\"
        }
        case 47 {
            return "/"
        }
        case 110 {
            return "\n"
        }
        case 114 {
            return "\r"
        }
        case 116 {
            return "\t"
        }
        case 98 {
            return "\u{08}"
        }
        case 102 {
            return "\u{0C}"
        }
        default {
            return null
        }
    }
}

# Parse a JSON string starting at scalar index i (the opening quote). Handles
# the standard escapes; \uXXXX is form-validated (4 hex digits) and preserved
# verbatim (no codepoint intrinsic — compiler-boundary note above). Each pass
# takes the unescaped run, then one escape; the escape's width (2 or 6) decides
# where the next pass starts, so the cursor is a `while`.
fn read_string(list<b32> raw, list<u32> cps, int i) → StringValue ⇥ SafetensorError {
    let int n ← cps.length()
    mut string payload ← ""
    mut int pos ← i + 1
    while pos ≺ n {
        let int stop ← run_end(cps, pos, n, is_plain)
        payload ← "§§"(payload, piece(raw, pos, stop))
        require stop ≺ n throw variant BadFormat { message = "unterminated string" }
        if cps[stop] ≡ 34 then return StringValue { pos = stop + 1, payload = payload }
        reject cps[stop] ≢ 92 throw variant BadFormat { message = "unescaped control character in string" }
        require stop + 1 ≺ n throw variant BadFormat { message = "unterminated string escape" }
        if cps[stop + 1] ≡ 117 {
            require stop + 5 ≺ n throw variant BadFormat { message = "truncated \\u escape" }
            for from cps[stop + 2 ‥ stop + 6] let digit {
                require is_hex(digit) throw variant BadFormat { message = "malformed \\u escape" }
            }
            payload ← "§\\u§"(payload, piece(raw, stop + 2, stop + 6))
            pos ← stop + 6
        }
        else {
            let string ∪ none text ← escape_text(cps[stop + 1])
            if text ≡ null then throw variant BadFormat { message = "unknown string escape" }
            payload ← "§§"(payload, text)
            pos ← stop + 2
        }
    }
    throw variant BadFormat { message = "unterminated string" }
}

# The end of the digit run that must start at `at` (a digit is required there).
fn digits_after(list<u32> cps, int at) → int ⇥ SafetensorError {
    require at ≺ cps.length() throw variant BadFormat { message = "malformed number" }
    require is_digit(cps[at]) throw variant BadFormat { message = "malformed number" }
    return run_end(cps, at, cps.length(), is_digit)
}

# Parse a JSON number starting at index i (digit or minus). Returns the
# raw number text (JSON grammar: -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?).
fn read_number(list<b32> raw, list<u32> cps, int i) → StringValue ⇥ SafetensorError {
    let int n ← cps.length()
    let int lead ← cps[i] ≡ 45 ✓ i + 1 ✗ i
    require lead ≺ n throw variant BadFormat { message = "malformed number" }
    require is_digit(cps[lead]) throw variant BadFormat { message = "malformed number" }
    let int int_end ← cps[lead] ≡ 48 ✓ lead + 1 ✗ run_end(cps, lead, n, is_digit)
    reject cps[lead] ≡ 48 and int_end ≺ n and is_digit(cps[int_end]) throw variant BadFormat { message = "malformed number" }
    let int frac_end ← int_end ≺ n and cps[int_end] ≡ 46 ✓ digits_after(cps, int_end + 1) ✗ int_end
    let bool has_exponent ← frac_end ≺ n and (cps[frac_end] ≡ 101 or cps[frac_end] ≡ 69)
    let bool has_sign ← has_exponent and frac_end + 1 ≺ n and (cps[frac_end + 1] ≡ 43 or cps[frac_end + 1] ≡ 45)
    let int exponent_at ← has_sign ✓ frac_end + 2 ✗ frac_end + 1
    let int end ← has_exponent ✓ digits_after(cps, exponent_at) ✗ frac_end
    return StringValue { pos = end, payload = piece(raw, i, end) }
}

# The token (if any) and end of the lexeme that starts at scalar index pos.
fn next_lexeme(list<b32> raw, list<u32> cps, int pos) → Step ⇥ SafetensorError {
    let int n ← cps.length()
    let u32 c ← cps[pos]
    if is_blank(c) then return Step { tokens = empty, end = run_end(cps, pos, n, is_blank) }
    switch c {
        case 123 {
            return Step { tokens = [Token { kind = 0, payload = "{" }], end = pos + 1 }
        }
        case 125 {
            return Step { tokens = [Token { kind = 1, payload = "}" }], end = pos + 1 }
        }
        case 91 {
            return Step { tokens = [Token { kind = 2, payload = "[" }], end = pos + 1 }
        }
        case 93 {
            return Step { tokens = [Token { kind = 3, payload = "]" }], end = pos + 1 }
        }
        case 58 {
            return Step { tokens = [Token { kind = 4, payload = ":" }], end = pos + 1 }
        }
        case 44 {
            return Step { tokens = [Token { kind = 5, payload = "," }], end = pos + 1 }
        }
        case 34 {
            let StringValue s ← read_string(raw, cps, pos)
            return Step { tokens = [Token { kind = 6, payload = s.payload }], end = s.pos }
        }
        case 116 {
            require word_at(cps, pos, [116, 114, 117, 101]) throw variant BadFormat { message = "malformed literal" }
            return Step { tokens = [Token { kind = 8, payload = "true" }], end = pos + 4 }
        }
        case 102 {
            require word_at(cps, pos, [102, 97, 108, 115, 101]) throw variant BadFormat { message = "malformed literal" }
            return Step { tokens = [Token { kind = 9, payload = "false" }], end = pos + 5 }
        }
        case 110 {
            require word_at(cps, pos, [110, 117, 108, 108]) throw variant BadFormat { message = "malformed literal" }
            return Step { tokens = [Token { kind = 10, payload = "null" }], end = pos + 4 }
        }
        default {
            require is_digit(c) or c ≡ 45 throw variant BadFormat { message = "unexpected character in header" }
            let StringValue number ← read_number(raw, cps, pos)
            return Step { tokens = [Token { kind = 7, payload = number.payload }], end = number.pos }
        }
    }
}

# Whether the scalars at `pos` spell `word` (a JSON literal).
fn word_at(list<u32> cps, int pos, list<u32> word) → bool {
    return pos + word.length() ≤ cps.length() and cps[pos ‥ pos + word.length()] ≡ word
}

# Tokenize the whole header (strict lexical validation, bounded token
# count — checked before more tokens are appended). Lexemes have different
# widths, so the cursor jumps to each lexeme's end.
fn scan(string h) → list<Token> ⇥ SafetensorError {
    let list<b32> raw ← h ↦ list<b32>
    let list<u32> cps ← raw ↦ list<u32>
    let int n ← cps.length()
    mut list<Token> tks ← empty
    mut int pos ← 0
    while pos ≺ n {
        let Step step ← next_lexeme(raw, cps, pos)
        tks.extend(step.tokens)
        require tks.length() ≤ TOKEN_LIMIT throw variant BadBounds { message = "header token count above ceiling" }
        pos ← step.end
    }
    return tks
}

# -------------------------------------------------------------------------
# JSON structural walk (strict grammar validation + generic extraction).
# -------------------------------------------------------------------------

# Whether token i exists and has the given kind (0..10 as in `Token`).
fn is_kind(list<Token> tks, int i, int kind) → bool {
    return i ≺ tks.length() and tks[i].kind ≡ kind
}

# The index of the first token of `kind` at or after `from`, or the token count
# when there is none.
fn kind_end(list<Token> tks, int from, int kind) → int {
    for range from ‥ tks.length() let i {
        if tks[i].kind ≡ kind then return i
    }
    return tks.length()
}

# Integer-valued JSON number -> number (digits only, length-capped). A
# fractional/exponent number is not a valid shape dim or offset.
fn parse_integer(string raw) → int ⇥ SafetensorError {
    require raw.length() ≢ 0 throw variant BadFormat { message = "malformed integer" }
    require raw.length() ≤ 18 throw variant BadFormat { message = "integer above the numeric carrier" }
    let list<u32> cps ← raw ↦ list<b32> ↦ list<u32>
    require cps.all((u32 c) → bool ∴ is_digit(c)) throw variant BadFormat { message = "non-integer value" }
    do {
        return raw ↦ int
    }
    catch err {
        throw variant BadFormat { message = "malformed integer" }
    }
}

# Parse a JSON array of integers starting at pos (token kind 2). Bounded
# array length (shape rank / offsets / any numeric array). The array holds no
# nesting, so its body is the tokens up to the first `]`: integers at the even
# slots, commas at the odd ones.
fn parse_numbers(list<Token> tks, int pos) → NumberCursor ⇥ SafetensorError {
    require is_kind(tks, pos, 2) throw variant BadFormat { message = "expected an integer array" }
    let int close ← kind_end(tks, pos + 1, 3)
    let list<Token> body ← tks[pos + 1 ‥ close]
    mut list<int> values ← empty
    for from body at [slot] let t {
        if slot % 2 ≡ 0 {
            require t.kind ≡ 7 throw variant BadFormat { message = "array must contain only integers" }
            values.append(parse_integer(t.payload))
            require values.length() ≤ ARRAY_LIMIT throw variant BadBounds { message = "array above length ceiling" }
        }
        else {
            require t.kind ≡ 5 throw variant BadFormat { message = "malformed array separator" }
        }
    }
    reject body.length() ≻ 0 and body.length() % 2 ≡ 0 throw variant BadFormat { message = "trailing comma in array" }
    require close ≺ tks.length() throw variant BadFormat { message = "unterminated array" }
    return NumberCursor { pos = close + 1, values = values }
}

# Parse the __metadata__ object: a flat string->string table. KV count is
# bounded while collecting (ceiling before the walk grows further). The object
# holds only strings, so its body is the tokens up to the first `}`: members of
# four slots, key : value ,.
fn parse_metadata(list<Token> tks, int pos) → MetadataCursor ⇥ SafetensorError {
    require is_kind(tks, pos, 0) throw variant BadMetadata { message = "metadata must be a JSON object" }
    let int close ← kind_end(tks, pos + 1, 1)
    let list<Token> body ← tks[pos + 1 ‥ close]
    mut list<string> keys ← empty
    mut list<string> values ← empty
    for from body at [slot] let t {
        switch slot % 4 {
            case 0 {
                require t.kind ≡ 6 throw variant BadMetadata { message = "malformed metadata member" }
                keys.append(t.payload)
            }
            case 1 {
                require t.kind ≡ 4 throw variant BadMetadata { message = "missing colon in metadata" }
            }
            case 2 {
                require t.kind ≡ 6 throw variant BadMetadata { message = "metadata value must be a string" }
                values.append(t.payload)
                require keys.length() ≤ KV_LIMIT throw variant BadBounds { message = "metadata KV count above ceiling" }
            }
            default {
                require t.kind ≡ 5 throw variant BadMetadata { message = "malformed metadata separator" }
            }
        }
    }
    let int tail ← body.length() % 4
    reject tail ≡ 0 and body.length() ≻ 0 throw variant BadMetadata { message = "trailing comma in metadata" }
    require tail ≢ 1 throw variant BadMetadata { message = "missing colon in metadata" }
    require tail ≢ 2 throw variant BadMetadata { message = "metadata value must be a string" }
    require close ≺ tks.length() throw variant BadMetadata { message = "unterminated metadata object" }
    return MetadataCursor { pos = close + 1, keys = keys, values = values }
}

# Parse one tensor descriptor: {"dtype": "...", "shape": [...],
# "data_offsets": [begin, end]}. Unknown members, duplicates, and missing
# members fail closed. Members have different widths (a string, an array), so
# the cursor moves to each member's end.
fn parse_tensor(list<Token> tks, int pos, string name) → TensorCursor ⇥ SafetensorError {
    require is_kind(tks, pos, 0) throw variant BadFormat { message = "tensor descriptor must be an object: §"(name) }
    mut int p ← pos + 1
    mut bool seen_dtype ← false
    mut bool seen_shape ← false
    mut bool seen_offset ← false
    mut string kind ← ""
    mut list<int> shape ← empty
    mut int start ← 0
    mut int end ← 0
    let int count ← tks.length()
    while p ≺ count {
        if is_kind(tks, p, 1) {
            require seen_dtype throw variant BadFormat { message = "missing dtype in tensor descriptor: §"(name) }
            require seen_shape throw variant BadFormat { message = "missing shape in tensor descriptor: §"(name) }
            require seen_offset throw variant BadFormat { message = "missing data_offsets in tensor descriptor: §"(name) }
            return TensorCursor { pos = p + 1, dtype = kind, shape = shape, start = start, end = end }
        }
        require is_kind(tks, p, 6) throw variant BadFormat { message = "malformed tensor descriptor member" }
        let string key ← tks[p].payload
        require is_kind(tks, p + 1, 4) throw variant BadFormat { message = "missing colon in tensor descriptor" }
        let int value ← p + 2
        if key ≡ "dtype" {
            reject seen_dtype throw variant BadFormat { message = "duplicate dtype in tensor descriptor" }
            require is_kind(tks, value, 6) throw variant BadFormat { message = "dtype must be a string" }
            kind ← tks[value].payload
            p ← value + 1
            seen_dtype ← true
        }
        elif key ≡ "shape" {
            reject seen_shape throw variant BadFormat { message = "duplicate shape in tensor descriptor" }
            let NumberCursor nc ← parse_numbers(tks, value)
            p ← nc.pos
            shape ← nc.values
            seen_shape ← true
        }
        elif key ≡ "data_offsets" {
            reject seen_offset throw variant BadFormat { message = "duplicate data_offsets in tensor descriptor" }
            let NumberCursor oc ← parse_numbers(tks, value)
            p ← oc.pos
            require oc.values.length() ≡ 2 throw variant BadOffset { message = "data_offsets must have exactly 2 values: §"(name) }
            start ← oc.values[0]
            end ← oc.values[1]
            seen_offset ← true
        }
        else {
            throw variant BadFormat { message = "unknown member in tensor descriptor: §"(key) }
        }
        p ← member_end(tks, p, "tensor descriptor")
    }
    throw variant BadFormat { message = "unterminated tensor descriptor" }
}

# After a member ending at p: the index where the next member starts, or the
# index of the closing `}` itself, or the token count when the stream ended
# (the caller's loop then reports the unterminated object). A comma must be
# followed by a member (not the close), and anything else must be the close.
fn member_end(list<Token> tks, int p, string what) → int ⇥ SafetensorError {
    if p ≥ tks.length() then return p
    if is_kind(tks, p, 5) {
        require p + 1 ≺ tks.length() throw variant BadFormat { message = "trailing comma in §"(what) }
        require not is_kind(tks, p + 1, 1) throw variant BadFormat { message = "trailing comma in §"(what) }
        return p + 1
    }
    require is_kind(tks, p, 1) throw variant BadFormat { message = "malformed § separator"(what) }
    return p
}

# Walk the token stream: top-level must be a single JSON object whose
# members are an optional __metadata__ object plus tensor entries. Every
# tensor descriptor is structurally validated and retained generically. The
# top-level object must close exactly at the end of the token stream — any
# trailing token after the closing brace fails closed (no partial-header
# admission). Count ceilings are enforced WHILE collecting (before any
# count-driven work downstream).
fn walk(list<Token> tks) → Structure ⇥ SafetensorError {
    require tks.length() ≢ 0 throw variant BadFormat { message = "empty header" }
    require is_kind(tks, 0, 0) throw variant BadFormat { message = "header is not a JSON object" }
    mut int pos ← 1
    mut bool seen_meta ← false
    mut list<string> meta_keys ← empty
    mut list<string> meta_values ← empty
    mut list<string> names ← empty
    mut list<string> dtypes ← empty
    mut list<list<int>> shapes ← empty
    mut list<int> starts ← empty
    mut list<int> end ← empty
    let int count ← tks.length()
    while pos ≺ count {
        if is_kind(tks, pos, 1) {
            # Fail closed on trailing content: the top-level object must
            # close exactly at the end of the token stream.
            require pos + 1 ≡ count throw variant BadFormat { message = "trailing tokens after the header object" }
            return Structure { meta_keys = meta_keys, meta_values = meta_values, names = names, dtypes = dtypes, shapes = shapes, starts = starts, end = end }
        }
        require is_kind(tks, pos, 6) throw variant BadFormat { message = "malformed header member" }
        let string key ← tks[pos].payload
        require is_kind(tks, pos + 1, 4) throw variant BadFormat { message = "missing colon in header" }
        let int value ← pos + 2
        if key ≡ "__metadata__" {
            reject seen_meta throw variant BadMetadata { message = "duplicate __metadata__" }
            seen_meta ← true
            let MetadataCursor m ← parse_metadata(tks, value)
            pos ← m.pos
            meta_keys ← m.keys
            meta_values ← m.values
        }
        else {
            require names.length() ≺ TENSOR_LIMIT throw variant BadBounds { message = "tensor count above ceiling" }
            require key.length() ≤ NAME_LIMIT throw variant BadBounds { message = "tensor name above length ceiling" }
            let TensorCursor t ← parse_tensor(tks, value, key)
            pos ← t.pos
            names.append(key)
            dtypes.append(t.dtype)
            shapes.append(t.shape)
            starts.append(t.start)
            end.append(t.end)
        }
        pos ← member_end(tks, pos, "header")
    }
    throw variant BadFormat { message = "unterminated header object" }
}

# -------------------------------------------------------------------------
# Row validation helpers.
# -------------------------------------------------------------------------

# Build the manifest metadata table from the extracted header metadata
# (parallel key/value lists, header order preserved).
fn metadata(list<string> keys, list<string> values) → list<capsule.SafetensorsMetadata> {
    mut list<capsule.SafetensorsMetadata> out ← empty
    for from keys at [i] let key {
        out.append(capsule.SafetensorsMetadata { key = key, payload = values[i] })
    }
    return out
}

# Element-count product with checked multiplication. The generic format
# parser has no model-specific dimension table.
fn numel(list<int> shape) → int ⇥ SafetensorError {
    mut int product ← 1
    for from shape let dim {
        require dim ≥ 1 throw variant BadShape { message = "non-positive dimension" }
        product ← mul(product, dim)
    }
    return product
}

fn add(int a, int b) → int ⇥ SafetensorError {
    reject a ≺ 0 or b ≺ 0 or a ≻ MAX_NUMBER - b throw variant BadBounds { message = "checked integer addition overflow" }
    return a + b
}

fn mul(int a, int b) → int ⇥ SafetensorError {
    reject a ≺ 0 or b ≺ 0 or b ≢ 0 and a ≻ MAX_NUMBER / b throw variant BadBounds { message = "checked integer multiplication overflow" }
    return a * b
}

# Known Safetensors storage widths. A dtype with no entry here is retained
# opaquely; the generic parser must not reject a future dtype merely because
# Gradus cannot materialize it yet.
fn dtype_bytes(string kind) → int ∪ none {
    if kind ∈ ["BOOL", "U8", "I8", "F8_E4M3", "F8_E5M2"] then return 1
    if kind ∈ ["F16", "BF16", "I16", "U16"] then return 2
    if kind ∈ ["F32", "I32", "U32"] then return 4
    if kind ∈ ["F64", "I64", "U64", "C64"] then return 8
    if kind ∈ ["I128", "U128", "F128"] then return 16
    if kind ∈ ["I256", "U256", "F256"] then return 32
    return null
}

# The public Gradus DType union covers the currently materializable floating
# and integer types. Other standards-valid Safetensors names stay in the
# generic manifest text and are rejected only by this typed range handoff.
fn dtype_tag_of(string kind) → dtype.DType ⇥ SafetensorError {
    switch kind {
        case "F32" {
            return dtype.f32()
        }
        case "F16" {
            return dtype.f16()
        }
        case "BF16" {
            return dtype.bf16()
        }
        case "I32" {
            return dtype.i32()
        }
        case "U8" {
            return dtype.u8()
        }
        default {
            throw variant UnknownDtype { message = "unsupported materialized Safetensors dtype: §"(kind) }
        }
    }
}

# Select one bounded tensor after the source adapter has inspected the
# container header. Identity, shape, and ranges are caller-supplied facts;
# no model-specific tensor is encoded here.
@ public
fn admit_selected(string name, string kind, list<int> shape, list<b8> payload, string digest, int artifact_length, int data_start, int relative_start, int relative_end) → SelectedTensor ⇥ SafetensorError {
    require name.length() ≢ 0 throw variant BadFormat { message = "selected tensor name is empty" }
    require hex_ok(digest) throw variant BadDigest { message = "malformed artifact digest" }
    require artifact_length ≻ 0 throw variant BadBounds { message = "invalid artifact length" }
    require data_start ≥ 8 and data_start ≤ artifact_length throw variant BadOffset { message = "invalid data-region start" }
    require relative_start ≥ 0 and relative_end ≻ relative_start throw variant BadOffset { message = "selected tensor range is invalid" }
    let int absolute_end ← add(data_start, relative_end)
    require absolute_end ≤ artifact_length throw variant BadOffset { message = "selected tensor range exceeds the artifact" }
    let dtype.DType dtype_tag ← dtype_tag_of(kind)
    let int values ← numel(shape)
    require relative_end - relative_start ≡ mul(values, dtype.width(dtype_tag)) throw variant BadShape { message = "selected tensor range does not match its shape" }
    require payload.length() ≡ relative_end - relative_start throw variant BadOffset { message = "selected tensor payload length does not match its range" }
    let int absolute_start ← add(data_start, relative_start)
    return SelectedTensor { name = name, dtype_tag = dtype_tag, shape = shape, artifact_digest = digest, artifact_length = artifact_length, data_start = data_start, relative_start = relative_start, relative_end = relative_end, absolute_start = absolute_start, payload = payload }
}

# Parse one whole Safetensors member into the generic schema-2 capsule. The
# manifest preserves metadata and every descriptor but applies no model,
# tokenizer, or naming policy.
@ public
fn admit(list<u8> corpus, string digest) → capsule.Capsule ⇥ SafetensorError {
    let HeaderCursor cc ← header(corpus)
    let int header ← cc.header
    let string header_text ← cc.text
    let int data_length ← (corpus.length() - 8) - header
    require data_length ≻ 0 throw variant BadBounds { message = "empty Safetensors data region" }
    require hex_ok(digest) throw variant BadDigest { message = "malformed digest value" }
    let list<Token> tks ← scan(header_text)
    let Structure st ← walk(tks)
    let int n ← st.names.length()
    # A header with no tensors has no data to admit.
    require n ≻ 0 throw variant BadFormat { message = "header declares no tensors" }
    let list<string> sorted_names ← sort via asc from st.names
    if n ≻ 1 {
        for range 0 ‥ n - 1 let i {
            reject sorted_names[i] ≡ sorted_names[i + 1] throw variant BadOffset { message = "duplicate tensor name: §"(sorted_names[i + 1]) }
        }
    }
    mut int total_elements ← 0
    mut list<capsule.SafetensorsTensorDescriptor> descriptors ← empty
    mut list<TensorRange> ranges ← empty
    for from st.names at [i] let name {
        let int elements ← numel(st.shapes[i])
        require st.starts[i] ≥ 0 and st.end[i] ≻ st.starts[i] and st.end[i] ≤ data_length throw variant BadOffset { message = "tensor data range is invalid: §"(name) }
        let int ∪ none bytes_per_element ← dtype_bytes(st.dtypes[i])
        if bytes_per_element ≢ null {
            require st.end[i] - st.starts[i] ≡ mul(elements, bytes_per_element) throw variant BadShape { message = "shape/offset inconsistency for §"(name) }
        }
        total_elements ← add(total_elements, elements)
        descriptors.append(capsule.SafetensorsTensorDescriptor { name = name, dtype = st.dtypes[i], shape = st.shapes[i], start = st.starts[i], end = st.end[i], elements = elements })
        ranges.append(TensorRange { start = st.starts[i], end = st.end[i] })
    }
    let list<TensorRange> sorted_ranges ← sort via asc from ranges let tensor_range { return tensor_range.start }
    if n ≻ 1 {
        for range 0 ‥ n - 1 let i {
            reject sorted_ranges[i].end ≻ sorted_ranges[i + 1].start throw variant BadOffset { message = "overlapping tensor data regions" }
        }
    }
    do {
        let artifact.ContentIdentity identity ← artifact.ContentIdentity { algorithm = DIGEST_SHA256, digest = digest, length = corpus.length() }
        let capsule.SafetensorsManifest manifest ← capsule.SafetensorsManifest { format = "safetensors", version = "1.0.0", artifact_length = corpus.length(), data_length = data_length, metadata = metadata(st.meta_keys, st.meta_values), tensors = descriptors }
        let capsule.Capsule c ← capsule.construct_manifest(capsule.schema_version_text(), identity, capsule.safetensors_manifest(manifest))
        return c
    }
    catch err {
        throw variant BadAdmission { message = "capsule admission rejected: §"(err.message) }
    }
}
