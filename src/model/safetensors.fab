+++ toml
locale = "en"

+++ faber
# Safetensors format admission — any structurally valid Safetensors container
# parses into the admitted-model capsule, fail-closed.
#
# Public import: import from "gradus:model/safetensors" safetensors
# Depends on: gradus:model/capsule (the PML2-U1 admitted-model capsule,
# capsule-schema-2.0.0) and gradus:model/artifact (pathless content
# identity). This module is the U2 seam: raw Safetensors bytes in ->
# capsule.Capsule out. Raw bytes and paths are NEVER trust anchors
# (capsule contract, council C8) — only the capsule carries identity.

import from "gradus:model/artifact"

import from "gradus:model/capsule"

import from "gradus:dtype"
#
# --- Contract ------------------------------------------------------------
#
# The public `admit` entry is format-only. It does not identify an
# architecture, tokenizer, model revision, or qualification row. A model
# adapter can apply those facts after parsing. The digest value is
# host-computed and passed in (the language surface has no digest primitive);
# its form is validated here and its correctness remains re-verifiable via
# capsule.verify_against.
#
# Container facts (Safetensors reference format, README "Format":
# https://github.com/huggingface/safetensors/blob/main/README.md#format):
# the 8-byte little-endian u64 N is the JSON header length only, excluding
# the prefix; the JSON header occupies [8, 8 + N), and the data region
# starts at 8 + N. Tensor data_offsets are relative to the data region.
# Intervals must be in bounds and non-overlapping; unused bytes between
# tensor regions are allowed by the format.
#
# Typed error vocabulary (SafetensorError, variant -> class):
#   BadFormat        — container/JSON format violations (truncation,
#                      non-JSON, non-object header, malformed members, or
#                      malformed separators).
#   UnknownDtype     — unsupported dtype at the materialization handoff.
#   BadOffset        — data-offset violations (bounds, duplicate tensor name,
#                      or overlapping regions).
#   BadShape         — shape violations (non-positive dimensions or
#                      shape/offset byte-length inconsistency).
#   BadBounds        — ceilings: header size, token count, metadata KV
#                      count, tensor count, name length, dimension size,
#                      total elements.
#   BadDigest        — malformed artifact digest claim.
#   BadMetadata      — metadata structure violations (non-object metadata,
#                      malformed members/separators, or non-string value).
#   BadAdmission     — the capsule constructor rejected the validated row
#                      (defense-in-depth; should not fire on admitted rows).
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * Cross-module enum variants are unsupported (SEM002/SEM041), so this
#     module defines its OWN typed error vocabulary (above) mirroring the
#     capsule's AdmissionError classes, and renders capsule errors via
#     capsule.message on conversion.
#   * The language has no codepoint/ord intrinsic: a \uXXXX escape is
#     form-validated (4 hex digits) but preserved verbatim in the token
#     value. Header metadata and names retain that spelling in the manifest;
#     structural validation does not assign model meaning to either field.
#   * Proba proof is compile-level (`faber check src/model/safetensors.proba`):
#     execution (`faber test`) is blocked tree-wide by the missing locale
#     pack (radix/stdlib/reader/la/pack.toml) and the recorded FMIR
#     stepper limitation (see capsule.proba header). The proba reconstructs
#     a local format-valid JSON + data pattern.
#
# --- Seams ---------------------------------------------------------------
#   * GGUF row admission (parallel U3, hand-4) — disjoint format file.
#   * tokenizer and architecture identity — downstream model adapters.
#   * bundle identity and shard resolution — downstream model admission.
#   * digest computation — the admission host (pure-Rust, GI1).
#   * forward architectures / model rows — downstream adapters.

# -------------------------------------------------------------------------
# Generic parser constants. These are resource-safety bounds, not model
# shapes, artifact identities, or qualification facts.
# -------------------------------------------------------------------------

# Capsule contract mirror (capsule-schema-2.0.0 / sha-256). The parser keeps
# the format identity separate from architecture and quantization policy.
const string DIGEST_SHA256 = "sha-256"

# Generic parser ceilings (resource safety only; no model or artifact facts).
const int HEADER_LIMIT = 104857600

const int TOKEN_LIMIT = 1048576

const int KV_LIMIT = 65536

const int TENSOR_LIMIT = 65536

const int NAME_LIMIT = 4096

const int ARRAY_LIMIT = 1024

# Faber's signed integer ceiling. This is the only bound applied to shape
# products and aggregate element counts; the format parser does not impose a
# model-size policy.
const int MAX_NUMBER = 9223372036854775807

# -------------------------------------------------------------------------
# SafetensorError — typed error vocabulary (variant -> class above). The
# module's public surface (SafetensorError, message, admit) is marked
# @ public so the proba and the conformance suite can import it under the
# post-visibility-flip compiler (frozen entry behavior).
# -------------------------------------------------------------------------


@ public
union SafetensorError {
    @ shared
    string message

    BadFormat,
    UnknownDtype,
    BadOffset,
    BadShape,
    BadBounds,
    BadDigest,
    BadMetadata,
    BadAdmission
}

# Pathless, bounded handoff from a selected Safetensors descriptor.
# The source adapter owns header parsing and range reads. This value carries
# only the already-declared tensor bytes and range facts needed by a consumer.
@ public
class SelectedTensor {
    mut string name
    mut string raw_dtype = ""
    mut dtype.DType ∪ none dtype_tag = null
    mut list<int> shape
    mut string artifact_digest
    mut int artifact_length
    mut int data_start
    mut int relative_start
    mut int relative_end
    mut int absolute_start
    mut list<b8> payload

    fn byte_length() → int {
        return self.payload.length()
    }
}

# -------------------------------------------------------------------------
# Same-module carriers (the walkers build these; all fields are module-
# internal). Public surface stays on primitives + capsule.Capsule so the
# proba file-interface keeps every export (WARN014 seam, same as
# parameter/serialize/capsule).
# -------------------------------------------------------------------------

# A JSON token: kind 0..10 = { } [ ] : , string number true false null.
class Token {
    mut int kind
    mut string payload
}

# Extracted row structure after the header walk.
class Structure {
    mut list<string> meta_keys
    mut list<string> meta_values
    mut list<string> names
    mut list<string> dtypes
    mut list<list<int>> shapes
    mut list<int> starts
    mut list<int> end
}

# String-lexer result: new index + decoded value.
class StringValue {
    mut int pos
    mut string payload
}

# Metadata-object parse result.
class MetadataCursor {
    mut int pos
    mut list<string> keys
    mut list<string> values
}

# Tensor-descriptor parse result.
class TensorCursor {
    mut int pos
    mut string dtype
    mut list<int> shape
    mut int start
    mut int end
}

# Tensor range used only for ordered overlap validation.
class TensorRange {
    mut int start
    mut int end
}

# Number-array parse result.
class NumberCursor {
    mut int pos
    mut list<int> values
}

# Container-header parse result (header is the JSON-only length N; text is
# the JSON header's UTF-8 bytes, lexed in place over the byte buffer).
class HeaderCursor {
    mut int header
    mut list<b8> text
}

# -------------------------------------------------------------------------
# Character / value predicates (self-contained copies per leaf-module
# convention — the capsule's is_hex/hex_ok are module-private).
# -------------------------------------------------------------------------

fn is_digit(char c) → bool {
    return c ≥ '0' and c ≤ '9'
}

fn is_hex(char c) → bool {
    return (c ≥ '0' and c ≤ '9') or (c ≥ 'a' and c ≤ 'f')
}

# Byte-level predicates for the header lexer: each byte decodes to its
# character once and compares against character literals (JSON whitespace:
# space, tab, newline, carriage return). Bytes above the ASCII range fail
# the decode and fall to a character no arm matches.
fn is_optional_byte(b8 c) → bool {
    let char ch ← (c ↦ u8) ↦ char via code ⊥ '?'
    return ch ≡ ' ' or ch ≡ '\t' or ch ≡ '\n' or ch ≡ '\r'
}

fn is_digit_byte(b8 c) → bool {
    let char ch ← (c ↦ u8) ↦ char via code ⊥ '?'
    return ch ≥ '0' and ch ≤ '9'
}

fn is_hex_byte(b8 c) → bool {
    let char ch ← (c ↦ u8) ↦ char via code ⊥ '?'
    return (ch ≥ '0' and ch ≤ '9') or (ch ≥ 'a' and ch ≤ 'f') or (ch ≥ 'A' and ch ≤ 'F')
}

# Whole-digest predicate: exactly 64 lowercase hex characters.
fn hex_ok(string s) → bool {
    if s.length() ≢ 64 then return false

    for from s let c {
        if not is_hex(c) then return false
    }

    return true
}

# -------------------------------------------------------------------------
# Byte-level helpers (Safetensors container).
# -------------------------------------------------------------------------

# Little-endian u64 from the first 8 bytes of a list.
fn u64_le(list<u8> b) → int ⇥ SafetensorError {
    require b.length() ≥ 8 throw variant BadFormat { message = "truncated safetensors header prefix" }

    let int r7 ← b.get(7) coalesce 0 ∷ u8 ↦ int

    require r7 ≺ 128 throw variant BadBounds { message = "header size above the numeric carrier" }

    return (b[0 ‥ 8] ↦ u64 via le) ↦ int ⊥ 0
}

# Container-header validation from a bounded `[0..8+N)` slice against a
# declared `artifact_length` (which may be multi-GB). The JSON header is
# sliced out of the buffer in one range operation and validated as UTF-8;
# the lexer below runs over the byte buffer, never over a per-character
# copy.
fn header_with_length(list<u8> buf, int artifact_length) → HeaderCursor ⇥ SafetensorError {
    # --- header length + bounds (fail closed) -----------------------------
    let int header ← u64_le(buf)

    require header ≥ 1 throw variant BadFormat { message = "invalid safetensors header size" }

    require header ≤ HEADER_LIMIT throw variant BadBounds { message = "header size above ceiling" }

    require 8 + header ≤ artifact_length throw variant BadFormat { message = "truncated header — header size beyond file" }

    require 8 + header ≤ buf.length() throw variant BadFormat { message = "truncated header — header size beyond file" }

    # --- header slice + UTF-8 validation ----------------------------------
    let list<b8> text ↤ buf[8 ‥ 8 + header]

    do {
        let string ? ← text ↦ string
    }
    catch err {
        throw variant BadFormat { message = "header is not valid UTF-8" }
    }

    return HeaderCursor { header = header, text = text }
}

fn header(list<u8> corpus) → HeaderCursor ⇥ SafetensorError {
    return header_with_length(corpus, corpus.length())
}

# -------------------------------------------------------------------------
# JSON tokenizer (strict lexical validation of the header). The lexer runs
# over the header's UTF-8 bytes with integer offsets: one comparison per
# byte, token payloads materialized as single unescaped span reads (never
# per-character concatenation).
# -------------------------------------------------------------------------

# Byte-span text: one conversion per unescaped run (spans start and end at
# ASCII structural bytes, so they are whole UTF-8 characters; the default
# covers the impossible mid-character cut).
fn span_text(list<b8> h, int a, int b) → string {
    return h[a ‥ b] ↦ string ⊥ ""
}

# Exact byte-run match of an ASCII word at pos (a failed or truncated match
# is simply false, like the string-slice comparison it replaces).
fn word_at(list<b8> h, int pos, string word) → bool {
    let list<b8> w ↤ word

    if pos + w.length() ≻ h.length() then return false

    for exclusive w.length() let j {
        if not ((h.get(pos + j) coalesce 0x00 ∷ b8) ≡ (w.get(j) coalesce 0x00 ∷ b8)) then return false
    }

    return true
}

# Parse a JSON string starting at byte offset i (the opening quote). Handles
# the standard escapes; \uXXXX is form-validated (4 hex digits) and
# preserved verbatim (no codepoint intrinsic — compiler-boundary note
# above). Unescaped text is carried as whole spans between escapes; the
# five unescaped control bytes that JSON forbids here fail closed.
fn read_string(list<b8> h, int i) → StringValue ⇥ SafetensorError {
    mut string payload ← ""
    mut int pos ← i + 1
    mut int span ← pos

    while pos ≺ h.length() {
        let b8 c ← h.get(pos) coalesce 0x00 ∷ b8

        if c ≡ 0x22 ∷ b8 {
            payload ← payload + span_text(h, span, pos)
            return StringValue { pos = pos + 1, payload = payload }
        }

        if c ≡ 0x5c ∷ b8 {
            payload ← payload + span_text(h, span, pos)

            require pos + 1 ≺ h.length() throw variant BadFormat { message = "unterminated string escape" }

            let b8 e ← h.get(pos + 1) coalesce 0x00 ∷ b8

            if e ≡ 0x22 ∷ b8 {
                payload ← payload + «"»
                pos ← pos + 2
            }
            elif e ≡ 0x5c ∷ b8 {
                payload ← payload + "\\"
                pos ← pos + 2
            }
            elif e ≡ 0x2f ∷ b8 {
                payload ← payload + "/"
                pos ← pos + 2
            }
            elif e ≡ 0x6e ∷ b8 {
                payload ← payload + "\n"
                pos ← pos + 2
            }
            elif e ≡ 0x72 ∷ b8 {
                payload ← payload + "\r"
                pos ← pos + 2
            }
            elif e ≡ 0x74 ∷ b8 {
                payload ← payload + "\t"
                pos ← pos + 2
            }
            elif e ≡ 0x62 ∷ b8 {
                payload ← payload + "\u{08}"
                pos ← pos + 2
            }
            elif e ≡ 0x66 ∷ b8 {
                payload ← payload + "\u{0C}"
                pos ← pos + 2
            }
            elif e ≡ 0x75 ∷ b8 {
                require pos + 5 ≺ h.length() throw variant BadFormat { message = "truncated \\u escape" }

                for range 0 ‥ 4 let j {
                    require is_hex_byte(h.get(pos + 2 + j) coalesce 0x00 ∷ b8) throw variant BadFormat { message = "malformed \\u escape" }
                }

                # \uXXXX is preserved verbatim: the raw 6 escape bytes.
                payload ← payload + span_text(h, pos, pos + 6)
                pos ← pos + 6
            }
            else {
                throw variant BadFormat { message = "unknown string escape" }
            }

            span ← pos
        }
        elif c ≡ 0x0a ∷ b8 or c ≡ 0x0d ∷ b8 or c ≡ 0x09 ∷ b8 or c ≡ 0x08 ∷ b8 or c ≡ 0x0c ∷ b8 {
            throw variant BadFormat { message = "unescaped control character in string" }
        }
        else {
            pos ← pos + 1
        }
    }

    throw variant BadFormat { message = "unterminated string" }
}

# Parse a JSON number starting at byte offset i (digit or minus). Returns
# the raw number text (JSON grammar: -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?)
# as one span read.
fn read_number(list<b8> h, int i) → StringValue ⇥ SafetensorError {
    mut int pos ← i

    if (h.get(pos) coalesce 0x00 ∷ b8) ≡ 0x2d ∷ b8 {
        pos ← pos + 1

        require pos ≺ h.length() throw variant BadFormat { message = "malformed number" }
    }

    let b8 first ← h.get(pos) coalesce 0x00 ∷ b8

    if first ≡ 0x30 ∷ b8 {
        pos ← pos + 1

        reject pos ≺ h.length() and is_digit_byte(h.get(pos) coalesce 0x00 ∷ b8) throw variant BadFormat { message = "malformed number" }
    }
    elif is_digit_byte(first) {
        while pos ≺ h.length() and is_digit_byte(h.get(pos) coalesce 0x00 ∷ b8) {
            pos ← pos + 1
        }
    }
    else {
        throw variant BadFormat { message = "malformed number" }
    }

    if pos ≺ h.length() and (h.get(pos) coalesce 0x00 ∷ b8) ≡ 0x2e ∷ b8 {
        pos ← pos + 1

        require pos ≺ h.length() throw variant BadFormat { message = "malformed number" }

        require is_digit_byte(h.get(pos) coalesce 0x00 ∷ b8) throw variant BadFormat { message = "malformed number" }

        while pos ≺ h.length() and is_digit_byte(h.get(pos) coalesce 0x00 ∷ b8) {
            pos ← pos + 1
        }
    }

    if pos ≺ h.length() and ((h.get(pos) coalesce 0x00 ∷ b8) ≡ 0x65 ∷ b8 or (h.get(pos) coalesce 0x00 ∷ b8) ≡ 0x45 ∷ b8) {
        pos ← pos + 1

        if pos ≺ h.length() and ((h.get(pos) coalesce 0x00 ∷ b8) ≡ 0x2b ∷ b8 or (h.get(pos) coalesce 0x00 ∷ b8) ≡ 0x2d ∷ b8) {
            pos ← pos + 1
        }

        require pos ≺ h.length() throw variant BadFormat { message = "malformed number" }

        require is_digit_byte(h.get(pos) coalesce 0x00 ∷ b8) throw variant BadFormat { message = "malformed number" }

        while pos ≺ h.length() and is_digit_byte(h.get(pos) coalesce 0x00 ∷ b8) {
            pos ← pos + 1
        }
    }

    return StringValue { pos = pos, payload = span_text(h, i, pos) }
}

# Tokenize the whole header (strict lexical validation, bounded token
# count — checked before more tokens are appended).
fn scan(list<b8> h) → list<Token> ⇥ SafetensorError {
    mut list<Token> tks ← empty
    mut int pos ← 0

    while pos ≺ h.length() {
        let b8 c ← h.get(pos) coalesce 0x00 ∷ b8

        if is_optional_byte(c) {
            pos ← pos + 1
        }
        elif c ≡ 0x7b ∷ b8 {
            tks.append(Token { kind = 0, payload = "{" })
            pos ← pos + 1
        }
        elif c ≡ 0x7d ∷ b8 {
            tks.append(Token { kind = 1, payload = "}" })
            pos ← pos + 1
        }
        elif c ≡ 0x5b ∷ b8 {
            tks.append(Token { kind = 2, payload = "[" })
            pos ← pos + 1
        }
        elif c ≡ 0x5d ∷ b8 {
            tks.append(Token { kind = 3, payload = "]" })
            pos ← pos + 1
        }
        elif c ≡ 0x3a ∷ b8 {
            tks.append(Token { kind = 4, payload = ":" })
            pos ← pos + 1
        }
        elif c ≡ 0x2c ∷ b8 {
            tks.append(Token { kind = 5, payload = "," })
            pos ← pos + 1
        }
        elif c ≡ 0x22 ∷ b8 {
            let StringValue s ← read_string(h, pos)
            tks.append(Token { kind = 6, payload = s.payload })
            pos ← s.pos
        }
        elif is_digit_byte(c) or c ≡ 0x2d ∷ b8 {
            let StringValue n ← read_number(h, pos)
            tks.append(Token { kind = 7, payload = n.payload })
            pos ← n.pos
        }
        elif c ≡ 0x74 ∷ b8 {
            if word_at(h, pos, "true") {
                tks.append(Token { kind = 8, payload = "true" })
                pos ← pos + 4
            }
            else {
                throw variant BadFormat { message = "malformed literal" }
            }
        }
        elif c ≡ 0x66 ∷ b8 {
            if word_at(h, pos, "false") {
                tks.append(Token { kind = 9, payload = "false" })
                pos ← pos + 5
            }
            else {
                throw variant BadFormat { message = "malformed literal" }
            }
        }
        elif c ≡ 0x6e ∷ b8 {
            if word_at(h, pos, "null") {
                tks.append(Token { kind = 10, payload = "null" })
                pos ← pos + 4
            }
            else {
                throw variant BadFormat { message = "malformed literal" }
            }
        }
        else {
            throw variant BadFormat { message = "unexpected character in header" }
        }

        require tks.length() ≤ TOKEN_LIMIT throw variant BadBounds { message = "header token count above ceiling" }
    }

    return tks
}

# -------------------------------------------------------------------------
# JSON structural walk (strict grammar validation + generic extraction).
# -------------------------------------------------------------------------

# Token lookup still paper-overs a missing index as kind=-1. Making these
# failable ripples through the whole header walker; conversion is outside
# this unit.
fn dtype_kind(list<Token> tks, int i) → int {
    let Token t ← tks.get(i) coalesce Token { kind = -1, payload = "" }
    return t.kind
}

fn value_at(list<Token> tks, int i) → string {
    let Token t ← tks.get(i) coalesce Token { kind = -1, payload = "" }
    return t.payload
}

# Integer-valued JSON number -> number (digits only, length-capped). A
# fractional/exponent number is not a valid shape dim or offset.
fn parse_integer(string raw) → int ⇥ SafetensorError {
    require raw.length() ≢ 0 throw variant BadFormat { message = "malformed integer" }

    require raw.length() ≤ 18 throw variant BadFormat { message = "integer above the numeric carrier" }

    for from raw let c {
        require is_digit(c) throw variant BadFormat { message = "non-integer value" }
    }

    do {
        let int v ↤ raw
        return v
    }
    catch err {
        throw variant BadFormat { message = "malformed integer" }
    }
}

# Parse a JSON array of integers starting at pos (token kind 2). Bounded
# array length (shape rank / offsets / any numeric array).
fn parse_numbers(list<Token> tks, int pos) → NumberCursor ⇥ SafetensorError {
    require dtype_kind(tks, pos) ≡ 2 throw variant BadFormat { message = "expected an integer array" }

    mut int p ← pos + 1
    mut list<int> values ← empty

    while p ≺ tks.length() {
        if dtype_kind(tks, p) ≡ 3 {
            p ← p + 1
            return NumberCursor { pos = p, values = values }
        }

        require dtype_kind(tks, p) ≡ 7 throw variant BadFormat { message = "array must contain only integers" }

        values.append(parse_integer(value_at(tks, p)))
        p ← p + 1

        require values.length() ≤ ARRAY_LIMIT throw variant BadBounds { message = "array above length ceiling" }

        require p ≺ tks.length() throw variant BadFormat { message = "unterminated array" }

        if dtype_kind(tks, p) ≡ 5 {
            p ← p + 1

            require p ≺ tks.length() throw variant BadFormat { message = "trailing comma in array" }

            require dtype_kind(tks, p) ≢ 3 throw variant BadFormat { message = "trailing comma in array" }
        }
        elif dtype_kind(tks, p) ≢ 3 {
            throw variant BadFormat { message = "malformed array separator" }
        }
    }

    throw variant BadFormat { message = "unterminated array" }
}

# Parse the __metadata__ object: a flat string->string table. KV count is
# bounded while collecting (ceiling before the walk grows further).
fn parse_metadata(list<Token> tks, int pos) → MetadataCursor ⇥ SafetensorError {
    require dtype_kind(tks, pos) ≡ 0 throw variant BadMetadata { message = "metadata must be a JSON object" }

    mut int p ← pos + 1
    mut list<string> keys ← empty
    mut list<string> values ← empty

    while p ≺ tks.length() {
        if dtype_kind(tks, p) ≡ 1 {
            p ← p + 1
            return MetadataCursor { pos = p, keys = keys, values = values }
        }

        require dtype_kind(tks, p) ≡ 6 throw variant BadMetadata { message = "malformed metadata member" }

        let string key ← value_at(tks, p)
        p ← p + 1

        require dtype_kind(tks, p) ≡ 4 throw variant BadMetadata { message = "missing colon in metadata" }

        p ← p + 1

        require dtype_kind(tks, p) ≡ 6 throw variant BadMetadata { message = "metadata value must be a string" }

        let string payload ← value_at(tks, p)
        p ← p + 1
        keys.append(key)
        values.append(payload)

        require keys.length() ≤ KV_LIMIT throw variant BadBounds { message = "metadata KV count above ceiling" }

        require p ≺ tks.length() throw variant BadMetadata { message = "unterminated metadata object" }

        if dtype_kind(tks, p) ≡ 5 {
            p ← p + 1

            require p ≺ tks.length() throw variant BadMetadata { message = "trailing comma in metadata" }

            require dtype_kind(tks, p) ≢ 1 throw variant BadMetadata { message = "trailing comma in metadata" }
        }
        elif dtype_kind(tks, p) ≢ 1 {
            throw variant BadMetadata { message = "malformed metadata separator" }
        }
    }

    throw variant BadMetadata { message = "unterminated metadata object" }
}

# Parse one tensor descriptor: {"dtype": "...", "shape": [...],
# "data_offsets": [begin, end]}. Unknown members, duplicates, and missing
# members fail closed.
fn parse_tensor(list<Token> tks, int pos, string name) → TensorCursor ⇥ SafetensorError {
    require dtype_kind(tks, pos) ≡ 0 throw variant BadFormat { message = "tensor descriptor must be an object: §"(name) }

    mut int p ← pos + 1
    mut bool seen_dtype ← false
    mut bool seen_shape ← false
    mut bool seen_offset ← false
    mut string kind ← ""
    mut list<int> shape ← empty
    mut int start ← 0
    mut int end ← 0

    while p ≺ tks.length() {
        if dtype_kind(tks, p) ≡ 1 {
            p ← p + 1

            require seen_dtype throw variant BadFormat { message = "missing dtype in tensor descriptor: §"(name) }

            require seen_shape throw variant BadFormat { message = "missing shape in tensor descriptor: §"(name) }

            require seen_offset throw variant BadFormat { message = "missing data_offsets in tensor descriptor: §"(name) }

            return TensorCursor { pos = p, dtype = kind, shape = shape, start = start, end = end }
        }

        require dtype_kind(tks, p) ≡ 6 throw variant BadFormat { message = "malformed tensor descriptor member" }

        let string key ← value_at(tks, p)
        p ← p + 1

        require dtype_kind(tks, p) ≡ 4 throw variant BadFormat { message = "missing colon in tensor descriptor" }

        p ← p + 1

        if key ≡ "dtype" {
            reject seen_dtype throw variant BadFormat { message = "duplicate dtype in tensor descriptor" }

            require dtype_kind(tks, p) ≡ 6 throw variant BadFormat { message = "dtype must be a string" }

            kind ← value_at(tks, p)
            p ← p + 1
            seen_dtype ← true
        }
        elif key ≡ "shape" {
            reject seen_shape throw variant BadFormat { message = "duplicate shape in tensor descriptor" }

            let NumberCursor nc ← parse_numbers(tks, p)
            p ← nc.pos
            shape ← nc.values
            seen_shape ← true
        }
        elif key ≡ "data_offsets" {
            reject seen_offset throw variant BadFormat { message = "duplicate data_offsets in tensor descriptor" }

            let NumberCursor oc ← parse_numbers(tks, p)
            p ← oc.pos

            require oc.values.length() ≡ 2 throw variant BadOffset { message = "data_offsets must have exactly 2 values: §"(name) }

            start ← int_at(oc.values, 0)
            end ← int_at(oc.values, 1)
            seen_offset ← true
        }
        else {
            throw variant BadFormat { message = "unknown member in tensor descriptor: §"(key) }
        }

        require p ≺ tks.length() throw variant BadFormat { message = "unterminated tensor descriptor" }

        if dtype_kind(tks, p) ≡ 5 {
            p ← p + 1

            require p ≺ tks.length() throw variant BadFormat { message = "trailing comma in tensor descriptor" }

            require dtype_kind(tks, p) ≢ 1 throw variant BadFormat { message = "trailing comma in tensor descriptor" }
        }
        elif dtype_kind(tks, p) ≢ 1 {
            throw variant BadFormat { message = "malformed tensor descriptor separator" }
        }
    }

    throw variant BadFormat { message = "unterminated tensor descriptor" }
}

# Walk the token stream: top-level must be a single JSON object whose
# members are an optional __metadata__ object plus tensor entries. Every
# tensor descriptor is structurally validated and retained generically. The
# top-level object must close exactly at the end of the token stream — any
# trailing token after the closing brace fails closed (no partial-header
# admission). Count ceilings are enforced WHILE collecting (before any
# count-driven work downstream).
fn walk(list<Token> tks) → Structure ⇥ SafetensorError {
    require tks.length() ≢ 0 throw variant BadFormat { message = "empty header" }

    require dtype_kind(tks, 0) ≡ 0 throw variant BadFormat { message = "header is not a JSON object" }

    mut int pos ← 1
    mut bool seen_meta ← false
    mut list<string> meta_keys ← empty
    mut list<string> meta_values ← empty
    mut list<string> names ← empty
    mut list<string> dtypes ← empty
    mut list<list<int>> shapes ← empty
    mut list<int> starts ← empty
    mut list<int> end ← empty

    while pos ≺ tks.length() {
        if dtype_kind(tks, pos) ≡ 1 {
            pos ← pos + 1

            # Fail closed on trailing content: the top-level object must
            # close exactly at the end of the token stream.
            require pos ≡ tks.length() throw variant BadFormat { message = "trailing tokens after the header object" }

            return Structure { meta_keys = meta_keys, meta_values = meta_values, names = names, dtypes = dtypes, shapes = shapes, starts = starts, end = end }
        }

        require dtype_kind(tks, pos) ≡ 6 throw variant BadFormat { message = "malformed header member" }

        let string key ← value_at(tks, pos)
        pos ← pos + 1

        require dtype_kind(tks, pos) ≡ 4 throw variant BadFormat { message = "missing colon in header" }

        pos ← pos + 1

        if key ≡ "__metadata__" {
            reject seen_meta throw variant BadMetadata { message = "duplicate __metadata__" }

            seen_meta ← true
            let MetadataCursor m ← parse_metadata(tks, pos)
            pos ← m.pos
            meta_keys ← m.keys
            meta_values ← m.values
        }
        else {
            require names.length() ≺ TENSOR_LIMIT throw variant BadBounds { message = "tensor count above ceiling" }

            require key.length() ≤ NAME_LIMIT throw variant BadBounds { message = "tensor name above length ceiling" }

            let TensorCursor t ← parse_tensor(tks, pos, key)
            pos ← t.pos
            names.append(key)
            dtypes.append(t.dtype)
            shapes.append(t.shape)
            starts.append(t.start)
            end.append(t.end)
        }

        require pos ≺ tks.length() throw variant BadFormat { message = "unterminated header object" }

        if dtype_kind(tks, pos) ≡ 5 {
            pos ← pos + 1

            require pos ≺ tks.length() throw variant BadFormat { message = "trailing comma in header" }

            require dtype_kind(tks, pos) ≢ 1 throw variant BadFormat { message = "trailing comma in header" }
        }
        elif dtype_kind(tks, pos) ≢ 1 {
            throw variant BadFormat { message = "malformed header separator" }
        }
    }

    throw variant BadFormat { message = "unterminated header object" }
}

# -------------------------------------------------------------------------
# Row validation helpers.
# -------------------------------------------------------------------------

# Build the manifest metadata table from the extracted header metadata
# (parallel key/value lists, header order preserved).
fn metadata(list<string> keys, list<string> values) → list<capsule.SafetensorsMetadata> {
    mut list<capsule.SafetensorsMetadata> out ← empty

    for range 0 ‥ keys.length() let i {
        out.append(capsule.SafetensorsMetadata { key = keys.get(i) coalesce "", payload = values.get(i) coalesce "" })
    }

    return out
}

# Element-count product with checked multiplication. The generic format
# parser has no model-specific dimension table.
fn numel(list<int> shape) → int ⇥ SafetensorError {
    mut int product ← 1

    for from shape let dim {
        require dim ≥ 1 throw variant BadShape { message = "non-positive dimension" }

        product ← mul(product, dim)
    }

    return product
}

fn add(int a, int b) → int ⇥ SafetensorError {
    reject a ≺ 0 or b ≺ 0 or a ≻ MAX_NUMBER - b throw variant BadBounds { message = "checked integer addition overflow" }

    return a + b
}

fn mul(int a, int b) → int ⇥ SafetensorError {
    reject a ≺ 0 or b ≺ 0 or b ≢ 0 and a ≻ MAX_NUMBER / b throw variant BadBounds { message = "checked integer multiplication overflow" }

    return a * b
}

# Known Safetensors storage widths. A zero result means the wire dtype is
# retained opaquely; the generic parser must not reject a future dtype merely
# because Gradus cannot materialize it yet.
@ private
const map<string, int> DTYPE_BYTES = { "BOOL": 1, "U8": 1, "I8": 1, "F8_E4M3": 1, "F8_E5M2": 1, "F16": 2, "BF16": 2, "I16": 2, "U16": 2, "F32": 4, "I32": 4, "U32": 4, "F64": 8, "I64": 8, "U64": 8, "C64": 8, "I128": 16, "U128": 16, "F128": 16, "I256": 32, "U256": 32, "F256": 32 }

fn dtype_bytes(string kind) → int {
    return DTYPE_BYTES.get(kind) coalesce 0
}

# In-bounds integer read. A miss fails closed instead of coalescing to -1.
fn int_at(list<int> xs, int i) → int ⇥ SafetensorError {
    require i ≥ 0 throw variant BadBounds { message = "integer index out of range" }

    require i ≺ xs.length() throw variant BadBounds { message = "integer index out of range" }

    do {
        return xs[i]
    }
    catch err {
        throw variant BadBounds { message = "integer index out of range" }
    }

    throw variant BadBounds { message = "integer index out of range" }
}

# Fail-closed byte width for the 8 raw MLX/HuggingFace checkpoint dtypes
# `{F32, F16, BF16, U32, U8, I32, I8, F8_E4M3}`.
@ public
fn dtype_byte_width(string kind) → int ⇥ SafetensorError {
    switch kind {
        case "F32" {
            return 4
        }
        case "F16" {
            return 2
        }
        case "BF16" {
            return 2
        }
        case "U32" {
            return 4
        }
        case "U8" {
            return 1
        }
        case "I32" {
            return 4
        }
        case "I8" {
            return 1
        }
        case "F8_E4M3" {
            return 1
        }
        default {
            throw variant UnknownDtype { message = "unsupported Safetensors dtype: §"(kind) }
        }
    }
}

# The public Gradus DType union covers the closed compute-carrier types
# `{F32, F16, BF16, I32, U8}`. Packed/raw checkpoint storage dtypes
# (`U32`, `I8`, `F8_E4M3`) are validated by `dtype_byte_width`, carried on
# `SelectedTensor.raw_dtype`, and leave `dtype_tag` as `null` rather than
# aliasing a compute dtype.
fn dtype_tag_of(string kind) → dtype.DType ∪ none ⇥ SafetensorError {
    switch kind {
        case "F32" {
            return dtype.f32()
        }
        case "F16" {
            return dtype.f16()
        }
        case "BF16" {
            return dtype.bf16()
        }
        case "I32" {
            return dtype.i32()
        }
        case "U8" {
            return dtype.u8()
        }
        case "U32" {
            return null
        }
        case "I8" {
            return null
        }
        case "F8_E4M3" {
            return null
        }
        default {
            throw variant UnknownDtype { message = "unsupported materialized Safetensors dtype: §"(kind) }
        }
    }
}

# Select one bounded tensor after the source adapter has inspected the
# container header. Identity, shape, and ranges are caller-supplied facts;
# no model-specific tensor is encoded here.
@ public
fn admit_selected(string name, string kind, list<int> shape, list<b8> payload, string digest, int artifact_length, int data_start, int relative_start, int relative_end) → SelectedTensor ⇥ SafetensorError {
    require name.length() ≢ 0 throw variant BadFormat { message = "selected tensor name is empty" }

    require hex_ok(digest) throw variant BadDigest { message = "malformed artifact digest" }

    require artifact_length ≻ 0 throw variant BadBounds { message = "invalid artifact length" }

    require data_start ≥ 8 and data_start ≤ artifact_length throw variant BadOffset { message = "invalid data-region start" }

    require relative_start ≥ 0 and relative_end ≻ relative_start throw variant BadOffset { message = "selected tensor range is invalid" }

    let int absolute_end ← add(data_start, relative_end)

    require absolute_end ≤ artifact_length throw variant BadOffset { message = "selected tensor range exceeds the artifact" }

    let int elem_width ← dtype_byte_width(kind)
    let dtype.DType ∪ none dtype_tag ← dtype_tag_of(kind)
    let int values ← numel(shape)

    require relative_end - relative_start ≡ mul(values, elem_width) throw variant BadShape { message = "selected tensor range does not match its shape" }

    require payload.length() ≡ relative_end - relative_start throw variant BadOffset { message = "selected tensor payload length does not match its range" }

    let int absolute_start ← add(data_start, relative_start)
    return SelectedTensor { name = name, raw_dtype = kind, dtype_tag = dtype_tag, shape = shape, artifact_digest = digest, artifact_length = artifact_length, data_start = data_start, relative_start = relative_start, relative_end = relative_end, absolute_start = absolute_start, payload = payload }
}

fn validate_identity(artifact.ContentIdentity id, int artifact_length) → artifact.ContentIdentity ⇥ SafetensorError {
    require artifact_length ≻ 0 throw variant BadBounds { message = "invalid artifact length" }

    require id.length ≡ artifact_length throw variant BadBounds { message = "content identity length does not match artifact length" }

    do {
        return artifact.identity(id.algorithm, id.digest, id.length)
    }
    catch err {
        throw variant BadDigest { message = err.message }
    }
}

fn admit_header_parts(int header_len, list<b8> header_bytes, int artifact_length, artifact.ContentIdentity identity) → capsule.Capsule ⇥ SafetensorError {
    let artifact.ContentIdentity clean_id ← validate_identity(identity, artifact_length)
    let int data_length ← artifact_length - 8 - header_len

    require data_length ≻ 0 throw variant BadBounds { message = "empty Safetensors data region" }

    let list<Token> tks ← scan(header_bytes)
    let Structure st ← walk(tks)
    let int n ← st.names.length()
    let list<string> sorted_names ← st.names.sorted()

    for range 1 ‥ n let i {
        let string previous ← sorted_names.get(i - 1) coalesce ""
        let string current ← sorted_names.get(i) coalesce ""

        reject previous ≡ current throw variant BadOffset { message = "duplicate tensor name: §"(current) }
    }

    mut int total_elements ← 0
    mut list<capsule.SafetensorsTensorDescriptor> descriptors ← empty
    mut list<TensorRange> ranges ← empty
    let list<int> empty_dims ← empty

    for exclusive n let i {
        let string name ← st.names.get(i) coalesce ""
        let string kind ← st.dtypes.get(i) coalesce ""
        let list<int> dimensions ← st.shapes.get(i) coalesce empty_dims
        let int start ← int_at(st.starts, i)
        let int end ← int_at(st.end, i)
        let int bytes_per_element ← dtype_bytes(kind)
        let int elements ← numel(dimensions)

        require start ≥ 0 and end ≻ start and end ≤ data_length throw variant BadOffset { message = "tensor data range is invalid: §"(name) }

        if bytes_per_element ≻ 0 {
            require end - start ≡ mul(elements, bytes_per_element) throw variant BadShape { message = "shape/offset inconsistency for §"(name) }
        }

        total_elements ← add(total_elements, elements)
        descriptors.append(capsule.SafetensorsTensorDescriptor { name = name, dtype = kind, shape = dimensions, start = start, end = end, elements = elements })
        ranges.append(TensorRange { start = start, end = end })
    }

    let list<TensorRange> sorted_ranges ← sort via asc from ranges let tensor_range {
        return tensor_range.start
    }

    for range 1 ‥ n let i {
        let TensorRange previous ← sorted_ranges.get(i - 1) coalesce TensorRange { start = 0, end = 0 }
        let TensorRange current ← sorted_ranges.get(i) coalesce TensorRange { start = 0, end = 0 }

        reject previous.end ≻ current.start throw variant BadOffset { message = "overlapping tensor data regions" }
    }

    do {
        let capsule.SafetensorsManifest manifest ← capsule.SafetensorsManifest { format = "safetensors", version = "1.0.0", artifact_length = artifact_length, data_length = data_length, metadata = metadata(st.meta_keys, st.meta_values), tensors = descriptors }
        let capsule.Capsule c ← capsule.construct_manifest(capsule.schema_version_text(), clean_id, capsule.safetensors_manifest(manifest))
        return c
    }
    catch err {
        throw variant BadAdmission { message = "capsule admission rejected: §"(err.message) }
    }
}

# Header-only admission from `[0..8+N)` bytes, declared `artifact_length`,
# and `artifact.ContentIdentity` (zero whole-file buffering).
@ public
fn admit_header(list<u8> header_bytes, int artifact_length, artifact.ContentIdentity identity) → capsule.Capsule ⇥ SafetensorError {
    let HeaderCursor cc ← header_with_length(header_bytes, artifact_length)
    return admit_header_parts(cc.header, cc.text, artifact_length, identity)
}

# Range-based header inspection: reads `[0..8)` length prefix, then
# `[8..8+N)` JSON header from `source(offset, length)` without buffering
# the tensor data region.
@ public
fn inspect((int, int) → list<b8> ⇥ SafetensorError source, int artifact_length, artifact.ContentIdentity identity) → capsule.Capsule ⇥ SafetensorError {
    require artifact_length ≥ 8 throw variant BadFormat { message = "truncated safetensors header prefix" }

    let list<b8> prefix_wire ← source(0, 8)

    require prefix_wire.length() ≡ 8 throw variant BadFormat { message = "truncated safetensors header prefix" }

    let list<u8> prefix ← prefix_wire ↦ list<u8>
    let int header_len ← u64_le(prefix)

    require header_len ≥ 1 throw variant BadFormat { message = "invalid safetensors header size" }

    require header_len ≤ HEADER_LIMIT throw variant BadBounds { message = "header size above ceiling" }

    require 8 + header_len ≤ artifact_length throw variant BadFormat { message = "truncated header — header size beyond file" }

    let list<b8> header_wire ← source(8, header_len)

    require header_wire.length() ≡ header_len throw variant BadFormat { message = "truncated header — header size beyond file" }

    do {
        let string ? ← header_wire ↦ string
    }
    catch err {
        throw variant BadFormat { message = "header is not valid UTF-8" }
    }

    return admit_header_parts(header_len, header_wire, artifact_length, identity)
}

# Parse one whole Safetensors member into the generic schema-2 capsule. The
# manifest preserves metadata and every descriptor but applies no model,
# tokenizer, or naming policy.
@ public
fn admit(list<u8> corpus, string digest) → capsule.Capsule ⇥ SafetensorError {
    let HeaderCursor cc ← header(corpus)

    require hex_ok(digest) throw variant BadDigest { message = "malformed digest value" }

    let artifact.ContentIdentity identity ← artifact.ContentIdentity { algorithm = DIGEST_SHA256, digest = digest, length = corpus.length() }
    return admit_header_parts(cc.header, cc.text, corpus.length(), identity)
}

+++ faber test
# Focused compile-time proof for the public Safetensors format boundary.
#
# The large fixture below is test evidence only. Its names, metadata, digest,
# and byte ranges are not part of the public parser contract. The tests prove
# that structurally valid containers with different names, dtypes, header
# alignment, and data gaps are accepted, while malformed structure is
# rejected. Model and tokenizer admission belongs to a downstream adapter.

import from "gradus:model/safetensors" safetensors

import from "gradus:model/capsule" capsule

import from "gradus:model/artifact" artifact

import from "gradus:dtype" dtype

# A fixture header reconstructed from a checked-in evidence artifact. Exact
# values here are deliberately confined to this .proba file.
const string FIXTURE_JSON = «{"__metadata__":{"format.name":"safetensors","format.version":"1.0.0","model.arch":"llama","model.density":"dense","model.layers":"1","model.context":"2048","tokenizer.model":"gpt2","tokenizer.pre":"smollm","tokenizer.vocab_digest":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","tokenizer.eog":"0,2","tokenizer.bos_free":"true","tokenizer.space_prefix_free":"true"},"model.embed_tokens.weight":{"dtype":"F32","shape":[8,4],"data_offsets":[0,128]},"model.norm.weight":{"dtype":"F32","shape":[8],"data_offsets":[128,160]},"model.layers.0.self_attn.q_proj.weight":{"dtype":"F32","shape":[8,8],"data_offsets":[160,416]},"model.layers.0.self_attn.v_proj.weight":{"dtype":"F32","shape":[8,4],"data_offsets":[416,544]},"model.layers.0.mlp.down_proj.weight":{"dtype":"F32","shape":[4,8],"data_offsets":[544,672]}}»

const int FIXTURE_DATA_LENGTH = 672

const string FIXTURE_DIGEST = "992426b54e8d7a1b7e24e4167a92a5e630bb79ef7e89efdd5fd2cb2b29d0a0bc"

const string ALT_DIGEST = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# 8-byte little-endian header-size prefix.
fn header8(int n) → list<u8> {
    return (n ↦ u64 ⊥ 0) ↦ list<b8, size 8> via le ↦ list<u8>
}

fn text_bytes(string s) → list<u8> {
    let list<b8> o ↤ s
    return o ↦ list<u8>
}

fn join(list<u8> a, list<u8> b) → list<u8> {
    mut list<u8> out ← empty
    out.extend(a)
    out.extend(b)
    return out
}

fn data_pattern(int n) → list<u8> {
    mut list<u8> out ← empty
    for range 0‥n let i {
        out.append((i * 13 + 7) % 256 ↦ u8)
    }
    return out
}

# Fixture helper. Padding is valid JSON whitespace included in N; the parser
# also accepts the ordinary non-aligned framing built by contain_raw below.
fn contain(string header_json, list<u8> data) → list<u8> {
    let list<u8> hb ← text_bytes(header_json)
    let int n ← hb.length()
    let int aligned ← ((n + 7) / 8) * 8
    mut list<u8> padded ← empty
    padded.extend(hb)
    for range n‥aligned let i {
        padded.append(32 ↦ u8)
    }
    return join(join(header8(aligned), padded), data)
}

# Standard framing with the exact JSON byte length. N need not be aligned.
fn contain_raw(string header_json, list<u8> data) → list<u8> {
    let list<u8> hb ← text_bytes(header_json)
    return join(join(header8(hb.length()), hb), data)
}

fn fixture() → list<u8> {
    return contain(FIXTURE_JSON, data_pattern(FIXTURE_DATA_LENGTH))
}

fn admitted(list<u8> corpus, string digest) → bool {
    do {
        let capsule.Capsule ? ← safetensors.admit(corpus, digest)
        return true
    }
    catch err {
        return false
    }
}

fn error(list<u8> corpus, string digest) → string {
    do {
        let capsule.Capsule ? ← safetensors.admit(corpus, digest)
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn truncated(int n) → list<u8> {
    return fixture().take(n) ⊥ []
}

fn descriptor(capsule.SafetensorsManifest m) → capsule.SafetensorsTensorDescriptor {
    do {
        return m.description(0)
    }
    catch err {
        return capsule.SafetensorsTensorDescriptor {name = "", dtype = "", shape = [], start = -1, end = -1, elements = -1}
    }
}

fn roundtrip(capsule.Capsule c) → bool {
    do {
        let string wire ← capsule.serialize_identity(c)
        let capsule.Identity i ← capsule.deserialize_identity(wire)
        return c.identity() ≡ i
    }
    catch err {
        return false
    }
}

test "the evidence fixture admits as a generic Safetensors container" {
    let list<u8> corpus ← fixture()
    do {
        let capsule.Capsule c ← safetensors.admit(corpus, FIXTURE_DIGEST)
        assert c.format() ≡ "safetensors"
        assert c.tensor_count() ≡ 5
        assert c.length() ≡ corpus.length()
        assert c.digest() ≡ FIXTURE_DIGEST
        assert c.algorithm() ≡ "sha-256"
        assert c.safetensors_manifest() not is none
    }
    catch err {
        assert false
    }
}

test "metadata and descriptor facts are preserved without model admission" {
    do {
        let capsule.Capsule c ← safetensors.admit(fixture(), FIXTURE_DIGEST)
        let capsule.SafetensorsManifest m ← c.safetensors_manifest() coalesce capsule.SafetensorsManifest {format = "", version = "", artifact_length = 0, data_length = 0, metadata = [], tensors = []}
        assert m.format ≡ "safetensors"
        assert m.version ≡ "1.0.0"
        assert m.metadata_count() ≻ 0
        let capsule.SafetensorsTensorDescriptor d ← descriptor(m)
        assert d.name ≡ "model.embed_tokens.weight"
        assert d.dtype ≡ "F32"
        assert d.elements ≡ 32
        assert d.start ≡ 0
        assert d.end ≡ 128
    }
    catch err {
        assert false
    }
}

test "a structurally valid alternate tensor is admitted" {
    let string header ← «{"renamed.weight":{"dtype":"F16","shape":[2,2],"data_offsets":[0,8]}}»
    assert admitted(contain_raw(header, data_pattern(8)), ALT_DIGEST)
}

test "an ordinary non-aligned header length is admitted" {
    let string header ← «{"weight":{"dtype":"F32","shape":[1],"data_offsets":[0,4]}}»
    let list<u8> corpus ← contain_raw(header, data_pattern(4))
    assert admitted(corpus, ALT_DIGEST)
}

test "unused bytes between tensor regions are admitted" {
    let string header ← «{"a":{"dtype":"F32","shape":[1],"data_offsets":[2,6]}}»
    assert admitted(contain_raw(header, data_pattern(6)), ALT_DIGEST)
}

test "the capsule identity round-trips independently of fixture paths" {
    do {
        let capsule.Capsule c ← safetensors.admit(fixture(), FIXTURE_DIGEST)
        assert roundtrip(c)
        let artifact.ContentIdentity id ← c.identity
        assert id.digest ≡ FIXTURE_DIGEST
        assert id.length ≡ fixture().length()
    }
    catch err {
        assert false
    }
}

test "a malformed digest claim fails closed" {
    assert error(fixture(), "zz") ≡ "malformed digest value"
}

test "a truncated prefix fails closed" {
    assert admitted(truncated(4), FIXTURE_DIGEST) ≡ false
}

test "a truncated header or data region fails closed" {
    assert admitted(truncated(500), FIXTURE_DIGEST) ≡ false
    assert admitted(truncated(1000), FIXTURE_DIGEST) ≡ false
}

test "a non-JSON header fails closed" {
    assert admitted(contain_raw("garbage", data_pattern(1)), ALT_DIGEST) ≡ false
}

test "a non-object header fails closed" {
    assert admitted(contain_raw("[1,2,3]", data_pattern(1)), ALT_DIGEST) ≡ false
}

test "a future dtype is preserved when its range is bounded" {
    let string header ← «{"future.weight":{"dtype":"F99_E99","shape":[1],"data_offsets":[0,4]}}»
    do {
        let capsule.Capsule c ← safetensors.admit(contain_raw(header, data_pattern(4)), ALT_DIGEST)
        let capsule.SafetensorsManifest m ← c.safetensors_manifest() coalesce capsule.SafetensorsManifest {format = "", version = "", artifact_length = 0, data_length = 0, metadata = [], tensors = []}
        let capsule.SafetensorsTensorDescriptor d ← descriptor(m)
        assert d.name ≡ "future.weight"
        assert d.dtype ≡ "F99_E99"
        assert d.elements ≡ 1
        assert d.start ≡ 0
        assert d.end ≡ 4
    }
    catch err {
        assert false
    }
}

test "shape and byte offsets must agree" {
    let string header ← «{"weight":{"dtype":"F32","shape":[2],"data_offsets":[0,4]}}»
    assert admitted(contain_raw(header, data_pattern(4)), ALT_DIGEST) ≡ false
}

test "shape products above one billion are not capped by a model policy" {
    let string header ← «{"weight":{"dtype":"F32","shape":[1000001,1000],"data_offsets":[0,4]}}»
    assert error(contain_raw(header, data_pattern(4)), ALT_DIGEST) ≡ "shape/offset inconsistency for weight"
}

test "shape products reject only integer overflow" {
    let string header ← «{"weight":{"dtype":"F32","shape":[999999999999999999,10],"data_offsets":[0,4]}}»
    assert error(contain_raw(header, data_pattern(4)), ALT_DIGEST) ≡ "checked integer multiplication overflow"
}

test "duplicate names fail closed" {
    let string header ← «{"weight":{"dtype":"F32","shape":[1],"data_offsets":[0,4]},"weight":{"dtype":"F32","shape":[1],"data_offsets":[4,8]}}»
    assert admitted(contain_raw(header, data_pattern(8)), ALT_DIGEST) ≡ false
}

test "overlapping tensor regions fail closed" {
    let string header ← «{"a":{"dtype":"F32","shape":[1],"data_offsets":[0,4]},"b":{"dtype":"F32","shape":[1],"data_offsets":[2,6]}}»
    assert admitted(contain_raw(header, data_pattern(6)), ALT_DIGEST) ≡ false
}

test "metadata values must remain strings" {
    let string header ← «{"__metadata__":{"format":"safetensors","count":1},"weight":{"dtype":"F32","shape":[1],"data_offsets":[0,4]}}»
    assert admitted(contain_raw(header, data_pattern(4)), ALT_DIGEST) ≡ false
}

fn selected_payload() → list<b8> {
    let list<b8> payload ↤ data_pattern(8)
    return payload
}

test "selected admission accepts caller-supplied generic tensor facts" {
    do {
        let safetensors.SelectedTensor v ← safetensors.admit_selected(
            "renamed.weight",
            "BF16",
            [2,2],
            selected_payload(),
            ALT_DIGEST,
            24,
            16,
            0,
            8
        )
        assert v.name ≡ "renamed.weight"
        assert v.raw_dtype ≡ "BF16"
        assert v.dtype_tag not is none
        let dtype.DType dt ← v.dtype_tag coalesce dtype.f32()
        assert dtype.name(dt) ≡ "bf16"
        assert v.shape.get(0) coalesce (-1) ≡ 2
        assert v.shape.get(1) coalesce (-1) ≡ 2
        assert v.absolute_start ≡ 16
        assert v.byte_length() ≡ 8
    }
    catch err {
        assert false
    }
}

test "selected admission rejects inconsistent caller facts" {
    do {
        let safetensors.SelectedTensor ? ← safetensors.admit_selected(
            "renamed.weight",
            "BF16",
            [2,2],
            selected_payload(),
            ALT_DIGEST,
            24,
            16,
            0,
            4
        )
        assert false
    }
    catch err {
        assert true
    }
}

test "selected admission rejects a future dtype at materialization" {
    do {
        let safetensors.SelectedTensor ? ← safetensors.admit_selected(
            "future.weight",
            "F99_E99",
            [1],
            selected_payload(),
            ALT_DIGEST,
            24,
            16,
            0,
            8
        )
        assert false
    }
    catch err {
        assert true
    }
}

fn header_slice_only(string header_json) → list<u8> {
    let list<u8> hdr ← text_bytes(header_json)
    return join(header8(hdr.length()), hdr)
}

const string MULTI_DTYPE_JSON = «{"w.f32":{"dtype":"F32","shape":[2],"data_offsets":[0,8]},"w.f16":{"dtype":"F16","shape":[2],"data_offsets":[8,12]},"w.bf16":{"dtype":"BF16","shape":[2],"data_offsets":[12,16]},"w.u32":{"dtype":"U32","shape":[2],"data_offsets":[16,24]},"w.u8":{"dtype":"U8","shape":[2],"data_offsets":[24,26]},"w.i32":{"dtype":"I32","shape":[2],"data_offsets":[26,34]},"w.i8":{"dtype":"I8","shape":[2],"data_offsets":[34,36]},"w.fp8":{"dtype":"F8_E4M3","shape":[2],"data_offsets":[36,38]}}»

fn range_source_multi(int offset, int len) → list<b8> ⇥ safetensors.SafetensorError {
    let list<u8> hdr ← header_slice_only(MULTI_DTYPE_JSON)
    if offset ≺ 0 or offset + len ≻ hdr.length() {
        throw variant safetensors.SafetensorError.BadOffset { message = "test range source only buffers header bytes" }
    }
    mut list<u8> out ← empty
    for exclusive len let i {
        out.append(hdr.get(offset + i) coalesce 0 ∷ u8)
    }
    let list<b8> wire ↤ out
    return wire
}

test "range-based inspect admits a 4GB multi-dtype artifact using only header bytes" {
    let int big_len ← 4000000000
    let artifact.ContentIdentity id ← artifact.ContentIdentity { algorithm = "sha-256", digest = ALT_DIGEST, length = big_len }
    do {
        let capsule.Capsule c ← safetensors.inspect(range_source_multi, big_len, id)
        assert c.length() ≡ big_len
        assert c.tensor_count() ≡ 8
        let capsule.SafetensorsManifest m ← c.safetensors_manifest() coalesce capsule.SafetensorsManifest { format = "", version = "", artifact_length = 0, data_length = 0, metadata = [], tensors = [] }
        assert m.tensors[3].dtype ≡ "U32"
        assert m.tensors[4].dtype ≡ "U8"
        assert m.tensors[7].dtype ≡ "F8_E4M3"
    }
    catch err {
        assert false
    }
}

test "admit_header admits header-only slice with declared artifact_length" {
    let list<u8> hdr ← header_slice_only(MULTI_DTYPE_JSON)
    let int total_len ← hdr.length() + 38
    let artifact.ContentIdentity id ← artifact.ContentIdentity { algorithm = "sha-256", digest = ALT_DIGEST, length = total_len }
    do {
        let capsule.Capsule c ← safetensors.admit_header(hdr, total_len, id)
        assert c.tensor_count() ≡ 8
    }
    catch err {
        assert false
    }
}

# Declared header length N from the fixture's little-endian prefix.
fn prefix_len(list<u8> corpus) → int {
    return (corpus[0 ‥ 8] ↦ u64 via le) ↦ int ⊥ 0
}

test "admit_header on the fixture prefix agrees with whole-corpus admission" {
    let list<u8> corpus ← fixture()
    let int n ← prefix_len(corpus)
    let list<u8> prefix ← corpus.take(8 + n) ⊥ []
    do {
        let artifact.ContentIdentity id ← artifact.ContentIdentity { algorithm = "sha-256", digest = FIXTURE_DIGEST, length = corpus.length() }
        let capsule.Capsule c ← safetensors.admit_header(prefix, corpus.length(), id)
        assert c.tensor_count() ≡ 5
        assert c.length() ≡ corpus.length()
        assert c.digest() ≡ FIXTURE_DIGEST
    }
    catch err {
        assert false
    }
}

# Header-byte lexer pins (every header built from literal pieces so each
# JSON escape byte is explicit): the solidus and quote escapes decode in
# place, \n and \t decode to their control characters, and \uXXXX survives
# verbatim in the token value.
fn escaped_admit_name(string header) → string {
    do {
        let capsule.Capsule c ← safetensors.admit(contain_raw(header, data_pattern(4)), ALT_DIGEST)
        let capsule.SafetensorsManifest m ← c.safetensors_manifest() coalesce capsule.SafetensorsManifest {format = "", version = "", artifact_length = 0, data_length = 0, metadata = [], tensors = []}
        let capsule.SafetensorsTensorDescriptor d ← descriptor(m)
        return d.name
    }
    catch err {
        return "ERR:§"(err.message)
    }
}

test "escaped names keep their exact token values" {
    assert escaped_admit_name(«{"e» + "\\" + «/s":{"dtype":"F32","shape":[1],"data_offsets":[0,4]}}») ≡ «e/s»
    assert escaped_admit_name(«{"q» + "\\" + «"» + «t":{"dtype":"F32","shape":[1],"data_offsets":[0,4]}}») ≡ «q"t»
    assert escaped_admit_name(«{"a» + "\\n" + «b":{"dtype":"F32","shape":[1],"data_offsets":[0,4]}}») ≡ "a\nb"
    assert escaped_admit_name(«{"a» + "\\t" + «b":{"dtype":"F32","shape":[1],"data_offsets":[0,4]}}») ≡ "a\tb"
    assert escaped_admit_name(«{"u» + "\\u0041" + «x":{"dtype":"F32","shape":[1],"data_offsets":[0,4]}}») ≡ "u" + "\\u0041" + "x"
}

test "dtype_byte_width covers all 8 raw dtypes and rejects unknown dtypes" {
    do {
        assert safetensors.dtype_byte_width("F32") ≡ 4
        assert safetensors.dtype_byte_width("F16") ≡ 2
        assert safetensors.dtype_byte_width("BF16") ≡ 2
        assert safetensors.dtype_byte_width("U32") ≡ 4
        assert safetensors.dtype_byte_width("U8") ≡ 1
        assert safetensors.dtype_byte_width("I32") ≡ 4
        assert safetensors.dtype_byte_width("I8") ≡ 1
        assert safetensors.dtype_byte_width("F8_E4M3") ≡ 1
    }
    catch err {
        assert false
    }
    do {
        safetensors.dtype_byte_width("Q9_X")
        assert false
    }
    catch err {
        assert err.message ≡ "unsupported Safetensors dtype: Q9_X"
    }
}

test "uppercase hex \\uXXXX escapes and 0-D scalar tensors are admitted" {
    assert escaped_admit_name(«{"u» + "\\u004F" + "\\uABCD" + «_x":{"dtype":"F32","shape":[1],"data_offsets":[0,4]}}») ≡ "u" + "\\u004F" + "\\uABCD_x"

    let string scalar_header ← «{"model.layers.0.self_attn.q_proj.global_scale":{"dtype":"F32","shape":[],"data_offsets":[0,4]},"model.layers.0.self_attn.q_proj._amax":{"dtype":"F32","shape":[],"data_offsets":[4,8]},"model.layers.0.self_attn.q_proj._outer_scale_denominator":{"dtype":"F32","shape":[],"data_offsets":[8,12]}}»
    assert admitted(contain_raw(scalar_header, data_pattern(12)), ALT_DIGEST) ≡ true
}

test "admit_selected supports U32, F8_E4M3, I8, and 0-D scalars without compute-dtype aliasing" {
    let list<b8> bytes16 ↤ data_pattern(16)
    let list<b8> bytes8 ↤ data_pattern(8)
    let list<b8> bytes4 ↤ data_pattern(4)
    let list<b8> bytes1 ↤ data_pattern(1)

    do {
        let safetensors.SelectedTensor u32_t ← safetensors.admit_selected("model.layers.0.self_attn.q_proj.weight", "U32", [2, 2], bytes16, ALT_DIGEST, 32, 16, 0, 16)
        assert u32_t.raw_dtype ≡ "U32"
        assert u32_t.dtype_tag is none
        assert u32_t.byte_length() ≡ 16

        let safetensors.SelectedTensor fp8_t ← safetensors.admit_selected("model.layers.0.linear_attn.in_proj_qkv.weight", "F8_E4M3", [2, 4], bytes8, ALT_DIGEST, 32, 16, 0, 8)
        assert fp8_t.raw_dtype ≡ "F8_E4M3"
        assert fp8_t.dtype_tag is none
        assert fp8_t.byte_length() ≡ 8

        let safetensors.SelectedTensor i8_t ← safetensors.admit_selected("model.layers.0.mlp.gate_proj.weight", "I8", [4], bytes4, ALT_DIGEST, 32, 16, 0, 4)
        assert i8_t.raw_dtype ≡ "I8"
        assert i8_t.dtype_tag is none
        assert i8_t.byte_length() ≡ 4

        let safetensors.SelectedTensor scalar_f32 ← safetensors.admit_selected("model.layers.0.self_attn.q_proj._amax", "F32", [], bytes4, ALT_DIGEST, 32, 16, 0, 4)
        assert scalar_f32.raw_dtype ≡ "F32"
        assert scalar_f32.dtype_tag not is none
        let dtype.DType scalar_dt ← scalar_f32.dtype_tag coalesce dtype.u8()
        assert dtype.name(scalar_dt) ≡ "f32"
        assert scalar_f32.shape.length() ≡ 0

        let safetensors.SelectedTensor scalar_fp8 ← safetensors.admit_selected("model.layers.0.self_attn.q_proj.scales", "F8_E4M3", [], bytes1, ALT_DIGEST, 32, 16, 0, 1)
        assert scalar_fp8.raw_dtype ≡ "F8_E4M3"
        assert scalar_fp8.dtype_tag is none
        assert scalar_fp8.byte_length() ≡ 1
    }
    catch err {
        assert false
    }

    do {
        let safetensors.SelectedTensor ? ← safetensors.admit_selected("bad_u32.weight", "U32", [2, 2], bytes8, ALT_DIGEST, 32, 16, 0, 8)
        assert false
    }
    catch err {
        assert err.message ≡ "selected tensor range does not match its shape"
    }
}
