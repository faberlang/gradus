+++
locale = "en"
+++
# Safetensors row admission — one pinned Safetensors row parses into the
# admitted-model capsule, fail-closed (PML2-U2, Lane 1).
#
# Public import: import from "gradus:model/safetensors" safetensors
# Depends on: gradus:model/capsule (the PML2-U1 admitted-model capsule,
# capsule-schema-2.0.0) and gradus:model/artifact (pathless content
# identity). This module is the U2 seam: raw Safetensors bytes in ->
# capsule.Capsule out. Raw bytes and paths are NEVER trust anchors
# (capsule contract, council C8) — only the capsule carries identity.

import from "gradus:model/artifact" artifact

import from "gradus:model/capsule" capsule

import from "gradus:dtype" dtype
#
# --- Contract ------------------------------------------------------------
#
# The legacy `admit` entry admits the pinned scaled synthetic row of
# fixtures/safetensors/safetensors-row-oracle.md (smollm2-360m-scaled-row),
# a structural stand-in for the SmolLM2-360M-Instruct row of
# gi0-model-contract 1.0.0. Its row facts (arch llama/dense, gpt2/smollm
# tokenizer identity, F32 tensor table, ceilings) are pinned below as
# constants. GEA1's `admit_selected` entry is a separate bounded handoff for
# the one official BF16 V-projection range recorded below; it receives only
# that selected payload after the source adapter has parsed the header.
# ANY deviation fails closed with a typed SafetensorError before
# any allocation sized by an attacker-controlled count. The capsule
# certifies exactly the row this module admitted; the digest VALUE is
# host-computed and passed in (the language surface has no digest
# primitive — capsule.fab header, GI1 boundary), its form is validated
# here and its correctness re-verifiable via capsule.verify_against.
#
# Container facts (Safetensors reference format, README "Format":
# https://github.com/huggingface/safetensors/blob/main/README.md#format):
# the 8-byte little-endian u64 N is the JSON header length only, excluding
# the prefix; the JSON header occupies [8, 8 + N), and the data region
# starts at 8 + N (8-aligned). Tensor data_offsets are relative to the data
# region. The pinned row's data region tiles exactly: intervals are
# non-overlapping and their total length equals the data-region length, so no
# gap/overlap/misalignment can be admitted.
#
# Typed error vocabulary (SafetensorError, variant -> class):
#   BadFormat        — container/JSON format violations (truncation,
#                      non-JSON, non-object header, format-name mismatch,
#                      malformed members/separators).
#   UnknownVersion   — unsupported pinned row version.
#   BadArchitecture  — architecture facts mismatch (or tensor outside the
#                      admitted row / tensor-table mismatch).
#   UnknownDtype     — unsupported tensor dtype.
#   BadOffset        — data-offset violations (bounds, 8-byte misalignment,
#                      duplicate tensor name, overlapping regions, gapped /
#                      non-tiling data region).
#   BadShape         — shape violations (non-positive dim, shape mismatch,
#                      shape/offset byte-length inconsistency).
#   BadTokenizer     — tokenizer identity mismatch (kind / pre-tokenizer /
#                      EOG set / BOS-free / space-prefix-free facts).
#   BadBounds        — ceilings: header size, token count, metadata KV
#                      count, tensor count, name length, dimension size,
#                      total elements.
#   BadDigest        — malformed digest claim (row digest or vocab digest).
#   BadMetadata      — metadata structure violations (missing __metadata__,
#                      missing required key, non-string metadata value).
#   BadAdmission     — the capsule constructor rejected the validated row
#                      (defense-in-depth; should not fire on admitted rows).
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * Cross-module enum variants are unsupported (SEM002/SEM041), so this
#     module defines its OWN typed error vocabulary (above) mirroring the
#     capsule's AdmissionError classes, and renders capsule errors via
#     capsule.message on conversion.
#   * The language has no codepoint/ord intrinsic: a \uXXXX escape is
#     form-validated (4 hex digits) but preserved VERBATIM in the token
#     value. Every pinned row constant is pure ASCII, so any escape in an
#     admitted-relevant field changes the compared value and fails closed;
#     ignored fields carry the verbatim token (documented, fail-closed).
#   * Proba proof is compile-level (`faber check src/model/safetensors.proba`):
#     execution (`faber test`) is blocked tree-wide by the missing locale
#     pack (radix/stdlib/reader/la/pack.toml) and the recorded FMIR
#     stepper limitation (see capsule.proba header). The proba reconstructs
#     the pinned fixture bytes from the same JSON + data pattern as the
#     committed generator, so the oracle hash binds both.
#
# --- Seams ---------------------------------------------------------------
#   * GGUF row admission (parallel U3, hand-4) — disjoint format file.
#   * tokenizer probe parity (P1–P11, vocab digest execution) — PML2-U4.
#   * norma:model + GI1 admission migration (no dual authority) — PML2-U5.
#   * digest computation — the admission host (pure-Rust, GI1).
#   * forward architectures / new rows — PML3 (R3: the pinned constants
#     below are the one place a second row extends).

# -------------------------------------------------------------------------
# Pinned row constants (R3: extend here for a second row). Mirror values of
# the capsule contract where the capsule checks form (schema, digest
# algorithm, quantization row, ceilings).
# -------------------------------------------------------------------------

# Capsule contract mirrors (capsule-schema-2.0.0 / sha-256). Schema 2
# carries no quantization row (D4): the F32 row facts stay as structural
# checks here, and the identity algorithm mirrors the capsule.
const string DIGEST_SHA256 ← "sha-256"

const int F32_BYTES ← 4

# Pinned row facts (oracle doc; gi0-model-contract 1.0.0 sources).
const string ROW_FORMAT_NAME ← "safetensors"

const string ROW_FORMAT_VERSION ← "1.0.0"

const string ARCH_IDENTIFIER ← "llama"

const string ARCH_DENSITY ← "dense"

const int ARCH_LAYERS ← 1

const string ARCH_CONTEXT ← "2048"

const string TOKENIZER_MERGE_KIND ← "gpt2"

const string TOKENIZER_PRE ← "smollm"

const string TOKENIZER_EOG ← "0,2"

const string TOKENIZER_BOS ← "true"

const string TOKENIZER_SPACE ← "true"

const string DTYPE_F32 ← "F32"

# GEA1 selected source row. The header is inspected by the owning source
# adapter; this bounded seam receives only the declared tensor range, never a
# path, whole-file corpus, or container object.
const string GEA1_TENSOR_NAME ← "model.layers.0.self_attn.v_proj.weight"
const string GEA1_DIGEST ← "e6bffe7435d7ddc10fd3b9a9efd429dafbacb1cb17015fb5562664e7532bf86e"
const int GEA1_ARTIFACT_LENGTH ← 723674912
const int GEA1_DATA_START ← 32672
const int GEA1_RELATIVE_START ← 113422080
const int GEA1_RELATIVE_END ← 114036480
const int GEA1_ABSOLUTE_START ← 113454752
const int GEA1_BYTES ← 614400

# Metadata keys the pinned row must carry in __metadata__.
const string K_FORMAT_NAME ← "format.name"

const string K_FORMAT_VERSION ← "format.version"

const string K_ARCH ← "model.arch"

const string K_DENSITY ← "model.density"

const string K_LAYERS ← "model.layers"

const string K_CONTEXT ← "model.context"

const string K_MERGE_KIND ← "tokenizer.model"

const string K_PRE ← "tokenizer.pre"

const string K_VOCAB ← "tokenizer.vocab_digest"

const string K_EOG ← "tokenizer.eog"

const string K_BOS ← "tokenizer.bos_free"

const string K_SPACE ← "tokenizer.space_prefix_free"

# Row ceilings (validated BEFORE any count-driven work). Safetensors
# alignment is 8 bytes.
const int ALIGNMENT ← 8

const int HEADER_LIMIT ← 1048576

const int TOKEN_LIMIT ← 4096

const int KV_LIMIT ← 64

const int TENSOR_LIMIT ← 16

const int NAME_LIMIT ← 128

const int DIMENSION_LIMIT ← 65536

const int ELEMENT_LIMIT ← 1000000000

const int ARRAY_LIMIT ← 16

# The admitted tensor table (name + expected shape). The proba and the
# committed fixture generator must agree byte-for-byte on the row.
const list<string> EXPECTED_NAMES ← ["model.embed_tokens.weight", "model.norm.weight", "model.layers.0.self_attn.q_proj.weight", "model.layers.0.self_attn.v_proj.weight", "model.layers.0.mlp.down_proj.weight"]

const list<list<int>> EXPECTED_SHAPES ← [[8, 4], [8], [8, 8], [8, 4], [4, 8]]

# -------------------------------------------------------------------------
# SafetensorError — typed error vocabulary (variant -> class above). The
# module's public surface (SafetensorError, message, admit) is marked
# @ public so the proba and the conformance suite can import it under the
# post-visibility-flip compiler (frozen entry behavior).
# -------------------------------------------------------------------------


@ public { }
union SafetensorError {
    BadFormat {
        string message
    },
    UnknownVersion {
        string message
    },
    BadArchitecture {
        string message
    },
    UnknownDtype {
        string message
    },
    BadOffset {
        string message
    },
    BadShape {
        string message
    },
    BadTokenizer {
        string message
    },
    BadBounds {
        string message
    },
    BadDigest {
        string message
    },
    BadMetadata {
        string message
    },
    BadAdmission {
        string message
    }
}

@ public { }
fn message(SafetensorError e) → string {
    match e {
        case BadFormat const message {
            return message
        }
        case UnknownVersion const message {
            return message
        }
        case BadArchitecture const message {
            return message
        }
        case UnknownDtype const message {
            return message
        }
        case BadOffset const message {
            return message
        }
        case BadShape const message {
            return message
        }
        case BadTokenizer const message {
            return message
        }
        case BadBounds const message {
            return message
        }
        case BadDigest const message {
            return message
        }
        case BadMetadata const message {
            return message
        }
        case BadAdmission const message {
            return message
        }
    }
}

# GEA1's pathless, bounded handoff from the selected Safetensors descriptor.
# The source adapter owns header parsing and range reads. This value carries
# only the already-declared tensor bytes and range facts needed by a consumer.
@ public { }
class SelectedTensor {
    string name
    dtype.DType dtype_tag
    list<int> shape
    string artifact_digest
    int artifact_length
    int data_start
    int relative_start
    int relative_end
    int absolute_start
    bytes payload

    fn name() → string {
        return self.name
    }

    fn dtype() → dtype.DType {
        return self.dtype_tag
    }

    fn shape() → list<int> {
        return self.shape
    }

    fn digest() → string {
        return self.artifact_digest
    }

    fn artifact_length() → int {
        return self.artifact_length
    }

    fn data_start() → int {
        return self.data_start
    }

    fn relative_start() → int {
        return self.relative_start
    }

    fn relative_end() → int {
        return self.relative_end
    }

    fn absolute_start() → int {
        return self.absolute_start
    }

    fn byte_length() → int {
        return self.payload.length()
    }

    fn payload() → bytes {
        return self.payload
    }
}

# -------------------------------------------------------------------------
# Same-module carriers (the walkers build these; all fields are module-
# internal). Public surface stays on primitives + capsule.Capsule so the
# proba file-interface keeps every export (WARN014 seam, same as
# parameter/serialize/capsule).
# -------------------------------------------------------------------------

# A JSON token: kind 0..10 = { } [ ] : , string number true false null.
class Token {
    int kind
    string payload
}

# Extracted row structure after the header walk.
class Structure {
    list<string> meta_keys
    list<string> meta_values
    list<string> names
    list<string> dtypes
    list<list<int>> shapes
    list<int> starts
    list<int> end
}

# String-lexer result: new index + decoded value.
class StringValue {
    int pos
    string payload
}

# Metadata-object parse result.
class MetadataCursor {
    int pos
    list<string> keys
    list<string> values
}

# Tensor-descriptor parse result.
class TensorCursor {
    int pos
    string dtype
    list<int> shape
    int start
    int end
}

# Number-array parse result.
class NumberCursor {
    int pos
    list<int> values
}

# Container-header parse result (header is the JSON-only length N).
class HeaderCursor {
    int header
    string text
}

# -------------------------------------------------------------------------
# Character / value predicates (self-contained copies per leaf-module
# convention — the capsule's _is_hex/_hex_ok are module-private).
# -------------------------------------------------------------------------

@ private { }
fn _is_digit(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _is_hex(string c) → bool {
    if _is_digit(c) then return true
    if ((((c ≡ "a" or c ≡ "b") or c ≡ "c") or c ≡ "d") or c ≡ "e") or c ≡ "f" then return true
    return false
}

@ private { }
fn _is_optional(string c) → bool {
    return ((c ≡ " " or c ≡ "\t") or c ≡ "\n") or c ≡ "\r"
}

# Whole-digest predicate: exactly 64 lowercase hex characters.
@ private { }
fn _hex_ok(string s) → bool {
    if s.length() ≠ 64 then return false
    for range 0‥s.length() const i {
        if not _is_hex(s.slice(i, i + 1)) then return false
    }
    return true
}

# -------------------------------------------------------------------------
# Byte-level helpers (Safetensors container).
# -------------------------------------------------------------------------

# Little-endian u64 from the first 8 bytes of a list. Package MIR rejects the
# language octeti-window form `bytes[lo‥hi] ↦ int<u64, Le>` (`octeti index is
# not numerus` plus `conversion source type mismatch`); this mirrors
# gguf_manifest._u64, which already executes on the runner.
@ private { }
fn _u64_le(list<int<u8>> b) → int ⇥ SafetensorError {
    require b.length() ≥ 8 throw variant BadFormat {message = "truncated safetensors header prefix"}
    const int r7 ← b.get(7) coalesce 0 ∷ int<u8> ↦ int
    require r7 ≺ 128 throw variant BadBounds {message = "header size above the numeric carrier"}
    const int r0 ← b.get(0) coalesce 0 ∷ int<u8> ↦ int
    const int r1 ← b.get(1) coalesce 0 ∷ int<u8> ↦ int
    const int r2 ← b.get(2) coalesce 0 ∷ int<u8> ↦ int
    const int r3 ← b.get(3) coalesce 0 ∷ int<u8> ↦ int
    const int r4 ← b.get(4) coalesce 0 ∷ int<u8> ↦ int
    const int r5 ← b.get(5) coalesce 0 ∷ int<u8> ↦ int
    const int r6 ← b.get(6) coalesce 0 ∷ int<u8> ↦ int
    return ((((((r0 ∨ r1 ⇐ 8) ∨ r2 ⇐ 16) ∨ r3 ⇐ 24) ∨ r4 ⇐ 32) ∨ r5 ⇐ 40) ∨ r6 ⇐ 48) ∨ r7 ⇐ 56
}

# Container-header validation: the 8-byte LE N is the JSON-only header
# length, followed by bounds, 8-byte alignment, and UTF-8 header extraction.
# Ceilings are checked BEFORE the header slice is materialized.
@ private { }
fn _header(list<int<u8>> corpus) → HeaderCursor ⇥ SafetensorError {
    const int header ← _u64_le(corpus)
    require header ≥ 1 throw variant BadFormat {message = "invalid safetensors header size"}
    require header ≤ HEADER_LIMIT throw variant BadBounds {message = "header size above ceiling"}
    require 8 + header ≤ corpus.length() throw variant BadFormat {message = "truncated header — header size beyond file"}
    require header % ALIGNMENT ≡ 0 throw variant BadFormat {message = "misaligned safetensors header (not 8-byte aligned)"}
    var list<int<u8>> sub ← empty
    for range 8‥8 + header const i {
        sub.append(corpus.get(i) coalesce 0 ∷ int<u8>)
    }
    const bytes o ← sub
    do {
        return HeaderCursor {header = header, text = o ↦ string}
    }
    catch err {
        throw variant BadFormat {message = "header is not valid UTF-8"}
    }
}

# -------------------------------------------------------------------------
# JSON tokenizer (strict lexical validation of the header).
# -------------------------------------------------------------------------

# Parse a JSON string starting at index i (the opening quote). Handles the
# standard escapes; \uXXXX is form-validated (4 hex digits) and preserved
# verbatim (no codepoint intrinsic — compiler-boundary note above).
@ private { }
fn _read_string(string h, int i) → StringValue ⇥ SafetensorError {
    var string payload ← ""
    var int pos ← i + 1
    while pos ≺ h.length() {
        const string c ← h.slice(pos, pos + 1)
        if c ≡ «\"» then return StringValue {pos = pos + 1, payload = payload}
        if c ≡ "\\" {
            require pos + 1 ≺ h.length() throw variant BadFormat {message = "unterminated string escape"}
            const string e ← h.slice(pos + 1, pos + 2)
            if e ≡ «\"» {
                payload ← payload + «\"»
                pos ← pos + 2
            }
            elif e ≡ "\\" {
                payload ← payload + "\\"
                pos ← pos + 2
            }
            elif e ≡ "/" {
                payload ← payload + "/"
                pos ← pos + 2
            }
            elif e ≡ "n" {
                payload ← payload + "\n"
                pos ← pos + 2
            }
            elif e ≡ "r" {
                payload ← payload + "\r"
                pos ← pos + 2
            }
            elif e ≡ "t" {
                payload ← payload + "\t"
                pos ← pos + 2
            }
            elif e ≡ "b" {
                payload ← payload + "\u{08}"
                pos ← pos + 2
            }
            elif e ≡ "f" {
                payload ← payload + "\u{0C}"
                pos ← pos + 2
            }
            elif e ≡ "u" {
                require pos + 5 ≺ h.length() throw variant BadFormat {message = "truncated \\u escape"}
                const string quad ← h.slice(pos + 2, pos + 6)
                for range 0‥4 const j {
                    require _is_hex(quad.slice(j, j + 1)) throw variant BadFormat {message = "malformed \\u escape"}
                }
                payload ← "§\\u§"(payload, quad)
                pos ← pos + 6
            }
            else {
                throw variant BadFormat {message = "unknown string escape"}
            }
        }
        else {
            require not ((((c ≡ "\n" or c ≡ "\r") or c ≡ "\t") or c ≡ "\u{08}") or c ≡ "\u{0C}") throw variant BadFormat {message = "unescaped control character in string"}
            payload ← payload + c
            pos ← pos + 1
        }
    }
    throw variant BadFormat {message = "unterminated string"}
}

# Parse a JSON number starting at index i (digit or minus). Returns the
# raw number text (JSON grammar: -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?).
@ private { }
fn _read_number(string h, int i) → StringValue ⇥ SafetensorError {
    var int pos ← i
    if h.slice(pos, pos + 1) ≡ "-" {
        pos ← pos + 1
        require pos ≺ h.length() throw variant BadFormat {message = "malformed number"}
    }
    if h.slice(pos, pos + 1) ≡ "0" {
        pos ← pos + 1
        require not (pos ≺ h.length() and _is_digit(h.slice(pos, pos + 1))) throw variant BadFormat {message = "malformed number"}
    }
    elif _is_digit(h.slice(pos, pos + 1)) {
        while pos ≺ h.length() and _is_digit(h.slice(pos, pos + 1)) {
            pos ← pos + 1
        }
    }
    else {
        throw variant BadFormat {message = "malformed number"}
    }
    if pos ≺ h.length() and h.slice(pos, pos + 1) ≡ "." {
        pos ← pos + 1
        require pos ≺ h.length() throw variant BadFormat {message = "malformed number"}
        require _is_digit(h.slice(pos, pos + 1)) throw variant BadFormat {message = "malformed number"}
        while pos ≺ h.length() and _is_digit(h.slice(pos, pos + 1)) {
            pos ← pos + 1
        }
    }
    if pos ≺ h.length() and (h.slice(pos, pos + 1) ≡ "e" or h.slice(pos, pos + 1) ≡ "E") {
        pos ← pos + 1
        if pos ≺ h.length() and (h.slice(pos, pos + 1) ≡ "+" or h.slice(pos, pos + 1) ≡ "-") {
            pos ← pos + 1
        }
        require pos ≺ h.length() throw variant BadFormat {message = "malformed number"}
        require _is_digit(h.slice(pos, pos + 1)) throw variant BadFormat {message = "malformed number"}
        while pos ≺ h.length() and _is_digit(h.slice(pos, pos + 1)) {
            pos ← pos + 1
        }
    }
    return StringValue {pos = pos, payload = h.slice(i, pos)}
}

# Tokenize the whole header (strict lexical validation, bounded token
# count — checked before more tokens are appended).
@ private { }
fn _scan(string h) → list<Token> ⇥ SafetensorError {
    var list<Token> tks ← empty
    var int pos ← 0
    while pos ≺ h.length() {
        const string c ← h.slice(pos, pos + 1)
        if _is_optional(c) {
            pos ← pos + 1
        }
        elif c ≡ "{" {
            tks.append(Token {kind = 0, payload = "{"})
            pos ← pos + 1
        }
        elif c ≡ "}" {
            tks.append(Token {kind = 1, payload = "}"})
            pos ← pos + 1
        }
        elif c ≡ "[" {
            tks.append(Token {kind = 2, payload = "["})
            pos ← pos + 1
        }
        elif c ≡ "]" {
            tks.append(Token {kind = 3, payload = "]"})
            pos ← pos + 1
        }
        elif c ≡ ":" {
            tks.append(Token {kind = 4, payload = ":"})
            pos ← pos + 1
        }
        elif c ≡ "," {
            tks.append(Token {kind = 5, payload = ","})
            pos ← pos + 1
        }
        elif c ≡ «\"» {
            const StringValue s ← _read_string(h, pos)
            tks.append(Token {kind = 6, payload = s.payload})
            pos ← s.pos
        }
        elif _is_digit(c) or c ≡ "-" {
            const StringValue n ← _read_number(h, pos)
            tks.append(Token {kind = 7, payload = n.payload})
            pos ← n.pos
        }
        elif c ≡ "t" {
            if h.slice(pos, pos + 4) ≡ "true" {
                tks.append(Token {kind = 8, payload = "true"})
                pos ← pos + 4
            }
            else {
                throw variant BadFormat {message = "malformed literal"}
            }
        }
        elif c ≡ "f" {
            if h.slice(pos, pos + 5) ≡ "false" {
                tks.append(Token {kind = 9, payload = "false"})
                pos ← pos + 5
            }
            else {
                throw variant BadFormat {message = "malformed literal"}
            }
        }
        elif c ≡ "n" {
            if h.slice(pos, pos + 4) ≡ "null" {
                tks.append(Token {kind = 10, payload = "null"})
                pos ← pos + 4
            }
            else {
                throw variant BadFormat {message = "malformed literal"}
            }
        }
        else {
            throw variant BadFormat {message = "unexpected character in header"}
        }
        require tks.length() ≤ TOKEN_LIMIT throw variant BadBounds {message = "header token count above ceiling"}
    }
    return tks
}

# -------------------------------------------------------------------------
# JSON structural walk (strict grammar validation + pinned-row extraction).
# -------------------------------------------------------------------------

# Token lookup still paper-overs a missing index as kind=-1. Making these
# failable ripples through the whole header walker; conversion is outside
# this unit.
@ private { }
fn _dtype(list<Token> tks, int i) → int {
    const Token t ← tks.get(i) coalesce Token {kind = -1, payload = ""}
    return t.kind
}

@ private { }
fn _value(list<Token> tks, int i) → string {
    const Token t ← tks.get(i) coalesce Token {kind = -1, payload = ""}
    return t.payload
}

# Integer-valued JSON number -> number (digits only, length-capped). A
# fractional/exponent number is not a valid shape dim or offset.
@ private { }
fn _parse_integer(string raw) → int ⇥ SafetensorError {
    require raw.length() ≠ 0 throw variant BadFormat {message = "malformed integer"}
    require raw.length() ≤ 18 throw variant BadFormat {message = "integer above the numeric carrier"}
    for range 0‥raw.length() const i {
        require _is_digit(raw.slice(i, i + 1)) throw variant BadFormat {message = "non-integer value"}
    }
    do {
        const int v ↤ raw
        return v
    }
    catch err {
        throw variant BadFormat {message = "malformed integer"}
    }
}

# Parse a JSON array of integers starting at pos (token kind 2). Bounded
# array length (shape rank / offsets / any numeric array).
@ private { }
fn _parse_numbers(list<Token> tks, int pos) → NumberCursor ⇥ SafetensorError {
    require _dtype(tks, pos) ≡ 2 throw variant BadFormat {message = "expected an integer array"}
    var int p ← pos + 1
    var list<int> values ← empty
    while p ≺ tks.length() {
        if _dtype(tks, p) ≡ 3 {
            p ← p + 1
            return NumberCursor {pos = p, values = values}
        }
        require _dtype(tks, p) ≡ 7 throw variant BadFormat {message = "array must contain only integers"}
        values.append(_parse_integer(_value(tks, p)))
        p ← p + 1
        require values.length() ≤ ARRAY_LIMIT throw variant BadBounds {message = "array above length ceiling"}
        require p ≺ tks.length() throw variant BadFormat {message = "unterminated array"}
        if _dtype(tks, p) ≡ 5 {
            p ← p + 1
            require p ≺ tks.length() throw variant BadFormat {message = "trailing comma in array"}
            require _dtype(tks, p) ≠ 3 throw variant BadFormat {message = "trailing comma in array"}
        }
        elif _dtype(tks, p) ≠ 3 {
            throw variant BadFormat {message = "malformed array separator"}
        }
    }
    throw variant BadFormat {message = "unterminated array"}
}

# Parse the __metadata__ object: a flat string->string table. KV count is
# bounded while collecting (ceiling before the walk grows further).
@ private { }
fn _parse_metadata(list<Token> tks, int pos) → MetadataCursor ⇥ SafetensorError {
    require _dtype(tks, pos) ≡ 0 throw variant BadMetadata {message = "metadata must be a JSON object"}
    var int p ← pos + 1
    var list<string> keys ← empty
    var list<string> values ← empty
    while p ≺ tks.length() {
        if _dtype(tks, p) ≡ 1 {
            p ← p + 1
            return MetadataCursor {pos = p, keys = keys, values = values}
        }
        require _dtype(tks, p) ≡ 6 throw variant BadMetadata {message = "malformed metadata member"}
        const string key ← _value(tks, p)
        p ← p + 1
        require _dtype(tks, p) ≡ 4 throw variant BadMetadata {message = "missing colon in metadata"}
        p ← p + 1
        require _dtype(tks, p) ≡ 6 throw variant BadMetadata {message = "metadata value must be a string"}
        const string payload ← _value(tks, p)
        p ← p + 1
        keys.append(key)
        values.append(payload)
        require keys.length() ≤ KV_LIMIT throw variant BadBounds {message = "metadata KV count above ceiling"}
        require p ≺ tks.length() throw variant BadMetadata {message = "unterminated metadata object"}
        if _dtype(tks, p) ≡ 5 {
            p ← p + 1
            require p ≺ tks.length() throw variant BadMetadata {message = "trailing comma in metadata"}
            require _dtype(tks, p) ≠ 1 throw variant BadMetadata {message = "trailing comma in metadata"}
        }
        elif _dtype(tks, p) ≠ 1 {
            throw variant BadMetadata {message = "malformed metadata separator"}
        }
    }
    throw variant BadMetadata {message = "unterminated metadata object"}
}

# Parse one tensor descriptor: {"dtype": "...", "shape": [...],
# "data_offsets": [begin, end]}. Unknown members, duplicates, and missing
# members fail closed.
@ private { }
fn _parse_tensor(list<Token> tks, int pos, string name) → TensorCursor ⇥ SafetensorError {
    require _dtype(tks, pos) ≡ 0 throw variant BadFormat {message = "tensor descriptor must be an object: §"(name)}
    var int p ← pos + 1
    var bool seen_dtype ← false
    var bool seen_shape ← false
    var bool seen_offset ← false
    var string kind ← ""
    var list<int> shape ← empty
    var int start ← 0
    var int end ← 0
    while p ≺ tks.length() {
        if _dtype(tks, p) ≡ 1 {
            p ← p + 1
            require seen_dtype throw variant BadFormat {message = "missing dtype in tensor descriptor: §"(name)}
            require seen_shape throw variant BadFormat {message = "missing shape in tensor descriptor: §"(name)}
            require seen_offset throw variant BadFormat {message = "missing data_offsets in tensor descriptor: §"(name)}
            return TensorCursor {pos = p, dtype = kind, shape = shape, start = start, end = end}
        }
        require _dtype(tks, p) ≡ 6 throw variant BadFormat {message = "malformed tensor descriptor member"}
        const string key ← _value(tks, p)
        p ← p + 1
        require _dtype(tks, p) ≡ 4 throw variant BadFormat {message = "missing colon in tensor descriptor"}
        p ← p + 1
        if key ≡ "dtype" {
            require not seen_dtype throw variant BadFormat {message = "duplicate dtype in tensor descriptor"}
            require _dtype(tks, p) ≡ 6 throw variant BadFormat {message = "dtype must be a string"}
            kind ← _value(tks, p)
            p ← p + 1
            seen_dtype ← true
        }
        elif key ≡ "shape" {
            require not seen_shape throw variant BadFormat {message = "duplicate shape in tensor descriptor"}
            const NumberCursor nc ← _parse_numbers(tks, p)
            p ← nc.pos
            shape ← nc.values
            seen_shape ← true
        }
        elif key ≡ "data_offsets" {
            require not seen_offset throw variant BadFormat {message = "duplicate data_offsets in tensor descriptor"}
            const NumberCursor oc ← _parse_numbers(tks, p)
            p ← oc.pos
            require oc.values.length() ≡ 2 throw variant BadOffset {message = "data_offsets must have exactly 2 values: §"(name)}
            start ← _int_at(oc.values, 0)
            end ← _int_at(oc.values, 1)
            seen_offset ← true
        }
        else {
            throw variant BadFormat {message = "unknown member in tensor descriptor: §"(key)}
        }
        require p ≺ tks.length() throw variant BadFormat {message = "unterminated tensor descriptor"}
        if _dtype(tks, p) ≡ 5 {
            p ← p + 1
            require p ≺ tks.length() throw variant BadFormat {message = "trailing comma in tensor descriptor"}
            require _dtype(tks, p) ≠ 1 throw variant BadFormat {message = "trailing comma in tensor descriptor"}
        }
        elif _dtype(tks, p) ≠ 1 {
            throw variant BadFormat {message = "malformed tensor descriptor separator"}
        }
    }
    throw variant BadFormat {message = "unterminated tensor descriptor"}
}

# Walk the token stream: top-level must be a single JSON object whose
# members are __metadata__ (exactly once) plus tensor entries. Every value
# sits in a pinned context, so the whole header is strictly validated and
# the pinned fields are extracted. The top-level object must close exactly
# at the end of the token stream — any trailing token after the closing
# brace fails closed (no partial-header admission). Count ceilings are
# enforced WHILE collecting (before any count-driven work downstream).
@ private { }
fn _walk(list<Token> tks) → Structure ⇥ SafetensorError {
    require tks.length() ≠ 0 throw variant BadFormat {message = "empty header"}
    require _dtype(tks, 0) ≡ 0 throw variant BadFormat {message = "header is not a JSON object"}
    var int pos ← 1
    var bool seen_meta ← false
    var list<string> meta_keys ← empty
    var list<string> meta_values ← empty
    var list<string> names ← empty
    var list<string> dtypes ← empty
    var list<list<int>> shapes ← empty
    var list<int> starts ← empty
    var list<int> end ← empty
    while pos ≺ tks.length() {
        if _dtype(tks, pos) ≡ 1 {
            pos ← pos + 1
            # Fail closed on trailing content: the top-level object must
            # close exactly at the end of the token stream.
            require pos ≡ tks.length() throw variant BadFormat {message = "trailing tokens after the header object"}
            return Structure {meta_keys = meta_keys, meta_values = meta_values, names = names, dtypes = dtypes, shapes = shapes, starts = starts, end = end}
        }
        require _dtype(tks, pos) ≡ 6 throw variant BadFormat {message = "malformed header member"}
        const string key ← _value(tks, pos)
        pos ← pos + 1
        require _dtype(tks, pos) ≡ 4 throw variant BadFormat {message = "missing colon in header"}
        pos ← pos + 1
        if key ≡ "__metadata__" {
            require not seen_meta throw variant BadMetadata {message = "duplicate __metadata__"}
            seen_meta ← true
            const MetadataCursor m ← _parse_metadata(tks, pos)
            pos ← m.pos
            meta_keys ← m.keys
            meta_values ← m.values
        }
        else {
            require names.length() ≺ TENSOR_LIMIT throw variant BadBounds {message = "tensor count above ceiling"}
            require key.length() ≤ NAME_LIMIT throw variant BadBounds {message = "tensor name above length ceiling"}
            const TensorCursor t ← _parse_tensor(tks, pos, key)
            pos ← t.pos
            names.append(key)
            dtypes.append(t.dtype)
            shapes.append(t.shape)
            starts.append(t.start)
            end.append(t.end)
        }
        require pos ≺ tks.length() throw variant BadFormat {message = "unterminated header object"}
        if _dtype(tks, pos) ≡ 5 {
            pos ← pos + 1
            require pos ≺ tks.length() throw variant BadFormat {message = "trailing comma in header"}
            require _dtype(tks, pos) ≠ 1 throw variant BadFormat {message = "trailing comma in header"}
        }
        elif _dtype(tks, pos) ≠ 1 {
            throw variant BadFormat {message = "malformed header separator"}
        }
    }
    throw variant BadFormat {message = "unterminated header object"}
}

# -------------------------------------------------------------------------
# Row validation helpers.
# -------------------------------------------------------------------------

# Build the manifest metadata table from the extracted header metadata
# (parallel key/value lists, header order preserved).
@ private { }
fn _metadata(list<string> keys, list<string> values) → list<capsule.SafetensorsMetadata> {
    var list<capsule.SafetensorsMetadata> out ← empty
    for range 0‥keys.length() const i {
        out.append(capsule.SafetensorsMetadata {key = keys.get(i) coalesce "", payload = values.get(i) coalesce ""})
    }
    return out
}

# Metadata lookup by key (union; caller unwraps with coalesce).
@ private { }
fn _metadata_get(list<string> keys, list<string> values, string key) → string ∪ null {
    for range 0‥keys.length() const i {
        if keys.get(i) coalesce "" ≡ key then return values.get(i) coalesce ""
    }
    return null
}

# Required metadata value; a missing key is a metadata-structure error.
@ private { }
fn _metadata_require(list<string> keys, list<string> values, string key) → string ⇥ SafetensorError {
    const string ∪ null v ← _metadata_get(keys, values, key)
    if v not is null then return v coalesce ""
    throw variant BadMetadata {message = "missing required metadata key: §"(key)}
}

# Index of a tensor name in the admitted table, or -1.
@ private { }
fn _find_name(string name) → int {
    for range 0‥EXPECTED_NAMES.length() const i {
        if EXPECTED_NAMES.get(i) coalesce "" ≡ name then return i
    }
    return -1
}

# Element-count product with checked multiply and per-dimension bounds
# (mirror of shape U3 / serialize._numel). Ceilings are validated
# before the product drives anything.
@ private { }
fn _numel(list<int> shape) → int ⇥ SafetensorError {
    require shape.length() ≥ 1 throw variant BadShape {message = "empty shape"}
    var int product ← 1
    for from shape const dim {
        require dim ≥ 1 throw variant BadShape {message = "non-positive dimension"}
        require dim ≤ DIMENSION_LIMIT throw variant BadBounds {message = "dimension above ceiling"}
        require product ≤ ELEMENT_LIMIT / dim throw variant BadBounds {message = "element count above ceiling"}
        product ← product * dim
    }
    return product
}

# In-bounds integer read. A miss fails closed instead of coalescing to -1.
@ private { }
fn _int_at(list<int> xs, int i) → int ⇥ SafetensorError {
    require i ≥ 0 throw variant BadBounds {message = "integer index out of range"}
    require i ≺ xs.length() throw variant BadBounds {message = "integer index out of range"}
    do {
        return xs.get(i)
    }
    catch err {
        throw variant BadBounds {message = "integer index out of range"}
    }
    throw variant BadBounds {message = "integer index out of range"}
}

# Shape equality (element-wise; lists have no built-in equality).
@ private { }
fn _shapes_equal(list<int> a, list<int> b) → bool ⇥ SafetensorError {
    if a.length() ≠ b.length() then return false
    for range 0‥a.length() const i {
        if _int_at(a, i) ≠ _int_at(b, i) then return false
    }
    return true
}

# -------------------------------------------------------------------------
# GEA1 selected-range admission. The caller has independently read the
# Safetensors header and then supplied exactly one bounded tensor range. The
# pinned facts are checked before the range becomes a typed BF16 handoff.
# There is deliberately no path or container argument here.
# -------------------------------------------------------------------------

@ public { }
fn admit_selected(bytes payload, string digest, int artifact_length, int data_start, int relative_start, int relative_end) → SelectedTensor ⇥ SafetensorError {
    require digest ≡ GEA1_DIGEST throw variant BadDigest {message = "GEA1 source digest does not match the pinned artifact"}
    require artifact_length ≡ GEA1_ARTIFACT_LENGTH throw variant BadBounds {message = "GEA1 source length does not match the pinned artifact"}
    require data_start ≡ GEA1_DATA_START throw variant BadOffset {message = "GEA1 data-region start does not match the pinned header"}
    require relative_start ≡ GEA1_RELATIVE_START throw variant BadOffset {message = "GEA1 selected tensor start does not match the pinned header"}
    require relative_end ≡ GEA1_RELATIVE_END throw variant BadOffset {message = "GEA1 selected tensor end does not match the pinned header"}
    require relative_end ≻ relative_start throw variant BadOffset {message = "GEA1 selected tensor range is empty"}
    require relative_end - relative_start ≡ GEA1_BYTES throw variant BadShape {message = "GEA1 selected tensor byte length does not match BF16 shape"}
    require payload.length() ≡ GEA1_BYTES throw variant BadOffset {message = "GEA1 selected range read has the wrong byte length"}
    const int absolute_start ← data_start + relative_start
    require absolute_start ≡ GEA1_ABSOLUTE_START throw variant BadOffset {message = "GEA1 selected tensor absolute range is inconsistent"}
    return SelectedTensor {name = GEA1_TENSOR_NAME, dtype_tag = dtype.bf16(), shape = [320, 960], artifact_digest = digest, artifact_length = artifact_length, data_start = data_start, relative_start = relative_start, relative_end = relative_end, absolute_start = absolute_start, payload = payload}
}

# -------------------------------------------------------------------------
# admit — the fail-closed ADMISSION. One Safetensors row in, one
# capsule.Capsule out (schema-2: pathless artifact.ContentIdentity plus
# the capsule's SafetensorsManifest). Every count/offset/length is
# bounds-checked before any work sized by it; every dimension of the pinned
# row (format, version, architecture, dtype, offsets, shapes, tokenizer
# identity, ceilings) is validated before the capsule is built. The
# digest is the host-verified whole-file digest claim (form-validated
# here; correctness re-verifiable via capsule.verify_against). path is
# locator metadata only — schema 2 never carries a path into the capsule.
# -------------------------------------------------------------------------

@ public { }
fn admit(list<int<u8>> corpus, string digest, string path) → capsule.Capsule ⇥ SafetensorError {
    # -- container (format) ----------------------------------------------
    const HeaderCursor cc ← _header(corpus)
    const int header ← cc.header
    const string header_text ← cc.text
    const int data_length ← corpus.length() - 8 - header

    # -- header parse + pinned extraction --------------------------------
    const list<Token> tks ← _scan(header_text)
    const Structure st ← _walk(tks)

    # -- metadata facts (format / version / arch / tokenizer) ------------
    const string format_name ← _metadata_require(st.meta_keys, st.meta_values, K_FORMAT_NAME)
    const string format_version ← _metadata_require(st.meta_keys, st.meta_values, K_FORMAT_VERSION)
    const string arch ← _metadata_require(st.meta_keys, st.meta_values, K_ARCH)
    const string density ← _metadata_require(st.meta_keys, st.meta_values, K_DENSITY)
    const string layers_text ← _metadata_require(st.meta_keys, st.meta_values, K_LAYERS)
    const string context ← _metadata_require(st.meta_keys, st.meta_values, K_CONTEXT)
    const string merge_kind ← _metadata_require(st.meta_keys, st.meta_values, K_MERGE_KIND)
    const string pre ← _metadata_require(st.meta_keys, st.meta_values, K_PRE)
    const string vocab_digest ← _metadata_require(st.meta_keys, st.meta_values, K_VOCAB)
    const string eog ← _metadata_require(st.meta_keys, st.meta_values, K_EOG)
    const string bos ← _metadata_require(st.meta_keys, st.meta_values, K_BOS)
    const string space ← _metadata_require(st.meta_keys, st.meta_values, K_SPACE)
    require format_name ≡ ROW_FORMAT_NAME throw variant BadFormat {message = "unsupported safetensors format: §"(format_name)}
    require format_version ≡ ROW_FORMAT_VERSION throw variant UnknownVersion {message = "unsupported safetensors row version: §"(format_version)}
    require arch ≡ ARCH_IDENTIFIER throw variant BadArchitecture {message = "architecture mismatch"}
    require density ≡ ARCH_DENSITY throw variant BadArchitecture {message = "architecture mismatch"}
    require layers_text ≡ (ARCH_LAYERS ↦ string) throw variant BadArchitecture {message = "architecture mismatch"}
    require context ≡ ARCH_CONTEXT throw variant BadArchitecture {message = "architecture mismatch"}
    require merge_kind ≡ TOKENIZER_MERGE_KIND throw variant BadTokenizer {message = "tokenizer identity mismatch"}
    require pre ≡ TOKENIZER_PRE throw variant BadTokenizer {message = "tokenizer identity mismatch"}
    require eog ≡ TOKENIZER_EOG throw variant BadTokenizer {message = "tokenizer identity mismatch"}
    require bos ≡ TOKENIZER_BOS throw variant BadTokenizer {message = "tokenizer identity mismatch"}
    require space ≡ TOKENIZER_SPACE throw variant BadTokenizer {message = "tokenizer identity mismatch"}
    require _hex_ok(vocab_digest) throw variant BadDigest {message = "malformed vocabulary digest"}
    require _hex_ok(digest) throw variant BadDigest {message = "malformed digest value"}

    # -- tensor table (dtype / shapes / ceilings / offsets / coverage) ---
    const int n ← st.names.length()
    require n ≡ EXPECTED_NAMES.length() throw variant BadArchitecture {message = "tensor count mismatch"}
    for range 0‥n const i {
        for range 0‥n const j {
            require not (i ≺ j and st.names.get(i) coalesce "" ≡ st.names.get(j) coalesce "") throw variant BadOffset {message = "duplicate tensor name: §"(st.names.get(i) coalesce "")}
        }
    }
    var int total_elements ← 0
    var int sum_lengths ← 0
    var list<capsule.SafetensorsTensorDescriptor> descriptors ← empty
    for range 0‥n const i {
        const string name ← st.names.get(i) coalesce ""
        const string kind ← st.dtypes.get(i) coalesce ""
        const list<int> shape ← st.shapes.get(i) coalesce []
        const int start ← _int_at(st.starts, i)
        const int end ← _int_at(st.end, i)
        const int idx ← _find_name(name)
        require idx ≥ 0 throw variant BadArchitecture {message = "tensor not in admitted row: §"(name)}
        require kind ≡ DTYPE_F32 throw variant UnknownDtype {message = "unsupported dtype: § for §"(kind, name)}
        const int elements ← _numel(shape)
        const list<int> expected ← EXPECTED_SHAPES.get(idx) coalesce []
        const bool same_shape ← _shapes_equal(shape, expected)
        require same_shape throw variant BadShape {message = "shape mismatch for §"(name)}
        require end - start ≡ elements * F32_BYTES throw variant BadShape {message = "shape/offset inconsistency for §"(name)}
        require start ≥ 0 throw variant BadOffset {message = "malformed data offsets for §"(name)}
        require end ≻ start throw variant BadOffset {message = "malformed data offsets for §"(name)}
        require end ≤ data_length throw variant BadOffset {message = "data region truncated — tensor extends beyond file: §"(name)}
        require start % ALIGNMENT ≡ 0 throw variant BadOffset {message = "misaligned tensor data offset: §"(name)}
        total_elements ← total_elements + elements
        sum_lengths ← sum_lengths + (end - start)
        require total_elements ≤ ELEMENT_LIMIT throw variant BadBounds {message = "total element count above ceiling"}
        descriptors.append(capsule.SafetensorsTensorDescriptor {name = name, dtype = kind, shape = shape, start = start, end = end, elements = elements})
    }
    # pairwise overlap — intervals must not intersect (O(n²), n ≤ 16).
    for range 0‥n const i {
        for range 0‥n const j {
            if i ≠ j {
                const int ai ← _int_at(st.starts, i)
                const int bi ← _int_at(st.end, i)
                const int aj ← _int_at(st.starts, j)
                const int bj ← _int_at(st.end, j)
                require not (bi ≻ aj and bj ≻ ai) throw variant BadOffset {message = "overlapping tensor data regions"}
            }
        }
    }
    # exact tiling: non-overlapping intervals with total length == data
    # region length within [0, data_len] cover the region exactly.
    require sum_lengths ≡ data_length throw variant BadOffset {message = "data region does not tile exactly"}

    # -- capsule construction (the schema-2 admission target, C8) --------
    # The capsule carries the pathless content identity (host-computed
    # digest claim, form-validated above) plus the Safetensors manifest
    # (format/version + header metadata + per-tensor descriptors). path
    # never enters the capsule — schema 2 has no path.
    do {
        const artifact.ContentIdentity identity ← artifact.ContentIdentity {algorithm = DIGEST_SHA256, digest = digest, length = corpus.length()}
        const capsule.SafetensorsManifest manifest ← capsule.SafetensorsManifest {format = ROW_FORMAT_NAME, version = ROW_FORMAT_VERSION, artifact_length = corpus.length(), data_length = data_length, metadata = _metadata(st.meta_keys, st.meta_values), tensors = descriptors}
        const capsule.Capsule c ← capsule.construct_manifest(capsule.schema_version_text(), identity, capsule.safetensors_manifest(manifest))
        return c
    }
    catch err {
        throw variant BadAdmission {message = "capsule admission rejected: §"(capsule.message(err))}
    }
}
