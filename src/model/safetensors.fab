+++
locale = "en"
+++
# Safetensors row admission — one pinned Safetensors row parses into the
# admitted-model capsule, fail-closed (PML2-U2, Lane 1).
#
# Public import: importa ex "gradus:model/safetensors" privata safetensors
# Depends on: gradus:model/capsule (the PML2-U1 admitted-model capsule,
# capsule-schema-2.0.0) and gradus:model/artifact (pathless content
# identity). This module is the U2 seam: raw Safetensors bytes in ->
# capsula.Capsula out. Raw bytes and paths are NEVER trust anchors
# (capsule contract, council C8) — only the capsule carries identity.

import from "gradus:model/artifact" artifact

import from "gradus:model/capsule" capsula
#
# --- Contract ------------------------------------------------------------
#
# One Safetensors row is admitted: the pinned scaled row of
# fixtures/safetensors/safetensors-row-oracle.md (smollm2-360m-scaled-row),
# a structural stand-in for the SmolLM2-360M-Instruct row of
# gi0-model-contract 1.0.0. The row facts (arch llama/dense, gpt2/smollm
# tokenizer identity, F32-only tensor table, ceilings) are pinned below as
# constants; ANY deviation fails closed with a typed SafetensorError before
# any allocation sized by an attacker-controlled count. The capsule
# certifies exactly the row this module admitted; the digest VALUE is
# host-computed and passed in (the language surface has no digest
# primitive — capsule.fab header, GI1 boundary), its form is validated
# here and its correctness re-verifiable via capsule.verifica_contra.
#
# Container facts (Safetensors reference format): an 8-byte little-endian
# u64 header_size INCLUDES the 8-byte prefix; the JSON header occupies
# [8, header_size); the data region starts at header_size (8-aligned) and
# tensor data_offsets are relative to it. The pinned row's data region
# tiles exactly (coverage true): intervals are non-overlapping and their
# total length equals the data-region length, so no gap/overlap/misalignment
# can be admitted (capsule BytesValida.opertum = true).
#
# Typed error vocabulary (SafetensorError, variant -> class):
#   FormaMala       — container/JSON format violations (truncation,
#                     non-JSON, non-object header, format-name mismatch,
#                     malformed members/separators).
#   VersioIgnota    — unsupported pinned row version.
#   ArchitecturaMala— architecture facts mismatch (or tensor outside the
#                     admitted row / tensor-table mismatch).
#   TypoIgnotum     — unsupported tensor dtype.
#   OffscetaMala    — data-offset violations (bounds, 8-byte misalignment,
#                     duplicate tensor name, overlapping regions, gapped /
#                     non-tiling data region).
#   FiguraMala      — shape violations (non-positive dim, shape mismatch,
#                     shape/offset byte-length inconsistency).
#   TokenizerMala   — tokenizer identity mismatch (kind / pre-tokenizer /
#                     EOG set / BOS-free / space-prefix-free facts).
#   LimitesMala     — ceilings: header size, token count, metadata KV
#                     count, tensor count, name length, dimension size,
#                     total elements.
#   DigestioMala    — malformed digest claim (row digest or vocab digest).
#   MerciumMala     — metadata structure violations (missing __metadata__,
#                     missing required key, non-string metadata value).
#   IngressioMala   — the capsule constructor rejected the validated row
#                     (defense-in-depth; should not fire on admitted rows).
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * Cross-module enum variants are unsupported (SEM002/SEM041), so this
#     module defines its OWN typed error vocabulary (above) mirroring the
#     capsule's AdmissionError classes, and renders capsule errors via
#     capsula.causa on conversion.
#   * The language has no codepoint/ord intrinsic: a \uXXXX escape is
#     form-validated (4 hex digits) but preserved VERBATIM in the token
#     value. Every pinned row constant is pure ASCII, so any escape in an
#     admitted-relevant field changes the compared value and fails closed;
#     ignored fields carry the verbatim token (documented, fail-closed).
#   * Proba proof is compile-level (`faber check src/model/safetensors.proba`):
#     execution (`faber test`) is blocked tree-wide by the missing locale
#     pack (radix/stdlib/reader/la/pack.toml) and the recorded FMIR
#     stepper limitation (see capsule.proba header). The proba reconstructs
#     the pinned fixture bytes from the same JSON + data pattern as the
#     committed generator, so the oracle hash binds both.
#
# --- Seams ---------------------------------------------------------------
#   * GGUF row admission (parallel U3, hand-4) — disjoint format file.
#   * tokenizer probe parity (P1–P11, vocab digest execution) — PML2-U4.
#   * norma:model + GI1 admission migration (no dual authority) — PML2-U5.
#   * digest computation — the admission host (pure-Rust, GI1).
#   * forward architectures / new rows — PML3 (R3: the pinned constants
#     below are the one place a second row extends).

# -------------------------------------------------------------------------
# Pinned row constants (R3: extend here for a second row). Mirror values of
# the capsule contract where the capsule checks form (schema, digest
# algorithm, quantization row, ceilings).
# -------------------------------------------------------------------------

# Capsule contract mirrors (capsule-schema-2.0.0 / sha-256). Schema 2
# carries no quantization row (D4): the F32 row facts stay as structural
# checks here, and the identity algorithm mirrors the capsule.
const string DIGESTUM_SHA256 ← "sha-256"

const int F32_OCTETI ← 4

# Pinned row facts (oracle doc; gi0-model-contract 1.0.0 sources).
const string ROW_FORMAT_NOMEN ← "safetensors"

const string ROW_FORMAT_VERSIO ← "1.0.0"

const string ARCH_IDENTIFICATOR ← "llama"

const string ARCH_DENSITAS ← "dense"

const int ARCH_STRATA ← 1

const string ARCH_CONTEXTUS ← "2048"

const string TOKENIZATOR_PROGENIES ← "gpt2"

const string TOKENIZATOR_PRE ← "smollm"

const string TOKENIZATOR_EOG ← "0,2"

const string TOKENIZATOR_BOS ← "true"

const string TOKENIZATOR_SPATIUM ← "true"

const string DTYPE_F32 ← "F32"

# Metadata keys the pinned row must carry in __metadata__.
const string K_FORMAT_NOMEN ← "format.name"

const string K_FORMAT_VERSIO ← "format.version"

const string K_ARCH ← "model.arch"

const string K_DENSITAS ← "model.density"

const string K_STRATA ← "model.layers"

const string K_CONTEXTUS ← "model.context"

const string K_PROGENIES ← "tokenizer.model"

const string K_PRE ← "tokenizer.pre"

const string K_VOCAB ← "tokenizer.vocab_digest"

const string K_EOG ← "tokenizer.eog"

const string K_BOS ← "tokenizer.bos_free"

const string K_SPATIUM ← "tokenizer.space_prefix_free"

# Row ceilings (validated BEFORE any count-driven work). Safetensors
# alignment is 8 bytes.
const int CONCORDATIO_FABRICA ← 8

const int CAPUT_LIMES ← 1048576

const int TOKENS_LIMES ← 4096

const int KV_LIMES ← 64

const int TENSORES_LIMES ← 16

const int NOMEN_LIMES ← 128

const int DIMENSI_LIMES ← 65536

const int ELEMENTA_LIMES ← 1000000000

const int ARRAY_LIMES ← 16

# The admitted tensor table (name + expected shape). The proba and the
# committed fixture generator must agree byte-for-byte on the row.
const list<string> EXPECTATI_NOMINA ← ["model.embed_tokens.weight", "model.norm.weight", "model.layers.0.self_attn.q_proj.weight", "model.layers.0.self_attn.v_proj.weight", "model.layers.0.mlp.down_proj.weight"]

const list<list<int>> EXPECTATAE_FORMAE ← [[8, 4], [8], [8, 8], [8, 4], [4, 8]]

# -------------------------------------------------------------------------
# SafetensorError — typed error vocabulary (variant -> class above). The
# module's public surface (SafetensorError, causa, admittas) is marked
# @ publica so the proba and the conformance suite can import it under the
# post-visibility-flip compiler (frozen entry behavior).
# -------------------------------------------------------------------------


@ public { }
union SafetensorError {
    FormaMala {
        string message
    },
    VersioIgnota {
        string message
    },
    ArchitecturaMala {
        string message
    },
    TypoIgnotum {
        string message
    },
    OffscetaMala {
        string message
    },
    FiguraMala {
        string message
    },
    TokenizerMala {
        string message
    },
    LimitesMala {
        string message
    },
    DigestioMala {
        string message
    },
    MerciumMala {
        string message
    },
    IngressioMala {
        string message
    }
}

@ public { }
fn message(SafetensorError e) → string {
    match e {
        case FormaMala const causa {
            return causa
        }
        case VersioIgnota const causa {
            return causa
        }
        case ArchitecturaMala const causa {
            return causa
        }
        case TypoIgnotum const causa {
            return causa
        }
        case OffscetaMala const causa {
            return causa
        }
        case FiguraMala const causa {
            return causa
        }
        case TokenizerMala const causa {
            return causa
        }
        case LimitesMala const causa {
            return causa
        }
        case DigestioMala const causa {
            return causa
        }
        case MerciumMala const causa {
            return causa
        }
        case IngressioMala const causa {
            return causa
        }
    }
}

# -------------------------------------------------------------------------
# Same-module carriers (the walkers build these; all fields are module-
# internal). Public surface stays on primitives + capsula.Capsula so the
# proba file-interface keeps every export (WARN014 seam, same as
# parameter/serialize/capsule).
# -------------------------------------------------------------------------

# A JSON token: typo 0..10 = { } [ ] : , string number true false null.
class Token {
    int kind
    string payload
}

# Extracted row structure after the header walk.
class Structure {
    list<string> meta_claves
    list<string> meta_valores
    list<string> nomina
    list<string> dtypi
    list<list<int>> formae
    list<int> initii
    list<int> end
}

# String-lexer result: new index + decoded value.
class StringValue {
    int pos
    string payload
}

# Metadata-object parse result.
class MetadataCursor {
    int pos
    list<string> claves
    list<string> valores
}

# Tensor-descriptor parse result.
class TensorCursor {
    int pos
    string dtype
    list<int> shape
    int start
    int end
}

# Number-array parse result.
class NumberCursor {
    int pos
    list<int> valores
}

# Container-header parse result (header_size includes the 8-byte prefix).
class HeaderCursor {
    int caput
    string textus
}

# -------------------------------------------------------------------------
# Character / value predicates (self-contained copies per leaf-module
# convention — the capsule's _est_hex/_hex_recta are module-private).
# -------------------------------------------------------------------------

@ private { }
fn _is_digit(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _is_hex(string c) → bool {
    if ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9" then return true
    if ((((c ≡ "a" or c ≡ "b") or c ≡ "c") or c ≡ "d") or c ≡ "e") or c ≡ "f" then return true
    return false
}

@ private { }
fn _is_optional(string c) → bool {
    return ((c ≡ " " or c ≡ "\t") or c ≡ "\n") or c ≡ "\r"
}

# Whole-digest predicate: exactly 64 lowercase hex characters.
@ private { }
fn _hex_ok(string s) → bool {
    if s.length() ≠ 64 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _is_hex(s.slice(i, i + 1)) then return false
        i ← i + 1
    }
    return true
}

# -------------------------------------------------------------------------
# Byte-level helpers (Safetensors container).
# -------------------------------------------------------------------------

# 8-byte little-endian read at offset (bounds validated by callers).
@ private { }
fn _le8(list<int<u8>> b, int off) → int {
    const int r0 ← b.get(off + 0) coalesce 0 ∷ int<u8> ↦ int
    const int r1 ← b.get(off + 1) coalesce 0 ∷ int<u8> ↦ int
    const int r2 ← b.get(off + 2) coalesce 0 ∷ int<u8> ↦ int
    const int r3 ← b.get(off + 3) coalesce 0 ∷ int<u8> ↦ int
    const int r4 ← b.get(off + 4) coalesce 0 ∷ int<u8> ↦ int
    const int r5 ← b.get(off + 5) coalesce 0 ∷ int<u8> ↦ int
    const int r6 ← b.get(off + 6) coalesce 0 ∷ int<u8> ↦ int
    const int r7 ← b.get(off + 7) coalesce 0 ∷ int<u8> ↦ int
    return ((((((r0 ∨ r1 ⇐ 8) ∨ r2 ⇐ 16) ∨ r3 ⇐ 24) ∨ r4 ⇐ 32) ∨ r5 ⇐ 40) ∨ r6 ⇐ 48) ∨ r7 ⇐ 56
}

# Container-header validation: the 8-byte LE header_size (which includes
# the prefix), bounds, 8-byte alignment, UTF-8 header textus extraction.
# Ceilings are checked BEFORE the header slice is materialized.
@ private { }
fn _header(list<int<u8>> corpus) → HeaderCursor ⇥ SafetensorError {
    if corpus.length() ≺ 8 {
        throw variant FormaMala {message = "truncated safetensors header prefix"}
    }
    const int caput ← _le8(corpus, 0)
    if caput ≺ 8 {
        throw variant FormaMala {message = "invalid safetensors header size"}
    }
    if caput ≻ CAPUT_LIMES {
        throw variant LimitesMala {message = "header size above ceiling"}
    }
    if caput ≻ corpus.length() {
        throw variant FormaMala {message = "truncated header — header size beyond file"}
    }
    if caput % CONCORDATIO_FABRICA ≠ 0 {
        throw variant FormaMala {message = "misaligned safetensors header (not 8-byte aligned)"}
    }
    var list<int<u8>> sub ← vacua
    var int i ← 8
    while i ≺ caput {
        sub.append(corpus.get(i) coalesce 0 ∷ int<u8>)
        i ← i + 1
    }
    const bytes o ← sub
    do {
        const string t ← o ↦ string
        return HeaderCursor {caput = caput, textus = t}
    }
    catch err {
        throw variant FormaMala {message = "header is not valid UTF-8"}
    }
}

# -------------------------------------------------------------------------
# JSON tokenizer (strict lexical validation of the header).
# -------------------------------------------------------------------------

# Parse a JSON string starting at index i (the opening quote). Handles the
# standard escapes; \uXXXX is form-validated (4 hex digits) and preserved
# verbatim (no codepoint intrinsic — compiler-boundary note above).
@ private { }
fn _read_string(string h, int i) → StringValue ⇥ SafetensorError {
    var string valor ← ""
    var int pos ← i + 1
    while pos ≺ h.length() {
        const string c ← h.slice(pos, pos + 1)
        if c ≡ «\"» then return StringValue {pos = pos + 1, payload = valor}
        if c ≡ "\\" {
            if pos + 1 ≥ h.length() {
                throw variant FormaMala {message = "unterminated string escape"}
            }
            const string e ← h.slice(pos + 1, pos + 2)
            if e ≡ «\"» {
                valor ← valor + «\"»
                pos ← pos + 2
            }
            elif e ≡ "\\" {
                valor ← valor + "\\"
                pos ← pos + 2
            }
            elif e ≡ "/" {
                valor ← valor + "/"
                pos ← pos + 2
            }
            elif e ≡ "n" {
                valor ← valor + "\n"
                pos ← pos + 2
            }
            elif e ≡ "r" {
                valor ← valor + "\r"
                pos ← pos + 2
            }
            elif e ≡ "t" {
                valor ← valor + "\t"
                pos ← pos + 2
            }
            elif e ≡ "b" {
                valor ← valor + "\u{08}"
                pos ← pos + 2
            }
            elif e ≡ "f" {
                valor ← valor + "\u{0C}"
                pos ← pos + 2
            }
            elif e ≡ "u" {
                if pos + 5 ≥ h.length() {
                    throw variant FormaMala {message = "truncated \\u escape"}
                }
                const string quad ← h.slice(pos + 2, pos + 6)
                var int j ← 0
                while j ≺ 4 {
                    if not _is_hex(quad.slice(j, j + 1)) {
                        throw variant FormaMala {message = "malformed \\u escape"}
                    }
                    j ← j + 1
                }
                valor ← (valor + "\\u") + quad
                pos ← pos + 6
            }
            else {
                throw variant FormaMala {message = "unknown string escape"}
            }
        }
        else {
            if (((c ≡ "\n" or c ≡ "\r") or c ≡ "\t") or c ≡ "\u{08}") or c ≡ "\u{0C}" {
                throw variant FormaMala {message = "unescaped control character in string"}
            }
            valor ← valor + c
            pos ← pos + 1
        }
    }
    throw variant FormaMala {message = "unterminated string"}
}

# Parse a JSON number starting at index i (digit or minus). Returns the
# raw number textus (JSON grammar: -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?).
@ private { }
fn _read_number(string h, int i) → StringValue ⇥ SafetensorError {
    var int pos ← i
    if h.slice(pos, pos + 1) ≡ "-" {
        pos ← pos + 1
        if pos ≥ h.length() {
            throw variant FormaMala {message = "malformed number"}
        }
    }
    if h.slice(pos, pos + 1) ≡ "0" {
        pos ← pos + 1
        if pos ≺ h.length() and _is_digit(h.slice(pos, pos + 1)) {
            throw variant FormaMala {message = "malformed number"}
        }
    }
    elif _is_digit(h.slice(pos, pos + 1)) {
        while pos ≺ h.length() and _is_digit(h.slice(pos, pos + 1)) {
            pos ← pos + 1
        }
    }
    else {
        throw variant FormaMala {message = "malformed number"}
    }
    if pos ≺ h.length() and h.slice(pos, pos + 1) ≡ "." {
        pos ← pos + 1
        if pos ≥ h.length() or not _is_digit(h.slice(pos, pos + 1)) {
            throw variant FormaMala {message = "malformed number"}
        }
        while pos ≺ h.length() and _is_digit(h.slice(pos, pos + 1)) {
            pos ← pos + 1
        }
    }
    if pos ≺ h.length() and (h.slice(pos, pos + 1) ≡ "e" or h.slice(pos, pos + 1) ≡ "E") {
        pos ← pos + 1
        if pos ≺ h.length() and (h.slice(pos, pos + 1) ≡ "+" or h.slice(pos, pos + 1) ≡ "-") {
            pos ← pos + 1
        }
        if pos ≥ h.length() or not _is_digit(h.slice(pos, pos + 1)) {
            throw variant FormaMala {message = "malformed number"}
        }
        while pos ≺ h.length() and _is_digit(h.slice(pos, pos + 1)) {
            pos ← pos + 1
        }
    }
    return StringValue {pos = pos, payload = h.slice(i, pos)}
}

# Tokenize the whole header (strict lexical validation, bounded token
# count — checked before more tokens are appended).
@ private { }
fn _scan(string h) → list<Token> ⇥ SafetensorError {
    var list<Token> tks ← vacua
    var int pos ← 0
    while pos ≺ h.length() {
        const string c ← h.slice(pos, pos + 1)
        if _is_optional(c) {
            pos ← pos + 1
        }
        elif c ≡ "{" {
            tks.append(Token {kind = 0, payload = "{"})
            pos ← pos + 1
        }
        elif c ≡ "}" {
            tks.append(Token {kind = 1, payload = "}"})
            pos ← pos + 1
        }
        elif c ≡ "[" {
            tks.append(Token {kind = 2, payload = "["})
            pos ← pos + 1
        }
        elif c ≡ "]" {
            tks.append(Token {kind = 3, payload = "]"})
            pos ← pos + 1
        }
        elif c ≡ ":" {
            tks.append(Token {kind = 4, payload = ":"})
            pos ← pos + 1
        }
        elif c ≡ "," {
            tks.append(Token {kind = 5, payload = ","})
            pos ← pos + 1
        }
        elif c ≡ «\"» {
            const StringValue s ← _read_string(h, pos)
            tks.append(Token {kind = 6, payload = s.payload})
            pos ← s.pos
        }
        elif _is_digit(c) or c ≡ "-" {
            const StringValue n ← _read_number(h, pos)
            tks.append(Token {kind = 7, payload = n.payload})
            pos ← n.pos
        }
        elif c ≡ "t" {
            if h.slice(pos, pos + 4) ≡ "true" {
                tks.append(Token {kind = 8, payload = "true"})
                pos ← pos + 4
            }
            else {
                throw variant FormaMala {message = "malformed literal"}
            }
        }
        elif c ≡ "f" {
            if h.slice(pos, pos + 5) ≡ "false" {
                tks.append(Token {kind = 9, payload = "false"})
                pos ← pos + 5
            }
            else {
                throw variant FormaMala {message = "malformed literal"}
            }
        }
        elif c ≡ "n" {
            if h.slice(pos, pos + 4) ≡ "null" {
                tks.append(Token {kind = 10, payload = "null"})
                pos ← pos + 4
            }
            else {
                throw variant FormaMala {message = "malformed literal"}
            }
        }
        else {
            throw variant FormaMala {message = "unexpected character in header"}
        }
        if tks.length() ≻ TOKENS_LIMES {
            throw variant LimitesMala {message = "header token count above ceiling"}
        }
    }
    return tks
}

# -------------------------------------------------------------------------
# JSON structural walk (strict grammar validation + pinned-row extraction).
# -------------------------------------------------------------------------

@ private { }
fn _dtype(list<Token> tks, int i) → int {
    const Token t ← tks.get(i) coalesce Token {kind = -1, payload = ""}
    return t.kind
}

@ private { }
fn _value(list<Token> tks, int i) → string {
    const Token t ← tks.get(i) coalesce Token {kind = -1, payload = ""}
    return t.payload
}

# Integer-valued JSON number -> numerus (digits only, length-capped). A
# fractional/exponent number is not a valid shape dim or offset.
@ private { }
fn _parse_integer(string raw) → int ⇥ SafetensorError {
    if raw.length() ≡ 0 {
        throw variant FormaMala {message = "malformed integer"}
    }
    if raw.length() ≻ 18 {
        throw variant FormaMala {message = "integer above the numeric carrier"}
    }
    var int i ← 0
    while i ≺ raw.length() {
        if not _is_digit(raw.slice(i, i + 1)) {
            throw variant FormaMala {message = "non-integer value"}
        }
        i ← i + 1
    }
    do {
        const int v ← raw ↦ int
        return v
    }
    catch err {
        throw variant FormaMala {message = "malformed integer"}
    }
}

# Parse a JSON array of integers starting at pos (token typo 2). Bounded
# array length (shape rank / offsets / any numeric array).
@ private { }
fn _parse_numbers(list<Token> tks, int pos) → NumberCursor ⇥ SafetensorError {
    if _dtype(tks, pos) ≠ 2 {
        throw variant FormaMala {message = "expected an integer array"}
    }
    var int p ← pos + 1
    var list<int> valores ← vacua
    while p ≺ tks.length() {
        if _dtype(tks, p) ≡ 3 {
            p ← p + 1
            return NumberCursor {pos = p, valores = valores}
        }
        if _dtype(tks, p) ≠ 7 {
            throw variant FormaMala {message = "array must contain only integers"}
        }
        valores.append(_parse_integer(_value(tks, p)))
        p ← p + 1
        if valores.length() ≻ ARRAY_LIMES {
            throw variant LimitesMala {message = "array above length ceiling"}
        }
        if p ≥ tks.length() {
            throw variant FormaMala {message = "unterminated array"}
        }
        if _dtype(tks, p) ≡ 5 {
            p ← p + 1
            if p ≥ tks.length() or _dtype(tks, p) ≡ 3 {
                throw variant FormaMala {message = "trailing comma in array"}
            }
        }
        elif _dtype(tks, p) ≠ 3 {
            throw variant FormaMala {message = "malformed array separator"}
        }
    }
    throw variant FormaMala {message = "unterminated array"}
}

# Parse the __metadata__ object: a flat string->string table. KV count is
# bounded while collecting (ceiling before the walk grows further).
@ private { }
fn _parse_metadata(list<Token> tks, int pos) → MetadataCursor ⇥ SafetensorError {
    if _dtype(tks, pos) ≠ 0 {
        throw variant MerciumMala {message = "metadata must be a JSON object"}
    }
    var int p ← pos + 1
    var list<string> claves ← vacua
    var list<string> valores ← vacua
    while p ≺ tks.length() {
        if _dtype(tks, p) ≡ 1 {
            p ← p + 1
            return MetadataCursor {pos = p, claves = claves, valores = valores}
        }
        if _dtype(tks, p) ≠ 6 {
            throw variant MerciumMala {message = "malformed metadata member"}
        }
        const string clavis ← _value(tks, p)
        p ← p + 1
        if _dtype(tks, p) ≠ 4 {
            throw variant MerciumMala {message = "missing colon in metadata"}
        }
        p ← p + 1
        if _dtype(tks, p) ≠ 6 {
            throw variant MerciumMala {message = "metadata value must be a string"}
        }
        const string valor ← _value(tks, p)
        p ← p + 1
        claves.append(clavis)
        valores.append(valor)
        if claves.length() ≻ KV_LIMES {
            throw variant LimitesMala {message = "metadata KV count above ceiling"}
        }
        if p ≥ tks.length() {
            throw variant MerciumMala {message = "unterminated metadata object"}
        }
        if _dtype(tks, p) ≡ 5 {
            p ← p + 1
            if p ≥ tks.length() or _dtype(tks, p) ≡ 1 {
                throw variant MerciumMala {message = "trailing comma in metadata"}
            }
        }
        elif _dtype(tks, p) ≠ 1 {
            throw variant MerciumMala {message = "malformed metadata separator"}
        }
    }
    throw variant MerciumMala {message = "unterminated metadata object"}
}

# Parse one tensor descriptor: {"dtype": "...", "shape": [...],
# "data_offsets": [begin, end]}. Unknown members, duplicates, and missing
# members fail closed.
@ private { }
fn _parse_tensor(list<Token> tks, int pos, string nomen) → TensorCursor ⇥ SafetensorError {
    if _dtype(tks, pos) ≠ 0 {
        throw variant FormaMala {message = "tensor descriptor must be an object: " + nomen}
    }
    var int p ← pos + 1
    var bool dtype_visus ← false
    var bool forma_visa ← false
    var bool offsceta_visa ← false
    var string typo ← ""
    var list<int> forma ← vacua
    var int initium ← 0
    var int finis ← 0
    while p ≺ tks.length() {
        if _dtype(tks, p) ≡ 1 {
            p ← p + 1
            if not dtype_visus {
                throw variant FormaMala {message = "missing dtype in tensor descriptor: " + nomen}
            }
            if not forma_visa {
                throw variant FormaMala {message = "missing shape in tensor descriptor: " + nomen}
            }
            if not offsceta_visa {
                throw variant FormaMala {message = "missing data_offsets in tensor descriptor: " + nomen}
            }
            return TensorCursor {pos = p, dtype = typo, shape = forma, start = initium, end = finis}
        }
        if _dtype(tks, p) ≠ 6 {
            throw variant FormaMala {message = "malformed tensor descriptor member"}
        }
        const string clavis ← _value(tks, p)
        p ← p + 1
        if _dtype(tks, p) ≠ 4 {
            throw variant FormaMala {message = "missing colon in tensor descriptor"}
        }
        p ← p + 1
        if clavis ≡ "dtype" {
            if dtype_visus {
                throw variant FormaMala {message = "duplicate dtype in tensor descriptor"}
            }
            if _dtype(tks, p) ≠ 6 {
                throw variant FormaMala {message = "dtype must be a string"}
            }
            typo ← _value(tks, p)
            p ← p + 1
            dtype_visus ← true
        }
        elif clavis ≡ "shape" {
            if forma_visa {
                throw variant FormaMala {message = "duplicate shape in tensor descriptor"}
            }
            const NumberCursor nc ← _parse_numbers(tks, p)
            p ← nc.pos
            forma ← nc.valores
            forma_visa ← true
        }
        elif clavis ≡ "data_offsets" {
            if offsceta_visa {
                throw variant FormaMala {message = "duplicate data_offsets in tensor descriptor"}
            }
            const NumberCursor oc ← _parse_numbers(tks, p)
            p ← oc.pos
            if oc.valores.length() ≠ 2 {
                throw variant OffscetaMala {message = "data_offsets must have exactly 2 values: " + nomen}
            }
            initium ← oc.valores.get(0) coalesce (-1)
            finis ← oc.valores.get(1) coalesce (-1)
            offsceta_visa ← true
        }
        else {
            throw variant FormaMala {message = "unknown member in tensor descriptor: " + clavis}
        }
        if p ≥ tks.length() {
            throw variant FormaMala {message = "unterminated tensor descriptor"}
        }
        if _dtype(tks, p) ≡ 5 {
            p ← p + 1
            if p ≥ tks.length() or _dtype(tks, p) ≡ 1 {
                throw variant FormaMala {message = "trailing comma in tensor descriptor"}
            }
        }
        elif _dtype(tks, p) ≠ 1 {
            throw variant FormaMala {message = "malformed tensor descriptor separator"}
        }
    }
    throw variant FormaMala {message = "unterminated tensor descriptor"}
}

# Walk the token stream: top-level must be a single JSON object whose
# members are __metadata__ (exactly once) plus tensor entries. Every value
# sits in a pinned context, so the whole header is strictly validated and
# the pinned fields are extracted. The top-level object must close exactly
# at the end of the token stream — any trailing token after the closing
# brace fails closed (no partial-header admission). Count ceilings are
# enforced WHILE collecting (before any count-driven work downstream).
@ private { }
fn _walk(list<Token> tks) → Structure ⇥ SafetensorError {
    if tks.length() ≡ 0 {
        throw variant FormaMala {message = "empty header"}
    }
    if _dtype(tks, 0) ≠ 0 {
        throw variant FormaMala {message = "header is not a JSON object"}
    }
    var int pos ← 1
    var bool meta_visa ← false
    var list<string> meta_claves ← vacua
    var list<string> meta_valores ← vacua
    var list<string> nomina ← vacua
    var list<string> dtypi ← vacua
    var list<list<int>> formae ← vacua
    var list<int> initii ← vacua
    var list<int> finis ← vacua
    while pos ≺ tks.length() {
        if _dtype(tks, pos) ≡ 1 {
            pos ← pos + 1
            # Fail closed on trailing content: the top-level object must
            # close exactly at the end of the token stream.
            if pos ≠ tks.length() {
                throw variant FormaMala {message = "trailing tokens after the header object"}
            }
            return Structure {meta_claves = meta_claves, meta_valores = meta_valores, nomina = nomina, dtypi = dtypi, formae = formae, initii = initii, end = finis}
        }
        if _dtype(tks, pos) ≠ 6 {
            throw variant FormaMala {message = "malformed header member"}
        }
        const string clavis ← _value(tks, pos)
        pos ← pos + 1
        if _dtype(tks, pos) ≠ 4 {
            throw variant FormaMala {message = "missing colon in header"}
        }
        pos ← pos + 1
        if clavis ≡ "__metadata__" {
            if meta_visa {
                throw variant MerciumMala {message = "duplicate __metadata__"}
            }
            meta_visa ← true
            const MetadataCursor m ← _parse_metadata(tks, pos)
            pos ← m.pos
            meta_claves ← m.claves
            meta_valores ← m.valores
        }
        else {
            if nomina.length() ≥ TENSORES_LIMES {
                throw variant LimitesMala {message = "tensor count above ceiling"}
            }
            if clavis.length() ≻ NOMEN_LIMES {
                throw variant LimitesMala {message = "tensor name above length ceiling"}
            }
            const TensorCursor t ← _parse_tensor(tks, pos, clavis)
            pos ← t.pos
            nomina.append(clavis)
            dtypi.append(t.dtype)
            formae.append(t.shape)
            initii.append(t.start)
            finis.append(t.end)
        }
        if pos ≥ tks.length() {
            throw variant FormaMala {message = "unterminated header object"}
        }
        if _dtype(tks, pos) ≡ 5 {
            pos ← pos + 1
            if pos ≥ tks.length() or _dtype(tks, pos) ≡ 1 {
                throw variant FormaMala {message = "trailing comma in header"}
            }
        }
        elif _dtype(tks, pos) ≠ 1 {
            throw variant FormaMala {message = "malformed header separator"}
        }
    }
    throw variant FormaMala {message = "unterminated header object"}
}

# -------------------------------------------------------------------------
# Row validation helpers.
# -------------------------------------------------------------------------

# Build the manifest metadata table from the extracted header metadata
# (parallel key/value lists, header order preserved).
@ private { }
fn _metadata(list<string> claves, list<string> valores) → list<capsula.SafetensorsMetadata> {
    var list<capsula.SafetensorsMetadata> out ← vacua
    for range 0‥claves.length() const i {
        out.append(capsula.SafetensorsMetadata {key = claves.get(i) coalesce "", payload = valores.get(i) coalesce ""})
    }
    return out
}

# Metadata lookup by key (union; caller unwraps with vel).
@ private { }
fn _metadata_get(list<string> claves, list<string> valores, string clavis) → string ∪ null {
    for range 0‥claves.length() const i {
        if claves.get(i) coalesce "" ≡ clavis then return valores.get(i) coalesce ""
    }
    return null
}

# Required metadata value; a missing key is a metadata-structure error.
@ private { }
fn _metadata_require(list<string> claves, list<string> valores, string clavis) → string ⇥ SafetensorError {
    const string ∪ null v ← _metadata_get(claves, valores, clavis)
    if v not is null then return v coalesce ""
    throw variant MerciumMala {message = "missing required metadata key: " + clavis}
}

# Index of a tensor name in the admitted table, or -1.
@ private { }
fn _find_name(string nomen) → int {
    for range 0‥EXPECTATI_NOMINA.length() const i {
        if EXPECTATI_NOMINA.get(i) coalesce "" ≡ nomen then return i
    }
    return -1
}

# Element-count product with checked multiply and per-dimension bounds
# (mirror of shape U3 / serialize._quantitas). Ceilings are validated
# before the product drives anything.
@ private { }
fn _numel(list<int> forma) → int ⇥ SafetensorError {
    if forma.length() ≺ 1 {
        throw variant FiguraMala {message = "empty shape"}
    }
    var int product ← 1
    for from forma const dim {
        if dim ≺ 1 {
            throw variant FiguraMala {message = "non-positive dimension"}
        }
        if dim ≻ DIMENSI_LIMES {
            throw variant LimitesMala {message = "dimension above ceiling"}
        }
        if product ≻ ELEMENTA_LIMES / dim {
            throw variant LimitesMala {message = "element count above ceiling"}
        }
        product ← product * dim
    }
    return product
}

# Shape equality (element-wise; lists have no built-in equality).
@ private { }
fn _shapes_equal(list<int> a, list<int> b) → bool {
    if a.length() ≠ b.length() then return false
    for range 0‥a.length() const i {
        if a.get(i) coalesce (-1) ≠ b.get(i) coalesce (-1) then return false
    }
    return true
}

# -------------------------------------------------------------------------
# admittas — the fail-closed ADMISSION. One Safetensors row in, one
# capsula.Capsula out (schema-2: pathless artifact.IdentitasContenuti plus
# the capsule's ManifestumSafetensors). Every count/offset/length is
# bounds-checked before any work sized by it; every dimension of the pinned
# row (format, version, architecture, dtype, offsets, shapes, tokenizer
# identity, ceilings) is validated before the capsule is built. The
# digestio is the host-verified whole-file digest claim (form-validated
# here; correctness re-verifiable via capsule.verifica_contra). semita is
# locator metadata only — schema 2 never carries a path into the capsule.
# -------------------------------------------------------------------------

@ public { }
fn admittas(list<int<u8>> corpus, string digestio, string semita) → capsula.Capsule ⇥ SafetensorError {
    # -- container (format) ----------------------------------------------
    const HeaderCursor cc ← _header(corpus)
    const int caput ← cc.caput
    const string caput_textus ← cc.textus
    const int data_longitudo ← corpus.length() - caput

    # -- header parse + pinned extraction --------------------------------
    const list<Token> tks ← _scan(caput_textus)
    const Structure st ← _walk(tks)

    # -- metadata facts (format / version / arch / tokenizer) ------------
    const string format_nomen ← _metadata_require(st.meta_claves, st.meta_valores, K_FORMAT_NOMEN)
    const string format_versio ← _metadata_require(st.meta_claves, st.meta_valores, K_FORMAT_VERSIO)
    const string arch ← _metadata_require(st.meta_claves, st.meta_valores, K_ARCH)
    const string densitas ← _metadata_require(st.meta_claves, st.meta_valores, K_DENSITAS)
    const string strata_textus ← _metadata_require(st.meta_claves, st.meta_valores, K_STRATA)
    const string contextus ← _metadata_require(st.meta_claves, st.meta_valores, K_CONTEXTUS)
    const string progenies ← _metadata_require(st.meta_claves, st.meta_valores, K_PROGENIES)
    const string pre ← _metadata_require(st.meta_claves, st.meta_valores, K_PRE)
    const string vocab_digestio ← _metadata_require(st.meta_claves, st.meta_valores, K_VOCAB)
    const string eog ← _metadata_require(st.meta_claves, st.meta_valores, K_EOG)
    const string bos ← _metadata_require(st.meta_claves, st.meta_valores, K_BOS)
    const string spatium ← _metadata_require(st.meta_claves, st.meta_valores, K_SPATIUM)
    if format_nomen ≠ ROW_FORMAT_NOMEN {
        throw variant FormaMala {message = "unsupported safetensors format: " + format_nomen}
    }
    if format_versio ≠ ROW_FORMAT_VERSIO {
        throw variant VersioIgnota {message = "unsupported safetensors row version: " + format_versio}
    }
    if ((arch ≠ ARCH_IDENTIFICATOR or densitas ≠ ARCH_DENSITAS) or strata_textus ≠ (ARCH_STRATA ↦ string)) or contextus ≠ ARCH_CONTEXTUS {
        throw variant ArchitecturaMala {message = "architecture mismatch"}
    }
    if (((progenies ≠ TOKENIZATOR_PROGENIES or pre ≠ TOKENIZATOR_PRE) or eog ≠ TOKENIZATOR_EOG) or bos ≠ TOKENIZATOR_BOS) or spatium ≠ TOKENIZATOR_SPATIUM {
        throw variant TokenizerMala {message = "tokenizer identity mismatch"}
    }
    if not _hex_ok(vocab_digestio) {
        throw variant DigestioMala {message = "malformed vocabulary digest"}
    }
    if not _hex_ok(digestio) {
        throw variant DigestioMala {message = "malformed digest value"}
    }

    # -- tensor table (dtype / shapes / ceilings / offsets / coverage) ---
    const int n ← st.nomina.length()
    if n ≠ EXPECTATI_NOMINA.length() {
        throw variant ArchitecturaMala {message = "tensor count mismatch"}
    }
    # duplicate names — a duplicate tensor is a malformed row.
    for range 0‥n const i {
        for range 0‥n const j {
            if i ≺ j and st.nomina.get(i) coalesce "" ≡ st.nomina.get(j) coalesce "" {
                throw variant OffscetaMala {message = "duplicate tensor name: " + st.nomina.get(i) coalesce ""}
            }
        }
    }
    var int elementa_totalia ← 0
    var int sum_longitudinum ← 0
    var list<capsula.SafetensorsTensorDescriptor> descripta ← vacua
    for range 0‥n const i {
        const string nomen ← st.nomina.get(i) coalesce ""
        const string typo ← st.dtypi.get(i) coalesce ""
        const list<int> forma ← st.formae.get(i) coalesce []
        const int initium ← st.initii.get(i) coalesce (-1)
        const int finis ← st.end.get(i) coalesce (-1)
        const int idx ← _find_name(nomen)
        if idx ≺ 0 {
            throw variant ArchitecturaMala {message = "tensor not in admitted row: " + nomen}
        }
        if typo ≠ DTYPE_F32 {
            throw variant TypoIgnotum {message = (("unsupported dtype: " + typo) + " for ") + nomen}
        }
        const int elementa ← _numel(forma)
        const list<int> expectata ← EXPECTATAE_FORMAE.get(idx) coalesce []
        if not _shapes_equal(forma, expectata) {
            throw variant FiguraMala {message = "shape mismatch for " + nomen}
        }
        # F32: 4 bytes per element; the offsets must agree with the shape.
        if finis - initium ≠ elementa * F32_OCTETI {
            throw variant FiguraMala {message = "shape/offset inconsistency for " + nomen}
        }
        if initium ≺ 0 or finis ≤ initium {
            throw variant OffscetaMala {message = "malformed data offsets for " + nomen}
        }
        if finis ≻ data_longitudo {
            throw variant OffscetaMala {message = "data region truncated — tensor extends beyond file: " + nomen}
        }
        if initium % CONCORDATIO_FABRICA ≠ 0 {
            throw variant OffscetaMala {message = "misaligned tensor data offset: " + nomen}
        }
        elementa_totalia ← elementa_totalia + elementa
        sum_longitudinum ← sum_longitudinum + (finis - initium)
        if elementa_totalia ≻ ELEMENTA_LIMES {
            throw variant LimitesMala {message = "total element count above ceiling"}
        }
        # The validated tensor enters the manifest descriptor table (the
        # schema-2 per-tensor record; header order preserved).
        descripta.append(capsula.SafetensorsTensorDescriptor {name = nomen, dtype = typo, shape = forma, start = initium, end = finis, elements = elementa})
    }
    # pairwise overlap — intervals must not intersect (O(n²), n ≤ 16).
    for range 0‥n const i {
        for range 0‥n const j {
            if i ≠ j {
                const int ai ← st.initii.get(i) coalesce (-1)
                const int bi ← st.end.get(i) coalesce (-1)
                const int aj ← st.initii.get(j) coalesce (-1)
                const int bj ← st.end.get(j) coalesce (-1)
                if bi ≻ aj and bj ≻ ai {
                    throw variant OffscetaMala {message = "overlapping tensor data regions"}
                }
            }
        }
    }
    # exact tiling: non-overlapping intervals with total length == data
    # region length within [0, data_len] cover the region exactly.
    if sum_longitudinum ≠ data_longitudo {
        throw variant OffscetaMala {message = "data region does not tile exactly"}
    }

    # -- capsule construction (the schema-2 admission target, C8) --------
    # The capsule carries the pathless content identity (host-computed
    # digest claim, form-validated above) plus the Safetensors manifest
    # (format/version + header metadata + per-tensor descriptors). semita
    # never enters the capsule — schema 2 has no path.
    do {
        const artifact.ContentIdentity identitas ← artifact.ContentIdentity {algorithm = DIGESTUM_SHA256, digest = digestio, length = corpus.length()}
        const capsula.SafetensorsManifest manifestum ← capsula.SafetensorsManifest {format = ROW_FORMAT_NOMEN, version = ROW_FORMAT_VERSIO, artifact_length = corpus.length(), data_length = data_longitudo, metadata = _metadata(st.meta_claves, st.meta_valores), tensors = descripta}
        const capsula.Capsule c ← capsula.construct_manifest(capsula.schema_versio, identitas, capsula.safetensors_manifest(manifestum))
        return c
    }
    catch err {
        throw variant IngressioMala {message = "capsule admission rejected: " + capsula.message(err)}
    }
}
