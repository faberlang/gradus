+++
locale = "en"
+++
# Co-located package test for the typed-assembly `load` admit (dense-typed-
# assembly unit 4 gate). Not importable; discovered only by the faber test
# path.
#
# Proves, at execution level (package MIR link + FMIR runner):
#   * `dense.load<16, 8, 16, 8, 16>(cfg, source)` — the public size-generic
#     namespace call with explicit literal sizes — links through package MIR
#     (the namespace-call type-argument forward, radix PAF-NS-002 burn-down)
#     and runs: the resolver's canonical tensors pin into a
#     DenseModel<16, 8, 16, 8, 16> with both layers materialized.
#
# The synthetic fixture geometry (T=2 unused by load; D=16, V=8, Q=16, K=8,
# F=16) mirrors src/model/dense.proba's synthetic config; weights are zero
# blocks because this row proves execution and pinning, not numerics.

import from "gradus:model/dense" dense
import from "gradus:tensor" tensor

import from "gradus:test_util" test_util

# Staged zero block of an exact shape (the dense.proba `tene` posture).
fn tene0(list<f32> data, list<int> shape) → tensor.NumericBlock {
    return test_util.or_default(() → tensor.NumericBlock ⇥ tensor.TensorError ∴ tensor.construct(data, shape), tensor.default())
}

fn zeros(list<int> shape) → tensor.NumericBlock {
    var int n ← 1
    for range 0‥shape.length() const i {
        n ← n * (shape.get(i) coalesce 1)
    }
    var list<f32> data ← empty
    for range 0‥n const i {
        data.append((0.0 ∷ f32))
    }
    return tene0(data, shape)
}

fn _ends_with(string name, string suffix) → bool {
    if suffix.length() ≻ name.length() then return false
    return name.slice(name.length() - suffix.length(), name.length()) ≡ suffix
}

# Zero resolver: canonical name → zero block of the config-pinned shape
# (layers=2, heads=4, kv_heads=2, head_dim=4, hidden=16, vocab=8, tied).
# Non-canonical names (the bias probes) fail closed with MissingTensor.
fn _repertor_zero(string name, int layer) → tensor.NumericBlock ⇥ dense.DenseError {
    if name ≡ "model.embed_tokens" then return zeros([16, 8])
    if _ends_with(name, ".input_layernorm") then return zeros([16])
    if _ends_with(name, ".self_attn.q_proj") then return zeros([16, 16])
    if _ends_with(name, ".self_attn.k_proj") then return zeros([16, 8])
    if _ends_with(name, ".self_attn.v_proj") then return zeros([16, 8])
    if _ends_with(name, ".self_attn.o_proj") then return zeros([16, 16])
    if _ends_with(name, ".post_attention_layernorm") then return zeros([16])
    if _ends_with(name, ".mlp.gate_proj") then return zeros([16, 16])
    if _ends_with(name, ".mlp.up_proj") then return zeros([16, 16])
    if _ends_with(name, ".mlp.down_proj") then return zeros([16, 16])
    if name ≡ "model.norm" then return zeros([16])
    throw variant MissingTensor { message = "canonical tensor missing: §"(name) }
}

describe "dense-typed-assembly unit 4 — load runs through package MIR" {
    test "dense.load<16, 8, 16, 8, 16> pins the resolver into a DenseModel and runs" {
        do {
            const dense.DenseModel<16, 8, 16, 8, 16> m ← dense.load<16, 8, 16, 8, 16>(dense.DenseConfig { layers = 2, heads = 4, kv_heads = 2, head_dim = 4, hidden_dim = 16, vocab = 8, tied = true }, (string n, int s) → tensor.NumericBlock ⇥ dense.DenseError ∴ _repertor_zero(n, s))
            assert m.layers.length() ≡ 2
            assert m.embed.shape ≡ ([16, 8] ↦ list<int>)
        }
        catch err {
            assert false
        }
    }
}
