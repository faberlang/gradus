# GGUF row admission — the selected GGUF row parses → schema-2 capsule
# (PML2-U3, capsule-schema-2.0.0, A1C-M2).
#
# Public import: importa ex "gradus:model/gguf" privata gguf
# Depends on: gradus:model/capsule (capsule-schema-2.0.0, PML2-U1),
#             gradus:model/gguf_manifest (the one GGUF wire authority, A1b),
#             gradus:model/artifact (pathless content identity).
#
# --- Contract ------------------------------------------------------------
#
# One admitted GGUF row: SmolLM2-360M-Instruct-Q4_K_M (bartowski imatrix
# quant, llama.cpp b3772) — the pinned row of gi0-model-contract v1.0.0 /
# gi1-closeout.md (read-only facts, cited below). The row parses → a
# fail-closed capsule with rejection on the pinned one-row contract.
#
# D3 clean break (A1C-M2): the schema-1 wire parser (byte readers,
# admitted-key predicate, block-layout helpers) is DELETED. `admit` is a
# thin wrapper over gradus:model/gguf_manifest — it inspects
# the header/metadata/tensor table through `manifestum.inspice` over a
# caller-owned byte range and validates the pinned one-row contract
# through manifest accessors (`textum`/`numerum`/`metadatum`, the carried
# metadata/tensor descriptors). No alias, no forwarding import, no
# compatibility parser remains.
#
# Fail-closed dimensions, by owner:
#   manifestum (the wire authority): magic, GGUF version, count ceilings,
#       duplicate keys/tensor names, value wire kinds, UTF-8, string/key
#       ceilings, tensor rank/dim bounds, GGML block layout, tensor range
#       overlap, identity-form checks.
#   this module (the pinned row): expected counts (KV/tensor/element and
#       the exact per-type tensor counts F32 65 / Q4_K 16 / Q5_0 176 /
#       Q6_K 16 / Q8_0 17), the admitted 37-key metadata set (an unknown
#       key fails closed), the 15 required keys, the pinned metadata
#       VALUES (architecture, file type, quant version, block/context/
#       vocab/embedding counts, tokenizer model/pre/ids/bools), tensor
#       rank/shape ceilings and offsets, and the exact data-region tiling
#       (coverage_ok).
#
# The whole-file SHA-256 is computed by the admission host (pure-Rust, per
# capsule.fab) and passed in; this module builds the schema-2 capsule,
# which validates the digest form and carries the pathless content
# identity. Raw bytes are never a trust anchor — only the capsule carries
# identity (capsule-schema-2.0.0, C8).
#
# One-row boundary (gi1 exit-gate bullet 5): the constants below pin the
# selected row only; a wider admission is a row-contract change. Scaled
# structural fixtures exercise the RULES (same posture as capsule.proba);
# the pinned values exercise the row. No runtime claim is generalized
# beyond the selected row.
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * The manifest authority's names are not yet annotated @ publica
#     (gguf_manifest.fab is read-only for A1C), so this module's helpers
#     that name manifestum types (GgufManifestError, LectioFontis,
#     MetadatumGguf, ManifestumGguf) and call non-public accessors surface
#     SEM006.import_module_private (strict single-file) / WARN014
#     (file-interface export skipped) — the recorded A1C seam (see
#     capsule.fab header); the aggregate A1C-M8 gate owns the closeout.
#   * Proba proof is compile-level until the FMIR stepper / faber test
#     path covers library probas (capsule.fab residual); `faber check`
#     proves the whole surface type-checks.
#   * Public signatures stay on primitives plus capsula.Capsula and this
#     module's own GgufError so the proba file-interface keeps every
#     export (WARN014 — same seam as capsule.fab U1).
#
# --- Seams ---------------------------------------------------------------
#   * tokenizer probe parity (P1–P11, workload id lists) — PML2-U4.
#   * negative-matrix conformance suite across U2/U3/U4 — PML2-U6.
#   * norma:model + GI1 admission migration (no dual authority) — PML2-U5.
#   * digest computation — the admission host (pure-Rust, GI1).

importa ex "gradus:model/artifact" artifact
importa ex "gradus:model/capsule" capsula
importa ex "gradus:model/gguf_manifest" manifestum

# -------------------------------------------------------------------------
# Row contract — pinned constants. Row facts mirror gi0-model-contract
# v1.0.0 (§1–§5) and gi1-closeout.md exit-gate bullets 2/4/6; the GGML
# type ids are pinned to the toolchain table (same ids the manifestum
# authority resolves).
# -------------------------------------------------------------------------

# --- format / version ----------------------------------------------------
fixum numerus CONCORDATIO ← 32
# GGUF_DEFAULT_ALIGNMENT.
fixum numerus FILE_TYPE ← 15
# general.file_type (MOSTLY_Q4_K_M).
fixum numerus QUANTIZATIO_VERSION ← 2
# general.quantization_version.

# --- GGML type ids (pinned toolchain ggml.h, llama.cpp a957b7747) --------
fixum numerus GGML_F32 ← 0
fixum numerus GGML_Q5_0 ← 6
fixum numerus GGML_Q8_0 ← 8
fixum numerus GGML_Q4_K ← 12
fixum numerus GGML_Q6_K ← 14

# --- architecture facts (gi0-model-contract §2) --------------------------
fixum textus ARCHITECTURA ← "llama"
fixum numerus STRATA ← 32
# llama.block_count.
fixum numerus CONTEXTUS ← 8192
# llama.context_length.
fixum numerus VOCABULUM ← 49152
# llama.vocab_size.
fixum numerus EMBEDDING ← 960
# llama.embedding_length.

# --- tokenizer facts (gi0-model-contract §4) -----------------------------
fixum textus TOKENIZATOR_MODEL ← "gpt2"
fixum textus TOKENIZATOR_PRE ← "smollm"
fixum numerus BOS_ID ← 1
fixum numerus EOS_ID ← 2
fixum numerus PAD_ID ← 2
fixum numerus UNK_ID ← 0

# --- library hard ceilings (mirror capsule.fab / gradus:shape U3) --------
fixum numerus DIMENSI_LIMES ← 65536
fixum numerus ELEMENTA_LIMES ← 1000000000
fixum numerus NOMEN_LIMES ← 128
fixum numerus KV_LIMES ← 4096
# metadata KV count ceiling.
fixum numerus TENSORUM_LIMES ← 65536
# tensor count ceiling.

# -------------------------------------------------------------------------
# GgufError — typed error vocabulary of the GGUF admission boundary. Every
# variant carries a textus causa (render via causa). Variant → dimension:
#   FormatMala       — bad magic (not a GGUF file).
#   VersioIgnota     — unsupported GGUF file version.
#   ArchitecturaMala — architecture facts (arch id, layers, context,
#                      vocab, embedding).
#   QuantizatioIgnota— dtype/quantization: file type, quant version, ggml
#                      type, block layout, per-type tensor counts.
#   OffsetMala       — tensor offsets / data-region tiling (coverage).
#   FormaMala        — shapes: rank, dims, total element count.
#   TokenizerMala    — tokenizer identity facts.
#   LimitesMala      — count ceilings (kv/tensor/element, key length).
#   WireMala         — malformed bytes: truncation, unknown/duplicate
#                      keys or tensor names, string ceilings, overflow.
#   CapsulaMala      — capsule construction failed.
#
# Wire/format rejections detected by the manifestum authority surface as
# WireMala carrying the authority's typed causa (rendered verbatim), per
# the A1C one-authority boundary.
# -------------------------------------------------------------------------

discretio GgufError {
    FormatMala { textus causa },
    VersioIgnota { textus causa },
    ArchitecturaMala { textus causa },
    QuantizatioIgnota { textus causa },
    OffsetMala { textus causa },
    FormaMala { textus causa },
    TokenizerMala { textus causa },
    LimitesMala { textus causa },
    WireMala { textus causa },
    CapsulaMala { textus causa }
}

functio causa(GgufError e) → textus {
    discerne e {
        casu FormatMala fixum causa { redde causa }
        casu VersioIgnota fixum causa { redde causa }
        casu ArchitecturaMala fixum causa { redde causa }
        casu QuantizatioIgnota fixum causa { redde causa }
        casu OffsetMala fixum causa { redde causa }
        casu FormaMala fixum causa { redde causa }
        casu TokenizerMala fixum causa { redde causa }
        casu LimitesMala fixum causa { redde causa }
        casu WireMala fixum causa { redde causa }
        casu CapsulaMala fixum causa { redde causa }
    }
}

# -------------------------------------------------------------------------
# Private helpers over the manifestum authority. The range source slices
# the caller-owned bytes; the accessor wrappers map the authority's typed
# GgufManifestError into this module's GgufError vocabulary. None of these
# helpers parse wire bytes — the manifestum authority already validated
# them during inspice.
# -------------------------------------------------------------------------

# Range source over the supplied byte list (the caller-owned corpus). A
# read beyond the bytes fails the read; the manifestum authority turns the
# failure into a typed FonsMala.
@ privata
functio _fons(lista<numerus<u8>> b, numerus initium, numerus longitudo) → manifestum.LectioFontis {
    si initium < 0 aut longitudo < 0 aut initium > b.longitudo() - longitudo {
        redde manifestum.LectioFontis { successus = falsum, bytes = ||, causa = "range read beyond the supplied bytes" }
    }
    fixum lista<numerus<u8>> segmentum ← b.sectio(initium, initium + longitudo)
    fixum octeti bytes_o ← segmentum ↦ octeti
    redde manifestum.LectioFontis { successus = verum, bytes = bytes_o, causa = "" }
}

# Map the authority's typed error into this module's vocabulary, preserving
# its causa (rendered verbatim by the authority's own renderer).
@ privata
functio _errorem_manifesti(manifestum.GgufManifestError e) → GgufError {
    redde finge WireMala { causa = manifestum.causa(e) }
}

# Inspect the header/metadata/tensor-table corpus via the authority.
@ privata
functio _inspice(lista<numerus<u8>> b, artifact.IdentitasContenuti identitas) → manifestum.ManifestumGguf ⇥ GgufError {
    fac {
        redde manifestum.inspice(
            (numerus initium, numerus longitudo) → manifestum.LectioFontis ∴ _fons(b, initium, longitudo),
            b.longitudo(),
            identitas
        )
    }
    cape err {
        iace _errorem_manifesti(err)
    }
    iace finge WireMala { causa = "unreachable" }
}

# String metadata accessor, authority-mapped.
@ privata
functio _textus_pacta(manifestum.ManifestumGguf m, textus clavis) → textus ⇥ GgufError {
    fac {
        fixum textus v ← manifestum.textum(m, clavis)
        redde v
    }
    cape err {
        iace _errorem_manifesti(err)
    }
    iace finge WireMala { causa = "unreachable" }
}

# Integer metadata accessor, authority-mapped.
@ privata
functio _numerus_pacta(manifestum.ManifestumGguf m, textus clavis) → numerus ⇥ GgufError {
    fac {
        fixum numerus v ← manifestum.numerum(m, clavis)
        redde v
    }
    cape err {
        iace _errorem_manifesti(err)
    }
    iace finge WireMala { causa = "unreachable" }
}

# BOOL metadata value (the authority has no integer accessor for the BOOL
# wire kind; the carried value's first byte is the validated 0/1).
@ privata
functio _bivalens_pacta(manifestum.ManifestumGguf m, textus clavis) → numerus ⇥ GgufError {
    varia manifestum.MetadatumGguf md ← manifestum.MetadatumGguf { clavis = "", typo = -1, valor_wire = || }
    fac {
        md ← manifestum.metadatum(m, clavis)
    }
    cape err {
        iace _errorem_manifesti(err)
    }
    fixum octeti wire ← md.valor_wire
    si wire.longitudo() < 1 {
        iace finge WireMala { causa = "malformed bool value" }
    }
    fixum numerus v ← (wire.accipe(0) vel (0 ∷ numerus<u8>)) ↦ numerus
    redde v
}

# List membership (textus).
@ privata
functio _continet(lista<textus> xs, textus x) → bivalens {
    varia numerus i ← 0
    dum i < xs.longitudo() {
        si (xs.accipe(i) vel "") ≡ x ergo redde verum
        i ← i + 1
    }
    redde falsum
}

# The admitted metadata KEY SET is pinned (the 37 keys of the pinned row,
# gi0 evidence contract-gguf-metadata.txt): a key outside it fails closed.
# A pure predicate over carried metadata keys — no wire parsing.
@ privata
functio _clavis_pacta(textus k) → bivalens {
    si k ≡ "general.architecture" ergo redde verum
    si k ≡ "general.basename" ergo redde verum
    si k ≡ "general.file_type" ergo redde verum
    si k ≡ "general.finetune" ergo redde verum
    si k ≡ "general.languages" ergo redde verum
    si k ≡ "general.license" ergo redde verum
    si k ≡ "general.name" ergo redde verum
    si k ≡ "general.organization" ergo redde verum
    si k ≡ "general.quantization_version" ergo redde verum
    si k ≡ "general.size_label" ergo redde verum
    si k ≡ "general.type" ergo redde verum
    si k ≡ "llama.attention.head_count" ergo redde verum
    si k ≡ "llama.attention.head_count_kv" ergo redde verum
    si k ≡ "llama.attention.layer_norm_rms_epsilon" ergo redde verum
    si k ≡ "llama.block_count" ergo redde verum
    si k ≡ "llama.context_length" ergo redde verum
    si k ≡ "llama.embedding_length" ergo redde verum
    si k ≡ "llama.feed_forward_length" ergo redde verum
    si k ≡ "llama.rope.dimension_count" ergo redde verum
    si k ≡ "llama.rope.freq_base" ergo redde verum
    si k ≡ "llama.vocab_size" ergo redde verum
    si k ≡ "quantize.imatrix.chunks_count" ergo redde verum
    si k ≡ "quantize.imatrix.dataset" ergo redde verum
    si k ≡ "quantize.imatrix.entries_count" ergo redde verum
    si k ≡ "quantize.imatrix.file" ergo redde verum
    si k ≡ "tokenizer.chat_template" ergo redde verum
    si k ≡ "tokenizer.ggml.add_bos_token" ergo redde verum
    si k ≡ "tokenizer.ggml.add_space_prefix" ergo redde verum
    si k ≡ "tokenizer.ggml.bos_token_id" ergo redde verum
    si k ≡ "tokenizer.ggml.eos_token_id" ergo redde verum
    si k ≡ "tokenizer.ggml.merges" ergo redde verum
    si k ≡ "tokenizer.ggml.model" ergo redde verum
    si k ≡ "tokenizer.ggml.padding_token_id" ergo redde verum
    si k ≡ "tokenizer.ggml.pre" ergo redde verum
    si k ≡ "tokenizer.ggml.token_type" ergo redde verum
    si k ≡ "tokenizer.ggml.tokens" ergo redde verum
    si k ≡ "tokenizer.ggml.unknown_token_id" ergo redde verum
    redde falsum
}

# -------------------------------------------------------------------------
# admit — the fail-closed GGUF admission. A thin schema-2 wrapper (D3):
# inspects the header/metadata/tensor-table corpus through the manifestum
# authority, validates the pinned one-row contract through manifest
# accessors, and builds the schema-2 capsule. Every count is ceilings-
# checked BEFORE the authority is invoked; the whole-file SHA-256 is
# host-computed and passed in as the pathless content identity.
# -------------------------------------------------------------------------

functio admit(
    lista<numerus<u8>> bytes,
    textus digestio,
    numerus expectatum_kv,
    numerus expectatum_tensorum,
    numerus expectatum_elementa,
    numerus expectatum_f32,
    numerus expectatum_q4k,
    numerus expectatum_q5,
    numerus expectatum_q6,
    numerus expectatum_q8
) → capsula.Capsula ⇥ GgufError {
    # --- ceilings before any count-driven iteration (fail closed) --------
    si expectatum_kv < 1 aut expectatum_kv > KV_LIMES {
        iace finge LimitesMala { causa = "expected kv count outside the admitted range" }
    }
    si expectatum_tensorum < 1 aut expectatum_tensorum > TENSORUM_LIMES {
        iace finge LimitesMala { causa = "expected tensor count outside the admitted range" }
    }
    si expectatum_elementa < 1 aut expectatum_elementa > ELEMENTA_LIMES {
        iace finge LimitesMala { causa = "expected element count outside the admitted range" }
    }
    si expectatum_f32 < 0 aut expectatum_q4k < 0 aut expectatum_q5 < 0 aut expectatum_q6 < 0 aut expectatum_q8 < 0 {
        iace finge LimitesMala { causa = "expected tensor type counts outside the admitted range" }
    }
    si expectatum_f32 + expectatum_q4k + expectatum_q5 + expectatum_q6 + expectatum_q8 ≠ expectatum_tensorum {
        iace finge LimitesMala { causa = "expected tensor type counts do not sum to the tensor count" }
    }

    # --- format guard (truncated header) before the authority -------------
    si bytes.longitudo() < 24 {
        iace finge WireMala { causa = "truncated gguf header" }
    }

    # --- inspect the header/metadata/tensor-table via the authority -------
    fixum artifact.IdentitasContenuti identitas ← artifact.IdentitasContenuti {
        algorithmus = "sha-256",
        digestio = digestio,
        longitudo = bytes.longitudo()
    }
    fixum manifestum.ManifestumGguf m ← _inspice(bytes, identitas)

    # --- counts (the pinned one-row contract) -----------------------------
    si m.tensores.longitudo() ≠ expectatum_tensorum {
        iace finge LimitesMala { causa = "tensor count mismatch" }
    }
    si m.metadata.longitudo() ≠ expectatum_kv {
        iace finge LimitesMala { causa = "metadata KV count mismatch" }
    }

    # --- admitted metadata key set + required keys (fail closed) ----------
    varia lista<textus> claves ← vacua
    itera ex m.metadata fixum md {
        si md.clavis.longitudo() > NOMEN_LIMES {
            iace finge LimitesMala { causa = "metadata key exceeds the 128-byte ceiling" }
        }
        si non (_clavis_pacta(md.clavis)) {
            iace finge WireMala { causa = "unknown metadata key" }
        }
        claves.appende(md.clavis)
    }
    si non (_continet(claves, "general.architecture")) {
        iace finge ArchitecturaMala { causa = "missing required metadata key: general.architecture" }
    }
    si non (_continet(claves, "general.file_type")) {
        iace finge QuantizatioIgnota { causa = "missing required metadata key: general.file_type" }
    }
    si non (_continet(claves, "general.quantization_version")) {
        iace finge QuantizatioIgnota { causa = "missing required metadata key: general.quantization_version" }
    }
    si non (_continet(claves, "llama.block_count")) {
        iace finge ArchitecturaMala { causa = "missing required metadata key: llama.block_count" }
    }
    si non (_continet(claves, "llama.context_length")) {
        iace finge ArchitecturaMala { causa = "missing required metadata key: llama.context_length" }
    }
    si non (_continet(claves, "llama.vocab_size")) {
        iace finge ArchitecturaMala { causa = "missing required metadata key: llama.vocab_size" }
    }
    si non (_continet(claves, "llama.embedding_length")) {
        iace finge ArchitecturaMala { causa = "missing required metadata key: llama.embedding_length" }
    }
    si non (_continet(claves, "tokenizer.ggml.model")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.model" }
    }
    si non (_continet(claves, "tokenizer.ggml.pre")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.pre" }
    }
    si non (_continet(claves, "tokenizer.ggml.bos_token_id")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.bos_token_id" }
    }
    si non (_continet(claves, "tokenizer.ggml.eos_token_id")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.eos_token_id" }
    }
    si non (_continet(claves, "tokenizer.ggml.padding_token_id")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.padding_token_id" }
    }
    si non (_continet(claves, "tokenizer.ggml.unknown_token_id")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.unknown_token_id" }
    }
    si non (_continet(claves, "tokenizer.ggml.add_bos_token")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.add_bos_token" }
    }
    si non (_continet(claves, "tokenizer.ggml.add_space_prefix")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.add_space_prefix" }
    }

    # --- pinned required metadata VALUES (through manifest accessors) -----
    si _textus_pacta(m, "general.architecture") ≠ ARCHITECTURA {
        iace finge ArchitecturaMala { causa = "architecture mismatch" }
    }
    si _numerus_pacta(m, "general.file_type") ≠ FILE_TYPE {
        iace finge QuantizatioIgnota { causa = "file type mismatch" }
    }
    si _numerus_pacta(m, "general.quantization_version") ≠ QUANTIZATIO_VERSION {
        iace finge QuantizatioIgnota { causa = "quantization version mismatch" }
    }
    si _numerus_pacta(m, "llama.block_count") ≠ STRATA {
        iace finge ArchitecturaMala { causa = "layer count mismatch" }
    }
    si _numerus_pacta(m, "llama.context_length") ≠ CONTEXTUS {
        iace finge ArchitecturaMala { causa = "context length mismatch" }
    }
    si _numerus_pacta(m, "llama.vocab_size") ≠ VOCABULUM {
        iace finge ArchitecturaMala { causa = "vocabulary size mismatch" }
    }
    si _numerus_pacta(m, "llama.embedding_length") ≠ EMBEDDING {
        iace finge ArchitecturaMala { causa = "embedding size mismatch" }
    }
    si _textus_pacta(m, "tokenizer.ggml.model") ≠ TOKENIZATOR_MODEL {
        iace finge TokenizerMala { causa = "tokenizer model mismatch" }
    }
    si _textus_pacta(m, "tokenizer.ggml.pre") ≠ TOKENIZATOR_PRE {
        iace finge TokenizerMala { causa = "tokenizer pre-tokenizer mismatch" }
    }
    si _numerus_pacta(m, "tokenizer.ggml.bos_token_id") ≠ BOS_ID {
        iace finge TokenizerMala { causa = "bos token id mismatch" }
    }
    si _numerus_pacta(m, "tokenizer.ggml.eos_token_id") ≠ EOS_ID {
        iace finge TokenizerMala { causa = "eos token id mismatch" }
    }
    si _numerus_pacta(m, "tokenizer.ggml.padding_token_id") ≠ PAD_ID {
        iace finge TokenizerMala { causa = "padding token id mismatch" }
    }
    si _numerus_pacta(m, "tokenizer.ggml.unknown_token_id") ≠ UNK_ID {
        iace finge TokenizerMala { causa = "unknown token id mismatch" }
    }
    si _bivalens_pacta(m, "tokenizer.ggml.add_bos_token") ≠ 0 {
        iace finge TokenizerMala { causa = "add_bos_token mismatch" }
    }
    si _bivalens_pacta(m, "tokenizer.ggml.add_space_prefix") ≠ 0 {
        iace finge TokenizerMala { causa = "add_space_prefix mismatch" }
    }

    # --- tensor table (the pinned one-row contract through descriptors) --
    varia numerus tot_elementa ← 0
    varia numerus visi_f32 ← 0
    varia numerus visi_q4k ← 0
    varia numerus visi_q5 ← 0
    varia numerus visi_q6 ← 0
    varia numerus visi_q8 ← 0
    varia numerus cursus_data ← 0
    varia numerus tot_octeti ← 0
    itera ex m.tensores fixum t {
        si t.forma.longitudo() ≠ 1 et t.forma.longitudo() ≠ 2 {
            iace finge FormaMala { causa = "unsupported tensor rank" }
        }
        varia numerus d ← 0
        dum d < t.forma.longitudo() {
            fixum numerus dim ← t.forma.accipe(d) vel 0
            si dim > DIMENSI_LIMES {
                iace finge FormaMala { causa = "invalid tensor dimension" }
            }
            d ← d + 1
        }
        si t.nomen.longitudo() > NOMEN_LIMES {
            iace finge WireMala { causa = "tensor name exceeds the 128-byte ceiling" }
        }
        si t.typo_ggml ≠ GGML_F32 et t.typo_ggml ≠ GGML_Q4_K et t.typo_ggml ≠ GGML_Q5_0 et t.typo_ggml ≠ GGML_Q6_K et t.typo_ggml ≠ GGML_Q8_0 {
            iace finge QuantizatioIgnota { causa = "unknown ggml tensor type" }
        }
        si tot_elementa > expectatum_elementa - t.elementa {
            iace finge FormaMala { causa = "tensor element count above the expected total" }
        }
        tot_elementa ← tot_elementa + t.elementa
        si t.offset_relativum ≠ cursus_data {
            iace finge OffsetMala { causa = "tensor offsets are not contiguous" }
        }
        discerne t.layout {
            casu Cognita fixum elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
                si longitudo_octetorum % CONCORDATIO ≠ 0 {
                    iace finge QuantizatioIgnota { causa = "tensor byte size not a multiple of the 32-byte data alignment" }
                }
                cursus_data ← cursus_data + longitudo_octetorum
                tot_octeti ← tot_octeti + longitudo_octetorum
            }
            casu Ignota fixum typo {
                iace finge QuantizatioIgnota { causa = "unknown ggml tensor layout" }
            }
        }
        si t.typo_ggml ≡ GGML_F32 { visi_f32 ← visi_f32 + 1 }
        si t.typo_ggml ≡ GGML_Q4_K { visi_q4k ← visi_q4k + 1 }
        si t.typo_ggml ≡ GGML_Q5_0 { visi_q5 ← visi_q5 + 1 }
        si t.typo_ggml ≡ GGML_Q6_K { visi_q6 ← visi_q6 + 1 }
        si t.typo_ggml ≡ GGML_Q8_0 { visi_q8 ← visi_q8 + 1 }
    }

    # --- exact row facts --------------------------------------------------
    si tot_elementa ≠ expectatum_elementa {
        iace finge FormaMala { causa = "total element count mismatch" }
    }
    si visi_f32 ≠ expectatum_f32 aut visi_q4k ≠ expectatum_q4k aut visi_q5 ≠ expectatum_q5 aut visi_q6 ≠ expectatum_q6 aut visi_q8 ≠ expectatum_q8 {
        iace finge QuantizatioIgnota { causa = "tensor type count mismatch" }
    }

    # --- data region: exact tiling to EOF (coverage_ok) -------------------
    si tot_octeti ≠ m.longitudo_artifacti - m.data_inceptum {
        iace finge OffsetMala { causa = "data region does not tile exactly" }
    }

    # --- capsule construction (capsule-schema-2.0.0, A1C-M1) --------------
    fac {
        fixum capsula.Capsula c ← capsula.structa_manifestum(
            capsula.schema_versio,
            m.identitas,
            capsula.manifestum_gguf(m)
        )
        redde c
    }
    cape err {
        iace finge CapsulaMala { causa = "capsule construction failed: " + capsula.causa(err) }
    }
    iace finge CapsulaMala { causa = "unreachable" }
}
