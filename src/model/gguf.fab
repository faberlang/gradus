# GGUF row admission — the selected GGUF row parses → capsule (PML2-U3).
#
# Public import: importa ex "gradus:model/gguf" privata gguf
# Depends on: gradus:model/capsule (PML2-U1, capsule-schema-1.0.0).
#
# --- Contract ------------------------------------------------------------
#
# One admitted GGUF row: SmolLM2-360M-Instruct-Q4_K_M (bartowski imatrix
# quant, llama.cpp b3772) — the pinned row of gi0-model-contract v1.0.0 /
# gi1-closeout.md (read-only facts, cited below). The row parses → a
# fail-closed capsule with rejection on the full dimension set: format,
# version, architecture, dtype/quantization, offsets, shapes, tokenizer.
#
# Byte-level facts (pinned toolchain llama.cpp a957b7747 / gguf-py — the
# readers the pinned facts were derived with):
#   header:  "GGUF" magic | u32 version | u64 tensor_count | u64 kv_count
#   metadata: repeated — string key (u64 len + bytes) | u32 gguf_value_type
#            | value; scalars fixed-width LE, strings u64-len prefixed,
#            arrays u32 elem_type + u64 count + elements
#   tensor table: repeated — string name | u32 n_dims | dims (u64 ×
#            n_dims) | u32 ggml_type | u64 offset
#   data: begins at align32(end of table); each tensor's stored offset is
#            RELATIVE to the data-section start and must equal the
#            cumulative byte size of the preceding tensors (llama.cpp
#            reader check `ti.offset == ctx->size`; gguf-py data_offset).
#   GGML type ids (pinned toolchain): F32 0, Q5_0 6, Q8_0 8, Q4_K 12,
#            Q6_K 14. GGUF value types: UINT8 0 … FLOAT64 12.
#   alignment: GGUF_DEFAULT_ALIGNMENT = 32; the pinned row's tensor byte
#            sizes are all 32-multiples (gi1-closeout residual), so the
#            data region tiles exactly with no per-tensor padding.
#
# Fail-closed dimensions (each → typed GgufError):
#   format          bad magic → FormatMala
#   version         GGUF version ≠ 3 → VersioIgnota; file_type ≠ 15 and
#                   quantization_version ≠ 2 → QuantizatioIgnota
#   architecture    general.architecture ≠ "llama", block_count ≠ 32,
#                   context_length ≠ 8192, vocab_size ≠ 49152,
#                   embedding_length ≠ 960 → ArchitecturaMala
#   dtype/quant     tensor ggml_type outside {F32, Q5_0, Q8_0, Q4_K, Q6_K},
#                   non-block-multiple element count, or byte size not a
#                   32-multiple → QuantizatioIgnota; the exact per-type
#                   tensor counts (F32 65 / Q4_K 16 / Q5_0 176 / Q6_K 16 /
#                   Q8_0 17) must match the admitted contract
#   offsets         tensor offset ≠ the running cumulative size (out-of-
#                   order / overlapping / duplicate) → OffsetMala; the
#                   data region must tile exactly to EOF (coverage_ok)
#   shapes          n_dims ∉ {1,2}, dim < 1 or > 65536, or total elements
#                   ≠ the admitted count → FormaMala
#   tokenizer       tokenizer.ggml.model ≠ "gpt2", pre ≠ "smollm",
#                   bos/eos/pad/unk ids or add_bos/add_space_prefix
#                   mismatch → TokenizerMala
#   bounds/counts   kv/tensor counts ≠ the expected contract, key > 128 B,
#                   name > 128 B, string > 4096 B, array count / kv /
#                   tensor / element ceilings, u64 field above the integer
#                   carrier → LimitesMala / WireMala
#
# The admitted metadata KEY SET is pinned (the 37 keys of the pinned row):
# an unknown key fails closed. Required-key VALUES are pinned (identity-
# bearing). Optional-key values are consumed but not pinned (provenance —
# the whole-file digest binds them).
#
# The whole-file SHA-256 and the vocab digest are computed by the admission
# host (pure-Rust, per capsule.fab) and passed in; this module validates
# the parsed structure and builds the capsule, which validates the digest
# form. Raw bytes are never a trust anchor — only the capsule carries
# identity (capsule-schema-1.0.0, C8).
#
# One-row boundary (gi1 exit-gate bullet 5): the constants below pin the
# selected row only; a wider admission is a row-contract change. Scaled
# structural fixtures exercise the RULES (same posture as capsule.proba);
# the pinned values exercise the row. No runtime claim is generalized
# beyond the selected row.
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * Digest computation is host-side (no digest primitive in the
#     language); this module validates the digest claim's form via the
#     capsule constructor.
#   * Proba proof is compile-level until the FMIR stepper / faber test
#     path covers library probas (capsule.fab residual); `faber check`
#     proves the whole surface type-checks.
#   * Public signatures stay on primitives plus capsula.Capsula and this
#     module's own GgufError so the proba file-interface keeps every
#     export (WARN014 — same seam as capsule.fab U1).
#
# --- Seams ---------------------------------------------------------------
#   * tokenizer probe parity (P1–P11, workload id lists) — PML2-U4.
#   * negative-matrix conformance suite across U2/U3/U4 — PML2-U6.
#   * norma:model + GI1 admission migration (no dual authority) — PML2-U5.
#   * digest computation — the admission host (pure-Rust, GI1).

importa ex "gradus:model/capsule" capsula

# -------------------------------------------------------------------------
# Row contract — pinned constants. Byte/layout constants mirror the pinned
# toolchain; row facts mirror gi0-model-contract v1.0.0 (§1–§5) and
# gi1-closeout.md exit-gate bullets 2/4/6.
# -------------------------------------------------------------------------

# Capsule schema this module's output conforms to (capsule-schema-1.0.0).
fixum textus CAPSULA_SCHEMA ← "1.0.0"

# --- format / version ----------------------------------------------------
fixum numerus MAGIC_0 ← 0x47
fixum numerus MAGIC_1 ← 0x47
fixum numerus MAGIC_2 ← 0x55
fixum numerus MAGIC_3 ← 0x46
fixum numerus GGUF_VERSION ← 3
fixum numerus CONCORDATIO ← 32
# GGUF_DEFAULT_ALIGNMENT.
fixum numerus FILE_TYPE ← 15
# general.file_type (MOSTLY_Q4_K_M).
fixum numerus QUANTIZATIO_VERSION ← 2
# general.quantization_version.

# --- GGUF value types (gguf.h enum gguf_type) ----------------------------
fixum numerus GGUF_UINT8 ← 0
fixum numerus GGUF_INT8 ← 1
fixum numerus GGUF_UINT16 ← 2
fixum numerus GGUF_INT16 ← 3
fixum numerus GGUF_UINT32 ← 4
fixum numerus GGUF_INT32 ← 5
fixum numerus GGUF_FLOAT32 ← 6
fixum numerus GGUF_BOOL ← 7
fixum numerus GGUF_STRING ← 8
fixum numerus GGUF_ARRAY ← 9
fixum numerus GGUF_UINT64 ← 10
fixum numerus GGUF_INT64 ← 11
fixum numerus GGUF_FLOAT64 ← 12

# --- GGML type ids (pinned toolchain ggml.h, llama.cpp a957b7747) --------
fixum numerus GGML_F32 ← 0
fixum numerus GGML_Q5_0 ← 6
fixum numerus GGML_Q8_0 ← 8
fixum numerus GGML_Q4_K ← 12
fixum numerus GGML_Q6_K ← 14

# --- GGML block layout (pinned ggml-common.h / gi0-model-contract §3) ----
fixum numerus F32_ELEMENTA ← 1
fixum numerus F32_OCTETI ← 4
fixum numerus Q5_0_ELEMENTA ← 32
fixum numerus Q5_0_OCTETI ← 22
fixum numerus Q8_0_ELEMENTA ← 32
fixum numerus Q8_0_OCTETI ← 34
fixum numerus Q4_K_ELEMENTA ← 256
fixum numerus Q4_K_OCTETI ← 144
fixum numerus Q6_K_ELEMENTA ← 256
fixum numerus Q6_K_OCTETI ← 210

# --- architecture facts (gi0-model-contract §2) --------------------------
fixum textus ARCHITECTURA ← "llama"
fixum numerus STRATA ← 32
# llama.block_count.
fixum numerus CONTEXTUS ← 8192
# llama.context_length.
fixum numerus VOCABULUM ← 49152
# llama.vocab_size.
fixum numerus EMBEDDING ← 960
# llama.embedding_length.

# --- tokenizer facts (gi0-model-contract §4) -----------------------------
fixum textus TOKENIZATOR_MODEL ← "gpt2"
fixum textus TOKENIZATOR_PRE ← "smollm"
fixum numerus BOS_ID ← 1
fixum numerus EOS_ID ← 2
fixum numerus PAD_ID ← 2
fixum numerus UNK_ID ← 0

# --- library hard ceilings (mirror capsule.fab / gradus:shape U3) --------
fixum numerus DIMENSI_LIMES ← 65536
fixum numerus ELEMENTA_LIMES ← 1000000000
fixum numerus NOMEN_LIMES ← 128
fixum numerus TEXTUS_LIMES ← 4096
fixum numerus KV_LIMES ← 4096
# metadata KV count ceiling.
fixum numerus TENSORUM_LIMES ← 65536
# tensor count ceiling.
fixum numerus ARRAY_LIMES ← 262144
# metadata array element ceiling.

# -------------------------------------------------------------------------
# GgufError — typed error vocabulary of the GGUF admission boundary. Every
# variant carries a textus causa (render via causa). Variant → dimension:
#   FormatMala       — bad magic (not a GGUF file).
#   VersioIgnota     — unsupported GGUF file version.
#   ArchitecturaMala — architecture facts (arch id, layers, context,
#                      vocab, embedding).
#   QuantizatioIgnota— dtype/quantization: file type, quant version, ggml
#                      type, block layout, per-type tensor counts.
#   OffsetMala       — tensor offsets / data-region tiling (coverage).
#   FormaMala        — shapes: rank, dims, total element count.
#   TokenizerMala    — tokenizer identity facts.
#   LimitesMala      — count ceilings (kv/tensor/element, key length).
#   WireMala         — malformed bytes: truncation, unknown/duplicate
#                      keys or tensor names, string ceilings, overflow.
#   CapsulaMala      — capsule construction failed.
# -------------------------------------------------------------------------

discretio GgufError {
    FormatMala { textus causa },
    VersioIgnota { textus causa },
    ArchitecturaMala { textus causa },
    QuantizatioIgnota { textus causa },
    OffsetMala { textus causa },
    FormaMala { textus causa },
    TokenizerMala { textus causa },
    LimitesMala { textus causa },
    WireMala { textus causa },
    CapsulaMala { textus causa }
}

functio causa(GgufError e) → textus {
    discerne e {
        casu FormatMala fixum causa { redde causa }
        casu VersioIgnota fixum causa { redde causa }
        casu ArchitecturaMala fixum causa { redde causa }
        casu QuantizatioIgnota fixum causa { redde causa }
        casu OffsetMala fixum causa { redde causa }
        casu FormaMala fixum causa { redde causa }
        casu TokenizerMala fixum causa { redde causa }
        casu LimitesMala fixum causa { redde causa }
        casu WireMala fixum causa { redde causa }
        casu CapsulaMala fixum causa { redde causa }
    }
}

# -------------------------------------------------------------------------
# Private byte readers (little-endian; every read bounds-checked; u64
# fields reject a top byte ≥ 0x80 — a value ≥ 2^63 is above the carrier).
# -------------------------------------------------------------------------

# u32 little-endian at off.
@ privata
functio _legere_u32(lista<numerus<u8>> b, numerus off) → numerus ⇥ GgufError {
    si off + 4 > b.longitudo() {
        iace finge WireMala { causa = "truncated gguf field" }
    }
    fixum numerus r0 ← (b.accipe(off + 0) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r1 ← (b.accipe(off + 1) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r2 ← (b.accipe(off + 2) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r3 ← (b.accipe(off + 3) vel (0 ∷ numerus<u8>)) ↦ numerus
    redde r0 ∨ (r1 ⇐ 8) ∨ (r2 ⇐ 16) ∨ (r3 ⇐ 24)
}

# u64 little-endian at off; rejects a value ≥ 2^63 before reading.
@ privata
functio _legere_u64(lista<numerus<u8>> b, numerus off) → numerus ⇥ GgufError {
    si off + 8 > b.longitudo() {
        iace finge WireMala { causa = "truncated gguf field" }
    }
    fixum numerus r7 ← (b.accipe(off + 7) vel (0 ∷ numerus<u8>)) ↦ numerus
    si r7 ≥ 128 {
        iace finge WireMala { causa = "gguf field above the integer carrier" }
    }
    fixum numerus r0 ← (b.accipe(off + 0) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r1 ← (b.accipe(off + 1) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r2 ← (b.accipe(off + 2) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r3 ← (b.accipe(off + 3) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r4 ← (b.accipe(off + 4) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r5 ← (b.accipe(off + 5) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r6 ← (b.accipe(off + 6) vel (0 ∷ numerus<u8>)) ↦ numerus
    redde r0 ∨ (r1 ⇐ 8) ∨ (r2 ⇐ 16) ∨ (r3 ⇐ 24) ∨ (r4 ⇐ 32) ∨ (r5 ⇐ 40) ∨ (r6 ⇐ 48) ∨ (r7 ⇐ 56)
}

# len UTF-8 bytes at off → textus (bounds + UTF-8 validated).
@ privata
functio _legere_textus(lista<numerus<u8>> b, numerus off, numerus len) → textus ⇥ GgufError {
    si off + len > b.longitudo() {
        iace finge WireMala { causa = "truncated string field" }
    }
    varia lista<numerus<u8>> sub ← vacua
    varia numerus i ← 0
    dum i < len {
        sub.appende(b.accipe(off + i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    fixum octeti o ← sub
    fac {
        fixum textus s ← o ↦ textus
        redde s
    }
    cape err {
        iace finge WireMala { causa = "invalid UTF-8 in gguf string" }
    }
    iace finge WireMala { causa = "unreachable" }
}

# u64-len-prefixed string value at off → textus (len ≤ 4096).
@ privata
functio _legere_string(lista<numerus<u8>> b, numerus off) → textus ⇥ GgufError {
    fixum numerus len ← _legere_u64(b, off)
    si len > TEXTUS_LIMES {
        iace finge WireMala { causa = "string exceeds the 4096-byte ceiling" }
    }
    redde _legere_textus(b, off + 8, len)
}

# bool value at off → 0/1; any other byte fails closed.
@ privata
functio _legere_bool(lista<numerus<u8>> b, numerus off) → numerus ⇥ GgufError {
    si off + 1 > b.longitudo() {
        iace finge WireMala { causa = "truncated gguf field" }
    }
    fixum numerus v ← (b.accipe(off) vel (0 ∷ numerus<u8>)) ↦ numerus
    si v ≠ 0 et v ≠ 1 {
        iace finge WireMala { causa = "malformed bool value" }
    }
    redde v
}

# Fixed width of a scalar GGUF value type (0 for string/array/unknown).
@ privata
functio _scalar_magnitudo(numerus typo) → numerus {
    si typo ≡ GGUF_UINT8 aut typo ≡ GGUF_INT8 aut typo ≡ GGUF_BOOL ergo redde 1
    si typo ≡ GGUF_UINT16 aut typo ≡ GGUF_INT16 ergo redde 2
    si typo ≡ GGUF_UINT32 aut typo ≡ GGUF_INT32 aut typo ≡ GGUF_FLOAT32 ergo redde 4
    si typo ≡ GGUF_UINT64 aut typo ≡ GGUF_INT64 aut typo ≡ GGUF_FLOAT64 ergo redde 8
    redde 0
}

# Total byte length of a GGUF metadata value encoded at off (including
# length prefixes). Bounds-checked; used to consume optional-key values.
@ privata
functio _magnitudo_valoris(lista<numerus<u8>> b, numerus off, numerus typo) → numerus ⇥ GgufError {
    fixum numerus sc ← _scalar_magnitudo(typo)
    si sc ≠ 0 {
        si off + sc > b.longitudo() {
            iace finge WireMala { causa = "truncated gguf field" }
        }
        redde sc
    }
    si typo ≡ GGUF_STRING {
        fixum numerus len ← _legere_u64(b, off)
        si len > TEXTUS_LIMES {
            iace finge WireMala { causa = "string exceeds the 4096-byte ceiling" }
        }
        si off + 8 + len > b.longitudo() {
            iace finge WireMala { causa = "truncated gguf field" }
        }
        redde 8 + len
    }
    si typo ≡ GGUF_ARRAY {
        si off + 12 > b.longitudo() {
            iace finge WireMala { causa = "truncated gguf field" }
        }
        fixum numerus elementum_typo ← _legere_u32(b, off)
        fixum numerus elementum_num ← _legere_u64(b, off + 4)
        si elementum_num > ARRAY_LIMES {
            iace finge WireMala { causa = "array element count above ceiling" }
        }
        # Elements are length-prefixed strings or fixed-width scalars;
        # nested arrays and unknown element types fail closed in the loop.
        varia numerus tot ← 12
        varia numerus i ← 0
        dum i < elementum_num {
            si elementum_typo ≡ GGUF_STRING {
                fixum numerus len ← _legere_u64(b, off + tot)
                si len > TEXTUS_LIMES {
                    iace finge WireMala { causa = "string exceeds the 4096-byte ceiling" }
                }
                tot ← tot + 8 + len
            }
            secus {
                fixum numerus elem_sc ← _scalar_magnitudo(elementum_typo)
                si elem_sc ≡ 0 {
                    iace finge WireMala { causa = "unknown array element type" }
                }
                tot ← tot + elem_sc
            }
            si off + tot > b.longitudo() {
                iace finge WireMala { causa = "truncated gguf field" }
            }
            i ← i + 1
        }
        redde tot
    }
    iace finge WireMala { causa = "unknown gguf metadata value type" }
}

# -------------------------------------------------------------------------
# Admitted-key-set predicates. The 37 metadata keys of the pinned row are
# the admitted set (gi0 evidence contract-gguf-metadata.txt); a key outside
# it fails closed. Required keys additionally pin their value.
# -------------------------------------------------------------------------

@ privata
functio _clavis_admissa(textus k) → bivalens {
    si k ≡ "general.architecture" ergo redde verum
    si k ≡ "general.basename" ergo redde verum
    si k ≡ "general.file_type" ergo redde verum
    si k ≡ "general.finetune" ergo redde verum
    si k ≡ "general.languages" ergo redde verum
    si k ≡ "general.license" ergo redde verum
    si k ≡ "general.name" ergo redde verum
    si k ≡ "general.organization" ergo redde verum
    si k ≡ "general.quantization_version" ergo redde verum
    si k ≡ "general.size_label" ergo redde verum
    si k ≡ "general.type" ergo redde verum
    si k ≡ "llama.attention.head_count" ergo redde verum
    si k ≡ "llama.attention.head_count_kv" ergo redde verum
    si k ≡ "llama.attention.layer_norm_rms_epsilon" ergo redde verum
    si k ≡ "llama.block_count" ergo redde verum
    si k ≡ "llama.context_length" ergo redde verum
    si k ≡ "llama.embedding_length" ergo redde verum
    si k ≡ "llama.feed_forward_length" ergo redde verum
    si k ≡ "llama.rope.dimension_count" ergo redde verum
    si k ≡ "llama.rope.freq_base" ergo redde verum
    si k ≡ "llama.vocab_size" ergo redde verum
    si k ≡ "quantize.imatrix.chunks_count" ergo redde verum
    si k ≡ "quantize.imatrix.dataset" ergo redde verum
    si k ≡ "quantize.imatrix.entries_count" ergo redde verum
    si k ≡ "quantize.imatrix.file" ergo redde verum
    si k ≡ "tokenizer.chat_template" ergo redde verum
    si k ≡ "tokenizer.ggml.add_bos_token" ergo redde verum
    si k ≡ "tokenizer.ggml.add_space_prefix" ergo redde verum
    si k ≡ "tokenizer.ggml.bos_token_id" ergo redde verum
    si k ≡ "tokenizer.ggml.eos_token_id" ergo redde verum
    si k ≡ "tokenizer.ggml.merges" ergo redde verum
    si k ≡ "tokenizer.ggml.model" ergo redde verum
    si k ≡ "tokenizer.ggml.padding_token_id" ergo redde verum
    si k ≡ "tokenizer.ggml.pre" ergo redde verum
    si k ≡ "tokenizer.ggml.token_type" ergo redde verum
    si k ≡ "tokenizer.ggml.tokens" ergo redde verum
    si k ≡ "tokenizer.ggml.unknown_token_id" ergo redde verum
    redde falsum
}

# List membership (textus).
@ privata
functio _continet(lista<textus> xs, textus x) → bivalens {
    varia numerus i ← 0
    dum i < xs.longitudo() {
        si (xs.accipe(i) vel "") ≡ x ergo redde verum
        i ← i + 1
    }
    redde falsum
}

# -------------------------------------------------------------------------
# GGML-type helpers: admitted predicate + block layout (elems/bytes).
# -------------------------------------------------------------------------

@ privata
functio _typo_admissus(numerus typo) → bivalens {
    si typo ≡ GGML_F32 ergo redde verum
    si typo ≡ GGML_Q5_0 ergo redde verum
    si typo ≡ GGML_Q8_0 ergo redde verum
    si typo ≡ GGML_Q4_K ergo redde verum
    si typo ≡ GGML_Q6_K ergo redde verum
    redde falsum
}

# Block element count for an admitted type (0 for un-admitted).
@ privata
functio _typo_elementa(numerus typo) → numerus {
    si typo ≡ GGML_F32 ergo redde F32_ELEMENTA
    si typo ≡ GGML_Q5_0 ergo redde Q5_0_ELEMENTA
    si typo ≡ GGML_Q8_0 ergo redde Q8_0_ELEMENTA
    si typo ≡ GGML_Q4_K ergo redde Q4_K_ELEMENTA
    si typo ≡ GGML_Q6_K ergo redde Q6_K_ELEMENTA
    redde 0
}

# Block byte size for an admitted type (0 for un-admitted).
@ privata
functio _typo_octeti(numerus typo) → numerus {
    si typo ≡ GGML_F32 ergo redde F32_OCTETI
    si typo ≡ GGML_Q5_0 ergo redde Q5_0_OCTETI
    si typo ≡ GGML_Q8_0 ergo redde Q8_0_OCTETI
    si typo ≡ GGML_Q4_K ergo redde Q4_K_OCTETI
    si typo ≡ GGML_Q6_K ergo redde Q6_K_OCTETI
    redde 0
}

# -------------------------------------------------------------------------
# admit — the fail-closed GGUF admission. Parses the byte payload of the
# selected GGUF row and produces the admitted-model capsule. Every count
# is ceilings-checked BEFORE any loop or allocation sized by it; the
# whole-file digest and the vocab digest are host-computed and passed in.
# -------------------------------------------------------------------------

functio admit(
    lista<numerus<u8>> bytes,
    textus digestio,
    textus digestio_vocabuli,
    numerus expectatum_kv,
    numerus expectatum_tensorum,
    numerus expectatum_elementa,
    numerus expectatum_f32,
    numerus expectatum_q4k,
    numerus expectatum_q5,
    numerus expectatum_q6,
    numerus expectatum_q8,
    textus semita
) → capsula.Capsula ⇥ GgufError {
    # --- ceilings before any count-driven iteration (fail closed) --------
    si expectatum_kv < 1 aut expectatum_kv > KV_LIMES {
        iace finge LimitesMala { causa = "expected kv count outside the admitted range" }
    }
    si expectatum_tensorum < 1 aut expectatum_tensorum > TENSORUM_LIMES {
        iace finge LimitesMala { causa = "expected tensor count outside the admitted range" }
    }
    si expectatum_elementa < 1 aut expectatum_elementa > ELEMENTA_LIMES {
        iace finge LimitesMala { causa = "expected element count outside the admitted range" }
    }
    si expectatum_f32 < 0 aut expectatum_q4k < 0 aut expectatum_q5 < 0 aut expectatum_q6 < 0 aut expectatum_q8 < 0 {
        iace finge LimitesMala { causa = "expected tensor type counts outside the admitted range" }
    }
    si expectatum_f32 + expectatum_q4k + expectatum_q5 + expectatum_q6 + expectatum_q8 ≠ expectatum_tensorum {
        iace finge LimitesMala { causa = "expected tensor type counts do not sum to the tensor count" }
    }

    # --- format: magic ----------------------------------------------------
    si bytes.longitudo() < 24 {
        iace finge WireMala { causa = "truncated gguf header" }
    }
    fixum numerus m0 ← (bytes.accipe(0) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus m1 ← (bytes.accipe(1) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus m2 ← (bytes.accipe(2) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus m3 ← (bytes.accipe(3) vel (0 ∷ numerus<u8>)) ↦ numerus
    si m0 ≠ MAGIC_0 aut m1 ≠ MAGIC_1 aut m2 ≠ MAGIC_2 aut m3 ≠ MAGIC_3 {
        iace finge FormatMala { causa = "not a GGUF file — bad magic" }
    }

    # --- version ----------------------------------------------------------
    fixum numerus versio ← _legere_u32(bytes, 4)
    si versio ≠ GGUF_VERSION {
        iace finge VersioIgnota { causa = "unsupported GGUF file version: " + (versio ↦ textus) }
    }

    # --- counts (must equal the expected contract before iterating) -------
    fixum numerus tensorum ← _legere_u64(bytes, 8)
    si tensorum ≠ expectatum_tensorum {
        iace finge LimitesMala { causa = "tensor count mismatch" }
    }
    fixum numerus kv_num ← _legere_u64(bytes, 16)
    si kv_num ≠ expectatum_kv {
        iace finge LimitesMala { causa = "metadata KV count mismatch" }
    }

    # --- metadata KVs -----------------------------------------------------
    varia numerus cursor ← 24
    varia lista<textus> claves ← vacua
    varia numerus i ← 0
    dum i < kv_num {
        fixum numerus clavis_len ← _legere_u64(bytes, cursor)
        si clavis_len > NOMEN_LIMES {
            iace finge LimitesMala { causa = "metadata key exceeds the 128-byte ceiling" }
        }
        fixum textus clavis ← _legere_textus(bytes, cursor + 8, clavis_len)
        si _continet(claves, clavis) {
            iace finge WireMala { causa = "duplicate metadata key" }
        }
        claves.appende(clavis)
        si non (_clavis_admissa(clavis)) {
            iace finge WireMala { causa = "unknown metadata key" }
        }
        cursor ← cursor + 8 + clavis_len
        fixum numerus typo_valoris ← _legere_u32(bytes, cursor)
        cursor ← cursor + 4
        si clavis ≡ "general.architecture" {
            si typo_valoris ≠ GGUF_STRING { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_string(bytes, cursor) ≠ ARCHITECTURA { iace finge ArchitecturaMala { causa = "architecture mismatch" } }
        }
        si clavis ≡ "general.file_type" {
            si typo_valoris ≠ GGUF_UINT32 { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_u32(bytes, cursor) ≠ FILE_TYPE { iace finge QuantizatioIgnota { causa = "file type mismatch" } }
        }
        si clavis ≡ "general.quantization_version" {
            si typo_valoris ≠ GGUF_UINT32 { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_u32(bytes, cursor) ≠ QUANTIZATIO_VERSION { iace finge QuantizatioIgnota { causa = "quantization version mismatch" } }
        }
        si clavis ≡ "llama.block_count" {
            si typo_valoris ≠ GGUF_UINT32 { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_u32(bytes, cursor) ≠ STRATA { iace finge ArchitecturaMala { causa = "layer count mismatch" } }
        }
        si clavis ≡ "llama.context_length" {
            si typo_valoris ≠ GGUF_UINT32 { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_u32(bytes, cursor) ≠ CONTEXTUS { iace finge ArchitecturaMala { causa = "context length mismatch" } }
        }
        si clavis ≡ "llama.vocab_size" {
            si typo_valoris ≠ GGUF_UINT32 { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_u32(bytes, cursor) ≠ VOCABULUM { iace finge ArchitecturaMala { causa = "vocabulary size mismatch" } }
        }
        si clavis ≡ "llama.embedding_length" {
            si typo_valoris ≠ GGUF_UINT32 { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_u32(bytes, cursor) ≠ EMBEDDING { iace finge ArchitecturaMala { causa = "embedding size mismatch" } }
        }
        si clavis ≡ "tokenizer.ggml.model" {
            si typo_valoris ≠ GGUF_STRING { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_string(bytes, cursor) ≠ TOKENIZATOR_MODEL { iace finge TokenizerMala { causa = "tokenizer model mismatch" } }
        }
        si clavis ≡ "tokenizer.ggml.pre" {
            si typo_valoris ≠ GGUF_STRING { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_string(bytes, cursor) ≠ TOKENIZATOR_PRE { iace finge TokenizerMala { causa = "tokenizer pre-tokenizer mismatch" } }
        }
        si clavis ≡ "tokenizer.ggml.bos_token_id" {
            si typo_valoris ≠ GGUF_UINT32 { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_u32(bytes, cursor) ≠ BOS_ID { iace finge TokenizerMala { causa = "bos token id mismatch" } }
        }
        si clavis ≡ "tokenizer.ggml.eos_token_id" {
            si typo_valoris ≠ GGUF_UINT32 { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_u32(bytes, cursor) ≠ EOS_ID { iace finge TokenizerMala { causa = "eos token id mismatch" } }
        }
        si clavis ≡ "tokenizer.ggml.padding_token_id" {
            si typo_valoris ≠ GGUF_UINT32 { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_u32(bytes, cursor) ≠ PAD_ID { iace finge TokenizerMala { causa = "padding token id mismatch" } }
        }
        si clavis ≡ "tokenizer.ggml.unknown_token_id" {
            si typo_valoris ≠ GGUF_UINT32 { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_u32(bytes, cursor) ≠ UNK_ID { iace finge TokenizerMala { causa = "unknown token id mismatch" } }
        }
        si clavis ≡ "tokenizer.ggml.add_bos_token" {
            si typo_valoris ≠ GGUF_BOOL { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_bool(bytes, cursor) ≠ 0 { iace finge TokenizerMala { causa = "add_bos_token mismatch" } }
        }
        si clavis ≡ "tokenizer.ggml.add_space_prefix" {
            si typo_valoris ≠ GGUF_BOOL { iace finge WireMala { causa = "unexpected metadata value type" } }
            si _legere_bool(bytes, cursor) ≠ 0 { iace finge TokenizerMala { causa = "add_space_prefix mismatch" } }
        }
        fixum numerus magnitudo_valoris ← _magnitudo_valoris(bytes, cursor, typo_valoris)
        cursor ← cursor + magnitudo_valoris
        i ← i + 1
    }

    # --- required keys present (fail closed with the named key) -----------
    si non (_continet(claves, "general.architecture")) {
        iace finge ArchitecturaMala { causa = "missing required metadata key: general.architecture" }
    }
    si non (_continet(claves, "general.file_type")) {
        iace finge QuantizatioIgnota { causa = "missing required metadata key: general.file_type" }
    }
    si non (_continet(claves, "general.quantization_version")) {
        iace finge QuantizatioIgnota { causa = "missing required metadata key: general.quantization_version" }
    }
    si non (_continet(claves, "llama.block_count")) {
        iace finge ArchitecturaMala { causa = "missing required metadata key: llama.block_count" }
    }
    si non (_continet(claves, "llama.context_length")) {
        iace finge ArchitecturaMala { causa = "missing required metadata key: llama.context_length" }
    }
    si non (_continet(claves, "llama.vocab_size")) {
        iace finge ArchitecturaMala { causa = "missing required metadata key: llama.vocab_size" }
    }
    si non (_continet(claves, "llama.embedding_length")) {
        iace finge ArchitecturaMala { causa = "missing required metadata key: llama.embedding_length" }
    }
    si non (_continet(claves, "tokenizer.ggml.model")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.model" }
    }
    si non (_continet(claves, "tokenizer.ggml.pre")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.pre" }
    }
    si non (_continet(claves, "tokenizer.ggml.bos_token_id")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.bos_token_id" }
    }
    si non (_continet(claves, "tokenizer.ggml.eos_token_id")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.eos_token_id" }
    }
    si non (_continet(claves, "tokenizer.ggml.padding_token_id")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.padding_token_id" }
    }
    si non (_continet(claves, "tokenizer.ggml.unknown_token_id")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.unknown_token_id" }
    }
    si non (_continet(claves, "tokenizer.ggml.add_bos_token")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.add_bos_token" }
    }
    si non (_continet(claves, "tokenizer.ggml.add_space_prefix")) {
        iace finge TokenizerMala { causa = "missing required metadata key: tokenizer.ggml.add_space_prefix" }
    }

    # --- tensor table -----------------------------------------------------
    varia lista<textus> nomina ← vacua
    varia numerus tot_elementa ← 0
    varia numerus tot_octeti ← 0
    varia numerus cursus_data ← 0
    varia numerus visi_f32 ← 0
    varia numerus visi_q4k ← 0
    varia numerus visi_q5 ← 0
    varia numerus visi_q6 ← 0
    varia numerus visi_q8 ← 0
    varia numerus t ← 0
    dum t < tensorum {
        fixum numerus nomen_len ← _legere_u64(bytes, cursor)
        si nomen_len > NOMEN_LIMES {
            iace finge WireMala { causa = "tensor name exceeds the 128-byte ceiling" }
        }
        fixum textus nomen ← _legere_textus(bytes, cursor + 8, nomen_len)
        si nomen.longitudo() ≡ 0 {
            iace finge WireMala { causa = "empty tensor name" }
        }
        si _continet(nomina, nomen) {
            iace finge WireMala { causa = "duplicate tensor name" }
        }
        nomina.appende(nomen)
        cursor ← cursor + 8 + nomen_len

        fixum numerus n_dims ← _legere_u32(bytes, cursor)
        cursor ← cursor + 4
        si n_dims ≠ 1 et n_dims ≠ 2 {
            iace finge FormaMala { causa = "unsupported tensor rank" }
        }
        varia numerus nelems ← 1
        varia numerus d ← 0
        dum d < n_dims {
            fixum numerus dim ← _legere_u64(bytes, cursor)
            cursor ← cursor + 8
            si dim < 1 aut dim > DIMENSI_LIMES {
                iace finge FormaMala { causa = "invalid tensor dimension" }
            }
            si nelems > expectatum_elementa / dim {
                iace finge FormaMala { causa = "tensor element count above the expected total" }
            }
            nelems ← nelems * dim
            d ← d + 1
        }

        fixum numerus typo ← _legere_u32(bytes, cursor)
        cursor ← cursor + 4
        si non (_typo_admissus(typo)) {
            iace finge QuantizatioIgnota { causa = "unknown ggml tensor type" }
        }
        fixum numerus elementa_blocci ← _typo_elementa(typo)
        si nelems % elementa_blocci ≠ 0 {
            iace finge QuantizatioIgnota { causa = "tensor size not a multiple of its block layout" }
        }
        fixum numerus blocci ← nelems / elementa_blocci
        fixum numerus magnitudo ← blocci * _typo_octeti(typo)
        si magnitudo % CONCORDATIO ≠ 0 {
            iace finge QuantizatioIgnota { causa = "tensor byte size not a multiple of the 32-byte data alignment" }
        }
        si tot_elementa > expectatum_elementa - nelems {
            iace finge FormaMala { causa = "total element count above the expected total" }
        }
        tot_elementa ← tot_elementa + nelems
        tot_octeti ← tot_octeti + magnitudo

        fixum numerus offset ← _legere_u64(bytes, cursor)
        cursor ← cursor + 8
        si offset ≠ cursus_data {
            iace finge OffsetMala { causa = "tensor offsets are not contiguous" }
        }
        cursus_data ← cursus_data + magnitudo

        si typo ≡ GGML_F32 { visi_f32 ← visi_f32 + 1 }
        si typo ≡ GGML_Q4_K { visi_q4k ← visi_q4k + 1 }
        si typo ≡ GGML_Q5_0 { visi_q5 ← visi_q5 + 1 }
        si typo ≡ GGML_Q6_K { visi_q6 ← visi_q6 + 1 }
        si typo ≡ GGML_Q8_0 { visi_q8 ← visi_q8 + 1 }
        t ← t + 1
    }

    # --- exact row facts --------------------------------------------------
    si tot_elementa ≠ expectatum_elementa {
        iace finge FormaMala { causa = "total element count mismatch" }
    }
    si visi_f32 ≠ expectatum_f32 aut visi_q4k ≠ expectatum_q4k aut visi_q5 ≠ expectatum_q5 aut visi_q6 ≠ expectatum_q6 aut visi_q8 ≠ expectatum_q8 {
        iace finge QuantizatioIgnota { causa = "tensor type count mismatch" }
    }

    # --- data region: align32(start) + exact tiling (coverage_ok) ---------
    varia numerus data_inceptum ← cursor
    si data_inceptum % CONCORDATIO ≠ 0 {
        data_inceptum ← data_inceptum + (CONCORDATIO - data_inceptum % CONCORDATIO)
    }
    si tot_octeti ≠ bytes.longitudo() - data_inceptum {
        iace finge OffsetMala { causa = "data region does not tile exactly" }
    }

    # --- capsule construction (capsule-schema-1.0.0, PML2-U1) -------------
    fac {
        fixum capsula.Capsula c ← capsula.structa(
            CAPSULA_SCHEMA,
            bytes, verum,
            "sha-256", digestio,
            TOKENIZATOR_MODEL, TOKENIZATOR_PRE, digestio_vocabuli, "0,2", verum, verum,
            "q4_k", Q4_K_ELEMENTA, Q4_K_OCTETI, CONCORDATIO,
            bytes.longitudo(), expectatum_kv, expectatum_tensorum,
            NOMEN_LIMES, DIMENSI_LIMES, expectatum_elementa, TEXTUS_LIMES,
            ARCHITECTURA, "dense", STRATA, (CONTEXTUS ↦ textus),
            semita)
        redde c
    }
    cape err {
        iace finge CapsulaMala { causa = "capsule construction failed: " + capsula.causa(err) }
    }
    iace finge CapsulaMala { causa = "unreachable" }
}
