+++
locale = "en"
+++
# GGUF row admission — the selected GGUF row parses → schema-2 capsule
# (PML2-U3, capsule-schema-2.0.0, A1C-M2).
#
# Public import: import from "gradus:model/gguf" private gguf
# Depends on: gradus:model/capsule (capsule-schema-2.0.0, PML2-U1),
#             gradus:model/gguf_manifest (the one GGUF wire authority, A1b),
#             gradus:model/artifact (pathless content identity).
#
# --- Contract ------------------------------------------------------------
#
# One admitted GGUF row: SmolLM2-360M-Instruct-Q4_K_M (bartowski imatrix
# quant, llama.cpp b3772) — the pinned row of gi0-model-contract v1.0.0 /
# gi1-closeout.md (read-only facts, cited below). The row parses → a
# fail-closed capsule with rejection on the pinned one-row contract.
#
# D3 clean break (A1C-M2): the schema-1 wire parser (byte readers,
# admitted-key predicate, block-layout helpers) is DELETED. `admit` is a
# thin wrapper over gradus:model/gguf_manifest — it inspects
# the header/metadata/tensor table through `gguf_manifest.inspect` over a
# caller-owned byte range and validates the pinned one-row contract
# through manifest accessors (`text`/`number`/`metadata`, the carried
# metadata/tensor descriptors). No alias, no forwarding import, no
# compatibility parser remains.
#
# Fail-closed dimensions, by owner:
#   manifest (the wire authority): magic, GGUF version, count ceilings,
#       duplicate keys/tensor names, value wire kinds, UTF-8, string/key
#       ceilings, tensor rank/dim bounds, GGML block layout, tensor range
#       overlap, identity-form checks.
#   this module (the pinned row): expected counts (KV/tensor/element and
#       the exact per-type tensor counts F32 65 / Q4_K 16 / Q5_0 176 /
#       Q6_K 16 / Q8_0 17), the admitted 37-key metadata set (an unknown
#       key fails closed), the 15 required keys, the pinned metadata
#       VALUES (architecture, file type, quant version, block/context/
#       vocab/embedding counts, tokenizer model/pre/ids/bools), tensor
#       rank/shape ceilings and offsets, and the exact data-region tiling
#       (coverage_ok).
#
# The whole-file SHA-256 is computed by the admission host (pure-Rust, per
# capsule.fab) and passed in; this module builds the schema-2 capsule,
# which validates the digest form and carries the pathless content
# identity. Raw bytes are never a trust anchor — only the capsule carries
# identity (capsule-schema-2.0.0, C8).
#
# One-row boundary (gi1 exit-gate bullet 5): the constants below pin the
# selected row only; a wider admission is a row-contract change. Scaled
# structural fixtures exercise the RULES (same posture as capsule.proba);
# the pinned values exercise the row. No runtime claim is generalized
# beyond the selected row.
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * The manifest authority's public names are @ public (V-GGUFM/M8R4
#     closure), so this module's helpers that name manifest types
#     (GgufManifestError, SourceRead, GgufMetadata, GgufManifest)
#     and call their accessors import cleanly. gguf_manifest stays the
#     single GGUF parser authority.
#   * Proba proof is compile-level until the FMIR stepper / faber test
#     path covers library probas (capsule.fab residual); `faber check`
#     proves the whole surface type-checks.
#   * Public signatures stay on primitives plus capsule.Capsule and this
#     module's own GgufError so the proba file-interface keeps every
#     export.
#
# --- Seams ---------------------------------------------------------------
#   * tokenizer probe parity (P1–P11, workload id lists) — PML2-U4.
#   * negative-matrix conformance suite across U2/U3/U4 — PML2-U6.
#   * norma:model + GI1 admission migration (no dual authority) — PML2-U5.
#   * digest computation — the admission host (pure-Rust, GI1).

import from "gradus:model/artifact" artifact

import from "gradus:model/capsule" capsule

import from "gradus:model/gguf_manifest" gguf_manifest

# -------------------------------------------------------------------------
# Row contract — pinned constants. Row facts mirror gi0-model-contract
# v1.0.0 (§1–§5) and gi1-closeout.md exit-gate bullets 2/4/6; the GGML
# type ids are pinned to the toolchain table (same ids the manifest
# authority resolves).
# -------------------------------------------------------------------------

# --- format / version ----------------------------------------------------
const int ALIGNMENT ← 32
# GGUF_DEFAULT_ALIGNMENT.
const int FILE_TYPE ← 15
# general.file_type (MOSTLY_Q4_K_M).
const int QUANTIZATION_VERSION ← 2
# general.quantization_version.

# --- GGML type ids (pinned toolchain ggml.h, llama.cpp a957b7747) --------
const int GGML_F32 ← 0

const int GGML_Q5_0 ← 6

const int GGML_Q8_0 ← 8

const int GGML_Q4_K ← 12

const int GGML_Q6_K ← 14

# --- architecture facts (gi0-model-contract §2) --------------------------
const string ARCHITECTURE ← "llama"

const int LAYERS ← 32
# llama.block_count.
const int CONTEXT ← 8192
# llama.context_length.
const int VOCAB ← 49152
# llama.vocab_size.
const int EMBEDDING ← 960
# llama.embedding_length.

# --- tokenizer facts (gi0-model-contract §4) -----------------------------
const string TOKENIZER_MODEL ← "gpt2"

const string TOKENIZER_PRE ← "smollm"

const int BOS_ID ← 1

const int EOS_ID ← 2

const int PAD_ID ← 2

const int UNK_ID ← 0

# --- library hard ceilings (mirror capsule.fab / gradus:shape U3) --------
const int DIMENSION_LIMIT ← 65536

const int ELEMENT_LIMIT ← 1000000000

const int NAME_LIMIT ← 128

const int KV_LIMIT ← 4096
# metadata KV count ceiling.
const int TENSOR_LIMIT ← 65536
# tensor count ceiling.

# -------------------------------------------------------------------------
# GgufError — typed error vocabulary of the GGUF admission boundary. Every
# variant carries a text message (render via message). Variant → dimension:
#   BadFormat       — bad magic (not a GGUF file).
#   UnknownVersion     — unsupported GGUF file version.
#   BadArchitecture — architecture facts (arch id, layers, context,
#                      vocab, embedding).
#   UnknownQuantization— dtype/quantization: file type, quant version, ggml
#                      type, block layout, per-type tensor counts.
#   BadOffset       — tensor offsets / data-region tiling (coverage).
#   BadShape        — shapes: rank, dims, total element count.
#   BadTokenizer    — tokenizer identity facts.
#   BadBounds      — count ceilings (kv/tensor/element, key length).
#   BadWire         — malformed bytes: truncation, unknown/duplicate
#                      keys or tensor names, string ceilings, overflow.
#   BadCapsule      — capsule construction failed.
#
# Wire/format rejections detected by the manifest authority surface as
# BadWire carrying the authority's typed message (rendered verbatim), per
# the A1C one-authority boundary.
# -------------------------------------------------------------------------

@ public { }
union GgufError {
    BadFormat {
        string message
    },
    UnknownVersion {
        string message
    },
    BadArchitecture {
        string message
    },
    UnknownQuantization {
        string message
    },
    BadOffset {
        string message
    },
    BadShape {
        string message
    },
    BadTokenizer {
        string message
    },
    BadBounds {
        string message
    },
    BadWire {
        string message
    },
    BadCapsule {
        string message
    }
}

@ public { }
fn message(GgufError e) → string {
    match e {
        case BadFormat const message {
            return message
        }
        case UnknownVersion const message {
            return message
        }
        case BadArchitecture const message {
            return message
        }
        case UnknownQuantization const message {
            return message
        }
        case BadOffset const message {
            return message
        }
        case BadShape const message {
            return message
        }
        case BadTokenizer const message {
            return message
        }
        case BadBounds const message {
            return message
        }
        case BadWire const message {
            return message
        }
        case BadCapsule const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# Private helpers over the manifest authority. The range source slices
# the caller-owned bytes; the accessor wrappers map the authority's typed
# GgufManifestError into this module's GgufError vocabulary. None of these
# helpers parse wire bytes — the manifest authority already validated
# them during inspect.
# -------------------------------------------------------------------------

# Range source over the supplied byte list (the caller-owned corpus). A
# read beyond the bytes fails the read; the manifest authority turns the
# failure into a typed BadSource.
@ private { }
fn _source(list<int<u8>> b, int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    require not ((start ≺ 0 or length ≺ 0) or start ≻ b.length() - length) throw variant BadSource {message = "range read beyond the supplied bytes"}
    const list<int<u8>> segment ← b.slice(start, start + length)
    return segment ↦ bytes
}

# Map the authority's typed error into this module's vocabulary, preserving
# its message (rendered verbatim by the authority's own renderer).
@ private { }
fn _manifest_error(gguf_manifest.GgufManifestError e) → GgufError {
    return variant BadWire {message = gguf_manifest.message(e)}
}

# Inspect the header/metadata/tensor-table corpus via the authority.
@ private { }
fn _inspect(list<int<u8>> b, artifact.ContentIdentity identity) → gguf_manifest.GgufManifest ⇥ GgufError {
    do {
        return gguf_manifest.inspect((int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _source(b, start, length), b.length(), identity)
    }
    catch err {
        throw _manifest_error(err)
    }
    throw variant BadWire {message = "unreachable"}
}

# String metadata accessor, authority-mapped.
@ private { }
fn _text_value(gguf_manifest.GgufManifest m, string key) → string ⇥ GgufError {
    do {
        const string v ← gguf_manifest.text(m, key)
        return v
    }
    catch err {
        throw _manifest_error(err)
    }
    throw variant BadWire {message = "unreachable"}
}

# Integer metadata accessor, authority-mapped.
@ private { }
fn _number_value(gguf_manifest.GgufManifest m, string key) → int ⇥ GgufError {
    do {
        const int v ← gguf_manifest.number(m, key)
        return v
    }
    catch err {
        throw _manifest_error(err)
    }
    throw variant BadWire {message = "unreachable"}
}

# BOOL metadata value (the authority has no integer accessor for the BOOL
# wire kind; the carried value's first byte is the validated 0/1).
@ private { }
fn _bool_value(gguf_manifest.GgufManifest m, string key) → int ⇥ GgufError {
    var gguf_manifest.GgufMetadata md ← gguf_manifest.GgufMetadata {key = "", dtype = -1, payload_wire = ||}
    do {
        md ← gguf_manifest.metadata(m, key)
    }
    catch err {
        throw _manifest_error(err)
    }
    const bytes wire ← md.payload_wire
    require wire.length() ≥ 1 throw variant BadWire {message = "malformed bool value"}
    const int v ← wire.get(0) coalesce 0 ∷ int<u8> ↦ int
    return v
}

# List membership (text).
@ private { }
fn _contains(list<string> xs, string x) → bool {
    var int i ← 0
    while i ≺ xs.length() {
        if xs.get(i) coalesce "" ≡ x then return true
        i ← i + 1
    }
    return false
}

# The admitted metadata KEY SET is pinned (the 37 keys of the pinned row,
# gi0 evidence contract-gguf-metadata.txt): a key outside it fails closed.
# A pure predicate over carried metadata keys — no wire parsing.
@ private { }
fn _key_value(string k) → bool {
    if k ≡ "general.architecture" then return true
    if k ≡ "general.basename" then return true
    if k ≡ "general.file_type" then return true
    if k ≡ "general.finetune" then return true
    if k ≡ "general.languages" then return true
    if k ≡ "general.license" then return true
    if k ≡ "general.name" then return true
    if k ≡ "general.organization" then return true
    if k ≡ "general.quantization_version" then return true
    if k ≡ "general.size_label" then return true
    if k ≡ "general.type" then return true
    if k ≡ "llama.attention.head_count" then return true
    if k ≡ "llama.attention.head_count_kv" then return true
    if k ≡ "llama.attention.layer_norm_rms_epsilon" then return true
    if k ≡ "llama.block_count" then return true
    if k ≡ "llama.context_length" then return true
    if k ≡ "llama.embedding_length" then return true
    if k ≡ "llama.feed_forward_length" then return true
    if k ≡ "llama.rope.dimension_count" then return true
    if k ≡ "llama.rope.freq_base" then return true
    if k ≡ "llama.vocab_size" then return true
    if k ≡ "quantize.imatrix.chunks_count" then return true
    if k ≡ "quantize.imatrix.dataset" then return true
    if k ≡ "quantize.imatrix.entries_count" then return true
    if k ≡ "quantize.imatrix.file" then return true
    if k ≡ "tokenizer.chat_template" then return true
    if k ≡ "tokenizer.ggml.add_bos_token" then return true
    if k ≡ "tokenizer.ggml.add_space_prefix" then return true
    if k ≡ "tokenizer.ggml.bos_token_id" then return true
    if k ≡ "tokenizer.ggml.eos_token_id" then return true
    if k ≡ "tokenizer.ggml.merges" then return true
    if k ≡ "tokenizer.ggml.model" then return true
    if k ≡ "tokenizer.ggml.padding_token_id" then return true
    if k ≡ "tokenizer.ggml.pre" then return true
    if k ≡ "tokenizer.ggml.token_type" then return true
    if k ≡ "tokenizer.ggml.tokens" then return true
    if k ≡ "tokenizer.ggml.unknown_token_id" then return true
    return false
}

# -------------------------------------------------------------------------
# admit — the fail-closed GGUF admission. A thin schema-2 wrapper (D3):
# inspects the header/metadata/tensor-table corpus through the manifest
# authority, validates the pinned one-row contract through manifest
# accessors, and builds the schema-2 capsule. Every count is ceilings-
# checked BEFORE the authority is invoked; the whole-file SHA-256 is
# host-computed and passed in as the pathless content identity.
# -------------------------------------------------------------------------

@ public { }
fn admit(list<int<u8>> bytes, string digest, int expected_kv, int expected_tensors, int expected_elements, int expected_f32, int expected_q4k, int expected_q5, int expected_q6, int expected_q8) → capsule.Capsule ⇥ GgufError {
    # --- ceilings before any count-driven iteration (fail closed) --------
    require not (expected_kv ≺ 1 or expected_kv ≻ KV_LIMIT) throw variant BadBounds {message = "expected kv count outside the admitted range"}
    require not (expected_tensors ≺ 1 or expected_tensors ≻ TENSOR_LIMIT) throw variant BadBounds {message = "expected tensor count outside the admitted range"}
    require not (expected_elements ≺ 1 or expected_elements ≻ ELEMENT_LIMIT) throw variant BadBounds {message = "expected element count outside the admitted range"}
    require not ((((expected_f32 ≺ 0 or expected_q4k ≺ 0) or expected_q5 ≺ 0) or expected_q6 ≺ 0) or expected_q8 ≺ 0) throw variant BadBounds {message = "expected tensor type counts outside the admitted range"}
    require (((expected_f32 + expected_q4k) + expected_q5) + expected_q6) + expected_q8 ≡ expected_tensors throw variant BadBounds {message = "expected tensor type counts do not sum to the tensor count"}

    # --- format guard (truncated header) before the authority -------------
    require bytes.length() ≥ 24 throw variant BadWire {message = "truncated gguf header"}

    # --- inspect the header/metadata/tensor-table via the authority -------
    const artifact.ContentIdentity identity ← artifact.ContentIdentity {algorithm = "sha-256", digest = digest, length = bytes.length()}
    const gguf_manifest.GgufManifest m ← _inspect(bytes, identity)

    # --- counts (the pinned one-row contract) -----------------------------
    require m.tensors.length() ≡ expected_tensors throw variant BadBounds {message = "tensor count mismatch"}
    require m.metadata.length() ≡ expected_kv throw variant BadBounds {message = "metadata KV count mismatch"}

    # --- admitted metadata key set + required keys (fail closed) ----------
    var list<string> keys ← empty
    for from m.metadata const md {
        require md.key.length() ≤ NAME_LIMIT throw variant BadBounds {message = "metadata key exceeds the 128-byte ceiling"}
        require _key_value(md.key) throw variant BadWire {message = "unknown metadata key"}
        keys.append(md.key)
    }
    require _contains(keys, "general.architecture") throw variant BadArchitecture {message = "missing required metadata key: general.architecture"}
    require _contains(keys, "general.file_type") throw variant UnknownQuantization {message = "missing required metadata key: general.file_type"}
    require _contains(keys, "general.quantization_version") throw variant UnknownQuantization {message = "missing required metadata key: general.quantization_version"}
    require _contains(keys, "llama.block_count") throw variant BadArchitecture {message = "missing required metadata key: llama.block_count"}
    require _contains(keys, "llama.context_length") throw variant BadArchitecture {message = "missing required metadata key: llama.context_length"}
    require _contains(keys, "llama.vocab_size") throw variant BadArchitecture {message = "missing required metadata key: llama.vocab_size"}
    require _contains(keys, "llama.embedding_length") throw variant BadArchitecture {message = "missing required metadata key: llama.embedding_length"}
    require _contains(keys, "tokenizer.ggml.model") throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.model"}
    require _contains(keys, "tokenizer.ggml.pre") throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.pre"}
    require _contains(keys, "tokenizer.ggml.bos_token_id") throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.bos_token_id"}
    require _contains(keys, "tokenizer.ggml.eos_token_id") throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.eos_token_id"}
    require _contains(keys, "tokenizer.ggml.padding_token_id") throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.padding_token_id"}
    require _contains(keys, "tokenizer.ggml.unknown_token_id") throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.unknown_token_id"}
    require _contains(keys, "tokenizer.ggml.add_bos_token") throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.add_bos_token"}
    require _contains(keys, "tokenizer.ggml.add_space_prefix") throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.add_space_prefix"}

    # --- pinned required metadata VALUES (through manifest accessors) -----
    require _text_value(m, "general.architecture") ≡ ARCHITECTURE throw variant BadArchitecture {message = "architecture mismatch"}
    require _number_value(m, "general.file_type") ≡ FILE_TYPE throw variant UnknownQuantization {message = "file type mismatch"}
    require _number_value(m, "general.quantization_version") ≡ QUANTIZATION_VERSION throw variant UnknownQuantization {message = "quantization version mismatch"}
    require _number_value(m, "llama.block_count") ≡ LAYERS throw variant BadArchitecture {message = "layer count mismatch"}
    require _number_value(m, "llama.context_length") ≡ CONTEXT throw variant BadArchitecture {message = "context length mismatch"}
    require _number_value(m, "llama.vocab_size") ≡ VOCAB throw variant BadArchitecture {message = "vocabulary size mismatch"}
    require _number_value(m, "llama.embedding_length") ≡ EMBEDDING throw variant BadArchitecture {message = "embedding size mismatch"}
    require _text_value(m, "tokenizer.ggml.model") ≡ TOKENIZER_MODEL throw variant BadTokenizer {message = "tokenizer model mismatch"}
    require _text_value(m, "tokenizer.ggml.pre") ≡ TOKENIZER_PRE throw variant BadTokenizer {message = "tokenizer pre-tokenizer mismatch"}
    require _number_value(m, "tokenizer.ggml.bos_token_id") ≡ BOS_ID throw variant BadTokenizer {message = "bos token id mismatch"}
    require _number_value(m, "tokenizer.ggml.eos_token_id") ≡ EOS_ID throw variant BadTokenizer {message = "eos token id mismatch"}
    require _number_value(m, "tokenizer.ggml.padding_token_id") ≡ PAD_ID throw variant BadTokenizer {message = "padding token id mismatch"}
    require _number_value(m, "tokenizer.ggml.unknown_token_id") ≡ UNK_ID throw variant BadTokenizer {message = "unknown token id mismatch"}
    require _bool_value(m, "tokenizer.ggml.add_bos_token") ≡ 0 throw variant BadTokenizer {message = "add_bos_token mismatch"}
    require _bool_value(m, "tokenizer.ggml.add_space_prefix") ≡ 0 throw variant BadTokenizer {message = "add_space_prefix mismatch"}

    # --- tensor table (the pinned one-row contract through descriptors) --
    var int total_elements ← 0
    var int visi_f32 ← 0
    var int visi_q4k ← 0
    var int visi_q5 ← 0
    var int visi_q6 ← 0
    var int visi_q8 ← 0
    var int data_cursor ← 0
    var int total_bytes ← 0
    for from m.tensors const t {
        require not (t.shape.length() ≠ 1 and t.shape.length() ≠ 2) throw variant BadShape {message = "unsupported tensor rank"}
        var int d ← 0
        while d ≺ t.shape.length() {
            const int dim ← t.shape.get(d) coalesce 0
            require dim ≤ DIMENSION_LIMIT throw variant BadShape {message = "invalid tensor dimension"}
            d ← d + 1
        }
        require t.name.length() ≤ NAME_LIMIT throw variant BadWire {message = "tensor name exceeds the 128-byte ceiling"}
        require not ((((t.dtype_ggml ≠ GGML_F32 and t.dtype_ggml ≠ GGML_Q4_K) and t.dtype_ggml ≠ GGML_Q5_0) and t.dtype_ggml ≠ GGML_Q6_K) and t.dtype_ggml ≠ GGML_Q8_0) throw variant UnknownQuantization {message = "unknown ggml tensor type"}
        require total_elements ≤ expected_elements - t.elements throw variant BadShape {message = "tensor element count above the expected total"}
        total_elements ← total_elements + t.elements
        require t.relative_offset ≡ data_cursor throw variant BadOffset {message = "tensor offsets are not contiguous"}
        match t.layout {
            case gguf_manifest.Known const elements_per_block, bytes_per_block, byte_length {
                require byte_length % ALIGNMENT ≡ 0 throw variant UnknownQuantization {message = "tensor byte size not a multiple of the 32-byte data alignment"}
                data_cursor ← data_cursor + byte_length
                total_bytes ← total_bytes + byte_length
            }
            case gguf_manifest.Unknown const kind {
                throw variant UnknownQuantization {message = "unknown ggml tensor layout"}
            }
        }
        if t.dtype_ggml ≡ GGML_F32 {
            visi_f32 ← visi_f32 + 1
        }
        if t.dtype_ggml ≡ GGML_Q4_K {
            visi_q4k ← visi_q4k + 1
        }
        if t.dtype_ggml ≡ GGML_Q5_0 {
            visi_q5 ← visi_q5 + 1
        }
        if t.dtype_ggml ≡ GGML_Q6_K {
            visi_q6 ← visi_q6 + 1
        }
        if t.dtype_ggml ≡ GGML_Q8_0 {
            visi_q8 ← visi_q8 + 1
        }
    }

    # --- exact row facts --------------------------------------------------
    require total_elements ≡ expected_elements throw variant BadShape {message = "total element count mismatch"}
    require not ((((visi_f32 ≠ expected_f32 or visi_q4k ≠ expected_q4k) or visi_q5 ≠ expected_q5) or visi_q6 ≠ expected_q6) or visi_q8 ≠ expected_q8) throw variant UnknownQuantization {message = "tensor type count mismatch"}

    # --- data region: exact tiling to EOF (coverage_ok) -------------------
    require total_bytes ≡ m.artifact_length - m.data_start throw variant BadOffset {message = "data region does not tile exactly"}

    # --- capsule construction (capsule-schema-2.0.0, A1C-M1) --------------
    do {
        const capsule.Capsule c ← capsule.construct_manifest(capsule.schema_version, m.identity, capsule.from_gguf(m))
        return c
    }
    catch err {
        throw variant BadCapsule {message = "capsule construction failed: §"(capsule.message(err))}
    }
    throw variant BadCapsule {message = "unreachable"}
}
