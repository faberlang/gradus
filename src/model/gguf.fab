+++
locale = "en"
+++
# GGUF row admission — the selected GGUF row parses → schema-2 capsule
# (PML2-U3, capsule-schema-2.0.0, A1C-M2).
#
# Public import: importa ex "gradus:model/gguf" privata gguf
# Depends on: gradus:model/capsule (capsule-schema-2.0.0, PML2-U1),
#             gradus:model/gguf_manifest (the one GGUF wire authority, A1b),
#             gradus:model/artifact (pathless content identity).
#
# --- Contract ------------------------------------------------------------
#
# One admitted GGUF row: SmolLM2-360M-Instruct-Q4_K_M (bartowski imatrix
# quant, llama.cpp b3772) — the pinned row of gi0-model-contract v1.0.0 /
# gi1-closeout.md (read-only facts, cited below). The row parses → a
# fail-closed capsule with rejection on the pinned one-row contract.
#
# D3 clean break (A1C-M2): the schema-1 wire parser (byte readers,
# admitted-key predicate, block-layout helpers) is DELETED. `admit` is a
# thin wrapper over gradus:model/gguf_manifest — it inspects
# the header/metadata/tensor table through `manifestum.inspice` over a
# caller-owned byte range and validates the pinned one-row contract
# through manifest accessors (`textum`/`numerum`/`metadatum`, the carried
# metadata/tensor descriptors). No alias, no forwarding import, no
# compatibility parser remains.
#
# Fail-closed dimensions, by owner:
#   manifestum (the wire authority): magic, GGUF version, count ceilings,
#       duplicate keys/tensor names, value wire kinds, UTF-8, string/key
#       ceilings, tensor rank/dim bounds, GGML block layout, tensor range
#       overlap, identity-form checks.
#   this module (the pinned row): expected counts (KV/tensor/element and
#       the exact per-type tensor counts F32 65 / Q4_K 16 / Q5_0 176 /
#       Q6_K 16 / Q8_0 17), the admitted 37-key metadata set (an unknown
#       key fails closed), the 15 required keys, the pinned metadata
#       VALUES (architecture, file type, quant version, block/context/
#       vocab/embedding counts, tokenizer model/pre/ids/bools), tensor
#       rank/shape ceilings and offsets, and the exact data-region tiling
#       (coverage_ok).
#
# The whole-file SHA-256 is computed by the admission host (pure-Rust, per
# capsule.fab) and passed in; this module builds the schema-2 capsule,
# which validates the digest form and carries the pathless content
# identity. Raw bytes are never a trust anchor — only the capsule carries
# identity (capsule-schema-2.0.0, C8).
#
# One-row boundary (gi1 exit-gate bullet 5): the constants below pin the
# selected row only; a wider admission is a row-contract change. Scaled
# structural fixtures exercise the RULES (same posture as capsule.proba);
# the pinned values exercise the row. No runtime claim is generalized
# beyond the selected row.
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * The manifest authority's public names are @ publica (V-GGUFM/M8R4
#     closure), so this module's helpers that name manifestum types
#     (GgufManifestError, LectioFontis, MetadatumGguf, ManifestumGguf)
#     and call their accessors import cleanly. gguf_manifest stays the
#     single GGUF parser authority.
#   * Proba proof is compile-level until the FMIR stepper / faber test
#     path covers library probas (capsule.fab residual); `faber check`
#     proves the whole surface type-checks.
#   * Public signatures stay on primitives plus capsula.Capsula and this
#     module's own GgufError so the proba file-interface keeps every
#     export.
#
# --- Seams ---------------------------------------------------------------
#   * tokenizer probe parity (P1–P11, workload id lists) — PML2-U4.
#   * negative-matrix conformance suite across U2/U3/U4 — PML2-U6.
#   * norma:model + GI1 admission migration (no dual authority) — PML2-U5.
#   * digest computation — the admission host (pure-Rust, GI1).

import from "gradus:model/artifact" artifact

import from "gradus:model/capsule" capsula

import from "gradus:model/gguf_manifest" manifestum

# -------------------------------------------------------------------------
# Row contract — pinned constants. Row facts mirror gi0-model-contract
# v1.0.0 (§1–§5) and gi1-closeout.md exit-gate bullets 2/4/6; the GGML
# type ids are pinned to the toolchain table (same ids the manifestum
# authority resolves).
# -------------------------------------------------------------------------

# --- format / version ----------------------------------------------------
const int CONCORDATIO ← 32
# GGUF_DEFAULT_ALIGNMENT.
const int FILE_TYPE ← 15
# general.file_type (MOSTLY_Q4_K_M).
const int QUANTIZATIO_VERSION ← 2
# general.quantization_version.

# --- GGML type ids (pinned toolchain ggml.h, llama.cpp a957b7747) --------
const int GGML_F32 ← 0

const int GGML_Q5_0 ← 6

const int GGML_Q8_0 ← 8

const int GGML_Q4_K ← 12

const int GGML_Q6_K ← 14

# --- architecture facts (gi0-model-contract §2) --------------------------
const string ARCHITECTURA ← "llama"

const int STRATA ← 32
# llama.block_count.
const int CONTEXTUS ← 8192
# llama.context_length.
const int VOCABULUM ← 49152
# llama.vocab_size.
const int EMBEDDING ← 960
# llama.embedding_length.

# --- tokenizer facts (gi0-model-contract §4) -----------------------------
const string TOKENIZATOR_MODEL ← "gpt2"

const string TOKENIZATOR_PRE ← "smollm"

const int BOS_ID ← 1

const int EOS_ID ← 2

const int PAD_ID ← 2

const int UNK_ID ← 0

# --- library hard ceilings (mirror capsule.fab / gradus:shape U3) --------
const int DIMENSI_LIMES ← 65536

const int ELEMENTA_LIMES ← 1000000000

const int NOMEN_LIMES ← 128

const int KV_LIMES ← 4096
# metadata KV count ceiling.
const int TENSORUM_LIMES ← 65536
# tensor count ceiling.

# -------------------------------------------------------------------------
# GgufError — typed error vocabulary of the GGUF admission boundary. Every
# variant carries a textus causa (render via causa). Variant → dimension:
#   FormatMala       — bad magic (not a GGUF file).
#   VersioIgnota     — unsupported GGUF file version.
#   ArchitecturaMala — architecture facts (arch id, layers, context,
#                      vocab, embedding).
#   QuantizatioIgnota— dtype/quantization: file type, quant version, ggml
#                      type, block layout, per-type tensor counts.
#   OffsetMala       — tensor offsets / data-region tiling (coverage).
#   FormaMala        — shapes: rank, dims, total element count.
#   TokenizerMala    — tokenizer identity facts.
#   LimitesMala      — count ceilings (kv/tensor/element, key length).
#   WireMala         — malformed bytes: truncation, unknown/duplicate
#                      keys or tensor names, string ceilings, overflow.
#   CapsulaMala      — capsule construction failed.
#
# Wire/format rejections detected by the manifestum authority surface as
# WireMala carrying the authority's typed causa (rendered verbatim), per
# the A1C one-authority boundary.
# -------------------------------------------------------------------------

union GgufError {
    FormatMala {
        string causa
    },
    VersioIgnota {
        string causa
    },
    ArchitecturaMala {
        string causa
    },
    QuantizatioIgnota {
        string causa
    },
    OffsetMala {
        string causa
    },
    FormaMala {
        string causa
    },
    TokenizerMala {
        string causa
    },
    LimitesMala {
        string causa
    },
    WireMala {
        string causa
    },
    CapsulaMala {
        string causa
    }
}

fn causa(GgufError e) → string {
    match e {
        case FormatMala const causa {
            return causa
        }
        case VersioIgnota const causa {
            return causa
        }
        case ArchitecturaMala const causa {
            return causa
        }
        case QuantizatioIgnota const causa {
            return causa
        }
        case OffsetMala const causa {
            return causa
        }
        case FormaMala const causa {
            return causa
        }
        case TokenizerMala const causa {
            return causa
        }
        case LimitesMala const causa {
            return causa
        }
        case WireMala const causa {
            return causa
        }
        case CapsulaMala const causa {
            return causa
        }
    }
}

# -------------------------------------------------------------------------
# Private helpers over the manifestum authority. The range source slices
# the caller-owned bytes; the accessor wrappers map the authority's typed
# GgufManifestError into this module's GgufError vocabulary. None of these
# helpers parse wire bytes — the manifestum authority already validated
# them during inspice.
# -------------------------------------------------------------------------

# Range source over the supplied byte list (the caller-owned corpus). A
# read beyond the bytes fails the read; the manifestum authority turns the
# failure into a typed FonsMala.
@ private { }
fn _fons(list<int<u8>> b, int initium, int longitudo) → manifestum.LectioFontis {
    if (initium ≺ 0 or longitudo ≺ 0) or initium ≻ b.length() - longitudo then return manifestum.LectioFontis {successus = false, bytes = ||, causa = "range read beyond the supplied bytes"}
    const list<int<u8>> segmentum ← b.slice(initium, initium + longitudo)
    const bytes bytes_o ← segmentum ↦ bytes
    return manifestum.LectioFontis {successus = true, bytes = bytes_o, causa = ""}
}

# Map the authority's typed error into this module's vocabulary, preserving
# its causa (rendered verbatim by the authority's own renderer).
@ private { }
fn _errorem_manifesti(manifestum.GgufManifestError e) → GgufError {
    return variant WireMala {causa = manifestum.causa(e)}
}

# Inspect the header/metadata/tensor-table corpus via the authority.
@ private { }
fn _inspice(list<int<u8>> b, artifact.IdentitasContenuti identitas) → manifestum.ManifestumGguf ⇥ GgufError {
    do {
        return manifestum.inspice((int initium, int longitudo) → manifestum.LectioFontis ∴ _fons(b, initium, longitudo), b.length(), identitas)
    }
    catch err {
        throw _errorem_manifesti(err)
    }
    throw variant WireMala {causa = "unreachable"}
}

# String metadata accessor, authority-mapped.
@ private { }
fn _textus_pacta(manifestum.ManifestumGguf m, string clavis) → string ⇥ GgufError {
    do {
        const string v ← manifestum.textum(m, clavis)
        return v
    }
    catch err {
        throw _errorem_manifesti(err)
    }
    throw variant WireMala {causa = "unreachable"}
}

# Integer metadata accessor, authority-mapped.
@ private { }
fn _numerus_pacta(manifestum.ManifestumGguf m, string clavis) → int ⇥ GgufError {
    do {
        const int v ← manifestum.numerum(m, clavis)
        return v
    }
    catch err {
        throw _errorem_manifesti(err)
    }
    throw variant WireMala {causa = "unreachable"}
}

# BOOL metadata value (the authority has no integer accessor for the BOOL
# wire kind; the carried value's first byte is the validated 0/1).
@ private { }
fn _bivalens_pacta(manifestum.ManifestumGguf m, string clavis) → int ⇥ GgufError {
    var manifestum.MetadatumGguf md ← manifestum.MetadatumGguf {clavis = "", typo = -1, valor_wire = ||}
    do {
        md ← manifestum.metadatum(m, clavis)
    }
    catch err {
        throw _errorem_manifesti(err)
    }
    const bytes wire ← md.valor_wire
    if wire.length() ≺ 1 {
        throw variant WireMala {causa = "malformed bool value"}
    }
    const int v ← wire.get(0) coalesce 0 ∷ int<u8> ↦ int
    return v
}

# List membership (textus).
@ private { }
fn _continet(list<string> xs, string x) → bool {
    var int i ← 0
    while i ≺ xs.length() {
        if xs.get(i) coalesce "" ≡ x then return true
        i ← i + 1
    }
    return false
}

# The admitted metadata KEY SET is pinned (the 37 keys of the pinned row,
# gi0 evidence contract-gguf-metadata.txt): a key outside it fails closed.
# A pure predicate over carried metadata keys — no wire parsing.
@ private { }
fn _clavis_pacta(string k) → bool {
    if k ≡ "general.architecture" then return true
    if k ≡ "general.basename" then return true
    if k ≡ "general.file_type" then return true
    if k ≡ "general.finetune" then return true
    if k ≡ "general.languages" then return true
    if k ≡ "general.license" then return true
    if k ≡ "general.name" then return true
    if k ≡ "general.organization" then return true
    if k ≡ "general.quantization_version" then return true
    if k ≡ "general.size_label" then return true
    if k ≡ "general.type" then return true
    if k ≡ "llama.attention.head_count" then return true
    if k ≡ "llama.attention.head_count_kv" then return true
    if k ≡ "llama.attention.layer_norm_rms_epsilon" then return true
    if k ≡ "llama.block_count" then return true
    if k ≡ "llama.context_length" then return true
    if k ≡ "llama.embedding_length" then return true
    if k ≡ "llama.feed_forward_length" then return true
    if k ≡ "llama.rope.dimension_count" then return true
    if k ≡ "llama.rope.freq_base" then return true
    if k ≡ "llama.vocab_size" then return true
    if k ≡ "quantize.imatrix.chunks_count" then return true
    if k ≡ "quantize.imatrix.dataset" then return true
    if k ≡ "quantize.imatrix.entries_count" then return true
    if k ≡ "quantize.imatrix.file" then return true
    if k ≡ "tokenizer.chat_template" then return true
    if k ≡ "tokenizer.ggml.add_bos_token" then return true
    if k ≡ "tokenizer.ggml.add_space_prefix" then return true
    if k ≡ "tokenizer.ggml.bos_token_id" then return true
    if k ≡ "tokenizer.ggml.eos_token_id" then return true
    if k ≡ "tokenizer.ggml.merges" then return true
    if k ≡ "tokenizer.ggml.model" then return true
    if k ≡ "tokenizer.ggml.padding_token_id" then return true
    if k ≡ "tokenizer.ggml.pre" then return true
    if k ≡ "tokenizer.ggml.token_type" then return true
    if k ≡ "tokenizer.ggml.tokens" then return true
    if k ≡ "tokenizer.ggml.unknown_token_id" then return true
    return false
}

# -------------------------------------------------------------------------
# admit — the fail-closed GGUF admission. A thin schema-2 wrapper (D3):
# inspects the header/metadata/tensor-table corpus through the manifestum
# authority, validates the pinned one-row contract through manifest
# accessors, and builds the schema-2 capsule. Every count is ceilings-
# checked BEFORE the authority is invoked; the whole-file SHA-256 is
# host-computed and passed in as the pathless content identity.
# -------------------------------------------------------------------------

fn admit(list<int<u8>> bytes, string digestio, int expectatum_kv, int expectatum_tensorum, int expectatum_elementa, int expectatum_f32, int expectatum_q4k, int expectatum_q5, int expectatum_q6, int expectatum_q8) → capsula.Capsula ⇥ GgufError {
    # --- ceilings before any count-driven iteration (fail closed) --------
    if expectatum_kv ≺ 1 or expectatum_kv ≻ KV_LIMES {
        throw variant LimitesMala {causa = "expected kv count outside the admitted range"}
    }
    if expectatum_tensorum ≺ 1 or expectatum_tensorum ≻ TENSORUM_LIMES {
        throw variant LimitesMala {causa = "expected tensor count outside the admitted range"}
    }
    if expectatum_elementa ≺ 1 or expectatum_elementa ≻ ELEMENTA_LIMES {
        throw variant LimitesMala {causa = "expected element count outside the admitted range"}
    }
    if (((expectatum_f32 ≺ 0 or expectatum_q4k ≺ 0) or expectatum_q5 ≺ 0) or expectatum_q6 ≺ 0) or expectatum_q8 ≺ 0 {
        throw variant LimitesMala {causa = "expected tensor type counts outside the admitted range"}
    }
    if (((expectatum_f32 + expectatum_q4k) + expectatum_q5) + expectatum_q6) + expectatum_q8 ≠ expectatum_tensorum {
        throw variant LimitesMala {causa = "expected tensor type counts do not sum to the tensor count"}
    }

    # --- format guard (truncated header) before the authority -------------
    if bytes.length() ≺ 24 {
        throw variant WireMala {causa = "truncated gguf header"}
    }

    # --- inspect the header/metadata/tensor-table via the authority -------
    const artifact.IdentitasContenuti identitas ← artifact.IdentitasContenuti {algorithmus = "sha-256", digestio = digestio, longitudo = bytes.length()}
    const manifestum.ManifestumGguf m ← _inspice(bytes, identitas)

    # --- counts (the pinned one-row contract) -----------------------------
    if m.tensores.length() ≠ expectatum_tensorum {
        throw variant LimitesMala {causa = "tensor count mismatch"}
    }
    if m.metadata.length() ≠ expectatum_kv {
        throw variant LimitesMala {causa = "metadata KV count mismatch"}
    }

    # --- admitted metadata key set + required keys (fail closed) ----------
    var list<string> claves ← vacua
    for from m.metadata const md {
        if md.clavis.length() ≻ NOMEN_LIMES {
            throw variant LimitesMala {causa = "metadata key exceeds the 128-byte ceiling"}
        }
        if not _clavis_pacta(md.clavis) {
            throw variant WireMala {causa = "unknown metadata key"}
        }
        claves.append(md.clavis)
    }
    if not _continet(claves, "general.architecture") {
        throw variant ArchitecturaMala {causa = "missing required metadata key: general.architecture"}
    }
    if not _continet(claves, "general.file_type") {
        throw variant QuantizatioIgnota {causa = "missing required metadata key: general.file_type"}
    }
    if not _continet(claves, "general.quantization_version") {
        throw variant QuantizatioIgnota {causa = "missing required metadata key: general.quantization_version"}
    }
    if not _continet(claves, "llama.block_count") {
        throw variant ArchitecturaMala {causa = "missing required metadata key: llama.block_count"}
    }
    if not _continet(claves, "llama.context_length") {
        throw variant ArchitecturaMala {causa = "missing required metadata key: llama.context_length"}
    }
    if not _continet(claves, "llama.vocab_size") {
        throw variant ArchitecturaMala {causa = "missing required metadata key: llama.vocab_size"}
    }
    if not _continet(claves, "llama.embedding_length") {
        throw variant ArchitecturaMala {causa = "missing required metadata key: llama.embedding_length"}
    }
    if not _continet(claves, "tokenizer.ggml.model") {
        throw variant TokenizerMala {causa = "missing required metadata key: tokenizer.ggml.model"}
    }
    if not _continet(claves, "tokenizer.ggml.pre") {
        throw variant TokenizerMala {causa = "missing required metadata key: tokenizer.ggml.pre"}
    }
    if not _continet(claves, "tokenizer.ggml.bos_token_id") {
        throw variant TokenizerMala {causa = "missing required metadata key: tokenizer.ggml.bos_token_id"}
    }
    if not _continet(claves, "tokenizer.ggml.eos_token_id") {
        throw variant TokenizerMala {causa = "missing required metadata key: tokenizer.ggml.eos_token_id"}
    }
    if not _continet(claves, "tokenizer.ggml.padding_token_id") {
        throw variant TokenizerMala {causa = "missing required metadata key: tokenizer.ggml.padding_token_id"}
    }
    if not _continet(claves, "tokenizer.ggml.unknown_token_id") {
        throw variant TokenizerMala {causa = "missing required metadata key: tokenizer.ggml.unknown_token_id"}
    }
    if not _continet(claves, "tokenizer.ggml.add_bos_token") {
        throw variant TokenizerMala {causa = "missing required metadata key: tokenizer.ggml.add_bos_token"}
    }
    if not _continet(claves, "tokenizer.ggml.add_space_prefix") {
        throw variant TokenizerMala {causa = "missing required metadata key: tokenizer.ggml.add_space_prefix"}
    }

    # --- pinned required metadata VALUES (through manifest accessors) -----
    if _textus_pacta(m, "general.architecture") ≠ ARCHITECTURA {
        throw variant ArchitecturaMala {causa = "architecture mismatch"}
    }
    if _numerus_pacta(m, "general.file_type") ≠ FILE_TYPE {
        throw variant QuantizatioIgnota {causa = "file type mismatch"}
    }
    if _numerus_pacta(m, "general.quantization_version") ≠ QUANTIZATIO_VERSION {
        throw variant QuantizatioIgnota {causa = "quantization version mismatch"}
    }
    if _numerus_pacta(m, "llama.block_count") ≠ STRATA {
        throw variant ArchitecturaMala {causa = "layer count mismatch"}
    }
    if _numerus_pacta(m, "llama.context_length") ≠ CONTEXTUS {
        throw variant ArchitecturaMala {causa = "context length mismatch"}
    }
    if _numerus_pacta(m, "llama.vocab_size") ≠ VOCABULUM {
        throw variant ArchitecturaMala {causa = "vocabulary size mismatch"}
    }
    if _numerus_pacta(m, "llama.embedding_length") ≠ EMBEDDING {
        throw variant ArchitecturaMala {causa = "embedding size mismatch"}
    }
    if _textus_pacta(m, "tokenizer.ggml.model") ≠ TOKENIZATOR_MODEL {
        throw variant TokenizerMala {causa = "tokenizer model mismatch"}
    }
    if _textus_pacta(m, "tokenizer.ggml.pre") ≠ TOKENIZATOR_PRE {
        throw variant TokenizerMala {causa = "tokenizer pre-tokenizer mismatch"}
    }
    if _numerus_pacta(m, "tokenizer.ggml.bos_token_id") ≠ BOS_ID {
        throw variant TokenizerMala {causa = "bos token id mismatch"}
    }
    if _numerus_pacta(m, "tokenizer.ggml.eos_token_id") ≠ EOS_ID {
        throw variant TokenizerMala {causa = "eos token id mismatch"}
    }
    if _numerus_pacta(m, "tokenizer.ggml.padding_token_id") ≠ PAD_ID {
        throw variant TokenizerMala {causa = "padding token id mismatch"}
    }
    if _numerus_pacta(m, "tokenizer.ggml.unknown_token_id") ≠ UNK_ID {
        throw variant TokenizerMala {causa = "unknown token id mismatch"}
    }
    if _bivalens_pacta(m, "tokenizer.ggml.add_bos_token") ≠ 0 {
        throw variant TokenizerMala {causa = "add_bos_token mismatch"}
    }
    if _bivalens_pacta(m, "tokenizer.ggml.add_space_prefix") ≠ 0 {
        throw variant TokenizerMala {causa = "add_space_prefix mismatch"}
    }

    # --- tensor table (the pinned one-row contract through descriptors) --
    var int tot_elementa ← 0
    var int visi_f32 ← 0
    var int visi_q4k ← 0
    var int visi_q5 ← 0
    var int visi_q6 ← 0
    var int visi_q8 ← 0
    var int cursus_data ← 0
    var int tot_octeti ← 0
    for from m.tensores const t {
        if t.forma.length() ≠ 1 and t.forma.length() ≠ 2 {
            throw variant FormaMala {causa = "unsupported tensor rank"}
        }
        var int d ← 0
        while d ≺ t.forma.length() {
            const int dim ← t.forma.get(d) coalesce 0
            if dim ≻ DIMENSI_LIMES {
                throw variant FormaMala {causa = "invalid tensor dimension"}
            }
            d ← d + 1
        }
        if t.nomen.length() ≻ NOMEN_LIMES {
            throw variant WireMala {causa = "tensor name exceeds the 128-byte ceiling"}
        }
        if (((t.typo_ggml ≠ GGML_F32 and t.typo_ggml ≠ GGML_Q4_K) and t.typo_ggml ≠ GGML_Q5_0) and t.typo_ggml ≠ GGML_Q6_K) and t.typo_ggml ≠ GGML_Q8_0 {
            throw variant QuantizatioIgnota {causa = "unknown ggml tensor type"}
        }
        if tot_elementa ≻ expectatum_elementa - t.elementa {
            throw variant FormaMala {causa = "tensor element count above the expected total"}
        }
        tot_elementa ← tot_elementa + t.elementa
        if t.offset_relativum ≠ cursus_data {
            throw variant OffsetMala {causa = "tensor offsets are not contiguous"}
        }
        match t.layout {
            case manifestum.Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
                if longitudo_octetorum % CONCORDATIO ≠ 0 {
                    throw variant QuantizatioIgnota {causa = "tensor byte size not a multiple of the 32-byte data alignment"}
                }
                cursus_data ← cursus_data + longitudo_octetorum
                tot_octeti ← tot_octeti + longitudo_octetorum
            }
            case manifestum.Ignota const typo {
                throw variant QuantizatioIgnota {causa = "unknown ggml tensor layout"}
            }
        }
        if t.typo_ggml ≡ GGML_F32 {
            visi_f32 ← visi_f32 + 1
        }
        if t.typo_ggml ≡ GGML_Q4_K {
            visi_q4k ← visi_q4k + 1
        }
        if t.typo_ggml ≡ GGML_Q5_0 {
            visi_q5 ← visi_q5 + 1
        }
        if t.typo_ggml ≡ GGML_Q6_K {
            visi_q6 ← visi_q6 + 1
        }
        if t.typo_ggml ≡ GGML_Q8_0 {
            visi_q8 ← visi_q8 + 1
        }
    }

    # --- exact row facts --------------------------------------------------
    if tot_elementa ≠ expectatum_elementa {
        throw variant FormaMala {causa = "total element count mismatch"}
    }
    if (((visi_f32 ≠ expectatum_f32 or visi_q4k ≠ expectatum_q4k) or visi_q5 ≠ expectatum_q5) or visi_q6 ≠ expectatum_q6) or visi_q8 ≠ expectatum_q8 {
        throw variant QuantizatioIgnota {causa = "tensor type count mismatch"}
    }

    # --- data region: exact tiling to EOF (coverage_ok) -------------------
    if tot_octeti ≠ m.longitudo_artifacti - m.data_inceptum {
        throw variant OffsetMala {causa = "data region does not tile exactly"}
    }

    # --- capsule construction (capsule-schema-2.0.0, A1C-M1) --------------
    do {
        const capsula.Capsula c ← capsula.structa_manifestum(capsula.schema_versio, m.identitas, capsula.manifestum_gguf(m))
        return c
    }
    catch err {
        throw variant CapsulaMala {causa = "capsule construction failed: " + capsula.causa(err)}
    }
    throw variant CapsulaMala {causa = "unreachable"}
}
