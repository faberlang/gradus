+++ toml
locale = "en"

+++ faber
# GGUF row admission — the selected GGUF row parses → schema-2 capsule
# (PML2-U3, capsule-schema-2.0.0, A1C-M2).
#
# Public import: import from "gradus:model/gguf" private gguf
# Depends on: gradus:model/capsule (capsule-schema-2.0.0, PML2-U1),
#             gradus:model/gguf_manifest (the one GGUF wire authority, A1b),
#             gradus:model/artifact (pathless content identity).
#
# --- Contract ------------------------------------------------------------
#
# One admitted GGUF row: SmolLM2-360M-Instruct-Q4_K_M (bartowski imatrix
# quant, llama.cpp b3772) — the pinned row of gi0-model-contract v1.0.0 /
# gi1-closeout.md (read-only facts, cited below). The row parses → a
# fail-closed capsule with rejection on the pinned one-row contract.
#
# D3 clean break (A1C-M2): the schema-1 wire parser (byte readers,
# admitted-key predicate, block-layout helpers) is DELETED. `admit` calls
# `admit_with_manifest` and returns its capsule; `admit_with_manifest` is the
# one validation path over gradus:model/gguf_manifest — it inspects
# the header/metadata/tensor table through `gguf_manifest.inspect` over a
# caller-owned byte range and validates the pinned one-row contract
# through manifest accessors (`text`/`number`/`metadata`, the carried
# metadata/tensor descriptors). No alias, no forwarding import, no
# compatibility parser remains.
#
# Fail-closed dimensions, by owner:
#   manifest (the wire authority): magic, GGUF version, count ceilings,
#       duplicate keys/tensor names, value wire kinds, UTF-8, string/key
#       ceilings, tensor rank/dim bounds, GGML block layout, tensor range
#       overlap, identity-form checks.
#   this module (the pinned row): expected counts (KV/tensor/element and
#       the exact per-type tensor counts F32 65 / Q4_K 16 / Q5_0 176 /
#       Q6_K 16 / Q8_0 17), the admitted 37-key metadata set (an unknown
#       key fails closed), the 15 required keys, the pinned metadata
#       VALUES (architecture, file type, quant version, block/context/
#       vocab/embedding counts, tokenizer model/pre/ids/bools), tensor
#       rank/shape ceilings and offsets, and the exact data-region tiling
#       (coverage_ok).
#
# The whole-file SHA-256 is computed by the admission host (pure-Rust, per
# capsule.fab) and passed in; this module builds the schema-2 capsule,
# which validates the digest form and carries the pathless content
# identity. Raw bytes are never a trust anchor — only the capsule carries
# identity (capsule-schema-2.0.0, C8).
#
# One-row boundary (gi1 exit-gate bullet 5): the constants below pin the
# selected row only; a wider admission is a row-contract change. Scaled
# structural fixtures exercise the RULES (same posture as capsule.proba);
# the pinned values exercise the row. No runtime claim is generalized
# beyond the selected row.
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * The manifest authority's public names are @ public (V-GGUFM/M8R4
#     closure), so this module's helpers that name manifest types
#     (GgufManifestError, GgufMetadata, GgufManifest)
#     and call their accessors import cleanly. gguf_manifest stays the
#     single GGUF parser authority; ManifestError retains its typed failures
#     across this row-admission boundary.
#   * Proba proof is compile-level until the FMIR stepper / faber test
#     path covers library probas (capsule.fab residual); `faber check`
#     proves the whole surface type-checks.
#   * Public signatures stay on primitives plus capsule.Capsule and this
#     module's own GgufError so the proba file-interface keeps every
#     export.
#
# --- Seams ---------------------------------------------------------------
#   * tokenizer probe parity (P1–P11, workload id lists) — PML2-U4.
#   * negative-matrix conformance suite across U2/U3/U4 — PML2-U6.
#   * norma:model + GI1 admission migration (no dual authority) — PML2-U5.
#   * digest computation — the admission host (pure-Rust, GI1).

import from "gradus:model/artifact" let artifact

import from "gradus:model/capsule" let capsule

import from "gradus:model/gguf_manifest" let gguf_manifest

# -------------------------------------------------------------------------
# Row contract — pinned constants. Row facts mirror gi0-model-contract
# v1.0.0 (§1–§5) and gi1-closeout.md exit-gate bullets 2/4/6; the GGML
# type ids are pinned to the toolchain table (same ids the manifest
# authority resolves).
# -------------------------------------------------------------------------

# --- format / version ----------------------------------------------------
const int ALIGNMENT = 32
# GGUF_DEFAULT_ALIGNMENT.
const int QUANTIZATION_VERSION = 2
# general.quantization_version.

# --- GGML type ids (pinned toolchain ggml.h, llama.cpp a957b7747) --------
const int GGML_F32 = 0

const int GGML_Q5_0 = 6

const int GGML_Q8_0 = 8

const int GGML_Q4_K = 12

const int GGML_Q6_K = 14

# --- architecture facts (gi0-model-contract §2) --------------------------
const string ARCHITECTURE = "llama"

const int LAYERS = 32
# llama.block_count.
const int CONTEXT = 8192
# llama.context_length.
const int VOCAB = 49152
# llama.vocab_size.
const int EMBEDDING = 960
# llama.embedding_length.

# --- tokenizer facts (gi0-model-contract §4) -----------------------------
const string TOKENIZER_MODEL = "gpt2"

const string TOKENIZER_PRE = "smollm"

const int BOS_ID = 1

const int EOS_ID = 2

const int UNK_ID = 0

# --- admitted metadata keys (gi0 evidence contract-gguf-metadata.txt) ----
# Not a top-level static (D5.8/D5.9): the `↦ set<string>` conversion is not
# compile-time evaluable, so the value moves into a function.
fn admitted_keys() → set<string> {
    return [
        "general.architecture",
        "general.basename",
        "general.file_type",
        "general.finetune",
        "general.languages",
        "general.license",
        "general.name",
        "general.organization",
        "general.quantization_version",
        "general.size_label",
        "general.type",
        "llama.attention.head_count",
        "llama.attention.head_count_kv",
        "llama.attention.key_length",
        "llama.attention.value_length",
        "llama.attention.layer_norm_rms_epsilon",
        "llama.block_count",
        "llama.context_length",
        "llama.embedding_length",
        "llama.feed_forward_length",
        "llama.rope.dimension_count",
        "llama.rope.freq_base",
        "llama.vocab_size",
        "quantize.imatrix.chunks_count",
        "quantize.imatrix.dataset",
        "quantize.imatrix.entries_count",
        "quantize.imatrix.file",
        "tokenizer.chat_template",
        "tokenizer.ggml.add_bos_token",
        "tokenizer.ggml.add_space_prefix",
        "tokenizer.ggml.bos_token_id",
        "tokenizer.ggml.eos_token_id",
        "tokenizer.ggml.merges",
        "tokenizer.ggml.model",
        "tokenizer.ggml.padding_token_id",
        "tokenizer.ggml.pre",
        "tokenizer.ggml.token_type",
        "tokenizer.ggml.tokens",
        "tokenizer.ggml.unknown_token_id"
    ] ↦ set<string>
}

# --- bounded parser resources --------------------------------------------
const int NAME_LIMIT = 128

const int KV_LIMIT = 4096
# metadata KV count ceiling.
const int TENSOR_LIMIT = 65536
# tensor count ceiling.

# -------------------------------------------------------------------------
# GgufError — typed error vocabulary of the GGUF admission boundary. Every
# variant carries a text message (render via message). Variant → dimension:
#   BadFormat       — bad magic (not a GGUF file).
#   UnknownVersion     — unsupported GGUF file version.
#   BadArchitecture — architecture facts (arch id, layers, context,
#                      vocab, embedding).
#   UnknownQuantization— dtype/quantization: file type, quant version, ggml
#                      type, block layout, per-type tensor counts.
#   BadOffset       — tensor offsets / data-region tiling (coverage).
#   BadShape        — shapes: rank, dims, total element count.
#   BadTokenizer    — tokenizer identity facts.
#   BadBounds      — count ceilings (kv/tensor/element, key length).
#   BadWire         — malformed bytes: truncation, unknown/duplicate
#                      keys or tensor names, string ceilings, overflow.
#   BadCapsule      — capsule construction failed.
#
# Wire/format rejections detected by the manifest authority surface as
# ManifestError carrying the authority's typed value and shared message, per
# the A1C one-authority boundary.
# -------------------------------------------------------------------------

@ public
union GgufError {
    @ shared
    string message

    BadFormat,
    UnknownVersion,
    BadArchitecture,
    UnknownQuantization,
    BadOffset,
    BadShape,
    BadTokenizer,
    BadBounds,
    BadWire,
    BadCapsule,
    ManifestError {
        gguf_manifest.GgufManifestError inner
    }
}

@ conversion
fn from_gguf_manifest_error(gguf_manifest.GgufManifestError err) → GgufError {
    return variant ManifestError {message = err.message, inner = err}
}



# -------------------------------------------------------------------------
# Private helpers over the manifest authority. The range source slices
# the caller-owned bytes; the accessor wrappers map the authority's typed
# GgufManifestError into this module's GgufError vocabulary. None of these
# helpers parse wire bytes — the manifest authority already validated
# them during inspect.
# -------------------------------------------------------------------------

# Range source over the supplied byte list (the caller-owned corpus). A
# read beyond the bytes fails the read; the manifest authority turns the
# failure into a typed BadSource.
fn source(list<u8> b, int start, int length) → list<b8> ⇥ gguf_manifest.GgufManifestError {
    reject ((start ≺ 0 or length ≺ 0) or start ≻ b.length() - length) throw variant BadSource {message = "range read beyond the supplied bytes"}
    let list<u8> segment ← b[start‥start + length]
    return segment ↦ list<b8>
}

# Inspect the header/metadata/tensor-table corpus via the authority. `b` is
# the header prefix; `artifact_length` is the whole artifact's length (the
# prefix may be shorter). A read past the prefix fails closed as BadSource.
fn inspect(list<u8> b, int artifact_length, artifact.ContentIdentity identity) → gguf_manifest.GgufManifest ⇥ GgufError {
    return gguf_manifest.inspect((int start, int length) → list<b8> ⇥ gguf_manifest.GgufManifestError ∴ source(b, start, length), artifact_length, identity)
}

# String metadata accessor, authority-mapped.
fn text_value(gguf_manifest.GgufManifest m, string key) → string ⇥ GgufError {
    return gguf_manifest.text(m, key)
}

# Integer metadata accessor, authority-mapped.
fn number_value(gguf_manifest.GgufManifest m, string key) → int ⇥ GgufError {
    return gguf_manifest.number(m, key)
}

# BOOL metadata value (the authority has no integer accessor for the BOOL
# wire kind; the carried value's first byte is the validated 0/1).
fn bool_value(gguf_manifest.GgufManifest m, string key) → int ⇥ GgufError {
    mut gguf_manifest.GgufMetadata md ← gguf_manifest.GgufMetadata {key = "", dtype = -1, payload_wire = ||}
    md ← gguf_manifest.metadata(m, key)
    let list<b8> wire ← md.payload_wire
    require wire.length() ≥ 1 throw variant BadWire {message = "malformed bool value"}
    let int v ← (wire.get(0) coalesce 0x00 ∷ b8) ↦ u8 ↦ int
    return v
}

# Admitted-key predicate. The admitted-key set is built once per admission,
# before the metadata loop (issue #83); a key outside it fails closed.
fn key_value(set<string> admitted, string k) → bool {
    return k ∈ admitted
}

# -------------------------------------------------------------------------
# admit — the fail-closed GGUF admission. A thin schema-2 wrapper (D3):
# inspects the header/metadata/tensor-table corpus through the manifest
# authority, validates the pinned one-row contract through manifest
# accessors, and builds the schema-2 capsule. Every count is ceilings-
# checked BEFORE the authority is invoked; the whole-file SHA-256 is
# host-computed and passed in as the pathless content identity.
# -------------------------------------------------------------------------

# The admitted row: the schema-2 capsule plus the manifest the authority
# inspected while admitting it. A caller that needs the manifest (tokenizer
# tables, tensor descriptors) takes it from here instead of parsing the same
# header a second time.
@ public
class Admission {
    mut capsule.Capsule cap
    mut gguf_manifest.GgufManifest manifest
}

# admit — the capsule only; a thin caller of the one validation path.
@ public
fn admit(list<u8> bytes, string digest, int artifact_length, int expected_file_type, int expected_pad_id, int expected_kv, int expected_tensors, int expected_elements, int expected_f32, int expected_q4k, int expected_q5, int expected_q6, int expected_q8) → capsule.Capsule ⇥ GgufError {
    let Admission a ← admit_with_manifest(bytes, digest, artifact_length, expected_file_type, expected_pad_id, expected_kv, expected_tensors, expected_elements, expected_f32, expected_q4k, expected_q5, expected_q6, expected_q8)
    return a.cap
}

# admit_with_manifest — the one fail-closed validation path; returns the
# capsule together with the inspected manifest.
@ public
fn admit_with_manifest(list<u8> bytes, string digest, int artifact_length, int expected_file_type, int expected_pad_id, int expected_kv, int expected_tensors, int expected_elements, int expected_f32, int expected_q4k, int expected_q5, int expected_q6, int expected_q8) → Admission ⇥ GgufError {
    # --- ceilings before any count-driven iteration (fail closed) --------
    # `bytes` is the header prefix (or the whole file); `artifact_length` is
    # the whole artifact's length, which the digest was computed over.
    require artifact_length ≥ bytes.length() throw variant BadBounds {message = "artifact length is shorter than the supplied bytes"}
    reject (expected_kv ≺ 1 or expected_kv ≻ KV_LIMIT) throw variant BadBounds {message = "expected kv count outside the admitted range"}
    reject (expected_tensors ≺ 1 or expected_tensors ≻ TENSOR_LIMIT) throw variant BadBounds {message = "expected tensor count outside the admitted range"}
    require expected_elements ≥ 1 throw variant BadBounds {message = "expected element count must be positive"}
    reject ((((expected_f32 ≺ 0 or expected_q4k ≺ 0) or expected_q5 ≺ 0) or expected_q6 ≺ 0) or expected_q8 ≺ 0) throw variant BadBounds {message = "expected tensor type counts outside the admitted range"}
    require (((expected_f32 + expected_q4k) + expected_q5) + expected_q6) + expected_q8 ≡ expected_tensors throw variant BadBounds {message = "expected tensor type counts do not sum to the tensor count"}

    # --- format guard (truncated header) before the authority -------------
    require bytes.length() ≥ 24 throw variant BadWire {message = "truncated gguf header"}

    # --- inspect the header/metadata/tensor-table via the authority -------
    let artifact.ContentIdentity identity ← artifact.ContentIdentity {algorithm = "sha-256", digest = digest, length = artifact_length}
    let gguf_manifest.GgufManifest m ← inspect(bytes, artifact_length, identity)

    # --- counts (the pinned one-row contract) -----------------------------
    require m.tensors.length() ≡ expected_tensors throw variant BadBounds {message = "tensor count mismatch"}
    require m.metadata.length() ≡ expected_kv throw variant BadBounds {message = "metadata KV count mismatch"}

    # --- admitted metadata key set + required keys (fail closed) ----------
    # The admitted-key set is hoisted once, before the loop (issue #83): it
    # was rebuilt for every metadata key.
    let set<string> admitted ← admitted_keys()
    mut list<string> keys ← empty
    for from m.metadata let md {
        require md.key.length() ≤ NAME_LIMIT throw variant BadBounds {message = "metadata key exceeds the 128-byte ceiling"}
        require key_value(admitted, md.key) throw variant BadWire {message = "unknown metadata key"}
        keys.append(md.key)
    }
    require "general.architecture" ∈ keys throw variant BadArchitecture {message = "missing required metadata key: general.architecture"}
    require "general.file_type" ∈ keys throw variant UnknownQuantization {message = "missing required metadata key: general.file_type"}
    require "general.quantization_version" ∈ keys throw variant UnknownQuantization {message = "missing required metadata key: general.quantization_version"}
    require "llama.block_count" ∈ keys throw variant BadArchitecture {message = "missing required metadata key: llama.block_count"}
    require "llama.context_length" ∈ keys throw variant BadArchitecture {message = "missing required metadata key: llama.context_length"}
    require "llama.vocab_size" ∈ keys throw variant BadArchitecture {message = "missing required metadata key: llama.vocab_size"}
    require "llama.embedding_length" ∈ keys throw variant BadArchitecture {message = "missing required metadata key: llama.embedding_length"}
    require "tokenizer.ggml.model" ∈ keys throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.model"}
    require "tokenizer.ggml.pre" ∈ keys throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.pre"}
    require "tokenizer.ggml.bos_token_id" ∈ keys throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.bos_token_id"}
    require "tokenizer.ggml.eos_token_id" ∈ keys throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.eos_token_id"}
    require "tokenizer.ggml.padding_token_id" ∈ keys throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.padding_token_id"}
    require "tokenizer.ggml.unknown_token_id" ∈ keys throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.unknown_token_id"}
    require "tokenizer.ggml.add_bos_token" ∈ keys throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.add_bos_token"}
    require "tokenizer.ggml.add_space_prefix" ∈ keys throw variant BadTokenizer {message = "missing required metadata key: tokenizer.ggml.add_space_prefix"}

    # --- pinned required metadata VALUES (through manifest accessors) -----
    require text_value(m, "general.architecture") ≡ ARCHITECTURE throw variant BadArchitecture {message = "architecture mismatch"}
    require number_value(m, "general.file_type") ≡ expected_file_type throw variant UnknownQuantization {message = "file type mismatch"}
    require number_value(m, "general.quantization_version") ≡ QUANTIZATION_VERSION throw variant UnknownQuantization {message = "quantization version mismatch"}
    require number_value(m, "llama.block_count") ≡ LAYERS throw variant BadArchitecture {message = "layer count mismatch"}
    require number_value(m, "llama.context_length") ≡ CONTEXT throw variant BadArchitecture {message = "context length mismatch"}
    require number_value(m, "llama.vocab_size") ≡ VOCAB throw variant BadArchitecture {message = "vocabulary size mismatch"}
    require number_value(m, "llama.embedding_length") ≡ EMBEDDING throw variant BadArchitecture {message = "embedding size mismatch"}
    require text_value(m, "tokenizer.ggml.model") ≡ TOKENIZER_MODEL throw variant BadTokenizer {message = "tokenizer model mismatch"}
    require text_value(m, "tokenizer.ggml.pre") ≡ TOKENIZER_PRE throw variant BadTokenizer {message = "tokenizer pre-tokenizer mismatch"}
    require number_value(m, "tokenizer.ggml.bos_token_id") ≡ BOS_ID throw variant BadTokenizer {message = "bos token id mismatch"}
    require number_value(m, "tokenizer.ggml.eos_token_id") ≡ EOS_ID throw variant BadTokenizer {message = "eos token id mismatch"}
    require number_value(m, "tokenizer.ggml.padding_token_id") ≡ expected_pad_id throw variant BadTokenizer {message = "padding token id mismatch"}
    require number_value(m, "tokenizer.ggml.unknown_token_id") ≡ UNK_ID throw variant BadTokenizer {message = "unknown token id mismatch"}
    require bool_value(m, "tokenizer.ggml.add_bos_token") ≡ 0 throw variant BadTokenizer {message = "add_bos_token mismatch"}
    require bool_value(m, "tokenizer.ggml.add_space_prefix") ≡ 0 throw variant BadTokenizer {message = "add_space_prefix mismatch"}

    # --- tensor table (the pinned one-row contract through descriptors) --
    mut int total_elements ← 0
    mut int visi_f32 ← 0
    mut int visi_q4k ← 0
    mut int visi_q5 ← 0
    mut int visi_q6 ← 0
    mut int visi_q8 ← 0
    mut int data_cursor ← 0
    for from m.tensors let t {
        reject (t.shape.length() ≢ 1 and t.shape.length() ≢ 2) throw variant BadShape {message = "unsupported tensor rank"}
        require t.name.length() ≤ NAME_LIMIT throw variant BadWire {message = "tensor name exceeds the 128-byte ceiling"}
        reject ((((t.dtype_ggml ≢ GGML_F32 and t.dtype_ggml ≢ GGML_Q4_K) and t.dtype_ggml ≢ GGML_Q5_0) and t.dtype_ggml ≢ GGML_Q6_K) and t.dtype_ggml ≢ GGML_Q8_0) throw variant UnknownQuantization {message = "unknown ggml tensor type"}
        require total_elements ≤ expected_elements - t.elements throw variant BadShape {message = "tensor element count above the expected total"}
        total_elements ← total_elements + t.elements
        require t.relative_offset ≡ data_cursor throw variant BadOffset {message = "tensor offsets are not contiguous"}
        match t.layout {
            case gguf_manifest.Known let elements_per_block, bytes_per_block, byte_length {
                require byte_length % ALIGNMENT ≡ 0 throw variant UnknownQuantization {message = "tensor byte size not a multiple of the 32-byte data alignment"}
                data_cursor ← data_cursor + byte_length
            }
            case gguf_manifest.Unknown let kind {
                throw variant UnknownQuantization {message = "unknown ggml tensor layout"}
            }
        }
        if t.dtype_ggml ≡ GGML_F32 {
            visi_f32 ← visi_f32 + 1
        }
        if t.dtype_ggml ≡ GGML_Q4_K {
            visi_q4k ← visi_q4k + 1
        }
        if t.dtype_ggml ≡ GGML_Q5_0 {
            visi_q5 ← visi_q5 + 1
        }
        if t.dtype_ggml ≡ GGML_Q6_K {
            visi_q6 ← visi_q6 + 1
        }
        if t.dtype_ggml ≡ GGML_Q8_0 {
            visi_q8 ← visi_q8 + 1
        }
    }

    # --- exact row facts --------------------------------------------------
    require total_elements ≡ expected_elements throw variant BadShape {message = "total element count mismatch"}
    reject ((((visi_f32 ≢ expected_f32 or visi_q4k ≢ expected_q4k) or visi_q5 ≢ expected_q5) or visi_q6 ≢ expected_q6) or visi_q8 ≢ expected_q8) throw variant UnknownQuantization {message = "tensor type count mismatch"}

    # --- data region: exact tiling to EOF (coverage_ok) -------------------
    require data_cursor ≡ m.artifact_length - m.data_start throw variant BadOffset {message = "data region does not tile exactly"}

    # --- capsule construction (capsule-schema-2.0.0, A1C-M1) --------------
    do {
        let capsule.Capsule c ← capsule.construct_manifest(capsule.schema_version, m.identity, capsule.from_gguf(m))
        return Admission {cap = c, manifest = m}
    }
    catch err {
        throw variant BadCapsule {message = "capsule construction failed: §"(err.message)}
    }
    throw variant BadCapsule {message = "unreachable"}
}

+++ faber test
# Co-located package test for gguf.fab (PML2-U3 — GGUF row admission,
# capsule-schema-2.0.0, A1C-M2).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the fail-closed schema-2 GGUF admission (legal
# fixture → schema-2 capsule with pathless content identity + GGUF
# manifest), the typed rejection matrix across the pinned one-row contract
# (format/version/header, counts, metadata keys and pinned values, tensor
# shapes/offsets, coverage), and the authority boundary (wire/format
# rejections carry the manifest authority's typed message). assert
# assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
#
# NOTE (pinned-row facts): the pinned-row facts (byte length 270,590,880;
# tensor count 290; total elements 361,821,120; per-type counts F32 65 /
# Q4_K 16 / Q5_0 176 / Q6_K 16 / Q8_0 17; digest prefix 2fa3f013…bac9c2;
# metadata KV count 37; file_type 15; quantization version 2) are cited
# read-only from gi0-model-contract v1.0.0 / gi1-closeout.md. The LEGAL
# fixture is a scaled STRUCTURAL replica of the pinned row: the same
# admitted metadata values (arch llama / 32 / 8192 / 49152 / 960, gpt2 /
# smollm tokenizer, file_type 15, quant version 2, aligned 32) with a
# scaled tensor inventory (3 tensors: Q8_0 + F32 + Q4_K, exact block
# layouts). The whole-file SHA-256 is computed by the admission host
# (capsule.fab boundary) — the proba passes format-valid hex fixtures; the
# digest VALUE is asserted as carried identity.

import from "gradus:model/gguf" gguf
import from "gradus:model/capsule" capsule
import from "gradus:model/gguf_manifest" gguf_manifest
import from "gradus:model/artifact" artifact

# -- fixture contract (scaled structural replica of the pinned row) -------
# F_DIGEST is the real whole-file SHA-256 of the generated fixture
# `fixtures/gguf/smollm2-360m-scaled-row.gguf` (oracle, gguf-row-oracle.md;
# recompute with `shasum -a 256` — a re-pin is an operator decision). The
# pinned row's own digest is 2fa3f013…bac9c2 (gi1-closeout, read-only);
# the scaled fixture has its own hash and its own identity.
const string F_DIGEST = "d89c9ef917158bfb5600f417020479499c6c042f728e9a29c8457a6b1a8f0974"
const string F_ALT_DIGEST = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
const int F_KV = 18
const int F_TENSORS = 3
const int F_ELEMENTS = 4624
const int F_F32 = 1
const int F_Q4K = 1
const int F_Q5 = 0
const int F_Q6 = 0
const int F_Q8 = 1

# The GGUF magic, as bytes.
fn magica() → list<u8> {
    return bytes_of([71, 71, 85, 70])
}

# The 15 identity-bearing required keys + 3 optional admitted keys. KV
# codec: "key;type;value" (type s=string, u=u32, b=bool, as=array[string]).
const list<string> LEGAL_KVS = ["general.architecture;s;llama", "general.file_type;u;15", "general.quantization_version;u;2", "llama.block_count;u;32", "llama.context_length;u;8192", "llama.vocab_size;u;49152", "llama.embedding_length;u;960", "tokenizer.ggml.model;s;gpt2", "tokenizer.ggml.pre;s;smollm", "tokenizer.ggml.bos_token_id;u;1", "tokenizer.ggml.eos_token_id;u;2", "tokenizer.ggml.padding_token_id;u;2", "tokenizer.ggml.unknown_token_id;u;0", "tokenizer.ggml.add_bos_token;b;0", "tokenizer.ggml.add_space_prefix;b;0", "general.name;s;smollm2-fixture", "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM", "general.languages;as;en"]

# NumericBlock codec: "name;type;d1,d2;offset" (offset auto = cumulative, or a
# literal relative offset for offset mutants). Q8_0 [32,16] = 512 elems =
# 544 B; F32 [16] = 64 B; Q4_K [256,16] = 4096 elems = 2304 B; total
# 2912 B, all 32-multiples (pinned-row property).
const list<string> LEGAL_TENSORS = ["token_embd.weight;8;32,16;auto", "blk.0.attn_norm.weight;0;16;auto", "blk.0.ffn_down.weight;12;256,16;auto"]

# -- byte helpers ---------------------------------------------------------

fn bytes_of(list<int> vals) → list<u8> {
    mut list<u8> bs ← empty
    for from vals let v {
        bs.append(v ↦ u8 ⊥ 0)
    }
    return bs
}

fn bytes_bytes(string s) → list<u8> {
    let list<b8> o ↤ s
    return o ↦ list<u8>
}

fn add(list<u8> acc, list<u8> piece) → list<u8> {
    mut list<u8> out ← empty
    out.extend(acc)
    out.extend(piece)
    return out
}

fn u32_le(int n) → list<u8> {
    return (n ↦ u32 ⊥ 0) ↦ list<b8, size 4> via le ↦ list<u8>
}

fn u64_le(int n) → list<u8> {
    return (n ↦ u64 ⊥ 0) ↦ list<b8, size 8> via le ↦ list<u8>
}

fn stringa(string s) → list<u8> {
    mut list<u8> out ← u64_le(s.length())
    out.extend(bytes_bytes(s))
    return out
}

# text → number (well-formed fixture strings; 0 on malformed).
fn number_a(string s) → int {
    do {
        let int v ↤ s
        return v
    }
    catch err {
        return 0
    }
}

fn repeat(string s, int n) → string {
    mut string out ← ""
    for range 0‥n let i {
        out ← out + s
    }
    return out
}

# -- GGUF builders --------------------------------------------------------

# "key;type;value" → KV bytes (string | u32 | bool | array-of-string).
fn kv_code(string code) → list<u8> {
    let list<string> partes ← code.split(";")
    let string key ← partes.get(0) coalesce ""
    let string kind ← partes.get(1) coalesce ""
    let string payload ← partes.get(2) coalesce ""
    mut list<u8> out ← stringa(key)
    if kind ≡ "s" {
        out ← add(out, u32_le(8))
        out ← add(out, stringa(payload))
    }
    if kind ≡ "u" {
        out ← add(out, u32_le(4))
        out ← add(out, u32_le(number_a(payload)))
    }
    if kind ≡ "b" {
        out ← add(out, u32_le(7))
        if payload ≡ "1" {
            out.append(1 ↦ u8)
        }
        else {
            out.append(0 ↦ u8)
        }
    }
    if kind ≡ "as" {
        out ← add(out, u32_le(9))
        out ← add(out, u32_le(8))
        let list<string> elems ← payload.split(",")
        out ← add(out, u64_le(elems.length()))
        for from elems let e {
            out ← add(out, stringa(e))
        }
    }
    return out
}

# "name;type;d1,d2;offset" → tensor-info bytes (offset relative to the
# data-section start; auto = running cumulative).
fn code_tensor(string code, int cursor) → list<u8> {
    let list<string> partes ← code.split(";")
    let string name ← partes.get(0) coalesce ""
    let string kind ← partes.get(1) coalesce ""
    let string shape ← partes.get(2) coalesce ""
    let string offset_s ← partes.get(3) coalesce "auto"
    mut list<u8> out ← stringa(name)
    let list<string> dims ← shape.split(",")
    out ← add(out, u32_le(dims.length()))
    for from dims let dd {
        out ← add(out, u64_le(number_a(dd)))
    }
    out ← add(out, u32_le(number_a(kind)))
    mut int off_val ← cursor
    if offset_s ≢ "auto" {
        off_val ← number_a(offset_s)
    }
    out ← add(out, u64_le(off_val))
    return out
}

# Flat byte size of a tensor (block layout mirrors the admitted GGML
# table: F32 1/4, Q5_0 32/22, Q8_0 32/34, Q4_K 256/144, Q6_K 256/210).
fn tensor_extent(string code) → int {
    let list<string> partes ← code.split(";")
    let int kind ← number_a(partes.get(1) coalesce "")
    let list<string> dims ← (partes.get(2) coalesce "").split(",")
    mut int nelems ← 1
    for from dims let dd {
        nelems ← nelems * number_a(dd)
    }
    mut int blocks ← 1
    if kind ≡ 0 {
        blocks ← 1
    }
    if kind ≡ 6 {
        blocks ← 32
    }
    if kind ≡ 8 {
        blocks ← 32
    }
    if kind ≡ 12 {
        blocks ← 256
    }
    if kind ≡ 14 {
        blocks ← 256
    }
    mut int bytes ← 1
    if kind ≡ 0 {
        bytes ← 4
    }
    if kind ≡ 6 {
        bytes ← 22
    }
    if kind ≡ 8 {
        bytes ← 34
    }
    if kind ≡ 12 {
        bytes ← 144
    }
    if kind ≡ 14 {
        bytes ← 210
    }
    return (nelems / blocks) * bytes
}

# Full GGUF v3 file from codec lists. extra_data appends trailing bytes to
# the data region (coverage mutants). Data section starts at align32(end
# of the tensor table); tensor offsets are cumulative relative.
fn aedifica(list<u8> magica, int version, list<string> kvs, list<string> tensors, int extra_data) → list<u8> {
    mut list<u8> f ← empty
    f.extend(magica)
    f ← add(f, u32_le(version))
    f ← add(f, u64_le(tensors.length()))
    f ← add(f, u64_le(kvs.length()))
    for from kvs let k {
        f ← add(f, kv_code(k))
    }
    # NumericBlock info table (offsets cumulative relative to data start).
    mut int cursor ← 0
    for from tensors let tt {
        f ← add(f, code_tensor(tt, cursor))
        cursor ← cursor + tensor_extent(tt)
    }
    # Data section at align32(end of table): pad bytes mirror the GGUF
    # writer and gen_fixture.py.
    let int table_end ← f.length()
    mut int data_start ← table_end
    if data_start % 32 ≢ 0 {
        let int pad ← 32 - data_start % 32
        mut int p ← 0
        while p ≺ pad {
            f.append(0 ↦ u8)
            p ← p + 1
        }
        data_start ← data_start + pad
    }
    mut int tot ← 0
    for from tensors let tt {
        tot ← tot + tensor_extent(tt)
    }
    # Deterministic data pattern (mirrors gen_fixture.py): byte k of the
    # data region = (k*13 + 7) mod 256. Data content is not semantically
    # inspected by admission; the pattern makes the fixture byte-stable.
    mut int z ← 0
    while z ≺ tot + extra_data {
        f.append(((z * 13 + 7) % 256) ↦ u8)
        z ← z + 1
    }
    return f
}

# The pinned legal fixture (scaled structural replica).
fn legal() → list<u8> {
    return aedifica(magica(), 3, LEGAL_KVS, LEGAL_TENSORS, 0)
}

# List replacement / removal for mutants.
fn repone(list<string> xs, string veterem, string novam) → list<string> {
    mut list<string> out ← empty
    for from xs let x {
        if x ≡ veterem {
            out.append(novam)
        }
        else {
            out.append(x)
        }
    }
    return out
}

fn demptio(list<string> xs, string veterem) → list<string> {
    mut list<string> out ← empty
    for from xs let x {
        if x ≢ veterem {
            out.append(x)
        }
    }
    return out
}

# Byte mutation / truncation.
fn mutate(list<u8> b, int off, int payload) → list<u8> {
    mut list<u8> out ← empty
    for range 0‥b.length() let i {
        if i ≡ off {
            out.append(payload ↦ u8 ⊥ 0)
        }
        else {
            out.append(b.get(i) coalesce (0 ∷ u8))
        }
    }
    return out
}

fn excerpt(list<u8> b, int n) → list<u8> {
    mut list<u8> out ← empty
    for range 0‥n let i {
        out.append(b.get(i) coalesce (0 ∷ u8))
    }
    return out
}

# -- admission outcome helpers --------------------------------------------

# Renders an admission outcome as text ("ok" or the typed error's message).
fn admission_result(list<u8> bytes_f, string digest, int expected_kv, int expected_tensors, int expected_elements, int expected_f32, int expected_q4k, int expected_q5, int expected_q6, int expected_q8) → string {
    do {
        let capsule.Capsule c ← gguf.admit(bytes_f, digest, bytes_f.length(), 15, 2, expected_kv, expected_tensors, expected_elements, expected_f32, expected_q4k, expected_q5, expected_q6, expected_q8)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# Admission with the legal fixture's contract.
fn legal_admission(list<u8> bytes_f) → string {
    return admission_result(bytes_f, F_DIGEST, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
}

# Capsule-level verification outcomes ("ok" | the typed error's message).
# Each helper wraps a single-error-type failable call so the happy-row
# probes keep one error class per fac/cape block (AdmissionError here —
# SEM010 hazard avoided; same seam as capsule.proba).
fn verify_result(capsule.Capsule c) → string {
    do {
        let bool ok ← capsule.verify(c)
        return "ok"
    }
    catch err {
        return "rejected"
    }
}

fn against_result(capsule.Capsule c, string expected) → string {
    do {
        let bool ok ← capsule.verify_against(c, expected)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# Identity-wire round-trip against the oracle wire form (single error
# class: AdmissionError from serializa/deserialize).
fn roundtrip_oraculi(capsule.Capsule c, string expected_wire) → bool {
    do {
        let string wire ← capsule.serialize_identity(c)
        if wire ≢ expected_wire then return false
        let capsule.Identity i ← capsule.deserialize_identity(wire)
        return c.identity() ≡ i
    }
    catch err {
        return false
    }
}

# -- happy path: the pinned legal fixture → schema-2 capsule --------------

describe "gguf admission happy row" {
    test "admission admits the pinned legal fixture" {
        do {
            let capsule.Capsule c ← gguf.admit(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            # Schema stamp (capsule-schema-2.0.0).
            assert c.schema ≡ "2.0.0"
            # Pathless content identity (whole-file digest, host-computed;
            # the oracle value d89c9ef9…8f0974 of the pinned legal fixture
            # is carried, never recomputed by the parser).
            assert c.algorithm() ≡ "sha-256"
            assert c.digest() ≡ F_DIGEST
            assert c.length() ≡ legal().length()
            # Per-format manifest (GGUF).
            assert c.format() ≡ "gguf"
            assert c.tensor_count() ≡ 3
            # The compact schema-versioned identity record.
            assert c.identity().schema ≡ "2.0.0"
            assert c.identity().digest ≡ F_DIGEST
            assert c.identity().byte_length ≡ legal().length()
        }
        catch err {
            assert false
        }
    }
    test "verify passes and verify_against matches the pinned digest" {
        do {
            let capsule.Capsule c ← gguf.admit(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            assert verify_result(c) ≡ "ok"
            assert against_result(c, F_DIGEST) ≡ "ok"
        }
        catch err {
            assert false
        }
    }
    test "the capsule identity matches the pinned-row oracle" {
        do {
            let capsule.Capsule c ← gguf.admit(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            let int fl ← legal().length()
            # Oracle: capsule/identity/<schema>/sha-256/<digest>/<len> — the
            # fixture's oracle digest d89c9ef9…8f0974 is carried, never
            # reconstructed from the path (there is no path in schema 2).
            let string wire ← "capsule/identity/2.0.0/sha-256/§/§"(F_DIGEST, fl ↦ string)
            assert roundtrip_oraculi(c, wire)
        }
        catch err {
            assert false
        }
    }
    test "verify_against rejects a digest mismatch" {
        do {
            let capsule.Capsule c ← gguf.admit(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            assert against_result(c, F_ALT_DIGEST) ≡ "digest mismatch — capsule does not match the expected artifact"
        }
        catch err {
            assert false
        }
    }
    test "the data region tiles exactly (coverage_ok)" {
        # 2912 bytes of tensor data = 544 (Q8_0) + 64 (F32) + 2304 (Q4_K);
        # the fixture's data length equals file length minus data start.
        do {
            let capsule.Capsule c ← gguf.admit(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            assert c.length() ≡ legal().length()
            assert c.tensor_count() ≡ 3
        }
        catch err {
            assert false
        }
    }
}

# -- negative matrix: format / version / header / counts ------------------

describe "gguf negative matrix — format, version, counts" {
    test "rejects bad magic" {
        assert legal_admission(aedifica(bytes_of([71, 71, 85, 88]), 3, LEGAL_KVS, LEGAL_TENSORS, 0)) ≡ "not a GGUF file — bad magic"
    }
    test "rejects an unsupported GGUF version" {
        assert legal_admission(aedifica(magica(), 4, LEGAL_KVS, LEGAL_TENSORS, 0)) ≡ "unsupported GGUF version: 4"
    }
    test "rejects a truncated header" {
        assert legal_admission(bytes_of([71, 71, 85, 70, 0, 0, 0, 3, 0, 0])) ≡ "truncated gguf header"
    }
    test "rejects a u64 field above the integer carrier" {
        # Byte 15 = top byte of the tensor-count u64 (LE); 0xFF ≥ 2^63.
        assert legal_admission(mutate(legal(), 15, 255)) ≡ "GGUF UINT64 value exceeds the numeric carrier"
    }
    test "rejects a metadata KV count mismatch" {
        assert admission_result(legal(), F_DIGEST, 17, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "metadata KV count mismatch"
    }
    test "rejects a tensor count mismatch" {
        assert admission_result(legal(), F_DIGEST, F_KV, 2, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, 0) ≡ "tensor count mismatch"
    }
    test "rejects expected kv count outside the admitted range" {
        assert admission_result(legal(), F_DIGEST, 0, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "expected kv count outside the admitted range"
    }
    test "rejects expected tensor count outside the admitted range" {
        assert admission_result(legal(), F_DIGEST, F_KV, 100000, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "expected tensor count outside the admitted range"
    }
    test "treats a large expected element count as a caller fact" {
        assert admission_result(legal(), F_DIGEST, F_KV, F_TENSORS, 2000000000, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "total element count mismatch"
    }
    test "rejects per-type counts that do not sum to the tensor count" {
        assert admission_result(legal(), F_DIGEST, F_KV, F_TENSORS, F_ELEMENTS, 2, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "expected tensor type counts do not sum to the tensor count"
    }
}

# -- negative matrix: metadata keys and values ----------------------------

describe "gguf negative matrix — metadata" {
    test "rejects an unknown metadata key" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "general.name;s;smollm2-fixture", "evil.key;s;x"), LEGAL_TENSORS, 0)) ≡ "unknown metadata key"
    }
    test "rejects a duplicate metadata key" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM", "general.name;s;dup"), LEGAL_TENSORS, 0)) ≡ "duplicate GGUF metadata key: general.name"
    }
    test "rejects a missing required key" {
        assert admission_result(aedifica(magica(), 3, demptio(LEGAL_KVS, "general.architecture;s;llama"), LEGAL_TENSORS, 0), F_DIGEST, 17, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "missing required metadata key: general.architecture"
    }
    test "rejects an architecture mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "general.architecture;s;llama", "general.architecture;s;qwen2"), LEGAL_TENSORS, 0)) ≡ "architecture mismatch"
    }
    test "rejects a layer count mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.block_count;u;32", "llama.block_count;u;16"), LEGAL_TENSORS, 0)) ≡ "layer count mismatch"
    }
    test "rejects a context length mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.context_length;u;8192", "llama.context_length;u;4096"), LEGAL_TENSORS, 0)) ≡ "context length mismatch"
    }
    test "rejects a vocabulary size mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.vocab_size;u;49152", "llama.vocab_size;u;32000"), LEGAL_TENSORS, 0)) ≡ "vocabulary size mismatch"
    }
    test "rejects an embedding size mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.embedding_length;u;960", "llama.embedding_length;u;512"), LEGAL_TENSORS, 0)) ≡ "embedding size mismatch"
    }
    test "rejects a file type mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "general.file_type;u;15", "general.file_type;u;14"), LEGAL_TENSORS, 0)) ≡ "file type mismatch"
    }
    test "rejects a quantization version mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "general.quantization_version;u;2", "general.quantization_version;u;1"), LEGAL_TENSORS, 0)) ≡ "quantization version mismatch"
    }
    test "rejects a tokenizer model mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.model;s;gpt2", "tokenizer.ggml.model;s;tiktoken"), LEGAL_TENSORS, 0)) ≡ "tokenizer model mismatch"
    }
    test "rejects a pre-tokenizer mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.pre;s;smollm", "tokenizer.ggml.pre;s;o200k"), LEGAL_TENSORS, 0)) ≡ "tokenizer pre-tokenizer mismatch"
    }
    test "rejects a bos token id mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.bos_token_id;u;1", "tokenizer.ggml.bos_token_id;u;0"), LEGAL_TENSORS, 0)) ≡ "bos token id mismatch"
    }
    test "rejects an eos token id mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.eos_token_id;u;2", "tokenizer.ggml.eos_token_id;u;1"), LEGAL_TENSORS, 0)) ≡ "eos token id mismatch"
    }
    test "rejects a padding token id mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.padding_token_id;u;2", "tokenizer.ggml.padding_token_id;u;3"), LEGAL_TENSORS, 0)) ≡ "padding token id mismatch"
    }
    test "rejects an unknown token id mismatch" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.unknown_token_id;u;0", "tokenizer.ggml.unknown_token_id;u;5"), LEGAL_TENSORS, 0)) ≡ "unknown token id mismatch"
    }
    test "rejects add_bos_token set" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.add_bos_token;b;0", "tokenizer.ggml.add_bos_token;b;1"), LEGAL_TENSORS, 0)) ≡ "add_bos_token mismatch"
    }
    test "rejects add_space_prefix set" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.add_space_prefix;b;0", "tokenizer.ggml.add_space_prefix;b;1"), LEGAL_TENSORS, 0)) ≡ "add_space_prefix mismatch"
    }
    test "rejects a wrong metadata value type" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "general.file_type;u;15", "general.file_type;s;15"), LEGAL_TENSORS, 0)) ≡ "metadata value is not an unsigned integer"
    }
    test "rejects a metadata key above the 128-byte ceiling" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "general.name;s;smollm2-fixture", repeat("k", 130) + ";s;x"), LEGAL_TENSORS, 0)) ≡ "metadata key exceeds the 128-byte ceiling"
    }
    test "rejects a string value above the authority text limit" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
        assert legal_admission(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM", "tokenizer.chat_template;s;§"(repeat("v", 1048577))), LEGAL_TENSORS, 0)) ≡ "GGUF string exceeds the bounded text limit"
    }
}

# -- negative matrix: tensors, offsets, shapes, coverage ------------------

describe "gguf negative matrix — tensors, offsets, shapes" {
    test "rejects an unknown ggml tensor type" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "token_embd.weight;8;32,16;auto", "token_embd.weight;2;32,16;auto"), 0)) ≡ "unknown ggml tensor type"
    }
    test "rejects an unsupported tensor rank" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;4,4,2;auto"), 0)) ≡ "unsupported tensor rank"
    }
    test "rejects a zero dimension" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;0;auto"), 0)) ≡ "tensor dimension must be positive"
    }
    test "rejects a tensor whose first dimension is not a complete GGML block" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "token_embd.weight;8;32,16;auto", "token_embd.weight;8;8,7;auto"), 0)) ≡ "tensor first dimension is not a complete GGML block"
    }
    test "rejects overlapping/duplicate tensor offsets" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;16;300"), 0)) ≡ "known GGML tensor ranges overlap"
    }
    test "rejects overlapping/duplicate tensor offsets at the data start" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;16;0"), 0)) ≡ "known GGML tensor ranges overlap"
    }
    test "rejects a duplicate tensor name" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", "token_embd.weight;8;32,16;auto"), 0)) ≡ "duplicate GGUF tensor name: token_embd.weight"
    }
    test "rejects an empty tensor name" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", ";0;16;auto"), 0)) ≡ "empty tensor name"
    }
    test "rejects a tensor name above the 128-byte ceiling" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORS, "blk.0.attn_norm.weight;0;16;auto", repeat("w", 130) + ";0;16;auto"), 0)) ≡ "tensor name exceeds the 128-byte ceiling"
    }
    test "rejects a total element count mismatch" {
        assert admission_result(legal(), F_DIGEST, F_KV, F_TENSORS, 4625, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8) ≡ "total element count mismatch"
    }
    test "rejects a per-type tensor count mismatch" {
        assert admission_result(legal(), F_DIGEST, F_KV, F_TENSORS, F_ELEMENTS, F_F32, 0, 1, F_Q6, F_Q8) ≡ "tensor type count mismatch"
    }
    test "rejects a truncated data region" {
        assert legal_admission(excerpt(legal(), legal().length() - 100)) ≡ "known GGML tensor range exceeds the artifact"
    }
    test "rejects trailing bytes in the data region" {
        assert legal_admission(aedifica(magica(), 3, LEGAL_KVS, LEGAL_TENSORS, 100)) ≡ "data region does not tile exactly"
    }
    test "rejects a truncated tensor table" {
        # Header + one KV + a partial tensor entry (name only, no fields).
        mut list<u8> f ← empty
        f.extend(magica())
        f ← add(f, u32_le(3))
        f ← add(f, u64_le(1))
        f ← add(f, u64_le(1))
        f ← add(f, kv_code("general.architecture;s;llama"))
        f ← add(f, stringa("a.b"))
        assert admission_result(f, F_DIGEST, 1, 1, 1, 1, 0, 0, 0, 0) ≡ "range source request exceeds the artifact"
    }
}

# -- header-prefix admission: explicit artifact length --------------------
# F32-shaped fixture: file_type 0, padding id 0, the two optional attention
# keys, and two F32 tensors (512 + 16 elements, 2112 data bytes).
const list<string> F32_TENSORS = ["token_embd.weight;0;32,16;auto", "blk.0.attn_norm.weight;0;16;auto"]
const string F32_DIGEST = "07735177a3542cbc0b0665051ce1922b55c4c9698de65131e65f2aea87a935e0"

fn f32_kvs() → list<string> {
    mut list<string> kvs ← repone(LEGAL_KVS, "general.file_type;u;15", "general.file_type;u;0")
    kvs ← repone(kvs, "tokenizer.ggml.padding_token_id;u;2", "tokenizer.ggml.padding_token_id;u;0")
    kvs.append("llama.attention.key_length;u;64")
    kvs.append("llama.attention.value_length;u;64")
    return kvs
}

fn f32_file() → list<u8> {
    return aedifica(magica(), 3, f32_kvs(), F32_TENSORS, 0)
}

# The header prefix: everything before the data region.
fn f32_prefix() → list<u8> {
    return excerpt(f32_file(), f32_file().length() - 2112)
}

fn prefix_result(list<u8> prefix, int artifact_length, int file_type, int pad_id) → string {
    do {
        let capsule.Capsule c ← gguf.admit(prefix, F32_DIGEST, artifact_length, file_type, pad_id, 20, 2, 528, 2, 0, 0, 0, 0)
        return "ok"
    }
    catch err {
        return err.message
    }
}

describe "gguf header-prefix admission" {
    test "the whole F32-shaped file admits with file type 0 and pad id 0" {
        assert prefix_result(f32_file(), f32_file().length(), 0, 0) ≡ "ok"
    }
    test "a header prefix admits against the whole-file artifact length" {
        assert prefix_result(f32_prefix(), f32_file().length(), 0, 0) ≡ "ok"
        do {
            let capsule.Capsule c ← gguf.admit(f32_prefix(), F32_DIGEST, f32_file().length(), 0, 0, 20, 2, 528, 2, 0, 0, 0, 0)
            assert c.length() ≡ f32_file().length()
            assert c.tensor_count() ≡ 2
        }
        catch err {
            assert false
        }
    }
    test "a tensor range beyond the artifact length is refused" {
        assert prefix_result(f32_prefix(), f32_file().length() - 100, 0, 0) ≡ "known GGML tensor range exceeds the artifact"
    }
    test "a data region longer than the tensors is refused" {
        assert prefix_result(f32_prefix(), f32_file().length() + 32, 0, 0) ≡ "data region does not tile exactly"
    }
    test "a prefix that ends inside the tensor table fails closed past the prefix" {
        assert prefix_result(excerpt(f32_prefix(), f32_prefix().length() - 40), f32_file().length(), 0, 0) ≡ "range read beyond the supplied bytes"
    }
    test "an artifact length shorter than the supplied bytes is refused" {
        assert prefix_result(f32_file(), f32_file().length() - 1, 0, 0) ≡ "artifact length is shorter than the supplied bytes"
    }
    test "the expected file type and pad id are enforced" {
        assert prefix_result(f32_prefix(), f32_file().length(), 15, 0) ≡ "file type mismatch"
        assert prefix_result(f32_prefix(), f32_file().length(), 0, 2) ≡ "padding token id mismatch"
    }
}

# -- admit_with_manifest: the manifest rides with the capsule --------------

# Range source over the supplied bytes (the same shape admit hands the
# authority); a read beyond the bytes fails the read.
fn manifest_source(list<u8> b, int start, int length) → list<b8> ⇥ gguf_manifest.GgufManifestError {
    reject ((start ≺ 0 or length ≺ 0) or start ≻ b.length() - length) throw variant BadSource {message = "range read beyond the supplied bytes"}
    let list<u8> segment ← b[start‥start + length]
    return segment ↦ list<b8>
}

# The fixture's manifest straight from the authority, with admit's identity.
# A failed inspect yields a version -1 marker the rows assert against, so
# each row's do-block keeps one error class (SEM010).
fn authority_manifest(list<u8> b) → gguf_manifest.GgufManifest {
    let artifact.ContentIdentity identity ← artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = b.length()}
    do {
        return gguf_manifest.inspect((int start, int length) → list<b8> ⇥ gguf_manifest.GgufManifestError ∴ manifest_source(b, start, length), b.length(), identity)
    }
    catch err {
        return gguf_manifest.GgufManifest {identity = identity, version = -1, alignment = 0, data_start = 0, artifact_length = 0, metadata = [], tensors = []}
    }
}

# Outcome of the new entry with the legal fixture's contract.
fn with_manifest_result(list<u8> b, int artifact_length, int expected_tensors) → string {
    do {
        let gguf.Admission a ← gguf.admit_with_manifest(b, F_DIGEST, artifact_length, 15, 2, F_KV, expected_tensors, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
        return "ok"
    }
    catch err {
        return err.message
    }
}

describe "gguf admit_with_manifest" {
    test "the returned manifest equals the authority's inspect of the same bytes" {
        do {
            let gguf.Admission a ← gguf.admit_with_manifest(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            let gguf_manifest.GgufManifest want ← authority_manifest(legal())
            assert want.version ≡ 3
            let gguf_manifest.GgufManifest got ← a.manifest
            assert got.identity.algorithm ≡ want.identity.algorithm
            assert got.identity.digest ≡ want.identity.digest
            assert got.identity.length ≡ want.identity.length
            assert got.version ≡ want.version
            assert got.alignment ≡ want.alignment
            assert got.data_start ≡ want.data_start
            assert got.artifact_length ≡ want.artifact_length
            assert got.metadata.length() ≡ want.metadata.length()
            assert got.tensors.length() ≡ want.tensors.length()
            assert got.metadata.length() ≡ F_KV
            assert got.tensors.length() ≡ F_TENSORS
            for range 0‥want.metadata.length() let i {
                assert got.metadata[i].key ≡ want.metadata[i].key
                assert got.metadata[i].dtype ≡ want.metadata[i].dtype
            }
            for range 0‥want.tensors.length() let i {
                assert got.tensors[i].name ≡ want.tensors[i].name
                assert got.tensors[i].dtype_ggml ≡ want.tensors[i].dtype_ggml
                assert got.tensors[i].elements ≡ want.tensors[i].elements
                assert got.tensors[i].relative_offset ≡ want.tensors[i].relative_offset
            }
        }
        catch err {
            assert false
        }
    }
    test "the returned capsule equals what admit returns for the same input" {
        do {
            let gguf.Admission a ← gguf.admit_with_manifest(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            let capsule.Capsule c ← gguf.admit(legal(), F_DIGEST, legal().length(), 15, 2, F_KV, F_TENSORS, F_ELEMENTS, F_F32, F_Q4K, F_Q5, F_Q6, F_Q8)
            assert a.cap.schema ≡ c.schema
            assert a.cap.digest() ≡ c.digest()
            assert a.cap.length() ≡ c.length()
            assert a.cap.format() ≡ c.format()
            assert a.cap.tensor_count() ≡ c.tensor_count()
            assert a.cap.identity() ≡ c.identity()
        }
        catch err {
            assert false
        }
    }
    test "the manifest identity is the admitted digest and artifact length" {
        do {
            let gguf.Admission a ← gguf.admit_with_manifest(f32_prefix(), F32_DIGEST, f32_file().length(), 0, 0, 20, 2, 528, 2, 0, 0, 0, 0)
            assert a.manifest.identity.algorithm ≡ "sha-256"
            assert a.manifest.identity.digest ≡ F32_DIGEST
            assert a.manifest.identity.length ≡ f32_file().length()
            assert a.manifest.artifact_length ≡ f32_file().length()
        }
        catch err {
            assert false
        }
    }
    test "rejects a truncated header" {
        assert with_manifest_result(bytes_of([71, 71, 85, 70, 0, 0, 0, 3, 0, 0]), 10, F_TENSORS) ≡ "truncated gguf header"
    }
    test "rejects bad magic" {
        let list<u8> bad ← aedifica(bytes_of([71, 71, 85, 88]), 3, LEGAL_KVS, LEGAL_TENSORS, 0)
        assert with_manifest_result(bad, bad.length(), F_TENSORS) ≡ "not a GGUF file — bad magic"
    }
    test "rejects an artifact length shorter than the supplied bytes" {
        assert with_manifest_result(legal(), legal().length() - 1, F_TENSORS) ≡ "artifact length is shorter than the supplied bytes"
    }
    test "rejects a tensor count mismatch" {
        assert with_manifest_result(legal(), legal().length(), 2) ≡ "expected tensor type counts do not sum to the tensor count"
    }
    test "rejects a data region that does not tile to the artifact length" {
        assert with_manifest_result(legal(), legal().length() + 32, F_TENSORS) ≡ "data region does not tile exactly"
    }
}
