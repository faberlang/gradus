+++
locale = "en"
+++
# Co-located package test for dense_llama.fab (REF-01-U1.6 — typed `llama`
# architecture adapter).
# Not importable; discovered only by the faber test path.
#
# Pins, at compile level: (a) the frozen SmolLM2-360M architecture config
# facts (32 layers, 15 heads, 5 KV heads, head_dim 64, hidden 960, vocab
# 49152, tied embedding); (b) every canonical tensor name resolves against a
# synthetic manifest carrying the exact descriptor facts the GGUF-A1b inspect
# surface reports for the real SmolLM2-360M-Instruct-Q4_K_M.gguf file
# (read-only pinned facts — shapes, GGML types, and known layouts below were
# measured from the real file's manifest on 2026-08-14; no artifact bytes are
# committed); (c) fail-closed rejection rows: unknown canonical names,
# out-of-range layer indices, a canonical tensor absent from the manifest,
# and an unknown GGML layout all produce typed LlamaError renders.
#
# Imported-union variant construction (GgmlLayout/LlamaArch/CanonicalDescriptor
# values from an imported module) is blocked by the pinned compiler defect
# (SEM001+SEM008), so the fail-closed rows flow through the module's own
# error channel; assert assertions run under the cargo-backed `faber test`
# harness (auditor-owned), while `faber check` proves the whole surface
# type-checks. The executable proof lives in exempla/dense-llama-adapter.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" gguf_manifest

import from "gradus:model/dense_llama" dense_llama

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn _u32(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>]
}

fn _u64(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>, ((n ⇒ 32) % 256) ∷ int<u8>, ((n ⇒ 40) % 256) ∷ int<u8>, ((n ⇒ 48) % 256) ∷ int<u8>, ((n ⇒ 56) % 256) ∷ int<u8>]
}

fn _join(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

fn _text_bytes(string s) → list<int<u8>> {
    # Package MIR has no text→bytes extraction arm. This structural
    # builder only needs a finite ASCII corpus, so keep its encoding explicit.
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_norm.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_q.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_k.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 107, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_v.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 118, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_output.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_norm.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_gate.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 103, 97, 116, 101, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_up.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 117, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_down.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 100, 111, 119, 110, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "output_norm.weight" then return [111, 117, 116, 112, 117, 116, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.31.attn_norm.weight" then return [98, 108, 107, 46, 51, 49, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.experts.0.weight" then return [98, 108, 107, 46, 48, 46, 101, 120, 112, 101, 114, 116, 115, 46, 48, 46, 119, 101, 105, 103, 104, 116]
    return []
}

fn _str(string s) → list<int<u8>> {
    const list<int<u8>> b ← _text_bytes(s)
    return _join(_u64(b.length()), b)
}

fn _tensor(string name, list<int> shape, int kind, int offset) → list<int<u8>> {
    var list<int<u8>> out ← _join(_str(name), _u32(shape.length()))
    for from shape const dim {
        out ← _join(out, _u64(dim))
    }
    return _join(_join(out, _u32(kind)), _u64(offset))
}

fn _header(int tensors, int metadata) → list<int<u8>> {
    return _join(_join([71, 71, 85, 70], _u32(3)), _join(_u64(tensors), _u64(metadata)))
}

fn _with_padding(list<int<u8>> table, int alignment, int total) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← b
    return gguf_manifest.GgufCorpus {table = o, artifact_length = total, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = total}}
}

# SmolLM2-360M scaled descriptor corpus: the twelve real GGUF tensor rows the
# A1b inspect surface reports for SmolLM2-360M-Instruct-Q4_K_M.gguf (shapes,
# GGML type ids, and known layouts are the read-only pinned facts; offsets
# and total are structural filler, never pinned). `output.weight` is absent —
# the real row has tied embeddings. blk.0 and blk.31 rows carry the
# layer-boundary facts. Layouts: F32 1-el/4B, Q5_0 32-el/22B, Q8_0 32-el/34B,
# Q6_K 256-el/210B. Data section starts at 736; total 57,351,136 (12 tensors,
# 57,350,400 payload bytes).
fn _corpus_smollm2() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(12, 0)
    table ← _join(table, _tensor("token_embd.weight", [960, 49152], 8, 0))
    table ← _join(table, _tensor("blk.0.attn_norm.weight", [960], 0, 50135040))
    table ← _join(table, _tensor("blk.0.attn_q.weight", [960, 960], 6, 50138880))
    table ← _join(table, _tensor("blk.0.attn_k.weight", [960, 320], 6, 50772480))
    table ← _join(table, _tensor("blk.0.attn_v.weight", [960, 320], 8, 50983680))
    table ← _join(table, _tensor("blk.0.attn_output.weight", [960, 960], 6, 51310080))
    table ← _join(table, _tensor("blk.0.ffn_norm.weight", [960], 0, 51943680))
    table ← _join(table, _tensor("blk.0.ffn_gate.weight", [960, 2560], 6, 51947520))
    table ← _join(table, _tensor("blk.0.ffn_up.weight", [960, 2560], 6, 53637120))
    table ← _join(table, _tensor("blk.0.ffn_down.weight", [2560, 960], 14, 55326720))
    table ← _join(table, _tensor("output_norm.weight", [960], 0, 57342720))
    table ← _join(table, _tensor("blk.31.attn_norm.weight", [960], 0, 57346560))
    return _with_padding(table, 32, 57351136)
}

# Same corpus minus output_norm.weight — the MissingTensor rejection row.
fn _corpus_sine_norm() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(10, 0)
    table ← _join(table, _tensor("token_embd.weight", [960, 49152], 8, 0))
    table ← _join(table, _tensor("blk.0.attn_norm.weight", [960], 0, 50135040))
    table ← _join(table, _tensor("blk.0.attn_q.weight", [960, 960], 6, 50138880))
    table ← _join(table, _tensor("blk.0.attn_k.weight", [960, 320], 6, 50772480))
    table ← _join(table, _tensor("blk.0.attn_v.weight", [960, 320], 8, 50983680))
    table ← _join(table, _tensor("blk.0.attn_output.weight", [960, 960], 6, 51310080))
    table ← _join(table, _tensor("blk.0.ffn_norm.weight", [960], 0, 51943680))
    table ← _join(table, _tensor("blk.0.ffn_gate.weight", [960, 2560], 6, 51947520))
    table ← _join(table, _tensor("blk.0.ffn_up.weight", [960, 2560], 6, 53637120))
    table ← _join(table, _tensor("blk.0.ffn_down.weight", [2560, 960], 14, 55326720))
    return _with_padding(table, 32, 57343392)
}

# Unknown-layout corpus: a canonical target carrying an unlisted GGML type id
# (999) — the UnknownLayout rejection row. Data section at 96, total 96.
fn _corpus_unknown_layout() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _join(table, _tensor("blk.0.ffn_gate.weight", [960, 2560], 999, 0))
    return _with_padding(table, 32, 96)
}

fn _layout_txt(gguf_manifest.GgmlLayout l) → string {
    return dense_llama.layout_note(l)
}

fn _shape(list<int> f) → string {
    var string out ← "["
    var int i ← 0
    while i ≺ f.length() {
        out ← out + (f.get(i) coalesce 0 ↦ string)
        if i + 1 ≺ f.length() {
            out ← out + ","
        }
        i ← i + 1
    }
    return out + "]"
}

# Render one canonical resolution as "canonical/gguf/shape/layout" or the
# typed LlamaError render.
fn _description(gguf_manifest.GgufCorpus corpus, string canonical, int layer) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const dense_llama.CanonicalDescriptor d ← dense_llama.resolve(m, dense_llama.smollm2_arch(), canonical, layer)
            return (((((d.canonical_name + "/") + d.gguf_name) + "/") + _shape(d.shape)) + "/") + _layout_txt(d.layout)
        }
        catch err {
            return "ERR:" + dense_llama.message(err)
        }
    }
    catch err {
        return "ERR:" + gguf_manifest.message(err)
    }
}

# Render one canonical-name mapping as the GGUF tensor name or the typed
# LlamaError render.
fn _name(string canonical, int layer) → string {
    do {
        return dense_llama.gguf_name(dense_llama.smollm2_arch(), canonical, layer)
    }
    catch err {
        return "ERR:" + dense_llama.message(err)
    }
}

# Render the frozen architecture config as a single facts line.
fn _arch() → string {
    const dense_llama.LlamaArch a ← dense_llama.smollm2_arch()
    return (((((((((((((a.name + "/") + (a.layers ↦ string)) + "/") + (a.heads ↦ string)) + "/") + (a.kv_heads ↦ string)) + "/") + (a.head_dim ↦ string)) + "/") + (a.hidden_dim ↦ string)) + "/") + (a.vocab ↦ string)) + "/") + (a.tied ↦ string)
}

test "frozen SmolLM2-360M architecture config facts" {
    assert _arch() ≡ "SmolLM2-360M/32/15/5/64/960/49152/true"
}

test "every canonical name resolves to the exact pinned descriptor facts" {
    assert _description(_corpus_smollm2(), "model.embed_tokens", 0) ≡ "model.embed_tokens/token_embd.weight/[960,49152]/known"
    assert _description(_corpus_smollm2(), "model.layers.input_layernorm", 0) ≡ "model.layers.input_layernorm/blk.0.attn_norm.weight/[960]/known"
    assert _description(_corpus_smollm2(), "model.layers.self_attn.q_proj", 0) ≡ "model.layers.self_attn.q_proj/blk.0.attn_q.weight/[960,960]/known"
    assert _description(_corpus_smollm2(), "model.layers.self_attn.k_proj", 0) ≡ "model.layers.self_attn.k_proj/blk.0.attn_k.weight/[960,320]/known"
    assert _description(_corpus_smollm2(), "model.layers.self_attn.v_proj", 0) ≡ "model.layers.self_attn.v_proj/blk.0.attn_v.weight/[960,320]/known"
    assert _description(_corpus_smollm2(), "model.layers.self_attn.o_proj", 0) ≡ "model.layers.self_attn.o_proj/blk.0.attn_output.weight/[960,960]/known"
    assert _description(_corpus_smollm2(), "model.layers.post_attention_layernorm", 0) ≡ "model.layers.post_attention_layernorm/blk.0.ffn_norm.weight/[960]/known"
    assert _description(_corpus_smollm2(), "model.layers.mlp.gate_proj", 0) ≡ "model.layers.mlp.gate_proj/blk.0.ffn_gate.weight/[960,2560]/known"
    assert _description(_corpus_smollm2(), "model.layers.mlp.up_proj", 0) ≡ "model.layers.mlp.up_proj/blk.0.ffn_up.weight/[960,2560]/known"
    assert _description(_corpus_smollm2(), "model.layers.mlp.down_proj", 0) ≡ "model.layers.mlp.down_proj/blk.0.ffn_down.weight/[2560,960]/known"
    assert _description(_corpus_smollm2(), "model.norm", 0) ≡ "model.norm/output_norm.weight/[960]/known"
    assert _description(_corpus_smollm2(), "lm_head", 0) ≡ "lm_head/token_embd.weight/[960,49152]/known"
}

test "layer-index boundary resolves against the frozen layer count" {
    assert _description(_corpus_smollm2(), "model.layers.input_layernorm", 31) ≡ "model.layers.input_layernorm/blk.31.attn_norm.weight/[960]/known"
}

test "unknown canonical names fail closed as UnknownCanonicalName" {
    assert _name("model.layers.mlp.silu_proj", 0) ≡ "ERR:unknown canonical tensor name: model.layers.mlp.silu_proj"
    assert _name("model.layers", 0) ≡ "ERR:unknown canonical tensor name: model.layers"
}

test "out-of-range layer indices fail closed as LayerOutOfRange" {
    assert _name("model.layers.input_layernorm", 32) ≡ "ERR:layer index outside the frozen llama layer range: 32"
    assert _name("model.layers.input_layernorm", -1) ≡ "ERR:layer index outside the frozen llama layer range: -1"
}

test "a canonical tensor absent from the manifest fails closed as MissingTensor" {
    assert _description(_corpus_sine_norm(), "model.norm", 0) ≡ "ERR:canonical tensor is absent from the manifest: output_norm.weight"
}

test "an unknown GGML layout fails closed as UnknownLayout" {
    assert _description(_corpus_unknown_layout(), "model.layers.mlp.gate_proj", 0) ≡ "ERR:canonical tensor resolves to an unknown GGML layout: blk.0.ffn_gate.weight"
}
