}

fn model_ref01(dense.DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, list<int> tokens, f32 epsilon, f32 scale, list<int> positions, int rope_dim, attention.RopeConfig rope_cfg) → tensor.NumericBlock {
    return test_util.or_default(() → tensor.NumericBlock ⇥ dense.DenseError ∴ dense.forward_ref01(cfg, source, tokens, epsilon, scale, positions, rope_dim, rope_cfg), tensor.default())
}

describe "typed-assembly REF-01 — forward_ref01 tied logits @ 5e-4" {
    test "tied embedding row through load + dense_block_static matches the f64 pins" {
        do {
            const tensor.NumericBlock y ← model_ref01(dense.DenseConfig { layers = 2, heads = 4, kv_heads = 2, head_dim = 4, hidden_dim = 16, vocab = 8, tied = true }, (string n, int s) → tensor.NumericBlock ⇥ dense.DenseError ∴ _repertor(n, s, EMBED, NORM_S, W_HEAD, l0, l1, false, false), TOKENS, (0.00001 ∷ f32), (0.5 ∷ f32), POSITIONES, 4, rq)
            assert y.shape ≡ ([2, 8] ↦ list<int>)
            assert e2(y, 0, 0).approximata(LG_T_0_0, TOLERATIO)
            assert e2(y, 0, 1).approximata(LG_T_0_1, TOLERATIO)
            assert e2(y, 0, 3).approximata(LG_T_0_3, TOLERATIO)
            assert e2(y, 0, 7).approximata(LG_T_0_7, TOLERATIO)
            assert e2(y, 1, 0).approximata(LG_T_1_0, TOLERATIO)
            assert e2(y, 1, 3).approximata(LG_T_1_3, TOLERATIO)
            assert e2(y, 1, 7).approximata(LG_T_1_7, TOLERATIO)
        }
        catch err {
            assert false
        }
    }
}

describe "typed-assembly REF-01 — prefill_ref01 and decode_step_ref01 compose" {
    test "prefill_ref01 matches forward_ref01 logits and two decode steps match the last row" {
        const dense.DenseConfig cfg ← dense.DenseConfig { layers = 2, heads = 4, kv_heads = 2, head_dim = 4, hidden_dim = 16, vocab = 8, tied = true }
        const (string, int) → tensor.NumericBlock ⇥ dense.DenseError source ← (string n, int s) → tensor.NumericBlock ⇥ dense.DenseError ∴ _repertor(n, s, EMBED, NORM_S, W_HEAD, l0, l1, false, false)
        const tensor.NumericBlock full ← model_ref01(cfg, source, TOKENS, (0.00001 ∷ f32), (0.5 ∷ f32), POSITIONES, 4, rq)
        const dense.DenseStep pref ← test_util.or_default(() → dense.DenseStep ⇥ dense.DenseError ∴ dense.prefill_ref01(cfg, source, TOKENS, (0.00001 ∷ f32), (0.5 ∷ f32), 4, rq, empty_p()), dense.default_step())
        assert pref.logits.shape ≡ ([2, 8] ↦ list<int>)
        assert e2(pref.logits, 0, 0).approximata(e2(full, 0, 0), TOLERATIO)
        assert e2(pref.logits, 1, 7).approximata(e2(full, 1, 7), TOLERATIO)
        const dense.DenseStep s0 ← test_util.or_default(() → dense.DenseStep ⇥ dense.DenseError ∴ dense.decode_step_ref01(cfg, source, 0, 0, (0.00001 ∷ f32), (0.5 ∷ f32), 4, rq, empty_p()), dense.default_step())
        const dense.DenseStep s1 ← test_util.or_default(() → dense.DenseStep ⇥ dense.DenseError ∴ dense.decode_step_ref01(cfg, source, 7, 1, (0.00001 ∷ f32), (0.5 ∷ f32), 4, rq, s0.layers), dense.default_step())
        assert s1.logits.shape ≡ ([1, 8] ↦ list<int>)
        assert e2(s1.logits, 0, 0).approximata(e2(full, 1, 0), TOLERATIO)
        assert e2(s1.logits, 0, 3).approximata(e2(full, 1, 3), TOLERATIO)
    }
}

describe "typed-assembly REF-01 — forward_ref01 untied logits @ 5e-4" {
    test "untied embedding row through load + dense_block_static matches the f64 pins" {
        do {
