+++
locale = "en"
+++
# Co-located package test for src/model/dense.fab (REF-01-U1.8 dense model
# assembly). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * the complete ordered dense forward graph (embedding gather -> 2 ordered
#     U1.5 dense blocks -> final RMSNorm -> output projection, assembled from
#     the typed architecture config and materialized stored-weight views via
#     canonical names) reproduces the independent f64 evaluation of the
#     documented formulas for a small synthetic dense config (T=2, D=16,
#     F=16, H=4, K=2, head_dim=4, vocab 8, tokens [0, 7], positions [0, 1],
#     rope_dim 4, consecutive-pair freq_base 100000, dk scale 0.5, RMSNorm
#     epsilon 1e-5) for the TIED and UNTIED embedding rows — pinned within
#     the documented 5e-4 absolute tolerance. The pins are the external
#     Python f64 evaluation (the PML3 transformer_block pin precedent; the
#     block transcription is validated against the pinned dense-block
#     values in src/transformer.proba first) of the two-layer graph with
#     residual-2 r1 + h (not ln2 + h). The same config and reference
#     values run as the executed proof in exempla/dense-model.
#   * the fail-closed typed-error contract of the assembly: a resolver that
#     fails on a canonical tensor (MissingTensor with the resolver's message),
#     token ids outside the embedding vocabulary (TerminusExcedit), an
#     invalid architecture config (BadConfig), a shape contradicting the
#     config (BadShape), and a positions/token count mismatch
#     (BadConfig).
#   * forward-only / autograd independence: the surface composes bare (no
#     autograd import, no gradient path).
#
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
# Execution of proba bodies is env-blocked tree-wide today (FMIR stepper /
# library-import gap — recorded residual); the executed proof of the same
# contract lives in exempla/dense-model.

import from "gradus:model/dense" dense
import from "gradus:attention" attention
import from "gradus:cache" kv
import from "gradus:tensor" tensor
import from "gradus:dtype" dtype

# Absolute tolerance for f32-vs-f64 comparison (the nn.proba posture).
const f32 TOLERATIO ← (0.0005 ∷ f32)

# Build a staged tensor, swallowing the never-firing construction errors
# (test data is always valid; the cape fallback is unreachable).
fn tene(list<f32> data, list<int> shape) → tensor.Tensor {
    var tensor.Tensor t ← tensor.default()
    do {
        t ← tensor.construct(data, shape)
    }
    catch err {
        return t
    }
    return t
}

# Pack a math-order [D, V] row-major table into the GGUF/ggml stored
# layout the assembly gathers from (descriptor still [D, V], flat buffer
# token-major: data[token * D + d]).
fn ggml_embed(tensor.Tensor row_major) → tensor.Tensor {
    const list<int> f ← row_major.shape()
    const int hidden ← f.get(0) coalesce 1
    const int vocab ← f.get(1) coalesce 1
    var list<f32> out ← vacua
    var int tok ← 0
    while tok ≺ vocab {
        var int j ← 0
        while j ≺ hidden {
            out.append(row_major.data.get(j * vocab + tok) coalesce 0.0 ∷ f32)
            j ← j + 1
        }
        tok ← tok + 1
    }
    return tene(out, [hidden, vocab])
}

# Staged-result element reads (swallow the never-firing access errors).
fn e2(tensor.Tensor r, int i, int j) → f32 {
    do {
        return r.get([i, j])
    }
    catch err {
        return (0.0 ∷ f32)
    }
}

# Validated RopeConfig.
fn config_p(f32 base, f32 scale, attention.RopePolicy policy) → attention.RopeConfig {
    var attention.RopeConfig c ← attention.default()
    do {
        c ← attention.construct_rope_config(base, scale, policy)
        return c
    }
    catch err {
        return c
    }
    return c
}

# forward wrapper for the pin rows (failure -> invalid tensor, every pin
# then fails).
fn model_p(dense.DenseConfig cfg, (string, int) → tensor.Tensor ⇥ dense.DenseError source, list<int> tokens, f32 epsilon, f32 scale, list<int> positions, int rope_dim, attention.RopeConfig rope_cfg) → tensor.Tensor {
    var tensor.Tensor r ← tensor.default()
    do {
        r ← dense.forward(cfg, source, tokens, epsilon, scale, positions, rope_dim, rope_cfg)
        return r
    }
    catch err {
        return r
    }
    return r
}

# forward wrapper for the error rows: the typed error's message on failure,
# "ok" otherwise.
fn model_text(dense.DenseConfig cfg, (string, int) → tensor.Tensor ⇥ dense.DenseError source, list<int> tokens, f32 epsilon, f32 scale, list<int> positions, int rope_dim, attention.RopeConfig rope_cfg) → string {
    do {
        const tensor.Tensor _ ← dense.forward(cfg, source, tokens, epsilon, scale, positions, rope_dim, rope_cfg)
        return "ok"
    }
    catch err {
        return dense.message(err)
    }
}

