        const dense.DenseConfig cfg ← dense.DenseConfig { layers = 2, heads = 4, kv_heads = 2, head_dim = 4, hidden_dim = 16, vocab = 8, tied = true }
        const (string, int) → tensor.NumericBlock ⇥ dense.DenseError source ← (string n, int s) → tensor.NumericBlock ⇥ dense.DenseError ∴ _repertor(n, s, EMBED, NORM_S, W_HEAD, l0, l1, false, false)
        do {
            const int cells ← dense.probe_typed_block_static(cfg, source, TOKENS, (0.00001 ∷ f32), (0.5 ∷ f32), POSITIONES, 4, rq)
            assert cells ≡ 32
        }
        catch err {
            assert false
        }
    }
}

describe "typed-assembly probe — glyphs run from a monomorphic wrapper" {
    test "rms_norm and + execute on pinned [2, 4] tensors" {
        do {
            const tensor<f32, [2, 4]> z ← dense.probe_inferred_leaves()
            const list<f32> data ← z ↦ list<f32>
            assert data.length() ≡ 8
