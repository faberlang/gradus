+++
locale = "en"
+++
# Co-located package test for tensor_payload.fab (GGUF-A3 C2-U2 — bounded
# per-tensor payload value + typed diagnostics).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the TensorPayload genus construction carries the
# exact stored range facts (name, absolute start, length) together with a
# bounded byte list, and the consumer-side render path (PayloadError →
# causa) type-checks. The module's own `discerne` renders every PayloadError
# variant (exhaustive match — proven by `faber check .`). Constructing
# PayloadError values from an imported module is blocked by a pinned
# compiler defect (imported-union variant construction, SEM001+SEM008 in the
# radix-module-boundary baseline ledger), so variant-level render assertions
# run under the auditor-owned `faber test` harness once the defect clears.
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.

import from "gradus:model/tensor_payload" tensor_payload

fn _octeti(list<int> vals) → bytes {
    var list<int<u8>> bs ← vacua
    for from vals const v {
        bs.append(v ↦ int<u8>)
    }
    const bytes o ← bs
    return o
}

fn rende(tensor_payload.PayloadError e) → string {
    return tensor_payload.causa(e)
}

test "carries the stored name, range, and bounded bytes" {
    const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {nomen = "token_embd.weight", initium_absolutum = 4096, longitudo = 128, bytes = _octeti([1, 2, 3])}
    assert p.nomen ≡ "token_embd.weight"
    assert p.initium_absolutum ≡ 4096
    assert p.longitudo ≡ 128
    assert p.bytes.length() ≡ 3
}
