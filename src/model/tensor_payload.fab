+++
locale = "en"
+++
# Bounded per-tensor payload value and its typed diagnostics (GGUF-A3 C2-U2).
#
# Public import: import from "gradus:model/tensor_payload" tensor_payload
# Depends on: nothing (leaf module — value carrier only).
#
# TensorPayload carries one validated tensor's bounded byte payload together
# with the exact stored range facts that describe it (name, absolute byte
# start, length). It deliberately carries no path, URL, reader, file handle,
# memory map, host/device object, or whole-model byte list — a source adapter
# supplies bounded bytes separately (delivery clean boundary).


@ public
class TensorPayload {
    string name
    int absolute_start
    int length
    bytes bytes
}

@ public
union PayloadError {
    @ shared
    string message

    UnknownName,
    BadRange,
    BadLength
}
