# Bounded typed tensor view, fail-closed bind, and windowed materializer
# (GGUF-A3 C2-U3 + C2-U4).
#
# Public import: importa ex "gradus:model/tensor_view" tensor_view
# Depends on: gradus:model/gguf_manifest (limes_payloadis + inveni_tensorem
#   range seam), gradus:model/tensor_payload (bounded payload value),
#   gradus:model/dequant (admitted-type cross-check + block codecs).
#
# `vincula` binds one descriptor + one validated payload into the typed view.
# It fails closed on: unknown name (NomineIgnota), unknown layout
# (LayoutIgnota), un-admitted physical type (TypoIgnotum), absolute-range
# mismatch (RangeMala), or stored-length mismatch (LongitudoMala). The
# manifest is the single layout authority — dequant only cross-checks
# admission and never re-derives layout. `VisumTensoris` never retains a
# path, reader, or source function; the bind reads no payload bytes.
#
# `materializa_slicem` dequantizes one element-aligned window of a bound
# view through the operation-scoped source, one block per read, in GGUF
# block order. It fails closed on: negative / out-of-tensor / over-cap
# windows (LimitesMala), block-misaligned windows (OrdoMala), unknown
# layout (LayoutIgnota), source failures (RangeMala), and malformed block
# bytes (RangeMala). Each sub-window is exactly one block (≤ CORPUS_LIMES);
# no whole-tensor or whole-model read path exists.

importa ex "gradus:model/gguf_manifest" manifestum
importa ex "gradus:model/tensor_payload" tensor_payload
importa ex "gradus:model/dequant" dequant

@ publica
genus VisumTensoris {
    textus nomen
    lista<numerus> forma
    numerus typo_ggml
    numerus elementa
    manifestum.LayoutGgml layout
    numerus initium_absolutum
    numerus longitudo_payloadis
}

@ publica
discretio VisioError {
    NomineIgnota { textus causa }
    RangeMala { textus causa }
    LongitudoMala { textus causa }
    LayoutIgnota { textus causa }
    TypoIgnotum { textus causa }
    OrdoMala { textus causa }
    LimitesMala { textus causa }
}

@ publica
functio causa(VisioError e) → textus {
    discerne e {
        casu NomineIgnota fixum causa { redde causa }
        casu RangeMala fixum causa { redde causa }
        casu LongitudoMala fixum causa { redde causa }
        casu LayoutIgnota fixum causa { redde causa }
        casu TypoIgnotum fixum causa { redde causa }
        casu OrdoMala fixum causa { redde causa }
        casu LimitesMala fixum causa { redde causa }
    }
}

# Descriptor lookup for the bind. inveni_tensorem only raises WireMala;
# unknown names fail closed as NomineIgnota.
@ privata
functio _descriptio(manifestum.ManifestumGguf m, textus nomen) → manifestum.DescriptioTensorisGguf ⇥ VisioError {
    fac {
        redde manifestum.inveni_tensorem(m, nomen)
    }
    cape err {
        discerne err {
            casu WireMala fixum causa { iace finge NomineIgnota { causa = causa } }
            ceterum { iace finge NomineIgnota { causa = "tensor not found: " + nomen } }
        }
    }
}

# Manifest range seam for a known-layout tensor. Inside the bind this runs
# only after name and layout checks, so its only reachable failure is a
# manifest-range overflow; it still fails closed as LimitesMala.
@ privata
functio _limes(manifestum.ManifestumGguf m, textus nomen) → iuncta<numerus, numerus> ⇥ VisioError {
    fac {
        redde manifestum.limes_payloadis(m, nomen)
    }
    cape err {
        discerne err {
            casu WireMala fixum causa { iace finge NomineIgnota { causa = causa } }
            ceterum { iace finge LimitesMala { causa = "manifest tensor range facts are invalid" } }
        }
    }
}

# Bind one descriptor + one validated payload into the typed view. The payload
# supplies only bounded bytes plus its own range facts; both facts must match
# the manifest's validated tensor table exactly.
@ publica
functio vincula(manifestum.ManifestumGguf m, tensor_payload.TensorPayload p) → VisumTensoris ⇥ VisioError {
    fixum manifestum.DescriptioTensorisGguf t ← _descriptio(m, p.nomen)
    discerne t.layout {
        casu Ignota fixum typo {
            iace finge LayoutIgnota { causa = "tensor layout is unknown; payload range is unavailable" }
        }
        casu Cognita fixum elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            # Un-admitted physical types fail closed before any range
            # comparison — dequant cross-checks admission, never re-derives.
            si dequant.elementa_glomoris(t.typo_ggml) ≡ 0 {
                iace finge TypoIgnotum { causa = "un-admitted GGML type id: " + (t.typo_ggml ↦ textus) }
            }
            fixum iuncta<numerus, numerus> limes ← _limes(m, p.nomen)
            si p.initium_absolutum ≠ limes[0] {
                iace finge RangeMala { causa = "payload start does not match the manifest tensor range" }
            }
            si p.longitudo ≠ limes[1] {
                iace finge LongitudoMala { causa = "payload length does not match the stored layout length" }
            }
            redde VisumTensoris {
                nomen = t.nomen,
                forma = t.forma,
                typo_ggml = t.typo_ggml,
                elementa = t.elementa,
                layout = t.layout,
                initium_absolutum = limes[0],
                longitudo_payloadis = limes[1]
            }
        }
    }
}

# Window cap for a single materialization: 16 Mi elements (the forward graph
# never needs a window above this; a larger window is a caller bug, not a
# contract negotiation).
@ publica
fixum numerus MAXIMUM_SLICEM_ELEMENTA ← 16777216

# One operation-scoped block read through the caller's source. The source is
# a function value supplied anew per operation and is never retained by any
# view. Every request is exactly one block (octeti_per_blockum bytes, ≤
# CORPUS_LIMES by construction for the admitted block types); a failed or
# short read fails closed as RangeMala.
@ privata
functio _fons_lege(
    (numerus, numerus) → manifestum.LectioFontis fons,
    numerus initium,
    numerus longitudo
) → octeti ⇥ VisioError {
    si initium < 0 aut longitudo < 0 {
        iace finge RangeMala { causa = "block sub-window range is negative" }
    }
    fixum manifestum.LectioFontis lectio ← fons(initium, longitudo)
    si non lectio.successus {
        iace finge RangeMala { causa = "payload range source failed: " + lectio.causa }
    }
    fixum octeti lectum ← lectio.bytes
    si lectum.longitudo() ≠ longitudo {
        iace finge RangeMala { causa = "payload range source returned an unexpected byte length" }
    }
    redde lectum
}

# Dequantize one element-aligned window of a bound view, one block per
# source read, in GGUF block order. The window [initium_elementum,
# initium_elementum + longitudo_elementum) must be within the tensor and
# block-aligned; the layout must be known; the source must answer each
# one-block request; each block must decode. No whole-tensor or whole-model
# read path exists.
@ publica
functio materializa_slicem(
    VisumTensoris v,
    numerus initium_elementum,
    numerus longitudo_elementum,
    (numerus, numerus) → manifestum.LectioFontis fons
) → lista<f32> ⇥ VisioError {
    discerne v.layout {
        casu Ignota fixum typo {
            iace finge LayoutIgnota { causa = "tensor layout is unknown; payload range is unavailable" }
        }
        casu Cognita fixum elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            si initium_elementum < 0 aut longitudo_elementum < 0 {
                iace finge LimitesMala { causa = "element window is negative" }
            }
            si longitudo_elementum > MAXIMUM_SLICEM_ELEMENTA {
                iace finge LimitesMala { causa = "element window exceeds the bounded slice cap" }
            }
            si initium_elementum > v.elementa aut longitudo_elementum > v.elementa - initium_elementum {
                iace finge LimitesMala { causa = "element window exceeds the tensor" }
            }
            si initium_elementum % elementa_per_blockum ≠ 0 aut longitudo_elementum % elementa_per_blockum ≠ 0 {
                iace finge OrdoMala { causa = "element window is not aligned to the tensor block boundary" }
            }
            fixum numerus blocci_prima ← initium_elementum / elementa_per_blockum
            fixum numerus blocci_numerus ← longitudo_elementum / elementa_per_blockum
            varia lista<f32> y ← vacua
            varia numerus i ← 0
            dum i < blocci_numerus {
                fixum numerus blockum ← blocci_prima + i
                fixum numerus payload_off ← blockum * octeti_per_blockum
                fixum numerus absolutus ← v.initium_absolutum + payload_off
                fixum octeti lectum ← _fons_lege(fons, absolutus, octeti_per_blockum)
                varia lista<numerus<u8>> blocci ← vacua
                varia numerus j ← 0
                dum j < lectum.longitudo() {
                    blocci.appende(lectum.accipe(j) vel (0 ∷ numerus<u8>))
                    j ← j + 1
                }
                fac {
                    fixum lista<f32> g ← dequant.dequantizas_glomulus(v.typo_ggml, blocci)
                    itera ex g fixum x {
                        y.appende(x)
                    }
                }
                cape err {
                    discerne err {
                        casu ValorMala fixum causa { iace finge RangeMala { causa = "block value decode failed: " + causa } }
                        ceterum { iace finge RangeMala { causa = "block decode failed" } }
                    }
                }
                i ← i + 1
            }
            redde y
        }
    }
}
