+++
locale = "en"
+++
# Bounded typed tensor view, fail-closed bind, and windowed materializer
# (GGUF-A3 C2-U3 + C2-U4).
#
# Public import: import from "gradus:model/tensor_view" tensor_view
# Depends on: gradus:model/gguf_manifest (payload_limit + find_tensor
#   range seam), gradus:model/tensor_payload (bounded payload value),
#   gradus:model/dequant (admitted-type cross-check + block codecs).
#
# `links` binds one descriptor + one validated payload into the typed view.
# It fails closed on: unknown name (UnknownName), unknown layout
# (UnknownLayout), un-admitted physical type (UnknownDtype), absolute-range
# mismatch (BadRange), or stored-length mismatch (BadLength). The
# manifest is the single layout authority — dequant only cross-checks
# admission and never re-derives layout. `TensorView` never retains a
# path, reader, or source function; the bind reads no payload bytes.
#
# `materialize_slice` dequantizes one element-aligned window of a bound
# view through the operation-scoped source, one block per read, in GGUF
# block order. It fails closed on: negative / out-of-tensor / over-cap
# windows (BadBounds), block-misaligned windows (BadOrder), unknown
# layout (UnknownLayout), source failures (BadRange), and malformed block
# bytes (BadRange). Each sub-window is exactly one block (≤ CORPUS_LIMIT);
# no whole-tensor or whole-model read path exists.
#
# `materialize_block` is the single-block probe: it dequantizes exactly
# one block of a bound view by block index. It fails closed on an
# out-of-range block index (BadBounds), unknown layout (UnknownLayout),
# source failures (BadRange), and malformed block bytes (BadRange). Like
# `materialize_slice`, it never reads a whole tensor or whole model.

import from "gradus:model/gguf_manifest" gguf_manifest

import from "gradus:model/tensor_payload" tensor_payload

import from "gradus:model/dequant" dequant

@ public { }
class TensorView {
    string name
    list<int> shape
    int dtype_ggml
    int elements
    gguf_manifest.GgmlLayout layout
    int absolute_start
    int payload_length
}

@ public { }
union ViewError {
    @ shared
    string message

    UnknownName,
    BadRange,
    BadLength,
    UnknownLayout,
    UnknownDtype,
    BadOrder,
    BadBounds
}



# Descriptor lookup for the bind. find_tensor raises NotFound for an
# unknown name; that absence fails closed as UnknownName.
@ private { }
fn _description(gguf_manifest.GgufManifest m, string name) → gguf_manifest.GgufTensorDescriptor ⇥ ViewError {
    do {
        return gguf_manifest.find_tensor(m, name)
    }
    catch err {
        match err {
            case gguf_manifest.NotFound const message {
                throw variant UnknownName {message = message}
            }
            case _ {
                throw variant UnknownName {message = "tensor not found: §"(name)}
            }
        }
    }
}

# Manifest range seam for a known-layout tensor. Inside the bind this runs
# only after name and layout checks, so its only reachable failure is a
# manifest-range overflow; it still fails closed as BadBounds.
@ private { }
fn _limit(gguf_manifest.GgufManifest m, string name) → tuple<int, int> ⇥ ViewError {
    do {
        return gguf_manifest.payload_limit(m, name)
    }
    catch err {
        match err {
            case gguf_manifest.NotFound const message {
                throw variant UnknownName {message = message}
            }
            case _ {
                throw variant BadBounds {message = "manifest tensor range facts are invalid"}
            }
        }
    }
}

# Known-layout projection. Unknown layouts fail closed before any range
# or decode work; both materializers share the same message.
@ private { }
fn _known(gguf_manifest.GgmlLayout layout) → tuple<int, int, int> ⇥ ViewError {
    match layout {
        case gguf_manifest.Unknown const kind {
            throw variant UnknownLayout {message = "tensor layout is unknown; payload range is unavailable"}
        }
        case gguf_manifest.Known const elements_per_block, bytes_per_block, byte_length {
            return tuple<int, int, int> [elements_per_block, bytes_per_block, byte_length]
        }
    }
}

# Bind one descriptor + one validated payload into the typed view. The payload
# supplies only bounded bytes plus its own range facts; both facts must match
# the manifest's validated tensor table exactly.
@ public { }
fn links(gguf_manifest.GgufManifest m, tensor_payload.TensorPayload p) → TensorView ⇥ ViewError {
    const gguf_manifest.GgufTensorDescriptor t ← _description(m, p.name)
    match t.layout {
        case gguf_manifest.Unknown const kind {
            throw variant UnknownLayout {message = "tensor layout is unknown; payload range is unavailable"}
        }
        case gguf_manifest.Known const elements_per_block, bytes_per_block, byte_length {
            # Un-admitted physical types fail closed before any range
            # comparison — dequant cross-checks admission, never re-derives.
            require dequant.block_elements(t.dtype_ggml) ≠ 0 throw variant UnknownDtype {message = "un-admitted GGML type id: §"(t.dtype_ggml ↦ string)}
            const tuple<int, int> limit ← _limit(m, p.name)
            require p.absolute_start ≡ limit[0] throw variant BadRange {message = "payload start does not match the manifest tensor range"}
            require p.length ≡ limit[1] throw variant BadLength {message = "payload length does not match the stored layout length"}
            return TensorView {name = t.name, shape = t.shape, dtype_ggml = t.dtype_ggml, elements = t.elements, layout = t.layout, absolute_start = limit[0], payload_length = limit[1]}
        }
    }
}

# Window cap for a single materialization: 16 Mi elements (the forward graph
# never needs a window above this; a larger window is a caller bug, not a
# contract negotiation).

const int MAXIMUM_SLICE_ELEMENTS ← 16777216

# One operation-scoped block read through the caller's source. The source is
# a function value supplied anew per operation and is never retained by any
# view. Every request is exactly one block (bytes_per_block bytes, ≤
# CORPUS_LIMIT by construction for the admitted block types); a failed or
# short read fails closed as BadRange.
@ private { }
fn _read_source((int, int) → bytes ⇥ gguf_manifest.GgufManifestError source, int start, int length) → bytes ⇥ ViewError {
    require start ≥ 0 throw variant BadRange {message = "block sub-window range is negative"}
    require length ≥ 0 throw variant BadRange {message = "block sub-window range is negative"}
    var bytes chunk ← ||
    do {
        chunk ← source(start, length)
    }
    catch err {
        throw variant BadRange {message = "payload range source failed: §"(err.message)}
    }
    require chunk.length() ≡ length throw variant BadRange {message = "payload range source returned an unexpected byte length"}
    return chunk
}

@ private { }
fn _read_block(TensorView v, int bytes_per_block, int block, (int, int) → bytes ⇥ gguf_manifest.GgufManifestError source) → bytes ⇥ ViewError {
    const int payload_off ← block * bytes_per_block
    const int absolute ← v.absolute_start + payload_off
    return _read_source(source, absolute, bytes_per_block)
}

@ private { }
fn _block_bytes(bytes chunk) → list<int<u8>> {
    var list<int<u8>> out ← empty
    # legacy-L2: flat byte carrier — value iteration replaces the invalid coordinate walk.
    for from chunk const byte {
        out.append(byte ∷ int<u8>)
    }
    return out
}

@ private { }
fn _dequantize_chunk(int dtype_ggml, bytes chunk) → list<f32> ⇥ ViewError {
    do {
        return dequant.dequantize_block(dtype_ggml, _block_bytes(chunk))
    }
    catch err {
        match err {
            case dequant.BadPayload const message {
                throw variant BadRange {message = "block value decode failed: §"(message)}
            }
            case _ {
                throw variant BadRange {message = "block decode failed"}
            }
        }
    }
    throw variant BadRange {message = "block decode failed"}
}

# Dequantize one element-aligned window of a bound view, one block per
# source read, in GGUF block order. The window [element_start,
# element_start + element_length) must be within the tensor and
# block-aligned; the layout must be known; the source must answer each
# one-block request; each block must decode. No whole-tensor or whole-model
# read path exists.
@ public { }
fn materialize_slice(TensorView v, int element_start, int element_length, (int, int) → bytes ⇥ gguf_manifest.GgufManifestError source) → list<f32> ⇥ ViewError {
    const tuple<int, int, int> known ← _known(v.layout)
    const int elements_per_block ← known[0]
    const int bytes_per_block ← known[1]
    require element_start ≥ 0 throw variant BadBounds {message = "element window is negative"}
    require element_length ≥ 0 throw variant BadBounds {message = "element window is negative"}
    require element_length ≤ MAXIMUM_SLICE_ELEMENTS throw variant BadBounds {message = "element window exceeds the bounded slice cap"}
    require element_start ≤ v.elements throw variant BadBounds {message = "element window exceeds the tensor"}
    require element_length ≤ v.elements - element_start throw variant BadBounds {message = "element window exceeds the tensor"}
    require element_start % elements_per_block ≡ 0 throw variant BadOrder {message = "element window is not aligned to the tensor block boundary"}
    require element_length % elements_per_block ≡ 0 throw variant BadOrder {message = "element window is not aligned to the tensor block boundary"}
    const int first_block ← element_start / elements_per_block
    const int block_count ← element_length / elements_per_block
    var list<f32> y ← empty
    for range 0‥block_count const i {
        const list<f32> g ← _dequantize_chunk(v.dtype_ggml, _read_block(v, bytes_per_block, first_block + i, source))
        for from g const x {
            y.append(x)
        }
    }
    return y
}

# Dequantize exactly one block of a bound view, addressed by block index —
# the single-block probe over the same read path as materialize_slice. The
# block index must be within the tensor's block count; the layout must be
# known; the source must answer the one-block request; the block must
# decode. No whole-tensor or whole-model read path exists.
@ public { }
fn materialize_block(TensorView v, int block_index, (int, int) → bytes ⇥ gguf_manifest.GgufManifestError source) → list<f32> ⇥ ViewError {
    const tuple<int, int, int> known ← _known(v.layout)
    const int elements_per_block ← known[0]
    const int bytes_per_block ← known[1]
    require block_index ≥ 0 throw variant BadBounds {message = "block index is negative"}
    const int blocks ← v.elements / elements_per_block
    require block_index ≺ blocks throw variant BadBounds {message = "block index exceeds the tensor block count"}
    return _dequantize_chunk(v.dtype_ggml, _read_block(v, bytes_per_block, block_index, source))
}
