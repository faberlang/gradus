# Bounded typed tensor view and fail-closed bind (GGUF-A3 C2-U3).
#
# Public import: importa ex "gradus:model/tensor_view" tensor_view
# Depends on: gradus:model/gguf_manifest (limes_payloadis + inveni_tensorem
#   range seam), gradus:model/tensor_payload (bounded payload value),
#   gradus:model/dequant (admitted-type cross-check).
#
# `vincula` binds one descriptor + one validated payload into the typed view.
# It fails closed on: unknown name (NomineIgnota), unknown layout
# (LayoutIgnota), un-admitted physical type (TypoIgnotum), absolute-range
# mismatch (RangeMala), or stored-length mismatch (LongitudoMala). The
# manifest is the single layout authority — dequant only cross-checks
# admission and never re-derives layout. `VisumTensoris` never retains a
# path, reader, or source function; the bind reads no payload bytes
# (windowed materialization is C2-U4/C2-U5's behavior family).

importa ex "gradus:model/gguf_manifest" manifestum
importa ex "gradus:model/tensor_payload" tensor_payload
importa ex "gradus:model/dequant" dequant

@ publica
genus VisumTensoris {
    textus nomen
    lista<numerus> forma
    numerus typo_ggml
    numerus elementa
    manifestum.LayoutGgml layout
    numerus initium_absolutum
    numerus longitudo_payloadis
}

@ publica
discretio VisioError {
    NomineIgnota { textus causa }
    RangeMala { textus causa }
    LongitudoMala { textus causa }
    LayoutIgnota { textus causa }
    TypoIgnotum { textus causa }
    OrdoMala { textus causa }
    LimitesMala { textus causa }
}

@ publica
functio causa(VisioError e) → textus {
    discerne e {
        casu NomineIgnota fixum causa { redde causa }
        casu RangeMala fixum causa { redde causa }
        casu LongitudoMala fixum causa { redde causa }
        casu LayoutIgnota fixum causa { redde causa }
        casu TypoIgnotum fixum causa { redde causa }
        casu OrdoMala fixum causa { redde causa }
        casu LimitesMala fixum causa { redde causa }
    }
}

# Descriptor lookup for the bind. inveni_tensorem only raises WireMala;
# unknown names fail closed as NomineIgnota.
@ privata
functio _descriptio(manifestum.ManifestumGguf m, textus nomen) → manifestum.DescriptioTensorisGguf ⇥ VisioError {
    fac {
        redde manifestum.inveni_tensorem(m, nomen)
    }
    cape err {
        discerne err {
            casu WireMala fixum causa { iace finge NomineIgnota { causa = causa } }
            ceterum { iace finge NomineIgnota { causa = "tensor not found: " + nomen } }
        }
    }
}

# Manifest range seam for a known-layout tensor. Inside the bind this runs
# only after name and layout checks, so its only reachable failure is a
# manifest-range overflow; it still fails closed as LimitesMala.
@ privata
functio _limes(manifestum.ManifestumGguf m, textus nomen) → iuncta<numerus, numerus> ⇥ VisioError {
    fac {
        redde manifestum.limes_payloadis(m, nomen)
    }
    cape err {
        discerne err {
            casu WireMala fixum causa { iace finge NomineIgnota { causa = causa } }
            ceterum { iace finge LimitesMala { causa = "manifest tensor range facts are invalid" } }
        }
    }
}

# Bind one descriptor + one validated payload into the typed view. The payload
# supplies only bounded bytes plus its own range facts; both facts must match
# the manifest's validated tensor table exactly.
@ publica
functio vincula(manifestum.ManifestumGguf m, tensor_payload.TensorPayload p) → VisumTensoris ⇥ VisioError {
    fixum manifestum.DescriptioTensorisGguf t ← _descriptio(m, p.nomen)
    discerne t.layout {
        casu Ignota fixum typo {
            iace finge LayoutIgnota { causa = "tensor layout is unknown; payload range is unavailable" }
        }
        casu Cognita fixum elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            # Un-admitted physical types fail closed before any range
            # comparison — dequant cross-checks admission, never re-derives.
            si dequant.elementa_glomoris(t.typo_ggml) ≡ 0 {
                iace finge TypoIgnotum { causa = "un-admitted GGML type id: " + (t.typo_ggml ↦ textus) }
            }
            fixum iuncta<numerus, numerus> limes ← _limes(m, p.nomen)
            si p.initium_absolutum ≠ limes[0] {
                iace finge RangeMala { causa = "payload start does not match the manifest tensor range" }
            }
            si p.longitudo ≠ limes[1] {
                iace finge LongitudoMala { causa = "payload length does not match the stored layout length" }
            }
            redde VisumTensoris {
                nomen = t.nomen,
                forma = t.forma,
                typo_ggml = t.typo_ggml,
                elementa = t.elementa,
                layout = t.layout,
                initium_absolutum = limes[0],
                longitudo_payloadis = limes[1]
            }
        }
    }
}
