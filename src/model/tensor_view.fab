+++
locale = "en"
+++
# Bounded typed tensor view, fail-closed bind, and windowed materializer
# (GGUF-A3 C2-U3 + C2-U4).
#
# Public import: importa ex "gradus:model/tensor_view" tensor_view
# Depends on: gradus:model/gguf_manifest (limes_payloadis + inveni_tensorem
#   range seam), gradus:model/tensor_payload (bounded payload value),
#   gradus:model/dequant (admitted-type cross-check + block codecs).
#
# `vincula` binds one descriptor + one validated payload into the typed view.
# It fails closed on: unknown name (NomineIgnota), unknown layout
# (LayoutIgnota), un-admitted physical type (TypoIgnotum), absolute-range
# mismatch (RangeMala), or stored-length mismatch (LongitudoMala). The
# manifest is the single layout authority — dequant only cross-checks
# admission and never re-derives layout. `VisumTensoris` never retains a
# path, reader, or source function; the bind reads no payload bytes.
#
# `materializa_slicem` dequantizes one element-aligned window of a bound
# view through the operation-scoped source, one block per read, in GGUF
# block order. It fails closed on: negative / out-of-tensor / over-cap
# windows (LimitesMala), block-misaligned windows (OrdoMala), unknown
# layout (LayoutIgnota), source failures (RangeMala), and malformed block
# bytes (RangeMala). Each sub-window is exactly one block (≤ CORPUS_LIMES);
# no whole-tensor or whole-model read path exists.
#
# `materializa_glomulum` is the single-block probe: it dequantizes exactly
# one block of a bound view by block index. It fails closed on an
# out-of-range block index (LimitesMala), unknown layout (LayoutIgnota),
# source failures (RangeMala), and malformed block bytes (RangeMala). Like
# `materializa_slicem`, it never reads a whole tensor or whole model.

import from "gradus:model/gguf_manifest" manifestum

import from "gradus:model/tensor_payload" tensor_payload

import from "gradus:model/dequant" dequant

@ public { }
class TensorView {
    string name
    list<int> shape
    int dtype_ggml
    int elements
    manifestum.GgmlLayout layout
    int absolute_start
    int longitudo_payloadis
}

@ public { }
union ViewError {
    NomineIgnota {
        string message
    },
    RangeMala {
        string message
    },
    LongitudoMala {
        string message
    },
    LayoutIgnota {
        string message
    },
    TypoIgnotum {
        string message
    },
    OrdoMala {
        string message
    },
    LimitesMala {
        string message
    }
}

@ public { }
fn message(ViewError e) → string {
    match e {
        case NomineIgnota const causa {
            return causa
        }
        case RangeMala const causa {
            return causa
        }
        case LongitudoMala const causa {
            return causa
        }
        case LayoutIgnota const causa {
            return causa
        }
        case TypoIgnotum const causa {
            return causa
        }
        case OrdoMala const causa {
            return causa
        }
        case LimitesMala const causa {
            return causa
        }
    }
}

# Descriptor lookup for the bind. inveni_tensorem only raises WireMala;
# unknown names fail closed as NomineIgnota.
@ private { }
fn _description(manifestum.GgufManifest m, string nomen) → manifestum.GgufTensorDescriptor ⇥ ViewError {
    do {
        return manifestum.inveni_tensorem(m, nomen)
    }
    catch err {
        match err {
            case manifestum.WireMala const causa {
                throw variant NomineIgnota {message = causa}
            }
            case _ {
                throw variant NomineIgnota {message = "tensor not found: " + nomen}
            }
        }
    }
}

# Manifest range seam for a known-layout tensor. Inside the bind this runs
# only after name and layout checks, so its only reachable failure is a
# manifest-range overflow; it still fails closed as LimitesMala.
@ private { }
fn _limit(manifestum.GgufManifest m, string nomen) → tuple<int, int> ⇥ ViewError {
    do {
        return manifestum.limes_payloadis(m, nomen)
    }
    catch err {
        match err {
            case manifestum.WireMala const causa {
                throw variant NomineIgnota {message = causa}
            }
            case _ {
                throw variant LimitesMala {message = "manifest tensor range facts are invalid"}
            }
        }
    }
}

# Bind one descriptor + one validated payload into the typed view. The payload
# supplies only bounded bytes plus its own range facts; both facts must match
# the manifest's validated tensor table exactly.
@ public { }
fn links(manifestum.GgufManifest m, tensor_payload.TensorPayload p) → TensorView ⇥ ViewError {
    const manifestum.GgufTensorDescriptor t ← _description(m, p.name)
    match t.layout {
        case manifestum.Ignota const typo {
            throw variant LayoutIgnota {message = "tensor layout is unknown; payload range is unavailable"}
        }
        case manifestum.Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            # Un-admitted physical types fail closed before any range
            # comparison — dequant cross-checks admission, never re-derives.
            if dequant.block_elements(t.dtype_ggml) ≡ 0 {
                throw variant TypoIgnotum {message = "un-admitted GGML type id: " + (t.dtype_ggml ↦ string)}
            }
            const tuple<int, int> limes ← _limit(m, p.name)
            if p.absolute_start ≠ limes[0] {
                throw variant RangeMala {message = "payload start does not match the manifest tensor range"}
            }
            if p.length ≠ limes[1] {
                throw variant LongitudoMala {message = "payload length does not match the stored layout length"}
            }
            return TensorView {name = t.name, shape = t.shape, dtype_ggml = t.dtype_ggml, elements = t.elements, layout = t.layout, absolute_start = limes[0], longitudo_payloadis = limes[1]}
        }
    }
}

# Window cap for a single materialization: 16 Mi elements (the forward graph
# never needs a window above this; a larger window is a caller bug, not a
# contract negotiation).

const int MAXIMUM_SLICEM_ELEMENTA ← 16777216

# One operation-scoped block read through the caller's source. The source is
# a function value supplied anew per operation and is never retained by any
# view. Every request is exactly one block (octeti_per_blockum bytes, ≤
# CORPUS_LIMES by construction for the admitted block types); a failed or
# short read fails closed as RangeMala.
@ private { }
fn _read_source((int, int) → manifestum.SourceRead fons, int initium, int longitudo) → bytes ⇥ ViewError {
    if initium ≺ 0 or longitudo ≺ 0 {
        throw variant RangeMala {message = "block sub-window range is negative"}
    }
    const manifestum.SourceRead lectio ← fons(initium, longitudo)
    if not lectio.successus {
        throw variant RangeMala {message = "payload range source failed: " + lectio.message}
    }
    const bytes lectum ← lectio.bytes
    if lectum.length() ≠ longitudo {
        throw variant RangeMala {message = "payload range source returned an unexpected byte length"}
    }
    return lectum
}

# Dequantize one element-aligned window of a bound view, one block per
# source read, in GGUF block order. The window [initium_elementum,
# initium_elementum + longitudo_elementum) must be within the tensor and
# block-aligned; the layout must be known; the source must answer each
# one-block request; each block must decode. No whole-tensor or whole-model
# read path exists.
@ public { }
fn materialize_slice(TensorView v, int initium_elementum, int longitudo_elementum, (int, int) → manifestum.SourceRead fons) → list<f32> ⇥ ViewError {
    match v.layout {
        case manifestum.Ignota const typo {
            throw variant LayoutIgnota {message = "tensor layout is unknown; payload range is unavailable"}
        }
        case manifestum.Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            if initium_elementum ≺ 0 or longitudo_elementum ≺ 0 {
                throw variant LimitesMala {message = "element window is negative"}
            }
            if longitudo_elementum ≻ MAXIMUM_SLICEM_ELEMENTA {
                throw variant LimitesMala {message = "element window exceeds the bounded slice cap"}
            }
            if initium_elementum ≻ v.elements or longitudo_elementum ≻ v.elements - initium_elementum {
                throw variant LimitesMala {message = "element window exceeds the tensor"}
            }
            if initium_elementum % elementa_per_blockum ≠ 0 or longitudo_elementum % elementa_per_blockum ≠ 0 {
                throw variant OrdoMala {message = "element window is not aligned to the tensor block boundary"}
            }
            const int blocci_prima ← initium_elementum / elementa_per_blockum
            const int blocci_numerus ← longitudo_elementum / elementa_per_blockum
            var list<f32> y ← vacua
            var int i ← 0
            while i ≺ blocci_numerus {
                const int blockum ← blocci_prima + i
                const int payload_off ← blockum * octeti_per_blockum
                const int absolutus ← v.absolute_start + payload_off
                const bytes lectum ← _read_source(fons, absolutus, octeti_per_blockum)
                var list<int<u8>> blocci ← vacua
                var int j ← 0
                while j ≺ lectum.length() {
                    blocci.append(lectum.get(j) coalesce 0 ∷ int<u8>)
                    j ← j + 1
                }
                do {
                    const list<f32> g ← dequant.dequantize_block(v.dtype_ggml, blocci)
                    for from g const x {
                        y.append(x)
                    }
                }
                catch err {
                    match err {
                        case dequant.ValorMala const causa {
                            throw variant RangeMala {message = "block value decode failed: " + causa}
                        }
                        case _ {
                            throw variant RangeMala {message = "block decode failed"}
                        }
                    }
                }
                i ← i + 1
            }
            return y
        }
    }
}

# Dequantize exactly one block of a bound view, addressed by block index —
# the single-block probe over the same read path as materializa_slicem. The
# block index must be within the tensor's block count; the layout must be
# known; the source must answer the one-block request; the block must
# decode. No whole-tensor or whole-model read path exists.
@ public { }
fn materialize_block(TensorView v, int index_glomuli, (int, int) → manifestum.SourceRead fons) → list<f32> ⇥ ViewError {
    match v.layout {
        case manifestum.Ignota const typo {
            throw variant LayoutIgnota {message = "tensor layout is unknown; payload range is unavailable"}
        }
        case manifestum.Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            if index_glomuli ≺ 0 {
                throw variant LimitesMala {message = "block index is negative"}
            }
            const int blocci ← v.elements / elementa_per_blockum
            if index_glomuli ≥ blocci {
                throw variant LimitesMala {message = "block index exceeds the tensor block count"}
            }
            const int payload_off ← index_glomuli * octeti_per_blockum
            const int absolutus ← v.absolute_start + payload_off
            const bytes lectum ← _read_source(fons, absolutus, octeti_per_blockum)
            var list<int<u8>> blocci_octeti ← vacua
            var int j ← 0
            while j ≺ lectum.length() {
                blocci_octeti.append(lectum.get(j) coalesce 0 ∷ int<u8>)
                j ← j + 1
            }
            do {
                return dequant.dequantize_block(v.dtype_ggml, blocci_octeti)
            }
            catch err {
                match err {
                    case dequant.ValorMala const causa {
                        throw variant RangeMala {message = "block value decode failed: " + causa}
                    }
                    case _ {
                        throw variant RangeMala {message = "block decode failed"}
                    }
                }
            }
        }
    }
}
