+++ toml
locale = "en"

+++ faber
# Bounded typed tensor view, open encoded-storage bind, and windowed
# materializer (GGUF-A3 C2-U3 + C2-U4).
#
# Public import: import from "gradus:model/tensor_view" tensor_view
# Depends on: gradus:model/gguf_manifest (payload_limit + find_tensor
#   range seam), gradus:model/tensor_payload (bounded payload value),
#   gradus:model/dequant (explicit F32 decoder), gradus:storage (open encoded
#   representation + block metadata).
#
# `links` binds one descriptor + one validated payload into the typed view.
# Unknown representation identities remain bindable and are preserved with
# their opaque payload bytes. The bind fails closed on unknown name
# (UnknownName), absolute-range mismatch (BadRange), or stored-length
# mismatch for a known layout (BadLength). The manifest's layout projection
# supplies block facts when it knows them; `TensorView` also carries the open
# representation and block metadata. It never retains a path, reader, or
# source function.
#
# `materialize_slice` decodes one element-aligned window of a bound
# view through the operation-scoped source, one block per read, in GGUF
# block order. It fails closed on: negative / out-of-tensor / over-cap
# windows (BadBounds), block-misaligned windows (BadOrder), unsupported
# decoder representation (UnsupportedRepresentation), unknown block
# geometry (UnknownLayout), source failures (BadRange), and malformed block
# bytes (BadRange). Each sub-window is exactly one block (≤ CORPUS_LIMIT);
# no whole-tensor or whole-model read path exists.
#
# `materialize_block` is the single-block probe: it decodes exactly
# one block of a bound view by block index. It fails closed on an
# out-of-range block index (BadBounds), unknown block geometry
# (UnknownLayout), unsupported decoder representation
# (UnsupportedRepresentation), source failures (BadRange), and malformed
# block bytes (BadRange). Like `materialize_slice`, it never reads a whole
# tensor or whole model.

import from "gradus:model/gguf_manifest"

import from "gradus:model/tensor_payload"

import from "gradus:model/dequant"

import from "gradus:storage"

@ public
class TensorView {
    mut string name
    mut list<int> shape
    mut int dtype_ggml
    mut storage.Representation representation
    mut int elements
    mut gguf_manifest.GgmlLayout layout
    mut storage.BlockMetadata block
    mut storage.EncodedStorage encoded
    mut int absolute_start
    mut int payload_length
}

@ public
union ViewError {
    @ shared
    string message

    UnknownName,
    BadRange,
    BadLength,
    UnknownLayout,
    UnsupportedRepresentation,
    BadOrder,
    BadBounds,
    ManifestFailure {
        gguf_manifest.GgufManifestError inner
    }
}

@ conversion
fn from_gguf_manifest_error(gguf_manifest.GgufManifestError err) → ViewError {
    return variant ManifestFailure { message = err.message, inner = err }
}

# Descriptor lookup for the bind. find_tensor raises NotFound for an
# unknown name; that absence fails closed as UnknownName.
fn description(gguf_manifest.GgufManifest m, string name) → gguf_manifest.GgufTensorDescriptor ⇥ ViewError {
    do {
        return gguf_manifest.find_tensor(m, name)
    }
    catch err {
        match err {
            case gguf_manifest.NotFound let message {
                throw variant UnknownName { message = message }
            }
            case _ {
                throw variant ManifestFailure { message = err.message, inner = err }
            }
        }
    }
}

# Manifest range seam for a known-layout tensor. Inside the bind this runs
# only after name and layout checks, so its only reachable failure is a
# manifest-range overflow; it still fails closed as BadBounds.
fn limit_of(gguf_manifest.GgufManifest m, string name) → tuple<int, int> ⇥ ViewError {
    do {
        return gguf_manifest.payload_limit(m, name)
    }
    catch err {
        match err {
            case gguf_manifest.NotFound let message {
                throw variant UnknownName { message = message }
            }
            case _ {
                throw variant BadBounds { message = "manifest tensor range facts are invalid" }
            }
        }
    }
}

# Known block projection. Unknown geometry fails closed before any window or
# decode work; both materializers share the same message. The projection is
# taken from the open metadata carried by the view, rather than re-deriving
# geometry from a representation name or code.
fn known_geometry(storage.BlockMetadata block) → tuple<int, int, int> ⇥ ViewError {
    if not block.known {
        throw variant UnknownLayout { message = "tensor layout is unknown; payload range is unavailable" }
    }

    return tuple<int, int, int> [block.elements_per_block, block.bytes_per_block, block.byte_length]
}

# Bind one descriptor + one validated payload into the typed view. The payload
# supplies only bounded bytes plus its own range facts; both facts must match
# the manifest's validated tensor table exactly.
@ public
fn links(gguf_manifest.GgufManifest m, tensor_payload.TensorPayload p) → TensorView ⇥ ViewError {
    # --- descriptor lookup + open representation --------------------------
    let gguf_manifest.GgufTensorDescriptor t ← description(m, p.name)

    match t.layout {
        case gguf_manifest.Unknown let kind {
            # The manifest cannot derive a stored length for an unknown code,
            # but its data start and relative offset still identify the
            # payload's expected absolute beginning. The caller's supplied
            # length becomes opaque block metadata until a decoder or host
            # supplies geometry.
            let int expected_start ← m.data_start + t.relative_offset

            require p.absolute_start ≡ expected_start throw variant BadRange { message = "payload start does not match the manifest tensor range" }

            require p.length ≥ 0 throw variant BadLength { message = "payload length is negative" }

            require p.absolute_start ≤ m.artifact_length and p.length ≤ m.artifact_length - p.absolute_start throw variant BadRange { message = "opaque payload range exceeds the artifact" }

            let storage.BlockMetadata block ← storage.unknown_block(p.length)
            let storage.EncodedStorage encoded ← storage.encoded(p.bytes, t.representation, block)
            return TensorView { name = t.name, shape = t.shape, dtype_ggml = t.dtype_ggml, representation = t.representation, elements = t.elements, layout = t.layout, block = block, encoded = encoded, absolute_start = p.absolute_start, payload_length = p.length }
        }
        case gguf_manifest.Known let elements_per_block, bytes_per_block, byte_length {
            # --- payload range match + construct --------------------------
            let tuple<int, int> limit ← limit_of(m, p.name)

            require p.absolute_start ≡ limit[0] throw variant BadRange { message = "payload start does not match the manifest tensor range" }

            require p.length ≡ limit[1] throw variant BadLength { message = "payload length does not match the stored layout length" }

            let storage.EncodedStorage encoded ← storage.encoded(p.bytes, t.representation, t.block)
            return TensorView { name = t.name, shape = t.shape, dtype_ggml = t.dtype_ggml, representation = t.representation, elements = t.elements, layout = t.layout, block = t.block, encoded = encoded, absolute_start = limit[0], payload_length = limit[1] }
        }
    }
}

# Window cap for a single materialization: 16 Mi elements (the forward graph
# never needs a window above this; a larger window is a caller bug, not a
# contract negotiation).

@ public
const int MAXIMUM_SLICE_ELEMENTS = 16777216

# One operation-scoped block read through the caller's source. The source is
# a function value supplied anew per operation and is never retained by any
# view. Every request is exactly one block (bytes_per_block bytes, ≤
# CORPUS_LIMIT by construction for the admitted block types); a failed or
# short read fails closed as BadRange.
fn read_source((int, int) → list<b8> ⇥ gguf_manifest.GgufManifestError source, int start, int length) → list<b8> ⇥ ViewError {
    require start ≥ 0 throw variant BadRange { message = "block sub-window range is negative" }

    require length ≥ 0 throw variant BadRange { message = "block sub-window range is negative" }

    mut list<b8> chunk ← ||

    do {
        chunk ← source(start, length)
    }
    catch err {
        throw variant BadRange { message = "payload range source failed: §"(err.message) }
    }

    require chunk.length() ≡ length throw variant BadRange { message = "payload range source returned an unexpected byte length" }

    return chunk
}

fn read_block(TensorView v, int bytes_per_block, int block, (int, int) → list<b8> ⇥ gguf_manifest.GgufManifestError source) → list<b8> ⇥ ViewError {
    let int payload_off ← block * bytes_per_block
    let int absolute ← v.absolute_start + payload_off
    return read_source(source, absolute, bytes_per_block)
}

fn decode_chunk(storage.Representation representation, list<b8> chunk) → list<f32> ⇥ ViewError {
    do {
        return dequant.decode_block_f32(representation, chunk)
    }
    catch err {
        match err {
            case dequant.BadPayload let message {
                throw variant BadRange { message = "block value decode failed: §"(message) }
            }
            case dequant.DequantError.UnsupportedRepresentation let message {
                throw variant UnsupportedRepresentation { message = message }
            }
            case _ {
                throw variant BadRange { message = "block decode failed" }
            }
        }
    }

    throw variant BadRange { message = "block decode failed" }
}

# Decode one element-aligned window of a bound view, one block per
# source read, in GGUF block order. The window [element_start,
# element_start + element_length) must be within the tensor and
# block-aligned; the layout must be known; the source must answer each
# one-block request; each block must decode. No whole-tensor or whole-model
# read path exists.
@ public
fn materialize_slice(TensorView v, int element_start, int element_length, (int, int) → list<b8> ⇥ gguf_manifest.GgufManifestError source) → list<f32> ⇥ ViewError {
    # --- layout + window bounds (fail closed) -----------------------------
    let tuple<int, int, int> known ← known_geometry(v.block)
    let int elements_per_block ← known[0]
    let int bytes_per_block ← known[1]

    require element_start ≥ 0 throw variant BadBounds { message = "element window is negative" }

    require element_length ≥ 0 throw variant BadBounds { message = "element window is negative" }

    require element_length ≤ MAXIMUM_SLICE_ELEMENTS throw variant BadBounds { message = "element window exceeds the bounded slice cap" }

    require element_start ≤ v.elements throw variant BadBounds { message = "element window exceeds the tensor" }

    require element_length ≤ v.elements - element_start throw variant BadBounds { message = "element window exceeds the tensor" }

    require element_start % elements_per_block ≡ 0 throw variant BadOrder { message = "element window is not aligned to the tensor block boundary" }

    require element_length % elements_per_block ≡ 0 throw variant BadOrder { message = "element window is not aligned to the tensor block boundary" }

    # --- block read + decode loop -----------------------------------------
    let int first_block ← element_start / elements_per_block
    let int block_count ← element_length / elements_per_block
    mut list<f32> y ← empty

    for range 0 ‥ block_count let i {
        let list<f32> g ← decode_chunk(v.representation, read_block(v, bytes_per_block, first_block + i, source))

        for from g let x {
            y.append(x)
        }
    }

    return y
}

# Decode exactly one block of a bound view, addressed by block index —
# the single-block probe over the same read path as materialize_slice. The
# block index must be within the tensor's block count; the layout must be
# known; the source must answer the one-block request; the block must
# decode. No whole-tensor or whole-model read path exists.
@ public
fn materialize_block(TensorView v, int block_index, (int, int) → list<b8> ⇥ gguf_manifest.GgufManifestError source) → list<f32> ⇥ ViewError {
    let tuple<int, int, int> known ← known_geometry(v.block)
    let int elements_per_block ← known[0]
    let int bytes_per_block ← known[1]

    require block_index ≥ 0 throw variant BadBounds { message = "block index is negative" }

    let int blocks ← v.elements / elements_per_block

    require block_index ≺ blocks throw variant BadBounds { message = "block index exceeds the tensor block count" }

    return decode_chunk(v.representation, read_block(v, bytes_per_block, block_index, source))
}

+++ faber test
# Co-located package test for tensor_view.fab (GGUF-A3 C2-U3 — typed tensor
# view + fail-closed bind; C2-U4 — windowed materializer + cap; C2-U5 —
# single-block materializer probe).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the positive bind produces a TensorView carrying
# the manifest-derived view facts (name, open physical type id, logical
# element count, absolute payload start, stored payload length), and unknown
# representations preserve their identity, supplied bytes, and block
# metadata. Bind errors remain typed for unknown names, range mismatch, and
# known-layout length mismatch. Decoder failure is a separate materialization
# concern: a known but unsupported representation binds and fails only when
# an explicit F32 decode is requested. Imported-union variant construction is
# blocked by the pinned compiler defect (SEM001+SEM008), so the fail-closed
# cases flow through links's own error channel instead of constructing
# ViewError values directly; assert assertions run under the cargo-backed
# `faber test` harness (auditor-owned), while `faber check` proves the whole
# surface type-checks.
#
# C2-U4 windowed materializer: the `slice` helper and its cases pin the
# window contract (whole-block reads in GGUF block order, window bounds /
# alignment / cap / source-failure / malformed-block fail-closed rows).
# C2-U5 single-block probe: the `block` helper and its cases pin the
# block-index contract (first-block probe, out-of-range / negative index /
# source-failure / malformed-block fail-closed rows).
# COMPILER BOUNDARY NOTE: a proba call site cannot pass a function value to
# a module function whose parameter type is a function type — the call does
# not resolve (SEM010), the same pinned seam as gguf_manifest.proba's
# inspect/read_fragment calls. `materialize_slice` and
# `materialize_block` type-check in the module itself and are callable
# from package consumers (exempla, C3-U1); the `slice`/`block` calls
# below document the intended surface and their assertions run under the
# auditor-owned `faber test` harness.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" gguf_manifest

import from "gradus:model/tensor_payload" tensor_payload

import from "gradus:model/tensor_view" tensor_view

import from "gradus:storage" storage

const string F_DIGEST = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn u32(int n) → list<u8> {
    return [(n % 256) ↦ u8, ((n ⇒ 8) % 256) ↦ u8, ((n ⇒ 16) % 256) ↦ u8, ((n ⇒ 24) % 256) ↦ u8]
}

fn u64(int n) → list<u8> {
    return [(n % 256) ↦ u8, ((n ⇒ 8) % 256) ↦ u8, ((n ⇒ 16) % 256) ↦ u8, ((n ⇒ 24) % 256) ↦ u8, ((n ⇒ 32) % 256) ↦ u8, ((n ⇒ 40) % 256) ↦ u8, ((n ⇒ 48) % 256) ↦ u8, ((n ⇒ 56) % 256) ↦ u8]
}

fn join(list<u8> a, list<u8> b) → list<u8> {
    mut list<u8> out ← empty
    for from a let x {
        out.append(x)
    }
    for from b let x {
        out.append(x)
    }
    return out
}

fn text_bytes(string s) → list<u8> {
    # Package MIR has no text→bytes extraction arm. This structural
    # builder only needs a finite ASCII corpus, so keep its encoding explicit.
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_norm.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.experts.0.weight" then return [98, 108, 107, 46, 48, 46, 101, 120, 112, 101, 114, 116, 115, 46, 48, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "no.such.tensor" then return [110, 111, 46, 115, 117, 99, 104, 46, 116, 101, 110, 115, 111, 114]
    return []
}

fn str(string s) → list<u8> {
    let list<u8> b ← text_bytes(s)
    return join(u64(b.length()), b)
}

fn tensor_row(string name, list<int> shape, int kind, int offset) → list<u8> {
    mut list<u8> out ← join(str(name), u32(shape.length()))
    for from shape let dim {
        out ← join(out, u64(dim))
    }
    return join(join(out, u32(kind)), u64(offset))
}

fn header(int tensors, int metadata) → list<u8> {
    return join(join([71, 71, 85, 70], u32(3)), join(u64(tensors), u64(metadata)))
}

fn with_padding(list<u8> table, int alignment, int total) → gguf_manifest.GgufCorpus {
    let int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    mut list<u8> b ← empty
    for from table let x {
        b.append(x)
    }
    while b.length() ≺ data_offset {
        b.append(0 ∷ u8)
    }
    let list<b8> o ↤ b
    return gguf_manifest.GgufCorpus {table = o, artifact_length = total, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = total}}
}

# llama-like corpus: F32 token_embd.weight [4,8]@0 and F16
# blk.0.attn_norm.weight [8]@160. Data section starts at 160.
fn corpus_llama() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(2, 0)
    table ← join(table, tensor_row("token_embd.weight", [4, 8], 0, 0))
    table ← join(table, tensor_row("blk.0.attn_norm.weight", [8], 1, 160))
    return with_padding(table, 32, 336)
}

# Q4_0 (GGML id 2) has known block geometry but no current F32 decoder. It
# proves that storage binding preserves an unsupported representation and the
# explicit materializer reports the decoder boundary.
fn corpus_q4_0() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(1, 0)
    table ← join(table, tensor_row("blk.0.attn_norm.weight", [32], 2, 0))
    return with_padding(table, 32, 256)
}

# qwen35moe-like corpus: Unknown-layout blk.0.experts.0.weight [2,3,4]@0 (kind
# 999) and BF16 blk.0.attn_norm.weight [2,2]@64. Data section starts at 160.
fn corpus_qwen35moe() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(2, 0)
    table ← join(table, tensor_row("blk.0.experts.0.weight", [2, 3, 4], 999, 0))
    table ← join(table, tensor_row("blk.0.attn_norm.weight", [2, 2], 30, 64))
    return with_padding(table, 32, 232)
}

# Q8_0 corpus for the materializer: token_embd.weight [64] kind 8 (Q8_0,
# 32 elements/block, 34 bytes/block) -> 2 blocks, 68 payload bytes. Data
# section starts at 96 (DEFAULT_ALIGNMENT 32), artifact total 164.
fn corpus_q8() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(1, 0)
    table ← join(table, tensor_row("token_embd.weight", [64], 8, 0))
    return with_padding(table, 32, 164)
}

# Render one bind attempt as "name/kind/elements/start/length" or the
# typed ViewError render.
fn view(gguf_manifest.GgufCorpus corpus, string name, int start, int length) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            let tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {name = name, absolute_start = start, length = length, bytes = ||}
            let tensor_view.TensorView v ← tensor_view.links(m, p)
            return (((((((v.name + "/") + (v.dtype_ggml ↦ string)) + "/") + (v.elements ↦ string)) + "/") + (v.absolute_start ↦ string)) + "/") + (v.payload_length ↦ string)
        }
        catch err {
            return "ERR:§"(err.message)
        }
    }
    catch err {
        return "ERR:§"(err.message)
    }
}

# Render the open storage fields for a bind whose representation has no
# manifest geometry. The payload bytes are intentionally shorter than the
# caller-supplied opaque range length; both values must remain visible.
fn encoded_view(gguf_manifest.GgufCorpus corpus, string name, int start, int length) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            let list<u8> supplied_list ← [17 ∷ u8, 18 ∷ u8, 19 ∷ u8]
            let list<b8> supplied ↤ supplied_list
            let tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {name = name, absolute_start = start, length = length, bytes = supplied}
            let tensor_view.TensorView v ← tensor_view.links(m, p)
            return (((((storage.identity(v.encoded.representation) + "/") + (v.encoded.payload.length() ↦ string)) + "/") + (v.encoded.block.byte_length ↦ string)) + "/") + (v.encoded.block.elements_per_block ↦ string)
        }
        catch err {
            return "ERR:§"(err.message)
        }
    }
    catch err {
        return "ERR:§"(err.message)
    }
}

# Deterministic zero-filled payload source. Zero blocks decode to valid
# zero-valued f32 elements for every admitted codec (never a NaN), so a
# positive window materializes and only its element count is observable.
fn source_zero(int start, int length) → list<b8> ⇥ gguf_manifest.GgufManifestError {
    mut list<b8> out ← ||
    for range 0‥length let i {
        out.append(0x00 ∷ b8)
    }
    return out
}

# Source whose first block carries a NaN half (0x7E00) -> dequant BadPayload.
fn source_nan(int start, int length) → list<b8> ⇥ gguf_manifest.GgufManifestError {
    mut list<b8> out ← ||
    out.append(0x00 ∷ b8)
    out.append(0x7e ∷ b8)
    for range 2‥length let i {
        out.append(0x00 ∷ b8)
    }
    return out
}

# BF16 payload source (bf16-U6): deterministic bf16 blocks over the
# qwen35moe corpus's absolute window (224..232). Block values (LE u16):
# 0x3f80 = 1.0, 0x4000 = 2.0, 0xbf80 = -1.0, 0x0000 = 0.0 — real
# language-visible f32 values through the decode, not zero padding.
fn source_bf16(int start, int length) → list<b8> ⇥ gguf_manifest.GgufManifestError {
    let list<int> row ← [128, 63, 0, 64, 128, 191, 0, 0]
    let int cell ← (start - 224) % 8
    mut list<b8> out ← ||
    for range 0‥length let i {
        # Why: every `row` entry is < 256, so the `⊥ 0` default never applies;
        # it handles the failable `↦` inside a `⇥ GgufManifestError` function.
        out.append(((row.get(cell + i) coalesce 0) ↦ u8 ⊥ 0) ↦ b8)
    }
    return out
}

# Source whose first block carries a NaN bf16 (0x7FC1) -> dequant BadPayload.
fn source_nan_bf16(int start, int length) → list<b8> ⇥ gguf_manifest.GgufManifestError {
    mut list<b8> out ← ||
    if start ≡ 224 {
        out.append(0xc1 ∷ b8)
        out.append(0x7f ∷ b8)
        for range 2‥length let i {
            out.append(0x00 ∷ b8)
        }
        return out
    }
    for range 0‥length let i {
        out.append(0x00 ∷ b8)
    }
    return out
}

# Failing source: the read never succeeds.
fn source_failed(int start, int length) → list<b8> ⇥ gguf_manifest.GgufManifestError {
    throw variant BadSource {message = "synthetic read failed"}
}

# Render one windowed materialization as "ok:<element count>" or the typed
# ViewError render.
fn slice(gguf_manifest.GgufCorpus corpus, string name, int start, int length, int element_start, int element_length, (int, int) → list<b8> ⇥ gguf_manifest.GgufManifestError source) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            let tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {name = name, absolute_start = start, length = length, bytes = ||}
            let tensor_view.TensorView v ← tensor_view.links(m, p)
            let list<f32> out ← tensor_view.materialize_slice(v, element_start, element_length, source)
            return "ok:§"(out.length() ↦ string)
        }
        catch err {
            return "ERR:§"(err.message)
        }
    }
    catch err {
        return "ERR:§"(err.message)
    }
}

test "positive bind carries the manifest-derived view facts" {
    assert view(corpus_llama(), "token_embd.weight", 160, 128) ≡ "token_embd.weight/0/32/160/128"
    assert view(corpus_llama(), "blk.0.attn_norm.weight", 320, 16) ≡ "blk.0.attn_norm.weight/1/8/320/16"
    assert view(corpus_qwen35moe(), "blk.0.attn_norm.weight", 224, 8) ≡ "blk.0.attn_norm.weight/30/4/224/8"
}

test "unknown name fails closed as UnknownName" {
    assert view(corpus_llama(), "no.such.tensor", 160, 128) ≡ "ERR:tensor not found: no.such.tensor"
}

test "absolute-range mismatch fails closed as BadRange" {
    assert view(corpus_llama(), "token_embd.weight", 161, 128) ≡ "ERR:payload start does not match the manifest tensor range"
}

test "stored-length mismatch fails closed as BadLength" {
    assert view(corpus_llama(), "token_embd.weight", 160, 127) ≡ "ERR:payload length does not match the stored layout length"
}

test "unknown representation binds with opaque range metadata" {
    assert view(corpus_qwen35moe(), "blk.0.experts.0.weight", 160, 19) ≡ "blk.0.experts.0.weight/999/24/160/19"
    assert encoded_view(corpus_qwen35moe(), "blk.0.experts.0.weight", 160, 19) ≡ "ggml/unspecified/unknown/999/3/19/0"
}

test "unsupported decoder representation binds and fails at materialization" {
    assert view(corpus_q4_0(), "blk.0.attn_norm.weight", 96, 18) ≡ "blk.0.attn_norm.weight/2/32/96/18"
}

# Render one single-block materialization as "ok:<element count>" or the
# typed ViewError render.
fn block(gguf_manifest.GgufCorpus corpus, string name, int start, int length, int block_index, (int, int) → list<b8> ⇥ gguf_manifest.GgufManifestError source) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            let tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {name = name, absolute_start = start, length = length, bytes = ||}
            let tensor_view.TensorView v ← tensor_view.links(m, p)
            let list<f32> out ← tensor_view.materialize_block(v, block_index, source)
            return "ok:§"(out.length() ↦ string)
        }
        catch err {
            return "ERR:§"(err.message)
        }
    }
    catch err {
        return "ERR:§"(err.message)
    }
}

test "positive window reads whole blocks in GGUF block order" {
    assert slice(corpus_q8(), "token_embd.weight", 96, 68, 0, 32, source_zero) ≡ "ok:32"
    assert slice(corpus_q8(), "token_embd.weight", 96, 68, 32, 32, source_zero) ≡ "ok:32"
    assert slice(corpus_q8(), "token_embd.weight", 96, 68, 0, 64, source_zero) ≡ "ok:64"
}

test "window bounds failure fails closed as BadBounds" {
    assert slice(corpus_q8(), "token_embd.weight", 96, 68, 0, 65, source_zero) ≡ "ERR:element window exceeds the tensor"
    assert slice(corpus_q8(), "token_embd.weight", 96, 68, 64, 32, source_zero) ≡ "ERR:element window exceeds the tensor"
    assert slice(corpus_q8(), "token_embd.weight", 96, 68, 0, -1, source_zero) ≡ "ERR:element window is negative"
}

test "block-misaligned window fails closed as BadOrder" {
    assert slice(corpus_q8(), "token_embd.weight", 96, 68, 1, 31, source_zero) ≡ "ERR:element window is not aligned to the tensor block boundary"
    assert slice(corpus_q8(), "token_embd.weight", 96, 68, 0, 33, source_zero) ≡ "ERR:element window is not aligned to the tensor block boundary"
}

test "over-cap window fails closed as BadBounds" {
    assert tensor_view.MAXIMUM_SLICE_ELEMENTS ≡ 16777216
    assert slice(corpus_q8(), "token_embd.weight", 96, 68, 0, 16777217, source_zero) ≡ "ERR:element window exceeds the bounded slice cap"
}

test "source failure fails closed as BadRange" {
    assert slice(corpus_q8(), "token_embd.weight", 96, 68, 0, 32, source_failed) ≡ "ERR:payload range source failed: synthetic read failed"
}

test "malformed block bytes fail closed as BadRange" {
    assert slice(corpus_q8(), "token_embd.weight", 96, 68, 0, 32, source_nan) ≡ "ERR:block value decode failed: NaN half in dequant block"
}

test "first-block probe decodes one block in GGUF block order" {
    assert block(corpus_q8(), "token_embd.weight", 96, 68, 0, source_zero) ≡ "ok:32"
    assert block(corpus_q8(), "token_embd.weight", 96, 68, 1, source_zero) ≡ "ok:32"
}

# First f32 element of a successful single-block BF16 materialization of
# the qwen35moe corpus's BF16 tensor (0.0 on error) — the language-visible
# value at the end of the bf16-U6 chain (tag 30 -> payload -> decode).
fn bf16_block_value(int block_index, (int, int) → list<b8> ⇥ gguf_manifest.GgufManifestError source) → f32 {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus_qwen35moe())
        do {
            let tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {name = "blk.0.attn_norm.weight", absolute_start = 224, length = 8, bytes = ||}
            let tensor_view.TensorView v ← tensor_view.links(m, p)
            let list<f32> out ← tensor_view.materialize_block(v, block_index, source)
            return out.get(0) coalesce 0.0 ∷ f32
        }
        catch err {
            return 0.0 ∷ f32
        }
    }
    catch err {
        return 0.0 ∷ f32
    }
}

test "BF16 tensor flows end-to-end to language-visible values" {
    # bf16-U6: dtype tag 30 -> bounded payload bind -> decode -> f32 value,
    # one block at a time, in GGUF block order.
    assert view(corpus_qwen35moe(), "blk.0.attn_norm.weight", 224, 8) ≡ "blk.0.attn_norm.weight/30/4/224/8"
    assert bf16_block_value(0, source_bf16) ≡ 1.0 ∷ f32
    assert bf16_block_value(1, source_bf16) ≡ 2.0 ∷ f32
    assert bf16_block_value(2, source_bf16) ≡ -1.0 ∷ f32
    assert bf16_block_value(3, source_bf16) ≡ 0.0 ∷ f32
}

test "NaN bf16 payload fails closed end-to-end" {
    assert block(corpus_qwen35moe(), "blk.0.attn_norm.weight", 224, 8, 0, source_nan_bf16) ≡ "ERR:block value decode failed: NaN bf16 value in dequant block"
}

test "out-of-range block index fails closed as BadBounds" {
    assert block(corpus_q8(), "token_embd.weight", 96, 68, 2, source_zero) ≡ "ERR:block index exceeds the tensor block count"
    assert block(corpus_q8(), "token_embd.weight", 96, 68, -1, source_zero) ≡ "ERR:block index is negative"
}

test "source failure fails closed as BadRange" {
    assert block(corpus_q8(), "token_embd.weight", 96, 68, 0, source_failed) ≡ "ERR:payload range source failed: synthetic read failed"
}

test "malformed block bytes fail closed as BadRange" {
    assert block(corpus_q8(), "token_embd.weight", 96, 68, 0, source_nan) ≡ "ERR:block value decode failed: NaN half in dequant block"
}

test "unsupported representation fails only at explicit F32 decode" {
    assert block(corpus_q4_0(), "blk.0.attn_norm.weight", 96, 18, 0, source_zero) ≡ "ERR:unsupported GGML representation: ggml/unspecified/q4_0/2"
}

test "unknown block geometry remains preserved but cannot materialize" {
    assert block(corpus_qwen35moe(), "blk.0.experts.0.weight", 160, 19, 0, source_zero) ≡ "ERR:tensor layout is unknown; payload range is unavailable"
}
