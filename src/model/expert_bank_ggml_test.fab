+++ toml
locale = "en"

+++ faber test
# Co-located CPU execution test for ExpertBank 3D GGML routed kernels.
# Split from expert_bank.fab so the GGML f16-bitcast kernels run on CPU
# without inheriting the unrelated dense/group-affine block in expert_bank.fab.

import from "gradus:model/expert_bank" let eb

fn close(f32 a, f32 b) → bool {
    let f32 diff ← (a - b).abs()
    let f32 tol ← (1.0e-4 ∷ f32) + (1.0e-3 ∷ f32) * b.abs()
    return diff ≤ tol
}

test "expert_bank GGML 3D routed matvec and matmul execute on CPU with f16 scales and Inf/NaN" {
    do {
        mut tensor<f32, [32]> tx32 ← tf32[32] {}
        mut tensor<f32, [1, 32]> txm32 ← tf32[1, 32] {}
        for exclusive 32 let k {
            tx32[[k]] ← 1.0 ∷ f32
            txm32[[0, k]] ← 1.0 ∷ f32
        }
        mut tensor<i32, [1]> idx_e1 ← ti32[1] {}
        idx_e1[[0]] ← 1 ∷ i32
        mut tensor<f32, [1]> ty1 ← tf32[1] {}
        mut tensor<f32, [1, 1]> tym ← tf32[1, 1] {}

        let eb.BankedMatrixSpec sp_q8 ← eb.BankedMatrixSpec { kind = variant eb.ExpertWeightKind.GgmlBlockQ8_0, expert_count = 2, out_features = 1, in_features = 32, bits = 0, group_size = 0, packed_cols = 0, group_cols = 0 }
        mut tensor<u8, [2, 1, 34]> tg_q8 ← tu8[2, 1, 34] {}
        tg_q8[[1, 0, 0]] ← 0x00 ∷ u8
        tg_q8[[1, 0, 1]] ← 0x38 ∷ u8
        for exclusive 32 let k { tg_q8[[1, 0, 2 + k]] ← 1 ∷ u8 }
        eb.dispatch_routed_matvec_ggml_q8_0<size 2, size 1, size 1, size 34, size 32>(sp_q8, tg_q8, tx32, mut ty1, 1)
        eb.dispatch_routed_matmul_ggml_q8_0<size 1, size 2, size 1, size 1, size 34, size 32>(sp_q8, tg_q8, txm32, idx_e1, mut tym)
        assert close(ty1[[0]], 16.0 ∷ f32)
        assert close(tym[[0, 0]], 16.0 ∷ f32)

        # f16 +Inf / -Inf / NaN scales on Q8_0
        tg_q8[[1, 0, 0]] ← 0x00 ∷ u8
        tg_q8[[1, 0, 1]] ← 0x7c ∷ u8
        eb.dispatch_routed_matvec_ggml_q8_0<size 2, size 1, size 1, size 34, size 32>(sp_q8, tg_q8, tx32, mut ty1, 1)
        assert ty1[[0]] ≻ (1.0e30 ∷ f32) and ty1[[0]] ≡ ty1[[0]] and ty1[[0]] * (0.5 ∷ f32) ≡ ty1[[0]]

        tg_q8[[1, 0, 1]] ← 0xfc ∷ u8
        eb.dispatch_routed_matmul_ggml_q8_0<size 1, size 2, size 1, size 1, size 34, size 32>(sp_q8, tg_q8, txm32, idx_e1, mut tym)
        assert tym[[0, 0]] ≺ (-1.0e30 ∷ f32) and tym[[0, 0]] ≡ tym[[0, 0]] and tym[[0, 0]] * (0.5 ∷ f32) ≡ tym[[0, 0]]

        tg_q8[[1, 0, 0]] ← 0x01 ∷ u8
        tg_q8[[1, 0, 1]] ← 0x7c ∷ u8
        eb.dispatch_routed_matvec_ggml_q8_0<size 2, size 1, size 1, size 34, size 32>(sp_q8, tg_q8, tx32, mut ty1, 1)
        assert ty1[[0]] ≢ ty1[[0]]

        let eb.BankedMatrixSpec sp_q41 ← eb.BankedMatrixSpec { kind = variant eb.ExpertWeightKind.GgmlBlockQ4_1, expert_count = 2, out_features = 1, in_features = 32, bits = 0, group_size = 0, packed_cols = 0, group_cols = 0 }
        mut tensor<u8, [2, 1, 20]> tg_q41 ← tu8[2, 1, 20] {}
        tg_q41[[1, 0, 0]] ← 0x00 ∷ u8
        tg_q41[[1, 0, 1]] ← 0x38 ∷ u8
        for exclusive 16 let k { tg_q41[[1, 0, 4 + k]] ← 0x11 ∷ u8 }
        eb.dispatch_routed_matvec_ggml_q4_1<size 2, size 1, size 1, size 20, size 32>(sp_q41, tg_q41, tx32, mut ty1, 1)
        eb.dispatch_routed_matmul_ggml_q4_1<size 1, size 2, size 1, size 1, size 20, size 32>(sp_q41, tg_q41, txm32, idx_e1, mut tym)
        assert close(ty1[[0]], 16.0 ∷ f32)
        assert close(tym[[0, 0]], 16.0 ∷ f32)

        let eb.BankedMatrixSpec sp_q50 ← eb.BankedMatrixSpec { kind = variant eb.ExpertWeightKind.GgmlBlockQ5_0, expert_count = 2, out_features = 1, in_features = 32, bits = 0, group_size = 0, packed_cols = 0, group_cols = 0 }
        mut tensor<u8, [2, 1, 22]> tg_q50 ← tu8[2, 1, 22] {}
        tg_q50[[1, 0, 0]] ← 0x00 ∷ u8
        tg_q50[[1, 0, 1]] ← 0x38 ∷ u8
        for exclusive 4 let h { tg_q50[[1, 0, 2 + h]] ← 0xff ∷ u8 }
        for exclusive 16 let k { tg_q50[[1, 0, 6 + k]] ← 0x11 ∷ u8 }
        eb.dispatch_routed_matvec_ggml_q5_0<size 2, size 1, size 1, size 22, size 32>(sp_q50, tg_q50, tx32, mut ty1, 1)
        eb.dispatch_routed_matmul_ggml_q5_0<size 1, size 2, size 1, size 1, size 22, size 32>(sp_q50, tg_q50, txm32, idx_e1, mut tym)
        assert close(ty1[[0]], 16.0 ∷ f32)
        assert close(tym[[0, 0]], 16.0 ∷ f32)

        let eb.BankedMatrixSpec sp_iq4 ← eb.BankedMatrixSpec { kind = variant eb.ExpertWeightKind.GgmlBlockIQ4_NL, expert_count = 2, out_features = 1, in_features = 32, bits = 0, group_size = 0, packed_cols = 0, group_cols = 0 }
        mut tensor<u8, [2, 1, 18]> tg_iq4 ← tu8[2, 1, 18] {}
        tg_iq4[[1, 0, 0]] ← 0x00 ∷ u8
        tg_iq4[[1, 0, 1]] ← 0x3c ∷ u8
        for exclusive 16 let k { tg_iq4[[1, 0, 2 + k]] ← 0x88 ∷ u8 }
        eb.dispatch_routed_matvec_ggml_iq4_nl<size 2, size 1, size 1, size 18, size 32>(sp_iq4, tg_iq4, tx32, mut ty1, 1)
        eb.dispatch_routed_matmul_ggml_iq4_nl<size 1, size 2, size 1, size 1, size 18, size 32>(sp_iq4, tg_iq4, txm32, idx_e1, mut tym)
        assert close(ty1[[0]], 32.0 ∷ f32)
        assert close(tym[[0, 0]], 32.0 ∷ f32)

        mut tensor<f32, [256]> tx256 ← tf32[256] {}
        mut tensor<f32, [1, 256]> txm256 ← tf32[1, 256] {}
        for exclusive 256 let k {
            tx256[[k]] ← 1.0 ∷ f32
            txm256[[0, k]] ← 1.0 ∷ f32
        }

        let eb.BankedMatrixSpec sp_q4k ← eb.BankedMatrixSpec { kind = variant eb.ExpertWeightKind.GgmlBlockQ4_K, expert_count = 2, out_features = 1, in_features = 256, bits = 0, group_size = 0, packed_cols = 0, group_cols = 0 }
        mut tensor<u8, [2, 1, 144]> tg_q4k ← tu8[2, 1, 144] {}
        tg_q4k[[1, 0, 0]] ← 0x00 ∷ u8
        tg_q4k[[1, 0, 1]] ← 0x3c ∷ u8
        for exclusive 12 let s { tg_q4k[[1, 0, 4 + s]] ← 0x11 ∷ u8 }
        for exclusive 128 let q { tg_q4k[[1, 0, 16 + q]] ← 0x11 ∷ u8 }
        eb.dispatch_routed_matvec_ggml_q4_k<size 2, size 1, size 144, size 256>(sp_q4k, tg_q4k, tx256, mut ty1, 1)
        eb.dispatch_routed_matmul_ggml_q4_k<size 1, size 2, size 1, size 1, size 144, size 256>(sp_q4k, tg_q4k, txm256, idx_e1, mut tym)
        assert close(ty1[[0]], tym[[0, 0]]) and ty1[[0]] ≻ (0.0 ∷ f32)

        let eb.BankedMatrixSpec sp_q5k ← eb.BankedMatrixSpec { kind = variant eb.ExpertWeightKind.GgmlBlockQ5_K, expert_count = 2, out_features = 1, in_features = 256, bits = 0, group_size = 0, packed_cols = 0, group_cols = 0 }
        mut tensor<u8, [2, 1, 176]> tg_q5k ← tu8[2, 1, 176] {}
        tg_q5k[[1, 0, 0]] ← 0x00 ∷ u8
        tg_q5k[[1, 0, 1]] ← 0x3c ∷ u8
        for exclusive 12 let s { tg_q5k[[1, 0, 4 + s]] ← 0x11 ∷ u8 }
        for exclusive 128 let q { tg_q5k[[1, 0, 48 + q]] ← 0x11 ∷ u8 }
        eb.dispatch_routed_matvec_ggml_q5_k<size 2, size 1, size 1, size 176, size 256>(sp_q5k, tg_q5k, tx256, mut ty1, 1)
        eb.dispatch_routed_matmul_ggml_q5_k<size 1, size 2, size 1, size 1, size 176, size 256>(sp_q5k, tg_q5k, txm256, idx_e1, mut tym)
        assert close(ty1[[0]], tym[[0, 0]]) and ty1[[0]] ≻ (0.0 ∷ f32)

        let eb.BankedMatrixSpec sp_q6k ← eb.BankedMatrixSpec { kind = variant eb.ExpertWeightKind.GgmlBlockQ6_K, expert_count = 2, out_features = 1, in_features = 256, bits = 0, group_size = 0, packed_cols = 0, group_cols = 0 }
        mut tensor<u8, [2, 1, 210]> tg_q6k ← tu8[2, 1, 210] {}
        tg_q6k[[1, 0, 208]] ← 0x00 ∷ u8
        tg_q6k[[1, 0, 209]] ← 0x3c ∷ u8
        for exclusive 128 let q { tg_q6k[[1, 0, q]] ← 0x11 ∷ u8 }
        for exclusive 64 let h { tg_q6k[[1, 0, 128 + h]] ← 0xff ∷ u8 }
        for exclusive 16 let s { tg_q6k[[1, 0, 192 + s]] ← 1 ∷ u8 }
        eb.dispatch_routed_matvec_ggml_q6_k<size 2, size 1, size 1, size 210, size 256>(sp_q6k, tg_q6k, tx256, mut ty1, 1)
        eb.dispatch_routed_matmul_ggml_q6_k<size 1, size 2, size 1, size 1, size 210, size 256>(sp_q6k, tg_q6k, txm256, idx_e1, mut tym)
        assert close(ty1[[0]], 4352.0 ∷ f32)
        assert close(tym[[0, 0]], 4352.0 ∷ f32)
    }
    catch err {
        assert false
    }
}
