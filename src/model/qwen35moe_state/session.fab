+++ toml
locale = "en"

+++ faber
# Hybrid session state — conv, recurrent, KV, reset, identity.
#
# Public import: import from "gradus:model/qwen35moe_state/session" session
# Depends on: gradus:model/qwen35moe_state/schedule, gradus:model/qwen35moe,
#   gradus:cache/session, gradus:cache/hybrid_arenas.

import from "gradus:model/qwen35moe_state/schedule" let schedule
import from "gradus:model/qwen35moe" let qwen35moe
import from "gradus:cache/session" let sess_mod
import from "gradus:cache/hybrid_arenas" let hybrid
import from "gradus:dtype" let dtype

# Whole-trunk hybrid session backed by typed device-ready arenas
# (`SessionState`, `ConvStateArena`, `RecurrentStateArena`, and
# `hybrid.HybridSession`) over `ExecutionSchedule` slots, plus the
# generation counter and identity key.
@ public
class HybridSession<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols> {
    mut schedule.Qwen35moeSchedule schedule
    mut hybrid.HybridSession<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols> arenas
    mut int generation
    mut string model
    mut string model_version
    mut string execution_config
    mut string tokenizer
    mut string state_types
    mut string dtype
}

const string IDENTITY_SCHEMA = "1.0.0"

# Decimal digit parse for the identity wire (for-from characters).
fn digit_value(char c) → int {
    switch c {
        case '0' { return 0 }
        case '1' { return 1 }
        case '2' { return 2 }
        case '3' { return 3 }
        case '4' { return 4 }
        case '5' { return 5 }
        case '6' { return 6 }
        case '7' { return 7 }
        case '8' { return 8 }
        case '9' { return 9 }
        default { return -1 }
    }
}

fn int_list_text(list<int> xs) → string {
    if xs.length() ≡ 0 then return "-"
    mut string out ← ""
    for exclusive xs.length() let i {
        if i ≻ 0 {
            out ← out + ","
        }
        out ← out + (xs[i] ↦ string)
    }
    return out
}

fn parse_nonneg_int_text(string s, string message) → int ⇥ schedule.Qwen35moeStateError {
    require s.length() ≥ 1 and s.length() ≤ 18 throw variant BadState {message = message}
    mut int value ← 0
    for from s let c {
        let int digit ← digit_value(c)
        require digit ≥ 0 throw variant BadState {message = message}
        value ← value * 10 + digit
    }
    return value
}

fn parse_rope_sections_wire(string exec_cfg) → list<int> ⇥ schedule.Qwen35moeStateError {
    let list<string> fields ← exec_cfg.split(":")
    for from fields let field {
        if field.starts_with("sections=") {
            let string raw ← field.slice(9, field.length())
            require raw.length() ≥ 1 and raw ≢ "-" throw variant BadState {message = "missing rope_sections in identity wire"}
            let list<string> items ← raw.split(",")
            mut list<int> out ← empty
            for from items let item {
                out.append(parse_nonneg_int_text(item, "malformed rope_sections in identity wire"))
            }
            require out.length() ≥ 1 throw variant BadState {message = "missing rope_sections in identity wire"}
            return out
        }
    }
    throw variant BadState {message = "missing rope_sections in identity wire"}
}

fn parse_conv_history_wire(string state_types, string exec_cfg, int conv_rows) → int ⇥ schedule.Qwen35moeStateError {
    mut int history_len ← -1
    let list<string> families ← state_types.split(";")
    for from families let entry {
        if entry.starts_with("conv=") {
            let string spec ← entry.slice(5, entry.length())
            let list<string> dims ← spec.split("x")
            require dims.length() ≡ 2 throw variant BadState {message = "malformed conv state_types in identity wire"}
            history_len ← parse_nonneg_int_text(dims.get(0) coalesce "", "malformed conv history length in identity wire")
        }
    }
    require history_len ≥ 1 throw variant BadState {message = "missing conv history length in identity wire"}
    let list<string> fields ← exec_cfg.split(":")
    for from fields let field {
        if field.starts_with("conv=") {
            let int conv_kernel ← parse_nonneg_int_text(field.slice(5, field.length()), "malformed conv kernel in identity wire")
            require conv_kernel ≥ 2 and conv_kernel - 1 ≡ history_len throw variant BadState {message = "inconsistent conv history length in identity wire"}
        }
    }
    require history_len ≤ conv_rows throw variant BadState {message = "conv history length exceeds ConvRows capacity"}
    return history_len
}

fn execution_config(qwen35moe.Qwen35moeConfig c) → string {
    # "/" and ";" never appear in these rendered fields.
    return "embd=§:heads=§:kv=§:key=§:conv=§:state=§:group=§:dt=§:inner=§:interval=§:rope=§:base=§:sections=§"(c.embedding_length ↦ string, c.head_count ↦ string, c.head_count_kv ↦ string, c.key_length ↦ string, c.conv_kernel ↦ string, c.state_size ↦ string, c.group_count ↦ string, c.gradus_temporis ↦ string, c.inner_size ↦ string, c.full_attention_interval ↦ string, c.rope_dimension_count ↦ string, (c.freq_base ↦ string), int_list_text(c.rope_sections))
}

fn schedule_wire(schedule.Qwen35moeSchedule s) → string {
    mut string out ← ""
    for from s.kinds let kind {
        out ← out + (kind ↦ string)
    }
    return out
}

fn tensor_active_rows_equal<size R, size C>(tensor<f32, [R, C]> a, tensor<f32, [R, C]> b, int rows) → bool {
    if rows ≺ 0 or rows ≻ R then return false
    for exclusive rows let r {
        for exclusive C let c {
            if a[[r, c]] ≢ b[[r, c]] then return false
        }
    }
    return true
}

fn ring_active_rows_equal<size W, size KVD>(tensor<f32, [W, KVD]> a, tensor<f32, [W, KVD]> b, int total_written, int win) → bool {
    if total_written ≺ 0 or win ≺ 1 or win ≻ W then return false
    if total_written ≡ 0 then return true
    mut int start ← total_written - win
    if start ≺ 0 {
        start ← 0
    }
    for range start ‥ total_written let p {
        let int slot ← p % win
        for exclusive KVD let c {
            if a[[slot, c]] ≢ b[[slot, c]] then return false
        }
    }
    return true
}

@ public
fn conv_arena_equal<size ConvRows, size ConvCh>(hybrid.ConvStateArena<size ConvRows, size ConvCh> a, hybrid.ConvStateArena<size ConvRows, size ConvCh> b) → bool {
    if a.sites_per_slot ≢ b.sites_per_slot then return false
    if a.history_len ≢ b.history_len then return false
    if a.channels ≢ b.channels then return false
    if a.site_base ≢ b.site_base then return false
    if a.txn_depth ≢ b.txn_depth then return false
    if a.slot_ids ≢ b.slot_ids then return false
    if a.steps_written ≢ b.steps_written then return false
    if a.buffers.length() ≢ b.buffers.length() then return false
    let int active_rows ← a.sites_per_slot * a.history_len
    for exclusive a.buffers.length() let i {
        if not tensor_active_rows_equal<size ConvRows, size ConvCh>(a.buffers[i], b.buffers[i], active_rows) then return false
    }
    return true
}

@ public
fn recurrent_arena_equal<size RecRows, size RecCols>(hybrid.RecurrentStateArena<size RecRows, size RecCols> a, hybrid.RecurrentStateArena<size RecRows, size RecCols> b) → bool {
    if a.rows ≢ b.rows then return false
    if a.cols ≢ b.cols then return false
    if a.txn_depth ≢ b.txn_depth then return false
    if a.slot_ids ≢ b.slot_ids then return false
    if a.steps_written ≢ b.steps_written then return false
    if a.states.length() ≢ b.states.length() then return false
    for exclusive a.states.length() let i {
        if not tensor_active_rows_equal<size RecRows, size RecCols>(a.states[i], b.states[i], RecRows) then return false
    }
    return true
}

@ public
fn session_kv_equal<size C, size W, size KVD>(sess_mod.SessionState<size C, size W, size KVD> a, sess_mod.SessionState<size C, size W, size KVD> b) → bool {
    if a.txn_depth ≢ b.txn_depth then return false
    if a.slot_arena_kind ≢ b.slot_arena_kind then return false
    if a.slot_local_index ≢ b.slot_local_index then return false
    if a.slot_window_sizes ≢ b.slot_window_sizes then return false
    if a.slot_kv_quant.length() ≢ b.slot_kv_quant.length() then return false
    for exclusive a.slot_kv_quant.length() let i {
        let sess_mod.KvQuantConfig qa ← a.slot_kv_quant[i]
        let sess_mod.KvQuantConfig qb ← b.slot_kv_quant[i]
        if qa.key_bits ≢ qb.key_bits or qa.value_bits ≢ qb.value_bits or qa.group_size ≢ qb.group_size or qa.enabled ≢ qb.enabled then return false
    }
    if a.full_kv.capacity ≢ b.full_kv.capacity or a.full_kv.kv_dim ≢ b.full_kv.kv_dim then return false
    if a.full_kv.slot_ids ≢ b.full_kv.slot_ids or a.full_kv.lengths ≢ b.full_kv.lengths then return false
    if a.full_kv.keys.length() ≢ b.full_kv.keys.length() or a.full_kv.values.length() ≢ b.full_kv.values.length() then return false
    if a.full_kv.lengths.length() ≢ a.full_kv.keys.length() then return false
    for exclusive a.full_kv.keys.length() let i {
        let int active ← a.full_kv.lengths[i]
        if not tensor_active_rows_equal<size C, size KVD>(a.full_kv.keys[i], b.full_kv.keys[i], active) then return false
        if not tensor_active_rows_equal<size C, size KVD>(a.full_kv.values[i], b.full_kv.values[i], active) then return false
    }
    if a.ring_kv.max_window ≢ b.ring_kv.max_window or a.ring_kv.kv_dim ≢ b.ring_kv.kv_dim then return false
    if a.ring_kv.slot_ids ≢ b.ring_kv.slot_ids or a.ring_kv.window_sizes ≢ b.ring_kv.window_sizes or a.ring_kv.total_written ≢ b.ring_kv.total_written then return false
    if a.ring_kv.keys.length() ≢ b.ring_kv.keys.length() or a.ring_kv.values.length() ≢ b.ring_kv.values.length() then return false
    if a.ring_kv.total_written.length() ≢ a.ring_kv.keys.length() or a.ring_kv.window_sizes.length() ≢ a.ring_kv.keys.length() then return false
    for exclusive a.ring_kv.keys.length() let i {
        let int tw ← a.ring_kv.total_written[i]
        let int win ← a.ring_kv.window_sizes[i]
        if not ring_active_rows_equal<size W, size KVD>(a.ring_kv.keys[i], b.ring_kv.keys[i], tw, win) then return false
        if not ring_active_rows_equal<size W, size KVD>(a.ring_kv.values[i], b.ring_kv.values[i], tw, win) then return false
    }
    return true
}

@ public
fn fresh_session<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols>(qwen35moe.Qwen35moeConfig c) → HybridSession<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols> ⇥ schedule.Qwen35moeStateError {
    require c.conv_kernel ≥ 2 throw variant schedule.Qwen35moeStateError.BadConfig {message = "conv kernel must leave a state slice"}
    let schedule.Qwen35moeSchedule s ← schedule.schedule(c)
    let _ exec_sched ← schedule.to_execution_schedule(s, c.rope_sections)
    do {
        let hybrid.HybridSession<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols> arenas ← hybrid.from_schedule<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols>(exec_sched, 1, c.conv_kernel - 1, false)
        return HybridSession {schedule = s, arenas = arenas, generation = 0, model = c.architecture, model_version = "file-type-§"(c.file_type ↦ string), execution_config = execution_config(c), tokenizer = "§:pre=§:tokens=§"(c.tokenizer_model, c.tokenizer_pre, c.token_count ↦ string), state_types = "conv=§x§;recurrent=§x§x§;kv=§x§"(c.conv_kernel - 1 ↦ string, (c.inner_size + 2 * c.group_count * c.state_size) ↦ string, c.gradus_temporis ↦ string, c.state_size ↦ string, c.state_size ↦ string, c.head_count_kv ↦ string, c.key_length ↦ string), dtype = "f32"}
    }
    catch err {
        throw variant schedule.Qwen35moeStateError.BadState {message = err.message}
    }
}

# Reset: fresh-arena construction — zeroed conv state, zeroed recurrent
# state, zeroed KV arenas, generation counter restart — with the same identity.
@ public
fn reset_session<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols>(HybridSession<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols> s) → HybridSession<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols> ⇥ schedule.Qwen35moeStateError {
    do {
        let hybrid.HybridSession<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols> fresh_arenas ← hybrid.from_schedule<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols>(s.arenas.kv.sched, s.arenas.conv.sites_per_slot, s.arenas.conv.history_len, false)
        return HybridSession {schedule = s.schedule, arenas = fresh_arenas, generation = 0, model = s.model, model_version = s.model_version, execution_config = s.execution_config, tokenizer = s.tokenizer, state_types = s.state_types, dtype = s.dtype}
    }
    catch err {
        throw variant schedule.Qwen35moeStateError.BadState {message = err.message}
    }
}

# State equality across the whole trunk (identity fields are equal by the
# wire comparison; this compares the typed arena state families and generation).
@ public
fn session_state_equal<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols>(HybridSession<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols> a, HybridSession<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols> b) → bool {
    if a.generation ≢ b.generation then return false
    if not conv_arena_equal<size ConvRows, size ConvCh>(a.arenas.conv, b.arenas.conv) then return false
    if not recurrent_arena_equal<size RecRows, size RecCols>(a.arenas.recurrent, b.arenas.recurrent) then return false
    return session_kv_equal<size C, size W, size KVD>(a.arenas.kv, b.arenas.kv)
}

# The identity key wire: schema / model / version / execution config /
# tokenizer / schedule / per-layer state types / dtype, mirroring the
# `gradus:cache` identity-key precedent so EXEC-03 can bind two prompts to
# one resident session without reload.
@ public
fn session_identity_key<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols>(HybridSession<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols> s) → string {
    return "qwen35moe-state/identity/§/§/§/§/§/§/§/§/§"(IDENTITY_SCHEMA, s.model, s.model_version, s.execution_config, s.tokenizer, schedule_wire(s.schedule), s.state_types, s.dtype, s.generation ↦ string)
}

# Parse an identity wire back into a session-shaped record with fresh
# empty placeholder arenas sized from the wire's `state_types` conv history
# length and `execution_config` `rope_sections`. Identity wires carry no
# tensor payloads; callers needing full arena payload round-trips should use
# `gradus:prepared_state` wire v2 (`serialize_hybrid_session` /
# `deserialize_hybrid_session`). Round-trips through session_identity_key.
@ public
fn deserialize_session_identity<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols>(string wire) → HybridSession<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols> ⇥ schedule.Qwen35moeStateError {
    let list<string> parts ← wire.split("/")
    require parts.length() ≡ 11 throw variant BadState {message = "malformed qwen35moe state identity wire"}
    require (parts.get(0) coalesce "") ≡ "qwen35moe-state" throw variant BadState {message = "unknown identity marker"}
    require (parts.get(1) coalesce "") ≡ "identity" throw variant BadState {message = "unknown identity marker"}
    require (parts.get(2) coalesce "") ≡ IDENTITY_SCHEMA throw variant BadState {message = "unknown identity schema"}
    let string model ← parts.get(3) coalesce ""
    let string model_version ← parts.get(4) coalesce ""
    let string exec_cfg ← parts.get(5) coalesce ""
    let string tokenizer ← parts.get(6) coalesce ""
    let string schedule_wire ← parts.get(7) coalesce ""
    let string state_types ← parts.get(8) coalesce ""
    let string dtype ← parts.get(9) coalesce ""
    require schedule_wire.length() ≥ 1 throw variant BadState {message = "malformed schedule wire"}
    mut list<int> kinds ← empty
    for from schedule_wire let c {
        let int kind ← digit_value(c)
        require kind ≥ 0 and kind ≤ 2 throw variant BadState {message = "malformed schedule wire"}
        kinds.append(kind)
    }
    let int generation ← parse_nonneg_int_text(parts.get(10) coalesce "", "malformed generation wire")
    let list<int> rope_sections ← parse_rope_sections_wire(exec_cfg)
    let int conv_history_len ← parse_conv_history_wire(state_types, exec_cfg, ConvRows)
    mut int linear ← 0
    mut int full ← 0
    mut int nextn ← 0
    mut list<int> linear_slots ← empty
    mut list<int> full_slots ← empty
    for from kinds let kind {
        switch kind {
            case 0 {
                linear_slots.append(linear)
                full_slots.append(-1)
                linear ↑
            }
            case 1 {
                linear_slots.append(-1)
                full_slots.append(full)
                full ↑
            }
            case 2 {
                linear_slots.append(-1)
                full_slots.append(-1)
                nextn ↑
            }
        }
    }
    let schedule.Qwen35moeSchedule s ← schedule.Qwen35moeSchedule {trunk_layers = linear + full, linear_layers = linear, full_layers = full, nextn_layers = nextn, kinds = kinds, linear_slots = linear_slots, full_slots = full_slots}
    let _ exec_sched ← schedule.to_execution_schedule(s, rope_sections)
    do {
        let hybrid.HybridSession<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols> arenas ← hybrid.from_schedule<size C, size W, size KVD, size ConvRows, size ConvCh, size RecRows, size RecCols>(exec_sched, 1, conv_history_len, false)
        return HybridSession {schedule = s, arenas = arenas, generation = generation, model = model, model_version = model_version, execution_config = exec_cfg, tokenizer = tokenizer, state_types = state_types, dtype = dtype}
    }
    catch err {
        throw variant schedule.Qwen35moeStateError.BadState {message = err.message}
    }
}
# -------------------------------------------------------------------------
# Scalar primitives (self-hosted per the nn/moe precedent).
# -------------------------------------------------------------------------

@ public
fn sigmoid(f32 x) → f32 {
    return 1.0 / (1.0 + (-x).exp())
}

@ public
fn silu(f32 x) → f32 {
    return x / (1.0 + (-x).exp())
}

@ public
fn softplus(f32 x) → f32 {
    # The comparator's form: identity above 20, log(1 + exp(x)) below.
    if x ≻ 20.0 then return x
    return (1.0 + x.exp()).ln()
}

# RMSNorm over one row (the comparator accumulates the squared sum in
# double; the reference row accumulates in f32 and the oracle band carries
# the difference).
@ public
fn rms_norm_row(list<f32> x, list<f32> weight, f32 eps) → list<f32> ⇥ schedule.Qwen35moeStateError {
    require x.length() ≡ weight.length() throw variant schedule.Qwen35moeStateError.BadShape {message = "norm row and weight lengths differ"}
    require x.length() ≥ 1 throw variant schedule.Qwen35moeStateError.BadShape {message = "norm row is empty"}
    mut f32 sum ← 0.0
    for from x let v {
        sum ← sum + v * v
    }
    let f32 scale ← 1.0 / (√ (sum / (x.length() ↦ f32) + eps))
    mut list<f32> out ← empty
    for range 0‥x.length() let i {
        out.append((x[i]) * scale * (weight[i]))
    }
    return out
}

# L2 norm over one row (the GDN q/k normalization): x / max(|x|_2, eps).
@ public
fn l2_norm_row(list<f32> x, f32 eps) → list<f32> ⇥ schedule.Qwen35moeStateError {
    mut f32 sum ← 0.0
    for from x let v {
        sum ← sum + v * v
    }
    let f32 norm ← √ sum
    mut f32 scale ← 1.0 / norm
    if norm ≺ eps {
        scale ← 1.0 / eps
    }
    mut list<f32> out ← empty
    for from x let v {
        out.append(v * scale)
    }
    return out
}

# -------------------------------------------------------------------------
# Weight windows. The adapter owns the read and the ".weight"/".bias"
# suffix per canonical name; every window is checked length- and
# finiteness-exact before a compute unit consumes it.
# -------------------------------------------------------------------------

@ public
fn window((string, int, int) → list<f32> ⇥ schedule.Qwen35moeStateError source, string name, int start, int length) → list<f32> ⇥ schedule.Qwen35moeStateError {
    require start ≥ 0 throw variant schedule.Qwen35moeStateError.BadWindow {message = "tensor window start must be non-negative"}
    require length ≥ 1 throw variant schedule.Qwen35moeStateError.BadWindow {message = "tensor window length must be positive"}
    let list<f32> value ← source(name, start, length)
    require value.length() ≡ length throw variant schedule.Qwen35moeStateError.BadWindow {message = "tensor window length does not match the carrier: §"(name)}
    for from value let v {
        require dtype.finite(v) throw variant schedule.Qwen35moeStateError.NonFinite {message = "tensor window contains a non-finite value: §"(name)}
    }
    return value
}

@ public
fn prefix(int layer) → string {
    return "blk.§"(layer ↦ string)
}

# Empty row coalesce target for nested-list reads (structure only).
@ public
fn empty_f32_row() → list<f32> {
    return empty
}

# [out, in] x [in, T] -> [T][out] rows (one projection over a whole window;
# each weight row is read once per layer call).
@ public
fn project_rows(list<f32> weight, list<f32> x_rows, int in_dim, int out_dim, int tokens) → list<f32> ⇥ schedule.Qwen35moeStateError {
    require weight.length() ≡ out_dim * in_dim throw variant schedule.Qwen35moeStateError.BadShape {message = "projection weight window has the wrong length"}
    require x_rows.length() ≡ tokens * in_dim throw variant schedule.Qwen35moeStateError.BadShape {message = "projection input rows have the wrong length"}
    mut list<f32> out ← empty
    for range 0‥tokens let t {
        let int base ← t * in_dim
        for range 0‥out_dim let o {
            mut f32 sum ← 0.0
            for range 0‥in_dim let i {
                sum ← sum + (weight.get(o * in_dim + i) coalesce 0.0) * (x_rows.get(base + i) coalesce 0.0)
            }
            require dtype.finite(sum) throw variant schedule.Qwen35moeStateError.NonFinite {message = "projection produced a non-finite value"}
            out.append(sum)
        }
    }
    return out
}

# -------------------------------------------------------------------------
# S4 — multi-section RoPE (F4).
# -------------------------------------------------------------------------

# The per-position RoPE angle table ([cos, sin] per pair, theta_j = pos *
# base^(-2j/dims)). Computed once per token and shared by every head
# rotation of that token (issue #79: the trig series was recomputed per
# head — 18 times per token per layer — instead of once per position).
@ public
fn rope_table(f32 base, int dims, int pos) → list<f32> ⇥ schedule.Qwen35moeStateError {
    require dims ≥ 2 and dims % 2 ≡ 0 throw variant schedule.Qwen35moeStateError.BadShape {message = "rope dims must be positive and even"}
    mut list<f32> table ← empty
    for range 0‥dims / 2 let j {
        let f32 angle ← (pos ↦ f32) * (base.power((-(2.0 * (j ↦ f32))) / (dims ↦ f32)) ⊥ 0.0)
        table.append(cos angle)
        table.append(sin angle)
    }
    return table
}

# Apply a precomputed angle table to one head row. Pair j (0..pairs-1) is
# (element j, element j + dims/2) — the comparator's half-split layout;
# elements at or beyond dims pass through untouched. Identical math and
# append order to the single-call form below.
@ public
fn rope_head_table(list<f32> head, list<f32> table, int dims, int pass_through) → list<f32> ⇥ schedule.Qwen35moeStateError {
    require head.length() ≥ dims throw variant schedule.Qwen35moeStateError.BadShape {message = "head row is shorter than the rope dims"}
    require pass_through ≡ head.length() throw variant schedule.Qwen35moeStateError.BadShape {message = "pass-through width must be the head width"}
    require table.length() ≡ dims throw variant schedule.Qwen35moeStateError.BadShape {message = "rope table must carry the full pair series"}
    mut list<f32> out ← empty
    let int half ← dims / 2
    for range 0‥pass_through let i {
        if i ≺ half {
            let f32 x0 ← head.get(i) coalesce 0.0
            let f32 x1 ← head.get(i + half) coalesce 0.0
            out.append(x0 * (table.get(i * 2) coalesce 1.0) - x1 * (table.get(i * 2 + 1) coalesce 0.0))
        }
        else {
            if i ≺ dims {
                let int pair ← i - half
                let f32 x0 ← head.get(pair) coalesce 0.0
                let f32 x1 ← head.get(pair + half) coalesce 0.0
                out.append(x0 * (table.get(pair * 2 + 1) coalesce 0.0) + x1 * (table.get(pair * 2) coalesce 1.0))
            }
            else {
                out.append(head.get(i) coalesce 0.0)
            }
        }
    }
    return out
}

# RoPE over one head row. Pair j (0..pairs-1) is (element j, element j +
# dims/2) — the comparator's half-split layout; elements at or beyond dims
# pass through untouched. The angle series is theta_j = pos * base^(-2 *
# j / dims). The four section lengths are carried for the multi-section
# wire: on the qwen35moe text row every section reads the same text
# position, so the per-section theta selection collapses to the shared
# series (the pinned comparator computes the identical value either way).
# Single-call form: builds the angle table, then applies it. Callers
# rotating many heads at one position share rope_table + rope_head_table
# instead.
@ public
fn rope_head(list<f32> head, int dims, int pairs, f32 base, list<int> sections, int pos, int pass_through) → list<f32> ⇥ schedule.Qwen35moeStateError {
    require dims ≡ pairs * 2 throw variant schedule.Qwen35moeStateError.BadShape {message = "rope dims must be twice the pair count"}
    require sections.length() ≥ 4 throw variant schedule.Qwen35moeStateError.BadShape {message = "rope needs four section lengths"}
    let list<f32> table ← rope_table(base, dims, pos)
    return rope_head_table(head, table, dims, pass_through)
}
