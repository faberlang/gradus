+++ toml
locale = "en"

+++ faber
# qwen35moe trunk schedule — linear vs full-attention layer kinds.
#
# Public import: import from "gradus:model/qwen35moe_state/schedule" schedule
# Owns Qwen35moeStateError.
# Depends on: gradus:model/qwen35moe, gradus:model/gguf_manifest.

import from "gradus:model/qwen35moe"

import from "gradus:model/gguf_manifest"

import from "gradus:model/schedule" let model_schedule

@ public
union Qwen35moeStateError {
    @ shared
    string message

    BadConfig,
    BadShape,
    BadWindow,
    BadSchedule,
    BadState,
    NonFinite
}

@ public
fn state_message(Qwen35moeStateError e) → string {
    return e.message
}

# -------------------------------------------------------------------------
# S0 — layer schedule (F1, F7).
# -------------------------------------------------------------------------

@ public
union LayerKind {
    LinearAttention,
    FullAttention,
    Nextn
}

@ public
class Qwen35moeSchedule {
    mut int trunk_layers
    mut int linear_layers
    mut int full_layers
    mut int nextn_layers
    mut list<int> kinds
    # Precomputed slot indices (issue #79): linear_slots[b] is the SSM state
    # slot of block b (-1 outside the family), full_slots[b] the KV state
    # slot. Built once at schedule construction so per-token lookups are a
    # constant-time read, never a scan over kinds.
    mut list<int> linear_slots
    mut list<int> full_slots
}

fn kind_code(int block, int trunk, int interval) → int {
    # 0 = linear attention, 1 = full attention, 2 = nextn.
    if block ≥ trunk then return 2

    if (block + 1) % interval ≡ 0 then return 1

    return 0
}

# Derive the per-block schedule from the frozen configuration alone: the
# trunk is block_count - nextn_predict_layers blocks, full attention at
# (i + 1) % full_attention_interval == 0, the trailing nextn_predict_layers
# blocks are NextN/MTP. Holds for the pinned 41-block row and the local
# 40-block rows (nextn_predict_layers 0).
@ public
fn schedule(qwen35moe.Qwen35moeConfig c) → Qwen35moeSchedule ⇥ Qwen35moeStateError {
    require c.block_count ≥ 1 throw variant BadConfig { message = "block count must be at least one" }

    require c.nextn_predict_layers ≥ 0 throw variant BadConfig { message = "nextn layer count must be non-negative" }

    require c.nextn_predict_layers ≺ c.block_count throw variant BadConfig { message = "nextn layers must sit inside the block stack" }

    require c.full_attention_interval ≥ 1 throw variant BadConfig { message = "full attention interval must be at least one" }

    let int trunk ← c.block_count - c.nextn_predict_layers
    mut list<int> kinds ← empty
    mut list<int> linear_slots ← empty
    mut list<int> full_slots ← empty
    mut int linear ← 0
    mut int full ← 0

    for range 0 ‥ c.block_count let b {
        let int kind ← kind_code(b, trunk, c.full_attention_interval)
        kinds.append(kind)

        switch kind {
            case 0 {
                linear_slots.append(linear)
                full_slots.append(-1)
                linear ↑
            }
            case 1 {
                linear_slots.append(-1)
                full_slots.append(full)
                full ↑
            }
            case 2 {
                linear_slots.append(-1)
                full_slots.append(-1)
            }
        }
    }

    return Qwen35moeSchedule { trunk_layers = trunk, linear_layers = linear, full_layers = full, nextn_layers = c.nextn_predict_layers, kinds = kinds, linear_slots = linear_slots, full_slots = full_slots }
}

@ public
fn layer_kind(Qwen35moeSchedule s, int block) → LayerKind ⇥ Qwen35moeStateError {
    require block ≥ 0 and block ≺ s.kinds.length() throw variant BadConfig { message = "block index outside the schedule" }

    let int kind ← s.kinds.get(block) coalesce (-1)

    if kind ≡ 2 then return variant Nextn

    if kind ≡ 1 then return variant FullAttention

    return variant LinearAttention
}

@ public
fn layer_kind_name(LayerKind k) → string {
    match k {
        case LinearAttention {
            return "linear_attention"
        }
        case FullAttention {
            return "full_attention"
        }
        case Nextn {
            return "nextn"
        }
    }
}

@ public
fn layer_kind_eq(LayerKind a, LayerKind b) → bool {
    return layer_kind_name(a) ≡ layer_kind_name(b)
}

@ public
fn is_trunk(Qwen35moeSchedule s, int block) → bool {
    return block ≥ 0 and block ≺ s.trunk_layers
}

# Index of one linear-attention layer inside the SSM state list (0..29 on
# the pinned row). A full-attention or nextn block fails closed. The slot
# is read from the precomputed linear_slots array (constant time).
@ public
fn linear_index(Qwen35moeSchedule s, int block) → int ⇥ Qwen35moeStateError {
    require block ≥ 0 and block ≺ s.kinds.length() throw variant BadConfig { message = "block index outside the schedule" }

    require s.kinds.get(block) coalesce (-1) ≡ 0 throw variant BadConfig { message = "block is not a linear-attention layer" }

    return s.linear_slots.get(block) coalesce (-1)
}

# Index of one full-attention layer inside the KV state list (0..9). The
# slot is read from the precomputed full_slots array (constant time).
@ public
fn attention_index(Qwen35moeSchedule s, int block) → int ⇥ Qwen35moeStateError {
    require block ≥ 0 and block ≺ s.kinds.length() throw variant BadConfig { message = "block index outside the schedule" }

    require s.kinds.get(block) coalesce (-1) ≡ 1 throw variant BadConfig { message = "block is not a full-attention layer" }

    return s.full_slots.get(block) coalesce (-1)
}

fn tensor_row(gguf_manifest.GgufManifest m, string name) → gguf_manifest.GgufTensorDescriptor ⇥ Qwen35moeStateError {
    do {
        return gguf_manifest.find_tensor(m, name)
    }
    catch err {
        throw variant BadSchedule { message = "schedule contradiction at §"(name) }
    }
}

fn find_shape(gguf_manifest.GgufManifest m, string name, int index, int expected) → bool ⇥ Qwen35moeStateError {
    let gguf_manifest.GgufTensorDescriptor t ← tensor_row(m, name)

    require t.shape.length() ≻ index throw variant BadSchedule { message = "schedule contradiction at §"(name) }

    require t.shape.get(index) coalesce 0 ≡ expected throw variant BadSchedule { message = "schedule contradiction at §"(name) }

    return true
}

fn exists(gguf_manifest.GgufManifest m, string name) → bool ⇥ Qwen35moeStateError {
    tensor_row(m, name)
    return true
}

# Validate the derived schedule against each block's tensor inventory. The
# class-defining tensors are checked per block: the SSM family must carry
# attn_qkv [., qkv] and the ssm set, the full-attention family attn_q/attn_k
# with the kv projection width, and each nextn block its nextn.eh_proj. A
# block whose inventory contradicts the derived kind fails closed naming the
# block and the first contradictory tensor.
@ public
fn validate_schedule(gguf_manifest.GgufManifest m, Qwen35moeSchedule s, qwen35moe.Qwen35moeConfig c) → bool ⇥ Qwen35moeStateError {
    require s.kinds.length() ≡ c.block_count throw variant BadConfig { message = "schedule does not match the configuration" }

    let int kv_projection ← c.head_count_kv * c.key_length
    let int conv_channels ← c.inner_size + 2 * c.group_count * c.state_size

    for range 0 ‥ c.block_count let b {
        let string p ← "blk.§"(b ↦ string)
        let int kind ← s.kinds.get(b) coalesce (-1)

        if kind ≡ 2 {
            find_shape(m, p + ".nextn.eh_proj.weight", 0, c.inner_size)
            exists(m, p + ".attn_q.weight")
        }
        else {
            if kind ≡ 0 {
                find_shape(m, p + ".attn_qkv.weight", 1, conv_channels)
                exists(m, p + ".ssm_conv1d.weight")
                exists(m, p + ".ssm_a")
                exists(m, p + ".ssm_norm.weight")
            }
            else {
                find_shape(m, p + ".attn_k.weight", 1, kv_projection)
                exists(m, p + ".attn_q.weight")
                exists(m, p + ".attn_v.weight")
            }
        }
    }

    return true
}

# Bridge to `gradus:model/schedule` ExecutionSchedule for Seam 3/4 callers.
@ public
fn to_execution_schedule(Qwen35moeSchedule s, list<int> dimension_sections) → model_schedule.ExecutionSchedule ⇥ Qwen35moeStateError {
    let int n ← s.kinds.length()
    require n ≥ 1 throw variant BadConfig { message = "schedule must have at least one block" }

    mut list<model_schedule.LayerSpec> layers ← empty
    let model_schedule.RopeKind full_rope ← variant Sectional { dimension_sections = dimension_sections }

    for range 0 ‥ n let b {
        let int kind ← s.kinds.get(b) coalesce (-1)
        mut model_schedule.AttentionKind attn ← variant LinearSsm
        mut model_schedule.RopeKind rope ← variant None
        mut int conv_sites ← 1
        mut int conv_kernel ← 4

        if kind ≡ 2 {
            attn ← variant model_schedule.AttentionKind.Nextn
            rope ← full_rope
            conv_sites ← 0
            conv_kernel ← 0
        }
        else {
            if kind ≡ 1 {
                attn ← variant model_schedule.AttentionKind.Full
                rope ← full_rope
                conv_sites ← 0
                conv_kernel ← 0
            }
        }

        layers.append(model_schedule.LayerSpec { physical_layer_id = b, attention = attn, rope = rope, ffn = variant MoE, conv_sites = conv_sites, conv_kernel = conv_kernel })
    }

    let list<model_schedule.ScheduleSegment> segs ← [variant Patterned { seg = model_schedule.PatternedSegment { start_layer = 0, end_layer = n } }]

    do {
        return model_schedule.build_schedule(layers, segs, variant model_schedule.ResidualKind.Standard, empty)
    }
    catch err {
        throw variant BadSchedule { message = err.message }
    }
}

+++ faber test
import from "gradus:model/qwen35moe_state/schedule" let qs
import from "gradus:model/schedule" let ms

test "Qwen35moe to_execution_schedule populates conv_sites=1 and conv_kernel=4 on LinearSsm layers" {
    let qs.Qwen35moeSchedule s ← qs.Qwen35moeSchedule {
        trunk_layers = 4,
        linear_layers = 3,
        full_layers = 1,
        nextn_layers = 0,
        kinds = [0, 0, 0, 1],
        linear_slots = [0, 1, 2, -1],
        full_slots = [-1, -1, -1, 0]
    }
    mut ms.ExecutionSchedule es ← ms.ExecutionSchedule { layers = [], segments = [], steps = [], slots = [], residual = variant ms.ResidualKind.Standard, taps = [] }
    do {
        es ← qs.to_execution_schedule(s, [11, 11, 10, 0])
    }
    catch err {
        assert false
    }
    do {
        assert ms.slot_conv_sites(es, 0) ≡ 1
        assert ms.slot_conv_kernel(es, 0) ≡ 4
        assert ms.slot_conv_sites(es, 1) ≡ 1
        assert ms.slot_conv_kernel(es, 1) ≡ 4
        assert ms.slot_conv_sites(es, 2) ≡ 1
        assert ms.slot_conv_kernel(es, 2) ≡ 4
        assert ms.slot_conv_sites(es, 3) ≡ 0
        assert ms.slot_conv_kernel(es, 3) ≡ 0
        assert ms.total_conv_sites(es) ≡ 3
    }
    catch err {
        assert false
    }
}
