+++ toml
locale = "en"

+++ faber
# Full-attention path with KV state for qwen35moe hybrid layers.
#
# Public import: import from "gradus:model/qwen35moe_state/full_attn" full_attn
# Depends on: schedule, session, qwen35moe, tensor.

import from "gradus:model/qwen35moe_state/schedule" let schedule
import from "gradus:model/qwen35moe_state/session" let session
import from "gradus:model/qwen35moe" let qwen35moe
import from "gradus:tensor" let tensor
import from "gradus:dtype" let dtype

# -------------------------------------------------------------------------
# S3 — the gated full-attention layer window (F3, F4).
# -------------------------------------------------------------------------

# Per-token intermediates of one full-attention layer window. Rows are
# [tokens][width]: normed [T][2048]; q_full the joint Q/gate projection
# [T][8192]; q_normed [T][16][256]; k_normed [T][2][256]; gate the
# pre-sigmoid gate rows [T][4096]; q_rope/k_rope the post-RoPE rows; v the
# V rows [T][2][256]; softmax the attention weights [T][16][kv_length];
# pregate the attention context [T][4096]; gated the sigmoid-gated context
# [T][4096].
@ public
class FullAttentionTrace {
    mut list<f32> normed
    mut list<f32> q_full
    mut list<f32> q_normed
    mut list<f32> k_normed
    mut list<f32> gate
    mut list<f32> q_rope
    mut list<f32> k_rope
    mut list<f32> v
    mut list<f32> softmax
    mut list<f32> pregate
    mut list<f32> gated
}

@ public
class FullAttentionOutcome {
    mut FullAttentionTrace trace
    mut list<f32> out
    mut session.KeyValueState kv
}

# Load-time-prepared full-attention weights (issue #79): every weight
# window is read, shape-checked, and finiteness-validated once here —
# never per decode token. The lean prepared entry points below consume
# this record and touch no weight source.
@ public
class FullAttentionWeights {
    mut tensor.NumericBlock attn_norm
    mut tensor.NumericBlock wq
    mut tensor.NumericBlock wk
    mut tensor.NumericBlock wv
    mut tensor.NumericBlock q_norm
    mut tensor.NumericBlock k_norm
    mut tensor.NumericBlock wo
}

# Read and validate the whole full-attention weight set once. The window
# order matches the traced entry point's read order, so the first
# diverging window fails with the same diagnostic either way.
@ public
fn prepare_full_attention((string, int, int) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError source, int layer, qwen35moe.Qwen35moeConfig c) → FullAttentionWeights ⇥ schedule.Qwen35moeStateError {
    require layer ≥ 0 throw variant BadConfig {message = "layer index must be non-negative"}
    require c.rope_sections.length() ≥ 4 throw variant BadShape {message = "rope needs four section lengths"}
    let int embd ← c.embedding_length
    let int q_width ← c.head_count * c.key_length
    let int kv_width ← c.head_count_kv * c.key_length
    let int head_dim ← c.key_length
    let string p ← session.prefix(layer)
    let tensor.NumericBlock attn_norm ← session.window(source, p + ".attn_norm", 0, embd, [embd])
    let tensor.NumericBlock wq ← session.window(source, p + ".attn_q", 0, 2 * q_width * embd, [2 * q_width, embd])
    let tensor.NumericBlock wk ← session.window(source, p + ".attn_k", 0, kv_width * embd, [kv_width, embd])
    let tensor.NumericBlock wv ← session.window(source, p + ".attn_v", 0, kv_width * embd, [kv_width, embd])
    let tensor.NumericBlock q_norm ← session.window(source, p + ".attn_q_norm", 0, head_dim, [head_dim])
    let tensor.NumericBlock k_norm ← session.window(source, p + ".attn_k_norm", 0, head_dim, [head_dim])
    let tensor.NumericBlock wo ← session.window(source, p + ".attn_output", 0, embd * q_width, [embd, q_width])
    return FullAttentionWeights {attn_norm = attn_norm, wq = wq, wk = wk, wv = wv, q_norm = q_norm, k_norm = k_norm, wo = wo}
}

# Run one full-attention layer over T input rows [T][2048] starting at
# absolute position start_pos: attn_norm -> joint Q/gate projection ->
# per-head Q RMSNorm -> K/V projections with per-kv-head K RMSNorm ->
# multi-section RoPE on Q/K -> causal softmax attention over the carried KV
# state -> sigmoid output gate -> output projection -> residual add. The KV
# state appends exactly T positions (one per token) in order. `capture`
# gates only the diagnostic trace buffers (including the [T][H][kv_len]
# softmax weights): the compute path and every float operation are
# identical either way (issue #79). The RoPE angle table is built once per
# token and shared by every Q/K head of that token.
fn full_attention_core(list<f32> x_rows, session.KeyValueState kv_in, int start_pos, FullAttentionWeights weights, qwen35moe.Qwen35moeConfig c, bool capture) → FullAttentionOutcome ⇥ schedule.Qwen35moeStateError {
    let int tokens ← x_rows.length() / c.embedding_length
    # --- window gates (fail closed) ---------------------------------------
    require tokens ≥ 1 and x_rows.length() ≡ tokens * c.embedding_length throw variant BadShape {message = "full attention input rows must be [T][embedding]"}
    require start_pos ≡ kv_in.length throw variant BadState {message = "positions must continue the kv state exactly"}
    require kv_in.length + tokens ≤ kv_in.capacity throw variant BadState {message = "kv state window exceeds capacity"}
    let int embd ← c.embedding_length
    let int heads ← c.head_count
    let int kv_heads ← c.head_count_kv
    let int head_dim ← c.key_length
    let int q_width ← heads * head_dim
    let int kv_width ← kv_heads * head_dim
    let int kv_len ← kv_in.length + tokens

    # --- weights (validated at read: prepare once, or per traced call) ----
    let tensor.NumericBlock attn_norm ← weights.attn_norm
    let tensor.NumericBlock wq ← weights.wq
    let tensor.NumericBlock wk ← weights.wk
    let tensor.NumericBlock wv ← weights.wv
    let tensor.NumericBlock q_norm ← weights.q_norm
    let tensor.NumericBlock k_norm ← weights.k_norm
    let tensor.NumericBlock wo ← weights.wo

    # --- attn_norm + projections ------------------------------------------
    mut list<f32> normed_rows ← empty
    for range 0‥tokens let t {
        mut list<f32> row ← empty
        for range 0‥embd let d {
            row.append(x_rows.get(t * embd + d) coalesce 0.0)
        }
        let list<f32> normed ← session.rms_norm_row(row, attn_norm.data, c.rms_norm_epsilon)
        for from normed let v {
            normed_rows.append(v)
        }
    }
    let list<f32> q_full_rows ← session.gemm_rows(wq, normed_rows, embd, 2 * q_width, tokens)
    let list<f32> k_rows ← session.gemm_rows(wk, normed_rows, embd, kv_width, tokens)
    let list<f32> v_rows ← session.gemm_rows(wv, normed_rows, embd, kv_width, tokens)

    # --- per-head Q/K/V views ---------------------------------------------
    # Q head h occupies [512h, 512h + 256), its gate the next 256; K/V per
    # kv head. Q/K heads are RMSNormed then carry multi-section RoPE over
    # the first rope dims; pass-through beyond. V is un-normed.
    mut list<f32> q_heads ← empty
    mut list<f32> gate_rows ← empty
    mut list<f32> k_heads ← empty
    mut list<f32> v_heads ← empty
    mut list<f32> q_normed_rows ← empty
    mut list<f32> k_normed_rows ← empty
    for range 0‥tokens let t {
        let list<f32> rope_angles ← session.rope_table(c.freq_base, c.rope_dimension_count, start_pos + t)
        for range 0‥heads let h {
            mut list<f32> qhead ← empty
            for range 0‥head_dim let d {
                qhead.append(q_full_rows.get(t * 2 * q_width + h * 2 * head_dim + d) coalesce 0.0)
            }
            let list<f32> normed ← session.rms_norm_row(qhead, q_norm.data, c.rms_norm_epsilon)
            let list<f32> turned ← session.rope_head_table(normed, rope_angles, c.rope_dimension_count, head_dim)
            if capture {
                q_normed_rows.extend(normed)
            }
            q_heads.extend(turned)
            for range 0‥head_dim let d {
                gate_rows.append(q_full_rows.get(t * 2 * q_width + h * 2 * head_dim + head_dim + d) coalesce 0.0)
            }
        }
        for range 0‥kv_heads let g {
            mut list<f32> khead ← empty
            for range 0‥head_dim let d {
                khead.append(k_rows.get(t * kv_width + g * head_dim + d) coalesce 0.0)
            }
            let list<f32> normed ← session.rms_norm_row(khead, k_norm.data, c.rms_norm_epsilon)
            let list<f32> turned ← session.rope_head_table(normed, rope_angles, c.rope_dimension_count, head_dim)
            if capture {
                k_normed_rows.extend(normed)
            }
            k_heads.extend(turned)
            for range 0‥head_dim let d {
                v_heads.append(v_rows.get(t * kv_width + g * head_dim + d) coalesce 0.0 ∷ f32)
            }
        }
    }

    # --- KV append: the T new positions join the state in order -----------
    mut list<f32> keys ← empty
    keys.extend(kv_in.keys)
    keys.extend(k_heads)
    mut list<f32> values ← empty
    values.extend(kv_in.values)
    values.extend(v_heads)
    let session.KeyValueState kv_out ← session.KeyValueState {keys = keys, values = values, kv_heads = kv_heads, key_dim = kv_in.key_dim, value_dim = kv_in.value_dim, capacity = kv_in.capacity, length = kv_len}

    # --- causal softmax attention -----------------------------------------
    # Query t attends positions 0..start_pos + t with the 1/sqrt(head_dim)
    # scale; GQA head h reads kv head h / (heads / kv_heads).
    let f32 kq_scale ← 1.0 / (√ (head_dim ↦ f32))
    let int heads_per_kv ← heads / kv_heads
    mut list<f32> pregate_rows ← empty
    mut list<f32> softmax_rows ← empty
    for range 0‥tokens let t {
        let int attend ← start_pos + t + 1
        for range 0‥heads let h {
            let int kvh ← h / heads_per_kv
            mut list<f32> scores ← empty
            mut f32 maximum ← 0.0
            for range 0‥attend let i {
                mut f32 dot ← 0.0
                for range 0‥head_dim let d {
                    dot ← dot + (q_heads.get(t * q_width + h * head_dim + d) coalesce 0.0) * (keys.get(i * kv_width + kvh * head_dim + d) coalesce 0.0)
                }
                let f32 score ← dot * kq_scale
                if i ≡ 0 or score ≻ maximum {
                    maximum ← score
                }
                scores.append(score)
            }
            mut list<f32> exponents ← empty
            mut f32 total ← 0.0
            for range 0‥attend let i {
                let f32 e ← ((scores.get(i) coalesce 0.0) - maximum).exp()
                exponents.append(e)
                total ← total + e
            }
            require total ≻ 0.0 throw variant schedule.Qwen35moeStateError.NonFinite {message = "attention softmax normalizer collapsed"}
            mut list<f32> norm_weights ← empty
            for range 0‥attend let i {
                norm_weights.append((exponents.get(i) coalesce 0.0) / total)
            }
            if capture {
                for range 0‥attend let i {
                    softmax_rows.append(norm_weights.get(i) coalesce 0.0)
                }
                for range attend‥kv_len {
                    softmax_rows.append(0.0)
                }
            }
            for range 0‥head_dim let d {
                mut f32 sum ← 0.0
                for range 0‥attend let i {
                    sum ← sum + (norm_weights.get(i) coalesce 0.0) * (values.get(i * kv_width + kvh * head_dim + d) coalesce 0.0)
                }
                pregate_rows.append(sum)
            }
        }
    }

    # --- sigmoid gate, output projection, residual add --------------------
    mut list<f32> gated_rows ← empty
    for range 0‥tokens * q_width let i {
        gated_rows.append((pregate_rows.get(i) coalesce 0.0) * session.sigmoid(gate_rows.get(i) coalesce 0.0))
    }
    let list<f32> projected ← session.gemm_rows(wo, gated_rows, q_width, embd, tokens)
    mut list<f32> out_rows ← empty
    for range 0‥tokens * embd let i {
        let f32 v ← projected.get(i) coalesce 0.0 ∷ f32
        require dtype.finite(v) throw variant schedule.Qwen35moeStateError.NonFinite {message = "full attention output is non-finite"}
        out_rows.append(v + (x_rows.get(i) coalesce 0.0 ∷ f32))
    }
    if not capture {
        # Lean decode route: no diagnostic trace buffers are allocated
        # (issue #79) — in particular the [T][H][kv_len] softmax weight
        # buffer and the pre-RoPE Q/K norm snapshots are skipped.
        return FullAttentionOutcome {trace = FullAttentionTrace {normed = empty, q_full = empty, q_normed = empty, k_normed = empty, gate = empty, q_rope = empty, k_rope = empty, v = empty, softmax = empty, pregate = empty, gated = empty}, out = out_rows, kv = kv_out}
    }
    let FullAttentionTrace trace ← FullAttentionTrace {normed = normed_rows, q_full = q_full_rows, q_normed = q_normed_rows, k_normed = k_normed_rows, gate = gate_rows, q_rope = q_heads, k_rope = k_heads, v = v_heads, softmax = softmax_rows, pregate = pregate_rows, gated = gated_rows}
    return FullAttentionOutcome {trace = trace, out = out_rows, kv = kv_out}
}

# Traced form (the oracle/diagnostic route): reads and validates every
# weight window through the source on each call, and captures the full
# per-token trace for the per-layer first-divergence comparison. Gate
# order matches the historical entry point: input shape, layer index,
# kv continuation, kv capacity, then weight windows.
@ public
fn full_attention(list<f32> x_rows, int layer, session.KeyValueState kv_in, int start_pos, (string, int, int) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError source, qwen35moe.Qwen35moeConfig c) → FullAttentionOutcome ⇥ schedule.Qwen35moeStateError {
    let int tokens ← x_rows.length() / c.embedding_length
    require tokens ≥ 1 and x_rows.length() ≡ tokens * c.embedding_length throw variant BadShape {message = "full attention input rows must be [T][embedding]"}
    require layer ≥ 0 throw variant BadConfig {message = "layer index must be non-negative"}
    require start_pos ≡ kv_in.length throw variant BadState {message = "positions must continue the kv state exactly"}
    require kv_in.length + tokens ≤ kv_in.capacity throw variant BadState {message = "kv state window exceeds capacity"}
    let FullAttentionWeights weights ← prepare_full_attention(source, layer, c)
    return full_attention_core(x_rows, kv_in, start_pos, weights, c, true)
}

# One-token incremental form (F5's decode side; the KV append is exactly
# one position).
@ public
fn full_attention_step(list<f32> x_row, int layer, session.KeyValueState kv_in, int pos, (string, int, int) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError source, qwen35moe.Qwen35moeConfig c) → FullAttentionOutcome ⇥ schedule.Qwen35moeStateError {
    return full_attention(x_row, layer, kv_in, pos, source, c)
}

# Lean prepared form (the decode route): consumes the load-time-prepared
# weight record, re-reads no weight source, re-runs no weight validation,
# and allocates no trace buffers.
@ public
fn full_attention_prepared(list<f32> x_rows, session.KeyValueState kv_in, int start_pos, FullAttentionWeights weights, qwen35moe.Qwen35moeConfig c) → FullAttentionOutcome ⇥ schedule.Qwen35moeStateError {
    return full_attention_core(x_rows, kv_in, start_pos, weights, c, false)
}

# One-token lean prepared form (the KV append is exactly one position).
@ public
fn full_attention_step_prepared(list<f32> x_row, session.KeyValueState kv_in, int pos, FullAttentionWeights weights, qwen35moe.Qwen35moeConfig c) → FullAttentionOutcome ⇥ schedule.Qwen35moeStateError {
    return full_attention_prepared(x_row, kv_in, pos, weights, c)
}
