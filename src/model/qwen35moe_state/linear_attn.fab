+++ toml
locale = "en"

+++ faber
# Gated DeltaNet linear-attention path (conv + recurrent) over typed arenas.
#
# Public import: import from "gradus:model/qwen35moe_state/linear_attn" linear_attn
# Depends on: schedule, session, qwen35moe, gradus:cache/hybrid_arenas, gradus:dtype.

import from "gradus:model/qwen35moe_state/schedule" let schedule
import from "gradus:model/qwen35moe_state/session" let session
import from "gradus:model/qwen35moe" let qwen35moe
import from "gradus:cache/hybrid_arenas" let hybrid
import from "gradus:dtype" let dtype

# -------------------------------------------------------------------------
# The linear-attention (SSM) layer window (F2, F5).
# -------------------------------------------------------------------------

# Per-token intermediates of one SSM layer window, kept for the per-layer
# first-divergence comparison. All lists are [tokens][width] row-major:
# normed is the attn_norm output [T][2048]; qkv_mixed the qkv projection
# [T][8192]; gate_proj the z projection [T][4096]; beta_sigmoid and gate
# are [T][32]; conv_input is [rows + T][8192]; conv_output is the
# post-SiLU conv [T][8192]; q_conv/k_conv are the L2-normed head-repeated
# rows [T][32][128]; v_conv matches; core_out is the delta-net output
# [T][32][128]; final_output is the z-gated normed row [T][4096].
@ public
class LinearAttentionTrace {
    mut list<f32> normed
    mut list<f32> qkv_mixed
    mut list<f32> gate_proj
    mut list<f32> beta_sigmoid
    mut list<f32> gate
    mut list<f32> conv_input
    mut list<f32> conv_output
    mut list<f32> q_conv
    mut list<f32> k_conv
    mut list<f32> v_conv
    mut list<f32> core_out
    mut list<f32> final_output
}

@ public
class LinearAttentionOutcome {
    mut LinearAttentionTrace trace
    mut list<f32> out
}

# Load-time-prepared SSM layer weights (issue #79): every weight window is
# read, length-checked, and finiteness-validated once here — never per
# decode token. The lean prepared entry points below consume this record
# and touch no weight source.
@ public
class LinearAttentionWeights {
    mut list<f32> attn_norm
    mut list<f32> wqkv
    mut list<f32> wgate
    mut list<f32> conv_weight
    mut list<f32> dt_bias
    mut list<f32> a_row
    mut list<f32> wbeta
    mut list<f32> walpha
    mut list<f32> ssm_norm
    mut list<f32> wout
}

# Read and validate the whole SSM layer weight set once. The window order
# matches the traced entry point's read order, so the first diverging
# window fails with the same diagnostic either way.
@ public
fn prepare_linear_attention((string, int, int) → list<f32> ⇥ schedule.Qwen35moeStateError source, int layer, qwen35moe.Qwen35moeConfig c) → LinearAttentionWeights ⇥ schedule.Qwen35moeStateError {
    require layer ≥ 0 throw variant BadConfig {message = "layer index must be non-negative"}
    let int embd ← c.embedding_length
    let int conv_channels ← c.inner_size + 2 * c.group_count * c.state_size
    let int value_heads ← c.gradus_temporis
    let int head_v_dim ← c.inner_size / value_heads
    let string p ← session.prefix(layer)
    let list<f32> attn_norm ← session.window(source, p + ".attn_norm", 0, embd)
    let list<f32> wqkv ← session.window(source, p + ".attn_qkv", 0, conv_channels * embd)
    let list<f32> wgate ← session.window(source, p + ".attn_gate", 0, c.inner_size * embd)
    let list<f32> conv_weight ← session.window(source, p + ".ssm_conv1d", 0, c.conv_kernel * conv_channels)
    let list<f32> dt_bias ← session.window(source, p + ".ssm_dt", 0, value_heads)
    let list<f32> a_row ← session.window(source, p + ".ssm_a", 0, value_heads)
    let list<f32> wbeta ← session.window(source, p + ".ssm_beta", 0, value_heads * embd)
    let list<f32> walpha ← session.window(source, p + ".ssm_alpha", 0, value_heads * embd)
    let list<f32> ssm_norm ← session.window(source, p + ".ssm_norm", 0, head_v_dim)
    let list<f32> wout ← session.window(source, p + ".ssm_out", 0, embd * c.inner_size)
    return LinearAttentionWeights {attn_norm = attn_norm, wqkv = wqkv, wgate = wgate, conv_weight = conv_weight, dt_bias = dt_bias, a_row = a_row, wbeta = wbeta, walpha = walpha, ssm_norm = ssm_norm, wout = wout}
}

fn find_arena_slot(list<int> slot_ids, int slot_id, string label) → int ⇥ schedule.Qwen35moeStateError {
    for exclusive slot_ids.length() let i {
        if slot_ids[i] ≡ slot_id then return i
    }
    throw variant BadState {message = "§ slot_id § not found in arena"(label, slot_id ↦ string)}
}

# One head, one token directly over a RecurrentStateArena tensor:
# decay -> delta -> outer update -> output read, in the comparator's exact
# stage order and float arithmetic, without copying the head matrix out.
fn delta_step_head<size RecRows, size RecCols>(mut tensor<f32, [RecRows, RecCols]> state, int row_base, list<f32> q, int q_base, list<f32> k, int k_base, list<f32> v, int v_base, f32 decay, f32 beta, int dim, f32 scale, mut list<f32> row_dec, mut list<f32> out) → void ⇥ schedule.Qwen35moeStateError {
    for range 0‥dim let j {
        let int r ← row_base + j
        mut f32 sum ← 0.0 ∷ f32
        for range 0‥dim let i {
            let f32 dec ← state[[r, i]] * decay
            row_dec[i] ← dec
            sum ← sum + dec * k[k_base + i]
        }
        let f32 d ← (v[v_base + j] - sum) * beta
        mut f32 read ← 0.0 ∷ f32
        for range 0‥dim let i {
            let f32 cell ← row_dec[i] + k[k_base + i] * d
            state[[r, i]] ← cell
            read ← read + cell * q[q_base + i]
        }
        require dtype.finite(read) throw variant schedule.Qwen35moeStateError.NonFinite {message = "gated delta net output is non-finite"}
        out.append(read * scale)
    }
}

# Advance one head of a RecurrentStateArena slot by one token.
@ public
fn delta_step_slot<size RecRows, size RecCols>(mut hybrid.RecurrentStateArena<size RecRows, size RecCols> arena, int slot_id, list<f32> q, list<f32> k, list<f32> v, f32 g, f32 beta, int head) → list<f32> ⇥ schedule.Qwen35moeStateError {
    require arena.txn_depth ≡ 0 throw variant BadState {message = "recurrent arena has an open transaction"}
    let int r_idx ← find_arena_slot(arena.slot_ids, slot_id, "recurrent")
    let int dim ← RecCols
    require dim ≥ 1 and RecRows % dim ≡ 0 throw variant BadShape {message = "recurrent arena shape must be [heads * dim, dim]"}
    let int heads ← RecRows / dim
    require head ≥ 0 and head ≺ heads throw variant BadState {message = "recurrent head index outside the state"}
    require q.length() ≡ dim and k.length() ≡ dim and v.length() ≡ dim throw variant BadShape {message = "delta rule rows must match the state dim"}
    let f32 scale ← 1.0 / (√ (dim ↦ f32))
    mut list<f32> row_dec ← empty
    for range 0‥dim {
        row_dec.append(0.0 ∷ f32)
    }
    mut list<f32> out ← empty
    delta_step_head<size RecRows, size RecCols>(mut arena.states[r_idx], head * dim, q, 0, k, 0, v, 0, g.exp(), beta, dim, scale, mut row_dec, mut out)
    arena.steps_written[r_idx] ← arena.steps_written[r_idx] + 1
    return out
}

# Read one head of a RecurrentStateArena slot against a query row (no update).
@ public
fn recurrent_readout_slot<size RecRows, size RecCols>(hybrid.RecurrentStateArena<size RecRows, size RecCols> arena, int slot_id, list<f32> q, int head) → list<f32> ⇥ schedule.Qwen35moeStateError {
    let int r_idx ← find_arena_slot(arena.slot_ids, slot_id, "recurrent")
    let int dim ← RecCols
    require dim ≥ 1 and RecRows % dim ≡ 0 throw variant BadShape {message = "recurrent arena shape must be [heads * dim, dim]"}
    let int heads ← RecRows / dim
    require head ≥ 0 and head ≺ heads throw variant BadState {message = "recurrent head index outside the state"}
    require q.length() ≡ dim throw variant BadShape {message = "query row must match the state dim"}
    let tensor<f32, [RecRows, RecCols]> state ← arena.states[r_idx]
    let f32 scale ← 1.0 / (√ (dim ↦ f32))
    let int row_base ← head * dim
    mut list<f32> out ← empty
    for range 0‥dim let j {
        mut f32 sum ← 0.0 ∷ f32
        for range 0‥dim let i {
            sum ← sum + state[[row_base + j, i]] * q[i]
        }
        out.append(sum * scale)
    }
    return out
}

# Run one SSM layer over T input rows [T][2048]: attn_norm -> qkv/z/beta/
# alpha/gate projections -> causal depthwise conv (ConvStateArena) -> L2
# norms + head repeat -> the delta recurrence per head per token
# (RecurrentStateArena) -> z-gated RMSNorm -> output projection -> residual
# add. `capture` gates only the diagnostic trace record: the compute path
# and every float operation are identical either way (issue #79).
fn linear_attention_core<size ConvRows, size ConvCh, size RecRows, size RecCols>(list<f32> x_rows, mut hybrid.ConvStateArena<size ConvRows, size ConvCh> conv_arena, mut hybrid.RecurrentStateArena<size RecRows, size RecCols> rec_arena, int slot_id, LinearAttentionWeights weights, qwen35moe.Qwen35moeConfig c, bool capture) → LinearAttentionOutcome ⇥ schedule.Qwen35moeStateError {
    let int tokens ← x_rows.length() / c.embedding_length
    require tokens ≥ 1 and x_rows.length() ≡ tokens * c.embedding_length throw variant BadShape {message = "linear attention input rows must be [T][embedding]"}
    let int embd ← c.embedding_length
    let int conv_channels ← c.inner_size + 2 * c.group_count * c.state_size
    let int key_dim ← c.state_size
    let int value_heads ← c.gradus_temporis
    let int value_dim ← c.state_size
    let int head_v_dim ← c.inner_size / value_heads
    let int conv_hist ← c.conv_kernel - 1
    let int group_heads ← c.group_count
    let f32 l2_eps ← c.rms_norm_epsilon

    require embd ≥ 1 and value_heads ≥ 1 and group_heads ≥ 1 and key_dim ≥ 1 and head_v_dim ≡ key_dim and value_dim ≡ key_dim and c.conv_kernel ≥ 2 throw variant BadShape {message = "invalid linear attention dimensions"}
    require conv_arena.txn_depth ≡ 0 and rec_arena.txn_depth ≡ 0 throw variant BadState {message = "hybrid arena has an open transaction"}
    require conv_arena.channels ≡ conv_channels and ConvCh ≡ conv_channels throw variant BadShape {message = "conv arena channel width mismatch"}
    require conv_arena.history_len ≡ conv_hist and conv_hist ≥ 1 and conv_hist ≤ ConvRows throw variant BadShape {message = "conv arena history_len mismatch"}
    require RecRows ≡ value_heads * value_dim and RecCols ≡ key_dim throw variant BadShape {message = "recurrent arena shape mismatch"}
    let int c_idx ← find_arena_slot(conv_arena.slot_ids, slot_id, "conv")
    let int r_idx ← find_arena_slot(rec_arena.slot_ids, slot_id, "recurrent")

    # --- weights (validated at read: prepare once, or per traced call) ----
    let list<f32> attn_norm ← weights.attn_norm
    let list<f32> wqkv ← weights.wqkv
    let list<f32> wgate ← weights.wgate
    let list<f32> conv_weight ← weights.conv_weight
    let list<f32> dt_bias ← weights.dt_bias
    let list<f32> a_row ← weights.a_row
    let list<f32> wbeta ← weights.wbeta
    let list<f32> walpha ← weights.walpha
    let list<f32> ssm_norm ← weights.ssm_norm
    let list<f32> wout ← weights.wout
    require attn_norm.length() ≡ embd and conv_weight.length() ≡ conv_channels * c.conv_kernel and dt_bias.length() ≡ value_heads and a_row.length() ≡ value_heads and ssm_norm.length() ≡ head_v_dim throw variant BadShape {message = "linear attention weight window has the wrong length"}

    mut list<f32> out_rows ← empty

    # --- attn_norm + projections over the whole window --------------------
    let list<f32> normed_rows ← session.rms_norm_rows(x_rows, attn_norm, embd, tokens, c.rms_norm_epsilon)
    let list<f32> qkv_rows ← session.project_rows(wqkv, normed_rows, embd, conv_channels, tokens)
    let list<f32> z_rows ← session.project_rows(wgate, normed_rows, embd, c.inner_size, tokens)
    let list<f32> beta_rows ← session.project_rows(wbeta, normed_rows, embd, value_heads, tokens)
    let list<f32> alpha_rows ← session.project_rows(walpha, normed_rows, embd, value_heads, tokens)
    mut list<f32> beta_sigmoid_rows ← empty
    mut list<f32> gate_rows ← empty
    for range 0‥tokens let t {
        let int hbase ← t * value_heads
        for range 0‥value_heads let h {
            beta_sigmoid_rows.append(session.sigmoid(beta_rows[hbase + h]))
            gate_rows.append(session.softplus(alpha_rows[hbase + h] + dt_bias[h]) * a_row[h])
        }
    }

    # --- causal depthwise conv (ConvStateArena) ----------------------------
    # When capture is false, read directly from conv_buf ++ qkv_rows and
    # advance conv_buf in place without allocating conv_input.
    mut tensor<f32, [ConvRows, ConvCh]> conv_buf ← conv_arena.buffers[c_idx]
    mut list<f32> conv_input ← empty
    mut list<f32> conv_out ← empty
    if capture {
        for range 0‥conv_hist let r {
            for range 0‥conv_channels let ch {
                conv_input.append(conv_buf[[r, ch]])
            }
        }
        for from qkv_rows let v {
            conv_input.append(v)
        }
        for range 0‥tokens let t {
            for range 0‥conv_channels let ch {
                let int w_base ← ch * c.conv_kernel
                mut f32 sum ← 0.0
                for range 0‥c.conv_kernel let tap {
                    sum ← sum + conv_input[(t + tap) * conv_channels + ch] * conv_weight[w_base + tap]
                }
                conv_out.append(session.silu(sum))
            }
        }
        for range 0‥conv_hist let r {
            let int src_row ← (tokens + r) * conv_channels
            for range 0‥conv_channels let ch {
                conv_buf[[r, ch]] ← conv_input[src_row + ch]
            }
        }
    }
    else {
        for range 0‥tokens let t {
            for range 0‥conv_channels let ch {
                let int w_base ← ch * c.conv_kernel
                mut f32 sum ← 0.0
                for range 0‥c.conv_kernel let tap {
                    let int row ← t + tap
                    mut f32 inp ← 0.0
                    if row ≺ conv_hist {
                        inp ← conv_buf[[row, ch]]
                    }
                    else {
                        inp ← qkv_rows[(row - conv_hist) * conv_channels + ch]
                    }
                    sum ← sum + inp * conv_weight[w_base + tap]
                }
                conv_out.append(session.silu(sum))
            }
        }
        for range 0‥conv_hist let r {
            let int row ← tokens + r
            if row ≺ conv_hist {
                for range 0‥conv_channels let ch {
                    conv_buf[[r, ch]] ← conv_buf[[row, ch]]
                }
            }
            else {
                let int q_base ← (row - conv_hist) * conv_channels
                for range 0‥conv_channels let ch {
                    conv_buf[[r, ch]] ← qkv_rows[q_base + ch]
                }
            }
        }
    }
    conv_arena.buffers[c_idx] ← conv_buf
    conv_arena.steps_written[c_idx] ← conv_arena.steps_written[c_idx] + tokens

    # --- head views: L2-normed q/k (repeated when traced) -----------------
    mut list<f32> q_rows ← empty
    mut list<f32> k_rows ← empty
    mut list<f32> v_rows ← empty
    mut list<f32> q_group ← empty
    mut list<f32> k_group ← empty
    mut list<f32> q_scales ← empty
    mut list<f32> k_scales ← empty
    for range 0‥group_heads {
        q_scales.append(0.0 ∷ f32)
        k_scales.append(0.0 ∷ f32)
    }
    for range 0‥tokens let t {
        let int tbase ← t * conv_channels
        let int k_offset ← tbase + group_heads * key_dim
        for range 0‥group_heads let h {
            let int q_off ← tbase + h * key_dim
            let int k_off ← k_offset + h * key_dim
            mut f32 qsum ← 0.0
            mut f32 ksum ← 0.0
            for range 0‥key_dim let d {
                let f32 qv ← conv_out[q_off + d]
                let f32 kv ← conv_out[k_off + d]
                qsum ← qsum + qv * qv
                ksum ← ksum + kv * kv
            }
            let f32 qnorm ← √ qsum
            let f32 knorm ← √ ksum
            q_scales[h] ← qnorm ≺ l2_eps ✓ (1.0 / l2_eps) ✗ (1.0 / qnorm)
            k_scales[h] ← knorm ≺ l2_eps ✓ (1.0 / l2_eps) ✗ (1.0 / knorm)
        }
        if capture {
            let int v_offset ← tbase + 2 * group_heads * key_dim
            for range 0‥value_heads let h {
                let int src_head ← h % group_heads
                let int q_off ← tbase + src_head * key_dim
                let int k_off ← k_offset + src_head * key_dim
                let int v_off ← v_offset + h * head_v_dim
                let f32 qs ← q_scales[src_head]
                let f32 ks ← k_scales[src_head]
                for range 0‥key_dim let d {
                    q_rows.append(conv_out[q_off + d] * qs)
                    k_rows.append(conv_out[k_off + d] * ks)
                    v_rows.append(conv_out[v_off + d])
                }
            }
        }
        else {
            for range 0‥group_heads let h {
                let int q_off ← tbase + h * key_dim
                let int k_off ← k_offset + h * key_dim
                let f32 qs ← q_scales[h]
                let f32 ks ← k_scales[h]
                for range 0‥key_dim let d {
                    q_group.append(conv_out[q_off + d] * qs)
                    k_group.append(conv_out[k_off + d] * ks)
                }
            }
        }
    }

    # --- delta recurrence: tokens outer, heads inner ----------------------
    # Each head's state is independent, so token-outer iteration updates
    # RecurrentStateArena directly and emits core_token_major without
    # temporary head copies or post-pass transposition.
    let f32 rec_scale ← 1.0 / (√ (key_dim ↦ f32))
    mut list<f32> row_dec ← empty
    for range 0‥key_dim {
        row_dec.append(0.0 ∷ f32)
    }
    mut list<f32> core_token_major ← empty
    for range 0‥tokens let t {
        let int h_idx_base ← t * value_heads
        let int v_conv_base ← t * conv_channels + 2 * group_heads * key_dim
        let int g_base ← t * group_heads * key_dim
        for range 0‥value_heads let h {
            let f32 beta ← beta_sigmoid_rows[h_idx_base + h]
            let f32 decay ← (gate_rows[h_idx_base + h]).exp()
            let int row_base ← h * value_dim
            if capture {
                let int qkv_base ← (h_idx_base + h) * key_dim
                delta_step_head<size RecRows, size RecCols>(mut rec_arena.states[r_idx], row_base, q_rows, qkv_base, k_rows, qkv_base, v_rows, qkv_base, decay, beta, key_dim, rec_scale, mut row_dec, mut core_token_major)
            }
            else {
                let int src_head ← h % group_heads
                let int qk_base ← g_base + src_head * key_dim
                let int v_base ← v_conv_base + h * head_v_dim
                delta_step_head<size RecRows, size RecCols>(mut rec_arena.states[r_idx], row_base, q_group, qk_base, k_group, qk_base, conv_out, v_base, decay, beta, key_dim, rec_scale, mut row_dec, mut core_token_major)
            }
        }
    }
    rec_arena.steps_written[r_idx] ← rec_arena.steps_written[r_idx] + tokens

    # --- z-gated RMSNorm, output projection, residual add -----------------
    mut list<f32> final_rows ← empty
    for range 0‥tokens let t {
        let int t_cbase ← t * value_heads * head_v_dim
        let int t_zbase ← t * c.inner_size
        for range 0‥value_heads let h {
            let int c_base ← t_cbase + h * head_v_dim
            let int z_base ← t_zbase + h * head_v_dim
            mut f32 sum ← 0.0
            for range 0‥head_v_dim let d {
                let f32 v ← core_token_major[c_base + d]
                sum ← sum + v * v
            }
            let f32 scale ← 1.0 / (√ (sum / (head_v_dim ↦ f32) + c.rms_norm_epsilon))
            for range 0‥head_v_dim let d {
                final_rows.append((core_token_major[c_base + d] * scale * ssm_norm[d]) * session.silu(z_rows[z_base + d]))
            }
        }
    }
    let list<f32> projected ← session.project_rows(wout, final_rows, c.inner_size, embd, tokens)
    for range 0‥tokens * embd let i {
        let f32 v ← projected[i]
        require dtype.finite(v) throw variant schedule.Qwen35moeStateError.NonFinite {message = "linear attention output is non-finite"}
        out_rows.append(v + x_rows[i])
    }
    if not capture {
        # Lean decode route: no diagnostic trace buffers are allocated
        # (issue #79); every compute intermediate above is either consumed
        # by the next stage or dropped here without a trace copy.
        return LinearAttentionOutcome {trace = LinearAttentionTrace {normed = empty, qkv_mixed = empty, gate_proj = empty, beta_sigmoid = empty, gate = empty, conv_input = empty, conv_output = empty, q_conv = empty, k_conv = empty, v_conv = empty, core_out = empty, final_output = empty}, out = out_rows}
    }
    let LinearAttentionTrace trace ← LinearAttentionTrace {normed = normed_rows, qkv_mixed = qkv_rows, gate_proj = z_rows, beta_sigmoid = beta_sigmoid_rows, gate = gate_rows, conv_input = conv_input, conv_output = conv_out, q_conv = q_rows, k_conv = k_rows, v_conv = v_rows, core_out = core_token_major, final_output = final_rows}
    return LinearAttentionOutcome {trace = trace, out = out_rows}
}

# Traced form (the oracle/diagnostic route): reads and validates every
# weight window through the source on each call, and captures the full
# per-token trace for the per-layer first-divergence comparison. Gate
# order matches the historical entry point: input shape, then layer index,
# then weight windows.
@ public
fn linear_attention<size ConvRows, size ConvCh, size RecRows, size RecCols>(list<f32> x_rows, int layer, mut hybrid.ConvStateArena<size ConvRows, size ConvCh> conv_arena, mut hybrid.RecurrentStateArena<size RecRows, size RecCols> rec_arena, int slot_id, (string, int, int) → list<f32> ⇥ schedule.Qwen35moeStateError source, qwen35moe.Qwen35moeConfig c) → LinearAttentionOutcome ⇥ schedule.Qwen35moeStateError {
    let int tokens ← x_rows.length() / c.embedding_length
    require tokens ≥ 1 and x_rows.length() ≡ tokens * c.embedding_length throw variant BadShape {message = "linear attention input rows must be [T][embedding]"}
    let LinearAttentionWeights weights ← prepare_linear_attention(source, layer, c)
    return linear_attention_core<size ConvRows, size ConvCh, size RecRows, size RecCols>(x_rows, mut conv_arena, mut rec_arena, slot_id, weights, c, true)
}

# One-token incremental form (F5's decode side; identical math, T = 1).
@ public
fn linear_attention_step<size ConvRows, size ConvCh, size RecRows, size RecCols>(list<f32> x_row, int layer, mut hybrid.ConvStateArena<size ConvRows, size ConvCh> conv_arena, mut hybrid.RecurrentStateArena<size RecRows, size RecCols> rec_arena, int slot_id, (string, int, int) → list<f32> ⇥ schedule.Qwen35moeStateError source, qwen35moe.Qwen35moeConfig c) → LinearAttentionOutcome ⇥ schedule.Qwen35moeStateError {
    return linear_attention<size ConvRows, size ConvCh, size RecRows, size RecCols>(x_row, layer, mut conv_arena, mut rec_arena, slot_id, source, c)
}

# Lean prepared form (the decode route): consumes the load-time-prepared
# weight record, re-reads no weight source, re-runs no weight validation,
# and allocates no trace buffers.
@ public
fn linear_attention_prepared<size ConvRows, size ConvCh, size RecRows, size RecCols>(list<f32> x_rows, mut hybrid.ConvStateArena<size ConvRows, size ConvCh> conv_arena, mut hybrid.RecurrentStateArena<size RecRows, size RecCols> rec_arena, int slot_id, LinearAttentionWeights weights, qwen35moe.Qwen35moeConfig c) → LinearAttentionOutcome ⇥ schedule.Qwen35moeStateError {
    return linear_attention_core<size ConvRows, size ConvCh, size RecRows, size RecCols>(x_rows, mut conv_arena, mut rec_arena, slot_id, weights, c, false)
}

# One-token lean prepared form (identical math, T = 1).
@ public
fn linear_attention_step_prepared<size ConvRows, size ConvCh, size RecRows, size RecCols>(list<f32> x_row, mut hybrid.ConvStateArena<size ConvRows, size ConvCh> conv_arena, mut hybrid.RecurrentStateArena<size RecRows, size RecCols> rec_arena, int slot_id, LinearAttentionWeights weights, qwen35moe.Qwen35moeConfig c) → LinearAttentionOutcome ⇥ schedule.Qwen35moeStateError {
    return linear_attention_prepared<size ConvRows, size ConvCh, size RecRows, size RecCols>(x_row, mut conv_arena, mut rec_arena, slot_id, weights, c)
}
