+++
locale = "en"
+++
# Typed `llama` (SmolLM2) architecture adapter (REF-01-U1.6).
#
# Public import: import from "gradus:model/dense_llama" dense_llama
# Depends on: gradus:model/gguf_manifest (manifest + GgufTensorDescriptor
#   range seam), the GGUF-A1b inspect surface facts for the real
#   SmolLM2-360M-Instruct-Q4_K_M.gguf file (read-only pinned facts, recorded
#   in the proba; no artifact bytes are committed).
#
# The adapter is a typed canonical tensor-name → manifest-descriptor mapping
# for the llama architecture family. `smollm2_arch` is the frozen
# SmolLM2-360M architecture config (32 layers, 15 heads, 5 KV heads, head_dim
# 64, hidden 960, vocab 49152, tied embedding). `gguf_name` maps a canonical
# name (model.embed_tokens, model.layers.{N}.input_layernorm,
# .self_attn.{q,k,v,o}_proj, .post_attention_layernorm, .mlp.{gate,up,down}_proj,
# model.norm, lm_head) to the GGUF tensor name that carries that weight.
# `resolve` resolves a canonical name to the manifest descriptor (canonical
# name, GGUF name, shape, GGML type, layout). Both fail closed with typed
# LlamaError rows on: unknown canonical names (UnknownCanonicalName),
# layer indices outside the frozen layer range (LayerOutOfRange), a required
# GGUF tensor absent from the manifest (MissingTensor), and an unknown GGML
# layout (UnknownLayout). The tied `lm_head` resolves to the shared embedding
# tensor; an untied row resolves to `output.weight`. The adapter retains no
# path, reader, source function, or payload.

import from "gradus:model/gguf_manifest" gguf_manifest

@ public { }
union LlamaError {
    UnknownCanonicalName {
        string message
    },
    LayerOutOfRange {
        string message
    },
    MissingTensor {
        string message
    },
    UnknownLayout {
        string message
    }
}

@ public { }
fn message(LlamaError e) → string {
    match e {
        case UnknownCanonicalName const message {
            return message
        }
        case LayerOutOfRange const message {
            return message
        }
        case MissingTensor const message {
            return message
        }
        case UnknownLayout const message {
            return message
        }
    }
}

# Frozen llama architecture config. `head_dimension` is the per-head dim;
# the KV projection width is kv_heads × head_dimension. `tied_embeddings`
# records tied embeddings (lm_head shares model.embed_tokens).

@ public { }
class LlamaArch {
    string name
    int layers
    int heads
    int kv_heads
    int head_dim
    int hidden_dim
    int vocab
    bool tied
}

# One resolved canonical descriptor: the canonical name, the GGUF tensor name
# that carries it, and the manifest-derived facts (shape, GGML type id,
# layout).

@ public { }
class CanonicalDescriptor {
    string canonical_name
    string gguf_name
    list<int> shape
    int dtype_ggml
    gguf_manifest.GgmlLayout layout
}

# Frozen SmolLM2-360M row config. Facts are the read-only A1b inspect-surface
# pins: general.architecture `llama`, llama.block_count 32,
# llama.embedding_length 960, llama.attention.head_count 15,
# llama.attention.head_count_kv 5, llama.vocab_size 49152, tied embeddings
# (no `output.weight` row in the manifest).
@ public { }
fn smollm2_arch() → LlamaArch {
    return LlamaArch {name = "SmolLM2-360M", layers = 32, heads = 15, kv_heads = 5, head_dim = 64, hidden_dim = 960, vocab = 49152, tied = true}
}

# Deterministic layout knownness render ("known"/"unknown"). The module owns
# the imported-union discrimination so proba/exempla consumers never match
# GgmlLayout variants directly.
@ public { }
fn layout_note(gguf_manifest.GgmlLayout l) → string {
    match l {
        case gguf_manifest.Known const elements_per_block, bytes_per_block, byte_length {
            return "known"
        }
        case gguf_manifest.Unknown const kind {
            return "unknown"
        }
    }
}

# Canonical tensor name → GGUF tensor name. Layer-indexed canonical families
# take the layer index as `layer`; it must be within the frozen layer range
# [0, layers). Unknown canonical names fail closed as UnknownCanonicalName.
@ public { }
fn gguf_name(LlamaArch a, string canonical, int layer) → string ⇥ LlamaError {
    if canonical ≡ "model.embed_tokens" then return "token_embd.weight"
    if canonical ≡ "model.norm" then return "output_norm.weight"
    if canonical ≡ "lm_head" {
        if a.tied then return "token_embd.weight"
        return "output.weight"
    }
    if layer ≺ 0 or layer ≥ a.layers {
        throw variant LayerOutOfRange {message = "layer index outside the frozen llama layer range: " + (layer ↦ string)}
    }
    if canonical ≡ "model.layers.input_layernorm" then return ("blk." + (layer ↦ string)) + ".attn_norm.weight"
    if canonical ≡ "model.layers.self_attn.q_proj" then return ("blk." + (layer ↦ string)) + ".attn_q.weight"
    if canonical ≡ "model.layers.self_attn.k_proj" then return ("blk." + (layer ↦ string)) + ".attn_k.weight"
    if canonical ≡ "model.layers.self_attn.v_proj" then return ("blk." + (layer ↦ string)) + ".attn_v.weight"
    if canonical ≡ "model.layers.self_attn.o_proj" then return ("blk." + (layer ↦ string)) + ".attn_output.weight"
    if canonical ≡ "model.layers.post_attention_layernorm" then return ("blk." + (layer ↦ string)) + ".ffn_norm.weight"
    if canonical ≡ "model.layers.mlp.gate_proj" then return ("blk." + (layer ↦ string)) + ".ffn_gate.weight"
    if canonical ≡ "model.layers.mlp.up_proj" then return ("blk." + (layer ↦ string)) + ".ffn_up.weight"
    if canonical ≡ "model.layers.mlp.down_proj" then return ("blk." + (layer ↦ string)) + ".ffn_down.weight"
    throw variant UnknownCanonicalName {message = "unknown canonical tensor name: " + canonical}
}

# Descriptor lookup for the resolve. find_tensor only raises BadWire;
# a canonical target missing from the manifest fails closed as MissingTensor.
@ private { }
fn _description(gguf_manifest.GgufManifest m, string name) → gguf_manifest.GgufTensorDescriptor ⇥ LlamaError {
    do {
        return gguf_manifest.find_tensor(m, name)
    }
    catch err {
        match err {
            case gguf_manifest.BadWire const message {
                throw variant MissingTensor {message = "canonical tensor is absent from the manifest: " + name}
            }
            case _ {
                throw variant MissingTensor {message = "canonical tensor resolution failed: " + name}
            }
        }
    }
}

# Resolve one canonical name to its manifest descriptor. The GGUF tensor that
# carries the weight must exist in the manifest (MissingTensor when absent) and
# its layout must be known (UnknownLayout when not); the returned descriptor
# carries the manifest-derived name, shape, GGML type, and layout.
@ public { }
fn resolve(gguf_manifest.GgufManifest m, LlamaArch a, string canonical, int layer) → CanonicalDescriptor ⇥ LlamaError {
    const string resolved ← gguf_name(a, canonical, layer)
    const gguf_manifest.GgufTensorDescriptor t ← _description(m, resolved)
    match t.layout {
        case gguf_manifest.Unknown const kind {
            throw variant UnknownLayout {message = "canonical tensor resolves to an unknown GGML layout: " + resolved}
        }
        case gguf_manifest.Known const elements_per_block, bytes_per_block, byte_length {
            return CanonicalDescriptor {canonical_name = canonical, gguf_name = t.name, shape = t.shape, dtype_ggml = t.dtype_ggml, layout = t.layout}
        }
    }
}
