+++
locale = "la"
+++
# Typed `llama` (SmolLM2) architecture adapter (REF-01-U1.6).
#
# Public import: importa ex "gradus:model/dense_llama" dense_llama
# Depends on: gradus:model/gguf_manifest (manifest + DescriptioTensorisGguf
#   range seam), the GGUF-A1b inspect surface facts for the real
#   SmolLM2-360M-Instruct-Q4_K_M.gguf file (read-only pinned facts, recorded
#   in the proba; no artifact bytes are committed).
#
# The adapter is a typed canonical tensor-name → manifest-descriptor mapping
# for the llama architecture family. `ars_smollm2` is the frozen
# SmolLM2-360M architecture config (32 layers, 15 heads, 5 KV heads, head_dim
# 64, hidden 960, vocab 49152, tied embedding). `nomen_gguf` maps a canonical
# name (model.embed_tokens, model.layers.{N}.input_layernorm,
# .self_attn.{q,k,v,o}_proj, .post_attention_layernorm, .mlp.{gate,up,down}_proj,
# model.norm, lm_head) to the GGUF tensor name that carries that weight.
# `resolvo` resolves a canonical name to the manifest descriptor (canonical
# name, GGUF name, shape, GGML type, layout). Both fail closed with typed
# DensumLlamaError rows on: unknown canonical names (NomenCanonicumIgnotum),
# layer indices outside the frozen layer range (StrataExcessiva), a required
# GGUF tensor absent from the manifest (TensorDeest), and an unknown GGML
# layout (LayoutIgnota). The tied `lm_head` resolves to the shared embedding
# tensor; an untied row resolves to `output.weight`. The adapter retains no
# path, reader, source function, or payload.

importa ex "gradus:model/gguf_manifest" manifestum

@ publica
discretio DensumLlamaError {
    NomenCanonicumIgnotum { textus causa }
    StrataExcessiva { textus causa }
    TensorDeest { textus causa }
    LayoutIgnota { textus causa }
}

@ publica
functio causa(DensumLlamaError e) → textus {
    discerne e {
        casu NomenCanonicumIgnotum fixum causa { redde causa }
        casu StrataExcessiva fixum causa { redde causa }
        casu TensorDeest fixum causa { redde causa }
        casu LayoutIgnota fixum causa { redde causa }
    }
}

# Frozen llama architecture config. `dimensio_capitis` is the per-head dim;
# the KV projection width is capita_kv × dimensio_capitis. `nexa_immortalia`
# records tied embeddings (lm_head shares model.embed_tokens).
@ publica
genus ArsLlama {
    textus nomen
    numerus strata
    numerus capita
    numerus capita_kv
    numerus dimensio_capitis
    numerus dimensio_occulta
    numerus vocabularia
    bivalens nexa_immortalia
}

# One resolved canonical descriptor: the canonical name, the GGUF tensor name
# that carries it, and the manifest-derived facts (shape, GGML type id,
# layout).
@ publica
genus DescriptioCanonica {
    textus nomen_canonicum
    textus nomen_gguf
    lista<numerus> forma
    numerus typo_ggml
    manifestum.LayoutGgml layout
}

# Frozen SmolLM2-360M row config. Facts are the read-only A1b inspect-surface
# pins: general.architecture `llama`, llama.block_count 32,
# llama.embedding_length 960, llama.attention.head_count 15,
# llama.attention.head_count_kv 5, llama.vocab_size 49152, tied embeddings
# (no `output.weight` row in the manifest).
@ publica
functio ars_smollm2() → ArsLlama {
    redde ArsLlama {
        nomen = "SmolLM2-360M",
        strata = 32,
        capita = 15,
        capita_kv = 5,
        dimensio_capitis = 64,
        dimensio_occulta = 960,
        vocabularia = 49152,
        nexa_immortalia = verum
    }
}

# Deterministic layout knownness render ("known"/"unknown"). The module owns
# the imported-union discrimination so proba/exempla consumers never match
# LayoutGgml variants directly.
@ publica
functio layout_nota(manifestum.LayoutGgml l) → textus {
    discerne l {
        casu Cognita fixum elementa_per_blockum, octeti_per_blockum, longitudo_octetorum { redde "known" }
        casu Ignota fixum typo { redde "unknown" }
    }
}

# Canonical tensor name → GGUF tensor name. Layer-indexed canonical families
# take the layer index as `stratum`; it must be within the frozen layer range
# [0, strata). Unknown canonical names fail closed as NomenCanonicumIgnotum.
@ publica
functio nomen_gguf(ArsLlama a, textus canonicum, numerus stratum) → textus ⇥ DensumLlamaError {
    si canonicum ≡ "model.embed_tokens" ergo redde "token_embd.weight"
    si canonicum ≡ "model.norm" ergo redde "output_norm.weight"
    si canonicum ≡ "lm_head" {
        si a.nexa_immortalia ergo redde "token_embd.weight"
        redde "output.weight"
    }
    si stratum < 0 aut stratum ≥ a.strata {
        iace finge StrataExcessiva { causa = "layer index outside the frozen llama layer range: " + (stratum ↦ textus) }
    }
    si canonicum ≡ "model.layers.input_layernorm" ergo redde "blk." + (stratum ↦ textus) + ".attn_norm.weight"
    si canonicum ≡ "model.layers.self_attn.q_proj" ergo redde "blk." + (stratum ↦ textus) + ".attn_q.weight"
    si canonicum ≡ "model.layers.self_attn.k_proj" ergo redde "blk." + (stratum ↦ textus) + ".attn_k.weight"
    si canonicum ≡ "model.layers.self_attn.v_proj" ergo redde "blk." + (stratum ↦ textus) + ".attn_v.weight"
    si canonicum ≡ "model.layers.self_attn.o_proj" ergo redde "blk." + (stratum ↦ textus) + ".attn_output.weight"
    si canonicum ≡ "model.layers.post_attention_layernorm" ergo redde "blk." + (stratum ↦ textus) + ".ffn_norm.weight"
    si canonicum ≡ "model.layers.mlp.gate_proj" ergo redde "blk." + (stratum ↦ textus) + ".ffn_gate.weight"
    si canonicum ≡ "model.layers.mlp.up_proj" ergo redde "blk." + (stratum ↦ textus) + ".ffn_up.weight"
    si canonicum ≡ "model.layers.mlp.down_proj" ergo redde "blk." + (stratum ↦ textus) + ".ffn_down.weight"
    iace finge NomenCanonicumIgnotum { causa = "unknown canonical tensor name: " + canonicum }
}

# Descriptor lookup for the resolve. inveni_tensorem only raises WireMala;
# a canonical target missing from the manifest fails closed as TensorDeest.
@ privata
functio _descriptio(manifestum.ManifestumGguf m, textus nomen) → manifestum.DescriptioTensorisGguf ⇥ DensumLlamaError {
    fac {
        redde manifestum.inveni_tensorem(m, nomen)
    }
    cape err {
        discerne err {
            casu WireMala fixum causa { iace finge TensorDeest { causa = "canonical tensor is absent from the manifest: " + nomen } }
            ceterum { iace finge TensorDeest { causa = "canonical tensor resolution failed: " + nomen } }
        }
    }
}

# Resolve one canonical name to its manifest descriptor. The GGUF tensor that
# carries the weight must exist in the manifest (TensorDeest when absent) and
# its layout must be known (LayoutIgnota when not); the returned descriptor
# carries the manifest-derived name, shape, GGML type, and layout.
@ publica
functio resolvo(manifestum.ManifestumGguf m, ArsLlama a, textus canonicum, numerus stratum) → DescriptioCanonica ⇥ DensumLlamaError {
    fixum textus gguf_nomen ← nomen_gguf(a, canonicum, stratum)
    fixum manifestum.DescriptioTensorisGguf t ← _descriptio(m, gguf_nomen)
    discerne t.layout {
        casu Ignota fixum typo {
            iace finge LayoutIgnota { causa = "canonical tensor resolves to an unknown GGML layout: " + gguf_nomen }
        }
        casu Cognita fixum elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            redde DescriptioCanonica {
                nomen_canonicum = canonicum,
                nomen_gguf = t.nomen,
                forma = t.forma,
                typo_ggml = t.typo_ggml,
                layout = t.layout
            }
        }
    }
}
