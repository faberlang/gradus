+++ toml
locale = "en"

+++ faber
# Typed `llama` (SmolLM2) architecture adapter (REF-01-U1.6).
#
# Public import: import from "gradus:model/dense_llama" dense_llama
# Depends on: gradus:model/gguf_manifest (manifest + GgufTensorDescriptor
#   range seam), the GGUF-A1b inspect surface facts for the real
#   SmolLM2-360M-Instruct-Q4_K_M.gguf file (read-only pinned facts, recorded
#   in the proba; no artifact bytes are committed).
#
# The adapter is a typed canonical tensor-name → manifest-descriptor mapping
# for the llama architecture family. `smollm2_arch` is the frozen
# SmolLM2-360M architecture config (32 layers, 15 heads, 5 KV heads, head_dim
# 64, hidden 960, vocab 49152, tied embedding). `gguf_name` maps a canonical
# name (model.embed_tokens, model.layers.{N}.input_layernorm,
# .self_attn.{q,k,v,o}_proj, .post_attention_layernorm, .mlp.{gate,up,down}_proj,
# model.norm, lm_head) to the GGUF tensor name that carries that weight.
# `resolve` resolves a canonical name to the manifest descriptor (canonical
# name, GGUF name, shape, GGML type, layout). Both fail closed with typed
# LlamaError rows on: unknown canonical names (UnknownCanonicalName),
# layer indices outside the frozen layer range (LayerOutOfRange), a required
# GGUF tensor absent from the manifest (MissingTensor), and an unknown GGML
# layout (UnknownLayout). The tied `lm_head` resolves to the shared embedding
# tensor; an untied row resolves to `output.weight`. The adapter retains no
# path, reader, source function, or payload.

import from "gradus:model/gguf_manifest"

@ public
union LlamaError {
    @ shared
    string message

    UnknownCanonicalName,
    LayerOutOfRange,
    MissingTensor,
    UnknownLayout,
    ManifestFailure {
        gguf_manifest.GgufManifestError inner
    }
}

@ conversion
fn from_gguf_manifest_error(gguf_manifest.GgufManifestError err) → LlamaError {
    return variant ManifestFailure { message = err.message, inner = err }
}

# Frozen llama architecture config. `head_dimension` is the per-head dim;
# the KV projection width is kv_heads × head_dimension. `tied_embeddings`
# records tied embeddings (lm_head shares model.embed_tokens).

@ public
class LlamaArch {
    mut string name
    mut int layers
    mut int heads
    mut int kv_heads
    mut int head_dim
    mut int hidden_dim
    mut int vocab
    mut bool tied
}

# One resolved canonical descriptor: the canonical name, the GGUF tensor name
# that carries it, and the manifest-derived facts (shape, GGML type id,
# layout).

@ public
class CanonicalDescriptor {
    mut string canonical_name
    mut string gguf_name
    mut list<int> shape
    mut int dtype_ggml
    mut gguf_manifest.GgmlLayout layout
}

# Frozen SmolLM2-360M row config. Facts are the read-only A1b inspect-surface
# pins: general.architecture `llama`, llama.block_count 32,
# llama.embedding_length 960, llama.attention.head_count 15,
# llama.attention.head_count_kv 5, llama.vocab_size 49152, tied embeddings
# (no `output.weight` row in the manifest).
@ public
fn smollm2_arch() → LlamaArch {
    return LlamaArch { name = "SmolLM2-360M", layers = 32, heads = 15, kv_heads = 5, head_dim = 64, hidden_dim = 960, vocab = 49152, tied = true }
}

# Deterministic layout knownness render ("known"/"unknown"). The module owns
# the imported-union discrimination so proba/exempla consumers never match
# GgmlLayout variants directly.
@ public
fn layout_note(gguf_manifest.GgmlLayout l) → string {
    match l {
        case gguf_manifest.GgmlLayout.Known let elements_per_block, bytes_per_block, byte_length {
            return "known"
        }
        case gguf_manifest.GgmlLayout.Unknown let kind {
            return "unknown"
        }
    }
}

# Canonical tensor name → GGUF tensor name. Layer-indexed canonical families
# take the layer index as `layer`; it must be within the frozen layer range
# [0, layers). Unknown canonical names fail closed as UnknownCanonicalName.
@ public
fn gguf_name(LlamaArch a, string canonical, int layer) → string ⇥ LlamaError {
    switch canonical {
        case "model.embed_tokens" {
            return "token_embd.weight"
        }
        case "model.norm" {
            return "output_norm.weight"
        }
        case "lm_head" {
            if a.tied then return "token_embd.weight"

            return "output.weight"
        }
        default {
        }
    }

    reject layer ≺ 0 or layer ≥ a.layers throw variant LayerOutOfRange { message = "layer index outside the frozen llama layer range: §"(layer ↦ string) }

    switch canonical {
        case "model.layers.input_layernorm" {
            return "blk.§.attn_norm.weight"(layer ↦ string)
        }
        case "model.layers.self_attn.q_proj" {
            return "blk.§.attn_q.weight"(layer ↦ string)
        }
        case "model.layers.self_attn.k_proj" {
            return "blk.§.attn_k.weight"(layer ↦ string)
        }
        case "model.layers.self_attn.v_proj" {
            return "blk.§.attn_v.weight"(layer ↦ string)
        }
        case "model.layers.self_attn.o_proj" {
            return "blk.§.attn_output.weight"(layer ↦ string)
        }
        case "model.layers.post_attention_layernorm" {
            return "blk.§.ffn_norm.weight"(layer ↦ string)
        }
        case "model.layers.mlp.gate_proj" {
            return "blk.§.ffn_gate.weight"(layer ↦ string)
        }
        case "model.layers.mlp.up_proj" {
            return "blk.§.ffn_up.weight"(layer ↦ string)
        }
        case "model.layers.mlp.down_proj" {
            return "blk.§.ffn_down.weight"(layer ↦ string)
        }
        default {
            throw variant UnknownCanonicalName { message = "unknown canonical tensor name: §"(canonical) }
        }
    }
}

# Descriptor lookup for the resolve. find_tensor raises NotFound when the
# name is absent; a canonical target missing from the manifest fails closed
# as MissingTensor.
fn description(gguf_manifest.GgufManifest m, string name) → gguf_manifest.GgufTensorDescriptor ⇥ LlamaError {
    do {
        return gguf_manifest.find_tensor(m, name)
    }
    catch err {
        match err {
            case gguf_manifest.GgufManifestError.NotFound let message {
                throw variant MissingTensor { message = "canonical tensor is absent from the manifest: §"(name) }
            }
            case _ {
                throw variant ManifestFailure { message = err.message, inner = err }
            }
        }
    }
}

# Resolve one canonical name to its manifest descriptor. The GGUF tensor that
# carries the weight must exist in the manifest (MissingTensor when absent) and
# its layout must be known (UnknownLayout when not); the returned descriptor
# carries the manifest-derived name, shape, GGML type, and layout.
@ public
fn resolve(gguf_manifest.GgufManifest m, LlamaArch a, string canonical, int layer) → CanonicalDescriptor ⇥ LlamaError {
    let string resolved ← gguf_name(a, canonical, layer)
    let gguf_manifest.GgufTensorDescriptor t ← description(m, resolved)

    match t.layout {
        case gguf_manifest.GgmlLayout.Unknown let kind {
            throw variant UnknownLayout { message = "canonical tensor resolves to an unknown GGML layout: §"(resolved) }
        }
        case gguf_manifest.GgmlLayout.Known let elements_per_block, bytes_per_block, byte_length {
            return CanonicalDescriptor { canonical_name = canonical, gguf_name = t.name, shape = t.shape, dtype_ggml = t.dtype_ggml, layout = t.layout }
        }
    }
}

+++ faber test
# Co-located package test for dense_llama.fab (REF-01-U1.6 — typed `llama`
# architecture adapter).
# Not importable; discovered only by the faber test path.
#
# Pins, at compile level: (a) the frozen SmolLM2-360M architecture config
# facts (32 layers, 15 heads, 5 KV heads, head_dim 64, hidden 960, vocab
# 49152, tied embedding); (b) every canonical tensor name resolves against a
# synthetic manifest carrying the exact descriptor facts the GGUF-A1b inspect
# surface reports for the real SmolLM2-360M-Instruct-Q4_K_M.gguf file
# (read-only pinned facts — shapes, GGML types, and known layouts below were
# measured from the real file's manifest on 2026-08-14; no artifact bytes are
# committed); (c) fail-closed rejection rows: unknown canonical names,
# out-of-range layer indices, a canonical tensor absent from the manifest,
# and an unknown GGML layout all produce typed LlamaError renders.
#
# Imported-union variant construction (GgmlLayout/LlamaArch/CanonicalDescriptor
# values from an imported module) is blocked by the pinned compiler defect
# (SEM001+SEM008), so the fail-closed rows flow through the module's own
# error channel; assert assertions run under the cargo-backed `faber test`
# harness (auditor-owned), while `faber check` proves the whole surface
# type-checks. The executable proof lives in exempla/dense-llama-adapter.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" gguf_manifest

import from "gradus:model/dense_llama" dense_llama

const string F_DIGEST = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn u32(int n) → list<u8> {
    return [(n % 256) ↦ u8, ((n ⇒ 8) % 256) ↦ u8, ((n ⇒ 16) % 256) ↦ u8, ((n ⇒ 24) % 256) ↦ u8]
}

fn u64(int n) → list<u8> {
    return [(n % 256) ↦ u8, ((n ⇒ 8) % 256) ↦ u8, ((n ⇒ 16) % 256) ↦ u8, ((n ⇒ 24) % 256) ↦ u8, ((n ⇒ 32) % 256) ↦ u8, ((n ⇒ 40) % 256) ↦ u8, ((n ⇒ 48) % 256) ↦ u8, ((n ⇒ 56) % 256) ↦ u8]
}

fn join(list<u8> a, list<u8> b) → list<u8> {
    mut list<u8> out ← empty
    for from a let x {
        out.append(x)
    }
    for from b let x {
        out.append(x)
    }
    return out
}

fn text_bytes(string s) → list<u8> {
    # Package MIR has no text→bytes extraction arm. This structural
    # builder only needs a finite ASCII corpus, so keep its encoding explicit.
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_norm.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_q.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_k.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 107, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_v.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 118, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_output.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_norm.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_gate.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 103, 97, 116, 101, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_up.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 117, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_down.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 100, 111, 119, 110, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "output_norm.weight" then return [111, 117, 116, 112, 117, 116, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.31.attn_norm.weight" then return [98, 108, 107, 46, 51, 49, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.experts.0.weight" then return [98, 108, 107, 46, 48, 46, 101, 120, 112, 101, 114, 116, 115, 46, 48, 46, 119, 101, 105, 103, 104, 116]
    return []
}

fn str(string s) → list<u8> {
    let list<u8> b ← text_bytes(s)
    return join(u64(b.length()), b)
}

fn tensor_row(string name, list<int> shape, int kind, int offset) → list<u8> {
    mut list<u8> out ← join(str(name), u32(shape.length()))
    for from shape let dim {
        out ← join(out, u64(dim))
    }
    return join(join(out, u32(kind)), u64(offset))
}

fn header(int tensors, int metadata) → list<u8> {
    return join(join([71, 71, 85, 70], u32(3)), join(u64(tensors), u64(metadata)))
}

fn with_padding(list<u8> table, int alignment, int total) → gguf_manifest.GgufCorpus {
    let int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    mut list<u8> b ← empty
    for from table let x {
        b.append(x)
    }
    while b.length() ≺ data_offset {
        b.append(0 ∷ u8)
    }
    let list<b8> o ↤ b
    return gguf_manifest.GgufCorpus {table = o, artifact_length = total, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = total}}
}

# SmolLM2-360M scaled descriptor corpus: the twelve real GGUF tensor rows the
# A1b inspect surface reports for SmolLM2-360M-Instruct-Q4_K_M.gguf (shapes,
# GGML type ids, and known layouts are the read-only pinned facts; offsets
# and total are structural filler, never pinned). `output.weight` is absent —
# the real row has tied embeddings. blk.0 and blk.31 rows carry the
# layer-boundary facts. Layouts: F32 1-el/4B, Q5_0 32-el/22B, Q8_0 32-el/34B,
# Q6_K 256-el/210B. Data section starts at 736; total 57,351,136 (12 tensors,
# 57,350,400 payload bytes).
fn corpus_smollm2() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(12, 0)
    table ← join(table, tensor_row("token_embd.weight", [960, 49152], 8, 0))
    table ← join(table, tensor_row("blk.0.attn_norm.weight", [960], 0, 50135040))
    table ← join(table, tensor_row("blk.0.attn_q.weight", [960, 960], 6, 50138880))
    table ← join(table, tensor_row("blk.0.attn_k.weight", [960, 320], 6, 50772480))
    table ← join(table, tensor_row("blk.0.attn_v.weight", [960, 320], 8, 50983680))
    table ← join(table, tensor_row("blk.0.attn_output.weight", [960, 960], 6, 51310080))
    table ← join(table, tensor_row("blk.0.ffn_norm.weight", [960], 0, 51943680))
    table ← join(table, tensor_row("blk.0.ffn_gate.weight", [960, 2560], 6, 51947520))
    table ← join(table, tensor_row("blk.0.ffn_up.weight", [960, 2560], 6, 53637120))
    table ← join(table, tensor_row("blk.0.ffn_down.weight", [2560, 960], 14, 55326720))
    table ← join(table, tensor_row("output_norm.weight", [960], 0, 57342720))
    table ← join(table, tensor_row("blk.31.attn_norm.weight", [960], 0, 57346560))
    return with_padding(table, 32, 57351136)
}

# Same corpus minus output_norm.weight — the MissingTensor rejection row.
fn corpus_sine_norm() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(10, 0)
    table ← join(table, tensor_row("token_embd.weight", [960, 49152], 8, 0))
    table ← join(table, tensor_row("blk.0.attn_norm.weight", [960], 0, 50135040))
    table ← join(table, tensor_row("blk.0.attn_q.weight", [960, 960], 6, 50138880))
    table ← join(table, tensor_row("blk.0.attn_k.weight", [960, 320], 6, 50772480))
    table ← join(table, tensor_row("blk.0.attn_v.weight", [960, 320], 8, 50983680))
    table ← join(table, tensor_row("blk.0.attn_output.weight", [960, 960], 6, 51310080))
    table ← join(table, tensor_row("blk.0.ffn_norm.weight", [960], 0, 51943680))
    table ← join(table, tensor_row("blk.0.ffn_gate.weight", [960, 2560], 6, 51947520))
    table ← join(table, tensor_row("blk.0.ffn_up.weight", [960, 2560], 6, 53637120))
    table ← join(table, tensor_row("blk.0.ffn_down.weight", [2560, 960], 14, 55326720))
    return with_padding(table, 32, 57343392)
}

# Unknown-layout corpus: a canonical target carrying an unlisted GGML type id
# (999) — the UnknownLayout rejection row. Data section at 96, total 96.
fn corpus_unknown_layout() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(1, 0)
    table ← join(table, tensor_row("blk.0.ffn_gate.weight", [960, 2560], 999, 0))
    return with_padding(table, 32, 96)
}

fn layout_txt(gguf_manifest.GgmlLayout l) → string {
    return dense_llama.layout_note(l)
}

fn shape(list<int> f) → string {
    mut string out ← "["
    for range 0‥f.length() let i {
        out ← out + (f.get(i) coalesce 0 ↦ string)
        if i + 1 ≺ f.length() {
            out ← out + ","
        }
    }
    return out + "]"
}

# Render one canonical resolution as "canonical/gguf/shape/layout" or the
# typed LlamaError render.
fn description(gguf_manifest.GgufCorpus corpus, string canonical, int layer) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            let dense_llama.CanonicalDescriptor d ← dense_llama.resolve(m, dense_llama.smollm2_arch(), canonical, layer)
            return (((((d.canonical_name + "/") + d.gguf_name) + "/") + shape(d.shape)) + "/") + layout_txt(d.layout)
        }
        catch err {
            return "ERR:§"(err.message)
        }
    }
    catch err {
        return "ERR:§"(err.message)
    }
}

# Render one canonical-name mapping as the GGUF tensor name or the typed
# LlamaError render.
fn name(string canonical, int layer) → string {
    do {
        return dense_llama.gguf_name(dense_llama.smollm2_arch(), canonical, layer)
    }
    catch err {
        return "ERR:§"(err.message)
    }
}

# Render the frozen architecture config as a single facts line.
fn arch() → string {
    let dense_llama.LlamaArch a ← dense_llama.smollm2_arch()
    return (((((((((((((a.name + "/") + (a.layers ↦ string)) + "/") + (a.heads ↦ string)) + "/") + (a.kv_heads ↦ string)) + "/") + (a.head_dim ↦ string)) + "/") + (a.hidden_dim ↦ string)) + "/") + (a.vocab ↦ string)) + "/") + (a.tied ↦ string)
}

test "frozen SmolLM2-360M architecture config facts" {
    assert arch() ≡ "SmolLM2-360M/32/15/5/64/960/49152/true"
}

test "every canonical name resolves to the exact pinned descriptor facts" {
    assert description(corpus_smollm2(), "model.embed_tokens", 0) ≡ "model.embed_tokens/token_embd.weight/[960,49152]/known"
    assert description(corpus_smollm2(), "model.layers.input_layernorm", 0) ≡ "model.layers.input_layernorm/blk.0.attn_norm.weight/[960]/known"
    assert description(corpus_smollm2(), "model.layers.self_attn.q_proj", 0) ≡ "model.layers.self_attn.q_proj/blk.0.attn_q.weight/[960,960]/known"
    assert description(corpus_smollm2(), "model.layers.self_attn.k_proj", 0) ≡ "model.layers.self_attn.k_proj/blk.0.attn_k.weight/[960,320]/known"
    assert description(corpus_smollm2(), "model.layers.self_attn.v_proj", 0) ≡ "model.layers.self_attn.v_proj/blk.0.attn_v.weight/[960,320]/known"
    assert description(corpus_smollm2(), "model.layers.self_attn.o_proj", 0) ≡ "model.layers.self_attn.o_proj/blk.0.attn_output.weight/[960,960]/known"
    assert description(corpus_smollm2(), "model.layers.post_attention_layernorm", 0) ≡ "model.layers.post_attention_layernorm/blk.0.ffn_norm.weight/[960]/known"
    assert description(corpus_smollm2(), "model.layers.mlp.gate_proj", 0) ≡ "model.layers.mlp.gate_proj/blk.0.ffn_gate.weight/[960,2560]/known"
    assert description(corpus_smollm2(), "model.layers.mlp.up_proj", 0) ≡ "model.layers.mlp.up_proj/blk.0.ffn_up.weight/[960,2560]/known"
    assert description(corpus_smollm2(), "model.layers.mlp.down_proj", 0) ≡ "model.layers.mlp.down_proj/blk.0.ffn_down.weight/[2560,960]/known"
    assert description(corpus_smollm2(), "model.norm", 0) ≡ "model.norm/output_norm.weight/[960]/known"
    assert description(corpus_smollm2(), "lm_head", 0) ≡ "lm_head/token_embd.weight/[960,49152]/known"
}

test "layer-index boundary resolves against the frozen layer count" {
    assert description(corpus_smollm2(), "model.layers.input_layernorm", 31) ≡ "model.layers.input_layernorm/blk.31.attn_norm.weight/[960]/known"
}

test "unknown canonical names fail closed as UnknownCanonicalName" {
    assert name("model.layers.mlp.silu_proj", 0) ≡ "ERR:unknown canonical tensor name: model.layers.mlp.silu_proj"
    assert name("model.layers", 0) ≡ "ERR:unknown canonical tensor name: model.layers"
}

test "out-of-range layer indices fail closed as LayerOutOfRange" {
    assert name("model.layers.input_layernorm", 32) ≡ "ERR:layer index outside the frozen llama layer range: 32"
    assert name("model.layers.input_layernorm", -1) ≡ "ERR:layer index outside the frozen llama layer range: -1"
}

test "a canonical tensor absent from the manifest fails closed as MissingTensor" {
    assert description(corpus_sine_norm(), "model.norm", 0) ≡ "ERR:canonical tensor is absent from the manifest: output_norm.weight"
}

test "an unknown GGML layout fails closed as UnknownLayout" {
    assert description(corpus_unknown_layout(), "model.layers.mlp.gate_proj", 0) ≡ "ERR:canonical tensor resolves to an unknown GGML layout: blk.0.ffn_gate.weight"
}
