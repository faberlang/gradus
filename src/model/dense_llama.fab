+++
locale = "en"
+++
# Typed `llama` (SmolLM2) architecture adapter (REF-01-U1.6).
#
# Public import: importa ex "gradus:model/dense_llama" dense_llama
# Depends on: gradus:model/gguf_manifest (manifest + DescriptioTensorisGguf
#   range seam), the GGUF-A1b inspect surface facts for the real
#   SmolLM2-360M-Instruct-Q4_K_M.gguf file (read-only pinned facts, recorded
#   in the proba; no artifact bytes are committed).
#
# The adapter is a typed canonical tensor-name → manifest-descriptor mapping
# for the llama architecture family. `ars_smollm2` is the frozen
# SmolLM2-360M architecture config (32 layers, 15 heads, 5 KV heads, head_dim
# 64, hidden 960, vocab 49152, tied embedding). `nomen_gguf` maps a canonical
# name (model.embed_tokens, model.layers.{N}.input_layernorm,
# .self_attn.{q,k,v,o}_proj, .post_attention_layernorm, .mlp.{gate,up,down}_proj,
# model.norm, lm_head) to the GGUF tensor name that carries that weight.
# `resolvo` resolves a canonical name to the manifest descriptor (canonical
# name, GGUF name, shape, GGML type, layout). Both fail closed with typed
# DensumLlamaError rows on: unknown canonical names (NomenCanonicumIgnotum),
# layer indices outside the frozen layer range (StrataExcessiva), a required
# GGUF tensor absent from the manifest (TensorDeest), and an unknown GGML
# layout (LayoutIgnota). The tied `lm_head` resolves to the shared embedding
# tensor; an untied row resolves to `output.weight`. The adapter retains no
# path, reader, source function, or payload.

import from "gradus:model/gguf_manifest" manifestum

@ public { }
union LlamaError {
    NomenCanonicumIgnotum {
        string message
    },
    StrataExcessiva {
        string message
    },
    TensorDeest {
        string message
    },
    LayoutIgnota {
        string message
    }
}

@ public { }
fn message(LlamaError e) → string {
    match e {
        case NomenCanonicumIgnotum const causa {
            return causa
        }
        case StrataExcessiva const causa {
            return causa
        }
        case TensorDeest const causa {
            return causa
        }
        case LayoutIgnota const causa {
            return causa
        }
    }
}

# Frozen llama architecture config. `dimensio_capitis` is the per-head dim;
# the KV projection width is capita_kv × dimensio_capitis. `nexa_immortalia`
# records tied embeddings (lm_head shares model.embed_tokens).

@ public { }
class LlamaArch {
    string name
    int layers
    int heads
    int kv_heads
    int head_dim
    int hidden_dim
    int vocab
    bool tied
}

# One resolved canonical descriptor: the canonical name, the GGUF tensor name
# that carries it, and the manifest-derived facts (shape, GGML type id,
# layout).

@ public { }
class CanonicalDescriptor {
    string nomen_canonicum
    string gguf_name
    list<int> shape
    int dtype_ggml
    manifestum.GgmlLayout layout
}

# Frozen SmolLM2-360M row config. Facts are the read-only A1b inspect-surface
# pins: general.architecture `llama`, llama.block_count 32,
# llama.embedding_length 960, llama.attention.head_count 15,
# llama.attention.head_count_kv 5, llama.vocab_size 49152, tied embeddings
# (no `output.weight` row in the manifest).
@ public { }
fn smollm2_arch() → LlamaArch {
    return LlamaArch {name = "SmolLM2-360M", layers = 32, heads = 15, kv_heads = 5, head_dim = 64, hidden_dim = 960, vocab = 49152, tied = true}
}

# Deterministic layout knownness render ("known"/"unknown"). The module owns
# the imported-union discrimination so proba/exempla consumers never match
# LayoutGgml variants directly.
@ public { }
fn layout_note(manifestum.GgmlLayout l) → string {
    match l {
        case manifestum.Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            return "known"
        }
        case manifestum.Ignota const typo {
            return "unknown"
        }
    }
}

# Canonical tensor name → GGUF tensor name. Layer-indexed canonical families
# take the layer index as `stratum`; it must be within the frozen layer range
# [0, strata). Unknown canonical names fail closed as NomenCanonicumIgnotum.
@ public { }
fn gguf_name(LlamaArch a, string canonicum, int stratum) → string ⇥ LlamaError {
    if canonicum ≡ "model.embed_tokens" then return "token_embd.weight"
    if canonicum ≡ "model.norm" then return "output_norm.weight"
    if canonicum ≡ "lm_head" {
        if a.tied then return "token_embd.weight"
        return "output.weight"
    }
    if stratum ≺ 0 or stratum ≥ a.layers {
        throw variant StrataExcessiva {message = "layer index outside the frozen llama layer range: " + (stratum ↦ string)}
    }
    if canonicum ≡ "model.layers.input_layernorm" then return ("blk." + (stratum ↦ string)) + ".attn_norm.weight"
    if canonicum ≡ "model.layers.self_attn.q_proj" then return ("blk." + (stratum ↦ string)) + ".attn_q.weight"
    if canonicum ≡ "model.layers.self_attn.k_proj" then return ("blk." + (stratum ↦ string)) + ".attn_k.weight"
    if canonicum ≡ "model.layers.self_attn.v_proj" then return ("blk." + (stratum ↦ string)) + ".attn_v.weight"
    if canonicum ≡ "model.layers.self_attn.o_proj" then return ("blk." + (stratum ↦ string)) + ".attn_output.weight"
    if canonicum ≡ "model.layers.post_attention_layernorm" then return ("blk." + (stratum ↦ string)) + ".ffn_norm.weight"
    if canonicum ≡ "model.layers.mlp.gate_proj" then return ("blk." + (stratum ↦ string)) + ".ffn_gate.weight"
    if canonicum ≡ "model.layers.mlp.up_proj" then return ("blk." + (stratum ↦ string)) + ".ffn_up.weight"
    if canonicum ≡ "model.layers.mlp.down_proj" then return ("blk." + (stratum ↦ string)) + ".ffn_down.weight"
    throw variant NomenCanonicumIgnotum {message = "unknown canonical tensor name: " + canonicum}
}

# Descriptor lookup for the resolve. inveni_tensorem only raises WireMala;
# a canonical target missing from the manifest fails closed as TensorDeest.
@ private { }
fn _description(manifestum.GgufManifest m, string nomen) → manifestum.GgufTensorDescriptor ⇥ LlamaError {
    do {
        return manifestum.inveni_tensorem(m, nomen)
    }
    catch err {
        match err {
            case manifestum.WireMala const causa {
                throw variant TensorDeest {message = "canonical tensor is absent from the manifest: " + nomen}
            }
            case _ {
                throw variant TensorDeest {message = "canonical tensor resolution failed: " + nomen}
            }
        }
    }
}

# Resolve one canonical name to its manifest descriptor. The GGUF tensor that
# carries the weight must exist in the manifest (TensorDeest when absent) and
# its layout must be known (LayoutIgnota when not); the returned descriptor
# carries the manifest-derived name, shape, GGML type, and layout.
@ public { }
fn resolve(manifestum.GgufManifest m, LlamaArch a, string canonicum, int stratum) → CanonicalDescriptor ⇥ LlamaError {
    const string gguf_nomen ← gguf_name(a, canonicum, stratum)
    const manifestum.GgufTensorDescriptor t ← _description(m, gguf_nomen)
    match t.layout {
        case manifestum.Ignota const typo {
            throw variant LayoutIgnota {message = "canonical tensor resolves to an unknown GGML layout: " + gguf_nomen}
        }
        case manifestum.Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            return CanonicalDescriptor {nomen_canonicum = canonicum, gguf_name = t.name, shape = t.shape, dtype_ggml = t.dtype_ggml, layout = t.layout}
        }
    }
}
