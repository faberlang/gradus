# GGUF-A1a red proof: format-general manifest symbols are intentionally
# referenced before their implementation exists. On 2026-08-12 the focused
# command `faber check --diagnostics src/model/gguf_manifest.proba` exited 1;
# its first divergence was SEM002:unknown_qualified_type at
# `manifestum.LayoutGgml`.

importa ex "gradus:model/gguf_manifest" privata manifestum

probandum "manifest red proof" {
    proba "retains an unknown GGML layout as inspectable" {
        fac {
            fixum manifestum.LayoutGgml _ ← manifestum.layout(999, [3, 2, 1])
        }
        cape err {
            adfirma falsum
        }
    }
}
