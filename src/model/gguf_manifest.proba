# GGUF-A1b manifest and range-source proof surface, plus the LIB-02-U1
# tokenizer metadata array accessors.
#
# `faber check` proves the builders, parse calls, returned-field access, and
# typed-error branches type-check. The current imported-library `faber test`
# route is provider-blocked; this file makes no executed-value claim. The
# executable package proof lives in exempla/gguf-manifest and records its own
# command/output receipt. The cases below also type-check exact wire-byte
# assertions for all thirteen metadata kinds, nested arrays, descriptor fields,
# legal range order/gaps, BOOL numerum rejection, incremental inspection,
# checked payload-fragment reads, and the tokenizer array accessors against the
# pinned target-prefix counts (248320 tokens, 247587 merges) and special ids.

importa ex "gradus:model/artifact" artifact
importa ex "gradus:model/gguf_manifest" manifestum

fixum textus F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

functio _u8(numerus n) → lista<numerus<u8>> {
    redde [(n % 256) ∷ numerus<u8>]
}

functio _u16(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>
    ]
}

functio _u32(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>,
        ((n ⇒ 16) % 256) ∷ numerus<u8>,
        ((n ⇒ 24) % 256) ∷ numerus<u8>
    ]
}

functio _u64(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>,
        ((n ⇒ 16) % 256) ∷ numerus<u8>,
        ((n ⇒ 24) % 256) ∷ numerus<u8>,
        ((n ⇒ 32) % 256) ∷ numerus<u8>,
        ((n ⇒ 40) % 256) ∷ numerus<u8>,
        ((n ⇒ 48) % 256) ∷ numerus<u8>,
        ((n ⇒ 56) % 256) ∷ numerus<u8>
    ]
}

functio _iunge(lista<numerus<u8>> a, lista<numerus<u8>> b) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    itera ex a fixum x { out.appende(x) }
    itera ex b fixum x { out.appende(x) }
    redde out
}

functio _textus_bytes(textus s) → lista<numerus<u8>> {
    # Package MIR has no textus→octeti extraction arm. This structural
    # builder only needs a finite ASCII corpus, so keep its encoding explicit.
    si s ≡ "general.architecture" ergo redde [103,101,110,101,114,97,108,46,97,114,99,104,105,116,101,99,116,117,114,101]
    si s ≡ "general.custom_note" ergo redde [103,101,110,101,114,97,108,46,99,117,115,116,111,109,95,110,111,116,101]
    si s ≡ "tokenizer.ggml.tokens" ergo redde [116,111,107,101,110,105,122,101,114,46,103,103,109,108,46,116,111,107,101,110,115]
    si s ≡ "<s>" ergo redde [60,115,62]
    si s ≡ "hello" ergo redde [104,101,108,108,111]
    si s ≡ "token_embd.weight" ergo redde [116,111,107,101,110,95,101,109,98,100,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_norm.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ "qwen2" ergo redde [113,119,101,110,50]
    si s ≡ "general.alignment" ergo redde [103,101,110,101,114,97,108,46,97,108,105,103,110,109,101,110,116]
    si s ≡ "qwen2.custom_flag" ergo redde [113,119,101,110,50,46,99,117,115,116,111,109,95,102,108,97,103]
    si s ≡ "world" ergo redde [119,111,114,108,100]
    si s ≡ "blk.0.attn_q.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,113,46,119,101,105,103,104,116]
    si s ≡ "qwen35moe" ergo redde [113,119,101,110,51,53,109,111,101]
    si s ≡ "qwen35moe.custom_flag" ergo redde [113,119,101,110,51,53,109,111,101,46,99,117,115,116,111,109,95,102,108,97,103]
    si s ≡ "blk.0.experts.0.weight" ergo redde [98,108,107,46,48,46,101,120,112,101,114,116,115,46,48,46,119,101,105,103,104,116]
    si s ≡ "bad.value" ergo redde [98,97,100,46,118,97,108,117,101]
    si s ≡ "llama" ergo redde [108,108,97,109,97]
    si s ≡ "same" ergo redde [115,97,109,101]
    si s ≡ "huge" ergo redde [104,117,103,101]
    si s ≡ "too_many" ergo redde [116,111,111,95,109,97,110,121]
    si s ≡ "scalar" ergo redde [115,99,97,108,97,114]
    si s ≡ "bad_q4k" ergo redde [98,97,100,95,113,52,107]
    si s ≡ "known" ergo redde [107,110,111,119,110]
    si s ≡ "unknown" ergo redde [117,110,107,110,111,119,110]
    si s ≡ "overflow" ergo redde [111,118,101,114,102,108,111,119]
    si s ≡ "a" ergo redde [97]
    si s ≡ "b" ergo redde [98]
    si s ≡ "wire.uint8" ergo redde [119,105,114,101,46,117,105,110,116,56]
    si s ≡ "wire.int8" ergo redde [119,105,114,101,46,105,110,116,56]
    si s ≡ "wire.uint16" ergo redde [119,105,114,101,46,117,105,110,116,49,54]
    si s ≡ "wire.int16" ergo redde [119,105,114,101,46,105,110,116,49,54]
    si s ≡ "wire.uint32" ergo redde [119,105,114,101,46,117,105,110,116,51,50]
    si s ≡ "wire.int32" ergo redde [119,105,114,101,46,105,110,116,51,50]
    si s ≡ "wire.float32" ergo redde [119,105,114,101,46,102,108,111,97,116,51,50]
    si s ≡ "wire.bool" ergo redde [119,105,114,101,46,98,111,111,108]
    si s ≡ "wire.string" ergo redde [119,105,114,101,46,115,116,114,105,110,103]
    si s ≡ "wire.array" ergo redde [119,105,114,101,46,97,114,114,97,121]
    si s ≡ "wire.nested" ergo redde [119,105,114,101,46,110,101,115,116,101,100]
    si s ≡ "wire.uint64" ergo redde [119,105,114,101,46,117,105,110,116,54,52]
    si s ≡ "wire.int64" ergo redde [119,105,114,101,46,105,110,116,54,52]
    si s ≡ "wire.float64" ergo redde [119,105,114,101,46,102,108,111,97,116,54,52]
    redde []
}

functio _str(textus s) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> b ← _textus_bytes(s)
    redde _iunge(_u64(b.longitudo()), b)
}

functio _kv(textus key, numerus typo, lista<numerus<u8>> value) → lista<numerus<u8>> {
    redde _iunge(_iunge(_str(key), _u32(typo)), value)
}

functio _array(numerus typo, numerus count, lista<numerus<u8>> value) → lista<numerus<u8>> {
    redde _iunge(_iunge(_u32(typo), _u64(count)), value)
}

functio _tensor(textus name, lista<numerus> forma, numerus typo, numerus offset) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← _iunge(_str(name), _u32(forma.longitudo()))
    itera ex forma fixum dim { out ← _iunge(out, _u64(dim)) }
    redde _iunge(_iunge(out, _u32(typo)), _u64(offset))
}

functio _caput(numerus tensorum, numerus metadata) → lista<numerus<u8>> {
    redde _iunge(
        _iunge([0x47, 0x47, 0x55, 0x46], _u32(3)),
        _iunge(_u64(tensorum), _u64(metadata))
    )
}

functio _cum_padding(lista<numerus<u8>> table, numerus concordatio, numerus total, bivalens extra_data) → manifestum.CorpusGguf {
    fixum numerus data_offset ← ((table.longitudo() + concordatio - 1) / concordatio) * concordatio
    varia lista<numerus<u8>> b ← table
    dum b.longitudo() < data_offset { b.appende(0 ∷ numerus<u8>) }
    si extra_data { b.appende(0 ∷ numerus<u8>) }
    fixum octeti o ← b
    redde manifestum.CorpusGguf {
        tabula = o,
        longitudo_artifacti = total,
        identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = total }
    }
}

functio _plenum(lista<numerus<u8>> table, numerus concordatio, numerus payload) → manifestum.CorpusGguf {
    fixum numerus data_offset ← ((table.longitudo() + concordatio - 1) / concordatio) * concordatio
    redde _cum_padding(table, concordatio, data_offset + payload, falsum)
}

functio _wire_aequa(octeti actual, lista<numerus<u8>> expectata) → bivalens {
    si actual.longitudo() ≠ expectata.longitudo() ergo redde falsum
    varia numerus i ← 0
    dum i < expectata.longitudo() {
        si (actual.accipe(i) vel (0 ∷ numerus<u8>)) ≠ (expectata.accipe(i) vel (0 ∷ numerus<u8>)) ergo redde falsum
        i ↑
    }
    redde verum
}

functio _metadata_corpus() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 14)
    table ← _iunge(table, _kv("wire.uint8", 0, _u8(127)))
    table ← _iunge(table, _kv("wire.int8", 1, _u8(254)))
    table ← _iunge(table, _kv("wire.uint16", 2, _u16(4660)))
    table ← _iunge(table, _kv("wire.int16", 3, _u16(65534)))
    table ← _iunge(table, _kv("wire.uint32", 4, _u32(305419896)))
    table ← _iunge(table, _kv("wire.int32", 5, _u32(4294967294)))
    table ← _iunge(table, _kv("wire.float32", 6, [0, 0, 128, 63]))
    table ← _iunge(table, _kv("wire.bool", 7, _u8(1)))
    table ← _iunge(table, _kv("wire.string", 8, _str("hello")))
    table ← _iunge(table, _kv("wire.array", 9, _array(2, 2, _iunge(_u16(4660), _u16(43981)))))
    table ← _iunge(table, _kv("wire.nested", 9, _array(9, 1, _array(0, 2, [7, 8]))))
    table ← _iunge(table, _kv("wire.uint64", 10, _u64(72623859790382856)))
    table ← _iunge(table, _kv("wire.int64", 11, [254, 255, 255, 255, 255, 255, 255, 255]))
    table ← _iunge(table, _kv("wire.float64", 12, [0, 0, 0, 0, 0, 0, 240, 63]))
    redde _plenum(table, 32, 0)
}

functio _numerum_observa(manifestum.ManifestumGguf m, textus clavis) → textus {
    fac {
        redde manifestum.numerum(m, clavis) ↦ textus
    }
    cape err { redde "ERR:" + manifestum.causa(err) }
}

functio _metadata_wire_result() → bivalens {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(_metadata_corpus())
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.uint8").valor_wire, _u8(127))
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.int8").valor_wire, _u8(254))
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.uint16").valor_wire, _u16(4660))
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.int16").valor_wire, _u16(65534))
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.uint32").valor_wire, _u32(305419896))
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.int32").valor_wire, _u32(4294967294))
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.float32").valor_wire, [0, 0, 128, 63])
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.bool").valor_wire, _u8(1))
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.string").valor_wire, _str("hello"))
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.array").valor_wire, _array(2, 2, _iunge(_u16(4660), _u16(43981))))
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.nested").valor_wire, _array(9, 1, _array(0, 2, [7, 8])))
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.uint64").valor_wire, _u64(72623859790382856))
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.int64").valor_wire, [254, 255, 255, 255, 255, 255, 255, 255])
        adfirma _wire_aequa(manifestum.metadatum(m, "wire.float64").valor_wire, [0, 0, 0, 0, 0, 0, 240, 63])
        adfirma _numerum_observa(m, "wire.uint8") ≡ "127"
        adfirma _numerum_observa(m, "wire.int8") ≡ "-2"
        adfirma _numerum_observa(m, "wire.uint16") ≡ "4660"
        adfirma _numerum_observa(m, "wire.int16") ≡ "-2"
        adfirma _numerum_observa(m, "wire.uint32") ≡ "305419896"
        adfirma _numerum_observa(m, "wire.int32") ≡ "-2"
        adfirma _numerum_observa(m, "wire.uint64") ≡ "72623859790382856"
        adfirma _numerum_observa(m, "wire.int64") ≡ "-2"
        adfirma manifestum.textum(m, "wire.string") ≡ "hello"
        redde verum
    }
    cape err { redde falsum }
}

functio _metadata_bool_float_result() → bivalens {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(_metadata_corpus())
        adfirma _numerum_observa(m, "wire.bool") ≡ "ERR:metadata value is not an unsigned integer"
        adfirma _numerum_observa(m, "wire.float32") ≡ "ERR:metadata value is not an unsigned integer"
        adfirma _numerum_observa(m, "wire.float64") ≡ "ERR:metadata value is not an unsigned integer"
        redde verum
    }
    cape err { redde falsum }
}

functio _descriptor_result(manifestum.CorpusGguf corpus, textus nomen) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fixum manifestum.DescriptioTensorisGguf t ← manifestum.inveni_tensorem(m, nomen)
        fixum manifestum.LayoutGgml layout ← t.layout
        redde (m.data_inceptum ↦ textus) + "/" + (t.offset_relativum ↦ textus) + "/" + (t.elementa ↦ textus)
    }
    cape err { redde manifestum.causa(err) }
}

functio _reordered_gapped() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 0)
    table ← _iunge(table, _tensor("b", [4, 1], 0, 160))
    table ← _iunge(table, _tensor("a", [4, 1], 0, 0))
    redde _plenum(table, 32, 256)
}

functio _boundary_table() → lista<numerus<u8>> {
    redde _iunge(_caput(0, 1), _kv("general.architecture", 8, _str("llama")))
}

functio _table_end() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> table ← _boundary_table()
    fixum numerus data_offset ← ((table.longitudo() + 31) / 32) * 32
    fixum octeti o ← table
    redde manifestum.CorpusGguf {
        tabula = o,
        longitudo_artifacti = data_offset,
        identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = data_offset }
    }
}

functio _padding_end() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> table ← _boundary_table()
    fixum numerus data_offset ← ((table.longitudo() + 31) / 32) * 32
    varia lista<numerus<u8>> b ← table
    b.appende(0 ∷ numerus<u8>)
    fixum octeti o ← b
    redde manifestum.CorpusGguf {
        tabula = o,
        longitudo_artifacti = data_offset,
        identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = data_offset }
    }
}

functio _llama() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 3)
    table ← _iunge(table, _kv("general.architecture", 8, _str("llama")))
    table ← _iunge(table, _kv("general.custom_note", 8, _str("unknown metadata")))
    # An array-valued unknown key proves value-wire preservation beyond a
    # filename or architecture switch.
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _iunge(_iunge(_u32(8), _u64(2)), _iunge(_str("<s>"), _str("hello")))))
    table ← _iunge(table, _tensor("token_embd.weight", [4, 8], 0, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [8], 1, 160))
    redde _cum_padding(table, 32, 384 + 80, falsum)
}

functio _qwen2() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 4)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen2")))
    table ← _iunge(table, _kv("general.alignment", 4, _u32(64)))
    table ← _iunge(table, _kv("qwen2.custom_flag", 4, _u32(7)))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _iunge(_iunge(_u32(8), _u64(2)), _iunge(_str("hello"), _str("world")))))
    # Q4_K block divisibility is along dimension 0; total-product-only logic
    # would incorrectly accept the old [1,1,256] shape.
    table ← _iunge(table, _tensor("blk.0.attn_q.weight", [256, 1, 1], 12, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [2, 2], 0, 192))
    redde _cum_padding(table, 64, 448 + 208, falsum)
}

functio _qwen35moe() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 4)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen35moe")))
    table ← _iunge(table, _kv("general.alignment", 4, _u32(128)))
    table ← _iunge(table, _kv("qwen35moe.custom_flag", 4, _u32(35)))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _iunge(_iunge(_u32(8), _u64(2)), _iunge(_str("hello"), _str("world")))))
    table ← _iunge(table, _tensor("blk.0.experts.0.weight", [2, 3, 4], 999, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [2, 2], 30, 64))
    redde _cum_padding(table, 128, 512 + 72, falsum)
}

functio _result(manifestum.CorpusGguf corpus) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        redde "ok"
    }
    cape err {
        redde manifestum.causa(err)
    }
}

functio _surface_result(manifestum.CorpusGguf corpus, textus tensor_name) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fixum textus arch ← manifestum.textum(m, "general.architecture")
        fixum manifestum.DescriptioTensorisGguf t ← manifestum.inveni_tensorem(m, tensor_name)
        redde arch + "/" + (m.concordatio ↦ textus) + "/" + ((t.forma.accipe(0) vel 0) ↦ textus) + "/" + (t.typo_ggml ↦ textus)
    }
    cape err {
        redde manifestum.causa(err)
    }
}

functio _bad_magic() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 0)
    table ← _iunge([0x00], table.prima(table.longitudo() - 1))
    redde _cum_padding(table, 32, 32, falsum)
}

functio _bad_version() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 0)
    table ← _iunge(_iunge(table.prima(4), _u32(2)), _iunge(_u64(0), _u64(0)))
    redde _cum_padding(table, 32, 32, falsum)
}

functio _truncated() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> b ← [0x47, 0x47, 0x55, 0x46]
    fixum octeti o ← b
    redde manifestum.CorpusGguf {
        tabula = o,
        longitudo_artifacti = 32,
        identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = 32 }
    }
}

functio _wrong_alignment_kind(numerus typo, lista<numerus<u8>> value) → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 1)
    table ← _iunge(table, _kv("general.alignment", typo, value))
    redde _cum_padding(table, 32, 32, falsum)
}

functio _malformed_value(numerus typo, lista<numerus<u8>> value) → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 1)
    table ← _iunge(table, _kv("bad.value", typo, value))
    redde _cum_padding(table, 32, 32, falsum)
}

functio _duplicate_metadata() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 2)
    table ← _iunge(table, _kv("general.architecture", 8, _str("llama")))
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen2")))
    redde _cum_padding(table, 32, 32, falsum)
}

functio _duplicate_tensors() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 0)
    table ← _iunge(table, _tensor("same", [8], 0, 0))
    table ← _iunge(table, _tensor("same", [8], 0, 32))
    redde _cum_padding(table, 32, 64, falsum)
}

functio _dimension_ceiling() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("huge", [1000000001], 0, 0))
    redde _cum_padding(table, 32, 64, falsum)
}

functio _element_overflow() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("too_many", [1000000000, 2], 0, 0))
    redde _cum_padding(table, 32, 64, falsum)
}

functio _rank_zero() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("scalar", [], 0, 0))
    redde _cum_padding(table, 32, 64, falsum)
}

functio _non_block_quant() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("bad_q4k", [1, 1, 256], 12, 0))
    redde _cum_padding(table, 32, 144, falsum)
}

functio _known_out_of_file() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("known", [256, 1], 12, 0))
    redde _cum_padding(table, 32, 100, falsum)
}

functio _unknown_out_of_file() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("unknown", [2, 3, 4], 999, 1000))
    redde _cum_padding(table, 32, 100, falsum)
}

functio _offset_overflow() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("overflow", [2, 3, 4], 999, 9223372036854775807))
    redde _cum_padding(table, 32, 64, falsum)
}

functio _overlap() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 0)
    table ← _iunge(table, _tensor("a", [8], 0, 0))
    table ← _iunge(table, _tensor("b", [8], 0, 16))
    redde _cum_padding(table, 32, 64, falsum)
}

functio _extra_data_region() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 0)
    redde _cum_padding(table, 32, 32, verum)
}

functio _identity_mismatch() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 0)
    fixum numerus data_offset ← ((table.longitudo() + 31) / 32) * 32
    varia lista<numerus<u8>> b ← table
    dum b.longitudo() < data_offset { b.appende(0 ∷ numerus<u8>) }
    fixum octeti o ← b
    redde manifestum.CorpusGguf {
        tabula = o,
        longitudo_artifacti = data_offset,
        identitas = artifact.IdentitasContenuti { algorithmus = "md5", digestio = F_DIGEST, longitudo = data_offset }
    }
}

functio _lectio_llama(numerus initium, numerus longitudo) → manifestum.LectioFontis {
    fixum manifestum.CorpusGguf corpus ← _llama()
    fixum octeti tabula ← corpus.tabula
    si initium < 0 aut longitudo < 0 aut initium + longitudo > corpus.longitudo_artifacti {
        redde manifestum.LectioFontis { successus = falsum, bytes = ||, causa = "synthetic range is outside the artifact" }
    }
    varia octeti out ← ||
    varia numerus i ← 0
    dum i < longitudo {
        fixum numerus index ← initium + i
        si index < tabula.longitudo() {
            out.appende(tabula.accipe(index) vel (0 ∷ numerus<u8>))
        } secus {
            out.appende((index % 256) ∷ numerus<u8>)
        }
        i ↑
    }
    redde manifestum.LectioFontis { successus = verum, bytes = out, causa = "" }
}

functio _lectio_defecta(numerus initium, numerus longitudo) → manifestum.LectioFontis {
    redde manifestum.LectioFontis { successus = falsum, bytes = ||, causa = "synthetic read failed" }
}

functio _inspice_resultum(bivalens deficit) → textus {
    fac {
        fixum manifestum.CorpusGguf corpus ← _llama()
        si deficit {
            fixum manifestum.ManifestumGguf _ ← manifestum.inspice(
                _lectio_defecta,
                corpus.longitudo_artifacti,
                corpus.identitas
            )
        } secus {
            fixum manifestum.ManifestumGguf m ← manifestum.inspice(
                _lectio_llama,
                corpus.longitudo_artifacti,
                corpus.identitas
            )
            redde manifestum.textum(m, "general.architecture") + "/" + (m.data_inceptum ↦ textus)
        }
        redde "unexpected-success"
    }
    cape err { redde manifestum.causa(err) }
}

functio _fragmentum_resultum() → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(_llama())
        fixum octeti bytes ← manifestum.lege_fragmentum(
            m,
            "token_embd.weight",
            3,
            4,
            _lectio_llama
        )
        si _wire_aequa(bytes, [35, 36, 37, 38]) ergo redde "exact-bytes"
        redde "wrong-bytes"
    }
    cape err { redde manifestum.causa(err) }
}

# LIB-02-U1 tokenizer-metadata pins from the target-prefix corpus
# (Qwen3.6-35B-A3B-UD-Q4_K_M.gguf metadata block): 248320 vocab entries,
# 247587 merges, and the pinned special ids. The builder repeats a finite
# fixture vocabulary so the arrays carry the exact pinned counts without a
# runtime textus-to-bytes encoder in package MIR.
fixum numerus TOKENS_PIN ← 248320
fixum numerus MERGES_PIN ← 247587
fixum numerus BOS_PIN ← 248044
fixum numerus EOS_PIN ← 248046
fixum numerus PAD_PIN ← 248055

functio _stringarum_itera(numerus count, lista<numerus<u8>> bytes) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < count {
        itera ex bytes fixum b { out.appende(b) }
        i ↑
    }
    redde out
}

functio _u32_itera(numerus count) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> four ← _u32(0)
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < count {
        itera ex four fixum b { out.appende(b) }
        i ↑
    }
    redde out
}

functio _tokenizer_corpus() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 7)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen35moe")))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _array(8, TOKENS_PIN, _stringarum_itera(TOKENS_PIN, _str("<s>")))))
    table ← _iunge(table, _kv("tokenizer.ggml.token_type", 9, _array(4, TOKENS_PIN, _u32_itera(TOKENS_PIN))))
    table ← _iunge(table, _kv("tokenizer.ggml.merges", 9, _array(8, MERGES_PIN, _stringarum_itera(MERGES_PIN, _str("hello")))))
    table ← _iunge(table, _kv("tokenizer.ggml.bos_token_id", 4, _u32(BOS_PIN)))
    table ← _iunge(table, _kv("tokenizer.ggml.eos_token_id", 4, _u32(EOS_PIN)))
    table ← _iunge(table, _kv("tokenizer.ggml.padding_token_id", 4, _u32(PAD_PIN)))
    table ← _iunge(table, _kv("tokenizer.chat_template", 8, _str("hello")))
    redde _plenum(table, 32, 0)
}

functio _tokenizer_array_result() → bivalens {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(_tokenizer_corpus())
        fixum lista<textus> tokens ← manifestum.textorum(m, "tokenizer.ggml.tokens")
        fixum lista<textus> merges ← manifestum.textorum(m, "tokenizer.ggml.merges")
        fixum lista<numerus> types ← manifestum.numerorum(m, "tokenizer.ggml.token_type")
        adfirma tokens.longitudo() ≡ TOKENS_PIN
        adfirma merges.longitudo() ≡ MERGES_PIN
        adfirma types.longitudo() ≡ TOKENS_PIN
        adfirma tokens.accipe(0) vel "" ≡ "<s>"
        adfirma manifestum.numerum(m, "tokenizer.ggml.bos_token_id") ≡ BOS_PIN
        adfirma manifestum.numerum(m, "tokenizer.ggml.eos_token_id") ≡ EOS_PIN
        adfirma manifestum.numerum(m, "tokenizer.ggml.padding_token_id") ≡ PAD_PIN
        adfirma manifestum.textum(m, "tokenizer.chat_template") ≡ "hello"
        redde verum
    }
    cape err { redde falsum }
}

functio _textorum_error(manifestum.CorpusGguf corpus, textus clavis) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fixum lista<textus> _ ← manifestum.textorum(m, clavis)
        redde "unexpected-success"
    }
    cape err { redde manifestum.causa(err) }
}

functio _numerorum_error(manifestum.CorpusGguf corpus, textus clavis) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fixum lista<numerus> _ ← manifestum.numerorum(m, clavis)
        redde "unexpected-success"
    }
    cape err { redde manifestum.causa(err) }
}

functio _duplicate_tokenizer_key() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 2)
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _array(8, 1, _str("<s>"))))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _array(8, 1, _str("hello"))))
    redde _cum_padding(table, 32, 32, falsum)
}

probandum "GGUF-A1b manifest and range-source cases" {
    proba "parses llama default with unknown metadata, qwen2 custom alignment, and qwen35moe surfaces" {
        adfirma _result(_llama()) ≡ "ok"
        adfirma _result(_qwen2()) ≡ "ok"
        adfirma _result(_qwen35moe()) ≡ "ok"
        adfirma _surface_result(_llama(), "token_embd.weight") ≡ "llama/32/4/0"
        adfirma _surface_result(_qwen2(), "blk.0.attn_q.weight") ≡ "qwen2/64/256/12"
        adfirma _surface_result(_qwen35moe(), "blk.0.experts.0.weight") ≡ "qwen35moe/128/2/999"
        fac {
            fixum manifestum.ManifestumGguf m ← manifestum.parse(_llama())
            fixum manifestum.MetadatumGguf unknown ← manifestum.metadatum(m, "general.custom_note")
            adfirma unknown.typo ≡ 8
            adfirma unknown.valor_wire.longitudo() > 0
        }
        cape err { adfirma falsum }
    }

    proba "preserves unknown type and mixed tensor metadata" {
        fac {
            fixum manifestum.ManifestumGguf m ← manifestum.parse(_qwen35moe())
            fixum manifestum.DescriptioTensorisGguf t ← manifestum.inveni_tensorem(m, "blk.0.experts.0.weight")
            fixum manifestum.DescriptioTensorisGguf known ← manifestum.inveni_tensorem(m, "blk.0.attn_norm.weight")
            fixum manifestum.LayoutGgml l ← t.layout
            fixum manifestum.LayoutGgml _ ← manifestum.layout(999, [2, 3, 4])
            adfirma manifestum.textum(m, "general.architecture") ≡ "qwen35moe"
            adfirma manifestum.numerum(m, "qwen35moe.custom_flag") ≡ 35
            adfirma t.typo_ggml ≡ 999
            adfirma known.typo_ggml ≡ 30
            adfirma manifestum.metadatum(m, "general.architecture").typo ≡ 8
        }
        cape err { adfirma falsum }
    }

    proba "rejects malformed magic, version, truncation, bool, and string" {
        adfirma _result(_bad_magic()) ≡ "not a GGUF file — bad magic"
        adfirma _result(_bad_version()) ≡ "unsupported GGUF version: 2"
        adfirma _result(_truncated()) ≡ "truncated GGUF header"
        adfirma _result(_wrong_alignment_kind(7, _u8(1))) ≡ "general.alignment must use GGUF UINT32 wire kind"
        adfirma _result(_wrong_alignment_kind(4, _u32(3))) ≡ "general.alignment must be a positive power of two"
        adfirma _result(_malformed_value(7, _u8(2))) ≡ "malformed GGUF bool value"
        adfirma _result(_malformed_value(8, _iunge(_u64(1), [0xff]))) ≡ "GGUF string is not valid UTF-8"
    }

    proba "rejects duplicate keys/names, bounds, overlap, and data bytes" {
        adfirma _result(_duplicate_metadata()) ≡ "duplicate GGUF metadata key: general.architecture"
        adfirma _result(_duplicate_tensors()) ≡ "duplicate GGUF tensor name: same"
        adfirma _result(_dimension_ceiling()) ≡ "tensor dimension is outside the bounded range"
        adfirma _result(_element_overflow()) ≡ "tensor element count exceeds the bounded range"
        adfirma _result(_rank_zero()) ≡ "tensor rank must be at least one"
        adfirma _result(_non_block_quant()) ≡ "tensor first dimension is not a complete GGML block"
        adfirma _result(_known_out_of_file()) ≡ "known GGML tensor range exceeds the artifact"
        adfirma _result(_unknown_out_of_file()) ≡ "GGML tensor offset exceeds the artifact"
        adfirma _result(_offset_overflow()) ≡ "checked offset addition overflow"
        adfirma _result(_overlap()) ≡ "known GGML tensor ranges overlap"
        adfirma _result(_extra_data_region()) ≡ "bounded GGUF corpus contains bytes from the data region"
        adfirma _result(_identity_mismatch()) ≡ "content identity does not match the supplied artifact length"
    }

    proba "preserves all thirteen metadata wire kinds and exact payload bytes" {
        adfirma _metadata_wire_result()
    }

    proba "keeps BOOL parseable while numerum rejects BOOL and floating values" {
        adfirma _metadata_bool_float_result()
        fac {
            fixum manifestum.ManifestumGguf m ← manifestum.parse(_metadata_corpus())
            adfirma manifestum.metadatum(m, "wire.bool").typo ≡ 7
            adfirma _numerum_observa(m, "wire.bool") ≡ "ERR:metadata value is not an unsigned integer"
        }
        cape err { adfirma falsum }
    }

    proba "observes default/custom data starts, descriptor ranges, and legal reorder/gaps" {
        adfirma _descriptor_result(_llama(), "blk.0.attn_norm.weight") ≡ "288/160/8"
        adfirma _descriptor_result(_qwen2(), "blk.0.attn_norm.weight") ≡ "384/192/4"
        adfirma _descriptor_result(_reordered_gapped(), "b") ≡ "128/160/4"
    }

    proba "accepts a corpus ending at table end or inside alignment padding" {
        adfirma _result(_table_end()) ≡ "ok"
        adfirma _result(_padding_end()) ≡ "ok"
        fac {
            fixum manifestum.ManifestumGguf exactum ← manifestum.parse(_table_end())
            fixum manifestum.ManifestumGguf partiale ← manifestum.parse(_padding_end())
            adfirma exactum.data_inceptum ≡ 96
            adfirma partiale.data_inceptum ≡ 96
            adfirma exactum.longitudo_artifacti ≡ 96
            adfirma partiale.longitudo_artifacti ≡ 96
        }
        cape err { adfirma falsum }
    }

    proba "inspects the bounded table through a caller-owned range source" {
        adfirma _inspice_resultum(falsum) ≡ "llama/288"
        adfirma _inspice_resultum(verum) ≡ "range source failed: synthetic read failed"
    }

    proba "reads an exact checked tensor fragment" {
        adfirma _fragmentum_resultum() ≡ "exact-bytes"
    }
}

probandum "LIB-02-U1 tokenizer metadata accessors" {
    proba "returns the exact token/merge counts and pinned special ids from the tokenizer metadata block" {
        adfirma _tokenizer_array_result()
    }

    proba "rejects missing, malformed, and duplicate tokenizer keys with typed GgufManifestError rows" {
        adfirma _textorum_error(_tokenizer_corpus(), "tokenizer.ggml.max_token_id") ≡ "metadata key not found: tokenizer.ggml.max_token_id"
        adfirma _textorum_error(_tokenizer_corpus(), "tokenizer.ggml.bos_token_id") ≡ "metadata value is not a GGUF string array"
        adfirma _numerorum_error(_tokenizer_corpus(), "tokenizer.ggml.tokens") ≡ "metadata array is not an integer array"
        adfirma _numerorum_error(_tokenizer_corpus(), "tokenizer.chat_template") ≡ "metadata value is not a GGUF integer array"
        adfirma _result(_duplicate_tokenizer_key()) ≡ "duplicate GGUF metadata key: tokenizer.ggml.tokens"
    }
}
