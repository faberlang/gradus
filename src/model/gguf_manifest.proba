+++
locale = "en"
+++
# GGUF-A1b manifest and range-source proof surface, plus the LIB-02-U1
# tokenizer metadata array accessors.
#
# `faber check` proves the builders, parse calls, returned-field access, and
# typed-error branches type-check. The current imported-library `faber test`
# route is provider-blocked; this file makes no executed-value claim. The
# executable package proof lives in exempla/gguf-manifest and records its own
# command/output receipt. The cases below also type-check exact wire-byte
# assertions for all thirteen metadata kinds, nested arrays, descriptor fields,
# legal range order/gaps, BOOL numerum rejection, incremental inspection,
# checked payload-fragment reads, and the tokenizer array accessors against the
# pinned target-prefix counts (248320 tokens, 247587 merges) and special ids.

import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" manifestum

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn _u8(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>]
}

fn _u16(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>]
}

fn _u32(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>]
}

fn _u64(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>, ((n ⇒ 32) % 256) ∷ int<u8>, ((n ⇒ 40) % 256) ∷ int<u8>, ((n ⇒ 48) % 256) ∷ int<u8>, ((n ⇒ 56) % 256) ∷ int<u8>]
}

fn _iunge(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

fn _textus_bytes(string s) → list<int<u8>> {
    # Package MIR has no textus→octeti extraction arm. This structural
    # builder only needs a finite ASCII corpus, so keep its encoding explicit.
    if s ≡ "general.architecture" then return [103, 101, 110, 101, 114, 97, 108, 46, 97, 114, 99, 104, 105, 116, 101, 99, 116, 117, 114, 101]
    if s ≡ "general.custom_note" then return [103, 101, 110, 101, 114, 97, 108, 46, 99, 117, 115, 116, 111, 109, 95, 110, 111, 116, 101]
    if s ≡ "tokenizer.ggml.tokens" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115]
    if s ≡ "<s>" then return [60, 115, 62]
    if s ≡ "hello" then return [104, 101, 108, 108, 111]
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_norm.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "qwen2" then return [113, 119, 101, 110, 50]
    if s ≡ "general.alignment" then return [103, 101, 110, 101, 114, 97, 108, 46, 97, 108, 105, 103, 110, 109, 101, 110, 116]
    if s ≡ "qwen2.custom_flag" then return [113, 119, 101, 110, 50, 46, 99, 117, 115, 116, 111, 109, 95, 102, 108, 97, 103]
    if s ≡ "world" then return [119, 111, 114, 108, 100]
    if s ≡ "blk.0.attn_q.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "qwen35moe" then return [113, 119, 101, 110, 51, 53, 109, 111, 101]
    if s ≡ "qwen35moe.custom_flag" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 99, 117, 115, 116, 111, 109, 95, 102, 108, 97, 103]
    if s ≡ "blk.0.experts.0.weight" then return [98, 108, 107, 46, 48, 46, 101, 120, 112, 101, 114, 116, 115, 46, 48, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "bad.value" then return [98, 97, 100, 46, 118, 97, 108, 117, 101]
    if s ≡ "llama" then return [108, 108, 97, 109, 97]
    if s ≡ "same" then return [115, 97, 109, 101]
    if s ≡ "huge" then return [104, 117, 103, 101]
    if s ≡ "too_many" then return [116, 111, 111, 95, 109, 97, 110, 121]
    if s ≡ "scalar" then return [115, 99, 97, 108, 97, 114]
    if s ≡ "bad_q4k" then return [98, 97, 100, 95, 113, 52, 107]
    if s ≡ "known" then return [107, 110, 111, 119, 110]
    if s ≡ "unknown" then return [117, 110, 107, 110, 111, 119, 110]
    if s ≡ "overflow" then return [111, 118, 101, 114, 102, 108, 111, 119]
    if s ≡ "a" then return [97]
    if s ≡ "b" then return [98]
    if s ≡ "wire.uint8" then return [119, 105, 114, 101, 46, 117, 105, 110, 116, 56]
    if s ≡ "wire.int8" then return [119, 105, 114, 101, 46, 105, 110, 116, 56]
    if s ≡ "wire.uint16" then return [119, 105, 114, 101, 46, 117, 105, 110, 116, 49, 54]
    if s ≡ "wire.int16" then return [119, 105, 114, 101, 46, 105, 110, 116, 49, 54]
    if s ≡ "wire.uint32" then return [119, 105, 114, 101, 46, 117, 105, 110, 116, 51, 50]
    if s ≡ "wire.int32" then return [119, 105, 114, 101, 46, 105, 110, 116, 51, 50]
    if s ≡ "wire.float32" then return [119, 105, 114, 101, 46, 102, 108, 111, 97, 116, 51, 50]
    if s ≡ "wire.bool" then return [119, 105, 114, 101, 46, 98, 111, 111, 108]
    if s ≡ "wire.string" then return [119, 105, 114, 101, 46, 115, 116, 114, 105, 110, 103]
    if s ≡ "wire.array" then return [119, 105, 114, 101, 46, 97, 114, 114, 97, 121]
    if s ≡ "wire.nested" then return [119, 105, 114, 101, 46, 110, 101, 115, 116, 101, 100]
    if s ≡ "wire.uint64" then return [119, 105, 114, 101, 46, 117, 105, 110, 116, 54, 52]
    if s ≡ "wire.int64" then return [119, 105, 114, 101, 46, 105, 110, 116, 54, 52]
    if s ≡ "wire.float64" then return [119, 105, 114, 101, 46, 102, 108, 111, 97, 116, 54, 52]
    return []
}

fn _str(string s) → list<int<u8>> {
    const list<int<u8>> b ← _textus_bytes(s)
    return _iunge(_u64(b.length()), b)
}

fn _kv(string key, int typo, list<int<u8>> value) → list<int<u8>> {
    return _iunge(_iunge(_str(key), _u32(typo)), value)
}

fn _array(int typo, int count, list<int<u8>> value) → list<int<u8>> {
    return _iunge(_iunge(_u32(typo), _u64(count)), value)
}

fn _tensor(string name, list<int> forma, int typo, int offset) → list<int<u8>> {
    var list<int<u8>> out ← _iunge(_str(name), _u32(forma.length()))
    for from forma const dim {
        out ← _iunge(out, _u64(dim))
    }
    return _iunge(_iunge(out, _u32(typo)), _u64(offset))
}

fn _header(int tensorum, int metadata) → list<int<u8>> {
    return _iunge(_iunge([71, 71, 85, 70], _u32(3)), _iunge(_u64(tensorum), _u64(metadata)))
}

fn _cum_padding(list<int<u8>> table, int concordatio, int total, bool extra_data) → manifestum.GgufCorpus {
    const int data_offset ← (((table.length() + concordatio) - 1) / concordatio) * concordatio
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    if extra_data {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← b
    return manifestum.GgufCorpus { tabula = o, artifact_length = total, identitas = artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = total } }
}

fn _plenum(list<int<u8>> table, int concordatio, int payload) → manifestum.GgufCorpus {
    const int data_offset ← (((table.length() + concordatio) - 1) / concordatio) * concordatio
    return _cum_padding(table, concordatio, data_offset + payload, false)
}

fn _wire_aequa(bytes actual, list<int<u8>> expectata) → bool {
    if actual.length() ≠ expectata.length() then return false
    var int i ← 0
    while i ≺ expectata.length() {
        if (actual.get(i) coalesce (0 ∷ int<u8>)) ≠ (expectata.get(i) coalesce (0 ∷ int<u8>)) then return false
        i ↑
    }
    return true
}

fn _metadata_corpus() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(0, 14)
    table ← _iunge(table, _kv("wire.uint8", 0, _u8(127)))
    table ← _iunge(table, _kv("wire.int8", 1, _u8(254)))
    table ← _iunge(table, _kv("wire.uint16", 2, _u16(4660)))
    table ← _iunge(table, _kv("wire.int16", 3, _u16(65534)))
    table ← _iunge(table, _kv("wire.uint32", 4, _u32(305419896)))
    table ← _iunge(table, _kv("wire.int32", 5, _u32(4294967294)))
    table ← _iunge(table, _kv("wire.float32", 6, [0, 0, 128, 63]))
    table ← _iunge(table, _kv("wire.bool", 7, _u8(1)))
    table ← _iunge(table, _kv("wire.string", 8, _str("hello")))
    table ← _iunge(table, _kv("wire.array", 9, _array(2, 2, _iunge(_u16(4660), _u16(43981)))))
    table ← _iunge(table, _kv("wire.nested", 9, _array(9, 1, _array(0, 2, [7, 8]))))
    table ← _iunge(table, _kv("wire.uint64", 10, _u64(72623859790382856)))
    table ← _iunge(table, _kv("wire.int64", 11, [254, 255, 255, 255, 255, 255, 255, 255]))
    table ← _iunge(table, _kv("wire.float64", 12, [0, 0, 0, 0, 0, 0, 240, 63]))
    return _plenum(table, 32, 0)
}

fn _number_observa(manifestum.GgufManifest m, string clavis) → string {
    do {
        return manifestum.numerum(m, clavis) ↦ string
    }
    catch err {
        return "ERR:" + manifestum.message(err)
    }
}

fn _metadata_wire_result() → bool {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(_metadata_corpus())
        assert _wire_aequa(manifestum.metadata(m, "wire.uint8").valor_wire, _u8(127))
        assert _wire_aequa(manifestum.metadata(m, "wire.int8").valor_wire, _u8(254))
        assert _wire_aequa(manifestum.metadata(m, "wire.uint16").valor_wire, _u16(4660))
        assert _wire_aequa(manifestum.metadata(m, "wire.int16").valor_wire, _u16(65534))
        assert _wire_aequa(manifestum.metadata(m, "wire.uint32").valor_wire, _u32(305419896))
        assert _wire_aequa(manifestum.metadata(m, "wire.int32").valor_wire, _u32(4294967294))
        assert _wire_aequa(manifestum.metadata(m, "wire.float32").valor_wire, [0, 0, 128, 63])
        assert _wire_aequa(manifestum.metadata(m, "wire.bool").valor_wire, _u8(1))
        assert _wire_aequa(manifestum.metadata(m, "wire.string").valor_wire, _str("hello"))
        assert _wire_aequa(manifestum.metadata(m, "wire.array").valor_wire, _array(2, 2, _iunge(_u16(4660), _u16(43981))))
        assert _wire_aequa(manifestum.metadata(m, "wire.nested").valor_wire, _array(9, 1, _array(0, 2, [7, 8])))
        assert _wire_aequa(manifestum.metadata(m, "wire.uint64").valor_wire, _u64(72623859790382856))
        assert _wire_aequa(manifestum.metadata(m, "wire.int64").valor_wire, [254, 255, 255, 255, 255, 255, 255, 255])
        assert _wire_aequa(manifestum.metadata(m, "wire.float64").valor_wire, [0, 0, 0, 0, 0, 0, 240, 63])
        assert _number_observa(m, "wire.uint8") ≡ "127"
        assert _number_observa(m, "wire.int8") ≡ "-2"
        assert _number_observa(m, "wire.uint16") ≡ "4660"
        assert _number_observa(m, "wire.int16") ≡ "-2"
        assert _number_observa(m, "wire.uint32") ≡ "305419896"
        assert _number_observa(m, "wire.int32") ≡ "-2"
        assert _number_observa(m, "wire.uint64") ≡ "72623859790382856"
        assert _number_observa(m, "wire.int64") ≡ "-2"
        assert manifestum.textum(m, "wire.string") ≡ "hello"
        return true
    }
    catch err {
        return false
    }
}

fn _metadata_bool_float_result() → bool {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(_metadata_corpus())
        assert _number_observa(m, "wire.bool") ≡ "ERR:metadata value is not an unsigned integer"
        assert _number_observa(m, "wire.float32") ≡ "ERR:metadata value is not an unsigned integer"
        assert _number_observa(m, "wire.float64") ≡ "ERR:metadata value is not an unsigned integer"
        return true
    }
    catch err {
        return false
    }
}

fn _descriptor_result(manifestum.GgufCorpus corpus, string nomen) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        const manifestum.GgufTensorDescriptor t ← manifestum.inveni_tensorem(m, nomen)
        const manifestum.GgmlLayout layout ← t.layout
        return ((((m.data_inceptum ↦ string) + "/") + (t.offset_relativum ↦ string)) + "/") + (t.elements ↦ string)
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _reordered_gapped() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(2, 0)
    table ← _iunge(table, _tensor("b", [4, 1], 0, 160))
    table ← _iunge(table, _tensor("a", [4, 1], 0, 0))
    return _plenum(table, 32, 256)
}

fn _boundary_table() → list<int<u8>> {
    return _iunge(_header(0, 1), _kv("general.architecture", 8, _str("llama")))
}

fn _table_end() → manifestum.GgufCorpus {
    const list<int<u8>> table ← _boundary_table()
    const int data_offset ← ((table.length() + 31) / 32) * 32
    const bytes o ← table
    return manifestum.GgufCorpus { tabula = o, artifact_length = data_offset, identitas = artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = data_offset } }
}

fn _padding_end() → manifestum.GgufCorpus {
    const list<int<u8>> table ← _boundary_table()
    const int data_offset ← ((table.length() + 31) / 32) * 32
    var list<int<u8>> b ← table
    b.append(0 ∷ int<u8>)
    const bytes o ← b
    return manifestum.GgufCorpus { tabula = o, artifact_length = data_offset, identitas = artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = data_offset } }
}

fn _llama() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(2, 3)
    table ← _iunge(table, _kv("general.architecture", 8, _str("llama")))
    table ← _iunge(table, _kv("general.custom_note", 8, _str("unknown metadata")))
    # An array-valued unknown key proves value-wire preservation beyond a
    # filename or architecture switch.
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _iunge(_iunge(_u32(8), _u64(2)), _iunge(_str("<s>"), _str("hello")))))
    table ← _iunge(table, _tensor("token_embd.weight", [4, 8], 0, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [8], 1, 160))
    return _cum_padding(table, 32, 384 + 80, false)
}

fn _qwen2() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(2, 4)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen2")))
    table ← _iunge(table, _kv("general.alignment", 4, _u32(64)))
    table ← _iunge(table, _kv("qwen2.custom_flag", 4, _u32(7)))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _iunge(_iunge(_u32(8), _u64(2)), _iunge(_str("hello"), _str("world")))))
    # Q4_K block divisibility is along dimension 0; total-product-only logic
    # would incorrectly accept the old [1,1,256] shape.
    table ← _iunge(table, _tensor("blk.0.attn_q.weight", [256, 1, 1], 12, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [2, 2], 0, 192))
    return _cum_padding(table, 64, 448 + 208, false)
}

fn _qwen35moe() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(2, 4)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen35moe")))
    table ← _iunge(table, _kv("general.alignment", 4, _u32(128)))
    table ← _iunge(table, _kv("qwen35moe.custom_flag", 4, _u32(35)))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _iunge(_iunge(_u32(8), _u64(2)), _iunge(_str("hello"), _str("world")))))
    table ← _iunge(table, _tensor("blk.0.experts.0.weight", [2, 3, 4], 999, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [2, 2], 30, 64))
    return _cum_padding(table, 128, 512 + 72, false)
}

fn _result(manifestum.GgufCorpus corpus) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        return "ok"
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _surface_result(manifestum.GgufCorpus corpus, string tensor_name) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        const string arch ← manifestum.textum(m, "general.architecture")
        const manifestum.GgufTensorDescriptor t ← manifestum.inveni_tensorem(m, tensor_name)
        return (((((arch + "/") + (m.concordatio ↦ string)) + "/") + ((t.shape.get(0) coalesce 0) ↦ string)) + "/") + (t.dtype_ggml ↦ string)
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _bad_magic() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(0, 0)
    table ← _iunge([0], table.take(table.length() - 1))
    return _cum_padding(table, 32, 32, false)
}

fn _bad_version() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(0, 0)
    table ← _iunge(_iunge(table.take(4), _u32(2)), _iunge(_u64(0), _u64(0)))
    return _cum_padding(table, 32, 32, false)
}

fn _truncated() → manifestum.GgufCorpus {
    const list<int<u8>> b ← [71, 71, 85, 70]
    const bytes o ← b
    return manifestum.GgufCorpus { tabula = o, artifact_length = 32, identitas = artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = 32 } }
}

fn _wrong_alignment_kind(int typo, list<int<u8>> value) → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(0, 1)
    table ← _iunge(table, _kv("general.alignment", typo, value))
    return _cum_padding(table, 32, 32, false)
}

fn _malformed_value(int typo, list<int<u8>> value) → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(0, 1)
    table ← _iunge(table, _kv("bad.value", typo, value))
    return _cum_padding(table, 32, 32, false)
}

fn _duplicate_metadata() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(0, 2)
    table ← _iunge(table, _kv("general.architecture", 8, _str("llama")))
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen2")))
    return _cum_padding(table, 32, 32, false)
}

fn _duplicate_tensors() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(2, 0)
    table ← _iunge(table, _tensor("same", [8], 0, 0))
    table ← _iunge(table, _tensor("same", [8], 0, 32))
    return _cum_padding(table, 32, 64, false)
}

fn _dimension_ceiling() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _iunge(table, _tensor("huge", [1000000001], 0, 0))
    return _cum_padding(table, 32, 64, false)
}

fn _element_overflow() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _iunge(table, _tensor("too_many", [1000000000, 2], 0, 0))
    return _cum_padding(table, 32, 64, false)
}

fn _rank_zero() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _iunge(table, _tensor("scalar", [], 0, 0))
    return _cum_padding(table, 32, 64, false)
}

fn _non_block_quant() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _iunge(table, _tensor("bad_q4k", [1, 1, 256], 12, 0))
    return _cum_padding(table, 32, 144, false)
}

fn _known_out_of_file() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _iunge(table, _tensor("known", [256, 1], 12, 0))
    return _cum_padding(table, 32, 100, false)
}

fn _unknown_out_of_file() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _iunge(table, _tensor("unknown", [2, 3, 4], 999, 1000))
    return _cum_padding(table, 32, 100, false)
}

fn _offset_overflow() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _iunge(table, _tensor("overflow", [2, 3, 4], 999, 9223372036854775807))
    return _cum_padding(table, 32, 64, false)
}

fn _overlap() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(2, 0)
    table ← _iunge(table, _tensor("a", [8], 0, 0))
    table ← _iunge(table, _tensor("b", [8], 0, 16))
    return _cum_padding(table, 32, 64, false)
}

fn _extra_data_region() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(0, 0)
    return _cum_padding(table, 32, 32, true)
}

fn _identity_mismatch() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(0, 0)
    const int data_offset ← ((table.length() + 31) / 32) * 32
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← b
    return manifestum.GgufCorpus { tabula = o, artifact_length = data_offset, identitas = artifact.ContentIdentity { algorithm = "md5", digest = F_DIGEST, length = data_offset } }
}

fn _read_llama(int initium, int longitudo) → manifestum.SourceRead {
    const manifestum.GgufCorpus corpus ← _llama()
    const bytes tabula ← corpus.tabula
    if (initium ≺ 0 or longitudo ≺ 0) or initium + longitudo ≻ corpus.artifact_length {
        return manifestum.SourceRead { successus = false, bytes = ||, message = "synthetic range is outside the artifact" }
    }
    var bytes out ← ||
    var int i ← 0
    while i ≺ longitudo {
        const int index ← initium + i
        if index ≺ tabula.length() {
            out.append(tabula.get(index) coalesce (0 ∷ int<u8>))
        }
        else {
            out.append((index % 256) ∷ int<u8>)
        }
        i ↑
    }
    return manifestum.SourceRead { successus = true, bytes = out, message = "" }
}

fn _read_defecta(int initium, int longitudo) → manifestum.SourceRead {
    return manifestum.SourceRead { successus = false, bytes = ||, message = "synthetic read failed" }
}

fn _inspect_result(bool deficit) → string {
    do {
        const manifestum.GgufCorpus corpus ← _llama()
        if deficit {
            const manifestum.GgufManifest _ ← manifestum.inspect(_read_defecta, corpus.artifact_length, corpus.identitas)
        }
        else {
            const manifestum.GgufManifest m ← manifestum.inspect(_read_llama, corpus.artifact_length, corpus.identitas)
            return (manifestum.textum(m, "general.architecture") + "/") + (m.data_inceptum ↦ string)
        }
        return "unexpected-success"
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _fragment_result() → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(_llama())
        const bytes bytes ← manifestum.read_fragmentum(m, "token_embd.weight", 3, 4, _read_llama)
        if _wire_aequa(bytes, [35, 36, 37, 38]) then return "exact-bytes"
        return "wrong-bytes"
    }
    catch err {
        return manifestum.message(err)
    }
}

# LIB-02-U1 tokenizer-metadata pins from the target-prefix corpus
# (Qwen3.6-35B-A3B-UD-Q4_K_M.gguf metadata block): 248320 vocab entries,
# 247587 merges, and the pinned special ids. The builder repeats a finite
# fixture vocabulary so the arrays carry the exact pinned counts without a
# runtime textus-to-bytes encoder in package MIR.
const int TOKENS_PIN ← 248320
const int MERGES_PIN ← 247587
const int BOS_PIN ← 248044
const int EOS_PIN ← 248046
const int PAD_PIN ← 248055

fn _stringarum_itera(int count, list<int<u8>> bytes) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ count {
        for from bytes const b {
            out.append(b)
        }
        i ↑
    }
    return out
}

fn _u32_itera(int count) → list<int<u8>> {
    const list<int<u8>> four ← _u32(0)
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ count {
        for from four const b {
            out.append(b)
        }
        i ↑
    }
    return out
}

fn _tokenizer_corpus() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(0, 7)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen35moe")))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _array(8, TOKENS_PIN, _stringarum_itera(TOKENS_PIN, _str("<s>")))))
    table ← _iunge(table, _kv("tokenizer.ggml.token_type", 9, _array(4, TOKENS_PIN, _u32_itera(TOKENS_PIN))))
    table ← _iunge(table, _kv("tokenizer.ggml.merges", 9, _array(8, MERGES_PIN, _stringarum_itera(MERGES_PIN, _str("hello")))))
    table ← _iunge(table, _kv("tokenizer.ggml.bos_token_id", 4, _u32(BOS_PIN)))
    table ← _iunge(table, _kv("tokenizer.ggml.eos_token_id", 4, _u32(EOS_PIN)))
    table ← _iunge(table, _kv("tokenizer.ggml.padding_token_id", 4, _u32(PAD_PIN)))
    table ← _iunge(table, _kv("tokenizer.chat_template", 8, _str("hello")))
    return _plenum(table, 32, 0)
}

fn _tokenizer_array_result() → bool {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(_tokenizer_corpus())
        const list<string> tokens ← manifestum.textorum(m, "tokenizer.ggml.tokens")
        const list<string> merges ← manifestum.textorum(m, "tokenizer.ggml.merges")
        const list<int> types ← manifestum.numerorum(m, "tokenizer.ggml.token_type")
        assert tokens.length() ≡ TOKENS_PIN
        assert merges.length() ≡ MERGES_PIN
        assert types.length() ≡ TOKENS_PIN
        assert tokens.get(0) coalesce "" ≡ "<s>"
        assert manifestum.numerum(m, "tokenizer.ggml.bos_token_id") ≡ BOS_PIN
        assert manifestum.numerum(m, "tokenizer.ggml.eos_token_id") ≡ EOS_PIN
        assert manifestum.numerum(m, "tokenizer.ggml.padding_token_id") ≡ PAD_PIN
        assert manifestum.textum(m, "tokenizer.chat_template") ≡ "hello"
        return true
    }
    catch err {
        return false
    }
}

fn _textorum_error(manifestum.GgufCorpus corpus, string clavis) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        const list<string> _ ← manifestum.textorum(m, clavis)
        return "unexpected-success"
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _numerorum_error(manifestum.GgufCorpus corpus, string clavis) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        const list<int> _ ← manifestum.numerorum(m, clavis)
        return "unexpected-success"
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _duplicate_tokenizer_key() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(0, 2)
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _array(8, 1, _str("<s>"))))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _array(8, 1, _str("hello"))))
    return _cum_padding(table, 32, 32, false)
}

describe "GGUF-A1b manifest and range-source cases" {
    test "parses llama default with unknown metadata, qwen2 custom alignment, and qwen35moe surfaces" {
        assert _result(_llama()) ≡ "ok"
        assert _result(_qwen2()) ≡ "ok"
        assert _result(_qwen35moe()) ≡ "ok"
        assert _surface_result(_llama(), "token_embd.weight") ≡ "llama/32/4/0"
        assert _surface_result(_qwen2(), "blk.0.attn_q.weight") ≡ "qwen2/64/256/12"
        assert _surface_result(_qwen35moe(), "blk.0.experts.0.weight") ≡ "qwen35moe/128/2/999"
        do {
            const manifestum.GgufManifest m ← manifestum.parse(_llama())
            const manifestum.GgufMetadata unknown ← manifestum.metadata(m, "general.custom_note")
            assert unknown.dtype ≡ 8
            assert unknown.valor_wire.length() ≻ 0
        }
        catch err {
            assert false
        }
    }
    test "preserves unknown type and mixed tensor metadata" {
        do {
            const manifestum.GgufManifest m ← manifestum.parse(_qwen35moe())
            const manifestum.GgufTensorDescriptor t ← manifestum.inveni_tensorem(m, "blk.0.experts.0.weight")
            const manifestum.GgufTensorDescriptor known ← manifestum.inveni_tensorem(m, "blk.0.attn_norm.weight")
            const manifestum.GgmlLayout l ← t.layout
            const manifestum.GgmlLayout _ ← manifestum.layout(999, [2, 3, 4])
            assert manifestum.textum(m, "general.architecture") ≡ "qwen35moe"
            assert manifestum.numerum(m, "qwen35moe.custom_flag") ≡ 35
            assert t.dtype_ggml ≡ 999
            assert known.dtype_ggml ≡ 30
            assert manifestum.metadata(m, "general.architecture").dtype ≡ 8
        }
        catch err {
            assert false
        }
    }
    test "rejects malformed magic, version, truncation, bool, and string" {
        assert _result(_bad_magic()) ≡ "not a GGUF file — bad magic"
        assert _result(_bad_version()) ≡ "unsupported GGUF version: 2"
        assert _result(_truncated()) ≡ "truncated GGUF header"
        assert _result(_wrong_alignment_kind(7, _u8(1))) ≡ "general.alignment must use GGUF UINT32 wire kind"
        assert _result(_wrong_alignment_kind(4, _u32(3))) ≡ "general.alignment must be a positive power of two"
        assert _result(_malformed_value(7, _u8(2))) ≡ "malformed GGUF bool value"
        assert _result(_malformed_value(8, _iunge(_u64(1), [255]))) ≡ "GGUF string is not valid UTF-8"
    }
    test "rejects duplicate keys/names, bounds, overlap, and data bytes" {
        assert _result(_duplicate_metadata()) ≡ "duplicate GGUF metadata key: general.architecture"
        assert _result(_duplicate_tensors()) ≡ "duplicate GGUF tensor name: same"
        assert _result(_dimension_ceiling()) ≡ "tensor dimension is outside the bounded range"
        assert _result(_element_overflow()) ≡ "tensor element count exceeds the bounded range"
        assert _result(_rank_zero()) ≡ "tensor rank must be at least one"
        assert _result(_non_block_quant()) ≡ "tensor first dimension is not a complete GGML block"
        assert _result(_known_out_of_file()) ≡ "known GGML tensor range exceeds the artifact"
        assert _result(_unknown_out_of_file()) ≡ "GGML tensor offset exceeds the artifact"
        assert _result(_offset_overflow()) ≡ "checked offset addition overflow"
        assert _result(_overlap()) ≡ "known GGML tensor ranges overlap"
        assert _result(_extra_data_region()) ≡ "bounded GGUF corpus contains bytes from the data region"
        assert _result(_identity_mismatch()) ≡ "content identity does not match the supplied artifact length"
    }
    test "preserves all thirteen metadata wire kinds and exact payload bytes" {
        assert _metadata_wire_result()
    }
    test "keeps BOOL parseable while numerum rejects BOOL and floating values" {
        assert _metadata_bool_float_result()
        do {
            const manifestum.GgufManifest m ← manifestum.parse(_metadata_corpus())
            assert manifestum.metadata(m, "wire.bool").dtype ≡ 7
            assert _number_observa(m, "wire.bool") ≡ "ERR:metadata value is not an unsigned integer"
        }
        catch err {
            assert false
        }
    }
    test "observes default/custom data starts, descriptor ranges, and legal reorder/gaps" {
        assert _descriptor_result(_llama(), "blk.0.attn_norm.weight") ≡ "288/160/8"
        assert _descriptor_result(_qwen2(), "blk.0.attn_norm.weight") ≡ "384/192/4"
        assert _descriptor_result(_reordered_gapped(), "b") ≡ "128/160/4"
    }
    test "accepts a corpus ending at table end or inside alignment padding" {
        assert _result(_table_end()) ≡ "ok"
        assert _result(_padding_end()) ≡ "ok"
        do {
            const manifestum.GgufManifest exactum ← manifestum.parse(_table_end())
            const manifestum.GgufManifest partiale ← manifestum.parse(_padding_end())
            assert exactum.data_inceptum ≡ 96
            assert partiale.data_inceptum ≡ 96
            assert exactum.artifact_length ≡ 96
            assert partiale.artifact_length ≡ 96
        }
        catch err {
            assert false
        }
    }
    test "inspects the bounded table through a caller-owned range source" {
        assert _inspect_result(false) ≡ "llama/288"
        assert _inspect_result(true) ≡ "range source failed: synthetic read failed"
    }
    test "reads an exact checked tensor fragment" {
        assert _fragment_result() ≡ "exact-bytes"
    }
}

# A3-C2-U1 payload-range accessor (LIB-03). Renders the exact stored byte
# range of one known-layout tensor as "initium/longitudo", or the typed error.
fn _limes_result(manifestum.GgufCorpus corpus, string nomen) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        const iuncta<int, int> limes ← manifestum.limes_payloadis(m, nomen)
        return ((limes[0] ↦ string) + "/") + (limes[1] ↦ string)
    }
    catch err {
        return manifestum.message(err)
    }
}

describe "A3-C2-U1 limes_payloadis payload-range accessor" {
    test "returns the exact stored byte range of one known-layout tensor" {
        assert _limes_result(_llama(), "token_embd.weight") ≡ "288/128"
        assert _limes_result(_llama(), "blk.0.attn_norm.weight") ≡ "448/16"
        assert _limes_result(_qwen2(), "blk.0.attn_q.weight") ≡ "384/144"
        assert _limes_result(_qwen2(), "blk.0.attn_norm.weight") ≡ "576/16"
        assert _limes_result(_qwen35moe(), "blk.0.attn_norm.weight") ≡ "576/8"
    }
    test "passes through inveni_tensorem for an unknown tensor name" {
        assert _limes_result(_llama(), "no.such.tensor") ≡ "tensor not found: no.such.tensor"
    }
    test "fails closed on an unknown (Ignota) layout" {
        assert _limes_result(_qwen35moe(), "blk.0.experts.0.weight") ≡ "tensor layout is unknown; payload range is unavailable"
    }
}

describe "LIB-02-U1 tokenizer metadata accessors" {
    test "returns the exact token/merge counts and pinned special ids from the tokenizer metadata block" {
        assert _tokenizer_array_result()
    }
    test "rejects missing, malformed, and duplicate tokenizer keys with typed GgufManifestError rows" {
        assert _textorum_error(_tokenizer_corpus(), "tokenizer.ggml.max_token_id") ≡ "metadata key not found: tokenizer.ggml.max_token_id"
        assert _textorum_error(_tokenizer_corpus(), "tokenizer.ggml.bos_token_id") ≡ "metadata value is not a GGUF string array"
        assert _numerorum_error(_tokenizer_corpus(), "tokenizer.ggml.tokens") ≡ "metadata array is not an integer array"
        assert _numerorum_error(_tokenizer_corpus(), "tokenizer.chat_template") ≡ "metadata value is not a GGUF integer array"
        assert _result(_duplicate_tokenizer_key()) ≡ "duplicate GGUF metadata key: tokenizer.ggml.tokens"
    }
}

# MODEL-01-M1 architecture-facing typed accessors (MODEL-01 chain). Pins the
# frozen qwen35moe facts through the new typed reads: the array-of-uint32
# read (rope.dimension_sections → [11, 11, 10, 0]), the bool read
# (add_bos_token → falsum), and the array-length read (tokenizer identity
# counts 248320 / 248320 / 247587). No parser behavior change.
fn _qwen35moe_facts_corpus() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(0, 3)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen35moe")))
    table ← _iunge(table, _kv("qwen35moe.rope.dimension_sections", 9, _array(4, 4, _iunge(_iunge(_u32(11), _u32(11)), _iunge(_u32(10), _u32(0))))))
    table ← _iunge(table, _kv("tokenizer.ggml.add_bos_token", 7, _u8(0)))
    return _plenum(table, 32, 0)
}

fn _m1_u32_error(manifestum.GgufCorpus corpus, string clavis) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        const list<int> _ ← manifestum.numerorum_u32(m, clavis)
        return "unexpected-success"
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _m1_bool_error(manifestum.GgufCorpus corpus, string clavis) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        const bool _ ← manifestum.boleanum(m, clavis)
        return "unexpected-success"
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _m1_length_error(manifestum.GgufCorpus corpus, string clavis) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        const int _ ← manifestum.longitudo_listae(m, clavis)
        return "unexpected-success"
    }
    catch err {
        return manifestum.message(err)
    }
}

describe "MODEL-01-M1 architecture-facing typed accessors" {
    test "decodes qwen35moe.rope.dimension_sections to the frozen [11, 11, 10, 0]" {
        do {
            const manifestum.GgufManifest m ← manifestum.parse(_qwen35moe_facts_corpus())
            const list<int> sections ← manifestum.numerorum_u32(m, "qwen35moe.rope.dimension_sections")
            assert sections.length() ≡ 4
            assert (sections.get(0) coalesce 0) ≡ 11
            assert (sections.get(1) coalesce 0) ≡ 11
            assert (sections.get(2) coalesce 0) ≡ 10
            assert (sections.get(3) coalesce 0) ≡ 0
        }
        catch err {
            assert false
        }
    }
    test "decodes tokenizer.ggml.add_bos_token to falsum" {
        do {
            const manifestum.GgufManifest m ← manifestum.parse(_qwen35moe_facts_corpus())
            assert manifestum.boleanum(m, "tokenizer.ggml.add_bos_token") ≡ false
        }
        catch err {
            assert false
        }
    }
    test "reads the pinned tokenizer array lengths (248320 / 248320 / 247587) without decoding elements" {
        do {
            const manifestum.GgufManifest m ← manifestum.parse(_tokenizer_corpus())
            assert manifestum.longitudo_listae(m, "tokenizer.ggml.tokens") ≡ TOKENS_PIN
            assert manifestum.longitudo_listae(m, "tokenizer.ggml.token_type") ≡ TOKENS_PIN
            assert manifestum.longitudo_listae(m, "tokenizer.ggml.merges") ≡ MERGES_PIN
        }
        catch err {
            assert false
        }
    }
    test "rejects missing, wrong-kind, and non-u32-array keys with typed GgufManifestError rows" {
        assert _m1_u32_error(_tokenizer_corpus(), "tokenizer.ggml.tokens") ≡ "metadata array is not a u32 array"
        assert _m1_u32_error(_tokenizer_corpus(), "tokenizer.ggml.bos_token_id") ≡ "metadata value is not a GGUF u32 array"
        assert _m1_u32_error(_metadata_corpus(), "wire.array") ≡ "metadata array is not a u32 array"
        assert _m1_u32_error(_tokenizer_corpus(), "tokenizer.ggml.max_token_id") ≡ "metadata key not found: tokenizer.ggml.max_token_id"
        assert _m1_bool_error(_tokenizer_corpus(), "tokenizer.ggml.bos_token_id") ≡ "metadata value is not a GGUF bool"
        assert _m1_bool_error(_tokenizer_corpus(), "tokenizer.ggml.add_bos_token") ≡ "metadata key not found: tokenizer.ggml.add_bos_token"
        assert _m1_length_error(_tokenizer_corpus(), "tokenizer.ggml.bos_token_id") ≡ "metadata value is not a GGUF array"
        assert _m1_length_error(_tokenizer_corpus(), "tokenizer.ggml.add_bos_token") ≡ "metadata key not found: tokenizer.ggml.add_bos_token"
    }
}
