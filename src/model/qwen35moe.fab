+++
locale = "la"
+++
# qwen35moe typed configuration genus and metadata freeze (MODEL-01-M3).
#
# Public import: importa ex "gradus:model/qwen35moe" qwen35moe
# Depends on: gradus:model/gguf_manifest (typed metadata accessors) and
# gradus:model/artifact (pathless content identity).
#
# `congela` freezes the frozen qwen35moe configuration rows from a parsed
# GGUF manifest — every row of the Frozen Architecture Configuration table in
# the MODEL-01 delivery (architecture/quantization, block/embedding,
# attention, rope, expert, SSM, nextn, and the tokenizer identity facts) —
# and enforces the 55-entry metadata count. Mutation family 1 fails closed
# with a typed divergence diagnostic naming the first diverging key: any
# frozen value changed, a required key missing, or an extra unknown
# `qwen35moe.*` key that shadows a required fact. Tokenizer facts are frozen
# as identity only; tokenizer execution is GGUF-A2's unit.

importa ex "gradus:model/artifact" artifact
importa ex "gradus:model/gguf_manifest" manifestum

fixum numerus METADATA_PIN ← 55
fixum numerus GGUF_FLOAT32 ← 6
fixum numerus PRAEFIXUM_QWEN ← 10

@ publica
genus ConfiguratioQwen35moe {
    textus architectura
    numerus typus_limaturae
    numerus versio_quantificationis
    numerus numerus_tractuum
    numerus longitudo_contextus
    numerus longitudo_vestimenti
    numerus numerus_capita
    numerus numerus_capita_kv
    numerus longitudo_clavis
    numerus longitudo_valoris
    f32 epsilon_normae_rms
    f32 basis_frequentiae
    numerus numerus_dimensionum_rotae
    lista<numerus> sectiones_rotae
    numerus numerus_expertorum
    numerus numerus_expertorum_activorum
    numerus longitudo_ffn_experti
    numerus longitudo_ffn_communi
    numerus nucleus_convolutus
    numerus magnitudo_status
    numerus numerus_coetuum
    numerus gradus_temporis
    numerus magnitudo_interior
    numerus intervallum_attentionis_plenae
    numerus numerus_strata_nextn
    textus exemplum_tokenizoris
    textus praeparatio_tokenizoris
    numerus numerus_tokenum
    numerus numerus_typorum_tokenum
    numerus numerus_concatenationum
    numerus eos_token_id
    numerus padding_token_id
    numerus bos_token_id
    bivalens add_bos_token
}

@ publica
discretio ErrorConfiguratioQwen35moe {
    MetadatumDiversum { textus clavis }
}

@ publica
functio causa(ErrorConfiguratioQwen35moe e) → textus {
    discerne e {
        casu MetadatumDiversum fixum clavis {
            redde "qwen35moe metadata divergence at " + clavis
        }
    }
}

# -------------------------------------------------------------------------
# Required-key membership for the extra-unknown-key scan.
# -------------------------------------------------------------------------

@ privata
functio _clavis_requisita_qwen(textus clavis) → bivalens {
    si clavis ≡ "qwen35moe.block_count" ergo redde verum
    si clavis ≡ "qwen35moe.context_length" ergo redde verum
    si clavis ≡ "qwen35moe.embedding_length" ergo redde verum
    si clavis ≡ "qwen35moe.attention.head_count" ergo redde verum
    si clavis ≡ "qwen35moe.attention.head_count_kv" ergo redde verum
    si clavis ≡ "qwen35moe.attention.key_length" ergo redde verum
    si clavis ≡ "qwen35moe.attention.value_length" ergo redde verum
    si clavis ≡ "qwen35moe.attention.layer_norm_rms_epsilon" ergo redde verum
    si clavis ≡ "qwen35moe.rope.freq_base" ergo redde verum
    si clavis ≡ "qwen35moe.rope.dimension_count" ergo redde verum
    si clavis ≡ "qwen35moe.rope.dimension_sections" ergo redde verum
    si clavis ≡ "qwen35moe.expert_count" ergo redde verum
    si clavis ≡ "qwen35moe.expert_used_count" ergo redde verum
    si clavis ≡ "qwen35moe.expert_feed_forward_length" ergo redde verum
    si clavis ≡ "qwen35moe.expert_shared_feed_forward_length" ergo redde verum
    si clavis ≡ "qwen35moe.ssm.conv_kernel" ergo redde verum
    si clavis ≡ "qwen35moe.ssm.state_size" ergo redde verum
    si clavis ≡ "qwen35moe.ssm.group_count" ergo redde verum
    si clavis ≡ "qwen35moe.ssm.time_step_rank" ergo redde verum
    si clavis ≡ "qwen35moe.ssm.inner_size" ergo redde verum
    si clavis ≡ "qwen35moe.full_attention_interval" ergo redde verum
    si clavis ≡ "qwen35moe.nextn_predict_layers" ergo redde verum
    redde falsum
}

# The first extra `qwen35moe.*` key outside the frozen set, or nihil.
@ privata
functio _clavis_qwen_ignota(manifestum.ManifestumGguf m) → textus ∪ nihil {
    itera ex m.metadata fixum meta {
        si meta.clavis.longitudo() ≥ PRAEFIXUM_QWEN et meta.clavis.sectio(0, PRAEFIXUM_QWEN) ≡ "qwen35moe." et non (_clavis_requisita_qwen(meta.clavis)) {
            redde meta.clavis
        }
    }
    redde nihil
}

# -------------------------------------------------------------------------
# Byte and float32-wire helpers (value arithmetic, the dequant seam).
# -------------------------------------------------------------------------

@ privata
functio _octeti_lista(octeti o) → lista<numerus<u8>> {
    fixum valor wire ← o ↦ valor
    fixum lista<numerus> numeri ← wire ↦ lista<numerus>
    varia lista<numerus<u8>> out ← vacua
    itera ex numeri fixum v {
        out.appende(v ∷ numerus<u8>)
    }
    redde out
}

@ privata
functio _byte(lista<numerus<u8>> b, numerus off) → numerus {
    redde (b.accipe(off) vel (0 ∷ numerus<u8>)) ↦ numerus
}

@ privata
functio _potentia_duorum(numerus n) → fractus {
    varia fractus result ← 1.0
    si n ≥ 0 {
        varia numerus i ← 0
        dum i < n {
            result ← result * 2.0
            i ← i + 1
        }
    } secus {
        varia numerus i ← n
        dum i < 0 {
            result ← result / 2.0
            i ← i + 1
        }
    }
    redde result
}

# 4 little-endian bytes -> exact f32 VALUE (IEEE-754 binary32 decode, the
# dequant `_f32le` seam). Infinity or a NaN payload decodes to a value that
# can never equal either frozen float fact, so the freeze comparison fails
# closed without a special NaN branch.
@ privata
functio _f32_le(lista<numerus<u8>> b, numerus off) → f32 {
    fixum numerus b0 ← _byte(b, off)
    fixum numerus b1 ← _byte(b, off + 1)
    fixum numerus b2 ← _byte(b, off + 2)
    fixum numerus b3 ← _byte(b, off + 3)
    fixum numerus raw ← (b3 * 16777216) + (b2 * 65536) + (b1 * 256) + b0
    fixum numerus sign ← (raw ⇒ 31) % 2
    fixum numerus exp ← (raw ⇒ 23) % 256
    fixum numerus frac ← raw % 8388608
    varia fractus sign_factor ← 1.0
    si sign ≠ 0 {
        sign_factor ← -1.0
    }
    fixum fractus frac_ratio ← (frac ↦ fractus) / 8388608.0
    si exp ≡ 0 {
        si frac ≡ 0 {
            redde (sign_factor * 0.0) ↦ f32
        }
        fixum fractus power ← _potentia_duorum(-126)
        redde (sign_factor * power * frac_ratio) ↦ f32
    }
    fixum fractus power ← _potentia_duorum(exp - 127)
    redde (sign_factor * power * (1.0 + frac_ratio)) ↦ f32
}

# -------------------------------------------------------------------------
# Typed read-and-pin accessors. Every accessor maps a missing or malformed
# key to a divergence diagnostic naming that key, then compares the read
# value against the frozen expectation. First divergence wins.
# -------------------------------------------------------------------------

@ privata
functio _exige_meta(manifestum.ManifestumGguf m, textus clavis) → manifestum.MetadatumGguf ⇥ ErrorConfiguratioQwen35moe {
    fac {
        redde manifestum.metadatum(m, clavis)
    }
    cape err {
        iace finge MetadatumDiversum { clavis = clavis }
    }
}

@ privata
functio _exige_numerum(manifestum.ManifestumGguf m, textus clavis, numerus expectatum) → numerus ⇥ ErrorConfiguratioQwen35moe {
    varia numerus observatum ← 0
    fac {
        observatum ← manifestum.numerum(m, clavis)
    }
    cape err {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si observatum ≠ expectatum {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    redde observatum
}

@ privata
functio _exige_textum(manifestum.ManifestumGguf m, textus clavis, textus expectatum) → textus ⇥ ErrorConfiguratioQwen35moe {
    varia textus observatum ← ""
    fac {
        observatum ← manifestum.textum(m, clavis)
    }
    cape err {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si observatum ≠ expectatum {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    redde observatum
}

@ privata
functio _exige_bool(manifestum.ManifestumGguf m, textus clavis, bivalens expectatum) → bivalens ⇥ ErrorConfiguratioQwen35moe {
    varia bivalens observatum ← falsum
    fac {
        observatum ← manifestum.boleanum(m, clavis)
    }
    cape err {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si observatum ≠ expectatum {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    redde observatum
}

@ privata
functio _exige_longitudo(manifestum.ManifestumGguf m, textus clavis, numerus expectatum) → numerus ⇥ ErrorConfiguratioQwen35moe {
    varia numerus observatum ← 0
    fac {
        observatum ← manifestum.longitudo_listae(m, clavis)
    }
    cape err {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si observatum ≠ expectatum {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    redde observatum
}

@ privata
functio _exige_f32(manifestum.ManifestumGguf m, textus clavis, f32 expectatum) → f32 ⇥ ErrorConfiguratioQwen35moe {
    fixum manifestum.MetadatumGguf meta ← _exige_meta(m, clavis)
    si meta.typo ≠ GGUF_FLOAT32 {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    fixum f32 observatum ← _f32_le(_octeti_lista(meta.valor_wire), 0)
    si non (observatum ≡ expectatum) {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    redde observatum
}

@ privata
functio _exige_sectiones(manifestum.ManifestumGguf m, textus clavis) → lista<numerus> ⇥ ErrorConfiguratioQwen35moe {
    varia lista<numerus> observata ← vacua
    fac {
        observata ← manifestum.numerorum(m, clavis)
    }
    cape err {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si observata.longitudo() ≠ 4 {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si (observata.accipe(0) vel 0) ≠ 11 {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si (observata.accipe(1) vel 0) ≠ 11 {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si (observata.accipe(2) vel 0) ≠ 10 {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si (observata.accipe(3) vel 0) ≠ 0 {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    redde observata
}

# Freeze the frozen qwen35moe configuration. Reads are in the delivery table
# order, so the first diverging fact is deterministic.
@ publica
functio congela(manifestum.ManifestumGguf m) → ConfiguratioQwen35moe ⇥ ErrorConfiguratioQwen35moe {
    fixum textus architectura ← _exige_textum(m, "general.architecture", "qwen35moe")
    fixum numerus typus_limaturae ← _exige_numerum(m, "general.file_type", 15)
    fixum numerus versio_quantificationis ← _exige_numerum(m, "general.quantization_version", 2)
    fixum numerus numerus_tractuum ← _exige_numerum(m, "qwen35moe.block_count", 41)
    fixum numerus longitudo_contextus ← _exige_numerum(m, "qwen35moe.context_length", 262144)
    fixum numerus longitudo_vestimenti ← _exige_numerum(m, "qwen35moe.embedding_length", 2048)
    fixum numerus numerus_capita ← _exige_numerum(m, "qwen35moe.attention.head_count", 16)
    fixum numerus numerus_capita_kv ← _exige_numerum(m, "qwen35moe.attention.head_count_kv", 2)
    fixum numerus longitudo_clavis ← _exige_numerum(m, "qwen35moe.attention.key_length", 256)
    fixum numerus longitudo_valoris ← _exige_numerum(m, "qwen35moe.attention.value_length", 256)
    fixum f32 epsilon_normae_rms ← _exige_f32(m, "qwen35moe.attention.layer_norm_rms_epsilon", (0.0000009999999974752427 ∷ f32))
    fixum f32 basis_frequentiae ← _exige_f32(m, "qwen35moe.rope.freq_base", (10000000.0 ∷ f32))
    fixum numerus numerus_dimensionum_rotae ← _exige_numerum(m, "qwen35moe.rope.dimension_count", 64)
    fixum lista<numerus> sectiones_rotae ← _exige_sectiones(m, "qwen35moe.rope.dimension_sections")
    fixum numerus numerus_expertorum ← _exige_numerum(m, "qwen35moe.expert_count", 256)
    fixum numerus numerus_expertorum_activorum ← _exige_numerum(m, "qwen35moe.expert_used_count", 8)
    fixum numerus longitudo_ffn_experti ← _exige_numerum(m, "qwen35moe.expert_feed_forward_length", 512)
    fixum numerus longitudo_ffn_communi ← _exige_numerum(m, "qwen35moe.expert_shared_feed_forward_length", 512)
    fixum numerus nucleus_convolutus ← _exige_numerum(m, "qwen35moe.ssm.conv_kernel", 4)
    fixum numerus magnitudo_status ← _exige_numerum(m, "qwen35moe.ssm.state_size", 128)
    fixum numerus numerus_coetuum ← _exige_numerum(m, "qwen35moe.ssm.group_count", 16)
    fixum numerus gradus_temporis ← _exige_numerum(m, "qwen35moe.ssm.time_step_rank", 32)
    fixum numerus magnitudo_interior ← _exige_numerum(m, "qwen35moe.ssm.inner_size", 4096)
    fixum numerus intervallum_attentionis_plenae ← _exige_numerum(m, "qwen35moe.full_attention_interval", 4)
    fixum numerus numerus_strata_nextn ← _exige_numerum(m, "qwen35moe.nextn_predict_layers", 1)
    fixum textus exemplum_tokenizoris ← _exige_textum(m, "tokenizer.ggml.model", "gpt2")
    fixum textus praeparatio_tokenizoris ← _exige_textum(m, "tokenizer.ggml.pre", "qwen35")
    fixum numerus numerus_tokenum ← _exige_longitudo(m, "tokenizer.ggml.tokens", 248320)
    fixum numerus numerus_typorum_tokenum ← _exige_longitudo(m, "tokenizer.ggml.token_type", 248320)
    fixum numerus numerus_concatenationum ← _exige_longitudo(m, "tokenizer.ggml.merges", 247587)
    fixum numerus eos_token_id ← _exige_numerum(m, "tokenizer.ggml.eos_token_id", 248046)
    fixum numerus padding_token_id ← _exige_numerum(m, "tokenizer.ggml.padding_token_id", 248055)
    fixum numerus bos_token_id ← _exige_numerum(m, "tokenizer.ggml.bos_token_id", 248044)
    fixum bivalens add_bos_token ← _exige_bool(m, "tokenizer.ggml.add_bos_token", falsum)

    fixum textus ∪ nihil ignota ← _clavis_qwen_ignota(m)
    si ignota non est nihil {
        iace finge MetadatumDiversum { clavis = ignota vel "" }
    }

    si m.metadata.longitudo() ≠ METADATA_PIN {
        iace finge MetadatumDiversum { clavis = "metadata count" }
    }

    redde ConfiguratioQwen35moe {
        architectura = architectura,
        typus_limaturae = typus_limaturae,
        versio_quantificationis = versio_quantificationis,
        numerus_tractuum = numerus_tractuum,
        longitudo_contextus = longitudo_contextus,
        longitudo_vestimenti = longitudo_vestimenti,
        numerus_capita = numerus_capita,
        numerus_capita_kv = numerus_capita_kv,
        longitudo_clavis = longitudo_clavis,
        longitudo_valoris = longitudo_valoris,
        epsilon_normae_rms = epsilon_normae_rms,
        basis_frequentiae = basis_frequentiae,
        numerus_dimensionum_rotae = numerus_dimensionum_rotae,
        sectiones_rotae = sectiones_rotae,
        numerus_expertorum = numerus_expertorum,
        numerus_expertorum_activorum = numerus_expertorum_activorum,
        longitudo_ffn_experti = longitudo_ffn_experti,
        longitudo_ffn_communi = longitudo_ffn_communi,
        nucleus_convolutus = nucleus_convolutus,
        magnitudo_status = magnitudo_status,
        numerus_coetuum = numerus_coetuum,
        gradus_temporis = gradus_temporis,
        magnitudo_interior = magnitudo_interior,
        intervallum_attentionis_plenae = intervallum_attentionis_plenae,
        numerus_strata_nextn = numerus_strata_nextn,
        exemplum_tokenizoris = exemplum_tokenizoris,
        praeparatio_tokenizoris = praeparatio_tokenizoris,
        numerus_tokenum = numerus_tokenum,
        numerus_typorum_tokenum = numerus_typorum_tokenum,
        numerus_concatenationum = numerus_concatenationum,
        eos_token_id = eos_token_id,
        padding_token_id = padding_token_id,
        bos_token_id = bos_token_id,
        add_bos_token = add_bos_token
    }
}

# -------------------------------------------------------------------------
# MODEL-01-M4: canonical 753-tensor map + 41-block schedule.
#
# `tensores_canonici` admits the four exact family sets from the Canonical
# 753-Tensor Map in the MODEL-01 delivery: global 3 (output.weight /
# output_norm.weight / token_embd.weight), hybrid 19x30, full-attention
# 16x10, and the nextn 20 on blk.40 — every tensor's exact stored shape and
# storage row. The schedule is structural: 41 block indices 0..40, full
# attention at index ≡ 3 mod 4, blk.40 the sole nextn block
# (`nextn_predict_layers` = 1). Anomalies are preserved per-tensor, never
# collapsed to one global storage row: blk.40's ffn_gate_inp.weight and
# ffn_gate_inp_shexp.weight are bf16 (f32 in every other block), and
# ffn_down_exps.weight is q6_K in blk.34/38/39 (q5_K elsewhere). Block-40
# nextn/MTP rule (frozen): the 20 blk.40 tensors are admitted for map
# completeness; the main forward layer schedule is blocks 0..39 and the
# admission claims no nextn/MTP execution semantics — those belong to
# GGUF-M2/M3/M4. Count invariants: 753 tensors total, 55 metadata entries,
# and the derived block-family and storage-distribution counts. Mutation
# families 2 (name), 3 (shape), 4 (storage), and 5 (count) fail closed with
# a typed first-divergence diagnostic naming the first diverging fact.
#
# GGML raw type ids (only the six canonical storage rows are admitted).
fixum numerus GGML_F32 ← 0
fixum numerus GGML_Q8_0 ← 8
fixum numerus GGML_Q4_K ← 12
fixum numerus GGML_Q5_K ← 13
fixum numerus GGML_Q6_K ← 14
fixum numerus GGML_BF16 ← 30

fixum numerus TENSORUM_PIN ← 753
fixum numerus TRACTUUM_PIN ← 41

@ publica
discretio ErrorTensorumQwen35moe {
    NomenDiversum { textus nomen },
    FormaDiversa { textus nomen },
    StipulaDiversa { textus nomen },
    NumerusDiversus { textus causa }
}

@ publica
functio causa_tensorum(ErrorTensorumQwen35moe e) → textus {
    discerne e {
        casu NomenDiversum fixum nomen { redde "qwen35moe tensor name divergence at " + nomen }
        casu FormaDiversa fixum nomen { redde "qwen35moe tensor shape divergence at " + nomen }
        casu StipulaDiversa fixum nomen { redde "qwen35moe tensor storage divergence at " + nomen }
        casu NumerusDiversus fixum causa { redde "qwen35moe tensor count divergence: " + causa }
    }
}

# Derived admission receipt: block-family and storage-distribution counts.
@ publica
genus SummaTensoriorumQwen {
    numerus totalis
    numerus globalium
    numerus hybridorum
    numerus attentionis_plenae
    numerus nextn
    numerus stipula_f32
    numerus stipula_q8_0
    numerus stipula_q4_k
    numerus stipula_q5_k
    numerus stipula_q6_k
    numerus stipula_bf16
    numerus experti_rank3
}

# One canonical expectation row (module-internal carrier).
genus TensorCanonicusQwen {
    textus nomen
    lista<numerus> forma
    numerus typo_ggml
}

# Block class: 0 = hybrid SSM/attention, 1 = full-attention (index ≡ 3 mod
# 4), 2 = the sole nextn block blk.40.
@ privata
functio _classis_blocki(numerus b) → numerus {
    si b ≡ 40 ergo redde 2
    si b % 4 ≡ 3 ergo redde 1
    redde 0
}

@ privata
functio _tensores_globales() → lista<TensorCanonicusQwen> {
    varia lista<TensorCanonicusQwen> out ← vacua
    out.appende(TensorCanonicusQwen { nomen = "output.weight", forma = [2048, 248320], typo_ggml = GGML_Q6_K })
    out.appende(TensorCanonicusQwen { nomen = "output_norm.weight", forma = [2048], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = "token_embd.weight", forma = [2048, 248320], typo_ggml = GGML_Q8_0 })
    redde out
}

# Hybrid SSM/attention block set (19); ffn_down_exps is q6_K in blk.34/38.
@ privata
functio _tensores_hybridae(numerus b) → lista<TensorCanonicusQwen> {
    fixum textus p ← "blk." + (b ↦ textus)
    varia numerus down_typo ← GGML_Q5_K
    si b ≡ 34 aut b ≡ 38 { down_typo ← GGML_Q6_K }
    varia lista<TensorCanonicusQwen> out ← vacua
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_gate.weight", forma = [2048, 4096], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_norm.weight", forma = [2048], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_qkv.weight", forma = [2048, 8192], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_down_exps.weight", forma = [512, 2048, 256], typo_ggml = down_typo })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_down_shexp.weight", forma = [512, 2048], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_gate_exps.weight", forma = [2048, 512, 256], typo_ggml = GGML_Q4_K })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_gate_inp.weight", forma = [2048, 256], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_gate_inp_shexp.weight", forma = [2048], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_gate_shexp.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_up_exps.weight", forma = [2048, 512, 256], typo_ggml = GGML_Q4_K })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_up_shexp.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".post_attention_norm.weight", forma = [2048], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ssm_a", forma = [32], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ssm_alpha.weight", forma = [2048, 32], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ssm_beta.weight", forma = [2048, 32], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ssm_conv1d.weight", forma = [4, 8192], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ssm_dt.bias", forma = [32], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ssm_norm.weight", forma = [128], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ssm_out.weight", forma = [4096, 2048], typo_ggml = GGML_Q8_0 })
    redde out
}

# Full-attention block set (16); ffn_down_exps is q6_K in blk.39.
@ privata
functio _tensores_plenae(numerus b) → lista<TensorCanonicusQwen> {
    fixum textus p ← "blk." + (b ↦ textus)
    varia numerus down_typo ← GGML_Q5_K
    si b ≡ 39 { down_typo ← GGML_Q6_K }
    varia lista<TensorCanonicusQwen> out ← vacua
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_k.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_k_norm.weight", forma = [256], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_norm.weight", forma = [2048], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_output.weight", forma = [4096, 2048], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_q.weight", forma = [2048, 8192], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_q_norm.weight", forma = [256], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_v.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_down_exps.weight", forma = [512, 2048, 256], typo_ggml = down_typo })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_down_shexp.weight", forma = [512, 2048], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_gate_exps.weight", forma = [2048, 512, 256], typo_ggml = GGML_Q4_K })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_gate_inp.weight", forma = [2048, 256], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_gate_inp_shexp.weight", forma = [2048], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_gate_shexp.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_up_exps.weight", forma = [2048, 512, 256], typo_ggml = GGML_Q4_K })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_up_shexp.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".post_attention_norm.weight", forma = [2048], typo_ggml = GGML_F32 })
    redde out
}

# Nextn block blk.40 set (20): the full-attention 16 with the frozen bf16
# anomaly on ffn_gate_inp / ffn_gate_inp_shexp, plus the four nextn.*
# tensors. ffn_down_exps stays q5_K (blk.40 is not in the q6_K anomaly set).
@ privata
functio _tensores_nextn() → lista<TensorCanonicusQwen> {
    fixum textus p ← "blk.40"
    varia lista<TensorCanonicusQwen> out ← vacua
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_k.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_k_norm.weight", forma = [256], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_norm.weight", forma = [2048], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_output.weight", forma = [4096, 2048], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_q.weight", forma = [2048, 8192], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_q_norm.weight", forma = [256], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".attn_v.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_down_exps.weight", forma = [512, 2048, 256], typo_ggml = GGML_Q5_K })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_down_shexp.weight", forma = [512, 2048], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_gate_exps.weight", forma = [2048, 512, 256], typo_ggml = GGML_Q4_K })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_gate_inp.weight", forma = [2048, 256], typo_ggml = GGML_BF16 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_gate_inp_shexp.weight", forma = [2048], typo_ggml = GGML_BF16 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_gate_shexp.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_up_exps.weight", forma = [2048, 512, 256], typo_ggml = GGML_Q4_K })
    out.appende(TensorCanonicusQwen { nomen = p + ".ffn_up_shexp.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".post_attention_norm.weight", forma = [2048], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".nextn.eh_proj.weight", forma = [4096, 2048], typo_ggml = GGML_Q8_0 })
    out.appende(TensorCanonicusQwen { nomen = p + ".nextn.enorm.weight", forma = [2048], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".nextn.hnorm.weight", forma = [2048], typo_ggml = GGML_F32 })
    out.appende(TensorCanonicusQwen { nomen = p + ".nextn.shared_head_norm.weight", forma = [2048], typo_ggml = GGML_F32 })
    redde out
}

@ privata
functio _canonici_blocki(numerus b) → lista<TensorCanonicusQwen> {
    si b ≡ 40 ergo redde _tensores_nextn()
    si b % 4 ≡ 3 ergo redde _tensores_plenae(b)
    redde _tensores_hybridae(b)
}

# Locate one canonical tensor in the manifest; a missing name is the family-2
# divergence (the manifest's own duplicate-name rejection runs at parse time).
@ privata
functio _inveni(manifestum.ManifestumGguf m, textus nomen) → manifestum.DescriptioTensorisGguf ⇥ ErrorTensorumQwen35moe {
    fac {
        redde manifestum.inveni_tensorem(m, nomen)
    }
    cape err {
        iace finge NomenDiversum { nomen = nomen }
    }
}

# Name -> shape -> storage check order makes the first diverging fact
# deterministic per canonical entry.
@ privata
functio _exige(manifestum.ManifestumGguf m, TensorCanonicusQwen c) → bivalens ⇥ ErrorTensorumQwen35moe {
    fixum manifestum.DescriptioTensorisGguf tensor ← _inveni(m, c.nomen)
    si tensor.forma.longitudo() ≠ c.forma.longitudo() {
        iace finge FormaDiversa { nomen = c.nomen }
    }
    varia numerus i ← 0
    dum i < c.forma.longitudo() {
        si (tensor.forma.accipe(i) vel 0) ≠ (c.forma.accipe(i) vel 0) {
            iace finge FormaDiversa { nomen = c.nomen }
        }
        i ↑
    }
    si tensor.typo_ggml ≠ c.typo_ggml {
        iace finge StipulaDiversa { nomen = c.nomen }
    }
    redde verum
}

# Admit the canonical map: count invariants fail closed first (family 5),
# then every canonical tensor is matched name/shape/storage in canonical
# order (families 2-4). The receipt counts are derived, so the schedule and
# storage distribution are proven from the admitted tensors themselves.
@ publica
functio tensores_canonici(manifestum.ManifestumGguf m) → SummaTensoriorumQwen ⇥ ErrorTensorumQwen35moe {
    si m.tensores.longitudo() ≠ TENSORUM_PIN {
        iace finge NumerusDiversus { causa = "tensor count " + (m.tensores.longitudo() ↦ textus) + " ≠ " + (TENSORUM_PIN ↦ textus) }
    }
    si m.metadata.longitudo() ≠ METADATA_PIN {
        iace finge NumerusDiversus { causa = "metadata count " + (m.metadata.longitudo() ↦ textus) + " ≠ " + (METADATA_PIN ↦ textus) }
    }

    varia numerus n_globalium ← 0
    varia numerus n_hybridorum ← 0
    varia numerus n_plenarum ← 0
    varia numerus n_nextn ← 0
    varia numerus n_f32 ← 0
    varia numerus n_q8_0 ← 0
    varia numerus n_q4_k ← 0
    varia numerus n_q5_k ← 0
    varia numerus n_q6_k ← 0
    varia numerus n_bf16 ← 0
    varia numerus n_rank3 ← 0

    fixum lista<TensorCanonicusQwen> globals ← _tensores_globales()
    itera ex globals fixum c {
        _exige(m, c)
        n_globalium ↑
        si c.typo_ggml ≡ GGML_F32 ergo n_f32 ↑
        si c.typo_ggml ≡ GGML_Q8_0 ergo n_q8_0 ↑
        si c.typo_ggml ≡ GGML_Q6_K ergo n_q6_k ↑
    }

    varia numerus b ← 0
    dum b < TRACTUUM_PIN {
        fixum lista<TensorCanonicusQwen> canon ← _canonici_blocki(b)
        fixum numerus classis ← _classis_blocki(b)
        itera ex canon fixum c {
            _exige(m, c)
            si classis ≡ 0 ergo n_hybridorum ↑
            si classis ≡ 1 ergo n_plenarum ↑
            si classis ≡ 2 ergo n_nextn ↑
            si c.typo_ggml ≡ GGML_F32 ergo n_f32 ↑
            si c.typo_ggml ≡ GGML_Q8_0 ergo n_q8_0 ↑
            si c.typo_ggml ≡ GGML_Q4_K ergo n_q4_k ↑
            si c.typo_ggml ≡ GGML_Q5_K ergo n_q5_k ↑
            si c.typo_ggml ≡ GGML_Q6_K ergo n_q6_k ↑
            si c.typo_ggml ≡ GGML_BF16 ergo n_bf16 ↑
            si c.forma.longitudo() ≡ 3 ergo n_rank3 ↑
        }
        b ↑
    }

    redde SummaTensoriorumQwen {
        totalis = TENSORUM_PIN,
        globalium = n_globalium,
        hybridorum = n_hybridorum,
        attentionis_plenae = n_plenarum,
        nextn = n_nextn,
        stipula_f32 = n_f32,
        stipula_q8_0 = n_q8_0,
        stipula_q4_k = n_q4_k,
        stipula_q5_k = n_q5_k,
        stipula_q6_k = n_q6_k,
        stipula_bf16 = n_bf16,
        experti_rank3 = n_rank3
    }
}

# -------------------------------------------------------------------------
# MODEL-01-M5: dimension/storage cross-reference validation.
#
# `referantia` cross-references the frozen configuration (M3) against the
# manifest tensors, deriving every expected dim from the config so a
# config/tensor pair that is individually frozen can still diverge:
# `embedding_length` at its stored-dim positions per family,
# `expert_count` as rank-3 dim 2 of the three `*_exps` tensors and dim 1 of
# `ffn_gate_inp`, `expert_feed_forward_length` at the down/gate-up
# positions, the ssm dims (`state_size` / `time_step_rank` / `conv_kernel`
# / `inner_size`), `head_count_kv` × `key_length` = dim 1 of
# `attn_k`/`attn_v` (norms carry 256), block-schedule consistency, element
# counts = product of stored dims, and the GGUF-A1a/A1b absolute range
# bound. The first diverging cross-fact fails with a typed diagnostic
# naming that tensor.
# -------------------------------------------------------------------------

@ publica
discretio ErrorReferentiaeQwen35moe {
    NomenIgnotum { textus nomen },
    DimensioDiversa { textus nomen },
    NumerusDivergens { textus causa },
    AmbitusMala { textus causa }
}

@ publica
functio causa_referantiae(ErrorReferentiaeQwen35moe e) → textus {
    discerne e {
        casu NomenIgnotum fixum nomen { redde "qwen35moe cross-reference name divergence at " + nomen }
        casu DimensioDiversa fixum nomen { redde "qwen35moe cross-reference dimension divergence at " + nomen }
        casu NumerusDivergens fixum causa { redde "qwen35moe cross-reference count divergence: " + causa }
        casu AmbitusMala fixum causa { redde "qwen35moe cross-reference range divergence: " + causa }
    }
}

@ privata
functio _refer_inveni(manifestum.ManifestumGguf m, textus nomen) → manifestum.DescriptioTensorisGguf ⇥ ErrorReferentiaeQwen35moe {
    fac {
        redde manifestum.inveni_tensorem(m, nomen)
    }
    cape err {
        iace finge NomenIgnotum { nomen = nomen }
    }
}

# Check one stored-dim position (GGUF file order); a rank below the index
# is itself the diverging fact.
@ privata
functio _refer_dim(manifestum.ManifestumGguf m, textus nomen, numerus index, numerus expectatum) → bivalens ⇥ ErrorReferentiaeQwen35moe {
    fixum manifestum.DescriptioTensorisGguf t ← _refer_inveni(m, nomen)
    si t.forma.longitudo() ≤ index {
        iace finge DimensioDiversa { nomen = nomen }
    }
    si (t.forma.accipe(index) vel 0) ≠ expectatum {
        iace finge DimensioDiversa { nomen = nomen }
    }
    redde verum
}

@ privata
functio _refer_gradu(manifestum.ManifestumGguf m, textus nomen, numerus expectatum) → bivalens ⇥ ErrorReferentiaeQwen35moe {
    fixum manifestum.DescriptioTensorisGguf t ← _refer_inveni(m, nomen)
    si t.forma.longitudo() ≠ expectatum {
        iace finge DimensioDiversa { nomen = nomen }
    }
    redde verum
}

# Single stored dim of the rank-1 norm tensors.
@ privata
functio _refer_unum(manifestum.ManifestumGguf m, textus nomen, numerus expectatum) → bivalens ⇥ ErrorReferentiaeQwen35moe {
    _refer_gradu(m, nomen, 1)
    _refer_dim(m, nomen, 0, expectatum)
    redde verum
}

# The expert family, shared by every block class. Down stores
# [ffn, embd, experts]; gate/up store [embd, ffn, experts]; `ffn_gate_inp`
# carries [embd, experts].
@ privata
functio _refer_ffn(manifestum.ManifestumGguf m, ConfiguratioQwen35moe c, textus p) → bivalens ⇥ ErrorReferentiaeQwen35moe {
    _refer_dim(m, p + ".ffn_down_exps.weight", 0, c.longitudo_ffn_experti)
    _refer_dim(m, p + ".ffn_down_exps.weight", 1, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_down_exps.weight", 2, c.numerus_expertorum)
    _refer_dim(m, p + ".ffn_down_shexp.weight", 0, c.longitudo_ffn_experti)
    _refer_dim(m, p + ".ffn_down_shexp.weight", 1, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_gate_exps.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_gate_exps.weight", 1, c.longitudo_ffn_experti)
    _refer_dim(m, p + ".ffn_gate_exps.weight", 2, c.numerus_expertorum)
    _refer_dim(m, p + ".ffn_gate_inp.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_gate_inp.weight", 1, c.numerus_expertorum)
    _refer_unum(m, p + ".ffn_gate_inp_shexp.weight", c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_gate_shexp.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_gate_shexp.weight", 1, c.longitudo_ffn_experti)
    _refer_dim(m, p + ".ffn_up_exps.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_up_exps.weight", 1, c.longitudo_ffn_experti)
    _refer_dim(m, p + ".ffn_up_exps.weight", 2, c.numerus_expertorum)
    _refer_dim(m, p + ".ffn_up_shexp.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_up_shexp.weight", 1, c.longitudo_ffn_experti)
    redde verum
}

# Hybrid SSM/attention block family (19 blocks, index ≢ 3 mod 4, ≠ 40).
@ privata
functio _refer_hybrida(manifestum.ManifestumGguf m, ConfiguratioQwen35moe c, textus p) → bivalens ⇥ ErrorReferentiaeQwen35moe {
    _refer_dim(m, p + ".attn_gate.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".attn_gate.weight", 1, c.magnitudo_interior)
    _refer_unum(m, p + ".attn_norm.weight", c.longitudo_vestimenti)
    _refer_dim(m, p + ".attn_qkv.weight", 0, c.longitudo_vestimenti)
    _refer_ffn(m, c, p)
    _refer_unum(m, p + ".post_attention_norm.weight", c.longitudo_vestimenti)
    _refer_unum(m, p + ".ssm_a", c.gradus_temporis)
    _refer_dim(m, p + ".ssm_alpha.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ssm_alpha.weight", 1, c.gradus_temporis)
    _refer_dim(m, p + ".ssm_beta.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ssm_beta.weight", 1, c.gradus_temporis)
    _refer_dim(m, p + ".ssm_conv1d.weight", 0, c.nucleus_convolutus)
    _refer_unum(m, p + ".ssm_dt.bias", c.gradus_temporis)
    _refer_unum(m, p + ".ssm_norm.weight", c.magnitudo_status)
    _refer_dim(m, p + ".ssm_out.weight", 0, c.magnitudo_interior)
    _refer_dim(m, p + ".ssm_out.weight", 1, c.longitudo_vestimenti)
    redde verum
}

# Full-attention block family core (16 blocks, index ≡ 3 mod 4).
@ privata
functio _refer_plena_core(manifestum.ManifestumGguf m, ConfiguratioQwen35moe c, textus p) → bivalens ⇥ ErrorReferentiaeQwen35moe {
    fixum numerus kv_protensio ← c.numerus_capita_kv * c.longitudo_clavis
    _refer_dim(m, p + ".attn_k.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".attn_k.weight", 1, kv_protensio)
    _refer_unum(m, p + ".attn_k_norm.weight", c.longitudo_clavis)
    _refer_unum(m, p + ".attn_norm.weight", c.longitudo_vestimenti)
    _refer_dim(m, p + ".attn_output.weight", 0, c.magnitudo_interior)
    _refer_dim(m, p + ".attn_output.weight", 1, c.longitudo_vestimenti)
    _refer_dim(m, p + ".attn_q.weight", 0, c.longitudo_vestimenti)
    _refer_unum(m, p + ".attn_q_norm.weight", c.longitudo_clavis)
    _refer_dim(m, p + ".attn_v.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".attn_v.weight", 1, kv_protensio)
    _refer_ffn(m, c, p)
    _refer_unum(m, p + ".post_attention_norm.weight", c.longitudo_vestimenti)
    redde verum
}

# Cross-reference the frozen config against the manifest. Block families
# run in schedule order so the first diverging cross-fact is deterministic.
@ publica
functio referantia(ConfiguratioQwen35moe c, manifestum.ManifestumGguf m) → bivalens ⇥ ErrorReferentiaeQwen35moe {
    _refer_dim(m, "output.weight", 0, c.longitudo_vestimenti)
    _refer_unum(m, "output_norm.weight", c.longitudo_vestimenti)
    _refer_dim(m, "token_embd.weight", 0, c.longitudo_vestimenti)

    varia numerus n_plenae ← 0
    varia numerus n_nextn ← 0
    varia numerus b ← 0
    dum b < TRACTUUM_PIN {
        fixum textus p ← "blk." + (b ↦ textus)
        si b ≡ 40 {
            _refer_plena_core(m, c, p)
            _refer_dim(m, p + ".nextn.eh_proj.weight", 0, c.magnitudo_interior)
            _refer_dim(m, p + ".nextn.eh_proj.weight", 1, c.longitudo_vestimenti)
            _refer_unum(m, p + ".nextn.enorm.weight", c.longitudo_vestimenti)
            _refer_unum(m, p + ".nextn.hnorm.weight", c.longitudo_vestimenti)
            _refer_unum(m, p + ".nextn.shared_head_norm.weight", c.longitudo_vestimenti)
            n_nextn ↑
        } secus {
            si b % 4 ≡ 3 {
                _refer_plena_core(m, c, p)
                n_plenae ↑
            } secus {
                _refer_hybrida(m, c, p)
            }
        }
        b ↑
    }

    fixum numerus expectatae_plenae ← (TRACTUUM_PIN - 1) / c.intervallum_attentionis_plenae
    si n_plenae ≠ expectatae_plenae {
        iace finge NumerusDivergens { causa = "full-attention blocks " + (n_plenae ↦ textus) + " ≠ " + (expectatae_plenae ↦ textus) }
    }
    si n_nextn ≠ c.numerus_strata_nextn {
        iace finge NumerusDivergens { causa = "nextn blocks " + (n_nextn ↦ textus) + " ≠ " + (c.numerus_strata_nextn ↦ textus) }
    }

    itera ex m.tensores fixum t {
        varia numerus productum ← 1
        itera ex t.forma fixum d {
            productum ← productum * d
        }
        si t.elementa ≠ productum {
            iace finge NumerusDivergens { causa = "element count of " + t.nomen }
        }
        si (m.data_inceptum + t.offset_relativum) > m.longitudo_artifacti {
            iace finge AmbitusMala { causa = t.nomen + " range exceeds the artifact" }
        }
    }
    redde verum
}

# -------------------------------------------------------------------------
# MODEL-01-M6: admission entry point + identity precondition + typed
# refusal matrix.
#
# `admitto` is the public admission entry on the module. It composes the
# identity precondition (family 6: byte length / SHA-256 divergence fails
# before any architecture read) -> config freeze (M3, family 1) ->
# canonical tensor map (M4, families 2-5) -> cross-reference validation
# (M5), and returns ADMIT with the frozen configuration + the 753-tensor
# receipt. Family 7 (unsupported-but-inspectable) refuses an unknown
# architecture name or raw GGML type: those stay inspectable as data per
# GGUF-A1a but cannot admit as qwen35moe. Every failure returns a typed
# first-divergence diagnostic naming the first diverging fact. Admission
# error variants carry the rendered diagnostic text; the module-level M3/M4/
# M5 typed enums (ErrorConfiguratioQwen35moe / ErrorTensorumQwen35moe /
# ErrorReferentiaeQwen35moe) stay public for direct callers of congela /
# tensores_canonici / referantia.
# -------------------------------------------------------------------------

@ publica
genus AdmissioQwen35moe {
    ConfiguratioQwen35moe configuratio
    SummaTensoriorumQwen summa
}

@ publica
discretio ErrorAdmissionisQwen35moe {
    # family 6: identity
    IdentitasDiversa { textus causa },
    # family 7: unknown architecture name
    ArchitecturaIgnota { textus causa },
    # family 7: unknown raw GGML type
    TypusIgnotus { textus causa },
    # family 1: metadata (rendered from the config freeze)
    ConfiguratioDiversa { textus causa },
    # families 2-5: name/shape/storage/count (rendered from the tensor map)
    TensorumDiversum { textus causa },
    # M5: cross-reference validation (rendered)
    ReferentiaDiversa { textus causa },
    # parse-level failures
    ManifestumMala { textus causa }
}

@ publica
functio causa_admissionis(ErrorAdmissionisQwen35moe e) → textus {
    discerne e {
        casu IdentitasDiversa fixum causa { redde causa }
        casu ArchitecturaIgnota fixum causa { redde causa }
        casu TypusIgnotus fixum causa { redde causa }
        casu ConfiguratioDiversa fixum causa { redde causa }
        casu TensorumDiversum fixum causa { redde causa }
        casu ReferentiaDiversa fixum causa { redde causa }
        casu ManifestumMala fixum causa { redde causa }
    }
}

# Parse the corpus into the manifest, mapping manifest-level failures to
# the admission channel.
@ privata
functio _admitto_parse(manifestum.CorpusGguf corpus) → manifestum.ManifestumGguf ⇥ ErrorAdmissionisQwen35moe {
    fac {
        redde manifestum.parse(corpus)
    }
    cape err {
        iace finge ManifestumMala { causa = manifestum.causa(err) }
    }
}

# Read `general.architecture` as data; a missing or unreadable key falls
# through to the config freeze, which reports it as a family-1 metadata
# divergence at that key.
@ privata
functio _architectura_lecta(manifestum.ManifestumGguf m) → textus ∪ nihil {
    fac {
        redde manifestum.textum(m, "general.architecture")
    }
    cape err {
        redde nihil
    }
}

# First tensor with an unknown raw GGML type (Ignota layout), or nihil.
@ privata
functio _typus_ignotus_primus(manifestum.ManifestumGguf m) → textus ∪ nihil {
    itera ex m.tensores fixum t {
        discerne t.layout {
            casu Ignota fixum typo {
                redde t.nomen
            }
            casu Cognita fixum elementa_per_blockum, octeti_per_blockum, longitudo_octetorum { }
        }
    }
    redde nihil
}

# Config freeze with the family-1 channel rendered into the admission channel.
@ privata
functio _admitto_congela(manifestum.ManifestumGguf m) → ConfiguratioQwen35moe ⇥ ErrorAdmissionisQwen35moe {
    fac {
        redde congela(m)
    }
    cape err {
        iace finge ConfiguratioDiversa { causa = causa(err) }
    }
}

# Canonical tensor map with the families-2-5 channel rendered in.
@ privata
functio _admitto_tensores(manifestum.ManifestumGguf m) → SummaTensoriorumQwen ⇥ ErrorAdmissionisQwen35moe {
    fac {
        redde tensores_canonici(m)
    }
    cape err {
        iace finge TensorumDiversum { causa = causa_tensorum(err) }
    }
}

# Cross-reference validation with the M5 channel rendered in.
@ privata
functio _admitto_referantia(ConfiguratioQwen35moe c, manifestum.ManifestumGguf m) → bivalens ⇥ ErrorAdmissionisQwen35moe {
    fac {
        redde referantia(c, m)
    }
    cape err {
        iace finge ReferentiaDiversa { causa = causa_referantiae(err) }
    }
}

@ publica
functio admitto(
    manifestum.CorpusGguf corpus,
    textus digestio_exspectata,
    numerus longitudo_exspectata
) → AdmissioQwen35moe ⇥ ErrorAdmissionisQwen35moe {
    # family 6: identity precondition, before any architecture read
    si corpus.identitas.algorithmus ≠ "sha-256" {
        iace finge IdentitasDiversa { causa = "qwen35moe admission identity divergence: content algorithm" }
    }
    si corpus.identitas.digestio ≠ digestio_exspectata {
        iace finge IdentitasDiversa { causa = "qwen35moe admission identity divergence: SHA-256" }
    }
    si corpus.identitas.longitudo ≠ longitudo_exspectata {
        iace finge IdentitasDiversa { causa = "qwen35moe admission identity divergence: byte length" }
    }

    fixum manifestum.ManifestumGguf m ← _admitto_parse(corpus)

    # family 7: unknown architecture name — unsupported-but-inspectable
    fixum textus ∪ nihil architectura ← _architectura_lecta(m)
    si architectura non est nihil {
        si (architectura vel "") ≠ "qwen35moe" {
            iace finge ArchitecturaIgnota { causa = "qwen35moe admission refusal: unsupported-but-inspectable architecture " + (architectura vel "") }
        }
    }

    # family 7: unknown raw GGML type — unsupported-but-inspectable
    fixum textus ∪ nihil typus_ignotus ← _typus_ignotus_primus(m)
    si typus_ignotus non est nihil {
        iace finge TypusIgnotus { causa = "qwen35moe admission refusal: unsupported-but-inspectable raw GGML type at " + (typus_ignotus vel "") }
    }

    # family 1: config freeze
    fixum ConfiguratioQwen35moe c ← _admitto_congela(m)

    # families 2-5: canonical tensor map
    fixum SummaTensoriorumQwen s ← _admitto_tensores(m)

    # M5 cross-reference validation
    _admitto_referantia(c, m)

    redde AdmissioQwen35moe { configuratio = c, summa = s }
}
