+++
locale = "en"
+++
# qwen35moe typed configuration genus and metadata freeze (MODEL-01-M3).
#
# Public import: importa ex "gradus:model/qwen35moe" qwen35moe
# Depends on: gradus:model/gguf_manifest (typed metadata accessors) and
# gradus:model/artifact (pathless content identity).
#
# `congela` freezes the frozen qwen35moe configuration rows from a parsed
# GGUF manifest — every row of the Frozen Architecture Configuration table in
# the MODEL-01 delivery (architecture/quantization, block/embedding,
# attention, rope, expert, SSM, nextn, and the tokenizer identity facts) —
# and enforces the 55-entry metadata count. Mutation family 1 fails closed
# with a typed divergence diagnostic naming the first diverging key: any
# frozen value changed, a required key missing, or an extra unknown
# `qwen35moe.*` key that shadows a required fact. Tokenizer facts are frozen
# as identity only; tokenizer execution is GGUF-A2's unit.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" manifestum

const int METADATA_PIN ← 55

const int GGUF_FLOAT32 ← 6

const int PRAEFIXUM_QWEN ← 10

@ public { }
class ConfiguratioQwen35moe {
    string architectura
    int typus_limaturae
    int versio_quantificationis
    int numerus_tractuum
    int longitudo_contextus
    int longitudo_vestimenti
    int numerus_capita
    int numerus_capita_kv
    int longitudo_clavis
    int longitudo_valoris
    f32 epsilon_normae_rms
    f32 basis_frequentiae
    int numerus_dimensionum_rotae
    list<int> sectiones_rotae
    int numerus_expertorum
    int numerus_expertorum_activorum
    int longitudo_ffn_experti
    int longitudo_ffn_communi
    int nucleus_convolutus
    int magnitudo_status
    int numerus_coetuum
    int gradus_temporis
    int magnitudo_interior
    int intervallum_attentionis_plenae
    int numerus_strata_nextn
    string exemplum_tokenizoris
    string praeparatio_tokenizoris
    int numerus_tokenum
    int numerus_typorum_tokenum
    int numerus_concatenationum
    int eos_token_id
    int padding_token_id
    int bos_token_id
    bool add_bos_token
}

@ public { }
union ErrorConfiguratioQwen35moe {
    MetadatumDiversum {
        string clavis
    }
}

@ public { }
fn causa(ErrorConfiguratioQwen35moe e) → string {
    match e {
        case MetadatumDiversum const clavis {
            return "qwen35moe metadata divergence at " + clavis
        }
    }
}

# -------------------------------------------------------------------------
# Required-key membership for the extra-unknown-key scan.
# -------------------------------------------------------------------------

@ private { }
fn _clavis_requisita_qwen(string clavis) → bool {
    if clavis ≡ "qwen35moe.block_count" then return true
    if clavis ≡ "qwen35moe.context_length" then return true
    if clavis ≡ "qwen35moe.embedding_length" then return true
    if clavis ≡ "qwen35moe.attention.head_count" then return true
    if clavis ≡ "qwen35moe.attention.head_count_kv" then return true
    if clavis ≡ "qwen35moe.attention.key_length" then return true
    if clavis ≡ "qwen35moe.attention.value_length" then return true
    if clavis ≡ "qwen35moe.attention.layer_norm_rms_epsilon" then return true
    if clavis ≡ "qwen35moe.rope.freq_base" then return true
    if clavis ≡ "qwen35moe.rope.dimension_count" then return true
    if clavis ≡ "qwen35moe.rope.dimension_sections" then return true
    if clavis ≡ "qwen35moe.expert_count" then return true
    if clavis ≡ "qwen35moe.expert_used_count" then return true
    if clavis ≡ "qwen35moe.expert_feed_forward_length" then return true
    if clavis ≡ "qwen35moe.expert_shared_feed_forward_length" then return true
    if clavis ≡ "qwen35moe.ssm.conv_kernel" then return true
    if clavis ≡ "qwen35moe.ssm.state_size" then return true
    if clavis ≡ "qwen35moe.ssm.group_count" then return true
    if clavis ≡ "qwen35moe.ssm.time_step_rank" then return true
    if clavis ≡ "qwen35moe.ssm.inner_size" then return true
    if clavis ≡ "qwen35moe.full_attention_interval" then return true
    if clavis ≡ "qwen35moe.nextn_predict_layers" then return true
    return false
}

# The first extra `qwen35moe.*` key outside the frozen set, or nihil.
@ private { }
fn _clavis_qwen_ignota(manifestum.ManifestumGguf m) → string ∪ null {
    for from m.metadata const meta {
        if (meta.clavis.length() ≥ PRAEFIXUM_QWEN and meta.clavis.slice(0, PRAEFIXUM_QWEN) ≡ "qwen35moe.") and not _clavis_requisita_qwen(meta.clavis) then return meta.clavis
    }
    return null
}

# -------------------------------------------------------------------------
# Byte and float32-wire helpers (value arithmetic, the dequant seam).
# -------------------------------------------------------------------------

@ private { }
fn _octeti_lista(bytes o) → list<int<u8>> {
    const value wire ← o ↦ value
    const list<int> numeri ← wire ↦ list<int>
    var list<int<u8>> out ← vacua
    for from numeri const v {
        out.append(v ∷ int<u8>)
    }
    return out
}

@ private { }
fn _byte(list<int<u8>> b, int off) → int {
    return b.get(off) coalesce 0 ∷ int<u8> ↦ int
}

@ private { }
fn _potentia_duorum(int n) → float {
    var float result ← 1.0
    if n ≥ 0 {
        var int i ← 0
        while i ≺ n {
            result ← result * 2.0
            i ← i + 1
        }
    }
    else {
        var int i ← n
        while i ≺ 0 {
            result ← result / 2.0
            i ← i + 1
        }
    }
    return result
}

# 4 little-endian bytes -> exact f32 VALUE (IEEE-754 binary32 decode, the
# dequant `_f32le` seam). Infinity or a NaN payload decodes to a value that
# can never equal either frozen float fact, so the freeze comparison fails
# closed without a special NaN branch.
@ private { }
fn _f32_le(list<int<u8>> b, int off) → f32 {
    const int b0 ← _byte(b, off)
    const int b1 ← _byte(b, off + 1)
    const int b2 ← _byte(b, off + 2)
    const int b3 ← _byte(b, off + 3)
    const int raw ← ((b3 * 16777216 + b2 * 65536) + b1 * 256) + b0
    const int sign ← (raw ⇒ 31) % 2
    const int exp ← (raw ⇒ 23) % 256
    const int frac ← raw % 8388608
    var float sign_factor ← 1.0
    if sign ≠ 0 {
        sign_factor ← -1.0
    }
    const float frac_ratio ← (frac ↦ float) / 8388608.0
    if exp ≡ 0 {
        if frac ≡ 0 then return sign_factor * 0.0 ↦ f32
        const float power ← _potentia_duorum(-126)
        return (sign_factor * power) * frac_ratio ↦ f32
    }
    const float power ← _potentia_duorum(exp - 127)
    return (sign_factor * power) * (1.0 + frac_ratio) ↦ f32
}

# -------------------------------------------------------------------------
# Typed read-and-pin accessors. Every accessor maps a missing or malformed
# key to a divergence diagnostic naming that key, then compares the read
# value against the frozen expectation. First divergence wins.
# -------------------------------------------------------------------------

@ private { }
fn _exige_meta(manifestum.ManifestumGguf m, string clavis) → manifestum.MetadatumGguf ⇥ ErrorConfiguratioQwen35moe {
    do {
        return manifestum.metadatum(m, clavis)
    }
    catch err {
        throw variant MetadatumDiversum {clavis = clavis}
    }
}

@ private { }
fn _exige_numerum(manifestum.ManifestumGguf m, string clavis, int expectatum) → int ⇥ ErrorConfiguratioQwen35moe {
    var int observatum ← 0
    do {
        observatum ← manifestum.numerum(m, clavis)
    }
    catch err {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    if observatum ≠ expectatum {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    return observatum
}

@ private { }
fn _exige_textum(manifestum.ManifestumGguf m, string clavis, string expectatum) → string ⇥ ErrorConfiguratioQwen35moe {
    var string observatum ← ""
    do {
        observatum ← manifestum.textum(m, clavis)
    }
    catch err {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    if observatum ≠ expectatum {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    return observatum
}

@ private { }
fn _exige_bool(manifestum.ManifestumGguf m, string clavis, bool expectatum) → bool ⇥ ErrorConfiguratioQwen35moe {
    var bool observatum ← false
    do {
        observatum ← manifestum.boleanum(m, clavis)
    }
    catch err {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    if observatum ≠ expectatum {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    return observatum
}

@ private { }
fn _exige_longitudo(manifestum.ManifestumGguf m, string clavis, int expectatum) → int ⇥ ErrorConfiguratioQwen35moe {
    var int observatum ← 0
    do {
        observatum ← manifestum.longitudo_listae(m, clavis)
    }
    catch err {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    if observatum ≠ expectatum {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    return observatum
}

@ private { }
fn _exige_f32(manifestum.ManifestumGguf m, string clavis, f32 expectatum) → f32 ⇥ ErrorConfiguratioQwen35moe {
    const manifestum.MetadatumGguf meta ← _exige_meta(m, clavis)
    if meta.typo ≠ GGUF_FLOAT32 {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    const f32 observatum ← _f32_le(_octeti_lista(meta.valor_wire), 0)
    if not (observatum ≡ expectatum) {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    return observatum
}

@ private { }
fn _exige_sectiones(manifestum.ManifestumGguf m, string clavis) → list<int> ⇥ ErrorConfiguratioQwen35moe {
    var list<int> observata ← vacua
    do {
        observata ← manifestum.numerorum(m, clavis)
    }
    catch err {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    if observata.length() ≠ 4 {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    if observata.get(0) coalesce 0 ≠ 11 {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    if observata.get(1) coalesce 0 ≠ 11 {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    if observata.get(2) coalesce 0 ≠ 10 {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    if observata.get(3) coalesce 0 ≠ 0 {
        throw variant MetadatumDiversum {clavis = clavis}
    }
    return observata
}

# Freeze the frozen qwen35moe configuration. Reads are in the delivery table
# order, so the first diverging fact is deterministic.
@ public { }
fn congela(manifestum.ManifestumGguf m) → ConfiguratioQwen35moe ⇥ ErrorConfiguratioQwen35moe {
    const string architectura ← _exige_textum(m, "general.architecture", "qwen35moe")
    const int typus_limaturae ← _exige_numerum(m, "general.file_type", 15)
    const int versio_quantificationis ← _exige_numerum(m, "general.quantization_version", 2)
    const int numerus_tractuum ← _exige_numerum(m, "qwen35moe.block_count", 41)
    const int longitudo_contextus ← _exige_numerum(m, "qwen35moe.context_length", 262144)
    const int longitudo_vestimenti ← _exige_numerum(m, "qwen35moe.embedding_length", 2048)
    const int numerus_capita ← _exige_numerum(m, "qwen35moe.attention.head_count", 16)
    const int numerus_capita_kv ← _exige_numerum(m, "qwen35moe.attention.head_count_kv", 2)
    const int longitudo_clavis ← _exige_numerum(m, "qwen35moe.attention.key_length", 256)
    const int longitudo_valoris ← _exige_numerum(m, "qwen35moe.attention.value_length", 256)
    const f32 epsilon_normae_rms ← _exige_f32(m, "qwen35moe.attention.layer_norm_rms_epsilon", 0.0000009999999974752427 ∷ f32)
    const f32 basis_frequentiae ← _exige_f32(m, "qwen35moe.rope.freq_base", 10000000.0 ∷ f32)
    const int numerus_dimensionum_rotae ← _exige_numerum(m, "qwen35moe.rope.dimension_count", 64)
    const list<int> sectiones_rotae ← _exige_sectiones(m, "qwen35moe.rope.dimension_sections")
    const int numerus_expertorum ← _exige_numerum(m, "qwen35moe.expert_count", 256)
    const int numerus_expertorum_activorum ← _exige_numerum(m, "qwen35moe.expert_used_count", 8)
    const int longitudo_ffn_experti ← _exige_numerum(m, "qwen35moe.expert_feed_forward_length", 512)
    const int longitudo_ffn_communi ← _exige_numerum(m, "qwen35moe.expert_shared_feed_forward_length", 512)
    const int nucleus_convolutus ← _exige_numerum(m, "qwen35moe.ssm.conv_kernel", 4)
    const int magnitudo_status ← _exige_numerum(m, "qwen35moe.ssm.state_size", 128)
    const int numerus_coetuum ← _exige_numerum(m, "qwen35moe.ssm.group_count", 16)
    const int gradus_temporis ← _exige_numerum(m, "qwen35moe.ssm.time_step_rank", 32)
    const int magnitudo_interior ← _exige_numerum(m, "qwen35moe.ssm.inner_size", 4096)
    const int intervallum_attentionis_plenae ← _exige_numerum(m, "qwen35moe.full_attention_interval", 4)
    const int numerus_strata_nextn ← _exige_numerum(m, "qwen35moe.nextn_predict_layers", 1)
    const string exemplum_tokenizoris ← _exige_textum(m, "tokenizer.ggml.model", "gpt2")
    const string praeparatio_tokenizoris ← _exige_textum(m, "tokenizer.ggml.pre", "qwen35")
    const int numerus_tokenum ← _exige_longitudo(m, "tokenizer.ggml.tokens", 248320)
    const int numerus_typorum_tokenum ← _exige_longitudo(m, "tokenizer.ggml.token_type", 248320)
    const int numerus_concatenationum ← _exige_longitudo(m, "tokenizer.ggml.merges", 247587)
    const int eos_token_id ← _exige_numerum(m, "tokenizer.ggml.eos_token_id", 248046)
    const int padding_token_id ← _exige_numerum(m, "tokenizer.ggml.padding_token_id", 248055)
    const int bos_token_id ← _exige_numerum(m, "tokenizer.ggml.bos_token_id", 248044)
    const bool add_bos_token ← _exige_bool(m, "tokenizer.ggml.add_bos_token", false)
    const string ∪ null ignota ← _clavis_qwen_ignota(m)
    if ignota not is null {
        throw variant MetadatumDiversum {clavis = ignota coalesce ""}
    }
    if m.metadata.length() ≠ METADATA_PIN {
        throw variant MetadatumDiversum {clavis = "metadata count"}
    }
    return ConfiguratioQwen35moe {architectura = architectura, typus_limaturae = typus_limaturae, versio_quantificationis = versio_quantificationis, numerus_tractuum = numerus_tractuum, longitudo_contextus = longitudo_contextus, longitudo_vestimenti = longitudo_vestimenti, numerus_capita = numerus_capita, numerus_capita_kv = numerus_capita_kv, longitudo_clavis = longitudo_clavis, longitudo_valoris = longitudo_valoris, epsilon_normae_rms = epsilon_normae_rms, basis_frequentiae = basis_frequentiae, numerus_dimensionum_rotae = numerus_dimensionum_rotae, sectiones_rotae = sectiones_rotae, numerus_expertorum = numerus_expertorum, numerus_expertorum_activorum = numerus_expertorum_activorum, longitudo_ffn_experti = longitudo_ffn_experti, longitudo_ffn_communi = longitudo_ffn_communi, nucleus_convolutus = nucleus_convolutus, magnitudo_status = magnitudo_status, numerus_coetuum = numerus_coetuum, gradus_temporis = gradus_temporis, magnitudo_interior = magnitudo_interior, intervallum_attentionis_plenae = intervallum_attentionis_plenae, numerus_strata_nextn = numerus_strata_nextn, exemplum_tokenizoris = exemplum_tokenizoris, praeparatio_tokenizoris = praeparatio_tokenizoris, numerus_tokenum = numerus_tokenum, numerus_typorum_tokenum = numerus_typorum_tokenum, numerus_concatenationum = numerus_concatenationum, eos_token_id = eos_token_id, padding_token_id = padding_token_id, bos_token_id = bos_token_id, add_bos_token = add_bos_token}
}

# -------------------------------------------------------------------------
# MODEL-01-M4: canonical 753-tensor map + 41-block schedule.
#
# `tensores_canonici` admits the four exact family sets from the Canonical
# 753-Tensor Map in the MODEL-01 delivery: global 3 (output.weight /
# output_norm.weight / token_embd.weight), hybrid 19x30, full-attention
# 16x10, and the nextn 20 on blk.40 — every tensor's exact stored shape and
# storage row. The schedule is structural: 41 block indices 0..40, full
# attention at index ≡ 3 mod 4, blk.40 the sole nextn block
# (`nextn_predict_layers` = 1). Anomalies are preserved per-tensor, never
# collapsed to one global storage row: blk.40's ffn_gate_inp.weight and
# ffn_gate_inp_shexp.weight are bf16 (f32 in every other block), and
# ffn_down_exps.weight is q6_K in blk.34/38/39 (q5_K elsewhere). Block-40
# nextn/MTP rule (frozen): the 20 blk.40 tensors are admitted for map
# completeness; the main forward layer schedule is blocks 0..39 and the
# admission claims no nextn/MTP execution semantics — those belong to
# GGUF-M2/M3/M4. Count invariants: 753 tensors total, 55 metadata entries,
# and the derived block-family and storage-distribution counts. Mutation
# families 2 (name), 3 (shape), 4 (storage), and 5 (count) fail closed with
# a typed first-divergence diagnostic naming the first diverging fact.
#
# GGML raw type ids (only the six canonical storage rows are admitted).
const int GGML_F32 ← 0

const int GGML_Q8_0 ← 8

const int GGML_Q4_K ← 12

const int GGML_Q5_K ← 13

const int GGML_Q6_K ← 14

const int GGML_BF16 ← 30

const int TENSORUM_PIN ← 753

const int TRACTUUM_PIN ← 41

@ public { }
union ErrorTensorumQwen35moe {
    NomenDiversum {
        string nomen
    },
    FormaDiversa {
        string nomen
    },
    StipulaDiversa {
        string nomen
    },
    NumerusDiversus {
        string causa
    }
}

@ public { }
fn causa_tensorum(ErrorTensorumQwen35moe e) → string {
    match e {
        case NomenDiversum const nomen {
            return "qwen35moe tensor name divergence at " + nomen
        }
        case FormaDiversa const nomen {
            return "qwen35moe tensor shape divergence at " + nomen
        }
        case StipulaDiversa const nomen {
            return "qwen35moe tensor storage divergence at " + nomen
        }
        case NumerusDiversus const causa {
            return "qwen35moe tensor count divergence: " + causa
        }
    }
}

# Derived admission receipt: block-family and storage-distribution counts.

@ public { }
class SummaTensoriorumQwen {
    int totalis
    int globalium
    int hybridorum
    int attentionis_plenae
    int nextn
    int stipula_f32
    int stipula_q8_0
    int stipula_q4_k
    int stipula_q5_k
    int stipula_q6_k
    int stipula_bf16
    int experti_rank3
}

# One canonical expectation row (module-internal carrier).
class TensorCanonicusQwen {
    string nomen
    list<int> forma
    int typo_ggml
}

# Block class: 0 = hybrid SSM/attention, 1 = full-attention (index ≡ 3 mod
# 4), 2 = the sole nextn block blk.40.
@ private { }
fn _classis_blocki(int b) → int {
    if b ≡ 40 then return 2
    if b % 4 ≡ 3 then return 1
    return 0
}

@ private { }
fn _tensores_globales() → list<TensorCanonicusQwen> {
    var list<TensorCanonicusQwen> out ← vacua
    out.append(TensorCanonicusQwen {nomen = "output.weight", forma = [2048, 248320], typo_ggml = GGML_Q6_K})
    out.append(TensorCanonicusQwen {nomen = "output_norm.weight", forma = [2048], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = "token_embd.weight", forma = [2048, 248320], typo_ggml = GGML_Q8_0})
    return out
}

# Hybrid SSM/attention block set (19); ffn_down_exps is q6_K in blk.34/38.
@ private { }
fn _tensores_hybridae(int b) → list<TensorCanonicusQwen> {
    const string p ← "blk." + (b ↦ string)
    var int down_typo ← GGML_Q5_K
    if b ≡ 34 or b ≡ 38 {
        down_typo ← GGML_Q6_K
    }
    var list<TensorCanonicusQwen> out ← vacua
    out.append(TensorCanonicusQwen {nomen = p + ".attn_gate.weight", forma = [2048, 4096], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_norm.weight", forma = [2048], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_qkv.weight", forma = [2048, 8192], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_down_exps.weight", forma = [512, 2048, 256], typo_ggml = down_typo})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_down_shexp.weight", forma = [512, 2048], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_gate_exps.weight", forma = [2048, 512, 256], typo_ggml = GGML_Q4_K})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_gate_inp.weight", forma = [2048, 256], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_gate_inp_shexp.weight", forma = [2048], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_gate_shexp.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_up_exps.weight", forma = [2048, 512, 256], typo_ggml = GGML_Q4_K})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_up_shexp.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".post_attention_norm.weight", forma = [2048], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".ssm_a", forma = [32], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".ssm_alpha.weight", forma = [2048, 32], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".ssm_beta.weight", forma = [2048, 32], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".ssm_conv1d.weight", forma = [4, 8192], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".ssm_dt.bias", forma = [32], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".ssm_norm.weight", forma = [128], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".ssm_out.weight", forma = [4096, 2048], typo_ggml = GGML_Q8_0})
    return out
}

# Full-attention block set (16); ffn_down_exps is q6_K in blk.39.
@ private { }
fn _tensores_plenae(int b) → list<TensorCanonicusQwen> {
    const string p ← "blk." + (b ↦ string)
    var int down_typo ← GGML_Q5_K
    if b ≡ 39 {
        down_typo ← GGML_Q6_K
    }
    var list<TensorCanonicusQwen> out ← vacua
    out.append(TensorCanonicusQwen {nomen = p + ".attn_k.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_k_norm.weight", forma = [256], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_norm.weight", forma = [2048], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_output.weight", forma = [4096, 2048], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_q.weight", forma = [2048, 8192], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_q_norm.weight", forma = [256], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_v.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_down_exps.weight", forma = [512, 2048, 256], typo_ggml = down_typo})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_down_shexp.weight", forma = [512, 2048], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_gate_exps.weight", forma = [2048, 512, 256], typo_ggml = GGML_Q4_K})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_gate_inp.weight", forma = [2048, 256], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_gate_inp_shexp.weight", forma = [2048], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_gate_shexp.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_up_exps.weight", forma = [2048, 512, 256], typo_ggml = GGML_Q4_K})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_up_shexp.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".post_attention_norm.weight", forma = [2048], typo_ggml = GGML_F32})
    return out
}

# Nextn block blk.40 set (20): the full-attention 16 with the frozen bf16
# anomaly on ffn_gate_inp / ffn_gate_inp_shexp, plus the four nextn.*
# tensors. ffn_down_exps stays q5_K (blk.40 is not in the q6_K anomaly set).
@ private { }
fn _tensores_nextn() → list<TensorCanonicusQwen> {
    const string p ← "blk.40"
    var list<TensorCanonicusQwen> out ← vacua
    out.append(TensorCanonicusQwen {nomen = p + ".attn_k.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_k_norm.weight", forma = [256], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_norm.weight", forma = [2048], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_output.weight", forma = [4096, 2048], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_q.weight", forma = [2048, 8192], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_q_norm.weight", forma = [256], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".attn_v.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_down_exps.weight", forma = [512, 2048, 256], typo_ggml = GGML_Q5_K})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_down_shexp.weight", forma = [512, 2048], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_gate_exps.weight", forma = [2048, 512, 256], typo_ggml = GGML_Q4_K})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_gate_inp.weight", forma = [2048, 256], typo_ggml = GGML_BF16})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_gate_inp_shexp.weight", forma = [2048], typo_ggml = GGML_BF16})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_gate_shexp.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_up_exps.weight", forma = [2048, 512, 256], typo_ggml = GGML_Q4_K})
    out.append(TensorCanonicusQwen {nomen = p + ".ffn_up_shexp.weight", forma = [2048, 512], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".post_attention_norm.weight", forma = [2048], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".nextn.eh_proj.weight", forma = [4096, 2048], typo_ggml = GGML_Q8_0})
    out.append(TensorCanonicusQwen {nomen = p + ".nextn.enorm.weight", forma = [2048], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".nextn.hnorm.weight", forma = [2048], typo_ggml = GGML_F32})
    out.append(TensorCanonicusQwen {nomen = p + ".nextn.shared_head_norm.weight", forma = [2048], typo_ggml = GGML_F32})
    return out
}

@ private { }
fn _canonici_blocki(int b) → list<TensorCanonicusQwen> {
    if b ≡ 40 then return _tensores_nextn()
    if b % 4 ≡ 3 then return _tensores_plenae(b)
    return _tensores_hybridae(b)
}

# Locate one canonical tensor in the manifest; a missing name is the family-2
# divergence (the manifest's own duplicate-name rejection runs at parse time).
@ private { }
fn _inveni(manifestum.ManifestumGguf m, string nomen) → manifestum.DescriptioTensorisGguf ⇥ ErrorTensorumQwen35moe {
    do {
        return manifestum.inveni_tensorem(m, nomen)
    }
    catch err {
        throw variant NomenDiversum {nomen = nomen}
    }
}

# Name -> shape -> storage check order makes the first diverging fact
# deterministic per canonical entry.
@ private { }
fn _exige(manifestum.ManifestumGguf m, TensorCanonicusQwen c) → bool ⇥ ErrorTensorumQwen35moe {
    const manifestum.DescriptioTensorisGguf tensor ← _inveni(m, c.nomen)
    if tensor.forma.length() ≠ c.forma.length() {
        throw variant FormaDiversa {nomen = c.nomen}
    }
    var int i ← 0
    while i ≺ c.forma.length() {
        if tensor.forma.get(i) coalesce 0 ≠ c.forma.get(i) coalesce 0 {
            throw variant FormaDiversa {nomen = c.nomen}
        }
        i ↑
    }
    if tensor.typo_ggml ≠ c.typo_ggml {
        throw variant StipulaDiversa {nomen = c.nomen}
    }
    return true
}

# Admit the canonical map: count invariants fail closed first (family 5),
# then every canonical tensor is matched name/shape/storage in canonical
# order (families 2-4). The receipt counts are derived, so the schedule and
# storage distribution are proven from the admitted tensors themselves.
@ public { }
fn tensores_canonici(manifestum.ManifestumGguf m) → SummaTensoriorumQwen ⇥ ErrorTensorumQwen35moe {
    if m.tensores.length() ≠ TENSORUM_PIN {
        throw variant NumerusDiversus {causa = (("tensor count " + (m.tensores.length() ↦ string)) + " ≠ ") + (TENSORUM_PIN ↦ string)}
    }
    if m.metadata.length() ≠ METADATA_PIN {
        throw variant NumerusDiversus {causa = (("metadata count " + (m.metadata.length() ↦ string)) + " ≠ ") + (METADATA_PIN ↦ string)}
    }
    var int n_globalium ← 0
    var int n_hybridorum ← 0
    var int n_plenarum ← 0
    var int n_nextn ← 0
    var int n_f32 ← 0
    var int n_q8_0 ← 0
    var int n_q4_k ← 0
    var int n_q5_k ← 0
    var int n_q6_k ← 0
    var int n_bf16 ← 0
    var int n_rank3 ← 0
    const list<TensorCanonicusQwen> globals ← _tensores_globales()
    for from globals const c {
        _exige(m, c)
        n_globalium ↑
        if c.typo_ggml ≡ GGML_F32 {
            n_f32 ↑
        }
        if c.typo_ggml ≡ GGML_Q8_0 {
            n_q8_0 ↑
        }
        if c.typo_ggml ≡ GGML_Q6_K {
            n_q6_k ↑
        }
    }
    var int b ← 0
    while b ≺ TRACTUUM_PIN {
        const list<TensorCanonicusQwen> canon ← _canonici_blocki(b)
        const int classis ← _classis_blocki(b)
        for from canon const c {
            _exige(m, c)
            if classis ≡ 0 {
                n_hybridorum ↑
            }
            if classis ≡ 1 {
                n_plenarum ↑
            }
            if classis ≡ 2 {
                n_nextn ↑
            }
            if c.typo_ggml ≡ GGML_F32 {
                n_f32 ↑
            }
            if c.typo_ggml ≡ GGML_Q8_0 {
                n_q8_0 ↑
            }
            if c.typo_ggml ≡ GGML_Q4_K {
                n_q4_k ↑
            }
            if c.typo_ggml ≡ GGML_Q5_K {
                n_q5_k ↑
            }
            if c.typo_ggml ≡ GGML_Q6_K {
                n_q6_k ↑
            }
            if c.typo_ggml ≡ GGML_BF16 {
                n_bf16 ↑
            }
            if c.forma.length() ≡ 3 {
                n_rank3 ↑
            }
        }
        b ↑
    }
    return SummaTensoriorumQwen {totalis = TENSORUM_PIN, globalium = n_globalium, hybridorum = n_hybridorum, attentionis_plenae = n_plenarum, nextn = n_nextn, stipula_f32 = n_f32, stipula_q8_0 = n_q8_0, stipula_q4_k = n_q4_k, stipula_q5_k = n_q5_k, stipula_q6_k = n_q6_k, stipula_bf16 = n_bf16, experti_rank3 = n_rank3}
}

# -------------------------------------------------------------------------
# MODEL-01-M5: dimension/storage cross-reference validation.
#
# `referantia` cross-references the frozen configuration (M3) against the
# manifest tensors, deriving every expected dim from the config so a
# config/tensor pair that is individually frozen can still diverge:
# `embedding_length` at its stored-dim positions per family,
# `expert_count` as rank-3 dim 2 of the three `*_exps` tensors and dim 1 of
# `ffn_gate_inp`, `expert_feed_forward_length` at the down/gate-up
# positions, the ssm dims (`state_size` / `time_step_rank` / `conv_kernel`
# / `inner_size`), `head_count_kv` × `key_length` = dim 1 of
# `attn_k`/`attn_v` (norms carry 256), block-schedule consistency, element
# counts = product of stored dims, and the GGUF-A1a/A1b absolute range
# bound. The first diverging cross-fact fails with a typed diagnostic
# naming that tensor.
# -------------------------------------------------------------------------


@ public { }
union ErrorReferentiaeQwen35moe {
    NomenIgnotum {
        string nomen
    },
    DimensioDiversa {
        string nomen
    },
    NumerusDivergens {
        string causa
    },
    AmbitusMala {
        string causa
    }
}

@ public { }
fn causa_referantiae(ErrorReferentiaeQwen35moe e) → string {
    match e {
        case NomenIgnotum const nomen {
            return "qwen35moe cross-reference name divergence at " + nomen
        }
        case DimensioDiversa const nomen {
            return "qwen35moe cross-reference dimension divergence at " + nomen
        }
        case NumerusDivergens const causa {
            return "qwen35moe cross-reference count divergence: " + causa
        }
        case AmbitusMala const causa {
            return "qwen35moe cross-reference range divergence: " + causa
        }
    }
}

@ private { }
fn _refer_inveni(manifestum.ManifestumGguf m, string nomen) → manifestum.DescriptioTensorisGguf ⇥ ErrorReferentiaeQwen35moe {
    do {
        return manifestum.inveni_tensorem(m, nomen)
    }
    catch err {
        throw variant NomenIgnotum {nomen = nomen}
    }
}

# Check one stored-dim position (GGUF file order); a rank below the index
# is itself the diverging fact.
@ private { }
fn _refer_dim(manifestum.ManifestumGguf m, string nomen, int index, int expectatum) → bool ⇥ ErrorReferentiaeQwen35moe {
    const manifestum.DescriptioTensorisGguf t ← _refer_inveni(m, nomen)
    if t.forma.length() ≤ index {
        throw variant DimensioDiversa {nomen = nomen}
    }
    if t.forma.get(index) coalesce 0 ≠ expectatum {
        throw variant DimensioDiversa {nomen = nomen}
    }
    return true
}

@ private { }
fn _refer_gradu(manifestum.ManifestumGguf m, string nomen, int expectatum) → bool ⇥ ErrorReferentiaeQwen35moe {
    const manifestum.DescriptioTensorisGguf t ← _refer_inveni(m, nomen)
    if t.forma.length() ≠ expectatum {
        throw variant DimensioDiversa {nomen = nomen}
    }
    return true
}

# Single stored dim of the rank-1 norm tensors.
@ private { }
fn _refer_unum(manifestum.ManifestumGguf m, string nomen, int expectatum) → bool ⇥ ErrorReferentiaeQwen35moe {
    _refer_gradu(m, nomen, 1)
    _refer_dim(m, nomen, 0, expectatum)
    return true
}

# The expert family, shared by every block class. Down stores
# [ffn, embd, experts]; gate/up store [embd, ffn, experts]; `ffn_gate_inp`
# carries [embd, experts].
@ private { }
fn _refer_ffn(manifestum.ManifestumGguf m, ConfiguratioQwen35moe c, string p) → bool ⇥ ErrorReferentiaeQwen35moe {
    _refer_dim(m, p + ".ffn_down_exps.weight", 0, c.longitudo_ffn_experti)
    _refer_dim(m, p + ".ffn_down_exps.weight", 1, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_down_exps.weight", 2, c.numerus_expertorum)
    _refer_dim(m, p + ".ffn_down_shexp.weight", 0, c.longitudo_ffn_experti)
    _refer_dim(m, p + ".ffn_down_shexp.weight", 1, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_gate_exps.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_gate_exps.weight", 1, c.longitudo_ffn_experti)
    _refer_dim(m, p + ".ffn_gate_exps.weight", 2, c.numerus_expertorum)
    _refer_dim(m, p + ".ffn_gate_inp.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_gate_inp.weight", 1, c.numerus_expertorum)
    _refer_unum(m, p + ".ffn_gate_inp_shexp.weight", c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_gate_shexp.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_gate_shexp.weight", 1, c.longitudo_ffn_experti)
    _refer_dim(m, p + ".ffn_up_exps.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_up_exps.weight", 1, c.longitudo_ffn_experti)
    _refer_dim(m, p + ".ffn_up_exps.weight", 2, c.numerus_expertorum)
    _refer_dim(m, p + ".ffn_up_shexp.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ffn_up_shexp.weight", 1, c.longitudo_ffn_experti)
    return true
}

# Hybrid SSM/attention block family (19 blocks, index ≢ 3 mod 4, ≠ 40).
@ private { }
fn _refer_hybrida(manifestum.ManifestumGguf m, ConfiguratioQwen35moe c, string p) → bool ⇥ ErrorReferentiaeQwen35moe {
    _refer_dim(m, p + ".attn_gate.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".attn_gate.weight", 1, c.magnitudo_interior)
    _refer_unum(m, p + ".attn_norm.weight", c.longitudo_vestimenti)
    _refer_dim(m, p + ".attn_qkv.weight", 0, c.longitudo_vestimenti)
    _refer_ffn(m, c, p)
    _refer_unum(m, p + ".post_attention_norm.weight", c.longitudo_vestimenti)
    _refer_unum(m, p + ".ssm_a", c.gradus_temporis)
    _refer_dim(m, p + ".ssm_alpha.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ssm_alpha.weight", 1, c.gradus_temporis)
    _refer_dim(m, p + ".ssm_beta.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".ssm_beta.weight", 1, c.gradus_temporis)
    _refer_dim(m, p + ".ssm_conv1d.weight", 0, c.nucleus_convolutus)
    _refer_unum(m, p + ".ssm_dt.bias", c.gradus_temporis)
    _refer_unum(m, p + ".ssm_norm.weight", c.magnitudo_status)
    _refer_dim(m, p + ".ssm_out.weight", 0, c.magnitudo_interior)
    _refer_dim(m, p + ".ssm_out.weight", 1, c.longitudo_vestimenti)
    return true
}

# Full-attention block family core (16 blocks, index ≡ 3 mod 4).
@ private { }
fn _refer_plena_core(manifestum.ManifestumGguf m, ConfiguratioQwen35moe c, string p) → bool ⇥ ErrorReferentiaeQwen35moe {
    const int kv_protensio ← c.numerus_capita_kv * c.longitudo_clavis
    _refer_dim(m, p + ".attn_k.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".attn_k.weight", 1, kv_protensio)
    _refer_unum(m, p + ".attn_k_norm.weight", c.longitudo_clavis)
    _refer_unum(m, p + ".attn_norm.weight", c.longitudo_vestimenti)
    _refer_dim(m, p + ".attn_output.weight", 0, c.magnitudo_interior)
    _refer_dim(m, p + ".attn_output.weight", 1, c.longitudo_vestimenti)
    _refer_dim(m, p + ".attn_q.weight", 0, c.longitudo_vestimenti)
    _refer_unum(m, p + ".attn_q_norm.weight", c.longitudo_clavis)
    _refer_dim(m, p + ".attn_v.weight", 0, c.longitudo_vestimenti)
    _refer_dim(m, p + ".attn_v.weight", 1, kv_protensio)
    _refer_ffn(m, c, p)
    _refer_unum(m, p + ".post_attention_norm.weight", c.longitudo_vestimenti)
    return true
}

# Cross-reference the frozen config against the manifest. Block families
# run in schedule order so the first diverging cross-fact is deterministic.
@ public { }
fn referantia(ConfiguratioQwen35moe c, manifestum.ManifestumGguf m) → bool ⇥ ErrorReferentiaeQwen35moe {
    _refer_dim(m, "output.weight", 0, c.longitudo_vestimenti)
    _refer_unum(m, "output_norm.weight", c.longitudo_vestimenti)
    _refer_dim(m, "token_embd.weight", 0, c.longitudo_vestimenti)
    var int n_plenae ← 0
    var int n_nextn ← 0
    var int b ← 0
    while b ≺ TRACTUUM_PIN {
        const string p ← "blk." + (b ↦ string)
        if b ≡ 40 {
            _refer_plena_core(m, c, p)
            _refer_dim(m, p + ".nextn.eh_proj.weight", 0, c.magnitudo_interior)
            _refer_dim(m, p + ".nextn.eh_proj.weight", 1, c.longitudo_vestimenti)
            _refer_unum(m, p + ".nextn.enorm.weight", c.longitudo_vestimenti)
            _refer_unum(m, p + ".nextn.hnorm.weight", c.longitudo_vestimenti)
            _refer_unum(m, p + ".nextn.shared_head_norm.weight", c.longitudo_vestimenti)
            n_nextn ↑
        }
        else {
            if b % 4 ≡ 3 {
                _refer_plena_core(m, c, p)
                n_plenae ↑
            }
            else {
                _refer_hybrida(m, c, p)
            }
        }
        b ↑
    }
    const int expectatae_plenae ← (TRACTUUM_PIN - 1) / c.intervallum_attentionis_plenae
    if n_plenae ≠ expectatae_plenae {
        throw variant NumerusDivergens {causa = (("full-attention blocks " + (n_plenae ↦ string)) + " ≠ ") + (expectatae_plenae ↦ string)}
    }
    if n_nextn ≠ c.numerus_strata_nextn {
        throw variant NumerusDivergens {causa = (("nextn blocks " + (n_nextn ↦ string)) + " ≠ ") + (c.numerus_strata_nextn ↦ string)}
    }
    for from m.tensores const t {
        var int productum ← 1
        for from t.forma const d {
            productum ← productum * d
        }
        if t.elementa ≠ productum {
            throw variant NumerusDivergens {causa = "element count of " + t.nomen}
        }
        if m.data_inceptum + t.offset_relativum ≻ m.longitudo_artifacti {
            throw variant AmbitusMala {causa = t.nomen + " range exceeds the artifact"}
        }
    }
    return true
}

# -------------------------------------------------------------------------
# MODEL-01-M6: admission entry point + identity precondition + typed
# refusal matrix.
#
# `admitto` is the public admission entry on the module. It composes the
# identity precondition (family 6: byte length / SHA-256 divergence fails
# before any architecture read) -> config freeze (M3, family 1) ->
# canonical tensor map (M4, families 2-5) -> cross-reference validation
# (M5), and returns ADMIT with the frozen configuration + the 753-tensor
# receipt. Family 7 (unsupported-but-inspectable) refuses an unknown
# architecture name or raw GGML type: those stay inspectable as data per
# GGUF-A1a but cannot admit as qwen35moe. Every failure returns a typed
# first-divergence diagnostic naming the first diverging fact. Admission
# error variants carry the rendered diagnostic text; the module-level M3/M4/
# M5 typed enums (ErrorConfiguratioQwen35moe / ErrorTensorumQwen35moe /
# ErrorReferentiaeQwen35moe) stay public for direct callers of congela /
# tensores_canonici / referantia.
# -------------------------------------------------------------------------


@ public { }
class AdmissioQwen35moe {
    ConfiguratioQwen35moe configuratio
    SummaTensoriorumQwen summa
}

@ public { }
union ErrorAdmissionisQwen35moe {
    IdentitasDiversa {
        string causa
    },
    ArchitecturaIgnota {
        string causa
    },
    TypusIgnotus {
        string causa
    },
    ConfiguratioDiversa {
        string causa
    },
    TensorumDiversum {
        string causa
    },
    ReferentiaDiversa {
        string causa
    },
    ManifestumMala {
        string causa
    }
}

@ public { }
fn causa_admissionis(ErrorAdmissionisQwen35moe e) → string {
    match e {
        case IdentitasDiversa const causa {
            return causa
        }
        case ArchitecturaIgnota const causa {
            return causa
        }
        case TypusIgnotus const causa {
            return causa
        }
        case ConfiguratioDiversa const causa {
            return causa
        }
        case TensorumDiversum const causa {
            return causa
        }
        case ReferentiaDiversa const causa {
            return causa
        }
        case ManifestumMala const causa {
            return causa
        }
    }
}

# Parse the corpus into the manifest, mapping manifest-level failures to
# the admission channel.
@ private { }
fn _admitto_parse(manifestum.CorpusGguf corpus) → manifestum.ManifestumGguf ⇥ ErrorAdmissionisQwen35moe {
    do {
        return manifestum.parse(corpus)
    }
    catch err {
        throw variant ManifestumMala {causa = manifestum.causa(err)}
    }
}

# Read `general.architecture` as data; a missing or unreadable key falls
# through to the config freeze, which reports it as a family-1 metadata
# divergence at that key.
@ private { }
fn _architectura_lecta(manifestum.ManifestumGguf m) → string ∪ null {
    do {
        return manifestum.textum(m, "general.architecture")
    }
    catch err {
        return null
    }
}

# First tensor with an unknown raw GGML type (Ignota layout), or nihil.
@ private { }
fn _typus_ignotus_primus(manifestum.ManifestumGguf m) → string ∪ null {
    for from m.tensores const t {
        match t.layout {
            case manifestum.Ignota const typo {
                return t.nomen
            }
            case manifestum.Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            }
        }
    }
    return null
}

# Config freeze with the family-1 channel rendered into the admission channel.
@ private { }
fn _admitto_congela(manifestum.ManifestumGguf m) → ConfiguratioQwen35moe ⇥ ErrorAdmissionisQwen35moe {
    do {
        return congela(m)
    }
    catch err {
        throw variant ConfiguratioDiversa {causa = causa(err)}
    }
}

# Canonical tensor map with the families-2-5 channel rendered in.
@ private { }
fn _admitto_tensores(manifestum.ManifestumGguf m) → SummaTensoriorumQwen ⇥ ErrorAdmissionisQwen35moe {
    do {
        return tensores_canonici(m)
    }
    catch err {
        throw variant TensorumDiversum {causa = causa_tensorum(err)}
    }
}

# Cross-reference validation with the M5 channel rendered in.
@ private { }
fn _admitto_referantia(ConfiguratioQwen35moe c, manifestum.ManifestumGguf m) → bool ⇥ ErrorAdmissionisQwen35moe {
    do {
        return referantia(c, m)
    }
    catch err {
        throw variant ReferentiaDiversa {causa = causa_referantiae(err)}
    }
}

@ public { }
fn admitto(manifestum.CorpusGguf corpus, string digestio_exspectata, int longitudo_exspectata) → AdmissioQwen35moe ⇥ ErrorAdmissionisQwen35moe {
    # family 6: identity precondition, before any architecture read
    if corpus.identitas.algorithmus ≠ "sha-256" {
        throw variant IdentitasDiversa {causa = "qwen35moe admission identity divergence: content algorithm"}
    }
    if corpus.identitas.digestio ≠ digestio_exspectata {
        throw variant IdentitasDiversa {causa = "qwen35moe admission identity divergence: SHA-256"}
    }
    if corpus.identitas.longitudo ≠ longitudo_exspectata {
        throw variant IdentitasDiversa {causa = "qwen35moe admission identity divergence: byte length"}
    }
    const manifestum.ManifestumGguf m ← _admitto_parse(corpus)

    # family 7: unknown architecture name — unsupported-but-inspectable
    const string ∪ null architectura ← _architectura_lecta(m)
    if architectura not is null {
        if architectura coalesce "" ≠ "qwen35moe" {
            throw variant ArchitecturaIgnota {causa = "qwen35moe admission refusal: unsupported-but-inspectable architecture " + architectura coalesce ""}
        }
    }

    # family 7: unknown raw GGML type — unsupported-but-inspectable
    const string ∪ null typus_ignotus ← _typus_ignotus_primus(m)
    if typus_ignotus not is null {
        throw variant TypusIgnotus {causa = "qwen35moe admission refusal: unsupported-but-inspectable raw GGML type at " + typus_ignotus coalesce ""}
    }

    # family 1: config freeze
    const ConfiguratioQwen35moe c ← _admitto_congela(m)

    # families 2-5: canonical tensor map
    const SummaTensoriorumQwen s ← _admitto_tensores(m)

    # M5 cross-reference validation
    _admitto_referantia(c, m)
    return AdmissioQwen35moe {configuratio = c, summa = s}
}
