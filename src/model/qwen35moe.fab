+++ toml
locale = "en"

+++ faber
# qwen35moe typed configuration genus and metadata freeze (MODEL-01-M3).
#
# Public import: import from "gradus:model/qwen35moe" qwen35moe
# Depends on: gradus:model/gguf_manifest (typed metadata accessors).
#
# `freeze` freezes the frozen qwen35moe configuration rows from a parsed
# GGUF manifest — every row of the Frozen Architecture Configuration table in
# the MODEL-01 delivery (architecture/quantization, block/embedding,
# attention, rope, expert, SSM, nextn, and the tokenizer identity facts) —
# and enforces the 55-entry metadata count. Mutation family 1 fails closed
# with a typed divergence diagnostic naming the first diverging key: any
# frozen value changed, a required key missing, or an extra unknown
# `qwen35moe.*` key that shadows a required fact. Tokenizer facts are frozen
# as identity only; tokenizer execution is GGUF-A2's unit.

import from "gradus:model/bundle"
import from "gradus:model/config" let cfg
import from "gradus:model/gguf_manifest"
import from "gradus:model/tensor_directory"

const int METADATA_PIN = 55

const int GGUF_FLOAT32 = 6

# Not a top-level static (D5.8/D5.9): the `↦ set<string>` conversion is not
# compile-time evaluable, so the value moves into a function.
fn required_qwen_keys() → set<string> {
    return ["qwen35moe.block_count", "qwen35moe.context_length", "qwen35moe.embedding_length", "qwen35moe.attention.head_count", "qwen35moe.attention.head_count_kv", "qwen35moe.attention.key_length", "qwen35moe.attention.value_length", "qwen35moe.attention.layer_norm_rms_epsilon", "qwen35moe.rope.freq_base", "qwen35moe.rope.dimension_count", "qwen35moe.rope.dimension_sections", "qwen35moe.expert_count", "qwen35moe.expert_used_count", "qwen35moe.expert_feed_forward_length", "qwen35moe.expert_shared_feed_forward_length", "qwen35moe.ssm.conv_kernel", "qwen35moe.ssm.state_size", "qwen35moe.ssm.group_count", "qwen35moe.ssm.time_step_rank", "qwen35moe.ssm.inner_size", "qwen35moe.full_attention_interval", "qwen35moe.nextn_predict_layers"] ↦ set<string>
}

@ public
class Qwen35moeConfig {
    mut string architecture
    mut int file_type
    mut int quantization_version
    mut int block_count
    mut int context_length
    mut int embedding_length
    mut int head_count
    mut int head_count_kv
    mut int key_length
    mut int value_length
    mut f32 rms_norm_epsilon
    mut f32 freq_base
    mut int rope_dimension_count
    mut list<int> rope_sections
    mut int expert_count
    mut int expert_used_count
    mut int expert_ffn_length
    mut int shared_ffn_length
    mut int conv_kernel
    mut int state_size
    mut int group_count
    mut int gradus_temporis
    mut int inner_size
    mut int full_attention_interval
    mut int nextn_predict_layers
    mut string tokenizer_model
    mut string tokenizer_pre
    mut int token_count
    mut int token_type_count
    mut int merge_count
    mut int eos_token_id
    mut int padding_token_id
    mut int bos_token_id
    mut bool add_bos_token
}

@ public
union Qwen35moeConfigError {
    DivergentMetadata {
        string key
        string message
    }
}

# -------------------------------------------------------------------------
# Required-key membership for the extra-unknown-key scan.
# -------------------------------------------------------------------------

fn required_qwen_key(string key) → bool {
    return key ∈ required_qwen_keys()
}

# The first extra `qwen35moe.*` key outside the frozen set, or null.
fn unknown_qwen_key(gguf_manifest.GgufManifest m) → string ∪ none {
    for from m.metadata let meta {
        if meta.key.starts_with("qwen35moe.") and not required_qwen_key(meta.key) then return meta.key
    }

    return null
}

# -------------------------------------------------------------------------
# Typed read-and-pin accessors. Every accessor maps a missing or malformed
# key to a divergence diagnostic naming that key, then compares the read
# value against the frozen expectation. First divergence wins.
# -------------------------------------------------------------------------

fn require_metadata(gguf_manifest.GgufManifest m, string key) → gguf_manifest.GgufMetadata ⇥ Qwen35moeConfigError {
    do {
        return gguf_manifest.metadata(m, key)
    }
    catch err {
        throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }
    }
}

fn require_number(gguf_manifest.GgufManifest m, string key, int expected) → int ⇥ Qwen35moeConfigError {
    mut int observed ← 0

    do {
        observed ← gguf_manifest.number(m, key)
    }
    catch err {
        throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }
    }

    require observed ≡ expected throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }

    return observed
}

fn require_text(gguf_manifest.GgufManifest m, string key, string expected) → string ⇥ Qwen35moeConfigError {
    mut string observed ← ""

    do {
        observed ← gguf_manifest.text(m, key)
    }
    catch err {
        throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }
    }

    require observed ≡ expected throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }

    return observed
}

fn require_bool(gguf_manifest.GgufManifest m, string key, bool expected) → bool ⇥ Qwen35moeConfigError {
    mut bool observed ← false

    do {
        observed ← gguf_manifest.boolean(m, key)
    }
    catch err {
        throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }
    }

    require observed ≡ expected throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }

    return observed
}

fn require_length(gguf_manifest.GgufManifest m, string key, int expected) → int ⇥ Qwen35moeConfigError {
    mut int observed ← 0

    do {
        observed ← gguf_manifest.list_length(m, key)
    }
    catch err {
        throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }
    }

    require observed ≡ expected throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }

    return observed
}

fn require_f32(gguf_manifest.GgufManifest m, string key, f32 expected) → f32 ⇥ Qwen35moeConfigError {
    let gguf_manifest.GgufMetadata meta ← require_metadata(m, key)

    require meta.dtype ≡ GGUF_FLOAT32 throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }

    # Exact IEEE-754 binary32 decode via the language endian-read form:
    # bit-identical for every pattern, NaN payloads included.
    let f32 observed ← meta.payload_wire[0 ‥ 4] ↦ f32 via Le

    require observed ≡ expected throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }

    return observed
}

fn require_sections(gguf_manifest.GgufManifest m, string key) → list<int> ⇥ Qwen35moeConfigError {
    mut list<int> observed ← empty

    do {
        observed ← gguf_manifest.numbers(m, key)
    }
    catch err {
        throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }
    }

    require observed.length() ≡ 4 throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }

    require observed.get(0) coalesce 0 ≡ 11 throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }

    require observed.get(1) coalesce 0 ≡ 11 throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }

    require observed.get(2) coalesce 0 ≡ 10 throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }

    require observed.get(3) coalesce 0 ≡ 0 throw variant DivergentMetadata { key = key, message = "qwen35moe metadata divergence at §"(key) }

    return observed
}

# Freeze the frozen qwen35moe configuration. Reads are in the delivery table
# order, so the first diverging fact is deterministic.
@ public
fn freeze(gguf_manifest.GgufManifest m) → Qwen35moeConfig ⇥ Qwen35moeConfigError {
    # --- architecture + general facts (fail closed) -----------------------
    let string architecture ← require_text(m, "general.architecture", "qwen35moe")
    let int file_type ← require_number(m, "general.file_type", 15)
    let int quantization_version ← require_number(m, "general.quantization_version", 2)
    let int block_count ← require_number(m, "qwen35moe.block_count", 41)
    let int context_length ← require_number(m, "qwen35moe.context_length", 262144)
    let int embedding_length ← require_number(m, "qwen35moe.embedding_length", 2048)

    # --- attention + rope facts -------------------------------------------
    let int head_count ← require_number(m, "qwen35moe.attention.head_count", 16)
    let int head_count_kv ← require_number(m, "qwen35moe.attention.head_count_kv", 2)
    let int key_length ← require_number(m, "qwen35moe.attention.key_length", 256)
    let int value_length ← require_number(m, "qwen35moe.attention.value_length", 256)
    let f32 rms_norm_epsilon ← require_f32(m, "qwen35moe.attention.layer_norm_rms_epsilon", 0.0000009999999974752427 ∷ f32)
    let f32 freq_base ← require_f32(m, "qwen35moe.rope.freq_base", 10000000.0 ∷ f32)
    let int rope_dimension_count ← require_number(m, "qwen35moe.rope.dimension_count", 64)
    let list<int> rope_sections ← require_sections(m, "qwen35moe.rope.dimension_sections")

    # --- expert + ssm facts -----------------------------------------------
    let int expert_count ← require_number(m, "qwen35moe.expert_count", 256)
    let int expert_used_count ← require_number(m, "qwen35moe.expert_used_count", 8)
    let int expert_ffn_length ← require_number(m, "qwen35moe.expert_feed_forward_length", 512)
    let int shared_ffn_length ← require_number(m, "qwen35moe.expert_shared_feed_forward_length", 512)
    let int conv_kernel ← require_number(m, "qwen35moe.ssm.conv_kernel", 4)
    let int state_size ← require_number(m, "qwen35moe.ssm.state_size", 128)
    let int group_count ← require_number(m, "qwen35moe.ssm.group_count", 16)
    let int gradus_temporis ← require_number(m, "qwen35moe.ssm.time_step_rank", 32)
    let int inner_size ← require_number(m, "qwen35moe.ssm.inner_size", 4096)
    let int full_attention_interval ← require_number(m, "qwen35moe.full_attention_interval", 4)
    let int nextn_predict_layers ← require_number(m, "qwen35moe.nextn_predict_layers", 1)

    # --- tokenizer facts --------------------------------------------------
    let string tokenizer_model ← require_text(m, "tokenizer.ggml.model", "gpt2")
    let string tokenizer_pre ← require_text(m, "tokenizer.ggml.pre", "qwen35")
    let int token_count ← require_length(m, "tokenizer.ggml.tokens", 248320)
    let int token_type_count ← require_length(m, "tokenizer.ggml.token_type", 248320)
    let int merge_count ← require_length(m, "tokenizer.ggml.merges", 247587)
    let int eos_token_id ← require_number(m, "tokenizer.ggml.eos_token_id", 248046)
    let int padding_token_id ← require_number(m, "tokenizer.ggml.padding_token_id", 248055)
    let int bos_token_id ← require_number(m, "tokenizer.ggml.bos_token_id", 248044)
    let bool add_bos_token ← require_bool(m, "tokenizer.ggml.add_bos_token", false)

    # --- divergence guard + construct -------------------------------------
    let string ∪ none unknown ← unknown_qwen_key(m)

    reject unknown not is none throw variant DivergentMetadata { key = unknown coalesce "", message = "qwen35moe metadata divergence at §"(unknown coalesce "") }

    require m.metadata.length() ≡ METADATA_PIN throw variant DivergentMetadata { key = "metadata count", message = "qwen35moe metadata divergence at metadata count" }

    return Qwen35moeConfig { architecture = architecture, file_type = file_type, quantization_version = quantization_version, block_count = block_count, context_length = context_length, embedding_length = embedding_length, head_count = head_count, head_count_kv = head_count_kv, key_length = key_length, value_length = value_length, rms_norm_epsilon = rms_norm_epsilon, freq_base = freq_base, rope_dimension_count = rope_dimension_count, rope_sections = rope_sections, expert_count = expert_count, expert_used_count = expert_used_count, expert_ffn_length = expert_ffn_length, shared_ffn_length = shared_ffn_length, conv_kernel = conv_kernel, state_size = state_size, group_count = group_count, gradus_temporis = gradus_temporis, inner_size = inner_size, full_attention_interval = full_attention_interval, nextn_predict_layers = nextn_predict_layers, tokenizer_model = tokenizer_model, tokenizer_pre = tokenizer_pre, token_count = token_count, token_type_count = token_type_count, merge_count = merge_count, eos_token_id = eos_token_id, padding_token_id = padding_token_id, bos_token_id = bos_token_id, add_bos_token = add_bos_token }
}

# -------------------------------------------------------------------------
# MODEL-01-M4: canonical 753-tensor map + 41-block schedule.
#
# `canonical_tensors` admits the four exact family sets from the Canonical
# 753-Tensor Map in the MODEL-01 delivery: global 3 (output.weight /
# output_norm.weight / token_embd.weight), hybrid 19x30, full-attention
# 16x10, and the nextn 20 on blk.40 — every tensor's exact stored shape and
# storage row. The schedule is structural: 41 block indices 0..40, full
# attention at index ≡ 3 mod 4, blk.40 the sole nextn block
# (`nextn_predict_layers` = 1). Anomalies are preserved per-tensor, never
# collapsed to one global storage row: blk.40's ffn_gate_inp.weight and
# ffn_gate_inp_shexp.weight are bf16 (f32 in every other block), and
# ffn_down_exps.weight is q6_K in blk.34/38/39 (q5_K elsewhere). Block-40
# nextn/MTP rule (frozen): the 20 blk.40 tensors are admitted for map
# completeness; the main forward layer schedule is blocks 0..39 and the
# admission claims no nextn/MTP execution semantics — those belong to
# GGUF-M2/M3/M4. Count invariants: 753 tensors total, 55 metadata entries,
# and the derived block-family and storage-distribution counts. Mutation
# families 2 (name), 3 (shape), 4 (storage), and 5 (count) fail closed with
# a typed first-divergence diagnostic naming the first diverging fact.
#
# GGML raw type ids (only the six canonical storage rows are admitted).
const int GGML_F32 = 0

const int GGML_Q8_0 = 8

const int GGML_Q4_K = 12

const int GGML_Q5_K = 13

const int GGML_Q6_K = 14

const int GGML_BF16 = 30

const int TENSOR_PIN = 753

const int BLOCK_PIN = 41

@ public
union Qwen35moeTensorError {
    DivergentName {
        string name
    },
    DivergentShape {
        string name
    },
    DivergentStorage {
        string name
    },
    DivergentCount {
        string message
    }
}

@ public
fn tensor_message(Qwen35moeTensorError e) → string {
    match e {
        case DivergentName let name {
            return "qwen35moe tensor name divergence at §"(name)
        }
        case DivergentShape let name {
            return "qwen35moe tensor shape divergence at §"(name)
        }
        case DivergentStorage let name {
            return "qwen35moe tensor storage divergence at §"(name)
        }
        case Qwen35moeTensorError.DivergentCount let message {
            return "qwen35moe tensor count divergence: §"(message)
        }
    }
}

# Derived admission receipt: block-family and storage-distribution counts.

@ public
class QwenTensorSummary {
    mut int total
    mut int globals
    mut int hybrid
    mut int full_attention
    mut int nextn
    mut int storage_f32
    mut int storage_q8_0
    mut int storage_q4_k
    mut int storage_q5_k
    mut int storage_q6_k
    mut int storage_bf16
    mut int expert_rank3
    mut int storage_q5_0 = 0
    mut int storage_q4_1 = 0
    mut int storage_iq4_nl = 0
    mut int storage_f16 = 0
    mut int storage_u32 = 0
    mut int storage_u8 = 0
    mut int storage_f8_e4m3 = 0
}

# One canonical expectation row (module-internal carrier).
class QwenCanonicalTensor {
    mut string name
    mut list<int> shape
    mut int dtype_ggml
}

# Block class: 0 = hybrid SSM/attention, 1 = full-attention (index ≡ 3 mod
# 4), 2 = the sole nextn block blk.40.
fn block_class_of(int b) → int {
    if b ≡ 40 then return 2

    if b % 4 ≡ 3 then return 1

    return 0
}

fn global_tensors() → list<QwenCanonicalTensor> {
    mut list<QwenCanonicalTensor> out ← empty
    out.append(QwenCanonicalTensor { name = "output.weight", shape = [2048, 248320], dtype_ggml = GGML_Q6_K })
    out.append(QwenCanonicalTensor { name = "output_norm.weight", shape = [2048], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = "token_embd.weight", shape = [2048, 248320], dtype_ggml = GGML_Q8_0 })
    return out
}

# Hybrid SSM/attention block set (19); ffn_down_exps is q6_K in blk.34/38.
fn hybrid_tensors(int b) → list<QwenCanonicalTensor> {
    let string p ← "blk.§"(b ↦ string)
    mut int down_kind ← GGML_Q5_K

    if b ≡ 34 or b ≡ 38 {
        down_kind ← GGML_Q6_K
    }

    mut list<QwenCanonicalTensor> out ← empty
    out.append(QwenCanonicalTensor { name = p + ".attn_gate.weight", shape = [2048, 4096], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".attn_norm.weight", shape = [2048], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".attn_qkv.weight", shape = [2048, 8192], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_down_exps.weight", shape = [512, 2048, 256], dtype_ggml = down_kind })
    out.append(QwenCanonicalTensor { name = p + ".ffn_down_shexp.weight", shape = [512, 2048], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_gate_exps.weight", shape = [2048, 512, 256], dtype_ggml = GGML_Q4_K })
    out.append(QwenCanonicalTensor { name = p + ".ffn_gate_inp.weight", shape = [2048, 256], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_gate_inp_shexp.weight", shape = [2048], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_gate_shexp.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_up_exps.weight", shape = [2048, 512, 256], dtype_ggml = GGML_Q4_K })
    out.append(QwenCanonicalTensor { name = p + ".ffn_up_shexp.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".post_attention_norm.weight", shape = [2048], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".ssm_a", shape = [32], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".ssm_alpha.weight", shape = [2048, 32], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".ssm_beta.weight", shape = [2048, 32], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".ssm_conv1d.weight", shape = [4, 8192], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".ssm_dt.bias", shape = [32], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".ssm_norm.weight", shape = [128], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".ssm_out.weight", shape = [4096, 2048], dtype_ggml = GGML_Q8_0 })
    return out
}

# Full-attention block set (16); ffn_down_exps is q6_K in blk.39.
fn dense_tensors(int b) → list<QwenCanonicalTensor> {
    let string p ← "blk.§"(b ↦ string)
    mut int down_kind ← GGML_Q5_K

    if b ≡ 39 {
        down_kind ← GGML_Q6_K
    }

    mut list<QwenCanonicalTensor> out ← empty
    out.append(QwenCanonicalTensor { name = p + ".attn_k.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".attn_k_norm.weight", shape = [256], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".attn_norm.weight", shape = [2048], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".attn_output.weight", shape = [4096, 2048], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".attn_q.weight", shape = [2048, 8192], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".attn_q_norm.weight", shape = [256], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".attn_v.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_down_exps.weight", shape = [512, 2048, 256], dtype_ggml = down_kind })
    out.append(QwenCanonicalTensor { name = p + ".ffn_down_shexp.weight", shape = [512, 2048], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_gate_exps.weight", shape = [2048, 512, 256], dtype_ggml = GGML_Q4_K })
    out.append(QwenCanonicalTensor { name = p + ".ffn_gate_inp.weight", shape = [2048, 256], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_gate_inp_shexp.weight", shape = [2048], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_gate_shexp.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_up_exps.weight", shape = [2048, 512, 256], dtype_ggml = GGML_Q4_K })
    out.append(QwenCanonicalTensor { name = p + ".ffn_up_shexp.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".post_attention_norm.weight", shape = [2048], dtype_ggml = GGML_F32 })
    return out
}

# Nextn block blk.40 set (20): the full-attention 16 with the frozen bf16
# anomaly on ffn_gate_inp / ffn_gate_inp_shexp, plus the four nextn.*
# tensors. ffn_down_exps stays q5_K (blk.40 is not in the q6_K anomaly set).
fn nextn_tensors() → list<QwenCanonicalTensor> {
    let string p ← "blk.40"
    mut list<QwenCanonicalTensor> out ← empty
    out.append(QwenCanonicalTensor { name = p + ".attn_k.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".attn_k_norm.weight", shape = [256], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".attn_norm.weight", shape = [2048], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".attn_output.weight", shape = [4096, 2048], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".attn_q.weight", shape = [2048, 8192], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".attn_q_norm.weight", shape = [256], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".attn_v.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_down_exps.weight", shape = [512, 2048, 256], dtype_ggml = GGML_Q5_K })
    out.append(QwenCanonicalTensor { name = p + ".ffn_down_shexp.weight", shape = [512, 2048], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_gate_exps.weight", shape = [2048, 512, 256], dtype_ggml = GGML_Q4_K })
    out.append(QwenCanonicalTensor { name = p + ".ffn_gate_inp.weight", shape = [2048, 256], dtype_ggml = GGML_BF16 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_gate_inp_shexp.weight", shape = [2048], dtype_ggml = GGML_BF16 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_gate_shexp.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".ffn_up_exps.weight", shape = [2048, 512, 256], dtype_ggml = GGML_Q4_K })
    out.append(QwenCanonicalTensor { name = p + ".ffn_up_shexp.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".post_attention_norm.weight", shape = [2048], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".nextn.eh_proj.weight", shape = [4096, 2048], dtype_ggml = GGML_Q8_0 })
    out.append(QwenCanonicalTensor { name = p + ".nextn.enorm.weight", shape = [2048], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".nextn.hnorm.weight", shape = [2048], dtype_ggml = GGML_F32 })
    out.append(QwenCanonicalTensor { name = p + ".nextn.shared_head_norm.weight", shape = [2048], dtype_ggml = GGML_F32 })
    return out
}

fn canonical_block(int b) → list<QwenCanonicalTensor> {
    if b ≡ 40 then return nextn_tensors()

    if b % 4 ≡ 3 then return dense_tensors(b)

    return hybrid_tensors(b)
}

# Locate one canonical tensor in the manifest; a missing name is the family-2
# divergence (the manifest's own duplicate-name rejection runs at parse time).
fn find(gguf_manifest.GgufManifest m, string name) → gguf_manifest.GgufTensorDescriptor ⇥ Qwen35moeTensorError {
    do {
        return gguf_manifest.find_tensor(m, name)
    }
    catch err {
        throw variant DivergentName { name = name }
    }
}

# Name -> shape -> storage check order makes the first diverging fact
# deterministic per canonical entry.
fn require_tensor_shape(gguf_manifest.GgufManifest m, QwenCanonicalTensor c) → bool ⇥ Qwen35moeTensorError {
    let gguf_manifest.GgufTensorDescriptor tensor ← find(m, c.name)

    require tensor.shape.length() ≡ c.shape.length() throw variant DivergentShape { name = c.name }

    for range 0 ‥ c.shape.length() let i {
        require tensor.shape.get(i) coalesce 0 ≡ c.shape.get(i) coalesce 0 throw variant DivergentShape { name = c.name }
    }

    require tensor.dtype_ggml ≡ c.dtype_ggml throw variant DivergentStorage { name = c.name }

    return true
}

# Admit the canonical map: count invariants fail closed first (family 5),
# then every canonical tensor is matched name/shape/storage in canonical
# order (families 2-4). The receipt counts are derived, so the schedule and
# storage distribution are proven from the admitted tensors themselves.
@ public
fn canonical_tensors(gguf_manifest.GgufManifest m) → QwenTensorSummary ⇥ Qwen35moeTensorError {
    # --- count invariants (fail closed) -----------------------------------
    require m.tensors.length() ≡ TENSOR_PIN throw variant Qwen35moeTensorError.DivergentCount { message = "tensor count § ≠ §"(m.tensors.length() ↦ string, TENSOR_PIN ↦ string) }

    require m.metadata.length() ≡ METADATA_PIN throw variant Qwen35moeTensorError.DivergentCount { message = "metadata count § ≠ §"(m.metadata.length() ↦ string, METADATA_PIN ↦ string) }

    # --- global tensors ---------------------------------------------------
    mut int n_global ← 0
    mut int n_hybrid ← 0
    mut int n_full_attention ← 0
    mut int n_nextn ← 0
    mut int n_f32 ← 0
    mut int n_q8_0 ← 0
    mut int n_q4_k ← 0
    mut int n_q5_k ← 0
    mut int n_q6_k ← 0
    mut int n_bf16 ← 0
    mut int n_rank3 ← 0
    let list<QwenCanonicalTensor> globals ← global_tensors()

    for from globals let c {
        require_tensor_shape(m, c)
        n_global ↑

        if c.dtype_ggml ≡ GGML_F32 {
            n_f32 ↑
        }

        if c.dtype_ggml ≡ GGML_Q8_0 {
            n_q8_0 ↑
        }

        if c.dtype_ggml ≡ GGML_Q6_K {
            n_q6_k ↑
        }
    }

    # --- per-block schedule (hybrid / full-attention / nextn) -------------
    for range 0 ‥ BLOCK_PIN let b {
        let list<QwenCanonicalTensor> canon ← canonical_block(b)
        let int block_class ← block_class_of(b)

        for from canon let c {
            require_tensor_shape(m, c)

            if block_class ≡ 0 {
                n_hybrid ↑
            }

            if block_class ≡ 1 {
                n_full_attention ↑
            }

            if block_class ≡ 2 {
                n_nextn ↑
            }

            if c.dtype_ggml ≡ GGML_F32 {
                n_f32 ↑
            }

            if c.dtype_ggml ≡ GGML_Q8_0 {
                n_q8_0 ↑
            }

            if c.dtype_ggml ≡ GGML_Q4_K {
                n_q4_k ↑
            }

            if c.dtype_ggml ≡ GGML_Q5_K {
                n_q5_k ↑
            }

            if c.dtype_ggml ≡ GGML_Q6_K {
                n_q6_k ↑
            }

            if c.dtype_ggml ≡ GGML_BF16 {
                n_bf16 ↑
            }

            if c.shape.length() ≡ 3 {
                n_rank3 ↑
            }
        }
    }

    # --- summary receipt --------------------------------------------------
    return QwenTensorSummary { total = TENSOR_PIN, globals = n_global, hybrid = n_hybrid, full_attention = n_full_attention, nextn = n_nextn, storage_f32 = n_f32, storage_q8_0 = n_q8_0, storage_q4_k = n_q4_k, storage_q5_k = n_q5_k, storage_q6_k = n_q6_k, storage_bf16 = n_bf16, expert_rank3 = n_rank3 }
}

# -------------------------------------------------------------------------
# MODEL-01-M5: dimension/storage cross-reference validation.
#
# `reference` cross-references the frozen configuration (M3) against the
# manifest tensors, deriving every expected dim from the config so a
# config/tensor pair that is individually frozen can still diverge:
# `embedding_length` at its stored-dim positions per family,
# `expert_count` as rank-3 dim 2 of the three `*_exps` tensors and dim 1 of
# `ffn_gate_inp`, `expert_feed_forward_length` at the down/gate-up
# positions, the ssm dims (`state_size` / `time_step_rank` / `conv_kernel`
# / `inner_size`), `head_count_kv` × `key_length` = dim 1 of
# `attn_k`/`attn_v` (norms carry 256), block-schedule consistency, element
# counts = product of stored dims, and the GGUF-A1a/A1b absolute range
# bound. The first diverging cross-fact fails with a typed diagnostic
# naming that tensor.
# -------------------------------------------------------------------------


@ public
union Qwen35moeReferenceError {
    UnknownName {
        string name
    },
    DivergentDimension {
        string name
    },
    DivergentCount {
        string message
    },
    BadRange {
        string message
    }
}

@ public
fn reference_message(Qwen35moeReferenceError e) → string {
    match e {
        case UnknownName let name {
            return "qwen35moe cross-reference name divergence at §"(name)
        }
        case DivergentDimension let name {
            return "qwen35moe cross-reference dimension divergence at §"(name)
        }
        case Qwen35moeReferenceError.DivergentCount let message {
            return "qwen35moe cross-reference count divergence: §"(message)
        }
        case BadRange let message {
            return "qwen35moe cross-reference range divergence: §"(message)
        }
    }
}

fn find_reference(gguf_manifest.GgufManifest m, string name) → gguf_manifest.GgufTensorDescriptor ⇥ Qwen35moeReferenceError {
    do {
        return gguf_manifest.find_tensor(m, name)
    }
    catch err {
        throw variant UnknownName { name = name }
    }
}

# Check one stored-dim position (GGUF file order); a rank below the index
# is itself the diverging fact.
fn reference_dim(gguf_manifest.GgufManifest m, string name, int index, int expected) → bool ⇥ Qwen35moeReferenceError {
    let gguf_manifest.GgufTensorDescriptor t ← find_reference(m, name)

    require t.shape.length() ≻ index throw variant DivergentDimension { name = name }

    require t.shape.get(index) coalesce 0 ≡ expected throw variant DivergentDimension { name = name }

    return true
}

fn reference_rank(gguf_manifest.GgufManifest m, string name, int expected) → bool ⇥ Qwen35moeReferenceError {
    let gguf_manifest.GgufTensorDescriptor t ← find_reference(m, name)

    require t.shape.length() ≡ expected throw variant DivergentDimension { name = name }

    return true
}

# Single stored dim of the rank-1 norm tensors.
fn reference_one(gguf_manifest.GgufManifest m, string name, int expected) → bool ⇥ Qwen35moeReferenceError {
    reference_rank(m, name, 1)
    reference_dim(m, name, 0, expected)
    return true
}

# The expert family, shared by every block class. Down stores
# [ffn, embd, experts]; gate/up store [embd, ffn, experts]; `ffn_gate_inp`
# carries [embd, experts].
fn reference_ffn(gguf_manifest.GgufManifest m, Qwen35moeConfig c, string p) → bool ⇥ Qwen35moeReferenceError {
    reference_dim(m, p + ".ffn_down_exps.weight", 0, c.expert_ffn_length)
    reference_dim(m, p + ".ffn_down_exps.weight", 1, c.embedding_length)
    reference_dim(m, p + ".ffn_down_exps.weight", 2, c.expert_count)
    reference_dim(m, p + ".ffn_down_shexp.weight", 0, c.expert_ffn_length)
    reference_dim(m, p + ".ffn_down_shexp.weight", 1, c.embedding_length)
    reference_dim(m, p + ".ffn_gate_exps.weight", 0, c.embedding_length)
    reference_dim(m, p + ".ffn_gate_exps.weight", 1, c.expert_ffn_length)
    reference_dim(m, p + ".ffn_gate_exps.weight", 2, c.expert_count)
    reference_dim(m, p + ".ffn_gate_inp.weight", 0, c.embedding_length)
    reference_dim(m, p + ".ffn_gate_inp.weight", 1, c.expert_count)
    reference_one(m, p + ".ffn_gate_inp_shexp.weight", c.embedding_length)
    reference_dim(m, p + ".ffn_gate_shexp.weight", 0, c.embedding_length)
    reference_dim(m, p + ".ffn_gate_shexp.weight", 1, c.expert_ffn_length)
    reference_dim(m, p + ".ffn_up_exps.weight", 0, c.embedding_length)
    reference_dim(m, p + ".ffn_up_exps.weight", 1, c.expert_ffn_length)
    reference_dim(m, p + ".ffn_up_exps.weight", 2, c.expert_count)
    reference_dim(m, p + ".ffn_up_shexp.weight", 0, c.embedding_length)
    reference_dim(m, p + ".ffn_up_shexp.weight", 1, c.expert_ffn_length)
    return true
}

# Hybrid SSM/attention block family (19 blocks, index ≢ 3 mod 4, ≠ 40).
fn reference_hybrid(gguf_manifest.GgufManifest m, Qwen35moeConfig c, string p) → bool ⇥ Qwen35moeReferenceError {
    reference_dim(m, p + ".attn_gate.weight", 0, c.embedding_length)
    reference_dim(m, p + ".attn_gate.weight", 1, c.inner_size)
    reference_one(m, p + ".attn_norm.weight", c.embedding_length)
    reference_dim(m, p + ".attn_qkv.weight", 0, c.embedding_length)
    reference_ffn(m, c, p)
    reference_one(m, p + ".post_attention_norm.weight", c.embedding_length)
    reference_one(m, p + ".ssm_a", c.gradus_temporis)
    reference_dim(m, p + ".ssm_alpha.weight", 0, c.embedding_length)
    reference_dim(m, p + ".ssm_alpha.weight", 1, c.gradus_temporis)
    reference_dim(m, p + ".ssm_beta.weight", 0, c.embedding_length)
    reference_dim(m, p + ".ssm_beta.weight", 1, c.gradus_temporis)
    reference_dim(m, p + ".ssm_conv1d.weight", 0, c.conv_kernel)
    reference_one(m, p + ".ssm_dt.bias", c.gradus_temporis)
    reference_one(m, p + ".ssm_norm.weight", c.state_size)
    reference_dim(m, p + ".ssm_out.weight", 0, c.inner_size)
    reference_dim(m, p + ".ssm_out.weight", 1, c.embedding_length)
    return true
}

# Full-attention block family core (16 blocks, index ≡ 3 mod 4).
fn reference_dense_core(gguf_manifest.GgufManifest m, Qwen35moeConfig c, string p) → bool ⇥ Qwen35moeReferenceError {
    let int kv_projection ← c.head_count_kv * c.key_length
    reference_dim(m, p + ".attn_k.weight", 0, c.embedding_length)
    reference_dim(m, p + ".attn_k.weight", 1, kv_projection)
    reference_one(m, p + ".attn_k_norm.weight", c.key_length)
    reference_one(m, p + ".attn_norm.weight", c.embedding_length)
    reference_dim(m, p + ".attn_output.weight", 0, c.inner_size)
    reference_dim(m, p + ".attn_output.weight", 1, c.embedding_length)
    reference_dim(m, p + ".attn_q.weight", 0, c.embedding_length)
    reference_one(m, p + ".attn_q_norm.weight", c.key_length)
    reference_dim(m, p + ".attn_v.weight", 0, c.embedding_length)
    reference_dim(m, p + ".attn_v.weight", 1, kv_projection)
    reference_ffn(m, c, p)
    reference_one(m, p + ".post_attention_norm.weight", c.embedding_length)
    return true
}

# Cross-reference the frozen config against the manifest. Block families
# run in schedule order so the first diverging cross-fact is deterministic.
@ public
fn reference(Qwen35moeConfig c, gguf_manifest.GgufManifest m) → bool ⇥ Qwen35moeReferenceError {
    # --- global head tensors ----------------------------------------------
    reference_dim(m, "output.weight", 0, c.embedding_length)
    reference_one(m, "output_norm.weight", c.embedding_length)
    reference_dim(m, "token_embd.weight", 0, c.embedding_length)

    # --- per-block schedule (dense core / hybrid / nextn) -----------------
    mut int n_full ← 0
    mut int n_nextn ← 0

    for range 0 ‥ BLOCK_PIN let b {
        let string p ← "blk.§"(b ↦ string)

        if b ≡ 40 {
            reference_dense_core(m, c, p)
            reference_dim(m, p + ".nextn.eh_proj.weight", 0, c.inner_size)
            reference_dim(m, p + ".nextn.eh_proj.weight", 1, c.embedding_length)
            reference_one(m, p + ".nextn.enorm.weight", c.embedding_length)
            reference_one(m, p + ".nextn.hnorm.weight", c.embedding_length)
            reference_one(m, p + ".nextn.shared_head_norm.weight", c.embedding_length)
            n_nextn ↑
        }
        else {
            if b % 4 ≡ 3 {
                reference_dense_core(m, c, p)
                n_full ↑
            }
            else {
                reference_hybrid(m, c, p)
            }
        }
    }

    # --- count + element/range invariants (fail closed) -------------------
    let int expected_full ← (BLOCK_PIN - 1) / c.full_attention_interval

    require n_full ≡ expected_full throw variant Qwen35moeReferenceError.DivergentCount { message = "full-attention blocks § ≠ §"(n_full ↦ string, expected_full ↦ string) }

    require n_nextn ≡ c.nextn_predict_layers throw variant Qwen35moeReferenceError.DivergentCount { message = "nextn blocks § ≠ §"(n_nextn ↦ string, c.nextn_predict_layers ↦ string) }

    for from m.tensors let t {
        mut int product ← 1

        for from t.shape let d {
            product ← product * d
        }

        require t.elements ≡ product throw variant Qwen35moeReferenceError.DivergentCount { message = "element count of §"(t.name) }

        require m.data_start + t.relative_offset ≤ m.artifact_length throw variant BadRange { message = "§ range exceeds the artifact"(t.name) }
    }

    return true
}

# -------------------------------------------------------------------------
# MODEL-01-M6: admission entry point + identity precondition + typed
# refusal matrix.
#
# `admit` is the public admission entry on the module. It composes the
# identity precondition (family 6: byte length / SHA-256 divergence fails
# before any architecture read) -> config freeze (M3, family 1) ->
# canonical tensor map (M4, families 2-5) -> cross-reference validation
# (M5), and returns ADMIT with the frozen configuration + the 753-tensor
# receipt. Family 7 (unsupported-but-inspectable) refuses an unknown
# architecture name or raw GGML type: those stay inspectable as data per
# GGUF-A1a but cannot admit as qwen35moe. Every failure returns a typed
# first-divergence diagnostic naming the first diverging fact. Admission
# error variants carry the rendered diagnostic text; the module-level M3/M4/
# M5 typed enums (Qwen35moeConfigError / Qwen35moeTensorError /
# Qwen35moeReferenceError) stay public for direct callers of freeze /
# canonical_tensors / reference.
# -------------------------------------------------------------------------


@ public
class Qwen35moeAdmission {
    mut Qwen35moeConfig config
    mut QwenTensorSummary summary
}

@ public
union Qwen35moeAdmissionError {
    DivergentIdentity {
        string message
    },
    UnknownArchitecture {
        string message
    },
    UnknownType {
        string message
    },
    DivergentConfig {
        string message
    },
    DivergentTensors {
        string message
    },
    DivergentReference {
        string message
    },
    BadManifest {
        string message
    }
}

@ public
fn admission_message(Qwen35moeAdmissionError e) → string {
    match e {
        case DivergentIdentity let message {
            return message
        }
        case UnknownArchitecture let message {
            return message
        }
        case UnknownType let message {
            return message
        }
        case DivergentConfig let message {
            return message
        }
        case DivergentTensors let message {
            return message
        }
        case DivergentReference let message {
            return message
        }
        case BadManifest let message {
            return message
        }
    }
}

# Parse the corpus into the manifest, mapping manifest-level failures to
# the admission channel.
fn parse_admission(gguf_manifest.GgufCorpus corpus) → gguf_manifest.GgufManifest ⇥ Qwen35moeAdmissionError {
    do {
        return gguf_manifest.parse(corpus)
    }
    catch err {
        throw variant BadManifest { message = err.message }
    }
}

# Read `general.architecture` as data; a missing or unreadable key falls
# through to the config freeze, which reports it as a family-1 metadata
# divergence at that key.
fn read_architecture(gguf_manifest.GgufManifest m) → string ∪ none {
    do {
        return gguf_manifest.text(m, "general.architecture")
    }
    catch err {
        return null
    }
}

# First tensor with an unknown raw GGML type (Unknown layout), or null.
fn first_unknown_dtype(gguf_manifest.GgufManifest m) → string ∪ none {
    for from m.tensors let t {
        match t.layout {
            case gguf_manifest.Unknown let kind {
                return t.name
            }
            case gguf_manifest.Known let elements_per_block, bytes_per_block, byte_length {
            }
        }
    }

    return null
}

# Config freeze with the family-1 channel rendered into the admission channel.
fn freeze_admission(gguf_manifest.GgufManifest m) → Qwen35moeConfig ⇥ Qwen35moeAdmissionError {
    do {
        return freeze(m)
    }
    catch err {
        match err {
            case DivergentMetadata let key, message {
                throw variant DivergentConfig { message = message }
            }
        }
    }
}

# Canonical tensor map with the families-2-5 channel rendered in.
fn admit_tensors(gguf_manifest.GgufManifest m) → QwenTensorSummary ⇥ Qwen35moeAdmissionError {
    do {
        return canonical_tensors(m)
    }
    catch err {
        throw variant DivergentTensors { message = tensor_message(err) }
    }
}

# Cross-reference validation with the M5 channel rendered in.
fn admit_references(Qwen35moeConfig c, gguf_manifest.GgufManifest m) → bool ⇥ Qwen35moeAdmissionError {
    do {
        return reference(c, m)
    }
    catch err {
        throw variant DivergentReference { message = reference_message(err) }
    }
}

@ public
fn admit(gguf_manifest.GgufCorpus corpus, string expected_digest, int expected_length) → Qwen35moeAdmission ⇥ Qwen35moeAdmissionError {
    # --- identity precondition (fail closed) ------------------------------
    require corpus.identity.algorithm ≡ "sha-256" throw variant DivergentIdentity { message = "qwen35moe admission identity divergence: content algorithm" }

    require corpus.identity.digest ≡ expected_digest throw variant DivergentIdentity { message = "qwen35moe admission identity divergence: SHA-256" }

    require corpus.identity.length ≡ expected_length throw variant DivergentIdentity { message = "qwen35moe admission identity divergence: byte length" }

    let gguf_manifest.GgufManifest m ← parse_admission(corpus)

    # --- architecture + dtype knownness (fail closed) ---------------------
    let string ∪ none architecture ← read_architecture(m)

    if architecture not is none {
        require architecture coalesce "" ≡ "qwen35moe" throw variant UnknownArchitecture { message = "qwen35moe admission refusal: unsupported-but-inspectable architecture §"(architecture coalesce "") }
    }

    let string ∪ none unknown_type ← first_unknown_dtype(m)

    reject unknown_type not is none throw variant UnknownType { message = "qwen35moe admission refusal: unsupported-but-inspectable raw GGML type at §"(unknown_type coalesce "") }

    # --- config freeze + canonical tensor map -----------------------------
    let Qwen35moeConfig c ← freeze_admission(m)
    let QwenTensorSummary s ← admit_tensors(m)

    # --- cross-reference validation ---------------------------------------
    admit_references(c, m)
    return Qwen35moeAdmission { config = c, summary = s }
}

# -------------------------------------------------------------------------
# TensorDirectory + admitted metadata path (no hardcoded 55/753/41 pins).
# Supports both 41-block Qwen3.5 (nextn = 1) and 40-block Qwen3.6-35B-A3B
# (nextn = 0) across Safetensors and GGUF TensorDirectories.
# -------------------------------------------------------------------------

fn opt_gguf_number(gguf_manifest.GgufManifest m, string key, int fallback) → int {
    do {
        return gguf_manifest.number(m, key)
    }
    catch err {
        return fallback
    }
}

fn req_gguf_number(gguf_manifest.GgufManifest m, string key) → int ⇥ Qwen35moeConfigError {
    do {
        return gguf_manifest.number(m, key)
    }
    catch err {
        throw variant DivergentMetadata { key = key, message = "qwen35moe metadata missing or invalid at §"(key) }
    }
}

fn opt_gguf_f32(gguf_manifest.GgufManifest m, string key, f32 fallback) → f32 {
    do {
        let gguf_manifest.GgufMetadata meta ← gguf_manifest.metadata(m, key)
        if meta.dtype ≡ GGUF_FLOAT32 and meta.payload_wire.length() ≥ 4 {
            return meta.payload_wire[0 ‥ 4] ↦ f32 via Le
        }
        return fallback
    }
    catch err {
        return fallback
    }
}

fn opt_gguf_text(gguf_manifest.GgufManifest m, string key, string fallback) → string {
    do {
        return gguf_manifest.text(m, key)
    }
    catch err {
        return fallback
    }
}

fn opt_gguf_list_length(gguf_manifest.GgufManifest m, string key, int fallback) → int {
    do {
        return gguf_manifest.list_length(m, key)
    }
    catch err {
        return fallback
    }
}

fn opt_gguf_bool(gguf_manifest.GgufManifest m, string key, bool fallback) → bool {
    do {
        return gguf_manifest.boolean(m, key)
    }
    catch err {
        return fallback
    }
}

@ public
fn config_from_gguf(gguf_manifest.GgufManifest m) → Qwen35moeConfig ⇥ Qwen35moeConfigError {
    let string arch ← require_text(m, "general.architecture", "qwen35moe")
    let int file_type ← opt_gguf_number(m, "general.file_type", 0)
    let int quantization_version ← opt_gguf_number(m, "general.quantization_version", 2)
    let int block_count ← req_gguf_number(m, "qwen35moe.block_count")
    require block_count ≥ 1 throw variant DivergentMetadata { key = "qwen35moe.block_count", message = "qwen35moe.block_count must be positive" }

    let int context_length ← opt_gguf_number(m, "qwen35moe.context_length", 262144)
    let int embedding_length ← req_gguf_number(m, "qwen35moe.embedding_length")
    let int head_count ← req_gguf_number(m, "qwen35moe.attention.head_count")
    let int head_count_kv ← req_gguf_number(m, "qwen35moe.attention.head_count_kv")
    let int key_length ← opt_gguf_number(m, "qwen35moe.attention.key_length", embedding_length / head_count)
    let int value_length ← opt_gguf_number(m, "qwen35moe.attention.value_length", key_length)
    let f32 rms_norm_epsilon ← opt_gguf_f32(m, "qwen35moe.attention.layer_norm_rms_epsilon", 1.0e-6 ∷ f32)
    let f32 freq_base ← opt_gguf_f32(m, "qwen35moe.rope.freq_base", 10000000.0 ∷ f32)

    mut list<int> rope_sections ← empty
    do {
        rope_sections ← gguf_manifest.numbers(m, "qwen35moe.rope.dimension_sections")
    }
    catch err {
        rope_sections ← [11, 11, 10, 0]
    }

    mut int derived_rope_pairs ← 0
    for from rope_sections let s {
        derived_rope_pairs ← derived_rope_pairs + s
    }
    let int derived_rope_dim ← derived_rope_pairs ≻ 0 ✓ (derived_rope_pairs * 2) ✗ 64
    let int rope_dimension_count ← opt_gguf_number(m, "qwen35moe.rope.dimension_count", derived_rope_dim)

    let int expert_count ← opt_gguf_number(m, "qwen35moe.expert_count", 256)
    let int expert_used_count ← opt_gguf_number(m, "qwen35moe.expert_used_count", 8)
    let int expert_ffn_length ← opt_gguf_number(m, "qwen35moe.expert_feed_forward_length", 512)
    let int shared_ffn_length ← opt_gguf_number(m, "qwen35moe.expert_shared_feed_forward_length", 512)
    let int conv_kernel ← opt_gguf_number(m, "qwen35moe.ssm.conv_kernel", 4)
    let int state_size ← opt_gguf_number(m, "qwen35moe.ssm.state_size", 128)
    let int group_count ← opt_gguf_number(m, "qwen35moe.ssm.group_count", 16)
    let int gradus_temporis ← opt_gguf_number(m, "qwen35moe.ssm.time_step_rank", 32)
    let int inner_size ← opt_gguf_number(m, "qwen35moe.ssm.inner_size", 4096)
    let int full_attention_interval ← opt_gguf_number(m, "qwen35moe.full_attention_interval", 4)
    let int nextn_predict_layers ← opt_gguf_number(m, "qwen35moe.nextn_predict_layers", 0)
    require nextn_predict_layers ≥ 0 and nextn_predict_layers ≺ block_count throw variant DivergentMetadata { key = "qwen35moe.nextn_predict_layers", message = "qwen35moe.nextn_predict_layers out of range" }

    let string tokenizer_model ← opt_gguf_text(m, "tokenizer.ggml.model", "gpt2")
    let string tokenizer_pre ← opt_gguf_text(m, "tokenizer.ggml.pre", "qwen35")
    let int token_count ← opt_gguf_list_length(m, "tokenizer.ggml.tokens", 0)
    let int token_type_count ← opt_gguf_list_length(m, "tokenizer.ggml.token_type", 0)
    let int merge_count ← opt_gguf_list_length(m, "tokenizer.ggml.merges", 0)
    let int eos_token_id ← opt_gguf_number(m, "tokenizer.ggml.eos_token_id", 0)
    let int padding_token_id ← opt_gguf_number(m, "tokenizer.ggml.padding_token_id", 0)
    let int bos_token_id ← opt_gguf_number(m, "tokenizer.ggml.bos_token_id", 0)
    let bool add_bos_token ← opt_gguf_bool(m, "tokenizer.ggml.add_bos_token", false)

    return Qwen35moeConfig { architecture = arch, file_type = file_type, quantization_version = quantization_version, block_count = block_count, context_length = context_length, embedding_length = embedding_length, head_count = head_count, head_count_kv = head_count_kv, key_length = key_length, value_length = value_length, rms_norm_epsilon = rms_norm_epsilon, freq_base = freq_base, rope_dimension_count = rope_dimension_count, rope_sections = rope_sections, expert_count = expert_count, expert_used_count = expert_used_count, expert_ffn_length = expert_ffn_length, shared_ffn_length = shared_ffn_length, conv_kernel = conv_kernel, state_size = state_size, group_count = group_count, gradus_temporis = gradus_temporis, inner_size = inner_size, full_attention_interval = full_attention_interval, nextn_predict_layers = nextn_predict_layers, tokenizer_model = tokenizer_model, tokenizer_pre = tokenizer_pre, token_count = token_count, token_type_count = token_type_count, merge_count = merge_count, eos_token_id = eos_token_id, padding_token_id = padding_token_id, bos_token_id = bos_token_id, add_bos_token = add_bos_token }
}

@ public
fn config_from_directory(cfg.ModelConfig mc, tensor_directory.TensorDirectory dir) → Qwen35moeConfig ⇥ Qwen35moeConfigError {
    require mc.num_hidden_layers ≥ 1 throw variant DivergentMetadata { key = "num_hidden_layers", message = "num_hidden_layers must be positive" }
    require mc.hidden_size ≥ 1 throw variant DivergentMetadata { key = "hidden_size", message = "hidden_size must be positive" }
    require mc.num_attention_heads ≥ 1 throw variant DivergentMetadata { key = "num_attention_heads", message = "num_attention_heads must be positive" }
    require mc.num_key_value_heads ≥ 1 throw variant DivergentMetadata { key = "num_key_value_heads", message = "num_key_value_heads must be positive" }

    let int last_idx ← mc.num_hidden_layers - 1
    let string last_s ← last_idx ↦ string
    let bool has_nextn ← tensor_directory.has_tensor(dir, variant bundle.MemberRole.Backbone, "mtp.fc.weight") or tensor_directory.has_tensor(dir, variant bundle.MemberRole.Backbone, "model.layers.§.eh_proj.weight"(last_s)) or tensor_directory.has_tensor(dir, variant bundle.MemberRole.Backbone, "blk.§.nextn.enorm.weight"(last_s))
    let int nextn_predict_layers ← has_nextn ✓ 1 ✗ 0

    mut int vocab ← mc.vocab_size
    do {
        let tensor_directory.DirectoryEntry emb ← tensor_directory.lookup_backbone(dir, "model.embed_tokens.weight")
        if emb.shape.length() ≥ 2 {
            match emb.container {
                case bundle.ContainerKind.Gguf {
                    vocab ← emb.shape[1]
                }
                case bundle.ContainerKind.Safetensors {
                    vocab ← emb.shape[0]
                }
            }
        }
    }
    catch err {
        pass
    }

    let list<int> rope_sections ← mc.rope_dimension_sections.length() ≻ 0 ✓ mc.rope_dimension_sections ✗ [11, 11, 10, 0]
    mut int rope_pairs ← 0
    for from rope_sections let s {
        rope_pairs ← rope_pairs + s
    }
    let int rope_dim ← rope_pairs ≻ 0 ✓ (rope_pairs * 2) ✗ 64

    let int expert_ffn ← mc.moe_intermediate_size coalesce mc.intermediate_size
    let int shared_ffn ← mc.shared_expert_intermediate_size coalesce expert_ffn

    return Qwen35moeConfig { architecture = mc.model_type, file_type = 0, quantization_version = 2, block_count = mc.num_hidden_layers, context_length = mc.max_position_embeddings, embedding_length = mc.hidden_size, head_count = mc.num_attention_heads, head_count_kv = mc.num_key_value_heads, key_length = mc.head_dim, value_length = mc.head_dim, rms_norm_epsilon = mc.rms_norm_eps, freq_base = mc.rope_theta, rope_dimension_count = rope_dim, rope_sections = rope_sections, expert_count = mc.num_local_experts coalesce 256, expert_used_count = mc.num_experts_per_tok coalesce 8, expert_ffn_length = expert_ffn, shared_ffn_length = shared_ffn, conv_kernel = mc.ssm_conv_kernel coalesce 4, state_size = mc.ssm_state_size coalesce 128, group_count = mc.ssm_group_count coalesce 16, gradus_temporis = mc.ssm_time_step_rank coalesce 32, inner_size = mc.ssm_inner_size coalesce 4096, full_attention_interval = mc.full_attention_interval coalesce 4, nextn_predict_layers = nextn_predict_layers, tokenizer_model = "gpt2", tokenizer_pre = "qwen35", token_count = vocab, token_type_count = vocab, merge_count = 0, eos_token_id = 0, padding_token_id = 0, bos_token_id = 0, add_bos_token = false }
}

fn dir_digits(string s) → bool {
    if s.length() ≡ 0 then return false
    for from s let c {
        if not "0123456789".contains(c ↦ string) then return false
    }
    return true
}

fn dir_find_dot(string s, int start) → int {
    for range start ‥ s.length() let i {
        if s.slice(i, i + 1) ≡ "." then return i
    }
    return -1
}

fn parse_layer_index(string name, string prefix, int block_count) → int ⇥ Qwen35moeTensorError {
    let int p_len ← prefix.length()
    let int dot ← dir_find_dot(name, p_len)
    require dot ≻ p_len throw variant DivergentName { name = name }
    let string d ← name.slice(p_len, dot)
    require dir_digits(d) throw variant DivergentName { name = name }

    mut int idx ← -1
    do {
        idx ← d ↦ int
    }
    catch err {
        throw variant DivergentName { name = name }
    }

    require idx ≥ 0 and idx ≺ block_count throw variant DivergentName { name = name }
    return idx
}

@ public
fn resolve_in_directory(tensor_directory.TensorDirectory dir, Qwen35moeConfig c, string name) → tensor_directory.DirectoryEntry ⇥ Qwen35moeTensorError {
    if name.starts_with("model.layers.") {
        parse_layer_index(name, "model.layers.", c.block_count)
    }
    elif name.starts_with("blk.") {
        parse_layer_index(name, "blk.", c.block_count)
    }

    do {
        return tensor_directory.lookup_backbone(dir, name)
    }
    catch err {
        if not name.contains(".weight") {
            do {
                return tensor_directory.lookup_backbone(dir, "§.weight"(name))
            }
            catch err2 {
                throw variant DivergentName { name = name }
            }
        }
        throw variant DivergentName { name = name }
    }
}

fn dir_require_any(tensor_directory.TensorDirectory dir, list<string> candidates) → tensor_directory.DirectoryEntry ⇥ Qwen35moeTensorError {
    for from candidates let cand {
        do {
            return tensor_directory.lookup_backbone(dir, cand)
        }
        catch err {
            pass
        }
    }

    let string first ← candidates.length() ≻ 0 ✓ candidates[0] ✗ ""
    throw variant DivergentName { name = first }
}

fn tally_storage(mut QwenTensorSummary s, tensor_directory.DirectoryEntry e) {
    switch e.raw_dtype {
        case "F32" {
            s.storage_f32 ↑
        }
        case "Q8_0" {
            s.storage_q8_0 ↑
        }
        case "Q4_K" {
            s.storage_q4_k ↑
        }
        case "Q5_K" {
            s.storage_q5_k ↑
        }
        case "Q6_K" {
            s.storage_q6_k ↑
        }
        case "BF16" {
            s.storage_bf16 ↑
        }
        case "Q5_0" {
            s.storage_q5_0 ↑
        }
        case "Q4_1" {
            s.storage_q4_1 ↑
        }
        case "IQ4_NL" {
            s.storage_iq4_nl ↑
        }
        case "F16" {
            s.storage_f16 ↑
        }
        case "U32" {
            s.storage_u32 ↑
        }
        case "U8" {
            s.storage_u8 ↑
        }
        case "F8_E4M3" {
            s.storage_f8_e4m3 ↑
        }
        case "FP8_E4M3" {
            s.storage_f8_e4m3 ↑
        }
        default {
            pass
        }
    }

    if e.shape.length() ≥ 3 {
        s.expert_rank3 ↑
    }
}

@ public
fn admit_in_directory(Qwen35moeConfig c, tensor_directory.TensorDirectory dir) → QwenTensorSummary ⇥ Qwen35moeTensorError {
    require c.block_count ≥ 1 throw variant Qwen35moeTensorError.DivergentCount { message = "block_count must be positive" }
    require c.nextn_predict_layers ≥ 0 and c.nextn_predict_layers ≺ c.block_count throw variant Qwen35moeTensorError.DivergentCount { message = "nextn_predict_layers out of range" }
    require c.full_attention_interval ≥ 1 throw variant Qwen35moeTensorError.DivergentCount { message = "full_attention_interval must be positive" }

    let int trunk_blocks ← c.block_count - c.nextn_predict_layers
    mut QwenTensorSummary summary ← QwenTensorSummary { total = 0, globals = 0, hybrid = 0, full_attention = 0, nextn = 0, storage_f32 = 0, storage_q8_0 = 0, storage_q4_k = 0, storage_q5_k = 0, storage_q6_k = 0, storage_bf16 = 0, expert_rank3 = 0 }

    dir_require_any(dir, ["model.embed_tokens.weight", "token_embd.weight"])
    summary.globals ↑
    dir_require_any(dir, ["model.norm.weight", "output_norm.weight"])
    summary.globals ↑
    if tensor_directory.has_tensor(dir, variant bundle.MemberRole.Backbone, "lm_head.weight") or tensor_directory.has_tensor(dir, variant bundle.MemberRole.Backbone, "output.weight") {
        summary.globals ↑
    }

    for range 0 ‥ c.block_count let b {
        let string bs ← b ↦ string
        if b ≥ trunk_blocks {
            dir_require_any(dir, ["model.layers.§.input_layernorm.weight"(bs), "blk.§.attn_norm.weight"(bs), "blk.§.nextn.enorm.weight"(bs)])
            summary.nextn ↑
        }
        elif (b + 1) % c.full_attention_interval ≡ 0 {
            dir_require_any(dir, ["model.layers.§.input_layernorm.weight"(bs), "blk.§.attn_norm.weight"(bs)])
            dir_require_any(dir, ["model.layers.§.self_attn.q_proj.weight"(bs), "blk.§.attn_q.weight"(bs)])
            dir_require_any(dir, ["model.layers.§.post_attention_layernorm.weight"(bs), "blk.§.ffn_norm.weight"(bs), "blk.§.post_attention_norm.weight"(bs)])
            summary.full_attention ↑
        }
        else {
            dir_require_any(dir, ["model.layers.§.input_layernorm.weight"(bs), "blk.§.attn_norm.weight"(bs)])
            dir_require_any(dir, ["model.layers.§.linear_attn.in_proj_qkv.weight"(bs), "model.layers.§.linear_attn.in_proj.weight"(bs), "blk.§.attn_qkv.weight"(bs)])
            dir_require_any(dir, ["model.layers.§.post_attention_layernorm.weight"(bs), "blk.§.ffn_norm.weight"(bs), "blk.§.post_attention_norm.weight"(bs)])
            summary.hybrid ↑
        }
    }

    let list<tensor_directory.DirectoryEntry> bb_entries ← tensor_directory.entries_for_role(dir, variant bundle.MemberRole.Backbone)
    summary.total ← bb_entries.length()
    for from bb_entries let e {
        tally_storage(mut summary, e)
    }

    return summary
}

+++ faber test
# MODEL-01-M3 qwen35moe configuration genus and metadata freeze (MODEL-01
# chain). Pins the frozen configuration rows from the delivery authority:
# every frozen value freezes through `freeze` and the 55-entry metadata
# count is enforced; mutation family 1 (frozen qwen35moe/general/tokenizer
# identity value changed, required key missing, extra unknown qwen35moe.*
# key, metadata count divergence) fails with a typed first-divergence
# diagnostic naming the key. Tokenizer facts are frozen as identity only.

import from "gradus:model/artifact" artifact

import from "gradus:model/bundle"
import from "gradus:model/config" let cfg
import from "gradus:model/gguf_manifest"
import from "gradus:model/tensor_directory" let tensor_directory
import from "gradus:storage" let storage

import from "gradus:model/qwen35moe" qwen35moe

const string F_DIGEST = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const int TOKENS_PIN = 248320

const int MERGES_PIN = 247587

fn u8(int n) → list<u8> {
    return [(n % 256) ∷ u8]
}

fn u32(int n) → list<u8> {
    return [(n % 256) ∷ u8, ((n ⇒ 8) % 256) ∷ u8, ((n ⇒ 16) % 256) ∷ u8, ((n ⇒ 24) % 256) ∷ u8]
}

fn u64(int n) → list<u8> {
    return [(n % 256) ∷ u8, ((n ⇒ 8) % 256) ∷ u8, ((n ⇒ 16) % 256) ∷ u8, ((n ⇒ 24) % 256) ∷ u8, ((n ⇒ 32) % 256) ∷ u8, ((n ⇒ 40) % 256) ∷ u8, ((n ⇒ 48) % 256) ∷ u8, ((n ⇒ 56) % 256) ∷ u8]
}

fn join(list<u8> a, list<u8> b) → list<u8> {
    mut list<u8> out ← empty
    for from a let x {
        out.append(x)
    }
    for from b let x {
        out.append(x)
    }
    return out
}

