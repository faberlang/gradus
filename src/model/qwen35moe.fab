+++
locale = "en"
+++
# qwen35moe typed configuration genus and metadata freeze (MODEL-01-M3).
#
# Public import: import from "gradus:model/qwen35moe" qwen35moe
# Depends on: gradus:model/gguf_manifest (typed metadata accessors).
#
# `freeze` freezes the frozen qwen35moe configuration rows from a parsed
# GGUF manifest — every row of the Frozen Architecture Configuration table in
# the MODEL-01 delivery (architecture/quantization, block/embedding,
# attention, rope, expert, SSM, nextn, and the tokenizer identity facts) —
# and enforces the 55-entry metadata count. Mutation family 1 fails closed
# with a typed divergence diagnostic naming the first diverging key: any
# frozen value changed, a required key missing, or an extra unknown
# `qwen35moe.*` key that shadows a required fact. Tokenizer facts are frozen
# as identity only; tokenizer execution is GGUF-A2's unit.

import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" gguf_manifest

const int METADATA_PIN ← 55

const int GGUF_FLOAT32 ← 6

const int QWEN_PREFIX ← 10

@ public { }
class Qwen35moeConfig {
    string architecture
    int file_type
    int quantization_version
    int block_count
    int context_length
    int embedding_length
    int head_count
    int head_count_kv
    int key_length
    int value_length
    f32 rms_norm_epsilon
    f32 freq_base
    int rope_dimension_count
    list<int> rope_sections
    int expert_count
    int expert_used_count
    int expert_ffn_length
    int shared_ffn_length
    int conv_kernel
    int state_size
    int group_count
    int gradus_temporis
    int inner_size
    int full_attention_interval
    int nextn_predict_layers
    string tokenizer_model
    string tokenizer_pre
    int token_count
    int token_type_count
    int merge_count
    int eos_token_id
    int padding_token_id
    int bos_token_id
    bool add_bos_token
}

@ public { }
union Qwen35moeConfigError {
    DivergentMetadata {
        string key
    }
}

@ public { }
fn message(Qwen35moeConfigError e) → string {
    match e {
        case DivergentMetadata const key {
            return "qwen35moe metadata divergence at §"(key)
        }
    }
}

# -------------------------------------------------------------------------
# Required-key membership for the extra-unknown-key scan.
# -------------------------------------------------------------------------

@ private { }
fn _required_qwen_key(string key) → bool {
    if key ≡ "qwen35moe.block_count" then return true
    if key ≡ "qwen35moe.context_length" then return true
    if key ≡ "qwen35moe.embedding_length" then return true
    if key ≡ "qwen35moe.attention.head_count" then return true
    if key ≡ "qwen35moe.attention.head_count_kv" then return true
    if key ≡ "qwen35moe.attention.key_length" then return true
    if key ≡ "qwen35moe.attention.value_length" then return true
    if key ≡ "qwen35moe.attention.layer_norm_rms_epsilon" then return true
    if key ≡ "qwen35moe.rope.freq_base" then return true
    if key ≡ "qwen35moe.rope.dimension_count" then return true
    if key ≡ "qwen35moe.rope.dimension_sections" then return true
    if key ≡ "qwen35moe.expert_count" then return true
    if key ≡ "qwen35moe.expert_used_count" then return true
    if key ≡ "qwen35moe.expert_feed_forward_length" then return true
    if key ≡ "qwen35moe.expert_shared_feed_forward_length" then return true
    if key ≡ "qwen35moe.ssm.conv_kernel" then return true
    if key ≡ "qwen35moe.ssm.state_size" then return true
    if key ≡ "qwen35moe.ssm.group_count" then return true
    if key ≡ "qwen35moe.ssm.time_step_rank" then return true
    if key ≡ "qwen35moe.ssm.inner_size" then return true
    if key ≡ "qwen35moe.full_attention_interval" then return true
    if key ≡ "qwen35moe.nextn_predict_layers" then return true
    return false
}

# The first extra `qwen35moe.*` key outside the frozen set, or null.
@ private { }
fn _unknown_qwen_key(gguf_manifest.GgufManifest m) → string ∪ null {
    for from m.metadata const meta {
        if (meta.key.length() ≥ QWEN_PREFIX and meta.key.slice(0, QWEN_PREFIX) ≡ "qwen35moe.") and not _required_qwen_key(meta.key) then return meta.key
    }
    return null
}

# -------------------------------------------------------------------------
# Byte and float32-wire helpers (value arithmetic, the dequant seam).
# -------------------------------------------------------------------------

@ private { }
fn _byte_list(bytes o) → list<int<u8>> {
    const value wire ← o ↦ value
    const list<int> numbers ← wire ↦ list<int>
    var list<int<u8>> out ← empty
    for from numbers const v {
        out.append(v ∷ int<u8>)
    }
    return out
}

@ private { }
fn _byte(list<int<u8>> b, int off) → int {
    return b.get(off) coalesce 0 ∷ int<u8> ↦ int
}

@ private { }
fn _power_two(int n) → float {
    var float result ← 1.0
    if n ≥ 0 {
        for range 0‥n const i {
            result ← result * 2.0
        }
    }
    else {
        for range n‥0 const i {
            result ← result / 2.0
        }
    }
    return result
}

# 4 little-endian bytes -> exact f32 VALUE (IEEE-754 binary32 decode, the
# dequant `_f32le` seam). Infinity or a NaN payload decodes to a value that
# can never equal either frozen float fact, so the freeze comparison fails
# closed without a special NaN branch.
@ private { }
fn _f32_le(list<int<u8>> b, int off) → f32 {
    const int b0 ← _byte(b, off)
    const int b1 ← _byte(b, off + 1)
    const int b2 ← _byte(b, off + 2)
    const int b3 ← _byte(b, off + 3)
    const int raw ← ((b3 * 16777216 + b2 * 65536) + b1 * 256) + b0
    const int sign ← (raw ⇒ 31) % 2
    const int exp ← (raw ⇒ 23) % 256
    const int frac ← raw % 8388608
    var float sign_factor ← 1.0
    if sign ≠ 0 {
        sign_factor ← -1.0
    }
    const float frac_ratio ← (frac ↦ float) / 8388608.0
    if exp ≡ 0 {
        if frac ≡ 0 then return sign_factor * 0.0 ↦ f32
        const float power ← _power_two(-126)
        return (sign_factor * power) * frac_ratio ↦ f32
    }
    const float power ← _power_two(exp - 127)
    return (sign_factor * power) * (1.0 + frac_ratio) ↦ f32
}

# -------------------------------------------------------------------------
# Typed read-and-pin accessors. Every accessor maps a missing or malformed
# key to a divergence diagnostic naming that key, then compares the read
# value against the frozen expectation. First divergence wins.
# -------------------------------------------------------------------------

@ private { }
fn _require_metadata(gguf_manifest.GgufManifest m, string key) → gguf_manifest.GgufMetadata ⇥ Qwen35moeConfigError {
    do {
        return gguf_manifest.metadata(m, key)
    }
    catch err {
        throw variant DivergentMetadata {key = key}
    }
}

@ private { }
fn _require_number(gguf_manifest.GgufManifest m, string key, int expected) → int ⇥ Qwen35moeConfigError {
    var int observed ← 0
    do {
        observed ← gguf_manifest.number(m, key)
    }
    catch err {
        throw variant DivergentMetadata {key = key}
    }
    require observed ≡ expected throw variant DivergentMetadata {key = key}
    return observed
}

@ private { }
fn _require_text(gguf_manifest.GgufManifest m, string key, string expected) → string ⇥ Qwen35moeConfigError {
    var string observed ← ""
    do {
        observed ← gguf_manifest.text(m, key)
    }
    catch err {
        throw variant DivergentMetadata {key = key}
    }
    require observed ≡ expected throw variant DivergentMetadata {key = key}
    return observed
}

@ private { }
fn _require_bool(gguf_manifest.GgufManifest m, string key, bool expected) → bool ⇥ Qwen35moeConfigError {
    var bool observed ← false
    do {
        observed ← gguf_manifest.boolean(m, key)
    }
    catch err {
        throw variant DivergentMetadata {key = key}
    }
    require observed ≡ expected throw variant DivergentMetadata {key = key}
    return observed
}

@ private { }
fn _require_length(gguf_manifest.GgufManifest m, string key, int expected) → int ⇥ Qwen35moeConfigError {
    var int observed ← 0
    do {
        observed ← gguf_manifest.list_length(m, key)
    }
    catch err {
        throw variant DivergentMetadata {key = key}
    }
    require observed ≡ expected throw variant DivergentMetadata {key = key}
    return observed
}

@ private { }
fn _require_f32(gguf_manifest.GgufManifest m, string key, f32 expected) → f32 ⇥ Qwen35moeConfigError {
    const gguf_manifest.GgufMetadata meta ← _require_metadata(m, key)
    require meta.dtype ≡ GGUF_FLOAT32 throw variant DivergentMetadata {key = key}
    const f32 observed ← _f32_le(_byte_list(meta.payload_wire), 0)
    require observed ≡ expected throw variant DivergentMetadata {key = key}
    return observed
}

@ private { }
fn _require_sections(gguf_manifest.GgufManifest m, string key) → list<int> ⇥ Qwen35moeConfigError {
    var list<int> observed ← empty
    do {
        observed ← gguf_manifest.numbers(m, key)
    }
    catch err {
        throw variant DivergentMetadata {key = key}
    }
    require observed.length() ≡ 4 throw variant DivergentMetadata {key = key}
    require observed.get(0) coalesce 0 ≡ 11 throw variant DivergentMetadata {key = key}
    require observed.get(1) coalesce 0 ≡ 11 throw variant DivergentMetadata {key = key}
    require observed.get(2) coalesce 0 ≡ 10 throw variant DivergentMetadata {key = key}
    require observed.get(3) coalesce 0 ≡ 0 throw variant DivergentMetadata {key = key}
    return observed
}

# Freeze the frozen qwen35moe configuration. Reads are in the delivery table
# order, so the first diverging fact is deterministic.
@ public { }
fn freeze(gguf_manifest.GgufManifest m) → Qwen35moeConfig ⇥ Qwen35moeConfigError {
    const string architecture ← _require_text(m, "general.architecture", "qwen35moe")
    const int file_type ← _require_number(m, "general.file_type", 15)
    const int quantization_version ← _require_number(m, "general.quantization_version", 2)
    const int block_count ← _require_number(m, "qwen35moe.block_count", 41)
    const int context_length ← _require_number(m, "qwen35moe.context_length", 262144)
    const int embedding_length ← _require_number(m, "qwen35moe.embedding_length", 2048)
    const int head_count ← _require_number(m, "qwen35moe.attention.head_count", 16)
    const int head_count_kv ← _require_number(m, "qwen35moe.attention.head_count_kv", 2)
    const int key_length ← _require_number(m, "qwen35moe.attention.key_length", 256)
    const int value_length ← _require_number(m, "qwen35moe.attention.value_length", 256)
    const f32 rms_norm_epsilon ← _require_f32(m, "qwen35moe.attention.layer_norm_rms_epsilon", 0.0000009999999974752427 ∷ f32)
    const f32 freq_base ← _require_f32(m, "qwen35moe.rope.freq_base", 10000000.0 ∷ f32)
    const int rope_dimension_count ← _require_number(m, "qwen35moe.rope.dimension_count", 64)
    const list<int> rope_sections ← _require_sections(m, "qwen35moe.rope.dimension_sections")
    const int expert_count ← _require_number(m, "qwen35moe.expert_count", 256)
    const int expert_used_count ← _require_number(m, "qwen35moe.expert_used_count", 8)
    const int expert_ffn_length ← _require_number(m, "qwen35moe.expert_feed_forward_length", 512)
    const int shared_ffn_length ← _require_number(m, "qwen35moe.expert_shared_feed_forward_length", 512)
    const int conv_kernel ← _require_number(m, "qwen35moe.ssm.conv_kernel", 4)
    const int state_size ← _require_number(m, "qwen35moe.ssm.state_size", 128)
    const int group_count ← _require_number(m, "qwen35moe.ssm.group_count", 16)
    const int gradus_temporis ← _require_number(m, "qwen35moe.ssm.time_step_rank", 32)
    const int inner_size ← _require_number(m, "qwen35moe.ssm.inner_size", 4096)
    const int full_attention_interval ← _require_number(m, "qwen35moe.full_attention_interval", 4)
    const int nextn_predict_layers ← _require_number(m, "qwen35moe.nextn_predict_layers", 1)
    const string tokenizer_model ← _require_text(m, "tokenizer.ggml.model", "gpt2")
    const string tokenizer_pre ← _require_text(m, "tokenizer.ggml.pre", "qwen35")
    const int token_count ← _require_length(m, "tokenizer.ggml.tokens", 248320)
    const int token_type_count ← _require_length(m, "tokenizer.ggml.token_type", 248320)
    const int merge_count ← _require_length(m, "tokenizer.ggml.merges", 247587)
    const int eos_token_id ← _require_number(m, "tokenizer.ggml.eos_token_id", 248046)
    const int padding_token_id ← _require_number(m, "tokenizer.ggml.padding_token_id", 248055)
    const int bos_token_id ← _require_number(m, "tokenizer.ggml.bos_token_id", 248044)
    const bool add_bos_token ← _require_bool(m, "tokenizer.ggml.add_bos_token", false)
    const string ∪ null unknown ← _unknown_qwen_key(m)
    require not (unknown not is null) throw variant DivergentMetadata {key = unknown coalesce ""}
    require m.metadata.length() ≡ METADATA_PIN throw variant DivergentMetadata {key = "metadata count"}
    return Qwen35moeConfig {architecture = architecture, file_type = file_type, quantization_version = quantization_version, block_count = block_count, context_length = context_length, embedding_length = embedding_length, head_count = head_count, head_count_kv = head_count_kv, key_length = key_length, value_length = value_length, rms_norm_epsilon = rms_norm_epsilon, freq_base = freq_base, rope_dimension_count = rope_dimension_count, rope_sections = rope_sections, expert_count = expert_count, expert_used_count = expert_used_count, expert_ffn_length = expert_ffn_length, shared_ffn_length = shared_ffn_length, conv_kernel = conv_kernel, state_size = state_size, group_count = group_count, gradus_temporis = gradus_temporis, inner_size = inner_size, full_attention_interval = full_attention_interval, nextn_predict_layers = nextn_predict_layers, tokenizer_model = tokenizer_model, tokenizer_pre = tokenizer_pre, token_count = token_count, token_type_count = token_type_count, merge_count = merge_count, eos_token_id = eos_token_id, padding_token_id = padding_token_id, bos_token_id = bos_token_id, add_bos_token = add_bos_token}
}

# -------------------------------------------------------------------------
# MODEL-01-M4: canonical 753-tensor map + 41-block schedule.
#
# `canonical_tensors` admits the four exact family sets from the Canonical
# 753-Tensor Map in the MODEL-01 delivery: global 3 (output.weight /
# output_norm.weight / token_embd.weight), hybrid 19x30, full-attention
# 16x10, and the nextn 20 on blk.40 — every tensor's exact stored shape and
# storage row. The schedule is structural: 41 block indices 0..40, full
# attention at index ≡ 3 mod 4, blk.40 the sole nextn block
# (`nextn_predict_layers` = 1). Anomalies are preserved per-tensor, never
# collapsed to one global storage row: blk.40's ffn_gate_inp.weight and
# ffn_gate_inp_shexp.weight are bf16 (f32 in every other block), and
# ffn_down_exps.weight is q6_K in blk.34/38/39 (q5_K elsewhere). Block-40
# nextn/MTP rule (frozen): the 20 blk.40 tensors are admitted for map
# completeness; the main forward layer schedule is blocks 0..39 and the
# admission claims no nextn/MTP execution semantics — those belong to
# GGUF-M2/M3/M4. Count invariants: 753 tensors total, 55 metadata entries,
# and the derived block-family and storage-distribution counts. Mutation
# families 2 (name), 3 (shape), 4 (storage), and 5 (count) fail closed with
# a typed first-divergence diagnostic naming the first diverging fact.
#
# GGML raw type ids (only the six canonical storage rows are admitted).
const int GGML_F32 ← 0

const int GGML_Q8_0 ← 8

const int GGML_Q4_K ← 12

const int GGML_Q5_K ← 13

const int GGML_Q6_K ← 14

const int GGML_BF16 ← 30

const int TENSOR_PIN ← 753

const int BLOCK_PIN ← 41

@ public { }
union Qwen35moeTensorError {
    DivergentName {
        string name
    },
    DivergentShape {
        string name
    },
    DivergentStorage {
        string name
    },
    DivergentCount {
        string message
    }
}

@ public { }
fn tensor_message(Qwen35moeTensorError e) → string {
    match e {
        case DivergentName const name {
            return "qwen35moe tensor name divergence at §"(name)
        }
        case DivergentShape const name {
            return "qwen35moe tensor shape divergence at §"(name)
        }
        case DivergentStorage const name {
            return "qwen35moe tensor storage divergence at §"(name)
        }
        case Qwen35moeTensorError.DivergentCount const message {
            return "qwen35moe tensor count divergence: §"(message)
        }
    }
}

# Derived admission receipt: block-family and storage-distribution counts.

@ public { }
class QwenTensorSummary {
    int total
    int globals
    int hybrid
    int full_attention
    int nextn
    int storage_f32
    int storage_q8_0
    int storage_q4_k
    int storage_q5_k
    int storage_q6_k
    int storage_bf16
    int expert_rank3
}

# One canonical expectation row (module-internal carrier).
class QwenCanonicalTensor {
    string name
    list<int> shape
    int dtype_ggml
}

# Block class: 0 = hybrid SSM/attention, 1 = full-attention (index ≡ 3 mod
# 4), 2 = the sole nextn block blk.40.
@ private { }
fn _block_class(int b) → int {
    if b ≡ 40 then return 2
    if b % 4 ≡ 3 then return 1
    return 0
}

@ private { }
fn _global_tensors() → list<QwenCanonicalTensor> {
    var list<QwenCanonicalTensor> out ← empty
    out.append(QwenCanonicalTensor {name = "output.weight", shape = [2048, 248320], dtype_ggml = GGML_Q6_K})
    out.append(QwenCanonicalTensor {name = "output_norm.weight", shape = [2048], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = "token_embd.weight", shape = [2048, 248320], dtype_ggml = GGML_Q8_0})
    return out
}

# Hybrid SSM/attention block set (19); ffn_down_exps is q6_K in blk.34/38.
@ private { }
fn _hybrid_tensors(int b) → list<QwenCanonicalTensor> {
    const string p ← "blk.§"(b ↦ string)
    var int down_kind ← GGML_Q5_K
    if b ≡ 34 or b ≡ 38 {
        down_kind ← GGML_Q6_K
    }
    var list<QwenCanonicalTensor> out ← empty
    out.append(QwenCanonicalTensor {name = p + ".attn_gate.weight", shape = [2048, 4096], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".attn_norm.weight", shape = [2048], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".attn_qkv.weight", shape = [2048, 8192], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".ffn_down_exps.weight", shape = [512, 2048, 256], dtype_ggml = down_kind})
    out.append(QwenCanonicalTensor {name = p + ".ffn_down_shexp.weight", shape = [512, 2048], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".ffn_gate_exps.weight", shape = [2048, 512, 256], dtype_ggml = GGML_Q4_K})
    out.append(QwenCanonicalTensor {name = p + ".ffn_gate_inp.weight", shape = [2048, 256], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".ffn_gate_inp_shexp.weight", shape = [2048], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".ffn_gate_shexp.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".ffn_up_exps.weight", shape = [2048, 512, 256], dtype_ggml = GGML_Q4_K})
    out.append(QwenCanonicalTensor {name = p + ".ffn_up_shexp.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".post_attention_norm.weight", shape = [2048], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".ssm_a", shape = [32], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".ssm_alpha.weight", shape = [2048, 32], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".ssm_beta.weight", shape = [2048, 32], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".ssm_conv1d.weight", shape = [4, 8192], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".ssm_dt.bias", shape = [32], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".ssm_norm.weight", shape = [128], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".ssm_out.weight", shape = [4096, 2048], dtype_ggml = GGML_Q8_0})
    return out
}

# Full-attention block set (16); ffn_down_exps is q6_K in blk.39.
@ private { }
fn _dense_tensors(int b) → list<QwenCanonicalTensor> {
    const string p ← "blk.§"(b ↦ string)
    var int down_kind ← GGML_Q5_K
    if b ≡ 39 {
        down_kind ← GGML_Q6_K
    }
    var list<QwenCanonicalTensor> out ← empty
    out.append(QwenCanonicalTensor {name = p + ".attn_k.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".attn_k_norm.weight", shape = [256], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".attn_norm.weight", shape = [2048], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".attn_output.weight", shape = [4096, 2048], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".attn_q.weight", shape = [2048, 8192], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".attn_q_norm.weight", shape = [256], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".attn_v.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".ffn_down_exps.weight", shape = [512, 2048, 256], dtype_ggml = down_kind})
    out.append(QwenCanonicalTensor {name = p + ".ffn_down_shexp.weight", shape = [512, 2048], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".ffn_gate_exps.weight", shape = [2048, 512, 256], dtype_ggml = GGML_Q4_K})
    out.append(QwenCanonicalTensor {name = p + ".ffn_gate_inp.weight", shape = [2048, 256], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".ffn_gate_inp_shexp.weight", shape = [2048], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".ffn_gate_shexp.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".ffn_up_exps.weight", shape = [2048, 512, 256], dtype_ggml = GGML_Q4_K})
    out.append(QwenCanonicalTensor {name = p + ".ffn_up_shexp.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".post_attention_norm.weight", shape = [2048], dtype_ggml = GGML_F32})
    return out
}

# Nextn block blk.40 set (20): the full-attention 16 with the frozen bf16
# anomaly on ffn_gate_inp / ffn_gate_inp_shexp, plus the four nextn.*
# tensors. ffn_down_exps stays q5_K (blk.40 is not in the q6_K anomaly set).
@ private { }
fn _nextn_tensors() → list<QwenCanonicalTensor> {
    const string p ← "blk.40"
    var list<QwenCanonicalTensor> out ← empty
    out.append(QwenCanonicalTensor {name = p + ".attn_k.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".attn_k_norm.weight", shape = [256], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".attn_norm.weight", shape = [2048], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".attn_output.weight", shape = [4096, 2048], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".attn_q.weight", shape = [2048, 8192], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".attn_q_norm.weight", shape = [256], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".attn_v.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".ffn_down_exps.weight", shape = [512, 2048, 256], dtype_ggml = GGML_Q5_K})
    out.append(QwenCanonicalTensor {name = p + ".ffn_down_shexp.weight", shape = [512, 2048], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".ffn_gate_exps.weight", shape = [2048, 512, 256], dtype_ggml = GGML_Q4_K})
    out.append(QwenCanonicalTensor {name = p + ".ffn_gate_inp.weight", shape = [2048, 256], dtype_ggml = GGML_BF16})
    out.append(QwenCanonicalTensor {name = p + ".ffn_gate_inp_shexp.weight", shape = [2048], dtype_ggml = GGML_BF16})
    out.append(QwenCanonicalTensor {name = p + ".ffn_gate_shexp.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".ffn_up_exps.weight", shape = [2048, 512, 256], dtype_ggml = GGML_Q4_K})
    out.append(QwenCanonicalTensor {name = p + ".ffn_up_shexp.weight", shape = [2048, 512], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".post_attention_norm.weight", shape = [2048], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".nextn.eh_proj.weight", shape = [4096, 2048], dtype_ggml = GGML_Q8_0})
    out.append(QwenCanonicalTensor {name = p + ".nextn.enorm.weight", shape = [2048], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".nextn.hnorm.weight", shape = [2048], dtype_ggml = GGML_F32})
    out.append(QwenCanonicalTensor {name = p + ".nextn.shared_head_norm.weight", shape = [2048], dtype_ggml = GGML_F32})
    return out
}

@ private { }
fn _canonical_block(int b) → list<QwenCanonicalTensor> {
    if b ≡ 40 then return _nextn_tensors()
    if b % 4 ≡ 3 then return _dense_tensors(b)
    return _hybrid_tensors(b)
}

# Locate one canonical tensor in the manifest; a missing name is the family-2
# divergence (the manifest's own duplicate-name rejection runs at parse time).
@ private { }
fn _find(gguf_manifest.GgufManifest m, string name) → gguf_manifest.GgufTensorDescriptor ⇥ Qwen35moeTensorError {
    do {
        return gguf_manifest.find_tensor(m, name)
    }
    catch err {
        throw variant DivergentName {name = name}
    }
}

# Name -> shape -> storage check order makes the first diverging fact
# deterministic per canonical entry.
@ private { }
fn _require(gguf_manifest.GgufManifest m, QwenCanonicalTensor c) → bool ⇥ Qwen35moeTensorError {
    const gguf_manifest.GgufTensorDescriptor tensor ← _find(m, c.name)
    require tensor.shape.length() ≡ c.shape.length() throw variant DivergentShape {name = c.name}
    for range 0‥c.shape.length() const i {
        require tensor.shape.get(i) coalesce 0 ≡ c.shape.get(i) coalesce 0 throw variant DivergentShape {name = c.name}
    }
    require tensor.dtype_ggml ≡ c.dtype_ggml throw variant DivergentStorage {name = c.name}
    return true
}

# Admit the canonical map: count invariants fail closed first (family 5),
# then every canonical tensor is matched name/shape/storage in canonical
# order (families 2-4). The receipt counts are derived, so the schedule and
# storage distribution are proven from the admitted tensors themselves.
@ public { }
fn canonical_tensors(gguf_manifest.GgufManifest m) → QwenTensorSummary ⇥ Qwen35moeTensorError {
    require m.tensors.length() ≡ TENSOR_PIN throw variant Qwen35moeTensorError.DivergentCount {message = "tensor count § ≠ §"(m.tensors.length() ↦ string, TENSOR_PIN ↦ string)}
    require m.metadata.length() ≡ METADATA_PIN throw variant Qwen35moeTensorError.DivergentCount {message = "metadata count § ≠ §"(m.metadata.length() ↦ string, METADATA_PIN ↦ string)}
    var int n_global ← 0
    var int n_hybrid ← 0
    var int n_full_attention ← 0
    var int n_nextn ← 0
    var int n_f32 ← 0
    var int n_q8_0 ← 0
    var int n_q4_k ← 0
    var int n_q5_k ← 0
    var int n_q6_k ← 0
    var int n_bf16 ← 0
    var int n_rank3 ← 0
    const list<QwenCanonicalTensor> globals ← _global_tensors()
    for from globals const c {
        _require(m, c)
        n_global ↑
        if c.dtype_ggml ≡ GGML_F32 {
            n_f32 ↑
        }
        if c.dtype_ggml ≡ GGML_Q8_0 {
            n_q8_0 ↑
        }
        if c.dtype_ggml ≡ GGML_Q6_K {
            n_q6_k ↑
        }
    }
    var int b ← 0
    while b ≺ BLOCK_PIN {
        const list<QwenCanonicalTensor> canon ← _canonical_block(b)
        const int block_class ← _block_class(b)
        for from canon const c {
            _require(m, c)
            if block_class ≡ 0 {
                n_hybrid ↑
            }
            if block_class ≡ 1 {
                n_full_attention ↑
            }
            if block_class ≡ 2 {
                n_nextn ↑
            }
            if c.dtype_ggml ≡ GGML_F32 {
                n_f32 ↑
            }
            if c.dtype_ggml ≡ GGML_Q8_0 {
                n_q8_0 ↑
            }
            if c.dtype_ggml ≡ GGML_Q4_K {
                n_q4_k ↑
            }
            if c.dtype_ggml ≡ GGML_Q5_K {
                n_q5_k ↑
            }
            if c.dtype_ggml ≡ GGML_Q6_K {
                n_q6_k ↑
            }
            if c.dtype_ggml ≡ GGML_BF16 {
                n_bf16 ↑
            }
            if c.shape.length() ≡ 3 {
                n_rank3 ↑
            }
        }
        b ↑
    }
    return QwenTensorSummary {total = TENSOR_PIN, globals = n_global, hybrid = n_hybrid, full_attention = n_full_attention, nextn = n_nextn, storage_f32 = n_f32, storage_q8_0 = n_q8_0, storage_q4_k = n_q4_k, storage_q5_k = n_q5_k, storage_q6_k = n_q6_k, storage_bf16 = n_bf16, expert_rank3 = n_rank3}
}

# -------------------------------------------------------------------------
# MODEL-01-M5: dimension/storage cross-reference validation.
#
# `reference` cross-references the frozen configuration (M3) against the
# manifest tensors, deriving every expected dim from the config so a
# config/tensor pair that is individually frozen can still diverge:
# `embedding_length` at its stored-dim positions per family,
# `expert_count` as rank-3 dim 2 of the three `*_exps` tensors and dim 1 of
# `ffn_gate_inp`, `expert_feed_forward_length` at the down/gate-up
# positions, the ssm dims (`state_size` / `time_step_rank` / `conv_kernel`
# / `inner_size`), `head_count_kv` × `key_length` = dim 1 of
# `attn_k`/`attn_v` (norms carry 256), block-schedule consistency, element
# counts = product of stored dims, and the GGUF-A1a/A1b absolute range
# bound. The first diverging cross-fact fails with a typed diagnostic
# naming that tensor.
# -------------------------------------------------------------------------


@ public { }
union Qwen35moeReferenceError {
    UnknownName {
        string name
    },
    DivergentDimension {
        string name
    },
    DivergentCount {
        string message
    },
    BadRange {
        string message
    }
}

@ public { }
fn reference_message(Qwen35moeReferenceError e) → string {
    match e {
        case UnknownName const name {
            return "qwen35moe cross-reference name divergence at §"(name)
        }
        case DivergentDimension const name {
            return "qwen35moe cross-reference dimension divergence at §"(name)
        }
        case Qwen35moeReferenceError.DivergentCount const message {
            return "qwen35moe cross-reference count divergence: §"(message)
        }
        case BadRange const message {
            return "qwen35moe cross-reference range divergence: §"(message)
        }
    }
}

@ private { }
fn _find_reference(gguf_manifest.GgufManifest m, string name) → gguf_manifest.GgufTensorDescriptor ⇥ Qwen35moeReferenceError {
    do {
        return gguf_manifest.find_tensor(m, name)
    }
    catch err {
        throw variant UnknownName {name = name}
    }
}

# Check one stored-dim position (GGUF file order); a rank below the index
# is itself the diverging fact.
@ private { }
fn _reference_dim(gguf_manifest.GgufManifest m, string name, int index, int expected) → bool ⇥ Qwen35moeReferenceError {
    const gguf_manifest.GgufTensorDescriptor t ← _find_reference(m, name)
    require t.shape.length() ≻ index throw variant DivergentDimension {name = name}
    require t.shape.get(index) coalesce 0 ≡ expected throw variant DivergentDimension {name = name}
    return true
}

@ private { }
fn _reference_rank(gguf_manifest.GgufManifest m, string name, int expected) → bool ⇥ Qwen35moeReferenceError {
    const gguf_manifest.GgufTensorDescriptor t ← _find_reference(m, name)
    require t.shape.length() ≡ expected throw variant DivergentDimension {name = name}
    return true
}

# Single stored dim of the rank-1 norm tensors.
@ private { }
fn _reference_one(gguf_manifest.GgufManifest m, string name, int expected) → bool ⇥ Qwen35moeReferenceError {
    _reference_rank(m, name, 1)
    _reference_dim(m, name, 0, expected)
    return true
}

# The expert family, shared by every block class. Down stores
# [ffn, embd, experts]; gate/up store [embd, ffn, experts]; `ffn_gate_inp`
# carries [embd, experts].
@ private { }
fn _reference_ffn(gguf_manifest.GgufManifest m, Qwen35moeConfig c, string p) → bool ⇥ Qwen35moeReferenceError {
    _reference_dim(m, p + ".ffn_down_exps.weight", 0, c.expert_ffn_length)
    _reference_dim(m, p + ".ffn_down_exps.weight", 1, c.embedding_length)
    _reference_dim(m, p + ".ffn_down_exps.weight", 2, c.expert_count)
    _reference_dim(m, p + ".ffn_down_shexp.weight", 0, c.expert_ffn_length)
    _reference_dim(m, p + ".ffn_down_shexp.weight", 1, c.embedding_length)
    _reference_dim(m, p + ".ffn_gate_exps.weight", 0, c.embedding_length)
    _reference_dim(m, p + ".ffn_gate_exps.weight", 1, c.expert_ffn_length)
    _reference_dim(m, p + ".ffn_gate_exps.weight", 2, c.expert_count)
    _reference_dim(m, p + ".ffn_gate_inp.weight", 0, c.embedding_length)
    _reference_dim(m, p + ".ffn_gate_inp.weight", 1, c.expert_count)
    _reference_one(m, p + ".ffn_gate_inp_shexp.weight", c.embedding_length)
    _reference_dim(m, p + ".ffn_gate_shexp.weight", 0, c.embedding_length)
    _reference_dim(m, p + ".ffn_gate_shexp.weight", 1, c.expert_ffn_length)
    _reference_dim(m, p + ".ffn_up_exps.weight", 0, c.embedding_length)
    _reference_dim(m, p + ".ffn_up_exps.weight", 1, c.expert_ffn_length)
    _reference_dim(m, p + ".ffn_up_exps.weight", 2, c.expert_count)
    _reference_dim(m, p + ".ffn_up_shexp.weight", 0, c.embedding_length)
    _reference_dim(m, p + ".ffn_up_shexp.weight", 1, c.expert_ffn_length)
    return true
}

# Hybrid SSM/attention block family (19 blocks, index ≢ 3 mod 4, ≠ 40).
@ private { }
fn _reference_hybrid(gguf_manifest.GgufManifest m, Qwen35moeConfig c, string p) → bool ⇥ Qwen35moeReferenceError {
    _reference_dim(m, p + ".attn_gate.weight", 0, c.embedding_length)
    _reference_dim(m, p + ".attn_gate.weight", 1, c.inner_size)
    _reference_one(m, p + ".attn_norm.weight", c.embedding_length)
    _reference_dim(m, p + ".attn_qkv.weight", 0, c.embedding_length)
    _reference_ffn(m, c, p)
    _reference_one(m, p + ".post_attention_norm.weight", c.embedding_length)
    _reference_one(m, p + ".ssm_a", c.gradus_temporis)
    _reference_dim(m, p + ".ssm_alpha.weight", 0, c.embedding_length)
    _reference_dim(m, p + ".ssm_alpha.weight", 1, c.gradus_temporis)
    _reference_dim(m, p + ".ssm_beta.weight", 0, c.embedding_length)
    _reference_dim(m, p + ".ssm_beta.weight", 1, c.gradus_temporis)
    _reference_dim(m, p + ".ssm_conv1d.weight", 0, c.conv_kernel)
    _reference_one(m, p + ".ssm_dt.bias", c.gradus_temporis)
    _reference_one(m, p + ".ssm_norm.weight", c.state_size)
    _reference_dim(m, p + ".ssm_out.weight", 0, c.inner_size)
    _reference_dim(m, p + ".ssm_out.weight", 1, c.embedding_length)
    return true
}

# Full-attention block family core (16 blocks, index ≡ 3 mod 4).
@ private { }
fn _reference_dense_core(gguf_manifest.GgufManifest m, Qwen35moeConfig c, string p) → bool ⇥ Qwen35moeReferenceError {
    const int kv_projection ← c.head_count_kv * c.key_length
    _reference_dim(m, p + ".attn_k.weight", 0, c.embedding_length)
    _reference_dim(m, p + ".attn_k.weight", 1, kv_projection)
    _reference_one(m, p + ".attn_k_norm.weight", c.key_length)
    _reference_one(m, p + ".attn_norm.weight", c.embedding_length)
    _reference_dim(m, p + ".attn_output.weight", 0, c.inner_size)
    _reference_dim(m, p + ".attn_output.weight", 1, c.embedding_length)
    _reference_dim(m, p + ".attn_q.weight", 0, c.embedding_length)
    _reference_one(m, p + ".attn_q_norm.weight", c.key_length)
    _reference_dim(m, p + ".attn_v.weight", 0, c.embedding_length)
    _reference_dim(m, p + ".attn_v.weight", 1, kv_projection)
    _reference_ffn(m, c, p)
    _reference_one(m, p + ".post_attention_norm.weight", c.embedding_length)
    return true
}

# Cross-reference the frozen config against the manifest. Block families
# run in schedule order so the first diverging cross-fact is deterministic.
@ public { }
fn reference(Qwen35moeConfig c, gguf_manifest.GgufManifest m) → bool ⇥ Qwen35moeReferenceError {
    _reference_dim(m, "output.weight", 0, c.embedding_length)
    _reference_one(m, "output_norm.weight", c.embedding_length)
    _reference_dim(m, "token_embd.weight", 0, c.embedding_length)
    var int n_full ← 0
    var int n_nextn ← 0
    var int b ← 0
    while b ≺ BLOCK_PIN {
        const string p ← "blk.§"(b ↦ string)
        if b ≡ 40 {
            _reference_dense_core(m, c, p)
            _reference_dim(m, p + ".nextn.eh_proj.weight", 0, c.inner_size)
            _reference_dim(m, p + ".nextn.eh_proj.weight", 1, c.embedding_length)
            _reference_one(m, p + ".nextn.enorm.weight", c.embedding_length)
            _reference_one(m, p + ".nextn.hnorm.weight", c.embedding_length)
            _reference_one(m, p + ".nextn.shared_head_norm.weight", c.embedding_length)
            n_nextn ↑
        }
        else {
            if b % 4 ≡ 3 {
                _reference_dense_core(m, c, p)
                n_full ↑
            }
            else {
                _reference_hybrid(m, c, p)
            }
        }
        b ↑
    }
    const int expected_full ← (BLOCK_PIN - 1) / c.full_attention_interval
    require n_full ≡ expected_full throw variant Qwen35moeReferenceError.DivergentCount {message = "full-attention blocks § ≠ §"(n_full ↦ string, expected_full ↦ string)}
    require n_nextn ≡ c.nextn_predict_layers throw variant Qwen35moeReferenceError.DivergentCount {message = "nextn blocks § ≠ §"(n_nextn ↦ string, c.nextn_predict_layers ↦ string)}
    for from m.tensors const t {
        var int product ← 1
        for from t.shape const d {
            product ← product * d
        }
        require t.elements ≡ product throw variant Qwen35moeReferenceError.DivergentCount {message = "element count of §"(t.name)}
        require m.data_start + t.relative_offset ≤ m.artifact_length throw variant BadRange {message = "§ range exceeds the artifact"(t.name)}
    }
    return true
}

# -------------------------------------------------------------------------
# MODEL-01-M6: admission entry point + identity precondition + typed
# refusal matrix.
#
# `admit` is the public admission entry on the module. It composes the
# identity precondition (family 6: byte length / SHA-256 divergence fails
# before any architecture read) -> config freeze (M3, family 1) ->
# canonical tensor map (M4, families 2-5) -> cross-reference validation
# (M5), and returns ADMIT with the frozen configuration + the 753-tensor
# receipt. Family 7 (unsupported-but-inspectable) refuses an unknown
# architecture name or raw GGML type: those stay inspectable as data per
# GGUF-A1a but cannot admit as qwen35moe. Every failure returns a typed
# first-divergence diagnostic naming the first diverging fact. Admission
# error variants carry the rendered diagnostic text; the module-level M3/M4/
# M5 typed enums (Qwen35moeConfigError / Qwen35moeTensorError /
# Qwen35moeReferenceError) stay public for direct callers of freeze /
# canonical_tensors / reference.
# -------------------------------------------------------------------------


@ public { }
class Qwen35moeAdmission {
    Qwen35moeConfig config
    QwenTensorSummary summary
}

@ public { }
union Qwen35moeAdmissionError {
    DivergentIdentity {
        string message
    },
    UnknownArchitecture {
        string message
    },
    UnknownType {
        string message
    },
    DivergentConfig {
        string message
    },
    DivergentTensors {
        string message
    },
    DivergentReference {
        string message
    },
    BadManifest {
        string message
    }
}

@ public { }
fn admission_message(Qwen35moeAdmissionError e) → string {
    match e {
        case DivergentIdentity const message {
            return message
        }
        case UnknownArchitecture const message {
            return message
        }
        case UnknownType const message {
            return message
        }
        case DivergentConfig const message {
            return message
        }
        case DivergentTensors const message {
            return message
        }
        case DivergentReference const message {
            return message
        }
        case BadManifest const message {
            return message
        }
    }
}

# Parse the corpus into the manifest, mapping manifest-level failures to
# the admission channel.
@ private { }
fn _parse_admission(gguf_manifest.GgufCorpus corpus) → gguf_manifest.GgufManifest ⇥ Qwen35moeAdmissionError {
    do {
        return gguf_manifest.parse(corpus)
    }
    catch err {
        throw variant BadManifest {message = gguf_manifest.message(err)}
    }
}

# Read `general.architecture` as data; a missing or unreadable key falls
# through to the config freeze, which reports it as a family-1 metadata
# divergence at that key.
@ private { }
fn _read_architecture(gguf_manifest.GgufManifest m) → string ∪ null {
    do {
        return gguf_manifest.text(m, "general.architecture")
    }
    catch err {
        return null
    }
}

# First tensor with an unknown raw GGML type (Unknown layout), or null.
@ private { }
fn _first_unknown_dtype(gguf_manifest.GgufManifest m) → string ∪ null {
    for from m.tensors const t {
        match t.layout {
            case gguf_manifest.Unknown const kind {
                return t.name
            }
            case gguf_manifest.Known const elements_per_block, bytes_per_block, byte_length {
            }
        }
    }
    return null
}

# Config freeze with the family-1 channel rendered into the admission channel.
@ private { }
fn _freeze_admission(gguf_manifest.GgufManifest m) → Qwen35moeConfig ⇥ Qwen35moeAdmissionError {
    do {
        return freeze(m)
    }
    catch err {
        throw variant DivergentConfig {message = message(err)}
    }
}

# Canonical tensor map with the families-2-5 channel rendered in.
@ private { }
fn _admit_tensors(gguf_manifest.GgufManifest m) → QwenTensorSummary ⇥ Qwen35moeAdmissionError {
    do {
        return canonical_tensors(m)
    }
    catch err {
        throw variant DivergentTensors {message = tensor_message(err)}
    }
}

# Cross-reference validation with the M5 channel rendered in.
@ private { }
fn _admit_references(Qwen35moeConfig c, gguf_manifest.GgufManifest m) → bool ⇥ Qwen35moeAdmissionError {
    do {
        return reference(c, m)
    }
    catch err {
        throw variant DivergentReference {message = reference_message(err)}
    }
}

@ public { }
fn admit(gguf_manifest.GgufCorpus corpus, string expected_digest, int expected_length) → Qwen35moeAdmission ⇥ Qwen35moeAdmissionError {
    # family 6: identity precondition, before any architecture read
    require corpus.identity.algorithm ≡ "sha-256" throw variant DivergentIdentity {message = "qwen35moe admission identity divergence: content algorithm"}
    require corpus.identity.digest ≡ expected_digest throw variant DivergentIdentity {message = "qwen35moe admission identity divergence: SHA-256"}
    require corpus.identity.length ≡ expected_length throw variant DivergentIdentity {message = "qwen35moe admission identity divergence: byte length"}
    const gguf_manifest.GgufManifest m ← _parse_admission(corpus)

    # family 7: unknown architecture name — unsupported-but-inspectable
    const string ∪ null architecture ← _read_architecture(m)
    if architecture not is null {
        require architecture coalesce "" ≡ "qwen35moe" throw variant UnknownArchitecture {message = "qwen35moe admission refusal: unsupported-but-inspectable architecture §"(architecture coalesce "")}
    }

    # family 7: unknown raw GGML type — unsupported-but-inspectable
    const string ∪ null unknown_type ← _first_unknown_dtype(m)
    require not (unknown_type not is null) throw variant UnknownType {message = "qwen35moe admission refusal: unsupported-but-inspectable raw GGML type at §"(unknown_type coalesce "")}

    # family 1: config freeze
    const Qwen35moeConfig c ← _freeze_admission(m)

    # families 2-5: canonical tensor map
    const QwenTensorSummary s ← _admit_tensors(m)

    # M5 cross-reference validation
    _admit_references(c, m)
    return Qwen35moeAdmission {config = c, summary = s}
}
