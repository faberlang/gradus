test "family 1 through admission: a frozen metadata divergence yields the typed diagnostic" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    {
        let gguf_manifest.GgufCorpus corpus ← corpus_mutatum(42, true, 2048, false, false)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe metadata divergence at qwen35moe.block_count"
    }
}

test "families 2-5 through admission: name, shape, storage, and count divergences yield the typed diagnostics" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    {
        let gguf_manifest.GgufCorpus corpus ← tensor_corpus(canonical_fragments(true, false, false, false, false, false, false, 41), 753)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe tensor name divergence at blk.0.attn_norm.weight"
    }
    {
        let gguf_manifest.GgufCorpus corpus ← tensor_corpus(canonical_fragments(false, true, false, false, false, false, false, 41), 753)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe tensor shape divergence at blk.0.ffn_down_exps.weight"
    }
    {
        let gguf_manifest.GgufCorpus corpus ← tensor_corpus(canonical_fragments(false, false, true, false, false, false, false, 41), 753)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe tensor storage divergence at blk.40.ffn_gate_inp.weight"
    }
    {
        let gguf_manifest.GgufCorpus corpus ← tensor_corpus(canonical_fragments(false, false, false, false, true, false, false, 41), 752)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe tensor count divergence: tensor count 752 ≠ 753"
    }
}

test "M5 cross-reference divergences surface through the admission entry" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    {
        let gguf_manifest.GgufCorpus corpus ← tensor_corpus(canonical_fragments(false, false, false, false, false, true, false, 41), 753)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe cross-reference dimension divergence at blk.0.attn_qkv.weight"
    }
}

import from "gradus:model/capsule" capsule

test "qwen35moe TensorDirectory admits 40-layer 0-NextN Qwen3.6-35B-A3B without 55/753/41 pins" {
    let artifact.ContentIdentity bb_id ← artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = 1048576 }
    mut list<capsule.SafetensorsTensorDescriptor> descs ← empty
    mut int off ← 0

    descs.append(capsule.SafetensorsTensorDescriptor { name = "model.embed_tokens.weight", dtype = "BF16", shape = [248320, 2048], start = off, end = off + 64, elements = 508559360 })
    off ← off + 64
    descs.append(capsule.SafetensorsTensorDescriptor { name = "model.norm.weight", dtype = "BF16", shape = [2048], start = off, end = off + 64, elements = 2048 })
    off ← off + 64
    descs.append(capsule.SafetensorsTensorDescriptor { name = "lm_head.weight", dtype = "BF16", shape = [248320, 2048], start = off, end = off + 64, elements = 508559360 })
    off ← off + 64

    for range 0 ‥ 40 let layer_idx {
        let string ls ← layer_idx ↦ string
        descs.append(capsule.SafetensorsTensorDescriptor { name = "model.layers.§.input_layernorm.weight"(ls), dtype = "BF16", shape = [2048], start = off, end = off + 32, elements = 2048 })
        off ← off + 32
        if (layer_idx + 1) % 4 ≡ 0 {
            descs.append(capsule.SafetensorsTensorDescriptor { name = "model.layers.§.self_attn.q_proj.weight"(ls), dtype = "BF16", shape = [4096, 2048], start = off, end = off + 32, elements = 8388608 })
            off ← off + 32
        }
        else {
            descs.append(capsule.SafetensorsTensorDescriptor { name = "model.layers.§.linear_attn.in_proj_qkv.weight"(ls), dtype = "BF16", shape = [8192, 2048], start = off, end = off + 32, elements = 16777216 })
            off ← off + 32
        }
        descs.append(capsule.SafetensorsTensorDescriptor { name = "model.layers.§.post_attention_layernorm.weight"(ls), dtype = "BF16", shape = [2048], start = off, end = off + 32, elements = 2048 })
        off ← off + 32
    }

    let capsule.SafetensorsManifest sm ← capsule.SafetensorsManifest { format = "safetensors", version = "1.0.0", artifact_length = 1048576, data_length = off, metadata = [], tensors = descs }

    do {
        let bundle.ModelBundle b ← bundle.safetensors_unindexed([bb_id], null, null, null, null, null)
        do {
            let tensor_directory.TensorDirectory dir ← tensor_directory.build(b, [
                variant tensor_directory.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = sm }
            ], [], [])
            do {
                let cfg.ModelConfig mc ← cfg.parse_json("{\"model_type\": \"qwen35moe\", \"hidden_size\": 2048, \"num_hidden_layers\": 40, \"num_attention_heads\": 16, \"num_key_value_heads\": 2, \"head_dim\": 256, \"intermediate_size\": 512, \"vocab_size\": 248320, \"full_attention_interval\": 4, \"num_local_experts\": 256, \"num_experts_per_tok\": 8, \"rope_dimension_sections\": [11, 11, 10, 0]}")
                do {
                    let qwen35moe.Qwen35moeConfig qc ← qwen35moe.config_from_directory(mc, dir)
                    assert qc.block_count ≡ 40
                    assert qc.nextn_predict_layers ≡ 0
                    assert qc.token_count ≡ 248320
                    assert qc.rope_dimension_count ≡ 64

                    do {
                        let qwen35moe.QwenTensorSummary summary ← qwen35moe.admit_in_directory(qc, dir)
                        assert summary.hybrid ≡ 30
                        assert summary.full_attention ≡ 10
                        assert summary.nextn ≡ 0
                        assert summary.globals ≡ 3
                        assert summary.total ≡ 123
                    }
                    catch err {
                        assert false
                    }

                    do {
                        let tensor_directory.DirectoryEntry l39 ← qwen35moe.resolve_in_directory(dir, qc, "model.layers.39.self_attn.q_proj.weight")
                        assert l39.raw_dtype ≡ "BF16"
                    }
                    catch err {
                        assert false
                    }

                    # Layer 40 is out of range for 40-layer Qwen3.6-35B-A3B
                    mut bool caught_oob ← false
                    do {
                        qwen35moe.resolve_in_directory(dir, qc, "model.layers.40.input_layernorm.weight")
                    }
                    catch err {
                        caught_oob ← true
                    }
                    assert caught_oob
                }
                catch err {
                    assert false
                }
            }
            catch err {
                assert false
            }
        }
        catch err {
            assert false
        }
    }
    catch err {
        assert false
    }
}

test "qwen35moe config_from_gguf reads 40-layer 0-NextN metadata and tokenizer fields without 55/41 pins" {
    let gguf_manifest.GgufCorpus corpus ← corpus_mutatum(40, false, 2048, false, false)
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            let qwen35moe.Qwen35moeConfig qc ← qwen35moe.config_from_gguf(m)
            assert qc.block_count ≡ 40
            assert qc.tokenizer_model ≡ "gpt2"
            assert qc.tokenizer_pre ≡ "qwen35"
            assert qc.token_count ≡ TOKENS_PIN
            assert qc.token_type_count ≡ TOKENS_PIN
            assert qc.merge_count ≡ MERGES_PIN
            assert qc.eos_token_id ≡ 248046
            assert qc.padding_token_id ≡ 248055
            assert qc.bos_token_id ≡ 248044
            assert qc.add_bos_token ≡ false
        }
        catch err {
            assert false
        }
    }
    catch err {
        assert false
    }
}

fn gguf_desc(string name, list<int> shape, int dtype_id, int rel_off, int elems, int blen) → gguf_manifest.GgufTensorDescriptor {
    return gguf_manifest.GgufTensorDescriptor {
        name = name,
        shape = shape,
        dtype_ggml = dtype_id,
        representation = storage.ggml_representation(dtype_id),
        relative_offset = rel_off,
        elements = elems,
        layout = variant gguf_manifest.GgmlLayout.Known { elements_per_block = 32, bytes_per_block = 18, byte_length = blen },
        block = storage.BlockMetadata { known = true, elements_per_block = 32, bytes_per_block = 18, block_count = 1, byte_length = blen }
    }
}

test "qwen35moe config_from_directory reads GGUF ne=[embd, vocab] and tally_storage counts Q5_0/Q4_1/IQ4_NL/F16/U32/U8/F8_E4M3" {
    # GGUF embedding tensor stored as ne=[2048, 248320] + Q5_0 (6), Q4_1 (3), IQ4_NL (20)
    let artifact.ContentIdentity gguf_id ← artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = 4096 }
    let gguf_manifest.GgufManifest gm ← gguf_manifest.GgufManifest {
        identity = gguf_id,
        version = 3,
        alignment = 32,
        data_start = 128,
        artifact_length = 4096,
        metadata = [],
        tensors = [
            gguf_desc("token_embd.weight", [2048, 248320], 6, 0, 508559360, 64),
            gguf_desc("output_norm.weight", [2048], 0, 64, 2048, 64),
            gguf_desc("blk.0.attn_norm.weight", [2048], 0, 128, 2048, 64),
            gguf_desc("blk.0.attn_qkv.weight", [8192, 2048], 3, 192, 16777216, 64),
            gguf_desc("blk.0.post_attention_norm.weight", [2048], 20, 256, 2048, 64)
        ]
    }
    do {
        let bundle.ModelBundle gb ← bundle.gguf_single(gguf_id)
        do {
            let tensor_directory.TensorDirectory gdir ← tensor_directory.build(gb, [
                variant tensor_directory.ShardSource.GgufSource { role = variant bundle.MemberRole.Backbone, manifest = gm }
            ], [], [])
            do {
                let cfg.ModelConfig mc ← cfg.parse_json(«{"model_type": "qwen35moe", "hidden_size": 2048, "num_hidden_layers": 1, "num_attention_heads": 16, "num_key_value_heads": 2, "head_dim": 256, "moe_intermediate_size": 512, "shared_expert_intermediate_size": 1024, "vocab_size": 1000, "full_attention_interval": 4, "num_local_experts": 256, "num_experts_per_tok": 8, "rope_dimension_sections": [11, 11, 10, 0]}»)
                do {
                    let qwen35moe.Qwen35moeConfig qc ← qwen35moe.config_from_directory(mc, gdir)
                    assert qc.token_count ≡ 248320
                    assert qc.rope_dimension_count ≡ 64
                    assert qc.expert_ffn_length ≡ 512
                    assert qc.shared_ffn_length ≡ 1024

                    do {
                        let qwen35moe.QwenTensorSummary gsum ← qwen35moe.admit_in_directory(qc, gdir)
                        assert gsum.storage_q5_0 ≡ 1
                        assert gsum.storage_q4_1 ≡ 1
                        assert gsum.storage_iq4_nl ≡ 1
                        assert gsum.storage_f32 ≡ 2
                    }
                    catch err {
                        assert false
                    }
                }
                catch err {
                    assert false
                }
            }
            catch err {
                assert false
            }
        }
        catch err {
            assert false
        }
    }
    catch err {
        assert false
    }

    # Mixed Safetensors storage tally across F16, U32, U8, F8_E4M3
    let artifact.ContentIdentity bb_id ← artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = 1048576 }
    let list<capsule.SafetensorsTensorDescriptor> descs ← [
        capsule.SafetensorsTensorDescriptor { name = "model.embed_tokens.weight", dtype = "F16", shape = [248320, 2048], start = 0, end = 64, elements = 508559360 },
        capsule.SafetensorsTensorDescriptor { name = "model.norm.weight", dtype = "F32", shape = [2048], start = 64, end = 128, elements = 2048 },
        capsule.SafetensorsTensorDescriptor { name = "model.layers.0.input_layernorm.weight", dtype = "F32", shape = [2048], start = 128, end = 192, elements = 2048 },
        capsule.SafetensorsTensorDescriptor { name = "model.layers.0.linear_attn.in_proj_qkv.weight", dtype = "U32", shape = [8192, 2048], start = 192, end = 256, elements = 16777216 },
        capsule.SafetensorsTensorDescriptor { name = "model.layers.0.linear_attn.in_proj_qkv.scales", dtype = "F8_E4M3", shape = [8192, 64], start = 256, end = 320, elements = 524288 },
        capsule.SafetensorsTensorDescriptor { name = "model.layers.0.post_attention_layernorm.weight", dtype = "U8", shape = [2048], start = 320, end = 384, elements = 2048 }
    ]
    let capsule.SafetensorsManifest sm ← capsule.SafetensorsManifest { format = "safetensors", version = "1.0.0", artifact_length = 1048576, data_length = 384, metadata = [], tensors = descs }
    do {
        let bundle.ModelBundle b ← bundle.safetensors_unindexed([bb_id], null, null, null, null, null)
        do {
            let tensor_directory.TensorDirectory dir ← tensor_directory.build(b, [
                variant tensor_directory.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = sm }
            ], [], [])
            do {
                let cfg.ModelConfig mc ← cfg.parse_json(«{"model_type": "qwen35moe", "hidden_size": 2048, "num_hidden_layers": 1, "num_attention_heads": 16, "num_key_value_heads": 2, "head_dim": 256, "intermediate_size": 512, "vocab_size": 248320, "full_attention_interval": 4}»)
                do {
                    let qwen35moe.Qwen35moeConfig qc ← qwen35moe.config_from_directory(mc, dir)
                    do {
                        let qwen35moe.QwenTensorSummary summary ← qwen35moe.admit_in_directory(qc, dir)
                        assert summary.storage_f16 ≡ 1
                        assert summary.storage_f32 ≡ 2
                        assert summary.storage_u32 ≡ 1
                        assert summary.storage_f8_e4m3 ≡ 1
                        assert summary.storage_u8 ≡ 1
                    }
                    catch err {
                        assert false
                    }
                }
                catch err {
                    assert false
                }
            }
            catch err {
                assert false
            }
        }
        catch err {
            assert false
        }
    }
    catch err {
        assert false
    }
}
