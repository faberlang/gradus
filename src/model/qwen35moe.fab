# qwen35moe typed configuration genus and metadata freeze (MODEL-01-M3).
#
# Public import: importa ex "gradus:model/qwen35moe" qwen35moe
# Depends on: gradus:model/gguf_manifest (typed metadata accessors).
#
# `congela` freezes the frozen qwen35moe configuration rows from a parsed
# GGUF manifest — every row of the Frozen Architecture Configuration table in
# the MODEL-01 delivery (architecture/quantization, block/embedding,
# attention, rope, expert, SSM, nextn, and the tokenizer identity facts) —
# and enforces the 55-entry metadata count. Mutation family 1 fails closed
# with a typed divergence diagnostic naming the first diverging key: any
# frozen value changed, a required key missing, or an extra unknown
# `qwen35moe.*` key that shadows a required fact. Tokenizer facts are frozen
# as identity only; tokenizer execution is GGUF-A2's unit.

importa ex "gradus:model/gguf_manifest" manifestum

fixum numerus METADATA_PIN ← 55
fixum numerus GGUF_FLOAT32 ← 6
fixum numerus PRAEFIXUM_QWEN ← 10

@ publica
genus ConfiguratioQwen35moe {
    textus architectura
    numerus typus_limaturae
    numerus versio_quantificationis
    numerus numerus_tractuum
    numerus longitudo_contextus
    numerus longitudo_vestimenti
    numerus numerus_capita
    numerus numerus_capita_kv
    numerus longitudo_clavis
    numerus longitudo_valoris
    f32 epsilon_normae_rms
    f32 basis_frequentiae
    numerus numerus_dimensionum_rotae
    lista<numerus> sectiones_rotae
    numerus numerus_expertorum
    numerus numerus_expertorum_activorum
    numerus longitudo_ffn_experti
    numerus longitudo_ffn_communi
    numerus nucleus_convolutus
    numerus magnitudo_status
    numerus numerus_coetuum
    numerus gradus_temporis
    numerus magnitudo_interior
    numerus intervallum_attentionis_plenae
    numerus numerus_strata_nextn
    textus exemplum_tokenizoris
    textus praeparatio_tokenizoris
    numerus numerus_tokenum
    numerus numerus_typorum_tokenum
    numerus numerus_concatenationum
    numerus eos_token_id
    numerus padding_token_id
    numerus bos_token_id
    bivalens add_bos_token
}

@ publica
discretio ErrorConfiguratioQwen35moe {
    MetadatumDiversum { textus clavis }
}

@ publica
functio causa(ErrorConfiguratioQwen35moe e) → textus {
    discerne e {
        casu MetadatumDiversum fixum clavis {
            redde "qwen35moe metadata divergence at " + clavis
        }
    }
}

# -------------------------------------------------------------------------
# Required-key membership for the extra-unknown-key scan.
# -------------------------------------------------------------------------

@ privata
functio _clavis_requisita_qwen(textus clavis) → bivalens {
    si clavis ≡ "qwen35moe.block_count" ergo redde verum
    si clavis ≡ "qwen35moe.context_length" ergo redde verum
    si clavis ≡ "qwen35moe.embedding_length" ergo redde verum
    si clavis ≡ "qwen35moe.attention.head_count" ergo redde verum
    si clavis ≡ "qwen35moe.attention.head_count_kv" ergo redde verum
    si clavis ≡ "qwen35moe.attention.key_length" ergo redde verum
    si clavis ≡ "qwen35moe.attention.value_length" ergo redde verum
    si clavis ≡ "qwen35moe.attention.layer_norm_rms_epsilon" ergo redde verum
    si clavis ≡ "qwen35moe.rope.freq_base" ergo redde verum
    si clavis ≡ "qwen35moe.rope.dimension_count" ergo redde verum
    si clavis ≡ "qwen35moe.rope.dimension_sections" ergo redde verum
    si clavis ≡ "qwen35moe.expert_count" ergo redde verum
    si clavis ≡ "qwen35moe.expert_used_count" ergo redde verum
    si clavis ≡ "qwen35moe.expert_feed_forward_length" ergo redde verum
    si clavis ≡ "qwen35moe.expert_shared_feed_forward_length" ergo redde verum
    si clavis ≡ "qwen35moe.ssm.conv_kernel" ergo redde verum
    si clavis ≡ "qwen35moe.ssm.state_size" ergo redde verum
    si clavis ≡ "qwen35moe.ssm.group_count" ergo redde verum
    si clavis ≡ "qwen35moe.ssm.time_step_rank" ergo redde verum
    si clavis ≡ "qwen35moe.ssm.inner_size" ergo redde verum
    si clavis ≡ "qwen35moe.full_attention_interval" ergo redde verum
    si clavis ≡ "qwen35moe.nextn_predict_layers" ergo redde verum
    redde falsum
}

# The first extra `qwen35moe.*` key outside the frozen set, or nihil.
@ privata
functio _clavis_qwen_ignota(manifestum.ManifestumGguf m) → textus ∪ nihil {
    itera ex m.metadata fixum meta {
        si meta.clavis.longitudo() ≥ PRAEFIXUM_QWEN et meta.clavis.sectio(0, PRAEFIXUM_QWEN) ≡ "qwen35moe." et non (_clavis_requisita_qwen(meta.clavis)) {
            redde meta.clavis
        }
    }
    redde nihil
}

# -------------------------------------------------------------------------
# Byte and float32-wire helpers (value arithmetic, the dequant seam).
# -------------------------------------------------------------------------

@ privata
functio _octeti_lista(octeti o) → lista<numerus<u8>> {
    fixum valor wire ← o ↦ valor
    fixum lista<numerus> numeri ← wire ↦ lista<numerus>
    varia lista<numerus<u8>> out ← vacua
    itera ex numeri fixum v {
        out.appende(v ∷ numerus<u8>)
    }
    redde out
}

@ privata
functio _byte(lista<numerus<u8>> b, numerus off) → numerus {
    redde (b.accipe(off) vel (0 ∷ numerus<u8>)) ↦ numerus
}

@ privata
functio _potentia_duorum(numerus n) → fractus {
    varia fractus result ← 1.0
    si n ≥ 0 {
        varia numerus i ← 0
        dum i < n {
            result ← result * 2.0
            i ← i + 1
        }
    } secus {
        varia numerus i ← n
        dum i < 0 {
            result ← result / 2.0
            i ← i + 1
        }
    }
    redde result
}

# 4 little-endian bytes -> exact f32 VALUE (IEEE-754 binary32 decode, the
# dequant `_f32le` seam). Infinity or a NaN payload decodes to a value that
# can never equal either frozen float fact, so the freeze comparison fails
# closed without a special NaN branch.
@ privata
functio _f32_le(lista<numerus<u8>> b, numerus off) → f32 {
    fixum numerus b0 ← _byte(b, off)
    fixum numerus b1 ← _byte(b, off + 1)
    fixum numerus b2 ← _byte(b, off + 2)
    fixum numerus b3 ← _byte(b, off + 3)
    fixum numerus raw ← (b3 * 16777216) + (b2 * 65536) + (b1 * 256) + b0
    fixum numerus sign ← (raw ⇒ 31) % 2
    fixum numerus exp ← (raw ⇒ 23) % 256
    fixum numerus frac ← raw % 8388608
    varia fractus sign_factor ← 1.0
    si sign ≠ 0 {
        sign_factor ← -1.0
    }
    fixum fractus frac_ratio ← (frac ↦ fractus) / 8388608.0
    si exp ≡ 0 {
        si frac ≡ 0 {
            redde (sign_factor * 0.0) ↦ f32
        }
        fixum fractus power ← _potentia_duorum(-126)
        redde (sign_factor * power * frac_ratio) ↦ f32
    }
    fixum fractus power ← _potentia_duorum(exp - 127)
    redde (sign_factor * power * (1.0 + frac_ratio)) ↦ f32
}

# -------------------------------------------------------------------------
# Typed read-and-pin accessors. Every accessor maps a missing or malformed
# key to a divergence diagnostic naming that key, then compares the read
# value against the frozen expectation. First divergence wins.
# -------------------------------------------------------------------------

@ privata
functio _exige_meta(manifestum.ManifestumGguf m, textus clavis) → manifestum.MetadatumGguf ⇥ ErrorConfiguratioQwen35moe {
    fac {
        redde manifestum.metadatum(m, clavis)
    }
    cape err {
        iace finge MetadatumDiversum { clavis = clavis }
    }
}

@ privata
functio _exige_numerum(manifestum.ManifestumGguf m, textus clavis, numerus expectatum) → numerus ⇥ ErrorConfiguratioQwen35moe {
    varia numerus observatum ← 0
    fac {
        observatum ← manifestum.numerum(m, clavis)
    }
    cape err {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si observatum ≠ expectatum {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    redde observatum
}

@ privata
functio _exige_textum(manifestum.ManifestumGguf m, textus clavis, textus expectatum) → textus ⇥ ErrorConfiguratioQwen35moe {
    varia textus observatum ← ""
    fac {
        observatum ← manifestum.textum(m, clavis)
    }
    cape err {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si observatum ≠ expectatum {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    redde observatum
}

@ privata
functio _exige_bool(manifestum.ManifestumGguf m, textus clavis, bivalens expectatum) → bivalens ⇥ ErrorConfiguratioQwen35moe {
    varia bivalens observatum ← falsum
    fac {
        observatum ← manifestum.boleanum(m, clavis)
    }
    cape err {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si observatum ≠ expectatum {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    redde observatum
}

@ privata
functio _exige_longitudo(manifestum.ManifestumGguf m, textus clavis, numerus expectatum) → numerus ⇥ ErrorConfiguratioQwen35moe {
    varia numerus observatum ← 0
    fac {
        observatum ← manifestum.longitudo_listae(m, clavis)
    }
    cape err {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si observatum ≠ expectatum {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    redde observatum
}

@ privata
functio _exige_f32(manifestum.ManifestumGguf m, textus clavis, f32 expectatum) → f32 ⇥ ErrorConfiguratioQwen35moe {
    fixum manifestum.MetadatumGguf meta ← _exige_meta(m, clavis)
    si meta.typo ≠ GGUF_FLOAT32 {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    fixum f32 observatum ← _f32_le(_octeti_lista(meta.valor_wire), 0)
    si non (observatum ≡ expectatum) {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    redde observatum
}

@ privata
functio _exige_sectiones(manifestum.ManifestumGguf m, textus clavis) → lista<numerus> ⇥ ErrorConfiguratioQwen35moe {
    varia lista<numerus> observata ← vacua
    fac {
        observata ← manifestum.numerorum_u32(m, clavis)
    }
    cape err {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si observata.longitudo() ≠ 4 {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si (observata.accipe(0) vel 0) ≠ 11 {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si (observata.accipe(1) vel 0) ≠ 11 {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si (observata.accipe(2) vel 0) ≠ 10 {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    si (observata.accipe(3) vel 0) ≠ 0 {
        iace finge MetadatumDiversum { clavis = clavis }
    }
    redde observata
}

# Freeze the frozen qwen35moe configuration. Reads are in the delivery table
# order, so the first diverging fact is deterministic.
@ publica
functio congela(manifestum.ManifestumGguf m) → ConfiguratioQwen35moe ⇥ ErrorConfiguratioQwen35moe {
    fixum textus architectura ← _exige_textum(m, "general.architecture", "qwen35moe")
    fixum numerus typus_limaturae ← _exige_numerum(m, "general.file_type", 15)
    fixum numerus versio_quantificationis ← _exige_numerum(m, "general.quantization_version", 2)
    fixum numerus numerus_tractuum ← _exige_numerum(m, "qwen35moe.block_count", 41)
    fixum numerus longitudo_contextus ← _exige_numerum(m, "qwen35moe.context_length", 262144)
    fixum numerus longitudo_vestimenti ← _exige_numerum(m, "qwen35moe.embedding_length", 2048)
    fixum numerus numerus_capita ← _exige_numerum(m, "qwen35moe.attention.head_count", 16)
    fixum numerus numerus_capita_kv ← _exige_numerum(m, "qwen35moe.attention.head_count_kv", 2)
    fixum numerus longitudo_clavis ← _exige_numerum(m, "qwen35moe.attention.key_length", 256)
    fixum numerus longitudo_valoris ← _exige_numerum(m, "qwen35moe.attention.value_length", 256)
    fixum f32 epsilon_normae_rms ← _exige_f32(m, "qwen35moe.attention.layer_norm_rms_epsilon", (0.0000009999999974752427 ∷ f32))
    fixum f32 basis_frequentiae ← _exige_f32(m, "qwen35moe.rope.freq_base", (10000000.0 ∷ f32))
    fixum numerus numerus_dimensionum_rotae ← _exige_numerum(m, "qwen35moe.rope.dimension_count", 64)
    fixum lista<numerus> sectiones_rotae ← _exige_sectiones(m, "qwen35moe.rope.dimension_sections")
    fixum numerus numerus_expertorum ← _exige_numerum(m, "qwen35moe.expert_count", 256)
    fixum numerus numerus_expertorum_activorum ← _exige_numerum(m, "qwen35moe.expert_used_count", 8)
    fixum numerus longitudo_ffn_experti ← _exige_numerum(m, "qwen35moe.expert_feed_forward_length", 512)
    fixum numerus longitudo_ffn_communi ← _exige_numerum(m, "qwen35moe.expert_shared_feed_forward_length", 512)
    fixum numerus nucleus_convolutus ← _exige_numerum(m, "qwen35moe.ssm.conv_kernel", 4)
    fixum numerus magnitudo_status ← _exige_numerum(m, "qwen35moe.ssm.state_size", 128)
    fixum numerus numerus_coetuum ← _exige_numerum(m, "qwen35moe.ssm.group_count", 16)
    fixum numerus gradus_temporis ← _exige_numerum(m, "qwen35moe.ssm.time_step_rank", 32)
    fixum numerus magnitudo_interior ← _exige_numerum(m, "qwen35moe.ssm.inner_size", 4096)
    fixum numerus intervallum_attentionis_plenae ← _exige_numerum(m, "qwen35moe.full_attention_interval", 4)
    fixum numerus numerus_strata_nextn ← _exige_numerum(m, "qwen35moe.nextn_predict_layers", 1)
    fixum textus exemplum_tokenizoris ← _exige_textum(m, "tokenizer.ggml.model", "gpt2")
    fixum textus praeparatio_tokenizoris ← _exige_textum(m, "tokenizer.ggml.pre", "qwen35")
    fixum numerus numerus_tokenum ← _exige_longitudo(m, "tokenizer.ggml.tokens", 248320)
    fixum numerus numerus_typorum_tokenum ← _exige_longitudo(m, "tokenizer.ggml.token_type", 248320)
    fixum numerus numerus_concatenationum ← _exige_longitudo(m, "tokenizer.ggml.merges", 247587)
    fixum numerus eos_token_id ← _exige_numerum(m, "tokenizer.ggml.eos_token_id", 248046)
    fixum numerus padding_token_id ← _exige_numerum(m, "tokenizer.ggml.padding_token_id", 248055)
    fixum numerus bos_token_id ← _exige_numerum(m, "tokenizer.ggml.bos_token_id", 248044)
    fixum bivalens add_bos_token ← _exige_bool(m, "tokenizer.ggml.add_bos_token", falsum)

    fixum textus ∪ nihil ignota ← _clavis_qwen_ignota(m)
    si ignota non est nihil {
        iace finge MetadatumDiversum { clavis = ignota vel "" }
    }

    si m.metadata.longitudo() ≠ METADATA_PIN {
        iace finge MetadatumDiversum { clavis = "metadata count" }
    }

    redde ConfiguratioQwen35moe {
        architectura = architectura,
        typus_limaturae = typus_limaturae,
        versio_quantificationis = versio_quantificationis,
        numerus_tractuum = numerus_tractuum,
        longitudo_contextus = longitudo_contextus,
        longitudo_vestimenti = longitudo_vestimenti,
        numerus_capita = numerus_capita,
        numerus_capita_kv = numerus_capita_kv,
        longitudo_clavis = longitudo_clavis,
        longitudo_valoris = longitudo_valoris,
        epsilon_normae_rms = epsilon_normae_rms,
        basis_frequentiae = basis_frequentiae,
        numerus_dimensionum_rotae = numerus_dimensionum_rotae,
        sectiones_rotae = sectiones_rotae,
        numerus_expertorum = numerus_expertorum,
        numerus_expertorum_activorum = numerus_expertorum_activorum,
        longitudo_ffn_experti = longitudo_ffn_experti,
        longitudo_ffn_communi = longitudo_ffn_communi,
        nucleus_convolutus = nucleus_convolutus,
        magnitudo_status = magnitudo_status,
        numerus_coetuum = numerus_coetuum,
        gradus_temporis = gradus_temporis,
        magnitudo_interior = magnitudo_interior,
        intervallum_attentionis_plenae = intervallum_attentionis_plenae,
        numerus_strata_nextn = numerus_strata_nextn,
        exemplum_tokenizoris = exemplum_tokenizoris,
        praeparatio_tokenizoris = praeparatio_tokenizoris,
        numerus_tokenum = numerus_tokenum,
        numerus_typorum_tokenum = numerus_typorum_tokenum,
        numerus_concatenationum = numerus_concatenationum,
        eos_token_id = eos_token_id,
        padding_token_id = padding_token_id,
        bos_token_id = bos_token_id,
        add_bos_token = add_bos_token
    }
}
