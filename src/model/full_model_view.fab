@ public
class F32ModelView {
    string canonical_name
    string tensor_name
    string family
    int layer
    dtype.DType dtype_tag
    list<int> shape
    int values
    int absolute_start
    int absolute_end
    int byte_length
    int artifact_length
    string artifact_digest
    string tensor_digest
    bytes payload

    fn canonical_name() → string {
        return self.canonical_name
    }

    fn tensor_name() → string {
        return self.tensor_name
    }

    fn family() → string {
        return self.family
    }

    fn layer() → int {
        return self.layer
    }

    fn dtype() → dtype.DType {
        return self.dtype_tag
    }

    fn shape() → list<int> {
        return self.shape
    }

    fn values() → int {
        return self.values
    }

    fn absolute_start() → int {
        return self.absolute_start
    }

    fn absolute_end() → int {
        return self.absolute_end
    }

    fn byte_length() → int {
        return self.byte_length
    }

    fn artifact_length() → int {
        return self.artifact_length
    }

    fn artifact_digest() → string {
        return self.artifact_digest
    }

    fn tensor_digest() → string {
        return self.tensor_digest
    }

    fn payload() → bytes {
        return self.payload
    }
}

@ public
union ModelViewError {
    @ shared
    string message

    BadName,
    BadDtype,
    BadShape,
    BadRange,
    BadDigest,
    BadPayload,
    BadLayer
}

fn _shape_matches(list<int> actual, list<int> expected) → bool {
    if actual.length() ≠ expected.length() then return false
    for range 0‥expected.length() const i {
        if actual.get(i) coalesce (-1) ≠ expected.get(i) coalesce (-1) then return false
    }
    return true
}

fn _range_matches(int start, int end, int expected_start, int expected_end, int expected_bytes, bytes payload) → bool {
    if start ≺ 0 then return false
    if end ≤ start then return false
    if start ≠ expected_start or end ≠ expected_end then return false
    if end - start ≠ expected_bytes then return false
    if payload.length() ≠ expected_bytes then return false
    return true
}

fn _layer_in_range(int layer) → bool {
    return not (layer ≺ 0 or layer ≥ BLOCK_COUNT)
}

# Bind one block-family row: the expected range is the layer start plus the
# family offset, both from the frozen manifest rows above.
fn _admit_layer_row(string family, string canonical_family, string suffix, list<int> expected_shape, int expected_values, int within_layer_offset, int expected_bytes, list<string> digests, int layer, bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    # --- artifact + layer identity (fail closed) --------------------------
    require artifact_length ≡ GEA3_ARTIFACT_LENGTH throw variant BadRange {message = "GEA3 source artifact length does not match the frozen F32 GGUF"}
    require artifact_digest ≡ GEA3_ARTIFACT_DIGEST throw variant BadDigest {message = "GEA3 source artifact digest does not match the frozen F32 GGUF"}
    require _layer_in_range(layer) throw variant BadLayer {message = "GEA3 layer index is outside the frozen block range 0..31: §"(layer ↦ string)}
    const int expected_start ← (LAYER_STARTS.get(layer) coalesce (-1)) + within_layer_offset
    const string expected_digest ← digests.get(layer) coalesce ""

    # --- expected row derivation + checks ---------------------------------
    require tensor_digest ≡ expected_digest throw variant BadDigest {message = "GEA3 tensor digest does not match the frozen manifest row"}
    require _shape_matches(shape, expected_shape) throw variant BadShape {message = "GEA3 full-model tensor shape does not match the frozen manifest row"}
    require _range_matches(absolute_start, absolute_end, expected_start, expected_start + expected_bytes, expected_bytes, payload) throw variant BadRange {message = "GEA3 full-model tensor range does not match the frozen manifest row"}
    require expected_values * dtype.width(dtype.f32()) ≡ expected_bytes throw variant BadPayload {message = "GEA3 F32 full-model tensor byte geometry is inconsistent"}
    const string tensor_name ← "blk." + (layer ↦ string) + "." + suffix
    return F32ModelView {canonical_name = canonical_family, tensor_name = tensor_name, family = family, layer = layer, dtype_tag = dtype.f32(), shape = shape, values = expected_values, absolute_start = absolute_start, absolute_end = absolute_end, byte_length = payload.length(), artifact_length = artifact_length, artifact_digest = artifact_digest, tensor_digest = tensor_digest, payload = payload}
}

# Bind one head row (layer -1): token_embd, output_norm, or the tied lm_head.
fn _admit_head_row(string family, string canonical_name, string tensor_name, list<int> expected_shape, int expected_values, int expected_start, int expected_end, int expected_bytes, string expected_digest, bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    # --- artifact identity (fail closed) ----------------------------------
    require artifact_length ≡ GEA3_ARTIFACT_LENGTH throw variant BadRange {message = "GEA3 source artifact length does not match the frozen F32 GGUF"}
    require artifact_digest ≡ GEA3_ARTIFACT_DIGEST throw variant BadDigest {message = "GEA3 source artifact digest does not match the frozen F32 GGUF"}

    # --- row checks + construct -------------------------------------------
    require tensor_digest ≡ expected_digest throw variant BadDigest {message = "GEA3 tensor digest does not match the frozen manifest row"}
    require _shape_matches(shape, expected_shape) throw variant BadShape {message = "GEA3 full-model tensor shape does not match the frozen manifest row"}
    require _range_matches(absolute_start, absolute_end, expected_start, expected_end, expected_bytes, payload) throw variant BadRange {message = "GEA3 full-model tensor range does not match the frozen manifest row"}
    require expected_values * dtype.width(dtype.f32()) ≡ expected_bytes throw variant BadPayload {message = "GEA3 F32 full-model tensor byte geometry is inconsistent"}
    return F32ModelView {canonical_name = canonical_name, tensor_name = tensor_name, family = family, layer = -1, dtype_tag = dtype.f32(), shape = shape, values = expected_values, absolute_start = absolute_start, absolute_end = absolute_end, byte_length = payload.length(), artifact_length = artifact_length, artifact_digest = artifact_digest, tensor_digest = tensor_digest, payload = payload}
}

# Each constructor is a separate typed admission function. The caller supplies
# only the bounded range bytes, the layer index, the absolute range, the
# logical shape, and host-verified identity claims; family names, dtype, and
# expected geometry are fixed here.
@ public
fn admit_attn_norm(int layer, bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    return _admit_layer_row("attn_norm", ATTN_NORM_CANONICAL, ATTN_NORM_SUFFIX, [960], ATTN_NORM_VALUES, ATTN_NORM_OFFSET, ATTN_NORM_BYTES, ATTN_NORM_DIGESTS, layer, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_attn_q(int layer, bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    return _admit_layer_row("attn_q", ATTN_Q_CANONICAL, ATTN_Q_SUFFIX, [960, 960], ATTN_Q_VALUES, ATTN_Q_OFFSET, ATTN_Q_BYTES, ATTN_Q_DIGESTS, layer, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_attn_k(int layer, bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    return _admit_layer_row("attn_k", ATTN_K_CANONICAL, ATTN_K_SUFFIX, [320, 960], ATTN_K_VALUES, ATTN_K_OFFSET, ATTN_K_BYTES, ATTN_K_DIGESTS, layer, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_attn_v(int layer, bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    return _admit_layer_row("attn_v", ATTN_V_CANONICAL, ATTN_V_SUFFIX, [320, 960], ATTN_V_VALUES, ATTN_V_OFFSET, ATTN_V_BYTES, ATTN_V_DIGESTS, layer, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_attn_output(int layer, bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    return _admit_layer_row("attn_output", ATTN_OUTPUT_CANONICAL, ATTN_OUTPUT_SUFFIX, [960, 960], ATTN_OUTPUT_VALUES, ATTN_OUTPUT_OFFSET, ATTN_OUTPUT_BYTES, ATTN_OUTPUT_DIGESTS, layer, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_ffn_norm(int layer, bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    return _admit_layer_row("ffn_norm", FFN_NORM_CANONICAL, FFN_NORM_SUFFIX, [960], FFN_NORM_VALUES, FFN_NORM_OFFSET, FFN_NORM_BYTES, FFN_NORM_DIGESTS, layer, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_ffn_gate(int layer, bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    return _admit_layer_row("ffn_gate", FFN_GATE_CANONICAL, FFN_GATE_SUFFIX, [2560, 960], FFN_GATE_VALUES, FFN_GATE_OFFSET, FFN_GATE_BYTES, FFN_GATE_DIGESTS, layer, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_ffn_up(int layer, bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    return _admit_layer_row("ffn_up", FFN_UP_CANONICAL, FFN_UP_SUFFIX, [2560, 960], FFN_UP_VALUES, FFN_UP_OFFSET, FFN_UP_BYTES, FFN_UP_DIGESTS, layer, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_ffn_down(int layer, bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    return _admit_layer_row("ffn_down", FFN_DOWN_CANONICAL, FFN_DOWN_SUFFIX, [960, 2560], FFN_DOWN_VALUES, FFN_DOWN_OFFSET, FFN_DOWN_BYTES, FFN_DOWN_DIGESTS, layer, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_token_embd(bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    return _admit_head_row("token_embd", TOKEN_EMBD_CANONICAL, TOKEN_EMBD_NAME, [49152, 960], TOKEN_EMBD_VALUES, TOKEN_EMBD_START, TOKEN_EMBD_END, TOKEN_EMBD_BYTES, TOKEN_EMBD_DIGEST, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

@ public
fn admit_output_norm(bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    return _admit_head_row("output_norm", OUTPUT_NORM_CANONICAL, OUTPUT_NORM_NAME, [960], OUTPUT_NORM_VALUES, OUTPUT_NORM_START, OUTPUT_NORM_END, OUTPUT_NORM_BYTES, OUTPUT_NORM_DIGEST, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

# The tied head: lm_head IS token_embd.weight for this model — identical
# range, digest, and [49152,960] geometry under the lm_head identity.
@ public
fn admit_lm_head(bytes payload, int absolute_start, int absolute_end, list<int> shape, int artifact_length, string artifact_digest, string tensor_digest) → F32ModelView ⇥ ModelViewError {
    return _admit_head_row("lm_head", LM_HEAD_CANONICAL, TOKEN_EMBD_NAME, [49152, 960], TOKEN_EMBD_VALUES, TOKEN_EMBD_START, TOKEN_EMBD_END, TOKEN_EMBD_BYTES, TOKEN_EMBD_DIGEST, payload, absolute_start, absolute_end, shape, artifact_length, artifact_digest, tensor_digest)
}

fn _validate_head(F32ModelView view, string expected_canonical, string expected_tensor_name, string expected_family, list<int> expected_shape, int expected_values, int expected_start, int expected_end, int expected_bytes, string expected_digest) → void ⇥ ModelViewError {
    # --- identity + dtype (fail closed) -----------------------------------
    require view.layer() ≡ -1 throw variant BadLayer {message = "GEA3 head row must not carry a layer index"}
    require view.canonical_name() ≡ expected_canonical throw variant BadName {message = "GEA3 full-model view canonical identity does not match its admission row"}
    require view.tensor_name() ≡ expected_tensor_name throw variant BadName {message = "GEA3 full-model view tensor identity does not match its admission row"}
    require view.family() ≡ expected_family throw variant BadName {message = "GEA3 full-model view family does not match its admission row"}
    require dtype.eq(view.dtype(), dtype.f32()) throw variant BadDtype {message = "GEA3 full-model view is not F32"}

    # --- shape + range (fail closed) --------------------------------------
    require _shape_matches(view.shape(), expected_shape) throw variant BadShape {message = "GEA3 full-model view shape does not match its admission row"}
    require view.values() ≡ expected_values throw variant BadShape {message = "GEA3 full-model view value count does not match its admission row"}
    require view.absolute_start() ≡ expected_start and view.absolute_end() ≡ expected_end throw variant BadRange {message = "GEA3 full-model view absolute range does not match its admission row"}
    require view.byte_length() ≡ expected_bytes throw variant BadRange {message = "GEA3 full-model view byte length does not match its admission row"}
    require view.payload().length() ≡ expected_bytes throw variant BadPayload {message = "GEA3 full-model view payload is not the admitted bounded range"}
    require view.artifact_length() ≡ GEA3_ARTIFACT_LENGTH throw variant BadRange {message = "GEA3 full-model view artifact length does not match the frozen F32 GGUF"}

    # --- digest facts (fail closed) ---------------------------------------
    require view.artifact_digest() ≡ GEA3_ARTIFACT_DIGEST throw variant BadDigest {message = "GEA3 full-model view artifact digest does not match the frozen F32 GGUF"}
    require view.tensor_digest() ≡ expected_digest throw variant BadDigest {message = "GEA3 full-model view tensor digest does not match its admission row"}
}

fn _validate_layer(F32ModelView view, string canonical_family, string suffix, list<int> expected_shape, int expected_values, int within_layer_offset, int expected_bytes, string expected_digest, int layer) → void ⇥ ModelViewError {
    # --- expected row derivation ------------------------------------------
    const int expected_start ← (LAYER_STARTS.get(layer) coalesce (-1)) + within_layer_offset
    const string expected_tensor_name ← "blk." + (layer ↦ string) + "." + suffix

    # --- layer binding + shape + range (fail closed) ----------------------
    require view.layer() ≡ layer throw variant BadLayer {message = "GEA3 full-model view layer binding does not match its admission row"}
    require view.canonical_name() ≡ canonical_family throw variant BadName {message = "GEA3 full-model view canonical identity does not match its admission row"}
    require view.tensor_name() ≡ expected_tensor_name throw variant BadName {message = "GEA3 full-model view tensor identity does not match its admission row"}
    require dtype.eq(view.dtype(), dtype.f32()) throw variant BadDtype {message = "GEA3 full-model view is not F32"}
    require _shape_matches(view.shape(), expected_shape) throw variant BadShape {message = "GEA3 full-model view shape does not match its admission row"}
    require view.values() ≡ expected_values throw variant BadShape {message = "GEA3 full-model view value count does not match its admission row"}
    require view.absolute_start() ≡ expected_start and view.absolute_end() ≡ expected_start + expected_bytes throw variant BadRange {message = "GEA3 full-model view absolute range does not match its admission row"}
    require view.byte_length() ≡ expected_bytes throw variant BadRange {message = "GEA3 full-model view byte length does not match its admission row"}
    require view.payload().length() ≡ expected_bytes throw variant BadPayload {message = "GEA3 full-model view payload is not the admitted bounded range"}
    require view.artifact_length() ≡ GEA3_ARTIFACT_LENGTH throw variant BadRange {message = "GEA3 full-model view artifact length does not match the frozen F32 GGUF"}

    # --- digest facts (fail closed) ---------------------------------------
    require view.artifact_digest() ≡ GEA3_ARTIFACT_DIGEST throw variant BadDigest {message = "GEA3 full-model view artifact digest does not match the frozen F32 GGUF"}
    require view.tensor_digest() ≡ expected_digest throw variant BadDigest {message = "GEA3 full-model view tensor digest does not match its admission row"}
}

# Ordinary host validation before a view crosses into a device entry. The
# device body receives only the already-validated F32 resident view.
@ public
fn validate(F32ModelView view) → void ⇥ ModelViewError {
    const string family ← view.family()
    if family ≡ "token_embd" then return _validate_head(view, TOKEN_EMBD_CANONICAL, TOKEN_EMBD_NAME, "token_embd", [49152, 960], TOKEN_EMBD_VALUES, TOKEN_EMBD_START, TOKEN_EMBD_END, TOKEN_EMBD_BYTES, TOKEN_EMBD_DIGEST)
    if family ≡ "output_norm" then return _validate_head(view, OUTPUT_NORM_CANONICAL, OUTPUT_NORM_NAME, "output_norm", [960], OUTPUT_NORM_VALUES, OUTPUT_NORM_START, OUTPUT_NORM_END, OUTPUT_NORM_BYTES, OUTPUT_NORM_DIGEST)
    if family ≡ "lm_head" then return _validate_head(view, LM_HEAD_CANONICAL, TOKEN_EMBD_NAME, "lm_head", [49152, 960], TOKEN_EMBD_VALUES, TOKEN_EMBD_START, TOKEN_EMBD_END, TOKEN_EMBD_BYTES, TOKEN_EMBD_DIGEST)
    require _layer_in_range(view.layer()) throw variant BadLayer {message = "GEA3 layer index is outside the frozen block range 0..31: §"(view.layer() ↦ string)}
    const int layer ← view.layer()
    if family ≡ "attn_norm" then return _validate_layer(view, ATTN_NORM_CANONICAL, ATTN_NORM_SUFFIX, [960], ATTN_NORM_VALUES, ATTN_NORM_OFFSET, ATTN_NORM_BYTES, ATTN_NORM_DIGESTS.get(layer) coalesce "", layer)
    if family ≡ "attn_q" then return _validate_layer(view, ATTN_Q_CANONICAL, ATTN_Q_SUFFIX, [960, 960], ATTN_Q_VALUES, ATTN_Q_OFFSET, ATTN_Q_BYTES, ATTN_Q_DIGESTS.get(layer) coalesce "", layer)
    if family ≡ "attn_k" then return _validate_layer(view, ATTN_K_CANONICAL, ATTN_K_SUFFIX, [320, 960], ATTN_K_VALUES, ATTN_K_OFFSET, ATTN_K_BYTES, ATTN_K_DIGESTS.get(layer) coalesce "", layer)
    if family ≡ "attn_v" then return _validate_layer(view, ATTN_V_CANONICAL, ATTN_V_SUFFIX, [320, 960], ATTN_V_VALUES, ATTN_V_OFFSET, ATTN_V_BYTES, ATTN_V_DIGESTS.get(layer) coalesce "", layer)
    if family ≡ "attn_output" then return _validate_layer(view, ATTN_OUTPUT_CANONICAL, ATTN_OUTPUT_SUFFIX, [960, 960], ATTN_OUTPUT_VALUES, ATTN_OUTPUT_OFFSET, ATTN_OUTPUT_BYTES, ATTN_OUTPUT_DIGESTS.get(layer) coalesce "", layer)
    if family ≡ "ffn_norm" then return _validate_layer(view, FFN_NORM_CANONICAL, FFN_NORM_SUFFIX, [960], FFN_NORM_VALUES, FFN_NORM_OFFSET, FFN_NORM_BYTES, FFN_NORM_DIGESTS.get(layer) coalesce "", layer)
    if family ≡ "ffn_gate" then return _validate_layer(view, FFN_GATE_CANONICAL, FFN_GATE_SUFFIX, [2560, 960], FFN_GATE_VALUES, FFN_GATE_OFFSET, FFN_GATE_BYTES, FFN_GATE_DIGESTS.get(layer) coalesce "", layer)
    if family ≡ "ffn_up" then return _validate_layer(view, FFN_UP_CANONICAL, FFN_UP_SUFFIX, [2560, 960], FFN_UP_VALUES, FFN_UP_OFFSET, FFN_UP_BYTES, FFN_UP_DIGESTS.get(layer) coalesce "", layer)
    if family ≡ "ffn_down" then return _validate_layer(view, FFN_DOWN_CANONICAL, FFN_DOWN_SUFFIX, [960, 2560], FFN_DOWN_VALUES, FFN_DOWN_OFFSET, FFN_DOWN_BYTES, FFN_DOWN_DIGESTS.get(layer) coalesce "", layer)
    throw variant BadName {message = "GEA3 full-model view family is not one of the frozen census rows"}
}
