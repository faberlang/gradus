+++ toml
locale = "en"

+++ faber
# LinearWeight — per-module operator binding from TensorDirectory sibling
# presence and host-side linear_matvec dispatch (issue #50).
#
# Public import: import from "gradus:model/linear_weight" lw
# Depends on: gradus:model/bundle, gradus:model/tensor_directory,
#   gradus:model/dequant, gradus:quant/group_affine, gradus:quant/q8_0,
#   gradus:quant/q4_1, gradus:quant/q5_0, gradus:quant/iq4_nl,
#   gradus:decode_step, gradus:kernel, gradus:storage.
#
# --- Contract ------------------------------------------------------------
#
# Binds a single linear site (q_proj, k_proj, v_proj, o_proj, gate_proj,
# up_proj, down_proj, lm_head) to a typed LinearWeight descriptor by
# inspecting resident sibling tensors first:
#   .weight + .scales + .biases  -> GroupAffine (u32 or u8, 4/6/8-bit)
#   single GGML block tensor     -> GgmlBlock (Q8_0 / Q4_1 / Q5_0 / IQ4_NL /
#                                   Q4_K / Q5_K / Q6_K)
#   .weight [+ .bias]            -> DenseF32 / DenseBf16 / DenseF16
#
# Optional QuantConfigHint supplies secondary validation/parameter defaults
# (e.g. bits, group_size from config.json) while ignoring stale `mode`
# overrides (such as `mode: "nvfp4"`) when GroupAffine siblings are present.
#
# Host-side linear_matvec and kernel dispatchers operate per module so two
# projections in the same layer can hold different quantization schemes
# without expanding full weight matrices to F32.

import from "gradus:decode_step" let ds
import from "gradus:kernel" let kern
import from "gradus:model/bundle" let bundle
import from "gradus:model/dequant" let dequant
import from "gradus:model/tensor_directory" let td
import from "gradus:storage" let storage
import from "gradus:quant/block_fp8" let bf8
import from "gradus:quant/dual_scaled_fp4" let fp4
import from "gradus:quant/group_affine" let ga

@ public
union LinearWeightError {
    @ shared
    string message

    BadBinding,
    UnsupportedFormat,
    BadShape,
    BadConfig,
    DirectoryFailure {
        td.DirectoryError inner
    },
    GroupAffineFailure {
        ga.GroupAffineError inner
    },
    BlockFp8Failure {
        bf8.BlockFp8Error inner
    },
    DualScaledFp4Failure {
        fp4.DualScaledFp4Error inner
    },
    DequantFailure {
        dequant.DequantError inner
    }
}

@ conversion
fn from_directory_error(td.DirectoryError err) → LinearWeightError {
    return variant DirectoryFailure { message = err.message, inner = err }
}

@ conversion
fn from_group_affine_error(ga.GroupAffineError err) → LinearWeightError {
    return variant GroupAffineFailure { message = err.message, inner = err }
}

@ conversion
fn from_block_fp8_error(bf8.BlockFp8Error err) → LinearWeightError {
    return variant BlockFp8Failure { message = err.message, inner = err }
}

@ conversion
fn from_dual_scaled_fp4_error(fp4.DualScaledFp4Error err) → LinearWeightError {
    return variant DualScaledFp4Failure { message = err.message, inner = err }
}

@ conversion
fn from_dequant_error(dequant.DequantError err) → LinearWeightError {
    return variant DequantFailure { message = err.message, inner = err }
}

@ public
union LinearWeightKind {
    DenseF32,
    DenseBf16,
    DenseF16,
    GgmlBlockQ8_0,
    GgmlBlockQ4_1,
    GgmlBlockQ5_0,
    GgmlBlockIQ4_NL,
    GgmlBlockQ4_K,
    GgmlBlockQ5_K,
    GgmlBlockQ6_K,
    GroupAffineU32,
    GroupAffineU8,
    BlockFp8U8,
    BlockFp8U32,
    DualScaledFp4U8,
    DualScaledFp4U32
}

@ public
class QuantConfigHint {
    let string ∪ none mode
    let int ∪ none bits
    let int ∪ none group_size
}

@ public
fn default_hint() → QuantConfigHint {
    return QuantConfigHint { mode = null, bits = null, group_size = null }
}

@ public
class LinearWeight {
    let LinearWeightKind kind
    let int out_features
    let int in_features
    let int bits
    let int group_size
    let int packed_cols
    let int group_cols
    let bool has_bias
    let int block_rows = 0
    let int block_cols = 0
    let string scales_dtype = "F32"
    let bool is_modelopt = false
}

@ public
union WeightPayload {
    DensePayload {
        list<f32> weight
        list<f32> bias
    },
    GroupAffineU32Payload {
        list<u32> weight
        list<f32> scales
        list<f32> biases
        list<f32> bias
    },
    GroupAffineU8Payload {
        list<u8> weight
        list<f32> scales
        list<f32> biases
        list<f32> bias
    },
    GroupAffineU32Bf16Payload {
        list<u32> weight
        list<bf16> scales
        list<bf16> biases
        list<f32> bias
    },
    GroupAffineU8Bf16Payload {
        list<u8> weight
        list<bf16> scales
        list<bf16> biases
        list<f32> bias
    },
    GroupAffineU32F16Payload {
        list<u32> weight
        list<f16> scales
        list<f16> biases
        list<f32> bias
    },
    GroupAffineU8F16Payload {
        list<u8> weight
        list<f16> scales
        list<f16> biases
        list<f32> bias
    },
    BlockFp8U8Payload {
        list<u8> weight
        list<u8> scales
        list<f32> f32_scales
        list<f32> bias
    },
    BlockFp8U32Payload {
        list<u32> weight
        list<u8> scales
        list<f32> f32_scales
        list<f32> bias
    },
    DualScaledFp4U8Payload {
        list<u8> weight
        list<u8> scales
        f32 global_scale
        list<f32> bias
    },
    DualScaledFp4U32Payload {
        list<u32> weight
        list<u8> scales
        f32 global_scale
        list<f32> bias
    },
    GgmlBlockPayload {
        list<u8> raw_blocks
        list<f32> bias
    }
}

# -------------------------------------------------------------------------
# Binding from TensorDirectory sibling presence
# -------------------------------------------------------------------------

fn is_ggml_block_dtype(string raw_dtype) → bool {
    return raw_dtype ≡ "Q8_0" or raw_dtype ≡ "Q4_1" or raw_dtype ≡ "Q5_0" or raw_dtype ≡ "IQ4_NL" or raw_dtype ≡ "Q4_K" or raw_dtype ≡ "Q5_K" or raw_dtype ≡ "Q6_K"
}

fn ggml_kind_for(string raw_dtype) → LinearWeightKind ⇥ LinearWeightError {
    switch raw_dtype {
        case "Q8_0" {
            return variant LinearWeightKind.GgmlBlockQ8_0
        }
        case "Q4_1" {
            return variant LinearWeightKind.GgmlBlockQ4_1
        }
        case "Q5_0" {
            return variant LinearWeightKind.GgmlBlockQ5_0
        }
        case "IQ4_NL" {
            return variant LinearWeightKind.GgmlBlockIQ4_NL
        }
        case "Q4_K" {
            return variant LinearWeightKind.GgmlBlockQ4_K
        }
        case "Q5_K" {
            return variant LinearWeightKind.GgmlBlockQ5_K
        }
        case "Q6_K" {
            return variant LinearWeightKind.GgmlBlockQ6_K
        }
        default {
            throw variant UnsupportedFormat { message = "unsupported GGML block dtype: §"(raw_dtype) }
        }
    }
}

fn ggml_block_elements(LinearWeightKind kind) → int ⇥ LinearWeightError {
    match kind {
        case LinearWeightKind.GgmlBlockQ8_0 {
            return 32
        }
        case LinearWeightKind.GgmlBlockQ4_1 {
            return 32
        }
        case LinearWeightKind.GgmlBlockQ5_0 {
            return 32
        }
        case LinearWeightKind.GgmlBlockIQ4_NL {
            return 32
        }
        case LinearWeightKind.GgmlBlockQ4_K {
            return 256
        }
        case LinearWeightKind.GgmlBlockQ5_K {
            return 256
        }
        case LinearWeightKind.GgmlBlockQ6_K {
            return 256
        }
        default {
            throw variant UnsupportedFormat { message = "not a GGML block kind" }
        }
    }
}

fn ggml_block_bytes(LinearWeightKind kind) → int ⇥ LinearWeightError {
    match kind {
        case LinearWeightKind.GgmlBlockQ8_0 {
            return 34
        }
        case LinearWeightKind.GgmlBlockQ4_1 {
            return 20
        }
        case LinearWeightKind.GgmlBlockQ5_0 {
            return 22
        }
        case LinearWeightKind.GgmlBlockIQ4_NL {
            return 18
        }
        case LinearWeightKind.GgmlBlockQ4_K {
            return 144
        }
        case LinearWeightKind.GgmlBlockQ5_K {
            return 176
        }
        case LinearWeightKind.GgmlBlockQ6_K {
            return 210
        }
        default {
            throw variant UnsupportedFormat { message = "not a GGML block kind" }
        }
    }
}

fn dense_kind_for(string raw_dtype) → LinearWeightKind ⇥ LinearWeightError {
    switch raw_dtype {
        case "F32" {
            return variant LinearWeightKind.DenseF32
        }
        case "BF16" {
            return variant LinearWeightKind.DenseBf16
        }
        case "F16" {
            return variant LinearWeightKind.DenseF16
        }
        default {
            throw variant UnsupportedFormat { message = "unsupported dense dtype: §"(raw_dtype) }
        }
    }
}

class AffineGeom {
    let int group_size
    let int bits
}

fn apply_row_prefix_view(int raw_out, td.LoadView view) → int ⇥ LinearWeightError {
    match view {
        case RowPrefix let rows {
            require rows ≥ 1 and rows ≤ raw_out throw variant BadShape { message = "RowPrefix rows (§) out of bounds for weight rows (§)"(rows ↦ string, raw_out ↦ string) }
            return rows
        }
        default {
            return raw_out
        }
    }
}

fn is_scalar_entry(td.DirectoryEntry entry) → bool {
    for from entry.shape let d {
        if d ≢ 1 {
            return false
        }
    }
    return true
}

fn affine_bits_valid(int bits, bool is_u8) → bool {
    if is_u8 {
        return bits ≡ 4 or bits ≡ 8
    }
    return bits ≡ 4 or bits ≡ 6 or bits ≡ 8
}

fn hint_allows_affine(QuantConfigHint hint) → bool {
    if hint.mode is string {
        let string hm ← hint.mode coalesce ""
        return hm ≡ "affine" or hm ≡ "group_affine"
    }
    return true
}

fn resolve_affine_geom(int bits_per_group, bool is_u8, QuantConfigHint hint) → AffineGeom ⇥ LinearWeightError {
    if hint_allows_affine(hint) {
        if hint.group_size is int and hint.bits is int {
            let int hg ← hint.group_size coalesce 0
            let int hb ← hint.bits coalesce 0
            if hg ≥ 1 and affine_bits_valid(hb, is_u8) and hg * hb ≡ bits_per_group {
                return AffineGeom { group_size = hg, bits = hb }
            }
        }
        elif hint.group_size is int {
            let int hg ← hint.group_size coalesce 0
            if hg ≥ 1 and bits_per_group % hg ≡ 0 {
                let int b ← bits_per_group / hg
                if affine_bits_valid(b, is_u8) {
                    return AffineGeom { group_size = hg, bits = b }
                }
            }
        }
        elif hint.bits is int {
            let int hb ← hint.bits coalesce 0
            if affine_bits_valid(hb, is_u8) and bits_per_group % hb ≡ 0 {
                return AffineGeom { group_size = bits_per_group / hb, bits = hb }
            }
        }
    }

    let list<int> candidates ← [64, 32, 128, 16, 256, 8, 4]
    for from candidates let gs {
        if bits_per_group % gs ≡ 0 {
            let int b ← bits_per_group / gs
            if affine_bits_valid(b, is_u8) {
                return AffineGeom { group_size = gs, bits = b }
            }
        }
    }

    throw variant BadShape { message = "unable to infer valid GroupAffine group_size and bits for bits_per_group=§"(bits_per_group ↦ string) }
}

fn group_affine_scale_dtype(string raw_dtype) → ga.ScaleDtype {
    if raw_dtype ≡ "BF16" then return variant ga.ScaleDtype.ScaleBf16
    if raw_dtype ≡ "F16" then return variant ga.ScaleDtype.ScaleF16
    return variant ga.ScaleDtype.ScaleF32
}

fn bind_group_affine(td.DirectoryEntry weight, td.DirectoryEntry scales, td.DirectoryEntry biases, bool has_bias, QuantConfigHint hint) → LinearWeight ⇥ LinearWeightError {
    let int raw_out ← weight.shape.get(0) coalesce 0
    let int out_features ← apply_row_prefix_view(raw_out, weight.view)
    let int packed_cols ← weight.shape.get(1) coalesce 0
    require scales.shape.length() ≡ 2 and biases.shape.length() ≡ 2 throw variant BadShape { message = "scales and biases must be rank-2" }

    let int s_rows ← scales.shape.get(0) coalesce 0
    let int group_cols ← scales.shape.get(1) coalesce 0
    let int b_rows ← biases.shape.get(0) coalesce 0
    let int b_cols ← biases.shape.get(1) coalesce 0
    require (s_rows ≡ raw_out or s_rows ≡ out_features) and b_rows ≡ s_rows and b_cols ≡ group_cols and group_cols ≥ 1 throw variant BadShape { message = "scales/biases shape mismatch against weight" }
    require scales.raw_dtype ≡ biases.raw_dtype and (scales.raw_dtype ≡ "F32" or scales.raw_dtype ≡ "BF16" or scales.raw_dtype ≡ "F16") throw variant UnsupportedFormat { message = "GroupAffine scales/biases dtype must match and be F32, BF16, or F16, got §/§"(scales.raw_dtype, biases.raw_dtype) }

    mut int pack_width ← 32
    mut ga.PackKind pack ← variant ga.PackKind.PackU32
    mut LinearWeightKind kind ← variant LinearWeightKind.GroupAffineU32
    mut bool is_u8 ← false

    if weight.raw_dtype ≡ "U32" {
        pack_width ← 32
        pack ← variant ga.PackKind.PackU32
        kind ← variant LinearWeightKind.GroupAffineU32
        is_u8 ← false
    }
    elif weight.raw_dtype ≡ "U8" {
        pack_width ← 8
        pack ← variant ga.PackKind.PackU8
        kind ← variant LinearWeightKind.GroupAffineU8
        is_u8 ← true
    }
    else {
        throw variant UnsupportedFormat { message = "GroupAffine weight dtype must be U32 or U8, got §"(weight.raw_dtype) }
    }

    let int total_bits ← packed_cols * pack_width
    require total_bits % group_cols ≡ 0 throw variant BadShape { message = "packed GroupAffine bit width not divisible by group_cols" }

    let int bits_per_group ← total_bits / group_cols
    let AffineGeom geom ← resolve_affine_geom(bits_per_group, is_u8, hint)
    let int in_features ← group_cols * geom.group_size
    let ga.ScaleDtype sd ← group_affine_scale_dtype(scales.raw_dtype)
    let ga.GroupAffineSpec spec ← ga.admit_spec_with_scale(out_features, in_features, geom.bits, geom.group_size, pack, sd)
    return LinearWeight { kind = kind, out_features = spec.out_features, in_features = spec.in_features, bits = spec.bits, group_size = spec.group_size, packed_cols = spec.packed_cols, group_cols = spec.group_cols, has_bias = has_bias, scales_dtype = scales.raw_dtype }
}

fn bind_dual_scaled_fp4(td.DirectoryEntry weight, td.DirectoryEntry scales, td.DirectoryEntry ∪ none maybe_global, td.DirectoryEntry ∪ none maybe_amax, td.DirectoryEntry ∪ none maybe_denom, bool has_bias) → LinearWeight ⇥ LinearWeightError {
    let int raw_out ← weight.shape.get(0) coalesce 0
    let int out_features ← apply_row_prefix_view(raw_out, weight.view)
    let int packed_cols ← weight.shape.get(1) coalesce 0
    require scales.shape.length() ≡ 2 throw variant BadShape { message = "DualScaledFp4 scales must be rank-2" }

    let int s_rows ← scales.shape.get(0) coalesce 0
    let int group_cols ← scales.shape.get(1) coalesce 0
    require (s_rows ≡ raw_out or s_rows ≡ out_features) and group_cols ≥ 1 throw variant BadShape { message = "DualScaledFp4 scales shape mismatch against weight" }

    mut bool is_modelopt ← false
    if maybe_global is td.DirectoryEntry {
        require is_scalar_entry(maybe_global) throw variant BadShape { message = "DualScaledFp4 global_scale must be scalar" }
        is_modelopt ← false
    }
    elif maybe_amax is td.DirectoryEntry and maybe_denom is td.DirectoryEntry {
        require is_scalar_entry(maybe_amax) and is_scalar_entry(maybe_denom) throw variant BadShape { message = "ModelOpt DualScaledFp4 amax and outer_scale_denominator must be scalar" }
        is_modelopt ← true
    }
    else {
        throw variant BadBinding { message = "DualScaledFp4 requires global_scale or ModelOpt amax + outer_scale_denominator" }
    }

    mut fp4.PackKind pack ← variant fp4.PackKind.PackU8
    mut LinearWeightKind kind ← variant LinearWeightKind.DualScaledFp4U8
    mut int in_features ← packed_cols * 2

    if weight.raw_dtype ≡ "U8" {
        pack ← variant fp4.PackKind.PackU8
        kind ← variant LinearWeightKind.DualScaledFp4U8
        in_features ← packed_cols * 2
    }
    elif weight.raw_dtype ≡ "U32" {
        pack ← variant fp4.PackKind.PackU32
        kind ← variant LinearWeightKind.DualScaledFp4U32
        in_features ← packed_cols * 8
    }
    else {
        throw variant UnsupportedFormat { message = "DualScaledFp4 weight dtype must be U8 or U32, got §"(weight.raw_dtype) }
    }

    require in_features % group_cols ≡ 0 throw variant BadShape { message = "DualScaledFp4 in_features not divisible by scale group_cols" }
    let int group_size ← in_features / group_cols
    let fp4.DualScaledFp4Spec spec ← fp4.admit_spec(out_features, in_features, group_size, pack)
    return LinearWeight { kind = kind, out_features = spec.out_features, in_features = spec.in_features, bits = 4, group_size = spec.group_size, packed_cols = spec.packed_cols, group_cols = spec.group_cols, has_bias = has_bias, scales_dtype = scales.raw_dtype, is_modelopt = is_modelopt }
}

fn is_fp8_weight_dtype(string raw_dtype) → bool {
    return raw_dtype ≡ "F8_E4M3" or raw_dtype ≡ "FP8_E4M3" or raw_dtype ≡ "E4M3"
}

fn bind_block_fp8(td.DirectoryEntry weight, td.DirectoryEntry ∪ none maybe_scales, bool has_bias) → LinearWeight ⇥ LinearWeightError {
    let int raw_out ← weight.shape.get(0) coalesce 0
    let int out_features ← apply_row_prefix_view(raw_out, weight.view)
    let int packed_cols ← weight.shape.get(1) coalesce 0

    mut bf8.PackKind pack ← variant bf8.PackKind.PackU8
    mut LinearWeightKind kind ← variant LinearWeightKind.BlockFp8U8
    mut int in_features ← packed_cols

    if is_fp8_weight_dtype(weight.raw_dtype) or weight.raw_dtype ≡ "U8" {
        pack ← variant bf8.PackKind.PackU8
        kind ← variant LinearWeightKind.BlockFp8U8
        in_features ← packed_cols
    }
    elif weight.raw_dtype ≡ "U32" {
        pack ← variant bf8.PackKind.PackU32
        kind ← variant LinearWeightKind.BlockFp8U32
        in_features ← packed_cols * 4
    }
    else {
        throw variant UnsupportedFormat { message = "BlockFp8 weight dtype must be F8_E4M3, U8, or U32, got §"(weight.raw_dtype) }
    }

    if maybe_scales is td.DirectoryEntry {
        require maybe_scales.shape.length() ≡ 2 throw variant BadShape { message = "BlockFp8 scales must be rank-2" }
        let int scale_rows ← maybe_scales.shape.get(0) coalesce 0
        let int scale_cols ← maybe_scales.shape.get(1) coalesce 0
        require scale_rows ≥ 1 and scale_cols ≥ 1 throw variant BadShape { message = "BlockFp8 scales must have positive extents" }
        require maybe_scales.raw_dtype ≡ "U8" or maybe_scales.raw_dtype ≡ "F32" throw variant UnsupportedFormat { message = "BlockFp8 scales dtype must be U8 or F32, got §"(maybe_scales.raw_dtype) }

        mut int row_span ← raw_out
        if raw_out % scale_rows ≡ 0 {
            row_span ← raw_out
        }
        elif out_features % scale_rows ≡ 0 {
            row_span ← out_features
        }
        require row_span % scale_rows ≡ 0 throw variant BadShape { message = "BlockFp8 weight rows not divisible by scale_rows" }
        let int block_rows ← row_span / scale_rows
        require out_features % block_rows ≡ 0 throw variant BadShape { message = "BlockFp8 RowPrefix out_features must be divisible by block_rows" }
        require in_features % scale_cols ≡ 0 throw variant BadShape { message = "BlockFp8 in_features not divisible by scale_cols" }
        let int block_cols ← in_features / scale_cols
        let bf8.BlockFp8Spec spec ← bf8.admit_spec(out_features, in_features, block_rows, block_cols, pack)
        return LinearWeight { kind = kind, out_features = spec.out_features, in_features = spec.in_features, bits = 8, group_size = spec.block_cols, packed_cols = spec.packed_cols, group_cols = spec.scale_cols, has_bias = has_bias, block_rows = spec.block_rows, block_cols = spec.block_cols, scales_dtype = maybe_scales.raw_dtype }
    }

    require is_fp8_weight_dtype(weight.raw_dtype) throw variant BadBinding { message = "BlockFp8 U8/U32 storage requires a scales tensor" }
    let bf8.BlockFp8Spec spec ← bf8.admit_spec(out_features, in_features, out_features, in_features, pack)
    return LinearWeight { kind = kind, out_features = spec.out_features, in_features = spec.in_features, bits = 8, group_size = spec.block_cols, packed_cols = spec.packed_cols, group_cols = spec.scale_cols, has_bias = has_bias, block_rows = spec.block_rows, block_cols = spec.block_cols, scales_dtype = "NONE" }
}

fn resolve_scales_sibling(td.TensorDirectory dir, bundle.MemberRole role, string module_prefix, td.DirectoryEntry ∪ none sib_scales) → td.DirectoryEntry ∪ none ⇥ LinearWeightError {
    if sib_scales is td.DirectoryEntry {
        return sib_scales
    }
    if td.has_tensor(dir, role, "§.weight_scale_inv"(module_prefix)) {
        return td.lookup(dir, role, "§.weight_scale_inv"(module_prefix))
    }
    return null
}

@ public
fn bind_with_config(td.TensorDirectory dir, bundle.MemberRole role, string module_prefix, QuantConfigHint hint) → LinearWeight ⇥ LinearWeightError {
    let td.SiblingSet sib ← td.siblings(dir, role, module_prefix)
    let td.DirectoryEntry weight ← sib.weight

    require weight.shape.length() ≡ 2 throw variant BadShape { message = "weight shape must be rank-2" }

    let int dim0 ← weight.shape.get(0) coalesce 0
    let int dim1 ← weight.shape.get(1) coalesce 0
    require dim0 ≥ 1 and dim1 ≥ 1 throw variant BadShape { message = "weight shape must have positive extents" }

    let bool has_bias ← td.has_tensor(dir, role, "§.bias"(module_prefix))
    let td.DirectoryEntry ∪ none maybe_scales ← resolve_scales_sibling(dir, role, module_prefix, sib.scales)
    let td.DirectoryEntry ∪ none maybe_biases ← sib.biases
    let td.DirectoryEntry ∪ none maybe_global ← sib.global_scale
    let td.DirectoryEntry ∪ none maybe_amax ← sib.amax
    let td.DirectoryEntry ∪ none maybe_denom ← sib.outer_scale_denominator

    # 1. DualScaledFp4: .weight + .scales + (.global_scale | .amax + .outer_scale_denominator)
    if maybe_scales is td.DirectoryEntry and (maybe_global is td.DirectoryEntry or (maybe_amax is td.DirectoryEntry and maybe_denom is td.DirectoryEntry)) {
        return bind_dual_scaled_fp4(weight, maybe_scales, maybe_global, maybe_amax, maybe_denom, has_bias)
    }

    # 2. GroupAffine: .weight + .scales + .biases (overrides stale config mode)
    if maybe_scales is td.DirectoryEntry and maybe_biases is td.DirectoryEntry {
        return bind_group_affine(weight, maybe_scales, maybe_biases, has_bias, hint)
    }

    # 3. BlockFp8: F8_E4M3 / FP8_E4M3 / E4M3 or U8 / U32 with scales-only sibling
    if is_fp8_weight_dtype(weight.raw_dtype) or ((weight.raw_dtype ≡ "U8" or weight.raw_dtype ≡ "U32") and maybe_scales is td.DirectoryEntry) {
        return bind_block_fp8(weight, maybe_scales, has_bias)
    }

    # GGUF stores 2D weights in ne order [ne0 = in_features, ne1 = out_features],
    # whereas Safetensors stores PyTorch [out_features, in_features] order.
    mut int raw_out ← dim0
    mut int in_features ← dim1
    match weight.container {
        case bundle.ContainerKind.Gguf {
            in_features ← dim0
            raw_out ← dim1
        }
        case bundle.ContainerKind.Safetensors {}
    }
    let int out_features ← apply_row_prefix_view(raw_out, weight.view)

    # 4. GgmlBlock: single GGML block tensor
    if is_ggml_block_dtype(weight.raw_dtype) {
        let LinearWeightKind kind ← ggml_kind_for(weight.raw_dtype)
        let int block_elems ← ggml_block_elements(kind)
        require in_features % block_elems ≡ 0 throw variant BadShape { message = "GGML weight in_features must be divisible by block element count" }
        return LinearWeight { kind = kind, out_features = out_features, in_features = in_features, bits = 0, group_size = 0, packed_cols = 0, group_cols = 0, has_bias = has_bias }
    }

    # 5. Dense: .weight [+ .bias]
    let LinearWeightKind kind ← dense_kind_for(weight.raw_dtype)
    return LinearWeight { kind = kind, out_features = out_features, in_features = in_features, bits = 0, group_size = 0, packed_cols = 0, group_cols = 0, has_bias = has_bias }
}

@ public
fn bind(td.TensorDirectory dir, bundle.MemberRole role, string module_prefix) → LinearWeight ⇥ LinearWeightError {
    return bind_with_config(dir, role, module_prefix, default_hint())
}

@ public
fn to_group_affine_spec(LinearWeight lw) → ga.GroupAffineSpec ⇥ LinearWeightError {
    let ga.ScaleDtype sd ← group_affine_scale_dtype(lw.scales_dtype)
    match lw.kind {
        case LinearWeightKind.GroupAffineU32 {
            return ga.admit_spec_with_scale(lw.out_features, lw.in_features, lw.bits, lw.group_size, variant ga.PackKind.PackU32, sd)
        }
        case LinearWeightKind.GroupAffineU8 {
            return ga.admit_spec_with_scale(lw.out_features, lw.in_features, lw.bits, lw.group_size, variant ga.PackKind.PackU8, sd)
        }
        default {
            throw variant UnsupportedFormat { message = "LinearWeight is not GroupAffine" }
        }
    }
}

@ public
fn to_block_fp8_spec(LinearWeight lw) → bf8.BlockFp8Spec ⇥ LinearWeightError {
    match lw.kind {
        case LinearWeightKind.BlockFp8U8 {
            return bf8.admit_spec(lw.out_features, lw.in_features, lw.block_rows, lw.block_cols, variant bf8.PackKind.PackU8)
        }
        case LinearWeightKind.BlockFp8U32 {
            return bf8.admit_spec(lw.out_features, lw.in_features, lw.block_rows, lw.block_cols, variant bf8.PackKind.PackU32)
        }
        default {
            throw variant UnsupportedFormat { message = "LinearWeight is not BlockFp8" }
        }
    }
}

@ public
fn to_dual_scaled_fp4_spec(LinearWeight lw) → fp4.DualScaledFp4Spec ⇥ LinearWeightError {
    match lw.kind {
        case LinearWeightKind.DualScaledFp4U8 {
            return fp4.admit_spec(lw.out_features, lw.in_features, lw.group_size, variant fp4.PackKind.PackU8)
        }
        case LinearWeightKind.DualScaledFp4U32 {
            return fp4.admit_spec(lw.out_features, lw.in_features, lw.group_size, variant fp4.PackKind.PackU32)
        }
        default {
            throw variant UnsupportedFormat { message = "LinearWeight is not DualScaledFp4" }
        }
    }
}

# -------------------------------------------------------------------------
# Host-side linear_matvec dispatch (without expanding weights to F32)
# -------------------------------------------------------------------------

fn apply_optional_bias(mut list<f32> y, list<f32> bias, int out_features) → void ⇥ LinearWeightError {
    if bias.length() ≻ 0 {
        require bias.length() ≡ out_features throw variant BadShape { message = "bias length mismatch" }
        for exclusive out_features let r {
            y[r] ← y[r] + bias[r]
        }
    }
}

@ public
fn linear_matvec_dense(int out_features, int in_features, list<f32> w_dense, list<f32> bias, list<f32> x) → list<f32> ⇥ LinearWeightError {
    require w_dense.length() ≡ out_features * in_features throw variant BadShape { message = "dense weight length mismatch" }
    require x.length() ≡ in_features throw variant BadShape { message = "input vector length mismatch" }

    mut list<f32> y ← empty

    for exclusive out_features let r {
        mut f32 acc ← 0.0 ∷ f32
        let int base ← r * in_features

        for exclusive in_features let j {
            acc ← acc + w_dense[base + j] * x[j]
        }

        y.append(acc)
    }

    apply_optional_bias(mut y, bias, out_features)
    return y
}

fn unpack_u32_at(list<u32> weight, int w_base, int j, int bits) → int {
    let int bit_pos ← j * bits
    let int word_idx ← bit_pos / 32
    let int shift ← bit_pos % 32
    let int w0 ← weight[w_base + word_idx] ↦ int

    if bits ≡ 8 {
        return (w0 ⇒ shift) % 256
    }

    if bits ≡ 4 {
        return (w0 ⇒ shift) % 16
    }

    if shift ≤ 26 {
        return (w0 ⇒ shift) % 64
    }

    let int w1 ← weight[w_base + word_idx + 1] ↦ int
    let int lo ← w0 ⇒ shift
    let int hi ← w1 ⇐ (32 - shift)
    return (lo ∨ hi) % 64
}

fn unpack_u8_at(list<u8> weight, int w_base, int j, int bits) → int {
    if bits ≡ 8 {
        return weight[w_base + j] ↦ int
    }

    let int b ← weight[w_base + j / 2] ↦ int
    let int shift ← (j % 2) * 4
    return (b ⇒ shift) % 16
}

@ public
fn linear_matvec_group_affine_u32(ga.GroupAffineSpec spec, list<u32> weight, list<f32> scales, list<f32> biases, list<f32> bias, list<f32> x) → list<f32> ⇥ LinearWeightError {
    match spec.pack {
        case ga.PackKind.PackU32 {}
        default {
            throw variant BadBinding { message = "expected PackU32 spec" }
        }
    }

    require weight.length() ≡ spec.out_features * spec.packed_cols throw variant BadShape { message = "weight length mismatch" }
    require scales.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "scales length mismatch" }
    require biases.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "biases length mismatch" }
    require x.length() ≡ spec.in_features throw variant BadShape { message = "input vector length mismatch" }

    mut list<f32> y ← empty

    for exclusive spec.out_features let r {
        let int w_base ← r * spec.packed_cols
        let int g_base ← r * spec.group_cols
        mut f32 acc ← 0.0 ∷ f32

        for exclusive spec.in_features let j {
            let int q ← unpack_u32_at(weight, w_base, j, spec.bits)
            let int g ← j / spec.group_size
            let f32 w ← (q ↦ f32) * scales[g_base + g] + biases[g_base + g]
            acc ← acc + w * x[j]
        }

        y.append(acc)
    }

    apply_optional_bias(mut y, bias, spec.out_features)
    return y
}

@ public
fn linear_matvec_group_affine_u8(ga.GroupAffineSpec spec, list<u8> weight, list<f32> scales, list<f32> biases, list<f32> bias, list<f32> x) → list<f32> ⇥ LinearWeightError {
    match spec.pack {
        case ga.PackKind.PackU8 {}
        default {
            throw variant BadBinding { message = "expected PackU8 spec" }
        }
    }

    require weight.length() ≡ spec.out_features * spec.packed_cols throw variant BadShape { message = "weight length mismatch" }
    require scales.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "scales length mismatch" }
    require biases.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "biases length mismatch" }
    require x.length() ≡ spec.in_features throw variant BadShape { message = "input vector length mismatch" }

    mut list<f32> y ← empty

    for exclusive spec.out_features let r {
        let int w_base ← r * spec.packed_cols
        let int g_base ← r * spec.group_cols
        mut f32 acc ← 0.0 ∷ f32

        for exclusive spec.in_features let j {
            let int q ← unpack_u8_at(weight, w_base, j, spec.bits)
            let int g ← j / spec.group_size
            let f32 w ← (q ↦ f32) * scales[g_base + g] + biases[g_base + g]
            acc ← acc + w * x[j]
        }

        y.append(acc)
    }

    apply_optional_bias(mut y, bias, spec.out_features)
    return y
}

fn ggml_representation(LinearWeightKind kind) → storage.Representation ⇥ LinearWeightError {
    match kind {
        case LinearWeightKind.GgmlBlockQ8_0 {
            return storage.ggml_representation(8)
        }
        case LinearWeightKind.GgmlBlockQ4_1 {
            return storage.ggml_representation(3)
        }
        case LinearWeightKind.GgmlBlockQ5_0 {
            return storage.ggml_representation(6)
        }
        case LinearWeightKind.GgmlBlockIQ4_NL {
            return storage.ggml_representation(20)
        }
        case LinearWeightKind.GgmlBlockQ4_K {
            return storage.ggml_representation(12)
        }
        case LinearWeightKind.GgmlBlockQ5_K {
            return storage.ggml_representation(13)
        }
        case LinearWeightKind.GgmlBlockQ6_K {
            return storage.ggml_representation(14)
        }
        default {
            throw variant UnsupportedFormat { message = "not a GGML block kind" }
        }
    }
}

fn decode_ggml_block_f32(LinearWeightKind kind, list<u8> block_bytes_list) → list<f32> ⇥ LinearWeightError {
    let storage.Representation rep ← ggml_representation(kind)
    return dequant.decode_block_u8(rep, block_bytes_list)
}

@ public
fn linear_matvec_ggml_block(LinearWeight lw, list<u8> raw_blocks, list<f32> bias, list<f32> x) → list<f32> ⇥ LinearWeightError {
    let int out_features ← lw.out_features
    let int in_features ← lw.in_features
    let int block_elements ← ggml_block_elements(lw.kind)
    let int block_bytes ← ggml_block_bytes(lw.kind)
    let int total_blocks ← in_features / block_elements
    let int expected_bytes ← out_features * total_blocks * block_bytes

    require raw_blocks.length() ≡ expected_bytes throw variant BadShape { message = "raw block byte length mismatch" }
    require x.length() ≡ in_features throw variant BadShape { message = "input vector length mismatch" }

    mut list<f32> y ← empty

    for exclusive out_features let r {
        mut f32 acc ← 0.0 ∷ f32

        for exclusive total_blocks let b {
            let int base ← (r * total_blocks + b) * block_bytes
            mut list<u8> block_slice ← empty
            for exclusive block_bytes let bi {
                block_slice.append(raw_blocks[base + bi])
            }
            let list<f32> block_weights ← decode_ggml_block_f32(lw.kind, block_slice)
            let int x_base ← b * block_elements

            for exclusive block_elements let k {
                acc ← acc + block_weights[k] * x[x_base + k]
            }
        }

        y.append(acc)
    }

    apply_optional_bias(mut y, bias, out_features)
    return y
}

@ public
fn linear_matvec(LinearWeight lw, WeightPayload payload, list<f32> x) → list<f32> ⇥ LinearWeightError {
    match payload {
        case DensePayload let weight, bias {
            match lw.kind {
                case DenseF32 {}
                case DenseBf16 {}
                case DenseF16 {}
                default {
                    throw variant BadBinding { message = "LinearWeight kind does not match DensePayload" }
                }
            }
            if lw.has_bias {
                require bias.length() ≻ 0 throw variant BadBinding { message = "LinearWeight requires bias" }
            }
            return linear_matvec_dense(lw.out_features, lw.in_features, weight, bias, x)
        }
        case GroupAffineU32Payload let weight, scales, biases, bias {
            let ga.GroupAffineSpec spec ← to_group_affine_spec(lw)
            if lw.has_bias {
                require bias.length() ≻ 0 throw variant BadBinding { message = "LinearWeight requires bias" }
            }
            return linear_matvec_group_affine_u32(spec, weight, scales, biases, bias, x)
        }
        case GroupAffineU8Payload let weight, scales, biases, bias {
            let ga.GroupAffineSpec spec ← to_group_affine_spec(lw)
            if lw.has_bias {
                require bias.length() ≻ 0 throw variant BadBinding { message = "LinearWeight requires bias" }
            }
            return linear_matvec_group_affine_u8(spec, weight, scales, biases, bias, x)
        }
        case GroupAffineU32Bf16Payload let weight, scales, biases, bias {
            let ga.GroupAffineSpec spec ← to_group_affine_spec(lw)
            if lw.has_bias {
                require bias.length() ≻ 0 throw variant BadBinding { message = "LinearWeight requires bias" }
            }
            let list<f32> w_dense ← ga.ref_dequantize_u32_bf16(spec, weight, scales, biases)
            mut list<f32> y ← ga.ref_matvec(spec.out_features, spec.in_features, w_dense, x)
            apply_optional_bias(mut y, bias, spec.out_features)
            return y
        }
        case GroupAffineU8Bf16Payload let weight, scales, biases, bias {
            let ga.GroupAffineSpec spec ← to_group_affine_spec(lw)
            if lw.has_bias {
                require bias.length() ≻ 0 throw variant BadBinding { message = "LinearWeight requires bias" }
            }
            let list<f32> w_dense ← ga.ref_dequantize_u8_bf16(spec, weight, scales, biases)
            mut list<f32> y ← ga.ref_matvec(spec.out_features, spec.in_features, w_dense, x)
            apply_optional_bias(mut y, bias, spec.out_features)
            return y
        }
        case GroupAffineU32F16Payload let weight, scales, biases, bias {
            let ga.GroupAffineSpec spec ← to_group_affine_spec(lw)
            if lw.has_bias {
                require bias.length() ≻ 0 throw variant BadBinding { message = "LinearWeight requires bias" }
            }
            let list<f32> w_dense ← ga.ref_dequantize_u32_f16(spec, weight, scales, biases)
            mut list<f32> y ← ga.ref_matvec(spec.out_features, spec.in_features, w_dense, x)
            apply_optional_bias(mut y, bias, spec.out_features)
            return y
        }
        case GroupAffineU8F16Payload let weight, scales, biases, bias {
            let ga.GroupAffineSpec spec ← to_group_affine_spec(lw)
            if lw.has_bias {
                require bias.length() ≻ 0 throw variant BadBinding { message = "LinearWeight requires bias" }
            }
            let list<f32> w_dense ← ga.ref_dequantize_u8_f16(spec, weight, scales, biases)
            mut list<f32> y ← ga.ref_matvec(spec.out_features, spec.in_features, w_dense, x)
            apply_optional_bias(mut y, bias, spec.out_features)
            return y
        }
        case BlockFp8U8Payload let weight, scales, f32_scales, bias {
            let bf8.BlockFp8Spec spec ← to_block_fp8_spec(lw)
            if lw.has_bias {
                require bias.length() ≻ 0 throw variant BadBinding { message = "LinearWeight requires bias" }
            }
            mut list<f32> w_dense ← empty
            if lw.scales_dtype ≡ "NONE" {
                w_dense ← bf8.ref_dequantize_u8_unscaled(spec.out_features, spec.in_features, weight)
            }
            elif lw.scales_dtype ≡ "F32" {
                w_dense ← bf8.ref_dequantize_u8_f32(spec, weight, f32_scales)
            }
            else {
                w_dense ← bf8.ref_dequantize_u8(spec, weight, scales)
            }
            mut list<f32> y ← bf8.ref_matvec(spec.out_features, spec.in_features, w_dense, x)
            apply_optional_bias(mut y, bias, spec.out_features)
            return y
        }
        case BlockFp8U32Payload let weight, scales, f32_scales, bias {
            let bf8.BlockFp8Spec spec ← to_block_fp8_spec(lw)
            if lw.has_bias {
                require bias.length() ≻ 0 throw variant BadBinding { message = "LinearWeight requires bias" }
            }
            mut list<f32> w_dense ← empty
            if lw.scales_dtype ≡ "F32" {
                w_dense ← bf8.ref_dequantize_u32_f32(spec, weight, f32_scales)
            }
            else {
                w_dense ← bf8.ref_dequantize_u32(spec, weight, scales)
            }
            mut list<f32> y ← bf8.ref_matvec(spec.out_features, spec.in_features, w_dense, x)
            apply_optional_bias(mut y, bias, spec.out_features)
            return y
        }
        case DualScaledFp4U8Payload let weight, scales, global_scale, bias {
            let fp4.DualScaledFp4Spec spec ← to_dual_scaled_fp4_spec(lw)
            if lw.has_bias {
                require bias.length() ≻ 0 throw variant BadBinding { message = "LinearWeight requires bias" }
            }
            let list<f32> w_dense ← fp4.ref_dequantize_u8(spec, weight, scales, global_scale)
            mut list<f32> y ← fp4.ref_matvec(spec.out_features, spec.in_features, w_dense, x)
            apply_optional_bias(mut y, bias, spec.out_features)
            return y
        }
        case DualScaledFp4U32Payload let weight, scales, global_scale, bias {
            let fp4.DualScaledFp4Spec spec ← to_dual_scaled_fp4_spec(lw)
            if lw.has_bias {
                require bias.length() ≻ 0 throw variant BadBinding { message = "LinearWeight requires bias" }
            }
            let list<f32> w_dense ← fp4.ref_dequantize_u32(spec, weight, scales, global_scale)
            mut list<f32> y ← fp4.ref_matvec(spec.out_features, spec.in_features, w_dense, x)
            apply_optional_bias(mut y, bias, spec.out_features)
            return y
        }
        case GgmlBlockPayload let raw_blocks, bias {
            if lw.has_bias {
                require bias.length() ≻ 0 throw variant BadBinding { message = "LinearWeight requires bias" }
            }
            return linear_matvec_ggml_block(lw, raw_blocks, bias, x)
        }
    }
}

# -------------------------------------------------------------------------
# Device @ kernel contractions & host dispatchers (CPU + Metal)
# -------------------------------------------------------------------------

@ public
kernel add_bias<size Out>(tensor<f32, [Out]> bias, mut tensor<f32, [Out]> y) → void {
    for from y at [row] thread lane let e {
        y[[row]] ← e + bias[[row]]
    }
}

@ public
kernel ggml_q8_0_matvec<size Out, size Blocks, size RowBytes, size In>(tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void {
    for from y at [row] thread lane let e {
        let i32 row_block_limit ← RowBytes / 34
        let i32 in_block_limit ← In / 32
        mut f32 acc ← 0.0 ∷ f32

        for exclusive Blocks let b {
            if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                let i32 base ← b * 34
                let i32 lo ← (raw_blocks[[row, base]] ↦ i32 ⊥ 0) ∧ 255
                let i32 hi ← (raw_blocks[[row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                let f32 d ← ((((lo + hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                let i32 x_base ← b * 32
                for exclusive 32 let k {
                    let i32 q_u ← (raw_blocks[[row, base + 2 + k]] ↦ i32 ⊥ 0)
                    mut i32 q_s ← q_u
                    if q_u ≥ 128 {
                        q_s ← q_u - 256
                    }
                    let f32 w ← (q_s ↦ f32) * d
                    acc ← acc + w * x[[x_base + k]]
                }
            }
        }

        y[[row]] ← acc
    }
}

@ public
fn dispatch_add_bias<size Out>(LinearWeight lw, tensor<f32, [Out]> bias, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    require lw.has_bias throw variant BadBinding { message = "LinearWeight does not have bias" }
    require lw.out_features ≡ Out throw variant BadShape { message = "bias shape mismatch in dispatch_add_bias" }
    add_bias<size Out>(bias, mut y)
}

@ public
fn dispatch_dense_f32<size Out, size In>(LinearWeight lw, tensor<f32, [Out, In]> weight, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case DenseF32 {}
        default {
            throw variant BadBinding { message = "expected DenseF32 LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In throw variant BadShape { message = "shape mismatch in dispatch_dense_f32" }

    ds.gemv<size Out, size In>(weight, x, mut y)
}

@ public
fn dispatch_dense_bf16<size Out, size In>(LinearWeight lw, tensor<bf16, [Out, In]> weight, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case DenseBf16 {}
        default {
            throw variant BadBinding { message = "expected DenseBf16 LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In throw variant BadShape { message = "shape mismatch in dispatch_dense_bf16" }

    kern.gemv_bf16_f32acc<size Out, size In>(weight, x, mut y)
}

@ public
fn dispatch_group_affine_u32<size Out, size PackedIn, size Groups, size In>(LinearWeight lw, tensor<u32, [Out, PackedIn]> weight, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case GroupAffineU32 {}
        default {
            throw variant BadBinding { message = "expected GroupAffineU32 LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In and lw.packed_cols ≡ PackedIn and lw.group_cols ≡ Groups throw variant BadShape { message = "shape mismatch in dispatch_group_affine_u32" }

    ga.linear_matvec_u32<size Out, size PackedIn, size Groups, size In>(weight, scales, biases, x, mut y, lw.bits ↦ i32 ⊥ 8, lw.group_size ↦ i32 ⊥ 64)
}

@ public
fn dispatch_group_affine_u8<size Out, size PackedIn, size Groups, size In>(LinearWeight lw, tensor<u8, [Out, PackedIn]> weight, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case GroupAffineU8 {}
        default {
            throw variant BadBinding { message = "expected GroupAffineU8 LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In and lw.packed_cols ≡ PackedIn and lw.group_cols ≡ Groups throw variant BadShape { message = "shape mismatch in dispatch_group_affine_u8" }

    ga.linear_matvec_u8<size Out, size PackedIn, size Groups, size In>(weight, scales, biases, x, mut y, lw.bits ↦ i32 ⊥ 4, lw.group_size ↦ i32 ⊥ 64)
}

@ public
fn dispatch_group_affine_u32_bf16<size Out, size PackedIn, size Groups, size In>(LinearWeight lw, tensor<u32, [Out, PackedIn]> weight, tensor<bf16, [Out, Groups]> scales, tensor<bf16, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case GroupAffineU32 {}
        default {
            throw variant BadBinding { message = "expected GroupAffineU32 LinearWeight" }
        }
    }
    require lw.scales_dtype ≡ "BF16" throw variant BadBinding { message = "expected BF16 scales_dtype in dispatch_group_affine_u32_bf16" }
    require lw.out_features ≡ Out and lw.in_features ≡ In and lw.packed_cols ≡ PackedIn and lw.group_cols ≡ Groups throw variant BadShape { message = "shape mismatch in dispatch_group_affine_u32_bf16" }

    ga.linear_matvec_u32_bf16<size Out, size PackedIn, size Groups, size In>(weight, scales, biases, x, mut y, lw.bits ↦ i32 ⊥ 8, lw.group_size ↦ i32 ⊥ 64)
}

@ public
fn dispatch_group_affine_u8_bf16<size Out, size PackedIn, size Groups, size In>(LinearWeight lw, tensor<u8, [Out, PackedIn]> weight, tensor<bf16, [Out, Groups]> scales, tensor<bf16, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case GroupAffineU8 {}
        default {
            throw variant BadBinding { message = "expected GroupAffineU8 LinearWeight" }
        }
    }
    require lw.scales_dtype ≡ "BF16" throw variant BadBinding { message = "expected BF16 scales_dtype in dispatch_group_affine_u8_bf16" }
    require lw.out_features ≡ Out and lw.in_features ≡ In and lw.packed_cols ≡ PackedIn and lw.group_cols ≡ Groups throw variant BadShape { message = "shape mismatch in dispatch_group_affine_u8_bf16" }

    ga.linear_matvec_u8_bf16<size Out, size PackedIn, size Groups, size In>(weight, scales, biases, x, mut y, lw.bits ↦ i32 ⊥ 4, lw.group_size ↦ i32 ⊥ 64)
}

