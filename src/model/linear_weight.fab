# -------------------------------------------------------------------------
# Remaining B=1 device GEMV kernels & dispatchers
# -------------------------------------------------------------------------

@ public
kernel dense_f16_matvec<size Out, size In>(tensor<f16, [Out, In]> weight, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void {
    for from y at [row] thread lane let e {
        let i32 in_dim ← In ↦ i32
        mut f32 acc ← 0.0 ∷ f32
        if in_dim ≥ 1 and in_dim ≤ 16777216 {
            mut i32 j ← 0
            while j ≺ in_dim {
                acc ← acc + (weight[[row, j]] ↦ f32) * x[[j]]
                j ← j + 1
            }
        }
        y[[row]] ← acc
    }
}

@ public
fn dispatch_dense_f16<size Out, size In>(LinearWeight lw, tensor<f16, [Out, In]> weight, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case DenseF16 {}
        default {
            throw variant BadBinding { message = "expected DenseF16 LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In throw variant BadShape { message = "shape mismatch in dispatch_dense_f16" }

    dense_f16_matvec<size Out, size In>(weight, x, mut y)
}

@ public
kernel ggml_q4_1_matvec<size Out, size Blocks, size RowBytes, size In>(tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void {
    for from y at [row] thread lane let e {
        let i32 row_block_limit ← RowBytes / 20
        let i32 in_block_limit ← In / 32
        mut f32 acc ← 0.0 ∷ f32

        for exclusive Blocks let b {
            if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                let i32 base ← b * 20

                let i32 d_lo ← (raw_blocks[[row, base]] ↦ i32 ⊥ 0) ∧ 255
                let i32 d_hi ← (raw_blocks[[row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                let f32 d ← ((((d_lo + d_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                let i32 m_lo ← (raw_blocks[[row, base + 2]] ↦ i32 ⊥ 0) ∧ 255
                let i32 m_hi ← (raw_blocks[[row, base + 3]] ↦ i32 ⊥ 0) ∧ 255
                let f32 m ← ((((m_lo + m_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                let i32 x_base ← b * 32
                for exclusive 16 let j {
                    let i32 qs ← (raw_blocks[[row, base + 4 + j]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 q0 ← qs ∧ 15
                    let i32 q1 ← (qs ⇒ 4) ∧ 15
                    let f32 w0 ← (q0 ↦ f32) * d + m
                    let f32 w1 ← (q1 ↦ f32) * d + m
                    acc ← acc + w0 * x[[x_base + j]] + w1 * x[[x_base + 16 + j]]
                }
            }
        }

        y[[row]] ← acc
    }
}

@ public
fn dispatch_ggml_q4_1<size Out, size Blocks, size RowBytes, size In>(LinearWeight lw, tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case GgmlBlockQ4_1 {}
        default {
            throw variant BadBinding { message = "expected GgmlBlockQ4_1 LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In and In ≡ Blocks * 32 and RowBytes ≡ Blocks * 20 throw variant BadShape { message = "shape mismatch in dispatch_ggml_q4_1" }

    ggml_q4_1_matvec<size Out, size Blocks, size RowBytes, size In>(raw_blocks, x, mut y)
}

@ public
kernel ggml_q5_0_matvec<size Out, size Blocks, size RowBytes, size In>(tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void {
    for from y at [row] thread lane let e {
        let i32 row_block_limit ← RowBytes / 22
        let i32 in_block_limit ← In / 32
        mut f32 acc ← 0.0 ∷ f32

        for exclusive Blocks let b {
            if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                let i32 base ← b * 22
                let i32 lo ← (raw_blocks[[row, base]] ↦ i32 ⊥ 0) ∧ 255
                let i32 hi ← (raw_blocks[[row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                let f32 d ← ((((lo + hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                let i32 x_base ← b * 32
                for exclusive 16 let j {
                    let i32 qh_lo_b ← (raw_blocks[[row, base + 2 + (j / 8)]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 qh_hi_b ← (raw_blocks[[row, base + 4 + (j / 8)]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 bit_pos ← j % 8
                    mut i32 qh_lo_sh ← qh_lo_b
                    mut i32 qh_hi_sh ← qh_hi_b
                    if bit_pos ≡ 1 {
                        qh_lo_sh ← qh_lo_b ⇒ 1
                        qh_hi_sh ← qh_hi_b ⇒ 1
                    }
                    elif bit_pos ≡ 2 {
                        qh_lo_sh ← qh_lo_b ⇒ 2
                        qh_hi_sh ← qh_hi_b ⇒ 2
                    }
                    elif bit_pos ≡ 3 {
                        qh_lo_sh ← qh_lo_b ⇒ 3
                        qh_hi_sh ← qh_hi_b ⇒ 3
                    }
                    elif bit_pos ≡ 4 {
                        qh_lo_sh ← qh_lo_b ⇒ 4
                        qh_hi_sh ← qh_hi_b ⇒ 4
                    }
                    elif bit_pos ≡ 5 {
                        qh_lo_sh ← qh_lo_b ⇒ 5
                        qh_hi_sh ← qh_hi_b ⇒ 5
                    }
                    elif bit_pos ≡ 6 {
                        qh_lo_sh ← qh_lo_b ⇒ 6
                        qh_hi_sh ← qh_hi_b ⇒ 6
                    }
                    elif bit_pos ≡ 7 {
                        qh_lo_sh ← qh_lo_b ⇒ 7
                        qh_hi_sh ← qh_hi_b ⇒ 7
                    }
                    let i32 xh_0 ← (qh_lo_sh ∧ 1) * 16
                    let i32 xh_1 ← (qh_hi_sh ∧ 1) * 16
                    let i32 qs ← (raw_blocks[[row, base + 6 + j]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 x0 ← ((qs ∧ 15) + xh_0) - 16
                    let i32 x1 ← (((qs ⇒ 4) ∧ 15) + xh_1) - 16
                    let f32 w0 ← (x0 ↦ f32) * d
                    let f32 w1 ← (x1 ↦ f32) * d
                    acc ← acc + w0 * x[[x_base + j]] + w1 * x[[x_base + 16 + j]]
                }
            }
        }

        y[[row]] ← acc
    }
}

@ public
fn dispatch_ggml_q5_0<size Out, size Blocks, size RowBytes, size In>(LinearWeight lw, tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case GgmlBlockQ5_0 {}
        default {
            throw variant BadBinding { message = "expected GgmlBlockQ5_0 LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In and In ≡ Blocks * 32 and RowBytes ≡ Blocks * 22 throw variant BadShape { message = "shape mismatch in dispatch_ggml_q5_0" }

    ggml_q5_0_matvec<size Out, size Blocks, size RowBytes, size In>(raw_blocks, x, mut y)
}

@ public
kernel ggml_iq4_nl_matvec<size Out, size Blocks, size RowBytes, size In>(tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void {
    for from y at [row] thread lane let e {
        let i32 row_block_limit ← RowBytes / 18
        let i32 in_block_limit ← In / 32
        mut f32 acc ← 0.0 ∷ f32

        for exclusive Blocks let b {
            if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                let i32 base ← b * 18
                let i32 lo ← (raw_blocks[[row, base]] ↦ i32 ⊥ 0) ∧ 255
                let i32 hi ← (raw_blocks[[row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                let f32 d ← ((((lo + hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                let i32 x_base ← b * 32
                for exclusive 16 let j {
                    let i32 qs ← (raw_blocks[[row, base + 2 + j]] ↦ i32 ⊥ 0) ∧ 255
                    let i32 q0 ← qs ∧ 15
                    let i32 q1 ← (qs ⇒ 4) ∧ 15

                    mut f32 kv0 ← 113.0 ∷ f32
                    if q0 ≡ 0 { kv0 ← -127.0 ∷ f32 }
                    elif q0 ≡ 1 { kv0 ← -104.0 ∷ f32 }
                    elif q0 ≡ 2 { kv0 ← -83.0 ∷ f32 }
                    elif q0 ≡ 3 { kv0 ← -65.0 ∷ f32 }
                    elif q0 ≡ 4 { kv0 ← -49.0 ∷ f32 }
                    elif q0 ≡ 5 { kv0 ← -35.0 ∷ f32 }
                    elif q0 ≡ 6 { kv0 ← -22.0 ∷ f32 }
                    elif q0 ≡ 7 { kv0 ← -10.0 ∷ f32 }
                    elif q0 ≡ 8 { kv0 ← 1.0 ∷ f32 }
                    elif q0 ≡ 9 { kv0 ← 13.0 ∷ f32 }
                    elif q0 ≡ 10 { kv0 ← 25.0 ∷ f32 }
                    elif q0 ≡ 11 { kv0 ← 38.0 ∷ f32 }
                    elif q0 ≡ 12 { kv0 ← 53.0 ∷ f32 }
                    elif q0 ≡ 13 { kv0 ← 69.0 ∷ f32 }
                    elif q0 ≡ 14 { kv0 ← 89.0 ∷ f32 }

                    mut f32 kv1 ← 113.0 ∷ f32
                    if q1 ≡ 0 { kv1 ← -127.0 ∷ f32 }
                    elif q1 ≡ 1 { kv1 ← -104.0 ∷ f32 }
                    elif q1 ≡ 2 { kv1 ← -83.0 ∷ f32 }
                    elif q1 ≡ 3 { kv1 ← -65.0 ∷ f32 }
                    elif q1 ≡ 4 { kv1 ← -49.0 ∷ f32 }
                    elif q1 ≡ 5 { kv1 ← -35.0 ∷ f32 }
                    elif q1 ≡ 6 { kv1 ← -22.0 ∷ f32 }
                    elif q1 ≡ 7 { kv1 ← -10.0 ∷ f32 }
                    elif q1 ≡ 8 { kv1 ← 1.0 ∷ f32 }
                    elif q1 ≡ 9 { kv1 ← 13.0 ∷ f32 }
                    elif q1 ≡ 10 { kv1 ← 25.0 ∷ f32 }
                    elif q1 ≡ 11 { kv1 ← 38.0 ∷ f32 }
                    elif q1 ≡ 12 { kv1 ← 53.0 ∷ f32 }
                    elif q1 ≡ 13 { kv1 ← 69.0 ∷ f32 }
                    elif q1 ≡ 14 { kv1 ← 89.0 ∷ f32 }

                    acc ← acc + (d * kv0) * x[[x_base + j]] + (d * kv1) * x[[x_base + 16 + j]]
                }
            }
        }

        y[[row]] ← acc
    }
}

@ public
fn dispatch_ggml_iq4_nl<size Out, size Blocks, size RowBytes, size In>(LinearWeight lw, tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case GgmlBlockIQ4_NL {}
        default {
            throw variant BadBinding { message = "expected GgmlBlockIQ4_NL LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In and In ≡ Blocks * 32 and RowBytes ≡ Blocks * 18 throw variant BadShape { message = "shape mismatch in dispatch_ggml_iq4_nl" }

    ggml_iq4_nl_matvec<size Out, size Blocks, size RowBytes, size In>(raw_blocks, x, mut y)
}

@ public
kernel ggml_q4_k_matvec<size Out, size RowBytes, size In>(tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void {
    for from y at [row] thread lane let e {
        let i32 row_block_limit ← RowBytes / 144
        let i32 in_block_limit ← In / 256
        mut f32 acc ← 0.0 ∷ f32

        for range 0 ‥ row_block_limit let b {
            if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                let i32 base ← b * 144

                let i32 d_lo ← (raw_blocks[[row, base]] ↦ i32 ⊥ 0) ∧ 255
                let i32 d_hi ← (raw_blocks[[row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                let f32 d ← ((((d_lo + d_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                let i32 dm_lo ← (raw_blocks[[row, base + 2]] ↦ i32 ⊥ 0) ∧ 255
                let i32 dm_hi ← (raw_blocks[[row, base + 3]] ↦ i32 ⊥ 0) ∧ 255
                let f32 dmin ← ((((dm_lo + dm_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                let i32 x_base ← b * 256
                for exclusive 4 let chunk {
                    let i32 idx0 ← chunk * 2
                    let i32 idx1 ← idx0 + 1

                    mut i32 sc0 ← 0
                    mut i32 m0 ← 0
                    if idx0 ≺ 4 {
                        sc0 ← (raw_blocks[[row, base + 4 + idx0]] ↦ i32 ⊥ 0) ∧ 63
                        m0 ← (raw_blocks[[row, base + 8 + idx0]] ↦ i32 ⊥ 0) ∧ 63
                    }
                    else {
                        let i32 s_hi ← raw_blocks[[row, base + 8 + idx0]] ↦ i32 ⊥ 0
                        let i32 s_lo ← raw_blocks[[row, base + idx0]] ↦ i32 ⊥ 0
                        let i32 m_lo ← raw_blocks[[row, base + 4 + idx0]] ↦ i32 ⊥ 0
                        sc0 ← (s_hi ∧ 15) + (((s_lo ⇒ 6) ∧ 3) * 16)
                        m0 ← ((s_hi ⇒ 4) ∧ 15) + (((m_lo ⇒ 6) ∧ 3) * 16)
                    }

                    mut i32 sc1 ← 0
                    mut i32 m1 ← 0
                    if idx1 ≺ 4 {
                        sc1 ← (raw_blocks[[row, base + 4 + idx1]] ↦ i32 ⊥ 0) ∧ 63
                        m1 ← (raw_blocks[[row, base + 8 + idx1]] ↦ i32 ⊥ 0) ∧ 63
                    }
                    else {
                        let i32 s_hi ← raw_blocks[[row, base + 8 + idx1]] ↦ i32 ⊥ 0
                        let i32 s_lo ← raw_blocks[[row, base + idx1]] ↦ i32 ⊥ 0
                        let i32 m_lo ← raw_blocks[[row, base + 4 + idx1]] ↦ i32 ⊥ 0
                        sc1 ← (s_hi ∧ 15) + (((s_lo ⇒ 6) ∧ 3) * 16)
                        m1 ← ((s_hi ⇒ 4) ∧ 15) + (((m_lo ⇒ 6) ∧ 3) * 16)
                    }

                    let f32 d1 ← d * (sc0 ↦ f32)
                    let f32 m1f ← dmin * (m0 ↦ f32)
                    let f32 d2 ← d * (sc1 ↦ f32)
                    let f32 m2f ← dmin * (m1 ↦ f32)
                    let i32 qoff ← chunk * 32
                    let i32 cx_base ← x_base + chunk * 64

                    for exclusive 32 let l {
                        let i32 qs ← (raw_blocks[[row, base + 16 + qoff + l]] ↦ i32 ⊥ 0) ∧ 255
                        let f32 w0 ← d1 * ((qs ∧ 15) ↦ f32) - m1f
                        let f32 w1 ← d2 * (((qs ⇒ 4) ∧ 15) ↦ f32) - m2f
                        acc ← acc + w0 * x[[cx_base + l]] + w1 * x[[cx_base + 32 + l]]
                    }
                }
            }
        }

        y[[row]] ← acc
    }
}

@ public
fn dispatch_ggml_q4_k<size Out, size RowBytes, size In>(LinearWeight lw, tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case GgmlBlockQ4_K {}
        default {
            throw variant BadBinding { message = "expected GgmlBlockQ4_K LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In and In ≥ 256 and In % 256 ≡ 0 and RowBytes ≡ (In / 256) * 144 throw variant BadShape { message = "shape mismatch in dispatch_ggml_q4_k" }

    ggml_q4_k_matvec<size Out, size RowBytes, size In>(raw_blocks, x, mut y)
}

@ public
kernel ggml_q5_k_matvec<size Out, size Blocks, size RowBytes, size In>(tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void {
    for from y at [row] thread lane let e {
        let i32 row_block_limit ← RowBytes / 176
        let i32 in_block_limit ← In / 256
        mut f32 acc ← 0.0 ∷ f32

        for exclusive Blocks let b {
            if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                let i32 base ← b * 176

                let i32 d_lo ← (raw_blocks[[row, base]] ↦ i32 ⊥ 0) ∧ 255
                let i32 d_hi ← (raw_blocks[[row, base + 1]] ↦ i32 ⊥ 0) ∧ 255
                let f32 d ← ((((d_lo + d_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                let i32 dm_lo ← (raw_blocks[[row, base + 2]] ↦ i32 ⊥ 0) ∧ 255
                let i32 dm_hi ← (raw_blocks[[row, base + 3]] ↦ i32 ⊥ 0) ∧ 255
                let f32 dmin ← ((((dm_lo + dm_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                let i32 x_base ← b * 256
                for exclusive 4 let chunk {
                    let i32 idx0 ← chunk * 2
                    let i32 idx1 ← idx0 + 1

                    mut i32 sc0 ← 0
                    mut i32 m0 ← 0
                    if idx0 ≺ 4 {
                        sc0 ← (raw_blocks[[row, base + 4 + idx0]] ↦ i32 ⊥ 0) ∧ 63
                        m0 ← (raw_blocks[[row, base + 8 + idx0]] ↦ i32 ⊥ 0) ∧ 63
                    }
                    else {
                        let i32 s_hi ← raw_blocks[[row, base + 8 + idx0]] ↦ i32 ⊥ 0
                        let i32 s_lo ← raw_blocks[[row, base + idx0]] ↦ i32 ⊥ 0
                        let i32 m_lo ← raw_blocks[[row, base + 4 + idx0]] ↦ i32 ⊥ 0
                        sc0 ← (s_hi ∧ 15) + (((s_lo ⇒ 6) ∧ 3) * 16)
                        m0 ← ((s_hi ⇒ 4) ∧ 15) + (((m_lo ⇒ 6) ∧ 3) * 16)
                    }

                    mut i32 sc1 ← 0
                    mut i32 m1 ← 0
                    if idx1 ≺ 4 {
                        sc1 ← (raw_blocks[[row, base + 4 + idx1]] ↦ i32 ⊥ 0) ∧ 63
                        m1 ← (raw_blocks[[row, base + 8 + idx1]] ↦ i32 ⊥ 0) ∧ 63
                    }
                    else {
                        let i32 s_hi ← raw_blocks[[row, base + 8 + idx1]] ↦ i32 ⊥ 0
                        let i32 s_lo ← raw_blocks[[row, base + idx1]] ↦ i32 ⊥ 0
                        let i32 m_lo ← raw_blocks[[row, base + 4 + idx1]] ↦ i32 ⊥ 0
                        sc1 ← (s_hi ∧ 15) + (((s_lo ⇒ 6) ∧ 3) * 16)
                        m1 ← ((s_hi ⇒ 4) ∧ 15) + (((m_lo ⇒ 6) ∧ 3) * 16)
                    }

                    let f32 d1 ← d * (sc0 ↦ f32)
                    let f32 m1f ← dmin * (m0 ↦ f32)
                    let f32 d2 ← d * (sc1 ↦ f32)
                    let f32 m2f ← dmin * (m1 ↦ f32)
                    let i32 qoff ← chunk * 32
                    let i32 cx_base ← x_base + chunk * 64

                    for exclusive 32 let l {
                        let i32 qs ← (raw_blocks[[row, base + 48 + qoff + l]] ↦ i32 ⊥ 0) ∧ 255
                        let i32 qh ← (raw_blocks[[row, base + 16 + l]] ↦ i32 ⊥ 0) ∧ 255
                        mut i32 qh_sh ← qh
                        if chunk ≡ 1 { qh_sh ← qh ⇒ 2 }
                        elif chunk ≡ 2 { qh_sh ← qh ⇒ 4 }
                        elif chunk ≡ 3 { qh_sh ← qh ⇒ 6 }
                        let i32 hi_lo ← (qh_sh ∧ 1) * 16
                        let i32 hi_hi ← ((qh_sh ⇒ 1) ∧ 1) * 16
                        let i32 q_lo ← (qs ∧ 15) + hi_lo
                        let i32 q_hi ← ((qs ⇒ 4) ∧ 15) + hi_hi
                        let f32 w0 ← d1 * (q_lo ↦ f32) - m1f
                        let f32 w1 ← d2 * (q_hi ↦ f32) - m2f
                        acc ← acc + w0 * x[[cx_base + l]] + w1 * x[[cx_base + 32 + l]]
                    }
                }
            }
        }

        y[[row]] ← acc
    }
}

@ public
fn dispatch_ggml_q5_k<size Out, size Blocks, size RowBytes, size In>(LinearWeight lw, tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case GgmlBlockQ5_K {}
        default {
            throw variant BadBinding { message = "expected GgmlBlockQ5_K LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In and In ≡ Blocks * 256 and RowBytes ≡ Blocks * 176 throw variant BadShape { message = "shape mismatch in dispatch_ggml_q5_k" }

    ggml_q5_k_matvec<size Out, size Blocks, size RowBytes, size In>(raw_blocks, x, mut y)
}

@ public
kernel ggml_q6_k_matvec<size Out, size Blocks, size RowBytes, size In>(tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void {
    for from y at [row] thread lane let e {
        let i32 row_block_limit ← RowBytes / 210
        let i32 in_block_limit ← In / 256
        mut f32 acc ← 0.0 ∷ f32

        for exclusive Blocks let b {
            if b ≥ 0 and b ≺ row_block_limit and b ≺ in_block_limit {
                let i32 base ← b * 210

                let i32 d_lo ← (raw_blocks[[row, base + 208]] ↦ i32 ⊥ 0) ∧ 255
                let i32 d_hi ← (raw_blocks[[row, base + 209]] ↦ i32 ⊥ 0) ∧ 255
                let f32 d ← ((((d_lo + d_hi * 256) ↦ u16 ⊥ 0) ↦ b16) ↦ f16) ↦ f32

                let i32 x_base ← b * 256
                for exclusive 2 let n {
                    let i32 sc_base ← n * 8
                    let i32 ql_off ← n * 64
                    let i32 qh_off ← n * 32
                    let i32 y_off ← x_base + n * 128

                    for exclusive 32 let l {
                        let i32 idx ← l / 16
                        let i32 ql_lo ← (raw_blocks[[row, base + ql_off + l]] ↦ i32 ⊥ 0) ∧ 255
                        let i32 ql_hi ← (raw_blocks[[row, base + ql_off + l + 32]] ↦ i32 ⊥ 0) ∧ 255
                        let i32 qh ← (raw_blocks[[row, base + 128 + qh_off + l]] ↦ i32 ⊥ 0) ∧ 255

                        let i32 q1 ← ((ql_lo ∧ 15) + ((qh ∧ 3) * 16)) - 32
                        let i32 q2 ← ((ql_hi ∧ 15) + (((qh ⇒ 2) ∧ 3) * 16)) - 32
                        let i32 q3 ← (((ql_lo ⇒ 4) ∧ 15) + (((qh ⇒ 4) ∧ 3) * 16)) - 32
                        let i32 q4 ← (((ql_hi ⇒ 4) ∧ 15) + (((qh ⇒ 6) ∧ 3) * 16)) - 32

                        let i32 s0_u ← (raw_blocks[[row, base + 192 + sc_base + idx]] ↦ i32 ⊥ 0) ∧ 255
                        let i32 s2_u ← (raw_blocks[[row, base + 192 + sc_base + idx + 2]] ↦ i32 ⊥ 0) ∧ 255
                        let i32 s4_u ← (raw_blocks[[row, base + 192 + sc_base + idx + 4]] ↦ i32 ⊥ 0) ∧ 255
                        let i32 s6_u ← (raw_blocks[[row, base + 192 + sc_base + idx + 6]] ↦ i32 ⊥ 0) ∧ 255

                        let i32 s0 ← s0_u ≥ 128 ✓ s0_u - 256 ✗ s0_u
                        let i32 s2 ← s2_u ≥ 128 ✓ s2_u - 256 ✗ s2_u
                        let i32 s4 ← s4_u ≥ 128 ✓ s4_u - 256 ✗ s4_u
                        let i32 s6 ← s6_u ≥ 128 ✓ s6_u - 256 ✗ s6_u

                        let f32 w1 ← d * (s0 ↦ f32) * (q1 ↦ f32)
                        let f32 w2 ← d * (s2 ↦ f32) * (q2 ↦ f32)
                        let f32 w3 ← d * (s4 ↦ f32) * (q3 ↦ f32)
                        let f32 w4 ← d * (s6 ↦ f32) * (q4 ↦ f32)

                        acc ← acc + w1 * x[[y_off + l]] + w2 * x[[y_off + l + 32]] + w3 * x[[y_off + l + 64]] + w4 * x[[y_off + l + 96]]
                    }
                }
            }
        }

        y[[row]] ← acc
    }
}

@ public
fn dispatch_ggml_q6_k<size Out, size Blocks, size RowBytes, size In>(LinearWeight lw, tensor<u8, [Out, RowBytes]> raw_blocks, tensor<f32, [In]> x, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case GgmlBlockQ6_K {}
        default {
            throw variant BadBinding { message = "expected GgmlBlockQ6_K LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In and In ≡ Blocks * 256 and RowBytes ≡ Blocks * 210 throw variant BadShape { message = "shape mismatch in dispatch_ggml_q6_k" }

    ggml_q6_k_matvec<size Out, size Blocks, size RowBytes, size In>(raw_blocks, x, mut y)
}

# -------------------------------------------------------------------------
# Batched B=k device linear_matmul kernels & dispatchers
# -------------------------------------------------------------------------

@ public
kernel add_bias_matmul<size B, size Out>(tensor<f32, [Out]> bias, mut tensor<f32, [B, Out]> y) → void {
    for from y at [b_idx, row] thread lane let e {
        y[[b_idx, row]] ← e + bias[[row]]
    }
}

@ public
fn dispatch_add_bias_matmul<size B, size Out>(LinearWeight lw, tensor<f32, [Out]> bias, mut tensor<f32, [B, Out]> y) → void ⇥ LinearWeightError {
    require lw.has_bias throw variant BadBinding { message = "LinearWeight does not have bias" }
    require lw.out_features ≡ Out throw variant BadShape { message = "bias shape mismatch in dispatch_add_bias_matmul" }
    add_bias_matmul<size B, size Out>(bias, mut y)
}

@ public
kernel dense_f32_matmul<size B, size Out, size In>(tensor<f32, [Out, In]> weight, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y) → void {
    for from y at [b_idx, row] thread lane let e {
        let i32 in_dim ← In ↦ i32
        mut f32 acc ← 0.0 ∷ f32
        if in_dim ≥ 1 and in_dim ≤ 16777216 {
            mut i32 j ← 0
            while j ≺ in_dim {
                acc ← acc + weight[[row, j]] * x[[b_idx, j]]
                j ← j + 1
            }
        }
        y[[b_idx, row]] ← acc
    }
}

@ public
fn dispatch_dense_f32_matmul<size B, size Out, size In>(LinearWeight lw, tensor<f32, [Out, In]> weight, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case DenseF32 {}
        default {
            throw variant BadBinding { message = "expected DenseF32 LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In throw variant BadShape { message = "shape mismatch in dispatch_dense_f32_matmul" }

    dense_f32_matmul<size B, size Out, size In>(weight, x, mut y)
}

@ public
kernel dense_bf16_matmul<size B, size Out, size In>(tensor<bf16, [Out, In]> weight, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y) → void {
    for from y at [b_idx, row] thread lane let e {
        let i32 in_dim ← In ↦ i32
        mut f32 acc ← 0.0 ∷ f32
        if in_dim ≥ 1 and in_dim ≤ 16777216 {
            mut i32 j ← 0
            while j ≺ in_dim {
                acc ← acc + (weight[[row, j]] ↦ f32) * x[[b_idx, j]]
                j ← j + 1
            }
        }
        y[[b_idx, row]] ← acc
    }
}

@ public
fn dispatch_dense_bf16_matmul<size B, size Out, size In>(LinearWeight lw, tensor<bf16, [Out, In]> weight, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case DenseBf16 {}
        default {
            throw variant BadBinding { message = "expected DenseBf16 LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In throw variant BadShape { message = "shape mismatch in dispatch_dense_bf16_matmul" }

    dense_bf16_matmul<size B, size Out, size In>(weight, x, mut y)
}

@ public
kernel dense_f16_matmul<size B, size Out, size In>(tensor<f16, [Out, In]> weight, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y) → void {
    for from y at [b_idx, row] thread lane let e {
        let i32 in_dim ← In ↦ i32
        mut f32 acc ← 0.0 ∷ f32
        if in_dim ≥ 1 and in_dim ≤ 16777216 {
            mut i32 j ← 0
            while j ≺ in_dim {
                acc ← acc + (weight[[row, j]] ↦ f32) * x[[b_idx, j]]
                j ← j + 1
            }
        }
        y[[b_idx, row]] ← acc
    }
}

@ public
fn dispatch_dense_f16_matmul<size B, size Out, size In>(LinearWeight lw, tensor<f16, [Out, In]> weight, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y) → void ⇥ LinearWeightError {
