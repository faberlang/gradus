@ public
fn dispatch_group_affine_u32_splitk<size Out, size PackedIn, size Groups, size In, size KParts>(LinearWeight lw, tensor<u32, [Out, PackedIn]> weight, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out, KParts]> partials, mut tensor<f32, [Out]> y) → void ⇥ LinearWeightError {
    match lw.kind {
        case GroupAffineU32 {}
        default {
            throw variant BadBinding { message = "expected GroupAffineU32 LinearWeight" }
        }
    }
    require lw.out_features ≡ Out and lw.in_features ≡ In and lw.packed_cols ≡ PackedIn and lw.group_cols ≡ Groups throw variant BadShape { message = "shape mismatch in dispatch_group_affine_u32_splitk" }

    let i32 bits ← lw.bits ↦ i32 ⊥ 8
    let i32 gs ← lw.group_size ↦ i32 ⊥ 64
    if bits ≡ 4 {
        ga.linear_matvec_4bit_u32_part<size Out, size PackedIn, size Groups, size In, size KParts>(weight, scales, biases, x, mut partials, gs)
    }
    elif bits ≡ 8 {
        ga.linear_matvec_8bit_u32_part<size Out, size PackedIn, size Groups, size In, size KParts>(weight, scales, biases, x, mut partials, gs)
    }
    else {
        ga.linear_matvec_u32_part<size Out, size PackedIn, size Groups, size In, size KParts>(weight, scales, biases, x, mut partials, bits, gs)
    }
    ga.linear_matvec_u32_combine<size Out, size KParts>(partials, mut y)
}

