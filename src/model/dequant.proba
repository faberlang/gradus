# Co-located package test for dequant.fab (PML2-U5 — CPU dequant of the
# four admitted GGML block types, the dequant trio member).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the admitted-type layout facts (block
# elements/bytes per type), the fail-closed gate matrix (un-admitted type,
# block byte-length mismatch, row byte-length mismatch, NaN half), the
# per-block element counts for the five admitted types, and the row dequant
# over a multi-block payload. adfirma assertions run under the cargo-backed
# `faber test` harness (auditor-owned); `faber check` proves the whole
# surface type-checks.
#
# NOTE (pinned fixtures): the block bytes below are REAL blocks of the
# admitted pinned row (SmolLM2-360M-Instruct Q4_K_M) taken read-only from
# `radix/docs/factory/gpu-inference-gguf/evidence/gi2-dequant-goldens.json`
# (cpu-oracle goldens; `ggml/src/ggml-quants.c @ a957b7747`). The exact
# f32 VALUES are bit-exact vs those goldens — the numeric comparison is the
# auditor-owned execution path; this proba pins the STRUCTURE (element
# counts, byte lengths, error classes).

importa ex "./dequant" privata dequant

# -- pinned block fixtures (real pinned-row blocks from the goldens) ------

# F32 output_norm.weight block 0 (4 bytes).
fixum lista<numerus<u8>> F32_BLOC ← bytes([0, 0, 166, 63])

# Q5_0 blk.0.attn_q.weight block 0 (22 bytes).
fixum lista<numerus<u8>> Q5_0_BLOC ← bytes([8, 43, 119, 109, 62, 184, 32, 0, 33, 111, 51, 16, 208, 254, 228, 14, 240, 50, 28, 17, 242, 10])

# Q8_0 blk.0.attn_v.weight block 0 (34 bytes).
fixum lista<numerus<u8>> Q8_0_BLOC ← bytes([127, 19, 178, 239, 0, 129, 207, 249, 10, 3, 22, 207, 199, 10, 234, 132, 26, 233, 8, 241, 51, 13, 24, 225, 205, 206, 35, 9, 255, 237, 15, 51, 235, 168])

# Q4_K blk.3.ffn_down.weight block 0 (144 bytes).
fixum lista<numerus<u8>> Q4_K_BLOC ← bytes([211, 19, 6, 31, 238, 238, 235, 177, 222, 234, 231, 244, 240, 220, 159, 186, 97, 100, 144, 165, 52, 118, 72, 149, 16, 60, 69, 242, 160, 117, 80, 24, 182, 37, 112, 72, 7, 231, 85, 117, 166, 35, 133, 55, 207, 85, 138, 139, 199, 178, 69, 190, 106, 82, 158, 227, 54, 168, 247, 162, 64, 165, 246, 111, 99, 102, 146, 73, 98, 72, 164, 233, 136, 84, 35, 124, 104, 144, 183, 6, 248, 89, 70, 77, 75, 118, 207, 143, 128, 105, 56, 134, 81, 173, 249, 12, 29, 152, 122, 138, 124, 121, 118, 154, 102, 72, 42, 108, 140, 132, 119, 174, 182, 184, 233, 215, 249, 145, 197, 198, 28, 100, 147, 181, 182, 87, 147, 132, 202, 182, 88, 165, 135, 213, 200, 242, 87, 64, 134, 134, 175, 154, 120, 8])

# Q6_K blk.0.ffn_down.weight block 0 (210 bytes).
fixum lista<numerus<u8>> Q6_K_BLOC ← bytes([113, 120, 48, 26, 253, 99, 58, 251, 166, 32, 168, 217, 201, 249, 47, 200, 4, 194, 175, 244, 204, 57, 245, 253, 211, 250, 7, 254, 125, 60, 225, 222, 2, 42, 109, 248, 105, 64, 207, 51, 102, 53, 8, 188, 140, 17, 172, 178, 160, 175, 136, 104, 215, 71, 28, 27, 196, 7, 164, 93, 45, 180, 46, 17, 67, 80, 29, 121, 8, 71, 7, 235, 1, 188, 217, 125, 94, 215, 178, 138, 115, 34, 222, 156, 129, 177, 161, 13, 65, 139, 99, 91, 189, 156, 5, 181, 225, 121, 50, 146, 65, 127, 208, 9, 54, 133, 158, 153, 221, 72, 5, 224, 245, 162, 19, 143, 5, 104, 48, 107, 218, 64, 65, 80, 163, 135, 31, 229, 47, 115, 74, 76, 230, 118, 161, 201, 168, 236, 148, 136, 170, 194, 229, 88, 97, 217, 149, 169, 82, 218, 134, 18, 77, 201, 1, 233, 90, 68, 152, 168, 230, 116, 58, 89, 74, 153, 162, 87, 178, 199, 76, 176, 106, 71, 29, 32, 110, 153, 89, 97, 46, 80, 153, 197, 87, 154, 78, 82, 141, 78, 233, 102, 61, 131, 174, 66, 69, 60, 178, 128, 63, 161, 207, 92, 176, 48, 67, 117, 103, 135])

# -- byte-list helpers ----------------------------------------------------

functio bytes(lista<numerus> vals) → lista<numerus<u8>> {
    varia lista<numerus<u8>> bs ← vacua
    itera ex vals fixum v {
        bs.appende(v ↦ numerus<u8>)
    }
    redde bs
}

# Concatenate two byte lists (row assembly for the multi-block probes).
functio add(lista<numerus<u8>> a, lista<numerus<u8>> b) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    itera ex a fixum byte {
        out.appende(byte)
    }
    itera ex b fixum byte {
        out.appende(byte)
    }
    redde out
}

# -- outcome helpers ------------------------------------------------------

# dequantizas_glomulus outcome as textus ("ok" or the typed error's causa).
functio glomulus_result(numerus typo, lista<numerus<u8>> blocci) → textus {
    fac {
        fixum lista<f32> _ ← dequant.dequantizas_glomulus(typo, blocci)
        redde "ok"
    }
    cape err {
        redde dequant.causa(err)
    }
}

# dequantizas_ordo outcome as textus ("ok" or the typed error's causa).
functio ordo_result(numerus typo, lista<numerus<u8>> octeti) → textus {
    fac {
        fixum lista<f32> _ ← dequant.dequantizas_ordo(typo, octeti)
        redde "ok"
    }
    cape err {
        redde dequant.causa(err)
    }
}

# Element count of a successful block dequant (0 on error).
functio glomulus_elementa(numerus typo, lista<numerus<u8>> blocci) → numerus {
    fac {
        fixum lista<f32> out ← dequant.dequantizas_glomulus(typo, blocci)
        redde out.longitudo()
    }
    cape err {
        redde 0
    }
}

# Element count of a successful row dequant (0 on error).
functio ordo_elementa(numerus typo, lista<numerus<u8>> octeti) → numerus {
    fac {
        fixum lista<f32> out ← dequant.dequantizas_ordo(typo, octeti)
        redde out.longitudo()
    }
    cape err {
        redde 0
    }
}

# -- layout facts ---------------------------------------------------------

probandum "dequant layout facts" {
    proba "admits the five pinned-row GGML types with their block layouts" {
        adfirma dequant.elementa_glomoris(0) ≡ 1
        adfirma dequant.octeti_glomoris(0) ≡ 4
        adfirma dequant.elementa_glomoris(6) ≡ 32
        adfirma dequant.octeti_glomoris(6) ≡ 22
        adfirma dequant.elementa_glomoris(8) ≡ 32
        adfirma dequant.octeti_glomoris(8) ≡ 34
        adfirma dequant.elementa_glomoris(12) ≡ 256
        adfirma dequant.octeti_glomoris(12) ≡ 144
        adfirma dequant.elementa_glomoris(14) ≡ 256
        adfirma dequant.octeti_glomoris(14) ≡ 210
    }

    proba "un-admitted ggml type ids report zero layout facts" {
        adfirma dequant.elementa_glomoris(2) ≡ 0
        adfirma dequant.octeti_glomoris(2) ≡ 0
        adfirma dequant.elementa_glomoris(15) ≡ 0
        adfirma dequant.octeti_glomoris(15) ≡ 0
    }
}

# -- block dequant (pinned-row blocks, element-count structure) -----------

probandum "block dequant" {
    proba "F32 block yields one f32 element" {
        adfirma glomulus_elementa(0, F32_BLOC) ≡ 1
    }

    proba "Q5_0 block yields 32 f32 elements" {
        adfirma glomulus_elementa(6, Q5_0_BLOC) ≡ 32
    }

    proba "Q8_0 block yields 32 f32 elements" {
        adfirma glomulus_elementa(8, Q8_0_BLOC) ≡ 32
    }

    proba "Q4_K block yields 256 f32 elements" {
        adfirma glomulus_elementa(12, Q4_K_BLOC) ≡ 256
    }

    proba "Q6_K block yields 256 f32 elements" {
        adfirma glomulus_elementa(14, Q6_K_BLOC) ≡ 256
    }
}

# -- fail-closed gates ----------------------------------------------------

probandum "dequant fail-closed gates" {
    proba "un-admitted ggml type fails closed before any byte is touched" {
        adfirma glomulus_result(2, Q8_0_BLOC) ≡ "un-admitted GGML type id: 2"
        adfirma glomulus_result(15, Q8_0_BLOC) ≡ "un-admitted GGML type id: 15"
    }

    proba "block byte-length mismatch fails closed" {
        # Q8_0 block trimmed to 33 bytes.
        fixum lista<numerus<u8>> trim ← excerpe(Q8_0_BLOC, 33)
        adfirma glomulus_result(8, trim) ≡ "block byte length mismatch"
    }

    proba "row byte-length mismatch fails closed" {
        # Q4_K block (144 B) with one extra byte appended.
        fixum lista<numerus<u8>> padded ← add(Q4_K_BLOC, bytes([0]))
        adfirma ordo_result(12, padded) ≡ "row byte length not a multiple of block_bytes"
    }

    proba "un-admitted type in row dequant fails closed" {
        adfirma ordo_result(2, Q8_0_BLOC) ≡ "un-admitted GGML type id: 2"
    }
}

# -- row dequant ----------------------------------------------------------

probandum "row dequant" {
    proba "two-block Q8_0 row yields 64 f32 elements" {
        fixum lista<numerus<u8>> row ← add(Q8_0_BLOC, Q8_0_BLOC)
        adfirma ordo_elementa(8, row) ≡ 64
    }

    proba "two-block F32 row yields 2 f32 elements" {
        fixum lista<numerus<u8>> row ← add(F32_BLOC, F32_BLOC)
        adfirma ordo_elementa(0, row) ≡ 2
    }

    proba "row element count equals blocks × block elements" {
        fixum lista<numerus<u8>> row ← add(Q6_K_BLOC, add(Q6_K_BLOC, Q6_K_BLOC))
        adfirma ordo_elementa(14, row) ≡ 3 * dequant.elementa_glomoris(14)
    }
}

# Sub-list helper for the trimmed-block probe.
functio excerpe(lista<numerus<u8>> b, numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < n {
        out.appende(b.accipe(i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    redde out
}
