+++
locale = "en"
+++
# Co-located package test for dequant.fab (PML2-U5 — CPU dequant of the
# admitted GGML block types; extended by GGUF-A3 C1 to the union set
# {F32, BF16, Q5_0, Q8_0, Q4_K, Q5_K, Q6_K}).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the admitted-type layout facts (block
# elements/bytes per type), the fail-closed gate matrix (un-admitted type,
# block byte-length mismatch, row byte-length mismatch, NaN half/bf16), the
# per-block element counts for the seven admitted types, and the row dequant
# over a multi-block payload. adfirma assertions run under the cargo-backed
# `faber test` harness (auditor-owned); `faber check` proves the whole
# surface type-checks.
#
# NOTE (pinned fixtures): the block bytes below are REAL blocks of the
# admitted pinned row (SmolLM2-360M-Instruct Q4_K_M) taken read-only from
# `radix/docs/factory/gpu-inference-gguf/evidence/gi2-dequant-goldens.json`
# (cpu-oracle goldens; `ggml/src/ggml-quants.c @ a957b7747`), plus the
# deterministic BF16/Q5_K blocks from the A3 union-set goldens
# (`fixtures/gguf/gguf-dequant-goldens.json`, schema
# `gguf-dequant-goldens-v2`). The exact f32 VALUES are bit-exact vs those
# goldens — the numeric comparison is the auditor-owned execution path;
# this proba pins the STRUCTURE (element counts, byte lengths, error
# classes) and the admitted layout facts for the widened set.

import from "gradus:model/dequant" dequant

# -- pinned block fixtures (real pinned-row blocks from the goldens) ------

# F32 output_norm.weight block 0 (4 bytes).
const list<int<u8>> F32_BLOC ← _bytes([0, 0, 166, 63])

# BF16 (GGML_BF16 = 30) deterministic blocks from the A3 union goldens.
# "one" (0x3f80) and "max-finite" (0x7f7f), each 2 bytes.
const list<int<u8>> BF16_ONE_BLOC ← _bytes([128, 63])

const list<int<u8>> BF16_MAX_BLOC ← _bytes([127, 127])

# Q5_0 blk.0.attn_q.weight block 0 (22 bytes).
const list<int<u8>> Q5_0_BLOC ← _bytes([8, 43, 119, 109, 62, 184, 32, 0, 33, 111, 51, 16, 208, 254, 228, 14, 240, 50, 28, 17, 242, 10])

# Q8_0 blk.0.attn_v.weight block 0 (34 bytes).
const list<int<u8>> Q8_0_BLOC ← _bytes([127, 19, 178, 239, 0, 129, 207, 249, 10, 3, 22, 207, 199, 10, 234, 132, 26, 233, 8, 241, 51, 13, 24, 225, 205, 206, 35, 9, 255, 237, 15, 51, 235, 168])

# Q4_K blk.3.ffn_down.weight block 0 (144 bytes).
const list<int<u8>> Q4_K_BLOC ← _bytes([211, 19, 6, 31, 238, 238, 235, 177, 222, 234, 231, 244, 240, 220, 159, 186, 97, 100, 144, 165, 52, 118, 72, 149, 16, 60, 69, 242, 160, 117, 80, 24, 182, 37, 112, 72, 7, 231, 85, 117, 166, 35, 133, 55, 207, 85, 138, 139, 199, 178, 69, 190, 106, 82, 158, 227, 54, 168, 247, 162, 64, 165, 246, 111, 99, 102, 146, 73, 98, 72, 164, 233, 136, 84, 35, 124, 104, 144, 183, 6, 248, 89, 70, 77, 75, 118, 207, 143, 128, 105, 56, 134, 81, 173, 249, 12, 29, 152, 122, 138, 124, 121, 118, 154, 102, 72, 42, 108, 140, 132, 119, 174, 182, 184, 233, 215, 249, 145, 197, 198, 28, 100, 147, 181, 182, 87, 147, 132, 202, 182, 88, 165, 135, 213, 200, 242, 87, 64, 134, 134, 175, 154, 120, 8])

# Q5_K (GGML_Q5_K = 13) deterministic blocks from the A3 union goldens:
# "max-scale-ones" (d = 65504, dmin = -0.0, scales all 0x3f, qh/qs all
# ones) and "negative-d-highbits" (negative d, scale high-bit paths), each
# 176 bytes.
const list<int<u8>> Q5_K_MAX_BLOC ← add(add(add(_bytes([255, 123, 0, 128]), repetere(63, 12)), repetere(255, 32)), repetere(255, 128))

const list<int<u8>> Q5_K_HIGH_BLOC ← add(add(_bytes([0, 188, 0, 60, 255, 127, 191, 63, 60, 45, 30, 15, 63, 42, 21, 0]), repetere(255, 32)), repetere_ordo([0, 17, 34, 51], 32))

# Q6_K blk.0.ffn_down.weight block 0 (210 bytes).
const list<int<u8>> Q6_K_BLOC ← _bytes([113, 120, 48, 26, 253, 99, 58, 251, 166, 32, 168, 217, 201, 249, 47, 200, 4, 194, 175, 244, 204, 57, 245, 253, 211, 250, 7, 254, 125, 60, 225, 222, 2, 42, 109, 248, 105, 64, 207, 51, 102, 53, 8, 188, 140, 17, 172, 178, 160, 175, 136, 104, 215, 71, 28, 27, 196, 7, 164, 93, 45, 180, 46, 17, 67, 80, 29, 121, 8, 71, 7, 235, 1, 188, 217, 125, 94, 215, 178, 138, 115, 34, 222, 156, 129, 177, 161, 13, 65, 139, 99, 91, 189, 156, 5, 181, 225, 121, 50, 146, 65, 127, 208, 9, 54, 133, 158, 153, 221, 72, 5, 224, 245, 162, 19, 143, 5, 104, 48, 107, 218, 64, 65, 80, 163, 135, 31, 229, 47, 115, 74, 76, 230, 118, 161, 201, 168, 236, 148, 136, 170, 194, 229, 88, 97, 217, 149, 169, 82, 218, 134, 18, 77, 201, 1, 233, 90, 68, 152, 168, 230, 116, 58, 89, 74, 153, 162, 87, 178, 199, 76, 176, 106, 71, 29, 32, 110, 153, 89, 97, 46, 80, 153, 197, 87, 154, 78, 82, 141, 78, 233, 102, 61, 131, 174, 66, 69, 60, 178, 128, 63, 161, 207, 92, 176, 48, 67, 117, 103, 135])

# -- byte-list helpers ----------------------------------------------------

fn _bytes(list<int> vals) → list<int<u8>> {
    var list<int<u8>> bs ← vacua
    for from vals const v {
        bs.append(v ↦ int<u8>)
    }
    return bs
}

# Concatenate two byte lists (row assembly for the multi-block probes).
fn add(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    for from a const byte {
        out.append(byte)
    }
    for from b const byte {
        out.append(byte)
    }
    return out
}

# Repeat one byte value n times (block-fixture assembly).
fn repetere(int v, int n) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ n {
        out.append((v % 256) ∷ int<u8>)
        i ← i + 1
    }
    return out
}

# Repeat a byte pattern n times (block-fixture assembly).
fn repetere_ordo(list<int> pat, int n) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ n {
        for from pat const v {
            out.append((v % 256) ∷ int<u8>)
        }
        i ← i + 1
    }
    return out
}

# -- outcome helpers ------------------------------------------------------

# dequantizas_glomulus outcome as textus ("ok" or the typed error's causa).
fn glomulus_result(int typo, list<int<u8>> blocci) → string {
    do {
        dequant.dequantize_block(typo, blocci)
        return "ok"
    }
    catch err {
        return dequant.message(err)
    }
}

# dequantizas_ordo outcome as textus ("ok" or the typed error's causa).
fn ordo_result(int typo, list<int<u8>> octeti) → string {
    do {
        dequant.dequantize_order(typo, octeti)
        return "ok"
    }
    catch err {
        return dequant.message(err)
    }
}

# Element count of a successful block dequant (0 on error).
fn glomulus_elementa(int typo, list<int<u8>> blocci) → int {
    do {
        const list<f32> out ← dequant.dequantize_block(typo, blocci)
        return out.length()
    }
    catch err {
        return 0
    }
}

# Element count of a successful row dequant (0 on error).
fn ordo_elementa(int typo, list<int<u8>> octeti) → int {
    do {
        const list<f32> out ← dequant.dequantize_order(typo, octeti)
        return out.length()
    }
    catch err {
        return 0
    }
}

# -- layout facts ---------------------------------------------------------

test "admits the seven union-set GGML types with their block layouts" {
    assert dequant.block_elements(0) ≡ 1
    assert dequant.block_bytes(0) ≡ 4
    assert dequant.block_elements(30) ≡ 1
    assert dequant.block_bytes(30) ≡ 2
    assert dequant.block_elements(6) ≡ 32
    assert dequant.block_bytes(6) ≡ 22
    assert dequant.block_elements(8) ≡ 32
    assert dequant.block_bytes(8) ≡ 34
    assert dequant.block_elements(12) ≡ 256
    assert dequant.block_bytes(12) ≡ 144
    assert dequant.block_elements(13) ≡ 256
    assert dequant.block_bytes(13) ≡ 176
    assert dequant.block_elements(14) ≡ 256
    assert dequant.block_bytes(14) ≡ 210
}

test "un-admitted ggml type ids report zero layout facts" {
    assert dequant.block_elements(2) ≡ 0
    assert dequant.block_bytes(2) ≡ 0
    assert dequant.block_elements(15) ≡ 0
    assert dequant.block_bytes(15) ≡ 0
}

# -- block dequant (pinned-row blocks, element-count structure) -----------

test "F32 block yields one f32 element" {
    assert glomulus_elementa(0, F32_BLOC) ≡ 1
}

test "BF16 block yields one f32 element" {
    assert glomulus_elementa(30, BF16_ONE_BLOC) ≡ 1
    assert glomulus_elementa(30, BF16_MAX_BLOC) ≡ 1
}

test "Q5_0 block yields 32 f32 elements" {
    assert glomulus_elementa(6, Q5_0_BLOC) ≡ 32
}

test "Q8_0 block yields 32 f32 elements" {
    assert glomulus_elementa(8, Q8_0_BLOC) ≡ 32
}

test "Q4_K block yields 256 f32 elements" {
    assert glomulus_elementa(12, Q4_K_BLOC) ≡ 256
}

test "Q5_K block yields 256 f32 elements" {
    assert glomulus_elementa(13, Q5_K_MAX_BLOC) ≡ 256
    assert glomulus_elementa(13, Q5_K_HIGH_BLOC) ≡ 256
}

test "Q6_K block yields 256 f32 elements" {
    assert glomulus_elementa(14, Q6_K_BLOC) ≡ 256
}

# -- fail-closed gates ----------------------------------------------------

test "un-admitted ggml type fails closed before any byte is touched" {
    assert glomulus_result(2, Q8_0_BLOC) ≡ "un-admitted GGML type id: 2"
    assert glomulus_result(15, Q8_0_BLOC) ≡ "un-admitted GGML type id: 15"
}

test "block byte-length mismatch fails closed" {
    # Q8_0 block trimmed to 33 bytes.
    const list<int<u8>> trim ← excerpe(Q8_0_BLOC, 33)
    assert glomulus_result(8, trim) ≡ "block byte length mismatch"
    # Q5_K block trimmed to 175 bytes.
    const list<int<u8>> trim_q5k ← excerpe(Q5_K_MAX_BLOC, 175)
    assert glomulus_result(13, trim_q5k) ≡ "block byte length mismatch"
    # BF16 block padded to 3 bytes.
    const list<int<u8>> pad_bf16 ← add(BF16_ONE_BLOC, _bytes([0]))
    assert glomulus_result(30, pad_bf16) ≡ "block byte length mismatch"
}

test "NaN bf16 value fails closed" {
    # bf16 quiet NaN (0x7fc1): dequant must not smuggle a NaN into f32.
    const list<int<u8>> nan_bf16 ← _bytes([193, 127])
    assert glomulus_result(30, nan_bf16) ≡ "NaN bf16 value in dequant block"
}

test "row byte-length mismatch fails closed" {
    # Q4_K block (144 B) with one extra byte appended.
    const list<int<u8>> padded ← add(Q4_K_BLOC, _bytes([0]))
    assert ordo_result(12, padded) ≡ "row byte length not a multiple of block_bytes"
    # Q5_K block (176 B) with one extra byte appended.
    const list<int<u8>> padded_q5k ← add(Q5_K_MAX_BLOC, _bytes([0]))
    assert ordo_result(13, padded_q5k) ≡ "row byte length not a multiple of block_bytes"
}

test "un-admitted type in row dequant fails closed" {
    assert ordo_result(2, Q8_0_BLOC) ≡ "un-admitted GGML type id: 2"
}

# -- row dequant ----------------------------------------------------------

test "two-block Q8_0 row yields 64 f32 elements" {
    const list<int<u8>> row ← add(Q8_0_BLOC, Q8_0_BLOC)
    assert ordo_elementa(8, row) ≡ 64
}

test "two-block F32 row yields 2 f32 elements" {
    const list<int<u8>> row ← add(F32_BLOC, F32_BLOC)
    assert ordo_elementa(0, row) ≡ 2
}

test "row element count equals blocks × block elements" {
    const list<int<u8>> row ← add(Q6_K_BLOC, add(Q6_K_BLOC, Q6_K_BLOC))
    assert ordo_elementa(14, row) ≡ 3 * dequant.block_elements(14)
    const list<int<u8>> row_q5k ← add(Q5_K_MAX_BLOC, Q5_K_HIGH_BLOC)
    assert ordo_elementa(13, row_q5k) ≡ 2 * dequant.block_elements(13)
}

# Sub-list helper for the trimmed-block probe.
fn excerpe(list<int<u8>> b, int n) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ n {
        out.append(b.get(i) coalesce 0 ∷ int<u8>)
        i ← i + 1
    }
    return out
}
