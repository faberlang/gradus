+++ toml
locale = "en"

+++ faber
# ModelBundle — pathless, content-addressed multi-member bundle contract
# and index-optional shard mapping (issue #43).
#
# Public import: import from "gradus:model/bundle" bundle
# Depends on: gradus:model/artifact.
#
# --- Contract ------------------------------------------------------------
#
# A ModelBundle binds multiple artifacts by role (`backbone`, `drafter`,
# `vision`, `config`, `quant_config`, `shard_index`, `tokenizer`) using
# pathless `artifact.ContentIdentity` anchors only — never filesystem
# paths, filenames, or URLs.
#
# Supports:
#   * Single-file GGUF (1-member bundle) and paired backbone + drafter GGUF
#     (2-member bundle, e.g. `inkling2_loop` + `dflash`).
#   * Multi-shard Safetensors with an explicit `shard_index` map (e.g.
#     Qwen2.5-7B / Inkling-2-Mini 4-shard + `model.safetensors.index.json`).
#   * Multi-shard Safetensors without an index file (ordered shard member
#     list, e.g. Flint's 5 zero-based shards).
#
# Missing optional roles (`drafter`, `vision`, `quant_config`,
# `shard_index`, and `config`/`tokenizer` on GGUF) are valid; duplicate or
# conflicting primary/singular roles and malformed member identities fail
# closed.

import from "gradus:model/artifact"

@ public
const string BUNDLE_SCHEMA = "model-bundle-1.0.0"

@ public
union BundleError {
    @ shared
    string message

    BadIdentity,
    BadRole,
    DuplicateRole,
    MissingPrimary,
    BadShardMap,
    BadWire
}

@ public
union MemberRole {
    Backbone,
    Drafter,
    Vision,
    Config,
    QuantConfig,
    ShardIndex,
    Tokenizer
}

@ public
union ContainerKind {
    Gguf,
    Safetensors
}

@ public
class BundleMember {
    let MemberRole role
    let ContainerKind container
    let int shard_index
    let artifact.ContentIdentity identity
}

@ public
class ShardEntry {
    let string tensor_name
    let int shard_index
}

@ public
union ShardMapping {
    Indexed {
        list<ShardEntry> entries
    },
    Unindexed {
        int shard_count
    }
}

@ public
class ModelBundle {
    let string schema
    let ContainerKind primary_container
    let list<BundleMember> backbone_shards
    let BundleMember ∪ none drafter
    let BundleMember ∪ none vision
    let BundleMember ∪ none config
    let BundleMember ∪ none quant_config
    let BundleMember ∪ none shard_index
    let BundleMember ∪ none tokenizer
    let ShardMapping shard_map
}

# -------------------------------------------------------------------------
# Role and container helpers
# -------------------------------------------------------------------------

@ public
fn role_name(MemberRole r) → string {
    match r {
        case Backbone {
            return "backbone"
        }
        case Drafter {
            return "drafter"
        }
        case Vision {
            return "vision"
        }
        case Config {
            return "config"
        }
        case QuantConfig {
            return "quant_config"
        }
        case ShardIndex {
            return "shard_index"
        }
        case Tokenizer {
            return "tokenizer"
        }
    }
}

@ public
fn container_name(ContainerKind c) → string {
    match c {
        case Gguf {
            return "gguf"
        }
        case Safetensors {
            return "safetensors"
        }
    }
}

fn validate_identity(artifact.ContentIdentity id) → artifact.ContentIdentity ⇥ BundleError {
    do {
        return artifact.identity(id.algorithm, id.digest, id.length)
    }
    catch err {
        throw variant BadIdentity { message = err.message }
    }
}

fn format_identity(artifact.ContentIdentity id) → string {
    return "§:§:§"(id.algorithm, id.digest, id.length ↦ string)
}

# -------------------------------------------------------------------------
# General fail-closed admission
# -------------------------------------------------------------------------

@ public
fn admit_bundle(ContainerKind primary_container, list<BundleMember> members, ShardMapping shard_map) → ModelBundle ⇥ BundleError {
    mut list<BundleMember> backbone_raw ← empty
    mut list<BundleMember> drafter_list ← empty
    mut list<BundleMember> vision_list ← empty
    mut list<BundleMember> config_list ← empty
    mut list<BundleMember> quant_list ← empty
    mut list<BundleMember> index_list ← empty
    mut list<BundleMember> tok_list ← empty

    for from members let m {
        let artifact.ContentIdentity id ← validate_identity(m.identity)
        let BundleMember clean ← BundleMember { role = m.role, container = m.container, shard_index = m.shard_index, identity = id }

        match clean.role {
            case Backbone {
                require container_name(clean.container) ≡ container_name(primary_container) throw variant BadRole { message = "backbone shard container must match bundle primary container" }

                backbone_raw.append(clean)
            }
            case Drafter {
                require drafter_list.length() ≡ 0 throw variant DuplicateRole { message = "duplicate drafter role in bundle" }

                drafter_list.append(clean)
            }
            case Vision {
                require vision_list.length() ≡ 0 throw variant DuplicateRole { message = "duplicate vision role in bundle" }

                vision_list.append(clean)
            }
            case Config {
                require config_list.length() ≡ 0 throw variant DuplicateRole { message = "duplicate config role in bundle" }

                config_list.append(clean)
            }
            case QuantConfig {
                require quant_list.length() ≡ 0 throw variant DuplicateRole { message = "duplicate quant_config role in bundle" }

                quant_list.append(clean)
            }
            case ShardIndex {
                require index_list.length() ≡ 0 throw variant DuplicateRole { message = "duplicate shard_index role in bundle" }

                index_list.append(clean)
            }
            case Tokenizer {
                require tok_list.length() ≡ 0 throw variant DuplicateRole { message = "duplicate tokenizer role in bundle" }

                tok_list.append(clean)
            }
        }
    }

    require backbone_raw.length() ≥ 1 throw variant MissingPrimary { message = "bundle requires at least one backbone member" }

    # Order and verify contiguous 0..N-1 backbone shard indices.
    let int shard_total ← backbone_raw.length()
    mut list<BundleMember> backbone_ordered ← empty

    for range 0 ‥ shard_total let expected_idx {
        mut int found ← -1

        for range 0 ‥ backbone_raw.length() let j {
            if backbone_raw[j].shard_index ≡ expected_idx {
                require found ≡ -1 throw variant DuplicateRole { message = "duplicate backbone shard_index §"(expected_idx ↦ string) }

                found ← j
            }
        }

        require found ≥ 0 throw variant BadRole { message = "missing backbone shard_index §"(expected_idx ↦ string) }

        backbone_ordered.append(backbone_raw[found])
    }

    # Validate shard_map consistency.
    match shard_map {
        case Indexed let entries {
            require index_list.length() ≡ 1 throw variant BadShardMap { message = "indexed shard_map requires a shard_index member" }

            require entries.length() ≥ 1 throw variant BadShardMap { message = "indexed shard_map requires at least one tensor entry" }

            mut list<string> seen_names ← empty

            for from entries let entry {
                require entry.tensor_name.length() ≥ 1 throw variant BadShardMap { message = "shard_map tensor_name must not be empty" }

                require entry.shard_index ≥ 0 and entry.shard_index ≺ shard_total throw variant BadShardMap { message = "shard_map shard_index § outside [0..§)"(entry.shard_index ↦ string, shard_total ↦ string) }

                require entry.tensor_name ∉ seen_names throw variant BadShardMap { message = "duplicate tensor_name in shard_map: §"(entry.tensor_name) }

                seen_names.append(entry.tensor_name)
            }
        }
        case Unindexed let count {
            require index_list.length() ≡ 0 throw variant BadShardMap { message = "shard_index member provided without indexed shard_map" }

            require count ≡ shard_total throw variant BadShardMap { message = "unindexed shard_count § does not match backbone shards §"(count ↦ string, shard_total ↦ string) }
        }
    }

    mut BundleMember ∪ none drafter_opt ← null
    mut BundleMember ∪ none vision_opt ← null
    mut BundleMember ∪ none config_opt ← null
    mut BundleMember ∪ none quant_opt ← null
    mut BundleMember ∪ none index_opt ← null
    mut BundleMember ∪ none tok_opt ← null

    if drafter_list.length() ≡ 1 then drafter_opt ← drafter_list[0]

    if vision_list.length() ≡ 1 then vision_opt ← vision_list[0]

    if config_list.length() ≡ 1 then config_opt ← config_list[0]

    if quant_list.length() ≡ 1 then quant_opt ← quant_list[0]

    if index_list.length() ≡ 1 then index_opt ← index_list[0]

    if tok_list.length() ≡ 1 then tok_opt ← tok_list[0]

    return ModelBundle { schema = BUNDLE_SCHEMA, primary_container = primary_container, backbone_shards = backbone_ordered, drafter = drafter_opt, vision = vision_opt, config = config_opt, quant_config = quant_opt, shard_index = index_opt, tokenizer = tok_opt, shard_map = shard_map }
}

# -------------------------------------------------------------------------
# Convenience constructors: single/dual GGUF, unindexed/indexed Safetensors
# -------------------------------------------------------------------------

@ public
fn gguf_single(artifact.ContentIdentity backbone) → ModelBundle ⇥ BundleError {
    let list<BundleMember> members ← [BundleMember { role = variant Backbone, container = variant Gguf, shard_index = 0, identity = backbone }]
    return admit_bundle(variant Gguf, members, variant Unindexed { shard_count = 1 })
}

@ public
fn gguf_paired(artifact.ContentIdentity backbone, artifact.ContentIdentity drafter) → ModelBundle ⇥ BundleError {
    let list<BundleMember> members ← [
        BundleMember { role = variant Backbone, container = variant Gguf, shard_index = 0, identity = backbone },
        BundleMember { role = variant Drafter, container = variant Gguf, shard_index = 0, identity = drafter }
    ]
    return admit_bundle(variant Gguf, members, variant Unindexed { shard_count = 1 })
}

fn append_optional_member(mut list<BundleMember> members, MemberRole role, ContainerKind container, artifact.ContentIdentity ∪ none id) {
    if id not is none {
        let artifact.ContentIdentity inner ← id coalesce artifact.ContentIdentity { algorithm = "", digest = "", length = 0 }
        members.append(BundleMember { role = role, container = container, shard_index = 0, identity = inner })
    }
}

@ public
fn safetensors_unindexed(list<artifact.ContentIdentity> shards, artifact.ContentIdentity ∪ none config, artifact.ContentIdentity ∪ none quant_config, artifact.ContentIdentity ∪ none tokenizer, artifact.ContentIdentity ∪ none drafter, artifact.ContentIdentity ∪ none vision) → ModelBundle ⇥ BundleError {
    require shards.length() ≥ 1 throw variant MissingPrimary { message = "bundle requires at least one backbone shard" }

    mut list<BundleMember> members ← empty

    for range 0 ‥ shards.length() let i {
        members.append(BundleMember { role = variant Backbone, container = variant Safetensors, shard_index = i, identity = shards[i] })
    }

    append_optional_member(mut members, variant Config, variant Safetensors, config)
    append_optional_member(mut members, variant QuantConfig, variant Safetensors, quant_config)
    append_optional_member(mut members, variant Tokenizer, variant Safetensors, tokenizer)
    append_optional_member(mut members, variant Drafter, variant Safetensors, drafter)
    append_optional_member(mut members, variant Vision, variant Safetensors, vision)
    return admit_bundle(variant Safetensors, members, variant Unindexed { shard_count = shards.length() })
}

@ public
fn safetensors_indexed(list<artifact.ContentIdentity> shards, artifact.ContentIdentity shard_index, list<ShardEntry> entries, artifact.ContentIdentity ∪ none config, artifact.ContentIdentity ∪ none quant_config, artifact.ContentIdentity ∪ none tokenizer, artifact.ContentIdentity ∪ none drafter, artifact.ContentIdentity ∪ none vision) → ModelBundle ⇥ BundleError {
    require shards.length() ≥ 1 throw variant MissingPrimary { message = "bundle requires at least one backbone shard" }

    mut list<BundleMember> members ← empty

    for range 0 ‥ shards.length() let i {
        members.append(BundleMember { role = variant Backbone, container = variant Safetensors, shard_index = i, identity = shards[i] })
    }

    members.append(BundleMember { role = variant ShardIndex, container = variant Safetensors, shard_index = 0, identity = shard_index })
    append_optional_member(mut members, variant Config, variant Safetensors, config)
    append_optional_member(mut members, variant QuantConfig, variant Safetensors, quant_config)
    append_optional_member(mut members, variant Tokenizer, variant Safetensors, tokenizer)
    append_optional_member(mut members, variant Drafter, variant Safetensors, drafter)
    append_optional_member(mut members, variant Vision, variant Safetensors, vision)
    return admit_bundle(variant Safetensors, members, variant Indexed { entries = entries })
}

# -------------------------------------------------------------------------
# Queries & deterministic wire serialization
# -------------------------------------------------------------------------

@ public
fn backbone_shard_count(ModelBundle b) → int {
    return b.backbone_shards.length()
}

@ public
fn backbone_shard(ModelBundle b, int index) → BundleMember ⇥ BundleError {
    require index ≥ 0 and index ≺ b.backbone_shards.length() throw variant BadRole { message = "backbone shard index § out of bounds"(index ↦ string) }

    return b.backbone_shards[index]
}

@ public
fn member_count(ModelBundle b) → int {
    mut int n ← b.backbone_shards.length()

    if b.drafter not is none then n ↑

    if b.vision not is none then n ↑

    if b.config not is none then n ↑

    if b.quant_config not is none then n ↑

    if b.shard_index not is none then n ↑

    if b.tokenizer not is none then n ↑

    return n
}

@ public
fn resolve_tensor_shard(ModelBundle b, string tensor_name) → int ⇥ BundleError {
    match b.shard_map {
        case Indexed let entries {
            for from entries let entry {
                if entry.tensor_name ≡ tensor_name then return entry.shard_index
            }

            throw variant BadShardMap { message = "tensor § not present in shard_map"(tensor_name) }
        }
        case Unindexed let count {
            throw variant BadShardMap { message = "bundle is unindexed; shard resolution requires header scan across § shards"(count ↦ string) }
        }
    }
}

fn optional_wire_part(string role, BundleMember ∪ none m) → string {
    if m is none then return "§=-"(role)

    let BundleMember inner ← m coalesce BundleMember { role = variant Backbone, container = variant Gguf, shard_index = 0, identity = artifact.ContentIdentity { algorithm = "", digest = "", length = 0 } }
    return "§=§:§"(role, container_name(inner.container), format_identity(inner.identity))
}

@ public
fn bundle_wire_identity(ModelBundle b) → string {
    mut string out ← "§|§|shards=§"(b.schema, container_name(b.primary_container), b.backbone_shards.length() ↦ string)

    for from b.backbone_shards let s {
        out ← "§|backbone[§]=§"(out, s.shard_index ↦ string, format_identity(s.identity))
    }

    out ← "§|§"(out, optional_wire_part("drafter", b.drafter))
    out ← "§|§"(out, optional_wire_part("vision", b.vision))
    out ← "§|§"(out, optional_wire_part("config", b.config))
    out ← "§|§"(out, optional_wire_part("quant_config", b.quant_config))
    out ← "§|§"(out, optional_wire_part("shard_index", b.shard_index))
    out ← "§|§"(out, optional_wire_part("tokenizer", b.tokenizer))

    match b.shard_map {
        case Indexed let entries {
            out ← "§|map=indexed:§"(out, entries.length() ↦ string)
        }
        case Unindexed let count {
            out ← "§|map=unindexed:§"(out, count ↦ string)
        }
    }

    return out
}

+++ faber test
import from "gradus:model/artifact" artifact

import from "gradus:model/bundle" bundle

fn make_id(string ch, int len) → artifact.ContentIdentity {
    mut string d ← ""
    for range 0 ‥ 64 let i {
        d ← d + ch
    }
    return artifact.identity("sha-256", d, len) ⊥ artifact.ContentIdentity { algorithm = "", digest = "", length = 0 }
}

fn admit_result(bundle.ContainerKind primary, list<bundle.BundleMember> members, bundle.ShardMapping map) → string {
    do {
        bundle.admit_bundle(primary, members, map)
        return "ok"
    }
    catch err {
        return err.message
    }
}

test "Single-file GGUF admits as a 1-member bundle" {
    do {
        let bundle.ModelBundle b ← bundle.gguf_single(make_id("a", 1024))
        assert bundle.backbone_shard_count(b) ≡ 1
        assert bundle.member_count(b) ≡ 1
        assert b.drafter is none
        assert b.vision is none
        assert b.shard_index is none
    }
    catch err {
        assert false
    }
}

test "Paired backbone + dflash GGUF admits as a 2-member bundle" {
    do {
        let bundle.ModelBundle b ← bundle.gguf_paired(make_id("a", 2048), make_id("b", 512))
        assert bundle.backbone_shard_count(b) ≡ 1
        assert bundle.member_count(b) ≡ 2
        assert b.drafter not is none
    }
    catch err {
        assert false
    }
}

test "Flint 5-shard zero-based Safetensors pack admits without shard_index" {
    do {
        let list<artifact.ContentIdentity> shards ← [make_id("0", 100), make_id("1", 101), make_id("2", 102), make_id("3", 103), make_id("4", 104)]
        let bundle.ModelBundle b ← bundle.safetensors_unindexed(shards, make_id("c", 64), null, make_id("a", 128), null, null)
        assert bundle.backbone_shard_count(b) ≡ 5
        assert bundle.member_count(b) ≡ 7
        assert b.shard_index is none
        assert b.quant_config is none
        assert b.vision is none
        let bundle.BundleMember s4 ← bundle.backbone_shard(b, 4)
        assert s4.shard_index ≡ 4
        assert s4.identity.length ≡ 104
    }
    catch err {
        assert false
    }
}

test "Indexed multi-shard Safetensors bundle resolves tensor shards deterministically" {
    do {
        let list<artifact.ContentIdentity> shards ← [make_id("0", 100), make_id("1", 101)]
        let list<bundle.ShardEntry> entries ← [
            bundle.ShardEntry { tensor_name = "model.embed_tokens.weight", shard_index = 0 },
            bundle.ShardEntry { tensor_name = "model.layers.0.self_attn.q_proj.weight", shard_index = 1 }
        ]
        let bundle.ModelBundle b ← bundle.safetensors_indexed(shards, make_id("f", 32), entries, make_id("c", 64), null, make_id("a", 128), null, null)
        assert bundle.resolve_tensor_shard(b, "model.embed_tokens.weight") ≡ 0
        assert bundle.resolve_tensor_shard(b, "model.layers.0.self_attn.q_proj.weight") ≡ 1
        let string wire1 ← bundle.bundle_wire_identity(b)
        let string wire2 ← bundle.bundle_wire_identity(b)
        assert wire1 ≡ wire2
    }
    catch err {
        assert false
    }
}

test "Duplicate roles, missing primary, and malformed identities fail closed" {
    let artifact.ContentIdentity good ← make_id("a", 128)
    let artifact.ContentIdentity bad ← artifact.ContentIdentity { algorithm = "md5", digest = "abc", length = 0 }
    assert admit_result(bundle.ContainerKind.Gguf, [], variant bundle.Unindexed { shard_count = 0 }) ≡ "bundle requires at least one backbone member"
    assert admit_result(bundle.ContainerKind.Gguf, [bundle.BundleMember { role = variant bundle.MemberRole.Backbone, container = variant bundle.ContainerKind.Gguf, shard_index = 0, identity = bad }], variant bundle.Unindexed { shard_count = 1 }) ≡ "unknown content identity algorithm: md5"
    assert admit_result(bundle.ContainerKind.Gguf, [
        bundle.BundleMember { role = variant bundle.MemberRole.Backbone, container = variant bundle.ContainerKind.Gguf, shard_index = 0, identity = good },
        bundle.BundleMember { role = variant bundle.MemberRole.Drafter, container = variant bundle.ContainerKind.Gguf, shard_index = 0, identity = good },
        bundle.BundleMember { role = variant bundle.MemberRole.Drafter, container = variant bundle.ContainerKind.Gguf, shard_index = 0, identity = good }
    ], variant bundle.Unindexed { shard_count = 1 }) ≡ "duplicate drafter role in bundle"
}
