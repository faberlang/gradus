+++
locale = "en"
+++
# Structural proof for the pathless content-identity surface. `faber check`
# proves this source type-checks; the focused `faber test` route remains
# auditor-owned because the imported-library provider seam is not executable
# in the current lane.

import from "gradus:model/artifact" artifact

fn identity_result(string algorithm, string digest, int length) → string {
    do {
        artifact.identity(algorithm, digest, length)
        return "ok"
    }
    catch err {
        return err.message
    }
}

test "accepts a content identity" {
    do {
        const artifact.ContentIdentity i ← artifact.identity("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 128)
        assert i.algorithm ≡ "sha-256"
        assert i.length ≡ 128
    }
    catch err {
        assert false
    }
}

test "rejects invalid algorithm, digest, and length claims" {
    assert identity_result("blake3", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 128) ≡ "unknown content identity algorithm: blake3"
    assert identity_result("sha-256", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", 128) ≡ "content digest must be 64 lower-case hexadecimal digits"
    assert identity_result("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 128) ≡ "content digest must be 64 lower-case hexadecimal digits"
    assert identity_result("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 0) ≡ "content length must be positive"
}
