# GGUF-A1a red proof: the pathless content-identity surface is intentionally
# referenced before its implementation exists. On 2026-08-12 the focused
# command `faber check --diagnostics src/model/artifact.proba` exited 1; its
# first divergence was SEM002:unknown_qualified_type at
# `artifact.IdentitasContenuti`.

importa ex "gradus:model/artifact" privata artifact

probandum "artifact identity red proof" {
    proba "accepts a content identity" {
        fac {
            fixum artifact.IdentitasContenuti i ← artifact.identitas(
                "sha-256",
                "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                128
            )
            adfirma i.algorithmus ≡ "sha-256"
            adfirma i.longitudo ≡ 128
        }
        cape err {
            adfirma falsum
        }
    }
}
