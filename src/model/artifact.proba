+++
locale = "la"
+++
# Structural proof for the pathless content-identity surface. `faber check`
# proves this source type-checks; the focused `faber test` route remains
# auditor-owned because the imported-library provider seam is not executable
# in the current lane.

importa ex "gradus:model/artifact" artifact

functio identity_result(textus algorithmus, textus digestio, numerus longitudo) → textus {
    fac {
        fixum artifact.IdentitasContenuti _ ← artifact.identitas(algorithmus, digestio, longitudo)
        redde "ok"
    }
    cape err {
        redde artifact.causa(err)
    }
}

probandum "artifact identity red proof" {
    proba "accepts a content identity" {
        fac {
            fixum artifact.IdentitasContenuti i ← artifact.identitas(
                "sha-256",
                "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                128
            )
            adfirma i.algorithmus ≡ "sha-256"
            adfirma i.longitudo ≡ 128
        }
        cape err {
            adfirma falsum
        }
    }

    proba "rejects invalid algorithm, digest, and length claims" {
        adfirma identity_result("blake3", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 128) ≡ "unknown content identity algorithm: blake3"
        adfirma identity_result("sha-256", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", 128) ≡ "content digest must be 64 lower-case hexadecimal digits"
        adfirma identity_result("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 128) ≡ "content digest must be 64 lower-case hexadecimal digits"
        adfirma identity_result("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 0) ≡ "content length must be positive"
    }
}
