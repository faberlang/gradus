+++
locale = "en"
+++
# MODEL-01-M3 qwen35moe configuration genus and metadata freeze (MODEL-01
# chain). Pins the frozen configuration rows from the delivery authority:
# every frozen value freezes through `congela` and the 55-entry metadata
# count is enforced; mutation family 1 (frozen qwen35moe/general/tokenizer
# identity value changed, required key missing, extra unknown qwen35moe.*
# key, metadata count divergence) fails with a typed first-divergence
# diagnostic naming the key. Tokenizer facts are frozen as identity only.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" manifestum

import from "gradus:model/qwen35moe" qwen35moe

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const int TOKENS_PIN ← 248320

const int MERGES_PIN ← 247587

fn _u8(int n) → list<int<u8>> {
    return [n % 256 ∷ int<u8>]
}

fn _u32(int n) → list<int<u8>> {
    return [n % 256 ∷ int<u8>, (n ⇒ 8) % 256 ∷ int<u8>, (n ⇒ 16) % 256 ∷ int<u8>, (n ⇒ 24) % 256 ∷ int<u8>]
}

fn _u64(int n) → list<int<u8>> {
    return [n % 256 ∷ int<u8>, (n ⇒ 8) % 256 ∷ int<u8>, (n ⇒ 16) % 256 ∷ int<u8>, (n ⇒ 24) % 256 ∷ int<u8>, (n ⇒ 32) % 256 ∷ int<u8>, (n ⇒ 40) % 256 ∷ int<u8>, (n ⇒ 48) % 256 ∷ int<u8>, (n ⇒ 56) % 256 ∷ int<u8>]
}

fn _iunge(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

# Package MIR has no textus->octeti extraction arm. This structural builder
# encodes only the finite ASCII key/value set the freeze corpora need.
fn _textus_bytes(string s) → list<int<u8>> {
    if s ≡ "general.architecture" then return [103, 101, 110, 101, 114, 97, 108, 46, 97, 114, 99, 104, 105, 116, 101, 99, 116, 117, 114, 101]
    if s ≡ "general.file_type" then return [103, 101, 110, 101, 114, 97, 108, 46, 102, 105, 108, 101, 95, 116, 121, 112, 101]
    if s ≡ "general.quantization_version" then return [103, 101, 110, 101, 114, 97, 108, 46, 113, 117, 97, 110, 116, 105, 122, 97, 116, 105, 111, 110, 95, 118, 101, 114, 115, 105, 111, 110]
    if s ≡ "qwen35moe" then return [113, 119, 101, 110, 51, 53, 109, 111, 101]
    if s ≡ "llama" then return [108, 108, 97, 109, 97]
    if s ≡ "qwen35moe.block_count" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 98, 108, 111, 99, 107, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen35moe.context_length" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 99, 111, 110, 116, 101, 120, 116, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "qwen35moe.embedding_length" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 101, 109, 98, 101, 100, 100, 105, 110, 103, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "qwen35moe.attention.head_count" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 104, 101, 97, 100, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen35moe.attention.head_count_kv" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 104, 101, 97, 100, 95, 99, 111, 117, 110, 116, 95, 107, 118]
    if s ≡ "qwen35moe.attention.key_length" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 107, 101, 121, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "qwen35moe.attention.value_length" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 118, 97, 108, 117, 101, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "qwen35moe.attention.layer_norm_rms_epsilon" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 108, 97, 121, 101, 114, 95, 110, 111, 114, 109, 95, 114, 109, 115, 95, 101, 112, 115, 105, 108, 111, 110]
    if s ≡ "qwen35moe.rope.freq_base" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 114, 111, 112, 101, 46, 102, 114, 101, 113, 95, 98, 97, 115, 101]
    if s ≡ "qwen35moe.rope.dimension_count" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 114, 111, 112, 101, 46, 100, 105, 109, 101, 110, 115, 105, 111, 110, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen35moe.rope.dimension_sections" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 114, 111, 112, 101, 46, 100, 105, 109, 101, 110, 115, 105, 111, 110, 95, 115, 101, 99, 116, 105, 111, 110, 115]
    if s ≡ "qwen35moe.expert_count" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 101, 120, 112, 101, 114, 116, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen35moe.expert_used_count" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 101, 120, 112, 101, 114, 116, 95, 117, 115, 101, 100, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen35moe.expert_feed_forward_length" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 101, 120, 112, 101, 114, 116, 95, 102, 101, 101, 100, 95, 102, 111, 114, 119, 97, 114, 100, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "qwen35moe.expert_shared_feed_forward_length" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 101, 120, 112, 101, 114, 116, 95, 115, 104, 97, 114, 101, 100, 95, 102, 101, 101, 100, 95, 102, 111, 114, 119, 97, 114, 100, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "qwen35moe.ssm.conv_kernel" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 115, 115, 109, 46, 99, 111, 110, 118, 95, 107, 101, 114, 110, 101, 108]
    if s ≡ "qwen35moe.ssm.state_size" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 115, 115, 109, 46, 115, 116, 97, 116, 101, 95, 115, 105, 122, 101]
    if s ≡ "qwen35moe.ssm.group_count" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 115, 115, 109, 46, 103, 114, 111, 117, 112, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen35moe.ssm.time_step_rank" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 115, 115, 109, 46, 116, 105, 109, 101, 95, 115, 116, 101, 112, 95, 114, 97, 110, 107]
    if s ≡ "qwen35moe.ssm.inner_size" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 115, 115, 109, 46, 105, 110, 110, 101, 114, 95, 115, 105, 122, 101]
    if s ≡ "qwen35moe.full_attention_interval" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 102, 117, 108, 108, 95, 97, 116, 116, 101, 110, 116, 105, 111, 110, 95, 105, 110, 116, 101, 114, 118, 97, 108]
    if s ≡ "qwen35moe.nextn_predict_layers" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 110, 101, 120, 116, 110, 95, 112, 114, 101, 100, 105, 99, 116, 95, 108, 97, 121, 101, 114, 115]
    if s ≡ "tokenizer.ggml.model" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 111, 100, 101, 108]
    if s ≡ "tokenizer.ggml.pre" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 112, 114, 101]
    if s ≡ "tokenizer.ggml.tokens" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115]
    if s ≡ "tokenizer.ggml.token_type" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 95, 116, 121, 112, 101]
    if s ≡ "tokenizer.ggml.merges" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 101, 114, 103, 101, 115]
    if s ≡ "tokenizer.ggml.eos_token_id" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 101, 111, 115, 95, 116, 111, 107, 101, 110, 95, 105, 100]
    if s ≡ "tokenizer.ggml.padding_token_id" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 112, 97, 100, 100, 105, 110, 103, 95, 116, 111, 107, 101, 110, 95, 105, 100]
    if s ≡ "tokenizer.ggml.bos_token_id" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 98, 111, 115, 95, 116, 111, 107, 101, 110, 95, 105, 100]
    if s ≡ "tokenizer.ggml.add_bos_token" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 97, 100, 100, 95, 98, 111, 115, 95, 116, 111, 107, 101, 110]
    if s ≡ "gpt2" then return [103, 112, 116, 50]
    if s ≡ "qwen35" then return [113, 119, 101, 110, 51, 53]
    if s ≡ "<s>" then return [60, 115, 62]
    if s ≡ "hello" then return [104, 101, 108, 108, 111]
    if s ≡ "qwen35moe.extra_fact" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 101, 120, 116, 114, 97, 95, 102, 97, 99, 116]
    # MODEL-01-M4 canonical-tensor name strings (globals + per-block suffixes).
    if s ≡ "output.weight" then return [111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "output_norm.weight" then return [111, 117, 116, 112, 117, 116, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_gate.weight" then return [46, 97, 116, 116, 110, 95, 103, 97, 116, 101, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_norm.weight" then return [46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_norm2.weight" then return [46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 50, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_qkv.weight" then return [46, 97, 116, 116, 110, 95, 113, 107, 118, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_down_exps.weight" then return [46, 102, 102, 110, 95, 100, 111, 119, 110, 95, 101, 120, 112, 115, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_down_shexp.weight" then return [46, 102, 102, 110, 95, 100, 111, 119, 110, 95, 115, 104, 101, 120, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_gate_exps.weight" then return [46, 102, 102, 110, 95, 103, 97, 116, 101, 95, 101, 120, 112, 115, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_gate_inp.weight" then return [46, 102, 102, 110, 95, 103, 97, 116, 101, 95, 105, 110, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_gate_inp_shexp.weight" then return [46, 102, 102, 110, 95, 103, 97, 116, 101, 95, 105, 110, 112, 95, 115, 104, 101, 120, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_gate_shexp.weight" then return [46, 102, 102, 110, 95, 103, 97, 116, 101, 95, 115, 104, 101, 120, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_up_exps.weight" then return [46, 102, 102, 110, 95, 117, 112, 95, 101, 120, 112, 115, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_up_shexp.weight" then return [46, 102, 102, 110, 95, 117, 112, 95, 115, 104, 101, 120, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".post_attention_norm.weight" then return [46, 112, 111, 115, 116, 95, 97, 116, 116, 101, 110, 116, 105, 111, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ssm_a" then return [46, 115, 115, 109, 95, 97]
    if s ≡ ".ssm_alpha.weight" then return [46, 115, 115, 109, 95, 97, 108, 112, 104, 97, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ssm_beta.weight" then return [46, 115, 115, 109, 95, 98, 101, 116, 97, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ssm_conv1d.weight" then return [46, 115, 115, 109, 95, 99, 111, 110, 118, 49, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ssm_dt.bias" then return [46, 115, 115, 109, 95, 100, 116, 46, 98, 105, 97, 115]
    if s ≡ ".ssm_norm.weight" then return [46, 115, 115, 109, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ssm_out.weight" then return [46, 115, 115, 109, 95, 111, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_k.weight" then return [46, 97, 116, 116, 110, 95, 107, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_k_norm.weight" then return [46, 97, 116, 116, 110, 95, 107, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_output.weight" then return [46, 97, 116, 116, 110, 95, 111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_q.weight" then return [46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_q_norm.weight" then return [46, 97, 116, 116, 110, 95, 113, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_v.weight" then return [46, 97, 116, 116, 110, 95, 118, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".nextn.eh_proj.weight" then return [46, 110, 101, 120, 116, 110, 46, 101, 104, 95, 112, 114, 111, 106, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".nextn.enorm.weight" then return [46, 110, 101, 120, 116, 110, 46, 101, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".nextn.hnorm.weight" then return [46, 110, 101, 120, 116, 110, 46, 104, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".nextn.shared_head_norm.weight" then return [46, 110, 101, 120, 116, 110, 46, 115, 104, 97, 114, 101, 100, 95, 104, 101, 97, 100, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    return []
}

fn _str(string s) → list<int<u8>> {
    const list<int<u8>> b ← _textus_bytes(s)
    return _iunge(_u64(b.length()), b)
}

fn _kv(string key, int typo, list<int<u8>> value) → list<int<u8>> {
    return _iunge(_iunge(_str(key), _u32(typo)), value)
}

# Key-bytes variant for generated filler keys ("general.extra.N").
fn _kv_bytes(list<int<u8>> key, int typo, list<int<u8>> value) → list<int<u8>> {
    return _iunge(_iunge(_iunge(_u64(key.length()), key), _u32(typo)), value)
}

fn _array(int typo, int count, list<int<u8>> value) → list<int<u8>> {
    return _iunge(_iunge(_u32(typo), _u64(count)), value)
}

fn _header(int tensorum, int metadata) → list<int<u8>> {
    return _iunge(_iunge([71, 71, 85, 70], _u32(3)), _iunge(_u64(tensorum), _u64(metadata)))
}

fn _cum_padding(list<int<u8>> table, int concordatio, int total, bool extra_data) → manifestum.GgufCorpus {
    const int data_offset ← (((table.length() + concordatio) - 1) / concordatio) * concordatio
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    if extra_data {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← b
    return manifestum.GgufCorpus {tabula = o, artifact_length = total, identitas = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = total}}
}

fn _plenum(list<int<u8>> table, int concordatio, int payload) → manifestum.GgufCorpus {
    const int data_offset ← (((table.length() + concordatio) - 1) / concordatio) * concordatio
    return _cum_padding(table, concordatio, data_offset + payload, false)
}

# "general.extra." followed by one or two ASCII digits.
fn _clavis_generalis_extra(int n) → list<int<u8>> {
    const list<int<u8>> prefix ← [103, 101, 110, 101, 114, 97, 108, 46, 101, 120, 116, 114, 97, 46]
    var list<int<u8>> out ← vacua
    for from prefix const p {
        out.append(p)
    }
    if n ≺ 10 {
        out.append(48 + n ∷ int<u8>)
    }
    else {
        out.append(48 + n / 10 ∷ int<u8>)
        out.append(48 + n % 10 ∷ int<u8>)
    }
    return out
}

fn _stringarum_itera(int count, list<int<u8>> bytes) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ count {
        for from bytes const b {
            out.append(b)
        }
        i ↑
    }
    return out
}

fn _u32_itera(int count) → list<int<u8>> {
    const list<int<u8>> four ← _u32(0)
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ count {
        for from four const b {
            out.append(b)
        }
        i ↑
    }
    return out
}

# The 34 frozen metadata rows plus 21 `general.extra.N` filler keys to the
# pinned 55-entry count. The three mutable facts are parameterized so each
# mutation-family-1 corpus differs in exactly one fact.
fn _corpus_mutatum(int block_count, bool cum_ssm, int embedding, bool extra_qwen, bool extra_general) → manifestum.GgufCorpus {
    var int count ← 55
    if not cum_ssm {
        count ← count - 1
    }
    if extra_qwen {
        count ← count + 1
    }
    if extra_general {
        count ← count + 1
    }
    var list<int<u8>> table ← _header(0, count)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen35moe")))
    table ← _iunge(table, _kv("general.file_type", 4, _u32(15)))
    table ← _iunge(table, _kv("general.quantization_version", 4, _u32(2)))
    table ← _iunge(table, _kv("qwen35moe.block_count", 4, _u32(block_count)))
    table ← _iunge(table, _kv("qwen35moe.context_length", 4, _u32(262144)))
    table ← _iunge(table, _kv("qwen35moe.embedding_length", 4, _u32(embedding)))
    table ← _iunge(table, _kv("qwen35moe.attention.head_count", 4, _u32(16)))
    table ← _iunge(table, _kv("qwen35moe.attention.head_count_kv", 4, _u32(2)))
    table ← _iunge(table, _kv("qwen35moe.attention.key_length", 4, _u32(256)))
    table ← _iunge(table, _kv("qwen35moe.attention.value_length", 4, _u32(256)))
    table ← _iunge(table, _kv("qwen35moe.attention.layer_norm_rms_epsilon", 6, [189, 55, 134, 53]))
    table ← _iunge(table, _kv("qwen35moe.rope.freq_base", 6, [128, 150, 24, 75]))
    table ← _iunge(table, _kv("qwen35moe.rope.dimension_count", 4, _u32(64)))
    table ← _iunge(table, _kv("qwen35moe.rope.dimension_sections", 9, _array(4, 4, _iunge(_iunge(_u32(11), _u32(11)), _iunge(_u32(10), _u32(0))))))
    table ← _iunge(table, _kv("qwen35moe.expert_count", 4, _u32(256)))
    table ← _iunge(table, _kv("qwen35moe.expert_used_count", 4, _u32(8)))
    table ← _iunge(table, _kv("qwen35moe.expert_feed_forward_length", 4, _u32(512)))
    table ← _iunge(table, _kv("qwen35moe.expert_shared_feed_forward_length", 4, _u32(512)))
    table ← _iunge(table, _kv("qwen35moe.ssm.conv_kernel", 4, _u32(4)))
    if cum_ssm {
        table ← _iunge(table, _kv("qwen35moe.ssm.state_size", 4, _u32(128)))
    }
    table ← _iunge(table, _kv("qwen35moe.ssm.group_count", 4, _u32(16)))
    table ← _iunge(table, _kv("qwen35moe.ssm.time_step_rank", 4, _u32(32)))
    table ← _iunge(table, _kv("qwen35moe.ssm.inner_size", 4, _u32(4096)))
    table ← _iunge(table, _kv("qwen35moe.full_attention_interval", 4, _u32(4)))
    table ← _iunge(table, _kv("qwen35moe.nextn_predict_layers", 4, _u32(1)))
    table ← _iunge(table, _kv("tokenizer.ggml.model", 8, _str("gpt2")))
    table ← _iunge(table, _kv("tokenizer.ggml.pre", 8, _str("qwen35")))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _array(8, TOKENS_PIN, _stringarum_itera(TOKENS_PIN, _str("<s>")))))
    table ← _iunge(table, _kv("tokenizer.ggml.token_type", 9, _array(4, TOKENS_PIN, _u32_itera(TOKENS_PIN))))
    table ← _iunge(table, _kv("tokenizer.ggml.merges", 9, _array(8, MERGES_PIN, _stringarum_itera(MERGES_PIN, _str("hello")))))
    table ← _iunge(table, _kv("tokenizer.ggml.eos_token_id", 4, _u32(248046)))
    table ← _iunge(table, _kv("tokenizer.ggml.padding_token_id", 4, _u32(248055)))
    table ← _iunge(table, _kv("tokenizer.ggml.bos_token_id", 4, _u32(248044)))
    table ← _iunge(table, _kv("tokenizer.ggml.add_bos_token", 7, _u8(0)))
    var int extra_count ← 21
    if extra_general {
        extra_count ← extra_count + 1
    }
    var int i ← 0
    while i ≺ extra_count {
        table ← _iunge(table, _kv_bytes(_clavis_generalis_extra(i), 4, _u32(1)))
        i ↑
    }
    if extra_qwen {
        table ← _iunge(table, _kv("qwen35moe.extra_fact", 4, _u32(1)))
    }
    return _plenum(table, 32, 0)
}

fn _freeze_manif(manifestum.GgufManifest m) → string {
    do {
        const qwen35moe.Qwen35moeConfig c ← qwen35moe.congela(m)
        return "ok"
    }
    catch err {
        return qwen35moe.message(err)
    }
}

fn _freeze_result(manifestum.GgufCorpus corpus) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        return _freeze_manif(m)
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _freeze_puncta_manif(manifestum.GgufManifest m) → bool {
    do {
        const qwen35moe.Qwen35moeConfig c ← qwen35moe.congela(m)
        assert c.architectura ≡ "qwen35moe"
        assert c.typus_limaturae ≡ 15
        assert c.versio_quantificationis ≡ 2
        assert c.numerus_tractuum ≡ 41
        assert c.longitudo_contextus ≡ 262144
        assert c.longitudo_vestimenti ≡ 2048
        assert c.numerus_capita ≡ 16
        assert c.numerus_capita_kv ≡ 2
        assert c.longitudo_clavis ≡ 256
        assert c.longitudo_valoris ≡ 256
        assert c.epsilon_normae_rms ≡ 0.0000009999999974752427 ∷ f32
        assert c.basis_frequentiae ≡ 10000000.0 ∷ f32
        assert c.numerus_dimensionum_rotae ≡ 64
        assert c.sectiones_rotae.get(0) coalesce 0 ≡ 11
        assert c.sectiones_rotae.get(1) coalesce 0 ≡ 11
        assert c.sectiones_rotae.get(2) coalesce 0 ≡ 10
        assert c.sectiones_rotae.get(3) coalesce 0 ≡ 0
        assert c.numerus_expertorum ≡ 256
        assert c.numerus_expertorum_activorum ≡ 8
        assert c.longitudo_ffn_experti ≡ 512
        assert c.longitudo_ffn_communi ≡ 512
        assert c.nucleus_convolutus ≡ 4
        assert c.magnitudo_status ≡ 128
        assert c.numerus_coetuum ≡ 16
        assert c.gradus_temporis ≡ 32
        assert c.magnitudo_interior ≡ 4096
        assert c.intervallum_attentionis_plenae ≡ 4
        assert c.numerus_strata_nextn ≡ 1
        assert c.exemplum_tokenizoris ≡ "gpt2"
        assert c.praeparatio_tokenizoris ≡ "qwen35"
        assert c.numerus_tokenum ≡ 248320
        assert c.numerus_typorum_tokenum ≡ 248320
        assert c.numerus_concatenationum ≡ 247587
        assert c.eos_token_id ≡ 248046
        assert c.padding_token_id ≡ 248055
        assert c.bos_token_id ≡ 248044
        assert c.add_bos_token ≡ false
        return true
    }
    catch err {
        return false
    }
}

fn _freeze_puncta() → bool {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(_corpus_mutatum(41, true, 2048, false, false))
        return _freeze_puncta_manif(m)
    }
    catch err {
        return false
    }
}

# -------------------------------------------------------------------------
# MODEL-01-M4 canonical 753-tensor corpus builder. GGML raw type ids: f32 0,
# q8_0 8, q4_K 12, q5_K 13, q6_K 14, bf16 30. Offsets are sequential payload
# offsets (the parser requires disjoint stored ranges), sized by the same
# block geometry the manifest parser resolves.
# -------------------------------------------------------------------------

fn _blk_bytes(int b) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    out.append(98 ∷ int<u8>)
    out.append(108 ∷ int<u8>)
    out.append(107 ∷ int<u8>)
    out.append(46 ∷ int<u8>)
    if b ≥ 10 {
        out.append(48 + b / 10 ∷ int<u8>)
    }
    out.append(48 + b % 10 ∷ int<u8>)
    return out
}

fn _blk_nome_bytes(int b, string suffix) → list<int<u8>> {
    const list<int<u8>> prefix ← _blk_bytes(b)
    const list<int<u8>> sfix ← _textus_bytes(suffix)
    var list<int<u8>> out ← vacua
    for from prefix const p {
        out.append(p)
    }
    for from sfix const s {
        out.append(s)
    }
    return out
}

fn _str_bytes(list<int<u8>> b) → list<int<u8>> {
    return _iunge(_u64(b.length()), b)
}

fn _tensors_length(list<int> forma, int typo) → int {
    var int elementa ← 1
    for from forma const d {
        elementa ← elementa * d
    }
    var int elementa_per_blockum ← 1
    var int octeti_per_blockum ← 4
    if typo ≡ 8 {
        elementa_per_blockum ← 32
        octeti_per_blockum ← 34
    }
    if typo ≡ 12 {
        elementa_per_blockum ← 256
        octeti_per_blockum ← 144
    }
    if typo ≡ 13 {
        elementa_per_blockum ← 256
        octeti_per_blockum ← 176
    }
    if typo ≡ 14 {
        elementa_per_blockum ← 256
        octeti_per_blockum ← 210
    }
    if typo ≡ 30 {
        elementa_per_blockum ← 1
        octeti_per_blockum ← 2
    }
    return (elementa / elementa_per_blockum) * octeti_per_blockum
}

fn _tensors_bytes(list<int<u8>> nomen, list<int> forma, int typo, int offset) → list<int<u8>> {
    var list<int<u8>> out ← _str_bytes(nomen)
    out ← _iunge(out, _u32(forma.length()))
    for from forma const d {
        out ← _iunge(out, _u64(d))
    }
    out ← _iunge(out, _u32(typo))
    out ← _iunge(out, _u64(offset))
    return out
}

# Accumulating tensor-table fragment: bytes built so far plus the next free
# payload offset.
class FragmentumTensorium {
    list<int<u8>> bytes
    int end
}

fn _append_tensorem(FragmentumTensorium f, list<int<u8>> nomen, list<int> forma, int typo) → FragmentumTensorium {
    const int longitudo ← _tensors_length(forma, typo)
    return FragmentumTensorium {bytes = _iunge(f.bytes, _tensors_bytes(nomen, forma, typo, f.end)), end = f.end + longitudo}
}

# Hybrid SSM/attention block tensor set (19); q6_K down family in blk.34/38.
fn _hybrida_fragments(FragmentumTensorium f, int b, bool renomine, bool down_abjecta, bool down_q6_recta, bool qkv_embd_depravata) → FragmentumTensorium {
    var FragmentumTensorium g ← f
    var string norm_suffix ← ".attn_norm.weight"
    if renomine and b ≡ 0 {
        norm_suffix ← ".attn_norm2.weight"
    }
    var list<int> down_forma ← [512, 2048, 256]
    if down_abjecta and b ≡ 0 {
        down_forma ← [512, 2048]
    }
    var int down_dtype ← 13
    if not down_q6_recta and (b ≡ 34 or b ≡ 38) {
        down_dtype ← 14
    }
    var list<int> qkv_forma ← [2048, 8192]
    if qkv_embd_depravata and b ≡ 0 {
        qkv_forma ← [1024, 8192]
    }
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".attn_gate.weight"), [2048, 4096], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(b, norm_suffix), [2048], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".attn_qkv.weight"), qkv_forma, 8)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_down_exps.weight"), down_forma, down_dtype)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_down_shexp.weight"), [512, 2048], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_exps.weight"), [2048, 512, 256], 12)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_inp.weight"), [2048, 256], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_inp_shexp.weight"), [2048], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_shexp.weight"), [2048, 512], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_up_exps.weight"), [2048, 512, 256], 12)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_up_shexp.weight"), [2048, 512], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".post_attention_norm.weight"), [2048], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ssm_a"), [32], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ssm_alpha.weight"), [2048, 32], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ssm_beta.weight"), [2048, 32], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ssm_conv1d.weight"), [4, 8192], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ssm_dt.bias"), [32], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ssm_norm.weight"), [128], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ssm_out.weight"), [4096, 2048], 8)
    return g
}

# Full-attention block tensor set (16); q6_K down family in blk.39.
fn _plena_fragments(FragmentumTensorium f, int b, bool down_q6_recta, bool attn_k_depravata) → FragmentumTensorium {
    var FragmentumTensorium g ← f
    var int down_dtype ← 13
    if not down_q6_recta and b ≡ 39 {
        down_dtype ← 14
    }
    var list<int> attn_k_forma ← [2048, 512]
    if attn_k_depravata and b ≡ 3 {
        attn_k_forma ← [2048, 256]
    }
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".attn_k.weight"), attn_k_forma, 8)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".attn_k_norm.weight"), [256], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".attn_norm.weight"), [2048], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".attn_output.weight"), [4096, 2048], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".attn_q.weight"), [2048, 8192], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".attn_q_norm.weight"), [256], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".attn_v.weight"), [2048, 512], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_down_exps.weight"), [512, 2048, 256], down_dtype)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_down_shexp.weight"), [512, 2048], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_exps.weight"), [2048, 512, 256], 12)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_inp.weight"), [2048, 256], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_inp_shexp.weight"), [2048], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_shexp.weight"), [2048, 512], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_up_exps.weight"), [2048, 512, 256], 12)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".ffn_up_shexp.weight"), [2048, 512], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(b, ".post_attention_norm.weight"), [2048], 0)
    return g
}

# Nextn block blk.40 tensor set (20): full-attention 16 with the frozen
# bf16 anomaly on ffn_gate_inp/ffn_gate_inp_shexp, plus the four nextn.*
# tensors.
fn _nextn_fragments(FragmentumTensorium f, bool bf16_recta, bool omitte_postremum) → FragmentumTensorium {
    var FragmentumTensorium g ← f
    var int inp_dtype ← 30
    if bf16_recta {
        inp_dtype ← 0
    }
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".attn_k.weight"), [2048, 512], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".attn_k_norm.weight"), [256], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".attn_norm.weight"), [2048], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".attn_output.weight"), [4096, 2048], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".attn_q.weight"), [2048, 8192], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".attn_q_norm.weight"), [256], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".attn_v.weight"), [2048, 512], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".ffn_down_exps.weight"), [512, 2048, 256], 13)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".ffn_down_shexp.weight"), [512, 2048], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".ffn_gate_exps.weight"), [2048, 512, 256], 12)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".ffn_gate_inp.weight"), [2048, 256], inp_dtype)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".ffn_gate_inp_shexp.weight"), [2048], inp_dtype)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".ffn_gate_shexp.weight"), [2048, 512], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".ffn_up_exps.weight"), [2048, 512, 256], 12)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".ffn_up_shexp.weight"), [2048, 512], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".post_attention_norm.weight"), [2048], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".nextn.eh_proj.weight"), [4096, 2048], 8)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".nextn.enorm.weight"), [2048], 0)
    g ← _append_tensorem(g, _blk_nome_bytes(40, ".nextn.hnorm.weight"), [2048], 0)
    if not omitte_postremum {
        g ← _append_tensorem(g, _blk_nome_bytes(40, ".nextn.shared_head_norm.weight"), [2048], 0)
    }
    return g
}

# The full canonical tensor table: 3 globals then blocks 0..40 classified by
# the frozen schedule (nextn at 40, full-attention at index ≡ 3 mod 4).
fn _canonici_fragments(bool renomine_attn_norm, bool down_abjecta, bool bf16_recta, bool down_q6_recta, bool omitte_postremum, bool qkv_embd_depravata, bool attn_k_depravata, int tractuum) → FragmentumTensorium {
    var FragmentumTensorium f ← FragmentumTensorium {bytes = vacua, end = 0}
    f ← _append_tensorem(f, _textus_bytes("output.weight"), [2048, 248320], 14)
    f ← _append_tensorem(f, _textus_bytes("output_norm.weight"), [2048], 0)
    f ← _append_tensorem(f, _textus_bytes("token_embd.weight"), [2048, 248320], 8)
    var int b ← 0
    while b ≺ tractuum {
        if b ≡ 40 {
            f ← _nextn_fragments(f, bf16_recta, omitte_postremum)
        }
        else {
            if b % 4 ≡ 3 {
                f ← _plena_fragments(f, b, down_q6_recta, attn_k_depravata)
            }
            else {
                f ← _hybrida_fragments(f, b, renomine_attn_norm, down_abjecta, down_q6_recta, qkv_embd_depravata)
            }
        }
        b ↑
    }
    return f
}

# The canonical corpus: the 55 frozen metadata entries (34 rows + 21 filler
# keys, the same set the M3 corpora carry) plus the tensor table.
fn _corpus_tensorium(FragmentumTensorium fragmenta, int tensorum) → manifestum.GgufCorpus {
    return _corpus_tensorium_arch(fragmenta, tensorum, "qwen35moe")
}

# Canonical corpus with a caller-picked `general.architecture` value
# (MODEL-01-M6 family-7 unsupported-but-inspectable oracle).
fn _corpus_tensorium_arch(FragmentumTensorium fragmenta, int tensorum, string architectura) → manifestum.GgufCorpus {
    var list<int<u8>> table ← _header(tensorum, 55)
    table ← _iunge(table, _kv("general.architecture", 8, _str(architectura)))
    table ← _iunge(table, _kv("general.file_type", 4, _u32(15)))
    table ← _iunge(table, _kv("general.quantization_version", 4, _u32(2)))
    table ← _iunge(table, _kv("qwen35moe.block_count", 4, _u32(41)))
    table ← _iunge(table, _kv("qwen35moe.context_length", 4, _u32(262144)))
    table ← _iunge(table, _kv("qwen35moe.embedding_length", 4, _u32(2048)))
    table ← _iunge(table, _kv("qwen35moe.attention.head_count", 4, _u32(16)))
    table ← _iunge(table, _kv("qwen35moe.attention.head_count_kv", 4, _u32(2)))
    table ← _iunge(table, _kv("qwen35moe.attention.key_length", 4, _u32(256)))
    table ← _iunge(table, _kv("qwen35moe.attention.value_length", 4, _u32(256)))
    table ← _iunge(table, _kv("qwen35moe.attention.layer_norm_rms_epsilon", 6, [189, 55, 134, 53]))
    table ← _iunge(table, _kv("qwen35moe.rope.freq_base", 6, [128, 150, 24, 75]))
    table ← _iunge(table, _kv("qwen35moe.rope.dimension_count", 4, _u32(64)))
    table ← _iunge(table, _kv("qwen35moe.rope.dimension_sections", 9, _array(4, 4, _iunge(_iunge(_u32(11), _u32(11)), _iunge(_u32(10), _u32(0))))))
    table ← _iunge(table, _kv("qwen35moe.expert_count", 4, _u32(256)))
    table ← _iunge(table, _kv("qwen35moe.expert_used_count", 4, _u32(8)))
    table ← _iunge(table, _kv("qwen35moe.expert_feed_forward_length", 4, _u32(512)))
    table ← _iunge(table, _kv("qwen35moe.expert_shared_feed_forward_length", 4, _u32(512)))
    table ← _iunge(table, _kv("qwen35moe.ssm.conv_kernel", 4, _u32(4)))
    table ← _iunge(table, _kv("qwen35moe.ssm.state_size", 4, _u32(128)))
    table ← _iunge(table, _kv("qwen35moe.ssm.group_count", 4, _u32(16)))
    table ← _iunge(table, _kv("qwen35moe.ssm.time_step_rank", 4, _u32(32)))
    table ← _iunge(table, _kv("qwen35moe.ssm.inner_size", 4, _u32(4096)))
    table ← _iunge(table, _kv("qwen35moe.full_attention_interval", 4, _u32(4)))
    table ← _iunge(table, _kv("qwen35moe.nextn_predict_layers", 4, _u32(1)))
    table ← _iunge(table, _kv("tokenizer.ggml.model", 8, _str("gpt2")))
    table ← _iunge(table, _kv("tokenizer.ggml.pre", 8, _str("qwen35")))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _array(8, TOKENS_PIN, _stringarum_itera(TOKENS_PIN, _str("<s>")))))
    table ← _iunge(table, _kv("tokenizer.ggml.token_type", 9, _array(4, TOKENS_PIN, _u32_itera(TOKENS_PIN))))
    table ← _iunge(table, _kv("tokenizer.ggml.merges", 9, _array(8, MERGES_PIN, _stringarum_itera(MERGES_PIN, _str("hello")))))
    table ← _iunge(table, _kv("tokenizer.ggml.eos_token_id", 4, _u32(248046)))
    table ← _iunge(table, _kv("tokenizer.ggml.padding_token_id", 4, _u32(248055)))
    table ← _iunge(table, _kv("tokenizer.ggml.bos_token_id", 4, _u32(248044)))
    table ← _iunge(table, _kv("tokenizer.ggml.add_bos_token", 7, _u8(0)))
    var int i ← 0
    while i ≺ 21 {
        table ← _iunge(table, _kv_bytes(_clavis_generalis_extra(i), 4, _u32(1)))
        i ↑
    }
    table ← _iunge(table, fragmenta.bytes)
    return _plenum(table, 32, fragmenta.end + 1)
}

fn _tensors_manif(manifestum.GgufManifest m) → string {
    do {
        const qwen35moe.QwenTensorSummary s ← qwen35moe.tensores_canonici(m)
        return "ok"
    }
    catch err {
        return qwen35moe.causa_tensors(err)
    }
}

fn _tensors_result(manifestum.GgufCorpus corpus) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        return _tensors_manif(m)
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _tensors_puncta() → bool {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(_corpus_tensorium(_canonici_fragments(false, false, false, false, false, false, false, 41), 753))
        do {
            const qwen35moe.QwenTensorSummary s ← qwen35moe.tensores_canonici(m)
            assert s.totalis ≡ 753
            assert s.globalium ≡ 3
            assert s.hybridorum ≡ 30
            assert s.attentionis_plenae ≡ 10
            assert s.nextn ≡ 1
            assert s.stipula_f32 ≡ 368
            assert s.stipula_q8_0 ≡ 259
            assert s.stipula_q4_k ≡ 82
            assert s.stipula_q5_k ≡ 38
            assert s.stipula_q6_k ≡ 4
            assert s.stipula_bf16 ≡ 2
            assert s.experti_rank3 ≡ 123
            return true
        }
        catch err {
            return false
        }
    }
    catch err {
        return false
    }
}

# -------------------------------------------------------------------------
# MODEL-01-M5 cross-reference oracle helpers: freeze the config (M3), then
# run the dimension/storage cross-reference validator against the manifest.
# -------------------------------------------------------------------------

fn _referantia_manif(manifestum.GgufManifest m) → string {
    do {
        const qwen35moe.Qwen35moeConfig c ← qwen35moe.congela(m)
        do {
            const bool ok ← qwen35moe.referantia(c, m)
            return "ok"
        }
        catch err {
            return qwen35moe.causa_referantiae(err)
        }
        return "ok"
    }
    catch err {
        return qwen35moe.message(err)
    }
}

fn _referantia_result(manifestum.GgufCorpus corpus) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        return _referantia_manif(m)
    }
    catch err {
        return manifestum.message(err)
    }
}

test "canonical family sets, 41-block schedule, storage distribution and anomalies pin" {
    assert _tensors_result(_corpus_tensorium(_canonici_fragments(false, false, false, false, false, false, false, 41), 753)) ≡ "ok"
    assert _tensors_puncta()
}

test "mutation family 2: a canonical tensor rename yields a typed name diagnostic naming the first diverging fact" {
    assert _tensors_result(_corpus_tensorium(_canonici_fragments(true, false, false, false, false, false, false, 41), 753)) ≡ "qwen35moe tensor name divergence at blk.0.attn_norm.weight"
}

test "mutation family 3: a rank-3 expert tensor collapsed to rank-2 yields a typed shape diagnostic" {
    assert _tensors_result(_corpus_tensorium(_canonici_fragments(false, true, false, false, false, false, false, 41), 753)) ≡ "qwen35moe tensor shape divergence at blk.0.ffn_down_exps.weight"
}

test "mutation family 4: the blk.40 bf16 anomaly corrected away fails typed; the blk.34/38/39 q6_K anomaly corrected away fails typed" {
    assert _tensors_result(_corpus_tensorium(_canonici_fragments(false, false, true, false, false, false, false, 41), 753)) ≡ "qwen35moe tensor storage divergence at blk.40.ffn_gate_inp.weight"
    assert _tensors_result(_corpus_tensorium(_canonici_fragments(false, false, false, true, false, false, false, 41), 753)) ≡ "qwen35moe tensor storage divergence at blk.34.ffn_down_exps.weight"
}

test "mutation family 5: the tensor count 753→752 yields a typed count diagnostic" {
    assert _tensors_result(_corpus_tensorium(_canonici_fragments(false, false, false, false, true, false, false, 41), 752)) ≡ "qwen35moe tensor count divergence: tensor count 752 ≠ 753"
}

test "every cross-reference pin type-checks on the canonical corpus" {
    assert _referantia_result(_corpus_tensorium(_canonici_fragments(false, false, false, false, false, false, false, 41), 753)) ≡ "ok"
}

test "a deliberate cross-fact violation (attn_qkv embedding dim ≠ 2048) yields the typed first-divergence diagnostic" {
    assert _referantia_result(_corpus_tensorium(_canonici_fragments(false, false, false, false, false, true, false, 41), 753)) ≡ "qwen35moe cross-reference dimension divergence at blk.0.attn_qkv.weight"
}

test "a deliberate cross-fact violation (head_count_kv × key_length ≠ dim 1 of attn_k) yields the typed first-divergence diagnostic" {
    assert _referantia_result(_corpus_tensorium(_canonici_fragments(false, false, false, false, false, false, true, 41), 753)) ≡ "qwen35moe cross-reference dimension divergence at blk.3.attn_k.weight"
}

test "freezes every frozen config row with the metadata count pinned at 55" {
    assert _freeze_result(_corpus_mutatum(41, true, 2048, false, false)) ≡ "ok"
    assert _freeze_puncta()
}

test "mutation family 1: a frozen qwen35moe value change yields a typed diagnostic naming the first diverging key" {
    assert _freeze_result(_corpus_mutatum(42, true, 2048, false, false)) ≡ "qwen35moe metadata divergence at qwen35moe.block_count"
    assert _freeze_result(_corpus_mutatum(41, true, 1024, false, false)) ≡ "qwen35moe metadata divergence at qwen35moe.embedding_length"
}

test "mutation family 1: a missing required key yields a typed diagnostic naming that key" {
    assert _freeze_result(_corpus_mutatum(41, false, 2048, false, false)) ≡ "qwen35moe metadata divergence at qwen35moe.ssm.state_size"
}

test "mutation family 1: an extra unknown qwen35moe.* key fails closed" {
    assert _freeze_result(_corpus_mutatum(41, true, 2048, true, false)) ≡ "qwen35moe metadata divergence at qwen35moe.extra_fact"
}

test "mutation family 1: a metadata count divergence yields a typed diagnostic" {
    assert _freeze_result(_corpus_mutatum(41, true, 2048, false, true)) ≡ "qwen35moe metadata divergence at metadata count"
}

# -------------------------------------------------------------------------
# MODEL-01-M6 admission entry point + identity precondition + typed
# refusal matrix. `admitto` composes identity precondition (family 6,
# before any architecture read) -> config freeze (M3) -> canonical tensor
# map (M4) -> cross-reference validation (M5) and returns ADMIT with the
# frozen configuration + the 753-tensor receipt. Family 7 refuses an
# unknown architecture name or raw GGML type as unsupported-but-
# inspectable (stays inspectable as data per GGUF-A1a, cannot admit).
# -------------------------------------------------------------------------

const string F_DIGEST_MALA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# One unknown-raw-GGML-type tensor (type id 999, Ignota layout).
fn _fragment_dtype_ignoto() → FragmentumTensorium {
    var FragmentumTensorium f ← FragmentumTensorium {bytes = vacua, end = 0}
    return _append_tensorem(f, _blk_nome_bytes(0, ".attn_norm.weight"), [2048], 999)
}

fn _canonici_corpus() → manifestum.GgufCorpus {
    return _corpus_tensorium(_canonici_fragments(false, false, false, false, false, false, false, 41), 753)
}

fn _admission_result(manifestum.GgufCorpus corpus, string digestio, int longitudo) → string {
    do {
        const qwen35moe.Qwen35moeAdmission a ← qwen35moe.admit(corpus, digestio, longitudo)
        return "ADMIT"
    }
    catch err {
        return qwen35moe.causa_admissionis(err)
    }
}

fn _admission_puncta(manifestum.GgufCorpus corpus) → bool {
    do {
        const qwen35moe.Qwen35moeAdmission a ← qwen35moe.admit(corpus, F_DIGEST, corpus.artifact_length)
        assert a.config.architectura ≡ "qwen35moe"
        assert a.config.typus_limaturae ≡ 15
        assert a.config.versio_quantificationis ≡ 2
        assert a.config.numerus_tractuum ≡ 41
        assert a.config.longitudo_contextus ≡ 262144
        assert a.config.longitudo_vestimenti ≡ 2048
        assert a.config.numerus_capita ≡ 16
        assert a.config.numerus_capita_kv ≡ 2
        assert a.config.longitudo_clavis ≡ 256
        assert a.config.longitudo_valoris ≡ 256
        assert a.config.epsilon_normae_rms ≡ 0.0000009999999974752427 ∷ f32
        assert a.config.basis_frequentiae ≡ 10000000.0 ∷ f32
        assert a.config.numerus_dimensionum_rotae ≡ 64
        assert a.config.sectiones_rotae.get(0) coalesce 0 ≡ 11
        assert a.config.sectiones_rotae.get(1) coalesce 0 ≡ 11
        assert a.config.sectiones_rotae.get(2) coalesce 0 ≡ 10
        assert a.config.sectiones_rotae.get(3) coalesce 0 ≡ 0
        assert a.config.numerus_expertorum ≡ 256
        assert a.config.numerus_expertorum_activorum ≡ 8
        assert a.config.longitudo_ffn_experti ≡ 512
        assert a.config.longitudo_ffn_communi ≡ 512
        assert a.config.nucleus_convolutus ≡ 4
        assert a.config.magnitudo_status ≡ 128
        assert a.config.numerus_coetuum ≡ 16
        assert a.config.gradus_temporis ≡ 32
        assert a.config.magnitudo_interior ≡ 4096
        assert a.config.intervallum_attentionis_plenae ≡ 4
        assert a.config.numerus_strata_nextn ≡ 1
        assert a.config.exemplum_tokenizoris ≡ "gpt2"
        assert a.config.praeparatio_tokenizoris ≡ "qwen35"
        assert a.config.numerus_tokenum ≡ 248320
        assert a.config.numerus_typorum_tokenum ≡ 248320
        assert a.config.numerus_concatenationum ≡ 247587
        assert a.config.eos_token_id ≡ 248046
        assert a.config.padding_token_id ≡ 248055
        assert a.config.bos_token_id ≡ 248044
        assert a.config.add_bos_token ≡ false
        assert a.summa.totalis ≡ 753
        assert a.summa.globalium ≡ 3
        assert a.summa.hybridorum ≡ 30
        assert a.summa.attentionis_plenae ≡ 10
        assert a.summa.nextn ≡ 1
        assert a.summa.stipula_f32 ≡ 368
        assert a.summa.stipula_q8_0 ≡ 259
        assert a.summa.stipula_q4_k ≡ 82
        assert a.summa.stipula_q5_k ≡ 38
        assert a.summa.stipula_q6_k ≡ 4
        assert a.summa.stipula_bf16 ≡ 2
        assert a.summa.experti_rank3 ≡ 123
        return true
    }
    catch err {
        return false
    }
}

test "ADMIT returns the frozen configuration and the 753-tensor receipt on the exact frozen facts" {
    {
        const manifestum.GgufCorpus corpus ← _canonici_corpus()
        assert _admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "ADMIT"
        assert _admission_puncta(corpus)
    }
}

test "family 6: a wrong SHA-256 fails with the identity diagnostic before any architecture read" {
    {
        const manifestum.GgufCorpus corpus ← _canonici_corpus()
        assert _admission_result(corpus, F_DIGEST_MALA, corpus.artifact_length) ≡ "qwen35moe admission identity divergence: SHA-256"
    }
}

test "family 6: a wrong byte length fails with the identity diagnostic before any architecture read" {
    {
        const manifestum.GgufCorpus corpus ← _canonici_corpus()
        assert _admission_result(corpus, F_DIGEST, corpus.artifact_length + 1) ≡ "qwen35moe admission identity divergence: byte length"
    }
}

test "family 6 precedes any architecture read: a llama corpus with a wrong digest yields the identity diagnostic" {
    {
        const manifestum.GgufCorpus corpus ← _corpus_tensorium_arch(_canonici_fragments(false, false, false, false, false, false, false, 41), 753, "llama")
        assert _admission_result(corpus, F_DIGEST_MALA, corpus.artifact_length) ≡ "qwen35moe admission identity divergence: SHA-256"
    }
}

test "family 7: an unknown architecture stays inspectable as data but cannot admit" {
    {
        const manifestum.GgufCorpus corpus ← _corpus_tensorium_arch(_canonici_fragments(false, false, false, false, false, false, false, 41), 753, "llama")
        assert _admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe admission refusal: unsupported-but-inspectable architecture llama"
    }
}

test "family 7: an unknown raw GGML type stays inspectable as data but cannot admit" {
    {
        const manifestum.GgufCorpus corpus ← _corpus_tensorium(_fragment_dtype_ignoto(), 1)
        assert _admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe admission refusal: unsupported-but-inspectable raw GGML type at blk.0.attn_norm.weight"
    }
}

test "family 1 through admission: a frozen metadata divergence yields the typed diagnostic" {
    {
        const manifestum.GgufCorpus corpus ← _corpus_mutatum(42, true, 2048, false, false)
        assert _admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe metadata divergence at qwen35moe.block_count"
    }
}

test "families 2-5 through admission: name, shape, storage, and count divergences yield the typed diagnostics" {
    {
        const manifestum.GgufCorpus corpus ← _corpus_tensorium(_canonici_fragments(true, false, false, false, false, false, false, 41), 753)
        assert _admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe tensor name divergence at blk.0.attn_norm.weight"
    }
    {
        const manifestum.GgufCorpus corpus ← _corpus_tensorium(_canonici_fragments(false, true, false, false, false, false, false, 41), 753)
        assert _admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe tensor shape divergence at blk.0.ffn_down_exps.weight"
    }
    {
        const manifestum.GgufCorpus corpus ← _corpus_tensorium(_canonici_fragments(false, false, true, false, false, false, false, 41), 753)
        assert _admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe tensor storage divergence at blk.40.ffn_gate_inp.weight"
    }
    {
        const manifestum.GgufCorpus corpus ← _corpus_tensorium(_canonici_fragments(false, false, false, false, true, false, false, 41), 752)
        assert _admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe tensor count divergence: tensor count 752 ≠ 753"
    }
}

test "M5 cross-reference divergences surface through the admission entry" {
    {
        const manifestum.GgufCorpus corpus ← _corpus_tensorium(_canonici_fragments(false, false, false, false, false, true, false, 41), 753)
        assert _admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe cross-reference dimension divergence at blk.0.attn_qkv.weight"
    }
}
