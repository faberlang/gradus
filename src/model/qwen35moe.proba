+++
locale = "la"
+++
# MODEL-01-M3 qwen35moe configuration genus and metadata freeze (MODEL-01
# chain). Pins the frozen configuration rows from the delivery authority:
# every frozen value freezes through `congela` and the 55-entry metadata
# count is enforced; mutation family 1 (frozen qwen35moe/general/tokenizer
# identity value changed, required key missing, extra unknown qwen35moe.*
# key, metadata count divergence) fails with a typed first-divergence
# diagnostic naming the key. Tokenizer facts are frozen as identity only.

importa ex "gradus:model/artifact" artifact
importa ex "gradus:model/gguf_manifest" manifestum
importa ex "gradus:model/qwen35moe" qwen35moe

fixum textus F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fixum numerus TOKENS_PIN ← 248320
fixum numerus MERGES_PIN ← 247587

functio _u8(numerus n) → lista<numerus<u8>> {
    redde [(n % 256) ∷ numerus<u8>]
}

functio _u32(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>,
        ((n ⇒ 16) % 256) ∷ numerus<u8>,
        ((n ⇒ 24) % 256) ∷ numerus<u8>
    ]
}

functio _u64(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>,
        ((n ⇒ 16) % 256) ∷ numerus<u8>,
        ((n ⇒ 24) % 256) ∷ numerus<u8>,
        ((n ⇒ 32) % 256) ∷ numerus<u8>,
        ((n ⇒ 40) % 256) ∷ numerus<u8>,
        ((n ⇒ 48) % 256) ∷ numerus<u8>,
        ((n ⇒ 56) % 256) ∷ numerus<u8>
    ]
}

functio _iunge(lista<numerus<u8>> a, lista<numerus<u8>> b) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    itera ex a fixum x { out.appende(x) }
    itera ex b fixum x { out.appende(x) }
    redde out
}

# Package MIR has no textus->octeti extraction arm. This structural builder
# encodes only the finite ASCII key/value set the freeze corpora need.
functio _textus_bytes(textus s) → lista<numerus<u8>> {
    si s ≡ "general.architecture" ergo redde [103,101,110,101,114,97,108,46,97,114,99,104,105,116,101,99,116,117,114,101]
    si s ≡ "general.file_type" ergo redde [103,101,110,101,114,97,108,46,102,105,108,101,95,116,121,112,101]
    si s ≡ "general.quantization_version" ergo redde [103,101,110,101,114,97,108,46,113,117,97,110,116,105,122,97,116,105,111,110,95,118,101,114,115,105,111,110]
    si s ≡ "qwen35moe" ergo redde [113,119,101,110,51,53,109,111,101]
    si s ≡ "llama" ergo redde [108,108,97,109,97]
    si s ≡ "qwen35moe.block_count" ergo redde [113,119,101,110,51,53,109,111,101,46,98,108,111,99,107,95,99,111,117,110,116]
    si s ≡ "qwen35moe.context_length" ergo redde [113,119,101,110,51,53,109,111,101,46,99,111,110,116,101,120,116,95,108,101,110,103,116,104]
    si s ≡ "qwen35moe.embedding_length" ergo redde [113,119,101,110,51,53,109,111,101,46,101,109,98,101,100,100,105,110,103,95,108,101,110,103,116,104]
    si s ≡ "qwen35moe.attention.head_count" ergo redde [113,119,101,110,51,53,109,111,101,46,97,116,116,101,110,116,105,111,110,46,104,101,97,100,95,99,111,117,110,116]
    si s ≡ "qwen35moe.attention.head_count_kv" ergo redde [113,119,101,110,51,53,109,111,101,46,97,116,116,101,110,116,105,111,110,46,104,101,97,100,95,99,111,117,110,116,95,107,118]
    si s ≡ "qwen35moe.attention.key_length" ergo redde [113,119,101,110,51,53,109,111,101,46,97,116,116,101,110,116,105,111,110,46,107,101,121,95,108,101,110,103,116,104]
    si s ≡ "qwen35moe.attention.value_length" ergo redde [113,119,101,110,51,53,109,111,101,46,97,116,116,101,110,116,105,111,110,46,118,97,108,117,101,95,108,101,110,103,116,104]
    si s ≡ "qwen35moe.attention.layer_norm_rms_epsilon" ergo redde [113,119,101,110,51,53,109,111,101,46,97,116,116,101,110,116,105,111,110,46,108,97,121,101,114,95,110,111,114,109,95,114,109,115,95,101,112,115,105,108,111,110]
    si s ≡ "qwen35moe.rope.freq_base" ergo redde [113,119,101,110,51,53,109,111,101,46,114,111,112,101,46,102,114,101,113,95,98,97,115,101]
    si s ≡ "qwen35moe.rope.dimension_count" ergo redde [113,119,101,110,51,53,109,111,101,46,114,111,112,101,46,100,105,109,101,110,115,105,111,110,95,99,111,117,110,116]
    si s ≡ "qwen35moe.rope.dimension_sections" ergo redde [113,119,101,110,51,53,109,111,101,46,114,111,112,101,46,100,105,109,101,110,115,105,111,110,95,115,101,99,116,105,111,110,115]
    si s ≡ "qwen35moe.expert_count" ergo redde [113,119,101,110,51,53,109,111,101,46,101,120,112,101,114,116,95,99,111,117,110,116]
    si s ≡ "qwen35moe.expert_used_count" ergo redde [113,119,101,110,51,53,109,111,101,46,101,120,112,101,114,116,95,117,115,101,100,95,99,111,117,110,116]
    si s ≡ "qwen35moe.expert_feed_forward_length" ergo redde [113,119,101,110,51,53,109,111,101,46,101,120,112,101,114,116,95,102,101,101,100,95,102,111,114,119,97,114,100,95,108,101,110,103,116,104]
    si s ≡ "qwen35moe.expert_shared_feed_forward_length" ergo redde [113,119,101,110,51,53,109,111,101,46,101,120,112,101,114,116,95,115,104,97,114,101,100,95,102,101,101,100,95,102,111,114,119,97,114,100,95,108,101,110,103,116,104]
    si s ≡ "qwen35moe.ssm.conv_kernel" ergo redde [113,119,101,110,51,53,109,111,101,46,115,115,109,46,99,111,110,118,95,107,101,114,110,101,108]
    si s ≡ "qwen35moe.ssm.state_size" ergo redde [113,119,101,110,51,53,109,111,101,46,115,115,109,46,115,116,97,116,101,95,115,105,122,101]
    si s ≡ "qwen35moe.ssm.group_count" ergo redde [113,119,101,110,51,53,109,111,101,46,115,115,109,46,103,114,111,117,112,95,99,111,117,110,116]
    si s ≡ "qwen35moe.ssm.time_step_rank" ergo redde [113,119,101,110,51,53,109,111,101,46,115,115,109,46,116,105,109,101,95,115,116,101,112,95,114,97,110,107]
    si s ≡ "qwen35moe.ssm.inner_size" ergo redde [113,119,101,110,51,53,109,111,101,46,115,115,109,46,105,110,110,101,114,95,115,105,122,101]
    si s ≡ "qwen35moe.full_attention_interval" ergo redde [113,119,101,110,51,53,109,111,101,46,102,117,108,108,95,97,116,116,101,110,116,105,111,110,95,105,110,116,101,114,118,97,108]
    si s ≡ "qwen35moe.nextn_predict_layers" ergo redde [113,119,101,110,51,53,109,111,101,46,110,101,120,116,110,95,112,114,101,100,105,99,116,95,108,97,121,101,114,115]
    si s ≡ "tokenizer.ggml.model" ergo redde [116,111,107,101,110,105,122,101,114,46,103,103,109,108,46,109,111,100,101,108]
    si s ≡ "tokenizer.ggml.pre" ergo redde [116,111,107,101,110,105,122,101,114,46,103,103,109,108,46,112,114,101]
    si s ≡ "tokenizer.ggml.tokens" ergo redde [116,111,107,101,110,105,122,101,114,46,103,103,109,108,46,116,111,107,101,110,115]
    si s ≡ "tokenizer.ggml.token_type" ergo redde [116,111,107,101,110,105,122,101,114,46,103,103,109,108,46,116,111,107,101,110,95,116,121,112,101]
    si s ≡ "tokenizer.ggml.merges" ergo redde [116,111,107,101,110,105,122,101,114,46,103,103,109,108,46,109,101,114,103,101,115]
    si s ≡ "tokenizer.ggml.eos_token_id" ergo redde [116,111,107,101,110,105,122,101,114,46,103,103,109,108,46,101,111,115,95,116,111,107,101,110,95,105,100]
    si s ≡ "tokenizer.ggml.padding_token_id" ergo redde [116,111,107,101,110,105,122,101,114,46,103,103,109,108,46,112,97,100,100,105,110,103,95,116,111,107,101,110,95,105,100]
    si s ≡ "tokenizer.ggml.bos_token_id" ergo redde [116,111,107,101,110,105,122,101,114,46,103,103,109,108,46,98,111,115,95,116,111,107,101,110,95,105,100]
    si s ≡ "tokenizer.ggml.add_bos_token" ergo redde [116,111,107,101,110,105,122,101,114,46,103,103,109,108,46,97,100,100,95,98,111,115,95,116,111,107,101,110]
    si s ≡ "gpt2" ergo redde [103,112,116,50]
    si s ≡ "qwen35" ergo redde [113,119,101,110,51,53]
    si s ≡ "<s>" ergo redde [60,115,62]
    si s ≡ "hello" ergo redde [104,101,108,108,111]
    si s ≡ "qwen35moe.extra_fact" ergo redde [113,119,101,110,51,53,109,111,101,46,101,120,116,114,97,95,102,97,99,116]
    # MODEL-01-M4 canonical-tensor name strings (globals + per-block suffixes).
    si s ≡ "output.weight" ergo redde [111,117,116,112,117,116,46,119,101,105,103,104,116]
    si s ≡ "output_norm.weight" ergo redde [111,117,116,112,117,116,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ "token_embd.weight" ergo redde [116,111,107,101,110,95,101,109,98,100,46,119,101,105,103,104,116]
    si s ≡ ".attn_gate.weight" ergo redde [46,97,116,116,110,95,103,97,116,101,46,119,101,105,103,104,116]
    si s ≡ ".attn_norm.weight" ergo redde [46,97,116,116,110,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ ".attn_norm2.weight" ergo redde [46,97,116,116,110,95,110,111,114,109,50,46,119,101,105,103,104,116]
    si s ≡ ".attn_qkv.weight" ergo redde [46,97,116,116,110,95,113,107,118,46,119,101,105,103,104,116]
    si s ≡ ".ffn_down_exps.weight" ergo redde [46,102,102,110,95,100,111,119,110,95,101,120,112,115,46,119,101,105,103,104,116]
    si s ≡ ".ffn_down_shexp.weight" ergo redde [46,102,102,110,95,100,111,119,110,95,115,104,101,120,112,46,119,101,105,103,104,116]
    si s ≡ ".ffn_gate_exps.weight" ergo redde [46,102,102,110,95,103,97,116,101,95,101,120,112,115,46,119,101,105,103,104,116]
    si s ≡ ".ffn_gate_inp.weight" ergo redde [46,102,102,110,95,103,97,116,101,95,105,110,112,46,119,101,105,103,104,116]
    si s ≡ ".ffn_gate_inp_shexp.weight" ergo redde [46,102,102,110,95,103,97,116,101,95,105,110,112,95,115,104,101,120,112,46,119,101,105,103,104,116]
    si s ≡ ".ffn_gate_shexp.weight" ergo redde [46,102,102,110,95,103,97,116,101,95,115,104,101,120,112,46,119,101,105,103,104,116]
    si s ≡ ".ffn_up_exps.weight" ergo redde [46,102,102,110,95,117,112,95,101,120,112,115,46,119,101,105,103,104,116]
    si s ≡ ".ffn_up_shexp.weight" ergo redde [46,102,102,110,95,117,112,95,115,104,101,120,112,46,119,101,105,103,104,116]
    si s ≡ ".post_attention_norm.weight" ergo redde [46,112,111,115,116,95,97,116,116,101,110,116,105,111,110,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ ".ssm_a" ergo redde [46,115,115,109,95,97]
    si s ≡ ".ssm_alpha.weight" ergo redde [46,115,115,109,95,97,108,112,104,97,46,119,101,105,103,104,116]
    si s ≡ ".ssm_beta.weight" ergo redde [46,115,115,109,95,98,101,116,97,46,119,101,105,103,104,116]
    si s ≡ ".ssm_conv1d.weight" ergo redde [46,115,115,109,95,99,111,110,118,49,100,46,119,101,105,103,104,116]
    si s ≡ ".ssm_dt.bias" ergo redde [46,115,115,109,95,100,116,46,98,105,97,115]
    si s ≡ ".ssm_norm.weight" ergo redde [46,115,115,109,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ ".ssm_out.weight" ergo redde [46,115,115,109,95,111,117,116,46,119,101,105,103,104,116]
    si s ≡ ".attn_k.weight" ergo redde [46,97,116,116,110,95,107,46,119,101,105,103,104,116]
    si s ≡ ".attn_k_norm.weight" ergo redde [46,97,116,116,110,95,107,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ ".attn_output.weight" ergo redde [46,97,116,116,110,95,111,117,116,112,117,116,46,119,101,105,103,104,116]
    si s ≡ ".attn_q.weight" ergo redde [46,97,116,116,110,95,113,46,119,101,105,103,104,116]
    si s ≡ ".attn_q_norm.weight" ergo redde [46,97,116,116,110,95,113,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ ".attn_v.weight" ergo redde [46,97,116,116,110,95,118,46,119,101,105,103,104,116]
    si s ≡ ".nextn.eh_proj.weight" ergo redde [46,110,101,120,116,110,46,101,104,95,112,114,111,106,46,119,101,105,103,104,116]
    si s ≡ ".nextn.enorm.weight" ergo redde [46,110,101,120,116,110,46,101,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ ".nextn.hnorm.weight" ergo redde [46,110,101,120,116,110,46,104,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ ".nextn.shared_head_norm.weight" ergo redde [46,110,101,120,116,110,46,115,104,97,114,101,100,95,104,101,97,100,95,110,111,114,109,46,119,101,105,103,104,116]
    redde []
}

functio _str(textus s) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> b ← _textus_bytes(s)
    redde _iunge(_u64(b.longitudo()), b)
}

functio _kv(textus key, numerus typo, lista<numerus<u8>> value) → lista<numerus<u8>> {
    redde _iunge(_iunge(_str(key), _u32(typo)), value)
}

# Key-bytes variant for generated filler keys ("general.extra.N").
functio _kv_bytes(lista<numerus<u8>> key, numerus typo, lista<numerus<u8>> value) → lista<numerus<u8>> {
    redde _iunge(_iunge(_iunge(_u64(key.longitudo()), key), _u32(typo)), value)
}

functio _array(numerus typo, numerus count, lista<numerus<u8>> value) → lista<numerus<u8>> {
    redde _iunge(_iunge(_u32(typo), _u64(count)), value)
}

functio _caput(numerus tensorum, numerus metadata) → lista<numerus<u8>> {
    redde _iunge(
        _iunge([0x47, 0x47, 0x55, 0x46], _u32(3)),
        _iunge(_u64(tensorum), _u64(metadata))
    )
}

functio _cum_padding(lista<numerus<u8>> table, numerus concordatio, numerus total, bivalens extra_data) → manifestum.CorpusGguf {
    fixum numerus data_offset ← ((table.longitudo() + concordatio - 1) / concordatio) * concordatio
    varia lista<numerus<u8>> b ← table
    dum b.longitudo() < data_offset { b.appende(0 ∷ numerus<u8>) }
    si extra_data { b.appende(0 ∷ numerus<u8>) }
    fixum octeti o ← b
    redde manifestum.CorpusGguf {
        tabula = o,
        longitudo_artifacti = total,
        identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = total }
    }
}

functio _plenum(lista<numerus<u8>> table, numerus concordatio, numerus payload) → manifestum.CorpusGguf {
    fixum numerus data_offset ← ((table.longitudo() + concordatio - 1) / concordatio) * concordatio
    redde _cum_padding(table, concordatio, data_offset + payload, falsum)
}

# "general.extra." followed by one or two ASCII digits.
functio _clavis_generalis_extra(numerus n) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> prefix ← [103,101,110,101,114,97,108,46,101,120,116,114,97,46]
    varia lista<numerus<u8>> out ← vacua
    itera ex prefix fixum p { out.appende(p) }
    si n < 10 {
        out.appende((48 + n) ∷ numerus<u8>)
    } secus {
        out.appende((48 + n / 10) ∷ numerus<u8>)
        out.appende((48 + n % 10) ∷ numerus<u8>)
    }
    redde out
}

functio _stringarum_itera(numerus count, lista<numerus<u8>> bytes) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < count {
        itera ex bytes fixum b { out.appende(b) }
        i ↑
    }
    redde out
}

functio _u32_itera(numerus count) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> four ← _u32(0)
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < count {
        itera ex four fixum b { out.appende(b) }
        i ↑
    }
    redde out
}

# The 34 frozen metadata rows plus 21 `general.extra.N` filler keys to the
# pinned 55-entry count. The three mutable facts are parameterized so each
# mutation-family-1 corpus differs in exactly one fact.
functio _corpus_mutatum(
    numerus block_count,
    bivalens cum_ssm,
    numerus embedding,
    bivalens extra_qwen,
    bivalens extra_general
) → manifestum.CorpusGguf {
    varia numerus count ← 55
    si non cum_ssm { count ← count - 1 }
    si extra_qwen { count ← count + 1 }
    si extra_general { count ← count + 1 }
    varia lista<numerus<u8>> table ← _caput(0, count)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen35moe")))
    table ← _iunge(table, _kv("general.file_type", 4, _u32(15)))
    table ← _iunge(table, _kv("general.quantization_version", 4, _u32(2)))
    table ← _iunge(table, _kv("qwen35moe.block_count", 4, _u32(block_count)))
    table ← _iunge(table, _kv("qwen35moe.context_length", 4, _u32(262144)))
    table ← _iunge(table, _kv("qwen35moe.embedding_length", 4, _u32(embedding)))
    table ← _iunge(table, _kv("qwen35moe.attention.head_count", 4, _u32(16)))
    table ← _iunge(table, _kv("qwen35moe.attention.head_count_kv", 4, _u32(2)))
    table ← _iunge(table, _kv("qwen35moe.attention.key_length", 4, _u32(256)))
    table ← _iunge(table, _kv("qwen35moe.attention.value_length", 4, _u32(256)))
    table ← _iunge(table, _kv("qwen35moe.attention.layer_norm_rms_epsilon", 6, [189, 55, 134, 53]))
    table ← _iunge(table, _kv("qwen35moe.rope.freq_base", 6, [128, 150, 24, 75]))
    table ← _iunge(table, _kv("qwen35moe.rope.dimension_count", 4, _u32(64)))
    table ← _iunge(table, _kv("qwen35moe.rope.dimension_sections", 9, _array(4, 4, _iunge(_iunge(_u32(11), _u32(11)), _iunge(_u32(10), _u32(0))))))
    table ← _iunge(table, _kv("qwen35moe.expert_count", 4, _u32(256)))
    table ← _iunge(table, _kv("qwen35moe.expert_used_count", 4, _u32(8)))
    table ← _iunge(table, _kv("qwen35moe.expert_feed_forward_length", 4, _u32(512)))
    table ← _iunge(table, _kv("qwen35moe.expert_shared_feed_forward_length", 4, _u32(512)))
    table ← _iunge(table, _kv("qwen35moe.ssm.conv_kernel", 4, _u32(4)))
    si cum_ssm {
        table ← _iunge(table, _kv("qwen35moe.ssm.state_size", 4, _u32(128)))
    }
    table ← _iunge(table, _kv("qwen35moe.ssm.group_count", 4, _u32(16)))
    table ← _iunge(table, _kv("qwen35moe.ssm.time_step_rank", 4, _u32(32)))
    table ← _iunge(table, _kv("qwen35moe.ssm.inner_size", 4, _u32(4096)))
    table ← _iunge(table, _kv("qwen35moe.full_attention_interval", 4, _u32(4)))
    table ← _iunge(table, _kv("qwen35moe.nextn_predict_layers", 4, _u32(1)))
    table ← _iunge(table, _kv("tokenizer.ggml.model", 8, _str("gpt2")))
    table ← _iunge(table, _kv("tokenizer.ggml.pre", 8, _str("qwen35")))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _array(8, TOKENS_PIN, _stringarum_itera(TOKENS_PIN, _str("<s>")))))
    table ← _iunge(table, _kv("tokenizer.ggml.token_type", 9, _array(4, TOKENS_PIN, _u32_itera(TOKENS_PIN))))
    table ← _iunge(table, _kv("tokenizer.ggml.merges", 9, _array(8, MERGES_PIN, _stringarum_itera(MERGES_PIN, _str("hello")))))
    table ← _iunge(table, _kv("tokenizer.ggml.eos_token_id", 4, _u32(248046)))
    table ← _iunge(table, _kv("tokenizer.ggml.padding_token_id", 4, _u32(248055)))
    table ← _iunge(table, _kv("tokenizer.ggml.bos_token_id", 4, _u32(248044)))
    table ← _iunge(table, _kv("tokenizer.ggml.add_bos_token", 7, _u8(0)))
    varia numerus extra_count ← 21
    si extra_general { extra_count ← extra_count + 1 }
    varia numerus i ← 0
    dum i < extra_count {
        table ← _iunge(table, _kv_bytes(_clavis_generalis_extra(i), 4, _u32(1)))
        i ↑
    }
    si extra_qwen {
        table ← _iunge(table, _kv("qwen35moe.extra_fact", 4, _u32(1)))
    }
    redde _plenum(table, 32, 0)
}

functio _congela_manif(manifestum.ManifestumGguf m) → textus {
    fac {
        fixum qwen35moe.ConfiguratioQwen35moe c ← qwen35moe.congela(m)
        redde "ok"
    }
    cape err { redde qwen35moe.causa(err) }
}

functio _congela_resultum(manifestum.CorpusGguf corpus) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        redde _congela_manif(m)
    }
    cape err { redde manifestum.causa(err) }
}

functio _congela_puncta_manif(manifestum.ManifestumGguf m) → bivalens {
    fac {
        fixum qwen35moe.ConfiguratioQwen35moe c ← qwen35moe.congela(m)
        adfirma c.architectura ≡ "qwen35moe"
        adfirma c.typus_limaturae ≡ 15
        adfirma c.versio_quantificationis ≡ 2
        adfirma c.numerus_tractuum ≡ 41
        adfirma c.longitudo_contextus ≡ 262144
        adfirma c.longitudo_vestimenti ≡ 2048
        adfirma c.numerus_capita ≡ 16
        adfirma c.numerus_capita_kv ≡ 2
        adfirma c.longitudo_clavis ≡ 256
        adfirma c.longitudo_valoris ≡ 256
        adfirma c.epsilon_normae_rms ≡ (0.0000009999999974752427 ∷ f32)
        adfirma c.basis_frequentiae ≡ (10000000.0 ∷ f32)
        adfirma c.numerus_dimensionum_rotae ≡ 64
        adfirma (c.sectiones_rotae.accipe(0) vel 0) ≡ 11
        adfirma (c.sectiones_rotae.accipe(1) vel 0) ≡ 11
        adfirma (c.sectiones_rotae.accipe(2) vel 0) ≡ 10
        adfirma (c.sectiones_rotae.accipe(3) vel 0) ≡ 0
        adfirma c.numerus_expertorum ≡ 256
        adfirma c.numerus_expertorum_activorum ≡ 8
        adfirma c.longitudo_ffn_experti ≡ 512
        adfirma c.longitudo_ffn_communi ≡ 512
        adfirma c.nucleus_convolutus ≡ 4
        adfirma c.magnitudo_status ≡ 128
        adfirma c.numerus_coetuum ≡ 16
        adfirma c.gradus_temporis ≡ 32
        adfirma c.magnitudo_interior ≡ 4096
        adfirma c.intervallum_attentionis_plenae ≡ 4
        adfirma c.numerus_strata_nextn ≡ 1
        adfirma c.exemplum_tokenizoris ≡ "gpt2"
        adfirma c.praeparatio_tokenizoris ≡ "qwen35"
        adfirma c.numerus_tokenum ≡ 248320
        adfirma c.numerus_typorum_tokenum ≡ 248320
        adfirma c.numerus_concatenationum ≡ 247587
        adfirma c.eos_token_id ≡ 248046
        adfirma c.padding_token_id ≡ 248055
        adfirma c.bos_token_id ≡ 248044
        adfirma c.add_bos_token ≡ falsum
        redde verum
    }
    cape err { redde falsum }
}

functio _congela_puncta() → bivalens {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(_corpus_mutatum(41, verum, 2048, falsum, falsum))
        redde _congela_puncta_manif(m)
    }
    cape err { redde falsum }
}

# -------------------------------------------------------------------------
# MODEL-01-M4 canonical 753-tensor corpus builder. GGML raw type ids: f32 0,
# q8_0 8, q4_K 12, q5_K 13, q6_K 14, bf16 30. Offsets are sequential payload
# offsets (the parser requires disjoint stored ranges), sized by the same
# block geometry the manifest parser resolves.
# -------------------------------------------------------------------------

functio _blk_bytes(numerus b) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    out.appende(98 ∷ numerus<u8>)
    out.appende(108 ∷ numerus<u8>)
    out.appende(107 ∷ numerus<u8>)
    out.appende(46 ∷ numerus<u8>)
    si b ≥ 10 {
        out.appende((48 + b / 10) ∷ numerus<u8>)
    }
    out.appende((48 + b % 10) ∷ numerus<u8>)
    redde out
}

functio _blk_nome_bytes(numerus b, textus suffix) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> prefix ← _blk_bytes(b)
    fixum lista<numerus<u8>> sfix ← _textus_bytes(suffix)
    varia lista<numerus<u8>> out ← vacua
    itera ex prefix fixum p { out.appende(p) }
    itera ex sfix fixum s { out.appende(s) }
    redde out
}

functio _str_bytes(lista<numerus<u8>> b) → lista<numerus<u8>> {
    redde _iunge(_u64(b.longitudo()), b)
}

functio _tensorum_longitudo(lista<numerus> forma, numerus typo) → numerus {
    varia numerus elementa ← 1
    itera ex forma fixum d { elementa ← elementa * d }
    varia numerus elementa_per_blockum ← 1
    varia numerus octeti_per_blockum ← 4
    si typo ≡ 8 {
        elementa_per_blockum ← 32
        octeti_per_blockum ← 34
    }
    si typo ≡ 12 {
        elementa_per_blockum ← 256
        octeti_per_blockum ← 144
    }
    si typo ≡ 13 {
        elementa_per_blockum ← 256
        octeti_per_blockum ← 176
    }
    si typo ≡ 14 {
        elementa_per_blockum ← 256
        octeti_per_blockum ← 210
    }
    si typo ≡ 30 {
        elementa_per_blockum ← 1
        octeti_per_blockum ← 2
    }
    redde (elementa / elementa_per_blockum) * octeti_per_blockum
}

functio _tensorum_bytes(lista<numerus<u8>> nomen, lista<numerus> forma, numerus typo, numerus offset) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← _str_bytes(nomen)
    out ← _iunge(out, _u32(forma.longitudo()))
    itera ex forma fixum d { out ← _iunge(out, _u64(d)) }
    out ← _iunge(out, _u32(typo))
    out ← _iunge(out, _u64(offset))
    redde out
}

# Accumulating tensor-table fragment: bytes built so far plus the next free
# payload offset.
genus FragmentumTensorium {
    lista<numerus<u8>> bytes
    numerus finis
}

functio _appende_tensorem(FragmentumTensorium f, lista<numerus<u8>> nomen, lista<numerus> forma, numerus typo) → FragmentumTensorium {
    fixum numerus longitudo ← _tensorum_longitudo(forma, typo)
    redde FragmentumTensorium {
        bytes = _iunge(f.bytes, _tensorum_bytes(nomen, forma, typo, f.finis)),
        finis = f.finis + longitudo
    }
}

# Hybrid SSM/attention block tensor set (19); q6_K down family in blk.34/38.
functio _hybrida_fragmenta(FragmentumTensorium f, numerus b, bivalens renomine, bivalens down_abjecta, bivalens down_q6_recta, bivalens qkv_embd_depravata) → FragmentumTensorium {
    varia FragmentumTensorium g ← f
    varia textus norm_suffix ← ".attn_norm.weight"
    si renomine et b ≡ 0 { norm_suffix ← ".attn_norm2.weight" }
    varia lista<numerus> down_forma ← [512, 2048, 256]
    si down_abjecta et b ≡ 0 { down_forma ← [512, 2048] }
    varia numerus down_typo ← 13
    si non down_q6_recta et (b ≡ 34 aut b ≡ 38) { down_typo ← 14 }
    varia lista<numerus> qkv_forma ← [2048, 8192]
    si qkv_embd_depravata et b ≡ 0 { qkv_forma ← [1024, 8192] }
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".attn_gate.weight"), [2048, 4096], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, norm_suffix), [2048], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".attn_qkv.weight"), qkv_forma, 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_down_exps.weight"), down_forma, down_typo)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_down_shexp.weight"), [512, 2048], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_exps.weight"), [2048, 512, 256], 12)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_inp.weight"), [2048, 256], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_inp_shexp.weight"), [2048], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_shexp.weight"), [2048, 512], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_up_exps.weight"), [2048, 512, 256], 12)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_up_shexp.weight"), [2048, 512], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".post_attention_norm.weight"), [2048], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ssm_a"), [32], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ssm_alpha.weight"), [2048, 32], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ssm_beta.weight"), [2048, 32], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ssm_conv1d.weight"), [4, 8192], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ssm_dt.bias"), [32], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ssm_norm.weight"), [128], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ssm_out.weight"), [4096, 2048], 8)
    redde g
}

# Full-attention block tensor set (16); q6_K down family in blk.39.
functio _plena_fragmenta(FragmentumTensorium f, numerus b, bivalens down_q6_recta, bivalens attn_k_depravata) → FragmentumTensorium {
    varia FragmentumTensorium g ← f
    varia numerus down_typo ← 13
    si non down_q6_recta et b ≡ 39 { down_typo ← 14 }
    varia lista<numerus> attn_k_forma ← [2048, 512]
    si attn_k_depravata et b ≡ 3 { attn_k_forma ← [2048, 256] }
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".attn_k.weight"), attn_k_forma, 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".attn_k_norm.weight"), [256], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".attn_norm.weight"), [2048], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".attn_output.weight"), [4096, 2048], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".attn_q.weight"), [2048, 8192], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".attn_q_norm.weight"), [256], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".attn_v.weight"), [2048, 512], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_down_exps.weight"), [512, 2048, 256], down_typo)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_down_shexp.weight"), [512, 2048], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_exps.weight"), [2048, 512, 256], 12)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_inp.weight"), [2048, 256], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_inp_shexp.weight"), [2048], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_gate_shexp.weight"), [2048, 512], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_up_exps.weight"), [2048, 512, 256], 12)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".ffn_up_shexp.weight"), [2048, 512], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(b, ".post_attention_norm.weight"), [2048], 0)
    redde g
}

# Nextn block blk.40 tensor set (20): full-attention 16 with the frozen
# bf16 anomaly on ffn_gate_inp/ffn_gate_inp_shexp, plus the four nextn.*
# tensors.
functio _nextn_fragmenta(FragmentumTensorium f, bivalens bf16_recta, bivalens omitte_postremum) → FragmentumTensorium {
    varia FragmentumTensorium g ← f
    varia numerus inp_typo ← 30
    si bf16_recta { inp_typo ← 0 }
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".attn_k.weight"), [2048, 512], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".attn_k_norm.weight"), [256], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".attn_norm.weight"), [2048], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".attn_output.weight"), [4096, 2048], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".attn_q.weight"), [2048, 8192], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".attn_q_norm.weight"), [256], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".attn_v.weight"), [2048, 512], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".ffn_down_exps.weight"), [512, 2048, 256], 13)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".ffn_down_shexp.weight"), [512, 2048], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".ffn_gate_exps.weight"), [2048, 512, 256], 12)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".ffn_gate_inp.weight"), [2048, 256], inp_typo)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".ffn_gate_inp_shexp.weight"), [2048], inp_typo)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".ffn_gate_shexp.weight"), [2048, 512], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".ffn_up_exps.weight"), [2048, 512, 256], 12)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".ffn_up_shexp.weight"), [2048, 512], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".post_attention_norm.weight"), [2048], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".nextn.eh_proj.weight"), [4096, 2048], 8)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".nextn.enorm.weight"), [2048], 0)
    g ← _appende_tensorem(g, _blk_nome_bytes(40, ".nextn.hnorm.weight"), [2048], 0)
    si non omitte_postremum {
        g ← _appende_tensorem(g, _blk_nome_bytes(40, ".nextn.shared_head_norm.weight"), [2048], 0)
    }
    redde g
}

# The full canonical tensor table: 3 globals then blocks 0..40 classified by
# the frozen schedule (nextn at 40, full-attention at index ≡ 3 mod 4).
functio _canonici_fragmenta(
    bivalens renomine_attn_norm,
    bivalens down_abjecta,
    bivalens bf16_recta,
    bivalens down_q6_recta,
    bivalens omitte_postremum,
    bivalens qkv_embd_depravata,
    bivalens attn_k_depravata,
    numerus tractuum
) → FragmentumTensorium {
    varia FragmentumTensorium f ← FragmentumTensorium { bytes = vacua, finis = 0 }
    f ← _appende_tensorem(f, _textus_bytes("output.weight"), [2048, 248320], 14)
    f ← _appende_tensorem(f, _textus_bytes("output_norm.weight"), [2048], 0)
    f ← _appende_tensorem(f, _textus_bytes("token_embd.weight"), [2048, 248320], 8)
    varia numerus b ← 0
    dum b < tractuum {
        si b ≡ 40 {
            f ← _nextn_fragmenta(f, bf16_recta, omitte_postremum)
        } secus {
            si b % 4 ≡ 3 {
                f ← _plena_fragmenta(f, b, down_q6_recta, attn_k_depravata)
            } secus {
                f ← _hybrida_fragmenta(f, b, renomine_attn_norm, down_abjecta, down_q6_recta, qkv_embd_depravata)
            }
        }
        b ↑
    }
    redde f
}

# The canonical corpus: the 55 frozen metadata entries (34 rows + 21 filler
# keys, the same set the M3 corpora carry) plus the tensor table.
functio _corpus_tensorium(FragmentumTensorium fragmenta, numerus tensorum) → manifestum.CorpusGguf {
    redde _corpus_tensorium_arch(fragmenta, tensorum, "qwen35moe")
}

# Canonical corpus with a caller-picked `general.architecture` value
# (MODEL-01-M6 family-7 unsupported-but-inspectable oracle).
functio _corpus_tensorium_arch(FragmentumTensorium fragmenta, numerus tensorum, textus architectura) → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(tensorum, 55)
    table ← _iunge(table, _kv("general.architecture", 8, _str(architectura)))
    table ← _iunge(table, _kv("general.file_type", 4, _u32(15)))
    table ← _iunge(table, _kv("general.quantization_version", 4, _u32(2)))
    table ← _iunge(table, _kv("qwen35moe.block_count", 4, _u32(41)))
    table ← _iunge(table, _kv("qwen35moe.context_length", 4, _u32(262144)))
    table ← _iunge(table, _kv("qwen35moe.embedding_length", 4, _u32(2048)))
    table ← _iunge(table, _kv("qwen35moe.attention.head_count", 4, _u32(16)))
    table ← _iunge(table, _kv("qwen35moe.attention.head_count_kv", 4, _u32(2)))
    table ← _iunge(table, _kv("qwen35moe.attention.key_length", 4, _u32(256)))
    table ← _iunge(table, _kv("qwen35moe.attention.value_length", 4, _u32(256)))
    table ← _iunge(table, _kv("qwen35moe.attention.layer_norm_rms_epsilon", 6, [189, 55, 134, 53]))
    table ← _iunge(table, _kv("qwen35moe.rope.freq_base", 6, [128, 150, 24, 75]))
    table ← _iunge(table, _kv("qwen35moe.rope.dimension_count", 4, _u32(64)))
    table ← _iunge(table, _kv("qwen35moe.rope.dimension_sections", 9, _array(4, 4, _iunge(_iunge(_u32(11), _u32(11)), _iunge(_u32(10), _u32(0))))))
    table ← _iunge(table, _kv("qwen35moe.expert_count", 4, _u32(256)))
    table ← _iunge(table, _kv("qwen35moe.expert_used_count", 4, _u32(8)))
    table ← _iunge(table, _kv("qwen35moe.expert_feed_forward_length", 4, _u32(512)))
    table ← _iunge(table, _kv("qwen35moe.expert_shared_feed_forward_length", 4, _u32(512)))
    table ← _iunge(table, _kv("qwen35moe.ssm.conv_kernel", 4, _u32(4)))
    table ← _iunge(table, _kv("qwen35moe.ssm.state_size", 4, _u32(128)))
    table ← _iunge(table, _kv("qwen35moe.ssm.group_count", 4, _u32(16)))
    table ← _iunge(table, _kv("qwen35moe.ssm.time_step_rank", 4, _u32(32)))
    table ← _iunge(table, _kv("qwen35moe.ssm.inner_size", 4, _u32(4096)))
    table ← _iunge(table, _kv("qwen35moe.full_attention_interval", 4, _u32(4)))
    table ← _iunge(table, _kv("qwen35moe.nextn_predict_layers", 4, _u32(1)))
    table ← _iunge(table, _kv("tokenizer.ggml.model", 8, _str("gpt2")))
    table ← _iunge(table, _kv("tokenizer.ggml.pre", 8, _str("qwen35")))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _array(8, TOKENS_PIN, _stringarum_itera(TOKENS_PIN, _str("<s>")))))
    table ← _iunge(table, _kv("tokenizer.ggml.token_type", 9, _array(4, TOKENS_PIN, _u32_itera(TOKENS_PIN))))
    table ← _iunge(table, _kv("tokenizer.ggml.merges", 9, _array(8, MERGES_PIN, _stringarum_itera(MERGES_PIN, _str("hello")))))
    table ← _iunge(table, _kv("tokenizer.ggml.eos_token_id", 4, _u32(248046)))
    table ← _iunge(table, _kv("tokenizer.ggml.padding_token_id", 4, _u32(248055)))
    table ← _iunge(table, _kv("tokenizer.ggml.bos_token_id", 4, _u32(248044)))
    table ← _iunge(table, _kv("tokenizer.ggml.add_bos_token", 7, _u8(0)))
    varia numerus i ← 0
    dum i < 21 {
        table ← _iunge(table, _kv_bytes(_clavis_generalis_extra(i), 4, _u32(1)))
        i ↑
    }
    table ← _iunge(table, fragmenta.bytes)
    redde _plenum(table, 32, fragmenta.finis + 1)
}

functio _tensores_manif(manifestum.ManifestumGguf m) → textus {
    fac {
        fixum qwen35moe.SummaTensoriorumQwen s ← qwen35moe.tensores_canonici(m)
        redde "ok"
    }
    cape err { redde qwen35moe.causa_tensorum(err) }
}

functio _tensores_resultum(manifestum.CorpusGguf corpus) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        redde _tensores_manif(m)
    }
    cape err { redde manifestum.causa(err) }
}

functio _tensores_puncta() → bivalens {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(_corpus_tensorium(_canonici_fragmenta(falsum, falsum, falsum, falsum, falsum, falsum, falsum, 41), 753))
        fac {
            fixum qwen35moe.SummaTensoriorumQwen s ← qwen35moe.tensores_canonici(m)
            adfirma s.totalis ≡ 753
            adfirma s.globalium ≡ 3
            adfirma s.hybridorum ≡ 30
            adfirma s.attentionis_plenae ≡ 10
            adfirma s.nextn ≡ 1
            adfirma s.stipula_f32 ≡ 368
            adfirma s.stipula_q8_0 ≡ 259
            adfirma s.stipula_q4_k ≡ 82
            adfirma s.stipula_q5_k ≡ 38
            adfirma s.stipula_q6_k ≡ 4
            adfirma s.stipula_bf16 ≡ 2
            adfirma s.experti_rank3 ≡ 123
            redde verum
        }
        cape err { redde falsum }
    }
    cape err { redde falsum }
}

# -------------------------------------------------------------------------
# MODEL-01-M5 cross-reference oracle helpers: freeze the config (M3), then
# run the dimension/storage cross-reference validator against the manifest.
# -------------------------------------------------------------------------

functio _referantia_manif(manifestum.ManifestumGguf m) → textus {
    fac {
        fixum qwen35moe.ConfiguratioQwen35moe c ← qwen35moe.congela(m)
        fac {
            fixum bivalens ok ← qwen35moe.referantia(c, m)
            redde "ok"
        }
        cape err { redde qwen35moe.causa_referantiae(err) }
        redde "ok"
    }
    cape err { redde qwen35moe.causa(err) }
}

functio _referantia_resultum(manifestum.CorpusGguf corpus) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        redde _referantia_manif(m)
    }
    cape err { redde manifestum.causa(err) }
}

probandum "MODEL-01-M4 canonical 753-tensor map and block schedule" {
    proba "canonical family sets, 41-block schedule, storage distribution and anomalies pin" {
        adfirma _tensores_resultum(_corpus_tensorium(_canonici_fragmenta(falsum, falsum, falsum, falsum, falsum, falsum, falsum, 41), 753)) ≡ "ok"
        adfirma _tensores_puncta()
    }

    proba "mutation family 2: a canonical tensor rename yields a typed name diagnostic naming the first diverging fact" {
        adfirma _tensores_resultum(_corpus_tensorium(_canonici_fragmenta(verum, falsum, falsum, falsum, falsum, falsum, falsum, 41), 753)) ≡ "qwen35moe tensor name divergence at blk.0.attn_norm.weight"
    }

    proba "mutation family 3: a rank-3 expert tensor collapsed to rank-2 yields a typed shape diagnostic" {
        adfirma _tensores_resultum(_corpus_tensorium(_canonici_fragmenta(falsum, verum, falsum, falsum, falsum, falsum, falsum, 41), 753)) ≡ "qwen35moe tensor shape divergence at blk.0.ffn_down_exps.weight"
    }

    proba "mutation family 4: the blk.40 bf16 anomaly corrected away fails typed; the blk.34/38/39 q6_K anomaly corrected away fails typed" {
        adfirma _tensores_resultum(_corpus_tensorium(_canonici_fragmenta(falsum, falsum, verum, falsum, falsum, falsum, falsum, 41), 753)) ≡ "qwen35moe tensor storage divergence at blk.40.ffn_gate_inp.weight"
        adfirma _tensores_resultum(_corpus_tensorium(_canonici_fragmenta(falsum, falsum, falsum, verum, falsum, falsum, falsum, 41), 753)) ≡ "qwen35moe tensor storage divergence at blk.34.ffn_down_exps.weight"
    }

    proba "mutation family 5: the tensor count 753→752 yields a typed count diagnostic" {
        adfirma _tensores_resultum(_corpus_tensorium(_canonici_fragmenta(falsum, falsum, falsum, falsum, verum, falsum, falsum, 41), 752)) ≡ "qwen35moe tensor count divergence: tensor count 752 ≠ 753"
    }
}

probandum "MODEL-01-M5 dimension/storage cross-reference validation" {
    proba "every cross-reference pin type-checks on the canonical corpus" {
        adfirma _referantia_resultum(_corpus_tensorium(_canonici_fragmenta(falsum, falsum, falsum, falsum, falsum, falsum, falsum, 41), 753)) ≡ "ok"
    }

    proba "a deliberate cross-fact violation (attn_qkv embedding dim ≠ 2048) yields the typed first-divergence diagnostic" {
        adfirma _referantia_resultum(_corpus_tensorium(_canonici_fragmenta(falsum, falsum, falsum, falsum, falsum, verum, falsum, 41), 753)) ≡ "qwen35moe cross-reference dimension divergence at blk.0.attn_qkv.weight"
    }

    proba "a deliberate cross-fact violation (head_count_kv × key_length ≠ dim 1 of attn_k) yields the typed first-divergence diagnostic" {
        adfirma _referantia_resultum(_corpus_tensorium(_canonici_fragmenta(falsum, falsum, falsum, falsum, falsum, falsum, verum, 41), 753)) ≡ "qwen35moe cross-reference dimension divergence at blk.3.attn_k.weight"
    }
}

probandum "MODEL-01-M3 qwen35moe configuration genus and metadata freeze" {
    proba "freezes every frozen config row with the metadata count pinned at 55" {
        adfirma _congela_resultum(_corpus_mutatum(41, verum, 2048, falsum, falsum)) ≡ "ok"
        adfirma _congela_puncta()
    }

    proba "mutation family 1: a frozen qwen35moe value change yields a typed diagnostic naming the first diverging key" {
        adfirma _congela_resultum(_corpus_mutatum(42, verum, 2048, falsum, falsum)) ≡ "qwen35moe metadata divergence at qwen35moe.block_count"
        adfirma _congela_resultum(_corpus_mutatum(41, verum, 1024, falsum, falsum)) ≡ "qwen35moe metadata divergence at qwen35moe.embedding_length"
    }

    proba "mutation family 1: a missing required key yields a typed diagnostic naming that key" {
        adfirma _congela_resultum(_corpus_mutatum(41, falsum, 2048, falsum, falsum)) ≡ "qwen35moe metadata divergence at qwen35moe.ssm.state_size"
    }

    proba "mutation family 1: an extra unknown qwen35moe.* key fails closed" {
        adfirma _congela_resultum(_corpus_mutatum(41, verum, 2048, verum, falsum)) ≡ "qwen35moe metadata divergence at qwen35moe.extra_fact"
    }

    proba "mutation family 1: a metadata count divergence yields a typed diagnostic" {
        adfirma _congela_resultum(_corpus_mutatum(41, verum, 2048, falsum, verum)) ≡ "qwen35moe metadata divergence at metadata count"
    }
}

# -------------------------------------------------------------------------
# MODEL-01-M6 admission entry point + identity precondition + typed
# refusal matrix. `admitto` composes identity precondition (family 6,
# before any architecture read) -> config freeze (M3) -> canonical tensor
# map (M4) -> cross-reference validation (M5) and returns ADMIT with the
# frozen configuration + the 753-tensor receipt. Family 7 refuses an
# unknown architecture name or raw GGML type as unsupported-but-
# inspectable (stays inspectable as data per GGUF-A1a, cannot admit).
# -------------------------------------------------------------------------

fixum textus F_DIGEST_MALA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# One unknown-raw-GGML-type tensor (type id 999, Ignota layout).
functio _fragmentum_typo_ignoto() → FragmentumTensorium {
    varia FragmentumTensorium f ← FragmentumTensorium { bytes = vacua, finis = 0 }
    redde _appende_tensorem(f, _blk_nome_bytes(0, ".attn_norm.weight"), [2048], 999)
}

functio _canonici_corpus() → manifestum.CorpusGguf {
    redde _corpus_tensorium(_canonici_fragmenta(falsum, falsum, falsum, falsum, falsum, falsum, falsum, 41), 753)
}

functio _admissio_resultum(manifestum.CorpusGguf corpus, textus digestio, numerus longitudo) → textus {
    fac {
        fixum qwen35moe.AdmissioQwen35moe a ← qwen35moe.admitto(corpus, digestio, longitudo)
        redde "ADMIT"
    }
    cape err {
        redde qwen35moe.causa_admissionis(err)
    }
}

functio _admissio_puncta(manifestum.CorpusGguf corpus) → bivalens {
    fac {
        fixum qwen35moe.AdmissioQwen35moe a ← qwen35moe.admitto(corpus, F_DIGEST, corpus.longitudo_artifacti)
        adfirma a.configuratio.architectura ≡ "qwen35moe"
        adfirma a.configuratio.typus_limaturae ≡ 15
        adfirma a.configuratio.versio_quantificationis ≡ 2
        adfirma a.configuratio.numerus_tractuum ≡ 41
        adfirma a.configuratio.longitudo_contextus ≡ 262144
        adfirma a.configuratio.longitudo_vestimenti ≡ 2048
        adfirma a.configuratio.numerus_capita ≡ 16
        adfirma a.configuratio.numerus_capita_kv ≡ 2
        adfirma a.configuratio.longitudo_clavis ≡ 256
        adfirma a.configuratio.longitudo_valoris ≡ 256
        adfirma a.configuratio.epsilon_normae_rms ≡ (0.0000009999999974752427 ∷ f32)
        adfirma a.configuratio.basis_frequentiae ≡ (10000000.0 ∷ f32)
        adfirma a.configuratio.numerus_dimensionum_rotae ≡ 64
        adfirma (a.configuratio.sectiones_rotae.accipe(0) vel 0) ≡ 11
        adfirma (a.configuratio.sectiones_rotae.accipe(1) vel 0) ≡ 11
        adfirma (a.configuratio.sectiones_rotae.accipe(2) vel 0) ≡ 10
        adfirma (a.configuratio.sectiones_rotae.accipe(3) vel 0) ≡ 0
        adfirma a.configuratio.numerus_expertorum ≡ 256
        adfirma a.configuratio.numerus_expertorum_activorum ≡ 8
        adfirma a.configuratio.longitudo_ffn_experti ≡ 512
        adfirma a.configuratio.longitudo_ffn_communi ≡ 512
        adfirma a.configuratio.nucleus_convolutus ≡ 4
        adfirma a.configuratio.magnitudo_status ≡ 128
        adfirma a.configuratio.numerus_coetuum ≡ 16
        adfirma a.configuratio.gradus_temporis ≡ 32
        adfirma a.configuratio.magnitudo_interior ≡ 4096
        adfirma a.configuratio.intervallum_attentionis_plenae ≡ 4
        adfirma a.configuratio.numerus_strata_nextn ≡ 1
        adfirma a.configuratio.exemplum_tokenizoris ≡ "gpt2"
        adfirma a.configuratio.praeparatio_tokenizoris ≡ "qwen35"
        adfirma a.configuratio.numerus_tokenum ≡ 248320
        adfirma a.configuratio.numerus_typorum_tokenum ≡ 248320
        adfirma a.configuratio.numerus_concatenationum ≡ 247587
        adfirma a.configuratio.eos_token_id ≡ 248046
        adfirma a.configuratio.padding_token_id ≡ 248055
        adfirma a.configuratio.bos_token_id ≡ 248044
        adfirma a.configuratio.add_bos_token ≡ falsum
        adfirma a.summa.totalis ≡ 753
        adfirma a.summa.globalium ≡ 3
        adfirma a.summa.hybridorum ≡ 30
        adfirma a.summa.attentionis_plenae ≡ 10
        adfirma a.summa.nextn ≡ 1
        adfirma a.summa.stipula_f32 ≡ 368
        adfirma a.summa.stipula_q8_0 ≡ 259
        adfirma a.summa.stipula_q4_k ≡ 82
        adfirma a.summa.stipula_q5_k ≡ 38
        adfirma a.summa.stipula_q6_k ≡ 4
        adfirma a.summa.stipula_bf16 ≡ 2
        adfirma a.summa.experti_rank3 ≡ 123
        redde verum
    }
    cape err {
        redde falsum
    }
}

probandum "MODEL-01-M6 admission entry point and typed refusal matrix" {
    proba "ADMIT returns the frozen configuration and the 753-tensor receipt on the exact frozen facts" {
        fac {
            fixum manifestum.CorpusGguf corpus ← _canonici_corpus()
            adfirma _admissio_resultum(corpus, F_DIGEST, corpus.longitudo_artifacti) ≡ "ADMIT"
            adfirma _admissio_puncta(corpus)
        }
    }

    proba "family 6: a wrong SHA-256 fails with the identity diagnostic before any architecture read" {
        fac {
            fixum manifestum.CorpusGguf corpus ← _canonici_corpus()
            adfirma _admissio_resultum(corpus, F_DIGEST_MALA, corpus.longitudo_artifacti) ≡ "qwen35moe admission identity divergence: SHA-256"
        }
    }

    proba "family 6: a wrong byte length fails with the identity diagnostic before any architecture read" {
        fac {
            fixum manifestum.CorpusGguf corpus ← _canonici_corpus()
            adfirma _admissio_resultum(corpus, F_DIGEST, corpus.longitudo_artifacti + 1) ≡ "qwen35moe admission identity divergence: byte length"
        }
    }

    proba "family 6 precedes any architecture read: a llama corpus with a wrong digest yields the identity diagnostic" {
        fac {
            fixum manifestum.CorpusGguf corpus ← _corpus_tensorium_arch(_canonici_fragmenta(falsum, falsum, falsum, falsum, falsum, falsum, falsum, 41), 753, "llama")
            adfirma _admissio_resultum(corpus, F_DIGEST_MALA, corpus.longitudo_artifacti) ≡ "qwen35moe admission identity divergence: SHA-256"
        }
    }

    proba "family 7: an unknown architecture stays inspectable as data but cannot admit" {
        fac {
            fixum manifestum.CorpusGguf corpus ← _corpus_tensorium_arch(_canonici_fragmenta(falsum, falsum, falsum, falsum, falsum, falsum, falsum, 41), 753, "llama")
            adfirma _admissio_resultum(corpus, F_DIGEST, corpus.longitudo_artifacti) ≡ "qwen35moe admission refusal: unsupported-but-inspectable architecture llama"
        }
    }

    proba "family 7: an unknown raw GGML type stays inspectable as data but cannot admit" {
        fac {
            fixum manifestum.CorpusGguf corpus ← _corpus_tensorium(_fragmentum_typo_ignoto(), 1)
            adfirma _admissio_resultum(corpus, F_DIGEST, corpus.longitudo_artifacti) ≡ "qwen35moe admission refusal: unsupported-but-inspectable raw GGML type at blk.0.attn_norm.weight"
        }
    }

    proba "family 1 through admission: a frozen metadata divergence yields the typed diagnostic" {
        fac {
            fixum manifestum.CorpusGguf corpus ← _corpus_mutatum(42, verum, 2048, falsum, falsum)
            adfirma _admissio_resultum(corpus, F_DIGEST, corpus.longitudo_artifacti) ≡ "qwen35moe metadata divergence at qwen35moe.block_count"
        }
    }

    proba "families 2-5 through admission: name, shape, storage, and count divergences yield the typed diagnostics" {
        fac {
            fixum manifestum.CorpusGguf corpus ← _corpus_tensorium(_canonici_fragmenta(verum, falsum, falsum, falsum, falsum, falsum, falsum, 41), 753)
            adfirma _admissio_resultum(corpus, F_DIGEST, corpus.longitudo_artifacti) ≡ "qwen35moe tensor name divergence at blk.0.attn_norm.weight"
        }
        fac {
            fixum manifestum.CorpusGguf corpus ← _corpus_tensorium(_canonici_fragmenta(falsum, verum, falsum, falsum, falsum, falsum, falsum, 41), 753)
            adfirma _admissio_resultum(corpus, F_DIGEST, corpus.longitudo_artifacti) ≡ "qwen35moe tensor shape divergence at blk.0.ffn_down_exps.weight"
        }
        fac {
            fixum manifestum.CorpusGguf corpus ← _corpus_tensorium(_canonici_fragmenta(falsum, falsum, verum, falsum, falsum, falsum, falsum, 41), 753)
            adfirma _admissio_resultum(corpus, F_DIGEST, corpus.longitudo_artifacti) ≡ "qwen35moe tensor storage divergence at blk.40.ffn_gate_inp.weight"
        }
        fac {
            fixum manifestum.CorpusGguf corpus ← _corpus_tensorium(_canonici_fragmenta(falsum, falsum, falsum, falsum, verum, falsum, falsum, 41), 752)
            adfirma _admissio_resultum(corpus, F_DIGEST, corpus.longitudo_artifacti) ≡ "qwen35moe tensor count divergence: tensor count 752 ≠ 753"
        }
    }

    proba "M5 cross-reference divergences surface through the admission entry" {
        fac {
            fixum manifestum.CorpusGguf corpus ← _corpus_tensorium(_canonici_fragmenta(falsum, falsum, falsum, falsum, falsum, verum, falsum, 41), 753)
            adfirma _admissio_resultum(corpus, F_DIGEST, corpus.longitudo_artifacti) ≡ "qwen35moe cross-reference dimension divergence at blk.0.attn_qkv.weight"
        }
    }
}
