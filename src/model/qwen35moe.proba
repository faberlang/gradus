+++
locale = "en"
+++
# MODEL-01-M3 qwen35moe configuration genus and metadata freeze (MODEL-01
# chain). Pins the frozen configuration rows from the delivery authority:
# every frozen value freezes through `freeze` and the 55-entry metadata
# count is enforced; mutation family 1 (frozen qwen35moe/general/tokenizer
# identity value changed, required key missing, extra unknown qwen35moe.*
# key, metadata count divergence) fails with a typed first-divergence
# diagnostic naming the key. Tokenizer facts are frozen as identity only.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" gguf_manifest

import from "gradus:model/qwen35moe" qwen35moe

const string F_DIGEST = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

const int TOKENS_PIN = 248320

const int MERGES_PIN = 247587

fn u8(int n) → list<u8> {
    return [(n % 256) ∷ u8]
}

fn u32(int n) → list<u8> {
    return [(n % 256) ∷ u8, ((n ⇒ 8) % 256) ∷ u8, ((n ⇒ 16) % 256) ∷ u8, ((n ⇒ 24) % 256) ∷ u8]
}

fn u64(int n) → list<u8> {
    return [(n % 256) ∷ u8, ((n ⇒ 8) % 256) ∷ u8, ((n ⇒ 16) % 256) ∷ u8, ((n ⇒ 24) % 256) ∷ u8, ((n ⇒ 32) % 256) ∷ u8, ((n ⇒ 40) % 256) ∷ u8, ((n ⇒ 48) % 256) ∷ u8, ((n ⇒ 56) % 256) ∷ u8]
}

fn join(list<u8> a, list<u8> b) → list<u8> {
    var list<u8> out ← empty
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

# Package MIR has no text->bytes extraction arm. This structural builder
# encodes only the finite ASCII key/value set the freeze corpora need.
fn text_bytes(string s) → list<u8> {
    if s ≡ "general.architecture" then return [103, 101, 110, 101, 114, 97, 108, 46, 97, 114, 99, 104, 105, 116, 101, 99, 116, 117, 114, 101]
    if s ≡ "general.file_type" then return [103, 101, 110, 101, 114, 97, 108, 46, 102, 105, 108, 101, 95, 116, 121, 112, 101]
    if s ≡ "general.quantization_version" then return [103, 101, 110, 101, 114, 97, 108, 46, 113, 117, 97, 110, 116, 105, 122, 97, 116, 105, 111, 110, 95, 118, 101, 114, 115, 105, 111, 110]
    if s ≡ "qwen35moe" then return [113, 119, 101, 110, 51, 53, 109, 111, 101]
    if s ≡ "llama" then return [108, 108, 97, 109, 97]
    if s ≡ "qwen35moe.block_count" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 98, 108, 111, 99, 107, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen35moe.context_length" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 99, 111, 110, 116, 101, 120, 116, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "qwen35moe.embedding_length" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 101, 109, 98, 101, 100, 100, 105, 110, 103, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "qwen35moe.attention.head_count" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 104, 101, 97, 100, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen35moe.attention.head_count_kv" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 104, 101, 97, 100, 95, 99, 111, 117, 110, 116, 95, 107, 118]
    if s ≡ "qwen35moe.attention.key_length" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 107, 101, 121, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "qwen35moe.attention.value_length" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 118, 97, 108, 117, 101, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "qwen35moe.attention.layer_norm_rms_epsilon" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 108, 97, 121, 101, 114, 95, 110, 111, 114, 109, 95, 114, 109, 115, 95, 101, 112, 115, 105, 108, 111, 110]
    if s ≡ "qwen35moe.rope.freq_base" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 114, 111, 112, 101, 46, 102, 114, 101, 113, 95, 98, 97, 115, 101]
    if s ≡ "qwen35moe.rope.dimension_count" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 114, 111, 112, 101, 46, 100, 105, 109, 101, 110, 115, 105, 111, 110, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen35moe.rope.dimension_sections" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 114, 111, 112, 101, 46, 100, 105, 109, 101, 110, 115, 105, 111, 110, 95, 115, 101, 99, 116, 105, 111, 110, 115]
    if s ≡ "qwen35moe.expert_count" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 101, 120, 112, 101, 114, 116, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen35moe.expert_used_count" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 101, 120, 112, 101, 114, 116, 95, 117, 115, 101, 100, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen35moe.expert_feed_forward_length" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 101, 120, 112, 101, 114, 116, 95, 102, 101, 101, 100, 95, 102, 111, 114, 119, 97, 114, 100, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "qwen35moe.expert_shared_feed_forward_length" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 101, 120, 112, 101, 114, 116, 95, 115, 104, 97, 114, 101, 100, 95, 102, 101, 101, 100, 95, 102, 111, 114, 119, 97, 114, 100, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "qwen35moe.ssm.conv_kernel" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 115, 115, 109, 46, 99, 111, 110, 118, 95, 107, 101, 114, 110, 101, 108]
    if s ≡ "qwen35moe.ssm.state_size" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 115, 115, 109, 46, 115, 116, 97, 116, 101, 95, 115, 105, 122, 101]
    if s ≡ "qwen35moe.ssm.group_count" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 115, 115, 109, 46, 103, 114, 111, 117, 112, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen35moe.ssm.time_step_rank" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 115, 115, 109, 46, 116, 105, 109, 101, 95, 115, 116, 101, 112, 95, 114, 97, 110, 107]
    if s ≡ "qwen35moe.ssm.inner_size" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 115, 115, 109, 46, 105, 110, 110, 101, 114, 95, 115, 105, 122, 101]
    if s ≡ "qwen35moe.full_attention_interval" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 102, 117, 108, 108, 95, 97, 116, 116, 101, 110, 116, 105, 111, 110, 95, 105, 110, 116, 101, 114, 118, 97, 108]
    if s ≡ "qwen35moe.nextn_predict_layers" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 110, 101, 120, 116, 110, 95, 112, 114, 101, 100, 105, 99, 116, 95, 108, 97, 121, 101, 114, 115]
    if s ≡ "tokenizer.ggml.model" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 111, 100, 101, 108]
    if s ≡ "tokenizer.ggml.pre" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 112, 114, 101]
    if s ≡ "tokenizer.ggml.tokens" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115]
    if s ≡ "tokenizer.ggml.token_type" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 95, 116, 121, 112, 101]
    if s ≡ "tokenizer.ggml.merges" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 101, 114, 103, 101, 115]
    if s ≡ "tokenizer.ggml.eos_token_id" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 101, 111, 115, 95, 116, 111, 107, 101, 110, 95, 105, 100]
    if s ≡ "tokenizer.ggml.padding_token_id" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 112, 97, 100, 100, 105, 110, 103, 95, 116, 111, 107, 101, 110, 95, 105, 100]
    if s ≡ "tokenizer.ggml.bos_token_id" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 98, 111, 115, 95, 116, 111, 107, 101, 110, 95, 105, 100]
    if s ≡ "tokenizer.ggml.add_bos_token" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 97, 100, 100, 95, 98, 111, 115, 95, 116, 111, 107, 101, 110]
    if s ≡ "gpt2" then return [103, 112, 116, 50]
    if s ≡ "qwen35" then return [113, 119, 101, 110, 51, 53]
    if s ≡ "<s>" then return [60, 115, 62]
    if s ≡ "hello" then return [104, 101, 108, 108, 111]
    if s ≡ "qwen35moe.extra_fact" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 101, 120, 116, 114, 97, 95, 102, 97, 99, 116]
    # MODEL-01-M4 canonical-tensor name strings (globals + per-block suffixes).
    if s ≡ "output.weight" then return [111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "output_norm.weight" then return [111, 117, 116, 112, 117, 116, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_gate.weight" then return [46, 97, 116, 116, 110, 95, 103, 97, 116, 101, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_norm.weight" then return [46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_norm2.weight" then return [46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 50, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_qkv.weight" then return [46, 97, 116, 116, 110, 95, 113, 107, 118, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_down_exps.weight" then return [46, 102, 102, 110, 95, 100, 111, 119, 110, 95, 101, 120, 112, 115, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_down_shexp.weight" then return [46, 102, 102, 110, 95, 100, 111, 119, 110, 95, 115, 104, 101, 120, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_gate_exps.weight" then return [46, 102, 102, 110, 95, 103, 97, 116, 101, 95, 101, 120, 112, 115, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_gate_inp.weight" then return [46, 102, 102, 110, 95, 103, 97, 116, 101, 95, 105, 110, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_gate_inp_shexp.weight" then return [46, 102, 102, 110, 95, 103, 97, 116, 101, 95, 105, 110, 112, 95, 115, 104, 101, 120, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_gate_shexp.weight" then return [46, 102, 102, 110, 95, 103, 97, 116, 101, 95, 115, 104, 101, 120, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_up_exps.weight" then return [46, 102, 102, 110, 95, 117, 112, 95, 101, 120, 112, 115, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ffn_up_shexp.weight" then return [46, 102, 102, 110, 95, 117, 112, 95, 115, 104, 101, 120, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".post_attention_norm.weight" then return [46, 112, 111, 115, 116, 95, 97, 116, 116, 101, 110, 116, 105, 111, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ssm_a" then return [46, 115, 115, 109, 95, 97]
    if s ≡ ".ssm_alpha.weight" then return [46, 115, 115, 109, 95, 97, 108, 112, 104, 97, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ssm_beta.weight" then return [46, 115, 115, 109, 95, 98, 101, 116, 97, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ssm_conv1d.weight" then return [46, 115, 115, 109, 95, 99, 111, 110, 118, 49, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ssm_dt.bias" then return [46, 115, 115, 109, 95, 100, 116, 46, 98, 105, 97, 115]
    if s ≡ ".ssm_norm.weight" then return [46, 115, 115, 109, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".ssm_out.weight" then return [46, 115, 115, 109, 95, 111, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_k.weight" then return [46, 97, 116, 116, 110, 95, 107, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_k_norm.weight" then return [46, 97, 116, 116, 110, 95, 107, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_output.weight" then return [46, 97, 116, 116, 110, 95, 111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_q.weight" then return [46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_q_norm.weight" then return [46, 97, 116, 116, 110, 95, 113, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".attn_v.weight" then return [46, 97, 116, 116, 110, 95, 118, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".nextn.eh_proj.weight" then return [46, 110, 101, 120, 116, 110, 46, 101, 104, 95, 112, 114, 111, 106, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".nextn.enorm.weight" then return [46, 110, 101, 120, 116, 110, 46, 101, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".nextn.hnorm.weight" then return [46, 110, 101, 120, 116, 110, 46, 104, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ ".nextn.shared_head_norm.weight" then return [46, 110, 101, 120, 116, 110, 46, 115, 104, 97, 114, 101, 100, 95, 104, 101, 97, 100, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    return []
}

fn str(string s) → list<u8> {
    const list<u8> b ← text_bytes(s)
    return join(u64(b.length()), b)
}

fn kv(string key, int kind, list<u8> value) → list<u8> {
    return join(join(str(key), u32(kind)), value)
}

# Key-bytes variant for generated filler keys ("general.extra.N").
fn kv_bytes(list<u8> key, int kind, list<u8> value) → list<u8> {
    return join(join(join(u64(key.length()), key), u32(kind)), value)
}

fn array(int kind, int count, list<u8> value) → list<u8> {
    return join(join(u32(kind), u64(count)), value)
}

fn header(int tensors, int metadata) → list<u8> {
    return join(join([71, 71, 85, 70], u32(3)), join(u64(tensors), u64(metadata)))
}

fn with_padding(list<u8> table, int alignment, int total, bool extra_data) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    var list<u8> b ← empty
    for from table const x {
        b.append(x)
    }
    while b.length() ≺ data_offset {
        b.append(0 ∷ u8)
    }
    if extra_data {
        b.append(0 ∷ u8)
    }
    const bytes o ↤ b
    return gguf_manifest.GgufCorpus {table = o, artifact_length = total, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = total}}
}

fn full(list<u8> table, int alignment, int payload) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    return with_padding(table, alignment, data_offset + payload, false)
}

# Why: `∷` states only what the compiler proves (D1.11); `(48 + n) ↦ int<u8> ⊥ 0` is
# a failable conversion whose default never applies: n is one or two decimal digits (0..99), so 48 + digit is an ASCII digit byte.
# "general.extra." followed by one or two ASCII digits.
fn general_extra_key(int n) → list<u8> {
    const list<u8> prefix ← [103, 101, 110, 101, 114, 97, 108, 46, 101, 120, 116, 114, 97, 46]
    var list<u8> out ← empty
    for from prefix const p {
        out.append(p)
    }
    if n ≺ 10 {
        out.append((48 + n) ↦ u8 ⊥ 0)
    }
    else {
        out.append((48 + n / 10) ↦ u8 ⊥ 0)
        out.append((48 + n % 10) ↦ u8 ⊥ 0)
    }
    return out
}

fn strings_repeat(int count, list<u8> bytes) → list<u8> {
    var list<u8> out ← empty
    for range 0‥count const i {
        for from bytes const b {
            out.append(b)
        }
    }
    return out
}

fn u32_repeat(int count) → list<u8> {
    const list<u8> four ← u32(0)
    var list<u8> out ← empty
    for range 0‥count const i {
        for from four const b {
            out.append(b)
        }
    }
    return out
}

# The 34 frozen metadata rows plus 21 `general.extra.N` filler keys to the
# pinned 55-entry count. The three mutable facts are parameterized so each
# mutation-family-1 corpus differs in exactly one fact.
fn corpus_mutatum(int block_count, bool cum_ssm, int embedding, bool extra_qwen, bool extra_general) → gguf_manifest.GgufCorpus {
    var int count ← 55
    if not cum_ssm {
        count ← count - 1
    }
    if extra_qwen {
        count ← count + 1
    }
    if extra_general {
        count ← count + 1
    }
    var list<u8> table ← header(0, count)
    table ← join(table, kv("general.architecture", 8, str("qwen35moe")))
    table ← join(table, kv("general.file_type", 4, u32(15)))
    table ← join(table, kv("general.quantization_version", 4, u32(2)))
    table ← join(table, kv("qwen35moe.block_count", 4, u32(block_count)))
    table ← join(table, kv("qwen35moe.context_length", 4, u32(262144)))
    table ← join(table, kv("qwen35moe.embedding_length", 4, u32(embedding)))
    table ← join(table, kv("qwen35moe.attention.head_count", 4, u32(16)))
    table ← join(table, kv("qwen35moe.attention.head_count_kv", 4, u32(2)))
    table ← join(table, kv("qwen35moe.attention.key_length", 4, u32(256)))
    table ← join(table, kv("qwen35moe.attention.value_length", 4, u32(256)))
    table ← join(table, kv("qwen35moe.attention.layer_norm_rms_epsilon", 6, [189, 55, 134, 53]))
    table ← join(table, kv("qwen35moe.rope.freq_base", 6, [128, 150, 24, 75]))
    table ← join(table, kv("qwen35moe.rope.dimension_count", 4, u32(64)))
    table ← join(table, kv("qwen35moe.rope.dimension_sections", 9, array(4, 4, join(join(u32(11), u32(11)), join(u32(10), u32(0))))))
    table ← join(table, kv("qwen35moe.expert_count", 4, u32(256)))
    table ← join(table, kv("qwen35moe.expert_used_count", 4, u32(8)))
    table ← join(table, kv("qwen35moe.expert_feed_forward_length", 4, u32(512)))
    table ← join(table, kv("qwen35moe.expert_shared_feed_forward_length", 4, u32(512)))
    table ← join(table, kv("qwen35moe.ssm.conv_kernel", 4, u32(4)))
    if cum_ssm {
        table ← join(table, kv("qwen35moe.ssm.state_size", 4, u32(128)))
    }
    table ← join(table, kv("qwen35moe.ssm.group_count", 4, u32(16)))
    table ← join(table, kv("qwen35moe.ssm.time_step_rank", 4, u32(32)))
    table ← join(table, kv("qwen35moe.ssm.inner_size", 4, u32(4096)))
    table ← join(table, kv("qwen35moe.full_attention_interval", 4, u32(4)))
    table ← join(table, kv("qwen35moe.nextn_predict_layers", 4, u32(1)))
    table ← join(table, kv("tokenizer.ggml.model", 8, str("gpt2")))
    table ← join(table, kv("tokenizer.ggml.pre", 8, str("qwen35")))
    table ← join(table, kv("tokenizer.ggml.tokens", 9, array(8, TOKENS_PIN, strings_repeat(TOKENS_PIN, str("<s>")))))
    table ← join(table, kv("tokenizer.ggml.token_type", 9, array(4, TOKENS_PIN, u32_repeat(TOKENS_PIN))))
    table ← join(table, kv("tokenizer.ggml.merges", 9, array(8, MERGES_PIN, strings_repeat(MERGES_PIN, str("hello")))))
    table ← join(table, kv("tokenizer.ggml.eos_token_id", 4, u32(248046)))
    table ← join(table, kv("tokenizer.ggml.padding_token_id", 4, u32(248055)))
    table ← join(table, kv("tokenizer.ggml.bos_token_id", 4, u32(248044)))
    table ← join(table, kv("tokenizer.ggml.add_bos_token", 7, u8(0)))
    var int extra_count ← 21
    if extra_general {
        extra_count ← extra_count + 1
    }
    for range 0‥extra_count const i {
        table ← join(table, kv_bytes(general_extra_key(i), 4, u32(1)))
    }
    if extra_qwen {
        table ← join(table, kv("qwen35moe.extra_fact", 4, u32(1)))
    }
    return full(table, 32, 0)
}

fn freeze_manif(gguf_manifest.GgufManifest m) → string {
    do {
        const qwen35moe.Qwen35moeConfig c ← qwen35moe.freeze(m)
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn freeze_result(gguf_manifest.GgufCorpus corpus) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        return freeze_manif(m)
    }
    catch err {
        return err.message
    }
}

fn freeze_puncta_manif(gguf_manifest.GgufManifest m) → bool {
    do {
        const qwen35moe.Qwen35moeConfig c ← qwen35moe.freeze(m)
        assert c.architecture ≡ "qwen35moe"
        assert c.file_type ≡ 15
        assert c.quantization_version ≡ 2
        assert c.block_count ≡ 41
        assert c.context_length ≡ 262144
        assert c.embedding_length ≡ 2048
        assert c.head_count ≡ 16
        assert c.head_count_kv ≡ 2
        assert c.key_length ≡ 256
        assert c.value_length ≡ 256
        assert c.rms_norm_epsilon ≡ 0.0000009999999974752427 ∷ f32
        assert c.freq_base ≡ 10000000.0 ∷ f32
        assert c.rope_dimension_count ≡ 64
        assert c.rope_sections.get(0) coalesce 0 ≡ 11
        assert c.rope_sections.get(1) coalesce 0 ≡ 11
        assert c.rope_sections.get(2) coalesce 0 ≡ 10
        assert c.rope_sections.get(3) coalesce 0 ≡ 0
        assert c.expert_count ≡ 256
        assert c.expert_used_count ≡ 8
        assert c.expert_ffn_length ≡ 512
        assert c.shared_ffn_length ≡ 512
        assert c.conv_kernel ≡ 4
        assert c.state_size ≡ 128
        assert c.group_count ≡ 16
        assert c.gradus_temporis ≡ 32
        assert c.inner_size ≡ 4096
        assert c.full_attention_interval ≡ 4
        assert c.nextn_predict_layers ≡ 1
        assert c.tokenizer_model ≡ "gpt2"
        assert c.tokenizer_pre ≡ "qwen35"
        assert c.token_count ≡ 248320
        assert c.token_type_count ≡ 248320
        assert c.merge_count ≡ 247587
        assert c.eos_token_id ≡ 248046
        assert c.padding_token_id ≡ 248055
        assert c.bos_token_id ≡ 248044
        assert c.add_bos_token ≡ false
        return true
    }
    catch err {
        return false
    }
}

fn freeze_puncta() → bool {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus_mutatum(41, true, 2048, false, false))
        return freeze_puncta_manif(m)
    }
    catch err {
        return false
    }
}

# -------------------------------------------------------------------------
# MODEL-01-M4 canonical 753-tensor corpus builder. GGML raw type ids: f32 0,
# q8_0 8, q4_K 12, q5_K 13, q6_K 14, bf16 30. Offsets are sequential payload
# offsets (the parser requires disjoint stored ranges), sized by the same
# block geometry the manifest parser resolves.
# -------------------------------------------------------------------------

fn blk_bytes(int b) → list<u8> {
    var list<u8> out ← empty
    out.append(98 ∷ u8)
    out.append(108 ∷ u8)
    out.append(107 ∷ u8)
    out.append(46 ∷ u8)
    if b ≥ 10 {
        out.append((48 + b / 10) ↦ u8 ⊥ 0)
    }
    out.append((48 + b % 10) ↦ u8 ⊥ 0)
    return out
}

fn blk_nome_bytes(int b, string suffix) → list<u8> {
    const list<u8> prefix ← blk_bytes(b)
    const list<u8> sfix ← text_bytes(suffix)
    var list<u8> out ← empty
    for from prefix const p {
        out.append(p)
    }
    for from sfix const s {
        out.append(s)
    }
    return out
}

fn str_bytes(list<u8> b) → list<u8> {
    return join(u64(b.length()), b)
}

fn tensors_length(list<int> shape, int kind) → int {
    var int elements ← 1
    for from shape const d {
        elements ← elements * d
    }
    var int elements_per_block ← 1
    var int bytes_per_block ← 4
    if kind ≡ 8 {
        elements_per_block ← 32
        bytes_per_block ← 34
    }
    if kind ≡ 12 {
        elements_per_block ← 256
        bytes_per_block ← 144
    }
    if kind ≡ 13 {
        elements_per_block ← 256
        bytes_per_block ← 176
    }
    if kind ≡ 14 {
        elements_per_block ← 256
        bytes_per_block ← 210
    }
    if kind ≡ 30 {
        elements_per_block ← 1
        bytes_per_block ← 2
    }
    return (elements / elements_per_block) * bytes_per_block
}

fn tensors_bytes(list<u8> name, list<int> shape, int kind, int offset) → list<u8> {
    var list<u8> out ← str_bytes(name)
    out ← join(out, u32(shape.length()))
    for from shape const d {
        out ← join(out, u64(d))
    }
    out ← join(out, u32(kind))
    out ← join(out, u64(offset))
    return out
}

# Accumulating tensor-table fragment: bytes built so far plus the next free
# payload offset.
class TensorFragment {
    var list<u8> bytes
    var int end
}

fn append_tensor(TensorFragment f, list<u8> name, list<int> shape, int kind) → TensorFragment {
    const int length ← tensors_length(shape, kind)
    return TensorFragment {bytes = join(f.bytes, tensors_bytes(name, shape, kind, f.end)), end = f.end + length}
}

# Hybrid SSM/attention block tensor set (19); q6_K down family in blk.34/38.
fn hybrid_fragments(TensorFragment f, int b, bool rename, bool down_dropped, bool down_q6_exact, bool qkv_embd_corrupted) → TensorFragment {
    var TensorFragment g ← f
    var string norm_suffix ← ".attn_norm.weight"
    if rename and b ≡ 0 {
        norm_suffix ← ".attn_norm2.weight"
    }
    var list<int> down_shape ← [512, 2048, 256]
    if down_dropped and b ≡ 0 {
        down_shape ← [512, 2048]
    }
    var int down_dtype ← 13
    if not down_q6_exact and (b ≡ 34 or b ≡ 38) {
        down_dtype ← 14
    }
    var list<int> qkv_shape ← [2048, 8192]
    if qkv_embd_corrupted and b ≡ 0 {
        qkv_shape ← [1024, 8192]
    }
    g ← append_tensor(g, blk_nome_bytes(b, ".attn_gate.weight"), [2048, 4096], 8)
    g ← append_tensor(g, blk_nome_bytes(b, norm_suffix), [2048], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".attn_qkv.weight"), qkv_shape, 8)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_down_exps.weight"), down_shape, down_dtype)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_down_shexp.weight"), [512, 2048], 8)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_gate_exps.weight"), [2048, 512, 256], 12)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_gate_inp.weight"), [2048, 256], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_gate_inp_shexp.weight"), [2048], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_gate_shexp.weight"), [2048, 512], 8)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_up_exps.weight"), [2048, 512, 256], 12)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_up_shexp.weight"), [2048, 512], 8)
    g ← append_tensor(g, blk_nome_bytes(b, ".post_attention_norm.weight"), [2048], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".ssm_a"), [32], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".ssm_alpha.weight"), [2048, 32], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".ssm_beta.weight"), [2048, 32], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".ssm_conv1d.weight"), [4, 8192], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".ssm_dt.bias"), [32], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".ssm_norm.weight"), [128], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".ssm_out.weight"), [4096, 2048], 8)
    return g
}

# Full-attention block tensor set (16); q6_K down family in blk.39.
fn full_fragments(TensorFragment f, int b, bool down_q6_exact, bool attn_k_corrupted) → TensorFragment {
    var TensorFragment g ← f
    var int down_dtype ← 13
    if not down_q6_exact and b ≡ 39 {
        down_dtype ← 14
    }
    var list<int> attn_k_shape ← [2048, 512]
    if attn_k_corrupted and b ≡ 3 {
        attn_k_shape ← [2048, 256]
    }
    g ← append_tensor(g, blk_nome_bytes(b, ".attn_k.weight"), attn_k_shape, 8)
    g ← append_tensor(g, blk_nome_bytes(b, ".attn_k_norm.weight"), [256], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".attn_norm.weight"), [2048], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".attn_output.weight"), [4096, 2048], 8)
    g ← append_tensor(g, blk_nome_bytes(b, ".attn_q.weight"), [2048, 8192], 8)
    g ← append_tensor(g, blk_nome_bytes(b, ".attn_q_norm.weight"), [256], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".attn_v.weight"), [2048, 512], 8)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_down_exps.weight"), [512, 2048, 256], down_dtype)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_down_shexp.weight"), [512, 2048], 8)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_gate_exps.weight"), [2048, 512, 256], 12)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_gate_inp.weight"), [2048, 256], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_gate_inp_shexp.weight"), [2048], 0)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_gate_shexp.weight"), [2048, 512], 8)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_up_exps.weight"), [2048, 512, 256], 12)
    g ← append_tensor(g, blk_nome_bytes(b, ".ffn_up_shexp.weight"), [2048, 512], 8)
    g ← append_tensor(g, blk_nome_bytes(b, ".post_attention_norm.weight"), [2048], 0)
    return g
}

# Nextn block blk.40 tensor set (20): full-attention 16 with the frozen
# bf16 anomaly on ffn_gate_inp/ffn_gate_inp_shexp, plus the four nextn.*
# tensors.
fn nextn_fragments(TensorFragment f, bool bf16_exact, bool omit_last) → TensorFragment {
    var TensorFragment g ← f
    var int inp_dtype ← 30
    if bf16_exact {
        inp_dtype ← 0
    }
    g ← append_tensor(g, blk_nome_bytes(40, ".attn_k.weight"), [2048, 512], 8)
    g ← append_tensor(g, blk_nome_bytes(40, ".attn_k_norm.weight"), [256], 0)
    g ← append_tensor(g, blk_nome_bytes(40, ".attn_norm.weight"), [2048], 0)
    g ← append_tensor(g, blk_nome_bytes(40, ".attn_output.weight"), [4096, 2048], 8)
    g ← append_tensor(g, blk_nome_bytes(40, ".attn_q.weight"), [2048, 8192], 8)
    g ← append_tensor(g, blk_nome_bytes(40, ".attn_q_norm.weight"), [256], 0)
    g ← append_tensor(g, blk_nome_bytes(40, ".attn_v.weight"), [2048, 512], 8)
    g ← append_tensor(g, blk_nome_bytes(40, ".ffn_down_exps.weight"), [512, 2048, 256], 13)
    g ← append_tensor(g, blk_nome_bytes(40, ".ffn_down_shexp.weight"), [512, 2048], 8)
    g ← append_tensor(g, blk_nome_bytes(40, ".ffn_gate_exps.weight"), [2048, 512, 256], 12)
    g ← append_tensor(g, blk_nome_bytes(40, ".ffn_gate_inp.weight"), [2048, 256], inp_dtype)
    g ← append_tensor(g, blk_nome_bytes(40, ".ffn_gate_inp_shexp.weight"), [2048], inp_dtype)
    g ← append_tensor(g, blk_nome_bytes(40, ".ffn_gate_shexp.weight"), [2048, 512], 8)
    g ← append_tensor(g, blk_nome_bytes(40, ".ffn_up_exps.weight"), [2048, 512, 256], 12)
    g ← append_tensor(g, blk_nome_bytes(40, ".ffn_up_shexp.weight"), [2048, 512], 8)
    g ← append_tensor(g, blk_nome_bytes(40, ".post_attention_norm.weight"), [2048], 0)
    g ← append_tensor(g, blk_nome_bytes(40, ".nextn.eh_proj.weight"), [4096, 2048], 8)
    g ← append_tensor(g, blk_nome_bytes(40, ".nextn.enorm.weight"), [2048], 0)
    g ← append_tensor(g, blk_nome_bytes(40, ".nextn.hnorm.weight"), [2048], 0)
    if not omit_last {
        g ← append_tensor(g, blk_nome_bytes(40, ".nextn.shared_head_norm.weight"), [2048], 0)
    }
    return g
}

# The full canonical tensor table: 3 globals then blocks 0..40 classified by
# the frozen schedule (nextn at 40, full-attention at index ≡ 3 mod 4).
fn canonical_fragments(bool rename_attn_norm, bool down_dropped, bool bf16_exact, bool down_q6_exact, bool omit_last, bool qkv_embd_corrupted, bool attn_k_corrupted, int blocks) → TensorFragment {
    var TensorFragment f ← TensorFragment {bytes = empty, end = 0}
    f ← append_tensor(f, text_bytes("output.weight"), [2048, 248320], 14)
    f ← append_tensor(f, text_bytes("output_norm.weight"), [2048], 0)
    f ← append_tensor(f, text_bytes("token_embd.weight"), [2048, 248320], 8)
    var int b ← 0
    while b ≺ blocks {
        if b ≡ 40 {
            f ← nextn_fragments(f, bf16_exact, omit_last)
        }
        else {
            if b % 4 ≡ 3 {
                f ← full_fragments(f, b, down_q6_exact, attn_k_corrupted)
            }
            else {
                f ← hybrid_fragments(f, b, rename_attn_norm, down_dropped, down_q6_exact, qkv_embd_corrupted)
            }
        }
        b ↑
    }
    return f
}

# The canonical corpus: the 55 frozen metadata entries (34 rows + 21 filler
# keys, the same set the M3 corpora carry) plus the tensor table.
fn tensor_corpus(TensorFragment fragments, int tensors) → gguf_manifest.GgufCorpus {
    return tensor_corpus_arch(fragments, tensors, "qwen35moe")
}

# Canonical corpus with a caller-picked `general.architecture` value
# (MODEL-01-M6 family-7 unsupported-but-inspectable oracle).
fn tensor_corpus_arch(TensorFragment fragments, int tensors, string architecture) → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(tensors, 55)
    table ← join(table, kv("general.architecture", 8, str(architecture)))
    table ← join(table, kv("general.file_type", 4, u32(15)))
    table ← join(table, kv("general.quantization_version", 4, u32(2)))
    table ← join(table, kv("qwen35moe.block_count", 4, u32(41)))
    table ← join(table, kv("qwen35moe.context_length", 4, u32(262144)))
    table ← join(table, kv("qwen35moe.embedding_length", 4, u32(2048)))
    table ← join(table, kv("qwen35moe.attention.head_count", 4, u32(16)))
    table ← join(table, kv("qwen35moe.attention.head_count_kv", 4, u32(2)))
    table ← join(table, kv("qwen35moe.attention.key_length", 4, u32(256)))
    table ← join(table, kv("qwen35moe.attention.value_length", 4, u32(256)))
    table ← join(table, kv("qwen35moe.attention.layer_norm_rms_epsilon", 6, [189, 55, 134, 53]))
    table ← join(table, kv("qwen35moe.rope.freq_base", 6, [128, 150, 24, 75]))
    table ← join(table, kv("qwen35moe.rope.dimension_count", 4, u32(64)))
    table ← join(table, kv("qwen35moe.rope.dimension_sections", 9, array(4, 4, join(join(u32(11), u32(11)), join(u32(10), u32(0))))))
    table ← join(table, kv("qwen35moe.expert_count", 4, u32(256)))
    table ← join(table, kv("qwen35moe.expert_used_count", 4, u32(8)))
    table ← join(table, kv("qwen35moe.expert_feed_forward_length", 4, u32(512)))
    table ← join(table, kv("qwen35moe.expert_shared_feed_forward_length", 4, u32(512)))
    table ← join(table, kv("qwen35moe.ssm.conv_kernel", 4, u32(4)))
    table ← join(table, kv("qwen35moe.ssm.state_size", 4, u32(128)))
    table ← join(table, kv("qwen35moe.ssm.group_count", 4, u32(16)))
    table ← join(table, kv("qwen35moe.ssm.time_step_rank", 4, u32(32)))
    table ← join(table, kv("qwen35moe.ssm.inner_size", 4, u32(4096)))
    table ← join(table, kv("qwen35moe.full_attention_interval", 4, u32(4)))
    table ← join(table, kv("qwen35moe.nextn_predict_layers", 4, u32(1)))
    table ← join(table, kv("tokenizer.ggml.model", 8, str("gpt2")))
    table ← join(table, kv("tokenizer.ggml.pre", 8, str("qwen35")))
    table ← join(table, kv("tokenizer.ggml.tokens", 9, array(8, TOKENS_PIN, strings_repeat(TOKENS_PIN, str("<s>")))))
    table ← join(table, kv("tokenizer.ggml.token_type", 9, array(4, TOKENS_PIN, u32_repeat(TOKENS_PIN))))
    table ← join(table, kv("tokenizer.ggml.merges", 9, array(8, MERGES_PIN, strings_repeat(MERGES_PIN, str("hello")))))
    table ← join(table, kv("tokenizer.ggml.eos_token_id", 4, u32(248046)))
    table ← join(table, kv("tokenizer.ggml.padding_token_id", 4, u32(248055)))
    table ← join(table, kv("tokenizer.ggml.bos_token_id", 4, u32(248044)))
    table ← join(table, kv("tokenizer.ggml.add_bos_token", 7, u8(0)))
    for range 0‥21 const i {
        table ← join(table, kv_bytes(general_extra_key(i), 4, u32(1)))
    }
    table ← join(table, fragments.bytes)
    return full(table, 32, fragments.end + 1)
}

fn tensors_manif(gguf_manifest.GgufManifest m) → string {
    do {
        const qwen35moe.QwenTensorSummary s ← qwen35moe.canonical_tensors(m)
        return "ok"
    }
    catch err {
        return qwen35moe.tensor_message(err)
    }
}

fn tensors_result(gguf_manifest.GgufCorpus corpus) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        return tensors_manif(m)
    }
    catch err {
        return err.message
    }
}

fn tensors_puncta() → bool {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(tensor_corpus(canonical_fragments(false, false, false, false, false, false, false, 41), 753))
        do {
            const qwen35moe.QwenTensorSummary s ← qwen35moe.canonical_tensors(m)
            assert s.total ≡ 753
            assert s.globals ≡ 3
            assert s.hybrid ≡ 30
            assert s.full_attention ≡ 10
            assert s.nextn ≡ 1
            assert s.storage_f32 ≡ 368
            assert s.storage_q8_0 ≡ 259
            assert s.storage_q4_k ≡ 82
            assert s.storage_q5_k ≡ 38
            assert s.storage_q6_k ≡ 4
            assert s.storage_bf16 ≡ 2
            assert s.expert_rank3 ≡ 123
            return true
        }
        catch err {
            return false
        }
    }
    catch err {
        return false
    }
}

# -------------------------------------------------------------------------
# MODEL-01-M5 cross-reference oracle helpers: freeze the config (M3), then
# run the dimension/storage cross-reference validator against the manifest.
# -------------------------------------------------------------------------

fn reference_manif(gguf_manifest.GgufManifest m) → string {
    do {
        const qwen35moe.Qwen35moeConfig c ← qwen35moe.freeze(m)
        do {
            const bool ok ← qwen35moe.reference(c, m)
            return "ok"
        }
        catch err {
            return qwen35moe.reference_message(err)
        }
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn reference_result(gguf_manifest.GgufCorpus corpus) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        return reference_manif(m)
    }
    catch err {
        return err.message
    }
}

test "canonical family sets, 41-block schedule, storage distribution and anomalies pin" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert tensors_result(tensor_corpus(canonical_fragments(false, false, false, false, false, false, false, 41), 753)) ≡ "ok"
    assert tensors_puncta()
}

test "mutation family 2: a canonical tensor rename yields a typed name diagnostic naming the first diverging fact" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert tensors_result(tensor_corpus(canonical_fragments(true, false, false, false, false, false, false, 41), 753)) ≡ "qwen35moe tensor name divergence at blk.0.attn_norm.weight"
}

test "mutation family 3: a rank-3 expert tensor collapsed to rank-2 yields a typed shape diagnostic" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert tensors_result(tensor_corpus(canonical_fragments(false, true, false, false, false, false, false, 41), 753)) ≡ "qwen35moe tensor shape divergence at blk.0.ffn_down_exps.weight"
}

test "mutation family 4: the blk.40 bf16 anomaly corrected away fails typed; the blk.34/38/39 q6_K anomaly corrected away fails typed" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert tensors_result(tensor_corpus(canonical_fragments(false, false, true, false, false, false, false, 41), 753)) ≡ "qwen35moe tensor storage divergence at blk.40.ffn_gate_inp.weight"
    assert tensors_result(tensor_corpus(canonical_fragments(false, false, false, true, false, false, false, 41), 753)) ≡ "qwen35moe tensor storage divergence at blk.34.ffn_down_exps.weight"
}

test "mutation family 5: the tensor count 753→752 yields a typed count diagnostic" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert tensors_result(tensor_corpus(canonical_fragments(false, false, false, false, true, false, false, 41), 752)) ≡ "qwen35moe tensor count divergence: tensor count 752 ≠ 753"
}

test "every cross-reference pin type-checks on the canonical corpus" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert reference_result(tensor_corpus(canonical_fragments(false, false, false, false, false, false, false, 41), 753)) ≡ "ok"
}

test "a deliberate cross-fact violation (attn_qkv embedding dim ≠ 2048) yields the typed first-divergence diagnostic" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert reference_result(tensor_corpus(canonical_fragments(false, false, false, false, false, true, false, 41), 753)) ≡ "qwen35moe cross-reference dimension divergence at blk.0.attn_qkv.weight"
}

test "a deliberate cross-fact violation (head_count_kv × key_length ≠ dim 1 of attn_k) yields the typed first-divergence diagnostic" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert reference_result(tensor_corpus(canonical_fragments(false, false, false, false, false, false, true, 41), 753)) ≡ "qwen35moe cross-reference dimension divergence at blk.3.attn_k.weight"
}

test "freezes every frozen config row with the metadata count pinned at 55" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert freeze_result(corpus_mutatum(41, true, 2048, false, false)) ≡ "ok"
    assert freeze_puncta()
}

test "mutation family 1: a frozen qwen35moe value change yields a typed diagnostic naming the first diverging key" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert freeze_result(corpus_mutatum(42, true, 2048, false, false)) ≡ "qwen35moe metadata divergence at qwen35moe.block_count"
    assert freeze_result(corpus_mutatum(41, true, 1024, false, false)) ≡ "qwen35moe metadata divergence at qwen35moe.embedding_length"
}

test "mutation family 1: a missing required key yields a typed diagnostic naming that key" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert freeze_result(corpus_mutatum(41, false, 2048, false, false)) ≡ "qwen35moe metadata divergence at qwen35moe.ssm.state_size"
}

test "mutation family 1: an extra unknown qwen35moe.* key fails closed" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert freeze_result(corpus_mutatum(41, true, 2048, true, false)) ≡ "qwen35moe metadata divergence at qwen35moe.extra_fact"
}

test "mutation family 1: a metadata count divergence yields a typed diagnostic" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    assert freeze_result(corpus_mutatum(41, true, 2048, false, true)) ≡ "qwen35moe metadata divergence at metadata count"
}

# -------------------------------------------------------------------------
# MODEL-01-M6 admission entry point + identity precondition + typed
# refusal matrix. `admit` composes identity precondition (family 6,
# before any architecture read) -> config freeze (M3) -> canonical tensor
# map (M4) -> cross-reference validation (M5) and returns ADMIT with the
# frozen configuration + the 753-tensor receipt. Family 7 refuses an
# unknown architecture name or raw GGML type as unsupported-but-
# inspectable (stays inspectable as data per GGUF-A1a, cannot admit).
# -------------------------------------------------------------------------

const string F_DIGEST_BAD = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# One unknown-raw-GGML-type tensor (type id 999, Unknown layout).
fn fragment_dtype_unknown() → TensorFragment {
    var TensorFragment f ← TensorFragment {bytes = empty, end = 0}
    return append_tensor(f, blk_nome_bytes(0, ".attn_norm.weight"), [2048], 999)
}

fn canonical_corpus() → gguf_manifest.GgufCorpus {
    return tensor_corpus(canonical_fragments(false, false, false, false, false, false, false, 41), 753)
}

fn admission_result(gguf_manifest.GgufCorpus corpus, string digest, int length) → string {
    do {
        const qwen35moe.Qwen35moeAdmission a ← qwen35moe.admit(corpus, digest, length)
        return "ADMIT"
    }
    catch err {
        return qwen35moe.admission_message(err)
    }
}

fn admission_puncta(gguf_manifest.GgufCorpus corpus) → bool {
    do {
        const qwen35moe.Qwen35moeAdmission a ← qwen35moe.admit(corpus, F_DIGEST, corpus.artifact_length)
        assert a.config.architecture ≡ "qwen35moe"
        assert a.config.file_type ≡ 15
        assert a.config.quantization_version ≡ 2
        assert a.config.block_count ≡ 41
        assert a.config.context_length ≡ 262144
        assert a.config.embedding_length ≡ 2048
        assert a.config.head_count ≡ 16
        assert a.config.head_count_kv ≡ 2
        assert a.config.key_length ≡ 256
        assert a.config.value_length ≡ 256
        assert a.config.rms_norm_epsilon ≡ 0.0000009999999974752427 ∷ f32
        assert a.config.freq_base ≡ 10000000.0 ∷ f32
        assert a.config.rope_dimension_count ≡ 64
        assert a.config.rope_sections.get(0) coalesce 0 ≡ 11
        assert a.config.rope_sections.get(1) coalesce 0 ≡ 11
        assert a.config.rope_sections.get(2) coalesce 0 ≡ 10
        assert a.config.rope_sections.get(3) coalesce 0 ≡ 0
        assert a.config.expert_count ≡ 256
        assert a.config.expert_used_count ≡ 8
        assert a.config.expert_ffn_length ≡ 512
        assert a.config.shared_ffn_length ≡ 512
        assert a.config.conv_kernel ≡ 4
        assert a.config.state_size ≡ 128
        assert a.config.group_count ≡ 16
        assert a.config.gradus_temporis ≡ 32
        assert a.config.inner_size ≡ 4096
        assert a.config.full_attention_interval ≡ 4
        assert a.config.nextn_predict_layers ≡ 1
        assert a.config.tokenizer_model ≡ "gpt2"
        assert a.config.tokenizer_pre ≡ "qwen35"
        assert a.config.token_count ≡ 248320
        assert a.config.token_type_count ≡ 248320
        assert a.config.merge_count ≡ 247587
        assert a.config.eos_token_id ≡ 248046
        assert a.config.padding_token_id ≡ 248055
        assert a.config.bos_token_id ≡ 248044
        assert a.config.add_bos_token ≡ false
        assert a.summary.total ≡ 753
        assert a.summary.globals ≡ 3
        assert a.summary.hybrid ≡ 30
        assert a.summary.full_attention ≡ 10
        assert a.summary.nextn ≡ 1
        assert a.summary.storage_f32 ≡ 368
        assert a.summary.storage_q8_0 ≡ 259
        assert a.summary.storage_q4_k ≡ 82
        assert a.summary.storage_q5_k ≡ 38
        assert a.summary.storage_q6_k ≡ 4
        assert a.summary.storage_bf16 ≡ 2
        assert a.summary.expert_rank3 ≡ 123
        return true
    }
    catch err {
        return false
    }
}

test "ADMIT returns the frozen configuration and the 753-tensor receipt on the exact frozen facts" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    {
        const gguf_manifest.GgufCorpus corpus ← canonical_corpus()
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "ADMIT"
        assert admission_puncta(corpus)
    }
}

test "family 6: a wrong SHA-256 fails with the identity diagnostic before any architecture read" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    {
        const gguf_manifest.GgufCorpus corpus ← canonical_corpus()
        assert admission_result(corpus, F_DIGEST_BAD, corpus.artifact_length) ≡ "qwen35moe admission identity divergence: SHA-256"
    }
}

test "family 6: a wrong byte length fails with the identity diagnostic before any architecture read" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    {
        const gguf_manifest.GgufCorpus corpus ← canonical_corpus()
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length + 1) ≡ "qwen35moe admission identity divergence: byte length"
    }
}

test "family 6 precedes any architecture read: a llama corpus with a wrong digest yields the identity diagnostic" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    {
        const gguf_manifest.GgufCorpus corpus ← tensor_corpus_arch(canonical_fragments(false, false, false, false, false, false, false, 41), 753, "llama")
        assert admission_result(corpus, F_DIGEST_BAD, corpus.artifact_length) ≡ "qwen35moe admission identity divergence: SHA-256"
    }
}

test "family 7: an unknown architecture stays inspectable as data but cannot admit" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    {
        const gguf_manifest.GgufCorpus corpus ← tensor_corpus_arch(canonical_fragments(false, false, false, false, false, false, false, 41), 753, "llama")
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe admission refusal: unsupported-but-inspectable architecture llama"
    }
}

test "family 7: an unknown raw GGML type stays inspectable as data but cannot admit" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    {
        const gguf_manifest.GgufCorpus corpus ← tensor_corpus(fragment_dtype_unknown(), 1)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe admission refusal: unsupported-but-inspectable raw GGML type at blk.0.attn_norm.weight"
    }
}

test "family 1 through admission: a frozen metadata divergence yields the typed diagnostic" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    {
        const gguf_manifest.GgufCorpus corpus ← corpus_mutatum(42, true, 2048, false, false)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe metadata divergence at qwen35moe.block_count"
    }
}

test "families 2-5 through admission: name, shape, storage, and count divergences yield the typed diagnostics" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    {
        const gguf_manifest.GgufCorpus corpus ← tensor_corpus(canonical_fragments(true, false, false, false, false, false, false, 41), 753)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe tensor name divergence at blk.0.attn_norm.weight"
    }
    {
        const gguf_manifest.GgufCorpus corpus ← tensor_corpus(canonical_fragments(false, true, false, false, false, false, false, 41), 753)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe tensor shape divergence at blk.0.ffn_down_exps.weight"
    }
    {
        const gguf_manifest.GgufCorpus corpus ← tensor_corpus(canonical_fragments(false, false, true, false, false, false, false, 41), 753)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe tensor storage divergence at blk.40.ffn_gate_inp.weight"
    }
    {
        const gguf_manifest.GgufCorpus corpus ← tensor_corpus(canonical_fragments(false, false, false, false, true, false, false, 41), 752)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe tensor count divergence: tensor count 752 ≠ 753"
    }
}

test "M5 cross-reference divergences surface through the admission entry" skip "dense in-test GGUF fixture exceeds the 5s unit-test budget" {
    {
        const gguf_manifest.GgufCorpus corpus ← tensor_corpus(canonical_fragments(false, false, false, false, false, true, false, 41), 753)
        assert admission_result(corpus, F_DIGEST, corpus.artifact_length) ≡ "qwen35moe cross-reference dimension divergence at blk.0.attn_qkv.weight"
    }
}
