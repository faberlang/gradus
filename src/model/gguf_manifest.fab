+++
locale = "en"
+++
# GGUF v3 format-general manifest parser and pathless range seam (GGUF-A1b).
#
# Public import: import from "gradus:model/gguf_manifest" gguf_manifest
# Depends on: gradus:model/artifact (pathless content identity).
#
# `parse` consumes a bounded header/metadata/tensor-table corpus. `inspect`
# obtains that same table incrementally from a caller-owned range function and
# never retains the function or source bytes. `read_fragment` obtains only a
# checked tensor subrange. Neither operation retains a path, URL, reader, file
# handle, mapping, device object, or payload. `payload_wire` is the exact encoded
# GGUF value payload, beginning at the value's first byte and ending after its
# own length-prefixed content.

import from "gradus:model/artifact" artifact

# GGUF v3 wire value kinds (gguf.h enum gguf_type).
const int GGUF_UINT8 ← 0

const int GGUF_INT8 ← 1

const int GGUF_UINT16 ← 2

const int GGUF_INT16 ← 3

const int GGUF_UINT32 ← 4

const int GGUF_INT32 ← 5

const int GGUF_FLOAT32 ← 6

const int GGUF_BOOL ← 7

const int GGUF_STRING ← 8

const int GGUF_ARRAY ← 9

const int GGUF_UINT64 ← 10

const int GGUF_INT64 ← 11

const int GGUF_FLOAT64 ← 12

# GGML storage ids and block geometry. The table covers the ordinary GGUF
# scalar, integer, BF16, and K-quant rows seen in current Hub artifacts. A
# valid but unlisted id stays inspectable as GgmlLayout.Unknown.
const int GGML_F32 ← 0

const int GGML_F16 ← 1

const int GGML_Q4_0 ← 2

const int GGML_Q4_1 ← 3

const int GGML_Q5_0 ← 6

const int GGML_Q5_1 ← 7

const int GGML_Q8_0 ← 8

const int GGML_Q8_1 ← 9

const int GGML_Q2_K ← 10

const int GGML_Q3_K ← 11

const int GGML_Q4_K ← 12

const int GGML_Q5_K ← 13

const int GGML_Q6_K ← 14

const int GGML_Q8_K ← 15

const int GGML_IQ4_NL ← 20

const int GGML_I8 ← 24

const int GGML_I16 ← 25

const int GGML_I32 ← 26

const int GGML_I64 ← 27

const int GGML_F64 ← 28

const int GGML_BF16 ← 30

const int GGUF_VERSION ← 3

const int DEFAULT_ALIGNMENT ← 32

const int MAGIC_0 ← 71

const int MAGIC_1 ← 71

const int MAGIC_2 ← 85

const int MAGIC_3 ← 70

# Bounds protect the parser from count/length-driven allocation or loops.
# Duplicate-key/name and known-range validation are intentionally bounded
# quadratic scans in this A1 implementation. The 4,096-entry ceilings keep
# that work finite while admitting every inventoried local model (55 metadata
# entries and at most 753 tensors). The 64 MiB corpus ceiling bounds the
# retained header/table copy; the full model payload is never supplied here.
const int KV_LIMIT ← 4096

const int TENSOR_LIMIT ← 4096

const int CORPUS_LIMIT ← 67108864

const int NAME_LIMIT ← 4096

const int TEXT_LIMIT ← 1048576

const int ARRAY_LIMIT ← 1048576

const int RANK_LIMIT ← 64

const int DIMENSION_LIMIT ← 1000000000

const int ELEMENT_LIMIT ← 1000000000

const int MAX_NUMBER ← 9223372036854775807

@ public { }
union GgufManifestError {
    BadFormat {
        string message
    },
    UnknownVersion {
        string message
    },
    Truncated {
        string message
    },
    BadWire {
        string message
    },
    BadBounds {
        string message
    },
    Surplus {
        string message
    },
    DuplicateKey {
        string message
    },
    DuplicateTensor {
        string message
    },
    BadOffset {
        string message
    },
    UnknownLayout {
        string message
    },
    BadIdentity {
        string message
    },
    BadSource {
        string message
    },
    NotFound {
        string message
    }
}

@ public { }
class GgufCorpus {
    bytes table
    int artifact_length
    artifact.ContentIdentity identity
}

# A range source is (int, int) → bytes ⇥ GgufManifestError. Success
# returns the exact requested window; throw is the typed failure channel.

@ public { }
class GgufMetadata {
    string key
    int dtype
    bytes payload_wire
}

@ public { }
union GgmlLayout {
    Known {
        int elements_per_block
        int bytes_per_block
        int byte_length
    },
    Unknown {
        int dtype
    }
}

@ public { }
class GgufTensorDescriptor {
    string name
    list<int> shape
    int dtype_ggml
    int relative_offset
    int elements
    GgmlLayout layout
}

@ public { }
class GgufManifest {
    artifact.ContentIdentity identity
    int version
    int alignment
    int data_start
    int artifact_length
    list<GgufMetadata> metadata
    list<GgufTensorDescriptor> tensors
}

@ public { }
fn message(GgufManifestError e) → string {
    match e {
        case BadFormat const message {
            return message
        }
        case UnknownVersion const message {
            return message
        }
        case Truncated const message {
            return message
        }
        case BadWire const message {
            return message
        }
        case BadBounds const message {
            return message
        }
        case Surplus const message {
            return message
        }
        case DuplicateKey const message {
            return message
        }
        case DuplicateTensor const message {
            return message
        }
        case BadOffset const message {
            return message
        }
        case UnknownLayout const message {
            return message
        }
        case BadIdentity const message {
            return message
        }
        case BadSource const message {
            return message
        }
        case NotFound const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# Basic byte and checked-arithmetic helpers.
# -------------------------------------------------------------------------

@ private { }
fn _byte_list(bytes o) → list<int<u8>> {
    # Use the runtime's bulk byte-vector bridge. Reading `bytes` one element
    # at a time is semantically equivalent, but it makes an owned interpreter
    # carrier copy the whole buffer for every indexed access.
    const value wire ← o ↦ value
    const list<int> numbers ← wire ↦ list<int>
    var list<int<u8>> out ← empty
    for from numbers const v {
        out.append(v ∷ int<u8>)
    }
    return out
}

@ private { }
fn _byte_from_list(list<int<u8>> b) → bytes {
    return b ↦ bytes
}

@ private { }
fn _add(int a, int b) → int ⇥ GgufManifestError {
    require not ((a ≺ 0 or b ≺ 0) or a ≻ MAX_NUMBER - b) throw variant BadBounds {message = "checked offset addition overflow"}
    return a + b
}

@ private { }
fn _mul(int a, int b) → int ⇥ GgufManifestError {
    require not ((a ≺ 0 or b ≺ 0) or b ≠ 0 and a ≻ MAX_NUMBER / b) throw variant BadBounds {message = "checked length multiplication overflow"}
    return a * b
}

@ private { }
fn _slice(list<int<u8>> b, int off, int len) → list<int<u8>> ⇥ GgufManifestError {
    require not (off ≺ 0 or len ≺ 0) throw variant BadBounds {message = "negative byte range"}
    const int end ← _add(off, len)
    require end ≤ b.length() throw variant Truncated {message = "bounded GGUF corpus ends before the required field"}
    var list<int<u8>> out ← empty
    for range 0‥len const i {
        out.append(b.get(off + i) coalesce 0 ∷ int<u8>)
    }
    return out
}

# A source read is deliberately a function value, not a field of any public
# semantic value. The caller chooses the adapter and supplies it anew for
# each operation. The callback throws GgufManifestError (typically BadSource)
# so an application boundary can map an OS/provider diagnostic without
# importing that provider into Gradus.
@ private { }
fn _read_source((int, int) → bytes ⇥ GgufManifestError source, int total, int start, int length) → bytes ⇥ GgufManifestError {
    require not ((total ≤ 0 or start ≺ 0) or length ≺ 0) throw variant BadSource {message = "range source received an invalid range"}
    require length ≤ CORPUS_LIMIT throw variant BadBounds {message = "range source request exceeds the 64 MiB read limit"}
    const int end ← _add(start, length)
    require end ≤ total throw variant BadOffset {message = "range source request exceeds the artifact"}
    const bytes chunk ← source(start, length)
    require chunk.length() ≡ length throw variant BadSource {message = "range source returned an unexpected byte length"}
    return chunk
}

@ private { }
fn _u32(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    const list<int<u8>> x ← _slice(b, off, 4)
    const int r0 ← x.get(0) coalesce 0 ∷ int<u8> ↦ int
    const int r1 ← x.get(1) coalesce 0 ∷ int<u8> ↦ int
    const int r2 ← x.get(2) coalesce 0 ∷ int<u8> ↦ int
    const int r3 ← x.get(3) coalesce 0 ∷ int<u8> ↦ int
    return ((r0 ∨ r1 ⇐ 8) ∨ r2 ⇐ 16) ∨ r3 ⇐ 24
}

@ private { }
fn _u64(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    const list<int<u8>> x ← _slice(b, off, 8)
    const int r7 ← x.get(7) coalesce 0 ∷ int<u8> ↦ int
    require r7 ≺ 128 throw variant BadBounds {message = "GGUF UINT64 value exceeds the numeric carrier"}
    const int r0 ← x.get(0) coalesce 0 ∷ int<u8> ↦ int
    const int r1 ← x.get(1) coalesce 0 ∷ int<u8> ↦ int
    const int r2 ← x.get(2) coalesce 0 ∷ int<u8> ↦ int
    const int r3 ← x.get(3) coalesce 0 ∷ int<u8> ↦ int
    const int r4 ← x.get(4) coalesce 0 ∷ int<u8> ↦ int
    const int r5 ← x.get(5) coalesce 0 ∷ int<u8> ↦ int
    const int r6 ← x.get(6) coalesce 0 ∷ int<u8> ↦ int
    return ((((((r0 ∨ r1 ⇐ 8) ∨ r2 ⇐ 16) ∨ r3 ⇐ 24) ∨ r4 ⇐ 32) ∨ r5 ⇐ 40) ∨ r6 ⇐ 48) ∨ r7 ⇐ 56
}

@ private { }
fn _text(list<int<u8>> b, int off, int len) → string ⇥ GgufManifestError {
    const list<int<u8>> x ← _slice(b, off, len)
    const bytes o ← x
    do {
        return o ↦ string
    }
    catch err {
        throw variant BadWire {message = "GGUF string is not valid UTF-8"}
    }
    throw variant BadWire {message = "unreachable string conversion"}
}

@ private { }
fn _string(list<int<u8>> b, int off) → string ⇥ GgufManifestError {
    const int len ← _u64(b, off)
    require len ≤ TEXT_LIMIT throw variant BadBounds {message = "GGUF string exceeds the bounded text limit"}
    return _text(b, off + 8, len)
}

@ private { }
fn _u8_value(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    const list<int<u8>> x ← _slice(b, off, 1)
    return x.get(0) coalesce 0 ∷ int<u8> ↦ int
}

@ private { }
fn _scalar_size(int kind) → int {
    if (kind ≡ GGUF_UINT8 or kind ≡ GGUF_INT8) or kind ≡ GGUF_BOOL then return 1
    if kind ≡ GGUF_UINT16 or kind ≡ GGUF_INT16 then return 2
    if (kind ≡ GGUF_UINT32 or kind ≡ GGUF_INT32) or kind ≡ GGUF_FLOAT32 then return 4
    if (kind ≡ GGUF_UINT64 or kind ≡ GGUF_INT64) or kind ≡ GGUF_FLOAT64 then return 8
    return 0
}

@ private { }
fn _dtype_valid(int kind) → bool {
    return kind ≥ GGUF_UINT8 and kind ≤ GGUF_FLOAT64
}

# Append one octet buffer to another. The range parser uses this only for one
# metadata value at a time; it never reconstructs or reparses the whole table.
@ private { }
fn _join_bytes(bytes a, bytes b) → bytes {
    var bytes out ← a
    for range 0‥b.length() const i {
        out.append(b.get(i) coalesce 0 ∷ int<u8>)
    }
    return out
}

# Read one metadata value from its absolute wire offset. The result contains
# exactly that value's wire bytes. Arrays recurse over their declared element
# type, but no cumulative header/table prefix is copied or retained.
@ private { }
fn _source_value((int, int) → bytes ⇥ GgufManifestError source, int total, int off, int kind, int depth) → bytes ⇥ GgufManifestError {
    require depth ≤ 64 throw variant BadBounds {message = "metadata array nesting exceeds the bounded depth"}
    require _dtype_valid(kind) throw variant BadWire {message = "unknown GGUF metadata value type"}
    const int scalar ← _scalar_size(kind)
    if scalar ≻ 0 {
        const bytes wire ← _read_source(source, total, off, scalar)
        _size_value(_byte_list(wire), 0, kind, depth)
        return wire
    }
    if kind ≡ GGUF_STRING {
        const bytes header ← _read_source(source, total, off, 8)
        const int len ← _u64(_byte_list(header), 0)
        require len ≤ TEXT_LIMIT throw variant BadBounds {message = "GGUF string exceeds the bounded text limit"}
        const bytes corpus ← _read_source(source, total, _add(off, 8), len)
        _text(_byte_list(corpus), 0, len)
        return _join_bytes(header, corpus)
    }
    if kind ≡ GGUF_ARRAY {
        const bytes header ← _read_source(source, total, off, 12)
        const list<int<u8>> header_list ← _byte_list(header)
        const int element_kind ← _u32(header_list, 0)
        require _dtype_valid(element_kind) throw variant BadWire {message = "unknown GGUF array element type"}
        const int n ← _u64(header_list, 4)
        require n ≤ ARRAY_LIMIT throw variant BadBounds {message = "GGUF array count exceeds the bounded limit"}
        const int element_scalar ← _scalar_size(element_kind)
        if element_scalar ≻ 0 {
            const int length ← _mul(n, element_scalar)
            const bytes corpus ← _read_source(source, total, _add(off, 12), length)
            const bytes out ← _join_bytes(header, corpus)
            _size_value(_byte_list(out), 0, kind, depth)
            return out
        }
        if element_kind ≡ GGUF_STRING {
            var int cursor ← _add(off, 12)
            for range 0‥n const i {
                const bytes item_head ← _read_source(source, total, cursor, 8)
                const int len ← _u64(_byte_list(item_head), 0)
                require len ≤ TEXT_LIMIT throw variant BadBounds {message = "GGUF string exceeds the bounded text limit"}
                cursor ← _add(cursor, _add(8, len))
            }
            const int total_wire ← cursor - off
            # One exact source read preserves the full tokenizer array without
            # copying each growing element through Faber. The bounded scanner
            # above establishes its exact end before this read is issued.
            const bytes wire ← _read_source(source, total, off, total_wire)
            _size_value(_byte_list(wire), 0, kind, depth)
            return wire
        }
        var bytes out ← header
        var int cursor ← _add(off, 12)
        for range 0‥n const i {
            const bytes item ← _source_value(source, total, cursor, element_kind, depth + 1)
            # Append in place. Passing the growing accumulator through the
            # helper would copy it once per element and turn large tokenizer
            # string arrays quadratic.
            var int j ← 0
            while j ≺ item.length() {
                out.append(item.get(j) coalesce 0 ∷ int<u8>)
                j ↑
            }
            cursor ← _add(cursor, item.length())
        }
        return out
    }
    throw variant BadWire {message = "unknown GGUF metadata value type"}
}

# Returns the exact payload size for one typed GGUF value. For an array, the
# returned size includes its element-type and count headers and every nested
# element. No value bytes are retained here; the caller slices them once.
@ private { }
fn _size_value(list<int<u8>> b, int off, int kind, int depth) → int ⇥ GgufManifestError {
    require depth ≤ 64 throw variant BadBounds {message = "metadata array nesting exceeds the bounded depth"}
    const int scalar ← _scalar_size(kind)
    if scalar ≻ 0 {
        if kind ≡ GGUF_BOOL {
            const int v ← _u8_value(b, off)
            require not (v ≠ 0 and v ≠ 1) throw variant BadWire {message = "malformed GGUF bool value"}
        }
        _slice(b, off, scalar)
        return scalar
    }
    if kind ≡ GGUF_STRING {
        const int len ← _u64(b, off)
        require len ≤ TEXT_LIMIT throw variant BadBounds {message = "GGUF string exceeds the bounded text limit"}
        const int total ← _add(8, len)
        _slice(b, off, total)
        # Validate the bytes even though the exact wire is retained.
        _text(b, off + 8, len)
        return total
    }
    if kind ≡ GGUF_ARRAY {
        const int header ← _add(off, 12)
        require header ≤ b.length() throw variant Truncated {message = "truncated GGUF array header"}
        const int element_kind ← _u32(b, off)
        require _dtype_valid(element_kind) throw variant BadWire {message = "unknown GGUF array element type"}
        const int n ← _u64(b, off + 4)
        require n ≤ ARRAY_LIMIT throw variant BadBounds {message = "GGUF array count exceeds the bounded limit"}
        var int total ← 12
        for range 0‥n const i {
            const int part ← _size_value(b, off + total, element_kind, depth + 1)
            total ← _add(total, part)
        }
        _slice(b, off, total)
        return total
    }
    throw variant BadWire {message = "unknown GGUF metadata value type"}
}

# -------------------------------------------------------------------------
# Metadata and identity helpers.
# -------------------------------------------------------------------------

@ private { }
fn _contains(list<string> xs, string x) → bool {
    for range 0‥xs.length() const i {
        if xs.get(i) coalesce "" ≡ x then return true
    }
    return false
}

@ private { }
fn _digest_ok(string digest) → bool {
    if digest.length() ≠ 64 then return false
    for range 0‥digest.length() const i {
        const string c ← digest.slice(i, i + 1)
        if not (((((((((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9") or c ≡ "a") or c ≡ "b") or c ≡ "c") or c ≡ "d") or c ≡ "e") or c ≡ "f") then return false
    }
    return true
}

@ private { }
fn _identity_valid(artifact.ContentIdentity artifact, int length) → bool {
    return ((artifact.algorithm ≡ "sha-256" and _digest_ok(artifact.digest)) and artifact.length ≡ length) and length ≻ 0
}

@ private { }
fn _find_metadata(list<GgufMetadata> xs, string key) → GgufMetadata ∪ null {
    for from xs const x {
        if x.key ≡ key then return x
    }
    return null
}

@ private { }
fn _value_u16(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    const list<int<u8>> x ← _slice(b, off, 2)
    return (x.get(0) coalesce 0 ∷ int<u8> ↦ int) ∨ (x.get(1) coalesce 0 ∷ int<u8> ↦ int) ⇐ 8
}

@ private { }
fn _value_i32(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    const int raw ← _u32(b, off)
    if raw ≺ 2147483648 then return raw
    return raw - 4294967296
}

@ private { }
fn _value_i64(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    const list<int<u8>> x ← _slice(b, off, 8)
    const int high ← x.get(7) coalesce 0 ∷ int<u8> ↦ int
    const int r0 ← x.get(0) coalesce 0 ∷ int<u8> ↦ int
    const int r1 ← x.get(1) coalesce 0 ∷ int<u8> ↦ int
    const int r2 ← x.get(2) coalesce 0 ∷ int<u8> ↦ int
    const int r3 ← x.get(3) coalesce 0 ∷ int<u8> ↦ int
    const int r4 ← x.get(4) coalesce 0 ∷ int<u8> ↦ int
    const int r5 ← x.get(5) coalesce 0 ∷ int<u8> ↦ int
    const int r6 ← x.get(6) coalesce 0 ∷ int<u8> ↦ int
    const int lower ← ((((((r0 ∨ r1 ⇐ 8) ∨ r2 ⇐ 16) ∨ r3 ⇐ 24) ∨ r4 ⇐ 32) ∨ r5 ⇐ 40) ∨ r6 ⇐ 48) ∨ high % 128 ⇐ 56
    if high ≺ 128 then return lower
    return ((0 - MAX_NUMBER) - 1) + lower
}

@ private { }
fn _value_u32(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    return _u32(b, off)
}

@ private { }
fn _value_u64(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    return _u64(b, off)
}

@ private { }
fn _scalar_count(list<int<u8>> b, int off, int kind) → int ⇥ GgufManifestError {
    # BOOL remains valid and preserved in payload_wire, but is not an integer
    # accessor value; callers receive BadWire instead.
    if kind ≡ GGUF_UINT8 then return _u8_value(b, off)
    if kind ≡ GGUF_INT8 {
        const int raw ← _u8_value(b, off)
        if raw ≺ 128 then return raw
        return raw - 256
    }
    if kind ≡ GGUF_UINT16 then return _value_u16(b, off)
    if kind ≡ GGUF_INT16 {
        const int raw ← _value_u16(b, off)
        if raw ≺ 32768 then return raw
        return raw - 65536
    }
    if kind ≡ GGUF_UINT32 then return _value_u32(b, off)
    if kind ≡ GGUF_INT32 then return _value_i32(b, off)
    if kind ≡ GGUF_UINT64 then return _value_u64(b, off)
    if kind ≡ GGUF_INT64 then return _value_i64(b, off)
    throw variant BadWire {message = "metadata value is not an unsigned integer"}
}

@ private { }
fn _wire_count(GgufMetadata m) → int ⇥ GgufManifestError {
    const list<int<u8>> b ← _byte_list(m.payload_wire)
    return _scalar_count(b, 0, m.dtype)
}

@ private { }
fn _text_value(GgufMetadata m) → string ⇥ GgufManifestError {
    require m.dtype ≡ GGUF_STRING throw variant BadWire {message = "metadata value is not a GGUF string"}
    const list<int<u8>> b ← _byte_list(m.payload_wire)
    return _string(b, 0)
}

# -------------------------------------------------------------------------
# GGML layout resolution.
# -------------------------------------------------------------------------

@ private { }
fn _block_layout(int kind) → int {
    if ((((((kind ≡ GGML_F32 or kind ≡ GGML_F16) or kind ≡ GGML_I8) or kind ≡ GGML_I16) or kind ≡ GGML_I32) or kind ≡ GGML_I64) or kind ≡ GGML_F64) or kind ≡ GGML_BF16 then return 1
    if (((((kind ≡ GGML_Q4_0 or kind ≡ GGML_Q4_1) or kind ≡ GGML_Q5_0) or kind ≡ GGML_Q5_1) or kind ≡ GGML_Q8_0) or kind ≡ GGML_Q8_1) or kind ≡ GGML_IQ4_NL then return 32
    if ((((kind ≡ GGML_Q2_K or kind ≡ GGML_Q3_K) or kind ≡ GGML_Q4_K) or kind ≡ GGML_Q5_K) or kind ≡ GGML_Q6_K) or kind ≡ GGML_Q8_K then return 256
    return 0
}

@ private { }
fn _byte_layout(int kind) → int {
    if kind ≡ GGML_F32 or kind ≡ GGML_I32 then return 4
    if (kind ≡ GGML_F16 or kind ≡ GGML_I16) or kind ≡ GGML_BF16 then return 2
    if kind ≡ GGML_I8 then return 1
    if kind ≡ GGML_I64 or kind ≡ GGML_F64 then return 8
    if kind ≡ GGML_Q4_0 then return 18
    if kind ≡ GGML_Q4_1 then return 20
    if kind ≡ GGML_Q5_0 then return 22
    if kind ≡ GGML_Q5_1 then return 24
    if kind ≡ GGML_Q8_0 then return 34
    if kind ≡ GGML_Q8_1 then return 36
    if kind ≡ GGML_Q2_K then return 84
    if kind ≡ GGML_Q3_K then return 110
    if kind ≡ GGML_Q4_K then return 144
    if kind ≡ GGML_Q5_K then return 176
    if kind ≡ GGML_Q6_K then return 210
    if kind ≡ GGML_Q8_K then return 292
    if kind ≡ GGML_IQ4_NL then return 18
    return 0
}

@ private { }
fn _elements(list<int> shape) → int ⇥ GgufManifestError {
    var int total ← 1
    for from shape const dim {
        require not (dim ≤ 0 or dim ≻ DIMENSION_LIMIT) throw variant BadBounds {message = "tensor dimension is outside the bounded range"}
        require total ≤ ELEMENT_LIMIT / dim throw variant BadBounds {message = "tensor element count exceeds the bounded range"}
        total ← total * dim
    }
    return total
}

@ public { }
fn layout(int ggml_dtype, list<int> shape) → GgmlLayout ⇥ GgufManifestError {
    require shape.length() ≠ 0 throw variant BadBounds {message = "tensor rank must be at least one"}
    const int elements ← _elements(shape)
    const int elements_per_block ← _block_layout(ggml_dtype)
    if elements_per_block ≡ 0 then return variant Unknown {dtype = ggml_dtype}
    const int bytes_per_block ← _byte_layout(ggml_dtype)
    const int first_dimension ← shape.get(0) coalesce 0
    require first_dimension % elements_per_block ≡ 0 throw variant BadOffset {message = "tensor first dimension is not a complete GGML block"}
    const int blocks ← elements / elements_per_block
    const int length ← _mul(blocks, bytes_per_block)
    return variant Known {elements_per_block = elements_per_block, bytes_per_block = bytes_per_block, byte_length = length}
}

# -------------------------------------------------------------------------
# Public accessors.
# -------------------------------------------------------------------------

@ public { }
fn metadata(GgufManifest m, string key) → GgufMetadata ⇥ GgufManifestError {
    const GgufMetadata ∪ null found ← _find_metadata(m.metadata, key)
    if found not is null then return found coalesce GgufMetadata {key = "", dtype = -1, payload_wire = ||}
    throw variant NotFound {message = "metadata key not found: §"(key)}
}

@ public { }
fn text(GgufManifest m, string key) → string ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, key)
    return _text_value(x)
}

@ public { }
fn number(GgufManifest m, string key) → int ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, key)
    return _wire_count(x)
}

# Typed array accessors for the tokenizer metadata block (LIB-02-U1). Arrays
# are validated against their declared element kind; missing keys produce
# NotFound and malformed element kinds produce typed BadWire/BadBounds rows.
# Scalar tokenizer ids/template stay on the existing `number`/`text` surface.
@ public { }
fn texts(GgufManifest m, string key) → list<string> ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, key)
    require x.dtype ≡ GGUF_ARRAY throw variant BadWire {message = "metadata value is not a GGUF string array"}
    const list<int<u8>> b ← _byte_list(x.payload_wire)
    const int element_kind ← _u32(b, 0)
    require element_kind ≡ GGUF_STRING throw variant BadWire {message = "metadata array is not a string array"}
    const int n ← _u64(b, 4)
    require n ≤ ARRAY_LIMIT throw variant BadBounds {message = "GGUF array count exceeds the bounded limit"}
    var list<string> out ← empty
    var int cursor ← 12
    for range 0‥n const i {
        const int len ← _u64(b, cursor)
        require len ≤ TEXT_LIMIT throw variant BadBounds {message = "GGUF string exceeds the bounded text limit"}
        out.append(_text(b, _add(cursor, 8), len))
        cursor ← _add(cursor, _add(8, len))
    }
    return out
}

@ public { }
fn numbers(GgufManifest m, string key) → list<int> ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, key)
    require x.dtype ≡ GGUF_ARRAY throw variant BadWire {message = "metadata value is not a GGUF integer array"}
    const list<int<u8>> b ← _byte_list(x.payload_wire)
    const int element_kind ← _u32(b, 0)
    require ((((((element_kind ≡ GGUF_UINT8 or element_kind ≡ GGUF_INT8) or element_kind ≡ GGUF_UINT16) or element_kind ≡ GGUF_INT16) or element_kind ≡ GGUF_UINT32) or element_kind ≡ GGUF_INT32) or element_kind ≡ GGUF_UINT64) or element_kind ≡ GGUF_INT64 throw variant BadWire {message = "metadata array is not an integer array"}
    const int n ← _u64(b, 4)
    require n ≤ ARRAY_LIMIT throw variant BadBounds {message = "GGUF array count exceeds the bounded limit"}
    const int scalar ← _scalar_size(element_kind)
    var list<int> out ← empty
    var int cursor ← 12
    for range 0‥n const i {
        out.append(_scalar_count(b, cursor, element_kind))
        cursor ← _add(cursor, scalar)
    }
    return out
}

# Typed array-of-uint32 accessor (MODEL-01-M1). The wire element kind must be
# exactly GGUF_UINT32; another integer element kind fails closed instead of
# coercing. Missing keys produce NotFound; non-array values produce typed
# BadWire rows.
@ public { }
fn numbers_u32(GgufManifest m, string key) → list<int> ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, key)
    require x.dtype ≡ GGUF_ARRAY throw variant BadWire {message = "metadata value is not a GGUF u32 array"}
    const list<int<u8>> b ← _byte_list(x.payload_wire)
    const int element_kind ← _u32(b, 0)
    require element_kind ≡ GGUF_UINT32 throw variant BadWire {message = "metadata array is not a u32 array"}
    const int n ← _u64(b, 4)
    require n ≤ ARRAY_LIMIT throw variant BadBounds {message = "GGUF array count exceeds the bounded limit"}
    var list<int> out ← empty
    var int cursor ← 12
    for range 0‥n const i {
        out.append(_value_u32(b, cursor))
        cursor ← _add(cursor, 4)
    }
    return out
}

# Typed bool accessor (MODEL-01-M1). The wire kind must be exactly GGUF_BOOL;
# a present non-bool value fails closed instead of coercing. The parser has
# already validated the wire byte is 0 or 1.
@ public { }
fn boolean(GgufManifest m, string key) → bool ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, key)
    require x.dtype ≡ GGUF_BOOL throw variant BadWire {message = "metadata value is not a GGUF bool"}
    const list<int<u8>> b ← _byte_list(x.payload_wire)
    return _u8_value(b, 0) ≡ 1
}

# Typed array-length accessor (MODEL-01-M1). Reads only the array count from
# the wire header without decoding elements; wrong-kind values fail closed.
@ public { }
fn list_length(GgufManifest m, string key) → int ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, key)
    require x.dtype ≡ GGUF_ARRAY throw variant BadWire {message = "metadata value is not a GGUF array"}
    const list<int<u8>> b ← _byte_list(x.payload_wire)
    const int n ← _u64(b, 4)
    require n ≤ ARRAY_LIMIT throw variant BadBounds {message = "GGUF array count exceeds the bounded limit"}
    return n
}

@ public { }
fn find_tensor(GgufManifest m, string name) → GgufTensorDescriptor ⇥ GgufManifestError {
    for from m.tensors const t {
        if t.name ≡ name then return t
    }
    throw variant NotFound {message = "tensor not found: §"(name)}
}

# Exact stored byte range of one known-layout tensor: (absolute_start,
# payload_length) relative to the content identity. Reuses the
# already-validated range/overlap facts from parse/inspect; Unknown layout
# fails closed.
@ public { }
fn payload_limit(GgufManifest m, string name) → tuple<int, int> ⇥ GgufManifestError {
    const GgufTensorDescriptor tensor ← find_tensor(m, name)
    match tensor.layout {
        case Known const elements_per_block, bytes_per_block, byte_length {
            const int absolute ← _add(m.data_start, tensor.relative_offset)
            return tuple<int, int> [absolute, byte_length]
        }
        case Unknown const kind {
            throw variant UnknownLayout {message = "tensor layout is unknown; payload range is unavailable"}
        }
    }
}

# -------------------------------------------------------------------------
# Manifest parser.
# -------------------------------------------------------------------------

@ private { }
fn _align(int value, int alignment) → int ⇥ GgufManifestError {
    const int remainder ← value % alignment
    if remainder ≡ 0 then return value
    return _add(value, alignment - remainder)
}

@ private { }
fn _power_two(int value) → bool {
    if value ≤ 0 then return false
    var int x ← value
    while x % 2 ≡ 0 {
        x ← x / 2
    }
    return x ≡ 1
}

@ private { }
fn _construct(artifact.ContentIdentity identity, int total, int version, int alignment, int table_end, int corpus_length, list<GgufMetadata> metadata, list<GgufTensorDescriptor> tensors) → GgufManifest ⇥ GgufManifestError {
    const int data_start ← _align(table_end, alignment)
    require data_start ≤ total throw variant BadOffset {message = "GGUF data section begins beyond the artifact"}
    require corpus_length ≤ data_start throw variant Surplus {message = "bounded GGUF corpus contains bytes from the data region"}
    var list<int> abs_starts ← empty
    var list<int> abs_ends ← empty
    for from tensors const tensor {
        const int raw_start ← _add(data_start, tensor.relative_offset)
        require raw_start ≤ total throw variant BadOffset {message = "GGML tensor offset exceeds the artifact"}
        match tensor.layout {
            case Known const elements_per_block, bytes_per_block, byte_length {
                const int finish ← _add(raw_start, byte_length)
                require finish ≤ total throw variant BadOffset {message = "known GGML tensor range exceeds the artifact"}
                abs_starts.append(raw_start)
                abs_ends.append(finish)
            }
            case Unknown const kind {
            }
        }
    }
    var int a ← 0
    while a ≺ abs_starts.length() {
        var int z ← a + 1
        while z ≺ abs_starts.length() {
            const int ai ← abs_starts.get(a) coalesce 0
            const int bi ← abs_ends.get(a) coalesce 0
            const int aj ← abs_starts.get(z) coalesce 0
            const int bj ← abs_ends.get(z) coalesce 0
            require not (bi ≻ aj and bj ≻ ai) throw variant BadOffset {message = "known GGML tensor ranges overlap"}
            z ↑
        }
        a ↑
    }
    return GgufManifest {identity = identity, version = version, alignment = alignment, data_start = data_start, artifact_length = total, metadata = metadata, tensors = tensors}
}

@ public { }
fn parse(GgufCorpus corpus) → GgufManifest ⇥ GgufManifestError {
    # Check the caller-owned prefix before copying it into the parser's list
    # representation; otherwise an oversized octet corpus would already have
    # amplified memory before the bounded parser could reject it.
    require corpus.table.length() ≤ CORPUS_LIMIT throw variant BadBounds {message = "bounded GGUF corpus exceeds the 64 MiB parser limit"}
    const list<int<u8>> b ← _byte_list(corpus.table)
    const int total ← corpus.artifact_length
    require not ((total ≤ 0 or corpus.identity.length ≠ total) or not _identity_valid(corpus.identity, total)) throw variant BadIdentity {message = "content identity does not match the supplied artifact length"}
    require b.length() ≥ 24 throw variant Truncated {message = "truncated GGUF header"}
    const int m0 ← _u8_value(b, 0)
    const int m1 ← _u8_value(b, 1)
    const int m2 ← _u8_value(b, 2)
    const int m3 ← _u8_value(b, 3)
    require not (((m0 ≠ MAGIC_0 or m1 ≠ MAGIC_1) or m2 ≠ MAGIC_2) or m3 ≠ MAGIC_3) throw variant BadFormat {message = "not a GGUF file — bad magic"}
    const int version ← _u32(b, 4)
    require version ≡ GGUF_VERSION throw variant UnknownVersion {message = "unsupported GGUF version: §"(version ↦ string)}
    const int tensor_count ← _u64(b, 8)
    const int kv_num ← _u64(b, 16)
    require not (tensor_count ≻ TENSOR_LIMIT or kv_num ≻ KV_LIMIT) throw variant BadBounds {message = "GGUF count exceeds the bounded limit"}
    var int cursor ← 24
    var list<GgufMetadata> metadata ← empty
    var list<string> keys ← empty
    for range 0‥kv_num const i {
        const int key_len ← _u64(b, cursor)
        require key_len ≤ NAME_LIMIT throw variant BadBounds {message = "metadata key exceeds the bounded length"}
        const string key ← _text(b, cursor + 8, key_len)
        require not _contains(keys, key) throw variant DuplicateKey {message = "duplicate GGUF metadata key: §"(key)}
        keys.append(key)
        cursor ← _add(cursor, 8 + key_len)
        const int kind ← _u32(b, cursor)
        require _dtype_valid(kind) throw variant BadWire {message = "unknown GGUF metadata value type"}
        cursor ← _add(cursor, 4)
        const int value_start ← cursor
        const int value_len ← _size_value(b, value_start, kind, 0)
        const list<int<u8>> value_bytes ← _slice(b, value_start, value_len)
        metadata.append(GgufMetadata {key = key, dtype = kind, payload_wire = _byte_from_list(value_bytes)})
        cursor ← _add(cursor, value_len)
    }
    var int alignment ← DEFAULT_ALIGNMENT
    const GgufMetadata ∪ null alignment_meta ← _find_metadata(metadata, "general.alignment")
    if alignment_meta not is null {
        require (alignment_meta coalesce GgufMetadata {key = "", dtype = -1, payload_wire = ||}).dtype ≡ GGUF_UINT32 throw variant BadWire {message = "general.alignment must use GGUF UINT32 wire kind"}
        const int file_alignment ← _wire_count(alignment_meta coalesce GgufMetadata {key = "", dtype = -1, payload_wire = ||})
        require not ((file_alignment ≤ 0 or file_alignment ≻ 4294967295) or not _power_two(file_alignment)) throw variant BadWire {message = "general.alignment must be a positive power of two"}
        alignment ← file_alignment
    }
    var list<GgufTensorDescriptor> tensors ← empty
    var list<string> names ← empty
    var int t ← 0
    while t ≺ tensor_count {
        const int name_len ← _u64(b, cursor)
        require name_len ≤ NAME_LIMIT throw variant BadBounds {message = "tensor name exceeds the bounded length"}
        const string name ← _text(b, cursor + 8, name_len)
        require name.length() ≠ 0 throw variant BadWire {message = "empty tensor name"}
        require not _contains(names, name) throw variant DuplicateTensor {message = "duplicate GGUF tensor name: §"(name)}
        names.append(name)
        cursor ← _add(cursor, 8 + name_len)
        const int rank ← _u32(b, cursor)
        cursor ← _add(cursor, 4)
        require rank ≠ 0 throw variant BadBounds {message = "tensor rank must be at least one"}
        require rank ≤ RANK_LIMIT throw variant BadBounds {message = "tensor rank exceeds the bounded limit"}
        var list<int> shape ← empty
        var int d ← 0
        while d ≺ rank {
            const int dim ← _u64(b, cursor)
            require not (dim ≤ 0 or dim ≻ DIMENSION_LIMIT) throw variant BadBounds {message = "tensor dimension is outside the bounded range"}
            shape.append(dim)
            cursor ← _add(cursor, 8)
            d ↑
        }
        const int ggml_dtype ← _u32(b, cursor)
        cursor ← _add(cursor, 4)
        const int offset ← _u64(b, cursor)
        cursor ← _add(cursor, 8)
        const int elements ← _elements(shape)
        const GgmlLayout lay ← layout(ggml_dtype, shape)
        tensors.append(GgufTensorDescriptor {name = name, shape = shape, dtype_ggml = ggml_dtype, relative_offset = offset, elements = elements, layout = lay})
        t ↑
    }
    return _construct(corpus.identity, total, version, alignment, cursor, b.length(), metadata, tensors)
}

# Incrementally inspect a real GGUF header and directory. Every source request
# is an exact range established by the wire cursor; inspection stops at the end
# of the tensor table and never asks for a tensor payload byte.
@ public { }
fn inspect((int, int) → bytes ⇥ GgufManifestError source, int artifact_length, artifact.ContentIdentity identity) → GgufManifest ⇥ GgufManifestError {
    require not (artifact_length ≤ 0 or not _identity_valid(identity, artifact_length)) throw variant BadIdentity {message = "content identity does not match the supplied artifact length"}
    const bytes header_wire ← _read_source(source, artifact_length, 0, 24)
    const list<int<u8>> header ← _byte_list(header_wire)
    require not (((_u8_value(header, 0) ≠ MAGIC_0 or _u8_value(header, 1) ≠ MAGIC_1) or _u8_value(header, 2) ≠ MAGIC_2) or _u8_value(header, 3) ≠ MAGIC_3) throw variant BadFormat {message = "not a GGUF file — bad magic"}
    const int version ← _u32(header, 4)
    require version ≡ GGUF_VERSION throw variant UnknownVersion {message = "unsupported GGUF version: §"(version ↦ string)}
    const int tensor_count ← _u64(header, 8)
    const int kv_num ← _u64(header, 16)
    require not (tensor_count ≻ TENSOR_LIMIT or kv_num ≻ KV_LIMIT) throw variant BadBounds {message = "GGUF count exceeds the bounded limit"}
    var int cursor ← 24
    var list<GgufMetadata> metadata ← empty
    var list<string> keys ← empty
    for range 0‥kv_num const i {
        const bytes key_head_wire ← _read_source(source, artifact_length, cursor, 8)
        const int key_len ← _u64(_byte_list(key_head_wire), 0)
        require key_len ≤ NAME_LIMIT throw variant BadBounds {message = "metadata key exceeds the bounded length"}
        cursor ← _add(cursor, 8)
        const bytes key_body_wire ← _read_source(source, artifact_length, cursor, key_len)
        const string key ← _text(_byte_list(key_body_wire), 0, key_len)
        require not _contains(keys, key) throw variant DuplicateKey {message = "duplicate GGUF metadata key: §"(key)}
        keys.append(key)
        cursor ← _add(cursor, key_len)
        const bytes type_wire ← _read_source(source, artifact_length, cursor, 4)
        const int kind ← _u32(_byte_list(type_wire), 0)
        require _dtype_valid(kind) throw variant BadWire {message = "unknown GGUF metadata value type"}
        cursor ← _add(cursor, 4)
        const bytes value_wire ← _source_value(source, artifact_length, cursor, kind, 0)
        metadata.append(GgufMetadata {key = key, dtype = kind, payload_wire = value_wire})
        cursor ← _add(cursor, value_wire.length())
    }
    var int alignment ← DEFAULT_ALIGNMENT
    const GgufMetadata ∪ null alignment_meta ← _find_metadata(metadata, "general.alignment")
    if alignment_meta not is null {
        const GgufMetadata alignment_value ← alignment_meta coalesce GgufMetadata {key = "", dtype = -1, payload_wire = ||}
        require alignment_value.dtype ≡ GGUF_UINT32 throw variant BadWire {message = "general.alignment must use GGUF UINT32 wire kind"}
        const int file_alignment ← _wire_count(alignment_value)
        require not ((file_alignment ≤ 0 or file_alignment ≻ 4294967295) or not _power_two(file_alignment)) throw variant BadWire {message = "general.alignment must be a positive power of two"}
        alignment ← file_alignment
    }
    var list<GgufTensorDescriptor> tensors ← empty
    var list<string> names ← empty
    var int t ← 0
    while t ≺ tensor_count {
        const bytes name_head_wire ← _read_source(source, artifact_length, cursor, 8)
        const int name_len ← _u64(_byte_list(name_head_wire), 0)
        require name_len ≤ NAME_LIMIT throw variant BadBounds {message = "tensor name exceeds the bounded length"}
        cursor ← _add(cursor, 8)
        const bytes name_body_wire ← _read_source(source, artifact_length, cursor, name_len)
        const string name ← _text(_byte_list(name_body_wire), 0, name_len)
        require name.length() ≠ 0 throw variant BadWire {message = "empty tensor name"}
        require not _contains(names, name) throw variant DuplicateTensor {message = "duplicate GGUF tensor name: §"(name)}
        names.append(name)
        cursor ← _add(cursor, name_len)
        const bytes rank_wire ← _read_source(source, artifact_length, cursor, 4)
        const int rank ← _u32(_byte_list(rank_wire), 0)
        cursor ← _add(cursor, 4)
        require rank ≠ 0 throw variant BadBounds {message = "tensor rank must be at least one"}
        require rank ≤ RANK_LIMIT throw variant BadBounds {message = "tensor rank exceeds the bounded limit"}
        var list<int> shape ← empty
        var int d ← 0
        while d ≺ rank {
            const bytes dim_wire ← _read_source(source, artifact_length, cursor, 8)
            const int dim ← _u64(_byte_list(dim_wire), 0)
            require not (dim ≤ 0 or dim ≻ DIMENSION_LIMIT) throw variant BadBounds {message = "tensor dimension is outside the bounded range"}
            shape.append(dim)
            cursor ← _add(cursor, 8)
            d ↑
        }
        const bytes ggml_wire ← _read_source(source, artifact_length, cursor, 4)
        const int ggml_dtype ← _u32(_byte_list(ggml_wire), 0)
        cursor ← _add(cursor, 4)
        const bytes offset_wire ← _read_source(source, artifact_length, cursor, 8)
        const int offset ← _u64(_byte_list(offset_wire), 0)
        cursor ← _add(cursor, 8)
        const int elements ← _elements(shape)
        const GgmlLayout lay ← layout(ggml_dtype, shape)
        tensors.append(GgufTensorDescriptor {name = name, shape = shape, dtype_ggml = ggml_dtype, relative_offset = offset, elements = elements, layout = lay})
        t ↑
    }
    return _construct(identity, artifact_length, version, alignment, cursor, cursor, metadata, tensors)
}

# Read an exact, bounded fragment of one known-layout tensor. `start` and
# `length` are relative to the tensor's payload; the source receives only
# the checked absolute range and is not retained in the returned bytes.
@ public { }
fn read_fragment(GgufManifest m, string name, int start, int length, (int, int) → bytes ⇥ GgufManifestError source) → bytes ⇥ GgufManifestError {
    require not (start ≺ 0 or length ≺ 0) throw variant BadOffset {message = "tensor fragment range is negative"}
    const GgufTensorDescriptor tensor ← find_tensor(m, name)
    match tensor.layout {
        case Known const elements_per_block, bytes_per_block, byte_length {
            require not (start ≻ byte_length or length ≻ byte_length - start) throw variant BadOffset {message = "tensor fragment range exceeds the known tensor"}
            const int rel ← _add(tensor.relative_offset, start)
            const int absolute ← _add(m.data_start, rel)
            const int end ← _add(absolute, length)
            require not (absolute ≻ m.artifact_length or end ≻ m.artifact_length) throw variant BadOffset {message = "tensor fragment range exceeds the artifact"}
            return _read_source(source, m.artifact_length, absolute, length)
        }
        case Unknown const kind {
            throw variant UnknownLayout {message = "tensor layout is unknown; payload fragment is unavailable"}
        }
    }
}
