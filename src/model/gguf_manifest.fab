+++ toml
locale = "en"

+++ faber
# GGUF v3 format-general manifest parser and pathless range seam (GGUF-A1b).
#
# Public import: import from "gradus:model/gguf_manifest" gguf_manifest
# Depends on: gradus:model/artifact (pathless content identity),
# gradus:storage (open representation and block metadata).
#
# `parse` consumes a bounded header/metadata/tensor-table corpus. `inspect`
# obtains that same table incrementally from a caller-owned range function and
# never retains the function or source bytes. `read_fragment` obtains only a
# checked tensor subrange. Neither operation retains a path, URL, reader, file
# handle, mapping, device object, or payload. `payload_wire` is the exact encoded
# GGUF value payload, beginning at the value's first byte and ending after its
# own length-prefixed content. Each tensor descriptor also carries an open
# storage representation and separate block metadata. The legacy `layout`
# union remains a geometry projection for existing consumers; it is not the
# representation identity and unknown codes are preserved in full.

import from "gradus:model/artifact"

import from "gradus:storage"

# GGUF v3 wire value kinds (gguf.h enum gguf_type).
const int GGUF_UINT8 = 0

const int GGUF_INT8 = 1

const int GGUF_UINT16 = 2

const int GGUF_INT16 = 3

const int GGUF_UINT32 = 4

const int GGUF_INT32 = 5

const int GGUF_FLOAT32 = 6

const int GGUF_BOOL = 7

const int GGUF_STRING = 8

const int GGUF_ARRAY = 9

const int GGUF_UINT64 = 10

const int GGUF_INT64 = 11

const int GGUF_FLOAT64 = 12

# GGML storage ids and block geometry. The table covers the ordinary GGUF
# scalar, integer, BF16, and K-quant rows seen in current Hub artifacts. A
# valid but unlisted id stays inspectable as GgmlLayout.Unknown.
const int GGML_F32 = 0

const int GGML_F16 = 1

const int GGML_Q4_0 = 2

const int GGML_Q4_1 = 3

const int GGML_Q5_0 = 6

const int GGML_Q5_1 = 7

const int GGML_Q8_0 = 8

const int GGML_Q8_1 = 9

const int GGML_Q2_K = 10

const int GGML_Q3_K = 11

const int GGML_Q4_K = 12

const int GGML_Q5_K = 13

const int GGML_Q6_K = 14

const int GGML_Q8_K = 15

const int GGML_IQ4_NL = 20

const int GGML_I8 = 24

const int GGML_I16 = 25

const int GGML_I32 = 26

const int GGML_I64 = 27

const int GGML_F64 = 28

const int GGML_BF16 = 30

@ public
const int GGUF_VERSION = 3

const int DEFAULT_ALIGNMENT = 32

const int MAGIC_0 = 71

const int MAGIC_1 = 71

const int MAGIC_2 = 85

const int MAGIC_3 = 70

# Bounds protect the parser from count/length-driven allocation or loops.
# Duplicate-key/name and known-range validation are intentionally bounded
# quadratic scans in this A1 implementation. The 4,096-entry ceilings keep
# that work finite while admitting every inventoried local model (55 metadata
# entries and at most 753 tensors). The 64 MiB corpus ceiling bounds the
# retained header/table copy; the full model payload is never supplied here.
const int KV_LIMIT = 4096

const int TENSOR_LIMIT = 4096

const int CORPUS_LIMIT = 67108864

const int NAME_LIMIT = 4096

const int TEXT_LIMIT = 1048576

const int ARRAY_LIMIT = 1048576

const int RANK_LIMIT = 64

const int MAX_NUMBER = 9223372036854775807

@ public
union GgufManifestError {
    @ shared
    string message

    BadFormat,
    UnknownVersion,
    Truncated,
    BadWire,
    BadBounds,
    Surplus,
    DuplicateKey,
    DuplicateTensor,
    BadOffset,
    UnknownLayout,
    BadIdentity,
    BadSource,
    NotFound
}

@ public
class GgufCorpus {
    mut list<b8> table
    mut int artifact_length
    mut artifact.ContentIdentity identity
}

# A range source is (int, int) → list<b8> ⇥ GgufManifestError. Success
# returns the exact requested window; throw is the typed failure channel.

@ public
class GgufMetadata {
    mut string key
    mut int dtype
    mut list<b8> payload_wire
}

@ public
union GgmlLayout {
    Known {
        int elements_per_block
        int bytes_per_block
        int byte_length
    },
    Unknown {
        int dtype
    }
}

@ public
class GgufTensorDescriptor {
    mut string name
    mut list<int> shape
    mut int dtype_ggml
    mut storage.Representation representation
    mut int relative_offset
    mut int elements
    mut GgmlLayout layout
    mut storage.BlockMetadata block
}

@ public
class GgufManifest {
    mut artifact.ContentIdentity identity
    mut int version
    mut int alignment
    mut int data_start
    mut int artifact_length
    mut list<GgufMetadata> metadata
    mut list<GgufTensorDescriptor> tensors
}

# -------------------------------------------------------------------------
# Basic byte and checked-arithmetic helpers.
# -------------------------------------------------------------------------

fn byte_list(list<b8> o) → list<u8> {
    # One representation change, not a per-byte loop: the interpreter step
    # count of a whole-header parse depends on this staying O(1) statements.
    return o ↦ list<u8>
}

fn byte_from_list(list<u8> b) → list<b8> {
    return b ↦ list<b8>
}

fn add(int a, int b) → int ⇥ GgufManifestError {
    reject a ≺ 0 or b ≺ 0 or a ≻ MAX_NUMBER - b throw variant BadBounds { message = "checked offset addition overflow" }

    return a + b
}

fn mul(int a, int b) → int ⇥ GgufManifestError {
    reject a ≺ 0 or b ≺ 0 or b ≢ 0 and a ≻ MAX_NUMBER / b throw variant BadBounds { message = "checked length multiplication overflow" }

    return a * b
}

# Validate that `len` bytes at `off` lie inside `b`; returns the exclusive end.
# Copies nothing: callers that only need the bounds check (or read a few
# bytes) use this instead of `slice`.
fn check_range(list<u8> b, int off, int len) → int ⇥ GgufManifestError {
    reject off ≺ 0 or len ≺ 0 throw variant BadBounds { message = "negative byte range" }

    let int end ← add(off, len)

    require end ≤ b.length() throw variant Truncated { message = "bounded GGUF corpus ends before the required field" }

    return end
}

fn slice(list<u8> b, int off, int len) → list<u8> ⇥ GgufManifestError {
    let int end ← check_range(b, off, len)
    return b[off ‥ end]
}

# A source read is deliberately a function value, not a field of any public
# semantic value. The caller chooses the adapter and supplies it anew for
# each operation. The callback throws GgufManifestError (typically BadSource)
# so an application boundary can map an OS/provider diagnostic without
# importing that provider into Gradus.
fn read_source((int, int) → list<b8> ⇥ GgufManifestError source, int total, int start, int length) → list<b8> ⇥ GgufManifestError {
    reject total ≤ 0 or start ≺ 0 or length ≺ 0 throw variant BadSource { message = "range source received an invalid range" }

    require length ≤ CORPUS_LIMIT throw variant BadBounds { message = "range source request exceeds the 64 MiB read limit" }

    let int end ← add(start, length)

    require end ≤ total throw variant BadOffset { message = "range source request exceeds the artifact" }

    let list<b8> chunk ← source(start, length)

    require chunk.length() ≡ length throw variant BadSource { message = "range source returned an unexpected byte length" }

    return chunk
}

# Fixed-width little-endian reads. Each checks its range, then unpacks one
# exact byte window with the language's endian conversion.
fn u32(list<u8> b, int off) → int ⇥ GgufManifestError {
    let int end ← check_range(b, off, 4)
    let list<b8> window ← b[off ‥ end] ↦ list<b8>
    return (window ↦ u32 via Le) ↦ int ⊥ 0
}

fn u64(list<u8> b, int off) → int ⇥ GgufManifestError {
    let int end ← check_range(b, off, 8)
    let int r7 ← b.get(off + 7) coalesce 0 ∷ u8 ↦ int

    require r7 ≺ 128 throw variant BadBounds { message = "GGUF UINT64 value exceeds the numeric carrier" }

    let list<b8> window ← b[off ‥ end] ↦ list<b8>
    return (window ↦ u64 via Le) ↦ int ⊥ 0
}

# The same reads over an exact-length wire (`list<b8>` of 4 or 8 octets, as
# returned by `read_source`); no list is built.
fn u32_wire(list<b8> w) → int {
    return (w[0 ‥ 4] ↦ u32 via Le) ↦ int ⊥ 0
}

fn u64_wire(list<b8> w) → int ⇥ GgufManifestError {
    let int r7 ← (w[7] ↦ u8) ↦ int

    require r7 ≺ 128 throw variant BadBounds { message = "GGUF UINT64 value exceeds the numeric carrier" }

    return (w[0 ‥ 8] ↦ u64 via Le) ↦ int ⊥ 0
}

fn text_wire(list<b8> o) → string ⇥ GgufManifestError {
    do {
        return o ↦ string
    }
    catch err {
        throw variant BadWire { message = "GGUF string is not valid UTF-8" }
    }

    throw variant BadWire { message = "unreachable string conversion" }
}

fn text_at(list<u8> b, int off, int len) → string ⇥ GgufManifestError {
    let int end ← check_range(b, off, len)
    let list<b8> o ← b[off ‥ end] ↦ list<b8>
    return text_wire(o)
}

fn string_at(list<u8> b, int off) → string ⇥ GgufManifestError {
    let int len ← u64(b, off)

    require len ≤ TEXT_LIMIT throw variant BadBounds { message = "GGUF string exceeds the bounded text limit" }

    return text_at(b, off + 8, len)
}

fn u8_value(list<u8> b, int off) → int ⇥ GgufManifestError {
    check_range(b, off, 1)
    return b.get(off) coalesce 0 ∷ u8 ↦ int
}

fn scalar_size(int kind) → int {
    if kind ≡ GGUF_UINT8 or kind ≡ GGUF_INT8 or kind ≡ GGUF_BOOL then return 1

    if kind ≡ GGUF_UINT16 or kind ≡ GGUF_INT16 then return 2

    if kind ≡ GGUF_UINT32 or kind ≡ GGUF_INT32 or kind ≡ GGUF_FLOAT32 then return 4

    if kind ≡ GGUF_UINT64 or kind ≡ GGUF_INT64 or kind ≡ GGUF_FLOAT64 then return 8

    return 0
}

fn dtype_valid(int kind) → bool {
    return kind ≥ GGUF_UINT8 and kind ≤ GGUF_FLOAT64
}

# Read one metadata value from its absolute wire offset. The result contains
# exactly that value's wire bytes. Arrays recurse over their declared element
# type, but no cumulative header/table prefix is copied or retained.
fn source_value((int, int) → list<b8> ⇥ GgufManifestError source, int total, int off, int kind, int depth) → list<b8> ⇥ GgufManifestError {
    # --- bounds + kind (fail closed) --------------------------------------
    require depth ≤ 64 throw variant BadBounds { message = "metadata array nesting exceeds the bounded depth" }

    require dtype_valid(kind) throw variant BadWire { message = "unknown GGUF metadata value type" }

    let int scalar ← scalar_size(kind)

    if scalar ≻ 0 {
        # --- scalar wire (exact read) -------------------------------------
        let list<b8> wire ← read_source(source, total, off, scalar)
        size_value(byte_list(wire), 0, kind, depth)
        return wire
    }

    if kind ≡ GGUF_STRING {
        # --- string wire (length header + corpus) -------------------------
        let list<b8> header ← read_source(source, total, off, 8)
        let int len ← u64_wire(header)

        require len ≤ TEXT_LIMIT throw variant BadBounds { message = "GGUF string exceeds the bounded text limit" }

        # The language has no bulk `bytes` concatenation, so the whole value
        # (length header + body) is one exact read instead of two reads joined.
        let list<b8> wire ← read_source(source, total, off, add(8, len))
        text_wire(wire[8 ‥ add(8, len)])
        return wire
    }

    if kind ≡ GGUF_ARRAY {
        # --- array wire (element kind + count) ----------------------------
        let list<b8> header ← read_source(source, total, off, 12)
        let list<u8> header_list ← byte_list(header)
        let int element_kind ← u32(header_list, 0)

        require dtype_valid(element_kind) throw variant BadWire { message = "unknown GGUF array element type" }

        let int n ← u64(header_list, 4)

        require n ≤ ARRAY_LIMIT throw variant BadBounds { message = "GGUF array count exceeds the bounded limit" }

        let int element_scalar ← scalar_size(element_kind)

        if element_scalar ≻ 0 {
            # --- scalar element array (bulk read) -------------------------
            let int length ← mul(n, element_scalar)
            let list<b8> out ← read_source(source, total, off, add(12, length))
            size_value(byte_list(out), 0, kind, depth)
            return out
        }

        if element_kind ≡ GGUF_STRING {
            # --- string element array (scan → exact read) -----------------
            mut int cursor ← add(off, 12)

            for range 0 ‥ n let i {
                let list<b8> item_head ← read_source(source, total, cursor, 8)
                let int len ← u64_wire(item_head)

                require len ≤ TEXT_LIMIT throw variant BadBounds { message = "GGUF string exceeds the bounded text limit" }

                cursor ← add(cursor, add(8, len))
            }

            let int total_wire ← cursor - off
            # One exact source read preserves the full tokenizer array without
            # copying each growing element through Faber. The bounded scanner
            # above establishes its exact end before this read is issued.
            let list<b8> wire ← read_source(source, total, off, total_wire)
            size_value(byte_list(wire), 0, kind, depth)
            return wire
        }

        # --- nested element array (recursive reads) -----------------------
        mut list<b8> out ← copy header
        mut int cursor ← add(off, 12)

        for range 0 ‥ n let i {
            let list<b8> item ← source_value(source, total, cursor, element_kind, depth + 1)

            # Append in place. Passing the growing accumulator through the
            # helper would copy it once per element and turn large tokenizer
            # string arrays quadratic. Nested arrays are not a real GGUF
            # shape, and the language has no bulk `bytes` concatenation.
            for from item let x {
                out.append(x)
            }

            cursor ← add(cursor, item.length())
        }

        return out
    }

    throw variant BadWire { message = "unknown GGUF metadata value type" }
}

# Size of a validated string array (length-prefixed UTF-8 elements): the
# per-element u64 length, text-limit, range and UTF-8 checks of `size_value`
# for a string, inlined into one loop. Returns the array's total wire size.
fn string_array_size(list<u8> b, int off, int n) → int ⇥ GgufManifestError {
    let int blen ← b.length()
    mut int pos ← off + 12

    for range 0 ‥ n let i {
        require pos + 8 ≤ blen throw variant Truncated { message = "bounded GGUF corpus ends before the required field" }

        let int r7 ← b.get(pos + 7) coalesce 0 ∷ u8 ↦ int

        require r7 ≺ 128 throw variant BadBounds { message = "GGUF UINT64 value exceeds the numeric carrier" }

        let list<b8> head ← b[pos ‥ pos + 8] ↦ list<b8>
        let int len ← (head ↦ u64 via Le) ↦ int ⊥ 0

        require len ≤ TEXT_LIMIT throw variant BadBounds { message = "GGUF string exceeds the bounded text limit" }

        let int next ← pos + 8 + len

        require next ≤ blen throw variant Truncated { message = "bounded GGUF corpus ends before the required field" }

        let list<b8> body ← b[pos + 8 ‥ next] ↦ list<b8>
        text_wire(body)
        pos ← next
    }

    return pos - off
}

# Returns the exact payload size for one typed GGUF value. For an array, the
# returned size includes its element-type and count headers and every nested
# element. No value bytes are retained here; the caller slices them once.
fn size_value(list<u8> b, int off, int kind, int depth) → int ⇥ GgufManifestError {
    # --- bounds + kind (fail closed) --------------------------------------
    require depth ≤ 64 throw variant BadBounds { message = "metadata array nesting exceeds the bounded depth" }

    let int scalar ← scalar_size(kind)

    if scalar ≻ 0 {
        # --- scalar wire (BOOL validated) ---------------------------------
        if kind ≡ GGUF_BOOL {
            let int v ← u8_value(b, off)

            reject v ≢ 0 and v ≢ 1 throw variant BadWire { message = "malformed GGUF bool value" }
        }

        check_range(b, off, scalar)
        return scalar
    }

    if kind ≡ GGUF_STRING {
        # --- string wire (length + UTF-8 check) ---------------------------
        let int len ← u64(b, off)

        require len ≤ TEXT_LIMIT throw variant BadBounds { message = "GGUF string exceeds the bounded text limit" }

        let int total ← add(8, len)
        check_range(b, off, total)
        text_at(b, off + 8, len)
        return total
    }

    if kind ≡ GGUF_ARRAY {
        # --- array wire (element size recursion) --------------------------
        let int header ← add(off, 12)

        require header ≤ b.length() throw variant Truncated { message = "truncated GGUF array header" }

        let int element_kind ← u32(b, off)

        require dtype_valid(element_kind) throw variant BadWire { message = "unknown GGUF array element type" }

        let int n ← u64(b, off + 4)

        require n ≤ ARRAY_LIMIT throw variant BadBounds { message = "GGUF array count exceeds the bounded limit" }

        mut int total ← 12
        let int element_scalar ← scalar_size(element_kind)

        if n ≻ 0 and (element_kind ≡ GGUF_STRING or element_scalar ≻ 0 and element_kind ≢ GGUF_BOOL) {
            # Flat arrays: the same checks as the per-element recursion below,
            # in the same order, without one call per element. The element
            # depth check applies only when there is a first element.
            require depth + 1 ≤ 64 throw variant BadBounds { message = "metadata array nesting exceeds the bounded depth" }

            if element_kind ≡ GGUF_STRING then return string_array_size(b, off, n)

            let int body ← n * element_scalar
            check_range(b, off + 12, body)
            total ← add(12, body)
            check_range(b, off, total)
            return total
        }

        for range 0 ‥ n let i {
            let int part ← size_value(b, off + total, element_kind, depth + 1)
            total ← add(total, part)
        }

        check_range(b, off, total)
        return total
    }

    throw variant BadWire { message = "unknown GGUF metadata value type" }
}

# -------------------------------------------------------------------------
# Metadata and identity helpers.
# -------------------------------------------------------------------------

fn digest_ok(string digest) → bool {
    if digest.length() ≢ 64 then return false

    for range 0 ‥ digest.length() let i {
        let string c ← digest.slice(i, i + 1)

        if not "0123456789abcdef".contains(c) then return false
    }

    return true
}

fn identity_valid(artifact.ContentIdentity artifact, int length) → bool {
    return artifact.algorithm ≡ "sha-256" and digest_ok(artifact.digest) and artifact.length ≡ length and length ≻ 0
}

fn find_metadata(list<GgufMetadata> xs, string key) → GgufMetadata ∪ none {
    for from xs let x {
        if x.key ≡ key then return x
    }

    return null
}

fn value_u16(list<u8> b, int off) → int ⇥ GgufManifestError {
    let int end ← check_range(b, off, 2)
    let list<b8> window ← b[off ‥ end] ↦ list<b8>
    return (window ↦ u16 via Le) ↦ int ⊥ 0
}

fn value_i32(list<u8> b, int off) → int ⇥ GgufManifestError {
    let int raw ← u32(b, off)

    if raw ≺ 2147483648 then return raw

    return raw - 4294967296
}

fn value_i64(list<u8> b, int off) → int ⇥ GgufManifestError {
    let int end ← check_range(b, off, 8)
    let list<b8> window ← b[off ‥ end] ↦ list<b8>
    return (window ↦ i64 via Le) ↦ int ⊥ 0
}

fn value_u32(list<u8> b, int off) → int ⇥ GgufManifestError {
    return u32(b, off)
}

fn value_u64(list<u8> b, int off) → int ⇥ GgufManifestError {
    return u64(b, off)
}

fn scalar_count(list<u8> b, int off, int kind) → int ⇥ GgufManifestError {
    # BOOL remains valid and preserved in payload_wire, but is not an integer
    # accessor value; callers receive BadWire instead.
    if kind ≡ GGUF_UINT8 then return u8_value(b, off)

    if kind ≡ GGUF_INT8 {
        let int raw ← u8_value(b, off)

        if raw ≺ 128 then return raw

        return raw - 256
    }

    if kind ≡ GGUF_UINT16 then return value_u16(b, off)

    if kind ≡ GGUF_INT16 {
        let int raw ← value_u16(b, off)

        if raw ≺ 32768 then return raw

        return raw - 65536
    }

    if kind ≡ GGUF_UINT32 then return value_u32(b, off)

    if kind ≡ GGUF_INT32 then return value_i32(b, off)

    if kind ≡ GGUF_UINT64 then return value_u64(b, off)

    if kind ≡ GGUF_INT64 then return value_i64(b, off)

    throw variant BadWire { message = "metadata value is not an unsigned integer" }
}

fn wire_count(GgufMetadata m) → int ⇥ GgufManifestError {
    let list<u8> b ← byte_list(m.payload_wire)
    return scalar_count(b, 0, m.dtype)
}

fn text_value(GgufMetadata m) → string ⇥ GgufManifestError {
    require m.dtype ≡ GGUF_STRING throw variant BadWire { message = "metadata value is not a GGUF string" }

    let list<u8> b ← byte_list(m.payload_wire)
    return string_at(b, 0)
}

# -------------------------------------------------------------------------
# GGML layout resolution.
# -------------------------------------------------------------------------

fn block_layout(int kind) → int {
    if kind ≡ GGML_F32 or kind ≡ GGML_F16 or kind ≡ GGML_I8 or kind ≡ GGML_I16 or kind ≡ GGML_I32 or kind ≡ GGML_I64 or kind ≡ GGML_F64 or kind ≡ GGML_BF16 then return 1

    if kind ≡ GGML_Q4_0 or kind ≡ GGML_Q4_1 or kind ≡ GGML_Q5_0 or kind ≡ GGML_Q5_1 or kind ≡ GGML_Q8_0 or kind ≡ GGML_Q8_1 or kind ≡ GGML_IQ4_NL then return 32

    if kind ≡ GGML_Q2_K or kind ≡ GGML_Q3_K or kind ≡ GGML_Q4_K or kind ≡ GGML_Q5_K or kind ≡ GGML_Q6_K or kind ≡ GGML_Q8_K then return 256

    return 0
}

fn byte_layout(int kind) → int {
    if kind ≡ GGML_F32 or kind ≡ GGML_I32 then return 4

    if kind ≡ GGML_F16 or kind ≡ GGML_I16 or kind ≡ GGML_BF16 then return 2

    if kind ≡ GGML_I8 then return 1

    if kind ≡ GGML_I64 or kind ≡ GGML_F64 then return 8

    if kind ≡ GGML_Q4_0 then return 18

    if kind ≡ GGML_Q4_1 then return 20

    if kind ≡ GGML_Q5_0 then return 22

    if kind ≡ GGML_Q5_1 then return 24

    if kind ≡ GGML_Q8_0 then return 34

    if kind ≡ GGML_Q8_1 then return 36

    if kind ≡ GGML_Q2_K then return 84

    if kind ≡ GGML_Q3_K then return 110

    if kind ≡ GGML_Q4_K then return 144

    if kind ≡ GGML_Q5_K then return 176

    if kind ≡ GGML_Q6_K then return 210

    if kind ≡ GGML_Q8_K then return 292

    if kind ≡ GGML_IQ4_NL then return 18

    return 0
}

fn element_count(list<int> shape) → int ⇥ GgufManifestError {
    mut int total ← 1

    for from shape let dim {
        reject dim ≤ 0 throw variant BadBounds { message = "tensor dimension must be positive" }

        require total ≤ MAX_NUMBER / dim throw variant BadBounds { message = "tensor element count exceeds the numeric range" }

        total ← total * dim
    }

    return total
}

@ public
fn layout(int ggml_dtype, list<int> shape) → GgmlLayout ⇥ GgufManifestError {
    # --- rank + element count (fail closed) -------------------------------
    require shape.length() ≢ 0 throw variant BadBounds { message = "tensor rank must be at least one" }

    let int elements ← element_count(shape)

    # --- block + byte layout resolution -----------------------------------
    let int elements_per_block ← block_layout(ggml_dtype)

    if elements_per_block ≡ 0 then return variant Unknown { dtype = ggml_dtype }

    let int bytes_per_block ← byte_layout(ggml_dtype)

    # --- first-dim alignment + byte length (fail closed) ------------------
    let int first_dimension ← shape.get(0) coalesce 0

    require first_dimension % elements_per_block ≡ 0 throw variant BadOffset { message = "tensor first dimension is not a complete GGML block" }

    let int blocks ← elements / elements_per_block
    let int length ← mul(blocks, bytes_per_block)
    return variant Known { elements_per_block = elements_per_block, bytes_per_block = bytes_per_block, byte_length = length }
}

# Open storage metadata accompanies the legacy geometry projection. Unknown
# layouts retain the source representation while making their geometry
# explicitly unavailable.
fn block_metadata(GgmlLayout value) → storage.BlockMetadata {
    match value {
        case Known let elements_per_block, bytes_per_block, byte_length {
            return storage.known_block(elements_per_block, bytes_per_block, byte_length / bytes_per_block, byte_length)
        }
        case Unknown let dtype {
            return storage.unknown_block(0)
        }
    }
}

# -------------------------------------------------------------------------
# Public accessors.
# -------------------------------------------------------------------------

@ public
fn metadata(GgufManifest m, string key) → GgufMetadata ⇥ GgufManifestError {
    let GgufMetadata ∪ none found ← find_metadata(m.metadata, key)

    if found not is none then return found coalesce GgufMetadata { key = "", dtype = -1, payload_wire = || }

    throw variant NotFound { message = "metadata key not found: §"(key) }
}

@ public
fn text(GgufManifest m, string key) → string ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)
    return text_value(x)
}

@ public
fn number(GgufManifest m, string key) → int ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)
    return wire_count(x)
}

# Typed array accessors for the tokenizer metadata block (LIB-02-U1). Arrays
# are validated against their declared element kind; missing keys produce
# NotFound and malformed element kinds produce typed BadWire/BadBounds rows.
# Scalar tokenizer ids/template stay on the existing `number`/`text` surface.
@ public
fn texts(GgufManifest m, string key) → list<string> ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)

    require x.dtype ≡ GGUF_ARRAY throw variant BadWire { message = "metadata value is not a GGUF string array" }

    let list<u8> b ← byte_list(x.payload_wire)
    let int element_kind ← u32(b, 0)

    require element_kind ≡ GGUF_STRING throw variant BadWire { message = "metadata array is not a string array" }

    let int n ← u64(b, 4)

    require n ≤ ARRAY_LIMIT throw variant BadBounds { message = "GGUF array count exceeds the bounded limit" }

    mut list<string> out ← empty
    mut int cursor ← 12
    let int blen ← b.length()

    for range 0 ‥ n let i {
        require cursor + 8 ≤ blen throw variant Truncated { message = "bounded GGUF corpus ends before the required field" }

        let int r7 ← b.get(cursor + 7) coalesce 0 ∷ u8 ↦ int

        require r7 ≺ 128 throw variant BadBounds { message = "GGUF UINT64 value exceeds the numeric carrier" }

        let list<b8> head ← b[cursor ‥ cursor + 8] ↦ list<b8>
        let int len ← (head ↦ u64 via Le) ↦ int ⊥ 0

        require len ≤ TEXT_LIMIT throw variant BadBounds { message = "GGUF string exceeds the bounded text limit" }

        let int next ← cursor + 8 + len

        require next ≤ blen throw variant Truncated { message = "bounded GGUF corpus ends before the required field" }

        let list<b8> body ← b[cursor + 8 ‥ next] ↦ list<b8>
        out.append(text_wire(body))
        cursor ← next
    }

    return out
}

# Read `n` consecutive little-endian u32 values starting after a 12-byte array
# header. One range check covers the whole run (the per-element check of the
# generic path fails with the same Truncated error on the same overrun).
fn u32_run(list<u8> b, int n) → list<int> ⇥ GgufManifestError {
    let int end ← check_range(b, 12, n * 4)
    mut list<int> out ← empty
    mut int cursor ← 12

    while cursor ≺ end {
        let list<b8> window ← b[cursor ‥ cursor + 4] ↦ list<b8>
        out.append((window ↦ u32 via Le) ↦ int ⊥ 0)
        cursor ← cursor + 4
    }

    return out
}

@ public
fn numbers(GgufManifest m, string key) → list<int> ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)

    require x.dtype ≡ GGUF_ARRAY throw variant BadWire { message = "metadata value is not a GGUF integer array" }

    let list<u8> b ← byte_list(x.payload_wire)
    let int element_kind ← u32(b, 0)

    require element_kind ≡ GGUF_UINT8 or element_kind ≡ GGUF_INT8 or element_kind ≡ GGUF_UINT16 or element_kind ≡ GGUF_INT16 or element_kind ≡ GGUF_UINT32 or element_kind ≡ GGUF_INT32 or element_kind ≡ GGUF_UINT64 or element_kind ≡ GGUF_INT64 throw variant BadWire { message = "metadata array is not an integer array" }

    let int n ← u64(b, 4)

    require n ≤ ARRAY_LIMIT throw variant BadBounds { message = "GGUF array count exceeds the bounded limit" }

    let int scalar ← scalar_size(element_kind)
    mut list<int> out ← empty
    mut int cursor ← 12

    if element_kind ≡ GGUF_UINT32 then return u32_run(b, n)

    for range 0 ‥ n let i {
        out.append(scalar_count(b, cursor, element_kind))
        cursor ← add(cursor, scalar)
    }

    return out
}

# Typed array-of-uint32 accessor (MODEL-01-M1). The wire element kind must be
# exactly GGUF_UINT32; another integer element kind fails closed instead of
# coercing. Missing keys produce NotFound; non-array values produce typed
# BadWire rows.
@ public
fn numbers_u32(GgufManifest m, string key) → list<int> ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)

    require x.dtype ≡ GGUF_ARRAY throw variant BadWire { message = "metadata value is not a GGUF u32 array" }

    let list<u8> b ← byte_list(x.payload_wire)
    let int element_kind ← u32(b, 0)

    require element_kind ≡ GGUF_UINT32 throw variant BadWire { message = "metadata array is not a u32 array" }

    let int n ← u64(b, 4)

    require n ≤ ARRAY_LIMIT throw variant BadBounds { message = "GGUF array count exceeds the bounded limit" }

    return u32_run(b, n)
}

# Typed bool accessor (MODEL-01-M1). The wire kind must be exactly GGUF_BOOL;
# a present non-bool value fails closed instead of coercing. The parser has
# already validated the wire byte is 0 or 1.
@ public
fn boolean(GgufManifest m, string key) → bool ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)

    require x.dtype ≡ GGUF_BOOL throw variant BadWire { message = "metadata value is not a GGUF bool" }

    let list<u8> b ← byte_list(x.payload_wire)
    return u8_value(b, 0) ≡ 1
}

# Typed array-length accessor (MODEL-01-M1). Reads only the array count from
# the wire header without decoding elements; wrong-kind values fail closed.
@ public
fn list_length(GgufManifest m, string key) → int ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)

    require x.dtype ≡ GGUF_ARRAY throw variant BadWire { message = "metadata value is not a GGUF array" }

    let list<u8> b ← byte_list(x.payload_wire)
    let int n ← u64(b, 4)

    require n ≤ ARRAY_LIMIT throw variant BadBounds { message = "GGUF array count exceeds the bounded limit" }

    return n
}

@ public
fn find_tensor(GgufManifest m, string name) → GgufTensorDescriptor ⇥ GgufManifestError {
    for from m.tensors let t {
        if t.name ≡ name then return t
    }

    throw variant NotFound { message = "tensor not found: §"(name) }
}

# Exact stored byte range of one known-layout tensor: (absolute_start,
# payload_length) relative to the content identity. Reuses the
# already-validated range/overlap facts from parse/inspect; Unknown layout
# fails closed.
@ public
fn payload_limit(GgufManifest m, string name) → tuple<int, int> ⇥ GgufManifestError {
    let GgufTensorDescriptor tensor ← find_tensor(m, name)

    match tensor.layout {
        case Known let elements_per_block, bytes_per_block, byte_length {
            let int absolute ← add(m.data_start, tensor.relative_offset)
            return tuple<int, int> [absolute, byte_length]
        }
        case Unknown let kind {
            throw variant UnknownLayout { message = "tensor layout is unknown; payload range is unavailable" }
        }
    }
}

# -------------------------------------------------------------------------
# Manifest parser.
# -------------------------------------------------------------------------

fn align(int value, int alignment) → int ⇥ GgufManifestError {
    let int remainder ← value % alignment

    if remainder ≡ 0 then return value

    return add(value, alignment - remainder)
}

fn power_two(int value) → bool {
    if value ≤ 0 then return false

    mut int x ← value

    while x % 2 ≡ 0 {
        x ← x / 2
    }

    return x ≡ 1
}

fn construct(artifact.ContentIdentity identity, int total, int version, int alignment, int table_end, int corpus_length, list<GgufMetadata> metadata, list<GgufTensorDescriptor> tensors) → GgufManifest ⇥ GgufManifestError {
    # --- data region start + corpus boundary (fail closed) ----------------
    let int data_start ← align(table_end, alignment)

    require data_start ≤ total throw variant BadOffset { message = "GGUF data section begins beyond the artifact" }

    require corpus_length ≤ data_start throw variant Surplus { message = "bounded GGUF corpus contains bytes from the data region" }

    # --- tensor absolute ranges (within the artifact) ---------------------
    mut list<int> abs_starts ← empty
    mut list<int> abs_ends ← empty

    for from tensors let tensor {
        let int raw_start ← add(data_start, tensor.relative_offset)

        require raw_start ≤ total throw variant BadOffset { message = "GGML tensor offset exceeds the artifact" }

        match tensor.layout {
            case Known let elements_per_block, bytes_per_block, byte_length {
                let int finish ← add(raw_start, byte_length)

                require finish ≤ total throw variant BadOffset { message = "known GGML tensor range exceeds the artifact" }

                abs_starts.append(raw_start)
                abs_ends.append(finish)
            }
            case Unknown let kind {
            }
        }
    }

    # --- range overlap scan (fail closed) ---------------------------------
    mut int a ← 0

    while a ≺ abs_starts.length() {
        mut int z ← a + 1

        while z ≺ abs_starts.length() {
            let int ai ← abs_starts.get(a) coalesce 0
            let int bi ← abs_ends.get(a) coalesce 0
            let int aj ← abs_starts.get(z) coalesce 0
            let int bj ← abs_ends.get(z) coalesce 0

            reject bi ≻ aj and bj ≻ ai throw variant BadOffset { message = "known GGML tensor ranges overlap" }

            z ↑
        }

        a ↑
    }

    # --- manifest construct -----------------------------------------------
    return GgufManifest { identity = identity, version = version, alignment = alignment, data_start = data_start, artifact_length = total, metadata = metadata, tensors = tensors }
}

@ public
fn parse(GgufCorpus corpus) → GgufManifest ⇥ GgufManifestError {
    # --- corpus + identity bounds (fail closed) ---------------------------
    # Check the caller-owned prefix before copying it into the parser's list
    # representation; otherwise an oversized octet corpus would already have
    # amplified memory before the bounded parser could reject it.
    require corpus.table.length() ≤ CORPUS_LIMIT throw variant BadBounds { message = "bounded GGUF corpus exceeds the 64 MiB parser limit" }

    let list<u8> b ← byte_list(corpus.table)
    let int total ← corpus.artifact_length

    reject total ≤ 0 or corpus.identity.length ≢ total or not identity_valid(corpus.identity, total) throw variant BadIdentity { message = "content identity does not match the supplied artifact length" }

    # --- header + format guard (magic/version/counts) ---------------------
    require b.length() ≥ 24 throw variant Truncated { message = "truncated GGUF header" }

    let int m0 ← u8_value(b, 0)
    let int m1 ← u8_value(b, 1)
    let int m2 ← u8_value(b, 2)
    let int m3 ← u8_value(b, 3)

    reject m0 ≢ MAGIC_0 or m1 ≢ MAGIC_1 or m2 ≢ MAGIC_2 or m3 ≢ MAGIC_3 throw variant BadFormat { message = "not a GGUF file — bad magic" }

    let int version ← u32(b, 4)

    require version ≡ GGUF_VERSION throw variant UnknownVersion { message = "unsupported GGUF version: §"(version ↦ string) }

    let int tensor_count ← u64(b, 8)
    let int kv_num ← u64(b, 16)

    reject tensor_count ≻ TENSOR_LIMIT or kv_num ≻ KV_LIMIT throw variant BadBounds { message = "GGUF count exceeds the bounded limit" }

    # --- metadata table (keys + wire values) ------------------------------
    mut int cursor ← 24
    mut list<GgufMetadata> metadata ← empty
    mut list<string> keys ← empty

    for range 0 ‥ kv_num let i {
        # --- key (length + duplicate check) -------------------------------
        let int key_len ← u64(b, cursor)

        require key_len ≤ NAME_LIMIT throw variant BadBounds { message = "metadata key exceeds the bounded length" }

        let string key ← text_at(b, cursor + 8, key_len)

        reject key ∈ keys throw variant DuplicateKey { message = "duplicate GGUF metadata key: §"(key) }

        keys.append(key)
        cursor ← add(cursor, 8 + key_len)

        # --- value kind (fail closed) -------------------------------------
        let int kind ← u32(b, cursor)

        require dtype_valid(kind) throw variant BadWire { message = "unknown GGUF metadata value type" }

        cursor ← add(cursor, 4)

        # --- value wire + record append -----------------------------------
        let int value_start ← cursor
        let int value_len ← size_value(b, value_start, kind, 0)
        let list<u8> value_bytes ← slice(b, value_start, value_len)
        metadata.append(GgufMetadata { key = key, dtype = kind, payload_wire = byte_from_list(value_bytes) })
        cursor ← add(cursor, value_len)
    }

    # --- alignment override (general.alignment) ---------------------------
    mut int alignment ← DEFAULT_ALIGNMENT
    let GgufMetadata ∪ none alignment_meta ← find_metadata(metadata, "general.alignment")

    if alignment_meta not is none {
        require (alignment_meta coalesce GgufMetadata { key = "", dtype = -1, payload_wire = || }).dtype ≡ GGUF_UINT32 throw variant BadWire { message = "general.alignment must use GGUF UINT32 wire kind" }

        let int file_alignment ← wire_count(alignment_meta coalesce GgufMetadata { key = "", dtype = -1, payload_wire = || })

        reject file_alignment ≤ 0 or file_alignment ≻ 4294967295 or not power_two(file_alignment) throw variant BadWire { message = "general.alignment must be a positive power of two" }

        alignment ← file_alignment
    }

    # --- tensor table (names + shapes + layouts) --------------------------
    mut list<GgufTensorDescriptor> tensors ← empty
    mut list<string> names ← empty
    mut int t ← 0

    while t ≺ tensor_count {
        # --- name (length + duplicate check) ------------------------------
        let int name_len ← u64(b, cursor)

        require name_len ≤ NAME_LIMIT throw variant BadBounds { message = "tensor name exceeds the bounded length" }

        let string name ← text_at(b, cursor + 8, name_len)

        require name.length() ≢ 0 throw variant BadWire { message = "empty tensor name" }

        reject name ∈ names throw variant DuplicateTensor { message = "duplicate GGUF tensor name: §"(name) }

        names.append(name)
        cursor ← add(cursor, 8 + name_len)

        # --- rank + shape dims (bounded) ----------------------------------
        let int rank ← u32(b, cursor)
        cursor ← add(cursor, 4)

        require rank ≢ 0 throw variant BadBounds { message = "tensor rank must be at least one" }

        require rank ≤ RANK_LIMIT throw variant BadBounds { message = "tensor rank exceeds the bounded limit" }

        mut list<int> shape ← empty
        mut int d ← 0

        while d ≺ rank {
            let int dim ← u64(b, cursor)

            reject dim ≤ 0 throw variant BadBounds { message = "tensor dimension must be positive" }

            shape.append(dim)
            cursor ← add(cursor, 8)
            d ↑
        }

        # --- dtype + offset + layout --------------------------------------
        let int ggml_dtype ← u32(b, cursor)
        cursor ← add(cursor, 4)
        let int offset ← u64(b, cursor)
        cursor ← add(cursor, 8)
        let int elements ← element_count(shape)
        let GgmlLayout lay ← layout(ggml_dtype, shape)

        # --- append tensor descriptor -------------------------------------
        tensors.append(GgufTensorDescriptor { name = name, shape = shape, dtype_ggml = ggml_dtype, representation = storage.ggml_representation(ggml_dtype), relative_offset = offset, elements = elements, layout = lay, block = block_metadata(lay) })
        t ↑
    }

    # --- manifest construct -----------------------------------------------
    return construct(corpus.identity, total, version, alignment, cursor, b.length(), metadata, tensors)
}

# Incrementally inspect a real GGUF header and directory. Every source request
# is an exact range established by the wire cursor; inspection stops at the end
# of the tensor table and never asks for a tensor payload byte.
@ public
fn inspect((int, int) → list<b8> ⇥ GgufManifestError source, int artifact_length, artifact.ContentIdentity identity) → GgufManifest ⇥ GgufManifestError {
    # --- identity + header (fail closed) ----------------------------------
    reject artifact_length ≤ 0 or not identity_valid(identity, artifact_length) throw variant BadIdentity { message = "content identity does not match the supplied artifact length" }

    let list<b8> header_wire ← read_source(source, artifact_length, 0, 24)
    let list<u8> header ← byte_list(header_wire)

    reject u8_value(header, 0) ≢ MAGIC_0 or u8_value(header, 1) ≢ MAGIC_1 or u8_value(header, 2) ≢ MAGIC_2 or u8_value(header, 3) ≢ MAGIC_3 throw variant BadFormat { message = "not a GGUF file — bad magic" }

    let int version ← u32(header, 4)

    require version ≡ GGUF_VERSION throw variant UnknownVersion { message = "unsupported GGUF version: §"(version ↦ string) }

    let int tensor_count ← u64(header, 8)
    let int kv_num ← u64(header, 16)

    reject tensor_count ≻ TENSOR_LIMIT or kv_num ≻ KV_LIMIT throw variant BadBounds { message = "GGUF count exceeds the bounded limit" }

    # --- metadata table (ranged reads) ------------------------------------
    mut int cursor ← 24
    mut list<GgufMetadata> metadata ← empty
    mut list<string> keys ← empty

    for range 0 ‥ kv_num let i {
        # --- key (length + duplicate check) -------------------------------
        let list<b8> key_head_wire ← read_source(source, artifact_length, cursor, 8)
        let int key_len ← u64_wire(key_head_wire)

        require key_len ≤ NAME_LIMIT throw variant BadBounds { message = "metadata key exceeds the bounded length" }

        cursor ← add(cursor, 8)
        let list<b8> key_body_wire ← read_source(source, artifact_length, cursor, key_len)
        let string key ← text_wire(key_body_wire)

        reject key ∈ keys throw variant DuplicateKey { message = "duplicate GGUF metadata key: §"(key) }

        keys.append(key)
        cursor ← add(cursor, key_len)

        # --- value kind + wire read ---------------------------------------
        let list<b8> type_wire ← read_source(source, artifact_length, cursor, 4)
        let int kind ← u32_wire(type_wire)

        require dtype_valid(kind) throw variant BadWire { message = "unknown GGUF metadata value type" }

        cursor ← add(cursor, 4)
        let list<b8> value_wire ← source_value(source, artifact_length, cursor, kind, 0)

        # --- append metadata record ---------------------------------------
        metadata.append(GgufMetadata { key = key, dtype = kind, payload_wire = value_wire })
        cursor ← add(cursor, value_wire.length())
    }

    # --- alignment override (general.alignment) ---------------------------
    mut int alignment ← DEFAULT_ALIGNMENT
    let GgufMetadata ∪ none alignment_meta ← find_metadata(metadata, "general.alignment")

    if alignment_meta not is none {
        let GgufMetadata alignment_value ← alignment_meta coalesce GgufMetadata { key = "", dtype = -1, payload_wire = || }

        require alignment_value.dtype ≡ GGUF_UINT32 throw variant BadWire { message = "general.alignment must use GGUF UINT32 wire kind" }

        let int file_alignment ← wire_count(alignment_value)

        reject file_alignment ≤ 0 or file_alignment ≻ 4294967295 or not power_two(file_alignment) throw variant BadWire { message = "general.alignment must be a positive power of two" }

        alignment ← file_alignment
    }

    # --- tensor table (ranged reads) --------------------------------------
    mut list<GgufTensorDescriptor> tensors ← empty
    mut list<string> names ← empty
    mut int t ← 0

    while t ≺ tensor_count {
        # --- name (length + duplicate check) ------------------------------
        let list<b8> name_head_wire ← read_source(source, artifact_length, cursor, 8)
        let int name_len ← u64_wire(name_head_wire)

        require name_len ≤ NAME_LIMIT throw variant BadBounds { message = "tensor name exceeds the bounded length" }

        cursor ← add(cursor, 8)
        let list<b8> name_body_wire ← read_source(source, artifact_length, cursor, name_len)
        let string name ← text_wire(name_body_wire)

        require name.length() ≢ 0 throw variant BadWire { message = "empty tensor name" }

        reject name ∈ names throw variant DuplicateTensor { message = "duplicate GGUF tensor name: §"(name) }

        names.append(name)
        cursor ← add(cursor, name_len)

        # --- rank + shape dims (bounded) ----------------------------------
        let list<b8> rank_wire ← read_source(source, artifact_length, cursor, 4)
        let int rank ← u32_wire(rank_wire)
        cursor ← add(cursor, 4)

        require rank ≢ 0 throw variant BadBounds { message = "tensor rank must be at least one" }

        require rank ≤ RANK_LIMIT throw variant BadBounds { message = "tensor rank exceeds the bounded limit" }

        mut list<int> shape ← empty
        mut int d ← 0

        while d ≺ rank {
            let list<b8> dim_wire ← read_source(source, artifact_length, cursor, 8)
            let int dim ← u64_wire(dim_wire)

            reject dim ≤ 0 throw variant BadBounds { message = "tensor dimension must be positive" }

            shape.append(dim)
            cursor ← add(cursor, 8)
            d ↑
        }

        # --- dtype + offset + layout --------------------------------------
        let list<b8> ggml_wire ← read_source(source, artifact_length, cursor, 4)
        let int ggml_dtype ← u32_wire(ggml_wire)
        cursor ← add(cursor, 4)
        let list<b8> offset_wire ← read_source(source, artifact_length, cursor, 8)
        let int offset ← u64_wire(offset_wire)
        cursor ← add(cursor, 8)
        let int elements ← element_count(shape)
        let GgmlLayout lay ← layout(ggml_dtype, shape)

        # --- append tensor descriptor -------------------------------------
        tensors.append(GgufTensorDescriptor { name = name, shape = shape, dtype_ggml = ggml_dtype, representation = storage.ggml_representation(ggml_dtype), relative_offset = offset, elements = elements, layout = lay, block = block_metadata(lay) })
        t ↑
    }

    # --- manifest construct -----------------------------------------------
    return construct(identity, artifact_length, version, alignment, cursor, cursor, metadata, tensors)
}

# Read an exact, bounded fragment of one known-layout tensor. `start` and
# `length` are relative to the tensor's payload; the source receives only
# the checked absolute range and is not retained in the returned bytes.
@ public
fn read_fragment(GgufManifest m, string name, int start, int length, (int, int) → list<b8> ⇥ GgufManifestError source) → list<b8> ⇥ GgufManifestError {
    # --- fragment range + tensor lookup (fail closed) ---------------------
    reject start ≺ 0 or length ≺ 0 throw variant BadOffset { message = "tensor fragment range is negative" }

    let GgufTensorDescriptor tensor ← find_tensor(m, name)

    match tensor.layout {
        case Known let elements_per_block, bytes_per_block, byte_length {
            # --- absolute range + exact source read -----------------------
            reject start ≻ byte_length or length ≻ byte_length - start throw variant BadOffset { message = "tensor fragment range exceeds the known tensor" }

            let int rel ← add(tensor.relative_offset, start)
            let int absolute ← add(m.data_start, rel)
            let int end ← add(absolute, length)

            reject absolute ≻ m.artifact_length or end ≻ m.artifact_length throw variant BadOffset { message = "tensor fragment range exceeds the artifact" }

            return read_source(source, m.artifact_length, absolute, length)
        }
        case Unknown let kind {
            throw variant UnknownLayout { message = "tensor layout is unknown; payload fragment is unavailable" }
        }
    }
}

+++ faber test
# GGUF-A1b manifest and range-source proof surface, plus the LIB-02-U1
# tokenizer metadata array accessors.
#
# `faber check` proves the builders, parse calls, returned-field access, and
# typed-error branches type-check. The current imported-library `faber test`
# route is provider-blocked; this file makes no executed-value claim. The
# executable package proof lives in exempla/gguf-manifest and records its own
# command/output receipt. The cases below also type-check exact wire-byte
# assertions for all thirteen metadata kinds, nested arrays, descriptor fields,
# legal range order/gaps, BOOL number rejection, incremental inspection,
# checked payload-fragment reads, and the tokenizer array accessors against the
# pinned target-prefix counts (248320 tokens, 247587 merges) and special ids.

import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" gguf_manifest

const string F_DIGEST = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn u8(int n) → list<u8> {
    return [(n % 256) ↦ u8]
}

fn u16(int n) → list<u8> {
    return [(n % 256) ↦ u8, ((n ⇒ 8) % 256) ↦ u8]
}

fn u32(int n) → list<u8> {
    return [(n % 256) ↦ u8, ((n ⇒ 8) % 256) ↦ u8, ((n ⇒ 16) % 256) ↦ u8, ((n ⇒ 24) % 256) ↦ u8]
}

fn u64(int n) → list<u8> {
    return [(n % 256) ↦ u8, ((n ⇒ 8) % 256) ↦ u8, ((n ⇒ 16) % 256) ↦ u8, ((n ⇒ 24) % 256) ↦ u8, ((n ⇒ 32) % 256) ↦ u8, ((n ⇒ 40) % 256) ↦ u8, ((n ⇒ 48) % 256) ↦ u8, ((n ⇒ 56) % 256) ↦ u8]
}

fn join(list<u8> a, list<u8> b) → list<u8> {
    mut list<u8> out ← empty
    for from a let x {
        out.append(x)
    }
    for from b let x {
        out.append(x)
    }
    return out
}

fn text_bytes(string s) → list<u8> {
    # Package MIR has no text→bytes extraction arm. This structural
    # builder only needs a finite ASCII corpus, so keep its encoding explicit.
    if s ≡ "general.architecture" then return [103, 101, 110, 101, 114, 97, 108, 46, 97, 114, 99, 104, 105, 116, 101, 99, 116, 117, 114, 101]
    if s ≡ "general.custom_note" then return [103, 101, 110, 101, 114, 97, 108, 46, 99, 117, 115, 116, 111, 109, 95, 110, 111, 116, 101]
    if s ≡ "tokenizer.ggml.tokens" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115]
    if s ≡ "tokenizer.ggml.token_type" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 95, 116, 121, 112, 101]
    if s ≡ "tokenizer.ggml.merges" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 109, 101, 114, 103, 101, 115]
    if s ≡ "tokenizer.ggml.bos_token_id" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 98, 111, 115, 95, 116, 111, 107, 101, 110, 95, 105, 100]
    if s ≡ "tokenizer.ggml.eos_token_id" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 101, 111, 115, 95, 116, 111, 107, 101, 110, 95, 105, 100]
    if s ≡ "tokenizer.ggml.padding_token_id" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 112, 97, 100, 100, 105, 110, 103, 95, 116, 111, 107, 101, 110, 95, 105, 100]
    if s ≡ "tokenizer.chat_template" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 99, 104, 97, 116, 95, 116, 101, 109, 112, 108, 97, 116, 101]
    if s ≡ "<s>" then return [60, 115, 62]
    if s ≡ "hello" then return [104, 101, 108, 108, 111]
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_norm.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "qwen2" then return [113, 119, 101, 110, 50]
    if s ≡ "general.alignment" then return [103, 101, 110, 101, 114, 97, 108, 46, 97, 108, 105, 103, 110, 109, 101, 110, 116]
    if s ≡ "qwen2.custom_flag" then return [113, 119, 101, 110, 50, 46, 99, 117, 115, 116, 111, 109, 95, 102, 108, 97, 103]
    if s ≡ "world" then return [119, 111, 114, 108, 100]
    if s ≡ "blk.0.attn_q.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "qwen35moe" then return [113, 119, 101, 110, 51, 53, 109, 111, 101]
    if s ≡ "qwen35moe.custom_flag" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 99, 117, 115, 116, 111, 109, 95, 102, 108, 97, 103]
    if s ≡ "blk.0.experts.0.weight" then return [98, 108, 107, 46, 48, 46, 101, 120, 112, 101, 114, 116, 115, 46, 48, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "bad.value" then return [98, 97, 100, 46, 118, 97, 108, 117, 101]
    if s ≡ "llama" then return [108, 108, 97, 109, 97]
    if s ≡ "same" then return [115, 97, 109, 101]
    if s ≡ "huge" then return [104, 117, 103, 101]
    if s ≡ "too_many" then return [116, 111, 111, 95, 109, 97, 110, 121]
    if s ≡ "scalar" then return [115, 99, 97, 108, 97, 114]
    if s ≡ "bad_q4k" then return [98, 97, 100, 95, 113, 52, 107]
    if s ≡ "known" then return [107, 110, 111, 119, 110]
    if s ≡ "unknown" then return [117, 110, 107, 110, 111, 119, 110]
    if s ≡ "overflow" then return [111, 118, 101, 114, 102, 108, 111, 119]
    if s ≡ "a" then return [97]
    if s ≡ "b" then return [98]
    if s ≡ "wire.uint8" then return [119, 105, 114, 101, 46, 117, 105, 110, 116, 56]
    if s ≡ "wire.int8" then return [119, 105, 114, 101, 46, 105, 110, 116, 56]
    if s ≡ "wire.uint16" then return [119, 105, 114, 101, 46, 117, 105, 110, 116, 49, 54]
    if s ≡ "wire.int16" then return [119, 105, 114, 101, 46, 105, 110, 116, 49, 54]
    if s ≡ "wire.uint32" then return [119, 105, 114, 101, 46, 117, 105, 110, 116, 51, 50]
    if s ≡ "wire.int32" then return [119, 105, 114, 101, 46, 105, 110, 116, 51, 50]
    if s ≡ "wire.float32" then return [119, 105, 114, 101, 46, 102, 108, 111, 97, 116, 51, 50]
    if s ≡ "wire.bool" then return [119, 105, 114, 101, 46, 98, 111, 111, 108]
    if s ≡ "wire.string" then return [119, 105, 114, 101, 46, 115, 116, 114, 105, 110, 103]
    if s ≡ "wire.array" then return [119, 105, 114, 101, 46, 97, 114, 114, 97, 121]
    if s ≡ "wire.nested" then return [119, 105, 114, 101, 46, 110, 101, 115, 116, 101, 100]
    if s ≡ "wire.uint64" then return [119, 105, 114, 101, 46, 117, 105, 110, 116, 54, 52]
    if s ≡ "wire.int64" then return [119, 105, 114, 101, 46, 105, 110, 116, 54, 52]
    if s ≡ "wire.float64" then return [119, 105, 114, 101, 46, 102, 108, 111, 97, 116, 54, 52]
    if s ≡ "qwen35moe.rope.dimension_sections" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 114, 111, 112, 101, 46, 100, 105, 109, 101, 110, 115, 105, 111, 110, 95, 115, 101, 99, 116, 105, 111, 110, 115]
    if s ≡ "tokenizer.ggml.add_bos_token" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 97, 100, 100, 95, 98, 111, 115, 95, 116, 111, 107, 101, 110]
    return []
}

fn str(string s) → list<u8> {
    let list<u8> b ← text_bytes(s)
    return join(u64(b.length()), b)
}

fn kv(string key, int kind, list<u8> value) → list<u8> {
    return join(join(str(key), u32(kind)), value)
}

fn array(int kind, int count, list<u8> value) → list<u8> {
    return join(join(u32(kind), u64(count)), value)
}

fn tensor_row(string name, list<int> shape, int kind, int offset) → list<u8> {
    mut list<u8> out ← join(str(name), u32(shape.length()))
    for from shape let dim {
        out ← join(out, u64(dim))
    }
    return join(join(out, u32(kind)), u64(offset))
}

fn header(int tensors, int metadata) → list<u8> {
    return join(join([71, 71, 85, 70], u32(3)), join(u64(tensors), u64(metadata)))
}

fn with_padding(list<u8> table, int alignment, int total, bool extra_data) → gguf_manifest.GgufCorpus {
    let int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    mut list<u8> b ← empty
    for from table let x {
        b.append(x)
    }
    while b.length() ≺ data_offset {
        b.append(0 ∷ u8)
    }
    if extra_data {
        b.append(0 ∷ u8)
    }
    let list<b8> o ↤ b
    return gguf_manifest.GgufCorpus { table = o, artifact_length = total, identity = artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = total } }
}

fn full(list<u8> table, int alignment, int payload) → gguf_manifest.GgufCorpus {
    let int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    return with_padding(table, alignment, data_offset + payload, false)
}

fn wire_equal(list<b8> actual, list<u8> expected) → bool {
    # Compared as ints: a `list<u8>` read out of a bits list does not compare
    # equal to a `list<u8>` literal on the runner (finding reported with this
    # change), while the widened int lists do.
    let list<u8> narrowed ← actual ↦ list<u8>
    let list<int> actual_ints ← narrowed ↦ list<int>
    let list<int> expected_ints ← expected ↦ list<int>
    return actual_ints ≡ expected_ints
}

fn metadata_corpus() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(0, 14)
    table ← join(table, kv("wire.uint8", 0, u8(127)))
    table ← join(table, kv("wire.int8", 1, u8(254)))
    table ← join(table, kv("wire.uint16", 2, u16(4660)))
    table ← join(table, kv("wire.int16", 3, u16(65534)))
    table ← join(table, kv("wire.uint32", 4, u32(305419896)))
    table ← join(table, kv("wire.int32", 5, u32(4294967294)))
    table ← join(table, kv("wire.float32", 6, [0, 0, 128, 63]))
    table ← join(table, kv("wire.bool", 7, u8(1)))
    table ← join(table, kv("wire.string", 8, str("hello")))
    table ← join(table, kv("wire.array", 9, array(2, 2, join(u16(4660), u16(43981)))))
    table ← join(table, kv("wire.nested", 9, array(9, 1, array(0, 2, [7, 8]))))
    table ← join(table, kv("wire.uint64", 10, u64(72623859790382856)))
    table ← join(table, kv("wire.int64", 11, [254, 255, 255, 255, 255, 255, 255, 255]))
    table ← join(table, kv("wire.float64", 12, [0, 0, 0, 0, 0, 0, 240, 63]))
    return full(table, 32, 0)
}

fn number_observe(gguf_manifest.GgufManifest m, string key) → string {
    do {
        return gguf_manifest.number(m, key) ↦ string
    }
    catch err {
        return "ERR:§"(err.message)
    }
}

fn metadata_wire_result() → bool {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(metadata_corpus())
        assert wire_equal(gguf_manifest.metadata(m, "wire.uint8").payload_wire, u8(127))
        assert wire_equal(gguf_manifest.metadata(m, "wire.int8").payload_wire, u8(254))
        assert wire_equal(gguf_manifest.metadata(m, "wire.uint16").payload_wire, u16(4660))
        assert wire_equal(gguf_manifest.metadata(m, "wire.int16").payload_wire, u16(65534))
        assert wire_equal(gguf_manifest.metadata(m, "wire.uint32").payload_wire, u32(305419896))
        assert wire_equal(gguf_manifest.metadata(m, "wire.int32").payload_wire, u32(4294967294))
        assert wire_equal(gguf_manifest.metadata(m, "wire.float32").payload_wire, [0, 0, 128, 63])
        assert wire_equal(gguf_manifest.metadata(m, "wire.bool").payload_wire, u8(1))
        assert wire_equal(gguf_manifest.metadata(m, "wire.string").payload_wire, str("hello"))
        assert wire_equal(gguf_manifest.metadata(m, "wire.array").payload_wire, array(2, 2, join(u16(4660), u16(43981))))
        assert wire_equal(gguf_manifest.metadata(m, "wire.nested").payload_wire, array(9, 1, array(0, 2, [7, 8])))
        assert wire_equal(gguf_manifest.metadata(m, "wire.uint64").payload_wire, u64(72623859790382856))
        assert wire_equal(gguf_manifest.metadata(m, "wire.int64").payload_wire, [254, 255, 255, 255, 255, 255, 255, 255])
        assert wire_equal(gguf_manifest.metadata(m, "wire.float64").payload_wire, [0, 0, 0, 0, 0, 0, 240, 63])
        assert number_observe(m, "wire.uint8") ≡ "127"
        assert number_observe(m, "wire.int8") ≡ "-2"
        assert number_observe(m, "wire.uint16") ≡ "4660"
        assert number_observe(m, "wire.int16") ≡ "-2"
        assert number_observe(m, "wire.uint32") ≡ "305419896"
        assert number_observe(m, "wire.int32") ≡ "-2"
        assert number_observe(m, "wire.uint64") ≡ "72623859790382856"
        assert number_observe(m, "wire.int64") ≡ "-2"
        assert gguf_manifest.text(m, "wire.string") ≡ "hello"
        return true
    }
    catch err {
        return false
    }
}

fn metadata_bool_float_result() → bool {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(metadata_corpus())
        assert number_observe(m, "wire.bool") ≡ "ERR:metadata value is not an unsigned integer"
        assert number_observe(m, "wire.float32") ≡ "ERR:metadata value is not an unsigned integer"
        assert number_observe(m, "wire.float64") ≡ "ERR:metadata value is not an unsigned integer"
        return true
    }
    catch err {
        return false
    }
}

fn descriptor_result(gguf_manifest.GgufCorpus corpus, string name) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        let gguf_manifest.GgufTensorDescriptor t ← gguf_manifest.find_tensor(m, name)
        let gguf_manifest.GgmlLayout layout ← t.layout
        return ((((m.data_start ↦ string) + "/") + (t.relative_offset ↦ string)) + "/") + (t.elements ↦ string)
    }
    catch err {
        return err.message
    }
}

fn reordered_gapped() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(2, 0)
    table ← join(table, tensor_row("b", [4, 1], 0, 160))
    table ← join(table, tensor_row("a", [4, 1], 0, 0))
    return full(table, 32, 256)
}

fn boundary_table() → list<u8> {
    return join(header(0, 1), kv("general.architecture", 8, str("llama")))
}

fn table_end() → gguf_manifest.GgufCorpus {
    let list<u8> table ← boundary_table()
    let int data_offset ← ((table.length() + 31) / 32) * 32
    let list<b8> o ↤ table
    return gguf_manifest.GgufCorpus { table = o, artifact_length = data_offset, identity = artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = data_offset } }
}

fn padding_end() → gguf_manifest.GgufCorpus {
    let list<u8> table ← boundary_table()
    let int data_offset ← ((table.length() + 31) / 32) * 32
    mut list<u8> b ← empty
    for from table let x {
        b.append(x)
    }
    b.append(0 ∷ u8)
    let list<b8> o ↤ b
    return gguf_manifest.GgufCorpus { table = o, artifact_length = data_offset, identity = artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = data_offset } }
}

fn llama() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(2, 3)
    table ← join(table, kv("general.architecture", 8, str("llama")))
    table ← join(table, kv("general.custom_note", 8, str("unknown metadata")))
    # An array-valued unknown key proves value-wire preservation beyond a
    # filename or architecture switch.
    table ← join(table, kv("tokenizer.ggml.tokens", 9, join(join(u32(8), u64(2)), join(str("<s>"), str("hello")))))
    table ← join(table, tensor_row("token_embd.weight", [4, 8], 0, 0))
    table ← join(table, tensor_row("blk.0.attn_norm.weight", [8], 1, 160))
    return with_padding(table, 32, 384 + 80, false)
}

fn qwen2() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(2, 4)
    table ← join(table, kv("general.architecture", 8, str("qwen2")))
    table ← join(table, kv("general.alignment", 4, u32(64)))
    table ← join(table, kv("qwen2.custom_flag", 4, u32(7)))
    table ← join(table, kv("tokenizer.ggml.tokens", 9, join(join(u32(8), u64(2)), join(str("hello"), str("world")))))
    # Q4_K block divisibility is along dimension 0; total-product-only logic
    # would incorrectly accept the old [1,1,256] shape.
    table ← join(table, tensor_row("blk.0.attn_q.weight", [256, 1, 1], 12, 0))
    table ← join(table, tensor_row("blk.0.attn_norm.weight", [2, 2], 0, 192))
    return with_padding(table, 64, 448 + 208, false)
}

fn qwen35moe() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(2, 4)
    table ← join(table, kv("general.architecture", 8, str("qwen35moe")))
    table ← join(table, kv("general.alignment", 4, u32(128)))
    table ← join(table, kv("qwen35moe.custom_flag", 4, u32(35)))
    table ← join(table, kv("tokenizer.ggml.tokens", 9, join(join(u32(8), u64(2)), join(str("hello"), str("world")))))
    table ← join(table, tensor_row("blk.0.experts.0.weight", [2, 3, 4], 999, 0))
    table ← join(table, tensor_row("blk.0.attn_norm.weight", [2, 2], 30, 64))
    return with_padding(table, 128, 512 + 72, false)
}

fn result(gguf_manifest.GgufCorpus corpus) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn surface_result(gguf_manifest.GgufCorpus corpus, string tensor_name) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        let string arch ← gguf_manifest.text(m, "general.architecture")
        let gguf_manifest.GgufTensorDescriptor t ← gguf_manifest.find_tensor(m, tensor_name)
        return (((((arch + "/") + (m.alignment ↦ string)) + "/") + ((t.shape.get(0) coalesce 0) ↦ string)) + "/") + (t.dtype_ggml ↦ string)
    }
    catch err {
        return err.message
    }
}

fn bad_magic() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(0, 0)
    table ← join([0], table.take(table.length() - 1) ⊥ [])
    return with_padding(table, 32, 32, false)
}

fn bad_version() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(0, 0)
    table ← join(join(table.take(4) ⊥ [], u32(2)), join(u64(0), u64(0)))
    return with_padding(table, 32, 32, false)
}

fn truncated() → gguf_manifest.GgufCorpus {
    let list<u8> b ← [71, 71, 85, 70]
    let list<b8> o ↤ b
    return gguf_manifest.GgufCorpus { table = o, artifact_length = 32, identity = artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = 32 } }
}

fn wrong_alignment_kind(int kind, list<u8> value) → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(0, 1)
    table ← join(table, kv("general.alignment", kind, value))
    return with_padding(table, 32, 32, false)
}

fn malformed_value(int kind, list<u8> value) → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(0, 1)
    table ← join(table, kv("bad.value", kind, value))
    return with_padding(table, 32, 32, false)
}

fn duplicate_metadata() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(0, 2)
    table ← join(table, kv("general.architecture", 8, str("llama")))
    table ← join(table, kv("general.architecture", 8, str("qwen2")))
    return with_padding(table, 32, 32, false)
}

fn duplicate_tensors() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(2, 0)
    table ← join(table, tensor_row("same", [8], 0, 0))
    table ← join(table, tensor_row("same", [8], 0, 32))
    return with_padding(table, 32, 64, false)
}

fn large_dimension() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(1, 0)
    table ← join(table, tensor_row("huge", [1000000001], 999, 0))
    return with_padding(table, 32, 64, false)
}

fn element_overflow() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(1, 0)
    table ← join(table, tensor_row("too_many", [3037000500, 3037000500], 999, 0))
    return with_padding(table, 32, 64, false)
}

fn rank_zero() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(1, 0)
    table ← join(table, tensor_row("scalar", [], 0, 0))
    return with_padding(table, 32, 64, false)
}

fn non_block_quant() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(1, 0)
    table ← join(table, tensor_row("bad_q4k", [1, 1, 256], 12, 0))
    return with_padding(table, 32, 144, false)
}

fn known_out_of_file() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(1, 0)
    table ← join(table, tensor_row("known", [256, 1], 12, 0))
    return with_padding(table, 32, 100, false)
}

fn unknown_out_of_file() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(1, 0)
    table ← join(table, tensor_row("unknown", [2, 3, 4], 999, 1000))
    return with_padding(table, 32, 100, false)
}

fn offset_overflow() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(1, 0)
    table ← join(table, tensor_row("overflow", [2, 3, 4], 999, 9223372036854775807))
    return with_padding(table, 32, 100, false)
}

fn overlap() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(2, 0)
    table ← join(table, tensor_row("a", [8], 0, 0))
    table ← join(table, tensor_row("b", [8], 0, 16))
    return with_padding(table, 32, 144, false)
}

fn extra_data_region() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(0, 0)
    return with_padding(table, 32, 32, true)
}

fn identity_mismatch() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(0, 0)
    let int data_offset ← ((table.length() + 31) / 32) * 32
    mut list<u8> b ← empty
    for from table let x {
        b.append(x)
    }
    while b.length() ≺ data_offset {
        b.append(0 ∷ u8)
    }
    let list<b8> o ↤ b
    return gguf_manifest.GgufCorpus { table = o, artifact_length = data_offset, identity = artifact.ContentIdentity { algorithm = "md5", digest = F_DIGEST, length = data_offset } }
}

fn read_llama(int start, int length) → list<b8> ⇥ gguf_manifest.GgufManifestError {
    let gguf_manifest.GgufCorpus corpus ← llama()
    let list<b8> table ← corpus.table
    reject ((start ≺ 0 or length ≺ 0) or start + length ≻ corpus.artifact_length) throw variant BadSource { message = "synthetic range is outside the artifact" }
    mut list<b8> out ← ||
    for range 0‥length let i {
        let int index ← start + i
        if index ≺ table.length() {
            out.append(table.get(index) coalesce (0x00 ∷ b8))
        }
        else {
            out.append((index % 256) ↦ b8)
        }
    }
    return out
}

fn read_failed(int start, int length) → list<b8> ⇥ gguf_manifest.GgufManifestError {
    throw variant BadSource { message = "synthetic read failed" }
}

fn inspect_result(bool deficit) → string {
    do {
        let gguf_manifest.GgufCorpus corpus ← llama()
        if deficit {
            let gguf_manifest.GgufManifest ? ← gguf_manifest.inspect(read_failed, corpus.artifact_length, corpus.identity)
        }
        else {
            let gguf_manifest.GgufManifest m ← gguf_manifest.inspect(read_llama, corpus.artifact_length, corpus.identity)
            return (gguf_manifest.text(m, "general.architecture") + "/") + (m.data_start ↦ string)
        }
        return "unexpected-success"
    }
    catch err {
        return err.message
    }
}

fn fragment_result() → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(llama())
        let list<b8> bytes ← gguf_manifest.read_fragment(m, "token_embd.weight", 3, 4, read_llama)
        if wire_equal(bytes, [35, 36, 37, 38]) then return "exact-bytes"
        return "wrong-bytes"
    }
    catch err {
        return err.message
    }
}

# LIB-02-U1 tokenizer-metadata pins from the target-prefix corpus
# (Qwen3.6-35B-A3B-UD-Q4_K_M.gguf metadata block): 248320 vocab entries,
# 247587 merges, and the pinned special ids. The builder repeats a finite
# fixture vocabulary so the arrays carry the exact pinned counts without a
# runtime text-to-bytes encoder in package MIR.
const int TOKENS_PIN = 248320
const int MERGES_PIN = 247587
const int BOS_PIN = 248044
const int EOS_PIN = 248046
const int PAD_PIN = 248055

fn strings_repeat(int count, list<u8> bytes) → list<u8> {
    mut list<u8> out ← empty
    for range 0‥count let i {
        for from bytes let b {
            out.append(b)
        }
    }
    return out
}

fn u32_repeat(int count) → list<u8> {
    let list<u8> four ← u32(0)
    mut list<u8> out ← empty
    for range 0‥count let i {
        for from four let b {
            out.append(b)
        }
    }
    return out
}

# One in-place pass: every piece is appended to the single `table` list once.
# Building this 7 MB table with `join` (a per-byte copy of both operands) at
# each nesting level copies it about ten times and by itself exceeds the
# 100,000,000-step interpreter budget before any parser code runs.
fn tokenizer_corpus() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(0, 8)
    table ← join(table, kv("general.architecture", 8, str("qwen35moe")))
    let list<u8> tokens_head ← join(join(str("tokenizer.ggml.tokens"), u32(9)), join(u32(8), u64(TOKENS_PIN)))
    for from tokens_head let x {
        table.append(x)
    }
    let list<u8> token_unit ← str("<s>")
    for range 0‥TOKENS_PIN let i {
        for from token_unit let x {
            table.append(x)
        }
    }
    let list<u8> types_head ← join(join(str("tokenizer.ggml.token_type"), u32(9)), join(u32(4), u64(TOKENS_PIN)))
    for from types_head let x {
        table.append(x)
    }
    let list<u8> type_unit ← u32(0)
    for range 0‥TOKENS_PIN let i {
        for from type_unit let x {
            table.append(x)
        }
    }
    let list<u8> merges_head ← join(join(str("tokenizer.ggml.merges"), u32(9)), join(u32(8), u64(MERGES_PIN)))
    for from merges_head let x {
        table.append(x)
    }
    let list<u8> merge_unit ← str("hello")
    for range 0‥MERGES_PIN let i {
        for from merge_unit let x {
            table.append(x)
        }
    }
    let list<u8> tail ← join(join(kv("tokenizer.ggml.bos_token_id", 4, u32(BOS_PIN)), kv("tokenizer.ggml.eos_token_id", 4, u32(EOS_PIN))), join(kv("tokenizer.ggml.padding_token_id", 4, u32(PAD_PIN)), kv("tokenizer.chat_template", 8, str("hello"))))
    for from tail let x {
        table.append(x)
    }
    let int data_offset ← (((table.length() + 32) - 1) / 32) * 32
    while table.length() ≺ data_offset {
        table.append(0 ∷ u8)
    }
    let list<b8> o ↤ table
    return gguf_manifest.GgufCorpus { table = o, artifact_length = data_offset, identity = artifact.ContentIdentity { algorithm = "sha-256", digest = F_DIGEST, length = data_offset } }
}

fn tokenizer_array_result() → bool {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(tokenizer_corpus())
        let list<string> tokens ← gguf_manifest.texts(m, "tokenizer.ggml.tokens")
        let list<string> merges ← gguf_manifest.texts(m, "tokenizer.ggml.merges")
        let list<int> types ← gguf_manifest.numbers(m, "tokenizer.ggml.token_type")
        assert tokens.length() ≡ TOKENS_PIN
        assert merges.length() ≡ MERGES_PIN
        assert types.length() ≡ TOKENS_PIN
        assert tokens.get(0) coalesce "" ≡ "<s>"
        assert gguf_manifest.number(m, "tokenizer.ggml.bos_token_id") ≡ BOS_PIN
        assert gguf_manifest.number(m, "tokenizer.ggml.eos_token_id") ≡ EOS_PIN
        assert gguf_manifest.number(m, "tokenizer.ggml.padding_token_id") ≡ PAD_PIN
        assert gguf_manifest.text(m, "tokenizer.chat_template") ≡ "hello"
        return true
    }
    catch err {
        return false
    }
}

fn texts_error(gguf_manifest.GgufCorpus corpus, string key) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        let list<string> ? ← gguf_manifest.texts(m, key)
        return "unexpected-success"
    }
    catch err {
        return err.message
    }
}

# Classify a metadata miss by variant, not by diagnostic prose. A missing
# key must be NotFound; BadWire is reserved for malformed present values.
fn metadata_error_kind(gguf_manifest.GgufCorpus corpus, string key) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        let gguf_manifest.GgufMetadata ? ← gguf_manifest.metadata(m, key)
        return "unexpected-success"
    }
    catch err {
        match err {
            case gguf_manifest.NotFound let message {
                return "not-found|" + message
            }
            case gguf_manifest.BadWire let message {
                return "bad-wire|" + message
            }
            case _ {
                return "other|" + err.message
            }
        }
    }
}

# Present non-array value stays BadWire (malformed, not absent).
fn texts_error_kind(gguf_manifest.GgufCorpus corpus, string key) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        let list<string> ? ← gguf_manifest.texts(m, key)
        return "unexpected-success"
    }
    catch err {
        match err {
            case gguf_manifest.NotFound let message {
                return "not-found|" + message
            }
            case gguf_manifest.BadWire let message {
                return "bad-wire|" + message
            }
            case _ {
                return "other|" + err.message
            }
        }
    }
}

# Classify a tensor miss by variant. find_tensor absence is NotFound.
fn tensor_error_kind(gguf_manifest.GgufCorpus corpus, string name) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        let gguf_manifest.GgufTensorDescriptor ? ← gguf_manifest.find_tensor(m, name)
        return "unexpected-success"
    }
    catch err {
        match err {
            case gguf_manifest.NotFound let message {
                return "not-found|" + message
            }
            case gguf_manifest.BadWire let message {
                return "bad-wire|" + message
            }
            case _ {
                return "other|" + err.message
            }
        }
    }
}

fn numbers_error(gguf_manifest.GgufCorpus corpus, string key) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        let list<int> ? ← gguf_manifest.numbers(m, key)
        return "unexpected-success"
    }
    catch err {
        return err.message
    }
}

fn duplicate_tokenizer_key() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(0, 2)
    table ← join(table, kv("tokenizer.ggml.tokens", 9, array(8, 1, str("<s>"))))
    table ← join(table, kv("tokenizer.ggml.tokens", 9, array(8, 1, str("hello"))))
    return with_padding(table, 32, 32, false)
}

describe "GGUF-A1b manifest and range-source cases" {
    test "parses llama default with unknown metadata, qwen2 custom alignment, and qwen35moe surfaces" {
        assert result(llama()) ≡ "ok"
        assert result(qwen2()) ≡ "ok"
        assert result(qwen35moe()) ≡ "ok"
        assert surface_result(llama(), "token_embd.weight") ≡ "llama/32/4/0"
        assert surface_result(qwen2(), "blk.0.attn_q.weight") ≡ "qwen2/64/256/12"
        assert surface_result(qwen35moe(), "blk.0.experts.0.weight") ≡ "qwen35moe/128/2/999"
        do {
            let gguf_manifest.GgufManifest m ← gguf_manifest.parse(llama())
            let gguf_manifest.GgufMetadata unknown ← gguf_manifest.metadata(m, "general.custom_note")
            assert unknown.dtype ≡ 8
            assert unknown.payload_wire.length() ≻ 0
        }
        catch err {
            assert false
        }
    }
    test "preserves unknown type and mixed tensor metadata" {
        do {
            let gguf_manifest.GgufManifest m ← gguf_manifest.parse(qwen35moe())
            let gguf_manifest.GgufTensorDescriptor t ← gguf_manifest.find_tensor(m, "blk.0.experts.0.weight")
            let gguf_manifest.GgufTensorDescriptor known ← gguf_manifest.find_tensor(m, "blk.0.attn_norm.weight")
            let gguf_manifest.GgmlLayout l ← t.layout
            let gguf_manifest.GgmlLayout ? ← gguf_manifest.layout(999, [2, 3, 4])
            assert gguf_manifest.text(m, "general.architecture") ≡ "qwen35moe"
            assert gguf_manifest.number(m, "qwen35moe.custom_flag") ≡ 35
            assert t.dtype_ggml ≡ 999
            assert known.dtype_ggml ≡ 30
            assert gguf_manifest.metadata(m, "general.architecture").dtype ≡ 8
        }
        catch err {
            assert false
        }
    }
    test "rejects malformed magic, version, truncation, bool, and string" {
        assert result(bad_magic()) ≡ "not a GGUF file — bad magic"
        assert result(bad_version()) ≡ "unsupported GGUF version: 2"
        assert result(truncated()) ≡ "truncated GGUF header"
        assert result(wrong_alignment_kind(7, u8(1))) ≡ "general.alignment must use GGUF UINT32 wire kind"
        assert result(wrong_alignment_kind(4, u32(3))) ≡ "general.alignment must be a positive power of two"
        assert result(malformed_value(7, u8(2))) ≡ "malformed GGUF bool value"
        assert result(malformed_value(8, join(u64(1), [255]))) ≡ "GGUF string is not valid UTF-8"
    }
    test "rejects duplicate keys/names, bounds, overlap, and data bytes" {
        assert result(duplicate_metadata()) ≡ "duplicate GGUF metadata key: general.architecture"
        assert result(duplicate_tensors()) ≡ "duplicate GGUF tensor name: same"
        assert result(large_dimension()) ≡ "ok"
        assert result(element_overflow()) ≡ "tensor element count exceeds the numeric range"
        assert result(rank_zero()) ≡ "tensor rank must be at least one"
        assert result(non_block_quant()) ≡ "tensor first dimension is not a complete GGML block"
        assert result(known_out_of_file()) ≡ "known GGML tensor range exceeds the artifact"
        assert result(unknown_out_of_file()) ≡ "GGML tensor offset exceeds the artifact"
        assert result(offset_overflow()) ≡ "checked offset addition overflow"
        assert result(overlap()) ≡ "known GGML tensor ranges overlap"
        assert result(extra_data_region()) ≡ "bounded GGUF corpus contains bytes from the data region"
        assert result(identity_mismatch()) ≡ "content identity does not match the supplied artifact length"
    }
    test "preserves all thirteen metadata wire kinds and exact payload bytes" {
        assert metadata_wire_result()
    }
    test "keeps BOOL parseable while number rejects BOOL and floating values" {
        assert metadata_bool_float_result()
        do {
            let gguf_manifest.GgufManifest m ← gguf_manifest.parse(metadata_corpus())
            assert gguf_manifest.metadata(m, "wire.bool").dtype ≡ 7
            assert number_observe(m, "wire.bool") ≡ "ERR:metadata value is not an unsigned integer"
        }
        catch err {
            assert false
        }
    }
    test "observes default/custom data starts, descriptor ranges, and legal reorder/gaps" {
        assert descriptor_result(llama(), "blk.0.attn_norm.weight") ≡ "288/160/8"
        assert descriptor_result(qwen2(), "blk.0.attn_norm.weight") ≡ "384/192/4"
        assert descriptor_result(reordered_gapped(), "b") ≡ "128/160/4"
    }
    test "accepts a corpus ending at table end or inside alignment padding" {
        assert result(table_end()) ≡ "ok"
        assert result(padding_end()) ≡ "ok"
        do {
            let gguf_manifest.GgufManifest exactum ← gguf_manifest.parse(table_end())
            let gguf_manifest.GgufManifest partiale ← gguf_manifest.parse(padding_end())
            assert exactum.data_start ≡ 96
            assert partiale.data_start ≡ 96
            assert exactum.artifact_length ≡ 96
            assert partiale.artifact_length ≡ 96
        }
        catch err {
            assert false
        }
    }
    test "inspects the bounded table through a caller-owned range source" {
        assert inspect_result(false) ≡ "llama/288"
        assert inspect_result(true) ≡ "synthetic read failed"
    }
    test "reads an exact checked tensor fragment" {
        assert fragment_result() ≡ "exact-bytes"
    }
}

# A3-C2-U1 payload-range accessor (LIB-03). Renders the exact stored byte
# range of one known-layout tensor as "start/length", or the typed error.
fn limit_result(gguf_manifest.GgufCorpus corpus, string name) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        let tuple<int, int> limit ← gguf_manifest.payload_limit(m, name)
        return ((limit[0] ↦ string) + "/") + (limit[1] ↦ string)
    }
    catch err {
        return err.message
    }
}

describe "A3-C2-U1 payload_limit payload-range accessor" {
    test "returns the exact stored byte range of one known-layout tensor" {
        assert limit_result(llama(), "token_embd.weight") ≡ "288/128"
        assert limit_result(llama(), "blk.0.attn_norm.weight") ≡ "448/16"
        assert limit_result(qwen2(), "blk.0.attn_q.weight") ≡ "384/144"
        assert limit_result(qwen2(), "blk.0.attn_norm.weight") ≡ "576/16"
        assert limit_result(qwen35moe(), "blk.0.attn_norm.weight") ≡ "448/8"
    }
    test "passes through find_tensor for an unknown tensor name" {
        assert limit_result(llama(), "no.such.tensor") ≡ "tensor not found: no.such.tensor"
    }
    test "fails closed on an unknown (Unknown) layout" {
        assert limit_result(qwen35moe(), "blk.0.experts.0.weight") ≡ "tensor layout is unknown; payload range is unavailable"
    }
}

describe "LIB-02-U1 tokenizer metadata accessors" {
    test "returns the exact token/merge counts and pinned special ids from the tokenizer metadata block" {
        assert tokenizer_array_result()
    }
    test "rejects missing, malformed, and duplicate tokenizer keys with typed GgufManifestError rows" {
        let gguf_manifest.GgufCorpus corpus ← tokenizer_corpus()
        assert texts_error(corpus, "tokenizer.ggml.max_token_id") ≡ "metadata key not found: tokenizer.ggml.max_token_id"
        assert texts_error(corpus, "tokenizer.ggml.bos_token_id") ≡ "metadata value is not a GGUF string array"
        assert numbers_error(corpus, "tokenizer.ggml.tokens") ≡ "metadata array is not an integer array"
        assert numbers_error(corpus, "tokenizer.chat_template") ≡ "metadata value is not a GGUF integer array"
        assert result(duplicate_tokenizer_key()) ≡ "duplicate GGUF metadata key: tokenizer.ggml.tokens"
    }
    test "missing metadata keys and tensor names are NotFound, not BadWire" {
        let gguf_manifest.GgufCorpus corpus ← tokenizer_corpus()
        assert metadata_error_kind(corpus, "tokenizer.ggml.max_token_id") ≡ "not-found|metadata key not found: tokenizer.ggml.max_token_id"
        assert texts_error_kind(corpus, "tokenizer.ggml.bos_token_id") ≡ "bad-wire|metadata value is not a GGUF string array"
        assert tensor_error_kind(llama(), "no.such.tensor") ≡ "not-found|tensor not found: no.such.tensor"
    }
}

# MODEL-01-M1 architecture-facing typed accessors (MODEL-01 chain). Pins the
# frozen qwen35moe facts through the new typed reads: the array-of-uint32
# read (rope.dimension_sections → [11, 11, 10, 0]), the bool read
# (add_bos_token → false), and the array-length read (tokenizer identity
# counts 248320 / 248320 / 247587). No parser behavior change.
fn qwen35moe_facts_corpus() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(0, 3)
    table ← join(table, kv("general.architecture", 8, str("qwen35moe")))
    table ← join(table, kv("qwen35moe.rope.dimension_sections", 9, array(4, 4, join(join(u32(11), u32(11)), join(u32(10), u32(0))))))
    table ← join(table, kv("tokenizer.ggml.add_bos_token", 7, u8(0)))
    return full(table, 32, 0)
}

fn m1_u32_error(gguf_manifest.GgufCorpus corpus, string key) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        let list<int> ? ← gguf_manifest.numbers_u32(m, key)
        return "unexpected-success"
    }
    catch err {
        return err.message
    }
}

fn m1_bool_error(gguf_manifest.GgufCorpus corpus, string key) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        let bool ? ← gguf_manifest.boolean(m, key)
        return "unexpected-success"
    }
    catch err {
        return err.message
    }
}

fn m1_length_error(gguf_manifest.GgufCorpus corpus, string key) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        let int ? ← gguf_manifest.list_length(m, key)
        return "unexpected-success"
    }
    catch err {
        return err.message
    }
}

describe "MODEL-01-M1 architecture-facing typed accessors" {
    test "decodes qwen35moe.rope.dimension_sections to the frozen [11, 11, 10, 0]" {
        do {
            let gguf_manifest.GgufManifest m ← gguf_manifest.parse(qwen35moe_facts_corpus())
            let list<int> sections ← gguf_manifest.numbers_u32(m, "qwen35moe.rope.dimension_sections")
            assert sections.length() ≡ 4
            assert (sections.get(0) coalesce 0) ≡ 11
            assert (sections.get(1) coalesce 0) ≡ 11
            assert (sections.get(2) coalesce 0) ≡ 10
            assert (sections.get(3) coalesce 0) ≡ 0
        }
        catch err {
            assert false
        }
    }
    test "decodes tokenizer.ggml.add_bos_token to false" {
        do {
            let gguf_manifest.GgufManifest m ← gguf_manifest.parse(qwen35moe_facts_corpus())
            assert gguf_manifest.boolean(m, "tokenizer.ggml.add_bos_token") ≡ false
        }
        catch err {
            assert false
        }
    }
    test "reads the pinned tokenizer array lengths (248320 / 248320 / 247587) without decoding elements" {
        do {
            let gguf_manifest.GgufManifest m ← gguf_manifest.parse(tokenizer_corpus())
            assert gguf_manifest.list_length(m, "tokenizer.ggml.tokens") ≡ TOKENS_PIN
            assert gguf_manifest.list_length(m, "tokenizer.ggml.token_type") ≡ TOKENS_PIN
            assert gguf_manifest.list_length(m, "tokenizer.ggml.merges") ≡ MERGES_PIN
        }
        catch err {
            assert false
        }
    }
    test "rejects missing, wrong-kind, and non-u32-array keys with typed GgufManifestError rows" {
        let gguf_manifest.GgufCorpus corpus ← tokenizer_corpus()
        assert m1_u32_error(corpus, "tokenizer.ggml.tokens") ≡ "metadata array is not a u32 array"
        assert m1_u32_error(corpus, "tokenizer.ggml.bos_token_id") ≡ "metadata value is not a GGUF u32 array"
        assert m1_u32_error(metadata_corpus(), "wire.array") ≡ "metadata array is not a u32 array"
        assert m1_u32_error(corpus, "tokenizer.ggml.max_token_id") ≡ "metadata key not found: tokenizer.ggml.max_token_id"
        assert m1_bool_error(corpus, "tokenizer.ggml.bos_token_id") ≡ "metadata value is not a GGUF bool"
        assert m1_bool_error(corpus, "tokenizer.ggml.add_bos_token") ≡ "metadata key not found: tokenizer.ggml.add_bos_token"
        assert m1_length_error(corpus, "tokenizer.ggml.bos_token_id") ≡ "metadata value is not a GGUF array"
        assert m1_length_error(corpus, "tokenizer.ggml.add_bos_token") ≡ "metadata key not found: tokenizer.ggml.add_bos_token"
    }
}
