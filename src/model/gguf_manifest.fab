# GGUF v3 format-general manifest parser (GGUF-A1a).
#
# Public import: importa ex "gradus:model/gguf_manifest" privata manifestum
# Depends on: gradus:model/artifact (pathless content identity).
#
# This leaf consumes a bounded header/metadata/tensor-table corpus. It never
# retains that corpus, a path, a URL, a reader, a file handle, a mapping, or a
# device object. Tensor payloads remain outside Gradus until a later range
# source unit. `valor_wire` is the exact encoded GGUF value payload, beginning
# at the value's first byte and ending after its own length-prefixed content.

importa ex "gradus:model/artifact" privata artifact

# GGUF v3 wire value kinds (gguf.h enum gguf_type).
fixum numerus GGUF_UINT8 ← 0
fixum numerus GGUF_INT8 ← 1
fixum numerus GGUF_UINT16 ← 2
fixum numerus GGUF_INT16 ← 3
fixum numerus GGUF_UINT32 ← 4
fixum numerus GGUF_INT32 ← 5
fixum numerus GGUF_FLOAT32 ← 6
fixum numerus GGUF_BOOL ← 7
fixum numerus GGUF_STRING ← 8
fixum numerus GGUF_ARRAY ← 9
fixum numerus GGUF_UINT64 ← 10
fixum numerus GGUF_INT64 ← 11
fixum numerus GGUF_FLOAT64 ← 12

# GGML storage ids and block geometry. The table covers the ordinary GGUF
# scalar, integer, BF16, and K-quant rows seen in current Hub artifacts. A
# valid but unlisted id stays inspectable as LayoutGgml.Ignota.
fixum numerus GGML_F32 ← 0
fixum numerus GGML_F16 ← 1
fixum numerus GGML_Q4_0 ← 2
fixum numerus GGML_Q4_1 ← 3
fixum numerus GGML_Q5_0 ← 6
fixum numerus GGML_Q5_1 ← 7
fixum numerus GGML_Q8_0 ← 8
fixum numerus GGML_Q8_1 ← 9
fixum numerus GGML_Q2_K ← 10
fixum numerus GGML_Q3_K ← 11
fixum numerus GGML_Q4_K ← 12
fixum numerus GGML_Q5_K ← 13
fixum numerus GGML_Q6_K ← 14
fixum numerus GGML_Q8_K ← 15
fixum numerus GGML_IQ4_NL ← 20
fixum numerus GGML_I8 ← 24
fixum numerus GGML_I16 ← 25
fixum numerus GGML_I32 ← 26
fixum numerus GGML_I64 ← 27
fixum numerus GGML_F64 ← 28
fixum numerus GGML_BF16 ← 30

fixum numerus GGUF_VERSION ← 3
fixum numerus DEFAULT_ALIGNMENT ← 32
fixum numerus MAGIC_0 ← 0x47
fixum numerus MAGIC_1 ← 0x47
fixum numerus MAGIC_2 ← 0x55
fixum numerus MAGIC_3 ← 0x46

# Bounds protect the parser from count/length-driven allocation or loops.
# Duplicate-key/name and known-range validation are intentionally bounded
# quadratic scans in this A1a implementation. The 4,096-entry ceilings keep
# that work finite while admitting every inventoried local model (55 metadata
# entries and at most 753 tensors). The 64 MiB corpus ceiling bounds the
# retained header/table copy; the full model payload is never supplied here.
fixum numerus KV_LIMES ← 4096
fixum numerus TENSORUM_LIMES ← 4096
fixum numerus CORPUS_LIMES ← 67108864
fixum numerus NOMEN_LIMES ← 4096
fixum numerus TEXTUS_LIMES ← 1048576
fixum numerus ARRAY_LIMES ← 1048576
fixum numerus RANK_LIMES ← 64
fixum numerus DIMENSI_LIMES ← 1000000000
fixum numerus ELEMENTA_LIMES ← 1000000000
fixum numerus MAX_NUMERUS ← 9223372036854775807

discretio GgufManifestError {
    FormatMala { textus causa },
    VersioIgnota { textus causa },
    Truncata { textus causa },
    WireMala { textus causa },
    LimitesMala { textus causa },
    Superfluitas { textus causa },
    ClavisDuplicata { textus causa },
    TensorDuplicatum { textus causa },
    OffsetMala { textus causa },
    IdentitasMala { textus causa }
}

genus CorpusGguf {
    octeti tabula
    numerus longitudo_artifacti
    artifact.IdentitasContenuti identitas
}

genus MetadatumGguf {
    textus clavis
    numerus typo
    octeti valor_wire
}

discretio LayoutGgml {
    Cognita { numerus elementa_per_blockum, numerus octeti_per_blockum, numerus longitudo_octetorum },
    Ignota { numerus typo }
}

genus DescriptioTensorisGguf {
    textus nomen
    lista<numerus> forma
    numerus typo_ggml
    numerus offset_relativum
    numerus elementa
    LayoutGgml layout
}

genus ManifestumGguf {
    artifact.IdentitasContenuti identitas
    numerus versio
    numerus concordatio
    numerus data_inceptum
    numerus longitudo_artifacti
    lista<MetadatumGguf> metadata
    lista<DescriptioTensorisGguf> tensores
}

functio causa(GgufManifestError e) → textus {
    discerne e {
        casu FormatMala fixum causa { redde causa }
        casu VersioIgnota fixum causa { redde causa }
        casu Truncata fixum causa { redde causa }
        casu WireMala fixum causa { redde causa }
        casu LimitesMala fixum causa { redde causa }
        casu Superfluitas fixum causa { redde causa }
        casu ClavisDuplicata fixum causa { redde causa }
        casu TensorDuplicatum fixum causa { redde causa }
        casu OffsetMala fixum causa { redde causa }
        casu IdentitasMala fixum causa { redde causa }
    }
}

# -------------------------------------------------------------------------
# Basic byte and checked-arithmetic helpers.
# -------------------------------------------------------------------------

@ privata
functio _octeti_lista(octeti o) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < o.longitudo() {
        out.appende(o.accipe(i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    redde out
}

@ privata
functio _octeti_ex_lista(lista<numerus<u8>> b) → octeti {
    varia octeti out ← ||
    itera ex b fixum v {
        out.appende(v)
    }
    redde out
}

@ privata
functio _add(numerus a, numerus b) → numerus ⇥ GgufManifestError {
    si a < 0 aut b < 0 aut a > MAX_NUMERUS - b {
        iace finge LimitesMala { causa = "checked offset addition overflow" }
    }
    redde a + b
}

@ privata
functio _mul(numerus a, numerus b) → numerus ⇥ GgufManifestError {
    si a < 0 aut b < 0 aut (b ≠ 0 et a > MAX_NUMERUS / b) {
        iace finge LimitesMala { causa = "checked length multiplication overflow" }
    }
    redde a * b
}

@ privata
functio _slice(lista<numerus<u8>> b, numerus off, numerus len) → lista<numerus<u8>> ⇥ GgufManifestError {
    si off < 0 aut len < 0 {
        iace finge LimitesMala { causa = "negative byte range" }
    }
    fixum numerus finis ← _add(off, len)
    si finis > b.longitudo() {
        iace finge Truncata { causa = "bounded GGUF corpus ends before the required field" }
    }
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < len {
        out.appende(b.accipe(off + i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    redde out
}

@ privata
functio _u32(lista<numerus<u8>> b, numerus off) → numerus ⇥ GgufManifestError {
    fixum lista<numerus<u8>> x ← _slice(b, off, 4)
    fixum numerus r0 ← (x.accipe(0) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r1 ← (x.accipe(1) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r2 ← (x.accipe(2) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r3 ← (x.accipe(3) vel (0 ∷ numerus<u8>)) ↦ numerus
    redde r0 ∨ (r1 ⇐ 8) ∨ (r2 ⇐ 16) ∨ (r3 ⇐ 24)
}

@ privata
functio _u64(lista<numerus<u8>> b, numerus off) → numerus ⇥ GgufManifestError {
    fixum lista<numerus<u8>> x ← _slice(b, off, 8)
    fixum numerus r7 ← (x.accipe(7) vel (0 ∷ numerus<u8>)) ↦ numerus
    si r7 ≥ 128 {
        iace finge LimitesMala { causa = "GGUF UINT64 value exceeds the numerus carrier" }
    }
    fixum numerus r0 ← (x.accipe(0) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r1 ← (x.accipe(1) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r2 ← (x.accipe(2) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r3 ← (x.accipe(3) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r4 ← (x.accipe(4) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r5 ← (x.accipe(5) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r6 ← (x.accipe(6) vel (0 ∷ numerus<u8>)) ↦ numerus
    redde r0 ∨ (r1 ⇐ 8) ∨ (r2 ⇐ 16) ∨ (r3 ⇐ 24) ∨ (r4 ⇐ 32) ∨ (r5 ⇐ 40) ∨ (r6 ⇐ 48) ∨ (r7 ⇐ 56)
}

@ privata
functio _texto(lista<numerus<u8>> b, numerus off, numerus len) → textus ⇥ GgufManifestError {
    fixum lista<numerus<u8>> x ← _slice(b, off, len)
    fixum octeti o ← x
    fac {
        redde o ↦ textus
    }
    cape err {
        iace finge WireMala { causa = "GGUF string is not valid UTF-8" }
    }
    iace finge WireMala { causa = "unreachable string conversion" }
}

@ privata
functio _stringa(lista<numerus<u8>> b, numerus off) → textus ⇥ GgufManifestError {
    fixum numerus len ← _u64(b, off)
    si len > TEXTUS_LIMES {
        iace finge LimitesMala { causa = "GGUF string exceeds the bounded text limit" }
    }
    redde _texto(b, off + 8, len)
}

@ privata
functio _u8val(lista<numerus<u8>> b, numerus off) → numerus ⇥ GgufManifestError {
    fixum lista<numerus<u8>> x ← _slice(b, off, 1)
    redde (x.accipe(0) vel (0 ∷ numerus<u8>)) ↦ numerus
}

@ privata
functio _scalar_magnitudo(numerus typo) → numerus {
    si typo ≡ GGUF_UINT8 aut typo ≡ GGUF_INT8 aut typo ≡ GGUF_BOOL ergo redde 1
    si typo ≡ GGUF_UINT16 aut typo ≡ GGUF_INT16 ergo redde 2
    si typo ≡ GGUF_UINT32 aut typo ≡ GGUF_INT32 aut typo ≡ GGUF_FLOAT32 ergo redde 4
    si typo ≡ GGUF_UINT64 aut typo ≡ GGUF_INT64 aut typo ≡ GGUF_FLOAT64 ergo redde 8
    redde 0
}

@ privata
functio _typo_validum(numerus typo) → bivalens {
    redde typo ≥ GGUF_UINT8 et typo ≤ GGUF_FLOAT64
}

# Returns the exact payload size for one typed GGUF value. For an array, the
# returned size includes its element-type and count headers and every nested
# element. No value bytes are retained here; the caller slices them once.
@ privata
functio _valor_magnitudo(lista<numerus<u8>> b, numerus off, numerus typo, numerus profunditas) → numerus ⇥ GgufManifestError {
    si profunditas > 64 {
        iace finge LimitesMala { causa = "metadata array nesting exceeds the bounded depth" }
    }
    fixum numerus scalar ← _scalar_magnitudo(typo)
    si scalar > 0 {
        si typo ≡ GGUF_BOOL {
            fixum numerus v ← _u8val(b, off)
            si v ≠ 0 et v ≠ 1 {
                iace finge WireMala { causa = "malformed GGUF bool value" }
            }
        }
        fixum lista<numerus<u8>> _ ← _slice(b, off, scalar)
        redde scalar
    }
    si typo ≡ GGUF_STRING {
        fixum numerus len ← _u64(b, off)
        si len > TEXTUS_LIMES {
            iace finge LimitesMala { causa = "GGUF string exceeds the bounded text limit" }
        }
        fixum numerus total ← _add(8, len)
        fixum lista<numerus<u8>> _ ← _slice(b, off, total)
        # Validate the bytes even though the exact wire is retained.
        fixum textus _ ← _texto(b, off + 8, len)
        redde total
    }
    si typo ≡ GGUF_ARRAY {
        fixum numerus caput ← _add(off, 12)
        si caput > b.longitudo() {
            iace finge Truncata { causa = "truncated GGUF array header" }
        }
        fixum numerus elementum_typo ← _u32(b, off)
        si non (_typo_validum(elementum_typo)) {
            iace finge WireMala { causa = "unknown GGUF array element type" }
        }
        fixum numerus n ← _u64(b, off + 4)
        si n > ARRAY_LIMES {
            iace finge LimitesMala { causa = "GGUF array count exceeds the bounded limit" }
        }
        varia numerus total ← 12
        varia numerus i ← 0
        dum i < n {
            fixum numerus part ← _valor_magnitudo(b, off + total, elementum_typo, profunditas + 1)
            total ← _add(total, part)
            i ← i + 1
        }
        fixum lista<numerus<u8>> _ ← _slice(b, off, total)
        redde total
    }
    iace finge WireMala { causa = "unknown GGUF metadata value type" }
}

# -------------------------------------------------------------------------
# Metadata and identity helpers.
# -------------------------------------------------------------------------

@ privata
functio _continet(lista<textus> xs, textus x) → bivalens {
    varia numerus i ← 0
    dum i < xs.longitudo() {
        si (xs.accipe(i) vel "") ≡ x ergo redde verum
        i ← i + 1
    }
    redde falsum
}

@ privata
functio _digestio_recta(textus digestio) → bivalens {
    si digestio.longitudo() ≠ 64 ergo redde falsum
    varia numerus i ← 0
    dum i < digestio.longitudo() {
        fixum textus c ← digestio.sectio(i, i + 1)
        si non (c ≡ "0" aut c ≡ "1" aut c ≡ "2" aut c ≡ "3" aut c ≡ "4" aut c ≡ "5" aut c ≡ "6" aut c ≡ "7" aut c ≡ "8" aut c ≡ "9" aut c ≡ "a" aut c ≡ "b" aut c ≡ "c" aut c ≡ "d" aut c ≡ "e" aut c ≡ "f") {
            redde falsum
        }
        i ← i + 1
    }
    redde verum
}

@ privata
functio _identitas_valet(artifact.IdentitasContenuti artifacti, numerus longitudo) → bivalens {
    redde artifacti.algorithmus ≡ "sha-256" et _digestio_recta(artifacti.digestio) et artifacti.longitudo ≡ longitudo et longitudo > 0
}

@ privata
functio _metadatum_inveni(lista<MetadatumGguf> xs, textus clavis) → MetadatumGguf ∪ nihil {
    itera ex xs fixum x {
        si x.clavis ≡ clavis ergo redde x
    }
    redde nihil
}

@ privata
functio _valor_u16(lista<numerus<u8>> b, numerus off) → numerus ⇥ GgufManifestError {
    fixum lista<numerus<u8>> x ← _slice(b, off, 2)
    redde ((x.accipe(0) vel (0 ∷ numerus<u8>)) ↦ numerus) ∨ (((x.accipe(1) vel (0 ∷ numerus<u8>)) ↦ numerus) ⇐ 8)
}

@ privata
functio _valor_i32(lista<numerus<u8>> b, numerus off) → numerus ⇥ GgufManifestError {
    fixum numerus raw ← _u32(b, off)
    si raw < 2147483648 ergo redde raw
    redde raw - 4294967296
}

@ privata
functio _valor_i64(lista<numerus<u8>> b, numerus off) → numerus ⇥ GgufManifestError {
    fixum lista<numerus<u8>> x ← _slice(b, off, 8)
    fixum numerus high ← (x.accipe(7) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r0 ← (x.accipe(0) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r1 ← (x.accipe(1) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r2 ← (x.accipe(2) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r3 ← (x.accipe(3) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r4 ← (x.accipe(4) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r5 ← (x.accipe(5) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r6 ← (x.accipe(6) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus lower ← r0 ∨ (r1 ⇐ 8) ∨ (r2 ⇐ 16) ∨ (r3 ⇐ 24) ∨ (r4 ⇐ 32) ∨ (r5 ⇐ 40) ∨ (r6 ⇐ 48) ∨ ((high % 128) ⇐ 56)
    si high < 128 ergo redde lower
    redde ((0 - MAX_NUMERUS) - 1) + lower
}

@ privata
functio _valor_u32(lista<numerus<u8>> b, numerus off) → numerus ⇥ GgufManifestError {
    redde _u32(b, off)
}

@ privata
functio _valor_u64(lista<numerus<u8>> b, numerus off) → numerus ⇥ GgufManifestError {
    redde _u64(b, off)
}

@ privata
functio _numerum_wire(MetadatumGguf m) → numerus ⇥ GgufManifestError {
    fixum lista<numerus<u8>> b ← _octeti_lista(m.valor_wire)
    si m.typo ≡ GGUF_UINT8 aut m.typo ≡ GGUF_BOOL ergo redde _u8val(b, 0)
    si m.typo ≡ GGUF_INT8 {
        fixum numerus raw ← _u8val(b, 0)
        si raw < 128 ergo redde raw
        redde raw - 256
    }
    si m.typo ≡ GGUF_UINT16 ergo redde _valor_u16(b, 0)
    si m.typo ≡ GGUF_INT16 {
        fixum numerus raw ← _valor_u16(b, 0)
        si raw < 32768 ergo redde raw
        redde raw - 65536
    }
    si m.typo ≡ GGUF_UINT32 ergo redde _valor_u32(b, 0)
    si m.typo ≡ GGUF_INT32 ergo redde _valor_i32(b, 0)
    si m.typo ≡ GGUF_UINT64 ergo redde _valor_u64(b, 0)
    si m.typo ≡ GGUF_INT64 ergo redde _valor_i64(b, 0)
    iace finge WireMala { causa = "metadata value is not an unsigned integer" }
}

@ privata
functio _valor_textus(MetadatumGguf m) → textus ⇥ GgufManifestError {
    si m.typo ≠ GGUF_STRING {
        iace finge WireMala { causa = "metadata value is not a GGUF string" }
    }
    fixum lista<numerus<u8>> b ← _octeti_lista(m.valor_wire)
    redde _stringa(b, 0)
}

# -------------------------------------------------------------------------
# GGML layout resolution.
# -------------------------------------------------------------------------

@ privata
functio _layout_blockum(numerus typo) → numerus {
    si typo ≡ GGML_F32 aut typo ≡ GGML_F16 aut typo ≡ GGML_I8 aut typo ≡ GGML_I16 aut typo ≡ GGML_I32 aut typo ≡ GGML_I64 aut typo ≡ GGML_F64 aut typo ≡ GGML_BF16 ergo redde 1
    si typo ≡ GGML_Q4_0 aut typo ≡ GGML_Q4_1 aut typo ≡ GGML_Q5_0 aut typo ≡ GGML_Q5_1 aut typo ≡ GGML_Q8_0 aut typo ≡ GGML_Q8_1 aut typo ≡ GGML_IQ4_NL ergo redde 32
    si typo ≡ GGML_Q2_K aut typo ≡ GGML_Q3_K aut typo ≡ GGML_Q4_K aut typo ≡ GGML_Q5_K aut typo ≡ GGML_Q6_K aut typo ≡ GGML_Q8_K ergo redde 256
    redde 0
}

@ privata
functio _layout_octeti(numerus typo) → numerus {
    si typo ≡ GGML_F32 aut typo ≡ GGML_I32 ergo redde 4
    si typo ≡ GGML_F16 aut typo ≡ GGML_I16 aut typo ≡ GGML_BF16 ergo redde 2
    si typo ≡ GGML_I8 ergo redde 1
    si typo ≡ GGML_I64 aut typo ≡ GGML_F64 ergo redde 8
    si typo ≡ GGML_Q4_0 ergo redde 18
    si typo ≡ GGML_Q4_1 ergo redde 20
    si typo ≡ GGML_Q5_0 ergo redde 22
    si typo ≡ GGML_Q5_1 ergo redde 24
    si typo ≡ GGML_Q8_0 ergo redde 34
    si typo ≡ GGML_Q8_1 ergo redde 36
    si typo ≡ GGML_Q2_K ergo redde 84
    si typo ≡ GGML_Q3_K ergo redde 110
    si typo ≡ GGML_Q4_K ergo redde 144
    si typo ≡ GGML_Q5_K ergo redde 176
    si typo ≡ GGML_Q6_K ergo redde 210
    si typo ≡ GGML_Q8_K ergo redde 292
    si typo ≡ GGML_IQ4_NL ergo redde 18
    redde 0
}

@ privata
functio _elementa(lista<numerus> forma) → numerus ⇥ GgufManifestError {
    varia numerus total ← 1
    itera ex forma fixum dim {
        si dim ≤ 0 aut dim > DIMENSI_LIMES {
            iace finge LimitesMala { causa = "tensor dimension is outside the bounded range" }
        }
        si total > ELEMENTA_LIMES / dim {
            iace finge LimitesMala { causa = "tensor element count exceeds the bounded range" }
        }
        total ← total * dim
    }
    redde total
}

functio layout(numerus typo_ggml, lista<numerus> forma) → LayoutGgml ⇥ GgufManifestError {
    si forma.longitudo() ≡ 0 {
        iace finge LimitesMala { causa = "tensor rank must be at least one" }
    }
    fixum numerus elementa ← _elementa(forma)
    fixum numerus elementa_per_blockum ← _layout_blockum(typo_ggml)
    si elementa_per_blockum ≡ 0 {
        redde finge Ignota { typo = typo_ggml }
    }
    fixum numerus octeti_per_blockum ← _layout_octeti(typo_ggml)
    fixum numerus prima_dimensio ← forma.accipe(0) vel 0
    si prima_dimensio % elementa_per_blockum ≠ 0 {
        iace finge OffsetMala { causa = "tensor first dimension is not a complete GGML block" }
    }
    fixum numerus blocci ← elementa / elementa_per_blockum
    fixum numerus longitudo ← _mul(blocci, octeti_per_blockum)
    redde finge Cognita {
        elementa_per_blockum = elementa_per_blockum,
        octeti_per_blockum = octeti_per_blockum,
        longitudo_octetorum = longitudo
    }
}

# -------------------------------------------------------------------------
# Public accessors.
# -------------------------------------------------------------------------

functio metadatum(ManifestumGguf m, textus clavis) → MetadatumGguf ⇥ GgufManifestError {
    fixum MetadatumGguf ∪ nihil found ← _metadatum_inveni(m.metadata, clavis)
    si found non est nihil ergo redde found vel MetadatumGguf { clavis = "", typo = -1, valor_wire = || }
    iace finge WireMala { causa = "metadata key not found: " + clavis }
}

functio textum(ManifestumGguf m, textus clavis) → textus ⇥ GgufManifestError {
    fixum MetadatumGguf x ← metadatum(m, clavis)
    redde _valor_textus(x)
}

functio numerum(ManifestumGguf m, textus clavis) → numerus ⇥ GgufManifestError {
    fixum MetadatumGguf x ← metadatum(m, clavis)
    redde _numerum_wire(x)
}

functio inveni_tensorem(ManifestumGguf m, textus nomen) → DescriptioTensorisGguf ⇥ GgufManifestError {
    itera ex m.tensores fixum t {
        si t.nomen ≡ nomen ergo redde t
    }
    iace finge WireMala { causa = "tensor not found: " + nomen }
}

# -------------------------------------------------------------------------
# Manifest parser.
# -------------------------------------------------------------------------

@ privata
functio _align(numerus value, numerus alignment) → numerus ⇥ GgufManifestError {
    fixum numerus remainder ← value % alignment
    si remainder ≡ 0 ergo redde value
    redde _add(value, alignment - remainder)
}

@ privata
functio _potentia_duorum(numerus value) → bivalens {
    si value ≤ 0 ergo redde falsum
    varia numerus x ← value
    dum x % 2 ≡ 0 {
        x ← x / 2
    }
    redde x ≡ 1
}

functio parse(CorpusGguf corpus) → ManifestumGguf ⇥ GgufManifestError {
    # Check the caller-owned prefix before copying it into the parser's list
    # representation; otherwise an oversized octet corpus would already have
    # amplified memory before the bounded parser could reject it.
    si corpus.tabula.longitudo() > CORPUS_LIMES {
        iace finge LimitesMala { causa = "bounded GGUF corpus exceeds the 64 MiB parser limit" }
    }
    fixum lista<numerus<u8>> b ← _octeti_lista(corpus.tabula)
    fixum numerus total ← corpus.longitudo_artifacti
    si total ≤ 0 aut corpus.identitas.longitudo ≠ total aut non (_identitas_valet(corpus.identitas, total)) {
        iace finge IdentitasMala { causa = "content identity does not match the supplied artifact length" }
    }
    si b.longitudo() < 24 {
        iace finge Truncata { causa = "truncated GGUF header" }
    }
    fixum numerus m0 ← _u8val(b, 0)
    fixum numerus m1 ← _u8val(b, 1)
    fixum numerus m2 ← _u8val(b, 2)
    fixum numerus m3 ← _u8val(b, 3)
    si m0 ≠ MAGIC_0 aut m1 ≠ MAGIC_1 aut m2 ≠ MAGIC_2 aut m3 ≠ MAGIC_3 {
        iace finge FormatMala { causa = "not a GGUF file — bad magic" }
    }
    fixum numerus versio ← _u32(b, 4)
    si versio ≠ GGUF_VERSION {
        iace finge VersioIgnota { causa = "unsupported GGUF version: " + (versio ↦ textus) }
    }
    fixum numerus tensorum ← _u64(b, 8)
    fixum numerus kv_num ← _u64(b, 16)
    si tensorum > TENSORUM_LIMES aut kv_num > KV_LIMES {
        iace finge LimitesMala { causa = "GGUF count exceeds the bounded limit" }
    }

    varia numerus cursor ← 24
    varia lista<MetadatumGguf> metadata ← vacua
    varia lista<textus> claves ← vacua
    varia numerus i ← 0
    dum i < kv_num {
        fixum numerus key_len ← _u64(b, cursor)
        si key_len > NOMEN_LIMES {
            iace finge LimitesMala { causa = "metadata key exceeds the bounded length" }
        }
        fixum textus key ← _texto(b, cursor + 8, key_len)
        si _continet(claves, key) {
            iace finge ClavisDuplicata { causa = "duplicate GGUF metadata key: " + key }
        }
        claves.appende(key)
        cursor ← _add(cursor, 8 + key_len)
        fixum numerus typo ← _u32(b, cursor)
        si non (_typo_validum(typo)) {
            iace finge WireMala { causa = "unknown GGUF metadata value type" }
        }
        cursor ← _add(cursor, 4)
        fixum numerus value_start ← cursor
        fixum numerus value_len ← _valor_magnitudo(b, value_start, typo, 0)
        fixum lista<numerus<u8>> value_bytes ← _slice(b, value_start, value_len)
        metadata.appende(MetadatumGguf {
            clavis = key,
            typo = typo,
            valor_wire = _octeti_ex_lista(value_bytes)
        })
        cursor ← _add(cursor, value_len)
        i ← i + 1
    }

    varia numerus concordatio ← DEFAULT_ALIGNMENT
    fixum MetadatumGguf ∪ nihil alignment_meta ← _metadatum_inveni(metadata, "general.alignment")
    si alignment_meta non est nihil {
        si (alignment_meta vel MetadatumGguf { clavis = "", typo = -1, valor_wire = || }).typo ≠ GGUF_UINT32 {
            iace finge WireMala { causa = "general.alignment must use GGUF UINT32 wire kind" }
        }
        fixum numerus alignment ← _numerum_wire(alignment_meta vel MetadatumGguf { clavis = "", typo = -1, valor_wire = || })
        si alignment ≤ 0 aut alignment > 4294967295 aut non (_potentia_duorum(alignment)) {
            iace finge WireMala { causa = "general.alignment must be a positive power of two" }
        }
        concordatio ← alignment
    }

    varia lista<DescriptioTensorisGguf> tensores ← vacua
    varia lista<textus> nomina ← vacua
    varia lista<numerus> initia ← vacua
    varia lista<numerus> fines ← vacua
    varia lista<bivalens> notae ← vacua
    varia numerus t ← 0
    dum t < tensorum {
        fixum numerus name_len ← _u64(b, cursor)
        si name_len > NOMEN_LIMES {
            iace finge LimitesMala { causa = "tensor name exceeds the bounded length" }
        }
        fixum textus name ← _texto(b, cursor + 8, name_len)
        si name.longitudo() ≡ 0 {
            iace finge WireMala { causa = "empty tensor name" }
        }
        si _continet(nomina, name) {
            iace finge TensorDuplicatum { causa = "duplicate GGUF tensor name: " + name }
        }
        nomina.appende(name)
        cursor ← _add(cursor, 8 + name_len)
        fixum numerus rank ← _u32(b, cursor)
        cursor ← _add(cursor, 4)
        si rank ≡ 0 {
            iace finge LimitesMala { causa = "tensor rank must be at least one" }
        }
        si rank > RANK_LIMES {
            iace finge LimitesMala { causa = "tensor rank exceeds the bounded limit" }
        }
        varia lista<numerus> forma ← vacua
        varia numerus d ← 0
        dum d < rank {
            fixum numerus dim ← _u64(b, cursor)
            si dim ≤ 0 aut dim > DIMENSI_LIMES {
                iace finge LimitesMala { causa = "tensor dimension is outside the bounded range" }
            }
            forma.appende(dim)
            cursor ← _add(cursor, 8)
            d ← d + 1
        }
        fixum numerus typo_ggml ← _u32(b, cursor)
        cursor ← _add(cursor, 4)
        fixum numerus offset ← _u64(b, cursor)
        cursor ← _add(cursor, 8)
        fixum numerus elementa ← _elementa(forma)
        fixum LayoutGgml lay ← layout(typo_ggml, forma)
        discerne lay {
            casu Cognita fixum elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
                initia.appende(offset)
                fines.appende(longitudo_octetorum)
                notae.appende(verum)
            }
            casu Ignota fixum typo {
                initia.appende(offset)
                fines.appende(0)
                notae.appende(falsum)
            }
        }
        tensores.appende(DescriptioTensorisGguf {
            nomen = name,
            forma = forma,
            typo_ggml = typo_ggml,
            offset_relativum = offset,
            elementa = elementa,
            layout = lay
        })
        t ← t + 1
    }

    fixum numerus data_inceptum ← _align(cursor, concordatio)
    si data_inceptum > total {
        iace finge OffsetMala { causa = "GGUF data section begins beyond the artifact" }
    }
    si b.longitudo() > data_inceptum {
        iace finge Superfluitas { causa = "bounded GGUF corpus contains bytes from the data region" }
    }

    # Convert known relative ranges to checked absolute ranges. Unknown raw
    # types remain inspectable and intentionally have no materialized length.
    varia lista<numerus> abs_initia ← vacua
    varia lista<numerus> abs_fines ← vacua
    varia numerus q ← 0
    dum q < tensores.longitudo() {
        fixum numerus raw_offset ← initia.accipe(q) vel 0
        fixum numerus raw_start ← _add(data_inceptum, raw_offset)
        si raw_start > total {
            iace finge OffsetMala { causa = "GGML tensor offset exceeds the artifact" }
        }
        si notae.accipe(q) vel falsum {
            fixum numerus start ← raw_start
            fixum numerus len ← fines.accipe(q) vel 0
            fixum numerus finish ← _add(start, len)
            si finish > total {
                iace finge OffsetMala { causa = "known GGML tensor range exceeds the artifact" }
            }
            abs_initia.appende(start)
            abs_fines.appende(finish)
        }
        q ← q + 1
    }
    varia numerus a ← 0
    dum a < abs_initia.longitudo() {
        varia numerus z ← a + 1
        dum z < abs_initia.longitudo() {
            fixum numerus ai ← abs_initia.accipe(a) vel 0
            fixum numerus bi ← abs_fines.accipe(a) vel 0
            fixum numerus aj ← abs_initia.accipe(z) vel 0
            fixum numerus bj ← abs_fines.accipe(z) vel 0
            si bi > aj et bj > ai {
                iace finge OffsetMala { causa = "known GGML tensor ranges overlap" }
            }
            z ← z + 1
        }
        a ← a + 1
    }

    redde ManifestumGguf {
        identitas = corpus.identitas,
        versio = versio,
        concordatio = concordatio,
        data_inceptum = data_inceptum,
        longitudo_artifacti = total,
        metadata = metadata,
        tensores = tensores
    }
}
