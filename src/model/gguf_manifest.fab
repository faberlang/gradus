+++
locale = "en"
+++
# GGUF v3 format-general manifest parser and pathless range seam (GGUF-A1b).
#
# Public import: import from "gradus:model/gguf_manifest" gguf_manifest
# Depends on: gradus:model/artifact (pathless content identity),
# gradus:storage (open representation and block metadata).
#
# `parse` consumes a bounded header/metadata/tensor-table corpus. `inspect`
# obtains that same table incrementally from a caller-owned range function and
# never retains the function or source bytes. `read_fragment` obtains only a
# checked tensor subrange. Neither operation retains a path, URL, reader, file
# handle, mapping, device object, or payload. `payload_wire` is the exact encoded
# GGUF value payload, beginning at the value's first byte and ending after its
# own length-prefixed content. Each tensor descriptor also carries an open
# storage representation and separate block metadata. The legacy `layout`
# union remains a geometry projection for existing consumers; it is not the
# representation identity and unknown codes are preserved in full.

import from "gradus:model/artifact" artifact

import from "gradus:storage" storage

# GGUF v3 wire value kinds (gguf.h enum gguf_type).
const int GGUF_UINT8 = 0

const int GGUF_INT8 = 1

const int GGUF_UINT16 = 2

const int GGUF_INT16 = 3

const int GGUF_UINT32 = 4

const int GGUF_INT32 = 5

const int GGUF_FLOAT32 = 6

const int GGUF_BOOL = 7

const int GGUF_STRING = 8

const int GGUF_ARRAY = 9

const int GGUF_UINT64 = 10

const int GGUF_INT64 = 11

const int GGUF_FLOAT64 = 12

# GGML storage ids and block geometry. The table covers the ordinary GGUF
# scalar, integer, BF16, and K-quant rows seen in current Hub artifacts. A
# valid but unlisted id stays inspectable as GgmlLayout.Unknown.
const int GGML_F32 = 0

const int GGML_F16 = 1

const int GGML_Q4_0 = 2

const int GGML_Q4_1 = 3

const int GGML_Q5_0 = 6

const int GGML_Q5_1 = 7

const int GGML_Q8_0 = 8

const int GGML_Q8_1 = 9

const int GGML_Q2_K = 10

const int GGML_Q3_K = 11

const int GGML_Q4_K = 12

const int GGML_Q5_K = 13

const int GGML_Q6_K = 14

const int GGML_Q8_K = 15

const int GGML_IQ4_NL = 20

const int GGML_I8 = 24

const int GGML_I16 = 25

const int GGML_I32 = 26

const int GGML_I64 = 27

const int GGML_F64 = 28

const int GGML_BF16 = 30

@ public
const int GGUF_VERSION = 3

const int DEFAULT_ALIGNMENT = 32

# The ASCII bytes of "GGUF".
const list<u8> MAGIC = [71, 71, 85, 70]

# Powers of two a GGUF alignment may take (the u32 domain `general.alignment`
# is bounded to).
const list<int> ALIGNMENTS = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384, 32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4194304, 8388608, 16777216, 33554432, 67108864, 134217728, 268435456, 536870912, 1073741824, 2147483648]

# Bounds protect the parser from count/length-driven allocation or loops.
# Duplicate-key/name checks use hash sets and the known-range overlap check
# sorts the ranges once. The 4,096-entry ceilings keep that work finite while
# admitting every inventoried local model (55 metadata entries and at most 753
# tensors). The 64 MiB corpus ceiling bounds the
# retained header/table copy; the full model payload is never supplied here.
const int KV_LIMIT = 4096

const int TENSOR_LIMIT = 4096

const int CORPUS_LIMIT = 67108864

const int NAME_LIMIT = 4096

const int TEXT_LIMIT = 1048576

const int ARRAY_LIMIT = 1048576

const int RANK_LIMIT = 64

const int MAX_NUMBER = 9223372036854775807

@ public
union GgufManifestError {
    @ shared
    string message

    BadFormat,
    UnknownVersion,
    Truncated,
    BadWire,
    BadBounds,
    Surplus,
    DuplicateKey,
    DuplicateTensor,
    BadOffset,
    UnknownLayout,
    BadIdentity,
    BadSource,
    NotFound
}

@ public
class GgufCorpus {
    mut list<b8> table
    mut int artifact_length
    mut artifact.ContentIdentity identity
}

# A range source is (int, int) → list<b8> ⇥ GgufManifestError. Success
# returns the exact requested window; throw is the typed failure channel.

@ public
class GgufMetadata {
    mut string key
    mut int dtype
    mut list<b8> payload_wire
}

@ public
union GgmlLayout {
    Known {
        int elements_per_block
        int bytes_per_block
        int byte_length
    },
    Unknown {
        int dtype
    }
}

@ public
class GgufTensorDescriptor {
    mut string name
    mut list<int> shape
    mut int dtype_ggml
    mut storage.Representation representation
    mut int relative_offset
    mut int elements
    mut GgmlLayout layout
    mut storage.BlockMetadata block
}

@ public
class GgufManifest {
    mut artifact.ContentIdentity identity
    mut int version
    mut int alignment
    mut int data_start
    mut int artifact_length
    mut list<GgufMetadata> metadata
    mut list<GgufTensorDescriptor> tensors
}

# One known tensor's absolute byte range, for the overlap check.
class DataRange {
    mut int start
    mut int end
}

# -------------------------------------------------------------------------
# Basic byte and checked-arithmetic helpers.
# -------------------------------------------------------------------------

fn byte_list(list<b8> o) → list<u8> {
    # One representation change, not a per-byte loop: the interpreter step
    # count of a whole-header parse depends on this staying O(1) statements.
    return o ↦ list<u8>
}

fn byte_from_list(list<u8> b) → list<b8> {
    return b ↦ list<b8>
}

fn add(int a, int b) → int ⇥ GgufManifestError {
    reject a ≺ 0 or b ≺ 0 or a ≻ MAX_NUMBER - b throw variant BadBounds { message = "checked offset addition overflow" }
    return a + b
}

fn mul(int a, int b) → int ⇥ GgufManifestError {
    reject a ≺ 0 or b ≺ 0 or b ≢ 0 and a ≻ MAX_NUMBER / b throw variant BadBounds { message = "checked length multiplication overflow" }
    return a * b
}

# Validate that `len` bytes at `off` lie inside `b`; returns the exclusive end.
# Copies nothing: callers that only need the bounds check (or read a few
# bytes) use this instead of `slice`.
fn check_range(list<u8> b, int off, int len) → int ⇥ GgufManifestError {
    reject off ≺ 0 or len ≺ 0 throw variant BadBounds { message = "negative byte range" }
    let int end ← add(off, len)
    require end ≤ b.length() throw variant Truncated { message = "bounded GGUF corpus ends before the required field" }
    return end
}

fn slice(list<u8> b, int off, int len) → list<u8> ⇥ GgufManifestError {
    let int end ← check_range(b, off, len)
    return b[off‥end]
}

# A source read is deliberately a function value, not a field of any public
# semantic value. The caller chooses the adapter and supplies it anew for
# each operation. The callback throws GgufManifestError (typically BadSource)
# so an application boundary can map an OS/provider diagnostic without
# importing that provider into Gradus.
fn read_source((int, int) → list<b8> ⇥ GgufManifestError source, int total, int start, int length) → list<b8> ⇥ GgufManifestError {
    reject total ≤ 0 or start ≺ 0 or length ≺ 0 throw variant BadSource { message = "range source received an invalid range" }
    require length ≤ CORPUS_LIMIT throw variant BadBounds { message = "range source request exceeds the 64 MiB read limit" }
    let int end ← add(start, length)
    require end ≤ total throw variant BadOffset { message = "range source request exceeds the artifact" }
    let list<b8> chunk ← source(start, length)
    require chunk.length() ≡ length throw variant BadSource { message = "range source returned an unexpected byte length" }
    return chunk
}

# Fixed-width little-endian reads. Each checks its range, then unpacks one
# exact byte window with the language's endian conversion. The `decode_*`
# forms take a window of exactly the field width (a range source returns the
# exact window, the list forms slice one after `check_range`); a window of any
# other width is a typed error, never a default value.
fn decode_u32(list<b8> window) → int ⇥ GgufManifestError {
    do {
        return window ↦ u32 via Le ↦ int
    }
    catch err {
        throw variant BadWire { message = "GGUF u32 field is not four bytes" }
    }
}

fn decode_u64(list<b8> window) → int ⇥ GgufManifestError {
    do {
        return window ↦ u64 via Le ↦ int
    }
    catch err {
        throw variant BadBounds { message = "GGUF UINT64 value exceeds the numeric carrier" }
    }
}

fn u32(list<u8> b, int off) → int ⇥ GgufManifestError {
    let int end ← check_range(b, off, 4)
    return decode_u32(b[off‥end] ↦ list<b8>)
}

fn u64(list<u8> b, int off) → int ⇥ GgufManifestError {
    let int end ← check_range(b, off, 8)
    return decode_u64(b[off‥end] ↦ list<b8>)
}

fn text_wire(list<b8> o) → string ⇥ GgufManifestError {
    do {
        return o ↦ string
    }
    catch err {
        throw variant BadWire { message = "GGUF string is not valid UTF-8" }
    }
}

fn text_at(list<u8> b, int off, int len) → string ⇥ GgufManifestError {
    let int end ← check_range(b, off, len)
    let list<b8> o ← b[off‥end] ↦ list<b8>
    return text_wire(o)
}

fn string_at(list<u8> b, int off) → string ⇥ GgufManifestError {
    let int len ← u64(b, off)
    require len ≤ TEXT_LIMIT throw variant BadBounds { message = "GGUF string exceeds the bounded text limit" }
    return text_at(b, off + 8, len)
}

fn u8_value(list<u8> b, int off) → int ⇥ GgufManifestError {
    check_range(b, off, 1)
    return b[off] ↦ int
}

fn scalar_size(int kind) → int {
    if kind ∈ [GGUF_UINT8, GGUF_INT8, GGUF_BOOL] then return 1
    if kind ∈ [GGUF_UINT16, GGUF_INT16] then return 2
    if kind ∈ [GGUF_UINT32, GGUF_INT32, GGUF_FLOAT32] then return 4
    if kind ∈ [GGUF_UINT64, GGUF_INT64, GGUF_FLOAT64] then return 8
    return 0
}

fn dtype_valid(int kind) → bool {
    return kind ≥ GGUF_UINT8 and kind ≤ GGUF_FLOAT64
}

# Read one metadata value from its absolute wire offset. The result contains
# exactly that value's wire bytes. Arrays recurse over their declared element
# type, but no cumulative header/table prefix is copied or retained.
fn source_value((int, int) → list<b8> ⇥ GgufManifestError source, int total, int off, int kind, int depth) → list<b8> ⇥ GgufManifestError {
    # --- bounds + kind (fail closed) --------------------------------------
    require depth ≤ 64 throw variant BadBounds { message = "metadata array nesting exceeds the bounded depth" }
    require dtype_valid(kind) throw variant BadWire { message = "unknown GGUF metadata value type" }
    let int scalar ← scalar_size(kind)
    if scalar ≻ 0 {
        # --- scalar wire (exact read) -------------------------------------
        let list<b8> wire ← read_source(source, total, off, scalar)
        size_value(byte_list(wire), 0, kind, depth)
        return wire
    }
    if kind ≡ GGUF_STRING {
        # --- string wire (length header + corpus) -------------------------
        let list<b8> header ← read_source(source, total, off, 8)
        let int len ← decode_u64(header)
        require len ≤ TEXT_LIMIT throw variant BadBounds { message = "GGUF string exceeds the bounded text limit" }
        # The language has no bulk `bytes` concatenation, so the whole value
        # (length header + body) is one exact read instead of two reads joined.
        let list<b8> wire ← read_source(source, total, off, add(8, len))
        text_wire(wire[8‥add(8, len)])
        return wire
    }
    if kind ≡ GGUF_ARRAY {
        # --- array wire (element kind + count) ----------------------------
        let list<b8> header ← read_source(source, total, off, 12)
        let list<u8> header_list ← byte_list(header)
        let int element_kind ← u32(header_list, 0)
        require dtype_valid(element_kind) throw variant BadWire { message = "unknown GGUF array element type" }
        let int n ← u64(header_list, 4)
        require n ≤ ARRAY_LIMIT throw variant BadBounds { message = "GGUF array count exceeds the bounded limit" }
        let int element_scalar ← scalar_size(element_kind)
        if element_scalar ≻ 0 {
            # --- scalar element array (bulk read) -------------------------
            let int length ← mul(n, element_scalar)
            let list<b8> out ← read_source(source, total, off, add(12, length))
            size_value(byte_list(out), 0, kind, depth)
            return out
        }
        if element_kind ≡ GGUF_STRING {
            # --- string element array (scan → exact read) -----------------
            mut int cursor ← add(off, 12)
            for range 0 ‥ n let i {
                let list<b8> item_head ← read_source(source, total, cursor, 8)
                let int len ← decode_u64(item_head)
                require len ≤ TEXT_LIMIT throw variant BadBounds { message = "GGUF string exceeds the bounded text limit" }
                cursor ← add(cursor, add(8, len))
            }
            let int total_wire ← cursor - off
            # One exact source read preserves the full tokenizer array without
            # copying each growing element through Faber. The bounded scanner
            # above establishes its exact end before this read is issued.
            let list<b8> wire ← read_source(source, total, off, total_wire)
            size_value(byte_list(wire), 0, kind, depth)
            return wire
        }

        # --- nested element array (recursive reads) -----------------------
        mut list<b8> out ← copy header
        mut int cursor ← add(off, 12)
        for range 0 ‥ n let i {
            let list<b8> item ← source_value(source, total, cursor, element_kind, depth + 1)
            # Append in place. Passing the growing accumulator through the
            # helper would copy it once per element and turn large tokenizer
            # string arrays quadratic. Nested arrays are not a real GGUF
            # shape, and the language has no bulk `bytes` concatenation.
            out.extend(item)
            cursor ← add(cursor, item.length())
        }
        return out
    }
    throw variant BadWire { message = "unknown GGUF metadata value type" }
}

# Size of a validated string array (length-prefixed UTF-8 elements): the
# per-element u64 length, text-limit, range and UTF-8 checks of `size_value`
# for a string, inlined into one loop. Returns the array's total wire size.
fn string_array_size(list<u8> b, int off, int n) → int ⇥ GgufManifestError {
    let int blen ← b.length()
    mut int pos ← off + 12
    for range 0 ‥ n let i {
        require pos + 8 ≤ blen throw variant Truncated { message = "bounded GGUF corpus ends before the required field" }
        let int len ← decode_u64(b[pos‥pos + 8] ↦ list<b8>)
        require len ≤ TEXT_LIMIT throw variant BadBounds { message = "GGUF string exceeds the bounded text limit" }
        let int next ← pos + 8 + len
        require next ≤ blen throw variant Truncated { message = "bounded GGUF corpus ends before the required field" }
        let list<b8> body ← b[pos + 8‥next] ↦ list<b8>
        text_wire(body)
        pos ← next
    }
    return pos - off
}

# Returns the exact payload size for one typed GGUF value. For an array, the
# returned size includes its element-type and count headers and every nested
# element. No value bytes are retained here; the caller slices them once.
fn size_value(list<u8> b, int off, int kind, int depth) → int ⇥ GgufManifestError {
    # --- bounds + kind (fail closed) --------------------------------------
    require depth ≤ 64 throw variant BadBounds { message = "metadata array nesting exceeds the bounded depth" }
    let int scalar ← scalar_size(kind)
    if scalar ≻ 0 {
        # --- scalar wire (BOOL validated) ---------------------------------
        if kind ≡ GGUF_BOOL {
            let int v ← u8_value(b, off)
            reject v ≢ 0 and v ≢ 1 throw variant BadWire { message = "malformed GGUF bool value" }
        }
        check_range(b, off, scalar)
        return scalar
    }
    if kind ≡ GGUF_STRING {
        # --- string wire (length + UTF-8 check) ---------------------------
        let int len ← u64(b, off)
        require len ≤ TEXT_LIMIT throw variant BadBounds { message = "GGUF string exceeds the bounded text limit" }
        let int total ← add(8, len)
        check_range(b, off, total)
        text_at(b, off + 8, len)
        return total
    }
    if kind ≡ GGUF_ARRAY {
        # --- array wire (element size recursion) --------------------------
        let int header ← add(off, 12)
        require header ≤ b.length() throw variant Truncated { message = "truncated GGUF array header" }
        let int element_kind ← u32(b, off)
        require dtype_valid(element_kind) throw variant BadWire { message = "unknown GGUF array element type" }
        let int n ← u64(b, off + 4)
        require n ≤ ARRAY_LIMIT throw variant BadBounds { message = "GGUF array count exceeds the bounded limit" }
        mut int total ← 12
        let int element_scalar ← scalar_size(element_kind)
        if n ≻ 0 and (element_kind ≡ GGUF_STRING or (element_scalar ≻ 0 and element_kind ≢ GGUF_BOOL)) {
            # Flat arrays: the same checks as the per-element recursion below,
            # in the same order, without one call per element. The element
            # depth check applies only when there is a first element.
            require depth + 1 ≤ 64 throw variant BadBounds { message = "metadata array nesting exceeds the bounded depth" }
            if element_kind ≡ GGUF_STRING {
                return string_array_size(b, off, n)
            }
            let int body ← n * element_scalar
            check_range(b, off + 12, body)
            total ← add(12, body)
            check_range(b, off, total)
            return total
        }
        for range 0 ‥ n let i {
            let int part ← size_value(b, off + total, element_kind, depth + 1)
            total ← add(total, part)
        }
        check_range(b, off, total)
        return total
    }
    throw variant BadWire { message = "unknown GGUF metadata value type" }
}

# -------------------------------------------------------------------------
# Metadata and identity helpers.
# -------------------------------------------------------------------------

# Whether `digest` is exactly 64 lowercase hex characters.
fn digest_ok(string digest) → bool {
    let list<u32> scalars ← digest ↦ list<b32> ↦ list<u32>
    return scalars.length() ≡ 64 and scalars.all((u32 c) → bool ∴ (c ≥ 48 and c ≤ 57) or (c ≥ 97 and c ≤ 102))
}

fn identity_valid(artifact.ContentIdentity artifact, int length) → bool {
    return artifact.algorithm ≡ "sha-256" and digest_ok(artifact.digest) and artifact.length ≡ length and length ≻ 0
}

fn find_metadata(list<GgufMetadata> xs, string key) → GgufMetadata ∪ none {
    for from xs let x {
        if x.key ≡ key then return x
    }
    return null
}

fn value_u16(list<u8> b, int off) → int ⇥ GgufManifestError {
    let int end ← check_range(b, off, 2)
    do {
        return b[off‥end] ↦ list<b8> ↦ u16 via Le ↦ int
    }
    catch err {
        throw variant BadWire { message = "GGUF u16 field is not two bytes" }
    }
}

fn value_i32(list<u8> b, int off) → int ⇥ GgufManifestError {
    let int raw ← u32(b, off)
    if raw ≺ 2147483648 then return raw
    return raw - 4294967296
}

fn value_i64(list<u8> b, int off) → int ⇥ GgufManifestError {
    let int end ← check_range(b, off, 8)
    do {
        return b[off‥end] ↦ list<b8> ↦ i64 via Le ↦ int
    }
    catch err {
        throw variant BadWire { message = "GGUF i64 field is not eight bytes" }
    }
}

fn value_u32(list<u8> b, int off) → int ⇥ GgufManifestError {
    return u32(b, off)
}

fn value_u64(list<u8> b, int off) → int ⇥ GgufManifestError {
    return u64(b, off)
}

fn scalar_count(list<u8> b, int off, int kind) → int ⇥ GgufManifestError {
    # BOOL remains valid and preserved in payload_wire, but is not an integer
    # accessor value; callers receive BadWire instead.
    if kind ≡ GGUF_UINT8 then return u8_value(b, off)
    if kind ≡ GGUF_INT8 {
        let int raw ← u8_value(b, off)
        if raw ≺ 128 then return raw
        return raw - 256
    }
    if kind ≡ GGUF_UINT16 then return value_u16(b, off)
    if kind ≡ GGUF_INT16 {
        let int raw ← value_u16(b, off)
        if raw ≺ 32768 then return raw
        return raw - 65536
    }
    if kind ≡ GGUF_UINT32 then return value_u32(b, off)
    if kind ≡ GGUF_INT32 then return value_i32(b, off)
    if kind ≡ GGUF_UINT64 then return value_u64(b, off)
    if kind ≡ GGUF_INT64 then return value_i64(b, off)
    throw variant BadWire { message = "metadata value is not an unsigned integer" }
}

fn wire_count(GgufMetadata m) → int ⇥ GgufManifestError {
    let list<u8> b ← byte_list(m.payload_wire)
    return scalar_count(b, 0, m.dtype)
}

fn text_value(GgufMetadata m) → string ⇥ GgufManifestError {
    require m.dtype ≡ GGUF_STRING throw variant BadWire { message = "metadata value is not a GGUF string" }
    let list<u8> b ← byte_list(m.payload_wire)
    return string_at(b, 0)
}

# -------------------------------------------------------------------------
# GGML layout resolution.
# -------------------------------------------------------------------------

fn block_layout(int kind) → int {
    if kind ∈ [GGML_F32, GGML_F16, GGML_I8, GGML_I16, GGML_I32, GGML_I64, GGML_F64, GGML_BF16] then return 1
    if kind ∈ [GGML_Q4_0, GGML_Q4_1, GGML_Q5_0, GGML_Q5_1, GGML_Q8_0, GGML_Q8_1, GGML_IQ4_NL] then return 32
    if kind ∈ [GGML_Q2_K, GGML_Q3_K, GGML_Q4_K, GGML_Q5_K, GGML_Q6_K, GGML_Q8_K] then return 256
    return 0
}

fn byte_layout(int kind) → int {
    if kind ∈ [GGML_F32, GGML_I32] then return 4
    if kind ∈ [GGML_F16, GGML_I16, GGML_BF16] then return 2
    if kind ≡ GGML_I8 then return 1
    if kind ∈ [GGML_I64, GGML_F64] then return 8
    if kind ∈ [GGML_Q4_0, GGML_IQ4_NL] then return 18
    if kind ≡ GGML_Q4_1 then return 20
    if kind ≡ GGML_Q5_0 then return 22
    if kind ≡ GGML_Q5_1 then return 24
    if kind ≡ GGML_Q8_0 then return 34
    if kind ≡ GGML_Q8_1 then return 36
    if kind ≡ GGML_Q2_K then return 84
    if kind ≡ GGML_Q3_K then return 110
    if kind ≡ GGML_Q4_K then return 144
    if kind ≡ GGML_Q5_K then return 176
    if kind ≡ GGML_Q6_K then return 210
    if kind ≡ GGML_Q8_K then return 292
    return 0
}

fn element_count(list<int> shape) → int ⇥ GgufManifestError {
    mut int total ← 1
    for from shape let dim {
        reject dim ≤ 0 throw variant BadBounds { message = "tensor dimension must be positive" }
        require total ≤ MAX_NUMBER / dim throw variant BadBounds { message = "tensor element count exceeds the numeric range" }
        total ← total * dim
    }
    return total
}

@ public
fn layout(int ggml_dtype, list<int> shape) → GgmlLayout ⇥ GgufManifestError {
    # --- rank + element count (fail closed) -------------------------------
    require shape.length() ≢ 0 throw variant BadBounds { message = "tensor rank must be at least one" }
    let int elements ← element_count(shape)

    # --- block + byte layout resolution -----------------------------------
    let int elements_per_block ← block_layout(ggml_dtype)
    if elements_per_block ≡ 0 then return variant Unknown { dtype = ggml_dtype }
    let int bytes_per_block ← byte_layout(ggml_dtype)

    # --- first-dim alignment + byte length (fail closed) ------------------
    require shape[0] % elements_per_block ≡ 0 throw variant BadOffset { message = "tensor first dimension is not a complete GGML block" }
    let int blocks ← elements / elements_per_block
    let int length ← mul(blocks, bytes_per_block)
    return variant Known { elements_per_block = elements_per_block, bytes_per_block = bytes_per_block, byte_length = length }
}

# Open storage metadata accompanies the legacy geometry projection. Unknown
# layouts retain the source representation while making their geometry
# explicitly unavailable.
fn block_metadata(GgmlLayout value) → storage.BlockMetadata {
    match value {
        case Known let elements_per_block, bytes_per_block, byte_length {
            return storage.known_block(elements_per_block, bytes_per_block, byte_length / bytes_per_block, byte_length)
        }
        case Unknown let dtype {
            return storage.unknown_block(0)
        }
    }
}

# -------------------------------------------------------------------------
# Public accessors.
# -------------------------------------------------------------------------

# Whether the manifest declares `key` (an optional key is probed here, so a
# present-but-malformed value still fails closed in its typed accessor).
@ public
fn has_key(GgufManifest m, string key) → bool {
    return find_metadata(m.metadata, key) ≢ null
}

@ public
fn metadata(GgufManifest m, string key) → GgufMetadata ⇥ GgufManifestError {
    let GgufMetadata ∪ none found ← find_metadata(m.metadata, key)
    if found ≢ null then return found
    throw variant NotFound { message = "metadata key not found: §"(key) }
}

@ public
fn text(GgufManifest m, string key) → string ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)
    return text_value(x)
}

@ public
fn number(GgufManifest m, string key) → int ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)
    return wire_count(x)
}

# Typed array accessors for the tokenizer metadata block (LIB-02-U1). Arrays
# are validated against their declared element kind; missing keys produce
# NotFound and malformed element kinds produce typed BadWire/BadBounds rows.
# Scalar tokenizer ids/template stay on the existing `number`/`text` surface.
@ public
fn texts(GgufManifest m, string key) → list<string> ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)
    require x.dtype ≡ GGUF_ARRAY throw variant BadWire { message = "metadata value is not a GGUF string array" }
    let list<u8> b ← byte_list(x.payload_wire)
    let int element_kind ← u32(b, 0)
    require element_kind ≡ GGUF_STRING throw variant BadWire { message = "metadata array is not a string array" }
    let int n ← u64(b, 4)
    require n ≤ ARRAY_LIMIT throw variant BadBounds { message = "GGUF array count exceeds the bounded limit" }
    mut list<string> out ← empty
    mut int cursor ← 12
    let int blen ← b.length()
    for range 0 ‥ n let i {
        require cursor + 8 ≤ blen throw variant Truncated { message = "bounded GGUF corpus ends before the required field" }
        let int len ← decode_u64(b[cursor‥cursor + 8] ↦ list<b8>)
        require len ≤ TEXT_LIMIT throw variant BadBounds { message = "GGUF string exceeds the bounded text limit" }
        let int next ← cursor + 8 + len
        require next ≤ blen throw variant Truncated { message = "bounded GGUF corpus ends before the required field" }
        let list<b8> body ← b[cursor + 8‥next] ↦ list<b8>
        out.append(text_wire(body))
        cursor ← next
    }
    return out
}

# Read `n` consecutive little-endian u32 values starting after a 12-byte array
# header. One range check covers the whole run (the per-element check of the
# generic path fails with the same Truncated error on the same overrun).
fn u32_run(list<u8> b, int n) → list<int> ⇥ GgufManifestError {
    let int end ← check_range(b, 12, n * 4)
    do {
        return b[12‥end] ↦ list<b8> ↦ list<u32> via Le ↦ list<int>
    }
    catch err {
        throw variant BadWire { message = "GGUF u32 array is not whole four-byte values" }
    }
}

@ public
fn numbers(GgufManifest m, string key) → list<int> ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)
    require x.dtype ≡ GGUF_ARRAY throw variant BadWire { message = "metadata value is not a GGUF integer array" }
    let list<u8> b ← byte_list(x.payload_wire)
    let int element_kind ← u32(b, 0)
    require element_kind ≡ GGUF_UINT8 or element_kind ≡ GGUF_INT8 or element_kind ≡ GGUF_UINT16 or element_kind ≡ GGUF_INT16 or element_kind ≡ GGUF_UINT32 or element_kind ≡ GGUF_INT32 or element_kind ≡ GGUF_UINT64 or element_kind ≡ GGUF_INT64 throw variant BadWire { message = "metadata array is not an integer array" }
    let int n ← u64(b, 4)
    require n ≤ ARRAY_LIMIT throw variant BadBounds { message = "GGUF array count exceeds the bounded limit" }
    if element_kind ≡ GGUF_UINT32 then return u32_run(b, n)
    let int scalar ← scalar_size(element_kind)
    mut list<int> out ← empty
    for range 0 ‥ n let i {
        out.append(scalar_count(b, 12 + i * scalar, element_kind))
    }
    return out
}

# Typed array-of-uint32 accessor (MODEL-01-M1). The wire element kind must be
# exactly GGUF_UINT32; another integer element kind fails closed instead of
# coercing. Missing keys produce NotFound; non-array values produce typed
# BadWire rows.
@ public
fn numbers_u32(GgufManifest m, string key) → list<int> ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)
    require x.dtype ≡ GGUF_ARRAY throw variant BadWire { message = "metadata value is not a GGUF u32 array" }
    let list<u8> b ← byte_list(x.payload_wire)
    let int element_kind ← u32(b, 0)
    require element_kind ≡ GGUF_UINT32 throw variant BadWire { message = "metadata array is not a u32 array" }
    let int n ← u64(b, 4)
    require n ≤ ARRAY_LIMIT throw variant BadBounds { message = "GGUF array count exceeds the bounded limit" }
    return u32_run(b, n)
}

# Typed bool accessor (MODEL-01-M1). The wire kind must be exactly GGUF_BOOL;
# a present non-bool value fails closed instead of coercing. The parser has
# already validated the wire byte is 0 or 1.
@ public
fn boolean(GgufManifest m, string key) → bool ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)
    require x.dtype ≡ GGUF_BOOL throw variant BadWire { message = "metadata value is not a GGUF bool" }
    let list<u8> b ← byte_list(x.payload_wire)
    return u8_value(b, 0) ≡ 1
}

# Typed array-length accessor (MODEL-01-M1). Reads only the array count from
# the wire header without decoding elements; wrong-kind values fail closed.
@ public
fn list_length(GgufManifest m, string key) → int ⇥ GgufManifestError {
    let GgufMetadata x ← metadata(m, key)
    require x.dtype ≡ GGUF_ARRAY throw variant BadWire { message = "metadata value is not a GGUF array" }
    let list<u8> b ← byte_list(x.payload_wire)
    let int n ← u64(b, 4)
    require n ≤ ARRAY_LIMIT throw variant BadBounds { message = "GGUF array count exceeds the bounded limit" }
    return n
}

@ public
fn find_tensor(GgufManifest m, string name) → GgufTensorDescriptor ⇥ GgufManifestError {
    for from m.tensors let t {
        if t.name ≡ name then return t
    }
    throw variant NotFound { message = "tensor not found: §"(name) }
}

# Exact stored byte range of one known-layout tensor: (absolute_start,
# payload_length) relative to the content identity. Reuses the
# already-validated range/overlap facts from parse/inspect; Unknown layout
# fails closed.
@ public
fn payload_limit(GgufManifest m, string name) → tuple<int, int> ⇥ GgufManifestError {
    let GgufTensorDescriptor tensor ← find_tensor(m, name)
    match tensor.layout {
        case Known let elements_per_block, bytes_per_block, byte_length {
            let int absolute ← add(m.data_start, tensor.relative_offset)
            return tuple<int, int> [absolute, byte_length]
        }
        case Unknown let kind {
            throw variant UnknownLayout { message = "tensor layout is unknown; payload range is unavailable" }
        }
    }
}

# -------------------------------------------------------------------------
# Manifest parser.
# -------------------------------------------------------------------------

fn align(int value, int alignment) → int ⇥ GgufManifestError {
    let int remainder ← value % alignment
    if remainder ≡ 0 then return value
    return add(value, alignment - remainder)
}

# Whether `value` is a power of two (the alignment domain: 1 up to 2^31).
fn power_two(int value) → bool {
    return value ∈ ALIGNMENTS
}

# The data-section alignment: `general.alignment` when declared (a UINT32 power
# of two), the default otherwise.
fn alignment_of(list<GgufMetadata> metadata) → int ⇥ GgufManifestError {
    let GgufMetadata ∪ none declared ← find_metadata(metadata, "general.alignment")
    if declared ≡ null then return DEFAULT_ALIGNMENT
    require declared.dtype ≡ GGUF_UINT32 throw variant BadWire { message = "general.alignment must use GGUF UINT32 wire kind" }
    let int file_alignment ← wire_count(declared)
    reject file_alignment ≤ 0 or file_alignment ≻ 4294967295 or not power_two(file_alignment) throw variant BadWire { message = "general.alignment must be a positive power of two" }
    return file_alignment
}

fn construct(artifact.ContentIdentity identity, int total, int version, int alignment, int table_end, int corpus_length, list<GgufMetadata> metadata, list<GgufTensorDescriptor> tensors) → GgufManifest ⇥ GgufManifestError {
    # --- data region start + corpus boundary (fail closed) ----------------
    let int data_start ← align(table_end, alignment)
    require data_start ≤ total throw variant BadOffset { message = "GGUF data section begins beyond the artifact" }
    require corpus_length ≤ data_start throw variant Surplus { message = "bounded GGUF corpus contains bytes from the data region" }

    # --- tensor absolute ranges (within the artifact) ---------------------
    mut list<DataRange> spans ← empty
    for from tensors let tensor {
        let int raw_start ← add(data_start, tensor.relative_offset)
        require raw_start ≤ total throw variant BadOffset { message = "GGML tensor offset exceeds the artifact" }
        match tensor.layout {
            case Known let elements_per_block, bytes_per_block, byte_length {
                let int finish ← add(raw_start, byte_length)
                require finish ≤ total throw variant BadOffset { message = "known GGML tensor range exceeds the artifact" }
                spans.append(DataRange { start = raw_start, end = finish })
            }
            case Unknown let kind {
            }
        }
    }

    # --- range overlap scan (fail closed) ---------------------------------
    # Known ranges are never empty, so sorted by start they overlap exactly
    # when one ends past the next one's start.
    let list<DataRange> ordered ← sort via asc from spans let span { return span.start }
    let int known ← ordered.length()
    if known ≻ 1 {
        for from ordered[0 ‥ known - 1], ordered[1 ‥ known] let previous, next {
            reject previous.end ≻ next.start throw variant BadOffset { message = "known GGML tensor ranges overlap" }
        }
    }

    # --- manifest construct -----------------------------------------------
    return GgufManifest { identity = identity, version = version, alignment = alignment, data_start = data_start, artifact_length = total, metadata = metadata, tensors = tensors }
}

@ public
fn parse(GgufCorpus corpus) → GgufManifest ⇥ GgufManifestError {
    # --- corpus + identity bounds (fail closed) ---------------------------
    # Check the caller-owned prefix before copying it into the parser's list
    # representation; otherwise an oversized octet corpus would already have
    # amplified memory before the bounded parser could reject it.
    require corpus.table.length() ≤ CORPUS_LIMIT throw variant BadBounds { message = "bounded GGUF corpus exceeds the 64 MiB parser limit" }
    let list<u8> b ← byte_list(corpus.table)
    let int total ← corpus.artifact_length
    reject total ≤ 0 or corpus.identity.length ≢ total or not identity_valid(corpus.identity, total) throw variant BadIdentity { message = "content identity does not match the supplied artifact length" }

    # --- header + format guard (magic/version/counts) ---------------------
    require b.length() ≥ 24 throw variant Truncated { message = "truncated GGUF header" }
    reject b[0 ‥ 4] ≢ MAGIC throw variant BadFormat { message = "not a GGUF file — bad magic" }
    let int version ← u32(b, 4)
    require version ≡ GGUF_VERSION throw variant UnknownVersion { message = "unsupported GGUF version: §"(version) }
    let int tensor_count ← u64(b, 8)
    let int kv_num ← u64(b, 16)
    reject tensor_count ≻ TENSOR_LIMIT or kv_num ≻ KV_LIMIT throw variant BadBounds { message = "GGUF count exceeds the bounded limit" }

    # --- metadata table (keys + wire values) ------------------------------
    mut int cursor ← 24
    mut list<GgufMetadata> metadata ← empty
    mut set<string> keys ← empty
    for range 0 ‥ kv_num let i {
        # --- key (length + duplicate check) -------------------------------
        let int key_len ← u64(b, cursor)
        require key_len ≤ NAME_LIMIT throw variant BadBounds { message = "metadata key exceeds the bounded length" }
        let string key ← text_at(b, cursor + 8, key_len)
        reject key ∈ keys throw variant DuplicateKey { message = "duplicate GGUF metadata key: §"(key) }
        keys.add(key)
        cursor ← add(cursor, 8 + key_len)

        # --- value kind (fail closed) -------------------------------------
        let int kind ← u32(b, cursor)
        require dtype_valid(kind) throw variant BadWire { message = "unknown GGUF metadata value type" }
        cursor ← add(cursor, 4)

        # --- value wire + record append -----------------------------------
        let int value_start ← cursor
        let int value_len ← size_value(b, value_start, kind, 0)
        let list<u8> value_bytes ← slice(b, value_start, value_len)
        metadata.append(GgufMetadata { key = key, dtype = kind, payload_wire = byte_from_list(value_bytes) })
        cursor ← add(cursor, value_len)
    }

    # --- alignment override (general.alignment) ---------------------------
    let int alignment ← alignment_of(metadata)

    # --- tensor table (names + shapes + layouts) --------------------------
    mut list<GgufTensorDescriptor> tensors ← empty
    mut set<string> names ← empty
    for range 0 ‥ tensor_count let t {
        # --- name (length + duplicate check) ------------------------------
        let int name_len ← u64(b, cursor)
        require name_len ≤ NAME_LIMIT throw variant BadBounds { message = "tensor name exceeds the bounded length" }
        let string name ← text_at(b, cursor + 8, name_len)
        require name.length() ≢ 0 throw variant BadWire { message = "empty tensor name" }
        reject name ∈ names throw variant DuplicateTensor { message = "duplicate GGUF tensor name: §"(name) }
        names.add(name)
        cursor ← add(cursor, 8 + name_len)

        # --- rank + shape dims (bounded) ----------------------------------
        let int rank ← u32(b, cursor)
        cursor ← add(cursor, 4)
        require rank ≢ 0 throw variant BadBounds { message = "tensor rank must be at least one" }
        require rank ≤ RANK_LIMIT throw variant BadBounds { message = "tensor rank exceeds the bounded limit" }
        mut list<int> shape ← empty
        for range 0 ‥ rank let d {
            let int dim ← u64(b, cursor)
            reject dim ≤ 0 throw variant BadBounds { message = "tensor dimension must be positive" }
            shape.append(dim)
            cursor ← add(cursor, 8)
        }

        # --- dtype + offset + layout --------------------------------------
        let int ggml_dtype ← u32(b, cursor)
        cursor ← add(cursor, 4)
        let int offset ← u64(b, cursor)
        cursor ← add(cursor, 8)
        let int elements ← element_count(shape)
        let GgmlLayout lay ← layout(ggml_dtype, shape)

        # --- append tensor descriptor -------------------------------------
        tensors.append(GgufTensorDescriptor { name = name, shape = shape, dtype_ggml = ggml_dtype, representation = storage.ggml_representation(ggml_dtype), relative_offset = offset, elements = elements, layout = lay, block = block_metadata(lay) })
    }

    # --- manifest construct -----------------------------------------------
    return construct(corpus.identity, total, version, alignment, cursor, b.length(), metadata, tensors)
}

# Incrementally inspect a real GGUF header and directory. Every source request
# is an exact range established by the wire cursor; inspection stops at the end
# of the tensor table and never asks for a tensor payload byte.
@ public
fn inspect((int, int) → list<b8> ⇥ GgufManifestError source, int artifact_length, artifact.ContentIdentity identity) → GgufManifest ⇥ GgufManifestError {
    # --- identity + header (fail closed) ----------------------------------
    reject artifact_length ≤ 0 or not identity_valid(identity, artifact_length) throw variant BadIdentity { message = "content identity does not match the supplied artifact length" }
    let list<b8> header_wire ← read_source(source, artifact_length, 0, 24)
    let list<u8> header ← byte_list(header_wire)
    reject header[0 ‥ 4] ≢ MAGIC throw variant BadFormat { message = "not a GGUF file — bad magic" }
    let int version ← u32(header, 4)
    require version ≡ GGUF_VERSION throw variant UnknownVersion { message = "unsupported GGUF version: §"(version) }
    let int tensor_count ← u64(header, 8)
    let int kv_num ← u64(header, 16)
    reject tensor_count ≻ TENSOR_LIMIT or kv_num ≻ KV_LIMIT throw variant BadBounds { message = "GGUF count exceeds the bounded limit" }

    # --- metadata table (ranged reads) ------------------------------------
    mut int cursor ← 24
    mut list<GgufMetadata> metadata ← empty
    mut set<string> keys ← empty
    for range 0 ‥ kv_num let i {
        # --- key (length + duplicate check) -------------------------------
        let list<b8> key_head_wire ← read_source(source, artifact_length, cursor, 8)
        let int key_len ← decode_u64(key_head_wire)
        require key_len ≤ NAME_LIMIT throw variant BadBounds { message = "metadata key exceeds the bounded length" }
        cursor ← add(cursor, 8)
        let list<b8> key_body_wire ← read_source(source, artifact_length, cursor, key_len)
        let string key ← text_wire(key_body_wire)
        reject key ∈ keys throw variant DuplicateKey { message = "duplicate GGUF metadata key: §"(key) }
        keys.add(key)
        cursor ← add(cursor, key_len)

        # --- value kind + wire read ---------------------------------------
        let list<b8> type_wire ← read_source(source, artifact_length, cursor, 4)
        let int kind ← decode_u32(type_wire)
        require dtype_valid(kind) throw variant BadWire { message = "unknown GGUF metadata value type" }
        cursor ← add(cursor, 4)
        let list<b8> value_wire ← source_value(source, artifact_length, cursor, kind, 0)

        # --- append metadata record ---------------------------------------
        metadata.append(GgufMetadata { key = key, dtype = kind, payload_wire = value_wire })
        cursor ← add(cursor, value_wire.length())
    }

    # --- alignment override (general.alignment) ---------------------------
    let int alignment ← alignment_of(metadata)

    # --- tensor table (ranged reads) --------------------------------------
    mut list<GgufTensorDescriptor> tensors ← empty
    mut set<string> names ← empty
    for range 0 ‥ tensor_count let t {
        # --- name (length + duplicate check) ------------------------------
        let list<b8> name_head_wire ← read_source(source, artifact_length, cursor, 8)
        let int name_len ← decode_u64(name_head_wire)
        require name_len ≤ NAME_LIMIT throw variant BadBounds { message = "tensor name exceeds the bounded length" }
        cursor ← add(cursor, 8)
        let list<b8> name_body_wire ← read_source(source, artifact_length, cursor, name_len)
        let string name ← text_wire(name_body_wire)
        require name.length() ≢ 0 throw variant BadWire { message = "empty tensor name" }
        reject name ∈ names throw variant DuplicateTensor { message = "duplicate GGUF tensor name: §"(name) }
        names.add(name)
        cursor ← add(cursor, name_len)

        # --- rank + shape dims (bounded) ----------------------------------
        let list<b8> rank_wire ← read_source(source, artifact_length, cursor, 4)
        let int rank ← decode_u32(rank_wire)
        cursor ← add(cursor, 4)
        require rank ≢ 0 throw variant BadBounds { message = "tensor rank must be at least one" }
        require rank ≤ RANK_LIMIT throw variant BadBounds { message = "tensor rank exceeds the bounded limit" }
        mut list<int> shape ← empty
        for range 0 ‥ rank let d {
            let list<b8> dim_wire ← read_source(source, artifact_length, cursor, 8)
            let int dim ← decode_u64(dim_wire)
            reject dim ≤ 0 throw variant BadBounds { message = "tensor dimension must be positive" }
            shape.append(dim)
            cursor ← add(cursor, 8)
        }

        # --- dtype + offset + layout --------------------------------------
        let list<b8> ggml_wire ← read_source(source, artifact_length, cursor, 4)
        let int ggml_dtype ← decode_u32(ggml_wire)
        cursor ← add(cursor, 4)
        let list<b8> offset_wire ← read_source(source, artifact_length, cursor, 8)
        let int offset ← decode_u64(offset_wire)
        cursor ← add(cursor, 8)
        let int elements ← element_count(shape)
        let GgmlLayout lay ← layout(ggml_dtype, shape)

        # --- append tensor descriptor -------------------------------------
        tensors.append(GgufTensorDescriptor { name = name, shape = shape, dtype_ggml = ggml_dtype, representation = storage.ggml_representation(ggml_dtype), relative_offset = offset, elements = elements, layout = lay, block = block_metadata(lay) })
    }

    # --- manifest construct -----------------------------------------------
    return construct(identity, artifact_length, version, alignment, cursor, cursor, metadata, tensors)
}

# Read an exact, bounded fragment of one known-layout tensor. `start` and
# `length` are relative to the tensor's payload; the source receives only
# the checked absolute range and is not retained in the returned bytes.
@ public
fn read_fragment(GgufManifest m, string name, int start, int length, (int, int) → list<b8> ⇥ GgufManifestError source) → list<b8> ⇥ GgufManifestError {
    # --- fragment range + tensor lookup (fail closed) ---------------------
    reject start ≺ 0 or length ≺ 0 throw variant BadOffset { message = "tensor fragment range is negative" }
    let GgufTensorDescriptor tensor ← find_tensor(m, name)
    match tensor.layout {
        case Known let elements_per_block, bytes_per_block, byte_length {
            # --- absolute range + exact source read -----------------------
            reject start ≻ byte_length or length ≻ byte_length - start throw variant BadOffset { message = "tensor fragment range exceeds the known tensor" }
            let int rel ← add(tensor.relative_offset, start)
            let int absolute ← add(m.data_start, rel)
            let int end ← add(absolute, length)
            reject absolute ≻ m.artifact_length or end ≻ m.artifact_length throw variant BadOffset { message = "tensor fragment range exceeds the artifact" }
            return read_source(source, m.artifact_length, absolute, length)
        }
        case Unknown let kind {
            throw variant UnknownLayout { message = "tensor layout is unknown; payload fragment is unavailable" }
        }
    }
}

# -------------------------------------------------------------------------
# Typed tensor loading.
#
# GGUF stores a matrix with `ne` = [in, out] (ne0 is the innermost, fastest
# axis); the row-major shape a consumer wants is the REVERSED `ne` = [out, in],
# and the file's byte order already is that row-major order, so the load is one
# range read and one bulk conversion, with no transpose pass. The destination
# type is the one source of truth for shape: the conversion itself checks the
# byte length, and the only separate checks are the element type and the dims
# (a transposed tensor has the right byte count). A tensor of another type or
# shape is refused by a named error (UnknownLayout for the type, BadBounds for
# the dims or the length); nothing is silently reshaped.
# -------------------------------------------------------------------------

# `ne` is the manifest shape (ne0 first), `expected` the destination's
# row-major dims. The type must be F32 and the dims the same, reversed.
@ public
fn check_dims(string name, list<int> ne, int dtype, list<int> expected) → void ⇥ GgufManifestError {
    reject dtype ≢ GGML_F32 throw variant UnknownLayout { message = "tensor § is not F32 (ggml type §)"(name, dtype) }
    reject ne.invert() ≢ expected throw variant BadBounds { message = "tensor § ne § differs from the expected row-major dims § reversed"(name, ne, expected) }
}

# One range read of the tensor's payload through the caller's source, after
# the type and dims checks.
fn tensor_bytes((int, int) → list<b8> ⇥ GgufManifestError source, GgufManifest m, string name, list<int> expected) → list<b8> ⇥ GgufManifestError {
    let GgufTensorDescriptor d ← find_tensor(m, name)
    check_dims(name, d.shape, d.dtype_ggml, expected)
    let tuple<int, int> limit ← payload_limit(m, name)
    return source(limit[0], limit[1])
}

# The F32 matrix `name` as `tensor<f32, [N, K]>`. `rows` and `cols` carry the
# extents N and K: the expected dims are their lengths, and a generic extent
# that appears in no argument has no carrier for the run-time shape of the
# conversion.
@ public
fn load_matrix<size N, size K>((int, int) → list<b8> ⇥ GgufManifestError source, GgufManifest m, string name, tensor<f32, [N]> rows, tensor<f32, [K]> cols) → tensor<f32, [N, K]> ⇥ GgufManifestError {
    let list<b8> raw ← tensor_bytes(source, m, name, [rows.length(), cols.length()])
    do {
        return raw ↦ tensor<f32, [size N, size K]> via Le
    }
    catch err {
        throw variant BadBounds { message = "tensor §: §"(name, err) }
    }
}

# The F32 vector `name` as `tensor<f32, [N]>`.
@ public
fn load_vector<size N>((int, int) → list<b8> ⇥ GgufManifestError source, GgufManifest m, string name, tensor<f32, [N]> extent) → tensor<f32, [N]> ⇥ GgufManifestError {
    let list<b8> raw ← tensor_bytes(source, m, name, [extent.length()])
    do {
        return raw ↦ tensor<f32, [size N]> via Le
    }
    catch err {
        throw variant BadBounds { message = "tensor §: §"(name, err) }
    }
}
