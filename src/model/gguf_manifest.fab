+++
locale = "en"
+++
# GGUF v3 format-general manifest parser and pathless range seam (GGUF-A1b).
#
# Public import: importa ex "gradus:model/gguf_manifest" privata manifestum
# Depends on: gradus:model/artifact (pathless content identity).
#
# `parse` consumes a bounded header/metadata/tensor-table corpus. `inspice`
# obtains that same table incrementally from a caller-owned range function and
# never retains the function or source bytes. `lege_fragmentum` obtains only a
# checked tensor subrange. Neither operation retains a path, URL, reader, file
# handle, mapping, device object, or payload. `valor_wire` is the exact encoded
# GGUF value payload, beginning at the value's first byte and ending after its
# own length-prefixed content.

import from "gradus:model/artifact" artifact

# GGUF v3 wire value kinds (gguf.h enum gguf_type).
const int GGUF_UINT8 ← 0

const int GGUF_INT8 ← 1

const int GGUF_UINT16 ← 2

const int GGUF_INT16 ← 3

const int GGUF_UINT32 ← 4

const int GGUF_INT32 ← 5

const int GGUF_FLOAT32 ← 6

const int GGUF_BOOL ← 7

const int GGUF_STRING ← 8

const int GGUF_ARRAY ← 9

const int GGUF_UINT64 ← 10

const int GGUF_INT64 ← 11

const int GGUF_FLOAT64 ← 12

# GGML storage ids and block geometry. The table covers the ordinary GGUF
# scalar, integer, BF16, and K-quant rows seen in current Hub artifacts. A
# valid but unlisted id stays inspectable as LayoutGgml.Ignota.
const int GGML_F32 ← 0

const int GGML_F16 ← 1

const int GGML_Q4_0 ← 2

const int GGML_Q4_1 ← 3

const int GGML_Q5_0 ← 6

const int GGML_Q5_1 ← 7

const int GGML_Q8_0 ← 8

const int GGML_Q8_1 ← 9

const int GGML_Q2_K ← 10

const int GGML_Q3_K ← 11

const int GGML_Q4_K ← 12

const int GGML_Q5_K ← 13

const int GGML_Q6_K ← 14

const int GGML_Q8_K ← 15

const int GGML_IQ4_NL ← 20

const int GGML_I8 ← 24

const int GGML_I16 ← 25

const int GGML_I32 ← 26

const int GGML_I64 ← 27

const int GGML_F64 ← 28

const int GGML_BF16 ← 30

const int GGUF_VERSION ← 3

const int DEFAULT_ALIGNMENT ← 32

const int MAGIC_0 ← 71

const int MAGIC_1 ← 71

const int MAGIC_2 ← 85

const int MAGIC_3 ← 70

# Bounds protect the parser from count/length-driven allocation or loops.
# Duplicate-key/name and known-range validation are intentionally bounded
# quadratic scans in this A1 implementation. The 4,096-entry ceilings keep
# that work finite while admitting every inventoried local model (55 metadata
# entries and at most 753 tensors). The 64 MiB corpus ceiling bounds the
# retained header/table copy; the full model payload is never supplied here.
const int KV_LIMES ← 4096

const int TENSORUM_LIMES ← 4096

const int CORPUS_LIMES ← 67108864

const int NOMEN_LIMES ← 4096

const int TEXTUS_LIMES ← 1048576

const int ARRAY_LIMES ← 1048576

const int RANK_LIMES ← 64

const int DIMENSI_LIMES ← 1000000000

const int ELEMENTA_LIMES ← 1000000000

const int MAX_NUMERUS ← 9223372036854775807

@ public { }
union GgufManifestError {
    FormatMala {
        string message
    },
    VersioIgnota {
        string message
    },
    Truncata {
        string message
    },
    WireMala {
        string message
    },
    LimitesMala {
        string message
    },
    Superfluitas {
        string message
    },
    ClavisDuplicata {
        string message
    },
    TensorDuplicatum {
        string message
    },
    OffsetMala {
        string message
    },
    LayoutIgnota {
        string message
    },
    IdentitasMala {
        string message
    },
    FonsMala {
        string message
    }
}

@ public { }
class GgufCorpus {
    bytes tabula
    int artifact_length
    artifact.ContentIdentity identitas
}

# A range source reports success or failure as an explicit value. This keeps
# the higher-order package ABI executable while preserving a typed failure
# channel at the Gradus boundary.

@ public { }
class SourceRead {
    bool successus
    bytes bytes
    string message
}

@ public { }
class GgufMetadata {
    string key
    int dtype
    bytes valor_wire
}

@ public { }
union GgmlLayout {
    Cognita {
        int elementa_per_blockum
        int octeti_per_blockum
        int longitudo_octetorum
    },
    Ignota {
        int dtype
    }
}

@ public { }
class GgufTensorDescriptor {
    string name
    list<int> shape
    int dtype_ggml
    int offset_relativum
    int elements
    GgmlLayout layout
}

@ public { }
class GgufManifest {
    artifact.ContentIdentity identitas
    int version
    int concordatio
    int data_inceptum
    int artifact_length
    list<GgufMetadata> metadata
    list<GgufTensorDescriptor> tensors
}

@ public { }
fn message(GgufManifestError e) → string {
    match e {
        case FormatMala const causa {
            return causa
        }
        case VersioIgnota const causa {
            return causa
        }
        case Truncata const causa {
            return causa
        }
        case WireMala const causa {
            return causa
        }
        case LimitesMala const causa {
            return causa
        }
        case Superfluitas const causa {
            return causa
        }
        case ClavisDuplicata const causa {
            return causa
        }
        case TensorDuplicatum const causa {
            return causa
        }
        case OffsetMala const causa {
            return causa
        }
        case LayoutIgnota const causa {
            return causa
        }
        case IdentitasMala const causa {
            return causa
        }
        case FonsMala const causa {
            return causa
        }
    }
}

# -------------------------------------------------------------------------
# Basic byte and checked-arithmetic helpers.
# -------------------------------------------------------------------------

@ private { }
fn _byte_list(bytes o) → list<int<u8>> {
    # Use the runtime's bulk byte-vector bridge. Reading `octeti` one element
    # at a time is semantically equivalent, but it makes an owned interpreter
    # carrier copy the whole buffer for every indexed access.
    const value wire ← o ↦ value
    const list<int> numeri ← wire ↦ list<int>
    var list<int<u8>> out ← vacua
    for from numeri const v {
        out.append(v ∷ int<u8>)
    }
    return out
}

@ private { }
fn _byte_from_list(list<int<u8>> b) → bytes {
    return b ↦ bytes
}

@ private { }
fn _add(int a, int b) → int ⇥ GgufManifestError {
    if (a ≺ 0 or b ≺ 0) or a ≻ MAX_NUMERUS - b {
        throw variant LimitesMala {message = "checked offset addition overflow"}
    }
    return a + b
}

@ private { }
fn _mul(int a, int b) → int ⇥ GgufManifestError {
    if (a ≺ 0 or b ≺ 0) or b ≠ 0 and a ≻ MAX_NUMERUS / b {
        throw variant LimitesMala {message = "checked length multiplication overflow"}
    }
    return a * b
}

@ private { }
fn _slice(list<int<u8>> b, int off, int len) → list<int<u8>> ⇥ GgufManifestError {
    if off ≺ 0 or len ≺ 0 {
        throw variant LimitesMala {message = "negative byte range"}
    }
    const int finis ← _add(off, len)
    if finis ≻ b.length() {
        throw variant Truncata {message = "bounded GGUF corpus ends before the required field"}
    }
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ len {
        out.append(b.get(off + i) coalesce 0 ∷ int<u8>)
        i ↑
    }
    return out
}

# A source read is deliberately a function value, not a field of any public
# semantic value. The caller chooses the adapter and supplies it anew for
# each operation. The callback error channel is textus so an application
# boundary can map an OS/provider diagnostic without importing that provider
# into Gradus.
@ private { }
fn _read_source((int, int) → SourceRead fons, int total, int initium, int longitudo) → bytes ⇥ GgufManifestError {
    if (total ≤ 0 or initium ≺ 0) or longitudo ≺ 0 {
        throw variant FonsMala {message = "range source received an invalid range"}
    }
    if longitudo ≻ CORPUS_LIMES {
        throw variant LimitesMala {message = "range source request exceeds the 64 MiB read limit"}
    }
    const int finis ← _add(initium, longitudo)
    if finis ≻ total {
        throw variant OffsetMala {message = "range source request exceeds the artifact"}
    }
    const SourceRead lectio ← fons(initium, longitudo)
    if not lectio.successus {
        throw variant FonsMala {message = "range source failed: " + lectio.message}
    }
    const bytes lectum ← lectio.bytes
    if lectum.length() ≠ longitudo {
        throw variant FonsMala {message = "range source returned an unexpected byte length"}
    }
    return lectum
}

@ private { }
fn _u32(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    const list<int<u8>> x ← _slice(b, off, 4)
    const int r0 ← x.get(0) coalesce 0 ∷ int<u8> ↦ int
    const int r1 ← x.get(1) coalesce 0 ∷ int<u8> ↦ int
    const int r2 ← x.get(2) coalesce 0 ∷ int<u8> ↦ int
    const int r3 ← x.get(3) coalesce 0 ∷ int<u8> ↦ int
    return ((r0 ∨ r1 ⇐ 8) ∨ r2 ⇐ 16) ∨ r3 ⇐ 24
}

@ private { }
fn _u64(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    const list<int<u8>> x ← _slice(b, off, 8)
    const int r7 ← x.get(7) coalesce 0 ∷ int<u8> ↦ int
    if r7 ≥ 128 {
        throw variant LimitesMala {message = "GGUF UINT64 value exceeds the numerus carrier"}
    }
    const int r0 ← x.get(0) coalesce 0 ∷ int<u8> ↦ int
    const int r1 ← x.get(1) coalesce 0 ∷ int<u8> ↦ int
    const int r2 ← x.get(2) coalesce 0 ∷ int<u8> ↦ int
    const int r3 ← x.get(3) coalesce 0 ∷ int<u8> ↦ int
    const int r4 ← x.get(4) coalesce 0 ∷ int<u8> ↦ int
    const int r5 ← x.get(5) coalesce 0 ∷ int<u8> ↦ int
    const int r6 ← x.get(6) coalesce 0 ∷ int<u8> ↦ int
    return ((((((r0 ∨ r1 ⇐ 8) ∨ r2 ⇐ 16) ∨ r3 ⇐ 24) ∨ r4 ⇐ 32) ∨ r5 ⇐ 40) ∨ r6 ⇐ 48) ∨ r7 ⇐ 56
}

@ private { }
fn _texto(list<int<u8>> b, int off, int len) → string ⇥ GgufManifestError {
    const list<int<u8>> x ← _slice(b, off, len)
    const bytes o ← x
    do {
        return o ↦ string
    }
    catch err {
        throw variant WireMala {message = "GGUF string is not valid UTF-8"}
    }
    throw variant WireMala {message = "unreachable string conversion"}
}

@ private { }
fn _string(list<int<u8>> b, int off) → string ⇥ GgufManifestError {
    const int len ← _u64(b, off)
    if len ≻ TEXTUS_LIMES {
        throw variant LimitesMala {message = "GGUF string exceeds the bounded text limit"}
    }
    return _texto(b, off + 8, len)
}

@ private { }
fn _u8_value(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    const list<int<u8>> x ← _slice(b, off, 1)
    return x.get(0) coalesce 0 ∷ int<u8> ↦ int
}

@ private { }
fn _scalar_size(int typo) → int {
    if (typo ≡ GGUF_UINT8 or typo ≡ GGUF_INT8) or typo ≡ GGUF_BOOL then return 1
    if typo ≡ GGUF_UINT16 or typo ≡ GGUF_INT16 then return 2
    if (typo ≡ GGUF_UINT32 or typo ≡ GGUF_INT32) or typo ≡ GGUF_FLOAT32 then return 4
    if (typo ≡ GGUF_UINT64 or typo ≡ GGUF_INT64) or typo ≡ GGUF_FLOAT64 then return 8
    return 0
}

@ private { }
fn _dtype_valid(int typo) → bool {
    return typo ≥ GGUF_UINT8 and typo ≤ GGUF_FLOAT64
}

# Append one octet buffer to another. The range parser uses this only for one
# metadata value at a time; it never reconstructs or reparses the whole table.
@ private { }
fn _join_bytes(bytes a, bytes b) → bytes {
    var bytes out ← a
    var int i ← 0
    while i ≺ b.length() {
        out.append(b.get(i) coalesce 0 ∷ int<u8>)
        i ↑
    }
    return out
}

# Read one metadata value from its absolute wire offset. The result contains
# exactly that value's wire bytes. Arrays recurse over their declared element
# type, but no cumulative header/table prefix is copied or retained.
@ private { }
fn _source_value((int, int) → SourceRead fons, int total, int off, int typo, int profunditas) → bytes ⇥ GgufManifestError {
    if profunditas ≻ 64 {
        throw variant LimitesMala {message = "metadata array nesting exceeds the bounded depth"}
    }
    if not _dtype_valid(typo) {
        throw variant WireMala {message = "unknown GGUF metadata value type"}
    }
    const int scalar ← _scalar_size(typo)
    if scalar ≻ 0 {
        const bytes wire ← _read_source(fons, total, off, scalar)
        _size_value(_byte_list(wire), 0, typo, profunditas)
        return wire
    }
    if typo ≡ GGUF_STRING {
        const bytes caput ← _read_source(fons, total, off, 8)
        const int len ← _u64(_byte_list(caput), 0)
        if len ≻ TEXTUS_LIMES {
            throw variant LimitesMala {message = "GGUF string exceeds the bounded text limit"}
        }
        const bytes corpus ← _read_source(fons, total, _add(off, 8), len)
        _texto(_byte_list(corpus), 0, len)
        return _join_bytes(caput, corpus)
    }
    if typo ≡ GGUF_ARRAY {
        const bytes caput ← _read_source(fons, total, off, 12)
        const list<int<u8>> caput_lista ← _byte_list(caput)
        const int elementum_typo ← _u32(caput_lista, 0)
        if not _dtype_valid(elementum_typo) {
            throw variant WireMala {message = "unknown GGUF array element type"}
        }
        const int n ← _u64(caput_lista, 4)
        if n ≻ ARRAY_LIMES {
            throw variant LimitesMala {message = "GGUF array count exceeds the bounded limit"}
        }
        const int elementum_scalar ← _scalar_size(elementum_typo)
        if elementum_scalar ≻ 0 {
            const int longitudo ← _mul(n, elementum_scalar)
            const bytes corpus ← _read_source(fons, total, _add(off, 12), longitudo)
            const bytes out ← _join_bytes(caput, corpus)
            _size_value(_byte_list(out), 0, typo, profunditas)
            return out
        }
        if elementum_typo ≡ GGUF_STRING {
            var int cursor ← _add(off, 12)
            var int i ← 0
            while i ≺ n {
                const bytes item_head ← _read_source(fons, total, cursor, 8)
                const int len ← _u64(_byte_list(item_head), 0)
                if len ≻ TEXTUS_LIMES {
                    throw variant LimitesMala {message = "GGUF string exceeds the bounded text limit"}
                }
                cursor ← _add(cursor, _add(8, len))
                i ↑
            }
            const int total_wire ← cursor - off
            # One exact source read preserves the full tokenizer array without
            # copying each growing element through Faber. The bounded scanner
            # above establishes its exact end before this read is issued.
            const bytes wire ← _read_source(fons, total, off, total_wire)
            _size_value(_byte_list(wire), 0, typo, profunditas)
            return wire
        }
        var bytes out ← caput
        var int cursor ← _add(off, 12)
        var int i ← 0
        while i ≺ n {
            const bytes item ← _source_value(fons, total, cursor, elementum_typo, profunditas + 1)
            # Append in place. Passing the growing accumulator through the
            # helper would copy it once per element and turn large tokenizer
            # string arrays quadratic.
            var int j ← 0
            while j ≺ item.length() {
                out.append(item.get(j) coalesce 0 ∷ int<u8>)
                j ↑
            }
            cursor ← _add(cursor, item.length())
            i ↑
        }
        return out
    }
    throw variant WireMala {message = "unknown GGUF metadata value type"}
}

# Returns the exact payload size for one typed GGUF value. For an array, the
# returned size includes its element-type and count headers and every nested
# element. No value bytes are retained here; the caller slices them once.
@ private { }
fn _size_value(list<int<u8>> b, int off, int typo, int profunditas) → int ⇥ GgufManifestError {
    if profunditas ≻ 64 {
        throw variant LimitesMala {message = "metadata array nesting exceeds the bounded depth"}
    }
    const int scalar ← _scalar_size(typo)
    if scalar ≻ 0 {
        if typo ≡ GGUF_BOOL {
            const int v ← _u8_value(b, off)
            if v ≠ 0 and v ≠ 1 {
                throw variant WireMala {message = "malformed GGUF bool value"}
            }
        }
        _slice(b, off, scalar)
        return scalar
    }
    if typo ≡ GGUF_STRING {
        const int len ← _u64(b, off)
        if len ≻ TEXTUS_LIMES {
            throw variant LimitesMala {message = "GGUF string exceeds the bounded text limit"}
        }
        const int total ← _add(8, len)
        _slice(b, off, total)
        # Validate the bytes even though the exact wire is retained.
        _texto(b, off + 8, len)
        return total
    }
    if typo ≡ GGUF_ARRAY {
        const int caput ← _add(off, 12)
        if caput ≻ b.length() {
            throw variant Truncata {message = "truncated GGUF array header"}
        }
        const int elementum_typo ← _u32(b, off)
        if not _dtype_valid(elementum_typo) {
            throw variant WireMala {message = "unknown GGUF array element type"}
        }
        const int n ← _u64(b, off + 4)
        if n ≻ ARRAY_LIMES {
            throw variant LimitesMala {message = "GGUF array count exceeds the bounded limit"}
        }
        var int total ← 12
        var int i ← 0
        while i ≺ n {
            const int part ← _size_value(b, off + total, elementum_typo, profunditas + 1)
            total ← _add(total, part)
            i ↑
        }
        _slice(b, off, total)
        return total
    }
    throw variant WireMala {message = "unknown GGUF metadata value type"}
}

# -------------------------------------------------------------------------
# Metadata and identity helpers.
# -------------------------------------------------------------------------

@ private { }
fn _contains(list<string> xs, string x) → bool {
    var int i ← 0
    while i ≺ xs.length() {
        if xs.get(i) coalesce "" ≡ x then return true
        i ↑
    }
    return false
}

@ private { }
fn _digest_ok(string digestio) → bool {
    if digestio.length() ≠ 64 then return false
    var int i ← 0
    while i ≺ digestio.length() {
        const string c ← digestio.slice(i, i + 1)
        if not (((((((((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9") or c ≡ "a") or c ≡ "b") or c ≡ "c") or c ≡ "d") or c ≡ "e") or c ≡ "f") then return false
        i ↑
    }
    return true
}

@ private { }
fn _identity_valid(artifact.ContentIdentity artifacti, int longitudo) → bool {
    return ((artifacti.algorithm ≡ "sha-256" and _digest_ok(artifacti.digest)) and artifacti.length ≡ longitudo) and longitudo ≻ 0
}

@ private { }
fn _find_metadata(list<GgufMetadata> xs, string clavis) → GgufMetadata ∪ null {
    for from xs const x {
        if x.key ≡ clavis then return x
    }
    return null
}

@ private { }
fn _value_u16(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    const list<int<u8>> x ← _slice(b, off, 2)
    return (x.get(0) coalesce 0 ∷ int<u8> ↦ int) ∨ (x.get(1) coalesce 0 ∷ int<u8> ↦ int) ⇐ 8
}

@ private { }
fn _value_i32(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    const int raw ← _u32(b, off)
    if raw ≺ 2147483648 then return raw
    return raw - 4294967296
}

@ private { }
fn _value_i64(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    const list<int<u8>> x ← _slice(b, off, 8)
    const int high ← x.get(7) coalesce 0 ∷ int<u8> ↦ int
    const int r0 ← x.get(0) coalesce 0 ∷ int<u8> ↦ int
    const int r1 ← x.get(1) coalesce 0 ∷ int<u8> ↦ int
    const int r2 ← x.get(2) coalesce 0 ∷ int<u8> ↦ int
    const int r3 ← x.get(3) coalesce 0 ∷ int<u8> ↦ int
    const int r4 ← x.get(4) coalesce 0 ∷ int<u8> ↦ int
    const int r5 ← x.get(5) coalesce 0 ∷ int<u8> ↦ int
    const int r6 ← x.get(6) coalesce 0 ∷ int<u8> ↦ int
    const int lower ← ((((((r0 ∨ r1 ⇐ 8) ∨ r2 ⇐ 16) ∨ r3 ⇐ 24) ∨ r4 ⇐ 32) ∨ r5 ⇐ 40) ∨ r6 ⇐ 48) ∨ high % 128 ⇐ 56
    if high ≺ 128 then return lower
    return ((0 - MAX_NUMERUS) - 1) + lower
}

@ private { }
fn _value_u32(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    return _u32(b, off)
}

@ private { }
fn _value_u64(list<int<u8>> b, int off) → int ⇥ GgufManifestError {
    return _u64(b, off)
}

@ private { }
fn _scalar_count(list<int<u8>> b, int off, int typo) → int ⇥ GgufManifestError {
    # BOOL remains valid and preserved in valor_wire, but is not an integer
    # accessor value; callers receive WireMala instead.
    if typo ≡ GGUF_UINT8 then return _u8_value(b, off)
    if typo ≡ GGUF_INT8 {
        const int raw ← _u8_value(b, off)
        if raw ≺ 128 then return raw
        return raw - 256
    }
    if typo ≡ GGUF_UINT16 then return _value_u16(b, off)
    if typo ≡ GGUF_INT16 {
        const int raw ← _value_u16(b, off)
        if raw ≺ 32768 then return raw
        return raw - 65536
    }
    if typo ≡ GGUF_UINT32 then return _value_u32(b, off)
    if typo ≡ GGUF_INT32 then return _value_i32(b, off)
    if typo ≡ GGUF_UINT64 then return _value_u64(b, off)
    if typo ≡ GGUF_INT64 then return _value_i64(b, off)
    throw variant WireMala {message = "metadata value is not an unsigned integer"}
}

@ private { }
fn _wire_count(GgufMetadata m) → int ⇥ GgufManifestError {
    const list<int<u8>> b ← _byte_list(m.valor_wire)
    return _scalar_count(b, 0, m.dtype)
}

@ private { }
fn _text_value(GgufMetadata m) → string ⇥ GgufManifestError {
    if m.dtype ≠ GGUF_STRING {
        throw variant WireMala {message = "metadata value is not a GGUF string"}
    }
    const list<int<u8>> b ← _byte_list(m.valor_wire)
    return _string(b, 0)
}

# -------------------------------------------------------------------------
# GGML layout resolution.
# -------------------------------------------------------------------------

@ private { }
fn _block_layout(int typo) → int {
    if ((((((typo ≡ GGML_F32 or typo ≡ GGML_F16) or typo ≡ GGML_I8) or typo ≡ GGML_I16) or typo ≡ GGML_I32) or typo ≡ GGML_I64) or typo ≡ GGML_F64) or typo ≡ GGML_BF16 then return 1
    if (((((typo ≡ GGML_Q4_0 or typo ≡ GGML_Q4_1) or typo ≡ GGML_Q5_0) or typo ≡ GGML_Q5_1) or typo ≡ GGML_Q8_0) or typo ≡ GGML_Q8_1) or typo ≡ GGML_IQ4_NL then return 32
    if ((((typo ≡ GGML_Q2_K or typo ≡ GGML_Q3_K) or typo ≡ GGML_Q4_K) or typo ≡ GGML_Q5_K) or typo ≡ GGML_Q6_K) or typo ≡ GGML_Q8_K then return 256
    return 0
}

@ private { }
fn _byte_layout(int typo) → int {
    if typo ≡ GGML_F32 or typo ≡ GGML_I32 then return 4
    if (typo ≡ GGML_F16 or typo ≡ GGML_I16) or typo ≡ GGML_BF16 then return 2
    if typo ≡ GGML_I8 then return 1
    if typo ≡ GGML_I64 or typo ≡ GGML_F64 then return 8
    if typo ≡ GGML_Q4_0 then return 18
    if typo ≡ GGML_Q4_1 then return 20
    if typo ≡ GGML_Q5_0 then return 22
    if typo ≡ GGML_Q5_1 then return 24
    if typo ≡ GGML_Q8_0 then return 34
    if typo ≡ GGML_Q8_1 then return 36
    if typo ≡ GGML_Q2_K then return 84
    if typo ≡ GGML_Q3_K then return 110
    if typo ≡ GGML_Q4_K then return 144
    if typo ≡ GGML_Q5_K then return 176
    if typo ≡ GGML_Q6_K then return 210
    if typo ≡ GGML_Q8_K then return 292
    if typo ≡ GGML_IQ4_NL then return 18
    return 0
}

@ private { }
fn _elements(list<int> forma) → int ⇥ GgufManifestError {
    var int total ← 1
    for from forma const dim {
        if dim ≤ 0 or dim ≻ DIMENSI_LIMES {
            throw variant LimitesMala {message = "tensor dimension is outside the bounded range"}
        }
        if total ≻ ELEMENTA_LIMES / dim {
            throw variant LimitesMala {message = "tensor element count exceeds the bounded range"}
        }
        total ← total * dim
    }
    return total
}

fn layout(int typo_ggml, list<int> forma) → GgmlLayout ⇥ GgufManifestError {
    if forma.length() ≡ 0 {
        throw variant LimitesMala {message = "tensor rank must be at least one"}
    }
    const int elementa ← _elements(forma)
    const int elementa_per_blockum ← _block_layout(typo_ggml)
    if elementa_per_blockum ≡ 0 then return variant Ignota {dtype = typo_ggml}
    const int octeti_per_blockum ← _byte_layout(typo_ggml)
    const int prima_dimensio ← forma.get(0) coalesce 0
    if prima_dimensio % elementa_per_blockum ≠ 0 {
        throw variant OffsetMala {message = "tensor first dimension is not a complete GGML block"}
    }
    const int blocci ← elementa / elementa_per_blockum
    const int longitudo ← _mul(blocci, octeti_per_blockum)
    return variant Cognita {elementa_per_blockum = elementa_per_blockum, octeti_per_blockum = octeti_per_blockum, longitudo_octetorum = longitudo}
}

# -------------------------------------------------------------------------
# Public accessors.
# -------------------------------------------------------------------------

@ public { }
fn metadata(GgufManifest m, string clavis) → GgufMetadata ⇥ GgufManifestError {
    const GgufMetadata ∪ null found ← _find_metadata(m.metadata, clavis)
    if found not is null then return found coalesce GgufMetadata {key = "", dtype = -1, valor_wire = ||}
    throw variant WireMala {message = "metadata key not found: " + clavis}
}

@ public { }
fn textum(GgufManifest m, string clavis) → string ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, clavis)
    return _text_value(x)
}

@ public { }
fn numerum(GgufManifest m, string clavis) → int ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, clavis)
    return _wire_count(x)
}

# Typed array accessors for the tokenizer metadata block (LIB-02-U1). Arrays
# are validated against their declared element kind; missing keys and
# malformed element kinds produce typed GgufManifestError rows. Scalar
# tokenizer ids/template stay on the existing `numerum`/`textum` surface.
@ public { }
fn textorum(GgufManifest m, string clavis) → list<string> ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, clavis)
    if x.dtype ≠ GGUF_ARRAY {
        throw variant WireMala {message = "metadata value is not a GGUF string array"}
    }
    const list<int<u8>> b ← _byte_list(x.valor_wire)
    const int elementum_typo ← _u32(b, 0)
    if elementum_typo ≠ GGUF_STRING {
        throw variant WireMala {message = "metadata array is not a string array"}
    }
    const int n ← _u64(b, 4)
    if n ≻ ARRAY_LIMES {
        throw variant LimitesMala {message = "GGUF array count exceeds the bounded limit"}
    }
    var list<string> out ← vacua
    var int cursor ← 12
    var int i ← 0
    while i ≺ n {
        const int len ← _u64(b, cursor)
        if len ≻ TEXTUS_LIMES {
            throw variant LimitesMala {message = "GGUF string exceeds the bounded text limit"}
        }
        out.append(_texto(b, _add(cursor, 8), len))
        cursor ← _add(cursor, _add(8, len))
        i ↑
    }
    return out
}

@ public { }
fn numerorum(GgufManifest m, string clavis) → list<int> ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, clavis)
    if x.dtype ≠ GGUF_ARRAY {
        throw variant WireMala {message = "metadata value is not a GGUF integer array"}
    }
    const list<int<u8>> b ← _byte_list(x.valor_wire)
    const int elementum_typo ← _u32(b, 0)
    if not (((((((elementum_typo ≡ GGUF_UINT8 or elementum_typo ≡ GGUF_INT8) or elementum_typo ≡ GGUF_UINT16) or elementum_typo ≡ GGUF_INT16) or elementum_typo ≡ GGUF_UINT32) or elementum_typo ≡ GGUF_INT32) or elementum_typo ≡ GGUF_UINT64) or elementum_typo ≡ GGUF_INT64) {
        throw variant WireMala {message = "metadata array is not an integer array"}
    }
    const int n ← _u64(b, 4)
    if n ≻ ARRAY_LIMES {
        throw variant LimitesMala {message = "GGUF array count exceeds the bounded limit"}
    }
    const int scalar ← _scalar_size(elementum_typo)
    var list<int> out ← vacua
    var int cursor ← 12
    var int i ← 0
    while i ≺ n {
        out.append(_scalar_count(b, cursor, elementum_typo))
        cursor ← _add(cursor, scalar)
        i ↑
    }
    return out
}

# Typed array-of-uint32 accessor (MODEL-01-M1). The wire element kind must be
# exactly GGUF_UINT32; another integer element kind fails closed instead of
# coercing. Missing keys and non-array values produce typed GgufManifestError
# rows.
@ public { }
fn numerorum_u32(GgufManifest m, string clavis) → list<int> ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, clavis)
    if x.dtype ≠ GGUF_ARRAY {
        throw variant WireMala {message = "metadata value is not a GGUF u32 array"}
    }
    const list<int<u8>> b ← _byte_list(x.valor_wire)
    const int elementum_typo ← _u32(b, 0)
    if elementum_typo ≠ GGUF_UINT32 {
        throw variant WireMala {message = "metadata array is not a u32 array"}
    }
    const int n ← _u64(b, 4)
    if n ≻ ARRAY_LIMES {
        throw variant LimitesMala {message = "GGUF array count exceeds the bounded limit"}
    }
    var list<int> out ← vacua
    var int cursor ← 12
    var int i ← 0
    while i ≺ n {
        out.append(_value_u32(b, cursor))
        cursor ← _add(cursor, 4)
        i ↑
    }
    return out
}

# Typed bool accessor (MODEL-01-M1). The wire kind must be exactly GGUF_BOOL;
# a present non-bool value fails closed instead of coercing. The parser has
# already validated the wire byte is 0 or 1.
@ public { }
fn boleanum(GgufManifest m, string clavis) → bool ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, clavis)
    if x.dtype ≠ GGUF_BOOL {
        throw variant WireMala {message = "metadata value is not a GGUF bool"}
    }
    const list<int<u8>> b ← _byte_list(x.valor_wire)
    return _u8_value(b, 0) ≡ 1
}

# Typed array-length accessor (MODEL-01-M1). Reads only the array count from
# the wire header without decoding elements; wrong-kind values fail closed.
@ public { }
fn longitudo_listae(GgufManifest m, string clavis) → int ⇥ GgufManifestError {
    const GgufMetadata x ← metadata(m, clavis)
    if x.dtype ≠ GGUF_ARRAY {
        throw variant WireMala {message = "metadata value is not a GGUF array"}
    }
    const list<int<u8>> b ← _byte_list(x.valor_wire)
    const int n ← _u64(b, 4)
    if n ≻ ARRAY_LIMES {
        throw variant LimitesMala {message = "GGUF array count exceeds the bounded limit"}
    }
    return n
}

@ public { }
fn inveni_tensorem(GgufManifest m, string nomen) → GgufTensorDescriptor ⇥ GgufManifestError {
    for from m.tensors const t {
        if t.name ≡ nomen then return t
    }
    throw variant WireMala {message = "tensor not found: " + nomen}
}

# Exact stored byte range of one known-layout tensor: (initium_absolutum,
# longitudo_payloadis) relative to the content identity. Reuses the
# already-validated range/overlap facts from parse/inspice; Ignota layout
# fails closed.
@ public { }
fn limes_payloadis(GgufManifest m, string nomen) → tuple<int, int> ⇥ GgufManifestError {
    const GgufTensorDescriptor tensor ← inveni_tensorem(m, nomen)
    match tensor.layout {
        case Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            const int absolute ← _add(m.data_inceptum, tensor.offset_relativum)
            return tuple<int, int> [absolute, longitudo_octetorum]
        }
        case Ignota const typo {
            throw variant LayoutIgnota {message = "tensor layout is unknown; payload range is unavailable"}
        }
    }
}

# -------------------------------------------------------------------------
# Manifest parser.
# -------------------------------------------------------------------------

@ private { }
fn _align(int value, int alignment) → int ⇥ GgufManifestError {
    const int remainder ← value % alignment
    if remainder ≡ 0 then return value
    return _add(value, alignment - remainder)
}

@ private { }
fn _power_two(int value) → bool {
    if value ≤ 0 then return false
    var int x ← value
    while x % 2 ≡ 0 {
        x ← x / 2
    }
    return x ≡ 1
}

@ private { }
fn _construct(artifact.ContentIdentity identitas, int total, int versio, int concordatio, int tabula_finis, int corpus_longitudo, list<GgufMetadata> metadata, list<GgufTensorDescriptor> tensores) → GgufManifest ⇥ GgufManifestError {
    const int data_inceptum ← _align(tabula_finis, concordatio)
    if data_inceptum ≻ total {
        throw variant OffsetMala {message = "GGUF data section begins beyond the artifact"}
    }
    if corpus_longitudo ≻ data_inceptum {
        throw variant Superfluitas {message = "bounded GGUF corpus contains bytes from the data region"}
    }
    var list<int> abs_initia ← vacua
    var list<int> abs_fines ← vacua
    for from tensores const tensor {
        const int raw_start ← _add(data_inceptum, tensor.offset_relativum)
        if raw_start ≻ total {
            throw variant OffsetMala {message = "GGML tensor offset exceeds the artifact"}
        }
        match tensor.layout {
            case Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
                const int finish ← _add(raw_start, longitudo_octetorum)
                if finish ≻ total {
                    throw variant OffsetMala {message = "known GGML tensor range exceeds the artifact"}
                }
                abs_initia.append(raw_start)
                abs_fines.append(finish)
            }
            case Ignota const typo {
            }
        }
    }
    var int a ← 0
    while a ≺ abs_initia.length() {
        var int z ← a + 1
        while z ≺ abs_initia.length() {
            const int ai ← abs_initia.get(a) coalesce 0
            const int bi ← abs_fines.get(a) coalesce 0
            const int aj ← abs_initia.get(z) coalesce 0
            const int bj ← abs_fines.get(z) coalesce 0
            if bi ≻ aj and bj ≻ ai {
                throw variant OffsetMala {message = "known GGML tensor ranges overlap"}
            }
            z ↑
        }
        a ↑
    }
    return GgufManifest {identitas = identitas, version = versio, concordatio = concordatio, data_inceptum = data_inceptum, artifact_length = total, metadata = metadata, tensors = tensores}
}

@ public { }
fn parse(GgufCorpus corpus) → GgufManifest ⇥ GgufManifestError {
    # Check the caller-owned prefix before copying it into the parser's list
    # representation; otherwise an oversized octet corpus would already have
    # amplified memory before the bounded parser could reject it.
    if corpus.tabula.length() ≻ CORPUS_LIMES {
        throw variant LimitesMala {message = "bounded GGUF corpus exceeds the 64 MiB parser limit"}
    }
    const list<int<u8>> b ← _byte_list(corpus.tabula)
    const int total ← corpus.artifact_length
    if (total ≤ 0 or corpus.identitas.length ≠ total) or not _identity_valid(corpus.identitas, total) {
        throw variant IdentitasMala {message = "content identity does not match the supplied artifact length"}
    }
    if b.length() ≺ 24 {
        throw variant Truncata {message = "truncated GGUF header"}
    }
    const int m0 ← _u8_value(b, 0)
    const int m1 ← _u8_value(b, 1)
    const int m2 ← _u8_value(b, 2)
    const int m3 ← _u8_value(b, 3)
    if ((m0 ≠ MAGIC_0 or m1 ≠ MAGIC_1) or m2 ≠ MAGIC_2) or m3 ≠ MAGIC_3 {
        throw variant FormatMala {message = "not a GGUF file — bad magic"}
    }
    const int versio ← _u32(b, 4)
    if versio ≠ GGUF_VERSION {
        throw variant VersioIgnota {message = "unsupported GGUF version: " + (versio ↦ string)}
    }
    const int tensorum ← _u64(b, 8)
    const int kv_num ← _u64(b, 16)
    if tensorum ≻ TENSORUM_LIMES or kv_num ≻ KV_LIMES {
        throw variant LimitesMala {message = "GGUF count exceeds the bounded limit"}
    }
    var int cursor ← 24
    var list<GgufMetadata> metadata ← vacua
    var list<string> claves ← vacua
    var int i ← 0
    while i ≺ kv_num {
        const int key_len ← _u64(b, cursor)
        if key_len ≻ NOMEN_LIMES {
            throw variant LimitesMala {message = "metadata key exceeds the bounded length"}
        }
        const string key ← _texto(b, cursor + 8, key_len)
        if _contains(claves, key) {
            throw variant ClavisDuplicata {message = "duplicate GGUF metadata key: " + key}
        }
        claves.append(key)
        cursor ← _add(cursor, 8 + key_len)
        const int typo ← _u32(b, cursor)
        if not _dtype_valid(typo) {
            throw variant WireMala {message = "unknown GGUF metadata value type"}
        }
        cursor ← _add(cursor, 4)
        const int value_start ← cursor
        const int value_len ← _size_value(b, value_start, typo, 0)
        const list<int<u8>> value_bytes ← _slice(b, value_start, value_len)
        metadata.append(GgufMetadata {key = key, dtype = typo, valor_wire = _byte_from_list(value_bytes)})
        cursor ← _add(cursor, value_len)
        i ↑
    }
    var int concordatio ← DEFAULT_ALIGNMENT
    const GgufMetadata ∪ null alignment_meta ← _find_metadata(metadata, "general.alignment")
    if alignment_meta not is null {
        if (alignment_meta coalesce GgufMetadata {key = "", dtype = -1, valor_wire = ||}).dtype ≠ GGUF_UINT32 {
            throw variant WireMala {message = "general.alignment must use GGUF UINT32 wire kind"}
        }
        const int alignment ← _wire_count(alignment_meta coalesce GgufMetadata {key = "", dtype = -1, valor_wire = ||})
        if (alignment ≤ 0 or alignment ≻ 4294967295) or not _power_two(alignment) {
            throw variant WireMala {message = "general.alignment must be a positive power of two"}
        }
        concordatio ← alignment
    }
    var list<GgufTensorDescriptor> tensores ← vacua
    var list<string> nomina ← vacua
    var int t ← 0
    while t ≺ tensorum {
        const int name_len ← _u64(b, cursor)
        if name_len ≻ NOMEN_LIMES {
            throw variant LimitesMala {message = "tensor name exceeds the bounded length"}
        }
        const string name ← _texto(b, cursor + 8, name_len)
        if name.length() ≡ 0 {
            throw variant WireMala {message = "empty tensor name"}
        }
        if _contains(nomina, name) {
            throw variant TensorDuplicatum {message = "duplicate GGUF tensor name: " + name}
        }
        nomina.append(name)
        cursor ← _add(cursor, 8 + name_len)
        const int rank ← _u32(b, cursor)
        cursor ← _add(cursor, 4)
        if rank ≡ 0 {
            throw variant LimitesMala {message = "tensor rank must be at least one"}
        }
        if rank ≻ RANK_LIMES {
            throw variant LimitesMala {message = "tensor rank exceeds the bounded limit"}
        }
        var list<int> forma ← vacua
        var int d ← 0
        while d ≺ rank {
            const int dim ← _u64(b, cursor)
            if dim ≤ 0 or dim ≻ DIMENSI_LIMES {
                throw variant LimitesMala {message = "tensor dimension is outside the bounded range"}
            }
            forma.append(dim)
            cursor ← _add(cursor, 8)
            d ↑
        }
        const int typo_ggml ← _u32(b, cursor)
        cursor ← _add(cursor, 4)
        const int offset ← _u64(b, cursor)
        cursor ← _add(cursor, 8)
        const int elementa ← _elements(forma)
        const GgmlLayout lay ← layout(typo_ggml, forma)
        tensores.append(GgufTensorDescriptor {name = name, shape = forma, dtype_ggml = typo_ggml, offset_relativum = offset, elements = elementa, layout = lay})
        t ↑
    }
    return _construct(corpus.identitas, total, versio, concordatio, cursor, b.length(), metadata, tensores)
}

# Incrementally inspect a real GGUF header and directory. Every source request
# is an exact range established by the wire cursor; inspection stops at the end
# of the tensor table and never asks for a tensor payload byte.
@ public { }
fn inspect((int, int) → SourceRead fons, int longitudo_artifacti, artifact.ContentIdentity identitas) → GgufManifest ⇥ GgufManifestError {
    if longitudo_artifacti ≤ 0 or not _identity_valid(identitas, longitudo_artifacti) {
        throw variant IdentitasMala {message = "content identity does not match the supplied artifact length"}
    }
    const bytes caput_wire ← _read_source(fons, longitudo_artifacti, 0, 24)
    const list<int<u8>> caput ← _byte_list(caput_wire)
    if ((_u8_value(caput, 0) ≠ MAGIC_0 or _u8_value(caput, 1) ≠ MAGIC_1) or _u8_value(caput, 2) ≠ MAGIC_2) or _u8_value(caput, 3) ≠ MAGIC_3 {
        throw variant FormatMala {message = "not a GGUF file — bad magic"}
    }
    const int versio ← _u32(caput, 4)
    if versio ≠ GGUF_VERSION {
        throw variant VersioIgnota {message = "unsupported GGUF version: " + (versio ↦ string)}
    }
    const int tensorum ← _u64(caput, 8)
    const int kv_num ← _u64(caput, 16)
    if tensorum ≻ TENSORUM_LIMES or kv_num ≻ KV_LIMES {
        throw variant LimitesMala {message = "GGUF count exceeds the bounded limit"}
    }
    var int cursor ← 24
    var list<GgufMetadata> metadata ← vacua
    var list<string> claves ← vacua
    var int i ← 0
    while i ≺ kv_num {
        const bytes key_head_wire ← _read_source(fons, longitudo_artifacti, cursor, 8)
        const int key_len ← _u64(_byte_list(key_head_wire), 0)
        if key_len ≻ NOMEN_LIMES {
            throw variant LimitesMala {message = "metadata key exceeds the bounded length"}
        }
        cursor ← _add(cursor, 8)
        const bytes key_body_wire ← _read_source(fons, longitudo_artifacti, cursor, key_len)
        const string key ← _texto(_byte_list(key_body_wire), 0, key_len)
        if _contains(claves, key) {
            throw variant ClavisDuplicata {message = "duplicate GGUF metadata key: " + key}
        }
        claves.append(key)
        cursor ← _add(cursor, key_len)
        const bytes type_wire ← _read_source(fons, longitudo_artifacti, cursor, 4)
        const int typo ← _u32(_byte_list(type_wire), 0)
        if not _dtype_valid(typo) {
            throw variant WireMala {message = "unknown GGUF metadata value type"}
        }
        cursor ← _add(cursor, 4)
        const bytes value_wire ← _source_value(fons, longitudo_artifacti, cursor, typo, 0)
        metadata.append(GgufMetadata {key = key, dtype = typo, valor_wire = value_wire})
        cursor ← _add(cursor, value_wire.length())
        i ↑
    }
    var int concordatio ← DEFAULT_ALIGNMENT
    const GgufMetadata ∪ null alignment_meta ← _find_metadata(metadata, "general.alignment")
    if alignment_meta not is null {
        const GgufMetadata alignment_value ← alignment_meta coalesce GgufMetadata {key = "", dtype = -1, valor_wire = ||}
        if alignment_value.dtype ≠ GGUF_UINT32 {
            throw variant WireMala {message = "general.alignment must use GGUF UINT32 wire kind"}
        }
        const int alignment ← _wire_count(alignment_value)
        if (alignment ≤ 0 or alignment ≻ 4294967295) or not _power_two(alignment) {
            throw variant WireMala {message = "general.alignment must be a positive power of two"}
        }
        concordatio ← alignment
    }
    var list<GgufTensorDescriptor> tensores ← vacua
    var list<string> nomina ← vacua
    var int t ← 0
    while t ≺ tensorum {
        const bytes name_head_wire ← _read_source(fons, longitudo_artifacti, cursor, 8)
        const int name_len ← _u64(_byte_list(name_head_wire), 0)
        if name_len ≻ NOMEN_LIMES {
            throw variant LimitesMala {message = "tensor name exceeds the bounded length"}
        }
        cursor ← _add(cursor, 8)
        const bytes name_body_wire ← _read_source(fons, longitudo_artifacti, cursor, name_len)
        const string name ← _texto(_byte_list(name_body_wire), 0, name_len)
        if name.length() ≡ 0 {
            throw variant WireMala {message = "empty tensor name"}
        }
        if _contains(nomina, name) {
            throw variant TensorDuplicatum {message = "duplicate GGUF tensor name: " + name}
        }
        nomina.append(name)
        cursor ← _add(cursor, name_len)
        const bytes rank_wire ← _read_source(fons, longitudo_artifacti, cursor, 4)
        const int rank ← _u32(_byte_list(rank_wire), 0)
        cursor ← _add(cursor, 4)
        if rank ≡ 0 {
            throw variant LimitesMala {message = "tensor rank must be at least one"}
        }
        if rank ≻ RANK_LIMES {
            throw variant LimitesMala {message = "tensor rank exceeds the bounded limit"}
        }
        var list<int> forma ← vacua
        var int d ← 0
        while d ≺ rank {
            const bytes dim_wire ← _read_source(fons, longitudo_artifacti, cursor, 8)
            const int dim ← _u64(_byte_list(dim_wire), 0)
            if dim ≤ 0 or dim ≻ DIMENSI_LIMES {
                throw variant LimitesMala {message = "tensor dimension is outside the bounded range"}
            }
            forma.append(dim)
            cursor ← _add(cursor, 8)
            d ↑
        }
        const bytes ggml_wire ← _read_source(fons, longitudo_artifacti, cursor, 4)
        const int typo_ggml ← _u32(_byte_list(ggml_wire), 0)
        cursor ← _add(cursor, 4)
        const bytes offset_wire ← _read_source(fons, longitudo_artifacti, cursor, 8)
        const int offset ← _u64(_byte_list(offset_wire), 0)
        cursor ← _add(cursor, 8)
        const int elementa ← _elements(forma)
        const GgmlLayout lay ← layout(typo_ggml, forma)
        tensores.append(GgufTensorDescriptor {name = name, shape = forma, dtype_ggml = typo_ggml, offset_relativum = offset, elements = elementa, layout = lay})
        t ↑
    }
    return _construct(identitas, longitudo_artifacti, versio, concordatio, cursor, cursor, metadata, tensores)
}

# Read an exact, bounded fragment of one known-layout tensor. `initium` and
# `longitudo` are relative to the tensor's payload; the source receives only
# the checked absolute range and is not retained in the returned octeti.
@ public { }
fn read_fragmentum(GgufManifest m, string nomen, int initium, int longitudo, (int, int) → SourceRead fons) → bytes ⇥ GgufManifestError {
    if initium ≺ 0 or longitudo ≺ 0 {
        throw variant OffsetMala {message = "tensor fragment range is negative"}
    }
    const GgufTensorDescriptor tensor ← inveni_tensorem(m, nomen)
    match tensor.layout {
        case Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            if initium ≻ longitudo_octetorum or longitudo ≻ longitudo_octetorum - initium {
                throw variant OffsetMala {message = "tensor fragment range exceeds the known tensor"}
            }
            const int rel ← _add(tensor.offset_relativum, initium)
            const int absolute ← _add(m.data_inceptum, rel)
            const int finis ← _add(absolute, longitudo)
            if absolute ≻ m.artifact_length or finis ≻ m.artifact_length {
                throw variant OffsetMala {message = "tensor fragment range exceeds the artifact"}
            }
            return _read_source(fons, m.artifact_length, absolute, longitudo)
        }
        case Ignota const typo {
            throw variant LayoutIgnota {message = "tensor layout is unknown; payload fragment is unavailable"}
        }
    }
}
