+++
locale = "la"
+++
# Co-located package test for tensor_view.fab (GGUF-A3 C2-U3 — typed tensor
# view + fail-closed bind; C2-U4 — windowed materializer + cap; C2-U5 —
# single-block materializer probe).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the positive bind produces a VisumTensoris
# carrying the manifest-derived view facts (name, physical type id, logical
# element count, absolute payload start, stored payload length), and each of
# the five fail-closed bind rows type-checks through the typed error render:
# unknown name -> NomineIgnota, absolute-range mismatch -> RangeMala,
# stored-length mismatch -> LongitudoMala, unknown layout -> LayoutIgnota,
# un-admitted physical type -> TypoIgnotum. Imported-union variant
# construction is blocked by the pinned compiler defect (SEM001+SEM008), so
# the fail-closed cases flow through vincula's own error channel instead of
# constructing VisioError values directly; adfirma assertions run under the
# cargo-backed `faber test` harness (auditor-owned), while `faber check`
# proves the whole surface type-checks.
#
# C2-U4 windowed materializer: the `_slicem` helper and its cases pin the
# window contract (whole-block reads in GGUF block order, window bounds /
# alignment / cap / source-failure / malformed-block fail-closed rows).
# C2-U5 single-block probe: the `_glomulum` helper and its cases pin the
# block-index contract (first-block probe, out-of-range / negative index /
# source-failure / malformed-block fail-closed rows).
# COMPILER BOUNDARY NOTE: a proba call site cannot pass a function value to
# a module function whose parameter type is a function type — the call does
# not resolve (SEM010), the same pinned seam as gguf_manifest.proba's
# inspice/lege_fragmentum calls. `materializa_slicem` and
# `materializa_glomulum` type-check in the module itself and are callable
# from package consumers (exempla, C3-U1); the `_slicem`/`_glomulum` calls
# below document the intended surface and their assertions run under the
# auditor-owned `faber test` harness.

importa ex "gradus:model/artifact" artifact
importa ex "gradus:model/gguf_manifest" manifestum
importa ex "gradus:model/tensor_payload" tensor_payload
importa ex "gradus:model/tensor_view" tensor_view

fixum textus F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

functio _u32(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>,
        ((n ⇒ 16) % 256) ∷ numerus<u8>,
        ((n ⇒ 24) % 256) ∷ numerus<u8>
    ]
}

functio _u64(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>,
        ((n ⇒ 16) % 256) ∷ numerus<u8>,
        ((n ⇒ 24) % 256) ∷ numerus<u8>,
        ((n ⇒ 32) % 256) ∷ numerus<u8>,
        ((n ⇒ 40) % 256) ∷ numerus<u8>,
        ((n ⇒ 48) % 256) ∷ numerus<u8>,
        ((n ⇒ 56) % 256) ∷ numerus<u8>
    ]
}

functio _iunge(lista<numerus<u8>> a, lista<numerus<u8>> b) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    itera ex a fixum x { out.appende(x) }
    itera ex b fixum x { out.appende(x) }
    redde out
}

functio _textus_bytes(textus s) → lista<numerus<u8>> {
    # Package MIR has no textus→octeti extraction arm. This structural
    # builder only needs a finite ASCII corpus, so keep its encoding explicit.
    si s ≡ "token_embd.weight" ergo redde [116,111,107,101,110,95,101,109,98,100,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_norm.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ "blk.0.experts.0.weight" ergo redde [98,108,107,46,48,46,101,120,112,101,114,116,115,46,48,46,119,101,105,103,104,116]
    si s ≡ "no.such.tensor" ergo redde [110,111,46,115,117,99,104,46,116,101,110,115,111,114]
    redde []
}

functio _str(textus s) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> b ← _textus_bytes(s)
    redde _iunge(_u64(b.longitudo()), b)
}

functio _tensor(textus name, lista<numerus> forma, numerus typo, numerus offset) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← _iunge(_str(name), _u32(forma.longitudo()))
    itera ex forma fixum dim { out ← _iunge(out, _u64(dim)) }
    redde _iunge(_iunge(out, _u32(typo)), _u64(offset))
}

functio _caput(numerus tensorum, numerus metadata) → lista<numerus<u8>> {
    redde _iunge(
        _iunge([0x47, 0x47, 0x55, 0x46], _u32(3)),
        _iunge(_u64(tensorum), _u64(metadata))
    )
}

functio _cum_padding(lista<numerus<u8>> table, numerus concordatio, numerus total) → manifestum.CorpusGguf {
    fixum numerus data_offset ← ((table.longitudo() + concordatio - 1) / concordatio) * concordatio
    varia lista<numerus<u8>> b ← table
    dum b.longitudo() < data_offset { b.appende(0 ∷ numerus<u8>) }
    fixum octeti o ← b
    redde manifestum.CorpusGguf {
        tabula = o,
        longitudo_artifacti = total,
        identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = total }
    }
}

# llama-like corpus: F32 token_embd.weight [4,8]@0 and F16
# blk.0.attn_norm.weight [8]@160. Data section starts at 160.
functio _corpus_llama() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 0)
    table ← _iunge(table, _tensor("token_embd.weight", [4, 8], 0, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [8], 1, 160))
    redde _cum_padding(table, 32, 336)
}

# qwen35moe-like corpus: Ignota-layout blk.0.experts.0.weight [2,3,4]@0 (typo
# 999) and BF16 blk.0.attn_norm.weight [2,2]@64. Data section starts at 160.
functio _corpus_qwen35moe() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 0)
    table ← _iunge(table, _tensor("blk.0.experts.0.weight", [2, 3, 4], 999, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [2, 2], 30, 64))
    redde _cum_padding(table, 32, 232)
}

# Q8_0 corpus for the materializer: token_embd.weight [64] typo 8 (Q8_0,
# 32 elements/block, 34 bytes/block) -> 2 blocks, 68 payload bytes. Data
# section starts at 96 (DEFAULT_ALIGNMENT 32), artifact total 164.
functio _corpus_q8() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("token_embd.weight", [64], 8, 0))
    redde _cum_padding(table, 32, 164)
}

# Render one bind attempt as "name/typo/elementa/initium/longitudo" or the
# typed VisioError render.
functio _visum(manifestum.CorpusGguf corpus, textus nomen, numerus initium, numerus longitudo) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
                nomen = nomen,
                initium_absolutum = initium,
                longitudo = longitudo,
                bytes = ||
            }
            fixum tensor_view.VisumTensoris v ← tensor_view.vincula(m, p)
            redde v.nomen + "/" + (v.typo_ggml ↦ textus) + "/" + (v.elementa ↦ textus) + "/" + (v.initium_absolutum ↦ textus) + "/" + (v.longitudo_payloadis ↦ textus)
        }
        cape err { redde "ERR:" + tensor_view.causa(err) }
    }
    cape err { redde "ERR:" + manifestum.causa(err) }
}

# Deterministic zero-filled payload source. Zero blocks decode to valid
# zero-valued f32 elements for every admitted codec (never a NaN), so a
# positive window materializes and only its element count is observable.
functio _fons_zero(numerus initium, numerus longitudo) → manifestum.LectioFontis {
    varia octeti out ← ||
    varia numerus i ← 0
    dum i < longitudo {
        out.appende(0 ∷ numerus<u8>)
        i ← i + 1
    }
    redde manifestum.LectioFontis { successus = verum, bytes = out, causa = "" }
}

# Source whose first block carries a NaN half (0x7E00) -> dequant ValorMala.
functio _fons_nan(numerus initium, numerus longitudo) → manifestum.LectioFontis {
    varia octeti out ← ||
    out.appende(0 ∷ numerus<u8>)
    out.appende(126 ∷ numerus<u8>)
    varia numerus i ← 2
    dum i < longitudo {
        out.appende(0 ∷ numerus<u8>)
        i ← i + 1
    }
    redde manifestum.LectioFontis { successus = verum, bytes = out, causa = "" }
}

# Failing source: the read never succeeds.
functio _fons_defecta(numerus initium, numerus longitudo) → manifestum.LectioFontis {
    redde manifestum.LectioFontis { successus = falsum, bytes = ||, causa = "synthetic read failed" }
}

# Render one windowed materialization as "ok:<element count>" or the typed
# VisioError render.
functio _slicem(manifestum.CorpusGguf corpus, textus nomen, numerus initium, numerus longitudo, numerus initium_elementum, numerus longitudo_elementum, (numerus, numerus) → manifestum.LectioFontis fons) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
                nomen = nomen,
                initium_absolutum = initium,
                longitudo = longitudo,
                bytes = ||
            }
            fixum tensor_view.VisumTensoris v ← tensor_view.vincula(m, p)
            fixum lista<f32> out ← tensor_view.materializa_slicem(v, initium_elementum, longitudo_elementum, fons)
            redde "ok:" + (out.longitudo() ↦ textus)
        }
        cape err { redde "ERR:" + tensor_view.causa(err) }
    }
    cape err { redde "ERR:" + manifestum.causa(err) }
}

probandum "tensor_view bind and fail-closed matrix proof" {
    proba "positive bind carries the manifest-derived view facts" {
        adfirma _visum(_corpus_llama(), "token_embd.weight", 160, 128) ≡ "token_embd.weight/0/32/160/128"
        adfirma _visum(_corpus_qwen35moe(), "blk.0.attn_norm.weight", 224, 8) ≡ "blk.0.attn_norm.weight/30/4/224/8"
    }

    proba "unknown name fails closed as NomineIgnota" {
        adfirma _visum(_corpus_llama(), "no.such.tensor", 160, 128) ≡ "ERR:tensor not found: no.such.tensor"
    }

    proba "absolute-range mismatch fails closed as RangeMala" {
        adfirma _visum(_corpus_llama(), "token_embd.weight", 161, 128) ≡ "ERR:payload start does not match the manifest tensor range"
    }

    proba "stored-length mismatch fails closed as LongitudoMala" {
        adfirma _visum(_corpus_llama(), "token_embd.weight", 160, 127) ≡ "ERR:payload length does not match the stored layout length"
    }

    proba "unknown layout fails closed as LayoutIgnota" {
        adfirma _visum(_corpus_qwen35moe(), "blk.0.experts.0.weight", 0, 0) ≡ "ERR:tensor layout is unknown; payload range is unavailable"
    }

    proba "un-admitted physical type fails closed as TypoIgnotum" {
        adfirma _visum(_corpus_llama(), "blk.0.attn_norm.weight", 320, 16) ≡ "ERR:un-admitted GGML type id: 1"
    }
}

# Render one single-block materialization as "ok:<element count>" or the
# typed VisioError render.
functio _glomulum(manifestum.CorpusGguf corpus, textus nomen, numerus initium, numerus longitudo, numerus index_glomuli, (numerus, numerus) → manifestum.LectioFontis fons) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
                nomen = nomen,
                initium_absolutum = initium,
                longitudo = longitudo,
                bytes = ||
            }
            fixum tensor_view.VisumTensoris v ← tensor_view.vincula(m, p)
            fixum lista<f32> out ← tensor_view.materializa_glomulum(v, index_glomuli, fons)
            redde "ok:" + (out.longitudo() ↦ textus)
        }
        cape err { redde "ERR:" + tensor_view.causa(err) }
    }
    cape err { redde "ERR:" + manifestum.causa(err) }
}

probandum "tensor_view windowed materializer proof" {
    proba "positive window reads whole blocks in GGUF block order" {
        adfirma _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 32, _fons_zero) ≡ "ok:32"
        adfirma _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 32, 32, _fons_zero) ≡ "ok:32"
        adfirma _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 64, _fons_zero) ≡ "ok:64"
    }

    proba "window bounds failure fails closed as LimitesMala" {
        adfirma _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 65, _fons_zero) ≡ "ERR:element window exceeds the tensor"
        adfirma _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 64, 32, _fons_zero) ≡ "ERR:element window exceeds the tensor"
        adfirma _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, -1, _fons_zero) ≡ "ERR:element window is negative"
    }

    proba "block-misaligned window fails closed as OrdoMala" {
        adfirma _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 1, 31, _fons_zero) ≡ "ERR:element window is not aligned to the tensor block boundary"
        adfirma _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 33, _fons_zero) ≡ "ERR:element window is not aligned to the tensor block boundary"
    }

    proba "over-cap window fails closed as LimitesMala" {
        adfirma tensor_view.MAXIMUM_SLICEM_ELEMENTA ≡ 16777216
        adfirma _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 16777217, _fons_zero) ≡ "ERR:element window exceeds the bounded slice cap"
    }

    proba "source failure fails closed as RangeMala" {
        adfirma _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 32, _fons_defecta) ≡ "ERR:payload range source failed: synthetic read failed"
    }

    proba "malformed block bytes fail closed as RangeMala" {
        adfirma _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 32, _fons_nan) ≡ "ERR:block value decode failed: NaN half in dequant block"
    }
}

probandum "tensor_view single-block materializer proof" {
    proba "first-block probe dequantizes one block in GGUF block order" {
        adfirma _glomulum(_corpus_q8(), "token_embd.weight", 96, 68, 0, _fons_zero) ≡ "ok:32"
        adfirma _glomulum(_corpus_q8(), "token_embd.weight", 96, 68, 1, _fons_zero) ≡ "ok:32"
    }

    proba "out-of-range block index fails closed as LimitesMala" {
        adfirma _glomulum(_corpus_q8(), "token_embd.weight", 96, 68, 2, _fons_zero) ≡ "ERR:block index exceeds the tensor block count"
        adfirma _glomulum(_corpus_q8(), "token_embd.weight", 96, 68, -1, _fons_zero) ≡ "ERR:block index is negative"
    }

    proba "source failure fails closed as RangeMala" {
        adfirma _glomulum(_corpus_q8(), "token_embd.weight", 96, 68, 0, _fons_defecta) ≡ "ERR:payload range source failed: synthetic read failed"
    }

    proba "malformed block bytes fail closed as RangeMala" {
        adfirma _glomulum(_corpus_q8(), "token_embd.weight", 96, 68, 0, _fons_nan) ≡ "ERR:block value decode failed: NaN half in dequant block"
    }
}
