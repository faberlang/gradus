+++
locale = "en"
+++
# Co-located package test for tensor_view.fab (GGUF-A3 C2-U3 — typed tensor
# view + fail-closed bind; C2-U4 — windowed materializer + cap; C2-U5 —
# single-block materializer probe).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the positive bind produces a VisumTensoris
# carrying the manifest-derived view facts (name, physical type id, logical
# element count, absolute payload start, stored payload length), and each of
# the five fail-closed bind rows type-checks through the typed error render:
# unknown name -> NomineIgnota, absolute-range mismatch -> RangeMala,
# stored-length mismatch -> LongitudoMala, unknown layout -> LayoutIgnota,
# un-admitted physical type -> TypoIgnotum. Imported-union variant
# construction is blocked by the pinned compiler defect (SEM001+SEM008), so
# the fail-closed cases flow through vincula's own error channel instead of
# constructing VisioError values directly; adfirma assertions run under the
# cargo-backed `faber test` harness (auditor-owned), while `faber check`
# proves the whole surface type-checks.
#
# C2-U4 windowed materializer: the `_slicem` helper and its cases pin the
# window contract (whole-block reads in GGUF block order, window bounds /
# alignment / cap / source-failure / malformed-block fail-closed rows).
# C2-U5 single-block probe: the `_glomulum` helper and its cases pin the
# block-index contract (first-block probe, out-of-range / negative index /
# source-failure / malformed-block fail-closed rows).
# COMPILER BOUNDARY NOTE: a proba call site cannot pass a function value to
# a module function whose parameter type is a function type — the call does
# not resolve (SEM010), the same pinned seam as gguf_manifest.proba's
# inspice/lege_fragmentum calls. `materializa_slicem` and
# `materializa_glomulum` type-check in the module itself and are callable
# from package consumers (exempla, C3-U1); the `_slicem`/`_glomulum` calls
# below document the intended surface and their assertions run under the
# auditor-owned `faber test` harness.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" manifestum

import from "gradus:model/tensor_payload" tensor_payload

import from "gradus:model/tensor_view" tensor_view

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn _u32(int n) → list<int<u8>> {
    return [n % 256 ∷ int<u8>, (n ⇒ 8) % 256 ∷ int<u8>, (n ⇒ 16) % 256 ∷ int<u8>, (n ⇒ 24) % 256 ∷ int<u8>]
}

fn _u64(int n) → list<int<u8>> {
    return [n % 256 ∷ int<u8>, (n ⇒ 8) % 256 ∷ int<u8>, (n ⇒ 16) % 256 ∷ int<u8>, (n ⇒ 24) % 256 ∷ int<u8>, (n ⇒ 32) % 256 ∷ int<u8>, (n ⇒ 40) % 256 ∷ int<u8>, (n ⇒ 48) % 256 ∷ int<u8>, (n ⇒ 56) % 256 ∷ int<u8>]
}

fn _iunge(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

fn _textus_bytes(string s) → list<int<u8>> {
    # Package MIR has no textus→octeti extraction arm. This structural
    # builder only needs a finite ASCII corpus, so keep its encoding explicit.
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_norm.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.experts.0.weight" then return [98, 108, 107, 46, 48, 46, 101, 120, 112, 101, 114, 116, 115, 46, 48, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "no.such.tensor" then return [110, 111, 46, 115, 117, 99, 104, 46, 116, 101, 110, 115, 111, 114]
    return []
}

fn _str(string s) → list<int<u8>> {
    const list<int<u8>> b ← _textus_bytes(s)
    return _iunge(_u64(b.length()), b)
}

fn _tensor(string name, list<int> forma, int typo, int offset) → list<int<u8>> {
    var list<int<u8>> out ← _iunge(_str(name), _u32(forma.length()))
    for from forma const dim {
        out ← _iunge(out, _u64(dim))
    }
    return _iunge(_iunge(out, _u32(typo)), _u64(offset))
}

fn _caput(int tensorum, int metadata) → list<int<u8>> {
    return _iunge(_iunge([71, 71, 85, 70], _u32(3)), _iunge(_u64(tensorum), _u64(metadata)))
}

fn _cum_padding(list<int<u8>> table, int concordatio, int total) → manifestum.CorpusGguf {
    const int data_offset ← (((table.length() + concordatio) - 1) / concordatio) * concordatio
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← b
    return manifestum.CorpusGguf {tabula = o, longitudo_artifacti = total, identitas = artifact.IdentitasContenuti {algorithmus = "sha-256", digestio = F_DIGEST, longitudo = total}}
}

# llama-like corpus: F32 token_embd.weight [4,8]@0 and F16
# blk.0.attn_norm.weight [8]@160. Data section starts at 160.
fn _corpus_llama() → manifestum.CorpusGguf {
    var list<int<u8>> table ← _caput(2, 0)
    table ← _iunge(table, _tensor("token_embd.weight", [4, 8], 0, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [8], 1, 160))
    return _cum_padding(table, 32, 336)
}

# qwen35moe-like corpus: Ignota-layout blk.0.experts.0.weight [2,3,4]@0 (typo
# 999) and BF16 blk.0.attn_norm.weight [2,2]@64. Data section starts at 160.
fn _corpus_qwen35moe() → manifestum.CorpusGguf {
    var list<int<u8>> table ← _caput(2, 0)
    table ← _iunge(table, _tensor("blk.0.experts.0.weight", [2, 3, 4], 999, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [2, 2], 30, 64))
    return _cum_padding(table, 32, 232)
}

# Q8_0 corpus for the materializer: token_embd.weight [64] typo 8 (Q8_0,
# 32 elements/block, 34 bytes/block) -> 2 blocks, 68 payload bytes. Data
# section starts at 96 (DEFAULT_ALIGNMENT 32), artifact total 164.
fn _corpus_q8() → manifestum.CorpusGguf {
    var list<int<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("token_embd.weight", [64], 8, 0))
    return _cum_padding(table, 32, 164)
}

# Render one bind attempt as "name/typo/elementa/initium/longitudo" or the
# typed VisioError render.
fn _visum(manifestum.CorpusGguf corpus, string nomen, int initium, int longitudo) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {nomen = nomen, initium_absolutum = initium, longitudo = longitudo, bytes = ||}
            const tensor_view.VisumTensoris v ← tensor_view.vincula(m, p)
            return (((((((v.nomen + "/") + (v.typo_ggml ↦ string)) + "/") + (v.elementa ↦ string)) + "/") + (v.initium_absolutum ↦ string)) + "/") + (v.longitudo_payloadis ↦ string)
        }
        catch err {
            return "ERR:" + tensor_view.causa(err)
        }
    }
    catch err {
        return "ERR:" + manifestum.causa(err)
    }
}

# Deterministic zero-filled payload source. Zero blocks decode to valid
# zero-valued f32 elements for every admitted codec (never a NaN), so a
# positive window materializes and only its element count is observable.
fn _fons_zero(int initium, int longitudo) → manifestum.LectioFontis {
    var bytes out ← ||
    var int i ← 0
    while i ≺ longitudo {
        out.append(0 ∷ int<u8>)
        i ← i + 1
    }
    return manifestum.LectioFontis {successus = true, bytes = out, causa = ""}
}

# Source whose first block carries a NaN half (0x7E00) -> dequant ValorMala.
fn _fons_nan(int initium, int longitudo) → manifestum.LectioFontis {
    var bytes out ← ||
    out.append(0 ∷ int<u8>)
    out.append(126 ∷ int<u8>)
    var int i ← 2
    while i ≺ longitudo {
        out.append(0 ∷ int<u8>)
        i ← i + 1
    }
    return manifestum.LectioFontis {successus = true, bytes = out, causa = ""}
}

# Failing source: the read never succeeds.
fn _fons_defecta(int initium, int longitudo) → manifestum.LectioFontis {
    return manifestum.LectioFontis {successus = false, bytes = ||, causa = "synthetic read failed"}
}

# Render one windowed materialization as "ok:<element count>" or the typed
# VisioError render.
fn _slicem(manifestum.CorpusGguf corpus, string nomen, int initium, int longitudo, int initium_elementum, int longitudo_elementum, (int, int) → manifestum.LectioFontis fons) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {nomen = nomen, initium_absolutum = initium, longitudo = longitudo, bytes = ||}
            const tensor_view.VisumTensoris v ← tensor_view.vincula(m, p)
            const list<f32> out ← tensor_view.materializa_slicem(v, initium_elementum, longitudo_elementum, fons)
            return "ok:" + (out.length() ↦ string)
        }
        catch err {
            return "ERR:" + tensor_view.causa(err)
        }
    }
    catch err {
        return "ERR:" + manifestum.causa(err)
    }
}

test "positive bind carries the manifest-derived view facts" {
    assert _visum(_corpus_llama(), "token_embd.weight", 160, 128) ≡ "token_embd.weight/0/32/160/128"
    assert _visum(_corpus_qwen35moe(), "blk.0.attn_norm.weight", 224, 8) ≡ "blk.0.attn_norm.weight/30/4/224/8"
}

test "unknown name fails closed as NomineIgnota" {
    assert _visum(_corpus_llama(), "no.such.tensor", 160, 128) ≡ "ERR:tensor not found: no.such.tensor"
}

test "absolute-range mismatch fails closed as RangeMala" {
    assert _visum(_corpus_llama(), "token_embd.weight", 161, 128) ≡ "ERR:payload start does not match the manifest tensor range"
}

test "stored-length mismatch fails closed as LongitudoMala" {
    assert _visum(_corpus_llama(), "token_embd.weight", 160, 127) ≡ "ERR:payload length does not match the stored layout length"
}

test "unknown layout fails closed as LayoutIgnota" {
    assert _visum(_corpus_qwen35moe(), "blk.0.experts.0.weight", 0, 0) ≡ "ERR:tensor layout is unknown; payload range is unavailable"
}

test "un-admitted physical type fails closed as TypoIgnotum" {
    assert _visum(_corpus_llama(), "blk.0.attn_norm.weight", 320, 16) ≡ "ERR:un-admitted GGML type id: 1"
}

# Render one single-block materialization as "ok:<element count>" or the
# typed VisioError render.
fn _glomulum(manifestum.CorpusGguf corpus, string nomen, int initium, int longitudo, int index_glomuli, (int, int) → manifestum.LectioFontis fons) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {nomen = nomen, initium_absolutum = initium, longitudo = longitudo, bytes = ||}
            const tensor_view.VisumTensoris v ← tensor_view.vincula(m, p)
            const list<f32> out ← tensor_view.materializa_glomulum(v, index_glomuli, fons)
            return "ok:" + (out.length() ↦ string)
        }
        catch err {
            return "ERR:" + tensor_view.causa(err)
        }
    }
    catch err {
        return "ERR:" + manifestum.causa(err)
    }
}

test "positive window reads whole blocks in GGUF block order" {
    assert _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 32, _fons_zero) ≡ "ok:32"
    assert _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 32, 32, _fons_zero) ≡ "ok:32"
    assert _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 64, _fons_zero) ≡ "ok:64"
}

test "window bounds failure fails closed as LimitesMala" {
    assert _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 65, _fons_zero) ≡ "ERR:element window exceeds the tensor"
    assert _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 64, 32, _fons_zero) ≡ "ERR:element window exceeds the tensor"
    assert _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, -1, _fons_zero) ≡ "ERR:element window is negative"
}

test "block-misaligned window fails closed as OrdoMala" {
    assert _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 1, 31, _fons_zero) ≡ "ERR:element window is not aligned to the tensor block boundary"
    assert _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 33, _fons_zero) ≡ "ERR:element window is not aligned to the tensor block boundary"
}

test "over-cap window fails closed as LimitesMala" {
    assert tensor_view.MAXIMUM_SLICEM_ELEMENTA ≡ 16777216
    assert _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 16777217, _fons_zero) ≡ "ERR:element window exceeds the bounded slice cap"
}

test "source failure fails closed as RangeMala" {
    assert _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 32, _fons_defecta) ≡ "ERR:payload range source failed: synthetic read failed"
}

test "malformed block bytes fail closed as RangeMala" {
    assert _slicem(_corpus_q8(), "token_embd.weight", 96, 68, 0, 32, _fons_nan) ≡ "ERR:block value decode failed: NaN half in dequant block"
}

test "first-block probe dequantizes one block in GGUF block order" {
    assert _glomulum(_corpus_q8(), "token_embd.weight", 96, 68, 0, _fons_zero) ≡ "ok:32"
    assert _glomulum(_corpus_q8(), "token_embd.weight", 96, 68, 1, _fons_zero) ≡ "ok:32"
}

test "out-of-range block index fails closed as LimitesMala" {
    assert _glomulum(_corpus_q8(), "token_embd.weight", 96, 68, 2, _fons_zero) ≡ "ERR:block index exceeds the tensor block count"
    assert _glomulum(_corpus_q8(), "token_embd.weight", 96, 68, -1, _fons_zero) ≡ "ERR:block index is negative"
}

test "source failure fails closed as RangeMala" {
    assert _glomulum(_corpus_q8(), "token_embd.weight", 96, 68, 0, _fons_defecta) ≡ "ERR:payload range source failed: synthetic read failed"
}

test "malformed block bytes fail closed as RangeMala" {
    assert _glomulum(_corpus_q8(), "token_embd.weight", 96, 68, 0, _fons_nan) ≡ "ERR:block value decode failed: NaN half in dequant block"
}
