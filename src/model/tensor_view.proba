+++
locale = "en"
+++
# Co-located package test for tensor_view.fab (GGUF-A3 C2-U3 — typed tensor
# view + fail-closed bind; C2-U4 — windowed materializer + cap; C2-U5 —
# single-block materializer probe).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the positive bind produces a TensorView
# carrying the manifest-derived view facts (name, physical type id, logical
# element count, absolute payload start, stored payload length), and each of
# the five fail-closed bind rows type-checks through the typed error render:
# unknown name -> UnknownName, absolute-range mismatch -> BadRange,
# stored-length mismatch -> BadLength, unknown layout -> UnknownLayout,
# un-admitted physical type -> UnknownDtype. Imported-union variant
# construction is blocked by the pinned compiler defect (SEM001+SEM008), so
# the fail-closed cases flow through links's own error channel instead of
# constructing ViewError values directly; assert assertions run under the
# cargo-backed `faber test` harness (auditor-owned), while `faber check`
# proves the whole surface type-checks.
#
# C2-U4 windowed materializer: the `_slice` helper and its cases pin the
# window contract (whole-block reads in GGUF block order, window bounds /
# alignment / cap / source-failure / malformed-block fail-closed rows).
# C2-U5 single-block probe: the `_block` helper and its cases pin the
# block-index contract (first-block probe, out-of-range / negative index /
# source-failure / malformed-block fail-closed rows).
# COMPILER BOUNDARY NOTE: a proba call site cannot pass a function value to
# a module function whose parameter type is a function type — the call does
# not resolve (SEM010), the same pinned seam as gguf_manifest.proba's
# inspect/read_fragment calls. `materialize_slice` and
# `materialize_block` type-check in the module itself and are callable
# from package consumers (exempla, C3-U1); the `_slice`/`_block` calls
# below document the intended surface and their assertions run under the
# auditor-owned `faber test` harness.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" gguf_manifest

import from "gradus:model/tensor_payload" tensor_payload

import from "gradus:model/tensor_view" tensor_view

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn _u32(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>]
}

fn _u64(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>, ((n ⇒ 32) % 256) ∷ int<u8>, ((n ⇒ 40) % 256) ∷ int<u8>, ((n ⇒ 48) % 256) ∷ int<u8>, ((n ⇒ 56) % 256) ∷ int<u8>]
}

fn _join(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

fn _text_bytes(string s) → list<int<u8>> {
    # Package MIR has no text→bytes extraction arm. This structural
    # builder only needs a finite ASCII corpus, so keep its encoding explicit.
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_norm.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.experts.0.weight" then return [98, 108, 107, 46, 48, 46, 101, 120, 112, 101, 114, 116, 115, 46, 48, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "no.such.tensor" then return [110, 111, 46, 115, 117, 99, 104, 46, 116, 101, 110, 115, 111, 114]
    return []
}

fn _str(string s) → list<int<u8>> {
    const list<int<u8>> b ← _text_bytes(s)
    return _join(_u64(b.length()), b)
}

fn _tensor(string name, list<int> shape, int kind, int offset) → list<int<u8>> {
    var list<int<u8>> out ← _join(_str(name), _u32(shape.length()))
    for from shape const dim {
        out ← _join(out, _u64(dim))
    }
    return _join(_join(out, _u32(kind)), _u64(offset))
}

fn _header(int tensors, int metadata) → list<int<u8>> {
    return _join(_join([71, 71, 85, 70], _u32(3)), _join(_u64(tensors), _u64(metadata)))
}

fn _with_padding(list<int<u8>> table, int alignment, int total) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← b
    return gguf_manifest.GgufCorpus {table = o, artifact_length = total, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = total}}
}

# llama-like corpus: F32 token_embd.weight [4,8]@0 and F16
# blk.0.attn_norm.weight [8]@160. Data section starts at 160.
fn _corpus_llama() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(2, 0)
    table ← _join(table, _tensor("token_embd.weight", [4, 8], 0, 0))
    table ← _join(table, _tensor("blk.0.attn_norm.weight", [8], 1, 160))
    return _with_padding(table, 32, 336)
}

# Q4_0 (GGML id 2) stays outside the dequant admitted set. Used only as
# the fail-closed UnknownDtype oracle after W1-U3 admitted F16 (id 1).
fn _corpus_q4_0() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _join(table, _tensor("blk.0.attn_norm.weight", [32], 2, 0))
    return _with_padding(table, 32, 256)
}

# qwen35moe-like corpus: Unknown-layout blk.0.experts.0.weight [2,3,4]@0 (kind
# 999) and BF16 blk.0.attn_norm.weight [2,2]@64. Data section starts at 160.
fn _corpus_qwen35moe() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(2, 0)
    table ← _join(table, _tensor("blk.0.experts.0.weight", [2, 3, 4], 999, 0))
    table ← _join(table, _tensor("blk.0.attn_norm.weight", [2, 2], 30, 64))
    return _with_padding(table, 32, 232)
}

# Q8_0 corpus for the materializer: token_embd.weight [64] kind 8 (Q8_0,
# 32 elements/block, 34 bytes/block) -> 2 blocks, 68 payload bytes. Data
# section starts at 96 (DEFAULT_ALIGNMENT 32), artifact total 164.
fn _corpus_q8() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _join(table, _tensor("token_embd.weight", [64], 8, 0))
    return _with_padding(table, 32, 164)
}

# Render one bind attempt as "name/kind/elements/start/length" or the
# typed ViewError render.
fn _view(gguf_manifest.GgufCorpus corpus, string name, int start, int length) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {name = name, absolute_start = start, length = length, bytes = ||}
            const tensor_view.TensorView v ← tensor_view.links(m, p)
            return (((((((v.name + "/") + (v.dtype_ggml ↦ string)) + "/") + (v.elements ↦ string)) + "/") + (v.absolute_start ↦ string)) + "/") + (v.payload_length ↦ string)
        }
        catch err {
            return "ERR:" + tensor_view.message(err)
        }
    }
    catch err {
        return "ERR:" + gguf_manifest.message(err)
    }
}

# Deterministic zero-filled payload source. Zero blocks decode to valid
# zero-valued f32 elements for every admitted codec (never a NaN), so a
# positive window materializes and only its element count is observable.
fn _source_zero(int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    var bytes out ← ||
    var int i ← 0
    while i ≺ length {
        out.append(0 ∷ int<u8>)
        i ← i + 1
    }
    return out
}

# Source whose first block carries a NaN half (0x7E00) -> dequant BadPayload.
fn _source_nan(int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    var bytes out ← ||
    out.append(0 ∷ int<u8>)
    out.append(126 ∷ int<u8>)
    var int i ← 2
    while i ≺ length {
        out.append(0 ∷ int<u8>)
        i ← i + 1
    }
    return out
}

# Failing source: the read never succeeds.
fn _source_failed(int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    throw variant BadSource {message = "synthetic read failed"}
}

# Render one windowed materialization as "ok:<element count>" or the typed
# ViewError render.
fn _slice(gguf_manifest.GgufCorpus corpus, string name, int start, int length, int element_start, int element_length, (int, int) → bytes ⇥ gguf_manifest.GgufManifestError source) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {name = name, absolute_start = start, length = length, bytes = ||}
            const tensor_view.TensorView v ← tensor_view.links(m, p)
            const list<f32> out ← tensor_view.materialize_slice(v, element_start, element_length, source)
            return "ok:" + (out.length() ↦ string)
        }
        catch err {
            return "ERR:" + tensor_view.message(err)
        }
    }
    catch err {
        return "ERR:" + gguf_manifest.message(err)
    }
}

test "positive bind carries the manifest-derived view facts" {
    assert _view(_corpus_llama(), "token_embd.weight", 160, 128) ≡ "token_embd.weight/0/32/160/128"
    assert _view(_corpus_llama(), "blk.0.attn_norm.weight", 320, 16) ≡ "blk.0.attn_norm.weight/1/8/320/16"
    assert _view(_corpus_qwen35moe(), "blk.0.attn_norm.weight", 224, 8) ≡ "blk.0.attn_norm.weight/30/4/224/8"
}

test "unknown name fails closed as UnknownName" {
    assert _view(_corpus_llama(), "no.such.tensor", 160, 128) ≡ "ERR:tensor not found: no.such.tensor"
}

test "absolute-range mismatch fails closed as BadRange" {
    assert _view(_corpus_llama(), "token_embd.weight", 161, 128) ≡ "ERR:payload start does not match the manifest tensor range"
}

test "stored-length mismatch fails closed as BadLength" {
    assert _view(_corpus_llama(), "token_embd.weight", 160, 127) ≡ "ERR:payload length does not match the stored layout length"
}

test "unknown layout fails closed as UnknownLayout" {
    assert _view(_corpus_qwen35moe(), "blk.0.experts.0.weight", 0, 0) ≡ "ERR:tensor layout is unknown; payload range is unavailable"
}

test "un-admitted physical type fails closed as UnknownDtype" {
    assert _view(_corpus_q4_0(), "blk.0.attn_norm.weight", 0, 18) ≡ "ERR:un-admitted GGML type id: 2"
}

# Render one single-block materialization as "ok:<element count>" or the
# typed ViewError render.
fn _block(gguf_manifest.GgufCorpus corpus, string name, int start, int length, int block_index, (int, int) → bytes ⇥ gguf_manifest.GgufManifestError source) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {name = name, absolute_start = start, length = length, bytes = ||}
            const tensor_view.TensorView v ← tensor_view.links(m, p)
            const list<f32> out ← tensor_view.materialize_block(v, block_index, source)
            return "ok:" + (out.length() ↦ string)
        }
        catch err {
            return "ERR:" + tensor_view.message(err)
        }
    }
    catch err {
        return "ERR:" + gguf_manifest.message(err)
    }
}

test "positive window reads whole blocks in GGUF block order" {
    assert _slice(_corpus_q8(), "token_embd.weight", 96, 68, 0, 32, _source_zero) ≡ "ok:32"
    assert _slice(_corpus_q8(), "token_embd.weight", 96, 68, 32, 32, _source_zero) ≡ "ok:32"
    assert _slice(_corpus_q8(), "token_embd.weight", 96, 68, 0, 64, _source_zero) ≡ "ok:64"
}

test "window bounds failure fails closed as BadBounds" {
    assert _slice(_corpus_q8(), "token_embd.weight", 96, 68, 0, 65, _source_zero) ≡ "ERR:element window exceeds the tensor"
    assert _slice(_corpus_q8(), "token_embd.weight", 96, 68, 64, 32, _source_zero) ≡ "ERR:element window exceeds the tensor"
    assert _slice(_corpus_q8(), "token_embd.weight", 96, 68, 0, -1, _source_zero) ≡ "ERR:element window is negative"
}

test "block-misaligned window fails closed as BadOrder" {
    assert _slice(_corpus_q8(), "token_embd.weight", 96, 68, 1, 31, _source_zero) ≡ "ERR:element window is not aligned to the tensor block boundary"
    assert _slice(_corpus_q8(), "token_embd.weight", 96, 68, 0, 33, _source_zero) ≡ "ERR:element window is not aligned to the tensor block boundary"
}

test "over-cap window fails closed as BadBounds" {
    assert tensor_view.MAXIMUM_SLICE_ELEMENTS ≡ 16777216
    assert _slice(_corpus_q8(), "token_embd.weight", 96, 68, 0, 16777217, _source_zero) ≡ "ERR:element window exceeds the bounded slice cap"
}

test "source failure fails closed as BadRange" {
    assert _slice(_corpus_q8(), "token_embd.weight", 96, 68, 0, 32, _source_failed) ≡ "ERR:payload range source failed: synthetic read failed"
}

test "malformed block bytes fail closed as BadRange" {
    assert _slice(_corpus_q8(), "token_embd.weight", 96, 68, 0, 32, _source_nan) ≡ "ERR:block value decode failed: NaN half in dequant block"
}

test "first-block probe dequantizes one block in GGUF block order" {
    assert _block(_corpus_q8(), "token_embd.weight", 96, 68, 0, _source_zero) ≡ "ok:32"
    assert _block(_corpus_q8(), "token_embd.weight", 96, 68, 1, _source_zero) ≡ "ok:32"
}

test "out-of-range block index fails closed as BadBounds" {
    assert _block(_corpus_q8(), "token_embd.weight", 96, 68, 2, _source_zero) ≡ "ERR:block index exceeds the tensor block count"
    assert _block(_corpus_q8(), "token_embd.weight", 96, 68, -1, _source_zero) ≡ "ERR:block index is negative"
}

test "source failure fails closed as BadRange" {
    assert _block(_corpus_q8(), "token_embd.weight", 96, 68, 0, _source_failed) ≡ "ERR:payload range source failed: synthetic read failed"
}

test "malformed block bytes fail closed as BadRange" {
    assert _block(_corpus_q8(), "token_embd.weight", 96, 68, 0, _source_nan) ≡ "ERR:block value decode failed: NaN half in dequant block"
}
