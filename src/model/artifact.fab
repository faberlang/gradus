+++ toml
locale = "en"

+++ faber
# Pathless artifact identity for model-format inspection.
#
# Public import: import from "gradus:model/artifact" private artifact
#
# This module deliberately carries only content identity. It does not own a
# path, URL, reader, file handle, memory map, host/device object, or payload.
# A source adapter supplies bounded bytes separately for every parse call.

@ public
union ArtifactError {
    @ shared
    string message

    UnknownAlgorithm,
    BadDigest,
    BadLength
}

@ public
class ContentIdentity {
    mut string algorithm
    mut string digest
    mut int length
}

fn digest_ok(string digest) → bool {
    if digest.length() ≢ 64 then return false

    for from digest let c {
        if not (c ≥ '0' and c ≤ '9' or c ≥ 'a' and c ≤ 'f') then return false
    }

    return true
}

@ public
fn identity(string algorithm, string digest, int length) → ContentIdentity ⇥ ArtifactError {
    require algorithm ≡ "sha-256" throw variant UnknownAlgorithm { message = "unknown content identity algorithm: §"(algorithm) }

    require digest_ok(digest) throw variant BadDigest { message = "content digest must be 64 lower-case hexadecimal digits" }

    require length ≻ 0 throw variant BadLength { message = "content length must be positive" }

    return ContentIdentity { algorithm = algorithm, digest = digest, length = length }
}

+++ faber test
# Structural proof for the pathless content-identity surface. `faber check`
# proves this source type-checks; the focused `faber test` route remains
# auditor-owned because the imported-library provider seam is not executable
# in the current lane.

import from "gradus:model/artifact" artifact

fn identity_result(string algorithm, string digest, int length) → string {
    do {
        artifact.identity(algorithm, digest, length)
        return "ok"
    }
    catch err {
        return err.message
    }
}

test "accepts a content identity" {
    do {
        let artifact.ContentIdentity i ← artifact.identity("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 128)
        assert i.algorithm ≡ "sha-256"
        assert i.length ≡ 128
    }
    catch err {
        assert false
    }
}

test "rejects invalid algorithm, digest, and length claims" {
    assert identity_result("blake3", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 128) ≡ "unknown content identity algorithm: blake3"
    assert identity_result("sha-256", "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", 128) ≡ "content digest must be 64 lower-case hexadecimal digits"
    assert identity_result("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 128) ≡ "content digest must be 64 lower-case hexadecimal digits"
    assert identity_result("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 0) ≡ "content length must be positive"
}
