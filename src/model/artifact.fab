+++
locale = "en"
+++
# Pathless artifact identity for model-format inspection.
#
# Public import: import from "gradus:model/artifact" private artifact
#
# This module deliberately carries only content identity. It does not own a
# path, URL, reader, file handle, memory map, host/device object, or payload.
# A source adapter supplies bounded bytes separately for every parse call.

@ public
union ArtifactError {
    @ shared
    string message

    UnknownAlgorithm,
    BadDigest,
    BadLength
}

@ public
class ContentIdentity {
    string algorithm
    string digest
    int length
}

fn _hex(string c) → bool {
    return c between "0123456789abcdef"
}

fn _digest_ok(string digest) → bool {
    if digest.length() ≠ 64 then return false
    for range 0 ‥ digest.length() const i {
        if not _hex(digest.slice(i, i + 1)) then return false
    }
    return true
}

@ public
fn identity(string algorithm, string digest, int length) → ContentIdentity ⇥ ArtifactError {
    require algorithm ≡ "sha-256" throw variant UnknownAlgorithm { message = "unknown content identity algorithm: §"(algorithm) }
    require _digest_ok(digest) throw variant BadDigest { message = "content digest must be 64 lower-case hexadecimal digits" }
    require length ≻ 0 throw variant BadLength { message = "content length must be positive" }
    return ContentIdentity { algorithm = algorithm, digest = digest, length = length }
}
