+++
locale = "la"
+++
# Pathless artifact identity for model-format inspection.
#
# Public import: importa ex "gradus:model/artifact" privata artifact
#
# This module deliberately carries only content identity. It does not own a
# path, URL, reader, file handle, memory map, host/device object, or payload.
# A source adapter supplies bounded bytes separately for every parse call.

discretio ArtifactError {
    AlgorithmusIgnotus { textus causa },
    DigestioMala { textus causa },
    LongitudoMala { textus causa }
}

@ publica
genus IdentitasContenuti {
    textus algorithmus
    textus digestio
    numerus longitudo
}

@ publica
functio causa(ArtifactError e) → textus {
    discerne e {
        casu AlgorithmusIgnotus fixum causa { redde causa }
        casu DigestioMala fixum causa { redde causa }
        casu LongitudoMala fixum causa { redde causa }
    }
}

@ privata
functio _hex(textus c) → bivalens {
    si c ≡ "0" aut c ≡ "1" aut c ≡ "2" aut c ≡ "3" aut c ≡ "4" aut c ≡ "5" aut c ≡ "6" aut c ≡ "7" aut c ≡ "8" aut c ≡ "9" ergo redde verum
    si c ≡ "a" aut c ≡ "b" aut c ≡ "c" aut c ≡ "d" aut c ≡ "e" aut c ≡ "f" ergo redde verum
    redde falsum
}

@ privata
functio _digestio_recta(textus digestio) → bivalens {
    si digestio.longitudo() ≠ 64 ergo redde falsum
    varia numerus i ← 0
    dum i < digestio.longitudo() {
        si non (_hex(digestio.sectio(i, i + 1))) ergo redde falsum
        i ← i + 1
    }
    redde verum
}

@ publica
functio identitas(textus algorithmus, textus digestio, numerus longitudo) → IdentitasContenuti ⇥ ArtifactError {
    si algorithmus ≠ "sha-256" {
        iace finge AlgorithmusIgnotus { causa = "unknown content identity algorithm: " + algorithmus }
    }
    si non (_digestio_recta(digestio)) {
        iace finge DigestioMala { causa = "content digest must be 64 lower-case hexadecimal digits" }
    }
    si longitudo ≤ 0 {
        iace finge LongitudoMala { causa = "content length must be positive" }
    }
    redde IdentitasContenuti {
        algorithmus = algorithmus,
        digestio = digestio,
        longitudo = longitudo
    }
}
