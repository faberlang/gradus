+++
locale = "en"
+++
# Pathless artifact identity for model-format inspection.
#
# Public import: importa ex "gradus:model/artifact" privata artifact
#
# This module deliberately carries only content identity. It does not own a
# path, URL, reader, file handle, memory map, host/device object, or payload.
# A source adapter supplies bounded bytes separately for every parse call.

union ArtifactError {
    AlgorithmusIgnotus {
        string message
    },
    DigestioMala {
        string message
    },
    LongitudoMala {
        string message
    }
}

@ public { }
class ContentIdentity {
    string algorithm
    string digest
    int length
}

@ public { }
fn message(ArtifactError e) → string {
    match e {
        case AlgorithmusIgnotus const causa {
            return causa
        }
        case DigestioMala const causa {
            return causa
        }
        case LongitudoMala const causa {
            return causa
        }
    }
}

@ private { }
fn _hex(string c) → bool {
    if ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9" then return true
    if ((((c ≡ "a" or c ≡ "b") or c ≡ "c") or c ≡ "d") or c ≡ "e") or c ≡ "f" then return true
    return false
}

@ private { }
fn _digest_ok(string digestio) → bool {
    if digestio.length() ≠ 64 then return false
    var int i ← 0
    while i ≺ digestio.length() {
        if not _hex(digestio.slice(i, i + 1)) then return false
        i ← i + 1
    }
    return true
}

@ public { }
fn identitas(string algorithmus, string digestio, int longitudo) → ContentIdentity ⇥ ArtifactError {
    if algorithmus ≠ "sha-256" {
        throw variant AlgorithmusIgnotus {message = "unknown content identity algorithm: " + algorithmus}
    }
    if not _digest_ok(digestio) {
        throw variant DigestioMala {message = "content digest must be 64 lower-case hexadecimal digits"}
    }
    if longitudo ≤ 0 {
        throw variant LongitudoMala {message = "content length must be positive"}
    }
    return ContentIdentity {algorithm = algorithmus, digest = digestio, length = longitudo}
}
