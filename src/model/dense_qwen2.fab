+++
locale = "en"
+++
# REF-01-U1.7 — typed `qwen2` (Qwen2.5) architecture adapter.
#
# The canonical dense tensor-name family for a qwen2 row: each canonical
# HF-style name (`model.embed_tokens`, `model.layers.{N}.input_layernorm`,
# `.self_attn.{q,k,v,o}_proj`, `.post_attention_layernorm`,
# `.mlp.{gate,up,down}_proj`, `model.norm`, `lm_head`) resolves to the exact
# GGUF-A1b manifest descriptor the A1b inspect surface reports for the
# pinned Qwen2.5-0.5B row. The qwen2 deltas over the llama family: lm_head
# tie status is read from the tensor set (`output.weight` present -> untied,
# absent -> tied, the gi0-model-contract precedent), the GQA head config
# (`qwen2.attention.head_count_kv`), and rope_theta frozen at 1000000 (the
# qwen2 family fact; `qwen2.rope.freq_base` is a float wire value the
# integer accessor preserves but does not decode). Fails closed with typed
# diagnostics on unknown canonical names, out-of-range layers, missing
# tensors, and non-qwen2 manifests.
#
# Public import: importa ex "gradus:model/dense_qwen2" dense_qwen2
# Depends on: gradus:model/gguf_manifest (A1b manifest + descriptor surface).

import from "gradus:model/gguf_manifest" manifestum

# Frozen architecture config for a qwen2 row, read from the manifest
# metadata facts. theta is the frozen qwen2 family delta (1000000); ligatum
# is read from the tensor set (gi0-model-contract §2.2 precedent).

@ public { }
class ConfiguraDensaQwen2 {
    int strata
    int capita
    int capita_kv
    int dimensio_capitis
    int dimensio_occulta
    int vocabulum
    int theta
    bool ligatum
}

@ public { }
union DenseQwen2Error {
    ArchaegrammaIgnota {
        string causa
    },
    CanonicoIgnota {
        string causa
    },
    StratumExtraLimitem {
        string causa
    },
    TensorAbsens {
        string causa
    },
    ConfiguraMala {
        string causa
    }
}

@ public { }
fn causa(DenseQwen2Error e) → string {
    match e {
        case ArchaegrammaIgnota const causa {
            return causa
        }
        case CanonicoIgnota const causa {
            return causa
        }
        case StratumExtraLimitem const causa {
            return causa
        }
        case TensorAbsens const causa {
            return causa
        }
        case ConfiguraMala const causa {
            return causa
        }
    }
}

# First occurrence of `quid` in `ubi` at or after `ab` (character indices),
# or -1 when absent — the reference's std::string::find (tokenizer seam).
@ private { }
fn _inveni(string ubi, string quid, int ab) → int {
    const int n ← ubi.length()
    const int m ← quid.length()
    if m ≡ 0 or m ≻ n then return -1
    var int i ← ab
    while i + m ≤ n {
        if ubi.slice(i, i + m) ≡ quid then return i
        i ← i + 1
    }
    return -1
}

# True when every character is an ASCII digit (the canonical layer index is
# a bare digit string; anything else fails closed as an unknown name).
@ private { }
fn _digitorum(string s) → bool {
    if s.length() ≡ 0 then return false
    var int i ← 0
    while i ≺ s.length() {
        const string c ← s.slice(i, i + 1)
        if ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9" {
            i ← i + 1
        }
        else then return false
    }
    return true
}

# Split "model.layers.{N}.suffix" into (layer index, suffix), validating the
# index against the frozen layer count.
@ private { }
fn _stratum(string nomen, int strata) → tuple<int, string> ⇥ DenseQwen2Error {
    const int p ← _inveni(nomen, ".", 13)
    if p ≺ 0 {
        throw variant CanonicoIgnota {causa = "unknown canonical qwen2 tensor name: " + nomen}
    }
    const string digit ← nomen.slice(13, p)
    if not _digitorum(digit) {
        throw variant CanonicoIgnota {causa = "unknown canonical qwen2 tensor name: " + nomen}
    }
    const int stratum ← _digiti_numerus(digit, nomen)
    if stratum ≺ 0 or stratum ≥ strata {
        throw variant StratumExtraLimitem {causa = "layer index out of range for canonical tensor: " + nomen}
    }
    const string suffix ← nomen.slice(p, nomen.length())
    return tuple<int, string> [stratum, suffix]
}

# Bounded digit-string to numerus; the digit guard above already rejected
# malformed text, so a conversion failure here is an internal fault surfaced
# as an unknown canonical name (fail closed).
@ private { }
fn _digiti_numerus(string digit, string nomen) → int ⇥ DenseQwen2Error {
    do {
        return digit ↦ int
    }
    catch err {
        throw variant CanonicoIgnota {causa = "unknown canonical qwen2 tensor name: " + nomen}
    }
}

# Canonical layer-tensor suffix -> GGUF suffix (the canonical family names
# of the dense reference surface).
@ private { }
fn _gguf_suffix(string suffix) → string ⇥ DenseQwen2Error {
    if suffix ≡ ".input_layernorm" then return ".attn_norm.weight"
    if suffix ≡ ".self_attn.q_proj" then return ".attn_q.weight"
    if suffix ≡ ".self_attn.k_proj" then return ".attn_k.weight"
    if suffix ≡ ".self_attn.v_proj" then return ".attn_v.weight"
    if suffix ≡ ".self_attn.o_proj" then return ".attn_output.weight"
    if suffix ≡ ".post_attention_layernorm" then return ".ffn_norm.weight"
    if suffix ≡ ".mlp.gate_proj" then return ".ffn_gate.weight"
    if suffix ≡ ".mlp.up_proj" then return ".ffn_up.weight"
    if suffix ≡ ".mlp.down_proj" then return ".ffn_down.weight"
    throw variant CanonicoIgnota {causa = "unknown canonical qwen2 layer tensor suffix: " + suffix}
}

# Canonical name -> GGUF tensor name. lm_head follows the frozen tie status.
@ private { }
fn _gguf_nomen(ConfiguraDensaQwen2 cfg, string nomen) → string ⇥ DenseQwen2Error {
    if nomen ≡ "model.embed_tokens" then return "token_embd.weight"
    if nomen ≡ "model.norm" then return "output_norm.weight"
    if nomen ≡ "lm_head" {
        if cfg.ligatum then return "token_embd.weight"
        return "output.weight"
    }
    if nomen.length() ≻ 13 {
        if nomen.slice(0, 13) ≡ "model.layers." {
            const tuple<int, string> part ← _stratum(nomen, cfg.strata)
            const string suffix ← _gguf_suffix(part[1])
            return ("blk." + (part[0] ↦ string)) + suffix
        }
    }
    throw variant CanonicoIgnota {causa = "unknown canonical qwen2 tensor name: " + nomen}
}

# Manifest metadata string fact, mapped to the typed diagnostic channel.
@ private { }
fn _textum_factum(manifestum.ManifestumGguf m, string clavis) → string ⇥ DenseQwen2Error {
    do {
        return manifestum.textum(m, clavis)
    }
    catch err {
        match err {
            case manifestum.WireMala const causa {
                throw variant ConfiguraMala {causa = "qwen2 metadata fact unavailable: " + clavis}
            }
            case _ {
                throw variant ConfiguraMala {causa = "qwen2 metadata fact unavailable: " + clavis}
            }
        }
    }
}

# Manifest metadata integer fact, mapped to the typed diagnostic channel.
@ private { }
fn _numerum_factum(manifestum.ManifestumGguf m, string clavis) → int ⇥ DenseQwen2Error {
    do {
        return manifestum.numerum(m, clavis)
    }
    catch err {
        match err {
            case manifestum.WireMala const causa {
                throw variant ConfiguraMala {causa = "qwen2 metadata fact unavailable: " + clavis}
            }
            case _ {
                throw variant ConfiguraMala {causa = "qwen2 metadata fact unavailable: " + clavis}
            }
        }
    }
}

# token_embd.weight descriptor; the canonical embed read for the frozen
# vocabulum fact.
@ private { }
fn _embed(manifestum.ManifestumGguf m) → manifestum.DescriptioTensorisGguf ⇥ DenseQwen2Error {
    do {
        return manifestum.inveni_tensorem(m, "token_embd.weight")
    }
    catch err {
        match err {
            case manifestum.WireMala const causa {
                throw variant TensorAbsens {causa = "canonical model.embed_tokens missing from manifest: token_embd.weight"}
            }
            case _ {
                throw variant TensorAbsens {causa = "canonical model.embed_tokens missing from manifest: token_embd.weight"}
            }
        }
    }
}

# Frozen config from the manifest metadata facts of the pinned qwen2 row.
# Theta is frozen at 1000000 (the qwen2 family delta; the float
# qwen2.rope.freq_base wire value is preserved by the manifest but not
# decoded by the integer accessor). Vocab is the token_embd shape fact.
# Ligatum is read from the tensor set: output.weight present -> untied.
@ public { }
fn configura(manifestum.ManifestumGguf m) → ConfiguraDensaQwen2 ⇥ DenseQwen2Error {
    const string arch ← _textum_factum(m, "general.architecture")
    if arch ≠ "qwen2" {
        throw variant ArchaegrammaIgnota {causa = "architecture is not qwen2: " + arch}
    }
    const int strata ← _numerum_factum(m, "qwen2.block_count")
    const int capita ← _numerum_factum(m, "qwen2.attention.head_count")
    const int capita_kv ← _numerum_factum(m, "qwen2.attention.head_count_kv")
    const int occulta ← _numerum_factum(m, "qwen2.embedding_length")
    if capita ≤ 0 {
        throw variant ConfiguraMala {causa = "qwen2 head count must be positive"}
    }
    const int capitis ← occulta / capita
    const manifestum.DescriptioTensorisGguf embed ← _embed(m)
    if embed.forma.length() ≺ 2 {
        throw variant ConfiguraMala {causa = "qwen2 token_embd.weight must be rank 2"}
    }
    const int vocabulum ← embed.forma.get(1) coalesce 0
    const bool ligatum ← _ligatum(m)
    return ConfiguraDensaQwen2 {strata = strata, capita = capita, capita_kv = capita_kv, dimensio_capitis = capitis, dimensio_occulta = occulta, vocabulum = vocabulum, theta = 1000000, ligatum = ligatum}
}

# Tie status read from the tensor set (gi0-model-contract precedent):
# output.weight present -> untied (falsum), absent -> tied (verum).
@ private { }
fn _ligatum(manifestum.ManifestumGguf m) → bool {
    do {
        manifestum.inveni_tensorem(m, "output.weight")
        return false
    }
    catch err {
        return true
    }
}

# Resolve one canonical tensor name to its exact manifest descriptor,
# failing closed with the canonical name and GGUF name in the diagnostic.
@ public { }
fn resolve(ConfiguraDensaQwen2 cfg, manifestum.ManifestumGguf m, string nomen) → manifestum.DescriptioTensorisGguf ⇥ DenseQwen2Error {
    const string gguf ← _gguf_nomen(cfg, nomen)
    do {
        return manifestum.inveni_tensorem(m, gguf)
    }
    catch err {
        match err {
            case manifestum.WireMala const causa {
                throw variant TensorAbsens {causa = (("canonical " + nomen) + " missing from manifest: ") + gguf}
            }
            case _ {
                throw variant TensorAbsens {causa = (("canonical " + nomen) + " missing from manifest: ") + gguf}
            }
        }
    }
}

# Render the resolved descriptor facts (gguf-name/shape/layout) for the
# executed proof and the proba pins. Module-internal so the imported
# LayoutGgml variants resolve (the A1b proba surface reads facts via the
# module, never by destructuring the imported enum directly).
@ public { }
fn descriptio_render(manifestum.DescriptioTensorisGguf t) → string {
    var string forma ← ""
    const int n ← t.forma.length()
    var int i ← 0
    while i ≺ n {
        if i ≻ 0 {
            forma ← forma + ","
        }
        forma ← forma + (t.forma.get(i) coalesce 0 ↦ string)
        i ← i + 1
    }
    match t.layout {
        case manifestum.Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            return (((t.nomen + "/") + forma) + "/known/") + (elementa_per_blockum ↦ string)
        }
        case manifestum.Ignota const typo {
            return ((t.nomen + "/") + forma) + "/unknown"
        }
    }
}
