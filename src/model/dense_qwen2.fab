}

# Untied variant: the same canonical table plus output.weight.
fn qwen2_soluta() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(18, 5)
    table ← join(table, kv("general.architecture", 8, str("qwen2")))
    table ← join(table, kv("qwen2.block_count", 4, u32(24)))
    table ← join(table, kv("qwen2.attention.head_count", 4, u32(14)))
    table ← join(table, kv("qwen2.attention.head_count_kv", 4, u32(2)))
    table ← join(table, kv("qwen2.embedding_length", 4, u32(896)))
    mut int off ← 0
    table ← join(table, tensor_row("token_embd.weight", [896, 151936], 8, off))
    off ← off + payload_length(8, [896, 151936])
    table ← join(table, tensor_row("output_norm.weight", [896], 0, off))
    off ← off + payload_length(0, [896])
    table ← join(table, tensor_row("blk.0.attn_norm.weight", [896], 0, off))
    off ← off + payload_length(0, [896])
    table ← join(table, tensor_row("blk.0.attn_q.weight", [896, 896], 6, off))
    off ← off + payload_length(6, [896, 896])
    table ← join(table, tensor_row("blk.0.attn_k.weight", [896, 128], 6, off))
    off ← off + payload_length(6, [896, 128])
    table ← join(table, tensor_row("blk.0.attn_v.weight", [896, 128], 8, off))
    off ← off + payload_length(8, [896, 128])
    table ← join(table, tensor_row("blk.0.attn_q.bias", [896], 0, off))
    off ← off + payload_length(0, [896])
    table ← join(table, tensor_row("blk.0.attn_k.bias", [128], 0, off))
    off ← off + payload_length(0, [128])
    table ← join(table, tensor_row("blk.0.attn_v.bias", [128], 0, off))
    off ← off + payload_length(0, [128])
    table ← join(table, tensor_row("blk.0.attn_output.weight", [896, 896], 6, off))
    off ← off + payload_length(6, [896, 896])
    table ← join(table, tensor_row("blk.0.ffn_norm.weight", [896], 0, off))
    off ← off + payload_length(0, [896])
    table ← join(table, tensor_row("blk.0.ffn_gate.weight", [896, 4864], 6, off))
    off ← off + payload_length(6, [896, 4864])
    table ← join(table, tensor_row("blk.0.ffn_up.weight", [896, 4864], 6, off))
    off ← off + payload_length(6, [896, 4864])
    table ← join(table, tensor_row("blk.0.ffn_down.weight", [4864, 896], 14, off))
    off ← off + payload_length(14, [4864, 896])
    table ← join(table, tensor_row("blk.23.attn_norm.weight", [896], 0, off))
    off ← off + payload_length(0, [896])
    table ← join(table, tensor_row("blk.23.attn_q.weight", [896, 896], 6, off))
    off ← off + payload_length(6, [896, 896])
    table ← join(table, tensor_row("blk.23.ffn_down.weight", [4864, 896], 12, off))
    off ← off + payload_length(12, [4864, 896])
    table ← join(table, tensor_row("output.weight", [896, 151936], 8, off))
    off ← off + payload_length(8, [896, 151936])
    return corpus(table, 32, off)
}

# Rejection corpus: architecture is llama, not qwen2.
fn llama() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(1, 1)
    table ← join(table, kv("general.architecture", 8, str("llama")))
    table ← join(table, tensor_row("token_embd.weight", [960, 49152], 8, 0))
    return corpus(table, 32, payload_length(8, [960, 49152]))
}

# Resolution render: gguf-name/shape/layout or a typed error.
fn resolve_render(gguf_manifest.GgufCorpus corpus, string name) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            let dense_qwen2.DenseQwen2Config cfg ← dense_qwen2.config(m)
            let gguf_manifest.GgufTensorDescriptor t ← dense_qwen2.resolve(cfg, m, name)
            return dense_qwen2.render_description(t)
        }
        catch err {
            return err.message
        }
    }
    catch err {
        return err.message
    }
}

fn config_render(gguf_manifest.GgufCorpus corpus) → string {
    do {
        let gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            let dense_qwen2.DenseQwen2Config cfg ← dense_qwen2.config(m)
            return ((((((((((((((cfg.layers ↦ string) + "/") + (cfg.heads ↦ string)) + "/") + (cfg.kv_heads ↦ string)) + "/") + (cfg.head_dim ↦ string)) + "/") + (cfg.hidden_dim ↦ string)) + "/") + (cfg.vocab ↦ string)) + "/") + (cfg.theta ↦ string)) + "/") + (cfg.tied ↦ string)
        }
        catch err {
            return err.message
        }
    }
    catch err {
        return err.message
    }
}

test "freezes the Qwen2.5-0.5B architecture config from the manifest" {
    assert config_render(qwen2_ligata()) ≡ "24/14/2/64/896/151936/1000000/true"
    assert config_render(qwen2_soluta()) ≡ "24/14/2/64/896/151936/1000000/false"
}

test "resolves every canonical tensor name to the exact A1b descriptor facts" {
    assert resolve_render(qwen2_ligata(), "model.embed_tokens") ≡ "token_embd.weight/896,151936/known/32"
    assert resolve_render(qwen2_ligata(), "model.layers.0.input_layernorm") ≡ "blk.0.attn_norm.weight/896/known/1"
    assert resolve_render(qwen2_ligata(), "model.layers.0.self_attn.q_proj") ≡ "blk.0.attn_q.weight/896,896/known/32"
    assert resolve_render(qwen2_ligata(), "model.layers.0.self_attn.k_proj") ≡ "blk.0.attn_k.weight/896,128/known/32"
    assert resolve_render(qwen2_ligata(), "model.layers.0.self_attn.v_proj") ≡ "blk.0.attn_v.weight/896,128/known/32"
    assert resolve_render(qwen2_ligata(), "model.layers.0.self_attn.q_proj.bias") ≡ "blk.0.attn_q.bias/896/known/1"
    assert resolve_render(qwen2_ligata(), "model.layers.0.self_attn.k_proj.bias") ≡ "blk.0.attn_k.bias/128/known/1"
    assert resolve_render(qwen2_ligata(), "model.layers.0.self_attn.v_proj.bias") ≡ "blk.0.attn_v.bias/128/known/1"
    assert resolve_render(qwen2_ligata(), "model.layers.0.self_attn.o_proj") ≡ "blk.0.attn_output.weight/896,896/known/32"
    assert resolve_render(qwen2_ligata(), "model.layers.0.post_attention_layernorm") ≡ "blk.0.ffn_norm.weight/896/known/1"
    assert resolve_render(qwen2_ligata(), "model.layers.0.mlp.gate_proj") ≡ "blk.0.ffn_gate.weight/896,4864/known/32"
    assert resolve_render(qwen2_ligata(), "model.layers.0.mlp.up_proj") ≡ "blk.0.ffn_up.weight/896,4864/known/32"
    assert resolve_render(qwen2_ligata(), "model.layers.0.mlp.down_proj") ≡ "blk.0.ffn_down.weight/4864,896/known/256"
    assert resolve_render(qwen2_ligata(), "model.layers.23.input_layernorm") ≡ "blk.23.attn_norm.weight/896/known/1"
    assert resolve_render(qwen2_ligata(), "model.layers.23.self_attn.q_proj") ≡ "blk.23.attn_q.weight/896,896/known/32"
    assert resolve_render(qwen2_ligata(), "model.layers.23.mlp.down_proj") ≡ "blk.23.ffn_down.weight/4864,896/known/256"
    assert resolve_render(qwen2_ligata(), "model.norm") ≡ "output_norm.weight/896/known/1"
}

test "resolves lm_head from the tensor set: tied row → token_embd, untied row → output" {
    assert resolve_render(qwen2_ligata(), "lm_head") ≡ "token_embd.weight/896,151936/known/32"
    assert resolve_render(qwen2_soluta(), "lm_head") ≡ "output.weight/896,151936/known/32"
}

test "fails closed on unknown canonical names, layer range, and missing tensors" {
    assert resolve_render(qwen2_ligata(), "model.foo") ≡ "unknown canonical qwen2 tensor name: model.foo"
    assert resolve_render(qwen2_ligata(), "model.layers.0.self_attn.x_proj") ≡ "unknown canonical qwen2 layer tensor suffix: .self_attn.x_proj"
    assert resolve_render(qwen2_ligata(), "model.layers.0.self_attn.o_proj.bias") ≡ "unknown canonical qwen2 layer tensor suffix: .self_attn.o_proj.bias"
    assert resolve_render(qwen2_ligata(), "model.layers.24.input_layernorm") ≡ "layer index out of range for canonical tensor: model.layers.24.input_layernorm"
    assert resolve_render(qwen2_ligata(), "model.layers.1.input_layernorm") ≡ "canonical model.layers.1.input_layernorm missing from manifest: blk.1.attn_norm.weight"
}

test "rejects a non-qwen2 manifest with the architecture diagnostic" {
    assert config_render(llama()) ≡ "architecture is not qwen2: llama"
}
