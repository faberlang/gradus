+++
locale = "la"
+++
# REF-01-U1.7 — typed `qwen2` (Qwen2.5) architecture adapter.
#
# The canonical dense tensor-name family for a qwen2 row: each canonical
# HF-style name (`model.embed_tokens`, `model.layers.{N}.input_layernorm`,
# `.self_attn.{q,k,v,o}_proj`, `.post_attention_layernorm`,
# `.mlp.{gate,up,down}_proj`, `model.norm`, `lm_head`) resolves to the exact
# GGUF-A1b manifest descriptor the A1b inspect surface reports for the
# pinned Qwen2.5-0.5B row. The qwen2 deltas over the llama family: lm_head
# tie status is read from the tensor set (`output.weight` present -> untied,
# absent -> tied, the gi0-model-contract precedent), the GQA head config
# (`qwen2.attention.head_count_kv`), and rope_theta frozen at 1000000 (the
# qwen2 family fact; `qwen2.rope.freq_base` is a float wire value the
# integer accessor preserves but does not decode). Fails closed with typed
# diagnostics on unknown canonical names, out-of-range layers, missing
# tensors, and non-qwen2 manifests.
#
# Public import: importa ex "gradus:model/dense_qwen2" dense_qwen2
# Depends on: gradus:model/gguf_manifest (A1b manifest + descriptor surface).

importa ex "gradus:model/gguf_manifest" manifestum

# Frozen architecture config for a qwen2 row, read from the manifest
# metadata facts. theta is the frozen qwen2 family delta (1000000); ligatum
# is read from the tensor set (gi0-model-contract §2.2 precedent).
@ publica
genus ConfiguraDensaQwen2 {
    numerus strata
    numerus capita
    numerus capita_kv
    numerus dimensio_capitis
    numerus dimensio_occulta
    numerus vocabulum
    numerus theta
    bivalens ligatum
}

@ publica
discretio DenseQwen2Error {
    ArchaegrammaIgnota { textus causa }
    CanonicoIgnota { textus causa }
    StratumExtraLimitem { textus causa }
    TensorAbsens { textus causa }
    ConfiguraMala { textus causa }
}

@ publica
functio causa(DenseQwen2Error e) → textus {
    discerne e {
        casu ArchaegrammaIgnota fixum causa { redde causa }
        casu CanonicoIgnota fixum causa { redde causa }
        casu StratumExtraLimitem fixum causa { redde causa }
        casu TensorAbsens fixum causa { redde causa }
        casu ConfiguraMala fixum causa { redde causa }
    }
}

# First occurrence of `quid` in `ubi` at or after `ab` (character indices),
# or -1 when absent — the reference's std::string::find (tokenizer seam).
@ privata
functio _inveni(textus ubi, textus quid, numerus ab) → numerus {
    fixum numerus n ← ubi.longitudo()
    fixum numerus m ← quid.longitudo()
    si m ≡ 0 aut m > n ergo redde -1
    varia numerus i ← ab
    dum i + m ≤ n {
        si ubi.sectio(i, i + m) ≡ quid ergo redde i
        i ← i + 1
    }
    redde -1
}

# True when every character is an ASCII digit (the canonical layer index is
# a bare digit string; anything else fails closed as an unknown name).
@ privata
functio _digitorum(textus s) → bivalens {
    si s.longitudo() ≡ 0 ergo redde falsum
    varia numerus i ← 0
    dum i < s.longitudo() {
        fixum textus c ← s.sectio(i, i + 1)
        si c ≡ "0" aut c ≡ "1" aut c ≡ "2" aut c ≡ "3" aut c ≡ "4" aut c ≡ "5" aut c ≡ "6" aut c ≡ "7" aut c ≡ "8" aut c ≡ "9" {
            i ← i + 1
        } secus {
            redde falsum
        }
    }
    redde verum
}

# Split "model.layers.{N}.suffix" into (layer index, suffix), validating the
# index against the frozen layer count.
@ privata
functio _stratum(textus nomen, numerus strata) → iuncta<numerus, textus> ⇥ DenseQwen2Error {
    fixum numerus p ← _inveni(nomen, ".", 13)
    si p < 0 ergo iace finge CanonicoIgnota { causa = "unknown canonical qwen2 tensor name: " + nomen }
    fixum textus digit ← nomen.sectio(13, p)
    si non (_digitorum(digit)) ergo iace finge CanonicoIgnota { causa = "unknown canonical qwen2 tensor name: " + nomen }
    fixum numerus stratum ← _digiti_numerus(digit, nomen)
    si stratum < 0 aut stratum ≥ strata ergo iace finge StratumExtraLimitem { causa = "layer index out of range for canonical tensor: " + nomen }
    fixum textus suffix ← nomen.sectio(p, nomen.longitudo())
    redde iuncta<numerus, textus> [stratum, suffix]
}

# Bounded digit-string to numerus; the digit guard above already rejected
# malformed text, so a conversion failure here is an internal fault surfaced
# as an unknown canonical name (fail closed).
@ privata
functio _digiti_numerus(textus digit, textus nomen) → numerus ⇥ DenseQwen2Error {
    fac {
        redde digit ↦ numerus
    }
    cape err {
        iace finge CanonicoIgnota { causa = "unknown canonical qwen2 tensor name: " + nomen }
    }
}

# Canonical layer-tensor suffix -> GGUF suffix (the canonical family names
# of the dense reference surface).
@ privata
functio _gguf_suffix(textus suffix) → textus ⇥ DenseQwen2Error {
    si suffix ≡ ".input_layernorm" ergo redde ".attn_norm.weight"
    si suffix ≡ ".self_attn.q_proj" ergo redde ".attn_q.weight"
    si suffix ≡ ".self_attn.k_proj" ergo redde ".attn_k.weight"
    si suffix ≡ ".self_attn.v_proj" ergo redde ".attn_v.weight"
    si suffix ≡ ".self_attn.o_proj" ergo redde ".attn_output.weight"
    si suffix ≡ ".post_attention_layernorm" ergo redde ".ffn_norm.weight"
    si suffix ≡ ".mlp.gate_proj" ergo redde ".ffn_gate.weight"
    si suffix ≡ ".mlp.up_proj" ergo redde ".ffn_up.weight"
    si suffix ≡ ".mlp.down_proj" ergo redde ".ffn_down.weight"
    iace finge CanonicoIgnota { causa = "unknown canonical qwen2 layer tensor suffix: " + suffix }
}

# Canonical name -> GGUF tensor name. lm_head follows the frozen tie status.
@ privata
functio _gguf_nomen(ConfiguraDensaQwen2 cfg, textus nomen) → textus ⇥ DenseQwen2Error {
    si nomen ≡ "model.embed_tokens" ergo redde "token_embd.weight"
    si nomen ≡ "model.norm" ergo redde "output_norm.weight"
    si nomen ≡ "lm_head" {
        si cfg.ligatum ergo redde "token_embd.weight"
        redde "output.weight"
    }
    si nomen.longitudo() > 13 {
        si nomen.sectio(0, 13) ≡ "model.layers." {
            fixum iuncta<numerus, textus> part ← _stratum(nomen, cfg.strata)
            fixum textus suffix ← _gguf_suffix(part[1])
            redde "blk." + (part[0] ↦ textus) + suffix
        }
    }
    iace finge CanonicoIgnota { causa = "unknown canonical qwen2 tensor name: " + nomen }
}

# Manifest metadata string fact, mapped to the typed diagnostic channel.
@ privata
functio _textum_factum(manifestum.ManifestumGguf m, textus clavis) → textus ⇥ DenseQwen2Error {
    fac {
        redde manifestum.textum(m, clavis)
    }
    cape err {
        discerne err {
            casu WireMala fixum causa { iace finge ConfiguraMala { causa = "qwen2 metadata fact unavailable: " + clavis } }
            ceterum { iace finge ConfiguraMala { causa = "qwen2 metadata fact unavailable: " + clavis } }
        }
    }
}

# Manifest metadata integer fact, mapped to the typed diagnostic channel.
@ privata
functio _numerum_factum(manifestum.ManifestumGguf m, textus clavis) → numerus ⇥ DenseQwen2Error {
    fac {
        redde manifestum.numerum(m, clavis)
    }
    cape err {
        discerne err {
            casu WireMala fixum causa { iace finge ConfiguraMala { causa = "qwen2 metadata fact unavailable: " + clavis } }
            ceterum { iace finge ConfiguraMala { causa = "qwen2 metadata fact unavailable: " + clavis } }
        }
    }
}

# token_embd.weight descriptor; the canonical embed read for the frozen
# vocabulum fact.
@ privata
functio _embed(manifestum.ManifestumGguf m) → manifestum.DescriptioTensorisGguf ⇥ DenseQwen2Error {
    fac {
        redde manifestum.inveni_tensorem(m, "token_embd.weight")
    }
    cape err {
        discerne err {
            casu WireMala fixum causa { iace finge TensorAbsens { causa = "canonical model.embed_tokens missing from manifest: token_embd.weight" } }
            ceterum { iace finge TensorAbsens { causa = "canonical model.embed_tokens missing from manifest: token_embd.weight" } }
        }
    }
}

# Frozen config from the manifest metadata facts of the pinned qwen2 row.
# Theta is frozen at 1000000 (the qwen2 family delta; the float
# qwen2.rope.freq_base wire value is preserved by the manifest but not
# decoded by the integer accessor). Vocab is the token_embd shape fact.
# Ligatum is read from the tensor set: output.weight present -> untied.
@ publica
functio configura(manifestum.ManifestumGguf m) → ConfiguraDensaQwen2 ⇥ DenseQwen2Error {
    fixum textus arch ← _textum_factum(m, "general.architecture")
    si arch ≠ "qwen2" ergo iace finge ArchaegrammaIgnota { causa = "architecture is not qwen2: " + arch }
    fixum numerus strata ← _numerum_factum(m, "qwen2.block_count")
    fixum numerus capita ← _numerum_factum(m, "qwen2.attention.head_count")
    fixum numerus capita_kv ← _numerum_factum(m, "qwen2.attention.head_count_kv")
    fixum numerus occulta ← _numerum_factum(m, "qwen2.embedding_length")
    si capita ≤ 0 ergo iace finge ConfiguraMala { causa = "qwen2 head count must be positive" }
    fixum numerus capitis ← occulta / capita
    fixum manifestum.DescriptioTensorisGguf embed ← _embed(m)
    si embed.forma.longitudo() < 2 ergo iace finge ConfiguraMala { causa = "qwen2 token_embd.weight must be rank 2" }
    fixum numerus vocabulum ← embed.forma.accipe(1) vel 0
    fixum bivalens ligatum ← _ligatum(m)
    redde ConfiguraDensaQwen2 {
        strata = strata,
        capita = capita,
        capita_kv = capita_kv,
        dimensio_capitis = capitis,
        dimensio_occulta = occulta,
        vocabulum = vocabulum,
        theta = 1000000,
        ligatum = ligatum
    }
}

# Tie status read from the tensor set (gi0-model-contract precedent):
# output.weight present -> untied (falsum), absent -> tied (verum).
@ privata
functio _ligatum(manifestum.ManifestumGguf m) → bivalens {
    fac {
        fixum manifestum.DescriptioTensorisGguf _ ← manifestum.inveni_tensorem(m, "output.weight")
        redde falsum
    }
    cape err { redde verum }
}

# Resolve one canonical tensor name to its exact manifest descriptor,
# failing closed with the canonical name and GGUF name in the diagnostic.
@ publica
functio resolve(ConfiguraDensaQwen2 cfg, manifestum.ManifestumGguf m, textus nomen) → manifestum.DescriptioTensorisGguf ⇥ DenseQwen2Error {
    fixum textus gguf ← _gguf_nomen(cfg, nomen)
    fac {
        redde manifestum.inveni_tensorem(m, gguf)
    }
    cape err {
        discerne err {
            casu WireMala fixum causa { iace finge TensorAbsens { causa = "canonical " + nomen + " missing from manifest: " + gguf } }
            ceterum { iace finge TensorAbsens { causa = "canonical " + nomen + " missing from manifest: " + gguf } }
        }
    }
}

# Render the resolved descriptor facts (gguf-name/shape/layout) for the
# executed proof and the proba pins. Module-internal so the imported
# LayoutGgml variants resolve (the A1b proba surface reads facts via the
# module, never by destructuring the imported enum directly).
@ publica
functio descriptio_render(manifestum.DescriptioTensorisGguf t) → textus {
    varia textus forma ← ""
    fixum numerus n ← t.forma.longitudo()
    varia numerus i ← 0
    dum i < n {
        si i > 0 { forma ← forma + "," }
        forma ← forma + ((t.forma.accipe(i) vel 0) ↦ textus)
        i ← i + 1
    }
    discerne t.layout {
        casu Cognita fixum elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            redde t.nomen + "/" + forma + "/known/" + (elementa_per_blockum ↦ textus)
        }
        casu Ignota fixum typo {
            redde t.nomen + "/" + forma + "/unknown"
        }
    }
}
