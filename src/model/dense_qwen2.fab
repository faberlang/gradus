+++ toml
locale = "en"

+++ faber
# REF-01-U1.7 — typed `qwen2` (Qwen2.5) architecture adapter.
#
# The canonical dense tensor-name family for a qwen2 row: each canonical
# HF-style name (`model.embed_tokens`, `model.layers.{N}.input_layernorm`,
# `.self_attn.{q,k,v,o}_proj`, `.self_attn.{q,k,v}_proj.bias`,
# `.post_attention_layernorm`, `.mlp.{gate,up,down}_proj`, `model.norm`,
# `lm_head`) resolves to the exact
# GGUF-A1b manifest descriptor the A1b inspect surface reports for the
# pinned Qwen2.5-0.5B row. The qwen2 deltas over the llama family: lm_head
# tie status is read from the tensor set (`output.weight` present -> untied,
# absent -> tied, the gi0-model-contract precedent), the GQA head config
# (`qwen2.attention.head_count_kv`), and rope_theta frozen at 1000000 (the
# qwen2 family fact; `qwen2.rope.freq_base` is a float wire value the
# integer accessor preserves but does not decode). Fails closed with typed
# diagnostics on unknown canonical names, out-of-range layers, missing
# tensors, and non-qwen2 manifests.
#
# Public import: import from "gradus:model/dense_qwen2" dense_qwen2
# Depends on: gradus:model/gguf_manifest (A1b manifest + descriptor surface).

import from "gradus:model/bundle" let bundle
import from "gradus:model/gguf_manifest" let gguf_manifest
import from "gradus:model/tensor_directory" let tensor_directory

# Frozen architecture config for a qwen2 row, read from the manifest
# metadata facts. theta is the frozen qwen2 family delta (1000000); tied
# is read from the tensor set (gi0-model-contract §2.2 precedent).

@ public
class DenseQwen2Config {
    mut int layers
    mut int heads
    mut int kv_heads
    mut int head_dim
    mut int hidden_dim
    mut int vocab
    mut int theta
    mut bool tied
}

@ public
union DenseQwen2Error {
    @ shared
    string message

    UnknownArchitecture,
    UnknownCanonical,
    LayerOutOfRange,
    MissingTensor,
    BadConfig,
    ManifestFailure {
        gguf_manifest.GgufManifestError inner
    }
}

@ conversion
fn from_gguf_manifest_error(gguf_manifest.GgufManifestError err) → DenseQwen2Error {
    return variant ManifestFailure { message = err.message, inner = err }
}

# First occurrence of `needle` in `haystack` at or after `start` (character
# indices), or -1 when absent — the reference's std::string::find
# (tokenizer seam).
fn find(string haystack, string needle, int start) → int {
    let int n ← haystack.length()
    let int m ← needle.length()

    if m ≡ 0 or m ≻ n then return -1

    for range start ‥ n - m + 1 let i {
        if haystack.slice(i, i + m) ≡ needle then return i
    }

    return -1
}

# True when every character is an ASCII digit (the canonical layer index is
# a bare digit string; anything else fails closed as an unknown name).
fn digits(string s) → bool {
    if s.length() ≡ 0 then return false

    for from s let c {
        if not "0123456789".contains(c ↦ string) then return false
    }

    return true
}

# Split "model.layers.{N}.suffix" into (layer index, suffix), validating the
# index against the frozen layer count.
fn layer(string name, int layers) → tuple<layer: int, suffix: string> ⇥ DenseQwen2Error {
    let int p ← find(name, ".", 13)

    require p ≥ 0 throw variant UnknownCanonical { message = "unknown canonical qwen2 tensor name: §"(name) }

    let string digit ← name.slice(13, p)

    require digits(digit) throw variant UnknownCanonical { message = "unknown canonical qwen2 tensor name: §"(name) }

    let int layer ← digit_count(digit, name)

    reject layer ≺ 0 or layer ≥ layers throw variant LayerOutOfRange { message = "layer index out of range for canonical tensor: §"(name) }

    let string suffix ← name.slice(p, name.length())
    return tuple<layer: int, suffix: string> [layer, suffix]
}

# Bounded digit-string to number; the digit guard above already rejected
# malformed text, so a conversion failure here is an internal fault surfaced
# as an unknown canonical name (fail closed).
fn digit_count(string digit, string name) → int ⇥ DenseQwen2Error {
    do {
        return digit ↦ int
    }
    catch err {
        throw variant UnknownCanonical { message = "unknown canonical qwen2 tensor name: §"(name) }
    }
}

# Canonical layer-tensor suffix -> GGUF suffix (the canonical family names
# of the dense reference surface). Qwen2.5 carries real F32 Q/K/V bias
# (`attn_{q,k,v}.bias`); there is no `attn_output.bias`.
fn gguf_suffix(string suffix) → string ⇥ DenseQwen2Error {
    switch suffix {
        case ".input_layernorm" {
            return ".attn_norm.weight"
        }
        case ".self_attn.q_proj" {
            return ".attn_q.weight"
        }
        case ".self_attn.k_proj" {
            return ".attn_k.weight"
        }
        case ".self_attn.v_proj" {
            return ".attn_v.weight"
        }
        case ".self_attn.o_proj" {
            return ".attn_output.weight"
        }
        case ".self_attn.q_proj.bias" {
            return ".attn_q.bias"
        }
        case ".self_attn.k_proj.bias" {
            return ".attn_k.bias"
        }
        case ".self_attn.v_proj.bias" {
            return ".attn_v.bias"
        }
        case ".post_attention_layernorm" {
            return ".ffn_norm.weight"
        }
        case ".mlp.gate_proj" {
            return ".ffn_gate.weight"
        }
        case ".mlp.up_proj" {
            return ".ffn_up.weight"
        }
        case ".mlp.down_proj" {
            return ".ffn_down.weight"
        }
        default {
            throw variant UnknownCanonical { message = "unknown canonical qwen2 layer tensor suffix: §"(suffix) }
        }
    }
}

# Canonical name -> GGUF tensor name. lm_head follows the frozen tie status.
fn gguf_name(DenseQwen2Config cfg, string name) → string ⇥ DenseQwen2Error {
    if name ≡ "model.embed_tokens" then return "token_embd.weight"

    if name ≡ "model.norm" then return "output_norm.weight"

    if name ≡ "lm_head" {
        if cfg.tied then return "token_embd.weight"

        return "output.weight"
    }

    if name.length() ≻ 13 {
        if name.starts_with("model.layers.") {
            let tuple<layer: int, suffix: string> part ← layer(name, cfg.layers)
            let string suffix ← gguf_suffix(part.suffix)
            return "blk.§§"(part.layer ↦ string, suffix)
        }
    }

    throw variant UnknownCanonical { message = "unknown canonical qwen2 tensor name: §"(name) }
}

# Manifest metadata string fact, mapped to the typed diagnostic channel.
fn text_value(gguf_manifest.GgufManifest m, string key) → string ⇥ DenseQwen2Error {
    do {
        return gguf_manifest.text(m, key)
    }
    catch err {
        match err {
            case gguf_manifest.GgufManifestError.NotFound let message {
                throw variant BadConfig { message = "qwen2 metadata fact unavailable: §"(key) }
            }
            case _ {
                throw variant ManifestFailure { message = err.message, inner = err }
            }
        }
    }
}

# Manifest metadata integer fact, mapped to the typed diagnostic channel.
fn number_value(gguf_manifest.GgufManifest m, string key) → int ⇥ DenseQwen2Error {
    do {
        return gguf_manifest.number(m, key)
    }
    catch err {
        match err {
            case gguf_manifest.GgufManifestError.NotFound let message {
                throw variant BadConfig { message = "qwen2 metadata fact unavailable: §"(key) }
            }
            case _ {
                throw variant ManifestFailure { message = err.message, inner = err }
            }
        }
    }
}

# token_embd.weight descriptor; the canonical embed read for the frozen
# vocab fact.
fn embed_descriptor(gguf_manifest.GgufManifest m) → gguf_manifest.GgufTensorDescriptor ⇥ DenseQwen2Error {
    do {
        return gguf_manifest.find_tensor(m, "token_embd.weight")
    }
    catch err {
        match err {
            case gguf_manifest.GgufManifestError.NotFound let message {
                throw variant MissingTensor { message = "canonical model.embed_tokens missing from manifest: token_embd.weight" }
            }
            case _ {
                throw variant ManifestFailure { message = err.message, inner = err }
            }
        }
    }
}

# Frozen config from the manifest metadata facts of the pinned qwen2 row.
# Theta is frozen at 1000000 (the qwen2 family delta; the float
# qwen2.rope.freq_base wire value is preserved by the manifest but not
# decoded by the integer accessor). Vocab is the token_embd shape fact.
# Tie status is read from the tensor set: output.weight present -> untied.
@ public
fn config(gguf_manifest.GgufManifest m) → DenseQwen2Config ⇥ DenseQwen2Error {
    # --- architecture + count facts (fail closed) -------------------------
    let string arch ← text_value(m, "general.architecture")

    require arch ≡ "qwen2" throw variant UnknownArchitecture { message = "architecture is not qwen2: §"(arch) }

    let int layers ← number_value(m, "qwen2.block_count")
    let int heads ← number_value(m, "qwen2.attention.head_count")
    let int kv_heads ← number_value(m, "qwen2.attention.head_count_kv")
    let int hidden_dim ← number_value(m, "qwen2.embedding_length")

    require heads ≻ 0 throw variant BadConfig { message = "qwen2 head count must be positive" }

    let int head_dim ← hidden_dim / heads

    # --- vocab from the embed descriptor ----------------------------------
    let gguf_manifest.GgufTensorDescriptor embed ← embed_descriptor(m)

    require embed.shape.length() ≥ 2 throw variant BadConfig { message = "qwen2 token_embd.weight must be rank 2" }

    let int vocab ← embed.shape.get(1) coalesce 0

    # --- tie status + construct -------------------------------------------
    let bool tied ← tied_flag(m)
    return DenseQwen2Config { layers = layers, heads = heads, kv_heads = kv_heads, head_dim = head_dim, hidden_dim = hidden_dim, vocab = vocab, theta = 1000000, tied = tied }
}

# Tie status read from the tensor set (gi0-model-contract precedent):
# output.weight present -> untied (false), absent (NotFound) -> tied.
# Any other manifest error fails closed instead of pretending the row is tied.
fn tied_flag(gguf_manifest.GgufManifest m) → bool ⇥ DenseQwen2Error {
    do {
        gguf_manifest.find_tensor(m, "output.weight")
        return false
    }
    catch err {
        match err {
            case gguf_manifest.GgufManifestError.NotFound let message {
                return true
            }
            case _ {
                throw variant BadConfig { message = "qwen2 tie status is unreadable: §"(err.message) }
            }
        }
    }
}

# Resolve one canonical tensor name to its exact manifest descriptor,
# failing closed with the canonical name and GGUF name in the diagnostic.
@ public
fn resolve(DenseQwen2Config cfg, gguf_manifest.GgufManifest m, string name) → gguf_manifest.GgufTensorDescriptor ⇥ DenseQwen2Error {
    let string gguf ← gguf_name(cfg, name)

    do {
        return gguf_manifest.find_tensor(m, gguf)
    }
    catch err {
        match err {
            case gguf_manifest.GgufManifestError.NotFound let message {
                throw variant MissingTensor { message = "canonical § missing from manifest: §"(name, gguf) }
            }
            case _ {
                throw variant ManifestFailure { message = err.message, inner = err }
            }
        }
    }
}

# Render the resolved descriptor facts (gguf-name/shape/layout) for the
# executed proof and the proba pins. Module-internal so the imported
# GgmlLayout variants resolve (the A1b proba surface reads facts via the
# module, never by destructuring the imported enum directly).
@ public
fn render_description(gguf_manifest.GgufTensorDescriptor t) → string {
    mut string shape ← ""
    mut bool first ← true

    for from t.shape let dim {
        if not first {
            shape ← shape + ","
        }

        first ← false
        shape ← shape + (dim ↦ string)
    }

    match t.layout {
        case gguf_manifest.GgmlLayout.Known let elements_per_block, bytes_per_block, byte_length {
            return "§/§/known/§"(t.name, shape, elements_per_block ↦ string)
        }
        case gguf_manifest.GgmlLayout.Unknown let kind {
            return "§/§/unknown"(t.name, shape)
        }
    }
}

# Derive DenseQwen2Config from TensorDirectory + admitted artifact dimensions
# (Safetensors or GGUF) without hardcoded checkpoint constants.
@ public
fn config_from_directory(int layers, int heads, int kv_heads, int hidden_dim, int theta, tensor_directory.TensorDirectory dir) → DenseQwen2Config ⇥ DenseQwen2Error {
    require heads ≻ 0 throw variant BadConfig { message = "qwen2 head count must be positive" }

    let int head_dim ← hidden_dim / heads
    let bool tied ← not tensor_directory.has_tensor(dir, variant bundle.MemberRole.Backbone, "lm_head.weight")

    mut tensor_directory.DirectoryEntry ∪ none emb_opt ← null

    do {
        emb_opt ← tensor_directory.lookup_backbone(dir, "model.embed_tokens.weight")
    }
    catch err {
        throw variant MissingTensor { message = err.message }
    }

    require emb_opt not is none throw variant MissingTensor { message = "missing model.embed_tokens.weight" }

    let tensor_directory.DirectoryEntry emb ← emb_opt

    require emb.shape.length() ≥ 2 throw variant BadConfig { message = "qwen2 embed_tokens must be rank 2" }

    let int vocab ← emb.shape.get(0) coalesce 0
    return DenseQwen2Config { layers = layers, heads = heads, kv_heads = kv_heads, head_dim = head_dim, hidden_dim = hidden_dim, vocab = vocab, theta = theta, tied = tied }
}

fn canonical_hf_name(DenseQwen2Config cfg, string name) → string ⇥ DenseQwen2Error {
    if name ≡ "model.embed_tokens" then return "model.embed_tokens.weight"

    if name ≡ "model.norm" then return "model.norm.weight"

    if name ≡ "lm_head" {
        if cfg.tied then return "model.embed_tokens.weight"

        return "lm_head.weight"
    }

    if name.starts_with("model.layers.") {
        let tuple<layer: int, suffix: string> part ← layer(name, cfg.layers)

        if part.suffix ∈ [".input_layernorm", ".self_attn.q_proj", ".self_attn.k_proj", ".self_attn.v_proj", ".self_attn.o_proj", ".post_attention_layernorm", ".mlp.gate_proj", ".mlp.up_proj", ".mlp.down_proj"] {
            return "§.weight"(name)
        }
        elif part.suffix ∈ [".self_attn.q_proj.bias", ".self_attn.k_proj.bias", ".self_attn.v_proj.bias"] {
            return name
        }
        else {
            throw variant UnknownCanonical { message = "unknown canonical qwen2 layer tensor suffix: §"(part.suffix) }
        }
    }

    throw variant UnknownCanonical { message = "unknown canonical qwen2 tensor name: §"(name) }
}

# Resolve one canonical qwen2 tensor name through a TensorDirectory.
@ public
fn resolve_in_directory(tensor_directory.TensorDirectory dir, DenseQwen2Config cfg, string name) → tensor_directory.DirectoryEntry ⇥ DenseQwen2Error {
    let string hf_name ← canonical_hf_name(cfg, name)

    do {
        return tensor_directory.lookup_backbone(dir, hf_name)
    }
    catch err {
        throw variant MissingTensor { message = err.message }
    }
}

+++ faber test
# REF-01-U1.7 — typed `qwen2` (Qwen2.5) architecture adapter, descriptor
# resolution pins.
#
# The proba pins each canonical dense tensor name to the exact manifest
# descriptor facts (GGUF name, shape, layout) the GGUF-A1b inspect surface
# reports for the pinned Qwen2.5-0.5B row, plus the qwen2 deltas (tie status
# read from the tensor set, GQA head config, rope_theta 1000000) and the
# fail-closed rejection rows. Like the A1b precedent, `faber check` proves
# the builders, parse calls, returned-field access, and typed-error branches
# type-check; the current imported-library `faber test` route is
# provider-blocked, so this file makes no executed-value claim. The executed
# proof lives in exempla/dense-qwen2-adapter.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" let gguf_manifest

import from "gradus:model/dense_qwen2" dense_qwen2

const string F_DIGEST = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn u8(int n) → list<u8> {
    return [(n % 256) ↦ u8]
}

fn u16(int n) → list<u8> {
    return [(n % 256) ↦ u8, ((n ⇒ 8) % 256) ↦ u8]
}

fn u32(int n) → list<u8> {
    return [(n % 256) ↦ u8, ((n ⇒ 8) % 256) ↦ u8, ((n ⇒ 16) % 256) ↦ u8, ((n ⇒ 24) % 256) ↦ u8]
}

fn u64(int n) → list<u8> {
    return [(n % 256) ↦ u8, ((n ⇒ 8) % 256) ↦ u8, ((n ⇒ 16) % 256) ↦ u8, ((n ⇒ 24) % 256) ↦ u8, ((n ⇒ 32) % 256) ↦ u8, ((n ⇒ 40) % 256) ↦ u8, ((n ⇒ 48) % 256) ↦ u8, ((n ⇒ 56) % 256) ↦ u8]
}

fn join(list<u8> a, list<u8> b) → list<u8> {
    mut list<u8> out ← empty
    for from a let x {
        out.append(x)
    }
    for from b let x {
        out.append(x)
    }
    return out
}

# Fixture byte encoding for the finite ASCII keys/values this builder uses.
fn text_bytes(string s) → list<u8> {
    if s ≡ "general.architecture" then return [103, 101, 110, 101, 114, 97, 108, 46, 97, 114, 99, 104, 105, 116, 101, 99, 116, 117, 114, 101]
    if s ≡ "qwen2" then return [113, 119, 101, 110, 50]
    if s ≡ "llama" then return [108, 108, 97, 109, 97]
    if s ≡ "qwen2.block_count" then return [113, 119, 101, 110, 50, 46, 98, 108, 111, 99, 107, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen2.attention.head_count" then return [113, 119, 101, 110, 50, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 104, 101, 97, 100, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen2.attention.head_count_kv" then return [113, 119, 101, 110, 50, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 104, 101, 97, 100, 95, 99, 111, 117, 110, 116, 95, 107, 118]
    if s ≡ "qwen2.embedding_length" then return [113, 119, 101, 110, 50, 46, 101, 109, 98, 101, 100, 100, 105, 110, 103, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "output_norm.weight" then return [111, 117, 116, 112, 117, 116, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "output.weight" then return [111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_norm.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_q.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_k.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 107, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_v.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 118, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_q.bias" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 98, 105, 97, 115]
    if s ≡ "blk.0.attn_k.bias" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 107, 46, 98, 105, 97, 115]
    if s ≡ "blk.0.attn_v.bias" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 118, 46, 98, 105, 97, 115]
    if s ≡ "blk.0.attn_output.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_norm.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_gate.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 103, 97, 116, 101, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_up.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 117, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_down.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 100, 111, 119, 110, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.23.attn_norm.weight" then return [98, 108, 107, 46, 50, 51, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.23.attn_q.weight" then return [98, 108, 107, 46, 50, 51, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.23.ffn_down.weight" then return [98, 108, 107, 46, 50, 51, 46, 102, 102, 110, 95, 100, 111, 119, 110, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.24.attn_norm.weight" then return [98, 108, 107, 46, 50, 52, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    return []
}

fn str(string s) → list<u8> {
    let list<u8> b ← text_bytes(s)
    return join(u64(b.length()), b)
}

fn kv(string key, int kind, list<u8> value) → list<u8> {
    return join(join(str(key), u32(kind)), value)
}

fn tensor_row(string name, list<int> shape, int kind, int offset) → list<u8> {
    mut list<u8> out ← join(str(name), u32(shape.length()))
    for from shape let dim {
        out ← join(out, u64(dim))
    }
    return join(join(out, u32(kind)), u64(offset))
}

fn header(int tensors, int metadata) → list<u8> {
    return join(join([71, 71, 85, 70], u32(3)), join(u64(tensors), u64(metadata)))
}

fn bytes_of(list<u8> b) → list<b8> {
    return b ↦ list<b8>
}

fn corpus(list<u8> table, int alignment, int payload) → gguf_manifest.GgufCorpus {
    let int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    mut list<u8> b ← empty
    for from table let x {
        b.append(x)
    }
    while b.length() ≺ data_offset {
        b.append(0 ∷ u8)
    }
    let list<b8> o ← bytes_of(b)
    return gguf_manifest.GgufCorpus {table = o, artifact_length = data_offset + payload, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = data_offset + payload}}
}

# Known GGML payload byte length for the fixture types (mirrors the A1a
# fixture geometry; the manifest layout() facts are asserted separately).
fn payload_length(int kind, list<int> shape) → int {
    mut int elements ← 1
    for from shape let d {
        elements ← elements * d
    }
    if kind ≡ 0 then return elements * 4
    if kind ≡ 6 then return (elements / 32) * 22
    if kind ≡ 8 then return (elements / 32) * 34
    if kind ≡ 12 then return (elements / 256) * 144
    if kind ≡ 14 then return (elements / 256) * 210
    return 0
}

# Synthetic qwen2 manifest with the canonical tensor table for the pinned
# Qwen2.5-0.5B row: layer 0 full + layer 23 boundary, tied embeddings (no
# output.weight). Shapes/types mirror the A1b inspect surface facts.
fn qwen2_ligata() → gguf_manifest.GgufCorpus {
    mut list<u8> table ← header(17, 5)
    table ← join(table, kv("general.architecture", 8, str("qwen2")))
    table ← join(table, kv("qwen2.block_count", 4, u32(24)))
    table ← join(table, kv("qwen2.attention.head_count", 4, u32(14)))
    table ← join(table, kv("qwen2.attention.head_count_kv", 4, u32(2)))
    table ← join(table, kv("qwen2.embedding_length", 4, u32(896)))
    mut int off ← 0
    table ← join(table, tensor_row("token_embd.weight", [896, 151936], 8, off))
