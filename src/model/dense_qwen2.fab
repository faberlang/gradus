+++
locale = "en"
+++
# REF-01-U1.7 — typed `qwen2` (Qwen2.5) architecture adapter.
#
# The canonical dense tensor-name family for a qwen2 row: each canonical
# HF-style name (`model.embed_tokens`, `model.layers.{N}.input_layernorm`,
# `.self_attn.{q,k,v,o}_proj`, `.self_attn.{q,k,v}_proj.bias`,
# `.post_attention_layernorm`, `.mlp.{gate,up,down}_proj`, `model.norm`,
# `lm_head`) resolves to the exact
# GGUF-A1b manifest descriptor the A1b inspect surface reports for the
# pinned Qwen2.5-0.5B row. The qwen2 deltas over the llama family: lm_head
# tie status is read from the tensor set (`output.weight` present -> untied,
# absent -> tied, the gi0-model-contract precedent), the GQA head config
# (`qwen2.attention.head_count_kv`), and rope_theta frozen at 1000000 (the
# qwen2 family fact; `qwen2.rope.freq_base` is a float wire value the
# integer accessor preserves but does not decode). Fails closed with typed
# diagnostics on unknown canonical names, out-of-range layers, missing
# tensors, and non-qwen2 manifests.
#
# Public import: import from "gradus:model/dense_qwen2" dense_qwen2
# Depends on: gradus:model/gguf_manifest (A1b manifest + descriptor surface).

import from "gradus:model/gguf_manifest" gguf_manifest

# Frozen architecture config for a qwen2 row, read from the manifest
# metadata facts. theta is the frozen qwen2 family delta (1000000); tied
# is read from the tensor set (gi0-model-contract §2.2 precedent).

@ public
class DenseQwen2Config {
    int layers
    int heads
    int kv_heads
    int head_dim
    int hidden_dim
    int vocab
    int theta
    bool tied
}

@ public
union DenseQwen2Error {
    @ shared
    string message

    UnknownArchitecture,
    UnknownCanonical,
    LayerOutOfRange,
    MissingTensor,
    BadConfig,
    ManifestFailure {
        gguf_manifest.GgufManifestError inner
    }
}

@ conversion fn from_gguf_manifest_error(gguf_manifest.GgufManifestError err) → DenseQwen2Error {
    return variant ManifestFailure {message = err.message, inner = err}
}



# First occurrence of `quid` in `ubi` at or after `ab` (character indices),
# or -1 when absent — the reference's std::string::find (tokenizer seam).
fn _find(string ubi, string quid, int ab) → int {
    const int n ← ubi.length()
    const int m ← quid.length()
    if m ≡ 0 or m ≻ n then return -1
    var int i ← ab
    while i + m ≤ n {
        if ubi.slice(i, i + m) ≡ quid then return i
        i ← i + 1
    }
    return -1
}

# True when every character is an ASCII digit (the canonical layer index is
# a bare digit string; anything else fails closed as an unknown name).
fn _digits(string s) → bool {
    if s.length() ≡ 0 then return false
    for from s const c {
        if not ((c ↦ string) between "0123456789") then return false
    }
    return true
}

# Split "model.layers.{N}.suffix" into (layer index, suffix), validating the
# index against the frozen layer count.
fn _layer(string name, int layers) → tuple<int, string> ⇥ DenseQwen2Error {
    const int p ← _find(name, ".", 13)
    require p ≥ 0 throw variant UnknownCanonical {message = "unknown canonical qwen2 tensor name: §"(name)}
    const string digit ← name.slice(13, p)
    require _digits(digit) throw variant UnknownCanonical {message = "unknown canonical qwen2 tensor name: §"(name)}
    const int layer ← _digit_count(digit, name)
    require not (layer ≺ 0 or layer ≥ layers) throw variant LayerOutOfRange {message = "layer index out of range for canonical tensor: §"(name)}
    const string suffix ← name.slice(p, name.length())
    return tuple<int, string> [layer, suffix]
}

# Bounded digit-string to number; the digit guard above already rejected
# malformed text, so a conversion failure here is an internal fault surfaced
# as an unknown canonical name (fail closed).
fn _digit_count(string digit, string name) → int ⇥ DenseQwen2Error {
    do {
        return digit ↦ int
    }
    catch err {
        throw variant UnknownCanonical {message = "unknown canonical qwen2 tensor name: §"(name)}
    }
}

# Canonical layer-tensor suffix -> GGUF suffix (the canonical family names
# of the dense reference surface). Qwen2.5 carries real F32 Q/K/V bias
# (`attn_{q,k,v}.bias`); there is no `attn_output.bias`.
fn _gguf_suffix(string suffix) → string ⇥ DenseQwen2Error {
    if suffix ≡ ".input_layernorm" then return ".attn_norm.weight"
    if suffix ≡ ".self_attn.q_proj" then return ".attn_q.weight"
    if suffix ≡ ".self_attn.k_proj" then return ".attn_k.weight"
    if suffix ≡ ".self_attn.v_proj" then return ".attn_v.weight"
    if suffix ≡ ".self_attn.o_proj" then return ".attn_output.weight"
    if suffix ≡ ".self_attn.q_proj.bias" then return ".attn_q.bias"
    if suffix ≡ ".self_attn.k_proj.bias" then return ".attn_k.bias"
    if suffix ≡ ".self_attn.v_proj.bias" then return ".attn_v.bias"
    if suffix ≡ ".post_attention_layernorm" then return ".ffn_norm.weight"
    if suffix ≡ ".mlp.gate_proj" then return ".ffn_gate.weight"
    if suffix ≡ ".mlp.up_proj" then return ".ffn_up.weight"
    if suffix ≡ ".mlp.down_proj" then return ".ffn_down.weight"
    throw variant UnknownCanonical {message = "unknown canonical qwen2 layer tensor suffix: §"(suffix)}
}

# Canonical name -> GGUF tensor name. lm_head follows the frozen tie status.
fn _gguf_name(DenseQwen2Config cfg, string name) → string ⇥ DenseQwen2Error {
    if name ≡ "model.embed_tokens" then return "token_embd.weight"
    if name ≡ "model.norm" then return "output_norm.weight"
    if name ≡ "lm_head" {
        if cfg.tied then return "token_embd.weight"
        return "output.weight"
    }
    if name.length() ≻ 13 {
        if name.slice(0, 13) ≡ "model.layers." {
            const tuple<int, string> part ← _layer(name, cfg.layers)
            const string suffix ← _gguf_suffix(part[1])
            return "blk.§§"(part[0] ↦ string, suffix)
        }
    }
    throw variant UnknownCanonical {message = "unknown canonical qwen2 tensor name: §"(name)}
}

# Manifest metadata string fact, mapped to the typed diagnostic channel.
fn _text_value(gguf_manifest.GgufManifest m, string key) → string ⇥ DenseQwen2Error {
    do {
        return gguf_manifest.text(m, key)
    }
    catch err {
        match err {
            case gguf_manifest.NotFound const message {
                throw variant BadConfig {message = "qwen2 metadata fact unavailable: §"(key)}
            }
            case _ {
                throw variant ManifestFailure {message = err.message, inner = err}
            }
        }
    }
}

# Manifest metadata integer fact, mapped to the typed diagnostic channel.
fn _number_value(gguf_manifest.GgufManifest m, string key) → int ⇥ DenseQwen2Error {
    do {
        return gguf_manifest.number(m, key)
    }
    catch err {
        match err {
            case gguf_manifest.NotFound const message {
                throw variant BadConfig {message = "qwen2 metadata fact unavailable: §"(key)}
            }
            case _ {
                throw variant ManifestFailure {message = err.message, inner = err}
            }
        }
    }
}

# token_embd.weight descriptor; the canonical embed read for the frozen
# vocab fact.
fn _embed(gguf_manifest.GgufManifest m) → gguf_manifest.GgufTensorDescriptor ⇥ DenseQwen2Error {
    do {
        return gguf_manifest.find_tensor(m, "token_embd.weight")
    }
    catch err {
        match err {
            case gguf_manifest.NotFound const message {
                throw variant MissingTensor {message = "canonical model.embed_tokens missing from manifest: token_embd.weight"}
            }
            case _ {
                throw variant ManifestFailure {message = err.message, inner = err}
            }
        }
    }
}

# Frozen config from the manifest metadata facts of the pinned qwen2 row.
# Theta is frozen at 1000000 (the qwen2 family delta; the float
# qwen2.rope.freq_base wire value is preserved by the manifest but not
# decoded by the integer accessor). Vocab is the token_embd shape fact.
# Tie status is read from the tensor set: output.weight present -> untied.
@ public
fn config(gguf_manifest.GgufManifest m) → DenseQwen2Config ⇥ DenseQwen2Error {
    # --- architecture + count facts (fail closed) -------------------------
    const string arch ← _text_value(m, "general.architecture")
    require arch ≡ "qwen2" throw variant UnknownArchitecture {message = "architecture is not qwen2: §"(arch)}
    const int layers ← _number_value(m, "qwen2.block_count")
    const int heads ← _number_value(m, "qwen2.attention.head_count")
    const int kv_heads ← _number_value(m, "qwen2.attention.head_count_kv")
    const int hidden_dim ← _number_value(m, "qwen2.embedding_length")
    require heads ≻ 0 throw variant BadConfig {message = "qwen2 head count must be positive"}
    const int head_dim ← hidden_dim / heads

    # --- vocab from the embed descriptor ----------------------------------
    const gguf_manifest.GgufTensorDescriptor embed ← _embed(m)
    require embed.shape.length() ≥ 2 throw variant BadConfig {message = "qwen2 token_embd.weight must be rank 2"}
    const int vocab ← embed.shape.get(1) coalesce 0

    # --- tie status + construct -------------------------------------------
    const bool tied ← _tied(m)
    return DenseQwen2Config {layers = layers, heads = heads, kv_heads = kv_heads, head_dim = head_dim, hidden_dim = hidden_dim, vocab = vocab, theta = 1000000, tied = tied}
}

# Tie status read from the tensor set (gi0-model-contract precedent):
# output.weight present -> untied (false), absent (NotFound) -> tied.
# Any other manifest error fails closed instead of pretending the row is tied.
fn _tied(gguf_manifest.GgufManifest m) → bool ⇥ DenseQwen2Error {
    do {
        gguf_manifest.find_tensor(m, "output.weight")
        return false
    }
    catch err {
        match err {
            case gguf_manifest.NotFound const message {
                return true
            }
            case _ {
                throw variant BadConfig {message = "qwen2 tie status is unreadable: §"(err.message)}
            }
        }
    }
    throw variant BadConfig {message = "unreachable qwen2 tie status"}
}

# Resolve one canonical tensor name to its exact manifest descriptor,
# failing closed with the canonical name and GGUF name in the diagnostic.
@ public
fn resolve(DenseQwen2Config cfg, gguf_manifest.GgufManifest m, string name) → gguf_manifest.GgufTensorDescriptor ⇥ DenseQwen2Error {
    const string gguf ← _gguf_name(cfg, name)
    do {
        return gguf_manifest.find_tensor(m, gguf)
    }
    catch err {
        match err {
            case gguf_manifest.NotFound const message {
                throw variant MissingTensor {message = "canonical § missing from manifest: §"(name, gguf)}
            }
            case _ {
                throw variant ManifestFailure {message = err.message, inner = err}
            }
        }
    }
}

# Render the resolved descriptor facts (gguf-name/shape/layout) for the
# executed proof and the proba pins. Module-internal so the imported
# GgmlLayout variants resolve (the A1b proba surface reads facts via the
# module, never by destructuring the imported enum directly).
@ public
fn render_description(gguf_manifest.GgufTensorDescriptor t) → string {
    var string shape ← ""
    const int n ← t.shape.length()
    for range 0‥n const i {
        if i ≻ 0 {
            shape ← shape + ","
        }
        shape ← shape + (t.shape.get(i) coalesce 0 ↦ string)
    }
    match t.layout {
        case gguf_manifest.Known const elements_per_block, bytes_per_block, byte_length {
            return (((t.name + "/") + shape) + "/known/") + (elements_per_block ↦ string)
        }
        case gguf_manifest.Unknown const kind {
            return ((t.name + "/") + shape) + "/unknown"
        }
    }
}
