+++
locale = "en"
+++
# Co-located package test for capsule.fab (PML2-U1 admitted-model capsule,
# capsule-schema-2.0.0, A1C-M1).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the fail-closed schema-2 admission constructor
# (happy row + every typed rejection path), the schema-2 capsule surface
# (pathless content identity + per-format manifest with per-tensor
# descriptors), self-verification, the schema-versioned identity wire
# round-trip, and the schema-1 rejection at the boundary (RetiredSchema).
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned; compile-level until the FMIR stepper / faber test path
# covers library probas — recorded serialize.proba residual); `faber check`
# proves the whole surface type-checks.
#
# NOTE (pinned-row fixtures): the digest values are format-valid 64-hex
# fixtures (the value's SHA-256 computation is host-side per the module
# header). The Safetensors row is the structural F32 fixture row of
# fixtures/safetensors (smollm2-360m-scaled-row shape names), scaled to the
# rule set: two F32 tensors whose ranges tile the data region exactly.

import from "gradus:model/capsule" capsule

import from "gradus:model/artifact" artifact

# -- pinned fixture facts (structural Safetensors row) ----------------------

const string F_SCHEMA ← "2.0.0"

const string F_ALGO ← "sha-256"

const string F_DIGEST ← "2fa3f01300000000000000000000000000000000000000000000000000bac9c2"

const string F_ALIA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const int F_LENGTH ← 1024

const int F_DATA ← 160

# -- helpers ---------------------------------------------------------------

# The pathless content identity carried by every admitted fixture.
fn identity_fixture() → artifact.ContentIdentity {
    return artifact.ContentIdentity {algorithm = F_ALGO, digest = F_DIGEST, length = F_LENGTH}
}

# An identity with caller-supplied fields (fail-closed cases).
fn identity_variant(string algorithm, string digest, int length) → artifact.ContentIdentity {
    return artifact.ContentIdentity {algorithm = algorithm, digest = digest, length = length}
}

# A Safetensors tensor descriptor.
fn description(string name, string kind, list<int> shape, int start, int end, int elements) → capsule.SafetensorsTensorDescriptor {
    return capsule.SafetensorsTensorDescriptor {name = name, dtype = kind, shape = shape, start = start, end = end, elements = elements}
}

# The two-descriptor F32 fixture row (ranges tile the 160-byte data region).
fn tensors_fixture() → list<capsule.SafetensorsTensorDescriptor> {
    return [description("model.embed_tokens.weight", "F32", [8, 4], 0, 128, 32), description("model.norm.weight", "F32", [8], 128, 160, 8)]
}

# The well-formed Safetensors manifest (format/version + metadata + tensors).
fn manifest_fixture() → capsule.SafetensorsManifest {
    return capsule.SafetensorsManifest {format = "safetensors", version = "1.0.0", artifact_length = F_LENGTH, data_length = F_DATA, metadata = [capsule.SafetensorsMetadata {key = "format.name", payload = "safetensors"}], tensors = tensors_fixture()}
}

# A manifest with caller-supplied fields (fail-closed cases).
fn manifest_variant(string format, string version, int artifact_length, int data_length, list<capsule.SafetensorsTensorDescriptor> tensors) → capsule.SafetensorsManifest {
    return capsule.SafetensorsManifest {format = format, version = version, artifact_length = artifact_length, data_length = data_length, metadata = [], tensors = tensors}
}

# Renders an admission outcome as text: "ok" on success, the typed
# error's message on rejection.
fn construct_result(string schema, artifact.ContentIdentity id, capsule.SafetensorsManifest m) → string {
    do {
        const capsule.Capsule c ← capsule.construct_manifest(schema, id, capsule.safetensors_manifest(m))
        if c.schema() ≡ schema then return "ok"
        return "unexpected schema stamp"
    }
    catch err {
        return capsule.message(err)
    }
}

# Verify outcome as text.
fn verify_result(capsule.Capsule c) → string {
    do {
        const bool ok ← capsule.verify(c)
        if ok then return "ok"
        return "verification failed"
    }
    catch err {
        return capsule.message(err)
    }
}

# Identity verification against an expected digest, as text.
fn against_result(capsule.Capsule c, string expected) → string {
    do {
        const bool ok ← capsule.verify_against(c, expected)
        if ok then return "ok"
        return "verification failed"
    }
    catch err {
        return capsule.message(err)
    }
}

# Identity wire outcome as text ("ok" or the typed error's message).
fn identity_wire_result(string wire) → string {
    do {
        const capsule.Identity i ← capsule.deserialize_identity(wire)
        if i.schema() ≡ "2.0.0" then return "ok"
        return "unexpected schema"
    }
    catch err {
        return capsule.message(err)
    }
}

# Identity round-trip predicate: deserialize(serializa(c)).identity() ≡
# c.identity() by identity_equal.
fn roundtrip(capsule.Capsule c) → bool {
    do {
        const capsule.Identity i ← capsule.deserialize_identity(capsule.serialize_identity(c))
        return capsule.identity_equal(c.identity(), i)
    }
    catch err {
        return false
    }
}

# Hand-built schema-1-stamped capsule. construct_manifest can never produce
# it (schema 1 is rejected at admission), so it is built directly here to
# prove verify's boundary rejects the retired stamp with RetiredSchema.
fn capsule_schema_retired() → capsule.Capsule {
    return capsule.Capsule {schema = "1.0.0", identity = identity_fixture(), manifest = capsule.safetensors_manifest(manifest_fixture())}
}

# The schema-2 wire for the pinned identity.
fn wire_fixture() → string {
    return (((((("capsule/identity/" + F_SCHEMA) + "/") + F_ALGO) + "/") + F_DIGEST) + "/") + (F_LENGTH ↦ string)
}

# -- admission (happy row) --------------------------------------------------

test "admission admits the schema-2 safetensors capsule" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_fixture()) ≡ "ok"
}

test "the capsule stamps schema 2.0.0 and carries identity and manifest" {
    do {
        const capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        # Schema stamp (capsule-schema-2.0.0).
        assert c.schema() ≡ "2.0.0"
        # Pathless content identity.
        assert c.algorithm() ≡ "sha-256"
        assert c.digest() ≡ F_DIGEST
        assert c.length() ≡ F_LENGTH
        # Per-format manifest.
        assert c.format() ≡ "safetensors"
        # The compact schema-versioned identity record.
        assert c.identity().schema() ≡ "2.0.0"
        assert c.identity().algorithm() ≡ "sha-256"
        assert c.identity().digest() ≡ F_DIGEST
        assert c.identity().byte_length() ≡ F_LENGTH
    }
    catch err {
        assert false
    }
}

test "verify passes on an admitted capsule" {
    do {
        const capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        assert verify_result(c) ≡ "ok"
    }
    catch err {
        assert false
    }
}

test "the capsule carries the safetensors manifest" {
    do {
        const capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        assert c.safetensors_manifest() not is null
    }
    catch err {
        assert false
    }
}

test "per-tensor descriptors are visible in the safetensors manifest" {
    do {
        const capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        assert c.tensor_count() ≡ 2
        const capsule.SafetensorsTensorDescriptor d0 ← manifest_fixture().description(0)
        assert d0.name() ≡ "model.embed_tokens.weight"
        assert d0.dtype() ≡ "F32"
        assert d0.elements() ≡ 32
        const capsule.SafetensorsTensorDescriptor d1 ← manifest_fixture().description(1)
        assert d1.name() ≡ "model.norm.weight"
        assert d1.elements() ≡ 8
        const capsule.SafetensorsMetadata meta ← manifest_fixture().metadata(0)
        assert meta.key() ≡ "format.name"
        assert meta.payload() ≡ "safetensors"
        assert manifest_fixture().tensor_count() ≡ 2
    }
    catch err {
        assert false
    }
}

test "identity verifies against the expected digest and fails closed on a mismatch" {
    do {
        const capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        assert against_result(c, F_DIGEST) ≡ "ok"
        assert against_result(c, F_ALIA) ≡ "digest mismatch — capsule does not match the expected artifact"
    }
    catch err {
        assert false
    }
}

test "the identity record round-trips the wire form" {
    do {
        const capsule.Capsule c ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        assert roundtrip(c)
        assert identity_wire_result(wire_fixture()) ≡ "ok"
    }
    catch err {
        assert false
    }
}

test "a different digest changes the identity" {
    do {
        const capsule.Capsule a ← capsule.construct_manifest(F_SCHEMA, identity_fixture(), capsule.safetensors_manifest(manifest_fixture()))
        const capsule.Capsule b ← capsule.construct_manifest(F_SCHEMA, identity_variant(F_ALGO, F_ALIA, F_LENGTH), capsule.safetensors_manifest(manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, tensors_fixture())))
        assert capsule.identity_equal(a.identity(), a.identity())
        assert not capsule.identity_equal(a.identity(), b.identity())
    }
    catch err {
        assert false
    }
}

# -- schema-1 rejection at the boundary (RetiredSchema) -----------------------

test "construct_manifest rejects a schema-1 stamp" {
    assert construct_result("1.0.0", identity_fixture(), manifest_fixture()) ≡ "schema 1 is retired — capsule schema is 2.0.0"
}

test "verify rejects a schema-1-stamped capsule" {
    assert verify_result(capsule_schema_retired()) ≡ "schema 1 is retired — capsule schema is 2.0.0"
}

test "deserialization rejects a schema-1-stamped wire" {
    assert identity_wire_result((("capsule/identity/1.0.0/sha-256/" + F_DIGEST) + "/") + (F_LENGTH ↦ string)) ≡ "schema 1 is retired — capsule schema is 2.0.0"
}

test "deserialization rejects the retired 9-segment schema-1 wire" {
    assert identity_wire_result(("capsule/identity/1.0.0/sha-256/" + F_DIGEST) + "/4/q4_k/llama/16") ≡ "schema 1 is retired — capsule schema is 2.0.0"
}

# -- fail-closed construction (error paths) ---------------------------------

test "rejects an unknown schema version" {
    assert construct_result("3.0.0", identity_fixture(), manifest_fixture()) ≡ "unknown capsule schema version: 3.0.0"
}

test "rejects an un-admitted digest algorithm" {
    assert construct_result(F_SCHEMA, identity_variant("md5", F_DIGEST, F_LENGTH), manifest_fixture()) ≡ "unknown digest algorithm: md5"
}

test "rejects a short digest value" {
    assert construct_result(F_SCHEMA, identity_variant(F_ALGO, "abc", F_LENGTH), manifest_fixture()) ≡ "malformed digest value"
}

test "rejects a non-hex digest value" {
    assert construct_result(F_SCHEMA, identity_variant(F_ALGO, "zzzzzzzz00000000000000000000000000000000000000000000000000bac9c2", F_LENGTH), manifest_fixture()) ≡ "malformed digest value"
}

test "rejects a non-positive artifact byte length" {
    assert construct_result(F_SCHEMA, identity_variant(F_ALGO, F_DIGEST, 0), manifest_fixture()) ≡ "invalid artifact byte length"
}

test "rejects a manifest whose artifact length does not match the identity" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", 2048, F_DATA, tensors_fixture())) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a non-safetensors format name" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("gguf", "1.0.0", F_LENGTH, F_DATA, tensors_fixture())) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects an empty format name" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("", "1.0.0", F_LENGTH, F_DATA, tensors_fixture())) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects an empty format version" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "", F_LENGTH, F_DATA, tensors_fixture())) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects an empty data region" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, 0, [])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a data region larger than the artifact" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, 2048, tensors_fixture())) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects an empty tensor name" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("", "F32", [8, 4], 0, 128, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects an empty tensor dtype" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "", [8, 4], 0, 128, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a zero-element tensor" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [8, 4], 0, 128, 0)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects an empty tensor shape" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [], 0, 128, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a negative tensor dimension" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [8, -4], 0, 128, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a tensor whose element count does not match the shape" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [8, 4], 0, 128, 31)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a negative tensor data offset" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [8, 4], -1, 128, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a reversed tensor data range" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [8, 4], 128, 128, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

test "rejects a tensor range beyond the data region" {
    assert construct_result(F_SCHEMA, identity_fixture(), manifest_variant("safetensors", "1.0.0", F_LENGTH, F_DATA, [description("w", "F32", [8, 4], 0, 161, 32)])) ≡ "manifest is inconsistent with the artifact identity"
}

# -- schema-versioned identity wire -----------------------------------------

test "deserialization rejects an unknown schema version" {
    assert identity_wire_result((("capsule/identity/3.0.0/sha-256/" + F_DIGEST) + "/") + (F_LENGTH ↦ string)) ≡ "unknown capsule schema version: 3.0.0"
}

test "deserialization rejects an unknown marker" {
    assert identity_wire_result((("model/identity/2.0.0/sha-256/" + F_DIGEST) + "/") + (F_LENGTH ↦ string)) ≡ "unknown capsule identity marker"
}

test "deserialization rejects a malformed wire form" {
    assert identity_wire_result("capsule/identity/2.0.0/sha-256") ≡ "malformed capsule identity wire form"
}

test "deserialization rejects a 9-segment non-schema-1 wire" {
    assert identity_wire_result(("capsule/identity/3.0.0/sha-256/" + F_DIGEST) + "/4/q4_k/llama/16") ≡ "malformed capsule identity wire form"
}

test "deserialization rejects an un-admitted digest algorithm" {
    assert identity_wire_result((("capsule/identity/2.0.0/md5/" + F_DIGEST) + "/") + (F_LENGTH ↦ string)) ≡ "unknown digest algorithm: md5"
}

test "deserialization rejects a malformed digest" {
    assert identity_wire_result("capsule/identity/2.0.0/sha-256/zz/" + (F_LENGTH ↦ string)) ≡ "malformed digest value"
}

test "deserialization rejects a non-numeric byte length" {
    assert identity_wire_result(("capsule/identity/2.0.0/sha-256/" + F_DIGEST) + "/many") ≡ "malformed numeric field"
}

test "deserialization rejects a non-positive byte length" {
    assert identity_wire_result(("capsule/identity/2.0.0/sha-256/" + F_DIGEST) + "/0") ≡ "invalid byte length in capsule identity"
}
