# Co-located package test for capsule.fab (PML2-U1 admitted-model capsule,
# capsule-schema-1.0.0).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the fail-closed admission constructor (happy
# row + every typed rejection path), the six-field capsule surface
# (validated bytes / cryptographic identity / tokenizer identity /
# quantization / bounds / architecture facts), self-verification, the
# schema-versioned identity wire round-trip + version rejection, and the
# non-trust-anchor posture (provenance path never binds identity).
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
#
# NOTE (pinned-row fixtures): the GI1 pinned-row facts (byte length
# 270,590,880, tensor count 290, total elements 361,821,120, digest prefix
# 2fa3f013…bac9c2) are cited read-only from gi1-closeout.md. The byte
# payload here is a scaled fixture (4 bytes) because the proba proves the
# admission RULES, not the giant row; the full row is a U2/U3 admission
# fixture. The digest values are format-valid 64-hex fixtures (the value's
# SHA-256 computation is host-side per the module header).

importa ex "./capsule" privata capsula

# -- pinned-row fixture facts (scaled byte payload) -------------------------

fixum textus F_SCHEMA ← "1.0.0"
fixum textus F_ALGO ← "sha-256"
fixum textus F_DIGEST ← "2fa3f01300000000000000000000000000000000000000000000000000bac9c2"
fixum textus F_VOCAB ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
fixum textus F_ALIA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
fixum textus F_PROGENIES ← "gpt2"
fixum textus F_PRE ← "smollm"
fixum textus F_EOG ← "0,2"
fixum bivalens F_BOS ← verum
fixum bivalens F_SPATIUM ← verum
fixum textus F_QUANT ← "q4_k"
fixum numerus F_ELEMS ← 256
fixum numerus F_OCTETI ← 144
fixum numerus F_CONCORDATIO ← 32
fixum numerus F_MACHINA ← 270590880
fixum numerus F_KV ← 37
fixum numerus F_TENSORES ← 290
fixum numerus F_NOMEN ← 128
fixum numerus F_DIMENSIO ← 65536
fixum numerus F_ELEMENTA ← 361821120
fixum numerus F_TEXTUS ← 4096
fixum textus F_ARCH ← "llama"
fixum textus F_DENSITAS ← "dense"
fixum numerus F_STRATA ← 16
fixum textus F_CONTEXTUS ← "2048"
fixum textus F_SEMITA ← ""

# -- helpers ---------------------------------------------------------------

# Byte values → validated-byte payload (u8 carrier list).
functio bytes(lista<numerus> vals) → lista<numerus<u8>> {
    varia lista<numerus<u8>> bs ← vacua
    itera ex vals fixum v {
        bs.appende(v ↦ numerus<u8>)
    }
    redde bs
}

# The scaled fixture payload (4 bytes).
functio payload() → lista<numerus<u8>> {
    redde bytes([1, 2, 3, 4])
}

# Renders an admission outcome as textus: "ok" on success, the typed
# error's causa on rejection.
functio structa_result(
    textus schema,
    lista<numerus<u8>> b,
    bivalens opertum,
    textus algorithmus,
    textus digestio,
    textus progenies,
    textus pre_tokenizator,
    textus digestio_vocabuli,
    textus eog,
    bivalens bos_vacua,
    bivalens spatium_vacua,
    textus typo_quantizationis,
    numerus elementa_glomoris,
    numerus octeti_glomoris,
    numerus concordatio,
    numerus limes_machinae,
    numerus limes_kv,
    numerus limes_tensorum,
    numerus limes_nominis,
    numerus limes_dimensionis,
    numerus limes_elementorum,
    numerus limes_textus,
    textus identificator,
    textus densitas,
    numerus strata,
    textus contextus,
    textus semita
) → textus {
    fac {
        fixum capsula.Capsula c ← capsula.structa(schema, b, opertum, algorithmus, digestio, progenies, pre_tokenizator, digestio_vocabuli, eog, bos_vacua, spatium_vacua, typo_quantizationis, elementa_glomoris, octeti_glomoris, concordatio, limes_machinae, limes_kv, limes_tensorum, limes_nominis, limes_dimensionis, limes_elementorum, limes_textus, identificator, densitas, strata, contextus, semita)
        redde "ok"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Verifica outcome as textus.
functio verifica_result(capsula.Capsula c) → textus {
    fac {
        fixum bivalens ok ← capsula.verifica(c)
        redde "ok"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Hand-built empty-corpus capsule (longitudo 0, opertum verum) — the
# auditor-2 fire-3 P2-2 fixture. structa can never produce this (it
# rejects empty payloads at admission), so it is built directly here to
# prove verifica's defense-in-depth re-check fails closed identically.
functio capsula_corpus_vacua() → capsula.Capsula {
    redde capsula.Capsula {
        schema = F_SCHEMA,
        bytes = capsula.BytesValida { corpus = bytes([]), longitudo = 0, opertum = verum },
        crypta = capsula.IdentitasCrypto { algorithmus = F_ALGO, digestio = F_DIGEST },
        tokenizator = capsula.IdentitasTokenizer { progenies = F_PROGENIES, pre_tokenizator = F_PRE, digestio_vocabuli = F_VOCAB, eog = F_EOG, bos_vacua = F_BOS, spatium_vacua = F_SPATIUM },
        quantizatio = capsula.Quantizatio { typo = F_QUANT, elementa_glomoris = F_ELEMS, octeti_glomoris = F_OCTETI, concordatio = F_CONCORDATIO },
        limites = capsula.Limites { machina = F_MACHINA, kv = F_KV, tensores = F_TENSORES, nomen = F_NOMEN, dimensio = F_DIMENSIO, elementa = F_ELEMENTA, textus = F_TEXTUS },
        architectura = capsula.Architectura { identificator = F_ARCH, densitas = F_DENSITAS, strata = F_STRATA, contextus = F_CONTEXTUS },
        semita = F_SEMITA
    }
}

# Identity verification against an expected digest, as textus.
functio contra_result(capsula.Capsula c, textus expectatum) → textus {
    fac {
        fixum bivalens ok ← capsula.verifica_contra(c, expectatum)
        redde "ok"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Identity wire outcome as textus ("ok" or the typed error's causa).
functio identitas_wire_result(textus wire) → textus {
    fac {
        fixum capsula.Identitas i ← capsula.deserializa_identitas(wire)
        redde "ok"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Identity round-trip predicate: deserializa(serializa(c)).identia() ≡
# c.identia() by identitas_aequus.
functio roundtrip(capsula.Capsula c) → bivalens {
    fac {
        fixum capsula.Identitas i ← capsula.deserializa_identitas(capsula.serializa_identitas(c))
        redde capsula.identitas_aequus(c.identia(), i)
    }
    cape err {
        redde falsum
    }
}

# -- admission (happy row) --------------------------------------------------

probandum "capsule admission" {
    proba "admission admits the pinned-row capsule" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "ok"
    }

    proba "the capsule stamps the schema and carries all six field groups" {
        fac {
            fixum capsula.Capsula c ← capsula.structa(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA)
            # Schema stamp (capsule-schema-1.0.0).
            adfirma c.schematis() ≡ "1.0.0"
            # Field 1 — validated bytes.
            adfirma c.longitudo() ≡ 4
            adfirma c.opertum()
            # Field 2 — cryptographic identity.
            adfirma c.algorithmus() ≡ "sha-256"
            adfirma c.digestio() ≡ F_DIGEST
            # Field 3 — tokenizer identity.
            adfirma c.progenies() ≡ "gpt2"
            adfirma c.pre_tokenizator() ≡ "smollm"
            adfirma c.digestio_vocabuli() ≡ F_VOCAB
            adfirma c.eog() ≡ "0,2"
            adfirma c.bos_vacua()
            adfirma c.spatium_vacua()
            # Field 4 — quantization.
            adfirma c.quantizatio() ≡ "q4_k"
            adfirma c.elementa_glomoris() ≡ 256
            adfirma c.octeti_glomoris() ≡ 144
            adfirma c.concordatio() ≡ 32
            # Field 5 — bounds.
            adfirma c.limes_machinae() ≡ 270590880
            adfirma c.limes_kv() ≡ 37
            adfirma c.limes_tensorum() ≡ 290
            adfirma c.limes_nominis() ≡ 128
            adfirma c.limes_dimensionis() ≡ 65536
            adfirma c.limes_elementorum() ≡ 361821120
            adfirma c.limes_textus() ≡ 4096
            # Field 6 — architecture facts.
            adfirma c.identificator() ≡ "llama"
            adfirma c.densitas() ≡ "dense"
            adfirma c.strata() ≡ 16
            adfirma c.contextus() ≡ "2048"
            # Provenance path is locator metadata (empty = not recorded).
            adfirma c.semita() ≡ ""
        }
        cape err {
            adfirma falsum
        }
    }

    proba "verifica passes on an admitted capsule" {
        fac {
            fixum capsula.Capsula c ← capsula.structa(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA)
            adfirma verifica_result(c) ≡ "ok"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "verifica rejects a hand-built empty-corpus capsule (P2-2)" {
        # Defense-in-depth: structa can never build an empty corpus, so a
        # hand-built one (longitudo 0, opertum verum) must still fail
        # closed under verifica — identically to structa's rejection.
        adfirma verifica_result(capsula_corpus_vacua()) ≡ "empty validated byte payload"
    }

    proba "identity verifies against the expected digest and fails closed on a mismatch" {
        fac {
            fixum capsula.Capsula c ← capsula.structa(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA)
            adfirma contra_result(c, F_DIGEST) ≡ "ok"
            adfirma contra_result(c, F_ALIA) ≡ "digest mismatch — capsule does not match the expected artifact"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the identity record round-trips the wire form" {
        fac {
            fixum capsula.Capsula c ← capsula.structa(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA)
            adfirma roundtrip(c)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the provenance path never binds identity" {
        fac {
            # Two capsules, identical identity fields, DIFFERENT recorded
            # provenance paths — identity must agree (§2: a path is a
            # locator, never identity).
            fixum capsula.Capsula a ← capsula.structa(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, "")
            fixum capsula.Capsula b ← capsula.structa(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, "cache/models/pinned.gguf")
            adfirma non (a.semita() ≡ b.semita())
            adfirma capsula.identitas_aequus(a.identia(), b.identia())
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a different digest changes the identity" {
        fac {
            fixum capsula.Capsula a ← capsula.structa(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA)
            fixum capsula.Capsula b ← capsula.structa(F_SCHEMA, payload(), verum, F_ALGO, F_ALIA, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA)
            adfirma non (capsula.identitas_aequus(a.identia(), b.identia()))
        }
        cape err {
            adfirma falsum
        }
    }
}

# -- fail-closed construction (error paths) ---------------------------------

probandum "capsule fail-closed construction" {
    proba "rejects an unknown schema version" {
        adfirma structa_result("2.0.0", payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "unknown capsule schema version: 2.0.0"
    }

    proba "rejects an un-admitted digest algorithm" {
        adfirma structa_result(F_SCHEMA, payload(), verum, "md5", F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "unknown digest algorithm: md5"
    }

    proba "rejects a short digest value" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, "abc", F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "malformed digest value"
    }

    proba "rejects a non-hex digest value" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, "zzzzzzzz00000000000000000000000000000000000000000000000000bac9c2", F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "malformed digest value"
    }

    proba "rejects a malformed vocabulary digest" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, "zz", F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "malformed vocabulary digest"
    }

    proba "rejects an empty validated byte payload" {
        adfirma structa_result(F_SCHEMA, bytes([]), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "empty validated byte payload"
    }

    proba "rejects a data region whose coverage accounting did not pass" {
        adfirma structa_result(F_SCHEMA, payload(), falsum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "data-region coverage did not pass — gapped or overlapping region"
    }

    proba "rejects an empty tokenizer kind" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, "", F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid tokenizer identity"
    }

    proba "rejects an empty pre-tokenizer" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, "", F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid tokenizer identity"
    }

    proba "rejects a non-sorted EOG set" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, "2,0", F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid tokenizer identity"
    }

    proba "rejects a well-formed-but-different EOG set (pinned EOG is {0, 2})" {
        # PIN ADDED (correctness-fix slice): the capsule contract (§3 row 3)
        # pins behavioral facts including the EOG set {0, 2}; a well-formed
        # but different set is a different tokenizer and fails closed at the
        # capsule admission gate.
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, "1,5", F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid tokenizer identity"
    }

    proba "rejects an empty EOG set" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, "", F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid tokenizer identity"
    }

    proba "rejects a negative EOG id" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, "-1,2", F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid tokenizer identity"
    }

    proba "rejects an un-admitted quantization row" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, "q2_k", F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "unknown or mis-laid-out quantization row: q2_k"
    }

    proba "rejects a mis-laid-out quantization row" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, 128, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "unknown or mis-laid-out quantization row: q4_k"
    }

    proba "rejects a non-32 block alignment" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, 16, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "unknown or mis-laid-out quantization row: q4_k"
    }

    proba "rejects a file-size ceiling below the validated data region" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, 2, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid bounds ceilings"
    }

    proba "rejects a dimension ceiling above the library hard limit" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, 70000, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid bounds ceilings"
    }

    proba "rejects an element ceiling above the library hard limit" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, 2000000000, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid bounds ceilings"
    }

    proba "rejects a tensor-name ceiling above the hard limit" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, 256, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid bounds ceilings"
    }

    proba "rejects a per-string byte ceiling above the hard limit" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, 8192, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid bounds ceilings"
    }

    proba "rejects a zero metadata-KV ceiling" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, 0, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid bounds ceilings"
    }

    proba "rejects an empty architecture identifier" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, "", F_DENSITAS, F_STRATA, F_CONTEXTUS, F_SEMITA) ≡ "invalid architecture facts"
    }

    proba "rejects a zero layer count" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, 0, F_CONTEXTUS, F_SEMITA) ≡ "invalid architecture facts"
    }

    proba "rejects an empty context configuration" {
        adfirma structa_result(F_SCHEMA, payload(), verum, F_ALGO, F_DIGEST, F_PROGENIES, F_PRE, F_VOCAB, F_EOG, F_BOS, F_SPATIUM, F_QUANT, F_ELEMS, F_OCTETI, F_CONCORDATIO, F_MACHINA, F_KV, F_TENSORES, F_NOMEN, F_DIMENSIO, F_ELEMENTA, F_TEXTUS, F_ARCH, F_DENSITAS, F_STRATA, "", F_SEMITA) ≡ "invalid architecture facts"
    }
}

# -- schema-versioned identity wire -----------------------------------------

probandum "capsule identity wire" {
    proba "deserialization rejects an unknown schema version" {
        adfirma identitas_wire_result("capsule/identity/2.0.0/sha-256/" + F_DIGEST + "/4/q4_k/llama/16") ≡ "unknown capsule schema version: 2.0.0"
    }

    proba "deserialization rejects an unknown marker" {
        adfirma identitas_wire_result("model/identity/1.0.0/sha-256/" + F_DIGEST + "/4/q4_k/llama/16") ≡ "unknown capsule identity marker"
    }

    proba "deserialization rejects a malformed wire form" {
        adfirma identitas_wire_result("capsule/identity/1.0.0/sha-256") ≡ "malformed capsule identity wire form"
    }

    proba "deserialization rejects an un-admitted digest algorithm" {
        adfirma identitas_wire_result("capsule/identity/1.0.0/md5/" + F_DIGEST + "/4/q4_k/llama/16") ≡ "unknown digest algorithm: md5"
    }

    proba "deserialization rejects a malformed digest" {
        adfirma identitas_wire_result("capsule/identity/1.0.0/sha-256/zz/4/q4_k/llama/16") ≡ "malformed digest value"
    }

    proba "deserialization rejects a non-numeric byte length" {
        adfirma identitas_wire_result("capsule/identity/1.0.0/sha-256/" + F_DIGEST + "/many/q4_k/llama/16") ≡ "malformed numeric field"
    }

    proba "deserialization rejects an un-admitted quantization row" {
        adfirma identitas_wire_result("capsule/identity/1.0.0/sha-256/" + F_DIGEST + "/4/q2_k/llama/16") ≡ "unknown quantization row: q2_k"
    }

    proba "deserialization rejects an empty architecture identifier" {
        adfirma identitas_wire_result("capsule/identity/1.0.0/sha-256/" + F_DIGEST + "/4/q4_k//16") ≡ "empty architecture identifier"
    }

    proba "deserialization rejects a zero layer count" {
        adfirma identitas_wire_result("capsule/identity/1.0.0/sha-256/" + F_DIGEST + "/4/q4_k/llama/0") ≡ "invalid layer count in capsule identity"
    }
}
