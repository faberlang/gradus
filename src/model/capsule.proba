+++
locale = "la"
+++
# Co-located package test for capsule.fab (PML2-U1 admitted-model capsule,
# capsule-schema-2.0.0, A1C-M1).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the fail-closed schema-2 admission constructor
# (happy row + every typed rejection path), the schema-2 capsule surface
# (pathless content identity + per-format manifest with per-tensor
# descriptors), self-verification, the schema-versioned identity wire
# round-trip, and the schema-1 rejection at the boundary (SchemaVetus).
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned; compile-level until the FMIR stepper / faber test path
# covers library probas — recorded serialize.proba residual); `faber check`
# proves the whole surface type-checks.
#
# NOTE (pinned-row fixtures): the digest values are format-valid 64-hex
# fixtures (the value's SHA-256 computation is host-side per the module
# header). The Safetensors row is the structural F32 fixture row of
# fixtures/safetensors (smollm2-360m-scaled-row shape names), scaled to the
# rule set: two F32 tensors whose ranges tile the data region exactly.

importa ex "gradus:model/capsule" capsula
importa ex "gradus:model/artifact" artifact

# -- pinned fixture facts (structural Safetensors row) ----------------------

fixum textus F_SCHEMA ← "2.0.0"
fixum textus F_ALGO ← "sha-256"
fixum textus F_DIGEST ← "2fa3f01300000000000000000000000000000000000000000000000000bac9c2"
fixum textus F_ALIA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
fixum numerus F_LONGITUDO ← 1024
fixum numerus F_DATORUM ← 160

# -- helpers ---------------------------------------------------------------

# The pathless content identity carried by every admitted fixture.
functio identitas_fixture() → artifact.IdentitasContenuti {
    redde artifact.IdentitasContenuti { algorithmus = F_ALGO, digestio = F_DIGEST, longitudo = F_LONGITUDO }
}

# An identity with caller-supplied fields (fail-closed cases).
functio identitas_variata(textus algorithmus, textus digestio, numerus longitudo) → artifact.IdentitasContenuti {
    redde artifact.IdentitasContenuti { algorithmus = algorithmus, digestio = digestio, longitudo = longitudo }
}

# A Safetensors tensor descriptor.
functio descriptio(textus nomen, textus typo, lista<numerus> forma, numerus initium, numerus finis, numerus elementa) → capsula.DescriptioTensorisSafetensori {
    redde capsula.DescriptioTensorisSafetensori { nomen = nomen, typo = typo, forma = forma, initium = initium, finis = finis, elementa = elementa }
}

# The two-descriptor F32 fixture row (ranges tile the 160-byte data region).
functio tensores_fixture() → lista<capsula.DescriptioTensorisSafetensori> {
    redde [
        descriptio("model.embed_tokens.weight", "F32", [8, 4], 0, 128, 32),
        descriptio("model.norm.weight", "F32", [8], 128, 160, 8)
    ]
}

# The well-formed Safetensors manifest (format/version + metadata + tensors).
functio manifestum_fixture() → capsula.ManifestumSafetensors {
    redde capsula.ManifestumSafetensors {
        formatum = "safetensors",
        versio = "1.0.0",
        longitudo_artifacti = F_LONGITUDO,
        longitudo_datorum = F_DATORUM,
        metadata = [ capsula.MetadatumSafetensori { clavis = "format.name", valor = "safetensors" } ],
        tensores = tensores_fixture()
    }
}

# A manifest with caller-supplied fields (fail-closed cases).
functio manifestum_variata(textus formatum, textus versio, numerus longitudo_artifacti, numerus longitudo_datorum, lista<capsula.DescriptioTensorisSafetensori> tensores) → capsula.ManifestumSafetensors {
    redde capsula.ManifestumSafetensors {
        formatum = formatum,
        versio = versio,
        longitudo_artifacti = longitudo_artifacti,
        longitudo_datorum = longitudo_datorum,
        metadata = [],
        tensores = tensores
    }
}

# Renders an admission outcome as textus: "ok" on success, the typed
# error's causa on rejection.
functio structa_result(textus schema, artifact.IdentitasContenuti id, capsula.ManifestumSafetensors m) → textus {
    fac {
        fixum capsula.Capsula c ← capsula.structa_manifestum(schema, id, capsula.manifestum_safetensors(m))
        si c.schematis() ≡ schema ergo redde "ok"
        redde "unexpected schema stamp"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Verifica outcome as textus.
functio verifica_result(capsula.Capsula c) → textus {
    fac {
        fixum bivalens ok ← capsula.verifica(c)
        si ok ergo redde "ok"
        redde "verification failed"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Identity verification against an expected digest, as textus.
functio contra_result(capsula.Capsula c, textus expectatum) → textus {
    fac {
        fixum bivalens ok ← capsula.verifica_contra(c, expectatum)
        si ok ergo redde "ok"
        redde "verification failed"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Identity wire outcome as textus ("ok" or the typed error's causa).
functio identitas_wire_result(textus wire) → textus {
    fac {
        fixum capsula.Identitas i ← capsula.deserializa_identitas(wire)
        si i.schematis() ≡ "2.0.0" ergo redde "ok"
        redde "unexpected schema"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Identity round-trip predicate: deserializa(serializa(c)).identia() ≡
# c.identia() by identitas_aequus.
functio roundtrip(capsula.Capsula c) → bivalens {
    fac {
        fixum capsula.Identitas i ← capsula.deserializa_identitas(capsula.serializa_identitas(c))
        redde capsula.identitas_aequus(c.identia(), i)
    }
    cape err {
        redde falsum
    }
}

# Hand-built schema-1-stamped capsule. structa_manifestum can never produce
# it (schema 1 is rejected at admission), so it is built directly here to
# prove verifica's boundary rejects the retired stamp with SchemaVetus.
functio capsula_schema_vetus() → capsula.Capsula {
    redde capsula.Capsula {
        schema = "1.0.0",
        identitas = identitas_fixture(),
        manifestum = capsula.manifestum_safetensors(manifestum_fixture())
    }
}

# The schema-2 wire for the pinned identity.
functio wire_fixture() → textus {
    redde "capsule/identity/" + F_SCHEMA + "/" + F_ALGO + "/" + F_DIGEST + "/" + (F_LONGITUDO ↦ textus)
}

# -- admission (happy row) --------------------------------------------------

probandum "capsule admission" {
    proba "admission admits the schema-2 safetensors capsule" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_fixture()) ≡ "ok"
    }

    proba "the capsule stamps schema 2.0.0 and carries identity and manifest" {
        fac {
            fixum capsula.Capsula c ← capsula.structa_manifestum(F_SCHEMA, identitas_fixture(), capsula.manifestum_safetensors(manifestum_fixture()))
            # Schema stamp (capsule-schema-2.0.0).
            adfirma c.schematis() ≡ "2.0.0"
            # Pathless content identity.
            adfirma c.algorithmus() ≡ "sha-256"
            adfirma c.digestio() ≡ F_DIGEST
            adfirma c.longitudo() ≡ F_LONGITUDO
            # Per-format manifest.
            adfirma c.formatum() ≡ "safetensors"
            # The compact schema-versioned identity record.
            adfirma c.identia().schematis() ≡ "2.0.0"
            adfirma c.identia().algorithmus() ≡ "sha-256"
            adfirma c.identia().digestio() ≡ F_DIGEST
            adfirma c.identia().longitudo_bytes() ≡ F_LONGITUDO
        }
        cape err {
            adfirma falsum
        }
    }

    proba "verifica passes on an admitted capsule" {
        fac {
            fixum capsula.Capsula c ← capsula.structa_manifestum(F_SCHEMA, identitas_fixture(), capsula.manifestum_safetensors(manifestum_fixture()))
            adfirma verifica_result(c) ≡ "ok"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the capsule carries the safetensors manifest" {
        fac {
            fixum capsula.Capsula c ← capsula.structa_manifestum(F_SCHEMA, identitas_fixture(), capsula.manifestum_safetensors(manifestum_fixture()))
            adfirma c.manifestum_safetensors() non est nihil
        }
        cape err {
            adfirma falsum
        }
    }

    proba "per-tensor descriptors are visible in the safetensors manifest" {
        fac {
            fixum capsula.Capsula c ← capsula.structa_manifestum(F_SCHEMA, identitas_fixture(), capsula.manifestum_safetensors(manifestum_fixture()))
            adfirma c.tensorum_numerus() ≡ 2
            fixum capsula.DescriptioTensorisSafetensori d0 ← manifestum_fixture().descriptio(0)
            adfirma d0.nomen() ≡ "model.embed_tokens.weight"
            adfirma d0.typo() ≡ "F32"
            adfirma d0.elementa() ≡ 32
            fixum capsula.DescriptioTensorisSafetensori d1 ← manifestum_fixture().descriptio(1)
            adfirma d1.nomen() ≡ "model.norm.weight"
            adfirma d1.elementa() ≡ 8
            fixum capsula.MetadatumSafetensori meta ← manifestum_fixture().metadatum(0)
            adfirma meta.clavis() ≡ "format.name"
            adfirma meta.valor() ≡ "safetensors"
            adfirma manifestum_fixture().tensorum_numerus() ≡ 2
        }
        cape err {
            adfirma falsum
        }
    }

    proba "identity verifies against the expected digest and fails closed on a mismatch" {
        fac {
            fixum capsula.Capsula c ← capsula.structa_manifestum(F_SCHEMA, identitas_fixture(), capsula.manifestum_safetensors(manifestum_fixture()))
            adfirma contra_result(c, F_DIGEST) ≡ "ok"
            adfirma contra_result(c, F_ALIA) ≡ "digest mismatch — capsule does not match the expected artifact"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the identity record round-trips the wire form" {
        fac {
            fixum capsula.Capsula c ← capsula.structa_manifestum(F_SCHEMA, identitas_fixture(), capsula.manifestum_safetensors(manifestum_fixture()))
            adfirma roundtrip(c)
            adfirma identitas_wire_result(wire_fixture()) ≡ "ok"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a different digest changes the identity" {
        fac {
            fixum capsula.Capsula a ← capsula.structa_manifestum(F_SCHEMA, identitas_fixture(), capsula.manifestum_safetensors(manifestum_fixture()))
            fixum capsula.Capsula b ← capsula.structa_manifestum(F_SCHEMA, identitas_variata(F_ALGO, F_ALIA, F_LONGITUDO), capsula.manifestum_safetensors(manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, tensores_fixture())))
            adfirma capsula.identitas_aequus(a.identia(), a.identia())
            adfirma non (capsula.identitas_aequus(a.identia(), b.identia()))
        }
        cape err {
            adfirma falsum
        }
    }
}

# -- schema-1 rejection at the boundary (SchemaVetus) -----------------------

probandum "capsule schema-1 rejection" {
    proba "structa_manifestum rejects a schema-1 stamp" {
        adfirma structa_result("1.0.0", identitas_fixture(), manifestum_fixture()) ≡ "schema 1 is retired — capsule schema is 2.0.0"
    }

    proba "verifica rejects a schema-1-stamped capsule" {
        adfirma verifica_result(capsula_schema_vetus()) ≡ "schema 1 is retired — capsule schema is 2.0.0"
    }

    proba "deserialization rejects a schema-1-stamped wire" {
        adfirma identitas_wire_result("capsule/identity/1.0.0/sha-256/" + F_DIGEST + "/" + (F_LONGITUDO ↦ textus)) ≡ "schema 1 is retired — capsule schema is 2.0.0"
    }

    proba "deserialization rejects the retired 9-segment schema-1 wire" {
        adfirma identitas_wire_result("capsule/identity/1.0.0/sha-256/" + F_DIGEST + "/4/q4_k/llama/16") ≡ "schema 1 is retired — capsule schema is 2.0.0"
    }
}

# -- fail-closed construction (error paths) ---------------------------------

probandum "capsule fail-closed construction" {
    proba "rejects an unknown schema version" {
        adfirma structa_result("3.0.0", identitas_fixture(), manifestum_fixture()) ≡ "unknown capsule schema version: 3.0.0"
    }

    proba "rejects an un-admitted digest algorithm" {
        adfirma structa_result(F_SCHEMA, identitas_variata("md5", F_DIGEST, F_LONGITUDO), manifestum_fixture()) ≡ "unknown digest algorithm: md5"
    }

    proba "rejects a short digest value" {
        adfirma structa_result(F_SCHEMA, identitas_variata(F_ALGO, "abc", F_LONGITUDO), manifestum_fixture()) ≡ "malformed digest value"
    }

    proba "rejects a non-hex digest value" {
        adfirma structa_result(F_SCHEMA, identitas_variata(F_ALGO, "zzzzzzzz00000000000000000000000000000000000000000000000000bac9c2", F_LONGITUDO), manifestum_fixture()) ≡ "malformed digest value"
    }

    proba "rejects a non-positive artifact byte length" {
        adfirma structa_result(F_SCHEMA, identitas_variata(F_ALGO, F_DIGEST, 0), manifestum_fixture()) ≡ "invalid artifact byte length"
    }

    proba "rejects a manifest whose artifact length does not match the identity" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", 2048, F_DATORUM, tensores_fixture())) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects a non-safetensors format name" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("gguf", "1.0.0", F_LONGITUDO, F_DATORUM, tensores_fixture())) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects an empty format name" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("", "1.0.0", F_LONGITUDO, F_DATORUM, tensores_fixture())) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects an empty format version" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "", F_LONGITUDO, F_DATORUM, tensores_fixture())) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects an empty data region" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, 0, [])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects a data region larger than the artifact" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, 2048, tensores_fixture())) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects an empty tensor name" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [descriptio("", "F32", [8, 4], 0, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects an empty tensor dtype" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [descriptio("w", "", [8, 4], 0, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects a zero-element tensor" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [descriptio("w", "F32", [8, 4], 0, 128, 0)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects an empty tensor shape" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [descriptio("w", "F32", [], 0, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects a negative tensor dimension" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [descriptio("w", "F32", [8, -4], 0, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects a tensor whose element count does not match the shape" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [descriptio("w", "F32", [8, 4], 0, 128, 31)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects a negative tensor data offset" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [descriptio("w", "F32", [8, 4], -1, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects a reversed tensor data range" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [descriptio("w", "F32", [8, 4], 128, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects a tensor range beyond the data region" {
        adfirma structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [descriptio("w", "F32", [8, 4], 0, 161, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
    }
}

# -- schema-versioned identity wire -----------------------------------------

probandum "capsule identity wire" {
    proba "deserialization rejects an unknown schema version" {
        adfirma identitas_wire_result("capsule/identity/3.0.0/sha-256/" + F_DIGEST + "/" + (F_LONGITUDO ↦ textus)) ≡ "unknown capsule schema version: 3.0.0"
    }

    proba "deserialization rejects an unknown marker" {
        adfirma identitas_wire_result("model/identity/2.0.0/sha-256/" + F_DIGEST + "/" + (F_LONGITUDO ↦ textus)) ≡ "unknown capsule identity marker"
    }

    proba "deserialization rejects a malformed wire form" {
        adfirma identitas_wire_result("capsule/identity/2.0.0/sha-256") ≡ "malformed capsule identity wire form"
    }

    proba "deserialization rejects a 9-segment non-schema-1 wire" {
        adfirma identitas_wire_result("capsule/identity/3.0.0/sha-256/" + F_DIGEST + "/4/q4_k/llama/16") ≡ "malformed capsule identity wire form"
    }

    proba "deserialization rejects an un-admitted digest algorithm" {
        adfirma identitas_wire_result("capsule/identity/2.0.0/md5/" + F_DIGEST + "/" + (F_LONGITUDO ↦ textus)) ≡ "unknown digest algorithm: md5"
    }

    proba "deserialization rejects a malformed digest" {
        adfirma identitas_wire_result("capsule/identity/2.0.0/sha-256/zz/" + (F_LONGITUDO ↦ textus)) ≡ "malformed digest value"
    }

    proba "deserialization rejects a non-numeric byte length" {
        adfirma identitas_wire_result("capsule/identity/2.0.0/sha-256/" + F_DIGEST + "/many") ≡ "malformed numeric field"
    }

    proba "deserialization rejects a non-positive byte length" {
        adfirma identitas_wire_result("capsule/identity/2.0.0/sha-256/" + F_DIGEST + "/0") ≡ "invalid byte length in capsule identity"
    }
}
