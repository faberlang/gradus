+++
locale = "en"
+++
# Co-located package test for capsule.fab (PML2-U1 admitted-model capsule,
# capsule-schema-2.0.0, A1C-M1).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the fail-closed schema-2 admission constructor
# (happy row + every typed rejection path), the schema-2 capsule surface
# (pathless content identity + per-format manifest with per-tensor
# descriptors), self-verification, the schema-versioned identity wire
# round-trip, and the schema-1 rejection at the boundary (SchemaVetus).
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned; compile-level until the FMIR stepper / faber test path
# covers library probas — recorded serialize.proba residual); `faber check`
# proves the whole surface type-checks.
#
# NOTE (pinned-row fixtures): the digest values are format-valid 64-hex
# fixtures (the value's SHA-256 computation is host-side per the module
# header). The Safetensors row is the structural F32 fixture row of
# fixtures/safetensors (smollm2-360m-scaled-row shape names), scaled to the
# rule set: two F32 tensors whose ranges tile the data region exactly.

import from "gradus:model/capsule" capsula

import from "gradus:model/artifact" artifact

# -- pinned fixture facts (structural Safetensors row) ----------------------

const string F_SCHEMA ← "2.0.0"

const string F_ALGO ← "sha-256"

const string F_DIGEST ← "2fa3f01300000000000000000000000000000000000000000000000000bac9c2"

const string F_ALIA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const int F_LONGITUDO ← 1024

const int F_DATORUM ← 160

# -- helpers ---------------------------------------------------------------

# The pathless content identity carried by every admitted fixture.
fn identitas_fixture() → artifact.ContentIdentity {
    return artifact.ContentIdentity {algorithm = F_ALGO, digest = F_DIGEST, length = F_LONGITUDO}
}

# An identity with caller-supplied fields (fail-closed cases).
fn identitas_variata(string algorithmus, string digestio, int longitudo) → artifact.ContentIdentity {
    return artifact.ContentIdentity {algorithm = algorithmus, digest = digestio, length = longitudo}
}

# A Safetensors tensor descriptor.
fn description(string nomen, string typo, list<int> forma, int initium, int finis, int elementa) → capsula.SafetensorsTensorDescriptor {
    return capsula.SafetensorsTensorDescriptor {name = nomen, dtype = typo, shape = forma, start = initium, end = finis, elements = elementa}
}

# The two-descriptor F32 fixture row (ranges tile the 160-byte data region).
fn tensores_fixture() → list<capsula.SafetensorsTensorDescriptor> {
    return [description("model.embed_tokens.weight", "F32", [8, 4], 0, 128, 32), description("model.norm.weight", "F32", [8], 128, 160, 8)]
}

# The well-formed Safetensors manifest (format/version + metadata + tensors).
fn manifestum_fixture() → capsula.SafetensorsManifest {
    return capsula.SafetensorsManifest {format = "safetensors", version = "1.0.0", artifact_length = F_LONGITUDO, data_length = F_DATORUM, metadata = [capsula.SafetensorsMetadata {key = "format.name", payload = "safetensors"}], tensors = tensores_fixture()}
}

# A manifest with caller-supplied fields (fail-closed cases).
fn manifestum_variata(string formatum, string versio, int longitudo_artifacti, int longitudo_datorum, list<capsula.SafetensorsTensorDescriptor> tensores) → capsula.SafetensorsManifest {
    return capsula.SafetensorsManifest {format = formatum, version = versio, artifact_length = longitudo_artifacti, data_length = longitudo_datorum, metadata = [], tensors = tensores}
}

# Renders an admission outcome as textus: "ok" on success, the typed
# error's causa on rejection.
fn structa_result(string schema, artifact.ContentIdentity id, capsula.SafetensorsManifest m) → string {
    do {
        const capsula.Capsule c ← capsula.construct_manifest(schema, id, capsula.safetensors_manifest(m))
        if c.schema() ≡ schema then return "ok"
        return "unexpected schema stamp"
    }
    catch err {
        return capsula.message(err)
    }
}

# Verifica outcome as textus.
fn verifica_result(capsula.Capsule c) → string {
    do {
        const bool ok ← capsula.verify(c)
        if ok then return "ok"
        return "verification failed"
    }
    catch err {
        return capsula.message(err)
    }
}

# Identity verification against an expected digest, as textus.
fn contra_result(capsula.Capsule c, string expectatum) → string {
    do {
        const bool ok ← capsula.verify_against(c, expectatum)
        if ok then return "ok"
        return "verification failed"
    }
    catch err {
        return capsula.message(err)
    }
}

# Identity wire outcome as textus ("ok" or the typed error's causa).
fn identitas_wire_result(string wire) → string {
    do {
        const capsula.Identity i ← capsula.deserialize_identity(wire)
        if i.schema() ≡ "2.0.0" then return "ok"
        return "unexpected schema"
    }
    catch err {
        return capsula.message(err)
    }
}

# Identity round-trip predicate: deserializa(serializa(c)).identia() ≡
# c.identia() by identitas_aequus.
fn roundtrip(capsula.Capsule c) → bool {
    do {
        const capsula.Identity i ← capsula.deserialize_identity(capsula.serialize_identity(c))
        return capsula.identity_equal(c.identity(), i)
    }
    catch err {
        return false
    }
}

# Hand-built schema-1-stamped capsule. structa_manifestum can never produce
# it (schema 1 is rejected at admission), so it is built directly here to
# prove verifica's boundary rejects the retired stamp with SchemaVetus.
fn capsula_schema_vetus() → capsula.Capsule {
    return capsula.Capsule {schema = "1.0.0", identitas = identitas_fixture(), manifestum = capsula.safetensors_manifest(manifestum_fixture())}
}

# The schema-2 wire for the pinned identity.
fn wire_fixture() → string {
    return (((((("capsule/identity/" + F_SCHEMA) + "/") + F_ALGO) + "/") + F_DIGEST) + "/") + (F_LONGITUDO ↦ string)
}

# -- admission (happy row) --------------------------------------------------

test "admission admits the schema-2 safetensors capsule" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_fixture()) ≡ "ok"
}

test "the capsule stamps schema 2.0.0 and carries identity and manifest" {
    do {
        const capsula.Capsule c ← capsula.construct_manifest(F_SCHEMA, identitas_fixture(), capsula.safetensors_manifest(manifestum_fixture()))
        # Schema stamp (capsule-schema-2.0.0).
        assert c.schema() ≡ "2.0.0"
        # Pathless content identity.
        assert c.algorithm() ≡ "sha-256"
        assert c.digest() ≡ F_DIGEST
        assert c.length() ≡ F_LONGITUDO
        # Per-format manifest.
        assert c.format() ≡ "safetensors"
        # The compact schema-versioned identity record.
        assert c.identity().schema() ≡ "2.0.0"
        assert c.identity().algorithm() ≡ "sha-256"
        assert c.identity().digest() ≡ F_DIGEST
        assert c.identity().byte_length() ≡ F_LONGITUDO
    }
    catch err {
        assert false
    }
}

test "verifica passes on an admitted capsule" {
    do {
        const capsula.Capsule c ← capsula.construct_manifest(F_SCHEMA, identitas_fixture(), capsula.safetensors_manifest(manifestum_fixture()))
        assert verifica_result(c) ≡ "ok"
    }
    catch err {
        assert false
    }
}

test "the capsule carries the safetensors manifest" {
    do {
        const capsula.Capsule c ← capsula.construct_manifest(F_SCHEMA, identitas_fixture(), capsula.safetensors_manifest(manifestum_fixture()))
        assert c.safetensors_manifest() not is null
    }
    catch err {
        assert false
    }
}

test "per-tensor descriptors are visible in the safetensors manifest" {
    do {
        const capsula.Capsule c ← capsula.construct_manifest(F_SCHEMA, identitas_fixture(), capsula.safetensors_manifest(manifestum_fixture()))
        assert c.tensor_count() ≡ 2
        const capsula.SafetensorsTensorDescriptor d0 ← manifestum_fixture().description(0)
        assert d0.name() ≡ "model.embed_tokens.weight"
        assert d0.dtype() ≡ "F32"
        assert d0.elements() ≡ 32
        const capsula.SafetensorsTensorDescriptor d1 ← manifestum_fixture().description(1)
        assert d1.name() ≡ "model.norm.weight"
        assert d1.elements() ≡ 8
        const capsula.SafetensorsMetadata meta ← manifestum_fixture().metadata(0)
        assert meta.key() ≡ "format.name"
        assert meta.payload() ≡ "safetensors"
        assert manifestum_fixture().tensor_count() ≡ 2
    }
    catch err {
        assert false
    }
}

test "identity verifies against the expected digest and fails closed on a mismatch" {
    do {
        const capsula.Capsule c ← capsula.construct_manifest(F_SCHEMA, identitas_fixture(), capsula.safetensors_manifest(manifestum_fixture()))
        assert contra_result(c, F_DIGEST) ≡ "ok"
        assert contra_result(c, F_ALIA) ≡ "digest mismatch — capsule does not match the expected artifact"
    }
    catch err {
        assert false
    }
}

test "the identity record round-trips the wire form" {
    do {
        const capsula.Capsule c ← capsula.construct_manifest(F_SCHEMA, identitas_fixture(), capsula.safetensors_manifest(manifestum_fixture()))
        assert roundtrip(c)
        assert identitas_wire_result(wire_fixture()) ≡ "ok"
    }
    catch err {
        assert false
    }
}

test "a different digest changes the identity" {
    do {
        const capsula.Capsule a ← capsula.construct_manifest(F_SCHEMA, identitas_fixture(), capsula.safetensors_manifest(manifestum_fixture()))
        const capsula.Capsule b ← capsula.construct_manifest(F_SCHEMA, identitas_variata(F_ALGO, F_ALIA, F_LONGITUDO), capsula.safetensors_manifest(manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, tensores_fixture())))
        assert capsula.identity_equal(a.identity(), a.identity())
        assert not capsula.identity_equal(a.identity(), b.identity())
    }
    catch err {
        assert false
    }
}

# -- schema-1 rejection at the boundary (SchemaVetus) -----------------------

test "structa_manifestum rejects a schema-1 stamp" {
    assert structa_result("1.0.0", identitas_fixture(), manifestum_fixture()) ≡ "schema 1 is retired — capsule schema is 2.0.0"
}

test "verifica rejects a schema-1-stamped capsule" {
    assert verifica_result(capsula_schema_vetus()) ≡ "schema 1 is retired — capsule schema is 2.0.0"
}

test "deserialization rejects a schema-1-stamped wire" {
    assert identitas_wire_result((("capsule/identity/1.0.0/sha-256/" + F_DIGEST) + "/") + (F_LONGITUDO ↦ string)) ≡ "schema 1 is retired — capsule schema is 2.0.0"
}

test "deserialization rejects the retired 9-segment schema-1 wire" {
    assert identitas_wire_result(("capsule/identity/1.0.0/sha-256/" + F_DIGEST) + "/4/q4_k/llama/16") ≡ "schema 1 is retired — capsule schema is 2.0.0"
}

# -- fail-closed construction (error paths) ---------------------------------

test "rejects an unknown schema version" {
    assert structa_result("3.0.0", identitas_fixture(), manifestum_fixture()) ≡ "unknown capsule schema version: 3.0.0"
}

test "rejects an un-admitted digest algorithm" {
    assert structa_result(F_SCHEMA, identitas_variata("md5", F_DIGEST, F_LONGITUDO), manifestum_fixture()) ≡ "unknown digest algorithm: md5"
}

test "rejects a short digest value" {
    assert structa_result(F_SCHEMA, identitas_variata(F_ALGO, "abc", F_LONGITUDO), manifestum_fixture()) ≡ "malformed digest value"
}

test "rejects a non-hex digest value" {
    assert structa_result(F_SCHEMA, identitas_variata(F_ALGO, "zzzzzzzz00000000000000000000000000000000000000000000000000bac9c2", F_LONGITUDO), manifestum_fixture()) ≡ "malformed digest value"
}

test "rejects a non-positive artifact byte length" {
    assert structa_result(F_SCHEMA, identitas_variata(F_ALGO, F_DIGEST, 0), manifestum_fixture()) ≡ "invalid artifact byte length"
}

test "rejects a manifest whose artifact length does not match the identity" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", 2048, F_DATORUM, tensores_fixture())) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects a non-safetensors format name" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("gguf", "1.0.0", F_LONGITUDO, F_DATORUM, tensores_fixture())) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects an empty format name" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("", "1.0.0", F_LONGITUDO, F_DATORUM, tensores_fixture())) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects an empty format version" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "", F_LONGITUDO, F_DATORUM, tensores_fixture())) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects an empty data region" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, 0, [])) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects a data region larger than the artifact" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, 2048, tensores_fixture())) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects an empty tensor name" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [description("", "F32", [8, 4], 0, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects an empty tensor dtype" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [description("w", "", [8, 4], 0, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects a zero-element tensor" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [description("w", "F32", [8, 4], 0, 128, 0)])) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects an empty tensor shape" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [description("w", "F32", [], 0, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects a negative tensor dimension" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [description("w", "F32", [8, -4], 0, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects a tensor whose element count does not match the shape" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [description("w", "F32", [8, 4], 0, 128, 31)])) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects a negative tensor data offset" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [description("w", "F32", [8, 4], -1, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects a reversed tensor data range" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [description("w", "F32", [8, 4], 128, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
}

test "rejects a tensor range beyond the data region" {
    assert structa_result(F_SCHEMA, identitas_fixture(), manifestum_variata("safetensors", "1.0.0", F_LONGITUDO, F_DATORUM, [description("w", "F32", [8, 4], 0, 161, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
}

# -- schema-versioned identity wire -----------------------------------------

test "deserialization rejects an unknown schema version" {
    assert identitas_wire_result((("capsule/identity/3.0.0/sha-256/" + F_DIGEST) + "/") + (F_LONGITUDO ↦ string)) ≡ "unknown capsule schema version: 3.0.0"
}

test "deserialization rejects an unknown marker" {
    assert identitas_wire_result((("model/identity/2.0.0/sha-256/" + F_DIGEST) + "/") + (F_LONGITUDO ↦ string)) ≡ "unknown capsule identity marker"
}

test "deserialization rejects a malformed wire form" {
    assert identitas_wire_result("capsule/identity/2.0.0/sha-256") ≡ "malformed capsule identity wire form"
}

test "deserialization rejects a 9-segment non-schema-1 wire" {
    assert identitas_wire_result(("capsule/identity/3.0.0/sha-256/" + F_DIGEST) + "/4/q4_k/llama/16") ≡ "malformed capsule identity wire form"
}

test "deserialization rejects an un-admitted digest algorithm" {
    assert identitas_wire_result((("capsule/identity/2.0.0/md5/" + F_DIGEST) + "/") + (F_LONGITUDO ↦ string)) ≡ "unknown digest algorithm: md5"
}

test "deserialization rejects a malformed digest" {
    assert identitas_wire_result("capsule/identity/2.0.0/sha-256/zz/" + (F_LONGITUDO ↦ string)) ≡ "malformed digest value"
}

test "deserialization rejects a non-numeric byte length" {
    assert identitas_wire_result(("capsule/identity/2.0.0/sha-256/" + F_DIGEST) + "/many") ≡ "malformed numeric field"
}

test "deserialization rejects a non-positive byte length" {
    assert identitas_wire_result(("capsule/identity/2.0.0/sha-256/" + F_DIGEST) + "/0") ≡ "invalid byte length in capsule identity"
}
