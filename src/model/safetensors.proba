# Co-located package test for safetensors.fab (PML2-U2 Safetensors row
# admission). Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the pinned legal fixture reconstructs the exact
# committed row bytes and admits -> schema-2 capsule (capsule-schema-2.0.0:
# pathless artifact.IdentitasContenuti plus the capsule's
# ManifestumSafetensors) with the pinned identity; the oracle hash binds the
# capsule digest (verifica_contra); the manifest carries the pinned row
# facts (arch/tokenizer metadata + F32 per-tensor descriptors); and the
# negative matrix (truncated prefix/header/data, non-JSON header, non-object
# header, misaligned header, format-name mismatch, row-version mismatch, arch
# mismatch incl. extra/missing tensors, unsupported dtype, duplicate tensor,
# misaligned data offset, overlapping data regions, gapped data region,
# shape mismatch, shape/offset inconsistency, tokenizer identity mismatch,
# metadata structure violations, ceilings, malformed digest claim) fails
# closed with the module's typed errors. adfirma assertions run under the
# cargo-backed `faber test` harness (auditor-owned); `faber check` on this
# file proves the whole surface type-checks (WARN014 seam — the module's
# public surface stays on primitives + capsula.Capsula).
#
# NOTE (fixture + oracle): the pinned fixture is
# fixtures/safetensors/smollm2-360m-scaled-row.safetensors (1512 bytes,
# SHA-256 42444229…5f75d8 — see safetensors-row-oracle.md). This proba
# RECONSTRUCTS those exact bytes from the same JSON string + data pattern as
# the committed generator (gen_fixture.py); byte-equivalence is part of the
# oracle contract. The digest VALUE is host-computed per the capsule
# boundary (capsule.fab header); the oracle hash is pinned here and the
# capsule's identity is checked against it via verifica_contra.

importa ex "gradus:model/safetensors" safetensors
importa ex "gradus:model/capsule" capsula

# -- pinned row constants (must agree byte-for-byte with gen_fixture.py) ---

fixum textus PRAESTOLATUM_JSON ← "{\"__metadata__\":{\"format.name\":\"safetensors\",\"format.version\":\"1.0.0\",\"model.arch\":\"llama\",\"model.density\":\"dense\",\"model.layers\":\"1\",\"model.context\":\"2048\",\"tokenizer.model\":\"gpt2\",\"tokenizer.pre\":\"smollm\",\"tokenizer.vocab_digest\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"tokenizer.eog\":\"0,2\",\"tokenizer.bos_free\":\"true\",\"tokenizer.space_prefix_free\":\"true\"},\"model.embed_tokens.weight\":{\"dtype\":\"F32\",\"shape\":[8,4],\"data_offsets\":[0,128]},\"model.norm.weight\":{\"dtype\":\"F32\",\"shape\":[8],\"data_offsets\":[128,160]},\"model.layers.0.self_attn.q_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,8],\"data_offsets\":[160,416]},\"model.layers.0.self_attn.v_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,4],\"data_offsets\":[416,544]},\"model.layers.0.mlp.down_proj.weight\":{\"dtype\":\"F32\",\"shape\":[4,8],\"data_offsets\":[544,672]}}"

fixum numerus PRAESTOLATUM_DATA_LONGITUDO ← 672
fixum numerus PRAESTOLATUM_LONGITUDO ← 1512
fixum textus PRAESTOLATUM_HASH ← "424442296e97c261de42fd496cc6cdb4496f3f632835479de96a7ed76c5f75d8"
fixum textus F_ALIA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
fixum textus F_VOCAB ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# -- byte-building helpers (mirror of the committed generator) --------------

# 8-byte little-endian header-size prefix.
functio _caput8(numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    out.appende((n ⇒ 0) ↦ numerus<u8>)
    out.appende((n ⇒ 8) ↦ numerus<u8>)
    out.appende((n ⇒ 16) ↦ numerus<u8>)
    out.appende((n ⇒ 24) ↦ numerus<u8>)
    out.appende((n ⇒ 32) ↦ numerus<u8>)
    out.appende((n ⇒ 40) ↦ numerus<u8>)
    out.appende((n ⇒ 48) ↦ numerus<u8>)
    out.appende((n ⇒ 56) ↦ numerus<u8>)
    redde out
}

# textus -> UTF-8 byte list.
functio _textus_bytes(textus s) → lista<numerus<u8>> {
    fixum octeti o ← s ↦ octeti
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < o.longitudo() {
        out.appende(o.accipe(i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    redde out
}

# Concatenate two byte lists.
functio _iunge(lista<numerus<u8>> a, lista<numerus<u8>> b) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    itera ex a fixum x { out.appende(x) }
    itera ex b fixum x { out.appende(x) }
    redde out
}

# Deterministic data-byte pattern (matches the generator).
functio _data_pattern(numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < n {
        out.appende(((i * 13 + 7) % 256) ↦ numerus<u8>)
        i ← i + 1
    }
    redde out
}

# Assemble a Safetensors container: LE prefix (header_size includes the
# 8-byte prefix; header padded with spaces to 8-alignment) + data region.
functio _continer(textus caput_json, lista<numerus<u8>> data) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> hb ← _textus_bytes(caput_json)
    fixum numerus n ← hb.longitudo()
    fixum numerus aligned ← ((n + 7) / 8) * 8
    varia lista<numerus<u8>> padded ← vacua
    itera ex hb fixum x { padded.appende(x) }
    varia numerus i ← n
    dum i < aligned {
        padded.appende(32 ↦ numerus<u8>)
        i ← i + 1
    }
    fixum numerus caput ← aligned + 8
    redde _iunge(_iunge(_caput8(caput), padded), data)
}

# The pinned legal fixture, reconstructed byte-for-byte.
functio fixatura() → lista<numerus<u8>> {
    redde _continer(PRAESTOLATUM_JSON, _data_pattern(PRAESTOLATUM_DATA_LONGITUDO))
}

# A truncated fixture (first n bytes only).
functio _truncata(numerus n) → lista<numerus<u8>> {
    redde fixatura().prima(n)
}

# Admission outcome as textus: "ok" or the typed error's causa.
functio admittas_result(lista<numerus<u8>> corpus, textus digestio, textus semita) → textus {
    fac {
        fixum capsula.Capsula c ← safetensors.admittas(corpus, digestio, semita)
        redde "ok"
    }
    cape err {
        redde safetensors.causa(err)
    }
}

# verifica_contra outcome as textus.
functio contra_result(capsula.Capsula c, textus expectatum) → textus {
    fac {
        fixum bivalens ok ← capsula.verifica_contra(c, expectatum)
        redde "ok"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Manifest metadata lookup by key (safetensors.fab's own lookup is private).
functio meta_valor(capsula.ManifestumSafetensors m, textus clavis) → textus {
    fac {
        itera ab 0‥m.metadatorum_numerus() fixum i {
            si m.metadatum(i).clavis() ≡ clavis {
                redde m.metadatum(i).valor()
            }
        }
    }
    cape err {
        redde ""
    }
    redde ""
}

# Indexed tensor descriptor with the manifest's AdmissionError contained
# (the proba's fac blocks catch safetensors.SafetensorError only).
functio descriptio_facta(capsula.ManifestumSafetensors m, numerus i) → capsula.DescriptioTensorisSafetensori {
    fac {
        redde m.descriptio(i)
    }
    cape err {
        redde capsula.DescriptioTensorisSafetensori { nomen = "", typo = "", forma = [], initium = -1, finis = -1, elementa = -1 }
    }
}

# Schema-2 identity wire round-trip: deserializa(serializa(c)).identia() ≡
# c.identia() by identitas_aequus.
functio roundtrip(capsula.Capsula c) → bivalens {
    fac {
        fixum capsula.Identitas i ← capsula.deserializa_identitas(capsula.serializa_identitas(c))
        redde capsula.identitas_aequus(c.identia(), i)
    }
    cape err {
        redde falsum
    }
}

# -- happy row --------------------------------------------------------------

probandum "safetensors row admission" {
    proba "the pinned fixture reconstructs to the oracle byte length and admits" {
        adfirma admittas_result(fixatura(), PRAESTOLATUM_HASH, "") ≡ "ok"
        adfirma fixatura().longitudo() ≡ PRAESTOLATUM_LONGITUDO
    }

    proba "the capsule carries the pinned row identity" {
        fac {
            fixum capsula.Capsula c ← safetensors.admittas(fixatura(), PRAESTOLATUM_HASH, "")
            # schema stamp (capsule-schema-2.0.0).
            adfirma c.schematis() ≡ "2.0.0"
            # pathless content identity: host-verified digest claim + length.
            adfirma c.algorithmus() ≡ "sha-256"
            adfirma c.digestio() ≡ PRAESTOLATUM_HASH
            adfirma c.longitudo() ≡ PRAESTOLATUM_LONGITUDO
            # per-format manifest.
            adfirma c.formatum() ≡ "safetensors"
            adfirma c.tensorum_numerus() ≡ 5
            adfirma c.manifestum_safetensors() non est nihil
            # the compact schema-versioned identity record.
            adfirma c.identia().schematis() ≡ "2.0.0"
            adfirma c.identia().algorithmus() ≡ "sha-256"
            adfirma c.identia().digestio() ≡ PRAESTOLATUM_HASH
            adfirma c.identia().longitudo_bytes() ≡ PRAESTOLATUM_LONGITUDO
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the manifest carries the pinned row facts" {
        fac {
            fixum capsula.Capsula c ← safetensors.admittas(fixatura(), PRAESTOLATUM_HASH, "")
            fixum capsula.ManifestumSafetensors m ← c.manifestum_safetensors() vel capsula.ManifestumSafetensors { formatum = "", versio = "", longitudo_artifacti = 0, longitudo_datorum = 0, metadata = [], tensores = [] }
            # container facts (format/version, artifact/data lengths).
            adfirma m.formatum() ≡ "safetensors"
            adfirma m.versio() ≡ "1.0.0"
            adfirma m.longitudo_artefacti() ≡ PRAESTOLATUM_LONGITUDO
            adfirma m.longitudo_datorum() ≡ PRAESTOLATUM_DATA_LONGITUDO
            # header metadata carries the pinned arch/tokenizer identity
            # (the schema-1 capsule fields now live in the manifest).
            adfirma m.metadatorum_numerus() ≡ 12
            adfirma meta_valor(m, "model.arch") ≡ "llama"
            adfirma meta_valor(m, "model.density") ≡ "dense"
            adfirma meta_valor(m, "model.layers") ≡ "1"
            adfirma meta_valor(m, "model.context") ≡ "2048"
            adfirma meta_valor(m, "tokenizer.model") ≡ "gpt2"
            adfirma meta_valor(m, "tokenizer.pre") ≡ "smollm"
            adfirma meta_valor(m, "tokenizer.vocab_digest") ≡ F_VOCAB
            adfirma meta_valor(m, "tokenizer.eog") ≡ "0,2"
            adfirma meta_valor(m, "tokenizer.bos_free") ≡ "true"
            adfirma meta_valor(m, "tokenizer.space_prefix_free") ≡ "true"
            # per-tensor F32 descriptors (structural row; no quantization
            # claims — D4).
            fixum capsula.DescriptioTensorisSafetensori d0 ← descriptio_facta(m, 0)
            adfirma d0.nomen() ≡ "model.embed_tokens.weight"
            adfirma d0.typo() ≡ "F32"
            adfirma d0.forma().longitudo() ≡ 2
            adfirma d0.forma().accipe(0) vel -1 ≡ 8
            adfirma d0.forma().accipe(1) vel -1 ≡ 4
            adfirma d0.elementa() ≡ 32
            adfirma d0.initium() ≡ 0
            adfirma d0.finis() ≡ 128
            fixum capsula.DescriptioTensorisSafetensori d1 ← descriptio_facta(m, 1)
            adfirma d1.nomen() ≡ "model.norm.weight"
            adfirma d1.elementa() ≡ 8
            adfirma d1.initium() ≡ 128
            adfirma d1.finis() ≡ 160
            fixum capsula.DescriptioTensorisSafetensori d4 ← descriptio_facta(m, 4)
            adfirma d4.nomen() ≡ "model.layers.0.mlp.down_proj.weight"
            adfirma d4.elementa() ≡ 32
            adfirma m.tensorum_numerus() ≡ 5
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the schema-2 identity record round-trips the wire form" {
        fac {
            fixum capsula.Capsula c ← safetensors.admittas(fixatura(), PRAESTOLATUM_HASH, "")
            adfirma roundtrip(c)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the oracle hash binds the capsule identity" {
        fac {
            fixum capsula.Capsula c ← safetensors.admittas(fixatura(), PRAESTOLATUM_HASH, "")
            adfirma contra_result(c, PRAESTOLATUM_HASH) ≡ "ok"
            adfirma contra_result(c, F_ALIA) ≡ "digest mismatch — capsule does not match the expected artifact"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the provenance path is locator metadata, never identity" {
        fac {
            fixum capsula.Capsula a ← safetensors.admittas(fixatura(), PRAESTOLATUM_HASH, "")
            fixum capsula.Capsula b ← safetensors.admittas(fixatura(), PRAESTOLATUM_HASH, "cache/models/smollm2-scaled.safetensors")
            # schema-2 identity carries no path: the two admissions are the
            # same content identity despite different locator paths.
            adfirma capsula.identitas_aequus(a.identia(), b.identia())
            adfirma a.identia().digestio() ≡ b.identia().digestio()
            adfirma a.identia().longitudo_bytes() ≡ b.identia().longitudo_bytes()
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a malformed digest claim fails closed before the row is admitted" {
        adfirma admittas_result(fixatura(), "zz", "") ≡ "malformed digest value"
    }
}

# -- negative matrix (fail closed, typed errors) -----------------------------

probandum "safetensors fail-closed matrix" {
    proba "rejects a truncated header prefix" {
        adfirma admittas_result(_truncata(4), PRAESTOLATUM_HASH, "") ≡ "truncated safetensors header prefix"
    }

    proba "rejects a header extending beyond the file" {
        adfirma admittas_result(_truncata(500), PRAESTOLATUM_HASH, "") ≡ "truncated header — header size beyond file"
    }

    proba "rejects a truncated data region" {
        adfirma admittas_result(_truncata(1000), PRAESTOLATUM_HASH, "") ≡ "data region truncated — tensor extends beyond file: model.layers.0.self_attn.q_proj.weight"
    }

    proba "rejects a non-JSON header" {
        adfirma admittas_result(_continer("garbage", _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "unexpected character in header"
    }

    proba "rejects a header that is not a JSON object" {
        adfirma admittas_result(_continer("[1,2,3]", _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "header is not a JSON object"
    }

    proba "rejects trailing tokens after the top-level object" {
        # A valid row header followed by a stray member (e.g. `},"x":1`)
        # must fail closed: the walk consumes the whole token stream or
        # rejects. Auditor-2 F2 (fire-4).
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON + ",\"x\":1", _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "trailing tokens after the header object"
    }

    proba "rejects a non-8-byte-aligned header" {
        fixum lista<numerus<u8>> mis ← _iunge(_caput8(841), _iunge(_textus_bytes(PRAESTOLATUM_JSON), _data_pattern(672)))
        adfirma admittas_result(mis, PRAESTOLATUM_HASH, "") ≡ "misaligned safetensors header (not 8-byte aligned)"
    }

    proba "rejects an unsupported format name" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"format.name\":\"safetensors\"", "\"format.name\":\"gguf\""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "unsupported safetensors format: gguf"
    }

    proba "rejects an unsupported row version" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"format.version\":\"1.0.0\"", "\"format.version\":\"2.0.0\""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "unsupported safetensors row version: 2.0.0"
    }

    proba "rejects an architecture mismatch" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"model.arch\":\"llama\"", "\"model.arch\":\"qwen2\""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "architecture mismatch"
    }

    proba "rejects a density-class mismatch" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"model.density\":\"dense\"", "\"model.density\":\"sparse\""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "architecture mismatch"
    }

    proba "rejects a tensor outside the admitted row (tied-embeddings arch rule)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"model.norm.weight\"", "\"output.weight\""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "tensor not in admitted row: output.weight"
    }

    proba "rejects a tensor-count mismatch" {
        fixum textus six ← PRAESTOLATUM_JSON.muta("\"data_offsets\":[544,672]}}", "\"data_offsets\":[544,672]},\"model.layers.0.mlp.up_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,8],\"data_offsets\":[672,928]}}")
        adfirma admittas_result(_continer(six, _data_pattern(928)), PRAESTOLATUM_HASH, "") ≡ "tensor count mismatch"
    }

    proba "rejects an unsupported dtype" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"dtype\":\"F32\"", "\"dtype\":\"F16\""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "unsupported dtype: F16 for model.embed_tokens.weight"
    }

    proba "rejects a duplicate tensor name" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"model.layers.0.mlp.down_proj.weight\"", "\"model.embed_tokens.weight\""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "duplicate tensor name: model.embed_tokens.weight"
    }

    proba "rejects a misaligned tensor data offset" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"data_offsets\":[0,128]", "\"data_offsets\":[4,132]"), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "misaligned tensor data offset: model.embed_tokens.weight"
    }

    proba "rejects overlapping tensor data regions" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"data_offsets\":[128,160]", "\"data_offsets\":[64,96]"), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "overlapping tensor data regions"
    }

    proba "rejects a gapped data region (no exact tiling)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON, _data_pattern(676)), PRAESTOLATUM_HASH, "") ≡ "data region does not tile exactly"
    }

    proba "rejects a shape mismatch" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"shape\":[8,4]", "\"shape\":[8,5]"), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "shape mismatch for model.embed_tokens.weight"
    }

    proba "rejects a shape/offset byte-length inconsistency" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"data_offsets\":[0,128]", "\"data_offsets\":[0,132]"), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "shape/offset inconsistency for model.embed_tokens.weight"
    }

    proba "rejects a dimension above the ceiling" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"shape\":[8,4]", "\"shape\":[70000,4]"), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "dimension above ceiling"
    }

    proba "rejects a total element count above the ceiling" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"shape\":[8,4]", "\"shape\":[65536,20000]"), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "element count above ceiling"
    }

    proba "rejects a tensor-name above the length ceiling" {
        fixum textus longe ← PRAESTOLATUM_JSON.muta("\"model.norm.weight\"", "\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"")
        adfirma admittas_result(_continer(longe, _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "tensor name above length ceiling"
    }

    proba "rejects a tokenizer model mismatch" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"tokenizer.model\":\"gpt2\"", "\"tokenizer.model\":\"llama\""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "tokenizer identity mismatch"
    }

    proba "rejects a tokenizer EOG-set mismatch" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"tokenizer.eog\":\"0,2\"", "\"tokenizer.eog\":\"2,0\""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "tokenizer identity mismatch"
    }

    proba "rejects a tokenizer BOS-free mismatch" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"tokenizer.bos_free\":\"true\"", "\"tokenizer.bos_free\":\"false\""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "tokenizer identity mismatch"
    }

    proba "rejects a malformed vocabulary digest" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"tokenizer.vocab_digest\":\"" + F_VOCAB + "\"", "\"tokenizer.vocab_digest\":\"zz\""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "malformed vocabulary digest"
    }

    proba "rejects a non-string metadata value" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"model.layers\":\"1\"", "\"model.layers\":1"), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "metadata value must be a string"
    }

    proba "rejects a missing required metadata key" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"format.name\":\"safetensors\",", ""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "missing required metadata key: format.name"
    }

    proba "rejects a header with no __metadata__ — fails at the first required key" {
        # meta_visa is set but never read in safetensors.fab: there is no
        # "missing __metadata__" error. A header without __metadata__ walks
        # to an empty metadata table and fails closed at the first required
        # key (format.name) — the same behavior the conformance suite
        # asserts for this identical header.
        adfirma admittas_result(_continer("{\"model.norm.weight\":{\"dtype\":\"F32\",\"shape\":[8],\"data_offsets\":[0,32]}}", _data_pattern(32)), PRAESTOLATUM_HASH, "") ≡ "missing required metadata key: format.name"
    }
}
