+++
locale = "en"
+++
# Co-located package test for safetensors.fab (PML2-U2 Safetensors row
# admission). Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the pinned legal fixture reconstructs the exact
# committed row bytes and admits -> schema-2 capsule (capsule-schema-2.0.0:
# pathless artifact.IdentitasContenuti plus the capsule's
# ManifestumSafetensors) with the pinned identity; the oracle hash binds the
# capsule digest (verifica_contra); the manifest carries the pinned row
# facts (arch/tokenizer metadata + F32 per-tensor descriptors); and the
# negative matrix (truncated prefix/header/data, non-JSON header, non-object
# header, misaligned header, format-name mismatch, row-version mismatch, arch
# mismatch incl. extra/missing tensors, unsupported dtype, duplicate tensor,
# misaligned data offset, overlapping data regions, gapped data region,
# shape mismatch, shape/offset inconsistency, tokenizer identity mismatch,
# metadata structure violations, ceilings, malformed digest claim) fails
# closed with the module's typed errors. adfirma assertions run under the
# cargo-backed `faber test` harness (auditor-owned); `faber check` on this
# file proves the whole surface type-checks (WARN014 seam — the module's
# public surface stays on primitives + capsula.Capsula).
#
# NOTE (fixture + oracle): the pinned fixture is
# fixtures/safetensors/smollm2-360m-scaled-row.safetensors (1512 bytes,
# SHA-256 42444229…5f75d8 — see safetensors-row-oracle.md). This proba
# RECONSTRUCTS those exact bytes from the same JSON string + data pattern as
# the committed generator (gen_fixture.py); byte-equivalence is part of the
# oracle contract. The digest VALUE is host-computed per the capsule
# boundary (capsule.fab header); the oracle hash is pinned here and the
# capsule's identity is checked against it via verifica_contra.

import from "gradus:model/safetensors" safetensors

import from "gradus:model/capsule" capsula

# -- pinned row constants (must agree byte-for-byte with gen_fixture.py) ---

const string PRAESTOLATUM_JSON ← «{\"__metadata__\":{\"format.name\":\"safetensors\",\"format.version\":\"1.0.0\",\"model.arch\":\"llama\",\"model.density\":\"dense\",\"model.layers\":\"1\",\"model.context\":\"2048\",\"tokenizer.model\":\"gpt2\",\"tokenizer.pre\":\"smollm\",\"tokenizer.vocab_digest\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"tokenizer.eog\":\"0,2\",\"tokenizer.bos_free\":\"true\",\"tokenizer.space_prefix_free\":\"true\"},\"model.embed_tokens.weight\":{\"dtype\":\"F32\",\"shape\":[8,4],\"data_offsets\":[0,128]},\"model.norm.weight\":{\"dtype\":\"F32\",\"shape\":[8],\"data_offsets\":[128,160]},\"model.layers.0.self_attn.q_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,8],\"data_offsets\":[160,416]},\"model.layers.0.self_attn.v_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,4],\"data_offsets\":[416,544]},\"model.layers.0.mlp.down_proj.weight\":{\"dtype\":\"F32\",\"shape\":[4,8],\"data_offsets\":[544,672]}}»

const int PRAESTOLATUM_DATA_LONGITUDO ← 672

const int PRAESTOLATUM_LONGITUDO ← 1512

const string PRAESTOLATUM_HASH ← "424442296e97c261de42fd496cc6cdb4496f3f632835479de96a7ed76c5f75d8"

const string F_ALIA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

const string F_VOCAB ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# -- byte-building helpers (mirror of the committed generator) --------------

# 8-byte little-endian header-size prefix.
fn _caput8(int n) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    out.append((n ⇒ 0) ↦ int<u8>)
    out.append((n ⇒ 8) ↦ int<u8>)
    out.append((n ⇒ 16) ↦ int<u8>)
    out.append((n ⇒ 24) ↦ int<u8>)
    out.append((n ⇒ 32) ↦ int<u8>)
    out.append((n ⇒ 40) ↦ int<u8>)
    out.append((n ⇒ 48) ↦ int<u8>)
    out.append((n ⇒ 56) ↦ int<u8>)
    return out
}

# textus -> UTF-8 byte list.
fn _textus_bytes(string s) → list<int<u8>> {
    const bytes o ← s ↦ bytes
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ o.length() {
        out.append(o.get(i) coalesce 0 ∷ int<u8>)
        i ← i + 1
    }
    return out
}

# Concatenate two byte lists.
fn _iunge(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

# Deterministic data-byte pattern (matches the generator).
fn _data_pattern(int n) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ n {
        out.append((i * 13 + 7) % 256 ↦ int<u8>)
        i ← i + 1
    }
    return out
}

# Assemble a Safetensors container: LE prefix (header_size includes the
# 8-byte prefix; header padded with spaces to 8-alignment) + data region.
fn _continer(string caput_json, list<int<u8>> data) → list<int<u8>> {
    const list<int<u8>> hb ← _textus_bytes(caput_json)
    const int n ← hb.length()
    const int aligned ← ((n + 7) / 8) * 8
    var list<int<u8>> padded ← vacua
    for from hb const x {
        padded.append(x)
    }
    var int i ← n
    while i ≺ aligned {
        padded.append(32 ↦ int<u8>)
        i ← i + 1
    }
    const int caput ← aligned + 8
    return _iunge(_iunge(_caput8(caput), padded), data)
}

# The pinned legal fixture, reconstructed byte-for-byte.
fn fixatura() → list<int<u8>> {
    return _continer(PRAESTOLATUM_JSON, _data_pattern(PRAESTOLATUM_DATA_LONGITUDO))
}

# A truncated fixture (first n bytes only).
fn _truncata(int n) → list<int<u8>> {
    return fixatura().take(n)
}

# Admission outcome as textus: "ok" or the typed error's causa.
fn admittas_result(list<int<u8>> corpus, string digestio, string semita) → string {
    do {
        const capsula.Capsule c ← safetensors.admittas(corpus, digestio, semita)
        return "ok"
    }
    catch err {
        return safetensors.message(err)
    }
}

# verifica_contra outcome as textus.
fn contra_result(capsula.Capsule c, string expectatum) → string {
    do {
        const bool ok ← capsula.verify_against(c, expectatum)
        return "ok"
    }
    catch err {
        return capsula.message(err)
    }
}

# Manifest metadata lookup by key (safetensors.fab's own lookup is private).
fn meta_valor(capsula.SafetensorsManifest m, string clavis) → string {
    do {
        for range 0‥m.metadata_count() const i {
            if m.metadata(i).key() ≡ clavis then return m.metadata(i).payload()
        }
    }
    catch err {
        return ""
    }
    return ""
}

# Indexed tensor descriptor with the manifest's AdmissionError contained
# (the proba's fac blocks catch safetensors.SafetensorError only).
fn descriptio_facta(capsula.SafetensorsManifest m, int i) → capsula.SafetensorsTensorDescriptor {
    do {
        return m.description(i)
    }
    catch err {
        return capsula.SafetensorsTensorDescriptor {name = "", dtype = "", shape = [], start = -1, end = -1, elements = -1}
    }
}

# Schema-2 identity wire round-trip: deserializa(serializa(c)).identia() ≡
# c.identia() by identitas_aequus.
fn roundtrip(capsula.Capsule c) → bool {
    do {
        const capsula.Identity i ← capsula.deserialize_identity(capsula.serialize_identity(c))
        return capsula.identity_equal(c.identity(), i)
    }
    catch err {
        return false
    }
}

# -- happy row --------------------------------------------------------------

test "the pinned fixture reconstructs to the oracle byte length and admits" {
    assert admittas_result(fixatura(), PRAESTOLATUM_HASH, "") ≡ "ok"
    assert fixatura().length() ≡ PRAESTOLATUM_LONGITUDO
}

test "the capsule carries the pinned row identity" {
    do {
        const capsula.Capsule c ← safetensors.admittas(fixatura(), PRAESTOLATUM_HASH, "")
        # schema stamp (capsule-schema-2.0.0).
        assert c.schema() ≡ "2.0.0"
        # pathless content identity: host-verified digest claim + length.
        assert c.algorithm() ≡ "sha-256"
        assert c.digest() ≡ PRAESTOLATUM_HASH
        assert c.length() ≡ PRAESTOLATUM_LONGITUDO
        # per-format manifest.
        assert c.format() ≡ "safetensors"
        assert c.tensor_count() ≡ 5
        assert c.safetensors_manifest() not is null
        # the compact schema-versioned identity record.
        assert c.identity().schema() ≡ "2.0.0"
        assert c.identity().algorithm() ≡ "sha-256"
        assert c.identity().digest() ≡ PRAESTOLATUM_HASH
        assert c.identity().byte_length() ≡ PRAESTOLATUM_LONGITUDO
    }
    catch err {
        assert false
    }
}

test "the manifest carries the pinned row facts" {
    do {
        const capsula.Capsule c ← safetensors.admittas(fixatura(), PRAESTOLATUM_HASH, "")
        const capsula.SafetensorsManifest m ← c.safetensors_manifest() coalesce capsula.SafetensorsManifest {format = "", version = "", artifact_length = 0, data_length = 0, metadata = [], tensors = []}
        # container facts (format/version, artifact/data lengths).
        assert m.format() ≡ "safetensors"
        assert m.version() ≡ "1.0.0"
        assert m.artifact_length() ≡ PRAESTOLATUM_LONGITUDO
        assert m.data_length() ≡ PRAESTOLATUM_DATA_LONGITUDO
        # header metadata carries the pinned arch/tokenizer identity
        # (the schema-1 capsule fields now live in the manifest).
        assert m.metadata_count() ≡ 12
        assert meta_valor(m, "model.arch") ≡ "llama"
        assert meta_valor(m, "model.density") ≡ "dense"
        assert meta_valor(m, "model.layers") ≡ "1"
        assert meta_valor(m, "model.context") ≡ "2048"
        assert meta_valor(m, "tokenizer.model") ≡ "gpt2"
        assert meta_valor(m, "tokenizer.pre") ≡ "smollm"
        assert meta_valor(m, "tokenizer.vocab_digest") ≡ F_VOCAB
        assert meta_valor(m, "tokenizer.eog") ≡ "0,2"
        assert meta_valor(m, "tokenizer.bos_free") ≡ "true"
        assert meta_valor(m, "tokenizer.space_prefix_free") ≡ "true"
        # per-tensor F32 descriptors (structural row; no quantization
        # claims — D4).
        const capsula.SafetensorsTensorDescriptor d0 ← descriptio_facta(m, 0)
        assert d0.name() ≡ "model.embed_tokens.weight"
        assert d0.dtype() ≡ "F32"
        assert d0.shape().length() ≡ 2
        assert d0.shape().get(0) coalesce (-1) ≡ 8
        assert d0.shape().get(1) coalesce (-1) ≡ 4
        assert d0.elements() ≡ 32
        assert d0.start() ≡ 0
        assert d0.end() ≡ 128
        const capsula.SafetensorsTensorDescriptor d1 ← descriptio_facta(m, 1)
        assert d1.name() ≡ "model.norm.weight"
        assert d1.elements() ≡ 8
        assert d1.start() ≡ 128
        assert d1.end() ≡ 160
        const capsula.SafetensorsTensorDescriptor d4 ← descriptio_facta(m, 4)
        assert d4.name() ≡ "model.layers.0.mlp.down_proj.weight"
        assert d4.elements() ≡ 32
        assert m.tensor_count() ≡ 5
    }
    catch err {
        assert false
    }
}

test "the schema-2 identity record round-trips the wire form" {
    do {
        const capsula.Capsule c ← safetensors.admittas(fixatura(), PRAESTOLATUM_HASH, "")
        assert roundtrip(c)
    }
    catch err {
        assert false
    }
}

test "the oracle hash binds the capsule identity" {
    do {
        const capsula.Capsule c ← safetensors.admittas(fixatura(), PRAESTOLATUM_HASH, "")
        assert contra_result(c, PRAESTOLATUM_HASH) ≡ "ok"
        assert contra_result(c, F_ALIA) ≡ "digest mismatch — capsule does not match the expected artifact"
    }
    catch err {
        assert false
    }
}

test "the provenance path is locator metadata, never identity" {
    do {
        const capsula.Capsule a ← safetensors.admittas(fixatura(), PRAESTOLATUM_HASH, "")
        const capsula.Capsule b ← safetensors.admittas(fixatura(), PRAESTOLATUM_HASH, "cache/models/smollm2-scaled.safetensors")
        # schema-2 identity carries no path: the two admissions are the
        # same content identity despite different locator paths.
        assert capsula.identity_equal(a.identity(), b.identity())
        assert a.identity().digest() ≡ b.identity().digest()
        assert a.identity().byte_length() ≡ b.identity().byte_length()
    }
    catch err {
        assert false
    }
}

test "a malformed digest claim fails closed before the row is admitted" {
    assert admittas_result(fixatura(), "zz", "") ≡ "malformed digest value"
}

# -- negative matrix (fail closed, typed errors) -----------------------------

test "rejects a truncated header prefix" {
    assert admittas_result(_truncata(4), PRAESTOLATUM_HASH, "") ≡ "truncated safetensors header prefix"
}

test "rejects a header extending beyond the file" {
    assert admittas_result(_truncata(500), PRAESTOLATUM_HASH, "") ≡ "truncated header — header size beyond file"
}

test "rejects a truncated data region" {
    assert admittas_result(_truncata(1000), PRAESTOLATUM_HASH, "") ≡ "data region truncated — tensor extends beyond file: model.layers.0.self_attn.q_proj.weight"
}

test "rejects a non-JSON header" {
    assert admittas_result(_continer("garbage", _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "unexpected character in header"
}

test "rejects a header that is not a JSON object" {
    assert admittas_result(_continer("[1,2,3]", _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "header is not a JSON object"
}

test "rejects trailing tokens after the top-level object" {
    # A valid row header followed by a stray member (e.g. `},"x":1`)
    # must fail closed: the walk consumes the whole token stream or
    # rejects. Auditor-2 F2 (fire-4).
    assert admittas_result(_continer(PRAESTOLATUM_JSON + «,\"x\":1», _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "trailing tokens after the header object"
}

test "rejects a non-8-byte-aligned header" {
    const list<int<u8>> mis ← _iunge(_caput8(841), _iunge(_textus_bytes(PRAESTOLATUM_JSON), _data_pattern(672)))
    assert admittas_result(mis, PRAESTOLATUM_HASH, "") ≡ "misaligned safetensors header (not 8-byte aligned)"
}

test "rejects an unsupported format name" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"format.name\":\"safetensors\"», «\"format.name\":\"gguf\"»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "unsupported safetensors format: gguf"
}

test "rejects an unsupported row version" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"format.version\":\"1.0.0\"», «\"format.version\":\"2.0.0\"»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "unsupported safetensors row version: 2.0.0"
}

test "rejects an architecture mismatch" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"model.arch\":\"llama\"», «\"model.arch\":\"qwen2\"»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "architecture mismatch"
}

test "rejects a density-class mismatch" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"model.density\":\"dense\"», «\"model.density\":\"sparse\"»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "architecture mismatch"
}

test "rejects a tensor outside the admitted row (tied-embeddings arch rule)" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"model.norm.weight\"», «\"output.weight\"»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "tensor not in admitted row: output.weight"
}

test "rejects a tensor-count mismatch" {
    const string six ← PRAESTOLATUM_JSON.replace(«\"data_offsets\":[544,672]}}», «\"data_offsets\":[544,672]},\"model.layers.0.mlp.up_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,8],\"data_offsets\":[672,928]}}»)
    assert admittas_result(_continer(six, _data_pattern(928)), PRAESTOLATUM_HASH, "") ≡ "tensor count mismatch"
}

test "rejects an unsupported dtype" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"dtype\":\"F32\"», «\"dtype\":\"F16\"»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "unsupported dtype: F16 for model.embed_tokens.weight"
}

test "rejects a duplicate tensor name" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"model.layers.0.mlp.down_proj.weight\"», «\"model.embed_tokens.weight\"»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "duplicate tensor name: model.embed_tokens.weight"
}

test "rejects a misaligned tensor data offset" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"data_offsets\":[0,128]», «\"data_offsets\":[4,132]»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "misaligned tensor data offset: model.embed_tokens.weight"
}

test "rejects overlapping tensor data regions" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"data_offsets\":[128,160]», «\"data_offsets\":[64,96]»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "overlapping tensor data regions"
}

test "rejects a gapped data region (no exact tiling)" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON, _data_pattern(676)), PRAESTOLATUM_HASH, "") ≡ "data region does not tile exactly"
}

test "rejects a shape mismatch" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"shape\":[8,4]», «\"shape\":[8,5]»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "shape mismatch for model.embed_tokens.weight"
}

test "rejects a shape/offset byte-length inconsistency" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"data_offsets\":[0,128]», «\"data_offsets\":[0,132]»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "shape/offset inconsistency for model.embed_tokens.weight"
}

test "rejects a dimension above the ceiling" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"shape\":[8,4]», «\"shape\":[70000,4]»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "dimension above ceiling"
}

test "rejects a total element count above the ceiling" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"shape\":[8,4]», «\"shape\":[65536,20000]»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "element count above ceiling"
}

test "rejects a tensor-name above the length ceiling" {
    const string longe ← PRAESTOLATUM_JSON.replace(«\"model.norm.weight\"», «\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"»)
    assert admittas_result(_continer(longe, _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "tensor name above length ceiling"
}

test "rejects a tokenizer model mismatch" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"tokenizer.model\":\"gpt2\"», «\"tokenizer.model\":\"llama\"»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "tokenizer identity mismatch"
}

test "rejects a tokenizer EOG-set mismatch" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"tokenizer.eog\":\"0,2\"», «\"tokenizer.eog\":\"2,0\"»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "tokenizer identity mismatch"
}

test "rejects a tokenizer BOS-free mismatch" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"tokenizer.bos_free\":\"true\"», «\"tokenizer.bos_free\":\"false\"»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "tokenizer identity mismatch"
}

test "rejects a malformed vocabulary digest" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace((«\"tokenizer.vocab_digest\":\"» + F_VOCAB) + «\"», «\"tokenizer.vocab_digest\":\"zz\"»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "malformed vocabulary digest"
}

test "rejects a non-string metadata value" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"model.layers\":\"1\"», «\"model.layers\":1»), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "metadata value must be a string"
}

test "rejects a missing required metadata key" {
    assert admittas_result(_continer(PRAESTOLATUM_JSON.replace(«\"format.name\":\"safetensors\",», ""), _data_pattern(672)), PRAESTOLATUM_HASH, "") ≡ "missing required metadata key: format.name"
}

test "rejects a header with no __metadata__ — fails at the first required key" {
    # meta_visa is set but never read in safetensors.fab: there is no
    # "missing __metadata__" error. A header without __metadata__ walks
    # to an empty metadata table and fails closed at the first required
    # key (format.name) — the same behavior the conformance suite
    # asserts for this identical header.
    assert admittas_result(_continer(«{\"model.norm.weight\":{\"dtype\":\"F32\",\"shape\":[8],\"data_offsets\":[0,32]}}», _data_pattern(32)), PRAESTOLATUM_HASH, "") ≡ "missing required metadata key: format.name"
}
