+++
locale = "en"
+++
# Focused compile-time proof for the public Safetensors format boundary.
#
# The large fixture below is test evidence only. Its names, metadata, digest,
# and byte ranges are not part of the public parser contract. The tests prove
# that structurally valid containers with different names, dtypes, header
# alignment, and data gaps are accepted, while malformed structure is
# rejected. Model and tokenizer admission belongs to a downstream adapter.

import from "gradus:model/safetensors" safetensors

import from "gradus:model/capsule" capsule

import from "gradus:model/artifact" artifact

import from "gradus:dtype" dtype

# A fixture header reconstructed from a checked-in evidence artifact. Exact
# values here are deliberately confined to this .proba file.
const string FIXTURE_JSON ← «{"__metadata__":{"format.name":"safetensors","format.version":"1.0.0","model.arch":"llama","model.density":"dense","model.layers":"1","model.context":"2048","tokenizer.model":"gpt2","tokenizer.pre":"smollm","tokenizer.vocab_digest":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","tokenizer.eog":"0,2","tokenizer.bos_free":"true","tokenizer.space_prefix_free":"true"},"model.embed_tokens.weight":{"dtype":"F32","shape":[8,4],"data_offsets":[0,128]},"model.norm.weight":{"dtype":"F32","shape":[8],"data_offsets":[128,160]},"model.layers.0.self_attn.q_proj.weight":{"dtype":"F32","shape":[8,8],"data_offsets":[160,416]},"model.layers.0.self_attn.v_proj.weight":{"dtype":"F32","shape":[8,4],"data_offsets":[416,544]},"model.layers.0.mlp.down_proj.weight":{"dtype":"F32","shape":[4,8],"data_offsets":[544,672]}}»

const int FIXTURE_DATA_LENGTH ← 672

const string FIXTURE_DIGEST ← "992426b54e8d7a1b7e24e4167a92a5e630bb79ef7e89efdd5fd2cb2b29d0a0bc"

const string ALT_DIGEST ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# 8-byte little-endian header-size prefix.
fn _header8(int n) → list<int<u8>> {
    var list<int<u8>> out ← empty
    out.append((n ⇒ 0) ↦ int<u8>)
    out.append((n ⇒ 8) ↦ int<u8>)
    out.append((n ⇒ 16) ↦ int<u8>)
    out.append((n ⇒ 24) ↦ int<u8>)
    out.append((n ⇒ 32) ↦ int<u8>)
    out.append((n ⇒ 40) ↦ int<u8>)
    out.append((n ⇒ 48) ↦ int<u8>)
    out.append((n ⇒ 56) ↦ int<u8>)
    return out
}

fn _text_bytes(string s) → list<int<u8>> {
    const bytes o ↤ s
    var list<int<u8>> out ← empty
    for range 0‥o.length() const i {
        out.append(o.get(i) coalesce 0 ∷ int<u8>)
    }
    return out
}

fn _join(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← empty
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

fn _data_pattern(int n) → list<int<u8>> {
    var list<int<u8>> out ← empty
    for range 0‥n const i {
        out.append((i * 13 + 7) % 256 ↦ int<u8>)
    }
    return out
}

# Fixture helper. Padding is valid JSON whitespace included in N; the parser
# also accepts the ordinary non-aligned framing built by _contain_raw below.
fn _contain(string header_json, list<int<u8>> data) → list<int<u8>> {
    const list<int<u8>> hb ← _text_bytes(header_json)
    const int n ← hb.length()
    const int aligned ← ((n + 7) / 8) * 8
    var list<int<u8>> padded ← empty
    for from hb const x {
        padded.append(x)
    }
    for range n‥aligned const i {
        padded.append(32 ↦ int<u8>)
    }
    return _join(_join(_header8(aligned), padded), data)
}

# Standard framing with the exact JSON byte length. N need not be aligned.
fn _contain_raw(string header_json, list<int<u8>> data) → list<int<u8>> {
    const list<int<u8>> hb ← _text_bytes(header_json)
    return _join(_join(_header8(hb.length()), hb), data)
}

fn fixture() → list<int<u8>> {
    return _contain(FIXTURE_JSON, _data_pattern(FIXTURE_DATA_LENGTH))
}

fn _admitted(list<int<u8>> corpus, string digest) → bool {
    do {
        const capsule.Capsule _ ← safetensors.admit(corpus, digest)
        return true
    }
    catch err {
        return false
    }
}

fn _error(list<int<u8>> corpus, string digest) → string {
    do {
        const capsule.Capsule _ ← safetensors.admit(corpus, digest)
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn _truncated(int n) → list<int<u8>> {
    return fixture().take(n)
}

fn _descriptor(capsule.SafetensorsManifest m) → capsule.SafetensorsTensorDescriptor {
    do {
        return m.description(0)
    }
    catch err {
        return capsule.SafetensorsTensorDescriptor {name = "", dtype = "", shape = [], start = -1, end = -1, elements = -1}
    }
}

fn _roundtrip(capsule.Capsule c) → bool {
    do {
        const string wire ← capsule.serialize_identity(c)
        const capsule.Identity i ← capsule.deserialize_identity(wire)
        return capsule.identity_equal(c.identity(), i)
    }
    catch err {
        return false
    }
}

test "the evidence fixture admits as a generic Safetensors container" {
    const list<int<u8>> corpus ← fixture()
    do {
        const capsule.Capsule c ← safetensors.admit(corpus, FIXTURE_DIGEST)
        assert c.format() ≡ "safetensors"
        assert c.tensor_count() ≡ 5
        assert c.length() ≡ corpus.length()
        assert c.digest() ≡ FIXTURE_DIGEST
        assert c.algorithm() ≡ "sha-256"
        assert c.safetensors_manifest() not is null
    }
    catch err {
        assert false
    }
}

test "metadata and descriptor facts are preserved without model admission" {
    do {
        const capsule.Capsule c ← safetensors.admit(fixture(), FIXTURE_DIGEST)
        const capsule.SafetensorsManifest m ← c.safetensors_manifest() coalesce capsule.SafetensorsManifest {format = "", version = "", artifact_length = 0, data_length = 0, metadata = [], tensors = []}
        assert m.format ≡ "safetensors"
        assert m.version ≡ "1.0.0"
        assert m.metadata_count() ≻ 0
        const capsule.SafetensorsTensorDescriptor d ← _descriptor(m)
        assert d.name ≡ "model.embed_tokens.weight"
        assert d.dtype ≡ "F32"
        assert d.elements ≡ 32
        assert d.start ≡ 0
        assert d.end ≡ 128
    }
    catch err {
        assert false
    }
}

test "a structurally valid alternate tensor is admitted" {
    const string header ← «{"renamed.weight":{"dtype":"F16","shape":[2,2],"data_offsets":[0,8]}}»
    assert _admitted(_contain_raw(header, _data_pattern(8)), ALT_DIGEST)
}

test "an ordinary non-aligned header length is admitted" {
    const string header ← «{"weight":{"dtype":"F32","shape":[1],"data_offsets":[0,4]}}»
    const list<int<u8>> corpus ← _contain_raw(header, _data_pattern(4))
    assert _admitted(corpus, ALT_DIGEST)
}

test "unused bytes between tensor regions are admitted" {
    const string header ← «{"a":{"dtype":"F32","shape":[1],"data_offsets":[2,6]}}»
    assert _admitted(_contain_raw(header, _data_pattern(6)), ALT_DIGEST)
}

test "the capsule identity round-trips independently of fixture paths" {
    do {
        const capsule.Capsule c ← safetensors.admit(fixture(), FIXTURE_DIGEST)
        assert _roundtrip(c)
        const artifact.ContentIdentity id ← c.identity
        assert id.digest ≡ FIXTURE_DIGEST
        assert id.length ≡ fixture().length()
    }
    catch err {
        assert false
    }
}

test "a malformed digest claim fails closed" {
    assert _error(fixture(), "zz") ≡ "malformed digest value"
}

test "a truncated prefix fails closed" {
    assert _admitted(_truncated(4), FIXTURE_DIGEST) ≡ false
}

test "a truncated header or data region fails closed" {
    assert _admitted(_truncated(500), FIXTURE_DIGEST) ≡ false
    assert _admitted(_truncated(1000), FIXTURE_DIGEST) ≡ false
}

test "a non-JSON header fails closed" {
    assert _admitted(_contain_raw("garbage", _data_pattern(1)), ALT_DIGEST) ≡ false
}

test "a non-object header fails closed" {
    assert _admitted(_contain_raw("[1,2,3]", _data_pattern(1)), ALT_DIGEST) ≡ false
}

test "a future dtype is preserved when its range is bounded" {
    const string header ← «{"future.weight":{"dtype":"F99_E99","shape":[1],"data_offsets":[0,4]}}»
    do {
        const capsule.Capsule c ← safetensors.admit(_contain_raw(header, _data_pattern(4)), ALT_DIGEST)
        const capsule.SafetensorsManifest m ← c.safetensors_manifest() coalesce capsule.SafetensorsManifest {format = "", version = "", artifact_length = 0, data_length = 0, metadata = [], tensors = []}
        const capsule.SafetensorsTensorDescriptor d ← _descriptor(m)
        assert d.name ≡ "future.weight"
        assert d.dtype ≡ "F99_E99"
        assert d.elements ≡ 1
        assert d.start ≡ 0
        assert d.end ≡ 4
    }
    catch err {
        assert false
    }
}

test "shape and byte offsets must agree" {
    const string header ← «{"weight":{"dtype":"F32","shape":[2],"data_offsets":[0,4]}}»
    assert _admitted(_contain_raw(header, _data_pattern(4)), ALT_DIGEST) ≡ false
}

test "shape products above one billion are not capped by a model policy" {
    const string header ← «{"weight":{"dtype":"F32","shape":[1000001,1000],"data_offsets":[0,4]}}»
    assert _error(_contain_raw(header, _data_pattern(4)), ALT_DIGEST) ≡ "shape/offset inconsistency for weight"
}

test "shape products reject only integer overflow" {
    const string header ← «{"weight":{"dtype":"F32","shape":[999999999999999999,10],"data_offsets":[0,4]}}»
    assert _error(_contain_raw(header, _data_pattern(4)), ALT_DIGEST) ≡ "checked integer multiplication overflow"
}

test "duplicate names fail closed" {
    const string header ← «{"weight":{"dtype":"F32","shape":[1],"data_offsets":[0,4]},"weight":{"dtype":"F32","shape":[1],"data_offsets":[4,8]}}»
    assert _admitted(_contain_raw(header, _data_pattern(8)), ALT_DIGEST) ≡ false
}

test "overlapping tensor regions fail closed" {
    const string header ← «{"a":{"dtype":"F32","shape":[1],"data_offsets":[0,4]},"b":{"dtype":"F32","shape":[1],"data_offsets":[2,6]}}»
    assert _admitted(_contain_raw(header, _data_pattern(6)), ALT_DIGEST) ≡ false
}

test "metadata values must remain strings" {
    const string header ← «{"__metadata__":{"format":"safetensors","count":1},"weight":{"dtype":"F32","shape":[1],"data_offsets":[0,4]}}»
    assert _admitted(_contain_raw(header, _data_pattern(4)), ALT_DIGEST) ≡ false
}

fn selected_payload() → bytes {
    const bytes payload ← _data_pattern(8)
    return payload
}

test "selected admission accepts caller-supplied generic tensor facts" {
    do {
        const safetensors.SelectedTensor v ← safetensors.admit_selected(
            "renamed.weight",
            "BF16",
            [2,2],
            selected_payload(),
            ALT_DIGEST,
            24,
            16,
            0,
            8
        )
        assert v.name ≡ "renamed.weight"
        assert dtype.name(v.dtype_tag) ≡ "bf16"
        assert v.shape.get(0) coalesce (-1) ≡ 2
        assert v.shape.get(1) coalesce (-1) ≡ 2
        assert v.absolute_start ≡ 16
        assert v.byte_length() ≡ 8
    }
    catch err {
        assert false
    }
}

test "selected admission rejects inconsistent caller facts" {
    do {
        const safetensors.SelectedTensor _ ← safetensors.admit_selected(
            "renamed.weight",
            "BF16",
            [2,2],
            selected_payload(),
            ALT_DIGEST,
            24,
            16,
            0,
            4
        )
        assert false
    }
    catch err {
        assert true
    }
}

test "selected admission rejects a future dtype at materialization" {
    do {
        const safetensors.SelectedTensor _ ← safetensors.admit_selected(
            "future.weight",
            "F99_E99",
            [1],
            selected_payload(),
            ALT_DIGEST,
            24,
            16,
            0,
            8
        )
        assert false
    }
    catch err {
        assert true
    }
}
