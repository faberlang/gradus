fn show_text(string text) → string {
    return text.replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t").replace("\u{8}", "\\b").replace("\u{c}", "\\f").replace("\u{1}", "\\x01")
}

fn show_option_int(string name, int ∪ none value) → string {
    return value is none ✓ "" ✗ "|§=§"(name, value coalesce 0)
}

fn show_option_float(string name, f32 ∪ none value) → string {
    return value is none ✓ "" ✗ "|§=§"(name, value coalesce 0.0 ∷ f32)
}

fn show(GenerateRequest req) → string {
    return «ok|prompt=§§§§§§§§§»(show_text(req.prompt), show_option_int("max_tokens", req.max_tokens), show_option_int("max_prompt", req.max_prompt), show_option_float("temperature", req.temperature), show_option_int("top_k", req.top_k), show_option_float("top_p", req.top_p), show_option_float("min_p", req.min_p), show_option_float("repeat_penalty", req.repeat_penalty), show_option_int("seed", req.seed))
}

# How a body parses: `ok|...` with the fields it carried, or `err|<cause>`.
fn outcome(string body) → string {
    do {
        return show(parse_generate_body(body))
    }
    catch err {
        return "err|§"(err)
    }
}

describe "request wire corpus" tag "inferentia" {
    test "every body parses to its recorded outcome" {
        mut list<string> mismatches ← empty
        for from WIRE_LABELS, WIRE_BODIES, WIRE_OUTCOMES let label, body, expected {
            if outcome(body) ≢ expected {
                mismatches.append(label)
            }
        }
        assert mismatches.length() ≡ 0
    }
    test "the corpus rows line up" {
        assert WIRE_LABELS.length() ≡ 124
        assert WIRE_BODIES.length() ≡ 124
        assert WIRE_OUTCOMES.length() ≡ 124
    }
}
