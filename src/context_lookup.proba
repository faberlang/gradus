+++
locale = "en"
+++
# Co-located package tests for the SD4-U1 context-lookup search contract.
# These rows prove only the typed bounds and fallback semantics. Matching and
# candidate construction belong to SD4-U2; this file contains no search loop.

import from "gradus:context_lookup" context_lookup
import from "gradus:speculative" speculative

import from "gradus:test_util" test_util

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.
fn bounds_detail(int max_block, int tokens_available) → string {
    do {
        const context_lookup.LookupBounds _ ← context_lookup.construct_bounds(max_block, tokens_available)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# BLOCKER (F2, funnel 7ec5e484): consume helper returns the success value,
# so the trap form needs outcome narrowing — hard-blocked ("projection
# base", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not convert.
fn suffix_detail(context_lookup.LookupBounds bounds) → list<int> {
    do {
        return context_lookup.suffix_lengths(bounds)
    }
    catch err {
        return empty
    }
}

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base", MIR repair 2d5b7789 not
# landed). Kept on do/catch. Do not convert.
fn following_detail(context_lookup.LookupBounds bounds, int source_offset, int match_length) → string {
    do {
        const int _ ← context_lookup.following_source_index(bounds, source_offset, match_length)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base", MIR repair 2d5b7789 not
# landed). Kept on do/catch. Do not convert.
fn extension_detail(context_lookup.LookupBounds bounds, int source_offset, int match_length) → string {
    do {
        const int extension ← context_lookup.extension_length(bounds, source_offset, match_length)
        return extension ↦ string
    }
    catch err {
        return err.message
    }
}

describe "SD4-U1 — context-lookup search contract" {
    test "window maximum honors policy maximum and available-context cap" {
        const _ trap_result_13 ← trap {
            const context_lookup.LookupBounds policy_cap ← context_lookup.construct_bounds(8, 12)
            const context_lookup.LookupBounds context_cap ← context_lookup.construct_bounds(8, 5)
            const context_lookup.LookupBounds narrow_policy ← context_lookup.construct_bounds(3, 20)
            assert policy_cap.window_maximum() ≡ 8
            assert context_cap.window_maximum() ≡ 4
            assert narrow_policy.window_maximum() ≡ 3
        }
        assert trap_result_13 is void
    }

    test "suffix lengths enumerate downward to one" {
        const _ trap_result_12 ← trap {
            const context_lookup.LookupBounds bounds ← context_lookup.construct_bounds(5, 20)
            assert context_lookup.minimum_suffix_length() ≡ 1
            assert suffix_detail(bounds) ≡ ([5, 4, 3, 2, 1] ↦ list<int>)
        }
        assert trap_result_12 is void
    }

    test "a match at the context tail is rejected without a following token" {
        const _ trap_result_11 ← trap {
            const context_lookup.LookupBounds bounds ← context_lookup.construct_bounds(8, 5)
            assert following_detail(bounds, 4, 1) ≡ "match must have a following source token"
            assert following_detail(bounds, 3, 2) ≡ "match must have a following source token"
            assert following_detail(bounds, 0, 1) ≡ "ok"
        }
        assert trap_result_11 is void
    }

    test "candidate extension clamps at policy maximum and context end" {
        const _ trap_result_10 ← trap {
            const context_lookup.LookupBounds policy_cap ← context_lookup.construct_bounds(3, 10)
            const context_lookup.LookupBounds context_cap ← context_lookup.construct_bounds(9, 6)
            assert extension_detail(policy_cap, 1, 2) ≡ "3"
            assert extension_detail(context_cap, 1, 1) ≡ "4"
        }
        assert trap_result_10 is void
    }

    test "empty context and undersized lookup bounds reject through the seam vocabulary" {
        assert bounds_detail(8, 0) ≡ "context lookup requires at least two context tokens"
        assert bounds_detail(8, 1) ≡ "context lookup requires at least two context tokens"
        assert bounds_detail(0, 8) ≡ "lookup maximum block size must be at least one"
    }

    test "malformed bound state and malformed matches reject instead of downgrading" {
        assert following_detail(context_lookup.default(), 0, 1) ≡ "lookup maximum block size must be at least one"
        const _ trap_result_9 ← trap {
            const context_lookup.LookupBounds bounds ← context_lookup.construct_bounds(4, 8)
            assert following_detail(bounds, -1, 1) ≡ "match source offset must be non-negative"
            assert following_detail(bounds, 0, 0) ≡ "match length must be at least one"
        }
        assert trap_result_9 is void
    }

    test "empty lookup is the ordinary typed no-draft fallback" {
        const speculative.ProviderResult result ← context_lookup.empty_proposal()
        assert speculative.is_no_draft(result)
        assert context_lookup.fallback_kind() ≡ "no_draft"
        assert speculative.candidate_ids(result).length() ≡ 0
    }
}

# BLOCKER (Z1, funnel 7ec5e484): or_default rewrite would add SEM010 sites
# (check-signature change); the trap form needs narrowing (hard-blocked,
# MIR repair 2d5b7789 not landed). Kept on do/catch. Do not convert.
fn request_p(list<int> prompt, list<int> history, int block_size) → speculative.ProviderRequest {
    return test_util.or_default(() → speculative.ProviderRequest ⇥ speculative.SpeculativeError ∴ speculative.construct_request(prompt, history, block_size, 1, block_size), speculative.default())
}

describe "SD4-U2 — deterministic context-only provider" {
    test "repeated identical requests return identical candidates and metadata" {
        const speculative.ProviderRequest request ← request_p([1, 2, 3, 1, 2, 3], empty, 3)
        const _ trap_result_8 ← trap {
            const speculative.ProviderResult first ← context_lookup.propose(request)
            const speculative.ProviderResult second ← context_lookup.propose(request)
            assert speculative.result_equal(first, second)
            assert speculative.candidate_ids(first) ≡ ([1, 2, 3] ↦ list<int>)
            const speculative.CandidateProvenance metadata ← speculative.candidate_provenance(first)
            assert metadata.source() ≡ "context_lookup"
            assert metadata.source_offset() ≡ 0
            assert metadata.match_length() ≡ 3
        }
        assert trap_result_8 is void
    }

    test "longest matching suffix wins before any shorter match" {
        const speculative.ProviderRequest request ← request_p([1, 2, 3, 1, 2, 3], empty, 3)
        const _ trap_result_7 ← trap {
            const speculative.ProviderResult result ← context_lookup.propose(request)
            const speculative.CandidateProvenance metadata ← speculative.candidate_provenance(result)
            assert metadata.match_length() ≡ 3
            assert metadata.source_offset() ≡ 0
            assert speculative.candidate_ids(result) ≡ ([1, 2, 3] ↦ list<int>)
        }
        assert trap_result_7 is void
    }

    test "equal-length matches choose the lowest source offset" {
        const speculative.ProviderRequest request ← request_p([5, 6, 5, 6, 5, 6], empty, 2)
        const _ trap_result_6 ← trap {
            const speculative.ProviderResult result ← context_lookup.propose(request)
            const speculative.CandidateProvenance metadata ← speculative.candidate_provenance(result)
            assert metadata.match_length() ≡ 2
            assert metadata.source_offset() ≡ 0
            assert speculative.candidate_ids(result) ≡ ([5, 6] ↦ list<int>)
        }
        assert trap_result_6 is void
    }

    test "window and candidate limits clamp the lookup result" {
        const speculative.ProviderRequest request ← request_p([9, 8, 7, 9, 8, 7], empty, 2)
        const _ trap_result_5 ← trap {
            const speculative.ProviderResult result ← context_lookup.propose(request)
            const speculative.CandidateProvenance metadata ← speculative.candidate_provenance(result)
            assert metadata.match_length() ≡ 2
            assert metadata.source_offset() ≡ 1
            assert speculative.candidate_ids(result) ≡ ([9, 8] ↦ list<int>)
            assert speculative.candidate_ids(result).length() ≤ request.block_size()
        }
        assert trap_result_5 is void
    }

    test "prompt plus accepted history is the only searchable context" {
        const speculative.ProviderRequest request ← request_p([4, 5], [4, 5], 2)
        const _ trap_result_4 ← trap {
            const speculative.ProviderResult result ← context_lookup.propose(request)
            const speculative.CandidateProvenance metadata ← speculative.candidate_provenance(result)
            assert metadata.source_offset() ≡ 0
            assert metadata.match_length() ≡ 2
            assert speculative.candidate_ids(result) ≡ ([4, 5] ↦ list<int>)
        }
        assert trap_result_4 is void
    }

    test "an absent occurrence returns the ordinary no-draft result" {
        const speculative.ProviderRequest request ← request_p([10, 11, 12], empty, 2)
        const _ trap_result_3 ← trap {
            const speculative.ProviderResult result ← context_lookup.propose(request)
            assert speculative.is_no_draft(result)
            assert speculative.candidate_ids(result).length() ≡ 0
        }
        assert trap_result_3 is void
    }

    test "short contexts return no-draft and malformed token state rejects" {
        const speculative.ProviderRequest empty_request ← request_p(empty, empty, 2)
        const _ trap_result_2 ← trap {
            assert speculative.is_no_draft(context_lookup.propose(empty_request))
        }
        assert trap_result_2 is void
        # BLOCKER (F1, funnel 7ec5e484): assert-on-error row needs
        # `err.message` after catch — narrowing family, hard-blocked
        # ("projection base", MIR repair 2d5b7789 not landed). Kept on
        # do/catch. Do not convert.
        do {
            const speculative.ProviderResult _ ← context_lookup.propose(speculative.default())
            assert false
        }
        catch err {
            assert err.message ≡ "provider block size must be at least one"
        }
    }

    test "propose leaves the request unchanged and imports no sampler or train surface" {
        const speculative.ProviderRequest request ← request_p([7, 8, 7, 8], [9], 2)
        const speculative.ProviderRequest before ← request
        do {
            const speculative.ProviderResult _ ← context_lookup.propose(request)
            assert speculative.request_equal(request, before)
            assert request.prompt() ≡ before.prompt()
            assert request.history() ≡ before.history()
            assert request.block_size() ≡ before.block_size()
        }
        catch err {
            assert false
        }
    }
}

describe "SD4-U4 — no-match fallback carries no acceleration provenance" {
    test "a no-draft fallback exposes no candidate provenance to claim" {
        const speculative.ProviderRequest request ← request_p([10, 11, 12], empty, 2)
        # BLOCKER (F1, funnel 7ec5e484): assert-on-error row needs
        # `err.message` after catch — narrowing family, hard-blocked
        # ("projection base", MIR repair 2d5b7789 not landed). Kept on
        # do/catch. Do not convert.
        const _ trap_result_1 ← trap {
            const speculative.ProviderResult result ← context_lookup.propose(request)
            assert speculative.is_no_draft(result)
            do {
                const speculative.CandidateProvenance _ ← speculative.candidate_provenance(result)
                assert false
            }
            catch err {
                assert err.message ≡ "no-draft result has no provenance"
            }
        }
        assert trap_result_1 is void
    }
}
