+++
locale = "en"
+++
# GEA1-R1 / GEA2-U3 — independently inspectable device entries.
#
# Public import: import from "gradus:kernel" kernel
# Depends on: gradus:dtype (DType tag and name predicate)
#
# GEA2 block geometry is frozen at T=8, D=960, H=15, K=5, d=64, and F=2560.
# The thirteen new entries below are all F32 and position-independent.  Their
# signatures are the device contract; host admission stays in ordinary
# functions and the nine tensor views remain path/container-free.
#
# Entry inventory (input shapes → output shape):
#   rmsnorm       [8,960] · [960]                 → [8,960]
#   gemm_qo       [8,960] · [960,960]             → [8,960]
#   gemm_kv       [8,960] · [960,320]             → [8,320]
#   gemm_gate_up  [8,960] · [960,2560]            → [8,2560]
#   gemm_down     [8,2560] · [2560,960]           → [8,960]
#   rope_q        [8,960] · table [8,32,3]        → [8,960]
#   rope_k        [8,320] · table [8,32,3]        → [8,320]
#   transpose     [8,64]                          → [64,8]
#   score_gemm    [8,64] · [64,8] · scale [8,8]   → [8,8]
#   causal_softmax [8,8]                          → [8,8]
#   context_gemm  [8,8] · [8,64]                  → [8,64]
#   swiglu       [8,2560] · [8,2560]              → [8,2560]
#   residual_add [8,960] · [8,960]                → [8,960]
#
# Glyph law: · is rank-2 matmul and ⊙ is same-shape elementwise product.
# RMSNorm, RoPE, softmax, SiLU, transpose, and add use their method twins,
# which resolve to the pinned collection operations without host calls.
#
# The host admission layer receives typed resident views and validates their
# dtype, shape, byte range, and activation length before the device boundary.
# The @ kernel entries receive only shaped resident tensors and an output
# view. They know no Safetensors/GGUF format, path, container, Hub identity,
# or physical device.

import from "gradus:dtype" dtype

const int GEMV_N ← 320

const int GEMV_K ← 960

const int GEMV_ELEMENTS ← GEMV_N * GEMV_K

@ public
union KernelError {
    @ shared
    string message

    BadView,
    BadInput,
    BadValue
}

# Physical BF16 resident view. The payload is exactly one declared byte
# range; it is not a file, path, or container.
@ public
class Bf16View {
    dtype.DType dtype_tag
    list<int> shape
    int absolute_start
    int absolute_end
    int byte_length
    bytes payload

    fn dtype() → dtype.DType {
        return self.dtype_tag
    }

    fn shape() → list<int> {
        return self.shape
    }

    fn absolute_start() → int {
        return self.absolute_start
    }

    fn absolute_end() → int {
        return self.absolute_end
    }

    fn byte_length() → int {
        return self.byte_length
    }

    fn payload() → bytes {
        return self.payload
    }
}

# Physical F32 resident view. It carries the same logical matrix shape while
# retaining its own declared F32 byte range.
@ public
class F32View {
    dtype.DType dtype_tag
    list<int> shape
    int absolute_start
    int absolute_end
    int byte_length
    bytes payload

    fn dtype() → dtype.DType {
        return self.dtype_tag
    }

    fn shape() → list<int> {
        return self.shape
    }

    fn absolute_start() → int {
        return self.absolute_start
    }

    fn absolute_end() → int {
        return self.absolute_end
    }

    fn byte_length() → int {
        return self.byte_length
    }

    fn payload() → bytes {
        return self.payload
    }
}

fn _gemv_shape(list<int> shape) → bool {
    if shape.length() ≠ 2 then return false
    if shape.get(0) coalesce (-1) ≠ GEMV_N then return false
    if shape.get(1) coalesce (-1) ≠ GEMV_K then return false
    return true
}

fn _range_ok(int absolute_start, int absolute_end, bytes payload, int expected_bytes) → bool {
    if absolute_start ≺ 0 then return false
    if absolute_end ≤ absolute_start then return false
    if absolute_end - absolute_start ≠ expected_bytes then return false
    if payload.length() ≠ expected_bytes then return false
    return true
}

# Construct the typed BF16 view after a bounded source-range read.
@ public
fn bf16_view(bytes payload, int absolute_start, int absolute_end, list<int> shape) → Bf16View ⇥ KernelError {
    require _gemv_shape(shape) throw variant BadView { message = "BF16 view must have logical shape [320,960]" }
    require _range_ok(absolute_start, absolute_end, payload, GEMV_ELEMENTS * dtype.width(dtype.bf16())) throw variant BadView { message = "BF16 view range does not match [320,960] storage" }
    return Bf16View { dtype_tag = dtype.bf16(), shape = shape, absolute_start = absolute_start, absolute_end = absolute_end, byte_length = payload.length(), payload = payload }
}

# Construct the typed F32 view after its own bounded resident-range read.
@ public
fn f32_view(bytes payload, int absolute_start, int absolute_end, list<int> shape) → F32View ⇥ KernelError {
    require _gemv_shape(shape) throw variant BadView { message = "F32 view must have logical shape [320,960]" }
    require _range_ok(absolute_start, absolute_end, payload, GEMV_ELEMENTS * dtype.width(dtype.f32())) throw variant BadView { message = "F32 view range does not match [320,960] storage" }
    return F32View { dtype_tag = dtype.f32(), shape = shape, absolute_start = absolute_start, absolute_end = absolute_end, byte_length = payload.length(), payload = payload }
}

# Host admission checks. These are called before a Bf16View/F32View crosses
# into the corresponding @ kernel entry; no host validation remains in a
# device body.
@ public
fn validate_bf16_view(Bf16View weights, list<f32> input) → void ⇥ KernelError {
    require dtype.eq(weights.dtype(), dtype.bf16()) throw variant BadView { message = "BF16 GEMV received a non-BF16 view" }
    require _gemv_shape(weights.shape()) throw variant BadView { message = "BF16 GEMV received the wrong logical shape" }
    require _range_ok(weights.absolute_start(), weights.absolute_end(), weights.payload(), GEMV_ELEMENTS * dtype.width(dtype.bf16())) throw variant BadView { message = "BF16 GEMV received an invalid resident range" }
    require input.length() ≡ GEMV_K throw variant BadInput { message = "GEMV input must have length 960" }
}

@ public
fn validate_f32_view(F32View weights, list<f32> input) → void ⇥ KernelError {
    require dtype.eq(weights.dtype(), dtype.f32()) throw variant BadView { message = "F32 GEMV received a non-F32 view" }
    require _gemv_shape(weights.shape()) throw variant BadView { message = "F32 GEMV received the wrong logical shape" }
    require _range_ok(weights.absolute_start(), weights.absolute_end(), weights.payload(), GEMV_ELEMENTS * dtype.width(dtype.f32())) throw variant BadView { message = "F32 GEMV received an invalid resident range" }
    require input.length() ≡ GEMV_K throw variant BadInput { message = "GEMV input must have length 960" }
}

# GEA1 body 1: BF16 weights widen in the dense tiled-matmul load seam;
# accumulation and output remain F32. This declaration is intentionally
# independent from the F32 body below.
@ kernel
@ public
fn gemv_bf16_f32acc(tensor<bf16, [320, 960]> weights, tensor<f32, [960]> input, mut tensor<f32, [320]> output) → void {
    output ← weights · input
}

# GEA1 body 2: independent F32 weights, F32 accumulation, and F32 output.
# This remains a complete second body, not a type parameter, macro, dispatch
# alias, or call through the BF16 implementation.
@ kernel
@ public
fn gemv_f32_f32acc(tensor<f32, [320, 960]> weights, tensor<f32, [960]> input, mut tensor<f32, [320]> output) → void {
    output ← weights · input
}

# GEA2-U3 body 1 — RMSNorm over the last axis with the frozen epsilon.
@ kernel
@ public
fn rmsnorm(tensor<f32, [8, 960]> input, tensor<f32, [960]> weight, mut tensor<f32, [8, 960]> output) → void {
    output ← input.rms_norm(1, 0.00001, weight)
}

# GEA2-U3 bodies 2–5 — the four projection GEMM shapes.  q/o share one
# [960,960] entry, k/v share [960,320], and gate/up share [960,2560].
@ kernel
@ public
fn gemm_qo(tensor<f32, [8, 960]> input, tensor<f32, [960, 960]> weights, mut tensor<f32, [8, 960]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn gemm_kv(tensor<f32, [8, 960]> input, tensor<f32, [960, 320]> weights, mut tensor<f32, [8, 320]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn gemm_gate_up(tensor<f32, [8, 960]> input, tensor<f32, [960, 2560]> weights, mut tensor<f32, [8, 2560]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn gemm_down(tensor<f32, [8, 2560]> input, tensor<f32, [2560, 960]> weights, mut tensor<f32, [8, 960]> output) → void {
    output ← input · weights
}

# GEA2-U3 bodies 6–7 — packed RoPE with the committed [T,32,3]
# angle/cos/sin table input.  RopePlan consumes the table at lowering time;
# the source intrinsic keeps the frozen consecutive-pair dim=64 contract.
@ kernel
@ public
fn rope_q(tensor<f32, [8, 960]> input, tensor<f32, [8, 32, 3]> rope_table, mut tensor<f32, [8, 960]> output) → void {
    output ← input.rope_norm(0, 64)
}

@ kernel
@ public
fn rope_k(tensor<f32, [8, 320]> input, tensor<f32, [8, 32, 3]> rope_table, mut tensor<f32, [8, 320]> output) → void {
    output ← input.rope_norm(0, 64)
}

# GEA2-U3 body 8 — explicit head transpose for q_h · k_g^T.
@ kernel
@ public
fn transpose(tensor<f32, [8, 64]> input, mut tensor<f32, [64, 8]> output) → void {
    output ← input.transpose()
}

# GEA2-U3 body 9 — score GEMM followed by the frozen 0.125 scale.  The
# scale view is a [T,T] resident constant filled with 1/sqrt(64)=0.125;
# using a shaped peer keeps the elementwise operation broadcast-free.
@ kernel
@ public
fn score_gemm(tensor<f32, [8, 64]> query, tensor<f32, [64, 8]> key_transposed, tensor<f32, [8, 8]> attention_scale, mut tensor<f32, [8, 8]> output) → void {
    output ← (query · key_transposed) ⊙ attention_scale
}

# GEA2-U3 body 10 — stable row softmax.  The explicit max-from reduction
# records the caller-stated identity; the softmax collection method owns the
# row-wise max-subtract/exp/sum recipe and causal masking at lowering.
@ kernel
@ public
fn causal_softmax(tensor<f32, [8, 8]> scores, mut tensor<f32, [8, 8]> output) → void {
    const f32 _stability_max ← max from scores at [i, j] coalesce 0.0
    output ← scores.softmax()
}

# GEA2-U3 body 11 — per-head context GEMM.
@ kernel
@ public
fn context_gemm(tensor<f32, [8, 8]> probabilities, tensor<f32, [8, 64]> values, mut tensor<f32, [8, 64]> output) → void {
    output ← probabilities · values
}

# GEA2-U3 body 12 — SwiGLU: silu(gate) ⊙ up.  `silu` is the scalar-preserving
# tensor method spelling admitted by the device surface; no host helper call.
@ kernel
@ public
fn swiglu(tensor<f32, [8, 2560]> gate, tensor<f32, [8, 2560]> up, mut tensor<f32, [8, 2560]> output) → void {
    const tensor<f32, [8, 2560]> activated ← gate.silu()
    output ← activated ⊙ up
}

# GEA2-U3 body 13 — residual stream addition.
@ kernel
@ public
fn residual_add(tensor<f32, [8, 960]> left, tensor<f32, [8, 960]> right, mut tensor<f32, [8, 960]> output) → void {
    output ← left + right
}

# GEA3-U3a — decode-step device entries at T=1. Geometry frozen at GEA1/GEA2
# (D=960, H=15, K=5, d=64, F=2560) with the GEA3-U1 decode freezes: T=1,
# L_max=76, declared history length, mask beyond L. Every entry is F32 and
# independently selectable; the route instantiates per-head windows and the
# 32x layer repetition at plan time (GEA2-U7 inheritance), so these bodies
# carry no loop, slice, failable construct, or in-body call.
#
# Geometry amended from the original L_max=32 (U3a-amend cc3981c8): U1 froze
# l_max=76 and the prefill writes positions 0..35, so the decode family must
# cover positions 36..75 — 40 decode steps — in the same fixed-capacity
# buffers. The [x,32,3] rope tables are unaffected: their 32 is d/2
# consecutive pairs (dim=64), not history capacity.
#
# Entry inventory (input shapes → output shape):
#   decode_rmsnorm        [1,960] · [960]              → [1,960]
#   decode_gemv_qo        [1,960] · [960,960]          → [1,960]
#   decode_gemv_kv        [1,960] · [960,320]          → [1,320]
#   decode_gemv_gate_up   [1,960] · [960,2560]         → [1,2560]
#   decode_gemv_down      [1,2560] · [2560,960]        → [1,960]
#   decode_rope_q         [1,960] · table [1,32,3]     → [1,960]
#   decode_rope_k         [1,320] · table [1,32,3]     → [1,320]
#   kv_append_k           row view [320] · row [320] → row view [320]
#   kv_append_v           row view [320] · row [320] → row view [320]
#   decode_key_transpose  [76,64]                      → [64,76]
#   decode_score_gemm     [1,64] · [64,76] · scale [1,76] → [1,76]
#   decode_masked_softmax [1,76] · mask [1,76]         → [1,76]
#   decode_context_gemm   [1,76] · [76,64]             → [1,64]
#   decode_swiglu         [1,2560] · [1,2560]          → [1,2560]
#   decode_residual_add   [1,960] · [1,960]            → [1,960]
#
# KV geometry (CTO ruling 0891c09b): fixed-capacity buffers at L_max=76,
# append-in-place, declared history length, mask beyond L. The append entries
# consume a single position-projected [320] row view of the resident arena;
# the host's typed Position binding moves that view to the declared slot and
# `history + row` writes only that row. No capacity-sized selector is staged.
# The additive mask is the resident declared-length constant (0 within L,
# negative beyond) feeding softmax.

# GEA3-U3a body 1 — decode RMSNorm over the single row.
@ kernel
@ public
fn decode_rmsnorm(tensor<f32, [1, 960]> input, tensor<f32, [960]> weight, mut tensor<f32, [1, 960]> output) → void {
    output ← input.rms_norm(1, 0.00001, weight)
}

# GEA3-U3a bodies 2–5 — the projection GEMV shapes at query-1.
@ kernel
@ public
fn decode_gemv_qo(tensor<f32, [1, 960]> input, tensor<f32, [960, 960]> weights, mut tensor<f32, [1, 960]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn decode_gemv_kv(tensor<f32, [1, 960]> input, tensor<f32, [960, 320]> weights, mut tensor<f32, [1, 320]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn decode_gemv_gate_up(tensor<f32, [1, 960]> input, tensor<f32, [960, 2560]> weights, mut tensor<f32, [1, 2560]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn decode_gemv_down(tensor<f32, [1, 2560]> input, tensor<f32, [2560, 960]> weights, mut tensor<f32, [1, 960]> output) → void {
    output ← input · weights
}

# GEA3-U3a bodies 6–7 — RoPE at the decode position. The [1,32,3] table is
# the position-p row of the committed angle/cos/sin table; the consecutive-
# pair dim=64 contract is unchanged from GEA2.
@ kernel
@ public
fn decode_rope_q(tensor<f32, [1, 960]> input, tensor<f32, [1, 32, 3]> rope_table, mut tensor<f32, [1, 960]> output) → void {
    output ← input.rope_norm(0, 64)
}

@ kernel
@ public
fn decode_rope_k(tensor<f32, [1, 320]> input, tensor<f32, [1, 32, 3]> rope_table, mut tensor<f32, [1, 320]> output) → void {
    output ← input.rope_norm(0, 64)
}

# GEA3-U3a bodies 8–9 — direct in-place KV append at the declared slot.
# The fixed-capacity [76,320] buffer remains the resident K (or V) arena,
# while each launch binds one [320] Position view of that arena. The source
# entry therefore performs one selected-row add and never scans capacity or
# stages a one-hot selector.
@ kernel
@ public
fn kv_append_k(tensor<f32, [320]> history, tensor<f32, [320]> row, mut tensor<f32, [320]> output) → void {
    output ← history + row
}

@ kernel
@ public
fn kv_append_v(tensor<f32, [320]> history, tensor<f32, [320]> row, mut tensor<f32, [320]> output) → void {
    output ← history + row
}

# GEA3-U3a body 10 — per-kv-head key-window transpose for query-1 · keys-L.
@ kernel
@ public
fn decode_key_transpose(tensor<f32, [76, 64]> input, mut tensor<f32, [64, 76]> output) → void {
    output ← input.transpose()
}

# GEA3-U3a body 11 — query-1 × keys-L score with the frozen 0.125 scale as
# the resident [1,76] constant (1/sqrt(64)).
@ kernel
@ public
fn decode_score_gemm(tensor<f32, [1, 64]> query, tensor<f32, [64, 76]> key_transposed, tensor<f32, [1, 76]> attention_scale, mut tensor<f32, [1, 76]> output) → void {
    output ← (query · key_transposed) ⊙ attention_scale
}

# GEA3-U3a body 12 — declared-length masked softmax. The additive mask is
# the resident [1,76] constant: 0 within the declared history length L and
# negative beyond it; the softmax collection method owns the row-wise
# stability recipe exactly as in GEA2.
@ kernel
@ public
fn decode_masked_softmax(tensor<f32, [1, 76]> scores, tensor<f32, [1, 76]> length_mask, mut tensor<f32, [1, 76]> output) → void {
    const f32 _stability_max ← max from scores at [i, j] coalesce 0.0
    output ← (scores + length_mask).softmax()
}

# GEA3-U3a body 13 — per-head context GEMV over the L_max-keyed window.
@ kernel
@ public
fn decode_context_gemm(tensor<f32, [1, 76]> probabilities, tensor<f32, [76, 64]> values, mut tensor<f32, [1, 64]> output) → void {
    output ← probabilities · values
}

# GEA3-U3a body 14 — SwiGLU at query-1.
@ kernel
@ public
fn decode_swiglu(tensor<f32, [1, 2560]> gate, tensor<f32, [1, 2560]> up, mut tensor<f32, [1, 2560]> output) → void {
    const tensor<f32, [1, 2560]> activated ← gate.silu()
    output ← activated ⊙ up
}

# GEA3-U3a body 15 — decode residual stream addition.
@ kernel
@ public
fn decode_residual_add(tensor<f32, [1, 960]> left, tensor<f32, [1, 960]> right, mut tensor<f32, [1, 960]> output) → void {
    output ← left + right
}

# GEA3-U3b — prefill device entries at T_p. The frozen prompt tokenizes to
# 36 tokens (gea3-prompt-tokens.manifest.json), not the exact-8 reuse case,
# so the GEA2 13-entry block set is re-shaped at [T_p,·] instead of reused
# byte-identically (goal open item 3; ruling 0891c09b). T_p=36 is frozen by
# GEA3-U1 and is never re-shaped to fit geometry. Geometry otherwise frozen
# at GEA1/GEA2 (D=960, H=15, K=5, d=64, F=2560); the GEA3-U1 freeze puts
# the fixed-capacity KV buffers at L_max=76 (prompt 36 + n_predict 8 +
# margin 32). Positions 0..T_p-1; the K/V row writes place rows 0..35 of
# the per-layer history buffers. Every entry is F32 and independently
# selectable; per-head windows and the 32x layer repetition stay plan-time
# facts, so these bodies carry no loop, slice, failable construct, or
# in-body call.
#
# Entry inventory (input shapes → output shape):
#   prefill_rmsnorm        [36,960] · [960]              → [36,960]
#   prefill_gemm_qo        [36,960] · [960,960]          → [36,960]
#   prefill_gemm_kv        [36,960] · [960,320]          → [36,320]
#   prefill_gemm_gate_up   [36,960] · [960,2560]         → [36,2560]
#   prefill_gemm_down      [36,2560] · [2560,960]        → [36,960]
#   prefill_rope_q         [36,960] · table [36,32,3]    → [36,960]
#   prefill_rope_k         [36,320] · table [36,32,3]    → [36,320]
#   prefill_key_transpose  [36,64]                       → [64,36]
#   prefill_score_gemm     [36,64] · [64,36] · scale [36,36] → [36,36]
#   prefill_causal_softmax [36,36]                       → [36,36]
#   prefill_context_gemm   [36,36] · [36,64]             → [36,64]
#   prefill_swiglu         [36,2560] · [36,2560]         → [36,2560]
#   prefill_residual_add   [36,960] · [36,960]           → [36,960]
#   prefill_kv_write_k     [76,320] · block [76,36] · rows [36,320] → [76,320]
#   prefill_kv_write_v     [76,320] · block [76,36] · rows [36,320] → [76,320]
#
# KV row writes use the U3a append idiom at block granularity: block is the
# resident [76,36] 0/1 indicator selecting history rows 0..35, so
# `block · rows` writes the [36,320] rope'd K (or V) rows into exactly
# those slots of the fixed-capacity buffer.

# GEA3-U3b body 1 — prefill RMSNorm over the T_p rows.
@ kernel
@ public
fn prefill_rmsnorm(tensor<f32, [36, 960]> input, tensor<f32, [960]> weight, mut tensor<f32, [36, 960]> output) → void {
    output ← input.rms_norm(1, 0.00001, weight)
}

# GEA3-U3b bodies 2–5 — the projection GEMM shapes at T_p rows.
@ kernel
@ public
fn prefill_gemm_qo(tensor<f32, [36, 960]> input, tensor<f32, [960, 960]> weights, mut tensor<f32, [36, 960]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn prefill_gemm_kv(tensor<f32, [36, 960]> input, tensor<f32, [960, 320]> weights, mut tensor<f32, [36, 320]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn prefill_gemm_gate_up(tensor<f32, [36, 960]> input, tensor<f32, [960, 2560]> weights, mut tensor<f32, [36, 2560]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn prefill_gemm_down(tensor<f32, [36, 2560]> input, tensor<f32, [2560, 960]> weights, mut tensor<f32, [36, 960]> output) → void {
    output ← input · weights
}

# GEA3-U3b bodies 6–7 — RoPE at positions 0..T_p-1. The [36,32,3] table is
# the position-0..35 block of the committed angle/cos/sin table; the
# consecutive-pair dim=64 contract is unchanged from GEA2.
@ kernel
@ public
fn prefill_rope_q(tensor<f32, [36, 960]> input, tensor<f32, [36, 32, 3]> rope_table, mut tensor<f32, [36, 960]> output) → void {
    output ← input.rope_norm(0, 64)
}

@ kernel
@ public
fn prefill_rope_k(tensor<f32, [36, 320]> input, tensor<f32, [36, 32, 3]> rope_table, mut tensor<f32, [36, 320]> output) → void {
    output ← input.rope_norm(0, 64)
}

# GEA3-U3b bodies 8–9 — per-head key transpose and the T_p × T_p score GEMM
# with the frozen 0.125 scale as the resident [36,36] constant.
@ kernel
@ public
fn prefill_key_transpose(tensor<f32, [36, 64]> input, mut tensor<f32, [64, 36]> output) → void {
    output ← input.transpose()
}

@ kernel
@ public
fn prefill_score_gemm(tensor<f32, [36, 64]> query, tensor<f32, [64, 36]> key_transposed, tensor<f32, [36, 36]> attention_scale, mut tensor<f32, [36, 36]> output) → void {
    output ← (query · key_transposed) ⊙ attention_scale
}

# GEA3-U3b body 10 — causal row softmax over the T_p × T_p scores.
# GEA3-U6 num-9 repair: the plain `.softmax()` body emitted a FULL-ROW
# softmax — no causal masking at all (every row 36/36 non-zero; row 0
# must be [1, 0, …]).  The additive-mask idiom of `decode_masked_softmax`
# is the established surface: the resident causal_mask is 0 at or below
# the diagonal and negative infinity above it, and the softmax collection
# method owns the row-wise max-subtract/exp/sum recipe.
@ kernel
@ public
fn prefill_causal_softmax(tensor<f32, [36, 36]> scores, tensor<f32, [36, 36]> causal_mask, mut tensor<f32, [36, 36]> output) → void {
    const f32 _stability_max ← max from scores at [i, j] coalesce 0.0
    output ← (scores + causal_mask).softmax()
}

# GEA3-U3b body 11 — per-head context GEMM at T_p rows.
@ kernel
@ public
fn prefill_context_gemm(tensor<f32, [36, 36]> probabilities, tensor<f32, [36, 64]> values, mut tensor<f32, [36, 64]> output) → void {
    output ← probabilities · values
}

# GEA3-U3b body 12 — SwiGLU at T_p rows.
@ kernel
@ public
fn prefill_swiglu(tensor<f32, [36, 2560]> gate, tensor<f32, [36, 2560]> up, mut tensor<f32, [36, 2560]> output) → void {
    const tensor<f32, [36, 2560]> activated ← gate.silu()
    output ← activated ⊙ up
}

# GEA3-U3b body 13 — prefill residual stream addition.
@ kernel
@ public
fn prefill_residual_add(tensor<f32, [36, 960]> left, tensor<f32, [36, 960]> right, mut tensor<f32, [36, 960]> output) → void {
    output ← left + right
}

# GEA3-U3b bodies 14–15 — K/V row writes into the fixed-capacity per-layer
# history buffers at L_max=76. The [76,36] block is the resident 0/1 row
# indicator for positions 0..T_p-1; rows are the rope'd K (or V) outputs.
@ kernel
@ public
fn prefill_kv_write_k(tensor<f32, [76, 320]> history, tensor<f32, [76, 36]> block, tensor<f32, [36, 320]> rows, mut tensor<f32, [76, 320]> output) → void {
    output ← history + block · rows
}

@ kernel
@ public
fn prefill_kv_write_v(tensor<f32, [76, 320]> history, tensor<f32, [76, 36]> block, tensor<f32, [36, 320]> rows, mut tensor<f32, [76, 320]> output) → void {
    output ← history + block · rows
}

# GEA3-U3c — head entries: final RMSNorm, tied lm_head GEMV, and the
# embedding row route. Three independently selectable F32 entries closing
# the U3 kernel-authorship family, all at the decode-step shape T=1 with
# the frozen head geometry (D=960, vocab V=49152). The weights of
# `lm_head_gemv` and the matrix of `embedding_gather` are the SAME tied
# `token_embd.weight` in its resident [V,960] layout (GEA3-U2 typed view);
# lm_head consumes it transposed so the widest GEMV yet is
# [1,960]·[960,49152] → [1,49152] over one physical buffer.
#
# Entry inventory (input shapes → output shape):
#   head_rmsnorm      [1,960] · [960]            → [1,960]
#   lm_head_gemv      [1,960] · [49152,960]^T    → [1,49152]
#   embedding_gather  [49152,960] table + [1] ids → [1,960]
#
# Embedding row route (PGC-R1, superseding the one-hot design note of CTO
# ruling 0891c09b per the 2026-08-28 reopen order): the gather is a direct
# indexed row copy — the compact token-id vector `[1]` (decode; `[36]` in
# the prefill-shaped member) selects rows of the resident embed matrix, one
# row copy per token, no host copy, loop, slice, failable construct, or
# in-body call. The prior one-hot selector matmul dispatched ~1.89e9 padded
# FMAs per fixed-1000 prefill to recover 36×960 values; the row copy
# dispatches none. The tied token_embd.weight stays one physical [V,960]
# buffer shared with `lm_head_gemv`.

# GEA3-U3c body 1 — final RMSNorm over output_norm.weight.
@ kernel
@ public
fn head_rmsnorm(tensor<f32, [1, 960]> input, tensor<f32, [960]> weight, mut tensor<f32, [1, 960]> output) → void {
    output ← input.rms_norm(1, 0.00001, weight)
}

# GEA3-U3c body 2 — tied lm_head GEMV [960→49152]: the resident
# token_embd.weight [49152,960] consumed transposed, one physical buffer.
@ kernel
@ public
fn lm_head_gemv(tensor<f32, [1, 960]> input, tensor<f32, [49152, 960]> embeddings, mut tensor<f32, [1, 49152]> output) → void {
    output ← input · embeddings.transpose()
}

# GEA3-U3c body 3 — embedding row gather (PGC-R1): the compact token-id
# vector reads exactly one row of the resident embed matrix per id.
@ kernel
@ public
fn embedding_gather(tensor<f32, [49152, 960]> embeddings, list<int<u32>> ids, mut tensor<f32, [1, 960]> output) → void {
    output ← embeddings.gather(ids)
}
