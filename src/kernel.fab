+++ toml
locale = "en"

+++ faber
# GEA1-R1 / GEA2-U3 — independently inspectable device entries.
#
# Public import: import from "gradus:kernel" kernel
# Depends on: gradus:dtype (DType tag and name predicate)
#
# The block entries below are all F32 and position-independent. Their
# signatures are the device contract; host admission stays in ordinary
# functions and the nine tensor views remain path/container-free.
#
# Entry inventory (input shapes → output shape):
#   rmsnorm<T,D>       [T,D] · [D] · ε             → [T,D]
#   gemm_qo<T,D>       [T,D] · [D,D]               → [T,D]
#   gemm_kv<T,D,K>     [T,D] · [D,K]               → [T,K]
#   gemm_gate_up<T,D,F> [T,D] · [D,F]              → [T,F]
#   gemm_down<T,F,D>   [T,F] · [F,D]               → [T,D]
#   rope_q<T,D,d,P>    [T,D] · table [T,P,3]       → [T,D]
#   rope_k<T,K,d,P>    [T,K] · table [T,P,3]       → [T,K]
#   transpose<T,d>     [T,d]                       → [d,T]
#   score_gemm<T,d>    [T,d] · [d,T] · scale [T,T] → [T,T]
#   causal_softmax<T>  [T,T]                       → [T,T]
#   context_gemm<T,d>  [T,T] · [T,d]               → [T,d]
#   swiglu<T,F>        [T,F] · [T,F]               → [T,F]
#   residual_add<T,D>  [T,D] · [T,D]               → [T,D]
#
# Glyph law: · is rank-2 matmul and ⊙ is same-shape elementwise product.
# RMSNorm, RoPE, softmax, SiLU, transpose, and add use their method twins,
# which resolve to the pinned collection operations without host calls.
#
# The host admission layer receives typed resident views and validates their
# dtype, shape, byte range, and activation length before the device boundary.
# The @ kernel entries receive only shaped resident tensors and an output
# view. They know no Safetensors/GGUF format, path, container, Hub identity,
# or physical device.

import from "gradus:dtype"

@ public
union KernelError {
    @ shared
    string message

    BadView,
    BadInput,
    BadValue
}

# Physical BF16 resident view. The payload is exactly one declared byte
# range; it is not a file, path, or container.
@ public
class Bf16View {
    let dtype.DType dtype_tag
    let list<int> shape
    let int absolute_start
    let int absolute_end
    let int byte_length
    let list<b8> payload
}

# Physical F32 resident view. It carries the same logical matrix shape while
# retaining its own declared F32 byte range.
@ public
class F32View {
    let dtype.DType dtype_tag
    let list<int> shape
    let int absolute_start
    let int absolute_end
    let int byte_length
    let list<b8> payload
}

fn shape_numel(list<int> shape) → int {
    mut int total ← 1

    for range 0 ‥ shape.length() let i {
        let int extent ← shape.get(i) coalesce 0

        if extent ≤ 0 then return 0

        total ← total * extent
    }

    return total
}

fn matrix_shape(list<int> shape) → bool {
    if shape.length() ≢ 2 then return false

    return shape.get(0) coalesce 0 ≻ 0 and shape.get(1) coalesce 0 ≻ 0
}

fn range_ok(int absolute_start, int absolute_end, list<b8> payload, int expected_bytes) → bool {
    if absolute_start ≺ 0 then return false

    if absolute_end ≤ absolute_start then return false

    if absolute_end - absolute_start ≢ expected_bytes then return false

    if payload.length() ≢ expected_bytes then return false

    return true
}

# Construct the typed BF16 view after a bounded source-range read.
@ public
fn bf16_view(list<b8> payload, int absolute_start, int absolute_end, list<int> shape) → Bf16View ⇥ KernelError {
    require matrix_shape(shape) throw variant BadView { message = "BF16 view must have a positive matrix shape" }

    require range_ok(absolute_start, absolute_end, payload, shape_numel(shape) * dtype.width(dtype.bf16())) throw variant BadView { message = "BF16 view range does not match its declared shape" }

    return Bf16View { dtype_tag = dtype.bf16(), shape = shape, absolute_start = absolute_start, absolute_end = absolute_end, byte_length = payload.length(), payload = payload }
}

# Construct the typed F32 view after its own bounded resident-range read.
@ public
fn f32_view(list<b8> payload, int absolute_start, int absolute_end, list<int> shape) → F32View ⇥ KernelError {
    require matrix_shape(shape) throw variant BadView { message = "F32 view must have a positive matrix shape" }

    require range_ok(absolute_start, absolute_end, payload, shape_numel(shape) * dtype.width(dtype.f32())) throw variant BadView { message = "F32 view range does not match its declared shape" }

    return F32View { dtype_tag = dtype.f32(), shape = shape, absolute_start = absolute_start, absolute_end = absolute_end, byte_length = payload.length(), payload = payload }
}

# Host admission checks. These are called before a Bf16View/F32View crosses
# into the corresponding @ kernel entry; no host validation remains in a
# device body.
@ public
fn validate_bf16_view(Bf16View weights, list<f32> input) → void ⇥ KernelError {
    require dtype.eq(weights.dtype_tag, dtype.bf16()) throw variant BadView { message = "BF16 GEMV received a non-BF16 view" }

    require matrix_shape(weights.shape) throw variant BadView { message = "BF16 GEMV received an invalid matrix shape" }

    require range_ok(weights.absolute_start, weights.absolute_end, weights.payload, shape_numel(weights.shape) * dtype.width(dtype.bf16())) throw variant BadView { message = "BF16 GEMV received an invalid resident range" }

    require input.length() ≡ weights.shape.get(1) coalesce 0 throw variant BadInput { message = "GEMV input does not match the declared inner extent" }
}

@ public
fn validate_f32_view(F32View weights, list<f32> input) → void ⇥ KernelError {
    require dtype.eq(weights.dtype_tag, dtype.f32()) throw variant BadView { message = "F32 GEMV received a non-F32 view" }

    require matrix_shape(weights.shape) throw variant BadView { message = "F32 GEMV received an invalid matrix shape" }

    require range_ok(weights.absolute_start, weights.absolute_end, weights.payload, shape_numel(weights.shape) * dtype.width(dtype.f32())) throw variant BadView { message = "F32 GEMV received an invalid resident range" }

    require input.length() ≡ weights.shape.get(1) coalesce 0 throw variant BadInput { message = "GEMV input does not match the declared inner extent" }
}

# GEA1 body 1: BF16 weights widen in the dense tiled-matmul load seam;
# accumulation and output remain F32. This declaration is intentionally
# independent from the F32 body below.
@ public
kernel gemv_bf16_f32acc<size N, size K>(tensor<bf16, [N, K]> weights, tensor<f32, [K]> input, mut tensor<f32, [N]> output) → void {
    output ⇇ weights · input
}

# GEA1 body 2: independent F32 weights, F32 accumulation, and F32 output.
# This remains a complete second body, not a type parameter, macro, dispatch
# alias, or call through the BF16 implementation.
@ public
kernel gemv_f32_f32acc<size N, size K>(tensor<f32, [N, K]> weights, tensor<f32, [K]> input, mut tensor<f32, [N]> output) → void {
    output ⇇ weights · input
}

# GEA2-U3 body 1 — RMSNorm over the last axis with caller-supplied epsilon.
@ public
kernel rmsnorm<size T, size D>(tensor<f32, [T, D]> input, tensor<f32, [D]> weight, f32 epsilon, mut tensor<f32, [T, D]> output) → void {
    output ⇇ input.norm_rms(axis 1, epsilon, weight)
}

# GEA2-U3 bodies 2–5 — projection GEMMs with model widths supplied by their
# tensor shapes.
@ public
kernel gemm_qo<size T, size D>(tensor<f32, [T, D]> input, tensor<f32, [D, D]> weights, mut tensor<f32, [T, D]> output) → void {
    output ⇇ input · weights
}

@ public
kernel gemm_kv<size T, size D, size K>(tensor<f32, [T, D]> input, tensor<f32, [D, K]> weights, mut tensor<f32, [T, K]> output) → void {
    output ⇇ input · weights
}

@ public
kernel gemm_gate_up<size T, size D, size F>(tensor<f32, [T, D]> input, tensor<f32, [D, F]> weights, mut tensor<f32, [T, F]> output) → void {
    output ⇇ input · weights
}

@ public
kernel gemm_down<size T, size F, size D>(tensor<f32, [T, F]> input, tensor<f32, [F, D]> weights, mut tensor<f32, [T, D]> output) → void {
    output ⇇ input · weights
}

# GEA2-U3 bodies 6–7 — packed RoPE with a caller-shaped [T,P,3]
# angle/cos/sin table input. RopePlan consumes the table at lowering time;
# the source intrinsic carries the caller's consecutive-pair dimension.
@ public
kernel rope_q<size T, size D, size d, size P>(tensor<f32, [T, D]> input, tensor<f32, [T, P, 3]> rope_table, mut tensor<f32, [T, D]> output) → void {
    output ⇇ input.norm_rope<size d>(0, rope_table)
}

@ public
kernel rope_k<size T, size K, size d, size P>(tensor<f32, [T, K]> input, tensor<f32, [T, P, 3]> rope_table, mut tensor<f32, [T, K]> output) → void {
    output ⇇ input.norm_rope<size d>(0, rope_table)
}

# GEA2-U3 body 8 — explicit transpose for q · kᵀ.
@ public
kernel transpose<size T, size d>(tensor<f32, [T, d]> input, mut tensor<f32, [d, T]> output) → void {
    output ⇇ inputᵀ
}

# GEA2-U3 body 9 — score GEMM followed by a caller-supplied scale. The scale
# view is shaped [T,T], which keeps the elementwise operation broadcast-free.
@ public
kernel score_gemm<size T, size d>(tensor<f32, [T, d]> query, tensor<f32, [d, T]> key_transposed, tensor<f32, [T, T]> attention_scale, mut tensor<f32, [T, T]> output) → void {
    output ⇇ query · key_transposed ⊙ attention_scale
}

# GEA2-U3 body 10 — stable causal row softmax. The `softmax_causal` method
# owns the causal guard as well as the row-wise max-subtract/exp/sum recipe.
@ public
kernel causal_softmax<size T>(tensor<f32, [T, T]> scores, mut tensor<f32, [T, T]> output) → void {
    output ⇇ scores.softmax_causal()
}

# GEA2-U3 body 11 — context GEMM.
@ public
kernel context_gemm<size T, size d>(tensor<f32, [T, T]> probabilities, tensor<f32, [T, d]> values, mut tensor<f32, [T, d]> output) → void {
    output ⇇ probabilities · values
}

# GEA2-U3 body 12 — SwiGLU: silu(gate) ⊙ up. `silu` is the scalar-preserving
# tensor method spelling admitted by the device surface; no host helper call.
@ public
kernel swiglu<size T, size F>(tensor<f32, [T, F]> gate, tensor<f32, [T, F]> up, mut tensor<f32, [T, F]> output) → void {
    let tensor<f32, [T, F]> activated ← gate.silu()
    output ⇇ activated ⊙ up
}

# GEA2-U3 body 13 — residual stream addition.
@ public
kernel residual_add<size T, size D>(tensor<f32, [T, D]> left, tensor<f32, [T, D]> right, mut tensor<f32, [T, D]> output) → void {
    output ⇇ left + right
}

# GEA3-U3a — decode-step device entries at the literal one-row decode
# contract. Model widths and KV capacity are caller-shaped size parameters.
# The route instantiates per-head windows and layer repetition at plan time,
# so these bodies carry no loop, slice, failable construct, or in-body call.
#
# Entry inventory (input shapes → output shape):
#   decode_rmsnorm<D>       [1,D] · [D] · ε             → [1,D]
#   decode_gemv_qo<D>       [1,D] · [D,D]               → [1,D]
#   decode_gemv_kv<D,K>     [1,D] · [D,K]               → [1,K]
#   decode_mlp<D,F>         [1,D] · [D,F] · [D,F] · [F,D] → [1,D]
#   decode_rope_q<D,d,P>    [1,D] · table [1,P,3]       → [1,D]
#   decode_rope_k<K,d,P>    [1,K] · table [1,P,3]       → [1,K]
#   kv_append_k<K>         row [K] · row [K]           → row [K]
#   kv_append_v<K>         row [K] · row [K]           → row [K]
#   decode_key_transpose<C,d> [C,d]                    → [d,C]
#   decode_score_gemm<d,C> [1,d] · [d,C] · scale [1,C] → [1,C]
#   decode_masked_softmax<C> [1,C] · mask [1,C]        → [1,C]
#   decode_context_gemm<C,d> [1,C] · [C,d]              → [1,d]
#   decode_residual_add<D> [1,D] · [1,D]               → [1,D]
#
# KV geometry: caller-shaped capacity buffers, append-in-place, declared
# history length, and a mask beyond L. The append entries consume a single
# position-projected row view of the resident arena; the host's typed Position
# binding moves that view to the declared slot and `history + row` writes only
# that row. No capacity-sized selector is staged. The additive mask is the
# resident declared-length constant (0 within L, negative beyond) feeding
# softmax.

# GEA3-U3a body 1 — decode RMSNorm over the single row.
@ public
kernel decode_rmsnorm<size D>(tensor<f32, [1, D]> input, tensor<f32, [D]> weight, f32 epsilon, mut tensor<f32, [1, D]> output) → void {
    output ⇇ input.norm_rms(axis 1, epsilon, weight)
}

# GEA3-U3a bodies 2–5 — the projection GEMV shapes at query-1.
@ public
kernel decode_gemv_qo<size D>(tensor<f32, [1, D]> input, tensor<f32, [D, D]> weights, mut tensor<f32, [1, D]> output) → void {
    output ⇇ input · weights
}

@ public
kernel decode_gemv_kv<size D, size K>(tensor<f32, [1, D]> input, tensor<f32, [D, K]> weights, mut tensor<f32, [1, K]> output) → void {
    output ⇇ input · weights
}

@ public
kernel decode_gemv_gate_up<size D, size F>(tensor<f32, [1, D]> input, tensor<f32, [D, F]> weights, mut tensor<f32, [1, F]> output) → void {
    output ⇇ input · weights
}

@ public
kernel decode_gemv_down<size F, size D>(tensor<f32, [1, F]> input, tensor<f32, [F, D]> weights, mut tensor<f32, [1, D]> output) → void {
    output ⇇ input · weights
}

# GEA3-A2g direct-op MLP parent. The three matmul producers and the SwiGLU
# consumer stay inline so lowering retains the source-local stage identities.
@ public
kernel decode_mlp<size D, size F>(tensor<f32, [1, D]> input, tensor<f32, [D, F]> gate_weights, tensor<f32, [D, F]> up_weights, tensor<f32, [F, D]> down_weights, mut tensor<f32, [1, D]> output) → void {
    let tensor<f32, [1, F]> gate ← input · gate_weights
    let tensor<f32, [1, F]> up ← input · up_weights
    let tensor<f32, [1, F]> activated ← gate.silu()
    let tensor<f32, [1, F]> fused ← activated ⊙ up
    output ⇇ fused · down_weights
}

# GEA3-U3a bodies 6–7 — RoPE at the decode position. The table is the
# position-p row of the caller-shaped angle/cos/sin table.
@ public
kernel decode_rope_q<size D, size d, size P>(tensor<f32, [1, D]> input, tensor<f32, [1, P, 3]> rope_table, mut tensor<f32, [1, D]> output) → void {
    output ⇇ input.norm_rope<size d>(0, rope_table)
}

@ public
kernel decode_rope_k<size K, size d, size P>(tensor<f32, [1, K]> input, tensor<f32, [1, P, 3]> rope_table, mut tensor<f32, [1, K]> output) → void {
    output ⇇ input.norm_rope<size d>(0, rope_table)
}

# GEA3-U3a bodies 8–9 — direct in-place KV append at the declared slot.
# Each launch binds one row view of the resident K (or V) arena. The source
# entry therefore performs one selected-row add and never scans capacity or
# stages a one-hot selector.
@ public
kernel kv_append_k<size K>(tensor<f32, [K]> history, tensor<f32, [K]> row, mut tensor<f32, [K]> output) → void {
    output ⇇ history + row
}

@ public
kernel kv_append_v<size K>(tensor<f32, [K]> history, tensor<f32, [K]> row, mut tensor<f32, [K]> output) → void {
    output ⇇ history + row
}

# GEA3-U3a body 10 — batched per-kv-head key transpose for query-1 · keys-L.
# The leading head axis is a logical view over the shared KV arena; its
# capacity and head width remain caller-shaped facts.
@ public
kernel decode_key_transpose<size H, size C, size d>(tensor<f32, [H, C, d]> input, mut tensor<f32, [H, d, C]> output) → void {
    output ⇇ inputᵀ
}

# GEA3-U3a body 11 — batched head-axis query-1 × keys-L score. The scale is
# an identical-shape resident peer so the elementwise step stays explicit.
@ public
kernel decode_score_gemm<size H, size Q, size T, size d, size C>(tensor<f32, [H, Q, T, d]> query, tensor<f32, [H, d, C]> key_transposed, tensor<f32, [H, Q, T, C]> attention_scale, mut tensor<f32, [H, Q, T, C]> output) → void {
    output ⇇ query · key_transposed ⊙ attention_scale
}

# GEA3-U3a body 12 — declared-length masked softmax over the batched scores.
# The additive mask is a resident [1,C] peer broadcast over head/query/row
# axes: 0 within the declared history length L and negative beyond it.
@ public
kernel decode_masked_softmax<size H, size Q, size T, size C>(tensor<f32, [H, Q, T, C]> scores, tensor<f32, [1, C]> length_mask, mut tensor<f32, [H, Q, T, C]> output) → void {
    output ⇇ (scores + length_mask.expanded(scores.shape())).softmax()
}

# GEA3-U3a body 13 — batched context GEMV over the capacity-keyed window.
@ public
kernel decode_context_gemm<size H, size Q, size T, size C, size d>(tensor<f32, [H, Q, T, C]> probabilities, tensor<f32, [H, C, d]> values, mut tensor<f32, [H, Q, T, d]> output) → void {
    output ⇇ probabilities · values
}

# GEA3-U3a body 14 — SwiGLU at query-1.
@ public
kernel decode_swiglu<size F>(tensor<f32, [1, F]> gate, tensor<f32, [1, F]> up, mut tensor<f32, [1, F]> output) → void {
    let tensor<f32, [1, F]> activated ← gate.silu()
    output ⇇ activated ⊙ up
}

# GEA3-U3a body 15 — decode residual stream addition.
@ public
kernel decode_residual_add<size D>(tensor<f32, [1, D]> left, tensor<f32, [1, D]> right, mut tensor<f32, [1, D]> output) → void {
    output ⇇ left + right
}

# GEA3-U3b — prefill device entries over a caller-shaped prompt extent and
# capacity. Prompt rows, model widths, and KV capacity are admission facts,
# not library statues. Per-head windows and layer repetition stay plan-time
# facts, so these bodies carry no loop, slice, failable construct, or in-body
# call.
#
# Entry inventory (input shapes → output shape):
#   prefill_rmsnorm<T,D>       [T,D] · [D] · ε             → [T,D]
#   prefill_gemm_qo<T,D>       [T,D] · [D,D]               → [T,D]
#   prefill_gemm_kv<T,D,K>     [T,D] · [D,K]               → [T,K]
#   prefill_mlp<T,D,F>         [T,D] · [D,F] · [D,F] · [F,D] → [T,D]
#   prefill_rope_q<T,D,d,P>    [T,D] · table [T,P,3]       → [T,D]
#   prefill_rope_k<T,K,d,P>    [T,K] · table [T,P,3]       → [T,K]
#   prefill_key_transpose<T,d> [T,d]                       → [d,T]
#   prefill_score_gemm<T,d>    [T,d] · [d,T] · scale [T,T] → [T,T]
#   prefill_causal_softmax<T>  [T,T]                       → [T,T]
#   prefill_context_gemm<T,d>  [T,T] · [T,d]               → [T,d]
#   prefill_residual_add<T,D>  [T,D] · [T,D]               → [T,D]
#   prefill_kv_write<C,T,K>    [C,K] · block [C,T] · rows [T,K] → [C,K]
#
# KV row writes use the U3a append idiom at block granularity: block is the
# resident [C,T] 0/1 indicator selecting history rows, so `block · rows`
# writes the [T,K] rope'd K (or V) rows into exactly those slots of the
# capacity buffer.

# GEA3-U3b body 1 — prefill RMSNorm over the T_p rows.
@ public
kernel prefill_rmsnorm<size T, size D>(tensor<f32, [T, D]> input, tensor<f32, [D]> weight, f32 epsilon, mut tensor<f32, [T, D]> output) → void {
    output ⇇ input.norm_rms(axis 1, epsilon, weight)
}

# GEA3-U3b bodies 2–5 — the projection GEMM shapes at T_p rows.
@ public
kernel prefill_gemm_qo<size T, size D>(tensor<f32, [T, D]> input, tensor<f32, [D, D]> weights, mut tensor<f32, [T, D]> output) → void {
    output ⇇ input · weights
}

@ public
kernel prefill_gemm_kv<size T, size D, size K>(tensor<f32, [T, D]> input, tensor<f32, [D, K]> weights, mut tensor<f32, [T, K]> output) → void {
    output ⇇ input · weights
}

@ public
kernel prefill_gemm_gate_up<size T, size D, size F>(tensor<f32, [T, D]> input, tensor<f32, [D, F]> weights, mut tensor<f32, [T, F]> output) → void {
    output ⇇ input · weights
}

@ public
kernel prefill_gemm_down<size T, size F, size D>(tensor<f32, [T, F]> input, tensor<f32, [F, D]> weights, mut tensor<f32, [T, D]> output) → void {
    output ⇇ input · weights
}

# GEA3-A2g direct-op MLP parent. The three matmul producers and the SwiGLU
# consumer remain in one source body for the composed plan.
@ public
kernel prefill_mlp<size T, size D, size F>(tensor<f32, [T, D]> input, tensor<f32, [D, F]> gate_weights, tensor<f32, [D, F]> up_weights, tensor<f32, [F, D]> down_weights, mut tensor<f32, [T, D]> output) → void {
    let tensor<f32, [T, F]> gate ← input · gate_weights
    let tensor<f32, [T, F]> up ← input · up_weights
    let tensor<f32, [T, F]> activated ← gate.silu()
    let tensor<f32, [T, F]> fused ← activated ⊙ up
    output ⇇ fused · down_weights
}

# GEA3-U3b bodies 6–7 — RoPE at the caller's prompt positions. The table is
# the prompt block of the admitted angle/cos/sin table.
@ public
kernel prefill_rope_q<size T, size D, size d, size P>(tensor<f32, [T, D]> input, tensor<f32, [T, P, 3]> rope_table, mut tensor<f32, [T, D]> output) → void {
    output ⇇ input.norm_rope<size d>(0, rope_table)
}

@ public
kernel prefill_rope_k<size T, size K, size d, size P>(tensor<f32, [T, K]> input, tensor<f32, [T, P, 3]> rope_table, mut tensor<f32, [T, K]> output) → void {
    output ⇇ input.norm_rope<size d>(0, rope_table)
}

# GEA3-U3b bodies 8–9 — key transpose and prompt score GEMM with a resident
# [T,T] scale constant.
@ public
kernel prefill_key_transpose<size T, size d>(tensor<f32, [T, d]> input, mut tensor<f32, [d, T]> output) → void {
    output ⇇ inputᵀ
}

@ public
kernel prefill_score_gemm<size T, size d>(tensor<f32, [T, d]> query, tensor<f32, [d, T]> key_transposed, tensor<f32, [T, T]> attention_scale, mut tensor<f32, [T, T]> output) → void {
    output ⇇ query · key_transposed ⊙ attention_scale
}

# GEA3-U3b body 10 — causal row softmax over the T_p × T_p scores.
# GEA3-U6 num-9 repair: the plain `.softmax()` body emitted a FULL-ROW
# softmax — no causal masking at all (every row has non-zero mass; the first
# must be [1, 0, …]). The additive-mask idiom of `decode_masked_softmax`
# is the established surface: the resident causal_mask is 0 at or below
# the diagonal and negative infinity above it, and the softmax collection
# method owns the row-wise max-subtract/exp/sum recipe.
@ public
kernel prefill_causal_softmax<size T>(tensor<f32, [T, T]> scores, tensor<f32, [T, T]> causal_mask, mut tensor<f32, [T, T]> output) → void {
    output ⇇ (scores + causal_mask).softmax()
}

# GEA3-U3b body 11 — context GEMM at prompt rows.
@ public
kernel prefill_context_gemm<size T, size d>(tensor<f32, [T, T]> probabilities, tensor<f32, [T, d]> values, mut tensor<f32, [T, d]> output) → void {
    output ⇇ probabilities · values
}

# GEA3-U3b body 12 — SwiGLU at T_p rows.
@ public
kernel prefill_swiglu<size T, size F>(tensor<f32, [T, F]> gate, tensor<f32, [T, F]> up, mut tensor<f32, [T, F]> output) → void {
    let tensor<f32, [T, F]> activated ← gate.silu()
    output ⇇ activated ⊙ up
}

# GEA3-U3b body 13 — prefill residual stream addition.
@ public
kernel prefill_residual_add<size T, size D>(tensor<f32, [T, D]> left, tensor<f32, [T, D]> right, mut tensor<f32, [T, D]> output) → void {
    output ⇇ left + right
}

# GEA3-U3b bodies 14–15 — K/V row writes into the capacity-sized per-layer
# history buffers. The [C,T] block is the resident 0/1 row indicator for the
# prompt positions; rows are the rope'd K (or V) outputs.
@ public
kernel prefill_kv_write_k<size C, size T, size K>(tensor<f32, [C, K]> history, tensor<f32, [C, T]> block, tensor<f32, [T, K]> rows, mut tensor<f32, [C, K]> output) → void {
    output ⇇ history + block · rows
}

@ public
kernel prefill_kv_write_v<size C, size T, size K>(tensor<f32, [C, K]> history, tensor<f32, [C, T]> block, tensor<f32, [T, K]> rows, mut tensor<f32, [C, K]> output) → void {
    output ⇇ history + block · rows
}

# GEA3-U3c — head entries: final RMSNorm, tied lm_head GEMV, and the
# embedding row route. Their widths are supplied by the admitted tensor
# shapes. The weights of `lm_head_gemv` and the matrix of
# `embedding_gather` are the SAME tied token embedding in its resident
# [V,D] layout; lm_head consumes it transposed.
#
# Entry inventory (input shapes → output shape):
#   head_rmsnorm<D>       [1,D] · [D] · ε          → [1,D]
#   lm_head_gemv<V,D>     [1,D] · [V,D]^T          → [1,V]
#   embedding_gather<V,D> [V,D] table + [1] ids    → [1,D]
#
# Embedding row route (PGC-R1, superseding the one-hot design note of CTO
# ruling 0891c09b per the 2026-08-28 reopen order): the gather is a direct
# indexed row copy — the compact token-id vector selects rows of the resident
# embed matrix, one row copy per token, no host copy, loop, slice, failable
# construct, or in-body call. The tied token embedding stays one physical
# buffer shared with `lm_head_gemv`.

# GEA3-U3c body 1 — final RMSNorm over output_norm.weight.
@ public
kernel head_rmsnorm<size D>(tensor<f32, [1, D]> input, tensor<f32, [D]> weight, f32 epsilon, mut tensor<f32, [1, D]> output) → void {
    output ⇇ input.norm_rms(axis 1, epsilon, weight)
}

# GEA3-U3c body 2 — tied lm_head GEMV: the resident token embedding is
# consumed transposed as one physical buffer.
@ public
kernel lm_head_gemv<size V, size D>(tensor<f32, [1, D]> input, tensor<f32, [V, D]> embeddings, mut tensor<f32, [1, V]> output) → void {
    output ⇇ input · embeddingsᵀ
}

# GEA3-U3c body 3 — embedding row gather (PGC-R1): the compact token-id
# vector reads the selected row of the resident embed matrix.
@ public
kernel embedding_gather<size V, size D>(tensor<f32, [V, D]> embeddings, tensor<u32, [1]> ids, mut tensor<f32, [1, D]> output) → void {
    output ⇇ embeddings.gather(ids)
}

+++ faber test
# GEA1 source-level proof. These tests prove only typed view admission and
# the host/device boundary; they make no lowering, Metal, or device claim.

import from "gradus:dtype" dtype

import from "gradus:model/safetensors" safetensors

import from "gradus:kernel" kernel

const int N = 320
const int K = 960
const int BF16_LENGTH = N * K * 2
const int F32_LENGTH = N * K * 4

fn bytes_of(list<u8> values) → list<b8> {
    let list<b8> out ↤ values
    return out
}

fn bf16_ones() → list<b8> {
    mut list<u8> out ← empty
    for range 0‥(N * K) let i {
        out.append(128 ∷ u8)
        out.append(63 ∷ u8)
    }
    return bytes_of(out)
}

fn f32_ones() → list<b8> {
    mut list<u8> out ← empty
    for range 0‥(N * K) let i {
        out.append(0 ∷ u8)
        out.append(0 ∷ u8)
        out.append(128 ∷ u8)
        out.append(63 ∷ u8)
    }
    return bytes_of(out)
}

fn input_ones() → list<f32> {
    mut list<f32> out ← empty
    for range 0‥K let i {
        out.append(1.0)
    }
    return out
}

test "gea1 typed BF16 and F32 views keep the logical shape" {
    let _ trap_result_4 ← trap {
        let kernel.Bf16View bf16 ← kernel.bf16_view(bf16_ones(), 113454752, 114069152, [N, K])
        let kernel.F32View f32 ← kernel.f32_view(f32_ones(), 200000000, 201228800, [N, K])
        assert dtype.name(bf16.dtype_tag) ≡ "bf16"
        assert dtype.name(f32.dtype_tag) ≡ "f32"
        assert bf16.shape.get(0) coalesce (-1) ≡ N
        assert bf16.shape.get(1) coalesce (-1) ≡ K
        assert f32.shape.get(0) coalesce (-1) ≡ N
        assert f32.shape.get(1) coalesce (-1) ≡ K
        assert bf16.byte_length ≡ BF16_LENGTH
        assert f32.byte_length ≡ F32_LENGTH
        assert bf16.absolute_end - bf16.absolute_start ≡ BF16_LENGTH
        assert f32.absolute_end - f32.absolute_start ≡ F32_LENGTH
    }
    match trap_result_4 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "gea1 host admission validates both resident views before device entry" {
    let _ trap_result_3 ← trap {
        let list<b8> bf16_payload ← bf16_ones()
        let kernel.Bf16View bf16 ← kernel.bf16_view(bf16_payload, 113454752, 114069152, [N, K])
        kernel.validate_bf16_view(bf16, input_ones())

        let list<b8> f32_payload ← f32_ones()
        let kernel.F32View f32 ← kernel.f32_view(f32_payload, 200000000, 201228800, [N, K])
        kernel.validate_f32_view(f32, input_ones())
    }
    match trap_result_3 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

# BLOCKER (B, funnel 7ec5e484): reject rows need the error outcome narrowed
# after trap (`outcome is <error>`) — hard-blocked ("projection base that
# does not resolve to a local value", MIR repair 2d5b7789 not landed). Kept
# on do/catch. Do not convert.
test "gea1 view constructors reject wrong typed storage geometry" {
    do {
        let kernel.Bf16View ? ← kernel.bf16_view(bf16_ones(), 113454752, 114069150, [N, K])
        assert false
    }
    catch err {
        assert true
    }
    do {
        let kernel.F32View ? ← kernel.f32_view(f32_ones(), 200000000, 201228800, [N, K - 1])
        assert false
    }
    catch err {
        assert true
    }
}

# BLOCKER (B, funnel 7ec5e484): reject rows need the error outcome narrowed
# after trap — hard-blocked ("projection base", MIR repair 2d5b7789 not
# landed). Kept on do/catch. Do not convert.
test "gea1 host admission rejects a non-contract input vector" {
    do {
        let list<b8> bf16_payload ← bf16_ones()
        let kernel.Bf16View bf16 ← kernel.bf16_view(bf16_payload, 113454752, 114069152, [N, K])
        kernel.validate_bf16_view(bf16, [1.0])
        assert false
    }
    catch err {
        assert true
    }
    do {
        let list<b8> f32_payload ← f32_ones()
        let kernel.F32View f32 ← kernel.f32_view(f32_payload, 200000000, 201228800, [N, K])
        kernel.validate_f32_view(f32, [1.0])
        assert false
    }
    catch err {
        assert true
    }
}

test "gea1 selected source range is admitted before the kernel boundary" {
    let _ trap_result_2 ← trap {
        let safetensors.SelectedTensor selected ← safetensors.admit_selected(
            "encoder.weight",
            "BF16",
            [N, K],
            bf16_ones(),
            "e6bffe7435d7ddc10fd3b9a9efd429dafbacb1cb17015fb5562664e7532bf86e",
            723674912,
            32672,
            113422080,
            114036480
        )
        assert selected.absolute_start ≡ 113454752
        assert dtype.name(selected.dtype_tag) ≡ "bf16"
        assert selected.shape.get(0) coalesce (-1) ≡ N
        assert selected.shape.get(1) coalesce (-1) ≡ K
    }
    match trap_result_2 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

# BLOCKER (B, funnel 7ec5e484): reject rows need the error outcome narrowed
# after trap — hard-blocked ("projection base", MIR repair 2d5b7789 not
# landed). Kept on do/catch. Do not convert.
test "gea1 selected source range rejects identity or byte-range drift" {
    do {
        let safetensors.SelectedTensor ? ← safetensors.admit_selected(
            "encoder.weight",
            "BF16",
            [N, K],
            bytes_of([128, 63]),
            "zz",
            723674912,
            32672,
            113422080,
            114036480
        )
        assert false
    }
    catch err {
        assert true
    }
    do {
        let safetensors.SelectedTensor ? ← safetensors.admit_selected(
            "encoder.weight",
            "BF16",
            [N, K],
            bytes_of([128, 63]),
            "e6bffe7435d7ddc10fd3b9a9efd429dafbacb1cb17015fb5562664e7532bf86e",
            723674912,
            32672,
            113422080,
            114036480
        )
        assert false
    }
    catch err {
        assert true
    }
}

