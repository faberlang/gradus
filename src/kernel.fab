+++
locale = "en"
+++
# GEA1-R1 / GEA2-U3 — independently inspectable device entries.
#
# Public import: import from "gradus:kernel" kernel
# Depends on: gradus:dtype (DType tag and name predicate)
#
# The block entries below are all F32 and position-independent. Their
# signatures are the device contract; host admission stays in ordinary
# functions and the nine tensor views remain path/container-free.
#
# Entry inventory (input shapes → output shape):
#   rmsnorm<T,D>       [T,D] · [D]                 → [T,D]
#   gemm_qo<T,D>       [T,D] · [D,D]               → [T,D]
#   gemm_kv<T,D,K>     [T,D] · [D,K]               → [T,K]
#   gemm_gate_up<T,D,F> [T,D] · [D,F]              → [T,F]
#   gemm_down<T,F,D>   [T,F] · [F,D]               → [T,D]
#   rope_q<T,D,d,P>    [T,D] · table [T,P,3]       → [T,D]
#   rope_k<T,K,d,P>    [T,K] · table [T,P,3]       → [T,K]
#   transpose<T,d>     [T,d]                       → [d,T]
#   score_gemm<T,d>    [T,d] · [d,T] · scale [T,T] → [T,T]
#   causal_softmax<T>  [T,T]                       → [T,T]
#   context_gemm<T,d>  [T,T] · [T,d]               → [T,d]
#   swiglu<T,F>        [T,F] · [T,F]               → [T,F]
#   residual_add<T,D>  [T,D] · [T,D]               → [T,D]
#
# Glyph law: · is rank-2 matmul and ⊙ is same-shape elementwise product.
# RMSNorm, RoPE, softmax, SiLU, transpose, and add use their method twins,
# which resolve to the pinned collection operations without host calls.
#
# The host admission layer receives typed resident views and validates their
# dtype, shape, byte range, and activation length before the device boundary.
# The @ kernel entries receive only shaped resident tensors and an output
# view. They know no Safetensors/GGUF format, path, container, Hub identity,
# or physical device.

import from "gradus:dtype" dtype

@ public
union KernelError {
    @ shared
    string message

    BadView,
    BadInput,
    BadValue
}

# Physical BF16 resident view. The payload is exactly one declared byte
# range; it is not a file, path, or container.
@ public
class Bf16View {
    dtype.DType dtype_tag
    list<int> shape
    int absolute_start
    int absolute_end
    int byte_length
    bytes payload
}

# Physical F32 resident view. It carries the same logical matrix shape while
# retaining its own declared F32 byte range.
@ public
class F32View {
    dtype.DType dtype_tag
    list<int> shape
    int absolute_start
    int absolute_end
    int byte_length
    bytes payload
}

fn shape_numel(list<int> shape) → int {
    var int total ← 1
    for range 0‥shape.length() const i {
        const int extent ← shape.get(i) coalesce 0
        if extent ≤ 0 then return 0
        total ← total * extent
    }
    return total
}

fn matrix_shape(list<int> shape) → bool {
    if shape.length() ≠ 2 then return false
    return (shape.get(0) coalesce 0) ≻ 0 and (shape.get(1) coalesce 0) ≻ 0
}

fn range_ok(int absolute_start, int absolute_end, bytes payload, int expected_bytes) → bool {
    if absolute_start ≺ 0 then return false
    if absolute_end ≤ absolute_start then return false
    if absolute_end - absolute_start ≠ expected_bytes then return false
    if payload.length() ≠ expected_bytes then return false
    return true
}

# Construct the typed BF16 view after a bounded source-range read.
@ public
fn bf16_view(bytes payload, int absolute_start, int absolute_end, list<int> shape) → Bf16View ⇥ KernelError {
    require matrix_shape(shape) throw variant BadView { message = "BF16 view must have a positive matrix shape" }
    require range_ok(absolute_start, absolute_end, payload, shape_numel(shape) * dtype.width(dtype.bf16())) throw variant BadView { message = "BF16 view range does not match its declared shape" }
    return Bf16View { dtype_tag = dtype.bf16(), shape = shape, absolute_start = absolute_start, absolute_end = absolute_end, byte_length = payload.length(), payload = payload }
}

# Construct the typed F32 view after its own bounded resident-range read.
@ public
fn f32_view(bytes payload, int absolute_start, int absolute_end, list<int> shape) → F32View ⇥ KernelError {
    require matrix_shape(shape) throw variant BadView { message = "F32 view must have a positive matrix shape" }
    require range_ok(absolute_start, absolute_end, payload, shape_numel(shape) * dtype.width(dtype.f32())) throw variant BadView { message = "F32 view range does not match its declared shape" }
    return F32View { dtype_tag = dtype.f32(), shape = shape, absolute_start = absolute_start, absolute_end = absolute_end, byte_length = payload.length(), payload = payload }
}

# Host admission checks. These are called before a Bf16View/F32View crosses
# into the corresponding @ kernel entry; no host validation remains in a
# device body.
@ public
fn validate_bf16_view(Bf16View weights, list<f32> input) → void ⇥ KernelError {
    require dtype.eq(weights.dtype_tag, dtype.bf16()) throw variant BadView { message = "BF16 GEMV received a non-BF16 view" }
    require matrix_shape(weights.shape) throw variant BadView { message = "BF16 GEMV received an invalid matrix shape" }
    require range_ok(weights.absolute_start, weights.absolute_end, weights.payload, shape_numel(weights.shape) * dtype.width(dtype.bf16())) throw variant BadView { message = "BF16 GEMV received an invalid resident range" }
    require input.length() ≡ (weights.shape.get(1) coalesce 0) throw variant BadInput { message = "GEMV input does not match the declared inner extent" }
}

@ public
fn validate_f32_view(F32View weights, list<f32> input) → void ⇥ KernelError {
    require dtype.eq(weights.dtype_tag, dtype.f32()) throw variant BadView { message = "F32 GEMV received a non-F32 view" }
    require matrix_shape(weights.shape) throw variant BadView { message = "F32 GEMV received an invalid matrix shape" }
    require range_ok(weights.absolute_start, weights.absolute_end, weights.payload, shape_numel(weights.shape) * dtype.width(dtype.f32())) throw variant BadView { message = "F32 GEMV received an invalid resident range" }
    require input.length() ≡ (weights.shape.get(1) coalesce 0) throw variant BadInput { message = "GEMV input does not match the declared inner extent" }
}

# GEA1 body 1: BF16 weights widen in the dense tiled-matmul load seam;
# accumulation and output remain F32. This declaration is intentionally
# independent from the F32 body below.
@ kernel
@ public
fn gemv_bf16_f32acc<size N, size K>(tensor<bf16, [N, K]> weights, tensor<f32, [K]> input, mut tensor<f32, [N]> output) → void {
    output ← weights · input
}

# GEA1 body 2: independent F32 weights, F32 accumulation, and F32 output.
# This remains a complete second body, not a type parameter, macro, dispatch
# alias, or call through the BF16 implementation.
@ kernel
@ public
fn gemv_f32_f32acc<size N, size K>(tensor<f32, [N, K]> weights, tensor<f32, [K]> input, mut tensor<f32, [N]> output) → void {
    output ← weights · input
}

# GEA2-U3 body 1 — RMSNorm over the last axis with the fixed epsilon.
@ kernel
@ public
fn rmsnorm<size T, size D>(tensor<f32, [T, D]> input, tensor<f32, [D]> weight, mut tensor<f32, [T, D]> output) → void {
    output ← input.rms_norm(1, 0.00001, weight)
}

# GEA2-U3 bodies 2–5 — projection GEMMs with model widths supplied by their
# tensor shapes.
@ kernel
@ public
fn gemm_qo<size T, size D>(tensor<f32, [T, D]> input, tensor<f32, [D, D]> weights, mut tensor<f32, [T, D]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn gemm_kv<size T, size D, size K>(tensor<f32, [T, D]> input, tensor<f32, [D, K]> weights, mut tensor<f32, [T, K]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn gemm_gate_up<size T, size D, size F>(tensor<f32, [T, D]> input, tensor<f32, [D, F]> weights, mut tensor<f32, [T, F]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn gemm_down<size T, size F, size D>(tensor<f32, [T, F]> input, tensor<f32, [F, D]> weights, mut tensor<f32, [T, D]> output) → void {
    output ← input · weights
}

# GEA2-U3 bodies 6–7 — packed RoPE with a caller-shaped [T,P,3]
# angle/cos/sin table input. RopePlan consumes the table at lowering time;
# the source intrinsic carries the caller's consecutive-pair dimension.
@ kernel
@ public
fn rope_q<size T, size D, size d, size P>(tensor<f32, [T, D]> input, tensor<f32, [T, P, 3]> rope_table, mut tensor<f32, [T, D]> output) → void {
    output ← input.rope_norm<d>(0)
}

@ kernel
@ public
fn rope_k<size T, size K, size d, size P>(tensor<f32, [T, K]> input, tensor<f32, [T, P, 3]> rope_table, mut tensor<f32, [T, K]> output) → void {
    output ← input.rope_norm<d>(0)
}

# GEA2-U3 body 8 — explicit transpose for q · kᵀ.
@ kernel
@ public
fn transpose<size T, size d>(tensor<f32, [T, d]> input, mut tensor<f32, [d, T]> output) → void {
    output ← input.transpose()
}

# GEA2-U3 body 9 — score GEMM followed by a caller-supplied scale. The scale
# view is shaped [T,T], which keeps the elementwise operation broadcast-free.
@ kernel
@ public
fn score_gemm<size T, size d>(tensor<f32, [T, d]> query, tensor<f32, [d, T]> key_transposed, tensor<f32, [T, T]> attention_scale, mut tensor<f32, [T, T]> output) → void {
    output ← (query · key_transposed) ⊙ attention_scale
}

# GEA2-U3 body 10 — stable row softmax. The softmax collection method owns
# the row-wise max-subtract/exp/sum recipe and causal masking at lowering.
@ kernel
@ public
fn causal_softmax<size T>(tensor<f32, [T, T]> scores, mut tensor<f32, [T, T]> output) → void {
    output ← scores.softmax()
}

# GEA2-U3 body 11 — context GEMM.
@ kernel
@ public
fn context_gemm<size T, size d>(tensor<f32, [T, T]> probabilities, tensor<f32, [T, d]> values, mut tensor<f32, [T, d]> output) → void {
    output ← probabilities · values
}

# GEA2-U3 body 12 — SwiGLU: silu(gate) ⊙ up. `silu` is the scalar-preserving
# tensor method spelling admitted by the device surface; no host helper call.
@ kernel
@ public
fn swiglu<size T, size F>(tensor<f32, [T, F]> gate, tensor<f32, [T, F]> up, mut tensor<f32, [T, F]> output) → void {
    const tensor<f32, [T, F]> activated ← gate.silu()
    output ← activated ⊙ up
}

# GEA2-U3 body 13 — residual stream addition.
@ kernel
@ public
fn residual_add<size T, size D>(tensor<f32, [T, D]> left, tensor<f32, [T, D]> right, mut tensor<f32, [T, D]> output) → void {
    output ← left + right
}

# GEA3-U3a — decode-step device entries at the literal one-row decode
# contract. Model widths and KV capacity are caller-shaped size parameters.
# The route instantiates per-head windows and layer repetition at plan time,
# so these bodies carry no loop, slice, failable construct, or in-body call.
#
# Entry inventory (input shapes → output shape):
#   decode_rmsnorm<D>       [1,D] · [D]                 → [1,D]
#   decode_gemv_qo<D>       [1,D] · [D,D]               → [1,D]
#   decode_gemv_kv<D,K>     [1,D] · [D,K]               → [1,K]
#   decode_mlp<D,F>         [1,D] · [D,F] · [D,F] · [F,D] → [1,D]
#   decode_rope_q<D,d,P>    [1,D] · table [1,P,3]       → [1,D]
#   decode_rope_k<K,d,P>    [1,K] · table [1,P,3]       → [1,K]
#   kv_append_k<K>         row [K] · row [K]           → row [K]
#   kv_append_v<K>         row [K] · row [K]           → row [K]
#   decode_key_transpose<C,d> [C,d]                    → [d,C]
#   decode_score_gemm<d,C> [1,d] · [d,C] · scale [1,C] → [1,C]
#   decode_masked_softmax<C> [1,C] · mask [1,C]        → [1,C]
#   decode_context_gemm<C,d> [1,C] · [C,d]              → [1,d]
#   decode_residual_add<D> [1,D] · [1,D]               → [1,D]
#
# KV geometry: caller-shaped capacity buffers, append-in-place, declared
# history length, and a mask beyond L. The append entries consume a single
# position-projected row view of the resident arena; the host's typed Position
# binding moves that view to the declared slot and `history + row` writes only
# that row. No capacity-sized selector is staged. The additive mask is the
# resident declared-length constant (0 within L, negative beyond) feeding
# softmax.

# GEA3-U3a body 1 — decode RMSNorm over the single row.
@ kernel
@ public
fn decode_rmsnorm<size D>(tensor<f32, [1, D]> input, tensor<f32, [D]> weight, mut tensor<f32, [1, D]> output) → void {
    output ← input.rms_norm(1, 0.00001, weight)
}

# GEA3-U3a bodies 2–5 — the projection GEMV shapes at query-1.
@ kernel
@ public
fn decode_gemv_qo<size D>(tensor<f32, [1, D]> input, tensor<f32, [D, D]> weights, mut tensor<f32, [1, D]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn decode_gemv_kv<size D, size K>(tensor<f32, [1, D]> input, tensor<f32, [D, K]> weights, mut tensor<f32, [1, K]> output) → void {
    output ← input · weights
}

@ kernel
fn decode_gemv_gate_up<size D, size F>(tensor<f32, [1, D]> input, tensor<f32, [D, F]> weights, mut tensor<f32, [1, F]> output) → void {
    output ← input · weights
}

@ kernel
fn decode_gemv_down<size F, size D>(tensor<f32, [1, F]> input, tensor<f32, [F, D]> weights, mut tensor<f32, [1, D]> output) → void {
    output ← input · weights
}

# GEA3-A2g direct-op MLP parent. The three matmul producers and the SwiGLU
# consumer stay inline so lowering retains the source-local stage identities.
@ kernel
@ public
fn decode_mlp<size D, size F>(tensor<f32, [1, D]> input, tensor<f32, [D, F]> gate_weights, tensor<f32, [D, F]> up_weights, tensor<f32, [F, D]> down_weights, mut tensor<f32, [1, D]> output) → void {
    const tensor<f32, [1, F]> gate ← input · gate_weights
    const tensor<f32, [1, F]> up ← input · up_weights
    const tensor<f32, [1, F]> activated ← gate.silu()
    const tensor<f32, [1, F]> fused ← activated ⊙ up
    output ← fused · down_weights
}

# GEA3-U3a bodies 6–7 — RoPE at the decode position. The table is the
# position-p row of the caller-shaped angle/cos/sin table.
@ kernel
@ public
fn decode_rope_q<size D, size d, size P>(tensor<f32, [1, D]> input, tensor<f32, [1, P, 3]> rope_table, mut tensor<f32, [1, D]> output) → void {
    output ← input.rope_norm<d>(0)
}

@ kernel
@ public
fn decode_rope_k<size K, size d, size P>(tensor<f32, [1, K]> input, tensor<f32, [1, P, 3]> rope_table, mut tensor<f32, [1, K]> output) → void {
    output ← input.rope_norm<d>(0)
}

# GEA3-U3a bodies 8–9 — direct in-place KV append at the declared slot.
# Each launch binds one row view of the resident K (or V) arena. The source
# entry therefore performs one selected-row add and never scans capacity or
# stages a one-hot selector.
@ kernel
@ public
fn kv_append_k<size K>(tensor<f32, [K]> history, tensor<f32, [K]> row, mut tensor<f32, [K]> output) → void {
    output ← history + row
}

@ kernel
@ public
fn kv_append_v<size K>(tensor<f32, [K]> history, tensor<f32, [K]> row, mut tensor<f32, [K]> output) → void {
    output ← history + row
}

# GEA3-U3a body 10 — key-window transpose for query-1 · keys-L.
@ kernel
@ public
fn decode_key_transpose<size C, size d>(tensor<f32, [C, d]> input, mut tensor<f32, [d, C]> output) → void {
    output ← input.transpose()
}

# GEA3-U3a body 11 — query-1 × keys-L score with a resident [1,C] scale.
@ kernel
@ public
fn decode_score_gemm<size d, size C>(tensor<f32, [1, d]> query, tensor<f32, [d, C]> key_transposed, tensor<f32, [1, C]> attention_scale, mut tensor<f32, [1, C]> output) → void {
    output ← (query · key_transposed) ⊙ attention_scale
}

# GEA3-U3a body 12 — declared-length masked softmax. The additive mask is
# the resident [1,C] constant: 0 within the declared history length L and
# negative beyond it; the softmax collection method owns the row-wise
# stability recipe exactly as in GEA2.
@ kernel
@ public
fn decode_masked_softmax<size C>(tensor<f32, [1, C]> scores, tensor<f32, [1, C]> length_mask, mut tensor<f32, [1, C]> output) → void {
    output ← (scores + length_mask).softmax()
}

# GEA3-U3a body 13 — context GEMV over the capacity-keyed window.
@ kernel
@ public
fn decode_context_gemm<size C, size d>(tensor<f32, [1, C]> probabilities, tensor<f32, [C, d]> values, mut tensor<f32, [1, d]> output) → void {
    output ← probabilities · values
}

# GEA3-U3a body 14 — SwiGLU at query-1.
@ kernel
fn decode_swiglu<size F>(tensor<f32, [1, F]> gate, tensor<f32, [1, F]> up, mut tensor<f32, [1, F]> output) → void {
    const tensor<f32, [1, F]> activated ← gate.silu()
    output ← activated ⊙ up
}

# GEA3-U3a body 15 — decode residual stream addition.
@ kernel
@ public
fn decode_residual_add<size D>(tensor<f32, [1, D]> left, tensor<f32, [1, D]> right, mut tensor<f32, [1, D]> output) → void {
    output ← left + right
}

# GEA3-U3b — prefill device entries over a caller-shaped prompt extent and
# capacity. Prompt rows, model widths, and KV capacity are admission facts,
# not library statues. Per-head windows and layer repetition stay plan-time
# facts, so these bodies carry no loop, slice, failable construct, or in-body
# call.
#
# Entry inventory (input shapes → output shape):
#   prefill_rmsnorm<T,D>       [T,D] · [D]                 → [T,D]
#   prefill_gemm_qo<T,D>       [T,D] · [D,D]               → [T,D]
#   prefill_gemm_kv<T,D,K>     [T,D] · [D,K]               → [T,K]
#   prefill_mlp<T,D,F>         [T,D] · [D,F] · [D,F] · [F,D] → [T,D]
#   prefill_rope_q<T,D,d,P>    [T,D] · table [T,P,3]       → [T,D]
#   prefill_rope_k<T,K,d,P>    [T,K] · table [T,P,3]       → [T,K]
#   prefill_key_transpose<T,d> [T,d]                       → [d,T]
#   prefill_score_gemm<T,d>    [T,d] · [d,T] · scale [T,T] → [T,T]
#   prefill_causal_softmax<T>  [T,T]                       → [T,T]
#   prefill_context_gemm<T,d>  [T,T] · [T,d]               → [T,d]
#   prefill_residual_add<T,D>  [T,D] · [T,D]               → [T,D]
#   prefill_kv_write<C,T,K>    [C,K] · block [C,T] · rows [T,K] → [C,K]
#
# KV row writes use the U3a append idiom at block granularity: block is the
# resident [C,T] 0/1 indicator selecting history rows, so `block · rows`
# writes the [T,K] rope'd K (or V) rows into exactly those slots of the
# capacity buffer.

# GEA3-U3b body 1 — prefill RMSNorm over the T_p rows.
@ kernel
@ public
fn prefill_rmsnorm<size T, size D>(tensor<f32, [T, D]> input, tensor<f32, [D]> weight, mut tensor<f32, [T, D]> output) → void {
    output ← input.rms_norm(1, 0.00001, weight)
}

# GEA3-U3b bodies 2–5 — the projection GEMM shapes at T_p rows.
@ kernel
@ public
fn prefill_gemm_qo<size T, size D>(tensor<f32, [T, D]> input, tensor<f32, [D, D]> weights, mut tensor<f32, [T, D]> output) → void {
    output ← input · weights
}

@ kernel
@ public
fn prefill_gemm_kv<size T, size D, size K>(tensor<f32, [T, D]> input, tensor<f32, [D, K]> weights, mut tensor<f32, [T, K]> output) → void {
    output ← input · weights
}

@ kernel
fn prefill_gemm_gate_up<size T, size D, size F>(tensor<f32, [T, D]> input, tensor<f32, [D, F]> weights, mut tensor<f32, [T, F]> output) → void {
    output ← input · weights
}

@ kernel
fn prefill_gemm_down<size T, size F, size D>(tensor<f32, [T, F]> input, tensor<f32, [F, D]> weights, mut tensor<f32, [T, D]> output) → void {
    output ← input · weights
}

# GEA3-A2g direct-op MLP parent. The three matmul producers and the SwiGLU
# consumer remain in one source body for the composed plan.
@ kernel
@ public
fn prefill_mlp<size T, size D, size F>(tensor<f32, [T, D]> input, tensor<f32, [D, F]> gate_weights, tensor<f32, [D, F]> up_weights, tensor<f32, [F, D]> down_weights, mut tensor<f32, [T, D]> output) → void {
    const tensor<f32, [T, F]> gate ← input · gate_weights
    const tensor<f32, [T, F]> up ← input · up_weights
    const tensor<f32, [T, F]> activated ← gate.silu()
    const tensor<f32, [T, F]> fused ← activated ⊙ up
    output ← fused · down_weights
}

# GEA3-U3b bodies 6–7 — RoPE at the caller's prompt positions. The table is
# the prompt block of the admitted angle/cos/sin table.
@ kernel
@ public
fn prefill_rope_q<size T, size D, size d, size P>(tensor<f32, [T, D]> input, tensor<f32, [T, P, 3]> rope_table, mut tensor<f32, [T, D]> output) → void {
    output ← input.rope_norm<d>(0)
}

@ kernel
@ public
fn prefill_rope_k<size T, size K, size d, size P>(tensor<f32, [T, K]> input, tensor<f32, [T, P, 3]> rope_table, mut tensor<f32, [T, K]> output) → void {
    output ← input.rope_norm<d>(0)
}

# GEA3-U3b bodies 8–9 — key transpose and prompt score GEMM with a resident
# [T,T] scale constant.
@ kernel
@ public
fn prefill_key_transpose<size T, size d>(tensor<f32, [T, d]> input, mut tensor<f32, [d, T]> output) → void {
    output ← input.transpose()
}

@ kernel
@ public
fn prefill_score_gemm<size T, size d>(tensor<f32, [T, d]> query, tensor<f32, [d, T]> key_transposed, tensor<f32, [T, T]> attention_scale, mut tensor<f32, [T, T]> output) → void {
    output ← (query · key_transposed) ⊙ attention_scale
}

# GEA3-U3b body 10 — causal row softmax over the T_p × T_p scores.
# GEA3-U6 num-9 repair: the plain `.softmax()` body emitted a FULL-ROW
# softmax — no causal masking at all (every row has non-zero mass; the first
# must be [1, 0, …]). The additive-mask idiom of `decode_masked_softmax`
# is the established surface: the resident causal_mask is 0 at or below
# the diagonal and negative infinity above it, and the softmax collection
# method owns the row-wise max-subtract/exp/sum recipe.
@ kernel
@ public
fn prefill_causal_softmax<size T>(tensor<f32, [T, T]> scores, tensor<f32, [T, T]> causal_mask, mut tensor<f32, [T, T]> output) → void {
    output ← (scores + causal_mask).softmax()
}

# GEA3-U3b body 11 — context GEMM at prompt rows.
@ kernel
@ public
fn prefill_context_gemm<size T, size d>(tensor<f32, [T, T]> probabilities, tensor<f32, [T, d]> values, mut tensor<f32, [T, d]> output) → void {
    output ← probabilities · values
}

# GEA3-U3b body 12 — SwiGLU at T_p rows.
@ kernel
fn prefill_swiglu<size T, size F>(tensor<f32, [T, F]> gate, tensor<f32, [T, F]> up, mut tensor<f32, [T, F]> output) → void {
    const tensor<f32, [T, F]> activated ← gate.silu()
    output ← activated ⊙ up
}

# GEA3-U3b body 13 — prefill residual stream addition.
@ kernel
@ public
fn prefill_residual_add<size T, size D>(tensor<f32, [T, D]> left, tensor<f32, [T, D]> right, mut tensor<f32, [T, D]> output) → void {
    output ← left + right
}

# GEA3-U3b bodies 14–15 — K/V row writes into the capacity-sized per-layer
# history buffers. The [C,T] block is the resident 0/1 row indicator for the
# prompt positions; rows are the rope'd K (or V) outputs.
@ kernel
@ public
fn prefill_kv_write_k<size C, size T, size K>(tensor<f32, [C, K]> history, tensor<f32, [C, T]> block, tensor<f32, [T, K]> rows, mut tensor<f32, [C, K]> output) → void {
    output ← history + block · rows
}

@ kernel
@ public
fn prefill_kv_write_v<size C, size T, size K>(tensor<f32, [C, K]> history, tensor<f32, [C, T]> block, tensor<f32, [T, K]> rows, mut tensor<f32, [C, K]> output) → void {
    output ← history + block · rows
}

# GEA3-U3c — head entries: final RMSNorm, tied lm_head GEMV, and the
# embedding row route. Their widths are supplied by the admitted tensor
# shapes. The weights of `lm_head_gemv` and the matrix of
# `embedding_gather` are the SAME tied token embedding in its resident
# [V,D] layout; lm_head consumes it transposed.
#
# Entry inventory (input shapes → output shape):
#   head_rmsnorm<D>       [1,D] · [D]              → [1,D]
#   lm_head_gemv<V,D>     [1,D] · [V,D]^T          → [1,V]
#   embedding_gather<V,D> [V,D] table + [1] ids    → [1,D]
#
# Embedding row route (PGC-R1, superseding the one-hot design note of CTO
# ruling 0891c09b per the 2026-08-28 reopen order): the gather is a direct
# indexed row copy — the compact token-id vector selects rows of the resident
# embed matrix, one row copy per token, no host copy, loop, slice, failable
# construct, or in-body call. The tied token embedding stays one physical
# buffer shared with `lm_head_gemv`.

# GEA3-U3c body 1 — final RMSNorm over output_norm.weight.
@ kernel
@ public
fn head_rmsnorm<size D>(tensor<f32, [1, D]> input, tensor<f32, [D]> weight, mut tensor<f32, [1, D]> output) → void {
    output ← input.rms_norm(1, 0.00001, weight)
}

# GEA3-U3c body 2 — tied lm_head GEMV: the resident token embedding is
# consumed transposed as one physical buffer.
@ kernel
@ public
fn lm_head_gemv<size V, size D>(tensor<f32, [1, D]> input, tensor<f32, [V, D]> embeddings, mut tensor<f32, [1, V]> output) → void {
    output ← input · embeddings.transpose()
}

# GEA3-U3c body 3 — embedding row gather (PGC-R1): the compact token-id
# vector reads the selected row of the resident embed matrix.
@ kernel
@ public
fn embedding_gather<size V, size D>(tensor<f32, [V, D]> embeddings, list<int<u32>> ids, mut tensor<f32, [1, D]> output) → void {
    output ← embeddings.gather(ids)
}
