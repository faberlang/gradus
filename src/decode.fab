+++
locale = "en"
+++
# Decode loop semantics — PML5-U1 (production inference computation layer).
#
# Public import: importa ex "gradus:decode" privata decode
# Depends on: gradus:dtype (finita), gradus:tensor (value carrier),
# gradus:nn (linear — the output projection), gradus:transformer
# (transformer_block — the SHARED forward row).
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own those). This module holds no backend or device handle and makes no
# performance claims (NGAB owns executable evidence).
#
# =========================================================================
# The decode contract (pml5-delivery.md PML5-U1)
# =========================================================================
#
# --- One-token decode over the forward row -------------------------------
# decodere_datum(token_id, positio, decodere) is the explicit public
# one-token decode op: token id + position in → full-vocabulary logits
# out. The forward row is the PML3 shared transformer block
# (transformer.transformer_block, attention mode 2 — causal + RoPE, the
# selected inference row) over the F32 staged carrier; the decode composes
# embedding gather → block → output projection.
#
# --- Prefill and decode share the same forward functions -----------------
# praefundere(tokens, decodere) runs the multi-token (teacher-forced)
# path over the SAME forward functions: the same embedding gather, the
# same transformer_block, the same output projection. The single-token
# prefill IS the decode at position 0 (probed); the first prefill
# position equals the single-token decode at position 0 (probed). The
# decode's single-token causal self-score is position-invariant under RoPE
# (the rotation of q and k by the same angles cancels in the dot product)
# — the position enters through the multi-token causal path (and the
# KV-cache of U2).
#
# --- Reset / context-limit behavior (explicit) ---------------------------
# The Decodere declares its context length (contextus); the decode op and
# the prefill op fail closed on positions at or beyond it (reject policy —
# no silent truncation; U5 owns the full session policy). The session
# (Sessio) is an explicit position counter with advance (progredere —
# rejects at the limit) and reset (redintegra — back to position 0);
# no hidden position state.
#
# --- Oracle-matching logits (GI2 contract, read-only inputs) -------------
# The logits are pinned per the GI2 numeric-contract discipline (read
# only: gi0-numeric-contract.md — full-vocab raw logits, finite gate,
# top-1 exactness on each pin row, first-divergence rule) applied to
# the gradus forward row: the decode.proba pins f64 evaluations of the
# documented forward arithmetic (the same arithmetic the transformer/
# attention/nn probas pin) with the documented 5e-4 tolerance. The GI2
# oracle itself (dequant + the 32-layer decoder in faber-runtime) is a
# read-only input to this phase, never reimplemented here.
#
# --- Evidence honesty (CTO Q2, hard) -------------------------------------
# This surface is the STRUCTURAL proof: the decode op, the prefill/decode
# sharing, and the reset/limit behavior are compile-validated and proven
# by the co-located proba (f64 oracle pins). Executed VALUE identity
# (the logits computed at runtime) is env-blocked tree-wide today (FMIR
# stepper / library-import gap — the PML4 closeout recorded both blockers;
# neither is fixed here). PML5-U1 is PARTIAL: logit-value identity is
# deferred to the auditor-owned runtime-evidence gate.
#
# =========================================================================
# PML5-U5 additions — reset, cancellation observation, deterministic replay
# =========================================================================
#
# --- Session reset (fresh state) -----------------------------------------
# redintegra(Sessio) resets an advanced session to position 0, preserving
# the context limit — the public reset. The generation cursor
# (generation.fab) wires it as the cursor reset.
#
# --- Cancellation observation points (cooperative, fail closed) ----------
# Cancelatum is an explicit pure value; observa_cancellationem is the
# cooperative checkpoint the generation loop calls at step boundaries. A
# set flag REJECTS with Cancelata (typed) — cancellation is observed, never
# assumed, never silently skipped. The decode/replay compositions observe
# the flag at entry and before every step.
#
# --- Deterministic replay (same seed + input -> same tokens) -------------
# replica(logits-stream, sampling Configura, history, Semen, Cancelatum)
# is the bounded deterministic sampling composition: per-step
# sampling.sors over the running history with the explicit advancing RNG
# state. Pure — equal inputs produce equal token sequences (probed). The
# model decode (logits production) is NOT here — U6 wires decodere_datum
# into the aggregate.
#
# --- No server / device handle --------------------------------------------
# This module holds no device handle, no server, no HTTP/batching
# surface — only logical state (sessions, cancellation tokens, the replay
# composition). No performance claims.
import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

import from "gradus:nn" nn

import from "gradus:transformer" transformer

import from "gradus:sampling" sampling

import from "gradus:train" train

# -------------------------------------------------------------------------
# DecodeError — typed error vocabulary of the decode surface.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------

union DecodeError {
    IdExtra {
        string message
    },
    PositioInvalida {
        string message
    },
    Terminus {
        string message
    },
    DecodereInvalida {
        string message
    },
    FormaMismatch {
        string message
    },
    TypoMismatch {
        string message
    },
    ElementaMismatch {
        string message
    },
    Incompatibilis {
        string message
    },
    DimensioInvalida {
        string message
    },
    Cancelata {
        string message
    },
    SamplingDefecta {
        string message
    }
}

@ public { }
fn message(DecodeError e) → string {
    match e {
        case IdExtra const message {
            return message
        }
        case PositioInvalida const message {
            return message
        }
        case Terminus const message {
            return message
        }
        case DecodereInvalida const message {
            return message
        }
        case FormaMismatch const message {
            return message
        }
        case TypoMismatch const message {
            return message
        }
        case ElementaMismatch const message {
            return message
        }
        case Incompatibilis const message {
            return message
        }
        case DimensioInvalida const message {
            return message
        }
        case Cancelata const message {
            return message
        }
        case SamplingDefecta const message {
            return message
        }
    }
}

# The attention mode of the shared forward row: 2 = causal + RoPE (the
# selected inference row, transformer.fab mode contract).
const int MODUS_INFERENTIA ← 2

# -------------------------------------------------------------------------
# Pondera — the transformer block's weights (the shared forward row's
# parameters). Mirrors the transformer_block argument order.
# -------------------------------------------------------------------------


@ public { }
class Weights {
    tensor.Tensor ln1_s
    tensor.Tensor ln1_o
    tensor.Tensor wq
    tensor.Tensor bq
    tensor.Tensor wk
    tensor.Tensor bk
    tensor.Tensor wv
    tensor.Tensor bv
    tensor.Tensor wo
    tensor.Tensor bo
    tensor.Tensor ln2_s
    tensor.Tensor ln2_o
    tensor.Tensor wf1
    tensor.Tensor bf1
    tensor.Tensor wf2
    tensor.Tensor bf2
    tensor.Tensor ln3_s
    tensor.Tensor ln3_o

    fn ln1_s() → tensor.Tensor {
        return self.ln1_s
    }

    fn ln1_o() → tensor.Tensor {
        return self.ln1_o
    }

    fn wq() → tensor.Tensor {
        return self.wq
    }

    fn bq() → tensor.Tensor {
        return self.bq
    }

    fn wk() → tensor.Tensor {
        return self.wk
    }

    fn bk() → tensor.Tensor {
        return self.bk
    }

    fn wv() → tensor.Tensor {
        return self.wv
    }

    fn bv() → tensor.Tensor {
        return self.bv
    }

    fn wo() → tensor.Tensor {
        return self.wo
    }

    fn bo() → tensor.Tensor {
        return self.bo
    }

    fn ln2_s() → tensor.Tensor {
        return self.ln2_s
    }

    fn ln2_o() → tensor.Tensor {
        return self.ln2_o
    }

    fn wf1() → tensor.Tensor {
        return self.wf1
    }

    fn bf1() → tensor.Tensor {
        return self.bf1
    }

    fn wf2() → tensor.Tensor {
        return self.wf2
    }

    fn bf2() → tensor.Tensor {
        return self.bf2
    }

    fn ln3_s() → tensor.Tensor {
        return self.ln3_s
    }

    fn ln3_o() → tensor.Tensor {
        return self.ln3_o
    }
}

# Build the block weights (the block's own fail-closed validation runs at
# call time; the decode-level invariants are the Decodere constructor's).
@ public { }
fn construct_weights(tensor.Tensor ln1_s, tensor.Tensor ln1_o, tensor.Tensor wq, tensor.Tensor bq, tensor.Tensor wk, tensor.Tensor bk, tensor.Tensor wv, tensor.Tensor bv, tensor.Tensor wo, tensor.Tensor bo, tensor.Tensor ln2_s, tensor.Tensor ln2_o, tensor.Tensor wf1, tensor.Tensor bf1, tensor.Tensor wf2, tensor.Tensor bf2, tensor.Tensor ln3_s, tensor.Tensor ln3_o) → Weights {
    return Weights {ln1_s = ln1_s, ln1_o = ln1_o, wq = wq, bq = bq, wk = wk, bk = bk, wv = wv, bv = bv, wo = wo, bo = bo, ln2_s = ln2_s, ln2_o = ln2_o, wf1 = wf1, bf1 = bf1, wf2 = wf2, bf2 = bf2, ln3_s = ln3_s, ln3_o = ln3_o}
}

# -------------------------------------------------------------------------
# Decodere — the model handle: the embedding table + the block weights +
# the output projection + the decode configuration. Gradus owns this
# logical state; no device handle. The forward row's weight-shape
# validation is the transformer_block's fail-closed contract (call time);
# this constructor validates the decode-level invariants.
# -------------------------------------------------------------------------


@ public { }
class Decoder {
    tensor.Tensor table
    Weights weights
    tensor.Tensor projection
    tensor.Tensor projectio_bias
    f32 scale
    int vocabulary
    int context
    int dimension

    # The embedding table [vocabulum, dimensio].
    fn table() → tensor.Tensor {
        return self.table
    }

    # The shared forward row's block weights.
    fn weights() → Weights {
        return self.weights
    }

    # The output projection [dimensio, vocabulum].
    fn projection() → tensor.Tensor {
        return self.projection
    }

    # The output projection bias [vocabulum].
    fn projectio_bias() → tensor.Tensor {
        return self.projectio_bias
    }

    # The attention dk scaling factor (1/sqrt(dk)).
    fn scale() → f32 {
        return self.scale
    }

    # Vocabulary size (token-id domain [0, vocabulum)).
    fn vocabulary() → int {
        return self.vocabulary
    }

    # Context length (the position limit; decode fails closed at it).
    fn context() → int {
        return self.context
    }

    # Embedding dimension (the forward row's feature width).
    fn dimension() → int {
        return self.dimension
    }
}

@ public { }
fn construct_decoder(tensor.Tensor table, Weights weights, tensor.Tensor projection, tensor.Tensor projectio_bias, f32 scale, int vocabulary, int context, int dimension) → Decoder ⇥ DecodeError {
    if vocabulary ≺ 1 {
        throw variant DecodereInvalida {message = "vocabulary must be non-empty"}
    }
    if context ≺ 1 {
        throw variant DecodereInvalida {message = "context length must be at least one"}
    }
    if dimension ≺ 1 {
        throw variant DecodereInvalida {message = "embedding dimension must be at least one"}
    }
    if not dtype.finite(scale) {
        throw variant DecodereInvalida {message = "invalid attention scale"}
    }
    if scale ≤ 0.0 {
        throw variant DecodereInvalida {message = "invalid attention scale"}
    }
    const list<int> fm ← table.shape()
    if fm.length() ≠ 2 {
        throw variant DecodereInvalida {message = "embedding must be rank-2"}
    }
    if fm.get(0) coalesce 1 ≠ vocabulary {
        throw variant DecodereInvalida {message = "embedding rows must equal the vocabulary"}
    }
    if fm.get(1) coalesce 1 ≠ dimension {
        throw variant DecodereInvalida {message = "embedding columns must equal the dimension"}
    }
    const list<int> fp ← projection.shape()
    if fp.length() ≠ 2 {
        throw variant DecodereInvalida {message = "output projection must be rank-2"}
    }
    if fp.get(0) coalesce 1 ≠ dimension or fp.get(1) coalesce 1 ≠ vocabulary {
        throw variant DecodereInvalida {message = "output projection shape must be [dim, vocab]"}
    }
    const list<int> fpb ← projectio_bias.shape()
    if fpb.length() ≠ 1 or fpb.get(0) coalesce 1 ≠ vocabulary {
        throw variant DecodereInvalida {message = "output projection bias must be [vocab]"}
    }
    return Decoder {table = table, weights = weights, projection = projection, projectio_bias = projectio_bias, scale = scale, vocabulary = vocabulary, context = context, dimension = dimension}
}

# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# Staged-tensor construction (the never-firing shape check, re-mapped).
@ private { }
fn _tensor(list<f32> datos, list<int> forma) → tensor.Tensor ⇥ DecodeError {
    do {
        return tensor.construct(datos, forma)
    }
    catch err {
        throw variant ElementaMismatch {message = tensor.message(err)}
    }
    throw variant ElementaMismatch {message = "unreachable"}
}

# The embedding gather: the token's row of the embedding table, flat.
@ private { }
fn _embedding(tensor.Tensor table, int id, int dim) → list<f32> {
    var list<f32> row ← vacua
    var int i ← 0
    while i ≺ dim {
        row.append(table.data.get(id * dim + i) coalesce 0.0 ∷ f32)
        i ← i + 1
    }
    return row
}

# The shared forward row: the transformer block (mode 2 — causal + RoPE)
# over the staged carrier, positions explicit.
@ private { }
fn _block(Decoder m, tensor.Tensor x, list<int> positions) → tensor.Tensor ⇥ DecodeError {
    const Weights p ← m.weights()
    do {
        return transformer.transformer_block(x, p.ln1_s(), p.ln1_o(), p.wq(), p.bq(), p.wk(), p.bk(), p.wv(), p.bv(), p.wo(), p.bo(), p.ln2_s(), p.ln2_o(), p.wf1(), p.bf1(), p.wf2(), p.bf2(), p.ln3_s(), p.ln3_o(), m.scale(), MODUS_INFERENTIA, positions, m.dimension())
    }
    catch err {
        const string c ← transformer.message(err)
        if c ≡ "inner dimensions mismatch" {
            throw variant Incompatibilis {message = c}
        }
        if c ≡ "dtype mismatch" {
            throw variant TypoMismatch {message = c}
        }
        if c ≡ "bias does not match output width" {
            throw variant FormaMismatch {message = c}
        }
        if c ≡ "unknown attention mode" {
            throw variant DimensioInvalida {message = c}
        }
        throw variant FormaMismatch {message = c}
    }
}

# The output projection: the block output → full-vocab logits.
@ private { }
fn _project(Decoder m, tensor.Tensor h) → tensor.Tensor ⇥ DecodeError {
    do {
        return nn.linear(h, m.projection(), m.projectio_bias())
    }
    catch err {
        const string c ← nn.causa(err)
        if c ≡ "inner dimensions mismatch" {
            throw variant Incompatibilis {message = c}
        }
        if c ≡ "dtype mismatch" {
            throw variant TypoMismatch {message = c}
        }
        throw variant FormaMismatch {message = c}
    }
}

# -------------------------------------------------------------------------
# decodere_datum — the ONE-token decode op: token id + position in →
# full-vocab logits out, over the shared forward row. Fail closed on a
# token id outside [0, vocabulum) and a position at or beyond the context
# limit (the reject policy — no silent truncation).
# -------------------------------------------------------------------------

@ public { }
fn decodere_datum(int token_id, int position, Decoder m) → tensor.Tensor ⇥ DecodeError {
    if token_id ≺ 0 or token_id ≥ m.vocabulary() {
        throw variant IdExtra {message = "token id out of vocabulary range"}
    }
    if position ≺ 0 or position ≥ m.context() {
        throw variant PositioInvalida {message = "position out of context"}
    }
    const list<f32> row ← _embedding(m.table(), token_id, m.dimension())
    const tensor.Tensor x ← _tensor(row, [1, m.dimension()])
    const tensor.Tensor h ← _block(m, x, [position])
    const tensor.Tensor logits ← _project(m, h)
    # The [1, V] projection flattens to the full-vocab logits [V].
    return _tensor(logits.data, [m.vocabulary()])
}

# -------------------------------------------------------------------------
# praefundere — the multi-token (teacher-forced) path: prompt token ids →
# full-vocab logits [N, V] over the SAME forward functions as decode.
# The prompt length must not exceed the context limit (reject policy).
# -------------------------------------------------------------------------

fn prefill(list<int> tokens, Decoder m) → tensor.Tensor ⇥ DecodeError {
    if tokens.length() ≡ 0 {
        throw variant ElementaMismatch {message = "empty prompt"}
    }
    if tokens.length() ≻ m.context() {
        throw variant PositioInvalida {message = "prompt exceeds the context limit"}
    }
    for from tokens const t {
        if t ≺ 0 or t ≥ m.vocabulary() {
            throw variant IdExtra {message = "token id out of vocabulary range"}
        }
    }
    var list<f32> flat ← vacua
    for from tokens const t {
        const list<f32> row ← _embedding(m.table(), t, m.dimension())
        for from row const v {
            flat.append(v)
        }
    }
    const tensor.Tensor x ← _tensor(flat, [tokens.length(), m.dimension()])
    var list<int> positions ← vacua
    for range 0‥tokens.length() const i {
        positions.append(i)
    }
    const tensor.Tensor h ← _block(m, x, positions)
    return _project(m, h)
}

# -------------------------------------------------------------------------
# Sessio — the explicit session position state. Reset and the context
# limit are explicit public behaviors: progredere rejects at the limit,
# redintegra resets to position 0. No hidden position state.
# -------------------------------------------------------------------------


@ public { }
class Session {
    int position
    int context

    # The next decode position.
    fn position() → int {
        return self.position
    }

    # The session's context limit.
    fn context() → int {
        return self.context
    }
}

# A fresh session at position 0 with the declared context limit.
@ public { }
fn fresh_session(int context) → Session ⇥ DecodeError {
    if context ≺ 1 {
        throw variant DecodereInvalida {message = "context length must be at least one"}
    }
    return Session {position = 0, context = context}
}

# Advance the session by one position — rejects when the next position
# would be at or beyond the context limit (the limit is reached).
fn advance(Session s) → Session ⇥ DecodeError {
    if s.position() + 1 ≥ s.context() {
        throw variant Terminus {message = "context limit reached"}
    }
    return Session {position = s.position() + 1, context = s.context()}
}

# Reset the session to position 0 (fresh state).
@ public { }
fn reset(Session s) → Session {
    return Session {position = 0, context = s.context()}
}

# -------------------------------------------------------------------------
# Cancellation observation — the cooperative checkpoint (PML5-U5).
# Cancelatum is an explicit pure value the generation loop owns; the
# observation point (observa_cancellationem) is the cooperative check the
# loop calls at step boundaries. Cancellation is cooperative and fail
# closed: the flag is observed, never assumed, and a set flag rejects with
# a typed Cancelata — no silent mid-decode abort, no ignored cancellation.
# -------------------------------------------------------------------------


@ public { }
class Cancellation {
    bool cancelled

    # The cancellation flag (true = cancellation requested).
    fn cancelled() → bool {
        return self.cancelled
    }
}

# A fresh (not cancelled) cancellation token.
@ public { }
fn fresh_cancellation() → Cancellation {
    return Cancellation {cancelled = false}
}

# A cancellation-requested token.
fn cancellation_cancelled() → Cancellation {
    return Cancellation {cancelled = true}
}

# The cooperative checkpoint: when the flag is set the step REJECTS with
# Cancelata (fail closed — no silent skip); otherwise the token passes
# through unchanged (the loop continues).
@ public { }
fn observe_cancellation(Cancellation c) → Cancellation ⇥ DecodeError {
    if c.cancelled() {
        throw variant Cancelata {message = "cancellation requested"}
    }
    return c
}

# -------------------------------------------------------------------------
# replica — the deterministic replay composition (PML5-U5). A bounded
# sampling loop: each logits row is drawn via sampling.sors with the
# running history and the explicit Semen state (which advances); the drawn
# token appends to the history and the outcome list. Pure — equal inputs
# (same logits stream, config, history, seed, cancellation flag) produce
# equal token sequences. Cancellation is observed at the entry and before
# every step (the cooperative checkpoint). The model decode (logits
# production) is NOT part of this composition — U6 wires decodere_datum
# in. Sampling errors map to SamplingDefecta (the causa text preserved).
# -------------------------------------------------------------------------

@ private { }
fn _sampling_map(sampling.SamplingError e) → DecodeError {
    return variant SamplingDefecta {message = sampling.message(e)}
}

fn replica(list<list<f32>> logita, sampling.Config c, list<int> history, train.Semen seed, Cancellation cancelatum) → list<int> ⇥ DecodeError {
    observe_cancellation(cancelatum)
    var list<int> result ← vacua
    var list<int> running ← vacua
    for from history const t {
        running.append(t)
    }
    var train.Semen current ← seed
    for from logita const row {
        observe_cancellation(cancelatum)
        var sampling.Sampler outcome
        do {
            outcome ← sampling.sample(row, c, running, current)
        }
        catch err {
            throw _sampling_map(err)
        }
        const int token ← outcome.token_id()
        result.append(token)
        running.append(token)
        current ← outcome.seed()
    }
    return result
}
