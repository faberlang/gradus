+++
locale = "en"
+++
# Decode loop semantics — PML5-U1 (production inference computation layer).
#
# Public import: import from "gradus:decode" decode
# Depends on: gradus:dtype (finite), gradus:tensor (value carrier),
# gradus:nn (linear — the output projection), gradus:transformer
# (transformer_block — the SHARED forward row), gradus:cache (KVCache
# for decode_cached), gradus:sampling (sample — replay), gradus:train
# (Seed — replay RNG).
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own those). This module holds no backend or device handle and makes no
# performance claims (NGAB owns executable evidence).
#
# =========================================================================
# The decode contract (pml5-delivery.md PML5-U1)
# =========================================================================
#
# --- One-token decode over the forward row -------------------------------
# decode_data(token_id, position, decoder) is the explicit public
# one-token decode op: token id + position in → full-vocabulary logits
# out. The forward row is the PML3 shared transformer block
# (transformer.transformer_block, attention mode 2 — causal + RoPE, the
# selected inference row) over the F32 staged carrier; the decode composes
# embedding gather → block → output projection.
#
# --- Prefill and decode share the same forward functions -----------------
# prefill(tokens, decoder) runs the multi-token (teacher-forced)
# path over the SAME forward functions: the same embedding gather, the
# same transformer_block, the same output projection. The single-token
# prefill IS the decode at position 0 (probed); the first prefill
# position equals the single-token decode at position 0 (probed). The
# decode's single-token causal self-score is position-invariant under RoPE
# (the rotation of q and k by the same angles cancels in the dot product)
# — the position enters through the multi-token causal path. decode_cached
# is the one-token incremental step: attention reads/writes the layer
# KVCache so later tokens attend to the stored prefix.
#
# --- Reset / context-limit behavior (explicit) ---------------------------
# The Decoder declares its context length (context); the decode op and
# the prefill op fail closed on positions at or beyond it (reject policy —
# no silent truncation; U5 owns the full session policy). The session
# (Session) is an explicit position counter with advance (advance —
# rejects at the limit) and reset (reset — back to position 0);
# no hidden position state.
#
# --- Oracle-matching logits (GI2 contract, read-only inputs) -------------
# The logits are pinned per the GI2 numeric-contract discipline (read
# only: gi0-numeric-contract.md — full-vocab raw logits, finite gate,
# top-1 exactness on each pin row, first-divergence rule) applied to
# the gradus forward row: the decode.proba pins f64 evaluations of the
# documented forward arithmetic (the same arithmetic the transformer/
# attention/nn probas pin) with the documented 5e-4 tolerance. The GI2
# oracle itself (dequant + the 32-layer decoder in faber-runtime) is a
# read-only input to this phase, never reimplemented here.
#
# --- Evidence honesty (CTO Q2, hard) -------------------------------------
# This surface is the STRUCTURAL proof: the decode op, the prefill/decode
# sharing, and the reset/limit behavior are compile-validated and proven
# by the co-located proba (f64 oracle pins). Executed VALUE identity
# (the logits computed at runtime) is env-blocked tree-wide today (FMIR
# stepper / library-import gap — the PML4 closeout recorded both blockers;
# neither is fixed here). PML5-U1 is PARTIAL: logit-value identity is
# deferred to the auditor-owned runtime-evidence gate.
#
# =========================================================================
# PML5-U5 additions — reset, cancellation observation, deterministic replay
# =========================================================================
#
# --- Session reset (fresh state) -----------------------------------------
# reset(Session) resets an advanced session to position 0, preserving
# the context limit — the public reset. The generation cursor
# (generation.fab) wires it as the cursor reset.
#
# --- Cancellation observation points (cooperative, fail closed) ----------
# Cancellation is an explicit pure value; observe_cancellation is the
# cooperative checkpoint the generation loop calls at step boundaries. A
# set flag REJECTS with Cancelled (typed) — cancellation is observed, never
# assumed, never silently skipped. The decode/replay compositions observe
# the flag at entry and before every step.
#
# --- Deterministic replay (same seed + input -> same tokens) -------------
# replay(logits-stream, sampling Config, history, Seed, Cancellation)
# is the bounded deterministic sampling composition: per-step
# sampling.sample over the running history with the explicit advancing RNG
# state. Pure — equal inputs produce equal token sequences (probed). The
# model decode (logits production) is NOT here — U6 wires decode_data
# into the aggregate.
#
# --- No server / device handle --------------------------------------------
# This module holds no device handle, no server, no HTTP/batching
# surface — only logical state (sessions, cancellation tokens, the replay
# composition). No performance claims.
import from "gradus:cache" kv

import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

import from "gradus:nn" nn

import from "gradus:transformer" transformer

import from "gradus:sampling" sampling

import from "gradus:train" train

# -------------------------------------------------------------------------
# DecodeError — typed error vocabulary of the decode surface.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------

@ public { }
union DecodeError {
    IdOutOfRange {
        string message
    },
    InvalidPosition {
        string message
    },
    LimitReached {
        string message
    },
    InvalidDecoder {
        string message
    },
    ShapeMismatch {
        string message
    },
    DtypeMismatch {
        string message
    },
    ElementMismatch {
        string message
    },
    Incompatible {
        string message
    },
    InvalidDimension {
        string message
    },
    Cancelled {
        string message
    },
    SamplingFailure {
        string message
    }
}

@ public { }
fn message(DecodeError e) → string {
    match e {
        case IdOutOfRange const message {
            return message
        }
        case InvalidPosition const message {
            return message
        }
        case LimitReached const message {
            return message
        }
        case InvalidDecoder const message {
            return message
        }
        case ShapeMismatch const message {
            return message
        }
        case DtypeMismatch const message {
            return message
        }
        case ElementMismatch const message {
            return message
        }
        case Incompatible const message {
            return message
        }
        case InvalidDimension const message {
            return message
        }
        case Cancelled const message {
            return message
        }
        case SamplingFailure const message {
            return message
        }
    }
}

# The attention mode of the shared forward row: 2 = causal + RoPE (the
# selected inference row, transformer.fab mode contract).
const int INFERENCE_MODE ← 2

# -------------------------------------------------------------------------
# Weights — the transformer block's weights (the shared forward row's
# parameters). Mirrors the transformer_block argument order.
# -------------------------------------------------------------------------


@ public { }
class Weights {
    tensor.Tensor ln1_s
    tensor.Tensor ln1_o
    tensor.Tensor wq
    tensor.Tensor bq
    tensor.Tensor wk
    tensor.Tensor bk
    tensor.Tensor wv
    tensor.Tensor bv
    tensor.Tensor wo
    tensor.Tensor bo
    tensor.Tensor ln2_s
    tensor.Tensor ln2_o
    tensor.Tensor wf1
    tensor.Tensor bf1
    tensor.Tensor wf2
    tensor.Tensor bf2
    tensor.Tensor ln3_s
    tensor.Tensor ln3_o

    fn ln1_s() → tensor.Tensor {
        return self.ln1_s
    }

    fn ln1_o() → tensor.Tensor {
        return self.ln1_o
    }

    fn wq() → tensor.Tensor {
        return self.wq
    }

    fn bq() → tensor.Tensor {
        return self.bq
    }

    fn wk() → tensor.Tensor {
        return self.wk
    }

    fn bk() → tensor.Tensor {
        return self.bk
    }

    fn wv() → tensor.Tensor {
        return self.wv
    }

    fn bv() → tensor.Tensor {
        return self.bv
    }

    fn wo() → tensor.Tensor {
        return self.wo
    }

    fn bo() → tensor.Tensor {
        return self.bo
    }

    fn ln2_s() → tensor.Tensor {
        return self.ln2_s
    }

    fn ln2_o() → tensor.Tensor {
        return self.ln2_o
    }

    fn wf1() → tensor.Tensor {
        return self.wf1
    }

    fn bf1() → tensor.Tensor {
        return self.bf1
    }

    fn wf2() → tensor.Tensor {
        return self.wf2
    }

    fn bf2() → tensor.Tensor {
        return self.bf2
    }

    fn ln3_s() → tensor.Tensor {
        return self.ln3_s
    }

    fn ln3_o() → tensor.Tensor {
        return self.ln3_o
    }
}

# Build the block weights (the block's own fail-closed validation runs at
# call time; the decode-level invariants are the Decoder constructor's).
@ public { }
fn construct_weights(tensor.Tensor ln1_s, tensor.Tensor ln1_o, tensor.Tensor wq, tensor.Tensor bq, tensor.Tensor wk, tensor.Tensor bk, tensor.Tensor wv, tensor.Tensor bv, tensor.Tensor wo, tensor.Tensor bo, tensor.Tensor ln2_s, tensor.Tensor ln2_o, tensor.Tensor wf1, tensor.Tensor bf1, tensor.Tensor wf2, tensor.Tensor bf2, tensor.Tensor ln3_s, tensor.Tensor ln3_o) → Weights {
    return Weights {ln1_s = ln1_s, ln1_o = ln1_o, wq = wq, bq = bq, wk = wk, bk = bk, wv = wv, bv = bv, wo = wo, bo = bo, ln2_s = ln2_s, ln2_o = ln2_o, wf1 = wf1, bf1 = bf1, wf2 = wf2, bf2 = bf2, ln3_s = ln3_s, ln3_o = ln3_o}
}

# -------------------------------------------------------------------------
# Decoder — the model handle: the embedding table + the block weights +
# the output projection + the decode configuration. Gradus owns this
# logical state; no device handle. The forward row's weight-shape
# validation is the transformer_block's fail-closed contract (call time);
# this constructor validates the decode-level invariants.
# -------------------------------------------------------------------------


@ public { }
class Decoder {
    tensor.Tensor table
    Weights weights
    tensor.Tensor projection
    tensor.Tensor projection_bias
    f32 scale
    int vocabulary
    int context
    int dimension

    # The embedding table [vocab, dimension].
    fn table() → tensor.Tensor {
        return self.table
    }

    # The shared forward row's block weights.
    fn weights() → Weights {
        return self.weights
    }

    # The output projection [dimension, vocab].
    fn projection() → tensor.Tensor {
        return self.projection
    }

    # The output projection bias [vocab].
    fn projection_bias() → tensor.Tensor {
        return self.projection_bias
    }

    # The attention dk scaling factor (1/sqrt(dk)).
    fn scale() → f32 {
        return self.scale
    }

    # Vocabulary size (token-id domain [0, vocab)).
    fn vocabulary() → int {
        return self.vocabulary
    }

    # Context length (the position limit; decode fails closed at it).
    fn context() → int {
        return self.context
    }

    # Embedding dimension (the forward row's feature width).
    fn dimension() → int {
        return self.dimension
    }
}

@ public { }
fn construct_decoder(tensor.Tensor table, Weights weights, tensor.Tensor projection, tensor.Tensor projection_bias, f32 scale, int vocabulary, int context, int dimension) → Decoder ⇥ DecodeError {
    require vocabulary ≥ 1 throw variant InvalidDecoder {message = "vocabulary must be non-empty"}
    require context ≥ 1 throw variant InvalidDecoder {message = "context length must be at least one"}
    require dimension ≥ 1 throw variant InvalidDecoder {message = "embedding dimension must be at least one"}
    require dtype.finite(scale) throw variant InvalidDecoder {message = "invalid attention scale"}
    require scale ≻ 0.0 throw variant InvalidDecoder {message = "invalid attention scale"}
    const list<int> fm ← table.shape()
    require fm.length() ≡ 2 throw variant InvalidDecoder {message = "embedding must be rank-2"}
    require fm.get(0) coalesce 1 ≡ vocabulary throw variant InvalidDecoder {message = "embedding rows must equal the vocabulary"}
    require fm.get(1) coalesce 1 ≡ dimension throw variant InvalidDecoder {message = "embedding columns must equal the dimension"}
    const list<int> fp ← projection.shape()
    require fp.length() ≡ 2 throw variant InvalidDecoder {message = "output projection must be rank-2"}
    require not (fp.get(0) coalesce 1 ≠ dimension or fp.get(1) coalesce 1 ≠ vocabulary) throw variant InvalidDecoder {message = "output projection shape must be [dim, vocab]"}
    const list<int> fpb ← projection_bias.shape()
    require not (fpb.length() ≠ 1 or fpb.get(0) coalesce 1 ≠ vocabulary) throw variant InvalidDecoder {message = "output projection bias must be [vocab]"}
    return Decoder {table = table, weights = weights, projection = projection, projection_bias = projection_bias, scale = scale, vocabulary = vocabulary, context = context, dimension = dimension}
}

# Placeholder Default for `var Decoder` bindings (var on structs).
# Empty weights and an empty staged payload; not a valid decoder.
@ public { }
fn default() → Decoder {
    const tensor.Tensor t ← tensor.default()
    const Weights w ← Weights {ln1_s = t, ln1_o = t, wq = t, bq = t, wk = t, bk = t, wv = t, bv = t, wo = t, bo = t, ln2_s = t, ln2_o = t, wf1 = t, bf1 = t, wf2 = t, bf2 = t, ln3_s = t, ln3_o = t}
    return Decoder {table = t, weights = w, projection = t, projection_bias = t, scale = 0.0, vocabulary = 0, context = 0, dimension = 0}
}

# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# Staged-tensor construction (the never-firing shape check, re-mapped).
@ private { }
fn _tensor(list<f32> data, list<int> shape) → tensor.Tensor ⇥ DecodeError {
    do {
        return tensor.construct(data, shape)
    }
    catch err {
        throw variant ElementMismatch {message = tensor.message(err)}
    }
    throw variant ElementMismatch {message = "unreachable"}
}

# The embedding gather: the token's row of the embedding table, flat.
@ private { }
fn _embedding(tensor.Tensor table, int id, int dim) → list<f32> {
    var list<f32> row ← empty
    for range 0‥dim const i {
        row.append(table.data.get(id * dim + i) coalesce 0.0 ∷ f32)
    }
    return row
}

# The shared forward row: the transformer block (mode 2 — causal + RoPE)
# over the staged carrier, positions explicit.
@ private { }
fn _block(Decoder m, tensor.Tensor x, list<int> positions) → tensor.Tensor ⇥ DecodeError {
    const Weights p ← m.weights()
    do {
        return transformer.transformer_block(x, p.ln1_s(), p.ln1_o(), p.wq(), p.bq(), p.wk(), p.bk(), p.wv(), p.bv(), p.wo(), p.bo(), p.ln2_s(), p.ln2_o(), p.wf1(), p.bf1(), p.wf2(), p.bf2(), p.ln3_s(), p.ln3_o(), m.scale(), INFERENCE_MODE, positions, m.dimension())
    }
    catch err {
        const string c ← transformer.message(err)
        require c ≠ "inner dimensions mismatch" throw variant Incompatible {message = c}
        require c ≠ "dtype mismatch" throw variant DtypeMismatch {message = c}
        require c ≠ "bias does not match output width" throw variant ShapeMismatch {message = c}
        require c ≠ "unknown attention mode" throw variant InvalidDimension {message = c}
        throw variant ShapeMismatch {message = c}
    }
}

# The output projection: the block output → full-vocab logits.
@ private { }
fn _project(Decoder m, tensor.Tensor h) → tensor.Tensor ⇥ DecodeError {
    do {
        return nn.linear_carrier(h, m.projection(), m.projection_bias())
    }
    catch err {
        const string c ← nn.message(err)
        require c ≠ "inner dimensions mismatch" throw variant Incompatible {message = c}
        require c ≠ "dtype mismatch" throw variant DtypeMismatch {message = c}
        throw variant ShapeMismatch {message = c}
    }
}

# -------------------------------------------------------------------------
# decode_data — the ONE-token decode op: token id + position in →
# full-vocab logits out, over the shared forward row. Fail closed on a
# token id outside [0, vocab) and a position at or beyond the context
# limit (the reject policy — no silent truncation).
# -------------------------------------------------------------------------

@ public { }
fn decode_data(int token_id, int position, Decoder m) → tensor.Tensor ⇥ DecodeError {
    require not (token_id ≺ 0 or token_id ≥ m.vocabulary()) throw variant IdOutOfRange {message = "token id out of vocabulary range"}
    require not (position ≺ 0 or position ≥ m.context()) throw variant InvalidPosition {message = "position out of context"}
    const list<f32> row ← _embedding(m.table(), token_id, m.dimension())
    const tensor.Tensor x ← _tensor(row, [1, m.dimension()])
    const tensor.Tensor h ← _block(m, x, [position])
    const tensor.Tensor logits ← _project(m, h)
    # The [1, V] projection flattens to the full-vocab logits [V].
    return _tensor(logits.data, [m.vocabulary()])
}

# -------------------------------------------------------------------------
# decode_cached — ONE incremental decode step over the layer KVCache.
# Token id + position + cache in → full-vocab logits + updated cache.
# The new token's K/V are appended; later steps attend to the stored
# prefix. Fail-closed on the same token/position domain as decode_data.
# -------------------------------------------------------------------------

@ public { }
class DecodeStep {
    tensor.Tensor logits
    kv.KVCache state

    fn logits() → tensor.Tensor {
        return self.logits
    }

    fn state() → kv.KVCache {
        return self.state
    }
}

@ public { }
fn default_step() → DecodeStep {
    return DecodeStep {logits = tensor.default(), state = kv.default()}
}

@ private { }
fn _block_cached(Decoder m, tensor.Tensor x, list<int> positions, kv.KVCache layer, list<int> tokens) → transformer.CachedBlock ⇥ DecodeError {
    const Weights p ← m.weights()
    do {
        return transformer.transformer_block_cached(x, p.ln1_s(), p.ln1_o(), p.wq(), p.bq(), p.wk(), p.bk(), p.wv(), p.bv(), p.wo(), p.bo(), p.ln2_s(), p.ln2_o(), p.wf1(), p.bf1(), p.wf2(), p.bf2(), p.ln3_s(), p.ln3_o(), m.scale(), positions, m.dimension(), layer, tokens)
    }
    catch err {
        const string c ← transformer.message(err)
        require c ≠ "inner dimensions mismatch" throw variant Incompatible {message = c}
        require c ≠ "dtype mismatch" throw variant DtypeMismatch {message = c}
        require c ≠ "bias does not match output width" throw variant ShapeMismatch {message = c}
        throw variant ShapeMismatch {message = c}
    }
}

@ public { }
fn decode_cached(int token_id, int position, Decoder m, kv.KVCache layer) → DecodeStep ⇥ DecodeError {
    require not (token_id ≺ 0 or token_id ≥ m.vocabulary()) throw variant IdOutOfRange {message = "token id out of vocabulary range"}
    require not (position ≺ 0 or position ≥ m.context()) throw variant InvalidPosition {message = "position out of context"}
    require layer.dimension() ≡ m.dimension() throw variant ShapeMismatch {message = "cache dimension must equal the decoder dimension"}
    const list<f32> row ← _embedding(m.table(), token_id, m.dimension())
    const tensor.Tensor x ← _tensor(row, [1, m.dimension()])
    const transformer.CachedBlock block ← _block_cached(m, x, [position], layer, [token_id])
    const tensor.Tensor projected ← _project(m, block.output())
    return DecodeStep {logits = _tensor(projected.data, [m.vocabulary()]), state = block.state()}
}

# -------------------------------------------------------------------------
# prefill — the multi-token (teacher-forced) path: prompt token ids →
# full-vocab logits [N, V] over the SAME forward functions as decode.
# The prompt length must not exceed the context limit (reject policy).
# -------------------------------------------------------------------------

@ public { }
fn prefill(list<int> tokens, Decoder m) → tensor.Tensor ⇥ DecodeError {
    require tokens.length() ≠ 0 throw variant ElementMismatch {message = "empty prompt"}
    require tokens.length() ≤ m.context() throw variant InvalidPosition {message = "prompt exceeds the context limit"}
    for from tokens const t {
        require not (t ≺ 0 or t ≥ m.vocabulary()) throw variant IdOutOfRange {message = "token id out of vocabulary range"}
    }
    var list<f32> flat ← empty
    for from tokens const t {
        const list<f32> row ← _embedding(m.table(), t, m.dimension())
        for from row const v {
            flat.append(v)
        }
    }
    const tensor.Tensor x ← _tensor(flat, [tokens.length(), m.dimension()])
    var list<int> positions ← empty
    for range 0‥tokens.length() const i {
        positions.append(i)
    }
    const tensor.Tensor h ← _block(m, x, positions)
    return _project(m, h)
}

# -------------------------------------------------------------------------
# Session — the explicit session position state. Reset and the context
# limit are explicit public behaviors: advance rejects at the limit,
# reset resets to position 0. No hidden position state.
# -------------------------------------------------------------------------


@ public { }
class Session {
    int position
    int context

    # The next decode position.
    fn position() → int {
        return self.position
    }

    # The session's context limit.
    fn context() → int {
        return self.context
    }
}

# A fresh session at position 0 with the declared context limit.
@ public { }
fn fresh_session(int context) → Session ⇥ DecodeError {
    require context ≥ 1 throw variant InvalidDecoder {message = "context length must be at least one"}
    return Session {position = 0, context = context}
}

# Placeholder Default for `var Session` bindings (var on structs).
# Zero context (not a valid session). Only a placeholder the caller
# overwrites, or returns from an unreachable cape arm.
@ public { }
fn default_session() → Session {
    return Session {position = 0, context = 0}
}

# Advance the session by one position — rejects when the next position
# would be at or beyond the context limit (the limit is reached).
@ public { }
fn advance(Session s) → Session ⇥ DecodeError {
    require s.position() + 1 ≺ s.context() throw variant LimitReached {message = "context limit reached"}
    return Session {position = s.position() + 1, context = s.context()}
}

# Reset the session to position 0 (fresh state).
@ public { }
fn reset(Session s) → Session {
    return Session {position = 0, context = s.context()}
}

# -------------------------------------------------------------------------
# Cancellation observation — the cooperative checkpoint (PML5-U5).
# Cancellation is an explicit pure value the generation loop owns; the
# observation point (observe_cancellation) is the cooperative check the
# loop calls at step boundaries. Cancellation is cooperative and fail
# closed: the flag is observed, never assumed, and a set flag rejects with
# a typed Cancelled — no silent mid-decode abort, no ignored cancellation.
# -------------------------------------------------------------------------


@ public { }
class Cancellation {
    bool cancelled

    # The cancellation flag (true = cancellation requested).
    fn cancelled() → bool {
        return self.cancelled
    }
}

# A fresh (not cancelled) cancellation token.
@ public { }
fn fresh_cancellation() → Cancellation {
    return Cancellation {cancelled = false}
}

# A cancellation-requested token.
@ public { }
fn cancellation_cancelled() → Cancellation {
    return Cancellation {cancelled = true}
}

# The cooperative checkpoint: when the flag is set the step REJECTS with
# Cancelled (fail closed — no silent skip); otherwise the token passes
# through unchanged (the loop continues).
@ public { }
fn observe_cancellation(Cancellation c) → Cancellation ⇥ DecodeError {
    require not c.cancelled() throw variant Cancelled {message = "cancellation requested"}
    return c
}

# -------------------------------------------------------------------------
# replay — the deterministic replay composition (PML5-U5). A bounded
# sampling loop: each logits row is drawn via sampling.sample with the
# running history and the explicit Seed state (which advances); the drawn
# token appends to the history and the outcome list. Pure — equal inputs
# (same logits stream, config, history, seed, cancellation flag) produce
# equal token sequences. Cancellation is observed at the entry and before
# every step (the cooperative checkpoint). The model decode (logits
# production) is NOT part of this composition — U6 wires decode_data
# in. Sampling errors map to SamplingFailure (the message text preserved).
# -------------------------------------------------------------------------

@ private { }
fn _sampling_map(sampling.SamplingError e) → DecodeError {
    return variant SamplingFailure {message = sampling.message(e)}
}

@ public { }
fn replay(list<list<f32>> logit_rows, sampling.Config c, list<int> history, train.Seed seed, Cancellation cancellation) → list<int> ⇥ DecodeError {
    observe_cancellation(cancellation)
    var list<int> result ← empty
    var list<int> running ← empty
    for from history const t {
        running.append(t)
    }
    var train.Seed current ← seed
    for from logit_rows const row {
        observe_cancellation(cancellation)
        var sampling.Sampler outcome ← sampling.default()
        do {
            outcome ← sampling.sample(row, c, running, current)
        }
        catch err {
            throw _sampling_map(err)
        }
        const int token ← outcome.token_id()
        result.append(token)
        running.append(token)
        current ← outcome.seed()
    }
    return result
}
