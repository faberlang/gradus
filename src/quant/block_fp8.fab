                    acc ← acc + (w * s) * x[[b_idx, j]]
                }

                y[[b_idx, row]] ← acc
            }
        }
    }
}

@ public
kernel routed_expert_matmul_u32<size B, size E, size Out, size PackedIn, size ScaleRows, size ScaleCols, size In>(tensor<u32, [E, Out, PackedIn]> weight, tensor<u8, [E, ScaleRows, ScaleCols]> scales, tensor<f32, [B, In]> x, tensor<i32, [B]> expert_indices, mut tensor<f32, [B, Out]> y, i32 block_rows, i32 block_cols) → void {
    for from y at [b_idx, row] thread lane let e {
        if block_rows ≥ 1 and block_rows ≤ 4096 and block_cols ≥ 1 and block_cols ≤ 4096 {
            let i32 ee ← expert_indices[[b_idx]]
            if ee ≥ 0 and ee ≺ E {
                let i32 sr ← row / block_rows
                mut f32 acc ← 0.0 ∷ f32

                for exclusive In let j {
                    let i32 sc ← j / block_cols
                    let i32 word_idx ← j / 4
                    let i32 byte_lane ← j % 4
                    let u32 w0 ← weight[[ee, row, word_idx]]
                    mut u32 raw_bits ← 0 ∷ u32

                    if byte_lane ≡ 0 {
                        raw_bits ← w0 ∧ (255 ∷ u32)
                    }
                    elif byte_lane ≡ 1 {
                        raw_bits ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                    }
                    elif byte_lane ≡ 2 {
                        raw_bits ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                    }
                    else {
                        raw_bits ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)
                    }

                    let i32 wb ← raw_bits ↦ wrapping<i32>
                    let i32 w_sign ← (wb ⇒ 7) ∧ 1
                    let i32 w_exp ← (wb ⇒ 3) ∧ 15
                    let i32 w_mant ← wb ∧ 7
                    mut f32 w ← 0.0 ∷ f32

                    if w_exp ≡ 15 and w_mant ≡ 7 {
                        w ← (0.0 ∷ f32) / (0.0 ∷ f32)
                    }
                    else {
                        if w_exp ≡ 0 {
                            w ← (w_mant ↦ f32) * (0.001953125 ∷ f32)
                        }
                        else {
                            mut f32 pow2 ← 0.0078125 ∷ f32
                            if (w_exp ∧ 1) ≢ 0 {
                                pow2 ← pow2 * (2.0 ∷ f32)
                            }
                            if (w_exp ∧ 2) ≢ 0 {
                                pow2 ← pow2 * (4.0 ∷ f32)
                            }
                            if (w_exp ∧ 4) ≢ 0 {
                                pow2 ← pow2 * (16.0 ∷ f32)
                            }
                            if (w_exp ∧ 8) ≢ 0 {
                                pow2 ← pow2 * (256.0 ∷ f32)
                            }
                            let f32 frac ← (1.0 ∷ f32) + (w_mant ↦ f32) * (0.125 ∷ f32)
                            w ← pow2 * frac
                        }

                        if w_sign ≡ 1 {
                            w ← -w
                        }
                    }

                    let i32 se ← scales[[ee, sr, sc]] ↦ i32
                    mut f32 s ← 1.0 ∷ f32

                    if se ≡ 255 {
                        s ← (0.0 ∷ f32) / (0.0 ∷ f32)
                    }
                    elif se ≥ 127 {
                        let i32 diff ← se - 127
                        let f32 p1 ← 2.0 ∷ f32
                        let f32 p2 ← p1 * p1
                        let f32 p4 ← p2 * p2
                        let f32 p8 ← p4 * p4
                        let f32 p16 ← p8 * p8
                        let f32 p32 ← p16 * p16
                        let f32 p64 ← p32 * p32

                        if (diff ∧ 1) ≢ 0 {
                            s ← s * p1
                        }
                        if (diff ∧ 2) ≢ 0 {
                            s ← s * p2
                        }
                        if (diff ∧ 4) ≢ 0 {
                            s ← s * p4
                        }
                        if (diff ∧ 8) ≢ 0 {
                            s ← s * p8
                        }
                        if (diff ∧ 16) ≢ 0 {
                            s ← s * p16
                        }
                        if (diff ∧ 32) ≢ 0 {
                            s ← s * p32
                        }
                        if (diff ∧ 64) ≢ 0 {
                            s ← s * p64
                        }
                    }
                    else {
                        let i32 diff ← 127 - se
                        let f32 n1 ← 0.5 ∷ f32
                        let f32 n2 ← n1 * n1
                        let f32 n4 ← n2 * n2
                        let f32 n8 ← n4 * n4
                        let f32 n16 ← n8 * n8
                        let f32 n32 ← n16 * n16
                        let f32 n64 ← n32 * n32

                        if (diff ∧ 1) ≢ 0 {
                            s ← s * n1
                        }
                        if (diff ∧ 2) ≢ 0 {
                            s ← s * n2
                        }
                        if (diff ∧ 4) ≢ 0 {
                            s ← s * n4
                        }
                        if (diff ∧ 8) ≢ 0 {
                            s ← s * n8
                        }
                        if (diff ∧ 16) ≢ 0 {
                            s ← s * n16
                        }
                        if (diff ∧ 32) ≢ 0 {
                            s ← s * n32
                        }
                        if (diff ∧ 64) ≢ 0 {
                            s ← s * n64
                        }
                    }

                    acc ← acc + (w * s) * x[[b_idx, j]]
                }

                y[[b_idx, row]] ← acc
            }
        }
    }
}

