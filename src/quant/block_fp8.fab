                            if (w_exp ∧ 1) ≢ 0 {
                                pow2 ← pow2 * (2.0 ∷ f32)
                            }
                            if (w_exp ∧ 2) ≢ 0 {
                                pow2 ← pow2 * (4.0 ∷ f32)
                            }
                            if (w_exp ∧ 4) ≢ 0 {
                                pow2 ← pow2 * (16.0 ∷ f32)
                            }
                            if (w_exp ∧ 8) ≢ 0 {
                                pow2 ← pow2 * (256.0 ∷ f32)
                            }
                            let f32 frac ← (1.0 ∷ f32) + (w_mant ↦ f32) * (0.125 ∷ f32)
                            w ← pow2 * frac
                        }

                        if w_sign ≡ 1 {
                            w ← -w
                        }
                    }

                    let f32 s ← scales[[ee, sr, sc]]
                    acc ← acc + (w * s) * x[[b_idx, j]]
                }

                y[[b_idx, row]] ← acc
            }
        }
    }
}

+++ faber test
import from "gradus:quant/block_fp8" let bf8

fn close(f32 a, f32 b) → bool {
    let f32 diff ← (a - b).abs()
    let f32 tol ← (1.0e-5 ∷ f32) + (1.0e-4 ∷ f32) * b.abs()
    return diff ≤ tol
}

fn spec_result(int o, int i, int br, int bc, bf8.PackKind p) → string {
    do {
        bf8.admit_spec(o, i, br, bc, p)
        return "ok"
    }
    catch err {
        return err.message
    }
}

test "BlockFp8 spec validates shape and block divisibility fail-closed" {
    assert spec_result(4, 16, 1, 4, variant bf8.PackKind.PackU8) ≡ "ok"
    assert spec_result(4, 16, 2, 4, variant bf8.PackKind.PackU32) ≡ "ok"
    assert spec_result(3, 16, 2, 4, variant bf8.PackKind.PackU8) ≡ "out_features must be divisible by block_rows"
    assert spec_result(4, 15, 1, 4, variant bf8.PackKind.PackU8) ≡ "in_features must be divisible by block_cols"
    assert spec_result(4, 6, 1, 3, variant bf8.PackKind.PackU32) ≡ "in_features must be divisible by 4 for u32 packing"
}

test "BlockFp8 raw u8 (MXFP8 2D block) ref decode and kernel matvec match" {
    # Out=2, In=8, block_rows=2, block_cols=4 -> ScaleRows=1, ScaleCols=2
    # scales: [128 (2.0), 126 (0.5)]
    # Row 0: [0x38 (1.0), 0xBC (-1.5), 0x01 (2^-9), 0x40 (2.0), 0x38 (1.0), 0xB8 (-1.0), 0x44 (3.0), 0x80 (-0.0)]
    # Row 1: [0xC0 (-2.0), 0x3C (1.5), 0x00 (0.0), 0x48 (4.0), 0xC4 (-3.0), 0x30 (0.5), 0x4E (7.0), 0xB0 (-0.5)]
    let list<u8> w_list ← [
        0x38 ∷ u8, 0xbc ∷ u8, 0x01 ∷ u8, 0x40 ∷ u8,
        0x38 ∷ u8, 0xb8 ∷ u8, 0x44 ∷ u8, 0x80 ∷ u8,
        0xc0 ∷ u8, 0x3c ∷ u8, 0x00 ∷ u8, 0x48 ∷ u8,
        0xc4 ∷ u8, 0x30 ∷ u8, 0x4e ∷ u8, 0xb0 ∷ u8
    ]
    let list<u8> s_list ← [128 ∷ u8, 126 ∷ u8]
    let list<f32> x_list ← [1.0, -2.0, 4.0, 0.5, -1.0, 2.0, 0.25, -3.0]

    do {
        let bf8.BlockFp8Spec spec ← bf8.admit_spec(2, 8, 2, 4, variant bf8.PackKind.PackU8)
        let list<f32> w_dense ← bf8.ref_dequantize_u8(spec, w_list, s_list)
        let list<f32> y_ref ← bf8.ref_matvec(2, 8, w_dense, x_list)

        mut tensor<u8, [2, 8]> w_t ← tu8[2, 8] {}
        for exclusive 2 let r {
            for exclusive 8 let c {
                w_t[[r, c]] ← w_list[r * 8 + c]
            }
        }
        mut tensor<u8, [1, 2]> s_t ← tu8[1, 2] {}
        s_t[[0, 0]] ← 128 ∷ u8
        s_t[[0, 1]] ← 126 ∷ u8
        mut tensor<f32, [8]> x_t ← tf32[8] {}
        for exclusive 8 let j {
            x_t[[j]] ← x_list[j]
        }
        mut tensor<f32, [2]> y_k ← tf32[2] {}

        bf8.linear_matvec_u8(w_t, s_t, x_t, mut y_k, 2, 4)
        assert close(y_k[[0]], y_ref[0])
        assert close(y_k[[1]], y_ref[1])
    }
    catch err {
        assert false
    }
}

test "BlockFp8 MLX-converted u32 (Inkling L20-23) ref decode and kernel matvec match" {
    # Out=2, In=8, group_size=4 (Br=1, Bc=4) -> PackedIn=2 u32s, ScaleRows=2, ScaleCols=2
    let u32 r0w0 ← 0x4001bc38 ∷ u32
    let u32 r0w1 ← 0x8044b838 ∷ u32
    let u32 r1w0 ← 0x48003cc0 ∷ u32
    let u32 r1w1 ← 0xb04e30c4 ∷ u32
    let list<u32> w_list ← [r0w0, r0w1, r1w0, r1w1]
    let list<u8> s_list ← [128 ∷ u8, 126 ∷ u8, 127 ∷ u8, 129 ∷ u8]
    let list<f32> x_list ← [1.0, -2.0, 4.0, 0.5, -1.0, 2.0, 0.25, -3.0]

    do {
        let bf8.BlockFp8Spec spec ← bf8.admit_group_spec(2, 8, 4, variant bf8.PackKind.PackU32)
        let list<f32> w_dense ← bf8.ref_dequantize_u32(spec, w_list, s_list)
        let list<f32> y_ref ← bf8.ref_matvec(2, 8, w_dense, x_list)

        mut tensor<u32, [2, 2]> w_t ← tu32[2, 2] {}
        w_t[[0, 0]] ← r0w0
        w_t[[0, 1]] ← r0w1
        w_t[[1, 0]] ← r1w0
        w_t[[1, 1]] ← r1w1
        mut tensor<u8, [2, 2]> s_t ← tu8[2, 2] {}
        s_t[[0, 0]] ← 128 ∷ u8
        s_t[[0, 1]] ← 126 ∷ u8
        s_t[[1, 0]] ← 127 ∷ u8
        s_t[[1, 1]] ← 129 ∷ u8
        mut tensor<f32, [8]> x_t ← tf32[8] {}
        for exclusive 8 let j {
            x_t[[j]] ← x_list[j]
        }
        mut tensor<f32, [2]> y_k ← tf32[2] {}

        bf8.linear_matvec_u32(w_t, s_t, x_t, mut y_k, 1, 4)
        assert close(y_k[[0]], y_ref[0])
        assert close(y_k[[1]], y_ref[1])
    }
    catch err {
        assert false
    }
}

test "BlockFp8 u8 and u32 kernels handle rows above 65536 without aliasing" {
    # Out=65540 (> 65536), In=4, block_rows=2, block_cols=4 -> ScaleRows=32770, ScaleCols=1
    mut tensor<u8, [65540, 4]> w_u8 ← tu8[65540, 4] {}
    w_u8[[1, 0]] ← 0x38 ∷ u8
    w_u8[[65537, 0]] ← 0x40 ∷ u8
    w_u8[[65537, 1]] ← 0x40 ∷ u8
    w_u8[[65537, 2]] ← 0x40 ∷ u8
    w_u8[[65537, 3]] ← 0x40 ∷ u8

    mut tensor<u32, [65540, 1]> w_u32 ← tu32[65540, 1] {}
    w_u32[[1, 0]] ← 0x00000038 ∷ u32
    w_u32[[65537, 0]] ← 0x40404040 ∷ u32

    mut tensor<u8, [32770, 1]> scales ← tu8[32770, 1] {}
    scales[[0, 0]] ← 127 ∷ u8
    scales[[32768, 0]] ← 128 ∷ u8

    mut tensor<f32, [4]> x_t ← tf32[4] {}
    for exclusive 4 let j {
        x_t[[j]] ← 1.0 ∷ f32
    }

    mut tensor<f32, [65540]> y_u8 ← tf32[65540] {}
    mut tensor<f32, [65540]> y_u32 ← tf32[65540] {}

    bf8.linear_matvec_u8(w_u8, scales, x_t, mut y_u8, 2, 4)
    bf8.linear_matvec_u32(w_u32, scales, x_t, mut y_u32, 2, 4)

    assert close(y_u8[[0]], 0.0 ∷ f32)
    assert close(y_u8[[1]], 1.0 ∷ f32)
    assert close(y_u8[[65537]], 16.0 ∷ f32)

    assert close(y_u32[[0]], 0.0 ∷ f32)
    assert close(y_u32[[1]], 1.0 ∷ f32)
    assert close(y_u32[[65537]], 16.0 ∷ f32)

    mut tensor<f32, [2, 4]> x_mat ← tf32[2, 4] {}
    for exclusive 4 let j {
        x_mat[[0, j]] ← 1.0 ∷ f32
        x_mat[[1, j]] ← 2.0 ∷ f32
    }

    mut tensor<f32, [2, 65540]> y_mm_u8 ← tf32[2, 65540] {}
    mut tensor<f32, [2, 65540]> y_mm_u32 ← tf32[2, 65540] {}
    bf8.linear_matmul_u8(w_u8, scales, x_mat, mut y_mm_u8, 2, 4)
    bf8.linear_matmul_u32(w_u32, scales, x_mat, mut y_mm_u32, 2, 4)

    assert close(y_mm_u8[[0, 1]], 1.0 ∷ f32)
    assert close(y_mm_u8[[1, 65537]], 32.0 ∷ f32)
    assert close(y_mm_u32[[0, 1]], 1.0 ∷ f32)
    assert close(y_mm_u32[[1, 65537]], 32.0 ∷ f32)

    mut tensor<f32, [32770, 1]> f32_scales ← tf32[32770, 1] {}
    f32_scales[[0, 0]] ← 1.0 ∷ f32
    f32_scales[[32768, 0]] ← 2.0 ∷ f32

    mut tensor<f32, [65540]> y_mv_u8_f32 ← tf32[65540] {}
    mut tensor<f32, [2, 65540]> y_mm_u8_f32 ← tf32[2, 65540] {}
    mut tensor<f32, [65540]> y_mv_u32_f32 ← tf32[65540] {}
    mut tensor<f32, [2, 65540]> y_mm_u32_f32 ← tf32[2, 65540] {}
    mut tensor<f32, [65540]> y_mv_unscaled ← tf32[65540] {}
    mut tensor<f32, [2, 65540]> y_mm_unscaled ← tf32[2, 65540] {}

    bf8.linear_matvec_u8_f32_scales(w_u8, f32_scales, x_t, mut y_mv_u8_f32, 2, 4)
    bf8.linear_matmul_u8_f32_scales(w_u8, f32_scales, x_mat, mut y_mm_u8_f32, 2, 4)
    bf8.linear_matvec_u32_f32_scales(w_u32, f32_scales, x_t, mut y_mv_u32_f32, 2, 4)
    bf8.linear_matmul_u32_f32_scales(w_u32, f32_scales, x_mat, mut y_mm_u32_f32, 2, 4)
    bf8.linear_matvec_u8_unscaled(w_u8, x_t, mut y_mv_unscaled)
    bf8.linear_matmul_u8_unscaled(w_u8, x_mat, mut y_mm_unscaled)

    assert close(y_mv_u8_f32[[65537]], 16.0 ∷ f32)
    assert close(y_mm_u8_f32[[1, 65537]], 32.0 ∷ f32)
    assert close(y_mv_u32_f32[[65537]], 16.0 ∷ f32)
    assert close(y_mm_u32_f32[[1, 65537]], 32.0 ∷ f32)
    assert close(y_mv_unscaled[[1]], 1.0 ∷ f32)
    assert close(y_mm_unscaled[[1, 65537]], 16.0 ∷ f32)

    mut tensor<u8, [2, 2, 4]> e_w_u8 ← tu8[2, 2, 4] {}
    mut tensor<u32, [2, 2, 1]> e_w_u32 ← tu32[2, 2, 1] {}
    mut tensor<u8, [2, 1, 1]> e_s_u8 ← tu8[2, 1, 1] {}
    mut tensor<f32, [2, 1, 1]> e_s_f32 ← tf32[2, 1, 1] {}
    e_w_u8[[1, 0, 0]] ← 0x38 ∷ u8
    e_w_u8[[1, 1, 0]] ← 0x40 ∷ u8
    e_w_u32[[1, 0, 0]] ← 0x00000038 ∷ u32
    e_w_u32[[1, 1, 0]] ← 0x00000040 ∷ u32
    e_s_u8[[0, 0, 0]] ← 127 ∷ u8
    e_s_u8[[1, 0, 0]] ← 128 ∷ u8
    e_s_f32[[0, 0, 0]] ← 1.0 ∷ f32
    e_s_f32[[1, 0, 0]] ← 2.0 ∷ f32

    mut tensor<i32, [2]> experts ← ti32[2] {}
    experts[[0]] ← 0 ∷ i32
    experts[[1]] ← 1 ∷ i32
    mut tensor<f32, [2]> e_y_mv_u8 ← tf32[2] {}
    mut tensor<f32, [2]> e_y_mv_u32 ← tf32[2] {}
    mut tensor<f32, [2]> e_y_mv_u8_f32 ← tf32[2] {}
    mut tensor<f32, [2]> e_y_mv_u32_f32 ← tf32[2] {}
    mut tensor<f32, [2]> e_y_mv_unscaled ← tf32[2] {}
    mut tensor<f32, [2, 2]> e_y_mm_u8 ← tf32[2, 2] {}
    mut tensor<f32, [2, 2]> e_y_mm_u32 ← tf32[2, 2] {}
    mut tensor<f32, [2, 2]> e_y_mm_u8_f32 ← tf32[2, 2] {}
    mut tensor<f32, [2, 2]> e_y_mm_u32_f32 ← tf32[2, 2] {}
    mut tensor<f32, [2, 2]> e_y_mm_unscaled ← tf32[2, 2] {}

    bf8.routed_expert_matvec_u8(e_w_u8, e_s_u8, x_t, mut e_y_mv_u8, 1, 2, 4)
    bf8.routed_expert_matvec_u32(e_w_u32, e_s_u8, x_t, mut e_y_mv_u32, 1, 2, 4)
    bf8.routed_expert_matvec_u8_f32_scales(e_w_u8, e_s_f32, x_t, mut e_y_mv_u8_f32, 1, 2, 4)
    bf8.routed_expert_matvec_u32_f32_scales(e_w_u32, e_s_f32, x_t, mut e_y_mv_u32_f32, 1, 2, 4)
    bf8.routed_expert_matvec_u8_unscaled(e_w_u8, x_t, mut e_y_mv_unscaled, 1)
    bf8.routed_expert_matmul_u8(e_w_u8, e_s_u8, x_mat, experts, mut e_y_mm_u8, 2, 4)
    bf8.routed_expert_matmul_u32(e_w_u32, e_s_u8, x_mat, experts, mut e_y_mm_u32, 2, 4)
    bf8.routed_expert_matmul_u8_f32_scales(e_w_u8, e_s_f32, x_mat, experts, mut e_y_mm_u8_f32, 2, 4)
    bf8.routed_expert_matmul_u32_f32_scales(e_w_u32, e_s_f32, x_mat, experts, mut e_y_mm_u32_f32, 2, 4)
    bf8.routed_expert_matmul_u8_unscaled(e_w_u8, x_mat, experts, mut e_y_mm_unscaled)

    assert close(e_y_mv_u8[[0]], 2.0 ∷ f32)
    assert close(e_y_mv_u8[[1]], 4.0 ∷ f32)
    assert close(e_y_mv_u32[[0]], 2.0 ∷ f32)
    assert close(e_y_mv_u32[[1]], 4.0 ∷ f32)
    assert close(e_y_mv_u8_f32[[0]], 2.0 ∷ f32)
    assert close(e_y_mv_u32_f32[[1]], 4.0 ∷ f32)
    assert close(e_y_mv_unscaled[[0]], 1.0 ∷ f32)
    assert close(e_y_mm_u8[[1, 0]], 4.0 ∷ f32)
    assert close(e_y_mm_u32[[1, 1]], 8.0 ∷ f32)
    assert close(e_y_mm_u8_f32[[1, 0]], 4.0 ∷ f32)
    assert close(e_y_mm_u32_f32[[1, 1]], 8.0 ∷ f32)
    assert close(e_y_mm_unscaled[[1, 1]], 4.0 ∷ f32)
}

test "BlockFp8 batched ref_matmul, f32-scale, unscaled, and 3D expert-slice decode match" {
    let list<u8> w_u8 ← [
        0x38 ∷ u8, 0x40 ∷ u8, 0x3c ∷ u8, 0x00 ∷ u8,
        0xb8 ∷ u8, 0x30 ∷ u8, 0x44 ∷ u8, 0x00 ∷ u8,
        0x38 ∷ u8, 0x38 ∷ u8, 0x00 ∷ u8, 0x00 ∷ u8,
        0x40 ∷ u8, 0x40 ∷ u8, 0x00 ∷ u8, 0x00 ∷ u8
    ]
    let list<u32> w_u32 ← [
        0x003c4038 ∷ u32,
        0x004430b8 ∷ u32,
        0x00003838 ∷ u32,
        0x00004040 ∷ u32
    ]
    let list<u8> s_u8 ← [128 ∷ u8, 127 ∷ u8, 126 ∷ u8, 128 ∷ u8]
    let list<f32> s_f32 ← [2.0 ∷ f32, 1.0 ∷ f32, 0.5 ∷ f32, 2.0 ∷ f32]
    let list<f32> x_mat ← [
        1.0, 2.0, -1.0, 3.0,
        0.5, -1.0, 2.0, 1.0
    ]

    do {
        let bf8.BlockFp8Spec spec_u8 ← bf8.admit_spec(4, 4, 2, 2, variant bf8.PackKind.PackU8)
        let bf8.BlockFp8Spec spec_u32 ← bf8.admit_spec(4, 4, 2, 2, variant bf8.PackKind.PackU32)
        let list<f32> d_u8 ← bf8.ref_dequantize_u8(spec_u8, w_u8, s_u8)
        let list<f32> d_u8_f32 ← bf8.ref_dequantize_u8_f32(spec_u8, w_u8, s_f32)
        let list<f32> d_u32 ← bf8.ref_dequantize_u32(spec_u32, w_u32, s_u8)
        let list<f32> d_u32_f32 ← bf8.ref_dequantize_u32_f32(spec_u32, w_u32, s_f32)
        for exclusive d_u8.length() let i {
            assert close(d_u8[i], d_u8_f32[i])
            assert close(d_u8[i], d_u32[i])
            assert close(d_u8[i], d_u32_f32[i])
        }

        let list<f32> y_mm ← bf8.ref_matmul(2, 4, 4, d_u8, x_mat)
        assert close(y_mm[0], 8.5)
        assert close(y_mm[1], -3.0)
        assert close(y_mm[2], 1.5)
        assert close(y_mm[3], 3.0)
        assert close(y_mm[7], -0.5)

        let list<f32> d_unscaled ← bf8.ref_dequantize_u8_unscaled(4, 4, w_u8)
        let list<f32> y_unscaled ← bf8.ref_matmul(2, 4, 4, d_unscaled, x_mat)
        assert close(y_unscaled[0], 3.5)
        assert close(y_unscaled[7], -1.0)
    }
    catch err {
        assert false
    }
}
