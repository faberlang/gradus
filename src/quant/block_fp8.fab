+++ toml
locale = "en"

+++ faber
# BlockFp8 (MXFP8) — block-scaled FP8 E4M3FN with UE8M0 scales (issue #105).
#
# Public import: import from "gradus:quant/block_fp8" let block_fp8
#
# --- Contract ------------------------------------------------------------
#
# Rule-17 pure-Faber representation (zero compiler format tables):
#   * Raw encoding:
#       - `weight`: `u8` E4M3FN bytes `[Out, In]`
#       - `scales`: `u8` UE8M0 block scales `[Out / Br, In / Bc]`
#         (per-group `[Out, In / G]` is `Br = 1, Bc = G`)
#   * MLX-converted encoding (Inkling L20-23):
#       - `weight`: `u32` packed 4x E4M3FN bytes `[Out, In / 4]`
#       - `scales`: `u8` UE8M0 block scales `[Out / Br, In / Bc]`
#   * Dequantize: `w[r, j] = fp8_e4m3(weight[r, j]) * ue8m0(scales[r / Br, j / Bc])`

import from "gradus:quant/fp_primitives" let fp

@ public
union BlockFp8Error {
    @ shared
    string message

    BadConfig,
    BadShape,
    BadPack
}

@ public
union PackKind {
    PackU8,
    PackU32
}

@ public
class BlockFp8Spec {
    let int out_features
    let int in_features
    let int block_rows
    let int block_cols
    let PackKind pack
    let int packed_cols
    let int scale_rows
    let int scale_cols
}

@ public
fn admit_spec(int out_features, int in_features, int block_rows, int block_cols, PackKind pack) → BlockFp8Spec ⇥ BlockFp8Error {
    require out_features ≥ 1 throw variant BadShape { message = "out_features must be at least 1" }
    require in_features ≥ 1 throw variant BadShape { message = "in_features must be at least 1" }
    require block_rows ≥ 1 throw variant BadConfig { message = "block_rows must be at least 1" }
    require block_cols ≥ 1 throw variant BadConfig { message = "block_cols must be at least 1" }
    require out_features % block_rows ≡ 0 throw variant BadShape { message = "out_features must be divisible by block_rows" }
    require in_features % block_cols ≡ 0 throw variant BadShape { message = "in_features must be divisible by block_cols" }

    mut int packed_cols ← in_features

    match pack {
        case PackU8 {
            packed_cols ← in_features
        }
        case PackU32 {
            require in_features % 4 ≡ 0 throw variant BadShape { message = "in_features must be divisible by 4 for u32 packing" }
            packed_cols ← in_features / 4
        }
    }

    let int scale_rows ← out_features / block_rows
    let int scale_cols ← in_features / block_cols
    return BlockFp8Spec {
        out_features = out_features,
        in_features = in_features,
        block_rows = block_rows,
        block_cols = block_cols,
        pack = pack,
        packed_cols = packed_cols,
        scale_rows = scale_rows,
        scale_cols = scale_cols
    }
}

@ public
fn admit_group_spec(int out_features, int in_features, int group_size, PackKind pack) → BlockFp8Spec ⇥ BlockFp8Error {
    return admit_spec(out_features, in_features, 1, group_size, pack)
}

# -------------------------------------------------------------------------
# Typed host reference decode and GEMV
# -------------------------------------------------------------------------

fn ue8m0_list_to_f32(list<u8> scales) → list<f32> {
    mut list<f32> out ← empty

    for from scales let b {
        out.append(fp.ue8m0(b))
    }

    return out
}

fn dequantize_u8_with_f32_scales(BlockFp8Spec spec, list<u8> weight, list<f32> scales) → list<f32> ⇥ BlockFp8Error {
    match spec.pack {
        case PackU8 {
            pass
        }
        default {
            throw variant BadPack { message = "expected PackU8 spec" }
        }
    }

    require weight.length() ≡ spec.out_features * spec.packed_cols throw variant BadShape { message = "weight length mismatch" }
    require scales.length() ≡ spec.scale_rows * spec.scale_cols throw variant BadShape { message = "scales length mismatch" }

    mut list<f32> out ← empty

    for exclusive spec.out_features let r {
        let int sr ← r / spec.block_rows
        let int w_base ← r * spec.packed_cols
        let int s_base ← sr * spec.scale_cols

        for exclusive spec.in_features let j {
            let int sc ← j / spec.block_cols
            let f32 w ← fp.fp8_e4m3(weight[w_base + j])
            let f32 s ← scales[s_base + sc]
            out.append(w * s)
        }
    }

    return out
}

fn dequantize_u32_with_f32_scales(BlockFp8Spec spec, list<u32> weight, list<f32> scales) → list<f32> ⇥ BlockFp8Error {
    match spec.pack {
        case PackU32 {
            pass
        }
        default {
            throw variant BadPack { message = "expected PackU32 spec" }
        }
    }

    require weight.length() ≡ spec.out_features * spec.packed_cols throw variant BadShape { message = "weight length mismatch" }
    require scales.length() ≡ spec.scale_rows * spec.scale_cols throw variant BadShape { message = "scales length mismatch" }

    mut list<f32> out ← empty

    for exclusive spec.out_features let r {
        let int sr ← r / spec.block_rows
        let int w_base ← r * spec.packed_cols
        let int s_base ← sr * spec.scale_cols

        for exclusive spec.in_features let j {
            let int word_idx ← j / 4
            let int shift ← (j % 4) * 8
            let int word ← weight[w_base + word_idx] ↦ int
            let u8 raw_w ← ((word ⇒ shift) ∧ 255) ↦ wrapping<u8>
            let int sc ← j / spec.block_cols
            let f32 w ← fp.fp8_e4m3(raw_w)
            let f32 s ← scales[s_base + sc]
            out.append(w * s)
        }
    }

    return out
}

@ public
fn ref_dequantize_u8(BlockFp8Spec spec, list<u8> weight, list<u8> scales) → list<f32> ⇥ BlockFp8Error {
    return dequantize_u8_with_f32_scales(spec, weight, ue8m0_list_to_f32(scales))
}

@ public
fn ref_dequantize_u8_f32(BlockFp8Spec spec, list<u8> weight, list<f32> scales) → list<f32> ⇥ BlockFp8Error {
    return dequantize_u8_with_f32_scales(spec, weight, scales)
}

@ public
fn ref_dequantize_u8_unscaled(int out_features, int in_features, list<u8> weight) → list<f32> ⇥ BlockFp8Error {
    let BlockFp8Spec spec ← admit_spec(out_features, in_features, out_features, in_features, variant PackKind.PackU8)
    let list<f32> unit ← [1.0 ∷ f32]
    return dequantize_u8_with_f32_scales(spec, weight, unit)
}

@ public
fn ref_dequantize_u32(BlockFp8Spec spec, list<u32> weight, list<u8> scales) → list<f32> ⇥ BlockFp8Error {
    return dequantize_u32_with_f32_scales(spec, weight, ue8m0_list_to_f32(scales))
}

@ public
fn ref_dequantize_u32_f32(BlockFp8Spec spec, list<u32> weight, list<f32> scales) → list<f32> ⇥ BlockFp8Error {
    return dequantize_u32_with_f32_scales(spec, weight, scales)
}

@ public
fn ref_matvec(int out_features, int in_features, list<f32> w_dense, list<f32> x) → list<f32> ⇥ BlockFp8Error {
    require w_dense.length() ≡ out_features * in_features throw variant BadShape { message = "dense weight length mismatch" }
    require x.length() ≡ in_features throw variant BadShape { message = "input vector length mismatch" }

    mut list<f32> y ← empty

    for exclusive out_features let r {
        mut f32 acc ← 0.0 ∷ f32
        let int base ← r * in_features

        for exclusive in_features let j {
            acc ← acc + w_dense[base + j] * x[j]
        }

        y.append(acc)
    }

    return y
}

@ public
fn ref_matmul(int batch, int out_features, int in_features, list<f32> w_dense, list<f32> x) → list<f32> ⇥ BlockFp8Error {
    require batch ≥ 1 throw variant BadShape { message = "batch must be at least 1" }
    require w_dense.length() ≡ out_features * in_features throw variant BadShape { message = "dense weight length mismatch" }
    require x.length() ≡ batch * in_features throw variant BadShape { message = "input batch length mismatch" }

    mut list<f32> y ← empty

    for exclusive batch let b {
        let int x_base ← b * in_features

        for exclusive out_features let r {
            mut f32 acc ← 0.0 ∷ f32
            let int w_base ← r * in_features

            for exclusive in_features let j {
                acc ← acc + w_dense[w_base + j] * x[x_base + j]
            }

            y.append(acc)
        }
    }

    return y
}

# -------------------------------------------------------------------------
# Shape-generic @ kernel packed GEMV contractions (CPU + Metal)
# -------------------------------------------------------------------------

@ public
kernel linear_matvec_u8<size Out, size In, size ScaleRows, size ScaleCols>(tensor<u8, [Out, In]> weight, tensor<u8, [ScaleRows, ScaleCols]> scales, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 block_rows, i32 block_cols) → void {
    for from y at [row] thread lane let e {
        if block_rows ≥ 1 and block_rows ≤ 4096 and block_cols ≥ 1 and block_cols ≤ 4096 {
            let i32 sr ← row / block_rows
            mut f32 acc ← 0.0 ∷ f32

            for exclusive In let j {
                let i32 sc ← j / block_cols
                let i32 wb ← weight[[row, j]] ↦ i32
                let i32 w_sign ← (wb ⇒ 7) ∧ 1
                let i32 w_exp ← (wb ⇒ 3) ∧ 15
                let i32 w_mant ← wb ∧ 7
                mut f32 w ← 0.0 ∷ f32

                if w_exp ≡ 15 and w_mant ≡ 7 {
                    w ← (0.0 ∷ f32) / (0.0 ∷ f32)
                }
                else {
                    if w_exp ≡ 0 {
                        w ← (w_mant ↦ f32) * (0.001953125 ∷ f32)
                    }
                    else {
                        mut f32 pow2 ← 0.0078125 ∷ f32
                        if (w_exp ∧ 1) ≢ 0 {
                            pow2 ← pow2 * (2.0 ∷ f32)
                        }
                        if (w_exp ∧ 2) ≢ 0 {
                            pow2 ← pow2 * (4.0 ∷ f32)
                        }
                        if (w_exp ∧ 4) ≢ 0 {
                            pow2 ← pow2 * (16.0 ∷ f32)
                        }
                        if (w_exp ∧ 8) ≢ 0 {
                            pow2 ← pow2 * (256.0 ∷ f32)
                        }
                        let f32 frac ← (1.0 ∷ f32) + (w_mant ↦ f32) * (0.125 ∷ f32)
                        w ← pow2 * frac
                    }

                    if w_sign ≡ 1 {
                        w ← -w
                    }
                }

                let i32 se ← scales[[sr, sc]] ↦ i32
                mut f32 s ← 1.0 ∷ f32

                if se ≡ 255 {
                    s ← (0.0 ∷ f32) / (0.0 ∷ f32)
                }
                elif se ≥ 127 {
                    let i32 diff ← se - 127
                    let f32 p1 ← 2.0 ∷ f32
                    let f32 p2 ← p1 * p1
                    let f32 p4 ← p2 * p2
                    let f32 p8 ← p4 * p4
                    let f32 p16 ← p8 * p8
                    let f32 p32 ← p16 * p16
                    let f32 p64 ← p32 * p32

                    if (diff ∧ 1) ≢ 0 {
                        s ← s * p1
                    }
                    if (diff ∧ 2) ≢ 0 {
                        s ← s * p2
                    }
                    if (diff ∧ 4) ≢ 0 {
                        s ← s * p4
                    }
                    if (diff ∧ 8) ≢ 0 {
                        s ← s * p8
                    }
                    if (diff ∧ 16) ≢ 0 {
                        s ← s * p16
                    }
                    if (diff ∧ 32) ≢ 0 {
                        s ← s * p32
                    }
                    if (diff ∧ 64) ≢ 0 {
                        s ← s * p64
                    }
                }
                else {
                    let i32 diff ← 127 - se
                    let f32 n1 ← 0.5 ∷ f32
                    let f32 n2 ← n1 * n1
                    let f32 n4 ← n2 * n2
                    let f32 n8 ← n4 * n4
                    let f32 n16 ← n8 * n8
                    let f32 n32 ← n16 * n16
                    let f32 n64 ← n32 * n32

                    if (diff ∧ 1) ≢ 0 {
                        s ← s * n1
                    }
                    if (diff ∧ 2) ≢ 0 {
                        s ← s * n2
                    }
                    if (diff ∧ 4) ≢ 0 {
                        s ← s * n4
                    }
                    if (diff ∧ 8) ≢ 0 {
                        s ← s * n8
                    }
                    if (diff ∧ 16) ≢ 0 {
                        s ← s * n16
                    }
                    if (diff ∧ 32) ≢ 0 {
                        s ← s * n32
                    }
                    if (diff ∧ 64) ≢ 0 {
                        s ← s * n64
                    }
                }

                acc ← acc + (w * s) * x[[j]]
            }

            y[[row]] ← acc
        }
    }
}

@ public
kernel linear_matvec_u32<size Out, size PackedIn, size ScaleRows, size ScaleCols, size In>(tensor<u32, [Out, PackedIn]> weight, tensor<u8, [ScaleRows, ScaleCols]> scales, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 block_rows, i32 block_cols) → void {
    for from y at [row] thread lane let e {
        if block_rows ≥ 1 and block_rows ≤ 4096 and block_cols ≥ 1 and block_cols ≤ 4096 {
            let i32 sr ← row / block_rows
            mut f32 acc ← 0.0 ∷ f32

            for exclusive In let j {
                let i32 sc ← j / block_cols
                let i32 word_idx ← j / 4
                let i32 byte_lane ← j % 4
                let u32 w0 ← weight[[row, word_idx]]
                mut u32 raw_bits ← 0 ∷ u32

                if byte_lane ≡ 0 {
                    raw_bits ← w0 ∧ (255 ∷ u32)
                }
                elif byte_lane ≡ 1 {
                    raw_bits ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                }
                elif byte_lane ≡ 2 {
                    raw_bits ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                }
                else {
                    raw_bits ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)
                }

                let i32 wb ← raw_bits ↦ wrapping<i32>
                let i32 w_sign ← (wb ⇒ 7) ∧ 1
                let i32 w_exp ← (wb ⇒ 3) ∧ 15
                let i32 w_mant ← wb ∧ 7
                mut f32 w ← 0.0 ∷ f32

                if w_exp ≡ 15 and w_mant ≡ 7 {
                    w ← (0.0 ∷ f32) / (0.0 ∷ f32)
                }
                else {
                    if w_exp ≡ 0 {
                        w ← (w_mant ↦ f32) * (0.001953125 ∷ f32)
                    }
                    else {
                        mut f32 pow2 ← 0.0078125 ∷ f32
                        if (w_exp ∧ 1) ≢ 0 {
                            pow2 ← pow2 * (2.0 ∷ f32)
                        }
                        if (w_exp ∧ 2) ≢ 0 {
                            pow2 ← pow2 * (4.0 ∷ f32)
                        }
                        if (w_exp ∧ 4) ≢ 0 {
                            pow2 ← pow2 * (16.0 ∷ f32)
                        }
                        if (w_exp ∧ 8) ≢ 0 {
                            pow2 ← pow2 * (256.0 ∷ f32)
                        }
                        let f32 frac ← (1.0 ∷ f32) + (w_mant ↦ f32) * (0.125 ∷ f32)
                        w ← pow2 * frac
                    }

                    if w_sign ≡ 1 {
                        w ← -w
                    }
                }

                let i32 se ← scales[[sr, sc]] ↦ i32
                mut f32 s ← 1.0 ∷ f32

                if se ≡ 255 {
                    s ← (0.0 ∷ f32) / (0.0 ∷ f32)
                }
                elif se ≥ 127 {
                    let i32 diff ← se - 127
                    let f32 p1 ← 2.0 ∷ f32
                    let f32 p2 ← p1 * p1
                    let f32 p4 ← p2 * p2
                    let f32 p8 ← p4 * p4
                    let f32 p16 ← p8 * p8
                    let f32 p32 ← p16 * p16
                    let f32 p64 ← p32 * p32

                    if (diff ∧ 1) ≢ 0 {
                        s ← s * p1
                    }
                    if (diff ∧ 2) ≢ 0 {
                        s ← s * p2
                    }
                    if (diff ∧ 4) ≢ 0 {
                        s ← s * p4
                    }
                    if (diff ∧ 8) ≢ 0 {
                        s ← s * p8
                    }
                    if (diff ∧ 16) ≢ 0 {
                        s ← s * p16
                    }
                    if (diff ∧ 32) ≢ 0 {
                        s ← s * p32
                    }
                    if (diff ∧ 64) ≢ 0 {
                        s ← s * p64
                    }
                }
                else {
                    let i32 diff ← 127 - se
                    let f32 n1 ← 0.5 ∷ f32
                    let f32 n2 ← n1 * n1
                    let f32 n4 ← n2 * n2
                    let f32 n8 ← n4 * n4
                    let f32 n16 ← n8 * n8
                    let f32 n32 ← n16 * n16
                    let f32 n64 ← n32 * n32

                    if (diff ∧ 1) ≢ 0 {
                        s ← s * n1
                    }
                    if (diff ∧ 2) ≢ 0 {
                        s ← s * n2
                    }
                    if (diff ∧ 4) ≢ 0 {
                        s ← s * n4
                    }
                    if (diff ∧ 8) ≢ 0 {
                        s ← s * n8
                    }
                    if (diff ∧ 16) ≢ 0 {
                        s ← s * n16
                    }
                    if (diff ∧ 32) ≢ 0 {
                        s ← s * n32
                    }
                    if (diff ∧ 64) ≢ 0 {
                        s ← s * n64
                    }
                }

                acc ← acc + (w * s) * x[[j]]
            }

            y[[row]] ← acc
        }
    }
}

@ public
kernel linear_matmul_u8<size B, size Out, size In, size ScaleRows, size ScaleCols>(tensor<u8, [Out, In]> weight, tensor<u8, [ScaleRows, ScaleCols]> scales, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y, i32 block_rows, i32 block_cols) → void {
    for from y at [b_idx, row] thread lane let e {
        if block_rows ≥ 1 and block_rows ≤ 4096 and block_cols ≥ 1 and block_cols ≤ 4096 {
            let i32 sr ← row / block_rows
            mut f32 acc ← 0.0 ∷ f32

            for exclusive In let j {
                let i32 sc ← j / block_cols
                let i32 wb ← weight[[row, j]] ↦ i32
                let i32 w_sign ← (wb ⇒ 7) ∧ 1
                let i32 w_exp ← (wb ⇒ 3) ∧ 15
                let i32 w_mant ← wb ∧ 7
                mut f32 w ← 0.0 ∷ f32

                if w_exp ≡ 15 and w_mant ≡ 7 {
                    w ← (0.0 ∷ f32) / (0.0 ∷ f32)
                }
                else {
                    if w_exp ≡ 0 {
                        w ← (w_mant ↦ f32) * (0.001953125 ∷ f32)
                    }
                    else {
                        mut f32 pow2 ← 0.0078125 ∷ f32
                        if (w_exp ∧ 1) ≢ 0 {
                            pow2 ← pow2 * (2.0 ∷ f32)
                        }
                        if (w_exp ∧ 2) ≢ 0 {
                            pow2 ← pow2 * (4.0 ∷ f32)
                        }
                        if (w_exp ∧ 4) ≢ 0 {
                            pow2 ← pow2 * (16.0 ∷ f32)
                        }
                        if (w_exp ∧ 8) ≢ 0 {
                            pow2 ← pow2 * (256.0 ∷ f32)
                        }
                        let f32 frac ← (1.0 ∷ f32) + (w_mant ↦ f32) * (0.125 ∷ f32)
                        w ← pow2 * frac
                    }

                    if w_sign ≡ 1 {
                        w ← -w
                    }
                }

                let i32 se ← scales[[sr, sc]] ↦ i32
                mut f32 s ← 1.0 ∷ f32

                if se ≡ 255 {
                    s ← (0.0 ∷ f32) / (0.0 ∷ f32)
                }
                elif se ≥ 127 {
                    let i32 diff ← se - 127
                    let f32 p1 ← 2.0 ∷ f32
                    let f32 p2 ← p1 * p1
                    let f32 p4 ← p2 * p2
                    let f32 p8 ← p4 * p4
                    let f32 p16 ← p8 * p8
                    let f32 p32 ← p16 * p16
                    let f32 p64 ← p32 * p32

                    if (diff ∧ 1) ≢ 0 {
                        s ← s * p1
                    }
                    if (diff ∧ 2) ≢ 0 {
                        s ← s * p2
                    }
                    if (diff ∧ 4) ≢ 0 {
                        s ← s * p4
                    }
                    if (diff ∧ 8) ≢ 0 {
                        s ← s * p8
                    }
                    if (diff ∧ 16) ≢ 0 {
                        s ← s * p16
                    }
                    if (diff ∧ 32) ≢ 0 {
                        s ← s * p32
                    }
                    if (diff ∧ 64) ≢ 0 {
                        s ← s * p64
                    }
                }
                else {
                    let i32 diff ← 127 - se
                    let f32 n1 ← 0.5 ∷ f32
                    let f32 n2 ← n1 * n1
                    let f32 n4 ← n2 * n2
                    let f32 n8 ← n4 * n4
                    let f32 n16 ← n8 * n8
                    let f32 n32 ← n16 * n16
                    let f32 n64 ← n32 * n32

                    if (diff ∧ 1) ≢ 0 {
                        s ← s * n1
                    }
                    if (diff ∧ 2) ≢ 0 {
                        s ← s * n2
                    }
                    if (diff ∧ 4) ≢ 0 {
                        s ← s * n4
                    }
                    if (diff ∧ 8) ≢ 0 {
                        s ← s * n8
                    }
                    if (diff ∧ 16) ≢ 0 {
                        s ← s * n16
                    }
                    if (diff ∧ 32) ≢ 0 {
                        s ← s * n32
                    }
                    if (diff ∧ 64) ≢ 0 {
                        s ← s * n64
                    }
                }

                acc ← acc + (w * s) * x[[b_idx, j]]
            }

            y[[b_idx, row]] ← acc
        }
    }
}

@ public
kernel linear_matmul_u32<size B, size Out, size PackedIn, size ScaleRows, size ScaleCols, size In>(tensor<u32, [Out, PackedIn]> weight, tensor<u8, [ScaleRows, ScaleCols]> scales, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y, i32 block_rows, i32 block_cols) → void {
    for from y at [b_idx, row] thread lane let e {
        if block_rows ≥ 1 and block_rows ≤ 4096 and block_cols ≥ 1 and block_cols ≤ 4096 {
            let i32 sr ← row / block_rows
            mut f32 acc ← 0.0 ∷ f32

            for exclusive In let j {
                let i32 sc ← j / block_cols
                let i32 word_idx ← j / 4
                let i32 byte_lane ← j % 4
                let u32 w0 ← weight[[row, word_idx]]
                mut u32 raw_bits ← 0 ∷ u32

                if byte_lane ≡ 0 {
                    raw_bits ← w0 ∧ (255 ∷ u32)
                }
                elif byte_lane ≡ 1 {
                    raw_bits ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                }
                elif byte_lane ≡ 2 {
                    raw_bits ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                }
                else {
                    raw_bits ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)
                }

                let i32 wb ← raw_bits ↦ wrapping<i32>
                let i32 w_sign ← (wb ⇒ 7) ∧ 1
                let i32 w_exp ← (wb ⇒ 3) ∧ 15
                let i32 w_mant ← wb ∧ 7
                mut f32 w ← 0.0 ∷ f32

                if w_exp ≡ 15 and w_mant ≡ 7 {
                    w ← (0.0 ∷ f32) / (0.0 ∷ f32)
                }
                else {
                    if w_exp ≡ 0 {
                        w ← (w_mant ↦ f32) * (0.001953125 ∷ f32)
                    }
                    else {
                        mut f32 pow2 ← 0.0078125 ∷ f32
                        if (w_exp ∧ 1) ≢ 0 {
                            pow2 ← pow2 * (2.0 ∷ f32)
                        }
                        if (w_exp ∧ 2) ≢ 0 {
                            pow2 ← pow2 * (4.0 ∷ f32)
                        }
                        if (w_exp ∧ 4) ≢ 0 {
                            pow2 ← pow2 * (16.0 ∷ f32)
