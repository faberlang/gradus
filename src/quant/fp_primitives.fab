+++ toml
locale = "en"

+++ faber
# Pure-Faber floating-point micro-format primitives (Rule 17, issue #105).
#
# Public import: import from "gradus:quant/fp_primitives" let fp
#
# --- Contract ------------------------------------------------------------
#
# Zero Radix compiler format tables, zero NumericBlock:
#   * `fp8_e4m3`: E4M3FN byte decode (1 sign, 4 exp bias 7, 3 mantissa;
#     0x7F and 0xFF are NaN; subnormals and -0.0 are preserved).
#   * `ue8m0`: E8M0 unsigned exponent-only scale byte (2^(e - 127);
#     0xFF is NaN).
#   * `e2m1`: 4-bit E2M1 FP4 nibble decode
#     (±{0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0}, -0.0 preserved).
#   * `e2m1x2_lo` / `e2m1x2_hi` / `e2m1x2`: packed pair of 4-bit E2M1 values
#     in one byte (low nibble = even index, high nibble = odd index).

# Decode one E4M3FN byte into f32.
# 0x7F and 0xFF decode to NaN; -0.0 (0x80) and subnormals are preserved.
@ public
fn fp8_e4m3(u8 raw) → f32 {
    let i32 b ← raw ↦ i32
    let i32 sign ← (b ⇒ 7) ∧ 1
    let i32 exp_bits ← (b ⇒ 3) ∧ 15
    let i32 mant ← b ∧ 7

    if exp_bits ≡ 15 and mant ≡ 7 {
        return (0.0 ∷ f32) / (0.0 ∷ f32)
    }

    mut f32 mag ← 0.0 ∷ f32

    if exp_bits ≡ 0 {
        # Subnormal or zero: 2^(1 - 7) * (mant / 8) = mant * 2^-9.
        mag ← (mant ↦ f32) * (0.001953125 ∷ f32)
    }
    else {
        # Normal: 2^(exp_bits - 7) * (1 + mant / 8).
        let f32 pow2 ← ((1 ⇐ exp_bits) ↦ f32) * (0.0078125 ∷ f32)
        let f32 frac ← (1.0 ∷ f32) + (mant ↦ f32) * (0.125 ∷ f32)
        mag ← pow2 * frac
    }

    if sign ≡ 1 {
        return -mag
    }

    return mag
}

# Decode one UE8M0 (E8M0 unsigned exponent-only) scale byte into f32.
# Returns 2^(e - 127) for e in 0..254, and NaN for 0xFF (255). The value is
# the IEEE exponent field read directly as the bit pattern: field `e` is the
# f32 encoding of 2^(e - 127) for every e in 1..254; field 0 would be zero,
# so it holds the subnormal encoding of 2^-127 (mantissa 2^22); field 255 is
# NaN. Every result is an exact power of two, identical to the squaring-tree
# decode it replaces.
@ public
fn ue8m0(u8 raw) → f32 {
    let i32 e ← raw ↦ i32

    if e ≡ 255 {
        return (0.0 ∷ f32) / (0.0 ∷ f32)
    }

    if e ≡ 0 {
        return (4194304 ↦ u32 ⊥ 0) ↦ b32 ↦ f32
    }

    return ((e ⇐ 23) ↦ u32 ⊥ 0) ↦ b32 ↦ f32
}

# Decode the low 4 bits of a nibble as an E2M1 FP4 value into f32.
# Values: ±{0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0}; -0.0 preserved.
@ public
fn e2m1(u8 nibble) → f32 {
    let i32 n ← (nibble ↦ i32) ∧ 15
    let i32 sign ← (n ⇒ 3) ∧ 1
    let i32 mag_bits ← n ∧ 7
    mut f32 mag ← 0.0 ∷ f32

    if mag_bits ≡ 0 {
        mag ← 0.0 ∷ f32
    }
    elif mag_bits ≡ 1 {
        mag ← 0.5 ∷ f32
    }
    elif mag_bits ≡ 2 {
        mag ← 1.0 ∷ f32
    }
    elif mag_bits ≡ 3 {
        mag ← 1.5 ∷ f32
    }
    elif mag_bits ≡ 4 {
        mag ← 2.0 ∷ f32
    }
    elif mag_bits ≡ 5 {
        mag ← 3.0 ∷ f32
    }
    elif mag_bits ≡ 6 {
        mag ← 4.0 ∷ f32
    }
    else {
        mag ← 6.0 ∷ f32
    }

    if sign ≡ 1 {
        return -mag
    }

    return mag
}

# Decode the low-nibble (even index) E2M1 value from a packed e2m1x2 byte.
@ public
fn e2m1x2_lo(u8 packed) → f32 {
    return e2m1(packed ∧ (15 ∷ u8))
}

# Decode the high-nibble (odd index) E2M1 value from a packed e2m1x2 byte.
@ public
fn e2m1x2_hi(u8 packed) → f32 {
    return e2m1((packed ⇒ (4 ∷ u8)) ∧ (15 ∷ u8))
}

# Pair of decoded E2M1 values from one e2m1x2 byte.
@ public
class E2m1Pair {
    let f32 lo
    let f32 hi
}

# Decode a packed e2m1x2 byte into (even_val, odd_val).
@ public
fn e2m1x2(u8 packed) → E2m1Pair {
    return E2m1Pair { lo = e2m1x2_lo(packed), hi = e2m1x2_hi(packed) }
}

+++ faber test
import from "gradus:quant/fp_primitives" let fp

fn is_neg_zero(f32 x) → bool {
    return x ≡ (0.0 ∷ f32) and ((1.0 ∷ f32) / x) ≺ (0.0 ∷ f32)
}

fn is_pos_zero(f32 x) → bool {
    return x ≡ (0.0 ∷ f32) and ((1.0 ∷ f32) / x) ≻ (0.0 ∷ f32)
}

test "fp8_e4m3 decodes NaNs, zeros, subnormals, normals, and extremes" {
    # NaNs: 0x7F and 0xFF
    let f32 nan_pos ← fp.fp8_e4m3(0x7f ∷ u8)
    let f32 nan_neg ← fp.fp8_e4m3(0xff ∷ u8)
    assert nan_pos ≢ nan_pos
    assert nan_neg ≢ nan_neg

    # Signed zeros: +0.0 (0x00) and -0.0 (0x80)
    assert is_pos_zero(fp.fp8_e4m3(0x00 ∷ u8))
    assert is_neg_zero(fp.fp8_e4m3(0x80 ∷ u8))

    # Subnormals: 2^-9 * mant
    assert fp.fp8_e4m3(0x01 ∷ u8) ≡ (0.001953125 ∷ f32)
    assert fp.fp8_e4m3(0x81 ∷ u8) ≡ (-0.001953125 ∷ f32)
    assert fp.fp8_e4m3(0x07 ∷ u8) ≡ (0.013671875 ∷ f32)
    assert fp.fp8_e4m3(0x87 ∷ u8) ≡ (-0.013671875 ∷ f32)

    # Smallest normal: 0x08 -> exp=1, mant=0 -> 2^-6 = 0.015625
    assert fp.fp8_e4m3(0x08 ∷ u8) ≡ (0.015625 ∷ f32)
    # 1.0: sign=0, exp=7 (0111), mant=0 -> 0x38
    assert fp.fp8_e4m3(0x38 ∷ u8) ≡ (1.0 ∷ f32)
    # -1.0: 0xB8
    assert fp.fp8_e4m3(0xb8 ∷ u8) ≡ (-1.0 ∷ f32)
    # 1.5: sign=0, exp=7, mant=4 -> 0x3C
    assert fp.fp8_e4m3(0x3c ∷ u8) ≡ (1.5 ∷ f32)
    # 0.875: sign=0, exp=6, mant=6 -> 0x36 -> 0.5 * 1.75 = 0.875
    assert fp.fp8_e4m3(0x36 ∷ u8) ≡ (0.875 ∷ f32)

    # Max finite: 0x7E (448.0) and 0xFE (-448.0)
    assert fp.fp8_e4m3(0x7e ∷ u8) ≡ (448.0 ∷ f32)
    assert fp.fp8_e4m3(0xfe ∷ u8) ≡ (-448.0 ∷ f32)
}

test "ue8m0 decodes powers of two across full range and NaN" {
    # 0xFF -> NaN
    let f32 nan_v ← fp.ue8m0(0xff ∷ u8)
    assert nan_v ≢ nan_v

    # 127 (0x7F) -> 2^0 = 1.0
    assert fp.ue8m0(127 ∷ u8) ≡ (1.0 ∷ f32)
    # 128 (0x80) -> 2^1 = 2.0
    assert fp.ue8m0(128 ∷ u8) ≡ (2.0 ∷ f32)
    # 126 (0x7E) -> 2^-1 = 0.5
    assert fp.ue8m0(126 ∷ u8) ≡ (0.5 ∷ f32)
    # 130 -> 2^3 = 8.0
    assert fp.ue8m0(130 ∷ u8) ≡ (8.0 ∷ f32)
    # 120 -> 2^-7 = 0.0078125
    assert fp.ue8m0(120 ∷ u8) ≡ (0.0078125 ∷ f32)

    # Extremes: e=0 -> 2^-127, e=254 -> 2^127
    let f32 e0 ← fp.ue8m0(0 ∷ u8)
    let f32 e1 ← fp.ue8m0(1 ∷ u8)
    assert e0 ≻ (0.0 ∷ f32)
    assert e1 ≡ e0 * (2.0 ∷ f32)

    let f32 e254 ← fp.ue8m0(254 ∷ u8)
    let f32 e253 ← fp.ue8m0(253 ∷ u8)
    assert e254 ≡ e253 * (2.0 ∷ f32)
    assert e254 ≡ e254
    assert e254 ≻ (1.0e38 ∷ f32)
}

test "e2m1x2 decodes all 16 E2M1 values and low/high nibble order" {
    let list<f32> pos_table ← [0.0 ∷ f32, 0.5 ∷ f32, 1.0 ∷ f32, 1.5 ∷ f32, 2.0 ∷ f32, 3.0 ∷ f32, 4.0 ∷ f32, 6.0 ∷ f32]

    for exclusive 8 let i {
        let u8 nib_pos ← i ↦ u8 ⊥ (0 ∷ u8)
        let u8 nib_neg ← (i + 8) ↦ u8 ⊥ (0 ∷ u8)
        assert fp.e2m1(nib_pos) ≡ pos_table[i]
        assert fp.e2m1(nib_neg) ≡ -pos_table[i]
    }

    assert is_pos_zero(fp.e2m1(0x00 ∷ u8))
    assert is_neg_zero(fp.e2m1(0x08 ∷ u8))

    # Packed byte 0xD3: low nibble = 3 (+1.5), high nibble = 13 (-3.0)
    let fp.E2m1Pair pair ← fp.e2m1x2(0xd3 ∷ u8)
    assert pair.lo ≡ (1.5 ∷ f32)
    assert pair.hi ≡ (-3.0 ∷ f32)
    assert fp.e2m1x2_lo(0xd3 ∷ u8) ≡ (1.5 ∷ f32)
    assert fp.e2m1x2_hi(0xd3 ∷ u8) ≡ (-3.0 ∷ f32)
}
