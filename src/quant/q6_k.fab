+++ toml
locale = "en"

+++ faber
# GGML Q6_K as a named block genus and one decode function (gradus #26).
#
# Public import: import from "gradus:quant/q6_k" let q6_k
#
# A Q6_K super-block quantizes 256 weights to signed 6-bit values (-32..31)
# across 16 sub-blocks of 16 weights, with 8-bit signed sub-block scales
# and one half super-block scale d. On disk a block is 210 bytes,
# little-endian, with no padding:
#
#     block_q6_k { uint8_t ql[128]; uint8_t qh[64]; int8_t scales[16]; ggml_half d; }
#
# Weights are grouped into two 128-element halves (n = 0, 1). Within each
# half, 4 quadrants (quad = 0..3) of 32 weights (l = 0..31) pack their lower
# 4 bits in ql and upper 2 bits in qh, then subtract 32:
#
#     ql_idx = n * 64 + (quad % 2) * 32 + l
#     qh_idx = n * 32 + l
#     sc_idx = n * 8 + l / 16 + quad * 2
#     nib    = (quad < 2) ? (ql[ql_idx] & 0x0F) : (ql[ql_idx] >> 4)
#     hi     = ((qh[qh_idx] >> (quad * 2)) & 3) << 4
#     q      = (nib | hi) - 32
#     y      = (f32(d) * f32(scales[sc_idx])) * f32(q)
#
# matching gradus:model/dequant dequant_q6_k and ggml-quants.c bit for bit.
#
# Rule 17: the format lives in Gradus. `decode` reads the fields in place
# and copies no block or field list.
#
# `Q6_K`, `decode`, and `from_bytes` are `@ public` (file_interface exports
# `list<T, size N>`), and `decode_block` stays `@ public` as a host helper.
# Device/Metal execution over `tensor<Q6_K, [N]>` remains blocked on compiler
# record-tensor lowering: `raw ↦ tensor<Q6_K, [N]> via Le` passes `faber check`,
# but `--device cpu` and `--target metal-text` fail closed with
# `PKG001:E_DEVICE_UNSUPPORTED` ("lane kernel form not lowered to KIR: a cell of
# type Struct(DefId(...))", same as #25 / PR #41), and calling `decode` inside a
# `thread lane` loop hits `SEM010:filum_independence_unproven`.

# Elements per block.
@ public
const int Q6_K_ELEMENTS = 256

# Bytes per block: 128 (low nibbles) + 64 (high 2-bit pairs) + 16 (int8 scales) + 2 (half scale d).
@ public
const int Q6_K_BYTES = 210

# The block genus. Field order is the on-disk order.
@ public
class Q6_K {
    let list<u8, size 128> ql
    let list<u8, size 64> qh
    let list<i8, size 16> scales
    let f16 d
}

# Typed fail-closed diagnostics of the loader.
#   BadBlock — byte length is not Q6_K_BYTES.
#   BadScale — the half scale is NaN.
@ public
union Q6_KError {
    @ shared
    string message

    BadBlock,
    BadScale
}

# Weight k (0 ≤ k < 256) of block b as f32. An out-of-range k ends the run
# on the `b.ql[ql_idx]` bounds check before any shift runs.
@ public
fn decode(Q6_K b, i32 k) → f32 {
    let int ki ← k ↦ int
    let int n ← ki / 128
    let int within ← ki % 128
    let int quad ← within / 32
    let int l ← within % 32
    let int ql_idx ← n * 64 + (quad % 2) * 32 + l
    let int ql_byte ← b.ql[ql_idx] ↦ int
    let int qh_byte ← b.qh[n * 32 + l] ↦ int
    let int nib ← quad ≺ 2 ✓ ql_byte % 16 ✗ (ql_byte ⇒ 4) % 16
    let int hi ← ((qh_byte ⇒ quad * 2) % 4) * 16
    let int q ← (nib ∨ hi) - 32
    let f32 sc ← b.scales[n * 8 + l / 16 + quad * 2] ↦ f32
    return (b.d ↦ f32) * sc * (q ↦ f32)
}

# One block from its 210 on-disk bytes.
@ public
fn from_bytes(list<u8> raw) → Q6_K ⇥ Q6_KError {
    if raw.length() ≢ Q6_K_BYTES {
        throw variant BadBlock { message = "Q6_K block byte length mismatch" }
    }

    let list<b8> buf ↤ raw
    let int bits ← (buf[208 ‥ 210] ↦ u16 via Le) ↦ int

    if (bits ⇒ 10) % 32 ≡ 31 {
        if bits % 1024 ≢ 0 {
            throw variant BadScale { message = "NaN half scale in Q6_K block" }
        }
    }

    let f16 d ← ((buf[208 ‥ 210] ↦ u16 via Le) ↦ b16) ↦ f16
    let list<u8> ql_raw ← buf[0 ‥ 128] ↦ list<u8>
    let list<u8> qh_raw ← buf[128 ‥ 192] ↦ list<u8>
    mut list<i8> scales_raw ← empty

    for range 0 ‥ 16 let i {
        let int b ← raw[192 + i] ↦ int
        let int signed ← b ≥ 128 ✓ b - 256 ✗ b
        scales_raw.append(signed ↦ i8 ⊥ (0 ∷ i8))
    }

    do {
        return Q6_K {
            ql = ql_raw ↦ list<u8, size 128>,
            qh = qh_raw ↦ list<u8, size 64>,
            scales = scales_raw ↦ list<i8, size 16>,
            d = d
        }
    }
    catch err {
        throw variant BadBlock { message = "Q6_K block byte length mismatch" }
    }
}

# The 256 weights of one block from its 210 bytes.
@ public
fn decode_block(list<u8> raw) → list<f32> ⇥ Q6_KError {
    let Q6_K b ← from_bytes(raw)
    mut list<f32> y ← empty

    for range 0 ‥ Q6_K_ELEMENTS let k {
        y.append(decode(b, k ↦ i32 ⊥ 0))
    }

    return y
}

