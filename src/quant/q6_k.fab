    for from vals let v {
        bs.append(v ↦ u8 ⊥ 0)
    }
    return bs
}

fn bits_of(f32 v) → int {
    return v ↦ b32 ↦ u32 ↦ int
}

fn block_result(list<u8> raw) → string {
    do {
        q6_k.decode_block(raw)
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn weights(list<u8> raw) → list<f32> {
    do {
        return q6_k.decode_block(raw)
    }
    catch err {
        return empty
    }
}

fn host_bits(list<u8> raw) → list<int> {
    do {
        let list<b8> buf ↤ raw
        let list<f32> y ← dequant.decode_block_f32(dequant.representation_for(14), buf)
        mut list<int> out ← empty
        for from y let v {
            out.append(bits_of(v))
        }
        return out
    }
    catch err {
        return empty
    }
}

fn golden_mismatches(int i) → int {
    let list<f32> y ← weights(bytes_of(GOLDEN_BLOCKS[i]))
    if y.length() ≢ 256 then return 256
    mut int bad ← 0
    for range 0 ‥ 256 let j {
        if bits_of(y[j]) ≢ GOLDEN_BITS[i][j] then bad ← bad + 1
    }
    return bad
}

fn geometry_bytes(storage.Representation kind) → int {
    do {
        return dequant.block_bytes(kind)
    }
    catch err {
        return 0
    }
}

fn geometry_elements(storage.Representation kind) → int {
    do {
        return dequant.block_elements(kind)
    }
    catch err {
        return 0
    }
}

test "Q6_K layout: 210 bytes per 256 weights, no padding" {
    assert q6_k.Q6_K_ELEMENTS ≡ 256
    assert q6_k.Q6_K_BYTES ≡ 210
    assert q6_k.Q6_K_BYTES ≡ 128 + 64 + 16 + 2
}

test "Q6_K layout equals the host dequant geometry" {
    let storage.Representation q6k ← dequant.representation_for(14)
    assert geometry_bytes(q6k) ≡ q6_k.Q6_K_BYTES
    assert geometry_elements(q6k) ≡ q6_k.Q6_K_ELEMENTS
}

test "the golden table is the seven Q6_K fixtures" {
    assert GOLDEN_NAMES.length() ≡ 7
    assert GOLDEN_BLOCKS.length() ≡ 7
    assert GOLDEN_BITS.length() ≡ 7
}

test "decode matches the independent golden bit for bit on every block" {
    for range 0 ‥ 7 let i {
        assert golden_mismatches(i) ≡ 0
    }
}

test "genus decode equals host dequant on every golden block" {
    for range 0 ‥ 7 let i {
        let list<int> h ← host_bits(bytes_of(GOLDEN_BLOCKS[i]))
        let list<f32> y ← weights(bytes_of(GOLDEN_BLOCKS[i]))
        assert h.length() ≡ 256
        assert y.length() ≡ 256
        for range 0 ‥ 256 let j {
            assert bits_of(y[j]) ≡ h[j]
        }
    }
}

# Hand-built block with d = 1.0 (0x3c00 = [0, 60] at bytes 208..210)
# covering all 4 quadrants, both halves (n=0, n=1), both scale sub-indices
# (l=0..15 -> idx=0, l=16..31 -> idx=1), positive & negative i8 scales,
# and extreme q values (-32 and +31):
#   scales[0] =  2, scales[1] = -3, scales[2] =  4, scales[3] = -5
#   scales[4] =  1, scales[5] = -2, scales[6] =  3, scales[7] = -4
#   scales[8] = -1, scales[9] =  2
#   n=0, l=0:  ql[0]=0xA5 (lo=5, hi=10), ql[32]=0x3C (lo=12, hi=3), qh[0]=0xE4 (0b11_10_01_00: q0=0,q1=1,q2=2,q3=3)
#     k=0   (quad=0, l=0):  nib=5,  hi=0  -> q=5-32=-27,  sc=scales[0]=2   -> -54.0
#     k=32  (quad=1, l=0):  nib=12, hi=16 -> q=28-32=-4,  sc=scales[2]=4   -> -16.0
#     k=64  (quad=2, l=0):  nib=10, hi=32 -> q=42-32=10,  sc=scales[4]=1   ->  10.0
#     k=96  (quad=3, l=0):  nib=3,  hi=48 -> q=51-32=19,  sc=scales[6]=3   ->  57.0
#   n=0, l=16: ql[16]=0x00, ql[48]=0xFF, qh[16]=0x0C (0b00_00_11_00: q0=0,q1=3,q2=0,q3=0)
#     k=16  (quad=0, l=16): nib=0,  hi=0  -> q=-32,       sc=scales[1]=-3  ->  96.0
#     k=48  (quad=1, l=16): nib=15, hi=48 -> q=63-32=31,  sc=scales[3]=-5  -> -155.0
#     k=80  (quad=2, l=16): nib=0,  hi=0  -> q=-32,       sc=scales[5]=-2  ->  64.0
#     k=112 (quad=3, l=16): nib=15, hi=0  -> q=15-32=-17, sc=scales[7]=-4  ->  68.0
#   n=1, l=0:  ql[64]=0xFF, qh[32]=0x03 (q0=3)
#     k=128 (quad=0, l=0):  nib=15, hi=48 -> q=31,        sc=scales[8]=-1  -> -31.0
#   n=1, l=16: ql[80]=0x00, qh[48]=0x00 (q0=0)
#     k=144 (quad=0, l=16): nib=0,  hi=0  -> q=-32,       sc=scales[9]=2   -> -64.0
fn branch_block() → list<u8> {
    mut list<int> raw ← empty
    for range 0 ‥ 210 let i {
        raw.append(0)
    }
    raw[0] ← 0xA5
    raw[32] ← 0x3C
    raw[128] ← 0xE4
    raw[16] ← 0x00
    raw[48] ← 0xFF
    raw[128 + 16] ← 0x0C
    raw[64] ← 0xFF
    raw[128 + 32] ← 0x03
    raw[192 + 0] ← 2
    raw[192 + 1] ← 253
    raw[192 + 2] ← 4
    raw[192 + 3] ← 251
    raw[192 + 4] ← 1
    raw[192 + 5] ← 254
    raw[192 + 6] ← 3
    raw[192 + 7] ← 252
    raw[192 + 8] ← 255
    raw[192 + 9] ← 2
    raw[208] ← 0
    raw[209] ← 60
    return bytes_of(raw)
}

test "all 4 quadrant packing branches, signed scales, and extremes match hand formula" {
    let list<f32> y ← weights(branch_block())
    assert y.length() ≡ 256
    assert y[0] ≡ -54.0 ∷ f32
    assert y[32] ≡ -16.0 ∷ f32
    assert y[64] ≡ 10.0 ∷ f32
    assert y[96] ≡ 57.0 ∷ f32
    assert y[16] ≡ 96.0 ∷ f32
    assert y[48] ≡ -155.0 ∷ f32
    assert y[80] ≡ 64.0 ∷ f32
    assert y[112] ≡ 68.0 ∷ f32
    assert y[128] ≡ -31.0 ∷ f32
    assert y[144] ≡ -64.0 ∷ f32
}

test "truncated block is refused by name" {
    let list<u8> full ← bytes_of(GOLDEN_BLOCKS[0])
    mut list<u8> trim ← empty
    for range 0 ‥ 209 let i {
        trim.append(full[i])
    }
    assert block_result(trim) ≡ "Q6_K block byte length mismatch"
    assert block_result(bytes_of([])) ≡ "Q6_K block byte length mismatch"
}

test "padded block is refused by name" {
    let list<u8> full ← bytes_of(GOLDEN_BLOCKS[0])
    mut list<u8> pad ← copy full
    pad.append(0 ↦ u8)
    assert block_result(pad) ≡ "Q6_K block byte length mismatch"
}

test "Q6_K public from_bytes and decode read fields directly" {
    do {
        let q6_k.Q6_K blk ← q6_k.from_bytes(branch_block())
        assert q6_k.decode(blk, 0) ≡ -54.0 ∷ f32
        assert q6_k.decode(blk, 32) ≡ -16.0 ∷ f32
        assert q6_k.decode(blk, 64) ≡ 10.0 ∷ f32
        assert q6_k.decode(blk, 96) ≡ 57.0 ∷ f32
        assert q6_k.decode(blk, 128) ≡ -31.0 ∷ f32
        assert q6_k.decode(blk, 144) ≡ -64.0 ∷ f32
    }
    catch err {
        assert false
    }
}

test "NaN half scale is refused by name" {
    # 0x7e00 quiet NaN and 0x7c01 signalling NaN at the scale slot (208..210), rest zero.
    mut list<int> qnan ← empty
    mut list<int> snan ← empty
    for range 0 ‥ 208 let i {
        qnan.append(0)
        snan.append(0)
    }
    qnan.append(0)
    qnan.append(126)
    snan.append(1)
    snan.append(124)
    assert block_result(bytes_of(qnan)) ≡ "NaN half scale in Q6_K block"
    assert block_result(bytes_of(snan)) ≡ "NaN half scale in Q6_K block"
}

test "infinite half scale is data, not an error" {
    # 0x7c00 = +inf at bytes 208..210; the loader admits it (only NaN is malformed).
    mut list<int> raw ← empty
    for range 0 ‥ 208 let i {
        raw.append(0)
    }
    raw.append(0)
    raw.append(124)
    assert block_result(bytes_of(raw)) ≡ "ok"
}

test "negative zero scale preserves IEEE-754 sign bits" {
    # 0x8000 = -0.0 at bytes 208..210.
    # On branch_block with d = -0.0:
    #   k=0  (q=-27, sc=2)  -> -0.0 * 2 * (-27) = +0.0 (0x00000000)
    #   k=64 (q=+10, sc=1)  -> -0.0 * 1 * (+10) = -0.0 (0x80000000)
    #   k=16 (q=-32, sc=-3) -> (-0.0 * -3) * (-32) = (+0.0) * (-32) = -0.0 (0x80000000)
    mut list<u8> raw ← branch_block()
    raw[208] ← 0 ↦ u8
    raw[209] ← 128 ↦ u8
    let list<f32> y ← weights(raw)
    assert y.length() ≡ 256
    assert bits_of(y[0]) ≡ 0x00000000
    assert bits_of(y[64]) ≡ 0x80000000
    assert bits_of(y[16]) ≡ 0x80000000
}
