                        let i32 j ← j_base + k
                        let u8 packed ← weight[[ee, row, j / 2]]
                        mut i32 nib ← 0

                        if j % 2 ≡ 0 {
                            nib ← (packed ↦ i32) ∧ 15
                        }
                        else {
                            nib ← ((packed ↦ i32) ⇒ 4) ∧ 15
