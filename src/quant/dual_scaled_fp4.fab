+++ toml
locale = "en"

+++ faber
# DualScaledFp4 (NVFP4) — dual-scaled 4-bit E2M1 with FP8 E4M3FN group scales
# and f32 global scale (issue #105).
#
# Public import: import from "gradus:quant/dual_scaled_fp4" let dual_scaled_fp4
#
# --- Contract ------------------------------------------------------------
#
# Rule-17 pure-Faber representation (zero compiler format tables):
#   * Raw ModelOpt encoding:
#       - `weight`: packed E2M1 (`u8` `[Out, In / 2]`, low nibble = even, high = odd)
#       - `scales`: `fp8_e4m3` group-16 `_scale` (`u8` `[Out, In / G]`)
#       - `amax`: `f32` `_amax`
#       - `outer_scale_denominator`: `f32` `_outer_scale_denominator`
#       - `global_scale = amax / outer_scale_denominator`
#   * MLX-converted encoding (Inkling L0-19):
#       - `weight`: `u32` packed 8x E2M1 nibbles (`[Out, In / 8]`)
#       - `scales`: `fp8_e4m3` group scales (`u8` `[Out, In / G]`)
#       - `global_scale`: `f32`
#   * Dequantize: `w[r, j] = e2m1(q[r, j]) * fp8_e4m3(scales[r, j / G]) * global_scale`

import from "gradus:dtype" let dtype
import from "gradus:quant/fp_primitives" let fp

const list<f32, size 8> E2M1_MAG = [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0]

@ public
union DualScaledFp4Error {
    @ shared
    string message

    BadConfig,
    BadShape,
    BadPack,
    BadScale
}

@ public
union PackKind {
    PackU8,
    PackU32
}

@ public
class DualScaledFp4Spec {
    let int out_features
    let int in_features
    let int group_size
    let PackKind pack
    let int packed_cols
    let int group_cols
}

@ public
fn admit_spec(int out_features, int in_features, int group_size, PackKind pack) → DualScaledFp4Spec ⇥ DualScaledFp4Error {
    require out_features ≥ 1 throw variant BadShape { message = "out_features must be at least 1" }
    require in_features ≥ 1 throw variant BadShape { message = "in_features must be at least 1" }
    require group_size ≥ 1 throw variant BadConfig { message = "group_size must be at least 1" }
    require in_features % group_size ≡ 0 throw variant BadShape { message = "in_features must be divisible by group_size" }

    mut int packed_cols ← 0

    match pack {
        case PackU8 {
            require in_features % 2 ≡ 0 throw variant BadShape { message = "in_features must be divisible by 2 for u8 E2M1 packing" }
            packed_cols ← in_features / 2
        }
        case PackU32 {
            require in_features % 8 ≡ 0 throw variant BadShape { message = "in_features must be divisible by 8 for u32 E2M1 packing" }
            packed_cols ← in_features / 8
        }
    }

    let int group_cols ← in_features / group_size
    return DualScaledFp4Spec {
        out_features = out_features,
        in_features = in_features,
        group_size = group_size,
        pack = pack,
        packed_cols = packed_cols,
        group_cols = group_cols
    }
}

@ public
fn admit_nvfp4_spec(int out_features, int in_features, PackKind pack) → DualScaledFp4Spec ⇥ DualScaledFp4Error {
    return admit_spec(out_features, in_features, 16, pack)
}

@ public
fn admit_modelopt_global_scale(f32 amax, f32 outer_scale_denominator) → f32 ⇥ DualScaledFp4Error {
    require dtype.finite(amax) and amax ≥ (0.0 ∷ f32) throw variant BadScale { message = "amax must be finite and non-negative" }
    require dtype.finite(outer_scale_denominator) and outer_scale_denominator ≻ (0.0 ∷ f32) throw variant BadScale { message = "outer_scale_denominator must be finite and positive" }
    let f32 global_scale ← amax / outer_scale_denominator
    require dtype.finite(global_scale) throw variant BadScale { message = "global scale must be finite" }
    return global_scale
}

# -------------------------------------------------------------------------
# Typed host reference decode and GEMV
# -------------------------------------------------------------------------

@ public
fn ref_dequantize_u8(DualScaledFp4Spec spec, list<u8> weight, list<u8> scales, f32 global_scale) → list<f32> ⇥ DualScaledFp4Error {
    match spec.pack {
        case PackU8 {
            pass
        }
        default {
            throw variant BadPack { message = "expected PackU8 spec" }
        }
    }

    require weight.length() ≡ spec.out_features * spec.packed_cols throw variant BadShape { message = "weight length mismatch" }
    require scales.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "scales length mismatch" }

    mut list<f32> out ← empty

    for exclusive spec.out_features let r {
        let int w_base ← r * spec.packed_cols
        let int s_base ← r * spec.group_cols

        for exclusive spec.in_features let j {
            let u8 packed ← weight[w_base + (j / 2)]
            let f32 q ← (j % 2 ≡ 0) ✓ fp.e2m1x2_lo(packed) ✗ fp.e2m1x2_hi(packed)
            let f32 local_s ← fp.fp8_e4m3(scales[s_base + (j / spec.group_size)])
            out.append(q * local_s * global_scale)
        }
    }

    return out
}

@ public
fn ref_dequantize_modelopt_u8(DualScaledFp4Spec spec, list<u8> weight, list<u8> scales, f32 amax, f32 outer_scale_denominator) → list<f32> ⇥ DualScaledFp4Error {
    let f32 global_scale ← admit_modelopt_global_scale(amax, outer_scale_denominator)
    return ref_dequantize_u8(spec, weight, scales, global_scale)
}

@ public
fn ref_dequantize_u32(DualScaledFp4Spec spec, list<u32> weight, list<u8> scales, f32 global_scale) → list<f32> ⇥ DualScaledFp4Error {
    match spec.pack {
        case PackU32 {
            pass
        }
        default {
            throw variant BadPack { message = "expected PackU32 spec" }
        }
    }

    require weight.length() ≡ spec.out_features * spec.packed_cols throw variant BadShape { message = "weight length mismatch" }
    require scales.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "scales length mismatch" }

    mut list<f32> out ← empty

    for exclusive spec.out_features let r {
        let int w_base ← r * spec.packed_cols
        let int s_base ← r * spec.group_cols

        for exclusive spec.in_features let j {
            let int word_idx ← j / 8
            let int shift ← (j % 8) * 4
            let int word ← weight[w_base + word_idx] ↦ int
            let u8 nib ← ((word ⇒ shift) ∧ 15) ↦ wrapping<u8>
            let f32 q ← fp.e2m1(nib)
            let f32 local_s ← fp.fp8_e4m3(scales[s_base + (j / spec.group_size)])
            out.append(q * local_s * global_scale)
        }
    }

    return out
}

@ public
fn ref_matvec(int out_features, int in_features, list<f32> w_dense, list<f32> x) → list<f32> ⇥ DualScaledFp4Error {
    require w_dense.length() ≡ out_features * in_features throw variant BadShape { message = "dense weight length mismatch" }
    require x.length() ≡ in_features throw variant BadShape { message = "input vector length mismatch" }

    mut list<f32> y ← empty

    for exclusive out_features let r {
        mut f32 acc ← 0.0 ∷ f32
        let int base ← r * in_features

        for exclusive in_features let j {
            acc ← acc + w_dense[base + j] * x[j]
        }

        y.append(acc)
    }

    return y
}

@ public
fn ref_matmul(int batch, int out_features, int in_features, list<f32> w_dense, list<f32> x) → list<f32> ⇥ DualScaledFp4Error {
    require batch ≥ 1 throw variant BadShape { message = "batch must be at least 1" }
    require w_dense.length() ≡ out_features * in_features throw variant BadShape { message = "dense weight length mismatch" }
    require x.length() ≡ batch * in_features throw variant BadShape { message = "input batch length mismatch" }

    mut list<f32> y ← empty

    for exclusive batch let b {
        let int x_base ← b * in_features

        for exclusive out_features let r {
            mut f32 acc ← 0.0 ∷ f32
            let int w_base ← r * in_features

            for exclusive in_features let j {
                acc ← acc + w_dense[w_base + j] * x[x_base + j]
            }

            y.append(acc)
        }
    }

    return y
}

# -------------------------------------------------------------------------
# Shape-generic @ kernel packed GEMV contractions (CPU + Metal)
# -------------------------------------------------------------------------

# Geometry invariant: Groups * group_size == In.
@ public
kernel linear_matvec_u8<size Out, size PackedIn, size Groups, size In>(tensor<u8, [Out, PackedIn]> weight, tensor<u8, [Out, Groups]> scales, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, f32 global_scale, i32 group_size) → void {
    assert group_size ∈ 1 … 4096 and Groups ∈ 1 … 65536 and In ∈ 1 … 16777216 panic "linear_matvec_u8: invalid geometry"
    for from y at [row] thread lane let e {
        let i32 n_groups ← Groups ↦ i32
        let i32 in_dim ← In ↦ i32
        mut f32 acc ← 0.0 ∷ f32

        if group_size % 2 ≡ 0 {
            let i32 bytes_per_group ← group_size / 2
            mut i32 g ← 0

            while g ≺ n_groups {
                let i32 sb ← scales[[row, g]] ↦ i32
                let i32 s_exp ← (sb ⇒ 3) ∧ 15
                let i32 s_mant ← sb ∧ 7
                let f32 sp ← (0.0078125 ∷ f32) * ((s_exp ∧ 1) ≢ 0 ✓ (2.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 2) ≢ 0 ✓ (4.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 4) ≢ 0 ✓ (16.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 8) ≢ 0 ✓ (256.0 ∷ f32) ✗ (1.0 ∷ f32))
                let f32 s_mag ← (s_exp ≡ 0) ✓ ((s_mant ↦ f32) * (0.001953125 ∷ f32)) ✗ (sp * ((1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)))
                let f32 s_sgn ← ((sb ∧ 128) ≢ 0) ✓ (-1.0 ∷ f32) ✗ (1.0 ∷ f32)
                let f32 local_s ← (s_exp ≡ 15 and s_mant ≡ 7) ✓ nan ✗ (s_mag * s_sgn)

                let i32 w_base ← g * bytes_per_group
                let i32 x_base ← g * group_size
                mut f32 g_acc ← 0.0 ∷ f32
                mut i32 bg ← 0
                while bg ≺ bytes_per_group {
                    let i32 w_idx ← w_base + bg
                    let i32 packed ← weight[[row, w_idx]] ↦ i32
                    let i32 j0 ← x_base + bg * 2
                    let i32 j1 ← j0 + 1

                    let i32 n0 ← packed ∧ 15
                    let f32 m0 ← E2M1_MAG[n0 ∧ 7]
                    let f32 q0 ← ((n0 ∧ 8) ≢ 0) ✓ -m0 ✗ m0

                    let i32 n1 ← (packed ⇒ 4) ∧ 15
                    let f32 m1 ← E2M1_MAG[n1 ∧ 7]
                    let f32 q1 ← ((n1 ∧ 8) ≢ 0) ✓ -m1 ✗ m1

                    g_acc ← g_acc + q0 * x[[j0]] + q1 * x[[j1]]
                    bg ← bg + 1
                }

                acc ← acc + local_s * g_acc
                g ← g + 1
            }
        }
        else {
            mut i32 g ← 0

            while g ≺ n_groups {
                let i32 sb ← scales[[row, g]] ↦ i32
                let i32 s_exp ← (sb ⇒ 3) ∧ 15
                let i32 s_mant ← sb ∧ 7
                let f32 sp ← (0.0078125 ∷ f32) * ((s_exp ∧ 1) ≢ 0 ✓ (2.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 2) ≢ 0 ✓ (4.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 4) ≢ 0 ✓ (16.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 8) ≢ 0 ✓ (256.0 ∷ f32) ✗ (1.0 ∷ f32))
                let f32 s_mag ← (s_exp ≡ 0) ✓ ((s_mant ↦ f32) * (0.001953125 ∷ f32)) ✗ (sp * ((1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)))
                let f32 s_sgn ← ((sb ∧ 128) ≢ 0) ✓ (-1.0 ∷ f32) ✗ (1.0 ∷ f32)
                let f32 local_s ← (s_exp ≡ 15 and s_mant ≡ 7) ✓ nan ✗ (s_mag * s_sgn)

                let i32 x_base ← g * group_size
                mut f32 g_acc ← 0.0 ∷ f32
                mut i32 k ← 0
                while k ≺ group_size {
                    let i32 jj ← x_base + k
                    let i32 packed ← weight[[row, jj / 2]] ↦ i32
                    let i32 nib ← (jj % 2 ≡ 0) ✓ (packed ∧ 15) ✗ ((packed ⇒ 4) ∧ 15)
                    let f32 m0 ← E2M1_MAG[nib ∧ 7]
                    let f32 q ← ((nib ∧ 8) ≢ 0) ✓ -m0 ✗ m0
                    g_acc ← g_acc + q * x[[jj]]
                    k ← k + 1
                }

                acc ← acc + local_s * g_acc
                g ← g + 1
            }
        }

        y[[row]] ← acc * global_scale
    }
}

# Geometry invariant: Groups * group_size == In.
@ public
kernel linear_matvec_u8_part<size Out, size PackedIn, size Groups, size In, size KParts>(tensor<u8, [Out, PackedIn]> weight, tensor<u8, [Out, Groups]> scales, tensor<f32, [In]> x, mut tensor<f32, [Out, KParts]> partials, f32 global_scale, i32 group_size) → void {
    assert group_size ∈ 1 … 4096 and Groups ∈ 1 … 65536 and KParts ∈ 1 … 256 and In ∈ 1 … 16777216 panic "linear_matvec_u8_part: invalid geometry"
    for from partials at [row, part] thread lane let e {
        let i32 n_groups ← Groups ↦ i32
        let i32 k_parts ← KParts ↦ i32
        let i32 in_dim ← In ↦ i32
        mut f32 acc ← 0.0 ∷ f32

        if group_size % 2 ≡ 0 {
            let i32 bytes_per_group ← group_size / 2
            mut i32 g ← part ↦ i32

            while g ≺ n_groups {
                let i32 sb ← scales[[row, g]] ↦ i32
                let i32 s_exp ← (sb ⇒ 3) ∧ 15
                let i32 s_mant ← sb ∧ 7
                let f32 sp ← (0.0078125 ∷ f32) * ((s_exp ∧ 1) ≢ 0 ✓ (2.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 2) ≢ 0 ✓ (4.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 4) ≢ 0 ✓ (16.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 8) ≢ 0 ✓ (256.0 ∷ f32) ✗ (1.0 ∷ f32))
                let f32 s_mag ← (s_exp ≡ 0) ✓ ((s_mant ↦ f32) * (0.001953125 ∷ f32)) ✗ (sp * ((1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)))
                let f32 s_sgn ← ((sb ∧ 128) ≢ 0) ✓ (-1.0 ∷ f32) ✗ (1.0 ∷ f32)
                let f32 local_s ← (s_exp ≡ 15 and s_mant ≡ 7) ✓ nan ✗ (s_mag * s_sgn)

                let i32 w_base ← g * bytes_per_group
                let i32 x_base ← g * group_size
                mut f32 g_acc ← 0.0 ∷ f32
                mut i32 bg ← 0
                while bg ≺ bytes_per_group {
                    let i32 w_idx ← w_base + bg
                    let i32 packed ← weight[[row, w_idx]] ↦ i32
                    let i32 j0 ← x_base + bg * 2
                    let i32 j1 ← j0 + 1

                    let i32 n0 ← packed ∧ 15
                    let f32 m0 ← E2M1_MAG[n0 ∧ 7]
                    let f32 q0 ← ((n0 ∧ 8) ≢ 0) ✓ -m0 ✗ m0

                    let i32 n1 ← (packed ⇒ 4) ∧ 15
                    let f32 m1 ← E2M1_MAG[n1 ∧ 7]
                    let f32 q1 ← ((n1 ∧ 8) ≢ 0) ✓ -m1 ✗ m1

                    g_acc ← g_acc + q0 * x[[j0]] + q1 * x[[j1]]
                    bg ← bg + 1
                }

                acc ← acc + local_s * g_acc
                g ← g + k_parts
            }
        }
        else {
            mut i32 g ← part ↦ i32

            while g ≺ n_groups {
                let i32 sb ← scales[[row, g]] ↦ i32
                let i32 s_exp ← (sb ⇒ 3) ∧ 15
                let i32 s_mant ← sb ∧ 7
                let f32 sp ← (0.0078125 ∷ f32) * ((s_exp ∧ 1) ≢ 0 ✓ (2.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 2) ≢ 0 ✓ (4.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 4) ≢ 0 ✓ (16.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 8) ≢ 0 ✓ (256.0 ∷ f32) ✗ (1.0 ∷ f32))
                let f32 s_mag ← (s_exp ≡ 0) ✓ ((s_mant ↦ f32) * (0.001953125 ∷ f32)) ✗ (sp * ((1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)))
                let f32 s_sgn ← ((sb ∧ 128) ≢ 0) ✓ (-1.0 ∷ f32) ✗ (1.0 ∷ f32)
                let f32 local_s ← (s_exp ≡ 15 and s_mant ≡ 7) ✓ nan ✗ (s_mag * s_sgn)

                let i32 x_base ← g * group_size
                mut f32 g_acc ← 0.0 ∷ f32
                mut i32 k ← 0
                while k ≺ group_size {
                    let i32 jj ← x_base + k
                    let i32 packed ← weight[[row, jj / 2]] ↦ i32
                    let i32 nib ← (jj % 2 ≡ 0) ✓ (packed ∧ 15) ✗ ((packed ⇒ 4) ∧ 15)
                    let f32 m0 ← E2M1_MAG[nib ∧ 7]
                    let f32 q ← ((nib ∧ 8) ≢ 0) ✓ -m0 ✗ m0
                    g_acc ← g_acc + q * x[[jj]]
                    k ← k + 1
                }

                acc ← acc + local_s * g_acc
                g ← g + k_parts
            }
        }

        partials[[row, part]] ← acc * global_scale
    }
}

@ public
kernel linear_matvec_combine<size Out, size KParts>(tensor<f32, [Out, KParts]> partials, mut tensor<f32, [Out]> y) → void {
    assert KParts ∈ 1 … 256 panic "linear_matvec_combine: invalid KParts"
    for from y at [row] thread lane let e {
        let i32 k_parts ← KParts ↦ i32
        mut f32 acc ← 0.0 ∷ f32
        mut i32 p ← 0
        while p ≺ k_parts {
            acc ← acc + partials[[row, p]]
            p ← p + 1
        }
        y[[row]] ← acc
    }
}

# Geometry invariant: Groups * group_size == In.
@ public
kernel linear_matvec_modelopt_u8<size Out, size PackedIn, size Groups, size In>(tensor<u8, [Out, PackedIn]> weight, tensor<u8, [Out, Groups]> scales, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, f32 amax, f32 outer_scale_denominator, i32 group_size) → void {
    assert group_size ∈ 1 … 4096 and outer_scale_denominator ≻ 0.0 panic "linear_matvec_modelopt_u8: invalid geometry"
    let f32 global_scale ← amax / outer_scale_denominator

    for from y at [row] thread lane let e {
        mut f32 acc ← 0.0 ∷ f32

        for exclusive In let j {
            let i32 g ← j / group_size
            let u8 packed ← weight[[row, j / 2]]
            mut i32 nib ← 0

            if j % 2 ≡ 0 {
                nib ← (packed ↦ i32) ∧ 15
            }
            else {
                nib ← ((packed ↦ i32) ⇒ 4) ∧ 15
            }

            let f32 q_mag ← E2M1_MAG[nib ∧ 7]
            let f32 q ← ((nib ∧ 8) ≢ 0) ✓ -q_mag ✗ q_mag

            let i32 sb ← scales[[row, g]] ↦ i32
            let i32 s_sign ← (sb ⇒ 7) ∧ 1
            let i32 s_exp ← (sb ⇒ 3) ∧ 15
            let i32 s_mant ← sb ∧ 7
            mut f32 local_s ← 0.0 ∷ f32

            if s_exp ≡ 15 and s_mant ≡ 7 {
                local_s ← nan
            }
            else {
                if s_exp ≡ 0 {
                    local_s ← (s_mant ↦ f32) * (0.001953125 ∷ f32)
                }
                else {
                    mut f32 pow2 ← 0.0078125 ∷ f32
                    if (s_exp ∧ 1) ≢ 0 {
                        pow2 ← pow2 * (2.0 ∷ f32)
                    }
                    if (s_exp ∧ 2) ≢ 0 {
                        pow2 ← pow2 * (4.0 ∷ f32)
                    }
                    if (s_exp ∧ 4) ≢ 0 {
                        pow2 ← pow2 * (16.0 ∷ f32)
                    }
                    if (s_exp ∧ 8) ≢ 0 {
                        pow2 ← pow2 * (256.0 ∷ f32)
                    }
                    let f32 frac ← (1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)
                    local_s ← pow2 * frac
                }

                if s_sign ≡ 1 {
                    local_s ← -local_s
                }
            }

            let f32 w ← q * local_s * global_scale
            acc ← acc + w * x[[j]]
        }

        y[[row]] ← acc
    }
}

# Geometry invariant: Groups * group_size == In.
@ public
kernel linear_matvec_u32<size Out, size PackedIn, size Groups, size In>(tensor<u32, [Out, PackedIn]> weight, tensor<u8, [Out, Groups]> scales, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, f32 global_scale, i32 group_size) → void {
    assert group_size ∈ 1 … 4096 and Groups ∈ 1 … 65536 and In ∈ 1 … 16777216 panic "linear_matvec_u32: invalid geometry"
    for from y at [row] thread lane let e {
        let i32 n_groups ← Groups ↦ i32
        let i32 in_dim ← In ↦ i32
        mut f32 acc ← 0.0 ∷ f32

        if group_size % 8 ≡ 0 {
            let i32 words_per_group ← group_size / 8
            mut i32 g ← 0

            while g ≺ n_groups {
                let i32 sb ← scales[[row, g]] ↦ i32
                let i32 s_exp ← (sb ⇒ 3) ∧ 15
                let i32 s_mant ← sb ∧ 7
                let f32 sp ← (0.0078125 ∷ f32) * ((s_exp ∧ 1) ≢ 0 ✓ (2.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 2) ≢ 0 ✓ (4.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 4) ≢ 0 ✓ (16.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 8) ≢ 0 ✓ (256.0 ∷ f32) ✗ (1.0 ∷ f32))
                let f32 s_mag ← (s_exp ≡ 0) ✓ ((s_mant ↦ f32) * (0.001953125 ∷ f32)) ✗ (sp * ((1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)))
                let f32 s_sgn ← ((sb ∧ 128) ≢ 0) ✓ (-1.0 ∷ f32) ✗ (1.0 ∷ f32)
                let f32 local_s ← (s_exp ≡ 15 and s_mant ≡ 7) ✓ nan ✗ (s_mag * s_sgn)

                let i32 w_base ← g * words_per_group
                let i32 x_base ← g * group_size
                mut f32 g_acc ← 0.0 ∷ f32
                mut i32 wg ← 0
                while wg ≺ words_per_group {
                    let i32 w_idx ← w_base + wg
                    let u32 w ← weight[[row, w_idx]]
                    let i32 j0 ← x_base + wg * 8
                    let i32 j1 ← j0 + 1
                    let i32 j2 ← j0 + 2
                    let i32 j3 ← j0 + 3
                    let i32 j4 ← j0 + 4
                    let i32 j5 ← j0 + 5
                    let i32 j6 ← j0 + 6
                    let i32 j7 ← j0 + 7

                    let i32 n0 ← (w ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m0 ← E2M1_MAG[n0 ∧ 7]
                    let f32 q0 ← ((n0 ∧ 8) ≢ 0) ✓ -m0 ✗ m0

                    let i32 n1 ← ((w ⇒ (4 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m1 ← E2M1_MAG[n1 ∧ 7]
                    let f32 q1 ← ((n1 ∧ 8) ≢ 0) ✓ -m1 ✗ m1

                    let i32 n2 ← ((w ⇒ (8 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m2 ← E2M1_MAG[n2 ∧ 7]
                    let f32 q2 ← ((n2 ∧ 8) ≢ 0) ✓ -m2 ✗ m2

                    let i32 n3 ← ((w ⇒ (12 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m3 ← E2M1_MAG[n3 ∧ 7]
                    let f32 q3 ← ((n3 ∧ 8) ≢ 0) ✓ -m3 ✗ m3

                    let i32 n4 ← ((w ⇒ (16 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m4 ← E2M1_MAG[n4 ∧ 7]
                    let f32 q4 ← ((n4 ∧ 8) ≢ 0) ✓ -m4 ✗ m4

                    let i32 n5 ← ((w ⇒ (20 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m5 ← E2M1_MAG[n5 ∧ 7]
                    let f32 q5 ← ((n5 ∧ 8) ≢ 0) ✓ -m5 ✗ m5

                    let i32 n6 ← ((w ⇒ (24 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m6 ← E2M1_MAG[n6 ∧ 7]
                    let f32 q6 ← ((n6 ∧ 8) ≢ 0) ✓ -m6 ✗ m6

                    let i32 n7 ← ((w ⇒ (28 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m7 ← E2M1_MAG[n7 ∧ 7]
                    let f32 q7 ← ((n7 ∧ 8) ≢ 0) ✓ -m7 ✗ m7

                    g_acc ← g_acc + q0 * x[[j0]] + q1 * x[[j1]] + q2 * x[[j2]] + q3 * x[[j3]] + q4 * x[[j4]] + q5 * x[[j5]] + q6 * x[[j6]] + q7 * x[[j7]]
                    wg ← wg + 1
                }

                acc ← acc + local_s * g_acc
                g ← g + 1
            }
        }
        else {
            mut i32 g ← 0

            while g ≺ n_groups {
                let i32 sb ← scales[[row, g]] ↦ i32
                let i32 s_exp ← (sb ⇒ 3) ∧ 15
                let i32 s_mant ← sb ∧ 7
                let f32 sp ← (0.0078125 ∷ f32) * ((s_exp ∧ 1) ≢ 0 ✓ (2.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 2) ≢ 0 ✓ (4.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 4) ≢ 0 ✓ (16.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 8) ≢ 0 ✓ (256.0 ∷ f32) ✗ (1.0 ∷ f32))
                let f32 s_mag ← (s_exp ≡ 0) ✓ ((s_mant ↦ f32) * (0.001953125 ∷ f32)) ✗ (sp * ((1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)))
                let f32 s_sgn ← ((sb ∧ 128) ≢ 0) ✓ (-1.0 ∷ f32) ✗ (1.0 ∷ f32)
                let f32 local_s ← (s_exp ≡ 15 and s_mant ≡ 7) ✓ nan ✗ (s_mag * s_sgn)

                let i32 x_base ← g * group_size
                mut f32 g_acc ← 0.0 ∷ f32
                mut i32 k ← 0
                while k ≺ group_size {
                    let i32 jj ← x_base + k
                    let u32 w0 ← weight[[row, jj / 8]]
                    let i32 lane ← jj % 8
                    mut u32 raw_n ← w0 ∧ (15 ∷ u32)
                    if lane ≡ 1 { raw_n ← (w0 ⇒ (4 ∷ u32)) ∧ (15 ∷ u32) }
                    elif lane ≡ 2 { raw_n ← (w0 ⇒ (8 ∷ u32)) ∧ (15 ∷ u32) }
                    elif lane ≡ 3 { raw_n ← (w0 ⇒ (12 ∷ u32)) ∧ (15 ∷ u32) }
                    elif lane ≡ 4 { raw_n ← (w0 ⇒ (16 ∷ u32)) ∧ (15 ∷ u32) }
                    elif lane ≡ 5 { raw_n ← (w0 ⇒ (20 ∷ u32)) ∧ (15 ∷ u32) }
                    elif lane ≡ 6 { raw_n ← (w0 ⇒ (24 ∷ u32)) ∧ (15 ∷ u32) }
                    elif lane ≡ 7 { raw_n ← (w0 ⇒ (28 ∷ u32)) ∧ (15 ∷ u32) }
                    let i32 nib ← raw_n ↦ wrapping<i32>
                    let f32 m0 ← E2M1_MAG[nib ∧ 7]
                    let f32 q ← ((nib ∧ 8) ≢ 0) ✓ -m0 ✗ m0
                    g_acc ← g_acc + q * x[[jj]]
                    k ← k + 1
                }

                acc ← acc + local_s * g_acc
                g ← g + 1
            }
        }

        y[[row]] ← acc * global_scale
    }
}

# Geometry invariant: Groups * group_size == In.
@ public
kernel linear_matvec_u32_part<size Out, size PackedIn, size Groups, size In, size KParts>(tensor<u32, [Out, PackedIn]> weight, tensor<u8, [Out, Groups]> scales, tensor<f32, [In]> x, mut tensor<f32, [Out, KParts]> partials, f32 global_scale, i32 group_size) → void {
    assert group_size ∈ 1 … 4096 and Groups ∈ 1 … 65536 and KParts ∈ 1 … 256 and In ∈ 1 … 16777216 panic "linear_matvec_u32_part: invalid geometry"
    for from partials at [row, part] thread lane let e {
        let i32 n_groups ← Groups ↦ i32
        let i32 k_parts ← KParts ↦ i32
        let i32 in_dim ← In ↦ i32
        mut f32 acc ← 0.0 ∷ f32

        if group_size % 8 ≡ 0 {
            let i32 words_per_group ← group_size / 8
            mut i32 g ← part ↦ i32

            while g ≺ n_groups {
                let i32 sb ← scales[[row, g]] ↦ i32
                let i32 s_exp ← (sb ⇒ 3) ∧ 15
                let i32 s_mant ← sb ∧ 7
                let f32 sp ← (0.0078125 ∷ f32) * ((s_exp ∧ 1) ≢ 0 ✓ (2.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 2) ≢ 0 ✓ (4.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 4) ≢ 0 ✓ (16.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 8) ≢ 0 ✓ (256.0 ∷ f32) ✗ (1.0 ∷ f32))
                let f32 s_mag ← (s_exp ≡ 0) ✓ ((s_mant ↦ f32) * (0.001953125 ∷ f32)) ✗ (sp * ((1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)))
                let f32 s_sgn ← ((sb ∧ 128) ≢ 0) ✓ (-1.0 ∷ f32) ✗ (1.0 ∷ f32)
                let f32 local_s ← (s_exp ≡ 15 and s_mant ≡ 7) ✓ nan ✗ (s_mag * s_sgn)

                let i32 w_base ← g * words_per_group
                let i32 x_base ← g * group_size
                mut f32 g_acc ← 0.0 ∷ f32
                mut i32 wg ← 0
                while wg ≺ words_per_group {
                    let i32 w_idx ← w_base + wg
                    let u32 w ← weight[[row, w_idx]]
                    let i32 j0 ← x_base + wg * 8
                    let i32 j1 ← j0 + 1
                    let i32 j2 ← j0 + 2
                    let i32 j3 ← j0 + 3
                    let i32 j4 ← j0 + 4
                    let i32 j5 ← j0 + 5
                    let i32 j6 ← j0 + 6
                    let i32 j7 ← j0 + 7

                    let i32 n0 ← (w ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m0 ← E2M1_MAG[n0 ∧ 7]
                    let f32 q0 ← ((n0 ∧ 8) ≢ 0) ✓ -m0 ✗ m0

                    let i32 n1 ← ((w ⇒ (4 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m1 ← E2M1_MAG[n1 ∧ 7]
                    let f32 q1 ← ((n1 ∧ 8) ≢ 0) ✓ -m1 ✗ m1

                    let i32 n2 ← ((w ⇒ (8 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m2 ← E2M1_MAG[n2 ∧ 7]
                    let f32 q2 ← ((n2 ∧ 8) ≢ 0) ✓ -m2 ✗ m2

                    let i32 n3 ← ((w ⇒ (12 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m3 ← E2M1_MAG[n3 ∧ 7]
                    let f32 q3 ← ((n3 ∧ 8) ≢ 0) ✓ -m3 ✗ m3

                    let i32 n4 ← ((w ⇒ (16 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m4 ← E2M1_MAG[n4 ∧ 7]
                    let f32 q4 ← ((n4 ∧ 8) ≢ 0) ✓ -m4 ✗ m4

                    let i32 n5 ← ((w ⇒ (20 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m5 ← E2M1_MAG[n5 ∧ 7]
                    let f32 q5 ← ((n5 ∧ 8) ≢ 0) ✓ -m5 ✗ m5

                    let i32 n6 ← ((w ⇒ (24 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m6 ← E2M1_MAG[n6 ∧ 7]
                    let f32 q6 ← ((n6 ∧ 8) ≢ 0) ✓ -m6 ✗ m6

                    let i32 n7 ← ((w ⇒ (28 ∷ u32)) ∧ (15 ∷ u32)) ↦ wrapping<i32>
                    let f32 m7 ← E2M1_MAG[n7 ∧ 7]
                    let f32 q7 ← ((n7 ∧ 8) ≢ 0) ✓ -m7 ✗ m7

                    g_acc ← g_acc + q0 * x[[j0]] + q1 * x[[j1]] + q2 * x[[j2]] + q3 * x[[j3]] + q4 * x[[j4]] + q5 * x[[j5]] + q6 * x[[j6]] + q7 * x[[j7]]
                    wg ← wg + 1
                }

                acc ← acc + local_s * g_acc
                g ← g + k_parts
            }
        }
        else {
            mut i32 g ← part ↦ i32

            while g ≺ n_groups {
                let i32 sb ← scales[[row, g]] ↦ i32
                let i32 s_exp ← (sb ⇒ 3) ∧ 15
                let i32 s_mant ← sb ∧ 7
                let f32 sp ← (0.0078125 ∷ f32) * ((s_exp ∧ 1) ≢ 0 ✓ (2.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 2) ≢ 0 ✓ (4.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 4) ≢ 0 ✓ (16.0 ∷ f32) ✗ (1.0 ∷ f32)) * ((s_exp ∧ 8) ≢ 0 ✓ (256.0 ∷ f32) ✗ (1.0 ∷ f32))
                let f32 s_mag ← (s_exp ≡ 0) ✓ ((s_mant ↦ f32) * (0.001953125 ∷ f32)) ✗ (sp * ((1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)))
                let f32 s_sgn ← ((sb ∧ 128) ≢ 0) ✓ (-1.0 ∷ f32) ✗ (1.0 ∷ f32)
                let f32 local_s ← (s_exp ≡ 15 and s_mant ≡ 7) ✓ nan ✗ (s_mag * s_sgn)

                let i32 x_base ← g * group_size
                mut f32 g_acc ← 0.0 ∷ f32
                mut i32 k ← 0
                while k ≺ group_size {
                    let i32 jj ← x_base + k
                    let u32 w0 ← weight[[row, jj / 8]]
                    let i32 lane ← jj % 8
                    mut u32 raw_n ← w0 ∧ (15 ∷ u32)
                    if lane ≡ 1 { raw_n ← (w0 ⇒ (4 ∷ u32)) ∧ (15 ∷ u32) }
                    elif lane ≡ 2 { raw_n ← (w0 ⇒ (8 ∷ u32)) ∧ (15 ∷ u32) }
                    elif lane ≡ 3 { raw_n ← (w0 ⇒ (12 ∷ u32)) ∧ (15 ∷ u32) }
                    elif lane ≡ 4 { raw_n ← (w0 ⇒ (16 ∷ u32)) ∧ (15 ∷ u32) }
                    elif lane ≡ 5 { raw_n ← (w0 ⇒ (20 ∷ u32)) ∧ (15 ∷ u32) }
                    elif lane ≡ 6 { raw_n ← (w0 ⇒ (24 ∷ u32)) ∧ (15 ∷ u32) }
                    elif lane ≡ 7 { raw_n ← (w0 ⇒ (28 ∷ u32)) ∧ (15 ∷ u32) }
                    let i32 nib ← raw_n ↦ wrapping<i32>
                    let f32 m0 ← E2M1_MAG[nib ∧ 7]
                    let f32 q ← ((nib ∧ 8) ≢ 0) ✓ -m0 ✗ m0
                    g_acc ← g_acc + q * x[[jj]]
                    k ← k + 1
                }

                acc ← acc + local_s * g_acc
                g ← g + k_parts
            }
        }

        partials[[row, part]] ← acc * global_scale
    }
}

@ public
kernel linear_matmul_u8<size B, size Out, size PackedIn, size Groups, size In>(tensor<u8, [Out, PackedIn]> weight, tensor<u8, [Out, Groups]> scales, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y, f32 global_scale, i32 group_size) → void {
    assert group_size ∈ 1 … 4096 panic "linear_matmul_u8: invalid group_size"
    for from y at [b_idx, row] thread lane let e {
        let i32 n_groups ← In / group_size
        mut f32 acc ← 0.0 ∷ f32

        for exclusive n_groups let g {
            let i32 j_base ← g * group_size
            if j_base ≥ 0 and j_base + group_size ≤ In {
                let i32 sb ← scales[[row, g]] ↦ i32
                let i32 s_sign ← (sb ⇒ 7) ∧ 1
                let i32 s_exp ← (sb ⇒ 3) ∧ 15
                let i32 s_mant ← sb ∧ 7
                mut f32 local_s ← 0.0 ∷ f32

                if s_exp ≡ 15 and s_mant ≡ 7 {
                    local_s ← nan
                }
                else {
                    if s_exp ≡ 0 {
                        local_s ← (s_mant ↦ f32) * (0.001953125 ∷ f32)
                    }
                    else {
                        mut f32 pow2 ← 0.0078125 ∷ f32
                        if (s_exp ∧ 1) ≢ 0 {
                            pow2 ← pow2 * (2.0 ∷ f32)
                        }
                        if (s_exp ∧ 2) ≢ 0 {
                            pow2 ← pow2 * (4.0 ∷ f32)
                        }
                        if (s_exp ∧ 4) ≢ 0 {
                            pow2 ← pow2 * (16.0 ∷ f32)
                        }
                        if (s_exp ∧ 8) ≢ 0 {
                            pow2 ← pow2 * (256.0 ∷ f32)
                        }
                        let f32 frac ← (1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)
                        local_s ← pow2 * frac
                    }

                    if s_sign ≡ 1 {
                        local_s ← -local_s
                    }
                }

                let f32 group_scale ← local_s * global_scale

                for exclusive group_size let k {
                    let i32 j ← j_base + k
                    let u8 packed ← weight[[row, j / 2]]
                    mut i32 nib ← 0

                    if j % 2 ≡ 0 {
                        nib ← (packed ↦ i32) ∧ 15
                    }
                    else {
                        nib ← ((packed ↦ i32) ⇒ 4) ∧ 15
                    }

                    let f32 q_mag ← E2M1_MAG[nib ∧ 7]
                    let f32 q ← ((nib ∧ 8) ≢ 0) ✓ -q_mag ✗ q_mag

                    acc ← acc + (q * group_scale) * x[[b_idx, j_base + k]]
                }
            }
        }

        y[[b_idx, row]] ← acc
    }
}

@ public
kernel linear_matmul_modelopt_u8<size B, size Out, size PackedIn, size Groups, size In>(tensor<u8, [Out, PackedIn]> weight, tensor<u8, [Out, Groups]> scales, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y, f32 amax, f32 outer_scale_denominator, i32 group_size) → void {
    assert group_size ∈ 1 … 4096 and outer_scale_denominator ≻ 0.0 panic "linear_matmul_modelopt_u8: invalid geometry"
    let f32 global_scale ← amax / outer_scale_denominator

    for from y at [b_idx, row] thread lane let e {
        let i32 n_groups ← In / group_size
        mut f32 acc ← 0.0 ∷ f32

        for exclusive n_groups let g {
            let i32 j_base ← g * group_size
            if j_base ≥ 0 and j_base + group_size ≤ In {
                let i32 sb ← scales[[row, g]] ↦ i32
                let i32 s_sign ← (sb ⇒ 7) ∧ 1
                let i32 s_exp ← (sb ⇒ 3) ∧ 15
                let i32 s_mant ← sb ∧ 7
                mut f32 local_s ← 0.0 ∷ f32

                if s_exp ≡ 15 and s_mant ≡ 7 {
                    local_s ← nan
                }
                else {
                    if s_exp ≡ 0 {
                        local_s ← (s_mant ↦ f32) * (0.001953125 ∷ f32)
                    }
                    else {
                        mut f32 pow2 ← 0.0078125 ∷ f32
                        if (s_exp ∧ 1) ≢ 0 {
                            pow2 ← pow2 * (2.0 ∷ f32)
                        }
                        if (s_exp ∧ 2) ≢ 0 {
                            pow2 ← pow2 * (4.0 ∷ f32)
                        }
                        if (s_exp ∧ 4) ≢ 0 {
                            pow2 ← pow2 * (16.0 ∷ f32)
                        }
                        if (s_exp ∧ 8) ≢ 0 {
                            pow2 ← pow2 * (256.0 ∷ f32)
                        }
                        let f32 frac ← (1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)
                        local_s ← pow2 * frac
                    }

                    if s_sign ≡ 1 {
                        local_s ← -local_s
                    }
                }

                let f32 group_scale ← local_s * global_scale

                for exclusive group_size let k {
                    let i32 j ← j_base + k
                    let u8 packed ← weight[[row, j / 2]]
                    mut i32 nib ← 0

                    if j % 2 ≡ 0 {
                        nib ← (packed ↦ i32) ∧ 15
                    }
                    else {
                        nib ← ((packed ↦ i32) ⇒ 4) ∧ 15
                    }

                    let f32 q_mag ← E2M1_MAG[nib ∧ 7]
                    let f32 q ← ((nib ∧ 8) ≢ 0) ✓ -q_mag ✗ q_mag

                    acc ← acc + (q * group_scale) * x[[b_idx, j_base + k]]
                }
            }
        }

        y[[b_idx, row]] ← acc
    }
}

@ public
kernel linear_matmul_u32<size B, size Out, size PackedIn, size Groups, size In>(tensor<u32, [Out, PackedIn]> weight, tensor<u8, [Out, Groups]> scales, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y, f32 global_scale, i32 group_size) → void {
    assert group_size ∈ 1 … 4096 panic "linear_matmul_u32: invalid group_size"
    for from y at [b_idx, row] thread lane let e {
        let i32 n_groups ← In / group_size
        mut f32 acc ← 0.0 ∷ f32

        for exclusive n_groups let g {
            let i32 j_base ← g * group_size
            if j_base ≥ 0 and j_base + group_size ≤ In {
                let i32 sb ← scales[[row, g]] ↦ i32
                let i32 s_sign ← (sb ⇒ 7) ∧ 1
                let i32 s_exp ← (sb ⇒ 3) ∧ 15
                let i32 s_mant ← sb ∧ 7
                mut f32 local_s ← 0.0 ∷ f32

                if s_exp ≡ 15 and s_mant ≡ 7 {
                    local_s ← nan
                }
                else {
                    if s_exp ≡ 0 {
                        local_s ← (s_mant ↦ f32) * (0.001953125 ∷ f32)
                    }
                    else {
                        mut f32 pow2 ← 0.0078125 ∷ f32
                        if (s_exp ∧ 1) ≢ 0 {
                            pow2 ← pow2 * (2.0 ∷ f32)
                        }
                        if (s_exp ∧ 2) ≢ 0 {
                            pow2 ← pow2 * (4.0 ∷ f32)
                        }
                        if (s_exp ∧ 4) ≢ 0 {
                            pow2 ← pow2 * (16.0 ∷ f32)
                        }
                        if (s_exp ∧ 8) ≢ 0 {
                            pow2 ← pow2 * (256.0 ∷ f32)
                        }
                        let f32 frac ← (1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)
                        local_s ← pow2 * frac
                    }

                    if s_sign ≡ 1 {
                        local_s ← -local_s
                    }
                }

                let f32 group_scale ← local_s * global_scale

                for exclusive group_size let k {
                    let i32 j ← j_base + k
                    let i32 word_idx ← j / 8
                    let i32 nib_lane ← j % 8
                    let u32 w0 ← weight[[row, word_idx]]
                    mut u32 nib_u32 ← 0 ∷ u32

                    if nib_lane ≡ 0 {
                        nib_u32 ← w0 ∧ (15 ∷ u32)
                    }
                    elif nib_lane ≡ 1 {
                        nib_u32 ← (w0 ⇒ (4 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif nib_lane ≡ 2 {
                        nib_u32 ← (w0 ⇒ (8 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif nib_lane ≡ 3 {
                        nib_u32 ← (w0 ⇒ (12 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif nib_lane ≡ 4 {
                        nib_u32 ← (w0 ⇒ (16 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif nib_lane ≡ 5 {
                        nib_u32 ← (w0 ⇒ (20 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif nib_lane ≡ 6 {
                        nib_u32 ← (w0 ⇒ (24 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    else {
                        nib_u32 ← (w0 ⇒ (28 ∷ u32)) ∧ (15 ∷ u32)
                    }

                    let i32 nib ← nib_u32 ↦ wrapping<i32>
                    let f32 q_mag ← E2M1_MAG[nib ∧ 7]
                    let f32 q ← ((nib ∧ 8) ≢ 0) ✓ -q_mag ✗ q_mag

                    acc ← acc + (q * group_scale) * x[[b_idx, j_base + k]]
                }
            }
        }

        y[[b_idx, row]] ← acc
    }
}

# -------------------------------------------------------------------------
# Shape-generic 3D @ kernel routed-expert contractions (CPU + Metal)
# -------------------------------------------------------------------------

@ public
kernel routed_expert_matvec_u8<size E, size Out, size PackedIn, size Groups, size In>(tensor<u8, [E, Out, PackedIn]> weight, tensor<u8, [E, Out, Groups]> scales, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx, f32 global_scale, i32 group_size) → void {
    assert group_size ∈ 1 … 4096 and expert_idx ≥ 0 and expert_idx ≺ E panic "routed_expert_matvec_u8: invalid geometry or expert_idx"
    for from y at [row] thread lane let e {
        mut f32 acc ← 0.0 ∷ f32

        for exclusive In let j {
            let i32 g ← j / group_size
            let u8 packed ← weight[[expert_idx, row, j / 2]]
            mut i32 nib ← 0

            if j % 2 ≡ 0 {
                nib ← (packed ↦ i32) ∧ 15
            }
            else {
                nib ← ((packed ↦ i32) ⇒ 4) ∧ 15
            }

            let f32 q_mag ← E2M1_MAG[nib ∧ 7]
            let f32 q ← ((nib ∧ 8) ≢ 0) ✓ -q_mag ✗ q_mag

            let i32 sb ← scales[[expert_idx, row, g]] ↦ i32
            let i32 s_sign ← (sb ⇒ 7) ∧ 1
            let i32 s_exp ← (sb ⇒ 3) ∧ 15
            let i32 s_mant ← sb ∧ 7
            mut f32 local_s ← 0.0 ∷ f32

            if s_exp ≡ 15 and s_mant ≡ 7 {
                local_s ← nan
            }
            else {
                if s_exp ≡ 0 {
                    local_s ← (s_mant ↦ f32) * (0.001953125 ∷ f32)
                }
                else {
                    mut f32 pow2 ← 0.0078125 ∷ f32
                    if (s_exp ∧ 1) ≢ 0 {
                        pow2 ← pow2 * (2.0 ∷ f32)
                    }
                    if (s_exp ∧ 2) ≢ 0 {
                        pow2 ← pow2 * (4.0 ∷ f32)
                    }
                    if (s_exp ∧ 4) ≢ 0 {
                        pow2 ← pow2 * (16.0 ∷ f32)
                    }
                    if (s_exp ∧ 8) ≢ 0 {
                        pow2 ← pow2 * (256.0 ∷ f32)
                    }
                    let f32 frac ← (1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)
                    local_s ← pow2 * frac
                }

                if s_sign ≡ 1 {
                    local_s ← -local_s
                }
            }

            let f32 w ← q * local_s * global_scale
            acc ← acc + w * x[[j]]
        }

        y[[row]] ← acc
    }
}

@ public
kernel routed_expert_matvec_modelopt_u8<size E, size Out, size PackedIn, size Groups, size In>(tensor<u8, [E, Out, PackedIn]> weight, tensor<u8, [E, Out, Groups]> scales, tensor<f32, [E]> amax, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx, f32 outer_scale_denominator, i32 group_size) → void {
    assert group_size ∈ 1 … 4096 and expert_idx ≥ 0 and expert_idx ≺ E and outer_scale_denominator ≻ 0.0 panic "routed_expert_matvec_modelopt_u8: invalid geometry or expert_idx"
    for from y at [row] thread lane let e {
        let f32 global_scale ← amax[[expert_idx]] / outer_scale_denominator
        mut f32 acc ← 0.0 ∷ f32

        for exclusive In let j {
            let i32 g ← j / group_size
            let u8 packed ← weight[[expert_idx, row, j / 2]]
            mut i32 nib ← 0

            if j % 2 ≡ 0 {
                nib ← (packed ↦ i32) ∧ 15
            }
            else {
                nib ← ((packed ↦ i32) ⇒ 4) ∧ 15
            }

            let f32 q_mag ← E2M1_MAG[nib ∧ 7]
            let f32 q ← ((nib ∧ 8) ≢ 0) ✓ -q_mag ✗ q_mag

            let i32 sb ← scales[[expert_idx, row, g]] ↦ i32
            let i32 s_sign ← (sb ⇒ 7) ∧ 1
            let i32 s_exp ← (sb ⇒ 3) ∧ 15
            let i32 s_mant ← sb ∧ 7
            mut f32 local_s ← 0.0 ∷ f32

            if s_exp ≡ 15 and s_mant ≡ 7 {
                local_s ← nan
            }
            else {
                if s_exp ≡ 0 {
                    local_s ← (s_mant ↦ f32) * (0.001953125 ∷ f32)
                }
                else {
                    mut f32 pow2 ← 0.0078125 ∷ f32
                    if (s_exp ∧ 1) ≢ 0 {
                        pow2 ← pow2 * (2.0 ∷ f32)
                    }
                    if (s_exp ∧ 2) ≢ 0 {
                        pow2 ← pow2 * (4.0 ∷ f32)
                    }
                    if (s_exp ∧ 4) ≢ 0 {
                        pow2 ← pow2 * (16.0 ∷ f32)
                    }
                    if (s_exp ∧ 8) ≢ 0 {
                        pow2 ← pow2 * (256.0 ∷ f32)
                    }
                    let f32 frac ← (1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)
                    local_s ← pow2 * frac
                }

                if s_sign ≡ 1 {
                    local_s ← -local_s
                }
            }

            let f32 w ← q * local_s * global_scale
            acc ← acc + w * x[[j]]
        }

        y[[row]] ← acc
    }
}

@ public
kernel routed_expert_matvec_u32<size E, size Out, size PackedIn, size Groups, size In>(tensor<u32, [E, Out, PackedIn]> weight, tensor<u8, [E, Out, Groups]> scales, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 expert_idx, f32 global_scale, i32 group_size) → void {
    assert group_size ∈ 1 … 4096 and expert_idx ≥ 0 and expert_idx ≺ E panic "routed_expert_matvec_u32: invalid geometry or expert_idx"
    for from y at [row] thread lane let e {
        mut f32 acc ← 0.0 ∷ f32

        for exclusive In let j {
            let i32 g ← j / group_size
            let i32 word_idx ← j / 8
            let i32 nib_lane ← j % 8
            let u32 w0 ← weight[[expert_idx, row, word_idx]]
            mut u32 nib_u32 ← 0 ∷ u32

            if nib_lane ≡ 0 {
                nib_u32 ← w0 ∧ (15 ∷ u32)
            }
            elif nib_lane ≡ 1 {
                nib_u32 ← (w0 ⇒ (4 ∷ u32)) ∧ (15 ∷ u32)
            }
            elif nib_lane ≡ 2 {
                nib_u32 ← (w0 ⇒ (8 ∷ u32)) ∧ (15 ∷ u32)
            }
            elif nib_lane ≡ 3 {
                nib_u32 ← (w0 ⇒ (12 ∷ u32)) ∧ (15 ∷ u32)
            }
            elif nib_lane ≡ 4 {
                nib_u32 ← (w0 ⇒ (16 ∷ u32)) ∧ (15 ∷ u32)
            }
            elif nib_lane ≡ 5 {
                nib_u32 ← (w0 ⇒ (20 ∷ u32)) ∧ (15 ∷ u32)
            }
            elif nib_lane ≡ 6 {
                nib_u32 ← (w0 ⇒ (24 ∷ u32)) ∧ (15 ∷ u32)
            }
            else {
                nib_u32 ← (w0 ⇒ (28 ∷ u32)) ∧ (15 ∷ u32)
            }

            let i32 nib ← nib_u32 ↦ wrapping<i32>
            let f32 q_mag ← E2M1_MAG[nib ∧ 7]
            let f32 q ← ((nib ∧ 8) ≢ 0) ✓ -q_mag ✗ q_mag

            let i32 sb ← scales[[expert_idx, row, g]] ↦ i32
            let i32 s_sign ← (sb ⇒ 7) ∧ 1
            let i32 s_exp ← (sb ⇒ 3) ∧ 15
            let i32 s_mant ← sb ∧ 7
            mut f32 local_s ← 0.0 ∷ f32

            if s_exp ≡ 15 and s_mant ≡ 7 {
                local_s ← nan
            }
            else {
                if s_exp ≡ 0 {
                    local_s ← (s_mant ↦ f32) * (0.001953125 ∷ f32)
                }
                else {
                    mut f32 pow2 ← 0.0078125 ∷ f32
                    if (s_exp ∧ 1) ≢ 0 {
                        pow2 ← pow2 * (2.0 ∷ f32)
                    }
                    if (s_exp ∧ 2) ≢ 0 {
                        pow2 ← pow2 * (4.0 ∷ f32)
                    }
                    if (s_exp ∧ 4) ≢ 0 {
                        pow2 ← pow2 * (16.0 ∷ f32)
                    }
                    if (s_exp ∧ 8) ≢ 0 {
                        pow2 ← pow2 * (256.0 ∷ f32)
                    }
                    let f32 frac ← (1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)
                    local_s ← pow2 * frac
                }

                if s_sign ≡ 1 {
                    local_s ← -local_s
                }
            }

            let f32 w ← q * local_s * global_scale
            acc ← acc + w * x[[j]]
        }

        y[[row]] ← acc
    }
}

@ public
kernel routed_expert_matmul_u8<size B, size E, size Out, size PackedIn, size Groups, size In>(tensor<u8, [E, Out, PackedIn]> weight, tensor<u8, [E, Out, Groups]> scales, tensor<f32, [B, In]> x, tensor<i32, [B]> expert_indices, mut tensor<f32, [B, Out]> y, f32 global_scale, i32 group_size) → void {
    assert group_size ∈ 1 … 4096 panic "routed_expert_matmul_u8: invalid group_size"
    for from y at [b_idx, row] thread lane let e {
        let i32 ee ← expert_indices[[b_idx]]
        if ee ≥ 0 and ee ≺ E {
            let i32 n_groups ← In / group_size
            mut f32 acc ← 0.0 ∷ f32

            for exclusive n_groups let g {
                let i32 j_base ← g * group_size
                if j_base ≥ 0 and j_base + group_size ≤ In {
                    let i32 sb ← scales[[ee, row, g]] ↦ i32
                    let i32 s_sign ← (sb ⇒ 7) ∧ 1
                    let i32 s_exp ← (sb ⇒ 3) ∧ 15
                    let i32 s_mant ← sb ∧ 7
                    mut f32 local_s ← 0.0 ∷ f32

                    if s_exp ≡ 15 and s_mant ≡ 7 {
                        local_s ← nan
                    }
                    else {
                        if s_exp ≡ 0 {
                            local_s ← (s_mant ↦ f32) * (0.001953125 ∷ f32)
                        }
                        else {
                            mut f32 pow2 ← 0.0078125 ∷ f32
                            if (s_exp ∧ 1) ≢ 0 {
                                pow2 ← pow2 * (2.0 ∷ f32)
                            }
                            if (s_exp ∧ 2) ≢ 0 {
                                pow2 ← pow2 * (4.0 ∷ f32)
                            }
                            if (s_exp ∧ 4) ≢ 0 {
                                pow2 ← pow2 * (16.0 ∷ f32)
                            }
                            if (s_exp ∧ 8) ≢ 0 {
                                pow2 ← pow2 * (256.0 ∷ f32)
                            }
                            let f32 frac ← (1.0 ∷ f32) + (s_mant ↦ f32) * (0.125 ∷ f32)
                            local_s ← pow2 * frac
                        }

                        if s_sign ≡ 1 {
                            local_s ← -local_s
                        }
                    }

                    let f32 group_scale ← local_s * global_scale

                    for exclusive group_size let k {
                        let i32 j ← j_base + k
                        let u8 packed ← weight[[ee, row, j / 2]]
                        mut i32 nib ← 0

                        if j % 2 ≡ 0 {
                            nib ← (packed ↦ i32) ∧ 15
                        }
                        else {
                            nib ← ((packed ↦ i32) ⇒ 4) ∧ 15
                        }

                        let f32 q_mag ← E2M1_MAG[nib ∧ 7]
                        let f32 q ← ((nib ∧ 8) ≢ 0) ✓ -q_mag ✗ q_mag

                        acc ← acc + (q * group_scale) * x[[b_idx, j_base + k]]
                    }
                }
            }

            y[[b_idx, row]] ← acc
        }
    }
}

