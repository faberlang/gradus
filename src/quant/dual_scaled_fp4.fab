                                pow2 ← pow2 * (2.0 ∷ f32)
                            }
                            if (s_exp ∧ 2) ≢ 0 {
                                pow2 ← pow2 * (4.0 ∷ f32)
                            }
                            if (s_exp ∧ 4) ≢ 0 {
                                pow2 ← pow2 * (16.0 ∷ f32)
                            }
                            if (s_exp ∧ 8) ≢ 0 {
                                pow2 ← pow2 * (256.0 ∷ f32)
