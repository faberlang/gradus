+++ toml
locale = "en"

+++ faber test
# Co-located package tests for GroupAffine native f16 scales and biases
# kernels against host reference. Split from group_affine.fab to keep each
# test module under the 64-entry generic monomorphization cap.

import from "gradus:quant/group_affine" let ga

fn close(f32 a, f32 b) → bool {
    let f32 diff ← (a - b).abs()
    let f32 tol ← (1.0e-5 ∷ f32) + (1.0e-4 ∷ f32) * b.abs()
    return diff ≤ tol
}

test "GroupAffine native f16 scales and biases kernels match host ref across matvec, split-K, and matmul" {
    let list<u32> w_u32 ← [0x04030201 ∷ u32, 0x08070605 ∷ u32, 0x1e140a00 ∷ u32, 0x014080ff ∷ u32]
    let list<u32> w4_u32 ← [0x87654321 ∷ u32, 0xfedcba98 ∷ u32]
    let list<u8> w_u8 ← [0x21 ∷ u8, 0x43 ∷ u8, 0xf0 ∷ u8, 0x7a ∷ u8]
    let list<f16> s_f16 ← [(0.5 ∷ f32) ↦ f16, (2.0 ∷ f32) ↦ f16, (0.25 ∷ f32) ↦ f16, (-0.5 ∷ f32) ↦ f16]
    let list<f16> b_f16 ← [(-1.0 ∷ f32) ↦ f16, (0.25 ∷ f32) ↦ f16, (0.0 ∷ f32) ↦ f16, (1.0 ∷ f32) ↦ f16]
    let list<f16> s_u8_f16 ← [(0.5 ∷ f32) ↦ f16, (-0.25 ∷ f32) ↦ f16]
    let list<f16> b_u8_f16 ← [(-1.5 ∷ f32) ↦ f16, (2.0 ∷ f32) ↦ f16]
    let list<f32> x_u32 ← [1.0, -2.0, 0.5, 4.0, -1.0, 2.0, -0.5, 3.0]
    let list<f32> x_u32_mat ← [1.0, -2.0, 0.5, 4.0, -1.0, 2.0, -0.5, 3.0, 0.5, 1.0, -1.0, 2.0, 0.25, -0.5, 1.5, -1.0]
    let list<f32> x_u8 ← [1.0, -2.0, 0.5, 4.0]
    let list<f32> x_u8_mat ← [1.0, -2.0, 0.5, 4.0, -1.0, 0.5, 2.0, -3.0]

    do {
        let ga.GroupAffineSpec spec_u32 ← ga.admit_spec_with_scale(2, 8, 8, 4, variant ga.PackKind.PackU32, variant ga.ScaleDtype.ScaleF16)
        let ga.GroupAffineSpec spec4_u32 ← ga.admit_spec_with_scale(2, 8, 4, 4, variant ga.PackKind.PackU32, variant ga.ScaleDtype.ScaleF16)
        let ga.GroupAffineSpec spec_u8 ← ga.admit_spec_with_scale(2, 4, 4, 4, variant ga.PackKind.PackU8, variant ga.ScaleDtype.ScaleF16)
        match spec_u32.scale_dtype {
            case ScaleF16 {
                pass
            }
            default {
                assert false
            }
        }

        let list<f32> ref_mv_u32 ← ga.ref_matvec(2, 8, ga.ref_dequantize_u32_f16(spec_u32, w_u32, s_f16, b_f16), x_u32)
        let list<f32> ref_mv_u32_4 ← ga.ref_matvec(2, 8, ga.ref_dequantize_u32_f16(spec4_u32, w4_u32, s_f16, b_f16), x_u32)
        let list<f32> ref_mm_u32 ← ga.ref_matmul(2, 2, 8, ga.ref_dequantize_u32_f16(spec_u32, w_u32, s_f16, b_f16), x_u32_mat)
        let list<f32> ref_mv_u8 ← ga.ref_matvec(2, 4, ga.ref_dequantize_u8_f16(spec_u8, w_u8, s_u8_f16, b_u8_f16), x_u8)
        let list<f32> ref_mm_u8 ← ga.ref_matmul(2, 2, 4, ga.ref_dequantize_u8_f16(spec_u8, w_u8, s_u8_f16, b_u8_f16), x_u8_mat)

        mut tensor<u32, [2, 2]> tw_u32 ← tu32[2, 2] {}
        tw_u32[[0, 0]] ← w_u32[0]
        tw_u32[[0, 1]] ← w_u32[1]
        tw_u32[[1, 0]] ← w_u32[2]
        tw_u32[[1, 1]] ← w_u32[3]
        mut tensor<u32, [2, 1]> tw4_u32 ← tu32[2, 1] {}
        tw4_u32[[0, 0]] ← w4_u32[0]
        tw4_u32[[1, 0]] ← w4_u32[1]
        mut tensor<u8, [2, 2]> tw_u8 ← tu8[2, 2] {}
        tw_u8[[0, 0]] ← w_u8[0]
        tw_u8[[0, 1]] ← w_u8[1]
        tw_u8[[1, 0]] ← w_u8[2]
        tw_u8[[1, 1]] ← w_u8[3]

        mut tensor<f16, [2, 2]> ts_u32 ← tf16[2, 2] {}
        mut tensor<f16, [2, 2]> tb_u32 ← tf16[2, 2] {}
        for exclusive 2 let r {
            for exclusive 2 let g {
                ts_u32[[r, g]] ← s_f16[r * 2 + g]
                tb_u32[[r, g]] ← b_f16[r * 2 + g]
            }
        }
        mut tensor<f16, [2, 1]> ts_u8 ← tf16[2, 1] {}
        mut tensor<f16, [2, 1]> tb_u8 ← tf16[2, 1] {}
        ts_u8[[0, 0]] ← s_u8_f16[0]
        ts_u8[[1, 0]] ← s_u8_f16[1]
        tb_u8[[0, 0]] ← b_u8_f16[0]
        tb_u8[[1, 0]] ← b_u8_f16[1]

        mut tensor<f32, [8]> tx_u32 ← tf32[8] {}
        for exclusive 8 let j {
            tx_u32[[j]] ← x_u32[j]
        }
        mut tensor<f32, [2, 8]> tx_u32_mat ← tf32[2, 8] {}
        for exclusive 2 let b {
            for exclusive 8 let j {
                tx_u32_mat[[b, j]] ← x_u32_mat[b * 8 + j]
            }
        }
        mut tensor<f32, [4]> tx_u8 ← tf32[4] {}
        for exclusive 4 let j {
            tx_u8[[j]] ← x_u8[j]
        }
        mut tensor<f32, [2, 4]> tx_u8_mat ← tf32[2, 4] {}
        for exclusive 2 let b {
            for exclusive 4 let j {
                tx_u8_mat[[b, j]] ← x_u8_mat[b * 4 + j]
            }
        }

        mut tensor<f32, [2]> ty ← tf32[2] {}
        mut tensor<f32, [2, 2]> tp ← tf32[2, 2] {}
        mut tensor<f32, [2, 2]> tym ← tf32[2, 2] {}

        ga.linear_matvec_u32_f16(tw_u32, ts_u32, tb_u32, tx_u32, mut ty, 8, 4)
        assert close(ty[[0]], ref_mv_u32[0])
        assert close(ty[[1]], ref_mv_u32[1])

        ga.linear_matvec_u32_f16_part(tw_u32, ts_u32, tb_u32, tx_u32, mut tp, 8, 4)
        ga.linear_matvec_u32_combine(tp, mut ty)
        assert close(ty[[0]], ref_mv_u32[0])
        assert close(ty[[1]], ref_mv_u32[1])

        ga.linear_matvec_4bit_u32_f16_part(tw4_u32, ts_u32, tb_u32, tx_u32, mut tp, 4 ∷ i32)
        ga.linear_matvec_u32_combine(tp, mut ty)
        assert close(ty[[0]], ref_mv_u32_4[0])
        assert close(ty[[1]], ref_mv_u32_4[1])

        ga.linear_matmul_u32_f16(tw_u32, ts_u32, tb_u32, tx_u32_mat, mut tym, 8, 4)
        assert close(tym[[0, 0]], ref_mm_u32[0])
        assert close(tym[[0, 1]], ref_mm_u32[1])
        assert close(tym[[1, 0]], ref_mm_u32[2])
        assert close(tym[[1, 1]], ref_mm_u32[3])

        ga.linear_matvec_u8_f16(tw_u8, ts_u8, tb_u8, tx_u8, mut ty, 4, 4)
        assert close(ty[[0]], ref_mv_u8[0])
        assert close(ty[[1]], ref_mv_u8[1])

        ga.linear_matvec_u8_f16_part(tw_u8, ts_u8, tb_u8, tx_u8, mut tp, 4, 4)
        ga.linear_matvec_u32_combine(tp, mut ty)
        assert close(ty[[0]], ref_mv_u8[0])
        assert close(ty[[1]], ref_mv_u8[1])

        ga.linear_matvec_4bit_u8_f16_part(tw_u8, ts_u8, tb_u8, tx_u8, mut tp, 4 ∷ i32)
        ga.linear_matvec_u32_combine(tp, mut ty)
        assert close(ty[[0]], ref_mv_u8[0])
        assert close(ty[[1]], ref_mv_u8[1])

        ga.linear_matmul_u8_f16(tw_u8, ts_u8, tb_u8, tx_u8_mat, mut tym, 4, 4)
        assert close(tym[[0, 0]], ref_mm_u8[0])
        assert close(tym[[0, 1]], ref_mm_u8[1])
        assert close(tym[[1, 0]], ref_mm_u8[2])
        assert close(tym[[1, 1]], ref_mm_u8[3])
    }
    catch err {
        assert false
    }
}
