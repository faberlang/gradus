@ public
kernel linear_matvec_u8<size Out, size PackedIn, size Groups, size In>(tensor<u8, [Out, PackedIn]> weight, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 bits, i32 group_size) → void {
    for from y at [row] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 {
            mut f32 acc ← 0.0 ∷ f32

            for exclusive In let j {
                let i32 g ← j / group_size
                let f32 s ← scales[[row, g]]
                let f32 b ← biases[[row, g]]
                mut u8 q ← 0 ∷ u8

                if bits ≡ 8 {
                    q ← weight[[row, j]]
                }
                else {
                    let u8 packed ← weight[[row, j / 2]]
                    if j % 2 ≡ 0 {
                        q ← packed ∧ (15 ∷ u8)
                    }
                    else {
                        q ← (packed ⇒ (4 ∷ u8)) ∧ (15 ∷ u8)
                    }
                }

                let f32 w ← (q ↦ f32) * s + b
                acc ← acc + w * x[[j]]
            }

            y[[row]] ← acc
        }
    }
}

# Split-K partial-sum kernel for `linear_matvec_u8`.
@ public
kernel linear_matvec_u8_part<size Out, size PackedIn, size Groups, size In, size KParts>(tensor<u8, [Out, PackedIn]> weight, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out, KParts]> partials, i32 bits, i32 group_size) → void {
    for from partials at [row, part] thread lane let e {
        let i32 n_groups ← Groups ↦ i32
        let i32 k_parts ← KParts ↦ i32
        let i32 in_dim ← In ↦ i32
        if group_size ≥ 1 and group_size ≤ 4096 and n_groups ≥ 1 and n_groups ≤ 65536 and in_dim ≥ 1 and in_dim ≤ 16777216 and k_parts ≥ 1 and k_parts ≤ 256 and (bits ≡ 4 or bits ≡ 8) {
            mut f32 acc ← 0.0 ∷ f32
            mut i32 g ← part ↦ i32

            if bits ≡ 8 {
                while g ≺ n_groups {
                    let f32 s ← scales[[row, g]]
                    let f32 b ← biases[[row, g]]
                    let i32 x_base ← g * group_size
                    mut f32 g_qx ← 0.0 ∷ f32
                    mut f32 g_x ← 0.0 ∷ f32
                    mut i32 k ← 0
                    while k ≺ group_size {
                        let i32 j ← x_base + k
                        let f32 xv ← x[[j]]
                        g_qx ← g_qx + ((weight[[row, j]] ↦ i32) ↦ f32) * xv
                        g_x ← g_x + xv
                        k ← k + 1
                    }
                    acc ← acc + s * g_qx + b * g_x
                    g ← g + k_parts
                }
            }
            elif group_size % 2 ≡ 0 {
                let i32 bytes_per_group ← group_size / 2
                while g ≺ n_groups {
                    let f32 s ← scales[[row, g]]
                    let f32 b ← biases[[row, g]]
                    let i32 w_base ← g * bytes_per_group
                    let i32 x_base ← g * group_size
                    mut f32 g_qx ← 0.0 ∷ f32
                    mut f32 g_x ← 0.0 ∷ f32
                    mut i32 bg ← 0
                    while bg ≺ bytes_per_group {
                        let i32 w_idx ← w_base + bg
                        let i32 packed ← weight[[row, w_idx]] ↦ i32
                        let i32 j0 ← x_base + bg * 2
                        let i32 j1 ← j0 + 1
                        let f32 x0 ← x[[j0]]
                        let f32 x1 ← x[[j1]]
                        g_qx ← g_qx + ((packed ∧ 15) ↦ f32) * x0 + (((packed ⇒ 4) ∧ 15) ↦ f32) * x1
                        g_x ← g_x + x0 + x1
                        bg ← bg + 1
                    }
                    acc ← acc + s * g_qx + b * g_x
                    g ← g + k_parts
                }
            }
            else {
                while g ≺ n_groups {
                    let f32 s ← scales[[row, g]]
                    let f32 b ← biases[[row, g]]
                    let i32 x_base ← g * group_size
                    mut f32 g_qx ← 0.0 ∷ f32
                    mut f32 g_x ← 0.0 ∷ f32
                    mut i32 k ← 0
                    while k ≺ group_size {
                        let i32 j ← x_base + k
                        let i32 packed ← weight[[row, j / 2]] ↦ i32
                        let i32 q ← (j % 2 ≡ 0) ✓ (packed ∧ 15) ✗ ((packed ⇒ 4) ∧ 15)
                        let f32 xv ← x[[j]]
                        g_qx ← g_qx + (q ↦ f32) * xv
                        g_x ← g_x + xv
                        k ← k + 1
                    }
                    acc ← acc + s * g_qx + b * g_x
                    g ← g + k_parts
                }
            }

            partials[[row, part]] ← acc
        }
    }
}

@ public
kernel linear_matmul_u32<size B, size Out, size PackedIn, size Groups, size In>(tensor<u32, [Out, PackedIn]> weight, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y, i32 bits, i32 group_size) → void {
    for from y at [b_idx, row] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 and bits ≥ 4 and bits ≤ 8 {
