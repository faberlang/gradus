+++ toml
locale = "en"

+++ faber
# GroupAffine — planar group-affine quantized weight representation and
# shape-generic packed GEMV kernels for u32 and u8 (4/6/8-bit, issue #45).
#
# Public import: import from "gradus:quant/group_affine" group_affine
#
# --- Contract ------------------------------------------------------------
#
# Planar multi-tensor quantization (Rule 17):
#   * `weight` packed as `u32` (4/6/8-bit) or `u8` (4/8-bit)
#   * `scales` [Out, In / group_size]
#   * `biases` [Out, In / group_size]
#   * `w = q * scale + bias`
#
# Supports:
#   1. 8-bit u32-packed (SmolLM2-135M-Instruct-8bit, Inkling MLX-8bit)
#   2. 4-bit u8-packed (Flint INT4 MLX) and 4-bit u32-packed
#   3. 6-bit u32-packed (SmolLM2-360M MLX 6-bit)

@ public
union GroupAffineError {
    @ shared
    string message

    BadConfig,
    BadShape,
    BadBits,
    BadPack
}

@ public
union PackKind {
    PackU32,
    PackU8
}

@ public
class GroupAffineSpec {
    let int out_features
    let int in_features
    let int bits
    let int group_size
    let PackKind pack
    let int packed_cols
    let int group_cols
}

@ public
fn admit_spec(int out_features, int in_features, int bits, int group_size, PackKind pack) → GroupAffineSpec ⇥ GroupAffineError {
    require out_features ≥ 1 throw variant BadShape { message = "out_features must be at least 1" }

    require in_features ≥ 1 throw variant BadShape { message = "in_features must be at least 1" }

    require bits ≡ 4 or bits ≡ 6 or bits ≡ 8 throw variant BadBits { message = "bits must be 4, 6, or 8" }

    require group_size ≥ 1 throw variant BadConfig { message = "group_size must be at least 1" }

    require in_features % group_size ≡ 0 throw variant BadShape { message = "in_features must be divisible by group_size" }

    mut int pack_width ← 32

    match pack {
        case PackU32 {
            pack_width ← 32
        }
        case PackU8 {
            require bits ≡ 4 or bits ≡ 8 throw variant BadPack { message = "u8 packing supports 4-bit and 8-bit weights only" }

            pack_width ← 8
        }
    }

    let int total_bits ← in_features * bits

    require total_bits % pack_width ≡ 0 throw variant BadShape { message = "in_features * bits must be divisible by pack width" }

    let int packed_cols ← total_bits / pack_width
    let int group_cols ← in_features / group_size
    return GroupAffineSpec { out_features = out_features, in_features = in_features, bits = bits, group_size = group_size, pack = pack, packed_cols = packed_cols, group_cols = group_cols }
}

# -------------------------------------------------------------------------
# Typed host reference decode and GEMV
# -------------------------------------------------------------------------

fn unpack_u32_q(list<u32> row_words, int j, int bits) → int {
    let int bit_pos ← j * bits
    let int word_idx ← bit_pos / 32
    let int shift ← bit_pos % 32
    let int w0 ← row_words[word_idx] ↦ int

    if bits ≡ 8 {
        return (w0 ⇒ shift) % 256
    }

    if bits ≡ 4 {
        return (w0 ⇒ shift) % 16
    }

    # bits == 6: may straddle a 32-bit word boundary when shift > 26.
    if shift ≤ 26 {
        return (w0 ⇒ shift) % 64
    }

    let int w1 ← row_words[word_idx + 1] ↦ int
    let int lo ← w0 ⇒ shift
    let int hi ← w1 ⇐ (32 - shift)
    return (lo ∨ hi) % 64
}

fn unpack_u8_q(list<u8> row_bytes, int j, int bits) → int {
    if bits ≡ 8 {
        return row_bytes[j] ↦ int
    }

    let int b ← row_bytes[j / 2] ↦ int
    let int shift ← (j % 2) * 4
    return (b ⇒ shift) % 16
}

@ public
fn ref_dequantize_u32(GroupAffineSpec spec, list<u32> weight, list<f32> scales, list<f32> biases) → list<f32> ⇥ GroupAffineError {
    match spec.pack {
        case PackU32 {
            pass
        }
        default {
            throw variant BadPack { message = "expected PackU32 spec" }
        }
    }

    require weight.length() ≡ spec.out_features * spec.packed_cols throw variant BadShape { message = "weight length mismatch" }

    require scales.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "scales length mismatch" }

    require biases.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "biases length mismatch" }

    mut list<f32> out ← empty

    for exclusive spec.out_features let r {
        mut list<u32> row_words ← empty
        let int w_base ← r * spec.packed_cols

        for exclusive spec.packed_cols let c {
            row_words.append(weight[w_base + c])
        }

        let int g_base ← r * spec.group_cols

        for exclusive spec.in_features let j {
            let int q ← unpack_u32_q(row_words, j, spec.bits)
            let int g ← j / spec.group_size
            let f32 s ← scales[g_base + g]
            let f32 b ← biases[g_base + g]
            out.append((q ↦ f32) * s + b)
        }
    }

    return out
}

@ public
fn ref_dequantize_u8(GroupAffineSpec spec, list<u8> weight, list<f32> scales, list<f32> biases) → list<f32> ⇥ GroupAffineError {
    match spec.pack {
        case PackU8 {
            pass
        }
        default {
            throw variant BadPack { message = "expected PackU8 spec" }
        }
    }

    require weight.length() ≡ spec.out_features * spec.packed_cols throw variant BadShape { message = "weight length mismatch" }

    require scales.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "scales length mismatch" }

    require biases.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "biases length mismatch" }

    mut list<f32> out ← empty

    for exclusive spec.out_features let r {
        mut list<u8> row_bytes ← empty
        let int w_base ← r * spec.packed_cols

        for exclusive spec.packed_cols let c {
            row_bytes.append(weight[w_base + c])
        }

        let int g_base ← r * spec.group_cols

        for exclusive spec.in_features let j {
            let int q ← unpack_u8_q(row_bytes, j, spec.bits)
            let int g ← j / spec.group_size
            let f32 s ← scales[g_base + g]
            let f32 b ← biases[g_base + g]
            out.append((q ↦ f32) * s + b)
        }
    }

    return out
}

@ public
fn ref_matvec(int out_features, int in_features, list<f32> w_dense, list<f32> x) → list<f32> ⇥ GroupAffineError {
    require w_dense.length() ≡ out_features * in_features throw variant BadShape { message = "dense weight length mismatch" }

    require x.length() ≡ in_features throw variant BadShape { message = "input vector length mismatch" }

    mut list<f32> y ← empty

    for exclusive out_features let r {
        mut f32 acc ← 0.0 ∷ f32
        let int base ← r * in_features

        for exclusive in_features let j {
            acc ← acc + w_dense[base + j] * x[j]
        }

        y.append(acc)
    }

    return y
}

# -------------------------------------------------------------------------
# Shape-generic @ kernel packed GEMV contractions (CPU + Metal)
# -------------------------------------------------------------------------

@ public
kernel linear_matvec_u32<size Out, size PackedIn, size Groups, size In>(tensor<u32, [Out, PackedIn]> weight, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 bits, i32 group_size) → void {
    for from y at [row] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 {
            let i32 rr ← (row ↦ i32) ∧ 65535
            mut f32 acc ← 0.0 ∷ f32

            for exclusive In let j {
                let i32 ji ← (j ↦ i32) ∧ 65535
                let i32 g ← (ji / group_size) ∧ 4095
                let f32 s ← scales[[rr, g]]
                let f32 b ← biases[[rr, g]]
                let i32 bit_pos ← ji * bits
                let i32 word_idx ← (bit_pos / 32) ∧ 65535
                let i32 shift ← bit_pos % 32
                let u32 w0 ← weight[[rr, word_idx]]
                mut u32 q ← 0 ∷ u32

                if bits ≡ 8 {
                    if shift ≡ 0 {
                        q ← w0 ∧ (255 ∷ u32)
                    }
                    elif shift ≡ 8 {
                        q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                    }
                    elif shift ≡ 16 {
                        q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                    }
                    else {
                        q ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)
                    }
                }
                elif bits ≡ 4 {
                    if shift ≡ 0 {
                        q ← w0 ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 4 {
                        q ← (w0 ⇒ (4 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 8 {
                        q ← (w0 ⇒ (8 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 12 {
                        q ← (w0 ⇒ (12 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 16 {
                        q ← (w0 ⇒ (16 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 20 {
                        q ← (w0 ⇒ (20 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 24 {
                        q ← (w0 ⇒ (24 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    else {
                        q ← (w0 ⇒ (28 ∷ u32)) ∧ (15 ∷ u32)
                    }
                }
                else {
                    if shift ≡ 0 {
                        q ← w0 ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 2 {
                        q ← (w0 ⇒ (2 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 4 {
                        q ← (w0 ⇒ (4 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 6 {
                        q ← (w0 ⇒ (6 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 8 {
                        q ← (w0 ⇒ (8 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 10 {
                        q ← (w0 ⇒ (10 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 12 {
                        q ← (w0 ⇒ (12 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 14 {
                        q ← (w0 ⇒ (14 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 16 {
                        q ← (w0 ⇒ (16 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 18 {
                        q ← (w0 ⇒ (18 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 20 {
                        q ← (w0 ⇒ (20 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 22 {
                        q ← (w0 ⇒ (22 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 24 {
                        q ← (w0 ⇒ (24 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 26 {
                        q ← (w0 ⇒ (26 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 28 {
                        let u32 w1 ← weight[[rr, word_idx + 1]]
                        let u32 lo ← w0 ⇒ (28 ∷ u32)
                        let u32 hi ← (w1 ∧ (3 ∷ u32)) * (16 ∷ u32)
                        q ← lo + hi
                    }
                    else {
                        let u32 w1 ← weight[[rr, word_idx + 1]]
                        let u32 lo ← w0 ⇒ (30 ∷ u32)
                        let u32 hi ← (w1 ∧ (15 ∷ u32)) * (4 ∷ u32)
                        q ← lo + hi
                    }
                }

                let f32 w ← (q ↦ f32) * s + b
                acc ← acc + w * x[[ji]]
            }

            y[[row]] ← acc
        }
    }
}

@ public
kernel linear_matvec_u8<size Out, size PackedIn, size Groups, size In>(tensor<u8, [Out, PackedIn]> weight, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 bits, i32 group_size) → void {
    for from y at [row] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 {
            let i32 rr ← (row ↦ i32) ∧ 65535
            mut f32 acc ← 0.0 ∷ f32

            for exclusive In let j {
                let i32 ji ← (j ↦ i32) ∧ 65535
                let i32 g ← (ji / group_size) ∧ 4095
                let f32 s ← scales[[rr, g]]
                let f32 b ← biases[[rr, g]]
                mut u8 q ← 0 ∷ u8

                if bits ≡ 8 {
                    q ← weight[[rr, ji]]
                }
                else {
                    let u8 packed ← weight[[rr, (ji / 2) ∧ 65535]]
                    if ji % 2 ≡ 0 {
                        q ← packed ∧ (15 ∷ u8)
                    }
                    else {
                        q ← (packed ⇒ (4 ∷ u8)) ∧ (15 ∷ u8)
                    }
                }

                let f32 w ← (q ↦ f32) * s + b
                acc ← acc + w * x[[ji]]
            }

            y[[row]] ← acc
        }
    }
}

+++ faber test
import from "gradus:quant/group_affine" ga

fn close(f32 a, f32 b) → bool {
    let f32 diff ← (a - b).abs()
    let f32 tol ← (1.0e-5 ∷ f32) + (1.0e-4 ∷ f32) * b.abs()
    return diff ≤ tol
}

fn spec_result(int o, int i, int bits, int g, ga.PackKind p) → string {
    do {
        ga.admit_spec(o, i, bits, g, p)
        return "ok"
    }
    catch err {
        return err.message
    }
}

test "GroupAffine spec validates shape/group/pack divisibility fail-closed" {
    assert spec_result(4, 16, 8, 4, variant ga.PackKind.PackU32) ≡ "ok"
    assert spec_result(4, 16, 4, 4, variant ga.PackKind.PackU8) ≡ "ok"
    assert spec_result(4, 16, 6, 16, variant ga.PackKind.PackU32) ≡ "ok"
    assert spec_result(4, 15, 8, 4, variant ga.PackKind.PackU32) ≡ "in_features must be divisible by group_size"
    assert spec_result(4, 16, 6, 4, variant ga.PackKind.PackU8) ≡ "u8 packing supports 4-bit and 8-bit weights only"
    assert spec_result(4, 12, 6, 4, variant ga.PackKind.PackU32) ≡ "in_features * bits must be divisible by pack width"
}

test "GroupAffine 8-bit u32-packed ref decode and kernel GEMV match" {
    # Out=2, In=8, group_size=4 -> PackedIn=2 u32s, Groups=2
    # Row 0: q = [1, 2, 3, 4, 5, 6, 7, 8], s=[0.5, 2.0], b=[-1.0, 0.25]
    # Row 1: q = [0, 10, 20, 30, 255, 128, 64, 1], s=[0.25, -0.5], b=[0.0, 1.0]
    let u32 r0w0 ← 0x04030201 ∷ u32
    let u32 r0w1 ← 0x08070605 ∷ u32
    let u32 r1w0 ← 0x1e140a00 ∷ u32
    let u32 r1w1 ← 0x014080ff ∷ u32
    let list<u32> w_list ← [r0w0, r0w1, r1w0, r1w1]
    let list<f32> s_list ← [0.5 ∷ f32, 2.0 ∷ f32, 0.25 ∷ f32, -0.5 ∷ f32]
    let list<f32> b_list ← [-1.0 ∷ f32, 0.25 ∷ f32, 0.0 ∷ f32, 1.0 ∷ f32]
    let list<f32> x_list ← [1.0 ∷ f32, -2.0 ∷ f32, 0.5 ∷ f32, 4.0 ∷ f32, -1.0 ∷ f32, 2.0 ∷ f32, -0.5 ∷ f32, 3.0 ∷ f32]

    do {
        let ga.GroupAffineSpec spec ← ga.admit_spec(2, 8, 8, 4, variant ga.PackKind.PackU32)
        let list<f32> w_dense ← ga.ref_dequantize_u32(spec, w_list, s_list, b_list)
        let list<f32> y_ref ← ga.ref_matvec(2, 8, w_dense, x_list)

        mut tensor<u32, [2, 2]> w_t ← tu32[2, 2] {}
        w_t[[0, 0]] ← r0w0
        w_t[[0, 1]] ← r0w1
        w_t[[1, 0]] ← r1w0
        w_t[[1, 1]] ← r1w1
        mut tensor<f32, [2, 2]> s_t ← tf32[2, 2] {}
        s_t[[0, 0]] ← 0.5
        s_t[[0, 1]] ← 2.0
        s_t[[1, 0]] ← 0.25
        s_t[[1, 1]] ← -0.5
        mut tensor<f32, [2, 2]> b_t ← tf32[2, 2] {}
        b_t[[0, 0]] ← -1.0
        b_t[[0, 1]] ← 0.25
        b_t[[1, 0]] ← 0.0
        b_t[[1, 1]] ← 1.0
        mut tensor<f32, [8]> x_t ← tf32[8] {}
        for exclusive 8 let j {
            x_t[[j]] ← x_list[j]
        }
        mut tensor<f32, [2]> y_k ← tf32[2] {}

        ga.linear_matvec_u32(w_t, s_t, b_t, x_t, mut y_k, 8, 4)
        assert close(y_k[[0]], y_ref[0])
        assert close(y_k[[1]], y_ref[1])
    }
    catch err {
        assert false
    }
}

test "GroupAffine 4-bit u8-packed (Flint style) ref decode and kernel GEMV match" {
    # Out=2, In=4, group_size=4 -> PackedIn=2 u8s, Groups=1
    let list<u8> w_list ← [0x21 ∷ u8, 0xf3 ∷ u8, 0x05 ∷ u8, 0xa7 ∷ u8]
    let list<f32> s_list ← [0.25 ∷ f32, -0.5 ∷ f32]
    let list<f32> b_list ← [-1.0 ∷ f32, 2.0 ∷ f32]
    let list<f32> x_list ← [1.0 ∷ f32, -2.0 ∷ f32, 3.0 ∷ f32, 0.5 ∷ f32]

    do {
        let ga.GroupAffineSpec spec ← ga.admit_spec(2, 4, 4, 4, variant ga.PackKind.PackU8)
        let list<f32> w_dense ← ga.ref_dequantize_u8(spec, w_list, s_list, b_list)
        let list<f32> y_ref ← ga.ref_matvec(2, 4, w_dense, x_list)

        mut tensor<u8, [2, 2]> w_t ← tu8[2, 2] {}
        w_t[[0, 0]] ← 0x21 ∷ u8
        w_t[[0, 1]] ← 0xf3 ∷ u8
        w_t[[1, 0]] ← 0x05 ∷ u8
        w_t[[1, 1]] ← 0xa7 ∷ u8
        mut tensor<f32, [2, 1]> s_t ← tf32[2, 1] {}
        s_t[[0, 0]] ← 0.25
        s_t[[1, 0]] ← -0.5
        mut tensor<f32, [2, 1]> b_t ← tf32[2, 1] {}
        b_t[[0, 0]] ← -1.0
        b_t[[1, 0]] ← 2.0
        mut tensor<f32, [4]> x_t ← tf32[4] {}
        for exclusive 4 let j {
            x_t[[j]] ← x_list[j]
        }
        mut tensor<f32, [2]> y_k ← tf32[2] {}

        ga.linear_matvec_u8(w_t, s_t, b_t, x_t, mut y_k, 4, 4)
        assert close(y_k[[0]], y_ref[0])
        assert close(y_k[[1]], y_ref[1])
    }
    catch err {
        assert false
    }
}

test "GroupAffine 6-bit u32-packed (SmolLM2-360M style) ref decode and kernel GEMV match" {
    # Out=1, In=16, group_size=16 -> 16*6 = 96 bits = 3 u32 words, Groups=1
    # Pack q[j] = (j * 3 + 1) % 64 into 3 u32 words:
    # j=0..5: 1,4,7,10,13 -> bits 0..29 + j=5(16): 16&3=0 at 30..31 -> word0
    let u32 w0 ← 0x1a0ca301 ∷ u32
    let u32 w1 ← 0x89581762 ∷ u32
    let u32 w2 ← 0x74b1a094 ∷ u32
    let list<u32> w_list ← [w0, w1, w2]
    let list<f32> s_list ← [0.125 ∷ f32]
    let list<f32> b_list ← [-2.0 ∷ f32]
    mut list<f32> x_list ← empty
    for exclusive 16 let j {
        x_list.append(((j ↦ f32) - 7.5 ∷ f32) * (0.25 ∷ f32))
    }

    do {
        let ga.GroupAffineSpec spec ← ga.admit_spec(1, 16, 6, 16, variant ga.PackKind.PackU32)
        let list<f32> w_dense ← ga.ref_dequantize_u32(spec, w_list, s_list, b_list)
        let list<f32> y_ref ← ga.ref_matvec(1, 16, w_dense, x_list)

        mut tensor<u32, [1, 3]> w_t ← tu32[1, 3] {}
        w_t[[0, 0]] ← w0
        w_t[[0, 1]] ← w1
        w_t[[0, 2]] ← w2
        mut tensor<f32, [1, 1]> s_t ← tf32[1, 1] {}
        s_t[[0, 0]] ← 0.125
        mut tensor<f32, [1, 1]> b_t ← tf32[1, 1] {}
        b_t[[0, 0]] ← -2.0
        mut tensor<f32, [16]> x_t ← tf32[16] {}
        for exclusive 16 let j {
            x_t[[j]] ← x_list[j]
        }
        mut tensor<f32, [1]> y_k ← tf32[1] {}

        ga.linear_matvec_u32(w_t, s_t, b_t, x_t, mut y_k, 6, 16)
        assert close(y_k[[0]], y_ref[0])
    }
    catch err {
        assert false
    }
}
