                while g ≺ n_groups {
                    let f32 s ← scales[[row, g]]
                    let f32 b ← biases[[row, g]]
                    let i32 x_base ← g * group_size
                    mut f32 g_qx ← 0.0 ∷ f32
                    mut f32 g_x ← 0.0 ∷ f32
                    mut i32 k ← 0
                    while k ≺ group_size {
                        let i32 j ← x_base + k
                        let u32 w0 ← weight[[row, j / 8]]
                        let i32 rem ← j % 8
                        mut u32 q ← 0 ∷ u32
                        if rem ≡ 0 { q ← w0 ∧ (15 ∷ u32) }
                        elif rem ≡ 1 { q ← (w0 ⇒ (4 ∷ u32)) ∧ (15 ∷ u32) }
                        elif rem ≡ 2 { q ← (w0 ⇒ (8 ∷ u32)) ∧ (15 ∷ u32) }
                        elif rem ≡ 3 { q ← (w0 ⇒ (12 ∷ u32)) ∧ (15 ∷ u32) }
