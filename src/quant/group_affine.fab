+++ toml
locale = "en"

+++ faber
# GroupAffine — planar group-affine quantized weight representation and
# shape-generic packed GEMV kernels for u32 and u8 (4/6/8-bit, issue #45).
#
# Public import: import from "gradus:quant/group_affine" group_affine
#
# --- Contract ------------------------------------------------------------
#
# Planar multi-tensor quantization (Rule 17):
#   * `weight` packed as `u32` (4/6/8-bit) or `u8` (4/8-bit)
#   * `scales` [Out, In / group_size]
#   * `biases` [Out, In / group_size]
#   * `w = q * scale + bias`
#
# Supports:
#   1. 8-bit u32-packed (SmolLM2-135M-Instruct-8bit, Inkling MLX-8bit)
#   2. 4-bit u8-packed (Flint INT4 MLX) and 4-bit u32-packed
#   3. 6-bit u32-packed (SmolLM2-360M MLX 6-bit)

@ public
union GroupAffineError {
    @ shared
    string message

    BadConfig,
    BadShape,
    BadBits,
    BadPack
}

@ public
union PackKind {
    PackU32,
    PackU8
}

@ public
union ScaleDtype {
    ScaleF32,
    ScaleBf16
}

@ public
class GroupAffineSpec {
    let int out_features
    let int in_features
    let int bits
    let int group_size
    let PackKind pack
    let int packed_cols
    let int group_cols
    let ScaleDtype scale_dtype
}

@ public
fn admit_spec_with_scale(int out_features, int in_features, int bits, int group_size, PackKind pack, ScaleDtype scale_dtype) → GroupAffineSpec ⇥ GroupAffineError {
    require out_features ≥ 1 throw variant BadShape { message = "out_features must be at least 1" }

    require in_features ≥ 1 throw variant BadShape { message = "in_features must be at least 1" }

    require bits ≡ 4 or bits ≡ 6 or bits ≡ 8 throw variant BadBits { message = "bits must be 4, 6, or 8" }

    require group_size ≥ 1 throw variant BadConfig { message = "group_size must be at least 1" }

    require in_features % group_size ≡ 0 throw variant BadShape { message = "in_features must be divisible by group_size" }

    mut int pack_width ← 32

    match pack {
        case PackU32 {
            pack_width ← 32
        }
        case PackU8 {
            require bits ≡ 4 or bits ≡ 8 throw variant BadPack { message = "u8 packing supports 4-bit and 8-bit weights only" }

            pack_width ← 8
        }
    }

    let int total_bits ← in_features * bits

    require total_bits % pack_width ≡ 0 throw variant BadShape { message = "in_features * bits must be divisible by pack width" }

    let int packed_cols ← total_bits / pack_width
    let int group_cols ← in_features / group_size
    return GroupAffineSpec { out_features = out_features, in_features = in_features, bits = bits, group_size = group_size, pack = pack, packed_cols = packed_cols, group_cols = group_cols, scale_dtype = scale_dtype }
}

@ public
fn admit_spec(int out_features, int in_features, int bits, int group_size, PackKind pack) → GroupAffineSpec ⇥ GroupAffineError {
    return admit_spec_with_scale(out_features, in_features, bits, group_size, pack, variant ScaleDtype.ScaleF32)
}

# -------------------------------------------------------------------------
# Typed host reference decode and GEMV
# -------------------------------------------------------------------------

fn unpack_u32_q(list<u32> row_words, int j, int bits) → int {
    let int bit_pos ← j * bits
    let int word_idx ← bit_pos / 32
    let int shift ← bit_pos % 32
    let int w0 ← row_words[word_idx] ↦ int

    if bits ≡ 8 {
        return (w0 ⇒ shift) % 256
    }

    if bits ≡ 4 {
        return (w0 ⇒ shift) % 16
    }

    # bits == 6: may straddle a 32-bit word boundary when shift > 26.
    if shift ≤ 26 {
        return (w0 ⇒ shift) % 64
    }

    let int w1 ← row_words[word_idx + 1] ↦ int
    let int lo ← w0 ⇒ shift
    let int hi ← w1 ⇐ (32 - shift)
    return (lo ∨ hi) % 64
}

fn unpack_u8_q(list<u8> row_bytes, int j, int bits) → int {
    if bits ≡ 8 {
        return row_bytes[j] ↦ int
    }

    let int b ← row_bytes[j / 2] ↦ int
    let int shift ← (j % 2) * 4
    return (b ⇒ shift) % 16
}

fn bf16_list_to_f32(list<bf16> items) → list<f32> {
    mut list<f32> out ← empty

    for from items let v {
        out.append(v ↦ f32)
    }

    return out
}

fn dequantize_u32_with_f32_scales(GroupAffineSpec spec, list<u32> weight, list<f32> scales, list<f32> biases) → list<f32> ⇥ GroupAffineError {
    match spec.pack {
        case PackU32 {
            pass
        }
        default {
            throw variant BadPack { message = "expected PackU32 spec" }
        }
    }

    require weight.length() ≡ spec.out_features * spec.packed_cols throw variant BadShape { message = "weight length mismatch" }

    require scales.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "scales length mismatch" }

    require biases.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "biases length mismatch" }

    mut list<f32> out ← empty

    for exclusive spec.out_features let r {
        mut list<u32> row_words ← empty
        let int w_base ← r * spec.packed_cols

        for exclusive spec.packed_cols let c {
            row_words.append(weight[w_base + c])
        }

        let int g_base ← r * spec.group_cols

        for exclusive spec.in_features let j {
            let int q ← unpack_u32_q(row_words, j, spec.bits)
            let int g ← j / spec.group_size
            let f32 s ← scales[g_base + g]
            let f32 b ← biases[g_base + g]
            out.append((q ↦ f32) * s + b)
        }
    }

    return out
}

fn dequantize_u8_with_f32_scales(GroupAffineSpec spec, list<u8> weight, list<f32> scales, list<f32> biases) → list<f32> ⇥ GroupAffineError {
    match spec.pack {
        case PackU8 {
            pass
        }
        default {
            throw variant BadPack { message = "expected PackU8 spec" }
        }
    }

    require weight.length() ≡ spec.out_features * spec.packed_cols throw variant BadShape { message = "weight length mismatch" }

    require scales.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "scales length mismatch" }

    require biases.length() ≡ spec.out_features * spec.group_cols throw variant BadShape { message = "biases length mismatch" }

    mut list<f32> out ← empty

    for exclusive spec.out_features let r {
        mut list<u8> row_bytes ← empty
        let int w_base ← r * spec.packed_cols

        for exclusive spec.packed_cols let c {
            row_bytes.append(weight[w_base + c])
        }

        let int g_base ← r * spec.group_cols

        for exclusive spec.in_features let j {
            let int q ← unpack_u8_q(row_bytes, j, spec.bits)
            let int g ← j / spec.group_size
            let f32 s ← scales[g_base + g]
            let f32 b ← biases[g_base + g]
            out.append((q ↦ f32) * s + b)
        }
    }

    return out
}

@ public
fn ref_dequantize_u32(GroupAffineSpec spec, list<u32> weight, list<f32> scales, list<f32> biases) → list<f32> ⇥ GroupAffineError {
    return dequantize_u32_with_f32_scales(spec, weight, scales, biases)
}

@ public
fn ref_dequantize_u32_bf16(GroupAffineSpec spec, list<u32> weight, list<bf16> scales, list<bf16> biases) → list<f32> ⇥ GroupAffineError {
    return dequantize_u32_with_f32_scales(spec, weight, bf16_list_to_f32(scales), bf16_list_to_f32(biases))
}

@ public
fn ref_dequantize_u8(GroupAffineSpec spec, list<u8> weight, list<f32> scales, list<f32> biases) → list<f32> ⇥ GroupAffineError {
    return dequantize_u8_with_f32_scales(spec, weight, scales, biases)
}

@ public
fn ref_dequantize_u8_bf16(GroupAffineSpec spec, list<u8> weight, list<bf16> scales, list<bf16> biases) → list<f32> ⇥ GroupAffineError {
    return dequantize_u8_with_f32_scales(spec, weight, bf16_list_to_f32(scales), bf16_list_to_f32(biases))
}

@ public
fn ref_matvec(int out_features, int in_features, list<f32> w_dense, list<f32> x) → list<f32> ⇥ GroupAffineError {
    require w_dense.length() ≡ out_features * in_features throw variant BadShape { message = "dense weight length mismatch" }

    require x.length() ≡ in_features throw variant BadShape { message = "input vector length mismatch" }

    mut list<f32> y ← empty

    for exclusive out_features let r {
        mut f32 acc ← 0.0 ∷ f32
        let int base ← r * in_features

        for exclusive in_features let j {
            acc ← acc + w_dense[base + j] * x[j]
        }

        y.append(acc)
    }

    return y
}

@ public
fn ref_matmul(int batch, int out_features, int in_features, list<f32> w_dense, list<f32> x) → list<f32> ⇥ GroupAffineError {
    require batch ≥ 1 throw variant BadShape { message = "batch must be at least 1" }

    require w_dense.length() ≡ out_features * in_features throw variant BadShape { message = "dense weight length mismatch" }

    require x.length() ≡ batch * in_features throw variant BadShape { message = "input matrix length mismatch" }

    mut list<f32> y ← empty

    for exclusive batch let b {
        let int x_base ← b * in_features

        for exclusive out_features let r {
            mut f32 acc ← 0.0 ∷ f32
            let int w_base ← r * in_features

            for exclusive in_features let j {
                acc ← acc + w_dense[w_base + j] * x[x_base + j]
            }

            y.append(acc)
        }
    }

    return y
}

# -------------------------------------------------------------------------
# Shape-generic @ kernel packed GEMV contractions (CPU + Metal)
# -------------------------------------------------------------------------

@ public
kernel linear_matvec_u32<size Out, size PackedIn, size Groups, size In>(tensor<u32, [Out, PackedIn]> weight, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 bits, i32 group_size) → void {
    for from y at [row] thread lane let e {
        let i32 n_groups ← Groups ↦ i32
        let i32 in_dim ← In ↦ i32
        if group_size ≥ 1 and group_size ≤ 4096 and n_groups ≥ 1 and n_groups ≤ 65536 and in_dim ≥ 1 and in_dim ≤ 16777216 and (bits ≡ 4 or bits ≡ 6 or bits ≡ 8) {
            mut f32 acc ← 0.0 ∷ f32

            if bits ≡ 4 {
                if group_size % 8 ≡ 0 {
                    let i32 words_per_group ← group_size / 8
                    mut i32 g ← 0
                    while g ≺ n_groups {
                        let f32 s ← scales[[row, g]]
                        let f32 b ← biases[[row, g]]
                        let i32 w_base ← g * words_per_group
                        let i32 x_base ← g * group_size
                        mut f32 g_qx ← 0.0 ∷ f32
                        mut f32 g_x ← 0.0 ∷ f32
                        mut i32 wg ← 0
                        while wg ≺ words_per_group {
                            let i32 w_idx ← w_base + wg
                            let u32 w ← weight[[row, w_idx]]
                            let i32 j0 ← x_base + wg * 8
                            let i32 j1 ← j0 + 1
                            let i32 j2 ← j0 + 2
                            let i32 j3 ← j0 + 3
                            let i32 j4 ← j0 + 4
                            let i32 j5 ← j0 + 5
                            let i32 j6 ← j0 + 6
                            let i32 j7 ← j0 + 7
                            let f32 x0 ← x[[j0]]
                            let f32 x1 ← x[[j1]]
                            let f32 x2 ← x[[j2]]
                            let f32 x3 ← x[[j3]]
                            let f32 x4 ← x[[j4]]
                            let f32 x5 ← x[[j5]]
                            let f32 x6 ← x[[j6]]
                            let f32 x7 ← x[[j7]]
                            g_qx ← g_qx + ((w ∧ (15 ∷ u32)) ↦ f32) * x0 + (((w ⇒ (4 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x1 + (((w ⇒ (8 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x2 + (((w ⇒ (12 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x3 + (((w ⇒ (16 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x4 + (((w ⇒ (20 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x5 + (((w ⇒ (24 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x6 + (((w ⇒ (28 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x7
                            g_x ← g_x + x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7
                            wg ← wg + 1
                        }
                        acc ← acc + s * g_qx + b * g_x
                        g ← g + 1
                    }
                }
                else {
                    mut i32 g ← 0
                    while g ≺ n_groups {
                        let f32 s ← scales[[row, g]]
                        let f32 b ← biases[[row, g]]
                        let i32 x_base ← g * group_size
                        mut f32 g_qx ← 0.0 ∷ f32
                        mut f32 g_x ← 0.0 ∷ f32
                        mut i32 k ← 0
                        while k ≺ group_size {
                            let i32 j ← x_base + k
                            let i32 word_idx ← j / 8
                            let i32 rem ← j % 8
                            let u32 w0 ← weight[[row, word_idx]]
                            mut u32 q ← 0 ∷ u32

                            if rem ≡ 0 {
                                q ← w0 ∧ (15 ∷ u32)
                            }
                            elif rem ≡ 1 {
                                q ← (w0 ⇒ (4 ∷ u32)) ∧ (15 ∷ u32)
                            }
                            elif rem ≡ 2 {
                                q ← (w0 ⇒ (8 ∷ u32)) ∧ (15 ∷ u32)
                            }
                            elif rem ≡ 3 {
                                q ← (w0 ⇒ (12 ∷ u32)) ∧ (15 ∷ u32)
                            }
                            elif rem ≡ 4 {
                                q ← (w0 ⇒ (16 ∷ u32)) ∧ (15 ∷ u32)
                            }
                            elif rem ≡ 5 {
                                q ← (w0 ⇒ (20 ∷ u32)) ∧ (15 ∷ u32)
                            }
                            elif rem ≡ 6 {
                                q ← (w0 ⇒ (24 ∷ u32)) ∧ (15 ∷ u32)
                            }
                            else {
                                q ← (w0 ⇒ (28 ∷ u32)) ∧ (15 ∷ u32)
                            }

                            let f32 xv ← x[[j]]
                            g_qx ← g_qx + (q ↦ f32) * xv
                            g_x ← g_x + xv
                            k ← k + 1
                        }
                        acc ← acc + s * g_qx + b * g_x
                        g ← g + 1
                    }
                }
            }
            elif bits ≡ 8 {
                if group_size % 4 ≡ 0 {
                    let i32 words_per_group ← group_size / 4
                    mut i32 g ← 0
                    while g ≺ n_groups {
                        let f32 s ← scales[[row, g]]
                        let f32 b ← biases[[row, g]]
                        let i32 w_base ← g * words_per_group
                        let i32 x_base ← g * group_size
                        mut f32 g_qx ← 0.0 ∷ f32
                        mut f32 g_x ← 0.0 ∷ f32
                        mut i32 wg ← 0
                        while wg ≺ words_per_group {
                            let i32 w_idx ← w_base + wg
                            let u32 w ← weight[[row, w_idx]]
                            let i32 j0 ← x_base + wg * 4
                            let i32 j1 ← j0 + 1
                            let i32 j2 ← j0 + 2
                            let i32 j3 ← j0 + 3
                            let f32 x0 ← x[[j0]]
                            let f32 x1 ← x[[j1]]
                            let f32 x2 ← x[[j2]]
                            let f32 x3 ← x[[j3]]
                            g_qx ← g_qx + ((w ∧ (255 ∷ u32)) ↦ f32) * x0 + (((w ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)) ↦ f32) * x1 + (((w ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)) ↦ f32) * x2 + (((w ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)) ↦ f32) * x3
                            g_x ← g_x + x0 + x1 + x2 + x3
                            wg ← wg + 1
                        }
                        acc ← acc + s * g_qx + b * g_x
                        g ← g + 1
                    }
                }
                else {
                    mut i32 g ← 0
                    while g ≺ n_groups {
                        let f32 s ← scales[[row, g]]
                        let f32 b ← biases[[row, g]]
                        let i32 x_base ← g * group_size
                        mut f32 g_qx ← 0.0 ∷ f32
                        mut f32 g_x ← 0.0 ∷ f32
                        mut i32 k ← 0
                        while k ≺ group_size {
                            let i32 j ← x_base + k
                            let i32 word_idx ← j / 4
                            let i32 rem ← j % 4
                            let u32 w0 ← weight[[row, word_idx]]
                            mut u32 q ← 0 ∷ u32

                            if rem ≡ 0 {
                                q ← w0 ∧ (255 ∷ u32)
                            }
                            elif rem ≡ 1 {
                                q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                            }
                            elif rem ≡ 2 {
                                q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                            }
                            else {
                                q ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)
                            }

                            let f32 xv ← x[[j]]
                            g_qx ← g_qx + (q ↦ f32) * xv
                            g_x ← g_x + xv
                            k ← k + 1
                        }
                        acc ← acc + s * g_qx + b * g_x
                        g ← g + 1
                    }
                }
            }
            else {
                mut i32 g ← 0
                while g ≺ n_groups {
                    let f32 s ← scales[[row, g]]
                    let f32 b ← biases[[row, g]]
                    let i32 x_base ← g * group_size
                    mut f32 g_qx ← 0.0 ∷ f32
                    mut f32 g_x ← 0.0 ∷ f32
                    mut i32 k ← 0
                    while k ≺ group_size {
                        let i32 jj ← x_base + k
                        let i32 bit_pos ← jj * 6
                        let i32 word_idx ← bit_pos / 32
                        let i32 shift ← bit_pos % 32
                        let u32 w0 ← weight[[row, word_idx]]
                        mut u32 q ← 0 ∷ u32

                            if shift ≡ 0 {
                                q ← w0 ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 2 {
                                q ← (w0 ⇒ (2 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 4 {
                                q ← (w0 ⇒ (4 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 6 {
                                q ← (w0 ⇒ (6 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 8 {
                                q ← (w0 ⇒ (8 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 10 {
                                q ← (w0 ⇒ (10 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 12 {
                                q ← (w0 ⇒ (12 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 14 {
                                q ← (w0 ⇒ (14 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 16 {
                                q ← (w0 ⇒ (16 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 18 {
                                q ← (w0 ⇒ (18 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 20 {
                                q ← (w0 ⇒ (20 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 22 {
                                q ← (w0 ⇒ (22 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 24 {
                                q ← (w0 ⇒ (24 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 26 {
                                q ← (w0 ⇒ (26 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 28 {
                                let i32 word_idx1 ← word_idx + 1
                                let u32 w1 ← weight[[row, word_idx1]]
                                let u32 lo ← w0 ⇒ (28 ∷ u32)
                                let u32 hi ← (w1 ∧ (3 ∷ u32)) * (16 ∷ u32)
                                q ← lo + hi
                            }
                            else {
                                let i32 word_idx1 ← word_idx + 1
                                let u32 w1 ← weight[[row, word_idx1]]
                                let u32 lo ← w0 ⇒ (30 ∷ u32)
                                let u32 hi ← (w1 ∧ (15 ∷ u32)) * (4 ∷ u32)
                                q ← lo + hi
                            }

                            let f32 xv ← x[[jj]]
                            g_qx ← g_qx + (q ↦ f32) * xv
                            g_x ← g_x + xv
                        k ← k + 1
                    }
                    acc ← acc + s * g_qx + b * g_x
                    g ← g + 1
                }
            }

            y[[row]] ← acc
        }
    }
}

# Split-K partial-sum kernel for `linear_matvec_u32`: each lane `[row, part]`
# accumulates a strided subset of groups `part, part + KParts, ...` into `partials`.
@ public
kernel linear_matvec_u32_part<size Out, size PackedIn, size Groups, size In, size KParts>(tensor<u32, [Out, PackedIn]> weight, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out, KParts]> partials, i32 bits, i32 group_size) → void {
    for from partials at [row, part] thread lane let e {
        let i32 n_groups ← Groups ↦ i32
        let i32 k_parts ← KParts ↦ i32
        let i32 in_dim ← In ↦ i32
        if group_size ≥ 1 and group_size ≤ 4096 and n_groups ≥ 1 and n_groups ≤ 65536 and in_dim ≥ 1 and in_dim ≤ 16777216 and k_parts ≥ 1 and k_parts ≤ 256 and (bits ≡ 4 or bits ≡ 6 or bits ≡ 8) {
            mut f32 acc ← 0.0 ∷ f32

            if bits ≡ 4 {
                if group_size % 8 ≡ 0 {
                    let i32 words_per_group ← group_size / 8
                    mut i32 g ← part ↦ i32
                    while g ≺ n_groups {
                        let f32 s ← scales[[row, g]]
                        let f32 b ← biases[[row, g]]
                        let i32 w_base ← g * words_per_group
                        let i32 x_base ← g * group_size
                        mut f32 g_qx ← 0.0 ∷ f32
                        mut f32 g_x ← 0.0 ∷ f32
                        mut i32 wg ← 0
                        while wg ≺ words_per_group {
                            let i32 w_idx ← w_base + wg
                            let u32 w ← weight[[row, w_idx]]
                            let i32 j0 ← x_base + wg * 8
                            let i32 j1 ← j0 + 1
                            let i32 j2 ← j0 + 2
                            let i32 j3 ← j0 + 3
                            let i32 j4 ← j0 + 4
                            let i32 j5 ← j0 + 5
                            let i32 j6 ← j0 + 6
                            let i32 j7 ← j0 + 7
                            let f32 x0 ← x[[j0]]
                            let f32 x1 ← x[[j1]]
                            let f32 x2 ← x[[j2]]
                            let f32 x3 ← x[[j3]]
                            let f32 x4 ← x[[j4]]
                            let f32 x5 ← x[[j5]]
                            let f32 x6 ← x[[j6]]
                            let f32 x7 ← x[[j7]]
                            g_qx ← g_qx + ((w ∧ (15 ∷ u32)) ↦ f32) * x0 + (((w ⇒ (4 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x1 + (((w ⇒ (8 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x2 + (((w ⇒ (12 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x3 + (((w ⇒ (16 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x4 + (((w ⇒ (20 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x5 + (((w ⇒ (24 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x6 + (((w ⇒ (28 ∷ u32)) ∧ (15 ∷ u32)) ↦ f32) * x7
                            g_x ← g_x + x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7
                            wg ← wg + 1
                        }
                        acc ← acc + s * g_qx + b * g_x
                        g ← g + k_parts
                    }
                }
                else {
                    mut i32 g ← part ↦ i32
                    while g ≺ n_groups {
                        let f32 s ← scales[[row, g]]
                        let f32 b ← biases[[row, g]]
                        let i32 x_base ← g * group_size
                        mut f32 g_qx ← 0.0 ∷ f32
                        mut f32 g_x ← 0.0 ∷ f32
                        mut i32 k ← 0
                        while k ≺ group_size {
                            let i32 j ← x_base + k
                            let i32 word_idx ← j / 8
                            let i32 rem ← j % 8
                            let u32 w0 ← weight[[row, word_idx]]
                            mut u32 q ← 0 ∷ u32

                            if rem ≡ 0 {
                                q ← w0 ∧ (15 ∷ u32)
                            }
                            elif rem ≡ 1 {
                                q ← (w0 ⇒ (4 ∷ u32)) ∧ (15 ∷ u32)
                            }
                            elif rem ≡ 2 {
                                q ← (w0 ⇒ (8 ∷ u32)) ∧ (15 ∷ u32)
                            }
                            elif rem ≡ 3 {
                                q ← (w0 ⇒ (12 ∷ u32)) ∧ (15 ∷ u32)
                            }
                            elif rem ≡ 4 {
                                q ← (w0 ⇒ (16 ∷ u32)) ∧ (15 ∷ u32)
                            }
                            elif rem ≡ 5 {
                                q ← (w0 ⇒ (20 ∷ u32)) ∧ (15 ∷ u32)
                            }
                            elif rem ≡ 6 {
                                q ← (w0 ⇒ (24 ∷ u32)) ∧ (15 ∷ u32)
                            }
                            else {
                                q ← (w0 ⇒ (28 ∷ u32)) ∧ (15 ∷ u32)
                            }

                            let f32 xv ← x[[j]]
                            g_qx ← g_qx + (q ↦ f32) * xv
                            g_x ← g_x + xv
                            k ← k + 1
                        }
                        acc ← acc + s * g_qx + b * g_x
                        g ← g + k_parts
                    }
                }
            }
            elif bits ≡ 8 {
                if group_size % 4 ≡ 0 {
                    let i32 words_per_group ← group_size / 4
                    mut i32 g ← part ↦ i32
                    while g ≺ n_groups {
                        let f32 s ← scales[[row, g]]
                        let f32 b ← biases[[row, g]]
                        let i32 w_base ← g * words_per_group
                        let i32 x_base ← g * group_size
                        mut f32 g_qx ← 0.0 ∷ f32
                        mut f32 g_x ← 0.0 ∷ f32
                        mut i32 wg ← 0
                        while wg ≺ words_per_group {
                            let i32 w_idx ← w_base + wg
                            let u32 w ← weight[[row, w_idx]]
                            let i32 j0 ← x_base + wg * 4
                            let i32 j1 ← j0 + 1
                            let i32 j2 ← j0 + 2
                            let i32 j3 ← j0 + 3
                            let f32 x0 ← x[[j0]]
                            let f32 x1 ← x[[j1]]
                            let f32 x2 ← x[[j2]]
                            let f32 x3 ← x[[j3]]
                            g_qx ← g_qx + ((w ∧ (255 ∷ u32)) ↦ f32) * x0 + (((w ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)) ↦ f32) * x1 + (((w ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)) ↦ f32) * x2 + (((w ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)) ↦ f32) * x3
                            g_x ← g_x + x0 + x1 + x2 + x3
                            wg ← wg + 1
                        }
                        acc ← acc + s * g_qx + b * g_x
                        g ← g + k_parts
                    }
                }
                else {
                    mut i32 g ← part ↦ i32
                    while g ≺ n_groups {
                        let f32 s ← scales[[row, g]]
                        let f32 b ← biases[[row, g]]
                        let i32 x_base ← g * group_size
                        mut f32 g_qx ← 0.0 ∷ f32
                        mut f32 g_x ← 0.0 ∷ f32
                        mut i32 k ← 0
                        while k ≺ group_size {
                            let i32 j ← x_base + k
                            let i32 word_idx ← j / 4
                            let i32 rem ← j % 4
                            let u32 w0 ← weight[[row, word_idx]]
                            mut u32 q ← 0 ∷ u32

                            if rem ≡ 0 {
                                q ← w0 ∧ (255 ∷ u32)
                            }
                            elif rem ≡ 1 {
                                q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                            }
                            elif rem ≡ 2 {
                                q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                            }
                            else {
                                q ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)
                            }

                            let f32 xv ← x[[j]]
                            g_qx ← g_qx + (q ↦ f32) * xv
                            g_x ← g_x + xv
                            k ← k + 1
                        }
                        acc ← acc + s * g_qx + b * g_x
                        g ← g + k_parts
                    }
                }
            }
            else {
                mut i32 g ← part ↦ i32
                while g ≺ n_groups {
                    let f32 s ← scales[[row, g]]
                    let f32 b ← biases[[row, g]]
                    let i32 x_base ← g * group_size
                    mut f32 g_qx ← 0.0 ∷ f32
                    mut f32 g_x ← 0.0 ∷ f32
                    mut i32 k ← 0
                    while k ≺ group_size {
                        let i32 jj ← x_base + k
                        let i32 bit_pos ← jj * 6
                        let i32 word_idx ← bit_pos / 32
                        let i32 shift ← bit_pos % 32
                        let u32 w0 ← weight[[row, word_idx]]
                        mut u32 q ← 0 ∷ u32

                            if shift ≡ 0 {
                                q ← w0 ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 2 {
                                q ← (w0 ⇒ (2 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 4 {
                                q ← (w0 ⇒ (4 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 6 {
                                q ← (w0 ⇒ (6 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 8 {
                                q ← (w0 ⇒ (8 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 10 {
                                q ← (w0 ⇒ (10 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 12 {
                                q ← (w0 ⇒ (12 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 14 {
                                q ← (w0 ⇒ (14 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 16 {
                                q ← (w0 ⇒ (16 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 18 {
                                q ← (w0 ⇒ (18 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 20 {
                                q ← (w0 ⇒ (20 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 22 {
                                q ← (w0 ⇒ (22 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 24 {
                                q ← (w0 ⇒ (24 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 26 {
                                q ← (w0 ⇒ (26 ∷ u32)) ∧ (63 ∷ u32)
                            }
                            elif shift ≡ 28 {
                                let i32 word_idx1 ← word_idx + 1
                                let u32 w1 ← weight[[row, word_idx1]]
                                let u32 lo ← w0 ⇒ (28 ∷ u32)
                                let u32 hi ← (w1 ∧ (3 ∷ u32)) * (16 ∷ u32)
                                q ← lo + hi
                            }
                            else {
                                let i32 word_idx1 ← word_idx + 1
                                let u32 w1 ← weight[[row, word_idx1]]
                                let u32 lo ← w0 ⇒ (30 ∷ u32)
                                let u32 hi ← (w1 ∧ (15 ∷ u32)) * (4 ∷ u32)
                                q ← lo + hi
                            }

                            let f32 xv ← x[[jj]]
                            g_qx ← g_qx + (q ↦ f32) * xv
                            g_x ← g_x + xv
                        k ← k + 1
                    }
                    acc ← acc + s * g_qx + b * g_x
                    g ← g + k_parts
                }
            }

            partials[[row, part]] ← acc
        }
    }
}

# Split-K reduction kernel for `linear_matvec_u32_part`.
@ public
kernel linear_matvec_u32_combine<size Out, size KParts>(tensor<f32, [Out, KParts]> partials, mut tensor<f32, [Out]> y) → void {
    for from y at [row] thread lane let e {
        let i32 k_parts ← KParts ↦ i32
        if k_parts ≥ 1 and k_parts ≤ 256 {
            mut f32 acc ← 0.0 ∷ f32
            mut i32 p ← 0
            while p ≺ k_parts {
                acc ← acc + partials[[row, p]]
                p ← p + 1
            }
            y[[row]] ← acc
        }
    }
}

