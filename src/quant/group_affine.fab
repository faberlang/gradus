        if group_size ≥ 1 and group_size ≤ 4096 and n_groups ≥ 1 and n_groups ≤ 65536 and in_dim ≥ 1 and in_dim ≤ 16777216 and k_parts ≥ 1 and k_parts ≤ 256 {
