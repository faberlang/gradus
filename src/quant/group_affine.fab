                        let f32 s ← scales[[row, g]] ↦ f32
                        let f32 b ← biases[[row, g]] ↦ f32
                        let i32 x_base ← g * group_size
                        mut f32 g_qx ← 0.0 ∷ f32
                        mut f32 g_x ← 0.0 ∷ f32
                        mut i32 k ← 0
                        while k ≺ group_size {
                            let i32 j ← x_base + k
                            let u32 w0 ← weight[[row, j / 4]]
                            let i32 rem ← j % 4
                            mut u32 q ← 0 ∷ u32
                            if rem ≡ 0 { q ← w0 ∧ (255 ∷ u32) }
                            elif rem ≡ 1 { q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32) }
                            elif rem ≡ 2 { q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32) }
                            else { q ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32) }
                            let f32 xv ← x[[j]]
                            g_qx ← g_qx + (q ↦ f32) * xv
                            g_x ← g_x + xv
                            k ← k + 1
                        }
                        acc ← acc + s * g_qx + b * g_x
                        g ← g + k_parts
                    }
                }
            }
            else {
                mut i32 g ← part ↦ i32
                while g ≺ n_groups {
                    let f32 s ← scales[[row, g]] ↦ f32
                    let f32 b ← biases[[row, g]] ↦ f32
                    let i32 x_base ← g * group_size
                    mut f32 g_qx ← 0.0 ∷ f32
                    mut f32 g_x ← 0.0 ∷ f32
                    mut i32 k ← 0
                    while k ≺ group_size {
                        let i32 jj ← x_base + k
                        let i32 bit_pos ← jj * 6
                        let i32 word_idx ← bit_pos / 32
                        let i32 shift ← bit_pos % 32
                        let u32 w0 ← weight[[row, word_idx]]
                        mut u32 q ← 0 ∷ u32
                        if shift ≡ 0 { q ← w0 ∧ (63 ∷ u32) }
                        elif shift ≡ 2 { q ← (w0 ⇒ (2 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 4 { q ← (w0 ⇒ (4 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 6 { q ← (w0 ⇒ (6 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 8 { q ← (w0 ⇒ (8 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 10 { q ← (w0 ⇒ (10 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 12 { q ← (w0 ⇒ (12 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 14 { q ← (w0 ⇒ (14 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 16 { q ← (w0 ⇒ (16 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 18 { q ← (w0 ⇒ (18 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 20 { q ← (w0 ⇒ (20 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 22 { q ← (w0 ⇒ (22 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 24 { q ← (w0 ⇒ (24 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 26 { q ← (w0 ⇒ (26 ∷ u32)) ∧ (63 ∷ u32) }
                        elif shift ≡ 28 {
                            let u32 w1 ← weight[[row, word_idx + 1]]
                            q ← (w0 ⇒ (28 ∷ u32)) + (w1 ∧ (3 ∷ u32)) * (16 ∷ u32)
                        }
                        else {
                            let u32 w1 ← weight[[row, word_idx + 1]]
                            q ← (w0 ⇒ (30 ∷ u32)) + (w1 ∧ (15 ∷ u32)) * (4 ∷ u32)
                        }
                        let f32 xv ← x[[jj]]
                        g_qx ← g_qx + (q ↦ f32) * xv
                        g_x ← g_x + xv
                        k ← k + 1
                    }
                    acc ← acc + s * g_qx + b * g_x
                    g ← g + k_parts
                }
            }

            partials[[row, part]] ← acc
        }
    }
}

@ public
kernel linear_matvec_u8_bf16<size Out, size PackedIn, size Groups, size In>(tensor<u8, [Out, PackedIn]> weight, tensor<bf16, [Out, Groups]> scales, tensor<bf16, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out]> y, i32 bits, i32 group_size) → void {
    for from y at [row] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 {
            mut f32 acc ← 0.0 ∷ f32

            for exclusive In let j {
                let i32 g ← j / group_size
                let f32 s ← scales[[row, g]] ↦ f32
                let f32 b ← biases[[row, g]] ↦ f32
                mut u8 q ← 0 ∷ u8

                if bits ≡ 8 {
                    q ← weight[[row, j]]
                }
                else {
                    let u8 packed ← weight[[row, j / 2]]
                    if j % 2 ≡ 0 {
                        q ← packed ∧ (15 ∷ u8)
                    }
                    else {
                        q ← (packed ⇒ (4 ∷ u8)) ∧ (15 ∷ u8)
                    }
                }

                let f32 w ← (q ↦ f32) * s + b
                acc ← acc + w * x[[j]]
            }

            y[[row]] ← acc
        }
    }
}

# Split-K partial-sum kernel for `linear_matvec_u8_bf16`.
@ public
kernel linear_matvec_u8_bf16_part<size Out, size PackedIn, size Groups, size In, size KParts>(tensor<u8, [Out, PackedIn]> weight, tensor<bf16, [Out, Groups]> scales, tensor<bf16, [Out, Groups]> biases, tensor<f32, [In]> x, mut tensor<f32, [Out, KParts]> partials, i32 bits, i32 group_size) → void {
    for from partials at [row, part] thread lane let e {
        let i32 n_groups ← Groups ↦ i32
        let i32 k_parts ← KParts ↦ i32
        let i32 in_dim ← In ↦ i32
        if group_size ≥ 1 and group_size ≤ 4096 and n_groups ≥ 1 and n_groups ≤ 65536 and in_dim ≥ 1 and in_dim ≤ 16777216 and k_parts ≥ 1 and k_parts ≤ 256 and (bits ≡ 4 or bits ≡ 8) {
            mut f32 acc ← 0.0 ∷ f32
            mut i32 g ← part ↦ i32

            if bits ≡ 8 {
                while g ≺ n_groups {
                    let f32 s ← scales[[row, g]] ↦ f32
                    let f32 b ← biases[[row, g]] ↦ f32
                    let i32 x_base ← g * group_size
                    mut f32 g_qx ← 0.0 ∷ f32
                    mut f32 g_x ← 0.0 ∷ f32
                    mut i32 k ← 0
                    while k ≺ group_size {
                        let i32 j ← x_base + k
                        let f32 xv ← x[[j]]
                        g_qx ← g_qx + ((weight[[row, j]] ↦ i32) ↦ f32) * xv
                        g_x ← g_x + xv
                        k ← k + 1
                    }
                    acc ← acc + s * g_qx + b * g_x
                    g ← g + k_parts
                }
            }
            elif group_size % 2 ≡ 0 {
                let i32 bytes_per_group ← group_size / 2
                while g ≺ n_groups {
                    let f32 s ← scales[[row, g]] ↦ f32
                    let f32 b ← biases[[row, g]] ↦ f32
                    let i32 w_base ← g * bytes_per_group
                    let i32 x_base ← g * group_size
                    mut f32 g_qx ← 0.0 ∷ f32
                    mut f32 g_x ← 0.0 ∷ f32
                    mut i32 bg ← 0
                    while bg ≺ bytes_per_group {
                        let i32 w_idx ← w_base + bg
                        let i32 packed ← weight[[row, w_idx]] ↦ i32
                        let i32 j0 ← x_base + bg * 2
                        let i32 j1 ← j0 + 1
                        let f32 x0 ← x[[j0]]
                        let f32 x1 ← x[[j1]]
                        g_qx ← g_qx + ((packed ∧ 15) ↦ f32) * x0 + (((packed ⇒ 4) ∧ 15) ↦ f32) * x1
                        g_x ← g_x + x0 + x1
                        bg ← bg + 1
                    }
                    acc ← acc + s * g_qx + b * g_x
                    g ← g + k_parts
                }
            }
            else {
                while g ≺ n_groups {
                    let f32 s ← scales[[row, g]] ↦ f32
                    let f32 b ← biases[[row, g]] ↦ f32
                    let i32 x_base ← g * group_size
                    mut f32 g_qx ← 0.0 ∷ f32
                    mut f32 g_x ← 0.0 ∷ f32
                    mut i32 k ← 0
                    while k ≺ group_size {
                        let i32 j ← x_base + k
                        let i32 packed ← weight[[row, j / 2]] ↦ i32
                        let i32 q ← (j % 2 ≡ 0) ✓ (packed ∧ 15) ✗ ((packed ⇒ 4) ∧ 15)
                        let f32 xv ← x[[j]]
                        g_qx ← g_qx + (q ↦ f32) * xv
                        g_x ← g_x + xv
                        k ← k + 1
                    }
                    acc ← acc + s * g_qx + b * g_x
                    g ← g + k_parts
                }
            }

            partials[[row, part]] ← acc
        }
    }
}

@ public
kernel linear_matmul_u32_bf16<size B, size Out, size PackedIn, size Groups, size In>(tensor<u32, [Out, PackedIn]> weight, tensor<bf16, [Out, Groups]> scales, tensor<bf16, [Out, Groups]> biases, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y, i32 bits, i32 group_size) → void {
    for from y at [b_idx, row] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 and bits ≥ 4 and bits ≤ 8 {
            mut f32 acc ← 0.0 ∷ f32

            for exclusive In let j {
                let i32 g ← j / group_size
                let f32 s ← scales[[row, g]] ↦ f32
                let f32 b ← biases[[row, g]] ↦ f32
                let i64 bit_pos ← j * bits
                let i64 word_idx ← bit_pos / 32
                let i64 shift ← bit_pos % 32
                let u32 w0 ← weight[[row, word_idx]]
                mut u32 q ← 0 ∷ u32

                if bits ≡ 8 {
                    if shift ≡ 0 {
                        q ← w0 ∧ (255 ∷ u32)
                    }
                    elif shift ≡ 8 {
                        q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                    }
                    elif shift ≡ 16 {
                        q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                    }
                    else {
                        q ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)
                    }
                }
                elif bits ≡ 4 {
                    if shift ≡ 0 {
                        q ← w0 ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 4 {
                        q ← (w0 ⇒ (4 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 8 {
                        q ← (w0 ⇒ (8 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 12 {
                        q ← (w0 ⇒ (12 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 16 {
                        q ← (w0 ⇒ (16 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 20 {
                        q ← (w0 ⇒ (20 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    elif shift ≡ 24 {
                        q ← (w0 ⇒ (24 ∷ u32)) ∧ (15 ∷ u32)
                    }
                    else {
                        q ← (w0 ⇒ (28 ∷ u32)) ∧ (15 ∷ u32)
                    }
                }
                else {
                    if shift ≡ 0 {
                        q ← w0 ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 2 {
                        q ← (w0 ⇒ (2 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 4 {
                        q ← (w0 ⇒ (4 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 6 {
                        q ← (w0 ⇒ (6 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 8 {
                        q ← (w0 ⇒ (8 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 10 {
                        q ← (w0 ⇒ (10 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 12 {
                        q ← (w0 ⇒ (12 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 14 {
                        q ← (w0 ⇒ (14 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 16 {
                        q ← (w0 ⇒ (16 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 18 {
                        q ← (w0 ⇒ (18 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 20 {
                        q ← (w0 ⇒ (20 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 22 {
                        q ← (w0 ⇒ (22 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 24 {
                        q ← (w0 ⇒ (24 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 26 {
                        q ← (w0 ⇒ (26 ∷ u32)) ∧ (63 ∷ u32)
                    }
                    elif shift ≡ 28 {
                        let u32 w1 ← weight[[row, word_idx + 1]]
                        let u32 lo ← w0 ⇒ (28 ∷ u32)
                        let u32 hi ← (w1 ∧ (3 ∷ u32)) * (16 ∷ u32)
                        q ← lo + hi
                    }
                    else {
                        let u32 w1 ← weight[[row, word_idx + 1]]
                        let u32 lo ← w0 ⇒ (30 ∷ u32)
                        let u32 hi ← (w1 ∧ (15 ∷ u32)) * (4 ∷ u32)
                        q ← lo + hi
                    }
                }

                let f32 w ← (q ↦ f32) * s + b
                acc ← acc + w * x[[b_idx, j]]
            }

            y[[b_idx, row]] ← acc
        }
    }
}

@ public
kernel linear_matmul_u8_bf16<size B, size Out, size PackedIn, size Groups, size In>(tensor<u8, [Out, PackedIn]> weight, tensor<bf16, [Out, Groups]> scales, tensor<bf16, [Out, Groups]> biases, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y, i32 bits, i32 group_size) → void {
    for from y at [b_idx, row] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 {
            mut f32 acc ← 0.0 ∷ f32

            for exclusive In let j {
                let i32 g ← j / group_size
                let f32 s ← scales[[row, g]] ↦ f32
                let f32 b ← biases[[row, g]] ↦ f32
                mut u8 q ← 0 ∷ u8

                if bits ≡ 8 {
                    q ← weight[[row, j]]
                }
                else {
                    let u8 packed ← weight[[row, j / 2]]
                    if j % 2 ≡ 0 {
                        q ← packed ∧ (15 ∷ u8)
                    }
                    else {
                        q ← (packed ⇒ (4 ∷ u8)) ∧ (15 ∷ u8)
                    }
                }

                let f32 w ← (q ↦ f32) * s + b
                acc ← acc + w * x[[b_idx, j]]
            }

            y[[b_idx, row]] ← acc
        }
    }
}

+++ faber test
import from "gradus:quant/group_affine" ga

fn close(f32 a, f32 b) → bool {
    let f32 diff ← (a - b).abs()
    let f32 tol ← (1.0e-5 ∷ f32) + (1.0e-4 ∷ f32) * b.abs()
    return diff ≤ tol
}

fn spec_result(int o, int i, int bits, int g, ga.PackKind p) → string {
    do {
        ga.admit_spec(o, i, bits, g, p)
        return "ok"
    }
    catch err {
        return err.message
    }
}

test "GroupAffine spec validates shape/group/pack divisibility fail-closed" {
    assert spec_result(4, 16, 8, 4, variant ga.PackKind.PackU32) ≡ "ok"
    assert spec_result(4, 16, 4, 4, variant ga.PackKind.PackU8) ≡ "ok"
    assert spec_result(4, 16, 6, 16, variant ga.PackKind.PackU32) ≡ "ok"
    assert spec_result(4, 15, 8, 4, variant ga.PackKind.PackU32) ≡ "in_features must be divisible by group_size"
    assert spec_result(4, 16, 6, 4, variant ga.PackKind.PackU8) ≡ "u8 packing supports 4-bit and 8-bit weights only"
    assert spec_result(4, 12, 6, 4, variant ga.PackKind.PackU32) ≡ "in_features * bits must be divisible by pack width"
}

test "GroupAffine 8-bit u32-packed ref decode and kernel GEMV match" {
    # Out=2, In=8, group_size=4 -> PackedIn=2 u32s, Groups=2
    # Row 0: q = [1, 2, 3, 4, 5, 6, 7, 8], s=[0.5, 2.0], b=[-1.0, 0.25]
    # Row 1: q = [0, 10, 20, 30, 255, 128, 64, 1], s=[0.25, -0.5], b=[0.0, 1.0]
    let u32 r0w0 ← 0x04030201 ∷ u32
    let u32 r0w1 ← 0x08070605 ∷ u32
    let u32 r1w0 ← 0x1e140a00 ∷ u32
    let u32 r1w1 ← 0x014080ff ∷ u32
    let list<u32> w_list ← [r0w0, r0w1, r1w0, r1w1]
    let list<f32> s_list ← [0.5, 2.0, 0.25, -0.5]
    let list<f32> b_list ← [-1.0, 0.25, 0.0, 1.0]
    let list<f32> x_list ← [1.0, -2.0, 0.5, 4.0, -1.0, 2.0, -0.5, 3.0]

    do {
        let ga.GroupAffineSpec spec ← ga.admit_spec(2, 8, 8, 4, variant ga.PackKind.PackU32)
        let list<f32> w_dense ← ga.ref_dequantize_u32(spec, w_list, s_list, b_list)
        let list<f32> y_ref ← ga.ref_matvec(2, 8, w_dense, x_list)

        mut tensor<u32, [2, 2]> w_t ← tu32[2, 2] {}
        w_t[[0, 0]] ← r0w0
        w_t[[0, 1]] ← r0w1
        w_t[[1, 0]] ← r1w0
        w_t[[1, 1]] ← r1w1
        mut tensor<f32, [2, 2]> s_t ← tf32[2, 2] {}
        s_t[[0, 0]] ← 0.5
        s_t[[0, 1]] ← 2.0
        s_t[[1, 0]] ← 0.25
        s_t[[1, 1]] ← -0.5
        mut tensor<f32, [2, 2]> b_t ← tf32[2, 2] {}
        b_t[[0, 0]] ← -1.0
        b_t[[0, 1]] ← 0.25
        b_t[[1, 0]] ← 0.0
        b_t[[1, 1]] ← 1.0
        mut tensor<f32, [8]> x_t ← tf32[8] {}
        for exclusive 8 let j {
            x_t[[j]] ← x_list[j]
        }
        mut tensor<f32, [2]> y_k ← tf32[2] {}

        ga.linear_matvec_u32(w_t, s_t, b_t, x_t, mut y_k, 8, 4)
        assert close(y_k[[0]], y_ref[0])
        assert close(y_k[[1]], y_ref[1])

        mut tensor<f32, [2, 2]> p_k ← tf32[2, 2] {}
        mut tensor<f32, [2]> y_sk ← tf32[2] {}
        ga.linear_matvec_u32_part(w_t, s_t, b_t, x_t, mut p_k, 8, 4)
        ga.linear_matvec_u32_combine(p_k, mut y_sk)
        assert close(y_sk[[0]], y_ref[0])
        assert close(y_sk[[1]], y_ref[1])

        # Split-K specialized 8bit_u32_part
        ga.linear_matvec_8bit_u32_part(w_t, s_t, b_t, x_t, mut p_k, 4 ∷ i32)
        ga.linear_matvec_u32_combine(p_k, mut y_sk)
        assert close(y_sk[[0]], y_ref[0])
        assert close(y_sk[[1]], y_ref[1])

        # Split-K specialized 4bit_u32_part
        let list<u32> w4_list ← [0x87654321 ∷ u32, 0xfedcba98 ∷ u32]
        let ga.GroupAffineSpec spec4_u32 ← ga.admit_spec(2, 8, 4, 4, variant ga.PackKind.PackU32)
        let list<f32> ref4_u32 ← ga.ref_matvec(2, 8, ga.ref_dequantize_u32(spec4_u32, w4_list, s_list, b_list), x_list)
        mut tensor<u32, [2, 1]> w4_t ← tu32[2, 1] {}
        w4_t[[0, 0]] ← w4_list[0]
        w4_t[[1, 0]] ← w4_list[1]
        ga.linear_matvec_4bit_u32_part(w4_t, s_t, b_t, x_t, mut p_k, 4 ∷ i32)
        ga.linear_matvec_u32_combine(p_k, mut y_sk)
        assert close(y_sk[[0]], ref4_u32[0])
        assert close(y_sk[[1]], ref4_u32[1])

        # Split-K u32_bf16_part
        let list<bf16> s_bf16 ← [(0.5 ∷ f32) ↦ bf16, (2.0 ∷ f32) ↦ bf16, (0.25 ∷ f32) ↦ bf16, (-0.5 ∷ f32) ↦ bf16]
        let list<bf16> b_bf16 ← [(-1.0 ∷ f32) ↦ bf16, (0.25 ∷ f32) ↦ bf16, (0.0 ∷ f32) ↦ bf16, (1.0 ∷ f32) ↦ bf16]
        mut tensor<bf16, [2, 2]> s_bt ← tbf16[2, 2] {}
        mut tensor<bf16, [2, 2]> b_bt ← tbf16[2, 2] {}
        for exclusive 2 let r {
            for exclusive 2 let g {
                let int idx ← r * 2 + g
                s_bt[[r, g]] ← s_bf16[idx]
                b_bt[[r, g]] ← b_bf16[idx]
            }
        }
        let list<f32> ref8_u32_bf16 ← ga.ref_matvec(2, 8, ga.ref_dequantize_u32_bf16(spec, w_list, s_bf16, b_bf16), x_list)
        ga.linear_matvec_u32_bf16_part(w_t, s_bt, b_bt, x_t, mut p_k, 8 ∷ i32, 4 ∷ i32)
        ga.linear_matvec_u32_combine(p_k, mut y_sk)
        assert close(y_sk[[0]], ref8_u32_bf16[0])
        assert close(y_sk[[1]], ref8_u32_bf16[1])

        # Split-K u8_part (4-bit and 8-bit) + u8_bf16_part
        let list<u8> wu8_4_list ← [0x21 ∷ u8, 0x43 ∷ u8, 0x65 ∷ u8, 0x87 ∷ u8, 0xa9 ∷ u8, 0xcb ∷ u8, 0xed ∷ u8, 0x0f ∷ u8]
        let ga.GroupAffineSpec spec4_u8 ← ga.admit_spec(2, 8, 4, 4, variant ga.PackKind.PackU8)
        let list<f32> ref4_u8 ← ga.ref_matvec(2, 8, ga.ref_dequantize_u8(spec4_u8, wu8_4_list, s_list, b_list), x_list)
        let list<f32> ref4_u8_bf16 ← ga.ref_matvec(2, 8, ga.ref_dequantize_u8_bf16(spec4_u8, wu8_4_list, s_bf16, b_bf16), x_list)
        mut tensor<u8, [2, 4]> wu8_4_t ← tu8[2, 4] {}
        for exclusive 2 let r {
            for exclusive 4 let c {
                wu8_4_t[[r, c]] ← wu8_4_list[r * 4 + c]
            }
        }
        ga.linear_matvec_u8_part(wu8_4_t, s_t, b_t, x_t, mut p_k, 4 ∷ i32, 4 ∷ i32)
        ga.linear_matvec_u32_combine(p_k, mut y_sk)
        assert close(y_sk[[0]], ref4_u8[0])
        assert close(y_sk[[1]], ref4_u8[1])

        ga.linear_matvec_u8_bf16_part(wu8_4_t, s_bt, b_bt, x_t, mut p_k, 4 ∷ i32, 4 ∷ i32)
        ga.linear_matvec_u32_combine(p_k, mut y_sk)
        assert close(y_sk[[0]], ref4_u8_bf16[0])
        assert close(y_sk[[1]], ref4_u8_bf16[1])

        let list<u8> wu8_8_list ← [1 ∷ u8, 2 ∷ u8, 3 ∷ u8, 4 ∷ u8, 5 ∷ u8, 6 ∷ u8, 7 ∷ u8, 8 ∷ u8, 10 ∷ u8, 20 ∷ u8, 30 ∷ u8, 40 ∷ u8, 255 ∷ u8, 128 ∷ u8, 64 ∷ u8, 1 ∷ u8]
        let ga.GroupAffineSpec spec8_u8 ← ga.admit_spec(2, 8, 8, 4, variant ga.PackKind.PackU8)
        let list<f32> ref8_u8 ← ga.ref_matvec(2, 8, ga.ref_dequantize_u8(spec8_u8, wu8_8_list, s_list, b_list), x_list)
        mut tensor<u8, [2, 8]> wu8_8_t ← tu8[2, 8] {}
        for exclusive 2 let r {
            for exclusive 8 let c {
                wu8_8_t[[r, c]] ← wu8_8_list[r * 8 + c]
            }
        }
        ga.linear_matvec_u8_part(wu8_8_t, s_t, b_t, x_t, mut p_k, 8 ∷ i32, 4 ∷ i32)
        ga.linear_matvec_u32_combine(p_k, mut y_sk)
        assert close(y_sk[[0]], ref8_u8[0])
        assert close(y_sk[[1]], ref8_u8[1])
    }
    catch err {
        assert false
    }
}

test "GroupAffine 4-bit u8-packed (Flint style) ref decode and kernel GEMV match" {
    # Out=2, In=4, group_size=4 -> PackedIn=2 u8s, Groups=1
    let list<u8> w_list ← [0x21, 0xf3, 0x05, 0xa7]
    let list<f32> s_list ← [0.25, -0.5]
    let list<f32> b_list ← [-1.0, 2.0]
    let list<f32> x_list ← [1.0, -2.0, 3.0, 0.5]

    do {
        let ga.GroupAffineSpec spec ← ga.admit_spec(2, 4, 4, 4, variant ga.PackKind.PackU8)
        let list<f32> w_dense ← ga.ref_dequantize_u8(spec, w_list, s_list, b_list)
        let list<f32> y_ref ← ga.ref_matvec(2, 4, w_dense, x_list)

        mut tensor<u8, [2, 2]> w_t ← tu8[2, 2] {}
        w_t[[0, 0]] ← 0x21 ∷ u8
        w_t[[0, 1]] ← 0xf3 ∷ u8
        w_t[[1, 0]] ← 0x05 ∷ u8
        w_t[[1, 1]] ← 0xa7 ∷ u8
        mut tensor<f32, [2, 1]> s_t ← tf32[2, 1] {}
        s_t[[0, 0]] ← 0.25
        s_t[[1, 0]] ← -0.5
        mut tensor<f32, [2, 1]> b_t ← tf32[2, 1] {}
        b_t[[0, 0]] ← -1.0
        b_t[[1, 0]] ← 2.0
        mut tensor<f32, [4]> x_t ← tf32[4] {}
        for exclusive 4 let j {
            x_t[[j]] ← x_list[j]
        }
        mut tensor<f32, [2]> y_k ← tf32[2] {}

        ga.linear_matvec_u8(w_t, s_t, b_t, x_t, mut y_k, 4, 4)
        assert close(y_k[[0]], y_ref[0])
        assert close(y_k[[1]], y_ref[1])
    }
    catch err {
        assert false
    }
}

test "GroupAffine 6-bit u32-packed (SmolLM2-360M style) ref decode and kernel GEMV match" {
    # Out=1, In=16, group_size=16 -> 16*6 = 96 bits = 3 u32 words, Groups=1
    # Pack q[j] = (j * 3 + 1) % 64 into 3 u32 words:
    # j=0..5: 1,4,7,10,13 -> bits 0..29 + j=5(16): 16&3=0 at 30..31 -> word0
    let u32 w0 ← 0x1a0ca301 ∷ u32
    let u32 w1 ← 0x89581762 ∷ u32
    let u32 w2 ← 0x74b1a094 ∷ u32
    let list<u32> w_list ← [w0, w1, w2]
    let list<f32> s_list ← [0.125]
    let list<f32> b_list ← [-2.0]
    mut list<f32> x_list ← empty
    for exclusive 16 let j {
        x_list.append(((j ↦ f32) - 7.5 ∷ f32) * (0.25 ∷ f32))
    }

    do {
        let ga.GroupAffineSpec spec ← ga.admit_spec(1, 16, 6, 16, variant ga.PackKind.PackU32)
        let list<f32> w_dense ← ga.ref_dequantize_u32(spec, w_list, s_list, b_list)
        let list<f32> y_ref ← ga.ref_matvec(1, 16, w_dense, x_list)

        mut tensor<u32, [1, 3]> w_t ← tu32[1, 3] {}
        w_t[[0, 0]] ← w0
        w_t[[0, 1]] ← w1
        w_t[[0, 2]] ← w2
        mut tensor<f32, [1, 1]> s_t ← tf32[1, 1] {}
        s_t[[0, 0]] ← 0.125
        mut tensor<f32, [1, 1]> b_t ← tf32[1, 1] {}
        b_t[[0, 0]] ← -2.0
        mut tensor<f32, [16]> x_t ← tf32[16] {}
        for exclusive 16 let j {
            x_t[[j]] ← x_list[j]
        }
        mut tensor<f32, [1]> y_k ← tf32[1] {}

        ga.linear_matvec_u32(w_t, s_t, b_t, x_t, mut y_k, 6, 16)
        assert close(y_k[[0]], y_ref[0])

        # Multi-group Split-K (Groups=4, KParts=2) proves g <- g + k_parts for 6-bit.
        let list<f32> s4_list ← [0.125, -0.25, 0.5, -0.125]
        let list<f32> b4_list ← [-2.0, 0.5, -0.25, 1.0]
        let ga.GroupAffineSpec spec4 ← ga.admit_spec(1, 16, 6, 4, variant ga.PackKind.PackU32)
        let list<f32> w4_dense ← ga.ref_dequantize_u32(spec4, w_list, s4_list, b4_list)
        let list<f32> y4_ref ← ga.ref_matvec(1, 16, w4_dense, x_list)

        mut tensor<f32, [1, 4]> s4_t ← tf32[1, 4] {}
        mut tensor<f32, [1, 4]> b4_t ← tf32[1, 4] {}
        for exclusive 4 let g {
            s4_t[[0, g]] ← s4_list[g]
            b4_t[[0, g]] ← b4_list[g]
        }
        mut tensor<f32, [1, 2]> p_k ← tf32[1, 2] {}
        mut tensor<f32, [1]> y_sk ← tf32[1] {}
        ga.linear_matvec_u32_part(w_t, s4_t, b4_t, x_t, mut p_k, 6, 4)
        ga.linear_matvec_u32_combine(p_k, mut y_sk)
        assert close(y_sk[[0]], y4_ref[0])
    }
    catch err {
        assert false
    }
}

test "GroupAffine 8-bit u32-packed batched linear_matmul matches ref_matmul" {
    let u32 r0w0 ← 0x04030201 ∷ u32
    let u32 r0w1 ← 0x08070605 ∷ u32
    let u32 r1w0 ← 0x1e140a00 ∷ u32
    let u32 r1w1 ← 0x014080ff ∷ u32
    let list<u32> w_list ← [r0w0, r0w1, r1w0, r1w1]
    let list<f32> s_list ← [0.5, 2.0, 0.25, -0.5]
    let list<f32> b_list ← [-1.0, 0.25, 0.0, 1.0]
    let list<f32> x_list ← [
        1.0, -2.0, 0.5, 4.0, -1.0, 2.0, -0.5, 3.0,
        -0.5, 1.5, -1.0, 0.25, 2.0, -1.0, 1.5, -0.5
    ]

    do {
        let ga.GroupAffineSpec spec ← ga.admit_spec(2, 8, 8, 4, variant ga.PackKind.PackU32)
        let list<f32> w_dense ← ga.ref_dequantize_u32(spec, w_list, s_list, b_list)
        let list<f32> y_ref ← ga.ref_matmul(2, 2, 8, w_dense, x_list)

        mut tensor<u32, [2, 2]> w_t ← tu32[2, 2] {}
        w_t[[0, 0]] ← r0w0
        w_t[[0, 1]] ← r0w1
        w_t[[1, 0]] ← r1w0
        w_t[[1, 1]] ← r1w1
        mut tensor<f32, [2, 2]> s_t ← tf32[2, 2] {}
        s_t[[0, 0]] ← 0.5
        s_t[[0, 1]] ← 2.0
        s_t[[1, 0]] ← 0.25
        s_t[[1, 1]] ← -0.5
        mut tensor<f32, [2, 2]> b_t ← tf32[2, 2] {}
        b_t[[0, 0]] ← -1.0
        b_t[[0, 1]] ← 0.25
        b_t[[1, 0]] ← 0.0
        b_t[[1, 1]] ← 1.0
        mut tensor<f32, [2, 8]> x_t ← tf32[2, 8] {}
        for exclusive 2 let bi {
            for exclusive 8 let j {
                x_t[[bi, j]] ← x_list[bi * 8 + j]
            }
        }
        mut tensor<f32, [2, 2]> y_k ← tf32[2, 2] {}

        ga.linear_matmul_u32(w_t, s_t, b_t, x_t, mut y_k, 8, 4)
        assert close(y_k[[0, 0]], y_ref[0])
        assert close(y_k[[0, 1]], y_ref[1])
        assert close(y_k[[1, 0]], y_ref[2])
        assert close(y_k[[1, 1]], y_ref[3])
    }
    catch err {
        assert false
    }
}

test "GroupAffine 4-bit u8-packed batched linear_matmul matches ref_matmul" {
    let list<u8> w_list ← [0x21, 0xf3, 0x05, 0xa7]
    let list<f32> s_list ← [0.25, -0.5]
    let list<f32> b_list ← [-1.0, 2.0]
    let list<f32> x_list ← [
        1.0, -2.0, 3.0, 0.5,
        -1.5, 0.5, 2.0, -3.0
    ]

    do {
        let ga.GroupAffineSpec spec ← ga.admit_spec(2, 4, 4, 4, variant ga.PackKind.PackU8)
        let list<f32> w_dense ← ga.ref_dequantize_u8(spec, w_list, s_list, b_list)
        let list<f32> y_ref ← ga.ref_matmul(2, 2, 4, w_dense, x_list)

        mut tensor<u8, [2, 2]> w_t ← tu8[2, 2] {}
        w_t[[0, 0]] ← 0x21 ∷ u8
        w_t[[0, 1]] ← 0xf3 ∷ u8
        w_t[[1, 0]] ← 0x05 ∷ u8
        w_t[[1, 1]] ← 0xa7 ∷ u8
        mut tensor<f32, [2, 1]> s_t ← tf32[2, 1] {}
        s_t[[0, 0]] ← 0.25
        s_t[[1, 0]] ← -0.5
        mut tensor<f32, [2, 1]> b_t ← tf32[2, 1] {}
        b_t[[0, 0]] ← -1.0
        b_t[[1, 0]] ← 2.0
        mut tensor<f32, [2, 4]> x_t ← tf32[2, 4] {}
        for exclusive 2 let bi {
            for exclusive 4 let j {
                x_t[[bi, j]] ← x_list[bi * 4 + j]
            }
        }
        mut tensor<f32, [2, 2]> y_k ← tf32[2, 2] {}

        ga.linear_matmul_u8(w_t, s_t, b_t, x_t, mut y_k, 4, 4)
        assert close(y_k[[0, 0]], y_ref[0])
        assert close(y_k[[0, 1]], y_ref[1])
        assert close(y_k[[1, 0]], y_ref[2])
        assert close(y_k[[1, 1]], y_ref[3])
    }
    catch err {
        assert false
    }
}

test "GroupAffine kernels handle rows above 65536 without aliasing" {
    # Out=65540 (> 65536), In=8, bits=4, group_size=4 (group_size % 8 != 0) -> PackedIn=1 u32, Groups=2, KParts=2.
    mut tensor<u32, [65540, 1]> w_u32 ← tu32[65540, 1] {}
    w_u32[[1, 0]] ← 0x00000011 ∷ u32
    w_u32[[65537, 0]] ← 0x22222222 ∷ u32

    mut tensor<u8, [65540, 4]> w_u8 ← tu8[65540, 4] {}
    w_u8[[1, 0]] ← 0x11 ∷ u8
    w_u8[[65537, 0]] ← 0x22 ∷ u8
    w_u8[[65537, 1]] ← 0x22 ∷ u8
    w_u8[[65537, 2]] ← 0x22 ∷ u8
    w_u8[[65537, 3]] ← 0x22 ∷ u8

    mut tensor<f32, [65540, 2]> scales ← tf32[65540, 2] {}
    scales[[1, 0]] ← 1.0 ∷ f32
    scales[[1, 1]] ← 1.0 ∷ f32
    scales[[65537, 0]] ← 2.0 ∷ f32
    scales[[65537, 1]] ← 1.0 ∷ f32

    mut tensor<f32, [65540, 2]> biases ← tf32[65540, 2] {}
    biases[[1, 0]] ← 0.0 ∷ f32
    biases[[1, 1]] ← 0.25 ∷ f32
    biases[[65537, 0]] ← 1.0 ∷ f32
    biases[[65537, 1]] ← 0.5 ∷ f32

    mut tensor<f32, [8]> x_vec ← tf32[8] {}
    mut tensor<f32, [2, 8]> x_mat ← tf32[2, 8] {}
    for exclusive 8 let j {
        x_vec[[j]] ← 1.0 ∷ f32
        x_mat[[0, j]] ← 1.0 ∷ f32
        x_mat[[1, j]] ← 2.0 ∷ f32
    }

    mut tensor<f32, [65540]> y_mv_u32 ← tf32[65540] {}
    mut tensor<f32, [65540]> y_mv_u8 ← tf32[65540] {}
    mut tensor<f32, [2, 65540]> y_mm_u32 ← tf32[2, 65540] {}
    mut tensor<f32, [2, 65540]> y_mm_u8 ← tf32[2, 65540] {}

    ga.linear_matvec_u32(w_u32, scales, biases, x_vec, mut y_mv_u32, 4, 4)
    mut tensor<f32, [65540, 2]> p_mv_u32 ← tf32[65540, 2] {}
    mut tensor<f32, [65540]> y_mv_u32_sk ← tf32[65540] {}
    ga.linear_matvec_u32_part(w_u32, scales, biases, x_vec, mut p_mv_u32, 4, 4)
    ga.linear_matvec_u32_combine(p_mv_u32, mut y_mv_u32_sk)
    assert close(y_mv_u32_sk[[0]], 0.0 ∷ f32)
    assert close(y_mv_u32_sk[[1]], 3.0 ∷ f32)
    assert close(y_mv_u32_sk[[65537]], 30.0 ∷ f32)
    ga.linear_matvec_u8(w_u8, scales, biases, x_vec, mut y_mv_u8, 4, 4)
    ga.linear_matmul_u32(w_u32, scales, biases, x_mat, mut y_mm_u32, 4, 4)
    ga.linear_matmul_u8(w_u8, scales, biases, x_mat, mut y_mm_u8, 4, 4)

    assert close(y_mv_u32[[0]], 0.0 ∷ f32)
    assert close(y_mv_u32[[1]], 3.0 ∷ f32)
    assert close(y_mv_u32[[65537]], 30.0 ∷ f32)

    assert close(y_mv_u8[[0]], 0.0 ∷ f32)
    assert close(y_mv_u8[[1]], 3.0 ∷ f32)
    assert close(y_mv_u8[[65537]], 30.0 ∷ f32)

    assert close(y_mm_u32[[0, 1]], 3.0 ∷ f32)
    assert close(y_mm_u32[[0, 65537]], 30.0 ∷ f32)
    assert close(y_mm_u32[[1, 1]], 6.0 ∷ f32)
    assert close(y_mm_u32[[1, 65537]], 60.0 ∷ f32)

    assert close(y_mm_u8[[0, 1]], 3.0 ∷ f32)
    assert close(y_mm_u8[[0, 65537]], 30.0 ∷ f32)
    assert close(y_mm_u8[[1, 1]], 6.0 ∷ f32)
    assert close(y_mm_u8[[1, 65537]], 60.0 ∷ f32)

    mut tensor<bf16, [65540, 2]> scales_bf16 ← tbf16[65540, 2] {}
    scales_bf16[[1, 0]] ← (1.0 ∷ f32) ↦ bf16
    scales_bf16[[1, 1]] ← (1.0 ∷ f32) ↦ bf16
    scales_bf16[[65537, 0]] ← (2.0 ∷ f32) ↦ bf16
    scales_bf16[[65537, 1]] ← (1.0 ∷ f32) ↦ bf16

    mut tensor<bf16, [65540, 2]> biases_bf16 ← tbf16[65540, 2] {}
    biases_bf16[[1, 0]] ← (0.0 ∷ f32) ↦ bf16
    biases_bf16[[1, 1]] ← (0.25 ∷ f32) ↦ bf16
    biases_bf16[[65537, 0]] ← (1.0 ∷ f32) ↦ bf16
    biases_bf16[[65537, 1]] ← (0.5 ∷ f32) ↦ bf16

    mut tensor<f32, [65540]> y_mv_u32_bf16 ← tf32[65540] {}
    mut tensor<f32, [65540]> y_mv_u8_bf16 ← tf32[65540] {}
    mut tensor<f32, [2, 65540]> y_mm_u32_bf16 ← tf32[2, 65540] {}
    mut tensor<f32, [2, 65540]> y_mm_u8_bf16 ← tf32[2, 65540] {}

    ga.linear_matvec_u32_bf16(w_u32, scales_bf16, biases_bf16, x_vec, mut y_mv_u32_bf16, 4, 4)
    ga.linear_matvec_u8_bf16(w_u8, scales_bf16, biases_bf16, x_vec, mut y_mv_u8_bf16, 4, 4)
    ga.linear_matmul_u32_bf16(w_u32, scales_bf16, biases_bf16, x_mat, mut y_mm_u32_bf16, 4, 4)
    ga.linear_matmul_u8_bf16(w_u8, scales_bf16, biases_bf16, x_mat, mut y_mm_u8_bf16, 4, 4)

    assert close(y_mv_u32_bf16[[0]], 0.0 ∷ f32)
    assert close(y_mv_u32_bf16[[1]], 3.0 ∷ f32)
    assert close(y_mv_u32_bf16[[65537]], 30.0 ∷ f32)

    assert close(y_mv_u8_bf16[[0]], 0.0 ∷ f32)
    assert close(y_mv_u8_bf16[[1]], 3.0 ∷ f32)
    assert close(y_mv_u8_bf16[[65537]], 30.0 ∷ f32)

    assert close(y_mm_u32_bf16[[0, 1]], 3.0 ∷ f32)
    assert close(y_mm_u32_bf16[[0, 65537]], 30.0 ∷ f32)
    assert close(y_mm_u32_bf16[[1, 1]], 6.0 ∷ f32)
    assert close(y_mm_u32_bf16[[1, 65537]], 60.0 ∷ f32)

    assert close(y_mm_u8_bf16[[0, 1]], 3.0 ∷ f32)
    assert close(y_mm_u8_bf16[[0, 65537]], 30.0 ∷ f32)
    assert close(y_mm_u8_bf16[[1, 1]], 6.0 ∷ f32)
    assert close(y_mm_u8_bf16[[1, 65537]], 60.0 ∷ f32)
}

test "GroupAffine native bf16 scales and biases ref decode and matmul match" {
    let list<bf16> s_u32_bf16 ← [(0.5 ∷ f32) ↦ bf16, (2.0 ∷ f32) ↦ bf16, (0.25 ∷ f32) ↦ bf16, (-0.5 ∷ f32) ↦ bf16]
    let list<bf16> b_u32_bf16 ← [(-1.0 ∷ f32) ↦ bf16, (0.25 ∷ f32) ↦ bf16, (0.0 ∷ f32) ↦ bf16, (1.0 ∷ f32) ↦ bf16]
    let list<u32> w_u32 ← [0x04030201 ∷ u32, 0x08070605 ∷ u32, 0x1e140a00 ∷ u32, 0x014080ff ∷ u32]
    let list<f32> s_u32_f32 ← [0.5, 2.0, 0.25, -0.5]
    let list<f32> b_u32_f32 ← [-1.0, 0.25, 0.0, 1.0]
    let list<f32> x_u32 ← [1.0, -2.0, 0.5, 4.0, -1.0, 2.0, -0.5, 3.0, 0.5, 1.0, -1.0, 2.0, 0.25, -0.5, 1.5, -1.0]

    let list<u8> w_u8 ← [0x21 ∷ u8, 0x43 ∷ u8, 0xf0 ∷ u8, 0x7a ∷ u8]
    let list<bf16> s_u8_bf16 ← [(0.5 ∷ f32) ↦ bf16, (-0.25 ∷ f32) ↦ bf16]
    let list<bf16> b_u8_bf16 ← [(-1.5 ∷ f32) ↦ bf16, (2.0 ∷ f32) ↦ bf16]
    let list<f32> s_u8_f32 ← [0.5, -0.25]
    let list<f32> b_u8_f32 ← [-1.5, 2.0]
    let list<f32> x_u8 ← [1.0, -2.0, 0.5, 4.0, -1.0, 0.5, 2.0, -3.0]

    do {
        let ga.GroupAffineSpec spec_u32 ← ga.admit_spec_with_scale(2, 8, 8, 4, variant ga.PackKind.PackU32, variant ga.ScaleDtype.ScaleBf16)
        match spec_u32.scale_dtype {
            case ScaleBf16 {
                pass
            }
            default {
                assert false
            }
        }
        let list<f32> w_bf16 ← ga.ref_dequantize_u32_bf16(spec_u32, w_u32, s_u32_bf16, b_u32_bf16)
        let list<f32> w_f32 ← ga.ref_dequantize_u32(spec_u32, w_u32, s_u32_f32, b_u32_f32)
        for exclusive w_bf16.length() let i {
            assert close(w_bf16[i], w_f32[i])
        }
        let list<f32> y_bf16 ← ga.ref_matmul(2, 2, 8, w_bf16, x_u32)
        let list<f32> y_f32 ← ga.ref_matmul(2, 2, 8, w_f32, x_u32)
        for exclusive y_bf16.length() let i {
            assert close(y_bf16[i], y_f32[i])
        }

        let ga.GroupAffineSpec spec_u8 ← ga.admit_spec_with_scale(2, 4, 4, 4, variant ga.PackKind.PackU8, variant ga.ScaleDtype.ScaleBf16)
        let list<f32> wu8_bf16 ← ga.ref_dequantize_u8_bf16(spec_u8, w_u8, s_u8_bf16, b_u8_bf16)
        let list<f32> wu8_f32 ← ga.ref_dequantize_u8(spec_u8, w_u8, s_u8_f32, b_u8_f32)
        for exclusive wu8_bf16.length() let i {
            assert close(wu8_bf16[i], wu8_f32[i])
        }
        let list<f32> yu8_bf16 ← ga.ref_matmul(2, 2, 4, wu8_bf16, x_u8)
        let list<f32> yu8_f32 ← ga.ref_matmul(2, 2, 4, wu8_f32, x_u8)
        for exclusive yu8_bf16.length() let i {
            assert close(yu8_bf16[i], yu8_f32[i])
        }
    }
    catch err {
        assert false
    }
}
