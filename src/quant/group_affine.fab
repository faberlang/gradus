@ public
kernel linear_matmul_u8<size B, size Out, size PackedIn, size Groups, size In>(tensor<u8, [Out, PackedIn]> weight, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [B, In]> x, mut tensor<f32, [B, Out]> y, i32 bits, i32 group_size) → void {
