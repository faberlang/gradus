# Attention package map.
#
# Public import: import from "gradus:attention" attention
# Prefer leaves:
#   gradus:attention/rope    RopeConfig, RopePolicy, AttentionError
#   gradus:attention/gqa     SDPA, causal, rotary, multi-head, cached attention
#
# This file holds no genera. Import the leaf that owns the type.

import from "gradus:attention/rope" rope
import from "gradus:attention/gqa" gqa

# -------------------------------------------------------------------------
# scaled_dot_product_static — static-shape generic scaled dot-product
#   attention on compiler tensors (shape-generics Phase 2).
#   scores = qb·kbᵀ·scale, attn = softmax(scores), context = attn·vb.
#   qb/kb/vb are the [B,D] projections; scale is the [B,B] dk_scale factor.
#   Typed-tensor ops only, so symbolic shapes stay in the type. This is the
#   sole typed attention surface; the staged-carrier SDPA lives in
#   gradus:attention/gqa. Callers: examples/training/bert-tiny-fragment and
#   bert-gradus-probe.
# -------------------------------------------------------------------------

@ kernel
@ public
fn scaled_dot_product_static<size B, size D>(tensor<f32, [B, D]> qb, tensor<f32, [B, D]> kb, tensor<f32, [B, D]> vb, tensor<f32, [B, B]> scale) → tensor<f32, [B, D]> {
    const _ kt ← kb.transpose()
    const _ scores ← qb · kt
    const _ scaled ← scores ⊙ scale
    const _ attn ← scaled.softmax()
    const _ context ← attn · vb
    return context
}
