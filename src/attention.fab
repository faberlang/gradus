+++
locale = "en"
+++
# Attention mechanism facade.
#
# Public import: import from "gradus:attention" attention
# Depends on: gradus:tensor, gradus:math, gradus:dtype
#
# S6-G1 (gpu-training-lowering stage-6-delivery.md): first concrete
# static-shape attention primitive — scaled dot-product attention for the
# BERT-tiny fragment shapes (B=2, D=8, H=1), bounded to the S6-G1 caller.
# Shape generics are not available yet; follow the norma:optimizer
# concrete-overload precedent.
#
# Will split into nested leaves when ≥2 attention variants are implemented:
#   gradus:attention/scaled_dot_product  scaled dot-product attention
#   gradus:attention/causal              causal masking
#   gradus:attention/multi_head          multi-head composition
# unit-2D (hand-53) kept the static-shape generic in this file as
# scaled_dot_product_static — a one-leaf split cannot be named
# gradus:attention/scaled_dot_product while this file owns
# gradus:attention, and a full split would move the PML3-U2 runtime
# carrier (out of scope). SEM005 forbids the spec name here.
#
# Architectural rule: attention is a building block, not a transformer
# component. This module must not import from gradus:transformer.
# No module owns a backend or device handle.
#
# TOOLCHAIN NOTE: the legacy fixed-shape function below is self-contained
# (typed-tensor ops only). The PML3-U2 production surface (bottom of this
# module) instead composes the gradus:math / gradus:tensor families over the
# staged carrier — the same posture as the nn.fab production surface (see
# nn.fab "Compiler-boundary notes"). The transformer block inlines the same
# math for the same stepper reason (the S4-A train_step_4x4 precedent).
#
# PML0-U3 ledger disposition (pml0-proof-api-ledger.md, gradus 33df687) —
# executed at PML1-U6: scaled_dot_product_2x8 is ADMITTED as caller-backed
# public API (grep-verified live callers in package code):
#   row 12 — bert-tiny-fragment train.fab:366 (+oracle capture.fab:398);
#            bert-gradus-probe train.fab:364

import from "gradus:cache" kv

import from "gradus:dtype" dtype

import from "gradus:math" math

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# scaled_dot_product_2x8 — single-head attention for B=2, D=8, H=1
#   scores = qb @ kbᵀ · scale,  attn = softmax(scores),  context = attn @ vb
#   qb/kb/vb are the biased Q/K/V projections [2,8]; scale is the [2,2]
#   dk_scale factor (1/sqrt(8) fill, matching the fragment shape).
# -------------------------------------------------------------------------

fn scaled_dot_product_2x8(tensor<f32, [2, 8]> qb, tensor<f32, [2, 8]> kb, tensor<f32, [2, 8]> vb, tensor<f32, [2, 2]> scale) → tensor<f32, [2, 8]> {
    const _ kt ← kb.transpose()
    const _ scores ← qb · kt
    const _ scaled ← scores ⊙ scale
    const _ attn ← scaled.softmax()
    const _ context ← attn · vb
    return context
}

# -------------------------------------------------------------------------
# scaled_dot_product_static — static-shape generic variant of the
#   scaled_dot_product family (shape-generics Phase 2, 2026-08-13).
#   scores = qb·kbᵀ·scale, attn = softmax(scores), context = attn·vb.
#   qb/kb/vb are the [B,D] projections; scale is the [B,B] dk_scale factor.
#   Depth-2 static body — symbolic shapes stay in the type (no runtime shape
#   reads). *_static because the module already carries the admitted
#   runtime-carrier scaled_dot_product (no same-name overload, SEM005); the
#   nested-leaf split note above stays the long-term home.
# -------------------------------------------------------------------------

fn scaled_dot_product_static<size B, size D>(tensor<f32, [B, D]> qb, tensor<f32, [B, D]> kb, tensor<f32, [B, D]> vb, tensor<f32, [B, B]> scale) → tensor<f32, [B, D]> {
    const _ kt ← kb.transpose()
    const _ scores ← qb · kt
    const _ scaled ← scores ⊙ scale
    const _ attn ← scaled.softmax()
    const _ context ← attn · vb
    return context
}

# =========================================================================
# PML3-U2 — production surface (shape-generic, forward-only, typed errors)
# =========================================================================
#
# --- Contract (pml3-delivery.md PML3-U2) ---------------------------------
# Scaled dot-product attention with causal masking and RoPE integration for
# the admitted rows is forward-only, composable, oracle-checked (CPU
# reference vs the GI2/GI3 pinned contracts); attention semantics shared by
# training and inference. The F32 row is the admitted row (any other staged
# tag fails closed).
#
# --- Formulas (matching the accepted proofs and the GI3 frozen recipes) ---
#   scaled_dot_product(q,k,v,scale)   = softmax((q·kᵀ)·scale)·v — the
#       accepted scaled_dot_product_2x8 arithmetic (capture.fab: scores =
#       qb@kt, scaled = scores·dk_scale, softmax, attn@v); q/k/v are the
#       single-head [T,D] projections.
#   scaled_dot_product_causal(...)    = same with the GI3 CausalMaskedSoftmax
#       recipe semantics: row i attends to columns j ≤ i (j > i masked,
#       diagonal included) — masked stable row softmax, no mask-tensor input
#       (causal structure is the recipe's semantics, gi3-contract.md §1.1).
#   rotary_position_embedding(x,pos,dim) = the GI3 Rope recipe on the LAST
#       axis: llama-arch NORM consecutive-pair rotation (2k, 2k+1) with
#       theta = pos · freq_base^(-2k/dim), freq_base frozen at 100000
#       (gi3-contract.md §1 frozen recipe; radix-mir-stepper tensor_rope).
#       Elements beyond dim are untouched.
#   scaled_dot_product_causal_rope(...) = the RoPE-integrated composite for
#       the admitted rows: q and k are rotated at their positions first,
#       then causal attention runs — THE function shared by training and
#       inference (U3 consumes it; PML4 training / PML5 inference both call
#       this forward, no gradient path).
#
# --- Autograd independence (PML3 thesis, forward-without-autograd) --------
# This module imports NO autograd surface (no gradus:gradient, no @ radix
# backward, no companion ABI). Attention is a pure value function over the
# staged carrier; the co-located proba exercises the whole surface with no
# autograd import at all.
#
# --- Compiler-boundary notes ---------------------------------------------
#   * Shape generics are not available in library context (SEM014 — the
#     nn.fab posture); the staged carrier carries runtime shapes, so the
#     attention surface is shape-generic at runtime and R3-compliant (no
#     one-row/one-shape narrowing in the public API).
#   * The CPU reference evaluates rope/softmax in f64 (FMIR stepper); this
#     surface is f32 self-hosted (exp via power; sin/cos via range
#     reduction + Taylor series — the mathesis.fab precedent). Row tests
#     compare with a documented tolerance, not bit equality.
#   * The legacy scaled_dot_product_2x8 stays caller-backed admitted API
#     (PML0-U3 ledger row 12); the production surface re-admits none of the
#     retired transformer helpers.

# -------------------------------------------------------------------------
# AttentionError — typed error vocabulary of the attention surface. Every
# variant carries a text message (render via message), mirroring the tensor/
# shape/dtype/math/nn error contract.
# -------------------------------------------------------------------------



@ public { }
union AttentionError {
    @ shared
    string message

    NegativeDimension,
    DimensionAboveLimit,
    ProductAboveLimit,
    GradusMismatch,
    ShapeMismatch,
    Incompatible,
    DtypeMismatch,
    ElementMismatch,
    InvalidPosition,
    InvalidDimension,
    InvalidConfig
}



# -------------------------------------------------------------------------
# RopePolicy — the RoPE pair-policy discriminator (REF-01 U1.3).
#   Consecutive — llama-arch NORM consecutive-pair (2k, 2k+1), the GI3
#     frozen llama recipe.
#   Interleaved — qwen2 interleaved-pair (k, k+n/2) — the llama.cpp NEOX
#     half-split layout (pairs offset by n_dims/2).
# -------------------------------------------------------------------------



@ public { }
union RopePolicy {
    Consecutive,
    Interleaved
}

# Canonical policy factories (cross-module `variant` of an imported enum's
# variants is not supported in library context today — the dtype.f32
# precedent).
@ public { }
fn consecutive_policy() → RopePolicy {
    return variant Consecutive
}

@ public { }
fn interleaved_policy() → RopePolicy {
    return variant Interleaved
}

# Canonical policy name (surface for probes and diagnostics).
@ public { }
fn policy_name(RopePolicy p) → string {
    match p {
        case Consecutive {
            return "consecutive-pair"
        }
        case Interleaved {
            return "interleaved-pair"
        }
    }
}

# -------------------------------------------------------------------------
# RopeConfig — the configurable RoPE knobs (REF-01 U1.3): frequency base
# (theta), scale, and pair policy. The validated constructor is
# construct_rope_config; the genus itself is the plain carrier (the
# sampling.Config precedent).
# -------------------------------------------------------------------------



@ public { }
class RopeConfig {
    f32 base
    f32 scale
    RopePolicy policy

    # Frequency base (theta) of the rotation.
    fn base() → f32 {
        return self.base
    }

    # Position/frequency scale multiplier (1.0 = no scaling).
    fn scale() → f32 {
        return self.scale
    }

    # Pair policy — consecutive-pair (llama NORM) or interleaved-pair (qwen2).
    fn policy() → RopePolicy {
        return self.policy
    }
}

# The validated RopeConfig constructor. The frequency base and the scale
# must be positive and finite; the policy is one of the two admitted
# variants (Consecutive / Interleaved).
@ public { }
fn construct_rope_config(f32 base, f32 scale, RopePolicy policy) → RopeConfig ⇥ AttentionError {
    require not (not dtype.finite(base) or not (base ≻ 0.0)) throw variant InvalidConfig {message = "rope frequency base must be positive"}
    require not (not dtype.finite(scale) or not (scale ≻ 0.0)) throw variant InvalidConfig {message = "rope scale must be positive"}
    return RopeConfig {base = base, scale = scale, policy = policy}
}

# Provider-safe constructor for the canonical llama consecutive-pair route.
# The FMIR proba runner can pass a RopeConfig carrier across the package
# boundary, but it cannot execute the zero-argument enum factory when that
# factory is nested as an imported argument. Keep the policy construction in
# this module so the public route remains canonical without changing the
# RopePolicy API.
@ public { }
fn construct_consecutive_rope_config(f32 base, f32 scale) → RopeConfig ⇥ AttentionError {
    return construct_rope_config(base, scale, variant Consecutive)
}

# Placeholder Default for `var RopeConfig` bindings (varia on structs).
# Zero base/scale (not a valid config). Only a placeholder the caller
# overwrites, or returns from an unreachable cape arm.
@ public { }
fn default() → RopeConfig {
    return RopeConfig {base = 0.0, scale = 0.0, policy = consecutive_policy()}
}

# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# RoPE frequency base — frozen at 100000 (the GI3 Rope recipe v1 constant;
# the radix-mir-stepper tensor_rope FREQ_BASE).
const f32 ROPE_FREQ_BASE ← 100000.0 ∷ f32

# 2π and π for angle reduction (the mathesis.fab precedent).
const f32 TAU ← 6.283185307179586 ∷ f32

const f32 SEMITAU ← 3.141592653589793 ∷ f32

# F32-only gate — the admitted row is the F32 row; a differently tagged
# staged carrier fails closed (mirror of nn.fab _dtype_f32).
@ private { }
fn _dtype_f32(tensor.Tensor t) → bool ⇥ AttentionError {
    require dtype.eq(t.dtype(), dtype.f32()) throw variant DtypeMismatch {message = "unsupported dtype for attention primitive"}
    return true
}

# Pairwise dtype parity + F32 gate.
@ private { }
fn _dtype_pair(tensor.Tensor a, tensor.Tensor b) → bool ⇥ AttentionError {
    require dtype.eq(a.dtype(), b.dtype()) throw variant DtypeMismatch {message = "dtype mismatch"}
    require dtype.eq(a.dtype(), dtype.f32()) throw variant DtypeMismatch {message = "unsupported dtype for attention primitive"}
    return true
}

# Three-way dtype parity + F32 gate for the q/k/v triple.
@ private { }
fn _dtype_triple(tensor.Tensor a, tensor.Tensor b, tensor.Tensor c) → bool ⇥ AttentionError {
    _dtype_pair(a, b)
    return _dtype_pair(a, c)
}

# e^x via the exponentiation intrinsic (base e > 0, so the non-positive
# base guard never fires; power lowers to exp(x·ln(e)) ≈ exp(x)) — the
# nn.fab _exp precedent.
@ private { }
fn _exp(f32 x) → f32 {
    return (2.718281828459045 ∷ f32).power(x)
}

# Angle reduction to the principal range [-π, π] for stable Taylor
# evaluation (the mathesis.fab _reduce_angle precedent).
@ private { }
fn _reduce_angle(f32 x) → f32 {
    const f32 shifted ← x + SEMITAU
    const int k ← (shifted / TAU).floor()
    return x - TAU * (k ↦ f32)
}

# sin via Taylor series on the reduced angle (fixed 12-iteration count —
# accurate to f32 precision over the reduced range, mathesis.fab precedent).
@ private { }
fn _sin(f32 x) → f32 {
    const f32 a ← _reduce_angle(x)
    var f32 term ← a
    var f32 sum ← a
    const f32 x2 ← a * a
    var int n ← 1
    while n ≺ 12 {
        term ← (term * (0.0 - x2)) / ((2 * n ↦ f32) * ((2 * n + 1) ↦ f32))
        sum ← sum + term
        n ← n + 1
    }
    return sum
}

# cos via Taylor series on the reduced angle.
@ private { }
fn _cos(f32 x) → f32 {
    const f32 a ← _reduce_angle(x)
    var f32 term ← 1.0
    var f32 sum ← 1.0
    const f32 x2 ← a * a
    var int n ← 1
    while n ≺ 12 {
        term ← (term * (0.0 - x2)) / (((2 * n - 1) ↦ f32) * (2 * n ↦ f32))
        sum ← sum + term
        n ← n + 1
    }
    return sum
}

# Rank-2 transpose [rows, cols] → [cols, rows] (math has no transpose; the
# score product needs kᵀ). Infallible — callers validate shape first.
@ private { }
fn _transpose(tensor.Tensor t) → tensor.Tensor {
    const list<int> f ← t.shape()
    const int rows ← f.get(0) coalesce 1
    const int cols ← f.get(1) coalesce 1
    const list<int> trans ← [cols, rows]
    var list<f32> out ← empty
    var int j ← 0
    while j ≺ cols {
        for from t.data at [i] const value {
            if i % cols ≡ j {
                out.append(value)
            }
        }
        j ← j + 1
    }
    return tensor.Tensor {dtype = t.dtype(), shape = trans, data = out}
}

# Filled-tensor construction through the attention error vocabulary
# (tensor.fill → AttentionError, message text preserved).
@ private { }
fn _fill(list<int> f, f32 payload) → tensor.Tensor ⇥ AttentionError {
    do {
        return tensor.fill(f, payload)
    }
    catch err {
        match err {
            case tensor.TensorError.InvalidShape const message {
                throw variant ShapeMismatch { message = message }
            }
            case tensor.TensorError.ElementMismatch const message {
                throw variant ElementMismatch { message = message }
            }
            case tensor.TensorError.IndexOutOfBounds const message {
                throw variant ShapeMismatch { message = message }
            }
        }
    }
}

# Row softmax over the LAST axis of a rank-2 tensor, numerically stable via
# max subtraction (the stepper tensor_softmax identity). With causalis =
# verum it is the GI3 masked stable row softmax: row i keeps columns
# j ≤ i (diagonal included) and outputs zeros past the prefix.
@ private { }
fn _softmax(tensor.Tensor x, bool causalis) → tensor.Tensor {
    const list<int> f ← x.shape()
    const int rows ← f.get(0) coalesce 1
    const int cols ← f.get(1) coalesce 1
    var list<f32> out ← empty
    for range 0‥rows const i {
        var int end ← cols
        if causalis {
            end ← i + 1
        }
        # Row max over the valid prefix.
        var f32 maximum ← x.data.get(i * cols) coalesce 0.0 ∷ f32
        var int j ← 0
        while j ≺ end {
            const f32 v ← x.data.get(i * cols + j) coalesce 0.0 ∷ f32
            if v ≻ maximum {
                maximum ← v
            }
            j ← j + 1
        }
        # exp(x − max) over the valid prefix and the normalizer sum. At least
        # one element equals max, so the sum is ≥ 1 — no division by zero.
        var list<f32> exps ← empty
        var f32 total ← 0.0 ∷ f32
        var int j2 ← 0
        while j2 ≺ end {
            const f32 v ← x.data.get(i * cols + j2) coalesce 0.0 ∷ f32
            const f32 e ← _exp(v - maximum)
            exps.append(e)
            total ← total + e
            j2 ← j2 + 1
        }
        for from exps const e {
            out.append(e / total)
        }
        var int j3 ← end
        while j3 ≺ cols {
            out.append(0.0 ∷ f32)
            j3 ← j3 + 1
        }
    }
    return tensor.Tensor {dtype = x.dtype(), shape = f, data = out}
}

# RoPE table with logical shape [positions, dim/2, 3]. Each reduced pair
# stores [angle, cos(angle), sin(angle)] in that order. The table is built
# once at the forward boundary and shared by every q/k/head application.
@ private { }
fn _rope_table(list<int> positions, int dim, f32 freq_base, f32 scale) → list<f32> {
    const f32 dim_f ↤ dim
    const int half ← dim / 2
    var list<f32> table ← empty
    for from positions const pos {
        const f32 pos_f ↤ pos
        var int pair ← 0
        while pair ≺ half {
            const f32 pair_f ↤ pair
            const f32 angle ← (pos_f * scale) * freq_base.power((0.0 - 2.0 * pair_f) / dim_f)
            table.append(angle)
            table.append(_cos(angle))
            table.append(_sin(angle))
            pair ← pair + 1
        }
    }
    return table
}

# RoPE rotation over the LAST axis of a rank-2 tensor (REF-01-U1.3
# configurable row). With interposita = falsum it is the llama-arch NORM
# consecutive-pair rotation (2k, 2k+1) for k < dim/2 with
# theta = pos · scale · base^(-2k/dim); with interposita = verum it is the
# qwen2 interleaved-pair rotation (k, k+dim/2) with the same theta (the
# llama.cpp NEOX half-split layout, pairs offset by n_dims/2). Elements
# beyond dim are untouched. Infallible — callers validate
# shape/positions/dim first.
@ private { }
fn _rope(tensor.Tensor x, int dim, list<f32> table, bool interposita) → tensor.Tensor {
    const list<int> f ← x.shape()
    const int t ← f.get(0) coalesce 1
    const int d ← f.get(1) coalesce 1
    const int half ← dim / 2
    var list<f32> out ← empty
    var int row ← 0
    while row ≺ t {
        const int base ← row * d
        var int col ← 0
        while col ≺ d {
            if col ≺ dim {
                if interposita {
                    # qwen2 interleaved-pair: output column col belongs to
                    # pair k (0..half-1) and is its first (col < half) or
                    # second (col >= half) element.
                    const int k ← col % half
                    const int table_base ← (row * half + k) * 3
                    const f32 c ← table.get(table_base + 1) coalesce 0.0 ∷ f32
                    const f32 s ← table.get(table_base + 2) coalesce 0.0 ∷ f32
                    if col ≺ half {
                        const f32 x0 ← x.data.get(base + k) coalesce 0.0 ∷ f32
                        const f32 x1 ← x.data.get((base + k) + half) coalesce 0.0 ∷ f32
                        out.append(x0 * c - x1 * s)
                    }
                    else {
                        const f32 x0 ← x.data.get(base + k) coalesce 0.0 ∷ f32
                        const f32 x1 ← x.data.get((base + k) + half) coalesce 0.0 ∷ f32
                        out.append(x0 * s + x1 * c)
                    }
                    col ← col + 1
                }
                else {
                    # llama-arch NORM consecutive-pair (2k, 2k+1).
                    const int k ← col / 2
                    const int table_base ← (row * half + k) * 3
                    const f32 c ← table.get(table_base + 1) coalesce 0.0 ∷ f32
                    const f32 s ← table.get(table_base + 2) coalesce 0.0 ∷ f32
                    const f32 x0 ← x.data.get(base + col) coalesce 0.0 ∷ f32
                    const f32 x1 ← x.data.get((base + col) + 1) coalesce 0.0 ∷ f32
                    out.append(x0 * c - x1 * s)
                    out.append(x0 * s + x1 * c)
                    col ← col + 2
                }
            }
            else {
                out.append(x.data.get(base + col) coalesce 0.0 ∷ f32)
                col ← col + 1
            }
        }
        row ← row + 1
    }
    return tensor.Tensor {dtype = x.dtype(), shape = f, data = out}
}

# Interleaved-pair flag from the typed policy (falsum = consecutive-pair
# llama NORM, verum = interleaved-pair qwen2). Infallible.
@ private { }
fn _interleaved(RopePolicy policy) → bool {
    match policy {
        case Consecutive {
            return false
        }
        case Interleaved {
            return true
        }
    }
}

# Shared q/k/v validation: dtype parity + F32 gate, rank-2, shared [T,D]
# shape, non-empty. Returns the shared shape.
@ private { }
fn _validate_triplet(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v) → list<int> ⇥ AttentionError {
    _dtype_triple(q, k, v)
    const list<int> fq ← q.shape()
    const list<int> fk ← k.shape()
    const list<int> fv ← v.shape()
    require fq.length() ≡ 2 throw variant GradusMismatch {message = "attention requires rank-2 tensors"}
    require not (fk.length() ≠ 2 or fv.length() ≠ 2) throw variant GradusMismatch {message = "attention requires rank-2 tensors"}
    const int t ← fq.get(0) coalesce 1
    const int d ← fq.get(1) coalesce 1
    require not (fk.get(0) coalesce 1 ≠ t or fk.get(1) coalesce 1 ≠ d) throw variant ShapeMismatch {message = "query, key, value must share shape"}
    require not (fv.get(0) coalesce 1 ≠ t or fv.get(1) coalesce 1 ≠ d) throw variant ShapeMismatch {message = "query, key, value must share shape"}
    require not (t ≡ 0 or d ≡ 0) throw variant ElementMismatch {message = "empty attention input"}
    return fq
}

# Shared rope/positions/dim validation for a rank-2 staged tensor: dtype
# gate, rank-2, non-empty, positions length == row count, positions
# non-negative, dim even and within [2, last-extent]. Returns the shape.
@ private { }
fn _validate_rope(tensor.Tensor x, list<int> positions, int dim) → list<int> ⇥ AttentionError {
    _dtype_f32(x)
    const list<int> f ← x.shape()
    require f.length() ≡ 2 throw variant GradusMismatch {message = "rope requires rank-2 tensor"}
    const int t ← f.get(0) coalesce 1
    const int d ← f.get(1) coalesce 1
    require not (t ≡ 0 or d ≡ 0) throw variant ElementMismatch {message = "empty rope input"}
    require positions.length() ≡ t throw variant ShapeMismatch {message = "positions must match the token count"}
    require dim ≥ 2 throw variant InvalidDimension {message = "rope dim must be at least 2"}
    require dim % 2 ≡ 0 throw variant InvalidDimension {message = "rope dim must be even"}
    require dim ≤ d throw variant InvalidDimension {message = "rope dim exceeds head width"}
    for from positions const p {
        require p ≥ 0 throw variant InvalidPosition {message = "negative position"}
    }
    return f
}

# The attention computation core: scores = (q·kᵀ)·scale, row softmax (with
# or without the causal prefix), context = attn·v. Math failures are mapped
# into AttentionError preserving the message text (the nn.fab linear pattern).
@ private { }
fn _attention_core(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, f32 scale, bool causalis) → tensor.Tensor ⇥ AttentionError {
    const list<int> fq ← q.shape()
    const int t ← fq.get(0) coalesce 1
    const tensor.Tensor kt ← _transpose(k)
    const tensor.Tensor scale_t ← _fill([t, t], scale)
    do {
        const tensor.Tensor scores ← math.matmul(q, kt)
        const tensor.Tensor scaled ← math.mul(scores, scale_t)
        const tensor.Tensor attn ← _softmax(scaled, causalis)
        const tensor.Tensor context ← math.matmul(attn, v)
        return context
    }
    catch err {
        match err {
            case math.MathError.GradusMismatch const message {
                throw variant GradusMismatch { message = message }
            }
            case math.MathError.Incompatible const message {
                throw variant Incompatible { message = message }
            }
            case math.MathError.DtypeMismatch const message {
                throw variant DtypeMismatch { message = message }
            }
            case math.MathError.ProductAboveLimit const message {
                throw variant ProductAboveLimit { message = message }
            }
            case math.MathError.DimensionAboveLimit const message {
                throw variant DimensionAboveLimit { message = message }
            }
            case math.MathError.NegativeDimension const message {
                throw variant NegativeDimension { message = message }
            }
            case math.MathError.ShapeMismatch const message {
                throw variant ShapeMismatch { message = message }
            }
            case _ {
                throw variant ShapeMismatch { message = err.message }
            }
        }
    }
}

# Column slice of a rank-2 staged tensor: columns [start, start + width)
# → [rows, width] (the per-head q/k/v split of the multi-head row).
# Infallible — callers validate shape first (the _transpone posture).
@ private { }
fn _head(tensor.Tensor t, int start, int width) → tensor.Tensor {
    const list<int> f ← t.shape()
    const int rows ← f.get(0) coalesce 1
    const int full ← f.get(1) coalesce 1
    var list<f32> out ← empty
    for range 0‥rows const i {
        var int j ← 0
        while j ≺ width {
            out.append(t.data.get((i * full + start) + j) coalesce 0.0 ∷ f32)
            j ← j + 1
        }
    }
    return tensor.Tensor {dtype = t.dtype(), shape = [rows, width], data = out}
}

# Head concatenation along the last axis via the public math row, with the
# attention error vocabulary (the concat failures never fire on the row's
# validated [T, head_dim] parts; mapped for completeness).
@ private { }
fn _reconcile(list<tensor.Tensor> parts) → tensor.Tensor ⇥ AttentionError {
    do {
        return math.concatenate(parts, 1)
    }
    catch err {
        match err {
            case math.MathError.ElementMismatch const message {
                throw variant ElementMismatch { message = message }
            }
            case math.MathError.GradusMismatch const message {
                throw variant GradusMismatch { message = message }
            }
            case math.MathError.ShapeMismatch const message {
                throw variant ShapeMismatch { message = message }
            }
            case math.MathError.DtypeMismatch const message {
                throw variant DtypeMismatch { message = message }
            }
            case _ {
                throw variant ShapeMismatch { message = err.message }
            }
        }
    }
}

# matmul through the attention error vocabulary (the _attention_core mapping
# pattern, shared by the output projection).
@ private { }
fn _attention_matmul(tensor.Tensor a, tensor.Tensor b) → tensor.Tensor ⇥ AttentionError {
    do {
        return math.matmul(a, b)
    }
    catch err {
        match err {
            case math.MathError.GradusMismatch const message {
                throw variant GradusMismatch { message = message }
            }
            case math.MathError.Incompatible const message {
                throw variant Incompatible { message = message }
            }
            case math.MathError.DtypeMismatch const message {
                throw variant DtypeMismatch { message = message }
            }
            case math.MathError.ProductAboveLimit const message {
                throw variant ProductAboveLimit { message = message }
            }
            case math.MathError.DimensionAboveLimit const message {
                throw variant DimensionAboveLimit { message = message }
            }
            case math.MathError.NegativeDimension const message {
                throw variant NegativeDimension { message = message }
            }
            case math.MathError.ShapeMismatch const message {
                throw variant ShapeMismatch { message = message }
            }
            case _ {
                throw variant ShapeMismatch { message = err.message }
            }
        }
    }
}

# Shared multi-head validation (REF-01-U1.4): dtype parity + F32 gate for
# q/k/v/wo, rank-2, the head-count invariants (0 < num_kv_heads ≤
# num_heads, num_heads % num_kv_heads == 0), the packed widths (q [T, H·D],
# k/v [T, K·D], wo [H·D, H·D]), positions length == T, non-negative
# positions, and the rope dim within the head width. Returns the head dim.
@ private { }
fn _validate_multi(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, tensor.Tensor wo, int num_heads, int num_kv_heads, list<int> positions, int rope_dim) → int ⇥ AttentionError {
    _dtype_triple(q, k, v)
    _dtype_pair(q, wo)
    const list<int> fq ← q.shape()
    const list<int> fk ← k.shape()
    const list<int> fv ← v.shape()
    const list<int> fw ← wo.shape()
    require not (((fq.length() ≠ 2 or fk.length() ≠ 2) or fv.length() ≠ 2) or fw.length() ≠ 2) throw variant GradusMismatch {message = "multi-head attention requires rank-2 tensors"}
    require num_heads ≥ 1 throw variant InvalidConfig {message = "num_heads must be positive"}
    require num_kv_heads ≥ 1 throw variant InvalidConfig {message = "num_kv_heads must be positive"}
    require num_kv_heads ≤ num_heads throw variant InvalidConfig {message = "num_kv_heads must not exceed num_heads"}
    require num_heads % num_kv_heads ≡ 0 throw variant InvalidConfig {message = "num_heads must be a multiple of num_kv_heads"}
    const int t ← fq.get(0) coalesce 1
    const int qw ← fq.get(1) coalesce 1
    require not (fk.get(0) coalesce 1 ≠ t or fv.get(0) coalesce 1 ≠ t) throw variant ShapeMismatch {message = "query, key, value must share the token count"}
    require t ≠ 0 throw variant ElementMismatch {message = "empty attention input"}
    require qw % num_heads ≡ 0 throw variant InvalidConfig {message = "query width must be a multiple of num_heads"}
    const int d ← qw / num_heads
    require d ≠ 0 throw variant InvalidConfig {message = "head dim must be positive"}
    require fk.get(1) coalesce 1 ≡ num_kv_heads * d throw variant ShapeMismatch {message = "key width must equal num_kv_heads * head dim"}
    require fv.get(1) coalesce 1 ≡ num_kv_heads * d throw variant ShapeMismatch {message = "value width must equal num_kv_heads * head dim"}
    require not (fw.get(0) coalesce 1 ≠ qw or fw.get(1) coalesce 1 ≠ qw) throw variant ShapeMismatch {message = "output projection must be [H*D, H*D]"}
    require positions.length() ≡ t throw variant ShapeMismatch {message = "positions must match the token count"}
    for from positions const p {
        require p ≥ 0 throw variant InvalidPosition {message = "negative position"}
    }
    require rope_dim ≥ 2 throw variant InvalidDimension {message = "rope dim must be at least 2"}
    require rope_dim % 2 ≡ 0 throw variant InvalidDimension {message = "rope dim must be even"}
    require rope_dim ≤ d throw variant InvalidDimension {message = "rope dim exceeds head width"}
    return d
}

# -------------------------------------------------------------------------
# Family: rotary_position_embedding — the RoPE recipe over the staged
# carrier. x [T,D]; positions is one non-negative integer per row; dim is
# the (even) rotation width over the last axis.
#
# rotary_position_embedding is the fixed llama-arch NORM convenience row
# (consecutive-pair, freq_base 100000, scale 1.0 — the GI3 frozen llama
# recipe). rotary_position_embedding_config generalizes it: frequency
# base (theta), scale, and pair policy (consecutive-pair llama NORM vs
# interleaved-pair qwen2, REF-01-U1.3).
# -------------------------------------------------------------------------

@ public { }
fn rotary_position_embedding(tensor.Tensor x, list<int> positions, int dim) → tensor.Tensor ⇥ AttentionError {
    _validate_rope(x, positions, dim)
    const list<f32> table ← _rope_table(positions, dim, ROPE_FREQ_BASE, 1.0 ∷ f32)
    return _rope(x, dim, table, false)
}

@ public { }
fn rotary_position_embedding_config(tensor.Tensor x, list<int> positions, int dim, RopeConfig config) → tensor.Tensor ⇥ AttentionError {
    _validate_rope(x, positions, dim)
    const list<f32> table ← _rope_table(positions, dim, config.base(), config.scale())
    return _rope(x, dim, table, _interleaved(config.policy()))
}

# -------------------------------------------------------------------------
# Family: scaled_dot_product — single-head scaled dot-product attention.
#   scores = (q·kᵀ)·scale, row softmax over the last axis, context = attn·v.
# q/k/v are the [T,D] projections; scale is the dk scaling factor (the
# caller passes 1/sqrt(dk), matching the accepted dk_scale contract).
# -------------------------------------------------------------------------

@ public { }
fn scaled_dot_product(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, f32 scale) → tensor.Tensor ⇥ AttentionError {
    _validate_triplet(q, k, v)
    return _attention_core(q, k, v, scale, false)
}

# -------------------------------------------------------------------------
# Family: scaled_dot_product_causal — the same attention with the GI3
# CausalMaskedSoftmax recipe semantics: row i attends to columns j ≤ i
# (diagonal included; future positions masked out before softmax). This is
# the causal scoring used identically by training and inference.
# -------------------------------------------------------------------------

@ public { }
fn scaled_dot_product_causal(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, f32 scale) → tensor.Tensor ⇥ AttentionError {
    _validate_triplet(q, k, v)
    return _attention_core(q, k, v, scale, true)
}

# -------------------------------------------------------------------------
# Family: scaled_dot_product_causal_rope — the RoPE-integrated composite for
# the admitted rows. q and k are rotated at their positions first
# (rotary_position_embedding), then causal attention runs. Training and
# inference share this exact forward composition.
# -------------------------------------------------------------------------

@ public { }
fn scaled_dot_product_causal_rope(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, f32 scale, list<int> positions, int dim) → tensor.Tensor ⇥ AttentionError {
    _validate_triplet(q, k, v)
    _validate_rope(q, positions, dim)
    const list<f32> table ← _rope_table(positions, dim, ROPE_FREQ_BASE, 1.0 ∷ f32)
    const tensor.Tensor qr ← _rope(q, dim, table, false)
    const tensor.Tensor kr ← _rope(k, dim, table, false)
    return _attention_core(qr, kr, v, scale, true)
}

# -------------------------------------------------------------------------
# Family: multi_head_attention — multi-head attention with GQA KV-head
# sharing (REF-01-U1.4). q [T, H·D] and k/v [T, K·D] are the packed
# projections with K ≤ H and H % K == 0; each query head h attends through
# its KV group g = h // (H/K). The composition per head: the per-head
# splits, scaled scores, the GI3 CausalMaskedSoftmax recipe (row i attends
# columns j ≤ i, diagonal included), v accumulation, then head
# concatenation and the [H·D, H·D] output projection (wo in the [K, N]
# row-major adapter contract: out = concat · wo, the same posture as
# nn.linear — do not transpose). q and k
# are rotated at their positions first via the U1.3 configurable RoPE row —
# the inference composition is causal + RoPE. The row is shape-generic:
# every shape derives from the runtime tensors and the head counts; no
# fixed-shape constants. The F32 row is the admitted row.
# -------------------------------------------------------------------------

@ public { }
fn multi_head_attention(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, tensor.Tensor wo, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, RopeConfig rope_config) → tensor.Tensor ⇥ AttentionError {
    const int d ← _validate_multi(q, k, v, wo, num_heads, num_kv_heads, positions, rope_dim)
    const int ratio ← num_heads / num_kv_heads
    const f32 base ← rope_config.base()
    const f32 rope_scale ← rope_config.scale()
    const bool interposita ← _interleaved(rope_config.policy())
    const list<f32> table ← _rope_table(positions, rope_dim, base, rope_scale)
    var list<tensor.Tensor> heads ← empty
    var int h ← 0
    while h ≺ num_heads {
        const int g ← h / ratio
        const tensor.Tensor qh ← _head(q, h * d, d)
        const tensor.Tensor kg ← _head(k, g * d, d)
        const tensor.Tensor vg ← _head(v, g * d, d)
        const tensor.Tensor qr ← _rope(qh, rope_dim, table, interposita)
        const tensor.Tensor kr ← _rope(kg, rope_dim, table, interposita)
        const tensor.Tensor ctx ← _attention_core(qr, kr, vg, scale, true)
        heads.append(ctx)
        h ← h + 1
    }
    const tensor.Tensor concat ← _reconcile(heads)
    return _attention_matmul(concat, wo)
}

# =========================================================================
# KV-A A2 — cached attention prefix, GQA, K-after-RoPE, V rules.
# Frozen coordinates (kv-cache-semantic-contract):
#   absolute_position(i)     = prefix_before + i
#   causal_end_exclusive(i)  = prefix_before + i + 1
#   prefill:  prefix_before = 0, query_rows = T, row i attends [0, i+1)
#   decode:   prefix_before = L, query_rows = 1, attends [0, L+1)
# The just-written row at the absolute position is included. Positions are
# absolute — local row zero is not a decode RoPE position. K is stored
# after absolute-position RoPE; V is stored unchanged. GQA requires
# query_heads % kv_heads == 0, with query head h mapped to KV head
# h / (query_heads / kv_heads). The F32 row is the admitted row.
# =========================================================================

@ public { }
class CachedAttention {
    tensor.Tensor context
    kv.KVCache state

    fn context() → tensor.Tensor {
        return self.context
    }

    fn state() → kv.KVCache {
        return self.state
    }
}

@ public { }
fn default_cached() → CachedAttention {
    return CachedAttention {context = tensor.default(), state = kv.default()}
}

# Causal row softmax over the frozen prefix: query row i attends
# [0, prefix_before + i + 1). The score width is prefix_before + query_rows
# (cached rows plus the just-written rows). No clamp — a short K/V prefix
# would exclude the new row and is rejected before this helper runs.
@ private { }
fn _softmax_prefix(tensor.Tensor x, int prefix_before) → tensor.Tensor {
    const list<int> f ← x.shape()
    const int rows ← f.get(0) coalesce 1
    const int cols ← f.get(1) coalesce 1
    var list<f32> out ← empty
    for range 0‥rows const i {
        const int end ← prefix_before + i + 1
        var f32 maximum ← x.data.get(i * cols) coalesce 0.0 ∷ f32
        var int j ← 0
        while j ≺ end {
            const f32 v ← x.data.get(i * cols + j) coalesce 0.0 ∷ f32
            if v ≻ maximum {
                maximum ← v
            }
            j ← j + 1
        }
        var list<f32> exps ← empty
        var f32 total ← 0.0 ∷ f32
        var int j2 ← 0
        while j2 ≺ end {
            const f32 v ← x.data.get(i * cols + j2) coalesce 0.0 ∷ f32
            const f32 e ← _exp(v - maximum)
            exps.append(e)
            total ← total + e
            j2 ← j2 + 1
        }
        for from exps const e {
            out.append(e / total)
        }
        var int j3 ← end
        while j3 ≺ cols {
            out.append(0.0 ∷ f32)
            j3 ← j3 + 1
        }
    }
    return tensor.Tensor {dtype = x.dtype(), shape = f, data = out}
}

# Attention core for q [Tq, D] against full k/v [prefix_before + Tq, D].
# Query row i attends [0, prefix_before + i + 1), including the just-written
# row at absolute position prefix_before + i.
@ private { }
fn _attention_core_offset(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, f32 scale, int prefix_before) → tensor.Tensor ⇥ AttentionError {
    const list<int> fq ← q.shape()
    const list<int> fk ← k.shape()
    const int tq ← fq.get(0) coalesce 1
    const int tk ← fk.get(0) coalesce 1
    require prefix_before ≥ 0 throw variant InvalidPosition {message = "negative position"}
    require tk ≡ prefix_before + tq throw variant ShapeMismatch {message = "attention prefix excludes the just-written row"}
    const tensor.Tensor kt ← _transpose(k)
    const tensor.Tensor scale_t ← _fill([tq, tk], scale)
    do {
        const tensor.Tensor scores ← math.matmul(q, kt)
        const tensor.Tensor scaled ← math.mul(scores, scale_t)
        const tensor.Tensor attn ← _softmax_prefix(scaled, prefix_before)
        const tensor.Tensor context ← math.matmul(attn, v)
        return context
    }
    catch err {
        match err {
            case math.MathError.GradusMismatch const message {
                throw variant GradusMismatch { message = message }
            }
            case math.MathError.Incompatible const message {
                throw variant Incompatible { message = message }
            }
            case math.MathError.DtypeMismatch const message {
                throw variant DtypeMismatch { message = message }
            }
            case math.MathError.ProductAboveLimit const message {
                throw variant ProductAboveLimit { message = message }
            }
            case math.MathError.DimensionAboveLimit const message {
                throw variant DimensionAboveLimit { message = message }
            }
            case math.MathError.NegativeDimension const message {
                throw variant NegativeDimension { message = message }
            }
            case math.MathError.ShapeMismatch const message {
                throw variant ShapeMismatch { message = message }
            }
            case _ {
                throw variant ShapeMismatch { message = err.message }
            }
        }
    }
}

@ private { }
fn _concat_rows(tensor.Tensor a, tensor.Tensor b) → tensor.Tensor ⇥ AttentionError {
    const int ta ← a.shape().get(0) coalesce 0
    if ta ≡ 0 then return b
    const int tb ← b.shape().get(0) coalesce 0
    if tb ≡ 0 then return a
    do {
        return math.concatenate([a, b], 0)
    }
    catch err {
        throw variant ShapeMismatch {message = err.message}
    }
}

@ private { }
fn _write_cache(kv.KVCache layer, list<int> tokens, tensor.Tensor key, tensor.Tensor payload) → kv.KVCache ⇥ AttentionError {
    do {
        return kv.extend(layer, tokens, key, payload)
    }
    catch err {
        throw variant ShapeMismatch {message = err.message}
    }
}

# Positions are absolute: query row i is at prefix_before + i. Local row
# zero is rejected whenever prefix_before > 0 (decode RoPE must not reuse
# the first cache slot's coordinate).
@ private { }
fn _validate_absolute_positions(int prefix_before, list<int> positions, int query_rows) → bool ⇥ AttentionError {
    require positions.length() ≡ query_rows throw variant ShapeMismatch {message = "positions must match the token count"}
    for range 0‥query_rows const i {
        const int pos ← positions.get(i) coalesce (0 - 1)
        require pos ≡ prefix_before + i throw variant InvalidPosition {message = "position must be the absolute prefix row"}
    }
    return true
}

@ private { }
fn _validate_cached_triplet(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, kv.KVCache layer, list<int> tokens) → int ⇥ AttentionError {
    _dtype_triple(q, k, v)
    require layer.dtype() ≡ "f32" throw variant DtypeMismatch {message = "unsupported dtype for attention primitive"}
    const list<int> fq ← q.shape()
    const list<int> fk ← k.shape()
    const list<int> fv ← v.shape()
    require not (fq.length() ≠ 2 or fk.length() ≠ 2 or fv.length() ≠ 2) throw variant GradusMismatch {message = "attention requires rank-2 tensors"}
    const int t ← fq.get(0) coalesce 1
    const int d ← fq.get(1) coalesce 1
    require not (fk.get(0) coalesce 1 ≠ t or fk.get(1) coalesce 1 ≠ d) throw variant ShapeMismatch {message = "query, key, value must share shape"}
    require not (fv.get(0) coalesce 1 ≠ t or fv.get(1) coalesce 1 ≠ d) throw variant ShapeMismatch {message = "query, key, value must share shape"}
    require not (t ≡ 0 or d ≡ 0) throw variant ElementMismatch {message = "empty attention input"}
    require tokens.length() ≡ t throw variant ShapeMismatch {message = "tokens must match the token count"}
    require layer.dimension() ≡ d throw variant ShapeMismatch {message = "cache dimension must equal the head width"}
    const int prefix_before ← layer.length()
    const list<int> fc ← layer.key().shape()
    const list<int> fp ← layer.payload().shape()
    require fc.length() ≡ 2 throw variant GradusMismatch {message = "cache key must be rank-2"}
    require fp.length() ≡ 2 throw variant GradusMismatch {message = "cache value must be rank-2"}
    require fc.get(1) coalesce 1 ≡ d throw variant ShapeMismatch {message = "cache key width must equal the head width"}
    require fp.get(1) coalesce 1 ≡ d throw variant ShapeMismatch {message = "cache value width must equal the head width"}
    require (fc.get(0) coalesce 0) ≡ prefix_before throw variant ShapeMismatch {message = "cache key rows must equal the prefix length"}
    require (fp.get(0) coalesce 0) ≡ prefix_before throw variant ShapeMismatch {message = "cache value rows must equal the prefix length"}
    return prefix_before
}

# -------------------------------------------------------------------------
# scaled_dot_product_causal_rope_cached — single-head prefill / M=1 decode.
# q/k/v are the NEW rows [T, D]. prefix_before is the logical cache length
# L before this write. Q and K rotate at absolute positions L..L+T-1; K is
# stored after that RoPE, V is stored raw. The query attends [0, L+i+1)
# including the just-written row, then the new rows are extended.
# -------------------------------------------------------------------------

@ public { }
fn scaled_dot_product_causal_rope_cached(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, f32 scale, list<int> positions, int dim, kv.KVCache layer, list<int> tokens) → CachedAttention ⇥ AttentionError {
    const int prefix_before ← _validate_cached_triplet(q, k, v, layer, tokens)
    _validate_rope(q, positions, dim)
    _validate_absolute_positions(prefix_before, positions, q.shape().get(0) coalesce 0)
    const list<f32> table ← _rope_table(positions, dim, ROPE_FREQ_BASE, 1.0 ∷ f32)
    const tensor.Tensor qr ← _rope(q, dim, table, false)
    const tensor.Tensor kr ← _rope(k, dim, table, false)
    const tensor.Tensor full_k ← _concat_rows(layer.key(), kr)
    const tensor.Tensor full_v ← _concat_rows(layer.payload(), v)
    const tensor.Tensor context ← _attention_core_offset(qr, full_k, full_v, scale, prefix_before)
    return CachedAttention {context = context, state = _write_cache(layer, tokens, kr, v)}
}

@ private { }
fn _validate_cached_multi(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, tensor.Tensor wo, kv.KVCache layer, int num_heads, int num_kv_heads, list<int> positions, int rope_dim, list<int> tokens) → int ⇥ AttentionError {
    const int d ← _validate_multi(q, k, v, wo, num_heads, num_kv_heads, positions, rope_dim)
    require layer.dtype() ≡ "f32" throw variant DtypeMismatch {message = "unsupported dtype for attention primitive"}
    require tokens.length() ≡ (q.shape().get(0) coalesce 0) throw variant ShapeMismatch {message = "tokens must match the token count"}
    const int kv_width ← num_kv_heads * d
    require layer.dimension() ≡ kv_width throw variant ShapeMismatch {message = "cache dimension must equal num_kv_heads * head dim"}
    const int prefix_before ← layer.length()
    const list<int> fc ← layer.key().shape()
    require fc.length() ≡ 2 throw variant GradusMismatch {message = "cache key must be rank-2"}
    require fc.get(1) coalesce 1 ≡ kv_width throw variant ShapeMismatch {message = "cache key width must equal num_kv_heads * head dim"}
    const list<int> fv ← layer.payload().shape()
    require not (fv.length() ≠ 2 or fv.get(1) coalesce 1 ≠ kv_width) throw variant ShapeMismatch {message = "cache value width must equal num_kv_heads * head dim"}
    require (fc.get(0) coalesce 0) ≡ prefix_before throw variant ShapeMismatch {message = "cache key rows must equal the prefix length"}
    require (fv.get(0) coalesce 0) ≡ prefix_before throw variant ShapeMismatch {message = "cache value rows must equal the prefix length"}
    return d
}

# -------------------------------------------------------------------------
# multi_head_attention_cached — GQA prefill / M=1 decode. q [T, H·D] and
# k/v [T, K·D] are the NEW packed rows. GQA requires H % K == 0; query
# head h attends KV head h / (H/K). Cached K is post-RoPE at absolute
# positions; V is stored unchanged. Query row i attends [0, L+i+1).
# -------------------------------------------------------------------------

@ public { }
fn multi_head_attention_cached(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, tensor.Tensor wo, kv.KVCache layer, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, RopeConfig rope_config, list<int> tokens) → CachedAttention ⇥ AttentionError {
    const int d ← _validate_cached_multi(q, k, v, wo, layer, num_heads, num_kv_heads, positions, rope_dim, tokens)
    const int prefix_before ← layer.length()
    _validate_absolute_positions(prefix_before, positions, q.shape().get(0) coalesce 0)
    const int ratio ← num_heads / num_kv_heads
    const f32 base ← rope_config.base()
    const f32 rope_scale ← rope_config.scale()
    const bool interposita ← _interleaved(rope_config.policy())
    const list<f32> table ← _rope_table(positions, rope_dim, base, rope_scale)
    var list<tensor.Tensor> new_ks ← empty
    var int g ← 0
    while g ≺ num_kv_heads {
        const tensor.Tensor kg ← _head(k, g * d, d)
        new_ks.append(_rope(kg, rope_dim, table, interposita))
        g ← g + 1
    }
    const tensor.Tensor new_k ← _reconcile(new_ks)
    const tensor.Tensor full_k ← _concat_rows(layer.key(), new_k)
    const tensor.Tensor full_v ← _concat_rows(layer.payload(), v)
    var list<tensor.Tensor> heads ← empty
    var int h ← 0
    while h ≺ num_heads {
        const int group ← h / ratio
        const tensor.Tensor qh ← _head(q, h * d, d)
        const tensor.Tensor qr ← _rope(qh, rope_dim, table, interposita)
        const tensor.Tensor kg_all ← _head(full_k, group * d, d)
        const tensor.Tensor vg_all ← _head(full_v, group * d, d)
        heads.append(_attention_core_offset(qr, kg_all, vg_all, scale, prefix_before))
        h ← h + 1
    }
    const tensor.Tensor concat ← _reconcile(heads)
    const tensor.Tensor context ← _attention_matmul(concat, wo)
    return CachedAttention {context = context, state = _write_cache(layer, tokens, new_k, v)}
}
