+++
locale = "en"
+++
# Focused proof for the cache storage split. The old cache.proba keeps the
# decoded F32 consumer contract; this file proves the physical encoded seam.

import from "gradus:cache/kv" kv
import from "gradus:storage" storage
import from "gradus:test_util" test_util

fn bytes_repeat(int count, int value) → bytes {
    var list<int<u8>> values ← empty
    for range 0 ‥ count const _ {
        values.append(value ∷ int<u8>)
    }
    return values ↦ bytes
}

fn encoded_cache() → kv.KVCache {
    return test_util.or_default(() → kv.KVCache ⇥ kv.CacheError ∴ kv.empty_cache_with_capacity_representations("tiny-mlp", "1.0.0", "causal-rope-d4", "smollm", 1, 32, 8, kv.representation_f16(), kv.block_f16(), kv.representation_q8_0(), kv.block_q8_0()), kv.default())
}

fn decoded_detail(kv.KVCache c) → string {
    do {
        kv.decoded_key(c)
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn decoded_value_detail(kv.KVCache c) → string {
    do {
        kv.decoded_value(c)
        return "ok"
    }
    catch err {
        return err.message
    }
}

test "representation descriptors keep independent K and V identities" {
    const kv.KVCache c ← encoded_cache()
    assert c.key_storage.encoded.representation.namespace ≡ "ggml"
    assert c.key_storage.encoded.representation.name ≡ "f16"
    assert c.key_storage.encoded.representation.version ≡ "unspecified"
    assert c.key_storage.encoded.representation.code ≡ 1
    assert c.key_storage.encoded.block.elements_per_block ≡ 1
    assert c.key_storage.encoded.block.bytes_per_block ≡ 2
    assert c.value_storage.encoded.representation.name ≡ "q8_0"
    assert c.value_storage.encoded.representation.code ≡ 8
    assert c.value_storage.encoded.block.elements_per_block ≡ 32
    assert c.value_storage.encoded.block.bytes_per_block ≡ 34
    assert c.key_storage.shape ≡ ([0, 32] ↦ list<int>)
    assert c.value_storage.shape ≡ ([0, 32] ↦ list<int>)
    assert c.key_storage.count ≡ 0
    assert c.value_storage.count ≡ 0
}

test "encoded append preserves K/V bytes and logical shape" {
    const kv.KVCache c0 ← encoded_cache()
    const bytes key ← bytes_repeat(64, 17)
    const bytes value ← bytes_repeat(34, 203)
    const kv.KVCache c1 ← test_util.or_default(() → kv.KVCache ⇥ kv.CacheError ∴ kv.append_encoded(c0, 7, key, value), kv.default())
    assert c1.history ≡ ([7] ↦ list<int>)
    assert c1.length() ≡ 1
    assert c1.version ≡ 2
    assert c1.key_storage.shape ≡ ([1, 32] ↦ list<int>)
    assert c1.value_storage.shape ≡ ([1, 32] ↦ list<int>)
    assert c1.key_storage.count ≡ 1
    assert c1.value_storage.count ≡ 1
    assert c1.key_storage.encoded.payload.length() ≡ 64
    assert c1.value_storage.encoded.payload.length() ≡ 34
    assert c1.key_storage.encoded.payload.get(0) coalesce 0 ∷ int<u8> ≡ 17 ∷ int<u8>
    assert c1.key_storage.encoded.payload.get(63) coalesce 0 ∷ int<u8> ≡ 17 ∷ int<u8>
    assert c1.value_storage.encoded.payload.get(0) coalesce 0 ∷ int<u8> ≡ 203 ∷ int<u8>
    assert c1.value_storage.encoded.payload.get(33) coalesce 0 ∷ int<u8> ≡ 203 ∷ int<u8>
    assert decoded_detail(c1) ≡ "decoded K access is unavailable for encoded storage"
    assert decoded_value_detail(c1) ≡ "decoded V access is unavailable for encoded storage"
}

test "encoded extend appends complete physical rows without widening" {
    const kv.KVCache c0 ← encoded_cache()
    const bytes key ← bytes_repeat(128, 31)
    const bytes value ← bytes_repeat(68, 149)
    const kv.KVCache c1 ← test_util.or_default(() → kv.KVCache ⇥ kv.CacheError ∴ kv.extend_encoded(c0, [3, 5], key, value), kv.default())
    assert c1.history ≡ ([3, 5] ↦ list<int>)
    assert c1.length() ≡ 2
    assert c1.version ≡ 2
    assert c1.key_storage.shape ≡ ([2, 32] ↦ list<int>)
    assert c1.value_storage.shape ≡ ([2, 32] ↦ list<int>)
    assert c1.key_storage.encoded.payload.length() ≡ 128
    assert c1.value_storage.encoded.payload.length() ≡ 68
    assert c1.key_storage.encoded.payload.get(127) coalesce 0 ∷ int<u8> ≡ 31 ∷ int<u8>
    assert c1.value_storage.encoded.payload.get(67) coalesce 0 ∷ int<u8> ≡ 149 ∷ int<u8>
}

test "unknown future storage representation round-trips through encoded KV storage" {
    const storage.Representation future ← storage.representation("vendor", "future_blob", "2026", -77)
    const storage.BlockMetadata block ← storage.known_block(8, 10, 1, 10)
    const kv.KVCache c0 ← test_util.or_default(() → kv.KVCache ⇥ kv.CacheError ∴ kv.empty_cache_with_capacity_representations("tiny-mlp", "1.0.0", "causal-rope-d4", "smollm", 1, 8, 4, future, block, kv.representation_f16(), kv.block_f16()), kv.default())
    const kv.KVCache c1 ← test_util.or_default(() → kv.KVCache ⇥ kv.CacheError ∴ kv.append_encoded(c0, 11, bytes_repeat(10, 233), bytes_repeat(16, 17)), kv.default())
    assert c1.key_storage.encoded.representation.namespace ≡ "vendor"
    assert c1.key_storage.encoded.representation.name ≡ "future_blob"
    assert c1.key_storage.encoded.representation.version ≡ "2026"
    assert c1.key_storage.encoded.representation.code ≡ -77
    assert c1.key_storage.encoded.block.elements_per_block ≡ 8
    assert c1.key_storage.encoded.block.bytes_per_block ≡ 10
    assert c1.key_storage.encoded.payload.length() ≡ 10
    assert c1.key_storage.encoded.payload.get(0) coalesce 0 ∷ int<u8> ≡ 233 ∷ int<u8>
    assert c1.key_storage.shape ≡ ([1, 8] ↦ list<int>)
    assert c1.key_storage.count ≡ 1
}
