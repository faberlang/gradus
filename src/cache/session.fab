+++ toml
locale = "en"

+++ faber
# SessionState — slot-indexed FullKvArena and artifact-sized RingKvArena
# over ExecutionSchedule `slot_id` (issue #49, #51, #92).
#
# Public import: import from "gradus:cache/session" session
# Depends on: gradus:model/schedule, gradus:decode_step.
#
# --- Contract ------------------------------------------------------------
#
# Allocates typed device-ready `tensor<f32, [C, KVD]>` (`FullKvArena`) and
# circular `tensor<f32, [W, KVD]>` (`RingKvArena`) buffers indexed by
# `ExecutionSchedule.slots` (`slot_id`), with per-slot `window_size` taken
# from admitted artifact metadata (e.g. 513 on Flint, 1024 on Inkling,
# 1025 on dflash — arbitrary non-power-of-two integers).
#
# Transactional speculative verification (`branch` / `txn_write_kv` /
# `commit_prefix` / `rollback`) uses zero-copy cursor snapshots for
# `FullKvArena` (extension-only writes) and bounded ring snapshots plus
# kernel replay for `RingKvArena`.
#
# Zero `NumericBlock` (`list<f32>`) usage: all KV storage is typed device
# tensors compatible with Cranelift CPU and Metal KIR kernels.

import from "gradus:decode_step" let ds
import from "gradus:model/schedule" let model_schedule

const int ARENA_FULL_KV = 0
const int ARENA_RING_KV = 1
const int ARENA_RECURRENT_SSM = 2
const int ARENA_NO_STATE = 3
const int SESSION_ID_MOD = 2147483647

@ public
union SessionError {
    @ shared
    string message

    InvalidSchedule,
    InvalidCapacity,
    InvalidSlot,
    SlotArenaMismatch,
    OutOfBoundsPosition,
    TxnOpen,
    NoOpenTxn,
    InvalidCommitCount,
    InvalidBranchWrite,
    UnsupportedKvQuant,
    SessionMismatch
}

@ public
class ValidSpan {
    let int start_pos
    let int end_pos
    let int valid_count
    let int write_slot
}

@ public
class FullKvArena<size C, size KVD> {
    let int capacity
    let int kv_dim
    let list<int> slot_ids
    mut list<tensor<f32, [C, KVD]>> keys
    mut list<tensor<f32, [C, KVD]>> values
    mut list<int> lengths
}

@ public
class RingKvArena<size W, size KVD> {
    let int max_window
    let int kv_dim
    let list<int> slot_ids
    let list<int> window_sizes
    mut list<tensor<f32, [W, KVD]>> keys
    mut list<tensor<f32, [W, KVD]>> values
    mut list<int> total_written
}

@ public
class KvQuantConfig {
    let int key_bits
    let int value_bits
    let int group_size
    let bool enabled
}

@ public
fn default_kv_quant() → KvQuantConfig {
    return KvQuantConfig { key_bits = 0, value_bits = 0, group_size = 0, enabled = false }
}

@ public
class SessionState<size C, size W, size KVD> {
    let model_schedule.ExecutionSchedule sched
    mut FullKvArena<size C, size KVD> full_kv
    mut RingKvArena<size W, size KVD> ring_kv
    let list<int> slot_arena_kind
    let list<int> slot_local_index
    let list<int> slot_window_sizes
    mut list<KvQuantConfig> slot_kv_quant
    # 0 = no transaction open; 1 = a `branch` is active. Plain writes
    # fail-closed while a branch is open.
    mut int txn_depth
    mut int session_id = 0
    mut int txn_seq = 0
    mut int active_txn_id = 0
}

# One-shot speculative transaction over one `SessionState`.
# `branch` snapshots every ring buffer (bounded by the ring's own window
# design) and the full-KV cursors; branch writes go through `txn_write_kv`
# and ring writes are journaled; `commit_prefix(accepted_count)` restores the
# ring snapshot and replays the accepted prefix through `ds.kv_ring_write_row`,
# while `rollback` restores without replaying. Full-KV branch writes are
# sequential extension-only, so the large full-KV buffers are never copied.
@ public
class SessionTxn<size C, size W, size KVD> {
    let list<int> base_full_lengths
    mut list<int> full_draft_counts
    let list<int> base_ring_written
    mut list<int> ring_draft_counts
    let list<tensor<f32, [W, KVD]>> base_ring_keys
    let list<tensor<f32, [W, KVD]>> base_ring_values
    mut list<int> ring_journal_local_idx
    mut list<i32> ring_journal_pos
    mut list<tensor<f32, [KVD]>> ring_journal_k
    mut list<tensor<f32, [KVD]>> ring_journal_v
    mut bool open
    let int session_id = 0
    let int txn_id = 0
}

# -------------------------------------------------------------------------
# Pure indexing and valid-span bounds helpers
# -------------------------------------------------------------------------

@ public
fn ring_slot(int pos, int window) → int ⇥ SessionError {
    require pos ≥ 0 throw variant OutOfBoundsPosition { message = "ring position must be non-negative" }
    require window ≥ 1 throw variant InvalidCapacity { message = "ring window size must be positive" }

    return pos % window
}

@ public
fn ring_span(int total_written, int window) → ValidSpan ⇥ SessionError {
    require total_written ≥ 0 throw variant OutOfBoundsPosition { message = "total_written must be non-negative" }
    require window ≥ 1 throw variant InvalidCapacity { message = "ring window size must be positive" }

    if total_written ≡ 0 {
        return ValidSpan { start_pos = 0, end_pos = 0, valid_count = 0, write_slot = 0 }
    }

    mut int start ← total_written - window

    if start ≺ 0 {
        start ← 0
    }

    let int count ← total_written - start
    let int last_slot ← (total_written - 1) % window
    return ValidSpan { start_pos = start, end_pos = total_written, valid_count = count, write_slot = last_slot }
}

@ public
fn full_span(int total_written, int capacity) → ValidSpan ⇥ SessionError {
    require total_written ≥ 0 and total_written ≤ capacity throw variant OutOfBoundsPosition { message = "full KV length § exceeds capacity §"(total_written ↦ string, capacity ↦ string) }
    require capacity ≥ 1 throw variant InvalidCapacity { message = "full KV capacity must be positive" }

    if total_written ≡ 0 {
        return ValidSpan { start_pos = 0, end_pos = 0, valid_count = 0, write_slot = 0 }
    }

    return ValidSpan { start_pos = 0, end_pos = total_written, valid_count = total_written, write_slot = total_written - 1 }
}

# -------------------------------------------------------------------------
# Construction from ExecutionSchedule
# -------------------------------------------------------------------------

@ public
fn schedule_fingerprint(model_schedule.ExecutionSchedule sched, int cap, int win, int kvd) → int {
    mut int h ← 17
    h ← (h * 131 + cap + 1) % SESSION_ID_MOD
    h ← (h * 131 + win + 1) % SESSION_ID_MOD
    h ← (h * 131 + kvd + 1) % SESSION_ID_MOD
    h ← (h * 131 + sched.slots.length() + 1) % SESSION_ID_MOD
    h ← (h * 131 + sched.layers.length() + 1) % SESSION_ID_MOD
    for exclusive sched.slots.length() let i {
        let model_schedule.SlotSpec sp ← sched.slots[i]
        mut int tag ← 3
        match sp.arena {
            case model_schedule.ArenaKind.FullKv {
                tag ← 11
            }
            case model_schedule.ArenaKind.RingKv let w {
                tag ← 100 + w
            }
            case model_schedule.ArenaKind.RecurrentSsm {
                tag ← 23
            }
            case model_schedule.ArenaKind.NoState {
                tag ← 37
            }
        }
        h ← (h * 131 + sp.slot_id + 1) % SESSION_ID_MOD
        h ← (h * 131 + tag) % SESSION_ID_MOD
    }
    if h ≤ 0 then return 1
    return h
}

@ public
fn from_schedule<size C, size W, size KVD>(model_schedule.ExecutionSchedule sched) → SessionState<size C, size W, size KVD> ⇥ SessionError {
    require C ≥ 1 and W ≥ 1 and KVD ≥ 1 throw variant InvalidCapacity { message = "SessionState extents C, W, and KVD must be positive" }

    mut list<int> full_slot_ids ← empty
    mut list<tensor<f32, [C, KVD]>> full_keys ← empty
    mut list<tensor<f32, [C, KVD]>> full_values ← empty
    mut list<int> full_lengths ← empty

    mut list<int> ring_slot_ids ← empty
    mut list<int> ring_windows ← empty
    mut list<tensor<f32, [W, KVD]>> ring_keys ← empty
    mut list<tensor<f32, [W, KVD]>> ring_values ← empty
    mut list<int> ring_written ← empty

    mut list<int> slot_arena_kind ← empty
    mut list<int> slot_local_index ← empty
    mut list<int> slot_window_sizes ← empty
    mut list<KvQuantConfig> slot_kv_quant ← empty

    for exclusive sched.slots.length() let expected_slot {
        let model_schedule.SlotSpec sp ← sched.slots[expected_slot]

        require sp.slot_id ≡ expected_slot throw variant InvalidSchedule { message = "schedule slots must be contiguous from 0 (expected §, got §)"(expected_slot ↦ string, sp.slot_id ↦ string) }

        slot_kv_quant.append(default_kv_quant())

        match sp.arena {
            case model_schedule.ArenaKind.FullKv {
                let int local_idx ← full_slot_ids.length()
                let tensor<f32, [C, KVD]> fk ← tf32[C, KVD] {}
                let tensor<f32, [C, KVD]> fv ← tf32[C, KVD] {}
                full_slot_ids.append(sp.slot_id)
                full_keys.append(fk)
                full_values.append(fv)
                full_lengths.append(0)
                slot_arena_kind.append(ARENA_FULL_KV)
                slot_local_index.append(local_idx)
                slot_window_sizes.append(C)
            }
            case model_schedule.ArenaKind.RingKv let window {
                require window ≥ 1 and window ≤ W throw variant InvalidCapacity { message = "slot § ring window § exceeds arena capacity §"(sp.slot_id ↦ string, window ↦ string, W ↦ string) }

                let int local_idx ← ring_slot_ids.length()
                let tensor<f32, [W, KVD]> rk ← tf32[W, KVD] {}
                let tensor<f32, [W, KVD]> rv ← tf32[W, KVD] {}
                ring_slot_ids.append(sp.slot_id)
                ring_windows.append(window)
                ring_keys.append(rk)
                ring_values.append(rv)
                ring_written.append(0)
                slot_arena_kind.append(ARENA_RING_KV)
                slot_local_index.append(local_idx)
                slot_window_sizes.append(window)
            }
            case model_schedule.ArenaKind.RecurrentSsm {
                slot_arena_kind.append(ARENA_RECURRENT_SSM)
                slot_local_index.append(-1)
                slot_window_sizes.append(0)
            }
            case model_schedule.ArenaKind.NoState {
                slot_arena_kind.append(ARENA_NO_STATE)
                slot_local_index.append(-1)
                slot_window_sizes.append(0)
            }
        }
    }

    let FullKvArena<size C, size KVD> full_arena ← FullKvArena { capacity = C, kv_dim = KVD, slot_ids = full_slot_ids, keys = full_keys, values = full_values, lengths = full_lengths }
    let RingKvArena<size W, size KVD> ring_arena ← RingKvArena { max_window = W, kv_dim = KVD, slot_ids = ring_slot_ids, window_sizes = ring_windows, keys = ring_keys, values = ring_values, total_written = ring_written }
    let int sid ← schedule_fingerprint(sched, C, W, KVD)
    return SessionState { sched = sched, full_kv = full_arena, ring_kv = ring_arena, slot_arena_kind = slot_arena_kind, slot_local_index = slot_local_index, slot_window_sizes = slot_window_sizes, slot_kv_quant = slot_kv_quant, txn_depth = 0, session_id = sid, txn_seq = 0, active_txn_id = 0 }
}

@ public
fn from_schedule_with_id<size C, size W, size KVD>(model_schedule.ExecutionSchedule sched, int session_id) → SessionState<size C, size W, size KVD> ⇥ SessionError {
    mut SessionState<size C, size W, size KVD> sess ← from_schedule<size C, size W, size KVD>(sched)
    sess.session_id ← session_id
    return sess
}

@ public
fn set_session_id<size C, size W, size KVD>(mut SessionState<size C, size W, size KVD> sess, int session_id) → void ⇥ SessionError {
    require sess.txn_depth ≡ 0 throw variant TxnOpen { message = "cannot change session_id while a branch is open" }
    sess.session_id ← session_id
}

@ public
fn from_dense_schedule<size C, size KVD>(model_schedule.ExecutionSchedule sched) → SessionState<size C, size 1, size KVD> ⇥ SessionError {
    return from_schedule<size C, size 1, size KVD>(sched)
}

# -------------------------------------------------------------------------
# Slot inspection & per-slot KV-quant policy metadata
# -------------------------------------------------------------------------

fn check_slot_idx(int slot_count, int slot_id) → void ⇥ SessionError {
    require slot_id ≥ 0 and slot_id ≺ slot_count throw variant InvalidSlot { message = "slot_id § out of range"(slot_id ↦ string) }
}

@ public
fn slot_kind<size C, size W, size KVD>(SessionState<size C, size W, size KVD> sess, int slot_id) → model_schedule.ArenaKind ⇥ SessionError {
    check_slot_idx(sess.slot_arena_kind.length(), slot_id)
    return sess.sched.slots[slot_id].arena
}

@ public
fn slot_valid_span<size C, size W, size KVD>(SessionState<size C, size W, size KVD> sess, int slot_id) → ValidSpan ⇥ SessionError {
    check_slot_idx(sess.slot_arena_kind.length(), slot_id)
    let int kind ← sess.slot_arena_kind[slot_id]
    let int idx ← sess.slot_local_index[slot_id]

    if kind ≡ ARENA_FULL_KV {
        return full_span(sess.full_kv.lengths[idx], C)
    }
    elif kind ≡ ARENA_RING_KV {
        return ring_span(sess.ring_kv.total_written[idx], sess.slot_window_sizes[slot_id])
    }

    throw variant SlotArenaMismatch { message = "slot § is not a KV arena"(slot_id ↦ string) }
}

fn check_unquantized_slot(list<KvQuantConfig> quants, int slot_id) → void ⇥ SessionError {
    if slot_id ≺ quants.length() and quants[slot_id].enabled {
        throw variant UnsupportedKvQuant { message = "quantized KV arena is not implemented yet; slot § has KvQuantConfig.enabled = true"(slot_id ↦ string) }
    }
}

fn check_txn_ids(bool txn_open, int txn_sid, int sess_sid, int txn_depth, int txn_id, int active_txn_id, int t_full_len, int s_full_len, int t_ring_len, int s_ring_len) → void ⇥ SessionError {
    require txn_open throw variant NoOpenTxn { message = "transaction is closed" }
    require txn_sid ≡ sess_sid throw variant SessionMismatch { message = "SessionTxn session_id § does not match SessionState §"(txn_sid ↦ string, sess_sid ↦ string) }
    require txn_depth ≡ 1 throw variant NoOpenTxn { message = "session has no open transaction" }
    require txn_id ≡ active_txn_id throw variant SessionMismatch { message = "SessionTxn txn_id § does not match active transaction §"(txn_id ↦ string, active_txn_id ↦ string) }
    require t_full_len ≡ s_full_len throw variant SessionMismatch { message = "SessionTxn FullKv slot count mismatch" }
    require t_ring_len ≡ s_ring_len throw variant SessionMismatch { message = "SessionTxn RingKv slot count mismatch" }
}

@ public
fn verify_txn_session<size C, size W, size KVD>(SessionState<size C, size W, size KVD> sess, SessionTxn<size C, size W, size KVD> txn) → void ⇥ SessionError {
    check_txn_ids(txn.open, txn.session_id, sess.session_id, sess.txn_depth, txn.txn_id, sess.active_txn_id, txn.base_full_lengths.length(), sess.full_kv.lengths.length(), txn.base_ring_written.length(), sess.ring_kv.total_written.length())
}

@ public
fn set_slot_kv_quant<size C, size W, size KVD>(mut SessionState<size C, size W, size KVD> sess, int slot_id, KvQuantConfig cfg) → void ⇥ SessionError {
    check_slot_idx(sess.slot_arena_kind.length(), slot_id)
    require cfg.key_bits ≥ 0 and cfg.value_bits ≥ 0 and cfg.group_size ≥ 0 throw variant InvalidCapacity { message = "KvQuantConfig fields must be non-negative" }
    require not cfg.enabled throw variant UnsupportedKvQuant { message = "quantized KV arena is not implemented yet; KvQuantConfig.enabled = true is unsupported" }
    sess.slot_kv_quant[slot_id] ← cfg
}

# -------------------------------------------------------------------------
# Device-ready KV write, windowed attention score, and context dispatch
# -------------------------------------------------------------------------

@ public
fn write_kv<size C, size W, size KVD>(mut SessionState<size C, size W, size KVD> sess, int slot_id, tensor<f32, [KVD]> k, tensor<f32, [KVD]> v, i32 pos) → void ⇥ SessionError {
    require sess.txn_depth ≡ 0 throw variant TxnOpen { message = "plain write_kv refuses to touch a shared cache while a branch is open" }
    check_slot_idx(sess.slot_arena_kind.length(), slot_id)
    check_unquantized_slot(sess.slot_kv_quant, slot_id)
    let int kind ← sess.slot_arena_kind[slot_id]
    let int idx ← sess.slot_local_index[slot_id]
    let int p ← pos ↦ int

    if kind ≡ ARENA_FULL_KV {
        require p ≥ 0 and p ≺ C throw variant OutOfBoundsPosition { message = "FullKv position § out of capacity §"(p ↦ string, C ↦ string) }

        ds.kv_write_row(k, mut sess.full_kv.keys[idx], pos)
        ds.kv_write_row(v, mut sess.full_kv.values[idx], pos)
        if p + 1 ≻ sess.full_kv.lengths[idx] {
            sess.full_kv.lengths[idx] ← p + 1
        }
        return
    }
    elif kind ≡ ARENA_RING_KV {
        require p ≥ 0 throw variant OutOfBoundsPosition { message = "RingKv position § must be non-negative"(p ↦ string) }

        let i32 win ← sess.slot_window_sizes[slot_id] ↦ i32 ⊥ 0
        ds.kv_ring_write_row(k, mut sess.ring_kv.keys[idx], pos, win)
        ds.kv_ring_write_row(v, mut sess.ring_kv.values[idx], pos, win)
        if p + 1 ≻ sess.ring_kv.total_written[idx] {
            sess.ring_kv.total_written[idx] ← p + 1
        }
        return
    }

    throw variant SlotArenaMismatch { message = "slot § is not a KV arena"(slot_id ↦ string) }
}

# -------------------------------------------------------------------------
# Speculative transactions (zero-copy FullKv + RingKv snapshot/replay)
# -------------------------------------------------------------------------

@ public
fn branch<size C, size W, size KVD>(mut SessionState<size C, size W, size KVD> sess) → SessionTxn<size C, size W, size KVD> ⇥ SessionError {
    require sess.txn_depth ≡ 0 throw variant TxnOpen { message = "nested branches are not supported; commit or roll back the open transaction first" }
    for exclusive sess.slot_kv_quant.length() let i {
        check_unquantized_slot(sess.slot_kv_quant, i)
    }

    mut list<int> base_lengths ← empty
    mut list<int> full_counts ← empty
    mut list<int> base_written ← empty
    mut list<int> ring_counts ← empty
    mut list<tensor<f32, [W, KVD]>> base_keys ← empty
    mut list<tensor<f32, [W, KVD]>> base_values ← empty
    mut list<int> jidx ← empty
    mut list<i32> jpos ← empty
    mut list<tensor<f32, [KVD]>> jk ← empty
    mut list<tensor<f32, [KVD]>> jv ← empty

    for exclusive sess.full_kv.lengths.length() let i {
        base_lengths.append(sess.full_kv.lengths[i])
        full_counts.append(0)
    }
    for exclusive sess.ring_kv.total_written.length() let i {
        base_written.append(sess.ring_kv.total_written[i])
        ring_counts.append(0)
        mut tensor<f32, [W, KVD]> bk ← copy sess.ring_kv.keys[i]
        mut tensor<f32, [W, KVD]> bv ← copy sess.ring_kv.values[i]
        base_keys.append(bk)
        base_values.append(bv)
    }

    sess.txn_seq ← sess.txn_seq + 1
    sess.active_txn_id ← sess.txn_seq
    sess.txn_depth ← 1
    return SessionTxn { base_full_lengths = base_lengths, full_draft_counts = full_counts, base_ring_written = base_written, ring_draft_counts = ring_counts, base_ring_keys = base_keys, base_ring_values = base_values, ring_journal_local_idx = jidx, ring_journal_pos = jpos, ring_journal_k = jk, ring_journal_v = jv, open = true, session_id = sess.session_id, txn_id = sess.active_txn_id }
}

# Transactional write during an open branch. Both FullKv and RingKv enforce
# sequential append (`pos == current cursor`) so `base + accepted_count`
# cursor arithmetic on `commit_prefix` is exact without scanning gaps.
@ public
fn txn_write_kv<size C, size W, size KVD>(mut SessionState<size C, size W, size KVD> sess, mut SessionTxn<size C, size W, size KVD> txn, int slot_id, tensor<f32, [KVD]> k, tensor<f32, [KVD]> v, i32 pos) → void ⇥ SessionError {
    check_txn_ids(txn.open, txn.session_id, sess.session_id, sess.txn_depth, txn.txn_id, sess.active_txn_id, txn.base_full_lengths.length(), sess.full_kv.lengths.length(), txn.base_ring_written.length(), sess.ring_kv.total_written.length())
    check_slot_idx(sess.slot_arena_kind.length(), slot_id)
    check_unquantized_slot(sess.slot_kv_quant, slot_id)
    let int kind ← sess.slot_arena_kind[slot_id]
    let int idx ← sess.slot_local_index[slot_id]
    let int p ← pos ↦ int

    if kind ≡ ARENA_FULL_KV {
        require p ≥ 0 and p ≺ C throw variant OutOfBoundsPosition { message = "FullKv position § out of capacity §"(p ↦ string, C ↦ string) }
        require p ≡ sess.full_kv.lengths[idx] throw variant InvalidBranchWrite { message = "FullKv branch write at position § must sequentially append at length §"(p ↦ string, sess.full_kv.lengths[idx] ↦ string) }

        ds.kv_write_row(k, mut sess.full_kv.keys[idx], pos)
        ds.kv_write_row(v, mut sess.full_kv.values[idx], pos)
        sess.full_kv.lengths[idx] ← p + 1
        txn.full_draft_counts[idx] ← txn.full_draft_counts[idx] + 1
        return
    }
    elif kind ≡ ARENA_RING_KV {
        require p ≥ 0 throw variant OutOfBoundsPosition { message = "RingKv position § must be non-negative"(p ↦ string) }
        require p ≡ sess.ring_kv.total_written[idx] throw variant InvalidBranchWrite { message = "RingKv branch write at position § must sequentially append at total_written §"(p ↦ string, sess.ring_kv.total_written[idx] ↦ string) }

        let i32 win ← sess.slot_window_sizes[slot_id] ↦ i32 ⊥ 0
        ds.kv_ring_write_row(k, mut sess.ring_kv.keys[idx], pos, win)
        ds.kv_ring_write_row(v, mut sess.ring_kv.values[idx], pos, win)
        sess.ring_kv.total_written[idx] ← p + 1
        txn.ring_draft_counts[idx] ← txn.ring_draft_counts[idx] + 1
        mut tensor<f32, [KVD]> jk ← copy k
        mut tensor<f32, [KVD]> jv ← copy v
        txn.ring_journal_local_idx.append(idx)
        txn.ring_journal_pos.append(pos)
        txn.ring_journal_k.append(jk)
        txn.ring_journal_v.append(jv)
        return
    }

    throw variant SlotArenaMismatch { message = "slot § is not a KV arena"(slot_id ↦ string) }
}

fn txn_restore_ring<size C, size W, size KVD>(mut SessionState<size C, size W, size KVD> sess, SessionTxn<size C, size W, size KVD> txn) → void {
    for exclusive sess.ring_kv.keys.length() let i {
        mut tensor<f32, [W, KVD]> kc ← copy txn.base_ring_keys[i]
        mut tensor<f32, [W, KVD]> vc ← copy txn.base_ring_values[i]
        sess.ring_kv.keys[i] ← kc
        sess.ring_kv.values[i] ← vc
    }
}

@ public
fn commit_prefix<size C, size W, size KVD>(mut SessionState<size C, size W, size KVD> sess, mut SessionTxn<size C, size W, size KVD> txn, int accepted_count) → void ⇥ SessionError {
    check_txn_ids(txn.open, txn.session_id, sess.session_id, sess.txn_depth, txn.txn_id, sess.active_txn_id, txn.base_full_lengths.length(), sess.full_kv.lengths.length(), txn.base_ring_written.length(), sess.ring_kv.total_written.length())
    require accepted_count ≥ 0 throw variant InvalidCommitCount { message = "accepted count must be non-negative" }

    mut bool any_touched ← false
    for exclusive txn.full_draft_counts.length() let i {
        let int n ← txn.full_draft_counts[i]
        if n ≻ 0 {
            any_touched ← true
            require accepted_count ≤ n throw variant InvalidCommitCount { message = "accepted count § exceeds the § branched writes recorded for FullKv slot §"(accepted_count ↦ string, n ↦ string, i ↦ string) }
        }
    }
    for exclusive txn.ring_draft_counts.length() let i {
        let int n ← txn.ring_draft_counts[i]
        if n ≻ 0 {
            any_touched ← true
            require accepted_count ≤ n throw variant InvalidCommitCount { message = "accepted count § exceeds the § branched writes recorded for RingKv slot §"(accepted_count ↦ string, n ↦ string, i ↦ string) }
        }
    }
    if accepted_count ≻ 0 {
        require any_touched throw variant InvalidCommitCount { message = "accepted count § cannot be committed when no writes were drafted"(accepted_count ↦ string) }
    }

    txn_restore_ring(mut sess, txn)
    if accepted_count ≻ 0 {
        mut list<int> replayed ← empty
        for exclusive sess.ring_kv.keys.length() let i {
            replayed.append(0)
        }
        for exclusive txn.ring_journal_local_idx.length() let i {
            let int idx ← txn.ring_journal_local_idx[i]
            replayed[idx] ← replayed[idx] + 1
            if replayed[idx] ≤ accepted_count {
                let i32 win ← sess.ring_kv.window_sizes[idx] ↦ i32 ⊥ 0
                ds.kv_ring_write_row(txn.ring_journal_k[i], mut sess.ring_kv.keys[idx], txn.ring_journal_pos[i], win)
                ds.kv_ring_write_row(txn.ring_journal_v[i], mut sess.ring_kv.values[idx], txn.ring_journal_pos[i], win)
            }
        }
    }

    for exclusive sess.full_kv.lengths.length() let i {
        if txn.full_draft_counts[i] ≻ 0 {
            sess.full_kv.lengths[i] ← txn.base_full_lengths[i] + accepted_count
        }
        else {
            sess.full_kv.lengths[i] ← txn.base_full_lengths[i]
        }
    }
    for exclusive sess.ring_kv.total_written.length() let i {
        if txn.ring_draft_counts[i] ≻ 0 {
            sess.ring_kv.total_written[i] ← txn.base_ring_written[i] + accepted_count
        }
        else {
            sess.ring_kv.total_written[i] ← txn.base_ring_written[i]
        }
    }

    txn.open ← false
    sess.txn_depth ← 0
    sess.active_txn_id ← 0
}

@ public
fn rollback<size C, size W, size KVD>(mut SessionState<size C, size W, size KVD> sess, mut SessionTxn<size C, size W, size KVD> txn) → void ⇥ SessionError {
    check_txn_ids(txn.open, txn.session_id, sess.session_id, sess.txn_depth, txn.txn_id, sess.active_txn_id, txn.base_full_lengths.length(), sess.full_kv.lengths.length(), txn.base_ring_written.length(), sess.ring_kv.total_written.length())

    txn_restore_ring(mut sess, txn)
    for exclusive sess.full_kv.lengths.length() let i {
        sess.full_kv.lengths[i] ← txn.base_full_lengths[i]
    }
    for exclusive sess.ring_kv.total_written.length() let i {
        sess.ring_kv.total_written[i] ← txn.base_ring_written[i]
    }

    txn.open ← false
    sess.txn_depth ← 0
    sess.active_txn_id ← 0
}

fn find_arena_slot(list<int> slot_ids, int slot_id) → int ⇥ SessionError {
    for exclusive slot_ids.length() let i {
        if slot_ids[i] ≡ slot_id then return i
    }

    throw variant SlotArenaMismatch { message = "slot § is not in this KV arena"(slot_id ↦ string) }
}

@ public
fn score_full<size C, size KVD, size H, size QD>(FullKvArena<size C, size KVD> arena, int slot_id, tensor<f32, [H, C]> dom, tensor<f32, [QD]> q, mut tensor<f32, [H, C]> sc, i32 pos, i32 group, i32 dh, f32 scale) → void ⇥ SessionError {
    let int idx ← find_arena_slot(arena.slot_ids, slot_id)
    let int p ← pos ↦ int
    require p ≥ 0 and p ≺ arena.lengths[idx] throw variant OutOfBoundsPosition { message = "score_full pos § outside active length [0..§)"(p ↦ string, arena.lengths[idx] ↦ string) }
    let tensor<f32, [C, KVD]> kc ← arena.keys[idx]
    ds.attn_scores(dom, q, kc, mut sc, pos, group, dh, scale)
}

@ public
fn context_full<size C, size KVD, size H, size QD>(FullKvArena<size C, size KVD> arena, int slot_id, tensor<f32, [QD]> dom, tensor<f32, [H, C]> probs, mut tensor<f32, [QD]> ctx, i32 pos, i32 group, i32 dh) → void ⇥ SessionError {
    let int idx ← find_arena_slot(arena.slot_ids, slot_id)
    let int p ← pos ↦ int
    require p ≥ 0 and p ≺ arena.lengths[idx] throw variant OutOfBoundsPosition { message = "context_full pos § outside active length [0..§)"(p ↦ string, arena.lengths[idx] ↦ string) }
    let tensor<f32, [C, KVD]> vc ← arena.values[idx]
    ds.attn_context(dom, probs, vc, mut ctx, pos, group, dh)
}

@ public
fn score_ring<size W, size KVD, size H, size QD>(RingKvArena<size W, size KVD> arena, int slot_id, tensor<f32, [H, W]> dom, tensor<f32, [QD]> q, mut tensor<f32, [H, W]> sc, i32 pos, i32 group, i32 dh, f32 scale) → void ⇥ SessionError {
    let int idx ← find_arena_slot(arena.slot_ids, slot_id)
    let int p ← pos ↦ int
    require p ≥ 0 and p ≺ arena.total_written[idx] throw variant OutOfBoundsPosition { message = "score_ring pos § outside written length [0..§)"(p ↦ string, arena.total_written[idx] ↦ string) }
    let i32 win ← arena.window_sizes[idx] ↦ i32 ⊥ 0
    let tensor<f32, [W, KVD]> kc ← arena.keys[idx]
    ds.attn_scores_ring(dom, q, kc, mut sc, pos, win, group, dh, scale)
}

@ public
fn context_ring<size W, size KVD, size H, size QD>(RingKvArena<size W, size KVD> arena, int slot_id, tensor<f32, [QD]> dom, tensor<f32, [H, W]> probs, mut tensor<f32, [QD]> ctx, i32 pos, i32 group, i32 dh) → void ⇥ SessionError {
    let int idx ← find_arena_slot(arena.slot_ids, slot_id)
    let int p ← pos ↦ int
    require p ≥ 0 and p ≺ arena.total_written[idx] throw variant OutOfBoundsPosition { message = "context_ring pos § outside written length [0..§)"(p ↦ string, arena.total_written[idx] ↦ string) }
    let i32 win ← arena.window_sizes[idx] ↦ i32 ⊥ 0
    let tensor<f32, [W, KVD]> vc ← arena.values[idx]
    ds.attn_context_ring(dom, probs, vc, mut ctx, pos, win, group, dh)
}

# Active-prefix / active-span equality helper ignoring inactive tail rows
# `[length..C)` left behind by zero-copy FullKv cursor rollback.
@ public
fn active_rows_equal<size C, size W, size KVD>(SessionState<size C, size W, size KVD> a, SessionState<size C, size W, size KVD> b, f32 tol) → bool ⇥ SessionError {
    if a.full_kv.slot_ids.length() ≢ b.full_kv.slot_ids.length() then return false
    for exclusive a.full_kv.slot_ids.length() let i {
        if a.full_kv.slot_ids[i] ≢ b.full_kv.slot_ids[i] then return false
        let int la ← a.full_kv.lengths[i]
        let int lb ← b.full_kv.lengths[i]
        if la ≢ lb then return false
        let tensor<f32, [C, KVD]> ka ← a.full_kv.keys[i]
        let tensor<f32, [C, KVD]> kb ← b.full_kv.keys[i]
        let tensor<f32, [C, KVD]> va ← a.full_kv.values[i]
        let tensor<f32, [C, KVD]> vb ← b.full_kv.values[i]
        for exclusive la let r {
            for exclusive KVD let c {
                if (ka[[r, c]] - kb[[r, c]]).abs() ≻ tol then return false
                if (va[[r, c]] - vb[[r, c]]).abs() ≻ tol then return false
            }
        }
    }
    if a.ring_kv.slot_ids.length() ≢ b.ring_kv.slot_ids.length() then return false
    for exclusive a.ring_kv.slot_ids.length() let i {
        if a.ring_kv.slot_ids[i] ≢ b.ring_kv.slot_ids[i] then return false
        let int wa ← a.ring_kv.total_written[i]
        let int wb ← b.ring_kv.total_written[i]
        if wa ≢ wb then return false
        let int win_a ← a.ring_kv.window_sizes[i]
        let int win_b ← b.ring_kv.window_sizes[i]
        if win_a ≢ win_b then return false
        let ValidSpan sp ← ring_span(wa, win_a)
        let tensor<f32, [W, KVD]> ka ← a.ring_kv.keys[i]
        let tensor<f32, [W, KVD]> kb ← b.ring_kv.keys[i]
        let tensor<f32, [W, KVD]> va ← a.ring_kv.values[i]
        let tensor<f32, [W, KVD]> vb ← b.ring_kv.values[i]
        for range sp.start_pos ‥ sp.end_pos let p {
            let int slot ← ring_slot(p, win_a)
            for exclusive KVD let c {
                if (ka[[slot, c]] - kb[[slot, c]]).abs() ≻ tol then return false
                if (va[[slot, c]] - vb[[slot, c]]).abs() ≻ tol then return false
            }
        }
    }
    return true
}

@ public
fn softmax_full<size H, size C>(tensor<f32, [H, C]> sc, mut tensor<f32, [H, C]> probs) → void {
    ds.row_softmax(sc, mut probs)
}

@ public
fn softmax_ring<size H, size W>(tensor<f32, [H, W]> sc, mut tensor<f32, [H, W]> probs) → void {
    ds.row_softmax(sc, mut probs)
}

+++ faber test
import from "gradus:cache/session" let session
import from "gradus:model/schedule" let model_schedule

fn close(f32 a, f32 b) → bool {
    return (a - b).abs() ≺ 0.0001
}

fn mk_dense_sched(int layers) → model_schedule.ExecutionSchedule {
    do {
        return model_schedule.dense_schedule(layers, variant model_schedule.RopeKind.Standard, variant model_schedule.FfnKind.Dense, [])
    }
    catch err {
        assert false
        return model_schedule.ExecutionSchedule { layers = [], segments = [], steps = [], slots = [], residual = variant model_schedule.ResidualKind.Standard, taps = [] }
    }
}

fn mk_hybrid_flint_sched() → model_schedule.ExecutionSchedule {
    # Hybrid FullKv + RingKv(513) schedule (Slice B0 Flint pattern)
    let list<model_schedule.AttentionKind> attns ← [
        variant model_schedule.AttentionKind.SlidingWindow { window = 513 },
        variant model_schedule.AttentionKind.Full,
        variant model_schedule.AttentionKind.SlidingWindow { window = 513 }
    ]
    let list<model_schedule.RopeKind> ropes ← [
        variant model_schedule.RopeKind.Standard,
        variant model_schedule.RopeKind.None,
        variant model_schedule.RopeKind.Standard
    ]
    do {
        return model_schedule.patterned_schedule(attns, ropes, 2, [])
    }
    catch err {
        assert false
        return model_schedule.ExecutionSchedule { layers = [], segments = [], steps = [], slots = [], residual = variant model_schedule.ResidualKind.Standard, taps = [] }
    }
}

fn mk_small_ring_sched() → model_schedule.ExecutionSchedule {
    let list<model_schedule.AttentionKind> attns ← [
        variant model_schedule.AttentionKind.SlidingWindow { window = 8 },
        variant model_schedule.AttentionKind.SlidingWindow { window = 8 }
    ]
    let list<model_schedule.RopeKind> ropes ← [
        variant model_schedule.RopeKind.Standard,
        variant model_schedule.RopeKind.Standard
    ]
    do {
        return model_schedule.patterned_schedule(attns, ropes, 1, [])
    }
    catch err {
        assert false
        return model_schedule.ExecutionSchedule { layers = [], segments = [], steps = [], slots = [], residual = variant model_schedule.ResidualKind.Standard, taps = [] }
    }
}

fn fill_row(mut tensor<f32, [4]> row, int p) → void {
    for exclusive 4 let j {
        row[[j]] ← (p * 10 + j + 1) ↦ f32
    }
}

test "SessionState Slice A dense FullKvArena (30 slots, SmolLM2-135M shape)" {
    let model_schedule.ExecutionSchedule sched ← mk_dense_sched(30)
    do {
        mut session.SessionState<8, 1, 4> sess ← session.from_dense_schedule<size 8, size 4>(sched)
        assert sess.full_kv.slot_ids.length() ≡ 30
        assert sess.ring_kv.slot_ids.length() ≡ 0

        mut tensor<f32, [4]> k0 ← tf32[4] {}
        mut tensor<f32, [4]> v0 ← tf32[4] {}
        for exclusive 4 let j {
            k0[[j]] ← (j + 1) ↦ f32
            v0[[j]] ← ((j + 1) * 10) ↦ f32
        }

        session.write_kv(mut sess, 0, k0, v0, 0 ∷ i32)
        session.write_kv(mut sess, 29, k0, v0, 2 ∷ i32)

        let session.ValidSpan sp0 ← session.slot_valid_span(sess, 0)
        assert sp0.start_pos ≡ 0
        assert sp0.end_pos ≡ 1
        assert sp0.valid_count ≡ 1

        let session.ValidSpan sp29 ← session.slot_valid_span(sess, 29)
        assert sp29.end_pos ≡ 3
        assert sp29.write_slot ≡ 2

        let tensor<f32, [1, 8]> dom ← tf32[1, 8] {}
        let tensor<f32, [4]> q ← k0
        mut tensor<f32, [1, 8]> sc ← tf32[1, 8] {}
        session.score_full(sess.full_kv, 0, dom, q, mut sc, 0 ∷ i32, 1 ∷ i32, 4 ∷ i32, 0.5 ∷ f32)
        assert close(sc[[0, 0]], 15.0)
        assert sc[[0, 1]] ≺ -1.0e30

        mut tensor<f32, [1, 8]> pr ← tf32[1, 8] {}
        session.softmax_full(sc, mut pr)
        let tensor<f32, [4]> cdom ← tf32[4] {}
        mut tensor<f32, [4]> ctx ← tf32[4] {}
        session.context_full(sess.full_kv, 0, cdom, pr, mut ctx, 0 ∷ i32, 1 ∷ i32, 4 ∷ i32)
        assert close(ctx[[0]], 10.0)
        assert close(ctx[[3]], 40.0)
    }
    catch err {
        assert false
    }
}

test "SessionState hybrid FullKvArena + RingKvArena(513) wraparound and windowed attention" {
    let model_schedule.ExecutionSchedule sched ← mk_hybrid_flint_sched()
    do {
        mut session.SessionState<16, 513, 4> sess ← session.from_schedule<size 16, size 513, size 4>(sched)
        assert sess.full_kv.slot_ids.length() ≡ 1
        assert sess.ring_kv.slot_ids.length() ≡ 2
        assert sess.ring_kv.window_sizes[0] ≡ 513

        mut tensor<f32, [4]> k_a ← tf32[4] {}
        mut tensor<f32, [4]> v_a ← tf32[4] {}
        mut tensor<f32, [4]> k_b ← tf32[4] {}
        mut tensor<f32, [4]> v_b ← tf32[4] {}
        for exclusive 4 let j {
            k_a[[j]] ← 1.0
            v_a[[j]] ← 2.0
            k_b[[j]] ← 3.0
            v_b[[j]] ← 4.0
        }

        session.write_kv(mut sess, 0, k_a, v_a, 0 ∷ i32)
        session.write_kv(mut sess, 0, k_a, v_a, 512 ∷ i32)
        session.write_kv(mut sess, 0, k_b, v_b, 513 ∷ i32)

        let session.ValidSpan sp ← session.slot_valid_span(sess, 0)
        assert sp.start_pos ≡ 1
        assert sp.end_pos ≡ 514
        assert sp.valid_count ≡ 513
        assert sp.write_slot ≡ 0

        let session.ValidSpan sp1025 ← session.ring_span(1027, 1025)
        assert sp1025.start_pos ≡ 2
        assert sp1025.valid_count ≡ 1025
        assert sp1025.write_slot ≡ 1

        let tensor<f32, [1, 513]> rdom ← tf32[1, 513] {}
        let tensor<f32, [4]> q ← k_a
        mut tensor<f32, [1, 513]> rsc ← tf32[1, 513] {}
        session.score_ring(sess.ring_kv, 0, rdom, q, mut rsc, 513 ∷ i32, 1 ∷ i32, 4 ∷ i32, 0.5 ∷ f32)
        assert close(rsc[[0, 0]], 6.0)
        assert close(rsc[[0, 512]], 2.0)

        mut tensor<f32, [1, 513]> rpr ← tf32[1, 513] {}
        session.softmax_ring(rsc, mut rpr)
        let tensor<f32, [4]> cdom ← tf32[4] {}
        mut tensor<f32, [4]> rctx ← tf32[4] {}
        session.context_ring(sess.ring_kv, 0, cdom, rpr, mut rctx, 513 ∷ i32, 1 ∷ i32, 4 ∷ i32)
        assert rctx[[0]] ≻ 1.7 and rctx[[0]] ≺ 1.85
    }
    catch err {
        assert false
    }
}

test "SessionState branch rollback restores wraparound RingKvArena bit-for-bit" {
    let model_schedule.ExecutionSchedule sched ← mk_small_ring_sched()
    do {
        mut session.SessionState<4, 8, 4> sess ← session.from_schedule<size 4, size 8, size 4>(sched)
        assert sess.ring_kv.slot_ids.length() ≡ 2

        mut tensor<f32, [4]> k ← tf32[4] {}
        mut tensor<f32, [4]> v ← tf32[4] {}

        for exclusive 6 let p {
            fill_row(mut k, p)
            for exclusive 4 let j {
                v[[j]] ← ((p * 10 + j + 1) ↦ f32) * 0.5
            }
            session.write_kv(mut sess, 0, k, v, p ↦ i32 ⊥ 0)
        }
        assert sess.ring_kv.total_written[0] ≡ 6

        mut session.SessionTxn<4, 8, 4> txn ← session.branch(mut sess)
        for exclusive 4 let step {
            fill_row(mut k, 6 + step)
            for exclusive 4 let j {
                v[[j]] ← (((6 + step) * 10 + j + 1) ↦ f32) * 0.5
            }
            session.txn_write_kv(mut sess, mut txn, 0, k, v, (6 + step) ↦ i32 ⊥ 0)
        }
        assert sess.ring_kv.total_written[0] ≡ 10

        session.rollback(mut sess, mut txn)

        assert sess.ring_kv.total_written[0] ≡ 6
        let session.ValidSpan sp ← session.slot_valid_span(sess, 0)
        assert sp.start_pos ≡ 0
        assert sp.valid_count ≡ 6
        for exclusive 8 let slot {
            for exclusive 4 let j {
                mut f32 want ← 0.0
                mut f32 wantv ← 0.0
                if slot ≺ 6 {
                    want ← ((slot * 10 + j + 1) ↦ f32)
                    wantv ← ((slot * 10 + j + 1) ↦ f32) * 0.5
                }
                assert close(sess.ring_kv.keys[0][[slot, j]], want)
                assert close(sess.ring_kv.values[0][[slot, j]], wantv)
            }
        }
    }
    catch err {
        assert false
    }
}

test "SessionState commit_prefix advances m of k across wraparound including k exceeding window" {
    let model_schedule.ExecutionSchedule sched ← mk_small_ring_sched()
    do {
        mut session.SessionState<4, 8, 4> sess ← session.from_schedule<size 4, size 8, size 4>(sched)
        mut tensor<f32, [4]> k ← tf32[4] {}
        mut tensor<f32, [4]> v ← tf32[4] {}

        for exclusive 6 let p {
            fill_row(mut k, p)
            for exclusive 4 let j {
                v[[j]] ← ((p * 10 + j + 1) ↦ f32) * 0.5
            }
            session.write_kv(mut sess, 0, k, v, p ↦ i32 ⊥ 0)
        }

        mut session.SessionTxn<4, 8, 4> txn ← session.branch(mut sess)
        # Draft 10 candidates (exceeding window 8) at positions 6..15.
        for exclusive 10 let step {
            fill_row(mut k, 6 + step)
            for exclusive 4 let j {
                v[[j]] ← (((6 + step) * 10 + j + 1) ↦ f32) * 0.5
            }
            session.txn_write_kv(mut sess, mut txn, 0, k, v, (6 + step) ↦ i32 ⊥ 0)
        }

        session.commit_prefix(mut sess, mut txn, 3)

        assert sess.ring_kv.total_written[0] ≡ 9
        let session.ValidSpan sp ← session.slot_valid_span(sess, 0)
        assert sp.start_pos ≡ 1
        assert sp.valid_count ≡ 8

        # Accepted positions 6, 7, 8 -> slots 6, 7, 0; pre-branch live rows
        # in slots 1..5 are restored bit-for-bit despite k=10 wrapping over them.
        for exclusive 4 let j {
            assert close(sess.ring_kv.keys[0][[6, j]], (60 + j + 1) ↦ f32)
            assert close(sess.ring_kv.keys[0][[7, j]], (70 + j + 1) ↦ f32)
            assert close(sess.ring_kv.keys[0][[0, j]], (80 + j + 1) ↦ f32)
            assert close(sess.ring_kv.keys[0][[1, j]], (10 + j + 1) ↦ f32)
            assert close(sess.ring_kv.keys[0][[5, j]], (50 + j + 1) ↦ f32)
        }

        # commit_prefix(0) is equivalent to rollback.
        mut session.SessionTxn<4, 8, 4> txn2 ← session.branch(mut sess)
        fill_row(mut k, 20)
        session.txn_write_kv(mut sess, mut txn2, 0, k, v, 9 ∷ i32)
        session.commit_prefix(mut sess, mut txn2, 0)
        assert sess.ring_kv.total_written[0] ≡ 9
        assert close(sess.ring_kv.keys[0][[1, 0]], 11.0)
    }
    catch err {
        assert false
    }
}

test "SessionState transactions are atomic across FullKvArena, RingKvArena, and KvQuantConfig" {
    let model_schedule.ExecutionSchedule sched ← mk_hybrid_flint_sched()
    do {
        mut session.SessionState<16, 513, 4> sess ← session.from_schedule<size 16, size 513, size 4>(sched)
        let session.KvQuantConfig kvq ← session.KvQuantConfig { key_bits = 8, value_bits = 8, group_size = 64, enabled = false }
        session.set_slot_kv_quant(mut sess, 1, kvq)
        assert sess.slot_kv_quant[1].key_bits ≡ 8
        assert sess.slot_kv_quant[1].enabled ≡ false

        mut tensor<f32, [4]> k ← tf32[4] {}
        mut tensor<f32, [4]> v ← tf32[4] {}
        for exclusive 4 let j {
            k[[j]] ← 1.0
            v[[j]] ← 2.0
        }

        mut session.SessionTxn<16, 513, 4> txn ← session.branch(mut sess)
        session.txn_write_kv(mut sess, mut txn, 1, k, v, 0 ∷ i32)
        session.txn_write_kv(mut sess, mut txn, 0, k, v, 0 ∷ i32)
        session.rollback(mut sess, mut txn)
        assert sess.full_kv.lengths[0] ≡ 0
        assert sess.ring_kv.total_written[0] ≡ 0

        mut session.SessionTxn<16, 513, 4> txn2 ← session.branch(mut sess)
        session.txn_write_kv(mut sess, mut txn2, 1, k, v, 0 ∷ i32)
        session.txn_write_kv(mut sess, mut txn2, 0, k, v, 0 ∷ i32)
        session.txn_write_kv(mut sess, mut txn2, 1, k, v, 1 ∷ i32)
        session.txn_write_kv(mut sess, mut txn2, 0, k, v, 1 ∷ i32)
        session.commit_prefix(mut sess, mut txn2, 2)
        assert sess.full_kv.lengths[0] ≡ 2
        assert sess.ring_kv.total_written[0] ≡ 2
    }
    catch err {
        assert false
    }
}

test "SessionState rejects TxnOpen, NoOpenTxn, and empty-journal commit_prefix" {
    let model_schedule.ExecutionSchedule sched ← mk_small_ring_sched()
    do {
        mut session.SessionState<4, 8, 4> sess ← session.from_schedule<size 4, size 8, size 4>(sched)
        mut tensor<f32, [4]> k ← tf32[4] {}
        mut tensor<f32, [4]> v ← tf32[4] {}
        for exclusive 4 let j {
            k[[j]] ← 1.0
            v[[j]] ← 2.0
        }

        mut session.SessionTxn<4, 8, 4> txn ← session.branch(mut sess)

        do {
            session.write_kv(mut sess, 0, k, v, 0 ∷ i32)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.TxnOpen let ? {
                }
                case _ {
                    assert false
                }
            }
        }

        do {
            let session.SessionTxn<4, 8, 4> nested ← session.branch(mut sess)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.TxnOpen let ? {
                }
                case _ {
                    assert false
                }
            }
        }

        # Empty-journal commit_prefix(1) fails closed.
        do {
            session.commit_prefix(mut sess, mut txn, 1)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.InvalidCommitCount let ? {
                }
                case _ {
                    assert false
                }
            }
        }

        session.rollback(mut sess, mut txn)

        # Post-close operations reject with NoOpenTxn.
        do {
            session.txn_write_kv(mut sess, mut txn, 0, k, v, 0 ∷ i32)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.NoOpenTxn let ? {
                }
                case _ {
                    assert false
                }
            }
        }

        session.write_kv(mut sess, 0, k, v, 0 ∷ i32)
        assert sess.ring_kv.total_written[0] ≡ 1
    }
    catch err {
        assert false
    }
}

test "SessionState enforces sequential append on FullKv and RingKv branch writes" {
    let model_schedule.ExecutionSchedule sched ← mk_hybrid_flint_sched()
    do {
        mut session.SessionState<4, 513, 4> sess ← session.from_schedule<size 4, size 513, size 4>(sched)
        mut tensor<f32, [4]> k ← tf32[4] {}
        mut tensor<f32, [4]> v ← tf32[4] {}
        for exclusive 4 let j {
            k[[j]] ← 1.0
            v[[j]] ← 2.0
        }

        session.write_kv(mut sess, 1, k, v, 0 ∷ i32)
        session.write_kv(mut sess, 0, k, v, 0 ∷ i32)
        mut session.SessionTxn<4, 513, 4> txn ← session.branch(mut sess)

        # Rewrite at pos 0 (< length 1) on FullKv rejects.
        do {
            session.txn_write_kv(mut sess, mut txn, 1, k, v, 0 ∷ i32)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.InvalidBranchWrite let ? {
                }
                case _ {
                    assert false
                }
            }
        }

        # Gap write at pos 2 (> length 1) on FullKv rejects.
        do {
            session.txn_write_kv(mut sess, mut txn, 1, k, v, 2 ∷ i32)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.InvalidBranchWrite let ? {
                }
                case _ {
                    assert false
                }
            }
        }

        # Non-sequential write at pos 2 on RingKv rejects.
        do {
            session.txn_write_kv(mut sess, mut txn, 0, k, v, 2 ∷ i32)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.InvalidBranchWrite let ? {
                }
                case _ {
                    assert false
                }
            }
        }

        session.txn_write_kv(mut sess, mut txn, 1, k, v, 1 ∷ i32)
        session.txn_write_kv(mut sess, mut txn, 0, k, v, 1 ∷ i32)
        session.commit_prefix(mut sess, mut txn, 1)
        assert sess.full_kv.lengths[0] ≡ 2
        assert sess.ring_kv.total_written[0] ≡ 2
    }
    catch err {
        assert false
    }
}

test "SessionState dense-only branch and commit over a ring-free schedule" {
    let model_schedule.ExecutionSchedule sched ← mk_dense_sched(2)
    do {
        mut session.SessionState<4, 1, 4> sess ← session.from_dense_schedule<size 4, size 4>(sched)
        assert sess.ring_kv.slot_ids.length() ≡ 0
        mut tensor<f32, [4]> k ← tf32[4] {}
        mut tensor<f32, [4]> v ← tf32[4] {}
        for exclusive 4 let j {
            k[[j]] ← 1.0
            v[[j]] ← 2.0
        }

        mut session.SessionTxn<4, 1, 4> txn ← session.branch(mut sess)
        session.txn_write_kv(mut sess, mut txn, 0, k, v, 0 ∷ i32)
        session.txn_write_kv(mut sess, mut txn, 1, k, v, 0 ∷ i32)
        session.rollback(mut sess, mut txn)
        assert sess.full_kv.lengths[0] ≡ 0
        assert sess.full_kv.lengths[1] ≡ 0

        mut session.SessionTxn<4, 1, 4> txn2 ← session.branch(mut sess)
        session.txn_write_kv(mut sess, mut txn2, 0, k, v, 0 ∷ i32)
        session.txn_write_kv(mut sess, mut txn2, 1, k, v, 0 ∷ i32)
        session.commit_prefix(mut sess, mut txn2, 1)
        assert sess.full_kv.lengths[0] ≡ 1
        assert sess.full_kv.lengths[1] ≡ 1
    }
    catch err {
        assert false
    }
}

test "KvQuantConfig.enabled = true fails closed with UnsupportedKvQuant" {
    let model_schedule.ExecutionSchedule sched ← mk_hybrid_flint_sched()
    do {
        mut session.SessionState<16, 513, 4> sess ← session.from_schedule<size 16, size 513, size 4>(sched)
        let session.KvQuantConfig qcfg ← session.KvQuantConfig { key_bits = 4, value_bits = 4, group_size = 32, enabled = true }

        do {
            session.set_slot_kv_quant(mut sess, 1, qcfg)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.UnsupportedKvQuant let ? {
                }
                case _ {
                    assert false
                }
            }
        }

        # Guarded write_kv and branch also reject a quantized slot config.
        sess.slot_kv_quant[1] ← qcfg
        let tensor<f32, [4]> k ← tf32[4] {}
        let tensor<f32, [4]> v ← tf32[4] {}
        do {
            session.write_kv(mut sess, 1, k, v, 0 ∷ i32)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.UnsupportedKvQuant let ? {
                }
                case _ {
                    assert false
                }
            }
        }

        do {
            let session.SessionTxn<16, 513, 4> ? ← session.branch(mut sess)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.UnsupportedKvQuant let ? {
                }
                case _ {
                    assert false
                }
            }
        }
    }
    catch err {
        assert false
    }
}

test "SessionTxn rejects mismatched SessionState with SessionMismatch" {
    let model_schedule.ExecutionSchedule sched ← mk_hybrid_flint_sched()
    do {
        mut session.SessionState<16, 513, 4> sess_a ← session.from_schedule_with_id<size 16, size 513, size 4>(sched, 101)
        mut session.SessionState<16, 513, 4> sess_b ← session.from_schedule_with_id<size 16, size 513, size 4>(sched, 202)

        mut session.SessionTxn<16, 513, 4> txn_a ← session.branch(mut sess_a)
        mut session.SessionTxn<16, 513, 4> txn_b ← session.branch(mut sess_b)

        let tensor<f32, [4]> k ← tf32[4] {}
        let tensor<f32, [4]> v ← tf32[4] {}

        do {
            session.txn_write_kv(mut sess_b, mut txn_a, 1, k, v, 0 ∷ i32)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.SessionMismatch let ? {
                }
                case _ {
                    assert false
                }
            }
        }

        do {
            session.commit_prefix(mut sess_b, mut txn_a, 0)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.SessionMismatch let ? {
                }
                case _ {
                    assert false
                }
            }
        }

        do {
            session.rollback(mut sess_a, mut txn_b)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.SessionMismatch let ? {
                }
                case _ {
                    assert false
                }
            }
        }

        session.rollback(mut sess_a, mut txn_a)
        session.rollback(mut sess_b, mut txn_b)
    }
    catch err {
        assert false
    }
}

test "FullKvArena rollback compares only active [0..length) rows and masks stale draft tail" {
    let model_schedule.ExecutionSchedule sched ← mk_dense_sched(1)
    do {
        mut session.SessionState<8, 1, 4> sess ← session.from_dense_schedule<size 8, size 4>(sched)
        mut session.SessionState<8, 1, 4> baseline ← session.from_dense_schedule<size 8, size 4>(sched)

        mut tensor<f32, [4]> k0 ← tf32[4] {}
        mut tensor<f32, [4]> v0 ← tf32[4] {}
        for exclusive 4 let j {
            k0[[j]] ← (j + 1) ↦ f32
            v0[[j]] ← ((j + 1) * 10) ↦ f32
        }
        session.write_kv(mut sess, 0, k0, v0, 0 ∷ i32)
        session.write_kv(mut baseline, 0, k0, v0, 0 ∷ i32)

        mut tensor<f32, [4]> draft_k ← tf32[4] {}
        mut tensor<f32, [4]> draft_v ← tf32[4] {}
        for exclusive 4 let j {
            draft_k[[j]] ← 99.0
            draft_v[[j]] ← -77.0
        }

        mut session.SessionTxn<8, 1, 4> txn ← session.branch(mut sess)
        session.txn_write_kv(mut sess, mut txn, 0, draft_k, draft_v, 1 ∷ i32)
        session.txn_write_kv(mut sess, mut txn, 0, draft_k, draft_v, 2 ∷ i32)
        session.rollback(mut sess, mut txn)

        # Zero-copy FullKv rollback leaves stale values in [1..3), so raw tensor
        # indexing differs at row 1, while active_rows_equal compares only [0..1).
        assert close(sess.full_kv.keys[0][[1, 0]], 99.0)
        assert session.active_rows_equal(sess, baseline, 0.0001)

        # Scoring at active pos 0 masks [1..8) despite stale draft rows, and
        # accessing rolled-back pos 1 fails closed.
        let tensor<f32, [1, 8]> dom ← tf32[1, 8] {}
        mut tensor<f32, [1, 8]> sc ← tf32[1, 8] {}
        session.score_full(sess.full_kv, 0, dom, k0, mut sc, 0 ∷ i32, 1 ∷ i32, 4 ∷ i32, 0.5 ∷ f32)
        assert close(sc[[0, 0]], 15.0)
        assert sc[[0, 1]] ≺ -1.0e30

        mut tensor<f32, [1, 8]> pr ← tf32[1, 8] {}
        session.softmax_full(sc, mut pr)
        let tensor<f32, [4]> cdom ← tf32[4] {}
        mut tensor<f32, [4]> ctx ← tf32[4] {}
        session.context_full(sess.full_kv, 0, cdom, pr, mut ctx, 0 ∷ i32, 1 ∷ i32, 4 ∷ i32)
        assert close(ctx[[0]], 10.0)

        do {
            session.score_full(sess.full_kv, 0, dom, k0, mut sc, 1 ∷ i32, 1 ∷ i32, 4 ∷ i32, 0.5 ∷ f32)
            assert false
        }
        catch err {
            match err {
                case session.SessionError.OutOfBoundsPosition let ? {
                }
                case _ {
                    assert false
                }
            }
        }
    }
    catch err {
        assert false
    }
}
