+++
locale = "en"
+++
# Focused proof for structure-to-cache representation propagation.

import from "gradus:cache/kv" kv
import from "gradus:cache/structure" structure
import from "gradus:storage" storage
import from "gradus:test_util" test_util

fn layer_p() → structure.LayerSet {
    return test_util.or_default(() → structure.LayerSet ⇥ kv.CacheError ∴ structure.construct_layer_set([0, 1], structure.dense_structure(), 2, 16), structure.default_layer_set())
}

fn structure_p() → structure.KVStructure {
    var list<structure.LayerSet> layers ← empty
    layers.append(layer_p())
    return test_util.or_default(() → structure.KVStructure ⇥ kv.CacheError ∴ structure.construct_kv_structure_with_representations(layers, kv.representation_q8_0(), kv.block_q8_0(), kv.representation_f16(), kv.block_f16(), structure.v_layout_transposed(), structure.sharing_gqa(), structure.attention_classic(), 4, 1, 8), structure.default_kv_structure())
}

test "KVStructure preserves distinct requested K and V representations" {
    const structure.KVStructure s ← structure_p()
    assert structure.kv_dtype_name(s.kv_dtype_k) ≡ "q8_0"
    assert structure.kv_dtype_name(s.kv_dtype_v) ≡ "f16"
    assert s.key_representation.name ≡ "q8_0"
    assert s.value_representation.name ≡ "f16"
    assert s.key_block.elements_per_block ≡ 32
    assert s.value_block.elements_per_block ≡ 1
}

test "descriptor-first construction retains an open future representation" {
    var list<structure.LayerSet> layers ← empty
    layers.append(layer_p())
    const storage.Representation future ← storage.representation("vendor", "future_blob", "2026", -77)
    const storage.BlockMetadata future_block ← storage.known_block(8, 10, 1, 10)
    const structure.KVStructure s ← test_util.or_default(() → structure.KVStructure ⇥ kv.CacheError ∴ structure.construct_kv_structure_with_representations(layers, future, future_block, kv.representation_f16(), kv.block_f16(), structure.v_layout_transposed(), structure.sharing_gqa(), structure.attention_classic(), 4, 1, 8), structure.default_kv_structure())
    assert s.key_representation.name ≡ "future_blob"
    assert s.key_representation.namespace ≡ "vendor"
    assert s.key_representation.version ≡ "2026"
    assert s.key_representation.code ≡ -77
    assert s.key_block.elements_per_block ≡ 8
    assert structure.kv_dtype_name(s.kv_dtype_k) ≡ "future_blob"
}

test "empty_layers copies both structure representations into every cache" {
    const structure.KVStructure s ← structure_p()
    const list<kv.KVCache> layers ← test_util.or_default(() → list<kv.KVCache> ⇥ kv.CacheError ∴ structure.empty_layers(s, "tiny-mlp", "1.0.0", "causal-rope-d4", "smollm"), ([] ∷ list<kv.KVCache>))
    assert layers.length() ≡ 2
    const kv.KVCache first ← layers.get(0) coalesce kv.default()
    assert first.key_storage.encoded.representation.name ≡ "q8_0"
    assert first.value_storage.encoded.representation.name ≡ "f16"
    assert first.key_storage.shape ≡ ([0, 32] ↦ list<int>)
    assert first.value_storage.shape ≡ ([0, 32] ↦ list<int>)
    assert first.capacity ≡ 8
    assert first.length() ≡ 0
}
