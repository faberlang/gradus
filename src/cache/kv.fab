+++ toml
locale = "en"

+++ faber
# Logical KV-cache values and mutation rules.
#
# Public import: import from "gradus:cache/kv" kv
# Depends on: gradus:dtype, gradus:tensor.
# Owns CacheError.

import from "gradus:dtype"

import from "gradus:storage"

import from "gradus:tensor"

@ public
union CacheError {
    @ shared
    string message

    EmptyName,
    IdOutOfRange,
    ShapeMismatch,
    DtypeMismatch,
    InvalidDimension,
    ElementMismatch,
    UnknownVersion,
    BadWire,
    InvalidCombination,
    Overflow,
    Gap,
    ProfileUnavailable,
    TensorFailure {
        tensor.TensorError inner
    }
}

@ conversion
fn from_tensor_error(tensor.TensorError err) → CacheError {
    return variant TensorFailure { message = err.message, inner = err }
}

# The cache's schema version (the identity wire form).
@ public
const string SCHEMA_VERSION = "1.0.0"

const int MAX_NUMBER = 9223372036854775807

# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# "/" and ";" are reserved in the identity wire fields (the U3 wire-safety
# rule).
fn contains_separator(string s) → bool {
    return s.contains("/") or s.contains(";")
}

# NumericBlock field-wise equality over the VALID region (shape + the
# first numel elements). Decoded F32 row buffers are pre-allocated at
# capacity and shared along a derivation chain, so a view's tail may hold
# rows a later derivation wrote past this view's count; those rows are not
# part of the value.
fn tensor_equal(tensor.NumericBlock a, tensor.NumericBlock b) → bool {
    if not (a.shape ≡ b.shape) then return false

    for exclusive a.numel let i {
        if (a.data.get(i) coalesce 0.0 ∷ f32) ≢ (b.data.get(i) coalesce 0.0 ∷ f32) then return false
    }

    return true
}

fn bytes_equal(list<b8> a, list<b8> b) → bool {
    return a ≡ b
}

# The shared storage contract owns representation identity and block
# geometry. Cache code only adds the logical row shape/count and the decoded
# F32 capability; encoded bytes remain in storage.EncodedStorage.
@ public
fn representation_named(string namespace, string name, string version, int code) → storage.Representation ⇥ CacheError {
    require namespace.length() ≢ 0 throw variant EmptyName { message = "empty cache representation namespace" }

    require name.length() ≢ 0 throw variant EmptyName { message = "empty cache representation name" }

    require version.length() ≢ 0 throw variant EmptyName { message = "empty cache representation version" }

    reject contains_separator(namespace) or contains_separator(name) or contains_separator(version) throw variant EmptyName { message = "reserved wire character in cache representation" }

    return storage.representation(namespace, name, version, code)
}

@ public
fn representation_f32() → storage.Representation {
    return storage.representation("ggml", "f32", "unspecified", 0)
}

@ public
fn representation_f16() → storage.Representation {
    return storage.representation("ggml", "f16", "unspecified", 1)
}

@ public
fn representation_q8_0() → storage.Representation {
    return storage.representation("ggml", "q8_0", "unspecified", 8)
}

@ public
fn representation_q4_k() → storage.Representation {
    return storage.representation("ggml", "q4_k", "unspecified", 12)
}

@ public
fn representation_equal(storage.Representation a, storage.Representation b) → bool {
    if a.namespace ≢ b.namespace then return false

    if a.name ≢ b.name then return false

    if a.version ≢ b.version then return false

    if a.code ≢ b.code then return false

    return true
}

@ public
fn representation_from_name(string name) → storage.Representation ⇥ CacheError {
    switch name {
        case "f32" {
            return representation_f32()
        }
        case "f16" {
            return representation_f16()
        }
        case "q8_0" {
            return representation_q8_0()
        }
        case "q4_k" {
            return representation_q4_k()
        }
        default {
            throw variant DtypeMismatch { message = "unknown cache representation" }
        }
    }
}

@ public
fn block_f32() → storage.BlockMetadata {
    return storage.known_block(1, 4, 1, 4)
}

@ public
fn block_f16() → storage.BlockMetadata {
    return storage.known_block(1, 2, 1, 2)
}

@ public
fn block_q8_0() → storage.BlockMetadata {
    return storage.known_block(32, 34, 1, 34)
}

@ public
fn block_q4_k() → storage.BlockMetadata {
    return storage.known_block(256, 144, 1, 144)
}

@ public
fn block_equal(storage.BlockMetadata a, storage.BlockMetadata b) → bool {
    if a.known ≢ b.known then return false

    if a.elements_per_block ≢ b.elements_per_block then return false

    if a.bytes_per_block ≢ b.bytes_per_block then return false

    if a.block_count ≢ b.block_count then return false

    if a.byte_length ≢ b.byte_length then return false

    return true
}

fn row_bytes(storage.BlockMetadata block, int dimension) → int ⇥ CacheError {
    require dimension ≥ 1 throw variant InvalidDimension { message = "embedding dimension must be at least one" }

    require block.known throw variant InvalidCombination { message = "cache representation has unknown block geometry" }

    require block.elements_per_block ≥ 1 throw variant InvalidDimension { message = "representation block elements must be at least one" }

    require block.bytes_per_block ≥ 1 throw variant InvalidDimension { message = "representation block bytes must be at least one" }

    require dimension % block.elements_per_block ≡ 0 throw variant InvalidCombination { message = "representation block does not divide cache dimension" }

    let int blocks_per_row ← dimension / block.elements_per_block

    require blocks_per_row ≤ MAX_NUMBER / block.bytes_per_block throw variant Overflow { message = "representation row byte count overflow" }

    return blocks_per_row * block.bytes_per_block
}

# A storage identity keeps physical bytes separate from the decoded F32
# consumer carrier. `decoded` is a capability bit, not a dtype tag over a
# list<f32>; packed storage always lives in `encoded.payload`, while the
# shared representation and block metadata live beside those bytes.
@ public
class KVStorage {
    mut storage.EncodedStorage encoded
    mut list<int> shape
    mut int count
    # True only when the decoded F32 NumericBlock carrier is materialized;
    # an encoded F32 cache deliberately leaves this false until decoding.
    mut bool decoded
}

fn storage_block(storage.BlockMetadata template, int dimension, int count) → storage.BlockMetadata ⇥ CacheError {
    # The callers validate the template and dimension through row_bytes before
    # reaching this helper; repeat the arithmetic guards here because this
    # function is also used by every subsequent cache mutation.
    let int blocks_per_row ← dimension / template.elements_per_block

    if count ≢ 0 {
        require count ≤ MAX_NUMBER / blocks_per_row throw variant Overflow { message = "representation block count overflow" }
    }

    let int block_count ← count * blocks_per_row

    if block_count ≡ 0 then return storage.known_block(template.elements_per_block, template.bytes_per_block, 0, 0)

    if block_count ≻ MAX_NUMBER / template.bytes_per_block {
        throw variant Overflow { message = "representation byte count overflow" }
    }

    return storage.known_block(template.elements_per_block, template.bytes_per_block, block_count, block_count * template.bytes_per_block)
}

# Count-parameterized decoded storage: the row metadata for `count` valid
# rows. The decoded F32 row buffers are pre-allocated at capacity; the count
# (not the buffer length) is the logical row extent.
fn decoded_storage_count(storage.Representation representation, storage.BlockMetadata template, int dimension, int count) → KVStorage ⇥ CacheError {
    let storage.BlockMetadata metadata ← storage_block(template, dimension, count)
    return KVStorage { encoded = storage.encoded(||, representation, metadata), shape = [count, dimension], count = count, decoded = representation_equal(representation, representation_f32()) }
}

fn empty_storage(storage.Representation representation, storage.BlockMetadata template, list<int> shape) → KVStorage ⇥ CacheError {
    let storage.BlockMetadata metadata ← storage_block(template, shape.get(1) coalesce 0, 0)
    return KVStorage { encoded = storage.encoded(||, representation, metadata), shape = shape, count = 0, decoded = representation_equal(representation, representation_f32()) }
}

fn encoded_storage(storage.Representation representation, storage.BlockMetadata template, list<b8> payload, list<int> shape, int count) → KVStorage ⇥ CacheError {
    let storage.BlockMetadata metadata ← storage_block(template, shape.get(1) coalesce 0, count)
    return KVStorage { encoded = storage.encoded(payload, representation, metadata), shape = shape, count = count, decoded = false }
}

# -------------------------------------------------------------------------
# KVCache — the typed logical value.
# -------------------------------------------------------------------------

@ public
class KVCache {
    # Model name (identity).
    mut string model
    # Model version (identity).
    mut string model_version
    # Execution configuration tag (identity; carries the RoPE/scale facts).
    mut string config
    # Tokenizer identity (identity).
    mut string tokenizer
    # The exact token history (prefix) appended so far.
    mut list<int> history
    # Layer count of the forward row (the identity's layer field).
    mut int layers
    # Layout tag (identity; "staged").
    mut string layout
    # The cached K tensor: a [count, dimension] VIEW over the pre-allocated
    # fixed-capacity row buffer `key.data` (length capacity * dimension,
    # zero-initialized). Rows past the view count are not part of the value.
    mut tensor.NumericBlock key
    # The cached V tensor: the same view contract over `payload.data`.
    mut tensor.NumericBlock payload
    # Physical storage identities. F32 decoded caches keep the old NumericBlock
    # fields populated; encoded caches keep bytes here and expose explicit
    # decoded-access failures.
    mut KVStorage key_storage
    mut KVStorage value_storage
    # Generation (starts 1; bumps on successful append, extend, or reset).
    mut int version
    # The cached feature width.
    mut int dimension
    # Immutable admission bound copied from KVStructure.context_length.
    mut int capacity
    # True when a derivation already writes rows past this cache's count in
    # its shared row buffers: the next write from this cache must fork onto
    # fresh buffers first (value semantics for branched histories). A pure
    # control bit — never part of cache equality or any wire form.
    mut bool sealed

    # Cached position count (= the history length). Distinct from capacity.
    fn length() → int {
        return self.history.length()
    }
}

@ public
fn key_representation(KVCache c) → storage.Representation {
    return c.key_storage.encoded.representation
}

@ public
fn value_representation(KVCache c) → storage.Representation {
    return c.value_storage.encoded.representation
}

@ public
fn key_block(KVCache c) → storage.BlockMetadata {
    return c.key_storage.encoded.block
}

@ public
fn value_block(KVCache c) → storage.BlockMetadata {
    return c.value_storage.encoded.block
}

@ public
fn decoded_f32(KVCache c) → bool {
    return representation_equal(key_representation(c), representation_f32()) and representation_equal(value_representation(c), representation_f32()) and c.key_storage.decoded and c.value_storage.decoded
}

# Field-wise cache equality — the determinism/round-trip predicate.
# Convert-or-record: this is a small typed pure leaf whose ordered checks span
# heterogeneous fields; no collection intrinsic covers the short-circuit shape.
@ public
fn cache_equal(KVCache a, KVCache b) → bool {
    if a.model ≢ b.model then return false

    if a.model_version ≢ b.model_version then return false

    if a.config ≢ b.config then return false

    if a.tokenizer ≢ b.tokenizer then return false

    if not (a.history ≡ b.history) then return false

    if a.layers ≢ b.layers then return false

    if a.layout ≢ b.layout then return false

    if not tensor_equal(a.key, b.key) then return false

    if not tensor_equal(a.payload, b.payload) then return false

    if not representation_equal(a.key_storage.encoded.representation, b.key_storage.encoded.representation) then return false

    if not representation_equal(a.value_storage.encoded.representation, b.value_storage.encoded.representation) then return false

    if not block_equal(a.key_storage.encoded.block, b.key_storage.encoded.block) then return false

    if not block_equal(a.value_storage.encoded.block, b.value_storage.encoded.block) then return false

    if not (a.key_storage.shape ≡ b.key_storage.shape) then return false

    if not (a.value_storage.shape ≡ b.value_storage.shape) then return false

    if a.key_storage.count ≢ b.key_storage.count then return false

    if a.value_storage.count ≢ b.value_storage.count then return false

    if a.key_storage.decoded ≢ b.key_storage.decoded then return false

    if a.value_storage.decoded ≢ b.value_storage.decoded then return false

    if not bytes_equal(a.key_storage.encoded.payload, b.key_storage.encoded.payload) then return false

    if not bytes_equal(a.value_storage.encoded.payload, b.value_storage.encoded.payload) then return false

    if a.version ≢ b.version then return false

    if a.dimension ≢ b.dimension then return false

    if a.capacity ≢ b.capacity then return false

    return true
}

# Unstructured empty_cache helper bound. Structure-aware construction
# (empty_layers) copies KVStructure.context_length instead.
const int HELPER_CAPACITY = 2048

fn row_count(tensor.NumericBlock t) → int {
    if t.shape.length() ≺ 1 then return 0

    return t.shape.get(0) coalesce 0
}

# Gap and overflow reject before any new rows are assembled.
fn admit_write(KVCache c, int added) → bool ⇥ CacheError {
    let int write_position ← c.length()

    require write_position ≡ c.key_storage.count throw variant Gap { message = "cache write leaves a gap in the key storage" }

    require write_position ≡ c.value_storage.count throw variant Gap { message = "cache write leaves a gap in the value storage" }

    if c.key_storage.decoded {
        require write_position ≡ row_count(c.key) throw variant Gap { message = "cache write leaves a gap in the decoded key" }
    }

    if c.value_storage.decoded {
        require write_position ≡ row_count(c.payload) throw variant Gap { message = "cache write leaves a gap in the decoded value" }
    }

    require write_position + added ≤ c.capacity throw variant Overflow { message = "cache overflow" }

    return true
}

# Pre-allocated fixed-capacity zero row buffer for a decoded F32 cache.
fn capacity_zeros(int capacity, int dimension) → list<f32> {
    let tensor.NumericBlock zeros ← tensor.fill([capacity * dimension], 0.0 ∷ f32) ⊥ tensor.default()
    return zeros.data
}

# Write the new rows ([added, dimension]) IN PLACE into a pre-allocated row
# buffer at write_pos. No history row is read or copied: only the added
# rows move (issue #73 — the per-token full-history fold is gone).
fn write_rows(mut list<f32> buffer, int write_pos, int dimension, tensor.NumericBlock rows) → void {
    let int added ← rows.shape.get(0) coalesce 0

    for exclusive added let r {
        for exclusive dimension let j {
            buffer[(write_pos + r) * dimension + j] ← rows.data.get(r * dimension + j) coalesce 0.0 ∷ f32
        }
    }
}

# Fresh capacity buffer carrying the valid region of `data` (rows
# [0, count)) with zeros past it — the sealed-base fork path. This is the
# only place a valid region is copied, once per branch, never per token.
fn forked_data(list<f32> data, int count, int capacity, int dimension) → list<f32> {
    mut list<f32> out ← empty

    for exclusive count * dimension let i {
        out.append(data.get(i) coalesce 0.0 ∷ f32)
    }

    for exclusive capacity * dimension - count * dimension let i {
        out.append(0.0 ∷ f32)
    }

    return out
}

# Assemble the derived decoded cache over its row buffers at `count` valid
# rows: fresh [count, dimension] view headers (stage_f32 — the producer's
# shape arithmetic is the admission), fresh storage descriptors, and the
# caller's history. The result owns nothing sealed.
fn keep_decoded(KVCache c, list<int> history, list<f32> key_data, list<f32> value_data, int count) → KVCache ⇥ CacheError {
    let list<int> shape ← [count, c.dimension]
    let tensor.NumericBlock key ← tensor.stage_f32(shape, key_data)
    let tensor.NumericBlock payload ← tensor.stage_f32(shape, value_data)
    let KVStorage key_storage ← decoded_storage_count(c.key_storage.encoded.representation, c.key_storage.encoded.block, c.dimension, count)
    let KVStorage value_storage ← decoded_storage_count(c.value_storage.encoded.representation, c.value_storage.encoded.block, c.dimension, count)
    return KVCache { model = c.model, model_version = c.model_version, config = c.config, tokenizer = c.tokenizer, history = history, layers = c.layers, layout = c.layout, key = key, payload = payload, key_storage = key_storage, value_storage = value_storage, version = c.version + 1, dimension = c.dimension, capacity = c.capacity, sealed = false }
}

fn keep_encoded(KVCache c, list<int> history, list<b8> key_bytes, list<b8> value_bytes, int version) → KVCache ⇥ CacheError {
    let list<int> shape ← [history.length(), c.dimension]
    let KVStorage key_storage ← encoded_storage(c.key_storage.encoded.representation, c.key_storage.encoded.block, key_bytes, shape, history.length())
    let KVStorage value_storage ← encoded_storage(c.value_storage.encoded.representation, c.value_storage.encoded.block, value_bytes, shape, history.length())
    let tensor.NumericBlock vacant ← tensor.default()
    return KVCache { model = c.model, model_version = c.model_version, config = c.config, tokenizer = c.tokenizer, history = history, layers = c.layers, layout = c.layout, key = vacant, payload = vacant, key_storage = key_storage, value_storage = value_storage, version = version, dimension = c.dimension, capacity = c.capacity, sealed = false }
}

@ public
fn empty_cache_with_capacity(string model, string model_version, string config, string tokenizer, int layers, int dimension, int capacity) → KVCache ⇥ CacheError {
    return empty_cache_with_capacity_representations(model, model_version, config, tokenizer, layers, dimension, capacity, representation_f32(), block_f32(), representation_f32(), block_f32())
}

@ public
fn empty_cache_with_capacity_representations(string model, string model_version, string config, string tokenizer, int layers, int dimension, int capacity, storage.Representation key_representation, storage.BlockMetadata key_block, storage.Representation value_representation, storage.BlockMetadata value_block) → KVCache ⇥ CacheError {
    require model.length() ≢ 0 throw variant EmptyName { message = "empty model name" }

    require model_version.length() ≢ 0 throw variant EmptyName { message = "empty model version" }

    require config.length() ≢ 0 throw variant EmptyName { message = "empty execution config" }

    require tokenizer.length() ≢ 0 throw variant EmptyName { message = "empty tokenizer identity" }

    reject contains_separator(model) or contains_separator(model_version) or contains_separator(config) or contains_separator(tokenizer) throw variant EmptyName { message = "reserved wire character in identity" }

    require layers ≥ 1 throw variant InvalidDimension { message = "layer count must be at least one" }

    require dimension ≥ 1 throw variant InvalidDimension { message = "embedding dimension must be at least one" }

    require capacity ≥ 1 throw variant InvalidDimension { message = "capacity must be at least one" }

    row_bytes(key_block, dimension)
    row_bytes(value_block, dimension)
    let list<int> shape ← [0, dimension]
    let KVStorage key_storage ← empty_storage(key_representation, key_block, shape)
    let KVStorage value_storage ← empty_storage(value_representation, value_block, shape)

    # Decoded F32 caches start on PRE-ALLOCATED fixed-capacity zero row
    # buffers: every later append/extend writes rows in place at write_pos
    # and never copies the history (issue #73). Encoded (non-F32) caches
    # keep the vacant placeholder blocks; their bytes live in storage.
    if representation_equal(key_representation, representation_f32()) and representation_equal(value_representation, representation_f32()) {
        let list<f32> key_data ← capacity_zeros(capacity, dimension)
        let list<f32> value_data ← capacity_zeros(capacity, dimension)
        return KVCache { model = model, model_version = model_version, config = config, tokenizer = tokenizer, history = empty, layers = layers, layout = "staged", key = tensor.stage_f32(shape, key_data), payload = tensor.stage_f32(shape, value_data), key_storage = key_storage, value_storage = value_storage, version = 1, dimension = dimension, capacity = capacity, sealed = false }
    }

    let tensor.NumericBlock vacant ← tensor.default()
    return KVCache { model = model, model_version = model_version, config = config, tokenizer = tokenizer, history = empty, layers = layers, layout = "staged", key = vacant, payload = vacant, key_storage = key_storage, value_storage = value_storage, version = 1, dimension = dimension, capacity = capacity, sealed = false }
}

# -------------------------------------------------------------------------
# empty_cache — a fresh cache: the identity fields, an empty history, an
# empty K/V [0, dimension], version 1. Identity fields are non-empty and
# wire-safe (fail closed); the layers/dimension/capacity are positive.
# The 6-arg helper uses HELPER_CAPACITY. empty_layers copies
# KVStructure.context_length as the immutable admission bound.
# -------------------------------------------------------------------------

@ public
fn empty_cache(string model, string model_version, string config, string tokenizer, int layers, int dimension) → KVCache ⇥ CacheError {
    return empty_cache_with_capacity(model, model_version, config, tokenizer, layers, dimension, HELPER_CAPACITY)
}

# Placeholder Default for `var KVCache` bindings (var on structs).
# Empty identity and empty staged payloads; not a valid cache.
@ public
fn default() → KVCache {
    let tensor.NumericBlock t ← tensor.default()
    let storage.Representation representation ← representation_f32()
    let storage.BlockMetadata block ← block_f32()
    let storage.EncodedStorage encoded ← storage.encoded(||, representation, block)
    let KVStorage kv_storage ← KVStorage { encoded = encoded, shape = empty, count = 0, decoded = false }
    return KVCache { model = "", model_version = "", config = "", tokenizer = "", history = empty, layers = 0, layout = "", key = t, payload = t, key_storage = kv_storage, value_storage = kv_storage, version = 0, dimension = 0, capacity = 0, sealed = false }
}

# -------------------------------------------------------------------------
# append — the ONE mutation: extend the cache by exactly one position.
# The token joins the exact history; the [1, dimension] f32 K/V rows are
# written IN PLACE at write_pos into the pre-allocated capacity buffers (no
# history copy); the generation bumps by 1. Write position is the current
# length. Gaps and overflow reject before any new rows exist. The receiver
# is mut because the rows land in the shared pre-allocated buffers and the
# base is sealed against a silent second branch writing the same rows.
# -------------------------------------------------------------------------

@ public
fn append(mut KVCache c, int token_id, tensor.NumericBlock key, tensor.NumericBlock payload) → KVCache ⇥ CacheError {
    require token_id ≥ 0 throw variant IdOutOfRange { message = "token id must be non-negative" }

    require representation_equal(c.key_storage.encoded.representation, representation_f32()) and representation_equal(c.value_storage.encoded.representation, representation_f32()) throw variant DtypeMismatch { message = "decoded append requires F32 K/V representations" }

    require c.key_storage.decoded and c.value_storage.decoded throw variant DtypeMismatch { message = "decoded append requires decoded F32 storage" }

    require key.shape ≡ ([1, c.dimension] ↦ list<int>) throw variant ShapeMismatch { message = "K must be [1, dim]" }

    require payload.shape ≡ ([1, c.dimension] ↦ list<int>) throw variant ShapeMismatch { message = "V must be [1, dim]" }

    require dtype.name(key.dtype) ≡ "f32" throw variant DtypeMismatch { message = "unsupported dtype for cache" }

    require dtype.name(payload.dtype) ≡ "f32" throw variant DtypeMismatch { message = "unsupported dtype for cache" }

    admit_write(c, 1)
    mut list<int> new_history ← copy c.history
    new_history.append(token_id)
    let int write_pos ← c.length()
    let int dimension ← c.dimension

    if c.sealed {
        # Branched base: fork onto fresh capacity buffers (its valid region
        # copied once); the base and its earlier derivation stay untouched.
        mut list<f32> key_data ← forked_data(c.key.data, write_pos, c.capacity, dimension)
        mut list<f32> value_data ← forked_data(c.payload.data, write_pos, c.capacity, dimension)
        write_rows(mut key_data, write_pos, dimension, key)
        write_rows(mut value_data, write_pos, dimension, payload)
        return keep_decoded(c, new_history, key_data, value_data, write_pos + 1)
    }

    write_rows(mut c.key.data, write_pos, dimension, key)
    write_rows(mut c.payload.data, write_pos, dimension, payload)
    c.sealed ← true
    return keep_decoded(c, new_history, c.key.data, c.payload.data, write_pos + 1)
}

# -------------------------------------------------------------------------
# extend — append T new positions in one mutation (the prefill write).
# tokens, key, and payload must share length T; each new K/V row is [T, dim]
# and the T rows are written IN PLACE at write_pos (no history copy).
# Generation bumps by 1 (one write). Write position is the current length.
# Gaps and overflow reject before any new rows exist.
# -------------------------------------------------------------------------

@ public
fn extend(mut KVCache c, list<int> tokens, tensor.NumericBlock key, tensor.NumericBlock payload) → KVCache ⇥ CacheError {
    require tokens.length() ≢ 0 throw variant ElementMismatch { message = "empty token list" }

    require representation_equal(c.key_storage.encoded.representation, representation_f32()) and representation_equal(c.value_storage.encoded.representation, representation_f32()) throw variant DtypeMismatch { message = "decoded extend requires F32 K/V representations" }

    require c.key_storage.decoded and c.value_storage.decoded throw variant DtypeMismatch { message = "decoded extend requires decoded F32 storage" }

    require key.shape ≡ ([tokens.length(), c.dimension] ↦ list<int>) throw variant ShapeMismatch { message = "K must be [T, dim]" }

    require payload.shape ≡ ([tokens.length(), c.dimension] ↦ list<int>) throw variant ShapeMismatch { message = "V must be [T, dim]" }

    require dtype.name(key.dtype) ≡ "f32" throw variant DtypeMismatch { message = "unsupported dtype for cache" }

    require dtype.name(payload.dtype) ≡ "f32" throw variant DtypeMismatch { message = "unsupported dtype for cache" }

    admit_write(c, tokens.length())

    # Keep: token validation must reject the first bad id before any new
    # row is written; a transform cannot preserve this boundary.
    for from tokens let token_id {
        require token_id ≥ 0 throw variant IdOutOfRange { message = "token id must be non-negative" }
    }

    mut list<int> new_history ← copy c.history

    for from tokens let token_id {
        new_history.append(token_id)
    }

    let int write_pos ← c.length()
    let int dimension ← c.dimension

    if c.sealed {
        # Branched base: fork onto fresh capacity buffers (its valid region
        # copied once); the base and its earlier derivation stay untouched.
        mut list<f32> key_data ← forked_data(c.key.data, write_pos, c.capacity, dimension)
        mut list<f32> value_data ← forked_data(c.payload.data, write_pos, c.capacity, dimension)
        write_rows(mut key_data, write_pos, dimension, key)
        write_rows(mut value_data, write_pos, dimension, payload)
        return keep_decoded(c, new_history, key_data, value_data, write_pos + tokens.length())
    }

    write_rows(mut c.key.data, write_pos, dimension, key)
    write_rows(mut c.payload.data, write_pos, dimension, payload)
    c.sealed ← true
    return keep_decoded(c, new_history, c.key.data, c.payload.data, write_pos + tokens.length())
}

# -------------------------------------------------------------------------
# prefix_view — the speculative rollback: a view of the cache truncated to
# `count` valid rows over the SAME pre-allocated row buffers (issue #77).
# Rows past `count` stay in the buffers but are not part of the value — a
# rejected speculative branch is discarded by shrinking the view, never by
# copying the accepted prefix. The history is truncated to match. Decoded
# F32 caches only (the speculative commit path). The result is sealed when
# the truncation actually drops rows: a derivation already wrote rows past
# this count in the shared buffers, so the next write forks onto fresh
# buffers and any longer view over the same rows keeps its value.
# -------------------------------------------------------------------------

@ public
fn prefix_view(KVCache c, int count) → KVCache ⇥ CacheError {
    require representation_equal(key_representation(c), representation_f32()) and representation_equal(value_representation(c), representation_f32()) throw variant DtypeMismatch { message = "prefix view requires F32 K/V representations" }

    require c.key_storage.decoded and c.value_storage.decoded throw variant DtypeMismatch { message = "prefix view requires decoded F32 storage" }

    require count ≥ 0 and count ≤ c.length() throw variant ElementMismatch { message = "prefix view row count is outside the cache" }

    let list<int> shape ← [count, c.dimension]
    let tensor.NumericBlock key ← tensor.stage_f32(shape, c.key.data)
    let tensor.NumericBlock payload ← tensor.stage_f32(shape, c.payload.data)
    let KVStorage key_storage ← decoded_storage_count(c.key_storage.encoded.representation, c.key_storage.encoded.block, c.dimension, count)
    let KVStorage value_storage ← decoded_storage_count(c.value_storage.encoded.representation, c.value_storage.encoded.block, c.dimension, count)
    mut bool sealed ← c.sealed

    if count ≺ c.length() {
        sealed ← true
    }

    return KVCache { model = c.model, model_version = c.model_version, config = c.config, tokenizer = c.tokenizer, history = c.history[0 ‥ count], layers = c.layers, layout = c.layout, key = key, payload = payload, key_storage = key_storage, value_storage = value_storage, version = c.version + 1, dimension = c.dimension, capacity = c.capacity, sealed = sealed }
}

fn validate_encoded(KVCache c, list<b8> key, list<b8> value, int rows) → bool ⇥ CacheError {
    require rows ≥ 1 throw variant ElementMismatch { message = "encoded write must contain at least one row" }

    let int key_row_bytes ← row_bytes(c.key_storage.encoded.block, c.dimension)
    let int value_row_bytes ← row_bytes(c.value_storage.encoded.block, c.dimension)

    require key.length() ≡ rows * key_row_bytes throw variant ElementMismatch { message = "encoded K byte count does not match shape" }

    require value.length() ≡ rows * value_row_bytes throw variant ElementMismatch { message = "encoded V byte count does not match shape" }

    return true
}

# Append one physical encoded K/V row. The input bytes are retained verbatim;
# no list<f32> widening or dtype-only masquerade occurs. A F32 representation
# may use this route for an explicitly encoded cache, but decoded access then
# rejects until a real decode/materialization operation exists.
@ public
fn append_encoded(KVCache c, int token_id, list<b8> key, list<b8> value) → KVCache ⇥ CacheError {
    require token_id ≥ 0 throw variant IdOutOfRange { message = "token id must be non-negative" }

    require c.key_storage.count ≡ 0 or not c.key_storage.decoded throw variant DtypeMismatch { message = "encoded append cannot follow decoded key storage" }

    require c.value_storage.count ≡ 0 or not c.value_storage.decoded throw variant DtypeMismatch { message = "encoded append cannot follow decoded value storage" }

    validate_encoded(c, key, value, 1)
    admit_write(c, 1)
    let list<int> new_history ← c.history.added(token_id)
    return keep_encoded(c, new_history, join_bytes(c.key_storage.encoded.payload, key), join_bytes(c.value_storage.encoded.payload, value), c.version + 1)
}

# Append a physical encoded prefill block. Each byte buffer is row-major in
# the representation's own block format; the logical shape remains [rows,
# dimension] and the row/count metadata advances by exactly rows.
@ public
fn extend_encoded(KVCache c, list<int> tokens, list<b8> key, list<b8> value) → KVCache ⇥ CacheError {
    require tokens.length() ≢ 0 throw variant ElementMismatch { message = "empty encoded token list" }

    require c.key_storage.count ≡ 0 or not c.key_storage.decoded throw variant DtypeMismatch { message = "encoded extend cannot follow decoded key storage" }

    require c.value_storage.count ≡ 0 or not c.value_storage.decoded throw variant DtypeMismatch { message = "encoded extend cannot follow decoded value storage" }

    validate_encoded(c, key, value, tokens.length())
    admit_write(c, tokens.length())

    for from tokens let token_id {
        require token_id ≥ 0 throw variant IdOutOfRange { message = "token id must be non-negative" }
    }

    let list<int> new_history ← tokens.reduce((list<int> out, int token_id) ∴ out.added(token_id), c.history)
    return keep_encoded(c, new_history, join_bytes(c.key_storage.encoded.payload, key), join_bytes(c.value_storage.encoded.payload, value), c.version + 1)
}

@ public
fn decoded_key(KVCache c) → tensor.NumericBlock ⇥ CacheError {
    require representation_equal(c.key_storage.encoded.representation, representation_f32()) and c.key_storage.decoded throw variant DtypeMismatch { message = "decoded K access is unavailable for encoded storage" }

    return c.key
}

@ public
fn decoded_value(KVCache c) → tensor.NumericBlock ⇥ CacheError {
    require representation_equal(c.value_storage.encoded.representation, representation_f32()) and c.value_storage.decoded throw variant DtypeMismatch { message = "decoded V access is unavailable for encoded storage" }

    return c.payload
}

fn join_bytes(list<b8> base, list<b8> extra) → list<b8> {
    mut list<b8> out ← copy base

    for from extra let x {
        out.append(x)
    }

    return out
}

# -------------------------------------------------------------------------
# reset — logical prompt reset: empty history and empty K/V, same
# identity fields and immutable capacity, generation advanced by 1. The
# decoded path restarts on FRESH pre-allocated zero buffers (the old rows
# never leak into a later comparison); the base cache is left untouched.
# -------------------------------------------------------------------------

@ public
fn reset(KVCache c) → KVCache ⇥ CacheError {
    if representation_equal(c.key_storage.encoded.representation, representation_f32()) and representation_equal(c.value_storage.encoded.representation, representation_f32()) {
        let list<int> shape ← [0, c.dimension]
        let list<f32> key_data ← capacity_zeros(c.capacity, c.dimension)
        let list<f32> value_data ← capacity_zeros(c.capacity, c.dimension)
        let KVStorage key_storage ← decoded_storage_count(c.key_storage.encoded.representation, c.key_storage.encoded.block, c.dimension, 0)
        let KVStorage value_storage ← decoded_storage_count(c.value_storage.encoded.representation, c.value_storage.encoded.block, c.dimension, 0)
        return KVCache { model = c.model, model_version = c.model_version, config = c.config, tokenizer = c.tokenizer, history = empty, layers = c.layers, layout = c.layout, key = tensor.stage_f32(shape, key_data), payload = tensor.stage_f32(shape, value_data), key_storage = key_storage, value_storage = value_storage, version = c.version + 1, dimension = c.dimension, capacity = c.capacity, sealed = false }
    }

    return keep_encoded(c, empty, ||, ||, c.version + 1)
}

# -------------------------------------------------------------------------
# CacheIdentity is owned by cache/identity. Its identity includes the
# independent K/V representation names carried by the storage descriptors.
# -------------------------------------------------------------------------

+++ faber test
# Focused proof for the cache storage split. The old cache.proba keeps the
# decoded F32 consumer contract; this file proves the physical encoded seam.

import from "gradus:cache/kv" kv
import from "gradus:storage" storage
import from "gradus:tensor" tensor

fn bytes_repeat(int count, int value) → list<b8> {
    mut list<u8> values ← empty
    for range 0 ‥ count {
        values.append(value ↦ u8 ⊥ 0)
    }
    return values ↦ list<b8>
}

fn encoded_cache() → kv.KVCache {
    return kv.empty_cache_with_capacity_representations("tiny-mlp", "1.0.0", "causal-rope-d4", "smollm", 1, 32, 8, kv.representation_f16(), kv.block_f16(), kv.representation_q8_0(), kv.block_q8_0()) ⊥ kv.default()
}

fn decoded_detail(kv.KVCache c) → string {
    do {
        kv.decoded_key(c)
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn decoded_value_detail(kv.KVCache c) → string {
    do {
        kv.decoded_value(c)
        return "ok"
    }
    catch err {
        return err.message
    }
}

test "representation descriptors keep independent K and V identities" {
    let kv.KVCache c ← encoded_cache()
    assert c.key_storage.encoded.representation.namespace ≡ "ggml"
    assert c.key_storage.encoded.representation.name ≡ "f16"
    assert c.key_storage.encoded.representation.version ≡ "unspecified"
    assert c.key_storage.encoded.representation.code ≡ 1
    assert c.key_storage.encoded.block.elements_per_block ≡ 1
    assert c.key_storage.encoded.block.bytes_per_block ≡ 2
    assert c.value_storage.encoded.representation.name ≡ "q8_0"
    assert c.value_storage.encoded.representation.code ≡ 8
    assert c.value_storage.encoded.block.elements_per_block ≡ 32
    assert c.value_storage.encoded.block.bytes_per_block ≡ 34
    assert c.key_storage.shape ≡ ([0, 32] ↦ list<int>)
    assert c.value_storage.shape ≡ ([0, 32] ↦ list<int>)
    assert c.key_storage.count ≡ 0
    assert c.value_storage.count ≡ 0
}

test "encoded append preserves K/V bytes and logical shape" {
    let kv.KVCache c0 ← encoded_cache()
    let list<b8> key ← bytes_repeat(64, 17)
    let list<b8> value ← bytes_repeat(34, 203)
    let kv.KVCache c1 ← kv.append_encoded(c0, 7, key, value) ⊥ kv.default()
    assert c1.history ≡ ([7] ↦ list<int>)
    assert c1.length() ≡ 1
    assert c1.version ≡ 2
    assert c1.key_storage.shape ≡ ([1, 32] ↦ list<int>)
    assert c1.value_storage.shape ≡ ([1, 32] ↦ list<int>)
    assert c1.key_storage.count ≡ 1
    assert c1.value_storage.count ≡ 1
    assert c1.key_storage.encoded.payload.length() ≡ 64
    assert c1.value_storage.encoded.payload.length() ≡ 34
    assert c1.key_storage.encoded.payload.get(0) coalesce 0x00 ∷ b8 ≡ 0x11 ∷ b8
    assert c1.key_storage.encoded.payload.get(63) coalesce 0x00 ∷ b8 ≡ 0x11 ∷ b8
    assert c1.value_storage.encoded.payload.get(0) coalesce 0x00 ∷ b8 ≡ 0xcb ∷ b8
    assert c1.value_storage.encoded.payload.get(33) coalesce 0x00 ∷ b8 ≡ 0xcb ∷ b8
    assert decoded_detail(c1) ≡ "decoded K access is unavailable for encoded storage"
    assert decoded_value_detail(c1) ≡ "decoded V access is unavailable for encoded storage"
}

test "encoded extend appends complete physical rows without widening" {
    let kv.KVCache c0 ← encoded_cache()
    let list<b8> key ← bytes_repeat(128, 31)
    let list<b8> value ← bytes_repeat(68, 149)
    let kv.KVCache c1 ← kv.extend_encoded(c0, [3, 5], key, value) ⊥ kv.default()
    assert c1.history ≡ ([3, 5] ↦ list<int>)
    assert c1.length() ≡ 2
    assert c1.version ≡ 2
    assert c1.key_storage.shape ≡ ([2, 32] ↦ list<int>)
    assert c1.value_storage.shape ≡ ([2, 32] ↦ list<int>)
    assert c1.key_storage.encoded.payload.length() ≡ 128
    assert c1.value_storage.encoded.payload.length() ≡ 68
    assert c1.key_storage.encoded.payload.get(127) coalesce 0x00 ∷ b8 ≡ 0x1f ∷ b8
    assert c1.value_storage.encoded.payload.get(67) coalesce 0x00 ∷ b8 ≡ 0x95 ∷ b8
}

test "unknown future storage representation round-trips through encoded KV storage" {
    let storage.Representation future ← storage.representation("vendor", "future_blob", "2026", -77)
    let storage.BlockMetadata block ← storage.known_block(8, 10, 1, 10)
    let kv.KVCache c0 ← kv.empty_cache_with_capacity_representations("tiny-mlp", "1.0.0", "causal-rope-d4", "smollm", 1, 8, 4, future, block, kv.representation_f16(), kv.block_f16()) ⊥ kv.default()
    let kv.KVCache c1 ← kv.append_encoded(c0, 11, bytes_repeat(10, 233), bytes_repeat(16, 17)) ⊥ kv.default()
    assert c1.key_storage.encoded.representation.namespace ≡ "vendor"
    assert c1.key_storage.encoded.representation.name ≡ "future_blob"
    assert c1.key_storage.encoded.representation.version ≡ "2026"
    assert c1.key_storage.encoded.representation.code ≡ -77
    assert c1.key_storage.encoded.block.elements_per_block ≡ 8
    assert c1.key_storage.encoded.block.bytes_per_block ≡ 10
    assert c1.key_storage.encoded.payload.length() ≡ 10
    assert c1.key_storage.encoded.payload.get(0) coalesce 0x00 ∷ b8 ≡ 0xe9 ∷ b8
    assert c1.key_storage.shape ≡ ([1, 8] ↦ list<int>)
    assert c1.key_storage.count ≡ 1
}

# ---- prefix_view — the speculative rollback (issue #77)

# A small decoded F32 cache (the speculative commit path's storage).
fn decoded_cache() → kv.KVCache {
    return kv.empty_cache_with_capacity("tiny-mlp", "1.0.0", "causal-rope-d4", "smollm", 1, 4, 8) ⊥ kv.default()
}

# One [1, 4] f32 row for the appends.
fn staged_row(f32 a, f32 b, f32 c, f32 d) → tensor.NumericBlock {
    return tensor.construct([a, b, c, d], [1, 4]) ⊥ tensor.default()
}

# Element read with a default (the decode.fab test pattern).
fn cell(tensor.NumericBlock t, int row, int col) → f32 {
    return t.get([row, col]) ⊥ (0.0 - 999.0) ↦ f32
}

# Renders a prefix-view outcome as text.
fn prefix_detail(kv.KVCache c, int count) → string {
    let _ outcome ← trap {
        kv.prefix_view(c, count)
    }
    match outcome {
        case returned let ? {
            return "ok"
        }
        case thrown let err {
            return err.message
        }
    }
}

test "prefix view truncates a decoded branch in place" {
    mut kv.KVCache c0 ← decoded_cache()
    let tensor.NumericBlock k1 ← staged_row(1.0, 2.0, 3.0, 4.0)
    let tensor.NumericBlock v1 ← staged_row(5.0, 6.0, 7.0, 8.0)
    mut kv.KVCache c1 ← kv.append(mut c0, 9, k1, v1) ⊥ kv.default()
    let tensor.NumericBlock k2 ← staged_row(10.0, 11.0, 12.0, 13.0)
    let tensor.NumericBlock v2 ← staged_row(14.0, 15.0, 16.0, 17.0)
    mut kv.KVCache c2 ← kv.append(mut c1, 8, k2, v2) ⊥ kv.default()
    let kv.KVCache view ← kv.prefix_view(c2, 1) ⊥ kv.default()
    assert view.length() ≡ 1
    assert view.history ≡ ([9] ↦ list<int>)
    assert view.version ≡ c2.version + 1
    assert view.sealed
    assert view.capacity ≡ 8
    assert view.key_storage.count ≡ 1
    assert view.value_storage.count ≡ 1
    assert view.key.shape ≡ ([1, 4] ↦ list<int>)
    assert cell(view.key, 0, 0) ≡ (1.0 ∷ f32)
    assert cell(view.payload, 0, 3) ≡ (8.0 ∷ f32)
    assert prefix_detail(c2, 2) ≡ "ok"
    assert prefix_detail(c2, 3) ≡ "prefix view row count is outside the cache"
    assert prefix_detail(c2, 0 - 1) ≡ "prefix view row count is outside the cache"
}

test "a write from the truncated view forks and the longer view keeps its value" {
    mut kv.KVCache c0 ← decoded_cache()
    let tensor.NumericBlock k1 ← staged_row(1.0, 2.0, 3.0, 4.0)
    let tensor.NumericBlock v1 ← staged_row(5.0, 6.0, 7.0, 8.0)
    mut kv.KVCache c1 ← kv.append(mut c0, 9, k1, v1) ⊥ kv.default()
    let tensor.NumericBlock k2 ← staged_row(10.0, 11.0, 12.0, 13.0)
    let tensor.NumericBlock v2 ← staged_row(14.0, 15.0, 16.0, 17.0)
    mut kv.KVCache branch ← kv.append(mut c1, 8, k2, v2) ⊥ kv.default()
    mut kv.KVCache view ← kv.prefix_view(branch, 1) ⊥ kv.default()
    let tensor.NumericBlock k3 ← staged_row(20.0, 21.0, 22.0, 23.0)
    let tensor.NumericBlock v3 ← staged_row(24.0, 25.0, 26.0, 27.0)
    mut kv.KVCache forked ← kv.append(mut view, 7, k3, v3) ⊥ kv.default()
    assert forked.length() ≡ 2
    assert forked.history ≡ ([9, 7] ↦ list<int>)
    assert cell(forked.key, 1, 0) ≡ (20.0 ∷ f32)
    assert cell(forked.payload, 1, 3) ≡ (27.0 ∷ f32)
    assert branch.length() ≡ 2
    assert branch.history ≡ ([9, 8] ↦ list<int>)
    assert cell(branch.key, 1, 0) ≡ (10.0 ∷ f32)
    assert cell(branch.payload, 1, 3) ≡ (17.0 ∷ f32)
}
