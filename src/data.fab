+++ toml
locale = "en"

+++ faber
# Data loading facade — the batch leaf: deterministic shuffle + batch
# slicing of token-id corpora.
#
# Public import: import from "gradus:data" data
# Depends on: gradus:random (Seed/Draw — the ONLY RNG; this module advances no
# second generator).
#
# Nested-leaf plan: this file splits into nested leaves when a second
# data concern is implemented. The batch leaf is the first:
#   gradus:data/batch     batching and shuffling  ← this file (implemented)
#   gradus:data/token     tokenization (char-level, BPE) — still future
# Until that split, the batch leaf is the whole implemented surface and
# the facade keeps its public import path.
#
# Token-id domain: native list<int> carriers. Lists are already rank-1 integer
# sequences, so the data boundary validates only the corpus and batch-size
# invariants. Failures are typed DataError rejections — never partial or
# invented results.
#
# Architectural rule: data loading is separate from training. The Shakespeare
# corpus and a future safetensors dataset feed the same training loop through
# the same batch interface.

import from "gradus:random"

# -------------------------------------------------------------------------
# DataError — typed error vocabulary of the data surface. Every variant
# carries a text message so consumers can render the failure without
# matching each variant.
# -------------------------------------------------------------------------

@ public
union DataError {
    @ shared
    string message

    EmptyCorpus,
    InvalidBatchSize,
    InvalidVocabularyId,
    InvalidWindowLength,
    InvalidValidationModulus,
    InvalidPairLengths,
    InputWidthMismatch {
        int expected_width
        int actual_width
    },
    TargetWidthMismatch {
        int expected_width
        int actual_width
    },
    TensorFailure {
        tensor.TensorError inner
    },
    InvalidSamplerState,
    RandomFailure {
        random.RandomError inner
    }
}

@ conversion
fn from_random_error(random.RandomError err) → DataError {
    return variant RandomFailure { message = err.message, inner = err }
}

@ conversion
fn from_tensor_error(tensor.TensorError err) → DataError {
    return variant TensorFailure { message = err.message, inner = err }
}

# Shared corpus gate: non-empty. Message identity is the proba pin surface.
fn require_ids(list<int> ids) → void ⇥ DataError {
    require ids.length() ≢ 0 throw variant EmptyCorpus { message = "corpus is empty" }
}

# -------------------------------------------------------------------------
# shuffle — deterministic Fisher–Yates over the corpus order, driven by
# gradus:random Seed/Draw (the training RNG; no second generator).
#   for i in 0 ‥ n−1: one xorshift64 draw;
#   pick j = i + ((draw ∧ MASK_63) mod (n − i)); swap positions i and j.
# The draw is masked to its low 63 bits (sign-agnostic, the random.next_f32
# precedent) so the modulo span is never negative. Deterministic: the same
# (ids, seed) reproduces the same order. A single-element corpus consumes
# no draw and the seed is returned unchanged. The advanced seed rides the
# Shuffled carrier so an epoch loop chains shuffles without reconstructing
# state.
# -------------------------------------------------------------------------

# Sign-bit mask: shuffle picks use only the low 63 bits of a draw.
const int MASK_63 = 9223372036854775807

@ public
class Shuffled {
    mut list<int> payload
    mut random.Seed seed
}

@ public
fn shuffle(list<int> ids, random.Seed seed) → Shuffled ⇥ DataError {
    require_ids(ids)
    let list<int> source ← ids
    let int n ← source.length()
    mut list<int> data ← copy source
    mut random.Seed s ← copy seed
    let int last ← n - 1

    for range 0 ‥ last let i {
        let random.Draw d ← random.next(s)
        s ← d.seed
        let int pick ← i + (d.payload ∧ MASK_63) % (n - i)
        let int tmp ← data.get(i) coalesce 0
        data[i] ← data.get(pick) coalesce 0
        data[pick] ← tmp
    }

    return Shuffled { payload = data, seed = s }
}

# -------------------------------------------------------------------------
# batch — order-preserving slicing of a token-id corpus into
# consecutive batches of batch_size ids; the last batch is short when the
# length is not an exact multiple. Fail closed: empty corpus, batch size
# < 1, and batch size > corpus length are rejections — no partial or
# invented batches. Shuffling is the separate leaf function above;
# callers compose batch(shuffle(ids, seed).payload, size).
# -------------------------------------------------------------------------

@ public
fn batch(list<int> ids, int batch_size) → list<list<int>> ⇥ DataError {
    require_ids(ids)

    require batch_size ≥ 1 throw variant InvalidBatchSize { message = "batch size must be at least 1" }

    let list<int> source ← ids
    let int n ← source.length()

    require batch_size ≤ n throw variant InvalidBatchSize { message = "batch size exceeds corpus length" }

    mut list<list<int>> out ← empty
    mut int start ← 0

    while start ≺ n {
        mut int stop ← start + batch_size

        if stop ≻ n {
            stop ← n
        }

        let list<int> chunk ← source[start ‥ stop]

        out.append(chunk)
        start ← stop
    }

    return out
}

# -------------------------------------------------------------------------
# Local supervised examples. Each sample is a fixed-width list<int>; batches
# materialize row-major F32 NumericBlock tensors with shape [rows, width].
# Input samples share one width and target samples share one width (the two
# widths may differ). Integer IDs are represented as f32. The final batch is
# retained short, never dropped or padded.
# -------------------------------------------------------------------------

import from "gradus:tensor"

@ public
class Batch {
    let tensor.NumericBlock x
    let tensor.NumericBlock y
}

@ public
class SupervisedSet {
    let list<list<int>> inputs
    let list<list<int>> targets
}

@ public
class SupervisedSplit {
    let list<int> training
    let list<int> held_out
}

@ public
class ModulusSplit {
    let list<int> training_positions
    let list<int> held_out_positions
}

@ public
class SupervisedSampler {
    let string corpus
    let int seed
    let int epoch
    let int position
    # Hot-path caches (constructor defaults, never on the wire): the
    # precomputed corpus digest and the shuffled order for the cached epoch,
    # reshuffled only at epoch rollover. Absent (0 / empty) on hand-built
    # and wire-loaded states — the first step pays the exact compare once.
    mut int corpus_hash = 0
    mut bool corpus_hash_ready = false
    mut list<int> order_cache = empty
    mut int order_epoch = -1
}

# One ordered sequence identity format serves both LM document corpora and
# supervised index lists. This preserves the LM identity bytes exactly.
@ public
fn data_identity(list<list<int>> sequences) → string {
    mut string identity ← ""
    let list<int> empty_ints ← empty

    for range 0 ‥ sequences.length() let i {
        let list<int> sequence ← sequences.get(i) coalesce empty_ints
        identity ← identity + "d§:"(sequence.length() ↦ string)

        for range 0 ‥ sequence.length() let j {
            if j ≢ 0 {
                identity ← identity + ","
            }

            identity ← identity + (sequence.get(j) coalesce 0 ↦ string)
        }

        identity ← identity + ";"
    }

    return identity
}

# Streaming digest over the same ordered (length, token) domain data_identity
# renders: O(total tokens), fixed-size accumulator, no string allocation. A
# digest, not an identity — data_identity stays the contract surface; the
# hash only guards the hot-path corpus checks (a collision would admit a
# changed corpus with probability about 2^-63). The mix is xorshift-style on
# the wrapping<i64> ring (the random.fab precedent: wrapping keeps the
# 64-bit state without overflow concerns), masked into the non-negative
# range (the shuffle MASK_63 precedent).
const int HASH_OFFSET = 88172645463325252

fn hash_mix(int h, int v) → int {
    mut wrapping<i64> x ← (h ⊻ v) ↦ wrapping<i64>
    x ← x ⊻ x ⇐ 13
    x ← x ⊻ x ⇒ 7
    x ← x ⊻ x ⇐ 17
    return (x ↦ int) ∧ MASK_63
}

fn data_hash(list<list<int>> sequences) → int {
    mut int h ← HASH_OFFSET
    let list<int> empty_ints ← empty

    for exclusive sequences.length() let i {
        let list<int> sequence ← sequences.get(i) coalesce empty_ints
        h ← hash_mix(h, sequence.length())

        for exclusive sequence.length() let j {
            h ← hash_mix(h, sequence.get(j) coalesce 0)
        }
    }

    return h
}

# Shared modulus split returns positions, preserving input order in each side.
# Consumers provide a key per item: supervised rows use their index and LM
# documents use lm_document_score(document).
fn modulus_split(list<int> keys, int modulus) → ModulusSplit ⇥ DataError {
    require modulus ≥ 2 throw variant InvalidValidationModulus { message = "held-out modulus must be at least 2" }

    mut list<int> training ← empty
    mut list<int> held_out ← empty

    for range 0 ‥ keys.length() let i {
        if keys.get(i) coalesce 0 % modulus ≡ 0 {
            held_out.append(i)
        }
        else {
            training.append(i)
        }
    }

    return ModulusSplit { training_positions = training, held_out_positions = held_out }
}

@ public
fn supervised_set(list<list<int>> inputs, list<list<int>> targets) → SupervisedSet ⇥ DataError {
    require inputs.length() ≡ targets.length() throw variant InvalidPairLengths { message = "input and target sample counts differ" }

    if inputs.length() ≻ 0 {
        let list<int> empty_ints ← empty
        let int input_width ← (inputs.get(0) coalesce empty_ints).length()
        let int target_width ← (targets.get(0) coalesce empty_ints).length()

        for range 0 ‥ inputs.length() let i {
            let int actual_input_width ← (inputs.get(i) coalesce empty_ints).length()
            let int actual_target_width ← (targets.get(i) coalesce empty_ints).length()

            require actual_input_width ≡ input_width throw variant InputWidthMismatch { message = "input sample widths differ: expected §, got §"(input_width ↦ string, actual_input_width ↦ string), expected_width = input_width, actual_width = actual_input_width }

            require actual_target_width ≡ target_width throw variant TargetWidthMismatch { message = "target sample widths differ: expected §, got §"(target_width ↦ string, actual_target_width ↦ string), expected_width = target_width, actual_width = actual_target_width }
        }
    }

    return SupervisedSet { inputs = inputs, targets = targets }
}

fn supervised_tensor(list<list<int>> rows, int width) → tensor.NumericBlock ⇥ DataError {
    mut list<f32> flat ← empty
    let list<int> empty_ints ← empty

    for range 0 ‥ rows.length() let r {
        let list<int> row ← rows.get(r) coalesce empty_ints

        for range 0 ‥ width let c {
            flat.append(row.get(c) coalesce 0 ↦ f32)
        }
    }

    return tensor.construct(flat, [rows.length(), width])
}

@ public
fn supervised_split(int count, int held_out_modulus) → SupervisedSplit ⇥ DataError {
    mut list<int> indices ← empty

    for range 0 ‥ count let i {
        indices.append(i)
    }

    let ModulusSplit split ← modulus_split(indices, held_out_modulus)
    return SupervisedSplit { training = split.training_positions, held_out = split.held_out_positions }
}

@ public
fn epoch_order(list<int> train_set, random.Seed seed) → Shuffled ⇥ DataError {
    return shuffle(train_set, seed)
}

# Batch indices are positions in the shuffled epoch order; paired input and
# target samples are gathered with the same index before a batch is emitted.
# The final batch is short when needed; no sample is dropped or padded.
@ public
fn supervised_batches(SupervisedSet set, list<int> order, int batch_size) → list<Batch> ⇥ DataError {
    require_ids(order)

    require batch_size ≥ 1 throw variant InvalidBatchSize { message = "batch size must be at least 1" }

    mut list<Batch> out ← empty
    let list<int> empty_ints ← empty
    mut int start ← 0

    while start ≺ order.length() {
        mut int stop ← start + batch_size

        if stop ≻ order.length() {
            stop ← order.length()
        }

        mut list<list<int>> xs ← empty
        mut list<list<int>> ys ← empty

        for range start ‥ stop let p {
            let int index ← order.get(p) coalesce (-1)

            require index ≥ 0 and index ≺ set.inputs.length() and index ≺ set.targets.length() throw variant InvalidSamplerState { message = "sample index is outside the supervised set" }

            xs.append(set.inputs.get(index) coalesce empty_ints)
            ys.append(set.targets.get(index) coalesce empty_ints)
        }

        let int x_width ← (set.inputs.get(0) coalesce empty_ints).length()
        let int y_width ← (set.targets.get(0) coalesce empty_ints).length()
        out.append(Batch { x = supervised_tensor(xs, x_width), y = supervised_tensor(ys, y_width) })
        start ← stop
    }

    return out
}

@ public
fn supervised_indices_identity(list<int> indices) → string {
    return data_identity([indices])
}

@ public
fn supervised_sampler_start(list<int> train_set, random.Seed seed) → SupervisedSampler {
    return SupervisedSampler { corpus = supervised_indices_identity(train_set), seed = seed.status, epoch = 0, position = 0, corpus_hash = data_hash([train_set]), corpus_hash_ready = true }
}

# One versioned, # separated wire format and parser serve LM cursors and
# supervised sampler checkpoints. Field bytes are passed through unchanged.
fn versioned_wire(string version, list<string> fields) → string {
    mut string wire ← version

    for from fields let field {
        wire ← "§#§"(wire, field)
    }

    return wire
}

fn parse_versioned_wire(string wire, string version, int field_count) → list<string> ∪ none {
    let list<string> parts ← wire.split("#")

    if parts.length() ≢ field_count or parts.get(0) coalesce "" ≢ version then return null

    return parts
}

@ public
fn supervised_sampler_wire(SupervisedSampler state) → string {
    return versioned_wire("supervised-sampler-v1", [state.corpus, state.seed ↦ string, state.epoch ↦ string, state.position ↦ string])
}

fn parse_integer(string text) → int ∪ none {
    if text.length() ≡ 0 then return null

    mut int start ← 0

    if text.slice(0, 1) ≡ "-" {
        start ← 1

        if start ≡ text.length() then return null
    }

    for range start ‥ text.length() let i {
        let string c ← text.slice(i, i + 1)

        if c ≢ "0" and c ≢ "1" and c ≢ "2" and c ≢ "3" and c ≢ "4" and c ≢ "5" and c ≢ "6" and c ≢ "7" and c ≢ "8" and c ≢ "9" then return null
    }

    mut int value ← 0

    do {
        value ↤ text
    }
    catch err {
        return null
    }

    return value
}

@ public
fn supervised_sampler_parse(string wire) → SupervisedSampler ∪ none {
    let _ parts_value ← parse_versioned_wire(wire, "supervised-sampler-v1", 5)

    if parts_value is none then return null

    let list<string> empty_strings ← empty
    let list<string> parts ← parts_value coalesce empty_strings
    let _ seed_value ← parse_integer(parts.get(2) coalesce "")
    let _ epoch_value ← parse_integer(parts.get(3) coalesce "")
    let _ position_value ← parse_integer(parts.get(4) coalesce "")

    if seed_value is none or epoch_value is none or position_value is none then return null

    let int seed ← seed_value coalesce 0
    let int epoch ← epoch_value coalesce 0
    let int position ← position_value coalesce 0

    if epoch ≺ 0 or position ≺ 0 then return null

    return SupervisedSampler { corpus = parts.get(1) coalesce "", seed = seed, epoch = epoch, position = position }
}

@ public
fn supervised_sampler_order(list<int> train_set, SupervisedSampler state) → Shuffled ∪ none {
    if state.corpus ≢ supervised_indices_identity(train_set) then return null

    mut random.Seed seed ← random.default()

    do {
        seed ← random.construct_seed(state.seed)
    }
    catch err {
        return null
    }

    do {
        return shuffle(train_set, seed)
    }
    catch err {
        return null
    }
}

@ public
class SupervisedStep {
    let Batch batch
    let SupervisedSampler state
}

# Shared tail of supervised_sampler_step: slice one batch out of the epoch
# order and pair it with the advanced sampler state (which caches the order
# it used).
fn supervised_sampler_emit(SupervisedSet set, list<int> train_set, list<int> order, int position, int batch_size, string corpus, int seed_status, int epoch, int corpus_hash) → SupervisedStep ∪ none ⇥ DataError {
    mut int stop ← position + batch_size

    if stop ≻ train_set.length() {
        stop ← train_set.length()
    }

    let list<int> selected ← order[position ‥ stop]

    let list<Batch> batches ← supervised_batches(set, selected, batch_size)
    let Batch next_batch ← batches.get(0) coalesce Batch { x = tensor.default(), y = tensor.default() }
    let SupervisedSampler next_state ← SupervisedSampler { corpus = corpus, seed = seed_status, epoch = epoch, position = stop, corpus_hash = corpus_hash, corpus_hash_ready = true, order_cache = order, order_epoch = epoch }
    return SupervisedStep { batch = next_batch, state = next_state }
}

@ public
fn supervised_sampler_step(SupervisedSet set, list<int> train_set, int batch_size, SupervisedSampler state) → SupervisedStep ∪ none ⇥ DataError {
    if batch_size ≤ 0 or train_set.length() ≡ 0 then return null

    # Corpus identity: the precomputed streaming digest when the state
    # carries one (sampler-start states and every state this function
    # returns); the exact data_identity compare otherwise — hand-built or
    # wire-loaded states pay it once.
    mut int corpus_hash ← state.corpus_hash

    if state.corpus_hash_ready {
        if data_hash([train_set]) ≢ corpus_hash then return null
    }
    else {
        if state.corpus ≢ supervised_indices_identity(train_set) then return null

        corpus_hash ← data_hash([train_set])
    }

    mut int epoch ← state.epoch
    mut int position ← state.position

    if position ≥ train_set.length() {
        epoch ← epoch + 1
        position ← 0
    }

    mut random.Seed seed ← random.default()

    do {
        seed ← random.construct_seed(state.seed + epoch)
    }
    catch err {
        return null
    }

    # Shuffled epoch order, cached in the sampler state: an epoch's order
    # depends only on (seed, epoch), so the corpus is reshuffled exactly at
    # epoch rollover and every batch within the epoch reuses the cache.
    if state.order_epoch ≡ epoch and state.order_cache.length() ≡ train_set.length() {
        return supervised_sampler_emit(set, train_set, state.order_cache, position, batch_size, state.corpus, state.seed, epoch, corpus_hash)
    }

    let Shuffled shuffled ← epoch_order(train_set, seed)
    return supervised_sampler_emit(set, train_set, shuffled.payload, position, batch_size, state.corpus, state.seed, epoch, corpus_hash)
}

# The sampler persists through the same wire boundary as the cursor: the
# state's wire (supervised_sampler_wire) is the persisted bytes and
# supervised_sampler_parse restores them; the host owns the file.

# -------------------------------------------------------------------------
# Language-model byte vocabulary and stable corpus identity.
# -------------------------------------------------------------------------


@ public
const int LM_PAD_ID = 256

@ public
const int LM_VOCAB_SIZE = 257

@ public
fn lm_is_vocabulary_id(int id) → bool {
    return id ≥ 0 and id ≺ LM_VOCAB_SIZE
}

@ public
fn lm_vocabulary_id(int byte) → int ⇥ DataError {
    require byte ≥ 0 and byte ≤ 255 throw variant InvalidVocabularyId { message = "byte is outside the byte vocabulary" }

    return byte
}

@ public
fn lm_vocabulary_byte(int id) → int ⇥ DataError {
    require id ≥ 0 and id ≤ 255 throw variant InvalidVocabularyId { message = "id is outside the byte vocabulary" }

    return id
}

@ public
fn lm_document_score(list<int> document) → int {
    mut int score ← document.length()

    for range 0 ‥ document.length() let i {
        score ← score + document.get(i) coalesce 0
    }

    return score
}

@ public
fn lm_corpus_identity(list<list<int>> documents) → string {
    return data_identity(documents)
}

# -------------------------------------------------------------------------
# LM windows — fixed-width, non-overlapping next-token examples. Each
# document is divided into windows with stride equal to length; values beyond
# the document are right-padded and contribute no loss. A non-positive window
# length is a typed DataError rejection.
# -------------------------------------------------------------------------

@ public
class LmWindow {
    let int document
    let int start
    let list<int> inputs
    let list<int> targets
    let list<int> loss_mask
}

@ public
fn lm_windows(list<int> tokens, int length, int document) → list<LmWindow> ⇥ DataError {
    require length ≻ 0 throw variant InvalidWindowLength { message = "window length must be positive" }

    let int n ← tokens.length()
    mut list<LmWindow> windows ← empty
    mut int start ← 0

    while start ≺ n {
        mut list<int> inputs ← empty
        mut list<int> targets ← empty
        mut list<int> loss_mask ← empty

        for range 0 ‥ length let k {
            let int input_index ← start + k

            if input_index ≺ n {
                inputs.append(tokens.get(input_index) coalesce LM_PAD_ID)
            }
            else {
                inputs.append(LM_PAD_ID)
            }

            let int target_index ← input_index + 1

            if target_index ≺ n {
                targets.append(tokens.get(target_index) coalesce LM_PAD_ID)
                loss_mask.append(1)
            }
            else {
                targets.append(LM_PAD_ID)
                loss_mask.append(0)
            }
        }

        windows.append(LmWindow { document = document, start = start, inputs = inputs, targets = targets, loss_mask = loss_mask })
        start ← start + length
    }

    return windows
}

# -------------------------------------------------------------------------
# Document-level deterministic training/validation split. Documents remain
# intact, and each output preserves the input order within its split.
# -------------------------------------------------------------------------

@ public
class LmSplit {
    let list<list<int>> training
    let list<list<int>> validation
    # Original-corpus document index sets: filled by lm_split_documents so
    # cursor scans test membership in O(1) instead of deep list equality.
    # Empty (the constructor default) on hand-built splits — the cursor then
    # derives membership by content matching, the legacy rule.
    mut set<int> training_indices = empty
    mut set<int> validation_indices = empty
}

@ public
fn lm_split_documents(list<list<int>> documents, int validation_modulus) → LmSplit ⇥ DataError {
    mut list<int> scores ← empty
    let list<int> empty_ints ← empty

    for range 0 ‥ documents.length() let i {
        scores.append(lm_document_score(documents.get(i) coalesce empty_ints))
    }

    let ModulusSplit split ← modulus_split(scores, validation_modulus)
    mut list<list<int>> training ← empty
    mut list<list<int>> validation ← empty

    for from split.training_positions let i {
        training.append(documents.get(i) coalesce empty_ints)
    }

    for from split.held_out_positions let i {
        validation.append(documents.get(i) coalesce empty_ints)
    }

    return LmSplit { training = training, validation = validation, training_indices = split.training_positions ↦ set<int>, validation_indices = split.held_out_positions ↦ set<int> }
}

# -------------------------------------------------------------------------
# Restartable LM cursor. The cursor's document is an original-corpus index;
# its window is the next fixed-width window within that document. The corpus
# field is the exact lm_corpus_identity of the ordered documents used to
# create the cursor; next/advance reject a cursor if it differs from the
# supplied documents (including content or order changes). A consumed
# traversal ends at the exhausted position, which resumes nowhere.
# -------------------------------------------------------------------------

@ public
class LmCursor {
    let string corpus
    let string split
    let int document
    let int window
    # Precomputed corpus digest cache (constructor default, never on the
    # wire): a cursor that has been through one locate carries it, so later
    # locates compare the digest instead of rebuilding the identity string.
    mut int corpus_hash = 0
    mut bool corpus_hash_ready = false
}

@ public
fn lm_cursor_start(string corpus, string split) → LmCursor {
    return LmCursor { corpus = corpus, split = split, document = -1, window = 0 }
}

@ public
fn lm_cursor_wire(LmCursor cursor) → string {
    return versioned_wire("lm-cursor-v1", [cursor.corpus, cursor.split, cursor.document ↦ string, cursor.window ↦ string])
}

@ public
fn lm_cursor_parse(string wire) → LmCursor ∪ none {
    let _ parts_value ← parse_versioned_wire(wire, "lm-cursor-v1", 5)

    if parts_value is none then return null

    let list<string> empty_strings ← empty
    let list<string> parts ← parts_value coalesce empty_strings
    let string corpus ← parts.get(1) coalesce ""
    let string split ← parts.get(2) coalesce ""
    let string document_text ← parts.get(3) coalesce ""
    let string window_text ← parts.get(4) coalesce ""
    let _ parsed_document ← parse_integer(document_text)
    let _ parsed_window ← parse_integer(window_text)

    if parsed_document is none or parsed_window is none then return null

    let int document ← parsed_document coalesce 0
    let int window ← parsed_window coalesce 0
    return LmCursor { corpus = corpus, split = split, document = document, window = window }
}

fn lm_cursor_contains(list<list<int>> documents, list<int> document) → bool {
    let list<int> empty_ints ← empty

    for range 0 ‥ documents.length() let i {
        if documents.get(i) coalesce empty_ints ≡ document then return true
    }

    return false
}

# Original-corpus index set for one split side. Splits built by
# lm_split_documents carry the stored set; hand-built splits (empty set,
# non-empty side) derive it once per call by content matching — the legacy
# containment rule, duplicate contents included.
fn lm_side_indices(list<list<int>> documents, list<list<int>> side, set<int> stored) → set<int> {
    if stored.length() ≢ 0 or side.length() ≡ 0 {
        return stored
    }

    let list<int> empty_ints ← empty
    mut set<int> derived ← empty

    for exclusive documents.length() let i {
        if lm_cursor_contains(side, documents.get(i) coalesce empty_ints) {
            derived.add(i)
        }
    }

    return derived
}

# Index set for a named split side; none when the side name is unknown.
fn lm_split_indices(list<list<int>> documents, LmSplit split, string side_name) → set<int> ∪ none {
    if side_name ≡ "training" {
        return lm_side_indices(documents, split.training, split.training_indices)
    }

    if side_name ≡ "validation" {
        return lm_side_indices(documents, split.validation, split.validation_indices)
    }

    return null
}

# Shared forward scan: the next selected window at or after
# (first_document, first_window), starting the walk at `start` (never below
# zero). The window offset applies only when the scan lands on first_document
# itself, so an initial cursor (document -1) resolves with window 0. A window
# at or past its document's window count skips to the next selected
# document.
fn lm_cursor_resolve(list<list<int>> documents, set<int> indices, string corpus, string split, int first_document, int first_window, int start, int length, int corpus_hash) → LmCursor ∪ none {
    let list<int> empty_ints ← empty

    if start ≥ documents.length() then return null

    for exclusive documents.length() - start let k {
        let int i ← start + k

        if indices.has(i) {
            let list<int> document ← documents.get(i) coalesce empty_ints

            if document.length() ≻ 0 {
                mut int window ← 0

                if i ≡ first_document {
                    window ← first_window
                }

                let int window_count ← (document.length() - 1) / length + 1

                if window ≺ window_count then return LmCursor { corpus = corpus, split = split, document = i, window = window, corpus_hash = corpus_hash, corpus_hash_ready = true }
            }
        }
    }

    return null
}

# Resolve a possibly initial or stale cursor to the next selected window's
# canonical original-document index and within-document window index. An
# exhausted cursor (a document below the initial -1) resolves to none, which
# is how a traversal reports the end of its split.
fn lm_cursor_locate(list<list<int>> documents, LmSplit split, LmCursor cursor, int length) → LmCursor ∪ none {
    let int corpus_hash ← data_hash(documents)

    if cursor.corpus_hash_ready {
        if corpus_hash ≢ cursor.corpus_hash then return null
    }
    else {
        if cursor.corpus ≢ lm_corpus_identity(documents) then return null
    }

    if length ≤ 0 or cursor.document ≺ -1 or cursor.window ≺ 0 then return null

    let set<int> no_indices ← empty
    let _ indices_value ← lm_split_indices(documents, split, cursor.split)

    if indices_value is none then return null

    let set<int> indices ← indices_value coalesce no_indices

    # The scan starts at the cursor's own document (never below the initial
    # -1), not at document 0.
    mut int start ← cursor.document

    if start ≺ 0 {
        start ← 0
    }

    return lm_cursor_resolve(documents, indices, cursor.corpus, cursor.split, cursor.document, cursor.window, start, length, corpus_hash)
}

fn lm_cursor_window_at(list<int> tokens, int length, int document, int window) → LmWindow {
    let int start ← window * length
    mut list<int> inputs ← empty
    mut list<int> targets ← empty
    mut list<int> loss_mask ← empty

    for range 0 ‥ length let k {
        let int input_index ← start + k

        if input_index ≺ tokens.length() {
            inputs.append(tokens.get(input_index) coalesce LM_PAD_ID)
        }
        else {
            inputs.append(LM_PAD_ID)
        }

        let int target_index ← input_index + 1

        if target_index ≺ tokens.length() {
            targets.append(tokens.get(target_index) coalesce LM_PAD_ID)
            loss_mask.append(1)
        }
        else {
            targets.append(LM_PAD_ID)
            loss_mask.append(0)
        }
    }

    return LmWindow { document = document, start = start, inputs = inputs, targets = targets, loss_mask = loss_mask }
}

@ public
fn lm_cursor_next(list<list<int>> documents, LmSplit split, LmCursor cursor, int length) → LmWindow ∪ none {
    let _ location_value ← lm_cursor_locate(documents, split, cursor, length)

    if location_value is none then return null

    let LmCursor location ← location_value coalesce LmCursor { corpus = "", split = "", document = -1, window = 0 }
    let list<int> empty_ints ← empty
    let list<int> document ← documents.get(location.document) coalesce empty_ints
    return lm_cursor_window_at(document, length, location.document, location.window)
}

@ public
fn lm_cursor_advance(list<list<int>> documents, LmSplit split, LmCursor cursor, int length) → LmCursor ∪ none {
    let _ location_value ← lm_cursor_locate(documents, split, cursor, length)

    if location_value is none then return null

    let LmCursor location ← location_value coalesce LmCursor { corpus = "", split = "", document = -1, window = 0 }
    let list<int> empty_ints ← empty
    let list<int> document ← documents.get(location.document) coalesce empty_ints

    # Step within the located document first; only a rollover past its last
    # window scans forward — the duplicate full locate of the old
    # implementation is gone.
    let int window_count ← (document.length() - 1) / length + 1

    if location.window + 1 ≺ window_count {
        return LmCursor { corpus = location.corpus, split = location.split, document = location.document, window = location.window + 1, corpus_hash = location.corpus_hash, corpus_hash_ready = location.corpus_hash_ready }
    }

    let set<int> no_indices ← empty
    let _ indices_value ← lm_split_indices(documents, split, location.split)

    if indices_value is none then return null

    let set<int> indices ← indices_value coalesce no_indices
    return lm_cursor_resolve(documents, indices, location.corpus, location.split, location.document + 1, 0, location.document + 1, length, location.corpus_hash)
}

# The wire's exhausted position: a document index below the initial -1, so a
# finished cursor is never mistaken for a start cursor and never resumes a
# document.
@ public
const int LM_CURSOR_EXHAUSTED = -2

# The terminal cursor for a traversal: keep the corpus and the split, and mark
# the position exhausted. A run that consumes a split's final window persists
# this cursor, so a fresh process loads it, finds no next window, and reports
# exhaustion instead of replaying the window it already consumed.
@ public
fn lm_cursor_finish(LmCursor cursor) → LmCursor {
    return LmCursor { corpus = cursor.corpus, split = cursor.split, document = LM_CURSOR_EXHAUSTED, window = 0, corpus_hash = cursor.corpus_hash, corpus_hash_ready = cursor.corpus_hash_ready }
}

# -------------------------------------------------------------------------
# Cursor persistence. Gradus is self-contained: it owns the wire, and the
# host owns the file. The persisted state of a traversal is exactly the
# cursor wire (lm_cursor_wire), and a fresh process resumes by parsing
# those bytes (lm_cursor_parse) — whatever boundary carries them (a file,
# a store, a message) is the caller's. A parse failure loads as none —
# never a guessed cursor. Persist the wire at the acceptance boundary and
# keep the previous state on a failed write; a stale or absent state means
# a caller that keeps training past it would replay windows after a
# restart. The retry is the caller's decision.
# -------------------------------------------------------------------------

+++ faber test
# Co-located package test for data.fab (T2-U1 — the data/batch leaf).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * shuffle — deterministic Fisher–Yates over gradus:random Seed/Draw:
#     the same-seed ⇒ same-order pin (fresh seed and the chained advanced
#     seed), the golden permutation for seed 123 over the 10‥17 corpus
#     ([13, 17, 11, 12, 16, 14, 10, 15]), the single-element no-draw
#     contract, and the fail-closed empty-corpus row — message identity per
#     validation.
#   * batch — order-preserving slicing with a short last batch: exact
#     division, short remainder, size == length, and the fail-closed
#     bounds negatives (empty corpus, size < 1, size > length).
#
# Oracle pins: the golden permutations are exact i64 evaluations of the
# documented recurrence (random.fab xorshift64; concrete draw pins recorded
# in random.proba) run through the documented pick rule
# j = i + (draw ∧ 2^63−1) mod (n − i). The chained-seed pin evaluates the
# seed after seven draws from 123 (−1859521560095551381) as its input.
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber test src/data.proba` runs the suite through the
# package test route. Library-to-library calls execute on the FMIR stepper
# (radix 43c0102ba; regression-locked by 2e8042ae7). This suite remains
# compile-level proof; no runtime value identity is claimed here.

import from "gradus:data" data

import from "gradus:loss" loss

import from "gradus:tensor" tensor

import from "gradus:dtype" dtype

import from "gradus:random" random

# ---- helpers (the metrics.proba pattern)

# The pin seed and the corpus under permutation (ids 10‥17).
const int SEED_A = 123

fn corpus() → list<int> {
    return [10, 11, 12, 13, 14, 15, 16, 17]
}

# Seed helper, swallowing the never-firing construction error.
fn seed_p(int status) → random.Seed {
    return random.construct_seed(status) ⊥ random.default()
}

# Renders a shuffle outcome as text: "ok" on success, the typed error's
# message on rejection.
fn shuffle_detail(list<int> ids, random.Seed seed) → string {
    do {
        data.shuffle(ids, seed)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# Renders a batch outcome as text: "ok" on success, the typed error's
# message on rejection.
fn batch_detail(list<int> ids, int batch_size) → string {
    do {
        let list<list<int>> parts ← data.batch(ids, batch_size)
        parts.length()
        return "ok"
    }
    catch err {
        return err.message
    }
}

# ---- shuffle: determinism + golden permutations

test "same seed produces the same order and the same advanced seed" {
    let _ trap_result_16 ← trap {
        let data.Shuffled a ← data.shuffle(corpus(), seed_p(SEED_A))
        let data.Shuffled b ← data.shuffle(corpus(), seed_p(SEED_A))
        assert a.payload ≡ ([13, 17, 11, 12, 16, 14, 10, 15] ↦ list<int>)
        assert b.payload ≡ ([13, 17, 11, 12, 16, 14, 10, 15] ↦ list<int>)
        assert a.seed.status ≡ b.seed.status
    }
    match trap_result_16 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "golden permutation: seed 123 over the ten-to-seventeen corpus" {
    # Exact i64 evaluation of the documented recurrence + pick rule;
    # the draws are the seed-123 stream of the xorshift64 pinned in
    # random.proba. Seven draws consumed — the seed advanced off its start.
    let _ trap_result_15 ← trap {
        let data.Shuffled sh ← data.shuffle(corpus(), seed_p(SEED_A))
        assert sh.payload ≡ ([13, 17, 11, 12, 16, 14, 10, 15] ↦ list<int>)
        assert sh.seed.status ≢ SEED_A
    }
    match trap_result_15 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "the chained advanced seed reproduces its own order" {
    # The seed after seven draws from 123 (random.proba draw pins give
    # the recurrence); shuffling with it is deterministic too.
    let _ trap_result_14 ← trap {
        let random.Seed chained ← seed_p(0 - 1859521560095551381)
        let data.Shuffled a ← data.shuffle(corpus(), chained)
        let data.Shuffled b ← data.shuffle(corpus(), chained)
        assert a.payload ≡ ([13, 16, 15, 10, 11, 17, 12, 14] ↦ list<int>)
        assert b.payload ≡ ([13, 16, 15, 10, 11, 17, 12, 14] ↦ list<int>)
    }
    match trap_result_14 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "a single-element corpus shuffles to itself and consumes no draw" {
    # No position below n−1 exists — no draw, no advancement.
    let _ trap_result_13 ← trap {
        let data.Shuffled sh ← data.shuffle([7], seed_p(SEED_A))
        assert sh.payload ≡ ([7] ↦ list<int>)
        assert sh.seed.status ≡ SEED_A
    }
    match trap_result_13 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

# ---- shuffle: fail-closed contract

test "shuffle rejects an empty corpus" {
    assert shuffle_detail([], seed_p(SEED_A)) ≡ "corpus is empty"
}

# ---- batch: slicing contract

test "exact division: six ids at size three give two batches of three" {
    let _ trap_result_12 ← trap {
        let list<list<int>> parts ← data.batch([30, 31, 32, 33, 34, 35], 3)
        assert parts.length() ≡ 2
        let list<int> first ← parts.get(0) coalesce ([] ∷ list<int>)
        let list<int> second ← parts.get(1) coalesce ([] ∷ list<int>)
        assert first ≡ ([30, 31, 32] ↦ list<int>)
        assert second ≡ ([33, 34, 35] ↦ list<int>)
    }
    match trap_result_12 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "short last batch: five ids at size two give two/two/one" {
    let _ trap_result_11 ← trap {
        let list<list<int>> parts ← data.batch([40, 41, 42, 43, 44], 2)
        assert parts.length() ≡ 3
        let list<int> first ← parts.get(0) coalesce ([] ∷ list<int>)
        let list<int> second ← parts.get(1) coalesce ([] ∷ list<int>)
        let list<int> last ← parts.get(2) coalesce ([] ∷ list<int>)
        assert first ≡ ([40, 41] ↦ list<int>)
        assert second ≡ ([42, 43] ↦ list<int>)
        assert last ≡ ([44] ↦ list<int>)
    }
    match trap_result_11 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "batch size equal to the corpus length yields the whole corpus" {
    let _ trap_result_10 ← trap {
        let list<list<int>> parts ← data.batch(corpus(), 8)
        assert parts.length() ≡ 1
        let list<int> whole ← parts.get(0) coalesce ([] ∷ list<int>)
        assert whole ≡ ([10, 11, 12, 13, 14, 15, 16, 17] ↦ list<int>)
    }
    match trap_result_10 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

# ---- batch: fail-closed bounds

test "batch rejects an empty corpus" {
    assert batch_detail([], 2) ≡ "corpus is empty"
}

test "batch rejects a zero batch size" {
    assert batch_detail(corpus(), 0) ≡ "batch size must be at least 1"
}

test "batch rejects a negative batch size" {
    assert batch_detail(corpus(), 0 - 1) ≡ "batch size must be at least 1"
}

test "batch rejects a batch size above the corpus length" {
    assert batch_detail(corpus(), 9) ≡ "batch size exceeds corpus length"
}

fn supervised_input_width_error() → string {
    let _ outcome ← trap { data.supervised_set([[1], [2, 3]], [[11], [12]]) }
    match outcome {
        case returned let ? { return "accepted" }
        case thrown let err {
            match err {
                case data.DataError.InputWidthMismatch let message, expected_width, actual_width { return message }
                case _ { return "wrong error" }
            }
        }
    }
}

fn supervised_target_width_error() → string {
    let _ outcome ← trap { data.supervised_set([[1], [2]], [[11], [12, 13]]) }
    match outcome {
        case returned let ? { return "accepted" }
        case thrown let err {
            match err {
                case data.DataError.TargetWidthMismatch let message, expected_width, actual_width { return message }
                case _ { return "wrong error" }
            }
        }
    }
}

test "supervised tensor batches keep shuffled pairs aligned, use independent widths, and retain tail" {
    let _ outcome ← trap {
        let data.SupervisedSet set ← data.supervised_set([[10, 20], [11, 21], [12, 22]], [[110, 210, 310], [111, 211, 311], [112, 212, 312]])
        let list<data.Batch> batches ← data.supervised_batches(set, [2, 0, 1], 2)
        assert batches.length() ≡ 2
        let data.Batch first ← batches.get(0) coalesce data.Batch { x = tensor.default(), y = tensor.default() }
        let data.Batch tail ← batches.get(1) coalesce data.Batch { x = tensor.default(), y = tensor.default() }
        assert first.x.shape ≡ ([2, 2] ↦ list<int>)
        assert first.y.shape ≡ ([2, 3] ↦ list<int>)
        let list<f32> exp_list_0 ← [12.0, 22.0, 10.0, 20.0]
        assert first.x.data ≡ exp_list_0
        let list<f32> exp_list_1 ← [112.0, 212.0, 312.0, 110.0, 210.0, 310.0]
        assert first.y.data ≡ exp_list_1
        assert tail.x.shape ≡ ([1, 2] ↦ list<int>)
        assert tail.y.shape ≡ ([1, 3] ↦ list<int>)
        let list<f32> exp_list_2 ← [11.0, 21.0]
        assert tail.x.data ≡ exp_list_2
        let list<f32> exp_list_3 ← [111.0, 211.0, 311.0]
        assert tail.y.data ≡ exp_list_3
    }
    match outcome {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "supervised set refuses inconsistent input and target widths with named-width errors" {
    assert supervised_input_width_error() ≡ "input sample widths differ: expected 1, got 2"
    assert supervised_target_width_error() ≡ "target sample widths differ: expected 1, got 2"
}

test "fixed-seed supervised epoch covers each training row once, excludes held-out rows, and preserves pairing" {
    let _ outcome ← trap {
        let data.SupervisedSplit split ← data.supervised_split(8, 3)
        let data.SupervisedSet set ← data.supervised_set([[0, 10], [1, 11], [2, 12], [3, 13], [4, 14], [5, 15], [6, 16], [7, 17]], [[100, 200, 300], [101, 201, 301], [102, 202, 302], [103, 203, 303], [104, 204, 304], [105, 205, 305], [106, 206, 306], [107, 207, 307]])
        let data.Shuffled order ← data.epoch_order(split.training, seed_p(SEED_A))
        assert order.payload ≡ ([4, 5, 7, 2, 1] ↦ list<int>)
        let list<data.Batch> batches ← data.supervised_batches(set, order.payload, 2)
        assert batches.length() ≡ 3
        let data.Batch tail ← batches.get(2) coalesce data.Batch { x = tensor.default(), y = tensor.default() }
        assert tail.x.shape ≡ ([1, 2] ↦ list<int>)
        assert tail.y.shape ≡ ([1, 3] ↦ list<int>)
        mut list<f32> seen ← empty
        for from batches let batch {
            for range 0 ‥ (batch.x.shape.get(0) coalesce 0) let row {
                let f32 sample ← batch.x.data.get(row * 2) coalesce 0.0
                let f32 target ← batch.y.data.get(row * 3) coalesce 0.0
                assert target ≡ sample + 100.0
                assert (batch.x.data.get(row * 2 + 1) coalesce 0.0) ≡ sample + 10.0
                seen.append(sample)
            }
        }
        let list<f32> exp_list_4 ← [4.0, 5.0, 7.0, 2.0, 1.0]
        assert seen ≡ exp_list_4
        for from split.training let sample {
            mut int occurrences ← 0
            for from seen let observed { if observed ≡ (sample ↦ f32) { occurrences ← occurrences + 1 } }
            assert occurrences ≡ 1
        }
        for from split.held_out let sample {
            for from seen let observed { assert observed ≢ (sample ↦ f32) }
        }
    }
    match outcome {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "supervised held-out split indices are disjoint and exhaustive" {
    let _ outcome ← trap {
        let data.SupervisedSplit split ← data.supervised_split(7, 3)
        assert split.training ≡ ([1, 2, 4, 5] ↦ list<int>)
        assert split.held_out ≡ ([0, 3, 6] ↦ list<int>)
    }
    match outcome {
        case returned let ? {}
        case thrown let ? { assert false }
    }
}

test "sampler wire round-trips seed epoch and tail position through the shared versioned format" {
    let data.SupervisedSampler state ← data.SupervisedSampler { corpus = data.supervised_indices_identity([1, 2, 4, 5, 7]), seed = 123, epoch = 2, position = 4 }
    let string wire ← data.supervised_sampler_wire(state)
    assert wire ≡ "supervised-sampler-v1#d5:1,2,4,5,7;#123#2#4"
    let _ decoded ← data.supervised_sampler_parse(wire)
    assert decoded not is none
    let data.SupervisedSampler restored ← decoded coalesce state
    assert restored.corpus ≡ state.corpus
    assert restored.seed ≡ 123
    assert restored.epoch ≡ 2
    assert restored.position ≡ 4
    assert data.supervised_sampler_parse("supervised-sampler-v2#d5:1,2,4,5,7;#123#2#4") is none
}

# ---- LM byte vocabulary and corpus identity


fn lm_byte_id_rejected(int id) → bool {
    let _ id_outcome ← trap {
        data.lm_vocabulary_id(id)
    }
    if id_outcome is int {
        return false
    }
    let _ byte_outcome ← trap {
        data.lm_vocabulary_byte(id)
    }
    if byte_outcome is int {
        return false
    }
    return true
}

test "lm byte ids round-trip through the byte vocabulary" {
    let _ trap_result ← trap {
        assert data.lm_vocabulary_id(0) ≡ 0
        assert data.lm_vocabulary_id(65) ≡ 65
        assert data.lm_vocabulary_id(255) ≡ 255
        assert data.lm_vocabulary_byte(0) ≡ 0
        assert data.lm_vocabulary_byte(65) ≡ 65
        assert data.lm_vocabulary_byte(255) ≡ 255
        assert lm_byte_id_rejected(256)
        assert lm_byte_id_rejected(257)
    }
    match trap_result {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "lm vocabulary reserves the pad id outside the byte range" {
    assert data.LM_PAD_ID ≡ 256
    assert data.LM_VOCAB_SIZE ≡ 257
    assert data.lm_is_vocabulary_id(256)
    assert not data.lm_is_vocabulary_id(257)
    assert lm_byte_id_rejected(256)
}

test "lm corpus identity is stable and separates document boundaries" {
    let list<list<int>> documents ← [[1, 2], [3]]
    let string identity ← data.lm_corpus_identity(documents)
    assert identity ≡ "d2:1,2;d1:3;"

    mut list<int> first ← empty
    first.append(1)
    first.append(2)
    mut list<int> second ← empty
    second.append(3)
    mut list<list<int>> rebuilt ← empty
    rebuilt.append(first)
    rebuilt.append(second)
    assert data.lm_corpus_identity(rebuilt) ≡ identity
    assert data.lm_corpus_identity([[1], [2, 3]]) ≢ identity
}

test "lm document score follows its formula" {
    assert data.lm_document_score([1, 2]) ≡ 5
    assert data.lm_document_score([1, 2, 0]) ≡ 6
}

# -------------------------------------------------------------------------
# LM fixed-width next-token windows
# -------------------------------------------------------------------------

fn lm_window_mask_sum(list<int> mask) → int {
    mut int total ← 0
    for range 0 ‥ mask.length() let i {
        total ← total + (mask.get(i) coalesce 0)
    }
    return total
}

# Adapt a data-window's integer labels or mask to the i32 carrier expected by
# Gradus' authoritative masked cross-entropy consumer.
fn lm_loss_block(list<int> values, list<int> shape, bool integer_tag) → tensor.NumericBlock {
    mut list<f32> payload ← empty
    for from values let value {
        payload.append(value ↦ f32)
    }
    let tensor.NumericBlock block ← tensor.construct(payload, shape) ⊥ tensor.default()
    if integer_tag {
        return tensor.NumericBlock { dtype = dtype.i32(), shape = block.shape, data = block.data, numel = block.numel, strides = block.strides }
    }
    return block
}

fn lm_zero_mask_reports_element_mismatch(tensor.NumericBlock logits, tensor.NumericBlock targets, tensor.NumericBlock mask) → bool {
    do {
        loss.cross_entropy_masked_carrier(logits, targets, mask)
        return false
    }
    catch err {
        match err {
            case loss.LossError.ElementMismatch let message {
                return true
            }
            case _ {
                return false
            }
        }
    }
}

test "lm windows shift each target one position past its input" {
    let _ trap_result ← trap {
        let list<data.LmWindow> windows ← data.lm_windows([10, 11, 12, 13, 14, 15, 16], 3, 42)
        assert windows.length() ≡ 3
        let data.LmWindow first ← windows.get(0) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
        let data.LmWindow second ← windows.get(1) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
        let data.LmWindow third ← windows.get(2) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
        assert first.inputs ≡ ([10, 11, 12] ↦ list<int>)
        assert first.targets ≡ ([11, 12, 13] ↦ list<int>)
        assert second.inputs ≡ ([13, 14, 15] ↦ list<int>)
        assert second.targets ≡ ([14, 15, 16] ↦ list<int>)
        assert third.inputs ≡ ([16, 256, 256] ↦ list<int>)
        assert third.targets ≡ ([256, 256, 256] ↦ list<int>)
        assert first.document ≡ 42
        assert first.start ≡ 0
        assert second.start ≡ 3
        assert third.start ≡ 6
    }
    match trap_result {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "lm windows right-pad a short final window and zero its mask" {
    let _ trap_result ← trap {
        let list<data.LmWindow> windows ← data.lm_windows([10, 11, 12, 13, 14, 15, 16], 3, 42)
        let data.LmWindow third ← windows.get(2) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
        assert third.inputs ≡ ([16, 256, 256] ↦ list<int>)
        assert third.loss_mask ≡ ([0, 0, 0] ↦ list<int>)
    }
    match trap_result {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "lm window mask counts equal adjacent pairs and masked CE ignores right padding" {
    let list<int> tokens ← [0, 1, 2, 0, 1]
    let list<data.LmWindow> windows ← data.lm_windows(tokens, 3, 42) ⊥ ([] ∷ list<data.LmWindow>)
    let data.LmWindow first ← windows.get(0) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
    let data.LmWindow padded ← windows.get(1) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
    assert padded.targets ≡ ([1, 256, 256] ↦ list<int>)
    assert padded.loss_mask ≡ ([1, 0, 0] ↦ list<int>)
    assert lm_window_mask_sum(first.loss_mask) + lm_window_mask_sum(padded.loss_mask) ≡ tokens.length() - 1

    let tensor.NumericBlock padded_logits ← lm_loss_block([0, 1, 2, 1, 2, 3, 2, 1, 0], [3, 3], false)
    let tensor.NumericBlock padded_targets ← lm_loss_block(padded.targets, [3], true)
    let tensor.NumericBlock padded_mask ← lm_loss_block(padded.loss_mask, [3], true)
    let f32 masked_loss ← loss.cross_entropy_masked_carrier(padded_logits, padded_targets, padded_mask) ⊥ (0.0 ∷ f32)
    let loss.CrossEntropyStats padded_stats ← loss.cross_entropy_masked_stats_carrier(padded_logits, padded_targets, padded_mask) ⊥ loss.CrossEntropyStats { sum = 0.0, valid_count = 0 }
    assert padded_stats.valid_count ≡ 1
    assert padded_stats.sum ≡ masked_loss

    let tensor.NumericBlock active_logits ← lm_loss_block([0, 1, 2], [1, 3], false)
    let tensor.NumericBlock active_target ← lm_loss_block([1], [1], true)
    let f32 active_only_loss ← loss.cross_entropy_carrier(active_logits, active_target) ⊥ (0.0 ∷ f32)
    assert masked_loss ≡ active_only_loss
}

test "lm masked cross entropy rejects an all-padding zero-valid-target window" {
    let _ trap_result ← trap {
        let list<data.LmWindow> windows ← data.lm_windows([0, 1, 2, 0, 1, 2, 0], 3, 42)
        let data.LmWindow all_padding ← windows.get(2) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
        assert all_padding.loss_mask ≡ ([0, 0, 0] ↦ list<int>)
        let tensor.NumericBlock logits ← lm_loss_block([0, 0, 0, 0, 0, 0, 0, 0, 0], [3, 3], false)
        let tensor.NumericBlock targets ← lm_loss_block(all_padding.targets, [3], true)
        let tensor.NumericBlock mask ← lm_loss_block(all_padding.loss_mask, [3], true)
        assert lm_zero_mask_reports_element_mismatch(logits, targets, mask)
    }
    match trap_result {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}


# ---- LM document-level training/validation split

fn lm_split_is_partition(list<list<int>> documents, data.LmSplit split) → bool {
    if split.training.length() + split.validation.length() ≢ documents.length() {
        return false
    }
    for range 0 ‥ documents.length() let i {
        let list<int> document ← documents.get(i) coalesce ([] ∷ list<int>)
        mut int occurrences ← 0
        for range 0 ‥ split.training.length() let j {
            if (split.training.get(j) coalesce ([] ∷ list<int>)) ≡ document {
                occurrences ← occurrences + 1
            }
        }
        for range 0 ‥ split.validation.length() let j {
            if (split.validation.get(j) coalesce ([] ∷ list<int>)) ≡ document {
                occurrences ← occurrences + 1
            }
        }
        if occurrences ≢ 1 {
            return false
        }
    }
    return true
}

fn lm_id_belongs_to_range(int id, int base) → bool {
    return id ≡ data.LM_PAD_ID or (id ≥ base and id ≺ base + 100)
}

fn lm_split_windows_stay_local(list<list<int>> documents) → bool ⇥ data.DataError {
    for range 0 ‥ documents.length() let i {
        let list<int> document ← documents.get(i) coalesce ([] ∷ list<int>)
        let int first ← document.get(0) coalesce 0
        let int base ← (first / 100) * 100
        let list<data.LmWindow> windows ← data.lm_windows(document, 3, i)
        for range 0 ‥ windows.length() let j {
            let data.LmWindow window ← windows.get(j) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
            for range 0 ‥ window.inputs.length() let k {
                let int input_id ← window.inputs.get(k) coalesce data.LM_PAD_ID
                let int target_id ← window.targets.get(k) coalesce data.LM_PAD_ID
                if not lm_id_belongs_to_range(input_id, base) {
                    return false
                }
                if not lm_id_belongs_to_range(target_id, base) {
                    return false
                }
            }
        }
    }
    return true
}

test "lm split assigns whole documents and never shares one" {
    let _ trap_result ← trap {
        let list<list<int>> documents ← [[1, 2], [3, 4], [5, 6]]
        let data.LmSplit split ← data.lm_split_documents(documents, 3)
        let list<list<int>> exp_list_5 ← [[3, 4]]
        assert split.validation ≡ exp_list_5
        let list<list<int>> exp_list_6 ← [[1, 2], [5, 6]]
        assert split.training ≡ exp_list_6
        assert lm_split_is_partition(documents, split)
    }
    match trap_result {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "lm split is independent of document order" {
    let _ trap_result ← trap {
        let list<list<int>> reversed ← [[5, 6], [3, 4], [1, 2]]
        let data.LmSplit split ← data.lm_split_documents(reversed, 3)
        let list<list<int>> exp_list_7 ← [[3, 4]]
        assert split.validation ≡ exp_list_7
        let list<list<int>> exp_list_8 ← [[5, 6], [1, 2]]
        assert split.training ≡ exp_list_8
        assert lm_split_is_partition(reversed, split)
    }
    match trap_result {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "lm split keeps every window inside one document" {
    let _ trap_result ← trap {
        # Each document occupies its own 100-id range. The score modulus puts
        # the first document in validation and the other two in training.
        let list<list<int>> documents ← [[1, 2], [103, 104], [205, 206]]
        let data.LmSplit split ← data.lm_split_documents(documents, 5)
        assert lm_split_windows_stay_local(split.training)
        assert lm_split_windows_stay_local(split.validation)
    }
    match trap_result {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

# ---- restartable LM cursor wire and window iteration

test "lm cursor wire round-trips all fields" {
    let data.LmCursor cursor ← data.LmCursor { corpus = "12,34:56;", split = "validation", document = 17, window = 23 }
    let string wire ← data.lm_cursor_wire(cursor)
    assert wire ≡ "lm-cursor-v1#12,34:56;#validation#17#23"
    let _ parsed_value ← data.lm_cursor_parse(wire)
    assert parsed_value not is none
    let data.LmCursor parsed ← parsed_value coalesce data.LmCursor { corpus = "", split = "", document = -1, window = 0 }
    assert parsed.corpus ≡ cursor.corpus
    assert parsed.split ≡ cursor.split
    assert parsed.document ≡ cursor.document
    assert parsed.window ≡ cursor.window
}

test "a cursor restored from its wire yields the same next window" {
    let list<list<int>> documents ← [[10, 11, 12, 13, 14], [20, 21], [30, 31, 32, 33]]
    let string identity ← data.lm_corpus_identity(documents)
    let data.LmSplit split ← data.LmSplit { training = [[10, 11, 12, 13, 14], [30, 31, 32, 33]], validation = [[20, 21]] }
    let data.LmCursor cursor ← data.LmCursor { corpus = identity, split = "training", document = 0, window = 1 }
    let _ live_value ← data.lm_cursor_next(documents, split, cursor, 2)
    assert live_value not is none
    let data.LmWindow live ← live_value coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    let _ parsed_value ← data.lm_cursor_parse(data.lm_cursor_wire(cursor))
    assert parsed_value not is none
    let data.LmCursor restored ← parsed_value coalesce data.LmCursor { corpus = "", split = "", document = -1, window = 0 }
    let _ resumed_value ← data.lm_cursor_next(documents, split, restored, 2)
    assert resumed_value not is none
    let data.LmWindow resumed ← resumed_value coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    assert live.document ≡ resumed.document
    assert live.start ≡ resumed.start
    assert live.inputs ≡ resumed.inputs
    assert live.targets ≡ resumed.targets
    assert live.loss_mask ≡ resumed.loss_mask
}

test "lm cursor rejects changed or reordered corpora before returning a window" {
    let list<list<int>> documents ← [[10, 11, 12], [20, 21], [30, 31]]
    let string identity ← data.lm_corpus_identity(documents)
    let data.LmCursor cursor ← data.LmCursor { corpus = identity, split = "training", document = 1, window = 0 }

    let list<list<int>> changed ← [[10, 11, 12], [90, 91], [30, 31]]
    let data.LmSplit changed_split ← data.LmSplit { training = changed, validation = empty }
    assert data.lm_cursor_next(changed, changed_split, cursor, 2) is none

    let list<list<int>> reordered ← [[30, 31], [20, 21], [10, 11, 12]]
    let data.LmSplit reordered_split ← data.LmSplit { training = reordered, validation = empty }
    assert data.lm_cursor_next(reordered, reordered_split, cursor, 2) is none
}

test "advancing a cursor lands on the window that next returns" {
    let list<list<int>> documents ← [[10, 11, 12, 13, 14], [20, 21], [], [30, 31, 32, 33]]
    let string identity ← data.lm_corpus_identity(documents)
    let data.LmSplit split ← data.LmSplit { training = [[10, 11, 12, 13, 14], [], [30, 31, 32, 33]], validation = [[20, 21]] }
    let data.LmCursor start ← data.lm_cursor_start(identity, "training")
    assert start.document ≡ -1
    assert start.window ≡ 0
    let _ advanced_value ← data.lm_cursor_advance(documents, split, start, 2)
    assert advanced_value not is none
    let data.LmCursor advanced ← advanced_value coalesce data.LmCursor { corpus = "", split = "", document = -1, window = 0 }
    let data.LmWindow following ← data.lm_cursor_next(documents, split, advanced, 2) coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    assert following.document ≡ advanced.document
    assert following.start ≡ advanced.window * 2
    assert following.document ≡ 0
    assert following.start ≡ 2
    let _ to_last_value ← data.lm_cursor_advance(documents, split, advanced, 2)
    assert to_last_value not is none
    let data.LmCursor to_last ← to_last_value coalesce data.LmCursor { corpus = "", split = "", document = -1, window = 0 }
    assert to_last.document ≡ 0
    assert to_last.window ≡ 2
    let _ crossed_value ← data.lm_cursor_advance(documents, split, to_last, 2)
    assert crossed_value not is none
    let data.LmCursor crossed ← crossed_value coalesce data.LmCursor { corpus = "", split = "", document = -1, window = 0 }
    let _ crossed_window_value ← data.lm_cursor_next(documents, split, crossed, 2)
    assert crossed_window_value not is none
    let data.LmWindow crossed_window ← crossed_window_value coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    assert crossed_window.document ≡ crossed.document
    assert crossed_window.start ≡ crossed.window * 2
    assert crossed.document ≡ 3
    assert crossed.window ≡ 0
}

test "lm cursor reports exhaustion at the end of its split" {
    let list<list<int>> documents ← [[1, 2], [3, 4], []]
    let string identity ← data.lm_corpus_identity(documents)
    let data.LmSplit split ← data.LmSplit { training = [[1, 2]], validation = [[3, 4], []] }
    let data.LmCursor validation_start ← data.lm_cursor_start(identity, "validation")
    let data.LmWindow validation_window ← data.lm_cursor_next(documents, split, validation_start, 2) coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    assert validation_window.document ≡ 1
    let data.LmCursor last ← data.LmCursor { corpus = identity, split = "training", document = 0, window = 0 }
    let data.LmWindow window ← data.lm_cursor_next(documents, split, last, 2) coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    assert window.document ≡ 0
    let _ after_last ← data.lm_cursor_advance(documents, split, last, 2)
    assert after_last is none
    let _ exhausted ← data.lm_cursor_next(documents, split, data.LmCursor { corpus = identity, split = "training", document = 0, window = 1 }, 2)
    assert exhausted is none
}

test "lm cursor parse rejects a malformed wire with none" {
    assert data.lm_cursor_parse("lm-cursor-v2#12;#training#0#0") is none
    assert data.lm_cursor_parse("lm-cursor-v1#12;#training#0") is none
    assert data.lm_cursor_parse("lm-cursor-v1#12;#training#x#0") is none
    assert data.lm_cursor_parse("lm-cursor-v1#12;#training#0#2x") is none
}

# ---- cursor persistence: the wire is the persisted state and the host
# owns the file. The wire round-trip and the restored-cursor resume rows
# above pin the traversal contract; the restored-sampler row below pins
# the same boundary for the supervised sampler.


test "a sampler restored from its wire emits the same next step" {
    # train_set is the row-index corpus the sampler contract shuffles (the
    # supervised_split posture); the set rows are indexed by those ids.
    let _ outcome_157 ← trap {
        let list<int> train ← [0, 1, 2, 3, 4, 5, 6, 7]
        let data.SupervisedSet set ← data.supervised_set([[10, 20], [11, 21], [12, 22], [13, 23], [14, 24], [15, 25], [16, 26], [17, 27]], [[110], [111], [112], [113], [114], [115], [116], [117]]) ⊥ data.SupervisedSet { inputs = empty, targets = empty }
        let data.SupervisedSampler start_state ← data.supervised_sampler_start(train, seed_p(SEED_A))
        let _ first_value ← data.supervised_sampler_step(set, train, 2, start_state)
        assert first_value not is none
        let data.SupervisedStep first ← first_value coalesce data.SupervisedStep { batch = data.Batch { x = tensor.default(), y = tensor.default() }, state = start_state }
        let string wire ← data.supervised_sampler_wire(first.state)
        let _ parsed_value ← data.supervised_sampler_parse(wire)
        assert parsed_value not is none
        let data.SupervisedSampler restored ← parsed_value coalesce start_state
        let _ live_value ← data.supervised_sampler_step(set, train, 2, first.state)
        assert live_value not is none
        let data.SupervisedStep live ← live_value coalesce first
        let _ resumed_value ← data.supervised_sampler_step(set, train, 2, restored)
        assert resumed_value not is none
        let data.SupervisedStep resumed ← resumed_value coalesce live
        assert resumed.batch.x.shape ≡ live.batch.x.shape
        assert resumed.batch.y.shape ≡ live.batch.y.shape
        assert resumed.state.position ≡ live.state.position
        assert resumed.state.epoch ≡ live.state.epoch
        assert resumed.state.seed ≡ live.state.seed
    }
    match outcome_157 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}
