+++
locale = "en"
+++
# Data loading facade — the batch leaf: deterministic shuffle + batch
# slicing of token-id corpora.
#
# Public import: import from "gradus:data" data
# Depends on: gradus:random (Seed/Draw — the ONLY RNG; this module advances no
# second generator).
#
# Nested-leaf plan: this file splits into nested leaves when a second
# data concern is implemented. The batch leaf is the first:
#   gradus:data/batch     batching and shuffling  ← this file (implemented)
#   gradus:data/token     tokenization (char-level, BPE) — still future
# Until that split, the batch leaf is the whole implemented surface and
# the facade keeps its public import path.
#
# Token-id domain: native list<int> carriers. Lists are already rank-1 integer
# sequences, so the data boundary validates only the corpus and batch-size
# invariants. Failures are typed DataError rejections — never partial or
# invented results.
#
# Architectural rule: data loading is separate from training. The Shakespeare
# corpus and a future safetensors dataset feed the same training loop through
# the same batch interface.

import from "gradus:random" random
import from "norma:fs" fs
import from "norma:fault" fault

# -------------------------------------------------------------------------
# DataError — typed error vocabulary of the data surface. Every variant
# carries a text message so consumers can render the failure without
# matching each variant.
# -------------------------------------------------------------------------

@ public
union DataError {
    @ shared
    string message

    EmptyCorpus,
    InvalidBatchSize,
    InvalidVocabularyId,
    InvalidWindowLength,
    InvalidValidationModulus,
    InvalidPairLengths,
    InputWidthMismatch {
        int expected_width
        int actual_width
    },
    TargetWidthMismatch {
        int expected_width
        int actual_width
    },
    TensorFailure {
        tensor.TensorError inner
    },
    InvalidSamplerState,
    RandomFailure {
        random.RandomError inner
    }
}

@ conversion
fn from_random_error(random.RandomError err) → DataError {
    return variant RandomFailure { message = err.message, inner = err }
}

@ conversion
fn from_tensor_error(tensor.TensorError err) → DataError {
    return variant TensorFailure { message = err.message, inner = err }
}

# Shared corpus gate: non-empty. Message identity is the proba pin surface.
fn require_ids(list<int> ids) → void ⇥ DataError {
    require ids.length() ≢ 0 throw variant EmptyCorpus { message = "corpus is empty" }
}

# -------------------------------------------------------------------------
# shuffle — deterministic Fisher–Yates over the corpus order, driven by
# gradus:random Seed/Draw (the training RNG; no second generator).
#   for i in 0 ‥ n−1: one xorshift64 draw;
#   pick j = i + ((draw ∧ MASK_63) mod (n − i)); swap positions i and j.
# The draw is masked to its low 63 bits (sign-agnostic, the random.next_f32
# precedent) so the modulo span is never negative. Deterministic: the same
# (ids, seed) reproduces the same order. A single-element corpus consumes
# no draw and the seed is returned unchanged. The advanced seed rides the
# Shuffled carrier so an epoch loop chains shuffles without reconstructing
# state.
# -------------------------------------------------------------------------

# Sign-bit mask: shuffle picks use only the low 63 bits of a draw.
const int MASK_63 = 9223372036854775807

@ public
class Shuffled {
    mut list<int> payload
    mut random.Seed seed
}

@ public
fn shuffle(list<int> ids, random.Seed seed) → Shuffled ⇥ DataError {
    require_ids(ids)
    let list<int> source ← ids
    let int n ← source.length()
    mut list<int> data ← copy source
    mut random.Seed s ← copy seed
    let int last ← n - 1
    for range 0 ‥ last let i {
        let random.Draw d ← random.next(s)
        s ← d.seed
        let int pick ← i + ((d.payload ∧ MASK_63) % (n - i))
        let int tmp ← data.get(i) coalesce 0
        data[i] ← data.get(pick) coalesce 0
        data[pick] ← tmp
    }
    return Shuffled { payload = data, seed = s }
}

# -------------------------------------------------------------------------
# batch — order-preserving slicing of a token-id corpus into
# consecutive batches of batch_size ids; the last batch is short when the
# length is not an exact multiple. Fail closed: empty corpus, batch size
# < 1, and batch size > corpus length are rejections — no partial or
# invented batches. Shuffling is the separate leaf function above;
# callers compose batch(shuffle(ids, seed).payload, size).
# -------------------------------------------------------------------------

@ public
fn batch(list<int> ids, int batch_size) → list<list<int>> ⇥ DataError {
    require_ids(ids)
    require batch_size ≥ 1 throw variant InvalidBatchSize { message = "batch size must be at least 1" }
    let list<int> source ← ids
    let int n ← source.length()
    require batch_size ≤ n throw variant InvalidBatchSize { message = "batch size exceeds corpus length" }
    mut list<list<int>> out ← empty
    mut int start ← 0
    while start ≺ n {
        mut int stop ← start + batch_size
        if stop ≻ n {
            stop ← n
        }
        mut list<int> chunk ← empty
        for range start ‥ stop let k {
            chunk.append(source.get(k) coalesce 0)
        }
        out.append(chunk)
        start ← stop
    }
    return out
}

# -------------------------------------------------------------------------
# Local supervised examples. Each sample is a fixed-width list<int>; batches
# materialize row-major F32 NumericBlock tensors with shape [rows, width].
# Input samples share one width and target samples share one width (the two
# widths may differ). Integer IDs are represented as f32. The final batch is
# retained short, never dropped or padded.
# -------------------------------------------------------------------------

import from "gradus:tensor" tensor

@ public
class Batch {
    let tensor.NumericBlock x
    let tensor.NumericBlock y
}

@ public
class SupervisedSet {
    let list<list<int>> inputs
    let list<list<int>> targets
}

@ public
class SupervisedSplit {
    let list<int> training
    let list<int> held_out
}

@ public
class ModulusSplit {
    let list<int> training_positions
    let list<int> held_out_positions
}

@ public
class SupervisedSampler {
    let string corpus
    let int seed
    let int epoch
    let int position
}

# One ordered sequence identity format serves both LM document corpora and
# supervised index lists. This preserves the LM identity bytes exactly.
@ public
fn data_identity(list<list<int>> sequences) → string {
    mut string identity ← ""
    for range 0 ‥ sequences.length() let i {
        let list<int> sequence ← sequences.get(i) coalesce ([] ∷ list<int>)
        identity ← identity + "d§:"(sequence.length() ↦ string)
        for range 0 ‥ sequence.length() let j {
            if j ≢ 0 { identity ← identity + "," }
            identity ← identity + (sequence.get(j) coalesce 0 ↦ string)
        }
        identity ← identity + ";"
    }
    return identity
}

# Shared modulus split returns positions, preserving input order in each side.
# Consumers provide a key per item: supervised rows use their index and LM
# documents use lm_document_score(document).
fn modulus_split(list<int> keys, int modulus) → ModulusSplit ⇥ DataError {
    require modulus ≥ 2 throw variant InvalidValidationModulus { message = "held-out modulus must be at least 2" }
    mut list<int> training ← empty
    mut list<int> held_out ← empty
    for range 0 ‥ keys.length() let i {
        if (keys.get(i) coalesce 0) % modulus ≡ 0 { held_out.append(i) } else { training.append(i) }
    }
    return ModulusSplit { training_positions = training, held_out_positions = held_out }
}

@ public
fn supervised_set(list<list<int>> inputs, list<list<int>> targets) → SupervisedSet ⇥ DataError {
    require inputs.length() ≡ targets.length() throw variant InvalidPairLengths { message = "input and target sample counts differ" }
    if inputs.length() ≻ 0 {
        let int input_width ← (inputs.get(0) coalesce ([] ∷ list<int>)).length()
        let int target_width ← (targets.get(0) coalesce ([] ∷ list<int>)).length()
        for range 0 ‥ inputs.length() let i {
            let int actual_input_width ← (inputs.get(i) coalesce ([] ∷ list<int>)).length()
            let int actual_target_width ← (targets.get(i) coalesce ([] ∷ list<int>)).length()
            require actual_input_width ≡ input_width throw variant InputWidthMismatch { message = "input sample widths differ: expected " + (input_width ↦ string) + ", got " + (actual_input_width ↦ string), expected_width = input_width, actual_width = actual_input_width }
            require actual_target_width ≡ target_width throw variant TargetWidthMismatch { message = "target sample widths differ: expected " + (target_width ↦ string) + ", got " + (actual_target_width ↦ string), expected_width = target_width, actual_width = actual_target_width }
        }
    }
    return SupervisedSet { inputs = inputs, targets = targets }
}

fn supervised_tensor(list<list<int>> rows, int width) → tensor.NumericBlock ⇥ DataError {
    mut list<f32> flat ← empty
    for range 0 ‥ rows.length() let r {
        let list<int> row ← rows.get(r) coalesce ([] ∷ list<int>)
        for range 0 ‥ width let c { flat.append((row.get(c) coalesce 0) ↦ f32) }
    }
    return tensor.construct(flat, [rows.length(), width])
}

@ public
fn supervised_split(int count, int held_out_modulus) → SupervisedSplit ⇥ DataError {
    mut list<int> indices ← empty
    for range 0 ‥ count let i { indices.append(i) }
    let ModulusSplit split ← modulus_split(indices, held_out_modulus)
    return SupervisedSplit { training = split.training_positions, held_out = split.held_out_positions }
}

@ public
fn epoch_order(list<int> train_set, random.Seed seed) → Shuffled ⇥ DataError {
    return shuffle(train_set, seed)
}

# Batch indices are positions in the shuffled epoch order; paired input and
# target samples are gathered with the same index before a batch is emitted.
# The final batch is short when needed; no sample is dropped or padded.
@ public
fn supervised_batches(SupervisedSet set, list<int> order, int batch_size) → list<Batch> ⇥ DataError {
    require_ids(order)
    require batch_size ≥ 1 throw variant InvalidBatchSize { message = "batch size must be at least 1" }
    mut list<Batch> out ← empty
    mut int start ← 0
    while start ≺ order.length() {
        mut int stop ← start + batch_size
        if stop ≻ order.length() { stop ← order.length() }
        mut list<list<int>> xs ← empty
        mut list<list<int>> ys ← empty
        for range start ‥ stop let p {
            let int index ← order.get(p) coalesce -1
            require index ≥ 0 and index ≺ set.inputs.length() and index ≺ set.targets.length() throw variant InvalidSamplerState { message = "sample index is outside the supervised set" }
            xs.append(set.inputs.get(index) coalesce ([] ∷ list<int>))
            ys.append(set.targets.get(index) coalesce ([] ∷ list<int>))
        }
        let int x_width ← (set.inputs.get(0) coalesce ([] ∷ list<int>)).length()
        let int y_width ← (set.targets.get(0) coalesce ([] ∷ list<int>)).length()
        out.append(Batch { x = supervised_tensor(xs, x_width), y = supervised_tensor(ys, y_width) })
        start ← stop
    }
    return out
}

@ public
fn supervised_indices_identity(list<int> indices) → string {
    return data_identity([indices])
}

@ public
fn supervised_sampler_start(list<int> train_set, random.Seed seed) → SupervisedSampler {
    return SupervisedSampler { corpus = supervised_indices_identity(train_set), seed = seed.status, epoch = 0, position = 0 }
}

# One versioned, # separated wire format and parser serve LM cursors and
# supervised sampler checkpoints. Field bytes are passed through unchanged.
fn versioned_wire(string version, list<string> fields) → string {
    mut string wire ← version
    for from fields let field { wire ← wire + "#" + field }
    return wire
}

fn parse_versioned_wire(string wire, string version, int field_count) → list<string> ∪ none {
    let list<string> parts ← wire.split("#")
    if parts.length() ≢ field_count or (parts.get(0) coalesce "") ≢ version then return null
    return parts
}

@ public
fn supervised_sampler_wire(SupervisedSampler state) → string {
    return versioned_wire("supervised-sampler-v1", [state.corpus, state.seed ↦ string, state.epoch ↦ string, state.position ↦ string])
}

fn parse_integer(string text) → int ∪ none {
    if text.length() ≡ 0 then return null
    mut int start ← 0
    if (text.slice(0, 1) ⊥ "") ≡ "-" {
        start ← 1
        if start ≡ text.length() then return null
    }
    for range start ‥ text.length() let i {
        let string c ← text.slice(i, i + 1) ⊥ ""
        if c ≢ "0" and c ≢ "1" and c ≢ "2" and c ≢ "3" and c ≢ "4" and c ≢ "5" and c ≢ "6" and c ≢ "7" and c ≢ "8" and c ≢ "9" {
            return null
        }
    }
    mut int value ← 0
    do { value ↤ text }
    catch err { return null }
    return value
}

@ public
fn supervised_sampler_parse(string wire) → SupervisedSampler ∪ none {
    let _ parts_value ← parse_versioned_wire(wire, "supervised-sampler-v1", 5)
    if parts_value is none then return null
    let list<string> parts ← parts_value coalesce ([] ∷ list<string>)
    let _ seed_value ← parse_integer(parts.get(2) coalesce "")
    let _ epoch_value ← parse_integer(parts.get(3) coalesce "")
    let _ position_value ← parse_integer(parts.get(4) coalesce "")
    if seed_value is none or epoch_value is none or position_value is none then return null
    let int seed ← seed_value coalesce 0
    let int epoch ← epoch_value coalesce 0
    let int position ← position_value coalesce 0
    if epoch ≺ 0 or position ≺ 0 then return null
    return SupervisedSampler { corpus = parts.get(1) coalesce "", seed = seed, epoch = epoch, position = position }
}

@ public
fn supervised_sampler_order(list<int> train_set, SupervisedSampler state) → Shuffled ∪ none {
    if state.corpus ≢ supervised_indices_identity(train_set) then return null
    mut random.Seed seed ← random.default()
    do { seed ← random.construct_seed(state.seed) }
    catch err { return null }
    do { return shuffle(train_set, seed) }
    catch err { return null }
}

@ public
class SupervisedStep {
    let Batch batch
    let SupervisedSampler state
}

@ public
fn supervised_sampler_step(SupervisedSet set, list<int> train_set, int batch_size, SupervisedSampler state) → SupervisedStep ∪ none ⇥ DataError {
    if state.corpus ≢ supervised_indices_identity(train_set) or batch_size ≤ 0 or train_set.length() ≡ 0 then return null
    mut int epoch ← state.epoch
    mut int position ← state.position
    if position ≥ train_set.length() {
        epoch ← epoch + 1
        position ← 0
    }
    mut random.Seed seed ← random.default()
    do { seed ← random.construct_seed(state.seed + epoch) }
    catch err { return null }
    let Shuffled shuffled ← epoch_order(train_set, seed)
    mut int stop ← position + batch_size
    if stop ≻ train_set.length() { stop ← train_set.length() }
    mut list<int> selected ← empty
    for range position ‥ stop let i { selected.append(shuffled.payload.get(i) coalesce -1) }
    let list<Batch> batches ← supervised_batches(set, selected, batch_size)
    let Batch next_batch ← batches.get(0) coalesce Batch { x = tensor.default(), y = tensor.default() }
    let SupervisedSampler next_state ← SupervisedSampler { corpus = state.corpus, seed = state.seed, epoch = epoch, position = stop }
    return SupervisedStep { batch = next_batch, state = next_state }
}

@ public
fn supervised_sampler_save(string path, SupervisedSampler state) → bool {
    do { lm_cursor_write_text(path, supervised_sampler_wire(state)) }
    catch err { return false }
    return true
}

@ public
fn supervised_sampler_load(string path) → SupervisedSampler ∪ none {
    mut string wire ← ""
    do { wire ← lm_cursor_read_text(path) }
    catch err { return null }
    return supervised_sampler_parse(wire)
}

# -------------------------------------------------------------------------
# Language-model byte vocabulary and stable corpus identity.
# -------------------------------------------------------------------------


@ public
const int LM_PAD_ID = 256
@ public
const int LM_VOCAB_SIZE = 257

@ public
fn lm_is_vocabulary_id(int id) → bool {
    return id ≥ 0 and id ≺ LM_VOCAB_SIZE
}

@ public
fn lm_vocabulary_id(int byte) → int ⇥ DataError {
    require byte ≥ 0 and byte ≤ 255 throw variant InvalidVocabularyId { message = "byte is outside the byte vocabulary" }
    return byte
}

@ public
fn lm_vocabulary_byte(int id) → int ⇥ DataError {
    require id ≥ 0 and id ≤ 255 throw variant InvalidVocabularyId { message = "id is outside the byte vocabulary" }
    return id
}

@ public
fn lm_document_score(list<int> document) → int {
    mut int score ← document.length()
    for range 0 ‥ document.length() let i {
        score ← score + (document.get(i) coalesce 0)
    }
    return score
}

@ public
fn lm_corpus_identity(list<list<int>> documents) → string {
    return data_identity(documents)
}

# -------------------------------------------------------------------------
# LM windows — fixed-width, non-overlapping next-token examples. Each
# document is divided into windows with stride equal to length; values beyond
# the document are right-padded and contribute no loss. A non-positive window
# length is a typed DataError rejection.
# -------------------------------------------------------------------------

@ public
class LmWindow {
    let int document
    let int start
    let list<int> inputs
    let list<int> targets
    let list<int> loss_mask
}

@ public
fn lm_windows(list<int> tokens, int length, int document) → list<LmWindow> ⇥ DataError {
    require length ≻ 0 throw variant InvalidWindowLength { message = "window length must be positive" }
    let int n ← tokens.length()
    mut list<LmWindow> windows ← empty
    mut int start ← 0
    while start ≺ n {
        mut list<int> inputs ← empty
        mut list<int> targets ← empty
        mut list<int> loss_mask ← empty
        for range 0 ‥ length let k {
            let int input_index ← start + k
            if input_index ≺ n {
                inputs.append(tokens.get(input_index) coalesce LM_PAD_ID)
            } else {
                inputs.append(LM_PAD_ID)
            }
            let int target_index ← input_index + 1
            if target_index ≺ n {
                targets.append(tokens.get(target_index) coalesce LM_PAD_ID)
                loss_mask.append(1)
            } else {
                targets.append(LM_PAD_ID)
                loss_mask.append(0)
            }
        }
        windows.append(LmWindow { document = document, start = start, inputs = inputs, targets = targets, loss_mask = loss_mask })
        start ← start + length
    }
    return windows
}

# -------------------------------------------------------------------------
# Document-level deterministic training/validation split. Documents remain
# intact, and each output preserves the input order within its split.
# -------------------------------------------------------------------------

@ public
class LmSplit {
    let list<list<int>> training
    let list<list<int>> validation
}

@ public
fn lm_split_documents(list<list<int>> documents, int validation_modulus) → LmSplit ⇥ DataError {
    mut list<int> scores ← empty
    for range 0 ‥ documents.length() let i {
        scores.append(lm_document_score(documents.get(i) coalesce ([] ∷ list<int>)))
    }
    let ModulusSplit split ← modulus_split(scores, validation_modulus)
    mut list<list<int>> training ← empty
    mut list<list<int>> validation ← empty
    for from split.training_positions let i { training.append(documents.get(i) coalesce ([] ∷ list<int>)) }
    for from split.held_out_positions let i { validation.append(documents.get(i) coalesce ([] ∷ list<int>)) }
    return LmSplit { training = training, validation = validation }
}

# -------------------------------------------------------------------------
# Restartable LM cursor. The cursor's document is an original-corpus index;
# its window is the next fixed-width window within that document. The corpus
# field is the exact lm_corpus_identity of the ordered documents used to
# create the cursor; next/advance reject a cursor if it differs from the
# supplied documents (including content or order changes). A consumed
# traversal ends at the exhausted position, which resumes nowhere.
# -------------------------------------------------------------------------

@ public
class LmCursor {
    let string corpus
    let string split
    let int document
    let int window
}

@ public
fn lm_cursor_start(string corpus, string split) → LmCursor {
    return LmCursor { corpus = corpus, split = split, document = -1, window = 0 }
}

@ public
fn lm_cursor_wire(LmCursor cursor) → string {
    return versioned_wire("lm-cursor-v1", [cursor.corpus, cursor.split, cursor.document ↦ string, cursor.window ↦ string])
}

@ public
fn lm_cursor_parse(string wire) → LmCursor ∪ none {
    let _ parts_value ← parse_versioned_wire(wire, "lm-cursor-v1", 5)
    if parts_value is none then return null
    let list<string> parts ← parts_value coalesce ([] ∷ list<string>)
    let string corpus ← parts.get(1) coalesce ""
    let string split ← parts.get(2) coalesce ""
    let string document_text ← parts.get(3) coalesce ""
    let string window_text ← parts.get(4) coalesce ""
    let _ parsed_document ← parse_integer(document_text)
    let _ parsed_window ← parse_integer(window_text)
    if parsed_document is none or parsed_window is none then return null
    let int document ← parsed_document coalesce 0
    let int window ← parsed_window coalesce 0
    return LmCursor { corpus = corpus, split = split, document = document, window = window }
}

fn lm_cursor_contains(list<list<int>> documents, list<int> document) → bool {
    for range 0 ‥ documents.length() let i {
        if (documents.get(i) coalesce ([] ∷ list<int>)) ≡ document {
            return true
        }
    }
    return false
}

# Resolve a possibly initial or stale cursor to the next selected window's
# canonical original-document index and within-document window index. An
# exhausted cursor (a document below the initial -1) resolves to none, which
# is how a traversal reports the end of its split.
fn lm_cursor_locate(list<list<int>> documents, LmSplit split, LmCursor cursor, int length) → LmCursor ∪ none {
    if cursor.corpus ≢ lm_corpus_identity(documents) then return null
    if length ≤ 0 or cursor.document ≺ -1 or cursor.window ≺ 0 then return null
    mut list<list<int>> selected ← empty
    if cursor.split ≡ "training" {
        selected ← split.training
    }
    elif cursor.split ≡ "validation" {
        selected ← split.validation
    }
    else {
        return null
    }
    for range 0 ‥ documents.length() let i {
        if i ≥ cursor.document {
            let list<int> document ← documents.get(i) coalesce ([] ∷ list<int>)
            if lm_cursor_contains(selected, document) and document.length() ≻ 0 {
                mut int window ← 0
                if i ≡ cursor.document {
                    window ← cursor.window
                }
                let int window_count ← ((document.length() - 1) / length) + 1
                if window ≺ window_count {
                    return LmCursor { corpus = cursor.corpus, split = cursor.split, document = i, window = window }
                }
            }
        }
    }
    return null
}

fn lm_cursor_window_at(list<int> tokens, int length, int document, int window) → LmWindow {
    let int start ← window * length
    mut list<int> inputs ← empty
    mut list<int> targets ← empty
    mut list<int> loss_mask ← empty
    for range 0 ‥ length let k {
        let int input_index ← start + k
        if input_index ≺ tokens.length() {
            inputs.append(tokens.get(input_index) coalesce LM_PAD_ID)
        } else {
            inputs.append(LM_PAD_ID)
        }
        let int target_index ← input_index + 1
        if target_index ≺ tokens.length() {
            targets.append(tokens.get(target_index) coalesce LM_PAD_ID)
            loss_mask.append(1)
        } else {
            targets.append(LM_PAD_ID)
            loss_mask.append(0)
        }
    }
    return LmWindow { document = document, start = start, inputs = inputs, targets = targets, loss_mask = loss_mask }
}

@ public
fn lm_cursor_next(list<list<int>> documents, LmSplit split, LmCursor cursor, int length) → LmWindow ∪ none {
    let _ location_value ← lm_cursor_locate(documents, split, cursor, length)
    if location_value is none then return null
    let LmCursor location ← location_value coalesce LmCursor { corpus = "", split = "", document = -1, window = 0 }
    let list<int> document ← documents.get(location.document) coalesce ([] ∷ list<int>)
    return lm_cursor_window_at(document, length, location.document, location.window)
}

@ public
fn lm_cursor_advance(list<list<int>> documents, LmSplit split, LmCursor cursor, int length) → LmCursor ∪ none {
    let _ location_value ← lm_cursor_locate(documents, split, cursor, length)
    if location_value is none then return null
    let LmCursor location ← location_value coalesce LmCursor { corpus = "", split = "", document = -1, window = 0 }
    return lm_cursor_locate(documents, split, LmCursor { corpus = location.corpus, split = location.split, document = location.document, window = location.window + 1 }, length)
}

# The wire's exhausted position: a document index below the initial -1, so a
# finished cursor is never mistaken for a start cursor and never resumes a
# document.
@ public
const int LM_CURSOR_EXHAUSTED = -2

# The terminal cursor for a traversal: keep the corpus and the split, and mark
# the position exhausted. A run that consumes a split's final window persists
# this cursor, so a fresh process loads it, finds no next window, and reports
# exhaustion instead of replaying the window it already consumed.
@ public
fn lm_cursor_finish(LmCursor cursor) → LmCursor {
    return LmCursor { corpus = cursor.corpus, split = cursor.split, document = LM_CURSOR_EXHAUSTED, window = 0 }
}

# -------------------------------------------------------------------------
# Cursor persistence. A fresh process resumes from the file alone: the bytes
# on disk are exactly the cursor wire, and the loaded cursor is the parse of
# those bytes. A missing or unreadable file loads as none — never a guessed
# cursor. A save reports whether the wire reached the disk: it is true only
# when the write completed, and false when the write failed, in which case
# the previous file (or no file) is left in place. A false save is NOT a
# checkpoint — the persisted state is stale or absent, so a caller that keeps
# training past it would replay windows after a restart. Check the result at
# the acceptance boundary; a retry is the caller's decision.
# -------------------------------------------------------------------------

fn lm_cursor_read_text(string path) → string ⇥ fault.IoFault {
    return fs.read_file<string>(path)
}

fn lm_cursor_write_text(string path, string wire) → none ⇥ fault.IoFault {
    fs.write_file(path, wire)
}

@ public
fn lm_cursor_save(string path, LmCursor cursor) → bool {
    do {
        lm_cursor_write_text(path, lm_cursor_wire(cursor))
    }
    catch err {
        return false
    }
    return true
}

@ public
fn lm_cursor_load(string path) → LmCursor ∪ none {
    mut string wire ← ""
    do {
        wire ← lm_cursor_read_text(path)
    }
    catch err {
        return null
    }
    return lm_cursor_parse(wire)
}
