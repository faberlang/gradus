+++ toml
locale = "en"

+++ faber
# Construction helpers for the decode_token record-contract tests. Class
# constructions of imported classes work at module scope but not inside a
# co-located test scope (radix #2517 follow-up: the synthesized test-scope
# import uses the retired `const` binding form and binds nothing), so the
# tests build their records through these module-scope builders.

import from "gradus:decode_token" let dt

type LW = dt.LayerWeights<size 4, size 4, size 4, size 6>
type SV = dt.SlotView<size 4, size 4>
type WS = dt.Workspace<size 4, size 4, size 4, size 6, size 2, size 4, size 2>
type LP = dt.LayerParams

@ public
fn close(f32 a, f32 b) → bool {
    return (a - b).abs() ≺ 0.0001
}

@ public
fn weight(int r, int c, int salt) → f32 {
    return (((r * 7 + c * 3 + salt * 5) % 17 - 8) ↦ f32) * 0.025
}

@ public
fn build_lp(i32 bpdh, i32 bpspan, i32 bpgroup, i32 bprope, f32 beps, f32 blntheta, f32 bscale) → LP {
    return dt.LayerParams { pdh = bpdh, pspan = bpspan, pgroup = bpgroup, prope = bprope, peps = beps, plntheta = blntheta, pscale = bscale }
}

@ public
fn build_sv(mut tensor<f32, [4, 4]> skin, mut tensor<f32, [4, 4]> svin, i32 spos) → SV {
    return dt.SlotView<size 4, size 4> { kin = skin, vin = svin, pos = spos }
}

@ public
fn build_lw(tensor<f32, [4]> lanorm, tensor<f32, [4, 4]> lwq, tensor<f32, [4, 4]> lwk, tensor<f32, [4, 4]> lwv, tensor<f32, [4, 4]> lwo, tensor<f32, [4]> lfnorm, tensor<f32, [6, 4]> lwg, tensor<f32, [6, 4]> lwu, tensor<f32, [4, 6]> lwd, i32 lqkv_bias, tensor<f32, [4]> lbq, tensor<f32, [4]> lbk, tensor<f32, [4]> lbv) → LW {
    return dt.LayerWeights<size 4, size 4, size 4, size 6> { anorm = lanorm, wq = lwq, wk = lwk, wv = lwv, wo = lwo, fnorm = lfnorm, wg = lwg, wu = lwu, wd = lwd, qkv_bias = lqkv_bias, bq = lbq, bk = lbk, bv = lbv }
}

@ public
fn build_ws(tensor<f32, [2, 4]> whcdom, tensor<f32, [2, 4]> wcpdom, tensor<f32, [4]> wqdom, mut tensor<f32, [4]> wxn, mut tensor<f32, [4]> wq, mut tensor<f32, [4]> wqr, mut tensor<f32, [4]> wk, mut tensor<f32, [4]> wkr, mut tensor<f32, [4]> wv, mut tensor<f32, [2, 4]> wsc, mut tensor<f32, [2, 4]> wpr, mut tensor<f32, [2, 4]> wcp, mut tensor<f32, [4]> wctx, mut tensor<f32, [4]> wh1, mut tensor<f32, [6]> wgate, mut tensor<f32, [6]> wup, mut tensor<f32, [6]> wact) → WS {
    return dt.Workspace<size 4, size 4, size 4, size 6, size 2, size 4, size 2> { hcdom = whcdom, cpdom = wcpdom, qdom = wqdom, xn = wxn, q = wq, qr = wqr, k = wk, kr = wkr, v = wv, sc = wsc, pr = wpr, cp = wcp, ctx = wctx, h1 = wh1, gate = wgate, up = wup, act = wact }
}

# One layer_wide pass on a private workspace and slot at position 1. The
# record-contract tests run one fully fresh pass per proof so no result
# buffer is ever written twice.
@ public
fn run_prope(LW prlw, LP prlp, tensor<f32, [4]> prhin, mut tensor<f32, [1]> prsink, mut tensor<f32, [4]> prout) → void {
    let tensor<f32, [2, 4]> prhcdom ← tf32[2, 4] {}
    let tensor<f32, [2, 4]> prcpdom ← tf32[2, 4] {}
    let tensor<f32, [4]> prqdom ← tf32[4] {}
    mut tensor<f32, [4]> prxn ← tf32[4] {}
    mut tensor<f32, [4]> prq ← tf32[4] {}
    mut tensor<f32, [4]> prqr ← tf32[4] {}
    mut tensor<f32, [4]> prk ← tf32[4] {}
    mut tensor<f32, [4]> prkr ← tf32[4] {}
    mut tensor<f32, [4]> prv ← tf32[4] {}
    mut tensor<f32, [2, 4]> prsc ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> prpr ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> prcp ← tf32[2, 4] {}
    mut tensor<f32, [4]> prctx ← tf32[4] {}
    mut tensor<f32, [4]> prh1 ← tf32[4] {}
    mut tensor<f32, [6]> prgate ← tf32[6] {}
    mut tensor<f32, [6]> prup ← tf32[6] {}
    mut tensor<f32, [6]> pract ← tf32[6] {}
    mut _ prws ← build_ws(prhcdom, prcpdom, prqdom, mut prxn, mut prq, mut prqr, mut prk, mut prkr, mut prv, mut prsc, mut prpr, mut prcp, mut prctx, mut prh1, mut prgate, mut prup, mut pract)
    mut tensor<f32, [4, 4]> prkin ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> prvin ← tf32[4, 4] {}
    for exclusive 2 let r {
        for exclusive 4 let c {
            prkin[[r, c]] ← ((r + 1) * (c + 1) ↦ f32) * 0.1
            prvin[[r, c]] ← ((r * 2 + c + 1) ↦ f32) * 0.05
        }
    }
    mut _ prsv ← build_sv(mut prkin, mut prvin, 1)
    dt.prime_workspace(mut prws, mut prsink)
    dt.layer_wide(prhin, mut prout, prlw, mut prsv, prlp, mut prws)
}
