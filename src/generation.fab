# Generation configuration, cursor policy, and generation sessions.
#
# Public import: import from "gradus:generation" generation
# Depends on: gradus:attention (dense-engine rope configuration),
#   gradus:cache and gradus:model/dense (KV-backed sessions),
#   gradus:decode (decoder sessions and cancellation),
#   gradus:dtype (finite checks), gradus:sampling (sampling policy),
#   gradus:tensor (numeric carriers), gradus:tokenizer (EOG policy), and
#   gradus:train (seed values).
#
# GenerationConfig is the single configuration authority. Unsupported controls
# are rejected rather than ignored. Cursor limits reject rather than truncate,
# and session drivers remain ordinary host-side functions rather than kernels.
# The versioned wire keeps legacy 1.0.0 disabled-policy records readable while
# 1.1.0 records carry the acceleration policy explicitly.

import from "gradus:attention" attention

import from "gradus:cache" kv

import from "gradus:decode" decode

import from "gradus:dtype" dtype

import from "gradus:model/dense" dense

import from "gradus:sampling" sampling

import from "gradus:tensor" tensor

import from "gradus:tokenizer" tokenizer

import from "gradus:train" train

# --- error vocabulary ----------------------------------------------------
# Every variant carries a text message exposed through the shared field.

@ public
union GenerationError {
    @ shared
    string message

    InvalidConfig,
    ElementMismatch,
    DtypeMismatch,
    Incompatible,
    UnknownVersion,
    BadWire,
    LimitReached,
    Cancelled,
    DecodeFailure,
    SampledAccelerationRejected
}



# --- wire schema ----------------------------------------------------------
# Schema 1.1.0 carries one AccelerationPolicy segment; legacy 1.0.0 records
# decode to the disabled policy.
const string SCHEMA_VERSION_LEGACY ← "1.0.0"

const string SCHEMA_VERSION ← "1.1.0"

const string POLICY_VERSION ← "1.0.0"

# --- acceleration policy -------------------------------------------------
# The policy records mode and block bounds; lookup and candidate execution
# remain outside this configuration module.

@ public
union AccelerationMode {
    Disabled,
    ContextLookup
}

@ public
fn acceleration_disabled() → AccelerationMode {
    return variant Disabled
}

@ public
fn acceleration_context_lookup() → AccelerationMode {
    return variant ContextLookup
}

@ public
fn acceleration_mode_name(AccelerationMode m) → string {
    match m {
        case Disabled {
            return "disabled"
        }
        case ContextLookup {
            return "context_lookup"
        }
    }
}

fn acceleration_mode_from_name(string s) → AccelerationMode ⇥ GenerationError {
    if s ≡ "disabled" then return variant Disabled
    if s ≡ "context_lookup" then return variant ContextLookup
    throw variant BadWire {message = "unknown acceleration mode"}
}

@ public
class AccelerationPolicy {
    string version
    AccelerationMode mode
    int min_block
    int max_block
}

@ public
fn construct_acceleration(string version, AccelerationMode mode, int min_block, int max_block) → AccelerationPolicy ⇥ GenerationError {
    require version ≡ POLICY_VERSION throw variant UnknownVersion {message = "unknown acceleration policy version"}
    require min_block ≥ 1 throw variant InvalidConfig {message = "acceleration block size must be at least one"}
    require max_block ≥ 1 throw variant InvalidConfig {message = "acceleration block size must be at least one"}
    require min_block ≤ max_block throw variant InvalidConfig {message = "acceleration block size minimum must not exceed the maximum"}
    return AccelerationPolicy {version = version, mode = mode, min_block = min_block, max_block = max_block}
}

@ public
fn default_acceleration() → AccelerationPolicy {
    return AccelerationPolicy {version = "", mode = variant Disabled, min_block = 0, max_block = 0}
}

@ public
fn acceleration_equal(AccelerationPolicy a, AccelerationPolicy b) → bool {
    if a.version ≠ b.version then return false
    if acceleration_mode_name(a.mode) ≠ acceleration_mode_name(b.mode) then return false
    if a.min_block ≠ b.min_block then return false
    if a.max_block ≠ b.max_block then return false
    return true
}

# --- generation configuration --------------------------------------------


@ public
class GenerationConfig {
    int context
    int max_prompt
    int max_tokens
    int seed
    f32 temperature
    int top_k
    f32 top_p
    f32 min_p
    f32 repetition_penalty
    AccelerationPolicy acceleration
}

# Config equality is the round-trip and deterministic-mapping predicate.
@ public
fn generation_equal(GenerationConfig a, GenerationConfig b) → bool {
    if a.context ≠ b.context then return false
    if a.max_prompt ≠ b.max_prompt then return false
    if a.max_tokens ≠ b.max_tokens then return false
    if a.seed ≠ b.seed then return false
    if a.temperature ≠ b.temperature then return false
    if a.top_k ≠ b.top_k then return false
    if a.top_p ≠ b.top_p then return false
    if a.min_p ≠ b.min_p then return false
    if a.repetition_penalty ≠ b.repetition_penalty then return false
    if not acceleration_equal(a.acceleration, b.acceleration) then return false
    return true
}

# --- configuration admission (fail closed) -------------------------------

@ public
fn construct_generation_with_policy(int context, int max_prompt, int max_tokens, int seed, f32 temperature, int top_k, f32 top_p, f32 min_p, f32 repetition_penalty, AccelerationPolicy acceleration) → GenerationConfig ⇥ GenerationError {
    require context ≥ 1 throw variant InvalidConfig {message = "context length must be at least one"}
    require max_prompt ≥ 1 throw variant InvalidConfig {message = "prompt batch size must be at least one"}
    require max_tokens ≥ 1 throw variant InvalidConfig {message = "maximum generated tokens must be at least one"}
    require max_tokens ≤ context throw variant InvalidConfig {message = "maximum generated tokens must fit within the context"}
    require seed ≥ 1 throw variant InvalidConfig {message = "seed must be at least one"}
    require dtype.finite(temperature) throw variant InvalidConfig {message = "temperature must be non-negative"}
    require temperature ≥ 0.0 throw variant InvalidConfig {message = "temperature must be non-negative"}
    require top_k ≥ 0 throw variant InvalidConfig {message = "top-k must be non-negative"}
    require dtype.finite(top_p) throw variant InvalidConfig {message = "top-p must be within [0, 1]"}
    require top_p ≥ 0.0 throw variant InvalidConfig {message = "top-p must be within [0, 1]"}
    require top_p ≤ 1.0 throw variant InvalidConfig {message = "top-p must be within [0, 1]"}
    require dtype.finite(min_p) throw variant InvalidConfig {message = "min-p must be within [0, 1]"}
    require min_p ≥ 0.0 throw variant InvalidConfig {message = "min-p must be within [0, 1]"}
    require min_p ≤ 1.0 throw variant InvalidConfig {message = "min-p must be within [0, 1]"}
    require dtype.finite(repetition_penalty) throw variant InvalidConfig {message = "repetition penalty must be at least one"}
    require repetition_penalty ≥ 1.0 throw variant InvalidConfig {message = "repetition penalty must be at least one"}
    const AccelerationPolicy checked ← construct_acceleration(acceleration.version, acceleration.mode, acceleration.min_block, acceleration.max_block)
    return GenerationConfig {context = context, max_prompt = max_prompt, max_tokens = max_tokens, seed = seed, temperature = temperature, top_k = top_k, top_p = top_p, min_p = min_p, repetition_penalty = repetition_penalty, acceleration = checked}
}

@ public
fn construct_generation(int context, int max_prompt, int max_tokens, int seed, f32 temperature, int top_k, f32 top_p, f32 min_p, f32 repetition_penalty) → GenerationConfig ⇥ GenerationError {
    const AccelerationPolicy disabled ← construct_acceleration(POLICY_VERSION, variant Disabled, 1, 1)
    return construct_generation_with_policy(context, max_prompt, max_tokens, seed, temperature, top_k, top_p, min_p, repetition_penalty, disabled)
}

# Placeholder Default for `var GenerationConfig` bindings (var on structs).
# Zero fields (not a valid config). Only a placeholder the caller
# overwrites, or returns from an unreachable cape arm.
@ public
fn default() → GenerationConfig {
    return GenerationConfig {context = 0, max_prompt = 0, max_tokens = 0, seed = 0, temperature = 0.0, top_k = 0, top_p = 0.0, min_p = 0.0, repetition_penalty = 0.0, acceleration = default_acceleration()}
}

# --- neutral configuration fallback -------------------------------------

@ public
fn generation_failure(int context, int max_prompt, int max_tokens, int seed) → GenerationConfig ⇥ GenerationError {
    return construct_generation(context, max_prompt, max_tokens, seed, 1.0, 0, 1.0, 0.0, 1.0)
}

# --- supported controls --------------------------------------------------

@ public
fn support_flags() → list<string> {
    return ["context", "max_prompt", "max_tokens", "seed", "temperature", "top_k", "top_p", "min_p", "repetition_penalty", "acceleration"]
}

# Admission predicate: true iff the control name is a supported field.
@ public
fn admitted_features(string name) → bool {
    return name between support_flags()
}

# --- runtime projections -------------------------------------------------

# The five sampling fields project exactly onto the U3 Config (the
# config validated the same domains — the mapping never fails).
@ public
fn config(GenerationConfig g) → sampling.Config ⇥ GenerationError {
    do {
        return sampling.construct_config(g.temperature, g.top_k, g.top_p, g.min_p, g.repetition_penalty)
    }
    catch err {
        const string c ← err.message
        throw variant InvalidConfig {message = c}
    }
    throw variant InvalidConfig {message = "unreachable"}
}

# The seed projects exactly onto the U5 Seed (the config validated
# seed ≥ 1 — the mapping never fails).
@ public
fn seed(GenerationConfig g) → train.Seed ⇥ GenerationError {
    do {
        return train.construct_seed(g.seed)
    }
    catch err {
        const string c ← err.message
        throw variant InvalidConfig {message = c}
    }
    throw variant InvalidConfig {message = "unreachable"}
}

# --- versioned configuration wire ---------------------------------------

fn serialize_acceleration(AccelerationPolicy p) → string {
    return "§:§:§:§"(p.version, acceleration_mode_name(p.mode), p.min_block ↦ string, p.max_block ↦ string)
}

@ public
fn serialize_generation(GenerationConfig g) → string {
    const string head ← "generation/config/§/§/§/§/§/§/§/§/§/§"(SCHEMA_VERSION, g.context ↦ string, g.max_prompt ↦ string, g.max_tokens ↦ string, g.seed ↦ string, g.temperature ↦ string, g.top_k ↦ string, g.top_p ↦ string, g.min_p ↦ string, g.repetition_penalty ↦ string)
    return "§/§"(head, serialize_acceleration(g.acceleration))
}

fn digit(string c) → bool {
    return c between "0123456789"
}

fn numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    for from s const c {
        # String iteration binds a one-character value; convert before comparing.
        if not digit(c ↦ string) then return false
    }
    return true
}

fn wire_int(string text, string detail) → int ⇥ GenerationError {
    require numeric(text) throw variant BadWire {message = detail}
    do {
        return text ↦ int
    }
    catch err {
        throw variant BadWire {message = detail}
    }
    throw variant BadWire {message = detail}
}

fn wire_f32(string text, string detail) → f32 ⇥ GenerationError {
    do {
        return text ↦ f32
    }
    catch err {
        throw variant BadWire {message = detail}
    }
    throw variant BadWire {message = detail}
}

fn deserialize_acceleration(string segment) → AccelerationPolicy ⇥ GenerationError {
    const list<string> bits ← segment.split(":")
    require bits.length() ≡ 4 throw variant BadWire {message = "malformed acceleration policy"}
    const string version ← bits.get(0) coalesce ""
    const AccelerationMode mode ← acceleration_mode_from_name(bits.get(1) coalesce "")
    const int min_block ← wire_int(bits.get(2) coalesce "", "malformed acceleration block size in generation wire")
    const int max_block ← wire_int(bits.get(3) coalesce "", "malformed acceleration block size in generation wire")
    return construct_acceleration(version, mode, min_block, max_block)
}

@ public
fn deserialize_generation(string wire) → GenerationConfig ⇥ GenerationError {
    const list<string> parts ← wire.split("/")
    require parts.length() ≥ 12 throw variant BadWire {message = "malformed generation config wire"}
    require parts.length() ≤ 13 throw variant BadWire {message = "malformed generation config wire"}
    require parts.get(0) coalesce "" ≡ "generation" throw variant BadWire {message = "unknown generation marker"}
    require parts.get(1) coalesce "" ≡ "config" throw variant BadWire {message = "unknown generation marker"}
    const string version ← parts.get(2) coalesce ""
    if version ≡ SCHEMA_VERSION_LEGACY {
        require parts.length() ≡ 12 throw variant BadWire {message = "malformed generation config wire"}
    }
    if version ≡ SCHEMA_VERSION {
        require parts.length() ≡ 13 throw variant BadWire {message = "malformed generation config wire"}
    }
    if version ≠ SCHEMA_VERSION_LEGACY {
        require version ≡ SCHEMA_VERSION throw variant UnknownVersion {message = "unknown generation schema version"}
    }
    const int context ← wire_int(parts.get(3) coalesce "", "malformed context length in generation wire")
    const int max_prompt ← wire_int(parts.get(4) coalesce "", "malformed prompt batch in generation wire")
    const int max_tokens ← wire_int(parts.get(5) coalesce "", "malformed max tokens in generation wire")
    const int seed ← wire_int(parts.get(6) coalesce "", "malformed seed in generation wire")
    const f32 temperature ← wire_f32(parts.get(7) coalesce "", "malformed temperature in generation wire")
    const int top_k ← wire_int(parts.get(8) coalesce "", "malformed top-k in generation wire")
    const f32 top_p ← wire_f32(parts.get(9) coalesce "", "malformed top-p in generation wire")
    const f32 min_p ← wire_f32(parts.get(10) coalesce "", "malformed min-p in generation wire")
    const f32 penalty ← wire_f32(parts.get(11) coalesce "", "malformed repetition penalty in generation wire")
    if version ≡ SCHEMA_VERSION_LEGACY {
        return construct_generation(context, max_prompt, max_tokens, seed, temperature, top_k, top_p, min_p, penalty)
    }
    return construct_generation_with_policy(context, max_prompt, max_tokens, seed, temperature, top_k, top_p, min_p, penalty, deserialize_acceleration(parts.get(12) coalesce ""))
}

# --- generation cursor ---------------------------------------------------
# Cursor advancement rejects rather than truncates when either the context or
# generated-token limit is reached. Reset preserves the session context.


@ public
class GenerationCursor {
    decode.Session session
    int emitted
}

# A fresh cursor at position 0 with count 0 over the config's context.
@ public
fn fresh_cursor(GenerationConfig g) → GenerationCursor ⇥ GenerationError {
    var decode.Session s ← decode.default_session()
    do {
        s ← decode.fresh_session(g.context)
        return GenerationCursor {session = s, emitted = 0}
    }
    catch err {
        throw variant InvalidConfig {message = err.message}
    }
    throw variant InvalidConfig {message = "unreachable"}
}

# Placeholder Default for `var GenerationCursor` bindings (var on structs).
# Empty session (not a valid cursor). Only a placeholder the caller
# overwrites, or returns from an unreachable cape arm.
@ public
fn default_cursor() → GenerationCursor {
    return GenerationCursor {session = decode.default_session(), emitted = 0}
}

# The explicit limit-policy predicate: another token is allowed iff the
# session position is below the context limit AND the generated count is
# below the maximum-generated-tokens limit.
@ public
fn token_allowed(GenerationConfig g, GenerationCursor c) → bool {
    if c.session.position ≥ g.context then return false
    if c.emitted ≥ g.max_tokens then return false
    return true
}

# The next step — REJECTS (never truncates) when the step would exceed the
# max-tokens limit or the context limit; otherwise advances the session
# position by one and the count by one.
@ public
fn cursor_advance(GenerationConfig g, GenerationCursor c) → GenerationCursor ⇥ GenerationError {
    require c.emitted ≺ g.max_tokens throw variant LimitReached {message = "maximum generated tokens reached"}
    require c.session.position ≺ g.context throw variant LimitReached {message = "context limit reached"}
    return GenerationCursor {session = decode.Session {position = c.session.position + 1, context = c.session.context}, emitted = c.emitted + 1}
}

# Reset the cursor to the fresh state: session position 0 (the U1
# reset precedent, context preserved) with the count cleared.
@ public
fn cursor_reset(GenerationCursor c) → GenerationCursor {
    return GenerationCursor {session = decode.Session {position = 0, context = c.session.context}, emitted = 0}
}

# --- stop policy ----------------------------------------------------------
# IgnoreEos masks the admitted EOG ids with a finite negative logit so the
# sampler's finite-value contract remains intact.

@ public
union StopPolicy {
    Eog,
    IgnoreEos
}

@ public
fn eog_stop() → StopPolicy {
    return variant Eog
}

@ public
fn ignore_eos() → StopPolicy {
    return variant IgnoreEos
}

@ public
fn stop_policy_name(StopPolicy p) → string {
    match p {
        case Eog {
            return "eog"
        }
        case IgnoreEos {
            return "ignore_eos"
        }
    }
}

@ public
fn stops_on_eog(StopPolicy p) → bool {
    match p {
        case Eog {
            return true
        }
        case IgnoreEos {
            return false
        }
    }
}

# Finite EOG mask. Sampling rejects non-finite logits, so this is a
# large negative rather than -inf. Any real vocab logit wins over it.
fn suppress_eog(list<f32> logits) → list<f32> {
    var list<f32> out ← empty
    # The index is the vocabulary id consumed by tokenizer.is_eog.
    for range 0‥logits.length() const i {
        if tokenizer.is_eog(i) {
            out.append((-1000000000.0) ∷ f32)
        }
        else {
            out.append(logits.get(i) coalesce 0.0 ∷ f32)
        }
    }
    return out
}

fn sample_logits(list<f32> logits, StopPolicy stop) → list<f32> {
    if stops_on_eog(stop) {
        return logits
    }
    return suppress_eog(logits)
}

# Cursor sitting just after a prompt of length prompt_len: next decode
# position is the prompt length, generated count is 0. Rejects an empty
# prompt and a prompt that leaves no room in the context.
@ public
fn cursor_after_prompt(GenerationConfig g, int prompt_len) → GenerationCursor ⇥ GenerationError {
    require prompt_len ≥ 1 throw variant InvalidConfig {message = "needs at least one prompt token"}
    require prompt_len ≺ g.context throw variant InvalidConfig {message = "prompt length does not fit context"}
    return GenerationCursor {session = decode.Session {position = prompt_len, context = g.context}, emitted = 0}
}

# --- decoder generation --------------------------------------------------

fn observe(decode.Cancellation cancel) → void ⇥ GenerationError {
    do {
        const decode.Cancellation _ ← decode.observe_cancellation(cancel)
        return
    }
    catch err {
        throw variant Cancelled {message = err.message}
    }
}

fn sample(list<f32> logits, sampling.Config c, list<int> history, train.Seed seed) → sampling.Sampler ⇥ GenerationError {
    do {
        return sampling.sample(logits, c, history, seed)
    }
    catch err {
        throw variant DecodeFailure {message = err.message}
    }
}

fn prefill(list<int> prompt_ids, decode.Decoder m) → tensor.NumericBlock ⇥ GenerationError {
    do {
        return decode.prefill(prompt_ids, m)
    }
    catch err {
        throw variant DecodeFailure {message = err.message}
    }
}

fn decode_one(int token_id, int position, decode.Decoder m) → tensor.NumericBlock ⇥ GenerationError {
    do {
        return decode.decode_data(token_id, position, m)
    }
    catch err {
        throw variant DecodeFailure {message = err.message}
    }
}

fn last_logits(tensor.NumericBlock logits, int vocab) → list<f32> ⇥ GenerationError {
    # NumericBlock carries a runtime shape; validate its rank before indexing.
    const list<int> shape ← logits.shape
    if shape.length() ≡ 1 {
        return logits.data
    }
    require shape.length() ≡ 2 throw variant DecodeFailure {message = "decode logits must be rank-1 or rank-2"}
    const int rows ← shape.get(0) coalesce 0
    const int cols ← shape.get(1) coalesce 0
    require rows ≥ 1 throw variant DecodeFailure {message = "decode logits shape does not match the vocabulary"}
    require cols ≡ vocab throw variant DecodeFailure {message = "decode logits shape does not match the vocabulary"}
    var list<f32> row ← empty
    # NumericBlock data is flat; the row index selects the final row.
    for range 0‥vocab const i {
        do {
            row.append(logits.get([rows - 1, i]))
        }
        catch err {
            throw variant DecodeFailure {message = err.message}
        }
    }
    return row
}

fn dense_one(DenseEngine engine, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, int token_id, int position, list<kv.KVCache> layers) → dense.DenseStep ⇥ GenerationError {
    do {
        return dense.decode_step(engine.architecture, source, token_id, position, engine.epsilon, engine.scale, engine.rope_dim, engine.rope, layers)
    }
    catch err {
        throw variant DecodeFailure {message = err.message}
    }
}

fn dense_prefill(DenseEngine engine, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, list<int> prompt_ids, list<kv.KVCache> layers) → dense.DenseStep ⇥ GenerationError {
    do {
        return dense.prefill_cached(engine.architecture, source, prompt_ids, engine.epsilon, engine.scale, engine.rope_dim, engine.rope, layers)
    }
    catch err {
        throw variant DecodeFailure {message = err.message}
    }
}

fn copy_prefix(list<int> base, list<int> ids, int count) → list<int> {
    var list<int> out ← empty
    for from base const token {
        out.append(token)
    }
    # The count selects a prefix, so the source list cannot be walked to its end.
    for range 0‥count const i {
        out.append(ids.get(i) coalesce 0)
    }
    return out
}

fn advance_n(GenerationConfig g, GenerationCursor start, int count) → GenerationCursor ⇥ GenerationError {
    var GenerationCursor out ← start
    for range 0‥count const i {
        out ← cursor_advance(g, out)
    }
    return out
}

fn logit_row(tensor.NumericBlock logits, int row, int vocab) → list<f32> ⇥ GenerationError {
    require logits.rank() ≡ 2 throw variant DecodeFailure {message = "decode logits must be rank two"}
    # NumericBlock carries a runtime shape; validate its rank before indexing.
    const list<int> shape ← logits.shape
    const int rows ← shape.get(0) coalesce 0
    const int cols ← shape.get(1) coalesce 0
    require row ≥ 0 and row ≺ rows throw variant DecodeFailure {message = "decode logits row is outside the block"}
    require cols ≡ vocab throw variant DecodeFailure {message = "decode logits shape does not match the vocabulary"}
    var list<f32> out ← empty
    # NumericBlock data is flat; the row index selects the requested value.
    for range 0‥vocab const i {
        out.append(logits.data.get(row * vocab + i) coalesce 0.0 ∷ f32)
    }
    return out
}

fn draw_target_ids(tensor.NumericBlock logits, int rows, int vocab, sampling.Config drawn, train.Seed rng, StopPolicy stop) → list<int> ⇥ GenerationError {
    var list<int> out ← empty
    for range 0‥rows const row {
        const list<f32> values ← logit_row(logits, row, vocab)
        const sampling.Sampler target ← sample(sample_logits(values, stop), drawn, empty, rng)
        out.append(target.token_id)
    }
    return out
}

fn accepted_prefix(list<int> ids, int count, StopPolicy stop) → int {
    if not stops_on_eog(stop) {
        return count
    }
    # The count selects a prefix, so the source list cannot be walked to its end.
    for range 0‥count const i {
        if tokenizer.is_eog(ids.get(i) coalesce (-1)) {
            return i + 1
        }
    }
    return count
}

fn lookup_context(list<int> prompt, list<int> history) → list<int> {
    var list<int> context ← empty
    for from prompt const token {
        context.append(token)
    }
    for from history const token {
        context.append(token)
    }
    return context
}

fn accepted_target_count(list<int> target_ids, list<int> candidate_ids) → int {
    var int bound ← target_ids.length()
    if candidate_ids.length() ≺ bound {
        bound ← candidate_ids.length()
    }
    # The bound is the shorter list; a full lockstep walk would require equal lengths.
    for range 0‥bound const count {
        if target_ids.get(count) coalesce (-1) ≠ candidate_ids.get(count) coalesce (-1) {
            return count
        }
    }
    return bound
}

fn lookup_candidates(list<int> prompt, list<int> history, int block_size) → list<int> {
    const list<int> context ← lookup_context(prompt, history)
    const int available ← context.length()
    if available ≺ 2 {
        return empty
    }
    var int match_length ← block_size
    if match_length ≻ available - 1 {
        match_length ← available - 1
    }
    while match_length ≥ 1 {
        const int suffix_start ← available - match_length
        const int source_limit ← available - match_length
        for range 0‥(source_limit + 1) const source_offset {
            var bool matches ← true
            # Both windows use computed offsets into the flat context.
            for range 0‥match_length const i {
                if context.get(source_offset + i) coalesce (-1) ≠ context.get(suffix_start + i) coalesce (-1) {
                    matches ← false
                }
            }
            if matches {
                const int following ← source_offset + match_length
                var int extension ← block_size
                if extension ≻ available - following {
                    extension ← available - following
                }
                if extension ≥ 1 {
                    var list<int> candidates ← empty
                    # This range extracts a computed suffix from the flat context.
                    for range 0‥extension const i {
                        candidates.append(context.get(following + i) coalesce (-1))
                    }
                    return candidates
                }
            }
        }
        match_length ← match_length - 1
    }
    return empty
}

fn slice_rows(tensor.NumericBlock value, int start, int rows, int dimension) → tensor.NumericBlock ⇥ GenerationError {
    require value.shape ≡ ([start + rows, dimension] ↦ list<int>) throw variant DecodeFailure {message = "verified cache shape does not match the candidate block"}
    var list<f32> data ← empty
    # NumericBlock data is flat; these coordinates select a row window.
    for range start‥(start + rows) const row {
        for range 0‥dimension const column {
            data.append(value.data.get(row * dimension + column) coalesce 0.0 ∷ f32)
        }
    }
    do {
        return tensor.construct(data, [rows, dimension])
    }
    catch err {
        throw variant DecodeFailure {message = err.message}
    }
}

fn commit_dense_block(list<kv.KVCache> base, dense.DenseStep verified, list<int> candidate_ids, int accepted_count) → list<kv.KVCache> ⇥ GenerationError {
    require accepted_count ≥ 1 throw variant DecodeFailure {message = "accepted candidate block must not be empty"}
    require accepted_count ≤ candidate_ids.length() throw variant DecodeFailure {message = "accepted candidate block exceeds the proposal"}
    require verified.layers.length() ≡ base.length() throw variant DecodeFailure {message = "verified cache layer count does not match the base"}
    var list<kv.KVCache> committed ← empty
    const kv.KVCache first ← base.get(0) coalesce kv.default()
    const int prefix ← first.length()
    const list<int> accepted_ids ← copy_prefix(empty, candidate_ids, accepted_count)
    for from base, verified.layers const before, after {
        const tensor.NumericBlock key ← slice_rows(after.key, prefix, accepted_count, before.dimension)
        const tensor.NumericBlock payload ← slice_rows(after.payload, prefix, accepted_count, before.dimension)
        do {
            committed.append(kv.extend(before, accepted_ids, key, payload))
        }
        catch err {
            throw variant DecodeFailure {message = err.message}
        }
    }
    return committed
}

# Public generate: config + prompt ids + the admitted decoder.
# Prefill produces the last-row logits; each later step is
# decode_data + sampling.sample. Default stop is Eog: halt after the
# first EOG token (tokenizer.is_eog — set {0, 2}) or at the cursor
# ceiling. generate_with_stop / generate_cancelled_with_stop take an
# explicit StopPolicy. The KV-wired loop is generate_dense.
@ public
fn generate(GenerationConfig g, list<int> prompt_ids, decode.Decoder m) → list<int> ⇥ GenerationError {
    return generate_cancelled(g, prompt_ids, m, decode.fresh_cancellation())
}

@ public
fn generate_with_stop(GenerationConfig g, list<int> prompt_ids, decode.Decoder m, StopPolicy stop) → list<int> ⇥ GenerationError {
    return generate_cancelled_with_stop(g, prompt_ids, m, decode.fresh_cancellation(), stop)
}

@ public
fn generate_cancelled(GenerationConfig g, list<int> prompt_ids, decode.Decoder m, decode.Cancellation cancel) → list<int> ⇥ GenerationError {
    return generate_cancelled_with_stop(g, prompt_ids, m, cancel, eog_stop())
}

@ public
fn generate_cancelled_with_stop(GenerationConfig g, list<int> prompt_ids, decode.Decoder m, decode.Cancellation cancel, StopPolicy stop) → list<int> ⇥ GenerationError {
    observe(cancel)
    require prompt_ids.length() ≥ 1 throw variant InvalidConfig {message = "needs at least one prompt token"}
    require prompt_ids.length() ≺ g.context throw variant InvalidConfig {message = "prompt length does not fit context"}
    require prompt_ids.length() ≤ m.context throw variant InvalidConfig {message = "prompt length does not fit context"}
    const sampling.Config drawn ← config(g)
    var train.Seed rng ← seed(g)
    const tensor.NumericBlock pref ← prefill(prompt_ids, m)
    var list<f32> last ← last_logits(pref, m.vocabulary)
    var GenerationCursor cursor ← cursor_after_prompt(g, prompt_ids.length())
    var list<int> tokens ← empty
    var list<int> history ← empty
    var bool finished ← false
    while token_allowed(g, cursor) and not finished {
        observe(cancel)
        const sampling.Sampler outcome ← sample(sample_logits(last, stop), drawn, history, rng)
        const int token ← outcome.token_id
        tokens.append(token)
        history.append(token)
        rng ← outcome.seed
        cursor ← cursor_advance(g, cursor)
        if tokenizer.is_eog(token) and stops_on_eog(stop) {
            finished ← true
        }
        else {
            if token_allowed(g, cursor) {
                const tensor.NumericBlock step ← decode_one(token, cursor.session.position - 1, m)
                last ← last_logits(step, m.vocabulary)
            }
            else {
                finished ← true
            }
        }
    }
    return tokens
}

# --- dense generation ----------------------------------------------------
@ public
class DenseEngine {
    dense.DenseConfig architecture
    f32 epsilon
    f32 scale
    int rope_dim
    attention.RopeConfig rope
}

@ public
fn construct_dense_engine(dense.DenseConfig architecture, f32 epsilon, f32 scale, int rope_dim, attention.RopeConfig rope) → DenseEngine {
    return DenseEngine {architecture = architecture, epsilon = epsilon, scale = scale, rope_dim = rope_dim, rope = rope}
}

@ public
fn default_dense_engine() → DenseEngine {
    return DenseEngine {architecture = dense.DenseConfig {layers = 0, heads = 0, kv_heads = 0, head_dim = 0, hidden_dim = 0, vocab = 0, tied = false}, epsilon = 0.0, scale = 0.0, rope_dim = 0, rope = attention.default()}
}

# Same loop as generate, over dense.decode_step and a per-layer KV cache.
# Used by the SmolLM2 oracle example. Default EOG-stop applies: SmolLM2
# EOS=2 is in the admitted set {0, 2}, so a greedy continuation that
# would have been G1's unrestrained [30, 2, 198] becomes [30, 2].
# generate_dense_with_stop(IgnoreEos) suppresses EOG from sampling and
# runs to max_tokens — the U5 / llama.cpp ignore_eos row.
@ public
fn generate_dense(GenerationConfig g, list<int> prompt_ids, DenseEngine engine, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, list<kv.KVCache> layers, decode.Cancellation cancel) → list<int> ⇥ GenerationError {
    return generate_dense_with_stop(g, prompt_ids, engine, source, layers, cancel, eog_stop())
}

@ public
fn generate_dense_with_stop(GenerationConfig g, list<int> prompt_ids, DenseEngine engine, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, list<kv.KVCache> layers, decode.Cancellation cancel, StopPolicy stop) → list<int> ⇥ GenerationError {
    observe(cancel)
    require prompt_ids.length() ≥ 1 throw variant InvalidConfig {message = "needs at least one prompt token"}
    require prompt_ids.length() ≺ g.context throw variant InvalidConfig {message = "prompt length does not fit context"}
    const string acceleration_mode ← acceleration_mode_name(g.acceleration.mode)
    if acceleration_mode ≡ "context_lookup" {
        if g.temperature ≻ 0.0 or g.top_k ≻ 0 or (g.top_p ≻ 0.0 and g.top_p ≺ 1.0) or g.min_p ≻ 0.0 {
            throw variant SampledAccelerationRejected {message = "sampled acceleration is not supported"}
        }
    }
    const sampling.Config drawn ← config(g)
    var train.Seed rng ← seed(g)
    observe(cancel)
    const dense.DenseStep pref ← dense_prefill(engine, source, prompt_ids, layers)
    var list<kv.KVCache> state ← pref.layers
    var list<f32> last ← last_logits(pref.logits, engine.architecture.vocab)
    var GenerationCursor cursor ← cursor_after_prompt(g, prompt_ids.length())
    var list<int> tokens ← empty
    var list<int> history ← empty
    var bool finished ← false
    while token_allowed(g, cursor) and not finished {
        observe(cancel)
        if acceleration_mode ≡ "disabled" {
            const sampling.Sampler outcome ← sample(sample_logits(last, stop), drawn, history, rng)
            const int token ← outcome.token_id
            tokens.append(token)
            history.append(token)
            rng ← outcome.seed
            cursor ← cursor_advance(g, cursor)
            if tokenizer.is_eog(token) and stops_on_eog(stop) {
                finished ← true
            }
            else {
                if token_allowed(g, cursor) {
                    const dense.DenseStep step ← dense_one(engine, source, token, cursor.session.position - 1, state)
                    last ← last_logits(step.logits, engine.architecture.vocab)
                    state ← step.layers
                }
                else {
                    finished ← true
                }
            }
        }
        else {
            const int block_size ← g.acceleration.max_block
            const list<int> candidate_ids ← lookup_candidates(prompt_ids, history, block_size)
            if candidate_ids.length() ≡ 0 {
                const sampling.Sampler outcome ← sample(sample_logits(last, stop), drawn, history, rng)
                const int token ← outcome.token_id
                tokens.append(token)
                history.append(token)
                rng ← outcome.seed
                cursor ← cursor_advance(g, cursor)
                if tokenizer.is_eog(token) and stops_on_eog(stop) {
                    finished ← true
                }
                else {
                    if token_allowed(g, cursor) {
                        const dense.DenseStep step ← dense_one(engine, source, token, cursor.session.position - 1, state)
                        last ← last_logits(step.logits, engine.architecture.vocab)
                        state ← step.layers
                    }
                    else {
                        finished ← true
                    }
                }
            }
            else {
                var dense.DenseStep verified ← dense.default_step()
                var bool attempt_ok ← true
                do {
                    verified ← dense.decode_block(engine.architecture, source, candidate_ids, engine.epsilon, engine.scale, engine.rope_dim, engine.rope, state)
                }
                catch err {
                    attempt_ok ← false
                }
                var list<int> target_ids ← empty
                if attempt_ok {
                    do {
                        target_ids ← draw_target_ids(verified.logits, candidate_ids.length(), engine.architecture.vocab, drawn, rng, stop)
                    }
                    catch err {
                        attempt_ok ← false
                    }
                }
                if not attempt_ok {
                    const sampling.Sampler outcome ← sample(sample_logits(last, stop), drawn, history, rng)
                    const int token ← outcome.token_id
                    tokens.append(token)
                    history.append(token)
                    rng ← outcome.seed
                    cursor ← cursor_advance(g, cursor)
                    if tokenizer.is_eog(token) and stops_on_eog(stop) {
                        finished ← true
                    }
                    else {
                        if token_allowed(g, cursor) {
                            const dense.DenseStep step ← dense_one(engine, source, token, cursor.session.position - 1, state)
                            last ← last_logits(step.logits, engine.architecture.vocab)
                            state ← step.layers
                        }
                        else {
                            finished ← true
                        }
                    }
                }
                else {
                    const int raw_accepted ← accepted_target_count(target_ids, candidate_ids)
                    const int remaining ← g.max_tokens - cursor.emitted
                    var int accepted_count ← raw_accepted
                    if accepted_count ≻ remaining {
                        accepted_count ← remaining
                    }
                    accepted_count ← accepted_prefix(candidate_ids, accepted_count, stop)
                    var GenerationCursor staged_cursor ← cursor
                    var bool staging_ok ← true
                    do {
                        staged_cursor ← advance_n(g, cursor, accepted_count)
                    }
                    catch err {
                        staging_ok ← false
                    }
                    var list<f32> staged_last ← last
                    if staging_ok and accepted_count ≻ 0 {
                        do {
                            staged_last ← logit_row(verified.logits, accepted_count - 1, engine.architecture.vocab)
                        }
                        catch err {
                            staging_ok ← false
                        }
                    }
                    var list<kv.KVCache> committed ← empty
                    if staging_ok and accepted_count ≻ 0 {
                        do {
                            committed ← commit_dense_block(state, verified, candidate_ids, accepted_count)
                        }
                        catch err {
                            staging_ok ← false
                        }
                    }
                    if not staging_ok {
                        const sampling.Sampler outcome ← sample(sample_logits(last, stop), drawn, history, rng)
                        const int token ← outcome.token_id
                        tokens.append(token)
                        history.append(token)
                        rng ← outcome.seed
                        cursor ← cursor_advance(g, cursor)
                        if tokenizer.is_eog(token) and stops_on_eog(stop) {
                            finished ← true
                        }
                        else {
                            if token_allowed(g, cursor) {
                                const dense.DenseStep step ← dense_one(engine, source, token, cursor.session.position - 1, state)
                                last ← last_logits(step.logits, engine.architecture.vocab)
                                state ← step.layers
                            }
                            else {
                                finished ← true
                            }
                        }
                    }
                    else {
                        if accepted_count ≡ 0 {
                            const sampling.Sampler outcome ← sample(sample_logits(last, stop), drawn, history, rng)
                        const int token ← outcome.token_id
                        tokens.append(token)
                        history.append(token)
                        rng ← outcome.seed
                        cursor ← cursor_advance(g, cursor)
                        if tokenizer.is_eog(token) and stops_on_eog(stop) {
                            finished ← true
                        }
                        else {
                            if token_allowed(g, cursor) {
                                const dense.DenseStep step ← dense_one(engine, source, token, cursor.session.position - 1, state)
                                last ← last_logits(step.logits, engine.architecture.vocab)
                                state ← step.layers
                            }
                            else {
                                finished ← true
                            }
                        }
                    }
                    else {
                        state ← committed
                        tokens ← copy_prefix(tokens, candidate_ids, accepted_count)
                        history ← copy_prefix(history, candidate_ids, accepted_count)
                        cursor ← staged_cursor
                        last ← staged_last
                        if stops_on_eog(stop) and tokenizer.is_eog(candidate_ids.get(accepted_count - 1) coalesce (-1)) {
                            finished ← true
                        }
                        if raw_accepted ≺ candidate_ids.length() and accepted_count ≡ raw_accepted and token_allowed(g, cursor) and not finished {
                            const sampling.Sampler outcome ← sample(sample_logits(last, stop), drawn, history, rng)
                            const int token ← outcome.token_id
                            tokens.append(token)
                            history.append(token)
                            rng ← outcome.seed
                            cursor ← cursor_advance(g, cursor)
                            if tokenizer.is_eog(token) and stops_on_eog(stop) {
                                finished ← true
                            }
                            else {
                                if token_allowed(g, cursor) {
                                    const dense.DenseStep step ← dense_one(engine, source, token, cursor.session.position - 1, state)
                                    last ← last_logits(step.logits, engine.architecture.vocab)
                                    state ← step.layers
                                }
                                else {
                                    finished ← true
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
    return tokens
}
