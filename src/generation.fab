+++
locale = "en"
+++
# Generation-configuration contract — PML5-U4 (production inference
# computation layer; the single authority for generation configuration).
#
# Public import: importa ex "gradus:generation" privata generatio
# Depends on: gradus:dtype (finita), gradus:sampling (Configura — the U3
# sampling semantics the mapping is deterministic against), gradus:train
# (Semen — the U5 seed/RNG the seed mapping feeds).
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own those). This module holds no device handle and makes no performance
# claims.
#
# =========================================================================
# The generation-config contract (pml5-delivery.md PML5-U4)
# =========================================================================
#
# --- The single authority (council R7) -----------------------------------
# GeneratioConfigura is THE authority for generation configuration.
# NGAB5 and the future product repo ADAPT to this contract — they never
# define a second authority. The declared supported surface is the nine
# fields below (imperia_subsidia()); every llama.cpp-style control
# outside that surface is an EXPLICIT reject row (imperium_admissum →
# false; the reject-row matrix is probed) — never silently ignored. The
# versioned wire carries exactly the nine fields; an extra field breaks
# the parse (fail closed).
#
# --- Supported values, defaults, validation (the nine fields) ------------
#   contextus        — context length; ≥ 1. The decode/cache context the
#                      generated sequence must fit within.
#   magna_promptus   — prompt batch size (the prefill batch); ≥ 1.
#   maxima_verborum  — maximum generated tokens; ≥ 1 and ≤ contextus
#                      (the generated sequence must fit the context).
#   semen            — the deterministic RNG seed; ≥ 1 (the Semen rule —
#                      xorshift64 degenerates at 0; the mapping never
#                      fails).
#   temperatura      — temperature scaling; ≥ 0 (0 selects the greedy
#                      path — the U3 rule); default 1.0.
#   top_k            — top-k filter width; ≥ 0 (0 disables); default 0.
#   top_p            — top-p (nucleus) threshold; ∈ [0, 1] (≥ 1 disables);
#                      default 1.0.
#   min_p            — min-p threshold; ∈ [0, 1] (≤ 0 disables); default 0.
#   poena_repetitionis — repetition penalty; ≥ 1 (1.0 = none); default 1.0.
# Every field is validated at construction (fail closed — the capsule
# rule); generatio_defecta gives the neutral sampling defaults.
#
# --- Deterministic mapping -----------------------------------------------
# The contract maps deterministically to what the generation loop
# consumes: configura(g) → the U3 sampling Configura (the five sampling
# fields project exactly — the same domains, so the mapping never fails)
# and semen(g) → the U5 Semen (the seed projects exactly). The mapping is
# a pure function — equal configs map to equal values.
#
# --- Evidence honesty (CTO Q2, hard) -------------------------------------
# This surface is the STRUCTURAL proof: the supported values, defaults,
# validation, the deterministic mapping, the reject rows, and the PML5-U5
# context-limit cursor wiring are compile-validated and proven by the
# co-located proba (exact field, mapping, and boundary pins). Executed
# VALUE identity is env-blocked tree-wide today (FMIR stepper /
# library-import gap — the PML4 closeout recorded both blockers; neither
# is fixed here). PML5-U4 is PARTIAL: value-identity is deferred to the
# auditor-owned runtime-evidence gate.
#
# =========================================================================
# PML5-U5 additions — the context-limit wiring (reject vs truncate policy)
# =========================================================================
#
# The explicit policy decision: REJECT, never truncate (the U1 reject
# precedent). The generation cursor (GenereCursor) is the loop's explicit
# state — the decode session position + the generated-token count.
# cursor_progredere rejects with a typed Terminus when the next step
# would exceed the context limit (position >= contextus) or the
# maximum-generated-tokens limit (count >= maxima_verborum); the input
# limits are the U4 config's contextus/maxima_verborum. verbum_licet is
# the explicit policy predicate. cursor_redintegra resets to the fresh
# session state (the U1 redintegra precedent) with the count cleared.
# No server or device handle enters this module.
import from "gradus:dtype" dtype

import from "gradus:sampling" sampling

import from "gradus:train" train

import from "gradus:decode" decode

# -------------------------------------------------------------------------
# GeneratioError — typed error vocabulary of the generation-config
# contract. Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------

union GeneratioError {
    ConfiguraInvalida {
        string causa
    },
    ElementaMismatch {
        string causa
    },
    TypoMismatch {
        string causa
    },
    Incompatibilis {
        string causa
    },
    VersioIgnota {
        string causa
    },
    WireMala {
        string causa
    },
    Terminus {
        string causa
    }
}

fn causa(GeneratioError e) → string {
    match e {
        case ConfiguraInvalida const causa {
            return causa
        }
        case ElementaMismatch const causa {
            return causa
        }
        case TypoMismatch const causa {
            return causa
        }
        case Incompatibilis const causa {
            return causa
        }
        case VersioIgnota const causa {
            return causa
        }
        case WireMala const causa {
            return causa
        }
        case Terminus const causa {
            return causa
        }
    }
}

# The contract's schema version (the wire form).
const string schema_versio ← "1.0.0"

# -------------------------------------------------------------------------
# GeneratioConfigura — the nine-field generation configuration.
# -------------------------------------------------------------------------


@ public { }
class GeneratioConfigura {
    int contextus
    int magna_promptus
    int maxima_verborum
    int semen
    f32 temperatura
    int top_k
    f32 top_p
    f32 min_p
    f32 poena_repetitionis

    # Context length.
    fn contextus() → int {
        return self.contextus
    }

    # Prompt batch size (the prefill batch).
    fn magna_promptus() → int {
        return self.magna_promptus
    }

    # Maximum generated tokens.
    fn maxima_verborum() → int {
        return self.maxima_verborum
    }

    # The deterministic RNG seed.
    fn semen() → int {
        return self.semen
    }

    # Temperature scaling (0 = greedy).
    fn temperatura() → f32 {
        return self.temperatura
    }

    # Top-k filter width (0 = disabled).
    fn top_k() → int {
        return self.top_k
    }

    # Top-p nucleus threshold (≥ 1 = disabled).
    fn top_p() → f32 {
        return self.top_p
    }

    # Min-p threshold (≤ 0 = disabled).
    fn min_p() → f32 {
        return self.min_p
    }

    # Repetition penalty (1.0 = none).
    fn poena_repetitionis() → f32 {
        return self.poena_repetitionis
    }
}

# Field-wise config equality — the round-trip/determinism predicate.
fn generatio_aequus(GeneratioConfigura a, GeneratioConfigura b) → bool {
    if a.contextus() ≠ b.contextus() then return false
    if a.magna_promptus() ≠ b.magna_promptus() then return false
    if a.maxima_verborum() ≠ b.maxima_verborum() then return false
    if a.semen() ≠ b.semen() then return false
    if a.temperatura() ≠ b.temperatura() then return false
    if a.top_k() ≠ b.top_k() then return false
    if a.top_p() ≠ b.top_p() then return false
    if a.min_p() ≠ b.min_p() then return false
    if a.poena_repetitionis() ≠ b.poena_repetitionis() then return false
    return true
}

# -------------------------------------------------------------------------
# structa_generatio — the validated constructor (the single authority's
# validation runs here AND on every deserialization — fail closed).
# -------------------------------------------------------------------------

@ public { }
fn structa_generatio(int contextus, int magna_promptus, int maxima_verborum, int semen, f32 temperatura, int top_k, f32 top_p, f32 min_p, f32 poena_repetitionis) → GeneratioConfigura ⇥ GeneratioError {
    if contextus ≺ 1 {
        throw variant ConfiguraInvalida {causa = "context length must be at least one"}
    }
    if magna_promptus ≺ 1 {
        throw variant ConfiguraInvalida {causa = "prompt batch size must be at least one"}
    }
    if maxima_verborum ≺ 1 {
        throw variant ConfiguraInvalida {causa = "maximum generated tokens must be at least one"}
    }
    if maxima_verborum ≻ contextus {
        throw variant ConfiguraInvalida {causa = "maximum generated tokens must fit within the context"}
    }
    if semen ≺ 1 {
        throw variant ConfiguraInvalida {causa = "seed must be at least one"}
    }
    if not dtype.finita(temperatura) or temperatura ≺ 0.0 {
        throw variant ConfiguraInvalida {causa = "temperature must be non-negative"}
    }
    if top_k ≺ 0 {
        throw variant ConfiguraInvalida {causa = "top-k must be non-negative"}
    }
    if (not dtype.finita(top_p) or top_p ≺ 0.0) or top_p ≻ 1.0 {
        throw variant ConfiguraInvalida {causa = "top-p must be within [0, 1]"}
    }
    if (not dtype.finita(min_p) or min_p ≺ 0.0) or min_p ≻ 1.0 {
        throw variant ConfiguraInvalida {causa = "min-p must be within [0, 1]"}
    }
    if not dtype.finita(poena_repetitionis) or poena_repetitionis ≺ 1.0 {
        throw variant ConfiguraInvalida {causa = "repetition penalty must be at least one"}
    }
    return GeneratioConfigura {contextus = contextus, magna_promptus = magna_promptus, maxima_verborum = maxima_verborum, semen = semen, temperatura = temperatura, top_k = top_k, top_p = top_p, min_p = min_p, poena_repetitionis = poena_repetitionis}
}

# -------------------------------------------------------------------------
# generatio_defecta — the default generation config: the caller pins the
# context / prompt batch / max tokens / seed; the sampling knobs take the
# neutral defaults (temperature 1.0, top-k 0 = disabled, top-p 1.0 =
# disabled, min-p 0 = disabled, repetition penalty 1.0 = none).
# -------------------------------------------------------------------------

fn generatio_defecta(int contextus, int magna_promptus, int maxima_verborum, int semen) → GeneratioConfigura ⇥ GeneratioError {
    return structa_generatio(contextus, magna_promptus, maxima_verborum, semen, 1.0 ∷ f32, 0, 1.0 ∷ f32, 0.0 ∷ f32, 1.0 ∷ f32)
}

# -------------------------------------------------------------------------
# The declared supported surface + the admission predicate. NGAB5 and the
# product repo adapt to imperia_subsidia(); any control outside it is an
# explicit reject row (never silently ignored).
# -------------------------------------------------------------------------

fn imperia_subsidia() → list<string> {
    return ["contextus", "magna_promptus", "maxima_verborum", "semen", "temperatura", "top_k", "top_p", "min_p", "poena_repetitionis"]
}

# Admission predicate: true iff the control name is a supported field.
fn imperium_admissum(string nomen) → bool {
    const list<string> subsidia ← imperia_subsidia()
    for from subsidia const s {
        if s ≡ nomen then return true
    }
    return false
}

# -------------------------------------------------------------------------
# The deterministic mapping — what the generation loop consumes.
# -------------------------------------------------------------------------

# The five sampling fields project exactly onto the U3 Configura (the
# config validated the same domains — the mapping never fails).
@ public { }
fn configura(GeneratioConfigura g) → sampling.Configura ⇥ GeneratioError {
    do {
        return sampling.structa_configura(g.temperatura(), g.top_k(), g.top_p(), g.min_p(), g.poena_repetitionis())
    }
    catch err {
        const string c ← sampling.causa(err)
        throw variant ConfiguraInvalida {causa = c}
    }
    throw variant ConfiguraInvalida {causa = "unreachable"}
}

# The seed projects exactly onto the U5 Semen (the config validated
# seed ≥ 1 — the mapping never fails).
@ public { }
fn semen(GeneratioConfigura g) → train.Semen ⇥ GeneratioError {
    do {
        return train.structa_semen(g.semen())
    }
    catch err {
        const string c ← train.causa(err)
        throw variant ConfiguraInvalida {causa = c}
    }
    throw variant ConfiguraInvalida {causa = "unreachable"}
}

# -------------------------------------------------------------------------
# The versioned wire — exactly the nine fields. An extra field breaks the
# parse (fail closed — unsupported controls are never silently ignored);
# every field is re-validated by structa_generatio on deserialization.
# -------------------------------------------------------------------------

fn serializa_generatio(GeneratioConfigura g) → string {
    return (((((((((((((((((("generation/config/" + schema_versio) + "/") + (g.contextus() ↦ string)) + "/") + (g.magna_promptus() ↦ string)) + "/") + (g.maxima_verborum() ↦ string)) + "/") + (g.semen() ↦ string)) + "/") + (g.temperatura() ↦ string)) + "/") + (g.top_k() ↦ string)) + "/") + (g.top_p() ↦ string)) + "/") + (g.min_p() ↦ string)) + "/") + (g.poena_repetitionis() ↦ string)
}

@ private { }
fn _digitum(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _numerica(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _digitum(s.get(i)) then return false
        i ← i + 1
    }
    return true
}

fn deserializa_generatio(string wire) → GeneratioConfigura ⇥ GeneratioError {
    const list<string> partes ← wire.split("/")
    if partes.length() ≠ 12 {
        throw variant WireMala {causa = "malformed generation config wire"}
    }
    if partes.get(0) coalesce "" ≠ "generation" {
        throw variant WireMala {causa = "unknown generation marker"}
    }
    if partes.get(1) coalesce "" ≠ "config" {
        throw variant WireMala {causa = "unknown generation marker"}
    }
    if partes.get(2) coalesce "" ≠ schema_versio {
        throw variant VersioIgnota {causa = "unknown generation schema version"}
    }
    const string contextus_textus ← partes.get(3) coalesce ""
    const string magna_textus ← partes.get(4) coalesce ""
    const string maxima_textus ← partes.get(5) coalesce ""
    const string semen_textus ← partes.get(6) coalesce ""
    const string temperatura_textus ← partes.get(7) coalesce ""
    const string top_k_textus ← partes.get(8) coalesce ""
    const string top_p_textus ← partes.get(9) coalesce ""
    const string min_p_textus ← partes.get(10) coalesce ""
    const string poena_textus ← partes.get(11) coalesce ""
    var int contextus ← 0
    var int magna_promptus ← 0
    var int maxima_verborum ← 0
    var int semen ← 0
    var f32 temperatura ← 0.0 ∷ f32
    var int top_k ← 0
    var f32 top_p ← 0.0 ∷ f32
    var f32 min_p ← 0.0 ∷ f32
    var f32 poena ← 0.0 ∷ f32
    if not _numerica(contextus_textus) {
        throw variant WireMala {causa = "malformed context length in generation wire"}
    }
    do {
        contextus ← contextus_textus ↦ int
    }
    catch err {
        throw variant WireMala {causa = "malformed context length in generation wire"}
    }
    if not _numerica(magna_textus) {
        throw variant WireMala {causa = "malformed prompt batch in generation wire"}
    }
    do {
        magna_promptus ← magna_textus ↦ int
    }
    catch err {
        throw variant WireMala {causa = "malformed prompt batch in generation wire"}
    }
    if not _numerica(maxima_textus) {
        throw variant WireMala {causa = "malformed max tokens in generation wire"}
    }
    do {
        maxima_verborum ← maxima_textus ↦ int
    }
    catch err {
        throw variant WireMala {causa = "malformed max tokens in generation wire"}
    }
    if not _numerica(semen_textus) {
        throw variant WireMala {causa = "malformed seed in generation wire"}
    }
    do {
        semen ← semen_textus ↦ int
    }
    catch err {
        throw variant WireMala {causa = "malformed seed in generation wire"}
    }
    do {
        temperatura ← temperatura_textus ↦ f32
    }
    catch err {
        throw variant WireMala {causa = "malformed temperature in generation wire"}
    }
    if not _numerica(top_k_textus) {
        throw variant WireMala {causa = "malformed top-k in generation wire"}
    }
    do {
        top_k ← top_k_textus ↦ int
    }
    catch err {
        throw variant WireMala {causa = "malformed top-k in generation wire"}
    }
    do {
        top_p ← top_p_textus ↦ f32
    }
    catch err {
        throw variant WireMala {causa = "malformed top-p in generation wire"}
    }
    do {
        min_p ← min_p_textus ↦ f32
    }
    catch err {
        throw variant WireMala {causa = "malformed min-p in generation wire"}
    }
    do {
        poena ← poena_textus ↦ f32
    }
    catch err {
        throw variant WireMala {causa = "malformed repetition penalty in generation wire"}
    }
    return structa_generatio(contextus, magna_promptus, maxima_verborum, semen, temperatura, top_k, top_p, min_p, poena)
}

# -------------------------------------------------------------------------
# The generation cursor (PML5-U5 — context-limit wiring). The cursor is the
# generation loop's explicit state: the decode session position + the
# generated-token count. The LIMIT POLICY is explicit REJECT (the U1
# reject-policy precedent) — never silent truncation: cursor_progredere
# rejects with a typed Terminus when the next step would exceed either the
# context limit (sessio position >= contextus) or the maximum-generated-
# tokens limit (prolata >= maxima_verborum). With maxima_verborum <=
# contextus (the U4 validation) the max-tokens bound is the binding
# constraint in ordinary progression; the context rejection is the
# defensive fail-closed guard (probe-tested at the boundary state). The
# cursor reset (cursor_redintegra) returns the fresh session state (the
# U1 redintegra precedent) with the count cleared.
# -------------------------------------------------------------------------


@ public { }
class GenereCursor {
    decode.Sessio sessio
    int prolata

    # The decode session (the position counter).
    fn sessio() → decode.Sessio {
        return self.sessio
    }

    # The generated-token count.
    fn prolata() → int {
        return self.prolata
    }
}

# A fresh cursor at position 0 with count 0 over the config's context.
@ public { }
fn cursor_fresh(GeneratioConfigura g) → GenereCursor ⇥ GeneratioError {
    var decode.Sessio s
    do {
        s ← decode.sessio_fresh(g.contextus())
        return GenereCursor {sessio = s, prolata = 0}
    }
    catch err {
        throw variant ConfiguraInvalida {causa = decode.causa(err)}
    }
    throw variant ConfiguraInvalida {causa = "unreachable"}
}

# The explicit limit-policy predicate: another token is allowed iff the
# session position is below the context limit AND the generated count is
# below the maximum-generated-tokens limit.
@ public { }
fn verbum_licet(GeneratioConfigura g, GenereCursor c) → bool {
    if c.sessio().positio() ≥ g.contextus() then return false
    if c.prolata() ≥ g.maxima_verborum() then return false
    return true
}

# The next step — REJECTS (never truncates) when the step would exceed the
# max-tokens limit or the context limit; otherwise advances the session
# position by one and the count by one.
@ public { }
fn cursor_progredere(GeneratioConfigura g, GenereCursor c) → GenereCursor ⇥ GeneratioError {
    if c.prolata() ≥ g.maxima_verborum() {
        throw variant Terminus {causa = "maximum generated tokens reached"}
    }
    if c.sessio().positio() ≥ g.contextus() {
        throw variant Terminus {causa = "context limit reached"}
    }
    return GenereCursor {sessio = decode.Sessio {positio = c.sessio().positio() + 1, contextus = c.sessio().contextus()}, prolata = c.prolata() + 1}
}

# Reset the cursor to the fresh state: session position 0 (the U1
# redintegra precedent, context preserved) with the count cleared.
fn cursor_redintegra(GenereCursor c) → GenereCursor {
    return GenereCursor {sessio = decode.redintegra(c.sessio()), prolata = 0}
}
