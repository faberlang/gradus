+++
locale = "en"
+++
# Generation-configuration contract — PML5-U4 (production inference
# computation layer; the single authority for generation configuration).
#
# Public import: import from "gradus:generation" generation
# Depends on: gradus:dtype (finite), gradus:sampling (Config — the U3
# sampling semantics the mapping is deterministic against), gradus:train
# (Seed — the U5 seed/RNG the seed mapping feeds).
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own those). This module holds no device handle and makes no performance
# claims.
#
# =========================================================================
# The generation-config contract (pml5-delivery.md PML5-U4)
# =========================================================================
#
# --- The single authority (council R7) -----------------------------------
# GenerationConfig is THE authority for generation configuration.
# NGAB5 and the future product repo ADAPT to this contract — they never
# define a second authority. The declared supported surface is the ten
# fields below (support_flags()); every llama.cpp-style control
# outside that surface is an EXPLICIT reject row (admitted_features →
# false; the reject-row matrix is probed) — never silently ignored.
#
# --- Supported values, defaults, validation ------------------------------
#   context        — context length; ≥ 1. The decode/cache context the
#                      generated sequence must fit within.
#   max_prompt   — prompt batch size (the prefill batch); ≥ 1.
#   max_tokens  — maximum generated tokens; ≥ 1 and ≤ context
#                      (the generated sequence must fit the context).
#   seed            — the deterministic RNG seed; ≥ 1 (the Seed rule —
#                      xorshift64 degenerates at 0; the mapping never
#                      fails).
#   temperature      — temperature scaling; ≥ 0 (0 selects the greedy
#                      path — the U3 rule); default 1.0.
#   top_k            — top-k filter width; ≥ 0 (0 disables); default 0.
#   top_p            — top-p (nucleus) threshold; ∈ [0, 1] (≥ 1 disables);
#                      default 1.0.
#   min_p            — min-p threshold; ∈ [0, 1] (≤ 0 disables); default 0.
#   repetition_penalty — repetition penalty; ≥ 1 (1.0 = none); default 1.0.
#   acceleration   — one AccelerationPolicy (disabled | context_lookup;
#                      policy version; block-size bounds ≥ 1). The 9-arg
#                      construct_generation yields disabled. Unknown
#                      mode, policy version, or field count rejects.
# Every field is validated at construction (fail closed — the capsule
# rule); generation_failure gives the neutral sampling defaults.
#
# --- Versioned wire (SD0-U2) ---------------------------------------------
# Serialize emits schema 1.1.0 with exactly 13 slash parts (nine numeric
# fields plus one colon-separated policy segment). Deserialize accepts
# legacy 1.0.0 12-part wires as disabled, and 1.1.0 13-part wires with a
# policy segment. Every other shape rejects, including a 13-part 1.0.0
# extra field ("malformed generation config wire").
#
# --- Deterministic mapping -----------------------------------------------
# The contract maps deterministically to what the generation loop
# consumes: config(g) → the U3 sampling Config (the five sampling
# fields project exactly — the same domains, so the mapping never fails)
# and seed(g) → the U5 Seed (the seed projects exactly). The mapping is
# a pure function — equal configs map to equal values.
#
# --- Evidence honesty (CTO Q2, hard) -------------------------------------
# This surface is the STRUCTURAL proof: the supported values, defaults,
# validation, the deterministic mapping, the reject rows, and the PML5-U5
# context-limit cursor wiring are compile-validated and proven by the
# co-located proba (exact field, mapping, and boundary pins). Executed
# VALUE identity is not claimed here. Library-to-library calls execute on
# the FMIR stepper (radix 43c0102ba; regression-locked by 2e8042ae7).
# PML5-U4 is PARTIAL: value-identity is deferred to the
# auditor-owned runtime-evidence gate.
#
# =========================================================================
# PML5-U5 additions — the context-limit wiring (reject vs truncate policy)
# =========================================================================
#
# The explicit policy decision: REJECT, never truncate (the U1 reject
# precedent). The generation cursor (GenerationCursor) is the loop's explicit
# state — the decode session position + the generated-token count.
# cursor_advance rejects with a typed LimitReached when the next step
# would exceed the context limit (position >= context) or the
# maximum-generated-tokens limit (count >= max_tokens); the input
# limits are the U4 config's context/max_tokens. token_allowed is
# the explicit policy predicate. cursor_reset resets to the fresh
# session state (the U1 reset precedent) with the count cleared.
# No server or device handle enters this module.
#
# =========================================================================
# G2 — public generate route
# =========================================================================
#
# generate(config, prompt_ids, admitted decoder) is the canonical loop
# over the tiny Decoder: prefill → sample → decode_data feed-back
# until max_tokens or the first EOG token {0, 2}.
# generate_dense is the KV-wired loop over dense.decode_step (SmolLM2).
# The decoder/engine is an argument (M03: admitted model = generated
# model). Cancellation is observed at entry, during prefill, and before
# every sampled token. The cursor rejects rather than truncates.
# StopPolicy is additive: the existing generate / generate_cancelled /
# generate_dense signatures keep EOG-stop. The *_with_stop entry points
# accept Eog (emit first EOG then halt) or IgnoreEos (llama.cpp
# ignore_eos: EOG ids are suppressed from sampling and the loop runs to
# the max_tokens ceiling).
import from "gradus:attention" attention

import from "gradus:cache" kv

import from "gradus:decode" decode

import from "gradus:dtype" dtype

import from "gradus:model/dense" dense

import from "gradus:sampling" sampling

import from "gradus:tensor" tensor

import from "gradus:tokenizer" tokenizer

import from "gradus:train" train

# -------------------------------------------------------------------------
# GenerationError — typed error vocabulary of the generation-config
# contract. Every variant carries a text message (render via message).
# -------------------------------------------------------------------------

@ public { }
union GenerationError {
    @ shared
    string message

    InvalidConfig,
    ElementMismatch,
    DtypeMismatch,
    Incompatible,
    UnknownVersion,
    BadWire,
    LimitReached,
    Cancelled,
    DecodeFailure,
    SampledAccelerationRejected
}



# The contract's schema version (the wire form). 1.1.0 carries one
# AccelerationPolicy segment; legacy 1.0.0 12-part wires decode to
# the disabled policy.
const string schema_version_legacy ← "1.0.0"

const string schema_version ← "1.1.0"

const string policy_version ← "1.0.0"

# -------------------------------------------------------------------------
# AccelerationPolicy — the one versioned acceleration field on the
# generation config. Modes are disabled (constructor default) and
# context_lookup. SD0 owns the contract only: no lookup, draft, or
# candidate path lives here.
# -------------------------------------------------------------------------

@ public { }
union AccelerationMode {
    Disabled,
    ContextLookup
}

@ public { }
fn acceleration_disabled() → AccelerationMode {
    return variant Disabled
}

@ public { }
fn acceleration_context_lookup() → AccelerationMode {
    return variant ContextLookup
}

@ public { }
fn acceleration_mode_name(AccelerationMode m) → string {
    match m {
        case Disabled {
            return "disabled"
        }
        case ContextLookup {
            return "context_lookup"
        }
    }
}

@ private { }
fn _acceleration_mode_from_name(string s) → AccelerationMode ⇥ GenerationError {
    if s ≡ "disabled" then return variant Disabled
    if s ≡ "context_lookup" then return variant ContextLookup
    throw variant BadWire {message = "unknown acceleration mode"}
}

@ public { }
class AccelerationPolicy {
    string version
    AccelerationMode mode
    int min_block
    int max_block

    fn version() → string {
        return self.version
    }

    fn mode() → AccelerationMode {
        return self.mode
    }

    fn min_block() → int {
        return self.min_block
    }

    fn max_block() → int {
        return self.max_block
    }
}

@ public { }
fn construct_acceleration(string version, AccelerationMode mode, int min_block, int max_block) → AccelerationPolicy ⇥ GenerationError {
    require version ≡ policy_version throw variant UnknownVersion {message = "unknown acceleration policy version"}
    require min_block ≥ 1 throw variant InvalidConfig {message = "acceleration block size must be at least one"}
    require max_block ≥ 1 throw variant InvalidConfig {message = "acceleration block size must be at least one"}
    require min_block ≤ max_block throw variant InvalidConfig {message = "acceleration block size minimum must not exceed the maximum"}
    return AccelerationPolicy {version = version, mode = mode, min_block = min_block, max_block = max_block}
}

@ public { }
fn default_acceleration() → AccelerationPolicy {
    return AccelerationPolicy {version = "", mode = variant Disabled, min_block = 0, max_block = 0}
}

@ public { }
fn acceleration_equal(AccelerationPolicy a, AccelerationPolicy b) → bool {
    if a.version() ≠ b.version() then return false
    if acceleration_mode_name(a.mode()) ≠ acceleration_mode_name(b.mode()) then return false
    if a.min_block() ≠ b.min_block() then return false
    if a.max_block() ≠ b.max_block() then return false
    return true
}

# -------------------------------------------------------------------------
# GenerationConfig — the ten-field generation configuration (nine
# sampling/limit fields plus one AccelerationPolicy).
# -------------------------------------------------------------------------


@ public { }
class GenerationConfig {
    int context
    int max_prompt
    int max_tokens
    int seed
    f32 temperature
    int top_k
    f32 top_p
    f32 min_p
    f32 repetition_penalty
    AccelerationPolicy acceleration

    fn context() → int {
        return self.context
    }

    # Prompt batch size (the prefill batch).
    fn max_prompt() → int {
        return self.max_prompt
    }

    fn max_tokens() → int {
        return self.max_tokens
    }

    fn seed() → int {
        return self.seed
    }

    # Temperature scaling (0 = greedy).
    fn temperature() → f32 {
        return self.temperature
    }

    # Top-k filter width (0 = disabled).
    fn top_k() → int {
        return self.top_k
    }

    # Top-p nucleus threshold (≥ 1 = disabled).
    fn top_p() → f32 {
        return self.top_p
    }

    # Min-p threshold (≤ 0 = disabled).
    fn min_p() → f32 {
        return self.min_p
    }

    # Repetition penalty (1.0 = none).
    fn repetition_penalty() → f32 {
        return self.repetition_penalty
    }

    fn acceleration() → AccelerationPolicy {
        return self.acceleration
    }
}

# Field-wise config equality — the round-trip/determinism predicate.
@ public { }
fn generation_equal(GenerationConfig a, GenerationConfig b) → bool {
    if a.context() ≠ b.context() then return false
    if a.max_prompt() ≠ b.max_prompt() then return false
    if a.max_tokens() ≠ b.max_tokens() then return false
    if a.seed() ≠ b.seed() then return false
    if a.temperature() ≠ b.temperature() then return false
    if a.top_k() ≠ b.top_k() then return false
    if a.top_p() ≠ b.top_p() then return false
    if a.min_p() ≠ b.min_p() then return false
    if a.repetition_penalty() ≠ b.repetition_penalty() then return false
    if not acceleration_equal(a.acceleration(), b.acceleration()) then return false
    return true
}

# -------------------------------------------------------------------------
# construct_generation — the validated constructor (the single authority's
# validation runs here AND on every deserialization — fail closed).
# -------------------------------------------------------------------------

@ public { }
fn construct_generation_with_policy(int context, int max_prompt, int max_tokens, int seed, f32 temperature, int top_k, f32 top_p, f32 min_p, f32 repetition_penalty, AccelerationPolicy acceleration) → GenerationConfig ⇥ GenerationError {
    require context ≥ 1 throw variant InvalidConfig {message = "context length must be at least one"}
    require max_prompt ≥ 1 throw variant InvalidConfig {message = "prompt batch size must be at least one"}
    require max_tokens ≥ 1 throw variant InvalidConfig {message = "maximum generated tokens must be at least one"}
    require max_tokens ≤ context throw variant InvalidConfig {message = "maximum generated tokens must fit within the context"}
    require seed ≥ 1 throw variant InvalidConfig {message = "seed must be at least one"}
    require dtype.finite(temperature) throw variant InvalidConfig {message = "temperature must be non-negative"}
    require temperature ≥ 0.0 throw variant InvalidConfig {message = "temperature must be non-negative"}
    require top_k ≥ 0 throw variant InvalidConfig {message = "top-k must be non-negative"}
    require dtype.finite(top_p) throw variant InvalidConfig {message = "top-p must be within [0, 1]"}
    require top_p ≥ 0.0 throw variant InvalidConfig {message = "top-p must be within [0, 1]"}
    require top_p ≤ 1.0 throw variant InvalidConfig {message = "top-p must be within [0, 1]"}
    require dtype.finite(min_p) throw variant InvalidConfig {message = "min-p must be within [0, 1]"}
    require min_p ≥ 0.0 throw variant InvalidConfig {message = "min-p must be within [0, 1]"}
    require min_p ≤ 1.0 throw variant InvalidConfig {message = "min-p must be within [0, 1]"}
    require dtype.finite(repetition_penalty) throw variant InvalidConfig {message = "repetition penalty must be at least one"}
    require repetition_penalty ≥ 1.0 throw variant InvalidConfig {message = "repetition penalty must be at least one"}
    const AccelerationPolicy checked ← construct_acceleration(acceleration.version(), acceleration.mode(), acceleration.min_block(), acceleration.max_block())
    return GenerationConfig {context = context, max_prompt = max_prompt, max_tokens = max_tokens, seed = seed, temperature = temperature, top_k = top_k, top_p = top_p, min_p = min_p, repetition_penalty = repetition_penalty, acceleration = checked}
}

@ public { }
fn construct_generation(int context, int max_prompt, int max_tokens, int seed, f32 temperature, int top_k, f32 top_p, f32 min_p, f32 repetition_penalty) → GenerationConfig ⇥ GenerationError {
    const AccelerationPolicy disabled ← construct_acceleration(policy_version, variant Disabled, 1, 1)
    return construct_generation_with_policy(context, max_prompt, max_tokens, seed, temperature, top_k, top_p, min_p, repetition_penalty, disabled)
}

# Placeholder Default for `var GenerationConfig` bindings (var on structs).
# Zero fields (not a valid config). Only a placeholder the caller
# overwrites, or returns from an unreachable cape arm.
@ public { }
fn default() → GenerationConfig {
    return GenerationConfig {context = 0, max_prompt = 0, max_tokens = 0, seed = 0, temperature = 0.0, top_k = 0, top_p = 0.0, min_p = 0.0, repetition_penalty = 0.0, acceleration = default_acceleration()}
}

# -------------------------------------------------------------------------
# generation_failure — the default generation config: the caller pins the
# context / prompt batch / max tokens / seed; the sampling knobs take the
# neutral defaults (temperature 1.0, top-k 0 = disabled, top-p 1.0 =
# disabled, min-p 0 = disabled, repetition penalty 1.0 = none).
# -------------------------------------------------------------------------

@ public { }
fn generation_failure(int context, int max_prompt, int max_tokens, int seed) → GenerationConfig ⇥ GenerationError {
    return construct_generation(context, max_prompt, max_tokens, seed, 1.0 ∷ f32, 0, 1.0 ∷ f32, 0.0 ∷ f32, 1.0 ∷ f32)
}

# -------------------------------------------------------------------------
# The declared supported surface + the admission predicate. NGAB5 and the
# product repo adapt to support_flags(); any control outside it is an
# explicit reject row (never silently ignored).
# -------------------------------------------------------------------------

@ public { }
fn support_flags() → list<string> {
    return ["context", "max_prompt", "max_tokens", "seed", "temperature", "top_k", "top_p", "min_p", "repetition_penalty", "acceleration"]
}

# Admission predicate: true iff the control name is a supported field.
@ public { }
fn admitted_features(string name) → bool {
    const list<string> support ← support_flags()
    for from support const s {
        if s ≡ name then return true
    }
    return false
}

# -------------------------------------------------------------------------
# The deterministic mapping — what the generation loop consumes.
# -------------------------------------------------------------------------

# The five sampling fields project exactly onto the U3 Config (the
# config validated the same domains — the mapping never fails).
@ public { }
fn config(GenerationConfig g) → sampling.Config ⇥ GenerationError {
    do {
        return sampling.construct_config(g.temperature(), g.top_k(), g.top_p(), g.min_p(), g.repetition_penalty())
    }
    catch err {
        const string c ← err.message
        throw variant InvalidConfig {message = c}
    }
    throw variant InvalidConfig {message = "unreachable"}
}

# The seed projects exactly onto the U5 Seed (the config validated
# seed ≥ 1 — the mapping never fails).
@ public { }
fn seed(GenerationConfig g) → train.Seed ⇥ GenerationError {
    do {
        return train.construct_seed(g.seed())
    }
    catch err {
        const string c ← err.message
        throw variant InvalidConfig {message = c}
    }
    throw variant InvalidConfig {message = "unreachable"}
}

# -------------------------------------------------------------------------
# The versioned wire — schema 1.1.0 with nine numeric fields plus one
# policy segment (13 slash parts). Legacy 1.0.0 12-part wires decode to
# disabled. An extra field or unknown version/mode rejects.
# -------------------------------------------------------------------------

@ private { }
fn _serialize_acceleration(AccelerationPolicy p) → string {
    return "§:§:§:§"(p.version(), acceleration_mode_name(p.mode()), p.min_block() ↦ string, p.max_block() ↦ string)
}

@ public { }
fn serialize_generation(GenerationConfig g) → string {
    const string head ← "generation/config/§/§/§/§/§/§/§/§/§/§"(schema_version, g.context() ↦ string, g.max_prompt() ↦ string, g.max_tokens() ↦ string, g.seed() ↦ string, g.temperature() ↦ string, g.top_k() ↦ string, g.top_p() ↦ string, g.min_p() ↦ string, g.repetition_penalty() ↦ string)
    return head + "/" + _serialize_acceleration(g.acceleration())
}

@ private { }
fn _digit(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    for from s const c {
        # String iteration binds a one-character value; convert before comparing.
        if not _digit(c ↦ string) then return false
    }
    return true
}

@ private { }
fn _wire_int(string text, string detail) → int ⇥ GenerationError {
    require _numeric(text) throw variant BadWire {message = detail}
    do {
        return text ↦ int
    }
    catch err {
        throw variant BadWire {message = detail}
    }
    throw variant BadWire {message = detail}
}

@ private { }
fn _wire_f32(string text, string detail) → f32 ⇥ GenerationError {
    do {
        return text ↦ f32
    }
    catch err {
        throw variant BadWire {message = detail}
    }
    throw variant BadWire {message = detail}
}

@ private { }
fn _deserialize_acceleration(string segment) → AccelerationPolicy ⇥ GenerationError {
    const list<string> bits ← segment.split(":")
    require bits.length() ≡ 4 throw variant BadWire {message = "malformed acceleration policy"}
    const string version ← bits.get(0) coalesce ""
    const AccelerationMode mode ← _acceleration_mode_from_name(bits.get(1) coalesce "")
    const int min_block ← _wire_int(bits.get(2) coalesce "", "malformed acceleration block size in generation wire")
    const int max_block ← _wire_int(bits.get(3) coalesce "", "malformed acceleration block size in generation wire")
    return construct_acceleration(version, mode, min_block, max_block)
}

@ public { }
fn deserialize_generation(string wire) → GenerationConfig ⇥ GenerationError {
    const list<string> parts ← wire.split("/")
    require parts.length() ≥ 12 throw variant BadWire {message = "malformed generation config wire"}
    require parts.length() ≤ 13 throw variant BadWire {message = "malformed generation config wire"}
    require parts.get(0) coalesce "" ≡ "generation" throw variant BadWire {message = "unknown generation marker"}
    require parts.get(1) coalesce "" ≡ "config" throw variant BadWire {message = "unknown generation marker"}
    const string version ← parts.get(2) coalesce ""
    if version ≡ schema_version_legacy {
        require parts.length() ≡ 12 throw variant BadWire {message = "malformed generation config wire"}
    }
    if version ≡ schema_version {
        require parts.length() ≡ 13 throw variant BadWire {message = "malformed generation config wire"}
    }
    if version ≠ schema_version_legacy {
        require version ≡ schema_version throw variant UnknownVersion {message = "unknown generation schema version"}
    }
    const int context ← _wire_int(parts.get(3) coalesce "", "malformed context length in generation wire")
    const int max_prompt ← _wire_int(parts.get(4) coalesce "", "malformed prompt batch in generation wire")
    const int max_tokens ← _wire_int(parts.get(5) coalesce "", "malformed max tokens in generation wire")
    const int seed ← _wire_int(parts.get(6) coalesce "", "malformed seed in generation wire")
    const f32 temperature ← _wire_f32(parts.get(7) coalesce "", "malformed temperature in generation wire")
    const int top_k ← _wire_int(parts.get(8) coalesce "", "malformed top-k in generation wire")
    const f32 top_p ← _wire_f32(parts.get(9) coalesce "", "malformed top-p in generation wire")
    const f32 min_p ← _wire_f32(parts.get(10) coalesce "", "malformed min-p in generation wire")
    const f32 penalty ← _wire_f32(parts.get(11) coalesce "", "malformed repetition penalty in generation wire")
    if version ≡ schema_version_legacy {
        return construct_generation(context, max_prompt, max_tokens, seed, temperature, top_k, top_p, min_p, penalty)
    }
    return construct_generation_with_policy(context, max_prompt, max_tokens, seed, temperature, top_k, top_p, min_p, penalty, _deserialize_acceleration(parts.get(12) coalesce ""))
}

# -------------------------------------------------------------------------
# The generation cursor (PML5-U5 — context-limit wiring). The cursor is the
# generation loop's explicit state: the decode session position + the
# generated-token count. The LIMIT POLICY is explicit REJECT (the U1
# reject-policy precedent) — never silent truncation: cursor_advance
# rejects with a typed LimitReached when the next step would exceed either the
# context limit (session position >= context) or the maximum-generated-
# tokens limit (emitted >= max_tokens). With max_tokens <=
# context (the U4 validation) the max-tokens bound is the binding
# constraint in ordinary progression; the context rejection is the
# defensive fail-closed guard (probe-tested at the boundary state). The
# cursor reset (cursor_reset) returns the fresh session state (the
# U1 reset precedent) with the count cleared.
# -------------------------------------------------------------------------


@ public { }
class GenerationCursor {
    decode.Session session
    int emitted

    # The decode session (the position counter).
    fn session() → decode.Session {
        return self.session
    }

    # The generated-token count.
    fn emitted() → int {
        return self.emitted
    }
}

# A fresh cursor at position 0 with count 0 over the config's context.
@ public { }
fn fresh_cursor(GenerationConfig g) → GenerationCursor ⇥ GenerationError {
    var decode.Session s ← decode.default_session()
    do {
        s ← decode.fresh_session(g.context())
        return GenerationCursor {session = s, emitted = 0}
    }
    catch err {
        throw variant InvalidConfig {message = err.message}
    }
    throw variant InvalidConfig {message = "unreachable"}
}

# Placeholder Default for `var GenerationCursor` bindings (var on structs).
# Empty session (not a valid cursor). Only a placeholder the caller
# overwrites, or returns from an unreachable cape arm.
@ public { }
fn default_cursor() → GenerationCursor {
    return GenerationCursor {session = decode.default_session(), emitted = 0}
}

# The explicit limit-policy predicate: another token is allowed iff the
# session position is below the context limit AND the generated count is
# below the maximum-generated-tokens limit.
@ public { }
fn token_allowed(GenerationConfig g, GenerationCursor c) → bool {
    if c.session().position() ≥ g.context() then return false
    if c.emitted() ≥ g.max_tokens() then return false
    return true
}

# The next step — REJECTS (never truncates) when the step would exceed the
# max-tokens limit or the context limit; otherwise advances the session
# position by one and the count by one.
@ public { }
fn cursor_advance(GenerationConfig g, GenerationCursor c) → GenerationCursor ⇥ GenerationError {
    require c.emitted() ≺ g.max_tokens() throw variant LimitReached {message = "maximum generated tokens reached"}
    require c.session().position() ≺ g.context() throw variant LimitReached {message = "context limit reached"}
    return GenerationCursor {session = decode.Session {position = c.session().position() + 1, context = c.session().context()}, emitted = c.emitted() + 1}
}

# Reset the cursor to the fresh state: session position 0 (the U1
# reset precedent, context preserved) with the count cleared.
@ public { }
fn cursor_reset(GenerationCursor c) → GenerationCursor {
    return GenerationCursor {session = decode.Session {position = 0, context = c.session().context()}, emitted = 0}
}

# -------------------------------------------------------------------------
# StopPolicy — the generate-route stop binding. Additive: existing
# generate / generate_cancelled / generate_dense keep Eog. IgnoreEos is
# the llama.cpp ignore_eos row (U5 golden capture): admitted EOG ids
# {0, 2} are suppressed from the sampled logits (finite large-negative
# mask, never -inf — the sampling finite gate) and the loop does not
# halt on EOG, so generation proceeds to the max_tokens ceiling.
# Cross-module callers use the factories; they cannot invent imported
# variants (the RopePolicy precedent).
# -------------------------------------------------------------------------

@ public { }
union StopPolicy {
    Eog,
    IgnoreEos
}

@ public { }
fn eog_stop() → StopPolicy {
    return variant Eog
}

@ public { }
fn ignore_eos() → StopPolicy {
    return variant IgnoreEos
}

@ public { }
fn stop_policy_name(StopPolicy p) → string {
    match p {
        case Eog {
            return "eog"
        }
        case IgnoreEos {
            return "ignore_eos"
        }
    }
}

@ public { }
fn stops_on_eog(StopPolicy p) → bool {
    match p {
        case Eog {
            return true
        }
        case IgnoreEos {
            return false
        }
    }
}

# Finite EOG mask. Sampling rejects non-finite logits, so this is a
# large negative rather than -inf. Any real vocab logit wins over it.
@ private { }
fn _suppress_eog(list<f32> logits) → list<f32> {
    var list<f32> out ← empty
    # legacy-L2: flat list carrier — index is required for tokenizer.is_eog; retain range/index walk.
    for range 0‥logits.length() const i {
        if tokenizer.is_eog(i) {
            out.append((0.0 - 1000000000.0) ∷ f32)
        }
        else {
            out.append(logits.get(i) coalesce 0.0 ∷ f32)
        }
    }
    return out
}

@ private { }
fn _sample_logits(list<f32> logits, StopPolicy stop) → list<f32> {
    if stops_on_eog(stop) {
        return logits
    }
    return _suppress_eog(logits)
}

# Cursor sitting just after a prompt of length prompt_len: next decode
# position is the prompt length, generated count is 0. Rejects an empty
# prompt and a prompt that leaves no room in the context.
@ public { }
fn cursor_after_prompt(GenerationConfig g, int prompt_len) → GenerationCursor ⇥ GenerationError {
    require prompt_len ≥ 1 throw variant InvalidConfig {message = "needs at least one prompt token"}
    require prompt_len ≺ g.context() throw variant InvalidConfig {message = "prompt length does not fit context"}
    return GenerationCursor {session = decode.Session {position = prompt_len, context = g.context()}, emitted = 0}
}

# -------------------------------------------------------------------------
# generate — the public generation loop.
# -------------------------------------------------------------------------

@ private { }
fn _observe(decode.Cancellation cancel) → void ⇥ GenerationError {
    do {
        const decode.Cancellation _ ← decode.observe_cancellation(cancel)
        return
    }
    catch err {
        throw variant Cancelled {message = err.message}
    }
}

@ private { }
fn _sample(list<f32> logits, sampling.Config c, list<int> history, train.Seed seed) → sampling.Sampler ⇥ GenerationError {
    do {
        return sampling.sample(logits, c, history, seed)
    }
    catch err {
        throw variant DecodeFailure {message = err.message}
    }
}

@ private { }
fn _prefill(list<int> prompt_ids, decode.Decoder m) → tensor.Tensor ⇥ GenerationError {
    do {
        return decode.prefill(prompt_ids, m)
    }
    catch err {
        throw variant DecodeFailure {message = err.message}
    }
}

@ private { }
fn _decode_one(int token_id, int position, decode.Decoder m) → tensor.Tensor ⇥ GenerationError {
    do {
        return decode.decode_data(token_id, position, m)
    }
    catch err {
        throw variant DecodeFailure {message = err.message}
    }
}

@ private { }
fn _last_logits(tensor.Tensor logits, int vocab) → list<f32> ⇥ GenerationError {
    # legacy-L3: shape recovery pending shape-binding/S0-R1.
    const list<int> shape ← logits.shape()
    if shape.length() ≡ 1 {
        return logits.data
    }
    require shape.length() ≡ 2 throw variant DecodeFailure {message = "decode logits must be rank-1 or rank-2"}
    const int rows ← shape.get(0) coalesce 0
    const int cols ← shape.get(1) coalesce 0
    require rows ≥ 1 throw variant DecodeFailure {message = "decode logits shape does not match the vocabulary"}
    require cols ≡ vocab throw variant DecodeFailure {message = "decode logits shape does not match the vocabulary"}
    var list<f32> row ← empty
    # legacy-L2: staged carrier — logits is a flat-data Tensor; retain indexed access until shaped carrier migration.
    for range 0‥vocab const i {
        do {
            row.append(logits.get([rows - 1, i]))
        }
        catch err {
            throw variant DecodeFailure {message = err.message}
        }
    }
    return row
}

@ private { }
fn _dense_one(DenseEngine engine, (string, int) → tensor.Tensor ⇥ dense.DenseError source, int token_id, int position, list<kv.KVCache> layers) → dense.DenseStep ⇥ GenerationError {
    do {
        return dense.decode_step(engine.architecture, source, token_id, position, engine.epsilon, engine.scale, engine.rope_dim, engine.rope, layers)
    }
    catch err {
        throw variant DecodeFailure {message = err.message}
    }
}

@ private { }
fn _dense_prefill(DenseEngine engine, (string, int) → tensor.Tensor ⇥ dense.DenseError source, list<int> prompt_ids, list<kv.KVCache> layers) → dense.DenseStep ⇥ GenerationError {
    do {
        return dense.prefill_cached(engine.architecture, source, prompt_ids, engine.epsilon, engine.scale, engine.rope_dim, engine.rope, layers)
    }
    catch err {
        throw variant DecodeFailure {message = err.message}
    }
}

@ private { }
fn _prefix(list<int> base, list<int> ids, int count) → list<int> {
    var list<int> out ← empty
    for from base const token {
        out.append(token)
    }
    # legacy-L2: flat list carrier — prefix count requires indexed access; retain bounded range walk.
    for range 0‥count const i {
        out.append(ids.get(i) coalesce 0)
    }
    return out
}

@ private { }
fn _advance_n(GenerationConfig g, GenerationCursor start, int count) → GenerationCursor ⇥ GenerationError {
    var GenerationCursor out ← start
    var int i ← 0
    while i ≺ count {
        out ← cursor_advance(g, out)
        i ← i + 1
    }
    return out
}

@ private { }
fn _logit_row(tensor.Tensor logits, int row, int vocab) → list<f32> ⇥ GenerationError {
    require logits.rank() ≡ 2 throw variant DecodeFailure {message = "decode logits must be rank two"}
    # legacy-L3: shape recovery pending shape-binding/S0-R1.
    const list<int> shape ← logits.shape()
    const int rows ← shape.get(0) coalesce 0
    const int cols ← shape.get(1) coalesce 0
    require row ≥ 0 and row ≺ rows throw variant DecodeFailure {message = "decode logits row is outside the block"}
    require cols ≡ vocab throw variant DecodeFailure {message = "decode logits shape does not match the vocabulary"}
    var list<f32> out ← empty
    # legacy-L2: staged carrier — logits.data is flat list<f32>; retain range/index walk until shaped carrier migration.
    for range 0‥vocab const i {
        out.append(logits.data.get(row * vocab + i) coalesce 0.0 ∷ f32)
    }
    return out
}

@ private { }
fn _target_ids(tensor.Tensor logits, int rows, int vocab, sampling.Config drawn, train.Seed rng, StopPolicy stop) → list<int> ⇥ GenerationError {
    var list<int> out ← empty
    for range 0‥rows const row {
        const list<f32> values ← _logit_row(logits, row, vocab)
        const sampling.Sampler target ← _sample(_sample_logits(values, stop), drawn, empty, rng)
        out.append(target.token_id())
    }
    return out
}

@ private { }
fn _accepted_prefix(list<int> ids, int count, StopPolicy stop) → int {
    if not stops_on_eog(stop) {
        return count
    }
    # legacy-L2: flat list carrier — prefix count requires indexed access; retain bounded range walk.
    for range 0‥count const i {
        if tokenizer.is_eog(ids.get(i) coalesce (0 - 1)) {
            return i + 1
        }
    }
    return count
}

@ private { }
fn _lookup_context(list<int> prompt, list<int> history) → list<int> {
    var list<int> context ← empty
    for from prompt const token {
        context.append(token)
    }
    for from history const token {
        context.append(token)
    }
    return context
}

@ private { }
fn _accepted_target_count(list<int> target_ids, list<int> candidate_ids) → int {
    var int count ← 0
    # legacy-L2: flat list carriers — parallel indexed comparison requires the bounded walk.
    while count ≺ target_ids.length() and count ≺ candidate_ids.length() {
        if target_ids.get(count) coalesce (0 - 1) ≠ candidate_ids.get(count) coalesce (0 - 1) {
            return count
        }
        count ← count + 1
    }
    return count
}

@ private { }
fn _lookup_candidates(list<int> prompt, list<int> history, int block_size) → list<int> {
    const list<int> context ← _lookup_context(prompt, history)
    const int available ← context.length()
    if available ≺ 2 {
        return empty
    }
    var int match_length ← block_size
    if match_length ≻ available - 1 {
        match_length ← available - 1
    }
    while match_length ≥ 1 {
        const int suffix_start ← available - match_length
        const int source_limit ← available - match_length
        var int source_offset ← 0
        while source_offset ≤ source_limit {
            var bool matches ← true
            # legacy-L2: flat list carrier — parallel context windows require indexed access; retain bounded range walk.
            for range 0‥match_length const i {
                if context.get(source_offset + i) coalesce (0 - 1) ≠ context.get(suffix_start + i) coalesce (0 - 1) {
                    matches ← false
                }
            }
            if matches {
                const int following ← source_offset + match_length
                var int extension ← block_size
                if extension ≻ available - following {
                    extension ← available - following
                }
                if extension ≥ 1 {
                    var list<int> candidates ← empty
                    # legacy-L2: flat list carrier — indexed suffix extraction retains the bounded range walk.
                    for range 0‥extension const i {
                        candidates.append(context.get(following + i) coalesce (0 - 1))
                    }
                    return candidates
                }
            }
            source_offset ← source_offset + 1
        }
        match_length ← match_length - 1
    }
    return empty
}

@ private { }
fn _slice_rows(tensor.Tensor value, int start, int rows, int dimension) → tensor.Tensor ⇥ GenerationError {
    require value.shape() ≡ [start + rows, dimension] throw variant DecodeFailure {message = "verified cache shape does not match the candidate block"}
    var list<f32> data ← empty
    # legacy-L2: staged carrier — value.data is flat list<f32>; retain row/column walk until shaped carrier migration.
    for range start‥(start + rows) const row {
        for range 0‥dimension const column {
            data.append(value.data.get(row * dimension + column) coalesce 0.0 ∷ f32)
        }
    }
    do {
        return tensor.construct(data, [rows, dimension])
    }
    catch err {
        throw variant DecodeFailure {message = err.message}
    }
}

@ private { }
fn _commit_dense_block(list<kv.KVCache> base, dense.DenseStep verified, list<int> candidate_ids, int accepted_count) → list<kv.KVCache> ⇥ GenerationError {
    require accepted_count ≥ 1 throw variant DecodeFailure {message = "accepted candidate block must not be empty"}
    require accepted_count ≤ candidate_ids.length() throw variant DecodeFailure {message = "accepted candidate block exceeds the proposal"}
    require verified.layers().length() ≡ base.length() throw variant DecodeFailure {message = "verified cache layer count does not match the base"}
    var list<kv.KVCache> committed ← empty
    const kv.KVCache first ← base.get(0) coalesce kv.default()
    const int prefix ← first.length()
    const list<int> accepted_ids ← _prefix(empty, candidate_ids, accepted_count)
    # legacy-L2: flat list carriers — parallel cache lists require indexed access; retain bounded range walk.
    for range 0‥base.length() const i {
        const kv.KVCache before ← base.get(i) coalesce kv.default()
        const kv.KVCache after ← verified.layers().get(i) coalesce kv.default()
        const tensor.Tensor key ← _slice_rows(after.key(), prefix, accepted_count, before.dimension())
        const tensor.Tensor payload ← _slice_rows(after.payload(), prefix, accepted_count, before.dimension())
        do {
            committed.append(kv.extend(before, accepted_ids, key, payload))
        }
        catch err {
            throw variant DecodeFailure {message = err.message}
        }
    }
    return committed
}

# Public generate: config + prompt ids + the admitted decoder.
# Prefill produces the last-row logits; each later step is
# decode_data + sampling.sample. Default stop is Eog: halt after the
# first EOG token (tokenizer.is_eog — set {0, 2}) or at the cursor
# ceiling. generate_with_stop / generate_cancelled_with_stop take an
# explicit StopPolicy. The KV-wired loop is generate_dense.
@ public { }
fn generate(GenerationConfig g, list<int> prompt_ids, decode.Decoder m) → list<int> ⇥ GenerationError {
    return generate_cancelled(g, prompt_ids, m, decode.fresh_cancellation())
}

@ public { }
fn generate_with_stop(GenerationConfig g, list<int> prompt_ids, decode.Decoder m, StopPolicy stop) → list<int> ⇥ GenerationError {
    return generate_cancelled_with_stop(g, prompt_ids, m, decode.fresh_cancellation(), stop)
}

@ public { }
fn generate_cancelled(GenerationConfig g, list<int> prompt_ids, decode.Decoder m, decode.Cancellation cancel) → list<int> ⇥ GenerationError {
    return generate_cancelled_with_stop(g, prompt_ids, m, cancel, eog_stop())
}

@ public { }
fn generate_cancelled_with_stop(GenerationConfig g, list<int> prompt_ids, decode.Decoder m, decode.Cancellation cancel, StopPolicy stop) → list<int> ⇥ GenerationError {
    _observe(cancel)
    require prompt_ids.length() ≥ 1 throw variant InvalidConfig {message = "needs at least one prompt token"}
    require prompt_ids.length() ≺ g.context() throw variant InvalidConfig {message = "prompt length does not fit context"}
    require prompt_ids.length() ≤ m.context() throw variant InvalidConfig {message = "prompt length does not fit context"}
    const sampling.Config drawn ← config(g)
    var train.Seed rng ← seed(g)
    const tensor.Tensor pref ← _prefill(prompt_ids, m)
    var list<f32> last ← _last_logits(pref, m.vocabulary())
    var GenerationCursor cursor ← cursor_after_prompt(g, prompt_ids.length())
    var list<int> tokens ← empty
    var list<int> history ← empty
    var bool finished ← false
    while token_allowed(g, cursor) and not finished {
        _observe(cancel)
        const sampling.Sampler outcome ← _sample(_sample_logits(last, stop), drawn, history, rng)
        const int token ← outcome.token_id()
        tokens.append(token)
        history.append(token)
        rng ← outcome.seed()
        cursor ← cursor_advance(g, cursor)
        if tokenizer.is_eog(token) and stops_on_eog(stop) {
            finished ← true
        }
        else {
            if token_allowed(g, cursor) {
                const tensor.Tensor step ← _decode_one(token, cursor.session().position() - 1, m)
                last ← _last_logits(step, m.vocabulary())
            }
            else {
                finished ← true
            }
        }
    }
    return tokens
}

# Dense-engine carrier for generate_dense (the SmolLM2 / G1 path).
@ public { }
class DenseEngine {
    dense.DenseConfig architecture
    f32 epsilon
    f32 scale
    int rope_dim
    attention.RopeConfig rope
}

@ public { }
fn construct_dense_engine(dense.DenseConfig architecture, f32 epsilon, f32 scale, int rope_dim, attention.RopeConfig rope) → DenseEngine {
    return DenseEngine {architecture = architecture, epsilon = epsilon, scale = scale, rope_dim = rope_dim, rope = rope}
}

@ public { }
fn default_dense_engine() → DenseEngine {
    return DenseEngine {architecture = dense.DenseConfig {layers = 0, heads = 0, kv_heads = 0, head_dim = 0, hidden_dim = 0, vocab = 0, tied = false}, epsilon = 0.0, scale = 0.0, rope_dim = 0, rope = attention.default()}
}

# Same loop as generate, over dense.decode_step and a per-layer KV cache.
# Used by the SmolLM2 oracle example. Default EOG-stop applies: SmolLM2
# EOS=2 is in the admitted set {0, 2}, so a greedy continuation that
# would have been G1's unrestrained [30, 2, 198] becomes [30, 2].
# generate_dense_with_stop(IgnoreEos) suppresses EOG from sampling and
# runs to max_tokens — the U5 / llama.cpp ignore_eos row.
@ public { }
fn generate_dense(GenerationConfig g, list<int> prompt_ids, DenseEngine engine, (string, int) → tensor.Tensor ⇥ dense.DenseError source, list<kv.KVCache> layers, decode.Cancellation cancel) → list<int> ⇥ GenerationError {
    return generate_dense_with_stop(g, prompt_ids, engine, source, layers, cancel, eog_stop())
}

@ public { }
fn generate_dense_with_stop(GenerationConfig g, list<int> prompt_ids, DenseEngine engine, (string, int) → tensor.Tensor ⇥ dense.DenseError source, list<kv.KVCache> layers, decode.Cancellation cancel, StopPolicy stop) → list<int> ⇥ GenerationError {
    _observe(cancel)
    require prompt_ids.length() ≥ 1 throw variant InvalidConfig {message = "needs at least one prompt token"}
    require prompt_ids.length() ≺ g.context() throw variant InvalidConfig {message = "prompt length does not fit context"}
    const string acceleration_mode ← acceleration_mode_name(g.acceleration().mode())
    if acceleration_mode ≡ "context_lookup" {
        if g.temperature() ≻ 0.0 or g.top_k() ≻ 0 or (g.top_p() ≻ 0.0 and g.top_p() ≺ 1.0) or g.min_p() ≻ 0.0 {
            throw variant SampledAccelerationRejected {message = "sampled acceleration is not supported"}
        }
    }
    const sampling.Config drawn ← config(g)
    var train.Seed rng ← seed(g)
    _observe(cancel)
    const dense.DenseStep pref ← _dense_prefill(engine, source, prompt_ids, layers)
    var list<kv.KVCache> state ← pref.layers()
    var list<f32> last ← _last_logits(pref.logits(), engine.architecture.vocab)
    var GenerationCursor cursor ← cursor_after_prompt(g, prompt_ids.length())
    var list<int> tokens ← empty
    var list<int> history ← empty
    var bool finished ← false
    while token_allowed(g, cursor) and not finished {
        _observe(cancel)
        if acceleration_mode ≡ "disabled" {
            const sampling.Sampler outcome ← _sample(_sample_logits(last, stop), drawn, history, rng)
            const int token ← outcome.token_id()
            tokens.append(token)
            history.append(token)
            rng ← outcome.seed()
            cursor ← cursor_advance(g, cursor)
            if tokenizer.is_eog(token) and stops_on_eog(stop) {
                finished ← true
            }
            else {
                if token_allowed(g, cursor) {
                    const dense.DenseStep step ← _dense_one(engine, source, token, cursor.session().position() - 1, state)
                    last ← _last_logits(step.logits(), engine.architecture.vocab)
                    state ← step.layers()
                }
                else {
                    finished ← true
                }
            }
        }
        else {
            const int block_size ← g.acceleration().max_block()
            const list<int> candidate_ids ← _lookup_candidates(prompt_ids, history, block_size)
            if candidate_ids.length() ≡ 0 {
                const sampling.Sampler outcome ← _sample(_sample_logits(last, stop), drawn, history, rng)
                const int token ← outcome.token_id()
                tokens.append(token)
                history.append(token)
                rng ← outcome.seed()
                cursor ← cursor_advance(g, cursor)
                if tokenizer.is_eog(token) and stops_on_eog(stop) {
                    finished ← true
                }
                else {
                    if token_allowed(g, cursor) {
                        const dense.DenseStep step ← _dense_one(engine, source, token, cursor.session().position() - 1, state)
                        last ← _last_logits(step.logits(), engine.architecture.vocab)
                        state ← step.layers()
                    }
                    else {
                        finished ← true
                    }
                }
            }
            else {
                var dense.DenseStep verified ← dense.default_step()
                var bool attempt_ok ← true
                do {
                    verified ← dense.decode_block(engine.architecture, source, candidate_ids, engine.epsilon, engine.scale, engine.rope_dim, engine.rope, state)
                }
                catch err {
                    attempt_ok ← false
                }
                var list<int> target_ids ← empty
                if attempt_ok {
                    do {
                        target_ids ← _target_ids(verified.logits(), candidate_ids.length(), engine.architecture.vocab, drawn, rng, stop)
                    }
                    catch err {
                        attempt_ok ← false
                    }
                }
                if not attempt_ok {
                    const sampling.Sampler outcome ← _sample(_sample_logits(last, stop), drawn, history, rng)
                    const int token ← outcome.token_id()
                    tokens.append(token)
                    history.append(token)
                    rng ← outcome.seed()
                    cursor ← cursor_advance(g, cursor)
                    if tokenizer.is_eog(token) and stops_on_eog(stop) {
                        finished ← true
                    }
                    else {
                        if token_allowed(g, cursor) {
                            const dense.DenseStep step ← _dense_one(engine, source, token, cursor.session().position() - 1, state)
                            last ← _last_logits(step.logits(), engine.architecture.vocab)
                            state ← step.layers()
                        }
                        else {
                            finished ← true
                        }
                    }
                }
                else {
                    const int raw_accepted ← _accepted_target_count(target_ids, candidate_ids)
                    const int remaining ← g.max_tokens() - cursor.emitted()
                    var int accepted_count ← raw_accepted
                    if accepted_count ≻ remaining {
                        accepted_count ← remaining
                    }
                    accepted_count ← _accepted_prefix(candidate_ids, accepted_count, stop)
                    var GenerationCursor staged_cursor ← cursor
                    var bool staging_ok ← true
                    do {
                        staged_cursor ← _advance_n(g, cursor, accepted_count)
                    }
                    catch err {
                        staging_ok ← false
                    }
                    var list<f32> staged_last ← last
                    if staging_ok and accepted_count ≻ 0 {
                        do {
                            staged_last ← _logit_row(verified.logits(), accepted_count - 1, engine.architecture.vocab)
                        }
                        catch err {
                            staging_ok ← false
                        }
                    }
                    var list<kv.KVCache> committed ← empty
                    if staging_ok and accepted_count ≻ 0 {
                        do {
                            committed ← _commit_dense_block(state, verified, candidate_ids, accepted_count)
                        }
                        catch err {
                            staging_ok ← false
                        }
                    }
                    if not staging_ok {
                        const sampling.Sampler outcome ← _sample(_sample_logits(last, stop), drawn, history, rng)
                        const int token ← outcome.token_id()
                        tokens.append(token)
                        history.append(token)
                        rng ← outcome.seed()
                        cursor ← cursor_advance(g, cursor)
                        if tokenizer.is_eog(token) and stops_on_eog(stop) {
                            finished ← true
                        }
                        else {
                            if token_allowed(g, cursor) {
                                const dense.DenseStep step ← _dense_one(engine, source, token, cursor.session().position() - 1, state)
                                last ← _last_logits(step.logits(), engine.architecture.vocab)
                                state ← step.layers()
                            }
                            else {
                                finished ← true
                            }
                        }
                    }
                    else {
                        if accepted_count ≡ 0 {
                            const sampling.Sampler outcome ← _sample(_sample_logits(last, stop), drawn, history, rng)
                        const int token ← outcome.token_id()
                        tokens.append(token)
                        history.append(token)
                        rng ← outcome.seed()
                        cursor ← cursor_advance(g, cursor)
                        if tokenizer.is_eog(token) and stops_on_eog(stop) {
                            finished ← true
                        }
                        else {
                            if token_allowed(g, cursor) {
                                const dense.DenseStep step ← _dense_one(engine, source, token, cursor.session().position() - 1, state)
                                last ← _last_logits(step.logits(), engine.architecture.vocab)
                                state ← step.layers()
                            }
                            else {
                                finished ← true
                            }
                        }
                    }
                    else {
                        state ← committed
                        tokens ← _prefix(tokens, candidate_ids, accepted_count)
                        history ← _prefix(history, candidate_ids, accepted_count)
                        cursor ← staged_cursor
                        last ← staged_last
                        if stops_on_eog(stop) and tokenizer.is_eog(candidate_ids.get(accepted_count - 1) coalesce (0 - 1)) {
                            finished ← true
                        }
                        if raw_accepted ≺ candidate_ids.length() and accepted_count ≡ raw_accepted and token_allowed(g, cursor) and not finished {
                            const sampling.Sampler outcome ← _sample(_sample_logits(last, stop), drawn, history, rng)
                            const int token ← outcome.token_id()
                            tokens.append(token)
                            history.append(token)
                            rng ← outcome.seed()
                            cursor ← cursor_advance(g, cursor)
                            if tokenizer.is_eog(token) and stops_on_eog(stop) {
                                finished ← true
                            }
                            else {
                                if token_allowed(g, cursor) {
                                    const dense.DenseStep step ← _dense_one(engine, source, token, cursor.session().position() - 1, state)
                                    last ← _last_logits(step.logits(), engine.architecture.vocab)
                                    state ← step.layers()
                                }
                                else {
                                    finished ← true
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }
    return tokens
}
