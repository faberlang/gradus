+++
locale = "la"
+++
# Generation-configuration contract — PML5-U4 (production inference
# computation layer; the single authority for generation configuration).
#
# Public import: importa ex "gradus:generation" privata generatio
# Depends on: gradus:dtype (finita), gradus:sampling (Configura — the U3
# sampling semantics the mapping is deterministic against), gradus:train
# (Semen — the U5 seed/RNG the seed mapping feeds).
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own those). This module holds no device handle and makes no performance
# claims.
#
# =========================================================================
# The generation-config contract (pml5-delivery.md PML5-U4)
# =========================================================================
#
# --- The single authority (council R7) -----------------------------------
# GeneratioConfigura is THE authority for generation configuration.
# NGAB5 and the future product repo ADAPT to this contract — they never
# define a second authority. The declared supported surface is the nine
# fields below (imperia_subsidia()); every llama.cpp-style control
# outside that surface is an EXPLICIT reject row (imperium_admissum →
# false; the reject-row matrix is probed) — never silently ignored. The
# versioned wire carries exactly the nine fields; an extra field breaks
# the parse (fail closed).
#
# --- Supported values, defaults, validation (the nine fields) ------------
#   contextus        — context length; ≥ 1. The decode/cache context the
#                      generated sequence must fit within.
#   magna_promptus   — prompt batch size (the prefill batch); ≥ 1.
#   maxima_verborum  — maximum generated tokens; ≥ 1 and ≤ contextus
#                      (the generated sequence must fit the context).
#   semen            — the deterministic RNG seed; ≥ 1 (the Semen rule —
#                      xorshift64 degenerates at 0; the mapping never
#                      fails).
#   temperatura      — temperature scaling; ≥ 0 (0 selects the greedy
#                      path — the U3 rule); default 1.0.
#   top_k            — top-k filter width; ≥ 0 (0 disables); default 0.
#   top_p            — top-p (nucleus) threshold; ∈ [0, 1] (≥ 1 disables);
#                      default 1.0.
#   min_p            — min-p threshold; ∈ [0, 1] (≤ 0 disables); default 0.
#   poena_repetitionis — repetition penalty; ≥ 1 (1.0 = none); default 1.0.
# Every field is validated at construction (fail closed — the capsule
# rule); generatio_defecta gives the neutral sampling defaults.
#
# --- Deterministic mapping -----------------------------------------------
# The contract maps deterministically to what the generation loop
# consumes: configura(g) → the U3 sampling Configura (the five sampling
# fields project exactly — the same domains, so the mapping never fails)
# and semen(g) → the U5 Semen (the seed projects exactly). The mapping is
# a pure function — equal configs map to equal values.
#
# --- Evidence honesty (CTO Q2, hard) -------------------------------------
# This surface is the STRUCTURAL proof: the supported values, defaults,
# validation, the deterministic mapping, the reject rows, and the PML5-U5
# context-limit cursor wiring are compile-validated and proven by the
# co-located proba (exact field, mapping, and boundary pins). Executed
# VALUE identity is env-blocked tree-wide today (FMIR stepper /
# library-import gap — the PML4 closeout recorded both blockers; neither
# is fixed here). PML5-U4 is PARTIAL: value-identity is deferred to the
# auditor-owned runtime-evidence gate.
#
# =========================================================================
# PML5-U5 additions — the context-limit wiring (reject vs truncate policy)
# =========================================================================
#
# The explicit policy decision: REJECT, never truncate (the U1 reject
# precedent). The generation cursor (GenereCursor) is the loop's explicit
# state — the decode session position + the generated-token count.
# cursor_progredere rejects with a typed Terminus when the next step
# would exceed the context limit (position >= contextus) or the
# maximum-generated-tokens limit (count >= maxima_verborum); the input
# limits are the U4 config's contextus/maxima_verborum. verbum_licet is
# the explicit policy predicate. cursor_redintegra resets to the fresh
# session state (the U1 redintegra precedent) with the count cleared.
# No server or device handle enters this module.
importa ex "gradus:dtype" dtype
importa ex "gradus:sampling" sampling
importa ex "gradus:train" train
importa ex "gradus:decode" decode

# -------------------------------------------------------------------------
# GeneratioError — typed error vocabulary of the generation-config
# contract. Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------

discretio GeneratioError {
    ConfiguraInvalida { textus causa },
    ElementaMismatch { textus causa },
    TypoMismatch { textus causa },
    Incompatibilis { textus causa },
    VersioIgnota { textus causa },
    WireMala { textus causa },
    Terminus { textus causa }
}

functio causa(GeneratioError e) → textus {
    discerne e {
        casu ConfiguraInvalida fixum causa { redde causa }
        casu ElementaMismatch fixum causa { redde causa }
        casu TypoMismatch fixum causa { redde causa }
        casu Incompatibilis fixum causa { redde causa }
        casu VersioIgnota fixum causa { redde causa }
        casu WireMala fixum causa { redde causa }
        casu Terminus fixum causa { redde causa }
    }
}

# The contract's schema version (the wire form).
fixum textus schema_versio ← "1.0.0"

# -------------------------------------------------------------------------
# GeneratioConfigura — the nine-field generation configuration.
# -------------------------------------------------------------------------

@ publica
genus GeneratioConfigura {
    numerus contextus
    numerus magna_promptus
    numerus maxima_verborum
    numerus semen
    f32 temperatura
    numerus top_k
    f32 top_p
    f32 min_p
    f32 poena_repetitionis

    # Context length.
    functio contextus() → numerus {
        redde ego.contextus
    }

    # Prompt batch size (the prefill batch).
    functio magna_promptus() → numerus {
        redde ego.magna_promptus
    }

    # Maximum generated tokens.
    functio maxima_verborum() → numerus {
        redde ego.maxima_verborum
    }

    # The deterministic RNG seed.
    functio semen() → numerus {
        redde ego.semen
    }

    # Temperature scaling (0 = greedy).
    functio temperatura() → f32 {
        redde ego.temperatura
    }

    # Top-k filter width (0 = disabled).
    functio top_k() → numerus {
        redde ego.top_k
    }

    # Top-p nucleus threshold (≥ 1 = disabled).
    functio top_p() → f32 {
        redde ego.top_p
    }

    # Min-p threshold (≤ 0 = disabled).
    functio min_p() → f32 {
        redde ego.min_p
    }

    # Repetition penalty (1.0 = none).
    functio poena_repetitionis() → f32 {
        redde ego.poena_repetitionis
    }
}

# Field-wise config equality — the round-trip/determinism predicate.
functio generatio_aequus(GeneratioConfigura a, GeneratioConfigura b) → bivalens {
    si a.contextus() ≠ b.contextus() ergo redde falsum
    si a.magna_promptus() ≠ b.magna_promptus() ergo redde falsum
    si a.maxima_verborum() ≠ b.maxima_verborum() ergo redde falsum
    si a.semen() ≠ b.semen() ergo redde falsum
    si a.temperatura() ≠ b.temperatura() ergo redde falsum
    si a.top_k() ≠ b.top_k() ergo redde falsum
    si a.top_p() ≠ b.top_p() ergo redde falsum
    si a.min_p() ≠ b.min_p() ergo redde falsum
    si a.poena_repetitionis() ≠ b.poena_repetitionis() ergo redde falsum
    redde verum
}

# -------------------------------------------------------------------------
# structa_generatio — the validated constructor (the single authority's
# validation runs here AND on every deserialization — fail closed).
# -------------------------------------------------------------------------

@ publica
functio structa_generatio(
    numerus contextus,
    numerus magna_promptus,
    numerus maxima_verborum,
    numerus semen,
    f32 temperatura,
    numerus top_k,
    f32 top_p,
    f32 min_p,
    f32 poena_repetitionis
) → GeneratioConfigura ⇥ GeneratioError {
    si contextus < 1 {
        iace finge ConfiguraInvalida { causa = "context length must be at least one" }
    }
    si magna_promptus < 1 {
        iace finge ConfiguraInvalida { causa = "prompt batch size must be at least one" }
    }
    si maxima_verborum < 1 {
        iace finge ConfiguraInvalida { causa = "maximum generated tokens must be at least one" }
    }
    si maxima_verborum > contextus {
        iace finge ConfiguraInvalida { causa = "maximum generated tokens must fit within the context" }
    }
    si semen < 1 {
        iace finge ConfiguraInvalida { causa = "seed must be at least one" }
    }
    si non (dtype.finita(temperatura)) aut temperatura < 0.0 {
        iace finge ConfiguraInvalida { causa = "temperature must be non-negative" }
    }
    si top_k < 0 {
        iace finge ConfiguraInvalida { causa = "top-k must be non-negative" }
    }
    si non (dtype.finita(top_p)) aut top_p < 0.0 aut top_p > 1.0 {
        iace finge ConfiguraInvalida { causa = "top-p must be within [0, 1]" }
    }
    si non (dtype.finita(min_p)) aut min_p < 0.0 aut min_p > 1.0 {
        iace finge ConfiguraInvalida { causa = "min-p must be within [0, 1]" }
    }
    si non (dtype.finita(poena_repetitionis)) aut poena_repetitionis < 1.0 {
        iace finge ConfiguraInvalida { causa = "repetition penalty must be at least one" }
    }
    redde GeneratioConfigura {
        contextus = contextus,
        magna_promptus = magna_promptus,
        maxima_verborum = maxima_verborum,
        semen = semen,
        temperatura = temperatura,
        top_k = top_k,
        top_p = top_p,
        min_p = min_p,
        poena_repetitionis = poena_repetitionis
    }
}

# -------------------------------------------------------------------------
# generatio_defecta — the default generation config: the caller pins the
# context / prompt batch / max tokens / seed; the sampling knobs take the
# neutral defaults (temperature 1.0, top-k 0 = disabled, top-p 1.0 =
# disabled, min-p 0 = disabled, repetition penalty 1.0 = none).
# -------------------------------------------------------------------------

functio generatio_defecta(numerus contextus, numerus magna_promptus, numerus maxima_verborum, numerus semen) → GeneratioConfigura ⇥ GeneratioError {
    redde structa_generatio(contextus, magna_promptus, maxima_verborum, semen, (1.0 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32))
}

# -------------------------------------------------------------------------
# The declared supported surface + the admission predicate. NGAB5 and the
# product repo adapt to imperia_subsidia(); any control outside it is an
# explicit reject row (never silently ignored).
# -------------------------------------------------------------------------

functio imperia_subsidia() → lista<textus> {
    redde ["contextus", "magna_promptus", "maxima_verborum", "semen",
           "temperatura", "top_k", "top_p", "min_p", "poena_repetitionis"]
}

# Admission predicate: true iff the control name is a supported field.
functio imperium_admissum(textus nomen) → bivalens {
    fixum lista<textus> subsidia ← imperia_subsidia()
    itera ex subsidia fixum s {
        si s ≡ nomen ergo redde verum
    }
    redde falsum
}

# -------------------------------------------------------------------------
# The deterministic mapping — what the generation loop consumes.
# -------------------------------------------------------------------------

# The five sampling fields project exactly onto the U3 Configura (the
# config validated the same domains — the mapping never fails).
@ publica
functio configura(GeneratioConfigura g) → sampling.Configura ⇥ GeneratioError {
    fac {
        redde sampling.structa_configura(g.temperatura(), g.top_k(), g.top_p(), g.min_p(), g.poena_repetitionis())
    }
    cape err {
        fixum textus c ← sampling.causa(err)
        iace finge ConfiguraInvalida { causa = c }
    }
    iace finge ConfiguraInvalida { causa = "unreachable" }
}

# The seed projects exactly onto the U5 Semen (the config validated
# seed ≥ 1 — the mapping never fails).
@ publica
functio semen(GeneratioConfigura g) → train.Semen ⇥ GeneratioError {
    fac {
        redde train.structa_semen(g.semen())
    }
    cape err {
        fixum textus c ← train.causa(err)
        iace finge ConfiguraInvalida { causa = c }
    }
    iace finge ConfiguraInvalida { causa = "unreachable" }
}

# -------------------------------------------------------------------------
# The versioned wire — exactly the nine fields. An extra field breaks the
# parse (fail closed — unsupported controls are never silently ignored);
# every field is re-validated by structa_generatio on deserialization.
# -------------------------------------------------------------------------

functio serializa_generatio(GeneratioConfigura g) → textus {
    redde "generation/config/" + schema_versio + "/" + (g.contextus() ↦ textus) + "/" + (g.magna_promptus() ↦ textus) + "/" + (g.maxima_verborum() ↦ textus) + "/" + (g.semen() ↦ textus) + "/" + (g.temperatura() ↦ textus) + "/" + (g.top_k() ↦ textus) + "/" + (g.top_p() ↦ textus) + "/" + (g.min_p() ↦ textus) + "/" + (g.poena_repetitionis() ↦ textus)
}

@ privata
functio _digitum(textus c) → bivalens {
    redde c ≡ "0" aut c ≡ "1" aut c ≡ "2" aut c ≡ "3" aut c ≡ "4" aut c ≡ "5" aut c ≡ "6" aut c ≡ "7" aut c ≡ "8" aut c ≡ "9"
}

@ privata
functio _numerica(textus s) → bivalens {
    si s.longitudo() ≡ 0 ergo redde falsum
    si s.longitudo() > 18 ergo redde falsum
    varia numerus i ← 0
    dum i < s.longitudo() {
        si non (_digitum(s.accipe(i))) ergo redde falsum
        i ← i + 1
    }
    redde verum
}

functio deserializa_generatio(textus wire) → GeneratioConfigura ⇥ GeneratioError {
    fixum lista<textus> partes ← wire.divide("/")
    si partes.longitudo() ≠ 12 {
        iace finge WireMala { causa = "malformed generation config wire" }
    }
    si partes.accipe(0) vel "" ≠ "generation" {
        iace finge WireMala { causa = "unknown generation marker" }
    }
    si partes.accipe(1) vel "" ≠ "config" {
        iace finge WireMala { causa = "unknown generation marker" }
    }
    si partes.accipe(2) vel "" ≠ schema_versio {
        iace finge VersioIgnota { causa = "unknown generation schema version" }
    }
    fixum textus contextus_textus ← partes.accipe(3) vel ""
    fixum textus magna_textus ← partes.accipe(4) vel ""
    fixum textus maxima_textus ← partes.accipe(5) vel ""
    fixum textus semen_textus ← partes.accipe(6) vel ""
    fixum textus temperatura_textus ← partes.accipe(7) vel ""
    fixum textus top_k_textus ← partes.accipe(8) vel ""
    fixum textus top_p_textus ← partes.accipe(9) vel ""
    fixum textus min_p_textus ← partes.accipe(10) vel ""
    fixum textus poena_textus ← partes.accipe(11) vel ""
    varia numerus contextus ← 0
    varia numerus magna_promptus ← 0
    varia numerus maxima_verborum ← 0
    varia numerus semen ← 0
    varia f32 temperatura ← (0.0 ∷ f32)
    varia numerus top_k ← 0
    varia f32 top_p ← (0.0 ∷ f32)
    varia f32 min_p ← (0.0 ∷ f32)
    varia f32 poena ← (0.0 ∷ f32)
    si non (_numerica(contextus_textus)) {
        iace finge WireMala { causa = "malformed context length in generation wire" }
    }
    fac {
        contextus ← contextus_textus ↦ numerus
    }
    cape err {
        iace finge WireMala { causa = "malformed context length in generation wire" }
    }
    si non (_numerica(magna_textus)) {
        iace finge WireMala { causa = "malformed prompt batch in generation wire" }
    }
    fac {
        magna_promptus ← magna_textus ↦ numerus
    }
    cape err {
        iace finge WireMala { causa = "malformed prompt batch in generation wire" }
    }
    si non (_numerica(maxima_textus)) {
        iace finge WireMala { causa = "malformed max tokens in generation wire" }
    }
    fac {
        maxima_verborum ← maxima_textus ↦ numerus
    }
    cape err {
        iace finge WireMala { causa = "malformed max tokens in generation wire" }
    }
    si non (_numerica(semen_textus)) {
        iace finge WireMala { causa = "malformed seed in generation wire" }
    }
    fac {
        semen ← semen_textus ↦ numerus
    }
    cape err {
        iace finge WireMala { causa = "malformed seed in generation wire" }
    }
    fac {
        temperatura ← temperatura_textus ↦ f32
    }
    cape err {
        iace finge WireMala { causa = "malformed temperature in generation wire" }
    }
    si non (_numerica(top_k_textus)) {
        iace finge WireMala { causa = "malformed top-k in generation wire" }
    }
    fac {
        top_k ← top_k_textus ↦ numerus
    }
    cape err {
        iace finge WireMala { causa = "malformed top-k in generation wire" }
    }
    fac {
        top_p ← top_p_textus ↦ f32
    }
    cape err {
        iace finge WireMala { causa = "malformed top-p in generation wire" }
    }
    fac {
        min_p ← min_p_textus ↦ f32
    }
    cape err {
        iace finge WireMala { causa = "malformed min-p in generation wire" }
    }
    fac {
        poena ← poena_textus ↦ f32
    }
    cape err {
        iace finge WireMala { causa = "malformed repetition penalty in generation wire" }
    }
    redde structa_generatio(contextus, magna_promptus, maxima_verborum, semen, temperatura, top_k, top_p, min_p, poena)
}

# -------------------------------------------------------------------------
# The generation cursor (PML5-U5 — context-limit wiring). The cursor is the
# generation loop's explicit state: the decode session position + the
# generated-token count. The LIMIT POLICY is explicit REJECT (the U1
# reject-policy precedent) — never silent truncation: cursor_progredere
# rejects with a typed Terminus when the next step would exceed either the
# context limit (sessio position >= contextus) or the maximum-generated-
# tokens limit (prolata >= maxima_verborum). With maxima_verborum <=
# contextus (the U4 validation) the max-tokens bound is the binding
# constraint in ordinary progression; the context rejection is the
# defensive fail-closed guard (probe-tested at the boundary state). The
# cursor reset (cursor_redintegra) returns the fresh session state (the
# U1 redintegra precedent) with the count cleared.
# -------------------------------------------------------------------------

@ publica
genus GenereCursor {
    decode.Sessio sessio
    numerus prolata

    # The decode session (the position counter).
    functio sessio() → decode.Sessio {
        redde ego.sessio
    }

    # The generated-token count.
    functio prolata() → numerus {
        redde ego.prolata
    }
}

# A fresh cursor at position 0 with count 0 over the config's context.
@ publica
functio cursor_fresh(GeneratioConfigura g) → GenereCursor ⇥ GeneratioError {
    varia decode.Sessio s
    fac {
        s ← decode.sessio_fresh(g.contextus())
        redde GenereCursor { sessio = s, prolata = 0 }
    }
    cape err {
        iace finge ConfiguraInvalida { causa = decode.causa(err) }
    }
    iace finge ConfiguraInvalida { causa = "unreachable" }
}

# The explicit limit-policy predicate: another token is allowed iff the
# session position is below the context limit AND the generated count is
# below the maximum-generated-tokens limit.
@ publica
functio verbum_licet(GeneratioConfigura g, GenereCursor c) → bivalens {
    si c.sessio().positio() ≥ g.contextus() ergo redde falsum
    si c.prolata() ≥ g.maxima_verborum() ergo redde falsum
    redde verum
}

# The next step — REJECTS (never truncates) when the step would exceed the
# max-tokens limit or the context limit; otherwise advances the session
# position by one and the count by one.
@ publica
functio cursor_progredere(GeneratioConfigura g, GenereCursor c) → GenereCursor ⇥ GeneratioError {
    si c.prolata() ≥ g.maxima_verborum() {
        iace finge Terminus { causa = "maximum generated tokens reached" }
    }
    si c.sessio().positio() ≥ g.contextus() {
        iace finge Terminus { causa = "context limit reached" }
    }
    redde GenereCursor {
        sessio = decode.Sessio { positio = c.sessio().positio() + 1, contextus = c.sessio().contextus() },
        prolata = c.prolata() + 1
    }
}

# Reset the cursor to the fresh state: session position 0 (the U1
# redintegra precedent, context preserved) with the count cleared.
functio cursor_redintegra(GenereCursor c) → GenereCursor {
    redde GenereCursor { sessio = decode.redintegra(c.sessio()), prolata = 0 }
}
