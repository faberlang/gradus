+++
locale = "en"
+++
# Generation-configuration contract — PML5-U4 (production inference
# computation layer; the single authority for generation configuration).
#
# Public import: import from "gradus:generation" generation
# Depends on: gradus:dtype (finite), gradus:sampling (Config — the U3
# sampling semantics the mapping is deterministic against), gradus:train
# (Seed — the U5 seed/RNG the seed mapping feeds).
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own those). This module holds no device handle and makes no performance
# claims.
#
# =========================================================================
# The generation-config contract (pml5-delivery.md PML5-U4)
# =========================================================================
#
# --- The single authority (council R7) -----------------------------------
# GenerationConfig is THE authority for generation configuration.
# NGAB5 and the future product repo ADAPT to this contract — they never
# define a second authority. The declared supported surface is the nine
# fields below (support_flags()); every llama.cpp-style control
# outside that surface is an EXPLICIT reject row (admitted_features →
# false; the reject-row matrix is probed) — never silently ignored. The
# versioned wire carries exactly the nine fields; an extra field breaks
# the parse (fail closed).
#
# --- Supported values, defaults, validation (the nine fields) ------------
#   context        — context length; ≥ 1. The decode/cache context the
#                      generated sequence must fit within.
#   max_prompt   — prompt batch size (the prefill batch); ≥ 1.
#   max_tokens  — maximum generated tokens; ≥ 1 and ≤ context
#                      (the generated sequence must fit the context).
#   seed            — the deterministic RNG seed; ≥ 1 (the Seed rule —
#                      xorshift64 degenerates at 0; the mapping never
#                      fails).
#   temperature      — temperature scaling; ≥ 0 (0 selects the greedy
#                      path — the U3 rule); default 1.0.
#   top_k            — top-k filter width; ≥ 0 (0 disables); default 0.
#   top_p            — top-p (nucleus) threshold; ∈ [0, 1] (≥ 1 disables);
#                      default 1.0.
#   min_p            — min-p threshold; ∈ [0, 1] (≤ 0 disables); default 0.
#   repetition_penalty — repetition penalty; ≥ 1 (1.0 = none); default 1.0.
# Every field is validated at construction (fail closed — the capsule
# rule); generation_failure gives the neutral sampling defaults.
#
# --- Deterministic mapping -----------------------------------------------
# The contract maps deterministically to what the generation loop
# consumes: config(g) → the U3 sampling Config (the five sampling
# fields project exactly — the same domains, so the mapping never fails)
# and seed(g) → the U5 Seed (the seed projects exactly). The mapping is
# a pure function — equal configs map to equal values.
#
# --- Evidence honesty (CTO Q2, hard) -------------------------------------
# This surface is the STRUCTURAL proof: the supported values, defaults,
# validation, the deterministic mapping, the reject rows, and the PML5-U5
# context-limit cursor wiring are compile-validated and proven by the
# co-located proba (exact field, mapping, and boundary pins). Executed
# VALUE identity is env-blocked tree-wide today (FMIR stepper /
# library-import gap — the PML4 closeout recorded both blockers; neither
# is fixed here). PML5-U4 is PARTIAL: value-identity is deferred to the
# auditor-owned runtime-evidence gate.
#
# =========================================================================
# PML5-U5 additions — the context-limit wiring (reject vs truncate policy)
# =========================================================================
#
# The explicit policy decision: REJECT, never truncate (the U1 reject
# precedent). The generation cursor (GenerationCursor) is the loop's explicit
# state — the decode session position + the generated-token count.
# cursor_advance rejects with a typed LimitReached when the next step
# would exceed the context limit (position >= context) or the
# maximum-generated-tokens limit (count >= max_tokens); the input
# limits are the U4 config's context/max_tokens. token_allowed is
# the explicit policy predicate. cursor_reset resets to the fresh
# session state (the U1 reset precedent) with the count cleared.
# No server or device handle enters this module.
#
# =========================================================================
# G2 — public generate route
# =========================================================================
#
# generate(config, prompt_ids, admitted decoder) is the canonical loop
# over the tiny Decoder: prefill → sample → decode_data feed-back
# until max_tokens or the first EOG token {0, 2}.
# generate_dense is the KV-wired loop over dense.decode_step (SmolLM2).
# The decoder/engine is an argument (M03: admitted model = generated
# model). Cancellation is observed at entry, during prefill, and before
# every sampled token. The cursor rejects rather than truncates.
# StopPolicy is additive: the existing generate / generate_cancelled /
# generate_dense signatures keep EOG-stop. The *_with_stop entry points
# accept Eog (emit first EOG then halt) or IgnoreEos (llama.cpp
# ignore_eos: EOG ids are suppressed from sampling and the loop runs to
# the max_tokens ceiling).
import from "gradus:attention" attention

import from "gradus:cache" kv

import from "gradus:decode" decode

import from "gradus:dtype" dtype

import from "gradus:model/dense" dense

import from "gradus:sampling" sampling

import from "gradus:tensor" tensor

import from "gradus:tokenizer" tokenizer

import from "gradus:train" train

# -------------------------------------------------------------------------
# GenerationError — typed error vocabulary of the generation-config
# contract. Every variant carries a text message (render via message).
# -------------------------------------------------------------------------

@ public { }
union GenerationError {
    InvalidConfig {
        string message
    },
    ElementMismatch {
        string message
    },
    DtypeMismatch {
        string message
    },
    Incompatible {
        string message
    },
    UnknownVersion {
        string message
    },
    BadWire {
        string message
    },
    LimitReached {
        string message
    },
    Cancelled {
        string message
    },
    DecodeFailure {
        string message
    }
}

@ public { }
fn message(GenerationError e) → string {
    match e {
        case InvalidConfig const message {
            return message
        }
        case ElementMismatch const message {
            return message
        }
        case DtypeMismatch const message {
            return message
        }
        case Incompatible const message {
            return message
        }
        case UnknownVersion const message {
            return message
        }
        case BadWire const message {
            return message
        }
        case LimitReached const message {
            return message
        }
        case Cancelled const message {
            return message
        }
        case DecodeFailure const message {
            return message
        }
    }
}

# The contract's schema version (the wire form).
const string schema_version ← "1.0.0"

# -------------------------------------------------------------------------
# GenerationConfig — the nine-field generation configuration.
# -------------------------------------------------------------------------


@ public { }
class GenerationConfig {
    int context
    int max_prompt
    int max_tokens
    int seed
    f32 temperature
    int top_k
    f32 top_p
    f32 min_p
    f32 repetition_penalty

    # Context length.
    fn context() → int {
        return self.context
    }

    # Prompt batch size (the prefill batch).
    fn max_prompt() → int {
        return self.max_prompt
    }

    # Maximum generated tokens.
    fn max_tokens() → int {
        return self.max_tokens
    }

    # The deterministic RNG seed.
    fn seed() → int {
        return self.seed
    }

    # Temperature scaling (0 = greedy).
    fn temperature() → f32 {
        return self.temperature
    }

    # Top-k filter width (0 = disabled).
    fn top_k() → int {
        return self.top_k
    }

    # Top-p nucleus threshold (≥ 1 = disabled).
    fn top_p() → f32 {
        return self.top_p
    }

    # Min-p threshold (≤ 0 = disabled).
    fn min_p() → f32 {
        return self.min_p
    }

    # Repetition penalty (1.0 = none).
    fn repetition_penalty() → f32 {
        return self.repetition_penalty
    }
}

# Field-wise config equality — the round-trip/determinism predicate.
@ public { }
fn generation_equal(GenerationConfig a, GenerationConfig b) → bool {
    if a.context() ≠ b.context() then return false
    if a.max_prompt() ≠ b.max_prompt() then return false
    if a.max_tokens() ≠ b.max_tokens() then return false
    if a.seed() ≠ b.seed() then return false
    if a.temperature() ≠ b.temperature() then return false
    if a.top_k() ≠ b.top_k() then return false
    if a.top_p() ≠ b.top_p() then return false
    if a.min_p() ≠ b.min_p() then return false
    if a.repetition_penalty() ≠ b.repetition_penalty() then return false
    return true
}

# -------------------------------------------------------------------------
# construct_generation — the validated constructor (the single authority's
# validation runs here AND on every deserialization — fail closed).
# -------------------------------------------------------------------------

@ public { }
fn construct_generation(int context, int max_prompt, int max_tokens, int seed, f32 temperature, int top_k, f32 top_p, f32 min_p, f32 repetition_penalty) → GenerationConfig ⇥ GenerationError {
    require context ≥ 1 throw variant InvalidConfig {message = "context length must be at least one"}
    require max_prompt ≥ 1 throw variant InvalidConfig {message = "prompt batch size must be at least one"}
    require max_tokens ≥ 1 throw variant InvalidConfig {message = "maximum generated tokens must be at least one"}
    require max_tokens ≤ context throw variant InvalidConfig {message = "maximum generated tokens must fit within the context"}
    require seed ≥ 1 throw variant InvalidConfig {message = "seed must be at least one"}
    require not (not dtype.finite(temperature) or temperature ≺ 0.0) throw variant InvalidConfig {message = "temperature must be non-negative"}
    require top_k ≥ 0 throw variant InvalidConfig {message = "top-k must be non-negative"}
    require not ((not dtype.finite(top_p) or top_p ≺ 0.0) or top_p ≻ 1.0) throw variant InvalidConfig {message = "top-p must be within [0, 1]"}
    require not ((not dtype.finite(min_p) or min_p ≺ 0.0) or min_p ≻ 1.0) throw variant InvalidConfig {message = "min-p must be within [0, 1]"}
    require not (not dtype.finite(repetition_penalty) or repetition_penalty ≺ 1.0) throw variant InvalidConfig {message = "repetition penalty must be at least one"}
    return GenerationConfig {context = context, max_prompt = max_prompt, max_tokens = max_tokens, seed = seed, temperature = temperature, top_k = top_k, top_p = top_p, min_p = min_p, repetition_penalty = repetition_penalty}
}

# Placeholder Default for `var GenerationConfig` bindings (var on structs).
# Zero fields (not a valid config). Only a placeholder the caller
# overwrites, or returns from an unreachable cape arm.
@ public { }
fn default() → GenerationConfig {
    return GenerationConfig {context = 0, max_prompt = 0, max_tokens = 0, seed = 0, temperature = 0.0, top_k = 0, top_p = 0.0, min_p = 0.0, repetition_penalty = 0.0}
}

# -------------------------------------------------------------------------
# generation_failure — the default generation config: the caller pins the
# context / prompt batch / max tokens / seed; the sampling knobs take the
# neutral defaults (temperature 1.0, top-k 0 = disabled, top-p 1.0 =
# disabled, min-p 0 = disabled, repetition penalty 1.0 = none).
# -------------------------------------------------------------------------

@ public { }
fn generation_failure(int context, int max_prompt, int max_tokens, int seed) → GenerationConfig ⇥ GenerationError {
    return construct_generation(context, max_prompt, max_tokens, seed, 1.0 ∷ f32, 0, 1.0 ∷ f32, 0.0 ∷ f32, 1.0 ∷ f32)
}

# -------------------------------------------------------------------------
# The declared supported surface + the admission predicate. NGAB5 and the
# product repo adapt to support_flags(); any control outside it is an
# explicit reject row (never silently ignored).
# -------------------------------------------------------------------------

@ public { }
fn support_flags() → list<string> {
    return ["context", "max_prompt", "max_tokens", "seed", "temperature", "top_k", "top_p", "min_p", "repetition_penalty"]
}

# Admission predicate: true iff the control name is a supported field.
@ public { }
fn admitted_features(string name) → bool {
    const list<string> support ← support_flags()
    for from support const s {
        if s ≡ name then return true
    }
    return false
}

# -------------------------------------------------------------------------
# The deterministic mapping — what the generation loop consumes.
# -------------------------------------------------------------------------

# The five sampling fields project exactly onto the U3 Config (the
# config validated the same domains — the mapping never fails).
@ public { }
fn config(GenerationConfig g) → sampling.Config ⇥ GenerationError {
    do {
        return sampling.construct_config(g.temperature(), g.top_k(), g.top_p(), g.min_p(), g.repetition_penalty())
    }
    catch err {
        const string c ← sampling.message(err)
        throw variant InvalidConfig {message = c}
    }
    throw variant InvalidConfig {message = "unreachable"}
}

# The seed projects exactly onto the U5 Seed (the config validated
# seed ≥ 1 — the mapping never fails).
@ public { }
fn seed(GenerationConfig g) → train.Seed ⇥ GenerationError {
    do {
        return train.construct_seed(g.seed())
    }
    catch err {
        const string c ← train.message(err)
        throw variant InvalidConfig {message = c}
    }
    throw variant InvalidConfig {message = "unreachable"}
}

# -------------------------------------------------------------------------
# The versioned wire — exactly the nine fields. An extra field breaks the
# parse (fail closed — unsupported controls are never silently ignored);
# every field is re-validated by construct_generation on deserialization.
# -------------------------------------------------------------------------

@ public { }
fn serialize_generation(GenerationConfig g) → string {
    return "generation/config/§/§/§/§/§/§/§/§/§/§"(schema_version, g.context() ↦ string, g.max_prompt() ↦ string, g.max_tokens() ↦ string, g.seed() ↦ string, g.temperature() ↦ string, g.top_k() ↦ string, g.top_p() ↦ string, g.min_p() ↦ string, g.repetition_penalty() ↦ string)
}

@ private { }
fn _digit(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    for range 0‥s.length() const i {
        if not _digit(s.get(i)) then return false
    }
    return true
}

@ public { }
fn deserialize_generation(string wire) → GenerationConfig ⇥ GenerationError {
    const list<string> parts ← wire.split("/")
    require parts.length() ≡ 12 throw variant BadWire {message = "malformed generation config wire"}
    require parts.get(0) coalesce "" ≡ "generation" throw variant BadWire {message = "unknown generation marker"}
    require parts.get(1) coalesce "" ≡ "config" throw variant BadWire {message = "unknown generation marker"}
    require parts.get(2) coalesce "" ≡ schema_version throw variant UnknownVersion {message = "unknown generation schema version"}
    const string context_text ← parts.get(3) coalesce ""
    const string max_prompt_text ← parts.get(4) coalesce ""
    const string max_tokens_text ← parts.get(5) coalesce ""
    const string seed_text ← parts.get(6) coalesce ""
    const string temperature_text ← parts.get(7) coalesce ""
    const string top_k_text ← parts.get(8) coalesce ""
    const string top_p_text ← parts.get(9) coalesce ""
    const string min_p_text ← parts.get(10) coalesce ""
    const string penalty_text ← parts.get(11) coalesce ""
    var int context ← 0
    var int max_prompt ← 0
    var int max_tokens ← 0
    var int seed ← 0
    var f32 temperature ← 0.0 ∷ f32
    var int top_k ← 0
    var f32 top_p ← 0.0 ∷ f32
    var f32 min_p ← 0.0 ∷ f32
    var f32 penalty ← 0.0 ∷ f32
    require _numeric(context_text) throw variant BadWire {message = "malformed context length in generation wire"}
    do {
        context ← context_text ↦ int
    }
    catch err {
        throw variant BadWire {message = "malformed context length in generation wire"}
    }
    require _numeric(max_prompt_text) throw variant BadWire {message = "malformed prompt batch in generation wire"}
    do {
        max_prompt ← max_prompt_text ↦ int
    }
    catch err {
        throw variant BadWire {message = "malformed prompt batch in generation wire"}
    }
    require _numeric(max_tokens_text) throw variant BadWire {message = "malformed max tokens in generation wire"}
    do {
        max_tokens ← max_tokens_text ↦ int
    }
    catch err {
        throw variant BadWire {message = "malformed max tokens in generation wire"}
    }
    require _numeric(seed_text) throw variant BadWire {message = "malformed seed in generation wire"}
    do {
        seed ← seed_text ↦ int
    }
    catch err {
        throw variant BadWire {message = "malformed seed in generation wire"}
    }
    do {
        temperature ← temperature_text ↦ f32
    }
    catch err {
        throw variant BadWire {message = "malformed temperature in generation wire"}
    }
    require _numeric(top_k_text) throw variant BadWire {message = "malformed top-k in generation wire"}
    do {
        top_k ← top_k_text ↦ int
    }
    catch err {
        throw variant BadWire {message = "malformed top-k in generation wire"}
    }
    do {
        top_p ← top_p_text ↦ f32
    }
    catch err {
        throw variant BadWire {message = "malformed top-p in generation wire"}
    }
    do {
        min_p ← min_p_text ↦ f32
    }
    catch err {
        throw variant BadWire {message = "malformed min-p in generation wire"}
    }
    do {
        penalty ← penalty_text ↦ f32
    }
    catch err {
        throw variant BadWire {message = "malformed repetition penalty in generation wire"}
    }
    return construct_generation(context, max_prompt, max_tokens, seed, temperature, top_k, top_p, min_p, penalty)
}

# -------------------------------------------------------------------------
# The generation cursor (PML5-U5 — context-limit wiring). The cursor is the
# generation loop's explicit state: the decode session position + the
# generated-token count. The LIMIT POLICY is explicit REJECT (the U1
# reject-policy precedent) — never silent truncation: cursor_advance
# rejects with a typed LimitReached when the next step would exceed either the
# context limit (session position >= context) or the maximum-generated-
# tokens limit (emitted >= max_tokens). With max_tokens <=
# context (the U4 validation) the max-tokens bound is the binding
# constraint in ordinary progression; the context rejection is the
# defensive fail-closed guard (probe-tested at the boundary state). The
# cursor reset (cursor_reset) returns the fresh session state (the
# U1 reset precedent) with the count cleared.
# -------------------------------------------------------------------------


@ public { }
class GenerationCursor {
    decode.Session session
    int emitted

    # The decode session (the position counter).
    fn session() → decode.Session {
        return self.session
    }

    # The generated-token count.
    fn emitted() → int {
        return self.emitted
    }
}

# A fresh cursor at position 0 with count 0 over the config's context.
@ public { }
fn fresh_cursor(GenerationConfig g) → GenerationCursor ⇥ GenerationError {
    var decode.Session s ← decode.default_session()
    do {
        s ← decode.fresh_session(g.context())
        return GenerationCursor {session = s, emitted = 0}
    }
    catch err {
        throw variant InvalidConfig {message = decode.message(err)}
    }
    throw variant InvalidConfig {message = "unreachable"}
}

# Placeholder Default for `var GenerationCursor` bindings (var on structs).
# Empty session (not a valid cursor). Only a placeholder the caller
# overwrites, or returns from an unreachable cape arm.
@ public { }
fn default_cursor() → GenerationCursor {
    return GenerationCursor {session = decode.default_session(), emitted = 0}
}

# The explicit limit-policy predicate: another token is allowed iff the
# session position is below the context limit AND the generated count is
# below the maximum-generated-tokens limit.
@ public { }
fn token_allowed(GenerationConfig g, GenerationCursor c) → bool {
    if c.session().position() ≥ g.context() then return false
    if c.emitted() ≥ g.max_tokens() then return false
    return true
}

# The next step — REJECTS (never truncates) when the step would exceed the
# max-tokens limit or the context limit; otherwise advances the session
# position by one and the count by one.
@ public { }
fn cursor_advance(GenerationConfig g, GenerationCursor c) → GenerationCursor ⇥ GenerationError {
    require c.emitted() ≺ g.max_tokens() throw variant LimitReached {message = "maximum generated tokens reached"}
    require c.session().position() ≺ g.context() throw variant LimitReached {message = "context limit reached"}
    return GenerationCursor {session = decode.Session {position = c.session().position() + 1, context = c.session().context()}, emitted = c.emitted() + 1}
}

# Reset the cursor to the fresh state: session position 0 (the U1
# reset precedent, context preserved) with the count cleared.
@ public { }
fn cursor_reset(GenerationCursor c) → GenerationCursor {
    return GenerationCursor {session = decode.Session {position = 0, context = c.session().context()}, emitted = 0}
}

# -------------------------------------------------------------------------
# StopPolicy — the generate-route stop binding. Additive: existing
# generate / generate_cancelled / generate_dense keep Eog. IgnoreEos is
# the llama.cpp ignore_eos row (U5 golden capture): admitted EOG ids
# {0, 2} are suppressed from the sampled logits (finite large-negative
# mask, never -inf — the sampling finite gate) and the loop does not
# halt on EOG, so generation proceeds to the max_tokens ceiling.
# Cross-module callers use the factories; they cannot invent imported
# variants (the RopePolicy precedent).
# -------------------------------------------------------------------------

@ public { }
union StopPolicy {
    Eog,
    IgnoreEos
}

@ public { }
fn eog_stop() → StopPolicy {
    return variant Eog
}

@ public { }
fn ignore_eos() → StopPolicy {
    return variant IgnoreEos
}

@ public { }
fn stop_policy_name(StopPolicy p) → string {
    match p {
        case Eog {
            return "eog"
        }
        case IgnoreEos {
            return "ignore_eos"
        }
    }
}

@ public { }
fn stops_on_eog(StopPolicy p) → bool {
    match p {
        case Eog {
            return true
        }
        case IgnoreEos {
            return false
        }
    }
}

# Finite EOG mask. Sampling rejects non-finite logits, so this is a
# large negative rather than -inf. Any real vocab logit wins over it.
@ private { }
fn _suppress_eog(list<f32> logits) → list<f32> {
    var list<f32> out ← empty
    for range 0‥logits.length() const i {
        if tokenizer.is_eog(i) {
            out.append((0.0 - 1000000000.0) ∷ f32)
        }
        else {
            out.append(logits.get(i) coalesce 0.0 ∷ f32)
        }
    }
    return out
}

@ private { }
fn _sample_logits(list<f32> logits, StopPolicy stop) → list<f32> {
    if stops_on_eog(stop) {
        return logits
    }
    return _suppress_eog(logits)
}

# Cursor sitting just after a prompt of length prompt_len: next decode
# position is the prompt length, generated count is 0. Rejects an empty
# prompt and a prompt that leaves no room in the context.
@ public { }
fn cursor_after_prompt(GenerationConfig g, int prompt_len) → GenerationCursor ⇥ GenerationError {
    require prompt_len ≥ 1 throw variant InvalidConfig {message = "needs at least one prompt token"}
    require prompt_len ≺ g.context() throw variant InvalidConfig {message = "prompt length does not fit context"}
    return GenerationCursor {session = decode.Session {position = prompt_len, context = g.context()}, emitted = 0}
}

# -------------------------------------------------------------------------
# generate — the public generation loop.
# -------------------------------------------------------------------------

@ private { }
fn _observe(decode.Cancellation cancel) → void ⇥ GenerationError {
    do {
        const decode.Cancellation _ ← decode.observe_cancellation(cancel)
        return
    }
    catch err {
        throw variant Cancelled {message = decode.message(err)}
    }
}

@ private { }
fn _sample(list<f32> logits, sampling.Config c, list<int> history, train.Seed seed) → sampling.Sampler ⇥ GenerationError {
    do {
        return sampling.sample(logits, c, history, seed)
    }
    catch err {
        throw variant DecodeFailure {message = sampling.message(err)}
    }
}

@ private { }
fn _prefill(list<int> prompt_ids, decode.Decoder m) → tensor.Tensor ⇥ GenerationError {
    do {
        return decode.prefill(prompt_ids, m)
    }
    catch err {
        throw variant DecodeFailure {message = decode.message(err)}
    }
}

@ private { }
fn _decode_one(int token_id, int position, decode.Decoder m) → tensor.Tensor ⇥ GenerationError {
    do {
        return decode.decode_data(token_id, position, m)
    }
    catch err {
        throw variant DecodeFailure {message = decode.message(err)}
    }
}

@ private { }
fn _last_logits(tensor.Tensor logits, int vocab) → list<f32> ⇥ GenerationError {
    const list<int> shape ← logits.shape()
    if shape.length() ≡ 1 {
        return logits.data
    }
    require shape.length() ≡ 2 throw variant DecodeFailure {message = "decode logits must be rank-1 or rank-2"}
    const int rows ← shape.get(0) coalesce 0
    const int cols ← shape.get(1) coalesce 0
    require not (rows ≺ 1 or cols ≠ vocab) throw variant DecodeFailure {message = "decode logits shape does not match the vocabulary"}
    var list<f32> row ← empty
    for range 0‥vocab const i {
        do {
            row.append(logits.get([rows - 1, i]))
        }
        catch err {
            throw variant DecodeFailure {message = tensor.message(err)}
        }
    }
    return row
}

@ private { }
fn _dense_one(DenseEngine engine, (string, int) → tensor.Tensor ⇥ dense.DenseError source, int token_id, int position, list<kv.KVCache> layers) → dense.DenseStep ⇥ GenerationError {
    do {
        return dense.decode_step(engine.architecture, source, token_id, position, engine.epsilon, engine.scale, engine.rope_dim, engine.rope, layers)
    }
    catch err {
        throw variant DecodeFailure {message = dense.message(err)}
    }
}

@ private { }
fn _dense_prefill(DenseEngine engine, (string, int) → tensor.Tensor ⇥ dense.DenseError source, list<int> prompt_ids, list<kv.KVCache> layers) → dense.DenseStep ⇥ GenerationError {
    do {
        return dense.prefill_cached(engine.architecture, source, prompt_ids, engine.epsilon, engine.scale, engine.rope_dim, engine.rope, layers)
    }
    catch err {
        throw variant DecodeFailure {message = dense.message(err)}
    }
}

# Public generate: config + prompt ids + the admitted decoder.
# Prefill produces the last-row logits; each later step is
# decode_data + sampling.sample. Default stop is Eog: halt after the
# first EOG token (tokenizer.is_eog — set {0, 2}) or at the cursor
# ceiling. generate_with_stop / generate_cancelled_with_stop take an
# explicit StopPolicy. The KV-wired loop is generate_dense.
@ public { }
fn generate(GenerationConfig g, list<int> prompt_ids, decode.Decoder m) → list<int> ⇥ GenerationError {
    return generate_cancelled(g, prompt_ids, m, decode.fresh_cancellation())
}

@ public { }
fn generate_with_stop(GenerationConfig g, list<int> prompt_ids, decode.Decoder m, StopPolicy stop) → list<int> ⇥ GenerationError {
    return generate_cancelled_with_stop(g, prompt_ids, m, decode.fresh_cancellation(), stop)
}

@ public { }
fn generate_cancelled(GenerationConfig g, list<int> prompt_ids, decode.Decoder m, decode.Cancellation cancel) → list<int> ⇥ GenerationError {
    return generate_cancelled_with_stop(g, prompt_ids, m, cancel, eog_stop())
}

@ public { }
fn generate_cancelled_with_stop(GenerationConfig g, list<int> prompt_ids, decode.Decoder m, decode.Cancellation cancel, StopPolicy stop) → list<int> ⇥ GenerationError {
    _observe(cancel)
    require prompt_ids.length() ≥ 1 throw variant InvalidConfig {message = "needs at least one prompt token"}
    require prompt_ids.length() ≺ g.context() throw variant InvalidConfig {message = "prompt length does not fit context"}
    require prompt_ids.length() ≤ m.context() throw variant InvalidConfig {message = "prompt length does not fit context"}
    const sampling.Config drawn ← config(g)
    var train.Seed rng ← seed(g)
    const tensor.Tensor pref ← _prefill(prompt_ids, m)
    var list<f32> last ← _last_logits(pref, m.vocabulary())
    var GenerationCursor cursor ← cursor_after_prompt(g, prompt_ids.length())
    var list<int> tokens ← empty
    var list<int> history ← empty
    var bool finished ← false
    while token_allowed(g, cursor) and not finished {
        _observe(cancel)
        const sampling.Sampler outcome ← _sample(_sample_logits(last, stop), drawn, history, rng)
        const int token ← outcome.token_id()
        tokens.append(token)
        history.append(token)
        rng ← outcome.seed()
        cursor ← cursor_advance(g, cursor)
        if tokenizer.is_eog(token) and stops_on_eog(stop) {
            finished ← true
        }
        else {
            if token_allowed(g, cursor) {
                const tensor.Tensor step ← _decode_one(token, cursor.session().position() - 1, m)
                last ← _last_logits(step, m.vocabulary())
            }
            else {
                finished ← true
            }
        }
    }
    return tokens
}

# Dense-engine carrier for generate_dense (the SmolLM2 / G1 path).
@ public { }
class DenseEngine {
    dense.DenseConfig architecture
    f32 epsilon
    f32 scale
    int rope_dim
    attention.RopeConfig rope
}

@ public { }
fn construct_dense_engine(dense.DenseConfig architecture, f32 epsilon, f32 scale, int rope_dim, attention.RopeConfig rope) → DenseEngine {
    return DenseEngine {architecture = architecture, epsilon = epsilon, scale = scale, rope_dim = rope_dim, rope = rope}
}

@ public { }
fn default_dense_engine() → DenseEngine {
    return DenseEngine {architecture = dense.DenseConfig {layers = 0, heads = 0, kv_heads = 0, head_dim = 0, hidden_dim = 0, vocab = 0, tied = false}, epsilon = 0.0, scale = 0.0, rope_dim = 0, rope = attention.default()}
}

# Same loop as generate, over dense.decode_step and a per-layer KV cache.
# Used by the SmolLM2 oracle example. Default EOG-stop applies: SmolLM2
# EOS=2 is in the admitted set {0, 2}, so a greedy continuation that
# would have been G1's unrestrained [30, 2, 198] becomes [30, 2].
# generate_dense_with_stop(IgnoreEos) suppresses EOG from sampling and
# runs to max_tokens — the U5 / llama.cpp ignore_eos row.
@ public { }
fn generate_dense(GenerationConfig g, list<int> prompt_ids, DenseEngine engine, (string, int) → tensor.Tensor ⇥ dense.DenseError source, list<kv.KVCache> layers, decode.Cancellation cancel) → list<int> ⇥ GenerationError {
    return generate_dense_with_stop(g, prompt_ids, engine, source, layers, cancel, eog_stop())
}

@ public { }
fn generate_dense_with_stop(GenerationConfig g, list<int> prompt_ids, DenseEngine engine, (string, int) → tensor.Tensor ⇥ dense.DenseError source, list<kv.KVCache> layers, decode.Cancellation cancel, StopPolicy stop) → list<int> ⇥ GenerationError {
    _observe(cancel)
    require prompt_ids.length() ≥ 1 throw variant InvalidConfig {message = "needs at least one prompt token"}
    require prompt_ids.length() ≺ g.context() throw variant InvalidConfig {message = "prompt length does not fit context"}
    const sampling.Config drawn ← config(g)
    var train.Seed rng ← seed(g)
    _observe(cancel)
    const dense.DenseStep pref ← _dense_prefill(engine, source, prompt_ids, layers)
    var list<kv.KVCache> state ← pref.layers()
    var list<f32> last ← _last_logits(pref.logits(), engine.architecture.vocab)
    var GenerationCursor cursor ← cursor_after_prompt(g, prompt_ids.length())
    var list<int> tokens ← empty
    var list<int> history ← empty
    var bool finished ← false
    while token_allowed(g, cursor) and not finished {
        _observe(cancel)
        const sampling.Sampler outcome ← _sample(_sample_logits(last, stop), drawn, history, rng)
        const int token ← outcome.token_id()
        tokens.append(token)
        history.append(token)
        rng ← outcome.seed()
        cursor ← cursor_advance(g, cursor)
        if tokenizer.is_eog(token) and stops_on_eog(stop) {
            finished ← true
        }
        else {
            if token_allowed(g, cursor) {
                const dense.DenseStep step ← _dense_one(engine, source, token, cursor.session().position() - 1, state)
                last ← _last_logits(step.logits(), engine.architecture.vocab)
                state ← step.layers()
            }
            else {
                finished ← true
            }
        }
    }
    return tokens
}
