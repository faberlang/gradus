+++ toml
locale = "en"

+++ faber
# Record-contract tests for the decode_token layer API (gradus #47).
# Class construction and cross-module imports bind at module scope only, so
# each proof runs as a module-scope check function and the co-located test
# cases below call it through the test scope's synthesized own-module
# binding. Runs through KIR on the CPU device route.

import from "gradus:decode_token" let { layer_wide, layer_step, prime_workspace }
import from "gradus:decode_token_test_support" let { close, weight, build_lw, build_sv, build_ws, build_lp, run_prope }

@ public
fn check_layer_step_identity() → bool {
    let tensor<f32, [2, 4]> hcdom ← tf32[2, 4] {}
    mut tensor<f32, [4]> hin ← tf32[4] {}
    mut tensor<f32, [4]> hout ← tf32[4] {}
    let tensor<f32, [4]> an ← tf32[4] {}
    let tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    let tensor<f32, [4, 4]> wk ← tf32[4, 4] {}
    let tensor<f32, [4, 4]> wv ← tf32[4, 4] {}
    let tensor<f32, [4, 4]> wo ← tf32[4, 4] {}
    let tensor<f32, [4]> fn2 ← tf32[4] {}
    let tensor<f32, [6, 4]> wg ← tf32[6, 4] {}
    let tensor<f32, [6, 4]> wu ← tf32[6, 4] {}
    let tensor<f32, [4, 6]> wd ← tf32[4, 6] {}
    let tensor<f32, [4]> bq0 ← tf32[4] {}
    let tensor<f32, [4]> bk0 ← tf32[4] {}
    let tensor<f32, [4]> bv0 ← tf32[4] {}
    for exclusive 4 let j {
        hin[[j]] ← (j ↦ f32) + 1.0
        an[[j]] ← 1.0
        fn2[[j]] ← 1.0
    }
    mut tensor<f32, [4, 4]> kin ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> vin ← tf32[4, 4] {}
    kin[[1, 0]] ← 7.0
    kin[[1, 1]] ← 8.0
    vin[[1, 0]] ← 9.0
    vin[[1, 1]] ← 10.0
    let _ lw ← build_lw(an, wq, wk, wv, wo, fn2, wg, wu, wd, 0, bq0, bk0, bv0)
    mut _ sv ← build_sv(mut kin, mut vin, 0)
    let _ lp ← build_lp(2, 2, 1, 2, 0.00001, 11.512925, 0.5)
    layer_step(hcdom, hin, mut hout, lw, mut sv, lp)
    assert close(hout[[0]], 1.0)
    assert close(hout[[1]], 2.0)
    assert close(hout[[3]], 4.0)
    assert kin[[0, 0]] ≡ (0.0 ↦ f32)
    assert kin[[1, 0]] ≡ (7.0 ↦ f32)
    assert kin[[1, 1]] ≡ (8.0 ↦ f32)
    assert vin[[1, 0]] ≡ (9.0 ↦ f32)
    assert vin[[1, 1]] ≡ (10.0 ↦ f32)
    return true
}

@ public
fn check_layer_wide_identity() → bool {
    let tensor<f32, [2, 4]> hcdom ← tf32[2, 4] {}
    let tensor<f32, [2, 4]> cpdom ← tf32[2, 4] {}
    let tensor<f32, [4]> qdom ← tf32[4] {}
    mut tensor<f32, [4]> xn ← tf32[4] {}
    mut tensor<f32, [4]> q ← tf32[4] {}
    mut tensor<f32, [4]> qr ← tf32[4] {}
    mut tensor<f32, [4]> k ← tf32[4] {}
    mut tensor<f32, [4]> kr ← tf32[4] {}
    mut tensor<f32, [4]> v ← tf32[4] {}
    mut tensor<f32, [2, 4]> sc ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> pr ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> cp ← tf32[2, 4] {}
    mut tensor<f32, [4]> ctx ← tf32[4] {}
    mut tensor<f32, [4]> h1 ← tf32[4] {}
    mut tensor<f32, [6]> gate ← tf32[6] {}
    mut tensor<f32, [6]> up ← tf32[6] {}
    mut tensor<f32, [6]> act ← tf32[6] {}
    mut _ ws ← build_ws(hcdom, cpdom, qdom, mut xn, mut q, mut qr, mut k, mut kr, mut v, mut sc, mut pr, mut cp, mut ctx, mut h1, mut gate, mut up, mut act)

    mut tensor<f32, [1]> sink ← tf32[1] {}
    mut tensor<f32, [4]> hin ← tf32[4] {}
    mut tensor<f32, [4]> hout ← tf32[4] {}
    let tensor<f32, [4]> an ← tf32[4] {}
    let tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    let tensor<f32, [4, 4]> wk ← tf32[4, 4] {}
    let tensor<f32, [4, 4]> wv ← tf32[4, 4] {}
    let tensor<f32, [4, 4]> wo ← tf32[4, 4] {}
    let tensor<f32, [4]> fn2 ← tf32[4] {}
    let tensor<f32, [6, 4]> wg ← tf32[6, 4] {}
    let tensor<f32, [6, 4]> wu ← tf32[6, 4] {}
    let tensor<f32, [4, 6]> wd ← tf32[4, 6] {}
    let tensor<f32, [4]> bq0 ← tf32[4] {}
    let tensor<f32, [4]> bk0 ← tf32[4] {}
    let tensor<f32, [4]> bv0 ← tf32[4] {}
    for exclusive 4 let j {
        hin[[j]] ← (j ↦ f32) + 1.0
        an[[j]] ← 1.0
        fn2[[j]] ← 1.0
    }
    let _ lw ← build_lw(an, wq, wk, wv, wo, fn2, wg, wu, wd, 0, bq0, bk0, bv0)
    mut tensor<f32, [4, 4]> kin ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> vin ← tf32[4, 4] {}
    kin[[1, 0]] ← 7.0
    kin[[1, 1]] ← 8.0
    vin[[1, 0]] ← 9.0
    vin[[1, 1]] ← 10.0
    mut _ sv ← build_sv(mut kin, mut vin, 0)
    let _ lp ← build_lp(2, 2, 1, 2, 0.00001, 11.512925, 0.5)

    prime_workspace(mut ws, mut sink)
    layer_wide(hin, mut hout, lw, mut sv, lp, mut ws)
    assert close(hout[[0]], 1.0)
    assert close(hout[[1]], 2.0)
    assert close(hout[[3]], 4.0)
    assert kin[[0, 0]] ≡ (0.0 ↦ f32)
    assert kin[[1, 0]] ≡ (7.0 ↦ f32)
    assert vin[[1, 0]] ≡ (9.0 ↦ f32)
    # A second token through the same workspace stays the identity.
    sv.pos ← 1
    layer_wide(hin, mut hout, lw, mut sv, lp, mut ws)
    assert close(hout[[0]], 1.0)
    assert close(hout[[3]], 4.0)
    assert kin[[1, 0]] ≡ (0.0 ↦ f32)
    return true
}
@ public
fn check_qkv_bias_moves_output() → bool {
    let tensor<f32, [4]> an ← tf32[4] {}
    let tensor<f32, [4]> fn2 ← tf32[4] {}
    for exclusive 4 let j {
        an[[j]] ← 1.0
        fn2[[j]] ← 1.0
    }
    mut tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wk ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wv ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wo ← tf32[4, 4] {}
    mut tensor<f32, [6, 4]> wg ← tf32[6, 4] {}
    mut tensor<f32, [6, 4]> wu ← tf32[6, 4] {}
    mut tensor<f32, [4, 6]> wd ← tf32[4, 6] {}
    for exclusive 4 let r {
        for exclusive 4 let c {
            wq[[r, c]] ← weight(r, c, 1)
            wk[[r, c]] ← weight(r, c, 2)
            wv[[r, c]] ← weight(r, c, 3)
            wo[[r, c]] ← weight(r, c, 4)
        }
    }
    for exclusive 6 let r {
        for exclusive 4 let c {
            wg[[r, c]] ← weight(r, c, 5)
            wu[[r, c]] ← weight(r, c, 6)
        }
    }
    for exclusive 4 let r {
        for exclusive 6 let c {
            wd[[r, c]] ← weight(r, c, 7)
        }
    }
    let tensor<f32, [4]> bq0 ← tf32[4] {}
    let tensor<f32, [4]> bk0 ← tf32[4] {}
    let tensor<f32, [4]> bv0 ← tf32[4] {}
    mut tensor<f32, [4]> bq1 ← tf32[4] {}
    mut tensor<f32, [4]> bk1 ← tf32[4] {}
    for exclusive 4 let j {
        bq1[[j]] ← 1.0
        bk1[[j]] ← 1.0
    }
    let tensor<f32, [4]> bv1 ← tf32[4] {}
    let _ lw0 ← build_lw(an, wq, wk, wv, wo, fn2, wg, wu, wd, 0, bq0, bk0, bv0)
    let _ lw1 ← build_lw(an, wq, wk, wv, wo, fn2, wg, wu, wd, 1, bq1, bk1, bv0)
    let _ lp ← build_lp(2, 2, 1, 2, 0.00001, 11.512925, 0.5)
    mut tensor<f32, [1]> sink ← tf32[1] {}
    mut tensor<f32, [4]> hin ← tf32[4] {}
    for exclusive 4 let j {
        hin[[j]] ← (j ↦ f32) + 1.0
    }

    # Run 1: unbiased weights on a fresh workspace, slot, and output.
    let tensor<f32, [2, 4]> hcdom0 ← tf32[2, 4] {}
    let tensor<f32, [2, 4]> cpdom0 ← tf32[2, 4] {}
    let tensor<f32, [4]> qdom0 ← tf32[4] {}
    mut tensor<f32, [4]> xn0 ← tf32[4] {}
    mut tensor<f32, [4]> q0 ← tf32[4] {}
    mut tensor<f32, [4]> qr0 ← tf32[4] {}
    mut tensor<f32, [4]> k0 ← tf32[4] {}
    mut tensor<f32, [4]> kr0 ← tf32[4] {}
    mut tensor<f32, [4]> v0 ← tf32[4] {}
    mut tensor<f32, [2, 4]> sc0 ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> pr0 ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> cp0 ← tf32[2, 4] {}
    mut tensor<f32, [4]> ctx0 ← tf32[4] {}
    mut tensor<f32, [4]> h10 ← tf32[4] {}
    mut tensor<f32, [6]> gate0 ← tf32[6] {}
    mut tensor<f32, [6]> up0 ← tf32[6] {}
    mut tensor<f32, [6]> act0 ← tf32[6] {}
    mut _ ws0 ← build_ws(hcdom0, cpdom0, qdom0, mut xn0, mut q0, mut qr0, mut k0, mut kr0, mut v0, mut sc0, mut pr0, mut cp0, mut ctx0, mut h10, mut gate0, mut up0, mut act0)
    mut tensor<f32, [4, 4]> kin0 ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> vin0 ← tf32[4, 4] {}
    for exclusive 2 let r {
        for exclusive 4 let c {
            kin0[[r, c]] ← ((r + 1) * (c + 1) ↦ f32) * 0.1
            vin0[[r, c]] ← ((r * 2 + c + 1) ↦ f32) * 0.05
        }
    }
    mut _ sv0 ← build_sv(mut kin0, mut vin0, 1)
    mut tensor<f32, [4]> out0 ← tf32[4] {}
    prime_workspace(mut ws0, mut sink)
    layer_wide(hin, mut out0, lw0, mut sv0, lp, mut ws0)

    # Run 2: the same layer with the unit QKV bias, all-fresh state.
    let tensor<f32, [2, 4]> hcdom1 ← tf32[2, 4] {}
    let tensor<f32, [2, 4]> cpdom1 ← tf32[2, 4] {}
    let tensor<f32, [4]> qdom1 ← tf32[4] {}
    mut tensor<f32, [4]> xn1 ← tf32[4] {}
    mut tensor<f32, [4]> q1 ← tf32[4] {}
    mut tensor<f32, [4]> qr1 ← tf32[4] {}
    mut tensor<f32, [4]> k1 ← tf32[4] {}
    mut tensor<f32, [4]> kr1 ← tf32[4] {}
    mut tensor<f32, [4]> v1 ← tf32[4] {}
    mut tensor<f32, [2, 4]> sc1 ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> pr1 ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> cp1 ← tf32[2, 4] {}
    mut tensor<f32, [4]> ctx1 ← tf32[4] {}
    mut tensor<f32, [4]> h11 ← tf32[4] {}
    mut tensor<f32, [6]> gate1 ← tf32[6] {}
    mut tensor<f32, [6]> up1 ← tf32[6] {}
    mut tensor<f32, [6]> act1 ← tf32[6] {}
    mut _ ws1 ← build_ws(hcdom1, cpdom1, qdom1, mut xn1, mut q1, mut qr1, mut k1, mut kr1, mut v1, mut sc1, mut pr1, mut cp1, mut ctx1, mut h11, mut gate1, mut up1, mut act1)
    mut tensor<f32, [4, 4]> kin1 ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> vin1 ← tf32[4, 4] {}
    for exclusive 2 let r {
        for exclusive 4 let c {
            kin1[[r, c]] ← ((r + 1) * (c + 1) ↦ f32) * 0.1
            vin1[[r, c]] ← ((r * 2 + c + 1) ↦ f32) * 0.05
        }
    }
    mut _ sv1 ← build_sv(mut kin1, mut vin1, 1)
    mut tensor<f32, [4]> out1 ← tf32[4] {}
    prime_workspace(mut ws1, mut sink)
    layer_wide(hin, mut out1, lw1, mut sv1, lp, mut ws1)

    # The unit bias shifts every query and key, so the mixed-weight layer
    # output must move somewhere in the residual stream.
    mut f32 dmax ← 0.0
    for exclusive 4 let j {
        let f32 d ← (out0[[j]] - out1[[j]]).abs()
        if d ≻ dmax {
            dmax ← d
        }
    }
    assert dmax ≻ 0.001
    return true
}

@ public
fn check_prope_modes_differ() → bool {
    let tensor<f32, [4]> an ← tf32[4] {}
    let tensor<f32, [4]> fn2 ← tf32[4] {}
    for exclusive 4 let j {
        an[[j]] ← 1.0
        fn2[[j]] ← 1.0
    }
    mut tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wk ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wv ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wo ← tf32[4, 4] {}
    mut tensor<f32, [6, 4]> wg ← tf32[6, 4] {}
    mut tensor<f32, [6, 4]> wu ← tf32[6, 4] {}
    mut tensor<f32, [4, 6]> wd ← tf32[4, 6] {}
    for exclusive 4 let r {
        for exclusive 4 let c {
            wq[[r, c]] ← weight(r, c, 1)
            wk[[r, c]] ← weight(r, c, 2)
            wv[[r, c]] ← weight(r, c, 3)
            wo[[r, c]] ← weight(r, c, 4)
        }
    }
    for exclusive 6 let r {
        for exclusive 4 let c {
            wg[[r, c]] ← weight(r, c, 5)
            wu[[r, c]] ← weight(r, c, 6)
        }
    }
    for exclusive 4 let r {
        for exclusive 6 let c {
            wd[[r, c]] ← weight(r, c, 7)
        }
    }
    let tensor<f32, [4]> bq0 ← tf32[4] {}
    let tensor<f32, [4]> bk0 ← tf32[4] {}
    let tensor<f32, [4]> bv0 ← tf32[4] {}
    let _ lw ← build_lw(an, wq, wk, wv, wo, fn2, wg, wu, wd, 0, bq0, bk0, bv0)
    let _ lpnone ← build_lp(2, 2, 1, 0, 0.00001, 11.512925, 2.0)
    let _ lphalf ← build_lp(2, 2, 1, 1, 0.00001, 11.512925, 2.0)
    let _ lppairs ← build_lp(2, 2, 1, 2, 0.00001, 11.512925, 2.0)
    mut tensor<f32, [1]> sink ← tf32[1] {}
    mut tensor<f32, [4]> hin ← tf32[4] {}
    for exclusive 4 let j {
        hin[[j]] ← (j ↦ f32) + 1.0
    }

    # One fully fresh workspace, slot, and output per run: none, half, pairs,
    # then half again for the determinism proof.
    mut tensor<f32, [4]> outnone ← tf32[4] {}
    mut tensor<f32, [4]> outhalf ← tf32[4] {}
    mut tensor<f32, [4]> outpairs ← tf32[4] {}
    mut tensor<f32, [4]> outhalf2 ← tf32[4] {}
    run_prope(lw, lpnone, hin, mut sink, mut outnone)
    run_prope(lw, lphalf, hin, mut sink, mut outhalf)
    run_prope(lw, lppairs, hin, mut sink, mut outpairs)
    run_prope(lw, lphalf, hin, mut sink, mut outhalf2)

    # Rotation at pos 1 changes the attention result; the bypass differs from
    # both conventions and the two conventions differ from each other. The
    # differences are small at these weight scales, so take the largest move
    # over the residual stream.
    mut f32 dnone ← 0.0
    mut f32 dpairs ← 0.0
    mut f32 dreplay ← 0.0
    for exclusive 4 let j {
        let f32 d1 ← (outnone[[j]] - outhalf[[j]]).abs()
        let f32 d2 ← (outhalf[[j]] - outpairs[[j]]).abs()
        let f32 d3 ← (outhalf[[j]] - outhalf2[[j]]).abs()
        if d1 ≻ dnone {
            dnone ← d1
        }
        if d2 ≻ dpairs {
            dpairs ← d2
        }
        if d3 ≻ dreplay {
            dreplay ← d3
        }
    }
    assert dnone ≻ 0.0001
    assert dpairs ≻ 0.0001
    assert dreplay ≺ 0.0000001
    return true
}

+++ faber test
# Thin cases: the proofs live in the module-scope check functions above.

test "decode_token layer_step with zero weights is the identity on the residual stream" {
    assert check_layer_step_identity()
}

test "decode_token layer_wide with zero weights is the identity on the residual stream" {
    assert check_layer_wide_identity()
}

test "decode_token layer_wide applies the QKV bias when the flag is set" {
    assert check_qkv_bias_moves_output()
}

test "decode_token layer_wide prope 0 skips RoPE while 1 and 2 rotate" {
    assert check_prope_modes_differ()
}
