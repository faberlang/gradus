+++ toml
locale = "en"

+++ faber
# Record-contract proofs for the decode_token layer API (gradus #47).
#
# One self-contained test module: the imports, type aliases, private builders,
# and module-scope check functions live here, and the thin `+++ faber test`
# cases below call the check functions. Co-located test scopes cannot bind
# imported class names with the current compiler (radix #2525), so the
# constructions happen at module scope and the checks are the module's public
# surface. Every proof runs one layer on a fully fresh workspace, slot, and
# output buffer — no result buffer is ever written twice (the cpu-device run
# route read a stale first value for twice-written buffers; radix #2524).

import from "gradus:decode_token" let dt

type LW = dt.LayerWeights<size 4, size 4, size 4, size 6>
type SV = dt.SlotView<size 4, size 4>
type WS = dt.Workspace<size 4, size 4, size 4, size 6, size 2, size 4, size 2>
type LP = dt.LayerParams
type RK = dt.RopeKind

fn close(f32 a, f32 b) → bool {
    return (a - b).abs() ≺ 0.0001
}

fn weight(int r, int c, int salt) → f32 {
    return (((r * 7 + c * 3 + salt * 5) % 17 - 8) ↦ f32) * 0.025
}

fn build_lw(tensor<f32, [4]> lanorm, tensor<f32, [4, 4]> lwq, tensor<f32, [4, 4]> lwk, tensor<f32, [4, 4]> lwv, tensor<f32, [4, 4]> lwo, tensor<f32, [4]> lfnorm, tensor<f32, [6, 4]> lwg, tensor<f32, [6, 4]> lwu, tensor<f32, [4, 6]> lwd, bool lbias, tensor<f32, [4]> lbq, tensor<f32, [4]> lbk, tensor<f32, [4]> lbv) → LW {
    return dt.LayerWeights<size 4, size 4, size 4, size 6> { anorm = lanorm, wq = lwq, wk = lwk, wv = lwv, wo = lwo, fnorm = lfnorm, wg = lwg, wu = lwu, wd = lwd, qkv_bias = lbias, bq = lbq, bk = lbk, bv = lbv }
}

fn build_sv(mut tensor<f32, [4, 4]> skin, mut tensor<f32, [4, 4]> svin, i32 spos) → SV {
    return dt.SlotView<size 4, size 4> { kin = skin, vin = svin, pos = spos }
}

fn build_ws(tensor<f32, [2, 4]> whcdom, tensor<f32, [2, 4]> wcpdom, tensor<f32, [4]> wqdom, mut tensor<f32, [4]> wxn, mut tensor<f32, [4]> wq, mut tensor<f32, [4]> wqr, mut tensor<f32, [4]> wk, mut tensor<f32, [4]> wkr, mut tensor<f32, [4]> wv, mut tensor<f32, [2, 4]> wsc, mut tensor<f32, [2, 4]> wpr, mut tensor<f32, [2, 4]> wcp, mut tensor<f32, [4]> wctx, mut tensor<f32, [4]> wh1, mut tensor<f32, [6]> wgate, mut tensor<f32, [6]> wup, mut tensor<f32, [6]> wact) → WS {
    return dt.Workspace<size 4, size 4, size 4, size 6, size 2, size 4, size 2> { hcdom = whcdom, cpdom = wcpdom, qdom = wqdom, xn = wxn, q = wq, qr = wqr, k = wk, kr = wkr, v = wv, sc = wsc, pr = wpr, cp = wcp, ctx = wctx, h1 = wh1, gate = wgate, up = wup, act = wact }
}

fn build_lp(i32 bpdh, i32 bpspan, i32 bpgroup, RK bprope, f32 beps, f32 blntheta, f32 bscale) → LP {
    return dt.LayerParams { pdh = bpdh, pspan = bpspan, pgroup = bpgroup, prope = bprope, peps = beps, plntheta = blntheta, pscale = bscale }
}

# Fill the shared weight set once; every check reuses it (weights are
# read-only and never written by a launch).
fn fill_weights(mut tensor<f32, [4, 4]> wq, mut tensor<f32, [4, 4]> wk, mut tensor<f32, [4, 4]> wv, mut tensor<f32, [4, 4]> wo, mut tensor<f32, [6, 4]> wg, mut tensor<f32, [6, 4]> wu, mut tensor<f32, [4, 6]> wd) → void {
    for exclusive 4 let r {
        for exclusive 4 let c {
            wq[[r, c]] ← weight(r, c, 1)
            wk[[r, c]] ← weight(r, c, 2)
            wv[[r, c]] ← weight(r, c, 3)
            wo[[r, c]] ← weight(r, c, 4)
        }
    }
    for exclusive 6 let r {
        for exclusive 4 let c {
            wg[[r, c]] ← weight(r, c, 5)
            wu[[r, c]] ← weight(r, c, 6)
        }
    }
    for exclusive 4 let r {
        for exclusive 6 let c {
            wd[[r, c]] ← weight(r, c, 7)
        }
    }
}

# One layer_wide pass on a private workspace and slot at position `rpos`.
fn run_layer(LW rlw, LP rlp, tensor<f32, [4]> prhin, i32 rpos, mut tensor<f32, [1]> prsink, mut tensor<f32, [4]> prout) → SV {
    let tensor<f32, [2, 4]> prhcdom ← tf32[2, 4] {}
    let tensor<f32, [2, 4]> prcpdom ← tf32[2, 4] {}
    let tensor<f32, [4]> prqdom ← tf32[4] {}
    mut tensor<f32, [4]> prxn ← tf32[4] {}
    mut tensor<f32, [4]> prq ← tf32[4] {}
    mut tensor<f32, [4]> prqr ← tf32[4] {}
    mut tensor<f32, [4]> prk ← tf32[4] {}
    mut tensor<f32, [4]> prkr ← tf32[4] {}
    mut tensor<f32, [4]> prv ← tf32[4] {}
    mut tensor<f32, [2, 4]> prsc ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> prpr ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> prcp ← tf32[2, 4] {}
    mut tensor<f32, [4]> prctx ← tf32[4] {}
    mut tensor<f32, [4]> prh1 ← tf32[4] {}
    mut tensor<f32, [6]> prgate ← tf32[6] {}
    mut tensor<f32, [6]> prup ← tf32[6] {}
    mut tensor<f32, [6]> pract ← tf32[6] {}
    mut _ prws ← build_ws(prhcdom, prcpdom, prqdom, mut prxn, mut prq, mut prqr, mut prk, mut prkr, mut prv, mut prsc, mut prpr, mut prcp, mut prctx, mut prh1, mut prgate, mut prup, mut pract)
    mut tensor<f32, [4, 4]> prkin ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> prvin ← tf32[4, 4] {}
    for exclusive 2 let r {
        for exclusive 4 let c {
            prkin[[r, c]] ← ((r + 1) * (c + 1) ↦ f32) * 0.1
            prvin[[r, c]] ← ((r * 2 + c + 1) ↦ f32) * 0.05
        }
    }
    mut _ prsv ← build_sv(mut prkin, mut prvin, rpos)
    dt.prime_workspace(prws, mut prsink)
    dt.layer_wide(prhin, mut prout, rlw, mut prsv, rlp, mut prws)
    return prsv
}

@ public
fn check_layer_step_identity() → bool {
    let tensor<f32, [2, 4]> hcdom ← tf32[2, 4] {}
    mut tensor<f32, [4]> hin ← tf32[4] {}
    mut tensor<f32, [4]> hout ← tf32[4] {}
    mut tensor<f32, [4]> an ← tf32[4] {}
    let tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    let tensor<f32, [4, 4]> wk ← tf32[4, 4] {}
    let tensor<f32, [4, 4]> wv ← tf32[4, 4] {}
    let tensor<f32, [4, 4]> wo ← tf32[4, 4] {}
    mut tensor<f32, [4]> fn2 ← tf32[4] {}
    let tensor<f32, [6, 4]> wg ← tf32[6, 4] {}
    let tensor<f32, [6, 4]> wu ← tf32[6, 4] {}
    let tensor<f32, [4, 6]> wd ← tf32[4, 6] {}
    let tensor<f32, [4]> bq0 ← tf32[4] {}
    let tensor<f32, [4]> bk0 ← tf32[4] {}
    let tensor<f32, [4]> bv0 ← tf32[4] {}
    for exclusive 4 let j {
        hin[[j]] ← (j ↦ f32) + 1.0
        an[[j]] ← 1.0
        fn2[[j]] ← 1.0
    }
    mut tensor<f32, [4, 4]> kin ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> vin ← tf32[4, 4] {}
    kin[[1, 0]] ← 7.0
    kin[[1, 1]] ← 8.0
    vin[[1, 0]] ← 9.0
    vin[[1, 1]] ← 10.0
    let _ lw ← build_lw(an, wq, wk, wv, wo, fn2, wg, wu, wd, false, bq0, bk0, bv0)
    mut _ sv ← build_sv(mut kin, mut vin, 0)
    let _ lp ← build_lp(2, 2, 1, variant dt.RopeKind.Pairs, 0.00001, 11.512925, 0.5)
    dt.layer_step(hcdom, hin, mut hout, lw, mut sv, lp)
    assert close(hout[[0]], 1.0)
    assert close(hout[[1]], 2.0)
    assert close(hout[[3]], 4.0)
    assert kin[[0, 0]] ≡ (0.0 ↦ f32)
    assert kin[[1, 0]] ≡ (7.0 ↦ f32)
    assert kin[[1, 1]] ≡ (8.0 ↦ f32)
    assert vin[[1, 0]] ≡ (9.0 ↦ f32)
    assert vin[[1, 1]] ≡ (10.0 ↦ f32)
    return true
}

@ public
fn check_layer_wide_identity() → bool {
    mut tensor<f32, [4]> an ← tf32[4] {}
    mut tensor<f32, [4]> fn2 ← tf32[4] {}
    for exclusive 4 let j {
        an[[j]] ← 1.0
        fn2[[j]] ← 1.0
    }
    let tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    let tensor<f32, [4, 4]> wk ← tf32[4, 4] {}
    let tensor<f32, [4, 4]> wv ← tf32[4, 4] {}
    let tensor<f32, [4, 4]> wo ← tf32[4, 4] {}
    let tensor<f32, [6, 4]> wg ← tf32[6, 4] {}
    let tensor<f32, [6, 4]> wu ← tf32[6, 4] {}
    let tensor<f32, [4, 6]> wd ← tf32[4, 6] {}
    let tensor<f32, [4]> bq0 ← tf32[4] {}
    let tensor<f32, [4]> bk0 ← tf32[4] {}
    let tensor<f32, [4]> bv0 ← tf32[4] {}
    let _ lw ← build_lw(an, wq, wk, wv, wo, fn2, wg, wu, wd, false, bq0, bk0, bv0)
    let _ lp ← build_lp(2, 2, 1, variant dt.RopeKind.Pairs, 0.00001, 11.512925, 0.5)
    mut tensor<f32, [1]> sink ← tf32[1] {}
    mut tensor<f32, [4]> hin ← tf32[4] {}
    for exclusive 4 let j {
        hin[[j]] ← (j ↦ f32) + 1.0
    }
    # Token 0 on a fully fresh workspace and slot: the layer is the identity
    # on the residual stream and writes the (zero) rotated keys to row 0.
    mut tensor<f32, [4]> hout0 ← tf32[4] {}
    mut _ sv0 ← run_layer(lw, lp, hin, 0, mut sink, mut hout0)
    assert close(hout0[[0]], 1.0)
    assert close(hout0[[1]], 2.0)
    assert close(hout0[[3]], 4.0)
    assert sv0.kin[[0, 0]] ≡ (0.0 ↦ f32)
    # Token 1 on another fully fresh workspace and slot: same identity, and
    # the cache write lands on row 1.
    mut tensor<f32, [4]> hout1 ← tf32[4] {}
    mut _ sv1 ← run_layer(lw, lp, hin, 1, mut sink, mut hout1)
    assert close(hout1[[0]], 1.0)
    assert close(hout1[[3]], 4.0)
    assert sv1.kin[[1, 0]] ≡ (0.0 ↦ f32)
    return true
}

@ public
fn check_qkv_bias_moves_output() → bool {
    mut tensor<f32, [4]> an ← tf32[4] {}
    mut tensor<f32, [4]> fn2 ← tf32[4] {}
    for exclusive 4 let j {
        an[[j]] ← 1.0
        fn2[[j]] ← 1.0
    }
    mut tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wk ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wv ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wo ← tf32[4, 4] {}
    mut tensor<f32, [6, 4]> wg ← tf32[6, 4] {}
    mut tensor<f32, [6, 4]> wu ← tf32[6, 4] {}
    mut tensor<f32, [4, 6]> wd ← tf32[4, 6] {}
    fill_weights(mut wq, mut wk, mut wv, mut wo, mut wg, mut wu, mut wd)
    let tensor<f32, [4]> bqz ← tf32[4] {}
    let tensor<f32, [4]> bkz ← tf32[4] {}
    let tensor<f32, [4]> bvz ← tf32[4] {}
    mut tensor<f32, [4]> bq1 ← tf32[4] {}
    mut tensor<f32, [4]> bk1 ← tf32[4] {}
    mut tensor<f32, [4]> bv1 ← tf32[4] {}
    for exclusive 4 let j {
        bq1[[j]] ← 1.0
        bk1[[j]] ← 1.0
        bv1[[j]] ← 1.0
    }
    # Three fully fresh runs at pos 1:
    # (a) flag off, zero bias tensors — the reference.
    # (b) flag off, NONZERO bias tensors — the gate must skip them entirely.
    # (c) flag on, the same nonzero bias tensors — the bias must apply.
    let _ lwz ← build_lw(an, wq, wk, wv, wo, fn2, wg, wu, wd, false, bqz, bkz, bvz)
    let _ lwn ← build_lw(an, wq, wk, wv, wo, fn2, wg, wu, wd, false, bq1, bk1, bv1)
    let _ lwt ← build_lw(an, wq, wk, wv, wo, fn2, wg, wu, wd, true, bq1, bk1, bv1)
    let _ lp ← build_lp(2, 2, 1, variant dt.RopeKind.Pairs, 0.00001, 11.512925, 0.5)
    mut tensor<f32, [1]> sink ← tf32[1] {}
    mut tensor<f32, [4]> hin ← tf32[4] {}
    for exclusive 4 let j {
        hin[[j]] ← (j ↦ f32) + 1.0
    }
    mut tensor<f32, [4]> outz ← tf32[4] {}
    mut tensor<f32, [4]> outn ← tf32[4] {}
    mut tensor<f32, [4]> outt ← tf32[4] {}
    mut _ svz ← run_layer(lwz, lp, hin, 1, mut sink, mut outz)
    mut _ svn ← run_layer(lwn, lp, hin, 1, mut sink, mut outn)
    mut _ svt ← run_layer(lwt, lp, hin, 1, mut sink, mut outt)
    # Flag off: the nonzero bias tensors change nothing, bit for bit.
    for exclusive 4 let j {
        assert outn[[j]] ≡ outz[[j]]
        assert svn.vin[[1, j]] ≡ svz.vin[[1, j]]
    }
    # Flag on: the V bias moves the cached value row and the Q/K bias moves
    # the scores, so the output and the cache must both move.
    mut f32 dmax ← 0.0
    mut bool vmoved ← false
    for exclusive 4 let j {
        let f32 d ← (outz[[j]] - outt[[j]]).abs()
        if d ≻ dmax {
            dmax ← d
        }
        if svn.vin[[1, j]] ≢ svt.vin[[1, j]] {
            vmoved ← true
        }
    }
    assert dmax ≻ 0.001
    assert vmoved
    return true
}

@ public
fn check_prope_modes_differ() → bool {
    mut tensor<f32, [4]> an ← tf32[4] {}
    mut tensor<f32, [4]> fn2 ← tf32[4] {}
    for exclusive 4 let j {
        an[[j]] ← 1.0
        fn2[[j]] ← 1.0
    }
    mut tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wk ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wv ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wo ← tf32[4, 4] {}
    mut tensor<f32, [6, 4]> wg ← tf32[6, 4] {}
    mut tensor<f32, [6, 4]> wu ← tf32[6, 4] {}
    mut tensor<f32, [4, 6]> wd ← tf32[4, 6] {}
    fill_weights(mut wq, mut wk, mut wv, mut wo, mut wg, mut wu, mut wd)
    let tensor<f32, [4]> bq0 ← tf32[4] {}
    let tensor<f32, [4]> bk0 ← tf32[4] {}
    let tensor<f32, [4]> bv0 ← tf32[4] {}
    let _ lw ← build_lw(an, wq, wk, wv, wo, fn2, wg, wu, wd, false, bq0, bk0, bv0)
    mut tensor<f32, [1]> sink ← tf32[1] {}
    mut tensor<f32, [4]> hin ← tf32[4] {}
    for exclusive 4 let j {
        hin[[j]] ← (j ↦ f32) + 1.0
    }
    mut tensor<f32, [4]> outnone ← tf32[4] {}
    mut tensor<f32, [4]> outhalf ← tf32[4] {}
    mut tensor<f32, [4]> outpairs ← tf32[4] {}
    mut tensor<f32, [4]> outhalf2 ← tf32[4] {}
    run_layer(lw, build_lp(2, 2, 1, variant dt.RopeKind.None, 0.00001, 11.512925, 2.0), hin, 1, mut sink, mut outnone)
    run_layer(lw, build_lp(2, 2, 1, variant dt.RopeKind.Half, 0.00001, 11.512925, 2.0), hin, 1, mut sink, mut outhalf)
    run_layer(lw, build_lp(2, 2, 1, variant dt.RopeKind.Pairs, 0.00001, 11.512925, 2.0), hin, 1, mut sink, mut outpairs)
    run_layer(lw, build_lp(2, 2, 1, variant dt.RopeKind.Half, 0.00001, 11.512925, 2.0), hin, 1, mut sink, mut outhalf2)
    # Rotation at pos 1 changes the attention result; the bypass differs from
    # both conventions and the two conventions differ from each other. The
    # differences are small at these weight scales, so take the largest move
    # over the residual stream.
    mut f32 dnone ← 0.0
    mut f32 dpairs ← 0.0
    mut f32 dreplay ← 0.0
    for exclusive 4 let j {
        let f32 d1 ← (outnone[[j]] - outhalf[[j]]).abs()
        let f32 d2 ← (outhalf[[j]] - outpairs[[j]]).abs()
        let f32 d3 ← (outhalf[[j]] - outhalf2[[j]]).abs()
        if d1 ≻ dnone {
            dnone ← d1
        }
        if d2 ≻ dpairs {
            dpairs ← d2
        }
        if d3 ≻ dreplay {
            dreplay ← d3
        }
    }
    assert dnone ≻ 0.0001
    assert dpairs ≻ 0.0001
    assert dreplay ≺ 0.0000001
    return true
}

# ---------------------------------------------------------------------------
# Regime-aware batching proofs (gradus #103): B=k verify, B=k diffusion,
# B=C chunked prefill.
# ---------------------------------------------------------------------------
type SV12 = dt.SlotView<size 12, size 4>
type WS12 = dt.Workspace<size 4, size 4, size 4, size 6, size 2, size 12, size 2>
type BWS4 = dt.BatchWorkspace<size 4, size 8, size 4, size 4, size 4, size 6, size 2, size 12>

fn close_tol(f32 got, f32 ref) → bool {
    let f32 diff ← (got - ref).abs()
    let f32 lim ← 0.00001 + 0.0001 * ref.abs()
    return diff ≤ lim
}

fn build_sv12(mut tensor<f32, [12, 4]> skin, mut tensor<f32, [12, 4]> svin, i32 spos) → SV12 {
    return dt.SlotView<size 12, size 4> { kin = skin, vin = svin, pos = spos }
}

fn build_ws12(tensor<f32, [2, 12]> whcdom, tensor<f32, [2, 4]> wcpdom, tensor<f32, [4]> wqdom, mut tensor<f32, [4]> wxn, mut tensor<f32, [4]> wq, mut tensor<f32, [4]> wqr, mut tensor<f32, [4]> wk, mut tensor<f32, [4]> wkr, mut tensor<f32, [4]> wv, mut tensor<f32, [2, 12]> wsc, mut tensor<f32, [2, 12]> wpr, mut tensor<f32, [2, 4]> wcp, mut tensor<f32, [4]> wctx, mut tensor<f32, [4]> wh1, mut tensor<f32, [6]> wgate, mut tensor<f32, [6]> wup, mut tensor<f32, [6]> wact) → WS12 {
    return dt.Workspace<size 4, size 4, size 4, size 6, size 2, size 12, size 2> { hcdom = whcdom, cpdom = wcpdom, qdom = wqdom, xn = wxn, q = wq, qr = wqr, k = wk, kr = wkr, v = wv, sc = wsc, pr = wpr, cp = wcp, ctx = wctx, h1 = wh1, gate = wgate, up = wup, act = wact }
}

fn build_bws4(tensor<f32, [8, 12]> whcdom, tensor<f32, [4, 4]> wqdom, mut tensor<f32, [4, 4]> wxn, mut tensor<f32, [4, 4]> wq, mut tensor<f32, [4, 4]> wqr, mut tensor<f32, [4, 4]> wk, mut tensor<f32, [4, 4]> wkr, mut tensor<f32, [4, 4]> wv, mut tensor<f32, [8, 12]> wsc, mut tensor<f32, [8, 12]> wpr, mut tensor<f32, [4, 4]> wctx, mut tensor<f32, [4, 4]> wh1, mut tensor<f32, [4, 6]> wgate, mut tensor<f32, [4, 6]> wup, mut tensor<f32, [4, 6]> wact) → BWS4 {
    return dt.BatchWorkspace<size 4, size 8, size 4, size 4, size 4, size 6, size 2, size 12> { hcdom = whcdom, qdom = wqdom, xn = wxn, q = wq, qr = wqr, k = wk, kr = wkr, v = wv, sc = wsc, pr = wpr, ctx = wctx, h1 = wh1, gate = wgate, up = wup, act = wact }
}

fn fresh_bws4(mut tensor<f32, [1]> sink) → BWS4 {
    let tensor<f32, [8, 12]> hcdom ← tf32[8, 12] {}
    let tensor<f32, [4, 4]> qdom ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> xn ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> q ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> qr ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> k ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> kr ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> v ← tf32[4, 4] {}
    mut tensor<f32, [8, 12]> sc ← tf32[8, 12] {}
    mut tensor<f32, [8, 12]> pr ← tf32[8, 12] {}
    mut tensor<f32, [4, 4]> ctx ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> h1 ← tf32[4, 4] {}
    mut tensor<f32, [4, 6]> gate ← tf32[4, 6] {}
    mut tensor<f32, [4, 6]> up ← tf32[4, 6] {}
    mut tensor<f32, [4, 6]> act ← tf32[4, 6] {}
    mut _ ws ← build_bws4(hcdom, qdom, mut xn, mut q, mut qr, mut k, mut kr, mut v, mut sc, mut pr, mut ctx, mut h1, mut gate, mut up, mut act)
    dt.prime_batch_workspace(ws, mut sink)
    return ws
}

fn run_seq_step12(LW rlw, LP rlp, tensor<f32, [4]> hin, mut SV12 sv, mut tensor<f32, [1]> sink, mut tensor<f32, [4]> hout) → void {
    let tensor<f32, [2, 12]> hcdom ← tf32[2, 12] {}
    let tensor<f32, [2, 4]> cpdom ← tf32[2, 4] {}
    let tensor<f32, [4]> qdom ← tf32[4] {}
    mut tensor<f32, [4]> xn ← tf32[4] {}
    mut tensor<f32, [4]> q ← tf32[4] {}
    mut tensor<f32, [4]> qr ← tf32[4] {}
    mut tensor<f32, [4]> k ← tf32[4] {}
    mut tensor<f32, [4]> kr ← tf32[4] {}
    mut tensor<f32, [4]> v ← tf32[4] {}
    mut tensor<f32, [2, 12]> sc ← tf32[2, 12] {}
    mut tensor<f32, [2, 12]> pr ← tf32[2, 12] {}
    mut tensor<f32, [2, 4]> cp ← tf32[2, 4] {}
    mut tensor<f32, [4]> ctx ← tf32[4] {}
    mut tensor<f32, [4]> h1 ← tf32[4] {}
    mut tensor<f32, [6]> gate ← tf32[6] {}
    mut tensor<f32, [6]> up ← tf32[6] {}
    mut tensor<f32, [6]> act ← tf32[6] {}
    mut _ ws ← build_ws12(hcdom, cpdom, qdom, mut xn, mut q, mut qr, mut k, mut kr, mut v, mut sc, mut pr, mut cp, mut ctx, mut h1, mut gate, mut up, mut act)
    dt.prime_workspace(ws, mut sink)
    dt.layer_wide(hin, mut hout, rlw, mut sv, rlp, mut ws)
}

fn fill_prefix_kv(mut tensor<f32, [12, 4]> kc, mut tensor<f32, [12, 4]> vc, int prefix) → void {
    for exclusive prefix let r {
        for exclusive 4 let c {
            kc[[r, c]] ← ((r + 1) * (c + 1) ↦ f32) * 0.1
            vc[[r, c]] ← ((r * 2 + c + 1) ↦ f32) * 0.05
        }
    }
}

fn make_test_lw(bool use_bias) → LW {
    mut tensor<f32, [4]> an ← tf32[4] {}
    mut tensor<f32, [4]> fn2 ← tf32[4] {}
    for exclusive 4 let j {
        an[[j]] ← 1.0 + (j ↦ f32) * 0.1
        fn2[[j]] ← 1.0 - (j ↦ f32) * 0.05
    }
    mut tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wk ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wv ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> wo ← tf32[4, 4] {}
    mut tensor<f32, [6, 4]> wg ← tf32[6, 4] {}
    mut tensor<f32, [6, 4]> wu ← tf32[6, 4] {}
    mut tensor<f32, [4, 6]> wd ← tf32[4, 6] {}
    fill_weights(mut wq, mut wk, mut wv, mut wo, mut wg, mut wu, mut wd)
    mut tensor<f32, [4]> bq ← tf32[4] {}
    mut tensor<f32, [4]> bk ← tf32[4] {}
    mut tensor<f32, [4]> bv ← tf32[4] {}
    if use_bias {
        for exclusive 4 let j {
            bq[[j]] ← (j ↦ f32) * 0.05
            bk[[j]] ← ((3 - j) ↦ f32) * 0.04
            bv[[j]] ← 0.03
        }
    }
    return build_lw(an, wq, wk, wv, wo, fn2, wg, wu, wd, use_bias, bq, bk, bv)
}

@ public
fn check_batch_causal_verify_matches_sequential() → bool {
    let _ lw ← make_test_lw(true)
    let _ lp ← build_lp(2, 1, 1, variant dt.RopeKind.Pairs, 0.00001, 11.512925, 0.70710677)
    mut tensor<f32, [1]> sink ← tf32[1] {}

    # 2 tokens in prefix, verify k = 4 tokens at pos = 2..5 inside MaxBatch = 4.
    mut tensor<f32, [4, 4]> hin ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> hout_batch ← tf32[4, 4] {}
    for exclusive 4 let b {
        for exclusive 4 let j {
            hin[[b, j]] ← ((b * 3 + j + 1) ↦ f32) * 0.25
        }
    }

    mut tensor<f32, [12, 4]> kin_b ← tf32[12, 4] {}
    mut tensor<f32, [12, 4]> vin_b ← tf32[12, 4] {}
    fill_prefix_kv(mut kin_b, mut vin_b, 2)
    mut _ sv_b ← build_sv12(mut kin_b, mut vin_b, 2)
    mut _ bws ← fresh_bws4(mut sink)
    dt.layer_batch(hin, mut hout_batch, lw, mut sv_b, lp, mut bws, 4, variant dt.AttentionRegime.Causal)

    # Sequential reference: 4 B=1 layer_wide steps at pos = 2, 3, 4, 5.
    mut tensor<f32, [12, 4]> kin_s ← tf32[12, 4] {}
    mut tensor<f32, [12, 4]> vin_s ← tf32[12, 4] {}
    fill_prefix_kv(mut kin_s, mut vin_s, 2)
    mut _ sv_s ← build_sv12(mut kin_s, mut vin_s, 2)

    for exclusive 4 let b {
        mut tensor<f32, [4]> h_step ← tf32[4] {}
        mut tensor<f32, [4]> o_step ← tf32[4] {}
        for exclusive 4 let j {
            h_step[[j]] ← hin[[b, j]]
        }
        sv_s.pos ← 2 + b
        run_seq_step12(lw, lp, h_step, mut sv_s, mut sink, mut o_step)
        for exclusive 4 let j {
            assert close_tol(hout_batch[[b, j]], o_step[[j]])
            assert close_tol(sv_b.kin[[2 + b, j]], sv_s.kin[[2 + b, j]])
            assert close_tol(sv_b.vin[[2 + b, j]], sv_s.vin[[2 + b, j]])
        }
    }
    return true
}

@ public
fn check_batch_block_diffusion_matches_reference() → bool {
    let _ lw ← make_test_lw(false)
    let _ lp ← build_lp(2, 1, 1, variant dt.RopeKind.Half, 0.00001, 11.512925, 0.70710677)
    mut tensor<f32, [1]> sink ← tf32[1] {}

    # 2 prefix tokens + 4 diffusion tokens (block_size = 8).
    mut tensor<f32, [4, 4]> hin ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> hout_diff ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> hout_caus ← tf32[4, 4] {}
    for exclusive 4 let b {
        for exclusive 4 let j {
            hin[[b, j]] ← ((b * 5 + j + 1) ↦ f32) * 0.2
        }
    }

    mut tensor<f32, [12, 4]> kin_d ← tf32[12, 4] {}
    mut tensor<f32, [12, 4]> vin_d ← tf32[12, 4] {}
    fill_prefix_kv(mut kin_d, mut vin_d, 2)
    mut _ sv_d ← build_sv12(mut kin_d, mut vin_d, 2)
    mut _ bws_d ← fresh_bws4(mut sink)
    dt.layer_batch(hin, mut hout_diff, lw, mut sv_d, lp, mut bws_d, 4, variant dt.AttentionRegime.BlockDiffusion { block_size = 8 })

    # Compare against Causal on the same inputs: token 0 in BlockDiffusion
    # attends to tokens 1..3 as well, so its output must differ from Causal.
    mut tensor<f32, [12, 4]> kin_c ← tf32[12, 4] {}
    mut tensor<f32, [12, 4]> vin_c ← tf32[12, 4] {}
    fill_prefix_kv(mut kin_c, mut vin_c, 2)
    mut _ sv_c ← build_sv12(mut kin_c, mut vin_c, 2)
    mut _ bws_c ← fresh_bws4(mut sink)
    dt.layer_batch(hin, mut hout_caus, lw, mut sv_c, lp, mut bws_c, 4, variant dt.AttentionRegime.Causal)

    mut f32 diff0 ← 0.0
    for exclusive 4 let j {
        let f32 d ← (hout_diff[[0, j]] - hout_caus[[0, j]]).abs()
        if d ≻ diff0 {
            diff0 ← d
        }
    }
    assert diff0 ≻ 0.0001

    # Naive host reference for non-causal block diffusion (all 4 tokens attend
    # mutually over [0 .. 6), i.e., prefix 2 + block 4):
    # We reuse sv_d's rotated KV cache (which is identical to sv_c's KV cache)
    # and recompute attention + output projection + MLP on the host.
    for exclusive 4 let b {
        # RMSNorm on hin[b, :]
        mut f32 ss ← 0.0
        for exclusive 4 let j {
            ss ← ss + hin[[b, j]] * hin[[b, j]]
        }
        let f32 inv_rms ← 1.0 / (ss / 4.0 + lp.peps).sqrt()
        mut tensor<f32, [4]> xn ← tf32[4] {}
        for exclusive 4 let j {
            xn[[j]] ← hin[[b, j]] * inv_rms * lw.anorm[[j]]
        }

        # Q = wq @ xn
        mut tensor<f32, [4]> q ← tf32[4] {}
        for exclusive 4 let r {
            mut f32 acc ← 0.0
            for exclusive 4 let c {
                acc ← acc + lw.wq[[r, c]] * xn[[c]]
            }
            q[[r]] ← acc
        }

        # Half RoPE at pos = 2 + b (span = 1, so each pair rotates by ang = pos)
        mut tensor<f32, [4]> qr ← tf32[4] {}
        let f32 ang ← (2 + b) ↦ f32
        let f32 cs ← ang.cos()
        let f32 sn ← ang.sin()
        qr[[0]] ← q[[0]] * cs - q[[1]] * sn
        qr[[1]] ← q[[0]] * sn + q[[1]] * cs
        qr[[2]] ← q[[2]] * cs - q[[3]] * sn
        qr[[3]] ← q[[2]] * sn + q[[3]] * cs

        # Non-causal attention over c in 0 .. 6 (prefix 2 + all 4 block tokens)
        mut tensor<f32, [4]> ctx ← tf32[4] {}
        for exclusive 2 let h {
            let i32 base ← h * 2
            mut tensor<f32, [6]> sc ← tf32[6] {}
            mut f32 mx ← -1.0e30
            for exclusive 6 let c {
                let f32 s ← (qr[[base]] * sv_d.kin[[c, base]] + qr[[base + 1]] * sv_d.kin[[c, base + 1]]) * lp.pscale
                sc[[c]] ← s
                if s ≻ mx {
                    mx ← s
                }
            }
            mut f32 esum ← 0.0
            for exclusive 6 let c {
                let f32 ev ← (sc[[c]] - mx).exp()
                sc[[c]] ← ev
                esum ← esum + ev
            }
            for exclusive 2 let d {
                mut f32 vacc ← 0.0
                for exclusive 6 let c {
                    vacc ← vacc + (sc[[c]] / esum) * sv_d.vin[[c, base + d]]
                }
                ctx[[base + d]] ← vacc
            }
        }

        # O projection + residual 1
        mut tensor<f32, [4]> h1 ← tf32[4] {}
        for exclusive 4 let r {
            mut f32 acc ← 0.0
            for exclusive 4 let c {
                acc ← acc + lw.wo[[r, c]] * ctx[[c]]
            }
            h1[[r]] ← hin[[b, r]] + acc
        }

        # FFN RMSNorm + SwiGLU + Wd + residual 2
        mut f32 ss2 ← 0.0
        for exclusive 4 let j {
            ss2 ← ss2 + h1[[j]] * h1[[j]]
        }
        let f32 inv_rms2 ← 1.0 / (ss2 / 4.0 + lp.peps).sqrt()
        mut tensor<f32, [4]> fnx ← tf32[4] {}
        for exclusive 4 let j {
            fnx[[j]] ← h1[[j]] * inv_rms2 * lw.fnorm[[j]]
        }
        mut tensor<f32, [6]> act ← tf32[6] {}
        for exclusive 6 let r {
            mut f32 gacc ← 0.0
            mut f32 uacc ← 0.0
            for exclusive 4 let c {
                gacc ← gacc + lw.wg[[r, c]] * fnx[[c]]
                uacc ← uacc + lw.wu[[r, c]] * fnx[[c]]
            }
            act[[r]] ← gacc / (1.0 + (-gacc).exp()) * uacc
        }
        for exclusive 4 let r {
            mut f32 dacc ← 0.0
            for exclusive 6 let c {
                dacc ← dacc + lw.wd[[r, c]] * act[[c]]
            }
            let f32 ref_v ← h1[[r]] + dacc
            assert close_tol(hout_diff[[b, r]], ref_v)
        }
    }
    return true
}

@ public
fn check_batch_chunked_prefill_matches_sequential() → bool {
    let _ lw ← make_test_lw(true)
    let _ lp ← build_lp(2, 1, 1, variant dt.RopeKind.None, 0.00001, 11.512925, 0.70710677)
    mut tensor<f32, [1]> sink ← tf32[1] {}

    # 7-token sequence prefilled in two chunks of MaxBatch = C_chunk = 4:
    # chunk 0: active_b = 4 at pos = 0..3
    # chunk 1: active_b = 3 at pos = 4..6
    mut tensor<f32, [4, 4]> hin0 ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> hout0 ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> hin1 ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> hout1 ← tf32[4, 4] {}
    for exclusive 4 let b {
        for exclusive 4 let j {
            hin0[[b, j]] ← ((b * 4 + j + 1) ↦ f32) * 0.15
        }
    }
    for exclusive 3 let b {
        for exclusive 4 let j {
            hin1[[b, j]] ← (((b + 4) * 4 + j + 1) ↦ f32) * 0.15
        }
    }

    mut tensor<f32, [12, 4]> kin_p ← tf32[12, 4] {}
    mut tensor<f32, [12, 4]> vin_p ← tf32[12, 4] {}
    mut _ sv_p ← build_sv12(mut kin_p, mut vin_p, 0)
    mut _ bws0 ← fresh_bws4(mut sink)
    dt.layer_batch(hin0, mut hout0, lw, mut sv_p, lp, mut bws0, 4, variant dt.AttentionRegime.Causal)
    sv_p.pos ← 4
    mut _ bws1 ← fresh_bws4(mut sink)
    dt.layer_batch(hin1, mut hout1, lw, mut sv_p, lp, mut bws1, 3, variant dt.AttentionRegime.Causal)

    # Sequential B=1 reference over all 7 tokens.
    mut tensor<f32, [12, 4]> kin_s ← tf32[12, 4] {}
    mut tensor<f32, [12, 4]> vin_s ← tf32[12, 4] {}
    mut _ sv_s ← build_sv12(mut kin_s, mut vin_s, 0)

    for exclusive 7 let t {
        mut tensor<f32, [4]> h_step ← tf32[4] {}
        mut tensor<f32, [4]> o_step ← tf32[4] {}
        for exclusive 4 let j {
            h_step[[j]] ← ((t * 4 + j + 1) ↦ f32) * 0.15
        }
        sv_s.pos ← t
        run_seq_step12(lw, lp, h_step, mut sv_s, mut sink, mut o_step)
        for exclusive 4 let j {
            if t ≺ 4 {
                assert close_tol(hout0[[t, j]], o_step[[j]])
            }
            else {
                assert close_tol(hout1[[t - 4, j]], o_step[[j]])
            }
            assert close_tol(sv_p.kin[[t, j]], sv_s.kin[[t, j]])
            assert close_tol(sv_p.vin[[t, j]], sv_s.vin[[t, j]])
        }
    }
    return true
}

@ public
fn check_tiled_batch_matches_batch() → bool {
    let _ lw ← make_test_lw(true)
    let _ lp ← build_lp(2, 1, 1, variant dt.RopeKind.Half, 0.00001, 11.512925, 0.70710677)
    mut tensor<f32, [1]> sink ← tf32[1] {}

    mut tensor<f32, [4, 4]> hin ← tf32[4, 4] {}
    for range 0‥4 let b {
        for range 0‥4 let d {
            hin[[b, d]] ← ((b + 1) * (d + 2) ↦ f32) * 0.25
        }
    }

    mut tensor<f32, [12, 4]> kin_b ← tf32[12, 4] {}
    mut tensor<f32, [12, 4]> vin_b ← tf32[12, 4] {}
    mut _ sv_b ← dt.SlotView<size 12, size 4> { kin = kin_b, vin = vin_b, pos = 0 }
    mut _ bws ← fresh_bws4(mut sink)
    mut tensor<f32, [4, 4]> hout_b ← tf32[4, 4] {}
    dt.layer_batch(hin, mut hout_b, lw, mut sv_b, lp, mut bws, 4, variant dt.AttentionRegime.Causal)

    mut tensor<f32, [12, 4]> kin_t ← tf32[12, 4] {}
    mut tensor<f32, [12, 4]> vin_t ← tf32[12, 4] {}
    mut _ sv_t ← dt.SlotView<size 12, size 4> { kin = kin_t, vin = vin_t, pos = 0 }
    let tensor<f32, [4, 12]> thcdom ← tf32[4, 12] {}
    let tensor<f32, [2, 4]> tqdom ← tf32[2, 4] {}
    mut tensor<f32, [4, 4]> txn ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> tq ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> tqr ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> tk ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> tkr ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> tv ← tf32[4, 4] {}
    mut tensor<f32, [4, 12]> tsc ← tf32[4, 12] {}
    mut tensor<f32, [4, 12]> tpr ← tf32[4, 12] {}
    mut tensor<f32, [4, 4]> tctx ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> th1 ← tf32[4, 4] {}
    mut tensor<f32, [4, 6]> tgate ← tf32[4, 6] {}
    mut tensor<f32, [4, 6]> tup ← tf32[4, 6] {}
    mut tensor<f32, [4, 6]> tact ← tf32[4, 6] {}
    mut _ tws ← dt.TiledBatchWorkspace<size 4, size 2, size 4, size 4, size 4, size 4, size 6, size 2, size 12> {
        hcdom = thcdom, qdom = tqdom, xn = txn, q = tq, qr = tqr, k = tk, kr = tkr, v = tv,
        sc = tsc, pr = tpr, ctx = tctx, h1 = th1, gate = tgate, up = tup, act = tact
    }
    dt.prime_tiled_batch_workspace(tws, mut sink)
    mut tensor<f32, [4, 4]> hout_t ← tf32[4, 4] {}
    dt.layer_batch_tiled(hin, mut hout_t, lw, mut sv_t, lp, mut tws, 4, variant dt.AttentionRegime.Causal)

    for range 0‥4 let b {
        for range 0‥4 let d {
            if not close(hout_t[[b, d]], hout_b[[b, d]]) then return false
        }
    }
    return true
}

@ public
fn check_tiled_batch_partial_matches_batch() → bool {
    let _ lw ← make_test_lw(true)
    let _ lp ← build_lp(2, 1, 1, variant dt.RopeKind.Pairs, 0.00001, 11.512925, 0.70710677)
    mut tensor<f32, [1]> sink ← tf32[1] {}

    # MaxBatch=4, TileB=2, active_b=3: exercises partial-batch projection and trailing partial tile (qcount=1).
    mut tensor<f32, [4, 4]> hin ← tf32[4, 4] {}
    for range 0‥4 let b {
        for range 0‥4 let d {
            hin[[b, d]] ← ((b * 3 + d + 1) ↦ f32) * 0.2
        }
    }

    mut tensor<f32, [12, 4]> kin_b ← tf32[12, 4] {}
    mut tensor<f32, [12, 4]> vin_b ← tf32[12, 4] {}
    fill_prefix_kv(mut kin_b, mut vin_b, 2)
    mut _ sv_b ← dt.SlotView<size 12, size 4> { kin = kin_b, vin = vin_b, pos = 2 }
    mut _ bws ← fresh_bws4(mut sink)
    mut tensor<f32, [4, 4]> hout_b ← tf32[4, 4] {}
    dt.layer_batch(hin, mut hout_b, lw, mut sv_b, lp, mut bws, 3, variant dt.AttentionRegime.BlockDiffusion { block_size = 2 })

    mut tensor<f32, [12, 4]> kin_t ← tf32[12, 4] {}
    mut tensor<f32, [12, 4]> vin_t ← tf32[12, 4] {}
    fill_prefix_kv(mut kin_t, mut vin_t, 2)
    mut _ sv_t ← dt.SlotView<size 12, size 4> { kin = kin_t, vin = vin_t, pos = 2 }
    let tensor<f32, [4, 12]> thcdom ← tf32[4, 12] {}
    let tensor<f32, [2, 4]> tqdom ← tf32[2, 4] {}
    mut tensor<f32, [4, 4]> txn ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> tq ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> tqr ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> tk ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> tkr ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> tv ← tf32[4, 4] {}
    mut tensor<f32, [4, 12]> tsc ← tf32[4, 12] {}
    mut tensor<f32, [4, 12]> tpr ← tf32[4, 12] {}
    mut tensor<f32, [4, 4]> tctx ← tf32[4, 4] {}
    mut tensor<f32, [4, 4]> th1 ← tf32[4, 4] {}
    mut tensor<f32, [4, 6]> tgate ← tf32[4, 6] {}
    mut tensor<f32, [4, 6]> tup ← tf32[4, 6] {}
    mut tensor<f32, [4, 6]> tact ← tf32[4, 6] {}
    mut _ tws ← dt.TiledBatchWorkspace<size 4, size 2, size 4, size 4, size 4, size 4, size 6, size 2, size 12> {
        hcdom = thcdom, qdom = tqdom, xn = txn, q = tq, qr = tqr, k = tk, kr = tkr, v = tv,
        sc = tsc, pr = tpr, ctx = tctx, h1 = th1, gate = tgate, up = tup, act = tact
    }
    dt.prime_tiled_batch_workspace(tws, mut sink)
    mut tensor<f32, [4, 4]> hout_t ← tf32[4, 4] {}
    dt.layer_batch_tiled(hin, mut hout_t, lw, mut sv_t, lp, mut tws, 3, variant dt.AttentionRegime.BlockDiffusion { block_size = 2 })

    for range 0‥3 let b {
        for range 0‥4 let d {
            if not close(hout_t[[b, d]], hout_b[[b, d]]) then return false
        }
        for range 0‥4 let d {
            if not close(sv_t.kin[[2 + b, d]], sv_b.kin[[2 + b, d]]) then return false
            if not close(sv_t.vin[[2 + b, d]], sv_b.vin[[2 + b, d]]) then return false
        }
    }
    return true
}

+++ faber test
# Thin cases: the proofs live in the module-scope check functions above.

test "decode_token layer_step with zero weights is the identity on the residual stream" {
    assert check_layer_step_identity()
}

test "decode_token layer_wide with zero weights is the identity on the residual stream" {
    assert check_layer_wide_identity()
}

test "decode_token layer_wide applies the QKV bias when the flag is set" {
    assert check_qkv_bias_moves_output()
}

test "decode_token layer_wide prope modes differ and replay deterministically" {
    assert check_prope_modes_differ()
}

test "decode_token layer_batch causal verify (B=k) matches sequential layer_wide" {
    assert check_batch_causal_verify_matches_sequential()
}

test "decode_token layer_batch block diffusion (B=k) matches naive reference" {
    assert check_batch_block_diffusion_matches_reference()
}

test "decode_token layer_batch chunked prefill (B=C) matches sequential layer_wide across chunks" {
    assert check_batch_chunked_prefill_matches_sequential()
}

test "decode_token layer_batch_tiled (O(TileB * H * C)) matches layer_batch" {
    assert check_tiled_batch_matches_batch()
}

test "decode_token layer_batch_tiled matches layer_batch on partial batch and trailing tile" {
    assert check_tiled_batch_partial_matches_batch()
}
