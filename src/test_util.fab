+++
locale = "en"
+++
# Shared proba-support helpers (U4a quality wave — proba do/catch deblock).
#
# or_default — run a failable call and fall back to a default on error.
# Theme-Z1 proba blocks (`do { t ← f() } catch { return t }`) collapse to
# one call; the fallback is the pre-work value the original catch returned.
# `@ public` (not `@ interna`) because the co-located proba suites are checked
# as standalone sources: `@ interna` is same-package-only and the standalone
# check route reports SEM006 import_interna_cross_package. The generic
# single-closure shape is the FMIR runner's supported bound — a second
# closure parameter or a generic discarded result do not lower
# (radix-mir validate/lower).

@ public { }
fn or_default<T, E>(() → T ⇥ E work, T fallback) → T {
    do {
        return work()
    }
    catch err {
        return fallback
    }
}
