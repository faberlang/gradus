+++ toml
locale = "en"

+++ faber
# Dense-engine generation over gradus:model/dense and the KV cache.
#
# Public import: import from "gradus:generation/dense" dense_gen
# Depends on: gradus:generation/config, gradus:generation/decoder,
#   gradus:attention/rope, gradus:cache/kv, gradus:model/dense.

import from "gradus:generation/config"

import from "gradus:generation/decoder"

import from "gradus:attention/rope"

import from "gradus:cache/kv"

import from "gradus:decode"

import from "gradus:dtype"

import from "gradus:model/dense"

import from "gradus:sampling"

import from "gradus:tensor"

import from "gradus:random"

fn dense_one(DenseEngine engine, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, int token_id, int position, list<kv.KVCache> layers) → dense.DenseStep ⇥ config.GenerationError {
    do {
        return dense.decode_step(engine.architecture, source, token_id, position, engine.epsilon, engine.scale, engine.rope_dim, engine.rope, layers)
    }
    catch err {
        throw variant config.GenerationError.DecodeFailure { message = err.message }
    }
}

fn dense_prefill(DenseEngine engine, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, list<int> prompt_ids, list<kv.KVCache> layers) → dense.DenseStep ⇥ config.GenerationError {
    do {
        return dense.prefill_cached(engine.architecture, source, prompt_ids, engine.epsilon, engine.scale, engine.rope_dim, engine.rope, layers)
    }
    catch err {
        throw variant config.GenerationError.DecodeFailure { message = err.message }
    }
}

fn advance_n(config.GenerationConfig g, decoder.GenerationCursor start, int count) → decoder.GenerationCursor ⇥ config.GenerationError {
    mut decoder.GenerationCursor out ← copy start

    for range 0 ‥ count let i {
        out ← decoder.cursor_advance(g, out)
    }

    return out
}

# The shared rank/row/vocabulary gate for one logits-row read: the copied
# row (logit_row) and the inline greedy argmax (greedy_row_token) keep the
# same fail-closed contract.
fn require_logits_row(tensor.NumericBlock logits, int row, int vocab) → void ⇥ config.GenerationError {
    require logits.rank() ≡ 2 throw variant config.GenerationError.DecodeFailure { message = "decode logits must be rank two" }

    # NumericBlock carries a runtime shape; validate its rank before indexing.
    let list<int> shape ← logits.shape
    let int rows ← shape.get(0) coalesce 0
    let int cols ← shape.get(1) coalesce 0

    require row ≥ 0 and row ≺ rows throw variant config.GenerationError.DecodeFailure { message = "decode logits row is outside the block" }

    require cols ≡ vocab throw variant config.GenerationError.DecodeFailure { message = "decode logits shape does not match the vocabulary" }

    return
}

fn logit_row(tensor.NumericBlock logits, int row, int vocab) → list<f32> ⇥ config.GenerationError {
    require_logits_row(logits, row, vocab)

    mut list<f32> out ← empty

    # NumericBlock data is flat; the row index selects the requested value.
    for range 0 ‥ vocab let i {
        out.append(logits.data.get(row * vocab + i) coalesce 0.0 ∷ f32)
    }

    return out
}

# The greedy target token for one verified logits row: the EOG-masked argmax
# computed inline over the flat row — no [V] copy (issue #77). It matches
# sample(sample_logits(row, g, stop), drawn, empty, rng) exactly when the
# drawn config takes the greedy path (temperature zero ignores the history,
# the penalty, and the seed): the same -1000000000 mask, the same first-index
# tie-break, and the same fail-closed shape and finite gates.
fn greedy_row_token(tensor.NumericBlock logits, int row, int vocab, config.GenerationConfig g, decoder.StopPolicy stop) → int ⇥ config.GenerationError {
    require_logits_row(logits, row, vocab)

    mut int best ← 0 - 1
    mut f32 best_value ← 0.0 ∷ f32

    for exclusive vocab let i {
        mut f32 value ← logits.data.get(row * vocab + i) coalesce 0.0 ∷ f32

        if not decoder.stops_on_eog(stop) and decoder.is_eog(g, i) {
            value ← (-1000000000.0) ∷ f32
        }

        require dtype.finite(value) throw variant config.GenerationError.DecodeFailure { message = "logits must be finite" }

        if best ≺ 0 or value ≻ best_value {
            best ← i
            best_value ← value
        }
    }

    require best ≥ 0 throw variant config.GenerationError.DecodeFailure { message = "logits must be non-empty" }

    return best
}

# The target token for one verified row: the greedy path computes the masked
# argmax inline; the sampled path runs the full sampling pipeline with an
# empty history (the outcome seed is discarded either way, so the walk never
# moves the RNG).
fn target_row_token(tensor.NumericBlock logits, int row, int vocab, sampling.Config drawn, random.Seed rng, config.GenerationConfig g, decoder.StopPolicy stop) → int ⇥ config.GenerationError {
    if drawn.temperature ≤ 0.0 {
        return greedy_row_token(logits, row, vocab, g, stop)
    }

    let list<f32> values ← logit_row(logits, row, vocab)
    let sampling.Sampler target ← decoder.sample(decoder.sample_logits(values, g, stop), drawn, empty, rng)
    return target.token_id
}

# The context token at flat position i without materializing the context:
# the prompt precedes the accepted history (issue #77 — no per-step copy).
fn context_token(list<int> prompt, list<int> history, int prompt_length, int i) → int {
    if i ≺ prompt_length {
        return prompt.get(i) coalesce (-1)
    }

    return history.get(i - prompt_length) coalesce (-1)
}

# Compare one source window with the final context suffix by token id,
# stopping at the first mismatch (issue #77 — the walk no longer runs to the
# window end).
fn window_matches(list<int> prompt, list<int> history, int prompt_length, int source_offset, int suffix_start, int match_length) → bool {
    for exclusive match_length let i {
        if context_token(prompt, history, prompt_length, source_offset + i) ≢ context_token(prompt, history, prompt_length, suffix_start + i) {
            return false
        }
    }

    return true
}

fn lookup_candidates(list<int> prompt, list<int> history, int block_size) → list<int> {
    let int prompt_length ← prompt.length()
    let int available ← prompt_length + history.length()

    if available ≺ 2 then return empty

    mut int match_length ← block_size

    if match_length ≻ available - 1 {
        match_length ← available - 1
    }

    while match_length ≥ 1 {
        let int suffix_start ← available - match_length

        # The final position is excluded from the source walk: a match there
        # is the suffix comparing with itself and has no following token to
        # begin a candidate extension (issue #77).
        for exclusive suffix_start let source_offset {
            if window_matches(prompt, history, prompt_length, source_offset, suffix_start, match_length) {
                let int following ← source_offset + match_length
                mut int extension ← block_size

                if extension ≻ available - following {
                    extension ← available - following
                }

                if extension ≥ 1 {
                    mut list<int> candidates ← empty

                    # This range extracts the tokens that followed the match.
                    for exclusive extension let i {
                        candidates.append(context_token(prompt, history, prompt_length, following + i))
                    }

                    return candidates
                }
            }
        }

        match_length ← match_length - 1
    }

    return empty
}

fn layer_lengths(list<kv.KVCache> layers) → list<int> {
    mut list<int> out ← empty

    for from layers let layer {
        out.append(layer.length())
    }

    return out
}

fn commit_dense_block(list<int> base_lengths, dense.DenseStep verified, list<int> candidate_ids, int accepted_count) → list<kv.KVCache> ⇥ config.GenerationError {
    require accepted_count ≥ 1 throw variant config.GenerationError.DecodeFailure { message = "accepted candidate block must not be empty" }

    require accepted_count ≤ candidate_ids.length() throw variant config.GenerationError.DecodeFailure { message = "accepted candidate block exceeds the proposal" }

    require verified.layers.length() ≡ base_lengths.length() throw variant config.GenerationError.DecodeFailure { message = "verified cache layer count does not match the base" }

    # Full accept: the verified views already hold every accepted row over
    # the pre-allocated buffers — reuse them as the committed state (issue
    # #77, no second write and no fork copy).
    if accepted_count ≡ candidate_ids.length() {
        return verified.layers
    }

    mut list<kv.KVCache> committed ← empty

    for exclusive base_lengths.length() let i {
        # Partial accept: roll the verified branch back to the accepted
        # prefix — a view over the same pre-allocated buffers whose rows
        # past the accepted count are not part of the value (issue #77).
        let int kept ← (base_lengths.get(i) coalesce 0) + accepted_count

        do {
            committed.append(kv.prefix_view(verified.layers[i], kept))
        }
        catch err {
            throw variant config.GenerationError.DecodeFailure { message = err.message }
        }
    }

    return committed
}

# Public generate: config + prompt ids + the admitted decoder.
# Prefill produces the last-row logits; each later step is
# decode_data + sampling.sample. EOG ids come from GenerationConfig; the
# StopPolicy selects whether generation stops or suppresses those ids. The
# KV-wired loop is generate_dense.
# --- dense generation ----------------------------------------------------
@ public
class DenseEngine {
    mut dense.DenseConfig architecture
    mut f32 epsilon
    mut f32 scale
    mut int rope_dim
    mut rope.RopeConfig rope
}

@ public
fn construct_dense_engine(dense.DenseConfig architecture, f32 epsilon, f32 scale, int rope_dim, rope.RopeConfig rope) → DenseEngine {
    return DenseEngine { architecture = architecture, epsilon = epsilon, scale = scale, rope_dim = rope_dim, rope = rope }
}

@ public
fn default_dense_engine() → DenseEngine {
    return DenseEngine { architecture = dense.DenseConfig { layers = 0, heads = 0, kv_heads = 0, head_dim = 0, hidden_dim = 0, vocab = 0, tied = false }, epsilon = 0.0, scale = 0.0, rope_dim = 0, rope = rope.default() }
}

# Same loop as generate, over dense.decode_step and a per-layer KV cache.
# The model or artifact supplies the EOG ids through GenerationConfig.
# generate_dense_with_stop(IgnoreEos) suppresses EOG from sampling and
# runs to max_tokens — the U5 / llama.cpp ignore_eos row.
@ public
fn generate_dense(config.GenerationConfig g, list<int> prompt_ids, DenseEngine engine, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, list<kv.KVCache> layers, decode.Cancellation cancel) → list<int> ⇥ config.GenerationError {
    return generate_dense_with_stop(g, prompt_ids, engine, source, layers, cancel, decoder.eog_stop())
}

class DenseLoopState {
    mut list<kv.KVCache> state
    mut list<f32> last
    mut decoder.GenerationCursor cursor
    mut list<int> tokens
    mut list<int> history
    mut bool finished
}

fn consume_emitted_token(config.GenerationConfig g, DenseEngine engine, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, decoder.StopPolicy stop, int token, mut DenseLoopState loop) → void ⇥ config.GenerationError {
    loop.tokens.append(token)
    loop.history.append(token)
    loop.cursor ← decoder.cursor_advance(g, loop.cursor)

    if decoder.is_eog(g, token) and decoder.stops_on_eog(stop) {
        loop.finished ← true
    }
    elif decoder.token_allowed(g, loop.cursor) {
        let dense.DenseStep step ← dense_one(engine, source, token, loop.cursor.session.position - 1, loop.state)
        loop.last ← decoder.last_logits(step.logits, engine.architecture.vocab)
        loop.state ← step.layers
    }
    else {
        loop.finished ← true
    }
}

class StageOutcome {
    mut bool ok
    mut int next_token
}

fn try_stage_eog_prefix(config.GenerationConfig g, dense.DenseStep verified, list<int> verify_block, int eog_stop_at, mut DenseLoopState loop) → bool {
    let list<int> base_lengths ← layer_lengths(loop.state)
    let decoder.GenerationCursor start_cursor ← copy loop.cursor
    mut bool ok ← true

    do {
        let list<kv.KVCache> committed ← commit_dense_block(base_lengths, verified, verify_block, eog_stop_at)
        let decoder.GenerationCursor eog_cursor ← advance_n(g, start_cursor, eog_stop_at + 1)
        loop.state ← committed
        loop.cursor ← eog_cursor
    }
    catch err {
        ok ← false
    }

    if not ok {
        return false
    }

    for exclusive (eog_stop_at + 1) let i {
        let int accepted ← verify_block.get(i) coalesce (-1)
        loop.tokens.append(accepted)
        loop.history.append(accepted)
    }

    loop.finished ← true
    return true
}

fn try_stage_non_eog_prefix(config.GenerationConfig g, DenseEngine engine, decoder.StopPolicy stop, sampling.Config drawn, random.Seed step_rng, dense.DenseStep verified, list<int> verify_block, int accepted_count, mut DenseLoopState loop) → StageOutcome {
    let list<int> base_lengths ← layer_lengths(loop.state)
    let decoder.GenerationCursor start_cursor ← copy loop.cursor
    mut int next_tok ← 0
    mut bool ok ← true

    do {
        let int nt ← target_row_token(verified.logits, accepted_count - 1, engine.architecture.vocab, drawn, step_rng, g, stop)
        let list<kv.KVCache> committed ← commit_dense_block(base_lengths, verified, verify_block, accepted_count)
        let decoder.GenerationCursor staged_cursor ← advance_n(g, start_cursor, accepted_count)
        next_tok ← nt
        loop.state ← committed
        loop.cursor ← staged_cursor
    }
    catch err {
        ok ← false
    }

    if not ok {
        return StageOutcome { ok = false, next_token = 0 }
    }

    for exclusive accepted_count let i {
        let int accepted ← verify_block.get(i) coalesce (-1)
        loop.tokens.append(accepted)
        loop.history.append(accepted)
    }

    return StageOutcome { ok = true, next_token = next_tok }
}

fn plain_step(config.GenerationConfig g, DenseEngine engine, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, decoder.StopPolicy stop, sampling.Config drawn, mut random.Seed rng, mut DenseLoopState loop) → void ⇥ config.GenerationError {
    let sampling.Sampler outcome ← decoder.sample(decoder.sample_logits(loop.last, g, stop), drawn, loop.history, rng)
    let int next_token ← outcome.token_id
    rng ← outcome.seed
    consume_emitted_token(g, engine, source, stop, next_token, mut loop)
}

@ public
fn generate_dense_with_stop(config.GenerationConfig g, list<int> prompt_ids, DenseEngine engine, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, list<kv.KVCache> layers, decode.Cancellation cancel, decoder.StopPolicy stop) → list<int> ⇥ config.GenerationError {
    decoder.observe(cancel)

    require prompt_ids.length() ≥ 1 throw variant config.GenerationError.InvalidConfig { message = "needs at least one prompt token" }

    require prompt_ids.length() ≤ g.max_prompt throw variant config.GenerationError.InvalidConfig { message = "prompt length exceeds max_prompt" }

    require prompt_ids.length() ≺ g.context throw variant config.GenerationError.InvalidConfig { message = "prompt length does not fit context" }

    let string acceleration_mode ← config.acceleration_mode_name(g.acceleration.mode)

    if acceleration_mode ≢ "disabled" {
        if g.temperature ≻ 0.0 or g.top_k ≻ 0 or g.top_p ≻ 0.0 and g.top_p ≺ 1.0 or g.min_p ≻ 0.0 {
            throw variant config.GenerationError.SampledAccelerationRejected { message = "sampled acceleration is not supported" }
        }

        require acceleration_mode ≡ "context_lookup" throw variant config.GenerationError.InvalidConfig { message = "acceleration mode § is not supported on generate_dense; use draft_verify"(acceleration_mode) }
    }

    let sampling.Config drawn ← config.config(g)
    mut random.Seed rng ← config.seed(g)
    decoder.observe(cancel)
    let dense.DenseStep pref ← dense_prefill(engine, source, prompt_ids, layers)
    let list<f32> initial_last ← decoder.last_logits(pref.logits, engine.architecture.vocab)
    let decoder.GenerationCursor initial_cursor ← decoder.cursor_after_prompt(g, prompt_ids.length())
    mut DenseLoopState loop ← DenseLoopState { state = pref.layers, last = initial_last, cursor = initial_cursor, tokens = empty, history = empty, finished = false }

    while decoder.token_allowed(g, loop.cursor) and not loop.finished {
        decoder.observe(cancel)

        if acceleration_mode ≡ "disabled" {
            plain_step(g, engine, source, stop, drawn, mut rng, mut loop)
        }
        else {
            let int block_size ← g.acceleration.max_block
            let list<int> candidate_ids ← lookup_candidates(prompt_ids, loop.history, block_size)

            if candidate_ids.length() ≡ 0 {
                plain_step(g, engine, source, stop, drawn, mut rng, mut loop)
            }
            else {
                # `loop.last` holds the target distribution for position `L`, so
                # candidate 0 is verified against `loop.last` BEFORE running
                # `decode_block` on `verify_block` (whose logit row `r` predicts
                # position `L + 1 + r`).
                let sampling.Sampler first_outcome ← decoder.sample(decoder.sample_logits(loop.last, g, stop), drawn, loop.history, rng)
                let int first_target ← first_outcome.token_id
                let random.Seed first_seed ← first_outcome.seed
                let int c0 ← candidate_ids.get(0) coalesce (-1)
                let int remaining ← g.max_tokens - loop.cursor.emitted
                let int room_ctx ← g.context - 1 - loop.cursor.session.position

                if first_target ≢ c0 or (decoder.is_eog(g, first_target) and decoder.stops_on_eog(stop)) or remaining ≤ 1 or room_ctx ≤ 0 {
                    rng ← first_seed
                    consume_emitted_token(g, engine, source, stop, first_target, mut loop)
                }
                else {
                    mut int verify_count ← candidate_ids.length()

                    if verify_count ≻ remaining - 1 {
                        verify_count ← remaining - 1
                    }

                    if verify_count ≻ room_ctx {
                        verify_count ← room_ctx
                    }

                    mut list<int> verify_block ← empty

                    for exclusive verify_count let i {
                        verify_block.append(candidate_ids.get(i) coalesce (-1))
                    }

                    mut dense.DenseStep verified ← dense.default_step()
                    mut bool attempt_ok ← true

                    do {
                        verified ← dense.decode_block(engine.architecture, source, verify_block, engine.epsilon, engine.scale, engine.rope_dim, engine.rope, loop.state)
                    }
                    catch err {
                        attempt_ok ← false
                    }

                    if not attempt_ok {
                        rng ← first_seed
                        consume_emitted_token(g, engine, source, stop, first_target, mut loop)
                    }
                    else {
                        mut int accepted_count ← 1
                        mut int eog_stop_at ← 0 - 1
                        mut bool verify_ok ← true

                        do {
                            for exclusive (verify_count - 1) let row {
                                let int cand_next ← verify_block.get(row + 1) coalesce (-1)
                                let int pred_next ← target_row_token(verified.logits, row, engine.architecture.vocab, drawn, rng, g, stop)

                                if pred_next ≢ cand_next {
                                    break
                                }

                                accepted_count ← accepted_count + 1

                                if decoder.stops_on_eog(stop) and decoder.is_eog(g, cand_next) {
                                    eog_stop_at ← row + 1
                                    break
                                }
                            }
                        }
                        catch err {
                            verify_ok ← false
                        }

                        if not verify_ok {
                            rng ← first_seed
                            consume_emitted_token(g, engine, source, stop, first_target, mut loop)
                        }
                        elif eog_stop_at ≥ 0 {
                            let bool eog_ok ← try_stage_eog_prefix(g, verified, verify_block, eog_stop_at, mut loop)

                            if not eog_ok {
                                rng ← first_seed
                                consume_emitted_token(g, engine, source, stop, first_target, mut loop)
                            }
                        }
                        else {
                            # Row `accepted_count - 1` of `verified.logits` predicts the
                            # token right after `verify_block[accepted_count - 1]`:
                            # corrective when `accepted_count < verify_count`, or bonus
                            # when `accepted_count == verify_count`.
                            let StageOutcome stage ← try_stage_non_eog_prefix(g, engine, stop, drawn, rng, verified, verify_block, accepted_count, mut loop)

                            if not stage.ok {
                                rng ← first_seed
                                consume_emitted_token(g, engine, source, stop, first_target, mut loop)
                            }
                            else {
                                consume_emitted_token(g, engine, source, stop, stage.next_token, mut loop)
                            }
                        }
                    }
                }
            }
        }
    }

    return loop.tokens
}
