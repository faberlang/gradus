+++
locale = "en"
+++
# Co-located package test for calibration.fab (W5d-U1 — residual-energy
# bake). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * empty-corpus and zero-routing-expert fail closed with typed
#     messages
#   * a synthetic 4-expert corpus pins exact per-expert scores and the
#     K-recommendation curve (0.0 / 0.5 / 0.0 at K=0,1,2)
#   * the 256-expert synthetic rung produces 256 scores, the same
#     (K, r=0) curve, and recommended_k = 2
#   * 75e4ab98 provenance fields are present; verify accepts the claimed
#     digest and rejects a tampered one
#
# Oracle pins are exact f32 dyadic fractions. No executed value is
# claimed here (CTO Q2); the auditor-owned runtime-evidence gate compares
# executed values against these pins.
#
# `faber check src/calibration.proba` proves the suite type-checks.
# Library-to-library calls execute on the FMIR stepper (radix 43c0102ba;
# regression-locked by 2e8042ae7). This suite remains compile-level proof;
# no runtime value identity is claimed here.

import from "gradus:calibration" calibration

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
const string F_CORPUS ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
const string F_BASE ← "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
const string F_TAMPER ← "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"

# ---- helpers

fn act(int layer, int expert, f32 mass, list<f32> output) → calibration.RoutingActivation {
    return calibration.activation(layer, expert, mass, output)
}

fn four_expert() → list<calibration.RoutingActivation> {
    var list<calibration.RoutingActivation> rows ← empty
    rows.append(act(0, 0, 1.0, [1.0, 0.0]))
    rows.append(act(0, 1, 1.0, [1.0, 0.0]))
    rows.append(act(0, 2, 1.0, [0.0, 1.0]))
    rows.append(act(0, 3, 1.0, [0.0, 1.0]))
    return rows
}

fn rung_256() → list<calibration.RoutingActivation> {
    var list<calibration.RoutingActivation> rows ← empty
    var int e ← 0
    while e ≺ 256 {
        if e % 2 ≡ 0 {
            rows.append(act(0, e, 1.0, [1.0, 0.0]))
        }
        else {
            rows.append(act(0, e, 1.0, [0.0, 1.0]))
        }
        e ← e + 1
    }
    return rows
}

fn corpus_detail(list<calibration.RoutingActivation> rows, int layers, int experts, int dimension) → string {
    do {
        calibration.corpus(rows, layers, experts, dimension)
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn bake_detail(calibration.CalibrationCorpus c, list<list<f32>> bases, f32 threshold) → string {
    do {
        calibration.bake(c, bases, threshold, "sha-256", F_DIGEST, 64, F_CORPUS, F_BASE)
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn verify_detail(calibration.ResidualEnergyArtifact a, string expected) → string {
    do {
        calibration.verify(a, expected)
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn baked_four(f32 threshold) → calibration.ResidualEnergyArtifact {
    var calibration.ResidualEnergyArtifact a ← calibration.default()
    do {
        const calibration.CalibrationCorpus c ← calibration.corpus(four_expert(), 1, 4, 2)
        a ← calibration.bake(c, [[1.0, 0.0], [0.0, 1.0]], threshold, "sha-256", F_DIGEST, 64, F_CORPUS, F_BASE)
    }
    catch err {
        return a
    }
    return a
}

fn baked_256() → calibration.ResidualEnergyArtifact {
    var calibration.ResidualEnergyArtifact a ← calibration.default()
    do {
        const calibration.CalibrationCorpus c ← calibration.corpus(rung_256(), 1, 256, 2)
        a ← calibration.bake(c, [[1.0, 0.0], [0.0, 1.0]], 0.1, "sha-256", F_DIGEST, 64, F_CORPUS, F_BASE)
    }
    catch err {
        return a
    }
    return a
}

# ---- fail-closed negatives

test "an empty corpus fails closed" {
    const list<calibration.RoutingActivation> empty ← empty
    assert corpus_detail(empty, 1, 4, 2) ≡ "empty calibration corpus"
}

test "a zero-routing expert fails closed" {
    var list<calibration.RoutingActivation> rows ← empty
    rows.append(act(0, 0, 1.0, [1.0, 0.0]))
    rows.append(act(0, 1, 1.0, [0.0, 1.0]))
    rows.append(act(0, 2, 1.0, [1.0, 0.0]))
    # expert 3 is declared and never routed
    assert corpus_detail(rows, 1, 4, 2) ≡ "zero-routing expert"
}

# ---- synthetic 4-expert exact pins

test "the four-expert bake pins exact residual scores and the K curve" {
    const calibration.ResidualEnergyArtifact a ← baked_four(0.1)
    assert a.schema() ≡ "residual-energy/1.0.0"
    assert calibration.score_count(a) ≡ 4
    assert calibration.curve_count(a) ≡ 3
    assert a.recommended_k() ≡ 2
    assert a.threshold() ≡ 0.1 ∷ f32
    assert a.below_threshold() ≡ true
    # K=0 residual 1; K=1 residual 1/2; K=2 residual 0 — exact dyadics.
    assert calibration.curve_residual(a, 0) ≡ 1.0 ∷ f32
    assert calibration.curve_residual(a, 1) ≡ 0.5 ∷ f32
    assert calibration.curve_residual(a, 2) ≡ 0.0 ∷ f32
    # At recommended K=2 every expert is fully represented.
    assert calibration.score_residual(a, 0) ≡ 0.0 ∷ f32
    assert calibration.score_residual(a, 2) ≡ 0.0 ∷ f32
}

test "a looser threshold recommends K=1" {
    const calibration.ResidualEnergyArtifact a ← baked_four(0.5)
    assert a.recommended_k() ≡ 1
    assert a.below_threshold() ≡ true
    # Experts 0/1 live in the first basis; 2/3 are fully residual at K=1.
    assert calibration.score_residual(a, 0) ≡ 0.0 ∷ f32
    assert calibration.score_residual(a, 1) ≡ 0.0 ∷ f32
    assert calibration.score_residual(a, 2) ≡ 1.0 ∷ f32
    assert calibration.score_residual(a, 3) ≡ 1.0 ∷ f32
}

test "the overlap census pins aligned and orthogonal expert pairs" {
    const calibration.ResidualEnergyArtifact a ← baked_four(0.1)
    # Upper-triangle cells: (0,0), (0,1), (0,2), (0,3), (1,1), (1,2), (1,3),
    # (2,2), (2,3), (3,3) — 10 cells. (0,1) aligned, (0,2) orthogonal.
    assert calibration.similarity_count(a) ≡ 10
    assert calibration.similarity_cosine(a, 0) ≡ 1.0 ∷ f32
    assert calibration.similarity_cosine(a, 1) ≡ 1.0 ∷ f32
    assert calibration.similarity_cosine(a, 2) ≡ 0.0 ∷ f32
}

# ---- 256-expert synthetic rung (the §17 quality-gate artifact)

test "the 256-expert synthetic rung produces scores, the K curve, and recommended K=2" {
    const calibration.ResidualEnergyArtifact a ← baked_256()
    assert calibration.score_count(a) ≡ 256
    assert calibration.curve_count(a) ≡ 3
    assert a.recommended_k() ≡ 2
    assert a.below_threshold() ≡ true
    assert calibration.curve_residual(a, 0) ≡ 1.0 ∷ f32
    assert calibration.curve_residual(a, 1) ≡ 0.5 ∷ f32
    assert calibration.curve_residual(a, 2) ≡ 0.0 ∷ f32
    assert calibration.score_residual(a, 0) ≡ 0.0 ∷ f32
    assert calibration.score_residual(a, 1) ≡ 0.0 ∷ f32
}

# ---- 75e4ab98 provenance

test "provenance-manifest fields are present and verify accepts the claimed digest" {
    const calibration.ResidualEnergyArtifact a ← baked_four(0.1)
    assert a.provenance().algorithm() ≡ "sha-256"
    assert a.provenance().digest() ≡ F_DIGEST
    assert a.provenance().length() ≡ 64
    assert a.provenance().corpus_digest() ≡ F_CORPUS
    assert a.provenance().base_digest() ≡ F_BASE
    assert verify_detail(a, F_DIGEST) ≡ "ok"
}

test "a tampered digest is rejected at load" {
    const calibration.ResidualEnergyArtifact a ← baked_four(0.1)
    assert verify_detail(a, F_TAMPER) ≡ "digest mismatch — residual-energy artifact does not match the expected digest"
}

test "a malformed digest claim fails closed before the bake" {
    do {
        const calibration.CalibrationCorpus c ← calibration.corpus(four_expert(), 1, 4, 2)
        assert bake_detail(c, [[1.0, 0.0]], 0.1) ≡ "ok"
        calibration.bake(c, [[1.0, 0.0]], 0.1, "sha-256", "zz", 64, F_CORPUS, F_BASE)
        assert false
    }
    catch err {
        assert err.message ≡ "content digest must be 64 lower-case hexadecimal digits"
    }
}
