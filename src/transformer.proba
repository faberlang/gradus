# Dense-block error renderer: the typed error's causa on failure,
# "no error" otherwise (the block_detail pattern).
fn dense_detail(tensor.Tensor x, tensor.Tensor ln1_s, f32 eps, tensor.Tensor wq, tensor.Tensor bq, tensor.Tensor wk, tensor.Tensor bk, tensor.Tensor wv, tensor.Tensor bv, tensor.Tensor wo, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, attention.RopeConfig cfg, tensor.Tensor ln2_s, tensor.Tensor wg, tensor.Tensor bg, tensor.Tensor wu, tensor.Tensor bu, tensor.Tensor wd, tensor.Tensor bd) → string {
    do {
        const tensor.Tensor _ ← transformer.dense_block(x, ln1_s, eps, wq, bq, wk, bk, wv, bv, wo, num_heads, num_kv_heads, scale, positions, rope_dim, cfg, ln2_s, wg, bg, wu, bu, wd, bd)
        return "no error"
    }
    catch err {
        return transformer.message(err)
    }
}

describe "dense block — synthetic dim config vs the independent f64 reference" {
    test "block output matches the f64 evaluation of the documented formulas @ 5e-4" {
        do {
            const tensor.Tensor y ← transformer.dense_block(x, ln1_s, (0.00001 ∷ f32), wq, bq, wk, bk, wv, bv, wo, 4, 2, (0.5 ∷ f32), [0, 1], 4, rq_c, ln2_s, wg, bg, wu, bu, wd, bd)
            assert y.shape() ≡ [2, 16]
            assert dtype.name(y.dtype()) ≡ "f32"
            assert e2(y, 0, 0).approximata(B_0_0, TOLERATIO)
            assert e2(y, 0, 3).approximata(B_0_3, TOLERATIO)
            assert e2(y, 0, 7).approximata(B_0_7, TOLERATIO)
            assert e2(y, 0, 8).approximata(B_0_8, TOLERATIO)
            assert e2(y, 0, 10).approximata(B_0_10, TOLERATIO)
            assert e2(y, 0, 12).approximata(B_0_12, TOLERATIO)
            assert e2(y, 0, 15).approximata(B_0_15, TOLERATIO)
            assert e2(y, 1, 0).approximata(B_1_0, TOLERATIO)
            assert e2(y, 1, 3).approximata(B_1_3, TOLERATIO)
            assert e2(y, 1, 6).approximata(B_1_6, TOLERATIO)
            assert e2(y, 1, 9).approximata(B_1_9, TOLERATIO)
            assert e2(y, 1, 12).approximata(B_1_12, TOLERATIO)
            assert e2(y, 1, 14).approximata(B_1_14, TOLERATIO)
            assert e2(y, 1, 15).approximata(B_1_15, TOLERATIO)
        }
        catch err {
            assert false
        }
    }
}

describe "dense block — typed error contract" {
    test "rejects a non-f32 input (only the F32 row is admitted)" {
        assert dense_detail(tene_i32(DATA_X_RAW, [2, 16]), ln1_s, (0.00001 ∷ f32), wq, bq, wk, bk, wv, bv, wo, 4, 2, (0.5 ∷ f32), [0, 1], 4, rq_c, ln2_s, wg, bg, wu, bu, wd, bd) ≡ "dtype mismatch"
    }
    test "a rank-1 input fails closed (rmsnorm accepts rank >= 1, linear requires rank 2)" {
        assert dense_detail(tene(DATA_X1_RAW, [16]), ln1_s, (0.00001 ∷ f32), wq, bq, wk, bk, wv, bv, wo, 4, 2, (0.5 ∷ f32), [0, 1], 4, rq_c, ln2_s, wg, bg, wu, bu, wd, bd) ≡ "linear requires rank-2 input"
    }
    test "a GQA config with num_kv_heads > num_heads fails closed" {
        assert dense_detail(x, ln1_s, (0.00001 ∷ f32), wq, bq, wk, bk, wv, bv, wo, 4, 8, (0.5 ∷ f32), [0, 1], 4, rq_c, ln2_s, wg, bg, wu, bu, wd, bd) ≡ "num_kv_heads must not exceed num_heads"
    }
    test "an output projection with the wrong width fails closed" {
        assert dense_detail(x, ln1_s, (0.00001 ∷ f32), wq, bq, wk, bk, wv, bv, wo_small, 4, 2, (0.5 ∷ f32), [0, 1], 4, rq_c, ln2_s, wg, bg, wu, bu, wd, bd) ≡ "output projection must be [H*D, H*D]"
    }
    test "a negative RoPE position fails closed (the inference row)" {
        assert dense_detail(x, ln1_s, (0.00001 ∷ f32), wq, bq, wk, bk, wv, bv, wo, 4, 2, (0.5 ∷ f32), [0, 0 - 1], 4, rq_c, ln2_s, wg, bg, wu, bu, wd, bd) ≡ "negative position"
    }
}

describe "dense block — forward-only, autograd-independent" {
    test "the block composes bare — no autograd import, no gradient path" {
        do {
            const tensor.Tensor t ← transformer.dense_block(x, ln1_s, (0.00001 ∷ f32), wq, bq, wk, bk, wv, bv, wo, 4, 2, (0.5 ∷ f32), [0, 1], 4, rq_c, ln2_s, wg, bg, wu, bu, wd, bd)
            assert t.valid()
            assert t.shape() ≡ [2, 16]
            assert dtype.name(t.dtype()) ≡ "f32"
        }
        catch err {
            assert false
        }
    }
}
