+++
locale = "en"
+++
# Co-located package test for transformer.fab (PML3-U3 transformer block
# production surface). Not importable; discovered only by the faber test
# path.
#
# Proves, at compile level:
#   * the training row: transformer_block with modus 0 (plain scaled
#     dot-product attention) reproduces the accepted GPU-training proof —
#     the BERT-tiny fragment block (bert_tiny_block_2x8, bert-tiny-fragment
#     oracle intermediates.json step 0). The pinned ln3 values below ARE the
#     accepted proof's CPU-reference values for the fragment's exact initial
#     parameters and input (f64 stepper evaluation of the documented block
#     formulas). A fresh independent f64 evaluation of the documented
#     formulas (external Python) reproduces these pinned values exactly, and
#     the f32 block simulation matches within ~3e-7 — well inside the
#     documented 5e-4 tolerance.
#   * the selected inference row: transformer_block with modus 2 (causal
#     mask + RoPE — the scaled_dot_product_causal_rope composite shared by
#     training and inference, GI3 CausalMaskedSoftmax + Rope recipes) over
#     the same fragment parameters with positions [0,1] / dim 2. The pinned
#     ln3 values are the f64 evaluation of the documented formulas (external
#     Python), pinned within the same 5e-4 tolerance.
#   * the typed-error contract of the block (causa identity per validation),
#     including the block's own ModusInvalida gate and the mapped
#     nn/attention/math errors (text preserved).
#   * forward-only / autograd independence: the whole surface is exercised
#     with NO autograd import (no gradus:gradient, no @ radix backward, no
#     companion ABI) — the staged carrier carries plain values, and the
#     block is a pure value function.
#
# Numerics: the CPU reference evaluates the block formulas in f64 (FMIR
# stepper); this surface is f32 self-hosted (exp via potentia; sin/cos via
# range reduction + Taylor for RoPE; tanh via the e^{2t} identity for GELU;
# Newton sqrt for layernorm). Rows compare with a documented 5e-4 absolute
# tolerance (approximata), matching the nn.proba / attention.proba posture.
#
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
# Execution of proba bodies is env-blocked tree-wide today (FMIR stepper /
# library-import gap — recorded residual); this suite is the compile-level
# proof of the same contract.

import from "gradus:transformer" transformer
import from "gradus:attention" attention
import from "gradus:tensor" tensor
import from "gradus:dtype" dtype
import from "gradus:math" math

# Absolute tolerance for f32-vs-f64 comparison (the nn.proba posture).
const f32 TOLERATIO ← (0.0005 ∷ f32)

# ---- helpers (the attention.proba pattern)

# Build a staged tensor, swallowing the never-firing construction errors
# (test data is always valid; the cape fallback is unreachable).
fn tene(list<f32> datos, list<int> forma) → tensor.Tensor {
    var tensor.Tensor t ← tensor.default()
    do {
        t ← tensor.construct(datos, forma)
    }
    catch err {
        return t
    }
    return t
}

# Build an i32-tagged staged tensor (dtype-mismatch probes).
fn tene_i32(list<f32> datos, list<int> forma) → tensor.Tensor {
    var tensor.Tensor t ← tensor.default()
    do {
        t ← math.cast(tene(datos, forma), "i32")
    }
    catch err {
        return t
    }
    return t
}

# Validated consecutive-pair RopeConfigura (dense.proba config_p shape).
fn config_p() → attention.RopeConfig {
    var attention.RopeConfig c ← attention.default()
    do {
        c ← attention.construct_rope_config((100000.0 ∷ f32), (1.0 ∷ f32), attention.consecutive_policy())
        return c
    }
    catch err {
        return c
    }
    return c
}

# Staged-result element reads (swallow the never-firing access errors).
fn e2(tensor.Tensor r, int i, int j) → f32 {
    do {
        return r.get([i, j])
    }
    catch err {
        return (0.0 ∷ f32)
    }
}

# Block error renderer: the typed error's causa on failure, "no error"
# otherwise. The causa texts are the documented error identity.
fn block_detail(tensor.Tensor x, tensor.Tensor ln1_s, tensor.Tensor ln1_o, tensor.Tensor wq, tensor.Tensor bq, tensor.Tensor wk, tensor.Tensor bk, tensor.Tensor wv, tensor.Tensor bv, tensor.Tensor wo, tensor.Tensor bo, tensor.Tensor ln2_s, tensor.Tensor ln2_o, tensor.Tensor wf1, tensor.Tensor bf1, tensor.Tensor wf2, tensor.Tensor bf2, tensor.Tensor ln3_s, tensor.Tensor ln3_o, f32 scale, int modus, list<int> positions, int dim) → string {
    do {
        const tensor.Tensor _ ← transformer.transformer_block(x, ln1_s, ln1_o, wq, bq, wk, bk, wv, bv, wo, bo, ln2_s, ln2_o, wf1, bf1, wf2, bf2, ln3_s, ln3_o, scale, modus, positions, dim)
        return "no error"
    }
    catch err {
        return transformer.message(err)
    }
}

# The fragment's initial parameters (bert-tiny-fragment capture.txt,
