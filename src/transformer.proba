+++
locale = "en"
+++
# Co-located package test for transformer.fab (PML3-U3 transformer block
# production surface). Not importable; discovered only by the faber test
# path.
#
# Proves, at compile level:
#   * the training row: transformer_block with mode 0 (plain scaled
#     dot-product attention) over the BERT-tiny fragment parameters. Residual-2
#     is r1 + h2 (the residual stream, matching dense_block / llama GI2-1),
#     not the fragment's accepted ln2 + h2b. The pinned ln3 values are the
#     independent f64 evaluation of that documented composition (external
#     Python). GI2-1 is llama/SwiGLU, not a GELU model — these pins are this
#     row's own f64 of the same residual-stream structure.
#   * the selected inference row: transformer_block with mode 2 (causal
#     mask + RoPE — the scaled_dot_product_causal_rope composite shared by
#     training and inference, GI3 CausalMaskedSoftmax + Rope recipes) over
#     the same fragment parameters with positions [0,1] / dim 2. The pinned
#     ln3 values are the f64 evaluation of the documented formulas (external
#     Python), pinned within the same 5e-4 tolerance.
#   * the typed-error contract of the block (message identity per validation),
#     including the block's own InvalidMode gate and the mapped
#     nn/attention/math errors (text preserved).
#   * forward-only / autograd independence: the whole surface is exercised
#     with NO autograd import (no gradus:gradient, no @ radix backward, no
#     companion ABI) — the staged carrier carries plain values, and the
#     block is a pure value function.
#
# Numerics: the CPU reference evaluates the block formulas in f64 (FMIR
# stepper); this surface is f32 self-hosted (exp via power; sin/cos via
# range reduction + Taylor for RoPE; tanh via the e^{2t} identity for GELU;
# Newton sqrt for layernorm). Rows compare with a documented 5e-4 absolute
# tolerance (approx), matching the nn.proba / attention.proba posture.
#
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
# Library-to-library calls execute on the FMIR stepper (radix 43c0102ba;
# regression-locked by 2e8042ae7). This suite remains compile-level proof;
# no runtime value identity is claimed here.

import from "gradus:transformer" transformer
import from "gradus:attention" attention
import from "gradus:tensor" tensor
import from "gradus:dtype" dtype
import from "gradus:math" math

import from "gradus:test_util" test_util

# Absolute tolerance for f32-vs-f64 comparison (the nn.proba posture).
const f32 TOLERANCE ← (0.0005 ∷ f32)

# ---- helpers (the attention.proba pattern)

# Build a staged tensor, swallowing the never-firing construction errors
# (test data is always valid; the cape fallback is unreachable).
fn tene(list<f32> data, list<int> shape) → tensor.NumericBlock {
    return test_util.or_default(() → tensor.NumericBlock ⇥ tensor.TensorError ∴ tensor.construct(data, shape), tensor.default())
}

# Build an i32-tagged staged tensor (dtype-mismatch probes).
fn tene_i32(list<f32> data, list<int> shape) → tensor.NumericBlock {
    return test_util.or_default(() → tensor.NumericBlock ⇥ math.MathError ∴ math.cast(tene(data, shape), "i32"), tensor.default())
}

# Validated consecutive-pair RopeConfig (dense.proba config_p shape).
fn config_p() → attention.RopeConfig {
    return test_util.or_default(() → attention.RopeConfig ⇥ attention.AttentionError ∴ attention.construct_rope_config((100000.0 ∷ f32), (1.0 ∷ f32), attention.consecutive_policy()), attention.default())
}

# Staged-result element reads (swallow the never-firing access errors).
# BLOCKER (class 3, scalar narrowing): the success arm is the f32 element —
# narrowing a trap outcome to a scalar success type is blocked (routed
# N2/N4a), and the or_default closure form adds new SEM010 rows here
# (receiver-call closure wall). Kept on do/catch. Do not convert.
fn e2(tensor.NumericBlock r, int i, int j) → f32 {
    do {
        return r.get([i, j])
    }
    catch err {
        return (0.0 ∷ f32)
    }
}

# Block error renderer: the typed error's message on failure, "no error"
# otherwise. The message texts are the documented error identity.
fn block_detail(tensor.NumericBlock x, tensor.NumericBlock ln1_s, tensor.NumericBlock ln1_o, tensor.NumericBlock wq, tensor.NumericBlock bq, tensor.NumericBlock wk, tensor.NumericBlock bk, tensor.NumericBlock wv, tensor.NumericBlock bv, tensor.NumericBlock wo, tensor.NumericBlock bo, tensor.NumericBlock ln2_s, tensor.NumericBlock ln2_o, tensor.NumericBlock wf1, tensor.NumericBlock bf1, tensor.NumericBlock wf2, tensor.NumericBlock bf2, tensor.NumericBlock ln3_s, tensor.NumericBlock ln3_o, f32 scale, int mode, list<int> positions, int dim) → string {
    const _ outcome ← trap {
        transformer.transformer_block(x, ln1_s, ln1_o, wq, bq, wk, bk, wv, bv, wo, bo, ln2_s, ln2_o, wf1, bf1, wf2, bf2, ln3_s, ln3_o, scale, mode, positions, dim)
    }
    if outcome is tensor.NumericBlock {
        return "no error"
    }
    const transformer.TransformerError err ← outcome
    return err.message
}

# The fragment's initial parameters (bert-tiny-fragment capture.txt,
# initial_* — the accepted GPU-training proof's row). Per-channel biases.
const list<f32> DATA_X ← [0.5, -0.3, 1.2, -0.7, -0.4, 0.8, -1.0, 0.3, 0.7, -0.2, -0.6, 1.0, -0.9, 1.3, 0.1, -0.5]
