# Dense-block error renderer: the typed error's causa on failure,
# "no error" otherwise (the block_detail pattern).
functio dense_detail(
    tensor.Tensor x, tensor.Tensor ln1_s, f32 eps,
    tensor.Tensor wq, tensor.Tensor bq,
    tensor.Tensor wk, tensor.Tensor bk,
    tensor.Tensor wv, tensor.Tensor bv,
    tensor.Tensor wo, numerus num_heads, numerus num_kv_heads, f32 scale,
    lista<numerus> positions, numerus rope_dim, attention.RopeConfigura cfg,
    tensor.Tensor ln2_s,
    tensor.Tensor wg, tensor.Tensor bg,
    tensor.Tensor wu, tensor.Tensor bu,
    tensor.Tensor wd, tensor.Tensor bd
) → textus {
    fac {
        fixum tensor.Tensor _ ← transformer.dense_block(x, ln1_s, eps, wq, bq, wk, bk, wv, bv, wo, num_heads, num_kv_heads, scale, positions, rope_dim, cfg, ln2_s, wg, bg, wu, bu, wd, bd)
        redde "no error"
    }
    cape err {
        redde transformer.causa(err)
    }
}

probandum "dense block — synthetic dim config vs the independent f64 reference" {{
    proba "block output matches the f64 evaluation of the documented formulas @ 5e-4" {{
        fac {{
            fixum attention.RopeConfigura rq ← attention.structa_rope_configura((100000.0 ∷ f32), (1.0 ∷ f32), attention.politica_consecutiva())
            fixum tensor.Tensor y ← transformer.dense_block(
                x, ln1_s, (0.00001 ∷ f32),
                wq, bq, wk, bk, wv, bv, wo,
                4, 2, (0.5 ∷ f32), [0, 1], 4, rq,
                ln2_s, wg, bg, wu, bu, wd, bd)
            adfirma y.figura() ≡ [2, 16]
            adfirma dtype.nomen(y.typus()) ≡ "f32"
                        adfirma e2(y, 0, 0).approximata(B_0_0, TOLERATIO)
            adfirma e2(y, 0, 3).approximata(B_0_3, TOLERATIO)
            adfirma e2(y, 0, 7).approximata(B_0_7, TOLERATIO)
            adfirma e2(y, 0, 8).approximata(B_0_8, TOLERATIO)
            adfirma e2(y, 0, 10).approximata(B_0_10, TOLERATIO)
            adfirma e2(y, 0, 12).approximata(B_0_12, TOLERATIO)
            adfirma e2(y, 0, 15).approximata(B_0_15, TOLERATIO)
            adfirma e2(y, 1, 0).approximata(B_1_0, TOLERATIO)
            adfirma e2(y, 1, 3).approximata(B_1_3, TOLERATIO)
            adfirma e2(y, 1, 6).approximata(B_1_6, TOLERATIO)
            adfirma e2(y, 1, 9).approximata(B_1_9, TOLERATIO)
            adfirma e2(y, 1, 12).approximata(B_1_12, TOLERATIO)
            adfirma e2(y, 1, 14).approximata(B_1_14, TOLERATIO)
            adfirma e2(y, 1, 15).approximata(B_1_15, TOLERATIO)
        }}
        cape err {{
            adfirma falsum
        }}
    }}
}}

probandum "dense block — typed error contract" {{
    proba "rejects a non-f32 input (only the F32 row is admitted)" {{
        adfirma dense_detail(tene_i32(DATA_X_RAW, [2, 16]), ln1_s, (0.00001 ∷ f32), wq, bq, wk, bk, wv, bv, wo, 4, 2, (0.5 ∷ f32), [0, 1], 4, rq_c, ln2_s, wg, bg, wu, bu, wd, bd) ≡ "dtype mismatch"
    }}

    proba "a rank-1 input fails closed (rmsnorm accepts rank >= 1, linear requires rank 2)" {{
        adfirma dense_detail(tene(DATA_X1_RAW, [16]), ln1_s, (0.00001 ∷ f32), wq, bq, wk, bk, wv, bv, wo, 4, 2, (0.5 ∷ f32), [0, 1], 4, rq_c, ln2_s, wg, bg, wu, bu, wd, bd) ≡ "linear requires rank-2 input"
    }}

    proba "a GQA config with num_kv_heads > num_heads fails closed" {{
        adfirma dense_detail(x, ln1_s, (0.00001 ∷ f32), wq, bq, wk, bk, wv, bv, wo, 4, 8, (0.5 ∷ f32), [0, 1], 4, rq_c, ln2_s, wg, bg, wu, bu, wd, bd) ≡ "num_kv_heads must not exceed num_heads"
    }}

    proba "an output projection with the wrong width fails closed" {{
        adfirma dense_detail(x, ln1_s, (0.00001 ∷ f32), wq, bq, wk, bk, wv, bv, wo_small, 4, 2, (0.5 ∷ f32), [0, 1], 4, rq_c, ln2_s, wg, bg, wu, bu, wd, bd) ≡ "output projection must be [H*D, H*D]"
    }}

    proba "a negative RoPE position fails closed (the inference row)" {{
        adfirma dense_detail(x, ln1_s, (0.00001 ∷ f32), wq, bq, wk, bk, wv, bv, wo, 4, 2, (0.5 ∷ f32), [0, 0 - 1], 4, rq_c, ln2_s, wg, bg, wu, bu, wd, bd) ≡ "negative position"
    }}
}}

probandum "dense block — forward-only, autograd-independent" {{
    proba "the block composes bare — no autograd import, no gradient path" {{
        fac {{
            fixum attention.RopeConfigura rq ← attention.structa_rope_configura((100000.0 ∷ f32), (1.0 ∷ f32), attention.politica_consecutiva())
            fixum tensor.Tensor t ← transformer.dense_block(
                x, ln1_s, (0.00001 ∷ f32),
                wq, bq, wk, bk, wv, bv, wo,
                4, 2, (0.5 ∷ f32), [0, 1], 4, rq,
                ln2_s, wg, bg, wu, bu, wd, bd)
            adfirma t.valet()
            adfirma t.figura() ≡ [2, 16]
            adfirma dtype.nomen(t.typus()) ≡ "f32"
        }}
        cape err {{
            adfirma falsum
        }}
    }}
}}
