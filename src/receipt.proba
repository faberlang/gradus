+++
locale = "en"
+++
# Co-located package test for receipt.fab (SD0-U5 — versioned speculative
# decode evidence receipt). Not importable; discovered only by the faber test
# path.
#
# First-failing oracle: a receipt carrying throughput without an equivalence
# verdict is rejected before it can be serialized or reported.
#
# Proves:
#   * the receipt binds policy/version, block and acceptance counts, first
#     divergence, equivalence, timings, regime, backend, and cold/warm label;
#   * valid values round-trip through the versioned wire;
#   * regime and evidence labels are closed sets;
#   * unknown schema/version/backend/regime and malformed fields reject; and
#   * serialization re-validates a manually assembled invalid value.

import from "gradus:receipt" receipt

import from "gradus:test_util" test_util

fn detail(string policy, string policy_version, string regime, string backend, string warmth, int block_size, int accepted, int rejected, int divergence, string equivalence, f32 ttft, f32 throughput) → string {
    const _ outcome ← trap {
        receipt.construct_receipt(policy, policy_version, block_size, accepted, rejected, divergence, equivalence, ttft, throughput, backend, regime, warmth, 0, 0, (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32)
    }
    if outcome is receipt.Receipt {
        return "ok"
    }
    const receipt.ReceiptError err ← outcome
    return err.message
}

fn valid() → receipt.Receipt {
    return test_util.or_default(() → receipt.Receipt ⇥ receipt.ReceiptError ∴ receipt.construct_receipt("context_lookup", "1.0.0", 4, 3, 1, 2, "equivalent", 12.5 ∷ f32, 42.0 ∷ f32, "compiled", "context-reproduction", "cold", 4, 1, 0.75 ∷ f32, 0.25 ∷ f32, 3.0 ∷ f32), receipt.default())
}

fn roundtrip(receipt.Receipt r) → bool {
    # BLOCKER (class 3, scalar narrowing): bool result narrowing is blocked
    # (routed N2/N4a). Kept on do/catch. Do not convert.
    do {
        const string wire ← receipt.serialize_receipt(r)
        const receipt.Receipt back ← receipt.deserialize_receipt(wire)
        return receipt.receipt_equal(r, back)
    }
    catch err {
        return false
    }
}

describe "SD0-U5 — versioned receipt schema" {
    test "throughput without an equivalence verdict is the first typed reject" {
        assert detail("context_lookup", "1.0.0", "context-reproduction", "reference", "cold", 4, 3, 1, 2, "", (0.0 - 1.0) ∷ f32, 42.0 ∷ f32) ≡ "equivalence verdict is required when timing or throughput is present"
    }

    test "a no-timing receipt may omit the equivalence verdict" {
        const _ trap_result_1 ← trap {

            const receipt.Receipt r ← receipt.construct_receipt("disabled", "1.0.0", 1, 0, 0, 0 - 1, "", (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32, "reference", "ordinary-chat", "warm", 0, 0, (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32)
            assert r.policy ≡ "disabled"
            assert r.policy_version ≡ "1.0.0"
            assert r.block_size ≡ 1
            assert r.accepted ≡ 0
            assert r.rejected ≡ 0
            assert r.first_divergence ≡ (0 - 1)
            assert r.equivalence ≡ ""
            assert r.ttft ≡ (0.0 - 1.0) ∷ f32
            assert r.throughput ≡ (0.0 - 1.0) ∷ f32
            assert r.backend ≡ "reference"
            assert r.regime ≡ "ordinary-chat"
            assert r.warmth ≡ "warm"
            assert roundtrip(r)
        }
        assert trap_result_1 is void
    }

    test "a measured receipt binds timing to an equivalence verdict" {
        const _ trap_result_2 ← trap {

            const receipt.Receipt r ← receipt.construct_receipt("context_lookup", "1.0.0", 4, 3, 1, 2, "equivalent", 12.5 ∷ f32, 42.0 ∷ f32, "compiled", "context-reproduction", "cold", 4, 1, 0.75 ∷ f32, 0.25 ∷ f32, 3.0 ∷ f32)
            assert r.equivalence ≡ "equivalent"
            assert r.ttft ≡ 12.5 ∷ f32
            assert r.throughput ≡ 42.0 ∷ f32
            assert r.draft_length ≡ 4
            assert r.fallback_count ≡ 1
            assert r.acceptance_rate ≡ 0.75 ∷ f32
            assert r.fallback_rate ≡ 0.25 ∷ f32
            assert r.overhead ≡ 3.0 ∷ f32
            assert receipt.evidence(r) ≡ "compiled:cold"
            assert roundtrip(r)
        }
        assert trap_result_2 is void
    }

    test "the 1.1.0 wire carries the separate draft, rate, fallback, and overhead fields" {
        const _ trap_result_3 ← trap {

            const receipt.Receipt r ← receipt.construct_receipt("context_lookup", "1.0.0", 2, 1, 1, 1, "equivalent", (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32, "reference", "context-reproduction", "warm", 2, 0, 0.5 ∷ f32, 0.0 ∷ f32, (0.0 - 1.0) ∷ f32)
            const string wire ← receipt.serialize_receipt(r)
            assert wire ≡ "receipt/1.1.0/context_lookup/1.0.0/2/1/1/1/equivalent/-1/-1/reference/context-reproduction/warm/2/0/0.5/0/-1"
            const receipt.Receipt back ← receipt.deserialize_receipt(wire)
            assert back.draft_length ≡ 2
            assert back.fallback_count ≡ 0
            assert back.acceptance_rate ≡ 0.5 ∷ f32
            assert back.fallback_rate ≡ 0.0 ∷ f32
            assert back.overhead ≡ (0.0 - 1.0) ∷ f32
            assert receipt.receipt_equal(r, back)
        }
        assert trap_result_3 is void
    }

    test "legacy 1.0.0 wires decode with additive measurements absent" {
        const _ trap_result_4 ← trap {

            const receipt.Receipt r ← receipt.deserialize_receipt("receipt/1.0.0/disabled/1.0.0/1/0/0/-1//-1/-1/reference/ordinary-chat/cold")
            assert r.policy ≡ "disabled"
            assert r.draft_length ≡ 0
            assert r.fallback_count ≡ 0
            assert r.acceptance_rate ≡ (0.0 - 1.0) ∷ f32
            assert r.fallback_rate ≡ (0.0 - 1.0) ∷ f32
            assert r.overhead ≡ (0.0 - 1.0) ∷ f32
            assert receipt.serialize_receipt(r) ≡ "receipt/1.1.0/disabled/1.0.0/1/0/0/-1//-1/-1/reference/ordinary-chat/cold/0/0/-1/-1/-1"
        }
        assert trap_result_4 is void
    }

    test "all four backend labels and both thermal labels are admitted" {
        assert detail("disabled", "1.0.0", "ordinary-chat", "reference", "cold", 1, 0, 0, 0 - 1, "", (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32) ≡ "ok"
        assert detail("disabled", "1.0.0", "ordinary-chat", "compiled", "warm", 1, 0, 0, 0 - 1, "", (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32) ≡ "ok"
        assert detail("disabled", "1.0.0", "ordinary-chat", "metal", "cold", 1, 0, 0, 0 - 1, "", (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32) ≡ "ok"
        assert detail("disabled", "1.0.0", "ordinary-chat", "cuda", "warm", 1, 0, 0, 0 - 1, "", (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32) ≡ "ok"
    }

    test "unknown regime, backend, warmth, and policy version reject" {
        assert detail("disabled", "1.0.0", "replay", "reference", "cold", 1, 0, 0, 0 - 1, "", (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32) ≡ "unknown receipt regime"
        assert detail("disabled", "1.0.0", "ordinary-chat", "vulkan", "cold", 1, 0, 0, 0 - 1, "", (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32) ≡ "unknown receipt backend"
        assert detail("disabled", "1.0.0", "ordinary-chat", "reference", "hot", 1, 0, 0, 0 - 1, "", (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32) ≡ "unknown receipt evidence temperature"
        assert detail("disabled", "9.9.9", "ordinary-chat", "reference", "cold", 1, 0, 0, 0 - 1, "", (0.0 - 1.0) ∷ f32, (0.0 - 1.0) ∷ f32) ≡ "unknown acceleration policy version"
    }

    test "the versioned wire rejects unknown marker, schema, and fields" {
        const _ outcome_1 ← trap {
            receipt.deserialize_receipt("tensor/1.0.0/disabled/1.0.0/1/0/0/-1//-1/-1/reference/ordinary-chat/cold")
        }
        const receipt.ReceiptError err_1 ← outcome_1
        assert err_1.message ≡ "unknown receipt marker"
        const _ outcome_2 ← trap {
            receipt.deserialize_receipt("receipt/9.9.9/disabled/1.0.0/1/0/0/-1//-1/-1/reference/ordinary-chat/cold")
        }
        const receipt.ReceiptError err_2 ← outcome_2
        assert err_2.message ≡ "unknown receipt schema version"
        const _ outcome_3 ← trap {
            receipt.deserialize_receipt("receipt/1.0.0/disabled/1.0.0/1/0/0/-1//-1/-1/reference/ordinary-chat")
        }
        const receipt.ReceiptError err_3 ← outcome_3
        assert err_3.message ≡ "malformed receipt wire"
        const _ outcome_4 ← trap {
            receipt.deserialize_receipt("receipt/1.1.0/disabled/1.0.0/1/0/0/-1//-1/-1/reference/ordinary-chat/cold/0/0/-1/-1/-1/extra")
        }
        const receipt.ReceiptError err_4 ← outcome_4
        assert err_4.message ≡ "malformed receipt wire"
    }

    test "the wire rejects malformed numeric fields and throughput without verdict" {
        const _ outcome_1 ← trap {
            receipt.deserialize_receipt("receipt/1.0.0/disabled/1.0.0/nope/0/0/-1//-1/-1/reference/ordinary-chat/cold")
        }
        const receipt.ReceiptError err_1 ← outcome_1
        assert err_1.message ≡ "malformed block size in receipt wire"
        const _ outcome_2 ← trap {
            receipt.deserialize_receipt("receipt/1.0.0/disabled/1.0.0/1/0/0/-1//-1/42/reference/ordinary-chat/cold")
        }
        const receipt.ReceiptError err_2 ← outcome_2
        assert err_2.message ≡ "equivalence verdict is required when timing or throughput is present"
    }

    test "serialization fails closed for a manually assembled invalid value" {
        const _ outcome ← trap {
            receipt.serialize_receipt(receipt.Receipt {policy = "disabled", policy_version = "1.0.0", block_size = 1, accepted = 0, rejected = 0, first_divergence = (0 - 1), equivalence = "", ttft = (0.0 - 1.0) ∷ f32, throughput = 10.0 ∷ f32, backend = "reference", regime = "ordinary-chat", warmth = "cold", draft_length = 0, fallback_count = 0, acceptance_rate = (0.0 - 1.0) ∷ f32, fallback_rate = (0.0 - 1.0) ∷ f32, overhead = (0.0 - 1.0) ∷ f32})
        }
        const receipt.ReceiptError err ← outcome
        assert err.message ≡ "equivalence verdict is required when timing or throughput is present"
    }
}
