+++
locale = "en"
+++
# Co-located package test for math.fab (PML1-U4 pure operation families).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level, per family:
#   * elementwise — add/sub/mul/div (broadcast: equal shapes, vector, scalar)
#     and neg/abs/signum; result-tensor consistency (valid / shape / dtype via
#     dtype.name) and error identity (non-broadcastable, dtype mismatch).
#   * reduce — sum/mean over axis 0 / axis 1 with exact values; error
#     identity (axis out of range, rank-0, empty reduction axis).
#   * matmul — rank-2 x rank-2 with exact values; error identity (inner
#     dims, rank, dtype).
#   * cast — name-based cast with dtype change and shape preservation;
#     rounding, overflow (Overflow), non-finite (NonFinite), and unknown
#     name (UnknownName) — the dtype cast rules via math.message.
#   * concat/slice — concatenate along axis 0 / axis 1, slice bounds,
#     and error identity (dimension mismatch, empty list, dtype, bounds).
#
# Construction and every op fail through MathError (math.construct is the
# family construction entry), so each test fac block carries one error type
# (SEM010 rule). assert assertions run under the cargo-backed `faber test`
# harness (auditor-owned); `faber check` proves the whole surface type-checks.
#
# --- The Absolute/Signum arm of the PML4 executed lane --------------------
# The f32 `abs`/`signum` receivers were MASKED on the FMIR lane: the
# MIR validator arms accepted only the exact number/fractus primitives, so
# the SizedNumeric(Fractus, _) receivers this surface uses failed
# validation. The rounding-fixed precedent (radix d0c9708fa — the
# Round/Floor/Ceiling/Truncate arm) aligned that family first; the
# Absolute/Signum arm (radix 2df1af436) did the same for this pair. The
# signum cases below are the gradus-side coverage of that surface, pinned at
# compile level per this proba's convention. Library-to-library calls execute
# on the FMIR stepper (radix 43c0102ba; regression-locked by 2e8042ae7), but
# this proba does not claim runtime value identity.

import from "gradus:math" math

import from "gradus:tensor" tensor

import from "gradus:dtype" dtype

# -- helpers ---------------------------------------------------------------

# Element reads rendered as text (swallow the never-firing access errors).
# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.

fn elem1(tensor.NumericBlock r, int i) → string {
    do {
        const f32 v ← r.get([i])
        return v.to_text()
    }
    catch err {
        return "?"
    }
}

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.

fn elem2(tensor.NumericBlock r, int i, int j) → string {
    do {
        const f32 v ← r.get([i, j])
        return v.to_text()
    }
    catch err {
        return "?"
    }
}

# Scalar result read (rank-0 tensor) via the flat storage.
fn elem0(tensor.NumericBlock r) → string {
    return (r.data.get(0) coalesce 0.0 ∷ f32).to_text()
}

# Per-op error renderers: the typed error's message on failure, "no error"
# otherwise. The message texts are the documented error contract identity.
# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.

fn add_detail(tensor.NumericBlock a, tensor.NumericBlock b) → string {
    do {
        math.add_carrier(a, b)
        return "no error"
    }
    catch err {
        return err.message
    }
}

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.

fn sub_detail(tensor.NumericBlock a, tensor.NumericBlock b) → string {
    do {
        math.sub_carrier(a, b)
        return "no error"
    }
    catch err {
        return err.message
    }
}

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.

fn mul_detail(tensor.NumericBlock a, tensor.NumericBlock b) → string {
    do {
        math.mul_carrier(a, b)
        return "no error"
    }
    catch err {
        return err.message
    }
}

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.

fn div_detail(tensor.NumericBlock a, tensor.NumericBlock b) → string {
    do {
        math.div_carrier(a, b)
        return "no error"
    }
    catch err {
        return err.message
    }
}

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.

fn sum_detail(tensor.NumericBlock t, int axis) → string {
    do {
        math.sum(t, axis)
        return "no error"
    }
    catch err {
        return err.message
    }
}

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.

fn mean_detail(tensor.NumericBlock t, int axis) → string {
    do {
        math.mean(t, axis)
        return "no error"
    }
    catch err {
        return err.message
    }
}

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
# local value", MIR repair 2d5b7789 not landed). Kept on do/catch. Do not
# convert.

fn matmul_detail(tensor.NumericBlock a, tensor.NumericBlock b) → string {
    do {
        math.matmul(a, b)
        return "no error"
    }
    catch err {
        return err.message
    }
}

# BLOCKER (B, funnel 7ec5e484): renderer needs `if outcome is <qualified>`
# after trap — hard-blocked ("projection base that does not resolve to a
