+++
locale = "en"
+++
# Immutable all-layer KV checkpoint, private branch, acceptance decision, and transaction seam — SD1-U1..U5
# (kv-cache-branching).
#
# Public import: import from "gradus:cache_branch" cache_branch
#
# Depends on gradus:cache for KVCache values and the opaque CacheIdentity
# equality predicate. This leaf does not import dense, generation, or any
# device surface.
#
# --- Contract ------------------------------------------------------------
#
# KVCheckpoint is one all-layer snapshot of dense layer caches. Construction
# requires every layer at the same accepted prefix length, compatible
# existing identity under cache_identity_equal, and one shared generation.
# It records the prefix length, the identity value, the base version, and
# the ordered layer state. Mismatched lengths or identities reject typed
# before any checkpoint exists. Rejected construction does not write the
# inputs.
#
# Atomic commit constructs a fresh all-layer state from the checkpoint and
# an accepted branch prefix. Branch values and decisions are logical values
# only; no identity fields or identity wire are added here.

import from "gradus:cache" kv

import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

import from "gradus:speculative" speculative

# -------------------------------------------------------------------------
# BranchError — typed vocabulary of the checkpoint / branch surface.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------

@ public { }
union BranchError {
    @ shared
    string message

    @ conversion kv.CacheError err {
        match err {
            case kv.CacheError.Overflow const message {
                return variant CandidateOverflow {message = "candidate block exceeds cache capacity"}
            }
            case kv.CacheError.Gap const message {
                return variant CandidateGap {message = "candidate write leaves a gap in the base cache"}
            }
            case _ {
                return variant CandidateShapeMismatch {message = err.message}
            }
        }
    }

    EmptyLayers,
    PrefixMismatch,
    IdentityMismatch,
    CandidateEmpty,
    LayerCountMismatch,
    CandidateShapeMismatch,
    CandidateGap,
    CandidateOverflow,
    CandidateNumeric,
    StaleCheckpoint
}



# -------------------------------------------------------------------------
# KVCheckpoint — immutable all-layer cache snapshot.
# -------------------------------------------------------------------------

@ public { }
class KVCheckpoint {
    list<kv.KVCache> layers
    int prefix_length
    kv.CacheIdentity identity
    int version

    fn layers() → list<kv.KVCache> {
        return self.layers
    }

    fn prefix_length() → int {
        return self.prefix_length
    }

    fn identity() → kv.CacheIdentity {
        return self.identity
    }

    fn version() → int {
        return self.version
    }
}

# Placeholder for `var KVCheckpoint` bindings. Not a valid checkpoint.
@ public { }
fn default() → KVCheckpoint {
    return KVCheckpoint {layers = empty, prefix_length = 0, identity = kv.cache_identity(kv.default()), version = 0}
}

@ private { }
fn _copy_layers(list<kv.KVCache> layers) → list<kv.KVCache> {
    var list<kv.KVCache> out ← empty
    for from layers const layer {
        out.append(layer)
    }
    return out
}

# Every layer must share one prefix length (dense `_shared_prefix` shape,
# local so this leaf does not import the dense route).
@ private { }
fn _shared_prefix(list<kv.KVCache> layers) → int ⇥ BranchError {
    require layers.length() ≥ 1 throw variant EmptyLayers {message = "checkpoint requires at least one layer"}
    const kv.KVCache first ← layers.get(0) coalesce kv.default()
    const int prefix ← first.length()
    for from layers const layer {
        require layer.length() ≡ prefix throw variant PrefixMismatch {message = "layers do not share one accepted prefix"}
    }
    return prefix
}

# Value equality over prefix length, identity, generation, and layer state.
@ public { }
fn checkpoint_equal(KVCheckpoint a, KVCheckpoint b) → bool {
    if a.prefix_length() ≠ b.prefix_length() then return false
    if a.version() ≠ b.version() then return false
    if not kv.cache_identity_equal(a.identity(), b.identity()) then return false
    if a.layers().length() ≠ b.layers().length() then return false
    for range 0‥a.layers().length() const i {
        const kv.KVCache left ← a.layers().get(i) coalesce kv.default()
        const kv.KVCache right ← b.layers().get(i) coalesce kv.default()
        if not kv.cache_equal(left, right) then return false
    }
    return true
}

# -------------------------------------------------------------------------
# construct_checkpoint — admit an ordered layer set as one all-layer value.
# Length mismatch rejects before identity is compared so a short layer is
# a prefix error, not an identity error. Failed construction returns
# before any value exists.
# -------------------------------------------------------------------------

@ public { }
fn construct_checkpoint(list<kv.KVCache> layers) → KVCheckpoint ⇥ BranchError {
    const int prefix ← _shared_prefix(layers)
    const kv.KVCache first ← layers.get(0) coalesce kv.default()
    const kv.CacheIdentity identity ← kv.cache_identity(first)
    const int version ← first.version()
    for from layers const layer {
        require kv.cache_identity_equal(kv.cache_identity(layer), identity) throw variant IdentityMismatch {message = "layers do not share one cache identity"}
        require layer.version() ≡ version throw variant IdentityMismatch {message = "layers do not share one cache generation"}
    }
    return KVCheckpoint {layers = _copy_layers(layers), prefix_length = prefix, identity = identity, version = version}
}

# -------------------------------------------------------------------------
# BranchProvenance — target-position facts carried with one private branch.
# The target rows begin immediately after the checkpoint prefix and are
# ordered one-for-one with candidate_ids. No model or policy facts live here.
# -------------------------------------------------------------------------

@ public { }
class BranchProvenance {
    list<int> target_positions
    int layer_count
    int candidate_count

    fn target_positions() → list<int> {
        return self.target_positions
    }

    fn target_start() → int {
        return self.target_positions.get(0) coalesce 0
    }

    fn target_rows() → int {
        return self.target_positions.length()
    }

    fn layer_count() → int {
        return self.layer_count
    }

    fn candidate_count() → int {
        return self.candidate_count
    }
}

@ public { }
fn default_provenance() → BranchProvenance {
    return BranchProvenance {target_positions = empty, layer_count = 0, candidate_count = 0}
}

@ public { }
fn provenance_equal(BranchProvenance a, BranchProvenance b) → bool {
    if not (a.target_positions() ≡ b.target_positions()) then return false
    if a.layer_count() ≠ b.layer_count() then return false
    if a.candidate_count() ≠ b.candidate_count() then return false
    return true
}

@ private { }
fn _make_provenance(int prefix, int candidate_count, int layer_count) → BranchProvenance {
    var list<int> positions ← empty
    for range prefix‥(prefix + candidate_count) const position {
        positions.append(position)
    }
    return BranchProvenance {target_positions = positions, layer_count = layer_count, candidate_count = candidate_count}
}

# -------------------------------------------------------------------------
# SpeculativeBranch — an independent all-layer logical materialization.
# `layers` contains fresh cache values with the candidate rows appended;
# candidate_keys/payloads retain the fresh candidate tensors for later
# inspection and commit. The identity and version are those of the base
# checkpoint, never a new wire or a device handle.
# -------------------------------------------------------------------------

@ public { }
class SpeculativeBranch {
    list<kv.KVCache> layers
    list<int> candidate_ids
    list<tensor.NumericBlock> candidate_keys
    list<tensor.NumericBlock> candidate_payloads
    kv.CacheIdentity identity
    int base_prefix_length
    int base_version
    BranchProvenance provenance

    fn layers() → list<kv.KVCache> {
        return self.layers
    }

    fn candidate_ids() → list<int> {
        return self.candidate_ids
    }

    fn candidate_keys() → list<tensor.NumericBlock> {
        return self.candidate_keys
    }

    fn candidate_payloads() → list<tensor.NumericBlock> {
        return self.candidate_payloads
    }

    fn identity() → kv.CacheIdentity {
        return self.identity
    }

    fn base_prefix_length() → int {
        return self.base_prefix_length
    }

    fn base_version() → int {
        return self.base_version
    }

    fn candidate_count() → int {
        return self.candidate_ids.length()
    }

    fn provenance() → BranchProvenance {
        return self.provenance
    }
}

@ public { }
fn default_branch() → SpeculativeBranch {
    return SpeculativeBranch {layers = empty, candidate_ids = empty, candidate_keys = empty, candidate_payloads = empty, identity = kv.cache_identity(kv.default()), base_prefix_length = 0, base_version = 0, provenance = default_provenance()}
}

# -------------------------------------------------------------------------
# AcceptanceDecision — the typed, value-level result consumed by commit.
# The accepted count is copied from speculative.GreedyAcceptance; this leaf
# never compares target and candidate ids or recomputes divergence.
# -------------------------------------------------------------------------

@ public { }
class AcceptanceDecision {
    speculative.GreedyAcceptance acceptance
    int candidate_count
    int accepted_count
    int discarded_count
    kv.CacheIdentity identity
    int base_prefix_length
    int base_version
    list<int> target_positions

    fn acceptance() → speculative.GreedyAcceptance {
        return self.acceptance
    }

    fn candidate_count() → int {
        return self.candidate_count
    }

    fn accepted_count() → int {
        return self.accepted_count
    }

    fn discarded_count() → int {
        return self.discarded_count
    }

    fn identity() → kv.CacheIdentity {
        return self.identity
    }

    fn base_prefix_length() → int {
        return self.base_prefix_length
    }

    fn base_version() → int {
        return self.base_version
    }

    fn target_positions() → list<int> {
        return self.target_positions
    }

    fn target_start() → int {
        return self.target_positions.get(0) coalesce 0
    }

    fn target_rows() → int {
        return self.target_positions.length()
    }
}

@ public { }
fn default_decision() → AcceptanceDecision {
    return AcceptanceDecision {acceptance = speculative.default_acceptance(), candidate_count = 0, accepted_count = 0, discarded_count = 0, identity = kv.cache_identity(kv.default()), base_prefix_length = 0, base_version = 0, target_positions = empty}
}

@ public { }
fn decision_equal(AcceptanceDecision a, AcceptanceDecision b) → bool {
    if not speculative.acceptance_equal(a.acceptance(), b.acceptance()) then return false
    if a.candidate_count() ≠ b.candidate_count() then return false
    if a.accepted_count() ≠ b.accepted_count() then return false
    if a.discarded_count() ≠ b.discarded_count() then return false
    if not kv.cache_identity_equal(a.identity(), b.identity()) then return false
    if a.base_prefix_length() ≠ b.base_prefix_length() then return false
    if a.base_version() ≠ b.base_version() then return false
    return a.target_positions() ≡ b.target_positions()
}

# A local copy of cache.fab's row-count and _admit_write boundary. The cache
# module keeps those helpers private; matching the same checks here preserves
# the fail-before-extend rule without widening cache.fab's mutation surface.
@ private { }
fn _row_count(tensor.NumericBlock t) → int {
    if t.shape().length() ≺ 1 then return 0
    return t.shape().get(0) coalesce 0
}

@ private { }
fn _admit_base(kv.KVCache c, int added) → bool ⇥ BranchError {
    const int write_position ← c.length()
    require write_position ≡ _row_count(c.key()) throw variant CandidateGap {message = "candidate write leaves a gap in the base key"}
    require write_position ≡ _row_count(c.payload()) throw variant CandidateGap {message = "candidate write leaves a gap in the base payload"}
    require write_position + added ≤ c.capacity() throw variant CandidateOverflow {message = "candidate block exceeds cache capacity"}
    return true
}

@ private { }
fn _copy_tensor(tensor.NumericBlock source) → tensor.NumericBlock ⇥ BranchError {
    do {
        return tensor.construct(source.data, source.shape())
    }
    catch err {
        throw variant CandidateShapeMismatch {message = "candidate tensor is not a valid f32 value"}
    }
}

@ private { }
fn _candidate_values_finite(tensor.NumericBlock t) → bool ⇥ BranchError {
    require t.valid() throw variant CandidateShapeMismatch {message = "candidate tensor is not a valid f32 value"}
    for from t.data const value {
        require dtype.finite(value) throw variant CandidateNumeric {message = "candidate K/V values must be finite"}
    }
    return true
}

@ private { }
fn _check_candidate_tensor(tensor.NumericBlock t, int rows, int dimension) → bool ⇥ BranchError {
    require t.shape() ≡ ([rows, dimension] ↦ list<int>) throw variant CandidateShapeMismatch {message = "candidate K/V rows must be [k, dim]"}
    require dtype.name(t.dtype()) ≡ "f32" throw variant CandidateShapeMismatch {message = "candidate K/V dtype must be f32"}
    _candidate_values_finite(t)
    return true
}

@ private { }
fn _extend_one(kv.KVCache base, list<int> ids, tensor.NumericBlock key, tensor.NumericBlock payload) → kv.KVCache ⇥ BranchError {
    var kv.KVCache out ← kv.default()
    out ← kv.extend(base, ids, key, payload)
    return out
}

# -------------------------------------------------------------------------
# construct_branch — materialize one bounded candidate block independently
# for every checkpoint layer. All validation completes before the first
# layer is extended. `construct_branch_with_identity` is the explicit form
# for callers that carry candidate provenance from another cache state.
# -------------------------------------------------------------------------

@ public { }
fn construct_branch(KVCheckpoint checkpoint, list<int> candidate_ids, list<tensor.NumericBlock> candidate_keys, list<tensor.NumericBlock> candidate_payloads) → SpeculativeBranch ⇥ BranchError {
    return construct_branch_with_identity(checkpoint, checkpoint.identity(), candidate_ids, candidate_keys, candidate_payloads)
}

@ public { }
fn construct_branch_with_identity(KVCheckpoint checkpoint, kv.CacheIdentity candidate_identity, list<int> candidate_ids, list<tensor.NumericBlock> candidate_keys, list<tensor.NumericBlock> candidate_payloads) → SpeculativeBranch ⇥ BranchError {
    require checkpoint.layers().length() ≥ 1 throw variant EmptyLayers {message = "branch requires a non-empty checkpoint"}
    require candidate_ids.length() ≥ 1 throw variant CandidateEmpty {message = "candidate block must not be empty"}
    require candidate_keys.length() ≡ checkpoint.layers().length() throw variant LayerCountMismatch {message = "candidate K layers do not match checkpoint layers"}
    require candidate_payloads.length() ≡ checkpoint.layers().length() throw variant LayerCountMismatch {message = "candidate V layers do not match checkpoint layers"}
    require kv.cache_identity_equal(candidate_identity, checkpoint.identity()) throw variant IdentityMismatch {message = "candidate identity does not match checkpoint identity"}

    const int candidate_count ← candidate_ids.length()
    for from candidate_ids const token_id {
        require token_id ≥ 0 throw variant CandidateNumeric {message = "candidate token id must be non-negative"}
    }

    for range 0‥checkpoint.layers().length() const i {
        const kv.KVCache base ← checkpoint.layers().get(i) coalesce kv.default()
        require kv.cache_identity_equal(kv.cache_identity(base), checkpoint.identity()) throw variant IdentityMismatch {message = "checkpoint layer identity does not match checkpoint identity"}
        require base.length() ≡ checkpoint.prefix_length() throw variant PrefixMismatch {message = "checkpoint layer prefix does not match checkpoint"}
        require base.version() ≡ checkpoint.version() throw variant IdentityMismatch {message = "checkpoint layer generation does not match checkpoint"}
        _admit_base(base, candidate_count)
        const tensor.NumericBlock key ← candidate_keys.get(i) coalesce tensor.default()
        const tensor.NumericBlock payload ← candidate_payloads.get(i) coalesce tensor.default()
        _check_candidate_tensor(key, candidate_count, base.dimension())
        _check_candidate_tensor(payload, candidate_count, base.dimension())
    }

    var list<kv.KVCache> branch_layers ← empty
    var list<tensor.NumericBlock> branch_keys ← empty
    var list<tensor.NumericBlock> branch_payloads ← empty
    for range 0‥checkpoint.layers().length() const i {
        const kv.KVCache base ← checkpoint.layers().get(i) coalesce kv.default()
        const tensor.NumericBlock key ← candidate_keys.get(i) coalesce tensor.default()
        const tensor.NumericBlock payload ← candidate_payloads.get(i) coalesce tensor.default()
        branch_layers.append(_extend_one(base, candidate_ids, key, payload))
        branch_keys.append(_copy_tensor(key))
        branch_payloads.append(_copy_tensor(payload))
    }

    const BranchProvenance provenance ← _make_provenance(checkpoint.prefix_length(), candidate_count, checkpoint.layers().length())
    return SpeculativeBranch {layers = branch_layers, candidate_ids = candidate_ids, candidate_keys = branch_keys, candidate_payloads = branch_payloads, identity = checkpoint.identity(), base_prefix_length = checkpoint.prefix_length(), base_version = checkpoint.version(), provenance = provenance}
}

# -------------------------------------------------------------------------
# construct_decision — wrap one SD0 greedy result for the candidate branch.
# The range check happens before any identity or layer fact is read. The
# imported GreedyAcceptance remains the sole authority for accepted count.
# -------------------------------------------------------------------------

@ public { }
fn construct_decision(SpeculativeBranch branch, speculative.GreedyAcceptance acceptance) → AcceptanceDecision ⇥ BranchError {
    const int candidate_count ← branch.candidate_count()
    const int accepted_count ← acceptance.accepted_prefix_length()
    require accepted_count ≥ 0 and accepted_count ≤ candidate_count throw variant CandidateNumeric {message = "accepted prefix count is outside candidate block"}
    const int discarded_count ← candidate_count - accepted_count
    return AcceptanceDecision {acceptance = acceptance, candidate_count = candidate_count, accepted_count = accepted_count, discarded_count = discarded_count, identity = branch.identity(), base_prefix_length = branch.base_prefix_length(), base_version = branch.base_version(), target_positions = branch.provenance().target_positions()}
}

# -------------------------------------------------------------------------
# Atomic all-layer prefix commit.
# Every validation runs before a layer is extended. The committed values are
# local functional values; the checkpoint and branch remain unchanged even
# when a later construction step rejects.
# -------------------------------------------------------------------------

@ private { }
fn _prefix_ids(list<int> ids, int count) → list<int> {
    var list<int> out ← empty
    for range 0‥count const i {
        out.append(ids.get(i) coalesce 0)
    }
    return out
}

@ private { }
fn _prefix_tensor(tensor.NumericBlock source, int rows, int dimension) → tensor.NumericBlock ⇥ BranchError {
    var list<f32> data ← empty
    for range 0‥(rows * dimension) const i {
        data.append(source.data.get(i) coalesce 0.0 ∷ f32)
    }
    do {
        return tensor.construct(data, [rows, dimension])
    }
    catch err {
        throw variant CandidateShapeMismatch {message = "accepted candidate rows are not a valid f32 value"}
    }
}

@ private { }
fn _validate_commit(KVCheckpoint checkpoint, SpeculativeBranch branch, int accepted_count) → bool ⇥ BranchError {
    # Read and range-check n before touching checkpoint state. This keeps an
    # invalid caller count a typed reject with no state contact.
    const int candidate_count ← branch.candidate_count()
    require accepted_count ≥ 0 and accepted_count ≤ candidate_count throw variant CandidateNumeric {message = "accepted prefix count is outside candidate block"}

    require checkpoint.layers().length() ≥ 1 throw variant EmptyLayers {message = "commit requires a non-empty checkpoint"}
    require branch.layers().length() ≡ checkpoint.layers().length() throw variant LayerCountMismatch {message = "branch layers do not match checkpoint layers"}
    require branch.candidate_keys().length() ≡ checkpoint.layers().length() throw variant LayerCountMismatch {message = "branch candidate K layers do not match checkpoint layers"}
    require branch.candidate_payloads().length() ≡ checkpoint.layers().length() throw variant LayerCountMismatch {message = "branch candidate V layers do not match checkpoint layers"}
    require kv.cache_identity_equal(branch.identity(), checkpoint.identity()) throw variant IdentityMismatch {message = "branch identity does not match checkpoint identity"}
    require branch.base_prefix_length() ≡ checkpoint.prefix_length() throw variant PrefixMismatch {message = "branch base prefix does not match checkpoint"}
    require branch.base_version() ≡ checkpoint.version() throw variant IdentityMismatch {message = "branch base generation does not match checkpoint"}
    require branch.provenance().layer_count() ≡ checkpoint.layers().length() throw variant LayerCountMismatch {message = "branch provenance layers do not match checkpoint layers"}
    require branch.provenance().candidate_count() ≡ candidate_count throw variant CandidateNumeric {message = "branch provenance does not match candidate block"}
    require branch.provenance().target_rows() ≡ candidate_count throw variant CandidateNumeric {message = "branch target rows do not match candidate block"}

    for range 0‥candidate_count const i {
        const int token_id ← branch.candidate_ids().get(i) coalesce 0
        require token_id ≥ 0 throw variant CandidateNumeric {message = "candidate token id must be non-negative"}
    }

    for range 0‥checkpoint.layers().length() const i {
        const kv.KVCache base ← checkpoint.layers().get(i) coalesce kv.default()
        require kv.cache_identity_equal(kv.cache_identity(base), checkpoint.identity()) throw variant IdentityMismatch {message = "checkpoint layer identity does not match checkpoint identity"}
        require base.length() ≡ checkpoint.prefix_length() throw variant PrefixMismatch {message = "checkpoint layer prefix does not match checkpoint"}
        require base.version() ≡ checkpoint.version() throw variant IdentityMismatch {message = "checkpoint layer generation does not match checkpoint"}
        _admit_base(base, accepted_count)
        const tensor.NumericBlock key ← branch.candidate_keys().get(i) coalesce tensor.default()
        const tensor.NumericBlock payload ← branch.candidate_payloads().get(i) coalesce tensor.default()
        _check_candidate_tensor(key, candidate_count, base.dimension())
        _check_candidate_tensor(payload, candidate_count, base.dimension())
    }
    return true
}

@ public { }
fn commit(KVCheckpoint checkpoint, SpeculativeBranch branch, int accepted_count) → KVCheckpoint ⇥ BranchError {
    _validate_commit(checkpoint, branch, accepted_count)
    if accepted_count ≡ 0 {
        return checkpoint
    }

    const list<int> accepted_ids ← _prefix_ids(branch.candidate_ids(), accepted_count)
    var list<kv.KVCache> committed_layers ← empty
    for range 0‥checkpoint.layers().length() const i {
        const kv.KVCache base ← checkpoint.layers().get(i) coalesce kv.default()
        const tensor.NumericBlock candidate_key ← branch.candidate_keys().get(i) coalesce tensor.default()
        const tensor.NumericBlock candidate_payload ← branch.candidate_payloads().get(i) coalesce tensor.default()
        const tensor.NumericBlock accepted_key ← _prefix_tensor(candidate_key, accepted_count, base.dimension())
        const tensor.NumericBlock accepted_payload ← _prefix_tensor(candidate_payload, accepted_count, base.dimension())
        committed_layers.append(_extend_one(base, accepted_ids, accepted_key, accepted_payload))
    }

    # construct_checkpoint performs the final all-layer equality check and
    # publishes no state until every fresh layer value exists.
    return construct_checkpoint(committed_layers)
}

# -------------------------------------------------------------------------
# Device-neutral consumer transaction seam (SD1-U5).
# CandidateBlock is the value-level input block. BranchHandle owns only the
# immutable checkpoint and private branch values; it has no device handle,
# policy, scheduler, or mutable state.
# -------------------------------------------------------------------------

@ public { }
class CandidateBlock {
    list<int> candidate_ids
    list<tensor.NumericBlock> candidate_keys
    list<tensor.NumericBlock> candidate_payloads

    fn candidate_ids() → list<int> {
        return self.candidate_ids
    }

    fn candidate_keys() → list<tensor.NumericBlock> {
        return self.candidate_keys
    }

    fn candidate_payloads() → list<tensor.NumericBlock> {
        return self.candidate_payloads
    }
}

@ public { }
fn default_block() → CandidateBlock {
    return CandidateBlock {candidate_ids = empty, candidate_keys = empty, candidate_payloads = empty}
}

@ public { }
fn construct_block(list<int> candidate_ids, list<tensor.NumericBlock> candidate_keys, list<tensor.NumericBlock> candidate_payloads) → CandidateBlock {
    return CandidateBlock {candidate_ids = candidate_ids, candidate_keys = candidate_keys, candidate_payloads = candidate_payloads}
}

@ public { }
class BranchHandle {
    KVCheckpoint checkpoint
    SpeculativeBranch branch

    fn checkpoint() → KVCheckpoint {
        return self.checkpoint
    }

    fn branch() → SpeculativeBranch {
        return self.branch
    }

    fn candidate_count() → int {
        return self.branch.candidate_count()
    }

    fn base_version() → int {
        return self.checkpoint.version()
    }
}

@ public { }
fn default_handle() → BranchHandle {
    return BranchHandle {checkpoint = default(), branch = default_branch()}
}

# Begin materializes the private branch through the U2 constructor. The
# checkpoint is copied as a value into the handle and remains unchanged.
@ public { }
fn begin(KVCheckpoint checkpoint, CandidateBlock block) → BranchHandle ⇥ BranchError {
    const SpeculativeBranch branch ← construct_branch(checkpoint, block.candidate_ids(), block.candidate_keys(), block.candidate_payloads())
    return BranchHandle {checkpoint = checkpoint, branch = branch}
}

# Inspect wraps the caller's landed greedy acceptance through the U3 result.
# This seam reports decision facts but does not implement policy or logits.
@ public { }
fn inspect(BranchHandle handle, speculative.GreedyAcceptance acceptance) → AcceptanceDecision ⇥ BranchError {
    return construct_decision(handle.branch(), acceptance)
}

# A value-level abort discards the private branch by returning its unchanged
# base checkpoint. There is no mutable handle to invalidate.
@ public { }
fn abort(BranchHandle handle) → KVCheckpoint {
    return handle.checkpoint()
}

@ private { }
fn _validate_current(KVCheckpoint current, BranchHandle handle) → bool ⇥ BranchError {
    require checkpoint_equal(current, handle.checkpoint()) throw variant StaleCheckpoint {message = "transaction checkpoint is stale"}
    return true
}

# Commit a handle only against the current state from which it began. A
# later all-layer commit changes the version and value, so an older handle is
# rejected before U4 can construct any new layer.
@ public { }
fn commit_transaction(KVCheckpoint current, BranchHandle handle, int accepted_count) → KVCheckpoint ⇥ BranchError {
    _validate_current(current, handle)
    return commit(handle.checkpoint(), handle.branch(), accepted_count)
}
