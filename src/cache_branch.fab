+++
locale = "en"
+++
# Immutable all-layer KV checkpoint — SD1-U1 (kv-cache-branching).
#
# Public import: import from "gradus:cache_branch" cache_branch
#
# Depends on gradus:cache for KVCache values and the opaque CacheIdentity
# equality predicate. This leaf does not import dense, generation, or any
# device surface.
#
# --- Contract ------------------------------------------------------------
#
# KVCheckpoint is one all-layer snapshot of dense layer caches. Construction
# requires every layer at the same accepted prefix length, compatible
# existing identity under cache_identity_equal, and one shared generation.
# It records the prefix length, the identity value, the base version, and
# the ordered layer state. Mismatched lengths or identities reject typed
# before any checkpoint exists. Rejected construction does not write the
# inputs.
#
# Branch materialization, acceptance decisions, and atomic commit are
# later units. No identity fields or identity wire are added here.

import from "gradus:cache" kv

# -------------------------------------------------------------------------
# BranchError — typed vocabulary of the checkpoint / branch surface.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------

@ public { }
union BranchError {
    EmptyLayers {
        string message
    },
    PrefixMismatch {
        string message
    },
    IdentityMismatch {
        string message
    }
}

@ public { }
fn message(BranchError e) → string {
    match e {
        case EmptyLayers const message {
            return message
        }
        case PrefixMismatch const message {
            return message
        }
        case IdentityMismatch const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# KVCheckpoint — immutable all-layer cache snapshot.
# -------------------------------------------------------------------------

@ public { }
class KVCheckpoint {
    list<kv.KVCache> layers
    int prefix_length
    kv.CacheIdentity identity
    int version

    fn layers() → list<kv.KVCache> {
        return self.layers
    }

    fn prefix_length() → int {
        return self.prefix_length
    }

    fn identity() → kv.CacheIdentity {
        return self.identity
    }

    fn version() → int {
        return self.version
    }
}

# Placeholder for `var KVCheckpoint` bindings. Not a valid checkpoint.
@ public { }
fn default() → KVCheckpoint {
    return KVCheckpoint {layers = empty, prefix_length = 0, identity = kv.cache_identity(kv.default()), version = 0}
}

@ private { }
fn _copy_layers(list<kv.KVCache> layers) → list<kv.KVCache> {
    var list<kv.KVCache> out ← empty
    for from layers const layer {
        out.append(layer)
    }
    return out
}

# Every layer must share one prefix length (dense `_shared_prefix` shape,
# local so this leaf does not import the dense route).
@ private { }
fn _shared_prefix(list<kv.KVCache> layers) → int ⇥ BranchError {
    require layers.length() ≥ 1 throw variant EmptyLayers {message = "checkpoint requires at least one layer"}
    const kv.KVCache first ← layers.get(0) coalesce kv.default()
    const int prefix ← first.length()
    for from layers const layer {
        require layer.length() ≡ prefix throw variant PrefixMismatch {message = "layers do not share one accepted prefix"}
    }
    return prefix
}

# Value equality over prefix length, identity, generation, and layer state.
@ public { }
fn checkpoint_equal(KVCheckpoint a, KVCheckpoint b) → bool {
    if a.prefix_length() ≠ b.prefix_length() then return false
    if a.version() ≠ b.version() then return false
    if not kv.cache_identity_equal(a.identity(), b.identity()) then return false
    if a.layers().length() ≠ b.layers().length() then return false
    for range 0‥a.layers().length() const i {
        const kv.KVCache left ← a.layers().get(i) coalesce kv.default()
        const kv.KVCache right ← b.layers().get(i) coalesce kv.default()
        if not kv.cache_equal(left, right) then return false
    }
    return true
}

# -------------------------------------------------------------------------
# construct_checkpoint — admit an ordered layer set as one all-layer value.
# Length mismatch rejects before identity is compared so a short layer is
# a prefix error, not an identity error. Failed construction returns
# before any value exists.
# -------------------------------------------------------------------------

@ public { }
fn construct_checkpoint(list<kv.KVCache> layers) → KVCheckpoint ⇥ BranchError {
    const int prefix ← _shared_prefix(layers)
    const kv.KVCache first ← layers.get(0) coalesce kv.default()
    const kv.CacheIdentity identity ← kv.cache_identity(first)
    const int version ← first.version()
    for from layers const layer {
        require kv.cache_identity_equal(kv.cache_identity(layer), identity) throw variant IdentityMismatch {message = "layers do not share one cache identity"}
        require layer.version() ≡ version throw variant IdentityMismatch {message = "layers do not share one cache generation"}
    }
    return KVCheckpoint {layers = _copy_layers(layers), prefix_length = prefix, identity = identity, version = version}
}
