+++
locale = "en"
+++
# KV-cache values and mutation rules — PML5-U2 (production inference
# computation layer; the campaign never-split unit).
#
# Public import: importa ex "gradus:cache" privata cache
# Depends on: gradus:dtype (tags/finita), gradus:tensor (value carrier).
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own device residency). This module holds no device handle and makes no
# performance claims.
#
# =========================================================================
# The KV-cache contract (pml5-delivery.md PML5-U2)
# =========================================================================
#
# --- The typed logical value ---------------------------------------------
# KVCache is the per-session key/value state the decode serves: one K/V
# pair per layer of the forward row (the gradus row is a single
# transformer block — stratorum = 1), each an [positions, dimensio] f32
# staged tensor, plus the exact token history (historia) and the
# identity fields (model / model version / execution config / tokenizer
# identity). No device handle, no physical residency.
#
# --- Declared mutation rules ---------------------------------------------
#   * Append per position (appende): extends the K/V by exactly ONE
#     position and the history by one token; strictly sequential — the
#     appended position is always the current history length (no gaps,
#     no duplicates, no reordering). Deterministic and pure.
#   * Generation tracking: versio is the cache's generation — the
#     mutation counter, starts at 1, bumps by 1 on every successful
#     append. Identity fields (model/version/config/tokenizer/stratorum/
#     dimensio) are stable across appends.
#   * Reset (redintegra): a fresh cache — the same identity fields, an
#     empty history and empty K/V, versio 1.
#
# --- Cache identity key (MD-A9 precedent) --------------------------------
# The cache's identity (IdentitasCache) is a typed record over the MD-A9
# key fields gradus owns: model, model version, execution configuration,
# tokenizer identity, exact token prefix/history, positions/RoPE facts,
# layer count, dtype, and layout. A versioned wire form round-trips the
# key exactly; identity equality is field-wise (the product repo / NGAB
# consume the exact key — never a second authority). The empty-prefix
# wire segment uses the documented sentinel "-".
#
# --- Evidence honesty (CTO Q2, hard) -------------------------------------
# This surface is the STRUCTURAL proof: the mutation rules and the
# identity-key facts are compile-validated and proven by the co-located
# proba. The append/readback arithmetic is exact concatenation (no
# rounding — pins are exact); the identity-key facts are exact textus/
# numerus pins. Executed VALUE identity is env-blocked tree-wide today
# (FMIR stepper / library-import gap — the PML4 closeout recorded both
# blockers; neither is fixed here). PML5-U2 is PARTIAL: value-identity is
# deferred to the auditor-owned runtime-evidence gate.
import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# CacheError — typed error vocabulary of the KV-cache surface.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------


@ public { }
union CacheError {
    NomenInane {
        string causa
    },
    IdExtra {
        string causa
    },
    FormaMismatch {
        string causa
    },
    TypoMismatch {
        string causa
    },
    DimensioInvalida {
        string causa
    },
    ElementaMismatch {
        string causa
    },
    VersioIgnota {
        string causa
    },
    WireMala {
        string causa
    }
}

@ public { }
fn causa(CacheError e) → string {
    match e {
        case NomenInane const causa {
            return causa
        }
        case IdExtra const causa {
            return causa
        }
        case FormaMismatch const causa {
            return causa
        }
        case TypoMismatch const causa {
            return causa
        }
        case DimensioInvalida const causa {
            return causa
        }
        case ElementaMismatch const causa {
            return causa
        }
        case VersioIgnota const causa {
            return causa
        }
        case WireMala const causa {
            return causa
        }
    }
}

# The cache's schema version (the identity wire form).
const string schema_versio ← "1.0.0"

# The canonical layout tag of the admitted row (the F32 staged carrier).
const string ORDINATIO_STAGED ← "staged"

# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# Staged-tensor construction (the never-firing shape check, re-mapped).
@ private { }
fn _tense(list<f32> datos, list<int> forma) → tensor.Tensor ⇥ CacheError {
    do {
        return tensor.structa(datos, forma)
    }
    catch err {
        throw variant ElementaMismatch {causa = tensor.causa(err)}
    }
    throw variant ElementaMismatch {causa = "unreachable"}
}

# List element access (the never-firing bounds check, re-mapped to the
# uninitialized fallback — callers validate lengths first).
@ private { }
fn _accipe(list<f32> datos, int i) → f32 {
    do {
        return datos.get(i)
    }
    catch err {
        return 0.0 - 999.0 ∷ f32
    }
    return 0.0 - 999.0 ∷ f32
}

# "/" and ";" are reserved in the identity wire fields (the U3 wire-safety
# rule).
@ private { }
fn _habeat_solidum(string s) → bool {
    var int i ← 0
    while i ≺ s.length() {
        if s.get(i) ≡ "/" or s.get(i) ≡ ";" then return true
        i ← i + 1
    }
    return false
}

@ private { }
fn _digitum(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _numerica(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _digitum(s.get(i)) then return false
        i ← i + 1
    }
    return true
}

# Tensor field-wise equality (figura + flat data).
@ private { }
fn _tensor_aequus(tensor.Tensor a, tensor.Tensor b) → bool {
    if not (a.figura() ≡ b.figura()) then return false
    if not (a.datos ≡ b.datos) then return false
    return true
}

# -------------------------------------------------------------------------
# KVCache — the typed logical value.
# -------------------------------------------------------------------------


@ public { }
class KVCache {
    string model
    string versio_modelis
    string configuratio
    string tokenizator
    list<int> historia
    int stratorum
    string typo
    string ordinatio
    tensor.Tensor clavis
    tensor.Tensor valor
    int versio
    int dimensio

    # Model name (identity).
    fn model() → string {
        return self.model
    }

    # Model version (identity).
    fn versio_modelis() → string {
        return self.versio_modelis
    }

    # Execution configuration tag (identity; carries the RoPE/scale facts).
    fn configuratio() → string {
        return self.configuratio
    }

    # Tokenizer identity (identity).
    fn tokenizator() → string {
        return self.tokenizator
    }

    # The exact token history (prefix) appended so far.
    fn historia() → list<int> {
        return self.historia
    }

    # Layer count of the forward row (the identity's layer field).
    fn stratorum() → int {
        return self.stratorum
    }

    # Element dtype nomen (identity; "f32" — the admitted row).
    fn typo() → string {
        return self.typo
    }

    # Layout tag (identity; "staged").
    fn ordinatio() → string {
        return self.ordinatio
    }

    # The cached K tensor [positions, dimensio].
    fn clavis() → tensor.Tensor {
        return self.clavis
    }

    # The cached V tensor [positions, dimensio].
    fn valor() → tensor.Tensor {
        return self.valor
    }

    # Generation (mutation counter: starts 1, bumps per append).
    fn versio() → int {
        return self.versio
    }

    # The cached feature width.
    fn dimensio() → int {
        return self.dimensio
    }

    # Cached position count (= the history length).
    fn longitudo() → int {
        return self.historia.length()
    }
}

# Field-wise cache equality — the determinism/round-trip predicate.
@ public { }
fn cache_aequus(KVCache a, KVCache b) → bool {
    if a.model() ≠ b.model() then return false
    if a.versio_modelis() ≠ b.versio_modelis() then return false
    if a.configuratio() ≠ b.configuratio() then return false
    if a.tokenizator() ≠ b.tokenizator() then return false
    if not (a.historia() ≡ b.historia()) then return false
    if a.stratorum() ≠ b.stratorum() then return false
    if a.typo() ≠ b.typo() then return false
    if a.ordinatio() ≠ b.ordinatio() then return false
    if not _tensor_aequus(a.clavis(), b.clavis()) then return false
    if not _tensor_aequus(a.valor(), b.valor()) then return false
    if a.versio() ≠ b.versio() then return false
    if a.dimensio() ≠ b.dimensio() then return false
    return true
}

# -------------------------------------------------------------------------
# cache_vacua — a fresh cache: the identity fields, an empty history, an
# empty K/V [0, dimensio], versio 1. Identity fields are non-empty and
# wire-safe (fail closed); the stratorum/dimensio are positive.
# -------------------------------------------------------------------------

@ public { }
fn cache_vacua(string model, string versio_modelis, string configuratio, string tokenizator, int stratorum, int dimensio) → KVCache ⇥ CacheError {
    if model.length() ≡ 0 {
        throw variant NomenInane {causa = "empty model name"}
    }
    if versio_modelis.length() ≡ 0 {
        throw variant NomenInane {causa = "empty model version"}
    }
    if configuratio.length() ≡ 0 {
        throw variant NomenInane {causa = "empty execution config"}
    }
    if tokenizator.length() ≡ 0 {
        throw variant NomenInane {causa = "empty tokenizer identity"}
    }
    if ((_habeat_solidum(model) or _habeat_solidum(versio_modelis)) or _habeat_solidum(configuratio)) or _habeat_solidum(tokenizator) {
        throw variant NomenInane {causa = "reserved wire character in identity"}
    }
    if stratorum ≺ 1 {
        throw variant DimensioInvalida {causa = "layer count must be at least one"}
    }
    if dimensio ≺ 1 {
        throw variant DimensioInvalida {causa = "embedding dimension must be at least one"}
    }
    const tensor.Tensor clavis ← _tense([], [0, dimensio])
    const tensor.Tensor valor ← _tense([], [0, dimensio])
    return KVCache {model = model, versio_modelis = versio_modelis, configuratio = configuratio, tokenizator = tokenizator, historia = vacua, stratorum = stratorum, typo = "f32", ordinatio = ORDINATIO_STAGED, clavis = clavis, valor = valor, versio = 1, dimensio = dimensio}
}

# -------------------------------------------------------------------------
# appende — the ONE mutation: extend the cache by exactly one position.
# The token joins the exact history; the [1, dimensio] f32 K/V extends
# each cached tensor; the generation bumps by 1. Strictly sequential —
# the appended position is always the current history length (no gaps,
# no duplicates). Deterministic and pure.
# -------------------------------------------------------------------------

@ public { }
fn appende(KVCache c, int token_id, tensor.Tensor clavis, tensor.Tensor valor) → KVCache ⇥ CacheError {
    if token_id ≺ 0 {
        throw variant IdExtra {causa = "token id must be non-negative"}
    }
    if not (clavis.figura() ≡ [1, c.dimensio()]) {
        throw variant FormaMismatch {causa = "K must be [1, dim]"}
    }
    if not (valor.figura() ≡ [1, c.dimensio()]) {
        throw variant FormaMismatch {causa = "V must be [1, dim]"}
    }
    if dtype.nomen(clavis.typus()) ≠ "f32" {
        throw variant TypoMismatch {causa = "unsupported dtype for cache"}
    }
    if dtype.nomen(valor.typus()) ≠ "f32" {
        throw variant TypoMismatch {causa = "unsupported dtype for cache"}
    }
    var list<int> novum_historia ← c.historia()
    novum_historia.append(token_id)
    var list<f32> nova_clavis ← vacua
    for from c.clavis().datos const v {
        nova_clavis.append(v)
    }
    for from clavis.datos const v {
        nova_clavis.append(v)
    }
    var list<f32> nova_valor ← vacua
    for from c.valor().datos const v {
        nova_valor.append(v)
    }
    for from valor.datos const v {
        nova_valor.append(v)
    }
    const int novus ← c.longitudo() + 1
    return KVCache {model = c.model(), versio_modelis = c.versio_modelis(), configuratio = c.configuratio(), tokenizator = c.tokenizator(), historia = novum_historia, stratorum = c.stratorum(), typo = c.typo(), ordinatio = c.ordinatio(), clavis = _tense(nova_clavis, [novus, c.dimensio()]), valor = _tense(nova_valor, [novus, c.dimensio()]), versio = c.versio() + 1, dimensio = c.dimensio()}
}

# -------------------------------------------------------------------------
# redintegra — the reset rule: a fresh cache with the same identity
# fields, an empty history and empty K/V, versio 1 (fresh state).
# -------------------------------------------------------------------------

@ public { }
fn redintegra(KVCache c) → KVCache ⇥ CacheError {
    const tensor.Tensor clavis ← _tense([], [0, c.dimensio()])
    const tensor.Tensor valor ← _tense([], [0, c.dimensio()])
    return KVCache {model = c.model(), versio_modelis = c.versio_modelis(), configuratio = c.configuratio(), tokenizator = c.tokenizator(), historia = vacua, stratorum = c.stratorum(), typo = c.typo(), ordinatio = c.ordinatio(), clavis = clavis, valor = valor, versio = 1, dimensio = c.dimensio()}
}

# -------------------------------------------------------------------------
# IdentitasCache — the typed cache identity key (MD-A9 precedent). The
# fields gradus owns: model, model version, execution configuration,
# tokenizer identity, exact token prefix, positions/RoPE facts, layer
# count, dtype, layout. Field-wise equality; a versioned wire round-trip.
# -------------------------------------------------------------------------


@ public { }
class IdentitasCache {
    string model
    string versio_modelis
    string configuratio
    string tokenizator
    string historia
    string positio
    int stratorum
    string typo
    string ordinatio

    fn model() → string {
        return self.model
    }

    fn versio_modelis() → string {
        return self.versio_modelis
    }

    fn configuratio() → string {
        return self.configuratio
    }

    fn tokenizator() → string {
        return self.tokenizator
    }

    fn historia() → string {
        return self.historia
    }

    fn positio() → string {
        return self.positio
    }

    fn stratorum() → int {
        return self.stratorum
    }

    fn typo() → string {
        return self.typo
    }

    fn ordinatio() → string {
        return self.ordinatio
    }
}

# Field-wise identity equality — the key-reuse predicate.
@ public { }
fn identitas_cache_aequus(IdentitasCache a, IdentitasCache b) → bool {
    if a.model() ≠ b.model() then return false
    if a.versio_modelis() ≠ b.versio_modelis() then return false
    if a.configuratio() ≠ b.configuratio() then return false
    if a.tokenizator() ≠ b.tokenizator() then return false
    if a.historia() ≠ b.historia() then return false
    if a.positio() ≠ b.positio() then return false
    if a.stratorum() ≠ b.stratorum() then return false
    if a.typo() ≠ b.typo() then return false
    if a.ordinatio() ≠ b.ordinatio() then return false
    return true
}

# Derive the identity key from a cache state: the prefix is the
# comma-joined token history; the position span is "0..<count>".
@ public { }
fn identitas_cache(KVCache c) → IdentitasCache {
    var string historia ← ""
    for range 0‥c.historia().length() const i {
        if i ≻ 0 {
            historia ← historia + ","
        }
        historia ← historia + (c.historia().get(i) coalesce 0 ↦ string)
    }
    return IdentitasCache {model = c.model(), versio_modelis = c.versio_modelis(), configuratio = c.configuratio(), tokenizator = c.tokenizator(), historia = historia, positio = "0.." + (c.longitudo() ↦ string), stratorum = c.stratorum(), typo = c.typo(), ordinatio = c.ordinatio()}
}

# -------------------------------------------------------------------------
# Identity wire — versioned, exact round-trip. The empty-prefix segment
# uses the documented sentinel "-" (divide/split behavior must not depend
# on empty segments).
# -------------------------------------------------------------------------

@ public { }
fn serializa_identitas(IdentitasCache i) → string {
    var string historia ← i.historia()
    if historia.length() ≡ 0 {
        historia ← "-"
    }
    return (((((((((((((((((("cache/identity/" + schema_versio) + "/") + i.model()) + "/") + i.versio_modelis()) + "/") + i.configuratio()) + "/") + i.tokenizator()) + "/") + historia) + "/") + i.positio()) + "/") + (i.stratorum() ↦ string)) + "/") + i.typo()) + "/") + i.ordinatio()
}

@ public { }
fn deserializa_identitas(string wire) → IdentitasCache ⇥ CacheError {
    const list<string> partes ← wire.split("/")
    if partes.length() ≠ 12 {
        throw variant WireMala {causa = "malformed cache identity wire"}
    }
    if partes.get(0) coalesce "" ≠ "cache" {
        throw variant WireMala {causa = "unknown cache marker"}
    }
    if partes.get(1) coalesce "" ≠ "identity" {
        throw variant WireMala {causa = "unknown cache marker"}
    }
    if partes.get(2) coalesce "" ≠ schema_versio {
        throw variant VersioIgnota {causa = "unknown cache schema version"}
    }
    const string model ← partes.get(3) coalesce ""
    const string versio_modelis ← partes.get(4) coalesce ""
    const string configuratio ← partes.get(5) coalesce ""
    const string tokenizator ← partes.get(6) coalesce ""
    var string historia ← partes.get(7) coalesce ""
    const string positio ← partes.get(8) coalesce ""
    const string stratorum_textus ← partes.get(9) coalesce ""
    const string typo ← partes.get(10) coalesce ""
    const string ordinatio ← partes.get(11) coalesce ""
    if model.length() ≡ 0 {
        throw variant WireMala {causa = "empty model name in cache identity"}
    }
    if versio_modelis.length() ≡ 0 {
        throw variant WireMala {causa = "empty model version in cache identity"}
    }
    if configuratio.length() ≡ 0 {
        throw variant WireMala {causa = "empty execution config in cache identity"}
    }
    if tokenizator.length() ≡ 0 {
        throw variant WireMala {causa = "empty tokenizer identity in cache identity"}
    }
    if historia ≡ "-" {
        historia ← ""
    }
    if positio.length() ≡ 0 {
        throw variant WireMala {causa = "malformed position span in cache identity"}
    }
    if not _numerica(stratorum_textus) {
        throw variant WireMala {causa = "malformed layer count in cache identity"}
    }
    var int stratorum ← 0
    do {
        stratorum ← stratorum_textus ↦ int
    }
    catch err {
        throw variant WireMala {causa = "malformed layer count in cache identity"}
    }
    if stratorum ≺ 1 {
        throw variant WireMala {causa = "invalid layer count in cache identity"}
    }
    if typo.length() ≡ 0 {
        throw variant WireMala {causa = "empty dtype in cache identity"}
    }
    if ordinatio.length() ≡ 0 {
        throw variant WireMala {causa = "empty layout in cache identity"}
    }
    return IdentitasCache {model = model, versio_modelis = versio_modelis, configuratio = configuratio, tokenizator = tokenizator, historia = historia, positio = positio, stratorum = stratorum, typo = typo, ordinatio = ordinatio}
}
