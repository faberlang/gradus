+++
locale = "en"
+++
# KV-cache values and mutation rules — PML5-U2 (production inference
# computation layer; the campaign never-split unit). W2-U1 adds the
# KVStructure typed descriptor (per-layer-set structure, opened KV
# dtypes, v_layout, GQA sharing) beside the existing logical f32 cache.
#
# Public import: importa ex "gradus:cache" privata cache
# Depends on: gradus:dtype (tags/finita), gradus:tensor (value carrier).
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own device residency). This module holds no device handle and makes no
# performance claims.
#
# =========================================================================
# The KV-cache contract (pml5-delivery.md PML5-U2)
# =========================================================================
#
# --- The typed logical value ---------------------------------------------
# KVCache is the per-session key/value state the decode serves: one K/V
# pair per layer of the forward row (the gradus row is a single
# transformer block — stratorum = 1), each an [positions, dimensio] f32
# staged tensor, plus the exact token history (historia) and the
# identity fields (model / model version / execution config / tokenizer
# identity). No device handle, no physical residency.
#
# --- Declared mutation rules ---------------------------------------------
#   * Append per position (appende): extends the K/V by exactly ONE
#     position and the history by one token; strictly sequential — the
#     appended position is always the current history length (no gaps,
#     no duplicates, no reordering). Deterministic and pure.
#   * Generation tracking: versio is the cache's generation — the
#     mutation counter, starts at 1, bumps by 1 on every successful
#     append. Identity fields (model/version/config/tokenizer/stratorum/
#     dimensio) are stable across appends.
#   * Reset (redintegra): a fresh cache — the same identity fields, an
#     empty history and empty K/V, versio 1.
#
# --- Cache identity key (MD-A9 precedent) --------------------------------
# The cache's identity (IdentitasCache) is a typed record over the MD-A9
# key fields gradus owns: model, model version, execution configuration,
# tokenizer identity, exact token prefix/history, positions/RoPE facts,
# layer count, dtype, and layout. A versioned wire form round-trips the
# key exactly; identity equality is field-wise (the product repo / NGAB
# consume the exact key — never a second authority). The empty-prefix
# wire segment uses the documented sentinel "-".
#
# --- Evidence honesty (CTO Q2, hard) -------------------------------------
# This surface is the STRUCTURAL proof: the mutation rules and the
# identity-key facts are compile-validated and proven by the co-located
# proba. The append/readback arithmetic is exact concatenation (no
# rounding — pins are exact); the identity-key facts are exact textus/
# numerus pins. Executed VALUE identity is env-blocked tree-wide today
# (FMIR stepper / library-import gap — the PML4 closeout recorded both
# blockers; neither is fixed here). PML5-U2 is PARTIAL: value-identity is
# deferred to the auditor-owned runtime-evidence gate.
#
# --- KVStructure (W2-U1 + W5c-U8) ----------------------------------------
# Semantic descriptor lowered into plan facts and consumed as GI4
# KvCacheLayout. Per-layer-set cache class: Dense | SlidingWindow |
# CompressedHca {ratio in {4, 128}} | Indexer. kv_dtype_k/v from the
# opened set {F32, F16, Q8_0, Q4_K} (F16 default), v_layout linked to
# the attention family, Single | GqaShared. The indexer cache is its
# own partition class (IndexerBudget bytes), not a KvDtype. GI4 slots /
# context / reserve_policy facts stay; infeasible bundles fail closed
# here (quantized-V requires the flash-attention family; block size
# must divide the flattened KV width; indexer class requires its
# partition budget; HCA ratio is the admitted pair). Dense/SWA-only
# wires stay cache/structure/1.0.0. Additive HCA / Indexer / partition
# fields emit cache/structure/1.1.0. Does not widen cache/identity/1.0.0.
import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# CacheError — typed error vocabulary of the KV-cache surface.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------


@ public { }
union CacheError {
    NomenInane {
        string message
    },
    IdExtra {
        string message
    },
    FormaMismatch {
        string message
    },
    TypoMismatch {
        string message
    },
    DimensioInvalida {
        string message
    },
    ElementaMismatch {
        string message
    },
    VersioIgnota {
        string message
    },
    WireMala {
        string message
    },
    CombinatioInvalida {
        string message
    }
}

@ public { }
fn message(CacheError e) → string {
    match e {
        case NomenInane const message {
            return message
        }
        case IdExtra const message {
            return message
        }
        case FormaMismatch const message {
            return message
        }
        case TypoMismatch const message {
            return message
        }
        case DimensioInvalida const message {
            return message
        }
        case ElementaMismatch const message {
            return message
        }
        case VersioIgnota const message {
            return message
        }
        case WireMala const message {
            return message
        }
        case CombinatioInvalida const message {
            return message
        }
    }
}

# The cache's schema version (the identity wire form).
const string schema_versio ← "1.0.0"

# The canonical layout tag of the admitted row (the F32 staged carrier).
const string ORDINATIO_STAGED ← "staged"

# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# Staged-tensor construction (the never-firing shape check, re-mapped).
@ private { }
fn _tensor(list<f32> datos, list<int> forma) → tensor.Tensor ⇥ CacheError {
    do {
        return tensor.construct(datos, forma)
    }
    catch err {
        throw variant ElementaMismatch {message = tensor.message(err)}
    }
    throw variant ElementaMismatch {message = "unreachable"}
}

# List element access (the never-firing bounds check, re-mapped to the
# uninitialized fallback — callers validate lengths first).
@ private { }
fn _get(list<f32> datos, int i) → f32 {
    do {
        return datos.get(i)
    }
    catch err {
        return 0.0 - 999.0 ∷ f32
    }
    return 0.0 - 999.0 ∷ f32
}

# "/" and ";" are reserved in the identity wire fields (the U3 wire-safety
# rule).
@ private { }
fn _has_no_separator(string s) → bool {
    var int i ← 0
    while i ≺ s.length() {
        if s.get(i) ≡ "/" or s.get(i) ≡ ";" then return true
        i ← i + 1
    }
    return false
}

@ private { }
fn _digit(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _digit(s.get(i)) then return false
        i ← i + 1
    }
    return true
}

# Tensor field-wise equality (figura + flat data).
@ private { }
fn _tensor_equal(tensor.Tensor a, tensor.Tensor b) → bool {
    if not (a.shape() ≡ b.shape()) then return false
    if not (a.data ≡ b.data) then return false
    return true
}

# -------------------------------------------------------------------------
# KVCache — the typed logical value.
# -------------------------------------------------------------------------


@ public { }
class KVCache {
    string model
    string model_version
    string config
    string tokenizer
    list<int> history
    int layers
    string dtype
    string layout
    tensor.Tensor key
    tensor.Tensor payload
    int version
    int dimension

    # Model name (identity).
    fn model() → string {
        return self.model
    }

    # Model version (identity).
    fn model_version() → string {
        return self.model_version
    }

    # Execution configuration tag (identity; carries the RoPE/scale facts).
    fn config() → string {
        return self.config
    }

    # Tokenizer identity (identity).
    fn tokenizer() → string {
        return self.tokenizer
    }

    # The exact token history (prefix) appended so far.
    fn history() → list<int> {
        return self.history
    }

    # Layer count of the forward row (the identity's layer field).
    fn layers() → int {
        return self.layers
    }

    # Element dtype nomen (identity; "f32" — the admitted row).
    fn dtype() → string {
        return self.dtype
    }

    # Layout tag (identity; "staged").
    fn layout() → string {
        return self.layout
    }

    # The cached K tensor [positions, dimensio].
    fn key() → tensor.Tensor {
        return self.key
    }

    # The cached V tensor [positions, dimensio].
    fn payload() → tensor.Tensor {
        return self.payload
    }

    # Generation (mutation counter: starts 1, bumps per append).
    fn version() → int {
        return self.version
    }

    # The cached feature width.
    fn dimension() → int {
        return self.dimension
    }

    # Cached position count (= the history length).
    fn length() → int {
        return self.history.length()
    }
}

# Field-wise cache equality — the determinism/round-trip predicate.
@ public { }
fn cache_equal(KVCache a, KVCache b) → bool {
    if a.model() ≠ b.model() then return false
    if a.model_version() ≠ b.model_version() then return false
    if a.config() ≠ b.config() then return false
    if a.tokenizer() ≠ b.tokenizer() then return false
    if not (a.history() ≡ b.history()) then return false
    if a.layers() ≠ b.layers() then return false
    if a.dtype() ≠ b.dtype() then return false
    if a.layout() ≠ b.layout() then return false
    if not _tensor_equal(a.key(), b.key()) then return false
    if not _tensor_equal(a.payload(), b.payload()) then return false
    if a.version() ≠ b.version() then return false
    if a.dimension() ≠ b.dimension() then return false
    return true
}

# -------------------------------------------------------------------------
# cache_vacua — a fresh cache: the identity fields, an empty history, an
# empty K/V [0, dimensio], versio 1. Identity fields are non-empty and
# wire-safe (fail closed); the stratorum/dimensio are positive.
# -------------------------------------------------------------------------

@ public { }
fn empty_cache(string model, string model_version, string config, string tokenizer, int layers, int dimension) → KVCache ⇥ CacheError {
    if model.length() ≡ 0 {
        throw variant NomenInane {message = "empty model name"}
    }
    if model_version.length() ≡ 0 {
        throw variant NomenInane {message = "empty model version"}
    }
    if config.length() ≡ 0 {
        throw variant NomenInane {message = "empty execution config"}
    }
    if tokenizer.length() ≡ 0 {
        throw variant NomenInane {message = "empty tokenizer identity"}
    }
    if ((_has_no_separator(model) or _has_no_separator(model_version)) or _has_no_separator(config)) or _has_no_separator(tokenizer) {
        throw variant NomenInane {message = "reserved wire character in identity"}
    }
    if layers ≺ 1 {
        throw variant DimensioInvalida {message = "layer count must be at least one"}
    }
    if dimension ≺ 1 {
        throw variant DimensioInvalida {message = "embedding dimension must be at least one"}
    }
    const tensor.Tensor key ← _tensor([], [0, dimension])
    const tensor.Tensor payload ← _tensor([], [0, dimension])
    return KVCache {model = model, model_version = model_version, config = config, tokenizer = tokenizer, history = vacua, layers = layers, dtype = "f32", layout = "staged", key = key, payload = payload, version = 1, dimension = dimension}
}

# Placeholder Default for `var KVCache` bindings (varia on structs).
# Empty identity and empty staged payloads; not a valid cache.
@ public { }
fn default() → KVCache {
    const tensor.Tensor t ← tensor.default()
    return KVCache {model = "", model_version = "", config = "", tokenizer = "", history = vacua, layers = 0, dtype = "", layout = "", key = t, payload = t, version = 0, dimension = 0}
}

# -------------------------------------------------------------------------
# appende — the ONE mutation: extend the cache by exactly one position.
# The token joins the exact history; the [1, dimensio] f32 K/V extends
# each cached tensor; the generation bumps by 1. Strictly sequential —
# the appended position is always the current history length (no gaps,
# no duplicates). Deterministic and pure.
# -------------------------------------------------------------------------

@ public { }
fn append(KVCache c, int token_id, tensor.Tensor key, tensor.Tensor payload) → KVCache ⇥ CacheError {
    if token_id ≺ 0 {
        throw variant IdExtra {message = "token id must be non-negative"}
    }
    if not (key.shape() ≡ [1, c.dimension()]) {
        throw variant FormaMismatch {message = "K must be [1, dim]"}
    }
    if not (payload.shape() ≡ [1, c.dimension()]) {
        throw variant FormaMismatch {message = "V must be [1, dim]"}
    }
    if dtype.name(key.dtype()) ≠ "f32" {
        throw variant TypoMismatch {message = "unsupported dtype for cache"}
    }
    if dtype.name(payload.dtype()) ≠ "f32" {
        throw variant TypoMismatch {message = "unsupported dtype for cache"}
    }
    var list<int> novum_historia ← c.history()
    novum_historia.append(token_id)
    var list<f32> nova_clavis ← vacua
    for from c.key().data const v {
        nova_clavis.append(v)
    }
    for from key.data const v {
        nova_clavis.append(v)
    }
    var list<f32> nova_valor ← vacua
    for from c.payload().data const v {
        nova_valor.append(v)
    }
    for from payload.data const v {
        nova_valor.append(v)
    }
    const int novus ← c.length() + 1
    return KVCache {model = c.model(), model_version = c.model_version(), config = c.config(), tokenizer = c.tokenizer(), history = novum_historia, layers = c.layers(), dtype = c.dtype(), layout = c.layout(), key = _tensor(nova_clavis, [novus, c.dimension()]), payload = _tensor(nova_valor, [novus, c.dimension()]), version = c.version() + 1, dimension = c.dimension()}
}

# -------------------------------------------------------------------------
# extend — append T new positions in one mutation (the prefill write).
# tokens, key, and payload must share length T; each new K/V row is [T, dim].
# Generation bumps by 1 (one write). Sequential: the new rows follow the
# existing history with no gaps.
# -------------------------------------------------------------------------

@ public { }
fn extend(KVCache c, list<int> tokens, tensor.Tensor key, tensor.Tensor payload) → KVCache ⇥ CacheError {
    if tokens.length() ≡ 0 {
        throw variant ElementaMismatch {message = "empty token list"}
    }
    if not (key.shape() ≡ [tokens.length(), c.dimension()]) {
        throw variant FormaMismatch {message = "K must be [T, dim]"}
    }
    if not (payload.shape() ≡ [tokens.length(), c.dimension()]) {
        throw variant FormaMismatch {message = "V must be [T, dim]"}
    }
    if dtype.name(key.dtype()) ≠ "f32" {
        throw variant TypoMismatch {message = "unsupported dtype for cache"}
    }
    if dtype.name(payload.dtype()) ≠ "f32" {
        throw variant TypoMismatch {message = "unsupported dtype for cache"}
    }
    var list<int> novum_historia ← c.history()
    for from tokens const token_id {
        if token_id ≺ 0 {
            throw variant IdExtra {message = "token id must be non-negative"}
        }
        novum_historia.append(token_id)
    }
    var list<f32> nova_clavis ← vacua
    for from c.key().data const v {
        nova_clavis.append(v)
    }
    for from key.data const v {
        nova_clavis.append(v)
    }
    var list<f32> nova_valor ← vacua
    for from c.payload().data const v {
        nova_valor.append(v)
    }
    for from payload.data const v {
        nova_valor.append(v)
    }
    const int novus ← c.length() + tokens.length()
    return KVCache {model = c.model(), model_version = c.model_version(), config = c.config(), tokenizer = c.tokenizer(), history = novum_historia, layers = c.layers(), dtype = c.dtype(), layout = c.layout(), key = _tensor(nova_clavis, [novus, c.dimension()]), payload = _tensor(nova_valor, [novus, c.dimension()]), version = c.version() + 1, dimension = c.dimension()}
}

# -------------------------------------------------------------------------
# redintegra — the reset rule: a fresh cache with the same identity
# fields, an empty history and empty K/V, versio 1 (fresh state).
# -------------------------------------------------------------------------

@ public { }
fn reset(KVCache c) → KVCache ⇥ CacheError {
    const tensor.Tensor key ← _tensor([], [0, c.dimension()])
    const tensor.Tensor payload ← _tensor([], [0, c.dimension()])
    return KVCache {model = c.model(), model_version = c.model_version(), config = c.config(), tokenizer = c.tokenizer(), history = vacua, layers = c.layers(), dtype = c.dtype(), layout = c.layout(), key = key, payload = payload, version = 1, dimension = c.dimension()}
}

# -------------------------------------------------------------------------
# IdentitasCache — the typed cache identity key (MD-A9 precedent). The
# fields gradus owns: model, model version, execution configuration,
# tokenizer identity, exact token prefix, positions/RoPE facts, layer
# count, dtype, layout. Field-wise equality; a versioned wire round-trip.
# -------------------------------------------------------------------------


@ public { }
class CacheIdentity {
    string model
    string model_version
    string config
    string tokenizer
    string history
    string position
    int layers
    string dtype
    string layout

    fn model() → string {
        return self.model
    }

    fn model_version() → string {
        return self.model_version
    }

    fn config() → string {
        return self.config
    }

    fn tokenizer() → string {
        return self.tokenizer
    }

    fn history() → string {
        return self.history
    }

    fn position() → string {
        return self.position
    }

    fn layers() → int {
        return self.layers
    }

    fn dtype() → string {
        return self.dtype
    }

    fn layout() → string {
        return self.layout
    }
}

# Field-wise identity equality — the key-reuse predicate.
@ public { }
fn cache_identity_equal(CacheIdentity a, CacheIdentity b) → bool {
    if a.model() ≠ b.model() then return false
    if a.model_version() ≠ b.model_version() then return false
    if a.config() ≠ b.config() then return false
    if a.tokenizer() ≠ b.tokenizer() then return false
    if a.history() ≠ b.history() then return false
    if a.position() ≠ b.position() then return false
    if a.layers() ≠ b.layers() then return false
    if a.dtype() ≠ b.dtype() then return false
    if a.layout() ≠ b.layout() then return false
    return true
}

# Derive the identity key from a cache state: the prefix is the
# comma-joined token history; the position span is "0..<count>".
@ public { }
fn cache_identity(KVCache c) → CacheIdentity {
    var string history ← ""
    for range 0‥c.history().length() const i {
        if i ≻ 0 {
            history ← history + ","
        }
        history ← history + (c.history().get(i) coalesce 0 ↦ string)
    }
    return CacheIdentity {model = c.model(), model_version = c.model_version(), config = c.config(), tokenizer = c.tokenizer(), history = history, position = "0.." + (c.length() ↦ string), layers = c.layers(), dtype = c.dtype(), layout = c.layout()}
}

# -------------------------------------------------------------------------
# Identity wire — versioned, exact round-trip. The empty-prefix segment
# uses the documented sentinel "-" (divide/split behavior must not depend
# on empty segments).
# -------------------------------------------------------------------------

@ public { }
fn serialize_identity(CacheIdentity i) → string {
    var string history ← i.history()
    if history.length() ≡ 0 {
        history ← "-"
    }
    return (((((((((((((((((("cache/identity/" + schema_versio) + "/") + i.model()) + "/") + i.model_version()) + "/") + i.config()) + "/") + i.tokenizer()) + "/") + history) + "/") + i.position()) + "/") + (i.layers() ↦ string)) + "/") + i.dtype()) + "/") + i.layout()
}

@ public { }
fn deserialize_identity(string wire) → CacheIdentity ⇥ CacheError {
    const list<string> partes ← wire.split("/")
    if partes.length() ≠ 12 {
        throw variant WireMala {message = "malformed cache identity wire"}
    }
    if partes.get(0) coalesce "" ≠ "cache" {
        throw variant WireMala {message = "unknown cache marker"}
    }
    if partes.get(1) coalesce "" ≠ "identity" {
        throw variant WireMala {message = "unknown cache marker"}
    }
    if partes.get(2) coalesce "" ≠ schema_versio {
        throw variant VersioIgnota {message = "unknown cache schema version"}
    }
    const string model ← partes.get(3) coalesce ""
    const string model_version ← partes.get(4) coalesce ""
    const string config ← partes.get(5) coalesce ""
    const string tokenizer ← partes.get(6) coalesce ""
    var string history ← partes.get(7) coalesce ""
    const string position ← partes.get(8) coalesce ""
    const string stratorum_textus ← partes.get(9) coalesce ""
    const string dtype ← partes.get(10) coalesce ""
    const string layout ← partes.get(11) coalesce ""
    if model.length() ≡ 0 {
        throw variant WireMala {message = "empty model name in cache identity"}
    }
    if model_version.length() ≡ 0 {
        throw variant WireMala {message = "empty model version in cache identity"}
    }
    if config.length() ≡ 0 {
        throw variant WireMala {message = "empty execution config in cache identity"}
    }
    if tokenizer.length() ≡ 0 {
        throw variant WireMala {message = "empty tokenizer identity in cache identity"}
    }
    if history ≡ "-" {
        history ← ""
    }
    if position.length() ≡ 0 {
        throw variant WireMala {message = "malformed position span in cache identity"}
    }
    if not _numeric(stratorum_textus) {
        throw variant WireMala {message = "malformed layer count in cache identity"}
    }
    var int layers ← 0
    do {
        layers ← stratorum_textus ↦ int
    }
    catch err {
        throw variant WireMala {message = "malformed layer count in cache identity"}
    }
    if layers ≺ 1 {
        throw variant WireMala {message = "invalid layer count in cache identity"}
    }
    if dtype.length() ≡ 0 {
        throw variant WireMala {message = "empty dtype in cache identity"}
    }
    if layout.length() ≡ 0 {
        throw variant WireMala {message = "empty layout in cache identity"}
    }
    return CacheIdentity {model = model, model_version = model_version, config = config, tokenizer = tokenizer, history = history, position = position, layers = layers, dtype = dtype, layout = layout}
}

# -------------------------------------------------------------------------
# KVStructure — W2-U1 typed descriptor (design §4.3). Semantic facts
# Gradus owns; Radix consumes them into the attention-recipe bundle;
# Hosts still consume GI4 KvCacheLayout bytes, never re-derived here.
# -------------------------------------------------------------------------

const string structure_schema ← "1.0.0"

const string structure_schema_v11 ← "1.1.0"

const string RESERVE_GI4 ← "gi4-reserve"

const int HCA_RATIO_4 ← 4

const int HCA_RATIO_128 ← 128

const int Q8_0_BLOCK ← 32

const int Q4_K_BLOCK ← 256

# Opened GI4 KV dtype set (operator-accepted 2026-08-18, need 1d3967ed).
@ public { }
union KvDtype {
    F32,
    F16,
    Q8_0,
    Q4_K
}

@ public { }
union SwaType {
    Standard,
    Chunked,
    Symmetric
}

@ public { }
union LayerStructure {
    Dense,
    SlidingWindow {
        int window
        SwaType swa_kind
    },
    CompressedHca {
        int ratio
    },
    Indexer
}

@ public { }
union CachePartition {
    IndexerBudget {
        int bytes
    }
}

@ public { }
union VLayout {
    Transposed,
    Straight
}

@ public { }
union KvSharing {
    Single,
    GqaShared
}

@ public { }
union AttentionFamily {
    Classic,
    Flash
}

@ public { }
fn kv_dtype_f32() → KvDtype {
    return variant F32
}

@ public { }
fn kv_dtype_f16() → KvDtype {
    return variant F16
}

@ public { }
fn kv_dtype_q8_0() → KvDtype {
    return variant Q8_0
}

@ public { }
fn kv_dtype_q4_k() → KvDtype {
    return variant Q4_K
}

@ public { }
fn kv_dtype_name(KvDtype t) → string {
    match t {
        case F32 {
            return "f32"
        }
        case F16 {
            return "f16"
        }
        case Q8_0 {
            return "q8_0"
        }
        case Q4_K {
            return "q4_k"
        }
    }
}

@ public { }
fn kv_dtype_eq(KvDtype a, KvDtype b) → bool {
    return kv_dtype_name(a) ≡ kv_dtype_name(b)
}

@ private { }
fn _kv_dtype_from_name(string s) → KvDtype ⇥ CacheError {
    if s ≡ "f32" then return variant F32
    if s ≡ "f16" then return variant F16
    if s ≡ "q8_0" then return variant Q8_0
    if s ≡ "q4_k" then return variant Q4_K
    throw variant TypoMismatch {message = "unadmitted kv dtype"}
}

@ private { }
fn _kv_dtype_block(KvDtype t) → int {
    match t {
        case F32 {
            return 1
        }
        case F16 {
            return 1
        }
        case Q8_0 {
            return Q8_0_BLOCK
        }
        case Q4_K {
            return Q4_K_BLOCK
        }
    }
}

@ private { }
fn _kv_dtype_quantized(KvDtype t) → bool {
    match t {
        case F32 {
            return false
        }
        case F16 {
            return false
        }
        case Q8_0 {
            return true
        }
        case Q4_K {
            return true
        }
    }
}

@ public { }
fn swa_standard() → SwaType {
    return variant Standard
}

@ public { }
fn swa_chunked() → SwaType {
    return variant Chunked
}

@ public { }
fn swa_symmetric() → SwaType {
    return variant Symmetric
}

@ public { }
fn swa_type_name(SwaType t) → string {
    match t {
        case Standard {
            return "standard"
        }
        case Chunked {
            return "chunked"
        }
        case Symmetric {
            return "symmetric"
        }
    }
}

@ public { }
fn swa_type_eq(SwaType a, SwaType b) → bool {
    return swa_type_name(a) ≡ swa_type_name(b)
}

@ private { }
fn _swa_type_from_name(string s) → SwaType ⇥ CacheError {
    if s ≡ "standard" then return variant Standard
    if s ≡ "chunked" then return variant Chunked
    if s ≡ "symmetric" then return variant Symmetric
    throw variant CombinatioInvalida {message = "unknown swa type"}
}

@ public { }
fn dense_structure() → LayerStructure {
    return variant Dense
}

@ public { }
fn sliding_window_structure(int window, SwaType swa_kind) → LayerStructure ⇥ CacheError {
    if window ≺ 1 {
        throw variant DimensioInvalida {message = "sliding window n_swa must be at least one"}
    }
    return variant SlidingWindow {window = window, swa_kind = swa_kind}
}

@ public { }
fn compressed_hca_structure(int ratio) → LayerStructure ⇥ CacheError {
    if ratio ≺ 1 {
        throw variant DimensioInvalida {message = "hca compression ratio must be at least one"}
    }
    if ratio ≠ HCA_RATIO_4 {
        if ratio ≠ HCA_RATIO_128 {
            throw variant CombinatioInvalida {message = "unadmitted hca compression ratio"}
        }
    }
    return variant CompressedHca {ratio = ratio}
}

@ public { }
fn indexer_structure() → LayerStructure {
    return variant Indexer
}

@ public { }
fn hca_ratio(LayerStructure s) → int {
    match s {
        case Dense {
            return 0
        }
        case SlidingWindow const window, swa_kind {
            return 0
        }
        case CompressedHca const ratio {
            return ratio
        }
        case Indexer {
            return 0
        }
    }
}

@ public { }
fn layer_structure_name(LayerStructure s) → string {
    match s {
        case Dense {
            return "dense"
        }
        case SlidingWindow const window, swa_kind {
            return "sliding-window"
        }
        case CompressedHca const ratio {
            return "compressed-hca"
        }
        case Indexer {
            return "indexer"
        }
    }
}

@ public { }
fn default_cache_partition() → CachePartition {
    return variant IndexerBudget {bytes = 0}
}

@ public { }
fn indexer_budget(int bytes) → CachePartition ⇥ CacheError {
    if bytes ≺ 1 {
        throw variant DimensioInvalida {message = "indexer partition budget must be at least one"}
    }
    return variant IndexerBudget {bytes = bytes}
}

@ public { }
fn partition_class_name(CachePartition p) → string {
    match p {
        case IndexerBudget const bytes {
            return "indexer"
        }
    }
}

@ public { }
fn partition_bytes(CachePartition p) → int {
    match p {
        case IndexerBudget const bytes {
            return bytes
        }
    }
}

@ public { }
fn cache_partition_eq(CachePartition a, CachePartition b) → bool {
    if partition_class_name(a) ≠ partition_class_name(b) then return false
    return partition_bytes(a) ≡ partition_bytes(b)
}

@ public { }
fn v_layout_transposed() → VLayout {
    return variant Transposed
}

@ public { }
fn v_layout_straight() → VLayout {
    return variant Straight
}

@ public { }
fn v_layout_name(VLayout v) → string {
    match v {
        case Transposed {
            return "transposed"
        }
        case Straight {
            return "straight"
        }
    }
}

@ public { }
fn v_layout_eq(VLayout a, VLayout b) → bool {
    return v_layout_name(a) ≡ v_layout_name(b)
}

@ private { }
fn _v_layout_from_name(string s) → VLayout ⇥ CacheError {
    if s ≡ "transposed" then return variant Transposed
    if s ≡ "straight" then return variant Straight
    throw variant CombinatioInvalida {message = "unknown v_layout"}
}

@ public { }
fn sharing_single() → KvSharing {
    return variant Single
}

@ public { }
fn sharing_gqa() → KvSharing {
    return variant GqaShared
}

@ public { }
fn sharing_name(KvSharing s) → string {
    match s {
        case Single {
            return "single"
        }
        case GqaShared {
            return "gqa"
        }
    }
}

@ public { }
fn sharing_eq(KvSharing a, KvSharing b) → bool {
    return sharing_name(a) ≡ sharing_name(b)
}

@ private { }
fn _sharing_from_name(string s) → KvSharing ⇥ CacheError {
    if s ≡ "single" then return variant Single
    if s ≡ "gqa" then return variant GqaShared
    throw variant CombinatioInvalida {message = "unknown sharing"}
}

@ public { }
fn attention_classic() → AttentionFamily {
    return variant Classic
}

@ public { }
fn attention_flash() → AttentionFamily {
    return variant Flash
}

@ public { }
fn attention_family_name(AttentionFamily f) → string {
    match f {
        case Classic {
            return "classic"
        }
        case Flash {
            return "flash"
        }
    }
}

@ public { }
fn attention_family_eq(AttentionFamily a, AttentionFamily b) → bool {
    return attention_family_name(a) ≡ attention_family_name(b)
}

@ private { }
fn _attention_family_from_name(string s) → AttentionFamily ⇥ CacheError {
    if s ≡ "classic" then return variant Classic
    if s ≡ "flash" then return variant Flash
    throw variant CombinatioInvalida {message = "unknown attention family"}
}

@ private { }
fn _attention_is_flash(AttentionFamily f) → bool {
    match f {
        case Classic {
            return false
        }
        case Flash {
            return true
        }
    }
}

@ private { }
fn _v_layout_is_straight(VLayout v) → bool {
    match v {
        case Transposed {
            return false
        }
        case Straight {
            return true
        }
    }
}

@ private { }
fn _sharing_is_gqa(KvSharing s) → bool {
    match s {
        case Single {
            return false
        }
        case GqaShared {
            return true
        }
    }
}

# -------------------------------------------------------------------------
# LayerSet — one per-layer-set cache-class slice of the model.
# Dense / SlidingWindow / CompressedHca are KV classes. Indexer is a
# partition class assigned per layer set; it is not a KvDtype.
# -------------------------------------------------------------------------

@ public { }
class LayerSet {
    list<int> indices
    LayerStructure structure
    int kv_heads
    int head_dim

    fn indices() → list<int> {
        return self.indices
    }

    fn structure() → LayerStructure {
        return self.structure
    }

    fn kv_heads() → int {
        return self.kv_heads
    }

    fn head_dim() → int {
        return self.head_dim
    }
}

@ public { }
fn default_layer_set() → LayerSet {
    return LayerSet {indices = vacua, structure = dense_structure(), kv_heads = 0, head_dim = 0}
}

@ private { }
fn _index_seen(list<int> seen, int idx) → bool {
    var int i ← 0
    while i ≺ seen.length() {
        if (seen.get(i) coalesce (0 - 1)) ≡ idx then return true
        i ← i + 1
    }
    return false
}

@ public { }
fn construct_layer_set(list<int> indices, LayerStructure structure, int kv_heads, int head_dim) → LayerSet ⇥ CacheError {
    if indices.length() ≺ 1 {
        throw variant DimensioInvalida {message = "layer set indices must be at least one"}
    }
    if kv_heads ≺ 1 {
        throw variant DimensioInvalida {message = "kv head count must be at least one"}
    }
    if head_dim ≺ 1 {
        throw variant DimensioInvalida {message = "head dim must be at least one"}
    }
    var list<int> seen ← vacua
    var int i ← 0
    while i ≺ indices.length() {
        const int idx ← indices.get(i) coalesce (0 - 1)
        if idx ≺ 0 {
            throw variant DimensioInvalida {message = "invalid layer index"}
        }
        if _index_seen(seen, idx) {
            throw variant CombinatioInvalida {message = "duplicate layer index"}
        }
        seen.append(idx)
        i ← i + 1
    }
    match structure {
        case Dense {
            return LayerSet {indices = indices, structure = dense_structure(), kv_heads = kv_heads, head_dim = head_dim}
        }
        case SlidingWindow const window, swa_kind {
            return LayerSet {indices = indices, structure = sliding_window_structure(window, swa_kind), kv_heads = kv_heads, head_dim = head_dim}
        }
        case CompressedHca const ratio {
            return LayerSet {indices = indices, structure = compressed_hca_structure(ratio), kv_heads = kv_heads, head_dim = head_dim}
        }
        case Indexer {
            return LayerSet {indices = indices, structure = indexer_structure(), kv_heads = kv_heads, head_dim = head_dim}
        }
    }
}

# -------------------------------------------------------------------------
# KVStructure — the admitted bundle. F16 / Dense / family-linked default.
# partitions is the non-KV ledger (indexer cache budget). Empty for
# Dense/SWA-only 1.0.0 wires.
# -------------------------------------------------------------------------

@ public { }
class KVStructure {
    list<LayerSet> layers
    KvDtype kv_dtype_k
    KvDtype kv_dtype_v
    VLayout v_layout
    KvSharing sharing
    AttentionFamily attention_family
    int query_heads
    int slots
    int context_length
    string reserve_policy
    list<CachePartition> partitions

    fn layers() → list<LayerSet> {
        return self.layers
    }

    fn kv_dtype_k() → KvDtype {
        return self.kv_dtype_k
    }

    fn kv_dtype_v() → KvDtype {
        return self.kv_dtype_v
    }

    fn v_layout() → VLayout {
        return self.v_layout
    }

    fn sharing() → KvSharing {
        return self.sharing
    }

    fn attention_family() → AttentionFamily {
        return self.attention_family
    }

    fn query_heads() → int {
        return self.query_heads
    }

    fn slots() → int {
        return self.slots
    }

    fn context_length() → int {
        return self.context_length
    }

    fn reserve_policy() → string {
        return self.reserve_policy
    }

    fn partitions() → list<CachePartition> {
        return self.partitions
    }
}

@ public { }
fn default_kv_structure() → KVStructure {
    return KVStructure {layers = vacua, kv_dtype_k = kv_dtype_f16(), kv_dtype_v = kv_dtype_f16(), v_layout = v_layout_transposed(), sharing = sharing_single(), attention_family = attention_classic(), query_heads = 0, slots = 0, context_length = 0, reserve_policy = "gi4-reserve", partitions = vacua}
}

@ private { }
fn _layer_set_eq(LayerSet a, LayerSet b) → bool {
    if not (a.indices() ≡ b.indices()) then return false
    if layer_structure_name(a.structure()) ≠ layer_structure_name(b.structure()) then return false
    if a.kv_heads() ≠ b.kv_heads() then return false
    if a.head_dim() ≠ b.head_dim() then return false
    match a.structure() {
        case Dense {
            return true
        }
        case SlidingWindow const window_a, swa_a {
            match b.structure() {
                case Dense {
                    return false
                }
                case SlidingWindow const window_b, swa_b {
                    if window_a ≠ window_b then return false
                    return swa_type_eq(swa_a, swa_b)
                }
                case CompressedHca const ratio_b {
                    return false
                }
                case Indexer {
                    return false
                }
            }
        }
        case CompressedHca const ratio_a {
            match b.structure() {
                case Dense {
                    return false
                }
                case SlidingWindow const window_b, swa_b {
                    return false
                }
                case CompressedHca const ratio_b {
                    return ratio_a ≡ ratio_b
                }
                case Indexer {
                    return false
                }
            }
        }
        case Indexer {
            match b.structure() {
                case Dense {
                    return false
                }
                case SlidingWindow const window_b, swa_b {
                    return false
                }
                case CompressedHca const ratio_b {
                    return false
                }
                case Indexer {
                    return true
                }
            }
        }
    }
}

@ public { }
fn kv_structure_equal(KVStructure a, KVStructure b) → bool {
    if a.layers().length() ≠ b.layers().length() then return false
    var int i ← 0
    while i ≺ a.layers().length() {
        const LayerSet la ← a.layers().get(i) coalesce default_layer_set()
        const LayerSet lb ← b.layers().get(i) coalesce default_layer_set()
        if not _layer_set_eq(la, lb) then return false
        i ← i + 1
    }
    if not kv_dtype_eq(a.kv_dtype_k(), b.kv_dtype_k()) then return false
    if not kv_dtype_eq(a.kv_dtype_v(), b.kv_dtype_v()) then return false
    if not v_layout_eq(a.v_layout(), b.v_layout()) then return false
    if not sharing_eq(a.sharing(), b.sharing()) then return false
    if not attention_family_eq(a.attention_family(), b.attention_family()) then return false
    if a.query_heads() ≠ b.query_heads() then return false
    if a.slots() ≠ b.slots() then return false
    if a.context_length() ≠ b.context_length() then return false
    if a.reserve_policy() ≠ b.reserve_policy() then return false
    if a.partitions().length() ≠ b.partitions().length() then return false
    var int p ← 0
    while p ≺ a.partitions().length() {
        const CachePartition pa ← a.partitions().get(p) coalesce default_cache_partition()
        const CachePartition pb ← b.partitions().get(p) coalesce default_cache_partition()
        if not cache_partition_eq(pa, pb) then return false
        p ← p + 1
    }
    return true
}

@ private { }
fn _check_block(KvDtype t, int kv_heads, int head_dim) → bool ⇥ CacheError {
    const int block ← _kv_dtype_block(t)
    const int width ← kv_heads * head_dim
    if width % block ≠ 0 {
        throw variant CombinatioInvalida {message = "block size does not divide head_dim"}
    }
    return true
}

@ private { }
fn _is_indexer_structure(LayerStructure s) → bool {
    match s {
        case Dense {
            return false
        }
        case SlidingWindow const window, swa_kind {
            return false
        }
        case CompressedHca const ratio {
            return false
        }
        case Indexer {
            return true
        }
    }
}

@ private { }
fn _uses_extended_class(LayerStructure s) → bool {
    match s {
        case Dense {
            return false
        }
        case SlidingWindow const window, swa_kind {
            return false
        }
        case CompressedHca const ratio {
            return true
        }
        case Indexer {
            return true
        }
    }
}

@ private { }
fn _check_class_partitions(list<LayerSet> layers, list<CachePartition> partitions) → bool ⇥ CacheError {
    var int indexer_parts ← 0
    var int i ← 0
    while i ≺ partitions.length() {
        const CachePartition part ← partitions.get(i) coalesce default_cache_partition()
        match part {
            case IndexerBudget const bytes {
                if bytes ≺ 1 {
                    throw variant DimensioInvalida {message = "indexer partition budget must be at least one"}
                }
                indexer_parts ← indexer_parts + 1
            }
        }
        i ← i + 1
    }
    if indexer_parts ≻ 1 {
        throw variant CombinatioInvalida {message = "duplicate indexer partition"}
    }
    var bool has_indexer ← false
    var int j ← 0
    while j ≺ layers.length() {
        const LayerSet layer ← layers.get(j) coalesce default_layer_set()
        if _is_indexer_structure(layer.structure()) {
            has_indexer ← true
        }
        j ← j + 1
    }
    if has_indexer {
        if indexer_parts ≡ 0 {
            throw variant CombinatioInvalida {message = "indexer class requires an indexer partition budget"}
        }
    }
    if indexer_parts ≻ 0 {
        if not has_indexer {
            throw variant CombinatioInvalida {message = "indexer partition requires an indexer class"}
        }
    }
    return true
}

@ public { }
fn construct_kv_structure(list<LayerSet> layers, KvDtype kv_dtype_k, KvDtype kv_dtype_v, VLayout v_layout, KvSharing sharing, AttentionFamily attention_family, int query_heads, int slots, int context_length) → KVStructure ⇥ CacheError {
    return construct_kv_structure_with_partitions(layers, kv_dtype_k, kv_dtype_v, v_layout, sharing, attention_family, query_heads, slots, context_length, vacua)
}

@ public { }
fn construct_kv_structure_with_partitions(list<LayerSet> layers, KvDtype kv_dtype_k, KvDtype kv_dtype_v, VLayout v_layout, KvSharing sharing, AttentionFamily attention_family, int query_heads, int slots, int context_length, list<CachePartition> partitions) → KVStructure ⇥ CacheError {
    if layers.length() ≺ 1 {
        throw variant DimensioInvalida {message = "layer set must be at least one"}
    }
    if query_heads ≺ 1 {
        throw variant DimensioInvalida {message = "query head count must be at least one"}
    }
    if slots ≺ 1 {
        throw variant DimensioInvalida {message = "slots must be at least one"}
    }
    if context_length ≺ 1 {
        throw variant DimensioInvalida {message = "context length must be at least one"}
    }
    if _kv_dtype_quantized(kv_dtype_v) {
        if not _attention_is_flash(attention_family) {
            throw variant CombinatioInvalida {message = "quantized V requires the flash-attention family"}
        }
    }
    if _attention_is_flash(attention_family) {
        if not _v_layout_is_straight(v_layout) {
            throw variant CombinatioInvalida {message = "flash-attention family requires straight V layout"}
        }
    }
    if not _attention_is_flash(attention_family) {
        if _v_layout_is_straight(v_layout) {
            throw variant CombinatioInvalida {message = "classic attention family requires transposed V layout"}
        }
    }
    _check_class_partitions(layers, partitions)
    var list<int> kv_seen ← vacua
    var list<int> indexer_seen ← vacua
    var int i ← 0
    while i ≺ layers.length() {
        const LayerSet layer ← layers.get(i) coalesce default_layer_set()
        if layer.indices().length() ≺ 1 {
            throw variant DimensioInvalida {message = "layer set indices must be at least one"}
        }
        if layer.kv_heads() ≺ 1 {
            throw variant DimensioInvalida {message = "kv head count must be at least one"}
        }
        if layer.head_dim() ≺ 1 {
            throw variant DimensioInvalida {message = "head dim must be at least one"}
        }
        const bool indexer ← _is_indexer_structure(layer.structure())
        if not indexer {
            if _sharing_is_gqa(sharing) {
                if not (layer.kv_heads() ≺ query_heads) {
                    throw variant CombinatioInvalida {message = "gqa sharing requires kv_heads < heads"}
                }
                if query_heads % layer.kv_heads() ≠ 0 {
                    throw variant CombinatioInvalida {message = "gqa sharing requires heads to divide by kv_heads"}
                }
            }
            if not _sharing_is_gqa(sharing) {
                if layer.kv_heads() ≠ query_heads {
                    throw variant CombinatioInvalida {message = "single sharing requires kv_heads = heads"}
                }
            }
            _check_block(kv_dtype_k, layer.kv_heads(), layer.head_dim())
            _check_block(kv_dtype_v, layer.kv_heads(), layer.head_dim())
        }
        var int j ← 0
        while j ≺ layer.indices().length() {
            const int idx ← layer.indices().get(j) coalesce (0 - 1)
            if idx ≺ 0 {
                throw variant DimensioInvalida {message = "invalid layer index"}
            }
            if indexer {
                if _index_seen(indexer_seen, idx) {
                    throw variant CombinatioInvalida {message = "duplicate layer index"}
                }
                indexer_seen.append(idx)
            }
            if not indexer {
                if _index_seen(kv_seen, idx) {
                    throw variant CombinatioInvalida {message = "duplicate layer index"}
                }
                kv_seen.append(idx)
            }
            j ← j + 1
        }
        i ← i + 1
    }
    return KVStructure {layers = layers, kv_dtype_k = kv_dtype_k, kv_dtype_v = kv_dtype_v, v_layout = v_layout, sharing = sharing, attention_family = attention_family, query_heads = query_heads, slots = slots, context_length = context_length, reserve_policy = "gi4-reserve", partitions = partitions}
}

@ private { }
fn _layer_wire(LayerSet layer) → string {
    var string indices ← ""
    var int i ← 0
    while i ≺ layer.indices().length() {
        if i ≻ 0 {
            indices ← indices + "+"
        }
        indices ← indices + ((layer.indices().get(i) coalesce 0) ↦ string)
        i ← i + 1
    }
    const string heads ← layer.kv_heads() ↦ string
    const string dim ← layer.head_dim() ↦ string
    match layer.structure() {
        case Dense {
            return (((indices + ":dense:") + heads) + ":") + dim
        }
        case SlidingWindow const window, swa_kind {
            return (((((((indices + ":swa:") + swa_type_name(swa_kind)) + ":") + (window ↦ string)) + ":") + heads) + ":") + dim
        }
        case CompressedHca const ratio {
            return (((((indices + ":hca:") + (ratio ↦ string)) + ":") + heads) + ":") + dim
        }
        case Indexer {
            return (((indices + ":indexer:") + heads) + ":") + dim
        }
    }
}

@ private { }
fn _parse_indices(string text) → list<int> ⇥ CacheError {
    if text.length() ≡ 0 {
        throw variant WireMala {message = "malformed layer set wire"}
    }
    const list<string> partes ← text.split("+")
    if partes.length() ≺ 1 {
        throw variant WireMala {message = "malformed layer set wire"}
    }
    var list<int> indices ← vacua
    var int i ← 0
    while i ≺ partes.length() {
        const string part ← partes.get(i) coalesce ""
        if not _numeric(part) {
            throw variant WireMala {message = "malformed layer index in structure wire"}
        }
        var int idx ← 0
        do {
            idx ← part ↦ int
        }
        catch err {
            throw variant WireMala {message = "malformed layer index in structure wire"}
        }
        indices.append(idx)
        i ← i + 1
    }
    return indices
}

@ private { }
fn _parse_layer_wire(string text) → LayerSet ⇥ CacheError {
    const list<string> partes ← text.split(":")
    if partes.length() ≡ 4 {
        const string kind ← partes.get(1) coalesce ""
        const string heads_text ← partes.get(2) coalesce ""
        const string dim_text ← partes.get(3) coalesce ""
        if not _numeric(heads_text) or not _numeric(dim_text) {
            throw variant WireMala {message = "malformed layer set wire"}
        }
        var int kv_heads ← 0
        var int head_dim ← 0
        do {
            kv_heads ← heads_text ↦ int
            head_dim ← dim_text ↦ int
        }
        catch err {
            throw variant WireMala {message = "malformed layer set wire"}
        }
        if kind ≡ "dense" {
            return construct_layer_set(_parse_indices(partes.get(0) coalesce ""), dense_structure(), kv_heads, head_dim)
        }
        if kind ≡ "indexer" {
            return construct_layer_set(_parse_indices(partes.get(0) coalesce ""), indexer_structure(), kv_heads, head_dim)
        }
        throw variant WireMala {message = "malformed layer set wire"}
    }
    if partes.length() ≡ 5 {
        if partes.get(1) coalesce "" ≠ "hca" {
            throw variant WireMala {message = "malformed layer set wire"}
        }
        const string ratio_text ← partes.get(2) coalesce ""
        const string heads_text ← partes.get(3) coalesce ""
        const string dim_text ← partes.get(4) coalesce ""
        if ((not _numeric(ratio_text) or not _numeric(heads_text)) or not _numeric(dim_text)) {
            throw variant WireMala {message = "malformed layer set wire"}
        }
        var int ratio ← 0
        var int kv_heads ← 0
        var int head_dim ← 0
        do {
            ratio ← ratio_text ↦ int
            kv_heads ← heads_text ↦ int
            head_dim ← dim_text ↦ int
        }
        catch err {
            throw variant WireMala {message = "malformed layer set wire"}
        }
        const LayerStructure structure ← compressed_hca_structure(ratio)
        return construct_layer_set(_parse_indices(partes.get(0) coalesce ""), structure, kv_heads, head_dim)
    }
    if partes.length() ≡ 6 {
        if partes.get(1) coalesce "" ≠ "swa" {
            throw variant WireMala {message = "malformed layer set wire"}
        }
        const string window_text ← partes.get(3) coalesce ""
        const string heads_text ← partes.get(4) coalesce ""
        const string dim_text ← partes.get(5) coalesce ""
        if ((not _numeric(window_text) or not _numeric(heads_text)) or not _numeric(dim_text)) {
            throw variant WireMala {message = "malformed layer set wire"}
        }
        var int window ← 0
        var int kv_heads ← 0
        var int head_dim ← 0
        do {
            window ← window_text ↦ int
            kv_heads ← heads_text ↦ int
            head_dim ← dim_text ↦ int
        }
        catch err {
            throw variant WireMala {message = "malformed layer set wire"}
        }
        const LayerStructure structure ← sliding_window_structure(window, _swa_type_from_name(partes.get(2) coalesce ""))
        return construct_layer_set(_parse_indices(partes.get(0) coalesce ""), structure, kv_heads, head_dim)
    }
    throw variant WireMala {message = "malformed layer set wire"}
}

@ private { }
fn _structure_uses_v11(KVStructure s) → bool {
    if s.partitions().length() ≻ 0 then return true
    var int i ← 0
    while i ≺ s.layers().length() {
        const LayerSet layer ← s.layers().get(i) coalesce default_layer_set()
        if _uses_extended_class(layer.structure()) then return true
        i ← i + 1
    }
    return false
}

@ private { }
fn _partitions_wire(list<CachePartition> partitions) → string {
    if partitions.length() ≡ 0 {
        return "-"
    }
    var string wire ← ""
    var int i ← 0
    while i ≺ partitions.length() {
        if i ≻ 0 {
            wire ← wire + ";"
        }
        const CachePartition part ← partitions.get(i) coalesce default_cache_partition()
        wire ← wire + ((partition_class_name(part) + ":") + (partition_bytes(part) ↦ string))
        i ← i + 1
    }
    return wire
}

@ private { }
fn _parse_partitions(string text) → list<CachePartition> ⇥ CacheError {
    if text ≡ "-" {
        return vacua
    }
    if text.length() ≡ 0 {
        throw variant WireMala {message = "malformed cache partition wire"}
    }
    const list<string> partes ← text.split(";")
    var list<CachePartition> partitions ← vacua
    var int i ← 0
    while i ≺ partes.length() {
        const string part ← partes.get(i) coalesce ""
        const list<string> bits ← part.split(":")
        if bits.length() ≠ 2 {
            throw variant WireMala {message = "malformed cache partition wire"}
        }
        if bits.get(0) coalesce "" ≠ "indexer" {
            throw variant CombinatioInvalida {message = "unknown partition class"}
        }
        const string bytes_text ← bits.get(1) coalesce ""
        if not _numeric(bytes_text) {
            throw variant WireMala {message = "malformed cache partition wire"}
        }
        var int bytes ← 0
        do {
            bytes ← bytes_text ↦ int
        }
        catch err {
            throw variant WireMala {message = "malformed cache partition wire"}
        }
        partitions.append(indexer_budget(bytes))
        i ← i + 1
    }
    return partitions
}

@ public { }
fn serialize_structure(KVStructure s) → string {
    var string layers ← ""
    var int i ← 0
    while i ≺ s.layers().length() {
        if i ≻ 0 {
            layers ← layers + ";"
        }
        const LayerSet layer ← s.layers().get(i) coalesce default_layer_set()
        layers ← layers + _layer_wire(layer)
        i ← i + 1
    }
    var string wire_schema ← structure_schema
    if _structure_uses_v11(s) {
        wire_schema ← structure_schema_v11
    }
    var string wire ← "cache/structure/" + wire_schema
    wire ← wire + "/"
    wire ← wire + layers
    wire ← wire + "/"
    wire ← wire + kv_dtype_name(s.kv_dtype_k())
    wire ← wire + "/"
    wire ← wire + kv_dtype_name(s.kv_dtype_v())
    wire ← wire + "/"
    wire ← wire + v_layout_name(s.v_layout())
    wire ← wire + "/"
    wire ← wire + sharing_name(s.sharing())
    wire ← wire + "/"
    wire ← wire + attention_family_name(s.attention_family())
    wire ← wire + "/"
    wire ← wire + (s.query_heads() ↦ string)
    wire ← wire + "/"
    wire ← wire + (s.slots() ↦ string)
    wire ← wire + "/"
    wire ← wire + (s.context_length() ↦ string)
    wire ← wire + "/"
    wire ← wire + s.reserve_policy()
    if _structure_uses_v11(s) {
        wire ← wire + "/"
        wire ← wire + _partitions_wire(s.partitions())
    }
    return wire
}

@ public { }
fn deserialize_structure(string wire) → KVStructure ⇥ CacheError {
    const list<string> partes ← wire.split("/")
    if partes.length() ≺ 13 {
        throw variant WireMala {message = "malformed cache structure wire"}
    }
    if partes.get(0) coalesce "" ≠ "cache" {
        throw variant WireMala {message = "unknown cache marker"}
    }
    if partes.get(1) coalesce "" ≠ "structure" {
        throw variant WireMala {message = "unknown cache marker"}
    }
    const string version ← partes.get(2) coalesce ""
    if version ≠ structure_schema {
        if version ≠ structure_schema_v11 {
            throw variant VersioIgnota {message = "unknown cache structure schema version"}
        }
    }
    if version ≡ structure_schema {
        if partes.length() ≠ 13 {
            throw variant WireMala {message = "malformed cache structure wire"}
        }
    }
    if version ≡ structure_schema_v11 {
        if partes.length() ≠ 14 {
            throw variant WireMala {message = "malformed cache structure wire"}
        }
    }
    const string layers_text ← partes.get(3) coalesce ""
    if layers_text.length() ≡ 0 {
        throw variant WireMala {message = "malformed cache structure wire"}
    }
    const list<string> layer_partes ← layers_text.split(";")
    var list<LayerSet> layers ← vacua
    var int i ← 0
    while i ≺ layer_partes.length() {
        layers.append(_parse_layer_wire(layer_partes.get(i) coalesce ""))
        i ← i + 1
    }
    const KvDtype kv_dtype_k ← _kv_dtype_from_name(partes.get(4) coalesce "")
    const KvDtype kv_dtype_v ← _kv_dtype_from_name(partes.get(5) coalesce "")
    const VLayout v_layout ← _v_layout_from_name(partes.get(6) coalesce "")
    const KvSharing sharing ← _sharing_from_name(partes.get(7) coalesce "")
    const AttentionFamily attention_family ← _attention_family_from_name(partes.get(8) coalesce "")
    const string heads_text ← partes.get(9) coalesce ""
    const string slots_text ← partes.get(10) coalesce ""
    const string context_text ← partes.get(11) coalesce ""
    const string reserve ← partes.get(12) coalesce ""
    if reserve ≠ RESERVE_GI4 {
        throw variant CombinatioInvalida {message = "unknown reserve policy"}
    }
    if ((not _numeric(heads_text) or not _numeric(slots_text)) or not _numeric(context_text)) {
        throw variant WireMala {message = "malformed cache structure wire"}
    }
    var int query_heads ← 0
    var int slots ← 0
    var int context_length ← 0
    do {
        query_heads ← heads_text ↦ int
        slots ← slots_text ↦ int
        context_length ← context_text ↦ int
    }
    catch err {
        throw variant WireMala {message = "malformed cache structure wire"}
    }
    var list<CachePartition> partitions ← vacua
    if version ≡ structure_schema_v11 {
        partitions ← _parse_partitions(partes.get(13) coalesce "")
    }
    return construct_kv_structure_with_partitions(layers, kv_dtype_k, kv_dtype_v, v_layout, sharing, attention_family, query_heads, slots, context_length, partitions)
}

# -------------------------------------------------------------------------
# empty_layers — one empty KVCache per KV layer index in the structure.
# Indexer partitions are skipped (they are not a KvDtype). Indices must
# be the contiguous range 0..N-1 so the returned list is layer-addressable.
# Each cache is one-block (layers = 1) with width kv_heads * head_dim.
# -------------------------------------------------------------------------

@ private { }
fn _layer_width(KVStructure s, int idx) → int ⇥ CacheError {
    var int i ← 0
    while i ≺ s.layers().length() {
        const LayerSet layer ← s.layers().get(i) coalesce default_layer_set()
        if not _is_indexer_structure(layer.structure()) {
            var int j ← 0
            while j ≺ layer.indices().length() {
                if (layer.indices().get(j) coalesce (0 - 1)) ≡ idx {
                    return layer.kv_heads() * layer.head_dim()
                }
                j ← j + 1
            }
        }
        i ← i + 1
    }
    throw variant CombinatioInvalida {message = "layer indices must be the contiguous range 0..N-1"}
}

@ public { }
fn empty_layers(KVStructure s, string model, string model_version, string config, string tokenizer) → list<KVCache> ⇥ CacheError {
    var int count ← 0
    var int i ← 0
    while i ≺ s.layers().length() {
        const LayerSet layer ← s.layers().get(i) coalesce default_layer_set()
        if not _is_indexer_structure(layer.structure()) {
            count ← count + layer.indices().length()
        }
        i ← i + 1
    }
    if count ≺ 1 {
        throw variant DimensioInvalida {message = "layer set must be at least one"}
    }
    var list<KVCache> out ← vacua
    var int idx ← 0
    while idx ≺ count {
        out.append(empty_cache(model, model_version, config, tokenizer, 1, _layer_width(s, idx)))
        idx ← idx + 1
    }
    return out
}
