+++
locale = "en"
+++
# KV-cache values and mutation rules — PML5-U2 (production inference
# computation layer; the campaign never-split unit).
#
# Public import: importa ex "gradus:cache" privata cache
# Depends on: gradus:dtype (tags/finita), gradus:tensor (value carrier).
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own device residency). This module holds no device handle and makes no
# performance claims.
#
# =========================================================================
# The KV-cache contract (pml5-delivery.md PML5-U2)
# =========================================================================
#
# --- The typed logical value ---------------------------------------------
# KVCache is the per-session key/value state the decode serves: one K/V
# pair per layer of the forward row (the gradus row is a single
# transformer block — stratorum = 1), each an [positions, dimensio] f32
# staged tensor, plus the exact token history (historia) and the
# identity fields (model / model version / execution config / tokenizer
# identity). No device handle, no physical residency.
#
# --- Declared mutation rules ---------------------------------------------
#   * Append per position (appende): extends the K/V by exactly ONE
#     position and the history by one token; strictly sequential — the
#     appended position is always the current history length (no gaps,
#     no duplicates, no reordering). Deterministic and pure.
#   * Generation tracking: versio is the cache's generation — the
#     mutation counter, starts at 1, bumps by 1 on every successful
#     append. Identity fields (model/version/config/tokenizer/stratorum/
#     dimensio) are stable across appends.
#   * Reset (redintegra): a fresh cache — the same identity fields, an
#     empty history and empty K/V, versio 1.
#
# --- Cache identity key (MD-A9 precedent) --------------------------------
# The cache's identity (IdentitasCache) is a typed record over the MD-A9
# key fields gradus owns: model, model version, execution configuration,
# tokenizer identity, exact token prefix/history, positions/RoPE facts,
# layer count, dtype, and layout. A versioned wire form round-trips the
# key exactly; identity equality is field-wise (the product repo / NGAB
# consume the exact key — never a second authority). The empty-prefix
# wire segment uses the documented sentinel "-".
#
# --- Evidence honesty (CTO Q2, hard) -------------------------------------
# This surface is the STRUCTURAL proof: the mutation rules and the
# identity-key facts are compile-validated and proven by the co-located
# proba. The append/readback arithmetic is exact concatenation (no
# rounding — pins are exact); the identity-key facts are exact textus/
# numerus pins. Executed VALUE identity is env-blocked tree-wide today
# (FMIR stepper / library-import gap — the PML4 closeout recorded both
# blockers; neither is fixed here). PML5-U2 is PARTIAL: value-identity is
# deferred to the auditor-owned runtime-evidence gate.
import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# CacheError — typed error vocabulary of the KV-cache surface.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------


@ public { }
union CacheError {
    NomenInane {
        string message
    },
    IdExtra {
        string message
    },
    FormaMismatch {
        string message
    },
    TypoMismatch {
        string message
    },
    DimensioInvalida {
        string message
    },
    ElementaMismatch {
        string message
    },
    VersioIgnota {
        string message
    },
    WireMala {
        string message
    }
}

@ public { }
fn message(CacheError e) → string {
    match e {
        case NomenInane const message {
            return message
        }
        case IdExtra const message {
            return message
        }
        case FormaMismatch const message {
            return message
        }
        case TypoMismatch const message {
            return message
        }
        case DimensioInvalida const message {
            return message
        }
        case ElementaMismatch const message {
            return message
        }
        case VersioIgnota const message {
            return message
        }
        case WireMala const message {
            return message
        }
    }
}

# The cache's schema version (the identity wire form).
const string schema_versio ← "1.0.0"

# The canonical layout tag of the admitted row (the F32 staged carrier).
const string ORDINATIO_STAGED ← "staged"

# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# Staged-tensor construction (the never-firing shape check, re-mapped).
@ private { }
fn _tensor(list<f32> datos, list<int> forma) → tensor.Tensor ⇥ CacheError {
    do {
        return tensor.construct(datos, forma)
    }
    catch err {
        throw variant ElementaMismatch {message = tensor.message(err)}
    }
    throw variant ElementaMismatch {message = "unreachable"}
}

# List element access (the never-firing bounds check, re-mapped to the
# uninitialized fallback — callers validate lengths first).
@ private { }
fn _get(list<f32> datos, int i) → f32 {
    do {
        return datos.get(i)
    }
    catch err {
        return 0.0 - 999.0 ∷ f32
    }
    return 0.0 - 999.0 ∷ f32
}

# "/" and ";" are reserved in the identity wire fields (the U3 wire-safety
# rule).
@ private { }
fn _has_no_separator(string s) → bool {
    var int i ← 0
    while i ≺ s.length() {
        if s.get(i) ≡ "/" or s.get(i) ≡ ";" then return true
        i ← i + 1
    }
    return false
}

@ private { }
fn _digit(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _digit(s.get(i)) then return false
        i ← i + 1
    }
    return true
}

# Tensor field-wise equality (figura + flat data).
@ private { }
fn _tensor_equal(tensor.Tensor a, tensor.Tensor b) → bool {
    if not (a.shape() ≡ b.shape()) then return false
    if not (a.data ≡ b.data) then return false
    return true
}

# -------------------------------------------------------------------------
# KVCache — the typed logical value.
# -------------------------------------------------------------------------


@ public { }
class KVCache {
    string model
    string model_version
    string config
    string tokenizer
    list<int> history
    int layers
    string dtype
    string layout
    tensor.Tensor key
    tensor.Tensor payload
    int version
    int dimension

    # Model name (identity).
    fn model() → string {
        return self.model
    }

    # Model version (identity).
    fn model_version() → string {
        return self.model_version
    }

    # Execution configuration tag (identity; carries the RoPE/scale facts).
    fn config() → string {
        return self.config
    }

    # Tokenizer identity (identity).
    fn tokenizer() → string {
        return self.tokenizer
    }

    # The exact token history (prefix) appended so far.
    fn history() → list<int> {
        return self.history
    }

    # Layer count of the forward row (the identity's layer field).
    fn layers() → int {
        return self.layers
    }

    # Element dtype nomen (identity; "f32" — the admitted row).
    fn dtype() → string {
        return self.dtype
    }

    # Layout tag (identity; "staged").
    fn layout() → string {
        return self.layout
    }

    # The cached K tensor [positions, dimensio].
    fn key() → tensor.Tensor {
        return self.key
    }

    # The cached V tensor [positions, dimensio].
    fn payload() → tensor.Tensor {
        return self.payload
    }

    # Generation (mutation counter: starts 1, bumps per append).
    fn version() → int {
        return self.version
    }

    # The cached feature width.
    fn dimension() → int {
        return self.dimension
    }

    # Cached position count (= the history length).
    fn length() → int {
        return self.history.length()
    }
}

# Field-wise cache equality — the determinism/round-trip predicate.
@ public { }
fn cache_equal(KVCache a, KVCache b) → bool {
    if a.model() ≠ b.model() then return false
    if a.model_version() ≠ b.model_version() then return false
    if a.config() ≠ b.config() then return false
    if a.tokenizer() ≠ b.tokenizer() then return false
    if not (a.history() ≡ b.history()) then return false
    if a.layers() ≠ b.layers() then return false
    if a.dtype() ≠ b.dtype() then return false
    if a.layout() ≠ b.layout() then return false
    if not _tensor_equal(a.key(), b.key()) then return false
    if not _tensor_equal(a.payload(), b.payload()) then return false
    if a.version() ≠ b.version() then return false
    if a.dimension() ≠ b.dimension() then return false
    return true
}

# -------------------------------------------------------------------------
# cache_vacua — a fresh cache: the identity fields, an empty history, an
# empty K/V [0, dimensio], versio 1. Identity fields are non-empty and
# wire-safe (fail closed); the stratorum/dimensio are positive.
# -------------------------------------------------------------------------

@ public { }
fn empty_cache(string model, string model_version, string config, string tokenizer, int layers, int dimension) → KVCache ⇥ CacheError {
    if model.length() ≡ 0 {
        throw variant NomenInane {message = "empty model name"}
    }
    if model_version.length() ≡ 0 {
        throw variant NomenInane {message = "empty model version"}
    }
    if config.length() ≡ 0 {
        throw variant NomenInane {message = "empty execution config"}
    }
    if tokenizer.length() ≡ 0 {
        throw variant NomenInane {message = "empty tokenizer identity"}
    }
    if ((_has_no_separator(model) or _has_no_separator(model_version)) or _has_no_separator(config)) or _has_no_separator(tokenizer) {
        throw variant NomenInane {message = "reserved wire character in identity"}
    }
    if layers ≺ 1 {
        throw variant DimensioInvalida {message = "layer count must be at least one"}
    }
    if dimension ≺ 1 {
        throw variant DimensioInvalida {message = "embedding dimension must be at least one"}
    }
    const tensor.Tensor key ← _tensor([], [0, dimension])
    const tensor.Tensor payload ← _tensor([], [0, dimension])
    return KVCache {model = model, model_version = model_version, config = config, tokenizer = tokenizer, history = vacua, layers = layers, dtype = "f32", layout = ORDINATIO_STAGED, key = key, payload = payload, version = 1, dimension = dimension}
}

# Placeholder Default for `var KVCache` bindings (varia on structs).
# Empty identity and empty staged payloads; not a valid cache.
@ public { }
fn default() → KVCache {
    const tensor.Tensor t ← tensor.default()
    return KVCache {model = "", model_version = "", config = "", tokenizer = "", history = vacua, layers = 0, dtype = "", layout = "", key = t, payload = t, version = 0, dimension = 0}
}

# -------------------------------------------------------------------------
# appende — the ONE mutation: extend the cache by exactly one position.
# The token joins the exact history; the [1, dimensio] f32 K/V extends
# each cached tensor; the generation bumps by 1. Strictly sequential —
# the appended position is always the current history length (no gaps,
# no duplicates). Deterministic and pure.
# -------------------------------------------------------------------------

@ public { }
fn append(KVCache c, int token_id, tensor.Tensor key, tensor.Tensor payload) → KVCache ⇥ CacheError {
    if token_id ≺ 0 {
        throw variant IdExtra {message = "token id must be non-negative"}
    }
    if not (key.shape() ≡ [1, c.dimension()]) {
        throw variant FormaMismatch {message = "K must be [1, dim]"}
    }
    if not (payload.shape() ≡ [1, c.dimension()]) {
        throw variant FormaMismatch {message = "V must be [1, dim]"}
    }
    if dtype.name(key.dtype()) ≠ "f32" {
        throw variant TypoMismatch {message = "unsupported dtype for cache"}
    }
    if dtype.name(payload.dtype()) ≠ "f32" {
        throw variant TypoMismatch {message = "unsupported dtype for cache"}
    }
    var list<int> novum_historia ← c.history()
    novum_historia.append(token_id)
    var list<f32> nova_clavis ← vacua
    for from c.key().data const v {
        nova_clavis.append(v)
    }
    for from key.data const v {
        nova_clavis.append(v)
    }
    var list<f32> nova_valor ← vacua
    for from c.payload().data const v {
        nova_valor.append(v)
    }
    for from payload.data const v {
        nova_valor.append(v)
    }
    const int novus ← c.length() + 1
    return KVCache {model = c.model(), model_version = c.model_version(), config = c.config(), tokenizer = c.tokenizer(), history = novum_historia, layers = c.layers(), dtype = c.dtype(), layout = c.layout(), key = _tensor(nova_clavis, [novus, c.dimension()]), payload = _tensor(nova_valor, [novus, c.dimension()]), version = c.version() + 1, dimension = c.dimension()}
}

# -------------------------------------------------------------------------
# redintegra — the reset rule: a fresh cache with the same identity
# fields, an empty history and empty K/V, versio 1 (fresh state).
# -------------------------------------------------------------------------

@ public { }
fn reset(KVCache c) → KVCache ⇥ CacheError {
    const tensor.Tensor key ← _tensor([], [0, c.dimension()])
    const tensor.Tensor payload ← _tensor([], [0, c.dimension()])
    return KVCache {model = c.model(), model_version = c.model_version(), config = c.config(), tokenizer = c.tokenizer(), history = vacua, layers = c.layers(), dtype = c.dtype(), layout = c.layout(), key = key, payload = payload, version = 1, dimension = c.dimension()}
}

# -------------------------------------------------------------------------
# IdentitasCache — the typed cache identity key (MD-A9 precedent). The
# fields gradus owns: model, model version, execution configuration,
# tokenizer identity, exact token prefix, positions/RoPE facts, layer
# count, dtype, layout. Field-wise equality; a versioned wire round-trip.
# -------------------------------------------------------------------------


@ public { }
class CacheIdentity {
    string model
    string model_version
    string config
    string tokenizer
    string history
    string position
    int layers
    string dtype
    string layout

    fn model() → string {
        return self.model
    }

    fn model_version() → string {
        return self.model_version
    }

    fn config() → string {
        return self.config
    }

    fn tokenizer() → string {
        return self.tokenizer
    }

    fn history() → string {
        return self.history
    }

    fn position() → string {
        return self.position
    }

    fn layers() → int {
        return self.layers
    }

    fn dtype() → string {
        return self.dtype
    }

    fn layout() → string {
        return self.layout
    }
}

# Field-wise identity equality — the key-reuse predicate.
@ public { }
fn cache_identity_equal(CacheIdentity a, CacheIdentity b) → bool {
    if a.model() ≠ b.model() then return false
    if a.model_version() ≠ b.model_version() then return false
    if a.config() ≠ b.config() then return false
    if a.tokenizer() ≠ b.tokenizer() then return false
    if a.history() ≠ b.history() then return false
    if a.position() ≠ b.position() then return false
    if a.layers() ≠ b.layers() then return false
    if a.dtype() ≠ b.dtype() then return false
    if a.layout() ≠ b.layout() then return false
    return true
}

# Derive the identity key from a cache state: the prefix is the
# comma-joined token history; the position span is "0..<count>".
@ public { }
fn cache_identity(KVCache c) → CacheIdentity {
    var string history ← ""
    for range 0‥c.history().length() const i {
        if i ≻ 0 {
            history ← history + ","
        }
        history ← history + (c.history().get(i) coalesce 0 ↦ string)
    }
    return CacheIdentity {model = c.model(), model_version = c.model_version(), config = c.config(), tokenizer = c.tokenizer(), history = history, position = "0.." + (c.length() ↦ string), layers = c.layers(), dtype = c.dtype(), layout = c.layout()}
}

# -------------------------------------------------------------------------
# Identity wire — versioned, exact round-trip. The empty-prefix segment
# uses the documented sentinel "-" (divide/split behavior must not depend
# on empty segments).
# -------------------------------------------------------------------------

@ public { }
fn serialize_identity(CacheIdentity i) → string {
    var string history ← i.history()
    if history.length() ≡ 0 {
        history ← "-"
    }
    return (((((((((((((((((("cache/identity/" + schema_versio) + "/") + i.model()) + "/") + i.model_version()) + "/") + i.config()) + "/") + i.tokenizer()) + "/") + history) + "/") + i.position()) + "/") + (i.layers() ↦ string)) + "/") + i.dtype()) + "/") + i.layout()
}

@ public { }
fn deserialize_identity(string wire) → CacheIdentity ⇥ CacheError {
    const list<string> partes ← wire.split("/")
    if partes.length() ≠ 12 {
        throw variant WireMala {message = "malformed cache identity wire"}
    }
    if partes.get(0) coalesce "" ≠ "cache" {
        throw variant WireMala {message = "unknown cache marker"}
    }
    if partes.get(1) coalesce "" ≠ "identity" {
        throw variant WireMala {message = "unknown cache marker"}
    }
    if partes.get(2) coalesce "" ≠ schema_versio {
        throw variant VersioIgnota {message = "unknown cache schema version"}
    }
    const string model ← partes.get(3) coalesce ""
    const string model_version ← partes.get(4) coalesce ""
    const string config ← partes.get(5) coalesce ""
    const string tokenizer ← partes.get(6) coalesce ""
    var string history ← partes.get(7) coalesce ""
    const string position ← partes.get(8) coalesce ""
    const string stratorum_textus ← partes.get(9) coalesce ""
    const string dtype ← partes.get(10) coalesce ""
    const string layout ← partes.get(11) coalesce ""
    if model.length() ≡ 0 {
        throw variant WireMala {message = "empty model name in cache identity"}
    }
    if model_version.length() ≡ 0 {
        throw variant WireMala {message = "empty model version in cache identity"}
    }
    if config.length() ≡ 0 {
        throw variant WireMala {message = "empty execution config in cache identity"}
    }
    if tokenizer.length() ≡ 0 {
        throw variant WireMala {message = "empty tokenizer identity in cache identity"}
    }
    if history ≡ "-" {
        history ← ""
    }
    if position.length() ≡ 0 {
        throw variant WireMala {message = "malformed position span in cache identity"}
    }
    if not _numeric(stratorum_textus) {
        throw variant WireMala {message = "malformed layer count in cache identity"}
    }
    var int layers ← 0
    do {
        layers ← stratorum_textus ↦ int
    }
    catch err {
        throw variant WireMala {message = "malformed layer count in cache identity"}
    }
    if layers ≺ 1 {
        throw variant WireMala {message = "invalid layer count in cache identity"}
    }
    if dtype.length() ≡ 0 {
        throw variant WireMala {message = "empty dtype in cache identity"}
    }
    if layout.length() ≡ 0 {
        throw variant WireMala {message = "empty layout in cache identity"}
    }
    return CacheIdentity {model = model, model_version = model_version, config = config, tokenizer = tokenizer, history = history, position = position, layers = layers, dtype = dtype, layout = layout}
}
