+++
locale = "en"
+++
# KV-cache values and mutation rules — PML5-U2 (production inference
# computation layer; the campaign never-split unit). W2-U1 adds the
# KVStructure typed descriptor (per-layer-set structure, opened KV
# dtypes, v_layout, GQA sharing) beside the existing logical f32 cache.
#
# Public import: import from "gradus:cache" cache
# Depends on: gradus:dtype (tags/finite), gradus:tensor (value carrier).
#
# Terminology (W0 rename, first touch): the carrier class is
# tensor.NumericBlock — the staged numeric envelope (flat data + shape).
# "Block" elsewhere in this module (dtype block rules, f32_block/f16_block
# strides) is the FORMAT/tiling sense, and transformer-block callers keep
# their own sense. NumericBlock never means either of those.
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own device residency). This module holds no device handle and makes no
# performance claims.
#
# --- Speculative rollback boundary (SD1) ---------------------------------
# Speculative rollback is a value-level operation: take an immutable
# all-layer checkpoint, materialize a private branch, and atomically commit
# the accepted prefix as a fresh state. It must never naively trim or mutate
# a shared cache. Physical allocation, residency, quantization, and
# scheduling remain outside this value contract; no physical handles belong
# in KVCache.
#
# =========================================================================
# The KV-cache contract (pml5-delivery.md PML5-U2)
# =========================================================================
#
# --- The typed logical value ---------------------------------------------
# KVCache is the per-session key/value state the decode serves: one K/V
# pair per layer of the forward row (the gradus row is a single
# transformer block — layers = 1), each an [positions, dimension] f32
# staged tensor, plus the exact token history (history) and the
# identity fields (model / model version / execution config / tokenizer
# identity). No device handle, no physical residency.
#
# --- Declared mutation rules (KV-A A1) -----------------------------------
#   * Capacity: construction copies KVStructure.context_length into
#     immutable KVCache.capacity. append/extend read that bound; they
#     do not take the structure again or a write position.
#   * Append per position (append): extends the K/V by exactly ONE
#     position and the history by one token. The write position is the
#     current length. Gaps and overflow reject before mutation.
#   * Extend (extend): the same sequential rule for T rows. Generation
#     bumps by 1 on a successful write.
#   * Generation: version starts at 1 and advances by 1 on every
#     successful append, extend, or reset. A rejected write leaves
#     rows, capacity, and generation unchanged.
#   * Reset: empty history and empty K/V, same identity and capacity,
#     generation advanced by 1 (logical prompt reset / sequence epoch).
#
# --- Cache identity key (MD-A9 precedent) --------------------------------
# The cache's identity (CacheIdentity) is a typed record over the MD-A9
# key fields gradus owns: model, model version, execution configuration,
# tokenizer identity, exact token prefix/history, positions/RoPE facts,
# layer count, dtype, and layout. A versioned wire form round-trips the
# key exactly; identity equality is field-wise (the product repo / NGAB
# consume the exact key — never a second authority). The empty-prefix
# wire segment uses the documented sentinel "-".
#
# --- Evidence honesty (CTO Q2, hard) -------------------------------------
# This surface is the STRUCTURAL proof: the mutation rules and the
# identity-key facts are compile-validated and proven by the co-located
# proba. The append/readback arithmetic is exact concatenation (no
# rounding — pins are exact); the identity-key facts are exact text/
# number pins. Library-to-library calls execute on the FMIR stepper
# (radix 43c0102ba; regression-locked by 2e8042ae7). This surface does
# not claim executed VALUE identity; PML5-U2 remains PARTIAL pending
# the auditor-owned runtime-evidence gate.
#
# --- KVStructure (W2-U1 + W5c-U8) ----------------------------------------
# Semantic descriptor lowered into plan facts and consumed as GI4
# KvCacheLayout. Per-layer-set cache class: Dense | SlidingWindow |
# CompressedHca {ratio in {4, 128}} | Indexer. kv_dtype_k/v from the
# opened set {F32, F16, Q8_0, Q4_K} (F16 default). The executed KVCache
# today is f32-staged: dtype() is "f32" and layout() is "staged"
# (cache.fab:265-273, :362, :398-399). Closing that gap is
# production-ml-library execution-tier scope. v_layout is linked to the
# attention family, Single | GqaShared. The indexer cache is its own
# partition class (IndexerBudget bytes), not a KvDtype. GI4 slots /
# context / reserve_policy facts stay; infeasible bundles fail closed
# here (quantized-V requires the flash-attention family; block size
# must divide the flattened KV width; indexer class requires its
# partition budget; HCA ratio is the admitted pair). Dense/SWA-only
# wires stay cache/structure/1.0.0. Additive HCA / Indexer / partition
# fields emit cache/structure/1.1.0. Does not widen cache/identity/1.0.0.
import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# CacheError — typed error vocabulary of the KV-cache surface.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------


@ public
union CacheError {
    @ shared
    string message

    EmptyName,
    IdOutOfRange,
    ShapeMismatch,
    DtypeMismatch,
    InvalidDimension,
    ElementMismatch,
    UnknownVersion,
    BadWire,
    InvalidCombination,
    Overflow,
    Gap,
    ProfileUnavailable,
    TensorFailure {
        tensor.TensorError inner
    }
}

@ conversion
fn from_tensor_error(tensor.TensorError err) → CacheError {
    return variant TensorFailure {message = err.message, inner = err}
}



# The cache's schema version (the identity wire form).
const string schema_version ← "1.0.0"

# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# Staged-tensor construction (the never-firing shape check, re-mapped).
fn _tensor(list<f32> data, list<int> shape) → tensor.NumericBlock ⇥ CacheError {
    return tensor.construct(data, shape)
}

# Immutable typed concatenation keeps source order while exposing the list
# shape to the collection reducer.
fn _append_f32(list<f32> base, list<f32> values) → list<f32> {
    return values.reduce((list<f32> out, f32 value) ∴ out.added(value), base)
}

# "/" and ";" are reserved in the identity wire fields (the U3 wire-safety
# rule).
fn _contains_separator(string s) → bool {
    return s.contains("/") or s.contains(";")
}

fn _digit(string c) → bool {
    return c between "0123456789"
}

fn _numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    # Keep: validation must short-circuit on the first invalid character;
    # filter/map would change that failable boundary and still need a scan.
    for from s const c {
        if not _digit(c ↦ string) then return false
    }
    return true
}

# NumericBlock field-wise equality (shape + flat data).
fn _tensor_equal(tensor.NumericBlock a, tensor.NumericBlock b) → bool {
    if not (a.shape() ≡ b.shape()) then return false
    if not (a.data ≡ b.data) then return false
    return true
}

# -------------------------------------------------------------------------
# KVCache — the typed logical value.
# -------------------------------------------------------------------------


@ public
class KVCache {
    string model
    string model_version
    string config
    string tokenizer
    list<int> history
    int layers
    string dtype
    string layout
    tensor.NumericBlock key
    tensor.NumericBlock payload
    int version
    int dimension
    int capacity

    # Model name (identity).
    fn model() → string {
        return self.model
    }

    # Model version (identity).
    fn model_version() → string {
        return self.model_version
    }

    # Execution configuration tag (identity; carries the RoPE/scale facts).
    fn config() → string {
        return self.config
    }

    # Tokenizer identity (identity).
    fn tokenizer() → string {
        return self.tokenizer
    }

    # The exact token history (prefix) appended so far.
    fn history() → list<int> {
        return self.history
    }

    # Layer count of the forward row (the identity's layer field).
    fn layers() → int {
        return self.layers
    }

    # Element dtype name (identity; "f32" — the admitted row).
    fn dtype() → string {
        return self.dtype
    }

    # Layout tag (identity; "staged").
    fn layout() → string {
        return self.layout
    }

    # The cached K tensor [positions, dimension].
    fn key() → tensor.NumericBlock {
        return self.key
    }

    # The cached V tensor [positions, dimension].
    fn payload() → tensor.NumericBlock {
        return self.payload
    }

    # Generation (starts 1; bumps on successful append, extend, or reset).
    fn version() → int {
        return self.version
    }

    # The cached feature width.
    fn dimension() → int {
        return self.dimension
    }

    # Immutable admission bound copied from KVStructure.context_length.
    fn capacity() → int {
        return self.capacity
    }

    # Cached position count (= the history length). Distinct from capacity.
    fn length() → int {
        return self.history.length()
    }
}

# Field-wise cache equality — the determinism/round-trip predicate.
# Convert-or-record: this is a small typed pure leaf whose ordered checks span
# heterogeneous fields; no collection intrinsic covers the short-circuit shape.
@ public
fn cache_equal(KVCache a, KVCache b) → bool {
    if a.model() ≠ b.model() then return false
    if a.model_version() ≠ b.model_version() then return false
    if a.config() ≠ b.config() then return false
    if a.tokenizer() ≠ b.tokenizer() then return false
    if not (a.history() ≡ b.history()) then return false
    if a.layers() ≠ b.layers() then return false
    if a.dtype() ≠ b.dtype() then return false
    if a.layout() ≠ b.layout() then return false
    if not _tensor_equal(a.key(), b.key()) then return false
    if not _tensor_equal(a.payload(), b.payload()) then return false
    if a.version() ≠ b.version() then return false
    if a.dimension() ≠ b.dimension() then return false
    if a.capacity() ≠ b.capacity() then return false
    return true
}

# Unstructured empty_cache helper bound. Structure-aware construction
# (empty_layers) copies KVStructure.context_length instead.
const int HELPER_CAPACITY ← 2048

fn _row_count(tensor.NumericBlock t) → int {
    if t.shape().length() ≺ 1 then return 0
    return t.shape().get(0) coalesce 0
}

# Gap and overflow reject before any new rows are assembled.
fn _admit_write(KVCache c, int added) → bool ⇥ CacheError {
    const int write_position ← c.length()
    require write_position ≡ _row_count(c.key()) throw variant Gap {message = "cache write leaves a gap"}
    require write_position ≡ _row_count(c.payload()) throw variant Gap {message = "cache write leaves a gap"}
    require write_position + added ≤ c.capacity() throw variant Overflow {message = "cache overflow"}
    return true
}

fn _keep(KVCache c, list<int> history, tensor.NumericBlock key, tensor.NumericBlock payload, int version) → KVCache {
    return KVCache {model = c.model(), model_version = c.model_version(), config = c.config(), tokenizer = c.tokenizer(), history = history, layers = c.layers(), dtype = c.dtype(), layout = c.layout(), key = key, payload = payload, version = version, dimension = c.dimension(), capacity = c.capacity()}
}

fn _empty_cache(string model, string model_version, string config, string tokenizer, int layers, int dimension, int capacity) → KVCache ⇥ CacheError {
    require model.length() ≠ 0 throw variant EmptyName {message = "empty model name"}
    require model_version.length() ≠ 0 throw variant EmptyName {message = "empty model version"}
    require config.length() ≠ 0 throw variant EmptyName {message = "empty execution config"}
    require tokenizer.length() ≠ 0 throw variant EmptyName {message = "empty tokenizer identity"}
    require not (((_contains_separator(model) or _contains_separator(model_version)) or _contains_separator(config)) or _contains_separator(tokenizer)) throw variant EmptyName {message = "reserved wire character in identity"}
    require layers ≥ 1 throw variant InvalidDimension {message = "layer count must be at least one"}
    require dimension ≥ 1 throw variant InvalidDimension {message = "embedding dimension must be at least one"}
    require capacity ≥ 1 throw variant InvalidDimension {message = "capacity must be at least one"}
    const tensor.NumericBlock key ← _tensor([], [0, dimension])
    const tensor.NumericBlock payload ← _tensor([], [0, dimension])
    return KVCache {model = model, model_version = model_version, config = config, tokenizer = tokenizer, history = empty, layers = layers, dtype = "f32", layout = "staged", key = key, payload = payload, version = 1, dimension = dimension, capacity = capacity}
}

# -------------------------------------------------------------------------
# empty_cache — a fresh cache: the identity fields, an empty history, an
# empty K/V [0, dimension], version 1. Identity fields are non-empty and
# wire-safe (fail closed); the layers/dimension/capacity are positive.
# The 6-arg helper uses HELPER_CAPACITY. empty_layers copies
# KVStructure.context_length as the immutable admission bound.
# -------------------------------------------------------------------------

@ public
fn empty_cache(string model, string model_version, string config, string tokenizer, int layers, int dimension) → KVCache ⇥ CacheError {
    return _empty_cache(model, model_version, config, tokenizer, layers, dimension, HELPER_CAPACITY)
}

# Placeholder Default for `var KVCache` bindings (var on structs).
# Empty identity and empty staged payloads; not a valid cache.
@ public
fn default() → KVCache {
    const tensor.NumericBlock t ← tensor.default()
    return KVCache {model = "", model_version = "", config = "", tokenizer = "", history = empty, layers = 0, dtype = "", layout = "", key = t, payload = t, version = 0, dimension = 0, capacity = 0}
}

# -------------------------------------------------------------------------
# append — the ONE mutation: extend the cache by exactly one position.
# The token joins the exact history; the [1, dimension] f32 K/V extends
# each cached tensor; the generation bumps by 1. Write position is the
# current length. Gaps and overflow reject before any new rows exist.
# -------------------------------------------------------------------------

@ public
fn append(KVCache c, int token_id, tensor.NumericBlock key, tensor.NumericBlock payload) → KVCache ⇥ CacheError {
    require token_id ≥ 0 throw variant IdOutOfRange {message = "token id must be non-negative"}
    require key.shape() ≡ ([1, c.dimension()] ↦ list<int>) throw variant ShapeMismatch {message = "K must be [1, dim]"}
    require payload.shape() ≡ ([1, c.dimension()] ↦ list<int>) throw variant ShapeMismatch {message = "V must be [1, dim]"}
    require dtype.name(key.dtype()) ≡ "f32" throw variant DtypeMismatch {message = "unsupported dtype for cache"}
    require dtype.name(payload.dtype()) ≡ "f32" throw variant DtypeMismatch {message = "unsupported dtype for cache"}
    _admit_write(c, 1)
    const list<int> new_history ← c.history().added(token_id)
    const list<f32> new_key ← _append_f32(c.key().data, key.data)
    const list<f32> new_payload ← _append_f32(c.payload().data, payload.data)
    const int new_len ← c.length() + 1
    return _keep(c, new_history, _tensor(new_key, [new_len, c.dimension()]), _tensor(new_payload, [new_len, c.dimension()]), c.version() + 1)
}

# -------------------------------------------------------------------------
# extend — append T new positions in one mutation (the prefill write).
# tokens, key, and payload must share length T; each new K/V row is [T, dim].
# Generation bumps by 1 (one write). Write position is the current length.
# Gaps and overflow reject before any new rows exist.
# -------------------------------------------------------------------------

@ public
fn extend(KVCache c, list<int> tokens, tensor.NumericBlock key, tensor.NumericBlock payload) → KVCache ⇥ CacheError {
    require tokens.length() ≠ 0 throw variant ElementMismatch {message = "empty token list"}
    require key.shape() ≡ ([tokens.length(), c.dimension()] ↦ list<int>) throw variant ShapeMismatch {message = "K must be [T, dim]"}
    require payload.shape() ≡ ([tokens.length(), c.dimension()] ↦ list<int>) throw variant ShapeMismatch {message = "V must be [T, dim]"}
    require dtype.name(key.dtype()) ≡ "f32" throw variant DtypeMismatch {message = "unsupported dtype for cache"}
    require dtype.name(payload.dtype()) ≡ "f32" throw variant DtypeMismatch {message = "unsupported dtype for cache"}
    _admit_write(c, tokens.length())
    # Keep: token validation must reject the first bad id before any new
    # collection is assembled; a transform cannot preserve this boundary.
    for from tokens const token_id {
        require token_id ≥ 0 throw variant IdOutOfRange {message = "token id must be non-negative"}
    }
    const list<int> new_history ← tokens.reduce((list<int> out, int token_id) ∴ out.added(token_id), c.history())
    const list<f32> new_key ← _append_f32(c.key().data, key.data)
    const list<f32> new_payload ← _append_f32(c.payload().data, payload.data)
    const int new_len ← c.length() + tokens.length()
    return _keep(c, new_history, _tensor(new_key, [new_len, c.dimension()]), _tensor(new_payload, [new_len, c.dimension()]), c.version() + 1)
}

# -------------------------------------------------------------------------
# reset — logical prompt reset: empty history and empty K/V, same
# identity fields and immutable capacity, generation advanced by 1.
# -------------------------------------------------------------------------

@ public
fn reset(KVCache c) → KVCache ⇥ CacheError {
    const tensor.NumericBlock key ← _tensor([], [0, c.dimension()])
    const tensor.NumericBlock payload ← _tensor([], [0, c.dimension()])
    return _keep(c, empty, key, payload, c.version() + 1)
}

# -------------------------------------------------------------------------
# CacheIdentity — the typed cache identity key (MD-A9 precedent). The
# fields gradus owns: model, model version, execution configuration,
# tokenizer identity, exact token prefix, positions/RoPE facts, layer
# count, dtype, layout. Field-wise equality; a versioned wire round-trip.
# -------------------------------------------------------------------------


@ public
class CacheIdentity {
    string model
    string model_version
    string config
    string tokenizer
    string history
    string position
    int layers
    string dtype
    string layout

    fn model() → string {
        return self.model
    }

    fn model_version() → string {
        return self.model_version
    }

    fn config() → string {
        return self.config
    }

    fn tokenizer() → string {
        return self.tokenizer
    }

    fn history() → string {
        return self.history
    }

    fn position() → string {
        return self.position
    }

    fn layers() → int {
        return self.layers
    }

    fn dtype() → string {
        return self.dtype
    }

    fn layout() → string {
        return self.layout
    }
}

# Field-wise identity equality — the key-reuse predicate.
@ public
fn cache_identity_equal(CacheIdentity a, CacheIdentity b) → bool {
    if a.model() ≠ b.model() then return false
    if a.model_version() ≠ b.model_version() then return false
    if a.config() ≠ b.config() then return false
    if a.tokenizer() ≠ b.tokenizer() then return false
    if a.history() ≠ b.history() then return false
    if a.position() ≠ b.position() then return false
    if a.layers() ≠ b.layers() then return false
    if a.dtype() ≠ b.dtype() then return false
    if a.layout() ≠ b.layout() then return false
    return true
}

# Derive the identity key from a cache state: the prefix is the
# comma-joined token history; the position span is "0..<count>".
@ public
fn cache_identity(KVCache c) → CacheIdentity {
    const string history ← c.history().reduce((string out, int token) ∴ out.length() ≡ 0 ? (token ↦ string) : "§,§"(out, token ↦ string), "")
    return CacheIdentity {model = c.model(), model_version = c.model_version(), config = c.config(), tokenizer = c.tokenizer(), history = history, position = "0..§"(c.length() ↦ string), layers = c.layers(), dtype = c.dtype(), layout = c.layout()}
}

# -------------------------------------------------------------------------
# Identity wire — versioned, exact round-trip. The empty-prefix segment
# uses the documented sentinel "-" (divide/split behavior must not depend
# on empty segments).
# -------------------------------------------------------------------------

@ public
fn serialize_identity(CacheIdentity i) → string {
    var string history ← i.history()
    if history.length() ≡ 0 {
        history ← "-"
    }
    return "cache/identity/§/§/§/§/§/§/§/§/§/§"(schema_version, i.model(), i.model_version(), i.config(), i.tokenizer(), history, i.position(), i.layers() ↦ string, i.dtype(), i.layout())
}

# Convert-or-record: wire validation and conversion must retain the exact
# first-failure error order; no closure intrinsic covers this failable parser.
@ public
fn deserialize_identity(string wire) → CacheIdentity ⇥ CacheError {
    const list<string> parts ← wire.split("/")
    require parts.length() ≡ 12 throw variant BadWire {message = "malformed cache identity wire"}
    require parts.get(0) coalesce "" ≡ "cache" throw variant BadWire {message = "unknown cache marker"}
    require parts.get(1) coalesce "" ≡ "identity" throw variant BadWire {message = "unknown cache marker"}
    require parts.get(2) coalesce "" ≡ schema_version throw variant UnknownVersion {message = "unknown cache schema version"}
    const string model ← parts.get(3) coalesce ""
    const string model_version ← parts.get(4) coalesce ""
    const string config ← parts.get(5) coalesce ""
    const string tokenizer ← parts.get(6) coalesce ""
    var string history ← parts.get(7) coalesce ""
    const string position ← parts.get(8) coalesce ""
    const string layers_text ← parts.get(9) coalesce ""
    const string dtype ← parts.get(10) coalesce ""
    const string layout ← parts.get(11) coalesce ""
    require model.length() ≠ 0 throw variant BadWire {message = "empty model name in cache identity"}
    require model_version.length() ≠ 0 throw variant BadWire {message = "empty model version in cache identity"}
    require config.length() ≠ 0 throw variant BadWire {message = "empty execution config in cache identity"}
    require tokenizer.length() ≠ 0 throw variant BadWire {message = "empty tokenizer identity in cache identity"}
    if history ≡ "-" {
        history ← ""
    }
    require position.length() ≠ 0 throw variant BadWire {message = "malformed position span in cache identity"}
    require _numeric(layers_text) throw variant BadWire {message = "malformed layer count in cache identity"}
    var int layers ← 0
    do {
        layers ↤ layers_text
    }
    catch err {
        throw variant BadWire {message = "malformed layer count in cache identity"}
    }
    require layers ≥ 1 throw variant BadWire {message = "invalid layer count in cache identity"}
    require dtype.length() ≠ 0 throw variant BadWire {message = "empty dtype in cache identity"}
    require layout.length() ≠ 0 throw variant BadWire {message = "empty layout in cache identity"}
    return CacheIdentity {model = model, model_version = model_version, config = config, tokenizer = tokenizer, history = history, position = position, layers = layers, dtype = dtype, layout = layout}
}

# -------------------------------------------------------------------------
# KVStructure — W2-U1 typed descriptor (design §4.3). Semantic facts
# Gradus owns; Radix consumes them into the attention-recipe bundle;
# Hosts still consume GI4 KvCacheLayout bytes, never re-derived here.
# -------------------------------------------------------------------------

const string structure_schema ← "1.0.0"

const string structure_schema_v11 ← "1.1.0"

const string RESERVE_GI4 ← "gi4-reserve"

const int HCA_RATIO_4 ← 4

const int HCA_RATIO_128 ← 128

const int Q8_0_BLOCK ← 32

const int Q4_K_BLOCK ← 256

# Opened GI4 KV dtype set (operator-accepted 2026-08-18, need 1d3967ed).
@ public
union KvDtype {
    F32,
    F16,
    Q8_0,
    Q4_K
}

@ public
union SwaType {
    Standard,
    Chunked,
    Symmetric
}

@ public
union LayerStructure {
    Dense,
    SlidingWindow {
        int window
        SwaType swa_kind
    },
    CompressedHca {
        int ratio
    },
    Indexer
}

@ public
union CachePartition {
    IndexerBudget {
        int bytes
    }
}

@ public
union VLayout {
    Transposed,
    Straight
}

@ public
union KvSharing {
    Single,
    GqaShared
}

@ public
union AttentionFamily {
    Classic,
    Flash
}

@ public
fn kv_dtype_f32() → KvDtype {
    return variant F32
}

@ public
fn kv_dtype_f16() → KvDtype {
    return variant F16
}

@ public
fn kv_dtype_q8_0() → KvDtype {
    return variant Q8_0
}

@ public
fn kv_dtype_q4_k() → KvDtype {
    return variant Q4_K
}

@ public
fn kv_dtype_name(KvDtype t) → string {
    match t {
        case F32 {
            return "f32"
        }
        case F16 {
            return "f16"
        }
        case Q8_0 {
            return "q8_0"
        }
        case Q4_K {
            return "q4_k"
        }
    }
}

@ public
fn kv_dtype_eq(KvDtype a, KvDtype b) → bool {
    return kv_dtype_name(a) ≡ kv_dtype_name(b)
}

fn _kv_dtype_from_name(string s) → KvDtype ⇥ CacheError {
    if s ≡ "f32" then return variant F32
    if s ≡ "f16" then return variant F16
    if s ≡ "q8_0" then return variant Q8_0
    if s ≡ "q4_k" then return variant Q4_K
    throw variant DtypeMismatch {message = "unadmitted kv dtype"}
}

fn _kv_dtype_quantized(KvDtype t) → bool {
    match t {
        case F32 {
            return false
        }
        case F16 {
            return false
        }
        case Q8_0 {
            return true
        }
        case Q4_K {
            return true
        }
    }
}

@ public
fn swa_standard() → SwaType {
    return variant Standard
}

@ public
fn swa_chunked() → SwaType {
    return variant Chunked
}

@ public
fn swa_symmetric() → SwaType {
    return variant Symmetric
}

@ public
fn swa_type_name(SwaType t) → string {
    match t {
        case Standard {
            return "standard"
        }
        case Chunked {
            return "chunked"
        }
        case Symmetric {
            return "symmetric"
        }
    }
}

@ public
fn swa_type_eq(SwaType a, SwaType b) → bool {
    return swa_type_name(a) ≡ swa_type_name(b)
}

fn _swa_type_from_name(string s) → SwaType ⇥ CacheError {
    if s ≡ "standard" then return variant Standard
    if s ≡ "chunked" then return variant Chunked
    if s ≡ "symmetric" then return variant Symmetric
    throw variant InvalidCombination {message = "unknown swa type"}
}

@ public
fn dense_structure() → LayerStructure {
    return variant Dense
}

@ public
fn sliding_window_structure(int window, SwaType swa_kind) → LayerStructure ⇥ CacheError {
    require window ≥ 1 throw variant InvalidDimension {message = "sliding window n_swa must be at least one"}
    return variant SlidingWindow {window = window, swa_kind = swa_kind}
}

@ public
fn compressed_hca_structure(int ratio) → LayerStructure ⇥ CacheError {
    require ratio ≥ 1 throw variant InvalidDimension {message = "hca compression ratio must be at least one"}
    if ratio ≠ HCA_RATIO_4 {
        require ratio ≡ HCA_RATIO_128 throw variant InvalidCombination {message = "unadmitted hca compression ratio"}
    }
    return variant CompressedHca {ratio = ratio}
}

@ public
fn indexer_structure() → LayerStructure {
    return variant Indexer
}

@ public
fn hca_ratio(LayerStructure s) → int {
    match s {
        case Dense {
            return 0
        }
        case SlidingWindow const window, swa_kind {
            return 0
        }
        case CompressedHca const ratio {
            return ratio
        }
        case Indexer {
            return 0
        }
    }
}

@ public
fn layer_structure_name(LayerStructure s) → string {
    match s {
        case Dense {
            return "dense"
        }
        case SlidingWindow const window, swa_kind {
            return "sliding-window"
        }
        case CompressedHca const ratio {
            return "compressed-hca"
        }
        case Indexer {
            return "indexer"
        }
    }
}

@ public
fn default_cache_partition() → CachePartition {
    return variant IndexerBudget {bytes = 0}
}

@ public
fn indexer_budget(int bytes) → CachePartition ⇥ CacheError {
    require bytes ≥ 1 throw variant InvalidDimension {message = "indexer partition budget must be at least one"}
    return variant IndexerBudget {bytes = bytes}
}

@ public
fn partition_class_name(CachePartition p) → string {
    match p {
        case IndexerBudget const bytes {
            return "indexer"
        }
    }
}

@ public
fn partition_bytes(CachePartition p) → int {
    match p {
        case IndexerBudget const bytes {
            return bytes
        }
    }
}

@ public
fn cache_partition_eq(CachePartition a, CachePartition b) → bool {
    if partition_class_name(a) ≠ partition_class_name(b) then return false
    return partition_bytes(a) ≡ partition_bytes(b)
}

@ public
fn v_layout_transposed() → VLayout {
    return variant Transposed
}

@ public
fn v_layout_straight() → VLayout {
    return variant Straight
}

@ public
fn v_layout_name(VLayout v) → string {
    match v {
        case Transposed {
            return "transposed"
        }
        case Straight {
            return "straight"
        }
    }
}

@ public
fn v_layout_eq(VLayout a, VLayout b) → bool {
    return v_layout_name(a) ≡ v_layout_name(b)
}

fn _v_layout_from_name(string s) → VLayout ⇥ CacheError {
    if s ≡ "transposed" then return variant Transposed
    if s ≡ "straight" then return variant Straight
    throw variant InvalidCombination {message = "unknown v_layout"}
}

@ public
fn sharing_single() → KvSharing {
    return variant Single
}

@ public
fn sharing_gqa() → KvSharing {
    return variant GqaShared
}

@ public
fn sharing_name(KvSharing s) → string {
    match s {
        case Single {
            return "single"
        }
        case GqaShared {
            return "gqa"
        }
    }
}

@ public
fn sharing_eq(KvSharing a, KvSharing b) → bool {
    return sharing_name(a) ≡ sharing_name(b)
}

fn _sharing_from_name(string s) → KvSharing ⇥ CacheError {
    if s ≡ "single" then return variant Single
    if s ≡ "gqa" then return variant GqaShared
    throw variant InvalidCombination {message = "unknown sharing"}
}

@ public
fn attention_classic() → AttentionFamily {
    return variant Classic
}

@ public
fn attention_flash() → AttentionFamily {
    return variant Flash
}

@ public
fn attention_family_name(AttentionFamily f) → string {
    match f {
        case Classic {
            return "classic"
        }
        case Flash {
            return "flash"
        }
    }
}

@ public
fn attention_family_eq(AttentionFamily a, AttentionFamily b) → bool {
    return attention_family_name(a) ≡ attention_family_name(b)
}

fn _attention_family_from_name(string s) → AttentionFamily ⇥ CacheError {
    if s ≡ "classic" then return variant Classic
    if s ≡ "flash" then return variant Flash
    throw variant InvalidCombination {message = "unknown attention family"}
}

fn _attention_is_flash(AttentionFamily f) → bool {
    match f {
        case Classic {
            return false
        }
        case Flash {
            return true
        }
    }
}

fn _v_layout_is_straight(VLayout v) → bool {
    match v {
        case Transposed {
            return false
        }
        case Straight {
            return true
        }
    }
}

fn _sharing_is_gqa(KvSharing s) → bool {
    match s {
        case Single {
            return false
        }
        case GqaShared {
            return true
        }
    }
}

# -------------------------------------------------------------------------
# KVProfile — cache-local admission law. A profile carries the family
# layout law, opened dtype set, dtype block rules, quantized-V rule, and
# reserve tag. GI4 is today's admitted law; CUDA stays an empty slot until
# device receipts exist.
# -------------------------------------------------------------------------

@ public
class KVProfile {
    string name
    list<VLayout> classic_v_layouts
    list<VLayout> flash_v_layouts
    bool quantized_v_requires_flash
    list<KvDtype> kv_dtypes
    int f32_block
    int f16_block
    int q8_0_block
    int q4_k_block
    string reserve_policy
    bool admitted

    fn name() → string {
        return self.name
    }

    fn classic_v_layouts() → list<VLayout> {
        return self.classic_v_layouts
    }

    fn flash_v_layouts() → list<VLayout> {
        return self.flash_v_layouts
    }

    fn quantized_v_requires_flash() → bool {
        return self.quantized_v_requires_flash
    }

    fn kv_dtypes() → list<KvDtype> {
        return self.kv_dtypes
    }

    fn f32_block() → int {
        return self.f32_block
    }

    fn f16_block() → int {
        return self.f16_block
    }

    fn q8_0_block() → int {
        return self.q8_0_block
    }

    fn q4_k_block() → int {
        return self.q4_k_block
    }

    fn reserve_policy() → string {
        return self.reserve_policy
    }

    fn admitted() → bool {
        return self.admitted
    }
}

@ public
fn profile_gi4() → KVProfile {
    var list<VLayout> classic_v_layouts ← empty
    classic_v_layouts.append(v_layout_transposed())
    var list<VLayout> flash_v_layouts ← empty
    flash_v_layouts.append(v_layout_straight())
    var list<KvDtype> kv_dtypes ← empty
    kv_dtypes.append(kv_dtype_f32())
    kv_dtypes.append(kv_dtype_f16())
    kv_dtypes.append(kv_dtype_q8_0())
    kv_dtypes.append(kv_dtype_q4_k())
    return KVProfile {name = "gi4", classic_v_layouts = classic_v_layouts, flash_v_layouts = flash_v_layouts, quantized_v_requires_flash = true, kv_dtypes = kv_dtypes, f32_block = 1, f16_block = 1, q8_0_block = Q8_0_BLOCK, q4_k_block = Q4_K_BLOCK, reserve_policy = RESERVE_GI4, admitted = true}
}

@ public
fn profile_cuda() → KVProfile {
    return KVProfile {name = "cuda", classic_v_layouts = empty, flash_v_layouts = empty, quantized_v_requires_flash = false, kv_dtypes = empty, f32_block = 0, f16_block = 0, q8_0_block = 0, q4_k_block = 0, reserve_policy = "", admitted = false}
}

# Keep: these are short-circuit membership checks over tagged union values;
# between has no covering nominal-union equality form here.
fn _profile_has_v_layout(list<VLayout> allowed, VLayout target) → bool {
    for from allowed const candidate {
        if v_layout_eq(candidate, target) then return true
    }
    return false
}

fn _profile_has_dtype(list<KvDtype> allowed, KvDtype target) → bool {
    for from allowed const candidate {
        if kv_dtype_eq(candidate, target) then return true
    }
    return false
}

fn _profile_dtype_block(KVProfile profile, KvDtype t) → int {
    match t {
        case F32 {
            return profile.f32_block()
        }
        case F16 {
            return profile.f16_block()
        }
        case Q8_0 {
            return profile.q8_0_block()
        }
        case Q4_K {
            return profile.q4_k_block()
        }
    }
}

# -------------------------------------------------------------------------
# LayerSet — one per-layer-set cache-class slice of the model.
# Dense / SlidingWindow / CompressedHca are KV classes. Indexer is a
# partition class assigned per layer set; it is not a KvDtype.
# -------------------------------------------------------------------------

@ public
class LayerSet {
    list<int> indices
    LayerStructure structure
    int kv_heads
    int head_dim

    fn indices() → list<int> {
        return self.indices
    }

    fn structure() → LayerStructure {
        return self.structure
    }

    fn kv_heads() → int {
        return self.kv_heads
    }

    fn head_dim() → int {
        return self.head_dim
    }
}

@ public
fn default_layer_set() → LayerSet {
    return LayerSet {indices = empty, structure = dense_structure(), kv_heads = 0, head_dim = 0}
}

fn _index_seen(list<int> seen, int idx) → bool {
    return idx between seen
}

@ public
fn construct_layer_set(list<int> indices, LayerStructure structure, int kv_heads, int head_dim) → LayerSet ⇥ CacheError {
    require indices.length() ≥ 1 throw variant InvalidDimension {message = "layer set indices must be at least one"}
    require kv_heads ≥ 1 throw variant InvalidDimension {message = "kv head count must be at least one"}
    require head_dim ≥ 1 throw variant InvalidDimension {message = "head dim must be at least one"}
    var list<int> seen ← empty
    # Keep: duplicate detection is an ordered, fail-closed validation walk;
    # the growing seen list is part of the check, not a reduction result.
    for from indices const idx {
        require idx ≥ 0 throw variant InvalidDimension {message = "invalid layer index"}
        require not _index_seen(seen, idx) throw variant InvalidCombination {message = "duplicate layer index"}
        seen.append(idx)
    }
    match structure {
        case Dense {
            return LayerSet {indices = indices, structure = dense_structure(), kv_heads = kv_heads, head_dim = head_dim}
        }
        case SlidingWindow const window, swa_kind {
            return LayerSet {indices = indices, structure = sliding_window_structure(window, swa_kind), kv_heads = kv_heads, head_dim = head_dim}
        }
        case CompressedHca const ratio {
            return LayerSet {indices = indices, structure = compressed_hca_structure(ratio), kv_heads = kv_heads, head_dim = head_dim}
        }
        case Indexer {
            return LayerSet {indices = indices, structure = indexer_structure(), kv_heads = kv_heads, head_dim = head_dim}
        }
    }
}

# -------------------------------------------------------------------------
# KVStructure — the admitted bundle. F16 / Dense / family-linked default.
# partitions is the non-KV ledger (indexer cache budget). Empty for
# Dense/SWA-only 1.0.0 wires.
# -------------------------------------------------------------------------

@ public
class KVStructure {
    list<LayerSet> layers
    KvDtype kv_dtype_k
    KvDtype kv_dtype_v
    VLayout v_layout
    KvSharing sharing
    AttentionFamily attention_family
    int query_heads
    int slots
    int context_length
    string reserve_policy
    list<CachePartition> partitions

    fn layers() → list<LayerSet> {
        return self.layers
    }

    fn kv_dtype_k() → KvDtype {
        return self.kv_dtype_k
    }

    fn kv_dtype_v() → KvDtype {
        return self.kv_dtype_v
    }

    fn v_layout() → VLayout {
        return self.v_layout
    }

    fn sharing() → KvSharing {
        return self.sharing
    }

    fn attention_family() → AttentionFamily {
        return self.attention_family
    }

    fn query_heads() → int {
        return self.query_heads
    }

    fn slots() → int {
        return self.slots
    }

    fn context_length() → int {
        return self.context_length
    }

    fn reserve_policy() → string {
        return self.reserve_policy
    }

    fn partitions() → list<CachePartition> {
        return self.partitions
    }
}

@ public
fn default_kv_structure() → KVStructure {
    return KVStructure {layers = empty, kv_dtype_k = kv_dtype_f16(), kv_dtype_v = kv_dtype_f16(), v_layout = v_layout_transposed(), sharing = sharing_single(), attention_family = attention_classic(), query_heads = 0, slots = 0, context_length = 0, reserve_policy = "gi4-reserve", partitions = empty}
}

fn _layer_set_eq(LayerSet a, LayerSet b) → bool {
    if not (a.indices() ≡ b.indices()) then return false
    if layer_structure_name(a.structure()) ≠ layer_structure_name(b.structure()) then return false
    if a.kv_heads() ≠ b.kv_heads() then return false
    if a.head_dim() ≠ b.head_dim() then return false
    match a.structure() {
        case Dense {
            return true
        }
        case SlidingWindow const window_a, swa_a {
            match b.structure() {
                case Dense {
                    return false
                }
                case SlidingWindow const window_b, swa_b {
                    if window_a ≠ window_b then return false
                    return swa_type_eq(swa_a, swa_b)
                }
                case CompressedHca const ratio_b {
                    return false
                }
                case Indexer {
                    return false
                }
            }
        }
        case CompressedHca const ratio_a {
            match b.structure() {
                case Dense {
                    return false
                }
                case SlidingWindow const window_b, swa_b {
                    return false
                }
                case CompressedHca const ratio_b {
                    return ratio_a ≡ ratio_b
                }
                case Indexer {
                    return false
                }
            }
        }
        case Indexer {
            match b.structure() {
                case Dense {
                    return false
                }
                case SlidingWindow const window_b, swa_b {
                    return false
                }
                case CompressedHca const ratio_b {
                    return false
                }
                case Indexer {
                    return true
                }
            }
        }
    }
}

# Convert-or-record: equality compares two aligned flat carriers and then
# short-circuits through scalar identity fields; the indexed lockstep walks
# are retained under the legacy-L2 bounded-list rule.
@ public
fn kv_structure_equal(KVStructure a, KVStructure b) → bool {
    if a.layers().length() ≠ b.layers().length() then return false
    # legacy-L2: flat list carriers — parallel layer comparison requires indexed access; retain bounded range walk.
    for range 0‥a.layers().length() const i {
        const LayerSet la ← a.layers().get(i) coalesce default_layer_set()
        const LayerSet lb ← b.layers().get(i) coalesce default_layer_set()
        if not _layer_set_eq(la, lb) then return false
    }
    if not kv_dtype_eq(a.kv_dtype_k(), b.kv_dtype_k()) then return false
    if not kv_dtype_eq(a.kv_dtype_v(), b.kv_dtype_v()) then return false
    if not v_layout_eq(a.v_layout(), b.v_layout()) then return false
    if not sharing_eq(a.sharing(), b.sharing()) then return false
    if not attention_family_eq(a.attention_family(), b.attention_family()) then return false
    if a.query_heads() ≠ b.query_heads() then return false
    if a.slots() ≠ b.slots() then return false
    if a.context_length() ≠ b.context_length() then return false
    if a.reserve_policy() ≠ b.reserve_policy() then return false
    if a.partitions().length() ≠ b.partitions().length() then return false
    # legacy-L2: flat list carriers — parallel partition comparison requires indexed access; retain bounded walk.
    for range 0‥a.partitions().length() const p {
        const CachePartition pa ← a.partitions().get(p) coalesce default_cache_partition()
        const CachePartition pb ← b.partitions().get(p) coalesce default_cache_partition()
        if not cache_partition_eq(pa, pb) then return false
    }
    return true
}

fn _check_block(KVProfile profile, KvDtype t, int kv_heads, int head_dim) → bool ⇥ CacheError {
    const int block ← _profile_dtype_block(profile, t)
    const int width ← kv_heads * head_dim
    require width % block ≡ 0 throw variant InvalidCombination {message = "block size does not divide head_dim"}
    return true
}

fn _is_indexer_structure(LayerStructure s) → bool {
    match s {
        case Dense {
            return false
        }
        case SlidingWindow const window, swa_kind {
            return false
        }
        case CompressedHca const ratio {
            return false
        }
        case Indexer {
            return true
        }
    }
}

fn _uses_extended_class(LayerStructure s) → bool {
    match s {
        case Dense {
            return false
        }
        case SlidingWindow const window, swa_kind {
            return false
        }
        case CompressedHca const ratio {
            return true
        }
        case Indexer {
            return true
        }
    }
}

fn _check_class_partitions(list<LayerSet> layers, list<CachePartition> partitions) → bool ⇥ CacheError {
    var int indexer_parts ← 0
    # Keep: each partition is validated before the final cardinality rule;
    # a reducer cannot carry the existing failable validation order.
    for from partitions const part {
        match part {
            case IndexerBudget const bytes {
                require bytes ≥ 1 throw variant InvalidDimension {message = "indexer partition budget must be at least one"}
                indexer_parts ← indexer_parts + 1
            }
        }
    }
    require indexer_parts ≤ 1 throw variant InvalidCombination {message = "duplicate indexer partition"}
    const bool has_indexer ← layers.reduce((bool seen, LayerSet layer) ∴ seen or _is_indexer_structure(layer.structure()), false)
    if has_indexer {
        require indexer_parts ≠ 0 throw variant InvalidCombination {message = "indexer class requires an indexer partition budget"}
    }
    if indexer_parts ≻ 0 {
        require has_indexer throw variant InvalidCombination {message = "indexer partition requires an indexer class"}
    }
    return true
}

fn _check_profile_law(KVProfile profile, KvDtype kv_dtype_k, KvDtype kv_dtype_v, VLayout v_layout, AttentionFamily attention_family) → bool ⇥ CacheError {
    require _profile_has_dtype(profile.kv_dtypes(), kv_dtype_k) throw variant DtypeMismatch {message = "unadmitted kv dtype"}
    require _profile_has_dtype(profile.kv_dtypes(), kv_dtype_v) throw variant DtypeMismatch {message = "unadmitted kv dtype"}
    if profile.quantized_v_requires_flash() and _kv_dtype_quantized(kv_dtype_v) {
        require _attention_is_flash(attention_family) throw variant InvalidCombination {message = "quantized V requires the flash-attention family"}
    }
    if _attention_is_flash(attention_family) {
        require _profile_has_v_layout(profile.flash_v_layouts(), v_layout) throw variant InvalidCombination {message = "flash-attention family requires straight V layout"}
    }
    if not _attention_is_flash(attention_family) {
        require _profile_has_v_layout(profile.classic_v_layouts(), v_layout) throw variant InvalidCombination {message = "classic attention family requires transposed V layout"}
    }
    return true
}

# Convert-or-record: nested admission checks and duplicate tracking must
# preserve fail-closed validation order; no reducer covers these failable walks.
fn _construct_kv_structure_with_profile_and_partitions(KVProfile profile, list<LayerSet> layers, KvDtype kv_dtype_k, KvDtype kv_dtype_v, VLayout v_layout, KvSharing sharing, AttentionFamily attention_family, int query_heads, int slots, int context_length, list<CachePartition> partitions) → KVStructure ⇥ CacheError {
    require profile.admitted() throw variant ProfileUnavailable {message = "cuda profile has no admitted KV layout law; awaiting device receipts (ELP-06/EXEC-02)"}
    require layers.length() ≥ 1 throw variant InvalidDimension {message = "layer set must be at least one"}
    require query_heads ≥ 1 throw variant InvalidDimension {message = "query head count must be at least one"}
    require slots ≥ 1 throw variant InvalidDimension {message = "slots must be at least one"}
    require context_length ≥ 1 throw variant InvalidDimension {message = "context length must be at least one"}
    _check_profile_law(profile, kv_dtype_k, kv_dtype_v, v_layout, attention_family)
    _check_class_partitions(layers, partitions)
    var list<int> kv_seen ← empty
    var list<int> indexer_seen ← empty
    for from layers const layer {
        require layer.indices().length() ≥ 1 throw variant InvalidDimension {message = "layer set indices must be at least one"}
        require layer.kv_heads() ≥ 1 throw variant InvalidDimension {message = "kv head count must be at least one"}
        require layer.head_dim() ≥ 1 throw variant InvalidDimension {message = "head dim must be at least one"}
        const bool indexer ← _is_indexer_structure(layer.structure())
        if not indexer {
            if _sharing_is_gqa(sharing) {
                require layer.kv_heads() ≺ query_heads throw variant InvalidCombination {message = "gqa sharing requires kv_heads < heads"}
                require query_heads % layer.kv_heads() ≡ 0 throw variant InvalidCombination {message = "gqa sharing requires heads to divide by kv_heads"}
            }
            if not _sharing_is_gqa(sharing) {
                require layer.kv_heads() ≡ query_heads throw variant InvalidCombination {message = "single sharing requires kv_heads = heads"}
            }
            _check_block(profile, kv_dtype_k, layer.kv_heads(), layer.head_dim())
            _check_block(profile, kv_dtype_v, layer.kv_heads(), layer.head_dim())
        }
        for from layer.indices() const idx {
            require idx ≥ 0 throw variant InvalidDimension {message = "invalid layer index"}
            if indexer {
                require not _index_seen(indexer_seen, idx) throw variant InvalidCombination {message = "duplicate layer index"}
                indexer_seen.append(idx)
            }
            if not indexer {
                require not _index_seen(kv_seen, idx) throw variant InvalidCombination {message = "duplicate layer index"}
                kv_seen.append(idx)
            }
        }
    }
    return KVStructure {layers = layers, kv_dtype_k = kv_dtype_k, kv_dtype_v = kv_dtype_v, v_layout = v_layout, sharing = sharing, attention_family = attention_family, query_heads = query_heads, slots = slots, context_length = context_length, reserve_policy = profile.reserve_policy(), partitions = partitions}
}

@ public
fn construct_kv_structure_with_profile(KVProfile profile, list<LayerSet> layers, KvDtype kv_dtype_k, KvDtype kv_dtype_v, VLayout v_layout, KvSharing sharing, AttentionFamily attention_family, int query_heads, int slots, int context_length) → KVStructure ⇥ CacheError {
    return _construct_kv_structure_with_profile_and_partitions(profile, layers, kv_dtype_k, kv_dtype_v, v_layout, sharing, attention_family, query_heads, slots, context_length, empty)
}

@ public
fn construct_kv_structure(list<LayerSet> layers, KvDtype kv_dtype_k, KvDtype kv_dtype_v, VLayout v_layout, KvSharing sharing, AttentionFamily attention_family, int query_heads, int slots, int context_length) → KVStructure ⇥ CacheError {
    return construct_kv_structure_with_partitions(layers, kv_dtype_k, kv_dtype_v, v_layout, sharing, attention_family, query_heads, slots, context_length, empty)
}

@ public
fn construct_kv_structure_with_partitions(list<LayerSet> layers, KvDtype kv_dtype_k, KvDtype kv_dtype_v, VLayout v_layout, KvSharing sharing, AttentionFamily attention_family, int query_heads, int slots, int context_length, list<CachePartition> partitions) → KVStructure ⇥ CacheError {
    return _construct_kv_structure_with_profile_and_partitions(profile_gi4(), layers, kv_dtype_k, kv_dtype_v, v_layout, sharing, attention_family, query_heads, slots, context_length, partitions)
}

fn _layer_wire(LayerSet layer) → string {
    var string indices ← ""
    var bool first ← true
    for from layer.indices() const idx {
        if not first {
            indices ← indices + "+"
        }
        indices ← indices + (idx ↦ string)
        first ← false
    }
    const string heads ← layer.kv_heads() ↦ string
    const string dim ← layer.head_dim() ↦ string
    match layer.structure() {
        case Dense {
            return (((indices + ":dense:") + heads) + ":") + dim
        }
        case SlidingWindow const window, swa_kind {
            return (((((((indices + ":swa:") + swa_type_name(swa_kind)) + ":") + (window ↦ string)) + ":") + heads) + ":") + dim
        }
        case CompressedHca const ratio {
            return (((((indices + ":hca:") + (ratio ↦ string)) + ":") + heads) + ":") + dim
        }
        case Indexer {
            return (((indices + ":indexer:") + heads) + ":") + dim
        }
    }
}

fn _parse_indices(string text) → list<int> ⇥ CacheError {
    require text.length() ≠ 0 throw variant BadWire {message = "malformed layer set wire"}
    const list<string> parts ← text.split("+")
    require parts.length() ≥ 1 throw variant BadWire {message = "malformed layer set wire"}
    var list<int> indices ← empty
    # Keep: each index has a typed conversion and ordered error mapping;
    # map/reduce cannot preserve the first malformed wire failure.
    for from parts const part {
        require _numeric(part) throw variant BadWire {message = "malformed layer index in structure wire"}
        var int idx ← 0
        do {
            idx ↤ part
        }
        catch err {
            throw variant BadWire {message = "malformed layer index in structure wire"}
        }
        indices.append(idx)
    }
    return indices
}

# Convert-or-record: each wire shape has a distinct branch and typed
# conversion errors must remain mapped to the existing message.
fn _parse_layer_wire(string text) → LayerSet ⇥ CacheError {
    const list<string> parts ← text.split(":")
    if parts.length() ≡ 4 {
        const string kind ← parts.get(1) coalesce ""
        const string heads_text ← parts.get(2) coalesce ""
        const string dim_text ← parts.get(3) coalesce ""
        require not (not _numeric(heads_text) or not _numeric(dim_text)) throw variant BadWire {message = "malformed layer set wire"}
        var int kv_heads ← 0
        var int head_dim ← 0
        do {
            kv_heads ↤ heads_text
            head_dim ↤ dim_text
        }
        catch err {
            throw variant BadWire {message = "malformed layer set wire"}
        }
        if kind ≡ "dense" {
            return construct_layer_set(_parse_indices(parts.get(0) coalesce ""), dense_structure(), kv_heads, head_dim)
        }
        if kind ≡ "indexer" {
            return construct_layer_set(_parse_indices(parts.get(0) coalesce ""), indexer_structure(), kv_heads, head_dim)
        }
        throw variant BadWire {message = "malformed layer set wire"}
    }
    if parts.length() ≡ 5 {
        require parts.get(1) coalesce "" ≡ "hca" throw variant BadWire {message = "malformed layer set wire"}
        const string ratio_text ← parts.get(2) coalesce ""
        const string heads_text ← parts.get(3) coalesce ""
        const string dim_text ← parts.get(4) coalesce ""
        require not ((not _numeric(ratio_text) or not _numeric(heads_text)) or not _numeric(dim_text)) throw variant BadWire {message = "malformed layer set wire"}
        var int ratio ← 0
        var int kv_heads ← 0
        var int head_dim ← 0
        do {
            ratio ↤ ratio_text
            kv_heads ↤ heads_text
            head_dim ↤ dim_text
        }
        catch err {
            throw variant BadWire {message = "malformed layer set wire"}
        }
        const LayerStructure structure ← compressed_hca_structure(ratio)
        return construct_layer_set(_parse_indices(parts.get(0) coalesce ""), structure, kv_heads, head_dim)
    }
    if parts.length() ≡ 6 {
        require parts.get(1) coalesce "" ≡ "swa" throw variant BadWire {message = "malformed layer set wire"}
        const string window_text ← parts.get(3) coalesce ""
        const string heads_text ← parts.get(4) coalesce ""
        const string dim_text ← parts.get(5) coalesce ""
        require not ((not _numeric(window_text) or not _numeric(heads_text)) or not _numeric(dim_text)) throw variant BadWire {message = "malformed layer set wire"}
        var int window ← 0
        var int kv_heads ← 0
        var int head_dim ← 0
        do {
            window ↤ window_text
            kv_heads ↤ heads_text
            head_dim ↤ dim_text
        }
        catch err {
            throw variant BadWire {message = "malformed layer set wire"}
        }
        const LayerStructure structure ← sliding_window_structure(window, _swa_type_from_name(parts.get(2) coalesce ""))
        return construct_layer_set(_parse_indices(parts.get(0) coalesce ""), structure, kv_heads, head_dim)
    }
    throw variant BadWire {message = "malformed layer set wire"}
}

fn _structure_uses_v11(KVStructure s) → bool {
    if s.partitions().length() ≻ 0 then return true
    # Keep: this is an early-exit predicate over a tagged structure list;
    # no admitted any/exists intrinsic preserves the first match boundary.
    for from s.layers() const layer {
        if _uses_extended_class(layer.structure()) then return true
    }
    return false
}

fn _partition_wire(CachePartition part) → string {
    return "§:§"(partition_class_name(part), partition_bytes(part) ↦ string)
}

fn _partitions_wire(list<CachePartition> partitions) → string {
    if partitions.length() ≡ 0 {
        return "-"
    }
    return partitions.reduce((string out, CachePartition part) ∴ out.length() ≡ 0 ? _partition_wire(part) : "§;§"(out, _partition_wire(part)), "")
}

fn _parse_partitions(string text) → list<CachePartition> ⇥ CacheError {
    if text ≡ "-" {
        return empty
    }
    require text.length() ≠ 0 throw variant BadWire {message = "malformed cache partition wire"}
    const list<string> parts ← text.split(";")
    var list<CachePartition> partitions ← empty
    # Keep: partition parsing validates and converts each item in wire order;
    # map/reduce cannot preserve the existing typed failure boundary.
    for from parts const part {
        const list<string> bits ← part.split(":")
        require bits.length() ≡ 2 throw variant BadWire {message = "malformed cache partition wire"}
        require bits.get(0) coalesce "" ≡ "indexer" throw variant InvalidCombination {message = "unknown partition class"}
        const string bytes_text ← bits.get(1) coalesce ""
        require _numeric(bytes_text) throw variant BadWire {message = "malformed cache partition wire"}
        var int bytes ← 0
        do {
            bytes ↤ bytes_text
        }
        catch err {
            throw variant BadWire {message = "malformed cache partition wire"}
        }
        partitions.append(indexer_budget(bytes))
    }
    return partitions
}

@ public
fn serialize_structure(KVStructure s) → string {
    const string layers ← s.layers().reduce((string out, LayerSet layer) ∴ out.length() ≡ 0 ? _layer_wire(layer) : "§;§"(out, _layer_wire(layer)), "")
    var string wire_schema ← structure_schema
    if _structure_uses_v11(s) {
        wire_schema ← structure_schema_v11
    }
    var string wire ← "cache/structure/§"(wire_schema)
    wire ← wire + "/"
    wire ← wire + layers
    wire ← wire + "/"
    wire ← wire + kv_dtype_name(s.kv_dtype_k())
    wire ← wire + "/"
    wire ← wire + kv_dtype_name(s.kv_dtype_v())
    wire ← wire + "/"
    wire ← wire + v_layout_name(s.v_layout())
    wire ← wire + "/"
    wire ← wire + sharing_name(s.sharing())
    wire ← wire + "/"
    wire ← wire + attention_family_name(s.attention_family())
    wire ← wire + "/"
    wire ← wire + (s.query_heads() ↦ string)
    wire ← wire + "/"
    wire ← wire + (s.slots() ↦ string)
    wire ← wire + "/"
    wire ← wire + (s.context_length() ↦ string)
    wire ← wire + "/"
    wire ← wire + s.reserve_policy()
    if _structure_uses_v11(s) {
        wire ← wire + "/"
        wire ← wire + _partitions_wire(s.partitions())
    }
    return wire
}

# Convert-or-record: schema branching, field checks, and nested failable
# parsers are ordered wire validation; no closure intrinsic covers this path.
@ public
fn deserialize_structure(string wire) → KVStructure ⇥ CacheError {
    const list<string> parts ← wire.split("/")
    require parts.length() ≥ 13 throw variant BadWire {message = "malformed cache structure wire"}
    require parts.get(0) coalesce "" ≡ "cache" throw variant BadWire {message = "unknown cache marker"}
    require parts.get(1) coalesce "" ≡ "structure" throw variant BadWire {message = "unknown cache marker"}
    const string version ← parts.get(2) coalesce ""
    if version ≠ structure_schema {
        require version ≡ structure_schema_v11 throw variant UnknownVersion {message = "unknown cache structure schema version"}
    }
    if version ≡ structure_schema {
        require parts.length() ≡ 13 throw variant BadWire {message = "malformed cache structure wire"}
    }
    if version ≡ structure_schema_v11 {
        require parts.length() ≡ 14 throw variant BadWire {message = "malformed cache structure wire"}
    }
    const string layers_text ← parts.get(3) coalesce ""
    require layers_text.length() ≠ 0 throw variant BadWire {message = "malformed cache structure wire"}
    const list<string> layer_parts ← layers_text.split(";")
    var list<LayerSet> layers ← empty
    for from layer_parts const part {
        layers.append(_parse_layer_wire(part))
    }
    const KvDtype kv_dtype_k ← _kv_dtype_from_name(parts.get(4) coalesce "")
    const KvDtype kv_dtype_v ← _kv_dtype_from_name(parts.get(5) coalesce "")
    const VLayout v_layout ← _v_layout_from_name(parts.get(6) coalesce "")
    const KvSharing sharing ← _sharing_from_name(parts.get(7) coalesce "")
    const AttentionFamily attention_family ← _attention_family_from_name(parts.get(8) coalesce "")
    const string heads_text ← parts.get(9) coalesce ""
    const string slots_text ← parts.get(10) coalesce ""
    const string context_text ← parts.get(11) coalesce ""
    const string reserve ← parts.get(12) coalesce ""
    require reserve ≡ RESERVE_GI4 throw variant InvalidCombination {message = "unknown reserve policy"}
    require not ((not _numeric(heads_text) or not _numeric(slots_text)) or not _numeric(context_text)) throw variant BadWire {message = "malformed cache structure wire"}
    var int query_heads ← 0
    var int slots ← 0
    var int context_length ← 0
    do {
        query_heads ↤ heads_text
        slots ↤ slots_text
        context_length ↤ context_text
    }
    catch err {
        throw variant BadWire {message = "malformed cache structure wire"}
    }
    var list<CachePartition> partitions ← empty
    if version ≡ structure_schema_v11 {
        partitions ← _parse_partitions(parts.get(13) coalesce "")
    }
    return construct_kv_structure_with_partitions(layers, kv_dtype_k, kv_dtype_v, v_layout, sharing, attention_family, query_heads, slots, context_length, partitions)
}

# -------------------------------------------------------------------------
# empty_layers — one empty KVCache per KV layer index in the structure.
# Indexer partitions are skipped (they are not a KvDtype). Indices must
# be the contiguous range 0..N-1 so the returned list is layer-addressable.
# Each cache is one-block (layers = 1) with width kv_heads * head_dim.
# Copies KVStructure.context_length as immutable KVCache.capacity.
# -------------------------------------------------------------------------

fn _cache_layer_count(LayerSet layer) → int {
    if _is_indexer_structure(layer.structure()) {
        return 0
    }
    return layer.indices().length()
}

fn _layer_width(KVStructure s, int idx) → int ⇥ CacheError {
    # Keep: this nested search returns the first matching layer width and
    # rejects missing coverage; no flat collection transform states that law.
    for from s.layers() const layer {
        if not _is_indexer_structure(layer.structure()) {
            for from layer.indices() const layer_idx {
                if layer_idx ≡ idx {
                    return layer.kv_heads() * layer.head_dim()
                }
            }
        }
    }
    throw variant InvalidCombination {message = "layer indices must be the contiguous range 0..N-1"}
}

@ public
fn empty_layers(KVStructure s, string model, string model_version, string config, string tokenizer) → list<KVCache> ⇥ CacheError {
    const int capacity ← s.context_length()
    require capacity ≥ 1 throw variant InvalidDimension {message = "capacity must be at least one"}
    const int count ← s.layers().reduce((int total, LayerSet layer) ∴ total + _cache_layer_count(layer), 0)
    require count ≥ 1 throw variant InvalidDimension {message = "layer set must be at least one"}
    var list<KVCache> out ← empty
    # Keep: this is a count-like address walk whose body can fail while
    # constructing each cache; map cannot carry the existing error channel.
    for range 0‥count const idx {
        out.append(_empty_cache(model, model_version, config, tokenizer, 1, _layer_width(s, idx), capacity))
    }
    return out
}
