+++ toml
locale = "en"

+++ faber
# Single-token decode device kernels, shape-generic over every tensor axis.
#
# Public import: import from "gradus:decode_step" ds
# Zero imports: self-contained under the compiler's kernel subset.
#
# Portability & KIR performance contracts:
#   - Arithmetic indices and symbolic 2D index products inside inner loops
#     must stay proven within `i64` for portable Cranelift CPU + Metal GPU
#     KIR admission (using `∧` bitmasks where symbolic strides multiply
#     lane coordinates, so no kernel needs `wide-integer-carrier (i64 mul)`).
#   - RMSNorm, GEMV, fused multi-output projections, and row softmax delegate
#     to the compiler's native tensor contractions/reductions (`norm_rms`, `·`,
#     `softmax()`) for parallel tiled execution.
#   - GQA context supports both direct (`attn_context`) and split-K
#     (`context_part` + `context_fin`) forms.
#
# Tolerances against a high-precision reference for real-weight model layers:
#   abs <= 1e-5 + 1e-4 * abs(ref).
# ---------------------------------------------------------------------------
# Tensor primitives (Metal GPU + CPU KIR native)
# ---------------------------------------------------------------------------
# Prime a 1D kernel-written tensor on the device before its first write so
# later launches reuse device storage without extra host uploads or waits.
@ public
kernel prime1<size N>(tensor<f32, [N]> ptarget, mut tensor<f32, [1]> psink) → void {
    psink[0] ← reduce via sum from ptarget at [i] thread lane let v {
        return v
    }
}

# Prime a 2D kernel-written tensor (partial matrices, score matrices, caches).
@ public
kernel prime2<size R, size C>(tensor<f32, [R, C]> ptarget, mut tensor<f32, [1]> psink) → void {
    for from psink at [i] thread lane let e {
        psink[[i]] ← ptarget[[0, 0]]
    }
}

# Embedding gather: gout[j] = gtable[ids[0], j]. `gdom` is the lane domain [D].
@ public
kernel gather_row<size V, size D>(tensor<f32, [D]> gdom, tensor<f32, [V, D]> gtable, tensor<i32, [1]> gids, mut tensor<f32, [D]> gout) → void {
    for from gdom at [j] thread lane let e {
        gout[[j]] ← gtable[[gids[0], j]]
    }
}

# Embedding gather using the output tensor as its own lane domain [D].
@ public
kernel gather_wide<size V, size D>(tensor<f32, [V, D]> gwtable, tensor<i32, [1]> gwids, mut tensor<f32, [D]> gwo) → void {
    for from gwo at [j] thread lane let e {
        gwo[[j]] ← gwtable[[gwids[0], j]]
    }
}

# RMSNorm in one parallel tiled launch: rmo = (rmx / rms(rmx, rmeps)) * rmw.
@ public
kernel rmsnorm<size D>(tensor<f32, [D]> rmx, tensor<f32, [D]> rmw, mut tensor<f32, [D]> rmo, f32 rmeps) → void {
    rmo ⇇ rmx.norm_rms(axis 0, rmeps, rmw)
}

# GEMV in one parallel tiled launch: gmy = gmw · gmx.
@ public
kernel gemv<size N, size K>(tensor<f32, [N, K]> gmw, tensor<f32, [K]> gmx, mut tensor<f32, [N]> gmy) → void {
    gmy ⇇ gmw · gmx
}

# Fused Q/K/V projection sharing input `x` in one launch:
#   q = wq · x, k = wk · x, v = wv · x.
@ public
kernel qkv_proj<size QD, size KVD, size D>(tensor<f32, [QD, D]> wq, tensor<f32, [KVD, D]> wk, tensor<f32, [KVD, D]> wv, tensor<f32, [D]> x, mut tensor<f32, [QD]> q, mut tensor<f32, [KVD]> k, mut tensor<f32, [KVD]> v) → void {
    q ⇇ wq · x
    k ⇇ wk · x
    v ⇇ wv · x
}

# Fused gate/up projection sharing input `x` in one launch:
#   g = wg · x, u = wu · x.
@ public
kernel gate_up_proj<size F, size D>(tensor<f32, [F, D]> wg, tensor<f32, [F, D]> wu, tensor<f32, [D]> x, mut tensor<f32, [F]> g, mut tensor<f32, [F]> u) → void {
    g ⇇ wg · x
    u ⇇ wu · x
}

# Rotate-half RoPE over a flat vector of heads [N = heads * 2 * rhspan]: the
# pair (jj, jj + rhspan) of each head rotates by rhpos * theta^(-p / rhspan),
# where p = jj mod rhspan and jj = j mod (2 * rhspan).
@ public
kernel rope_half<size N>(tensor<f32, [N]> rhx, mut tensor<f32, [N]> rho, i32 rhpos, i32 rhspan, f32 rhlntheta) → void {
    for from rhx at [j] thread lane let v {
        if rhspan ≻ 0 and rhspan ≤ 960 {
            let i32 hf ← rhspan
            let i32 jj ← j % (2 * hf)
            let i32 base ← j - jj
            let i32 p ← jj % hf
            let f32 freq ← (-(p ↦ f32) / (hf ↦ f32) * rhlntheta).exp()
            let f32 ang ← (rhpos ↦ f32) * freq
            let f32 c ← ang.cos()
            let f32 s ← ang.sin()

            if jj ≺ hf {
                rho[[j]] ← v * c - rhx[[base + jj + hf]] * s
            }
            else {
                rho[[j]] ← rhx[[base + jj - hf]] * s + v * c
            }
        }
    }
}

# Consecutive-pair (llama NORM) RoPE over a flat vector of heads
# [N = heads * 2 * rpspan]: the pair (jj, jj + 1) for even jj rotates by
# rppos * theta^(-p / rpspan), where p = jj / 2 and jj = j mod (2 * rpspan).
@ public
kernel rope_pairs<size N>(tensor<f32, [N]> rpx, mut tensor<f32, [N]> rpo, i32 rppos, i32 rpspan, f32 rplntheta) → void {
    for from rpx at [j] thread lane let v {
        if rpspan ≻ 0 and rpspan ≤ 960 {
            let i32 hf ← rpspan
            let i32 jj ← j % (2 * hf)
            let i32 p ← jj / 2
            let f32 freq ← (-(p ↦ f32) / (hf ↦ f32) * rplntheta).exp()
            let f32 ang ← (rppos ↦ f32) * freq
            let f32 c ← ang.cos()
            let f32 s ← ang.sin()

            if jj % 2 ≡ 0 {
                rpo[[j]] ← v * c - rpx[[j + 1]] * s
            }
            else {
                rpo[[j]] ← rpx[[j - 1]] * s + v * c
            }
        }
    }
}

# Precompute [P] RoPE cosine and sine tables at position `rtpos` once per token
# so Q and K head rotations share trig across all heads.
@ public
kernel rope_table<size P>(mut tensor<f32, [P]> rtcos, mut tensor<f32, [P]> rtsin, i32 rtpos, f32 rtlntheta) → void {
    let i32 span ← P ↦ i32 ⊥ 1

    for from rtcos at [p] thread lane let ? {
        if span ≻ 0 and span ≤ 960 {
            let f32 freq ← (-(p ↦ f32) / (span ↦ f32) * rtlntheta).exp()
            let f32 ang ← (rtpos ↦ f32) * freq
            rtcos[[p]] ← ang.cos()
            rtsin[[p]] ← ang.sin()
        }
    }
}

# Table-driven rotate-half RoPE twin of `rope_half`: reads precomputed [P]
# cosine and sine tables (P = rhspan) with zero per-lane trig.
@ public
kernel rope_half_table<size N, size P>(tensor<f32, [N]> rhx, tensor<f32, [P]> rhcos, tensor<f32, [P]> rhsin, mut tensor<f32, [N]> rho) → void {
    let i32 hf ← P ↦ i32 ⊥ 1

    for from rhx at [j] thread lane let v {
        if hf ≻ 0 and hf ≤ 960 {
            let i32 jj ← j % (2 * hf)
            let i32 base ← j - jj
            let i32 p ← jj % hf
            let f32 c ← rhcos[[p]]
            let f32 s ← rhsin[[p]]

            if jj ≺ hf {
                rho[[j]] ← v * c - rhx[[base + jj + hf]] * s
            }
            else {
                rho[[j]] ← rhx[[base + jj - hf]] * s + v * c
            }
        }
    }
}

# Table-driven consecutive-pair (llama NORM) RoPE twin of `rope_pairs`: reads
# precomputed [P] cosine and sine tables (P = rpspan) with zero per-lane trig.
@ public
kernel rope_pairs_table<size N, size P>(tensor<f32, [N]> rpx, tensor<f32, [P]> rpcos, tensor<f32, [P]> rpsin, mut tensor<f32, [N]> rpo) → void {
    let i32 hf ← P ↦ i32 ⊥ 1

    for from rpx at [j] thread lane let v {
        if hf ≻ 0 and hf ≤ 960 {
            let i32 jj ← j % (2 * hf)
            let i32 p ← jj / 2
            let f32 c ← rpcos[[p]]
            let f32 s ← rpsin[[p]]

            if jj % 2 ≡ 0 {
                rpo[[j]] ← v * c - rpx[[j + 1]] * s
            }
            else {
                rpo[[j]] ← rpx[[j - 1]] * s + v * c
            }
        }
    }
}

# KV-row write: update row `kwpos` in the existing cache. A negative or
# out-of-capacity position leaves the cache unchanged.
@ public
kernel kv_write_row<size C, size K>(tensor<f32, [K]> kwrow, mut tensor<f32, [C, K]> kwcache, i32 kwpos) → void {
    for from kwrow at [j] thread lane let v {
        if kwpos ≥ 0 and kwpos ≺ C {
            kwcache[[kwpos, j]] ← v
        }
    }
}

# Single-row KV-cache append helper (`[C, K]` updated at `kwpos`).
@ public
fn kv_write<size C, size K>(mut tensor<f32, [C, K]> kwcache, tensor<f32, [K]> kwrow, i32 kwpos) → void {
    kv_write_row(kwrow, mut kwcache, kwpos)
}

# Fused K and V cache row append at `kwpos` in one launch.
@ public
kernel kv_write_kv<size C, size K>(tensor<f32, [K]> kwk, tensor<f32, [K]> kwv, mut tensor<f32, [C, K]> kwkc, mut tensor<f32, [C, K]> kwvc, i32 kwpos) → void {
    for from kwk at [j] thread lane let vk {
        if kwpos ≥ 0 and kwpos ≺ C {
            kwkc[[kwpos, j]] ← vk
            kwvc[[kwpos, j]] ← kwv[[j]]
        }
    }
}

# Fused rotate-half RoPE for Q and K plus KV cache row write in one launch.
@ public
kernel rope_half_qk_kv_write<size QD, size KVD, size C>(tensor<f32, [QD]> rhx, tensor<f32, [KVD]> rhk, tensor<f32, [KVD]> rhv, mut tensor<f32, [QD]> rho, mut tensor<f32, [C, KVD]> kwkc, mut tensor<f32, [C, KVD]> kwvc, i32 rhpos, i32 rhspan, f32 rhlntheta) relaxed → void {
    for from rhx at [j] thread lane let v {
        if rhspan ≻ 0 and rhspan ≤ 960 {
            let i32 hf ← rhspan
            let i32 jj ← j % (2 * hf)
            let i32 base ← j - jj
            let i32 p ← jj % hf
            let f32 freq ← (-(p ↦ f32) / (hf ↦ f32) * rhlntheta).exp()
            let f32 ang ← (rhpos ↦ f32) * freq
            let f32 c ← ang.cos()
            let f32 s ← ang.sin()

            if jj ≺ hf {
                rho[[j]] ← v * c - rhx[[base + jj + hf]] * s
                if j ≺ KVD and rhpos ≥ 0 and rhpos ≺ C {
                    kwkc[[rhpos, j]] ← rhk[[j]] * c - rhk[[base + jj + hf]] * s
                    kwvc[[rhpos, j]] ← rhv[[j]]
                }
            }
            else {
                rho[[j]] ← rhx[[base + jj - hf]] * s + v * c
                if j ≺ KVD and rhpos ≥ 0 and rhpos ≺ C {
                    kwkc[[rhpos, j]] ← rhk[[base + jj - hf]] * s + rhk[[j]] * c
                    kwvc[[rhpos, j]] ← rhv[[j]]
                }
            }
        }
    }
}

# Fused consecutive-pair RoPE for Q and K plus KV cache row write in one launch.
@ public
kernel rope_pairs_qk_kv_write<size QD, size KVD, size C>(tensor<f32, [QD]> rpx, tensor<f32, [KVD]> rpk, tensor<f32, [KVD]> rpv, mut tensor<f32, [QD]> rpo, mut tensor<f32, [C, KVD]> kwkc, mut tensor<f32, [C, KVD]> kwvc, i32 rppos, i32 rpspan, f32 rplntheta) relaxed → void {
    for from rpx at [j] thread lane let v {
        if rpspan ≻ 0 and rpspan ≤ 960 {
            let i32 hf ← rpspan
            let i32 jj ← j % (2 * hf)
            let i32 p ← jj / 2
            let f32 freq ← (-(p ↦ f32) / (hf ↦ f32) * rplntheta).exp()
            let f32 ang ← (rppos ↦ f32) * freq
            let f32 c ← ang.cos()
            let f32 s ← ang.sin()

            if jj % 2 ≡ 0 {
                rpo[[j]] ← v * c - rpx[[j + 1]] * s
                if j ≺ KVD and rppos ≥ 0 and rppos ≺ C {
                    kwkc[[rppos, j]] ← rpk[[j]] * c - rpk[[j + 1]] * s
                    kwvc[[rppos, j]] ← rpv[[j]]
                }
            }
            else {
                rpo[[j]] ← rpx[[j - 1]] * s + v * c
                if j ≺ KVD and rppos ≥ 0 and rppos ≺ C {
                    kwkc[[rppos, j]] ← rpk[[j - 1]] * s + rpk[[j]] * c
                    kwvc[[rppos, j]] ← rpv[[j]]
                }
            }
        }
    }
}

# Fused table-driven rotate-half RoPE for Q and K plus KV cache row write in one launch.
@ public
kernel rope_half_table_qk_kv_write<size QD, size KVD, size C, size P>(tensor<f32, [QD]> rhx, tensor<f32, [KVD]> rhk, tensor<f32, [KVD]> rhv, tensor<f32, [P]> rhcos, tensor<f32, [P]> rhsin, mut tensor<f32, [QD]> rho, mut tensor<f32, [C, KVD]> kwkc, mut tensor<f32, [C, KVD]> kwvc, i32 rhpos) → void {
    let i32 hf ← P ↦ i32 ⊥ 1

    for from rhx at [j] thread lane let v {
        if hf ≻ 0 and hf ≤ 960 {
            let i32 jj ← j % (2 * hf)
            let i32 base ← j - jj
            let i32 p ← jj % hf
            let f32 c ← rhcos[[p]]
            let f32 s ← rhsin[[p]]

            if jj ≺ hf {
                rho[[j]] ← v * c - rhx[[base + jj + hf]] * s

                if j ≺ KVD and rhpos ≥ 0 and rhpos ≺ C {
                    kwkc[[rhpos, j]] ← rhk[[j]] * c - rhk[[base + jj + hf]] * s
                    kwvc[[rhpos, j]] ← rhv[[j]]
                }
            }
            else {
                rho[[j]] ← rhx[[base + jj - hf]] * s + v * c

                if j ≺ KVD and rhpos ≥ 0 and rhpos ≺ C {
                    kwkc[[rhpos, j]] ← rhk[[base + jj - hf]] * s + rhk[[j]] * c
                    kwvc[[rhpos, j]] ← rhv[[j]]
                }
            }
        }
    }
}

# Fused table-driven consecutive-pair RoPE for Q and K plus KV cache row write in one launch.
@ public
kernel rope_pairs_table_qk_kv_write<size QD, size KVD, size C, size P>(tensor<f32, [QD]> rpx, tensor<f32, [KVD]> rpk, tensor<f32, [KVD]> rpv, tensor<f32, [P]> rpcos, tensor<f32, [P]> rpsin, mut tensor<f32, [QD]> rpo, mut tensor<f32, [C, KVD]> kwkc, mut tensor<f32, [C, KVD]> kwvc, i32 rppos) → void {
    let i32 hf ← P ↦ i32 ⊥ 1

    for from rpx at [j] thread lane let v {
        if hf ≻ 0 and hf ≤ 960 {
            let i32 jj ← j % (2 * hf)
            let i32 p ← jj / 2
            let f32 c ← rpcos[[p]]
            let f32 s ← rpsin[[p]]

            if jj % 2 ≡ 0 {
                rpo[[j]] ← v * c - rpx[[j + 1]] * s

                if j ≺ KVD and rppos ≥ 0 and rppos ≺ C {
                    kwkc[[rppos, j]] ← rpk[[j]] * c - rpk[[j + 1]] * s
                    kwvc[[rppos, j]] ← rpv[[j]]
                }
            }
            else {
                rpo[[j]] ← rpx[[j - 1]] * s + v * c

                if j ≺ KVD and rppos ≥ 0 and rppos ≺ C {
                    kwkc[[rppos, j]] ← rpk[[j - 1]] * s + rpk[[j]] * c
                    kwvc[[rppos, j]] ← rpv[[j]]
                }
            }
        }
    }
}

# KV-block write: update rows `kwpos .. kwpos + N` from `kwblock` in one
# O(N * K) launch. Rows outside the cache are skipped independently.
@ public
kernel kv_write_rows<size N, size C, size K>(tensor<f32, [N, K]> kwblock, mut tensor<f32, [C, K]> kwcache, i32 kwpos) → void {
    for from kwblock at [n, j] thread lane let v {
        if kwpos ≥ 0 and kwpos + n ≺ C {
            kwcache[[kwpos + n, j]] ← v
        }
    }
}

# Host entry for an in-place block write; one device launch writes all valid rows.
@ public
fn kv_write_block<size N, size C, size K>(mut tensor<f32, [C, K]> kwcache, tensor<f32, [N, K]> kwblock, i32 kwpos) → void {
    kv_write_rows(kwblock, mut kwcache, kwpos)
}

# GQA decode scores: assc[h, c] = (asq[h * dh + :] . askc[c, (h / group) * dh + :])
# * asscale, masked to -3.0e38 for c > aspos so `row_softmax` zeroes masked slots.
@ public
kernel attn_scores<size H, size C, size QD, size KVD>(tensor<f32, [H, C]> asdom, tensor<f32, [QD]> asq, tensor<f32, [C, KVD]> askc, mut tensor<f32, [H, C]> assc, i32 aspos, i32 asgroup, i32 asdh, f32 asscale) → void {
    for from asdom at [h, c] thread lane let e {
        if c ≻ aspos or aspos ≺ 0 {
            assc[[h, c]] ← -3.0e38
        }
        elif asgroup ≻ 0 and asdh ≥ 1 and asdh ≤ 960 and asgroup ≤ 128 and h ∈ 0 … 4095 and c ∈ 0 … 16777215 {
            let i32 hh ← h ∧ 4095
            let i32 cc ← c ∧ 16777215
            let i32 qbase ← hh * asdh
            let i32 kbase ← hh / asgroup * asdh
            mut f32 acc ← 0.0

            for range 0 ‥ asdh let kk {
                acc ← acc + asq[[qbase + kk]] * askc[[cc, kbase + kk]]
            }

            assc[[h, c]] ← acc * asscale
        }
    }
}

# Row softmax in one parallel tiled launch: rso[h, :] = softmax(rsi[h, :]).
@ public
kernel row_softmax<size H, size C>(tensor<f32, [H, C]> rsi, mut tensor<f32, [H, C]> rso) → void {
    rso ⇇ rsi.softmax()
}

# GQA decode context (direct form for small cache capacity):
# acctx[h * dh + d] = sum_{c <= acpos} acp[h, c] * acvc[c, (h / group) * dh + d].
@ public
kernel attn_context<size QD, size H, size C, size KVD>(tensor<f32, [QD]> acdom, tensor<f32, [H, C]> acp, tensor<f32, [C, KVD]> acvc, mut tensor<f32, [QD]> acctx, i32 acpos, i32 acgroup, i32 acdh) → void {
    for from acdom at [j] thread lane let e {
        if acgroup ≻ 0 and acdh ≥ 1 and acdh ≤ 960 and acpos ≥ 0 and acpos ≺ C {
            let i32 dh ← acdh
            let i32 h ← j / dh
            let i32 d ← j % dh
            let i32 n ← acpos + 1
            let i32 base ← h / acgroup * dh
            let i32 vcol ← base + d
            mut f32 acc ← 0.0

            for range 0 ‥ n let c {
                acc ← acc + acp[[h, c]] * acvc[[c, vcol]]
            }

            acctx[[j]] ← acc
        }
    }
}

# GQA decode context phase 1 (split-K over P partitions of cache rows):
# cppart[p, j] = sum_{c = p, p + P, ... <= cppos} cpp[h, c] * cpvc[c, base + d].
@ public
kernel context_part<size P, size QD, size H, size C, size KVD>(tensor<f32, [P, QD]> cpdom, tensor<f32, [H, C]> cpp, tensor<f32, [C, KVD]> cpvc, mut tensor<f32, [P, QD]> cppart, i32 cppos, i32 cpgroup, i32 cpdh) → void {
    for from cpdom at [p, j] thread lane let e {
        if cpgroup ≻ 0 and cpdh ≥ 1 and cpdh ≤ 960 and cppos ≥ 0 and cppos ≺ C {
            let i32 dh ← cpdh
            let i32 h ← j / dh
            let i32 d ← j % dh
            let i32 base ← h / cpgroup * dh
            let i32 vcol ← base + d
            mut f32 acc ← 0.0
            mut i32 c ← p

            while c ≤ cppos {
                acc ← acc + cpp[[h, c]] * cpvc[[c, vcol]]
                c ← c + P
            }

            cppart[[p, j]] ← acc
        }
    }
}

# GQA decode context phase 2: cfout[j] = sum_{p = 0 .. P - 1} cfpart[p, j].
@ public
kernel context_fin<size P, size QD>(tensor<f32, [QD]> cfdom, tensor<f32, [P, QD]> cfpart, mut tensor<f32, [QD]> cfout) → void {
    for from cfdom at [j] thread lane let e {
        mut f32 acc ← 0.0

        for range 0 ‥ P let p {
            acc ← acc + cfpart[[p, j]]
        }

        cfout[[j]] ← acc
    }
}

# Circular ring-buffer KV-row write at `kwpos % kwwin` (arbitrary non-power-of-two
# window `kwwin <= W`). Negative `kwpos` or invalid window leaves the ring unchanged.
@ public
fn kv_ring_write_row<size W, size K>(tensor<f32, [K]> kwrow, mut tensor<f32, [W, K]> kwcache, i32 kwpos, i32 kwwin) → void {
    if kwpos ≥ 0 and kwwin ≥ 1 and kwwin ≤ W {
        let i32 slot ← kwpos % kwwin
        kv_write_row(kwrow, mut kwcache, slot)
    }
}

# Fused circular ring-buffer K and V row write at `kwpos % kwwin`.
@ public
fn kv_ring_write_kv<size W, size K>(tensor<f32, [K]> kwk, tensor<f32, [K]> kwv, mut tensor<f32, [W, K]> kwkc, mut tensor<f32, [W, K]> kwvc, i32 kwpos, i32 kwwin) → void {
    if kwpos ≥ 0 and kwwin ≥ 1 and kwwin ≤ W {
        let i32 slot ← kwpos % kwwin
        kv_write_kv(kwk, kwv, mut kwkc, mut kwvc, slot)
    }
}

# Windowed GQA decode scores over circular ring `[W, KVD]` with active window
# `aswin <= W`. Slots `>= aswin`, or `> aspos` when `aspos < aswin`, are masked
# to `-3.0e38` so `row_softmax` zeroes them.
@ public
kernel attn_scores_ring<size H, size W, size QD, size KVD>(tensor<f32, [H, W]> asdom, tensor<f32, [QD]> asq, tensor<f32, [W, KVD]> askc, mut tensor<f32, [H, W]> assc, i32 aspos, i32 aswin, i32 asgroup, i32 asdh, f32 asscale) → void {
    for from asdom at [h, s] thread lane let e {
        if aspos ≺ 0 or aswin ≺ 1 or s ≥ aswin or s ≻ aspos {
            assc[[h, s]] ← -3.0e38
        }
        elif asgroup ≻ 0 and asdh ≥ 1 and asdh ≤ 960 and asgroup ≤ 128 and h ∈ 0 … 4095 and s ∈ 0 … 16777215 {
            let i32 hh ← h ∧ 4095
            let i32 ss ← s ∧ 16777215
            let i32 qbase ← hh * asdh
            let i32 kbase ← hh / asgroup * asdh
            mut f32 acc ← 0.0

            for range 0 ‥ asdh let kk {
                acc ← acc + asq[[qbase + kk]] * askc[[ss, kbase + kk]]
            }

            assc[[h, s]] ← acc * asscale
        }
    }
}

# Windowed GQA decode context over circular ring `[W, KVD]` with active window `acwin <= W`.
@ public
kernel attn_context_ring<size QD, size H, size W, size KVD>(tensor<f32, [QD]> acdom, tensor<f32, [H, W]> acp, tensor<f32, [W, KVD]> acvc, mut tensor<f32, [QD]> acctx, i32 acpos, i32 acwin, i32 acgroup, i32 acdh) → void {
    for from acdom at [j] thread lane let e {
        if acgroup ≻ 0 and acdh ≥ 1 and acdh ≤ 960 and acpos ≥ 0 and acwin ≥ 1 and acwin ≤ W {
            let i32 dh ← acdh
            let i32 h ← j / dh
            let i32 d ← j % dh
            mut i32 n ← acpos + 1

            if n ≻ acwin {
                n ← acwin
            }

            let i32 base ← h / acgroup * dh
            let i32 vcol ← base + d
            mut f32 acc ← 0.0

            for range 0 ‥ n let s {
                acc ← acc + acp[[h, s]] * acvc[[s, vcol]]
            }

            acctx[[j]] ← acc
        }
    }
}

# Residual add: reo[j] = rea[j] + reb[j].
@ public
kernel residual_add<size D>(tensor<f32, [D]> rea, tensor<f32, [D]> reb, mut tensor<f32, [D]> reo) → void {
    for from rea at [j] thread lane let a {
        reo[[j]] ← a + reb[[j]]
    }
}

# SwiGLU: swo[j] = silu(swg[j]) * swu[j], silu(v) = v / (1 + exp(-v)).
@ public
kernel swiglu<size F>(tensor<f32, [F]> swg, tensor<f32, [F]> swu, mut tensor<f32, [F]> swo) relaxed → void {
    for from swg at [j] thread lane let v {
        swo[[j]] ← v / (1.0 + (-v).exp()) * swu[[j]]
    }
}

# Bias add in place: abinto[j] += abias[j]. Launched after a projection when
# the layer's weights carry a QKV bias; skipped entirely when they do not.
@ public
kernel add_bias<size N>(tensor<f32, [N]> abias, mut tensor<f32, [N]> abinto) → void {
    for from abias at [j] thread lane let b {
        abinto[[j]] ← abinto[[j]] + b
    }
}

# Argmax over logits `atx[V]`, writing the 1-element index tensor `atid[0]`.
# Equal maxima keep the lowest index.
@ public
kernel argmax_token<size V>(tensor<f32, [V]> atx, mut tensor<i32, [1]> atid) → void {
    atid[0] ← reduce via argmax from atx at [i] thread lane let v {
        return v
    } coalesce 0
}

# Chunked top-M: lane `p` of `[P]` scans chunk `p` once (`O(V)` global reads)
# into lane-private `[M]` buffers, writing the M best pairs in descending
# value with ties resolved to the lowest index. Chunks shorter than M fill
# trailing slots with `-3.4028235e38` and sentinel index `-1`.
@ public
kernel topm_chunks<size P, size V, size M>(tensor<f32, [P]> tmdom, tensor<f32, [V]> tmx, mut tensor<f32, [P, M]> tmval, mut tensor<i32, [P, M]> tmidx, i32 tmchunk) → void {
    for from tmdom at [p] thread lane let ? {
        let i32 mlen ← M

        if tmchunk ≥ 1 and mlen ≥ 1 and mlen ≤ 1023 and p ∈ 0 … 16383 {
            let i32 pp ← p ∧ 16383
            let i32 vlen ← V
            let i32 n ← tmchunk
            let i32 start ← pp * n
            let i32 end ← start + n
            let i32 stop ← end ≻ vlen ✓ vlen ✗ end
            mut tensor<f32, [M]> best_v ← empty
            mut tensor<i32, [M]> best_i ← empty

            for exclusive M let r {
                let i32 rr ← r ∧ 1023
                best_v[[rr]] ← -3.4028235e38
                best_i[[rr]] ← -1
            }

            if start ≺ stop {
                for range start ‥ stop let k {
                    let f32 raw ← tmx[[k]]

                    if raw ≡ raw {
                        mut f32 cur_v ← raw
                        mut i32 cur_i ← k

                        for exclusive M let r {
                            let i32 rr ← r ∧ 1023
                            let i32 bi ← best_i[[rr]]
                            let f32 bv ← best_v[[rr]]

                            if cur_i ≥ 0 and (bi ≺ 0 or cur_v ≻ bv or (cur_v ≡ bv and cur_i ≺ bi)) {
                                best_v[[rr]] ← cur_v
                                best_i[[rr]] ← cur_i
                                cur_v ← bv
                                cur_i ← bi
                            }
                        }
                    }
                }
            }

            for exclusive M let r {
                let i32 rr ← r ∧ 1023
                tmval[[p, rr]] ← best_v[[rr]]
                tmidx[[p, rr]] ← best_i[[rr]]
            }
        }
    }
}

# ---------------------------------------------------------------------------
# Batched regime-aware kernels (B = 1, B = k verify/diffusion, B = C prefill)
# ---------------------------------------------------------------------------
# Batched embedding gather: out[b, j] = table[ids[b], j] for b < active_b.
@ public
kernel gather_batch<size V, size B, size D>(tensor<f32, [V, D]> gbtable, tensor<i32, [B]> gbids, mut tensor<f32, [B, D]> gbout, i32 gbactive) → void {
    for from gbout at [b, j] thread lane let e {
        if b ≺ gbactive {
            let i32 tid ← gbids[[b]]
            gbout[[b, j]] ← gbtable[[tid, j]]
        }
    }
}

# Batched RMSNorm over axis 1: out[b, :] = (x[b, :] / rms(x[b, :], eps)) * w.
@ public
kernel rmsnorm_batch<size B, size D>(tensor<f32, [B, D]> rmx, tensor<f32, [D]> rmw, mut tensor<f32, [B, D]> rmo, f32 rmeps) → void {
    rmo ⇇ rmx.norm_rms(axis 1, rmeps, rmw)
}

# Batched linear projection with [Out, In] weights:
#   y[b, n] = sum_k x[b, k] * w[n, k] for b < active_b.
@ public
kernel matmul_nt_batch<size B, size N, size K>(tensor<f32, [N, K]> mmw, tensor<f32, [B, K]> mmx, mut tensor<f32, [B, N]> mmy, i32 mmactive, i32 mmk) → void {
    for from mmy at [b, n] thread lane let e {
        if b ≺ mmactive and mmk ≥ 1 and mmk ≤ 65535 and b ∈ 0 … 16383 and n ∈ 0 … 16777215 {
            let i32 bb ← b ∧ 16383
            let i32 nn ← n ∧ 16777215
            mut f32 acc ← 0.0

            for range 0 ‥ mmk let kk {
                acc ← acc + mmx[[bb, kk]] * mmw[[nn, kk]]
            }

            mmy[[b, n]] ← acc
        }
    }
}

# Batched Q/K/V projection sharing input `x`.
@ public
fn qkv_proj_batch<size B, size QD, size KVD, size D>(tensor<f32, [QD, D]> wq, tensor<f32, [KVD, D]> wk, tensor<f32, [KVD, D]> wv, tensor<f32, [B, D]> x, mut tensor<f32, [B, QD]> q, mut tensor<f32, [B, KVD]> k, mut tensor<f32, [B, KVD]> v, i32 active_b) → void {
    let i32 dlen ← D ↦ i32 ⊥ 1
    matmul_nt_batch(wq, x, mut q, active_b, dlen)
    matmul_nt_batch(wk, x, mut k, active_b, dlen)
    matmul_nt_batch(wv, x, mut v, active_b, dlen)
}

# Batched gate/up projection sharing input `x`.
@ public
fn gate_up_proj_batch<size B, size F, size D>(tensor<f32, [F, D]> wg, tensor<f32, [F, D]> wu, tensor<f32, [B, D]> x, mut tensor<f32, [B, F]> g, mut tensor<f32, [B, F]> u, i32 active_b) → void {
    let i32 dlen ← D ↦ i32 ⊥ 1
    matmul_nt_batch(wg, x, mut g, active_b, dlen)
    matmul_nt_batch(wu, x, mut u, active_b, dlen)
}

# Batched bias add in place: into[b, j] += bias[j] for b < active_b.
@ public
kernel add_bias_batch<size B, size N>(tensor<f32, [N]> abbias, mut tensor<f32, [B, N]> abinto, i32 abactive) → void {
    for from abinto at [b, j] thread lane let cur {
        if b ≺ abactive {
            abinto[[b, j]] ← cur + abbias[[j]]
        }
    }
}

# Batched rotate-half RoPE over [B, N]: token b uses position `tpos + b`.
@ public
kernel rope_half_batch<size B, size N>(tensor<f32, [B, N]> rhx, mut tensor<f32, [B, N]> rho, i32 rhtpos, i32 rhspan, f32 rhlntheta, i32 rhactive) → void {
    for from rhx at [b, j] thread lane let v {
        if b ≺ rhactive and rhspan ≻ 0 and rhspan ≤ 960 {
            let i32 hf ← rhspan
            let i32 jj ← j % (2 * hf)
            let i32 base ← j - jj
            let i32 p ← jj % hf
            let f32 freq ← (-(p ↦ f32) / (hf ↦ f32) * rhlntheta).exp()
            let f32 ang ← ((rhtpos + b) ↦ f32) * freq
            let f32 c ← ang.cos()
            let f32 s ← ang.sin()

            if jj ≺ hf {
                rho[[b, j]] ← v * c - rhx[[b, base + jj + hf]] * s
            }
            else {
                rho[[b, j]] ← rhx[[b, base + jj - hf]] * s + v * c
            }
        }
    }
}

# Batched consecutive-pair RoPE over [B, N]: token b uses position `tpos + b`.
@ public
kernel rope_pairs_batch<size B, size N>(tensor<f32, [B, N]> rpx, mut tensor<f32, [B, N]> rpo, i32 rptpos, i32 rpspan, f32 rplntheta, i32 rpactive) → void {
    for from rpx at [b, j] thread lane let v {
        if b ≺ rpactive and rpspan ≻ 0 and rpspan ≤ 960 {
            let i32 hf ← rpspan
            let i32 jj ← j % (2 * hf)
            let i32 p ← jj / 2
            let f32 freq ← (-(p ↦ f32) / (hf ↦ f32) * rplntheta).exp()
            let f32 ang ← ((rptpos + b) ↦ f32) * freq
            let f32 c ← ang.cos()
            let f32 s ← ang.sin()

            if jj % 2 ≡ 0 {
                rpo[[b, j]] ← v * c - rpx[[b, j + 1]] * s
            }
            else {
                rpo[[b, j]] ← rpx[[b, j - 1]] * s + v * c
            }
        }
    }
}

# Precompute [B, P] RoPE cosine and sine tables for `b < rtactive` at `rttpos + b`.
@ public
kernel rope_table_batch<size B, size P>(mut tensor<f32, [B, P]> rtcos, mut tensor<f32, [B, P]> rtsin, i32 rttpos, f32 rtlntheta, i32 rtactive) → void {
    let i32 span ← P ↦ i32 ⊥ 1

    for from rtcos at [b, p] thread lane let ? {
        if b ≺ rtactive and span ≻ 0 and span ≤ 960 {
            let f32 freq ← (-(p ↦ f32) / (span ↦ f32) * rtlntheta).exp()
            let f32 ang ← ((rttpos + b) ↦ f32) * freq
            rtcos[[b, p]] ← ang.cos()
            rtsin[[b, p]] ← ang.sin()
        }
    }
}

# Table-driven batched rotate-half RoPE twin of `rope_half_batch`.
@ public
kernel rope_half_table_batch<size B, size N, size P>(tensor<f32, [B, N]> rhx, tensor<f32, [B, P]> rhcos, tensor<f32, [B, P]> rhsin, mut tensor<f32, [B, N]> rho, i32 rhactive) → void {
    let i32 hf ← P ↦ i32 ⊥ 1

    for from rhx at [b, j] thread lane let v {
        if b ≺ rhactive and hf ≻ 0 and hf ≤ 960 and b ∈ 0 … 16383 {
            let i32 bb ← b ∧ 16383
            let i32 jj ← j % (2 * hf)
            let i32 base ← j - jj
            let i32 p ← jj % hf
            let f32 c ← rhcos[[bb, p]]
            let f32 s ← rhsin[[bb, p]]

            if jj ≺ hf {
                rho[[b, j]] ← v * c - rhx[[b, base + jj + hf]] * s
            }
            else {
                rho[[b, j]] ← rhx[[b, base + jj - hf]] * s + v * c
            }
        }
    }
}

# Table-driven batched consecutive-pair RoPE twin of `rope_pairs_batch`.
@ public
kernel rope_pairs_table_batch<size B, size N, size P>(tensor<f32, [B, N]> rpx, tensor<f32, [B, P]> rpcos, tensor<f32, [B, P]> rpsin, mut tensor<f32, [B, N]> rpo, i32 rpactive) → void {
    let i32 hf ← P ↦ i32 ⊥ 1

    for from rpx at [b, j] thread lane let v {
        if b ≺ rpactive and hf ≻ 0 and hf ≤ 960 and b ∈ 0 … 16383 {
            let i32 bb ← b ∧ 16383
            let i32 jj ← j % (2 * hf)
            let i32 p ← jj / 2
            let f32 c ← rpcos[[bb, p]]
            let f32 s ← rpsin[[bb, p]]

            if jj % 2 ≡ 0 {
                rpo[[b, j]] ← v * c - rpx[[b, j + 1]] * s
            }
            else {
                rpo[[b, j]] ← rpx[[b, j - 1]] * s + v * c
            }
        }
    }
}

# Batched fused K and V cache write: writes rows `0 .. active_b` into
# `kwkc` / `kwvc` at `[kwpos .. kwpos + active_b)` in one O(B * K) launch.
@ public
kernel kv_write_kv_batch<size B, size C, size K>(tensor<f32, [B, K]> kwk, tensor<f32, [B, K]> kwv, mut tensor<f32, [C, K]> kwkc, mut tensor<f32, [C, K]> kwvc, i32 kwpos, i32 kwactive) → void {
    for from kwk at [b, j] thread lane let vk {
        if b ≺ kwactive and kwpos ≥ 0 and kwpos + b ≺ C {
            kwkc[[kwpos + b, j]] ← vk
            kwvc[[kwpos + b, j]] ← kwv[[b, j]]
        }
    }
}

# Batched GQA attention scores over flattened [BH, C] where BH = MaxBatch * H:
#   - `block_size == 1`: causal (token b attends to c <= tpos + b).
#   - `block_size > 1`: block diffusion (token b attends to prefix + its block,
#     c < tpos + min((b / block_size + 1) * block_size, active_b)).
@ public
kernel attn_scores_batch<size B, size BH, size C, size QD, size KVD>(tensor<f32, [BH, C]> asdom, tensor<f32, [B, QD]> asq, tensor<f32, [C, KVD]> askc, mut tensor<f32, [BH, C]> assc, i32 aspos, i32 asheads, i32 asgroup, i32 asdh, f32 asscale, i32 asactive, i32 asblk) → void {
    for from asdom at [bh, c] thread lane let e {
        if aspos ≺ 0 or asheads ≺ 1 or asheads ≻ 4096 or asgroup ≺ 1 or asgroup ≻ 128 or asdh ≺ 1 or asdh ≻ 960 or asblk ≺ 1 or bh ∉ 0 … 16777215 or c ∉ 0 … 16777215 {
            assc[[bh, c]] ← -3.0e38
        }
        else {
            let i32 bhh ← bh ∧ 16777215
            let i32 cc ← c ∧ 16777215
            let i32 b ← bhh / asheads
            let i32 hh ← bhh % asheads

            if b ≥ asactive {
                assc[[bh, c]] ← -3.0e38
            }
            else {
                let i32 blk ← b / asblk
                mut i32 bend ← (blk + 1) * asblk

                if bend ≻ asactive {
                    bend ← asactive
                }

                if cc ≥ aspos + bend {
                    assc[[bh, c]] ← -3.0e38
                }
                else {
                    let i32 qbase ← hh * asdh
                    let i32 kbase ← hh / asgroup * asdh
                    mut f32 acc ← 0.0

                    for range 0 ‥ asdh let kk {
                        acc ← acc + asq[[b, qbase + kk]] * askc[[cc, kbase + kk]]
                    }

                    assc[[bh, c]] ← acc * asscale
                }
            }
        }
    }
}

# Batched GQA attention context over flattened probability rows [BH, C]:
#   ctx[b, j] = sum_{c < limit} pr[b * heads + h, c] * vc[c, (h / group) * dh + d].
@ public
kernel attn_context_batch<size B, size QD, size BH, size C, size KVD>(tensor<f32, [B, QD]> acdom, tensor<f32, [BH, C]> acp, tensor<f32, [C, KVD]> acvc, mut tensor<f32, [B, QD]> acctx, i32 acpos, i32 acheads, i32 acgroup, i32 acdh, i32 acactive, i32 acblk) → void {
    for from acdom at [b, j] thread lane let e {
        if b ≺ acactive and acpos ≥ 0 and acpos ≺ C and acheads ≥ 1 and acheads ≤ 4096 and acgroup ≥ 1 and acgroup ≤ 128 and acdh ≥ 1 and acdh ≤ 960 and acblk ≥ 1 and b ∈ 0 … 16383 {
            let i32 bb ← b ∧ 16383
            let i32 dh ← acdh
            let i32 h ← j / dh
            let i32 d ← j % dh
            let i32 row ← bb * acheads + h
            let i32 vcol ← h / acgroup * dh + d
            let i32 blk ← bb / acblk
            mut i32 bend ← (blk + 1) * acblk

            if bend ≻ acactive {
                bend ← acactive
            }

            mut i32 n ← acpos + bend

            if n ≻ C {
                n ← C
            }

            mut f32 acc ← 0.0

            for range 0 ‥ n let c {
                acc ← acc + acp[[row, c]] * acvc[[c, vcol]]
            }

            acctx[[b, j]] ← acc
        }
    }
}

# Batched residual add: out[b, j] = a[b, j] + b[b, j] for b < active_b.
@ public
kernel residual_add_batch<size B, size D>(tensor<f32, [B, D]> rea, tensor<f32, [B, D]> reb, mut tensor<f32, [B, D]> reo, i32 reactive) → void {
    for from rea at [b, j] thread lane let a {
        if b ≺ reactive {
            reo[[b, j]] ← a + reb[[b, j]]
        }
    }
}

# Batched SwiGLU: out[b, j] = silu(g[b, j]) * u[b, j] for b < active_b.
@ public
kernel swiglu_batch<size B, size F>(tensor<f32, [B, F]> swg, tensor<f32, [B, F]> swu, mut tensor<f32, [B, F]> swo, i32 swactive) → void {
    for from swg at [b, j] thread lane let v {
        if b ≺ swactive {
            swo[[b, j]] ← v / (1.0 + (-v).exp()) * swu[[b, j]]
        }
    }
}

+++ faber test
# Co-located package test for decode_step.fab. Runs through KIR on CPU and Metal.

import from "gradus:decode_step" ds

fn close(f32 a, f32 b) → bool {
    return (a - b).abs() ≺ 0.0001
}

test "decode_step add_bias adds each bias element in place" {
    mut tensor<f32, [3]> dom ← tf32[3] {}
    mut tensor<f32, [3]> bias ← tf32[3] {}
    mut tensor<f32, [3]> into ← tf32[3] {}
    for range 0‥3 let j {
        into[[j]] ← (j ↦ f32) + 1.0
        bias[[j]] ← ((3 - j) ↦ f32) * 0.5
    }
    ds.add_bias(bias, mut into)
    assert close(into[[0]], 2.5)
    assert close(into[[1]], 3.0)
    assert close(into[[2]], 3.5)
}

test "decode_step gather_row copies the embedding row named by ids[0]" {
    mut tensor<f32, [4]> dom ← tf32[4] {}
    mut tensor<f32, [3, 4]> table ← tf32[3, 4] {}
    mut tensor<i32, [1]> ids ← tensor<i32, [1]> {}
    mut tensor<f32, [4]> out ← tf32[4] {}
    for range 0‥3 let r {
        for range 0‥4 let c {
            table[[r, c]] ← (r * 10 + c) ↦ f32
        }
    }
    ids[0] ← 2
    ds.gather_row(dom, table, ids, mut out)
    assert close(out[[0]], 20.0)
    assert close(out[[1]], 21.0)
    assert close(out[[2]], 22.0)
    assert close(out[[3]], 23.0)
}

test "decode_step rmsnorm normalises one row with weight" {
    mut tensor<f32, [4]> x ← tf32[4] {}
    mut tensor<f32, [4]> w ← tf32[4] {}
    mut tensor<f32, [4]> out ← tf32[4] {}
    x[[0]] ← 1.0
    x[[1]] ← 2.0
    x[[2]] ← 3.0
    x[[3]] ← 4.0
    w[[0]] ← 1.0
    w[[1]] ← 1.0
    w[[2]] ← 2.0
    w[[3]] ← 2.0
    ds.rmsnorm(x, w, mut out, 0.0)
    # mean(x^2) = 7.5, 1 / sqrt(7.5) = 0.3651484
    assert close(out[[0]], 0.3651484)
    assert close(out[[1]], 0.7302967)
    assert close(out[[2]], 2.1908903)
    assert close(out[[3]], 2.9211872)
}

test "decode_step gemv computes tiled matrix-vector product" {
    mut tensor<f32, [2, 3]> w ← tf32[2, 3] {}
    mut tensor<f32, [3]> x ← tf32[3] {}
    mut tensor<f32, [2]> out ← tf32[2] {}
    for range 0‥2 let r {
        for range 0‥3 let c {
            w[[r, c]] ← (r * 3 + c + 1) ↦ f32
        }
    }
    x[[0]] ← 1.0
    x[[1]] ← 0.0
    x[[2]] ← -1.0
    ds.gemv(w, x, mut out)
    assert close(out[[0]], -2.0)
    assert close(out[[1]], -2.0)
}

test "decode_step qkv_proj fuses Q/K/V GEMVs over shared input" {
    mut tensor<f32, [2, 3]> wq ← tf32[2, 3] {}
    mut tensor<f32, [2, 3]> wk ← tf32[2, 3] {}
    mut tensor<f32, [2, 3]> wv ← tf32[2, 3] {}
    mut tensor<f32, [3]> x ← tf32[3] {}
    mut tensor<f32, [2]> q ← tf32[2] {}
    mut tensor<f32, [2]> k ← tf32[2] {}
    mut tensor<f32, [2]> v ← tf32[2] {}
    x[[0]] ← 1.0
    x[[1]] ← 2.0
    x[[2]] ← -1.0
    wq[[0, 0]] ← 2.0
    wq[[1, 1]] ← 3.0
    wk[[0, 2]] ← 4.0
    wk[[1, 0]] ← 1.0
    wv[[0, 1]] ← -2.0
    wv[[1, 2]] ← 5.0
    ds.qkv_proj(wq, wk, wv, x, mut q, mut k, mut v)
    assert close(q[[0]], 2.0)
    assert close(q[[1]], 6.0)
    assert close(k[[0]], -4.0)
    assert close(k[[1]], 1.0)
    assert close(v[[0]], -4.0)
    assert close(v[[1]], -5.0)
}

test "decode_step gate_up_proj fuses gate and up GEMVs over shared input" {
    mut tensor<f32, [2, 3]> wg ← tf32[2, 3] {}
    mut tensor<f32, [2, 3]> wu ← tf32[2, 3] {}
    mut tensor<f32, [3]> x ← tf32[3] {}
    mut tensor<f32, [2]> g ← tf32[2] {}
    mut tensor<f32, [2]> u ← tf32[2] {}
    x[[0]] ← 1.0
    x[[1]] ← 2.0
    x[[2]] ← 3.0
    wg[[0, 1]] ← 2.0
    wg[[1, 2]] ← -1.0
    wu[[0, 0]] ← 5.0
    wu[[1, 1]] ← 1.5
    ds.gate_up_proj(wg, wu, x, mut g, mut u)
    assert close(g[[0]], 4.0)
    assert close(g[[1]], -3.0)
    assert close(u[[0]], 5.0)
    assert close(u[[1]], 3.0)
}

test "decode_step rope_half rotates the (j, j + span) pairs of each head" {
    mut tensor<f32, [4]> x ← tf32[4] {}
    mut tensor<f32, [4]> out ← tf32[4] {}
    x[[0]] ← 1.0
    x[[1]] ← 2.0
    ds.rope_half(x, mut out, 1, 2, 0.0)
    # ln_theta 0 gives frequency 1: every pair rotates by angle 1.
    assert close(out[[0]], 0.5403023)
    assert close(out[[1]], 1.0806046)
    assert close(out[[2]], 0.841471)
    assert close(out[[3]], 1.682942)
    # Position 0 is the identity.
    ds.rope_half(x, mut out, 0, 2, 0.0)
    assert close(out[[0]], 1.0)
    assert close(out[[1]], 2.0)
    assert close(out[[2]], 0.0)
    assert close(out[[3]], 0.0)
}

test "decode_step rope_pairs rotates the (2p, 2p + 1) pairs of each head" {
    mut tensor<f32, [4]> x ← tf32[4] {}
    mut tensor<f32, [4]> out ← tf32[4] {}
    x[[0]] ← 1.0
    x[[1]] ← 2.0
    x[[2]] ← 3.0
    x[[3]] ← 4.0
    # One head of span 2; ln_theta = 2 ln 4 gives frequencies 1 and 1/4, so at
    # position 2 pair 0 = (x0, x1) rotates by 2 and pair 1 = (x2, x3) by 0.5.
    ds.rope_pairs(x, mut out, 2, 2, 2.7725887)
    assert close(out[[0]], -2.2347417)
    assert close(out[[1]], 0.0770038)
    assert close(out[[2]], 0.7150458)
    assert close(out[[3]], 4.9486069)
    # Position 0 is the identity.
    ds.rope_pairs(x, mut out, 0, 2, 2.7725887)
    assert close(out[[0]], 1.0)
    assert close(out[[1]], 2.0)
    assert close(out[[2]], 3.0)
    assert close(out[[3]], 4.0)
}

test "decode_step rope_pairs restarts the pair frequencies at every head" {
    mut tensor<f32, [8]> x ← tf32[8] {}
    mut tensor<f32, [8]> out ← tf32[8] {}
    for range 0‥8 let j {
        x[[j]] ← (j % 4 + 1) ↦ f32
    }
    ds.rope_pairs(x, mut out, 2, 2, 2.7725887)
    # Both heads hold [1, 2, 3, 4] and rotate identically.
    assert close(out[[0]], -2.2347417)
    assert close(out[[3]], 4.9486069)
    assert close(out[[4]], -2.2347417)
    assert close(out[[5]], 0.0770038)
    assert close(out[[6]], 0.7150458)
    assert close(out[[7]], 4.9486069)
}

test "decode_step rope_half_qk_kv_write matches rope_half plus kv_write_kv" {
    mut tensor<f32, [8]> q_in ← tf32[8] {}
    mut tensor<f32, [4]> k_in ← tf32[4] {}
    mut tensor<f32, [4]> v_in ← tf32[4] {}
    for range 0‥8 let j {
        q_in[[j]] ← (j + 1) ↦ f32
    }
    for range 0‥4 let j {
        k_in[[j]] ← (j * 2 + 1) ↦ f32
        v_in[[j]] ← (j * 3 - 2) ↦ f32
    }
    mut tensor<f32, [8]> q_ref ← tf32[8] {}
    mut tensor<f32, [4]> k_ref ← tf32[4] {}
    mut tensor<f32, [3, 4]> kc_ref ← tf32[3, 4] {}
    mut tensor<f32, [3, 4]> vc_ref ← tf32[3, 4] {}
    ds.rope_half(q_in, mut q_ref, 1, 2, 2.7725887)
    ds.rope_half(k_in, mut k_ref, 1, 2, 2.7725887)
    ds.kv_write_kv(k_ref, v_in, mut kc_ref, mut vc_ref, 1)

    mut tensor<f32, [8]> q_fused ← tf32[8] {}
    mut tensor<f32, [3, 4]> kc_fused ← tf32[3, 4] {}
    mut tensor<f32, [3, 4]> vc_fused ← tf32[3, 4] {}
    ds.rope_half_qk_kv_write(q_in, k_in, v_in, mut q_fused, mut kc_fused, mut vc_fused, 1, 2, 2.7725887)

    for range 0‥8 let j {
        assert close(q_fused[[j]], q_ref[[j]])
    }
    for range 0‥3 let r {
        for range 0‥4 let c {
            assert close(kc_fused[[r, c]], kc_ref[[r, c]])
            assert close(vc_fused[[r, c]], vc_ref[[r, c]])
        }
    }
}

