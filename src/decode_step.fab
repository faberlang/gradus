test "decode_step kv_write appends in place and preserves other rows" {
    mut tensor<f32, [3, 2]> cache ← tf32[3, 2] {}
    mut tensor<f32, [2]> row ← tf32[2] {}
    for range 0‥3 let r {
        for range 0‥2 let c {
            cache[[r, c]] ← (r * 2 + c) ↦ f32
        }
    }
    row[[0]] ← 100.0
    row[[1]] ← 101.0
    ds.kv_write(mut cache, row, 1)
    assert cache[[0, 0]] ≡ (0.0 ↦ f32)
    assert cache[[0, 1]] ≡ (1.0 ↦ f32)
    assert cache[[1, 0]] ≡ (100.0 ↦ f32)
    assert cache[[1, 1]] ≡ (101.0 ↦ f32)
    assert cache[[2, 0]] ≡ (4.0 ↦ f32)
    assert cache[[2, 1]] ≡ (5.0 ↦ f32)

    row[[0]] ← 200.0
    row[[1]] ← 201.0
    ds.kv_write(mut cache, row, 2)
    assert cache[[0, 0]] ≡ (0.0 ↦ f32)
    assert cache[[0, 1]] ≡ (1.0 ↦ f32)
    assert cache[[1, 0]] ≡ (100.0 ↦ f32)
    assert cache[[1, 1]] ≡ (101.0 ↦ f32)
    assert cache[[2, 0]] ≡ (200.0 ↦ f32)
    assert cache[[2, 1]] ≡ (201.0 ↦ f32)

    row[[0]] ← 300.0
    row[[1]] ← 301.0
    ds.kv_write(mut cache, row, -1)
    ds.kv_write(mut cache, row, 3)
    assert cache[[0, 0]] ≡ (0.0 ↦ f32)
    assert cache[[0, 1]] ≡ (1.0 ↦ f32)
    assert cache[[1, 0]] ≡ (100.0 ↦ f32)
    assert cache[[1, 1]] ≡ (101.0 ↦ f32)
    assert cache[[2, 0]] ≡ (200.0 ↦ f32)
    assert cache[[2, 1]] ≡ (201.0 ↦ f32)
}

test "decode_step kv_write_kv writes K and V rows together in one launch" {
    mut tensor<f32, [3, 2]> kc ← tf32[3, 2] {}
    mut tensor<f32, [3, 2]> vc ← tf32[3, 2] {}
    mut tensor<f32, [2]> k ← tf32[2] {}
    mut tensor<f32, [2]> v ← tf32[2] {}
    k[[0]] ← 11.0
    k[[1]] ← 12.0
    v[[0]] ← 21.0
    v[[1]] ← 22.0
    ds.kv_write_kv(k, v, mut kc, mut vc, 1)
    assert kc[[1, 0]] ≡ (11.0 ↦ f32)
    assert kc[[1, 1]] ≡ (12.0 ↦ f32)
    assert vc[[1, 0]] ≡ (21.0 ↦ f32)
    assert vc[[1, 1]] ≡ (22.0 ↦ f32)
    assert kc[[0, 0]] ≡ (0.0 ↦ f32)
    assert vc[[2, 1]] ≡ (0.0 ↦ f32)
}

test "decode_step kv_write_block changes only written rows and clips at capacity" {
    mut tensor<f32, [9, 2]> cache ← tf32[9, 2] {}
    mut tensor<f32, [1, 2]> one ← tf32[1, 2] {}
    mut tensor<f32, [7, 2]> seven ← tf32[7, 2] {}
    mut tensor<f32, [9, 2]> all ← tf32[9, 2] {}
    mut tensor<f32, [4, 2]> tail ← tf32[4, 2] {}
    for range 0‥9 let r {
        for range 0‥2 let c {
            cache[[r, c]] ← (r * 10 + c) ↦ f32
        }
    }
    one[[0, 0]] ← 100.0
    one[[0, 1]] ← 101.0
    ds.kv_write_block(mut cache, one, 3)
    for range 0‥9 let r {
        for range 0‥2 let c {
            if r ≡ 3 {
                assert cache[[r, c]] ≡ (100 + c) ↦ f32
            }
            else {
                assert cache[[r, c]] ≡ (r * 10 + c) ↦ f32
            }
        }
    }

    for range 0‥7 let r {
        for range 0‥2 let c {
            seven[[r, c]] ← (200 + r * 10 + c) ↦ f32
        }
    }
    ds.kv_write_block(mut cache, seven, 1)
    for range 0‥9 let r {
        for range 0‥2 let c {
            if r ≻ 0 and r ≺ 8 {
                assert cache[[r, c]] ≡ (200 + (r - 1) * 10 + c) ↦ f32
            }
            elif r ≡ 0 {
                assert cache[[r, c]] ≡ (c ↦ f32)
            }
            else {
                assert cache[[r, c]] ≡ (80 + c) ↦ f32
            }
        }
    }

    for range 0‥9 let r {
        for range 0‥2 let c {
            all[[r, c]] ← (300 + r * 10 + c) ↦ f32
        }
    }
    ds.kv_write_block(mut cache, all, 0)
    for range 0‥9 let r {
        for range 0‥2 let c {
            assert cache[[r, c]] ≡ (300 + r * 10 + c) ↦ f32
        }
    }

    for range 0‥4 let r {
        for range 0‥2 let c {
            tail[[r, c]] ← (400 + r * 10 + c) ↦ f32
        }
    }
    ds.kv_write_block(mut cache, tail, 7)
    for range 0‥9 let r {
        for range 0‥2 let c {
            if r ≻ 6 {
                assert cache[[r, c]] ≡ (400 + (r - 7) * 10 + c) ↦ f32
            }
            else {
                assert cache[[r, c]] ≡ (300 + r * 10 + c) ↦ f32
            }
        }
    }
}

test "decode_step row_softmax normalises rows" {
    mut tensor<f32, [1, 3]> s ← tf32[1, 3] {}
    mut tensor<f32, [1, 3]> p ← tf32[1, 3] {}
    s[[0, 0]] ← 1.0
    s[[0, 1]] ← 2.0
    s[[0, 2]] ← 3.0
    ds.row_softmax(s, mut p)
    assert close(p[[0, 0]], 0.0900306)
    assert close(p[[0, 1]], 0.2447285)
    assert close(p[[0, 2]], 0.6652410)
}

test "decode_step GQA decode attention masks past pos and shares a KV head" {
    # 2 query heads of dh 2 share one KV head (group 2); 3 cache rows, pos 1.
    mut tensor<f32, [2, 3]> hc ← tf32[2, 3] {}
    mut tensor<f32, [4]> qdom ← tf32[4] {}
    mut tensor<f32, [4]> q ← tf32[4] {}
    mut tensor<f32, [3, 2]> kc ← tf32[3, 2] {}
    mut tensor<f32, [3, 2]> vc ← tf32[3, 2] {}
    mut tensor<f32, [2, 3]> sc ← tf32[2, 3] {}
    mut tensor<f32, [2, 3]> p ← tf32[2, 3] {}
    mut tensor<f32, [4]> ctx ← tf32[4] {}
    mut tensor<f32, [2, 4]> cpdom ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> cp ← tf32[2, 4] {}
    mut tensor<f32, [4]> ctx_split ← tf32[4] {}
    q[[0]] ← 1.0
    q[[3]] ← 1.0
    kc[[0, 0]] ← 1.0
    kc[[1, 1]] ← 1.0
    kc[[2, 0]] ← 5.0
    kc[[2, 1]] ← 5.0
    vc[[0, 0]] ← 1.0
    vc[[1, 1]] ← 1.0
    vc[[2, 0]] ← 9.0
    vc[[2, 1]] ← 9.0
    ds.attn_scores(hc, q, kc, mut sc, 1, 2, 2, 1.0)
    assert close(sc[[0, 0]], 1.0)
    assert close(sc[[0, 1]], 0.0)
    assert close(sc[[1, 0]], 0.0)
    assert close(sc[[1, 1]], 1.0)
    assert sc[[0, 2]] ≺ -1.0e29
    ds.row_softmax(sc, mut p)
    # e / (1 + e) = 0.7310586 on the larger score, 0 on the masked column.
    assert close(p[[0, 0]], 0.7310586)
    assert close(p[[0, 1]], 0.2689414)
    assert close(p[[0, 2]], 0.0)
    ds.attn_context(qdom, p, vc, mut ctx, 1, 2, 2)
    assert close(ctx[[0]], 0.7310586)
    assert close(ctx[[1]], 0.2689414)
    assert close(ctx[[2]], 0.2689414)
    assert close(ctx[[3]], 0.7310586)
    ds.context_part(cpdom, p, vc, mut cp, 1, 2, 2)
    ds.context_fin(qdom, cp, mut ctx_split)
    assert close(ctx_split[[0]], ctx[[0]])
    assert close(ctx_split[[1]], ctx[[1]])
    assert close(ctx_split[[2]], ctx[[2]])
    assert close(ctx_split[[3]], ctx[[3]])
}

test "decode_step ring KV write and windowed attention wrap around window" {
    # 2 query heads of dh 2, 1 KV head (group 2); ring window 3, pos 3 wraps to slot 0.
    mut tensor<f32, [2, 3]> hc ← tf32[2, 3] {}
    mut tensor<f32, [4]> qdom ← tf32[4] {}
    mut tensor<f32, [4]> q ← tf32[4] {}
    mut tensor<f32, [2]> k_row ← tf32[2] {}
    mut tensor<f32, [2]> v_row ← tf32[2] {}
    mut tensor<f32, [3, 2]> kc ← tf32[3, 2] {}
    mut tensor<f32, [3, 2]> vc ← tf32[3, 2] {}
    mut tensor<f32, [2, 3]> sc ← tf32[2, 3] {}
    mut tensor<f32, [2, 3]> p ← tf32[2, 3] {}
    mut tensor<f32, [4]> ctx ← tf32[4] {}
    q[[0]] ← 1.0
    q[[3]] ← 1.0
    # Write pos 0, 1, 2, then pos 3 (overwrites slot 0)
    k_row[[0]] ← 9.0
    v_row[[0]] ← 9.0
    ds.kv_ring_write_kv(k_row, v_row, mut kc, mut vc, 0, 3)
    k_row[[0]] ← 0.0
    k_row[[1]] ← 1.0
    v_row[[0]] ← 0.0
    v_row[[1]] ← 1.0
    ds.kv_ring_write_kv(k_row, v_row, mut kc, mut vc, 1, 3)
    k_row[[0]] ← 0.0
    k_row[[1]] ← 0.0
    v_row[[0]] ← 0.0
    v_row[[1]] ← 0.0
    ds.kv_ring_write_kv(k_row, v_row, mut kc, mut vc, 2, 3)
    k_row[[0]] ← 1.0
    k_row[[1]] ← 0.0
    v_row[[0]] ← 1.0
    v_row[[1]] ← 0.0
    ds.kv_ring_write_kv(k_row, v_row, mut kc, mut vc, 3, 3)

    ds.attn_scores_ring(hc, q, kc, mut sc, 3, 3, 2, 2, 1.0)
    assert close(sc[[0, 0]], 1.0)
    assert close(sc[[0, 1]], 0.0)
    assert close(sc[[0, 2]], 0.0)
    assert close(sc[[1, 1]], 1.0)
    ds.row_softmax(sc, mut p)
    ds.attn_context_ring(qdom, p, vc, mut ctx, 3, 3, 2, 2)
    assert ctx[[0]] ≻ 0.5
    assert ctx[[3]] ≻ 0.5
}

test "decode_step residual_add and swiglu are elementwise" {
    mut tensor<f32, [2]> a ← tf32[2] {}
    mut tensor<f32, [2]> b ← tf32[2] {}
    mut tensor<f32, [2]> sum ← tf32[2] {}
    mut tensor<f32, [2]> act ← tf32[2] {}
    a[[0]] ← 0.0
    a[[1]] ← 1.0
    b[[0]] ← 2.0
    b[[1]] ← 3.0
    ds.residual_add(a, b, mut sum)
    ds.swiglu(a, b, mut act)
    assert close(sum[[0]], 2.0)
    assert close(sum[[1]], 4.0)
    # silu(0) = 0; silu(1) = 0.7310586, times 3.
    assert close(act[[0]], 0.0)
    assert close(act[[1]], 2.1931758)
}

test "decode_step argmax_token writes the global best index" {
    mut tensor<f32, [12]> x ← tf32[12] {}
    mut tensor<i32, [1]> idx ← tensor<i32, [1]> {}
    x[[0]] ← 1.0
    x[[1]] ← 5.0
    x[[2]] ← 5.0
    x[[3]] ← -3.0
    x[[4]] ← -1.0
    x[[5]] ← -2.0
    x[[6]] ← 0.0
    x[[7]] ← 0.0
    x[[8]] ← 0.0
    x[[9]] ← -9.0
    x[[10]] ← -8.0
    x[[11]] ← 7.0
    ds.argmax_token(x, mut idx)
    assert idx[0] ≡ 11
}

test "decode_step argmax_token ties keep the lowest global index" {
    mut tensor<f32, [12]> x ← tf32[12] {}
    mut tensor<i32, [1]> idx ← tensor<i32, [1]> {}
    for range 0‥12 let i {
        x[[i]] ← -4.0
    }
    x[[2]] ← 2.5
    x[[3]] ← 2.5
    x[[8]] ← 2.5
    ds.argmax_token(x, mut idx)
    assert idx[0] ≡ 2
}

test "decode_step argmax_token all-equal picks zero and later maximum wins" {
    mut tensor<f32, [12]> x ← tf32[12] {}
    mut tensor<i32, [1]> idx ← tensor<i32, [1]> {}
    for range 0‥12 let i {
        x[[i]] ← 0.25
    }
    ds.argmax_token(x, mut idx)
    assert idx[0] ≡ 0
    x[[6]] ← 0.5
    ds.argmax_token(x, mut idx)
    assert idx[0] ≡ 6
}

test "decode_step topm_chunks writes each chunk's top-M pairs in descending value, ties to the lowest index" {
    mut tensor<f32, [2]> dom ← tf32[2] {}
    mut tensor<f32, [8]> x ← tf32[8] {}
    mut tensor<f32, [2, 3]> val ← tf32[2, 3] {}
    mut tensor<i32, [2, 3]> idx ← ti32[2, 3] {}
    # chunks of 4: [0 1 2 3] [4 5 6 7]
    x[[0]] ← 1.0
    x[[1]] ← 5.0
    x[[2]] ← 5.0
    x[[3]] ← 3.0
    x[[4]] ← -1.0
    x[[5]] ← 9.0
    x[[6]] ← -1.0
    x[[7]] ← 2.0
    ds.topm_chunks(dom, x, mut val, mut idx, 4)
    assert close(val[[0, 0]], 5.0)
    assert idx[[0, 0]] ≡ 1
    assert close(val[[0, 1]], 5.0)
    assert idx[[0, 1]] ≡ 2
    assert close(val[[0, 2]], 3.0)
    assert idx[[0, 2]] ≡ 3
    assert close(val[[1, 0]], 9.0)
    assert idx[[1, 0]] ≡ 5
    assert close(val[[1, 1]], 2.0)
    assert idx[[1, 1]] ≡ 7
    assert close(val[[1, 2]], -1.0)
    assert idx[[1, 2]] ≡ 4
}

test "decode_step topm_chunks: a tie across a chunk boundary keeps the lowest index per chunk" {
    mut tensor<f32, [2]> dom ← tf32[2] {}
    mut tensor<f32, [8]> x ← tf32[8] {}
    mut tensor<f32, [2, 2]> val ← tf32[2, 2] {}
    mut tensor<i32, [2, 2]> idx ← ti32[2, 2] {}
    for range 0‥8 let i {
        x[[i]] ← -4.0
    }
    x[[3]] ← 2.5
    x[[4]] ← 2.5
    x[[6]] ← 2.5
    ds.topm_chunks(dom, x, mut val, mut idx, 4)
    assert idx[[0, 0]] ≡ 3
    assert close(val[[0, 1]], -4.0)
    assert idx[[0, 1]] ≡ 0
    assert idx[[1, 0]] ≡ 4
    assert idx[[1, 1]] ≡ 6
}

test "decode_step topm_chunks: a chunk shorter than M fills the trailing slots with the sentinel index -1" {
    mut tensor<f32, [2]> dom ← tf32[2] {}
    mut tensor<f32, [4]> x ← tf32[4] {}
    mut tensor<f32, [2, 3]> val ← tf32[2, 3] {}
    mut tensor<i32, [2, 3]> idx ← ti32[2, 3] {}
    x[[0]] ← 1.0
    x[[1]] ← 4.0
    x[[2]] ← 2.0
    x[[3]] ← 2.0
    ds.topm_chunks(dom, x, mut val, mut idx, 2)
    assert idx[[0, 0]] ≡ 1
    assert idx[[0, 1]] ≡ 0
    assert idx[[0, 2]] ≡ -1
    assert idx[[1, 0]] ≡ 2
    assert idx[[1, 1]] ≡ 3
    assert idx[[1, 2]] ≡ -1
}

@ public
kernel read_topm_indices<size P, size M>(tensor<i32, [P, M]> ridx, mut tensor<i32, [P]> rsum) → void {
    for from rsum at [p] thread lane let e {
        mut i32 acc ← 0

        for range 0 ‥ M let m {
            let i32 picked ← ridx[[p, m]]

            if picked ≥ 0 {
                acc ← acc + picked
            }
        }

        rsum[[p]] ← acc
    }
}

test "decode_step topm_chunks selects lower-index elements after a tie" {
    mut tensor<f32, [1]> dom ← tf32[1] {}
    mut tensor<f32, [4]> x ← tf32[4] {}
    mut tensor<f32, [1, 3]> val ← tf32[1, 3] {}
    mut tensor<i32, [1, 3]> idx ← ti32[1, 3] {}
    x[[0]] ← 3.0
    x[[1]] ← 5.0
    x[[2]] ← 5.0
    x[[3]] ← 1.0
    ds.topm_chunks(dom, x, mut val, mut idx, 4)
    assert close(val[[0, 0]], 5.0)
    assert idx[[0, 0]] ≡ 1
    assert close(val[[0, 1]], 5.0)
    assert idx[[0, 1]] ≡ 2
    assert close(val[[0, 2]], 3.0)
    assert idx[[0, 2]] ≡ 0
}

test "decode_step topm_chunks i32 indices and -1 sentinels are readable by a downstream kernel" {
    mut tensor<f32, [2]> dom ← tf32[2] {}
    mut tensor<f32, [4]> x ← tf32[4] {}
    mut tensor<f32, [2, 3]> val ← tf32[2, 3] {}
    mut tensor<i32, [2, 3]> idx ← ti32[2, 3] {}
    mut tensor<i32, [2]> sum ← ti32[2] {}
    x[[0]] ← 1.0
    x[[1]] ← 4.0
    x[[2]] ← 2.0
    x[[3]] ← 2.0
    ds.topm_chunks(dom, x, mut val, mut idx, 2)
    read_topm_indices(idx, mut sum)
    assert sum[[0]] ≡ 1
    assert sum[[1]] ≡ 5
}

test "decode_step topm_chunks preserves tie order when a later maximum shifts earlier ties down" {
    mut tensor<f32, [1]> dom ← tf32[1] {}
    mut tensor<f32, [6]> x ← tf32[6] {}
    mut tensor<f32, [1, 4]> val ← tf32[1, 4] {}
    mut tensor<i32, [1, 4]> idx ← ti32[1, 4] {}
    x[[0]] ← 2.0
    x[[1]] ← 2.0
    x[[2]] ← 4.0
    x[[3]] ← 2.0
    x[[4]] ← 4.0
    x[[5]] ← 1.0
    ds.topm_chunks(dom, x, mut val, mut idx, 6)
    assert close(val[[0, 0]], 4.0)
    assert idx[[0, 0]] ≡ 2
    assert close(val[[0, 1]], 4.0)
    assert idx[[0, 1]] ≡ 4
    assert close(val[[0, 2]], 2.0)
    assert idx[[0, 2]] ≡ 0
    assert close(val[[0, 3]], 2.0)
    assert idx[[0, 3]] ≡ 1
}

test "decode_step topm_chunks handles sentinel-magnitude values and partial trailing chunks" {
    mut tensor<f32, [2]> dom ← tf32[2] {}
    mut tensor<f32, [5]> x ← tf32[5] {}
    mut tensor<f32, [2, 3]> val ← tf32[2, 3] {}
    mut tensor<i32, [2, 3]> idx ← ti32[2, 3] {}
    x[[0]] ← -3.4028235e38
    x[[1]] ← 4.0
    x[[2]] ← 1.5
    x[[3]] ← -2.0
    x[[4]] ← 7.0
    ds.topm_chunks(dom, x, mut val, mut idx, 3)
    assert close(val[[0, 0]], 4.0)
    assert idx[[0, 0]] ≡ 1
    assert close(val[[0, 1]], 1.5)
    assert idx[[0, 1]] ≡ 2
    assert idx[[0, 2]] ≡ 0
    assert close(val[[1, 0]], 7.0)
    assert idx[[1, 0]] ≡ 4
    assert close(val[[1, 1]], -2.0)
    assert idx[[1, 1]] ≡ 3
    assert idx[[1, 2]] ≡ -1
}

test "decode_step kv_write_rows skips negative and out-of-capacity positions" {
    mut tensor<f32, [4, 2]> cache ← tf32[4, 2] {}
    mut tensor<f32, [2, 2]> block ← tf32[2, 2] {}
    for range 0‥4 let r {
        for range 0‥2 let c {
            cache[[r, c]] ← (r * 10 + c) ↦ f32
        }
    }
    for range 0‥2 let r {
        for range 0‥2 let c {
            block[[r, c]] ← (100 + r * 10 + c) ↦ f32
        }
    }
    ds.kv_write_rows(block, mut cache, -1)
    ds.kv_write_rows(block, mut cache, 4)
    ds.kv_write_rows(block, mut cache, 3)
    for range 0‥3 let r {
        for range 0‥2 let c {
            assert cache[[r, c]] ≡ (r * 10 + c) ↦ f32
        }
    }
    assert cache[[3, 0]] ≡ (100.0 ↦ f32)
    assert cache[[3, 1]] ≡ (101.0 ↦ f32)
}

test "decode_step kv_write_kv_batch writes active rows only and clips at capacity" {
    mut tensor<f32, [4, 2]> kc ← tf32[4, 2] {}
    mut tensor<f32, [4, 2]> vc ← tf32[4, 2] {}
    mut tensor<f32, [3, 2]> bk ← tf32[3, 2] {}
    mut tensor<f32, [3, 2]> bv ← tf32[3, 2] {}
    for range 0‥4 let r {
        for range 0‥2 let c {
            kc[[r, c]] ← (r * 10 + c) ↦ f32
            vc[[r, c]] ← (50 + r * 10 + c) ↦ f32
        }
    }
    for range 0‥3 let r {
        for range 0‥2 let c {
            bk[[r, c]] ← (100 + r * 10 + c) ↦ f32
            bv[[r, c]] ← (200 + r * 10 + c) ↦ f32
        }
    }
    ds.kv_write_kv_batch(bk, bv, mut kc, mut vc, 1, 2)
    assert kc[[0, 0]] ≡ (0.0 ↦ f32)
    assert kc[[1, 0]] ≡ (100.0 ↦ f32)
    assert kc[[2, 1]] ≡ (111.0 ↦ f32)
    assert kc[[3, 0]] ≡ (30.0 ↦ f32)
    assert vc[[0, 1]] ≡ (51.0 ↦ f32)
    assert vc[[1, 1]] ≡ (201.0 ↦ f32)
    assert vc[[2, 0]] ≡ (210.0 ↦ f32)
    assert vc[[3, 1]] ≡ (81.0 ↦ f32)

    ds.kv_write_kv_batch(bk, bv, mut kc, mut vc, -1, 2)
    ds.kv_write_kv_batch(bk, bv, mut kc, mut vc, 3, 3)
    assert kc[[2, 1]] ≡ (111.0 ↦ f32)
    assert kc[[3, 0]] ≡ (100.0 ↦ f32)
    assert vc[[3, 1]] ≡ (201.0 ↦ f32)
}

test "decode_step table-driven rope_half_table and rope_pairs_table match direct RoPE kernels" {
    mut tensor<f32, [8]> x ← tf32[8] {}
    mut tensor<f32, [8]> direct_half ← tf32[8] {}
    mut tensor<f32, [8]> table_half ← tf32[8] {}
    mut tensor<f32, [8]> direct_pairs ← tf32[8] {}
    mut tensor<f32, [8]> table_pairs ← tf32[8] {}
    mut tensor<f32, [2]> tcos ← tf32[2] {}
    mut tensor<f32, [2]> tsin ← tf32[2] {}
    for range 0‥8 let j {
        x[[j]] ← (j + 1) ↦ f32
    }
    ds.rope_table(mut tcos, mut tsin, 2, 2.7725887)
    ds.rope_half(x, mut direct_half, 2, 2, 2.7725887)
    ds.rope_half_table(x, tcos, tsin, mut table_half)
    ds.rope_pairs(x, mut direct_pairs, 2, 2, 2.7725887)
    ds.rope_pairs_table(x, tcos, tsin, mut table_pairs)
    for range 0‥8 let j {
        assert close(table_half[[j]], direct_half[[j]])
        assert close(table_pairs[[j]], direct_pairs[[j]])
    }
}

test "decode_step batched table-driven RoPE twins match direct batched kernels for active rows" {
    mut tensor<f32, [3, 8]> bx ← tf32[3, 8] {}
    mut tensor<f32, [3, 8]> direct_half ← tf32[3, 8] {}
    mut tensor<f32, [3, 8]> table_half ← tf32[3, 8] {}
    mut tensor<f32, [3, 8]> direct_pairs ← tf32[3, 8] {}
    mut tensor<f32, [3, 8]> table_pairs ← tf32[3, 8] {}
    mut tensor<f32, [3, 2]> bcos ← tf32[3, 2] {}
    mut tensor<f32, [3, 2]> bsin ← tf32[3, 2] {}
    for range 0‥3 let b {
        for range 0‥8 let j {
            bx[[b, j]] ← (b * 10 + j + 1) ↦ f32
            direct_half[[b, j]] ← -9.0
            table_half[[b, j]] ← -9.0
            direct_pairs[[b, j]] ← -9.0
            table_pairs[[b, j]] ← -9.0
        }
    }
    ds.rope_table_batch(mut bcos, mut bsin, 3, 2.7725887, 2)
    ds.rope_half_batch(bx, mut direct_half, 3, 2, 2.7725887, 2)
    ds.rope_half_table_batch(bx, bcos, bsin, mut table_half, 2)
    ds.rope_pairs_batch(bx, mut direct_pairs, 3, 2, 2.7725887, 2)
    ds.rope_pairs_table_batch(bx, bcos, bsin, mut table_pairs, 2)
    for range 0‥3 let b {
        for range 0‥8 let j {
            assert close(table_half[[b, j]], direct_half[[b, j]])
            assert close(table_pairs[[b, j]], direct_pairs[[b, j]])
        }
    }
    assert close(table_half[[2, 0]], -9.0)
    assert close(table_pairs[[2, 7]], -9.0)
}
