+++ toml
locale = "en"

+++ faber
# Single-token decode device kernels, shape-generic over every tensor axis.
#
# Public import: import from "gradus:decode_step" ds
# Zero imports: self-contained under the compiler's kernel subset.
#
# Portability & KIR performance contracts:
#   - Arithmetic indices and symbolic 2D index products inside inner loops
#     must stay proven within `i64` for portable Cranelift CPU + Metal GPU
#     KIR admission (using `∧` bitmasks where symbolic strides multiply
#     lane coordinates, so no kernel needs `wide-integer-carrier (i64 mul)`).
#   - RMSNorm, GEMV, fused multi-output projections, and row softmax delegate
#     to the compiler's native tensor contractions/reductions (`norm_rms`, `·`,
#     `softmax()`) for parallel tiled execution.
#   - GQA context supports both direct (`attn_context`) and split-K
#     (`context_part` + `context_fin`) forms.
#
# Tolerances against a high-precision reference for real-weight model layers:
#   abs <= 1e-5 + 1e-4 * abs(ref).
# ---------------------------------------------------------------------------
# Tensor primitives (Metal GPU + CPU KIR native)
# ---------------------------------------------------------------------------
# Prime a 1D kernel-written tensor on the device before its first write so
# later launches reuse device storage without extra host uploads or waits.
@ public
kernel prime1<size N>(tensor<f32, [N]> ptarget, mut tensor<f32, [1]> psink) → void {
    psink[0] ← reduce via sum from ptarget at [i] thread lane let v {
        return v
    }
}

# Prime a 2D kernel-written tensor (partial matrices, score matrices, caches).
@ public
kernel prime2<size R, size C>(tensor<f32, [R, C]> ptarget, mut tensor<f32, [1]> psink) → void {
    for from psink at [i] thread lane let e {
        psink[[i]] ← ptarget[[0, 0]]
    }
}

# Embedding gather: gout[j] = gtable[ids[0], j]. `gdom` is the lane domain [D].
@ public
kernel gather_row<size V, size D>(tensor<f32, [D]> gdom, tensor<f32, [V, D]> gtable, tensor<i32, [1]> gids, mut tensor<f32, [D]> gout) → void {
    for from gdom at [j] thread lane let e {
        gout[[j]] ← gtable[[gids[0], j]]
    }
}

# Embedding gather using the output tensor as its own lane domain [D].
@ public
kernel gather_wide<size V, size D>(tensor<f32, [V, D]> gwtable, tensor<i32, [1]> gwids, mut tensor<f32, [D]> gwo) → void {
    for from gwo at [j] thread lane let e {
        gwo[[j]] ← gwtable[[gwids[0], j]]
    }
}

# RMSNorm in one parallel tiled launch: rmo = (rmx / rms(rmx, rmeps)) * rmw.
@ public
kernel rmsnorm<size D>(tensor<f32, [D]> rmx, tensor<f32, [D]> rmw, mut tensor<f32, [D]> rmo, f32 rmeps) → void {
    rmo ⇇ rmx.norm_rms(axis 0, rmeps, rmw)
}

# GEMV in one parallel tiled launch: gmy = gmw · gmx.
@ public
kernel gemv<size N, size K>(tensor<f32, [N, K]> gmw, tensor<f32, [K]> gmx, mut tensor<f32, [N]> gmy) → void {
    gmy ⇇ gmw · gmx
}

# Fused Q/K/V projection sharing input `x` in one launch:
#   q = wq · x, k = wk · x, v = wv · x.
@ public
kernel qkv_proj<size QD, size KVD, size D>(tensor<f32, [QD, D]> wq, tensor<f32, [KVD, D]> wk, tensor<f32, [KVD, D]> wv, tensor<f32, [D]> x, mut tensor<f32, [QD]> q, mut tensor<f32, [KVD]> k, mut tensor<f32, [KVD]> v) → void {
    q ⇇ wq · x
    k ⇇ wk · x
    v ⇇ wv · x
}

# Fused gate/up projection sharing input `x` in one launch:
#   g = wg · x, u = wu · x.
@ public
kernel gate_up_proj<size F, size D>(tensor<f32, [F, D]> wg, tensor<f32, [F, D]> wu, tensor<f32, [D]> x, mut tensor<f32, [F]> g, mut tensor<f32, [F]> u) → void {
    g ⇇ wg · x
    u ⇇ wu · x
}

# Rotate-half RoPE over a flat vector of heads [N = heads * 2 * rhspan]: the
# pair (jj, jj + rhspan) of each head rotates by rhpos * theta^(-p / rhspan),
# where p = jj mod rhspan and jj = j mod (2 * rhspan).
@ public
kernel rope_half<size N>(tensor<f32, [N]> rhx, mut tensor<f32, [N]> rho, i32 rhpos, i32 rhspan, f32 rhlntheta) → void {
    for from rhx at [j] thread lane let v {
        if rhspan ≻ 0 and rhspan ≤ 960 {
            let i32 hf ← rhspan
            let i32 jj ← j % (2 * hf)
            let i32 base ← j - jj
            let i32 p ← jj % hf
            let f32 freq ← (-(p ↦ f32) / (hf ↦ f32) * rhlntheta).exp()
            let f32 ang ← (rhpos ↦ f32) * freq
            let f32 c ← ang.cos()
            let f32 s ← ang.sin()

            if jj ≺ hf {
                rho[[j]] ← v * c - rhx[[base + jj + hf]] * s
            }
            else {
                rho[[j]] ← rhx[[base + jj - hf]] * s + v * c
            }
        }
    }
}

# Consecutive-pair (llama NORM) RoPE over a flat vector of heads
# [N = heads * 2 * rpspan]: the pair (jj, jj + 1) for even jj rotates by
# rppos * theta^(-p / rpspan), where p = jj / 2 and jj = j mod (2 * rpspan).
@ public
kernel rope_pairs<size N>(tensor<f32, [N]> rpx, mut tensor<f32, [N]> rpo, i32 rppos, i32 rpspan, f32 rplntheta) → void {
    for from rpx at [j] thread lane let v {
        if rpspan ≻ 0 and rpspan ≤ 960 {
            let i32 hf ← rpspan
            let i32 jj ← j % (2 * hf)
            let i32 p ← jj / 2
            let f32 freq ← (-(p ↦ f32) / (hf ↦ f32) * rplntheta).exp()
            let f32 ang ← (rppos ↦ f32) * freq
            let f32 c ← ang.cos()
            let f32 s ← ang.sin()

            if jj % 2 ≡ 0 {
                rpo[[j]] ← v * c - rpx[[j + 1]] * s
            }
            else {
                rpo[[j]] ← rpx[[j - 1]] * s + v * c
            }
        }
    }
}

# KV-row write: update row `kwpos` in the existing cache. A negative or
# out-of-capacity position leaves the cache unchanged.
@ public
kernel kv_write_row<size C, size K>(tensor<f32, [K]> kwrow, mut tensor<f32, [C, K]> kwcache, i32 kwpos) → void {
    for from kwrow at [j] thread lane let v {
        if kwpos ≥ 0 and kwpos ≺ C {
            kwcache[[kwpos, j]] ← v
        }
    }
}

# Single-row KV-cache append helper (`[C, K]` updated at `kwpos`).
@ public
fn kv_write<size C, size K>(mut tensor<f32, [C, K]> kwcache, tensor<f32, [K]> kwrow, i32 kwpos) → void {
    kv_write_row(kwrow, mut kwcache, kwpos)
}

# Fused K and V cache row append at `kwpos` in one launch.
@ public
kernel kv_write_kv<size C, size K>(tensor<f32, [K]> kwk, tensor<f32, [K]> kwv, mut tensor<f32, [C, K]> kwkc, mut tensor<f32, [C, K]> kwvc, i32 kwpos) → void {
    for from kwk at [j] thread lane let vk {
        if kwpos ≥ 0 and kwpos ≺ C {
            kwkc[[kwpos, j]] ← vk
            kwvc[[kwpos, j]] ← kwv[[j]]
        }
    }
}

# KV-block write: update rows `kwpos .. kwpos + N` from `kwblock` in one
# launch. Rows outside the cache are skipped independently.
@ public
kernel kv_write_rows<size N, size C, size K>(tensor<f32, [N, K]> kwblock, mut tensor<f32, [C, K]> kwcache, i32 kwpos) → void {
    for from kwcache at [r, j] thread lane let old {
        if kwpos ≥ 0 and r ≥ kwpos and r - kwpos ≺ N {
            kwcache[[r, j]] ← kwblock[[r - kwpos, j]]
        }
    }
}

# Host entry for an in-place block write; one device launch writes all valid rows.
@ public
fn kv_write_block<size N, size C, size K>(mut tensor<f32, [C, K]> kwcache, tensor<f32, [N, K]> kwblock, i32 kwpos) → void {
    kv_write_rows(kwblock, mut kwcache, kwpos)
}

# GQA decode scores: assc[h, c] = (asq[h * dh + :] . askc[c, (h / group) * dh + :])
# * asscale, masked to -3.0e38 for c > aspos so `row_softmax` zeroes masked slots.
@ public
kernel attn_scores<size H, size C, size QD, size KVD>(tensor<f32, [H, C]> asdom, tensor<f32, [QD]> asq, tensor<f32, [C, KVD]> askc, mut tensor<f32, [H, C]> assc, i32 aspos, i32 asgroup, i32 asdh, f32 asscale) → void {
    for from asdom at [h, c] thread lane let e {
        if c ≻ aspos or aspos ≺ 0 {
            assc[[h, c]] ← -3.0e38
        }
        elif asgroup ≻ 0 and asdh ≥ 1 and asdh ≤ 960 and asgroup ≤ 128 and h ∈ 0 … 4095 and c ∈ 0 … 16777215 {
            let i32 hh ← h ∧ 4095
            let i32 cc ← c ∧ 16777215
            let i32 qbase ← hh * asdh
            let i32 kbase ← hh / asgroup * asdh
            mut f32 acc ← 0.0

            for range 0 ‥ asdh let kk {
                acc ← acc + asq[[qbase + kk]] * askc[[cc, kbase + kk]]
            }

            assc[[h, c]] ← acc * asscale
        }
    }
}

# Row softmax in one parallel tiled launch: rso[h, :] = softmax(rsi[h, :]).
@ public
kernel row_softmax<size H, size C>(tensor<f32, [H, C]> rsi, mut tensor<f32, [H, C]> rso) → void {
    rso ⇇ rsi.softmax()
}

# GQA decode context (direct form for small cache capacity):
# acctx[h * dh + d] = sum_{c <= acpos} acp[h, c] * acvc[c, (h / group) * dh + d].
@ public
kernel attn_context<size QD, size H, size C, size KVD>(tensor<f32, [QD]> acdom, tensor<f32, [H, C]> acp, tensor<f32, [C, KVD]> acvc, mut tensor<f32, [QD]> acctx, i32 acpos, i32 acgroup, i32 acdh) → void {
    for from acdom at [j] thread lane let e {
        if acgroup ≻ 0 and acdh ≥ 1 and acdh ≤ 960 and acpos ≥ 0 and acpos ≺ C {
            let i32 dh ← acdh
            let i32 h ← j / dh
            let i32 d ← j % dh
            let i32 n ← acpos + 1
            let i32 base ← h / acgroup * dh
            let i32 vcol ← base + d
            mut f32 acc ← 0.0

            for range 0 ‥ n let c {
                acc ← acc + acp[[h, c]] * acvc[[c, vcol]]
            }

            acctx[[j]] ← acc
        }
    }
}

# GQA decode context phase 1 (split-K over P partitions of cache rows):
# cppart[p, j] = sum_{c = p, p + P, ... <= cppos} cpp[h, c] * cpvc[c, base + d].
@ public
kernel context_part<size P, size QD, size H, size C, size KVD>(tensor<f32, [P, QD]> cpdom, tensor<f32, [H, C]> cpp, tensor<f32, [C, KVD]> cpvc, mut tensor<f32, [P, QD]> cppart, i32 cppos, i32 cpgroup, i32 cpdh) → void {
    for from cpdom at [p, j] thread lane let e {
        if cpgroup ≻ 0 and cpdh ≥ 1 and cpdh ≤ 960 and cppos ≥ 0 and cppos ≺ C {
            let i32 dh ← cpdh
            let i32 h ← j / dh
            let i32 d ← j % dh
            let i32 base ← h / cpgroup * dh
            let i32 vcol ← base + d
            mut f32 acc ← 0.0
            mut i32 c ← p

            while c ≤ cppos {
                acc ← acc + cpp[[h, c]] * cpvc[[c, vcol]]
                c ← c + P
            }

            cppart[[p, j]] ← acc
        }
    }
}

# GQA decode context phase 2: cfout[j] = sum_{p = 0 .. P - 1} cfpart[p, j].
@ public
kernel context_fin<size P, size QD>(tensor<f32, [QD]> cfdom, tensor<f32, [P, QD]> cfpart, mut tensor<f32, [QD]> cfout) → void {
    for from cfdom at [j] thread lane let e {
        mut f32 acc ← 0.0

        for range 0 ‥ P let p {
            acc ← acc + cfpart[[p, j]]
        }

        cfout[[j]] ← acc
    }
}

# Residual add: reo[j] = rea[j] + reb[j].
@ public
kernel residual_add<size D>(tensor<f32, [D]> rea, tensor<f32, [D]> reb, mut tensor<f32, [D]> reo) → void {
    for from rea at [j] thread lane let a {
        reo[[j]] ← a + reb[[j]]
    }
}

# SwiGLU: swo[j] = silu(swg[j]) * swu[j], silu(v) = v / (1 + exp(-v)).
@ public
kernel swiglu<size F>(tensor<f32, [F]> swg, tensor<f32, [F]> swu, mut tensor<f32, [F]> swo) → void {
    for from swg at [j] thread lane let v {
        swo[[j]] ← v / (1.0 + (-v).exp()) * swu[[j]]
    }
}

# Argmax over logits `atx[V]`, writing the 1-element index tensor `atid[0]`.
# Equal maxima keep the lowest index.
@ public
kernel argmax_token<size V>(tensor<f32, [V]> atx, mut tensor<i32, [1]> atid) → void {
    atid[0] ← reduce via argmax from atx at [i] thread lane let v {
        return v
    } coalesce 0
}

# Chunked top-M: lane (p, m) of [P, M] writes the m-th best (value, global index)
# pair of chunk p (descending value, ties to lowest index).
@ public
kernel topm_chunks<size P, size V, size M>(tensor<f32, [P, M]> tmdom, tensor<f32, [V]> tmx, mut tensor<f32, [P, M]> tmval, mut tensor<f32, [P, M]> tmidx, i32 tmchunk) → void {
    for from tmdom at [p, m] thread lane let e {
        if tmchunk ≥ 1 {
            let i32 n ← tmchunk
            let i32 start ← p * n
            let i32 stop ← start + n
            mut f32 pv ← 3.4028235e38
            mut f32 pf ← -1.0

            for range 0 … m let rank {
                mut f32 best ← -3.4028235e38
                mut i32 bi ← -1

                for range start ‥ stop let k {
                    let f32 v ← tmx[[k]]

                    if v ≺ pv or v ≡ pv and (k ↦ f32) ≻ pf {
                        if bi ≺ 0 or v ≻ best {
                            best ← v
                            bi ← k
                        }
                    }
                }

                pv ← best
                pf ← bi ↦ f32
            }

            tmval[[p, m]] ← pv
            tmidx[[p, m]] ← pf
        }
    }
}

+++ faber test
# Co-located package test for decode_step.fab. Runs through KIR on CPU and Metal.

import from "gradus:decode_step" ds

fn close(f32 a, f32 b) → bool {
    return (a - b).abs() ≺ 0.0001
}

test "decode_step gather_row copies the embedding row named by ids[0]" {
    mut tensor<f32, [4]> dom ← tf32[4] {}
    mut tensor<f32, [3, 4]> table ← tf32[3, 4] {}
    mut tensor<i32, [1]> ids ← tensor<i32, [1]> {}
    mut tensor<f32, [4]> out ← tf32[4] {}
    for range 0‥3 let r {
        for range 0‥4 let c {
            table[[r, c]] ← (r * 10 + c) ↦ f32
        }
    }
    ids[0] ← 2
    ds.gather_row(dom, table, ids, mut out)
    assert close(out[[0]], 20.0)
    assert close(out[[1]], 21.0)
    assert close(out[[2]], 22.0)
    assert close(out[[3]], 23.0)
}

test "decode_step rmsnorm normalises one row with weight" {
    mut tensor<f32, [4]> x ← tf32[4] {}
    mut tensor<f32, [4]> w ← tf32[4] {}
    mut tensor<f32, [4]> out ← tf32[4] {}
    x[[0]] ← 1.0
    x[[1]] ← 2.0
    x[[2]] ← 3.0
    x[[3]] ← 4.0
    w[[0]] ← 1.0
    w[[1]] ← 1.0
    w[[2]] ← 2.0
    w[[3]] ← 2.0
    ds.rmsnorm(x, w, mut out, 0.0)
    # mean(x^2) = 7.5, 1 / sqrt(7.5) = 0.3651484
    assert close(out[[0]], 0.3651484)
    assert close(out[[1]], 0.7302967)
    assert close(out[[2]], 2.1908903)
    assert close(out[[3]], 2.9211872)
}

test "decode_step gemv computes tiled matrix-vector product" {
    mut tensor<f32, [2, 3]> w ← tf32[2, 3] {}
    mut tensor<f32, [3]> x ← tf32[3] {}
    mut tensor<f32, [2]> out ← tf32[2] {}
    for range 0‥2 let r {
        for range 0‥3 let c {
            w[[r, c]] ← (r * 3 + c + 1) ↦ f32
        }
    }
    x[[0]] ← 1.0
    x[[1]] ← 0.0
    x[[2]] ← -1.0
    ds.gemv(w, x, mut out)
    assert close(out[[0]], -2.0)
    assert close(out[[1]], -2.0)
}

test "decode_step qkv_proj fuses Q/K/V GEMVs over shared input" {
    mut tensor<f32, [2, 3]> wq ← tf32[2, 3] {}
    mut tensor<f32, [2, 3]> wk ← tf32[2, 3] {}
    mut tensor<f32, [2, 3]> wv ← tf32[2, 3] {}
    mut tensor<f32, [3]> x ← tf32[3] {}
    mut tensor<f32, [2]> q ← tf32[2] {}
    mut tensor<f32, [2]> k ← tf32[2] {}
    mut tensor<f32, [2]> v ← tf32[2] {}
    x[[0]] ← 1.0
    x[[1]] ← 2.0
    x[[2]] ← -1.0
    wq[[0, 0]] ← 2.0
    wq[[1, 1]] ← 3.0
    wk[[0, 2]] ← 4.0
    wk[[1, 0]] ← 1.0
    wv[[0, 1]] ← -2.0
    wv[[1, 2]] ← 5.0
    ds.qkv_proj(wq, wk, wv, x, mut q, mut k, mut v)
    assert close(q[[0]], 2.0)
    assert close(q[[1]], 6.0)
    assert close(k[[0]], -4.0)
    assert close(k[[1]], 1.0)
    assert close(v[[0]], -4.0)
    assert close(v[[1]], -5.0)
}

test "decode_step gate_up_proj fuses gate and up GEMVs over shared input" {
    mut tensor<f32, [2, 3]> wg ← tf32[2, 3] {}
    mut tensor<f32, [2, 3]> wu ← tf32[2, 3] {}
    mut tensor<f32, [3]> x ← tf32[3] {}
    mut tensor<f32, [2]> g ← tf32[2] {}
    mut tensor<f32, [2]> u ← tf32[2] {}
    x[[0]] ← 1.0
    x[[1]] ← 2.0
    x[[2]] ← 3.0
    wg[[0, 1]] ← 2.0
    wg[[1, 2]] ← -1.0
    wu[[0, 0]] ← 5.0
    wu[[1, 1]] ← 1.5
    ds.gate_up_proj(wg, wu, x, mut g, mut u)
    assert close(g[[0]], 4.0)
    assert close(g[[1]], -3.0)
    assert close(u[[0]], 5.0)
    assert close(u[[1]], 3.0)
}

test "decode_step rope_half rotates the (j, j + span) pairs of each head" {
    mut tensor<f32, [4]> x ← tf32[4] {}
    mut tensor<f32, [4]> out ← tf32[4] {}
    x[[0]] ← 1.0
    x[[1]] ← 2.0
    ds.rope_half(x, mut out, 1, 2, 0.0)
    # ln_theta 0 gives frequency 1: every pair rotates by angle 1.
    assert close(out[[0]], 0.5403023)
    assert close(out[[1]], 1.0806046)
    assert close(out[[2]], 0.841471)
    assert close(out[[3]], 1.682942)
    # Position 0 is the identity.
    ds.rope_half(x, mut out, 0, 2, 0.0)
    assert close(out[[0]], 1.0)
    assert close(out[[1]], 2.0)
    assert close(out[[2]], 0.0)
    assert close(out[[3]], 0.0)
}

test "decode_step rope_pairs rotates the (2p, 2p + 1) pairs of each head" {
    mut tensor<f32, [4]> x ← tf32[4] {}
    mut tensor<f32, [4]> out ← tf32[4] {}
    x[[0]] ← 1.0
    x[[1]] ← 2.0
    x[[2]] ← 3.0
    x[[3]] ← 4.0
    # One head of span 2; ln_theta = 2 ln 4 gives frequencies 1 and 1/4, so at
    # position 2 pair 0 = (x0, x1) rotates by 2 and pair 1 = (x2, x3) by 0.5.
    ds.rope_pairs(x, mut out, 2, 2, 2.7725887)
    assert close(out[[0]], -2.2347417)
    assert close(out[[1]], 0.0770038)
    assert close(out[[2]], 0.7150458)
    assert close(out[[3]], 4.9486069)
    # Position 0 is the identity.
    ds.rope_pairs(x, mut out, 0, 2, 2.7725887)
    assert close(out[[0]], 1.0)
    assert close(out[[1]], 2.0)
    assert close(out[[2]], 3.0)
    assert close(out[[3]], 4.0)
}

test "decode_step rope_pairs restarts the pair frequencies at every head" {
    mut tensor<f32, [8]> x ← tf32[8] {}
    mut tensor<f32, [8]> out ← tf32[8] {}
    for range 0‥8 let j {
        x[[j]] ← (j % 4 + 1) ↦ f32
    }
    ds.rope_pairs(x, mut out, 2, 2, 2.7725887)
    # Both heads hold [1, 2, 3, 4] and rotate identically.
    assert close(out[[0]], -2.2347417)
    assert close(out[[3]], 4.9486069)
    assert close(out[[4]], -2.2347417)
    assert close(out[[5]], 0.0770038)
    assert close(out[[6]], 0.7150458)
    assert close(out[[7]], 4.9486069)
}

test "decode_step kv_write appends in place and preserves other rows" {
    mut tensor<f32, [3, 2]> cache ← tf32[3, 2] {}
    mut tensor<f32, [2]> row ← tf32[2] {}
    for range 0‥3 let r {
        for range 0‥2 let c {
            cache[[r, c]] ← (r * 2 + c) ↦ f32
        }
    }
    row[[0]] ← 100.0
    row[[1]] ← 101.0
    ds.kv_write(mut cache, row, 1)
    assert cache[[0, 0]] ≡ (0.0 ↦ f32)
    assert cache[[0, 1]] ≡ (1.0 ↦ f32)
    assert cache[[1, 0]] ≡ (100.0 ↦ f32)
    assert cache[[1, 1]] ≡ (101.0 ↦ f32)
    assert cache[[2, 0]] ≡ (4.0 ↦ f32)
    assert cache[[2, 1]] ≡ (5.0 ↦ f32)

    row[[0]] ← 200.0
    row[[1]] ← 201.0
    ds.kv_write(mut cache, row, 2)
    assert cache[[0, 0]] ≡ (0.0 ↦ f32)
    assert cache[[0, 1]] ≡ (1.0 ↦ f32)
    assert cache[[1, 0]] ≡ (100.0 ↦ f32)
    assert cache[[1, 1]] ≡ (101.0 ↦ f32)
    assert cache[[2, 0]] ≡ (200.0 ↦ f32)
    assert cache[[2, 1]] ≡ (201.0 ↦ f32)

    row[[0]] ← 300.0
    row[[1]] ← 301.0
    ds.kv_write(mut cache, row, -1)
    ds.kv_write(mut cache, row, 3)
    assert cache[[0, 0]] ≡ (0.0 ↦ f32)
    assert cache[[0, 1]] ≡ (1.0 ↦ f32)
    assert cache[[1, 0]] ≡ (100.0 ↦ f32)
    assert cache[[1, 1]] ≡ (101.0 ↦ f32)
    assert cache[[2, 0]] ≡ (200.0 ↦ f32)
    assert cache[[2, 1]] ≡ (201.0 ↦ f32)
}

test "decode_step kv_write_kv writes K and V rows together in one launch" {
    mut tensor<f32, [3, 2]> kc ← tf32[3, 2] {}
    mut tensor<f32, [3, 2]> vc ← tf32[3, 2] {}
    mut tensor<f32, [2]> k ← tf32[2] {}
    mut tensor<f32, [2]> v ← tf32[2] {}
    k[[0]] ← 11.0
    k[[1]] ← 12.0
    v[[0]] ← 21.0
    v[[1]] ← 22.0
    ds.kv_write_kv(k, v, mut kc, mut vc, 1)
    assert kc[[1, 0]] ≡ (11.0 ↦ f32)
    assert kc[[1, 1]] ≡ (12.0 ↦ f32)
    assert vc[[1, 0]] ≡ (21.0 ↦ f32)
    assert vc[[1, 1]] ≡ (22.0 ↦ f32)
    assert kc[[0, 0]] ≡ (0.0 ↦ f32)
    assert vc[[2, 1]] ≡ (0.0 ↦ f32)
}

test "decode_step kv_write_block changes only written rows and clips at capacity" {
    mut tensor<f32, [9, 2]> cache ← tf32[9, 2] {}
    mut tensor<f32, [1, 2]> one ← tf32[1, 2] {}
    mut tensor<f32, [7, 2]> seven ← tf32[7, 2] {}
    mut tensor<f32, [9, 2]> all ← tf32[9, 2] {}
    mut tensor<f32, [4, 2]> tail ← tf32[4, 2] {}
    for range 0‥9 let r {
        for range 0‥2 let c {
            cache[[r, c]] ← (r * 10 + c) ↦ f32
        }
    }
    one[[0, 0]] ← 100.0
    one[[0, 1]] ← 101.0
    ds.kv_write_block(mut cache, one, 3)
    for range 0‥9 let r {
        for range 0‥2 let c {
            if r ≡ 3 {
                assert cache[[r, c]] ≡ (100 + c) ↦ f32
            }
            else {
                assert cache[[r, c]] ≡ (r * 10 + c) ↦ f32
            }
        }
    }

    for range 0‥7 let r {
        for range 0‥2 let c {
            seven[[r, c]] ← (200 + r * 10 + c) ↦ f32
        }
    }
    ds.kv_write_block(mut cache, seven, 1)
    for range 0‥9 let r {
        for range 0‥2 let c {
            if r ≻ 0 and r ≺ 8 {
                assert cache[[r, c]] ≡ (200 + (r - 1) * 10 + c) ↦ f32
            }
            elif r ≡ 0 {
                assert cache[[r, c]] ≡ (c ↦ f32)
            }
            else {
                assert cache[[r, c]] ≡ (80 + c) ↦ f32
            }
        }
    }

    for range 0‥9 let r {
        for range 0‥2 let c {
            all[[r, c]] ← (300 + r * 10 + c) ↦ f32
        }
    }
    ds.kv_write_block(mut cache, all, 0)
    for range 0‥9 let r {
        for range 0‥2 let c {
            assert cache[[r, c]] ≡ (300 + r * 10 + c) ↦ f32
        }
    }

    for range 0‥4 let r {
        for range 0‥2 let c {
            tail[[r, c]] ← (400 + r * 10 + c) ↦ f32
        }
    }
    ds.kv_write_block(mut cache, tail, 7)
    for range 0‥9 let r {
        for range 0‥2 let c {
            if r ≻ 6 {
                assert cache[[r, c]] ≡ (400 + (r - 7) * 10 + c) ↦ f32
            }
            else {
                assert cache[[r, c]] ≡ (300 + r * 10 + c) ↦ f32
            }
        }
    }
}

test "decode_step row_softmax normalises rows" {
    mut tensor<f32, [1, 3]> s ← tf32[1, 3] {}
    mut tensor<f32, [1, 3]> p ← tf32[1, 3] {}
    s[[0, 0]] ← 1.0
    s[[0, 1]] ← 2.0
    s[[0, 2]] ← 3.0
    ds.row_softmax(s, mut p)
    assert close(p[[0, 0]], 0.0900306)
    assert close(p[[0, 1]], 0.2447285)
    assert close(p[[0, 2]], 0.6652410)
}

test "decode_step GQA decode attention masks past pos and shares a KV head" {
    # 2 query heads of dh 2 share one KV head (group 2); 3 cache rows, pos 1.
    mut tensor<f32, [2, 3]> hc ← tf32[2, 3] {}
    mut tensor<f32, [4]> qdom ← tf32[4] {}
    mut tensor<f32, [4]> q ← tf32[4] {}
    mut tensor<f32, [3, 2]> kc ← tf32[3, 2] {}
    mut tensor<f32, [3, 2]> vc ← tf32[3, 2] {}
    mut tensor<f32, [2, 3]> sc ← tf32[2, 3] {}
    mut tensor<f32, [2, 3]> p ← tf32[2, 3] {}
    mut tensor<f32, [4]> ctx ← tf32[4] {}
    mut tensor<f32, [2, 4]> cpdom ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> cp ← tf32[2, 4] {}
    mut tensor<f32, [4]> ctx_split ← tf32[4] {}
    q[[0]] ← 1.0
    q[[3]] ← 1.0
    kc[[0, 0]] ← 1.0
    kc[[1, 1]] ← 1.0
    kc[[2, 0]] ← 5.0
    kc[[2, 1]] ← 5.0
    vc[[0, 0]] ← 1.0
    vc[[1, 1]] ← 1.0
    vc[[2, 0]] ← 9.0
    vc[[2, 1]] ← 9.0
    ds.attn_scores(hc, q, kc, mut sc, 1, 2, 2, 1.0)
    assert close(sc[[0, 0]], 1.0)
    assert close(sc[[0, 1]], 0.0)
    assert close(sc[[1, 0]], 0.0)
    assert close(sc[[1, 1]], 1.0)
    assert sc[[0, 2]] ≺ -1.0e29
    ds.row_softmax(sc, mut p)
    # e / (1 + e) = 0.7310586 on the larger score, 0 on the masked column.
    assert close(p[[0, 0]], 0.7310586)
    assert close(p[[0, 1]], 0.2689414)
    assert close(p[[0, 2]], 0.0)
    ds.attn_context(qdom, p, vc, mut ctx, 1, 2, 2)
    assert close(ctx[[0]], 0.7310586)
    assert close(ctx[[1]], 0.2689414)
    assert close(ctx[[2]], 0.2689414)
    assert close(ctx[[3]], 0.7310586)
    ds.context_part(cpdom, p, vc, mut cp, 1, 2, 2)
    ds.context_fin(qdom, cp, mut ctx_split)
    assert close(ctx_split[[0]], ctx[[0]])
    assert close(ctx_split[[1]], ctx[[1]])
    assert close(ctx_split[[2]], ctx[[2]])
    assert close(ctx_split[[3]], ctx[[3]])
}

test "decode_step residual_add and swiglu are elementwise" {
    mut tensor<f32, [2]> a ← tf32[2] {}
    mut tensor<f32, [2]> b ← tf32[2] {}
    mut tensor<f32, [2]> sum ← tf32[2] {}
    mut tensor<f32, [2]> act ← tf32[2] {}
    a[[0]] ← 0.0
    a[[1]] ← 1.0
    b[[0]] ← 2.0
    b[[1]] ← 3.0
    ds.residual_add(a, b, mut sum)
    ds.swiglu(a, b, mut act)
    assert close(sum[[0]], 2.0)
    assert close(sum[[1]], 4.0)
    # silu(0) = 0; silu(1) = 0.7310586, times 3.
    assert close(act[[0]], 0.0)
    assert close(act[[1]], 2.1931758)
}

test "decode_step argmax_token writes the global best index" {
    mut tensor<f32, [12]> x ← tf32[12] {}
    mut tensor<i32, [1]> idx ← tensor<i32, [1]> {}
    x[[0]] ← 1.0
    x[[1]] ← 5.0
    x[[2]] ← 5.0
    x[[3]] ← -3.0
    x[[4]] ← -1.0
    x[[5]] ← -2.0
    x[[6]] ← 0.0
    x[[7]] ← 0.0
    x[[8]] ← 0.0
    x[[9]] ← -9.0
    x[[10]] ← -8.0
    x[[11]] ← 7.0
    ds.argmax_token(x, mut idx)
    assert idx[0] ≡ 11
}

test "decode_step argmax_token ties keep the lowest global index" {
    mut tensor<f32, [12]> x ← tf32[12] {}
    mut tensor<i32, [1]> idx ← tensor<i32, [1]> {}
    for range 0‥12 let i {
        x[[i]] ← -4.0
    }
    x[[2]] ← 2.5
    x[[3]] ← 2.5
    x[[8]] ← 2.5
    ds.argmax_token(x, mut idx)
    assert idx[0] ≡ 2
}

test "decode_step argmax_token all-equal picks zero and later maximum wins" {
    mut tensor<f32, [12]> x ← tf32[12] {}
    mut tensor<i32, [1]> idx ← tensor<i32, [1]> {}
    for range 0‥12 let i {
        x[[i]] ← 0.25
    }
    ds.argmax_token(x, mut idx)
    assert idx[0] ≡ 0
    x[[6]] ← 0.5
    ds.argmax_token(x, mut idx)
    assert idx[0] ≡ 6
}

test "decode_step topm_chunks writes each chunk's top-M pairs in descending value, ties to the lowest index" {
    mut tensor<f32, [2, 3]> dom ← tf32[2, 3] {}
    mut tensor<f32, [8]> x ← tf32[8] {}
    mut tensor<f32, [2, 3]> val ← tf32[2, 3] {}
    mut tensor<f32, [2, 3]> idx ← tf32[2, 3] {}
    # chunks of 4: [0 1 2 3] [4 5 6 7]
    x[[0]] ← 1.0
    x[[1]] ← 5.0
    x[[2]] ← 5.0
    x[[3]] ← 3.0
    x[[4]] ← -1.0
    x[[5]] ← 9.0
    x[[6]] ← -1.0
    x[[7]] ← 2.0
    ds.topm_chunks(dom, x, mut val, mut idx, 4)
    assert close(val[[0, 0]], 5.0)
    assert close(idx[[0, 0]], 1.0)
    assert close(val[[0, 1]], 5.0)
    assert close(idx[[0, 1]], 2.0)
    assert close(val[[0, 2]], 3.0)
    assert close(idx[[0, 2]], 3.0)
    assert close(val[[1, 0]], 9.0)
    assert close(idx[[1, 0]], 5.0)
    assert close(val[[1, 1]], 2.0)
    assert close(idx[[1, 1]], 7.0)
    assert close(val[[1, 2]], -1.0)
    assert close(idx[[1, 2]], 4.0)
}

test "decode_step topm_chunks: a tie across a chunk boundary keeps the lowest index per chunk" {
    mut tensor<f32, [2, 2]> dom ← tf32[2, 2] {}
    mut tensor<f32, [8]> x ← tf32[8] {}
    mut tensor<f32, [2, 2]> val ← tf32[2, 2] {}
    mut tensor<f32, [2, 2]> idx ← tf32[2, 2] {}
    for range 0‥8 let i {
        x[[i]] ← -4.0
    }
    x[[3]] ← 2.5
    x[[4]] ← 2.5
    x[[6]] ← 2.5
    ds.topm_chunks(dom, x, mut val, mut idx, 4)
    assert close(idx[[0, 0]], 3.0)
    assert close(val[[0, 1]], -4.0)
    assert close(idx[[0, 1]], 0.0)
    assert close(idx[[1, 0]], 4.0)
    assert close(idx[[1, 1]], 6.0)
}

test "decode_step topm_chunks: a chunk shorter than M fills the trailing slots with the sentinel index -1" {
    mut tensor<f32, [2, 3]> dom ← tf32[2, 3] {}
    mut tensor<f32, [4]> x ← tf32[4] {}
    mut tensor<f32, [2, 3]> val ← tf32[2, 3] {}
    mut tensor<f32, [2, 3]> idx ← tf32[2, 3] {}
    x[[0]] ← 1.0
    x[[1]] ← 4.0
    x[[2]] ← 2.0
    x[[3]] ← 2.0
    ds.topm_chunks(dom, x, mut val, mut idx, 2)
    assert close(idx[[0, 0]], 1.0)
    assert close(idx[[0, 1]], 0.0)
    assert close(idx[[0, 2]], -1.0)
    assert close(idx[[1, 0]], 2.0)
    assert close(idx[[1, 1]], 3.0)
    assert close(idx[[1, 2]], -1.0)
}
