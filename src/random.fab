+++
locale = "en"
+++
# Deterministic random-number generation for Gradus.
#
# Public import: import from "gradus:random" random
# This leaf owns the seed state, xorshift64 draws, and its versioned wire.
# It has no Gradus dependencies, so data, decoding, sampling, and generation
# can share one explicit RNG without depending on training controls.

# RandomError — failures owned by seed construction and wire decoding.
@ public
union RandomError {
    @ shared
    string message

    InvalidSeed,
    BadWire,
    UnknownVersion
}

const string schema_version = "1.0.0"

# Seed the xorshift64 generator. Zero is rejected because it is a fixed point.
@ public
class Seed {
    mut int status
}

@ public
fn construct_seed(int seed) → Seed ⇥ RandomError {
    require seed ≢ 0 throw variant InvalidSeed { message = "seed must be non-zero" }
    return Seed { status = seed }
}

# Placeholder Default for `var Seed` bindings. It is not a valid seed and
# must be overwritten before drawing.
@ public
fn default() → Seed {
    return Seed { status = 0 }
}

@ public
class Draw {
    mut int payload
    mut Seed seed
}

# xorshift64 step: x ^= x<<13; x ^= x>>7; x ^= x<<17. The wrapping ring
# preserves the 64-bit state without multiplication or overflow concerns.
@ public
fn next(Seed s) → Draw {
    mut wrapping<i64> x ← s.status ↦ wrapping<i64>
    x ← x ⊻ x ⇐ 13
    x ← x ⊻ x ⇒ 7
    x ← x ⊻ x ⇐ 17
    let int state ← x ↦ int
    return Draw { payload = state, seed = Seed { status = state } }
}

# Sign-bit mask: the [0,1) draw uses only the low 63 bits.
const int MASK_63 = 9223372036854775807
const f32 POW2_52 = 4503599627370496.0 ∷ f32

@ public
class DrawF32 {
    mut f32 payload
    mut Seed seed
}

# Map the top 52 bits of the sign-masked state into [0, 1).
@ public
fn next_f32(Seed s) → DrawF32 {
    let Draw f ← next(s)
    let f32 v ← (((f.payload ∧ MASK_63) ⇒ 11) ↦ f32) / POW2_52
    return DrawF32 { payload = v, seed = f.seed }
}

# The RNG wire remains byte-for-byte compatible with the former train surface.
@ public
fn serialize_seed(Seed s) → string {
    return "train/rng/§/§"(schema_version, s.status ↦ string)
}

@ public
fn deserialize_seed(string wire) → Seed ⇥ RandomError {
    let list<string> parts ← wire.split("/")
    require parts.length() ≡ 4 throw variant BadWire { message = "malformed rng wire" }
    require parts.get(0) coalesce "" ≡ "train" throw variant BadWire { message = "unknown rng marker" }
    require parts.get(1) coalesce "" ≡ "rng" throw variant BadWire { message = "unknown rng marker" }
    require parts.get(2) coalesce "" ≡ schema_version throw variant UnknownVersion { message = "unknown rng schema version" }
    let string status_text ← parts.get(3) coalesce ""
    require status_text.length() ≢ 0 throw variant BadWire { message = "malformed rng state" }
    mut int status ← 0
    do {
        status ↤ status_text
    }
    catch err {
        throw variant BadWire { message = "malformed rng state" }
    }
    return construct_seed(status)
}
