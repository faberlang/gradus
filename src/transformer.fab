+++
locale = "en"
+++
# Transformer architecture facade.
#
# Public import: import from "gradus:transformer" transformer
# Depends on: gradus:tensor, gradus:math, gradus:nn, gradus:attention,
#             gradus:cache
#
# S6-G1 (gpu-training-lowering stage-6-delivery.md): first concrete
# static-shape transformer block for the BERT-tiny fragment shapes
# (B=2, D=8, H=1). The fragment's block:
#   pre-LN → attention → output projection → residual →
#   post-LN → FFN (linear → GELU → linear) → residual → pre-loss LN
# Biases are per-channel [8] via the S6-C2 added_bias contract (the
# fragment's [2,8] workaround is removed — U8 owns the consumer migration).
#
# Will split into nested leaves when ≥2 transformer components are
# implemented:
#   gradus:transformer/block      block = attn + ffn + residual + norm
#   gradus:transformer/position   positional encoding (learned, sinusoidal, RoPE)
#   gradus:transformer/head       output projection (logits)
#
# Architectural rule: a transformer composes primitives and attention blocks.
# It does not own its training loop. This module must not import from
# gradus:train. No module owns a backend or device handle.
#
# LEGACY FIXED-SHAPE NOTE: the function below (bert_tiny_block_2x8) remains
# self-contained (typed-tensor ops only, no calls to other Gradus functions).
# Its attention + FFN math is intentionally inlined from the S4-A
# train_step_4x4 precedent; this legacy shape is not a current FMIR limitation.
# Library-to-library calls execute on FMIR since radix 43c0102ba
# (regression-locked by 2e8042ae7). The PML3-U3 production surface (bottom of
# this module) instead composes the gradus:nn / gradus:attention / gradus:math
# families over the staged carrier — the same posture as the nn.fab and
# attention.fab production surfaces (see nn.fab "Compiler-boundary notes").
#
# PML0-U3 ledger disposition (pml0-proof-api-ledger.md, gradus 33df687) —
# executed at PML1-U6: RETIRE attention_block_2x8 (row 13) and ffn_block_2x8
# (row 14). Neither had a live caller anywhere in the container; their math
# is fully inlined in bert_tiny_block_2x8 (row 15, ADMITTED — caller-backed:
# examples/training/bert-gradus-probe/src/train.fab:351). The standalone
# sub-block definitions are removed; the inlined copies below are the
# surviving surface.

import from "gradus:attention" attention

import from "gradus:cache" kv

import from "gradus:math" math

import from "gradus:nn" nn

import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# bert_tiny_block_2x8 — the fragment's full transformer block (B=2, D=8):
#   pre-LN → attention → output proj → residual → post-LN → FFN → residual →
#   pre-loss LN. Returns ln3 [2,8].
#   18 trainable params + frozen dk_scale in; the pre-loss LN output out.
#   Inlines the attention + FFN sub-block math (legacy admitted shape; library-
#   to-library calls execute on FMIR, above).
# -------------------------------------------------------------------------

@ public
fn bert_tiny_block_2x8(tensor<f32, [2, 8]> x, tensor<f32, [8]> ln1_s, tensor<f32, [8]> ln1_o, tensor<f32, [8, 8]> wq, tensor<f32, [8]> bq, tensor<f32, [8, 8]> wk, tensor<f32, [8]> bk, tensor<f32, [8, 8]> wv, tensor<f32, [8]> bv, tensor<f32, [8, 8]> wo, tensor<f32, [8]> bo, tensor<f32, [8]> ln2_s, tensor<f32, [8]> ln2_o, tensor<f32, [8, 8]> wf1, tensor<f32, [8]> bf1, tensor<f32, [8, 8]> wf2, tensor<f32, [8]> bf2, tensor<f32, [8]> ln3_s, tensor<f32, [8]> ln3_o, tensor<f32, [2, 2]> scale) → tensor<f32, [2, 8]> {
    # Pre-LN
    const _ ln1 ← x.layer_norm(1, 0.00001, ln1_s, ln1_o)

    # Q/K/V projections (per-channel [8] biases, S6-C2 added_bias)
    const _ q ← ln1 · wq
    const _ qb ← q.added_bias(bq)
    const _ k ← ln1 · wk
    const _ kb ← k.added_bias(bk)
    const _ v ← ln1 · wv
    const _ vb ← v.added_bias(bv)

    # Scaled dot-product attention
    const _ kt ← kb.transpose()
    const _ scores ← qb · kt
    const _ scaled ← scores ⊙ scale
    const _ attn ← scaled.softmax()
    const _ context ← attn · vb

    # Output projection + residual 1
    const _ ao ← context · wo
    const _ aob ← ao.added_bias(bo)
    const _ r1 ← x + aob

    # Post-LN
    const _ ln2 ← r1.layer_norm(1, 0.00001, ln2_s, ln2_o)

    # FFN (linear → GELU → linear)
    const _ h1 ← ln2 · wf1
    const _ h1b ← h1.added_bias(bf1)
    const _ a1 ← h1b.gelu()
    const _ h2 ← a1 · wf2
    const _ h2b ← h2.added_bias(bf2)

    # Residual 2
    const _ r2 ← ln2 + h2b

    # Pre-loss LN
    const _ ln3 ← r2.layer_norm(1, 0.00001, ln3_s, ln3_o)
    return ln3
}

# =========================================================================
# PML3-U3 — production surface (shape-generic transformer block, forward-only,
# typed errors)
# =========================================================================
#
# --- Contract (pml3-delivery.md PML3-U3) ---------------------------------
# A transformer block (attention + FFN + residual + norms) composes over the
# primitive surface, is forward-only, and matches the CPU oracle for the
# training row and the selected inference row; the block is usable by both
# PML4 training and PML5 inference. The F32 row is the admitted row.
#
# --- Block structure (matching the accepted fragment arithmetic) ----------
#   ln1 = layernorm(x, ln1_s, ln1_o)                    # pre-LN
#   qb  = linear(ln1, wq, bq); kb = linear(ln1, wk, bk); vb = linear(ln1, wv, bv)
#   ctx = attention(qb, kb, vb, scale [, positions, dim])   # mode-selected
#   ao  = linear(ctx, wo, bo)
#   r1  = x + ao                                        # residual 1
#   ln2 = layernorm(r1, ln2_s, ln2_o)                   # post-LN
#   h1  = linear(ln2, wf1, bf1); a1 = gelu(h1); h2 = linear(a1, wf2, bf2)
#   r2  = r1 + h2                                       # residual 2 (residual stream + FFN)
#   return ln3 = layernorm(r2, ln3_s, ln3_o)             # pre-loss LN -> block output
# Residual-2 matches dense_block / llama GI2-1 (add to the residual stream,
# not the post-LN). bert_tiny_block_2x8 keeps the fragment's accepted
# ln2 + h2b arithmetic. The attention sub-block is mode-selected so the
# same block serves the selected inference row (causal + RoPE, mode 2)
# and the causal row (mode 1).
#
# Attention modes (mode): 0 = scaled_dot_product (plain — the training-row
# proof), 1 = scaled_dot_product_causal, 2 = scaled_dot_product_causal_rope
# (the inference row; positions + dim are the RoPE arguments).
#
# --- Autograd independence (PML3 thesis, forward-without-autograd) --------
# This module imports NO autograd surface (no gradus:gradient, no @ radix
# backward, no companion ABI). The block is a pure value function over the
# staged carrier; the co-located proba exercises it with no autograd import.
#
# --- Compiler-boundary notes ---------------------------------------------
#   * Shape generics are not available in library context (SEM014 — the
#     nn.fab posture); the staged carrier carries runtime shapes, so the
#     block is shape-generic at runtime and R3-compliant (no one-row/one-
#     shape narrowing in the public API).
#   * The CPU reference evaluates the block in f64 (FMIR stepper — the
#     pinned bert-tiny-fragment intermediates.json); this surface is f32
#     self-hosted. Row tests compare with the documented 5e-4 tolerance
#     (approx), not bit equality (the nn.fab / attention.fab posture).
#   * Sub-call errors (NnError / AttentionError / MathError) are mapped into
#     TransformerError by their documented message text, preserving the text
#     (the nn.fab linear mapping pattern — cross-module enum variants are
#     not referenceable, SEM001/SEM041).

# -------------------------------------------------------------------------
# TransformerError — typed error vocabulary of the transformer block surface.
# Every variant carries a text message (render via message), mirroring the
# nn/attention/math error contract.
# -------------------------------------------------------------------------

@ public
union TransformerError {
    @ shared
    string message

    @ conversion nn.NnError err {
        match err {
            case nn.NnError.NegativeDimension const message { return variant NegativeDimension {message = message} }
            case nn.NnError.DimensionAboveLimit const message { return variant DimensionAboveLimit {message = message} }
            case nn.NnError.ProductAboveLimit const message { return variant ProductAboveLimit {message = message} }
            case nn.NnError.GradusMismatch const message { return variant GradusMismatch {message = message} }
            case nn.NnError.ShapeMismatch const message { return variant ShapeMismatch {message = message} }
            case nn.NnError.Incompatible const message { return variant Incompatible {message = message} }
            case nn.NnError.DtypeMismatch const message { return variant DtypeMismatch {message = message} }
            case nn.NnError.ElementMismatch const message { return variant ElementMismatch {message = message} }
            case nn.NnError.InvalidEpsilon const message { return variant InvalidEpsilon {message = message} }
        }
    }
    @ conversion math.MathError err {
        match err {
            case math.MathError.NegativeDimension const message { return variant NegativeDimension {message = message} }
            case math.MathError.DimensionAboveLimit const message { return variant DimensionAboveLimit {message = message} }
            case math.MathError.ProductAboveLimit const message { return variant ProductAboveLimit {message = message} }
            case math.MathError.GradusMismatch const message { return variant GradusMismatch {message = message} }
            case math.MathError.ShapeMismatch const message { return variant ShapeMismatch {message = message} }
            case math.MathError.Incompatible const message { return variant Incompatible {message = message} }
            case math.MathError.DtypeMismatch const message { return variant DtypeMismatch {message = message} }
            case math.MathError.ElementMismatch const message { return variant ElementMismatch {message = message} }
            case _ { return variant ShapeMismatch {message = err.message} }
        }
    }
    @ conversion attention.AttentionError err {
        match err {
            case attention.AttentionError.NegativeDimension const message { return variant NegativeDimension {message = message} }
            case attention.AttentionError.DimensionAboveLimit const message { return variant DimensionAboveLimit {message = message} }
            case attention.AttentionError.ProductAboveLimit const message { return variant ProductAboveLimit {message = message} }
            case attention.AttentionError.GradusMismatch const message { return variant GradusMismatch {message = message} }
            case attention.AttentionError.ShapeMismatch const message { return variant ShapeMismatch {message = message} }
            case attention.AttentionError.Incompatible const message { return variant Incompatible {message = message} }
            case attention.AttentionError.DtypeMismatch const message { return variant DtypeMismatch {message = message} }
            case attention.AttentionError.ElementMismatch const message { return variant ElementMismatch {message = message} }
            case attention.AttentionError.InvalidPosition const message { return variant InvalidPosition {message = message} }
            case attention.AttentionError.InvalidDimension const message { return variant InvalidDimension {message = message} }
            case _ { return variant ShapeMismatch {message = err.message} }
        }
    }

    NegativeDimension,
    DimensionAboveLimit,
    ProductAboveLimit,
    GradusMismatch,
    ShapeMismatch,
    Incompatible,
    DtypeMismatch,
    ElementMismatch,
    InvalidEpsilon,
    InvalidPosition,
    InvalidDimension,
    InvalidMode
}



# LayerNorm epsilon — the accepted rows' laminatio(1, 1e-5, …) contract
# (the fragment's pre-LN / post-LN / pre-loss LN all use 1e-5).
const f32 LAYERNORM_EPSILON ← 0.00001 ∷ f32

# -------------------------------------------------------------------------
# Private helpers — each wraps a primitive sub-call and maps its typed error
# into TransformerError preserving the documented message text (the nn.fab
# linear mapping pattern).
# -------------------------------------------------------------------------

# linear wrapper — nn.linear_carrier → TransformerError.
fn _linear(tensor.NumericBlock x, tensor.NumericBlock w, tensor.NumericBlock b) → tensor.NumericBlock ⇥ TransformerError {
    return nn.linear_carrier(x, w, b)
}

# gelu wrapper — nn.gelu → TransformerError.
fn _gelu(tensor.NumericBlock x) → tensor.NumericBlock ⇥ TransformerError {
    return nn.gelu(x)
}

# layernorm wrapper — nn.layernorm → TransformerError (fixed 1e-5 epsilon).
fn _layernorm(tensor.NumericBlock x, tensor.NumericBlock s, tensor.NumericBlock o) → tensor.NumericBlock ⇥ TransformerError {
    return nn.layernorm(x, s, o, LAYERNORM_EPSILON)
}

# add wrapper — math.add_carrier → TransformerError.
fn _add(tensor.NumericBlock a, tensor.NumericBlock b) → tensor.NumericBlock ⇥ TransformerError {
    return math.add_carrier(a, b)
}

# attention wrapper — mode-selected attention → TransformerError.
fn _attention(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, f32 scale, int mode, list<int> positions, int dim) → tensor.NumericBlock ⇥ TransformerError {
    if mode ≡ 2 {
        return attention.scaled_dot_product_causal_rope(q, k, v, scale, positions, dim)
    }
    elif mode ≡ 1 {
        return attention.scaled_dot_product_causal(q, k, v, scale)
    }
    return attention.scaled_dot_product(q, k, v, scale)
}

# -------------------------------------------------------------------------
# transformer_block — the shape-generic transformer block. Composes the
# primitive surface (nn + attention) over the staged carrier, forward-only.
#
#   x      [T,D] input
#   ln1_s/o [D]  pre-LN affine
#   wq/bq/wk/bk/wv/bv/wo/bo  attention projections ([D,D]/[D] per-channel)
#   ln2_s/o [D]  post-LN affine
#   wf1/bf1/wf2/bf2          FFN ([D,F]/[F]/[F,D]/[D] per-channel)
#   ln3_s/o [D]  pre-loss LN affine
#   scale    dk scaling factor (1/sqrt(dk))
#   mode    attention mode: 0 plain (training row), 1 causal, 2 causal+rope
#   positions RoPE positions (mode 2)
#   dim      RoPE rotation width over the last axis (mode 2)
#
# Returns ln3 — the pre-loss LN output (the block's surviving contract from
# bert_tiny_block_2x8). Shape-generic at runtime (R3).
# -------------------------------------------------------------------------

@ public
fn transformer_block(tensor.NumericBlock x, tensor.NumericBlock ln1_s, tensor.NumericBlock ln1_o, tensor.NumericBlock wq, tensor.NumericBlock bq, tensor.NumericBlock wk, tensor.NumericBlock bk, tensor.NumericBlock wv, tensor.NumericBlock bv, tensor.NumericBlock wo, tensor.NumericBlock bo, tensor.NumericBlock ln2_s, tensor.NumericBlock ln2_o, tensor.NumericBlock wf1, tensor.NumericBlock bf1, tensor.NumericBlock wf2, tensor.NumericBlock bf2, tensor.NumericBlock ln3_s, tensor.NumericBlock ln3_o, f32 scale, int mode, list<int> positions, int dim) → tensor.NumericBlock ⇥ TransformerError {
    require not (mode ≺ 0 or mode ≻ 2) throw variant InvalidMode {message = "unknown attention mode"}
    const tensor.NumericBlock ln1 ← _layernorm(x, ln1_s, ln1_o)
    const tensor.NumericBlock qb ← _linear(ln1, wq, bq)
    const tensor.NumericBlock kb ← _linear(ln1, wk, bk)
    const tensor.NumericBlock vb ← _linear(ln1, wv, bv)
    const tensor.NumericBlock ctx ← _attention(qb, kb, vb, scale, mode, positions, dim)
    const tensor.NumericBlock ao ← _linear(ctx, wo, bo)
    const tensor.NumericBlock r1 ← _add(x, ao)
    const tensor.NumericBlock ln2 ← _layernorm(r1, ln2_s, ln2_o)
    const tensor.NumericBlock h1 ← _linear(ln2, wf1, bf1)
    const tensor.NumericBlock a1 ← _gelu(h1)
    const tensor.NumericBlock h2 ← _linear(a1, wf2, bf2)
    const tensor.NumericBlock r2 ← _add(r1, h2)
    return _layernorm(r2, ln3_s, ln3_o)
}

# =========================================================================
# REF-01-U1.5 — the generic dense transformer block (dense_block).
# =========================================================================
#
# --- Contract (pml5-ref01-dense-reference-delivery.md REF-01-U1.5) --------
# The ordered dense transformer block in gradus:transformer:
#   ln1  = rmsnorm(x, ln1_s, ε)                 # input RMSNorm (U1.1)
#   qb   = linear(ln1, wq, bq)                  # [T, H*D]
#   kb   = linear(ln1, wk, bk)                  # [T, K*D]
#   vb   = linear(ln1, wv, bv)                  # [T, K*D]
#   ctx  = multi_head_attention(qb, kb, vb, wo, n_h, n_kv, scale,
#                               positions, rope_dim, cfg)   # GQA (U1.4)
#   r1   = x + ctx                              # residual 1
#   ln2  = rmsnorm(r1, ln2_s, ε)                # post-attn RMSNorm (U1.1)
#   h    = swiglu(linear(ln2, wg, bg), linear(ln2, wu, bu), wd, bd)  # U1.2
#   r2   = r1 + h                               # residual 2 -> block output
# Composes the U1.1 (rmsnorm), U1.2 (swiglu), and U1.4
# (multi_head_attention) rows over the staged f32 carrier; causal + RoPE
# attention (the inference composition). No fixed-shape constants: every
# shape derives from the runtime tensors and the head counts. The F32 row
# is the admitted row (the composed rows' contract). The output is the
# final residual r2 [T, D]; a final norm / output projection is model
# assembly (REF-01-U1.8), not the block.
#
# --- Autograd independence (PML3 thesis, forward-without-autograd) --------
# Same posture as transformer_block: no autograd import, no gradient path.
#
# --- Compiler-boundary notes ---------------------------------------------
# Same posture as transformer_block: the staged carrier makes the block
# shape-generic at runtime (R3); sub-call errors are mapped into
# TransformerError by typed variant (the map_* helpers above).

# rmsnorm wrapper — nn.rmsnorm → TransformerError.
fn _rmsnorm(tensor.NumericBlock x, tensor.NumericBlock s, f32 epsilon) → tensor.NumericBlock ⇥ TransformerError {
    return nn.rmsnorm_carrier(x, s, epsilon)
}

# swiglu wrapper — nn.swiglu → TransformerError.
fn _swiglu(tensor.NumericBlock gate, tensor.NumericBlock up, tensor.NumericBlock down_w, tensor.NumericBlock down_b) → tensor.NumericBlock ⇥ TransformerError {
    return nn.swiglu(gate, up, down_w, down_b)
}

# multi-head attention wrapper — attention.multi_head_attention →
# TransformerError.
fn _multi_attention(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, tensor.NumericBlock wo, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, attention.RopeConfig cfg) → tensor.NumericBlock ⇥ TransformerError {
    return attention.multi_head_attention(q, k, v, wo, num_heads, num_kv_heads, scale, positions, rope_dim, cfg)
}

# -------------------------------------------------------------------------
# Dense block grouped records. The records keep each natural parameter seam
# named while runtime data remains positional at the block boundary.
# -------------------------------------------------------------------------

@ public
class DenseAttentionWeights {
    tensor.NumericBlock wq
    tensor.NumericBlock bq
    tensor.NumericBlock wk
    tensor.NumericBlock bk
    tensor.NumericBlock wv
    tensor.NumericBlock bv
    tensor.NumericBlock wo
}

@ public
class DenseAttentionConfig {
    int num_heads
    int num_kv_heads
    f32 scale
    int rope_dim
    attention.RopeConfig rope_config
}

@ public
class DenseMlpWeights {
    tensor.NumericBlock wg
    tensor.NumericBlock bg
    tensor.NumericBlock wu
    tensor.NumericBlock bu
    tensor.NumericBlock wd
    tensor.NumericBlock bd
}

@ public
class DenseNormConfig {
    tensor.NumericBlock ln1_s
    tensor.NumericBlock ln2_s
    f32 epsilon
}

# -------------------------------------------------------------------------
# dense_block — the generic dense transformer block over the staged carrier.
#
#   x, positions                         runtime data (positional)
#   attention_weights                    q/k/v and output projections
#   attention_config                     GQA + the shared RopeConfig
#   mlp_weights                          SwiGLU gate/up/down projections
#   norm_config                          RMSNorm scales and epsilon
#
# Returns r2 — the block output [T, D]. Shape-generic at runtime (R3).
# -------------------------------------------------------------------------

@ public
fn dense_block(tensor.NumericBlock x, list<int> positions, DenseAttentionWeights attention_weights, DenseAttentionConfig attention_config, DenseMlpWeights mlp_weights, DenseNormConfig norm_config) → tensor.NumericBlock ⇥ TransformerError {
    const tensor.NumericBlock ln1 ← _rmsnorm(x, norm_config.ln1_s, norm_config.epsilon)
    const tensor.NumericBlock qb ← _linear(ln1, attention_weights.wq, attention_weights.bq)
    const tensor.NumericBlock kb ← _linear(ln1, attention_weights.wk, attention_weights.bk)
    const tensor.NumericBlock vb ← _linear(ln1, attention_weights.wv, attention_weights.bv)
    const tensor.NumericBlock ctx ← _multi_attention(qb, kb, vb, attention_weights.wo, attention_config.num_heads, attention_config.num_kv_heads, attention_config.scale, positions, attention_config.rope_dim, attention_config.rope_config)
    const tensor.NumericBlock r1 ← _add(x, ctx)
    const tensor.NumericBlock ln2 ← _rmsnorm(r1, norm_config.ln2_s, norm_config.epsilon)
    const tensor.NumericBlock gate ← _linear(ln2, mlp_weights.wg, mlp_weights.bg)
    const tensor.NumericBlock up ← _linear(ln2, mlp_weights.wu, mlp_weights.bu)
    const tensor.NumericBlock h ← _swiglu(gate, up, mlp_weights.wd, mlp_weights.bd)
    return _add(r1, h)
}

# =========================================================================
# GGUF-A5 — cached block: the same dense_block / transformer_block
# arithmetic, threading one layer's KVCache through attention.
# =========================================================================

@ public
class CachedBlock {
    tensor.NumericBlock output
    kv.KVCache state

    fn output() → tensor.NumericBlock {
        return self.output
    }

    fn state() → kv.KVCache {
        return self.state
    }
}

@ public
fn default_cached_block() → CachedBlock {
    return CachedBlock {output = tensor.default(), state = kv.default()}
}

fn _attention_cached(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, f32 scale, list<int> positions, int dim, kv.KVCache layer, list<int> tokens) → attention.CachedAttention ⇥ TransformerError {
    return attention.scaled_dot_product_causal_rope_cached(q, k, v, scale, positions, dim, layer, tokens)
}

fn _multi_attention_cached(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, tensor.NumericBlock wo, kv.KVCache layer, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, attention.RopeConfig cfg, list<int> tokens) → attention.CachedAttention ⇥ TransformerError {
    return attention.multi_head_attention_cached(q, k, v, wo, layer, num_heads, num_kv_heads, scale, positions, rope_dim, cfg, tokens)
}

# transformer_block_cached — inference mode 2 (causal + RoPE) only. The
# one-block decode step reads/writes the layer cache.
@ public
fn transformer_block_cached(tensor.NumericBlock x, tensor.NumericBlock ln1_s, tensor.NumericBlock ln1_o, tensor.NumericBlock wq, tensor.NumericBlock bq, tensor.NumericBlock wk, tensor.NumericBlock bk, tensor.NumericBlock wv, tensor.NumericBlock bv, tensor.NumericBlock wo, tensor.NumericBlock bo, tensor.NumericBlock ln2_s, tensor.NumericBlock ln2_o, tensor.NumericBlock wf1, tensor.NumericBlock bf1, tensor.NumericBlock wf2, tensor.NumericBlock bf2, tensor.NumericBlock ln3_s, tensor.NumericBlock ln3_o, f32 scale, list<int> positions, int dim, kv.KVCache layer, list<int> tokens) → CachedBlock ⇥ TransformerError {
    const tensor.NumericBlock ln1 ← _layernorm(x, ln1_s, ln1_o)
    const tensor.NumericBlock qb ← _linear(ln1, wq, bq)
    const tensor.NumericBlock kb ← _linear(ln1, wk, bk)
    const tensor.NumericBlock vb ← _linear(ln1, wv, bv)
    const attention.CachedAttention step ← _attention_cached(qb, kb, vb, scale, positions, dim, layer, tokens)
    const tensor.NumericBlock ao ← _linear(step.context(), wo, bo)
    const tensor.NumericBlock r1 ← _add(x, ao)
    const tensor.NumericBlock ln2 ← _layernorm(r1, ln2_s, ln2_o)
    const tensor.NumericBlock h1 ← _linear(ln2, wf1, bf1)
    const tensor.NumericBlock a1 ← _gelu(h1)
    const tensor.NumericBlock h2 ← _linear(a1, wf2, bf2)
    const tensor.NumericBlock r2 ← _add(r1, h2)
    return CachedBlock {output = _layernorm(r2, ln3_s, ln3_o), state = step.state()}
}

# dense_block_cached — the U1.5 dense block with per-layer KV read/write.
@ public
fn dense_block_cached(tensor.NumericBlock x, list<int> positions, kv.KVCache layer, list<int> tokens, DenseAttentionWeights attention_weights, DenseAttentionConfig attention_config, DenseMlpWeights mlp_weights, DenseNormConfig norm_config) → CachedBlock ⇥ TransformerError {
    const tensor.NumericBlock ln1 ← _rmsnorm(x, norm_config.ln1_s, norm_config.epsilon)
    const tensor.NumericBlock qb ← _linear(ln1, attention_weights.wq, attention_weights.bq)
    const tensor.NumericBlock kb ← _linear(ln1, attention_weights.wk, attention_weights.bk)
    const tensor.NumericBlock vb ← _linear(ln1, attention_weights.wv, attention_weights.bv)
    const attention.CachedAttention step ← _multi_attention_cached(qb, kb, vb, attention_weights.wo, layer, attention_config.num_heads, attention_config.num_kv_heads, attention_config.scale, positions, attention_config.rope_dim, attention_config.rope_config, tokens)
    const tensor.NumericBlock r1 ← _add(x, step.context())
    const tensor.NumericBlock ln2 ← _rmsnorm(r1, norm_config.ln2_s, norm_config.epsilon)
    const tensor.NumericBlock gate ← _linear(ln2, mlp_weights.wg, mlp_weights.bg)
    const tensor.NumericBlock up ← _linear(ln2, mlp_weights.wu, mlp_weights.bu)
    const tensor.NumericBlock h ← _swiglu(gate, up, mlp_weights.wd, mlp_weights.bd)
    return CachedBlock {output = _add(r1, h), state = step.state()}
}

# -------------------------------------------------------------------------
# Typed dense_block twins — ordinary assemblers over pinned tensors.
# Attention stays on the bag seam until GQA+RoPE is typed. Runtime ints
# are the bag-conversion geometry (T/D/Q/K/F as values).
# -------------------------------------------------------------------------

@ public
class TypedDenseLayer<size D, size Q, size K, size F> {
    tensor<f32, [D]> ln1
    tensor<f32, [D, Q]> wq
    tensor<f32, [Q]> bq
    bool has_bq
    tensor<f32, [D, K]> wk
    tensor<f32, [K]> bk
    bool has_bk
    tensor<f32, [D, K]> wv
    tensor<f32, [K]> bv
    bool has_bv
    tensor<f32, [Q, D]> wo
    tensor<f32, [D]> ln2
    tensor<f32, [D, F]> wg
    tensor<f32, [D, F]> wu
    tensor<f32, [F, D]> wd
}

@ public
class TypedCachedBlock<size T, size D> {
    tensor<f32, [T, D]> output
    kv.KVCache state
}

fn _to_block<size A, size B>(tensor<f32, [A, B]> t, int a, int b) → tensor.NumericBlock {
    return tensor.stage(dtype.f32(), [a, b], t ↦ list<f32>)
}

fn _from_block<size A, size B>(tensor.NumericBlock t) → tensor<f32, [A, B]> ⇥ TransformerError {
    do {
        return t.data ↦ tensor<f32, [A, B]>
    }
    catch conv {
        throw variant ShapeMismatch {message = "attention context pin failed"}
    }
}

@ public
fn dense_block_static<size T, size D, size Q, size K, size F>(tensor<f32, [T, D]> x, list<int> positions, TypedDenseLayer<D, Q, K, F> layer, DenseAttentionConfig attention_config, f32 epsilon, int rows, int hidden, int qwidth, int kwidth) → tensor<f32, [T, D]> ⇥ TransformerError {
    const tensor<f32, [T, D]> ln1 ← nn.rmsnorm(x, layer.ln1, epsilon)
    const tensor<f32, [T, Q]> q0 ← ln1 · layer.wq
    var tensor<f32, [T, Q]> qb ← q0
    if layer.has_bq {
        qb ← q0.added_bias(layer.bq)
    }
    const tensor<f32, [T, K]> k0 ← ln1 · layer.wk
    var tensor<f32, [T, K]> kb ← k0
    if layer.has_bk {
        kb ← k0.added_bias(layer.bk)
    }
    const tensor<f32, [T, K]> v0 ← ln1 · layer.wv
    var tensor<f32, [T, K]> vb ← v0
    if layer.has_bv {
        vb ← v0.added_bias(layer.bv)
    }
    const tensor.NumericBlock ctx_b ← _multi_attention(_to_block(qb, rows, qwidth), _to_block(kb, rows, kwidth), _to_block(vb, rows, kwidth), _to_block(layer.wo, qwidth, hidden), attention_config.num_heads, attention_config.num_kv_heads, attention_config.scale, positions, attention_config.rope_dim, attention_config.rope_config)
    const tensor<f32, [T, D]> ctx ← _from_block(ctx_b)
    const tensor<f32, [T, D]> r1 ← math.add(x, ctx)
    const tensor<f32, [T, D]> ln2 ← nn.rmsnorm(r1, layer.ln2, epsilon)
    const tensor<f32, [T, F]> gate ← ln2 · layer.wg
    const tensor<f32, [T, F]> up ← ln2 · layer.wu
    const tensor<f32, [T, F]> hidden_act ← nn.swiglu_hidden(gate, up)
    const tensor<f32, [T, D]> h ← hidden_act · layer.wd
    return math.add(r1, h)
}

@ public
fn dense_block_cached_static<size T, size D, size Q, size K, size F>(tensor<f32, [T, D]> x, list<int> positions, kv.KVCache cache, list<int> tokens, TypedDenseLayer<D, Q, K, F> layer, DenseAttentionConfig attention_config, f32 epsilon, int rows, int hidden, int qwidth, int kwidth) → TypedCachedBlock<T, D> ⇥ TransformerError {
    const tensor<f32, [T, D]> ln1 ← nn.rmsnorm(x, layer.ln1, epsilon)
    const tensor<f32, [T, Q]> q0 ← ln1 · layer.wq
    var tensor<f32, [T, Q]> qb ← q0
    if layer.has_bq {
        qb ← q0.added_bias(layer.bq)
    }
    const tensor<f32, [T, K]> k0 ← ln1 · layer.wk
    var tensor<f32, [T, K]> kb ← k0
    if layer.has_bk {
        kb ← k0.added_bias(layer.bk)
    }
    const tensor<f32, [T, K]> v0 ← ln1 · layer.wv
    var tensor<f32, [T, K]> vb ← v0
    if layer.has_bv {
        vb ← v0.added_bias(layer.bv)
    }
    const attention.CachedAttention step ← _multi_attention_cached(_to_block(qb, rows, qwidth), _to_block(kb, rows, kwidth), _to_block(vb, rows, kwidth), _to_block(layer.wo, qwidth, hidden), cache, attention_config.num_heads, attention_config.num_kv_heads, attention_config.scale, positions, attention_config.rope_dim, attention_config.rope_config, tokens)
    const tensor<f32, [T, D]> ctx ← _from_block(step.context())
    const tensor<f32, [T, D]> r1 ← math.add(x, ctx)
    const tensor<f32, [T, D]> ln2 ← nn.rmsnorm(r1, layer.ln2, epsilon)
    const tensor<f32, [T, F]> gate ← ln2 · layer.wg
    const tensor<f32, [T, F]> up ← ln2 · layer.wu
    const tensor<f32, [T, F]> hidden_act ← nn.swiglu_hidden(gate, up)
    const tensor<f32, [T, D]> h ← hidden_act · layer.wd
    return TypedCachedBlock {output = math.add(r1, h), state = step.state()}
}
