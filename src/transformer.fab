# ---- training row: transformer_block (mode 0) vs the accepted proof

describe "transformer block — training row oracle vs the accepted GPU-training proof" {
    test "mode 0 matches the independent f64 block evaluation (ln3, residual-2 r1 + h2)" {
        let _ trap_result_1 ← trap {

            let tensor.NumericBlock y ← transformer.transformer_block(tene(DATA_X, [2, 8]), tene(DATA_LN1_S, [8]), tene(DATA_LN1_O, [8]), tene(DATA_WQ, [8, 8]), tene(DATA_BQ, [8]), tene(DATA_WK, [8, 8]), tene(DATA_BK, [8]), tene(DATA_WV, [8, 8]), tene(DATA_BV, [8]), tene(DATA_WO, [8, 8]), tene(DATA_BO, [8]), tene(DATA_LN2_S, [8]), tene(DATA_LN2_O, [8]), tene(DATA_WF1, [8, 8]), tene(DATA_BF1, [8]), tene(DATA_WF2, [8, 8]), tene(DATA_BF2, [8]), tene(DATA_LN3_S, [8]), tene(DATA_LN3_O, [8]), DATA_SCALE, 0, [], 0)
            assert y.shape ≡ ([2, 8] ↦ list<int>)
            assert e2(y, 0, 0).approx(LN3_00, TOLERANCE)
            assert e2(y, 0, 1).approx(LN3_01, TOLERANCE)
            assert e2(y, 0, 2).approx(LN3_02, TOLERANCE)
            assert e2(y, 0, 3).approx(LN3_03, TOLERANCE)
            assert e2(y, 0, 4).approx(LN3_04, TOLERANCE)
            assert e2(y, 0, 5).approx(LN3_05, TOLERANCE)
            assert e2(y, 0, 6).approx(LN3_06, TOLERANCE)
            assert e2(y, 0, 7).approx(LN3_07, TOLERANCE)
            assert e2(y, 1, 0).approx(LN3_10, TOLERANCE)
            assert e2(y, 1, 1).approx(LN3_11, TOLERANCE)
            assert e2(y, 1, 2).approx(LN3_12, TOLERANCE)
            assert e2(y, 1, 3).approx(LN3_13, TOLERANCE)
            assert e2(y, 1, 4).approx(LN3_14, TOLERANCE)
            assert e2(y, 1, 5).approx(LN3_15, TOLERANCE)
            assert e2(y, 1, 6).approx(LN3_16, TOLERANCE)
            assert e2(y, 1, 7).approx(LN3_17, TOLERANCE)
            assert dtype.name(y.dtype) ≡ "f32"
        }
        match trap_result_1 {
            case returned let ? { }
