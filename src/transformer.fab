+++ toml
locale = "en"

+++ faber
# Transformer architecture facade.
#
# Public import: import from "gradus:transformer" transformer
# Depends on: gradus:tensor, gradus:math, gradus:nn, gradus:attention/rope,
#             gradus:attention/gqa, gradus:cache/kv
#
# Will split into nested leaves when ≥2 transformer components are
# implemented:
#   gradus:transformer/block      block = attn + ffn + residual + norm
#   gradus:transformer/position   positional encoding (learned, sinusoidal, RoPE)
#   gradus:transformer/head       output projection (logits)
#
# Architectural rule: a transformer composes primitives and attention blocks.
# It does not own its training loop and must not depend on training-control
# modules. No module owns a backend or device handle.
#
# The production block composes the gradus:nn / gradus:attention / gradus:math
# families over the staged carrier. Exact architecture fixtures belong in the
# co-located proba or in exempla, rather than in this public module.

import from "gradus:attention/rope"

import from "gradus:attention/gqa"

import from "gradus:cache/kv"

import from "gradus:math"

import from "gradus:nn"

import from "gradus:tensor"

# =========================================================================
# PML3-U3 — production surface (shape-generic transformer block, forward-only,
# typed errors)
# =========================================================================
#
# --- Contract (pml3-delivery.md PML3-U3) ---------------------------------
# A transformer block (attention + FFN + residual + norms) composes over the
# primitive surface, is forward-only, and matches the CPU oracle for the
# training row and the selected inference row; the block is usable by both
# PML4 training and PML5 inference. The F32 row is the admitted row.
#
# --- Block structure (matching the accepted fragment arithmetic) ----------
#   ln1 = layernorm(x, ln1_s, ln1_o)                    # pre-LN
#   qb  = linear(ln1, wq, bq); kb = linear(ln1, wk, bk); vb = linear(ln1, wv, bv)
#   ctx = attention(qb, kb, vb, scale [, positions, dim])   # mode-selected
#   ao  = linear(ctx, wo, bo)
#   r1  = x + ao                                        # residual 1
#   ln2 = layernorm(r1, ln2_s, ln2_o)                   # post-LN
#   h1  = linear(ln2, wf1, bf1); a1 = gelu(h1); h2 = linear(a1, wf2, bf2)
#   r2  = r1 + h2                                       # residual 2 (residual stream + FFN)
#   return ln3 = layernorm(r2, ln3_s, ln3_o)             # pre-loss LN -> block output
# Residual-2 matches dense_block / llama GI2-1 (add to the residual stream).
# The attention sub-block is mode-selected so the
# same block serves the selected inference row (causal + RoPE, mode 2)
# and the causal row (mode 1).
#
# Attention modes (mode): 0 = scaled_dot_product (plain — the training-row
# proof), 1 = scaled_dot_product_causal, 2 = scaled_dot_product_causal_rope
# (the inference row; positions + dim are the RoPE arguments).
#
# --- Autograd independence (PML3 thesis, forward-without-autograd) --------
# This module imports NO autograd surface (no gradus:gradient, no @ radix
# backward, no companion ABI). The block is a pure value function over the
# staged carrier; the co-located proba exercises it with no autograd import.
#
# --- Compiler-boundary notes ---------------------------------------------
#   * Shape generics are not available in library context (SEM014 — the
#     nn.fab posture); the staged carrier carries runtime shapes, so the
#     block is shape-generic at runtime and R3-compliant (no one-row/one-
#     shape narrowing in the public API).
#   * The CPU reference evaluates the block in f64 (FMIR stepper — the
#     pinned bert-tiny-fragment intermediates.json); this surface is f32
#     self-hosted. Row tests compare with the documented 5e-4 tolerance
#     (approx), not bit equality (the nn.fab / attention.fab posture).
#   * Sub-call errors (NnError / AttentionError / MathError) are mapped into
#     TransformerError by their documented message text, preserving the text
#     (the nn.fab linear mapping pattern — cross-module enum variants are
#     not referenceable, SEM001/SEM041).

# -------------------------------------------------------------------------
# TransformerError — typed error vocabulary of the transformer block surface.
# Every variant carries a text message (render via message), mirroring the
# nn/attention/math error contract.
# -------------------------------------------------------------------------

@ public
union TransformerError {
    @ shared
    string message

    NegativeDimension,
    DimensionAboveLimit,
    ProductAboveLimit,
    GradusMismatch,
    ShapeMismatch,
    Incompatible,
    DtypeMismatch,
    ElementMismatch,
    InvalidEpsilon,
    InvalidPosition,
    InvalidDimension,
    InvalidMode
}

@ conversion
fn from_nn_error(nn.NnError err) → TransformerError {
    match err {
        case nn.NnError.NegativeDimension let message {
            return variant NegativeDimension { message = message }
        }
        case nn.NnError.DimensionAboveLimit let message {
            return variant DimensionAboveLimit { message = message }
        }
        case nn.NnError.ProductAboveLimit let message {
            return variant ProductAboveLimit { message = message }
        }
        case nn.NnError.GradusMismatch let message {
            return variant GradusMismatch { message = message }
        }
        case nn.NnError.ShapeMismatch let message {
            return variant ShapeMismatch { message = message }
        }
        case nn.NnError.Incompatible let message {
            return variant Incompatible { message = message }
        }
        case nn.NnError.DtypeMismatch let message {
            return variant DtypeMismatch { message = message }
        }
        case nn.NnError.ElementMismatch let message {
            return variant ElementMismatch { message = message }
        }
        case nn.NnError.InvalidEpsilon let message {
            return variant InvalidEpsilon { message = message }
        }
        case nn.NnError.IndexOutOfBounds let message {
            return variant ShapeMismatch { message = message }
        }
        case _ {
            return variant ShapeMismatch { message = err.message }
        }
    }
}

@ conversion
fn from_math_error(math.MathError err) → TransformerError {
    match err {
        case math.MathError.NegativeDimension let message {
            return variant NegativeDimension { message = message }
        }
        case math.MathError.DimensionAboveLimit let message {
            return variant DimensionAboveLimit { message = message }
        }
        case math.MathError.ProductAboveLimit let message {
            return variant ProductAboveLimit { message = message }
        }
        case math.MathError.GradusMismatch let message {
            return variant GradusMismatch { message = message }
        }
        case math.MathError.ShapeMismatch let message {
            return variant ShapeMismatch { message = message }
        }
        case math.MathError.Incompatible let message {
            return variant Incompatible { message = message }
        }
        case math.MathError.DtypeMismatch let message {
            return variant DtypeMismatch { message = message }
        }
        case math.MathError.ElementMismatch let message {
            return variant ElementMismatch { message = message }
        }
        case _ {
            return variant ShapeMismatch { message = err.message }
        }
    }
}

@ conversion
fn from_attention_error(rope.AttentionError err) → TransformerError {
    match err {
        case rope.AttentionError.NegativeDimension let message {
            return variant NegativeDimension { message = message }
        }
        case rope.AttentionError.DimensionAboveLimit let message {
            return variant DimensionAboveLimit { message = message }
        }
        case rope.AttentionError.ProductAboveLimit let message {
            return variant ProductAboveLimit { message = message }
        }
        case rope.AttentionError.GradusMismatch let message {
            return variant GradusMismatch { message = message }
        }
        case rope.AttentionError.ShapeMismatch let message {
            return variant ShapeMismatch { message = message }
        }
        case rope.AttentionError.Incompatible let message {
            return variant Incompatible { message = message }
        }
        case rope.AttentionError.DtypeMismatch let message {
            return variant DtypeMismatch { message = message }
        }
        case rope.AttentionError.ElementMismatch let message {
            return variant ElementMismatch { message = message }
        }
        case rope.AttentionError.InvalidPosition let message {
            return variant InvalidPosition { message = message }
        }
        case rope.AttentionError.InvalidDimension let message {
            return variant InvalidDimension { message = message }
        }
        case _ {
            return variant ShapeMismatch { message = err.message }
        }
    }
}

# LayerNorm epsilon — the accepted rows' layer_norm(1, 1e-5, …) contract
# (the fragment's pre-LN / post-LN / pre-loss LN all use 1e-5).
const f32 LAYERNORM_EPSILON = 0.00001 ∷ f32

# -------------------------------------------------------------------------
# Private helpers — each wraps a primitive sub-call and maps its typed error
# into TransformerError preserving the documented message text (the nn.fab
# linear mapping pattern).
# -------------------------------------------------------------------------

# linear wrapper — nn.linear_carrier → TransformerError.
fn linear(tensor.NumericBlock x, tensor.NumericBlock w, tensor.NumericBlock b) → tensor.NumericBlock ⇥ TransformerError {
    return nn.linear_carrier(x, w, b)
}

# gelu wrapper — nn.gelu_carrier → TransformerError.
fn gelu(tensor.NumericBlock x) → tensor.NumericBlock ⇥ TransformerError {
    return nn.gelu_carrier(x)
}

# layernorm wrapper — nn.layernorm_carrier → TransformerError (fixed 1e-5 epsilon).
fn layernorm(tensor.NumericBlock x, tensor.NumericBlock s, tensor.NumericBlock o) → tensor.NumericBlock ⇥ TransformerError {
    return nn.layernorm_carrier(x, s, o, LAYERNORM_EPSILON)
}

# add wrapper — math.add_carrier → TransformerError.
fn add(tensor.NumericBlock a, tensor.NumericBlock b) → tensor.NumericBlock ⇥ TransformerError {
    return math.add_carrier(a, b)
}

# attention wrapper — mode-selected attention → TransformerError.
fn attention_for_mode(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, f32 scale, int mode, list<int> positions, int dim) → tensor.NumericBlock ⇥ TransformerError {
    switch mode {
        case 2 {
            return gqa.scaled_dot_product_causal_rope(q, k, v, scale, positions, dim)
        }
        case 1 {
            return gqa.scaled_dot_product_causal(q, k, v, scale)
        }
        default {
            return gqa.scaled_dot_product(q, k, v, scale)
        }
    }
}

# -------------------------------------------------------------------------
# transformer_block — the shape-generic transformer block. Composes the
# primitive surface (nn + attention) over the staged carrier, forward-only.
#
#   x      [T,D] input
#   ln1_s/o [D]  pre-LN affine
#   wq/bq/wk/bk/wv/bv/wo/bo  attention projections ([D,D]/[D] per-channel)
#   ln2_s/o [D]  post-LN affine
#   wf1/bf1/wf2/bf2          FFN ([D,F]/[F]/[F,D]/[D] per-channel)
#   ln3_s/o [D]  pre-loss LN affine
#   scale    dk scaling factor (1/sqrt(dk))
#   mode    attention mode: 0 plain (training row), 1 causal, 2 causal+rope
#   positions RoPE positions (mode 2)
#   dim      RoPE rotation width over the last axis (mode 2)
#
# Returns ln3 — the pre-loss LN output. Shape-generic at runtime (R3).
# -------------------------------------------------------------------------

@ public
fn transformer_block(tensor.NumericBlock x, tensor.NumericBlock ln1_s, tensor.NumericBlock ln1_o, tensor.NumericBlock wq, tensor.NumericBlock bq, tensor.NumericBlock wk, tensor.NumericBlock bk, tensor.NumericBlock wv, tensor.NumericBlock bv, tensor.NumericBlock wo, tensor.NumericBlock bo, tensor.NumericBlock ln2_s, tensor.NumericBlock ln2_o, tensor.NumericBlock wf1, tensor.NumericBlock bf1, tensor.NumericBlock wf2, tensor.NumericBlock bf2, tensor.NumericBlock ln3_s, tensor.NumericBlock ln3_o, f32 scale, int mode, list<int> positions, int dim) → tensor.NumericBlock ⇥ TransformerError {
    # --- attention mode (fail closed) -------------------------------------
    reject mode ≺ 0 or mode ≻ 2 throw variant InvalidMode { message = "unknown attention mode" }

    # --- pre-LN + Q/K/V projections ---------------------------------------
    let tensor.NumericBlock ln1 ← layernorm(x, ln1_s, ln1_o)
    let tensor.NumericBlock qb ← linear(ln1, wq, bq)
    let tensor.NumericBlock kb ← linear(ln1, wk, bk)
    let tensor.NumericBlock vb ← linear(ln1, wv, bv)

    # --- attention + output projection + residual 1 -----------------------
    let tensor.NumericBlock ctx ← attention_for_mode(qb, kb, vb, scale, mode, positions, dim)
    let tensor.NumericBlock ao ← linear(ctx, wo, bo)
    let tensor.NumericBlock r1 ← add(x, ao)

    # --- post-LN + FFN (linear → GELU → linear) ---------------------------
    let tensor.NumericBlock ln2 ← layernorm(r1, ln2_s, ln2_o)
    let tensor.NumericBlock h1 ← linear(ln2, wf1, bf1)
    let tensor.NumericBlock a1 ← gelu(h1)
    let tensor.NumericBlock h2 ← linear(a1, wf2, bf2)

    # --- residual 2 + pre-loss LN -----------------------------------------
    let tensor.NumericBlock r2 ← add(r1, h2)
    return layernorm(r2, ln3_s, ln3_o)
}

# =========================================================================
# Generic dense transformer block (dense_block).
# =========================================================================
#
# --- Contract -------------------------------------------------------------
# The ordered dense transformer block in gradus:transformer:
#   ln1  = rmsnorm(x, ln1_s, ε)                 # input RMSNorm (U1.1)
#   qb   = linear(ln1, wq, bq)                  # [T, H*D]
#   kb   = linear(ln1, wk, bk)                  # [T, K*D]
#   vb   = linear(ln1, wv, bv)                  # [T, K*D]
#   ctx  = multi_head_attention(qb, kb, vb, wo, n_h, n_kv, scale,
#                               positions, rope_dim, cfg)   # GQA (U1.4)
#   r1   = x + ctx                              # residual 1
#   ln2  = rmsnorm(r1, ln2_s, ε)                # post-attn RMSNorm (U1.1)
#   h    = swiglu(linear(ln2, wg, bg), linear(ln2, wu, bu), wd, bd)  # U1.2
#   r2   = r1 + h                               # residual 2 -> block output
# Composes the U1.1 (rmsnorm), U1.2 (swiglu), and U1.4
# (multi_head_attention) rows over the staged f32 carrier; causal + RoPE
# attention (the inference composition). No fixed-shape constants: every
# shape derives from the runtime tensors and the head counts. The F32 row
# is the admitted row (the composed rows' contract). The output is the
# final residual r2 [T, D]; a final norm / output projection is model
# assembly, not the block.
#
# --- Autograd independence (PML3 thesis, forward-without-autograd) --------
# Same posture as transformer_block: no autograd import, no gradient path.
#
# --- Compiler-boundary notes ---------------------------------------------
# Same posture as transformer_block: the staged carrier makes the block
# shape-generic at runtime (R3); sub-call errors are mapped into
# TransformerError by typed variant (the declared conversion functions
# above).

# rmsnorm wrapper — nn.rmsnorm_carrier → TransformerError.
fn rmsnorm(tensor.NumericBlock x, tensor.NumericBlock s, f32 epsilon) → tensor.NumericBlock ⇥ TransformerError {
    return nn.rmsnorm_carrier(x, s, epsilon)
}

# swiglu wrapper — nn.swiglu_carrier → TransformerError.
fn swiglu(tensor.NumericBlock gate, tensor.NumericBlock up, tensor.NumericBlock down_w, tensor.NumericBlock down_b) → tensor.NumericBlock ⇥ TransformerError {
    return nn.swiglu_carrier(gate, up, down_w, down_b)
}

# multi-head attention wrapper — gqa.multi_head_attention →
# TransformerError.
fn multi_attention(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, tensor.NumericBlock wo, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, rope.RopeConfig cfg) → tensor.NumericBlock ⇥ TransformerError {
    return gqa.multi_head_attention(q, k, v, wo, num_heads, num_kv_heads, scale, positions, rope_dim, cfg)
}

# -------------------------------------------------------------------------
# Dense block grouped records. The records keep each natural parameter seam
# named while runtime data remains positional at the block boundary.
# -------------------------------------------------------------------------

@ public
class DenseAttentionWeights {
    mut tensor.NumericBlock wq
    mut tensor.NumericBlock bq
    mut tensor.NumericBlock wk
    mut tensor.NumericBlock bk
    mut tensor.NumericBlock wv
    mut tensor.NumericBlock bv
    mut tensor.NumericBlock wo
}

@ public
class DenseAttentionConfig {
    mut int num_heads
    mut int num_kv_heads
    mut f32 scale
    mut int rope_dim
    mut rope.RopeConfig rope_config
}

@ public
class DenseMlpWeights {
    mut tensor.NumericBlock wg
    mut tensor.NumericBlock bg
    mut tensor.NumericBlock wu
    mut tensor.NumericBlock bu
    mut tensor.NumericBlock wd
    mut tensor.NumericBlock bd
}

@ public
class DenseNormConfig {
    mut tensor.NumericBlock ln1_s
    mut tensor.NumericBlock ln2_s
    mut f32 epsilon
}

# -------------------------------------------------------------------------
# dense_block — the generic dense transformer block over the staged carrier.
#
#   x, positions                         runtime data (positional)
#   attention_weights                    q/k/v and output projections
#   attention_config                     GQA + the shared RopeConfig
#   mlp_weights                          SwiGLU gate/up/down projections
#   norm_config                          RMSNorm scales and epsilon
#
# Returns r2 — the block output [T, D]. Shape-generic at runtime (R3).
# -------------------------------------------------------------------------

@ public
fn dense_block(tensor.NumericBlock x, list<int> positions, DenseAttentionWeights attention_weights, DenseAttentionConfig attention_config, DenseMlpWeights mlp_weights, DenseNormConfig norm_config) → tensor.NumericBlock ⇥ TransformerError {
    # --- input RMSNorm + Q/K/V projections --------------------------------
    let tensor.NumericBlock ln1 ← rmsnorm(x, norm_config.ln1_s, norm_config.epsilon)
    let tensor.NumericBlock qb ← linear(ln1, attention_weights.wq, attention_weights.bq)
    let tensor.NumericBlock kb ← linear(ln1, attention_weights.wk, attention_weights.bk)
    let tensor.NumericBlock vb ← linear(ln1, attention_weights.wv, attention_weights.bv)

    # --- multi-head attention (GQA + RoPE) --------------------------------
    let tensor.NumericBlock ctx ← multi_attention(qb, kb, vb, attention_weights.wo, attention_config.num_heads, attention_config.num_kv_heads, attention_config.scale, positions, attention_config.rope_dim, attention_config.rope_config)

    # --- residual 1 + post-attn RMSNorm -----------------------------------
    let tensor.NumericBlock r1 ← add(x, ctx)
    let tensor.NumericBlock ln2 ← rmsnorm(r1, norm_config.ln2_s, norm_config.epsilon)

    # --- SwiGLU + residual 2 ----------------------------------------------
    let tensor.NumericBlock gate ← linear(ln2, mlp_weights.wg, mlp_weights.bg)
    let tensor.NumericBlock up ← linear(ln2, mlp_weights.wu, mlp_weights.bu)
    let tensor.NumericBlock h ← swiglu(gate, up, mlp_weights.wd, mlp_weights.bd)
    return add(r1, h)
}

# =========================================================================
# GGUF-A5 — cached block: the same dense_block / transformer_block
# arithmetic, threading one layer's KVCache through attention.
# =========================================================================

@ public
class CachedBlock {
    mut tensor.NumericBlock output
    mut kv.KVCache state
}

@ public
fn default_cached_block() → CachedBlock {
    return CachedBlock { output = tensor.default(), state = kv.default() }
}

fn attention_cached(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, f32 scale, list<int> positions, int dim, kv.KVCache layer, list<int> tokens) → gqa.CachedAttention ⇥ TransformerError {
    return gqa.scaled_dot_product_causal_rope_cached(q, k, v, scale, positions, dim, layer, tokens)
}

fn multi_attention_cached(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, tensor.NumericBlock wo, kv.KVCache layer, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, rope.RopeConfig cfg, list<int> tokens) → gqa.CachedAttention ⇥ TransformerError {
    return gqa.multi_head_attention_cached(q, k, v, wo, layer, num_heads, num_kv_heads, scale, positions, rope_dim, cfg, tokens)
}

# transformer_block_cached — inference mode 2 (causal + RoPE) only. The
# one-block decode step reads/writes the layer cache.
@ public
fn transformer_block_cached(tensor.NumericBlock x, tensor.NumericBlock ln1_s, tensor.NumericBlock ln1_o, tensor.NumericBlock wq, tensor.NumericBlock bq, tensor.NumericBlock wk, tensor.NumericBlock bk, tensor.NumericBlock wv, tensor.NumericBlock bv, tensor.NumericBlock wo, tensor.NumericBlock bo, tensor.NumericBlock ln2_s, tensor.NumericBlock ln2_o, tensor.NumericBlock wf1, tensor.NumericBlock bf1, tensor.NumericBlock wf2, tensor.NumericBlock bf2, tensor.NumericBlock ln3_s, tensor.NumericBlock ln3_o, f32 scale, list<int> positions, int dim, kv.KVCache layer, list<int> tokens) → CachedBlock ⇥ TransformerError {
    # --- pre-LN + Q/K/V projections ---------------------------------------
    let tensor.NumericBlock ln1 ← layernorm(x, ln1_s, ln1_o)
    let tensor.NumericBlock qb ← linear(ln1, wq, bq)
    let tensor.NumericBlock kb ← linear(ln1, wk, bk)
    let tensor.NumericBlock vb ← linear(ln1, wv, bv)

    # --- cached attention (read/write layer) ------------------------------
    let gqa.CachedAttention step ← attention_cached(qb, kb, vb, scale, positions, dim, layer, tokens)

    # --- output projection + residual 1 -----------------------------------
    let tensor.NumericBlock ao ← linear(step.context, wo, bo)
    let tensor.NumericBlock r1 ← add(x, ao)

    # --- post-LN + FFN (linear → GELU → linear) ---------------------------
    let tensor.NumericBlock ln2 ← layernorm(r1, ln2_s, ln2_o)
    let tensor.NumericBlock h1 ← linear(ln2, wf1, bf1)
    let tensor.NumericBlock a1 ← gelu(h1)
    let tensor.NumericBlock h2 ← linear(a1, wf2, bf2)

    # --- residual 2 + pre-loss LN -----------------------------------------
    let tensor.NumericBlock r2 ← add(r1, h2)
    return CachedBlock { output = layernorm(r2, ln3_s, ln3_o), state = step.state }
}

# dense_block_cached — the U1.5 dense block with per-layer KV read/write.
@ public
fn dense_block_cached(tensor.NumericBlock x, list<int> positions, kv.KVCache layer, list<int> tokens, DenseAttentionWeights attention_weights, DenseAttentionConfig attention_config, DenseMlpWeights mlp_weights, DenseNormConfig norm_config) → CachedBlock ⇥ TransformerError {
    # --- input RMSNorm + Q/K/V projections --------------------------------
    let tensor.NumericBlock ln1 ← rmsnorm(x, norm_config.ln1_s, norm_config.epsilon)
    let tensor.NumericBlock qb ← linear(ln1, attention_weights.wq, attention_weights.bq)
    let tensor.NumericBlock kb ← linear(ln1, attention_weights.wk, attention_weights.bk)
    let tensor.NumericBlock vb ← linear(ln1, attention_weights.wv, attention_weights.bv)

    # --- cached multi-head attention (read/write layer) -------------------
    let gqa.CachedAttention step ← multi_attention_cached(qb, kb, vb, attention_weights.wo, layer, attention_config.num_heads, attention_config.num_kv_heads, attention_config.scale, positions, attention_config.rope_dim, attention_config.rope_config, tokens)

    # --- residual 1 + post-attn RMSNorm -----------------------------------
    let tensor.NumericBlock r1 ← add(x, step.context)
    let tensor.NumericBlock ln2 ← rmsnorm(r1, norm_config.ln2_s, norm_config.epsilon)

    # --- SwiGLU + residual 2 ----------------------------------------------
    let tensor.NumericBlock gate ← linear(ln2, mlp_weights.wg, mlp_weights.bg)
    let tensor.NumericBlock up ← linear(ln2, mlp_weights.wu, mlp_weights.bu)
    let tensor.NumericBlock h ← swiglu(gate, up, mlp_weights.wd, mlp_weights.bd)
    return CachedBlock { output = add(r1, h), state = step.state }
}

# -------------------------------------------------------------------------
# Typed dense_block twins — ordinary assemblers over pinned tensors.
# Attention stays on the bag seam until GQA+RoPE is typed. Runtime ints
# are the bag-conversion geometry (T/D/Q/K/F as values).
# -------------------------------------------------------------------------

@ public
class TypedDenseLayer<size D, size Q, size K, size F> {
    mut tensor<f32, [D]> ln1
    mut tensor<f32, [D, Q]> wq
    mut tensor<f32, [Q]> bq
    mut bool has_bq
    mut tensor<f32, [D, K]> wk
    mut tensor<f32, [K]> bk
    mut bool has_bk
    mut tensor<f32, [D, K]> wv
    mut tensor<f32, [K]> bv
    mut bool has_bv
    mut tensor<f32, [Q, D]> wo
    mut tensor<f32, [D]> ln2
    mut tensor<f32, [D, F]> wg
    mut tensor<f32, [D, F]> wu
    mut tensor<f32, [F, D]> wd
}

@ public
class TypedCachedBlock<size T, size D> {
    mut tensor<f32, [T, D]> output
    mut kv.KVCache state
}

fn to_block<size A, size B>(tensor<f32, [A, B]> t, int a, int b) → tensor.NumericBlock {
    return tensor.stage_f32([a, b], t ↦ list<f32>)
}

fn from_block<size A, size B>(tensor.NumericBlock t) → tensor<f32, [A, B]> ⇥ TransformerError {
    do {
        return t.data ↦ tensor<f32, [A, B]>
    }
    catch conv {
        throw variant ShapeMismatch { message = "attention context pin failed" }
    }
}

# KRS-4 absent-bias zero vector (tree rule 6: the host supplies the tensor).
# No typed zeros constructor exists (card hazard 1) — the zero is built
# host-side as a fill loop + construct + list→tensor pin, mirroring
# model/dense `_zeros_rank1` + `_pin_same_rank1`. Never a fill kernel.
fn zero_block(int n) → tensor.NumericBlock ⇥ TransformerError {
    mut list<f32> out ← empty

    for range 0 ‥ n {
        out.append(0.0 ∷ f32)
    }

    do {
        return tensor.construct(out, [n])
    }
    catch err {
        throw variant ShapeMismatch { message = "zero bias fill failed" }
    }
}

fn zero_bias<size N>(tensor.NumericBlock z) → tensor<f32, [N]> ⇥ TransformerError {
    do {
        return z.data ↦ tensor<f32, [N]>
    }
    catch conv {
        throw variant ShapeMismatch { message = "zero bias pin failed" }
    }
}

# KRS-4 region — the shared QKV projection of both static twins. The bias
# is ALWAYS added; the wrapper passes the real bias or a proven zero
# (never `if has_*` inside a kernel). Tuple return per the card's exact
# signature (card hazard 2 — first live tuple-returning @ kernel).
@ public
kernel dense_qkv<size T, size D, size Q, size K>(tensor<f32, [T, D]> ln1, tensor<f32, [D, Q]> wq, tensor<f32, [Q]> bq, tensor<f32, [D, K]> wk, tensor<f32, [K]> bk, tensor<f32, [D, K]> wv, tensor<f32, [K]> bv) → tuple<tensor<f32, [T, Q]>, tensor<f32, [T, K]>, tensor<f32, [T, K]>> {
    let tensor<f32, [T, Q]> q ← (ln1 · wq).added_bias(bq)
    let tensor<f32, [T, K]> k ← (ln1 · wk).added_bias(bk)
    let tensor<f32, [T, K]> v ← (ln1 · wv).added_bias(bv)
    return tuple<tensor<f32, [T, Q]>, tensor<f32, [T, K]>, tensor<f32, [T, K]>> [q, k, v]
}

# KRS-4 wrapper-side bias policy: has_* true → the real layer bias;
# false → a proven zero of the matching width (qwidth/kwidth are the
# runtime [Q]/[K] widths).
fn bias_or_zero<size N>(bool has, tensor<f32, [N]> real, int width) → tensor<f32, [N]> ⇥ TransformerError {
    if has then return real

    return zero_bias(zero_block(width))
}

@ public
fn dense_block_static<size T, size D, size Q, size K, size F>(tensor<f32, [T, D]> x, list<int> positions, TypedDenseLayer<size D, size Q, size K, size F> layer, DenseAttentionConfig attention_config, f32 epsilon, int rows, int hidden, int qwidth, int kwidth) → tensor<f32, [T, D]> ⇥ TransformerError {
    # --- input RMSNorm + QKV region (always-add bias; zeros on absent) ---
    let tensor<f32, [T, D]> ln1 ← nn.rmsnorm(x, layer.ln1, epsilon)
    let tensor<f32, [Q]> bq ← bias_or_zero(layer.has_bq, layer.bq, qwidth)
    let tensor<f32, [K]> bk ← bias_or_zero(layer.has_bk, layer.bk, kwidth)
    let tensor<f32, [K]> bv ← bias_or_zero(layer.has_bv, layer.bv, kwidth)
    let tuple<tensor<f32, [T, Q]>, tensor<f32, [T, K]>, tensor<f32, [T, K]>> qkv ← dense_qkv(ln1, layer.wq, bq, layer.wk, bk, layer.wv, bv)
    let tensor<f32, [T, Q]> qb ← qkv[0]
    let tensor<f32, [T, K]> kb ← qkv[1]
    let tensor<f32, [T, K]> vb ← qkv[2]

    # --- multi-head attention + context pin -------------------------------
    let tensor.NumericBlock ctx_b ← multi_attention(to_block(qb, rows, qwidth), to_block(kb, rows, kwidth), to_block(vb, rows, kwidth), to_block(layer.wo, qwidth, hidden), attention_config.num_heads, attention_config.num_kv_heads, attention_config.scale, positions, attention_config.rope_dim, attention_config.rope_config)
    let tensor<f32, [T, D]> ctx ← from_block(ctx_b)

    # --- residual 1 + post-attn RMSNorm -----------------------------------
    let tensor<f32, [T, D]> r1 ← math.add(x, ctx)
    let tensor<f32, [T, D]> ln2 ← nn.rmsnorm(r1, layer.ln2, epsilon)

    # --- SwiGLU + residual 2 ----------------------------------------------
    return dense_mlp(r1, ln2, layer.wg, layer.wu, layer.wd)
}

@ public
kernel dense_mlp<size T, size D, size F>(tensor<f32, [T, D]> residual, tensor<f32, [T, D]> ln2, tensor<f32, [D, F]> wg, tensor<f32, [D, F]> wu, tensor<f32, [F, D]> wd) → tensor<f32, [T, D]> {
    let tensor<f32, [T, F]> gate ← ln2 · wg
    let tensor<f32, [T, F]> up ← ln2 · wu
    let tensor<f32, [T, F]> hidden_act ← nn.swiglu_hidden(gate, up)
    let tensor<f32, [T, D]> h ← hidden_act · wd
    return math.add(residual, h)
}

@ public
fn dense_block_cached_static<size T, size D, size Q, size K, size F>(tensor<f32, [T, D]> x, list<int> positions, kv.KVCache cache, list<int> tokens, TypedDenseLayer<size D, size Q, size K, size F> layer, DenseAttentionConfig attention_config, f32 epsilon, int rows, int hidden, int qwidth, int kwidth) → TypedCachedBlock<size T, size D> ⇥ TransformerError {
    # --- input RMSNorm + QKV region (always-add bias; zeros on absent) ---
    let tensor<f32, [T, D]> ln1 ← nn.rmsnorm(x, layer.ln1, epsilon)
    let tensor<f32, [Q]> bq ← bias_or_zero(layer.has_bq, layer.bq, qwidth)
    let tensor<f32, [K]> bk ← bias_or_zero(layer.has_bk, layer.bk, kwidth)
    let tensor<f32, [K]> bv ← bias_or_zero(layer.has_bv, layer.bv, kwidth)
    let tuple<tensor<f32, [T, Q]>, tensor<f32, [T, K]>, tensor<f32, [T, K]>> qkv ← dense_qkv(ln1, layer.wq, bq, layer.wk, bk, layer.wv, bv)
    let tensor<f32, [T, Q]> qb ← qkv[0]
    let tensor<f32, [T, K]> kb ← qkv[1]
    let tensor<f32, [T, K]> vb ← qkv[2]

    # --- cached multi-head attention + context pin ------------------------
    let gqa.CachedAttention step ← multi_attention_cached(to_block(qb, rows, qwidth), to_block(kb, rows, kwidth), to_block(vb, rows, kwidth), to_block(layer.wo, qwidth, hidden), cache, attention_config.num_heads, attention_config.num_kv_heads, attention_config.scale, positions, attention_config.rope_dim, attention_config.rope_config, tokens)
    let tensor<f32, [T, D]> ctx ← from_block(step.context)

    # --- residual 1 + post-attn RMSNorm -----------------------------------
    let tensor<f32, [T, D]> r1 ← math.add(x, ctx)
    let tensor<f32, [T, D]> ln2 ← nn.rmsnorm(r1, layer.ln2, epsilon)

    # --- SwiGLU + residual 2 ----------------------------------------------
    return TypedCachedBlock { output = dense_mlp(r1, ln2, layer.wg, layer.wu, layer.wd), state = step.state }
}

+++ faber test
# Co-located package test for transformer.fab (PML3-U3 transformer block
# production surface). Not importable; discovered only by the faber test
# path.
#
# Proves, at compile level:
#   * the training row: transformer_block with mode 0 (plain scaled
#     dot-product attention) over the BERT-tiny fragment parameters. Residual-2
#     is r1 + h2 (the residual stream, matching dense_block / llama GI2-1),
#     not the fragment's accepted ln2 + h2b. The pinned ln3 values are the
#     independent f64 evaluation of that documented composition (external
#     Python). GI2-1 is llama/SwiGLU, not a GELU model — these pins are this
#     row's own f64 of the same residual-stream structure.
#   * the selected inference row: transformer_block with mode 2 (causal
#     mask + RoPE — the scaled_dot_product_causal_rope composite shared by
#     training and inference, GI3 CausalMaskedSoftmax + Rope recipes) over
#     the same fragment parameters with positions [0,1] / dim 2. The pinned
#     ln3 values are the f64 evaluation of the documented formulas (external
#     Python), pinned within the same 5e-4 tolerance.
#   * the typed-error contract of the block (message identity per validation),
#     including the block's own InvalidMode gate and the mapped
#     nn/attention/math errors (text preserved).
#   * forward-only / autograd independence: the whole surface is exercised
#     with NO autograd import (no gradus:gradient, no @ radix backward, no
#     companion ABI) — the staged carrier carries plain values, and the
#     block is a pure value function.
#
# Numerics: the CPU reference evaluates the block formulas in f64 (FMIR
# stepper); this surface is f32 self-hosted (exp via power; sin/cos via
# range reduction + Taylor for RoPE; tanh via the e^{2t} identity for GELU;
# Newton sqrt for layernorm). Rows compare with a documented 5e-4 absolute
# tolerance (approx), matching the nn.proba / attention.proba posture.
#
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
# Library-to-library calls execute on the FMIR stepper (radix 43c0102ba;
# regression-locked by 2e8042ae7). This suite remains compile-level proof;
# no runtime value identity is claimed here.

import from "gradus:transformer" transformer
import from "gradus:tensor" tensor
import from "gradus:dtype" dtype
import from "gradus:math" math
import from "gradus:attention/rope" rope


# Absolute tolerance for f32-vs-f64 comparison (the nn.proba posture).
const f32 TOLERANCE = (0.0005 ∷ f32)

# ---- helpers (the attention.proba pattern)

# Build a staged tensor, swallowing the never-firing construction errors
# (test data is always valid; the cape fallback is unreachable).
fn tene(list<f32> data, list<int> shape) → tensor.NumericBlock {
    return tensor.construct(data, shape) ⊥ tensor.default()
}

# Build an i32-tagged staged tensor (dtype-mismatch probes).
fn tene_i32(list<f32> data, list<int> shape) → tensor.NumericBlock {
    let tensor.NumericBlock f ← tene(data, shape)
    return tensor.NumericBlock {dtype = dtype.i32(), shape = f.shape, data = f.data, numel = f.numel, strides = f.strides}
}

# Validated consecutive-pair RopeConfig (dense.proba config_p shape).
fn config_p() → rope.RopeConfig {
    return rope.construct_rope_config((100000.0 ∷ f32), (1.0 ∷ f32), rope.consecutive_policy()) ⊥ rope.default()
}

# Staged-result element reads (swallow the never-firing access errors).
# BLOCKER (class 3, scalar narrowing): the success arm is the f32 element —
# narrowing a trap outcome to a scalar success type is blocked (routed
# N2/N4a), and the or_default closure form adds new SEM010 rows here
# (receiver-call closure wall). Kept on do/catch. Do not convert.
fn e2(tensor.NumericBlock r, int i, int j) → f32 {
    do {
        return r.get([i, j])
    }
    catch err {
        return (0.0 ∷ f32)
    }
}

# Block error renderer: the typed error's message on failure, "no error"
# otherwise. The message texts are the documented error identity.
fn block_detail(tensor.NumericBlock x, tensor.NumericBlock ln1_s, tensor.NumericBlock ln1_o, tensor.NumericBlock wq, tensor.NumericBlock bq, tensor.NumericBlock wk, tensor.NumericBlock bk, tensor.NumericBlock wv, tensor.NumericBlock bv, tensor.NumericBlock wo, tensor.NumericBlock bo, tensor.NumericBlock ln2_s, tensor.NumericBlock ln2_o, tensor.NumericBlock wf1, tensor.NumericBlock bf1, tensor.NumericBlock wf2, tensor.NumericBlock bf2, tensor.NumericBlock ln3_s, tensor.NumericBlock ln3_o, f32 scale, int mode, list<int> positions, int dim) → string {
    let _ outcome ← trap {
        transformer.transformer_block(x, ln1_s, ln1_o, wq, bq, wk, bk, wv, bv, wo, bo, ln2_s, ln2_o, wf1, bf1, wf2, bf2, ln3_s, ln3_o, scale, mode, positions, dim)
    }
    match outcome {
        case returned let value {
            return "no error"
        }
        case thrown let err {
            return err.message
        }
    }
}

