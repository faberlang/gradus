# Transformer architecture facade.
#
# Public import: importa ex "gradus:transformer" privata transformer
# Depends on: gradus:tensor, gradus:gradient, gradus:nn, gradus:attention
#
# S6-G1 (gpu-training-lowering stage-6-delivery.md): first concrete
# static-shape transformer block for the BERT-tiny fragment shapes
# (B=2, D=8, H=1). The fragment's block:
#   pre-LN → attention → output projection → residual →
#   post-LN → FFN (linear → GELU → linear) → residual → pre-loss LN
# Biases are per-channel [8] via the S6-C2 addita_bias contract (the
# fragment's [2,8] workaround is removed — U8 owns the consumer migration).
#
# Will split into nested leaves when ≥2 transformer components are
# implemented:
#   gradus:transformer/block      block = attn + ffn + residual + norm
#   gradus:transformer/position   positional encoding (learned, sinusoidal, RoPE)
#   gradus:transformer/head       output projection (logits)
#
# Architectural rule: a transformer composes primitives and attention blocks.
# It does not own its training loop. This module must not import from
# gradus:train. No module owns a backend or device handle.
#
# KNOWN TOOLCHAIN CONSTRAINT: the legacy fixed-shape function below
# (bert_tiny_block_2x8) is self-contained (typed-tensor ops only, no calls
# to other Gradus functions) — the FMIR stepper cannot resolve calls FROM a
# library function TO another library function ("FaberScript unsupported:
# provider sym#N"); it inlines the attention + FFN sub-block math (the S4-A
# train_step_4x4 precedent). The PML3-U3 production surface (bottom of this
# module) instead composes the gradus:nn / gradus:attention / gradus:math
# families over the staged carrier — the same posture as the nn.fab and
# attention.fab production surfaces (see nn.fab "Compiler-boundary notes").
#
# PML0-U3 ledger disposition (pml0-proof-api-ledger.md, gradus 33df687) —
# executed at PML1-U6: RETIRE attention_block_2x8 (row 13) and ffn_block_2x8
# (row 14). Neither had a live caller anywhere in the container; their math
# is fully inlined in bert_tiny_block_2x8 (row 15, ADMITTED — caller-backed:
# examples/training/bert-gradus-probe/src/train.fab:351). The standalone
# sub-block definitions are removed; the inlined copies below are the
# surviving surface.

importa ex "gradus:attention" privata attention
importa ex "gradus:math" privata math
importa ex "gradus:nn" privata nn
importa ex "gradus:tensor" privata tensor

# -------------------------------------------------------------------------
# bert_tiny_block_2x8 — the fragment's full transformer block (B=2, D=8):
#   pre-LN → attention → output proj → residual → post-LN → FFN → residual →
#   pre-loss LN. Returns ln3 [2,8].
#   18 trainable params + frozen dk_scale in; the pre-loss LN output out.
#   Inlines the attention + FFN sub-block math (stepper lib→lib gap, above).
# -------------------------------------------------------------------------

functio bert_tiny_block_2x8(
    tensor<f32, [2,8]> x,
    tensor<f32, [8]> ln1_s,   tensor<f32, [8]> ln1_o,
    tensor<f32, [8,8]> wq,    tensor<f32, [8]> bq,
    tensor<f32, [8,8]> wk,    tensor<f32, [8]> bk,
    tensor<f32, [8,8]> wv,    tensor<f32, [8]> bv,
    tensor<f32, [8,8]> wo,    tensor<f32, [8]> bo,
    tensor<f32, [8]> ln2_s,   tensor<f32, [8]> ln2_o,
    tensor<f32, [8,8]> wf1,   tensor<f32, [8]> bf1,
    tensor<f32, [8,8]> wf2,   tensor<f32, [8]> bf2,
    tensor<f32, [8]> ln3_s,   tensor<f32, [8]> ln3_o,
    tensor<f32, [2,2]> scale
) → tensor<f32, [2,8]> {
    # Pre-LN
    fixum tensor<f32, [2,8]> ln1 ← x.laminatio(1, 1.0e-5, ln1_s, ln1_o)

    # Q/K/V projections (per-channel [8] biases, S6-C2 addita_bias)
    fixum tensor<f32, [2,8]> q   ← ln1.matmul(wq)
    fixum tensor<f32, [2,8]> qb  ← q.addita_bias(bq)
    fixum tensor<f32, [2,8]> k   ← ln1.matmul(wk)
    fixum tensor<f32, [2,8]> kb  ← k.addita_bias(bk)
    fixum tensor<f32, [2,8]> v   ← ln1.matmul(wv)
    fixum tensor<f32, [2,8]> vb  ← v.addita_bias(bv)

    # Scaled dot-product attention
    fixum tensor<f32, [8,2]> kt      ← kb.transpone()
    fixum tensor<f32, [2,2]> scores  ← qb.matmul(kt)
    fixum tensor<f32, [2,2]> scaled  ← scores.multiplica(scale)
    fixum tensor<f32, [2,2]> attn    ← scaled.activatio_softmax()
    fixum tensor<f32, [2,8]> context ← attn.matmul(vb)

    # Output projection + residual 1
    fixum tensor<f32, [2,8]> ao   ← context.matmul(wo)
    fixum tensor<f32, [2,8]> aob  ← ao.addita_bias(bo)
    fixum tensor<f32, [2,8]> r1   ← x.addita(aob)

    # Post-LN
    fixum tensor<f32, [2,8]> ln2 ← r1.laminatio(1, 1.0e-5, ln2_s, ln2_o)

    # FFN (linear → GELU → linear)
    fixum tensor<f32, [2,8]> h1   ← ln2.matmul(wf1)
    fixum tensor<f32, [2,8]> h1b  ← h1.addita_bias(bf1)
    fixum tensor<f32, [2,8]> a1   ← h1b.gelu()
    fixum tensor<f32, [2,8]> h2   ← a1.matmul(wf2)
    fixum tensor<f32, [2,8]> h2b  ← h2.addita_bias(bf2)

    # Residual 2
    fixum tensor<f32, [2,8]> r2   ← ln2.addita(h2b)

    # Pre-loss LN
    fixum tensor<f32, [2,8]> ln3 ← r2.laminatio(1, 1.0e-5, ln3_s, ln3_o)
    redde ln3
}

# =========================================================================
# PML3-U3 — production surface (shape-generic transformer block, forward-only,
# typed errors)
# =========================================================================
#
# --- Contract (pml3-delivery.md PML3-U3) ---------------------------------
# A transformer block (attention + FFN + residual + norms) composes over the
# primitive surface, is forward-only, and matches the CPU oracle for the
# training row and the selected inference row; the block is usable by both
# PML4 training and PML5 inference. The F32 row is the admitted row.
#
# --- Block structure (matching the accepted fragment arithmetic) ----------
#   ln1 = layernorm(x, ln1_s, ln1_o)                    # pre-LN
#   qb  = linear(ln1, wq, bq); kb = linear(ln1, wk, bk); vb = linear(ln1, wv, bv)
#   ctx = attention(qb, kb, vb, scale [, positions, dim])   # mode-selected
#   ao  = linear(ctx, wo, bo)
#   r1  = x + ao                                        # residual 1
#   ln2 = layernorm(r1, ln2_s, ln2_o)                   # post-LN
#   h1  = linear(ln2, wf1, bf1); a1 = gelu(h1); h2 = linear(a1, wf2, bf2)
#   r2  = ln2 + h2                                      # residual 2 (post-LN + FFN out)
#   redde ln3 = layernorm(r2, ln3_s, ln3_o)             # pre-loss LN -> block output
# This is exactly the bert_tiny_block_2x8 arithmetic (the accepted
# GPU-training proof / BERT-tiny fragment row) — the training row. The
# attention sub-block is mode-selected so the same block serves the selected
# inference row (causal + RoPE, modus 2) and the causal row (modus 1).
#
# Attention modes (modus): 0 = scaled_dot_product (plain — the training-row
# proof), 1 = scaled_dot_product_causal, 2 = scaled_dot_product_causal_rope
# (the inference row; positions + dim are the RoPE arguments).
#
# --- Autograd independence (PML3 thesis, forward-without-autograd) --------
# This module imports NO autograd surface (no gradus:gradient, no @ radix
# backward, no companion ABI). The block is a pure value function over the
# staged carrier; the co-located proba exercises it with no autograd import.
#
# --- Compiler-boundary notes ---------------------------------------------
#   * Shape generics are not available in library context (SEM014 — the
#     nn.fab posture); the staged carrier carries runtime shapes, so the
#     block is shape-generic at runtime and R3-compliant (no one-row/one-
#     shape narrowing in the public API).
#   * The CPU reference evaluates the block in f64 (FMIR stepper — the
#     pinned bert-tiny-fragment intermediates.json); this surface is f32
#     self-hosted. Row tests compare with the documented 5e-4 tolerance
#     (approximata), not bit equality (the nn.fab / attention.fab posture).
#   * Sub-call errors (NnError / AttentionError / MathError) are mapped into
#     TransformerError by their documented causa text, preserving the text
#     (the nn.fab linear mapping pattern — cross-module enum variants are
#     not referenceable, SEM001/SEM041).

# -------------------------------------------------------------------------
# TransformerError — typed error vocabulary of the transformer block surface.
# Every variant carries a textus causa (render via causa), mirroring the
# nn/attention/math error contract.
# -------------------------------------------------------------------------

discretio TransformerError {
    DimensioNegativa { textus causa },
    DimensioSupraLimitem { textus causa },
    ProductumSupraLimitem { textus causa },
    GradusMismatch { textus causa },
    FormaMismatch { textus causa },
    Incompatibilis { textus causa },
    TypoMismatch { textus causa },
    ElementaMismatch { textus causa },
    EpsilonInvalida { textus causa },
    PositioInvalida { textus causa },
    DimensioInvalida { textus causa },
    ModusInvalida { textus causa }
}

functio causa(TransformerError e) → textus {
    discerne e {
        casu DimensioNegativa fixum causa { redde causa }
        casu DimensioSupraLimitem fixum causa { redde causa }
        casu ProductumSupraLimitem fixum causa { redde causa }
        casu GradusMismatch fixum causa { redde causa }
        casu FormaMismatch fixum causa { redde causa }
        casu Incompatibilis fixum causa { redde causa }
        casu TypoMismatch fixum causa { redde causa }
        casu ElementaMismatch fixum causa { redde causa }
        casu EpsilonInvalida fixum causa { redde causa }
        casu PositioInvalida fixum causa { redde causa }
        casu DimensioInvalida fixum causa { redde causa }
        casu ModusInvalida fixum causa { redde causa }
    }
}

# LayerNorm epsilon — the accepted rows' laminatio(1, 1e-5, …) contract
# (the fragment's pre-LN / post-LN / pre-loss LN all use 1e-5).
fixum f32 LAYERNORM_EPSILON ← (0.00001 ∷ f32)

# -------------------------------------------------------------------------
# Private helpers — each wraps a primitive sub-call and maps its typed error
# into TransformerError preserving the documented causa text (the nn.fab
# linear mapping pattern).
# -------------------------------------------------------------------------

# Map a documented sub-error causa text to the matching TransformerError
# variant (variant identity per the source module's vocabulary; the text is
# preserved verbatim — the proba asserts these exact strings).
@ privata
functio _mappa(textus c) → TransformerError {
    si c ≡ "negative dimension" {
        redde finge DimensioNegativa { causa = c }
    }
    si c ≡ "dimension above ceiling" {
        redde finge DimensioSupraLimitem { causa = c }
    }
    si c ≡ "element count above ceiling" {
        redde finge ProductumSupraLimitem { causa = c }
    }
    si c ≡ "linear requires rank-2 input" aut c ≡ "linear requires rank-2 weight" aut c ≡ "layernorm requires rank >= 1" aut c ≡ "matmul requires rank-2 operands" aut c ≡ "attention requires rank-2 tensors" {
        redde finge GradusMismatch { causa = c }
    }
    si c ≡ "inner dimensions mismatch" {
        redde finge Incompatibilis { causa = c }
    }
    si c ≡ "dtype mismatch" aut c ≡ "unsupported dtype for nn primitive" aut c ≡ "unsupported dtype for attention primitive" {
        redde finge TypoMismatch { causa = c }
    }
    si c ≡ "empty normalization axis" aut c ≡ "empty attention input" {
        redde finge ElementaMismatch { causa = c }
    }
    si c ≡ "negative epsilon" {
        redde finge EpsilonInvalida { causa = c }
    }
    si c ≡ "negative position" {
        redde finge PositioInvalida { causa = c }
    }
    si c ≡ "rope dim must be at least 2" aut c ≡ "rope dim must be even" aut c ≡ "rope dim exceeds head width" {
        redde finge DimensioInvalida { causa = c }
    }
    redde finge FormaMismatch { causa = c }
}

# linear wrapper — nn.linear → TransformerError.
@ privata
functio _linear(tensor.Tensor x, tensor.Tensor w, tensor.Tensor b) → tensor.Tensor ⇥ TransformerError {
    fac {
        redde nn.linear(x, w, b)
    }
    cape err {
        iace _mappa(nn.causa(err))
    }
}

# gelu wrapper — nn.gelu → TransformerError.
@ privata
functio _gelu(tensor.Tensor x) → tensor.Tensor ⇥ TransformerError {
    fac {
        redde nn.gelu(x)
    }
    cape err {
        iace _mappa(nn.causa(err))
    }
}

# layernorm wrapper — nn.layernorm → TransformerError (fixed 1e-5 epsilon).
@ privata
functio _layernorm(tensor.Tensor x, tensor.Tensor s, tensor.Tensor o) → tensor.Tensor ⇥ TransformerError {
    fac {
        redde nn.layernorm(x, s, o, LAYERNORM_EPSILON)
    }
    cape err {
        iace _mappa(nn.causa(err))
    }
}

# add wrapper — math.add → TransformerError.
@ privata
functio _add(tensor.Tensor a, tensor.Tensor b) → tensor.Tensor ⇥ TransformerError {
    fac {
        redde math.add(a, b)
    }
    cape err {
        iace _mappa(math.causa(err))
    }
}

# attention wrapper — mode-selected attention → TransformerError.
@ privata
functio _attentio(tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, f32 scale, numerus modus, lista<numerus> positions, numerus dim) → tensor.Tensor ⇥ TransformerError {
    si modus ≡ 2 {
        fac {
            redde attention.scaled_dot_product_causal_rope(q, k, v, scale, positions, dim)
        }
        cape err {
            iace _mappa(attention.causa(err))
        }
    }
    sin modus ≡ 1 {
        fac {
            redde attention.scaled_dot_product_causal(q, k, v, scale)
        }
        cape err {
            iace _mappa(attention.causa(err))
        }
    }
    fac {
        redde attention.scaled_dot_product(q, k, v, scale)
    }
    cape err {
        iace _mappa(attention.causa(err))
    }
}

# -------------------------------------------------------------------------
# transformer_block — the shape-generic transformer block. Composes the
# primitive surface (nn + attention) over the staged carrier, forward-only.
#
#   x      [T,D] input
#   ln1_s/o [D]  pre-LN affine
#   wq/bq/wk/bk/wv/bv/wo/bo  attention projections ([D,D]/[D] per-channel)
#   ln2_s/o [D]  post-LN affine
#   wf1/bf1/wf2/bf2          FFN ([D,F]/[F]/[F,D]/[D] per-channel)
#   ln3_s/o [D]  pre-loss LN affine
#   scale    dk scaling factor (1/sqrt(dk))
#   modus    attention mode: 0 plain (training row), 1 causal, 2 causal+rope
#   positions RoPE positions (modus 2)
#   dim      RoPE rotation width over the last axis (modus 2)
#
# Returns ln3 — the pre-loss LN output (the block's surviving contract from
# bert_tiny_block_2x8). Shape-generic at runtime (R3).
# -------------------------------------------------------------------------

functio transformer_block(
    tensor.Tensor x,
    tensor.Tensor ln1_s, tensor.Tensor ln1_o,
    tensor.Tensor wq, tensor.Tensor bq,
    tensor.Tensor wk, tensor.Tensor bk,
    tensor.Tensor wv, tensor.Tensor bv,
    tensor.Tensor wo, tensor.Tensor bo,
    tensor.Tensor ln2_s, tensor.Tensor ln2_o,
    tensor.Tensor wf1, tensor.Tensor bf1,
    tensor.Tensor wf2, tensor.Tensor bf2,
    tensor.Tensor ln3_s, tensor.Tensor ln3_o,
    f32 scale,
    numerus modus,
    lista<numerus> positions,
    numerus dim
) → tensor.Tensor ⇥ TransformerError {
    si modus < 0 aut modus > 2 {
        iace finge ModusInvalida { causa = "unknown attention mode" }
    }
    fixum tensor.Tensor ln1 ← _layernorm(x, ln1_s, ln1_o)
    fixum tensor.Tensor qb ← _linear(ln1, wq, bq)
    fixum tensor.Tensor kb ← _linear(ln1, wk, bk)
    fixum tensor.Tensor vb ← _linear(ln1, wv, bv)
    fixum tensor.Tensor ctx ← _attentio(qb, kb, vb, scale, modus, positions, dim)
    fixum tensor.Tensor ao ← _linear(ctx, wo, bo)
    fixum tensor.Tensor r1 ← _add(x, ao)
    fixum tensor.Tensor ln2 ← _layernorm(r1, ln2_s, ln2_o)
    fixum tensor.Tensor h1 ← _linear(ln2, wf1, bf1)
    fixum tensor.Tensor a1 ← _gelu(h1)
    fixum tensor.Tensor h2 ← _linear(a1, wf2, bf2)
    fixum tensor.Tensor r2 ← _add(ln2, h2)
    redde _layernorm(r2, ln3_s, ln3_o)
}
