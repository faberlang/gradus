# ---- training row oracle (mode 0 — plain scaled dot-product)
# Pinned ln3 = independent f64 evaluation of the documented block formulas
# with residual-2 r1 + h2 (the residual stream, matching dense_block /
# llama GI2-1). Old ln2 + h2 pins reproduced to 2.6e-10 before the flip.
# GI2-1 is a llama/SwiGLU reference, not a GELU model — these pins are
# this row's own f64 of the same residual-stream structure.
const f32 LN3_00 = (1.106439330967304 ∷ f32)
const f32 LN3_01 = (0.2117269775884883 ∷ f32)
const f32 LN3_02 = (1.292846813622155 ∷ f32)
const f32 LN3_03 = ((-1.974663027097102) ∷ f32)
