const f32 LN3_07 = (0.7697767760957988 ∷ f32)
const f32 LN3_10 = (0.6547262154221837 ∷ f32)
const f32 LN3_11 = ((-0.4457734715064318) ∷ f32)
const f32 LN3_12 = (1.764507892724463 ∷ f32)
const f32 LN3_13 = ((-1.389373545487935) ∷ f32)
const f32 LN3_14 = ((-0.3435704002614814) ∷ f32)
