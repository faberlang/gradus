+++
locale = "en"
+++
# Automatic differentiation wrapper — the gradient-call contract (PML4-U2).
#
# Public import: importa ex "gradus:gradient" privata gradient
# Depends on: gradus:tensor
#
# Wraps the compiler's reverse-mode AD transform (radix-air) into clean Faber
# ergonomics. The compiler generates gradient companion functions from
# @ radix backward annotations; this module owns the user-facing API surface
# around that mechanism.
#
# Architectural rule: @ radix backward annotations live behind this module's
# wrapper, not leaked into every public function signature in other modules.
# The gradient module is pure calculus — it does not know what it
# differentiates (no imports from loss, optimize, nn, attention, transformer).
# Parameter identity enters as plain (possessor, nomen, versio) fields — the
# PML1-U5 schema (parameter.fab schema_versio 1.0.0), never as a nominal
# parameter type.
#
# =========================================================================
# The gradient-call contract (pml4-delivery.md PML4-U2)
# =========================================================================
#
# --- One public contract ------------------------------------------------
# Compiler-generated backward companions are invoked through ONE public
# contract entry, never by calling the raw companion at a consumer call
# site:
#
#   gradient.gradientes_simple_loss(x, w, upstream,
#                                   nomen, possessor, versio)
#     → Gradientes   (per-parameter gradient bundle, identity + generation)
#
# The companion (loss_backward) is generated by the compiler FROM the
# annotated forward (simple_loss) and called INSIDE this module's wrapper.
# The wrapper pairs every gradient slot with its parameter identity
# (possessor + nomen, PML1-U5) and its GENERATION — the parameter's versio
# at gradient computation, so a later parameter mutation (parameter.fab
# muta bumps versio) makes a stored gradient provably stale
# (gradient.obsoletus).
#
# --- Shared with the GPU-training lane's accepted facts -----------------
#   * companion ABI: backward(args..., nil(), upstream) → iuncta(...) — the
#     stage-6 BERT-tiny route's 23-arg backward call / 21-slot gradient
#     destructure (gpu-training-lowering/stage-6-delivery.md); the MLP 4×4
#     route is forward_mlp_loss_backward (gradus.fab) → iuncta of 6 slots
#     (grad_input, grad_w1, grad_b1, grad_w2, grad_b2, grad_target) — the
#     same one-contract pattern.
#   * per-parameter identity = (possessor, nomen, versio) — parameter.fab
#     schema_versio 1.0.0 (PML1-U5); gradient value shape = parameter shape.
#   * gradient tolerance row: 1e-4 / 1e-4 (gpu-training-lowering/
#     numeric-policy.md v1.0.0 §5.1) — the auditor-owned runtime gate
#     compares companion output against the f64 oracle pins under this row.
#   * gradient oracle = FD central difference (the accepted route;
#     exempla/gradient-seam).
#
# --- Evidence honesty (CTO Q2, hard) ------------------------------------
# This surface is the STRUCTURAL proof: the companion call lives inside the
# module wrapper (compile-validated by the reverse-AD transform on `faber
# check`), and identity + generation logic is proven by the co-located
# proba. It does NOT prove runtime identity of the generated gradient
# VALUES — execution is env-blocked tree-wide today (FMIR stepper /
# library-import gap — recorded residual). PML4-U2 is PARTIAL: gradient-
# value identity is explicitly deferred to a runtime-evidence gate
# (auditor-owned faber test path; oracle pins recorded in gradient.proba).
import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# GradienteError — typed error vocabulary of the gradient-call contract.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------


@ public { }
union GradientError {
    GradusIgnotum {
        string message
    },
    GradusVersio {
        string message
    }
}

@ public { }
fn message(GradientError e) → string {
    match e {
        case GradusIgnotum const message {
            return message
        }
        case GradusVersio const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# Gradiente — one parameter's gradient: value + identity + generation.
#
#   possessor  — parameter owner path (PML1-U5 identity)
#   nomen      — parameter name (PML1-U5 identity)
#   versio     — GENERATION: the parameter's versio at gradient computation
#                (PML1-U5 mutation counter; a gradient computed at versio N
#                is stale once the parameter is at any other versio)
#   valor      — the gradient value tensor (shape = parameter shape)
# -------------------------------------------------------------------------


@ public { }
class Gradient {
    string owner
    string name
    int version
    tensor.Tensor payload

    # Owner path.
    fn owner() → string {
        return self.owner
    }

    # Parameter name.
    fn name() → string {
        return self.name
    }

    # Generation (parameter versio at gradient computation).
    fn version() → int {
        return self.version
    }

    # Gradient value carrier (shape = parameter shape).
    fn payload() → tensor.Tensor {
        return self.payload
    }
}

# Build a per-parameter gradient record. Identity fields must be non-empty
# and the generation must be a valid parameter versio (≥ 1, the PML1-U5
# start value) — fail closed, no best-effort reads (capsule rule).
@ public { }
fn construct(string name, string owner, int version, tensor.Tensor payload) → Gradient ⇥ GradientError {
    if name.length() ≡ 0 {
        throw variant GradusIgnotum {message = "empty gradient name"}
    }
    if owner.length() ≡ 0 {
        throw variant GradusIgnotum {message = "empty gradient owner"}
    }
    if version ≺ 1 {
        throw variant GradusVersio {message = "invalid gradient generation"}
    }
    return Gradient {owner = owner, name = name, version = version, payload = payload}
}

# -------------------------------------------------------------------------
# Gradientes — the per-parameter gradient bundle returned by ONE contract
# invocation. Identity resolution is unique within a bundle (possessor +
# nomen) and fails closed on a miss.
# -------------------------------------------------------------------------


@ public { }
class Gradients {
    list<Gradient> gradients

    # Gradient count (one per trainable parameter of the forward).
    fn count() → int {
        return self.gradients.length()
    }

    # Identity resolution by (possessor, nomen) — fail closed on a miss.
    fn find(string owner, string name) → Gradient ⇥ GradientError {
        for from self.gradients const g {
            if g.owner() ≡ owner and g.name() ≡ name then return g
        }
        throw variant GradusIgnotum {message = "no gradient for that parameter identity"}
    }
}

# Assemble a gradient bundle (insertion order = parameter declaration order).
@ public { }
fn construct_gradients(list<Gradient> gradients) → Gradients {
    return Gradients {gradients = gradients}
}

# -------------------------------------------------------------------------
# Generation / staleness contract. A gradient records the parameter versio
# it was computed against; once the parameter is mutated (parameter.fab
# muta bumps versio), the gradient is stale and an optimizer must not
# apply it. obsoletus(g, versio_currens) is true exactly when the gradient
# was computed at a different generation.
# -------------------------------------------------------------------------

@ public { }
fn obsolete(Gradient g, int versio_currens) → bool {
    return g.version() ≠ versio_currens
}

# -------------------------------------------------------------------------
# nil() — vacuum residual for the companion backward ABI.
# Required by the compiler-generated backward function to indicate no
# intermediate saves from the forward pass.
# -------------------------------------------------------------------------

@ public { }
fn nil() → void {
    pass
}

# -------------------------------------------------------------------------
# Differentiable scalar forward: simple_loss(x, w) = mean(x∘w)
#   x: frozen input,  w: trainable weight,  both 2×2 f32
#   Companion ABI: loss_backward(x, w, nil(), upstream) → iuncta(grad_x, grad_w)
# -------------------------------------------------------------------------

@ radix { lane = "air" }
@ radix backward "loss_backward"
@ public { }
fn simple_loss(tensor<f32, [2, 2]> x, tensor<f32, [2, 2]> w) → f32 {
    const tensor<f32, [2, 2]> product ← x.multiply(w)
    return product.mean()
}

# -------------------------------------------------------------------------
# gradientes_simple_loss — the ONE public contract entry: invokes the
# compiler-generated backward companion for simple_loss and packages the
# per-parameter gradient (the trainable parameter w) with identity +
# generation.
#
#   gradientes_simple_loss(x, w, upstream, nomen, possessor, versio)
#     → Gradientes (one Gradiente for w)
#
# `upstream` is the cotangent seed (1.0 for a scalar loss). Identity +
# generation are the caller-supplied parameter identity and version at
# gradient computation (the same values Parametrum.possessor()/nomen()/
# versio() return at the call site). Fail-closed: any empty identity field
# or invalid generation rejects BEFORE invocation (capsule rule). The
# companion is generated FROM the annotated simple_loss; consumers call
# this wrapper, never the raw companion.
# -------------------------------------------------------------------------

fn gradientes_simple_loss(tensor<f32, [2, 2]> x, tensor<f32, [2, 2]> w, f32 upstream, string name, string owner, int version) → Gradients ⇥ GradientError {
    if name.length() ≡ 0 {
        throw variant GradusIgnotum {message = "empty gradient name"}
    }
    if owner.length() ≡ 0 {
        throw variant GradusIgnotum {message = "empty gradient owner"}
    }
    if version ≺ 1 {
        throw variant GradusVersio {message = "invalid gradient generation"}
    }
    const tuple<tensor<f32, [2, 2]>, tensor<f32, [2, 2]>> grads ← loss_backward(x, w, nil(), upstream)
    const tensor<f32, [2, 2]> gw ← grads[1]
    # Bridge the companion's fixed-shape gradient into the staged carrier
    # (the parameter surface's value carrier): flat data round-trip through
    # the U1 constructor. The data is identical; the staged carrier is the
    # shape-generic surface U3's optimizer composes with.
    const list<f32> plana ← gw ↦ list<f32>
    var tensor.Tensor payload
    do {
        payload ← tensor.construct(plana, [2, 2])
    }
    catch err {
        throw variant GradusIgnotum {message = tensor.message(err)}
    }
    const Gradient rec ← construct(name, owner, version, payload)
    return construct_gradients([rec])
}
