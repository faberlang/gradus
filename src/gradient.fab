+++
locale = "en"
+++
# Automatic differentiation wrapper — the gradient-call contract (PML4-U2).
#
# Public import: import from "gradus:gradient" gradient
# Depends on: gradus:tensor
#
# Wraps the compiler's reverse-mode AD transform (radix-air) into clean Faber
# ergonomics. The compiler generates gradient companion functions from
# @ radix backward annotations; this module owns the user-facing API surface
# around that mechanism.
#
# Architectural rule: @ radix backward annotations live behind this module's
# wrapper, not leaked into every public function signature in other modules.
# The gradient module is pure calculus — it does not know what it
# differentiates (no imports from loss, optimize, nn, attention, transformer).
# Parameter identity enters as plain (owner, name, version) fields — the
# PML1-U5 schema (parameter.fab schema_version 1.0.0), never as a nominal
# parameter type.
#
# =========================================================================
# The gradient-call contract (pml4-delivery.md PML4-U2)
# =========================================================================
#
# --- One public contract ------------------------------------------------
# Compiler-generated backward companions are invoked through ONE public
# contract entry, never by calling the raw companion at a consumer call
# site:
#
#   gradient.gradients_simple_loss(x, w, upstream,
#                                   name, owner, version)
#     → Gradients   (per-parameter gradient bundle, identity + generation)
#
# The companion (loss_backward) is generated by the compiler FROM the
# annotated forward (simple_loss) and called INSIDE this module's wrapper.
# The wrapper pairs every gradient slot with its parameter identity
# (owner + name, PML1-U5) and its GENERATION — the parameter's version
# at gradient computation, so a later parameter mutation (parameter.fab
# mutate bumps version) makes a stored gradient provably stale
# (gradient.obsolete).
#
# --- Shared with the GPU-training lane's accepted facts -----------------
#   * companion ABI: backward(args..., nil(), upstream) → tuple(...) — the
#     stage-6 BERT-tiny route's 23-arg backward call / 21-slot gradient
#     destructure (gpu-training-lowering/stage-6-delivery.md); the MLP 4×4
#     route is forward_mlp_loss_backward (mlp.fab) → tuple of 6 slots
#     (grad_input, grad_w1, grad_b1, grad_w2, grad_b2, grad_target) — the
#     same one-contract pattern.
#   * per-parameter identity = (owner, name, version) — parameter.fab
#     schema_version 1.0.0 (PML1-U5); gradient value shape = parameter shape.
#   * gradient tolerance row: 1e-4 / 1e-4 (gpu-training-lowering/
#     numeric-policy.md v1.0.0 §5.1) — the auditor-owned runtime gate
#     compares companion output against the f64 oracle pins under this row.
#   * gradient oracle = FD central difference (the accepted route;
#     exempla/gradient-seam).
#
# --- Evidence honesty (CTO Q2, hard) ------------------------------------
# This surface is the STRUCTURAL proof: the companion call lives inside the
# module wrapper (compile-validated by the reverse-AD transform on `faber
# check`), and identity + generation logic is proven by the co-located
# proba. It does NOT prove runtime identity of the generated gradient
# VALUES — library-to-library calls execute on the FMIR stepper (radix
# 43c0102ba; regression-locked by 2e8042ae7). The gradient-seam
# check/run divergence remains an E8 residual, so gradient-value identity
# is explicitly deferred to a runtime-evidence gate
# (auditor-owned faber test path; oracle pins recorded in gradient.proba).
import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# GradientError — typed error vocabulary of the gradient-call contract.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------


@ public { }
union GradientError {
    UnknownGradient {
        string message
    },
    GradientVersion {
        string message
    }
}

@ public { }
fn message(GradientError e) → string {
    match e {
        case UnknownGradient const message {
            return message
        }
        case GradientVersion const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# Gradient — one parameter's gradient: value + identity + generation.
#
#   owner  — parameter owner path (PML1-U5 identity)
#   name      — parameter name (PML1-U5 identity)
#   version     — GENERATION: the parameter's version at gradient computation
#                (PML1-U5 mutation counter; a gradient computed at version N
#                is stale once the parameter is at any other version)
#   payload      — the gradient value tensor (shape = parameter shape)
# -------------------------------------------------------------------------


@ public { }
class Gradient {
    string owner
    string name
    int version
    tensor.Tensor payload

    # Owner path.
    fn owner() → string {
        return self.owner
    }

    # Parameter name.
    fn name() → string {
        return self.name
    }

    # Generation (parameter version at gradient computation).
    fn version() → int {
        return self.version
    }

    # Gradient value carrier (shape = parameter shape).
    fn payload() → tensor.Tensor {
        return self.payload
    }
}

# Build a per-parameter gradient record. Identity fields must be non-empty
# and the generation must be a valid parameter version (≥ 1, the PML1-U5
# start value) — fail closed, no best-effort reads (capsule rule).
@ public { }
fn construct(string name, string owner, int version, tensor.Tensor payload) → Gradient ⇥ GradientError {
    require name.length() ≠ 0 throw variant UnknownGradient {message = "empty gradient name"}
    require owner.length() ≠ 0 throw variant UnknownGradient {message = "empty gradient owner"}
    require version ≥ 1 throw variant GradientVersion {message = "invalid gradient generation"}
    return Gradient {owner = owner, name = name, version = version, payload = payload}
}

# Placeholder Default for `var Gradient` bindings (var on structs).
# Empty identity and an empty staged payload; not a valid gradient.
@ public { }
fn default() → Gradient {
    return Gradient {owner = "", name = "", version = 0, payload = tensor.default()}
}

# -------------------------------------------------------------------------
# Gradients — the per-parameter gradient bundle returned by ONE contract
# invocation. Identity resolution is unique within a bundle (owner +
# name) and fails closed on a miss.
# -------------------------------------------------------------------------


@ public { }
class Gradients {
    list<Gradient> gradients

    # Gradient count (one per trainable parameter of the forward).
    fn count() → int {
        return self.gradients.length()
    }

    # Identity resolution by (owner, name) — fail closed on a miss.
    fn find(string owner, string name) → Gradient ⇥ GradientError {
        for from self.gradients const g {
            if g.owner() ≡ owner and g.name() ≡ name then return g
        }
        throw variant UnknownGradient {message = "no gradient for that parameter identity"}
    }
}

# Assemble a gradient bundle (insertion order = parameter declaration order).
@ public { }
fn construct_gradients(list<Gradient> gradients) → Gradients {
    return Gradients {gradients = gradients}
}

# -------------------------------------------------------------------------
# Generation / staleness contract. A gradient records the parameter version
# it was computed against; once the parameter is mutated (parameter.fab
# mutate bumps version), the gradient is stale and an optimizer must not
# apply it. obsolete(g, current_version) is true exactly when the gradient
# was computed at a different generation.
# -------------------------------------------------------------------------

@ public { }
fn obsolete(Gradient g, int current_version) → bool {
    return g.version() ≠ current_version
}

# -------------------------------------------------------------------------
# nil() — empty residual for the companion backward ABI.
# Required by the compiler-generated backward function to indicate no
# intermediate saves from the forward pass.
# -------------------------------------------------------------------------

@ public { }
fn nil() → void {
    pass
}

# -------------------------------------------------------------------------
# Differentiable scalar forward: simple_loss(x, w) = mean(x∘w)
#   x: frozen input,  w: trainable weight,  both f32 [R, C]
#   Shape params bind implicitly at the call site (D1): shipped 2×2
#   calls stay valid. Depth-2 static body — no runtime shape reads.
#   Companion ABI: loss_backward(x, w, nil(), upstream) → tuple(grad_x, grad_w)
# -------------------------------------------------------------------------

@ radix { lane = "air" }
@ radix backward "loss_backward"
@ public { }
fn simple_loss<size R, size C>(tensor<f32, [R, C]> x, tensor<f32, [R, C]> w) → f32 {
    const _ product ← x ⊙ w
    return product.mean()
}

# -------------------------------------------------------------------------
# gradients_simple_loss — the ONE public contract entry: invokes the
# compiler-generated backward companion for simple_loss and packages the
# per-parameter gradient (the trainable parameter w) with identity +
# generation.
#
#   gradients_simple_loss(x, w, upstream, name, owner, version)
#     → Gradients (one Gradient for w)
#
# `upstream` is the cotangent seed (1.0 for a scalar loss). Identity +
# generation are the caller-supplied parameter identity and version at
# gradient computation (the same values Parameter.owner()/name()/
# version() return at the call site). Fail-closed: any empty identity field
# or invalid generation rejects BEFORE invocation (capsule rule). The
# companion is generated FROM the annotated simple_loss; consumers call
# this wrapper, never the raw companion.
# -------------------------------------------------------------------------

@ public { }
fn gradients_simple_loss<size R, size C>(tensor<f32, [R, C]> x, tensor<f32, [R, C]> w, f32 upstream, string name, string owner, int version) → Gradients ⇥ GradientError {
    require name.length() ≠ 0 throw variant UnknownGradient {message = "empty gradient name"}
    require owner.length() ≠ 0 throw variant UnknownGradient {message = "empty gradient owner"}
    require version ≥ 1 throw variant GradientVersion {message = "invalid gradient generation"}
    const tuple<tensor<f32, [R, C]>, tensor<f32, [R, C]>> grads ← loss_backward(x, w, nil(), upstream)
    const _ gw ← grads[1]
    # Bridge the companion's static-shape gradient into the staged carrier
    # (the parameter surface's value carrier): flat data round-trip through
    # the U1 constructor. Shape is materialized here (conversion edge):
    # size params are not values, so [R, C] cannot appear as a list literal.
    # The staged carrier is the shape-generic surface U3's optimizer
    # composes with.
    const list<f32> flat ↤ gw
    var tensor.Tensor payload ← tensor.default()
    do {
        payload ← tensor.construct(flat, gw.shape())
    }
    catch err {
        throw variant UnknownGradient {message = tensor.message(err)}
    }
    const Gradient rec ← construct(name, owner, version, payload)
    return construct_gradients([rec])
}

# -------------------------------------------------------------------------
# Differentiable masked mean over a padded batch (unit-3G / K2 bridge).
#   masked_mean(x, mask) = mean(x∘mask)
#   x: padded values,  mask: caller-built 0/1 operand (outside the region)
#   Shape param N binds implicitly at the call site (D1). Depth-2 static
#   body — no runtime shape reads, no in-region mask construction.
#   Admit conditions (§8.2): mask-as-operand, NaN-safe Mul+Mean body,
#   masked reduction exit. Padded lanes get exactly zero gradient via
#   the Mul VJP product rule (d(x·m)/dx = m). Companion ABI:
#     masked_mean_backward(x, mask, nil(), upstream) → (grad_x, grad_mask)
#   Generic-N unroll stays fail-closed this wave (OQ1); the library
#   surface is the already-admitted mask-as-operand form.
# -------------------------------------------------------------------------

@ radix { lane = "air" }
@ radix backward "masked_mean_backward"
@ public { }
fn masked_mean<size N>(tensor<f32, [N]> x, tensor<f32, [N]> mask) → f32 {
    const _ weighted ← x ⊙ mask
    return weighted.mean()
}

# -------------------------------------------------------------------------
# gradients_masked_mean — contract entry for the masked route: invokes
# the compiler-generated companion and packages the per-element gradient
# of the padded batch x (mask cotangent is product-rule arithmetic the
# caller discards). Identity + generation fail-closed before invocation.
# -------------------------------------------------------------------------

@ public { }
fn gradients_masked_mean<size N>(tensor<f32, [N]> x, tensor<f32, [N]> mask, f32 upstream, string name, string owner, int version) → Gradients ⇥ GradientError {
    require name.length() ≠ 0 throw variant UnknownGradient {message = "empty gradient name"}
    require owner.length() ≠ 0 throw variant UnknownGradient {message = "empty gradient owner"}
    require version ≥ 1 throw variant GradientVersion {message = "invalid gradient generation"}
    const tuple<tensor<f32, [N]>, tensor<f32, [N]>> grads ← masked_mean_backward(x, mask, nil(), upstream)
    const _ gx ← grads[0]
    const list<f32> flat ↤ gx
    var tensor.Tensor payload ← tensor.default()
    do {
        payload ← tensor.construct(flat, gx.shape())
    }
    catch err {
        throw variant UnknownGradient {message = tensor.message(err)}
    }
    const Gradient rec ← construct(name, owner, version, payload)
    return construct_gradients([rec])
}
