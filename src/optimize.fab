+++
locale = "en"
+++
# Optimizer state facade — SGD optimizer state (PML4-U3).
#
# Public import: importa ex "gradus:optimize" privata optimize
# Depends on: gradus:dtype (finita), gradus:gradient (Gradiente + obsoletus,
# the U2 gradient-call contract), gradus:parameter (Parametrum + muta, the
# PML1-U5 parameter contract), gradus:tensor (value carrier).
#
# Architectural rule: optimizers consume raw parameter tensors and gradient
# tensors. They do not know about layer abstractions or architectures. This
# module must not import from gradus:nn, gradus:attention, or
# gradus:transformer. No module owns a backend or device handle.
#
# PML0-U3 ledger disposition (pml0-proof-api-ledger.md, gradus 33df687) —
# executed at PML1-U6: RETIRE sgd_step_2x2 (row 10) and sgd_step_4x4 (row
# 11). The retired symbols' update math (param − lr·grad) is inlined in the
# caller-backed steppers train_step_2x2 / train_step_4x4 (src/train.fab,
# rows 16-17, admitted). PML4-U3 restores an optimizer surface ON TOP of
# the PML1 parameter contract (identity) and the U2 gradient-call contract
# (per-parameter gradients with generation) — the retired steppers are not
# revived; the production state contract below is the new surface.
#
# =========================================================================
# The optimizer-state contract (pml4-delivery.md PML4-U3)
# =========================================================================
#
# --- One per-parameter state slot ---------------------------------------
# SGD (first admitted row; batch optimizers after the first accepted —
# campaign batch-by-default). Every trainable parameter owns one state
# slot:
#
#   SgdStatum = identity (possessor + nomen, PML1-U5) + version +
#               generation + step count + learning rate
#
#   versio    — STATE version: mutation counter. Starts at 1; every
#               successful step (passus) bumps it by 1. Identity fields
#               (possessor/nomen) are stable across steps.
#   generatio — the parameter versio at the last applied step (the U2
#               generation seam). A gradient computed at a parameter
#               versio ≠ the parameter's current versio is STALE
#               (gradient.obsoletus) and is rejected before the step.
#   passus    — applied step count for this parameter.
#   lentus    — the learning rate (per-parameter; round-trips exactly in
#               the checkpoint).
#
# --- State mutation rules (explicit) ------------------------------------
# A step (passus) is the only mutation. Preconditions, fail closed with
# the typed OptimizeError:
#   * state identity ≡ parameter identity (IdentitasMismatch);
#   * gradient identity ≡ parameter identity (IdentitasMismatch);
#   * gradient fresh: NOT gradient.obsoletus(g, p.versio()) — the gradient
#     was computed against the parameter's current versio (GradusObsoletus);
#   * parameter trainable — frozen parameters never step (Gelida);
#   * gradient shape ≡ parameter shape (FormaMismatch).
# The update is the accepted SGD row (the retired sgd_step math, the
# train_step_2x2/4x4 formula, the GPU-training lane's per-step update):
#   param' = param − lentus·grad
# via parameter.muta (values-only, bumps the parameter versio by 1). A
# successful step produces the new parameter (versio bumped) and the new
# state slot: versio +1, generatio = the new parameter versio, passus +1.
# State identity and lentus are stable across steps.
#
# --- Serialization (versioned wire, exact round-trip) -------------------
#   slot wire:  "optimizer/sgd-state/1.0.0/<possessor>/<nomen>/<versio>/
#               <generatio>/<passus>/<lentus>"
#   full wire:  "optimizer/sgd/1.0.0/<count>;<slot>;...;<slot>"  (';' = slot
#               separator; empty optimizer has count 0 and no slots)
# The wire reserves '/' (slot field separator) and ';' (slot separator) in
# optimizer identity — an extension of the U5 wire-safety rule ("/"
# reserved) for this module's multi-slot wire, documented and fail-closed.
# The learning rate rides the lossless float-token form (the U7 serialize
# contract's shortest-round-trip textus tokens). A reader rejects unknown
# markers/schema versions, malformed fields, and out-of-range counters —
# fail closed, no best-effort partial reads (capsule rule).
# Checkpoint round-trip predicate: deserializa(serializa(x)) ≡ x by
# statum_aequus / sgd_aequus (field-wise, exact — including the lr).
#
# --- Shared with the GPU-training lane's accepted facts -----------------
#   * update formula param' = param − lr·grad — the retired sgd_step math
#     (pml0-proof-api-ledger.md rows 10-11), the admitted train_step_2x2/
#     4x4 surface (rows 16-17), and the stage-6 per-step update route
#     ("8-step inline SGD lr=0.01"; per-step parameter-update states in the
#     exit gate).
#   * per-parameter identity = (possessor, nomen, versio) — parameter.fab
#     schema_versio 1.0.0 (PML1-U5), the same schema the U2 Gradiente
#     record carries.
#   * gradient freshness composes with the U2 generation seam
#     (gradient.obsoletus).
#
# --- Evidence honesty (CTO Q2, hard) ------------------------------------
# This surface is the STRUCTURAL proof: the state contract (identity,
# version, generation, step-count, mutation rules) and the wire round-trip
# are compile-validated and proven by the co-located proba. Executed VALUE
# identity (the numeric outcome of a step, an exact checkpoint value) is
# env-blocked tree-wide today (FMIR stepper / library-import gap —
# recorded residual). PML4-U3 is PARTIAL: step-value identity is deferred
# to a runtime-evidence gate (auditor-owned faber test path; oracle pins
# recorded in optimize.proba).
import from "gradus:dtype" dtype

import from "gradus:gradient" gradient

import from "gradus:parameter" parametrum

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# Schema constant — any change to the wire layout is a schema bump;
# consumers reject unknown schema versions.
# -------------------------------------------------------------------------

const string schema_versio ← "1.0.0"

# -------------------------------------------------------------------------
# OptimizeError — typed error vocabulary of the optimizer-state contract.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------


@ public { }
union OptimizeError {
    NomenInane {
        string causa
    },
    VersioInvalida {
        string causa
    },
    GeneratioInvalida {
        string causa
    },
    PassusInvalida {
        string causa
    },
    LentusInvalida {
        string causa
    },
    IdentitasMismatch {
        string causa
    },
    GradusObsoletus {
        string causa
    },
    Gelida {
        string causa
    },
    FormaMismatch {
        string causa
    },
    Mutatio {
        string causa
    },
    NomenDuplicatum {
        string causa
    },
    NomenIgnotum {
        string causa
    },
    VersioIgnota {
        string causa
    },
    WireMala {
        string causa
    }
}

@ public { }
fn causa(OptimizeError e) → string {
    match e {
        case NomenInane const causa {
            return causa
        }
        case VersioInvalida const causa {
            return causa
        }
        case GeneratioInvalida const causa {
            return causa
        }
        case PassusInvalida const causa {
            return causa
        }
        case LentusInvalida const causa {
            return causa
        }
        case IdentitasMismatch const causa {
            return causa
        }
        case GradusObsoletus const causa {
            return causa
        }
        case Gelida const causa {
            return causa
        }
        case FormaMismatch const causa {
            return causa
        }
        case Mutatio const causa {
            return causa
        }
        case NomenDuplicatum const causa {
            return causa
        }
        case NomenIgnotum const causa {
            return causa
        }
        case VersioIgnota const causa {
            return causa
        }
        case WireMala const causa {
            return causa
        }
    }
}

# -------------------------------------------------------------------------
# Wire-safety and numeric-field helpers (the parameter.fab U5 pattern,
# extended: '/' AND ';' are reserved in optimizer identity — the slot and
# slot-separator markers of this module's wire).
# -------------------------------------------------------------------------

@ private { }
fn _habeat_solidum(string s) → bool {
    var int i ← 0
    while i ≺ s.length() {
        if s.get(i) ≡ "/" or s.get(i) ≡ ";" then return true
        i ← i + 1
    }
    return false
}

@ private { }
fn _digitum(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _numerica(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _digitum(s.get(i)) then return false
        i ← i + 1
    }
    return true
}

# -------------------------------------------------------------------------
# SgdStatum — one parameter's SGD state slot: identity + version +
# generation + step count + learning rate. See the header contract.
# -------------------------------------------------------------------------


@ public { }
class SgdStatum {
    string possessor
    string nomen
    int versio
    int generatio
    int passus
    f32 lentus

    # Owner path (identity, PML1-U5).
    fn possessor() → string {
        return self.possessor
    }

    # Parameter name (identity).
    fn nomen() → string {
        return self.nomen
    }

    # State version (mutation counter; starts at 1, bumps per step).
    fn versio() → int {
        return self.versio
    }

    # Generation: the parameter versio at the last applied step (U2 seam).
    fn generatio() → int {
        return self.generatio
    }

    # Applied step count.
    fn passus() → int {
        return self.passus
    }

    # Learning rate (per-parameter; exact in the checkpoint).
    fn lentus() → f32 {
        return self.lentus
    }
}

# Field-wise state equality — the checkpoint round-trip predicate
# (deserializa(serializa(x)) ≡ x), exact including the learning rate.
@ public { }
fn statum_aequus(SgdStatum a, SgdStatum b) → bool {
    if a.possessor() ≠ b.possessor() then return false
    if a.nomen() ≠ b.nomen() then return false
    if a.versio() ≠ b.versio() then return false
    if a.generatio() ≠ b.generatio() then return false
    if a.passus() ≠ b.passus() then return false
    if a.lentus() ≠ b.lentus() then return false
    return true
}

# Shared construction with full validation (used by the public constructor
# and by deserialization — both enter the same fail-closed rules).
@ private { }
fn _structum(string nomen, string possessor, int versio, int generatio, int passus, f32 lentus) → SgdStatum ⇥ OptimizeError {
    if not (not (nomen.length() ≡ 0)) {
        throw variant NomenInane {causa = "empty state name"}
    }
    if not (not (possessor.length() ≡ 0)) {
        throw variant NomenInane {causa = "empty state owner"}
    }
    if not (not (_habeat_solidum(possessor) or _habeat_solidum(nomen))) {
        throw variant NomenInane {causa = "reserved wire character in name or owner"}
    }
    if not (not (versio ≺ 1)) {
        throw variant VersioInvalida {causa = "invalid state version"}
    }
    if not (not (generatio ≺ 1)) {
        throw variant GeneratioInvalida {causa = "invalid generation"}
    }
    if not (not (passus ≺ 0)) {
        throw variant PassusInvalida {causa = "invalid step count"}
    }
    if not dtype.finita(lentus) {
        throw variant LentusInvalida {causa = "invalid learning rate"}
    }
    if not (not (lentus ≺ 0.0)) {
        throw variant LentusInvalida {causa = "invalid learning rate"}
    }
    return SgdStatum {possessor = possessor, nomen = nomen, versio = versio, generatio = generatio, passus = passus, lentus = lentus}
}

# Public constructor: a fresh state slot for a parameter at generation
# (its current versio), with the per-parameter learning rate. versio = 1,
# passus = 0.
@ public { }
fn structa(string nomen, string possessor, int generatio, f32 lentus) → SgdStatum ⇥ OptimizeError {
    return _structum(nomen, possessor, 1, generatio, 0, lentus)
}

# -------------------------------------------------------------------------
# Sgd — the optimizer: per-parameter state slots. Uniqueness by
# (possessor, nomen), fail-closed resolution.
# -------------------------------------------------------------------------


@ public { }
class Sgd {
    list<SgdStatum> statia

    # Registered state-slot count (one per optimized parameter).
    fn numerus() → int {
        return self.statia.length()
    }

    # Identity membership by (possessor, nomen).
    fn contineo(string possessor, string nomen) → bool {
        for from self.statia const s {
            if s.possessor() ≡ possessor and s.nomen() ≡ nomen then return true
        }
        return false
    }

    # Identity resolution — fail closed on a miss.
    fn inveni(string possessor, string nomen) → SgdStatum ⇥ OptimizeError {
        for from self.statia const s {
            if s.possessor() ≡ possessor and s.nomen() ≡ nomen then return s
        }
        throw variant NomenIgnotum {causa = "no optimizer state for that parameter"}
    }
}

# Field-wise optimizer equality — the whole-checkpoint round-trip
# predicate (same slots, exact field-wise).
@ public { }
fn sgd_aequus(Sgd a, Sgd b) → bool {
    if a.numerus() ≠ b.numerus() then return false
    for from a.statia const s {
        do {
            const SgdStatum t ← b.inveni(s.possessor(), s.nomen())
            if not statum_aequus(s, t) then return false
        }
        catch err {
            return false
        }
    }
    return true
}

# Empty optimizer (no state slots).
@ public { }
fn sgd_vacuum() → Sgd {
    return Sgd {statia = vacua}
}

# Register a state slot. Rejects a duplicate (possessor, nomen) identity.
@ public { }
fn adscisco(Sgd o, SgdStatum s) → Sgd ⇥ OptimizeError {
    if o.contineo(s.possessor(), s.nomen()) {
        throw variant NomenDuplicatum {causa = "optimizer state already registered for that parameter"}
    }
    var list<SgdStatum> nova ← o.statia
    nova.append(s)
    return Sgd {statia = nova}
}

# -------------------------------------------------------------------------
# Passus — one SGD step's result: the updated parameter and the advanced
# state slot.
# -------------------------------------------------------------------------


@ public { }
class Passus {
    parametrum.Parametrum novus
    SgdStatum statum

    # The updated parameter (versio bumped by muta).
    fn novus() → parametrum.Parametrum {
        return self.novus
    }

    # The advanced state slot (versio +1, generatio = new param versio,
    # passus +1).
    fn statum() → SgdStatum {
        return self.statum
    }
}

# -------------------------------------------------------------------------
# passus — the ONE state mutation: apply a fresh per-parameter gradient to
# the parameter (param' = param − lentus·grad) and advance the state slot.
# Preconditions are explicit and fail closed (see the header contract).
# -------------------------------------------------------------------------

@ public { }
fn passus(SgdStatum s, parametrum.Parametrum p, gradient.Gradiente g) → Passus ⇥ OptimizeError {
    if s.possessor() ≠ p.possessor() or s.nomen() ≠ p.nomen() {
        throw variant IdentitasMismatch {causa = "state identity does not match the parameter"}
    }
    if g.possessor() ≠ p.possessor() or g.nomen() ≠ p.nomen() {
        throw variant IdentitasMismatch {causa = "gradient identity does not match the parameter"}
    }
    if gradient.obsoletus(g, p.versio()) {
        throw variant GradusObsoletus {causa = "stale gradient: parameter mutated since the gradient was computed"}
    }
    if parametrum.est_gelida(p) {
        throw variant Gelida {causa = "frozen parameter cannot be optimized"}
    }
    if not (g.valor().figura() ≡ p.figura()) {
        throw variant FormaMismatch {causa = "gradient shape does not match the parameter"}
    }
    const list<f32> datos_p ← p.valor().datos
    const list<f32> datos_g ← g.valor().datos
    var list<f32> novus_datos ← vacua
    for range 0‥datos_p.length() const i {
        const f32 pv ← datos_p.get(i) coalesce 0.0 ∷ f32
        const f32 gv ← datos_g.get(i) coalesce 0.0 ∷ f32
        novus_datos.append(pv - s.lentus() * gv)
    }
    var parametrum.Parametrum p2
    do {
        p2 ← parametrum.muta(p, novus_datos)
    }
    catch err {
        throw variant Mutatio {causa = parametrum.causa(err)}
    }
    return Passus {novus = p2, statum = SgdStatum {possessor = s.possessor(), nomen = s.nomen(), versio = s.versio() + 1, generatio = p2.versio(), passus = s.passus() + 1, lentus = s.lentus()}}
}

# -------------------------------------------------------------------------
# Serialization — versioned wire forms, exact round-trip.
# -------------------------------------------------------------------------

@ public { }
fn serializa_statum(SgdStatum s) → string {
    var string out ← (((((((((((("optimizer/sgd-state/" + schema_versio) + "/") + s.possessor()) + "/") + s.nomen()) + "/") + (s.versio() ↦ string)) + "/") + (s.generatio() ↦ string)) + "/") + (s.passus() ↦ string)) + "/") + (s.lentus() ↦ string)
    return out
}

@ public { }
fn deserializa_statum(string wire) → SgdStatum ⇥ OptimizeError {
    const list<string> partes ← wire.split("/")
    if partes.length() ≠ 9 {
        throw variant WireMala {causa = "malformed sgd-state wire"}
    }
    if partes.get(0) coalesce "" ≠ "optimizer" {
        throw variant WireMala {causa = "unknown optimizer marker"}
    }
    if partes.get(1) coalesce "" ≠ "sgd-state" {
        throw variant WireMala {causa = "unknown optimizer-state marker"}
    }
    if partes.get(2) coalesce "" ≠ schema_versio {
        throw variant VersioIgnota {causa = "unknown optimizer schema version"}
    }
    const string possessor ← partes.get(3) coalesce ""
    const string nomen ← partes.get(4) coalesce ""
    const string versio_textus ← partes.get(5) coalesce ""
    const string generatio_textus ← partes.get(6) coalesce ""
    const string passus_textus ← partes.get(7) coalesce ""
    const string lentus_textus ← partes.get(8) coalesce ""
    var int versio ← 0
    var int generatio ← 0
    var int passus ← 0
    var f32 lentus ← 0.0 ∷ f32
    if not _numerica(versio_textus) {
        throw variant WireMala {causa = "malformed state version in optimizer wire"}
    }
    do {
        versio ← versio_textus ↦ int
    }
    catch err {
        throw variant WireMala {causa = "malformed state version in optimizer wire"}
    }
    if not _numerica(generatio_textus) {
        throw variant WireMala {causa = "malformed generation in optimizer wire"}
    }
    do {
        generatio ← generatio_textus ↦ int
    }
    catch err {
        throw variant WireMala {causa = "malformed generation in optimizer wire"}
    }
    if not _numerica(passus_textus) {
        throw variant WireMala {causa = "malformed step count in optimizer wire"}
    }
    do {
        passus ← passus_textus ↦ int
    }
    catch err {
        throw variant WireMala {causa = "malformed step count in optimizer wire"}
    }
    do {
        lentus ← lentus_textus ↦ f32
    }
    catch err {
        throw variant WireMala {causa = "malformed learning rate in optimizer wire"}
    }
    return _structum(nomen, possessor, versio, generatio, passus, lentus)
}

# The whole-optimizer (checkpoint) wire: count-prefixed, ';'-separated
# slots. The empty optimizer is "optimizer/sgd/1.0.0/0" (no slots).
@ public { }
fn serializa(Sgd o) → string {
    var string out ← (("optimizer/sgd/" + schema_versio) + "/") + (o.numerus() ↦ string)
    for from o.statia const s {
        out ← (out + ";") + serializa_statum(s)
    }
    return out
}

@ public { }
fn deserializa(string wire) → Sgd ⇥ OptimizeError {
    const list<string> partes ← wire.split(";")
    if partes.length() ≺ 1 {
        throw variant WireMala {causa = "malformed optimizer wire"}
    }
    const list<string> caput ← (partes.get(0) coalesce "").split("/")
    if caput.length() ≠ 4 {
        throw variant WireMala {causa = "malformed optimizer wire header"}
    }
    if caput.get(0) coalesce "" ≠ "optimizer" {
        throw variant WireMala {causa = "unknown optimizer marker"}
    }
    if caput.get(1) coalesce "" ≠ "sgd" {
        throw variant WireMala {causa = "unknown optimizer marker"}
    }
    if caput.get(2) coalesce "" ≠ schema_versio {
        throw variant VersioIgnota {causa = "unknown optimizer schema version"}
    }
    const string count_textus ← caput.get(3) coalesce ""
    if not _numerica(count_textus) {
        throw variant WireMala {causa = "malformed slot count in optimizer wire"}
    }
    var int count ← 0
    do {
        count ← count_textus ↦ int
    }
    catch err {
        throw variant WireMala {causa = "malformed slot count in optimizer wire"}
    }
    if count ≠ partes.length() - 1 {
        throw variant WireMala {causa = "slot count mismatch in optimizer wire"}
    }
    var list<SgdStatum> statia ← vacua
    var int i ← 1
    while i ≺ partes.length() {
        const SgdStatum s ← deserializa_statum(partes.get(i) coalesce "")
        statia.append(s)
        i ← i + 1
    }
    return Sgd {statia = statia}
}
