# Optimizer facade.
#
# Public import: importa ex "gradus:optimize" privata optimize
#
# S4-A (gpu-training-lowering stage-4-delivery.md): first concrete
# static-shape optimizer — SGD step, bounded to the first two callers
# (linear regression 2×2, MLP 4×4). Mirrors the norma:optimizer
# concrete-overload precedent.
#
# Architectural rule: optimizers consume raw parameter tensors and gradient
# tensors. They do not know about layer abstractions or architectures. This
# module must not import from gradus:nn, gradus:attention, or
# gradus:transformer. No module owns a backend or device handle.

# -------------------------------------------------------------------------
# sgd_step_2x2 — param − lr·grad (2×2 f32, linear-regression shape)
# -------------------------------------------------------------------------

functio sgd_step_2x2(
    tensor<f32, [2,2]> param,
    tensor<f32, [2,2]> grad,
    f32 lr
) → tensor<f32, [2,2]> {
    fixum lista<numerus> shape ← param.magnitudines()
    fixum tensor<f32, []> seed ← vacua
    fixum tensor<f32, [2,2]> lr_fill ← seed.crea(lr, shape)
    fixum tensor<f32, [2,2]> scaled ← grad.multiplica(lr_fill)
    redde param.subtrahe(scaled)
}

# -------------------------------------------------------------------------
# sgd_step_4x4 — param − lr·grad (4×4 f32, MLP shape)
# -------------------------------------------------------------------------

functio sgd_step_4x4(
    tensor<f32, [4,4]> param,
    tensor<f32, [4,4]> grad,
    f32 lr
) → tensor<f32, [4,4]> {
    fixum lista<numerus> shape ← param.magnitudines()
    fixum tensor<f32, []> seed ← vacua
    fixum tensor<f32, [4,4]> lr_fill ← seed.crea(lr, shape)
    fixum tensor<f32, [4,4]> scaled ← grad.multiplica(lr_fill)
    redde param.subtrahe(scaled)
}
