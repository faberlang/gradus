+++
locale = "en"
+++
# Optimizer state facade — SGD optimizer state (PML4-U3).
#
# Public import: import from "gradus:optimize" optimize
# Depends on: gradus:dtype (finite), gradus:gradient (Gradient + obsolete,
# the U2 gradient-call contract), gradus:parameter (Parameter + mutate, the
# PML1-U5 parameter contract), gradus:tensor (value carrier).
#
# Architectural rule: optimizers consume raw parameter tensors and gradient
# tensors. They do not know about layer abstractions or architectures. This
# module must not import from gradus:nn, gradus:attention, or
# gradus:transformer. No module owns a backend or device handle.
#
# PML0-U3 ledger disposition (pml0-proof-api-ledger.md, gradus 33df687) —
# sgd_step_2x2 (row 10) and sgd_step_4x4 (row 11) were initially retired
# at PML1-U6 because the update math (param − lr·grad) had to be inlined
# in train_step_2x2 / train_step_4x4 while the FMIR stepper lacked
# library-to-library call resolution (recorded 2026-08-04). That gap closed
# in radix 43c0102ba (2026-08-09); train-step-optimizer-call unit 1
# reversed the retirement and unit 2 routed train_step_* through these
# tensor-level steppers (per-tensor in/out). PML4-U3 remains the production
# state contract (identity + generation + step) ON TOP of the same math.
# GCB-W1-U3 (2026-08-28): sgd_step_2x2 and sgd_step_4x4 retired again —
# shape-specific wrappers collapsed onto the generic _sgd_family list
# form; train_step_2x2 / train_step_4x4 and the train_step_bert_* family
# all delegate through _sgd_family directly (need 127f9fd6).
#
# =========================================================================
# The optimizer-state contract (pml4-delivery.md PML4-U3)
# =========================================================================
#
# --- One per-parameter state slot ---------------------------------------
# SGD (first admitted row; batch optimizers after the first accepted —
# campaign batch-by-default). Every trainable parameter owns one state
# slot:
#
#   SgdState = identity (owner + name, PML1-U5) + version +
#               generation + step count + learning rate
#
#   version    — STATE version: mutation counter. Starts at 1; every
#               successful step (step) bumps it by 1. Identity fields
#               (owner/name) are stable across steps.
#   generation — the parameter version at the last applied step (the U2
#               generation seam). A gradient computed at a parameter
#               version ≠ the parameter's current version is STALE
#               (gradient.obsolete) and is rejected before the step.
#   step    — applied step count for this parameter.
#   rate    — the learning rate (per-parameter; round-trips exactly in
#               the checkpoint).
#
# --- State mutation rules (explicit) ------------------------------------
# A step (step) is the only mutation. Preconditions, fail closed with
# the typed OptimizeError:
#   * state identity ≡ parameter identity (IdentityMismatch);
#   * gradient identity ≡ parameter identity (IdentityMismatch);
#   * gradient fresh: NOT gradient.obsolete(g, p.version()) — the gradient
#     was computed against the parameter's current version (StaleGradient);
#   * parameter trainable — frozen parameters never step (Frozen);
#   * gradient shape ≡ parameter shape (ShapeMismatch).
# The update is the accepted SGD row (the shared sgd_step math, the
# train_step_2x2/4x4 formula, the GPU-training lane's per-step update):
#   param' = param − rate·grad
# via parameter.mutate (values-only, bumps the parameter version by 1). A
# successful step produces the new parameter (version bumped) and the new
# state slot: version +1, generation = the new parameter version, step +1.
# State identity and rate are stable across steps.
#
# --- Serialization (versioned wire, exact round-trip) -------------------
#   slot wire:  "optimizer/sgd-state/1.0.0/<owner>/<name>/<version>/
#               <generation>/<step>/<rate>"
#   full wire:  "optimizer/sgd/1.0.0/<count>;<slot>;...;<slot>"  (';' = slot
#               separator; empty optimizer has count 0 and no slots)
# The wire reserves '/' (slot field separator) and ';' (slot separator) in
# optimizer identity — an extension of the U5 wire-safety rule ("/"
# reserved) for this module's multi-slot wire, documented and fail-closed.
# The learning rate rides the lossless float-token form (the U7 serialize
# contract's shortest-round-trip text tokens). A reader rejects unknown
# markers/schema versions, malformed fields, and out-of-range counters —
# fail closed, no best-effort partial reads (capsule rule).
# Checkpoint round-trip predicate: deserialize(serialize(x)) ≡ x by
# state_equal / sgd_equal (field-wise, exact — including the lr).
#
# --- Shared with the GPU-training lane's accepted facts -----------------
#   * update formula param' = param − lr·grad — the shared sgd_step math
#     (pml0-proof-api-ledger.md rows 10-11), the admitted train_step_2x2/
#     4x4 surface (rows 16-17), and the stage-6 per-step update route
#     ("8-step inline SGD lr=0.01"; per-step parameter-update states in the
#     exit gate).
#   * per-parameter identity = (owner, name, version) — parameter.fab
#     schema_version 1.0.0 (PML1-U5), the same schema the U2 Gradient
#     record carries.
#   * gradient freshness composes with the U2 generation seam
#     (gradient.obsolete).
#
# --- Evidence honesty (CTO Q2, hard) ------------------------------------
# This surface is the STRUCTURAL proof: the state contract (identity,
# version, generation, step-count, mutation rules) and the wire round-trip
# are compile-validated and proven by the co-located proba. Executed VALUE
# identity (the numeric outcome of a step, an exact checkpoint value) —
# the train-step tensor path is executed by the training-loop exemplum.
# Library-to-library calls execute on the FMIR stepper (radix 43c0102ba;
# regression-locked by 2e8042ae7). PML4-U3 remains PARTIAL for broader
# step-value and checkpoint identity; those claims stay deferred to the
# runtime-evidence gate (auditor-owned faber test path; oracle pins
# recorded in optimize.proba).
import from "gradus:dtype" dtype

import from "gradus:gradient" gradient

import from "gradus:parameter" parameter

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# _sgd_family — one list-driven SGD update body (param' = param − lr·grad).
# Moved from gradus:train (train-step-optimizer-call unit 2, OQ2 default).
# train_step_bert_* and the fixed-shape train_step_2x2 / train_step_4x4
# delegate through this (sgd_step_2x2 / sgd_step_4x4 retired GCB-W1-U3).
# -------------------------------------------------------------------------

@ public
fn _sgd_family<size Figura>(list<tensor<f32, Figura>> params, list<tensor<f32, Figura>> grads, f32 lr) → list<tensor<f32, Figura>> {
    const list<int> shape ← params[0].shape()
    const tensor<f32, []> seed ← empty
    const _ lr_fill ← seed.create(lr, shape)
    var list<tensor<f32, Figura>> out ← empty
    for range 0 ‥ params.length() const i {
        out.append(params[i] - grads[i] ⊙ lr_fill)
    }
    return out
}

# -------------------------------------------------------------------------
# Schema constant — any change to the wire layout is a schema bump;
# consumers reject unknown schema versions.
# -------------------------------------------------------------------------

const string schema_version ← "1.0.0"

# -------------------------------------------------------------------------
# OptimizeError — typed error vocabulary of the optimizer-state contract.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------


@ public
union OptimizeError {
    @ shared
    string message

    EmptyName,
    InvalidVersion,
    InvalidGeneration,
    InvalidStep,
    InvalidRate,
    IdentityMismatch,
    StaleGradient,
    Frozen,
    ShapeMismatch,
    Mutation,
    DuplicateName,
    UnknownName,
    UnknownVersion,
    BadWire,
    ParameterFailure {
        parameter.ParameterError inner
    }
}

@ conversion
fn from_parameter_error(parameter.ParameterError err) → OptimizeError {
    return variant ParameterFailure { message = err.message, inner = err }
}



# -------------------------------------------------------------------------
# Wire-safety and numeric-field helpers (the parameter.fab U5 pattern,
# extended: '/' AND ';' are reserved in optimizer identity — the slot and
# slot-separator markers of this module's wire).
# -------------------------------------------------------------------------

fn _contains_separator(string s) → bool {
    return s.contains("/") or s.contains(";")
}

fn _digit(string c) → bool {
    const string text ↤ c
    return text between "0123456789"
}

fn _numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    for range 0 ‥ s.length() const i {
        if not _digit(s.get(i)) then return false
    }
    return true
}

# -------------------------------------------------------------------------
# SgdState — one parameter's SGD state slot: identity + version +
# generation + step count + learning rate. See the header contract.
# -------------------------------------------------------------------------


@ public
class SgdState {
    string owner
    string name
    int version
    int generation
    int step
    f32 rate

    # Owner path (identity, PML1-U5).
    fn owner() → string {
        return self.owner
    }

    # Parameter name (identity).
    fn name() → string {
        return self.name
    }

    # State version (mutation counter; starts at 1, bumps per step).
    fn version() → int {
        return self.version
    }

    # Generation: the parameter version at the last applied step (U2 seam).
    fn generation() → int {
        return self.generation
    }

    # Applied step count.
    fn step() → int {
        return self.step
    }

    # Learning rate (per-parameter; exact in the checkpoint).
    fn rate() → f32 {
        return self.rate
    }
}

# Field-wise state equality — the checkpoint round-trip predicate
# (deserialize(serialize(x)) ≡ x), exact including the learning rate.
@ public
fn state_equal(SgdState a, SgdState b) → bool {
    if a.owner() ≠ b.owner() then return false
    if a.name() ≠ b.name() then return false
    if a.version() ≠ b.version() then return false
    if a.generation() ≠ b.generation() then return false
    if a.step() ≠ b.step() then return false
    if a.rate() ≠ b.rate() then return false
    return true
}

# Shared construction with full validation (used by the public constructor
# and by deserialization — both enter the same fail-closed rules).
fn _construct(string name, string owner, int version, int generation, int step, f32 rate) → SgdState ⇥ OptimizeError {
    require name.length() ≠ 0 throw variant EmptyName { message = "empty state name" }
    require owner.length() ≠ 0 throw variant EmptyName { message = "empty state owner" }
    reject _contains_separator(owner) or _contains_separator(name) throw variant EmptyName { message = "reserved wire character in name or owner" }
    require version ≥ 1 throw variant InvalidVersion { message = "invalid state version" }
    require generation ≥ 1 throw variant InvalidGeneration { message = "invalid generation" }
    require step ≥ 0 throw variant InvalidStep { message = "invalid step count" }
    require dtype.finite(rate) throw variant InvalidRate { message = "invalid learning rate" }
    require rate ≥ 0.0 throw variant InvalidRate { message = "invalid learning rate" }
    return SgdState { owner = owner, name = name, version = version, generation = generation, step = step, rate = rate }
}

# Placeholder Default for `var SgdState` bindings (varia on structs).
# Empty identity and zero counters (not a valid state slot). Only a
# placeholder the caller overwrites, or returns from an unreachable cape arm.
@ public
fn default() → SgdState {
    return SgdState { owner = "", name = "", version = 0, generation = 0, step = 0, rate = 0.0 }
}

# Public constructor: a fresh state slot for a parameter at generation
# (its current version), with the per-parameter learning rate. version = 1,
# step = 0.
@ public
fn construct(string name, string owner, int generation, f32 rate) → SgdState ⇥ OptimizeError {
    return _construct(name, owner, 1, generation, 0, rate)
}

# -------------------------------------------------------------------------
# Sgd — the optimizer: per-parameter state slots. Uniqueness by
# (owner, name), fail-closed resolution.
# -------------------------------------------------------------------------


@ public
class Sgd {
    list<SgdState> states

    # Registered state-slot count (one per optimized parameter).
    fn count() → int {
        return self.states.length()
    }

    # Identity membership by (owner, name).
    fn contains(string owner, string name) → bool {
        for from self.states const s {
            if s.owner() ≡ owner and s.name() ≡ name then return true
        }
        return false
    }

    # Identity resolution — fail closed on a miss.
    fn find(string owner, string name) → SgdState ⇥ OptimizeError {
        for from self.states const s {
            if s.owner() ≡ owner and s.name() ≡ name then return s
        }
        throw variant UnknownName { message = "no optimizer state for that parameter" }
    }
}

# Field-wise optimizer equality — the whole-checkpoint round-trip
# predicate (same slots, exact field-wise).
@ public
fn sgd_equal(Sgd a, Sgd b) → bool {
    if a.count() ≠ b.count() then return false
    for from a.states const s {
        do {
            const SgdState t ← b.find(s.owner(), s.name())
            if not state_equal(s, t) then return false
        }
        catch err {
            return false
        }
    }
    return true
}

# Empty optimizer (no state slots).
@ public
fn empty_sgd() → Sgd {
    return Sgd { states = empty }
}

# Placeholder Default for `var Sgd` bindings (varia on structs).
# Empty optimizer (no state slots) — same carrier as empty_sgd.
@ public
fn default_sgd() → Sgd {
    return empty_sgd()
}

# Register a state slot. Rejects a duplicate (owner, name) identity.
@ public
fn add(Sgd o, SgdState s) → Sgd ⇥ OptimizeError {
    reject o.contains(s.owner(), s.name()) throw variant DuplicateName { message = "optimizer state already registered for that parameter" }
    var list<SgdState> next ← o.states
    next.append(s)
    return Sgd { states = next }
}

# -------------------------------------------------------------------------
# StepResult — one SGD step's result: the updated parameter and the advanced
# state slot.
# -------------------------------------------------------------------------


@ public
class StepResult {
    parameter.Parameter fresh
    SgdState state

    # The updated parameter (version bumped by mutate).
    fn fresh() → parameter.Parameter {
        return self.fresh
    }

    # The advanced state slot (version +1, generation = new param version,
    # step +1).
    fn state() → SgdState {
        return self.state
    }
}

# Placeholder Default for `var StepResult` bindings (varia on structs).
# Empty parameter and empty state (not a valid step). Only a placeholder
# the caller overwrites, or returns from an unreachable cape arm.
@ public
fn default_step() → StepResult {
    return StepResult { fresh = parameter.default(), state = default() }
}

# -------------------------------------------------------------------------
# step — the ONE state mutation: apply a fresh per-parameter gradient to
# the parameter (param' = param − rate·grad) and advance the state slot.
# Preconditions are explicit and fail closed (see the header contract).
# -------------------------------------------------------------------------

@ public
fn step(SgdState s, parameter.Parameter p, gradient.Gradient g) → StepResult ⇥ OptimizeError {
    reject s.owner() ≠ p.owner() or s.name() ≠ p.name() throw variant IdentityMismatch { message = "state identity does not match the parameter" }
    reject g.owner() ≠ p.owner() or g.name() ≠ p.name() throw variant IdentityMismatch { message = "gradient identity does not match the parameter" }
    reject gradient.obsolete(g, p.version()) throw variant StaleGradient { message = "stale gradient: parameter mutated since the gradient was computed" }
    reject parameter.is_frozen(p) throw variant Frozen { message = "frozen parameter cannot be optimized" }
    require g.payload().shape() ≡ p.shape() throw variant ShapeMismatch { message = "gradient shape does not match the parameter" }
    const list<f32> data_p ← p.payload().data
    const list<f32> data_g ← g.payload().data
    var list<f32> new_data ← empty
    for range 0 ‥ data_p.length() const i {
        const f32 pv ← data_p.get(i) coalesce 0.0 ∷ f32
        const f32 gv ← data_g.get(i) coalesce 0.0 ∷ f32
        new_data.append(pv - s.rate() * gv)
    }
    var parameter.Parameter p2 ← parameter.default()
    p2 ← parameter.mutate(p, new_data)
    return StepResult { fresh = p2, state = SgdState { owner = s.owner(), name = s.name(), version = s.version() + 1, generation = p2.version(), step = s.step() + 1, rate = s.rate() } }
}

# -------------------------------------------------------------------------
# Serialization — versioned wire forms, exact round-trip.
# -------------------------------------------------------------------------

@ public
fn serialize_state(SgdState s) → string {
    return "optimizer/sgd-state/§/§/§/§/§/§/§"(schema_version, s.owner(), s.name(), s.version() ↦ string, s.generation() ↦ string, s.step() ↦ string, s.rate() ↦ string)
}

@ public
fn deserialize_state(string wire) → SgdState ⇥ OptimizeError {
    const list<string> parts ← wire.split("/")
    require parts.length() ≡ 9 throw variant BadWire { message = "malformed sgd-state wire" }
    require parts.get(0) coalesce "" ≡ "optimizer" throw variant BadWire { message = "unknown optimizer marker" }
    require parts.get(1) coalesce "" ≡ "sgd-state" throw variant BadWire { message = "unknown optimizer-state marker" }
    require parts.get(2) coalesce "" ≡ schema_version throw variant UnknownVersion { message = "unknown optimizer schema version" }
    const string owner ← parts.get(3) coalesce ""
    const string name ← parts.get(4) coalesce ""
    const string version_text ← parts.get(5) coalesce ""
    const string generation_text ← parts.get(6) coalesce ""
    const string step_text ← parts.get(7) coalesce ""
    const string rate_text ← parts.get(8) coalesce ""
    var int version ← 0
    var int generation ← 0
    var int step ← 0
    var f32 rate ← 0.0 ∷ f32
    require _numeric(version_text) throw variant BadWire { message = "malformed state version in optimizer wire" }
    do {
        version ↤ version_text
    }
    catch err {
        throw variant BadWire { message = "malformed state version in optimizer wire" }
    }
    require _numeric(generation_text) throw variant BadWire { message = "malformed generation in optimizer wire" }
    do {
        generation ↤ generation_text
    }
    catch err {
        throw variant BadWire { message = "malformed generation in optimizer wire" }
    }
    require _numeric(step_text) throw variant BadWire { message = "malformed step count in optimizer wire" }
    do {
        step ↤ step_text
    }
    catch err {
        throw variant BadWire { message = "malformed step count in optimizer wire" }
    }
    do {
        rate ↤ rate_text
    }
    catch err {
        throw variant BadWire { message = "malformed learning rate in optimizer wire" }
    }
    return _construct(name, owner, version, generation, step, rate)
}

# The whole-optimizer (checkpoint) wire: count-prefixed, ';'-separated
# slots. The empty optimizer is "optimizer/sgd/1.0.0/0" (no slots).
@ public
fn serialize(Sgd o) → string {
    var string out ← "optimizer/sgd/§/§"(schema_version, o.count() ↦ string)
    for from o.states const s {
        out ← "§;§"(out, serialize_state(s))
    }
    return out
}

@ public
fn deserialize(string wire) → Sgd ⇥ OptimizeError {
    const list<string> parts ← wire.split(";")
    require parts.length() ≥ 1 throw variant BadWire { message = "malformed optimizer wire" }
    const list<string> header ← (parts.get(0) coalesce "").split("/")
    require header.length() ≡ 4 throw variant BadWire { message = "malformed optimizer wire header" }
    require header.get(0) coalesce "" ≡ "optimizer" throw variant BadWire { message = "unknown optimizer marker" }
    require header.get(1) coalesce "" ≡ "sgd" throw variant BadWire { message = "unknown optimizer marker" }
    require header.get(2) coalesce "" ≡ schema_version throw variant UnknownVersion { message = "unknown optimizer schema version" }
    const string count_text ← header.get(3) coalesce ""
    require _numeric(count_text) throw variant BadWire { message = "malformed slot count in optimizer wire" }
    var int count ← 0
    do {
        count ↤ count_text
    }
    catch err {
        throw variant BadWire { message = "malformed slot count in optimizer wire" }
    }
    require count ≡ parts.length() - 1 throw variant BadWire { message = "slot count mismatch in optimizer wire" }
    var Sgd o ← empty_sgd()
    for range 1 ‥ parts.length() const i {
        o ← add(o, deserialize_state(parts.get(i) coalesce ""))
    }
    return o
}
