# Residual-energy calibration bake — W5d-U1 (§17).
#
# Public import: import from "gradus:calibration" calibration
# Depends on: gradus:dtype (finite gate).
#
# This is a MEASUREMENT artifact, not a weight transform — the same role
# the ablation direction search plays for §13. Per expert, it records the
# fraction of routing-weighted expert-output energy that the first K
# candidate shared bases cannot represent. The bake emits per-expert
# scores, the K-recommendation curve the merge/basis families consume,
# the overlap-census cosine matrix, and 75e4ab98 provenance-digest fields.
# No tensor is rewritten here.
#
# Schema: residual-energy/1.0.0. A schema change is a bump; consumers
# reject an unknown schema. Digest VALUES are host-computed (no language
# crypto primitive — the capsule/artifact rule); this module form-validates
# them and fail-closes on a mismatch at verify/load.
#
# Residual at K against orthonormalized prefix B_1..B_K:
#   E_tot(e) = Σ_t mass_{t,e} · ||y_{t,e}||²
#   E_res(e, K) = Σ_t mass_{t,e} · (||y_{t,e}||² − Σ_{k<K} <y_{t,e}, b_k>²)
#   score(e, K) = E_res / E_tot
# Corpus curve[K] is the mass-energy-weighted mean of those scores.
# recommended_k is the smallest K whose curve residual is ≤ threshold.
#
# Fail-closed negatives (typed CalibrationError): empty corpus,
# zero-routing expert, malformed/mismatched provenance digest, invalid
# threshold, linearly dependent candidate basis, non-finite values.
import from "gradus:dtype" dtype

const string SCHEMA = "residual-energy/1.0.0"

# --- CalibrationError: typed vocabulary of the residual-energy bake ------
@ public
union CalibrationError {
    @ shared
    string message

    EmptyCorpus,
    ZeroRouting,
    DigestMismatch,
    DigestMalformed,
    ThresholdInvalid,
    DimensionMismatch,
    ExpertRange,
    BasisInvalid,
    NonFinite,
    Invalid
}

# --- Calibration corpus --------------------------------------------------
@ public
class RoutingActivation {
    mut int layer
    mut int expert
    mut f32 mass
    mut list<f32> output
}

# Mass and output are checked at corpus/bake, not here.
@ public
fn activation(int layer, int expert, f32 mass, list<f32> output) → RoutingActivation {
    return RoutingActivation { layer = layer, expert = expert, mass = mass, output = output }
}

# Declared layer/expert/dimension counts plus the routing-activation rows
# the bake measures.
@ public
class CalibrationCorpus {
    mut list<RoutingActivation> activations
    mut int layers
    mut int experts
    mut int dimension
}

# Fails closed on an empty row set, non-positive counts, out-of-range ids,
# dimension mismatch, non-finite/non-positive mass, or a declared
# (layer, expert) slot that never routed.
@ public
fn corpus(list<RoutingActivation> activations, int layers, int experts, int dimension) → CalibrationCorpus ⇥ CalibrationError {
    validate_corpus(activations, layers, experts, dimension)
    return CalibrationCorpus { activations = activations, layers = layers, experts = experts, dimension = dimension }
}

# --- Artifact records ----------------------------------------------------
# Per-expert residual-energy score at the recommended K; residual is the
# unrepresentable fraction in [0, 1], mass the routed mass behind it.
@ public
class ExpertEnergy {
    mut int layer
    mut int expert
    mut f32 residual
    mut f32 mass
}

# rank is 0 because this bake measures shared-basis output energy;
# per-expert rank-r deltas are a later transform gated on this curve.
@ public
class CurvePoint {
    mut int bases
    mut int rank
    mut f32 residual
}

# One overlap-census cosine over routing-weighted mean outputs.
@ public
class SimilarityCell {
    mut int layer
    mut int expert_a
    mut int expert_b
    mut f32 cosine
}

# 75e4ab98 admission-manifest fields: named sha-256 digest of this
# artifact, content length, and sibling corpus/base digests. Authority is
# the bake inputs; the manifest is a derived verification record and is
# never trusted without verify.
@ public
class Provenance {
    mut string algorithm
    mut string digest
    mut int length
    mut string corpus_digest
    mut string base_digest
}

@ public
class ResidualEnergyArtifact {
    mut string schema
    mut list<ExpertEnergy> scores
    mut list<CurvePoint> curve
    mut list<SimilarityCell> similarities
    mut int recommended_k
    mut f32 threshold
    mut bool below_threshold
    mut Provenance provenance
}

# Placeholder Default for `var ResidualEnergyArtifact` bindings.
@ public
fn default() → ResidualEnergyArtifact {
    return ResidualEnergyArtifact { schema = SCHEMA, scores = empty, curve = empty, similarities = empty, recommended_k = 0, threshold = 0.0, below_threshold = false, provenance = Provenance { algorithm = "", digest = "", length = 0, corpus_digest = "", base_digest = "" } }
}

# --- Bake ----------------------------------------------------------------
# Bases are Gram-Schmidt orthonormalized in listed order so curve[K] is
# residual against the span of the first K candidates. Provenance claims
# are form-validated (sha-256 + 64 lowercase hex + positive length).
# WARN027 keeper: one staged §17 measurement pipeline — slot scatter, curve
# fold, recommendation scan, score assembly — whose fail-closed order is the
# contract; splitting it would reorder validation, not reduce real branching.
@ public
fn bake(CalibrationCorpus corpus, list<list<f32>> bases, f32 threshold, string algorithm, string digest, int length, string corpus_digest, string base_digest) → ResidualEnergyArtifact ⇥ CalibrationError {
    validate_corpus(corpus.activations, corpus.layers, corpus.experts, corpus.dimension)
    require dtype.finite(threshold) throw variant NonFinite { message = "non-finite calibration value" }
    reject threshold ≤ 0.0 or threshold ≻ 1.0 throw variant ThresholdInvalid { message = "threshold must be in (0, 1]" }
    let Provenance proven ← provenance(algorithm, digest, length, corpus_digest, base_digest)
    let list<list<f32>> qs ← orthonormal(bases, corpus.dimension)
    let int k_max ← qs.length()
    let int slots ← corpus.layers * corpus.experts
    let int dim ← corpus.dimension
    mut list<f32> mass ← zeros(slots)
    mut list<f32> energy ← zeros(slots)
    mut list<f32> weighted ← zeros(slots * dim)
    mut list<f32> residual_k ← zeros((k_max + 1) * slots)
    for from corpus.activations let row {
        let int slot ← slot_index(row.layer, row.expert, corpus.experts)
        let f32 n2 ← norm2(row.output)
        mass ← put_f32(mass, slot, mass.get(slot) coalesce 0.0 ∷ f32 + row.mass)
        energy ← put_f32(energy, slot, energy.get(slot) coalesce 0.0 ∷ f32 + row.mass * n2)
        for range 0 ‥ dim let d {
            let int wi ← slot * dim + d
            let f32 y ← row.output.get(d) coalesce 0.0 ∷ f32
            weighted ← put_f32(weighted, wi, weighted.get(wi) coalesce 0.0 ∷ f32 + row.mass * y)
        }
        for range 0 ‥ k_max + 1 let k {
            let f32 r2 ← residual2(row.output, qs, k)
            let int ri ← k * slots + slot
            residual_k ← put_f32(residual_k, ri, residual_k.get(ri) coalesce 0.0 ∷ f32 + row.mass * r2)
        }
    }
    mut list<CurvePoint> curve ← empty
    # tot/residual folds are element-stream sums in index order; reduce keeps
    # that order byte-exact (carriers are construct-locked to their lengths).
    let f32 tot ← energy.reduce((f32 acc, f32 e) ∴ acc + e, 0.0)
    for range 0 ‥ k_max + 1 let ck {
        let f32 res ← residual_k[ck * slots ‥ (ck + 1) * slots].reduce((f32 acc, f32 r) ∴ acc + r, 0.0)
        mut f32 frac ← 0.0
        if tot ≻ 0.0 {
            frac ← res / tot
        }
        curve.append(CurvePoint { bases = ck, rank = 0, residual = frac })
    }
    mut int recommended ← k_max
    mut bool below ← false
    # Keep: first-K-satisfying scan with a one-way latch; argmin twins rank
    # values, not threshold predicates, and no first-index construct exists.
    for range 0 ‥ k_max + 1 let rk {
        let f32 frac ← (curve.get(rk) coalesce CurvePoint { bases = rk, rank = 0, residual = 1.0 }).residual
        if not below {
            if not (frac ≻ threshold) {
                recommended ← rk
                below ← true
            }
        }
    }
    mut list<ExpertEnergy> scores ← empty
    for range 0 ‥ corpus.layers let layer {
        for range 0 ‥ corpus.experts let expert {
            let int slot ← slot_index(layer, expert, corpus.experts)
            let f32 e_tot ← energy.get(slot) coalesce 0.0 ∷ f32
            let f32 e_res ← residual_k.get(recommended * slots + slot) coalesce 0.0 ∷ f32
            mut f32 score ← 0.0
            if e_tot ≻ 0.0 {
                score ← e_res / e_tot
            }
            scores.append(ExpertEnergy { layer = layer, expert = expert, residual = score, mass = mass.get(slot) coalesce 0.0 ∷ f32 })
        }
    }
    let list<SimilarityCell> census ← census_row(weighted, mass, corpus.layers, corpus.experts, dim)
    return ResidualEnergyArtifact { schema = SCHEMA, scores = scores, curve = curve, similarities = census, recommended_k = recommended, threshold = threshold, below_threshold = below, provenance = proven }
}

# --- Probe accessors -----------------------------------------------------
# Probes cannot type `.length()` on a cross-module `list<Class>` return,
# so these stay int-valued.
@ public
fn score_count(ResidualEnergyArtifact artifact) → int {
    return artifact.scores.length()
}

@ public
fn curve_count(ResidualEnergyArtifact artifact) → int {
    return artifact.curve.length()
}

@ public
fn similarity_count(ResidualEnergyArtifact artifact) → int {
    return artifact.similarities.length()
}

# Curve residual at K (0 if K is out of range). Used by probes so they
# never construct CurvePoint across the module boundary.
@ public
fn curve_residual(ResidualEnergyArtifact artifact, int k) → f32 {
    if k ≺ 0 or k ≥ artifact.curve.length() then return 0.0
    let CurvePoint p ← artifact.curve.get(k) coalesce CurvePoint { bases = k, rank = 0, residual = 0.0 }
    return p.residual
}

# Per-expert residual at the recommended K, by score-list index.
@ public
fn score_residual(ResidualEnergyArtifact artifact, int i) → f32 {
    if i ≺ 0 or i ≥ artifact.scores.length() then return 0.0
    let ExpertEnergy e ← artifact.scores.get(i) coalesce ExpertEnergy { layer = 0, expert = 0, residual = 0.0, mass = 0.0 }
    return e.residual
}

# Overlap-census cosine by cell index (upper-triangle order).
@ public
fn similarity_cosine(ResidualEnergyArtifact artifact, int i) → f32 {
    if i ≺ 0 or i ≥ artifact.similarities.length() then return 0.0
    let SimilarityCell c ← artifact.similarities.get(i) coalesce SimilarityCell { layer = 0, expert_a = 0, expert_b = 0, cosine = 0.0 }
    return c.cosine
}

# --- Verify --------------------------------------------------------------
# Load-time provenance check: the claimed digest must equal the independently
# known expected digest. Tampered claims fail closed.
@ public
fn verify(ResidualEnergyArtifact artifact, string expected) → ResidualEnergyArtifact ⇥ CalibrationError {
    require digest_ok(expected) throw variant DigestMalformed { message = "content digest must be 64 lower-case hexadecimal digits" }
    require artifact.provenance.digest ≡ expected throw variant DigestMismatch { message = "digest mismatch — residual-energy artifact does not match the expected digest" }
    return artifact
}

# --- Private helpers -----------------------------------------------------
fn digest_ok(string digest) → bool {
    if digest.length() ≢ 64 then return false
    for from digest let c {
        if not "0123456789abcdef".contains(c ↦ string) then return false
    }
    return true
}

fn provenance(string algorithm, string digest, int length, string corpus_digest, string base_digest) → Provenance ⇥ CalibrationError {
    require algorithm ≡ "sha-256" throw variant DigestMalformed { message = "unknown digest algorithm: §"(algorithm) }
    require digest_ok(digest) throw variant DigestMalformed { message = "content digest must be 64 lower-case hexadecimal digits" }
    require digest_ok(corpus_digest) throw variant DigestMalformed { message = "content digest must be 64 lower-case hexadecimal digits" }
    require digest_ok(base_digest) throw variant DigestMalformed { message = "content digest must be 64 lower-case hexadecimal digits" }
    require length ≻ 0 throw variant Invalid { message = "content length must be positive" }
    return Provenance { algorithm = algorithm, digest = digest, length = length, corpus_digest = corpus_digest, base_digest = base_digest }
}

# WARN027 keeper: fail-closed ordered require validation plus routing-mass
# scatter; no construct covers ordered failable validation.
fn validate_corpus(list<RoutingActivation> activations, int layers, int experts, int dimension) → bool ⇥ CalibrationError {
    require activations.length() ≢ 0 throw variant EmptyCorpus { message = "empty calibration corpus" }
    reject layers ≤ 0 or experts ≤ 0 or dimension ≤ 0 throw variant Invalid { message = "corpus counts must be positive" }
    let int slots ← layers * experts
    mut list<f32> mass ← zeros(slots)
    for from activations let row {
        reject row.layer ≺ 0 or row.layer ≥ layers throw variant ExpertRange { message = "layer id out of range" }
        reject row.expert ≺ 0 or row.expert ≥ experts throw variant ExpertRange { message = "expert id out of range" }
        require dtype.finite(row.mass) throw variant NonFinite { message = "non-finite calibration value" }
        require row.mass ≻ 0.0 throw variant Invalid { message = "routing mass must be positive" }
        require row.output.length() ≡ dimension throw variant DimensionMismatch { message = "output dimension does not match corpus" }
        require finite_vec(row.output) throw variant NonFinite { message = "non-finite calibration value" }
        let int slot ← slot_index(row.layer, row.expert, experts)
        mass ← put_f32(mass, slot, mass.get(slot) coalesce 0.0 ∷ f32 + row.mass)
    }
    for from mass let m {
        require m ≻ 0.0 throw variant ZeroRouting { message = "zero-routing expert" }
    }
    return true
}

# Keep: early-exit all-finite predicate; no all()-construct exists.
fn finite_vec(list<f32> xs) → bool {
    for from xs let v {
        if not dtype.finite(v) then return false
    }
    return true
}

fn slot_index(int layer, int expert, int experts) → int {
    return layer * experts + expert
}

# Keep: zero-fill counter walk — no fill/repeat construct exists.
fn zeros(int n) → list<f32> {
    mut list<f32> out ← empty
    for range 0 ‥ n let _ {
        out.append(0.0)
    }
    return out
}

# Keep: index-space in-place write emulation; no covering construct.
fn put_f32(list<f32> xs, int i, f32 v) → list<f32> {
    mut list<f32> out ← empty
    for range 0 ‥ xs.length() let j {
        if j ≡ i {
            out.append(v)
        }
        else {
            out.append(xs.get(j) coalesce 0.0 ∷ f32)
        }
    }
    return out
}

# Keep: index-space pair fold over two carriers; reduce sees one stream.
fn dot(list<f32> a, list<f32> b) → f32 {
    mut f32 s ← 0.0
    for range 0 ‥ a.length() let i {
        s ← s + a.get(i) coalesce 0.0 ∷ f32 * b.get(i) coalesce 0.0 ∷ f32
    }
    return s
}

fn norm2(list<f32> xs) → f32 {
    return dot(xs, xs)
}

fn sqrt(f32 x) → f32 {
    if x ≤ 0.0 then return 0.0
    mut f32 guess ← x / 2.0
    # denormal x can halve to 0.0 — restart the iteration from x
    if guess ≤ 0.0 {
        guess ← x
    }
    for range 0 ‥ 12 let _ {
        guess ← (guess + x / guess) / 2.0
    }
    return guess
}

fn scale(list<f32> xs, f32 s) → list<f32> {
    return xs.map(f32 v ∴ v * s)
}

# Keep: zip walk over two carriers by index; no zip construct covers a
# two-list elementwise transform.
fn sub_scale(list<f32> xs, list<f32> ys, f32 s) → list<f32> {
    mut list<f32> out ← empty
    for range 0 ‥ xs.length() let i {
        out.append(xs.get(i) coalesce 0.0 ∷ f32 - s * ys.get(i) coalesce 0.0 ∷ f32)
    }
    return out
}

fn orthonormal(list<list<f32>> bases, int dimension) → list<list<f32>> ⇥ CalibrationError {
    mut list<list<f32>> qs ← empty
    for from bases let raw {
        require raw.length() ≡ dimension throw variant DimensionMismatch { message = "output dimension does not match corpus" }
        require finite_vec(raw) throw variant NonFinite { message = "non-finite calibration value" }
        mut list<f32> v ← copy raw
        for from qs let q {
            v ← sub_scale(v, q, dot(v, q))
        }
        let f32 n2 ← norm2(v)
        require n2 ≻ 0.0 throw variant BasisInvalid { message = "candidate basis is empty or linearly dependent" }
        let f32 n ← sqrt(n2)
        qs.append(scale(v, 1.0 / n))
    }
    return qs
}

# Keep: per-element projection squared; a reducer would double-evaluate
# dot per element.
fn residual2(list<f32> y, list<list<f32>> qs, int k) → f32 {
    mut f32 captured ← 0.0
    for range 0 ‥ k let i {
        let list<f32> vac ← empty
        let list<f32> q ← qs.get(i) coalesce vac
        let f32 proj ← dot(y, q)
        captured ← captured + proj * proj
    }
    let f32 n2 ← norm2(y)
    let f32 left ← n2 - captured
    if left ≺ 0.0 then return 0.0
    return left
}

fn census_row(list<f32> weighted, list<f32> mass, int layers, int experts, int dim) → list<SimilarityCell> {
    mut list<SimilarityCell> out ← empty
    for range 0 ‥ layers let layer {
        for range 0 ‥ experts let a {
            for range a ‥ experts let b {
                out.append(SimilarityCell { layer = layer, expert_a = a, expert_b = b, cosine = cosine(weighted, mass, layer, a, b, experts, dim) })
            }
        }
    }
    return out
}

# Keep: triple accumulator (dot, na, nb) over one index space; no
# construct folds three streams at once.
fn cosine(list<f32> weighted, list<f32> mass, int layer, int a, int b, int experts, int dim) → f32 {
    let int sa ← slot_index(layer, a, experts)
    let int sb ← slot_index(layer, b, experts)
    let f32 ma ← mass.get(sa) coalesce 0.0 ∷ f32
    let f32 mb ← mass.get(sb) coalesce 0.0 ∷ f32
    if not (ma ≻ 0.0) then return 0.0
    if not (mb ≻ 0.0) then return 0.0
    mut f32 dot ← 0.0
    mut f32 na ← 0.0
    mut f32 nb ← 0.0
    for range 0 ‥ dim let d {
        let f32 va ← weighted.get(sa * dim + d) coalesce 0.0 ∷ f32 / ma
        let f32 vb ← weighted.get(sb * dim + d) coalesce 0.0 ∷ f32 / mb
        dot ← dot + va * vb
        na ← na + va * va
        nb ← nb + vb * vb
    }
    let f32 denom ← sqrt(na) * sqrt(nb)
    if not (denom ≻ 0.0) then return 0.0
    return dot / denom
}
