+++
locale = "en"
+++
# Co-located package test for decode_step.fab (A1-PORT-1: lane-form decode-step
# kernels). Not importable; discovered only by the faber test path:
#
#   faber test --include decode_step --device cpu
#
# With `--device cpu` the proba route runs each `@ kernel` in host form on the
# sequential oracle, so every row below executes the kernel body and compares
# against a hand-computed expectation. The real-shape Metal == cpu pin lives in
# radix/acceptance/a1-decode-parts (hardware test), not here.

import from "gradus:decode_step" ds

fn close(f32 a, f32 b) → bool {
    return (a - b).abs() ≺ 0.0001
}

test "decode_step gather_row copies the embedding row named by ids[0]" {
    var tensor<f32, [4]> dom ← tf32[4] {}
    var tensor<f32, [3, 4]> table ← tf32[3, 4] {}
    var tensor<i32, [1]> ids ← tensor<i32, [1]> {}
    var tensor<f32, [4]> out ← tf32[4] {}
    for range 0‥3 const r {
        for range 0‥4 const c {
            table[[r, c]] ← (r * 10 + c) ↦ f32
        }
    }
    ids[0] ← 2
    ds.gather_row(dom, table, ids, mut out)
    assert close(out[[0]], 20.0)
    assert close(out[[1]], 21.0)
    assert close(out[[2]], 22.0)
    assert close(out[[3]], 23.0)
}

test "decode_step rms_stats and rms_apply normalise one row" {
    var tensor<f32, [1]> dom ← tf32[1] {}
    var tensor<f32, [4]> x ← tf32[4] {}
    var tensor<f32, [4]> w ← tf32[4] {}
    var tensor<f32, [1]> st ← tf32[1] {}
    var tensor<f32, [4]> out ← tf32[4] {}
    x[[0]] ← 1.0
    x[[1]] ← 2.0
    x[[2]] ← 3.0
    x[[3]] ← 4.0
    w[[0]] ← 1.0
    w[[1]] ← 1.0
    w[[2]] ← 2.0
    w[[3]] ← 2.0
    ds.rms_stats(dom, x, mut st, 4, 0.0)
    ds.rms_apply(x, st, w, mut out)
    # mean(x^2) = 7.5, 1 / sqrt(7.5) = 0.3651484
    assert close(st[[0]], 0.3651484)
    assert close(out[[0]], 0.3651484)
    assert close(out[[1]], 0.7302967)
    assert close(out[[2]], 2.1908903)
    assert close(out[[3]], 2.9211872)
}

test "decode_step gemv_lane is one serial dot per output row" {
    var tensor<f32, [2]> dom ← tf32[2] {}
    var tensor<f32, [2, 3]> w ← tf32[2, 3] {}
    var tensor<f32, [3]> x ← tf32[3] {}
    var tensor<f32, [2]> out ← tf32[2] {}
    for range 0‥2 const r {
        for range 0‥3 const c {
            w[[r, c]] ← (r * 3 + c + 1) ↦ f32
        }
    }
    x[[0]] ← 1.0
    x[[1]] ← 0.0
    x[[2]] ← -1.0
    ds.gemv_lane(dom, w, x, mut out, 3)
    assert close(out[[0]], -2.0)
    assert close(out[[1]], -2.0)
}

test "decode_step rope_half rotates the (j, j + span) pairs of each head" {
    var tensor<f32, [4]> x ← tf32[4] {}
    var tensor<f32, [4]> out ← tf32[4] {}
    x[[0]] ← 1.0
    x[[1]] ← 2.0
    ds.rope_half(x, mut out, 1, 2, 0.0)
    # ln_theta 0 gives frequency 1: every pair rotates by angle 1.
    assert close(out[[0]], 0.5403023)
    assert close(out[[1]], 1.0806046)
    assert close(out[[2]], 0.841471)
    assert close(out[[3]], 1.682942)
    # Position 0 is the identity.
    ds.rope_half(x, mut out, 0, 2, 0.0)
    assert close(out[[0]], 1.0)
    assert close(out[[1]], 2.0)
    assert close(out[[2]], 0.0)
    assert close(out[[3]], 0.0)
}

test "decode_step kv_write replaces only row pos" {
    var tensor<f32, [3, 2]> cache ← tf32[3, 2] {}
    var tensor<f32, [2]> row ← tf32[2] {}
    var tensor<f32, [3, 2]> out ← tf32[3, 2] {}
    for range 0‥3 const r {
        for range 0‥2 const c {
            cache[[r, c]] ← (r * 2 + c) ↦ f32
        }
    }
    row[[0]] ← 100.0
    row[[1]] ← 101.0
    ds.kv_write(cache, row, mut out, 1)
    assert close(out[[0, 0]], 0.0)
    assert close(out[[0, 1]], 1.0)
    assert close(out[[1, 0]], 100.0)
    assert close(out[[1, 1]], 101.0)
    assert close(out[[2, 0]], 4.0)
    assert close(out[[2, 1]], 5.0)
}

test "decode_step softmax_stats and softmax_apply normalise a row" {
    var tensor<f32, [1]> dom ← tf32[1] {}
    var tensor<f32, [1, 3]> s ← tf32[1, 3] {}
    var tensor<f32, [1]> mx ← tf32[1] {}
    var tensor<f32, [1]> sm ← tf32[1] {}
    var tensor<f32, [1, 3]> p ← tf32[1, 3] {}
    s[[0, 0]] ← 1.0
    s[[0, 1]] ← 2.0
    s[[0, 2]] ← 3.0
    ds.softmax_stats(dom, s, mut mx, mut sm, 3)
    ds.softmax_apply(s, mx, sm, mut p)
    assert close(mx[[0]], 3.0)
    assert close(sm[[0]], 1.5032147)
    assert close(p[[0, 0]], 0.0900306)
    assert close(p[[0, 1]], 0.2447285)
    assert close(p[[0, 2]], 0.6652410)
}

test "decode_step GQA decode attention masks past pos and shares a KV head" {
    # 2 query heads of dh 2 share one KV head (group 2); 3 cache rows, pos 1.
    var tensor<f32, [2, 3]> hc ← tf32[2, 3] {}
    var tensor<f32, [4]> qdom ← tf32[4] {}
    var tensor<f32, [2]> hdom ← tf32[2] {}
    var tensor<f32, [4]> q ← tf32[4] {}
    var tensor<f32, [3, 2]> kc ← tf32[3, 2] {}
    var tensor<f32, [3, 2]> vc ← tf32[3, 2] {}
    var tensor<f32, [2, 3]> sc ← tf32[2, 3] {}
    var tensor<f32, [2]> mx ← tf32[2] {}
    var tensor<f32, [2]> sm ← tf32[2] {}
    var tensor<f32, [2, 3]> p ← tf32[2, 3] {}
    var tensor<f32, [4]> ctx ← tf32[4] {}
    q[[0]] ← 1.0
    q[[3]] ← 1.0
    kc[[0, 0]] ← 1.0
    kc[[1, 1]] ← 1.0
    kc[[2, 0]] ← 5.0
    kc[[2, 1]] ← 5.0
    vc[[0, 0]] ← 1.0
    vc[[1, 1]] ← 1.0
    vc[[2, 0]] ← 9.0
    vc[[2, 1]] ← 9.0
    ds.attn_scores(hc, q, kc, mut sc, 1, 2, 2, 1.0)
    assert close(sc[[0, 0]], 1.0)
    assert close(sc[[0, 1]], 0.0)
    assert close(sc[[1, 0]], 0.0)
    assert close(sc[[1, 1]], 1.0)
    assert sc[[0, 2]] ≺ -1.0e29
    ds.softmax_stats(hdom, sc, mut mx, mut sm, 3)
    ds.softmax_apply(sc, mx, sm, mut p)
    # e / (1 + e) = 0.7310586 on the larger score, 0 on the masked column.
    assert close(p[[0, 0]], 0.7310586)
    assert close(p[[0, 1]], 0.2689414)
    assert close(p[[0, 2]], 0.0)
    ds.attn_context(qdom, p, vc, mut ctx, 1, 2, 2)
    assert close(ctx[[0]], 0.7310586)
    assert close(ctx[[1]], 0.2689414)
    assert close(ctx[[2]], 0.2689414)
    assert close(ctx[[3]], 0.7310586)
}

test "decode_step residual_add and swiglu are elementwise" {
    var tensor<f32, [2]> a ← tf32[2] {}
    var tensor<f32, [2]> b ← tf32[2] {}
    var tensor<f32, [2]> sum ← tf32[2] {}
    var tensor<f32, [2]> act ← tf32[2] {}
    a[[0]] ← 0.0
    a[[1]] ← 1.0
    b[[0]] ← 2.0
    b[[1]] ← 3.0
    ds.residual_add(a, b, mut sum)
    ds.swiglu(a, b, mut act)
    assert close(sum[[0]], 2.0)
    assert close(sum[[1]], 4.0)
    # silu(0) = 0; silu(1) = 0.7310586, times 3.
    assert close(act[[0]], 0.0)
    assert close(act[[1]], 2.1931758)
}
