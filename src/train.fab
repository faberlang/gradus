+++
locale = "en"
+++
# Training facade — warmup+cosine schedule, train/eval mode, RNG, dropout,
# and checkpoint envelope (PML4).
#
# Public import: import from "gradus:train" train
# Depends on: gradus:dtype (finite), gradus:tensor (value carrier).
#
# This module does not own an epoch loop or metrics. Metrics live in
# gradus:metrics. The admitted parameter update is SGD
# (param' = param − lr·grad); optimizer state lives in gradus:optimize.
# Learning-rate schedules live here.
#
# The generic SGD update (param' = param − lr·grad) lives in
# gradus:optimize as `sgd_step`. This module owns schedules, train/eval mode,
# RNG, dropout, and checkpoint envelopes; it does not specialize updates for
# a model or fixture.
#
# Architectural rule: the training step is reusable across models. It must not
# import from a specific model definition. A model definition does not own its
# training step. No module owns a backend or device handle.
#
import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

# =========================================================================
# PML4-U4 — Schedules + train/eval mode (explicit public controls)
# =========================================================================
#
# --- Contract (pml4-delivery.md PML4-U4) ---------------------------------
# Two explicit public controls for a training run:
#
#   1. Schedule — the learning-rate schedule (warmup + cosine decay, the
#      accepted training-proof default). A pure config + one pure
#      evaluation, deterministic (no RNG, no hidden state):
#
#        lr(step) = vertex · step/warmup                      step < warmup
#        lr(step) = end + (vertex − end)·(1+cos(π·t))/2   step ≥ warmup
#      with t = (step − warmup)/(total − warmup) ∈ [0, 1], clamped to the
#      horizon (post-horizon lr = end). A degenerate horizon
#      (total == warmup) is constant at the vertex. The schedule's lr at
#      step k is the lr the loop binds into the parameter's SgdState
#      (U3, rate) before step — the loop composition is U6's.
#
#   2. Mode — train/eval mode (the dropout/RNG policy gate). Explicit
#      mode argument only: forward evaluation consults the mode it is
#      CALLED with — no hidden global state (the shared-layer rule,
#      council "forward-functions-first"). In eval mode dropout is
#      identity (effective rate 0); in train mode the effective rate is
#      the configured rate. The stochastic dropout mask is generated from
#      an explicit RNG state — the U5 seed/RNG seam; the MODE CONTROL and
#      its deterministic rate policy are this unit's.
#
# --- Shared with the GPU-training lane's accepted facts -----------------
#   * warmup + cosine is the schedule default per the pml4 delivery open
#     questions ("default: warmup + cosine per accepted training proof").
#   * lr = 0.01 is the accepted MLP training proof's constant; the
#     schedule's peak (vertex) is the same lr the optimizer state (U3)
#     carries per parameter.
#   * dropout rate domain [0, 1] (fraction of units omitted); eval = no
#     dropout (the standard evaluation-policy identity).
#
# --- Evidence honesty (CTO Q2, hard) ------------------------------------
# This surface is the STRUCTURAL proof: the controls are pure functions
# (explicit arguments, deterministic, no hidden state) and are
# compile-validated + proven by the co-located proba. Executed VALUE
# identity (a schedule's numeric lr, the f32 cosine self-hosting vs the
# f64 oracle) remains deferred. Library-to-library calls execute on the
# FMIR stepper (radix 43c0102ba; regression-locked by 2e8042ae7).
# PML4-U4 is PARTIAL: schedule and policy numeric identity is deferred
# to a runtime-evidence gate
# (auditor-owned faber test path; oracle pins recorded in train.proba).

# -------------------------------------------------------------------------
# TrainError — typed error vocabulary of the training-loop controls.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------


@ public
union TrainError {
    @ shared
    string message

    InvalidSchedule,
    UnknownMode,
    InvalidDropout,
    NegativeStep,
    InvalidSeed,
    BadPayload,
    InvalidPosition,
    EmptyState,
    UnknownVersion,
    BadWire,
    TensorFailure {
        tensor.TensorError inner
    }
}

@ conversion
fn from_tensor_error(tensor.TensorError err) → TrainError {
    return variant TensorFailure { message = err.message, inner = err }
}



# -------------------------------------------------------------------------
# Schedule — the learning-rate schedule config (warmup + cosine decay).
#   rate_vertex — peak lr at the end of warmup (the lr the U3 state
#                   slot carries at the peak);
#   warmup     — warmup steps (linear ramp 0 → vertex);
#   total_steps  — total scheduled steps (the decay horizon);
#   rate_end  — final lr after the cosine decay (≤ vertex).
# Construction fail-closed: finite non-negative rates, end ≤ vertex,
# non-negative warmup, horizon ≥ 1 and ≥ warmup.
# -------------------------------------------------------------------------


@ public
class Schedule {
    f32 rate_vertex
    int warmup
    int total_steps
    f32 rate_end
}

@ public
fn construct_schedule(f32 rate_vertex, int warmup, int total_steps, f32 rate_end) → Schedule ⇥ TrainError {
    require dtype.finite(rate_vertex) throw variant InvalidSchedule { message = "invalid peak learning rate" }
    require rate_vertex ≥ 0.0 throw variant InvalidSchedule { message = "invalid peak learning rate" }
    require dtype.finite(rate_end) throw variant InvalidSchedule { message = "invalid final learning rate" }
    require rate_end ≥ 0.0 throw variant InvalidSchedule { message = "invalid final learning rate" }
    require rate_end ≤ rate_vertex throw variant InvalidSchedule { message = "final learning rate above peak" }
    require warmup ≥ 0 throw variant InvalidSchedule { message = "negative warmup steps" }
    require total_steps ≥ 1 throw variant InvalidSchedule { message = "schedule horizon must be at least one step" }
    require total_steps ≥ warmup throw variant InvalidSchedule { message = "warmup exceeds the schedule horizon" }
    return Schedule { rate_vertex = rate_vertex, warmup = warmup, total_steps = total_steps, rate_end = rate_end }
}

# Placeholder Default for `var Schedule` bindings (varia on structs).
# Zero rates/horizon (not a valid schedule). Only a placeholder the
# caller overwrites, or returns from an unreachable cape arm.
@ public
fn default_schedule() → Schedule {
    return Schedule { rate_vertex = 0.0, warmup = 0, total_steps = 0, rate_end = 0.0 }
}

# π — the cosine-decay phase constant.
const f32 PI ← 3.141592653589793 ∷ f32

# cos via Taylor series. The schedule's phase is always in [0, π] (t ∈
# [0, 1]), so no range reduction is needed; 12 terms leave the remainder
# below f32 precision over that range (the attention.fab _cos
# precedent). At the horizon the series may undershoot by < 1e-4; the
# evaluation clamps the result to the true [end, vertex] range.
fn _cos(f32 x) → f32 {
    var f32 term ← 1.0
    var f32 sum ← 1.0
    const f32 x2 ← x * x
    for range 1‥12 const n {
        term ← (term * (0.0 - x2)) / (((2 * n - 1) ↦ f32) * (2 * n ↦ f32))
        sum ← sum + term
    }
    return sum
}

# -------------------------------------------------------------------------
# scheduled_rate — the schedule evaluation: the deterministic learning
# rate at a step (warmup + cosine decay, see the contract above). Pure:
# explicit Schedule + step in, lr out; no RNG, no hidden state.
# -------------------------------------------------------------------------

@ public
fn scheduled_rate(Schedule s, int step) → f32 ⇥ TrainError {
    require step ≥ 0 throw variant NegativeStep { message = "schedule step must be non-negative" }
    if step ≺ s.warmup then return s.rate_vertex * ((step ↦ f32) / (s.warmup ↦ f32))
    var int step_eff ← step
    if step_eff ≻ s.total_steps {
        step_eff ← s.total_steps
    }
    if s.total_steps ≻ s.warmup {
        const f32 t ← ((step_eff - s.warmup) ↦ f32) / ((s.total_steps - s.warmup) ↦ f32)
        const f32 phase ← PI * t
        var f32 lr ← s.rate_end + ((s.rate_vertex - s.rate_end) * (1.0 + _cos(phase))) / 2.0
        if lr ≺ s.rate_end {
            lr ← s.rate_end
        }
        if lr ≻ s.rate_vertex {
            lr ← s.rate_vertex
        }
        return lr
    }
    return s.rate_vertex
}

# -------------------------------------------------------------------------
# Mode — train/eval mode. An EXPLICIT argument to any mode-dependent
# call: forward evaluation consults the mode it is called with, never a
# hidden global (the shared-layer rule). Names are the wire contract:
# "train" | "eval".
# -------------------------------------------------------------------------


@ public
union Mode {
    Discipline,
    Estimate
}

# Canonical mode name (text surface for consumers).
@ public
fn mode_name(Mode m) → string {
    match m {
        case Discipline {
            return "train"
        }
        case Estimate {
            return "eval"
        }
    }
}

@ public
fn is_discipline(Mode m) → bool {
    match m {
        case Discipline {
            return true
        }
        case Estimate {
            return false
        }
    }
}

@ public
fn is_estimate(Mode m) → bool {
    return not is_discipline(m)
}

# Construct a mode from its canonical name — fail closed on an unknown
# name (the string entry; enum variants do not cross module
# boundaries, dtype.fab SEM001 note).
@ public
fn mode(string name) → Mode ⇥ TrainError {
    if name ≡ "train" then return variant Discipline
    if name ≡ "eval" then return variant Estimate
    throw variant UnknownMode { message = "unknown mode name" }
}

# -------------------------------------------------------------------------
# dropout_probability — the dropout/RNG policy gate. The effective dropout rate
# for a forward evaluation called with an explicit mode: eval → 0 (no
# dropout — the standard evaluation identity), train → the configured
# rate. The rate domain is [0, 1] (finite, fail closed). The stochastic
# mask applied at the effective rate comes from an explicit RNG state —
# the U5 seed/RNG seam; the deterministic mode gate is this unit's.
# -------------------------------------------------------------------------

@ public
fn dropout_probability(Mode m, f32 rate) → f32 ⇥ TrainError {
    require dtype.finite(rate) throw variant InvalidDropout { message = "dropout rate must be in [0, 1]" }
    require rate ≥ 0.0 throw variant InvalidDropout { message = "dropout rate must be in [0, 1]" }
    require rate ≤ 1.0 throw variant InvalidDropout { message = "dropout rate must be in [0, 1]" }
    if is_estimate(m) then return 0.0 ∷ f32
    return rate
}

# =========================================================================
# PML4-U5 — Seeds (RNG) and checkpoint resume (pml4-delivery.md U5)
# =========================================================================
#
# --- Contract ------------------------------------------------------------
# Two pieces close this module's reproducibility contract (metrics live
# in gradus:metrics, not here):
#
#   1. Seed — the seed/RNG state (this unit owns the machinery U4's
#      dropout gate composes with). A xorshift64 generator (shifts + XOR
#      only, no multiply — no overflow concerns) over a nonzero i64
#      state; deterministic: the same seed produces the same sequence.
#      next() draws the next 64-bit value and advances the state;
#      next_f32() maps a draw to [0, 1) (sign-masked, top 52 bits,
#      uniform over the masked space — the f32 [0,1) contract). dropout()
#      is the dropout-mask composition: it takes the effective rate from
#      dropout_probability (U4) — eval mode is identity and the RNG is left
#      untouched — and in train mode applies a per-element Bernoulli mask
#      scaled by 1/(1−rate) (inverted dropout, so the eval identity
#      composes exactly). Deterministic given (tensor, seed, mode, rate).
#
#   2. Checkpoint — the checkpoint: epoch + step + RNG state + the U3
#      optimizer-state wire (carried VERBATIM — the envelope stays
#      autograd-free; the state wire is validated by its own schema,
#      optimize.deserialize, at resume). Versioned wire round-trip
#      ("train/checkpoint/1.0.0/<epoch>/<step>/<rng_state>/<state_wire>");
#      interrupted-resume failure is EXPLICIT: a truncated/malformed
#      checkpoint wire, an unknown schema, an invalid epoch/step, a zero
#      RNG state, or a missing state wire all fail closed at
#      deserialization; a corrupt embedded state wire fails closed at
#      optimize.deserialize (resume).
#
# --- Shared with the GPU-training lane's accepted facts -----------------
#   * checkpoint resume (state + RNG + epoch/step) versioned per the U3
#     wire precedent (slot wire, lossless float form, '/' and ';'
#     reserved); same fail-closed posture (capsule rule).
#   * dropout mask semantics: per-element Bernoulli(1−rate), scaled by
#     1/(1−rate) in train (inverted dropout) — the standard training
#     policy the U4 dropout_probability gate controls.
#
# --- Evidence honesty (CTO Q2, hard) ------------------------------------
# This surface is the STRUCTURAL proof: the generator recurrence, the
# mask policy, and the checkpoint round-trip are compile-validated and
# proven by the co-located proba (f64 oracle pins for the xorshift
# recurrence, the [0,1) draws, and a concrete dropout-mask output).
# Executed VALUE identity for this section remains deferred.
# Library-to-library calls execute on the FMIR stepper (radix 43c0102ba;
# regression-locked by 2e8042ae7). PML4-U5 is PARTIAL: numeric identity
# is deferred to a runtime-evidence gate (auditor-owned faber
# test path; oracle pins recorded in train.proba).

# Schema version of this module's wire forms (rng, checkpoint).
const string schema_version ← "1.0.0"

# -------------------------------------------------------------------------
# Seed — the deterministic RNG state. A xorshift64 state (nonzero i64);
# the same seed reproduces the same sequence (reproducibility).
# -------------------------------------------------------------------------


@ public
class Seed {
    int status
}

# Seed the generator. Zero is rejected fail-closed (xorshift64 maps 0 → 0).
@ public
fn construct_seed(int seed) → Seed ⇥ TrainError {
    require seed ≠ 0 throw variant InvalidSeed { message = "seed must be non-zero" }
    return Seed { status = seed }
}

# Placeholder Default for `var Seed` bindings (varia on structs).
# Status 0 (not a valid seed — xorshift64 degenerates at 0). Only a
# placeholder the caller overwrites, or returns from an unreachable cape arm.
@ public
fn default() → Seed {
    return Seed { status = 0 }
}

# One RNG draw: the next 64-bit value + the advanced state.

@ public
class Draw {
    int payload
    Seed seed
}

# xorshift64 step: x ^= x<<13; x ^= x>>7; x ^= x<<17. Shifts + XOR only —
# no multiply, no overflow concerns. Bitwise on the i64 carrier.
@ public
fn next(Seed s) → Draw {
    var int x ← s.status
    x ← x ⊻ x ⇐ 13
    x ← x ⊻ x ⇒ 7
    x ← x ⊻ x ⇐ 17
    return Draw { payload = x, seed = Seed { status = x } }
}

# Sign-bit mask: the [0,1) draw uses only the low 63 bits (sign-agnostic).
const int MASK_63 ← 9223372036854775807

# 2^52 as f32 (exact power of two) — the draw denominator.
const f32 POW2_52 ← 4503599627370496.0 ∷ f32

# One f32 draw in [0, 1): the top 52 bits of the sign-masked state over
# 2^52. Uniform over the masked space; deterministic (same seed → same
# draws). f32 rounding is ~1e-7 — the proba pins compare within 1e-6.

@ public
class DrawF32 {
    f32 payload
    Seed seed
}

@ public
fn next_f32(Seed s) → DrawF32 {
    const Draw f ← next(s)
    const f32 v ← (((f.payload ∧ MASK_63) ⇒ 11) ↦ f32) / POW2_52
    return DrawF32 { payload = v, seed = f.seed }
}

# -------------------------------------------------------------------------
# dropout — the dropout-mask composition (the U5 machinery the U4
# dropout_probability gate controls). Eval mode (or rate 0) is identity and the
# RNG is untouched — the standard evaluation policy, deterministic. Train
# mode applies a per-element Bernoulli(1−rate) mask scaled by 1/(1−rate)
# (inverted dropout): x_i ← x_i·m_i/(1−rate), m_i = 1 if r_i ≥ rate.
# The mask is drawn from the explicit Seed state, which advances; the
# same (tensor, seed, mode, rate) reproduces the same output.
# -------------------------------------------------------------------------


@ public
class Dropout {
    tensor.NumericBlock payload
    Seed seed
}

@ public
fn dropout(tensor.NumericBlock x, Seed s, Mode m, f32 rate) → Dropout ⇥ TrainError {
    const f32 par ← dropout_probability(m, rate)
    if par ≡ 0.0 ∷ f32 then return Dropout { payload = x, seed = s }
    const f32 scale ← 1.0 / (1.0 - par)
    const list<f32> data ← x.data
    var list<f32> out ← empty
    var Seed s2 ← s
    for from data const v {
        const DrawF32 f ← next_f32(s2)
        s2 ← f.seed
        if f.payload ≥ par {
            out.append(v * scale)
        }
        else {
            out.append(0.0 ∷ f32)
        }
    }
    var tensor.NumericBlock updated ← tensor.default()
    updated ← tensor.construct(out, x.shape)
    return Dropout { payload = updated, seed = s2 }
}

# -------------------------------------------------------------------------
# RNG wire — versioned, exact round-trip.
# -------------------------------------------------------------------------

@ public
fn serialize_seed(Seed s) → string {
    return "train/rng/§/§"(schema_version, s.status ↦ string)
}

@ public
fn deserialize_seed(string wire) → Seed ⇥ TrainError {
    const list<string> parts ← wire.split("/")
    require parts.length() ≡ 4 throw variant BadWire { message = "malformed rng wire" }
    require parts.get(0) coalesce "" ≡ "train" throw variant BadWire { message = "unknown rng marker" }
    require parts.get(1) coalesce "" ≡ "rng" throw variant BadWire { message = "unknown rng marker" }
    require parts.get(2) coalesce "" ≡ schema_version throw variant UnknownVersion { message = "unknown rng schema version" }
    const string status_text ← parts.get(3) coalesce ""
    require status_text.length() ≠ 0 throw variant BadWire { message = "malformed rng state" }
    var int status ← 0
    do {
        status ↤ status_text
    }
    catch err {
        throw variant BadWire { message = "malformed rng state" }
    }
    return construct_seed(status)
}

# -------------------------------------------------------------------------
# Checkpoint — the checkpoint: epoch + step + RNG state + the optimizer-state
# wire (U3, carried verbatim). The envelope is autograd-free; the state
# wire validates against ITS OWN schema at resume (optimize.deserialize).
# -------------------------------------------------------------------------


@ public
class Checkpoint {
    # Epoch.
    int age
    # Step within the epoch.
    int step
    Seed rng
    # Embedded optimizer-state wire, carried verbatim.
    string state_wire
}

# Build a checkpoint. Epoch/step are non-negative; the state wire is
# non-empty (fail closed). The RNG is already a validated Seed.
@ public
fn construct_checkpoint(int age, int step, Seed rng, string state_wire) → Checkpoint ⇥ TrainError {
    require age ≥ 0 throw variant InvalidPosition { message = "epoch must be non-negative" }
    require step ≥ 0 throw variant InvalidPosition { message = "step must be non-negative" }
    require state_wire.length() ≠ 0 throw variant EmptyState { message = "checkpoint state wire is empty" }
    return Checkpoint { age = age, step = step, rng = rng, state_wire = state_wire }
}

# Placeholder Default for `var Checkpoint` bindings (varia on structs).
# Empty wire and an empty seed (not a valid checkpoint). Only a
# placeholder the caller overwrites, or returns from an unreachable cape arm.
@ public
fn default_checkpoint() → Checkpoint {
    return Checkpoint { age = 0, step = 0, rng = default(), state_wire = "" }
}

# Field-wise checkpoint equality — the round-trip predicate.
@ public
fn checkpoint_equal(Checkpoint a, Checkpoint b) → bool {
    if a.age ≠ b.age then return false
    if a.step ≠ b.step then return false
    if a.rng.status ≠ b.rng.status then return false
    if a.state_wire ≠ b.state_wire then return false
    return true
}

# -------------------------------------------------------------------------
# Checkpoint wire — versioned, exact round-trip. The fixed prefix carries
# marker/schema/epoch/step/rng-state; the embedded optimizer-state wire is
# the '/' tail (joined verbatim from the trailing segments).
# -------------------------------------------------------------------------

@ public
fn serialize_checkpoint(Checkpoint c) → string {
    return "train/checkpoint/§/§/§/§/§"(schema_version, c.age ↦ string, c.step ↦ string, c.rng.status ↦ string, c.state_wire)
}

# All-digits predicate for wire integer fields (epoch, step).
fn _digit(string c) → bool {
    const string text ↤ c
    return text between "0123456789"
}

fn _numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    for from s const c {
        if not _digit(c ↦ string) then return false
    }
    return true
}

@ public
fn deserialize_checkpoint(string wire) → Checkpoint ⇥ TrainError {
    const list<string> parts ← wire.split("/")
    require parts.length() ≥ 7 throw variant BadWire { message = "malformed checkpoint wire" }
    require parts.get(0) coalesce "" ≡ "train" throw variant BadWire { message = "unknown checkpoint marker" }
    require parts.get(1) coalesce "" ≡ "checkpoint" throw variant BadWire { message = "unknown checkpoint marker" }
    require parts.get(2) coalesce "" ≡ schema_version throw variant UnknownVersion { message = "unknown checkpoint schema version" }
    const string age_text ← parts.get(3) coalesce ""
    const string step_text ← parts.get(4) coalesce ""
    require _numeric(age_text) throw variant BadWire { message = "malformed epoch in checkpoint wire" }
    require _numeric(step_text) throw variant BadWire { message = "malformed step in checkpoint wire" }
    var int age ← 0
    var int step ← 0
    do {
        age ↤ age_text
    }
    catch err {
        throw variant BadWire { message = "malformed epoch in checkpoint wire" }
    }
    do {
        step ↤ step_text
    }
    catch err {
        throw variant BadWire { message = "malformed step in checkpoint wire" }
    }
    const string status_text ← parts.get(5) coalesce ""
    require status_text.length() ≠ 0 throw variant BadWire { message = "malformed rng state in checkpoint wire" }
    var int status ← 0
    do {
        status ↤ status_text
    }
    catch err {
        throw variant BadWire { message = "malformed rng state in checkpoint wire" }
    }
    const Seed rng ← construct_seed(status)
    # The embedded optimizer-state wire is the '/' tail, joined verbatim.
    var string state_wire ← ""
    # legacy-L2: flat list carrier — tail assembly needs source indices; retain bounded range walk.
    for range 6 ‥ parts.length() const i {
        if i ≻ 6 {
            state_wire ← state_wire + "/"
        }
        state_wire ← state_wire + parts.get(i) coalesce ""
    }
    require state_wire.length() ≠ 0 throw variant EmptyState { message = "checkpoint state wire is empty" }
    return Checkpoint { age = age, step = step, rng = rng, state_wire = state_wire }
}
