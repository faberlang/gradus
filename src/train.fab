# Training loop facade.
#
# Public import: importa ex "gradus:train" privata train
#
# S4-A (gpu-training-lowering stage-4-delivery.md): first concrete
# static-shape training-step calls, bounded to the first two callers
# (linear regression 2×2, MLP 4×4). A training step owns the SGD update of
# the trainable parameters: explicit current parameters, explicit trainable
# gradients, and a scalar learning rate in; explicit tuple of updated
# parameters out. It does not own model forward or backward.
#
# S6-G1 (gpu-training-lowering stage-6-delivery.md): train_step_bert_linear
# + train_step_bert_layernorm covering the BERT-tiny 18-trainable set
# (6×[8,8] weights + 6×[8] biases + 6×[8] LN params). The per-step gradient
# slot count is 21 (18 trainable + the frozen input, dk_scale, and target);
# the frozen slots are the backward call's business, not the step's — the
# train_step_bert_* calls take the 18 trainable gradients, matching the S4-A
# explicit-trainable-gradient precedent. Biases are [8] per-channel (the
# S6-C2 addita_bias contract).
#
# SPLIT NOTE: a single 18-return train_step_bert is not expressible — the
# source-level `iuncta<...>` tuple type is capped at 16 type arguments
# (radix-parser PARSE040 iuncta_arity_exceeded). The 18-trainable step is
# therefore two calls: train_step_bert_linear (12 linear-projection params)
# + train_step_bert_layernorm (6 LayerNorm params). Callers apply both.
#
# KNOWN TOOLCHAIN CONSTRAINT: the update math is written inline (mirroring
# the retired optimize.sgd_step_* standalone defs — pml0-proof-api-ledger.md
# rows 10-11, retired at PML1-U6) instead of calling `optimize.sgd_step_*`,
# because the current FMIR stepper cannot resolve calls FROM a library
# function TO another library function ("FaberScript unsupported: provider
# sym#N"). The retired symbols' math is duplicated inline here; the inlined
# copies are the surviving surface (ledger rows 10-11 disposition).
# Package-to-library calls are linked fine; library-to-library calls are a
# recorded faber/radix runtime gap. Revisit when library cross-module calls
# execute in the stepper.
#
# Architectural rule: the training loop is reusable across models. It must not
# import from a specific model definition. A model definition does not own its
# training loop. No module owns a backend or device handle.
#
# PML0-U3 ledger disposition (pml0-proof-api-ledger.md, gradus 33df687) —
# executed at PML1-U6: train_step_2x2 and train_step_4x4 are ADMITTED as
# caller-backed public API (grep-verified live callers in package code):
#   train_step_2x2 row 16 — examples/training/linear-regression/src/train.fab:103
#   train_step_4x4 row 17 — examples/training/mlp/src/train.fab:162
# train_step_bert_linear / train_step_bert_layernorm are out of the ledger's
# fixed-shape scope (non-_2x2/_4x4/_2x8 names).

# -------------------------------------------------------------------------
# train_step_2x2 — SGD update of weight + bias (2×2 f32, linear regression)
#   param' = param − lr·grad   (same math as the retired optimize.sgd_step_2x2)
# -------------------------------------------------------------------------

functio train_step_2x2(
    tensor<f32, [2,2]> weight,
    tensor<f32, [2,2]> bias,
    tensor<f32, [2,2]> grad_weight,
    tensor<f32, [2,2]> grad_bias,
    f32 lr
) → iuncta<tensor<f32, [2,2]>, tensor<f32, [2,2]>> {
    fixum lista<numerus> shape_w ← weight.magnitudines()
    fixum lista<numerus> shape_b ← bias.magnitudines()
    fixum tensor<f32, []> seed ← vacua
    fixum tensor<f32, [2,2]> lr_fill_w ← seed.crea(lr, shape_w)
    fixum tensor<f32, [2,2]> lr_fill_b ← seed.crea(lr, shape_b)
    fixum tensor<f32, [2,2]> scaled_w ← grad_weight.multiplica(lr_fill_w)
    fixum tensor<f32, [2,2]> scaled_b ← grad_bias.multiplica(lr_fill_b)
    fixum tensor<f32, [2,2]> new_weight ← weight.subtrahe(scaled_w)
    fixum tensor<f32, [2,2]> new_bias   ← bias.subtrahe(scaled_b)
    redde iuncta<tensor<f32, [2,2]>, tensor<f32, [2,2]>> [new_weight, new_bias]
}

# -------------------------------------------------------------------------
# train_step_4x4 — SGD update of weight1 + bias1 + weight2 + bias2
# (4×4 f32, two-layer MLP)
# -------------------------------------------------------------------------

functio train_step_4x4(
    tensor<f32, [4,4]> weight1,
    tensor<f32, [4,4]> bias1,
    tensor<f32, [4,4]> weight2,
    tensor<f32, [4,4]> bias2,
    tensor<f32, [4,4]> grad_weight1,
    tensor<f32, [4,4]> grad_bias1,
    tensor<f32, [4,4]> grad_weight2,
    tensor<f32, [4,4]> grad_bias2,
    f32 lr
) → iuncta<tensor<f32, [4,4]>, tensor<f32, [4,4]>, tensor<f32, [4,4]>, tensor<f32, [4,4]>> {
    fixum lista<numerus> shape_w1 ← weight1.magnitudines()
    fixum lista<numerus> shape_b1 ← bias1.magnitudines()
    fixum lista<numerus> shape_w2 ← weight2.magnitudines()
    fixum lista<numerus> shape_b2 ← bias2.magnitudines()
    fixum tensor<f32, []> seed ← vacua
    fixum tensor<f32, [4,4]> lr_fill_w1 ← seed.crea(lr, shape_w1)
    fixum tensor<f32, [4,4]> lr_fill_b1 ← seed.crea(lr, shape_b1)
    fixum tensor<f32, [4,4]> lr_fill_w2 ← seed.crea(lr, shape_w2)
    fixum tensor<f32, [4,4]> lr_fill_b2 ← seed.crea(lr, shape_b2)
    fixum tensor<f32, [4,4]> scaled_w1 ← grad_weight1.multiplica(lr_fill_w1)
    fixum tensor<f32, [4,4]> scaled_b1 ← grad_bias1.multiplica(lr_fill_b1)
    fixum tensor<f32, [4,4]> scaled_w2 ← grad_weight2.multiplica(lr_fill_w2)
    fixum tensor<f32, [4,4]> scaled_b2 ← grad_bias2.multiplica(lr_fill_b2)
    fixum tensor<f32, [4,4]> new_weight1 ← weight1.subtrahe(scaled_w1)
    fixum tensor<f32, [4,4]> new_bias1   ← bias1.subtrahe(scaled_b1)
    fixum tensor<f32, [4,4]> new_weight2 ← weight2.subtrahe(scaled_w2)
    fixum tensor<f32, [4,4]> new_bias2   ← bias2.subtrahe(scaled_b2)
    redde iuncta<tensor<f32, [4,4]>, tensor<f32, [4,4]>, tensor<f32, [4,4]>, tensor<f32, [4,4]>> [new_weight1, new_bias1, new_weight2, new_bias2]
}

# -------------------------------------------------------------------------
# train_step_bert_linear — SGD update of the 12 linear-projection BERT-tiny
#   trainable params (6×[8,8] weights + 6×[8] biases)
#   param' = param − lr·grad   (same math as the retired optimize.sgd_step_*)
#   12 explicit current params + 12 explicit trainable gradients + lr in;
#   explicit 12-tuple of updated params out, in the fragment's slot order
#   (wq,bq,wk,bk,wv,bv,wo,bo,wf1,bf1,wf2,bf2).
# -------------------------------------------------------------------------

functio train_step_bert_linear(
    tensor<f32, [8,8]> wq,   tensor<f32, [8]> bq,
    tensor<f32, [8,8]> wk,   tensor<f32, [8]> bk,
    tensor<f32, [8,8]> wv,   tensor<f32, [8]> bv,
    tensor<f32, [8,8]> wo,   tensor<f32, [8]> bo,
    tensor<f32, [8,8]> wf1,  tensor<f32, [8]> bf1,
    tensor<f32, [8,8]> wf2,  tensor<f32, [8]> bf2,
    tensor<f32, [8,8]> gwq,  tensor<f32, [8]> gbq,
    tensor<f32, [8,8]> gwk,  tensor<f32, [8]> gbk,
    tensor<f32, [8,8]> gwv,  tensor<f32, [8]> gbv,
    tensor<f32, [8,8]> gwo,  tensor<f32, [8]> gbo,
    tensor<f32, [8,8]> gwf1, tensor<f32, [8]> gbf1,
    tensor<f32, [8,8]> gwf2, tensor<f32, [8]> gbf2,
    f32 lr
) → iuncta<tensor<f32, [8,8]>, tensor<f32, [8]>,
           tensor<f32, [8,8]>, tensor<f32, [8]>,
           tensor<f32, [8,8]>, tensor<f32, [8]>,
           tensor<f32, [8,8]>, tensor<f32, [8]>,
           tensor<f32, [8,8]>, tensor<f32, [8]>,
           tensor<f32, [8,8]>, tensor<f32, [8]>> {
    fixum lista<numerus> shape_w ← wq.magnitudines()
    fixum lista<numerus> shape_b ← bq.magnitudines()
    fixum tensor<f32, []> seed ← vacua
    fixum tensor<f32, [8,8]> lr_fill_w ← seed.crea(lr, shape_w)
    fixum tensor<f32, [8]> lr_fill_b   ← seed.crea(lr, shape_b)

    fixum tensor<f32, [8,8]> swq  ← gwq.multiplica(lr_fill_w)
    fixum tensor<f32, [8]>    sbq  ← gbq.multiplica(lr_fill_b)
    fixum tensor<f32, [8,8]> swk  ← gwk.multiplica(lr_fill_w)
    fixum tensor<f32, [8]>    sbk  ← gbk.multiplica(lr_fill_b)
    fixum tensor<f32, [8,8]> swv  ← gwv.multiplica(lr_fill_w)
    fixum tensor<f32, [8]>    sbv  ← gbv.multiplica(lr_fill_b)
    fixum tensor<f32, [8,8]> swo  ← gwo.multiplica(lr_fill_w)
    fixum tensor<f32, [8]>    sbo  ← gbo.multiplica(lr_fill_b)
    fixum tensor<f32, [8,8]> swf1 ← gwf1.multiplica(lr_fill_w)
    fixum tensor<f32, [8]>    sbf1 ← gbf1.multiplica(lr_fill_b)
    fixum tensor<f32, [8,8]> swf2 ← gwf2.multiplica(lr_fill_w)
    fixum tensor<f32, [8]>    sbf2 ← gbf2.multiplica(lr_fill_b)

    fixum tensor<f32, [8,8]> nwq  ← wq.subtrahe(swq)
    fixum tensor<f32, [8]>    nbq  ← bq.subtrahe(sbq)
    fixum tensor<f32, [8,8]> nwk  ← wk.subtrahe(swk)
    fixum tensor<f32, [8]>    nbk  ← bk.subtrahe(sbk)
    fixum tensor<f32, [8,8]> nwv  ← wv.subtrahe(swv)
    fixum tensor<f32, [8]>    nbv  ← bv.subtrahe(sbv)
    fixum tensor<f32, [8,8]> nwo  ← wo.subtrahe(swo)
    fixum tensor<f32, [8]>    nbo  ← bo.subtrahe(sbo)
    fixum tensor<f32, [8,8]> nwf1 ← wf1.subtrahe(swf1)
    fixum tensor<f32, [8]>    nbf1 ← bf1.subtrahe(sbf1)
    fixum tensor<f32, [8,8]> nwf2 ← wf2.subtrahe(swf2)
    fixum tensor<f32, [8]>    nbf2 ← bf2.subtrahe(sbf2)

    redde iuncta<tensor<f32, [8,8]>, tensor<f32, [8]>,
                 tensor<f32, [8,8]>, tensor<f32, [8]>,
                 tensor<f32, [8,8]>, tensor<f32, [8]>,
                 tensor<f32, [8,8]>, tensor<f32, [8]>,
                 tensor<f32, [8,8]>, tensor<f32, [8]>,
                 tensor<f32, [8,8]>, tensor<f32, [8]>>
        [nwq, nbq, nwk, nbk, nwv, nbv, nwo, nbo,
         nwf1, nbf1, nwf2, nbf2]
}

# -------------------------------------------------------------------------
# train_step_bert_layernorm — SGD update of the 6 LayerNorm BERT-tiny
#   trainable params (6×[8] per-channel scale/offset)
#   param' = param − lr·grad   (same math as the retired optimize.sgd_step_*)
#   6 explicit current params + 6 explicit trainable gradients + lr in;
#   explicit 6-tuple of updated params out, in the fragment's slot order
#   (ln1_s,ln1_o,ln2_s,ln2_o,ln3_s,ln3_o).
# -------------------------------------------------------------------------

functio train_step_bert_layernorm(
    tensor<f32, [8]> ln1_s,  tensor<f32, [8]> ln1_o,
    tensor<f32, [8]> ln2_s,  tensor<f32, [8]> ln2_o,
    tensor<f32, [8]> ln3_s,  tensor<f32, [8]> ln3_o,
    tensor<f32, [8]> gln1_s, tensor<f32, [8]> gln1_o,
    tensor<f32, [8]> gln2_s, tensor<f32, [8]> gln2_o,
    tensor<f32, [8]> gln3_s, tensor<f32, [8]> gln3_o,
    f32 lr
) → iuncta<tensor<f32, [8]>, tensor<f32, [8]>,
           tensor<f32, [8]>, tensor<f32, [8]>,
           tensor<f32, [8]>, tensor<f32, [8]>> {
    fixum lista<numerus> shape_ln ← ln1_s.magnitudines()
    fixum tensor<f32, []> seed ← vacua
    fixum tensor<f32, [8]> lr_fill_ln ← seed.crea(lr, shape_ln)

    fixum tensor<f32, [8]> sln1s ← gln1_s.multiplica(lr_fill_ln)
    fixum tensor<f32, [8]> sln1o ← gln1_o.multiplica(lr_fill_ln)
    fixum tensor<f32, [8]> sln2s ← gln2_s.multiplica(lr_fill_ln)
    fixum tensor<f32, [8]> sln2o ← gln2_o.multiplica(lr_fill_ln)
    fixum tensor<f32, [8]> sln3s ← gln3_s.multiplica(lr_fill_ln)
    fixum tensor<f32, [8]> sln3o ← gln3_o.multiplica(lr_fill_ln)

    fixum tensor<f32, [8]> nln1s ← ln1_s.subtrahe(sln1s)
    fixum tensor<f32, [8]> nln1o ← ln1_o.subtrahe(sln1o)
    fixum tensor<f32, [8]> nln2s ← ln2_s.subtrahe(sln2s)
    fixum tensor<f32, [8]> nln2o ← ln2_o.subtrahe(sln2o)
    fixum tensor<f32, [8]> nln3s ← ln3_s.subtrahe(sln3s)
    fixum tensor<f32, [8]> nln3o ← ln3_o.subtrahe(sln3o)

    redde iuncta<tensor<f32, [8]>, tensor<f32, [8]>,
                 tensor<f32, [8]>, tensor<f32, [8]>,
                 tensor<f32, [8]>, tensor<f32, [8]>>
        [nln1s, nln1o, nln2s, nln2o, nln3s, nln3o]
}
