+++
locale = "la"
+++
# Training loop facade.
#
# Public import: importa ex "gradus:train" privata train
#
# S4-A (gpu-training-lowering stage-4-delivery.md): first concrete
# static-shape training-step calls, bounded to the first two callers
# (linear regression 2×2, MLP 4×4). A training step owns the SGD update of
# the trainable parameters: explicit current parameters, explicit trainable
# gradients, and a scalar learning rate in; explicit tuple of updated
# parameters out. It does not own model forward or backward.
#
# S6-G1 (gpu-training-lowering stage-6-delivery.md): train_step_bert_linear
# + train_step_bert_layernorm covering the BERT-tiny 18-trainable set
# (6×[8,8] weights + 6×[8] biases + 6×[8] LN params). The per-step gradient
# slot count is 21 (18 trainable + the frozen input, dk_scale, and target);
# the frozen slots are the backward call's business, not the step's — the
# train_step_bert_* calls take the 18 trainable gradients, matching the S4-A
# explicit-trainable-gradient precedent. Biases are [8] per-channel (the
# S6-C2 addita_bias contract).
#
# SPLIT NOTE: a single 18-return train_step_bert is not expressible — the
# source-level `iuncta<...>` tuple type is capped at 16 type arguments
# (radix-parser PARSE040 iuncta_arity_exceeded). The 18-trainable step is
# therefore two calls: train_step_bert_linear (12 linear-projection params)
# + train_step_bert_layernorm (6 LayerNorm params). Callers apply both.
#
# KNOWN TOOLCHAIN CONSTRAINT: the update math is written inline (mirroring
# the retired optimize.sgd_step_* standalone defs — pml0-proof-api-ledger.md
# rows 10-11, retired at PML1-U6) instead of calling `optimize.sgd_step_*`,
# because the current FMIR stepper cannot resolve calls FROM a library
# function TO another library function ("FaberScript unsupported: provider
# sym#N"). The retired symbols' math is duplicated inline here; the inlined
# copies are the surviving surface (ledger rows 10-11 disposition).
# Package-to-library calls are linked fine; library-to-library calls are a
# recorded faber/radix runtime gap. Revisit when library cross-module calls
# execute in the stepper.
#
# Architectural rule: the training loop is reusable across models. It must not
# import from a specific model definition. A model definition does not own its
# training loop. No module owns a backend or device handle.
#
# PML0-U3 ledger disposition (pml0-proof-api-ledger.md, gradus 33df687) —
# executed at PML1-U6: train_step_2x2 and train_step_4x4 are ADMITTED as
# caller-backed public API (grep-verified live callers in package code):
#   train_step_2x2 row 16 — examples/training/linear-regression/src/train.fab:103
#   train_step_4x4 row 17 — examples/training/mlp/src/train.fab:162
# train_step_bert_linear / train_step_bert_layernorm are out of the ledger's
# fixed-shape scope (non-_2x2/_4x4/_2x8 names).

importa ex "gradus:dtype" dtype
importa ex "gradus:tensor" tensor

# -------------------------------------------------------------------------
# train_step_2x2 — SGD update of weight + bias (2×2 f32, linear regression)
#   param' = param − lr·grad   (same math as the retired optimize.sgd_step_2x2)
# -------------------------------------------------------------------------

functio train_step_2x2(
    tensor<f32, [2,2]> weight,
    tensor<f32, [2,2]> bias,
    tensor<f32, [2,2]> grad_weight,
    tensor<f32, [2,2]> grad_bias,
    f32 lr
) → iuncta<tensor<f32, [2,2]>, tensor<f32, [2,2]>> {
    fixum lista<numerus> shape_w ← weight.magnitudines()
    fixum lista<numerus> shape_b ← bias.magnitudines()
    fixum tensor<f32, []> seed ← vacua
    fixum tensor<f32, [2,2]> lr_fill_w ← seed.crea(lr, shape_w)
    fixum tensor<f32, [2,2]> lr_fill_b ← seed.crea(lr, shape_b)
    fixum tensor<f32, [2,2]> scaled_w ← grad_weight.multiplica(lr_fill_w)
    fixum tensor<f32, [2,2]> scaled_b ← grad_bias.multiplica(lr_fill_b)
    fixum tensor<f32, [2,2]> new_weight ← weight.subtrahe(scaled_w)
    fixum tensor<f32, [2,2]> new_bias   ← bias.subtrahe(scaled_b)
    redde iuncta<tensor<f32, [2,2]>, tensor<f32, [2,2]>> [new_weight, new_bias]
}

# -------------------------------------------------------------------------
# train_step_4x4 — SGD update of weight1 + bias1 + weight2 + bias2
# (4×4 f32, two-layer MLP)
# -------------------------------------------------------------------------

functio train_step_4x4(
    tensor<f32, [4,4]> weight1,
    tensor<f32, [4,4]> bias1,
    tensor<f32, [4,4]> weight2,
    tensor<f32, [4,4]> bias2,
    tensor<f32, [4,4]> grad_weight1,
    tensor<f32, [4,4]> grad_bias1,
    tensor<f32, [4,4]> grad_weight2,
    tensor<f32, [4,4]> grad_bias2,
    f32 lr
) → iuncta<tensor<f32, [4,4]>, tensor<f32, [4,4]>, tensor<f32, [4,4]>, tensor<f32, [4,4]>> {
    fixum lista<numerus> shape_w1 ← weight1.magnitudines()
    fixum lista<numerus> shape_b1 ← bias1.magnitudines()
    fixum lista<numerus> shape_w2 ← weight2.magnitudines()
    fixum lista<numerus> shape_b2 ← bias2.magnitudines()
    fixum tensor<f32, []> seed ← vacua
    fixum tensor<f32, [4,4]> lr_fill_w1 ← seed.crea(lr, shape_w1)
    fixum tensor<f32, [4,4]> lr_fill_b1 ← seed.crea(lr, shape_b1)
    fixum tensor<f32, [4,4]> lr_fill_w2 ← seed.crea(lr, shape_w2)
    fixum tensor<f32, [4,4]> lr_fill_b2 ← seed.crea(lr, shape_b2)
    fixum tensor<f32, [4,4]> scaled_w1 ← grad_weight1.multiplica(lr_fill_w1)
    fixum tensor<f32, [4,4]> scaled_b1 ← grad_bias1.multiplica(lr_fill_b1)
    fixum tensor<f32, [4,4]> scaled_w2 ← grad_weight2.multiplica(lr_fill_w2)
    fixum tensor<f32, [4,4]> scaled_b2 ← grad_bias2.multiplica(lr_fill_b2)
    fixum tensor<f32, [4,4]> new_weight1 ← weight1.subtrahe(scaled_w1)
    fixum tensor<f32, [4,4]> new_bias1   ← bias1.subtrahe(scaled_b1)
    fixum tensor<f32, [4,4]> new_weight2 ← weight2.subtrahe(scaled_w2)
    fixum tensor<f32, [4,4]> new_bias2   ← bias2.subtrahe(scaled_b2)
    redde iuncta<tensor<f32, [4,4]>, tensor<f32, [4,4]>, tensor<f32, [4,4]>, tensor<f32, [4,4]>> [new_weight1, new_bias1, new_weight2, new_bias2]
}

# -------------------------------------------------------------------------
# train_step_bert_linear — SGD update of the 12 linear-projection BERT-tiny
#   trainable params (6×[8,8] weights + 6×[8] biases)
#   param' = param − lr·grad   (same math as the retired optimize.sgd_step_*)
#   12 explicit current params + 12 explicit trainable gradients + lr in;
#   explicit 12-tuple of updated params out, in the fragment's slot order
#   (wq,bq,wk,bk,wv,bv,wo,bo,wf1,bf1,wf2,bf2).
# -------------------------------------------------------------------------

functio train_step_bert_linear(
    tensor<f32, [8,8]> wq,   tensor<f32, [8]> bq,
    tensor<f32, [8,8]> wk,   tensor<f32, [8]> bk,
    tensor<f32, [8,8]> wv,   tensor<f32, [8]> bv,
    tensor<f32, [8,8]> wo,   tensor<f32, [8]> bo,
    tensor<f32, [8,8]> wf1,  tensor<f32, [8]> bf1,
    tensor<f32, [8,8]> wf2,  tensor<f32, [8]> bf2,
    tensor<f32, [8,8]> gwq,  tensor<f32, [8]> gbq,
    tensor<f32, [8,8]> gwk,  tensor<f32, [8]> gbk,
    tensor<f32, [8,8]> gwv,  tensor<f32, [8]> gbv,
    tensor<f32, [8,8]> gwo,  tensor<f32, [8]> gbo,
    tensor<f32, [8,8]> gwf1, tensor<f32, [8]> gbf1,
    tensor<f32, [8,8]> gwf2, tensor<f32, [8]> gbf2,
    f32 lr
) → iuncta<tensor<f32, [8,8]>, tensor<f32, [8]>,
           tensor<f32, [8,8]>, tensor<f32, [8]>,
           tensor<f32, [8,8]>, tensor<f32, [8]>,
           tensor<f32, [8,8]>, tensor<f32, [8]>,
           tensor<f32, [8,8]>, tensor<f32, [8]>,
           tensor<f32, [8,8]>, tensor<f32, [8]>> {
    fixum lista<numerus> shape_w ← wq.magnitudines()
    fixum lista<numerus> shape_b ← bq.magnitudines()
    fixum tensor<f32, []> seed ← vacua
    fixum tensor<f32, [8,8]> lr_fill_w ← seed.crea(lr, shape_w)
    fixum tensor<f32, [8]> lr_fill_b   ← seed.crea(lr, shape_b)

    fixum tensor<f32, [8,8]> swq  ← gwq.multiplica(lr_fill_w)
    fixum tensor<f32, [8]>    sbq  ← gbq.multiplica(lr_fill_b)
    fixum tensor<f32, [8,8]> swk  ← gwk.multiplica(lr_fill_w)
    fixum tensor<f32, [8]>    sbk  ← gbk.multiplica(lr_fill_b)
    fixum tensor<f32, [8,8]> swv  ← gwv.multiplica(lr_fill_w)
    fixum tensor<f32, [8]>    sbv  ← gbv.multiplica(lr_fill_b)
    fixum tensor<f32, [8,8]> swo  ← gwo.multiplica(lr_fill_w)
    fixum tensor<f32, [8]>    sbo  ← gbo.multiplica(lr_fill_b)
    fixum tensor<f32, [8,8]> swf1 ← gwf1.multiplica(lr_fill_w)
    fixum tensor<f32, [8]>    sbf1 ← gbf1.multiplica(lr_fill_b)
    fixum tensor<f32, [8,8]> swf2 ← gwf2.multiplica(lr_fill_w)
    fixum tensor<f32, [8]>    sbf2 ← gbf2.multiplica(lr_fill_b)

    fixum tensor<f32, [8,8]> nwq  ← wq.subtrahe(swq)
    fixum tensor<f32, [8]>    nbq  ← bq.subtrahe(sbq)
    fixum tensor<f32, [8,8]> nwk  ← wk.subtrahe(swk)
    fixum tensor<f32, [8]>    nbk  ← bk.subtrahe(sbk)
    fixum tensor<f32, [8,8]> nwv  ← wv.subtrahe(swv)
    fixum tensor<f32, [8]>    nbv  ← bv.subtrahe(sbv)
    fixum tensor<f32, [8,8]> nwo  ← wo.subtrahe(swo)
    fixum tensor<f32, [8]>    nbo  ← bo.subtrahe(sbo)
    fixum tensor<f32, [8,8]> nwf1 ← wf1.subtrahe(swf1)
    fixum tensor<f32, [8]>    nbf1 ← bf1.subtrahe(sbf1)
    fixum tensor<f32, [8,8]> nwf2 ← wf2.subtrahe(swf2)
    fixum tensor<f32, [8]>    nbf2 ← bf2.subtrahe(sbf2)

    redde iuncta<tensor<f32, [8,8]>, tensor<f32, [8]>,
                 tensor<f32, [8,8]>, tensor<f32, [8]>,
                 tensor<f32, [8,8]>, tensor<f32, [8]>,
                 tensor<f32, [8,8]>, tensor<f32, [8]>,
                 tensor<f32, [8,8]>, tensor<f32, [8]>,
                 tensor<f32, [8,8]>, tensor<f32, [8]>>
        [nwq, nbq, nwk, nbk, nwv, nbv, nwo, nbo,
         nwf1, nbf1, nwf2, nbf2]
}

# -------------------------------------------------------------------------
# train_step_bert_layernorm — SGD update of the 6 LayerNorm BERT-tiny
#   trainable params (6×[8] per-channel scale/offset)
#   param' = param − lr·grad   (same math as the retired optimize.sgd_step_*)
#   6 explicit current params + 6 explicit trainable gradients + lr in;
#   explicit 6-tuple of updated params out, in the fragment's slot order
#   (ln1_s,ln1_o,ln2_s,ln2_o,ln3_s,ln3_o).
# -------------------------------------------------------------------------

functio train_step_bert_layernorm(
    tensor<f32, [8]> ln1_s,  tensor<f32, [8]> ln1_o,
    tensor<f32, [8]> ln2_s,  tensor<f32, [8]> ln2_o,
    tensor<f32, [8]> ln3_s,  tensor<f32, [8]> ln3_o,
    tensor<f32, [8]> gln1_s, tensor<f32, [8]> gln1_o,
    tensor<f32, [8]> gln2_s, tensor<f32, [8]> gln2_o,
    tensor<f32, [8]> gln3_s, tensor<f32, [8]> gln3_o,
    f32 lr
) → iuncta<tensor<f32, [8]>, tensor<f32, [8]>,
           tensor<f32, [8]>, tensor<f32, [8]>,
           tensor<f32, [8]>, tensor<f32, [8]>> {
    fixum lista<numerus> shape_ln ← ln1_s.magnitudines()
    fixum tensor<f32, []> seed ← vacua
    fixum tensor<f32, [8]> lr_fill_ln ← seed.crea(lr, shape_ln)

    fixum tensor<f32, [8]> sln1s ← gln1_s.multiplica(lr_fill_ln)
    fixum tensor<f32, [8]> sln1o ← gln1_o.multiplica(lr_fill_ln)
    fixum tensor<f32, [8]> sln2s ← gln2_s.multiplica(lr_fill_ln)
    fixum tensor<f32, [8]> sln2o ← gln2_o.multiplica(lr_fill_ln)
    fixum tensor<f32, [8]> sln3s ← gln3_s.multiplica(lr_fill_ln)
    fixum tensor<f32, [8]> sln3o ← gln3_o.multiplica(lr_fill_ln)

    fixum tensor<f32, [8]> nln1s ← ln1_s.subtrahe(sln1s)
    fixum tensor<f32, [8]> nln1o ← ln1_o.subtrahe(sln1o)
    fixum tensor<f32, [8]> nln2s ← ln2_s.subtrahe(sln2s)
    fixum tensor<f32, [8]> nln2o ← ln2_o.subtrahe(sln2o)
    fixum tensor<f32, [8]> nln3s ← ln3_s.subtrahe(sln3s)
    fixum tensor<f32, [8]> nln3o ← ln3_o.subtrahe(sln3o)

    redde iuncta<tensor<f32, [8]>, tensor<f32, [8]>,
                 tensor<f32, [8]>, tensor<f32, [8]>,
                 tensor<f32, [8]>, tensor<f32, [8]>>
        [nln1s, nln1o, nln2s, nln2o, nln3s, nln3o]
}

# =========================================================================
# PML4-U4 — Schedules + train/eval mode (explicit public controls)
# =========================================================================
#
# --- Contract (pml4-delivery.md PML4-U4) ---------------------------------
# Two explicit public controls for the training loop:
#
#   1. Schedula — the learning-rate schedule (warmup + cosine decay, the
#      accepted training-proof default). A pure config + one pure
#      evaluation, deterministic (no RNG, no hidden state):
#
#        lr(step) = vertex · step/warmup                      step < warmup
#        lr(step) = finis + (vertex − finis)·(1+cos(π·t))/2   step ≥ warmup
#      with t = (step − warmup)/(total − warmup) ∈ [0, 1], clamped to the
#      horizon (post-horizon lr = finis). A degenerate horizon
#      (total == warmup) is constant at the vertex. The schedule's lr at
#      step k is the lr the loop binds into the parameter's SgdStatum
#      (U3, lentus) before passus — the loop composition is U6's.
#
#   2. Modus — train/eval mode (the dropout/RNG policy gate). Explicit
#      mode argument only: forward evaluation consults the mode it is
#      CALLED with — no hidden global state (the shared-layer rule,
#      council "forward-functions-first"). In eval mode dropout is
#      identity (effective rate 0); in train mode the effective rate is
#      the configured rate. The stochastic dropout mask is generated from
#      an explicit RNG state — the U5 seed/RNG seam; the MODE CONTROL and
#      its deterministic rate policy are this unit's.
#
# --- Shared with the GPU-training lane's accepted facts -----------------
#   * warmup + cosine is the schedule default per the pml4 delivery open
#     questions ("default: warmup + cosine per accepted training proof").
#   * lr = 0.01 is the accepted MLP training proof's constant; the
#     schedule's peak (vertex) is the same lr the optimizer state (U3)
#     carries per parameter.
#   * dropout rate domain [0, 1] (fraction of units omitted); eval = no
#     dropout (the standard evaluation-policy identity).
#
# --- Evidence honesty (CTO Q2, hard) ------------------------------------
# This surface is the STRUCTURAL proof: the controls are pure functions
# (explicit arguments, deterministic, no hidden state) and are
# compile-validated + proven by the co-located proba. Executed VALUE
# identity (a schedule's numeric lr, the f32 cosine self-hosting vs the
# f64 oracle) is env-blocked tree-wide today (FMIR stepper /
# library-import gap — recorded residual). PML4-U4 is PARTIAL: schedule
# and policy numeric identity is deferred to a runtime-evidence gate
# (auditor-owned faber test path; oracle pins recorded in train.proba).

# -------------------------------------------------------------------------
# TrainError — typed error vocabulary of the training-loop controls.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------

@ publica
discretio TrainError {
    SchedulaInvalida { textus causa },
    ModusIgnotus { textus causa },
    ExcutioInvalida { textus causa },
    PassusNegativus { textus causa },
    SemenInvalida { textus causa },
    ValorMala { textus causa },
    PositioInvalida { textus causa },
    StatumInane { textus causa },
    VersioIgnota { textus causa },
    WireMala { textus causa }
}

@ publica
functio causa(TrainError e) → textus {
    discerne e {
        casu SchedulaInvalida fixum causa { redde causa }
        casu ModusIgnotus fixum causa { redde causa }
        casu ExcutioInvalida fixum causa { redde causa }
        casu PassusNegativus fixum causa { redde causa }
        casu SemenInvalida fixum causa { redde causa }
        casu ValorMala fixum causa { redde causa }
        casu PositioInvalida fixum causa { redde causa }
        casu StatumInane fixum causa { redde causa }
        casu VersioIgnota fixum causa { redde causa }
        casu WireMala fixum causa { redde causa }
    }
}

# -------------------------------------------------------------------------
# Schedula — the learning-rate schedule config (warmup + cosine decay).
#   lentus_vertex — peak lr at the end of warmup (the lr the U3 state
#                   slot carries at the peak);
#   incalesco     — warmup steps (linear ramp 0 → vertex);
#   passus_total  — total scheduled steps (the decay horizon);
#   lentus_finis  — final lr after the cosine decay (≤ vertex).
# Construction fail-closed: finite non-negative rates, finis ≤ vertex,
# non-negative warmup, horizon ≥ 1 and ≥ warmup.
# -------------------------------------------------------------------------

@ publica
genus Schedula {
    f32 lentus_vertex
    numerus incalesco
    numerus passus_total
    f32 lentus_finis

    # Peak learning rate (end of warmup).
    functio lentus_vertex() → f32 {
        redde ego.lentus_vertex
    }

    # Warmup steps (linear ramp).
    functio incalesco() → numerus {
        redde ego.incalesco
    }

    # Total scheduled steps (decay horizon).
    functio passus_total() → numerus {
        redde ego.passus_total
    }

    # Final learning rate (post-decay).
    functio lentus_finis() → f32 {
        redde ego.lentus_finis
    }
}

@ publica
functio structa_schedula(f32 lentus_vertex, numerus incalesco, numerus passus_total, f32 lentus_finis) → Schedula ⇥ TrainError {
    requirit dtype.finita(lentus_vertex) secus finge SchedulaInvalida { causa = "invalid peak learning rate" }
    requirit non (lentus_vertex < 0.0) secus finge SchedulaInvalida { causa = "invalid peak learning rate" }
    requirit dtype.finita(lentus_finis) secus finge SchedulaInvalida { causa = "invalid final learning rate" }
    requirit non (lentus_finis < 0.0) secus finge SchedulaInvalida { causa = "invalid final learning rate" }
    requirit non (lentus_finis > lentus_vertex) secus finge SchedulaInvalida { causa = "final learning rate above peak" }
    requirit non (incalesco < 0) secus finge SchedulaInvalida { causa = "negative warmup steps" }
    requirit non (passus_total < 1) secus finge SchedulaInvalida { causa = "schedule horizon must be at least one step" }
    requirit non (passus_total < incalesco) secus finge SchedulaInvalida { causa = "warmup exceeds the schedule horizon" }
    redde Schedula { lentus_vertex = lentus_vertex, incalesco = incalesco, passus_total = passus_total, lentus_finis = lentus_finis }
}

# π — the cosine-decay phase constant.
fixum f32 PI ← (3.141592653589793 ∷ f32)

# cos via Taylor series. The schedule's phase is always in [0, π] (t ∈
# [0, 1]), so no range reduction is needed; 12 terms leave the remainder
# below f32 precision over that range (the attention.fab _cosinus
# precedent). At the horizon the series may undershoot by < 1e-4; the
# evaluation clamps the result to the true [finis, vertex] range.
@ privata
functio _cosinus(f32 x) → f32 {
    varia f32 term ← 1.0
    varia f32 sum ← 1.0
    fixum f32 x2 ← x * x
    varia numerus n ← 1
    dum n < 12 {
        term ← (term * (0.0 - x2)) / (((2 * n - 1) ↦ f32) * ((2 * n) ↦ f32))
        sum ← sum + term
        n ← n + 1
    }
    redde sum
}

# -------------------------------------------------------------------------
# lentus_schedulata — the schedule evaluation: the deterministic learning
# rate at a step (warmup + cosine decay, see the contract above). Pure:
# explicit Schedula + step in, lr out; no RNG, no hidden state.
# -------------------------------------------------------------------------

@ publica
functio lentus_schedulata(Schedula s, numerus passus) → f32 ⇥ TrainError {
    si passus < 0 {
        iace finge PassusNegativus { causa = "schedule step must be non-negative" }
    }
    si passus < s.incalesco() {
        redde s.lentus_vertex() * ((passus ↦ f32) / (s.incalesco() ↦ f32))
    }
    varia numerus passus_eff ← passus
    si passus_eff > s.passus_total() {
        passus_eff ← s.passus_total()
    }
    si s.passus_total() > s.incalesco() {
        fixum f32 t ← ((passus_eff - s.incalesco()) ↦ f32) / ((s.passus_total() - s.incalesco()) ↦ f32)
        fixum f32 phase ← PI * t
        varia f32 lr ← s.lentus_finis() + (s.lentus_vertex() - s.lentus_finis()) * (1.0 + _cosinus(phase)) / 2.0
        si lr < s.lentus_finis() {
            lr ← s.lentus_finis()
        }
        si lr > s.lentus_vertex() {
            lr ← s.lentus_vertex()
        }
        redde lr
    }
    redde s.lentus_vertex()
}

# -------------------------------------------------------------------------
# Modus — train/eval mode. An EXPLICIT argument to any mode-dependent
# call: forward evaluation consults the mode it is called with, never a
# hidden global (the shared-layer rule). Names are the wire contract:
# "train" | "eval".
# -------------------------------------------------------------------------

@ publica
discretio Modus {
    Disciplina
    Aestimatio
}

# Canonical mode name (textus surface for probes and consumers).
@ publica
functio modus_nomen(Modus m) → textus {
    discerne m {
        casu Disciplina { redde "train" }
        casu Aestimatio { redde "eval" }
    }
}

@ privata
functio _disciplina(Modus m) → bivalens {
    discerne m {
        casu Disciplina { redde verum }
        casu Aestimatio { redde falsum }
    }
}

# Train-mode predicate.
@ publica
functio est_disciplina(Modus m) → bivalens {
    redde _disciplina(m)
}

# Eval-mode predicate (dropout identity).
@ publica
functio est_aestimatio(Modus m) → bivalens {
    redde non (_disciplina(m))
}

# Construct a mode from its canonical name — fail closed on an unknown
# name (the probe-visible entry; enum variants do not cross module
# boundaries, dtype.fab SEM001 note).
@ publica
functio modus(textus nomen) → Modus ⇥ TrainError {
    si nomen ≡ "train" ergo redde finge Disciplina
    si nomen ≡ "eval" ergo redde finge Aestimatio
    iace finge ModusIgnotus { causa = "unknown mode name" }
}

# -------------------------------------------------------------------------
# dropout_pars — the dropout/RNG policy gate. The effective dropout rate
# for a forward evaluation called with an explicit mode: eval → 0 (no
# dropout — the standard evaluation identity), train → the configured
# rate. The rate domain is [0, 1] (finite, fail closed). The stochastic
# mask applied at the effective rate comes from an explicit RNG state —
# the U5 seed/RNG seam; the deterministic mode gate is this unit's.
# -------------------------------------------------------------------------

@ publica
functio dropout_pars(Modus m, f32 rate) → f32 ⇥ TrainError {
    si non (dtype.finita(rate)) {
        iace finge ExcutioInvalida { causa = "dropout rate must be in [0, 1]" }
    }
    si rate < 0.0 aut rate > 1.0 {
        iace finge ExcutioInvalida { causa = "dropout rate must be in [0, 1]" }
    }
    si est_aestimatio(m) ergo redde (0.0 ∷ f32)
    redde rate
}

# =========================================================================
# PML4-U5 — Seeds (RNG), checkpoint resume, metrics (pml4-delivery.md U5)
# =========================================================================
#
# --- Contract ------------------------------------------------------------
# Three pieces close the reproducibility contract:
#
#   1. Semen — the seed/RNG state (this unit owns the machinery U4's
#      dropout gate composes with). A xorshift64 generator (shifts + XOR
#      only, no multiply — no overflow concerns) over a nonzero i64
#      state; deterministic: the same seed produces the same sequence.
#      proximus() draws the next 64-bit value and advances the state;
#      proximus_f32() maps a draw to [0, 1) (sign-masked, top 52 bits,
#      uniform over the masked space — the f32 [0,1) contract). excutio()
#      is the dropout-mask composition: it takes the effective rate from
#      dropout_pars (U4) — eval mode is identity and the RNG is left
#      untouched — and in train mode applies a per-element Bernoulli mask
#      scaled by 1/(1−rate) (inverted dropout, so the eval identity
#      composes exactly). Deterministic given (tensor, seed, mode, rate).
#
#   2. Tabula — the checkpoint: epoch + step + RNG state + the U3
#      optimizer-state wire (carried VERBATIM — the envelope stays
#      autograd-free; the state wire is validated by its own schema,
#      optimize.deserializa, at resume). Versioned wire round-trip
#      ("train/checkpoint/1.0.0/<epoch>/<step>/<rng_state>/<state_wire>");
#      interrupted-resume failure is EXPLICIT: a truncated/malformed
#      checkpoint wire, an unknown schema, an invalid epoch/step, a zero
#      RNG state, or a missing state wire all fail closed at
#      deserialization; a corrupt embedded state wire fails closed at
#      optimize.deserializa (resume).
#
#   3. Metrics — see gradus:metrics (accuratezza + the per-step Metricum
#      record); defined values with a deterministic contract.
#
# --- Shared with the GPU-training lane's accepted facts -----------------
#   * checkpoint resume (state + RNG + epoch/step) versioned per the U3
#     wire precedent (slot wire, lossless float form, '/' and ';'
#     reserved); same fail-closed posture (capsule rule).
#   * dropout mask semantics: per-element Bernoulli(1−rate), scaled by
#     1/(1−rate) in train (inverted dropout) — the standard training
#     policy the U4 dropout_pars gate controls.
#
# --- Evidence honesty (CTO Q2, hard) ------------------------------------
# This surface is the STRUCTURAL proof: the generator recurrence, the
# mask policy, and the checkpoint round-trip are compile-validated and
# proven by the co-located proba (f64 oracle pins for the xorshift
# recurrence, the [0,1) draws, and a concrete dropout-mask output).
# Executed VALUE identity is env-blocked tree-wide today (FMIR stepper /
# library-import gap — recorded residual). PML4-U5 is PARTIAL: numeric
# identity is deferred to a runtime-evidence gate (auditor-owned faber
# test path; oracle pins recorded in train.proba).

# Schema version of this module's wire forms (rng, checkpoint).
fixum textus schema_versio ← "1.0.0"

# -------------------------------------------------------------------------
# Semen — the deterministic RNG state. A xorshift64 state (nonzero i64);
# the same seed reproduces the same sequence (reproducibility).
# -------------------------------------------------------------------------

@ publica
genus Semen {
    numerus status

    # The 64-bit generator state (nonzero — xorshift64 degenerates at 0).
    functio status() → numerus {
        redde ego.status
    }
}

# Seed the generator. Zero is rejected fail-closed (xorshift64 maps 0 → 0).
@ publica
functio structa_semen(numerus semen) → Semen ⇥ TrainError {
    si semen ≡ 0 {
        iace finge SemenInvalida { causa = "seed must be non-zero" }
    }
    redde Semen { status = semen }
}

# One RNG draw: the next 64-bit value + the advanced state.
@ publica
genus Fructus {
    numerus valor
    Semen semen

    # The drawn value.
    functio valor() → numerus {
        redde ego.valor
    }

    # The advanced generator state.
    functio semen() → Semen {
        redde ego.semen
    }
}

# xorshift64 step: x ^= x<<13; x ^= x>>7; x ^= x<<17. Shifts + XOR only —
# no multiply, no overflow concerns. Bitwise on the i64 carrier.
@ publica
functio proximus(Semen s) → Fructus {
    varia numerus x ← s.status()
    x ← x ⊻ (x ⇐ 13)
    x ← x ⊻ (x ⇒ 7)
    x ← x ⊻ (x ⇐ 17)
    redde Fructus { valor = x, semen = Semen { status = x } }
}

# Sign-bit mask: the [0,1) draw uses only the low 63 bits (sign-agnostic).
fixum numerus MASK_63 ← 9223372036854775807

# 2^52 as f32 (exact power of two) — the draw denominator.
fixum f32 DUO_52 ← (4503599627370496.0 ∷ f32)

# One f32 draw in [0, 1): the top 52 bits of the sign-masked state over
# 2^52. Uniform over the masked space; deterministic (same seed → same
# draws). f32 rounding is ~1e-7 — the proba pins compare within 1e-6.
@ publica
genus FructusF32 {
    f32 valor
    Semen semen

    # The drawn value in [0, 1).
    functio valor() → f32 {
        redde ego.valor
    }

    # The advanced generator state.
    functio semen() → Semen {
        redde ego.semen
    }
}

@ publica
functio proximus_f32(Semen s) → FructusF32 {
    fixum Fructus f ← proximus(s)
    fixum f32 v ← (((f.valor() ∧ MASK_63) ⇒ 11) ↦ f32) / DUO_52
    redde FructusF32 { valor = v, semen = f.semen() }
}

# -------------------------------------------------------------------------
# excutio — the dropout-mask composition (the U5 machinery the U4
# dropout_pars gate controls). Eval mode (or rate 0) is identity and the
# RNG is untouched — the standard evaluation policy, deterministic. Train
# mode applies a per-element Bernoulli(1−rate) mask scaled by 1/(1−rate)
# (inverted dropout): x_i ← x_i·m_i/(1−rate), m_i = 1 if r_i ≥ rate.
# The mask is drawn from the explicit Semen state, which advances; the
# same (tensor, seed, mode, rate) reproduces the same output.
# -------------------------------------------------------------------------

@ publica
genus Excutio {
    tensor.Tensor valor
    Semen semen

    # The masked tensor.
    functio valor() → tensor.Tensor {
        redde ego.valor
    }

    # The advanced RNG state.
    functio semen() → Semen {
        redde ego.semen
    }
}

@ publica
functio excutio(tensor.Tensor x, Semen s, Modus m, f32 rate) → Excutio ⇥ TrainError {
    fixum f32 par ← dropout_pars(m, rate)
    si par ≡ (0.0 ∷ f32) {
        redde Excutio { valor = x, semen = s }
    }
    fixum f32 scala ← 1.0 / (1.0 - par)
    fixum lista<f32> datos ← x.datos
    varia lista<f32> novus ← vacua
    varia Semen s2 ← s
    itera ex datos fixum v {
        fixum FructusF32 f ← proximus_f32(s2)
        s2 ← f.semen()
        si f.valor() ≥ par {
            novus.appende(v * scala)
        }
        secus {
            novus.appende((0.0 ∷ f32))
        }
    }
    varia tensor.Tensor renovatus
    fac {
        renovatus ← tensor.structa(novus, x.figura())
    }
    cape err {
        iace finge ValorMala { causa = tensor.causa(err) }
    }
    redde Excutio { valor = renovatus, semen = s2 }
}

# -------------------------------------------------------------------------
# RNG wire — versioned, exact round-trip.
# -------------------------------------------------------------------------

@ publica
functio serializa_semen(Semen s) → textus {
    redde "train/rng/" + schema_versio + "/" + (s.status() ↦ textus)
}

@ publica
functio deserializa_semen(textus wire) → Semen ⇥ TrainError {
    fixum lista<textus> partes ← wire.divide("/")
    si partes.longitudo() ≠ 4 {
        iace finge WireMala { causa = "malformed rng wire" }
    }
    si partes.accipe(0) vel "" ≠ "train" {
        iace finge WireMala { causa = "unknown rng marker" }
    }
    si partes.accipe(1) vel "" ≠ "rng" {
        iace finge WireMala { causa = "unknown rng marker" }
    }
    si partes.accipe(2) vel "" ≠ schema_versio {
        iace finge VersioIgnota { causa = "unknown rng schema version" }
    }
    fixum textus status_textus ← partes.accipe(3) vel ""
    si status_textus.longitudo() ≡ 0 {
        iace finge WireMala { causa = "malformed rng state" }
    }
    varia numerus status ← 0
    fac {
        status ← status_textus ↦ numerus
    }
    cape err {
        iace finge WireMala { causa = "malformed rng state" }
    }
    redde structa_semen(status)
}

# -------------------------------------------------------------------------
# Tabula — the checkpoint: epoch + step + RNG state + the optimizer-state
# wire (U3, carried verbatim). The envelope is autograd-free; the state
# wire validates against ITS OWN schema at resume (optimize.deserializa).
# -------------------------------------------------------------------------

@ publica
genus Tabula {
    numerus aetas
    numerus passus
    Semen rng
    textus statum_wire

    # Epoch.
    functio aetas() → numerus {
        redde ego.aetas
    }

    # Step within the epoch.
    functio passus() → numerus {
        redde ego.passus
    }

    # The RNG state (deterministic continuation after resume).
    functio rng() → Semen {
        redde ego.rng
    }

    # The embedded U3 optimizer-state wire (verbatim).
    functio statum_wire() → textus {
        redde ego.statum_wire
    }
}

# Build a checkpoint. Epoch/step are non-negative; the state wire is
# non-empty (fail closed). The RNG is already a validated Semen.
@ publica
functio structa_tabula(numerus aetas, numerus passus, Semen rng, textus statum_wire) → Tabula ⇥ TrainError {
    si aetas < 0 {
        iace finge PositioInvalida { causa = "epoch must be non-negative" }
    }
    si passus < 0 {
        iace finge PositioInvalida { causa = "step must be non-negative" }
    }
    si statum_wire.longitudo() ≡ 0 {
        iace finge StatumInane { causa = "checkpoint state wire is empty" }
    }
    redde Tabula { aetas = aetas, passus = passus, rng = rng, statum_wire = statum_wire }
}

# Field-wise checkpoint equality — the round-trip predicate.
@ publica
functio tabula_aequus(Tabula a, Tabula b) → bivalens {
    si a.aetas() ≠ b.aetas() ergo redde falsum
    si a.passus() ≠ b.passus() ergo redde falsum
    si a.rng().status() ≠ b.rng().status() ergo redde falsum
    si a.statum_wire() ≠ b.statum_wire() ergo redde falsum
    redde verum
}

# -------------------------------------------------------------------------
# Checkpoint wire — versioned, exact round-trip. The fixed prefix carries
# marker/schema/epoch/step/rng-state; the embedded optimizer-state wire is
# the '/' tail (joined verbatim from the trailing segments).
# -------------------------------------------------------------------------

@ publica
functio serializa_tabula(Tabula c) → textus {
    varia textus out ← "train/checkpoint/" + schema_versio + "/" + (c.aetas() ↦ textus) + "/" + (c.passus() ↦ textus) + "/" + (c.rng().status() ↦ textus) + "/" + c.statum_wire()
    redde out
}

# All-digits predicate for wire integer fields (epoch, step).
@ privata
functio _digitum(textus c) → bivalens {
    redde c ≡ "0" aut c ≡ "1" aut c ≡ "2" aut c ≡ "3" aut c ≡ "4" aut c ≡ "5" aut c ≡ "6" aut c ≡ "7" aut c ≡ "8" aut c ≡ "9"
}

@ privata
functio _numerica(textus s) → bivalens {
    si s.longitudo() ≡ 0 ergo redde falsum
    si s.longitudo() > 18 ergo redde falsum
    varia numerus i ← 0
    dum i < s.longitudo() {
        si non (_digitum(s.accipe(i))) ergo redde falsum
        i ← i + 1
    }
    redde verum
}

@ publica
functio deserializa_tabula(textus wire) → Tabula ⇥ TrainError {
    fixum lista<textus> partes ← wire.divide("/")
    si partes.longitudo() < 7 {
        iace finge WireMala { causa = "malformed checkpoint wire" }
    }
    si partes.accipe(0) vel "" ≠ "train" {
        iace finge WireMala { causa = "unknown checkpoint marker" }
    }
    si partes.accipe(1) vel "" ≠ "checkpoint" {
        iace finge WireMala { causa = "unknown checkpoint marker" }
    }
    si partes.accipe(2) vel "" ≠ schema_versio {
        iace finge VersioIgnota { causa = "unknown checkpoint schema version" }
    }
    fixum textus aetas_textus ← partes.accipe(3) vel ""
    fixum textus passus_textus ← partes.accipe(4) vel ""
    si non (_numerica(aetas_textus)) {
        iace finge WireMala { causa = "malformed epoch in checkpoint wire" }
    }
    si non (_numerica(passus_textus)) {
        iace finge WireMala { causa = "malformed step in checkpoint wire" }
    }
    varia numerus aetas ← 0
    varia numerus passus ← 0
    fac {
        aetas ← aetas_textus ↦ numerus
    }
    cape err {
        iace finge WireMala { causa = "malformed epoch in checkpoint wire" }
    }
    fac {
        passus ← passus_textus ↦ numerus
    }
    cape err {
        iace finge WireMala { causa = "malformed step in checkpoint wire" }
    }
    fixum textus status_textus ← partes.accipe(5) vel ""
    si status_textus.longitudo() ≡ 0 {
        iace finge WireMala { causa = "malformed rng state in checkpoint wire" }
    }
    varia numerus status ← 0
    fac {
        status ← status_textus ↦ numerus
    }
    cape err {
        iace finge WireMala { causa = "malformed rng state in checkpoint wire" }
    }
    fixum Semen rng ← structa_semen(status)
    # The embedded optimizer-state wire is the '/' tail, joined verbatim.
    varia textus statum_wire ← ""
    varia numerus i ← 6
    dum i < partes.longitudo() {
        si i > 6 {
            statum_wire ← statum_wire + "/"
        }
        statum_wire ← statum_wire + (partes.accipe(i) vel "")
        i ← i + 1
    }
    si statum_wire.longitudo() ≡ 0 {
        iace finge StatumInane { causa = "checkpoint state wire is empty" }
    }
    redde Tabula { aetas = aetas, passus = passus, rng = rng, statum_wire = statum_wire }
}
