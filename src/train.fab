+++
locale = "en"
+++
# Training controls — train/eval mode, dropout, and checkpoint envelope.
#
# Public import: import from "gradus:train" train
# Depends on: gradus:dtype (finite), gradus:tensor (value carrier),
# gradus:random (the shared explicit seed state).
#
# Learning-rate schedules live in gradus:schedule. This module does not own
# an epoch loop or metrics (gradus:metrics), and it does not specialize
# optimizer updates for a model or fixture (gradus:optimize).
#
# Architectural rule: the training step is reusable across models. It must not
# import from a specific model definition. A model definition does not own its
# training step. No module owns a backend or device handle.
#
import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

import from "gradus:random" random

# =========================================================================
# Train/eval mode and dropout policy
# =========================================================================
# Mode is explicit: forward evaluation consults the mode it is called with,
# never hidden global state. Eval mode has effective dropout rate 0; train
# mode uses the configured rate. The stochastic mask uses the explicit Seed
# state owned by gradus:random.

# -------------------------------------------------------------------------
# TrainError — typed error vocabulary of the training-loop controls.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------


@ public
union TrainError {
    @ shared
    string message

    UnknownMode,
    InvalidDropout,
    InvalidSeed,
    BadPayload,
    InvalidPosition,
    EmptyState,
    UnknownVersion,
    BadWire,
    TensorFailure {
        tensor.TensorError inner
    }
}

@ conversion
fn from_tensor_error(tensor.TensorError err) → TrainError {
    return variant TensorFailure { message = err.message, inner = err }
}

@ conversion
fn from_random_error(random.RandomError err) → TrainError {
    match err {
        case random.RandomError.InvalidSeed let message {
            return variant InvalidSeed { message = message }
        }
        case random.RandomError.BadWire let message {
            return variant BadWire { message = message }
        }
        case random.RandomError.UnknownVersion let message {
            return variant UnknownVersion { message = message }
        }
    }
}



# -------------------------------------------------------------------------
# Mode — train/eval mode. An EXPLICIT argument to any mode-dependent
# call: forward evaluation consults the mode it is called with, never a
# hidden global (the shared-layer rule). Names are the wire contract:
# "train" | "eval".
# -------------------------------------------------------------------------


@ public
union Mode {
    Discipline,
    Estimate
}

# Canonical mode name (text surface for consumers).
@ public
fn mode_name(Mode m) → string {
    match m {
        case Discipline {
            return "train"
        }
        case Estimate {
            return "eval"
        }
    }
}

@ public
fn is_discipline(Mode m) → bool {
    match m {
        case Discipline {
            return true
        }
        case Estimate {
            return false
        }
    }
}

@ public
fn is_estimate(Mode m) → bool {
    return not is_discipline(m)
}

# Construct a mode from its canonical name — fail closed on an unknown
# name (the string entry; enum variants do not cross module
# boundaries, dtype.fab SEM001 note).
@ public
fn mode(string name) → Mode ⇥ TrainError {
    if name ≡ "train" then return variant Discipline
    if name ≡ "eval" then return variant Estimate
    throw variant UnknownMode { message = "unknown mode name" }
}

# -------------------------------------------------------------------------
# dropout_probability — the dropout/RNG policy gate. The effective dropout rate
# for a forward evaluation called with an explicit mode: eval → 0 (no
# dropout — the standard evaluation identity), train → the configured
# rate. The rate domain is [0, 1] (finite, fail closed). The stochastic
# mask applied at the effective rate comes from an explicit RNG state —
# the U5 seed/RNG seam; the deterministic mode gate is this unit's.
# -------------------------------------------------------------------------

@ public
fn dropout_probability(Mode m, f32 rate) → f32 ⇥ TrainError {
    require dtype.finite(rate) throw variant InvalidDropout { message = "dropout rate must be in [0, 1]" }
    require rate ≥ 0.0 throw variant InvalidDropout { message = "dropout rate must be in [0, 1]" }
    require rate ≤ 1.0 throw variant InvalidDropout { message = "dropout rate must be in [0, 1]" }
    if is_estimate(m) then return 0.0 ∷ f32
    return rate
}

# -------------------------------------------------------------------------
# dropout — the dropout-mask composition (the U5 machinery the U4
# dropout_probability gate controls). Eval mode (or rate 0) is identity and the
# RNG is untouched — the standard evaluation policy, deterministic. Train
# mode applies a per-element Bernoulli(1−rate) mask scaled by 1/(1−rate)
# (inverted dropout): x_i ← x_i·m_i/(1−rate), m_i = 1 if r_i ≥ rate.
# The mask is drawn from the explicit Seed state, which advances; the
# same (tensor, seed, mode, rate) reproduces the same output.
# -------------------------------------------------------------------------


@ public
class Dropout {
    mut tensor.NumericBlock payload
    mut random.Seed seed
}

@ public
fn dropout(tensor.NumericBlock x, random.Seed s, Mode m, f32 rate) → Dropout ⇥ TrainError {
    let f32 par ← dropout_probability(m, rate)
    if par ≡ 0.0 ∷ f32 then return Dropout { payload = x, seed = s }
    let f32 scale ← 1.0 / (1.0 - par)
    let list<f32> data ← x.data
    mut list<f32> out ← empty
    mut random.Seed s2 ← copy s
    for from data let v {
        let random.DrawF32 f ← random.next_f32(s2)
        s2 ← f.seed
        if f.payload ≥ par {
            out.append(v * scale)
        }
        else {
            out.append(0.0 ∷ f32)
        }
    }
    mut tensor.NumericBlock updated ← tensor.default()
    updated ← tensor.construct(out, x.shape)
    return Dropout { payload = updated, seed = s2 }
}

const string schema_version = "1.0.0"

# -------------------------------------------------------------------------
# Checkpoint — the checkpoint: epoch + step + RNG state + the optimizer-state
# wire (U3, carried verbatim). The envelope is autograd-free; the state
# wire validates against ITS OWN schema at resume (optimize.deserialize).
# -------------------------------------------------------------------------


@ public
class Checkpoint {
    # Epoch.
    mut int age
    # Step within the epoch.
    mut int step
    mut random.Seed rng
    # Embedded optimizer-state wire, carried verbatim.
    mut string state_wire
}

# Build a checkpoint. Epoch/step are non-negative; the state wire is
# non-empty (fail closed). The RNG is already a validated Seed.
@ public
fn construct_checkpoint(int age, int step, random.Seed rng, string state_wire) → Checkpoint ⇥ TrainError {
    require age ≥ 0 throw variant InvalidPosition { message = "epoch must be non-negative" }
    require step ≥ 0 throw variant InvalidPosition { message = "step must be non-negative" }
    require state_wire.length() ≢ 0 throw variant EmptyState { message = "checkpoint state wire is empty" }
    return Checkpoint { age = age, step = step, rng = rng, state_wire = state_wire }
}

# Placeholder Default for `var Checkpoint` bindings (varia on structs).
# Empty wire and an empty seed (not a valid checkpoint). Only a
# placeholder the caller overwrites, or returns from an unreachable cape arm.
@ public
fn default_checkpoint() → Checkpoint {
    return Checkpoint { age = 0, step = 0, rng = random.default(), state_wire = "" }
}

# Field-wise checkpoint equality — the round-trip predicate.
@ public
fn checkpoint_equal(Checkpoint a, Checkpoint b) → bool {
    if a.age ≢ b.age then return false
    if a.step ≢ b.step then return false
    if a.rng.status ≢ b.rng.status then return false
    if a.state_wire ≢ b.state_wire then return false
    return true
}

# -------------------------------------------------------------------------
# Checkpoint wire — versioned, exact round-trip. The fixed prefix carries
# marker/schema/epoch/step/rng-state; the embedded optimizer-state wire is
# the '/' tail (joined verbatim from the trailing segments).
# -------------------------------------------------------------------------

@ public
fn serialize_checkpoint(Checkpoint c) → string {
    return "train/checkpoint/§/§/§/§/§"(schema_version, c.age ↦ string, c.step ↦ string, c.rng.status ↦ string, c.state_wire)
}

# All-digits predicate for wire integer fields (epoch, step).
fn digit(string c) → bool {
    let string text ↤ c
    return "0123456789".contains(text)
}

fn numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    for from s let c {
        if not digit(c ↦ string) then return false
    }
    return true
}

@ public
fn deserialize_checkpoint(string wire) → Checkpoint ⇥ TrainError {
    let list<string> parts ← wire.split("/")
    require parts.length() ≥ 7 throw variant BadWire { message = "malformed checkpoint wire" }
    require parts.get(0) coalesce "" ≡ "train" throw variant BadWire { message = "unknown checkpoint marker" }
    require parts.get(1) coalesce "" ≡ "checkpoint" throw variant BadWire { message = "unknown checkpoint marker" }
    require parts.get(2) coalesce "" ≡ schema_version throw variant UnknownVersion { message = "unknown checkpoint schema version" }
    let string age_text ← parts.get(3) coalesce ""
    let string step_text ← parts.get(4) coalesce ""
    require numeric(age_text) throw variant BadWire { message = "malformed epoch in checkpoint wire" }
    require numeric(step_text) throw variant BadWire { message = "malformed step in checkpoint wire" }
    mut int age ← 0
    mut int step ← 0
    do {
        age ↤ age_text
    }
    catch err {
        throw variant BadWire { message = "malformed epoch in checkpoint wire" }
    }
    do {
        step ↤ step_text
    }
    catch err {
        throw variant BadWire { message = "malformed step in checkpoint wire" }
    }
    let string status_text ← parts.get(5) coalesce ""
    require status_text.length() ≢ 0 throw variant BadWire { message = "malformed rng state in checkpoint wire" }
    mut int status ← 0
    do {
        status ↤ status_text
    }
    catch err {
        throw variant BadWire { message = "malformed rng state in checkpoint wire" }
    }
    let random.Seed rng ← random.construct_seed(status)
    # The embedded optimizer-state wire is the '/' tail, joined verbatim.
    mut string state_wire ← ""
    # legacy-L2: flat list carrier — tail assembly needs source indices; retain bounded range walk.
    for range 6 ‥ parts.length() let i {
        if i ≻ 6 {
            state_wire ← state_wire + "/"
        }
        state_wire ← state_wire + parts.get(i) coalesce ""
    }
    require state_wire.length() ≢ 0 throw variant EmptyState { message = "checkpoint state wire is empty" }
    return Checkpoint { age = age, step = step, rng = rng, state_wire = state_wire }
}
