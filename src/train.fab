+++
locale = "en"
+++
# Training loop facade.
#
# Public import: importa ex "gradus:train" privata train
#
# S4-A (gpu-training-lowering stage-4-delivery.md): first concrete
# static-shape training-step calls, bounded to the first two callers
# (linear regression 2×2, MLP 4×4). A training step owns the SGD update of
# the trainable parameters: explicit current parameters, explicit trainable
# gradients, and a scalar learning rate in; explicit tuple of updated
# parameters out. It does not own model forward or backward.
#
# S6-G1 (gpu-training-lowering stage-6-delivery.md): train_step_bert_linear
# + train_step_bert_layernorm covering the BERT-tiny 18-trainable set
# (6×[8,8] weights + 6×[8] biases + 6×[8] LN params). The per-step gradient
# slot count is 21 (18 trainable + the frozen input, dk_scale, and target);
# the frozen slots are the backward call's business, not the step's — the
# train_step_bert_* calls take the 18 trainable gradients, matching the S4-A
# explicit-trainable-gradient precedent. Biases are [8] per-channel (the
# S6-C2 addita_bias contract).
#
# SPLIT NOTE: a single 18-return train_step_bert is not expressible — the
# source-level `iuncta<...>` tuple type is capped at 16 type arguments
# (radix-parser PARSE040 iuncta_arity_exceeded). The 18-trainable step is
# therefore two calls: train_step_bert_linear (12 linear-projection params)
# + train_step_bert_layernorm (6 LayerNorm params). Callers apply both.
#
# KNOWN TOOLCHAIN CONSTRAINT: the update math is written inline (mirroring
# the retired optimize.sgd_step_* standalone defs — pml0-proof-api-ledger.md
# rows 10-11, retired at PML1-U6) instead of calling `optimize.sgd_step_*`,
# because the current FMIR stepper cannot resolve calls FROM a library
# function TO another library function ("FaberScript unsupported: provider
# sym#N"). The retired symbols' math is duplicated inline here; the inlined
# copies are the surviving surface (ledger rows 10-11 disposition).
# Package-to-library calls are linked fine; library-to-library calls are a
# recorded faber/radix runtime gap. Revisit when library cross-module calls
# execute in the stepper.
#
# Architectural rule: the training loop is reusable across models. It must not
# import from a specific model definition. A model definition does not own its
# training loop. No module owns a backend or device handle.
#
# PML0-U3 ledger disposition (pml0-proof-api-ledger.md, gradus 33df687) —
# executed at PML1-U6: train_step_2x2 and train_step_4x4 are ADMITTED as
# caller-backed public API (grep-verified live callers in package code):
#   train_step_2x2 row 16 — examples/training/linear-regression/src/train.fab:103
#   train_step_4x4 row 17 — examples/training/mlp/src/train.fab:162
# train_step_bert_linear / train_step_bert_layernorm are out of the ledger's
# fixed-shape scope (non-_2x2/_4x4/_2x8 names).

import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# train_step_2x2 — SGD update of weight + bias (2×2 f32, linear regression)
#   param' = param − lr·grad   (same math as the retired optimize.sgd_step_2x2)
# -------------------------------------------------------------------------

fn train_step_2x2(tensor<f32, [2, 2]> weight, tensor<f32, [2, 2]> bias, tensor<f32, [2, 2]> grad_weight, tensor<f32, [2, 2]> grad_bias, f32 lr) → tuple<tensor<f32, [2, 2]>, tensor<f32, [2, 2]>> {
    const list<int> shape_w ← weight.shape()
    const list<int> shape_b ← bias.shape()
    const tensor<f32, []> seed ← vacua
    const tensor<f32, [2, 2]> lr_fill_w ← seed.create(lr, shape_w)
    const tensor<f32, [2, 2]> lr_fill_b ← seed.create(lr, shape_b)
    const tensor<f32, [2, 2]> scaled_w ← grad_weight.multiply(lr_fill_w)
    const tensor<f32, [2, 2]> scaled_b ← grad_bias.multiply(lr_fill_b)
    const tensor<f32, [2, 2]> new_weight ← weight.subtract(scaled_w)
    const tensor<f32, [2, 2]> new_bias ← bias.subtract(scaled_b)
    return tuple<tensor<f32, [2, 2]>, tensor<f32, [2, 2]>> [new_weight, new_bias]
}

# -------------------------------------------------------------------------
# train_step_4x4 — SGD update of weight1 + bias1 + weight2 + bias2
# (4×4 f32, two-layer MLP)
# -------------------------------------------------------------------------

fn train_step_4x4(tensor<f32, [4, 4]> weight1, tensor<f32, [4, 4]> bias1, tensor<f32, [4, 4]> weight2, tensor<f32, [4, 4]> bias2, tensor<f32, [4, 4]> grad_weight1, tensor<f32, [4, 4]> grad_bias1, tensor<f32, [4, 4]> grad_weight2, tensor<f32, [4, 4]> grad_bias2, f32 lr) → tuple<tensor<f32, [4, 4]>, tensor<f32, [4, 4]>, tensor<f32, [4, 4]>, tensor<f32, [4, 4]>> {
    const list<int> shape_w1 ← weight1.shape()
    const list<int> shape_b1 ← bias1.shape()
    const list<int> shape_w2 ← weight2.shape()
    const list<int> shape_b2 ← bias2.shape()
    const tensor<f32, []> seed ← vacua
    const tensor<f32, [4, 4]> lr_fill_w1 ← seed.create(lr, shape_w1)
    const tensor<f32, [4, 4]> lr_fill_b1 ← seed.create(lr, shape_b1)
    const tensor<f32, [4, 4]> lr_fill_w2 ← seed.create(lr, shape_w2)
    const tensor<f32, [4, 4]> lr_fill_b2 ← seed.create(lr, shape_b2)
    const tensor<f32, [4, 4]> scaled_w1 ← grad_weight1.multiply(lr_fill_w1)
    const tensor<f32, [4, 4]> scaled_b1 ← grad_bias1.multiply(lr_fill_b1)
    const tensor<f32, [4, 4]> scaled_w2 ← grad_weight2.multiply(lr_fill_w2)
    const tensor<f32, [4, 4]> scaled_b2 ← grad_bias2.multiply(lr_fill_b2)
    const tensor<f32, [4, 4]> new_weight1 ← weight1.subtract(scaled_w1)
    const tensor<f32, [4, 4]> new_bias1 ← bias1.subtract(scaled_b1)
    const tensor<f32, [4, 4]> new_weight2 ← weight2.subtract(scaled_w2)
    const tensor<f32, [4, 4]> new_bias2 ← bias2.subtract(scaled_b2)
    return tuple<tensor<f32, [4, 4]>, tensor<f32, [4, 4]>, tensor<f32, [4, 4]>, tensor<f32, [4, 4]>> [new_weight1, new_bias1, new_weight2, new_bias2]
}

# -------------------------------------------------------------------------
# train_step_bert_linear — SGD update of the 12 linear-projection BERT-tiny
#   trainable params (6×[8,8] weights + 6×[8] biases)
#   param' = param − lr·grad   (same math as the retired optimize.sgd_step_*)
#   12 explicit current params + 12 explicit trainable gradients + lr in;
#   explicit 12-tuple of updated params out, in the fragment's slot order
#   (wq,bq,wk,bk,wv,bv,wo,bo,wf1,bf1,wf2,bf2).
# -------------------------------------------------------------------------

fn train_step_bert_linear(tensor<f32, [8, 8]> wq, tensor<f32, [8]> bq, tensor<f32, [8, 8]> wk, tensor<f32, [8]> bk, tensor<f32, [8, 8]> wv, tensor<f32, [8]> bv, tensor<f32, [8, 8]> wo, tensor<f32, [8]> bo, tensor<f32, [8, 8]> wf1, tensor<f32, [8]> bf1, tensor<f32, [8, 8]> wf2, tensor<f32, [8]> bf2, tensor<f32, [8, 8]> gwq, tensor<f32, [8]> gbq, tensor<f32, [8, 8]> gwk, tensor<f32, [8]> gbk, tensor<f32, [8, 8]> gwv, tensor<f32, [8]> gbv, tensor<f32, [8, 8]> gwo, tensor<f32, [8]> gbo, tensor<f32, [8, 8]> gwf1, tensor<f32, [8]> gbf1, tensor<f32, [8, 8]> gwf2, tensor<f32, [8]> gbf2, f32 lr) → tuple<tensor<f32, [8, 8]>, tensor<f32, [8]>, tensor<f32, [8, 8]>, tensor<f32, [8]>, tensor<f32, [8, 8]>, tensor<f32, [8]>, tensor<f32, [8, 8]>, tensor<f32, [8]>, tensor<f32, [8, 8]>, tensor<f32, [8]>, tensor<f32, [8, 8]>, tensor<f32, [8]>> {
    const list<int> shape_w ← wq.shape()
    const list<int> shape_b ← bq.shape()
    const tensor<f32, []> seed ← vacua
    const tensor<f32, [8, 8]> lr_fill_w ← seed.create(lr, shape_w)
    const tensor<f32, [8]> lr_fill_b ← seed.create(lr, shape_b)
    const tensor<f32, [8, 8]> swq ← gwq.multiply(lr_fill_w)
    const tensor<f32, [8]> sbq ← gbq.multiply(lr_fill_b)
    const tensor<f32, [8, 8]> swk ← gwk.multiply(lr_fill_w)
    const tensor<f32, [8]> sbk ← gbk.multiply(lr_fill_b)
    const tensor<f32, [8, 8]> swv ← gwv.multiply(lr_fill_w)
    const tensor<f32, [8]> sbv ← gbv.multiply(lr_fill_b)
    const tensor<f32, [8, 8]> swo ← gwo.multiply(lr_fill_w)
    const tensor<f32, [8]> sbo ← gbo.multiply(lr_fill_b)
    const tensor<f32, [8, 8]> swf1 ← gwf1.multiply(lr_fill_w)
    const tensor<f32, [8]> sbf1 ← gbf1.multiply(lr_fill_b)
    const tensor<f32, [8, 8]> swf2 ← gwf2.multiply(lr_fill_w)
    const tensor<f32, [8]> sbf2 ← gbf2.multiply(lr_fill_b)
    const tensor<f32, [8, 8]> nwq ← wq.subtract(swq)
    const tensor<f32, [8]> nbq ← bq.subtract(sbq)
    const tensor<f32, [8, 8]> nwk ← wk.subtract(swk)
    const tensor<f32, [8]> nbk ← bk.subtract(sbk)
    const tensor<f32, [8, 8]> nwv ← wv.subtract(swv)
    const tensor<f32, [8]> nbv ← bv.subtract(sbv)
    const tensor<f32, [8, 8]> nwo ← wo.subtract(swo)
    const tensor<f32, [8]> nbo ← bo.subtract(sbo)
    const tensor<f32, [8, 8]> nwf1 ← wf1.subtract(swf1)
    const tensor<f32, [8]> nbf1 ← bf1.subtract(sbf1)
    const tensor<f32, [8, 8]> nwf2 ← wf2.subtract(swf2)
    const tensor<f32, [8]> nbf2 ← bf2.subtract(sbf2)
    return tuple<tensor<f32, [8, 8]>, tensor<f32, [8]>, tensor<f32, [8, 8]>, tensor<f32, [8]>, tensor<f32, [8, 8]>, tensor<f32, [8]>, tensor<f32, [8, 8]>, tensor<f32, [8]>, tensor<f32, [8, 8]>, tensor<f32, [8]>, tensor<f32, [8, 8]>, tensor<f32, [8]>> [nwq, nbq, nwk, nbk, nwv, nbv, nwo, nbo, nwf1, nbf1, nwf2, nbf2]
}

# -------------------------------------------------------------------------
# train_step_bert_layernorm — SGD update of the 6 LayerNorm BERT-tiny
#   trainable params (6×[8] per-channel scale/offset)
#   param' = param − lr·grad   (same math as the retired optimize.sgd_step_*)
#   6 explicit current params + 6 explicit trainable gradients + lr in;
#   explicit 6-tuple of updated params out, in the fragment's slot order
#   (ln1_s,ln1_o,ln2_s,ln2_o,ln3_s,ln3_o).
# -------------------------------------------------------------------------

fn train_step_bert_layernorm(tensor<f32, [8]> ln1_s, tensor<f32, [8]> ln1_o, tensor<f32, [8]> ln2_s, tensor<f32, [8]> ln2_o, tensor<f32, [8]> ln3_s, tensor<f32, [8]> ln3_o, tensor<f32, [8]> gln1_s, tensor<f32, [8]> gln1_o, tensor<f32, [8]> gln2_s, tensor<f32, [8]> gln2_o, tensor<f32, [8]> gln3_s, tensor<f32, [8]> gln3_o, f32 lr) → tuple<tensor<f32, [8]>, tensor<f32, [8]>, tensor<f32, [8]>, tensor<f32, [8]>, tensor<f32, [8]>, tensor<f32, [8]>> {
    const list<int> shape_ln ← ln1_s.shape()
    const tensor<f32, []> seed ← vacua
    const tensor<f32, [8]> lr_fill_ln ← seed.create(lr, shape_ln)
    const tensor<f32, [8]> sln1s ← gln1_s.multiply(lr_fill_ln)
    const tensor<f32, [8]> sln1o ← gln1_o.multiply(lr_fill_ln)
    const tensor<f32, [8]> sln2s ← gln2_s.multiply(lr_fill_ln)
    const tensor<f32, [8]> sln2o ← gln2_o.multiply(lr_fill_ln)
    const tensor<f32, [8]> sln3s ← gln3_s.multiply(lr_fill_ln)
    const tensor<f32, [8]> sln3o ← gln3_o.multiply(lr_fill_ln)
    const tensor<f32, [8]> nln1s ← ln1_s.subtract(sln1s)
    const tensor<f32, [8]> nln1o ← ln1_o.subtract(sln1o)
    const tensor<f32, [8]> nln2s ← ln2_s.subtract(sln2s)
    const tensor<f32, [8]> nln2o ← ln2_o.subtract(sln2o)
    const tensor<f32, [8]> nln3s ← ln3_s.subtract(sln3s)
    const tensor<f32, [8]> nln3o ← ln3_o.subtract(sln3o)
    return tuple<tensor<f32, [8]>, tensor<f32, [8]>, tensor<f32, [8]>, tensor<f32, [8]>, tensor<f32, [8]>, tensor<f32, [8]>> [nln1s, nln1o, nln2s, nln2o, nln3s, nln3o]
}

# =========================================================================
# PML4-U4 — Schedules + train/eval mode (explicit public controls)
# =========================================================================
#
# --- Contract (pml4-delivery.md PML4-U4) ---------------------------------
# Two explicit public controls for the training loop:
#
#   1. Schedula — the learning-rate schedule (warmup + cosine decay, the
#      accepted training-proof default). A pure config + one pure
#      evaluation, deterministic (no RNG, no hidden state):
#
#        lr(step) = vertex · step/warmup                      step < warmup
#        lr(step) = finis + (vertex − finis)·(1+cos(π·t))/2   step ≥ warmup
#      with t = (step − warmup)/(total − warmup) ∈ [0, 1], clamped to the
#      horizon (post-horizon lr = finis). A degenerate horizon
#      (total == warmup) is constant at the vertex. The schedule's lr at
#      step k is the lr the loop binds into the parameter's SgdStatum
#      (U3, lentus) before passus — the loop composition is U6's.
#
#   2. Modus — train/eval mode (the dropout/RNG policy gate). Explicit
#      mode argument only: forward evaluation consults the mode it is
#      CALLED with — no hidden global state (the shared-layer rule,
#      council "forward-functions-first"). In eval mode dropout is
#      identity (effective rate 0); in train mode the effective rate is
#      the configured rate. The stochastic dropout mask is generated from
#      an explicit RNG state — the U5 seed/RNG seam; the MODE CONTROL and
#      its deterministic rate policy are this unit's.
#
# --- Shared with the GPU-training lane's accepted facts -----------------
#   * warmup + cosine is the schedule default per the pml4 delivery open
#     questions ("default: warmup + cosine per accepted training proof").
#   * lr = 0.01 is the accepted MLP training proof's constant; the
#     schedule's peak (vertex) is the same lr the optimizer state (U3)
#     carries per parameter.
#   * dropout rate domain [0, 1] (fraction of units omitted); eval = no
#     dropout (the standard evaluation-policy identity).
#
# --- Evidence honesty (CTO Q2, hard) ------------------------------------
# This surface is the STRUCTURAL proof: the controls are pure functions
# (explicit arguments, deterministic, no hidden state) and are
# compile-validated + proven by the co-located proba. Executed VALUE
# identity (a schedule's numeric lr, the f32 cosine self-hosting vs the
# f64 oracle) is env-blocked tree-wide today (FMIR stepper /
# library-import gap — recorded residual). PML4-U4 is PARTIAL: schedule
# and policy numeric identity is deferred to a runtime-evidence gate
# (auditor-owned faber test path; oracle pins recorded in train.proba).

# -------------------------------------------------------------------------
# TrainError — typed error vocabulary of the training-loop controls.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------


@ public { }
union TrainError {
    SchedulaInvalida {
        string message
    },
    ModusIgnotus {
        string message
    },
    ExcutioInvalida {
        string message
    },
    PassusNegativus {
        string message
    },
    SemenInvalida {
        string message
    },
    ValorMala {
        string message
    },
    PositioInvalida {
        string message
    },
    StatumInane {
        string message
    },
    VersioIgnota {
        string message
    },
    WireMala {
        string message
    }
}

@ public { }
fn message(TrainError e) → string {
    match e {
        case SchedulaInvalida const message {
            return message
        }
        case ModusIgnotus const message {
            return message
        }
        case ExcutioInvalida const message {
            return message
        }
        case PassusNegativus const message {
            return message
        }
        case SemenInvalida const message {
            return message
        }
        case ValorMala const message {
            return message
        }
        case PositioInvalida const message {
            return message
        }
        case StatumInane const message {
            return message
        }
        case VersioIgnota const message {
            return message
        }
        case WireMala const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# Schedula — the learning-rate schedule config (warmup + cosine decay).
#   lentus_vertex — peak lr at the end of warmup (the lr the U3 state
#                   slot carries at the peak);
#   incalesco     — warmup steps (linear ramp 0 → vertex);
#   passus_total  — total scheduled steps (the decay horizon);
#   lentus_finis  — final lr after the cosine decay (≤ vertex).
# Construction fail-closed: finite non-negative rates, finis ≤ vertex,
# non-negative warmup, horizon ≥ 1 and ≥ warmup.
# -------------------------------------------------------------------------


@ public { }
class Schedule {
    f32 rate_vertex
    int warmup
    int total_steps
    f32 rate_end

    # Peak learning rate (end of warmup).
    fn rate_vertex() → f32 {
        return self.rate_vertex
    }

    # Warmup steps (linear ramp).
    fn warmup() → int {
        return self.warmup
    }

    # Total scheduled steps (decay horizon).
    fn total_steps() → int {
        return self.total_steps
    }

    # Final learning rate (post-decay).
    fn rate_end() → f32 {
        return self.rate_end
    }
}

@ public { }
fn construct_schedule(f32 rate_vertex, int warmup, int total_steps, f32 rate_end) → Schedule ⇥ TrainError {
    if not dtype.finite(rate_vertex) {
        throw variant SchedulaInvalida {message = "invalid peak learning rate"}
    }
    if not (not (rate_vertex ≺ 0.0)) {
        throw variant SchedulaInvalida {message = "invalid peak learning rate"}
    }
    if not dtype.finite(rate_end) {
        throw variant SchedulaInvalida {message = "invalid final learning rate"}
    }
    if not (not (rate_end ≺ 0.0)) {
        throw variant SchedulaInvalida {message = "invalid final learning rate"}
    }
    if not (not (rate_end ≻ rate_vertex)) {
        throw variant SchedulaInvalida {message = "final learning rate above peak"}
    }
    if not (not (warmup ≺ 0)) {
        throw variant SchedulaInvalida {message = "negative warmup steps"}
    }
    if not (not (total_steps ≺ 1)) {
        throw variant SchedulaInvalida {message = "schedule horizon must be at least one step"}
    }
    if not (not (total_steps ≺ warmup)) {
        throw variant SchedulaInvalida {message = "warmup exceeds the schedule horizon"}
    }
    return Schedule {rate_vertex = rate_vertex, warmup = warmup, total_steps = total_steps, rate_end = rate_end}
}

# π — the cosine-decay phase constant.
const f32 PI ← 3.141592653589793 ∷ f32

# cos via Taylor series. The schedule's phase is always in [0, π] (t ∈
# [0, 1]), so no range reduction is needed; 12 terms leave the remainder
# below f32 precision over that range (the attention.fab _cosinus
# precedent). At the horizon the series may undershoot by < 1e-4; the
# evaluation clamps the result to the true [finis, vertex] range.
@ private { }
fn _cos(f32 x) → f32 {
    var f32 term ← 1.0
    var f32 sum ← 1.0
    const f32 x2 ← x * x
    var int n ← 1
    while n ≺ 12 {
        term ← (term * (0.0 - x2)) / (((2 * n - 1) ↦ f32) * (2 * n ↦ f32))
        sum ← sum + term
        n ← n + 1
    }
    return sum
}

# -------------------------------------------------------------------------
# lentus_schedulata — the schedule evaluation: the deterministic learning
# rate at a step (warmup + cosine decay, see the contract above). Pure:
# explicit Schedula + step in, lr out; no RNG, no hidden state.
# -------------------------------------------------------------------------

@ public { }
fn scheduled_rate(Schedule s, int passus) → f32 ⇥ TrainError {
    if passus ≺ 0 {
        throw variant PassusNegativus {message = "schedule step must be non-negative"}
    }
    if passus ≺ s.warmup() then return s.rate_vertex() * ((passus ↦ f32) / (s.warmup() ↦ f32))
    var int passus_eff ← passus
    if passus_eff ≻ s.total_steps() {
        passus_eff ← s.total_steps()
    }
    if s.total_steps() ≻ s.warmup() {
        const f32 t ← ((passus_eff - s.warmup()) ↦ f32) / ((s.total_steps() - s.warmup()) ↦ f32)
        const f32 phase ← PI * t
        var f32 lr ← s.rate_end() + ((s.rate_vertex() - s.rate_end()) * (1.0 + _cos(phase))) / 2.0
        if lr ≺ s.rate_end() {
            lr ← s.rate_end()
        }
        if lr ≻ s.rate_vertex() {
            lr ← s.rate_vertex()
        }
        return lr
    }
    return s.rate_vertex()
}

# -------------------------------------------------------------------------
# Modus — train/eval mode. An EXPLICIT argument to any mode-dependent
# call: forward evaluation consults the mode it is called with, never a
# hidden global (the shared-layer rule). Names are the wire contract:
# "train" | "eval".
# -------------------------------------------------------------------------


@ public { }
union Mode {
    Disciplina,
    Aestimatio
}

# Canonical mode name (textus surface for probes and consumers).
@ public { }
fn mode_name(Mode m) → string {
    match m {
        case Disciplina {
            return "train"
        }
        case Aestimatio {
            return "eval"
        }
    }
}

@ private { }
fn _discipline(Mode m) → bool {
    match m {
        case Disciplina {
            return true
        }
        case Aestimatio {
            return false
        }
    }
}

# Train-mode predicate.
@ public { }
fn is_discipline(Mode m) → bool {
    return _discipline(m)
}

# Eval-mode predicate (dropout identity).
@ public { }
fn is_estimate(Mode m) → bool {
    return not _discipline(m)
}

# Construct a mode from its canonical name — fail closed on an unknown
# name (the probe-visible entry; enum variants do not cross module
# boundaries, dtype.fab SEM001 note).
@ public { }
fn mode(string nomen) → Mode ⇥ TrainError {
    if nomen ≡ "train" then return variant Disciplina
    if nomen ≡ "eval" then return variant Aestimatio
    throw variant ModusIgnotus {message = "unknown mode name"}
}

# -------------------------------------------------------------------------
# dropout_pars — the dropout/RNG policy gate. The effective dropout rate
# for a forward evaluation called with an explicit mode: eval → 0 (no
# dropout — the standard evaluation identity), train → the configured
# rate. The rate domain is [0, 1] (finite, fail closed). The stochastic
# mask applied at the effective rate comes from an explicit RNG state —
# the U5 seed/RNG seam; the deterministic mode gate is this unit's.
# -------------------------------------------------------------------------

@ public { }
fn dropout_probability(Mode m, f32 rate) → f32 ⇥ TrainError {
    if not dtype.finite(rate) {
        throw variant ExcutioInvalida {message = "dropout rate must be in [0, 1]"}
    }
    if rate ≺ 0.0 or rate ≻ 1.0 {
        throw variant ExcutioInvalida {message = "dropout rate must be in [0, 1]"}
    }
    if is_estimate(m) then return 0.0 ∷ f32
    return rate
}

# =========================================================================
# PML4-U5 — Seeds (RNG), checkpoint resume, metrics (pml4-delivery.md U5)
# =========================================================================
#
# --- Contract ------------------------------------------------------------
# Three pieces close the reproducibility contract:
#
#   1. Semen — the seed/RNG state (this unit owns the machinery U4's
#      dropout gate composes with). A xorshift64 generator (shifts + XOR
#      only, no multiply — no overflow concerns) over a nonzero i64
#      state; deterministic: the same seed produces the same sequence.
#      proximus() draws the next 64-bit value and advances the state;
#      proximus_f32() maps a draw to [0, 1) (sign-masked, top 52 bits,
#      uniform over the masked space — the f32 [0,1) contract). excutio()
#      is the dropout-mask composition: it takes the effective rate from
#      dropout_pars (U4) — eval mode is identity and the RNG is left
#      untouched — and in train mode applies a per-element Bernoulli mask
#      scaled by 1/(1−rate) (inverted dropout, so the eval identity
#      composes exactly). Deterministic given (tensor, seed, mode, rate).
#
#   2. Tabula — the checkpoint: epoch + step + RNG state + the U3
#      optimizer-state wire (carried VERBATIM — the envelope stays
#      autograd-free; the state wire is validated by its own schema,
#      optimize.deserializa, at resume). Versioned wire round-trip
#      ("train/checkpoint/1.0.0/<epoch>/<step>/<rng_state>/<state_wire>");
#      interrupted-resume failure is EXPLICIT: a truncated/malformed
#      checkpoint wire, an unknown schema, an invalid epoch/step, a zero
#      RNG state, or a missing state wire all fail closed at
#      deserialization; a corrupt embedded state wire fails closed at
#      optimize.deserializa (resume).
#
#   3. Metrics — see gradus:metrics (accuratezza + the per-step Metricum
#      record); defined values with a deterministic contract.
#
# --- Shared with the GPU-training lane's accepted facts -----------------
#   * checkpoint resume (state + RNG + epoch/step) versioned per the U3
#     wire precedent (slot wire, lossless float form, '/' and ';'
#     reserved); same fail-closed posture (capsule rule).
#   * dropout mask semantics: per-element Bernoulli(1−rate), scaled by
#     1/(1−rate) in train (inverted dropout) — the standard training
#     policy the U4 dropout_pars gate controls.
#
# --- Evidence honesty (CTO Q2, hard) ------------------------------------
# This surface is the STRUCTURAL proof: the generator recurrence, the
# mask policy, and the checkpoint round-trip are compile-validated and
# proven by the co-located proba (f64 oracle pins for the xorshift
# recurrence, the [0,1) draws, and a concrete dropout-mask output).
# Executed VALUE identity is env-blocked tree-wide today (FMIR stepper /
# library-import gap — recorded residual). PML4-U5 is PARTIAL: numeric
# identity is deferred to a runtime-evidence gate (auditor-owned faber
# test path; oracle pins recorded in train.proba).

# Schema version of this module's wire forms (rng, checkpoint).
const string schema_versio ← "1.0.0"

# -------------------------------------------------------------------------
# Semen — the deterministic RNG state. A xorshift64 state (nonzero i64);
# the same seed reproduces the same sequence (reproducibility).
# -------------------------------------------------------------------------


@ public { }
class Seed {
    int status

    # The 64-bit generator state (nonzero — xorshift64 degenerates at 0).
    fn status() → int {
        return self.status
    }
}

# Seed the generator. Zero is rejected fail-closed (xorshift64 maps 0 → 0).
@ public { }
fn construct_seed(int seed) → Seed ⇥ TrainError {
    if seed ≡ 0 {
        throw variant SemenInvalida {message = "seed must be non-zero"}
    }
    return Seed {status = seed}
}

# One RNG draw: the next 64-bit value + the advanced state.

@ public { }
class Draw {
    int payload
    Seed seed

    # The drawn value.
    fn payload() → int {
        return self.payload
    }

    # The advanced generator state.
    fn seed() → Seed {
        return self.seed
    }
}

# xorshift64 step: x ^= x<<13; x ^= x>>7; x ^= x<<17. Shifts + XOR only —
# no multiply, no overflow concerns. Bitwise on the i64 carrier.
@ public { }
fn next(Seed s) → Draw {
    var int x ← s.status()
    x ← x ⊻ x ⇐ 13
    x ← x ⊻ x ⇒ 7
    x ← x ⊻ x ⇐ 17
    return Draw {payload = x, seed = Seed {status = x}}
}

# Sign-bit mask: the [0,1) draw uses only the low 63 bits (sign-agnostic).
const int MASK_63 ← 9223372036854775807

# 2^52 as f32 (exact power of two) — the draw denominator.
const f32 DUO_52 ← 4503599627370496.0 ∷ f32

# One f32 draw in [0, 1): the top 52 bits of the sign-masked state over
# 2^52. Uniform over the masked space; deterministic (same seed → same
# draws). f32 rounding is ~1e-7 — the proba pins compare within 1e-6.

@ public { }
class DrawF32 {
    f32 payload
    Seed seed

    # The drawn value in [0, 1).
    fn payload() → f32 {
        return self.payload
    }

    # The advanced generator state.
    fn seed() → Seed {
        return self.seed
    }
}

@ public { }
fn next_f32(Seed s) → DrawF32 {
    const Draw f ← next(s)
    const f32 v ← (((f.payload() ∧ MASK_63) ⇒ 11) ↦ f32) / DUO_52
    return DrawF32 {payload = v, seed = f.seed()}
}

# -------------------------------------------------------------------------
# excutio — the dropout-mask composition (the U5 machinery the U4
# dropout_pars gate controls). Eval mode (or rate 0) is identity and the
# RNG is untouched — the standard evaluation policy, deterministic. Train
# mode applies a per-element Bernoulli(1−rate) mask scaled by 1/(1−rate)
# (inverted dropout): x_i ← x_i·m_i/(1−rate), m_i = 1 if r_i ≥ rate.
# The mask is drawn from the explicit Semen state, which advances; the
# same (tensor, seed, mode, rate) reproduces the same output.
# -------------------------------------------------------------------------


@ public { }
class Dropout {
    tensor.Tensor payload
    Seed seed

    # The masked tensor.
    fn payload() → tensor.Tensor {
        return self.payload
    }

    # The advanced RNG state.
    fn seed() → Seed {
        return self.seed
    }
}

@ public { }
fn dropout(tensor.Tensor x, Seed s, Mode m, f32 rate) → Dropout ⇥ TrainError {
    const f32 par ← dropout_probability(m, rate)
    if par ≡ 0.0 ∷ f32 then return Dropout {payload = x, seed = s}
    const f32 scala ← 1.0 / (1.0 - par)
    const list<f32> datos ← x.data
    var list<f32> novus ← vacua
    var Seed s2 ← s
    for from datos const v {
        const DrawF32 f ← next_f32(s2)
        s2 ← f.seed()
        if f.payload() ≥ par {
            novus.append(v * scala)
        }
        else {
            novus.append(0.0 ∷ f32)
        }
    }
    var tensor.Tensor renovatus
    do {
        renovatus ← tensor.construct(novus, x.shape())
    }
    catch err {
        throw variant ValorMala {message = tensor.message(err)}
    }
    return Dropout {payload = renovatus, seed = s2}
}

# -------------------------------------------------------------------------
# RNG wire — versioned, exact round-trip.
# -------------------------------------------------------------------------

@ public { }
fn serialize_seed(Seed s) → string {
    return (("train/rng/" + schema_versio) + "/") + (s.status() ↦ string)
}

@ public { }
fn deserialize_seed(string wire) → Seed ⇥ TrainError {
    const list<string> partes ← wire.split("/")
    if partes.length() ≠ 4 {
        throw variant WireMala {message = "malformed rng wire"}
    }
    if partes.get(0) coalesce "" ≠ "train" {
        throw variant WireMala {message = "unknown rng marker"}
    }
    if partes.get(1) coalesce "" ≠ "rng" {
        throw variant WireMala {message = "unknown rng marker"}
    }
    if partes.get(2) coalesce "" ≠ schema_versio {
        throw variant VersioIgnota {message = "unknown rng schema version"}
    }
    const string status_textus ← partes.get(3) coalesce ""
    if status_textus.length() ≡ 0 {
        throw variant WireMala {message = "malformed rng state"}
    }
    var int status ← 0
    do {
        status ← status_textus ↦ int
    }
    catch err {
        throw variant WireMala {message = "malformed rng state"}
    }
    return construct_seed(status)
}

# -------------------------------------------------------------------------
# Tabula — the checkpoint: epoch + step + RNG state + the optimizer-state
# wire (U3, carried verbatim). The envelope is autograd-free; the state
# wire validates against ITS OWN schema at resume (optimize.deserializa).
# -------------------------------------------------------------------------


@ public { }
class Checkpoint {
    int age
    int step
    Seed rng
    string state_wire

    # Epoch.
    fn age() → int {
        return self.age
    }

    # Step within the epoch.
    fn step() → int {
        return self.step
    }

    # The RNG state (deterministic continuation after resume).
    fn rng() → Seed {
        return self.rng
    }

    # The embedded U3 optimizer-state wire (verbatim).
    fn state_wire() → string {
        return self.state_wire
    }
}

# Build a checkpoint. Epoch/step are non-negative; the state wire is
# non-empty (fail closed). The RNG is already a validated Semen.
@ public { }
fn construct_checkpoint(int age, int passus, Seed rng, string state_wire) → Checkpoint ⇥ TrainError {
    if age ≺ 0 {
        throw variant PositioInvalida {message = "epoch must be non-negative"}
    }
    if passus ≺ 0 {
        throw variant PositioInvalida {message = "step must be non-negative"}
    }
    if state_wire.length() ≡ 0 {
        throw variant StatumInane {message = "checkpoint state wire is empty"}
    }
    return Checkpoint {age = age, step = passus, rng = rng, state_wire = state_wire}
}

# Field-wise checkpoint equality — the round-trip predicate.
@ public { }
fn checkpoint_equal(Checkpoint a, Checkpoint b) → bool {
    if a.age() ≠ b.age() then return false
    if a.step() ≠ b.step() then return false
    if a.rng().status() ≠ b.rng().status() then return false
    if a.state_wire() ≠ b.state_wire() then return false
    return true
}

# -------------------------------------------------------------------------
# Checkpoint wire — versioned, exact round-trip. The fixed prefix carries
# marker/schema/epoch/step/rng-state; the embedded optimizer-state wire is
# the '/' tail (joined verbatim from the trailing segments).
# -------------------------------------------------------------------------

@ public { }
fn serialize_checkpoint(Checkpoint c) → string {
    var string out ← (((((((("train/checkpoint/" + schema_versio) + "/") + (c.age() ↦ string)) + "/") + (c.step() ↦ string)) + "/") + (c.rng().status() ↦ string)) + "/") + c.state_wire()
    return out
}

# All-digits predicate for wire integer fields (epoch, step).
@ private { }
fn _digit(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _digit(s.get(i)) then return false
        i ← i + 1
    }
    return true
}

@ public { }
fn deserialize_checkpoint(string wire) → Checkpoint ⇥ TrainError {
    const list<string> partes ← wire.split("/")
    if partes.length() ≺ 7 {
        throw variant WireMala {message = "malformed checkpoint wire"}
    }
    if partes.get(0) coalesce "" ≠ "train" {
        throw variant WireMala {message = "unknown checkpoint marker"}
    }
    if partes.get(1) coalesce "" ≠ "checkpoint" {
        throw variant WireMala {message = "unknown checkpoint marker"}
    }
    if partes.get(2) coalesce "" ≠ schema_versio {
        throw variant VersioIgnota {message = "unknown checkpoint schema version"}
    }
    const string aetas_textus ← partes.get(3) coalesce ""
    const string passus_textus ← partes.get(4) coalesce ""
    if not _numeric(aetas_textus) {
        throw variant WireMala {message = "malformed epoch in checkpoint wire"}
    }
    if not _numeric(passus_textus) {
        throw variant WireMala {message = "malformed step in checkpoint wire"}
    }
    var int age ← 0
    var int passus ← 0
    do {
        age ← aetas_textus ↦ int
    }
    catch err {
        throw variant WireMala {message = "malformed epoch in checkpoint wire"}
    }
    do {
        passus ← passus_textus ↦ int
    }
    catch err {
        throw variant WireMala {message = "malformed step in checkpoint wire"}
    }
    const string status_textus ← partes.get(5) coalesce ""
    if status_textus.length() ≡ 0 {
        throw variant WireMala {message = "malformed rng state in checkpoint wire"}
    }
    var int status ← 0
    do {
        status ← status_textus ↦ int
    }
    catch err {
        throw variant WireMala {message = "malformed rng state in checkpoint wire"}
    }
    const Seed rng ← construct_seed(status)
    # The embedded optimizer-state wire is the '/' tail, joined verbatim.
    var string state_wire ← ""
    var int i ← 6
    while i ≺ partes.length() {
        if i ≻ 6 {
            state_wire ← state_wire + "/"
        }
        state_wire ← state_wire + partes.get(i) coalesce ""
        i ← i + 1
    }
    if state_wire.length() ≡ 0 {
        throw variant StatumInane {message = "checkpoint state wire is empty"}
    }
    return Checkpoint {age = age, step = passus, rng = rng, state_wire = state_wire}
}
