+++
locale = "en"
+++
# Training error vocabulary retained for callers of gradus:train.
# Mode and dropout are owned by gradus:nn; checkpointing is owned by
# gradus:checkpoint. Each leaf declares its own operation error type.
#
import from "gradus:tensor" tensor

@ public
union TrainError {
    @ shared
    string message

    UnknownMode,
    InvalidDropout,
    InvalidSeed,
    BadPayload,
    InvalidPosition,
    EmptyState,
    UnknownVersion,
    BadWire,
    TensorFailure {
        tensor.TensorError inner
    }
}
