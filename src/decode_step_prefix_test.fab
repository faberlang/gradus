+++ toml
locale = "en"

+++ faber test
# Co-located tests for prefix-bounded decode_step softmax kernels (#74).

import from "gradus:decode_step" let ds

fn close(f32 a, f32 b) → bool {
    return (a - b).abs() ≺ 0.0002
}

test "decode_step row_softmax_prefix matches row_softmax on masked scores and handles empty/full prefixes" {
    let tensor<f32, [2]> hdom ← tf32[2] {}
    let tensor<f32, [2, 6]> hcdom ← tf32[2, 6] {}
    mut tensor<f32, [4]> q ← tf32[4] {}
    mut tensor<f32, [6, 2]> kc ← tf32[6, 2] {}
    mut tensor<f32, [2, 6]> sc ← tf32[2, 6] {}
    mut tensor<f32, [2, 6]> pr_full ← tf32[2, 6] {}
    mut tensor<f32, [2, 6]> pr_pref ← tf32[2, 6] {}
    q[[0]] ← 1.2
    q[[1]] ← -0.4
    q[[2]] ← 0.5
    q[[3]] ← 1.1
    for range 0‥6 let c {
        kc[[c, 0]] ← ((c + 1) ↦ f32) * 0.3
        kc[[c, 1]] ← ((5 - c) ↦ f32) * 0.2
    }
    ds.attn_scores(hcdom, q, kc, mut sc, 2, 2, 2, 0.5)
    ds.row_softmax(sc, mut pr_full)
    ds.row_softmax_prefix(hdom, sc, mut pr_pref, 3)
    for range 0‥2 let h {
        for range 0‥6 let c {
            assert close(pr_pref[[h, c]], pr_full[[h, c]])
        }
        assert pr_pref[[h, 3]] ≡ (0.0 ∷ f32)
        assert pr_pref[[h, 5]] ≡ (0.0 ∷ f32)
    }

    # active_cols >= C via row_softmax_active agrees with row_softmax.
    mut tensor<f32, [2, 6]> sc_all ← tf32[2, 6] {}
    mut tensor<f32, [2, 6]> pr_all_ref ← tf32[2, 6] {}
    mut tensor<f32, [2, 6]> pr_all_act ← tf32[2, 6] {}
    ds.attn_scores(hcdom, q, kc, mut sc_all, 5, 2, 2, 0.5)
    ds.row_softmax(sc_all, mut pr_all_ref)
    ds.row_softmax_active(hdom, sc_all, mut pr_all_act, 6)
    for range 0‥2 let h {
        for range 0‥6 let c {
            assert close(pr_all_act[[h, c]], pr_all_ref[[h, c]])
        }
    }

    # active_cols <= 0 zeroes the output rows cleanly.
    ds.row_softmax_prefix(hdom, sc_all, mut pr_pref, 0)
    for range 0‥2 let h {
        for range 0‥6 let c {
            assert pr_pref[[h, c]] ≡ (0.0 ∷ f32)
        }
    }
}

test "decode_step row_softmax_prefix_batch matches row_softmax on causal and block-diffusion scores" {
    # B=3, active_b=2, H=2, C=6 -> BH=6
    let tensor<f32, [6]> bhdom ← tf32[6] {}
    let tensor<f32, [6, 6]> dom ← tf32[6, 6] {}
    mut tensor<f32, [3, 4]> q ← tf32[3, 4] {}
    mut tensor<f32, [6, 2]> kc ← tf32[6, 2] {}
    mut tensor<f32, [6, 6]> sc ← tf32[6, 6] {}
    mut tensor<f32, [6, 6]> pr_ref ← tf32[6, 6] {}
    mut tensor<f32, [6, 6]> pr_pref ← tf32[6, 6] {}

    for range 0‥3 let b {
        for range 0‥4 let j {
            q[[b, j]] ← ((b + j + 1) ↦ f32) * 0.25
        }
    }
    for range 0‥6 let c {
        for range 0‥2 let d {
            kc[[c, d]] ← ((c * 2 + d + 1) ↦ f32) * 0.15
        }
    }

    # Causal: pos=1, active_b=2, heads=2, blk=1 -> b=0 attends [0..2), b=1 attends [0..3), b=2 zeroed
    ds.attn_scores_batch(dom, q, kc, mut sc, 1, 2, 2, 2, 0.5, 2, 1)
    ds.row_softmax(sc, mut pr_ref)
    ds.row_softmax_prefix_batch(bhdom, sc, mut pr_pref, 1, 2, 2, 1, 6)
    for range 0‥4 let row {
        for range 0‥6 let c {
            assert close(pr_pref[[row, c]], pr_ref[[row, c]])
        }
    }
    for range 4‥6 let row {
        for range 0‥6 let c {
            assert pr_pref[[row, c]] ≡ (0.0 ∷ f32)
        }
    }

    # Block diffusion: pos=1, active_b=3, heads=2, blk=2, limit_cols=5
    ds.attn_scores_batch(dom, q, kc, mut sc, 1, 2, 2, 2, 0.5, 3, 2)
    ds.row_softmax(sc, mut pr_ref)
    ds.row_softmax_prefix_batch(bhdom, sc, mut pr_pref, 1, 3, 2, 2, 6)
    for range 0‥6 let row {
        for range 0‥6 let c {
            assert close(pr_pref[[row, c]], pr_ref[[row, c]])
        }
    }
}
