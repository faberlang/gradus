+++
locale = "en"
+++
# Batched prefill: T prompt tokens of a llama-family decoder in one pass per layer.
#
# Public import: import from "gradus:prefill" prefill

import from "gradus:decode_step" ds
#
# The decode path (`gradus:decode_token` / `gradus:decode_step`) runs one token per
# launch chain, so a prompt of T tokens costs T chains. Here every step of a layer
# runs over all T rows at once: the projections are `⇇ ·` matrix products over the
# stacked weights in [in, out] layout (radix corpus/inference prefill-layer form 1;
# `transpose_copy` builds them at load from the decode layout), the norms
# are the language's row operation, and attention is batched `⇇ ·` products over the
# key/value groups (scores, the masked row softmax, the context). The K/V rows of all
# T positions are written to the caches in one launch, so decoding continues from
# position T exactly as if the prompt had been fed token by token. The prompt starts
# at position 0.
#
# Shapes (D hidden, QD query width, KVD key/value width, F ffn width, H query heads,
# C cache rows, T prompt rows, R = QD + 2 * KVD, G = 2 * F, KG key/value
# groups, GH = H / KG query heads per group, DH head width). The weights are those of `layer_wide`
# transposed to [in, out]: wqkvt [D, R] (q, k, v stacked), wot [QD, D], wgut [D, G]
# (gate and up stacked), wdt [F, D].
# Scratch (the caller allocates each once per prompt):
#   xn [T, D]   qkvr [T, R]   qkv [T, R]   qg [KG, GH, T, DH]   kt [KG, DH, T]   vg [KG, T, DH]
#   s4 [KG, GH, T, T]   p4 [KG, GH, T, T]   cg [KG, GH, T, DH]   ctx [T, QD]   ao [T, D]
#   h1 [T, D]   gu [T, G]   act [T, F]   dn [T, D]

# ---------------------------------------------------------------------------
# Kernels
# ---------------------------------------------------------------------------

# Embedding gather of every prompt row: gro[t, j] = grtable[grids[t], j].
@ kernel
@ public
fn gather_rows<size V, size D, size T>(tensor<f32, [V, D]> grtable, tensor<i32, [T]> grids, mut tensor<f32, [T, D]> gro) → void {
    for from gro at [t, j] thread lane let e {
        gro[[t, j]] ← grtable[[grids[t], j]]
    }
}

# RMSNorm of every row: rro[t, :] = rrx[t, :] * rrw / sqrt(mean(rrx[t, :]^2) + rreps).
@ kernel relaxed
@ public
fn rms_norm_rows<size T, size D>(tensor<f32, [T, D]> rrx, tensor<f32, [D]> rrw, mut tensor<f32, [T, D]> rro, f32 rreps) → void {
    rro ⇇ rrx.norm_rms(axis 1, rreps, rrw)
}

# Row-batched projection against a weight stored [in, out]: mpy = mpx · mpw.
@ kernel
@ public
fn matmul<size T, size K, size N>(tensor<f32, [T, K]> mpx, tensor<f32, [K, N]> mpw, mut tensor<f32, [T, N]> mpy) → void {
    mpy ⇇ mpx · mpw
}

# A weight copied into the [in, out] layout the plain product reads: tco[k, n] = tcw[n, k].
# Load-time, once per weight.
@ kernel
@ public
fn transpose_copy<size N, size K>(tensor<f32, [N, K]> tcw, mut tensor<f32, [K, N]> tco) → void {
    for from tco at [k, n] thread lane let e {
        tco[[k, n]] ← tcw[[n, k]]
    }
}

# RoPE of every row of the stacked q/k/v projection, row t at position rrpos + t:
# `qkv_rope` (gradus:decode_step) per row. Rows' columns [0, rrqd) are query,
# [rrqd, rrqd + rrkv) key, the rest value (copied). `rrnorm` 1 = consecutive pairs,
# 0 = rotate-half pairs.
@ kernel relaxed
@ public
fn rope_rows<size T, size R>(tensor<f32, [T, R]> rrx, mut tensor<f32, [T, R]> rro, i32 rrpos, i32 rrqd, i32 rrkv, i32 rrdh, f32 rrlntheta, i32 rrnorm) → void {
    for from rrx at [t, j] thread lane let own {
        if rrqd ≥ 0 and rrqd ≤ 1000000 and rrkv ≥ 0 and rrkv ≤ 1000000 and rrdh ≥ 2 and rrdh ≤ 1920 {
            let i32 hf ← rrdh / 2
            if j ≥ rrqd + rrkv {
                rro[[t, j]] ← own
            }
            else {
                let i32 jj ← j % rrdh
                mut i32 partner ← 0
                mut i32 pidx ← 0
                mut bool first ← false
                if rrnorm ≡ 1 {
                    pidx ← jj / 2
                    first ← jj % 2 ≡ 0
                    if first {
                        partner ← j + 1
                    }
                    else {
                        partner ← j - 1
                    }
                }
                else {
                    pidx ← jj % hf
                    first ← jj ≺ hf
                    if first {
                        partner ← j + hf
                    }
                    else {
                        partner ← j - hf
                    }
                }
                let f32 other ← rrx[[t, partner]]
                let f32 freq ← (-(pidx ↦ f32) / (hf ↦ f32) * rrlntheta).exp()
                let f32 ang ← ((rrpos + t) ↦ f32) * freq
                let f32 cs ← ang.cos()
                let f32 sn ← ang.sin()
                if first {
                    rro[[t, j]] ← own * cs - other * sn
                }
                else {
                    rro[[t, j]] ← other * sn + own * cs
                }
            }
        }
    }
}

# K/V cache rows rkpos .. rkpos + T - 1 from the rotated q/k/v rows: key row
# rkpos + t is rkqkv[t, rkqd .. rkqd + K), value row rkqkv[t, rkqd + K .. rkqd + 2K).
# The key cache is the lane domain (a lane stores only at its own coordinate); rows
# outside the prompt's positions are left unchanged.
@ kernel
@ public
fn kv_write_rows<size T, size C, size K, size R>(tensor<f32, [T, R]> rkqkv, mut tensor<f32, [C, K]> rkkc, mut tensor<f32, [C, K]> rkvc, i32 rkpos, i32 rkqd) → void {
    for from rkkc at [c, j] thread lane let e {
        let i32 t ← c - rkpos
        if rkqd ≥ 0 and rkqd ≤ 1000000 and t ≥ 0 and t ≺ T {
            rkkc[[c, j]] ← rkqkv[[t, rkqd + j]]
            rkvc[[c, j]] ← rkqkv[[t, rkqd + K + j]]
        }
    }
}

# Attention over the prompt (it starts at position 0, so a query attends to the
# prompt rows at or before it and to nothing else), heads on their own axis: KG
# key/value groups, GH query heads per group, DH head width. Each head's scores are
# one [T, T] matrix, so `softmax_causal` masks it by its own row (the query):
#
#   qg [KG, GH, T, DH]  (scaled by 1 / sqrt(DH))   kt [KG, DH, T]   vg [KG, T, DH]
#   s4 = qg · kt              [KG, GH, T, T]
#   p4 = s4.softmax_causal()  [KG, GH, T, T]
#   cg = p4 · vg              [KG, GH, T, DH], merged back to ctx [T, QD]

# Query heads by key/value group, scaled: hqg[g, hh, t, d] = hqkv[t, (g * group + hh) * dh + d] * scale.
@ kernel
@ public
fn q_heads<size T, size R, size KG, size GH, size DH>(tensor<f32, [T, R]> hqkv, mut tensor<f32, [KG, GH, T, DH]> hqg, i32 hqgroup, i32 hqdh, f32 hqscale) → void {
    for from hqg at [g, hh, t, d] thread lane let old {
        if hqgroup ≥ 1 and hqgroup ≤ 64 and hqdh ≥ 1 and hqdh ≤ 960 {
            hqg[[g, hh, t, d]] ← hqkv[[t, (g * hqgroup + hh) * hqdh + d]] * hqscale
        }
    }
}

# Keys per group, transposed: hkt[g, d, t] = hkqkv[t, hkqd + g * dh + d].
@ kernel
@ public
fn k_heads_t<size T, size R, size KG, size DH>(tensor<f32, [T, R]> hkqkv, mut tensor<f32, [KG, DH, T]> hkt, i32 hkqd, i32 hkdh) → void {
    for from hkt at [g, d, t] thread lane let old {
        if hkqd ≥ 0 and hkqd ≤ 1000000 and hkdh ≥ 1 and hkdh ≤ 960 {
            hkt[[g, d, t]] ← hkqkv[[t, hkqd + g * hkdh + d]]
        }
    }
}

# Values per group: hvg[g, t, d] = hvqkv[t, hvqd + hvkvd + g * dh + d].
@ kernel
@ public
fn v_heads<size T, size R, size KG, size DH>(tensor<f32, [T, R]> hvqkv, mut tensor<f32, [KG, T, DH]> hvg, i32 hvqd, i32 hvkvd, i32 hvdh) → void {
    for from hvg at [g, t, d] thread lane let old {
        if hvqd ≥ 0 and hvqd ≤ 1000000 and hvkvd ≥ 0 and hvkvd ≤ 1000000 and hvdh ≥ 1 and hvdh ≤ 960 {
            hvg[[g, t, d]] ← hvqkv[[t, hvqd + hvkvd + g * hvdh + d]]
        }
    }
}

# Grouped product: gpo[g, h] = gpa[g, h] · gpb[g], the key/value group shared by its heads.
@ kernel
@ public
fn group_matmul<size KG, size GH, size M, size K, size N>(tensor<f32, [KG, GH, M, K]> gpa, tensor<f32, [KG, K, N]> gpb, mut tensor<f32, [KG, GH, M, N]> gpo) → void {
    gpo ⇇ gpa · gpb
}

# Causal softmax of every head's [T, T] scores: row t keeps columns 0 ..= t.
@ kernel relaxed
@ public
fn softmax_causal_heads<size KG, size GH, size T>(tensor<f32, [KG, GH, T, T]> scx, mut tensor<f32, [KG, GH, T, T]> sco) → void {
    sco ⇇ scx.softmax_causal()
}

# Context heads back to rows: mhctx[t, h * dh + d] = mhcg[h / group, h % group, t, d].
@ kernel
@ public
fn merge_heads<size KG, size GH, size DH, size T, size QD>(tensor<f32, [KG, GH, T, DH]> mhcg, mut tensor<f32, [T, QD]> mhctx, i32 mhgroup, i32 mhdh) → void {
    for from mhctx at [t, j] thread lane let old {
        if mhgroup ≥ 1 and mhgroup ≤ 64 and mhdh ≥ 1 and mhdh ≤ 960 {
            let i32 h ← j / mhdh
            mhctx[[t, j]] ← mhcg[[h / mhgroup, h % mhgroup, t, j % mhdh]]
        }
    }
}

# Residual add of every row: rao[t, j] = raa[t, j] + rab[t, j].
@ kernel
@ public
fn add_rows<size T, size D>(tensor<f32, [T, D]> raa, tensor<f32, [T, D]> rab, mut tensor<f32, [T, D]> rao) → void {
    for from raa at [t, j] thread lane let a {
        rao[[t, j]] ← a + rab[[t, j]]
    }
}

# SwiGLU of every row of the stacked gate/up projection: swo[t, j] =
# silu(swgu[t, j]) * swgu[t, F + j].
@ kernel relaxed
@ public
fn swiglu_rows<size T, size F, size G>(tensor<f32, [T, G]> swgu, mut tensor<f32, [T, F]> swo) → void {
    for from swo at [t, j] thread lane let e {
        if G ≡ F + F {
            let f32 g ← swgu[[t, j]]
            swo[[t, j]] ← (g / (1.0 + (-g).exp())) * swgu[[t, F + j]]
        }
    }
}

# One row of a [T, D] tensor: tro[j] = trx[trrow, j].
@ kernel
@ public
fn take_row<size T, size D>(tensor<f32, [T, D]> trx, mut tensor<f32, [D]> tro, i32 trrow) → void {
    for from tro at [j] thread lane let e {
        if trrow ≥ 0 and trrow ≺ T {
            tro[[j]] ← trx[[trrow, j]]
        }
    }
}

# ---------------------------------------------------------------------------
# One layer over T prompt rows
# ---------------------------------------------------------------------------

# hout = layer(hin) for the T prompt rows at positions 0 .. T - 1, writing their K/V
# cache rows.
# 19 launches, whatever T is.
@ public
fn prefill_layer<size D, size QD, size KVD, size F, size C, size T, size R, size G, size KG, size GH, size DH>(
    tensor<f32, [T, D]> hin,
    mut tensor<f32, [T, D]> hout,
    tensor<f32, [D]> anorm,
    tensor<f32, [D, R]> wqkvt,
    tensor<f32, [QD, D]> wot,
    tensor<f32, [D]> fnorm,
    tensor<f32, [D, G]> wgut,
    tensor<f32, [F, D]> wdt,
    mut tensor<f32, [C, KVD]> kin,
    mut tensor<f32, [C, KVD]> vin,
    mut tensor<f32, [T, D]> xn,
    mut tensor<f32, [T, R]> qkvr,
    mut tensor<f32, [T, R]> qkv,
    mut tensor<f32, [KG, GH, T, DH]> qg,
    mut tensor<f32, [KG, DH, T]> kt,
    mut tensor<f32, [KG, T, DH]> vg,
    mut tensor<f32, [KG, GH, T, T]> s4,
    mut tensor<f32, [KG, GH, T, T]> p4,
    mut tensor<f32, [KG, GH, T, DH]> cg,
    mut tensor<f32, [T, QD]> ctx,
    mut tensor<f32, [T, D]> ao,
    mut tensor<f32, [T, D]> h1,
    mut tensor<f32, [T, G]> gu,
    mut tensor<f32, [T, F]> act,
    mut tensor<f32, [T, D]> dn,
    i32 pqd,
    i32 pkvd,
    i32 pdh,
    i32 pgroup,
    i32 prope,
    f32 peps,
    f32 plntheta,
    f32 pscale
) → void {
    rms_norm_rows(hin, anorm, mut xn, peps)
    matmul(xn, wqkvt, mut qkvr)
    rope_rows(qkvr, mut qkv, 0, pqd, pkvd, pdh, plntheta, prope)
    kv_write_rows(qkv, mut kin, mut vin, 0, pqd)
    q_heads(qkv, mut qg, pgroup, pdh, pscale)
    k_heads_t(qkv, mut kt, pqd, pdh)
    v_heads(qkv, mut vg, pqd, pkvd, pdh)
    group_matmul(qg, kt, mut s4)
    softmax_causal_heads(s4, mut p4)
    group_matmul(p4, vg, mut cg)
    merge_heads(cg, mut ctx, pgroup, pdh)
    matmul(ctx, wot, mut ao)
    add_rows(hin, ao, mut h1)
    rms_norm_rows(h1, fnorm, mut xn, peps)
    matmul(xn, wgut, mut gu)
    swiglu_rows(gu, mut act)
    matmul(act, wdt, mut dn)
    add_rows(h1, dn, mut hout)
}
