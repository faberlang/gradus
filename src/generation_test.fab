        }
    }
    test "ordinary-chat non-repeating prompt reproduces the pinned dense stream" {
        let _ trap_result_12 ← trap {
            let list<int> tokens ← corpus_dense(corpus_generation(), CORPUS_CHAT_PROMPT, decoder.eog_stop())
            assert tokens ≡ CORPUS_CHAT_STREAM
        }
