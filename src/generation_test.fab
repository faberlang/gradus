            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
    test "custom artifact EOG ids drive dense termination" {
        let _ trap_result_11b ← trap {
            let list<int> tokens ← corpus_dense(corpus_generation_with_eog([1]), CORPUS_CHAT_PROMPT, decoder.eog_stop())
