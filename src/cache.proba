# Co-located package test for cache.fab (PML5-U2 — KV-cache values and
# mutation rules). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * the typed logical value — KVCache (model / model version / execution
#     config / tokenizer identity / exact token history / layer count /
#     dtype / layout + the [positions, dim] f32 K/V + the generation
#     counter); construction fail-closed (empty or wire-unsafe identity
#     fields, layer/dim below one) — causa identity.
#   * the declared mutation rules — appende extends by exactly ONE
#     position (strictly sequential: the K/V row count equals the history
#     length) and bumps the generation; the append/readback arithmetic is
#     exact concatenation (pins are EXACT — the K/V pass through
#     bit-preserved); redintegra resets to a fresh cache (same identity
#     fields, empty history + K/V, versio 1).
#   * the cache identity key per the MD-A9 precedent (IdentitasCache:
#     model, version, execution config, tokenizer, exact prefix, position
#     span, layer count, dtype, layout) — exact field pins + the versioned
#     wire round-trip (with the documented "-" sentinel for the empty
#     history) + fail-closed rejections.
#   * determinism — equal inputs produce equal caches (pure, no hidden
#     state; cache_aequus field-wise).
#
# Oracle pins: the append/readback arithmetic is concatenation (no
# rounding), so the pins are EXACT f32 values (stronger than the
# tolerance rows); the identity-key facts are exact textus/numerus pins.
# No executed value is claimed (CTO Q2); the auditor-owned
# runtime-evidence gate compares executed append/readback against these
# exact pins.
#
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/cache.proba` proves the suite
# type-checks. Execution of proba bodies is env-blocked tree-wide today
# (recorded residual); this suite is the compile-level proof of the
# contract.

importa ex "gradus:cache" privata cache
importa ex "gradus:tensor" privata tensor
importa ex "gradus:math" privata math

# ---- helpers (the loss.proba / decode.proba pattern)

# Build a staged tensor, swallowing the never-firing construction errors.
functio tene(lista<f32> datos, lista<numerus> forma) → tensor.Tensor {
    varia tensor.Tensor t
    fac {
        t ← tensor.structa(datos, forma)
    }
    cape err {
        redde t
    }
    redde t
}

# Staged-result element read (swallow the never-firing access errors).
functio e2(tensor.Tensor t, numerus row, numerus col) → f32 {
    fac {
        redde t.accipe([row, col])
    }
    cape err {
        redde (0.0 - 999.0) ∷ f32
    }
}

# An i32-tagged staged tensor (dtype-mismatch probes).
functio tene_i32(lista<f32> datos, lista<numerus> forma) → tensor.Tensor {
    varia tensor.Tensor t
    fac {
        t ← math.casta(tene(datos, forma), "i32")
    }
    cape err {
        redde t
    }
    redde t
}

# The fresh test cache (model "tiny-mlp", version "1.0.0", config
# "causal-rope-d4", tokenizer "smollm", 1 layer, dim 4).
functio cache_p() → cache.KVCache {
    varia cache.KVCache c
    fac {
        c ← cache.cache_vacua("tiny-mlp", "1.0.0", "causal-rope-d4", "smollm", 1, 4)
    }
    cape err {
        redde c
    }
    redde c
}

# Renders a construction outcome as textus.
functio cache_vacua_detail(textus model, textus versio_modelis, textus configuratio, textus tokenizator, numerus stratorum, numerus dimensio) → textus {
    fac {
        fixum cache.KVCache _ ← cache.cache_vacua(model, versio_modelis, configuratio, tokenizator, stratorum, dimensio)
        redde "ok"
    }
    cape err {
        redde cache.causa(err)
    }
}

# Renders an append outcome as textus.
functio appende_detail(cache.KVCache c, numerus token_id, tensor.Tensor clavis, tensor.Tensor valor) → textus {
    fac {
        fixum cache.KVCache _ ← cache.appende(c, token_id, clavis, valor)
        redde "ok"
    }
    cape err {
        redde cache.causa(err)
    }
}

# Renders an identity-wire deserialization outcome as textus.
functio deserializa_detail(textus wire) → textus {
    fac {
        fixum cache.IdentitasCache _ ← cache.deserializa_identitas(wire)
        redde "ok"
    }
    cape err {
        redde cache.causa(err)
    }
}

# Identity wire round-trip predicate.
functio roundtrip_identitas(cache.IdentitasCache i) → bivalens {
    fac {
        fixum cache.IdentitasCache j ← cache.deserializa_identitas(cache.serializa_identitas(i))
        redde cache.identitas_cache_aequus(i, j)
    }
    cape err {
        redde falsum
    }
}

# ---- the typed logical value: construction

probandum "cache — the typed logical value" {
    proba "cache_vacua builds a fresh cache with full identity and empty state" {
        fac {
            fixum cache.KVCache c ← cache_p()
            adfirma c.model() ≡ "tiny-mlp"
            adfirma c.versio_modelis() ≡ "1.0.0"
            adfirma c.configuratio() ≡ "causal-rope-d4"
            adfirma c.tokenizator() ≡ "smollm"
            adfirma c.stratorum() ≡ 1
            adfirma c.typo() ≡ "f32"
            adfirma c.ordinatio() ≡ "staged"
            adfirma c.dimensio() ≡ 4
            adfirma c.longitudo() ≡ 0
            adfirma c.versio() ≡ 1
            adfirma c.clavis().figura() ≡ [0, 4]
            adfirma c.valor().figura() ≡ [0, 4]
        }
        cape err {
            adfirma falsum
        }
    }

    proba "cache_vacua rejects the identity/domain invariants" {
        adfirma cache_vacua_detail("", "1.0.0", "causal-rope-d4", "smollm", 1, 4) ≡ "empty model name"
        adfirma cache_vacua_detail("tiny-mlp", "", "causal-rope-d4", "smollm", 1, 4) ≡ "empty model version"
        adfirma cache_vacua_detail("tiny-mlp", "1.0.0", "", "smollm", 1, 4) ≡ "empty execution config"
        adfirma cache_vacua_detail("tiny-mlp", "1.0.0", "causal-rope-d4", "", 1, 4) ≡ "empty tokenizer identity"
        adfirma cache_vacua_detail("a/b", "1.0.0", "causal-rope-d4", "smollm", 1, 4) ≡ "reserved wire character in identity"
        adfirma cache_vacua_detail("tiny-mlp", "1.0.0", "causal-rope-d4", "smollm", 0, 4) ≡ "layer count must be at least one"
        adfirma cache_vacua_detail("tiny-mlp", "1.0.0", "causal-rope-d4", "smollm", 1, 0) ≡ "embedding dimension must be at least one"
    }
}

# ---- the declared mutation rules: append + generation + reset

probandum "cache — mutation rules" {
    proba "appende extends by one position, preserves the K/V exactly, and bumps the generation" {
        fac {
            fixum cache.KVCache c0 ← cache_p()
            fixum cache.KVCache c1 ← cache.appende(c0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
            adfirma c1.longitudo() ≡ 1
            adfirma c1.versio() ≡ 2
            adfirma c1.historia() ≡ [5]
            adfirma c1.clavis().figura() ≡ [1, 4]
            # Exact pass-through: the appended K/V is bit-preserved.
            adfirma e2(c1.clavis(), 0, 0) ≡ (1.0 ∷ f32)
            adfirma e2(c1.clavis(), 0, 1) ≡ (0.5 ∷ f32)
            adfirma e2(c1.clavis(), 0, 2) ≡ (0.2 ∷ f32)
            adfirma e2(c1.clavis(), 0, 3) ≡ (0.0 - 0.5 ∷ f32)
            adfirma e2(c1.valor(), 0, 0) ≡ (0.1 ∷ f32)
            adfirma e2(c1.valor(), 0, 3) ≡ (0.4 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "sequential appends preserve the history order and prior positions" {
        fac {
            fixum cache.KVCache c0 ← cache_p()
            fixum cache.KVCache c1 ← cache.appende(c0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
            fixum cache.KVCache c2 ← cache.appende(c1, 2, tene([0.0, 1.0, 1.0, 0.0], [1, 4]), tene([1.0, 0.0, 0.0, 1.0], [1, 4]))
            adfirma c2.longitudo() ≡ 2
            adfirma c2.versio() ≡ 3
            adfirma c2.historia() ≡ [5, 2]
            adfirma c2.clavis().figura() ≡ [2, 4]
            # Row 0 (the first position) is preserved; row 1 is the second.
            adfirma e2(c2.clavis(), 0, 1) ≡ (0.5 ∷ f32)
            adfirma e2(c2.clavis(), 1, 0) ≡ (0.0 ∷ f32)
            adfirma e2(c2.clavis(), 1, 1) ≡ (1.0 ∷ f32)
            adfirma e2(c2.valor(), 1, 0) ≡ (1.0 ∷ f32)
            adfirma e2(c2.valor(), 1, 3) ≡ (1.0 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "appende rejects a negative token id and malformed K/V" {
        fac {
            fixum cache.KVCache c0 ← cache_p()
            adfirma appende_detail(c0, 0 - 1, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4])) ≡ "token id must be non-negative"
            adfirma appende_detail(c0, 5, tene([1.0, 0.5], [2]), tene([0.1, 0.2, 0.3, 0.4], [1, 4])) ≡ "K must be [1, dim]"
            adfirma appende_detail(c0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2], [2])) ≡ "V must be [1, dim]"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "appende rejects a non-f32 K/V (only the F32 row is admitted)" {
        fac {
            fixum cache.KVCache c0 ← cache_p()
            adfirma appende_detail(c0, 5, tene_i32([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4])) ≡ "unsupported dtype for cache"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "redintegra resets to a fresh cache (same identity, empty state, versio 1)" {
        fac {
            fixum cache.KVCache c0 ← cache_p()
            fixum cache.KVCache c1 ← cache.appende(c0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
            fixum cache.KVCache c2 ← cache.redintegra(c1)
            adfirma c2.longitudo() ≡ 0
            adfirma c2.versio() ≡ 1
            adfirma c2.clavis().figura() ≡ [0, 4]
            adfirma c2.model() ≡ c1.model()
            adfirma c2.dimensio() ≡ c1.dimensio()
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- determinism

probandum "cache — determinism" {
    proba "equal append sequences produce equal caches (pure, no hidden state)" {
        fac {
            fixum cache.KVCache a0 ← cache_p()
            fixum cache.KVCache b0 ← cache_p()
            fixum cache.KVCache a1 ← cache.appende(a0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
            fixum cache.KVCache b1 ← cache.appende(b0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
            adfirma cache.cache_aequus(a1, b1)
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- the cache identity key (MD-A9 precedent)

probandum "cache — identity key facts" {
    proba "identitas_cache derives the full key (prefix, position span, layer, dtype, layout)" {
        fac {
            fixum cache.KVCache c0 ← cache_p()
            fixum cache.KVCache c1 ← cache.appende(c0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
            fixum cache.KVCache c2 ← cache.appende(c1, 2, tene([0.0, 1.0, 1.0, 0.0], [1, 4]), tene([1.0, 0.0, 0.0, 1.0], [1, 4]))
            fixum cache.IdentitasCache i ← cache.identitas_cache(c2)
            adfirma i.model() ≡ "tiny-mlp"
            adfirma i.versio_modelis() ≡ "1.0.0"
            adfirma i.configuratio() ≡ "causal-rope-d4"
            adfirma i.tokenizator() ≡ "smollm"
            adfirma i.historia() ≡ "5,2"
            adfirma i.positio() ≡ "0..2"
            adfirma i.stratorum() ≡ 1
            adfirma i.typo() ≡ "f32"
            adfirma i.ordinatio() ≡ "staged"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the fresh cache's identity key has the empty history and the 0..0 span" {
        fac {
            fixum cache.IdentitasCache i ← cache.identitas_cache(cache_p())
            adfirma i.historia() ≡ ""
            adfirma i.positio() ≡ "0..0"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the identity wire round-trips exactly" {
        fac {
            fixum cache.KVCache c0 ← cache_p()
            fixum cache.KVCache c1 ← cache.appende(c0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
            fixum cache.IdentitasCache i ← cache.identitas_cache(c1)
            adfirma roundtrip_identitas(i)
            # The exact wire form.
            adfirma cache.serializa_identitas(i) ≡ "cache/identity/1.0.0/tiny-mlp/1.0.0/causal-rope-d4/smollm/5/0..1/1/f32/staged"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the empty-history identity wire uses the documented sentinel" {
        fac {
            fixum cache.IdentitasCache i ← cache.identitas_cache(cache_p())
            fixum cache.IdentitasCache j ← cache.deserializa_identitas(cache.serializa_identitas(i))
            adfirma cache.identitas_cache_aequus(i, j)
            adfirma j.historia() ≡ ""
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the identity wire rejects unknown markers, schema, and malformed fields" {
        adfirma deserializa_detail("tensor/identity/1.0.0/tiny-mlp/1.0.0/causal-rope-d4/smollm/5/0..1/1/f32/staged") ≡ "unknown cache marker"
        adfirma deserializa_detail("cache/identity/9.9.9/tiny-mlp/1.0.0/causal-rope-d4/smollm/5/0..1/1/f32/staged") ≡ "unknown cache schema version"
        adfirma deserializa_detail("cache/identity/1.0.0/tiny-mlp/1.0.0/causal-rope-d4/smollm/5/0..1/1/f32") ≡ "malformed cache identity wire"
        adfirma deserializa_detail("cache/identity/1.0.0//1.0.0/causal-rope-d4/smollm/5/0..1/1/f32/staged") ≡ "empty model name in cache identity"
        adfirma deserializa_detail("cache/identity/1.0.0/tiny-mlp/1.0.0/causal-rope-d4/smollm/5/0..1/0/f32/staged") ≡ "invalid layer count in cache identity"
    }
}
