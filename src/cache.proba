+++
locale = "en"
+++
# Co-located package test for cache.fab (PML5-U2 — KV-cache values and
# mutation rules). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * the typed logical value — KVCache (model / model version / execution
#     config / tokenizer identity / exact token history / layer count /
#     dtype / layout + the [positions, dim] f32 K/V + the generation
#     counter); construction fail-closed (empty or wire-unsafe identity
#     fields, layer/dim below one) — causa identity.
#   * the declared mutation rules — appende extends by exactly ONE
#     position (strictly sequential: the K/V row count equals the history
#     length) and bumps the generation; the append/readback arithmetic is
#     exact concatenation (pins are EXACT — the K/V pass through
#     bit-preserved); redintegra resets to a fresh cache (same identity
#     fields, empty history + K/V, versio 1).
#   * the cache identity key per the MD-A9 precedent (IdentitasCache:
#     model, version, execution config, tokenizer, exact prefix, position
#     span, layer count, dtype, layout) — exact field pins + the versioned
#     wire round-trip (with the documented "-" sentinel for the empty
#     history) + fail-closed rejections.
#   * determinism — equal inputs produce equal caches (pure, no hidden
#     state; cache_aequus field-wise).
#
# Oracle pins: the append/readback arithmetic is concatenation (no
# rounding), so the pins are EXACT f32 values (stronger than the
# tolerance rows); the identity-key facts are exact textus/numerus pins.
# No executed value is claimed (CTO Q2); the auditor-owned
# runtime-evidence gate compares executed append/readback against these
# exact pins.
#
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/cache.proba` proves the suite
# type-checks. Execution of proba bodies is env-blocked tree-wide today
# (recorded residual); this suite is the compile-level proof of the
# contract.

import from "gradus:cache" cache

import from "gradus:tensor" tensor

import from "gradus:math" math

# ---- helpers (the loss.proba / decode.proba pattern)

# Build a staged tensor, swallowing the never-firing construction errors.
fn tene(list<f32> datos, list<int> forma) → tensor.Tensor {
    var tensor.Tensor t
    do {
        t ← tensor.structa(datos, forma)
    }
    catch err {
        return t
    }
    return t
}

# Staged-result element read (swallow the never-firing access errors).
fn e2(tensor.Tensor t, int row, int col) → f32 {
    do {
        return t.accipe([row, col])
    }
    catch err {
        return 0.0 - 999.0 ∷ f32
    }
}

# An i32-tagged staged tensor (dtype-mismatch probes).
fn tene_i32(list<f32> datos, list<int> forma) → tensor.Tensor {
    var tensor.Tensor t
    do {
        t ← math.casta(tene(datos, forma), "i32")
    }
    catch err {
        return t
    }
    return t
}

# The fresh test cache (model "tiny-mlp", version "1.0.0", config
# "causal-rope-d4", tokenizer "smollm", 1 layer, dim 4).
fn cache_p() → cache.KVCache {
    var cache.KVCache c
    do {
        c ← cache.cache_vacua("tiny-mlp", "1.0.0", "causal-rope-d4", "smollm", 1, 4)
    }
    catch err {
        return c
    }
    return c
}

# Renders a construction outcome as textus.
fn cache_vacua_detail(string model, string versio_modelis, string configuratio, string tokenizator, int stratorum, int dimensio) → string {
    do {
        cache.cache_vacua(model, versio_modelis, configuratio, tokenizator, stratorum, dimensio)
        return "ok"
    }
    catch err {
        return cache.causa(err)
    }
}

# Renders an append outcome as textus.
fn appende_detail(cache.KVCache c, int token_id, tensor.Tensor clavis, tensor.Tensor valor) → string {
    do {
        cache.appende(c, token_id, clavis, valor)
        return "ok"
    }
    catch err {
        return cache.causa(err)
    }
}

# Renders an identity-wire deserialization outcome as textus.
fn deserializa_detail(string wire) → string {
    do {
        cache.deserializa_identitas(wire)
        return "ok"
    }
    catch err {
        return cache.causa(err)
    }
}

# Identity wire round-trip predicate.
fn roundtrip_identitas(cache.IdentitasCache i) → bool {
    do {
        const cache.IdentitasCache j ← cache.deserializa_identitas(cache.serializa_identitas(i))
        return cache.identitas_cache_aequus(i, j)
    }
    catch err {
        return false
    }
}

# ---- the typed logical value: construction

test "cache_vacua builds a fresh cache with full identity and empty state" {
    do {
        const cache.KVCache c ← cache_p()
        assert c.model() ≡ "tiny-mlp"
        assert c.versio_modelis() ≡ "1.0.0"
        assert c.configuratio() ≡ "causal-rope-d4"
        assert c.tokenizator() ≡ "smollm"
        assert c.stratorum() ≡ 1
        assert c.typo() ≡ "f32"
        assert c.ordinatio() ≡ "staged"
        assert c.dimensio() ≡ 4
        assert c.longitudo() ≡ 0
        assert c.versio() ≡ 1
        assert c.clavis().figura() ≡ [0, 4]
        assert c.valor().figura() ≡ [0, 4]
    }
    catch err {
        assert false
    }
}

test "cache_vacua rejects the identity/domain invariants" {
    assert cache_vacua_detail("", "1.0.0", "causal-rope-d4", "smollm", 1, 4) ≡ "empty model name"
    assert cache_vacua_detail("tiny-mlp", "", "causal-rope-d4", "smollm", 1, 4) ≡ "empty model version"
    assert cache_vacua_detail("tiny-mlp", "1.0.0", "", "smollm", 1, 4) ≡ "empty execution config"
    assert cache_vacua_detail("tiny-mlp", "1.0.0", "causal-rope-d4", "", 1, 4) ≡ "empty tokenizer identity"
    assert cache_vacua_detail("a/b", "1.0.0", "causal-rope-d4", "smollm", 1, 4) ≡ "reserved wire character in identity"
    assert cache_vacua_detail("tiny-mlp", "1.0.0", "causal-rope-d4", "smollm", 0, 4) ≡ "layer count must be at least one"
    assert cache_vacua_detail("tiny-mlp", "1.0.0", "causal-rope-d4", "smollm", 1, 0) ≡ "embedding dimension must be at least one"
}

# ---- the declared mutation rules: append + generation + reset

test "appende extends by one position, preserves the K/V exactly, and bumps the generation" {
    do {
        const cache.KVCache c0 ← cache_p()
        const cache.KVCache c1 ← cache.appende(c0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
        assert c1.longitudo() ≡ 1
        assert c1.versio() ≡ 2
        assert c1.historia() ≡ [5]
        assert c1.clavis().figura() ≡ [1, 4]
        # Exact pass-through: the appended K/V is bit-preserved.
        assert e2(c1.clavis(), 0, 0) ≡ 1.0 ∷ f32
        assert e2(c1.clavis(), 0, 1) ≡ 0.5 ∷ f32
        assert e2(c1.clavis(), 0, 2) ≡ 0.2 ∷ f32
        assert e2(c1.clavis(), 0, 3) ≡ 0.0 - 0.5 ∷ f32
        assert e2(c1.valor(), 0, 0) ≡ 0.1 ∷ f32
        assert e2(c1.valor(), 0, 3) ≡ 0.4 ∷ f32
    }
    catch err {
        assert false
    }
}

test "sequential appends preserve the history order and prior positions" {
    do {
        const cache.KVCache c0 ← cache_p()
        const cache.KVCache c1 ← cache.appende(c0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
        const cache.KVCache c2 ← cache.appende(c1, 2, tene([0.0, 1.0, 1.0, 0.0], [1, 4]), tene([1.0, 0.0, 0.0, 1.0], [1, 4]))
        assert c2.longitudo() ≡ 2
        assert c2.versio() ≡ 3
        assert c2.historia() ≡ [5, 2]
        assert c2.clavis().figura() ≡ [2, 4]
        # Row 0 (the first position) is preserved; row 1 is the second.
        assert e2(c2.clavis(), 0, 1) ≡ 0.5 ∷ f32
        assert e2(c2.clavis(), 1, 0) ≡ 0.0 ∷ f32
        assert e2(c2.clavis(), 1, 1) ≡ 1.0 ∷ f32
        assert e2(c2.valor(), 1, 0) ≡ 1.0 ∷ f32
        assert e2(c2.valor(), 1, 3) ≡ 1.0 ∷ f32
    }
    catch err {
        assert false
    }
}

test "appende rejects a negative token id and malformed K/V" {
    do {
        const cache.KVCache c0 ← cache_p()
        assert appende_detail(c0, 0 - 1, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4])) ≡ "token id must be non-negative"
        assert appende_detail(c0, 5, tene([1.0, 0.5], [2]), tene([0.1, 0.2, 0.3, 0.4], [1, 4])) ≡ "K must be [1, dim]"
        assert appende_detail(c0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2], [2])) ≡ "V must be [1, dim]"
    }
    catch err {
        assert false
    }
}

test "appende rejects a non-f32 K/V (only the F32 row is admitted)" {
    do {
        const cache.KVCache c0 ← cache_p()
        assert appende_detail(c0, 5, tene_i32([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4])) ≡ "unsupported dtype for cache"
    }
    catch err {
        assert false
    }
}

test "redintegra resets to a fresh cache (same identity, empty state, versio 1)" {
    do {
        const cache.KVCache c0 ← cache_p()
        const cache.KVCache c1 ← cache.appende(c0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
        const cache.KVCache c2 ← cache.redintegra(c1)
        assert c2.longitudo() ≡ 0
        assert c2.versio() ≡ 1
        assert c2.clavis().figura() ≡ [0, 4]
        assert c2.model() ≡ c1.model()
        assert c2.dimensio() ≡ c1.dimensio()
    }
    catch err {
        assert false
    }
}

# ---- determinism

test "equal append sequences produce equal caches (pure, no hidden state)" {
    do {
        const cache.KVCache a0 ← cache_p()
        const cache.KVCache b0 ← cache_p()
        const cache.KVCache a1 ← cache.appende(a0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
        const cache.KVCache b1 ← cache.appende(b0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
        assert cache.cache_aequus(a1, b1)
    }
    catch err {
        assert false
    }
}

# ---- the cache identity key (MD-A9 precedent)

test "identitas_cache derives the full key (prefix, position span, layer, dtype, layout)" {
    do {
        const cache.KVCache c0 ← cache_p()
        const cache.KVCache c1 ← cache.appende(c0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
        const cache.KVCache c2 ← cache.appende(c1, 2, tene([0.0, 1.0, 1.0, 0.0], [1, 4]), tene([1.0, 0.0, 0.0, 1.0], [1, 4]))
        const cache.IdentitasCache i ← cache.identitas_cache(c2)
        assert i.model() ≡ "tiny-mlp"
        assert i.versio_modelis() ≡ "1.0.0"
        assert i.configuratio() ≡ "causal-rope-d4"
        assert i.tokenizator() ≡ "smollm"
        assert i.historia() ≡ "5,2"
        assert i.positio() ≡ "0..2"
        assert i.stratorum() ≡ 1
        assert i.typo() ≡ "f32"
        assert i.ordinatio() ≡ "staged"
    }
    catch err {
        assert false
    }
}

test "the fresh cache's identity key has the empty history and the 0..0 span" {
    do {
        const cache.IdentitasCache i ← cache.identitas_cache(cache_p())
        assert i.historia() ≡ ""
        assert i.positio() ≡ "0..0"
    }
    catch err {
        assert false
    }
}

test "the identity wire round-trips exactly" {
    do {
        const cache.KVCache c0 ← cache_p()
        const cache.KVCache c1 ← cache.appende(c0, 5, tene([1.0, 0.5, 0.2, 0.0 - 0.5], [1, 4]), tene([0.1, 0.2, 0.3, 0.4], [1, 4]))
        const cache.IdentitasCache i ← cache.identitas_cache(c1)
        assert roundtrip_identitas(i)
        # The exact wire form.
        assert cache.serializa_identitas(i) ≡ "cache/identity/1.0.0/tiny-mlp/1.0.0/causal-rope-d4/smollm/5/0..1/1/f32/staged"
    }
    catch err {
        assert false
    }
}

test "the empty-history identity wire uses the documented sentinel" {
    do {
        const cache.IdentitasCache i ← cache.identitas_cache(cache_p())
        const cache.IdentitasCache j ← cache.deserializa_identitas(cache.serializa_identitas(i))
        assert cache.identitas_cache_aequus(i, j)
        assert j.historia() ≡ ""
    }
    catch err {
        assert false
    }
}

test "the identity wire rejects unknown markers, schema, and malformed fields" {
    assert deserializa_detail("tensor/identity/1.0.0/tiny-mlp/1.0.0/causal-rope-d4/smollm/5/0..1/1/f32/staged") ≡ "unknown cache marker"
    assert deserializa_detail("cache/identity/9.9.9/tiny-mlp/1.0.0/causal-rope-d4/smollm/5/0..1/1/f32/staged") ≡ "unknown cache schema version"
    assert deserializa_detail("cache/identity/1.0.0/tiny-mlp/1.0.0/causal-rope-d4/smollm/5/0..1/1/f32") ≡ "malformed cache identity wire"
    assert deserializa_detail("cache/identity/1.0.0//1.0.0/causal-rope-d4/smollm/5/0..1/1/f32/staged") ≡ "empty model name in cache identity"
    assert deserializa_detail("cache/identity/1.0.0/tiny-mlp/1.0.0/causal-rope-d4/smollm/5/0..1/0/f32/staged") ≡ "invalid layer count in cache identity"
}
