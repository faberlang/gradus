# Scaled dot-product, causal attention, RoPE apply, and GQA multi-head.
#
# Public import: import from "gradus:attention/gqa" gqa
# Depends on: gradus:attention/rope, gradus:math, gradus:tensor, gradus:dtype.

import from "gradus:attention/rope" rope
import from "gradus:dtype" dtype
import from "gradus:math" math
import from "gradus:tensor" tensor
import from "gradus:cache/kv" kv



# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# RoPE frequency base — frozen at 100000 (the GI3 Rope recipe v1 constant;
# the radix-mir-stepper tensor_rope FREQ_BASE).
const f32 ROPE_FREQ_BASE ← 100000.0 ∷ f32

# 2π and π for angle reduction (the mathesis.fab precedent).
const f32 TAU ← 6.283185307179586 ∷ f32

const f32 SEMITAU ← 3.141592653589793 ∷ f32

# F32-only gate — the admitted row is the F32 row; a differently tagged
# staged carrier fails closed (mirror of nn.fab _dtype_f32).
fn _dtype_f32(tensor.NumericBlock t) → bool ⇥ rope.AttentionError {
    require dtype.eq(t.dtype, dtype.f32()) throw variant rope.AttentionError.DtypeMismatch {message = "unsupported dtype for attention primitive"}
    return true
}

# Pairwise dtype parity + F32 gate.
fn _dtype_pair(tensor.NumericBlock a, tensor.NumericBlock b) → bool ⇥ rope.AttentionError {
    require dtype.eq(a.dtype, b.dtype) throw variant rope.AttentionError.DtypeMismatch {message = "dtype mismatch"}
    require dtype.eq(a.dtype, dtype.f32()) throw variant rope.AttentionError.DtypeMismatch {message = "unsupported dtype for attention primitive"}
    return true
}

# Three-way dtype parity + F32 gate for the q/k/v triple.
fn _dtype_triple(tensor.NumericBlock a, tensor.NumericBlock b, tensor.NumericBlock c) → bool ⇥ rope.AttentionError {
    _dtype_pair(a, b)
    return _dtype_pair(a, c)
}

# e^x via the exponentiation intrinsic (base e > 0, so the non-positive
# base guard never fires; power lowers to exp(x·ln(e)) ≈ exp(x)) — the
# nn.fab _exp precedent.
fn _exp(f32 x) → f32 {
    return (2.718281828459045 ∷ f32).power(x)
}

# Angle reduction to the principal range [-π, π] for stable Taylor
# evaluation (the mathesis.fab _reduce_angle precedent).
fn _reduce_angle(f32 x) → f32 {
    const f32 shifted ← x + SEMITAU
    const int k ← (shifted / TAU).floor()
    return x - TAU * (k ↦ f32)
}

# sin via Taylor series on the reduced angle (fixed 12-iteration count —
# accurate to f32 precision over the reduced range, mathesis.fab precedent).
fn _sin(f32 x) → f32 {
    const f32 a ← _reduce_angle(x)
    var f32 term ← a
    var f32 sum ← a
    const f32 x2 ← a * a
    for range 1‥12 const n {
        term ← (term * -x2) / ((2 * n ↦ f32) * ((2 * n + 1) ↦ f32))
        sum ← sum + term
    }
    return sum
}

# cos via Taylor series on the reduced angle.
fn _cos(f32 x) → f32 {
    const f32 a ← _reduce_angle(x)
    var f32 term ← 1.0
    var f32 sum ← 1.0
    const f32 x2 ← a * a
    for range 1‥12 const n {
        term ← (term * -x2) / (((2 * n - 1) ↦ f32) * (2 * n ↦ f32))
        sum ← sum + term
    }
    return sum
}

# Rank-2 transpose [rows, cols] → [cols, rows] (math has no transpose; the
# score product needs kᵀ). Infallible — callers validate shape first.
fn _transpose(tensor.NumericBlock t) → tensor.NumericBlock {
    # legacy-L3: shape recovery pending shape-binding/S0-R1.
    const list<int> f ← t.shape
    const int rows ← f.get(0) coalesce 1
    const int cols ← f.get(1) coalesce 1
    const list<int> trans ← [cols, rows]
    var list<f32> out ← empty
    # legacy-L2: staged carrier — t.data is flat list<f32>; retain the
    # column-major nest until a pinned tensor can take `ᵀ` or
    # `for from grid at [i, j]`.
    for range 0‥cols const j {
        for range 0‥rows const i {
            out.append(t.data.get(i * cols + j) coalesce 0.0 ∷ f32)
        }
    }
    return tensor.stage(t.dtype, trans, out)
}

# Filled-tensor construction through the attention error vocabulary
# (tensor.fill → AttentionError, message text preserved).
fn _fill(list<int> f, f32 payload) → tensor.NumericBlock ⇥ rope.AttentionError {
    do {
        return tensor.fill(f, payload)
    }
    catch err {
        match err {
            case tensor.TensorError.InvalidShape const message {
                throw variant rope.AttentionError.ShapeMismatch { message = message }
            }
            case tensor.TensorError.ElementMismatch const message {
                throw variant rope.AttentionError.ElementMismatch { message = message }
            }
            case tensor.TensorError.IndexOutOfBounds const message {
                throw variant rope.AttentionError.ShapeMismatch { message = message }
            }
        }
    }
}

# Row softmax over the LAST axis of a rank-2 tensor, numerically stable via
# max subtraction (the stepper tensor_softmax identity). With causal =
# true it is the GI3 masked stable row softmax: row i keeps columns
# j ≤ prefix_before + i (diagonal included) and outputs zeros past the prefix.
# The causal-softmax device construct is not admitted for this staged library
# carrier, so this parameterized helper remains the single pending hand path.
# legacy-L5 pending construct admission
fn _softmax(tensor.NumericBlock x, int prefix_before, bool causal) → tensor.NumericBlock {
    # legacy-L3: shape recovery pending shape-binding/S0-R1.
    const list<int> f ← x.shape
    const int rows ← f.get(0) coalesce 1
    const int cols ← f.get(1) coalesce 1
    var list<f32> out ← empty
    # legacy-L2: staged carrier — x.data is flat list<f32>; retain range/index walk until shaped carrier migration.
    for range 0‥rows const i {
        var int end ← cols
        if causal {
            end ← prefix_before + i + 1
        }
        # Row max over the valid prefix. W0 stay: this is bounded
        # participation producing a value, not an unmasked index; no bounded
        # argmax twin is admitted.
        var f32 maximum ← x.data.get(i * cols) coalesce 0.0 ∷ f32
        for range 0‥end const j {
            const f32 v ← x.data.get(i * cols + j) coalesce 0.0 ∷ f32
            if v ≻ maximum {
                maximum ← v
            }
        }
        # exp(x − max) over the valid prefix and the normalizer sum. At least
        # one element equals max, so the sum is ≥ 1 — no division by zero.
        var list<f32> exps ← empty
        var f32 total ← 0.0 ∷ f32
        for range 0‥end const j2 {
            const f32 v ← x.data.get(i * cols + j2) coalesce 0.0 ∷ f32
            const f32 e ← _exp(v - maximum)
            exps.append(e)
            total ← total + e
        }
        for from exps const e {
            out.append(e / total)
        }
        for range end‥cols const _ {
            out.append(0.0 ∷ f32)
        }
    }
    return tensor.stage(x.dtype, f, out)
}

# RoPE table with logical shape [positions, dim/2, 3]. Each reduced pair
# stores [angle, cos(angle), sin(angle)] in that order. The table is built
# once at the forward boundary and shared by every q/k/head application.
fn _rope_table(list<int> positions, int dim, f32 θ, f32 scale) → list<f32> {
    const f32 dim_f ↤ dim
    const int half ← dim / 2
    var list<f32> table ← empty
    for from positions const pos {
        const f32 pos_f ↤ pos
        for range 0‥half const pair {
            const f32 pair_f ↤ pair
            const f32 angle ← (pos_f * scale) * θ.power((-(2.0 * pair_f)) / dim_f)
            table.append(angle)
            table.append(_cos(angle))
            table.append(_sin(angle))
        }
    }
    return table
}

# RoPE rotation over the LAST axis of a rank-2 tensor (REF-01-U1.3
# configurable row). With interposita = falsum it is the llama-arch NORM
# consecutive-pair rotation (2k, 2k+1) for k < dim/2 with
# theta = pos · scale · base^(-2k/dim); with interposita = verum it is the
# qwen2 interleaved-pair rotation (k, k+dim/2) with the same theta (the
# llama.cpp NEOX half-split layout, pairs offset by n_dims/2). Elements
# beyond dim are untouched. Infallible — callers validate
# shape/positions/dim first.
fn _rope(tensor.NumericBlock x, int dim, list<f32> table, bool interposita) → tensor.NumericBlock {
    # legacy-L3: shape recovery pending shape-binding/S0-R1.
    const list<int> f ← x.shape
    const int t ← f.get(0) coalesce 1
    const int d ← f.get(1) coalesce 1
    const int half ← dim / 2
    var list<f32> out ← empty
    # legacy-L2: staged carrier — x.data is flat list<f32>; retain row/column walk until shaped carrier migration.
    for range 0‥t const row {
        const int base ← row * d
        var int col ← 0
        while col ≺ d {
            if col ≺ dim {
                if interposita {
                    # qwen2 interleaved-pair: output column col belongs to
                    # pair k (0..half-1) and is its first (col < half) or
                    # second (col >= half) element.
                    const int k ← col % half
                    const int table_base ← (row * half + k) * 3
                    const f32 c ← table.get(table_base + 1) coalesce 0.0 ∷ f32
                    const f32 s ← table.get(table_base + 2) coalesce 0.0 ∷ f32
                    if col ≺ half {
                        const f32 x0 ← x.data.get(base + k) coalesce 0.0 ∷ f32
                        const f32 x1 ← x.data.get((base + k) + half) coalesce 0.0 ∷ f32
                        out.append(x0 * c - x1 * s)
                    }
                    else {
                        const f32 x0 ← x.data.get(base + k) coalesce 0.0 ∷ f32
                        const f32 x1 ← x.data.get((base + k) + half) coalesce 0.0 ∷ f32
                        out.append(x0 * s + x1 * c)
                    }
                    col ← col + 1
                }
                else {
                    # llama-arch NORM consecutive-pair (2k, 2k+1).
                    const int k ← col / 2
                    const int table_base ← (row * half + k) * 3
                    const f32 c ← table.get(table_base + 1) coalesce 0.0 ∷ f32
                    const f32 s ← table.get(table_base + 2) coalesce 0.0 ∷ f32
                    const f32 x0 ← x.data.get(base + col) coalesce 0.0 ∷ f32
                    const f32 x1 ← x.data.get((base + col) + 1) coalesce 0.0 ∷ f32
                    out.append(x0 * c - x1 * s)
                    out.append(x0 * s + x1 * c)
                    col ← col + 2
                }
            }
            else {
                out.append(x.data.get(base + col) coalesce 0.0 ∷ f32)
                col ← col + 1
            }
        }
    }
    return tensor.stage(x.dtype, f, out)
}

# Interleaved-pair flag from the typed policy (falsum = consecutive-pair
# llama NORM, verum = interleaved-pair qwen2). Infallible.
fn _interleaved(rope.RopePolicy policy) → bool {
    match policy {
        case Consecutive {
            return false
        }
        case Interleaved {
            return true
        }
    }
}

# Shared q/k/v validation: dtype parity + F32 gate, rank-2, shared [T,D]
# shape, non-empty. Returns the shared shape.
fn _validate_triplet(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v) → list<int> ⇥ rope.AttentionError {
    _dtype_triple(q, k, v)
    const list<int> fq ← q.shape
    const list<int> fk ← k.shape
    const list<int> fv ← v.shape
    require fq.length() ≡ 2 throw variant rope.AttentionError.GradusMismatch {message = "attention requires rank-2 tensors"}
    reject (fk.length() ≠ 2 or fv.length() ≠ 2) throw variant rope.AttentionError.GradusMismatch {message = "attention requires rank-2 tensors"}
    const int t ← fq.get(0) coalesce 1
    const int d ← fq.get(1) coalesce 1
    reject (fk.get(0) coalesce 1 ≠ t or fk.get(1) coalesce 1 ≠ d) throw variant rope.AttentionError.ShapeMismatch {message = "query, key, value must share shape"}
    reject (fv.get(0) coalesce 1 ≠ t or fv.get(1) coalesce 1 ≠ d) throw variant rope.AttentionError.ShapeMismatch {message = "query, key, value must share shape"}
    reject (t ≡ 0 or d ≡ 0) throw variant rope.AttentionError.ElementMismatch {message = "empty attention input"}
    return fq
}

# Shared rope/positions/dim validation for a rank-2 staged tensor: dtype
# gate, rank-2, non-empty, positions length == row count, positions
# non-negative, dim even and within [2, last-extent]. Returns the shape.
fn _validate_rope(tensor.NumericBlock x, list<int> positions, int dim) → list<int> ⇥ rope.AttentionError {
    _dtype_f32(x)
    const list<int> f ← x.shape
    require f.length() ≡ 2 throw variant rope.AttentionError.GradusMismatch {message = "rope requires rank-2 tensor"}
    const int t ← f.get(0) coalesce 1
    const int d ← f.get(1) coalesce 1
    reject (t ≡ 0 or d ≡ 0) throw variant rope.AttentionError.ElementMismatch {message = "empty rope input"}
    require positions.length() ≡ t throw variant rope.AttentionError.ShapeMismatch {message = "positions must match the token count"}
    require dim ≥ 2 throw variant rope.AttentionError.InvalidDimension {message = "rope dim must be at least 2"}
    require dim % 2 ≡ 0 throw variant rope.AttentionError.InvalidDimension {message = "rope dim must be even"}
    require dim ≤ d throw variant rope.AttentionError.InvalidDimension {message = "rope dim exceeds head width"}
    for from positions const p {
        require p ≥ 0 throw variant rope.AttentionError.InvalidPosition {message = "negative position"}
    }
    return f
}

# The attention computation core: scores = (q·kᵀ)·scale, row softmax (with
# or without the causal prefix), context = attn·v. Math failures are mapped
# into AttentionError preserving the message text (the nn.fab linear pattern).
fn _attention_core(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, f32 scale, bool causal) → tensor.NumericBlock ⇥ rope.AttentionError {
    const list<int> fq ← q.shape
    const int t ← fq.get(0) coalesce 1
    const tensor.NumericBlock kt ← _transpose(k)
    const tensor.NumericBlock scale_t ← _fill([t, t], scale)
    do {
        const tensor.NumericBlock scores ← math.matmul(q, kt)
        const tensor.NumericBlock scaled ← math.mul_carrier(scores, scale_t)
        const tensor.NumericBlock attn ← _softmax(scaled, 0, causal)
        const tensor.NumericBlock context ← math.matmul(attn, v)
        return context
    }
    catch err {
        match err {
            case math.MathError.GradusMismatch const message {
                throw variant rope.AttentionError.GradusMismatch { message = message }
            }
            case math.MathError.Incompatible const message {
                throw variant rope.AttentionError.Incompatible { message = message }
            }
            case math.MathError.DtypeMismatch const message {
                throw variant rope.AttentionError.DtypeMismatch { message = message }
            }
            case math.MathError.ProductAboveLimit const message {
                throw variant rope.AttentionError.ProductAboveLimit { message = message }
            }
            case math.MathError.DimensionAboveLimit const message {
                throw variant rope.AttentionError.DimensionAboveLimit { message = message }
            }
            case math.MathError.NegativeDimension const message {
                throw variant rope.AttentionError.NegativeDimension { message = message }
            }
            case math.MathError.ShapeMismatch const message {
                throw variant rope.AttentionError.ShapeMismatch { message = message }
            }
            case _ {
                throw variant rope.AttentionError.ShapeMismatch { message = err.message }
            }
        }
    }
}

# Column slice of a rank-2 staged tensor: columns [start, start + width)
# → [rows, width] (the per-head q/k/v split of the multi-head row).
# Infallible — callers validate shape first (the _transpone posture).
fn _head(tensor.NumericBlock t, int start, int width) → tensor.NumericBlock {
    # legacy-L3: shape recovery pending shape-binding/S0-R1.
    const list<int> f ← t.shape
    const int rows ← f.get(0) coalesce 1
    const int full ← f.get(1) coalesce 1
    var list<f32> out ← empty
    # legacy-L2: staged carrier — t.data is flat list<f32>; retain range/index walk until shaped carrier migration.
    for range 0‥rows const i {
        for range 0‥width const j {
            out.append(t.data.get((i * full + start) + j) coalesce 0.0 ∷ f32)
        }
    }
    return tensor.stage(t.dtype, [rows, width], out)
}

# Head concatenation along the last axis via the public math row, with the
# attention error vocabulary (the concat failures never fire on the row's
# validated [T, head_dim] parts; mapped for completeness).
fn _reconcile(list<tensor.NumericBlock> parts) → tensor.NumericBlock ⇥ rope.AttentionError {
    do {
        return math.concatenate(parts, 1)
    }
    catch err {
        match err {
            case math.MathError.ElementMismatch const message {
                throw variant rope.AttentionError.ElementMismatch { message = message }
            }
            case math.MathError.GradusMismatch const message {
                throw variant rope.AttentionError.GradusMismatch { message = message }
            }
            case math.MathError.ShapeMismatch const message {
                throw variant rope.AttentionError.ShapeMismatch { message = message }
            }
            case math.MathError.DtypeMismatch const message {
                throw variant rope.AttentionError.DtypeMismatch { message = message }
            }
            case _ {
                throw variant rope.AttentionError.ShapeMismatch { message = err.message }
            }
        }
    }
}

# matmul through the attention error vocabulary (the _attention_core mapping
# pattern, shared by the output projection).
fn _attention_matmul(tensor.NumericBlock a, tensor.NumericBlock b) → tensor.NumericBlock ⇥ rope.AttentionError {
    do {
        return math.matmul(a, b)
    }
    catch err {
        match err {
            case math.MathError.GradusMismatch const message {
                throw variant rope.AttentionError.GradusMismatch { message = message }
            }
            case math.MathError.Incompatible const message {
                throw variant rope.AttentionError.Incompatible { message = message }
            }
            case math.MathError.DtypeMismatch const message {
                throw variant rope.AttentionError.DtypeMismatch { message = message }
            }
            case math.MathError.ProductAboveLimit const message {
                throw variant rope.AttentionError.ProductAboveLimit { message = message }
            }
            case math.MathError.DimensionAboveLimit const message {
                throw variant rope.AttentionError.DimensionAboveLimit { message = message }
            }
            case math.MathError.NegativeDimension const message {
                throw variant rope.AttentionError.NegativeDimension { message = message }
            }
            case math.MathError.ShapeMismatch const message {
                throw variant rope.AttentionError.ShapeMismatch { message = message }
            }
            case _ {
                throw variant rope.AttentionError.ShapeMismatch { message = err.message }
            }
        }
    }
}

# Shared multi-head validation (REF-01-U1.4): dtype parity + F32 gate for
# q/k/v/wo, rank-2, the head-count invariants (0 < num_kv_heads ≤
# num_heads, num_heads % num_kv_heads == 0), the packed widths (q [T, H·D],
# k/v [T, K·D], wo [H·D, H·D]), positions length == T, non-negative
# positions, and the rope dim within the head width. Returns the head dim.
fn _validate_multi(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, tensor.NumericBlock wo, int num_heads, int num_kv_heads, list<int> positions, int rope_dim) → int ⇥ rope.AttentionError {
    _dtype_triple(q, k, v)
    _dtype_pair(q, wo)
    const list<int> fq ← q.shape
    const list<int> fk ← k.shape
    const list<int> fv ← v.shape
    const list<int> fw ← wo.shape
    reject (((fq.length() ≠ 2 or fk.length() ≠ 2) or fv.length() ≠ 2) or fw.length() ≠ 2) throw variant rope.AttentionError.GradusMismatch {message = "multi-head attention requires rank-2 tensors"}
    require num_heads ≥ 1 throw variant rope.AttentionError.InvalidConfig {message = "num_heads must be positive"}
    require num_kv_heads ≥ 1 throw variant rope.AttentionError.InvalidConfig {message = "num_kv_heads must be positive"}
    require num_kv_heads ≤ num_heads throw variant rope.AttentionError.InvalidConfig {message = "num_kv_heads must not exceed num_heads"}
    require num_heads % num_kv_heads ≡ 0 throw variant rope.AttentionError.InvalidConfig {message = "num_heads must be a multiple of num_kv_heads"}
    const int t ← fq.get(0) coalesce 1
    const int qw ← fq.get(1) coalesce 1
    reject (fk.get(0) coalesce 1 ≠ t or fv.get(0) coalesce 1 ≠ t) throw variant rope.AttentionError.ShapeMismatch {message = "query, key, value must share the token count"}
    require t ≠ 0 throw variant rope.AttentionError.ElementMismatch {message = "empty attention input"}
    require qw % num_heads ≡ 0 throw variant rope.AttentionError.InvalidConfig {message = "query width must be a multiple of num_heads"}
    const int d ← qw / num_heads
    require d ≠ 0 throw variant rope.AttentionError.InvalidConfig {message = "head dim must be positive"}
    require fk.get(1) coalesce 1 ≡ num_kv_heads * d throw variant rope.AttentionError.ShapeMismatch {message = "key width must equal num_kv_heads * head dim"}
    require fv.get(1) coalesce 1 ≡ num_kv_heads * d throw variant rope.AttentionError.ShapeMismatch {message = "value width must equal num_kv_heads * head dim"}
    reject (fw.get(0) coalesce 1 ≠ qw or fw.get(1) coalesce 1 ≠ qw) throw variant rope.AttentionError.ShapeMismatch {message = "output projection must be [H*D, H*D]"}
    require positions.length() ≡ t throw variant rope.AttentionError.ShapeMismatch {message = "positions must match the token count"}
    for from positions const p {
        require p ≥ 0 throw variant rope.AttentionError.InvalidPosition {message = "negative position"}
    }
    require rope_dim ≥ 2 throw variant rope.AttentionError.InvalidDimension {message = "rope dim must be at least 2"}
    require rope_dim % 2 ≡ 0 throw variant rope.AttentionError.InvalidDimension {message = "rope dim must be even"}
    require rope_dim ≤ d throw variant rope.AttentionError.InvalidDimension {message = "rope dim exceeds head width"}
    return d
}

# -------------------------------------------------------------------------
# Family: rotary_position_embedding — the RoPE recipe over the staged
# carrier. x [T,D]; positions is one non-negative integer per row; dim is
# the (even) rotation width over the last axis.
#
# rotary_position_embedding is the fixed llama-arch NORM convenience row
# (consecutive-pair, freq_base 100000, scale 1.0 — the GI3 frozen llama
# recipe). rotary_position_embedding_config generalizes it: frequency
# base (theta), scale, and pair policy (consecutive-pair llama NORM vs
# interleaved-pair qwen2, REF-01-U1.3).
# -------------------------------------------------------------------------

@ public
fn rotary_position_embedding(tensor.NumericBlock x, list<int> positions, int dim) → tensor.NumericBlock ⇥ rope.AttentionError {
    _validate_rope(x, positions, dim)
    const list<f32> table ← _rope_table(positions, dim, ROPE_FREQ_BASE, 1.0 ∷ f32)
    return _rope(x, dim, table, false)
}

@ public
fn rotary_position_embedding_config(tensor.NumericBlock x, list<int> positions, int dim, rope.RopeConfig config) → tensor.NumericBlock ⇥ rope.AttentionError {
    _validate_rope(x, positions, dim)
    const list<f32> table ← _rope_table(positions, dim, config.base, config.scale)
    return _rope(x, dim, table, _interleaved(config.policy))
}

# -------------------------------------------------------------------------
# Family: scaled_dot_product — single-head scaled dot-product attention.
#   scores = (q·kᵀ)·scale, row softmax over the last axis, context = attn·v.
# q/k/v are the [T,D] projections; scale is the dk scaling factor (the
# caller passes 1/sqrt(dk), matching the accepted dk_scale contract).
# -------------------------------------------------------------------------

@ public
fn scaled_dot_product(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, f32 scale) → tensor.NumericBlock ⇥ rope.AttentionError {
    _validate_triplet(q, k, v)
    return _attention_core(q, k, v, scale, false)
}

# -------------------------------------------------------------------------
# Family: scaled_dot_product_causal — the same attention with the GI3
# CausalMaskedSoftmax recipe semantics: row i attends to columns j ≤ i
# (diagonal included; future positions masked out before softmax). This is
# the causal scoring used identically by training and inference.
# -------------------------------------------------------------------------

@ public
fn scaled_dot_product_causal(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, f32 scale) → tensor.NumericBlock ⇥ rope.AttentionError {
    _validate_triplet(q, k, v)
    return _attention_core(q, k, v, scale, true)
}

# -------------------------------------------------------------------------
# Family: scaled_dot_product_causal_rope — the RoPE-integrated composite for
# the admitted rows. q and k are rotated at their positions first
# (rotary_position_embedding), then causal attention runs. Training and
# inference share this exact forward composition.
# -------------------------------------------------------------------------

@ public
fn scaled_dot_product_causal_rope(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, f32 scale, list<int> positions, int dim) → tensor.NumericBlock ⇥ rope.AttentionError {
    _validate_triplet(q, k, v)
    _validate_rope(q, positions, dim)
    const list<f32> table ← _rope_table(positions, dim, ROPE_FREQ_BASE, 1.0 ∷ f32)
    const tensor.NumericBlock qr ← _rope(q, dim, table, false)
    const tensor.NumericBlock kr ← _rope(k, dim, table, false)
    return _attention_core(qr, kr, v, scale, true)
}

# -------------------------------------------------------------------------
# Family: multi_head_attention — multi-head attention with GQA KV-head
# sharing (REF-01-U1.4). q [T, H·D] and k/v [T, K·D] are the packed
# projections with K ≤ H and H % K == 0; each query head h attends through
# its KV group g = h // (H/K). The composition per head: the per-head
# splits, scaled scores, the GI3 CausalMaskedSoftmax recipe (row i attends
# columns j ≤ i, diagonal included), v accumulation, then head
# concatenation and the [H·D, H·D] output projection (wo in the [K, N]
# row-major adapter contract: out = concat · wo, the same posture as
# nn.linear — do not transpose). q and k
# are rotated at their positions first via the U1.3 configurable RoPE row —
# the inference composition is causal + RoPE. The row is shape-generic:
# every shape derives from the runtime tensors and the head counts; no
# fixed-shape constants. The F32 row is the admitted row.
# -------------------------------------------------------------------------

@ public
fn multi_head_attention(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, tensor.NumericBlock wo, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, rope.RopeConfig rope_config) → tensor.NumericBlock ⇥ rope.AttentionError {
    # --- config + shape validation (fail closed) --------------------------
    const int d ← _validate_multi(q, k, v, wo, num_heads, num_kv_heads, positions, rope_dim)

    # --- rope config + shared table ---------------------------------------
    const int ratio ← num_heads / num_kv_heads
    const f32 base ← rope_config.base
    const f32 rope_scale ← rope_config.scale
    const bool interposita ← _interleaved(rope_config.policy)
    const list<f32> table ← _rope_table(positions, rope_dim, base, rope_scale)

    # --- per-head blocks (GQA split → RoPE → causal) ----------------------
    var list<tensor.NumericBlock> heads ← empty
    for range 0‥num_heads const h {
        # --- GQA group + per-head split -----------------------------------
        const int g ← h / ratio
        const tensor.NumericBlock qh ← _head(q, h * d, d)
        const tensor.NumericBlock kg ← _head(k, g * d, d)
        const tensor.NumericBlock vg ← _head(v, g * d, d)

        # --- RoPE rotation + causal attention -----------------------------
        const tensor.NumericBlock qr ← _rope(qh, rope_dim, table, interposita)
        const tensor.NumericBlock kr ← _rope(kg, rope_dim, table, interposita)
        const tensor.NumericBlock ctx ← _attention_core(qr, kr, vg, scale, true)
        heads.append(ctx)
    }

    # --- head concatenation -----------------------------------------------
    const tensor.NumericBlock concat ← _reconcile(heads)

    # --- output projection ------------------------------------------------
    return _attention_matmul(concat, wo)
}


# =========================================================================
# KV-A A2 — cached attention prefix, GQA, K-after-RoPE, V rules.
# Frozen coordinates (kv-cache-semantic-contract):
#   absolute_position(i)     = prefix_before + i
#   causal_end_exclusive(i)  = prefix_before + i + 1
#   prefill:  prefix_before = 0, query_rows = T, row i attends [0, i+1)
#   decode:   prefix_before = L, query_rows = 1, attends [0, L+1)
# The just-written row at the absolute position is included. Positions are
# absolute — local row zero is not a decode RoPE position. K is stored
# after absolute-position RoPE; V is stored unchanged. GQA requires
# query_heads % kv_heads == 0, with query head h mapped to KV head
# h / (query_heads / kv_heads). The F32 row is the admitted row.
# =========================================================================

@ public
class CachedAttention {
    tensor.NumericBlock context
    kv.KVCache state
}

@ public
fn default_cached() → CachedAttention {
    return CachedAttention {context = tensor.default(), state = kv.default()}
}

# Attention core for q [Tq, D] against full k/v [prefix_before + Tq, D].
# Query row i attends [0, prefix_before + i + 1), including the just-written
# row at absolute position prefix_before + i.
fn _attention_core_offset(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, f32 scale, int prefix_before) → tensor.NumericBlock ⇥ rope.AttentionError {
    const list<int> fq ← q.shape
    const list<int> fk ← k.shape
    const int tq ← fq.get(0) coalesce 1
    const int tk ← fk.get(0) coalesce 1
    require prefix_before ≥ 0 throw variant rope.AttentionError.InvalidPosition {message = "negative position"}
    require tk ≡ prefix_before + tq throw variant rope.AttentionError.ShapeMismatch {message = "attention prefix excludes the just-written row"}
    const tensor.NumericBlock kt ← _transpose(k)
    const tensor.NumericBlock scale_t ← _fill([tq, tk], scale)
    do {
        const tensor.NumericBlock scores ← math.matmul(q, kt)
        const tensor.NumericBlock scaled ← math.mul_carrier(scores, scale_t)
        const tensor.NumericBlock attn ← _softmax(scaled, prefix_before, true)
        const tensor.NumericBlock context ← math.matmul(attn, v)
        return context
    }
    catch err {
        match err {
            case math.MathError.GradusMismatch const message {
                throw variant rope.AttentionError.GradusMismatch { message = message }
            }
            case math.MathError.Incompatible const message {
                throw variant rope.AttentionError.Incompatible { message = message }
            }
            case math.MathError.DtypeMismatch const message {
                throw variant rope.AttentionError.DtypeMismatch { message = message }
            }
            case math.MathError.ProductAboveLimit const message {
                throw variant rope.AttentionError.ProductAboveLimit { message = message }
            }
            case math.MathError.DimensionAboveLimit const message {
                throw variant rope.AttentionError.DimensionAboveLimit { message = message }
            }
            case math.MathError.NegativeDimension const message {
                throw variant rope.AttentionError.NegativeDimension { message = message }
            }
            case math.MathError.ShapeMismatch const message {
                throw variant rope.AttentionError.ShapeMismatch { message = message }
            }
            case _ {
                throw variant rope.AttentionError.ShapeMismatch { message = err.message }
            }
        }
    }
}

fn _concat_rows(tensor.NumericBlock a, tensor.NumericBlock b) → tensor.NumericBlock ⇥ rope.AttentionError {
    const int ta ← a.shape.get(0) coalesce 0
    if ta ≡ 0 then return b
    const int tb ← b.shape.get(0) coalesce 0
    if tb ≡ 0 then return a
    do {
        return math.concatenate([a, b], 0)
    }
    catch err {
        throw variant rope.AttentionError.ShapeMismatch {message = err.message}
    }
    throw variant rope.AttentionError.ShapeMismatch {message = "unreachable concatenate"}
}

fn _write_cache(kv.KVCache layer, list<int> tokens, tensor.NumericBlock key, tensor.NumericBlock payload) → kv.KVCache ⇥ rope.AttentionError {
    do {
        return kv.extend(layer, tokens, key, payload)
    }
    catch err {
        throw variant rope.AttentionError.CacheFailure {message = err.message, inner = err}
    }
    throw variant rope.AttentionError.ShapeMismatch {message = "unreachable cache extend"}
}

# Positions are absolute: query row i is at prefix_before + i. Local row
# zero is rejected whenever prefix_before > 0 (decode RoPE must not reuse
# the first cache slot's coordinate).
fn _validate_absolute_positions(int prefix_before, list<int> positions, int query_rows) → bool ⇥ rope.AttentionError {
    require positions.length() ≡ query_rows throw variant rope.AttentionError.ShapeMismatch {message = "positions must match the token count"}
    # legacy-L2: staged carrier — positions is flat list<int>; retain range/index walk until shaped carrier migration.
    for range 0‥query_rows const i {
        const int pos ← positions.get(i) coalesce -1
        require pos ≡ prefix_before + i throw variant rope.AttentionError.InvalidPosition {message = "position must be the absolute prefix row"}
    }
    return true
}

fn _validate_cached_triplet(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, kv.KVCache layer, list<int> tokens) → int ⇥ rope.AttentionError {
    _dtype_triple(q, k, v)
    require layer.dtype ≡ "f32" throw variant rope.AttentionError.DtypeMismatch {message = "unsupported dtype for attention primitive"}
    const list<int> fq ← q.shape
    const list<int> fk ← k.shape
    const list<int> fv ← v.shape
    reject (fq.length() ≠ 2 or fk.length() ≠ 2 or fv.length() ≠ 2) throw variant rope.AttentionError.GradusMismatch {message = "attention requires rank-2 tensors"}
    const int t ← fq.get(0) coalesce 1
    const int d ← fq.get(1) coalesce 1
    reject (fk.get(0) coalesce 1 ≠ t or fk.get(1) coalesce 1 ≠ d) throw variant rope.AttentionError.ShapeMismatch {message = "query, key, value must share shape"}
    reject (fv.get(0) coalesce 1 ≠ t or fv.get(1) coalesce 1 ≠ d) throw variant rope.AttentionError.ShapeMismatch {message = "query, key, value must share shape"}
    reject (t ≡ 0 or d ≡ 0) throw variant rope.AttentionError.ElementMismatch {message = "empty attention input"}
    require tokens.length() ≡ t throw variant rope.AttentionError.ShapeMismatch {message = "tokens must match the token count"}
    require layer.dimension ≡ d throw variant rope.AttentionError.ShapeMismatch {message = "cache dimension must equal the head width"}
    const int prefix_before ← layer.length()
    const list<int> fc ← layer.key.shape
    const list<int> fp ← layer.payload.shape
    require fc.length() ≡ 2 throw variant rope.AttentionError.GradusMismatch {message = "cache key must be rank-2"}
    require fp.length() ≡ 2 throw variant rope.AttentionError.GradusMismatch {message = "cache value must be rank-2"}
    require fc.get(1) coalesce 1 ≡ d throw variant rope.AttentionError.ShapeMismatch {message = "cache key width must equal the head width"}
    require fp.get(1) coalesce 1 ≡ d throw variant rope.AttentionError.ShapeMismatch {message = "cache value width must equal the head width"}
    require (fc.get(0) coalesce 0) ≡ prefix_before throw variant rope.AttentionError.ShapeMismatch {message = "cache key rows must equal the prefix length"}
    require (fp.get(0) coalesce 0) ≡ prefix_before throw variant rope.AttentionError.ShapeMismatch {message = "cache value rows must equal the prefix length"}
    return prefix_before
}

# -------------------------------------------------------------------------
# scaled_dot_product_causal_rope_cached — single-head prefill / M=1 decode.
# q/k/v are the NEW rows [T, D]. prefix_before is the logical cache length
# L before this write. Q and K rotate at absolute positions L..L+T-1; K is
# stored after that RoPE, V is stored raw. The query attends [0, L+i+1)
# including the just-written row, then the new rows are extended.
# -------------------------------------------------------------------------

@ public
fn scaled_dot_product_causal_rope_cached(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, f32 scale, list<int> positions, int dim, kv.KVCache layer, list<int> tokens) → CachedAttention ⇥ rope.AttentionError {
    # --- cache + triplet + positions (fail closed) ------------------------
    const int prefix_before ← _validate_cached_triplet(q, k, v, layer, tokens)
    _validate_rope(q, positions, dim)
    _validate_absolute_positions(prefix_before, positions, q.shape.get(0) coalesce 0)

    # --- rope table + q/k rotation ----------------------------------------
    const list<f32> table ← _rope_table(positions, dim, ROPE_FREQ_BASE, 1.0 ∷ f32)
    const tensor.NumericBlock qr ← _rope(q, dim, table, false)
    const tensor.NumericBlock kr ← _rope(k, dim, table, false)

    # --- append new rows to the cached prefix -----------------------------
    const tensor.NumericBlock full_k ← _concat_rows(layer.key, kr)
    const tensor.NumericBlock full_v ← _concat_rows(layer.payload, v)

    # --- causal attention (offset core) -----------------------------------
    const tensor.NumericBlock context ← _attention_core_offset(qr, full_k, full_v, scale, prefix_before)

    # --- cache write + result ---------------------------------------------
    return CachedAttention {context = context, state = _write_cache(layer, tokens, kr, v)}
}

fn _validate_cached_multi(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, tensor.NumericBlock wo, kv.KVCache layer, int num_heads, int num_kv_heads, list<int> positions, int rope_dim, list<int> tokens) → int ⇥ rope.AttentionError {
    const int d ← _validate_multi(q, k, v, wo, num_heads, num_kv_heads, positions, rope_dim)
    require layer.dtype ≡ "f32" throw variant rope.AttentionError.DtypeMismatch {message = "unsupported dtype for attention primitive"}
    require tokens.length() ≡ (q.shape.get(0) coalesce 0) throw variant rope.AttentionError.ShapeMismatch {message = "tokens must match the token count"}
    const int kv_width ← num_kv_heads * d
    require layer.dimension ≡ kv_width throw variant rope.AttentionError.ShapeMismatch {message = "cache dimension must equal num_kv_heads * head dim"}
    const int prefix_before ← layer.length()
    const list<int> fc ← layer.key.shape
    require fc.length() ≡ 2 throw variant rope.AttentionError.GradusMismatch {message = "cache key must be rank-2"}
    require fc.get(1) coalesce 1 ≡ kv_width throw variant rope.AttentionError.ShapeMismatch {message = "cache key width must equal num_kv_heads * head dim"}
    const list<int> fv ← layer.payload.shape
    reject (fv.length() ≠ 2 or fv.get(1) coalesce 1 ≠ kv_width) throw variant rope.AttentionError.ShapeMismatch {message = "cache value width must equal num_kv_heads * head dim"}
    require (fc.get(0) coalesce 0) ≡ prefix_before throw variant rope.AttentionError.ShapeMismatch {message = "cache key rows must equal the prefix length"}
    require (fv.get(0) coalesce 0) ≡ prefix_before throw variant rope.AttentionError.ShapeMismatch {message = "cache value rows must equal the prefix length"}
    return d
}

# -------------------------------------------------------------------------
# multi_head_attention_cached — GQA prefill / M=1 decode. q [T, H·D] and
# k/v [T, K·D] are the NEW packed rows. GQA requires H % K == 0; query
# head h attends KV head h / (H/K). Cached K is post-RoPE at absolute
# positions; V is stored unchanged. Query row i attends [0, L+i+1).
# -------------------------------------------------------------------------

@ public
fn multi_head_attention_cached(tensor.NumericBlock q, tensor.NumericBlock k, tensor.NumericBlock v, tensor.NumericBlock wo, kv.KVCache layer, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, rope.RopeConfig rope_config, list<int> tokens) → CachedAttention ⇥ rope.AttentionError {
    # --- cache + GQA validation (fail closed) -----------------------------
    const int d ← _validate_cached_multi(q, k, v, wo, layer, num_heads, num_kv_heads, positions, rope_dim, tokens)
    const int prefix_before ← layer.length()
    _validate_absolute_positions(prefix_before, positions, q.shape.get(0) coalesce 0)

    # --- rope config + shared table ---------------------------------------
    const int ratio ← num_heads / num_kv_heads
    const f32 base ← rope_config.base
    const f32 rope_scale ← rope_config.scale
    const bool interposita ← _interleaved(rope_config.policy)
    const list<f32> table ← _rope_table(positions, rope_dim, base, rope_scale)

    # --- rotate + reconcile new keys (per KV head) ------------------------
    var list<tensor.NumericBlock> new_ks ← empty
    for range 0‥num_kv_heads const g {
        const tensor.NumericBlock kg ← _head(k, g * d, d)
        new_ks.append(_rope(kg, rope_dim, table, interposita))
    }
    const tensor.NumericBlock new_k ← _reconcile(new_ks)

    # --- append to the cached prefix --------------------------------------
    const tensor.NumericBlock full_k ← _concat_rows(layer.key, new_k)
    const tensor.NumericBlock full_v ← _concat_rows(layer.payload, v)

    # --- per-head blocks (GQA split → RoPE → causal) ----------------------
    var list<tensor.NumericBlock> heads ← empty
    for range 0‥num_heads const h {
        # --- GQA group + query split + RoPE -------------------------------
        const int group ← h / ratio
        const tensor.NumericBlock qh ← _head(q, h * d, d)
        const tensor.NumericBlock qr ← _rope(qh, rope_dim, table, interposita)

        # --- cached K/V split + causal attention --------------------------
        const tensor.NumericBlock kg_all ← _head(full_k, group * d, d)
        const tensor.NumericBlock vg_all ← _head(full_v, group * d, d)
        heads.append(_attention_core_offset(qr, kg_all, vg_all, scale, prefix_before))
    }

    # --- head concatenation + output projection ---------------------------
    const tensor.NumericBlock concat ← _reconcile(heads)
    const tensor.NumericBlock context ← _attention_matmul(concat, wo)

    # --- cache write + result ---------------------------------------------
    return CachedAttention {context = context, state = _write_cache(layer, tokens, new_k, v)}
}
