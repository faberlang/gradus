    assert close(weights[[1]], 0.2689414)
}

test "decode_hybrid_kernels row_softmax_sink O(C) online matches two-pass reference on non-uniform rows" {
    mut tensor<f32, [2, 4]> sc ← tf32[2, 4] {}
    mut tensor<f32, [2]> sink ← tf32[2] {}
    mut tensor<f32, [2, 4]> pr ← tf32[2, 4] {}
    sc[[0, 0]] ← -1.0
    sc[[0, 1]] ← 2.0
    sc[[0, 2]] ← 0.5
    sc[[0, 3]] ← 3.0
    sink[[0]] ← 1.0
    sc[[1, 0]] ← 4.0
    sc[[1, 1]] ← 4.0
    sc[[1, 2]] ← -2.0
    sc[[1, 3]] ← 0.0
    sink[[1]] ← 5.0
    dhk.row_softmax_sink(sc, sink, mut pr)
    for range 0‥2 let h {
        mut f32 m ← sink[[h]]
        for range 0‥4 let c {
            if sc[[h, c]] ≻ m {
                m ← sc[[h, c]]
            }
        }
        mut f32 denom ← (sink[[h]] - m).exp()
        for range 0‥4 let c {
            denom ← denom + (sc[[h, c]] - m).exp()
        }
        for range 0‥4 let c {
            let f32 expected ← (sc[[h, c]] - m).exp() / denom
            assert close(pr[[h, c]], expected)
        }
    }
}

test "decode_hybrid_kernels l2norm_repeat_slice and z_gated_rmsnorm O(dh) match reference" {
    mut tensor<f32, [4]> conv_out ← tf32[4] {}
    conv_out[[0]] ← 3.0
    conv_out[[1]] ← 4.0
    conv_out[[2]] ← 0.0
    conv_out[[3]] ← 2.0
    mut tensor<f32, [8]> rep ← tf32[8] {}
    dhk.l2norm_repeat_slice(conv_out, mut rep, 0, 2, 2, 0.00001)
    # head 0: [3, 4] / 5 = [0.6, 0.8]; head 1: [0, 2] / 2 = [0, 1]; repeated twice
    assert close(rep[[0]], 0.6)
    assert close(rep[[1]], 0.8)
    assert close(rep[[2]], 0.0)
    assert close(rep[[3]], 1.0)
    assert close(rep[[4]], 0.6)
    assert close(rep[[5]], 0.8)
    assert close(rep[[6]], 0.0)
    assert close(rep[[7]], 1.0)

    mut tensor<f32, [4]> z ← tf32[4] {}
    mut tensor<f32, [2]> w ← tf32[2] {}
    mut tensor<f32, [4]> zg ← tf32[4] {}
    z[[0]] ← 0.0
    z[[1]] ← 2.0
    z[[2]] ← 0.0
    z[[3]] ← -2.0
    w[[0]] ← 1.0
    w[[1]] ← 2.0
    dhk.z_gated_rmsnorm(conv_out, z, w, mut zg, 0.0)
    # head 0: rms = sqrt(12.5) = 3.535534; silu(0) = 0, silu(2) = 2/(1+exp(-2)) = 1.761594
    let f32 silu_pos2 ← (2.0 ∷ f32) / ((1.0 ∷ f32) + (-2.0 ∷ f32).exp())
    let f32 silu_neg2 ← (-2.0 ∷ f32) / ((1.0 ∷ f32) + (2.0 ∷ f32).exp())
    assert close(zg[[0]], 0.0)
    assert close(zg[[1]], (4.0 ∷ f32) / (3.535534 ∷ f32) * (2.0 ∷ f32) * silu_pos2)
    assert close(zg[[2]], 0.0)
    assert close(zg[[3]], (2.0 ∷ f32) / (1.4142135 ∷ f32) * (2.0 ∷ f32) * silu_neg2)

    # Direct O(dh) two-pass kernels match the legacy single-pass forms.
    mut tensor<f32, [2]> l2_scale ← tf32[2] {}
    mut tensor<f32, [8]> rep2 ← tf32[8] {}
    dhk.l2norm_src_scale(conv_out, mut l2_scale, 0, 2, 0.00001)
    dhk.l2norm_repeat_apply(conv_out, l2_scale, mut rep2, 0, 2, 2)
    for range 0‥8 let i {
        assert close(rep2[[i]], rep[[i]])
    }

    mut tensor<f32, [2]> inv_h ← tf32[2] {}
    mut tensor<f32, [4]> rn_out ← tf32[4] {}
    mut tensor<f32, [4]> rn_ref ← tf32[4] {}
    mut tensor<f32, [4]> zg2 ← tf32[4] {}
    dhk.rmsnorm_heads_inv(conv_out, mut inv_h, 2, 0.0)
    dhk.rmsnorm_heads_apply(conv_out, w, inv_h, mut rn_out)
    dhk.rmsnorm_heads(conv_out, w, mut rn_ref, 0.0)
    dhk.z_gated_rmsnorm_apply(conv_out, z, w, inv_h, mut zg2)
    for range 0‥4 let i {
        assert close(rn_out[[i]], rn_ref[[i]])
        assert close(zg2[[i]], zg[[i]])
    }
}

test "decode_hybrid_kernels Split-C row_softmax_sink matches single-pass row_softmax_sink" {
    mut tensor<f32, [2, 8]> rsi ← tf32[2, 8] {}
    mut tensor<f32, [2]> rsink ← tf32[2] {}
    mut tensor<f32, [2, 8]> rso_ref ← tf32[2, 8] {}
    mut tensor<f32, [2, 8]> rso_split ← tf32[2, 8] {}
    mut tensor<f32, [2, 4]> part_m ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> part_d ← tf32[2, 4] {}
    mut tensor<f32, [2]> row_m ← tf32[2] {}
    mut tensor<f32, [2]> row_inv_d ← tf32[2] {}

    rsink[[0]] ← 1.25
    rsink[[1]] ← -0.75
    for range 0‥8 let c {
        rsi[[0, c]] ← ((c ↦ f32) - 3.5) * 0.6
        rsi[[1, c]] ← (3.0 - (c ↦ f32)) * 0.4
    }

    dhk.row_softmax_sink(rsi, rsink, mut rso_ref)
    dhk.row_softmax_sink_part(rsi, mut part_m, mut part_d)
    dhk.row_softmax_sink_reduce(part_m, part_d, rsink, mut row_m, mut row_inv_d)
    dhk.row_softmax_sink_apply(rsi, row_m, row_inv_d, mut rso_split)

    for range 0‥2 let h {
        for range 0‥8 let c {
            assert close(rso_split[[h, c]], rso_ref[[h, c]])
        }
    }

    # Exact P=1024 boundary check (previously masked to 0 by p_len & 1023)
    mut tensor<f32, [1, 2]> rsi_b ← tf32[1, 2] {}
    mut tensor<f32, [1]> rsink_b ← tf32[1] {}
    mut tensor<f32, [1, 2]> rso_b_ref ← tf32[1, 2] {}
    mut tensor<f32, [1, 2]> rso_b_split ← tf32[1, 2] {}
    mut tensor<f32, [1, 1024]> part_m_b ← tf32[1, 1024] {}
    mut tensor<f32, [1, 1024]> part_d_b ← tf32[1, 1024] {}
    mut tensor<f32, [1]> row_m_b ← tf32[1] {}
    mut tensor<f32, [1]> row_inv_d_b ← tf32[1] {}
    rsink_b[[0]] ← 0.5
    rsi_b[[0, 0]] ← 1.25
    rsi_b[[0, 1]] ← -0.75
    dhk.row_softmax_sink(rsi_b, rsink_b, mut rso_b_ref)
    dhk.row_softmax_sink_part(rsi_b, mut part_m_b, mut part_d_b)
    dhk.row_softmax_sink_reduce(part_m_b, part_d_b, rsink_b, mut row_m_b, mut row_inv_d_b)
    dhk.row_softmax_sink_apply(rsi_b, row_m_b, row_inv_d_b, mut rso_b_split)
    assert close(rso_b_split[[0, 0]], rso_b_ref[[0, 0]])
    assert close(rso_b_split[[0, 1]], rso_b_ref[[0, 1]])
}

test "decode_hybrid_kernels moe_sigmoid_renorm_weights and split_q_gate_interleaved + sigmoid_mul" {
    # Sigmoid renormalization over top-2 logits [0.0, 2.0]:
    # sig(0) = 0.5, sig(2) = 1/(1+exp(-2)) ~ 0.8807971
    mut tensor<f32, [2]> top_vals ← tf32[2] {}
    mut tensor<f32, [2]> sig_w ← tf32[2] {}
    top_vals[[0]] ← 0.0
    top_vals[[1]] ← 2.0
    dhk.moe_sigmoid_renorm_weights(top_vals, mut sig_w)
    let f32 s0 ← 0.5 ∷ f32
    let f32 s1 ← (1.0 ∷ f32) / ((1.0 ∷ f32) + (-2.0 ∷ f32).exp())
    assert close(sig_w[[0]], s0 / (s0 + s1))
    assert close(sig_w[[1]], s1 / (s0 + s1))

    # Interleaved 2*QD split (2 heads, head_dim=2 -> TwoQD=8, QD=4) + sigmoid_mul
    mut tensor<f32, [8]> q_full ← tf32[8] {}
    q_full[[0]] ← 1.0
    q_full[[1]] ← 2.0
    q_full[[2]] ← 0.0
    q_full[[3]] ← 2.0
    q_full[[4]] ← 3.0
    q_full[[5]] ← 4.0
    q_full[[6]] ← -2.0
    q_full[[7]] ← 0.0
    mut tensor<f32, [4]> q_out ← tf32[4] {}
    mut tensor<f32, [4]> q_gate ← tf32[4] {}
    mut tensor<f32, [4]> gated ← tf32[4] {}
    dhk.split_q_gate_interleaved(q_full, mut q_out, mut q_gate, 2)
    assert close(q_out[[0]], 1.0)
    assert close(q_out[[1]], 2.0)
    assert close(q_out[[2]], 3.0)
    assert close(q_out[[3]], 4.0)
    assert close(q_gate[[0]], 0.0)
    assert close(q_gate[[1]], 2.0)
    assert close(q_gate[[2]], -2.0)
    assert close(q_gate[[3]], 0.0)

    dhk.sigmoid_mul(q_out, q_gate, mut gated)
    assert close(gated[[0]], 0.5)
    assert close(gated[[1]], 2.0 ∷ f32 * s1)
    assert close(gated[[2]], 3.0 ∷ f32 * ((1.0 ∷ f32) / ((1.0 ∷ f32) + (2.0 ∷ f32).exp())))
    assert close(gated[[3]], 2.0)
}

test "decode_hybrid_kernels batched norm_qk_heads and row_softmax_sink match B=1" {
    mut tensor<f32, [2, 4]> q_b ← tf32[2, 4] {}
    q_b[[0, 0]] ← 3.0
    q_b[[0, 1]] ← 4.0
    q_b[[0, 2]] ← 1.0
    q_b[[0, 3]] ← 1.0
    q_b[[1, 0]] ← 1.0
    q_b[[1, 1]] ← 1.0
    q_b[[1, 2]] ← 3.0
    q_b[[1, 3]] ← 4.0
    mut tensor<f32, [2]> qn_w ← tf32[2] {}
    qn_w[[0]] ← 1.0
    qn_w[[1]] ← 2.0
    mut tensor<f32, [2, 2]> inv_b ← tf32[2, 2] {}
    mut tensor<f32, [2, 4]> qn_b ← tf32[2, 4] {}
    dhk.rmsnorm_heads_inv_batch(q_b, mut inv_b, 2, 0.0, 2)
    dhk.rmsnorm_heads_apply_batch(q_b, qn_w, inv_b, mut qn_b, 2)
    assert close(qn_b[[0, 0]], 0.8485281)
    assert close(qn_b[[0, 1]], 2.2627417)
    assert close(qn_b[[1, 2]], 0.8485281)
    assert close(qn_b[[1, 3]], 2.2627417)

    mut tensor<f32, [4, 2]> sc_b ← tf32[4, 2] {}
    sc_b[[0, 0]] ← 0.0
    sc_b[[0, 1]] ← 0.0
    sc_b[[1, 0]] ← 1.0
    sc_b[[1, 1]] ← 1.0
    sc_b[[2, 0]] ← 0.0
    sc_b[[2, 1]] ← 0.0
    sc_b[[3, 0]] ← 1.0
    sc_b[[3, 1]] ← 1.0
    mut tensor<f32, [2]> sink_b ← tf32[2] {}
    sink_b[[0]] ← 0.0
    sink_b[[1]] ← 1.0
    mut tensor<f32, [4]> bh_dom ← tf32[4] {}
    mut tensor<f32, [4, 2]> pr_b ← tf32[4, 2] {}
    dhk.row_softmax_sink_batch(bh_dom, sc_b, sink_b, mut pr_b, 2)
    assert close(pr_b[[0, 0]], 0.3333333)
    assert close(pr_b[[3, 1]], 0.3333333)
}

test "decode_hybrid_kernels batched q_gate and rope_sectional match B=1" {
    mut tensor<f32, [2, 8]> q_full ← tf32[2, 8] {}
    q_full[[0, 0]] ← 1.0
    q_full[[0, 1]] ← 2.0
    q_full[[0, 2]] ← 0.0
    q_full[[0, 3]] ← 2.0
    q_full[[1, 4]] ← 3.0
    q_full[[1, 5]] ← 4.0
    q_full[[1, 6]] ← -2.0
    q_full[[1, 7]] ← 0.0
    mut tensor<f32, [2, 4]> q_out ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> q_gate ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> gated ← tf32[2, 4] {}
    dhk.split_q_gate_interleaved_batch(q_full, mut q_out, mut q_gate, 2, 2)
    dhk.sigmoid_mul_batch(q_out, q_gate, mut gated, 2)
    let f32 s2 ← (1.0 ∷ f32) / ((1.0 ∷ f32) + (-2.0 ∷ f32).exp())
    assert close(gated[[0, 0]], 0.5)
    assert close(gated[[0, 1]], 2.0 ∷ f32 * s2)
    assert close(gated[[1, 2]], 3.0 ∷ f32 * ((1.0 ∷ f32) / ((1.0 ∷ f32) + (2.0 ∷ f32).exp())))
    assert close(gated[[1, 3]], 2.0)

    mut tensor<i32, [4]> sec ← ti32[4] {}
    sec[[0]] ← 1
    mut tensor<f32, [2, 4]> r_in ← tf32[2, 4] {}
    r_in[[0, 0]] ← 1.0
    r_in[[0, 1]] ← 2.0
    r_in[[1, 0]] ← 1.0
    r_in[[1, 1]] ← 2.0
    r_in[[1, 2]] ← 7.0
    r_in[[1, 3]] ← 8.0
    mut tensor<f32, [2, 4]> r_out ← tf32[2, 4] {}
    dhk.rope_sectional_batch(r_in, mut r_out, 0, 4, sec, 0.0, 2)
    assert close(r_out[[0, 0]], 1.0)
    assert close(r_out[[1, 0]], -1.1426397)
    assert close(r_out[[1, 1]], 1.9220756)
    assert close(r_out[[1, 2]], 7.0)
}

test "decode_hybrid_kernels batched MoE routing and experts match B=1" {
    mut tensor<f32, [2, 2]> logits ← tf32[2, 2] {}
    logits[[0, 0]] ← 0.0
    logits[[0, 1]] ← 2.0
    logits[[1, 0]] ← 2.0
    logits[[1, 1]] ← 0.0
    mut tensor<i32, [2, 2]> idx ← ti32[2, 2] {}
    mut tensor<f32, [2, 2]> vals ← tf32[2, 2] {}
    mut tensor<f32, [2, 2]> weights ← tf32[2, 2] {}
    dhk.moe_topk_indices_batch(logits, mut idx, mut vals, 2)
    dhk.moe_sigmoid_renorm_weights_batch(vals, mut weights, 2)
    assert idx[[0, 0]] ≡ 1 and idx[[1, 0]] ≡ 0

    mut tensor<f32, [2, 2]> x_m ← tf32[2, 2] {}
    x_m[[0, 0]] ← 1.0
    x_m[[1, 0]] ← 1.0
    mut tensor<f32, [4, 2]> wg ← tf32[4, 2] {}
    wg[[0, 0]] ← 1.0
    wg[[2, 0]] ← 1.0
    mut tensor<f32, [4, 2]> wu ← tf32[4, 2] {}
    wu[[0, 0]] ← 1.0
    wu[[2, 0]] ← 1.0
    mut tensor<f32, [4, 2]> wd ← tf32[4, 2] {}
    wd[[0, 0]] ← 1.0
    wd[[2, 0]] ← 3.0
    mut tensor<f32, [4, 2]> act ← tf32[4, 2] {}
    mut tensor<f32, [2, 2]> m_out ← tf32[2, 2] {}
    dhk.moe_experts_gate_up_swiglu_batch<size 2, size 4, size 2, size 4, size 2, size 2>(wg, wu, x_m, idx, mut act, 2)
    dhk.moe_experts_down_accum_batch<size 2, size 4, size 2, size 4, size 2, size 2>(wd, act, idx, weights, mut m_out, 2)
    let f32 silu1 ← (1.0 ∷ f32) / ((1.0 ∷ f32) + (-1.0 ∷ f32).exp())
    let f32 s0 ← 0.5 ∷ f32
    let f32 s2 ← (1.0 ∷ f32) / ((1.0 ∷ f32) + (-2.0 ∷ f32).exp())
    let f32 w0 ← s0 / (s0 + s2)
    let f32 w1 ← s2 / (s0 + s2)
    assert close(m_out[[0, 0]], silu1 * (w0 * 1.0 + w1 * 3.0))
    assert close(m_out[[1, 0]], silu1 * (w1 * 1.0 + w0 * 3.0))
}
