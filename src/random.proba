+++
locale = "en"
+++
# Co-located proofs for the deterministic RNG surface.
#
# Assertions run under faber test; faber check proves this suite type-checks.

import from "gradus:random" random

# Renders an RNG-construction outcome as text.
fn seed_detail(int seed) → string {
    let _ outcome ← trap {
        random.construct_seed(seed)
    }
    if outcome is random.Seed {
        return "ok"
    }
    let random.RandomError err ← outcome
    return err.message
}

# Renders an RNG-wire deserialization outcome as text.
fn deserialize_seed_detail(string wire) → string {
    let _ outcome ← trap {
        random.deserialize_seed(wire)
    }
    if outcome is random.Seed {
        return "ok"
    }
    let random.RandomError err ← outcome
    return err.message
}

# ---- the seed/RNG contract

test "construct_seed seeds the generator" {
    let _ trap_result_18 ← trap {

        let random.Seed s ← random.construct_seed(1)
        assert s.status ≡ 1
    }
    assert trap_result_18 is void
}

test "construct_seed rejects the zero seed (xorshift64 degenerates at 0)" {
    assert seed_detail(0) ≡ "seed must be non-zero"
}

test "the same seed reproduces the same first draw (reproducibility)" {
    let _ trap_result_19 ← trap {

        let random.Seed s1 ← random.construct_seed(1)
        let random.Seed s2 ← random.construct_seed(1)
        let random.Draw a ← random.next(s1)
        let random.Draw b ← random.next(s2)
        assert a.payload ≡ b.payload
    }
    assert trap_result_19 is void
}

test "seed 1 state sequence matches the documented recurrence" {
    # x ^= x<<13; x ^= x>>7 (arithmetic on i64); x ^= x<<17.
    let _ trap_result_20 ← trap {

        let random.Seed s0 ← random.construct_seed(1)
        let random.Draw f1 ← random.next(s0)
        assert f1.payload ≡ 1082269761
        let random.Draw f2 ← random.next(f1.seed)
        assert f2.payload ≡ 1152992998833853505
        let random.Draw f3 ← random.next(f2.seed)
        assert f3.payload ≡ 0 - 7269227409276787159
        let random.Draw f4 ← random.next(f3.seed)
        assert f4.payload ≡ 0 - 768720241707614171
    }
    assert trap_result_20 is void
}

test "seed 42 first state matches the documented recurrence" {
    let _ trap_result_21 ← trap {

        let random.Seed s ← random.construct_seed(42)
        let random.Draw f ← random.next(s)
        assert f.payload ≡ 45454805674
    }
    assert trap_result_21 is void
}

test "seed 1 draws match the documented (state ∧ 2^63−1) >> 11 / 2^52 formula" {
    # Executed draws from seed 1: ~1.17e-10, 0.12500775141962395,
    # 0.21186878505709306, 0.9166551843907023. The first draw is
    # the documented ~1.17e-10 bound; the next three match the
    # f64 formula pins.
    let _ trap_result_22 ← trap {

        let random.Seed s0 ← random.construct_seed(1)
        let random.DrawF32 d1 ← random.next_f32(s0)
        let random.DrawF32 d2 ← random.next_f32(d1.seed)
        let random.DrawF32 d3 ← random.next_f32(d2.seed)
        let random.DrawF32 d4 ← random.next_f32(d3.seed)
        assert d1.payload ≺ 0.000001 ∷ f32
        assert d2.payload.approx(0.1250078 ∷ f32, 0.000001 ∷ f32)
        assert d3.payload.approx(0.2118688 ∷ f32, 0.000001 ∷ f32)
        assert d4.payload.approx(0.9166552 ∷ f32, 0.000001 ∷ f32)
    }
    assert trap_result_22 is void
}

test "the RNG wire round-trips a positive state exactly" {
    let _ trap_result_23 ← trap {

        let random.Seed s ← random.construct_seed(42)
        let random.Seed t ← random.deserialize_seed(random.serialize_seed(s))
        assert t.status ≡ 42
    }
    assert trap_result_23 is void
}

test "the RNG wire round-trips a negative state exactly (signed i64 status)" {
    # f3.seed.status is the signed i64 value -7269227409276787159.
    let _ trap_result_24 ← trap {

        let random.Seed s0 ← random.construct_seed(1)
        let random.Draw f1 ← random.next(s0)
        let random.Draw f2 ← random.next(f1.seed)
        let random.Draw f3 ← random.next(f2.seed)
        let random.Seed t ← random.deserialize_seed(random.serialize_seed(f3.seed))
        assert t.status ≡ f3.seed.status
    }
    assert trap_result_24 is void
}

test "the RNG wire preserves its exact versioned encoding" {
    let _ trap_result_25 ← trap {
        let random.Seed s ← random.construct_seed(42)
        assert random.serialize_seed(s) ≡ "train/rng/1.0.0/42"
    }
    assert trap_result_25 is void
}

test "the RNG wire rejects malformed, unknown-version, unknown-marker, and zero-state inputs" {
    assert deserialize_seed_detail("tensor/rng/1.0.0/42") ≡ "unknown rng marker"
    assert deserialize_seed_detail("train/rng/9.9.9/42") ≡ "unknown rng schema version"
    assert deserialize_seed_detail("train/rng/1.0.0") ≡ "malformed rng wire"
    assert deserialize_seed_detail("train/rng/1.0.0/nope") ≡ "malformed rng state"
    assert deserialize_seed_detail("train/rng/1.0.0/0") ≡ "seed must be non-zero"
}


test "fan uniform initialization is reproducible, bounded, and consumes draws only for weights" {
    let _ trap_result_26 ← trap {
        let random.Seed seed ← random.construct_seed(42)
        let random.Initialized a ← random.initialize_fan_uniform([[2, 2], [2]], [false, true], seed)
        let random.Initialized b ← random.initialize_fan_uniform([[2, 2], [2]], [false, true], seed)
        assert a.tensors[0].data ≡ b.tensors[0].data
        assert a.seed.status ≡ b.seed.status
        assert a.tensors[1].data ≡ [0.0, 0.0]
        let f32 bound ← (6.0 / 4.0).power(0.5)
        let f32 first ← a.tensors[0].data[0]
        let f32 second ← a.tensors[0].data[1]
        assert first ≥ (0.0 - bound) and first ≤ bound
        assert second ≥ (0.0 - bound) and second ≤ bound
        assert first ≢ second
    }
    assert trap_result_26 is void
}

test "a later shape does not change earlier parameter draws" {
    let _ trap_result_27 ← trap {
        let random.Seed seed ← random.construct_seed(7)
        let random.Initialized a ← random.initialize_fan_uniform([[2, 2], [2, 2]], [false, false], seed)
        let random.Initialized b ← random.initialize_fan_uniform([[2, 2], [3, 2]], [false, false], seed)
        assert a.tensors[0].data ≡ b.tensors[0].data
    }
    assert trap_result_27 is void
}
