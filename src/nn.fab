+++
locale = "en"
+++
# Differentiable NN primitives facade.
#
# Public import: import from "gradus:nn" nn
#
# S4-A (gpu-training-lowering stage-4-delivery.md): first concrete
# static-shape primitives — linear layer and GELU activation, bounded to the
# first two callers (linear regression 2×2, MLP 4×4). Shape generics are not
# available yet; follow the norma:optimizer concrete-overload precedent.
#
# S6-G1 (gpu-training-lowering stage-6-delivery.md): BERT-tiny shapes —
# linear_2x8 with per-channel [8] bias via the S6-C2 added_bias contract,
# layernorm_2x8, and gelu_2x8.
#
# Architectural rule: primitives do not know the architectures built from
# them. This module must not import from gradus:attention or
# gradus:transformer. Each primitive must be independently differentiable.
# No module owns a backend or device handle.
#
# PML0-U3 ledger disposition (pml0-proof-api-ledger.md, gradus 33df687) —
# executed at PML1-U6: all six fixed-shape primitives are ADMITTED as
# caller-backed public API (grep-verified live callers in package code):
#   linear_2x2    row 1 — examples/training/linear-regression/src/train.fab:93
#   linear_4x4    row 2 — examples/training/mlp/src/train.fab:150,152
#   gelu_4x4      row 3 — examples/training/mlp/src/train.fab:151
#   linear_2x8    row 4 — bert-tiny-fragment train.fab:363-372;
#                         bert-gradus-probe train.fab:361-371
#   layernorm_2x8 row 5 — bert-tiny-fragment train.fab:362,369,374;
#                         bert-gradus-probe train.fab:360,367,372
#   gelu_2x8      row 6 — bert-tiny-fragment train.fab:371;
#                         bert-gradus-probe train.fab:369
#
# PML3-U1 (production-ml-library/pml3-delivery.md): the PRODUCTION surface —
# shape-generic forward-only primitives over the PML1 staged tensor carrier
# (gradus:tensor NumericBlock): linear, gelu, layernorm. They compose the PML1
# operation families (gradus:math matmul/add) and the staged carrier; they
# do NOT use the compiler's typed-tensor ops (tensor<f32, [...]>), so their
# shapes are runtime facts (R3: no one-row/one-shape narrowing in the public
# API). Every failure is a typed NnError with a text message.
#
# --- Autograd independence (PML3 thesis, forward-without-autograd) --------
# This module imports NO autograd surface: no gradus:gradient, no @ radix
# backward annotations, no companion ABI, no tape. The production surface is
# pure value functions over the staged carrier; a training path that needs
# gradients composes these primitives inside a gradient-module annotation
# (PML3-U4 proves the shared-layer composition). The co-located proba
# exercises the whole surface with no autograd import at all.
#
# --- Formulas (matching the accepted GPU-training proofs) -----------------
#   linear(x, w, b) = x·w + b — x [M,K], w [K,N]; b is rank-0 empty
#                      (absent: y = x·w, no add), [N] (per-channel, the
#                      linear_2x8 contract; added without synthesizing
#                      [M,N]), or [M,N] (same-shape, the linear_2x2 /
#                      linear_4x4 contract).
#   gelu(x)         = 0.5·x·(1 + tanh(√(2/π)·(x + 0.044715·x³))) — the
#                      tanh-approximation identity of the compiler's GELU
#                      (radix-air reverse_ad_ops_test), self-hosted: tanh
#                      via the e^{2t} identity (power) so no scalar
#                      transcendental builtin is required.
#   layernorm(x,γ,β,ε) = (x − μ)/√(Var + ε)·γ + β over the LAST axis with
#                      per-feature γ/β [C] — the layernorm(1, ε, γ, β)
#                      contract of the accepted layernorm_2x8 row.
#   rmsnorm(x,γ,ε)    = x/√(mean(x²) + ε)·γ over the LAST axis, per-feature
#                      γ [C], no centering — the llama-arch norm family
#                      (llama.cpp LLM_NORM_RMS; ε explicit, llama default
#                      1e-5), REF-01-U1.1.
#
# --- Compiler-boundary notes ----------------------------------------------
#   * The staged carrier (runtime shape) exists precisely so shape-generic
#     library functions typecheck in library context (SEM014 holes do not
#     unify); this surface is the first consumer of that posture beyond math.
#   * GELU precision: the CPU reference (FMIR stepper) evaluates gelu in
#     f64; this surface is f32 self-hosted. Row tests compare with a
#     documented tolerance (approximate), not bit equality.
#   * const-with-cast module initializers are a recorded stepper residual
#     (execution); they typecheck under faber check.

import from "gradus:dtype" dtype

import from "gradus:math" math

import from "gradus:shape" shape

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# linear_2x2 — y = x·W + b (2×2 f32, linear-regression shape)
# -------------------------------------------------------------------------

# Bridge a typed-tensor flat buffer into the staged carrier. The compiled
# rust route does not carry typed-tensor methods (matmul / added /
# added_bias / gelu / layer_norm) on staged structs; the admitted
# fixed-shape rows therefore convert, call the staged production family,
# and convert back.
fn _staged(list<f32> data, list<int> shape) → tensor.NumericBlock {
    return tensor.stage(dtype.f32(), shape, data)
}

@ public
fn linear_2x2(tensor<f32, [2, 2]> input, tensor<f32, [2, 2]> weight, tensor<f32, [2, 2]> bias) → tensor<f32, [2, 2]> ⇥ NnError {
    const tensor.NumericBlock raw_x ← _staged(input ↦ list<f32>, [2, 2])
    const tensor.NumericBlock raw_w ← _staged(weight ↦ list<f32>, [2, 2])
    const tensor.NumericBlock raw_b ← _staged(bias ↦ list<f32>, [2, 2])
    return linear_from_raw<2, 2, 2>(raw_x, raw_w, raw_b)
}

# -------------------------------------------------------------------------
# linear_4x4 — y = x·W + b (4×4 f32, MLP shape)
# -------------------------------------------------------------------------

@ public
fn linear_4x4(tensor<f32, [4, 4]> input, tensor<f32, [4, 4]> weight, tensor<f32, [4, 4]> bias) → tensor<f32, [4, 4]> {
    return linear(input, weight, bias)
}

# -------------------------------------------------------------------------
# gelu_4x4 — GELU activation (4×4 f32, MLP hidden activation)
# -------------------------------------------------------------------------

@ public
fn gelu_4x4(tensor<f32, [4, 4]> x) → tensor<f32, [4, 4]> ⇥ NnError {
    const tensor.NumericBlock y ← gelu(_staged(x ↦ list<f32>, [4, 4]))
    do {
        return y.data ↦ tensor<f32, [4, 4]>
    }
    catch conv {
        throw variant GradusMismatch {message = "gelu_4x4 result conversion failed"}
    }
}

# -------------------------------------------------------------------------
# linear_2x8 — y = x·W + b (2×8 f32, BERT-tiny shape)
#   weight [8,8], per-channel bias [8]. The bias add uses the S6-C2
#   added_bias rank-extension contract (bias [8] against receiver [2,8]),
#   not the fragment's [2,8] same-shape workaround.
# -------------------------------------------------------------------------

@ public
fn linear_2x8(tensor<f32, [2, 8]> input, tensor<f32, [8, 8]> weight, tensor<f32, [8]> bias) → tensor<f32, [2, 8]> ⇥ NnError {
    const tensor.NumericBlock y ← linear_carrier(_staged(input ↦ list<f32>, [2, 8]), _staged(weight ↦ list<f32>, [8, 8]), _staged(bias ↦ list<f32>, [8]))
    do {
        return y.data ↦ tensor<f32, [2, 8]>
    }
    catch conv {
        throw variant GradusMismatch {message = "linear_2x8 result conversion failed"}
    }
}

# -------------------------------------------------------------------------
# layernorm_2x8 — LayerNorm (2×8 f32, BERT-tiny shape)
#   per-channel scale/offset [8]; axis = 1, epsilon = 1e-5 — the fragment's
#   layernorm(1, 1.0e-5, scale, offset) contract.
# -------------------------------------------------------------------------

@ public
fn layernorm_2x8(tensor<f32, [2, 8]> x, tensor<f32, [8]> scale, tensor<f32, [8]> offset) → tensor<f32, [2, 8]> ⇥ NnError {
    const tensor.NumericBlock y ← layernorm(_staged(x ↦ list<f32>, [2, 8]), _staged(scale ↦ list<f32>, [8]), _staged(offset ↦ list<f32>, [8]), 0.00001 ∷ f32)
    do {
        return y.data ↦ tensor<f32, [2, 8]>
    }
    catch conv {
        throw variant GradusMismatch {message = "layernorm_2x8 result conversion failed"}
    }
}

# -------------------------------------------------------------------------
# gelu_2x8 — GELU activation (2×8 f32, BERT-tiny FFN hidden activation)
# -------------------------------------------------------------------------

@ public
fn gelu_2x8(tensor<f32, [2, 8]> x) → tensor<f32, [2, 8]> ⇥ NnError {
    const tensor.NumericBlock y ← gelu(_staged(x ↦ list<f32>, [2, 8]))
    do {
        return y.data ↦ tensor<f32, [2, 8]>
    }
    catch conv {
        throw variant GradusMismatch {message = "gelu_2x8 result conversion failed"}
    }
}

# =========================================================================
# PML3-U1 — production surface (shape-generic, forward-only, typed errors)
# =========================================================================

# -------------------------------------------------------------------------
# NnError — typed error vocabulary of the NN primitive surface. Every
# variant carries a text message (render via message), mirroring the tensor/
# shape/dtype/math error contract.
# -------------------------------------------------------------------------

@ public
union NnError {
    @ shared
    string message

    @ conversion shape.ShapeError err {
        match err {
            case shape.ShapeError.NegativeDimension const message { return variant NegativeDimension {message = message} }
            case shape.ShapeError.DimensionAboveLimit const message { return variant DimensionAboveLimit {message = message} }
            case shape.ShapeError.ProductAboveLimit const message { return variant ProductAboveLimit {message = message} }
            case shape.ShapeError.Incompatible const message { return variant Incompatible {message = message} }
            case shape.ShapeError.ElementMismatch const message { return variant ElementMismatch {message = message} }
            case _ { return variant ShapeMismatch {message = err.message} }
        }
    }
    @ conversion math.MathError err {
        match err {
            case math.MathError.NegativeDimension const message { return variant NegativeDimension {message = message} }
            case math.MathError.DimensionAboveLimit const message { return variant DimensionAboveLimit {message = message} }
            case math.MathError.ProductAboveLimit const message { return variant ProductAboveLimit {message = message} }
            case math.MathError.GradusMismatch const message { return variant GradusMismatch {message = message} }
            case math.MathError.ShapeMismatch const message { return variant ShapeMismatch {message = message} }
            case math.MathError.Incompatible const message { return variant Incompatible {message = message} }
            case math.MathError.DtypeMismatch const message { return variant DtypeMismatch {message = message} }
            case math.MathError.ElementMismatch const message { return variant ElementMismatch {message = message} }
            case _ { return variant ShapeMismatch {message = err.message} }
        }
    }

    NegativeDimension,
    DimensionAboveLimit,
    ProductAboveLimit,
    GradusMismatch,
    ShapeMismatch,
    Incompatible,
    DtypeMismatch,
    ElementMismatch,
    InvalidEpsilon
}



# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# GELU tanh-approximation constants (the compiler identity:
# √(2/π) and the cubic correction 0.044715).
const f32 GELU_ALPHA ← 0.7978845608028654 ∷ f32

const f32 GELU_BETA ← 0.044715 ∷ f32

# LayerNorm default epsilon — the accepted rows' layernorm(1, 1e-5, …).
const f32 LAYERNORM_EPSILON_DEFAULT ← 0.00001 ∷ f32

# Bounded element count with the module's typed error mapping (ShapeError →
# NnError, variant identity preserved via the documented message text — same
# pattern as math.fab).
fn _numel_valid(list<int> f) → int ⇥ NnError {
    return shape.numel(f)
}

# F32-only gate — the admitted rows are the F32 row; a differently tagged
# staged carrier fails closed (dtype mismatch is explicit, never implicit).
fn _dtype_f32(tensor.NumericBlock t) → bool ⇥ NnError {
    require dtype.name(t.dtype()) ≡ "f32" throw variant DtypeMismatch {message = "unsupported dtype for nn primitive"}
    return true
}

# Three-way dtype parity + F32 gate for primitives with affine/weight peers.
fn _dtype_triplet(tensor.NumericBlock a, tensor.NumericBlock b, tensor.NumericBlock c) → bool ⇥ NnError {
    const string ta ← dtype.name(a.dtype())
    const string tb ← dtype.name(b.dtype())
    const string tc ← dtype.name(c.dtype())
    require not (ta ≠ tb or tb ≠ tc) throw variant DtypeMismatch {message = "dtype mismatch"}
    require ta ≡ "f32" throw variant DtypeMismatch {message = "unsupported dtype for nn primitive"}
    return true
}

# Two-way dtype parity + F32 gate (scale-only peers, e.g. rmsnorm).
fn _dtype_pair(tensor.NumericBlock a, tensor.NumericBlock b) → bool ⇥ NnError {
    const string ta ← dtype.name(a.dtype())
    const string tb ← dtype.name(b.dtype())
    require ta ≡ tb throw variant DtypeMismatch {message = "dtype mismatch"}
    require ta ≡ "f32" throw variant DtypeMismatch {message = "unsupported dtype for nn primitive"}
    return true
}

# e^x via the exponentiation intrinsic (base e > 0, so the non-positive
# base guard never fires; power lowers to exp(x·ln(e)) ≈ exp(x)).
fn _exp(f32 x) → f32 {
    return (2.718281828459045 ∷ f32).power(x)
}

# tanh via the e^{2t} identity, split by sign so e^{2|t|} never overflows to
# NaN: tanh(t) → 1 for t → +∞ and −1 for t → −∞ (2/(Inf+1) − 1 = −1.0).
fn _tanh(f32 t) → f32 {
    if t ≥ 0.0 {
        const f32 e ← _exp(2.0 * t)
        return 1.0 - 2.0 / (e + 1.0)
    }
    const f32 e ← _exp(-2.0 * t)
    return 2.0 / (e + 1.0) - 1.0
}

# sqrt via Newton iteration (var + ε ≥ 0 always; the non-positive guard
# covers the ε = 0 / constant-row corner). Prescale by factors of four so
# the initial ratio is in the quadratic-convergence regime, then restore the
# square-root scale after the fixed twelve iterations.
fn _sqrt(f32 x) → f32 {
    if x ≤ 0.0 then return 0.0
    var f32 scaled ← x
    var f32 rescale ← 1.0
    while scaled ≻ 1.0 {
        scaled ← scaled / 4.0
        rescale ← rescale * 2.0
    }
    var f32 guess ← scaled / 2.0
    if guess ≤ 0.0 {
        guess ← scaled
    }
    for range 0‥12 const i {
        guess ← (guess + scaled / guess) / 2.0
    }
    return guess * rescale
}

# GELU scalar — the tanh approximation identity of the compiler's GELU.
fn _scalar_gelu(f32 v) → f32 {
    const f32 t ← GELU_ALPHA * (v + ((GELU_BETA * v) * v) * v)
    return (0.5 * v) * (1.0 + _tanh(t))
}

# sigmoid via the e^{-t} identity, split by sign so the exponent never
# overflows (1/(1+e^{-t}) for t ≥ 0; e^{t}/(1+e^{t}) for t < 0 — both
# bounded, mirroring the _tanh sign split).
@ public
fn σ(f32 v) → f32 {
    if v ≥ 0.0 {
        const f32 e ← _exp(-v)
        return 1.0 / (e + 1.0)
    }
    const f32 e ← _exp(v)
    return e / (e + 1.0)
}

# SiLU scalar — the SiLU identity: silu(v) = v·sigmoid(v).
fn _scalar_silu(f32 v) → f32 {
    return v * σ(v)
}

# -------------------------------------------------------------------------
# Family: linear — y = (x · w) + b on compiler tensors.
#   x [M,K], w [K,N], b [M,N]. Per-channel [N] and absent (rank-0)
#   bias stay on linear_carrier.
# -------------------------------------------------------------------------

@ kernel
@ public
fn linear<size M, size K, size N>(tensor<f32, [M, K]> x, tensor<f32, [K, N]> w, tensor<f32, [M, N]> b) → tensor<f32, [M, N]> {
    return (x · w) + b
}

# linear_from_raw — one load-edge pin. Staged NumericBlock.data ↦ compiler
# tensor, then typed linear. Not a second production math.
fn linear_from_raw<size M, size K, size N>(tensor.NumericBlock raw_x, tensor.NumericBlock raw_w, tensor.NumericBlock raw_b) → tensor<f32, [M, N]> ⇥ NnError {
    const tensor.NumericBlock raw ← raw_x
    do {
        const _ x ← raw.data ↦ tensor<f32, [M, K]>
        const _ w ← raw_w.data ↦ tensor<f32, [K, N]>
        const _ b ← raw_b.data ↦ tensor<f32, [M, N]>
        return linear(x, w, b)
    }
    catch conv {
        throw variant GradusMismatch {message = "linear input conversion failed"}
    }
}

# linear_carrier — load-edge staged residual. Same rank/dtype/matmul
# ladder as the former production linear; not the production name (SEM005).
# Bias:
#   rank-0 empty → y = x·w (no [M,N] fill, no add)
#   [N]          → per-channel add via right-aligned broadcast
#   [M,N]        → same-shape add
@ public
fn linear_carrier(tensor.NumericBlock x, tensor.NumericBlock w, tensor.NumericBlock b) → tensor.NumericBlock ⇥ NnError {
    # legacy-L3: shape recovery pending shape-binding/S0-R1.
    const list<int> fx ← x.shape()
    const list<int> fw ← w.shape()
    require fx.length() ≡ 2 throw variant GradusMismatch {message = "linear requires rank-2 input"}
    require fw.length() ≡ 2 throw variant GradusMismatch {message = "linear requires rank-2 weight"}
    const int m ← fx.get(0) coalesce 1
    const int k ← fx.get(1) coalesce 1
    const int n ← fw.get(1) coalesce 1
    require k ≡ fw.get(0) coalesce 1 throw variant Incompatible {message = "inner dimensions mismatch"}
    const list<int> fb ← b.shape()
    const bool absent ← fb.length() ≡ 0
    if absent {
        _dtype_pair(x, w)
    }
    else {
        _dtype_triplet(x, w, b)
        if fb.length() ≡ 1 {
            require fb.get(0) coalesce 1 ≡ n throw variant ShapeMismatch {message = "bias does not match output width"}
        }
        else {
            if fb.length() ≡ 2 {
                require not (fb.get(0) coalesce 1 ≠ m or fb.get(1) coalesce 1 ≠ n) throw variant ShapeMismatch {message = "bias does not match output shape"}
            }
            else {
                throw variant ShapeMismatch {message = "bias must be per-channel or output-shaped"}
            }
        }
    }
    const tensor.NumericBlock prediction ← math.matmul(x, w)
    if absent {
        return prediction
    }
    return math.add_carrier(prediction, b)
}

# -------------------------------------------------------------------------
# Family: gelu — GELU activation, elementwise over the staged carrier.
# Shape and dtype are preserved; the F32 row is the admitted row (any other
# tag fails closed).
# -------------------------------------------------------------------------

@ public
fn gelu(tensor.NumericBlock x) → tensor.NumericBlock ⇥ NnError {
    _dtype_f32(x)
    # legacy-L3: shape recovery pending shape-binding/S0-R1.
    const list<int> f ← x.shape()
    const int total ← _numel_valid(f)
    var list<f32> out ← empty
    # legacy-L2: staged carrier — x.data is flat list<f32>; retain range/index walk until shaped carrier migration.
    for range 0‥total const i {
        const f32 v ← x.data.get(i) coalesce 0.0 ∷ f32
        out.append(_scalar_gelu(v))
    }
    return tensor.stage(x.dtype(), f, out)
}

# -------------------------------------------------------------------------
# Family: layernorm — LayerNorm over the LAST axis of the staged carrier,
# with per-feature scale/offset [C]. Matches the accepted
# layernorm(1, ε, γ, β) contract (the layernorm_2x8 row); rank >= 1, scale
# and offset must be rank-1 of width C, epsilon must be non-negative.
# -------------------------------------------------------------------------

@ public
fn layernorm(tensor.NumericBlock x, tensor.NumericBlock scale, tensor.NumericBlock offset, f32 ε) → tensor.NumericBlock ⇥ NnError {
    _dtype_triplet(x, scale, offset)
    require ε ≥ 0.0 throw variant InvalidEpsilon {message = "negative epsilon"}
    # legacy-L3: shape recovery pending shape-binding/S0-R1.
    const list<int> f ← x.shape()
    const int r ← f.length()
    require r ≠ 0 throw variant GradusMismatch {message = "layernorm requires rank >= 1"}
    const int c ← f.get(r - 1) coalesce 1
    const list<int> fs ← scale.shape()
    const list<int> fo ← offset.shape()
    require fs.length() ≡ 1 throw variant ShapeMismatch {message = "layernorm scale must be per-channel"}
    require fo.length() ≡ 1 throw variant ShapeMismatch {message = "layernorm offset must be per-channel"}
    require fs.get(0) coalesce 1 ≡ c throw variant ShapeMismatch {message = "layernorm scale width mismatch"}
    require fo.get(0) coalesce 1 ≡ c throw variant ShapeMismatch {message = "layernorm offset width mismatch"}
    require c ≠ 0 throw variant ElementMismatch {message = "empty normalization axis"}
    const int total ← _numel_valid(f)
    const int rows ← total / c
    var list<f32> out ← empty
    # legacy-L2: staged carrier — x.data, scale.data, and offset.data are flat lists; retain indexed walks until shaped carrier migration.
    for range 0‥rows const row {
        # legacy-L4: staged carrier — row reductions wait for a shaped reduce admission.
        # Row mean over the feature axis.
        var f32 sum ← 0.0 ∷ f32
        for range 0‥c const col {
            const f32 v ← x.data.get(row * c + col) coalesce 0.0 ∷ f32
            sum ← sum + v
        }
        const f32 mean ← sum / (c ↦ f32)
        # Row variance (population, over the feature axis).
        var f32 sq ← 0.0 ∷ f32
        for range 0‥c const col2 {
            const f32 v ← x.data.get(row * c + col2) coalesce 0.0 ∷ f32
            const f32 d ← v - mean
            sq ← sq + d * d
        }
        const f32 var ← sq / (c ↦ f32)
        const f32 std ← _sqrt(var + ε)
        # Normalize + per-feature affine.
        for range 0‥c const col3 {
            const f32 v ← x.data.get(row * c + col3) coalesce 0.0 ∷ f32
            const f32 s ← scale.data.get(col3) coalesce 0.0 ∷ f32
            const f32 o ← offset.data.get(col3) coalesce 0.0 ∷ f32
            out.append(((v - mean) / std) * s + o)
        }
    }
    return tensor.stage(x.dtype(), f, out)
}

# -------------------------------------------------------------------------
# Family: rmsnorm — RMSNorm over the LAST axis of the staged carrier, with
# per-feature scale [C], no centering — the llama-arch norm family
# (llama.cpp LLM_NORM_RMS): y = x / sqrt(mean(x²) + ε) · γ. Rank >= 1, scale
# must be rank-1 of width C, epsilon must be non-negative (llama-arch
# default 1e-5; the qwen2 row uses the same family with a smaller ε — the
# epsilon parameter is explicit, matching the layernorm posture).
# -------------------------------------------------------------------------

@ public
fn rmsnorm(tensor.NumericBlock x, tensor.NumericBlock γ, f32 ε) → tensor.NumericBlock ⇥ NnError {
    _dtype_pair(x, γ)
    require ε ≥ 0.0 throw variant InvalidEpsilon {message = "negative epsilon"}
    # legacy-L3: shape recovery pending shape-binding/S0-R1.
    const list<int> f ← x.shape()
    const int r ← f.length()
    require r ≠ 0 throw variant GradusMismatch {message = "rmsnorm requires rank >= 1"}
    const int c ← f.get(r - 1) coalesce 1
    const list<int> fs ← γ.shape()
    require fs.length() ≡ 1 throw variant ShapeMismatch {message = "rmsnorm scale must be per-channel"}
    require fs.get(0) coalesce 1 ≡ c throw variant ShapeMismatch {message = "rmsnorm scale width mismatch"}
    require c ≠ 0 throw variant ElementMismatch {message = "empty normalization axis"}
    const int total ← _numel_valid(f)
    const int rows ← total / c
    var list<f32> out ← empty
    # legacy-L2: staged carrier — x.data and scale.data are flat lists; retain indexed walks until shaped carrier migration.
    for range 0‥rows const row {
        # legacy-L4: staged carrier — row reductions wait for a shaped reduce admission.
        # Row mean square over the feature axis (no centering).
        var f32 sq ← 0.0 ∷ f32
        for range 0‥c const col {
            const f32 v ← x.data.get(row * c + col) coalesce 0.0 ∷ f32
            sq ← sq + v * v
        }
        const f32 mean_sq ← sq / (c ↦ f32)
        const f32 inv ← 1.0 / _sqrt(mean_sq + ε)
        # Normalize + per-feature scale (no offset, no centering).
        for range 0‥c const col2 {
            const f32 v ← x.data.get(row * c + col2) coalesce 0.0 ∷ f32
            const f32 s ← γ.data.get(col2) coalesce 0.0 ∷ f32
            out.append((v * inv) * s)
        }
    }
    return tensor.stage(x.dtype(), f, out)
}

# -------------------------------------------------------------------------
# Family: silu — SiLU activation, elementwise over the staged carrier.
#   silu(x) = x·sigmoid(x); shape and dtype are preserved; the F32 row is
#   the admitted row (any other tag fails closed).
# -------------------------------------------------------------------------

@ public
fn silu(tensor.NumericBlock x) → tensor.NumericBlock ⇥ NnError {
    _dtype_f32(x)
    # legacy-L3: shape recovery pending shape-binding/S0-R1.
    const list<int> f ← x.shape()
    const int total ← _numel_valid(f)
    var list<f32> out ← empty
    # legacy-L2: staged carrier — x.data is flat list<f32>; retain range/index walk until shaped carrier migration.
    for range 0‥total const i {
        const f32 v ← x.data.get(i) coalesce 0.0 ∷ f32
        out.append(_scalar_silu(v))
    }
    return tensor.stage(x.dtype(), f, out)
}

# -------------------------------------------------------------------------
# Family: swiglu — the SwiGLU gated-MLP row over the staged carrier:
#   h = silu(gate) ⊙ up; y = linear(h, down_weight, down_bias).
#   gate [M,F] and up [M,F] must share the same rank-2 shape; down_weight
#   is [F,N]; down_bias is [N] (per-channel) or [M,N] (same-shape) — the
#   linear bias contracts. No fixed-shape constants; the F32 row is the
#   admitted row.
# -------------------------------------------------------------------------

@ public
fn swiglu(tensor.NumericBlock gate, tensor.NumericBlock up, tensor.NumericBlock down_weight, tensor.NumericBlock down_bias) → tensor.NumericBlock ⇥ NnError {
    _dtype_f32(gate)
    _dtype_f32(up)
    const list<int> fg ← gate.shape()
    const list<int> fu ← up.shape()
    require fg.length() ≡ 2 throw variant GradusMismatch {message = "swiglu requires rank-2 gate and up"}
    require fu.length() ≡ 2 throw variant GradusMismatch {message = "swiglu requires rank-2 gate and up"}
    require fg ≡ fu throw variant ShapeMismatch {message = "gate and up must share the same shape"}
    const tensor.NumericBlock g ← silu(gate)
    const tensor.NumericBlock h ← math.mul(g, up)
    return linear_carrier(h, down_weight, down_bias)
}
