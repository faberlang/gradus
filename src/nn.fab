# ---- silu oracle rows (the SiLU activation identity)

# The pinned workload: x over [8] with the f64 values of silu(x) =
# x·sigmoid(x) = x/(1+e^{-x}), externally evaluated, compared within the
# documented 5e-4 absolute tolerance (the f32 self-hosted sigmoid via the
# e^{-t} identity, mirroring the gelu/tanh self-hosting precedent).

test "silu pins the f64 identity values at signed inputs" {
    # silu(x) = x/(1+e^{-x}), f64 reference (external evaluation).
    let _ trap_result_9 ← trap {
        let tensor.NumericBlock y ← nn.silu_carrier(hold([-3.0, -1.0, -0.5, 0.0, 0.5, 1.0, 2.0, 3.0], [8]))
