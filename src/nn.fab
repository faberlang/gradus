        assert e2(y, 0, 0).approx(0.0 - 0.003637, GELU_TOLERATIO)
        assert e2(y, 0, 4).approx(2.996363, GELU_TOLERATIO)
        assert e2(y, 0, 7).approx(1.954598, GELU_TOLERATIO)
        assert e2(y, 1, 0).approx(3.99993, GELU_TOLERATIO)
        assert e2(y, 1, 1).approx(0.0 - 0.00007, GELU_TOLERATIO)
        assert e2(y, 1, 3).approx(2.484917, GELU_TOLERATIO)
        assert e2(y, 1, 6).approx(0.149675, GELU_TOLERATIO)
        assert e2(y, 1, 7).approx(0.0 - 0.100325, GELU_TOLERATIO)
    }
    match trap_result_14 {
