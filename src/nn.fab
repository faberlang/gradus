+++
locale = "en"
+++
# Differentiable NN primitives facade.
#
# Public import: importa ex "gradus:nn" privata nn
#
# S4-A (gpu-training-lowering stage-4-delivery.md): first concrete
# static-shape primitives — linear layer and GELU activation, bounded to the
# first two callers (linear regression 2×2, MLP 4×4). Shape generics are not
# available yet; follow the norma:optimizer concrete-overload precedent.
#
# S6-G1 (gpu-training-lowering stage-6-delivery.md): BERT-tiny shapes —
# linear_2x8 with per-channel [8] bias via the S6-C2 addita_bias contract,
# layernorm_2x8, and gelu_2x8.
#
# Architectural rule: primitives do not know the architectures built from
# them. This module must not import from gradus:attention or
# gradus:transformer. Each primitive must be independently differentiable.
# No module owns a backend or device handle.
#
# PML0-U3 ledger disposition (pml0-proof-api-ledger.md, gradus 33df687) —
# executed at PML1-U6: all six fixed-shape primitives are ADMITTED as
# caller-backed public API (grep-verified live callers in package code):
#   linear_2x2    row 1 — examples/training/linear-regression/src/train.fab:93
#   linear_4x4    row 2 — examples/training/mlp/src/train.fab:150,152
#   gelu_4x4      row 3 — examples/training/mlp/src/train.fab:151
#   linear_2x8    row 4 — bert-tiny-fragment train.fab:363-372;
#                         bert-gradus-probe train.fab:361-371
#   layernorm_2x8 row 5 — bert-tiny-fragment train.fab:362,369,374;
#                         bert-gradus-probe train.fab:360,367,372
#   gelu_2x8      row 6 — bert-tiny-fragment train.fab:371;
#                         bert-gradus-probe train.fab:369
#
# PML3-U1 (production-ml-library/pml3-delivery.md): the PRODUCTION surface —
# shape-generic forward-only primitives over the PML1 staged tensor carrier
# (gradus:tensor Tensor): linear, gelu, layernorm. They compose the PML1
# operation families (gradus:math matmul/add) and the staged carrier; they
# do NOT use the compiler's typed-tensor ops (tensor<f32, [...]>), so their
# shapes are runtime facts (R3: no one-row/one-shape narrowing in the public
# API). Every failure is a typed NnError with a textus causa.
#
# --- Autograd independence (PML3 thesis, forward-without-autograd) --------
# This module imports NO autograd surface: no gradus:gradient, no @ radix
# backward annotations, no companion ABI, no tape. The production surface is
# pure value functions over the staged carrier; a training path that needs
# gradients composes these primitives inside a gradient-module annotation
# (PML3-U4 proves the shared-layer composition). The co-located proba
# exercises the whole surface with no autograd import at all.
#
# --- Formulas (matching the accepted GPU-training proofs) -----------------
#   linear(x, w, b) = x·w + b — x [M,K], w [K,N]; b is [N] (per-channel,
#                      the linear_2x8 contract) or [M,N] (same-shape, the
#                      linear_2x2 / linear_4x4 contract).
#   gelu(x)         = 0.5·x·(1 + tanh(√(2/π)·(x + 0.044715·x³))) — the
#                      tanh-approximation identity of the compiler's GELU
#                      (radix-air reverse_ad_ops_test), self-hosted: tanh
#                      via the e^{2t} identity (potentia) so no scalar
#                      transcendental builtin is required.
#   layernorm(x,γ,β,ε) = (x − μ)/√(Var + ε)·γ + β over the LAST axis with
#                      per-feature γ/β [C] — the laminatio(1, ε, γ, β)
#                      contract of the accepted layernorm_2x8 row.
#   rmsnorm(x,γ,ε)    = x/√(mean(x²) + ε)·γ over the LAST axis, per-feature
#                      γ [C], no centering — the llama-arch norm family
#                      (llama.cpp LLM_NORM_RMS; ε explicit, llama default
#                      1e-5), REF-01-U1.1.
#
# --- Compiler-boundary notes ----------------------------------------------
#   * The staged carrier (runtime shape) exists precisely so shape-generic
#     library functions typecheck in library context (SEM014 holes do not
#     unify); this surface is the first consumer of that posture beyond math.
#   * GELU precision: the CPU reference (FMIR stepper) evaluates gelu in
#     f64; this surface is f32 self-hosted. Row tests compare with a
#     documented tolerance (approximata), not bit equality.
#   * const-with-cast module initializers are a recorded stepper residual
#     (execution); they typecheck under faber check.

import from "gradus:dtype" dtype

import from "gradus:math" math

import from "gradus:shape" shape

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# linear_2x2 — y = x·W + b (2×2 f32, linear-regression shape)
# -------------------------------------------------------------------------

fn linear_2x2(tensor<f32, [2, 2]> input, tensor<f32, [2, 2]> weight, tensor<f32, [2, 2]> bias) → tensor<f32, [2, 2]> {
    const tensor<f32, [2, 2]> prediction ← input.matmul(weight)
    return prediction.added(bias)
}

# -------------------------------------------------------------------------
# linear_4x4 — y = x·W + b (4×4 f32, MLP shape)
# -------------------------------------------------------------------------

fn linear_4x4(tensor<f32, [4, 4]> input, tensor<f32, [4, 4]> weight, tensor<f32, [4, 4]> bias) → tensor<f32, [4, 4]> {
    const tensor<f32, [4, 4]> prediction ← input.matmul(weight)
    return prediction.added(bias)
}

# -------------------------------------------------------------------------
# gelu_4x4 — GELU activation (4×4 f32, MLP hidden activation)
# -------------------------------------------------------------------------

fn gelu_4x4(tensor<f32, [4, 4]> x) → tensor<f32, [4, 4]> {
    return x.gelu()
}

# -------------------------------------------------------------------------
# linear_2x8 — y = x·W + b (2×8 f32, BERT-tiny shape)
#   weight [8,8], per-channel bias [8]. The bias add uses the S6-C2
#   addita_bias rank-extension contract (bias [8] against receiver [2,8]),
#   not the fragment's [2,8] same-shape workaround.
# -------------------------------------------------------------------------

fn linear_2x8(tensor<f32, [2, 8]> input, tensor<f32, [8, 8]> weight, tensor<f32, [8]> bias) → tensor<f32, [2, 8]> {
    const tensor<f32, [2, 8]> prediction ← input.matmul(weight)
    return prediction.added_bias(bias)
}

# -------------------------------------------------------------------------
# layernorm_2x8 — LayerNorm (2×8 f32, BERT-tiny shape)
#   per-channel scale/offset [8]; axis = 1, epsilon = 1e-5 — the fragment's
#   laminatio(1, 1.0e-5, scale, offset) contract.
# -------------------------------------------------------------------------

fn layernorm_2x8(tensor<f32, [2, 8]> x, tensor<f32, [8]> scale, tensor<f32, [8]> offset) → tensor<f32, [2, 8]> {
    return x.layer_norm(1, 0.00001, scale, offset)
}

# -------------------------------------------------------------------------
# gelu_2x8 — GELU activation (2×8 f32, BERT-tiny FFN hidden activation)
# -------------------------------------------------------------------------

fn gelu_2x8(tensor<f32, [2, 8]> x) → tensor<f32, [2, 8]> {
    return x.gelu()
}

# =========================================================================
# PML3-U1 — production surface (shape-generic, forward-only, typed errors)
# =========================================================================

# -------------------------------------------------------------------------
# NnError — typed error vocabulary of the NN primitive surface. Every
# variant carries a textus causa (render via causa), mirroring the tensor/
# shape/dtype/math error contract.
# -------------------------------------------------------------------------

union NnError {
    DimensioNegativa {
        string message
    },
    DimensioSupraLimitem {
        string message
    },
    ProductumSupraLimitem {
        string message
    },
    GradusMismatch {
        string message
    },
    FormaMismatch {
        string message
    },
    Incompatibilis {
        string message
    },
    TypoMismatch {
        string message
    },
    ElementaMismatch {
        string message
    },
    EpsilonInvalida {
        string message
    }
}

@ public { }
fn message(NnError e) → string {
    match e {
        case DimensioNegativa const message {
            return message
        }
        case DimensioSupraLimitem const message {
            return message
        }
        case ProductumSupraLimitem const message {
            return message
        }
        case GradusMismatch const message {
            return message
        }
        case FormaMismatch const message {
            return message
        }
        case Incompatibilis const message {
            return message
        }
        case TypoMismatch const message {
            return message
        }
        case ElementaMismatch const message {
            return message
        }
        case EpsilonInvalida const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# Private helpers.
# -------------------------------------------------------------------------

# GELU tanh-approximation constants (the compiler identity:
# √(2/π) and the cubic correction 0.044715).
const f32 GELU_ALPHA ← 0.7978845608028654 ∷ f32

const f32 GELU_BETA ← 0.044715 ∷ f32

# LayerNorm default epsilon — the accepted rows' laminatio(1, 1e-5, …).
const f32 LAYERNORM_EPSILON_DEFAULT ← 0.00001 ∷ f32

# Bounded element count with the module's typed error mapping (FormaError →
# NnError, variant identity preserved via the documented causa text — same
# pattern as math.fab).
@ private { }
fn _numel_valid(list<int> f) → int ⇥ NnError {
    do {
        return shape.numel(f)
    }
    catch err {
        const string c ← shape.message(err)
        if c ≡ "negative dimension" {
            throw variant DimensioNegativa {message = c}
        }
        if c ≡ "dimension above ceiling" {
            throw variant DimensioSupraLimitem {message = c}
        }
        if c ≡ "element count above ceiling" {
            throw variant ProductumSupraLimitem {message = c}
        }
        throw variant FormaMismatch {message = c}
    }
}

# F32-only gate — the admitted rows are the F32 row; a differently tagged
# staged carrier fails closed (dtype mismatch is explicit, never implicit).
@ private { }
fn _dtype_f32(tensor.Tensor t) → bool ⇥ NnError {
    if dtype.name(t.dtype()) ≠ "f32" {
        throw variant TypoMismatch {message = "unsupported dtype for nn primitive"}
    }
    return true
}

# Three-way dtype parity + F32 gate for primitives with affine/weight peers.
@ private { }
fn _dtype_triplet(tensor.Tensor a, tensor.Tensor b, tensor.Tensor c) → bool ⇥ NnError {
    const string ta ← dtype.name(a.dtype())
    const string tb ← dtype.name(b.dtype())
    const string tc ← dtype.name(c.dtype())
    if ta ≠ tb or tb ≠ tc {
        throw variant TypoMismatch {message = "dtype mismatch"}
    }
    if ta ≠ "f32" {
        throw variant TypoMismatch {message = "unsupported dtype for nn primitive"}
    }
    return true
}

# Two-way dtype parity + F32 gate (scale-only peers, e.g. rmsnorm).
@ private { }
fn _dtype_pair(tensor.Tensor a, tensor.Tensor b) → bool ⇥ NnError {
    const string ta ← dtype.name(a.dtype())
    const string tb ← dtype.name(b.dtype())
    if ta ≠ tb {
        throw variant TypoMismatch {message = "dtype mismatch"}
    }
    if ta ≠ "f32" {
        throw variant TypoMismatch {message = "unsupported dtype for nn primitive"}
    }
    return true
}

# e^x via the exponentiation intrinsic (base e > 0, so the non-positive
# base guard never fires; potentia lowers to exp(x·ln(e)) ≈ exp(x)).
@ private { }
fn _exp(f32 x) → f32 {
    return (2.718281828459045 ∷ f32).power(x)
}

# tanh via the e^{2t} identity, split by sign so e^{2|t|} never overflows to
# NaN: tanh(t) → 1 for t → +∞ and −1 for t → −∞ (2/(Inf+1) − 1 = −1.0).
@ private { }
fn _tanh(f32 t) → f32 {
    if t ≥ 0.0 {
        const f32 e ← _exp(2.0 * t)
        return 1.0 - 2.0 / (e + 1.0)
    }
    const f32 e ← _exp(-2.0 * t)
    return 2.0 / (e + 1.0) - 1.0
}

# sqrt via Newton iteration (var + ε ≥ 0 always; the non-positive guard
# covers the ε = 0 / constant-row corner). Quadratic convergence makes a
# dozen iterations exact to f32 precision from the x/2 seed.
@ private { }
fn _sqrt(f32 x) → f32 {
    if x ≤ 0.0 then return 0.0
    var f32 guess ← x / 2.0
    var int i ← 0
    while i ≺ 12 {
        guess ← (guess + x / guess) / 2.0
        i ← i + 1
    }
    return guess
}

# GELU scalar — the tanh approximation identity of the compiler's GELU.
@ private { }
fn _scalar_gelu(f32 v) → f32 {
    const f32 t ← GELU_ALPHA * (v + ((GELU_BETA * v) * v) * v)
    return (0.5 * v) * (1.0 + _tanh(t))
}

# sigmoid via the e^{-t} identity, split by sign so the exponent never
# overflows (1/(1+e^{-t}) for t ≥ 0; e^{t}/(1+e^{t}) for t < 0 — both
# bounded, mirroring the _tanh sign split).
@ private { }
fn _sigmoid(f32 t) → f32 {
    if t ≥ 0.0 {
        const f32 e ← _exp(0.0 - t)
        return 1.0 / (e + 1.0)
    }
    const f32 e ← _exp(t)
    return e / (e + 1.0)
}

# SiLU scalar — the SiLU identity: silu(v) = v·sigmoid(v).
@ private { }
fn _scalar_silu(f32 v) → f32 {
    return v * _sigmoid(v)
}

# Elementwise product of two equal-shape staged carriers (the gated
# intermediate: silu(gate) ⊙ up), with the module's typed error mapping
# (MathError → NnError, variant identity preserved via the documented
# causa text — same pattern as linear's cape block).
@ private { }
fn _mul_elements(tensor.Tensor a, tensor.Tensor b) → tensor.Tensor ⇥ NnError {
    do {
        return math.mul(a, b)
    }
    catch err {
        const string c ← math.message(err)
        if c ≡ "dtype mismatch" {
            throw variant TypoMismatch {message = c}
        }
        if c ≡ "element count above ceiling" {
            throw variant ProductumSupraLimitem {message = c}
        }
        if c ≡ "dimension above ceiling" {
            throw variant DimensioSupraLimitem {message = c}
        }
        if c ≡ "negative dimension" {
            throw variant DimensioNegativa {message = c}
        }
        if c ≡ "shapes not broadcastable" {
            throw variant FormaMismatch {message = c}
        }
        throw variant FormaMismatch {message = c}
    }
}

# -------------------------------------------------------------------------
# Family: linear — y = x·w + b over the staged carrier.
#   x [M,K], w [K,N]; b [N] (per-channel) or [M,N] (same-shape) — the two
#   admitted bias contracts. Rank, inner-dimension, dtype, and bias shape
#   are validated fail-closed before any math runs; math failures are mapped
#   into NnError preserving the causa text.
# -------------------------------------------------------------------------

@ public { }
fn linear(tensor.Tensor x, tensor.Tensor w, tensor.Tensor b) → tensor.Tensor ⇥ NnError {
    const list<int> fx ← x.shape()
    const list<int> fw ← w.shape()
    if fx.length() ≠ 2 {
        throw variant GradusMismatch {message = "linear requires rank-2 input"}
    }
    if fw.length() ≠ 2 {
        throw variant GradusMismatch {message = "linear requires rank-2 weight"}
    }
    const int m ← fx.get(0) coalesce 1
    const int k ← fx.get(1) coalesce 1
    const int n ← fw.get(1) coalesce 1
    if k ≠ fw.get(0) coalesce 1 {
        throw variant Incompatibilis {message = "inner dimensions mismatch"}
    }
    _dtype_triplet(x, w, b)
    const list<int> fb ← b.shape()
    if fb.length() ≡ 1 {
        if fb.get(0) coalesce 1 ≠ n {
            throw variant FormaMismatch {message = "bias does not match output width"}
        }
    }
    else {
        if fb.length() ≡ 2 {
            if fb.get(0) coalesce 1 ≠ m or fb.get(1) coalesce 1 ≠ n {
                throw variant FormaMismatch {message = "bias does not match output shape"}
            }
        }
        else {
            throw variant FormaMismatch {message = "bias must be per-channel or output-shaped"}
        }
    }
    do {
        const tensor.Tensor prediction ← math.matmul(x, w)
        return math.add(prediction, b)
    }
    catch err {
        const string c ← math.message(err)
        if c ≡ "matmul requires rank-2 operands" {
            throw variant GradusMismatch {message = c}
        }
        if c ≡ "inner dimensions mismatch" {
            throw variant Incompatibilis {message = c}
        }
        if c ≡ "dtype mismatch" {
            throw variant TypoMismatch {message = c}
        }
        if c ≡ "element count above ceiling" {
            throw variant ProductumSupraLimitem {message = c}
        }
        if c ≡ "dimension above ceiling" {
            throw variant DimensioSupraLimitem {message = c}
        }
        if c ≡ "negative dimension" {
            throw variant DimensioNegativa {message = c}
        }
        if c ≡ "shapes not broadcastable" {
            throw variant FormaMismatch {message = c}
        }
        throw variant FormaMismatch {message = c}
    }
}

# -------------------------------------------------------------------------
# Family: gelu — GELU activation, elementwise over the staged carrier.
# Shape and dtype are preserved; the F32 row is the admitted row (any other
# tag fails closed).
# -------------------------------------------------------------------------

@ public { }
fn gelu(tensor.Tensor x) → tensor.Tensor ⇥ NnError {
    _dtype_f32(x)
    const list<int> f ← x.shape()
    const int total ← _numel_valid(f)
    var list<f32> out ← vacua
    for range 0‥total const i {
        const f32 v ← x.data.get(i) coalesce 0.0 ∷ f32
        out.append(_scalar_gelu(v))
    }
    return tensor.Tensor {dtype = x.dtype(), shape = f, data = out}
}

# -------------------------------------------------------------------------
# Family: layernorm — LayerNorm over the LAST axis of the staged carrier,
# with per-feature scale/offset [C]. Matches the accepted
# laminatio(1, ε, γ, β) contract (the layernorm_2x8 row); rank >= 1, scale
# and offset must be rank-1 of width C, epsilon must be non-negative.
# -------------------------------------------------------------------------

@ public { }
fn layernorm(tensor.Tensor x, tensor.Tensor scale, tensor.Tensor offset, f32 epsilon) → tensor.Tensor ⇥ NnError {
    _dtype_triplet(x, scale, offset)
    if epsilon ≺ 0.0 {
        throw variant EpsilonInvalida {message = "negative epsilon"}
    }
    const list<int> f ← x.shape()
    const int r ← f.length()
    if r ≡ 0 {
        throw variant GradusMismatch {message = "layernorm requires rank >= 1"}
    }
    const int c ← f.get(r - 1) coalesce 1
    const list<int> fs ← scale.shape()
    const list<int> fo ← offset.shape()
    if fs.length() ≠ 1 {
        throw variant FormaMismatch {message = "layernorm scale must be per-channel"}
    }
    if fo.length() ≠ 1 {
        throw variant FormaMismatch {message = "layernorm offset must be per-channel"}
    }
    if fs.get(0) coalesce 1 ≠ c {
        throw variant FormaMismatch {message = "layernorm scale width mismatch"}
    }
    if fo.get(0) coalesce 1 ≠ c {
        throw variant FormaMismatch {message = "layernorm offset width mismatch"}
    }
    if c ≡ 0 {
        throw variant ElementaMismatch {message = "empty normalization axis"}
    }
    const int total ← _numel_valid(f)
    const int rows ← total / c
    var list<f32> out ← vacua
    var int row ← 0
    while row ≺ rows {
        # Row mean over the feature axis.
        var f32 sum ← 0.0 ∷ f32
        var int col ← 0
        while col ≺ c {
            const f32 v ← x.data.get(row * c + col) coalesce 0.0 ∷ f32
            sum ← sum + v
            col ← col + 1
        }
        const f32 mean ← sum / (c ↦ f32)
        # Row variance (population, over the feature axis).
        var f32 sq ← 0.0 ∷ f32
        var int col2 ← 0
        while col2 ≺ c {
            const f32 v ← x.data.get(row * c + col2) coalesce 0.0 ∷ f32
            const f32 d ← v - mean
            sq ← sq + d * d
            col2 ← col2 + 1
        }
        const f32 var ← sq / (c ↦ f32)
        const f32 std ← _sqrt(var + epsilon)
        # Normalize + per-feature affine.
        var int col3 ← 0
        while col3 ≺ c {
            const f32 v ← x.data.get(row * c + col3) coalesce 0.0 ∷ f32
            const f32 s ← scale.data.get(col3) coalesce 0.0 ∷ f32
            const f32 o ← offset.data.get(col3) coalesce 0.0 ∷ f32
            out.append(((v - mean) / std) * s + o)
            col3 ← col3 + 1
        }
        row ← row + 1
    }
    return tensor.Tensor {dtype = x.dtype(), shape = f, data = out}
}

# -------------------------------------------------------------------------
# Family: rmsnorm — RMSNorm over the LAST axis of the staged carrier, with
# per-feature scale [C], no centering — the llama-arch norm family
# (llama.cpp LLM_NORM_RMS): y = x / sqrt(mean(x²) + ε) · γ. Rank >= 1, scale
# must be rank-1 of width C, epsilon must be non-negative (llama-arch
# default 1e-5; the qwen2 row uses the same family with a smaller ε — the
# epsilon parameter is explicit, matching the layernorm posture).
# -------------------------------------------------------------------------

@ public { }
fn rmsnorm(tensor.Tensor x, tensor.Tensor scale, f32 epsilon) → tensor.Tensor ⇥ NnError {
    _dtype_pair(x, scale)
    if epsilon ≺ 0.0 {
        throw variant EpsilonInvalida {message = "negative epsilon"}
    }
    const list<int> f ← x.shape()
    const int r ← f.length()
    if r ≡ 0 {
        throw variant GradusMismatch {message = "rmsnorm requires rank >= 1"}
    }
    const int c ← f.get(r - 1) coalesce 1
    const list<int> fs ← scale.shape()
    if fs.length() ≠ 1 {
        throw variant FormaMismatch {message = "rmsnorm scale must be per-channel"}
    }
    if fs.get(0) coalesce 1 ≠ c {
        throw variant FormaMismatch {message = "rmsnorm scale width mismatch"}
    }
    if c ≡ 0 {
        throw variant ElementaMismatch {message = "empty normalization axis"}
    }
    const int total ← _numel_valid(f)
    const int rows ← total / c
    var list<f32> out ← vacua
    var int row ← 0
    while row ≺ rows {
        # Row mean square over the feature axis (no centering).
        var f32 sq ← 0.0 ∷ f32
        var int col ← 0
        while col ≺ c {
            const f32 v ← x.data.get(row * c + col) coalesce 0.0 ∷ f32
            sq ← sq + v * v
            col ← col + 1
        }
        const f32 mean_sq ← sq / (c ↦ f32)
        const f32 inv ← 1.0 / _sqrt(mean_sq + epsilon)
        # Normalize + per-feature scale (no offset, no centering).
        var int col2 ← 0
        while col2 ≺ c {
            const f32 v ← x.data.get(row * c + col2) coalesce 0.0 ∷ f32
            const f32 s ← scale.data.get(col2) coalesce 0.0 ∷ f32
            out.append((v * inv) * s)
            col2 ← col2 + 1
        }
        row ← row + 1
    }
    return tensor.Tensor {dtype = x.dtype(), shape = f, data = out}
}

# -------------------------------------------------------------------------
# Family: silu — SiLU activation, elementwise over the staged carrier.
#   silu(x) = x·sigmoid(x); shape and dtype are preserved; the F32 row is
#   the admitted row (any other tag fails closed).
# -------------------------------------------------------------------------

@ public { }
fn silu(tensor.Tensor x) → tensor.Tensor ⇥ NnError {
    _dtype_f32(x)
    const list<int> f ← x.shape()
    const int total ← _numel_valid(f)
    var list<f32> out ← vacua
    for range 0‥total const i {
        const f32 v ← x.data.get(i) coalesce 0.0 ∷ f32
        out.append(_scalar_silu(v))
    }
    return tensor.Tensor {dtype = x.dtype(), shape = f, data = out}
}

# -------------------------------------------------------------------------
# Family: swiglu — the SwiGLU gated-MLP row over the staged carrier:
#   h = silu(gate) ⊙ up; y = linear(h, down_weight, down_bias).
#   gate [M,F] and up [M,F] must share the same rank-2 shape; down_weight
#   is [F,N]; down_bias is [N] (per-channel) or [M,N] (same-shape) — the
#   linear bias contracts. No fixed-shape constants; the F32 row is the
#   admitted row.
# -------------------------------------------------------------------------

@ public { }
fn swiglu(tensor.Tensor gate, tensor.Tensor up, tensor.Tensor down_weight, tensor.Tensor down_bias) → tensor.Tensor ⇥ NnError {
    _dtype_f32(gate)
    _dtype_f32(up)
    const list<int> fg ← gate.shape()
    const list<int> fu ← up.shape()
    if fg.length() ≠ 2 {
        throw variant GradusMismatch {message = "swiglu requires rank-2 gate and up"}
    }
    if fu.length() ≠ 2 {
        throw variant GradusMismatch {message = "swiglu requires rank-2 gate and up"}
    }
    if not (fg ≡ fu) {
        throw variant FormaMismatch {message = "gate and up must share the same shape"}
    }
    const tensor.Tensor g ← silu(gate)
    const tensor.Tensor h ← _mul_elements(g, up)
    return linear(h, down_weight, down_bias)
}
