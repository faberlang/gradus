        assert e1(y, 2).approx(0.0 - 0.188770334399, GELU_TOLERATIO)
        assert e1(y, 3) ≡ 0.0 ∷ f32
        assert e1(y, 4).approx(0.311229665601, GELU_TOLERATIO)
        assert e1(y, 5).approx(0.73105857863, GELU_TOLERATIO)
        assert e1(y, 6).approx(1.761594155956, GELU_TOLERATIO)
        assert e1(y, 7).approx(2.857722380467, GELU_TOLERATIO)
    }
    match trap_result_9 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

