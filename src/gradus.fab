+++
locale = "en"
+++
# gradus.fab — package map facade for the autograd and ML library.
#
# Public import: importa ex "gradus:gradus" privata gradus
#
# Prefer leaf modules (Norma / Triga style — one concern per import path):
#
#   ── Layer 1: Tensor foundation ──
#   gradus:dtype          versioned dtype tag + cast/round/serialize rules (U2)
#   gradus:shape          shape rules (broadcast/reshape/expand; bounded product) (U3)
#   gradus:math           tensor-aware math (own copy; independent of Norma)
#   gradus:tensor         tensor construction, shape/dtype, basic ops (not autograd-aware)
#
#   ── Layer 2: Autograd core ──
#   gradus:gradient      @ radix backward wrapper; forward + companion gradient calls
#
#   ── Layer 3: Loss ──
#   gradus:loss          loss functions (MSE, cross-entropy)
#
#   ── Layer 4: Optimization ──
#   gradus:optimize      optimizers (SGD, Adam) and learning-rate schedules
#
#   ── Layer 5: NN primitives ──
#   gradus:nn            differentiable primitives: Linear, activation, norm, embedding, dropout
#
#   ── Layer 6: Architecture blocks ──
#   gradus:attention     scaled dot-product attention, causal mask, multi-head
#   gradus:transformer   transformer block, positional encoding, output head
#
#   ── Layer 7: Training and data ──
#   gradus:train         training loop, metrics, checkpointing
#   gradus:data          batching, shuffling, tokenization
#
#   ── Shared value contracts (PML1) ──
#   gradus:parameter     parameter identity and traversal (U5)
#   gradus:serialize     versioned bytes serialization contract (U7)
#
# S6-G1 (gpu-training-lowering stage-6-delivery.md): the BERT-tiny surface is
# shipped — gradus:attention.scaled_dot_product_2x8, gradus:transformer
# bert_tiny_block_2x8, gradus:nn linear_2x8 / layernorm_2x8 / gelu_2x8,
# gradus:loss.mse_2x8, and gradus:train.train_step_bert (18-trainable
# BERT-tiny set). All static shapes (B=2, D=8, H=1); biases are per-channel
# [8] via the S6-C2 addita_bias contract. (PML1-U6: the standalone
# gradus:transformer attention_block_2x8 / ffn_block_2x8 were retired per
# pml0-proof-api-ledger.md rows 13-14; bert_tiny_block_2x8 inlines their
# math.)

# =========================================================================
# PML3-U4 — forward with and without autograd (shared-layer phase thesis)
# =========================================================================
#
# --- Contract (pml3-delivery.md PML3-U4) ---------------------------------
# One forward model composition runs identically (a) bare (inference path)
# and (b) through the existing compiler-generated backward companion
# (training path); no forward path builds a gradient tape; the shared-layer
# definition from pml0-module-dag.md §4 is implemented and tested.
#
# --- The shared layer (both paths consume the same forward semantics) -----
#   forward_mlp(x, w1, b1, w2, b2)   = linear(gelu(linear(x, w1, b1)), w2, b2)
#       over the staged carrier (gradus:tensor Tensor). The inference path
#       calls THIS bare — no gradient path, no tape, no autograd import.
#   forward_mlp_loss(input, w1, b1, w2, b2, target) = mean((mlp(input) −
#       target)²) — the SAME layer composition (linear → GELU → linear) over
#       the compiler typed-tensor surface, annotated @ radix backward. The
#       compiler generates the backward companion (forward_mlp_loss_backward)
#       FROM this forward source — the training path. The arithmetic is the
#       accepted MLP exemplum (examples/training/mlp, 4×4, per-step oracle
#       parity): no forward path ever requests gradient construction.
#
# --- Evidence honesty (CTO Q2, hard) --------------------------------------
# This surface is the STRUCTURAL proof: gradus.fab imports NO autograd module
# (no gradus:gradient, no tape); the forward path (forward_mlp) is a pure
# value function; gradient construction is requested only by the ONE
# training-path annotation. It does NOT prove runtime identity of bare
# forward vs the generated companion, companion behavior, or the numerical
# bound — execution is env-blocked tree-wide today (FMIR stepper /
# library-import gap — recorded residual). The identity claim is DEFERRED to
# a runtime-evidence gate (auditor-owned faber test path); U4 is PARTIAL.

import from "gradus:dtype" dtype

import from "gradus:nn" nn

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# GradusError — typed error vocabulary of the facade's shared forward.
# Every variant carries a textus causa (render via causa), mirroring the
# nn/tensor/shape error contract; nn error texts are preserved verbatim.
# -------------------------------------------------------------------------

union GradusError {
    DimensioNegativa {
        string causa
    },
    DimensioSupraLimitem {
        string causa
    },
    ProductumSupraLimitem {
        string causa
    },
    GradusMismatch {
        string causa
    },
    FormaMismatch {
        string causa
    },
    Incompatibilis {
        string causa
    },
    TypoMismatch {
        string causa
    },
    ElementaMismatch {
        string causa
    }
}

fn causa(GradusError e) → string {
    match e {
        case DimensioNegativa const causa {
            return causa
        }
        case DimensioSupraLimitem const causa {
            return causa
        }
        case ProductumSupraLimitem const causa {
            return causa
        }
        case GradusMismatch const causa {
            return causa
        }
        case FormaMismatch const causa {
            return causa
        }
        case Incompatibilis const causa {
            return causa
        }
        case TypoMismatch const causa {
            return causa
        }
        case ElementaMismatch const causa {
            return causa
        }
    }
}

# Map a documented nn error causa text to the matching GradusError variant
# (variant identity per the nn vocabulary; the text is preserved verbatim —
# the transformer.fab _mappa pattern).
@ private { }
fn _mappa(string c) → GradusError {
    if c ≡ "negative dimension" then return variant DimensioNegativa {causa = c}
    if c ≡ "dimension above ceiling" then return variant DimensioSupraLimitem {causa = c}
    if c ≡ "element count above ceiling" then return variant ProductumSupraLimitem {causa = c}
    if c ≡ "linear requires rank-2 input" or c ≡ "linear requires rank-2 weight" then return variant GradusMismatch {causa = c}
    if c ≡ "inner dimensions mismatch" then return variant Incompatibilis {causa = c}
    if c ≡ "dtype mismatch" or c ≡ "unsupported dtype for nn primitive" then return variant TypoMismatch {causa = c}
    return variant FormaMismatch {causa = c}
}

# nn.linear wrapper — gradus:nn → GradusError (causa text preserved).
@ private { }
fn _linear(tensor.Tensor x, tensor.Tensor w, tensor.Tensor b) → tensor.Tensor ⇥ GradusError {
    do {
        return nn.linear(x, w, b)
    }
    catch err {
        throw _mappa(nn.causa(err))
    }
}

# nn.gelu wrapper — gradus:nn → GradusError (causa text preserved).
@ private { }
fn _gelu(tensor.Tensor x) → tensor.Tensor ⇥ GradusError {
    do {
        return nn.gelu(x)
    }
    catch err {
        throw _mappa(nn.causa(err))
    }
}

# -------------------------------------------------------------------------
# forward_mlp — the SHARED forward model composition (inference path, bare).
#
#   x  [M,K] input;  w1 [K,H], b1 ([H] per-channel or [M,H] same-shape);
#   w2 [H,N], b2 ([N] per-channel or [M,N] same-shape).
#
#   y = linear(gelu(linear(x, w1, b1)), w2, b2)
#
# Pure value function over the staged carrier — NO autograd import, NO
# @ radix backward annotation, NO tape. Shape-generic at runtime (R3);
# the F32 row is the admitted row (nn fail-closed on any other tag).
# -------------------------------------------------------------------------

@ public { }
fn forward_mlp(tensor.Tensor x, tensor.Tensor w1, tensor.Tensor b1, tensor.Tensor w2, tensor.Tensor b2) → tensor.Tensor ⇥ GradusError {
    const tensor.Tensor h1 ← _linear(x, w1, b1)
    const tensor.Tensor a1 ← _gelu(h1)
    return _linear(a1, w2, b2)
}

# -------------------------------------------------------------------------
# nil() — vacuum residual for the companion backward ABI (the gradient.fab
# nil precedent; required by the compiler-generated backward function to
# indicate no intermediate saves from the forward pass).
# -------------------------------------------------------------------------

@ public { }
fn nil() → void {
    pass
}

# -------------------------------------------------------------------------
# forward_mlp_loss — the TRAINING-path composition (the same shared forward
# over the compiler typed-tensor surface + MSE to a scalar). The compiler
# generates forward_mlp_loss_backward FROM this forward source; consumers
# call the companion through the importa boundary (SEM004):
#
#   forward_mlp_loss_backward(input, w1, b1, w2, b2, target, nil(), upstream)
#     → iuncta(grad_input, grad_w1, grad_b1, grad_w2, grad_b2, grad_target)
#
# Arithmetic == the accepted MLP exemplum (examples/training/mlp 4×4,
# per-step oracle parity): linear → GELU → linear → MSE.
# -------------------------------------------------------------------------

@ radix { lane = "air" }
@ radix backward "forward_mlp_loss_backward"
@ public { }
fn forward_mlp_loss(tensor<f32, [4, 4]> input, tensor<f32, [4, 4]> weight1, tensor<f32, [4, 4]> bias1, tensor<f32, [4, 4]> weight2, tensor<f32, [4, 4]> bias2, tensor<f32, [4, 4]> target) → f32 {
    const tensor<f32, [4, 4]> h1 ← input.matmul(weight1)
    const tensor<f32, [4, 4]> h1b ← h1.added(bias1)
    const tensor<f32, [4, 4]> a1 ← h1b.gelu()
    const tensor<f32, [4, 4]> h2 ← a1.matmul(weight2)
    const tensor<f32, [4, 4]> h2b ← h2.added(bias2)
    const tensor<f32, [4, 4]> resd ← h2b.subtract(target)
    const tensor<f32, [4, 4]> sqrd ← resd.multiply(resd)
    return sqrd.mean()
}
#
# PML3-U4 (production-ml-library/pml3-delivery.md) — the phase-thesis surface
# lives in this facade: one forward model composition (linear → GELU → linear)
# that runs BARE (inference path — forward_mlp over the staged carrier, NO
# autograd surface) and THROUGH the compiler-generated backward companion
# (training path — forward_mlp_loss, @ radix backward, the accepted MLP
# arithmetic). This is the shared-layer proof of pml0-module-dag.md §4: the
# nn/attention/transformer modules stay autograd-free; training requests
# gradient construction ONLY inside the annotated facade function, never in
# the forward path. The gradient-module wrapper rule still holds — the
# primitives and architecture blocks leak no @ radix annotations; the facade
# carries the ONE training-path composition (U4's explicit write scope).
#
# This file held no genera before PML3-U4. Import the leaf modules above;
# the phase-thesis surface below is the facade's only code.
