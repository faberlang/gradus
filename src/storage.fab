+++
locale = "en"
+++
# Open-world encoded numeric storage.
#
# `dtype.DType` describes the closed set of values that the compute carrier
# can operate on. It is deliberately not used here. Model files and future
# numeric formats need to retain an identity even when Gradus has no decoder
# for that representation yet.
#
# An encoded storage value therefore keeps its opaque bytes and a separate
# representation identity. Block geometry is metadata, not a union arm: a
# producer can preserve a new quantizer or compression scheme without adding
# a variant to a shared type.

const int MAX_NUMBER ← 9223372036854775807

@ public
class Representation {
    # Open format namespace, for example "ggml" or a vendor namespace.
    string namespace
    # Human-readable format name. Unknown wire codes use "unknown" while the
    # raw code below retains the source identity.
    string name
    # Format or dialect revision. GGML type codes have no mandatory revision
    # in this seam, so the convenience mapper uses "unspecified".
    string version
    # Optional source-format code. A negative value means that the identity
    # has no numeric source code.
    int code
}

@ public
class BlockMetadata {
    # False means that the format was preserved but its block geometry is not
    # known to this library. The other fields then remain descriptive zeros.
    bool known
    int elements_per_block
    int bytes_per_block
    int block_count
    int byte_length
}

@ public
class EncodedStorage {
    # Opaque encoded bytes. No conversion to list<f32> occurs at this seam.
    bytes payload
    Representation representation
    BlockMetadata block
}

# Build an arbitrary representation identity. This is the extension seam for
# formats that Gradus does not know yet.
@ public
fn representation(string namespace, string name, string version, int code) → Representation {
    return Representation {namespace = namespace, name = name, version = version, code = code}
}

# Build the open identity for a GGML/GGUF storage code. Known names are a
# convenience only; the raw code remains present for known and unknown rows.
@ public
fn ggml_representation(int code) → Representation {
    var string name ← "unknown"
    switch code {
        case 0 { name ← "f32" }
        case 1 { name ← "f16" }
        case 2 { name ← "q4_0" }
        case 3 { name ← "q4_1" }
        case 6 { name ← "q5_0" }
        case 7 { name ← "q5_1" }
        case 8 { name ← "q8_0" }
        case 9 { name ← "q8_1" }
        case 10 { name ← "q2_k" }
        case 11 { name ← "q3_k" }
        case 12 { name ← "q4_k" }
        case 13 { name ← "q5_k" }
        case 14 { name ← "q6_k" }
        case 15 { name ← "q8_k" }
        case 20 { name ← "iq4_nl" }
        case 24 { name ← "i8" }
        case 25 { name ← "i16" }
        case 26 { name ← "i32" }
        case 27 { name ← "i64" }
        case 28 { name ← "f64" }
        case 30 { name ← "bf16" }
        default { }
    }
    return Representation {namespace = "ggml", name = name, version = "unspecified", code = code}
}

@ public
fn identity(Representation value) → string {
    return "§/§/§/§"(value.namespace, value.version, value.name, value.code ↦ string)
}

@ public
fn known_block(int elements_per_block, int bytes_per_block, int block_count, int byte_length) → BlockMetadata {
    return BlockMetadata {known = true, elements_per_block = elements_per_block, bytes_per_block = bytes_per_block, block_count = block_count, byte_length = byte_length}
}

@ public
fn unknown_block(int byte_length) → BlockMetadata {
    return BlockMetadata {known = false, elements_per_block = 0, bytes_per_block = 0, block_count = 0, byte_length = byte_length}
}

@ public
fn encoded(bytes payload, Representation representation, BlockMetadata block) → EncodedStorage {
    return EncodedStorage {payload = payload, representation = representation, block = block}
}

# The payload may be deferred or windowed at a view boundary. `complete` is
# consequently explicit; retaining a short prefix is still lossless for the
# bytes actually supplied and does not silently claim a decoded value.
@ public
fn complete(EncodedStorage value) → bool {
    const bytes payload ← value.payload
    const BlockMetadata block ← value.block
    return payload.length() ≡ block.byte_length
}

@ public
fn block_valid(BlockMetadata value) → bool {
    if not value.known then return value.elements_per_block ≡ 0 and value.bytes_per_block ≡ 0 and value.block_count ≡ 0 and value.byte_length ≥ 0
    if value.elements_per_block ≤ 0 or value.bytes_per_block ≤ 0 or value.block_count ≺ 0 or value.byte_length ≺ 0 then return false
    if value.block_count ≡ 0 then return value.byte_length ≡ 0
    if value.byte_length ≡ 0 then return false
    const int block_count ← value.block_count
    const int bytes_per_block ← value.bytes_per_block
    const int byte_length ← value.byte_length
    if block_count ≻ MAX_NUMBER / bytes_per_block then return false
    return block_count * bytes_per_block ≡ byte_length
}
