+++ toml
locale = "en"

+++ faber
# Checkpoint envelope: epoch, step, RNG state, and optimizer-state wire.
#
# Public import: import from "gradus:checkpoint" checkpoint
# The optimizer-state wire is carried verbatim and validated by its owner
# when resumed. Checkpoint state has its own schema and typed error type.
#
import from "gradus:random"

@ public
union CheckpointError {
    @ shared
    string message

    InvalidSeed,
    InvalidPosition,
    EmptyState,
    UnknownVersion,
    BadWire
}

@ conversion
fn from_random_error(random.RandomError err) → CheckpointError {
    match err {
        case random.RandomError.InvalidSeed let message {
            return variant InvalidSeed { message = message }
        }
        case random.RandomError.BadWire let message {
            return variant BadWire { message = message }
        }
        case random.RandomError.UnknownVersion let message {
            return variant UnknownVersion { message = message }
        }
        case random.RandomError.InvalidInitializerShape let message {
            # Checkpoint loading never runs the initializer; the arm keeps the
            # match total, and the message says what actually went wrong.
            return variant BadWire { message = message }
        }
        case random.RandomError.TensorFailure let message, ? {
            # Likewise unreachable from checkpoint loading; kept total.
            return variant BadWire { message = message }
        }
    }
}

const string schema_version = "1.0.0"

# -------------------------------------------------------------------------
# Checkpoint — the checkpoint: epoch + step + RNG state + the optimizer-state
# wire (U3, carried verbatim). The envelope is autograd-free; the state
# wire validates against ITS OWN schema at resume (optimize.deserialize).
# -------------------------------------------------------------------------


@ public
class Checkpoint {
    # Epoch.
    mut int age
    # Step within the epoch.
    mut int step
    mut random.Seed rng
    # Embedded optimizer-state wire, carried verbatim.
    mut string state_wire
}

# Build a checkpoint. Epoch/step are non-negative; the state wire is
# non-empty (fail closed). The RNG is already a validated Seed.
@ public
fn construct_checkpoint(int age, int step, random.Seed rng, string state_wire) → Checkpoint ⇥ CheckpointError {
    require age ≥ 0 throw variant InvalidPosition { message = "epoch must be non-negative" }

    require step ≥ 0 throw variant InvalidPosition { message = "step must be non-negative" }

    require state_wire.length() ≢ 0 throw variant EmptyState { message = "checkpoint state wire is empty" }

    return Checkpoint { age = age, step = step, rng = rng, state_wire = state_wire }
}

# Placeholder Default for `var Checkpoint` bindings (varia on structs).
# Empty wire and an empty seed (not a valid checkpoint). Only a
# placeholder the caller overwrites, or returns from an unreachable cape arm.
@ public
fn default_checkpoint() → Checkpoint {
    return Checkpoint { age = 0, step = 0, rng = random.default(), state_wire = "" }
}

# Field-wise checkpoint equality — the round-trip predicate.
@ public
fn checkpoint_equal(Checkpoint a, Checkpoint b) → bool {
    if a.age ≢ b.age then return false

    if a.step ≢ b.step then return false

    if a.rng.status ≢ b.rng.status then return false

    if a.state_wire ≢ b.state_wire then return false

    return true
}

# -------------------------------------------------------------------------
# Checkpoint wire — versioned, exact round-trip. The fixed prefix carries
# marker/schema/epoch/step/rng-state; the embedded optimizer-state wire is
# the '/' tail (joined verbatim from the trailing segments).
# -------------------------------------------------------------------------

@ public
fn serialize_checkpoint(Checkpoint c) → string {
    return "train/checkpoint/§/§/§/§/§"(schema_version, c.age ↦ string, c.step ↦ string, c.rng.status ↦ string, c.state_wire)
}

# All-digits predicate for wire integer fields (epoch, step).
fn digit(string c) → bool {
    let string text ↤ c
    return "0123456789".contains(text)
}

fn numeric(string s) → bool {
    if s.length() ≡ 0 then return false

    if s.length() ≻ 18 then return false

    for from s let c {
        if not digit(c ↦ string) then return false
    }

    return true
}

@ public
fn deserialize_checkpoint(string wire) → Checkpoint ⇥ CheckpointError {
    # Scan only the fixed six-field header prefix: the offsets of the first
    # six '/' separators delimit marker/schema/epoch/step/rng-state, and the
    # embedded optimizer-state wire is the single tail slice after the sixth
    # — the tail is never split and re-joined, so its own '/' characters cost
    # nothing here.
    mut list<int> slashes ← empty
    mut int i ← 0

    for from wire let c {
        if c ≡ '/' {
            slashes.append(i)

            if slashes.length() ≡ 6 {
                break
            }
        }

        i ← i + 1
    }

    require slashes.length() ≡ 6 throw variant BadWire { message = "malformed checkpoint wire" }

    let int m0 ← slashes.get(0) coalesce 0
    let int m1 ← slashes.get(1) coalesce 0
    let int m2 ← slashes.get(2) coalesce 0
    let int m3 ← slashes.get(3) coalesce 0
    let int m4 ← slashes.get(4) coalesce 0
    let int m5 ← slashes.get(5) coalesce 0

    require wire.slice(0, m0) ≡ "train" throw variant BadWire { message = "unknown checkpoint marker" }

    require wire.slice(m0 + 1, m1) ≡ "checkpoint" throw variant BadWire { message = "unknown checkpoint marker" }

    require wire.slice(m1 + 1, m2) ≡ schema_version throw variant UnknownVersion { message = "unknown checkpoint schema version" }

    let string age_text ← wire.slice(m2 + 1, m3)
    let string step_text ← wire.slice(m3 + 1, m4)

    require numeric(age_text) throw variant BadWire { message = "malformed epoch in checkpoint wire" }

    require numeric(step_text) throw variant BadWire { message = "malformed step in checkpoint wire" }

    mut int age ← 0
    mut int step ← 0

    do {
        age ↤ age_text
    }
    catch err {
        throw variant BadWire { message = "malformed epoch in checkpoint wire" }
    }

    do {
        step ↤ step_text
    }
    catch err {
        throw variant BadWire { message = "malformed step in checkpoint wire" }
    }

    let string status_text ← wire.slice(m4 + 1, m5)

    require status_text.length() ≢ 0 throw variant BadWire { message = "malformed rng state in checkpoint wire" }

    mut int status ← 0

    do {
        status ↤ status_text
    }
    catch err {
        throw variant BadWire { message = "malformed rng state in checkpoint wire" }
    }

    let random.Seed rng ← random.construct_seed(status)
    # The embedded optimizer-state wire is the '/' tail, sliced once verbatim.
    let string state_wire ← wire.slice(m5 + 1, wire.length())

    require state_wire.length() ≢ 0 throw variant EmptyState { message = "checkpoint state wire is empty" }

    return Checkpoint { age = age, step = step, rng = rng, state_wire = state_wire }
}

+++ faber test
# Co-located package tests for gradus:checkpoint.
# The envelope preserves its versioned wire and carries optimizer state
# verbatim; state validation remains the optimizer owner's responsibility.

import from "gradus:checkpoint" checkpoint

import from "gradus:random" random

import from "gradus:optimize" optimize

# A two-slot U3 optimizer-state wire (the checkpoint's embedded state),
# swallowing the never-firing OptimizeError through the tagged trap outcome.
fn sgd_wire_2() → string {
    let _ outcome ← trap {
        let optimize.Sgd o ← optimize.empty_sgd()
        let optimize.SgdState s1 ← optimize.construct("w1", "model", 1, 0.01 ∷ f32)
        let optimize.SgdState s2 ← optimize.construct("b1", "model", 1, 0.001 ∷ f32)
        let optimize.Sgd o2 ← optimize.add(o, s1)
        let optimize.Sgd o3 ← optimize.add(o2, s2)
        optimize.serialize(o3)
    }
    match outcome {
        case returned let wire {
            return wire
        }
        case thrown let ? {
            return ""
        }
    }
}

# Resume-path state-wire deserialization outcome (the embedded wire
# validates against ITS OWN schema — optimize.deserialize).
fn deserialize_optimum(string wire) → string {
    let _ outcome ← trap {
        optimize.deserialize(wire)
    }
    match outcome {
        case returned let value {
            return "ok"
        }
        case thrown let err {
            return err.message
        }
    }
}

# Renders a checkpoint-construction outcome as text.
fn checkpoint_detail(int age, int step, random.Seed rng, string state_wire) → string {
    let _ outcome ← trap {
        checkpoint.construct_checkpoint(age, step, rng, state_wire)
    }
    match outcome {
        case returned let value {
            return "ok"
        }
        case thrown let err {
            return err.message
        }
    }
}

# Renders a checkpoint-wire deserialization outcome as text.
fn deserialize_checkpoint_detail(string wire) → string {
    let _ outcome ← trap {
        checkpoint.deserialize_checkpoint(wire)
    }
    match outcome {
        case returned let value {
            return "ok"
        }
        case thrown let err {
            return err.message
        }
    }
}

# ---- the checkpoint envelope (Checkpoint)

test "construct_checkpoint builds a checkpoint with epoch, step, RNG, and state wire" {
    let _ trap_result_28 ← trap {

        let random.Seed s ← random.construct_seed(42)
        let checkpoint.Checkpoint c ← checkpoint.construct_checkpoint(2, 37, s, sgd_wire_2())
        assert c.age ≡ 2
        assert c.step ≡ 37
        assert c.rng.status ≡ 42
        assert c.state_wire.length() ≻ 0
    }
    match trap_result_28 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "construct_checkpoint rejects a negative epoch and a negative step" {
    let _ trap_result_29 ← trap {

        let random.Seed s ← random.construct_seed(42)
        assert checkpoint_detail(0 - 1, 0, s, sgd_wire_2()) ≡ "epoch must be non-negative"
        assert checkpoint_detail(0, 0 - 1, s, sgd_wire_2()) ≡ "step must be non-negative"
    }
    match trap_result_29 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "construct_checkpoint rejects an empty state wire" {
    let _ trap_result_30 ← trap {

        let random.Seed s ← random.construct_seed(42)
        assert checkpoint_detail(0, 0, s, "") ≡ "checkpoint state wire is empty"
    }
    match trap_result_30 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "the checkpoint wire round-trips exactly (epoch, step, RNG, embedded state verbatim)" {
    # The embedded state wire is valid at resume (optimize schema).
    let _ trap_result_31 ← trap {

        let random.Seed s ← random.construct_seed(42)
        let checkpoint.Checkpoint c ← checkpoint.construct_checkpoint(2, 37, s, sgd_wire_2())
        let checkpoint.Checkpoint t ← checkpoint.deserialize_checkpoint(checkpoint.serialize_checkpoint(c))
        assert checkpoint.checkpoint_equal(c, t)
        assert t.state_wire ≡ c.state_wire
        assert deserialize_optimum(t.state_wire) ≡ "ok"
    }
    match trap_result_31 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "the checkpoint wire round-trips a negative RNG state exactly" {
    let _ trap_result_32 ← trap {

        let random.Seed s0 ← random.construct_seed(1)
        let random.Draw f1 ← random.next(s0)
        let random.Draw f2 ← random.next(f1.seed)
        let random.Draw f3 ← random.next(f2.seed)
        let checkpoint.Checkpoint c ← checkpoint.construct_checkpoint(1, 3, f3.seed, sgd_wire_2())
        let checkpoint.Checkpoint t ← checkpoint.deserialize_checkpoint(checkpoint.serialize_checkpoint(c))
        assert checkpoint.checkpoint_equal(c, t)
        assert t.rng.status ≡ 0 - 7269227409276787159
    }
    match trap_result_32 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "an interrupted (corrupt embedded state) wire fails closed at resume — explicitly" {
    # A checkpoint whose embedded state wire was truncated mid-write:
    # the envelope carries it verbatim (the two-layer contract)...
    # ...and resume FAILS CLOSED at the state wire's own schema.
    let _ trap_result_33 ← trap {

        let random.Seed s ← random.construct_seed(42)
        let checkpoint.Checkpoint c ← checkpoint.construct_checkpoint(0, 0, s, "optimizer/sgd/1.0.0/2;optimizer/sgd-state/1.0.0/model/w1/1/1/0/0.01")
        let checkpoint.Checkpoint t ← checkpoint.deserialize_checkpoint(checkpoint.serialize_checkpoint(c))
        assert t.state_wire ≡ c.state_wire
        assert deserialize_optimum(t.state_wire) ≡ "slot count mismatch in optimizer wire"
    }
    match trap_result_33 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "an unknown checkpoint marker is rejected" {
    assert deserialize_checkpoint_detail("tensor/checkpoint/1.0.0/0/0/1/x") ≡ "unknown checkpoint marker"
}

test "an unknown checkpoint schema version is rejected" {
    assert deserialize_checkpoint_detail("train/checkpoint/9.9.9/0/0/1/x") ≡ "unknown checkpoint schema version"
}

test "a malformed checkpoint wire is rejected" {
    assert deserialize_checkpoint_detail("train/checkpoint/1.0.0/0") ≡ "malformed checkpoint wire"
}

test "a non-numeric epoch is rejected" {
    assert deserialize_checkpoint_detail("train/checkpoint/1.0.0/abc/0/1/x") ≡ "malformed epoch in checkpoint wire"
}

test "a zero RNG state in the checkpoint is rejected" {
    assert deserialize_checkpoint_detail("train/checkpoint/1.0.0/0/0/0/x") ≡ "seed must be non-zero"
}



# Four-slot optimizer-state wire used by the composed MLP resume proof.
fn sgd_wire_4() → string {
    let _ outcome ← trap {
        let optimize.Sgd o ← optimize.empty_sgd()
        let optimize.SgdState s1 ← optimize.construct("w1", "model.mlp", 1, 0.1 ∷ f32)
        let optimize.SgdState s2 ← optimize.construct("b1", "model.mlp", 1, 0.1 ∷ f32)
        let optimize.SgdState s3 ← optimize.construct("w2", "model.mlp", 1, 0.1 ∷ f32)
        let optimize.SgdState s4 ← optimize.construct("b2", "model.mlp", 1, 0.1 ∷ f32)
        let optimize.Sgd o1 ← optimize.add(o, s1)
        let optimize.Sgd o2 ← optimize.add(o1, s2)
        let optimize.Sgd o3 ← optimize.add(o2, s3)
        let optimize.Sgd o4 ← optimize.add(o3, s4)
        optimize.serialize(o4)
    }
    match outcome {
        case returned let wire {
            return wire
        }
        case thrown let ? {
            return ""
        }
    }
}

test "the four-slot state wire + RNG + epoch/step round-trips (checkpoint_equal) and resumes" {
    # The embedded four-slot state wire validates at resume.
    let _ trap_result_35 ← trap {

        let random.Seed s ← random.construct_seed(1)
        let checkpoint.Checkpoint c ← checkpoint.construct_checkpoint(0, 100, s, sgd_wire_4())
        let checkpoint.Checkpoint t ← checkpoint.deserialize_checkpoint(checkpoint.serialize_checkpoint(c))
        assert checkpoint.checkpoint_equal(c, t)
        assert deserialize_optimum(t.state_wire) ≡ "ok"
    }
    match trap_result_35 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}
