+++
locale = "en"
+++
# Serialization contract — versioned bytes wire format (PML1-U7).
#
# Public import: import from "gradus:serialize" serialize
# Depends on: nothing (leaf module). Contract mirrors are documented in the
# header below (U2 dtype names, U3 shape ceilings, U5 identity rules).
#
# --- Contract ------------------------------------------------------------
#
# Schema: serialize-schema-1.0.0 (stamped 2026-08-08, PML1-U7). One versioned
# BYTES wire format (bytes carrier) that carries tensor / dtype / shape /
# parameter values and round-trips them. Consumers reject unknown schema
# versions and unknown kinds — no best-effort partial reads (capsule rule,
# PML0-U14).
#
# Wire format (all integers big-endian):
#
#   Header (4 bytes):
#     [0..2)  magic  0x53 0x46        ("SF")
#     [2]     schema 0x01             (wire schema version byte)
#     [3]     kind   0x01 dtype | 0x02 shape | 0x03 tensor | 0x04 parameter
#
#   dtype payload:     tag u8   (0=f32, 1=f16, 2=i32, 3=u8 — the four
#                      canonical dtype names of dtype-schema-1.0.0, U2)
#   shape payload:     rank u8, then rank × dim i64be (non-negative;
#                      rank ≤ 64; products mirror gradus:shape
#                      numel — checked signed-int arithmetic, no policy cap)
#   tensor payload:    tag u8 | rank u8 | rank × dim i64be |
#                      data_len u32be | data (UTF-8 text of space-separated
#                      float tokens, shortest round-trip form)
#   parameter payload: tag u8 | rank u8 | rank × dim i64be | version i64be
#                      (≥ 1) | status u8 (0=trainable, 1=frozen) |
#                      owner_len u32be | owner UTF-8 |
#                      name_len u32be | name UTF-8 |
#                      data_len u32be | data (as tensor)
#
# Field ordering is fixed; a deserializer must consume exactly the declared
# payload and rejects trailing bytes. Names/owners follow the U5 identity
# wire-safety rule ('/' reserved).
#
# Float payload encoding (language-surface fact): the language has no float
# bit-reinterpretation primitive, so float data is carried as shortest
# round-trip text tokens (Rust-style f64 display/parse: lossless both
# ways, NaN/±Inf included). Integer fields are fixed-width binary. This is a
# drift candidate for the NGAB1 packet fact recheck (R1) — recorded here,
# not silently. Physical storage/bit-layout remains a host concern.
#
# Version rejection: a reader rejects an unknown magic, an unknown schema
# byte (UnknownVersion), or an unknown kind byte (UnknownKind) before
# touching the payload.
#
# Migration policy (feeds the PML6 package contract):
#   * the schema byte IS the version gate; any change to a field layout,
#     field encoding, or value semantics of a payload is a schema bump;
#   * backward-compatible additions (new trailing optional fields) bump the
#     minor schema version (1.0.0 → 1.1.0); breaking changes (reordered /
#     renumbered / repurposed fields or tags) bump the major (1.0.0 → 2.0.0);
#   * migration is WRITE-side: a new schema produces new bytes; old bytes are
#     never mutated in place, and a reader that does not know a schema byte
#     rejects rather than guessing. Downgrade/admission is a package-layer
#     (PML6) decision, not a wire-layer one.
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * Public signatures stay on primitives (text dtype names, flat lists,
#     bytes) plus this module's own genera (SerializedTensor, ParameterWire) so the
#     proba file-interface keeps every export (WARN014 — same seam as
#     parameter.fab U5).
#   * The dtype tag mapping mirrors dtype.fab U2's canonical names; the
#     shape ceilings (rank/dim/element) mirror gradus:shape U3; the
#     identity rules (name/owner wire-safety, version ≥ 1, status names)
#     mirror parameter.fab U5. All are documented mirrors, not imports, so
#     the module stays a dependency-free leaf.
#
# --- Seams ---------------------------------------------------------------
#   * package contract consumption of this schema — PML6.
#   * physical storage/bit-layout — hosts.
#   * capsule trust model over deserialized bytes — PML2 (no raw bytes as
#     trust anchor, C8).

# -------------------------------------------------------------------------
# Schema and wire constants. SCHEMA_BYTE is the wire-format version gate;
# the textual schema identity is documented in the contract header above.
# -------------------------------------------------------------------------

const int MAGIC_0 = 83

const int MAGIC_1 = 70

const int SCHEMA_BYTE = 1

const int KIND_DTYPE = 1

const int KIND_SHAPE = 2

const int KIND_TENSOR = 3

const int KIND_PARAMETER = 4

const int TAG_F32 = 0

const int TAG_F16 = 1

const int TAG_I32 = 2

const int TAG_U8 = 3

const int STATUS_TRAINABLE = 0

const int STATUS_FROZEN = 1
# Rank ceiling mirrors shape.RANK_LIMIT (U3); u32 length ceiling mirrors
# the wire u32be length field.
const int RANK_LIMIT = 64

const int LENGTH_LIMIT = 4294967295

const int INTEGER_MAX = 9223372036854775807

# -------------------------------------------------------------------------
# SerializeError — typed error vocabulary of the serialization contract.
# Every variant carries a text message (render via message). Variant → class:
#   UnknownVersion — unknown magic / schema byte (version rejection).
#   UnknownKind — unknown kind byte.
#   UnknownDtype  — unknown dtype name (serialize) or tag (deserialize).
#   BadShape    — rank/dimension/element-count ceiling violations.
#   BadWire     — malformed bytes: truncation, bad length, invalid version
#                  / status / name rules, trailing bytes, bad UTF-8.
#   BadData     — element-data failures: count mismatch, malformed tokens.
# -------------------------------------------------------------------------


@ public
union SerializeError {
    @ shared
    string message

    UnknownVersion,
    UnknownKind,
    UnknownDtype,
    BadShape,
    BadWire,
    BadData
}



# -------------------------------------------------------------------------
# Result carriers — same-module genera so proba consumers can read a
# deserialized value through projections without WARN014 (compiler-lane
# seam; see header).
# -------------------------------------------------------------------------

# A deserialized tensor value: dtype name + runtime shape + flat data.

@ public
class SerializedTensor {
    # Canonical dtype name (the dtype contract, U2).
    mut string dtype_name
    # Runtime shape (dimension vector).
    mut list<int> shape
    # Flat row-major data.
    mut list<f32> data
}

# A deserialized parameter value: full U5 identity + status + flat data.

@ public
class ParameterWire {
    # Parameter name (identity).
    mut string name
    # Owner path (identity).
    mut string owner
    # Canonical dtype name (identity).
    mut string dtype_name
    # Runtime shape (identity).
    mut list<int> shape
    # Mutation counter (identity).
    mut int version
    # Status name ("trainable" | "frozen").
    mut string status_name
    # Flat row-major data (value).
    mut list<f32> data
}

# -------------------------------------------------------------------------
# Private byte helpers. Encoding helpers assume validated inputs (non-
# negative; lengths ≤ u32 max; versions ≥ 1); decoding helpers assume the
# caller has validated bounds before reading.
# -------------------------------------------------------------------------

# bytes → byte list (parse cursor carrier).
fn byte_list(list<b8> o) → list<u8> {
    return o ↦ list<u8>
}

# text → UTF-8 byte list.
fn text_bytes(string s) → list<u8> {
    let list<b8> o ↤ s
    return byte_list(o)
}

# Why: a bare `n ↦ int<u8>` is failable and its error is text, so it cannot
# be handled inside a `⇥ SerializeError` function (SEM016); `⊥ 0` handles it
# here once. Every caller passes a wire constant (magic, schema, kind, status
# byte, all < 256) or a value validated before the append (dtype tag 0..3,
# rank ≤ RANK_LIMIT = 64), so the default never applies and only satisfies D17.8.
fn wire_byte(int n) → u8 {
    return n ↦ u8 ⊥ 0
}

# Why: each byte is extracted through `wrapping<u8>` (mod 2^8, cannot fail)
# before the `int<u8>` label; a bare `(n ⇒ k) ↦ int<u8>` is magnitude-checked
# and would abort whenever the shifted value exceeds 255.
# u32 big-endian (n validated: 0 ≤ n < 2^32 by callers).
fn be4(int n) → list<u8> {
    mut list<u8> out ← empty
    out.append(((n ⇒ 24) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 16) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 8) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 0) ↦ wrapping<u8>) ↦ u8)
    return out
}

# i64 big-endian (n validated: 0 ≤ n < 2^63 by callers).
fn be8(int n) → list<u8> {
    mut list<u8> out ← empty
    out.append(((n ⇒ 56) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 48) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 40) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 32) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 24) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 16) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 8) ↦ wrapping<u8>) ↦ u8)
    out.append(((n ⇒ 0) ↦ wrapping<u8>) ↦ u8)
    return out
}

# Wire header validation — returns the kind byte. Rejects unknown magic and
# unknown schema byte (version rejection) before any payload parsing.
fn header(list<u8> b) → int ⇥ SerializeError {
    require b.length() ≥ 4 throw variant BadWire { message = "truncated header" }
    let int m0 ← b.get(0) coalesce 0 ∷ u8 ↦ int
    let int m1 ← b.get(1) coalesce 0 ∷ u8 ↦ int
    reject m0 ≢ MAGIC_0 or m1 ≢ MAGIC_1 throw variant UnknownVersion { message = "unknown serialize magic" }
    let int schema ← b.get(2) coalesce 0 ∷ u8 ↦ int
    require schema ≡ SCHEMA_BYTE throw variant UnknownVersion { message = "unknown serialize schema version" }
    return b.get(3) coalesce 0 ∷ u8 ↦ int
}

# Length-prefixed UTF-8 text read; rejects truncation and bad UTF-8.
fn read_text(list<u8> b, int off, int len) → string ⇥ SerializeError {
    require off + len ≤ b.length() throw variant BadWire { message = "truncated text field" }
    mut list<u8> sub ← empty
    for range 0 ‥ len let i {
        sub.append(b.get(off + i) coalesce 0 ∷ u8)
    }
    let list<b8> o ↤ sub
    do {
        let string s ↤ o
        return s
    }
    catch err {
        throw variant BadWire { message = "invalid UTF-8 text field" }
    }
    throw variant BadWire { message = "unreachable" }
}

# Checked element product for a shape — mirror of gradus:shape U3's
# numel/_productus. Negative dimensions reject, and multiplication is
# bounded only by the signed integer carrier.
fn numel(list<int> shape) → int ⇥ SerializeError {
    mut int product ← 1
    for from shape let dim {
        require dim ≥ 0 throw variant BadShape { message = "negative dimension" }
        if dim ≻ 0 {
            require product ≤ INTEGER_MAX / dim throw variant BadShape { message = "element count overflows signed integer range" }
            product ← product * dim
        }
        else {
            product ← 0
        }
    }
    return product
}

# Rank ceiling check (mirrors shape.RANK_LIMIT; the wire rank field is u8).
fn rank_of(list<int> shape) → int ⇥ SerializeError {
    let int rank ← shape.length()
    require rank ≤ RANK_LIMIT throw variant BadShape { message = "rank above ceiling" }
    return rank
}

# Flat float data → space-separated shortest-round-trip text.
fn join_data(list<f32> data) → string {
    mut string out ← ""
    for range 0 ‥ data.length() let i {
        if i ≻ 0 {
            out ← out + " "
        }
        let f32 v ← data.get(i) coalesce 0.0
        out ← out + (v ↦ string)
    }
    return out
}

# Space-separated float text → flat data, count-checked against the
# shape product. Empty text round-trips an empty data list only when the
# shape expects zero elements (fail-closed otherwise).
fn split_data(string data_text, int expect) → list<f32> ⇥ SerializeError {
    if data_text.length() ≡ 0 {
        if expect ≡ 0 {
            let list<f32> nil ← empty
            return nil
        }
        else {
            throw variant BadData { message = "missing element data" }
        }
    }
    let list<string> tokens ← data_text.split(" ")
    require tokens.length() ≡ expect throw variant BadData { message = "element count mismatch in serialized data" }
    mut list<f32> out ← empty
    for from tokens let tok {
        require tok.length() ≢ 0 throw variant BadData { message = "malformed float token" }
        do {
            let f32 v ↤ tok
            out.append(v)
        }
        catch err {
            throw variant BadData { message = "malformed float token" }
        }
    }
    return out
}

# Canonical dtype name → wire tag. Mirrors dtype.fab U2's canonical names
# and its unknown-name error identity.
fn tag_from_name(string name) → int ⇥ SerializeError {
    if name ≡ "f32" then return TAG_F32
    if name ≡ "f16" then return TAG_F16
    if name ≡ "i32" then return TAG_I32
    if name ≡ "u8" then return TAG_U8
    throw variant UnknownDtype { message = "unknown dtype name: §"(name) }
}

# Wire tag → canonical dtype name.
fn name_from_tag(int tag) → string ⇥ SerializeError {
    if tag ≡ TAG_F32 then return "f32"
    if tag ≡ TAG_F16 then return "f16"
    if tag ≡ TAG_I32 then return "i32"
    if tag ≡ TAG_U8 then return "u8"
    throw variant UnknownDtype { message = "unknown dtype tag" }
}

# "/" is reserved in parameter names/owners (U5 identity wire-safety rule,
# mirrored here so the bytes contract cannot admit an identity U5 rejects).
fn contains_separator(string s) → bool {
    return s.contains("/")
}

# -------------------------------------------------------------------------
# Serialization — values → versioned bytes.
# -------------------------------------------------------------------------

@ public
fn serialize_dtype(string dtype_name) → list<b8> ⇥ SerializeError {
    let int tag ← tag_from_name(dtype_name)
    mut list<u8> buf ← empty
    buf.append(wire_byte(MAGIC_0))
    buf.append(wire_byte(MAGIC_1))
    buf.append(wire_byte(SCHEMA_BYTE))
    buf.append(wire_byte(KIND_DTYPE))
    buf.append(wire_byte(tag))
    let list<b8> wire ↤ buf
    return wire
}

@ public
fn serialize_shape(list<int> shape) → list<b8> ⇥ SerializeError {
    let int rank ← rank_of(shape)
    mut list<u8> buf ← empty
    buf.append(wire_byte(MAGIC_0))
    buf.append(wire_byte(MAGIC_1))
    buf.append(wire_byte(SCHEMA_BYTE))
    buf.append(wire_byte(KIND_SHAPE))
    buf.append(wire_byte(rank))
    # Per-dim validation mirrors shape._productus during the single encode
    # pass. Negative dims and signed-integer overflow fail closed.
    mut int product ← 1
    for from shape let dim {
        require dim ≥ 0 throw variant BadShape { message = "negative dimension" }
        if dim ≻ 0 {
            require product ≤ INTEGER_MAX / dim throw variant BadShape { message = "element count overflows signed integer range" }
            product ← product * dim
        }
        else {
            product ← 0
        }
        let list<u8> enc ← be8(dim)
        for from enc let byte {
            buf.append(byte)
        }
    }
    let list<b8> wire ↤ buf
    return wire
}

@ public
fn serialize_tensor(list<f32> data, list<int> shape, string dtype_name) → list<b8> ⇥ SerializeError {
    let int tag ← tag_from_name(dtype_name)
    let int rank ← rank_of(shape)
    let int expect ← numel(shape)
    require data.length() ≡ expect throw variant BadData { message = "element count mismatch" }
    let string data_text ← join_data(data)
    let int data_len ← data_text.length()
    require data_len ≤ LENGTH_LIMIT throw variant BadData { message = "serialized data too large" }
    mut list<u8> buf ← empty
    buf.append(wire_byte(MAGIC_0))
    buf.append(wire_byte(MAGIC_1))
    buf.append(wire_byte(SCHEMA_BYTE))
    buf.append(wire_byte(KIND_TENSOR))
    buf.append(wire_byte(tag))
    buf.append(wire_byte(rank))
    for from shape let dim {
        let list<u8> enc ← be8(dim)
        for from enc let byte {
            buf.append(byte)
        }
    }
    let list<u8> data_len_enc ← be4(data_len)
    for from data_len_enc let byte {
        buf.append(byte)
    }
    let list<u8> data_bytes ← text_bytes(data_text)
    for from data_bytes let byte {
        buf.append(byte)
    }
    let list<b8> wire ↤ buf
    return wire
}

@ public
fn serialize_parameter(string name, string owner, string dtype_name, list<int> shape, int version, string status_name, list<f32> data) → list<b8> ⇥ SerializeError {
    require name.length() ≢ 0 throw variant BadWire { message = "empty parameter name" }
    require owner.length() ≢ 0 throw variant BadWire { message = "empty parameter owner" }
    reject contains_separator(name) or contains_separator(owner) throw variant BadWire { message = "reserved wire character in name or owner" }
    reject name.length() ≻ LENGTH_LIMIT or owner.length() ≻ LENGTH_LIMIT throw variant BadWire { message = "serialized name too large" }
    require version ≥ 1 throw variant BadWire { message = "invalid parameter version" }
    mut int status ← STATUS_TRAINABLE
    if status_name ≡ "trainable" {
        status ← STATUS_TRAINABLE
    }
    else {
        if status_name ≡ "frozen" {
            status ← STATUS_FROZEN
        }
        else {
            throw variant BadWire { message = "unknown parameter status" }
        }
    }
    let int tag ← tag_from_name(dtype_name)
    let int rank ← rank_of(shape)
    let int expect ← numel(shape)
    require data.length() ≡ expect throw variant BadData { message = "element count mismatch" }
    let string data_text ← join_data(data)
    let int data_len ← data_text.length()
    require data_len ≤ LENGTH_LIMIT throw variant BadData { message = "serialized data too large" }
    mut list<u8> buf ← empty
    buf.append(wire_byte(MAGIC_0))
    buf.append(wire_byte(MAGIC_1))
    buf.append(wire_byte(SCHEMA_BYTE))
    buf.append(wire_byte(KIND_PARAMETER))
    buf.append(wire_byte(tag))
    buf.append(wire_byte(rank))
    for from shape let dim {
        let list<u8> enc ← be8(dim)
        for from enc let byte {
            buf.append(byte)
        }
    }
    let list<u8> version_enc ← be8(version)
    for from version_enc let byte {
        buf.append(byte)
    }
    buf.append(wire_byte(status))
    let list<u8> owner_len ← be4(owner.length())
    for from owner_len let byte {
        buf.append(byte)
    }
    let list<u8> owner_bytes ← text_bytes(owner)
    for from owner_bytes let byte {
        buf.append(byte)
    }
    let list<u8> name_len ← be4(name.length())
    for from name_len let byte {
        buf.append(byte)
    }
    let list<u8> name_bytes ← text_bytes(name)
    for from name_bytes let byte {
        buf.append(byte)
    }
    let list<u8> data_len_enc ← be4(data_len)
    for from data_len_enc let byte {
        buf.append(byte)
    }
    let list<u8> data_bytes ← text_bytes(data_text)
    for from data_bytes let byte {
        buf.append(byte)
    }
    let list<b8> wire ↤ buf
    return wire
}

# -------------------------------------------------------------------------
# Deserialization — versioned bytes → values. Every path validates the
# header first (version rejection), then consumes exactly the declared
# payload and rejects trailing bytes.
# -------------------------------------------------------------------------

@ public
fn deserialize_dtype(list<b8> wire) → string ⇥ SerializeError {
    let list<u8> b ← byte_list(wire)
    let int kind ← header(b)
    require kind ≡ KIND_DTYPE throw variant UnknownKind { message = "unknown serialize kind" }
    require b.length() ≡ 5 throw variant BadWire { message = "malformed dtype payload" }
    let int tag ← b.get(4) coalesce 0 ∷ u8 ↦ int
    return name_from_tag(tag)
}

@ public
fn deserialize_shape(list<b8> wire) → list<int> ⇥ SerializeError {
    let list<u8> b ← byte_list(wire)
    let list<b8> buf ↤ b
    let int kind ← header(b)
    require kind ≡ KIND_SHAPE throw variant UnknownKind { message = "unknown serialize kind" }
    require b.length() ≥ 5 throw variant BadWire { message = "truncated shape payload" }
    let int rank ← b.get(4) coalesce 0 ∷ u8 ↦ int
    require rank ≤ RANK_LIMIT throw variant BadShape { message = "rank above ceiling" }
    require b.length() ≡ 5 + rank * 8 throw variant BadWire { message = "malformed shape payload" }
    mut list<int> out ← empty
    for range 0 ‥ rank let i {
        let int lead ← b.get(5 + i * 8) coalesce 0 ∷ u8 ↦ int
        require lead ≺ 128 throw variant BadShape { message = "negative dimension" }
        let int dim ← (buf[5 + i * 8 ‥ 5 + i * 8 + 8] ↦ i64 via Be) ↦ int
        out.append(dim)
    }
    return out
}

@ public
fn deserialize_tensor(list<b8> wire) → SerializedTensor ⇥ SerializeError {
    let list<u8> b ← byte_list(wire)
    let list<b8> buf ↤ b
    let int kind ← header(b)
    require kind ≡ KIND_TENSOR throw variant UnknownKind { message = "unknown serialize kind" }
    require b.length() ≥ 6 throw variant BadWire { message = "truncated tensor payload" }
    let int tag ← b.get(4) coalesce 0 ∷ u8 ↦ int
    let string dtype ← name_from_tag(tag)
    let int rank ← b.get(5) coalesce 0 ∷ u8 ↦ int
    require rank ≤ RANK_LIMIT throw variant BadShape { message = "rank above ceiling" }
    let int dims_off ← 6
    mut list<int> shape ← empty
    for range 0 ‥ rank let i {
        let int lead ← b.get(dims_off + i * 8) coalesce 0 ∷ u8 ↦ int
        require lead ≺ 128 throw variant BadShape { message = "negative dimension" }
        let int dim ← (buf[dims_off + i * 8 ‥ dims_off + i * 8 + 8] ↦ i64 via Be) ↦ int
        shape.append(dim)
    }
    let int data_off ← dims_off + rank * 8
    require b.length() ≥ data_off + 4 throw variant BadWire { message = "truncated tensor data length" }
    let int data_len ← (buf[data_off ‥ data_off + 4] ↦ u32 via Be) ↦ int
    let int data_start ← data_off + 4
    require b.length() ≡ data_start + data_len throw variant BadWire { message = "malformed tensor payload" }
    let string data_text ← read_text(b, data_start, data_len)
    let int expect ← numel(shape)
    let list<f32> data ← split_data(data_text, expect)
    return SerializedTensor { dtype_name = dtype, shape = shape, data = data }
}

@ public
fn deserialize_parameter(list<b8> wire) → ParameterWire ⇥ SerializeError {
    let list<u8> b ← byte_list(wire)
    let list<b8> buf ↤ b
    let int kind ← header(b)
    require kind ≡ KIND_PARAMETER throw variant UnknownKind { message = "unknown serialize kind" }
    require b.length() ≥ 6 throw variant BadWire { message = "truncated parameter payload" }
    let int tag ← b.get(4) coalesce 0 ∷ u8 ↦ int
    let string dtype ← name_from_tag(tag)
    let int rank ← b.get(5) coalesce 0 ∷ u8 ↦ int
    require rank ≤ RANK_LIMIT throw variant BadShape { message = "rank above ceiling" }
    let int dims_off ← 6
    mut list<int> shape ← empty
    for range 0 ‥ rank let i {
        let int lead ← b.get(dims_off + i * 8) coalesce 0 ∷ u8 ↦ int
        require lead ≺ 128 throw variant BadShape { message = "negative dimension" }
        let int dim ← (buf[dims_off + i * 8 ‥ dims_off + i * 8 + 8] ↦ i64 via Be) ↦ int
        shape.append(dim)
    }
    let int version_off ← dims_off + rank * 8
    require b.length() ≥ version_off + 13 throw variant BadWire { message = "truncated parameter fields" }
    let int version_lead ← b.get(version_off) coalesce 0 ∷ u8 ↦ int
    require version_lead ≺ 128 throw variant BadWire { message = "invalid version in serialized parameter" }
    let int version ← (buf[version_off ‥ version_off + 8] ↦ i64 via Be) ↦ int
    require version ≥ 1 throw variant BadWire { message = "invalid version in serialized parameter" }
    let int status ← b.get(version_off + 8) coalesce 0 ∷ u8 ↦ int
    mut string status_name ← ""
    if status ≡ STATUS_TRAINABLE {
        status_name ← "trainable"
    }
    else {
        if status ≡ STATUS_FROZEN {
            status_name ← "frozen"
        }
        else {
            throw variant BadWire { message = "unknown parameter status" }
        }
    }
    let int poss_off ← version_off + 9
    require b.length() ≥ poss_off + 4 throw variant BadWire { message = "truncated parameter owner" }
    let int owner_len ← (buf[poss_off ‥ poss_off + 4] ↦ u32 via Be) ↦ int
    let int owner_start ← poss_off + 4
    require b.length() ≥ owner_start + owner_len throw variant BadWire { message = "truncated parameter owner" }
    let string owner ← read_text(b, owner_start, owner_len)
    require owner.length() ≢ 0 throw variant BadWire { message = "empty parameter owner" }
    let int name_off ← owner_start + owner_len
    require b.length() ≥ name_off + 4 throw variant BadWire { message = "truncated parameter name" }
    let int name_len ← (buf[name_off ‥ name_off + 4] ↦ u32 via Be) ↦ int
    let int name_start ← name_off + 4
    require b.length() ≥ name_start + name_len throw variant BadWire { message = "truncated parameter name" }
    let string name ← read_text(b, name_start, name_len)
    require name.length() ≢ 0 throw variant BadWire { message = "empty parameter name" }
    reject contains_separator(name) or contains_separator(owner) throw variant BadWire { message = "reserved wire character in name or owner" }
    let int data_off ← name_start + name_len
    require b.length() ≥ data_off + 4 throw variant BadWire { message = "truncated parameter data length" }
    let int data_len ← (buf[data_off ‥ data_off + 4] ↦ u32 via Be) ↦ int
    let int data_start ← data_off + 4
    require b.length() ≡ data_start + data_len throw variant BadWire { message = "malformed parameter payload" }
    let string data_text ← read_text(b, data_start, data_len)
    let int expect ← numel(shape)
    let list<f32> data ← split_data(data_text, expect)
    return ParameterWire { name = name, owner = owner, dtype_name = dtype, shape = shape, version = version, status_name = status_name, data = data }
}
