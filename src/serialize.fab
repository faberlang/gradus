+++
locale = "en"
+++
# Serialization contract — versioned bytes wire format (PML1-U7).
#
# Public import: importa ex "gradus:serialize" privata serializa
# Depends on: nothing (leaf module). Contract mirrors are documented in the
# header below (U2 dtype names, U3 shape ceilings, U5 identity rules).
#
# --- Contract ------------------------------------------------------------
#
# Schema: serialize-schema-1.0.0 (stamped 2026-08-08, PML1-U7). One versioned
# BYTES wire format (octeti carrier) that carries tensor / dtype / shape /
# parameter values and round-trips them. Consumers reject unknown schema
# versions and unknown kinds — no best-effort partial reads (capsule rule,
# PML0-U14).
#
# Wire format (all integers big-endian):
#
#   Header (4 bytes):
#     [0..2)  magic  0x53 0x46        ("SF")
#     [2]     schema 0x01             (wire schema version byte)
#     [3]     kind   0x01 dtype | 0x02 shape | 0x03 tensor | 0x04 parameter
#
#   dtype payload:     tag u8   (0=f32, 1=f16, 2=i32, 3=u8 — the four
#                      canonical dtype names of dtype-schema-1.0.0, U2)
#   shape payload:     rank u8, then rank × dim i64be (non-negative;
#                      rank ≤ 64; dims/ceiling mirror gradus:shape
#                      quantitas — element ceiling, no per-dimension cap)
#   tensor payload:    tag u8 | rank u8 | rank × dim i64be |
#                      data_len u32be | data (UTF-8 textus of space-separated
#                      float tokens, shortest round-trip form)
#   parameter payload: tag u8 | rank u8 | rank × dim i64be | versio i64be
#                      (≥ 1) | statio u8 (0=trainable, 1=frozen) |
#                      possessor_len u32be | possessor UTF-8 |
#                      nomen_len u32be | nomen UTF-8 |
#                      data_len u32be | data (as tensor)
#
# Field ordering is fixed; a deserializer must consume exactly the declared
# payload and rejects trailing bytes. Names/owners follow the U5 identity
# wire-safety rule ('/' reserved).
#
# Float payload encoding (language-surface fact): the language has no float
# bit-reinterpretation primitive, so float data is carried as shortest
# round-trip textus tokens (Rust-style f64 display/parse: lossless both
# ways, NaN/±Inf included). Integer fields are fixed-width binary. This is a
# drift candidate for the NGAB1 packet fact recheck (R1) — recorded here,
# not silently. Physical storage/bit-layout remains a host concern.
#
# Version rejection: a reader rejects an unknown magic, an unknown schema
# byte (VersioIgnota), or an unknown kind byte (GenusIgnotum) before
# touching the payload.
#
# Migration policy (feeds the PML6 package contract):
#   * the schema byte IS the version gate; any change to a field layout,
#     field encoding, or value semantics of a payload is a schema bump;
#   * backward-compatible additions (new trailing optional fields) bump the
#     minor schema version (1.0.0 → 1.1.0); breaking changes (reordered /
#     renumbered / repurposed fields or tags) bump the major (1.0.0 → 2.0.0);
#   * migration is WRITE-side: a new schema produces new bytes; old bytes are
#     never mutated in place, and a reader that does not know a schema byte
#     rejects rather than guessing. Downgrade/admission is a package-layer
#     (PML6) decision, not a wire-layer one.
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * Public signatures stay on primitives (textus dtype names, flat lists,
#     octeti) plus this module's own genera (Tensum, ParametrumWire) so the
#     proba file-interface keeps every export (WARN014 — same seam as
#     parameter.fab U5).
#   * The dtype tag mapping mirrors dtype.fab U2's canonical names; the
#     shape ceilings (rank/dim/element) mirror gradus:shape U3; the
#     identity rules (name/owner wire-safety, versio ≥ 1, statio names)
#     mirror parameter.fab U5. All are documented mirrors, not imports, so
#     the module stays a dependency-free leaf.
#
# --- Seams ---------------------------------------------------------------
#   * package contract consumption of this schema — PML6.
#   * physical storage/bit-layout — hosts.
#   * capsule trust model over deserialized bytes — PML2 (no raw bytes as
#     trust anchor, C8).

# -------------------------------------------------------------------------
# Schema and wire constants. schema_versio is the public contract identity;
# the schema BYTE on the wire is its encoding (bump both together).
# -------------------------------------------------------------------------

const string schema_versio ← "1.0.0"

const int MAGIC_0 ← 83

const int MAGIC_1 ← 70

const int SCHEMA_BYTE ← 1

const int KIND_DTYPE ← 1

const int KIND_FORMA ← 2

const int KIND_TENSOR ← 3

const int KIND_PARAMETRUM ← 4

const int TAG_F32 ← 0

const int TAG_F16 ← 1

const int TAG_I32 ← 2

const int TAG_U8 ← 3

const int STATIO_TRAINABILIS ← 0

const int STATIO_GELIDA ← 1
# Rank ceiling mirrors shape.GRADUS_LIMES (U3); u32 length ceiling mirrors
# the wire u32be length field.
const int RANK_LIMES ← 64

const int LONGITUDO_LIMES ← 4294967295

# -------------------------------------------------------------------------
# SerializeError — typed error vocabulary of the serialization contract.
# Every variant carries a textus causa (render via causa). Variant → class:
#   VersioIgnota — unknown magic / schema byte (version rejection).
#   GenusIgnotum — unknown kind byte.
#   TypoIgnotum  — unknown dtype name (serialize) or tag (deserialize).
#   FormaMala    — rank/dimension/element-count ceiling violations.
#   WireMala     — malformed bytes: truncation, bad length, invalid version
#                  / status / name rules, trailing bytes, bad UTF-8.
#   DataMala     — element-data failures: count mismatch, malformed tokens.
# -------------------------------------------------------------------------


@ public { }
union SerializeError {
    VersioIgnota {
        string causa
    },
    GenusIgnotum {
        string causa
    },
    TypoIgnotum {
        string causa
    },
    FormaMala {
        string causa
    },
    WireMala {
        string causa
    },
    DataMala {
        string causa
    }
}

@ public { }
fn causa(SerializeError e) → string {
    match e {
        case VersioIgnota const causa {
            return causa
        }
        case GenusIgnotum const causa {
            return causa
        }
        case TypoIgnotum const causa {
            return causa
        }
        case FormaMala const causa {
            return causa
        }
        case WireMala const causa {
            return causa
        }
        case DataMala const causa {
            return causa
        }
    }
}

# -------------------------------------------------------------------------
# Result carriers — same-module genera so proba consumers can read a
# deserialized value through projections without WARN014 (compiler-lane
# seam; see header).
# -------------------------------------------------------------------------

# A deserialized tensor value: dtype nomen + runtime shape + flat data.

@ public { }
class Tensum {
    string typo_nomen
    list<int> forma
    list<f32> datos

    # Canonical dtype name (the dtype contract, U2).
    fn typo() → string {
        return self.typo_nomen
    }

    # Runtime shape (dimension vector).
    fn figura() → list<int> {
        return self.forma
    }

    # Flat row-major data.
    fn datos() → list<f32> {
        return self.datos
    }
}

# A deserialized parameter value: full U5 identity + status + flat data.

@ public { }
class ParametrumWire {
    string nomen
    string possessor
    string typo_nomen
    list<int> forma
    int versio
    string statio_nomen
    list<f32> datos

    # Parameter name (identity).
    fn nomen() → string {
        return self.nomen
    }

    # Owner path (identity).
    fn possessor() → string {
        return self.possessor
    }

    # Canonical dtype name (identity).
    fn typo() → string {
        return self.typo_nomen
    }

    # Runtime shape (identity).
    fn figura() → list<int> {
        return self.forma
    }

    # Mutation counter (identity).
    fn versio() → int {
        return self.versio
    }

    # Status nomen ("trainable" | "frozen").
    fn statium() → string {
        return self.statio_nomen
    }

    # Flat row-major data (value).
    fn datos() → list<f32> {
        return self.datos
    }
}

# -------------------------------------------------------------------------
# Private byte helpers. Encoding helpers assume validated inputs (non-
# negative; lengths ≤ u32 max; versions ≥ 1); decoding helpers assume the
# caller has validated bounds before reading.
# -------------------------------------------------------------------------

# octeti → byte list (parse cursor carrier).
@ private { }
fn _octeti_lista(bytes o) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i ≺ o.length() {
        out.append(o.get(i) coalesce 0 ∷ int<u8>)
        i ← i + 1
    }
    return out
}

# textus → UTF-8 byte list.
@ private { }
fn _textus_bytes(string s) → list<int<u8>> {
    const bytes o ← s ↦ bytes
    return _octeti_lista(o)
}

# u32 big-endian (n validated: 0 ≤ n < 2^32 by callers).
@ private { }
fn _be4(int n) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    out.append((n ⇒ 24) ↦ int<u8>)
    out.append((n ⇒ 16) ↦ int<u8>)
    out.append((n ⇒ 8) ↦ int<u8>)
    out.append((n ⇒ 0) ↦ int<u8>)
    return out
}

# i64 big-endian (n validated: 0 ≤ n < 2^63 by callers).
@ private { }
fn _be8(int n) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    out.append((n ⇒ 56) ↦ int<u8>)
    out.append((n ⇒ 48) ↦ int<u8>)
    out.append((n ⇒ 40) ↦ int<u8>)
    out.append((n ⇒ 32) ↦ int<u8>)
    out.append((n ⇒ 24) ↦ int<u8>)
    out.append((n ⇒ 16) ↦ int<u8>)
    out.append((n ⇒ 8) ↦ int<u8>)
    out.append((n ⇒ 0) ↦ int<u8>)
    return out
}

# u32 big-endian read at offset (bounds validated by callers).
# RENAMED from _le4 (correctness-fix slice, 2026-08-09): this READs big-
# endian — the serialize wire format is big-endian (header). The former
# name collided with safetensors.fab's genuinely little-endian _le8 (same
# name, opposite semantics). Behavior unchanged; the name now matches the
# byte order. Reference: serialize header "Wire format (all integers big-
# endian)" vs safetensors header "8-byte little-endian u64 header_size".
@ private { }
fn _be4_lege(list<int<u8>> b, int off) → int {
    const int r0 ← b.get(off + 0) coalesce 0 ∷ int<u8> ↦ int
    const int r1 ← b.get(off + 1) coalesce 0 ∷ int<u8> ↦ int
    const int r2 ← b.get(off + 2) coalesce 0 ∷ int<u8> ↦ int
    const int r3 ← b.get(off + 3) coalesce 0 ∷ int<u8> ↦ int
    return ((r3 ∨ r2 ⇐ 8) ∨ r1 ⇐ 16) ∨ r0 ⇐ 24
}

# i64 big-endian read at offset. Callers must reject a lead byte ≥ 0x80
# (a negative / out-of-range value) before reading.
# RENAMED from _le8 (correctness-fix slice, 2026-08-09): see _be4_lege —
# this READs big-endian (the serialize wire format); safetensors.fab's
# _le8 reads little-endian. Behavior unchanged.
@ private { }
fn _be8_lege(list<int<u8>> b, int off) → int {
    const int r0 ← b.get(off + 0) coalesce 0 ∷ int<u8> ↦ int
    const int r1 ← b.get(off + 1) coalesce 0 ∷ int<u8> ↦ int
    const int r2 ← b.get(off + 2) coalesce 0 ∷ int<u8> ↦ int
    const int r3 ← b.get(off + 3) coalesce 0 ∷ int<u8> ↦ int
    const int r4 ← b.get(off + 4) coalesce 0 ∷ int<u8> ↦ int
    const int r5 ← b.get(off + 5) coalesce 0 ∷ int<u8> ↦ int
    const int r6 ← b.get(off + 6) coalesce 0 ∷ int<u8> ↦ int
    const int r7 ← b.get(off + 7) coalesce 0 ∷ int<u8> ↦ int
    return ((((((r7 ∨ r6 ⇐ 8) ∨ r5 ⇐ 16) ∨ r4 ⇐ 24) ∨ r3 ⇐ 32) ∨ r2 ⇐ 40) ∨ r1 ⇐ 48) ∨ r0 ⇐ 56
}

# Wire header validation — returns the kind byte. Rejects unknown magic and
# unknown schema byte (version rejection) before any payload parsing.
@ private { }
fn _caput(list<int<u8>> b) → int ⇥ SerializeError {
    if b.length() ≺ 4 {
        throw variant WireMala {causa = "truncated header"}
    }
    const int m0 ← b.get(0) coalesce 0 ∷ int<u8> ↦ int
    const int m1 ← b.get(1) coalesce 0 ∷ int<u8> ↦ int
    if m0 ≠ MAGIC_0 or m1 ≠ MAGIC_1 {
        throw variant VersioIgnota {causa = "unknown serialize magic"}
    }
    const int schema ← b.get(2) coalesce 0 ∷ int<u8> ↦ int
    if schema ≠ SCHEMA_BYTE {
        throw variant VersioIgnota {causa = "unknown serialize schema version"}
    }
    return b.get(3) coalesce 0 ∷ int<u8> ↦ int
}

# Length-prefixed UTF-8 textus read; rejects truncation and bad UTF-8.
@ private { }
fn _legere_textus(list<int<u8>> b, int off, int len) → string ⇥ SerializeError {
    if off + len ≻ b.length() {
        throw variant WireMala {causa = "truncated textus field"}
    }
    var list<int<u8>> sub ← vacua
    var int i ← 0
    while i ≺ len {
        sub.append(b.get(off + i) coalesce 0 ∷ int<u8>)
        i ← i + 1
    }
    const bytes o ← sub
    do {
        const string s ← o ↦ string
        return s
    }
    catch err {
        throw variant WireMala {causa = "invalid UTF-8 textus field"}
    }
    throw variant WireMala {causa = "unreachable"}
}

# Bounded element product for a shape — mirror of gradus:shape U3's
# quantitas/_productus (ELEMENTA_LIMES 1_000_000_000, negative-dim
# rejection; no per-dimension cap — policy matches shape.quantitas since
# the CTO-2 shape-policy correction). One source of the shape wire's
# ceiling checks.
@ private { }
fn _quantitas(list<int> forma) → int ⇥ SerializeError {
    var int product ← 1
    for from forma const dim {
        if dim ≺ 0 {
            throw variant FormaMala {causa = "negative dimension"}
        }
        if dim ≻ 0 {
            if product ≻ 1000000000 / dim {
                throw variant FormaMala {causa = "element count above ceiling"}
            }
            product ← product * dim
        }
        else {
            product ← 0
        }
    }
    return product
}

# Rank ceiling check (mirrors shape.GRADUS_LIMES; the wire rank field is u8).
@ private { }
fn _gradus(list<int> forma) → int ⇥ SerializeError {
    const int rank ← forma.length()
    if rank ≻ RANK_LIMES {
        throw variant FormaMala {causa = "rank above ceiling"}
    }
    return rank
}

# Flat float data → space-separated shortest-round-trip textus.
@ private { }
fn _iunge_datos(list<f32> datos) → string {
    var string out ← ""
    var int i ← 0
    while i ≺ datos.length() {
        if i ≻ 0 {
            out ← out + " "
        }
        const f32 v ← datos.get(i) coalesce 0.0
        out ← out + (v ↦ string)
        i ← i + 1
    }
    return out
}

# Space-separated float textus → flat data, count-checked against the
# shape product. Empty textus round-trips an empty data list only when the
# shape expects zero elements (fail-closed otherwise).
@ private { }
fn _divido_datos(string datos_textus, int expect) → list<f32> ⇥ SerializeError {
    if datos_textus.length() ≡ 0 {
        if expect ≡ 0 {
            const list<f32> nil ← vacua
            return nil
        }
        else {
            throw variant DataMala {causa = "missing element data"}
        }
    }
    const list<string> tokens ← datos_textus.split(" ")
    if tokens.length() ≠ expect {
        throw variant DataMala {causa = "element count mismatch in serialized data"}
    }
    var list<f32> out ← vacua
    for from tokens const tok {
        if tok.length() ≡ 0 {
            throw variant DataMala {causa = "malformed float token"}
        }
        do {
            const f32 v ← tok ↦ f32
            out.append(v)
        }
        catch err {
            throw variant DataMala {causa = "malformed float token"}
        }
    }
    return out
}

# Canonical dtype name → wire tag. Mirrors dtype.fab U2's canonical names
# and its unknown-name error identity.
@ private { }
fn _tag_a(string nomen) → int ⇥ SerializeError {
    if nomen ≡ "f32" then return TAG_F32
    if nomen ≡ "f16" then return TAG_F16
    if nomen ≡ "i32" then return TAG_I32
    if nomen ≡ "u8" then return TAG_U8
    throw variant TypoIgnotum {causa = "unknown dtype name: " + nomen}
}

# Wire tag → canonical dtype name.
@ private { }
fn _nomen_a_tag(int tag) → string ⇥ SerializeError {
    if tag ≡ TAG_F32 then return "f32"
    if tag ≡ TAG_F16 then return "f16"
    if tag ≡ TAG_I32 then return "i32"
    if tag ≡ TAG_U8 then return "u8"
    throw variant TypoIgnotum {causa = "unknown dtype tag"}
}

# "/" is reserved in parameter names/owners (U5 identity wire-safety rule,
# mirrored here so the bytes contract cannot admit an identity U5 rejects).
@ private { }
fn _habeat_solidum(string s) → bool {
    var int i ← 0
    while i ≺ s.length() {
        if s.get(i) ≡ "/" then return true
        i ← i + 1
    }
    return false
}

# -------------------------------------------------------------------------
# Serialization — values → versioned bytes.
# -------------------------------------------------------------------------

@ public { }
fn serializa_dtype(string typo_nomen) → bytes ⇥ SerializeError {
    const int tag ← _tag_a(typo_nomen)
    var list<int<u8>> buf ← vacua
    buf.append(MAGIC_0 ↦ int<u8>)
    buf.append(MAGIC_1 ↦ int<u8>)
    buf.append(SCHEMA_BYTE ↦ int<u8>)
    buf.append(KIND_DTYPE ↦ int<u8>)
    buf.append(tag ↦ int<u8>)
    const bytes wire ← buf
    return wire
}

@ public { }
fn serializa_shape(list<int> forma) → bytes ⇥ SerializeError {
    const int rank ← _gradus(forma)
    var list<int<u8>> buf ← vacua
    buf.append(MAGIC_0 ↦ int<u8>)
    buf.append(MAGIC_1 ↦ int<u8>)
    buf.append(SCHEMA_BYTE ↦ int<u8>)
    buf.append(KIND_FORMA ↦ int<u8>)
    buf.append(rank ↦ int<u8>)
    # Per-dim validation mirrors shape._productus (U3 ceilings) during the
    # single encode pass — negative dims and element-ceiling violations
    # fail closed (no per-dimension cap).
    var int product ← 1
    for from forma const dim {
        if dim ≺ 0 {
            throw variant FormaMala {causa = "negative dimension"}
        }
        if dim ≻ 0 {
            if product ≻ 1000000000 / dim {
                throw variant FormaMala {causa = "element count above ceiling"}
            }
            product ← product * dim
        }
        else {
            product ← 0
        }
        const list<int<u8>> enc ← _be8(dim)
        for from enc const byte {
            buf.append(byte)
        }
    }
    const bytes wire ← buf
    return wire
}

@ public { }
fn serializa_tensor(list<f32> datos, list<int> forma, string typo_nomen) → bytes ⇥ SerializeError {
    const int tag ← _tag_a(typo_nomen)
    const int rank ← _gradus(forma)
    const int expect ← _quantitas(forma)
    if datos.length() ≠ expect {
        throw variant DataMala {causa = "element count mismatch"}
    }
    const string datos_textus ← _iunge_datos(datos)
    const int data_len ← datos_textus.length()
    if data_len ≻ LONGITUDO_LIMES {
        throw variant DataMala {causa = "serialized data too large"}
    }
    var list<int<u8>> buf ← vacua
    buf.append(MAGIC_0 ↦ int<u8>)
    buf.append(MAGIC_1 ↦ int<u8>)
    buf.append(SCHEMA_BYTE ↦ int<u8>)
    buf.append(KIND_TENSOR ↦ int<u8>)
    buf.append(tag ↦ int<u8>)
    buf.append(rank ↦ int<u8>)
    for from forma const dim {
        const list<int<u8>> enc ← _be8(dim)
        for from enc const byte {
            buf.append(byte)
        }
    }
    const list<int<u8>> data_len_enc ← _be4(data_len)
    for from data_len_enc const byte {
        buf.append(byte)
    }
    const list<int<u8>> data_bytes ← _textus_bytes(datos_textus)
    for from data_bytes const byte {
        buf.append(byte)
    }
    const bytes wire ← buf
    return wire
}

@ public { }
fn serializa_parametrum(string nomen, string possessor, string typo_nomen, list<int> forma, int versio, string statio_nomen, list<f32> datos) → bytes ⇥ SerializeError {
    if nomen.length() ≡ 0 {
        throw variant WireMala {causa = "empty parameter name"}
    }
    if possessor.length() ≡ 0 {
        throw variant WireMala {causa = "empty parameter owner"}
    }
    if _habeat_solidum(nomen) or _habeat_solidum(possessor) {
        throw variant WireMala {causa = "reserved wire character in name or owner"}
    }
    if nomen.length() ≻ LONGITUDO_LIMES or possessor.length() ≻ LONGITUDO_LIMES {
        throw variant WireMala {causa = "serialized name too large"}
    }
    if versio ≺ 1 {
        throw variant WireMala {causa = "invalid parameter version"}
    }
    var int statio ← STATIO_TRAINABILIS
    if statio_nomen ≡ "trainable" {
        statio ← STATIO_TRAINABILIS
    }
    else {
        if statio_nomen ≡ "frozen" {
            statio ← STATIO_GELIDA
        }
        else {
            throw variant WireMala {causa = "unknown parameter status"}
        }
    }
    const int tag ← _tag_a(typo_nomen)
    const int rank ← _gradus(forma)
    const int expect ← _quantitas(forma)
    if datos.length() ≠ expect {
        throw variant DataMala {causa = "element count mismatch"}
    }
    const string datos_textus ← _iunge_datos(datos)
    const int data_len ← datos_textus.length()
    if data_len ≻ LONGITUDO_LIMES {
        throw variant DataMala {causa = "serialized data too large"}
    }
    var list<int<u8>> buf ← vacua
    buf.append(MAGIC_0 ↦ int<u8>)
    buf.append(MAGIC_1 ↦ int<u8>)
    buf.append(SCHEMA_BYTE ↦ int<u8>)
    buf.append(KIND_PARAMETRUM ↦ int<u8>)
    buf.append(tag ↦ int<u8>)
    buf.append(rank ↦ int<u8>)
    for from forma const dim {
        const list<int<u8>> enc ← _be8(dim)
        for from enc const byte {
            buf.append(byte)
        }
    }
    const list<int<u8>> versio_enc ← _be8(versio)
    for from versio_enc const byte {
        buf.append(byte)
    }
    buf.append(statio ↦ int<u8>)
    const list<int<u8>> possessor_len ← _be4(possessor.length())
    for from possessor_len const byte {
        buf.append(byte)
    }
    const list<int<u8>> possessor_bytes ← _textus_bytes(possessor)
    for from possessor_bytes const byte {
        buf.append(byte)
    }
    const list<int<u8>> nomen_len ← _be4(nomen.length())
    for from nomen_len const byte {
        buf.append(byte)
    }
    const list<int<u8>> nomen_bytes ← _textus_bytes(nomen)
    for from nomen_bytes const byte {
        buf.append(byte)
    }
    const list<int<u8>> data_len_enc ← _be4(data_len)
    for from data_len_enc const byte {
        buf.append(byte)
    }
    const list<int<u8>> data_bytes ← _textus_bytes(datos_textus)
    for from data_bytes const byte {
        buf.append(byte)
    }
    const bytes wire ← buf
    return wire
}

# -------------------------------------------------------------------------
# Deserialization — versioned bytes → values. Every path validates the
# header first (version rejection), then consumes exactly the declared
# payload and rejects trailing bytes.
# -------------------------------------------------------------------------

@ public { }
fn deserializa_dtype(bytes wire) → string ⇥ SerializeError {
    const list<int<u8>> b ← _octeti_lista(wire)
    const int kind ← _caput(b)
    if kind ≠ KIND_DTYPE {
        throw variant GenusIgnotum {causa = "unknown serialize kind"}
    }
    if b.length() ≠ 5 {
        throw variant WireMala {causa = "malformed dtype payload"}
    }
    const int tag ← b.get(4) coalesce 0 ∷ int<u8> ↦ int
    return _nomen_a_tag(tag)
}

@ public { }
fn deserializa_shape(bytes wire) → list<int> ⇥ SerializeError {
    const list<int<u8>> b ← _octeti_lista(wire)
    const int kind ← _caput(b)
    if kind ≠ KIND_FORMA {
        throw variant GenusIgnotum {causa = "unknown serialize kind"}
    }
    if b.length() ≺ 5 {
        throw variant WireMala {causa = "truncated shape payload"}
    }
    const int rank ← b.get(4) coalesce 0 ∷ int<u8> ↦ int
    if rank ≻ RANK_LIMES {
        throw variant FormaMala {causa = "rank above ceiling"}
    }
    if b.length() ≠ 5 + rank * 8 {
        throw variant WireMala {causa = "malformed shape payload"}
    }
    var list<int> out ← vacua
    var int i ← 0
    while i ≺ rank {
        const int lead ← b.get(5 + i * 8) coalesce 0 ∷ int<u8> ↦ int
        if lead ≥ 128 {
            throw variant FormaMala {causa = "negative dimension"}
        }
        const int dim ← _be8_lege(b, 5 + i * 8)
        out.append(dim)
        i ← i + 1
    }
    return out
}

@ public { }
fn deserializa_tensor(bytes wire) → Tensum ⇥ SerializeError {
    const list<int<u8>> b ← _octeti_lista(wire)
    const int kind ← _caput(b)
    if kind ≠ KIND_TENSOR {
        throw variant GenusIgnotum {causa = "unknown serialize kind"}
    }
    if b.length() ≺ 6 {
        throw variant WireMala {causa = "truncated tensor payload"}
    }
    const int tag ← b.get(4) coalesce 0 ∷ int<u8> ↦ int
    const string typo ← _nomen_a_tag(tag)
    const int rank ← b.get(5) coalesce 0 ∷ int<u8> ↦ int
    if rank ≻ RANK_LIMES {
        throw variant FormaMala {causa = "rank above ceiling"}
    }
    const int dims_off ← 6
    var list<int> forma ← vacua
    var int i ← 0
    while i ≺ rank {
        const int lead ← b.get(dims_off + i * 8) coalesce 0 ∷ int<u8> ↦ int
        if lead ≥ 128 {
            throw variant FormaMala {causa = "negative dimension"}
        }
        const int dim ← _be8_lege(b, dims_off + i * 8)
        forma.append(dim)
        i ← i + 1
    }
    const int data_off ← dims_off + rank * 8
    if b.length() ≺ data_off + 4 {
        throw variant WireMala {causa = "truncated tensor data length"}
    }
    const int data_len ← _be4_lege(b, data_off)
    const int data_start ← data_off + 4
    if b.length() ≠ data_start + data_len {
        throw variant WireMala {causa = "malformed tensor payload"}
    }
    const string datos_textus ← _legere_textus(b, data_start, data_len)
    const int expect ← _quantitas(forma)
    const list<f32> datos ← _divido_datos(datos_textus, expect)
    return Tensum {typo_nomen = typo, forma = forma, datos = datos}
}

@ public { }
fn deserializa_parametrum(bytes wire) → ParametrumWire ⇥ SerializeError {
    const list<int<u8>> b ← _octeti_lista(wire)
    const int kind ← _caput(b)
    if kind ≠ KIND_PARAMETRUM {
        throw variant GenusIgnotum {causa = "unknown serialize kind"}
    }
    if b.length() ≺ 6 {
        throw variant WireMala {causa = "truncated parameter payload"}
    }
    const int tag ← b.get(4) coalesce 0 ∷ int<u8> ↦ int
    const string typo ← _nomen_a_tag(tag)
    const int rank ← b.get(5) coalesce 0 ∷ int<u8> ↦ int
    if rank ≻ RANK_LIMES {
        throw variant FormaMala {causa = "rank above ceiling"}
    }
    const int dims_off ← 6
    var list<int> forma ← vacua
    var int i ← 0
    while i ≺ rank {
        const int lead ← b.get(dims_off + i * 8) coalesce 0 ∷ int<u8> ↦ int
        if lead ≥ 128 {
            throw variant FormaMala {causa = "negative dimension"}
        }
        const int dim ← _be8_lege(b, dims_off + i * 8)
        forma.append(dim)
        i ← i + 1
    }
    const int versio_off ← dims_off + rank * 8
    if b.length() ≺ versio_off + 13 {
        throw variant WireMala {causa = "truncated parameter fields"}
    }
    const int versio_lead ← b.get(versio_off) coalesce 0 ∷ int<u8> ↦ int
    if versio_lead ≥ 128 {
        throw variant WireMala {causa = "invalid version in serialized parameter"}
    }
    const int versio ← _be8_lege(b, versio_off)
    if versio ≺ 1 {
        throw variant WireMala {causa = "invalid version in serialized parameter"}
    }
    const int statio ← b.get(versio_off + 8) coalesce 0 ∷ int<u8> ↦ int
    var string statio_nomen ← ""
    if statio ≡ STATIO_TRAINABILIS {
        statio_nomen ← "trainable"
    }
    else {
        if statio ≡ STATIO_GELIDA {
            statio_nomen ← "frozen"
        }
        else {
            throw variant WireMala {causa = "unknown parameter status"}
        }
    }
    const int poss_off ← versio_off + 9
    if b.length() ≺ poss_off + 4 {
        throw variant WireMala {causa = "truncated parameter owner"}
    }
    const int possessor_len ← _be4_lege(b, poss_off)
    const int possessor_start ← poss_off + 4
    if b.length() ≺ possessor_start + possessor_len {
        throw variant WireMala {causa = "truncated parameter owner"}
    }
    const string possessor ← _legere_textus(b, possessor_start, possessor_len)
    if possessor.length() ≡ 0 {
        throw variant WireMala {causa = "empty parameter owner"}
    }
    const int nomen_off ← possessor_start + possessor_len
    if b.length() ≺ nomen_off + 4 {
        throw variant WireMala {causa = "truncated parameter name"}
    }
    const int nomen_len ← _be4_lege(b, nomen_off)
    const int nomen_start ← nomen_off + 4
    if b.length() ≺ nomen_start + nomen_len {
        throw variant WireMala {causa = "truncated parameter name"}
    }
    const string nomen ← _legere_textus(b, nomen_start, nomen_len)
    if nomen.length() ≡ 0 {
        throw variant WireMala {causa = "empty parameter name"}
    }
    if _habeat_solidum(nomen) or _habeat_solidum(possessor) {
        throw variant WireMala {causa = "reserved wire character in name or owner"}
    }
    const int data_off ← nomen_start + nomen_len
    if b.length() ≺ data_off + 4 {
        throw variant WireMala {causa = "truncated parameter data length"}
    }
    const int data_len ← _be4_lege(b, data_off)
    const int data_start ← data_off + 4
    if b.length() ≠ data_start + data_len {
        throw variant WireMala {causa = "malformed parameter payload"}
    }
    const string datos_textus ← _legere_textus(b, data_start, data_len)
    const int expect ← _quantitas(forma)
    const list<f32> datos ← _divido_datos(datos_textus, expect)
    return ParametrumWire {nomen = nomen, possessor = possessor, typo_nomen = typo, forma = forma, versio = versio, statio_nomen = statio_nomen, datos = datos}
}
