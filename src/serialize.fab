# Serialization contract — versioned bytes wire format (PML1-U7).
#
# Public import: importa ex "gradus:serialize" privata serializa
# Depends on: nothing (leaf module). Contract mirrors are documented in the
# header below (U2 dtype names, U3 shape ceilings, U5 identity rules).
#
# --- Contract ------------------------------------------------------------
#
# Schema: serialize-schema-1.0.0 (stamped 2026-08-08, PML1-U7). One versioned
# BYTES wire format (octeti carrier) that carries tensor / dtype / shape /
# parameter values and round-trips them. Consumers reject unknown schema
# versions and unknown kinds — no best-effort partial reads (capsule rule,
# PML0-U14).
#
# Wire format (all integers big-endian):
#
#   Header (4 bytes):
#     [0..2)  magic  0x53 0x46        ("SF")
#     [2]     schema 0x01             (wire schema version byte)
#     [3]     kind   0x01 dtype | 0x02 shape | 0x03 tensor | 0x04 parameter
#
#   dtype payload:     tag u8   (0=f32, 1=f16, 2=i32, 3=u8 — the four
#                      canonical dtype names of dtype-schema-1.0.0, U2)
#   shape payload:     rank u8, then rank × dim i64be (non-negative;
#                      rank ≤ 64 and dims/ceiling mirror gradus:shape U3)
#   tensor payload:    tag u8 | rank u8 | rank × dim i64be |
#                      data_len u32be | data (UTF-8 textus of space-separated
#                      float tokens, shortest round-trip form)
#   parameter payload: tag u8 | rank u8 | rank × dim i64be | versio i64be
#                      (≥ 1) | statio u8 (0=trainable, 1=frozen) |
#                      possessor_len u32be | possessor UTF-8 |
#                      nomen_len u32be | nomen UTF-8 |
#                      data_len u32be | data (as tensor)
#
# Field ordering is fixed; a deserializer must consume exactly the declared
# payload and rejects trailing bytes. Names/owners follow the U5 identity
# wire-safety rule ('/' reserved).
#
# Float payload encoding (language-surface fact): the language has no float
# bit-reinterpretation primitive, so float data is carried as shortest
# round-trip textus tokens (Rust-style f64 display/parse: lossless both
# ways, NaN/±Inf included). Integer fields are fixed-width binary. This is a
# drift candidate for the NGAB1 packet fact recheck (R1) — recorded here,
# not silently. Physical storage/bit-layout remains a host concern.
#
# Version rejection: a reader rejects an unknown magic, an unknown schema
# byte (VersioIgnota), or an unknown kind byte (GenusIgnotum) before
# touching the payload.
#
# Migration policy (feeds the PML6 package contract):
#   * the schema byte IS the version gate; any change to a field layout,
#     field encoding, or value semantics of a payload is a schema bump;
#   * backward-compatible additions (new trailing optional fields) bump the
#     minor schema version (1.0.0 → 1.1.0); breaking changes (reordered /
#     renumbered / repurposed fields or tags) bump the major (1.0.0 → 2.0.0);
#   * migration is WRITE-side: a new schema produces new bytes; old bytes are
#     never mutated in place, and a reader that does not know a schema byte
#     rejects rather than guessing. Downgrade/admission is a package-layer
#     (PML6) decision, not a wire-layer one.
#
# --- Compiler boundary notes ----------------------------------------------
#
#   * Public signatures stay on primitives (textus dtype names, flat lists,
#     octeti) plus this module's own genera (Tensum, ParametrumWire) so the
#     proba file-interface keeps every export (WARN014 — same seam as
#     parameter.fab U5).
#   * The dtype tag mapping mirrors dtype.fab U2's canonical names; the
#     shape ceilings (rank/dim/element) mirror gradus:shape U3; the
#     identity rules (name/owner wire-safety, versio ≥ 1, statio names)
#     mirror parameter.fab U5. All are documented mirrors, not imports, so
#     the module stays a dependency-free leaf.
#
# --- Seams ---------------------------------------------------------------
#   * package contract consumption of this schema — PML6.
#   * physical storage/bit-layout — hosts.
#   * capsule trust model over deserialized bytes — PML2 (no raw bytes as
#     trust anchor, C8).

# -------------------------------------------------------------------------
# Schema and wire constants. schema_versio is the public contract identity;
# the schema BYTE on the wire is its encoding (bump both together).
# -------------------------------------------------------------------------

fixum textus schema_versio ← "1.0.0"

fixum numerus MAGIC_0 ← 0x53
fixum numerus MAGIC_1 ← 0x46
fixum numerus SCHEMA_BYTE ← 0x01
fixum numerus KIND_DTYPE ← 0x01
fixum numerus KIND_FORMA ← 0x02
fixum numerus KIND_TENSOR ← 0x03
fixum numerus KIND_PARAMETRUM ← 0x04
fixum numerus TAG_F32 ← 0
fixum numerus TAG_F16 ← 1
fixum numerus TAG_I32 ← 2
fixum numerus TAG_U8 ← 3
fixum numerus STATIO_TRAINABILIS ← 0
fixum numerus STATIO_GELIDA ← 1
# Rank ceiling mirrors shape.GRADUS_LIMES (U3); u32 length ceiling mirrors
# the wire u32be length field.
fixum numerus RANK_LIMES ← 64
fixum numerus LONGITUDO_LIMES ← 4294967295

# -------------------------------------------------------------------------
# SerializeError — typed error vocabulary of the serialization contract.
# Every variant carries a textus causa (render via causa). Variant → class:
#   VersioIgnota — unknown magic / schema byte (version rejection).
#   GenusIgnotum — unknown kind byte.
#   TypoIgnotum  — unknown dtype name (serialize) or tag (deserialize).
#   FormaMala    — rank/dimension/element-count ceiling violations.
#   WireMala     — malformed bytes: truncation, bad length, invalid version
#                  / status / name rules, trailing bytes, bad UTF-8.
#   DataMala     — element-data failures: count mismatch, malformed tokens.
# -------------------------------------------------------------------------

discretio SerializeError {
    VersioIgnota { textus causa },
    GenusIgnotum { textus causa },
    TypoIgnotum { textus causa },
    FormaMala { textus causa },
    WireMala { textus causa },
    DataMala { textus causa }
}

functio causa(SerializeError e) → textus {
    discerne e {
        casu VersioIgnota fixum causa { redde causa }
        casu GenusIgnotum fixum causa { redde causa }
        casu TypoIgnotum fixum causa { redde causa }
        casu FormaMala fixum causa { redde causa }
        casu WireMala fixum causa { redde causa }
        casu DataMala fixum causa { redde causa }
    }
}

# -------------------------------------------------------------------------
# Result carriers — same-module genera so proba consumers can read a
# deserialized value through projections without WARN014 (compiler-lane
# seam; see header).
# -------------------------------------------------------------------------

# A deserialized tensor value: dtype nomen + runtime shape + flat data.
genus Tensum {
    textus typo_nomen
    lista<numerus> forma
    lista<f32> datos

    # Canonical dtype name (the dtype contract, U2).
    functio typo() → textus {
        redde ego.typo_nomen
    }

    # Runtime shape (dimension vector).
    functio figura() → lista<numerus> {
        redde ego.forma
    }

    # Flat row-major data.
    functio datos() → lista<f32> {
        redde ego.datos
    }
}

# A deserialized parameter value: full U5 identity + status + flat data.
genus ParametrumWire {
    textus nomen
    textus possessor
    textus typo_nomen
    lista<numerus> forma
    numerus versio
    textus statio_nomen
    lista<f32> datos

    # Parameter name (identity).
    functio nomen() → textus {
        redde ego.nomen
    }

    # Owner path (identity).
    functio possessor() → textus {
        redde ego.possessor
    }

    # Canonical dtype name (identity).
    functio typo() → textus {
        redde ego.typo_nomen
    }

    # Runtime shape (identity).
    functio figura() → lista<numerus> {
        redde ego.forma
    }

    # Mutation counter (identity).
    functio versio() → numerus {
        redde ego.versio
    }

    # Status nomen ("trainable" | "frozen").
    functio statium() → textus {
        redde ego.statio_nomen
    }

    # Flat row-major data (value).
    functio datos() → lista<f32> {
        redde ego.datos
    }
}

# -------------------------------------------------------------------------
# Private byte helpers. Encoding helpers assume validated inputs (non-
# negative; lengths ≤ u32 max; versions ≥ 1); decoding helpers assume the
# caller has validated bounds before reading.
# -------------------------------------------------------------------------

# octeti → byte list (parse cursor carrier).
@ privata
functio _octeti_lista(octeti o) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < o.longitudo() {
        out.appende(o.accipe(i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    redde out
}

# textus → UTF-8 byte list.
@ privata
functio _textus_bytes(textus s) → lista<numerus<u8>> {
    fixum octeti o ← s ↦ octeti
    redde _octeti_lista(o)
}

# u32 big-endian (n validated: 0 ≤ n < 2^32 by callers).
@ privata
functio _be4(numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    out.appende((n ⇒ 24) ↦ numerus<u8>)
    out.appende((n ⇒ 16) ↦ numerus<u8>)
    out.appende((n ⇒ 8) ↦ numerus<u8>)
    out.appende((n ⇒ 0) ↦ numerus<u8>)
    redde out
}

# i64 big-endian (n validated: 0 ≤ n < 2^63 by callers).
@ privata
functio _be8(numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    out.appende((n ⇒ 56) ↦ numerus<u8>)
    out.appende((n ⇒ 48) ↦ numerus<u8>)
    out.appende((n ⇒ 40) ↦ numerus<u8>)
    out.appende((n ⇒ 32) ↦ numerus<u8>)
    out.appende((n ⇒ 24) ↦ numerus<u8>)
    out.appende((n ⇒ 16) ↦ numerus<u8>)
    out.appende((n ⇒ 8) ↦ numerus<u8>)
    out.appende((n ⇒ 0) ↦ numerus<u8>)
    redde out
}

# u32 big-endian read at offset (bounds validated by callers).
@ privata
functio _le4(lista<numerus<u8>> b, numerus off) → numerus {
    fixum numerus r0 ← (b.accipe(off + 0) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r1 ← (b.accipe(off + 1) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r2 ← (b.accipe(off + 2) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r3 ← (b.accipe(off + 3) vel (0 ∷ numerus<u8>)) ↦ numerus
    redde r3 ∨ (r2 ⇐ 8) ∨ (r1 ⇐ 16) ∨ (r0 ⇐ 24)
}

# i64 big-endian read at offset. Callers must reject a lead byte ≥ 0x80
# (a negative / out-of-range value) before reading.
@ privata
functio _le8(lista<numerus<u8>> b, numerus off) → numerus {
    fixum numerus r0 ← (b.accipe(off + 0) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r1 ← (b.accipe(off + 1) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r2 ← (b.accipe(off + 2) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r3 ← (b.accipe(off + 3) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r4 ← (b.accipe(off + 4) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r5 ← (b.accipe(off + 5) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r6 ← (b.accipe(off + 6) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus r7 ← (b.accipe(off + 7) vel (0 ∷ numerus<u8>)) ↦ numerus
    redde r7 ∨ (r6 ⇐ 8) ∨ (r5 ⇐ 16) ∨ (r4 ⇐ 24) ∨ (r3 ⇐ 32) ∨ (r2 ⇐ 40) ∨ (r1 ⇐ 48) ∨ (r0 ⇐ 56)
}

# Wire header validation — returns the kind byte. Rejects unknown magic and
# unknown schema byte (version rejection) before any payload parsing.
@ privata
functio _caput(lista<numerus<u8>> b) → numerus ⇥ SerializeError {
    si b.longitudo() < 4 {
        iace finge WireMala { causa = "truncated header" }
    }
    fixum numerus m0 ← (b.accipe(0) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum numerus m1 ← (b.accipe(1) vel (0 ∷ numerus<u8>)) ↦ numerus
    si m0 ≠ MAGIC_0 aut m1 ≠ MAGIC_1 {
        iace finge VersioIgnota { causa = "unknown serialize magic" }
    }
    fixum numerus schema ← (b.accipe(2) vel (0 ∷ numerus<u8>)) ↦ numerus
    si schema ≠ SCHEMA_BYTE {
        iace finge VersioIgnota { causa = "unknown serialize schema version" }
    }
    redde (b.accipe(3) vel (0 ∷ numerus<u8>)) ↦ numerus
}

# Length-prefixed UTF-8 textus read; rejects truncation and bad UTF-8.
@ privata
functio _legere_textus(lista<numerus<u8>> b, numerus off, numerus len) → textus ⇥ SerializeError {
    si off + len > b.longitudo() {
        iace finge WireMala { causa = "truncated textus field" }
    }
    varia lista<numerus<u8>> sub ← vacua
    varia numerus i ← 0
    dum i < len {
        sub.appende(b.accipe(off + i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    fixum octeti o ← sub
    fac {
        fixum textus s ← o ↦ textus
        redde s
    }
    cape err {
        iace finge WireMala { causa = "invalid UTF-8 textus field" }
    }
    iace finge WireMala { causa = "unreachable" }
}

# Bounded element product for a shape — mirror of gradus:shape U3's
# quantitas/_productus (DIMENSI_LIMES 65536, ELEMENTA_LIMES 1_000_000_000,
# negative-dim rejection). One source of the shape wire's ceiling checks.
@ privata
functio _quantitas(lista<numerus> forma) → numerus ⇥ SerializeError {
    varia numerus product ← 1
    itera ex forma fixum dim {
        si dim < 0 {
            iace finge FormaMala { causa = "negative dimension" }
        }
        si dim > 65536 {
            iace finge FormaMala { causa = "dimension above ceiling" }
        }
        si dim > 0 {
            si product > 1000000000 / dim {
                iace finge FormaMala { causa = "element count above ceiling" }
            }
            product ← product * dim
        }
        secus {
            product ← 0
        }
    }
    redde product
}

# Rank ceiling check (mirrors shape.GRADUS_LIMES; the wire rank field is u8).
@ privata
functio _gradus(lista<numerus> forma) → numerus ⇥ SerializeError {
    fixum numerus rank ← forma.longitudo()
    si rank > RANK_LIMES {
        iace finge FormaMala { causa = "rank above ceiling" }
    }
    redde rank
}

# Flat float data → space-separated shortest-round-trip textus.
@ privata
functio _iunge_datos(lista<f32> datos) → textus {
    varia textus out ← ""
    varia numerus i ← 0
    dum i < datos.longitudo() {
        si i > 0 {
            out ← out + " "
        }
        fixum f32 v ← datos.accipe(i) vel 0.0
        out ← out + (v ↦ textus)
        i ← i + 1
    }
    redde out
}

# Space-separated float textus → flat data, count-checked against the
# shape product. Empty textus round-trips an empty data list only when the
# shape expects zero elements (fail-closed otherwise).
@ privata
functio _divido_datos(textus datos_textus, numerus expect) → lista<f32> ⇥ SerializeError {
    si datos_textus.longitudo() ≡ 0 {
        si expect ≡ 0 {
            fixum lista<f32> nil ← vacua
            redde nil
        }
        secus {
            iace finge DataMala { causa = "missing element data" }
        }
    }
    fixum lista<textus> tokens ← datos_textus.divide(" ")
    si tokens.longitudo() ≠ expect {
        iace finge DataMala { causa = "element count mismatch in serialized data" }
    }
    varia lista<f32> out ← vacua
    itera ex tokens fixum tok {
        si tok.longitudo() ≡ 0 {
            iace finge DataMala { causa = "malformed float token" }
        }
        fac {
            fixum f32 v ← tok ↦ f32
            out.appende(v)
        }
        cape err {
            iace finge DataMala { causa = "malformed float token" }
        }
    }
    redde out
}

# Canonical dtype name → wire tag. Mirrors dtype.fab U2's canonical names
# and its unknown-name error identity.
@ privata
functio _tag_a(textus nomen) → numerus ⇥ SerializeError {
    si nomen ≡ "f32" ergo redde TAG_F32
    si nomen ≡ "f16" ergo redde TAG_F16
    si nomen ≡ "i32" ergo redde TAG_I32
    si nomen ≡ "u8" ergo redde TAG_U8
    iace finge TypoIgnotum { causa = "unknown dtype name: " + nomen }
}

# Wire tag → canonical dtype name.
@ privata
functio _nomen_a_tag(numerus tag) → textus ⇥ SerializeError {
    si tag ≡ TAG_F32 ergo redde "f32"
    si tag ≡ TAG_F16 ergo redde "f16"
    si tag ≡ TAG_I32 ergo redde "i32"
    si tag ≡ TAG_U8 ergo redde "u8"
    iace finge TypoIgnotum { causa = "unknown dtype tag" }
}

# "/" is reserved in parameter names/owners (U5 identity wire-safety rule,
# mirrored here so the bytes contract cannot admit an identity U5 rejects).
@ privata
functio _habeat_solidum(textus s) → bivalens {
    varia numerus i ← 0
    dum i < s.longitudo() {
        si s.accipe(i) ≡ "/" ergo redde verum
        i ← i + 1
    }
    redde falsum
}

# -------------------------------------------------------------------------
# Serialization — values → versioned bytes.
# -------------------------------------------------------------------------

functio serializa_dtype(textus typo_nomen) → octeti ⇥ SerializeError {
    fixum numerus tag ← _tag_a(typo_nomen)
    varia lista<numerus<u8>> buf ← vacua
    buf.appende(MAGIC_0 ↦ numerus<u8>)
    buf.appende(MAGIC_1 ↦ numerus<u8>)
    buf.appende(SCHEMA_BYTE ↦ numerus<u8>)
    buf.appende(KIND_DTYPE ↦ numerus<u8>)
    buf.appende(tag ↦ numerus<u8>)
    fixum octeti wire ← buf
    redde wire
}

functio serializa_shape(lista<numerus> forma) → octeti ⇥ SerializeError {
    fixum numerus rank ← _gradus(forma)
    varia lista<numerus<u8>> buf ← vacua
    buf.appende(MAGIC_0 ↦ numerus<u8>)
    buf.appende(MAGIC_1 ↦ numerus<u8>)
    buf.appende(SCHEMA_BYTE ↦ numerus<u8>)
    buf.appende(KIND_FORMA ↦ numerus<u8>)
    buf.appende(rank ↦ numerus<u8>)
    # Per-dim validation mirrors shape._productus (U3 ceilings) during the
    # single encode pass — negative and ceiling-violating dims fail closed.
    varia numerus product ← 1
    itera ex forma fixum dim {
        si dim < 0 {
            iace finge FormaMala { causa = "negative dimension" }
        }
        si dim > 65536 {
            iace finge FormaMala { causa = "dimension above ceiling" }
        }
        si dim > 0 {
            si product > 1000000000 / dim {
                iace finge FormaMala { causa = "element count above ceiling" }
            }
            product ← product * dim
        }
        secus {
            product ← 0
        }
        fixum lista<numerus<u8>> enc ← _be8(dim)
        itera ex enc fixum byte {
            buf.appende(byte)
        }
    }
    fixum octeti wire ← buf
    redde wire
}

functio serializa_tensor(lista<f32> datos, lista<numerus> forma, textus typo_nomen) → octeti ⇥ SerializeError {
    fixum numerus tag ← _tag_a(typo_nomen)
    fixum numerus rank ← _gradus(forma)
    fixum numerus expect ← _quantitas(forma)
    si datos.longitudo() ≠ expect {
        iace finge DataMala { causa = "element count mismatch" }
    }
    fixum textus datos_textus ← _iunge_datos(datos)
    fixum numerus data_len ← datos_textus.longitudo()
    si data_len > LONGITUDO_LIMES {
        iace finge DataMala { causa = "serialized data too large" }
    }
    varia lista<numerus<u8>> buf ← vacua
    buf.appende(MAGIC_0 ↦ numerus<u8>)
    buf.appende(MAGIC_1 ↦ numerus<u8>)
    buf.appende(SCHEMA_BYTE ↦ numerus<u8>)
    buf.appende(KIND_TENSOR ↦ numerus<u8>)
    buf.appende(tag ↦ numerus<u8>)
    buf.appende(rank ↦ numerus<u8>)
    itera ex forma fixum dim {
        fixum lista<numerus<u8>> enc ← _be8(dim)
        itera ex enc fixum byte {
            buf.appende(byte)
        }
    }
    fixum lista<numerus<u8>> data_len_enc ← _be4(data_len)
    itera ex data_len_enc fixum byte {
        buf.appende(byte)
    }
    fixum lista<numerus<u8>> data_bytes ← _textus_bytes(datos_textus)
    itera ex data_bytes fixum byte {
        buf.appende(byte)
    }
    fixum octeti wire ← buf
    redde wire
}

functio serializa_parametrum(textus nomen, textus possessor, textus typo_nomen, lista<numerus> forma, numerus versio, textus statio_nomen, lista<f32> datos) → octeti ⇥ SerializeError {
    si nomen.longitudo() ≡ 0 {
        iace finge WireMala { causa = "empty parameter name" }
    }
    si possessor.longitudo() ≡ 0 {
        iace finge WireMala { causa = "empty parameter owner" }
    }
    si _habeat_solidum(nomen) aut _habeat_solidum(possessor) {
        iace finge WireMala { causa = "reserved wire character in name or owner" }
    }
    si nomen.longitudo() > LONGITUDO_LIMES aut possessor.longitudo() > LONGITUDO_LIMES {
        iace finge WireMala { causa = "serialized name too large" }
    }
    si versio < 1 {
        iace finge WireMala { causa = "invalid parameter version" }
    }
    varia numerus statio ← STATIO_TRAINABILIS
    si statio_nomen ≡ "trainable" {
        statio ← STATIO_TRAINABILIS
    }
    secus {
        si statio_nomen ≡ "frozen" {
            statio ← STATIO_GELIDA
        }
        secus {
            iace finge WireMala { causa = "unknown parameter status" }
        }
    }
    fixum numerus tag ← _tag_a(typo_nomen)
    fixum numerus rank ← _gradus(forma)
    fixum numerus expect ← _quantitas(forma)
    si datos.longitudo() ≠ expect {
        iace finge DataMala { causa = "element count mismatch" }
    }
    fixum textus datos_textus ← _iunge_datos(datos)
    fixum numerus data_len ← datos_textus.longitudo()
    si data_len > LONGITUDO_LIMES {
        iace finge DataMala { causa = "serialized data too large" }
    }
    varia lista<numerus<u8>> buf ← vacua
    buf.appende(MAGIC_0 ↦ numerus<u8>)
    buf.appende(MAGIC_1 ↦ numerus<u8>)
    buf.appende(SCHEMA_BYTE ↦ numerus<u8>)
    buf.appende(KIND_PARAMETRUM ↦ numerus<u8>)
    buf.appende(tag ↦ numerus<u8>)
    buf.appende(rank ↦ numerus<u8>)
    itera ex forma fixum dim {
        fixum lista<numerus<u8>> enc ← _be8(dim)
        itera ex enc fixum byte {
            buf.appende(byte)
        }
    }
    fixum lista<numerus<u8>> versio_enc ← _be8(versio)
    itera ex versio_enc fixum byte {
        buf.appende(byte)
    }
    buf.appende(statio ↦ numerus<u8>)
    fixum lista<numerus<u8>> possessor_len ← _be4(possessor.longitudo())
    itera ex possessor_len fixum byte {
        buf.appende(byte)
    }
    fixum lista<numerus<u8>> possessor_bytes ← _textus_bytes(possessor)
    itera ex possessor_bytes fixum byte {
        buf.appende(byte)
    }
    fixum lista<numerus<u8>> nomen_len ← _be4(nomen.longitudo())
    itera ex nomen_len fixum byte {
        buf.appende(byte)
    }
    fixum lista<numerus<u8>> nomen_bytes ← _textus_bytes(nomen)
    itera ex nomen_bytes fixum byte {
        buf.appende(byte)
    }
    fixum lista<numerus<u8>> data_len_enc ← _be4(data_len)
    itera ex data_len_enc fixum byte {
        buf.appende(byte)
    }
    fixum lista<numerus<u8>> data_bytes ← _textus_bytes(datos_textus)
    itera ex data_bytes fixum byte {
        buf.appende(byte)
    }
    fixum octeti wire ← buf
    redde wire
}

# -------------------------------------------------------------------------
# Deserialization — versioned bytes → values. Every path validates the
# header first (version rejection), then consumes exactly the declared
# payload and rejects trailing bytes.
# -------------------------------------------------------------------------

functio deserializa_dtype(octeti wire) → textus ⇥ SerializeError {
    fixum lista<numerus<u8>> b ← _octeti_lista(wire)
    fixum numerus kind ← _caput(b)
    si kind ≠ KIND_DTYPE {
        iace finge GenusIgnotum { causa = "unknown serialize kind" }
    }
    si b.longitudo() ≠ 5 {
        iace finge WireMala { causa = "malformed dtype payload" }
    }
    fixum numerus tag ← (b.accipe(4) vel (0 ∷ numerus<u8>)) ↦ numerus
    redde _nomen_a_tag(tag)
}

functio deserializa_shape(octeti wire) → lista<numerus> ⇥ SerializeError {
    fixum lista<numerus<u8>> b ← _octeti_lista(wire)
    fixum numerus kind ← _caput(b)
    si kind ≠ KIND_FORMA {
        iace finge GenusIgnotum { causa = "unknown serialize kind" }
    }
    si b.longitudo() < 5 {
        iace finge WireMala { causa = "truncated shape payload" }
    }
    fixum numerus rank ← (b.accipe(4) vel (0 ∷ numerus<u8>)) ↦ numerus
    si rank > RANK_LIMES {
        iace finge FormaMala { causa = "rank above ceiling" }
    }
    si b.longitudo() ≠ 5 + rank * 8 {
        iace finge WireMala { causa = "malformed shape payload" }
    }
    varia lista<numerus> out ← vacua
    varia numerus i ← 0
    dum i < rank {
        fixum numerus lead ← (b.accipe(5 + i * 8) vel (0 ∷ numerus<u8>)) ↦ numerus
        si lead ≥ 128 {
            iace finge FormaMala { causa = "negative dimension" }
        }
        fixum numerus dim ← _le8(b, 5 + i * 8)
        si dim > 65536 {
            iace finge FormaMala { causa = "dimension above ceiling" }
        }
        out.appende(dim)
        i ← i + 1
    }
    redde out
}

functio deserializa_tensor(octeti wire) → Tensum ⇥ SerializeError {
    fixum lista<numerus<u8>> b ← _octeti_lista(wire)
    fixum numerus kind ← _caput(b)
    si kind ≠ KIND_TENSOR {
        iace finge GenusIgnotum { causa = "unknown serialize kind" }
    }
    si b.longitudo() < 6 {
        iace finge WireMala { causa = "truncated tensor payload" }
    }
    fixum numerus tag ← (b.accipe(4) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum textus typo ← _nomen_a_tag(tag)
    fixum numerus rank ← (b.accipe(5) vel (0 ∷ numerus<u8>)) ↦ numerus
    si rank > RANK_LIMES {
        iace finge FormaMala { causa = "rank above ceiling" }
    }
    fixum numerus dims_off ← 6
    varia lista<numerus> forma ← vacua
    varia numerus i ← 0
    dum i < rank {
        fixum numerus lead ← (b.accipe(dims_off + i * 8) vel (0 ∷ numerus<u8>)) ↦ numerus
        si lead ≥ 128 {
            iace finge FormaMala { causa = "negative dimension" }
        }
        fixum numerus dim ← _le8(b, dims_off + i * 8)
        si dim > 65536 {
            iace finge FormaMala { causa = "dimension above ceiling" }
        }
        forma.appende(dim)
        i ← i + 1
    }
    fixum numerus data_off ← dims_off + rank * 8
    si b.longitudo() < data_off + 4 {
        iace finge WireMala { causa = "truncated tensor data length" }
    }
    fixum numerus data_len ← _le4(b, data_off)
    fixum numerus data_start ← data_off + 4
    si b.longitudo() ≠ data_start + data_len {
        iace finge WireMala { causa = "malformed tensor payload" }
    }
    fixum textus datos_textus ← _legere_textus(b, data_start, data_len)
    fixum numerus expect ← _quantitas(forma)
    fixum lista<f32> datos ← _divido_datos(datos_textus, expect)
    redde Tensum { typo_nomen = typo, forma = forma, datos = datos }
}

functio deserializa_parametrum(octeti wire) → ParametrumWire ⇥ SerializeError {
    fixum lista<numerus<u8>> b ← _octeti_lista(wire)
    fixum numerus kind ← _caput(b)
    si kind ≠ KIND_PARAMETRUM {
        iace finge GenusIgnotum { causa = "unknown serialize kind" }
    }
    si b.longitudo() < 6 {
        iace finge WireMala { causa = "truncated parameter payload" }
    }
    fixum numerus tag ← (b.accipe(4) vel (0 ∷ numerus<u8>)) ↦ numerus
    fixum textus typo ← _nomen_a_tag(tag)
    fixum numerus rank ← (b.accipe(5) vel (0 ∷ numerus<u8>)) ↦ numerus
    si rank > RANK_LIMES {
        iace finge FormaMala { causa = "rank above ceiling" }
    }
    fixum numerus dims_off ← 6
    varia lista<numerus> forma ← vacua
    varia numerus i ← 0
    dum i < rank {
        fixum numerus lead ← (b.accipe(dims_off + i * 8) vel (0 ∷ numerus<u8>)) ↦ numerus
        si lead ≥ 128 {
            iace finge FormaMala { causa = "negative dimension" }
        }
        fixum numerus dim ← _le8(b, dims_off + i * 8)
        si dim > 65536 {
            iace finge FormaMala { causa = "dimension above ceiling" }
        }
        forma.appende(dim)
        i ← i + 1
    }
    fixum numerus versio_off ← dims_off + rank * 8
    si b.longitudo() < versio_off + 13 {
        iace finge WireMala { causa = "truncated parameter fields" }
    }
    fixum numerus versio_lead ← (b.accipe(versio_off) vel (0 ∷ numerus<u8>)) ↦ numerus
    si versio_lead ≥ 128 {
        iace finge WireMala { causa = "invalid version in serialized parameter" }
    }
    fixum numerus versio ← _le8(b, versio_off)
    si versio < 1 {
        iace finge WireMala { causa = "invalid version in serialized parameter" }
    }
    fixum numerus statio ← (b.accipe(versio_off + 8) vel (0 ∷ numerus<u8>)) ↦ numerus
    varia textus statio_nomen ← ""
    si statio ≡ STATIO_TRAINABILIS {
        statio_nomen ← "trainable"
    }
    secus {
        si statio ≡ STATIO_GELIDA {
            statio_nomen ← "frozen"
        }
        secus {
            iace finge WireMala { causa = "unknown parameter status" }
        }
    }
    fixum numerus poss_off ← versio_off + 9
    si b.longitudo() < poss_off + 4 {
        iace finge WireMala { causa = "truncated parameter owner" }
    }
    fixum numerus possessor_len ← _le4(b, poss_off)
    fixum numerus possessor_start ← poss_off + 4
    si b.longitudo() < possessor_start + possessor_len {
        iace finge WireMala { causa = "truncated parameter owner" }
    }
    fixum textus possessor ← _legere_textus(b, possessor_start, possessor_len)
    si possessor.longitudo() ≡ 0 {
        iace finge WireMala { causa = "empty parameter owner" }
    }
    fixum numerus nomen_off ← possessor_start + possessor_len
    si b.longitudo() < nomen_off + 4 {
        iace finge WireMala { causa = "truncated parameter name" }
    }
    fixum numerus nomen_len ← _le4(b, nomen_off)
    fixum numerus nomen_start ← nomen_off + 4
    si b.longitudo() < nomen_start + nomen_len {
        iace finge WireMala { causa = "truncated parameter name" }
    }
    fixum textus nomen ← _legere_textus(b, nomen_start, nomen_len)
    si nomen.longitudo() ≡ 0 {
        iace finge WireMala { causa = "empty parameter name" }
    }
    si _habeat_solidum(nomen) aut _habeat_solidum(possessor) {
        iace finge WireMala { causa = "reserved wire character in name or owner" }
    }
    fixum numerus data_off ← nomen_start + nomen_len
    si b.longitudo() < data_off + 4 {
        iace finge WireMala { causa = "truncated parameter data length" }
    }
    fixum numerus data_len ← _le4(b, data_off)
    fixum numerus data_start ← data_off + 4
    si b.longitudo() ≠ data_start + data_len {
        iace finge WireMala { causa = "malformed parameter payload" }
    }
    fixum textus datos_textus ← _legere_textus(b, data_start, data_len)
    fixum numerus expect ← _quantitas(forma)
    fixum lista<f32> datos ← _divido_datos(datos_textus, expect)
    redde ParametrumWire {
        nomen = nomen,
        possessor = possessor,
        typo_nomen = typo,
        forma = forma,
        versio = versio,
        statio_nomen = statio_nomen,
        datos = datos
    }
}
