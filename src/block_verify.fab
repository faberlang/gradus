# Typed cached-block request/result contract — SD2-U1
#
# Public import: import from "gradus:block_verify" block_verify
#
# This leaf owns structural admission and value carriers only. It does not
# evaluate candidates, import a model, stage a branch, or choose an acceptance
# policy. The checkpoint remains the cache_branch identity and state carrier.

import from "gradus:cache/kv" kv

import from "gradus:cache/identity" cache_ident

import from "gradus:cache_branch" cache_branch

import from "gradus:attention/rope" rope

import from "gradus:dtype" dtype

import from "gradus:model/dense" dense

import from "gradus:speculative" speculative

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# VerifyError — typed vocabulary local to the block-verification leaf.
# Every structural reject carries a text message rendered by message().
# -------------------------------------------------------------------------

@ public
union VerifyError {
    @ shared
    string message

    EmptyPrefix,
    EmptyCandidates,
    CapacityOverflow,
    NegativeToken,
    ModelMismatch,
    ForwardFailure,
    TransactionFailure,
    ResultBounds
}

@ conversion
fn from_dense_error(dense.DenseError err) → VerifyError {
    match err {
        case dense.DenseError.IndexOutOfBounds const message {
            return variant ModelMismatch { message = "candidate token id is outside model vocabulary" }
        }
        case dense.DenseError.Overflow const message {
            return variant ModelMismatch { message = message }
        }
        case dense.DenseError.Gap const message {
            return variant ModelMismatch { message = message }
        }
        case _ {
            return variant ForwardFailure { message = err.message }
        }
    }
}

@ conversion
fn from_branch_error(cache_branch.BranchError err) → VerifyError {
    match err {
        case cache_branch.BranchError.CandidateNumeric const message {
            return variant ResultBounds { message = message }
        }
        case _ {
            return variant TransactionFailure { message = err.message }
        }
    }
}

# -------------------------------------------------------------------------
# BlockRequest — an admitted nonempty-prefix candidate block.
# -------------------------------------------------------------------------

@ public
class BlockRequest {
    cache_branch.KVCheckpoint checkpoint
    list<int> candidate_ids


    fn prefix_length() → int {
        return self.checkpoint.prefix_length
    }

    fn candidate_count() → int {
        return self.candidate_ids.length()
    }

    fn remaining_capacity() → int {
        const kv.KVCache layer ← self.checkpoint.layers.get(0) coalesce kv.default()
        return layer.capacity - self.checkpoint.prefix_length
    }
}

# Placeholder for `var BlockRequest` bindings. It is not an admitted request.
@ public
fn default_request() → BlockRequest {
    return BlockRequest { checkpoint = cache_branch.default(), candidate_ids = empty }
}

@ public
fn request_equal(BlockRequest a, BlockRequest b) → bool {
    if not cache_branch.checkpoint_equal(a.checkpoint, b.checkpoint) then return false
    return a.candidate_ids ≡ b.candidate_ids
}

fn request_capacity(cache_branch.KVCheckpoint checkpoint) → int {
    const kv.KVCache first ← checkpoint.layers.get(0) coalesce kv.default()
    return checkpoint.layers.reduce((int acc, kv.KVCache layer) ∴ (layer.capacity - checkpoint.prefix_length).minimum(acc), first.capacity - checkpoint.prefix_length)
}

# Structural admission is complete before any forward or model call can be
# made by a consumer. The checkpoint is immutable, so every reject leaves the
# caller's value available for checkpoint_equal comparison.
@ public
fn construct_request(cache_branch.KVCheckpoint checkpoint, list<int> candidate_ids) → BlockRequest ⇥ VerifyError {
    require checkpoint.prefix_length ≥ 1 throw variant EmptyPrefix { message = "block request prefix must be non-empty" }
    require candidate_ids.length() ≥ 1 throw variant EmptyCandidates { message = "candidate block must not be empty" }
    for from candidate_ids const token_id {
        require token_id ≥ 0 throw variant NegativeToken { message = "candidate token id must be non-negative" }
    }
    require candidate_ids.length() ≤ request_capacity(checkpoint) throw variant CapacityOverflow { message = "candidate block exceeds remaining cache capacity" }
    return BlockRequest { checkpoint = checkpoint, candidate_ids = candidate_ids }
}

# -------------------------------------------------------------------------
# BlockRows — the value-level result of a future reference forward.
# Positions are the target rows L..L+k-1. `logits` is [k, V]; each layer's
# candidate key/payload tensor is [k, dim]. This constructor validates only
# carrier shape and bounds; it performs no forward work.
# -------------------------------------------------------------------------

@ public
class BlockRows {
    BlockRequest request
    list<int> target_positions
    tensor.NumericBlock logits
    list<tensor.NumericBlock> candidate_keys
    list<tensor.NumericBlock> candidate_payloads


    fn row_count() → int {
        return self.target_positions.length()
    }
}

@ public
fn default_rows() → BlockRows {
    return BlockRows { request = default_request(), target_positions = empty, logits = tensor.default(), candidate_keys = empty, candidate_payloads = empty }
}

fn tensor_equal(tensor.NumericBlock a, tensor.NumericBlock b) → bool {
    if dtype.name(a.dtype) ≠ dtype.name(b.dtype) then return false
    if not (a.shape ≡ b.shape) then return false
    return a.data ≡ b.data
}

@ public
fn rows_equal(BlockRows a, BlockRows b) → bool {
    # Keep: pairwise staged-tensor equality with early return on the first
    # mismatch; per-index `get(i) coalesce` gathers across four parallel
    # lists. No zip/equality construct covers staged NumericBlock carriers.
    if not request_equal(a.request, b.request) then return false
    if not (a.target_positions ≡ b.target_positions) then return false
    if not tensor_equal(a.logits, b.logits) then return false
    if a.candidate_keys.length() ≠ b.candidate_keys.length() then return false
    if a.candidate_payloads.length() ≠ b.candidate_payloads.length() then return false
    for range 0 ‥ a.candidate_keys.length() const i {
        const tensor.NumericBlock left_key ← a.candidate_keys.get(i) coalesce tensor.default()
        const tensor.NumericBlock right_key ← b.candidate_keys.get(i) coalesce tensor.default()
        const tensor.NumericBlock left_payload ← a.candidate_payloads.get(i) coalesce tensor.default()
        const tensor.NumericBlock right_payload ← b.candidate_payloads.get(i) coalesce tensor.default()
        if not tensor_equal(left_key, right_key) then return false
        if not tensor_equal(left_payload, right_payload) then return false
    }
    return true
}

fn expected_positions(int prefix, int rows) → list<int> {
    # Keep: transform of a range source; `.map` covers collections, not
    # `for range` operands.
    var list<int> positions ← empty
    for range prefix ‥ prefix + rows const position {
        positions.append(position)
    }
    return positions
}

fn valid_f32_rows(tensor.NumericBlock value, list<int> expected_shape) → bool ⇥ VerifyError {
    require value.valid() throw variant ResultBounds { message = "result tensor is not a valid value" }
    require dtype.name(value.dtype) ≡ "f32" throw variant ResultBounds { message = "result tensor dtype must be f32" }
    require value.shape ≡ expected_shape throw variant ResultBounds { message = "result tensor shape does not match the block" }
    return true
}

# Construct a forward result only after the caller supplies a valid admitted
# request. The checks reject malformed result values without touching the
# request checkpoint.
@ public
fn construct_rows(BlockRequest request, list<int> target_positions, tensor.NumericBlock logits, list<tensor.NumericBlock> candidate_keys, list<tensor.NumericBlock> candidate_payloads) → BlockRows ⇥ VerifyError {
    # Keep: each row/layer is validated (count, shape, dtype) in first-failure
    # order before construction; a map/reduce cannot carry the typed failure
    # boundary.
    # --- row/position admission (fail closed) --------------------------------
    const int rows ← target_positions.length()
    require rows ≥ 1 and rows ≤ request.candidate_count() throw variant ResultBounds { message = "result row count is outside candidate block" }
    require target_positions ≡ expected_positions(request.prefix_length(), rows) throw variant ResultBounds { message = "result positions do not start at the checkpoint prefix" }
    # --- logits admission (fail closed) --------------------------------------
    require logits.rank() ≡ 2 throw variant ResultBounds { message = "result logits must be rank two" }
    const list<int> logits_shape ← logits.shape
    const int vocab ← logits_shape.get(1) coalesce 0
    require vocab ≥ 1 throw variant ResultBounds { message = "result logits vocabulary width must be positive" }
    valid_f32_rows(logits, [rows, vocab])
    # --- per-layer K/V admission (fail closed) -------------------------------
    const int layer_count ← request.checkpoint.layers.length()
    require layer_count ≥ 1 throw variant ResultBounds { message = "result requires at least one checkpoint layer" }
    require candidate_keys.length() ≡ layer_count throw variant ResultBounds { message = "result K layer count does not match checkpoint" }
    require candidate_payloads.length() ≡ layer_count throw variant ResultBounds { message = "result V layer count does not match checkpoint" }
    for range 0 ‥ layer_count const i {
        const kv.KVCache layer ← request.checkpoint.layers.get(i) coalesce kv.default()
        const tensor.NumericBlock key ← candidate_keys.get(i) coalesce tensor.default()
        const tensor.NumericBlock payload ← candidate_payloads.get(i) coalesce tensor.default()
        valid_f32_rows(key, [rows, layer.dimension])
        valid_f32_rows(payload, [rows, layer.dimension])
    }
    return BlockRows { request = request, target_positions = target_positions, logits = logits, candidate_keys = candidate_keys, candidate_payloads = candidate_payloads }
}

# -------------------------------------------------------------------------
# Reference forward — consume the admitted request through the additive
# dense multi-row cached seam. All model-relative checks happen before the
# first candidate row is constructed; dense and tensor failures are mapped
# into this leaf's typed vocabulary without importing a device surface.
# -------------------------------------------------------------------------

fn finite_value(tensor.NumericBlock value) → bool {
    if not value.valid() then return false
    return value.data.all(f32 item ∴ dtype.finite(item))
}

fn admit_model(BlockRequest request, dense.DenseConfig cfg) → bool ⇥ VerifyError {
    # Keep: model admission is a failable per-layer/per-token require chain in
    # first-failure order; no covering construct carries the typed boundary.
    require cfg.layers ≥ 1 throw variant ModelMismatch { message = "model must have at least one layer" }
    require cfg.vocab ≥ 1 throw variant ModelMismatch { message = "model vocabulary must be positive" }
    require cfg.kv_heads ≥ 1 and cfg.head_dim ≥ 1 throw variant ModelMismatch { message = "model KV dimensions must be positive" }
    require cfg.layers ≡ request.checkpoint.layers.length() throw variant ModelMismatch { message = "cache layer count must equal model layer count" }
    const int dimension ← cfg.kv_heads * cfg.head_dim
    for from request.candidate_ids const token_id {
        require token_id ≥ 0 and token_id ≺ cfg.vocab throw variant ModelMismatch { message = "candidate token id is outside model vocabulary" }
    }
    for from request.checkpoint.layers const layer {
        require layer.dtype ≡ "f32" throw variant ModelMismatch { message = "cache dtype must be f32" }
        require layer.dimension ≡ dimension throw variant ModelMismatch { message = "cache dimension does not match model KV width" }
        require layer.key.shape ≡ ([request.prefix_length(), dimension] ↦ list<int>) throw variant ModelMismatch { message = "cache key shape does not match the admitted prefix" }
        require layer.payload.shape ≡ ([request.prefix_length(), dimension] ↦ list<int>) throw variant ModelMismatch { message = "cache value shape does not match the admitted prefix" }
        require finite_value(layer.key) throw variant ModelMismatch { message = "cache contains non-finite values" }
        require finite_value(layer.payload) throw variant ModelMismatch { message = "cache contains non-finite values" }
    }
    return true
}

fn candidate_rows(tensor.NumericBlock full, int prefix, int rows, int dimension) → tensor.NumericBlock ⇥ VerifyError {
    # Keep: the row/column gather is index-space (row * dimension + column
    # into the staged carrier); no map construct covers an index-space gather
    # over a range source.
    require full.valid() throw variant ForwardFailure { message = "dense forward returned an invalid cache tensor" }
    require dtype.name(full.dtype) ≡ "f32" throw variant ModelMismatch { message = "dense forward cache dtype must be f32" }
    require full.shape ≡ ([prefix + rows, dimension] ↦ list<int>) throw variant ForwardFailure { message = "dense forward cache shape does not match the candidate block" }
    var list<f32> data ← empty
    for range prefix ‥ prefix + rows const row {
        for range 0 ‥ dimension const column {
            data.append(full.data.get(row * dimension + column) coalesce 0.0 ∷ f32)
        }
    }
    var tensor.NumericBlock out ← tensor.default()
    do {
        out ← tensor.construct(data, [rows, dimension])
    }
    catch err {
        throw variant ForwardFailure { message = "dense forward candidate rows are not a valid tensor" }
    }
    require finite_value(out) throw variant ModelMismatch { message = "dense forward produced non-finite candidate K/V values" }
    return out
}

# `row i` is the dense cached result at absolute position L+i, with candidate
# i's K/V written at that same position. The dense seam itself preserves the
# lower attention primitive's causal prefix + through-row convention.
@ public
fn forward(BlockRequest request, dense.DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, f32 epsilon, f32 scale, int rope_dim, rope.RopeConfig rope_cfg) → BlockRows ⇥ VerifyError {
    # --- model admission (fail closed) ---------------------------------------
    admit_model(request, cfg)
    const int rows ← request.candidate_count()
    const int prefix ← request.prefix_length()
    # --- dense forward -------------------------------------------------------
    const dense.DenseStep step ← dense.decode_block(cfg, source, request.candidate_ids, epsilon, scale, rope_dim, rope_cfg, request.checkpoint.layers)
    const tensor.NumericBlock logits ← step.logits
    require finite_value(logits) throw variant ModelMismatch { message = "dense forward produced non-finite logits" }
    const int dimension ← cfg.kv_heads * cfg.head_dim
    # --- candidate K/V gather ------------------------------------------------
    require step.layers.length() ≡ cfg.layers throw variant ForwardFailure { message = "dense forward returned the wrong layer count" }
    var list<tensor.NumericBlock> keys ← empty
    var list<tensor.NumericBlock> payloads ← empty
    for from step.layers const state {
        keys.append(candidate_rows(state.key, prefix, rows, dimension))
        payloads.append(candidate_rows(state.payload, prefix, rows, dimension))
    }
    return construct_rows(request, expected_positions(prefix, rows), logits, keys, payloads)
}

# -------------------------------------------------------------------------
# Atomic staging and commit — compose the landed SD1 transaction only.
# Candidate K/V rows are copied into a CandidateBlock by cache_branch.begin,
# which materializes the private all-layer branch before any caller state is
# eligible for commit. The public commit wrapper calls commit_transaction;
# this leaf never appends or extends a shared cache directly.
# -------------------------------------------------------------------------

fn candidate_block(BlockRows rows) → cache_branch.CandidateBlock ⇥ VerifyError {
    const BlockRequest request ← rows.request
    require rows.row_count() ≡ request.candidate_count() throw variant ResultBounds { message = "staged rows do not cover the candidate block" }
    require rows.candidate_keys.length() ≡ request.checkpoint.layers.length() throw variant ResultBounds { message = "staged K layers do not match the checkpoint" }
    require rows.candidate_payloads.length() ≡ request.checkpoint.layers.length() throw variant ResultBounds { message = "staged V layers do not match the checkpoint" }
    return cache_branch.construct_block(request.candidate_ids, rows.candidate_keys, rows.candidate_payloads)
}

@ public
fn stage(BlockRows rows) → cache_branch.BranchHandle ⇥ VerifyError {
    const cache_branch.CandidateBlock block ← candidate_block(rows)
    return cache_branch.begin(rows.request.checkpoint, block)
}

@ public
fn commit_staged(cache_branch.KVCheckpoint current, cache_branch.BranchHandle handle, int accepted_count) → cache_branch.KVCheckpoint ⇥ VerifyError {
    return cache_branch.commit_transaction(current, handle, accepted_count)
}

@ public
fn abort_staged(cache_branch.BranchHandle handle) → cache_branch.KVCheckpoint {
    return cache_branch.abort(handle)
}

# -------------------------------------------------------------------------
# Full-recompute oracle — SD2-U4. From fresh empty caches the oracle
# scalar-replays the same prefix (prefill), then the candidate block one
# token at a time through the scalar cached seam, collecting the target
# rows at L..L+k-1 and the final per-layer states. The replay is the
# independent authority for the U2 row convention; oracle_equal compares
# a block result against it within the pinned 1e-5 reference epsilon and
# never widens the tolerance locally.
# -------------------------------------------------------------------------

@ public
class OracleTrace {
    BlockRows rows
    list<kv.KVCache> final_layers
}

@ public
fn default_trace() → OracleTrace {
    return OracleTrace { rows = default_rows(), final_layers = empty }
}

fn oracle_empty_layers(cache_branch.KVCheckpoint base) → list<kv.KVCache> ⇥ VerifyError {
    # Keep: each layer construction is failable (ForwardFailure must surface
    # in first-failure order); map cannot carry the typed failure boundary.
    const kv.KVCache first ← base.layers.get(0) coalesce kv.default()
    var list<kv.KVCache> layers ← empty
    for range 0 ‥ base.layers.length() const i {
        do {
            const kv.KVCache layer ← kv.empty_cache(first.model, first.model_version, first.config, first.tokenizer, 1, first.dimension)
            layers.append(layer)
        }
        catch err {
            throw variant ForwardFailure { message = err.message }
        }
    }
    return layers
}

@ public
fn recompute(BlockRequest request, list<int> prefix_ids, dense.DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, f32 epsilon, f32 scale, int rope_dim, rope.RopeConfig rope_cfg) → OracleTrace ⇥ VerifyError {
    # Keep: the replay is stateful — step/layers are updated per token through
    # the scalar dense seam; a fold over stateful failable steps has no
    # covering construct.
    # --- admission (fail closed) ---------------------------------------------
    admit_model(request, cfg)
    require prefix_ids.length() ≥ 1 throw variant EmptyPrefix { message = "oracle replay prefix must be non-empty" }
    require prefix_ids.length() ≡ request.prefix_length() throw variant ModelMismatch { message = "oracle replay prefix must match the request prefix length" }
    for from prefix_ids const token_id {
        require token_id ≥ 0 and token_id ≺ cfg.vocab throw variant ModelMismatch { message = "oracle replay token id is outside model vocabulary" }
    }
    const int prefix ← request.prefix_length()
    const int rows ← request.candidate_count()
    # --- prefill replay ------------------------------------------------------
    var list<kv.KVCache> layers ← oracle_empty_layers(request.checkpoint)
    var dense.DenseStep step ← dense.prefill_cached(cfg, source, prefix_ids, epsilon, scale, rope_dim, rope_cfg, layers)
    require step.layers.length() ≡ cfg.layers throw variant ForwardFailure { message = "oracle replay returned the wrong layer count" }
    layers ← step.layers
    # --- per-token decode replay ---------------------------------------------
    var list<f32> logits_data ← empty
    for range 0 ‥ rows const i {
        const int token_id ← request.candidate_ids.get(i) coalesce 0
        step ← dense.decode_step(cfg, source, token_id, prefix + i, epsilon, scale, rope_dim, rope_cfg, layers)
        const tensor.NumericBlock row ← step.logits
        require row.valid() and row.rank() ≡ 2 throw variant ForwardFailure { message = "oracle replay returned an invalid logit row" }
        require finite_value(row) throw variant ModelMismatch { message = "oracle replay produced non-finite logits" }
        for from row.data const value {
            logits_data.append(value)
        }
        layers ← step.layers
    }
    var tensor.NumericBlock logits ← tensor.default()
    do {
        logits ← tensor.construct(logits_data, [rows, cfg.vocab])
    }
    catch err {
        throw variant ForwardFailure { message = "oracle replay logits are not a valid tensor" }
    }
    # --- trace assembly ------------------------------------------------------
    const int dimension ← cfg.kv_heads * cfg.head_dim
    var list<tensor.NumericBlock> keys ← empty
    var list<tensor.NumericBlock> payloads ← empty
    for from layers const state {
        require state.length() ≡ prefix + rows throw variant ForwardFailure { message = "oracle replay cache length does not cover the block" }
        keys.append(candidate_rows(state.key, prefix, rows, dimension))
        payloads.append(candidate_rows(state.payload, prefix, rows, dimension))
    }
    return OracleTrace { rows = construct_rows(request, expected_positions(prefix, rows), logits, keys, payloads), final_layers = layers }
}

@ public
class OracleReport {
    bool equivalent
    int first_divergence
    string detail
}

@ public
fn default_report() → OracleReport {
    return OracleReport { equivalent = false, first_divergence = 0, detail = "placeholder" }
}

@ public
fn construct_report(bool equivalent, int first_divergence, string detail) → OracleReport ⇥ VerifyError {
    if equivalent {
        require first_divergence ≡ -1 throw variant ResultBounds { message = "an equivalent report cannot carry a divergence index" }
        require detail ≡ "equivalent" throw variant ResultBounds { message = "an equivalent report must carry the equivalent detail" }
    }
    else {
        require first_divergence ≥ 0 throw variant ResultBounds { message = "a divergent report must record a non-negative first divergence index" }
        require detail ≠ "" throw variant ResultBounds { message = "a divergent report must carry a detail" }
    }
    return OracleReport { equivalent = equivalent, first_divergence = first_divergence, detail = detail }
}

fn equivalent_report() → OracleReport ⇥ VerifyError {
    return construct_report(true, -1, "equivalent")
}

fn divergent_report(int index, string detail) → OracleReport ⇥ VerifyError {
    return construct_report(false, index, detail)
}

# Earliest flat row whose values differ by more than epsilon, or -1 when the
# tensors agree within epsilon. Shapes are the caller's admission.
fn first_row_delta(tensor.NumericBlock a, tensor.NumericBlock b, f32 epsilon) → int {
    # Keep: first-divergence search with early return; not a filter (no
    # output list is built) and not a reduction (the index is the answer).
    const list<int> shape ← a.shape
    const int width ← shape.get(shape.length() - 1) coalesce 1
    for range 0 ‥ a.data.length() const i {
        const f32 left ← a.data.get(i) coalesce 0.0 ∷ f32
        const f32 right ← b.data.get(i) coalesce 0.0 ∷ f32
        if (left - right).abs() ≻ epsilon then return i / width
    }
    return -1
}

fn first_list_delta(list<int> a, list<int> b) → int {
    var int bound ← a.length()
    if b.length() ≺ bound {
        bound ← b.length()
    }
    for range 0 ‥ bound const i {
        const int left ← a.get(i) coalesce 0
        const int right ← b.get(i) coalesce 0
        if left ≠ right then return i
    }
    if a.length() ≠ b.length() then return 0
    return -1
}

# The comparison authority: every [k, V] row, the position mapping, the
# token history, and every layer's final staged tensors, within the
# admitted epsilon. The first divergence index is the earliest candidate
# row at which any compared surface disagrees; epsilon above the pinned
# 1e-5 reference bound is refused, never widened.
@ public
fn oracle_equal(BlockRows block_rows, OracleTrace trace, f32 epsilon) → OracleReport ⇥ VerifyError {
    # Keep: earliest-divergence comparison with early-return reports across
    # positions, logits, history, and staged tensors (index-space flat scan);
    # no covering construct for a first-divergence search over staged carriers.
    # --- epsilon admission (fail closed) -------------------------------------
    require dtype.finite(epsilon) and epsilon ≻ 0.0 and not (epsilon ≻ 0.00001 ∷ f32) throw variant ResultBounds { message = "oracle epsilon cannot exceed the pinned 1e-5 reference bound" }
    # --- request and positions -----------------------------------------------
    const BlockRows oracle_rows ← trace.rows
    require request_equal(block_rows.request, oracle_rows.request) throw variant ModelMismatch { message = "oracle replay request does not match the block request" }
    const int rows ← block_rows.row_count()
    if not (block_rows.target_positions ≡ oracle_rows.target_positions) {
        const int position_delta ← first_list_delta(block_rows.target_positions, oracle_rows.target_positions)
        var int index ← position_delta
        if index ≺ 0 or index ≥ rows {
            index ← 0
        }
        return divergent_report(index, "target positions diverge at candidate row §"(index ↦ string))
    }
    # --- logits --------------------------------------------------------------
    if not (block_rows.logits.shape ≡ oracle_rows.logits.shape) then return divergent_report(0, "logits shape diverges from the oracle replay")
    const int logits_delta ← first_row_delta(block_rows.logits, oracle_rows.logits, epsilon)
    if logits_delta ≥ 0 then return divergent_report(logits_delta, "logits diverge at candidate row §"(logits_delta ↦ string))
    # --- per-layer staged state ----------------------------------------------
    const cache_branch.KVCheckpoint base ← block_rows.request.checkpoint
    const int prefix ← base.prefix_length
    require trace.final_layers.length() ≡ base.layers.length() throw variant ForwardFailure { message = "oracle replay layer count does not match the checkpoint" }
    for range 0 ‥ base.layers.length() const li {
        const kv.KVCache replay ← trace.final_layers.get(li) coalesce kv.default()
        const kv.KVCache origin ← base.layers.get(li) coalesce kv.default()
        const tensor.NumericBlock staged_key ← block_rows.candidate_keys.get(li) coalesce tensor.default()
        const tensor.NumericBlock staged_payload ← block_rows.candidate_payloads.get(li) coalesce tensor.default()
        const int dimension ← origin.dimension
        var list<int> expected_history ← empty
        for from origin.history const prior {
            expected_history.append(prior)
        }
        for from block_rows.request.candidate_ids const token_id {
            expected_history.append(token_id)
        }
        const int history_delta ← first_list_delta(replay.history, expected_history)
        if history_delta ≥ 0 {
            var int history_index ← history_delta - prefix
            if history_index ≺ 0 or history_index ≥ rows {
                history_index ← 0
            }
            return divergent_report(history_index, "token history diverges at candidate row §"(history_index ↦ string))
        }
        require replay.key.shape ≡ ([prefix + rows, dimension] ↦ list<int>) throw variant ForwardFailure { message = "oracle replay staged key shape does not cover the block" }
        require replay.payload.shape ≡ ([prefix + rows, dimension] ↦ list<int>) throw variant ForwardFailure { message = "oracle replay staged payload shape does not cover the block" }
        for range 0 ‥ (prefix + rows) * dimension const flat {
            const f32 replay_key ← replay.key.data.get(flat) coalesce 0.0 ∷ f32
            const f32 replay_payload ← replay.payload.data.get(flat) coalesce 0.0 ∷ f32
            if flat ≺ prefix * dimension {
                const f32 origin_key ← origin.key.data.get(flat) coalesce 0.0 ∷ f32
                const f32 origin_payload ← origin.payload.data.get(flat) coalesce 0.0 ∷ f32
                if (replay_key - origin_key).abs() ≻ epsilon or (replay_payload - origin_payload).abs() ≻ epsilon then return divergent_report(0, "staged tensors diverge at candidate row §"(0 ↦ string))
            }
            else {
                const f32 staged_key_value ← staged_key.data.get(flat - prefix * dimension) coalesce 0.0 ∷ f32
                const f32 staged_payload_value ← staged_payload.data.get(flat - prefix * dimension) coalesce 0.0 ∷ f32
                if (replay_key - staged_key_value).abs() ≻ epsilon or (replay_payload - staged_payload_value).abs() ≻ epsilon {
                    const int row ← flat / dimension - prefix
                    return divergent_report(row, "staged tensors diverge at candidate row §"(row ↦ string))
                }
            }
        }
    }
    return equivalent_report()
}

# -------------------------------------------------------------------------
# BlockVerification — final consumer result carrier, defined here so later
# units compose one stable result type rather than inventing a second state
# or identity carrier.
# -------------------------------------------------------------------------

@ public
class BlockVerification {
    BlockRows rows
    speculative.GreedyAcceptance acceptance
    cache_branch.KVCheckpoint committed_checkpoint
}

@ public
fn default_verification() → BlockVerification {
    return BlockVerification { rows = default_rows(), acceptance = speculative.default_acceptance(), committed_checkpoint = cache_branch.default() }
}

@ public
fn verification_equal(BlockVerification a, BlockVerification b) → bool {
    if not rows_equal(a.rows, b.rows) then return false
    if not speculative.acceptance_equal(a.acceptance, b.acceptance) then return false
    return cache_branch.checkpoint_equal(a.committed_checkpoint, b.committed_checkpoint)
}

# The final carrier admits only an acceptance result in the request's block
# and a committed checkpoint at the corresponding prefix. It validates the
# shape of the value result; it does not recompute acceptance or commit state.
@ public
fn construct_verification(BlockRows rows, speculative.GreedyAcceptance acceptance, cache_branch.KVCheckpoint committed_checkpoint) → BlockVerification ⇥ VerifyError {
    # Keep: bounded acceptance/identity admission is a require chain, not loop
    # debt; the complexity is the admission contract itself.
    # --- acceptance admission (fail closed) ----------------------------------
    const int candidate_count ← rows.row_count()
    const int accepted_count ← acceptance.accepted_prefix
    const int divergence ← acceptance.divergence
    require accepted_count ≥ 0 and accepted_count ≤ candidate_count throw variant ResultBounds { message = "accepted prefix count is outside result rows" }
    require divergence ≡ -1 or divergence ≥ 0 and divergence ≺ candidate_count throw variant ResultBounds { message = "divergence index is outside result rows" }
    if divergence ≡ -1 {
        require accepted_count ≡ candidate_count throw variant ResultBounds { message = "full acceptance must cover every result row" }
    }
    else {
        require accepted_count ≡ divergence throw variant ResultBounds { message = "divergence index does not match accepted prefix" }
    }
    # --- committed checkpoint admission (fail closed) ------------------------
    const cache_branch.KVCheckpoint base ← rows.request.checkpoint
    require committed_checkpoint.layers.length() ≡ base.layers.length() throw variant ResultBounds { message = "committed checkpoint layer count does not match request" }
    if accepted_count ≡ 0 {
        require cache_branch.checkpoint_equal(committed_checkpoint, base) throw variant ResultBounds { message = "zero-acceptance checkpoint is not the request checkpoint" }
    }
    else {
        # A commit extends the cache identity's exact token history and
        # position range; every other identity field stays the base's.
        var list<int> accepted_ids ← empty
        for range 0 ‥ accepted_count const i {
            accepted_ids.append(rows.request.candidate_ids.get(i) coalesce 0)
        }
        require committed_identity_matches(base.identity, committed_checkpoint.identity, accepted_ids, committed_checkpoint.prefix_length) throw variant ResultBounds { message = "committed checkpoint identity does not extend the request identity" }
        require committed_checkpoint.prefix_length ≡ base.prefix_length + accepted_count throw variant ResultBounds { message = "committed checkpoint prefix does not match acceptance" }
        require committed_checkpoint.version ≡ base.version + 1 throw variant ResultBounds { message = "accepted checkpoint version is not advanced once" }
    }
    return BlockVerification { rows = rows, acceptance = acceptance, committed_checkpoint = committed_checkpoint }
}

# The committed identity is the base identity with the accepted candidate ids
# appended to the exact history and the position range grown to the new
# prefix; model/version/config/tokenizer/layer-count/dtype/layout are fixed.
fn committed_identity_matches(cache_ident.CacheIdentity base, cache_ident.CacheIdentity committed, list<int> accepted_ids, int committed_length) → bool {
    if base.model ≠ committed.model then return false
    if base.model_version ≠ committed.model_version then return false
    if base.config ≠ committed.config then return false
    if base.tokenizer ≠ committed.tokenizer then return false
    if base.layers ≠ committed.layers then return false
    if base.dtype ≠ committed.dtype then return false
    if base.layout ≠ committed.layout then return false
    const string expected_history ← accepted_ids.reduce((string out, int token_id) ∴ out + "," + (token_id ↦ string), base.history)
    if committed.history ≠ expected_history then return false
    return committed.position ≡ "0..§"(committed_length ↦ string)
}

# -------------------------------------------------------------------------
# Consumer verify seam — SD2-U5. One public compose over U1–U4: structural
# admission (construct_request is the caller's gate), k-row forward, greedy
# acceptance wrapped from speculative.first_divergence over the target rows,
# and commit_transaction for the accepted prefix. The seam never produces a
# candidate, contacts a provider, or runs a generation loop; SD4 consumes it.
# -------------------------------------------------------------------------

# Greedy target token per result row: argmax over that row's vocab width.
fn greedy_targets(BlockRows rows) → list<int> ⇥ VerifyError {
    # Keep: the LSR-W0 model form — per-row argmax over an index-space
    # (r * width + c) gather; the row build itself has no map-over-range
    # construct.
    const tensor.NumericBlock logits ← rows.logits
    require logits.rank() ≡ 2 and rows.row_count() ≥ 1 throw variant ResultBounds { message = "verify requires a non-empty result matrix" }
    const list<int> shape ← logits.shape
    const int width ← shape.get(1) coalesce 0
    require width ≥ 1 throw variant ResultBounds { message = "verify requires a positive vocabulary width" }
    var list<int> targets ← empty
    for range 0 ‥ rows.row_count() const r {
        var list<f32> row_values ← empty
        for range 0 ‥ width const c {
            row_values.append(logits.data.get(r * width + c) coalesce 0.0 ∷ f32)
        }
        const int best ← row_values.argmax() coalesce 0
        targets.append(best)
    }
    return targets
}

# Every failure path below throws before any caller state is eligible for
# change: the caller's checkpoint is immutable throughout, and staging lives
# only in the private branch until commit_transaction succeeds.
@ public
fn verify(BlockRequest request, dense.DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, f32 epsilon, f32 scale, int rope_dim, rope.RopeConfig rope_cfg) → BlockVerification ⇥ VerifyError {
    const BlockRows rows ← forward(request, cfg, source, epsilon, scale, rope_dim, rope_cfg)
    const list<int> targets ← greedy_targets(rows)
    var speculative.GreedyAcceptance acceptance ← speculative.default_acceptance()
    do {
        acceptance ← speculative.first_divergence(targets, request.candidate_ids)
    }
    catch err {
        throw variant ForwardFailure { message = err.message }
    }
    const cache_branch.BranchHandle handle ← stage(rows)
    const cache_branch.KVCheckpoint committed ← commit_staged(request.checkpoint, handle, acceptance.accepted_prefix)
    return construct_verification(rows, acceptance, committed)
}
