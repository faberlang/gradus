+++
locale = "en"
+++
# Typed cached-block request/result contract — SD2-U1
#
# Public import: import from "gradus:block_verify" block_verify
#
# This leaf owns structural admission and value carriers only. It does not
# evaluate candidates, import a model, stage a branch, or choose an acceptance
# policy. The checkpoint remains the cache_branch identity and state carrier.

import from "gradus:cache" kv

import from "gradus:cache_branch" cache_branch

import from "gradus:attention" attention

import from "gradus:dtype" dtype

import from "gradus:model/dense" dense

import from "gradus:speculative" speculative

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# VerifyError — typed vocabulary local to the block-verification leaf.
# Every structural reject carries a text message rendered by message().
# -------------------------------------------------------------------------

@ public { }
union VerifyError {
    EmptyPrefix {
        string message
    },
    EmptyCandidates {
        string message
    },
    CapacityOverflow {
        string message
    },
    NegativeToken {
        string message
    },
    ModelMismatch {
        string message
    },
    ForwardFailure {
        string message
    },
    ResultBounds {
        string message
    }
}

@ public { }
fn message(VerifyError e) → string {
    match e {
        case EmptyPrefix const message {
            return message
        }
        case EmptyCandidates const message {
            return message
        }
        case CapacityOverflow const message {
            return message
        }
        case NegativeToken const message {
            return message
        }
        case ModelMismatch const message {
            return message
        }
        case ForwardFailure const message {
            return message
        }
        case ResultBounds const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# BlockRequest — an admitted nonempty-prefix candidate block.
# -------------------------------------------------------------------------

@ public { }
class BlockRequest {
    cache_branch.KVCheckpoint checkpoint
    list<int> candidate_ids

    fn checkpoint() → cache_branch.KVCheckpoint {
        return self.checkpoint
    }

    fn candidate_ids() → list<int> {
        return self.candidate_ids
    }

    fn prefix_length() → int {
        return self.checkpoint.prefix_length()
    }

    fn candidate_count() → int {
        return self.candidate_ids.length()
    }

    fn remaining_capacity() → int {
        const kv.KVCache layer ← self.checkpoint.layers().get(0) coalesce kv.default()
        return layer.capacity() - self.checkpoint.prefix_length()
    }
}

# Placeholder for `var BlockRequest` bindings. It is not an admitted request.
@ public { }
fn default_request() → BlockRequest {
    return BlockRequest {checkpoint = cache_branch.default(), candidate_ids = empty}
}

@ public { }
fn request_equal(BlockRequest a, BlockRequest b) → bool {
    if not cache_branch.checkpoint_equal(a.checkpoint(), b.checkpoint()) then return false
    return a.candidate_ids() ≡ b.candidate_ids()
}

@ private { }
fn _request_capacity(cache_branch.KVCheckpoint checkpoint) → int {
    const kv.KVCache first ← checkpoint.layers().get(0) coalesce kv.default()
    var int remaining ← first.capacity() - checkpoint.prefix_length()
    for range 0‥checkpoint.layers().length() const i {
        const kv.KVCache layer ← checkpoint.layers().get(i) coalesce kv.default()
        const int layer_remaining ← layer.capacity() - checkpoint.prefix_length()
        if layer_remaining ≺ remaining then {
            remaining ← layer_remaining
        }
    }
    return remaining
}

# Structural admission is complete before any forward or model call can be
# made by a consumer. The checkpoint is immutable, so every reject leaves the
# caller's value available for checkpoint_equal comparison.
@ public { }
fn construct_request(cache_branch.KVCheckpoint checkpoint, list<int> candidate_ids) → BlockRequest ⇥ VerifyError {
    require checkpoint.prefix_length() ≥ 1 throw variant EmptyPrefix {message = "block request prefix must be non-empty"}
    require candidate_ids.length() ≥ 1 throw variant EmptyCandidates {message = "candidate block must not be empty"}
    for from candidate_ids const token_id {
        require token_id ≥ 0 throw variant NegativeToken {message = "candidate token id must be non-negative"}
    }
    require candidate_ids.length() ≤ _request_capacity(checkpoint) throw variant CapacityOverflow {message = "candidate block exceeds remaining cache capacity"}
    return BlockRequest {checkpoint = checkpoint, candidate_ids = candidate_ids}
}

# -------------------------------------------------------------------------
# BlockRows — the value-level result of a future reference forward.
# Positions are the target rows L..L+k-1. `logits` is [k, V]; each layer's
# candidate key/payload tensor is [k, dim]. This constructor validates only
# carrier shape and bounds; it performs no forward work.
# -------------------------------------------------------------------------

@ public { }
class BlockRows {
    BlockRequest request
    list<int> target_positions
    tensor.Tensor logits
    list<tensor.Tensor> candidate_keys
    list<tensor.Tensor> candidate_payloads

    fn request() → BlockRequest {
        return self.request
    }

    fn target_positions() → list<int> {
        return self.target_positions
    }

    fn logits() → tensor.Tensor {
        return self.logits
    }

    fn candidate_keys() → list<tensor.Tensor> {
        return self.candidate_keys
    }

    fn candidate_payloads() → list<tensor.Tensor> {
        return self.candidate_payloads
    }

    fn row_count() → int {
        return self.target_positions.length()
    }
}

@ public { }
fn default_rows() → BlockRows {
    return BlockRows {request = default_request(), target_positions = empty, logits = tensor.default(), candidate_keys = empty, candidate_payloads = empty}
}

@ private { }
fn _tensor_equal(tensor.Tensor a, tensor.Tensor b) → bool {
    if dtype.name(a.dtype()) ≠ dtype.name(b.dtype()) then return false
    if not (a.shape() ≡ b.shape()) then return false
    return a.data ≡ b.data
}

@ public { }
fn rows_equal(BlockRows a, BlockRows b) → bool {
    if not request_equal(a.request(), b.request()) then return false
    if not (a.target_positions() ≡ b.target_positions()) then return false
    if not _tensor_equal(a.logits(), b.logits()) then return false
    if a.candidate_keys().length() ≠ b.candidate_keys().length() then return false
    if a.candidate_payloads().length() ≠ b.candidate_payloads().length() then return false
    for range 0‥a.candidate_keys().length() const i {
        const tensor.Tensor left_key ← a.candidate_keys().get(i) coalesce tensor.default()
        const tensor.Tensor right_key ← b.candidate_keys().get(i) coalesce tensor.default()
        const tensor.Tensor left_payload ← a.candidate_payloads().get(i) coalesce tensor.default()
        const tensor.Tensor right_payload ← b.candidate_payloads().get(i) coalesce tensor.default()
        if not _tensor_equal(left_key, right_key) then return false
        if not _tensor_equal(left_payload, right_payload) then return false
    }
    return true
}

@ private { }
fn _expected_positions(int prefix, int rows) → list<int> {
    var list<int> positions ← empty
    for range prefix‥(prefix + rows) const position {
        positions.append(position)
    }
    return positions
}

@ private { }
fn _valid_f32_rows(tensor.Tensor value, list<int> expected_shape) → bool ⇥ VerifyError {
    require value.valid() throw variant ResultBounds {message = "result tensor is not a valid value"}
    require dtype.name(value.dtype()) ≡ "f32" throw variant ResultBounds {message = "result tensor dtype must be f32"}
    require value.shape() ≡ expected_shape throw variant ResultBounds {message = "result tensor shape does not match the block"}
    return true
}

# Construct a forward result only after the caller supplies a valid admitted
# request. The checks reject malformed result values without touching the
# request checkpoint.
@ public { }
fn construct_rows(BlockRequest request, list<int> target_positions, tensor.Tensor logits, list<tensor.Tensor> candidate_keys, list<tensor.Tensor> candidate_payloads) → BlockRows ⇥ VerifyError {
    const int rows ← target_positions.length()
    require rows ≥ 1 and rows ≤ request.candidate_count() throw variant ResultBounds {message = "result row count is outside candidate block"}
    require target_positions ≡ _expected_positions(request.prefix_length(), rows) throw variant ResultBounds {message = "result positions do not start at the checkpoint prefix"}
    require logits.rank() ≡ 2 throw variant ResultBounds {message = "result logits must be rank two"}
    const list<int> logits_shape ← logits.shape()
    const int vocab ← logits_shape.get(1) coalesce 0
    require vocab ≥ 1 throw variant ResultBounds {message = "result logits vocabulary width must be positive"}
    _valid_f32_rows(logits, [rows, vocab])

    const int layer_count ← request.checkpoint().layers().length()
    require layer_count ≥ 1 throw variant ResultBounds {message = "result requires at least one checkpoint layer"}
    require candidate_keys.length() ≡ layer_count throw variant ResultBounds {message = "result K layer count does not match checkpoint"}
    require candidate_payloads.length() ≡ layer_count throw variant ResultBounds {message = "result V layer count does not match checkpoint"}
    for range 0‥layer_count const i {
        const kv.KVCache layer ← request.checkpoint().layers().get(i) coalesce kv.default()
        const tensor.Tensor key ← candidate_keys.get(i) coalesce tensor.default()
        const tensor.Tensor payload ← candidate_payloads.get(i) coalesce tensor.default()
        _valid_f32_rows(key, [rows, layer.dimension()])
        _valid_f32_rows(payload, [rows, layer.dimension()])
    }
    return BlockRows {request = request, target_positions = target_positions, logits = logits, candidate_keys = candidate_keys, candidate_payloads = candidate_payloads}
}

# -------------------------------------------------------------------------
# Reference forward — consume the admitted request through the additive
# dense multi-row cached seam. All model-relative checks happen before the
# first candidate row is constructed; dense and tensor failures are mapped
# into this leaf's typed vocabulary without importing a device surface.
# -------------------------------------------------------------------------

@ private { }
fn _finite_value(tensor.Tensor value) → bool {
    if not value.valid() {
        return false
    }
    for from value.data const item {
        if not dtype.finite(item) {
            return false
        }
    }
    return true
}

@ private { }
fn _admit_model(BlockRequest request, dense.DenseConfig cfg) → bool ⇥ VerifyError {
    require cfg.layers ≥ 1 throw variant ModelMismatch {message = "model must have at least one layer"}
    require cfg.vocab ≥ 1 throw variant ModelMismatch {message = "model vocabulary must be positive"}
    require cfg.kv_heads ≥ 1 and cfg.head_dim ≥ 1 throw variant ModelMismatch {message = "model KV dimensions must be positive"}
    require cfg.layers ≡ request.checkpoint().layers().length() throw variant ModelMismatch {message = "cache layer count must equal model layer count"}
    const int dimension ← cfg.kv_heads * cfg.head_dim
    for from request.candidate_ids() const token_id {
        require token_id ≥ 0 and token_id ≺ cfg.vocab throw variant ModelMismatch {message = "candidate token id is outside model vocabulary"}
    }
    for from request.checkpoint().layers() const layer {
        require layer.dtype() ≡ "f32" throw variant ModelMismatch {message = "cache dtype must be f32"}
        require layer.dimension() ≡ dimension throw variant ModelMismatch {message = "cache dimension does not match model KV width"}
        require layer.key().shape() ≡ [request.prefix_length(), dimension] throw variant ModelMismatch {message = "cache key shape does not match the admitted prefix"}
        require layer.payload().shape() ≡ [request.prefix_length(), dimension] throw variant ModelMismatch {message = "cache value shape does not match the admitted prefix"}
        require _finite_value(layer.key()) throw variant ModelMismatch {message = "cache contains non-finite values"}
        require _finite_value(layer.payload()) throw variant ModelMismatch {message = "cache contains non-finite values"}
    }
    return true
}

@ private { }
fn _map_dense(string detail) → VerifyError {
    if detail ≡ "token id out of range for the embedding" then {
        return variant ModelMismatch {message = "candidate token id is outside model vocabulary"}
    }
    if detail ≡ "cache layer count must equal the model layer count" then {
        return variant ModelMismatch {message = "cache layer count must equal model layer count"}
    }
    if detail ≡ "cache overflow" then {
        return variant ModelMismatch {message = detail}
    }
    if detail ≡ "cache write leaves a gap" then {
        return variant ModelMismatch {message = detail}
    }
    return variant ForwardFailure {message = detail}
}

@ private { }
fn _candidate_rows(tensor.Tensor full, int prefix, int rows, int dimension) → tensor.Tensor ⇥ VerifyError {
    require full.valid() throw variant ForwardFailure {message = "dense forward returned an invalid cache tensor"}
    require dtype.name(full.dtype()) ≡ "f32" throw variant ModelMismatch {message = "dense forward cache dtype must be f32"}
    require full.shape() ≡ [prefix + rows, dimension] throw variant ForwardFailure {message = "dense forward cache shape does not match the candidate block"}
    var list<f32> data ← empty
    for range prefix‥(prefix + rows) const row {
        for range 0‥dimension const column {
            data.append(full.data.get(row * dimension + column) coalesce 0.0 ∷ f32)
        }
    }
    var tensor.Tensor out ← tensor.default()
    do {
        out ← tensor.construct(data, [rows, dimension])
    }
    catch err {
        throw variant ForwardFailure {message = "dense forward candidate rows are not a valid tensor"}
    }
    require _finite_value(out) throw variant ModelMismatch {message = "dense forward produced non-finite candidate K/V values"}
    return out
}

# `row i` is the dense cached result at absolute position L+i, with candidate
# i's K/V written at that same position. The dense seam itself preserves the
# lower attention primitive's causal prefix + through-row convention.
@ public { }
fn forward(BlockRequest request, dense.DenseConfig cfg, (string, int) → tensor.Tensor ⇥ dense.DenseError source, f32 epsilon, f32 scale, int rope_dim, attention.RopeConfig rope_cfg) → BlockRows ⇥ VerifyError {
    _admit_model(request, cfg)
    const int rows ← request.candidate_count()
    const int prefix ← request.prefix_length()
    var dense.DenseStep step ← dense.default_step()
    do {
        step ← dense.decode_block(cfg, source, request.candidate_ids(), epsilon, scale, rope_dim, rope_cfg, request.checkpoint().layers())
    }
    catch err {
        throw _map_dense(dense.message(err))
    }

    const tensor.Tensor logits ← step.logits()
    require _finite_value(logits) throw variant ModelMismatch {message = "dense forward produced non-finite logits"}
    const int dimension ← cfg.kv_heads * cfg.head_dim
    require step.layers().length() ≡ cfg.layers throw variant ForwardFailure {message = "dense forward returned the wrong layer count"}
    var list<tensor.Tensor> keys ← empty
    var list<tensor.Tensor> payloads ← empty
    for range 0‥cfg.layers const i {
        const kv.KVCache state ← step.layers().get(i) coalesce kv.default()
        keys.append(_candidate_rows(state.key(), prefix, rows, dimension))
        payloads.append(_candidate_rows(state.payload(), prefix, rows, dimension))
    }
    var list<int> positions ← empty
    for range prefix‥(prefix + rows) const position {
        positions.append(position)
    }
    return construct_rows(request, positions, logits, keys, payloads)
}

# -------------------------------------------------------------------------
# BlockVerification — final consumer result carrier, defined here so later
# units compose one stable result type rather than inventing a second state
# or identity carrier.
# -------------------------------------------------------------------------

@ public { }
class BlockVerification {
    BlockRows rows
    speculative.GreedyAcceptance acceptance
    cache_branch.KVCheckpoint committed_checkpoint

    fn rows() → BlockRows {
        return self.rows
    }

    fn acceptance() → speculative.GreedyAcceptance {
        return self.acceptance
    }

    fn committed_checkpoint() → cache_branch.KVCheckpoint {
        return self.committed_checkpoint
    }
}

@ public { }
fn default_verification() → BlockVerification {
    return BlockVerification {rows = default_rows(), acceptance = speculative.default_acceptance(), committed_checkpoint = cache_branch.default()}
}

@ public { }
fn verification_equal(BlockVerification a, BlockVerification b) → bool {
    if not rows_equal(a.rows(), b.rows()) then return false
    if not speculative.acceptance_equal(a.acceptance(), b.acceptance()) then return false
    return cache_branch.checkpoint_equal(a.committed_checkpoint(), b.committed_checkpoint())
}

# The final carrier admits only an acceptance result in the request's block
# and a committed checkpoint at the corresponding prefix. It validates the
# shape of the value result; it does not recompute acceptance or commit state.
@ public { }
fn construct_verification(BlockRows rows, speculative.GreedyAcceptance acceptance, cache_branch.KVCheckpoint committed_checkpoint) → BlockVerification ⇥ VerifyError {
    const int candidate_count ← rows.row_count()
    const int accepted_count ← acceptance.accepted_prefix_length()
    const int divergence ← acceptance.divergence_index()
    require accepted_count ≥ 0 and accepted_count ≤ candidate_count throw variant ResultBounds {message = "accepted prefix count is outside result rows"}
    require divergence ≡ (0 - 1) or (divergence ≥ 0 and divergence ≺ candidate_count) throw variant ResultBounds {message = "divergence index is outside result rows"}
    if divergence ≡ (0 - 1) {
        require accepted_count ≡ candidate_count throw variant ResultBounds {message = "full acceptance must cover every result row"}
    }
    else {
        require accepted_count ≡ divergence throw variant ResultBounds {message = "divergence index does not match accepted prefix"}
    }

    const cache_branch.KVCheckpoint base ← rows.request().checkpoint()
    require committed_checkpoint.layers().length() ≡ base.layers().length() throw variant ResultBounds {message = "committed checkpoint layer count does not match request"}
    require kv.cache_identity_equal(committed_checkpoint.identity(), base.identity()) throw variant ResultBounds {message = "committed checkpoint identity does not match request"}
    require committed_checkpoint.prefix_length() ≡ base.prefix_length() + accepted_count throw variant ResultBounds {message = "committed checkpoint prefix does not match acceptance"}
    if accepted_count ≡ 0 {
        require cache_branch.checkpoint_equal(committed_checkpoint, base) throw variant ResultBounds {message = "zero-acceptance checkpoint is not the request checkpoint"}
    }
    else {
        require committed_checkpoint.version() ≡ base.version() + 1 throw variant ResultBounds {message = "accepted checkpoint version is not advanced once"}
    }
    return BlockVerification {rows = rows, acceptance = acceptance, committed_checkpoint = committed_checkpoint}
}
