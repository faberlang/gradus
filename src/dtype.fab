+++
locale = "en"
+++
# Dtype system — versioned dtype contract (PML1-U2).
#
# Public import: import from "gradus:dtype" dtype
# Depends on: nothing (foundation layer; owns the DType tag)
#
# NOTE (compiler-lane finding, 2026-08-08): enum variants cannot be
# referenced across module boundaries in library-context checks (SEM001
# unknown_variant; unqualified patterns degrade to catchall bindings). The
# DType tag therefore lives HERE with its contract, and gradus:tensor
# consumes it (DAG: tensor → dtype, tensor → math) instead of the reverse.
#
# --- Contract ------------------------------------------------------------
#
# Schema: dtype-schema-1.0.0 (stamped 2026-08-08, PML1-U2). Any change to a
# dtype, a value domain, a promotion/rejection rule, the round rule, or the
# serialization encoding is a schema bump. Consumers reject unknown schema
# versions — no best-effort partial reads (capsule rule, PML0-U14).
#
# DType tag: F32, F16, I32, U8.
#
# Value domains (what each dtype's elements denote):
#   F32 — IEEE binary32: finite reals + NaN + ±Inf
#   F16 — IEEE binary16: finite reals + NaN + ±Inf
#   I32 — integers in [-2147483648, 2147483647]
#   U8  — integers in [0, 255]
#
# Conversion classes — explicit tables (encoded in promote / narrow):
#
#   Promotion (lossless widening; always succeeds, exact):
#       F16→F32   U8→F16   U8→I32   U8→F32     (+ identity pairs)
#   Narrowing (round + range-check; overflow → typed error):
#       F32→F16   F32→I32   F32→U8   F16→I32   F16→U8
#       I32→F32 (precision rounding; range always covers)   I32→F16   I32→U8
#
# Round rules:
#   float→int (→I32/U8) — round-half-away-from-zero (fractus.rotunda), then
#     range-check against the target domain.
#   F32→F16 — IEEE round-to-nearest, ties-to-even. The value-level cast here
#     checks finite-in-range; exact bit quantization is a lowering/host rule
#     (hosts own physical storage).
#   int→float (I32→F32) — round-to-nearest; precision loss above 2^24 is
#     explicit and expected (I32→F32 is NOT a promotion).
#   int→int (I32→U8) — no rounding; range-check only.
#
# Non-finite handling (per the capsule rules — fail closed, no silent
# tolerance):
#   float→int cast of NaN/±Inf → typed error (NonFinite).
#   float→float (F32→F16): NaN and ±Inf pass through (both are representable
#     in the target); a finite value above F16's max (65504.0) → typed error
#     (Overflow). The IEEE tie-zone (65504, 65520) rejects rather than
#     silently rounds — conservative, fail-closed.
#   int→float / int→int: no non-finite values exist in the source domain.
#
# Serialization rules (dtype-level; value bytes are PML1-U7):
#   Wire form: "dtype/<schema>/<name>" with schema = 1.0.0 and name one of
#   f32 | f16 | i32 | u8. Unknown schema or unknown name → typed error.
#   Element width (width): F32=4, F16=2, I32=4, U8=1 bytes.
#
# --- Seams ---------------------------------------------------------------
#   * value serialization bytes + version rejection policy — U7.
#   * elementwise cast family over this module's rules — U4 (math.fab).

# -------------------------------------------------------------------------
# DType — element-type tag carried on every Tensor (gradus:tensor consumes
# this module; the tag lives here so its variants stay in one module with
# the contract — see compiler-lane finding above).
# -------------------------------------------------------------------------


@ public { }
union DType {
    F32,
    F16,
    I32,
    U8
}

# Canonical tag factories — tensor.fab (and other consumers) obtain tags as
# values through these (cross-module `variant` of an imported enum's variants
# is not supported in library context today).
@ public { }
fn f32() → DType {
    return variant F32
}

@ public { }
fn f16() → DType {
    return variant F16
}

@ public { }
fn i32() → DType {
    return variant I32
}

@ public { }
fn u8() → DType {
    return variant U8
}

# Structural equality — the compiled rust route does not derive PartialEq
# on generated enums, so `≡` on a DType tag is not a rust-legal compare.
# Compare through this predicate (name identity of the four tags).
@ public { }
fn eq(DType a, DType b) → bool {
    return name(a) ≡ name(b)
}

# -------------------------------------------------------------------------
# Schema and value-domain constants.
# -------------------------------------------------------------------------

const string schema_version ← "1.0.0"

# Largest finite f32 (3.40282347e38 rounds to f32::MAX). Used only to
# classify non-finite values: |x| > maximum_f32 ⇒ ±Inf.
const f32 maximum_f32 ← 340282347000000000000000000000000000000.0 ∷ f32

# Largest finite f16. Finite F32 values above this reject on F32→F16.
const f32 maximum_f16 ← 65504.0 ∷ f32

const int minimum_i32 ← -2147483648

const int maximum_i32 ← 2147483647

const int minimum_u8 ← 0

const int maximum_u8 ← 255

# -------------------------------------------------------------------------
# DTypeError — typed error vocabulary of the dtype system. Every variant
# carries a text message so consumers can render failures without matching
# each variant (same pattern as TensorError in gradus:tensor).
# -------------------------------------------------------------------------


@ public { }
union DTypeError {
    UnknownName {
        string message
    },
    UnknownVersion {
        string message
    },
    NonFinite {
        string message
    },
    Overflow {
        string message
    }
}

@ public { }
fn message(DTypeError e) → string {
    match e {
        case UnknownName const message {
            return message
        }
        case UnknownVersion const message {
            return message
        }
        case NonFinite const message {
            return message
        }
        case Overflow const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# Tag contract — canonical names, name parsing, element width.
# -------------------------------------------------------------------------

@ public { }
fn name(DType t) → string {
    match t {
        case F32 {
            return "f32"
        }
        case F16 {
            return "f16"
        }
        case I32 {
            return "i32"
        }
        case U8 {
            return "u8"
        }
    }
}

@ public { }
fn from_name(string s) → DType ⇥ DTypeError {
    if s ≡ "f32" then return variant F32
    if s ≡ "f16" then return variant F16
    if s ≡ "i32" then return variant I32
    if s ≡ "u8" then return variant U8
    throw variant UnknownName {message = "unknown dtype name: " + s}
}

# Element width in bytes (dtype-level serialization fact).
@ public { }
fn width(DType t) → int {
    match t {
        case F32 {
            return 4
        }
        case F16 {
            return 2
        }
        case I32 {
            return 4
        }
        case U8 {
            return 1
        }
    }
}

# -------------------------------------------------------------------------
# Serialization — versioned dtype tag encoding. Value bytes are PML1-U7.
# -------------------------------------------------------------------------

@ public { }
fn serialize(DType t) → string {
    return (("dtype/" + schema_version) + "/") + name(t)
}

@ public { }
fn deserialize(string s) → DType ⇥ DTypeError {
    const list<string> parts ← s.split("/")
    require parts.length() ≡ 3 throw variant UnknownVersion {message = "malformed dtype serialization"}
    require parts.get(0) coalesce "" ≡ "dtype" throw variant UnknownVersion {message = "unknown dtype marker"}
    require parts.get(1) coalesce "" ≡ schema_version throw variant UnknownVersion {message = "unknown dtype schema version"}
    return from_name(parts.get(2) coalesce "")
}

# -------------------------------------------------------------------------
# Promotion table — lossless widening, identity included. Every pair is
# either promotion (exact, never fails) or narrowing (round + range-check,
# can reject). There is no categorically-rejected pair; rejection is
# value-level (overflow / non-finite) and belongs to cast.
# -------------------------------------------------------------------------

@ public { }
fn promote(DType a, DType b) → bool {
    match a {
        case F32 {
            match b {
                case F32 {
                    return true
                }
                case _ {
                    return false
                }
            }
        }
        case F16 {
            match b {
                case F16 {
                    return true
                }
                case F32 {
                    return true
                }
                case _ {
                    return false
                }
            }
        }
        case I32 {
            match b {
                case I32 {
                    return true
                }
                case _ {
                    return false
                }
            }
        }
        case U8 {
            match b {
                case U8 {
                    return true
                }
                case F16 {
                    return true
                }
                case I32 {
                    return true
                }
                case F32 {
                    return true
                }
                case _ {
                    return false
                }
            }
        }
    }
}

# Narrowing table — the complement of promotion over distinct pairs
# (round + range-check; I32→F32 never overflows). Identity pairs are not
# narrowing.
@ public { }
fn narrow(DType a, DType b) → bool {
    match a {
        case F32 {
            match b {
                case F32 {
                    return false
                }
                case _ {
                    return true
                }
            }
        }
        case F16 {
            match b {
                case F16 {
                    return false
                }
                case F32 {
                    return false
                }
                case _ {
                    return true
                }
            }
        }
        case I32 {
            match b {
                case I32 {
                    return false
                }
                case F32 {
                    return true
                }
                case _ {
                    return true
                }
            }
        }
        case U8 {
            match b {
                case U8 {
                    return false
                }
                case _ {
                    return false
                }
            }
        }
    }
}

# -------------------------------------------------------------------------
# Non-finite detection. A value is finite iff it is not NaN (NaN ≠ itself)
# and its magnitude does not exceed the largest finite f32.
# -------------------------------------------------------------------------

@ public { }
fn finite(f32 x) → bool {
    if x ≠ x then return false
    if x.abs() ≻ maximum_f32 then return false
    return true
}

# -------------------------------------------------------------------------
# Cast — convert a value between dtypes. Storage stays f32-carried (the
# staged seam from U1); the result is the value in target's value domain,
# carried as f32 (an exact integer for I32/U8, an in-range value for F16).
# Promotion passes through exactly; narrowing rounds per the round rules
# and rejects non-finite or overflowing values with a typed error (capsule
# rules — no silent tolerance).
# -------------------------------------------------------------------------

@ public { }
fn cast(f32 payload, DType source, DType target) → f32 ⇥ DTypeError {
    if promote(source, target) then return payload
    match target {
        case F32 {
            # Narrowing source I32 → F32: precision rounding only; the f32
            # exponent range always covers i32. Never overflows.
            return payload
        }
        case F16 {
            # Float→float: NaN and ±Inf pass through (representable in F16);
            # a finite value above F16's max fails closed.
            if not finite(payload) then return payload
            require payload.abs() ≤ maximum_f16 throw variant Overflow {message = "f16 overflow in cast"}
            return payload
        }
        case I32 {
            require finite(payload) throw variant NonFinite {message = "non-finite value in cast to i32"}
            const int n ← payload.round()
            require not (n ≺ minimum_i32 or n ≻ maximum_i32) throw variant Overflow {message = "i32 overflow in cast"}
            return n ↦ f32
        }
        case U8 {
            require finite(payload) throw variant NonFinite {message = "non-finite value in cast to u8"}
            const int n ← payload.round()
            require not (n ≺ minimum_u8 or n ≻ maximum_u8) throw variant Overflow {message = "u8 overflow in cast"}
            return n ↦ f32
        }
    }
}
