+++
locale = "en"
+++
# Co-located package test for gradient.fab (PML4-U2 — the gradient-call
# contract). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * the per-parameter gradient record: identity (owner + name,
#     PML1-U5 schema) + generation (version at gradient computation) +
#     value; construction is fail-closed (empty identity fields, invalid
#     generation — message identity per validation).
#   * the bundle contract: assembly, count, and unique identity resolution
#     (find fails closed on a miss — message identity).
#   * the generation/staleness contract: a gradient computed at version N is
#     stale exactly once the parameter is at a different version — composes
#     with parameter.fab mutate, which bumps version by 1 on every successful
#     mutation.
#   * the oracle pins: f64 evaluations of the documented gradient formula
#     for simple_loss(x, w) = mean(x∘w): ∂loss/∂w_ij = x_ij/4, and for
#     masked_mean(x, mask) = mean(x∘mask) over N=4: ∂loss/∂x_i = mask_i/N
#     (live lanes inside 1e-4/1e-4; padded lanes exactly zero). These are
#     the reference values the auditor-owned runtime gate compares the
#     generated companion's grad_w / grad_x against under the GPU-training
#     lane's gradient tolerance row (1e-4/1e-4 — numeric-policy v1.0.0 §5.1).
#
# The INVOCATION surface (gradients_simple_loss — the one public contract
# entry calling the compiler-generated companion) is compile-validated at
# package level: `faber check` on the library runs the reverse-AD transform
# and the wrapper's companion call type-checks (gradient.fab). The proba
# file-interface cannot call typed-tensor signatures (SEM010/SEM013), so
# the wrapper's call is proven structurally — the documented ABI and the
# exempla/gradient-seam fixture (checked by check-compile) carry the
# consumer-side proof.
#
# EVIDENCE HONESTY (CTO Q2, hard): this suite is STRUCTURAL proof. No
# executed companion gradient value is claimed here; the oracle pins are
# f64 evaluations of the documented formulas. Runtime gradient-value
# identity is not claimed here: the gradient-seam check/run divergence
# remains an E8 residual. PML4-U2 is PARTIAL and the value-identity
# claim is deferred to the auditor-owned runtime-evidence gate.
#
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/gradient.proba` proves the suite
# type-checks. Library-to-library calls execute on the FMIR stepper
# (radix 43c0102ba; regression-locked by 2e8042ae7). This suite remains
# compile-level proof; no runtime value identity is claimed here.

import from "gradus:gradient" gradient

import from "gradus:tensor" tensor

# ---- helpers (the nn.proba / loss.proba pattern)

# Build a staged tensor, swallowing the never-firing construction errors
# (test data is always valid; the cape fallback is unreachable).
fn hold(list<f32> data, list<int> shape) → tensor.Tensor {
    var tensor.Tensor t ← tensor.default()
    do {
        t ← tensor.construct(data, shape)
    }
    catch err {
        return t
    }
    return t
}

# Renders a gradient-record construction outcome as text: "ok" on
# success, the typed error's message on rejection (the documented error
# identity).
fn construct_detail(string owner, string name, int version, tensor.Tensor payload) → string {
    do {
        gradient.construct(owner, name, version, payload)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# Renders a bundle identity resolution as text: "found" on success, the
# typed error's message on a miss.
fn find_detail(gradient.Gradients b, string owner, string name) → string {
    do {
        b.find(owner, name)
        return "found"
    }
    catch err {
        return err.message
    }
}

# ---- oracle pins (f64 evaluations of the documented formulas)

# simple_loss(x, w) = mean(x∘w) over 2×2 → ∂loss/∂w_ij = x_ij/4. For the
# seam's canonical data x = [1, 2, 3, 4] the f64 reference values are
# exactly [0.25, 0.5, 0.75, 1.0]. These are the pins for the auditor-owned
# runtime-evidence gate: compare the generated companion's grad_w under
# the GPU-training lane's gradient tolerance row (1e-4/1e-4,
# gpu-training-lowering/numeric-policy.md v1.0.0 §5.1). No executed
# companion value is claimed here (CTO Q2).
const f32 GRAD_W_ORACLE_0 ← 0.25 ∷ f32

const f32 GRAD_W_ORACLE_1 ← 0.5 ∷ f32

const f32 GRAD_W_ORACLE_2 ← 0.75 ∷ f32

const f32 GRAD_W_ORACLE_3 ← 1.0 ∷ f32

# ---- per-parameter gradient record: identity + generation + value

test "construct builds a gradient record with full identity, generation, and value" {
    do {
        const gradient.Gradient g ← gradient.construct("weight", "model.mlp", 1, hold([0.25, 0.5, 0.75, 1.0], [2, 2]))
        assert g.owner() ≡ "model.mlp"
        assert g.name() ≡ "weight"
        assert g.version() ≡ 1
        assert g.payload().shape() ≡ ([2, 2] ↦ list<int>)
    }
    catch err {
        assert false
    }
}

test "construct rejects an empty owner path" {
    assert construct_detail("", "weight", 1, hold([0.0], [1])) ≡ "empty gradient owner"
}

test "construct rejects an empty parameter name" {
    assert construct_detail("model", "", 1, hold([0.0], [1])) ≡ "empty gradient name"
}

test "construct rejects an invalid generation (version < 1 — the PML1-U5 start value)" {
    assert construct_detail("model", "weight", 0, hold([0.0], [1])) ≡ "invalid gradient generation"
}

# ---- bundle contract: assembly, count, identity resolution

test "construct_gradients assembles a bundle; find resolves by (owner, name)" {
    do {
        const gradient.Gradient g1 ← gradient.construct("w1", "model.mlp", 1, hold([0.25, 0.5], [2]))
        const gradient.Gradient g2 ← gradient.construct("b1", "model.mlp", 3, hold([0.125], [1]))
        const gradient.Gradients b ← gradient.construct_gradients([g1, g2])
        assert b.count() ≡ 2
        const gradient.Gradient g ← b.find("model.mlp", "w1")
        assert g.name() ≡ "w1"
        assert g.version() ≡ 1
    }
    catch err {
        assert false
    }
}

test "find fails closed on an unknown identity (no gradient for that parameter)" {
    do {
        const gradient.Gradient g ← gradient.construct("w1", "model.mlp", 1, hold([0.25], [1]))
        const gradient.Gradients b ← gradient.construct_gradients([g])
        assert find_detail(b, "model.mlp", "nope") ≡ "no gradient for that parameter identity"
    }
    catch err {
        assert false
    }
}

# ---- generation / staleness contract

test "a gradient computed at the parameter's current version is not stale" {
    do {
        const gradient.Gradient g ← gradient.construct("w1", "model.mlp", 1, hold([0.25], [1]))
        assert not gradient.obsolete(g, 1)
    }
    catch err {
        assert false
    }
}

test "a gradient is stale once the parameter mutated (parameter.fab mutate bumps version 1 → 2)" {
    do {
        const gradient.Gradient g ← gradient.construct("w1", "model.mlp", 1, hold([0.25], [1]))
        # PML1-U5 mutation rule: every successful mutation bumps version
        # by 1; a gradient computed against version 1 must not be applied
        # to a parameter now at version 2.
        assert gradient.obsolete(g, 2)
    }
    catch err {
        assert false
    }
}

test "generation readback equals the recorded version at computation" {
    do {
        const gradient.Gradient g ← gradient.construct("w1", "model.mlp", 4, hold([0.25], [1]))
        assert g.version() ≡ 4
    }
    catch err {
        assert false
    }
}

# ---- oracle pins (f64 evaluations of the documented gradient formulas)

test "grad_w oracle pins equal ∂simple_loss/∂w_ij = x_ij/4 for x = [1, 2, 3, 4]" {
    do {
        # Documented formula: simple_loss(x, w) = mean(x∘w) over 4
        # elements; ∂loss/∂w_ij = x_ij/4. f64 evaluations: [1/4, 2/4,
        # 3/4, 4/4] = [0.25, 0.5, 0.75, 1.0] — exact.
        assert GRAD_W_ORACLE_0 ≡ 1.0 / 4.0 ∷ f32
        assert GRAD_W_ORACLE_1 ≡ 2.0 / 4.0 ∷ f32
        assert GRAD_W_ORACLE_2 ≡ 3.0 / 4.0 ∷ f32
        assert GRAD_W_ORACLE_3 ≡ 4.0 / 4.0 ∷ f32
    }
    catch err {
        assert false
    }
}

# ---- masked_mean oracle (unit-3G / K2): mean(x∘mask) over N=4
# ∂loss/∂x_i = mask_i / N. Fixture mask = [1, 1, 0, 0] (two live lanes,
# two pads). Live lanes sit inside the 1e-4/1e-4 gradient row; padded
# lanes are exactly zero. No executed companion value is claimed here
# (CTO Q2) — the file-interface cannot call typed-tensor signatures.

const f32 MASKED_GRAD_X_0 ← 0.25 ∷ f32

const f32 MASKED_GRAD_X_1 ← 0.25 ∷ f32

const f32 MASKED_GRAD_X_2 ← 0.0 ∷ f32

const f32 MASKED_GRAD_X_3 ← 0.0 ∷ f32

const f32 MASKED_GRAD_TOL ← 0.0001 ∷ f32

test "masked live-lane pins equal mask_i/N and sit inside the 1e-4/1e-4 row" {
    do {
        assert MASKED_GRAD_X_0 ≡ 1.0 / 4.0 ∷ f32
        assert MASKED_GRAD_X_1 ≡ 1.0 / 4.0 ∷ f32
        assert MASKED_GRAD_X_0.approximate(0.25, MASKED_GRAD_TOL)
        assert MASKED_GRAD_X_1.approximate(0.25, MASKED_GRAD_TOL)
    }
    catch err {
        assert false
    }
}

test "masked padded-lane pins are exactly zero" {
    do {
        assert MASKED_GRAD_X_2 ≡ 0.0 ∷ f32
        assert MASKED_GRAD_X_3 ≡ 0.0 ∷ f32
    }
    catch err {
        assert false
    }
}

test "masked oracle payload packages as a rank-1 gradient record" {
    do {
        const gradient.Gradient g ← gradient.construct("batch", "train.pad", 1, hold([0.25, 0.25, 0.0, 0.0], [4]))
        assert g.payload().shape() ≡ ([4] ↦ list<int>)
        assert not gradient.obsolete(g, 1)
    }
    catch err {
        assert false
    }
}
