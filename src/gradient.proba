# Co-located package test for gradient.fab (PML4-U2 — the gradient-call
# contract). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * the per-parameter gradient record: identity (possessor + nomen,
#     PML1-U5 schema) + generation (versio at gradient computation) +
#     value; construction is fail-closed (empty identity fields, invalid
#     generation — causa identity per validation).
#   * the bundle contract: assembly, count, and unique identity resolution
#     (inveni fails closed on a miss — causa identity).
#   * the generation/staleness contract: a gradient computed at versio N is
#     stale exactly once the parameter is at a different versio — composes
#     with parameter.fab muta, which bumps versio by 1 on every successful
#     mutation.
#   * the oracle pins: f64 evaluations of the documented gradient formula
#     for simple_loss(x, w) = mean(x∘w): ∂loss/∂w_ij = x_ij/4. These are
#     the reference values the auditor-owned runtime gate compares the
#     generated companion's grad_w against under the GPU-training lane's
#     gradient tolerance row (1e-4/1e-4 — numeric-policy v1.0.0 §5.1).
#
# The INVOCATION surface (gradientes_simple_loss — the one public contract
# entry calling the compiler-generated companion) is compile-validated at
# package level: `faber check` on the library runs the reverse-AD transform
# and the wrapper's companion call type-checks (gradient.fab). The proba
# file-interface cannot call typed-tensor signatures (SEM010/SEM013), so
# the wrapper's call is proven structurally — the documented ABI and the
# exempla/gradient-seam fixture (checked by check-compile) carry the
# consumer-side proof.
#
# EVIDENCE HONESTY (CTO Q2, hard): this suite is STRUCTURAL proof. No
# executed companion gradient value is claimed here; the oracle pins are
# f64 evaluations of the documented formulas. Runtime gradient-value
# identity is env-blocked tree-wide today (FMIR stepper / library-import
# gap — recorded residual); PML4-U2 is PARTIAL and the value-identity
# claim is deferred to the auditor-owned runtime-evidence gate.
#
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/gradient.proba` proves the suite
# type-checks. Execution of proba bodies is env-blocked tree-wide today
# (recorded residual); this suite is the compile-level proof of the
# contract.

importa ex "gradus:gradient" gradient
importa ex "gradus:tensor" tensor

# ---- helpers (the nn.proba / loss.proba pattern)

# Build a staged tensor, swallowing the never-firing construction errors
# (test data is always valid; the cape fallback is unreachable).
functio tene(lista<f32> datos, lista<numerus> forma) → tensor.Tensor {
    varia tensor.Tensor t
    fac {
        t ← tensor.structa(datos, forma)
    }
    cape err {
        redde t
    }
    redde t
}

# Renders a gradient-record construction outcome as textus: "ok" on
# success, the typed error's causa on rejection (the documented error
# identity).
functio structa_detail(textus possessor, textus nomen, numerus versio, tensor.Tensor valor) → textus {
    fac {
        fixum gradient.Gradiente _ ← gradient.structa(possessor, nomen, versio, valor)
        redde "ok"
    }
    cape err {
        redde gradient.causa(err)
    }
}

# Renders a bundle identity resolution as textus: "found" on success, the
# typed error's causa on a miss.
functio inveni_detail(gradient.Gradientes b, textus possessor, textus nomen) → textus {
    fac {
        fixum gradient.Gradiente _ ← b.inveni(possessor, nomen)
        redde "found"
    }
    cape err {
        redde gradient.causa(err)
    }
}

# ---- oracle pins (f64 evaluations of the documented formulas)

# simple_loss(x, w) = mean(x∘w) over 2×2 → ∂loss/∂w_ij = x_ij/4. For the
# seam's canonical data x = [1, 2, 3, 4] the f64 reference values are
# exactly [0.25, 0.5, 0.75, 1.0]. These are the pins for the auditor-owned
# runtime-evidence gate: compare the generated companion's grad_w under
# the GPU-training lane's gradient tolerance row (1e-4/1e-4,
# gpu-training-lowering/numeric-policy.md v1.0.0 §5.1). No executed
# companion value is claimed here (CTO Q2).
fixum f32 GRAD_W_ORACLE_0 ← (0.25 ∷ f32)
fixum f32 GRAD_W_ORACLE_1 ← (0.5 ∷ f32)
fixum f32 GRAD_W_ORACLE_2 ← (0.75 ∷ f32)
fixum f32 GRAD_W_ORACLE_3 ← (1.0 ∷ f32)

# ---- per-parameter gradient record: identity + generation + value

probandum "gradient contract — per-parameter gradient record" {
    proba "structa builds a gradient record with full identity, generation, and value" {
        fac {
            fixum gradient.Gradiente g ← gradient.structa("weight", "model.mlp", 1, tene([0.25, 0.5, 0.75, 1.0], [2, 2]))
            adfirma g.possessor() ≡ "model.mlp"
            adfirma g.nomen() ≡ "weight"
            adfirma g.versio() ≡ 1
            adfirma g.valor().figura() ≡ [2, 2]
        }
        cape err {
            adfirma falsum
        }
    }

    proba "structa rejects an empty owner path" {
        adfirma structa_detail("", "weight", 1, tene([0.0], [1])) ≡ "empty gradient owner"
    }

    proba "structa rejects an empty parameter name" {
        adfirma structa_detail("model", "", 1, tene([0.0], [1])) ≡ "empty gradient name"
    }

    proba "structa rejects an invalid generation (versio < 1 — the PML1-U5 start value)" {
        adfirma structa_detail("model", "weight", 0, tene([0.0], [1])) ≡ "invalid gradient generation"
    }
}

# ---- bundle contract: assembly, count, identity resolution

probandum "gradient contract — bundle and identity resolution" {
    proba "structa_gradientes assembles a bundle; inveni resolves by (possessor, nomen)" {
        fac {
            fixum gradient.Gradiente g1 ← gradient.structa("w1", "model.mlp", 1, tene([0.25, 0.5], [2]))
            fixum gradient.Gradiente g2 ← gradient.structa("b1", "model.mlp", 3, tene([0.125], [1]))
            fixum gradient.Gradientes b ← gradient.structa_gradientes([g1, g2])
            adfirma b.numerus() ≡ 2
            fixum gradient.Gradiente g ← b.inveni("model.mlp", "w1")
            adfirma g.nomen() ≡ "w1"
            adfirma g.versio() ≡ 1
        }
        cape err {
            adfirma falsum
        }
    }

    proba "inveni fails closed on an unknown identity (no gradient for that parameter)" {
        fac {
            fixum gradient.Gradiente g ← gradient.structa("w1", "model.mlp", 1, tene([0.25], [1]))
            fixum gradient.Gradientes b ← gradient.structa_gradientes([g])
            adfirma inveni_detail(b, "model.mlp", "nope") ≡ "no gradient for that parameter identity"
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- generation / staleness contract

probandum "gradient contract — generation and staleness" {
    proba "a gradient computed at the parameter's current versio is not stale" {
        fac {
            fixum gradient.Gradiente g ← gradient.structa("w1", "model.mlp", 1, tene([0.25], [1]))
            adfirma non (gradient.obsoletus(g, 1))
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a gradient is stale once the parameter mutated (parameter.fab muta bumps versio 1 → 2)" {
        fac {
            fixum gradient.Gradiente g ← gradient.structa("w1", "model.mlp", 1, tene([0.25], [1]))
            # PML1-U5 mutation rule: every successful mutation bumps versio
            # by 1; a gradient computed against versio 1 must not be applied
            # to a parameter now at versio 2.
            adfirma gradient.obsoletus(g, 2)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "generation readback equals the recorded versio at computation" {
        fac {
            fixum gradient.Gradiente g ← gradient.structa("w1", "model.mlp", 4, tene([0.25], [1]))
            adfirma g.versio() ≡ 4
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- oracle pins (f64 evaluations of the documented gradient formulas)

probandum "gradient contract — oracle pins" {
    proba "grad_w oracle pins equal ∂simple_loss/∂w_ij = x_ij/4 for x = [1, 2, 3, 4]" {
        fac {
            # Documented formula: simple_loss(x, w) = mean(x∘w) over 4
            # elements; ∂loss/∂w_ij = x_ij/4. f64 evaluations: [1/4, 2/4,
            # 3/4, 4/4] = [0.25, 0.5, 0.75, 1.0] — exact.
            adfirma GRAD_W_ORACLE_0 ≡ ((1.0 / 4.0) ∷ f32)
            adfirma GRAD_W_ORACLE_1 ≡ ((2.0 / 4.0) ∷ f32)
            adfirma GRAD_W_ORACLE_2 ≡ ((3.0 / 4.0) ∷ f32)
            adfirma GRAD_W_ORACLE_3 ≡ ((4.0 / 4.0) ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }
}
