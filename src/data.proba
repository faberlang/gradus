+++
locale = "en"
+++
# Co-located package test for data.fab (T2-U1 — the data/batch leaf).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * shuffle — deterministic Fisher–Yates over gradus:train Seed/Draw:
#     the same-seed ⇒ same-order pin (fresh seed and the chained advanced
#     seed), the golden permutation for seed 123 over the 10‥17 corpus
#     ([13, 17, 11, 12, 16, 14, 10, 15]), the single-element no-draw
#     contract, and the fail-closed rows (rank, dtype tag, empty corpus)
#     — message identity per validation.
#   * batch — order-preserving slicing with a short last batch: exact
#     division, short remainder, size == length, and the fail-closed
#     bounds negatives (empty corpus, size < 1, size > length) plus the
#     structural rejections shared with shuffle.
#
# Oracle pins: the golden permutations are exact i64 evaluations of the
# documented recurrence (train.fab xorshift64; concrete draw pins recorded
# in train.proba) run through the documented pick rule
# j = i + (draw ∧ 2^63−1) mod (n − i). The chained-seed pin evaluates the
# seed after seven draws from 123 (−1859521560095551381) as its input.
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/data.proba` proves the suite
# type-checks. Library-to-library calls execute on the FMIR stepper
# (radix 43c0102ba; regression-locked by 2e8042ae7). This suite remains
# compile-level proof; no runtime value identity is claimed here.

import from "gradus:data" data

import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

import from "gradus:train" train

import from "gradus:test_util" test_util

# ---- helpers (the metrics.proba pattern)

# The pin seed and the corpus under permutation (ids 10‥17).
const int SEED_A ← 123

fn corpus() → list<f32> {
    return [10.0, 11.0, 12.0, 13.0, 14.0, 15.0, 16.0, 17.0]
}

# Build an i32-tagged rank-1 token-id block (the metrics target carrier).
fn ids_block(list<f32> values) → tensor.NumericBlock {
    var list<int> shape ← empty
    shape.append(values.length())
    return test_util.or_default(() → tensor.NumericBlock ⇥ tensor.TensorError ∴ tensor.construct_dtype(values, shape, dtype.i32()), tensor.default())
}

# Build an f32-tagged block (the wrong-tag negative carrier).
fn f32_block(list<f32> values) → tensor.NumericBlock {
    var list<int> shape ← empty
    shape.append(values.length())
    return test_util.or_default(() → tensor.NumericBlock ⇥ tensor.TensorError ∴ tensor.construct_dtype(values, shape, dtype.f32()), tensor.default())
}

# Build a rank-2 i32 block (the wrong-rank negative carrier).
fn rank2_block(list<f32> values) → tensor.NumericBlock {
    var list<int> shape ← empty
    shape.append(values.length() / 2)
    shape.append(2)
    return test_util.or_default(() → tensor.NumericBlock ⇥ tensor.TensorError ∴ tensor.construct_dtype(values, shape, dtype.i32()), tensor.default())
}

# Seed helper, swallowing the never-firing construction error.
fn seed_p(int status) → train.Seed {
    return test_util.or_default(() → train.Seed ⇥ train.TrainError ∴ train.construct_seed(status), train.default())
}

# Renders a shuffle outcome as text: "ok" on success, the typed error's
# message on rejection.
fn shuffle_detail(tensor.NumericBlock ids, train.Seed seed) → string {
    const _ outcome ← trap {
        data.shuffle(ids, seed)
    }
    if outcome is data.Shuffled {
        return "ok"
    }
    const data.DataError err ← outcome
    return err.message
}

# Renders a batch outcome as text: "ok" on success, the typed error's
# message on rejection. The trap tail carries the batch count so the
# block lowers as an expression (the sample_detail shape).
fn batch_detail(tensor.NumericBlock ids, int batch_size) → string {
    const _ outcome ← trap {
        const list<tensor.NumericBlock> parts ← data.batch(ids, batch_size)
        parts.length()
    }
    if outcome is int {
        return "ok"
    }
    const data.DataError err ← outcome
    return err.message
}

# ---- shuffle: determinism + golden permutations

test "same seed produces the same order and the same advanced seed" {
    const _ trap_result_16 ← trap {
        const data.Shuffled a ← data.shuffle(ids_block(corpus()), seed_p(SEED_A))
        const data.Shuffled b ← data.shuffle(ids_block(corpus()), seed_p(SEED_A))
        assert a.payload.data ≡ ([13.0, 17.0, 11.0, 12.0, 16.0, 14.0, 10.0, 15.0] ↦ list<f32>)
        assert b.payload.data ≡ ([13.0, 17.0, 11.0, 12.0, 16.0, 14.0, 10.0, 15.0] ↦ list<f32>)
        assert a.seed.status ≡ b.seed.status
    }
    assert trap_result_16 is void
}

test "golden permutation: seed 123 over the ten-to-seventeen corpus" {
    # Exact i64 evaluation of the documented recurrence + pick rule;
    # the draws are the seed-123 stream of the xorshift64 pinned in
    # train.proba. Seven draws consumed — the seed advanced off its start.
    const _ trap_result_15 ← trap {
        const data.Shuffled sh ← data.shuffle(ids_block(corpus()), seed_p(SEED_A))
        assert sh.payload.data ≡ ([13.0, 17.0, 11.0, 12.0, 16.0, 14.0, 10.0, 15.0] ↦ list<f32>)
        assert sh.payload.shape ≡ ([8] ↦ list<int>)
        assert dtype.name(sh.payload.dtype) ≡ "i32"
        assert sh.seed.status ≠ SEED_A
    }
    assert trap_result_15 is void
}

test "the chained advanced seed reproduces its own order" {
    # The seed after seven draws from 123 (train.proba draw pins give
    # the recurrence); shuffling with it is deterministic too.
    const _ trap_result_14 ← trap {
        const train.Seed chained ← seed_p(0 - 1859521560095551381)
        const data.Shuffled a ← data.shuffle(ids_block(corpus()), chained)
        const data.Shuffled b ← data.shuffle(ids_block(corpus()), chained)
        assert a.payload.data ≡ ([13.0, 16.0, 15.0, 10.0, 11.0, 17.0, 12.0, 14.0] ↦ list<f32>)
        assert b.payload.data ≡ ([13.0, 16.0, 15.0, 10.0, 11.0, 17.0, 12.0, 14.0] ↦ list<f32>)
    }
    assert trap_result_14 is void
}

test "a single-element corpus shuffles to itself and consumes no draw" {
    # No position below n−1 exists — no draw, no advancement.
    const _ trap_result_13 ← trap {
        const data.Shuffled sh ← data.shuffle(ids_block([7.0]), seed_p(SEED_A))
        assert sh.payload.data ≡ ([7.0] ↦ list<f32>)
        assert sh.seed.status ≡ SEED_A
    }
    assert trap_result_13 is void
}

# ---- shuffle: fail-closed contract

test "shuffle rejects an empty corpus" {
    assert shuffle_detail(ids_block([]), seed_p(SEED_A)) ≡ "corpus is empty"
}

test "shuffle rejects a rank-2 corpus" {
    assert shuffle_detail(rank2_block([1.0, 2.0, 3.0, 4.0]), seed_p(SEED_A)) ≡ "token ids must be rank-1"
}

test "shuffle rejects an f32-tagged corpus" {
    assert shuffle_detail(f32_block(corpus()), seed_p(SEED_A)) ≡ "token ids must be i32"
}

# ---- batch: slicing contract

test "exact division: six ids at size three give two batches of three" {
    const _ trap_result_12 ← trap {
        const list<tensor.NumericBlock> parts ← data.batch(ids_block([30.0, 31.0, 32.0, 33.0, 34.0, 35.0]), 3)
        assert parts.length() ≡ 2
        const tensor.NumericBlock first ← parts.get(0) coalesce tensor.default()
        const tensor.NumericBlock second ← parts.get(1) coalesce tensor.default()
        assert first.data ≡ ([30.0, 31.0, 32.0] ↦ list<f32>)
        assert second.data ≡ ([33.0, 34.0, 35.0] ↦ list<f32>)
        assert first.shape ≡ ([3] ↦ list<int>)
        assert second.shape ≡ ([3] ↦ list<int>)
        assert dtype.name(first.dtype) ≡ "i32"
    }
    assert trap_result_12 is void
}

test "short last batch: five ids at size two give two/two/one" {
    const _ trap_result_11 ← trap {
        const list<tensor.NumericBlock> parts ← data.batch(ids_block([40.0, 41.0, 42.0, 43.0, 44.0]), 2)
        assert parts.length() ≡ 3
        const tensor.NumericBlock first ← parts.get(0) coalesce tensor.default()
        const tensor.NumericBlock second ← parts.get(1) coalesce tensor.default()
        const tensor.NumericBlock last ← parts.get(2) coalesce tensor.default()
        assert first.data ≡ ([40.0, 41.0] ↦ list<f32>)
        assert second.data ≡ ([42.0, 43.0] ↦ list<f32>)
        assert last.data ≡ ([44.0] ↦ list<f32>)
        assert first.shape ≡ ([2] ↦ list<int>)
        assert last.shape ≡ ([1] ↦ list<int>)
    }
    assert trap_result_11 is void
}

test "batch size equal to the corpus length yields the whole corpus" {
    const _ trap_result_10 ← trap {
        const list<tensor.NumericBlock> parts ← data.batch(ids_block(corpus()), 8)
        assert parts.length() ≡ 1
        const tensor.NumericBlock whole ← parts.get(0) coalesce tensor.default()
        assert whole.data ≡ ([10.0, 11.0, 12.0, 13.0, 14.0, 15.0, 16.0, 17.0] ↦ list<f32>)
    }
    assert trap_result_10 is void
}

# ---- batch: fail-closed bounds

test "batch rejects an empty corpus" {
    assert batch_detail(ids_block([]), 2) ≡ "corpus is empty"
}

test "batch rejects a zero batch size" {
    assert batch_detail(ids_block(corpus()), 0) ≡ "batch size must be at least 1"
}

test "batch rejects a negative batch size" {
    assert batch_detail(ids_block(corpus()), 0 - 1) ≡ "batch size must be at least 1"
}

test "batch rejects a batch size above the corpus length" {
    assert batch_detail(ids_block(corpus()), 9) ≡ "batch size exceeds corpus length"
}

test "batch rejects a rank-2 corpus" {
    assert batch_detail(rank2_block([1.0, 2.0, 3.0, 4.0]), 2) ≡ "token ids must be rank-1"
}

test "batch rejects an f32-tagged corpus" {
    assert batch_detail(f32_block(corpus()), 2) ≡ "token ids must be i32"
}
