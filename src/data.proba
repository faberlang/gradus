+++
locale = "en"
+++
# Co-located package test for data.fab (T2-U1 — the data/batch leaf).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * shuffle — deterministic Fisher–Yates over gradus:train Seed/Draw:
#     the same-seed ⇒ same-order pin (fresh seed and the chained advanced
#     seed), the golden permutation for seed 123 over the 10‥17 corpus
#     ([13, 17, 11, 12, 16, 14, 10, 15]), the single-element no-draw
#     contract, and the fail-closed empty-corpus row — message identity per
#     validation.
#   * batch — order-preserving slicing with a short last batch: exact
#     division, short remainder, size == length, and the fail-closed
#     bounds negatives (empty corpus, size < 1, size > length).
#
# Oracle pins: the golden permutations are exact i64 evaluations of the
# documented recurrence (train.fab xorshift64; concrete draw pins recorded
# in train.proba) run through the documented pick rule
# j = i + (draw ∧ 2^63−1) mod (n − i). The chained-seed pin evaluates the
# seed after seven draws from 123 (−1859521560095551381) as its input.
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber test src/data.proba` runs the suite through the
# package test route. Library-to-library calls execute on the FMIR stepper
# (radix 43c0102ba; regression-locked by 2e8042ae7). This suite remains
# compile-level proof; no runtime value identity is claimed here.

import from "gradus:data" data
import from "norma:fs" fs

import from "gradus:train" train

# ---- helpers (the metrics.proba pattern)

# The pin seed and the corpus under permutation (ids 10‥17).
const int SEED_A = 123

fn corpus() → list<int> {
    return [10, 11, 12, 13, 14, 15, 16, 17]
}

# Seed helper, swallowing the never-firing construction error.
fn seed_p(int status) → train.Seed {
    return train.construct_seed(status) ⊥ train.default()
}

# Renders a shuffle outcome as text: "ok" on success, the typed error's
# message on rejection.
fn shuffle_detail(list<int> ids, train.Seed seed) → string {
    let _ outcome ← trap {
        data.shuffle(ids, seed)
    }
    if outcome is data.Shuffled {
        return "ok"
    }
    let data.DataError err ← outcome
    return err.message
}

# Renders a batch outcome as text: "ok" on success, the typed error's
# message on rejection. The trap tail carries the batch count so the
# block lowers as an expression (the sample_detail shape).
fn batch_detail(list<int> ids, int batch_size) → string {
    let _ outcome ← trap {
        let list<list<int>> parts ← data.batch(ids, batch_size)
        parts.length()
    }
    if outcome is int {
        return "ok"
    }
    let data.DataError err ← outcome
    return err.message
}

# ---- shuffle: determinism + golden permutations

test "same seed produces the same order and the same advanced seed" {
    let _ trap_result_16 ← trap {
        let data.Shuffled a ← data.shuffle(corpus(), seed_p(SEED_A))
        let data.Shuffled b ← data.shuffle(corpus(), seed_p(SEED_A))
        assert a.payload ≡ ([13, 17, 11, 12, 16, 14, 10, 15] ↦ list<int>)
        assert b.payload ≡ ([13, 17, 11, 12, 16, 14, 10, 15] ↦ list<int>)
        assert a.seed.status ≡ b.seed.status
    }
    assert trap_result_16 is void
}

test "golden permutation: seed 123 over the ten-to-seventeen corpus" {
    # Exact i64 evaluation of the documented recurrence + pick rule;
    # the draws are the seed-123 stream of the xorshift64 pinned in
    # train.proba. Seven draws consumed — the seed advanced off its start.
    let _ trap_result_15 ← trap {
        let data.Shuffled sh ← data.shuffle(corpus(), seed_p(SEED_A))
        assert sh.payload ≡ ([13, 17, 11, 12, 16, 14, 10, 15] ↦ list<int>)
        assert sh.seed.status ≢ SEED_A
    }
    assert trap_result_15 is void
}

test "the chained advanced seed reproduces its own order" {
    # The seed after seven draws from 123 (train.proba draw pins give
    # the recurrence); shuffling with it is deterministic too.
    let _ trap_result_14 ← trap {
        let train.Seed chained ← seed_p(0 - 1859521560095551381)
        let data.Shuffled a ← data.shuffle(corpus(), chained)
        let data.Shuffled b ← data.shuffle(corpus(), chained)
        assert a.payload ≡ ([13, 16, 15, 10, 11, 17, 12, 14] ↦ list<int>)
        assert b.payload ≡ ([13, 16, 15, 10, 11, 17, 12, 14] ↦ list<int>)
    }
    assert trap_result_14 is void
}

test "a single-element corpus shuffles to itself and consumes no draw" {
    # No position below n−1 exists — no draw, no advancement.
    let _ trap_result_13 ← trap {
        let data.Shuffled sh ← data.shuffle([7], seed_p(SEED_A))
        assert sh.payload ≡ ([7] ↦ list<int>)
        assert sh.seed.status ≡ SEED_A
    }
    assert trap_result_13 is void
}

# ---- shuffle: fail-closed contract

test "shuffle rejects an empty corpus" {
    assert shuffle_detail([], seed_p(SEED_A)) ≡ "corpus is empty"
}

# ---- batch: slicing contract

test "exact division: six ids at size three give two batches of three" {
    let _ trap_result_12 ← trap {
        let list<list<int>> parts ← data.batch([30, 31, 32, 33, 34, 35], 3)
        assert parts.length() ≡ 2
        let list<int> first ← parts.get(0) coalesce ([] ∷ list<int>)
        let list<int> second ← parts.get(1) coalesce ([] ∷ list<int>)
        assert first ≡ ([30, 31, 32] ↦ list<int>)
        assert second ≡ ([33, 34, 35] ↦ list<int>)
    }
    assert trap_result_12 is void
}

test "short last batch: five ids at size two give two/two/one" {
    let _ trap_result_11 ← trap {
        let list<list<int>> parts ← data.batch([40, 41, 42, 43, 44], 2)
        assert parts.length() ≡ 3
        let list<int> first ← parts.get(0) coalesce ([] ∷ list<int>)
        let list<int> second ← parts.get(1) coalesce ([] ∷ list<int>)
        let list<int> last ← parts.get(2) coalesce ([] ∷ list<int>)
        assert first ≡ ([40, 41] ↦ list<int>)
        assert second ≡ ([42, 43] ↦ list<int>)
        assert last ≡ ([44] ↦ list<int>)
    }
    assert trap_result_11 is void
}

test "batch size equal to the corpus length yields the whole corpus" {
    let _ trap_result_10 ← trap {
        let list<list<int>> parts ← data.batch(corpus(), 8)
        assert parts.length() ≡ 1
        let list<int> whole ← parts.get(0) coalesce ([] ∷ list<int>)
        assert whole ≡ ([10, 11, 12, 13, 14, 15, 16, 17] ↦ list<int>)
    }
    assert trap_result_10 is void
}

# ---- batch: fail-closed bounds

test "batch rejects an empty corpus" {
    assert batch_detail([], 2) ≡ "corpus is empty"
}

test "batch rejects a zero batch size" {
    assert batch_detail(corpus(), 0) ≡ "batch size must be at least 1"
}

test "batch rejects a negative batch size" {
    assert batch_detail(corpus(), 0 - 1) ≡ "batch size must be at least 1"
}

test "batch rejects a batch size above the corpus length" {
    assert batch_detail(corpus(), 9) ≡ "batch size exceeds corpus length"
}

# ---- LM byte vocabulary and corpus identity

fn lm_byte_id_rejected(int id) → bool {
    let _ id_outcome ← trap {
        data.lm_vocabulary_id(id)
    }
    if id_outcome is int {
        return false
    }
    let _ byte_outcome ← trap {
        data.lm_vocabulary_byte(id)
    }
    if byte_outcome is int {
        return false
    }
    return true
}

test "lm byte ids round-trip through the byte vocabulary" {
    let _ trap_result ← trap {
        assert data.lm_vocabulary_id(0) ≡ 0
        assert data.lm_vocabulary_id(65) ≡ 65
        assert data.lm_vocabulary_id(255) ≡ 255
        assert data.lm_vocabulary_byte(0) ≡ 0
        assert data.lm_vocabulary_byte(65) ≡ 65
        assert data.lm_vocabulary_byte(255) ≡ 255
        assert lm_byte_id_rejected(256)
        assert lm_byte_id_rejected(257)
    }
    assert trap_result is void
}

test "lm vocabulary reserves the pad id outside the byte range" {
    assert data.LM_PAD_ID ≡ 256
    assert data.LM_VOCAB_SIZE ≡ 257
    assert data.lm_is_vocabulary_id(256)
    assert not data.lm_is_vocabulary_id(257)
    assert lm_byte_id_rejected(256)
}

test "lm corpus identity is stable and separates document boundaries" {
    let list<list<int>> documents ← [[1, 2], [3]]
    let string identity ← data.lm_corpus_identity(documents)
    assert identity ≡ "d2:1,2;d1:3;"

    mut list<int> first ← empty
    first.append(1)
    first.append(2)
    mut list<int> second ← empty
    second.append(3)
    mut list<list<int>> rebuilt ← empty
    rebuilt.append(first)
    rebuilt.append(second)
    assert data.lm_corpus_identity(rebuilt) ≡ identity
    assert data.lm_corpus_identity([[1], [2, 3]]) ≢ identity
}

test "lm document score follows its formula" {
    assert data.lm_document_score([1, 2]) ≡ 5
    assert data.lm_document_score([1, 2, 0]) ≡ 6
}

# -------------------------------------------------------------------------
# LM fixed-width next-token windows
# -------------------------------------------------------------------------

fn lm_window_mask_sum(list<int> mask) → int {
    mut int total ← 0
    for range 0 ‥ mask.length() let i {
        total ← total + (mask.get(i) coalesce 0)
    }
    return total
}

test "lm windows shift each target one position past its input" {
    let _ trap_result ← trap {
        let list<data.LmWindow> windows ← data.lm_windows([10, 11, 12, 13, 14, 15, 16], 3, 42)
        assert windows.length() ≡ 3
        let data.LmWindow first ← windows.get(0) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
        let data.LmWindow second ← windows.get(1) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
        let data.LmWindow third ← windows.get(2) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
        assert first.inputs ≡ ([10, 11, 12] ↦ list<int>)
        assert first.targets ≡ ([11, 12, 13] ↦ list<int>)
        assert second.inputs ≡ ([13, 14, 15] ↦ list<int>)
        assert second.targets ≡ ([14, 15, 16] ↦ list<int>)
        assert third.inputs ≡ ([16, 256, 256] ↦ list<int>)
        assert third.targets ≡ ([256, 256, 256] ↦ list<int>)
        assert first.document ≡ 42
        assert first.start ≡ 0
        assert second.start ≡ 3
        assert third.start ≡ 6
    }
    assert trap_result is void
}

test "lm windows right-pad a short final window and zero its mask" {
    let _ trap_result ← trap {
        let list<data.LmWindow> windows ← data.lm_windows([10, 11, 12, 13, 14, 15, 16], 3, 42)
        let data.LmWindow third ← windows.get(2) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
        assert third.inputs ≡ ([16, 256, 256] ↦ list<int>)
        assert third.loss_mask ≡ ([0, 0, 0] ↦ list<int>)
    }
    assert trap_result is void
}

test "lm window mask counts equal the number of real adjacent pairs" {
    let _ trap_result ← trap {
        let list<int> tokens ← [10, 11, 12, 13, 14, 15, 16]
        let list<data.LmWindow> windows ← data.lm_windows(tokens, 3, 42)
        let data.LmWindow first ← windows.get(0) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
        let data.LmWindow second ← windows.get(1) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
        let data.LmWindow third ← windows.get(2) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
        assert lm_window_mask_sum(first.loss_mask) ≡ 3
        assert lm_window_mask_sum(second.loss_mask) ≡ 3
        assert lm_window_mask_sum(third.loss_mask) ≡ 0
        assert lm_window_mask_sum(first.loss_mask) + lm_window_mask_sum(second.loss_mask) + lm_window_mask_sum(third.loss_mask) ≡ tokens.length() - 1
    }
    assert trap_result is void
}


# ---- LM document-level training/validation split

fn lm_split_is_partition(list<list<int>> documents, data.LmSplit split) → bool {
    if split.training.length() + split.validation.length() ≢ documents.length() {
        return false
    }
    for range 0 ‥ documents.length() let i {
        let list<int> document ← documents.get(i) coalesce ([] ∷ list<int>)
        mut int occurrences ← 0
        for range 0 ‥ split.training.length() let j {
            if (split.training.get(j) coalesce ([] ∷ list<int>)) ≡ document {
                occurrences ← occurrences + 1
            }
        }
        for range 0 ‥ split.validation.length() let j {
            if (split.validation.get(j) coalesce ([] ∷ list<int>)) ≡ document {
                occurrences ← occurrences + 1
            }
        }
        if occurrences ≢ 1 {
            return false
        }
    }
    return true
}

fn lm_id_belongs_to_range(int id, int base) → bool {
    return id ≡ data.LM_PAD_ID or (id ≥ base and id ≺ base + 100)
}

fn lm_split_windows_stay_local(list<list<int>> documents) → bool ⇥ data.DataError {
    for range 0 ‥ documents.length() let i {
        let list<int> document ← documents.get(i) coalesce ([] ∷ list<int>)
        let int first ← document.get(0) coalesce 0
        let int base ← (first / 100) * 100
        let list<data.LmWindow> windows ← data.lm_windows(document, 3, i)
        for range 0 ‥ windows.length() let j {
            let data.LmWindow window ← windows.get(j) coalesce data.LmWindow { document = 0, start = 0, inputs = empty, targets = empty, loss_mask = empty }
            for range 0 ‥ window.inputs.length() let k {
                let int input_id ← window.inputs.get(k) coalesce data.LM_PAD_ID
                let int target_id ← window.targets.get(k) coalesce data.LM_PAD_ID
                if not lm_id_belongs_to_range(input_id, base) {
                    return false
                }
                if not lm_id_belongs_to_range(target_id, base) {
                    return false
                }
            }
        }
    }
    return true
}

test "lm split assigns whole documents and never shares one" {
    let _ trap_result ← trap {
        let list<list<int>> documents ← [[1, 2], [3, 4], [5, 6]]
        let data.LmSplit split ← data.lm_split_documents(documents, 3)
        assert split.validation ≡ ([[3, 4]] ↦ list<list<int>>)
        assert split.training ≡ ([[1, 2], [5, 6]] ↦ list<list<int>>)
        assert lm_split_is_partition(documents, split)
    }
    assert trap_result is void
}

test "lm split is independent of document order" {
    let _ trap_result ← trap {
        let list<list<int>> reversed ← [[5, 6], [3, 4], [1, 2]]
        let data.LmSplit split ← data.lm_split_documents(reversed, 3)
        assert split.validation ≡ ([[3, 4]] ↦ list<list<int>>)
        assert split.training ≡ ([[5, 6], [1, 2]] ↦ list<list<int>>)
        assert lm_split_is_partition(reversed, split)
    }
    assert trap_result is void
}

test "lm split keeps every window inside one document" {
    let _ trap_result ← trap {
        # Each document occupies its own 100-id range. The score modulus puts
        # the first document in validation and the other two in training.
        let list<list<int>> documents ← [[1, 2], [103, 104], [205, 206]]
        let data.LmSplit split ← data.lm_split_documents(documents, 5)
        assert lm_split_windows_stay_local(split.training)
        assert lm_split_windows_stay_local(split.validation)
    }
    assert trap_result is void
}

# ---- restartable LM cursor wire and window iteration

test "lm cursor wire round-trips all fields" {
    let data.LmCursor cursor ← data.LmCursor { corpus = "12,34:56;", split = "validation", document = 17, window = 23 }
    let string wire ← data.lm_cursor_wire(cursor)
    assert wire ≡ "lm-cursor-v1#12,34:56;#validation#17#23"
    let _ parsed_value ← data.lm_cursor_parse(wire)
    assert parsed_value not is none
    let data.LmCursor parsed ← parsed_value coalesce data.LmCursor { corpus = "", split = "", document = -1, window = 0 }
    assert parsed.corpus ≡ cursor.corpus
    assert parsed.split ≡ cursor.split
    assert parsed.document ≡ cursor.document
    assert parsed.window ≡ cursor.window
}

test "a cursor restored from its wire yields the same next window" {
    let list<list<int>> documents ← [[10, 11, 12, 13, 14], [20, 21], [30, 31, 32, 33]]
    let data.LmSplit split ← data.LmSplit { training = [[10, 11, 12, 13, 14], [30, 31, 32, 33]], validation = [[20, 21]] }
    let data.LmCursor cursor ← data.LmCursor { corpus = "123;456;", split = "training", document = 0, window = 1 }
    let _ live_value ← data.lm_cursor_next(documents, split, cursor, 2)
    assert live_value not is none
    let data.LmWindow live ← live_value coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    let _ parsed_value ← data.lm_cursor_parse(data.lm_cursor_wire(cursor))
    assert parsed_value not is none
    let data.LmCursor restored ← parsed_value coalesce data.LmCursor { corpus = "", split = "", document = -1, window = 0 }
    let _ resumed_value ← data.lm_cursor_next(documents, split, restored, 2)
    assert resumed_value not is none
    let data.LmWindow resumed ← resumed_value coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    assert live.document ≡ resumed.document
    assert live.start ≡ resumed.start
    assert live.inputs ≡ resumed.inputs
    assert live.targets ≡ resumed.targets
    assert live.loss_mask ≡ resumed.loss_mask
}

test "advancing a cursor lands on the window that next returns" {
    let list<list<int>> documents ← [[10, 11, 12, 13, 14], [20, 21], [], [30, 31, 32, 33]]
    let data.LmSplit split ← data.LmSplit { training = [[10, 11, 12, 13, 14], [], [30, 31, 32, 33]], validation = [[20, 21]] }
    let data.LmCursor start ← data.lm_cursor_start("123;456;", "training")
    assert start.document ≡ -1
    assert start.window ≡ 0
    let _ advanced_value ← data.lm_cursor_advance(documents, split, start, 2)
    assert advanced_value not is none
    let data.LmCursor advanced ← advanced_value coalesce data.LmCursor { corpus = "", split = "", document = -1, window = 0 }
    let data.LmWindow following ← data.lm_cursor_next(documents, split, advanced, 2) coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    assert following.document ≡ advanced.document
    assert following.start ≡ advanced.window * 2
    assert following.document ≡ 0
    assert following.start ≡ 2
    let _ to_last_value ← data.lm_cursor_advance(documents, split, advanced, 2)
    assert to_last_value not is none
    let data.LmCursor to_last ← to_last_value coalesce data.LmCursor { corpus = "", split = "", document = -1, window = 0 }
    assert to_last.document ≡ 0
    assert to_last.window ≡ 2
    let _ crossed_value ← data.lm_cursor_advance(documents, split, to_last, 2)
    assert crossed_value not is none
    let data.LmCursor crossed ← crossed_value coalesce data.LmCursor { corpus = "", split = "", document = -1, window = 0 }
    let _ crossed_window_value ← data.lm_cursor_next(documents, split, crossed, 2)
    assert crossed_window_value not is none
    let data.LmWindow crossed_window ← crossed_window_value coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    assert crossed_window.document ≡ crossed.document
    assert crossed_window.start ≡ crossed.window * 2
    assert crossed.document ≡ 3
    assert crossed.window ≡ 0
}

test "lm cursor reports exhaustion at the end of its split" {
    let list<list<int>> documents ← [[1, 2], [3, 4], []]
    let data.LmSplit split ← data.LmSplit { training = [[1, 2]], validation = [[3, 4], []] }
    let data.LmCursor validation_start ← data.lm_cursor_start("", "validation")
    let data.LmWindow validation_window ← data.lm_cursor_next(documents, split, validation_start, 2) coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    assert validation_window.document ≡ 1
    let data.LmCursor last ← data.LmCursor { corpus = "", split = "training", document = 0, window = 0 }
    let data.LmWindow window ← data.lm_cursor_next(documents, split, last, 2) coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    assert window.document ≡ 0
    let _ after_last ← data.lm_cursor_advance(documents, split, last, 2)
    assert after_last is none
    let _ exhausted ← data.lm_cursor_next(documents, split, data.LmCursor { corpus = "", split = "training", document = 0, window = 1 }, 2)
    assert exhausted is none
}

test "lm cursor parse rejects a malformed wire with none" {
    assert data.lm_cursor_parse("lm-cursor-v2#12;#training#0#0") is none
    assert data.lm_cursor_parse("lm-cursor-v1#12;#training#0") is none
    assert data.lm_cursor_parse("lm-cursor-v1#12;#training#x#0") is none
    assert data.lm_cursor_parse("lm-cursor-v1#12;#training#0#2x") is none
}

# ---- cursor persistence: the file on disk is the only state a fresh process
# needs. The save writes exactly the cursor wire, the load parses it back, and
# a missing file loads as none rather than a guessed cursor.

# Remove a scratch cursor file; an absent file is already the wanted state.
fn lm_cursor_discard(string path) → none {
    do {
        fs.delete(path)
    }
    catch err {
    }
}

test "a cursor saved to disk resumes at the same next window" {
    let string path ← fs.join([fs.temp_dir(), "lm_cursor_resume.tmp"])
    # Original-corpus documents: index 0 and 1 are training, index 2 is
    # validation. The cursor sits at a non-zero document and a non-zero window.
    let list<list<int>> documents ← [[10, 11, 12, 13, 14], [30, 31, 32, 33, 34, 35], [20, 21]]
    let data.LmSplit split ← data.LmSplit { training = [[10, 11, 12, 13, 14], [30, 31, 32, 33, 34, 35]], validation = [[20, 21]] }
    let data.LmCursor cursor ← data.LmCursor { corpus = "123;456;", split = "training", document = 1, window = 1 }
    data.lm_cursor_save(path, cursor)
    let _ loaded_value ← data.lm_cursor_load(path)
    assert loaded_value not is none
    let data.LmCursor loaded ← loaded_value coalesce data.LmCursor { corpus = "", split = "", document = -1, window = 0 }
    assert loaded.document ≢ -1
    assert loaded.window ≢ 0
    let data.LmWindow original ← data.lm_cursor_next(documents, split, cursor, 2) coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    let data.LmWindow resumed ← data.lm_cursor_next(documents, split, loaded, 2) coalesce data.LmWindow { document = -1, start = -1, inputs = empty, targets = empty, loss_mask = empty }
    assert resumed.document ≡ original.document
    assert resumed.start ≡ original.start
    assert resumed.inputs ≡ original.inputs
    assert resumed.targets ≡ original.targets
    assert resumed.loss_mask ≡ original.loss_mask
    lm_cursor_discard(path)
}

test "lm cursor load returns none for a missing file" {
    let string path ← fs.join([fs.temp_dir(), "lm_cursor_absent.tmp"])
    lm_cursor_discard(path)
    assert data.lm_cursor_load(path) is none
}
