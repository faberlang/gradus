+++
locale = "la"
+++
# Co-located package test for sampling.fab (PML5-U3 — deterministic token
# sampling). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * greedy exactness — maxima returns the argmax (first-index ties),
#     and temperatura <= 0 routes sors to the greedy path with the Semen
#     unchanged.
#   * the pinned pipeline — distributio (logits + config + history →
#     filtered probabilities) matches the f64 oracle pins per knob:
#     temperature, top-k, top-p, min-p, repetition penalty, and their
#     combination (approximata within the documented 5e-4 tolerance).
#   * deterministic draws — sors (logits + config + history + Semen)
#     returns the oracle-pinned token for each pinned seed; the outcome
#     carries the ADVANCED Semen (the RNG continuation is explicit).
#   * purity — equal inputs produce equal distributions and equal tokens
#     (no hidden state); the draw consumes the RNG state (the advanced
#     status differs from the seed).
#   * fail-closed rows — empty logits, invalid config knobs, and history
#     tokens outside the vocabulary reject with the typed causa.
#
# Oracle pins: f64 evaluations of the documented pipeline (the same
# arithmetic the train.proba xorshift pins and the loss.proba exp pins
# use) for the pinned logits V=5 [2.0, 1.5, 0.0, -1.0, 3.0]:
#   temp 1.0 plain    dist [0.2217326936, 0.1344876769, 0.0300082569,
#                           0.0110394208, 0.6027319518]
#   temp 2.0 plain    dist [0.2488471128, 0.1938023263, 0.0915457368,
#                           0.0555252961, 0.410279528]
#   top-k 2           dist [0.2424661125, 0.0328142200, 0.0328142200,
#                           0.0328142200, 0.6590912275]
#   top-p 0.7         dist [0.2689414214, 0, 0, 0, 0.7310585786]
#   min-p 0.3         dist [0.2689414214, 0, 0, 0, 0.7310585786]
#   rep 2.0, hist [0,4] penalized [1.0, 1.5, 0.0, -1.0, 1.5];
#                     dist [0.2083048101, 0.3434365712, 0.0766310571,
#                           0.0281909905, 0.3434365712]
#   rep 2.0, hist [2,3] penalized [2.0, 1.5, 0.0, -2.0, 3.0];
#                     dist [0.2232908720, 0.1354327599, 0.0302191334,
#                           0.0040897150, 0.6069675198]
#   full (t1.5 k3 p0.8 m0.25 rep1.5 hist[2]) dist [0.2729060000,
#                   0.1955456938, 0, 0, 0.5315483062]
#   greedy (temp 0)   degenerate one-hot at the argmax (index 4).
# Seed pins (first draw of the xorshift64 seam, model-independent):
#   seed 1234567890123456789  u ≈ 0.245768647  (s_a)
#   seed 5428186273191027194  u ≈ 0.383910162  (s_b)
#   seed 730019052841267308   u ≈ 0.773805557  (s_c)
# The pinned draws sit > 2e-3 from every cumulative boundary (f32/f64
# drift is ~1e-6), so the token pins are boundary-safe.
#
# EVIDENCE HONESTY (CTO Q2, hard): this suite is STRUCTURAL proof. No
# executed token value is claimed; the pins are f64 evaluations of the
# documented formulas and the documented xorshift draws. Executed
# value-identity is env-blocked tree-wide today (FMIR stepper /
# library-import gap — the PML4 closeout recorded both blockers; neither
# is fixed here). PML5-U3 is PARTIAL and token value-identity is deferred
# to the auditor-owned runtime-evidence gate.
#
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/sampling.proba` proves the suite
# type-checks. Execution of proba bodies is env-blocked tree-wide today
# (recorded residual); this suite is the compile-level proof of the
# contract.

importa ex "gradus:sampling" sampling
importa ex "gradus:train" train

# ---- helpers

# The pinned logits vector (V=5).
functio logits_p() → lista<f32> {
    redde [2.0, 1.5, 0.0, (0.0 - 1.0) ∷ f32, 3.0]
}

# A config built through the validated constructor (swallow never-firing
# errors).
functio config_p(f32 temperatura, numerus top_k, f32 top_p, f32 min_p, f32 poena) → sampling.Configura {
    varia sampling.Configura c
    fac {
        c ← sampling.structa_configura(temperatura, top_k, top_p, min_p, poena)
    }
    cape err {
        redde c
    }
    redde c
}

# The plain temperature-1 config (no filters, no penalty).
functio config_simplex() → sampling.Configura {
    redde config_p(1.0, 0, 0.0, 0.0, 1.0)
}

# Element read with a default.
functio p(lista<f32> xs, numerus i) → f32 {
    redde xs.accipe(i) vel (0.0 - 999.0) ∷ f32
}

# A seeded Semen built through the validated constructor (swallow
# never-firing errors; the pinned seeds are non-zero).
functio semen_p(numerus semen) → train.Semen {
    varia train.Semen s
    fac {
        s ← train.structa_semen(semen)
        redde s
    }
    cape err {
        redde s
    }
    redde s
}

# The greedy argmax (swallow errors -> -1).
functio maxima_value(lista<f32> logits) → numerus {
    fac {
        fixum numerus t ← sampling.maxima(logits)
        redde t
    }
    cape err {
        redde (0 - 1)
    }
}

# The filtered distribution as a list (swallow errors -> empty list).
functio distributio_p(lista<f32> logits, sampling.Configura c, lista<numerus> hist) → lista<f32> {
    varia lista<f32> d
    fac {
        d ← sampling.distributio(logits, c, hist)
        redde d
    }
    cape err {
        redde d
    }
    redde d
}

# The drawn token id (swallow errors -> -1).
functio sors_token(lista<f32> logits, sampling.Configura c, lista<numerus> hist, train.Semen s) → numerus {
    fac {
        fixum sampling.Sortitio r ← sampling.sors(logits, c, hist, s)
        redde r.token_id()
    }
    cape err {
        redde (0 - 1)
    }
}

# The advanced RNG status after a draw (swallow errors -> 0).
functio sors_status(lista<f32> logits, sampling.Configura c, lista<numerus> hist, train.Semen s) → numerus {
    fac {
        fixum sampling.Sortitio r ← sampling.sors(logits, c, hist, s)
        redde r.semen().status()
    }
    cape err {
        redde 0
    }
}

# Renders a sors outcome as textus (the token or the typed causa).
functio sors_detail(lista<f32> logits, sampling.Configura c, lista<numerus> hist, train.Semen s) → textus {
    fac {
        fixum sampling.Sortitio _ ← sampling.sors(logits, c, hist, s)
        redde "ok"
    }
    cape err {
        redde sampling.causa(err)
    }
}

# Renders a maxima outcome as textus.
functio maxima_detail(lista<f32> logits) → textus {
    fac {
        fixum numerus _ ← sampling.maxima(logits)
        redde "ok"
    }
    cape err {
        redde sampling.causa(err)
    }
}

# Renders a config-construction outcome as textus.
functio config_detail(f32 temperatura, numerus top_k, f32 top_p, f32 min_p, f32 poena) → textus {
    fac {
        fixum sampling.Configura _ ← sampling.structa_configura(temperatura, top_k, top_p, min_p, poena)
        redde "ok"
    }
    cape err {
        redde sampling.causa(err)
    }
}

# ---- oracle tolerance (the decode.proba 5e-4 convention)

fixum f32 SAMPLING_TOLERATIO ← (0.0005 ∷ f32)

# The pinned seeds (i64-safe; the first draws are model-independent).
fixum numerus SEMEN_A ← 1234567890123456789
fixum numerus SEMEN_B ← 5428186273191027194
fixum numerus SEMEN_C ← 730019052841267308

# ---- greedy exactness

probandum "sampling — greedy path exact" {
    proba "maxima returns the argmax of the pinned logits" {
        adfirma maxima_value(logits_p()) ≡ 4
    }

    proba "maxima breaks ties to the first index" {
        adfirma maxima_value([1.0, 2.0, 2.0]) ≡ 1
    }

    proba "maxima returns index 0 when the first element is the max" {
        adfirma maxima_value([5.0, 1.0, 0.0]) ≡ 0
    }

    proba "temperatura 0 routes sors to the greedy path with the semen unchanged" {
        fac {
            fixum train.Semen s ← semen_p(SEMEN_A)
            fixum sampling.Sortitio r ← sampling.sors(logits_p(), config_p(0.0, 0, 0.0, 0.0, 1.0), [], s)
            adfirma r.token_id() ≡ 4
            adfirma r.semen().status() ≡ SEMEN_A
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the greedy distribution is degenerate one-hot at the argmax" {
        fixum lista<f32> d ← distributio_p(logits_p(), config_p(0.0, 0, 0.0, 0.0, 1.0), [])
        adfirma p(d, 0).approximata(0.0, SAMPLING_TOLERATIO)
        adfirma p(d, 1).approximata(0.0, SAMPLING_TOLERATIO)
        adfirma p(d, 2).approximata(0.0, SAMPLING_TOLERATIO)
        adfirma p(d, 3).approximata(0.0, SAMPLING_TOLERATIO)
        adfirma p(d, 4).approximata(1.0, SAMPLING_TOLERATIO)
    }
}

# ---- temperature

probandum "sampling — temperature knob" {
    proba "temperature 1 distribution matches the f64 oracle" {
        fixum lista<f32> d ← distributio_p(logits_p(), config_simplex(), [])
        adfirma p(d, 0).approximata((0.2217326936 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 1).approximata((0.1344876769 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 2).approximata((0.0300082569 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 3).approximata((0.0110394208 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 4).approximata((0.6027319518 ∷ f32), SAMPLING_TOLERATIO)
    }

    proba "temperature 2 distribution matches the f64 oracle" {
        fixum lista<f32> d ← distributio_p(logits_p(), config_p(2.0, 0, 0.0, 0.0, 1.0), [])
        adfirma p(d, 0).approximata((0.2488471128 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 1).approximata((0.1938023263 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 2).approximata((0.0915457368 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 3).approximata((0.0555252961 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 4).approximata((0.4102795280 ∷ f32), SAMPLING_TOLERATIO)
    }

    proba "temperature 1 draws the pinned tokens" {
        fac {
            fixum train.Semen sa ← semen_p(SEMEN_A)
            fixum train.Semen sb ← semen_p(SEMEN_B)
            fixum train.Semen sc ← semen_p(SEMEN_C)
            adfirma sors_token(logits_p(), config_simplex(), [], sa) ≡ 1
            adfirma sors_token(logits_p(), config_simplex(), [], sb) ≡ 2
            adfirma sors_token(logits_p(), config_simplex(), [], sc) ≡ 4
        }
        cape err {
            adfirma falsum
        }
    }

    proba "temperature 2 draws the pinned tokens" {
        fac {
            fixum train.Semen sa ← semen_p(SEMEN_A)
            fixum train.Semen sb ← semen_p(SEMEN_B)
            fixum train.Semen sc ← semen_p(SEMEN_C)
            adfirma sors_token(logits_p(), config_p(2.0, 0, 0.0, 0.0, 1.0), [], sa) ≡ 0
            adfirma sors_token(logits_p(), config_p(2.0, 0, 0.0, 0.0, 1.0), [], sb) ≡ 1
            adfirma sors_token(logits_p(), config_p(2.0, 0, 0.0, 0.0, 1.0), [], sc) ≡ 4
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- top-k

probandum "sampling — top-k knob" {
    proba "top-k 2 distribution keeps the two largest logits and renormalizes" {
        fixum lista<f32> d ← distributio_p(logits_p(), config_p(1.0, 2, 0.0, 0.0, 1.0), [])
        adfirma p(d, 0).approximata((0.2424661125 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 1).approximata((0.0328142200 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 2).approximata((0.0328142200 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 3).approximata((0.0328142200 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 4).approximata((0.6590912275 ∷ f32), SAMPLING_TOLERATIO)
    }

    proba "top-k 2 draws the pinned tokens" {
        fac {
            fixum train.Semen sa ← semen_p(SEMEN_A)
            fixum train.Semen sb ← semen_p(SEMEN_B)
            adfirma sors_token(logits_p(), config_p(1.0, 2, 0.0, 0.0, 1.0), [], sa) ≡ 1
            adfirma sors_token(logits_p(), config_p(1.0, 2, 0.0, 0.0, 1.0), [], sb) ≡ 4
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- top-p (nucleus)

probandum "sampling — top-p knob" {
    proba "top-p 0.7 keeps the nucleus {0, 4} and renormalizes" {
        fixum lista<f32> d ← distributio_p(logits_p(), config_p(1.0, 0, 0.7, 0.0, 1.0), [])
        adfirma p(d, 0).approximata((0.2689414214 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 1).approximata(0.0, SAMPLING_TOLERATIO)
        adfirma p(d, 2).approximata(0.0, SAMPLING_TOLERATIO)
        adfirma p(d, 3).approximata(0.0, SAMPLING_TOLERATIO)
        adfirma p(d, 4).approximata((0.7310585786 ∷ f32), SAMPLING_TOLERATIO)
    }

    proba "top-p 0.7 draws the pinned tokens" {
        fac {
            fixum train.Semen sa ← semen_p(SEMEN_A)
            fixum train.Semen sb ← semen_p(SEMEN_B)
            adfirma sors_token(logits_p(), config_p(1.0, 0, 0.7, 0.0, 1.0), [], sa) ≡ 0
            adfirma sors_token(logits_p(), config_p(1.0, 0, 0.7, 0.0, 1.0), [], sb) ≡ 4
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- min-p

probandum "sampling — min-p knob" {
    proba "min-p 0.3 keeps probs at least 0.3 x max and renormalizes" {
        fixum lista<f32> d ← distributio_p(logits_p(), config_p(1.0, 0, 0.0, 0.3, 1.0), [])
        adfirma p(d, 0).approximata((0.2689414214 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 1).approximata(0.0, SAMPLING_TOLERATIO)
        adfirma p(d, 2).approximata(0.0, SAMPLING_TOLERATIO)
        adfirma p(d, 3).approximata(0.0, SAMPLING_TOLERATIO)
        adfirma p(d, 4).approximata((0.7310585786 ∷ f32), SAMPLING_TOLERATIO)
    }

    proba "min-p 0.3 draws the pinned tokens" {
        fac {
            fixum train.Semen sa ← semen_p(SEMEN_A)
            fixum train.Semen sb ← semen_p(SEMEN_B)
            adfirma sors_token(logits_p(), config_p(1.0, 0, 0.0, 0.3, 1.0), [], sa) ≡ 0
            adfirma sors_token(logits_p(), config_p(1.0, 0, 0.0, 0.3, 1.0), [], sb) ≡ 4
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- repetition penalty

probandum "sampling — repetition penalty knob" {
    proba "penalty 2.0 over history [0, 4] divides the positive logits" {
        fixum lista<f32> d ← distributio_p(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [0, 4])
        adfirma p(d, 0).approximata((0.2083048101 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 1).approximata((0.3434365712 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 2).approximata((0.0766310571 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 3).approximata((0.0281909905 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 4).approximata((0.3434365712 ∷ f32), SAMPLING_TOLERATIO)
    }

    proba "penalty 2.0 over history [2, 3] multiplies the non-positive logits" {
        fixum lista<f32> d ← distributio_p(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [2, 3])
        adfirma p(d, 0).approximata((0.2232908720 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 1).approximata((0.1354327599 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 2).approximata((0.0302191334 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 3).approximata((0.0040897150 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 4).approximata((0.6069675198 ∷ f32), SAMPLING_TOLERATIO)
    }

    proba "penalty 2.0 over history [0, 4] draws the pinned tokens" {
        fac {
            fixum train.Semen sa ← semen_p(SEMEN_A)
            fixum train.Semen sc ← semen_p(SEMEN_C)
            adfirma sors_token(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [0, 4], sa) ≡ 1
            adfirma sors_token(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [0, 4], sc) ≡ 4
        }
        cape err {
            adfirma falsum
        }
    }

    proba "penalty 2.0 over history [2, 3] draws the pinned tokens" {
        fac {
            fixum train.Semen sa ← semen_p(SEMEN_A)
            fixum train.Semen sb ← semen_p(SEMEN_B)
            adfirma sors_token(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [2, 3], sa) ≡ 1
            adfirma sors_token(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [2, 3], sb) ≡ 2
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- the full combination

probandum "sampling — knob combination" {
    proba "the full pipeline (t1.5 k3 p0.8 m0.25 rep1.5 hist[2]) matches the f64 oracle" {
        fixum lista<f32> d ← distributio_p(logits_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2])
        adfirma p(d, 0).approximata((0.2729060000 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 1).approximata((0.1955456938 ∷ f32), SAMPLING_TOLERATIO)
        adfirma p(d, 2).approximata(0.0, SAMPLING_TOLERATIO)
        adfirma p(d, 3).approximata(0.0, SAMPLING_TOLERATIO)
        adfirma p(d, 4).approximata((0.5315483062 ∷ f32), SAMPLING_TOLERATIO)
    }

    proba "the full pipeline draws the pinned tokens" {
        fac {
            fixum train.Semen sa ← semen_p(SEMEN_A)
            fixum train.Semen sb ← semen_p(SEMEN_B)
            fixum train.Semen sc ← semen_p(SEMEN_C)
            adfirma sors_token(logits_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2], sa) ≡ 0
            adfirma sors_token(logits_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2], sb) ≡ 1
            adfirma sors_token(logits_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2], sc) ≡ 4
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- purity / determinism

probandum "sampling — purity and determinism" {
    proba "equal inputs produce equal distributions (pure — no hidden state)" {
        fixum lista<f32> a ← distributio_p(logits_p(), config_simplex(), [])
        fixum lista<f32> b ← distributio_p(logits_p(), config_simplex(), [])
        adfirma p(a, 0) ≡ p(b, 0)
        adfirma p(a, 1) ≡ p(b, 1)
        adfirma p(a, 4) ≡ p(b, 4)
    }

    proba "the same seed reproduces the same token; the draw advances the RNG" {
        fac {
            fixum train.Semen s1 ← semen_p(SEMEN_A)
            fixum train.Semen s2 ← semen_p(SEMEN_A)
            adfirma sors_token(logits_p(), config_simplex(), [], s1) ≡ sors_token(logits_p(), config_simplex(), [], s2)
            adfirma sors_status(logits_p(), config_simplex(), [], s1) ≠ SEMEN_A
        }
        cape err {
            adfirma falsum
        }
    }

    proba "different seeds draw different pinned tokens (the distribution is the same)" {
        fac {
            fixum train.Semen sa ← semen_p(SEMEN_A)
            fixum train.Semen sc ← semen_p(SEMEN_C)
            adfirma sors_token(logits_p(), config_simplex(), [], sa) ≡ 1
            adfirma sors_token(logits_p(), config_simplex(), [], sc) ≡ 4
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- fail-closed rows

probandum "sampling — fail-closed gates" {
    proba "empty logits reject" {
        adfirma maxima_detail([]) ≡ "logits must be non-empty"
        adfirma sors_detail([], config_simplex(), [], semen_p(SEMEN_A)) ≡ "logits must be non-empty"
    }

    proba "a negative temperature rejects" {
        adfirma config_detail((0.0 - 0.1) ∷ f32, 0, 0.0, 0.0, 1.0) ≡ "temperature must be non-negative"
    }

    proba "a negative top-k rejects" {
        adfirma config_detail(1.0, 0 - 1, 0.0, 0.0, 1.0) ≡ "top-k must be non-negative"
    }

    proba "a top-p above 1 rejects" {
        adfirma config_detail(1.0, 0, 1.5, 0.0, 1.0) ≡ "top-p must be within [0, 1]"
    }

    proba "a negative min-p rejects" {
        adfirma config_detail(1.0, 0, 0.0, (0.0 - 0.5) ∷ f32, 1.0) ≡ "min-p must be within [0, 1]"
    }

    proba "a repetition penalty below 1 rejects" {
        adfirma config_detail(1.0, 0, 0.0, 0.0, 0.5) ≡ "repetition penalty must be at least 1"
    }

    proba "a history token outside the vocabulary rejects" {
        adfirma sors_detail(logits_p(), config_simplex(), [5], semen_p(SEMEN_A)) ≡ "history token out of vocabulary range"
        adfirma sors_detail(logits_p(), config_simplex(), [0 - 1], semen_p(SEMEN_A)) ≡ "history token out of vocabulary range"
        adfirma sors_detail(logits_p(), config_p(0.0, 0, 0.0, 0.0, 1.0), [5], semen_p(SEMEN_A)) ≡ "history token out of vocabulary range"
    }
}
