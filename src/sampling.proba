+++
locale = "en"
+++
# Co-located package test for sampling.fab (PML5-U3 — deterministic token
# sampling). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * greedy exactness — max returns the argmax (first-index ties),
#     and temperature <= 0 routes sample to the greedy path with the Seed
#     unchanged.
#   * the pinned pipeline — distribution (logits + config + history →
#     filtered probabilities) matches the f64 oracle pins per knob:
#     temperature, top-k, top-p, min-p, repetition penalty, and their
#     combination (approximate within the documented 5e-4 tolerance).
#   * deterministic draws — sample (logits + config + history + Seed)
#     returns the oracle-pinned token for each pinned seed; the outcome
#     carries the ADVANCED Seed (the RNG continuation is explicit).
#   * purity — equal inputs produce equal distributions and equal tokens
#     (no hidden state); the draw consumes the RNG state (the advanced
#     status differs from the seed).
#   * fail-closed rows — empty logits, invalid config knobs, and history
#     tokens outside the vocabulary reject with the typed message.
#
# Oracle pins: f64 evaluations of the documented pipeline (the same
# arithmetic the train.proba xorshift pins and the loss.proba exp pins
# use) for the pinned logits V=5 [2.0, 1.5, 0.0, -1.0, 3.0]:
#   temp 1.0 plain    dist [0.2217326936, 0.1344876769, 0.0300082569,
#                           0.0110394208, 0.6027319518]
#   temp 2.0 plain    dist [0.2488471128, 0.1938023263, 0.0915457368,
#                           0.0555252961, 0.410279528]
#   top-k 2           dist [0.2424661125, 0.0328142200, 0.0328142200,
#                           0.0328142200, 0.6590912275]
#   top-p 0.7         dist [0.2689414214, 0, 0, 0, 0.7310585786]
#   min-p 0.3         dist [0.2689414214, 0, 0, 0, 0.7310585786]
#   rep 2.0, hist [0,4] penalized [1.0, 1.5, 0.0, -1.0, 1.5];
#                     dist [0.2083048101, 0.3434365712, 0.0766310571,
#                           0.0281909905, 0.3434365712]
#   rep 2.0, hist [2,3] penalized [2.0, 1.5, 0.0, -2.0, 3.0];
#                     dist [0.2232908720, 0.1354327599, 0.0302191334,
#                           0.0040897150, 0.6069675198]
#   full (t1.5 k3 p0.8 m0.25 rep1.5 hist[2]) dist [0.2729060000,
#                   0.1955456938, 0, 0, 0.5315483062]
#   greedy (temp 0)   degenerate one-hot at the argmax (index 4).
# Seed pins (first draw of the xorshift64 seam, model-independent):
#   seed 1234567890123456789  u ≈ 0.245768647  (s_a)
#   seed 5428186273191027194  u ≈ 0.383910162  (s_b)
#   seed 730019052841267308   u ≈ 0.773805557  (s_c)
# The pinned draws sit > 2e-3 from every cumulative boundary (f32/f64
# drift is ~1e-6), so the token pins are boundary-safe.
#
# EVIDENCE HONESTY (CTO Q2, hard): this suite is STRUCTURAL proof. No
# executed token value is claimed; the pins are f64 evaluations of the
# documented formulas and the documented xorshift draws. Executed
# value-identity is env-blocked tree-wide today (FMIR stepper /
# library-import gap — the PML4 closeout recorded both blockers; neither
# is fixed here). PML5-U3 is PARTIAL and token value-identity is deferred
# to the auditor-owned runtime-evidence gate.
#
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/sampling.proba` proves the suite
# type-checks. Execution of proba bodies is env-blocked tree-wide today
# (recorded residual); this suite is the compile-level proof of the
# contract.

import from "gradus:sampling" sampling
import from "gradus:train" train

# ---- helpers

# The pinned logits vector (V=5).
fn logits_p() → list<f32> {
    return [2.0, 1.5, 0.0, (0.0 - 1.0) ∷ f32, 3.0]
}

# A config built through the validated constructor (swallow never-firing
# errors).
fn config_p(f32 temperature, int top_k, f32 top_p, f32 min_p, f32 penalty) → sampling.Config {
    var sampling.Config c ← sampling.default_config()
    do {
        c ← sampling.construct_config(temperature, top_k, top_p, min_p, penalty)
    }
    catch err {
        return c
    }
    return c
}

# The plain temperature-1 config (no filters, no penalty).
fn config_simplex() → sampling.Config {
    return config_p(1.0, 0, 0.0, 0.0, 1.0)
}

# Element read with a default.
fn p(list<f32> xs, int i) → f32 {
    return xs.get(i) coalesce (0.0 - 999.0) ∷ f32
}

# A seeded Seed built through the validated constructor (swallow
# never-firing errors; the pinned seeds are non-zero).
fn seed_p(int seed) → train.Seed {
    var train.Seed s ← train.default()
    do {
        s ← train.construct_seed(seed)
        return s
    }
    catch err {
        return s
    }
    return s
}

# The greedy argmax (swallow errors -> -1).
fn max_value(list<f32> logits) → int {
    do {
        const int t ← sampling.max(logits)
        return t
    }
    catch err {
        return (0 - 1)
    }
}

# The filtered distribution as a list (swallow errors -> empty list).
fn distribution_p(list<f32> logits, sampling.Config c, list<int> hist) → list<f32> {
    var list<f32> d
    do {
        d ← sampling.distribution(logits, c, hist)
        return d
    }
    catch err {
        return d
    }
    return d
}

# The drawn token id (swallow errors -> -1).
fn sample_token(list<f32> logits, sampling.Config c, list<int> hist, train.Seed s) → int {
    do {
        const sampling.Sampler r ← sampling.sample(logits, c, hist, s)
        return r.token_id()
    }
    catch err {
        return (0 - 1)
    }
}

# The advanced RNG status after a draw (swallow errors -> 0).
fn sample_status(list<f32> logits, sampling.Config c, list<int> hist, train.Seed s) → int {
    do {
        const sampling.Sampler r ← sampling.sample(logits, c, hist, s)
        return r.seed().status()
    }
    catch err {
        return 0
    }
}

# Renders a sample outcome as text (the token or the typed message).
fn sample_detail(list<f32> logits, sampling.Config c, list<int> hist, train.Seed s) → string {
    do {
        const sampling.Sampler _ ← sampling.sample(logits, c, hist, s)
        return "ok"
    }
    catch err {
        return sampling.message(err)
    }
}

# Renders a max outcome as text.
fn max_detail(list<f32> logits) → string {
    do {
        const int _ ← sampling.max(logits)
        return "ok"
    }
    catch err {
        return sampling.message(err)
    }
}

# Renders a config-construction outcome as text.
fn config_detail(f32 temperature, int top_k, f32 top_p, f32 min_p, f32 penalty) → string {
    do {
        const sampling.Config _ ← sampling.construct_config(temperature, top_k, top_p, min_p, penalty)
        return "ok"
    }
    catch err {
        return sampling.message(err)
    }
}

# ---- oracle tolerance (the decode.proba 5e-4 convention)

const f32 SAMPLING_TOLERATIO ← (0.0005 ∷ f32)

# The pinned seeds (i64-safe; the first draws are model-independent).
const int SEED_A ← 1234567890123456789
const int SEED_B ← 5428186273191027194
const int SEED_C ← 730019052841267308

# ---- greedy exactness

describe "sampling — greedy path exact" {
    test "max returns the argmax of the pinned logits" {
        assert max_value(logits_p()) ≡ 4
    }
    test "max breaks ties to the first index" {
        assert max_value([1.0, 2.0, 2.0]) ≡ 1
    }
    test "max returns index 0 when the first element is the max" {
        assert max_value([5.0, 1.0, 0.0]) ≡ 0
    }
    test "temperature 0 routes sample to the greedy path with the seed unchanged" {
        do {
            const train.Seed s ← seed_p(SEED_A)
            const sampling.Sampler r ← sampling.sample(logits_p(), config_p(0.0, 0, 0.0, 0.0, 1.0), [], s)
            assert r.token_id() ≡ 4
            assert r.seed().status() ≡ SEED_A
        }
        catch err {
            assert false
        }
    }
    test "the greedy distribution is degenerate one-hot at the argmax" {
        const list<f32> d ← distribution_p(logits_p(), config_p(0.0, 0, 0.0, 0.0, 1.0), [])
        assert p(d, 0).approximate(0.0, SAMPLING_TOLERATIO)
        assert p(d, 1).approximate(0.0, SAMPLING_TOLERATIO)
        assert p(d, 2).approximate(0.0, SAMPLING_TOLERATIO)
        assert p(d, 3).approximate(0.0, SAMPLING_TOLERATIO)
        assert p(d, 4).approximate(1.0, SAMPLING_TOLERATIO)
    }
}

# ---- temperature

describe "sampling — temperature knob" {
    test "temperature 1 distribution matches the f64 oracle" {
        const list<f32> d ← distribution_p(logits_p(), config_simplex(), [])
        assert p(d, 0).approximate((0.2217326936 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approximate((0.1344876769 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 2).approximate((0.0300082569 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 3).approximate((0.0110394208 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 4).approximate((0.6027319518 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "temperature 2 distribution matches the f64 oracle" {
        const list<f32> d ← distribution_p(logits_p(), config_p(2.0, 0, 0.0, 0.0, 1.0), [])
        assert p(d, 0).approximate((0.2488471128 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approximate((0.1938023263 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 2).approximate((0.0915457368 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 3).approximate((0.0555252961 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 4).approximate((0.410279528 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "temperature 1 draws the pinned tokens" {
        do {
            const train.Seed sa ← seed_p(SEED_A)
            const train.Seed sb ← seed_p(SEED_B)
            const train.Seed sc ← seed_p(SEED_C)
            assert sample_token(logits_p(), config_simplex(), [], sa) ≡ 1
            assert sample_token(logits_p(), config_simplex(), [], sb) ≡ 2
            assert sample_token(logits_p(), config_simplex(), [], sc) ≡ 4
        }
        catch err {
            assert false
        }
    }
    test "temperature 2 draws the pinned tokens" {
        do {
            const train.Seed sa ← seed_p(SEED_A)
            const train.Seed sb ← seed_p(SEED_B)
            const train.Seed sc ← seed_p(SEED_C)
            assert sample_token(logits_p(), config_p(2.0, 0, 0.0, 0.0, 1.0), [], sa) ≡ 0
            assert sample_token(logits_p(), config_p(2.0, 0, 0.0, 0.0, 1.0), [], sb) ≡ 1
            assert sample_token(logits_p(), config_p(2.0, 0, 0.0, 0.0, 1.0), [], sc) ≡ 4
        }
        catch err {
            assert false
        }
    }
}

# ---- top-k

describe "sampling — top-k knob" {
    test "top-k 2 distribution keeps the two largest logits and renormalizes" {
        const list<f32> d ← distribution_p(logits_p(), config_p(1.0, 2, 0.0, 0.0, 1.0), [])
        assert p(d, 0).approximate((0.2424661125 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approximate((0.03281422 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 2).approximate((0.03281422 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 3).approximate((0.03281422 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 4).approximate((0.6590912275 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "top-k 2 draws the pinned tokens" {
        do {
            const train.Seed sa ← seed_p(SEED_A)
            const train.Seed sb ← seed_p(SEED_B)
            assert sample_token(logits_p(), config_p(1.0, 2, 0.0, 0.0, 1.0), [], sa) ≡ 1
            assert sample_token(logits_p(), config_p(1.0, 2, 0.0, 0.0, 1.0), [], sb) ≡ 4
        }
        catch err {
            assert false
        }
    }
}

# ---- top-p (nucleus)

describe "sampling — top-p knob" {
    test "top-p 0.7 keeps the nucleus {0, 4} and renormalizes" {
        const list<f32> d ← distribution_p(logits_p(), config_p(1.0, 0, 0.7, 0.0, 1.0), [])
        assert p(d, 0).approximate((0.2689414214 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approximate(0.0, SAMPLING_TOLERATIO)
        assert p(d, 2).approximate(0.0, SAMPLING_TOLERATIO)
        assert p(d, 3).approximate(0.0, SAMPLING_TOLERATIO)
        assert p(d, 4).approximate((0.7310585786 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "top-p 0.7 draws the pinned tokens" {
        do {
            const train.Seed sa ← seed_p(SEED_A)
            const train.Seed sb ← seed_p(SEED_B)
            assert sample_token(logits_p(), config_p(1.0, 0, 0.7, 0.0, 1.0), [], sa) ≡ 0
            assert sample_token(logits_p(), config_p(1.0, 0, 0.7, 0.0, 1.0), [], sb) ≡ 4
        }
        catch err {
            assert false
        }
    }
}

# ---- min-p

describe "sampling — min-p knob" {
    test "min-p 0.3 keeps probs at least 0.3 x max and renormalizes" {
        const list<f32> d ← distribution_p(logits_p(), config_p(1.0, 0, 0.0, 0.3, 1.0), [])
        assert p(d, 0).approximate((0.2689414214 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approximate(0.0, SAMPLING_TOLERATIO)
        assert p(d, 2).approximate(0.0, SAMPLING_TOLERATIO)
        assert p(d, 3).approximate(0.0, SAMPLING_TOLERATIO)
        assert p(d, 4).approximate((0.7310585786 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "min-p 0.3 draws the pinned tokens" {
        do {
            const train.Seed sa ← seed_p(SEED_A)
            const train.Seed sb ← seed_p(SEED_B)
            assert sample_token(logits_p(), config_p(1.0, 0, 0.0, 0.3, 1.0), [], sa) ≡ 0
            assert sample_token(logits_p(), config_p(1.0, 0, 0.0, 0.3, 1.0), [], sb) ≡ 4
        }
        catch err {
            assert false
        }
    }
}

# ---- repetition penalty

describe "sampling — repetition penalty knob" {
    test "penalty 2.0 over history [0, 4] divides the positive logits" {
        const list<f32> d ← distribution_p(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [0, 4])
        assert p(d, 0).approximate((0.2083048101 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approximate((0.3434365712 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 2).approximate((0.0766310571 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 3).approximate((0.0281909905 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 4).approximate((0.3434365712 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "penalty 2.0 over history [2, 3] multiplies the non-positive logits" {
        const list<f32> d ← distribution_p(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [2, 3])
        assert p(d, 0).approximate((0.223290872 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approximate((0.1354327599 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 2).approximate((0.0302191334 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 3).approximate((0.004089715 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 4).approximate((0.6069675198 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "penalty 2.0 over history [0, 4] draws the pinned tokens" {
        do {
            const train.Seed sa ← seed_p(SEED_A)
            const train.Seed sc ← seed_p(SEED_C)
            assert sample_token(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [0, 4], sa) ≡ 1
            assert sample_token(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [0, 4], sc) ≡ 4
        }
        catch err {
            assert false
        }
    }
    test "penalty 2.0 over history [2, 3] draws the pinned tokens" {
        do {
            const train.Seed sa ← seed_p(SEED_A)
            const train.Seed sb ← seed_p(SEED_B)
            assert sample_token(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [2, 3], sa) ≡ 1
            assert sample_token(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [2, 3], sb) ≡ 2
        }
        catch err {
            assert false
        }
    }
}

# ---- the full combination

describe "sampling — knob combination" {
    test "the full pipeline (t1.5 k3 p0.8 m0.25 rep1.5 hist[2]) matches the f64 oracle" {
        const list<f32> d ← distribution_p(logits_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2])
        assert p(d, 0).approximate((0.272906 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approximate((0.1955456938 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 2).approximate(0.0, SAMPLING_TOLERATIO)
        assert p(d, 3).approximate(0.0, SAMPLING_TOLERATIO)
        assert p(d, 4).approximate((0.5315483062 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "the full pipeline draws the pinned tokens" {
        do {
            const train.Seed sa ← seed_p(SEED_A)
            const train.Seed sb ← seed_p(SEED_B)
            const train.Seed sc ← seed_p(SEED_C)
            assert sample_token(logits_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2], sa) ≡ 0
            assert sample_token(logits_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2], sb) ≡ 1
            assert sample_token(logits_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2], sc) ≡ 4
        }
        catch err {
            assert false
        }
    }
}

# ---- purity / determinism

describe "sampling — purity and determinism" {
    test "equal inputs produce equal distributions (pure — no hidden state)" {
        const list<f32> a ← distribution_p(logits_p(), config_simplex(), [])
        const list<f32> b ← distribution_p(logits_p(), config_simplex(), [])
        assert p(a, 0) ≡ p(b, 0)
        assert p(a, 1) ≡ p(b, 1)
        assert p(a, 4) ≡ p(b, 4)
    }
    test "the same seed reproduces the same token; the draw advances the RNG" {
        do {
            const train.Seed s1 ← seed_p(SEED_A)
            const train.Seed s2 ← seed_p(SEED_A)
            assert sample_token(logits_p(), config_simplex(), [], s1) ≡ sample_token(logits_p(), config_simplex(), [], s2)
            assert sample_status(logits_p(), config_simplex(), [], s1) ≠ SEED_A
        }
        catch err {
            assert false
        }
    }
    test "different seeds draw different pinned tokens (the distribution is the same)" {
        do {
            const train.Seed sa ← seed_p(SEED_A)
            const train.Seed sc ← seed_p(SEED_C)
            assert sample_token(logits_p(), config_simplex(), [], sa) ≡ 1
            assert sample_token(logits_p(), config_simplex(), [], sc) ≡ 4
        }
        catch err {
            assert false
        }
    }
}

# ---- fail-closed rows

describe "sampling — fail-closed gates" {
    test "empty logits reject" {
        assert max_detail([]) ≡ "logits must be non-empty"
        assert sample_detail([], config_simplex(), [], seed_p(SEED_A)) ≡ "logits must be non-empty"
    }
    test "a negative temperature rejects" {
        assert config_detail((0.0 - 0.1) ∷ f32, 0, 0.0, 0.0, 1.0) ≡ "temperature must be non-negative"
    }
    test "a non-finite temperature rejects" {
        assert config_detail(1.0 / 0.0 ∷ f32, 0, 0.0, 0.0, 1.0) ≡ "temperature must be non-negative"
    }
    test "a negative top-k rejects" {
        assert config_detail(1.0, 0 - 1, 0.0, 0.0, 1.0) ≡ "top-k must be non-negative"
    }
    test "a top-p above 1 rejects" {
        assert config_detail(1.0, 0, 1.5, 0.0, 1.0) ≡ "top-p must be within [0, 1]"
    }
    test "a negative min-p rejects" {
        assert config_detail(1.0, 0, 0.0, (0.0 - 0.5) ∷ f32, 1.0) ≡ "min-p must be within [0, 1]"
    }
    test "a repetition penalty below 1 rejects" {
        assert config_detail(1.0, 0, 0.0, 0.0, 0.5) ≡ "repetition penalty must be at least 1"
    }
    test "a history token outside the vocabulary rejects" {
        assert sample_detail(logits_p(), config_simplex(), [5], seed_p(SEED_A)) ≡ "history token out of vocabulary range"
        assert sample_detail(logits_p(), config_simplex(), [0 - 1], seed_p(SEED_A)) ≡ "history token out of vocabulary range"
        assert sample_detail(logits_p(), config_p(0.0, 0, 0.0, 0.0, 1.0), [5], seed_p(SEED_A)) ≡ "history token out of vocabulary range"
    }
}
