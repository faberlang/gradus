+++ toml
locale = "en"

+++ faber
# Device layer axes for Slice B0 (Flint) and Slice B (Qwen3.6):
#   - Slice B0: QK-norm, learnable softmax offset / attn_sinks, RingKvArena +
#     FullKvArena dispatch (arbitrary non-power-of-two window, inverted RoPE),
#     and leading dense FFN + routed/shared MoE layers.
#   - Slice B: sectional RoPE, fused attn_qkv projection, causal 1D ShortConv
#     over ConvStateArena, and Gated DeltaNet recurrence over RecurrentStateArena.
#
# Public import: import from "gradus:decode_hybrid" let dh
# Zero NumericBlock / list<f32> in the device compute paths.

import from "gradus:decode_step" let ds
import from "gradus:decode_hybrid_kernels" let dhk
import from "gradus:decode_stages" let stages
import from "gradus:decode_token" let dt
import from "gradus:cache/session" let sess_mod
import from "gradus:cache/hybrid_arenas" let hybrid
import from "gradus:model/schedule" let model_schedule
import from "gradus:model/linear_weight" let lw_mod
import from "gradus:model/expert_bank" let eb

@ public
union HybridError {
    @ shared
    string message

    StageFailure {
        stages.StageError inner
    },
    LinearWeightFailure {
        lw_mod.LinearWeightError inner
    },
    ExpertBankFailure {
        eb.ExpertBankError inner
    },
    SessionFailure {
        sess_mod.SessionError inner
    }
}

@ public
@ conversion
fn from_stage_error(stages.StageError err) → HybridError {
    return variant StageFailure { message = err.message, inner = err }
}

@ public
@ conversion
fn from_linear_weight_error(lw_mod.LinearWeightError err) → HybridError {
    return variant LinearWeightFailure { message = err.message, inner = err }
}

@ public
@ conversion
fn from_expert_bank_error(eb.ExpertBankError err) → HybridError {
    return variant ExpertBankFailure { message = err.message, inner = err }
}

@ public
@ conversion
fn from_session_error(sess_mod.SessionError err) → HybridError {
    return variant SessionFailure { message = err.message, inner = err }
}

# Attention weights for Slice B0 (Flint) and Slice B (Qwen3.6) full-attention layers.
@ public
class FlintAttnWeights<size D, size QD, size KVD, size DH, size H> {
    let tensor<f32, [D]> anorm
    let tensor<f32, [QD, D]> wq
    let tensor<f32, [KVD, D]> wk
    let tensor<f32, [KVD, D]> wv
    let tensor<f32, [D, QD]> wo
    let tensor<f32, [DH]> ∪ none q_norm = null
    let tensor<f32, [DH]> ∪ none k_norm = null
    let bool has_sink = false
    let tensor<f32, [H]> softmax_sink
}

# Attention hyperparameters for Slice B0 (Flint).
@ public
class FlintAttnParams {
    let i32 dh
    let i32 span
    let i32 group
    let dt.RopeKind rope
    let f32 eps
    let f32 lntheta
    let f32 scale
}

# Dense SwiGLU FFN weights (for Flint leading `mlp_only_layers`).
@ public
class DenseFfnWeights<size D, size F> {
    let tensor<f32, [D]> fnorm
    let tensor<f32, [F, D]> wg
    let tensor<f32, [F, D]> wu
    let tensor<f32, [D, F]> wd
}

# Routed + optional shared MoE FFN weights.
# Expert matrices `wg`/`wu` (`[E * FE, D]`) and `wd` (`[E * D, FE]`) are 2D-packed
# so device kernels stay 2D and i64-free.
@ public
class MoeFfnWeights<size D, size E, size EF, size ED, size FE, size FS> {
    let tensor<f32, [D]> fnorm
    let tensor<f32, [E, D]> router
    let tensor<f32, [EF, D]> wg
    let tensor<f32, [EF, D]> wu
    let tensor<f32, [ED, FE]> wd
    let tensor<f32, [FS, D]> ∪ none shared_wg = null
    let tensor<f32, [FS, D]> ∪ none shared_wu = null
    let tensor<f32, [D, FS]> ∪ none shared_wd = null
    let tensor<f32, [1, D]> ∪ none shared_gate_w = null
    let bool use_sigmoid_routing = false
}

# Full-attention weights for Slice B (Qwen3.6) with 2*QD interleaved Q + gate projection.
@ public
class Qwen36FullAttnWeights<size D, size TwoQD, size QD, size KVD, size DH, size H> {
    let tensor<f32, [D]> anorm
    let tensor<f32, [TwoQD, D]> wq
    let tensor<f32, [KVD, D]> wk
    let tensor<f32, [KVD, D]> wv
    let tensor<f32, [D, QD]> wo
    let tensor<f32, [DH]> ∪ none q_norm = null
    let tensor<f32, [DH]> ∪ none k_norm = null
}

# Gated DeltaNet + ShortConv weights for Slice B (Qwen3.6) linear-attention layers.
@ public
class LinearAttnWeights<size D, size ConvCh, size InnerSize, size VH, size K, size HeadVDim> {
    let tensor<f32, [D]> anorm
    let tensor<f32, [ConvCh, D]> wqkv
    let tensor<f32, [InnerSize, D]> wgate
    let tensor<f32, [ConvCh, K]> conv_w
    let tensor<f32, [VH]> dt_bias
    let tensor<f32, [VH]> a_row
    let tensor<f32, [VH, D]> wbeta
    let tensor<f32, [VH, D]> walpha
    let tensor<f32, [HeadVDim]> ssm_norm
    let tensor<f32, [D, InnerSize]> wout
}

# Hyperparameters for Slice B (Qwen3.6) linear-attention layers.
@ public
class LinearAttnParams {
    let i32 group_heads
    let i32 key_dim
    let f32 eps
    let int site_idx
    let int history_len
}

# Slice B0 attention step: RMSNorm -> QKV proj -> optional QK-norm ->
# inverted RoPE (None on full-attn, Half/Pairs on SWA) -> SessionState KV write ->
# RingKvArena / FullKvArena score + learnable softmax / sink -> context -> O proj + residual.
@ public
fn flint_attn_step<size D, size QD, size KVD, size DH, size H, size C, size W>(tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, FlintAttnWeights<D, QD, KVD, DH, H> aw, FlintAttnParams ap, mut sess_mod.SessionState<C, W, KVD> sess, int slot_id, i32 pos) → void ⇥ sess_mod.SessionError {
    mut tensor<f32, [D]> xn ← tf32[D] {}
    mut tensor<f32, [QD]> q ← tf32[QD] {}
    mut tensor<f32, [KVD]> k ← tf32[KVD] {}
    mut tensor<f32, [KVD]> v ← tf32[KVD] {}
    do device {
        ds.rmsnorm(hin, aw.anorm, mut xn, ap.eps)
        ds.qkv_proj(aw.wq, aw.wk, aw.wv, xn, mut q, mut k, mut v)
    }

    mut tensor<f32, [QD]> qn ← tf32[QD] {}
    mut tensor<f32, [KVD]> kn ← tf32[KVD] {}
    mut tensor<f32, [H]> q_inv ← tf32[H] {}
    mut tensor<f32, [H]> k_inv ← tf32[H] {}
    if aw.q_norm not is none and aw.k_norm not is none {
        let tensor<f32, [DH]> qn_w ← aw.q_norm
        let tensor<f32, [DH]> kn_w ← aw.k_norm
        stages.norm_qk_heads<size H, size H, size QD, size KVD, size DH>(q, k, qn_w, kn_w, mut qn, mut kn, mut q_inv, mut k_inv, ap.eps)
    }
    else {
        stages.copy_qk_heads<size QD, size KVD>(q, k, mut qn, mut kn)
    }

    mut tensor<f32, [QD]> qr ← tf32[QD] {}
    mut tensor<f32, [KVD]> kr ← tf32[KVD] {}
    mut tensor<f32, [QD]> ctx ← tf32[QD] {}
    stages.attn_rope_and_session(qn, kn, v, mut qr, mut kr, ap.rope, pos, ap.span, ap.lntheta, ap.group, ap.dh, ap.scale, aw.has_sink, aw.softmax_sink, mut sess, slot_id, mut ctx)

    mut tensor<f32, [D]> ao ← tf32[D] {}
    do device {
        ds.gemv(aw.wo, ctx, mut ao)
        ds.residual_add(hin, ao, mut hout)
    }
}

# Dense SwiGLU FFN step (used for Flint leading `mlp_only_layers`).
@ public
fn dense_ffn_step<size D, size F>(tensor<f32, [D]> h1, mut tensor<f32, [D]> hout, DenseFfnWeights<D, F> fw, f32 eps) → void {
    stages.dense_ffn_stage(h1, mut hout, fw.fnorm, fw.wg, fw.wu, fw.wd, eps)
}

# Routed + optional shared MoE FFN step.
@ public
fn moe_ffn_step<size D, size E, size EF, size ED, size K, size FE, size FS>(tensor<f32, [D]> h1, mut tensor<f32, [D]> hout, MoeFfnWeights<D, E, EF, ED, FE, FS> mw, mut tensor<i32, [K]> top_idx, f32 eps) → void {
    mut tensor<f32, [D]> fnx ← tf32[D] {}
    mut tensor<f32, [D]> moe_out ← tf32[D] {}
    stages.moe_routed_core(h1, mw.fnorm, mw.router, mw.wg, mw.wu, mw.wd, mut fnx, mut moe_out, mut top_idx, eps, mw.use_sigmoid_routing)

    if mw.shared_wg not is none and mw.shared_wu not is none and mw.shared_wd not is none {
        let tensor<f32, [FS, D]> swg ← mw.shared_wg
        let tensor<f32, [FS, D]> swu ← mw.shared_wu
        let tensor<f32, [D, FS]> swd ← mw.shared_wd
        mut tensor<f32, [D]> s_out ← tf32[D] {}
        mut tensor<f32, [D]> ffn_out ← tf32[D] {}
        stages.moe_shared_ffn_proj(fnx, swg, swu, swd, mut s_out)
        if mw.shared_gate_w not is none {
            let tensor<f32, [1, D]> sgw ← mw.shared_gate_w
            mut tensor<f32, [1]> s_gate_logit ← tf32[1] {}
            do device {
                ds.gemv(sgw, fnx, mut s_gate_logit)
                dhk.sigmoid_gate_add(moe_out, s_out, s_gate_logit, mut ffn_out)
                ds.residual_add(h1, ffn_out, mut hout)
            }
        }
        else {
            do device {
                ds.residual_add(moe_out, s_out, mut ffn_out)
                ds.residual_add(h1, ffn_out, mut hout)
            }
        }
    }
    else {
        do device {
            ds.residual_add(h1, moe_out, mut hout)
        }
    }
}

# Slice B0 full layer step: attention + dense FFN (when `is_dense`) or MoE FFN.
@ public
fn flint_layer_step<size D, size QD, size KVD, size DH, size H, size C, size W, size F, size E, size EF, size ED, size K, size FE, size FS>(tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, FlintAttnWeights<D, QD, KVD, DH, H> aw, FlintAttnParams ap, mut sess_mod.SessionState<C, W, KVD> sess, int slot_id, i32 pos, bool is_dense, DenseFfnWeights<D, F> dfw, MoeFfnWeights<D, E, EF, ED, FE, FS> mfw, mut tensor<i32, [K]> top_idx) → void ⇥ sess_mod.SessionError {
    mut tensor<f32, [D]> h1 ← tf32[D] {}
    flint_attn_step<size D, size QD, size KVD, size DH, size H, size C, size W>(hin, mut h1, aw, ap, mut sess, slot_id, pos)

    if is_dense {
        dense_ffn_step(h1, mut hout, dfw, ap.eps)
    }
    else {
        moe_ffn_step(h1, mut hout, mfw, mut top_idx, ap.eps)
    }
}

# Slice B (Qwen3.6) full-attention step with 2*QD interleaved Q+gate projection,
# sectional RoPE (`dimension_sections`), optional per-head QK-norm over FullKvArena,
# and per-element sigmoid Q output gate (`ctx * sigmoid(q_gate)`).
@ public
fn qwen36_full_attn_step<size D, size TwoQD, size QD, size KVD, size DH, size H, size C, size W>(tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, Qwen36FullAttnWeights<D, TwoQD, QD, KVD, DH, H> aw, FlintAttnParams ap, tensor<i32, [4]> sections, mut sess_mod.SessionState<C, W, KVD> sess, int slot_id, i32 pos) → void ⇥ sess_mod.SessionError {
    mut tensor<f32, [D]> xn ← tf32[D] {}
    mut tensor<f32, [TwoQD]> q_full ← tf32[TwoQD] {}
    mut tensor<f32, [QD]> q ← tf32[QD] {}
    mut tensor<f32, [QD]> q_gate ← tf32[QD] {}
    mut tensor<f32, [KVD]> k ← tf32[KVD] {}
    mut tensor<f32, [KVD]> v ← tf32[KVD] {}
    do device {
        ds.rmsnorm(hin, aw.anorm, mut xn, ap.eps)
        ds.gemv(aw.wq, xn, mut q_full)
        ds.gemv(aw.wk, xn, mut k)
        ds.gemv(aw.wv, xn, mut v)
        dhk.split_q_gate_interleaved(q_full, mut q, mut q_gate, ap.dh)
    }

    mut tensor<f32, [QD]> qn ← tf32[QD] {}
    mut tensor<f32, [KVD]> kn ← tf32[KVD] {}
    mut tensor<f32, [H]> q_inv ← tf32[H] {}
    mut tensor<f32, [H]> k_inv ← tf32[H] {}
    if aw.q_norm not is none and aw.k_norm not is none {
        let tensor<f32, [DH]> qn_w ← aw.q_norm
        let tensor<f32, [DH]> kn_w ← aw.k_norm
        stages.norm_qk_heads<size H, size H, size QD, size KVD, size DH>(q, k, qn_w, kn_w, mut qn, mut kn, mut q_inv, mut k_inv, ap.eps)
    }
    else {
        stages.copy_qk_heads<size QD, size KVD>(q, k, mut qn, mut kn)
    }

    mut tensor<f32, [QD]> qr ← tf32[QD] {}
    mut tensor<f32, [KVD]> kr ← tf32[KVD] {}
    mut tensor<f32, [QD]> ctx ← tf32[QD] {}
    stages.attn_sectional_and_session<size QD, size KVD, size H, size C, size W>(qn, kn, v, mut qr, mut kr, pos, ap.dh, sections, ap.lntheta, ap.group, ap.scale, mut sess, slot_id, mut ctx)

    mut tensor<f32, [QD]> gated_ctx ← tf32[QD] {}
    mut tensor<f32, [D]> ao ← tf32[D] {}
    do device {
        dhk.sigmoid_mul(ctx, q_gate, mut gated_ctx)
        ds.gemv(aw.wo, gated_ctx, mut ao)
        ds.residual_add(hin, ao, mut hout)
    }
}

# Slice B (Qwen3.6) linear-attention step: fused attn_qkv -> causal 1D ShortConv
# over ConvStateArena -> L2-norm + head-repeat -> Gated DeltaNet recurrence over
# RecurrentStateArena -> z-gated RMSNorm -> output proj + residual.
@ public
fn qwen36_linear_attn_step<size D, size ConvCh, size RecRows, size VH, size K, size RecCols, size ConvRows>(tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, LinearAttnWeights<D, ConvCh, RecRows, VH, K, RecCols> lw, LinearAttnParams lp, mut hybrid.ConvStateArena<ConvRows, ConvCh> conv_arena, mut hybrid.RecurrentStateArena<RecRows, RecCols> rec_arena, int slot_id) → void ⇥ sess_mod.SessionError {
    stages.deltanet_linear_attn_stage(hin, mut hout, lw.anorm, lw.wqkv, lw.wgate, lw.conv_w, lw.dt_bias, lw.a_row, lw.wbeta, lw.walpha, lw.ssm_norm, lw.wout, lp.group_heads, lp.key_dim, lp.eps, lp.site_idx, lp.history_len, mut conv_arena, mut rec_arena, slot_id)
}

# Slice B (Qwen3.6) linear-attention step directly over HybridSession (Seam 4).
@ public
fn qwen36_linear_attn_hybrid_step<size C, size W, size KVD, size D, size ConvCh, size RecRows, size VH, size K, size RecCols, size ConvRows>(tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, LinearAttnWeights<D, ConvCh, RecRows, VH, K, RecCols> lw, LinearAttnParams lp, mut hybrid.HybridSession<C, W, KVD, ConvRows, ConvCh, RecRows, RecCols> hs, int slot_id) → void ⇥ sess_mod.SessionError {
    stages.deltanet_hybrid_stage(hin, mut hout, lw.anorm, lw.wqkv, lw.wgate, lw.conv_w, lw.dt_bias, lw.a_row, lw.wbeta, lw.walpha, lw.ssm_norm, lw.wout, lp.group_heads, lp.key_dim, lp.eps, lp.site_idx, lp.history_len, mut hs, slot_id)
}

# ---------------------------------------------------------------------------
# Seam-5 Quantized & Schedule-Driven Layer Orchestrators (Flint INT4 & Qwen3.6)
# ---------------------------------------------------------------------------

# Quantized GroupAffineU8 + BF16 scales/biases attention weights (Flint INT4 MLX).
@ public
class FlintGaU8Bf16AttnWeights<size D, size QD, size KVD, size DH, size H, size PD, size GD, size PQD, size GQD> {
    let tensor<f32, [D]> anorm
    let lw_mod.LinearWeight wq_desc
    let tensor<u8, [QD, PD]> wq_w
    let tensor<bf16, [QD, GD]> wq_s
    let tensor<bf16, [QD, GD]> wq_b
    let lw_mod.LinearWeight wk_desc
    let tensor<u8, [KVD, PD]> wk_w
    let tensor<bf16, [KVD, GD]> wk_s
    let tensor<bf16, [KVD, GD]> wk_b
    let lw_mod.LinearWeight wv_desc
    let tensor<u8, [KVD, PD]> wv_w
    let tensor<bf16, [KVD, GD]> wv_s
    let tensor<bf16, [KVD, GD]> wv_b
    let lw_mod.LinearWeight wo_desc
    let tensor<u8, [D, PQD]> wo_w
    let tensor<bf16, [D, GQD]> wo_s
    let tensor<bf16, [D, GQD]> wo_b
    let bool has_qk_norm
    let tensor<f32, [DH]> q_norm
    let tensor<f32, [DH]> k_norm
    let bool has_sink
    let tensor<f32, [H]> softmax_sink
}

# Quantized GroupAffineU8 + BF16 scales/biases dense SwiGLU FFN weights (Flint leading layers).
@ public
class FlintGaU8Bf16DenseFfnWeights<size D, size F, size PD, size GD, size PF, size GF> {
    let tensor<f32, [D]> fnorm
    let lw_mod.LinearWeight wg_desc
    let tensor<u8, [F, PD]> wg_w
    let tensor<bf16, [F, GD]> wg_s
    let tensor<bf16, [F, GD]> wg_b
    let lw_mod.LinearWeight wu_desc
    let tensor<u8, [F, PD]> wu_w
    let tensor<bf16, [F, GD]> wu_s
    let tensor<bf16, [F, GD]> wu_b
    let lw_mod.LinearWeight wd_desc
    let tensor<u8, [D, PF]> wd_w
    let tensor<bf16, [D, GF]> wd_s
    let tensor<bf16, [D, GF]> wd_b
}

# Quantized GroupAffineU8 + BF16 scales/biases ExpertBank MoE weights (Flint layers 2..48).
@ public
class FlintGaU8Bf16MoeFfnWeights<size D, size E, size FE, size PD, size GD, size PFE, size GFE, size FS> {
    let eb.ExpertBank bank
    let eb.BankedMatrixSpec gate_spec
    let eb.BankedMatrixSpec up_spec
    let eb.BankedMatrixSpec down_spec
    let tensor<f32, [D]> fnorm
    let tensor<f32, [E, D]> router
    let tensor<u8, [E, FE, PD]> wg_w
    let tensor<bf16, [E, FE, GD]> wg_s
    let tensor<bf16, [E, FE, GD]> wg_b
    let tensor<u8, [E, FE, PD]> wu_w
    let tensor<bf16, [E, FE, GD]> wu_s
    let tensor<bf16, [E, FE, GD]> wu_b
    let tensor<u8, [E, D, PFE]> wd_w
    let tensor<bf16, [E, D, GFE]> wd_s
    let tensor<bf16, [E, D, GFE]> wd_b
    let bool has_shared
    let tensor<f32, [FS, D]> shared_wg
    let tensor<f32, [FS, D]> shared_wu
    let tensor<f32, [D, FS]> shared_wd
    let bool has_shared_gate
    let tensor<f32, [1, D]> shared_gate_w
    let bool use_sigmoid_routing = true
}

# Quantized GGML Q4_K full-attention weights for Qwen3.6 (`2*QD` interleaved Q+gate).
@ public
class Qwen36Q4KFullAttnWeights<size D, size TwoQD, size QD, size KVD, size DH, size RowBytesD, size RowBytesQD> {
    let tensor<f32, [D]> anorm
    let lw_mod.LinearWeight wq_desc
    let tensor<u8, [TwoQD, RowBytesD]> wq_blocks
    let lw_mod.LinearWeight wk_desc
    let tensor<u8, [KVD, RowBytesD]> wk_blocks
    let lw_mod.LinearWeight wv_desc
    let tensor<u8, [KVD, RowBytesD]> wv_blocks
    let lw_mod.LinearWeight wo_desc
    let tensor<u8, [D, RowBytesQD]> wo_blocks
    let bool has_qk_norm
    let tensor<f32, [DH]> q_norm
    let tensor<f32, [DH]> k_norm
}

# Quantized GGML Q4_K ExpertBank MoE weights for Qwen3.6 (routed + shared expert + gate).
@ public
class Qwen36Q4KMoeFfnWeights<size D, size E, size FE, size RowBytesD, size RowBytesFE, size FS> {
    let eb.ExpertBank bank
    let eb.BankedMatrixSpec gate_spec
    let eb.BankedMatrixSpec up_spec
    let eb.BankedMatrixSpec down_spec
    let tensor<f32, [D]> fnorm
    let tensor<f32, [E, D]> router
    let tensor<u8, [E, FE, RowBytesD]> wg_blocks
    let tensor<u8, [E, FE, RowBytesD]> wu_blocks
    let tensor<u8, [E, D, RowBytesFE]> wd_blocks
    let bool has_shared
    let tensor<f32, [FS, D]> shared_wg
    let tensor<f32, [FS, D]> shared_wu
    let tensor<f32, [D, FS]> shared_wd
    let bool has_shared_gate
    let tensor<f32, [1, D]> shared_gate_w
    let bool use_sigmoid_routing = false
}

fn rope_kind_for_step(model_schedule.RopeKind rk, dt.RopeKind default_std) → dt.RopeKind {
    match rk {
        case model_schedule.RopeKind.None {
            return variant dt.RopeKind.None
        }
        default {
            return default_std
        }
    }
}

# Schedule-driven Flint INT4 (`GroupAffineU8` + `BF16` scales/biases) layer step over
# `ExecutionStep`, `SessionState` (`RingKv(513)` / `FullKv`), `LinearWeight`, `ExpertBank`,
# and `res.StandardCarrier`.
@ public
fn flint_layer_step_ga_u8_bf16<size D, size QD, size KVD, size DH, size H, size KVH, size PD, size GD, size PQD, size GQD, size C, size W, size F, size PF, size GF, size E, size K, size FE, size PFE, size GFE, size FS>(model_schedule.ExecutionStep step, tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, FlintGaU8Bf16AttnWeights<D, QD, KVD, DH, H, PD, GD, PQD, GQD> aw, FlintAttnParams ap, mut sess_mod.SessionState<C, W, KVD> sess, i32 pos, FlintGaU8Bf16DenseFfnWeights<D, F, PD, GD, PF, GF> dfw, FlintGaU8Bf16MoeFfnWeights<D, E, FE, PD, GD, PFE, GFE, FS> mfw, mut tensor<f32, [KVH]> k_inv, mut tensor<i32, [K]> top_idx) → void ⇥ HybridError {
    mut tensor<f32, [D]> xn ← tf32[D] {}
    mut tensor<f32, [QD]> q ← tf32[QD] {}
    mut tensor<f32, [KVD]> k ← tf32[KVD] {}
    mut tensor<f32, [KVD]> v ← tf32[KVD] {}
    stages.norm_rmsnorm<size D>(hin, aw.anorm, mut xn, ap.eps)
    stages.linear_project_group_affine_u8_bf16<size QD, size PD, size GD, size D>(aw.wq_desc, aw.wq_w, aw.wq_s, aw.wq_b, xn, mut q)
    stages.linear_project_group_affine_u8_bf16<size KVD, size PD, size GD, size D>(aw.wk_desc, aw.wk_w, aw.wk_s, aw.wk_b, xn, mut k)
    stages.linear_project_group_affine_u8_bf16<size KVD, size PD, size GD, size D>(aw.wv_desc, aw.wv_w, aw.wv_s, aw.wv_b, xn, mut v)

    mut tensor<f32, [QD]> qn ← tf32[QD] {}
    mut tensor<f32, [KVD]> kn ← tf32[KVD] {}
    mut tensor<f32, [H]> q_inv ← tf32[H] {}
    if aw.has_qk_norm {
        stages.norm_qk_heads<size H, size KVH, size QD, size KVD, size DH>(q, k, aw.q_norm, aw.k_norm, mut qn, mut kn, mut q_inv, mut k_inv, ap.eps)
    }
    else {
        stages.copy_qk_heads<size QD, size KVD>(q, k, mut qn, mut kn)
    }

    mut tensor<f32, [QD]> qr ← tf32[QD] {}
    mut tensor<f32, [KVD]> kr ← tf32[KVD] {}
    mut tensor<f32, [QD]> ctx ← tf32[QD] {}
    let dt.RopeKind rk ← rope_kind_for_step(step.rope, ap.rope)
    stages.attn_rope_and_session<size QD, size KVD, size H, size C, size W>(qn, kn, v, mut qr, mut kr, rk, pos, ap.span, ap.lntheta, ap.group, ap.dh, ap.scale, aw.has_sink, aw.softmax_sink, mut sess, step.slot_id, mut ctx)

    mut tensor<f32, [D]> ao ← tf32[D] {}
    mut tensor<f32, [D]> h1 ← tf32[D] {}
    stages.linear_project_group_affine_u8_bf16<size D, size PQD, size GQD, size QD>(aw.wo_desc, aw.wo_w, aw.wo_s, aw.wo_b, ctx, mut ao)
    do device {
        ds.residual_add(hin, ao, mut h1)
    }

    match step.ffn {
        case model_schedule.FfnKind.Dense {
            stages.dense_ffn_ga_u8_bf16_stage<size D, size F, size PD, size GD, size PF, size GF>(h1, mut hout, dfw.fnorm, dfw.wg_desc, dfw.wg_w, dfw.wg_s, dfw.wg_b, dfw.wu_desc, dfw.wu_w, dfw.wu_s, dfw.wu_b, dfw.wd_desc, dfw.wd_w, dfw.wd_s, dfw.wd_b, ap.eps)
        }
        case model_schedule.FfnKind.MoE {
            stages.moe_expert_bank_ga_u8_bf16_ffn_stage<size D, size E, size K, size FE, size PD, size GD, size PFE, size GFE, size FS>(mfw.bank, mfw.gate_spec, mfw.up_spec, mfw.down_spec, h1, mut hout, mfw.fnorm, mfw.router, mfw.wg_w, mfw.wg_s, mfw.wg_b, mfw.wu_w, mfw.wu_s, mfw.wu_b, mfw.wd_w, mfw.wd_s, mfw.wd_b, mfw.has_shared, mfw.shared_wg, mfw.shared_wu, mfw.shared_wd, mfw.has_shared_gate, mfw.shared_gate_w, mut top_idx, ap.eps, mfw.use_sigmoid_routing)
        }
    }
}

# Batched (B = 1, B = k, B = C prefill) Flint layer step over SessionState.
@ public
fn flint_layer_batch_step<size B, size BH, size D, size QD, size KVD, size DH, size H, size KVH, size C, size W, size F, size E, size EF, size ED, size K, size BK, size FE, size FS>(tensor<f32, [B, D]> hin, mut tensor<f32, [B, D]> hout, FlintAttnWeights<D, QD, KVD, DH, H> aw, FlintAttnParams ap, mut sess_mod.SessionState<C, W, KVD> sess, int slot_id, i32 pos, bool is_dense, DenseFfnWeights<D, F> dfw, MoeFfnWeights<D, E, EF, ED, FE, FS> mfw, tensor<f32, [BH]> bhdom1d, mut tensor<f32, [B, KVH]> k_inv, mut tensor<f32, [BK, FE]> expert_act, mut tensor<i32, [B, K]> top_idx, i32 active_b) → void ⇥ sess_mod.SessionError {
    mut tensor<f32, [B, D]> xn ← tf32[B, D] {}
    mut tensor<f32, [B, QD]> q ← tf32[B, QD] {}
    mut tensor<f32, [B, KVD]> k ← tf32[B, KVD] {}
    mut tensor<f32, [B, KVD]> v ← tf32[B, KVD] {}
    let i32 dlen ← D ↦ i32 ⊥ 1
    let bool full_batch ← (active_b ↦ int) ≡ B

    do device {
        ds.rmsnorm_batch(hin, aw.anorm, mut xn, ap.eps)
        if full_batch {
            ds.qkv_proj_batch_gemm(aw.wq, aw.wk, aw.wv, xn, mut q, mut k, mut v)
        }
        else {
            ds.matmul_nt_batch(aw.wq, xn, mut q, active_b, dlen)
            ds.matmul_nt_batch(aw.wk, xn, mut k, active_b, dlen)
            ds.matmul_nt_batch(aw.wv, xn, mut v, active_b, dlen)
        }
    }

    mut tensor<f32, [B, QD]> qn ← tf32[B, QD] {}
    mut tensor<f32, [B, KVD]> kn ← tf32[B, KVD] {}
    mut tensor<f32, [B, H]> q_inv ← tf32[B, H] {}
    if aw.q_norm not is none and aw.k_norm not is none {
        let tensor<f32, [DH]> qn_w ← aw.q_norm
        let tensor<f32, [DH]> kn_w ← aw.k_norm
        stages.norm_qk_heads_batch<size B, size H, size KVH, size QD, size KVD, size DH>(q, k, qn_w, kn_w, mut qn, mut kn, mut q_inv, mut k_inv, true, ap.eps, active_b)
    }
    else {
        do device {
            qn ⇇ q
            kn ⇇ k
        }
    }

    mut tensor<f32, [B, QD]> qr ← tf32[B, QD] {}
    mut tensor<f32, [B, KVD]> kr ← tf32[B, KVD] {}
    do device {
        match ap.rope {
            case dt.RopeKind.None {
                qr ⇇ qn
                kr ⇇ kn
            }
            case dt.RopeKind.Half {
                ds.rope_half_batch(qn, mut qr, pos, ap.span, ap.lntheta, active_b)
                ds.rope_half_batch(kn, mut kr, pos, ap.span, ap.lntheta, active_b)
            }
            case dt.RopeKind.Pairs {
                ds.rope_pairs_batch(qn, mut qr, pos, ap.span, ap.lntheta, active_b)
                ds.rope_pairs_batch(kn, mut kr, pos, ap.span, ap.lntheta, active_b)
            }
        }
    }

    mut tensor<f32, [B, QD]> ctx ← tf32[B, QD] {}
    stages.attn_session_batch<size B, size BH, size QD, size KVD, size H, size C, size W>(qr, kr, v, pos, ap.group, ap.dh, ap.scale, aw.has_sink, aw.softmax_sink, bhdom1d, mut sess, slot_id, mut ctx, active_b)

    mut tensor<f32, [B, D]> ao ← tf32[B, D] {}
    mut tensor<f32, [B, D]> h1 ← tf32[B, D] {}
    let i32 qdlen ← QD ↦ i32 ⊥ 1
    do device {
        if full_batch {
            ds.matmul_nt_gemm(aw.wo, ctx, mut ao)
        }
        else {
            ds.matmul_nt_batch(aw.wo, ctx, mut ao, active_b, qdlen)
        }
        ds.residual_add_batch(hin, ao, mut h1, active_b)
    }

    if is_dense {
        stages.dense_ffn_batch_stage<size B, size D, size F>(h1, mut hout, dfw.fnorm, dfw.wg, dfw.wu, dfw.wd, ap.eps, active_b)
    }
    else {
        if mfw.shared_wg not is none and mfw.shared_wu not is none and mfw.shared_wd not is none {
            let tensor<f32, [FS, D]> swg ← mfw.shared_wg
            let tensor<f32, [FS, D]> swu ← mfw.shared_wu
            let tensor<f32, [D, FS]> swd ← mfw.shared_wd
            if mfw.shared_gate_w not is none {
                let tensor<f32, [1, D]> sgw ← mfw.shared_gate_w
                stages.moe_ffn_batch_stage<size B, size D, size E, size EF, size ED, size K, size BK, size FE, size FS>(h1, mut hout, mfw.fnorm, mfw.router, mfw.wg, mfw.wu, mfw.wd, true, swg, swu, swd, true, sgw, mut top_idx, mut expert_act, ap.eps, mfw.use_sigmoid_routing, active_b)
            }
            else {
                let tensor<f32, [1, D]> empty_sgw ← tf32[1, D] {}
                stages.moe_ffn_batch_stage<size B, size D, size E, size EF, size ED, size K, size BK, size FE, size FS>(h1, mut hout, mfw.fnorm, mfw.router, mfw.wg, mfw.wu, mfw.wd, true, swg, swu, swd, false, empty_sgw, mut top_idx, mut expert_act, ap.eps, mfw.use_sigmoid_routing, active_b)
            }
        }
        else {
            let tensor<f32, [FS, D]> empty_swg ← tf32[FS, D] {}
            let tensor<f32, [D, FS]> empty_swd ← tf32[D, FS] {}
            let tensor<f32, [1, D]> empty_sgw ← tf32[1, D] {}
            stages.moe_ffn_batch_stage<size B, size D, size E, size EF, size ED, size K, size BK, size FE, size FS>(h1, mut hout, mfw.fnorm, mfw.router, mfw.wg, mfw.wu, mfw.wd, false, empty_swg, empty_swg, empty_swd, false, empty_sgw, mut top_idx, mut expert_act, ap.eps, mfw.use_sigmoid_routing, active_b)
        }
    }
}

# Schedule-driven Qwen3.6 F32 layer step over HybridSession + ExpertBank.
@ public
fn qwen36_hybrid_layer_step<size C, size W, size KVD, size D, size ConvCh, size RecRows, size VH, size K_conv, size RecCols, size ConvRows, size TwoQD, size QD, size DH, size H, size E, size EF, size ED, size TopK, size FE, size FS>(model_schedule.ExecutionStep step, tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, Qwen36FullAttnWeights<D, TwoQD, QD, KVD, DH, H> faw, FlintAttnParams ap, tensor<i32, [4]> sections, LinearAttnWeights<D, ConvCh, RecRows, VH, K_conv, RecCols> law, LinearAttnParams lp, eb.ExpertBank bank, tensor<f32, [D]> fnorm, tensor<f32, [E, D]> router, tensor<f32, [EF, D]> wg, tensor<f32, [EF, D]> wu, tensor<f32, [ED, FE]> wd, bool has_shared, tensor<f32, [FS, D]> shared_wg, tensor<f32, [FS, D]> shared_wu, tensor<f32, [D, FS]> shared_wd, bool has_shared_gate, tensor<f32, [1, D]> shared_gate_w, mut hybrid.HybridSession<C, W, KVD, ConvRows, ConvCh, RecRows, RecCols> hs, i32 pos, mut tensor<i32, [TopK]> top_idx) → void ⇥ HybridError {
    mut tensor<f32, [D]> h1 ← tf32[D] {}
    let model_schedule.ArenaKind kind ← sess_mod.slot_kind(hs.kv, step.slot_id)

    match kind {
        case model_schedule.ArenaKind.RecurrentSsm {
            stages.deltanet_hybrid_stage(hin, mut h1, law.anorm, law.wqkv, law.wgate, law.conv_w, law.dt_bias, law.a_row, law.wbeta, law.walpha, law.ssm_norm, law.wout, lp.group_heads, lp.key_dim, lp.eps, lp.site_idx, lp.history_len, mut hs, step.slot_id)
        }
        case model_schedule.ArenaKind.FullKv {
            qwen36_full_attn_step(hin, mut h1, faw, ap, sections, mut hs.kv, step.slot_id, pos)
        }
        default {
            throw variant SessionFailure { message = "qwen36_hybrid_layer_step requires RecurrentSsm or FullKv slot", inner = variant sess_mod.SessionError.SlotArenaMismatch { message = "unsupported slot arena for Qwen3.6 layer" } }
        }
    }

    require bank.expert_count ≡ E and bank.hidden_size ≡ D and bank.intermediate_size ≡ FE throw variant ExpertBankFailure { message = "ExpertBank extents do not match MoE stage dimensions", inner = variant eb.ExpertBankError.BadShape { message = "ExpertBank extents do not match MoE stage dimensions" } }
    mut tensor<f32, [D]> fnx ← tf32[D] {}
    mut tensor<f32, [D]> moe_out ← tf32[D] {}
    stages.moe_routed_core(h1, fnorm, router, wg, wu, wd, mut fnx, mut moe_out, mut top_idx, ap.eps, false)

    if has_shared {
        mut tensor<f32, [D]> s_out ← tf32[D] {}
        mut tensor<f32, [D]> ffn_out ← tf32[D] {}
        stages.moe_shared_ffn_proj(fnx, shared_wg, shared_wu, shared_wd, mut s_out)
        if has_shared_gate {
            mut tensor<f32, [1]> s_gate_logit ← tf32[1] {}
            do device {
                ds.gemv(shared_gate_w, fnx, mut s_gate_logit)
                dhk.sigmoid_gate_add(moe_out, s_out, s_gate_logit, mut ffn_out)
                ds.residual_add(h1, ffn_out, mut hout)
            }
        }
        else {
            do device {
                ds.residual_add(moe_out, s_out, mut ffn_out)
                ds.residual_add(h1, ffn_out, mut hout)
            }
        }
    }
    else {
        do device {
            ds.residual_add(h1, moe_out, mut hout)
        }
    }
}

# Schedule-driven Qwen3.6 quantized GGML Q4_K layer step over HybridSession, LinearWeight,
# and ExpertBank (routed Q4_K + shared expert + sigmoid shared gate).
@ public
fn qwen36_layer_step_q4_k<size C, size W, size KVD, size D, size ConvCh, size RecRows, size VH, size K_conv, size RecCols, size ConvRows, size TwoQD, size QD, size DH, size H, size KVH, size RowBytesD, size RowBytesQD, size RowBytesFE, size E, size TopK, size FE, size FS>(model_schedule.ExecutionStep step, tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, Qwen36Q4KFullAttnWeights<D, TwoQD, QD, KVD, DH, RowBytesD, RowBytesQD> faw, FlintAttnParams ap, tensor<i32, [4]> sections, LinearAttnWeights<D, ConvCh, RecRows, VH, K_conv, RecCols> law, LinearAttnParams lp, Qwen36Q4KMoeFfnWeights<D, E, FE, RowBytesD, RowBytesFE, FS> mfw, mut hybrid.HybridSession<C, W, KVD, ConvRows, ConvCh, RecRows, RecCols> hs, i32 pos, mut tensor<f32, [KVH]> k_inv, mut tensor<i32, [TopK]> top_idx) → void ⇥ HybridError {
    mut tensor<f32, [D]> h1 ← tf32[D] {}
    let model_schedule.ArenaKind kind ← sess_mod.slot_kind(hs.kv, step.slot_id)

    match kind {
        case model_schedule.ArenaKind.RecurrentSsm {
            stages.deltanet_hybrid_stage(hin, mut h1, law.anorm, law.wqkv, law.wgate, law.conv_w, law.dt_bias, law.a_row, law.wbeta, law.walpha, law.ssm_norm, law.wout, lp.group_heads, lp.key_dim, lp.eps, lp.site_idx, lp.history_len, mut hs, step.slot_id)
        }
        case model_schedule.ArenaKind.FullKv {
            mut tensor<f32, [D]> xn ← tf32[D] {}
            mut tensor<f32, [TwoQD]> q_full ← tf32[TwoQD] {}
            mut tensor<f32, [QD]> q ← tf32[QD] {}
            mut tensor<f32, [QD]> q_gate ← tf32[QD] {}
            mut tensor<f32, [KVD]> k ← tf32[KVD] {}
            mut tensor<f32, [KVD]> v ← tf32[KVD] {}
            stages.norm_rmsnorm<size D>(hin, faw.anorm, mut xn, ap.eps)
            stages.linear_project_ggml_q4_k<size TwoQD, size RowBytesD, size D>(faw.wq_desc, faw.wq_blocks, xn, mut q_full)
            stages.linear_project_ggml_q4_k<size KVD, size RowBytesD, size D>(faw.wk_desc, faw.wk_blocks, xn, mut k)
            stages.linear_project_ggml_q4_k<size KVD, size RowBytesD, size D>(faw.wv_desc, faw.wv_blocks, xn, mut v)
            do device {
                dhk.split_q_gate_interleaved(q_full, mut q, mut q_gate, ap.dh)
            }
            mut tensor<f32, [QD]> qn ← tf32[QD] {}
            mut tensor<f32, [KVD]> kn ← tf32[KVD] {}
            mut tensor<f32, [H]> q_inv ← tf32[H] {}
            if faw.has_qk_norm {
                stages.norm_qk_heads<size H, size KVH, size QD, size KVD, size DH>(q, k, faw.q_norm, faw.k_norm, mut qn, mut kn, mut q_inv, mut k_inv, ap.eps)
            }
            else {
                stages.copy_qk_heads<size QD, size KVD>(q, k, mut qn, mut kn)
            }
            mut tensor<f32, [QD]> qr ← tf32[QD] {}
            mut tensor<f32, [KVD]> kr ← tf32[KVD] {}
            mut tensor<f32, [QD]> ctx ← tf32[QD] {}
            stages.attn_sectional_and_session<size QD, size KVD, size H, size C, size W>(qn, kn, v, mut qr, mut kr, pos, ap.dh, sections, ap.lntheta, ap.group, ap.scale, mut hs.kv, step.slot_id, mut ctx)
            mut tensor<f32, [QD]> gated_ctx ← tf32[QD] {}
            mut tensor<f32, [D]> ao ← tf32[D] {}
            do device {
                dhk.sigmoid_mul(ctx, q_gate, mut gated_ctx)
            }
            stages.linear_project_ggml_q4_k<size D, size RowBytesQD, size QD>(faw.wo_desc, faw.wo_blocks, gated_ctx, mut ao)
            do device {
                ds.residual_add(hin, ao, mut h1)
            }
        }
        default {
            throw variant SessionFailure { message = "qwen36_layer_step_q4_k requires RecurrentSsm or FullKv slot", inner = variant sess_mod.SessionError.SlotArenaMismatch { message = "unsupported slot arena for Qwen3.6 layer" } }
        }
    }

    stages.moe_expert_bank_ggml_q4_k_shared_ffn_stage<size D, size E, size TopK, size FE, size RowBytesD, size RowBytesFE, size FS>(mfw.bank, mfw.gate_spec, mfw.up_spec, mfw.down_spec, h1, mut hout, mfw.fnorm, mfw.router, mfw.wg_blocks, mfw.wu_blocks, mfw.wd_blocks, mfw.has_shared, mfw.shared_wg, mfw.shared_wu, mfw.shared_wd, mfw.has_shared_gate, mfw.shared_gate_w, mut top_idx, ap.eps, mfw.use_sigmoid_routing)
}

# Batched (B = 1, B = k, B = C prefill) Qwen3.6 full-attention + MoE layer step over SessionState.
@ public
fn qwen36_full_layer_batch_step<size B, size BH, size D, size TwoQD, size QD, size KVD, size DH, size H, size KVH, size C, size W, size E, size EF, size ED, size K, size BK, size FE, size FS>(tensor<f32, [B, D]> hin, mut tensor<f32, [B, D]> hout, Qwen36FullAttnWeights<D, TwoQD, QD, KVD, DH, H> aw, FlintAttnParams ap, tensor<i32, [4]> sections, mut sess_mod.SessionState<C, W, KVD> sess, int slot_id, i32 pos, MoeFfnWeights<D, E, EF, ED, FE, FS> mfw, tensor<f32, [BH]> bhdom1d, mut tensor<f32, [B, KVH]> k_inv, mut tensor<f32, [BK, FE]> expert_act, mut tensor<i32, [B, K]> top_idx, i32 active_b) → void ⇥ sess_mod.SessionError {
    mut tensor<f32, [B, D]> xn ← tf32[B, D] {}
    mut tensor<f32, [B, TwoQD]> q_full ← tf32[B, TwoQD] {}
    mut tensor<f32, [B, QD]> q ← tf32[B, QD] {}
    mut tensor<f32, [B, QD]> q_gate ← tf32[B, QD] {}
    mut tensor<f32, [B, KVD]> k ← tf32[B, KVD] {}
    mut tensor<f32, [B, KVD]> v ← tf32[B, KVD] {}
    let i32 dlen ← D ↦ i32 ⊥ 1
    let bool full_batch ← (active_b ↦ int) ≡ B

    do device {
        ds.rmsnorm_batch(hin, aw.anorm, mut xn, ap.eps)
        if full_batch {
            ds.matmul_nt_gemm(aw.wq, xn, mut q_full)
            ds.matmul_nt_gemm(aw.wk, xn, mut k)
            ds.matmul_nt_gemm(aw.wv, xn, mut v)
        }
        else {
            ds.matmul_nt_batch(aw.wq, xn, mut q_full, active_b, dlen)
            ds.matmul_nt_batch(aw.wk, xn, mut k, active_b, dlen)
            ds.matmul_nt_batch(aw.wv, xn, mut v, active_b, dlen)
        }
        dhk.split_q_gate_interleaved_batch(q_full, mut q, mut q_gate, ap.dh, active_b)
    }

    mut tensor<f32, [B, QD]> qn ← tf32[B, QD] {}
    mut tensor<f32, [B, KVD]> kn ← tf32[B, KVD] {}
    mut tensor<f32, [B, H]> q_inv ← tf32[B, H] {}
    if aw.q_norm not is none and aw.k_norm not is none {
        let tensor<f32, [DH]> qn_w ← aw.q_norm
        let tensor<f32, [DH]> kn_w ← aw.k_norm
        stages.norm_qk_heads_batch<size B, size H, size KVH, size QD, size KVD, size DH>(q, k, qn_w, kn_w, mut qn, mut kn, mut q_inv, mut k_inv, true, ap.eps, active_b)
    }
    else {
        do device {
            qn ⇇ q
            kn ⇇ k
        }
    }

    mut tensor<f32, [B, QD]> qr ← tf32[B, QD] {}
    mut tensor<f32, [B, KVD]> kr ← tf32[B, KVD] {}
    do device {
        dhk.rope_sectional_batch(qn, mut qr, pos, ap.dh, sections, ap.lntheta, active_b)
        dhk.rope_sectional_batch(kn, mut kr, pos, ap.dh, sections, ap.lntheta, active_b)
    }

    mut tensor<f32, [B, QD]> ctx ← tf32[B, QD] {}
    let tensor<f32, [H]> no_sink ← tf32[H] {}
    stages.attn_session_batch<size B, size BH, size QD, size KVD, size H, size C, size W>(qr, kr, v, pos, ap.group, ap.dh, ap.scale, false, no_sink, bhdom1d, mut sess, slot_id, mut ctx, active_b)

    mut tensor<f32, [B, QD]> gated_ctx ← tf32[B, QD] {}
    mut tensor<f32, [B, D]> ao ← tf32[B, D] {}
    mut tensor<f32, [B, D]> h1 ← tf32[B, D] {}
    let i32 qdlen ← QD ↦ i32 ⊥ 1
    do device {
        dhk.sigmoid_mul_batch(ctx, q_gate, mut gated_ctx, active_b)
        if full_batch {
            ds.matmul_nt_gemm(aw.wo, gated_ctx, mut ao)
        }
        else {
            ds.matmul_nt_batch(aw.wo, gated_ctx, mut ao, active_b, qdlen)
        }
        ds.residual_add_batch(hin, ao, mut h1, active_b)
    }

    if mfw.shared_wg not is none and mfw.shared_wu not is none and mfw.shared_wd not is none {
        let tensor<f32, [FS, D]> swg ← mfw.shared_wg
        let tensor<f32, [FS, D]> swu ← mfw.shared_wu
        let tensor<f32, [D, FS]> swd ← mfw.shared_wd
        if mfw.shared_gate_w not is none {
            let tensor<f32, [1, D]> sgw ← mfw.shared_gate_w
            stages.moe_ffn_batch_stage<size B, size D, size E, size EF, size ED, size K, size BK, size FE, size FS>(h1, mut hout, mfw.fnorm, mfw.router, mfw.wg, mfw.wu, mfw.wd, true, swg, swu, swd, true, sgw, mut top_idx, mut expert_act, ap.eps, mfw.use_sigmoid_routing, active_b)
        }
        else {
            let tensor<f32, [1, D]> empty_sgw ← tf32[1, D] {}
            stages.moe_ffn_batch_stage<size B, size D, size E, size EF, size ED, size K, size BK, size FE, size FS>(h1, mut hout, mfw.fnorm, mfw.router, mfw.wg, mfw.wu, mfw.wd, true, swg, swu, swd, false, empty_sgw, mut top_idx, mut expert_act, ap.eps, mfw.use_sigmoid_routing, active_b)
        }
    }
    else {
        let tensor<f32, [FS, D]> empty_swg ← tf32[FS, D] {}
        let tensor<f32, [D, FS]> empty_swd ← tf32[D, FS] {}
        let tensor<f32, [1, D]> empty_sgw ← tf32[1, D] {}
        stages.moe_ffn_batch_stage<size B, size D, size E, size EF, size ED, size K, size BK, size FE, size FS>(h1, mut hout, mfw.fnorm, mfw.router, mfw.wg, mfw.wu, mfw.wd, false, empty_swg, empty_swg, empty_swd, false, empty_sgw, mut top_idx, mut expert_act, ap.eps, mfw.use_sigmoid_routing, active_b)
    }
}

+++ faber test
import from "gradus:decode_hybrid" let dh
import from "gradus:decode_token" let dt
import from "gradus:cache/session" let sess_mod
import from "gradus:cache/hybrid_arenas" let hybrid
import from "gradus:model/schedule" let model_schedule

fn close(f32 a, f32 b) → bool {
    return (a - b).abs() ≺ 0.0001
}

fn mk_flint_sched() → model_schedule.ExecutionSchedule {
    let list<model_schedule.AttentionKind> attns ← [
        variant model_schedule.AttentionKind.SlidingWindow { window = 5 },
        variant model_schedule.AttentionKind.Full
    ]
    let list<model_schedule.RopeKind> ropes ← [
        variant model_schedule.RopeKind.Standard,
        variant model_schedule.RopeKind.None
    ]
    do {
        return model_schedule.patterned_schedule(attns, ropes, 2, [])
    }
    catch err {
        assert false
        return model_schedule.ExecutionSchedule { layers = [], segments = [], steps = [], slots = [], residual = variant model_schedule.ResidualKind.Standard, taps = [] }
    }
}

fn mk_q36_linear_sched() → model_schedule.ExecutionSchedule {
    let list<model_schedule.AttentionKind> attns ← [
        variant model_schedule.AttentionKind.LinearSsm
    ]
    let list<model_schedule.RopeKind> ropes ← [
        variant model_schedule.RopeKind.None
    ]
    do {
        return model_schedule.patterned_schedule(attns, ropes, 1, [])
    }
    catch err {
        assert false
        return model_schedule.ExecutionSchedule { layers = [], segments = [], steps = [], slots = [], residual = variant model_schedule.ResidualKind.Standard, taps = [] }
    }
}

fn mk_q36_full_sched() → model_schedule.ExecutionSchedule {
    let list<model_schedule.AttentionKind> attns ← [
        variant model_schedule.AttentionKind.Full
    ]
    let list<model_schedule.RopeKind> ropes ← [
        variant model_schedule.RopeKind.Standard
    ]
    do {
        return model_schedule.patterned_schedule(attns, ropes, 1, [])
    }
    catch err {
        assert false
        return model_schedule.ExecutionSchedule { layers = [], segments = [], steps = [], slots = [], residual = variant model_schedule.ResidualKind.Standard, taps = [] }
    }
}

test "decode_hybrid flint_attn_step dispatches RingKvArena and FullKvArena with QK-norm and sink" {
    let model_schedule.ExecutionSchedule sched ← mk_flint_sched()
    do {
        mut sess_mod.SessionState<8, 5, 2> sess ← sess_mod.from_schedule<size 8, size 5, size 2>(sched)

        mut tensor<f32, [2]> hin ← tf32[2] {}
        hin[[0]] ← 1.0
        hin[[1]] ← 1.0

        mut tensor<f32, [2]> anorm ← tf32[2] {}
        anorm[[0]] ← 1.0
        anorm[[1]] ← 1.0

        mut tensor<f32, [4, 2]> wq ← tf32[4, 2] {}
        wq[[0, 0]] ← 1.0
        wq[[2, 1]] ← 1.0

        mut tensor<f32, [2, 2]> wk ← tf32[2, 2] {}
        wk[[0, 0]] ← 1.0

        mut tensor<f32, [2, 2]> wv ← tf32[2, 2] {}
        wv[[0, 0]] ← 1.0
        wv[[1, 1]] ← 1.0

        mut tensor<f32, [2, 4]> wo ← tf32[2, 4] {}
        wo[[0, 0]] ← 1.0
        wo[[1, 3]] ← 1.0

        mut tensor<f32, [2]> qn ← tf32[2] {}
        qn[[0]] ← 1.0
        qn[[1]] ← 1.0

        mut tensor<f32, [2]> kn ← tf32[2] {}
        kn[[0]] ← 1.0
        kn[[1]] ← 1.0

        mut tensor<f32, [2]> sink ← tf32[2] {}
        sink[[0]] ← 0.0
        sink[[1]] ← 0.0

        let dh.FlintAttnWeights<2, 4, 2, 2, 2> aw ← dh.FlintAttnWeights<2, 4, 2, 2, 2> {
            anorm = anorm,
            wq = wq,
            wk = wk,
            wv = wv,
            wo = wo,
            q_norm = qn,
            k_norm = kn,
            has_sink = true,
            softmax_sink = sink
        }

        let dh.FlintAttnParams ap_swa ← dh.FlintAttnParams {
            dh = 2,
            span = 1,
            group = 2,
            rope = variant dt.RopeKind.Half,
            eps = 0.0,
            lntheta = 0.0,
            scale = 1.0
        }
        let dh.FlintAttnParams ap_full ← dh.FlintAttnParams {
            dh = 2,
            span = 1,
            group = 2,
            rope = variant dt.RopeKind.None,
            eps = 0.0,
            lntheta = 0.0,
            scale = 1.0
        }

        mut tensor<f32, [2]> hout_swa ← tf32[2] {}
        mut tensor<f32, [2]> hout_full ← tf32[2] {}

        # Step 6 tokens into RingKv slot 0 (window 5 wraps at pos 5 -> slot 0).
        for range 0‥6 let p {
            dh.flint_attn_step(hin, mut hout_swa, aw, ap_swa, mut sess, 0, p ↦ i32 ⊥ 0)
        }
        dh.flint_attn_step(hin, mut hout_full, aw, ap_full, mut sess, 1, 0)

        assert sess.ring_kv.total_written[0] ≡ 6
        assert sess.full_kv.lengths[0] ≡ 1
        assert hout_swa[[0]] ≻ 1.0
        assert hout_full[[0]] ≻ 1.0
    }
    catch err {
        assert false
    }
}

test "decode_hybrid flint_layer_step supports leading dense FFN and routed+shared MoE" {
    let model_schedule.ExecutionSchedule sched ← mk_flint_sched()
    do {
        mut sess_mod.SessionState<8, 5, 2> sess ← sess_mod.from_schedule<size 8, size 5, size 2>(sched)

        mut tensor<f32, [2]> hin ← tf32[2] {}
        hin[[0]] ← 1.0
        hin[[1]] ← 1.0
        mut tensor<f32, [2]> ones2 ← tf32[2] {}
        ones2[[0]] ← 1.0
        ones2[[1]] ← 1.0

        mut tensor<f32, [4, 2]> wq ← tf32[4, 2] {}
        wq[[0, 0]] ← 1.0
        mut tensor<f32, [2, 2]> wk ← tf32[2, 2] {}
        wk[[0, 0]] ← 1.0
        mut tensor<f32, [2, 2]> wv ← tf32[2, 2] {}
        wv[[0, 0]] ← 1.0
        mut tensor<f32, [2, 4]> wo ← tf32[2, 4] {}
        wo[[0, 0]] ← 1.0

        mut tensor<f32, [2]> zsink ← tf32[2] {}
        let dh.FlintAttnWeights<2, 4, 2, 2, 2> aw ← dh.FlintAttnWeights<2, 4, 2, 2, 2> {
            anorm = ones2, wq = wq, wk = wk, wv = wv, wo = wo,
            softmax_sink = zsink
        }
        let dh.FlintAttnParams ap ← dh.FlintAttnParams {
            dh = 2, span = 1, group = 2, rope = variant dt.RopeKind.None,
            eps = 0.0, lntheta = 0.0, scale = 1.0
        }

        mut tensor<f32, [2, 2]> df_wg ← tf32[2, 2] {}
        df_wg[[0, 0]] ← 1.0
        mut tensor<f32, [2, 2]> df_wu ← tf32[2, 2] {}
        df_wu[[0, 0]] ← 1.0
        mut tensor<f32, [2, 2]> df_wd ← tf32[2, 2] {}
        df_wd[[0, 0]] ← 1.0
        let dh.DenseFfnWeights<2, 2> dfw ← dh.DenseFfnWeights<2, 2> {
            fnorm = ones2, wg = df_wg, wu = df_wu, wd = df_wd
        }

        mut tensor<f32, [2, 2]> router ← tf32[2, 2] {}
        router[[0, 0]] ← 1.0
        mut tensor<f32, [4, 2]> e_wg ← tf32[4, 2] {}
        e_wg[[0, 0]] ← 1.0
        mut tensor<f32, [4, 2]> e_wu ← tf32[4, 2] {}
        e_wu[[0, 0]] ← 1.0
        mut tensor<f32, [4, 2]> e_wd ← tf32[4, 2] {}
        e_wd[[0, 0]] ← 1.0
        mut tensor<f32, [1, 2]> sgw ← tf32[1, 2] {}
        let dh.MoeFfnWeights<2, 2, 4, 4, 2, 2> mfw ← dh.MoeFfnWeights<2, 2, 4, 4, 2, 2> {
            fnorm = ones2, router = router, wg = e_wg, wu = e_wu, wd = e_wd,
            shared_wg = df_wg, shared_wu = df_wu, shared_wd = df_wd,
            shared_gate_w = sgw, use_sigmoid_routing = true
        }

        mut tensor<f32, [2]> out_dense ← tf32[2] {}
        mut tensor<f32, [2]> out_moe ← tf32[2] {}
        mut tensor<i32, [1]> top_idx ← tensor<i32, [1]> {}
        dh.flint_layer_step<size 2, size 4, size 2, size 2, size 2, size 8, size 5, size 2, size 2, size 4, size 4, size 1, size 2, size 2>(hin, mut out_dense, aw, ap, mut sess, 1, 0, true, dfw, mfw, mut top_idx)
        dh.flint_layer_step<size 2, size 4, size 2, size 2, size 2, size 8, size 5, size 2, size 2, size 4, size 4, size 1, size 2, size 2>(hin, mut out_moe, aw, ap, mut sess, 1, 1, false, dfw, mfw, mut top_idx)

        assert out_dense[[0]] ≻ 1.0
        assert out_moe[[0]] ≻ 1.0
    }
    catch err {
        assert false
    }
}

fn mk_q36_linear_weights() → dh.LinearAttnWeights<2, 6, 2, 1, 4, 2> {
    mut tensor<f32, [2]> anorm ← tf32[2] {}
    anorm[[0]] ← 1.0
    anorm[[1]] ← 1.0
    mut tensor<f32, [6, 2]> wqkv ← tf32[6, 2] {}
    wqkv[[0, 0]] ← 1.0
    wqkv[[2, 0]] ← 1.0
    wqkv[[4, 0]] ← 1.0
    mut tensor<f32, [2, 2]> wgate ← tf32[2, 2] {}
    wgate[[0, 0]] ← 1.0
    mut tensor<f32, [6, 4]> conv_w ← tf32[6, 4] {}
    conv_w[[0, 3]] ← 1.0
    conv_w[[2, 3]] ← 1.0
    conv_w[[4, 3]] ← 1.0
    mut tensor<f32, [1]> dt_bias ← tf32[1] {}
    mut tensor<f32, [1]> a_row ← tf32[1] {}
    a_row[[0]] ← -1.0
    mut tensor<f32, [1, 2]> wbeta ← tf32[1, 2] {}
    mut tensor<f32, [1, 2]> walpha ← tf32[1, 2] {}
    mut tensor<f32, [2]> ssm_norm ← tf32[2] {}
    ssm_norm[[0]] ← 1.0
    ssm_norm[[1]] ← 1.0
    mut tensor<f32, [2, 2]> wout ← tf32[2, 2] {}
    wout[[0, 0]] ← 1.0

    return dh.LinearAttnWeights<2, 6, 2, 1, 4, 2> {
        anorm = anorm, wqkv = wqkv, wgate = wgate, conv_w = conv_w,
        dt_bias = dt_bias, a_row = a_row, wbeta = wbeta, walpha = walpha,
        ssm_norm = ssm_norm, wout = wout
    }
}

test "decode_hybrid qwen36_linear_attn_step advances ConvStateArena and RecurrentStateArena" {
    let model_schedule.ExecutionSchedule sched ← mk_q36_linear_sched()
    do {
        mut hybrid.ConvStateArena<3, 6> conv ← hybrid.conv_from_schedule<size 3, size 6>(sched, 1, 3, false)
        mut hybrid.RecurrentStateArena<2, 2> rec ← hybrid.recurrent_from_schedule<size 2, size 2>(sched)

        # D=2, ConvCh=6 (Q=2, K=2, V=2), InnerSize=2, VH=1, K=4, HeadVDim=2
        mut tensor<f32, [2]> hin ← tf32[2] {}
        hin[[0]] ← 1.0
        hin[[1]] ← 1.0
        let dh.LinearAttnWeights<2, 6, 2, 1, 4, 2> lw ← mk_q36_linear_weights()
        let dh.LinearAttnParams lp ← dh.LinearAttnParams {
            group_heads = 1, key_dim = 2, eps = 0.00001, site_idx = 0, history_len = 3
        }

        mut tensor<f32, [2]> hout ← tf32[2] {}
        dh.qwen36_linear_attn_step(hin, mut hout, lw, lp, mut conv, mut rec, 0)

        assert conv.steps_written[0] ≡ 1
        assert rec.steps_written[0] ≡ 1
        assert hout[[0]] ≻ 1.0
    }
    catch err {
        assert false
    }
}

test "decode_hybrid qwen36_linear_attn_hybrid_step matches qwen36_linear_attn_step over HybridSession" {
    let model_schedule.ExecutionSchedule sched ← mk_q36_linear_sched()
    do {
        mut hybrid.ConvStateArena<3, 6> conv_ref ← hybrid.conv_from_schedule<size 3, size 6>(sched, 1, 3, false)
        mut hybrid.RecurrentStateArena<2, 2> rec_ref ← hybrid.recurrent_from_schedule<size 2, size 2>(sched)
        mut hybrid.HybridSession<8, 1, 2, 3, 6, 2, 2> hs ← hybrid.from_schedule<size 8, size 1, size 2, size 3, size 6, size 2, size 2>(sched, 1, 3, false)

        mut tensor<f32, [2]> hin ← tf32[2] {}
        hin[[0]] ← 1.0
        hin[[1]] ← 1.0
        let dh.LinearAttnWeights<2, 6, 2, 1, 4, 2> lw ← mk_q36_linear_weights()
        let dh.LinearAttnParams lp ← dh.LinearAttnParams {
            group_heads = 1, key_dim = 2, eps = 0.00001, site_idx = 0, history_len = 3
        }

        mut tensor<f32, [2]> hout_ref ← tf32[2] {}
        mut tensor<f32, [2]> hout_hybrid ← tf32[2] {}
        dh.qwen36_linear_attn_step(hin, mut hout_ref, lw, lp, mut conv_ref, mut rec_ref, 0)
        dh.qwen36_linear_attn_hybrid_step(hin, mut hout_hybrid, lw, lp, mut hs, 0)

        assert hs.conv.steps_written[0] ≡ 1
        assert hs.recurrent.steps_written[0] ≡ 1
        assert hout_hybrid[[0]] ≻ 1.0
        assert close(hout_hybrid[[0]], hout_ref[[0]])
        assert close(hout_hybrid[[1]], hout_ref[[1]])
    }
    catch err {
        assert false
    }
}

test "decode_hybrid qwen36_full_attn_step applies sectional RoPE and writes FullKvArena" {
    let model_schedule.ExecutionSchedule sched ← mk_q36_full_sched()
    do {
        mut sess_mod.SessionState<8, 1, 4> sess ← sess_mod.from_dense_schedule<size 8, size 4>(sched)

        mut tensor<f32, [4]> hin ← tf32[4] {}
        hin[[0]] ← 1.0
        hin[[1]] ← 1.0
        hin[[2]] ← 1.0
        hin[[3]] ← 1.0
        mut tensor<f32, [4]> ones4 ← tf32[4] {}
        for range 0‥4 let i {
            ones4[[i]] ← 1.0
        }
        mut tensor<f32, [4, 4]> eye4 ← tf32[4, 4] {}
        mut tensor<f32, [8, 4]> wq_2qd ← tf32[8, 4] {}
        for range 0‥4 let i {
            eye4[[i, i]] ← 1.0
            wq_2qd[[i, i]] ← 1.0
        }
        # Set gate rows (4..7) to 2.0 on diagonal -> gate = [2.0, 0, 0, 0] -> sigmoid(2.0) ~ 0.8808
        wq_2qd[[4, 0]] ← 2.0

        let dh.Qwen36FullAttnWeights<4, 8, 4, 4, 4, 1> aw ← dh.Qwen36FullAttnWeights<4, 8, 4, 4, 4, 1> {
            anorm = ones4, wq = wq_2qd, wk = eye4, wv = eye4, wo = eye4,
            q_norm = ones4, k_norm = ones4
        }
        let dh.FlintAttnParams ap ← dh.FlintAttnParams {
            dh = 4, span = 1, group = 1, rope = variant dt.RopeKind.Half,
            eps = 0.0, lntheta = 0.0, scale = 0.5
        }
        mut tensor<i32, [4]> sections ← tensor<i32, [4]> {}
        sections[[0]] ← 1
        sections[[1]] ← 0
        sections[[2]] ← 0
        sections[[3]] ← 0

        mut tensor<f32, [4]> hout0 ← tf32[4] {}
        mut tensor<f32, [4]> hout ← tf32[4] {}
        dh.qwen36_full_attn_step(hin, mut hout0, aw, ap, sections, mut sess, 0, 0)
        dh.qwen36_full_attn_step(hin, mut hout, aw, ap, sections, mut sess, 0, 1)

        assert sess.full_kv.lengths[0] ≡ 2
        # At dim 0, gate = 2.0 -> sigmoid(2.0) ~ 0.8808, so hout[0] ~ 1.0 + 0.8808 = 1.8808
        # At dim 1, gate = 0.0 -> sigmoid(0.0) = 0.5, so hout[1] = 1.0 + 0.5 = 1.5
        let f32 sig2 ← (1.0 ∷ f32) / ((1.0 ∷ f32) + (-2.0 ∷ f32).exp())
        assert close(hout[[0]], 1.0 + sig2)
        assert close(hout[[1]], 1.5)
    }
    catch err {
        assert false
    }
}

test "decode_hybrid Flint sigmoid MoE routing matches sigmoid/sum vs softmax" {
    mut tensor<f32, [2]> h1 ← tf32[2] {}
    h1[[0]] ← 1.0
    h1[[1]] ← 1.0
    mut tensor<f32, [2]> ones2 ← tf32[2] {}
    ones2[[0]] ← 1.0
    ones2[[1]] ← 1.0

    # Router logits: expert 0 gets 0.0, expert 1 gets 2.0.
    mut tensor<f32, [2, 2]> router ← tf32[2, 2] {}
    router[[1, 0]] ← 2.0
    # Expert 0 down = [1, 0], Expert 1 down = [3, 0] (with gate/up = 1*1 -> silu(1)*1).
    mut tensor<f32, [4, 2]> wg ← tf32[4, 2] {}
    wg[[0, 0]] ← 1.0
    wg[[2, 0]] ← 1.0
    mut tensor<f32, [4, 2]> wu ← tf32[4, 2] {}
    wu[[0, 0]] ← 1.0
    wu[[2, 0]] ← 1.0
    mut tensor<f32, [4, 2]> wd ← tf32[4, 2] {}
    wd[[0, 0]] ← 1.0
    wd[[2, 0]] ← 3.0

    let dh.MoeFfnWeights<2, 2, 4, 4, 2, 2> mw_sig ← dh.MoeFfnWeights<2, 2, 4, 4, 2, 2> {
        fnorm = ones2, router = router, wg = wg, wu = wu, wd = wd,
        use_sigmoid_routing = true
    }
    let dh.MoeFfnWeights<2, 2, 4, 4, 2, 2> mw_soft ← dh.MoeFfnWeights<2, 2, 4, 4, 2, 2> {
        fnorm = ones2, router = router, wg = wg, wu = wu, wd = wd,
        use_sigmoid_routing = false
    }

    mut tensor<i32, [2]> top_idx ← ti32[2] {}
    mut tensor<f32, [2]> out_sig ← tf32[2] {}
    mut tensor<f32, [2]> out_soft ← tf32[2] {}
    dh.moe_ffn_step(h1, mut out_sig, mw_sig, mut top_idx, 0.0)
    dh.moe_ffn_step(h1, mut out_soft, mw_soft, mut top_idx, 0.0)

    # Sigmoid weights: s0 = 0.5, s1 = sigmoid(2.0) -> w0 = s0/(s0+s1), w1 = s1/(s0+s1)
    # Softmax weights: e0 = 1.0, e1 = exp(2.0) -> noticeably higher weight on expert 1 (wd=3.0)
    assert out_soft[[0]] ≻ out_sig[[0]] + 0.1 ∷ f32
    let f32 s0 ← 0.5 ∷ f32
    let f32 s1 ← (1.0 ∷ f32) / ((1.0 ∷ f32) + (-2.0 ∷ f32).exp())
    let f32 w0 ← s0 / (s0 + s1)
    let f32 w1 ← s1 / (s0 + s1)
    let f32 silu1 ← (1.0 ∷ f32) / ((1.0 ∷ f32) + (-1.0 ∷ f32).exp())
    assert close(out_sig[[0]], 1.0 + silu1 * (w0 * 1.0 + w1 * 3.0))
}
