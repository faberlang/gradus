# Co-located package test for optimize.fab (PML4-U3 — optimizer state,
# SGD first). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * the per-parameter state slot: identity (possessor + nomen, PML1-U5)
#     + state version (mutation counter) + generation (parameter versio at
#     last apply, the U2 seam) + step count + learning rate; construction
#     is fail-closed (empty/reserved identity fields, invalid version /
#     generation / step count / learning rate — causa identity).
#   * the optimizer collection: uniqueness by identity, fail-closed
#     resolution (inveni), registration.
#   * the state mutation rules (passus — one explicit step): identity
#     match, gradient freshness (NOT gradient.obsoletus — the U2 generation
#     seam), trainable-only, gradient shape ≡ parameter shape; the update
#     param' = param − lentus·grad advances the state (versio +1, generatio
#     = new param versio, passus +1) and composes with parameter.fab muta
#     (the parameter versio bumps 1 → 2).
#   * the versioned wire round-trip: deserializa(serializa(x)) ≡ x by
#     statum_aequus / sgd_aequus — EXACT, including the learning rate;
#     unknown markers/schema versions and malformed fields fail closed.
#   * the U2 bundle composition: a Gradientes bundle resolves by identity
#     and its gradient steps a parameter.
#
# Oracle pins: f64 evaluations of the documented SGD update formula
# param' = param − lr·grad for the canonical data param = [1,2,3,4],
# grad = [0.25,0.5,0.75,1.0] (the U2 grad_w oracle pins), lr = 0.01 (the
# accepted MLP training proof's lr): [0.9975, 1.995, 2.9925, 3.99]. The
# auditor-owned runtime-evidence gate compares the step's output against
# these under the GPU lane's tolerance rows (numeric-policy v1.0.0 — the
# 1e-4 gradient row; the conservative 1e-4 absolute tolerance below covers
# f32 self-hosting over these magnitudes).
#
# EVIDENCE HONESTY (CTO Q2, hard): this suite is STRUCTURAL proof. No
# executed step value or checkpoint value is claimed here; the oracle pins
# are f64 evaluations of the documented formulas. Executed value-identity
# is env-blocked tree-wide today (FMIR stepper / library-import gap —
# recorded residual); PML4-U3 is PARTIAL and value-identity is deferred to
# the auditor-owned runtime-evidence gate.
#
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/optimize.proba` proves the suite
# type-checks. Execution of proba bodies is env-blocked tree-wide today
# (recorded residual); this suite is the compile-level proof of the
# contract.

importa ex "gradus:optimize" optimize
importa ex "gradus:parameter" parametrum
importa ex "gradus:gradient" gradient
importa ex "gradus:tensor" tensor

# ---- helpers (the loss.proba / gradient.proba pattern)

# Build a staged tensor, swallowing the never-firing construction errors.
functio tene(lista<f32> datos, lista<numerus> forma) → tensor.Tensor {
    varia tensor.Tensor t
    fac {
        t ← tensor.structa(datos, forma)
    }
    cape err {
        redde t
    }
    redde t
}

# Staged-result element read (swallow the never-firing access errors).
functio e1(tensor.Tensor t, numerus i) → f32 {
    fac {
        redde t.accipe([i])
    }
    cape err {
        redde (0.0 - 999.0) ∷ f32
    }
}

# Renders a state-construction outcome as textus: "ok" on success, the
# typed error's causa on rejection.
functio structa_detail(textus possessor, textus nomen, numerus generatio, f32 lentus) → textus {
    fac {
        fixum optimize.SgdStatum _ ← optimize.structa(possessor, nomen, generatio, lentus)
        redde "ok"
    }
    cape err {
        redde optimize.causa(err)
    }
}

# Renders a step outcome as textus: "ok" on success, the typed error's
# causa on rejection.
functio passus_detail(optimize.SgdStatum s, parametrum.Parametrum p, gradient.Gradiente g) → textus {
    fac {
        fixum optimize.Passus _ ← optimize.passus(s, p, g)
        redde "ok"
    }
    cape err {
        redde optimize.causa(err)
    }
}

# Renders a registration outcome as textus.
functio adscisco_detail(optimize.Sgd o, optimize.SgdStatum s) → textus {
    fac {
        fixum optimize.Sgd _ ← optimize.adscisco(o, s)
        redde "ok"
    }
    cape err {
        redde optimize.causa(err)
    }
}

# Renders a slot-wire deserialization outcome as textus.
functio deserializa_statum_detail(textus wire) → textus {
    fac {
        fixum optimize.SgdStatum _ ← optimize.deserializa_statum(wire)
        redde "ok"
    }
    cape err {
        redde optimize.causa(err)
    }
}

# Renders a whole-wire deserialization outcome as textus.
functio deserializa_detail(textus wire) → textus {
    fac {
        fixum optimize.Sgd _ ← optimize.deserializa(wire)
        redde "ok"
    }
    cape err {
        redde optimize.causa(err)
    }
}

# Slot checkpoint round-trip predicate: deserializa(serializa(x)) ≡ x.
functio roundtrip_statum(optimize.SgdStatum s) → bivalens {
    fac {
        fixum optimize.SgdStatum t ← optimize.deserializa_statum(optimize.serializa_statum(s))
        redde optimize.statum_aequus(s, t)
    }
    cape err {
        redde falsum
    }
}

# Whole-optimizer checkpoint round-trip predicate.
functio roundtrip_sgd(optimize.Sgd o) → bivalens {
    fac {
        fixum optimize.Sgd t ← optimize.deserializa(optimize.serializa(o))
        redde optimize.sgd_aequus(o, t)
    }
    cape err {
        redde falsum
    }
}

# ---- swallowing builders (the tene pattern) ----------------------------
# A fac/cape handler binds ONE error type. The step probes below must
# exercise exactly the optimizer error vocabulary in their handler, so
# every foreign construction (parameter, gradient) is wrapped in its own
# single-error-type helper. Test data is always valid; the cape fallback
# is unreachable.

functio para(textus nomen, textus possessor, lista<f32> datos, lista<numerus> forma) → parametrum.Parametrum {
    varia parametrum.Parametrum p
    fac {
        p ← parametrum.structa(nomen, possessor, "f32", forma, datos)
    }
    cape err {
        redde p
    }
    redde p
}

functio para_gelida(textus nomen, textus possessor, lista<f32> datos, lista<numerus> forma) → parametrum.Parametrum {
    varia parametrum.Parametrum p
    fac {
        p ← parametrum.structa_gelida(nomen, possessor, "f32", forma, datos)
    }
    cape err {
        redde p
    }
    redde p
}

functio muta_p(parametrum.Parametrum p, lista<f32> datos) → parametrum.Parametrum {
    varia parametrum.Parametrum q
    fac {
        q ← parametrum.muta(p, datos)
    }
    cape err {
        redde q
    }
    redde q
}

functio grad(textus nomen, textus possessor, numerus versio, tensor.Tensor valor) → gradient.Gradiente {
    varia gradient.Gradiente g
    fac {
        g ← gradient.structa(nomen, possessor, versio, valor)
    }
    cape err {
        redde g
    }
    redde g
}

functio inveni_grad(gradient.Gradientes b, textus possessor, textus nomen) → gradient.Gradiente {
    varia gradient.Gradiente g
    fac {
        g ← b.inveni(possessor, nomen)
    }
    cape err {
        redde g
    }
    redde g
}

functio statum(textus nomen, textus possessor, numerus generatio, f32 lentus) → optimize.SgdStatum {
    varia optimize.SgdStatum s
    fac {
        s ← optimize.structa(nomen, possessor, generatio, lentus)
    }
    cape err {
        redde s
    }
    redde s
}


# ---- oracle pins (f64 evaluations of the documented SGD update formula)

# param' = param − lr·grad for param = [1,2,3,4], grad = [0.25,0.5,0.75,1.0]
# (the U2 grad_w oracle pins), lr = 0.01 (the accepted MLP training proof):
#   [1−0.0025, 2−0.005, 3−0.0075, 4−0.01] = [0.9975, 1.995, 2.9925, 3.99]
# — f64 evaluations, exact. Pins for the auditor-owned runtime-evidence
# gate (compare the step output under numeric-policy v1.0.0; the 1e-4
# gradient row). No executed value is claimed here (CTO Q2).
fixum f32 SGD_ORACLE_0 ← (0.9975 ∷ f32)
fixum f32 SGD_ORACLE_1 ← (1.995 ∷ f32)
fixum f32 SGD_ORACLE_2 ← (2.9925 ∷ f32)
fixum f32 SGD_ORACLE_3 ← (3.99 ∷ f32)

# Conservative absolute tolerance for the f32 step surface vs the f64
# oracle pins (covers f32 self-hosting over these magnitudes; within the
# GPU lane's 1e-4 gradient row).
fixum f32 SGD_TOLERATIO ← (0.0001 ∷ f32)

# ---- per-parameter state slot construction

probandum "optimizer state — state slot construction" {
    proba "structa builds a fresh state slot with full identity, version, generation, count, lr" {
        fac {
            fixum optimize.SgdStatum s ← optimize.structa("weight", "model.mlp", 1, (0.01 ∷ f32))
            adfirma s.possessor() ≡ "model.mlp"
            adfirma s.nomen() ≡ "weight"
            adfirma s.versio() ≡ 1
            adfirma s.generatio() ≡ 1
            adfirma s.passus() ≡ 0
            adfirma s.lentus() ≡ (0.01 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "structa rejects an empty owner path" {
        adfirma structa_detail("", "weight", 1, (0.01 ∷ f32)) ≡ "empty state owner"
    }

    proba "structa rejects an empty parameter name" {
        adfirma structa_detail("model", "", 1, (0.01 ∷ f32)) ≡ "empty state name"
    }

    proba "structa rejects the reserved wire character '/' in identity" {
        adfirma structa_detail("a/b", "weight", 1, (0.01 ∷ f32)) ≡ "reserved wire character in name or owner"
    }

    proba "structa rejects the slot separator ';' in identity" {
        adfirma structa_detail("a;b", "weight", 1, (0.01 ∷ f32)) ≡ "reserved wire character in name or owner"
    }

    proba "structa rejects an invalid generation (parameter versio starts at 1)" {
        adfirma structa_detail("model", "weight", 0, (0.01 ∷ f32)) ≡ "invalid generation"
    }

    proba "structa rejects a negative learning rate" {
        adfirma structa_detail("model", "weight", 1, (0.0 - 0.01 ∷ f32)) ≡ "invalid learning rate"
    }

    proba "structa rejects a non-finite learning rate" {
        adfirma structa_detail("model", "weight", 1, (1.0 / 0.0 ∷ f32)) ≡ "invalid learning rate"
    }
}

# ---- the optimizer collection (per-parameter slots)

probandum "optimizer state — the Sgd collection" {
    proba "sgd_vacuum is empty" {
        fac {
            fixum optimize.Sgd o ← optimize.sgd_vacuum()
            adfirma o.numerus() ≡ 0
        }
        cape err {
            adfirma falsum
        }
    }

    proba "adscisco registers a slot; inveni resolves by (possessor, nomen)" {
        fac {
            fixum optimize.Sgd o ← optimize.sgd_vacuum()
            fixum optimize.SgdStatum s ← optimize.structa("w1", "model.mlp", 1, (0.01 ∷ f32))
            fixum optimize.Sgd o2 ← optimize.adscisco(o, s)
            adfirma o2.numerus() ≡ 1
            adfirma o2.contineo("model.mlp", "w1")
            fixum optimize.SgdStatum t ← o2.inveni("model.mlp", "w1")
            adfirma optimize.statum_aequus(s, t)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "adscisco rejects a duplicate (possessor, nomen) identity" {
        fac {
            fixum optimize.Sgd o ← optimize.sgd_vacuum()
            fixum optimize.SgdStatum s ← optimize.structa("w1", "model.mlp", 1, (0.01 ∷ f32))
            fixum optimize.Sgd o2 ← optimize.adscisco(o, s)
            adfirma adscisco_detail(o2, s) ≡ "optimizer state already registered for that parameter"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "inveni fails closed on an unknown identity" {
        fac {
            fixum optimize.Sgd o ← optimize.sgd_vacuum()
            fixum optimize.SgdStatum s ← optimize.structa("w1", "model.mlp", 1, (0.01 ∷ f32))
            fixum optimize.Sgd o2 ← optimize.adscisco(o, s)
            fac {
                fixum optimize.SgdStatum _ ← o2.inveni("model.mlp", "nope")
                adfirma falsum
            }
            cape err {
                adfirma optimize.causa(err) ≡ "no optimizer state for that parameter"
            }
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- the state mutation rule (passus — one explicit SGD step)

probandum "optimizer state — passus mutation rules" {
    proba "a fresh gradient steps the parameter: param' = param − lr·grad (versio/generatio/passus advance)" {
        fac {
            fixum parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0, 3.0, 4.0], [4])
            fixum gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5, 0.75, 1.0], [4]))
            fixum optimize.SgdStatum s ← statum("w1", "model", 1, (0.01 ∷ f32))
            fixum optimize.Passus r ← optimize.passus(s, p, g)
            # parameter.fab muta bumps the parameter versio 1 → 2.
            adfirma r.novus().versio() ≡ 2
            # state advances: versio +1, generatio = new param versio,
            # passus +1; identity and lr stable.
            adfirma r.statum().versio() ≡ 2
            adfirma r.statum().generatio() ≡ 2
            adfirma r.statum().passus() ≡ 1
            adfirma r.statum().possessor() ≡ "model"
            adfirma r.statum().nomen() ≡ "w1"
            adfirma r.statum().lentus() ≡ (0.01 ∷ f32)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the step values match the f64 oracle pins (param − lr·grad)" {
        fac {
            fixum parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0, 3.0, 4.0], [4])
            fixum gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5, 0.75, 1.0], [4]))
            fixum optimize.SgdStatum s ← statum("w1", "model", 1, (0.01 ∷ f32))
            fixum optimize.Passus r ← optimize.passus(s, p, g)
            adfirma e1(r.novus().valor(), 0).approximata(SGD_ORACLE_0, SGD_TOLERATIO)
            adfirma e1(r.novus().valor(), 1).approximata(SGD_ORACLE_1, SGD_TOLERATIO)
            adfirma e1(r.novus().valor(), 2).approximata(SGD_ORACLE_2, SGD_TOLERATIO)
            adfirma e1(r.novus().valor(), 3).approximata(SGD_ORACLE_3, SGD_TOLERATIO)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "sequential steps advance the state (passus 1 → 2, generation tracks the param versio)" {
        fac {
            fixum parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0], [2])
            fixum optimize.SgdStatum s ← statum("w1", "model", 1, (0.01 ∷ f32))
            fixum gradient.Gradiente g1 ← grad("w1", "model", 1, tene([0.25, 0.5], [2]))
            fixum optimize.Passus r1 ← optimize.passus(s, p, g1)
            fixum gradient.Gradiente g2 ← grad("w1", "model", 2, tene([0.5, 1.0], [2]))
            fixum optimize.Passus r2 ← optimize.passus(r1.statum(), r1.novus(), g2)
            adfirma r2.statum().passus() ≡ 2
            adfirma r2.statum().versio() ≡ 3
            adfirma r2.statum().generatio() ≡ 3
            adfirma r2.novus().versio() ≡ 3
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a stale gradient is rejected (U2 obsoletus — parameter mutated since the gradient was computed)" {
        fac {
            fixum parametrum.Parametrum p1 ← para("w1", "model", [1.0, 2.0], [2])
            # A gradient computed against versio 1...
            fixum gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5], [2]))
            # ...and the parameter mutated to versio 2 (parameter.fab muta).
            fixum parametrum.Parametrum p2 ← muta_p(p1, [1.5, 2.5])
            fixum optimize.SgdStatum s ← statum("w1", "model", 1, (0.01 ∷ f32))
            adfirma gradient.obsoletus(g, p2.versio())
            adfirma passus_detail(s, p2, g) ≡ "stale gradient: parameter mutated since the gradient was computed"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a gradient with a different identity is rejected" {
        fac {
            fixum parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0], [2])
            fixum gradient.Gradiente g ← grad("w2", "model", 1, tene([0.25, 0.5], [2]))
            fixum optimize.SgdStatum s ← statum("w1", "model", 1, (0.01 ∷ f32))
            adfirma passus_detail(s, p, g) ≡ "gradient identity does not match the parameter"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a state bound to a different parameter is rejected" {
        fac {
            fixum parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0], [2])
            fixum gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5], [2]))
            fixum optimize.SgdStatum s ← statum("w1", "other", 1, (0.01 ∷ f32))
            adfirma passus_detail(s, p, g) ≡ "state identity does not match the parameter"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a frozen parameter never steps" {
        fac {
            fixum parametrum.Parametrum p ← para_gelida("w1", "model", [1.0, 2.0], [2])
            fixum gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5], [2]))
            fixum optimize.SgdStatum s ← statum("w1", "model", 1, (0.01 ∷ f32))
            adfirma parametrum.est_gelida(p)
            adfirma passus_detail(s, p, g) ≡ "frozen parameter cannot be optimized"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "a gradient with a mismatched shape is rejected" {
        fac {
            fixum parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0, 3.0, 4.0], [2, 2])
            fixum gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5], [2]))
            fixum optimize.SgdStatum s ← statum("w1", "model", 1, (0.01 ∷ f32))
            adfirma passus_detail(s, p, g) ≡ "gradient shape does not match the parameter"
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- the U2 gradient-call contract composes

probandum "optimizer state — U2 bundle composition" {
    proba "a Gradientes bundle resolves by identity and its gradient steps the parameter" {
        fac {
            fixum parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0, 3.0, 4.0], [4])
            fixum gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5, 0.75, 1.0], [4]))
            fixum gradient.Gradientes b ← gradient.structa_gradientes([g])
            fixum gradient.Gradiente g2 ← inveni_grad(b, "model", "w1")
            fixum optimize.SgdStatum s ← statum("w1", "model", 1, (0.01 ∷ f32))
            fixum optimize.Passus r ← optimize.passus(s, p, g2)
            adfirma r.statum().passus() ≡ 1
            adfirma e1(r.novus().valor(), 0).approximata(SGD_ORACLE_0, SGD_TOLERATIO)
        }
        cape err {
            adfirma falsum
        }
    }
}

# ---- the versioned wire round-trip (checkpoint exactness)

probandum "optimizer state — serialization round-trip" {
    proba "a slot wire round-trips exactly (identity, version, generation, count, lr)" {
        fac {
            fixum optimize.SgdStatum s ← optimize.structa("weight", "model.mlp", 1, (0.01 ∷ f32))
            adfirma roundtrip_statum(s)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "an advanced slot (post-step) round-trips exactly" {
        fac {
            fixum parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0, 3.0, 4.0], [4])
            fixum gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5, 0.75, 1.0], [4]))
            fixum optimize.SgdStatum s ← statum("w1", "model", 1, (0.01 ∷ f32))
            fixum optimize.Passus r ← optimize.passus(s, p, g)
            adfirma roundtrip_statum(r.statum())
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the whole-optimizer wire round-trips exactly (all slots)" {
        fac {
            fixum optimize.Sgd o ← optimize.sgd_vacuum()
            fixum optimize.SgdStatum s1 ← optimize.structa("w1", "model", 1, (0.01 ∷ f32))
            fixum optimize.SgdStatum s2 ← optimize.structa("b1", "model", 1, (0.001 ∷ f32))
            fixum optimize.Sgd o2 ← optimize.adscisco(o, s1)
            fixum optimize.Sgd o3 ← optimize.adscisco(o2, s2)
            adfirma roundtrip_sgd(o3)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the empty optimizer wire round-trips exactly" {
        fac {
            fixum optimize.Sgd o ← optimize.sgd_vacuum()
            adfirma roundtrip_sgd(o)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the lr is part of the exact-state predicate (a changed lr is not equal)" {
        fac {
            fixum optimize.SgdStatum a ← optimize.structa("w1", "model", 1, (0.01 ∷ f32))
            fixum optimize.SgdStatum b ← optimize.structa("w1", "model", 1, (0.02 ∷ f32))
            adfirma non (optimize.statum_aequus(a, b))
        }
        cape err {
            adfirma falsum
        }
    }

    proba "deserialization rejects an unknown marker" {
        adfirma deserializa_statum_detail("tensor/sgd-state/1.0.0/model/w1/1/1/0/0.01") ≡ "unknown optimizer marker"
    }

    proba "deserialization rejects an unknown schema version" {
        adfirma deserializa_statum_detail("optimizer/sgd-state/9.9.9/model/w1/1/1/0/0.01") ≡ "unknown optimizer schema version"
    }

    proba "deserialization rejects a malformed wire" {
        adfirma deserializa_statum_detail("optimizer/sgd-state/1.0.0/model") ≡ "malformed sgd-state wire"
    }

    proba "deserialization rejects a malformed learning-rate token" {
        adfirma deserializa_statum_detail("optimizer/sgd-state/1.0.0/model/w1/1/1/0/not-a-float") ≡ "malformed learning rate in optimizer wire"
    }

    proba "deserialization rejects an invalid state version (below the PML1-U5 start)" {
        adfirma deserializa_statum_detail("optimizer/sgd-state/1.0.0/model/w1/0/1/0/0.01") ≡ "invalid state version"
    }

    proba "whole-wire deserialization rejects a slot-count mismatch" {
        adfirma deserializa_detail("optimizer/sgd/1.0.0/2;optimizer/sgd-state/1.0.0/model/w1/1/1/0/0.01") ≡ "slot count mismatch in optimizer wire"
    }
}
