+++
locale = "en"
+++
# Co-located package test for optimize.fab (PML4-U3 — optimizer state,
# SGD first). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * the per-parameter state slot: identity (possessor + nomen, PML1-U5)
#     + state version (mutation counter) + generation (parameter versio at
#     last apply, the U2 seam) + step count + learning rate; construction
#     is fail-closed (empty/reserved identity fields, invalid version /
#     generation / step count / learning rate — causa identity).
#   * the optimizer collection: uniqueness by identity, fail-closed
#     resolution (inveni), registration.
#   * the state mutation rules (passus — one explicit step): identity
#     match, gradient freshness (NOT gradient.obsoletus — the U2 generation
#     seam), trainable-only, gradient shape ≡ parameter shape; the update
#     param' = param − lentus·grad advances the state (versio +1, generatio
#     = new param versio, passus +1) and composes with parameter.fab muta
#     (the parameter versio bumps 1 → 2).
#   * the versioned wire round-trip: deserializa(serializa(x)) ≡ x by
#     statum_aequus / sgd_aequus — EXACT, including the learning rate;
#     unknown markers/schema versions and malformed fields fail closed.
#   * the U2 bundle composition: a Gradientes bundle resolves by identity
#     and its gradient steps a parameter.
#
# Oracle pins: f64 evaluations of the documented SGD update formula
# param' = param − lr·grad for the canonical data param = [1,2,3,4],
# grad = [0.25,0.5,0.75,1.0] (the U2 grad_w oracle pins), lr = 0.01 (the
# accepted MLP training proof's lr): [0.9975, 1.995, 2.9925, 3.99]. The
# auditor-owned runtime-evidence gate compares the step's output against
# these under the GPU lane's tolerance rows (numeric-policy v1.0.0 — the
# 1e-4 gradient row; the conservative 1e-4 absolute tolerance below covers
# f32 self-hosting over these magnitudes).
#
# EVIDENCE HONESTY (CTO Q2, hard): this suite is STRUCTURAL proof. No
# executed step value or checkpoint value is claimed here; the oracle pins
# are f64 evaluations of the documented formulas. Executed value-identity
# is env-blocked tree-wide today (FMIR stepper / library-import gap —
# recorded residual); PML4-U3 is PARTIAL and value-identity is deferred to
# the auditor-owned runtime-evidence gate.
#
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/optimize.proba` proves the suite
# type-checks. Execution of proba bodies is env-blocked tree-wide today
# (recorded residual); this suite is the compile-level proof of the
# contract.

import from "gradus:optimize" optimize

import from "gradus:parameter" parametrum

import from "gradus:gradient" gradient

import from "gradus:tensor" tensor

# ---- helpers (the loss.proba / gradient.proba pattern)

# Build a staged tensor, swallowing the never-firing construction errors.
fn tene(list<f32> datos, list<int> forma) → tensor.Tensor {
    var tensor.Tensor t
    do {
        t ← tensor.structa(datos, forma)
    }
    catch err {
        return t
    }
    return t
}

# Staged-result element read (swallow the never-firing access errors).
fn e1(tensor.Tensor t, int i) → f32 {
    do {
        return t.accipe([i])
    }
    catch err {
        return 0.0 - 999.0 ∷ f32
    }
}

# Renders a state-construction outcome as textus: "ok" on success, the
# typed error's causa on rejection.
fn structa_detail(string possessor, string nomen, int generatio, f32 lentus) → string {
    do {
        optimize.structa(possessor, nomen, generatio, lentus)
        return "ok"
    }
    catch err {
        return optimize.causa(err)
    }
}

# Renders a step outcome as textus: "ok" on success, the typed error's
# causa on rejection.
fn passus_detail(optimize.SgdStatum s, parametrum.Parametrum p, gradient.Gradiente g) → string {
    do {
        optimize.passus(s, p, g)
        return "ok"
    }
    catch err {
        return optimize.causa(err)
    }
}

# Renders a registration outcome as textus.
fn adscisco_detail(optimize.Sgd o, optimize.SgdStatum s) → string {
    do {
        optimize.adscisco(o, s)
        return "ok"
    }
    catch err {
        return optimize.causa(err)
    }
}

# Renders a slot-wire deserialization outcome as textus.
fn deserializa_statum_detail(string wire) → string {
    do {
        optimize.deserializa_statum(wire)
        return "ok"
    }
    catch err {
        return optimize.causa(err)
    }
}

# Renders a whole-wire deserialization outcome as textus.
fn deserializa_detail(string wire) → string {
    do {
        optimize.deserializa(wire)
        return "ok"
    }
    catch err {
        return optimize.causa(err)
    }
}

# Slot checkpoint round-trip predicate: deserializa(serializa(x)) ≡ x.
fn roundtrip_statum(optimize.SgdStatum s) → bool {
    do {
        const optimize.SgdStatum t ← optimize.deserializa_statum(optimize.serializa_statum(s))
        return optimize.statum_aequus(s, t)
    }
    catch err {
        return false
    }
}

# Whole-optimizer checkpoint round-trip predicate.
fn roundtrip_sgd(optimize.Sgd o) → bool {
    do {
        const optimize.Sgd t ← optimize.deserializa(optimize.serializa(o))
        return optimize.sgd_aequus(o, t)
    }
    catch err {
        return false
    }
}

# ---- swallowing builders (the tene pattern) ----------------------------
# A fac/cape handler binds ONE error type. The step probes below must
# exercise exactly the optimizer error vocabulary in their handler, so
# every foreign construction (parameter, gradient) is wrapped in its own
# single-error-type helper. Test data is always valid; the cape fallback
# is unreachable.

fn para(string nomen, string possessor, list<f32> datos, list<int> forma) → parametrum.Parametrum {
    var parametrum.Parametrum p
    do {
        p ← parametrum.structa(nomen, possessor, "f32", forma, datos)
    }
    catch err {
        return p
    }
    return p
}

fn para_gelida(string nomen, string possessor, list<f32> datos, list<int> forma) → parametrum.Parametrum {
    var parametrum.Parametrum p
    do {
        p ← parametrum.structa_gelida(nomen, possessor, "f32", forma, datos)
    }
    catch err {
        return p
    }
    return p
}

fn muta_p(parametrum.Parametrum p, list<f32> datos) → parametrum.Parametrum {
    var parametrum.Parametrum q
    do {
        q ← parametrum.muta(p, datos)
    }
    catch err {
        return q
    }
    return q
}

fn grad(string nomen, string possessor, int versio, tensor.Tensor valor) → gradient.Gradiente {
    var gradient.Gradiente g
    do {
        g ← gradient.structa(nomen, possessor, versio, valor)
    }
    catch err {
        return g
    }
    return g
}

fn inveni_grad(gradient.Gradientes b, string possessor, string nomen) → gradient.Gradiente {
    var gradient.Gradiente g
    do {
        g ← b.inveni(possessor, nomen)
    }
    catch err {
        return g
    }
    return g
}

fn statum(string nomen, string possessor, int generatio, f32 lentus) → optimize.SgdStatum {
    var optimize.SgdStatum s
    do {
        s ← optimize.structa(nomen, possessor, generatio, lentus)
    }
    catch err {
        return s
    }
    return s
}


# ---- oracle pins (f64 evaluations of the documented SGD update formula)

# param' = param − lr·grad for param = [1,2,3,4], grad = [0.25,0.5,0.75,1.0]
# (the U2 grad_w oracle pins), lr = 0.01 (the accepted MLP training proof):
#   [1−0.0025, 2−0.005, 3−0.0075, 4−0.01] = [0.9975, 1.995, 2.9925, 3.99]
# — f64 evaluations, exact. Pins for the auditor-owned runtime-evidence
# gate (compare the step output under numeric-policy v1.0.0; the 1e-4
# gradient row). No executed value is claimed here (CTO Q2).
const f32 SGD_ORACLE_0 ← 0.9975 ∷ f32

const f32 SGD_ORACLE_1 ← 1.995 ∷ f32

const f32 SGD_ORACLE_2 ← 2.9925 ∷ f32

const f32 SGD_ORACLE_3 ← 3.99 ∷ f32

# Conservative absolute tolerance for the f32 step surface vs the f64
# oracle pins (covers f32 self-hosting over these magnitudes; within the
# GPU lane's 1e-4 gradient row).
const f32 SGD_TOLERATIO ← 0.0001 ∷ f32

# ---- per-parameter state slot construction

test "structa builds a fresh state slot with full identity, version, generation, count, lr" {
    do {
        const optimize.SgdStatum s ← optimize.structa("weight", "model.mlp", 1, 0.01 ∷ f32)
        assert s.possessor() ≡ "model.mlp"
        assert s.nomen() ≡ "weight"
        assert s.versio() ≡ 1
        assert s.generatio() ≡ 1
        assert s.passus() ≡ 0
        assert s.lentus() ≡ 0.01 ∷ f32
    }
    catch err {
        assert false
    }
}

test "structa rejects an empty owner path" {
    assert structa_detail("", "weight", 1, 0.01 ∷ f32) ≡ "empty state owner"
}

test "structa rejects an empty parameter name" {
    assert structa_detail("model", "", 1, 0.01 ∷ f32) ≡ "empty state name"
}

test "structa rejects the reserved wire character '/' in identity" {
    assert structa_detail("a/b", "weight", 1, 0.01 ∷ f32) ≡ "reserved wire character in name or owner"
}

test "structa rejects the slot separator ';' in identity" {
    assert structa_detail("a;b", "weight", 1, 0.01 ∷ f32) ≡ "reserved wire character in name or owner"
}

test "structa rejects an invalid generation (parameter versio starts at 1)" {
    assert structa_detail("model", "weight", 0, 0.01 ∷ f32) ≡ "invalid generation"
}

test "structa rejects a negative learning rate" {
    assert structa_detail("model", "weight", 1, 0.0 - 0.01 ∷ f32) ≡ "invalid learning rate"
}

test "structa rejects a non-finite learning rate" {
    assert structa_detail("model", "weight", 1, 1.0 / 0.0 ∷ f32) ≡ "invalid learning rate"
}

# ---- the optimizer collection (per-parameter slots)

test "sgd_vacuum is empty" {
    do {
        const optimize.Sgd o ← optimize.sgd_vacuum()
        assert o.numerus() ≡ 0
    }
    catch err {
        assert false
    }
}

test "adscisco registers a slot; inveni resolves by (possessor, nomen)" {
    do {
        const optimize.Sgd o ← optimize.sgd_vacuum()
        const optimize.SgdStatum s ← optimize.structa("w1", "model.mlp", 1, 0.01 ∷ f32)
        const optimize.Sgd o2 ← optimize.adscisco(o, s)
        assert o2.numerus() ≡ 1
        assert o2.contineo("model.mlp", "w1")
        const optimize.SgdStatum t ← o2.inveni("model.mlp", "w1")
        assert optimize.statum_aequus(s, t)
    }
    catch err {
        assert false
    }
}

test "adscisco rejects a duplicate (possessor, nomen) identity" {
    do {
        const optimize.Sgd o ← optimize.sgd_vacuum()
        const optimize.SgdStatum s ← optimize.structa("w1", "model.mlp", 1, 0.01 ∷ f32)
        const optimize.Sgd o2 ← optimize.adscisco(o, s)
        assert adscisco_detail(o2, s) ≡ "optimizer state already registered for that parameter"
    }
    catch err {
        assert false
    }
}

test "inveni fails closed on an unknown identity" {
    do {
        const optimize.Sgd o ← optimize.sgd_vacuum()
        const optimize.SgdStatum s ← optimize.structa("w1", "model.mlp", 1, 0.01 ∷ f32)
        const optimize.Sgd o2 ← optimize.adscisco(o, s)
        do {
            o2.inveni("model.mlp", "nope")
            assert false
        }
        catch err {
            assert optimize.causa(err) ≡ "no optimizer state for that parameter"
        }
    }
    catch err {
        assert false
    }
}

# ---- the state mutation rule (passus — one explicit SGD step)

test "a fresh gradient steps the parameter: param' = param − lr·grad (versio/generatio/passus advance)" {
    do {
        const parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0, 3.0, 4.0], [4])
        const gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5, 0.75, 1.0], [4]))
        const optimize.SgdStatum s ← statum("w1", "model", 1, 0.01 ∷ f32)
        const optimize.Passus r ← optimize.passus(s, p, g)
        # parameter.fab muta bumps the parameter versio 1 → 2.
        assert r.novus().versio() ≡ 2
        # state advances: versio +1, generatio = new param versio,
        # passus +1; identity and lr stable.
        assert r.statum().versio() ≡ 2
        assert r.statum().generatio() ≡ 2
        assert r.statum().passus() ≡ 1
        assert r.statum().possessor() ≡ "model"
        assert r.statum().nomen() ≡ "w1"
        assert r.statum().lentus() ≡ 0.01 ∷ f32
    }
    catch err {
        assert false
    }
}

test "the step values match the f64 oracle pins (param − lr·grad)" {
    do {
        const parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0, 3.0, 4.0], [4])
        const gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5, 0.75, 1.0], [4]))
        const optimize.SgdStatum s ← statum("w1", "model", 1, 0.01 ∷ f32)
        const optimize.Passus r ← optimize.passus(s, p, g)
        assert e1(r.novus().valor(), 0).approx(SGD_ORACLE_0, SGD_TOLERATIO)
        assert e1(r.novus().valor(), 1).approx(SGD_ORACLE_1, SGD_TOLERATIO)
        assert e1(r.novus().valor(), 2).approx(SGD_ORACLE_2, SGD_TOLERATIO)
        assert e1(r.novus().valor(), 3).approx(SGD_ORACLE_3, SGD_TOLERATIO)
    }
    catch err {
        assert false
    }
}

test "sequential steps advance the state (passus 1 → 2, generation tracks the param versio)" {
    do {
        const parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0], [2])
        const optimize.SgdStatum s ← statum("w1", "model", 1, 0.01 ∷ f32)
        const gradient.Gradiente g1 ← grad("w1", "model", 1, tene([0.25, 0.5], [2]))
        const optimize.Passus r1 ← optimize.passus(s, p, g1)
        const gradient.Gradiente g2 ← grad("w1", "model", 2, tene([0.5, 1.0], [2]))
        const optimize.Passus r2 ← optimize.passus(r1.statum(), r1.novus(), g2)
        assert r2.statum().passus() ≡ 2
        assert r2.statum().versio() ≡ 3
        assert r2.statum().generatio() ≡ 3
        assert r2.novus().versio() ≡ 3
    }
    catch err {
        assert false
    }
}

test "a stale gradient is rejected (U2 obsoletus — parameter mutated since the gradient was computed)" {
    do {
        const parametrum.Parametrum p1 ← para("w1", "model", [1.0, 2.0], [2])
        # A gradient computed against versio 1...
        const gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5], [2]))
        # ...and the parameter mutated to versio 2 (parameter.fab muta).
        const parametrum.Parametrum p2 ← muta_p(p1, [1.5, 2.5])
        const optimize.SgdStatum s ← statum("w1", "model", 1, 0.01 ∷ f32)
        assert gradient.obsoletus(g, p2.versio())
        assert passus_detail(s, p2, g) ≡ "stale gradient: parameter mutated since the gradient was computed"
    }
    catch err {
        assert false
    }
}

test "a gradient with a different identity is rejected" {
    do {
        const parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0], [2])
        const gradient.Gradiente g ← grad("w2", "model", 1, tene([0.25, 0.5], [2]))
        const optimize.SgdStatum s ← statum("w1", "model", 1, 0.01 ∷ f32)
        assert passus_detail(s, p, g) ≡ "gradient identity does not match the parameter"
    }
    catch err {
        assert false
    }
}

test "a state bound to a different parameter is rejected" {
    do {
        const parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0], [2])
        const gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5], [2]))
        const optimize.SgdStatum s ← statum("w1", "other", 1, 0.01 ∷ f32)
        assert passus_detail(s, p, g) ≡ "state identity does not match the parameter"
    }
    catch err {
        assert false
    }
}

test "a frozen parameter never steps" {
    do {
        const parametrum.Parametrum p ← para_gelida("w1", "model", [1.0, 2.0], [2])
        const gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5], [2]))
        const optimize.SgdStatum s ← statum("w1", "model", 1, 0.01 ∷ f32)
        assert parametrum.est_gelida(p)
        assert passus_detail(s, p, g) ≡ "frozen parameter cannot be optimized"
    }
    catch err {
        assert false
    }
}

test "a gradient with a mismatched shape is rejected" {
    do {
        const parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0, 3.0, 4.0], [2, 2])
        const gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5], [2]))
        const optimize.SgdStatum s ← statum("w1", "model", 1, 0.01 ∷ f32)
        assert passus_detail(s, p, g) ≡ "gradient shape does not match the parameter"
    }
    catch err {
        assert false
    }
}

# ---- the U2 gradient-call contract composes

test "a Gradientes bundle resolves by identity and its gradient steps the parameter" {
    do {
        const parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0, 3.0, 4.0], [4])
        const gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5, 0.75, 1.0], [4]))
        const gradient.Gradientes b ← gradient.structa_gradientes([g])
        const gradient.Gradiente g2 ← inveni_grad(b, "model", "w1")
        const optimize.SgdStatum s ← statum("w1", "model", 1, 0.01 ∷ f32)
        const optimize.Passus r ← optimize.passus(s, p, g2)
        assert r.statum().passus() ≡ 1
        assert e1(r.novus().valor(), 0).approx(SGD_ORACLE_0, SGD_TOLERATIO)
    }
    catch err {
        assert false
    }
}

# ---- the versioned wire round-trip (checkpoint exactness)

test "a slot wire round-trips exactly (identity, version, generation, count, lr)" {
    do {
        const optimize.SgdStatum s ← optimize.structa("weight", "model.mlp", 1, 0.01 ∷ f32)
        assert roundtrip_statum(s)
    }
    catch err {
        assert false
    }
}

test "an advanced slot (post-step) round-trips exactly" {
    do {
        const parametrum.Parametrum p ← para("w1", "model", [1.0, 2.0, 3.0, 4.0], [4])
        const gradient.Gradiente g ← grad("w1", "model", 1, tene([0.25, 0.5, 0.75, 1.0], [4]))
        const optimize.SgdStatum s ← statum("w1", "model", 1, 0.01 ∷ f32)
        const optimize.Passus r ← optimize.passus(s, p, g)
        assert roundtrip_statum(r.statum())
    }
    catch err {
        assert false
    }
}

test "the whole-optimizer wire round-trips exactly (all slots)" {
    do {
        const optimize.Sgd o ← optimize.sgd_vacuum()
        const optimize.SgdStatum s1 ← optimize.structa("w1", "model", 1, 0.01 ∷ f32)
        const optimize.SgdStatum s2 ← optimize.structa("b1", "model", 1, 0.001 ∷ f32)
        const optimize.Sgd o2 ← optimize.adscisco(o, s1)
        const optimize.Sgd o3 ← optimize.adscisco(o2, s2)
        assert roundtrip_sgd(o3)
    }
    catch err {
        assert false
    }
}

test "the empty optimizer wire round-trips exactly" {
    do {
        const optimize.Sgd o ← optimize.sgd_vacuum()
        assert roundtrip_sgd(o)
    }
    catch err {
        assert false
    }
}

test "the lr is part of the exact-state predicate (a changed lr is not equal)" {
    do {
        const optimize.SgdStatum a ← optimize.structa("w1", "model", 1, 0.01 ∷ f32)
        const optimize.SgdStatum b ← optimize.structa("w1", "model", 1, 0.02 ∷ f32)
        assert not optimize.statum_aequus(a, b)
    }
    catch err {
        assert false
    }
}

test "deserialization rejects an unknown marker" {
    assert deserializa_statum_detail("tensor/sgd-state/1.0.0/model/w1/1/1/0/0.01") ≡ "unknown optimizer marker"
}

test "deserialization rejects an unknown schema version" {
    assert deserializa_statum_detail("optimizer/sgd-state/9.9.9/model/w1/1/1/0/0.01") ≡ "unknown optimizer schema version"
}

test "deserialization rejects a malformed wire" {
    assert deserializa_statum_detail("optimizer/sgd-state/1.0.0/model") ≡ "malformed sgd-state wire"
}

test "deserialization rejects a malformed learning-rate token" {
    assert deserializa_statum_detail("optimizer/sgd-state/1.0.0/model/w1/1/1/0/not-a-float") ≡ "malformed learning rate in optimizer wire"
}

test "deserialization rejects an invalid state version (below the PML1-U5 start)" {
    assert deserializa_statum_detail("optimizer/sgd-state/1.0.0/model/w1/0/1/0/0.01") ≡ "invalid state version"
}

test "whole-wire deserialization rejects a slot-count mismatch" {
    assert deserializa_detail("optimizer/sgd/1.0.0/2;optimizer/sgd-state/1.0.0/model/w1/1/1/0/0.01") ≡ "slot count mismatch in optimizer wire"
}
