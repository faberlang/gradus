# Byte-level BPE runtime — table construction, merge, encode, decode.
#
# Public import: import from "gradus:tokenizer/bpe" bpe
# Depends on: gradus:tokenizer/identity, gradus:tokenizer/unicode,
#   gradus:model/gguf_manifest.

import from "gradus:tokenizer/identity" identity
import from "gradus:tokenizer/unicode" unicode
import from "gradus:model/gguf_manifest" gguf_manifest


# Byte-level BPE capability contract. The runtime only implements the gpt2
# byte-to-unicode convention, so the manifest's declared tokenizer model must
# be the byte-level family. Independent of the identity contract's pinned
# SmolLM2 kind constant (clean break posture).
const string TOKENIZER_CAPABLE = "gpt2"

# GEA3 is an intentionally specialized SmolLM census admission. These
# constants belong to this admission seam; generic TokenizerIdentity does not
# export or require them.
const string GEA3_PRE_TOKENIZER = "smollm"
const int GEA3_VOCAB = 49152
const int GEA3_MERGES = 48900

# llama.cpp llama_token_type NORMAL — the special-cache boundary: every
# vocab entry whose token_type is not NORMAL is special (the
# llama_vocab::init_special rule; U3-4).
const int KIND_NORMAL = 1

# GGUF metadata wire type for tokenizer.ggml.add_bos_token (bool) — mirrors
# the manifest module's private GGUF_BOOL constant (7).
const int KIND_BOOL = 7

# EOG text names (llama-vocab.cpp llm_load_vocab, pinned oracle 10150
# `dee2a846b`): every vocab token whose text is one of these names is an
# end-of-generation token (U3-5). The final name is the DeepSeek-OCR form
# with fullwidth bars and U+2581 lower-one-eighth-block separators.
const list<string> EOG_NAMES = ["<|eot_id|>", "<|im_end|>", "<|end|>", "<|return|>", "<|call|>", "<|flush|>", "<|calls|>", "<end_of_turn>", "<|endoftext|>", "</s>", "<|eom_id|>", "<EOT>", "_<EOT>", "[EOT]", "[EOS]", "<|end_of_text|>", "<end_of_utterance>", "<eos>", "<turn|>", "<|tool_response>", "<｜end▁of▁sentence｜>", "[e~["]

# FIM token text-name fallbacks — llama.cpp only falls back to these when
# the tokenizer.ggml.fim_*_token_id metadata keys are absent.
const list<string> FIM_PAD_NAMES = ["<|fim_pad|>", "<fim-pad>", "<fim_pad>", "<PAD>", "[PAD]"]

const list<string> FIM_REP_NAMES = ["<|fim_repo|>", "<|repo_name|>", "<fim-repo>", "<REPO>", "<reponame>"]

const list<string> FIM_SEP_NAMES = ["<|file_sep|>"]

# The FIM slots in order (pad, rep, sep): metadata key and its text-name fallbacks.
const list<string> FIM_KEYS = ["tokenizer.ggml.fim_pad_token_id", "tokenizer.ggml.fim_rep_token_id", "tokenizer.ggml.fim_sep_token_id"]

const list<list<string>> FIM_NAMES = [FIM_PAD_NAMES, FIM_REP_NAMES, FIM_SEP_NAMES]

# The artifact-backed runtime record. `words` is the vocab array indexed
# by token id (decode path); `vocab` is the display-token → id map and
# `concursus` the "left right" merge-pair → rank map (encode path).
# `special_texts`/`specialia_ids` are the artifact special-token cache
# (parallel lists; every non-NORMAL token_type entry, U3-4) that drives the
# parse-special on/off policy. `eog` is the artifact EOG stop set and
# `add_bos` the artifact's add_bos_token flag (U3-5). `chat_template` is
# the artifact's tokenizer.chat_template string (U3-6; absent → empty —
# no hard-coded fallback).


@ public
class Tokenizer {
    mut list<string> words
    mut map<string, int> vocab
    mut map<string, int> concursus
    mut list<string> special_texts
    mut list<int> specialia_ids
    mut list<int> eog
    mut bool add_bos
    mut string chat_template
    mut int multitudo
}

# One special-token occurrence found in a prompt: where it starts, how many
# characters it spans and its token id.
class SpecialHit {
    let int at
    let int length
    let int id
}

# --- Manifest reads and merge-table construction ---------------------------

fn artifact_text(gguf_manifest.GgufManifest m, string key) → string ⇥ identity.TokenizerError {
    do {
        return gguf_manifest.text(m, key)
    }
    catch err {
        throw variant identity.TokenizerError.BadArtifact { message = "tokenizer metadata is unavailable: §"(err.message) }
    }
}

fn artifact_texts(gguf_manifest.GgufManifest m, string key) → list<string> ⇥ identity.TokenizerError {
    do {
        return gguf_manifest.texts(m, key)
    }
    catch err {
        throw variant identity.TokenizerError.BadArtifact { message = "tokenizer array is unavailable: §"(err.message) }
    }
}

# tokenizer.ggml.token_type is OPTIONAL in GGUF: llama.cpp defaults absent
# types to NORMAL (→ an empty special cache). A PRESENT but malformed
# token_type fails closed.
fn artifact_optional_types(gguf_manifest.GgufManifest m) → list<int> ⇥ identity.TokenizerError {
    if not gguf_manifest.has_key(m, "tokenizer.ggml.token_type") then return empty
    do {
        return gguf_manifest.numbers(m, "tokenizer.ggml.token_type")
    }
    catch err {
        throw variant identity.TokenizerError.BadArtifact { message = "tokenizer token_type is malformed: §"(err.message) }
    }
}

# An OPTIONAL integer metadata key: none when the artifact does not declare
# it, a typed failure when it is declared but malformed. `what` names the
# metadata block in the failure.
fn artifact_optional_number(gguf_manifest.GgufManifest m, string key, string what) → int ∪ none ⇥ identity.TokenizerError {
    if not gguf_manifest.has_key(m, key) then return null
    do {
        return gguf_manifest.number(m, key)
    }
    catch err {
        throw variant identity.TokenizerError.BadArtifact { message = "§ is malformed: §"(what, err.message) }
    }
}

# A declared metadata entry; a failure to read it is a malformed artifact.
fn artifact_metadata(gguf_manifest.GgufManifest m, string key, string what) → gguf_manifest.GgufMetadata ⇥ identity.TokenizerError {
    do {
        return gguf_manifest.metadata(m, key)
    }
    catch err {
        throw variant identity.TokenizerError.BadArtifact { message = "§ is malformed: §"(what, err.message) }
    }
}

# Merge-entry well-formedness: exactly "left right" with a single space
# separator and non-empty halves (llama.cpp's find_bpe_rank asserts the same
# no-space-in-token invariant).
fn pair_ok(string par) → bool {
    let list<string> partes ← par.split(" ")
    return partes.length() ≡ 2 and partes[0].length() ≻ 0 and partes[1].length() ≻ 0
}

# The "left right" → rank map of a merge list (a merge's rank is its position).
fn merge_ranks(list<string> merges) → map<string, int> ⇥ identity.TokenizerError {
    mut map<string, int> ranks ← empty
    for from merges at [rank] let par {
        require pair_ok(par) throw variant identity.TokenizerError.BadMerges { message = "malformed merge entry: §"(par) }
        ranks.put(par, rank)
    }
    return ranks
}

# --- BPE merge loop (llama.cpp one-at-a-time semantics) --------------------

# The position of the adjacent pair with the lowest merge rank (the leftmost
# among equal ranks), or none when no adjacent pair is in the merge table.
fn best_pair(map<string, int> concursus, list<string> cur) → int ∪ none {
    let int n ← cur.length()
    if n ≺ 2 then return null
    mut list<int> positions ← empty
    mut list<int> ranks ← empty
    for from cur[0 ‥ n - 1], cur[1 ‥ n] at [i] let l, r {
        let int ∪ none rank ← concursus.get("§ §"(l, r))
        if rank ≢ null {
            positions.append(i)
            ranks.append(rank)
        }
    }
    let int ∪ none best ← ranks.argmin()
    if best ≡ null then return null
    return positions[best]
}

# Repeatedly merge the adjacent pair with the lowest merge rank (ties broken
# by the leftmost position), one occurrence per step, until no pair merges.
# Matches the pinned reference's priority-queue behavior; a fresh scan each
# step makes stale entries impossible. The loop ends when the symbols stop
# merging, which only the symbols themselves decide.
fn bpe_merge(map<string, int> concursus, list<string> symbola) → list<string> {
    mut list<string> cur ← copy symbola
    while true {
        let int ∪ none at ← best_pair(concursus, cur)
        if at ≡ null then break
        mut list<string> next ← cur[0 ‥ at]
        next.append("§§"(cur[at], cur[at + 1]))
        next.extend(cur[at + 2 ‥ cur.length()])
        cur ← next
    }
    return cur
}

# --- Runtime construction, encode, decode -----------------------------------

# Build the runtime from a parsed manifest. The vocab and merge arrays come
# from the artifact; the declared model must be the byte-level BPE family.
@ public
fn build(gguf_manifest.GgufManifest m) → Tokenizer ⇥ identity.TokenizerError {
    let string merge_kind ← artifact_text(m, "tokenizer.ggml.model")
    require merge_kind ≡ TOKENIZER_CAPABLE throw variant identity.TokenizerError.UnknownMergeKind { message = "tokenizer runtime is byte-level BPE; manifest declares: §"(merge_kind) }
    let list<string> words ← artifact_texts(m, "tokenizer.ggml.tokens")
    require words.length() ≢ 0 throw variant identity.TokenizerError.BadArtifact { message = "tokenizer vocabulary is empty" }
    let list<string> merges ← artifact_texts(m, "tokenizer.ggml.merges")
    mut map<string, int> vocab ← empty
    for from words at [id] let word {
        vocab.put(word, id)
    }
    let map<string, int> concursus ← merge_ranks(merges)
    # Special-token cache (U3-4): every vocab entry whose token_type is not
    # NORMAL is special (llama.cpp llama_vocab::init_special); absent
    # token_type means no specials (the reference defaults to NORMAL).
    let list<int> kinds ← artifact_optional_types(m)
    reject kinds.length() ≻ 0 and kinds.length() ≢ words.length() throw variant identity.TokenizerError.BadArtifact { message = "tokenizer token_type length does not match the vocabulary" }
    mut list<string> special_texts ← empty
    mut list<int> specialia_ids ← empty
    if kinds.length() ≻ 0 {
        for from words, kinds at [id] let word, kind {
            if kind ≢ KIND_NORMAL {
                special_texts.append(word)
                specialia_ids.append(id)
            }
        }
    }
    # EOG stop set + BOS policy (U3-5), derived from the artifact exactly
    # like llama.cpp llm_load_vocab: the declared eos id, the reference EOG
    # text names, and the FIM pad/rep/sep ids (metadata first, else the
    # text-name fallback); add_bos reads tokenizer.ggml.add_bos_token.
    # The chat template (U3-6) reads tokenizer.chat_template (absent →
    # empty, the no-template state).
    let list<int> eog ← manifest_eog(m, words)
    let bool add_bos ← artifact_add_bos(m)
    let string chat_template ← artifact_chat_template(m)
    return Tokenizer { words = words, vocab = vocab, concursus = concursus, special_texts = special_texts, specialia_ids = specialia_ids, eog = eog, add_bos = add_bos, chat_template = chat_template, multitudo = words.length() }
}

# Sparse table constructor — the provider builds a runtime over the model's
# vocab/merge arrays without wrapping them in a GGUF corpus. `ids`/`tokens`
# are parallel (token `tokens[i]` lives at id `ids[i]`); `special_ids` are
# the parse-special cache (must appear in `ids`). An id the table does not
# map holds empty text. Unmapped bytes fail closed at encode time
# (UnknownTrace).
@ public
fn build_tables(list<int> ids, list<string> tokens, list<string> merges, list<int> special_ids) → Tokenizer ⇥ identity.TokenizerError {
    require ids.length() ≡ tokens.length() throw variant identity.TokenizerError.BadArtifact { message = "tokenizer table ids and tokens are different lengths" }
    require ids.length() ≢ 0 throw variant identity.TokenizerError.BadArtifact { message = "tokenizer vocabulary is empty" }
    mut map<int, string> per_id ← empty
    mut map<string, int> vocab ← empty
    mut int max_id ← 0
    for from ids, tokens let id, token {
        require id ≥ 0 throw variant identity.TokenizerError.BadArtifact { message = "tokenizer table id is negative" }
        per_id.put(id, token)
        vocab.put(token, id)
        if id ≻ max_id then max_id ← id
    }
    mut list<string> words ← empty
    for range 0 … max_id let id {
        words.append(per_id.get(id) coalesce "")
    }
    let map<string, int> concursus ← merge_ranks(merges)
    mut list<string> special_texts ← empty
    mut list<int> specialia_ids ← empty
    for from special_ids let sid {
        reject sid ≺ 0 or sid ≻ max_id throw variant identity.TokenizerError.BadArtifact { message = "special token id is outside the table: §"(sid) }
        let string txt ← words[sid]
        require txt.length() ≢ 0 throw variant identity.TokenizerError.BadArtifact { message = "special token id has no table entry: §"(sid) }
        special_texts.append(txt)
        specialia_ids.append(sid)
    }
    mut list<int> eog_cand ← empty
    for from tokens, ids let token, id {
        if token ∈ EOG_NAMES then eog_cand.append(id)
    }
    return Tokenizer { words = words, vocab = vocab, concursus = concursus, special_texts = special_texts, specialia_ids = specialia_ids, eog = sorted_unique(eog_cand), add_bos = false, chat_template = "", multitudo = words.length() }
}

# -------------------------------------------------------------------------
# GEA3-U2 — census-bound tokenizer table admission (GEA3 full-model route).
#
# The vocab/merge tables admit from the pinned GGUF through the EXISTING
# typed artifact accessors (the same `texts`/`numbers` seams `build` reads)
# with the frozen GEA3 census rows checked against the local specialized
# constants: kind gpt2, pre-tokenizer smollm, 49,152 tokens, 48,900 merges,
# 49,152 token_type rows, BOS-free, and the artifact EOG set {0, 2, 4}
# (eos 2 + <|endoftext|> 0 + <|im_end|> 2 + <|fim_pad|> 4, ascending — the
# U1 manifest census `eog_set`). Any drift fails closed before runtime
# construction; `build` stays the unconstrained artifact constructor.
# -------------------------------------------------------------------------

# The frozen GEA3 artifact EOG census row.
const list<int> GEA3_EOG = [0, 2, 4]

@ public
fn admit_gea3_tables(gguf_manifest.GgufManifest m) → Tokenizer ⇥ identity.TokenizerError {
    let string kind ← artifact_text(m, "tokenizer.ggml.model")
    require kind ≡ TOKENIZER_CAPABLE throw variant identity.TokenizerError.UnknownMergeKind { message = "GEA3 tokenizer table kind does not match the pinned census row: §"(kind) }
    let string pre ← artifact_text(m, "tokenizer.ggml.pre")
    require pre ≡ GEA3_PRE_TOKENIZER throw variant identity.TokenizerError.UnknownPreTokenizer { message = "GEA3 tokenizer pre-tokenizer does not match the pinned census row: §"(pre) }
    let list<string> tokens ← artifact_texts(m, "tokenizer.ggml.tokens")
    require tokens.length() ≡ GEA3_VOCAB throw variant identity.TokenizerError.BadVocab { message = "GEA3 tokenizer vocabulary count does not match the pinned census row" }
    let list<string> merges ← artifact_texts(m, "tokenizer.ggml.merges")
    require merges.length() ≡ GEA3_MERGES throw variant identity.TokenizerError.BadVocab { message = "GEA3 tokenizer merge count does not match the pinned census row" }
    let list<int> kinds ← artifact_optional_types(m)
    require kinds.length() ≡ GEA3_VOCAB throw variant identity.TokenizerError.BadVocab { message = "GEA3 tokenizer token_type count does not match the pinned census row" }
    let Tokenizer t ← build(m)
    reject add_bos(t) throw variant identity.TokenizerError.BadArtifact { message = "GEA3 pinned tokenizer is BOS-free; add_bos_token drifted" }
    require artifact_eog(t) ≡ GEA3_EOG throw variant identity.TokenizerError.BadArtifact { message = "GEA3 artifact EOG set does not match the pinned census row" }
    return t
}

# Word-level encode: UTF-8 bytes → display symbols → BPE merges → vocab ids.
# A final piece missing from the vocab falls back to its single-byte display
# characters; a missing byte token is malformed vocab and fails closed.
@ public
fn encode(Tokenizer t, string word) → list<int> ⇥ identity.TokenizerError {
    let list<u8> byte_values ← word ↦ list<b8> ↦ list<u8>
    mut list<string> symbola ← empty
    for from byte_values let b {
        symbola.append(unicode.trace_from_byte(b))
    }
    mut list<int> ids ← empty
    for from bpe_merge(t.concursus, symbola) let piece {
        let int ∪ none id ← t.vocab.get(piece)
        if id ≢ null {
            ids.append(id)
        }
        else {
            for from piece let character {
                let string c ← character ↦ string
                let int ∪ none cid ← t.vocab.get(c)
                if cid ≡ null then throw variant identity.TokenizerError.UnknownTrace { message = "byte piece missing from the vocabulary: §"(c) }
                ids.append(cid)
            }
        }
    }
    return ids
}

# Word-level decode: ids → vocab display strings → inverse display mapping →
# bytes → UTF-8 text. Unknown ids, unmappable display characters, and byte
# sequences that are not valid UTF-8 fail with typed errors.
@ public
fn decode(Tokenizer t, list<int> ids) → string ⇥ identity.TokenizerError {
    mut list<u8> bytes ← empty
    for from ids let id {
        reject id ≺ 0 or id ≥ t.multitudo throw variant identity.TokenizerError.UnknownId { message = "token id outside the vocabulary range: §"(id) }
        for from t.words[id] let character {
            bytes.append(unicode.byte_from_trace(character ↦ string))
        }
    }
    do {
        return bytes ↦ list<b8> ↦ string
    }
    catch err {
        throw variant identity.TokenizerError.BadUtf8 { message = "decoded byte sequence is not valid UTF-8" }
    }
}

fn encode_words_kind(Tokenizer t, string text, bool smollm) → list<int> ⇥ identity.TokenizerError {
    let list<string> words ← smollm ✓ unicode.scan_smollm(text) ✗ unicode.scan_words(text)
    mut list<int> ids ← empty
    for from words let word {
        ids.extend(encode(t, word))
    }
    return ids
}

# Shared literal path of both parse policies (qwen35 scanner).
fn encode_words(Tokenizer t, string text) → list<int> ⇥ identity.TokenizerError {
    return encode_words_kind(t, text, false)
}

# Full-prompt encode, parse_special = falsum: the whole prompt goes
# through scanner + BPE (specials read as their literal bytes).
@ public
fn encode_prompt(Tokenizer t, string text) → list<int> ⇥ identity.TokenizerError {
    return encode_words(t, text)
}

# The earliest special-token occurrence at or after `from`: the longest text
# wins at one position, and the first listed among equal texts.
fn next_special(Tokenizer t, string text, int from) → SpecialHit ∪ none {
    mut SpecialHit ∪ none best ← null
    for from t.special_texts, t.specialia_ids let special, sid {
        let int ∪ none at ← unicode.find_span(text, special, from)
        if at ≢ null {
            let int length ← special.length()
            if best ≡ null or at ≺ best!.at or (at ≡ best!.at and length ≻ best!.length) {
                best ← SpecialHit { at = at, length = length, id = sid }
            }
        }
    }
    return best
}

# The characters [lo, hi) of a prompt.
fn span_text(string text, int lo, int hi) → string ⇥ identity.TokenizerError {
    do {
        return text.slice(lo, hi)
    }
    catch err {
        throw variant identity.TokenizerError.BadWire { message = "prompt span is outside the prompt" }
    }
}

# Full-prompt encode with an explicit scanner. `specials` splits on the
# artifact special cache first; `smollm` selects the SMOLLM scanner. The
# cursor jumps past each special match, so the loop's step is the match.
fn encode_prompt_kind(Tokenizer t, string text, bool specials, bool smollm) → list<int> ⇥ identity.TokenizerError {
    if not specials then return encode_words_kind(t, text, smollm)
    let int n ← text.length()
    mut list<int> ids ← empty
    mut int pos ← 0
    while pos ≺ n {
        let SpecialHit ∪ none hit ← next_special(t, text, pos)
        if hit ≡ null {
            ids.extend(encode_words_kind(t, span_text(text, pos, n), smollm))
            break
        }
        if hit.at ≻ pos then ids.extend(encode_words_kind(t, span_text(text, pos, hit.at), smollm))
        ids.append(hit.id)
        pos ← hit.at + hit.length
    }
    return ids
}

# Full-prompt encode, parse_special = verum: split the prompt on the
# artifact special cache BEFORE the scanner (llama.cpp
# split_special_tokens/find_special_token — earliest match, longest text
# on ties), emitting each special's single id and scanning each plain
# slice independently. A prompt with no specials encodes identically to
# encode_prompt.
@ public
fn encode_prompt_special(Tokenizer t, string text) → list<int> ⇥ identity.TokenizerError {
    return encode_prompt_kind(t, text, true, false)
}

# Provider encode route (G3): text → ids over the model's tables.
# SMOLLM scanner + parse-special on (llama-tokenize default; P5/P7/P8/P9).
# BOS is never prepended. Detokenize is deferred.
@ public
fn tokenize(Tokenizer t, string text) → list<int> ⇥ identity.TokenizerError {
    return encode_prompt_kind(t, text, true, true)
}

# Provider encode, parse-special off (P6 literal BPE bytes).
@ public
fn tokenize_literal(Tokenizer t, string text) → list<int> ⇥ identity.TokenizerError {
    return encode_prompt_kind(t, text, false, true)
}

# -------------------------------------------------------------------------
# EOG + BOS-free policy (LIB-02-U3-5, GGUF-A2).
#
# The runtime EOG stop set mirrors llama-vocab.cpp llm_load_vocab (pinned
# oracle 10150 `dee2a846b`): the declared tokenizer.ggml.eos_token_id is
# always a member, every vocab token whose text is in the reference EOG
# name list is a member, and the FIM pad/rep/sep ids join when the metadata
# key or a reference text-name match resolves them. For the pinned artifact
# this is exactly {248044, 248046, 248063, 248064, 248065}. The BOS policy
# reads tokenizer.ggml.add_bos_token (absent → falsum, the llama.cpp bool
# default): encode never prepends a BOS, so the falsum artifact is BOS-free
# (empty prompt → empty sequence). An artifact without EOG metadata yields
# an empty EOG set — no hard-coded SmolLM2 fallback (the stop-condition
# invariant).
# -------------------------------------------------------------------------

# Dedupe + ascending sort (the reference's EOG set order). The set only answers
# membership: the result is built from `a`'s own values, never by iterating the
# set, because the MIR runner hands a `set<int>` element back as `UInt` and a
# tensor index (`logits[[id]]` in Inferentia's EOG mask) refuses that carrier.
fn sorted_unique(list<int> a) → list<int> {
    mut set<int> seen ← empty
    mut list<int> unique ← empty
    for from a let v {
        if v ∉ seen {
            seen.add(v)
            unique.append(v)
        }
    }
    return sort via asc from unique
}

# One FIM slot: the metadata key first, else the reference text-name
# fallback (first matching vocab entry in id order); none when nothing
# resolves. A present-but-malformed key fails closed.
fn artifact_end(gguf_manifest.GgufManifest m, list<string> words, string key, list<string> names) → int ∪ none ⇥ identity.TokenizerError {
    let int ∪ none id ← artifact_optional_number(m, key, "tokenizer FIM metadata")
    if id ≢ null {
        reject id ≺ 0 or id ≥ words.length() throw variant identity.TokenizerError.BadArtifact { message = "tokenizer FIM id is outside the vocabulary" }
        return id
    }
    for from words at [i] let word {
        if word ∈ names then return i
    }
    return null
}

# The artifact EOG set: declared eos id + the EOG-name scan + the FIM
# pad/rep/sep slots, deduped and ascending.
fn manifest_eog(gguf_manifest.GgufManifest m, list<string> words) → list<int> ⇥ identity.TokenizerError {
    mut list<int> candidati ← empty
    let int ∪ none eos ← artifact_optional_number(m, "tokenizer.ggml.eos_token_id", "tokenizer EOG metadata")
    if eos ≢ null {
        reject eos ≺ 0 or eos ≥ words.length() throw variant identity.TokenizerError.BadArtifact { message = "tokenizer eos_token_id is outside the vocabulary" }
        candidati.append(eos)
    }
    for from words at [i] let word {
        if word ∈ EOG_NAMES then candidati.append(i)
    }
    for from FIM_KEYS, FIM_NAMES let key, names {
        let int ∪ none fim ← artifact_end(m, words, key, names)
        if fim ≢ null then candidati.append(fim)
    }
    return sorted_unique(candidati)
}

# The artifact's add_bos_token (GGUF bool; absent → falsum, the llama.cpp
# kv_bool default). A present non-bool value fails closed.
fn artifact_add_bos(gguf_manifest.GgufManifest m) → bool ⇥ identity.TokenizerError {
    if not gguf_manifest.has_key(m, "tokenizer.ggml.add_bos_token") then return false
    let gguf_manifest.GgufMetadata x ← artifact_metadata(m, "tokenizer.ggml.add_bos_token", "tokenizer.add_bos_token")
    require x.dtype ≡ KIND_BOOL throw variant identity.TokenizerError.BadArtifact { message = "tokenizer.add_bos_token is not a GGUF bool" }
    return (x.payload_wire ↦ list<u8>)[0] ≡ 1
}

# The artifact's chat template (U3-6). tokenizer.chat_template is OPTIONAL
# in GGUF: absent → empty string (the artifact declares no template — the
# renderer fails closed instead of inventing one). A PRESENT but malformed
# value fails closed.
fn artifact_chat_template(gguf_manifest.GgufManifest m) → string ⇥ identity.TokenizerError {
    if not gguf_manifest.has_key(m, "tokenizer.chat_template") then return ""
    do {
        return gguf_manifest.text(m, "tokenizer.chat_template")
    }
    catch err {
        throw variant identity.TokenizerError.BadArtifact { message = "tokenizer.chat_template is malformed: §"(err.message) }
    }
}

# The runtime EOG stop set (ascending; mirrors the reference's set order).
@ public
fn artifact_eog(Tokenizer t) → list<int> {
    return t.eog
}

# EOG-membership predicate — the runtime generation stop-policy binding
# (the artifact-set equivalent of the identity contract's is_eog).
@ public
fn is_artifact_eog(Tokenizer t, int id) → bool {
    return id ∈ t.eog
}

# The artifact's add_bos_token flag (falsum for the pinned artifact — the
# BOS-free policy: encode never prepends a BOS).
@ public
fn add_bos(Tokenizer t) → bool {
    return t.add_bos
}

# -------------------------------------------------------------------------
# Chat-template policy (LIB-02-U3-6, GGUF-A2).
#
# `tokenizer.chat_template` loads from artifact metadata (empty when the
# artifact declares none — the no-template state). The MINIMAL Qwen3-ChatML
# user-turn render applies the pinned shape `<|im_start|>user\n{content}
# <|im_end|>\n` — the executed subset of the artifact's Jinja template, NOT
# a universal template engine (the delivery forbids one). Full vision/tool-
# calling branches of the template are recorded, not executed (stop-
# condition scope). Rendering fails closed when the artifact declares no
# template — no hard-coded fallback (the artifact-backed invariant).
# -------------------------------------------------------------------------

# The artifact's chat template (the minimal ChatML subset the renderer
# applies; empty when the artifact declares none).
@ public
fn chat_template(Tokenizer t) → string {
    return t.chat_template
}

# Minimal Qwen3-ChatML user-turn render: `<|im_start|>user\n{content}
# <|im_end|>\n`. The content embeds verbatim, so encoding the rendered turn
# composes without changing the content's pinned ids (R1, U3-6 oracle).
@ public
fn render_user_turn(Tokenizer t, string content) → string ⇥ identity.TokenizerError {
    require t.chat_template.length() ≢ 0 throw variant identity.TokenizerError.BadArtifact { message = "artifact declares no chat template" }
    return "<|im_start|>user\n§<|im_end|>\n"(content)
}
