+++ toml
locale = "en"

+++ faber
# Byte-level BPE runtime — table construction, merge, encode, decode.
#
# Public import: import from "gradus:tokenizer/bpe" bpe
# Depends on: gradus:tokenizer/identity, gradus:tokenizer/unicode,
#   gradus:model/gguf_manifest.

import from "gradus:tokenizer/identity"

import from "gradus:tokenizer/unicode"

import from "gradus:model/gguf_manifest"

# Byte-level BPE capability contract. The runtime only implements the gpt2
# byte-to-unicode convention, so the manifest's declared tokenizer model must
# be the byte-level family. Independent of the identity contract's pinned
# SmolLM2 kind constant (clean break posture).
const string TOKENIZER_CAPABLE = "gpt2"

# GEA3 is an intentionally specialized SmolLM census admission. These
# constants belong to this admission seam; generic TokenizerIdentity does not
# export or require them.
const string GEA3_PRE_TOKENIZER = "smollm"

const int GEA3_VOCAB = 49152

const int GEA3_MERGES = 48900

# Sentinel rank for a pair absent from the merge table (never merges).
const int MERGE_ABSENS = 9223372036854775807

# llama.cpp llama_token_type NORMAL — the special-cache boundary: every
# vocab entry whose token_type is not NORMAL is special (the
# llama_vocab::init_special rule; U3-4).
const int KIND_NORMAL = 1

# GGUF metadata wire type for tokenizer.ggml.add_bos_token (bool) — mirrors
# the manifest module's private GGUF_BOOL constant (7).
const int KIND_BOOL = 7

# EOG text names (llama-vocab.cpp llm_load_vocab, pinned oracle 10150
# `dee2a846b`): every vocab token whose text is one of these names is an
# end-of-generation token (U3-5). The final name is the DeepSeek-OCR form
# with fullwidth bars and U+2581 lower-one-eighth-block separators.
const list<string> EOG_NAMES = ["<|eot_id|>", "<|im_end|>", "<|end|>", "<|return|>", "<|call|>", "<|flush|>", "<|calls|>", "<end_of_turn>", "<|endoftext|>", "</s>", "<|eom_id|>", "<EOT>", "_<EOT>", "[EOT]", "[EOS]", "<|end_of_text|>", "<end_of_utterance>", "<eos>", "<turn|>", "<|tool_response>", "<｜end▁of▁sentence｜>", "[e~["]

# FIM token text-name fallbacks — llama.cpp only falls back to these when
# the tokenizer.ggml.fim_*_token_id metadata keys are absent.
const list<string> FIM_PAD_NAMES = ["<|fim_pad|>", "<fim-pad>", "<fim_pad>", "<PAD>", "[PAD]"]

const list<string> FIM_REP_NAMES = ["<|fim_repo|>", "<|repo_name|>", "<fim-repo>", "<REPO>", "<reponame>"]

const list<string> FIM_SEP_NAMES = ["<|file_sep|>"]

# The artifact-backed runtime record. `words` is the vocab array indexed
# by token id (decode path); `vocab` is the display-token → id map and
# `concursus` the "left right" merge-pair → rank map (encode path).
# `traces` is the precomputed 256-entry byte → display-character table
# (the gpt2 byte-to-unicode convention, built once at construction and
# shared by every encode). `special_texts`/`specialia_ids` are the
# artifact special-token cache (parallel lists; every non-NORMAL
# token_type entry, U3-4) that drives the parse-special on/off policy.
# `eog` is the artifact EOG stop set and `add_bos` the artifact's
# add_bos_token flag (U3-5). `chat_template` is the artifact's
# tokenizer.chat_template string (U3-6; absent → empty — no hard-coded
# fallback).


@ public
class Tokenizer {
    mut list<string> words
    mut map<string, int> vocab
    mut map<string, int> concursus
    mut list<string> traces
    mut list<string> special_texts
    mut list<int> specialia_ids
    mut list<int> eog
    mut bool add_bos
    mut string chat_template
    mut int multitudo
}

# --- Byte ↔ display-codepoint mapping (gpt2 convention) --------------------

# Byte value → display codepoint. Bytes in the printable/Latin-1 ranges map
# to themselves; the remaining 68 bytes map to 0x100+n in ascending byte
# order (0x00 → U+0100, 0x20 → U+0120, 0x7F → U+0121, …, 0xAD → U+0143).
fn code_from_byte(int byte) → int ⇥ identity.TokenizerError {
    reject byte ≺ 0 or byte ≻ 255 throw variant identity.TokenizerError.BadWire { message = "byte value outside 0..255" }

    if byte ≥ 33 and byte ≤ 126 then return byte

    if byte ≥ 161 and byte ≤ 172 then return byte

    if byte ≥ 174 and byte ≤ 255 then return byte

    if byte ≤ 32 then return 256 + byte

    if byte ≤ 160 then return byte + 162

    return 323
}

# Display codepoint → byte value (inverse mapping). Unmappable codepoints
# are malformed vocab content and fail closed.
fn byte_from_code(int cpt) → int ⇥ identity.TokenizerError {
    if cpt ≥ 33 and cpt ≤ 126 then return cpt

    if cpt ≥ 161 and cpt ≤ 172 then return cpt

    if cpt ≥ 174 and cpt ≤ 255 then return cpt

    if cpt ≥ 256 and cpt ≤ 288 then return cpt - 256

    if cpt ≥ 289 and cpt ≤ 322 then return cpt - 162

    if cpt ≡ 323 then return 173

    throw variant identity.TokenizerError.UnknownTrace { message = "display character has no byte mapping (codepoint §)"(cpt ↦ string) }
}

# --- Codepoint ↔ text helpers -------------------------------------------

fn text_from_bytes(list<int> bs) → string ⇥ identity.TokenizerError {
    mut list<u8> u8s ← empty

    for from bs let b {
        do {
            u8s.append(b ↦ u8)
        }
        catch err {
            throw variant identity.TokenizerError.BadUtf8 { message = "display character byte is out of range" }
        }
    }

    let list<b8> o ↤ u8s

    do {
        return o ↦ string
    }
    catch err {
        throw variant identity.TokenizerError.BadUtf8 { message = "display character bytes are not valid UTF-8" }
    }

    throw variant identity.TokenizerError.BadUtf8 { message = "unreachable display character conversion" }
}

# UTF-8 encode one codepoint to its single-character text. Display
# codepoints are ≤ 0x143, so the 1- and 2-byte arms cover the mapping; the
# longer arms keep the helper total for arbitrary vocab content.
fn text_from_code(int cpt) → string ⇥ identity.TokenizerError {
    require cpt ≥ 0 throw variant identity.TokenizerError.BadWire { message = "negative codepoint" }

    do {
        let char c ← cpt ↦ char via code
        return c ↦ string
    }
    catch err {
        throw variant identity.TokenizerError.BadWire { message = "codepoint exceeds the Unicode range" }
    }
}

# Codepoint at byte offset `i` of a display text's byte values for a known
# sequence width (the byte-list twin of the single-character decode
# arithmetic: the lead byte's width selects the arm and the continuation
# bytes fold in with the same masks and shifts).
fn trace_code(list<int> bs, int i, int width) → int {
    let int b0 ← bs.get(i) coalesce 0
    let int b1 ← bs.get(i + 1) coalesce 0

    if width ≡ 2 then return (b0 ∧ 31) ⇐ 6 ∨ b1 ∧ 63

    let int b2 ← bs.get(i + 2) coalesce 0

    if width ≡ 3 then return (b0 ∧ 15) ⇐ 12 ∨ (b1 ∧ 63) ⇐ 6 ∨ b2 ∧ 63

    let int b3 ← bs.get(i + 3) coalesce 0

    return (b0 ∧ 7) ⇐ 18 ∨ (b1 ∧ 63) ⇐ 12 ∨ (b2 ∧ 63) ⇐ 6 ∨ b3 ∧ 63
}

# Bulk bytes → byte-value bridge (the runtime's analogue of the manifest
# module's `byte-list helper`; error-free by construction — the input always
# comes from a text UTF-8 encode; the bits list reads as `u8` numbers, then
# widens to `int`).
fn number_bytes(list<b8> o) → list<int> {
    let list<u8> u ← o ↦ list<u8>
    return u ↦ list<int>
}

# One display character (the byte-level BPE symbol for a single source byte).
fn trace_from_byte(int byte) → string ⇥ identity.TokenizerError {
    return text_from_code(code_from_byte(byte))
}

# The precomputed 256-entry byte → display-character table, built once per
# runtime: encode reads every source byte's symbol (and every fallback
# piece's symbols) from this table instead of re-deriving the UTF-8 text
# per byte.
fn trace_table() → list<string> ⇥ identity.TokenizerError {
    mut list<string> table ← empty

    for exclusive 256 let b {
        table.append(trace_from_byte(b))
    }

    return table
}

# --- Manifest reads and merge-table construction ---------------------------

fn artifact_text(gguf_manifest.GgufManifest m, string key) → string ⇥ identity.TokenizerError {
    do {
        return gguf_manifest.text(m, key)
    }
    catch err {
        throw variant identity.TokenizerError.BadArtifact { message = "tokenizer metadata is unavailable: §"(err.message) }
    }

    throw variant identity.TokenizerError.BadArtifact { message = "unreachable tokenizer metadata read" }
}

fn artifact_texts(gguf_manifest.GgufManifest m, string key) → list<string> ⇥ identity.TokenizerError {
    do {
        return gguf_manifest.texts(m, key)
    }
    catch err {
        throw variant identity.TokenizerError.BadArtifact { message = "tokenizer array is unavailable: §"(err.message) }
    }

    throw variant identity.TokenizerError.BadArtifact { message = "unreachable tokenizer array read" }
}

# tokenizer.ggml.token_type is OPTIONAL in GGUF: llama.cpp defaults absent
# types to NORMAL (→ an empty special cache). A PRESENT but malformed
# token_type fails closed.
fn artifact_optional_types(gguf_manifest.GgufManifest m) → list<int> ⇥ identity.TokenizerError {
    do {
        return gguf_manifest.numbers(m, "tokenizer.ggml.token_type")
    }
    catch err {
        match err {
            case gguf_manifest.GgufManifestError.NotFound let message {
                return empty
            }
            case _ {
                throw variant identity.TokenizerError.BadArtifact { message = "tokenizer token_type is malformed: §"(err.message) }
            }
        }
    }

    throw variant identity.TokenizerError.BadArtifact { message = "unreachable tokenizer token_type read" }
}

# Array-length read for the census admission: reads the declared element
# count from the wire header without decoding the elements (the full decode
# happens exactly once, in build). A malformed array fails closed.
fn artifact_length(gguf_manifest.GgufManifest m, string key) → int ⇥ identity.TokenizerError {
    do {
        return gguf_manifest.list_length(m, key)
    }
    catch err {
        throw variant identity.TokenizerError.BadArtifact { message = "tokenizer array is unavailable: §"(err.message) }
    }

    throw variant identity.TokenizerError.BadArtifact { message = "unreachable tokenizer array length read" }
}

# token_type array-length read: an absent array counts as zero rows
# (mirrors artifact_optional_types for the length-only admission check).
fn artifact_optional_length(gguf_manifest.GgufManifest m) → int ⇥ identity.TokenizerError {
    do {
        return gguf_manifest.list_length(m, "tokenizer.ggml.token_type")
    }
    catch err {
        match err {
            case gguf_manifest.GgufManifestError.NotFound let message {
                return 0
            }
            case _ {
                throw variant identity.TokenizerError.BadArtifact { message = "tokenizer token_type is malformed: §"(err.message) }
            }
        }
    }

    throw variant identity.TokenizerError.BadArtifact { message = "unreachable tokenizer token_type length read" }
}

# Merge-entry well-formedness: exactly "left right" with a single space
# separator and non-empty halves (llama.cpp's find_bpe_rank asserts the same
# no-space-in-token invariant).
fn pair_ok(string par) → bool {
    if par.length() ≡ 0 then return false

    let list<string> partes ← par.split(" ")

    if partes.length() ≢ 2 then return false

    if (partes.get(0) coalesce "").length() ≡ 0 then return false

    if (partes.get(1) coalesce "").length() ≡ 0 then return false

    return true
}

# --- BPE merge loop (llama.cpp one-at-a-time semantics) --------------------

# The merge-table key of one adjacent symbol pair.
fn pair_key(string l, string r) → string {
    return "§ §"(l, r)
}

# Min-heap ordering over (rank, position) entries: strictly smaller rank,
# else strictly smaller position (the leftmost tie-break).
fn entry_before(list<int> ranks, list<int> poses, int a, int b) → bool {
    let int ra ← ranks.get(a) coalesce 0
    let int rb ← ranks.get(b) coalesce 0

    if ra ≺ rb then return true

    if ra ≻ rb then return false

    return (poses.get(a) coalesce 0) ≺ (poses.get(b) coalesce 0)
}

# Sift the entry at index i up toward the root.
fn heap_sift_up(mut list<int> ranks, mut list<int> poses, int i) → void {
    mut int cur ← i

    while cur ≻ 0 {
        let int parent ← (cur - 1) / 2

        if entry_before(ranks, poses, cur, parent) {
            let int rank ← ranks.get(cur) coalesce 0
            let int pos ← poses.get(cur) coalesce 0
            ranks[cur] ← ranks.get(parent) coalesce 0
            poses[cur] ← poses.get(parent) coalesce 0
            ranks[parent] ← rank
            poses[parent] ← pos
            cur ← parent
        }
        else {
            return
        }
    }
}

# Sift the entry at index i down inside the live region [0, extent).
fn heap_sift_down(mut list<int> ranks, mut list<int> poses, int i, int extent) → void {
    mut int cur ← i

    while true {
        let int child ← 2 * cur + 1

        if child ≥ extent {
            return
        }

        mut int pick ← child
        let int other ← child + 1

        if other ≺ extent {
            if entry_before(ranks, poses, other, pick) {
                pick ← other
            }
        }

        if entry_before(ranks, poses, pick, cur) {
            let int rank ← ranks.get(cur) coalesce 0
            let int pos ← poses.get(cur) coalesce 0
            ranks[cur] ← ranks.get(pick) coalesce 0
            poses[cur] ← poses.get(pick) coalesce 0
            ranks[pick] ← rank
            poses[pick] ← pos
            cur ← pick
        }
        else {
            return
        }
    }
}

# Push one (rank, position) entry into the live region [0, extent): reuses
# the dead slot at `extent` when earlier pops left one, else appends. The
# caller increments its own extent afterwards.
fn heap_push(mut list<int> ranks, mut list<int> poses, int extent, int rank, int pos) → void {
    if ranks.length() ≡ extent {
        ranks.append(rank)
        poses.append(pos)
    }
    else {
        ranks[extent] ← rank
        poses[extent] ← pos
    }

    heap_sift_up(mut ranks, mut poses, extent)
}

# Pop the current minimum entry; restores the heap over the remaining
# extent-1 entries. Caller must pass extent > 0 and decrement afterwards.
fn heap_pop(mut list<int> ranks, mut list<int> poses, int extent) → tuple<int, int> {
    let int rank ← ranks.get(0) coalesce 0
    let int pos ← poses.get(0) coalesce 0
    let int last ← extent - 1

    if last ≻ 0 {
        ranks[0] ← ranks.get(last) coalesce 0
        poses[0] ← poses.get(last) coalesce 0
        heap_sift_down(mut ranks, mut poses, 0, last)
    }

    return tuple<int, int> [rank, pos]
}

# Repeatedly merge the adjacent pair with the lowest merge rank (ties broken
# by the leftmost position), one occurrence per step, until no pair merges.
# The symbol chain is a doubly-linked index array (prev/next over the
# original positions; a merge's left node absorbs its right neighbor), and
# a (rank, position) min-heap replaces the per-step full scan: each merge
# pushes only the two newly adjacent pairs, and a popped entry is skipped
# unless its left node is still alive and its current right neighbor still
# forms the entry's ranked pair. A pair's string is constant while both
# nodes stay adjacent (symbols change only by absorbing, which dissolves
# the pair), so every mergeable pair always holds a live heap entry and
# the pop order equals the scan's (rank, leftmost-position) choice.
# W0 stay: this compound (rank, leftmost-position) key has no covering twin;
# retain its sentinel guard pending a future operator ruling.
fn bpe_merge(map<string, int> concursus, list<string> symbola) → list<string> {
    let int n ← symbola.length()

    if n ≺ 2 {
        mut list<string> idem ← copy symbola
        return idem
    }

    mut list<string> sym ← empty
    mut list<int> prev ← empty
    mut list<int> next ← empty
    mut list<bool> alive ← empty

    for exclusive n let i {
        sym.append(symbola.get(i) coalesce "")
        prev.append(i - 1)

        if i + 1 ≺ n {
            next.append(i + 1)
        }
        else {
            next.append(-1)
        }

        alive.append(true)
    }

    mut list<int> heap_rank ← empty
    mut list<int> heap_pos ← empty
    mut int extent ← 0

    for exclusive (n - 1) let i {
        let int rank ← concursus.get(pair_key(sym.get(i) coalesce "", sym.get(i + 1) coalesce "")) coalesce MERGE_ABSENS

        if rank ≺ MERGE_ABSENS {
            heap_push(mut heap_rank, mut heap_pos, extent, rank, i)
            extent ↑
        }
    }

    while extent ≻ 0 {
        let tuple<int, int> entry ← heap_pop(mut heap_rank, mut heap_pos, extent)
        extent ← extent - 1
        let int rank ← entry[0]
        let int p ← entry[1]

        if not (alive.get(p) coalesce false) {
            continue
        }

        let int q ← next.get(p) coalesce (-1)

        if q ≺ 0 {
            continue
        }

        let int cur_rank ← concursus.get(pair_key(sym.get(p) coalesce "", sym.get(q) coalesce "")) coalesce MERGE_ABSENS

        if cur_rank ≢ rank {
            continue
        }

        # Merge q into p: p keeps the position, q leaves the chain.
        let string cohaesum ← "§§"(sym.get(p) coalesce "", sym.get(q) coalesce "")
        sym[p] ← cohaesum
        alive[q] ← false
        let int tail ← next.get(q) coalesce (-1)
        next[p] ← tail

        if tail ≥ 0 {
            prev[tail] ← p
        }

        # Only the two newly adjacent pairs can merge next.
        let int before ← prev.get(p) coalesce (-1)

        if before ≥ 0 {
            let int near_rank ← concursus.get(pair_key(sym.get(before) coalesce "", sym.get(p) coalesce "")) coalesce MERGE_ABSENS

            if near_rank ≺ MERGE_ABSENS {
                heap_push(mut heap_rank, mut heap_pos, extent, near_rank, before)
                extent ↑
            }
        }

        if tail ≥ 0 {
            let int far_rank ← concursus.get(pair_key(sym.get(p) coalesce "", sym.get(tail) coalesce "")) coalesce MERGE_ABSENS

            if far_rank ≺ MERGE_ABSENS {
                heap_push(mut heap_rank, mut heap_pos, extent, far_rank, p)
                extent ↑
            }
        }
    }

    mut list<string> out ← empty
    mut int node ← 0

    while node ≥ 0 {
        out.append(sym.get(node) coalesce "")
        node ← next.get(node) coalesce (-1)
    }

    return out
}

# --- Runtime construction, encode, decode -----------------------------------

# Build the runtime from a parsed manifest. The vocab and merge arrays come
# from the artifact; the declared model must be the byte-level BPE family.
# W0 stay: artifact construction must validate and populate maps in source
# order, preserving fail-closed error timing; no fold covers these effects.
@ public
fn build(gguf_manifest.GgufManifest m) → Tokenizer ⇥ identity.TokenizerError {
    let string merge_kind ← artifact_text(m, "tokenizer.ggml.model")

    require merge_kind ≡ TOKENIZER_CAPABLE throw variant identity.TokenizerError.UnknownMergeKind { message = "tokenizer runtime is byte-level BPE; manifest declares: §"(merge_kind) }

    let list<string> words ← artifact_texts(m, "tokenizer.ggml.tokens")

    require words.length() ≢ 0 throw variant identity.TokenizerError.BadArtifact { message = "tokenizer vocabulary is empty" }

    let list<string> merges ← artifact_texts(m, "tokenizer.ggml.merges")
    mut map<string, int> vocab ← empty

    for range 0 ‥ words.length() let i {
        vocab.put(words.get(i) coalesce "", i)
    }

    mut map<string, int> concursus ← empty
    mut int j ← 0

    while j ≺ merges.length() {
        let string par ← merges.get(j) coalesce ""

        require pair_ok(par) throw variant identity.TokenizerError.BadMerges { message = "malformed merge entry: §"(par) }

        concursus.put(par, j)
        j ↑
    }

    # Special-token cache (U3-4): every vocab entry whose token_type is not
    # NORMAL is special (llama.cpp llama_vocab::init_special); absent
    # token_type means no specials (the reference defaults to NORMAL).
    let list<int> kinds ← artifact_optional_types(m)

    reject kinds.length() ≻ 0 and kinds.length() ≢ words.length() throw variant identity.TokenizerError.BadArtifact { message = "tokenizer token_type length does not match the vocabulary" }

    mut list<string> special_texts ← empty
    mut list<int> specialia_ids ← empty
    mut int k ← 0

    while k ≺ words.length() {
        let int kind ← kinds.get(k) coalesce KIND_NORMAL

        if kind ≢ KIND_NORMAL {
            special_texts.append(words.get(k) coalesce "")
            specialia_ids.append(k)
        }

        k ↑
    }

    # EOG stop set + BOS policy (U3-5), derived from the artifact exactly
    # like llama.cpp llm_load_vocab: the declared eos id, the reference EOG
    # text names, and the FIM pad/rep/sep ids (metadata first, else the
    # text-name fallback); add_bos reads tokenizer.ggml.add_bos_token.
    # The chat template (U3-6) reads tokenizer.chat_template (absent →
    # empty, the no-template state).
    let list<int> eog ← manifest_eog(m, words, vocab)
    let bool add_bos ← artifact_add_bos(m)
    let string chat_template ← artifact_chat_template(m)
    let list<string> traces ← trace_table()
    return Tokenizer { words = words, vocab = vocab, concursus = concursus, traces = traces, special_texts = special_texts, specialia_ids = specialia_ids, eog = eog, add_bos = add_bos, chat_template = chat_template, multitudo = words.length() }
}

# Sparse table constructor — the provider builds a runtime over the model's
# vocab/merge arrays without wrapping them in a GGUF corpus. `ids`/`tokens`
# are parallel (token `tokens[i]` lives at id `ids[i]`); `special_ids` are
# the parse-special cache (must appear in `ids`). Unmapped bytes fail
# closed at encode time (UnknownTrace).
# W0 stay: sparse admission interleaves ordered validation, map population,
# and sentinel filling; no fold preserves those effects and error timing.
@ public
fn build_tables(list<int> ids, list<string> tokens, list<string> merges, list<int> special_ids) → Tokenizer ⇥ identity.TokenizerError {
    require ids.length() ≡ tokens.length() throw variant identity.TokenizerError.BadArtifact { message = "tokenizer table ids and tokens are different lengths" }

    require ids.length() ≢ 0 throw variant identity.TokenizerError.BadArtifact { message = "tokenizer vocabulary is empty" }

    mut map<int, string> per_id ← empty
    mut map<string, int> vocab ← empty

    for range 0 ‥ ids.length() let i {
        let int id ← ids.get(i) coalesce (-1)

        require id ≥ 0 throw variant identity.TokenizerError.BadArtifact { message = "tokenizer table id is negative" }

        let string token ← tokens.get(i) coalesce ""
        per_id.put(id, token)
        vocab.put(token, id)
    }

    # The validated, non-empty id collection supplies the max-id position;
    # read the value back after argmax, preserving the existing defensive
    # default for the nullable read.
    let int max_index ← ids.argmax() coalesce 0
    let int max_id ← ids.get(max_index) coalesce (-1)
    mut list<string> words ← empty
    mut int k ← 0

    while k ≤ max_id {
        words.append(per_id.get(k) coalesce "")
        k ↑
    }

    mut map<string, int> concursus ← empty
    mut int j ← 0

    while j ≺ merges.length() {
        let string par ← merges.get(j) coalesce ""

        require pair_ok(par) throw variant identity.TokenizerError.BadMerges { message = "malformed merge entry: §"(par) }

        concursus.put(par, j)
        j ↑
    }

    mut list<string> special_texts ← empty
    mut list<int> specialia_ids ← empty

    for from special_ids let sid {
        reject sid ≺ 0 or sid ≻ max_id throw variant identity.TokenizerError.BadArtifact { message = "special token id is outside the table: §"(sid ↦ string) }

        let string txt ← words.get(sid) coalesce ""

        require txt.length() ≢ 0 throw variant identity.TokenizerError.BadArtifact { message = "special token id has no table entry: §"(sid ↦ string) }

        special_texts.append(txt)
        specialia_ids.append(sid)
    }

    mut list<int> eog_cand ← empty
    mut int e ← 0

    while e ≺ ids.length() {
        let string v ← tokens.get(e) coalesce ""

        if in_name(v, EOG_NAMES) {
            eog_cand.append(ids.get(e) coalesce (-1))
        }

        e ↑
    }

    let list<string> traces ← trace_table()
    return Tokenizer { words = words, vocab = vocab, concursus = concursus, traces = traces, special_texts = special_texts, specialia_ids = specialia_ids, eog = sort_ascending(eog_cand), add_bos = false, chat_template = "", multitudo = words.length() }
}

# -------------------------------------------------------------------------
# GEA3-U2 — census-bound tokenizer table admission (GEA3 full-model route).
#
# The vocab/merge tables admit from the pinned GGUF through the EXISTING
# typed artifact accessors (the same `texts`/`numbers` seams `build` reads)
# with the frozen GEA3 census rows checked against the local specialized
# constants: kind gpt2, pre-tokenizer smollm, 49,152 tokens, 48,900 merges,
# 49,152 token_type rows, BOS-free, and the artifact EOG set {0, 2, 4}
# (eos 2 + <|endoftext|> 0 + <|im_end|> 2 + <|fim_pad|> 4, ascending — the
# U1 manifest census `eog_set`). Any drift fails closed before runtime
# construction; `build` stays the unconstrained artifact constructor.
# -------------------------------------------------------------------------

# The frozen GEA3 artifact EOG census row.
const int GEA3_EOG_FIRST = 0

const int GEA3_EOG_SECOND = 2

const int GEA3_EOG_THIRD = 4

# W0 stay: this explicit admission matrix preserves each typed rejection
# boundary and its order; no collection construct covers the sequence.
@ public
fn admit_gea3_tables(gguf_manifest.GgufManifest m) → Tokenizer ⇥ identity.TokenizerError {
    let string kind ← artifact_text(m, "tokenizer.ggml.model")

    require kind ≡ TOKENIZER_CAPABLE throw variant identity.TokenizerError.UnknownMergeKind { message = "GEA3 tokenizer table kind does not match the pinned census row: §"(kind) }

    let string pre ← artifact_text(m, "tokenizer.ggml.pre")

    require pre ≡ GEA3_PRE_TOKENIZER throw variant identity.TokenizerError.UnknownPreTokenizer { message = "GEA3 tokenizer pre-tokenizer does not match the pinned census row: §"(pre) }

    # Census count checks read the declared array lengths from the wire
    # headers; the arrays themselves decode exactly once, inside build.
    let int token_count ← artifact_length(m, "tokenizer.ggml.tokens")

    require token_count ≡ GEA3_VOCAB throw variant identity.TokenizerError.BadVocab { message = "GEA3 tokenizer vocabulary count does not match the pinned census row" }

    let int merge_count ← artifact_length(m, "tokenizer.ggml.merges")

    require merge_count ≡ GEA3_MERGES throw variant identity.TokenizerError.BadVocab { message = "GEA3 tokenizer merge count does not match the pinned census row" }

    let int kind_count ← artifact_optional_length(m)

    require kind_count ≡ GEA3_VOCAB throw variant identity.TokenizerError.BadVocab { message = "GEA3 tokenizer token_type count does not match the pinned census row" }

    let Tokenizer t ← build(m)

    reject add_bos(t) throw variant identity.TokenizerError.BadArtifact { message = "GEA3 pinned tokenizer is BOS-free; add_bos_token drifted" }

    let list<int> eog ← artifact_eog(t)

    require eog.length() ≡ 3 throw variant identity.TokenizerError.BadArtifact { message = "GEA3 artifact EOG set does not match the pinned census row" }

    require eog.get(0) coalesce (-1) ≡ GEA3_EOG_FIRST throw variant identity.TokenizerError.BadArtifact { message = "GEA3 artifact EOG set does not match the pinned census row" }

    require eog.get(1) coalesce (-1) ≡ GEA3_EOG_SECOND throw variant identity.TokenizerError.BadArtifact { message = "GEA3 artifact EOG set does not match the pinned census row" }

    require eog.get(2) coalesce (-1) ≡ GEA3_EOG_THIRD throw variant identity.TokenizerError.BadArtifact { message = "GEA3 artifact EOG set does not match the pinned census row" }

    return t
}

# Fallback expansion of one piece missing from the vocab: decode the
# piece's characters in one byte pass; each display character resolves
# back through its source byte's table entry (a piece's characters are
# exactly its source bytes' symbols, so the byte that produced each
# character is byte_from_code of its codepoint). A missing byte token is
# malformed vocab and fails closed.
fn append_fallback_ids(Tokenizer t, mut list<int> ids, string piece) → void ⇥ identity.TokenizerError {
    let list<int> bs ← number_bytes(piece ↦ list<b8>)
    let int pm ← bs.length()
    mut int pu ← 0

    while pu ≺ pm {
        let int b0 ← bs.get(pu) coalesce 0
        let int width ← lead_width(b0)

        require width ≥ 1 and pu + width ≤ pm throw variant identity.TokenizerError.UnknownTrace { message = "malformed display character" }

        mut int cpt ← b0

        if width ≻ 1 {
            cpt ← trace_code(bs, pu, width)
        }

        let string c ← t.traces.get(byte_from_code(cpt)) coalesce ""
        let int cid ← t.vocab.get(c) coalesce (-1)

        require cid ≥ 0 throw variant identity.TokenizerError.UnknownTrace { message = "byte piece missing from the vocabulary: §"(c) }

        ids.append(cid)
        pu ← pu + width
    }
}

# Word-level encode: UTF-8 bytes → display symbols → BPE merges → vocab ids.
# The display symbols read from the runtime's precomputed 256-entry byte
# table. A final piece missing from the vocab falls back to its single-byte
# display characters (append_fallback_ids); a missing byte token is
# malformed vocab and fails closed.
# W0 stay: ordered BPE output expansion has a failable fallback path; no
# map/flat-map form preserves it.
@ public
fn encode(Tokenizer t, string word) → list<int> ⇥ identity.TokenizerError {
    let list<int> byte_values ← number_bytes(word ↦ list<b8>)
    mut list<string> symbola ← empty

    for from byte_values let b {
        symbola.append(t.traces.get(b) coalesce "")
    }

    let list<string> end ← bpe_merge(t.concursus, symbola)
    mut list<int> ids ← empty

    for from end let piece {
        let int id ← t.vocab.get(piece) coalesce (-1)

        if id ≥ 0 {
            ids.append(id)
        }
        else {
            append_fallback_ids(t, mut ids, piece)
        }
    }

    return ids
}

# UTF-8 sequence width of one lead byte (0 when the byte cannot lead a
# sequence — a stray continuation byte or an out-of-range lead).
fn lead_width(int b0) → int {
    if b0 ≺ 128 then return 1

    if b0 ≥ 192 and b0 ≤ 223 then return 2

    if b0 ≥ 224 and b0 ≤ 239 then return 3

    if b0 ≥ 240 and b0 ≤ 247 then return 4

    return 0
}

# Append one display text's decoded bytes to the output: a direct UTF-8
# byte pass over the token's text (the lead byte selects the sequence
# width, each codepoint maps back through the inverse display mapping —
# no per-character string slicing or byte-list round-trips). The inverse
# mapping applies to one-byte characters too: byte_from_code is the
# identity on the printable range and fails closed on unmappable
# codepoints (vocab content).
fn append_trace_bytes(mut list<u8> bytes, string trace) → void ⇥ identity.TokenizerError {
    let list<int> bs ← number_bytes(trace ↦ list<b8>)
    let int m ← bs.length()
    mut int u ← 0

    while u ≺ m {
        let int b0 ← bs.get(u) coalesce 0
        let int width ← lead_width(b0)

        require width ≥ 1 and u + width ≤ m throw variant identity.TokenizerError.UnknownTrace { message = "malformed display character" }

        mut int cpt ← b0

        if width ≻ 1 {
            cpt ← trace_code(bs, u, width)
        }

        let int byte ← byte_from_code(cpt)

        do {
            bytes.append(byte ↦ u8)
        }
        catch err {
            throw variant identity.TokenizerError.BadUtf8 { message = "decoded byte is out of range" }
        }

        u ← u + width
    }
}

# Word-level decode: ids → vocab display strings → inverse display mapping →
# bytes → UTF-8 text. Unknown ids, unmappable display characters, and byte
# sequences that are not valid UTF-8 fail with typed errors. Each token's
# display text decodes in one direct UTF-8 byte pass (no per-character
# string slicing or byte-list round-trips).
# W0 stay: ordered decoding carries typed failures from each nested
# sequence; map cannot propagate the error channel and reduce would
# obscure first failure.
@ public
fn decode(Tokenizer t, list<int> ids) → string ⇥ identity.TokenizerError {
    mut list<u8> bytes ← empty

    for from ids let id {
        reject id ≺ 0 or id ≥ t.multitudo throw variant identity.TokenizerError.UnknownId { message = "token id outside the vocabulary range: §"(id ↦ string) }

        let string trace ← t.words.get(id) coalesce ""
        append_trace_bytes(mut bytes, trace)
    }

    let list<b8> o ↤ bytes

    do {
        return o ↦ string
    }
    catch err {
        throw variant identity.TokenizerError.BadUtf8 { message = "decoded byte sequence is not valid UTF-8" }
    }

    throw variant identity.TokenizerError.BadUtf8 { message = "unreachable decode conversion" }
}

fn encode_words_kind(Tokenizer t, string text, bool smollm) → list<int> ⇥ identity.TokenizerError {
    mut list<string> words ← empty

    if smollm {
        words ← unicode.scan_smollm(text)
    }
    else {
        words ← unicode.scan_words(text)
    }

    mut list<int> ids ← empty

    for from words let word {
        let list<int> partes ← encode(t, word)

        for from partes let id {
            ids.append(id)
        }
    }

    return ids
}

# Shared literal path of both parse policies (qwen35 scanner).
fn encode_words(Tokenizer t, string text) → list<int> ⇥ identity.TokenizerError {
    return encode_words_kind(t, text, false)
}

# Full-prompt encode, parse_special = falsum: the whole prompt goes
# through scanner + BPE (specials read as their literal bytes).
@ public
fn encode_prompt(Tokenizer t, string text) → list<int> ⇥ identity.TokenizerError {
    return encode_words(t, text)
}

# Does `specialis` match `text` exactly at character position `pos`?
# Compares character by character (single-character reads), so a
# non-matching special allocates no slice at all.
fn special_at(string text, string specialis, int pos) → bool {
    let int m ← specialis.length()

    if m ≡ 0 or pos + m ≻ text.length() then return false

    for exclusive m let j {
        if (specialis.get(j) coalesce "") ≢ (text.get(pos + j) coalesce "") then return false
    }

    return true
}

# Full-prompt encode with an explicit scanner. `specials` splits on the
# artifact special cache first; `smollm` selects the SMOLLM scanner.
# The special split indexes the special cache by first character and walks
# the prompt once left to right: the first position where any indexed
# special matches is the earliest occurrence, and the longest match at
# that position wins ties (list order below equal lengths — the previous
# scan's selection).
# W0 stay: special selection uses the compound (position, length) key, not
# an admitted unmasked argmax form.
fn encode_prompt_kind(Tokenizer t, string text, bool specials, bool smollm) → list<int> ⇥ identity.TokenizerError {
    if not specials then return encode_words_kind(t, text, smollm)

    let list<int> empty_ints ← empty
    mut map<string, list<int>> by_first ← empty

    for range 0 ‥ t.special_texts.length() let i {
        let string specialis ← t.special_texts.get(i) coalesce ""

        if specialis.length() ≻ 0 {
            let string head_char ← specialis.get(0) coalesce ""
            let list<int> prior ← by_first.get(head_char) coalesce empty_ints
            mut list<int> candidates ← empty

            for from prior let j {
                candidates.append(j)
            }

            candidates.append(i)
            by_first.put(head_char, candidates)
        }
    }

    let int n ← text.length()
    mut list<int> ids ← empty
    mut int pos ← 0
    mut int plain ← 0

    while pos ≺ n {
        let string c ← text.get(pos) coalesce ""
        let list<int> candidates ← by_first.get(c) coalesce empty_ints
        mut int melior_id ← -1
        mut int melior_length ← -1

        for from candidates let i {
            let string specialis ← t.special_texts.get(i) coalesce ""

            if specialis.length() ≻ melior_length and special_at(text, specialis, pos) {
                melior_id ← t.specialia_ids.get(i) coalesce (-1)
                melior_length ← specialis.length()
            }
        }

        if melior_length ≻ 0 {
            if pos ≻ plain {
                let list<int> partes ← encode_words_kind(t, text.slice(plain, pos), smollm)

                for from partes let id {
                    ids.append(id)
                }
            }

            ids.append(melior_id)
            pos ← pos + melior_length
            plain ← pos
            continue
        }

        pos ↑
    }

    if plain ≺ n {
        let list<int> partes ← encode_words_kind(t, text.slice(plain, n), smollm)

        for from partes let id {
            ids.append(id)
        }
    }

    return ids
}

# Full-prompt encode, parse_special = verum: split the prompt on the
# artifact special cache BEFORE the scanner (llama.cpp
# split_special_tokens/find_special_token — earliest match, longest text
# on ties), emitting each special's single id and scanning each plain
# slice independently. A prompt with no specials encodes identically to
# encode_prompt.
@ public
fn encode_prompt_special(Tokenizer t, string text) → list<int> ⇥ identity.TokenizerError {
    return encode_prompt_kind(t, text, true, false)
}

# Provider encode route (G3): text → ids over the model's tables.
# SMOLLM scanner + parse-special on (llama-tokenize default; P5/P7/P8/P9).
# BOS is never prepended. Detokenize is deferred.
@ public
fn tokenize(Tokenizer t, string text) → list<int> ⇥ identity.TokenizerError {
    return encode_prompt_kind(t, text, true, true)
}

# Provider encode, parse-special off (P6 literal BPE bytes).
@ public
fn tokenize_literal(Tokenizer t, string text) → list<int> ⇥ identity.TokenizerError {
    return encode_prompt_kind(t, text, false, true)
}

# -------------------------------------------------------------------------
# EOG + BOS-free policy (LIB-02-U3-5, GGUF-A2).
#
# The runtime EOG stop set mirrors llama-vocab.cpp llm_load_vocab (pinned
# oracle 10150 `dee2a846b`): the declared tokenizer.ggml.eos_token_id is
# always a member, every vocab token whose text is in the reference EOG
# name list is a member, and the FIM pad/rep/sep ids join when the metadata
# key or a reference text-name match resolves them. For the pinned artifact
# this is exactly {248044, 248046, 248063, 248064, 248065}. The BOS policy
# reads tokenizer.ggml.add_bos_token (absent → falsum, the llama.cpp bool
# default): encode never prepends a BOS, so the falsum artifact is BOS-free
# (empty prompt → empty sequence). An artifact without EOG metadata yields
# an empty EOG set — no hard-coded SmolLM2 fallback (the stop-condition
# invariant).
# -------------------------------------------------------------------------

# Contains-check over a name list (the EOG/FIM text-name scans).
fn in_name(string v, list<string> names) → bool {
    return v ∈ names
}

# Dedupe + ascending sort (the reference's EOG set order; -1 slots from the
# FIM fallback are dropped). First occurrences keep their scan order and the
# stable ascending sort matches the insertion form it replaces.
fn sort_ascending(list<int> a) → list<int> {
    mut list<int> seen ← empty

    for from a let v {
        if v ≺ 0 or v ∈ seen {
            continue
        }

        seen.append(v)
    }

    return sort via asc from seen
}

# One FIM slot: the metadata key first, else the reference text-name
# fallback (the names resolve through the vocab map in list order — the
# llama.cpp get_fid lookup). -1 when nothing resolves; a present-but-
# malformed key fails closed.
# W0 stay: the fallback returns the first resolving name, so filter/map do
# not replace this order-sensitive search.
fn artifact_end(gguf_manifest.GgufManifest m, list<string> words, string key, list<string> names, map<string, int> vocab) → int ⇥ identity.TokenizerError {
    mut int id ← -1
    mut bool adest ← false

    do {
        id ← gguf_manifest.number(m, key)
        adest ← true
    }
    catch err {
        match err {
            case gguf_manifest.GgufManifestError.NotFound let message {
                adest ← false
            }
            case _ {
                throw variant identity.TokenizerError.BadArtifact { message = "tokenizer FIM metadata is malformed: §"(err.message) }
            }
        }
    }

    if adest {
        reject id ≺ 0 or id ≥ words.length() throw variant identity.TokenizerError.BadArtifact { message = "tokenizer FIM id is outside the vocabulary" }

        return id
    }

    for from names let name {
        let int found ← vocab.get(name) coalesce (-1)

        if found ≥ 0 then return found
    }

    return -1
}

# The artifact EOG set: declared eos id + the EOG-name scan + the FIM
# pad/rep/sep slots, deduped and ascending. The name scans resolve through
# the vocab map (O(names) lookups, not an O(vocabulary) walk per name).
# W0 stay: candidates arrive from ordered metadata and name lookups before
# a separate dedupe/sort pass; no single closure intrinsic covers this
# shape.
fn manifest_eog(gguf_manifest.GgufManifest m, list<string> words, map<string, int> vocab) → list<int> ⇥ identity.TokenizerError {
    mut list<int> candidati ← empty
    mut int eos ← -1
    mut bool eos_adest ← false

    do {
        eos ← gguf_manifest.number(m, "tokenizer.ggml.eos_token_id")
        eos_adest ← true
    }
    catch err {
        match err {
            case gguf_manifest.GgufManifestError.NotFound let message {
                eos_adest ← false
            }
            case _ {
                throw variant identity.TokenizerError.BadArtifact { message = "tokenizer EOG metadata is malformed: §"(err.message) }
            }
        }
    }

    if eos_adest {
        reject eos ≺ 0 or eos ≥ words.length() throw variant identity.TokenizerError.BadArtifact { message = "tokenizer eos_token_id is outside the vocabulary" }

        candidati.append(eos)
    }

    for from EOG_NAMES let name {
        let int found ← vocab.get(name) coalesce (-1)

        if found ≥ 0 {
            candidati.append(found)
        }
    }

    candidati.append(artifact_end(m, words, "tokenizer.ggml.fim_pad_token_id", FIM_PAD_NAMES, vocab))
    candidati.append(artifact_end(m, words, "tokenizer.ggml.fim_rep_token_id", FIM_REP_NAMES, vocab))
    candidati.append(artifact_end(m, words, "tokenizer.ggml.fim_sep_token_id", FIM_SEP_NAMES, vocab))
    return sort_ascending(candidati)
}

# The artifact's add_bos_token (GGUF bool; absent → falsum, the llama.cpp
# kv_bool default). A present non-bool value fails closed.
fn artifact_add_bos(gguf_manifest.GgufManifest m) → bool ⇥ identity.TokenizerError {
    mut gguf_manifest.GgufMetadata x ← gguf_manifest.GgufMetadata { key = "", dtype = -1, payload_wire = || }
    mut bool adest ← false

    do {
        x ← gguf_manifest.metadata(m, "tokenizer.ggml.add_bos_token")
        adest ← true
    }
    catch err {
        match err {
            case gguf_manifest.GgufManifestError.NotFound let message {
                adest ← false
            }
            case _ {
                throw variant identity.TokenizerError.BadArtifact { message = "tokenizer.add_bos_token is malformed: §"(err.message) }
            }
        }
    }

    if not adest then return false

    require x.dtype ≡ KIND_BOOL throw variant identity.TokenizerError.BadArtifact { message = "tokenizer.add_bos_token is not a GGUF bool" }

    let list<int> bs ← number_bytes(x.payload_wire)
    return bs.get(0) coalesce 0 ≡ 1
}

# The artifact's chat template (U3-6). tokenizer.chat_template is OPTIONAL
# in GGUF: absent → empty string (the artifact declares no template — the
# renderer fails closed instead of inventing one). A PRESENT but malformed
# value fails closed.
fn artifact_chat_template(gguf_manifest.GgufManifest m) → string ⇥ identity.TokenizerError {
    do {
        return gguf_manifest.text(m, "tokenizer.chat_template")
    }
    catch err {
        match err {
            case gguf_manifest.GgufManifestError.NotFound let message {
                return ""
            }
            case _ {
                throw variant identity.TokenizerError.BadArtifact { message = "tokenizer.chat_template is malformed: §"(err.message) }
            }
        }
    }

    throw variant identity.TokenizerError.BadArtifact { message = "unreachable tokenizer.chat_template read" }
}

# The runtime EOG stop set (ascending; mirrors the reference's set order).
@ public
fn artifact_eog(Tokenizer t) → list<int> {
    return t.eog
}

# EOG-membership predicate — the runtime generation stop-policy binding
# (the artifact-set equivalent of the identity contract's is_eog).
@ public
fn is_artifact_eog(Tokenizer t, int id) → bool {
    return id ∈ t.eog
}

# The artifact's add_bos_token flag (falsum for the pinned artifact — the
# BOS-free policy: encode never prepends a BOS).
@ public
fn add_bos(Tokenizer t) → bool {
    return t.add_bos
}

# -------------------------------------------------------------------------
# Chat-template policy (LIB-02-U3-6, GGUF-A2).
#
# `tokenizer.chat_template` loads from artifact metadata (empty when the
# artifact declares none — the no-template state). The MINIMAL Qwen3-ChatML
# user-turn render applies the pinned shape `<|im_start|>user\n{content}
# <|im_end|>\n` — the executed subset of the artifact's Jinja template, NOT
# a universal template engine (the delivery forbids one). Full vision/tool-
# calling branches of the template are recorded, not executed (stop-
# condition scope). Rendering fails closed when the artifact declares no
# template — no hard-coded fallback (the artifact-backed invariant).
# -------------------------------------------------------------------------

# The artifact's chat template (the minimal ChatML subset the renderer
# applies; empty when the artifact declares none).
@ public
fn chat_template(Tokenizer t) → string {
    return t.chat_template
}

# Minimal Qwen3-ChatML user-turn render: `<|im_start|>user\n{content}
# <|im_end|>\n`. The content embeds verbatim, so encoding the rendered turn
# composes without changing the content's pinned ids (R1, U3-6 oracle).
@ public
fn render_user_turn(Tokenizer t, string content) → string ⇥ identity.TokenizerError {
    require t.chat_template.length() ≢ 0 throw variant identity.TokenizerError.BadArtifact { message = "artifact declares no chat template" }

    return "<|im_start|>user\n§<|im_end|>\n"(content)
}
