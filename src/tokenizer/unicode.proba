+++
locale = "en"
+++
# Co-located behavior tests for Unicode tokenizer scanners and spans.

import from "gradus:tokenizer/unicode" unicode

fn same_words(list<string> actual, list<string> expected) → bool {
    if actual.length() ≢ expected.length() then return false
    for range 0 ‥ actual.length() let index {
        if (actual.get(index) coalesce "") ≢ (expected.get(index) coalesce "") then return false
    }
    return true
}

fn words_or_failure(string text) → list<string> {
    do {
        return unicode.scan_words(text)
    }
    catch err {
        return ["failed"]
    }
}

fn smollm_words_or_failure(string text) → list<string> {
    do {
        return unicode.scan_smollm(text)
    }
    catch err {
        return ["failed"]
    }
}

describe "Unicode tokenizer behavior" {
    test "qwen scanner preserves empty and Unicode input" {
        assert same_words(words_or_failure(""), [])
        assert same_words(words_or_failure("a"), ["a"])
        assert same_words(words_or_failure("é"), ["é"])
        assert same_words(words_or_failure("😀"), ["😀"])
        assert same_words(words_or_failure("a\nb"), ["a", "\n", "b"])
    }

    test "smollm scanner preserves digit-separated spans" {
        assert same_words(smollm_words_or_failure("a1b"), ["a", "1", "b"])
    }

    test "find span returns character positions" {
        assert unicode.find_span("hello", "l", 0) ≡ 2
        assert unicode.find_span("hello", "l", 3) ≡ 3
        assert unicode.find_span("hello", "z", 0) ≡ -1
        assert unicode.find_span("hello", "", 0) ≡ -1
        assert unicode.find_span("hi", "hii", 0) ≡ -1
        assert unicode.find_span("hello", "o", 5) ≡ -1
        assert unicode.find_span("aé:c", ":", 0) ≡ 2
    }

    test "find span skips invalid negative candidate windows" {
        assert unicode.find_span("abc", "b", -5) ≡ 1
    }
}
