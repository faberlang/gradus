# Tokenizer identity contract — generic identity structure and wire.
#
# Public import: import from "gradus:tokenizer/identity" identity
# Prefer this leaf for TokenizerIdentity. The package facade is gradus:tokenizer.

const string schema_version = "2.0.0"

# -------------------------------------------------------------------------
# TokenizerError — typed error vocabulary of the tokenizer identity
# contract. Variant → class:
#   UnknownVersion       — unknown tokenizer identity schema version.
#   UnknownMergeKind    — malformed tokenizer merge-kind component.
#   UnknownPreTokenizer — malformed tokenizer pre-tokenizer component.
#   BadVocab      — vocab / merges / specials count mismatch.
#   BadDigest       — malformed vocabulary digest (not 64-hex).
#   BadEog            — malformed EOG set.
#   BadArtifact     — artifact tokenizer metadata is unavailable
#                        or malformed (LIB-02-U2 runtime).
#   BadMerges         — malformed merge entry in the artifact (U2).
#   UnknownId          — unknown token id in decode (out of range) (U2).
#   UnknownTrace   — display character with no byte mapping (U2).
#   BadUtf8           — byte sequence is not valid UTF-8 (U2).
#   BadWire           — malformed tokenizer identity wire form.
# -------------------------------------------------------------------------

@ public
union TokenizerError {
    @ shared
    string message

    UnknownVersion,
    UnknownMergeKind,
    UnknownPreTokenizer,
    BadVocab,
    BadDigest,
    BadEog,
    BadArtifact,
    BadMerges,
    UnknownId,
    UnknownTrace,
    BadUtf8,
    BadWire
}



# -------------------------------------------------------------------------
# TokenizerIdentity — the versioned tokenizer identity record. The
# field vocabulary mirrors the capsule's TokenizerIdentity (field 3) so
# the capsule can be built from this contract's values; the schema stamp
# makes the record versioned. Immutable — accessors only.
# -------------------------------------------------------------------------

@ public
class TokenizerIdentity {
    mut string schema
    mut string merge_kind
    mut string pre_tokenizer
    mut string vocab_digest
    mut string eog
    mut bool bos_free
    mut bool space_free
}

# -------------------------------------------------------------------------
# Private validation helpers. All return bool (predicates); construct and
# verify turn a falsum into the matching typed TokenizerError.
# -------------------------------------------------------------------------

# Hex-digit predicate for digest values.
fn is_hex(char c) → bool {
    return (c ≥ '0' and c ≤ '9') or (c ≥ 'a' and c ≤ 'f')
}

# Whole-digest predicate: exactly 64 lowercase hex characters.
fn hex_ok(string s) → bool {
    if s.length() ≢ 64 then return false
    for from s let c {
        if not is_hex(c) then return false
    }
    return true
}

# Wire components are non-empty and cannot introduce another path segment.
# Their contents remain caller-owned; this only protects the identity wire
# shape and keeps malformed records fail-closed.
fn component_ok(string s) → bool {
    return s.length() ≢ 0 and not s.contains("/")
}

# Digit predicate for the serialized EOG id list.
fn is_digit(char c) → bool {
    return c ≥ '0' and c ≤ '9'
}

# EOG-set WELL-FORMEDNESS predicate: comma-separated, non-empty, strictly
# ascending, non-negative integer token ids. The values remain caller-owned;
# this helper checks only the serialized shape and numeric ordering.
fn eog_ok(string eog) → bool {
    if eog.length() ≡ 0 then return false
    mut list<int> ids ← empty
    for from eog.split(",") let p {
        if p.length() ≡ 0 or p.length() ≻ 18 then return false
        for from p let digit {
            if not is_digit(digit) then return false
        }
        do {
            ids.append(p ↦ int)
        }
        catch err {
            return false
        }
    }
    let int n ← ids.length()
    for from ids[0 ‥ n - 1], ids[1 ‥ n] let before, after {
        if after ≤ before then return false
    }
    return true
}

# Parse one labeled boolean field from the identity wire. The label is part of
# the wire shape, so a swapped or unlabeled field fails closed rather than
# silently changing the caller's policy.
fn wire_bool(string raw, string label) → bool ⇥ TokenizerError {
    let list<string> parts ← raw.split("=")
    require parts.length() ≡ 2 throw variant BadWire { message = "malformed tokenizer identity boolean field" }
    require parts[0] ≡ label throw variant BadWire { message = "malformed tokenizer identity boolean field" }
    require parts[1] ≡ "true" or parts[1] ≡ "false" throw variant BadWire { message = "malformed tokenizer identity boolean field" }
    return parts[1] ≡ "true"
}

# -------------------------------------------------------------------------
# construct — the fail-closed tokenizer identity admission. Every caller
# field is checked for the structural shape required by the identity wire;
# the tokenizer family, pre-tokenizer, digest, EOG set, and policy flags are
# otherwise caller-owned. Schema version rejection comes first (§5: unknown
# schema → typed failure before use).
# -------------------------------------------------------------------------

@ public
fn construct(string schema, string merge_kind, string pre_tokenizer, string vocab_digest, string eog, bool bos_free, bool space_free) → TokenizerIdentity ⇥ TokenizerError {
    require schema ≡ schema_version throw variant UnknownVersion { message = "unknown tokenizer identity schema version: §"(schema) }
    require component_ok(merge_kind) throw variant UnknownMergeKind { message = "malformed tokenizer merge kind" }
    require component_ok(pre_tokenizer) throw variant UnknownPreTokenizer { message = "malformed pre-tokenizer" }
    require hex_ok(vocab_digest) throw variant BadDigest { message = "malformed vocabulary digest" }
    require eog_ok(eog) throw variant BadEog { message = "malformed EOG set" }
    return TokenizerIdentity { schema = schema, merge_kind = merge_kind, pre_tokenizer = pre_tokenizer, vocab_digest = vocab_digest, eog = eog, bos_free = bos_free, space_free = space_free }
}

# -------------------------------------------------------------------------
# verify — consumer-side self-verification (self-verifying contract). Re-
# runs the structural admission matrix over the identity without re-deriving
# raw artifact facts. An identity built by construct always passes; this is
# the defense-in-depth check for identities received across an owner boundary.
# -------------------------------------------------------------------------

@ public
fn verify(TokenizerIdentity t) → bool ⇥ TokenizerError {
    require t.schema ≡ schema_version throw variant UnknownVersion { message = "unknown tokenizer identity schema version: §"(t.schema) }
    require component_ok(t.merge_kind) throw variant UnknownMergeKind { message = "malformed tokenizer merge kind" }
    require component_ok(t.pre_tokenizer) throw variant UnknownPreTokenizer { message = "malformed pre-tokenizer" }
    require hex_ok(t.vocab_digest) throw variant BadDigest { message = "malformed vocabulary digest" }
    require eog_ok(t.eog) throw variant BadEog { message = "malformed EOG set" }
    return true
}

# -------------------------------------------------------------------------
# tokenizer_key — the tokenizer identity component of the KV block
# key (MD-A9 precedent). The KV key uses a collision-resistant digest over
# model bytes/version, execution configuration, tokenizer/chat-template
# and special-token policy, ... — this module owns the tokenizer identity
# component. The digest VALUE is computed by the host (no crypto in the
# language surface); this function renders the deterministic canonical
# component a host digests into the KV block key.
# -------------------------------------------------------------------------

@ public
fn tokenizer_key(TokenizerIdentity t) → string ⇥ TokenizerError {
    require verify(t) throw variant BadWire { message = "tokenizer identity failed verification" }
    return "tokenizer/identity/§/§/§/§/§/bos-free=§/space-prefix-free=§"(t.schema, t.merge_kind, t.pre_tokenizer, t.vocab_digest, t.eog, t.bos_free, t.space_free)
}

# -------------------------------------------------------------------------
# Identity wire form — the versioned tokenizer identity that crosses owner
# boundaries and participates in the KV identity key. Deserialization
# rejects an unknown schema version and malformed fields — fail closed,
# no best-effort partial reads (§5).
#   tokenizer/identity/<schema>/<kind>/<pre>/<vocab-digest>/<eog>/
#       bos-free=<bool>/space-prefix-free=<bool>
# -------------------------------------------------------------------------

@ public
fn serialize_identity(TokenizerIdentity t) → string ⇥ TokenizerError {
    require verify(t) throw variant BadWire { message = "tokenizer identity failed verification" }
    return "tokenizer/identity/§/§/§/§/§/bos-free=§/space-prefix-free=§"(t.schema, t.merge_kind, t.pre_tokenizer, t.vocab_digest, t.eog, t.bos_free, t.space_free)
}

@ public
fn deserialize_identity(string wire) → TokenizerIdentity ⇥ TokenizerError {
    let list<string> partes ← wire.split("/")
    require partes.length() ≡ 9 throw variant BadWire { message = "malformed tokenizer identity wire form" }
    require partes[0] ≡ "tokenizer" throw variant BadWire { message = "unknown tokenizer identity marker" }
    require partes[1] ≡ "identity" throw variant BadWire { message = "unknown tokenizer identity marker" }
    require partes[2] ≡ schema_version throw variant UnknownVersion { message = "unknown tokenizer identity schema version: §"(partes[2]) }
    let bool bos_free ← wire_bool(partes[7], "bos-free")
    let bool space_free ← wire_bool(partes[8], "space-prefix-free")
    return construct(partes[2], partes[3], partes[4], partes[5], partes[6], bos_free, space_free)
}
