# Tokenizer Unicode categories and pre-tokenizer scanners.
#
# Public import: import from "gradus:tokenizer/unicode" unicode
# Depends on: gradus:tokenizer/identity (TokenizerError).
#
# Text is walked as Unicode scalars: `text ↦ list<b32>` is the UTF-32 view of a
# string (one entry per character, never failable), and `↦ list<u32>` reads the
# same scalars as numbers for classification. A word is the bulk conversion of a
# scalar slice back to a string, so no UTF-8 is hand-encoded or hand-decoded.

import from "gradus:tokenizer/identity" identity

# --- Byte ↔ display-codepoint mapping (gpt2 convention) --------------------

# Byte value → display codepoint. Bytes in the printable/Latin-1 ranges map
# to themselves; the remaining 68 bytes map to 0x100+n in ascending byte
# order (0x00 → U+0100, 0x20 → U+0120, 0x7F → U+0121, …, 0xAD → U+0143).
fn code_from_byte(u8 byte) → int {
    if byte ≥ 33 and byte ≤ 126 then return byte
    if byte ≥ 161 and byte ≤ 172 then return byte
    if byte ≥ 174 and byte ≤ 255 then return byte
    if byte ≤ 32 then return 256 + byte
    if byte ≤ 160 then return byte + 162
    return 323
}

# Display codepoint → byte value (inverse mapping). Unmappable codepoints
# are malformed vocab content and fail closed.
fn byte_from_code(int cpt) → u8 ⇥ identity.TokenizerError {
    if cpt ≥ 33 and cpt ≤ 126 then return cpt
    if cpt ≥ 161 and cpt ≤ 172 then return cpt
    if cpt ≥ 174 and cpt ≤ 255 then return cpt
    if cpt ≥ 256 and cpt ≤ 288 then return cpt - 256
    if cpt ≥ 289 and cpt ≤ 322 then return cpt - 162
    if cpt ≡ 323 then return 173
    throw variant identity.TokenizerError.UnknownTrace { message = "display character has no byte mapping (codepoint §)"(cpt) }
}

# --- Codepoint ↔ text ---------------------------------------------------------

# The single-character text of one codepoint. The scalar range is checked
# first; a surrogate is in range but is not a character, so the conversion
# reports it as malformed text.
fn text_from_code(int cpt) → string ⇥ identity.TokenizerError {
    require cpt ≥ 0 throw variant identity.TokenizerError.BadWire { message = "negative codepoint" }
    reject cpt ≥ 1114112 throw variant identity.TokenizerError.BadWire { message = "codepoint exceeds the Unicode range" }
    do {
        let u32 scalar ← cpt ↦ u32
        let list<b32> one ← [scalar ↦ b32]
        return one ↦ string
    }
    catch err {
        throw variant identity.TokenizerError.BadUtf8 { message = "display character bytes are not valid UTF-8" }
    }
}

# The codepoint of a one-character text.
fn code_from_trace(string c) → int ⇥ identity.TokenizerError {
    let list<u32> scalars ← c ↦ list<b32> ↦ list<u32>
    require scalars.length() ≡ 1 throw variant identity.TokenizerError.UnknownTrace { message = "malformed display character" }
    return scalars[0] ↦ int
}

# One display character (the byte-level BPE symbol for a single source byte).
@ public
fn trace_from_byte(u8 byte) → string ⇥ identity.TokenizerError {
    return text_from_code(code_from_byte(byte))
}

# The source byte of one display character (inverse of `trace_from_byte`).
@ public
fn byte_from_trace(string c) → u8 ⇥ identity.TokenizerError {
    return byte_from_code(code_from_trace(c))
}

# -------------------------------------------------------------------------
# Unicode-category predicates (LIB-02-U3-1, GGUF-A2).
#
# The qwen35 pre-tokenizer regex (llama-vocab.cpp LLAMA_VOCAB_PRE_TYPE_QWEN35)
# needs the character classes \p{L} (letter), \p{M} (mark), \p{N} (number),
# \s (whitespace) and the explicit CR/LF newlines. Fab has no regex engine
# and no Unicode general-category tables in the language surface, so the
# bounded-category scanner (delivery open question 1 default) expresses each
# class as deterministic codepoint ranges covering the classes the two probes
# and the differential rows exercise. Classification runs on RAW input
# codepoints — the pre-tokenizer matches the input text before the
# byte-level BPE display mapping (a raw space is U+0020, not the display
# "Ġ" U+0120). A malformed character has no category and falls to Other —
# the same closed behavior as the reference regex leaving unmatched bytes
# to the [^\s\p{L}\p{M}\p{N}] alternative.
# -------------------------------------------------------------------------

# Scanner-relevant Unicode general categories. \p{L}/\p{M}/\p{N} come
# straight from the regex; \s is split into the explicit CR/LF newlines
# (the [\r\n] alternations) and the remaining ASCII whitespace, matching
# how the qwen35 pattern consumes each.
@ public
union UnicodeCategory {
    Letter,
    Signum,
    Number,
    Space,
    Newline,
    Other
}

# Inclusive range membership.
fn within(u32 cpt, int lo, int hi) → bool {
    return cpt ≥ lo and cpt ≤ hi
}

# \p{L} — Basic Latin + Latin-1 Supplement letters, the Thai block letters
# (consonants and the sara vowels, all Lo/Lm), and the CJK Unified Ideographs.
fn letter_code(u32 cpt) → bool {
    return within(cpt, 65, 90) or within(cpt, 97, 122) or within(cpt, 192, 214) or within(cpt, 216, 246) or within(cpt, 248, 255) or within(cpt, 3585, 3632) or within(cpt, 3634, 3635) or within(cpt, 3648, 3654) or within(cpt, 19968, 40959)
}

# \p{M} — the Thai vowel/tone signs (mai han-akat U+0E31, the sara i..phinthu
# signs U+0E34..U+0E3A, lakkhangyao U+0E45, and the tone marks U+0E47..U+0E4E),
# all Mn/Me.
fn symbol_code(u32 cpt) → bool {
    return cpt ≡ 3633 or within(cpt, 3636, 3642) or cpt ≡ 3653 or within(cpt, 3655, 3662)
}

# \p{N} — the ASCII digits plus the Thai digits of the same block.
fn number_code(u32 cpt) → bool {
    return within(cpt, 48, 57) or within(cpt, 3664, 3673)
}

# \s minus CR/LF — the ASCII whitespace the regex's \s+ / [^\s...] and
# leading- \ ? arms consume.
fn space_code(u32 cpt) → bool {
    return cpt ≡ 9 or within(cpt, 11, 12) or cpt ≡ 32
}

# The explicit CR/LF newlines of the [\r\n] alternations.
fn newline_code(u32 cpt) → bool {
    return cpt ≡ 10 or cpt ≡ 13
}

# The reference's \s carries both ordinary whitespace and CR/LF.
fn blank_code(u32 cpt) → bool {
    return space_code(cpt) or newline_code(cpt)
}

# The reference's [^\s\p{L}\p{M}\p{N}] — a character no family class
# matches (the punct/emoji/other run class, bounded ranges).
fn other_code(u32 cpt) → bool {
    return not (letter_code(cpt) or symbol_code(cpt) or number_code(cpt) or blank_code(cpt))
}

# [\p{L}\p{M}] — the letter/mark run class.
fn word_code(u32 cpt) → bool {
    return letter_code(cpt) or symbol_code(cpt)
}

fn category_of(u32 cpt) → UnicodeCategory {
    if letter_code(cpt) then return Letter
    if symbol_code(cpt) then return Signum
    if number_code(cpt) then return Number
    if space_code(cpt) then return Space
    if newline_code(cpt) then return Newline
    return Other
}

# Classify one character into the scanner-relevant category. Text that is not
# exactly one character has no category and falls to Other.
@ public
fn category(string c) → UnicodeCategory {
    let list<u32> scalars ← c ↦ list<b32> ↦ list<u32>
    if scalars.length() ≢ 1 then return Other
    return category_of(scalars[0])
}

# Category predicates (the \p{L}..[\r\n] classes the scanner composes).
@ public
fn is_letter(string c) → bool {
    return category(c) ≡ Letter
}

@ public
fn is_symbol(string c) → bool {
    return category(c) ≡ Signum
}

@ public
fn is_number(string c) → bool {
    return category(c) ≡ Number
}

@ public
fn is_space(string c) → bool {
    return category(c) ≡ Space
}

@ public
fn is_newline(string c) → bool {
    return category(c) ≡ Newline
}

@ public
fn is_other(string c) → bool {
    return category(c) ≡ Other
}

# Canonical category name for an enum value (internal name mapping).
fn category_enum_name(UnicodeCategory c) → string {
    match c {
        case Letter {
            return "littera"
        }
        case Signum {
            return "signum"
        }
        case Number {
            return "numerus"
        }
        case Space {
            return "spatium"
        }
        case Newline {
            return "novum_linea"
        }
        case Other {
            return "aliud"
        }
    }
}

# Canonical category name for one character (the proof/consumer text
# seam — text → text, no nominal types in the signature).
@ public
fn category_name(string c) → string {
    return category_enum_name(category(c))
}

# -------------------------------------------------------------------------
# qwen35 word-splitting scanner (LIB-02-U3-2 core families + LIB-02-U3-3
# edge families).
#
# The deterministic pre-tokenizer splits a raw prompt into words before the
# byte-level BPE core, mirroring llama.cpp's custom qwen35 scanner
# (unicode.cpp unicode_regex_split_custom_qwen35; llama-vocab.cpp
# LLAMA_VOCAB_PRE_TYPE_QWEN35; pinned oracle 10150 `dee2a846b`). The full
# qwen35 pattern is:
#   (?i:'s|'t|'re|'ve|'m|'ll|'d)
#   | [^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+
#   | \p{N}
#   | ?[^\s\p{L}\p{M}\p{N}]+[\r\n]*
#   | \s*[\r\n]+ | \s+(?!\S) | \s+
# The arms apply in that order (alternation order):
#   * the contraction family ('s/'t/'re/'ve/'m/'ll/'d, case-insensitive —
#     the reference lowercases the following letter),
#   * letter/mark runs with one optional leading non-CR/LF/number char
#     ([^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+),
#   * single numbers (\p{N}),
#   * punctuation/emoji/other runs with one optional leading literal space
#     and trailing CR/LF runs (?[^\s\p{L}\p{M}\p{N}]+[\r\n]*),
#   * whitespace runs (\s+ and the \s+(?!\S) trailing-run form) and newline
#     runs (\s*[\r\n]+).
# A character no family matches falls through to a single-character word
# (the reference's "no matches" arm).
#
# Reference semantics mirrored exactly:
#   * the contraction arm runs FIRST, so a "'t" following a word splits as
#     its own word ("don'ts" → "don" | "'t" | "s", not "don" | "'ts"),
#   * a letter/mark word absorbs ONE leading non-CR/LF/number char, so a
#     space or tab before a letter-run joins the word (" 你好" → one word,
#     "!hello" → one word),
#   * each digit is its own word,
#   * an "other" run takes one optional leading U+0020 and all trailing
#     CR/LF ("hello, world!" → "hello" | "," | " world" | "!", "a,!\n" →
#     "a" | ",!\n"), so a space-before-other joins the other-run ("x  ," →
#     "x" | " " | " ,"),
#   * a whitespace run of 2+ followed by a character emits all-but-one
#     whitespace as a word, leaving the last one for the next word,
#   * a whitespace run containing CR/LF consumes through the LAST CR/LF.
# Classification uses the bounded codepoint ranges above (ASCII whitespace
# only; the full Unicode White_Space property is a documented boundary).
#
# Each scanner is a cursor over the scalar list. The token end is a pure
# function of the cursor (`qwen_token_end`, `gpt2_token_end`), and the cursor
# jumps to it: the step depends on the text, so the cursor loop is a `while`.
# -------------------------------------------------------------------------

# The index where a run of `keep` scalars that starts at `from` ends, or `to`
# when the run reaches it. `from` never exceeds `to`.
fn run_end(list<u32> cps, int from, int to, (u32) → bool keep) → int {
    for range from ‥ to let i {
        if not keep(cps[i]) then return i
    }
    return to
}

# Codepoint range → the exact source slice.
fn piece(list<b32> raw, int lo, int hi) → string ⇥ identity.TokenizerError {
    do {
        return raw[lo ‥ hi] ↦ string
    }
    catch err {
        throw variant identity.TokenizerError.BadUtf8 { message = "scanner span is not valid text" }
    }
}

# ASCII lowercasing for the contraction arm — the reference matches the
# qwen35 contraction letters case-insensitively via unicode_tolower; only
# the ASCII letters s/t/r/v/m/l/d/e are in the pattern's sets.
fn small_code(u32 cpt) → u32 {
    return within(cpt, 65, 90) ✓ cpt + 32 ✗ cpt
}

# Length of the contraction ('s 't 'm 'd, 're 've 'll) that starts at `pos`
# inside [.., hi), or 0 when none starts there. `fold` lowercases the letters
# first (the case-insensitive qwen35 arm); gpt2 contractions are lowercase only.
fn contraction_len(list<u32> cps, int pos, int hi, bool fold) → int {
    if cps[pos] ≢ 39 or pos + 1 ≥ hi then return 0
    let u32 prox ← fold ✓ small_code(cps[pos + 1]) ✗ cps[pos + 1]
    if prox ≡ 115 or prox ≡ 116 or prox ≡ 109 or prox ≡ 100 then return 2
    if pos + 2 ≥ hi then return 0
    let u32 prox2 ← fold ✓ small_code(cps[pos + 2]) ✗ cps[pos + 2]
    if (prox ≡ 114 and prox2 ≡ 101) or (prox ≡ 118 and prox2 ≡ 101) or (prox ≡ 108 and prox2 ≡ 108) then return 3
    return 0
}

# End of the whitespace-family word that starts at `pos` (a blank run).
# \s*[\r\n]+ consumes through the last CR/LF of the run; \s+(?!\S) keeps the
# last whitespace of a run of 2+ that is followed by a character for the next
# word; \s+ takes a plain run to its end.
fn blank_token_end(list<u32> cps, int pos, int hi) → int {
    let int run ← run_end(cps, pos, hi, blank_code)
    for range run - 1 ‥ pos - 1 let j {
        if newline_code(cps[j]) then return j + 1
    }
    if run - pos ≻ 1 and run ≺ hi then return run - 1
    return run
}

# End of the qwen35 word that starts at `pos`, scanning inside [pos, n).
fn qwen_token_end(list<u32> cps, int pos, int n) → int {
    let u32 cpt ← cps[pos]
    # (?i:'s|'t|'re|'ve|'m|'ll|'d) — the contraction family. The reference
    # matches FIRST, lowercasing the following letter(s): a 2-character word
    # "'x" for s/t/m/d, a 3-character word "'xy" for re/ve/ll.
    let int contraction ← contraction_len(cps, pos, n, true)
    if contraction ≻ 0 then return pos + contraction
    # [^\r\n\p{L}\p{N}]?[\p{L}\p{M}]+ — letter/mark run with one optional
    # leading non-CR/LF/number char.
    if cpt ≢ 10 and cpt ≢ 13 and not number_code(cpt) {
        let bool word_follows ← pos + 1 ≺ n and word_code(cps[pos + 1])
        if word_code(cpt) or word_follows then return run_end(cps, pos + 1, n, word_code)
    }
    # \p{N} — one digit per word.
    if number_code(cpt) then return pos + 1
    # ?[^\s\p{L}\p{M}\p{N}]+[\r\n]* — punctuation/emoji/other run. An
    # optional leading literal space (U+0020) joins the run when the following
    # character is "other" (or the space is trailing at the segment end — the
    # reference's out-of-range next flags are "not whitespace/letter/mark/
    # number"), then the other-run, then all trailing CR/LF ("x  ," → "x" | " "
    # | " ,"; "a,!\n" → "a" | ",!\n").
    let bool opens_other ← cpt ≡ 32 ✓ (pos + 1 ≥ n or other_code(cps[pos + 1])) ✗ other_code(cpt)
    if opens_other {
        let int body ← cpt ≡ 32 ✓ pos + 1 ✗ pos
        return run_end(cps, run_end(cps, body, n, other_code), n, newline_code)
    }
    # \s family — the whitespace run. The reference's "no matches" arm (a
    # single-character word) is the safety net: every class above matches a
    # family, so a non-blank character never reaches it.
    if blank_code(cpt) then return blank_token_end(cps, pos, n)
    return pos + 1
}

# Split a raw prompt into words exactly like the pinned qwen35 scanner's
# core families. Each returned word is a slice of the input text; the U2
# word-level BPE core consumes one word at a time.
@ public
fn scan_words(string text) → list<string> ⇥ identity.TokenizerError {
    let list<b32> raw ← text ↦ list<b32>
    let list<u32> cps ← raw ↦ list<u32>
    let int n ← cps.length()
    mut list<string> words ← empty
    mut int pos ← 0
    while pos ≺ n {
        let int end ← qwen_token_end(cps, pos, n)
        words.append(piece(raw, pos, end))
        pos ← end
    }
    return words
}

# SMOLLM pre-tokenizer (llama-vocab.cpp LLAMA_VOCAB_PRE_TYPE_SMOLLM):
# first isolate each `\p{N}` digit, then run the GPT-2 custom scanner on
# every remaining span (`'s|'t|'re|'ve|'m|'ll|'d| ?\p{L}+| ?\p{N}+|
# ?[^\s\p{L}\p{N}]+|\s+(?!\S)`). P1–P11 are ASCII and exercise the
# letter / other / whitespace arms; digit isolation is the SMOLLM
# difference from a bare GPT-2 pre.
@ public
fn scan_smollm(string text) → list<string> ⇥ identity.TokenizerError {
    let list<b32> raw ← text ↦ list<b32>
    let list<u32> cps ← raw ↦ list<u32>
    mut list<string> words ← empty
    mut int span_start ← 0
    for from cps at [i] let cpt {
        if number_code(cpt) {
            words.extend(scan_gpt2_span(raw, cps, span_start, i))
            words.append(piece(raw, i, i + 1))
            span_start ← i + 1
        }
    }
    words.extend(scan_gpt2_span(raw, cps, span_start, cps.length()))
    return words
}

# End of the gpt2 word that starts at `pos`, scanning inside [pos, hi).
# Contractions are case-sensitive lowercase; an optional leading U+0020 joins
# a following letter / number / other run; a 2+ whitespace run followed by
# more text emits all-but-last (add_space_prefix = false — P11).
fn gpt2_token_end(list<u32> cps, int pos, int hi) → int {
    let u32 cpt ← cps[pos]
    let int contraction ← contraction_len(cps, pos, hi, false)
    if contraction ≻ 0 then return pos + contraction
    # c2 is the character the run class tests: the one after a leading space.
    if cpt ≢ 32 or pos + 1 ≺ hi {
        let u32 c2 ← cpt ≡ 32 ✓ cps[pos + 1] ✗ cpt
        let int body ← cpt ≡ 32 ✓ pos + 1 ✗ pos
        if letter_code(c2) then return run_end(cps, body, hi, letter_code)
        if number_code(c2) then return run_end(cps, body, hi, number_code)
        if other_code(c2) then return run_end(cps, body, hi, other_code)
    }
    let int run ← run_end(cps, pos, hi, blank_code)
    if run - pos ≻ 1 and run ≺ hi then return run - 1
    if run ≻ pos then return run
    return pos + 1
}

# GPT-2 custom scanner on one [lo, hi) codepoint span (unicode.cpp
# unicode_regex_split_custom_gpt2).
fn scan_gpt2_span(list<b32> raw, list<u32> cps, int lo, int hi) → list<string> ⇥ identity.TokenizerError {
    mut list<string> words ← empty
    mut int pos ← lo
    while pos ≺ hi {
        let int end ← gpt2_token_end(cps, pos, hi)
        words.append(piece(raw, pos, end))
        pos ← end
    }
    return words
}

# First occurrence of `quid` in `ubi` at or after `ab` (character indices),
# or none when absent (or when `ab` is outside the text) — the reference's
# std::string::find.
@ public
fn find_span(string ubi, string quid, int ab) → int ∪ none {
    let list<b32> hay ← ubi ↦ list<b32>
    let list<b32> needle ← quid ↦ list<b32>
    let int n ← hay.length()
    let int m ← needle.length()
    if m ≡ 0 or ab ≺ 0 or ab + m ≻ n then return null
    for range ab … n - m let i {
        if hay[i ‥ i + m] ≡ needle then return i
    }
    return null
}
