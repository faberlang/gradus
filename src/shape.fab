# Shape system — PML1-U3 (production shape representation and rules).
#
# Public import: importa ex "gradus:shape" privata forma
# Depends on: nothing — leaf module. Pure shape rules over the staged
# dimension-vector representation `lista<numerus>`.
#
# --- Posture decision (PML1-U3, R1 recheck — named boundary) --------------
#
# The shape representation is the STAGED carrier: a runtime dimension vector
# inside the value carrier (Tensor.forma, U1), with the static shape pinned
# by the consumer at materialization (`tensor<f32, [2,2]>` conversio). This
# decision is recorded here as the PML1-U3 posture decision.
#
# Compiler evidence (probed 2026-08-08 against the live compiler; see also
# the tensor.fab U1 header note):
#   * generic shape genus (`genus Tensor<magnitudo F>`) — type-argument
#     application `Tensor<[2,2]>` is PARSE001 today (generic type-args do
#     not parse);
#   * shape-hole `tensor<f32, _>` genus fields and return types fed by
#     runtime-shape construction are SEM014 cannot_infer_tensor_shape in
#     standalone library context (no call site to unify the hole);
#   * the staged carrier compiles in library context today (U1 green) and
#     keeps the static shape a compile-time fact at the boundary.
#
# Generated-admitted shapes (a closed enumeration of static shape types) are
# NOT the public posture: Council R3 forbids one-row/one-shape narrowing from
# hard-coding into the public API shape. Shape rules here stay generic over
# dimension vectors and admit support rows, not hard-coded [2,2]/[4,4]/[2,8]
# types (the fixed-shape enumeration stays a load-time support-matrix fact).
#
# Packet impact (pml0-interface-packet.md): the §3 shape facts (compile-time
# class — shapes are static facts at the boundary, carried in the compiled
# program and the frozen static surface) are UNCHANGED. The runtime list is
# the value-carrier representation; the boundary still carries static
# `tensor<f32, [2,2]>` types, so no packet revision is proposed.
#
# --- Bounds and ceilings (two classes; CTO-2 correction, PML1 closeout) ----
#
# General checked shape arithmetic (what the rules below enforce):
#   * every dimension must be non-negative — DimensioNegativa;
#   * total element ceiling 1_000_000_000, checked before every product step
#     so i64 overflow is unreachable and no allocation is sized above the
#     ceiling — ProductumSupraLimitem;
#   * rank ceiling 64 for expand (no unbounded dimension-vector growth) —
#     GradusMismatch.
# General arithmetic places NO per-dimension cap: a single dimension may
# exceed 65536 (a 128k–152k-vocab embedding/row shape stays expressible —
# CTO-2 note, recorded at PML1 closeout). The per-dimension 65536 is a
# support-row/capsule ceiling, not a general math limit.
#
# Support-row/capsule ceiling (separate from general arithmetic):
#   * DIMENSI_LIMES 65536 is the GI1 pinned-row ceiling (dims ≤ 65536 in the
#     admitted-model capsule, pml0-model-capsule-contract.md §5 row 5). It is
#     applied at capsule/support-row admission (PML2), NOT by general shape
#     arithmetic — general math must not exclude 128k–152k-vocab shapes.
#     DimensioSupraLimitem is that admission path's typed error identity.
#
# --- Rules ----------------------------------------------------------------
#
#   * valet — non-failable consistency predicate (all dims non-negative).
#   * gradus — rank.
#   * quantitas — bounded element product (scalar shape [] → 1).
#   * broadcastum — right-aligned pairwise broadcast; a dimension of 1
#     broadcasts to any size; any other mismatch fails closed.
#   * reformanda — reshape: element count preserved; a single -1 sentinel
#     infers the missing dimension (must divide evenly).
#   * expansio — expand: left-pad singleton dimensions to a target rank.
#
# Error identity: every rule fails closed with a distinct FormaError variant
# carrying a textus causa (render via forma.causa).

# Ceilings. DIMENSI_LIMES is the support-row/capsule ceiling (GI1 pinned
# row), NOT a general math limit — general shape arithmetic checks only
# ELEMENTA_LIMES (bounded product) and GRADUS_LIMES (rank); a dimension may
# legally exceed 65536 (e.g. a 152064-wide vocab row). DIMENSI_LIMES is
# documented here for the PML2 capsule/support-row admission path and
# adjusted only via a named contract change.
fixum numerus DIMENSI_LIMES ← 65536
fixum numerus ELEMENTA_LIMES ← 1000000000
fixum numerus GRADUS_LIMES ← 64

# FormaError — typed error vocabulary of the shape rules. Every variant
# carries a textus causa so consumers can render the failure without matching
# each variant.
discretio FormaError {
    DimensioNegativa { textus causa },
    DimensioSupraLimitem { textus causa },
    ProductumSupraLimitem { textus causa },
    Incompatibilis { textus causa },
    ElementaMismatch { textus causa },
    GradusMismatch { textus causa }
}

# Error rendering — mirror of tensor.causa.
functio causa(FormaError e) → textus {
    discerne e {
        casu DimensioNegativa fixum causa { redde causa }
        casu DimensioSupraLimitem fixum causa { redde causa }
        casu ProductumSupraLimitem fixum causa { redde causa }
        casu Incompatibilis fixum causa { redde causa }
        casu ElementaMismatch fixum causa { redde causa }
        casu GradusMismatch fixum causa { redde causa }
    }
}

# Consistency predicate: every dimension non-negative. Non-failable by design
# (mirror of tensor.valet).
functio valet(lista<numerus> forma) → bivalens {
    itera ex forma fixum dim {
        si dim < 0 ergo redde falsum
    }
    redde verum
}

# Rank (number of dimensions).
functio gradus(lista<numerus> forma) → numerus {
    redde forma.longitudo()
}

# Bounded element product. Fails closed on negative dims and on any ceiling
# violation before the product is usable to size an allocation. No
# per-dimension cap: a dimension may exceed 65536 (128k–152k vocab rows);
# the element ceiling below is the general math limit.
@ privata
functio _productus(lista<numerus> forma) → numerus ⇥ FormaError {
    varia numerus product ← 1
    itera ex forma fixum dim {
        si dim < 0 {
            iace finge DimensioNegativa { causa = "negative dimension" }
        }
        si dim > 0 {
            si product > ELEMENTA_LIMES / dim {
                iace finge ProductumSupraLimitem { causa = "element count above ceiling" }
            }
            product ← product * dim
        }
        secus {
            product ← 0
        }
    }
    redde product
}

# Public bounded product (scalar shape [] → 1). Gate for any allocation
# sized by an element count.
functio quantitas(lista<numerus> forma) → numerus ⇥ FormaError {
    redde _productus(forma)
}

# i-th dimension counted from the right, exposed left-indexed. Missing
# leading dimensions (right alignment) read as singleton 1.
@ privata
functio _dimensio(lista<numerus> forma, numerus max, numerus i) → numerus {
    fixum numerus l ← forma.longitudo()
    si i < max - l {
        redde 1
    }
    secus {
        redde forma.accipe(i - (max - l)) vel 1
    }
}

# Broadcast — right-aligned pairwise rule: each result dimension is the max
# of the two operand dimensions, where a singleton 1 broadcasts to any size.
# Any other mismatch fails closed. Result shape is ceiling-validated.
functio broadcastum(lista<numerus> a, lista<numerus> b) → lista<numerus> ⇥ FormaError {
    itera ex a fixum dim {
        si dim < 0 {
            iace finge DimensioNegativa { causa = "negative dimension" }
        }
    }
    itera ex b fixum dim {
        si dim < 0 {
            iace finge DimensioNegativa { causa = "negative dimension" }
        }
    }
    fixum numerus la ← a.longitudo()
    fixum numerus lb ← b.longitudo()
    varia numerus max ← la
    si lb > max ergo max ← lb
    varia lista<numerus> result ← vacua
    varia numerus i ← 0
    dum i < max {
        fixum numerus da ← _dimensio(a, max, i)
        fixum numerus db ← _dimensio(b, max, i)
        si da ≠ 1 aut db ≠ 1 {
            si da ≠ db {
                iace finge Incompatibilis { causa = "shapes not broadcastable" }
            }
        }
        varia numerus rd ← da
        si db > da ergo rd ← db
        result.appende(rd)
        i ← i + 1
    }
    # Element-count ceiling on the result shape (checked before use).
    varia numerus product ← 1
    itera ex result fixum dim {
        si dim > 0 {
            si product > ELEMENTA_LIMES / dim {
                iace finge ProductumSupraLimitem { causa = "element count above ceiling" }
            }
            product ← product * dim
        }
        secus {
            product ← 0
        }
    }
    redde result
}

# Reshape — element-count-preserving rule. A single -1 sentinel infers the
# missing dimension (must divide evenly); more than one -1 is rejected.
# The resolved shape is always ceiling-validated.
functio reformanda(lista<numerus> forma, lista<numerus> novus) → lista<numerus> ⇥ FormaError {
    fixum numerus total ← _productus(forma)
    varia numerus unknown ← 0
    varia numerus concrete ← 1
    varia numerus i ← 0
    dum i < novus.longitudo() {
        fixum numerus dim ← novus.accipe(i) vel 1
        si dim ≡ -1 {
            unknown ← unknown + 1
        }
        secus {
            si dim < 0 {
                iace finge DimensioNegativa { causa = "negative dimension" }
            }
            si dim > 0 {
                si concrete > ELEMENTA_LIMES / dim {
                    iace finge ProductumSupraLimitem { causa = "element count above ceiling" }
                }
                concrete ← concrete * dim
            }
            secus {
                concrete ← 0
            }
        }
        i ← i + 1
    }
    si unknown > 1 {
        iace finge ElementaMismatch { causa = "at most one inferred dimension" }
    }
    varia lista<numerus> result ← vacua
    varia numerus j ← 0
    dum j < novus.longitudo() {
        fixum numerus dim ← novus.accipe(j) vel 1
        si dim ≡ -1 {
            si concrete ≡ 0 {
                iace finge ElementaMismatch { causa = "inferred dimension not resolvable" }
            }
            si total % concrete ≠ 0 {
                iace finge ElementaMismatch { causa = "inferred dimension not integral" }
            }
            result.appende(total / concrete)
        }
        secus {
            result.appende(dim)
        }
        j ← j + 1
    }
    # Validate the resolved shape (ceilings) and, without a sentinel,
    # element-count preservation.
    fixum numerus nuevo ← _productus(result)
    si unknown ≡ 0 et nuevo ≠ total {
        iace finge ElementaMismatch { causa = "element count mismatch" }
    }
    redde result
}

# Expand — left-pad singleton dimensions to reach a target rank. Rejects a
# target rank below the current rank and any rank above the rank ceiling.
functio expansio(lista<numerus> forma, numerus ad_gradum) → lista<numerus> ⇥ FormaError {
    itera ex forma fixum dim {
        si dim < 0 {
            iace finge DimensioNegativa { causa = "negative dimension" }
        }
    }
    fixum numerus l ← forma.longitudo()
    si ad_gradum < l {
        iace finge GradusMismatch { causa = "target rank below current rank" }
    }
    si ad_gradum > GRADUS_LIMES {
        iace finge GradusMismatch { causa = "target rank above ceiling" }
    }
    varia lista<numerus> result ← vacua
    varia numerus i ← 0
    dum i < ad_gradum - l {
        result.appende(1)
        i ← i + 1
    }
    varia numerus j ← 0
    dum j < l {
        result.appende(forma.accipe(j) vel 1)
        j ← j + 1
    }
    redde result
}
