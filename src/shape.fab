# Shape system — PML1-U3 (production shape representation and rules).
#
# Public import: import from "gradus:shape" shape
# Depends on: nothing — leaf module. Pure shape rules over the staged
# dimension-vector representation `list<int>`.
#
# --- Posture decision (PML1-U3, R1 recheck — named boundary) -------------
#
# The shape representation is the STAGED carrier: a runtime dimension vector
# inside the value carrier (NumericBlock.shape, U1), with the static shape pinned
# by the consumer at materialization (`tensor<f32, [2,2]>` conversion). This
# decision is recorded here as the PML1-U3 posture decision.
#
# Compiler evidence (probed 2026-08-08 against the live compiler; see also
# the tensor.fab U1 header note):
#   * generic shape genus (`genus NumericBlock<magnitudo F>`) — type-argument
#     application `NumericBlock<[2,2]>` is PARSE001 today (generic type-args do
#     not parse);
#   * shape-hole `tensor<f32, _>` genus fields and return types fed by
#     runtime-shape construction are SEM014 cannot_infer_tensor_shape in
#     standalone library context (no call site to unify the hole);
#   * the staged carrier compiles in library context today (U1 green) and
#     keeps the static shape a compile-time fact at the boundary.
#
# Generated-admitted shapes (a closed enumeration of static shape types) are
# NOT the public posture: Council R3 forbids one-row/one-shape narrowing from
# hard-coding into the public API shape. Shape rules here stay generic over
# dimension vectors and admit support rows, not hard-coded [2,2]/[4,4]/[2,8]
# types (the fixed-shape enumeration stays a load-time support-matrix fact).
#
# Packet impact (pml0-interface-packet.md): the §3 shape facts (compile-time
# class — shapes are static facts at the boundary, carried in the compiled
# program and the frozen static surface) are UNCHANGED. The runtime list is
# the value-carrier representation; the boundary still carries static
# `tensor<f32, [2,2]>` types, so no packet revision is proposed.
#
# --- Bounds and ceilings (two classes; CTO-2 correction, PML1 closeout) --
#
# General checked shape arithmetic (what the rules below enforce):
#   * every dimension must be non-negative — NegativeDimension;
#   * total element ceiling 1_000_000_000, checked before every product step
#     so i64 overflow is unreachable and no allocation is sized above the
#     ceiling — ProductAboveLimit;
#   * rank ceiling 64 for expand (no unbounded dimension-vector growth) —
#     GradusMismatch.
# General arithmetic places NO per-dimension cap: a single dimension may
# exceed 65536 (a 128k–152k-vocab embedding/row shape stays expressible —
# CTO-2 note, recorded at PML1 closeout). The per-dimension 65536 is a
# support-row/capsule ceiling, not a general math limit.
#
# Support-row/capsule ceiling (separate from general arithmetic):
#   * DIMENSION_LIMIT 65536 is the GI1 pinned-row ceiling (dims ≤ 65536 in the
#     admitted-model capsule, pml0-model-capsule-contract.md §5 row 5). It is
#     applied at capsule/support-row admission (PML2), NOT by general shape
#     arithmetic — general math must not exclude 128k–152k-vocab shapes.
#     DimensionAboveLimit is that admission path's typed error identity.
#
# --- Rules ---------------------------------------------------------------
#
#   * valid — non-failable consistency predicate (all dims non-negative).
#   * rank — rank.
#   * numel — bounded element product (scalar shape [] → 1).
#   * broadcast — right-aligned pairwise broadcast; a dimension of 1
#     broadcasts to any size; any other mismatch fails closed.
#   * reshape — reshape: element count preserved; a single -1 sentinel
#     infers the missing dimension (must divide evenly).
#   * expand — expand: left-pad singleton dimensions to a target rank.
#
# Error identity: every rule fails closed with a distinct ShapeError variant
# carrying a text message (exposed as the shared `message`).

# --- Ceilings ------------------------------------------------------------
# DIMENSION_LIMIT is the support-row/capsule ceiling (GI1 pinned row), NOT a
# general math limit — general shape arithmetic checks only ELEMENTS_LIMIT
# (bounded product) and RANK_LIMIT (rank); a dimension may legally exceed
# 65536 (e.g. a 152064-wide vocab row). DIMENSION_LIMIT is documented here
# for the PML2 capsule/support-row admission path and adjusted only via a
# named contract change.
const int DIMENSION_LIMIT ← 65536

const int ELEMENTS_LIMIT ← 1000000000

const int RANK_LIMIT ← 64

# --- ShapeError ----------------------------------------------------------
# Typed error vocabulary of the shape rules. Every variant carries a text
# message so consumers can render the failure without matching each variant.
@ public
union ShapeError {
    @ shared
    string message

    NegativeDimension,
    DimensionAboveLimit,
    ProductAboveLimit,
    Incompatible,
    ElementMismatch,
    GradusMismatch
}

# --- Queries and product -------------------------------------------------
# Consistency predicate: every dimension non-negative. Non-failable by design
# (mirror of tensor.valid).
@ public
fn valid(list<int> shape) → bool {
    return shape.all(int d ∴ d ≥ 0)
}

# Rank (number of dimensions).
@ public
fn rank(list<int> shape) → int {
    return shape.length()
}

# Bounded element product. Fails closed on negative dims and on any ceiling
# violation before the product is usable to size an allocation. No
# per-dimension cap: a dimension may exceed 65536 (128k–152k vocab rows);
# the element ceiling below is the general math limit.
fn _product(list<int> shape) → int ⇥ ShapeError {
    require shape.all(int d ∴ d ≥ 0) throw variant NegativeDimension { message = "negative dimension" }
    var int product ← 1
    for from shape const dim {
        if dim ≻ 0 {
            require product ≤ ELEMENTS_LIMIT / dim throw variant ProductAboveLimit { message = "element count above ceiling" }
            product ← product * dim
        }
        else {
            product ← 0
        }
    }
    return product
}

# Public bounded product (scalar shape [] → 1). Gate for any allocation
# sized by an element count.
@ public
fn numel(list<int> shape) → int ⇥ ShapeError {
    return _product(shape)
}

# i-th dimension counted from the right, exposed left-indexed. Missing
# leading dimensions (right alignment) read as singleton 1.
fn _dimension(list<int> shape, int max, int i) → int {
    const int l ← shape.length()
    if i ≺ max - l then return 1
    else then return shape.get(i - (max - l)) coalesce 1
}

# --- Broadcast -----------------------------------------------------------
# Right-aligned pairwise rule: each result dimension is the max of the two
# operand dimensions, where a singleton 1 broadcasts to any size. Any other
# mismatch fails closed. Result shape is ceiling-validated.
@ public
fn broadcast(list<int> a, list<int> b) → list<int> ⇥ ShapeError {
    require a.all(int d ∴ d ≥ 0) throw variant NegativeDimension { message = "negative dimension" }
    require b.all(int d ∴ d ≥ 0) throw variant NegativeDimension { message = "negative dimension" }
    const int la ← a.length()
    const int lb ← b.length()
    const int max ← la ⤒ lb
    var list<int> result ← empty
    for range 0 ‥ max const i {
        const int da ← _dimension(a, max, i)
        const int db ← _dimension(b, max, i)
        # Implicit leading 1s (via _dimension) and explicit 1s broadcast to any size.
        if da ≠ 1 and db ≠ 1 {
            require da ≡ db throw variant Incompatible { message = "shapes not broadcastable" }
        }
        result.append(da ⤒ db)
    }
    # Element-count ceiling on the result shape (checked before use).
    _product(result)
    return result
}

# --- Reshape -------------------------------------------------------------
# Element-count-preserving rule. A single -1 sentinel infers the missing
# dimension (must divide evenly); more than one -1 is rejected. The resolved
# shape is always ceiling-validated.
@ public
fn reshape(list<int> shape, list<int> target) → list<int> ⇥ ShapeError {
    const int total ← _product(shape)
    var int unknown ← 0
    var int concrete ← 1
    # -1 is the inference sentinel; every other dimension must be non-negative.
    require target.all(int d ∴ d ≥ 0 or d ≡ -1) throw variant NegativeDimension { message = "negative dimension" }
    for from target const dim {
        if dim ≡ -1 {
            unknown ← unknown + 1
        }
        else {
            if dim ≻ 0 {
                require concrete ≤ ELEMENTS_LIMIT / dim throw variant ProductAboveLimit { message = "element count above ceiling" }
                concrete ← concrete * dim
            }
            else {
                concrete ← 0
            }
        }
    }
    require unknown ≤ 1 throw variant ElementMismatch { message = "at most one inferred dimension" }
    var list<int> result ← empty
    for from target const dim {
        if dim ≡ -1 {
            require concrete ≠ 0 throw variant ElementMismatch { message = "inferred dimension not resolvable" }
            require total % concrete ≡ 0 throw variant ElementMismatch { message = "inferred dimension not integral" }
            result.append(total / concrete)
        }
        else {
            result.append(dim)
        }
    }
    # Validate the resolved shape (ceilings) and, without a sentinel,
    # element-count preservation.
    const int resolved ← _product(result)
    reject unknown ≡ 0 and resolved ≠ total throw variant ElementMismatch { message = "element count mismatch" }
    return result
}

# --- Expand --------------------------------------------------------------
# Left-pad singleton dimensions to reach a target rank. Rejects a target
# rank below the current rank and any rank above the rank ceiling.
# OQ-2 (list-predicate-twins goal): expand validates its input dims but,
# unlike broadcast/reshape, never element-ceiling-validates its result —
# recorded asymmetry, out of scope here; ruling routed to Mind with the
# LPT-5 collapse report.
@ public
fn expand(list<int> shape, int target_rank) → list<int> ⇥ ShapeError {
    require shape.all(int d ∴ d ≥ 0) throw variant NegativeDimension { message = "negative dimension" }
    const int l ← shape.length()
    require target_rank ≥ l throw variant GradusMismatch { message = "target rank below current rank" }
    require target_rank ≤ RANK_LIMIT throw variant GradusMismatch { message = "target rank above ceiling" }
    var list<int> result ← empty
    for range 0 ‥ target_rank - l const _ {
        result.append(1)
    }
    for from shape const dim {
        result.append(dim)
    }
    return result
}
