+++
locale = "en"
+++
# Co-located package test for decode_token.fab (A1-PORT-2). Not importable;
# discovered only by the faber test path:
#
#   faber test --include decode_token --device cpu
#
# Tiny configuration: D=4, 2 heads, 1 KV head, dh=2, F=6, V=5, C=4. `layer_step`
# with all-zero weights is the identity on the residual stream (attention and
# FFN contribute 0). The real-shape numpy pin is radix/acceptance/a1-token-step.
# Every decode_step kernel is referenced from this package (a kernel imported
# only transitively has no MIR function today).

import from "gradus:decode_token" dt
import from "gradus:decode_step" ds

fn close(f32 a, f32 b) → bool {
    return (a - b).abs() ≺ 0.0001
}

fn touch() → void {
    var tensor<f32, [4]> d4 ← tf32[4] {}
    var tensor<f32, [4]> o4 ← tf32[4] {}
    var tensor<f32, [5, 4]> tab ← tf32[5, 4] {}
    var tensor<i32, [1]> ids ← tensor<i32, [1]> {}
    ds.gather_row(d4, tab, ids, mut o4)
    var tensor<f32, [1]> dom1 ← tf32[1] {}
    var tensor<f32, [1]> st1 ← tf32[1] {}
    var tensor<f32, [4]> an ← tf32[4] {}
    ds.rms_stats(dom1, o4, mut st1, 4, 0.00001)
    ds.rms_apply(o4, st1, d4, mut an)
    var tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    var tensor<f32, [4]> q ← tf32[4] {}
    ds.gemv_lane(d4, wq, an, mut q, 4)
    var tensor<f32, [4]> qr ← tf32[4] {}
    ds.rope_half(q, mut qr, 0, 1, 11.512925)
    var tensor<f32, [2]> kr ← tf32[2] {}
    var tensor<f32, [4, 2]> kc ← tf32[4, 2] {}
    var tensor<f32, [4, 2]> kc2 ← tf32[4, 2] {}
    ds.kv_write(kc, kr, mut kc2, 0)
    var tensor<f32, [2, 4]> hc ← tf32[2, 4] {}
    var tensor<f32, [2, 4]> sc ← tf32[2, 4] {}
    ds.attn_scores(hc, qr, kc2, mut sc, 0, 2, 2, 0.5)
    var tensor<f32, [2]> hd ← tf32[2] {}
    var tensor<f32, [2]> mx ← tf32[2] {}
    var tensor<f32, [2]> sm ← tf32[2] {}
    ds.softmax_stats(hd, sc, mut mx, mut sm, 4)
    var tensor<f32, [2, 4]> pr ← tf32[2, 4] {}
    ds.softmax_apply(sc, mx, sm, mut pr)
    var tensor<f32, [4]> ctx ← tf32[4] {}
    ds.attn_context(d4, pr, kc2, mut ctx, 0, 2, 2)
    var tensor<f32, [4]> h1 ← tf32[4] {}
    ds.residual_add(o4, an, mut h1)
    var tensor<f32, [6]> g1 ← tf32[6] {}
    var tensor<f32, [6]> u1 ← tf32[6] {}
    var tensor<f32, [6]> a1 ← tf32[6] {}
    ds.swiglu(g1, u1, mut a1)
}

test "decode_token embed_step gathers the row named by ids[0]" {
    touch()
    var tensor<f32, [5, 4]> tab ← tf32[5, 4] {}
    var tensor<i32, [1]> ids ← tensor<i32, [1]> {}
    var tensor<f32, [4]> h ← tf32[4] {}
    for range 0‥5 const r {
        for range 0‥4 const c {
            tab[[r, c]] ← (r * 10 + c) ↦ f32
        }
    }
    ids[0] ← 3
    dt.embed_step(tab, ids, mut h)
    assert close(h[[0]], 30.0)
    assert close(h[[3]], 33.0)
}

test "decode_token argmax_host picks the largest logit, first on ties" {
    touch()
    var tensor<f32, [5]> lg ← tf32[5] {}
    lg[[0]] ← 0.5
    lg[[1]] ← 2.0
    lg[[2]] ← 2.0
    lg[[3]] ← -1.0
    lg[[4]] ← 1.0
    assert dt.argmax_host(lg) ≡ 1
}

test "decode_token head_step is the tied lm_head over the normalised hidden" {
    touch()
    var tensor<f32, [4]> h ← tf32[4] {}
    var tensor<f32, [4]> w ← tf32[4] {}
    var tensor<f32, [5, 4]> tab ← tf32[5, 4] {}
    var tensor<f32, [5]> lg ← tf32[5] {}
    for range 0‥4 const j {
        h[[j]] ← 2.0
        w[[j]] ← 1.0
    }
    for range 0‥5 const r {
        tab[[r, 0]] ← r ↦ f32
    }
    dt.head_step(h, w, tab, mut lg, 4, 0.0)
    # rmsnorm of [2,2,2,2] is [1,1,1,1]; logit r = tab[r] . 1 = r
    assert close(lg[[0]], 0.0)
    assert close(lg[[3]], 3.0)
    assert close(lg[[4]], 4.0)
}

test "decode_token layer_step with zero weights is the identity on the residual stream" {
    touch()
    var tensor<f32, [2]> hd ← tf32[2] {}
    var tensor<f32, [4]> hin ← tf32[4] {}
    var tensor<f32, [4]> hout ← tf32[4] {}
    var tensor<f32, [4]> an ← tf32[4] {}
    var tensor<f32, [4]> fn2 ← tf32[4] {}
    var tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    var tensor<f32, [2, 4]> wk ← tf32[2, 4] {}
    var tensor<f32, [2, 4]> wv ← tf32[2, 4] {}
    var tensor<f32, [4, 4]> wo ← tf32[4, 4] {}
    var tensor<f32, [6, 4]> wg ← tf32[6, 4] {}
    var tensor<f32, [6, 4]> wu ← tf32[6, 4] {}
    var tensor<f32, [4, 6]> wd ← tf32[4, 6] {}
    var tensor<f32, [4, 2]> kin ← tf32[4, 2] {}
    var tensor<f32, [4, 2]> kout ← tf32[4, 2] {}
    var tensor<f32, [4, 2]> vin ← tf32[4, 2] {}
    var tensor<f32, [4, 2]> vout ← tf32[4, 2] {}
    for range 0‥4 const j {
        hin[[j]] ← (j ↦ f32) + 1.0
        an[[j]] ← 1.0
        fn2[[j]] ← 1.0
    }
    dt.layer_step(hd, hin, mut hout, an, wq, wk, wv, wo, fn2, wg, wu, wd, kin, mut kout, vin, mut vout, 0, 4, 4, 6, 4, 2, 1, 2, 0.00001, 11.512925, 0.5)
    assert close(hout[[0]], 1.0)
    assert close(hout[[1]], 2.0)
    assert close(hout[[3]], 4.0)
    assert close(kout[[0, 0]], 0.0)
}
