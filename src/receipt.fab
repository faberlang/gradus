+++
locale = "en"
+++
# Versioned speculative-decode evidence receipt — SD0-U5 / SD4-U5.
#
# This leaf carries measurement facts without collecting them. A receipt is
# independently classifiable by regime, backend, and cold/warm evidence. The
# wire is deliberately closed: unknown markers, schema versions, policy
# versions, labels, field counts, and malformed numbers reject.
#
# A negative value of exactly -1.0 means that a measured field is absent. Any
# non-negative timing, rate, or overhead is a measurement. The constructor
# requires a token-equivalence verdict before any measurement can be carried,
# so performance is never reported without the semantic result it qualifies.

import from "gradus:dtype" dtype

const string schema_version ← "1.1.0"
const string legacy_schema_version ← "1.0.0"
const string policy_version ← "1.0.0"
const f32 absent_timing ← (0.0 - 1.0) ∷ f32

# -------------------------------------------------------------------------
# ReceiptError — typed vocabulary for construction and wire rejection.
# -------------------------------------------------------------------------

@ public
union ReceiptError {
    @ shared
    string message

    InvalidPolicy,
    InvalidPolicyVersion,
    InvalidRegime,
    InvalidBackend,
    InvalidWarmth,
    InvalidCounts,
    InvalidDivergence,
    InvalidEquivalence,
    InvalidTiming,
    UnknownVersion,
    BadWire
}



# -------------------------------------------------------------------------
# Closed labels. Strings remain the wire-facing representation so consumers
# can classify an imported receipt without matching imported union variants.
# -------------------------------------------------------------------------

@ public
fn regime_context_reproduction() → string {
    return "context-reproduction"
}

@ public
fn regime_ordinary_chat() → string {
    return "ordinary-chat"
}

@ public
fn backend_reference() → string {
    return "reference"
}

@ public
fn backend_compiled() → string {
    return "compiled"
}

@ public
fn backend_metal() → string {
    return "metal"
}

@ public
fn backend_cuda() → string {
    return "cuda"
}

@ public
fn warmth_cold() → string {
    return "cold"
}

@ public
fn warmth_warm() → string {
    return "warm"
}

@ public
fn policy_disabled() → string {
    return "disabled"
}

@ public
fn policy_context_lookup() → string {
    return "context_lookup"
}

@ public
fn equivalence_equivalent() → string {
    return "equivalent"
}

@ public
fn equivalence_divergent() → string {
    return "divergent"
}

# -------------------------------------------------------------------------
# Receipt — the complete, versioned evidence value.
# -------------------------------------------------------------------------

@ public
class Receipt {
    string policy
    string policy_version
    int block_size
    int accepted
    int rejected
    int first_divergence
    string equivalence
    f32 ttft
    f32 throughput
    string backend
    string regime
    string warmth
    int draft_length
    int fallback_count
    f32 acceptance_rate
    f32 fallback_rate
    f32 overhead

    fn policy() → string {
        return self.policy
    }

    fn policy_version() → string {
        return self.policy_version
    }

    fn block_size() → int {
        return self.block_size
    }

    fn accepted_count() → int {
        return self.accepted
    }

    fn rejected_count() → int {
        return self.rejected
    }

    fn first_divergence() → int {
        return self.first_divergence
    }

    fn equivalence() → string {
        return self.equivalence
    }

    fn equivalence_verdict() → string {
        return self.equivalence
    }

    fn ttft() → f32 {
        return self.ttft
    }

    fn throughput() → f32 {
        return self.throughput
    }

    fn backend() → string {
        return self.backend
    }

    fn regime() → string {
        return self.regime
    }

    fn warmth() → string {
        return self.warmth
    }

    fn draft_length() → int {
        return self.draft_length
    }

    fn fallback_count() → int {
        return self.fallback_count
    }

    fn acceptance_rate() → f32 {
        return self.acceptance_rate
    }

    fn fallback_rate() → f32 {
        return self.fallback_rate
    }

    fn overhead() → f32 {
        return self.overhead
    }
}

# Placeholder for var Receipt bindings. The value is not a valid report; it
# is only a typed destination for a catch arm that cannot be reached by valid
# test data.
@ public
fn default() → Receipt {
    return Receipt {policy = "", policy_version = "", block_size = 0, accepted = 0, rejected = 0, first_divergence = (0 - 1), equivalence = "", ttft = absent_timing, throughput = absent_timing, backend = "", regime = "", warmth = "", draft_length = 0, fallback_count = 0, acceptance_rate = absent_timing, fallback_rate = absent_timing, overhead = absent_timing}
}

@ public
fn receipt_equal(Receipt a, Receipt b) → bool {
    if a.policy() ≠ b.policy() then return false
    if a.policy_version() ≠ b.policy_version() then return false
    if a.block_size() ≠ b.block_size() then return false
    if a.accepted_count() ≠ b.accepted_count() then return false
    if a.rejected_count() ≠ b.rejected_count() then return false
    if a.first_divergence() ≠ b.first_divergence() then return false
    if a.equivalence() ≠ b.equivalence() then return false
    if a.ttft() ≠ b.ttft() then return false
    if a.throughput() ≠ b.throughput() then return false
    if a.backend() ≠ b.backend() then return false
    if a.regime() ≠ b.regime() then return false
    if a.warmth() ≠ b.warmth() then return false
    if a.draft_length() ≠ b.draft_length() then return false
    if a.fallback_count() ≠ b.fallback_count() then return false
    if a.acceptance_rate() ≠ b.acceptance_rate() then return false
    if a.fallback_rate() ≠ b.fallback_rate() then return false
    return a.overhead() ≡ b.overhead()
}

@ public
fn evidence(Receipt r) → string {
    return r.backend() + ":" + r.warmth()
}

# -------------------------------------------------------------------------
# Validation and construction.
# -------------------------------------------------------------------------

fn _validate(string policy, string policy_ver, int block_size, int accepted, int rejected, int divergence, string equivalence, f32 ttft, f32 throughput, string backend, string regime, string warmth, int draft_length, int fallback_count, f32 acceptance_rate, f32 fallback_rate, f32 overhead) → void ⇥ ReceiptError {
    require policy ≡ "disabled" or policy ≡ "context_lookup" throw variant InvalidPolicy {message = "unknown receipt policy"}
    require policy_ver ≡ policy_version throw variant InvalidPolicyVersion {message = "unknown acceleration policy version"}
    require regime ≡ "context-reproduction" or regime ≡ "ordinary-chat" throw variant InvalidRegime {message = "unknown receipt regime"}
    require backend ≡ "reference" or backend ≡ "compiled" or backend ≡ "metal" or backend ≡ "cuda" throw variant InvalidBackend {message = "unknown receipt backend"}
    require warmth ≡ "cold" or warmth ≡ "warm" throw variant InvalidWarmth {message = "unknown receipt evidence temperature"}
    require block_size ≥ 1 throw variant InvalidCounts {message = "receipt block size must be at least one"}
    require accepted ≥ 0 throw variant InvalidCounts {message = "accepted count must be non-negative"}
    require rejected ≥ 0 throw variant InvalidCounts {message = "rejected count must be non-negative"}
    require draft_length ≥ 0 throw variant InvalidCounts {message = "draft length must be non-negative"}
    require fallback_count ≥ 0 throw variant InvalidCounts {message = "fallback count must be non-negative"}
    require divergence ≥ (0 - 1) throw variant InvalidDivergence {message = "first divergence must be -1 or non-negative"}
    require equivalence.length() ≡ 0 or equivalence ≡ "equivalent" or equivalence ≡ "divergent" throw variant InvalidEquivalence {message = "equivalence verdict must be equivalent or divergent"}
    require dtype.finite(ttft) and dtype.finite(throughput) and dtype.finite(acceptance_rate) and dtype.finite(fallback_rate) and dtype.finite(overhead) throw variant InvalidTiming {message = "receipt measurement must be finite"}
    require ttft ≡ absent_timing or ttft ≥ 0.0 throw variant InvalidTiming {message = "TTFT must be -1.0 or non-negative"}
    require throughput ≡ absent_timing or throughput ≥ 0.0 throw variant InvalidTiming {message = "throughput must be -1.0 or non-negative"}
    require acceptance_rate ≡ absent_timing or (acceptance_rate ≥ 0.0 and acceptance_rate ≤ 1.0) throw variant InvalidTiming {message = "acceptance rate must be -1.0 or within [0, 1]"}
    require fallback_rate ≡ absent_timing or (fallback_rate ≥ 0.0 and fallback_rate ≤ 1.0) throw variant InvalidTiming {message = "fallback rate must be -1.0 or within [0, 1]"}
    require overhead ≡ absent_timing or overhead ≥ 0.0 throw variant InvalidTiming {message = "overhead must be -1.0 or non-negative"}
    const bool measured_timing ← ttft ≠ absent_timing or throughput ≠ absent_timing
    reject (measured_timing and not (equivalence.length() ≠ 0)) throw variant InvalidEquivalence {message = "equivalence verdict is required when timing or throughput is present"}
    const bool measured ← measured_timing or acceptance_rate ≠ absent_timing or fallback_rate ≠ absent_timing or overhead ≠ absent_timing
    reject (measured and not (equivalence.length() ≠ 0)) throw variant InvalidEquivalence {message = "equivalence verdict is required when a receipt measurement is present"}
}

@ public
fn construct_receipt(string policy, string policy_ver, int block_size, int accepted, int rejected, int divergence, string equivalence, f32 ttft, f32 throughput, string backend, string regime, string warmth, int draft_length, int fallback_count, f32 acceptance_rate, f32 fallback_rate, f32 overhead) → Receipt ⇥ ReceiptError {
    _validate(policy, policy_ver, block_size, accepted, rejected, divergence, equivalence, ttft, throughput, backend, regime, warmth, draft_length, fallback_count, acceptance_rate, fallback_rate, overhead)
    return Receipt {policy = policy, policy_version = policy_ver, block_size = block_size, accepted = accepted, rejected = rejected, first_divergence = divergence, equivalence = equivalence, ttft = ttft, throughput = throughput, backend = backend, regime = regime, warmth = warmth, draft_length = draft_length, fallback_count = fallback_count, acceptance_rate = acceptance_rate, fallback_rate = fallback_rate, overhead = overhead}
}

# Short canonical spelling for consumers that treat receipt as the module's
# primary value constructor.
@ public
fn construct(string policy, string policy_ver, int block_size, int accepted, int rejected, int divergence, string equivalence, f32 ttft, f32 throughput, string backend, string regime, string warmth, int draft_length, int fallback_count, f32 acceptance_rate, f32 fallback_rate, f32 overhead) → Receipt ⇥ ReceiptError {
    return construct_receipt(policy, policy_ver, block_size, accepted, rejected, divergence, equivalence, ttft, throughput, backend, regime, warmth, draft_length, fallback_count, acceptance_rate, fallback_rate, overhead)
}

# -------------------------------------------------------------------------
# Versioned wire — receipt/1.1.0/<policy>/<policy-version>/<block>/<accepted>
#   /<rejected>/<first-divergence>/<equivalence>/<ttft>/<throughput>
#   /<backend>/<regime>/<warmth>/<draft-length>/<fallback-count>
#   /<acceptance-rate>/<fallback-rate>/<overhead>
#
# Empty equivalence and -1.0 measurements encode an unmeasured receipt. The
# 1.0.0 shape remains readable and receives absent values for the additive
# fields. No reader accepts a partial or future shape.
# -------------------------------------------------------------------------

fn _wire_int(string text, string detail) → int ⇥ ReceiptError {
    require text.length() ≠ 0 throw variant BadWire {message = detail}
    var int n ← 0
    do {
        n ↤ text
    }
    catch err {
        throw variant BadWire {message = detail}
    }
    require n ≥ 0 throw variant BadWire {message = detail}
    return n
}

fn _wire_divergence(string text) → int ⇥ ReceiptError {
    if text ≡ "-1" then return (0 - 1)
    return _wire_int(text, "malformed first divergence in receipt wire")
}

fn _wire_f32(string text, string detail) → f32 ⇥ ReceiptError {
    do {
        return text ↦ f32
    }
    catch err {
        throw variant BadWire {message = detail}
    }
    throw variant BadWire {message = detail}
}

@ public
fn serialize(Receipt r) → string ⇥ ReceiptError {
    _validate(r.policy(), r.policy_version(), r.block_size(), r.accepted_count(), r.rejected_count(), r.first_divergence(), r.equivalence(), r.ttft(), r.throughput(), r.backend(), r.regime(), r.warmth(), r.draft_length(), r.fallback_count(), r.acceptance_rate(), r.fallback_rate(), r.overhead())
    return "receipt/§/§/§/§/§/§/§/§/§/§/§/§/§/§/§/§/§/§"(schema_version, r.policy(), r.policy_version(), r.block_size() ↦ string, r.accepted_count() ↦ string, r.rejected_count() ↦ string, r.first_divergence() ↦ string, r.equivalence(), r.ttft() ↦ string, r.throughput() ↦ string, r.backend(), r.regime(), r.warmth(), r.draft_length() ↦ string, r.fallback_count() ↦ string, r.acceptance_rate() ↦ string, r.fallback_rate() ↦ string, r.overhead() ↦ string)
}

@ public
fn serialize_receipt(Receipt r) → string ⇥ ReceiptError {
    return serialize(r)
}

@ public
fn deserialize(string wire) → Receipt ⇥ ReceiptError {
    const list<string> parts ← wire.split("/")
    require parts.length() ≡ 14 or parts.length() ≡ 19 throw variant BadWire {message = "malformed receipt wire"}
    require parts.get(0) coalesce "" ≡ "receipt" throw variant BadWire {message = "unknown receipt marker"}
    const string wire_version ← parts.get(1) coalesce ""
    require wire_version ≡ legacy_schema_version or wire_version ≡ schema_version throw variant UnknownVersion {message = "unknown receipt schema version"}
    const string policy ← parts.get(2) coalesce ""
    const string policy_ver ← parts.get(3) coalesce ""
    const int block_size ← _wire_int(parts.get(4) coalesce "", "malformed block size in receipt wire")
    const int accepted ← _wire_int(parts.get(5) coalesce "", "malformed accepted count in receipt wire")
    const int rejected ← _wire_int(parts.get(6) coalesce "", "malformed rejected count in receipt wire")
    const int divergence ← _wire_divergence(parts.get(7) coalesce "")
    const string equivalence ← parts.get(8) coalesce ""
    const f32 ttft ← _wire_f32(parts.get(9) coalesce "", "malformed TTFT in receipt wire")
    const f32 throughput ← _wire_f32(parts.get(10) coalesce "", "malformed throughput in receipt wire")
    const string backend ← parts.get(11) coalesce ""
    const string regime ← parts.get(12) coalesce ""
    const string warmth ← parts.get(13) coalesce ""
    if wire_version ≡ legacy_schema_version {
        require parts.length() ≡ 14 throw variant BadWire {message = "malformed receipt wire"}
        return construct_receipt(policy, policy_ver, block_size, accepted, rejected, divergence, equivalence, ttft, throughput, backend, regime, warmth, 0, 0, absent_timing, absent_timing, absent_timing)
    }
    require parts.length() ≡ 19 throw variant BadWire {message = "malformed receipt wire"}
    const int draft_length ← _wire_int(parts.get(14) coalesce "", "malformed draft length in receipt wire")
    const int fallback_count ← _wire_int(parts.get(15) coalesce "", "malformed fallback count in receipt wire")
    const f32 acceptance_rate ← _wire_f32(parts.get(16) coalesce "", "malformed acceptance rate in receipt wire")
    const f32 fallback_rate ← _wire_f32(parts.get(17) coalesce "", "malformed fallback rate in receipt wire")
    const f32 overhead ← _wire_f32(parts.get(18) coalesce "", "malformed overhead in receipt wire")
    return construct_receipt(policy, policy_ver, block_size, accepted, rejected, divergence, equivalence, ttft, throughput, backend, regime, warmth, draft_length, fallback_count, acceptance_rate, fallback_rate, overhead)
}

@ public
fn deserialize_receipt(string wire) → Receipt ⇥ ReceiptError {
    return deserialize(wire)
}
