# GEA3-U2 rows. The full-model typed views (gradus:model/full_model_view)
# cross into the device boundary only after the ordinary host validators
# pass; these rows prove that seam stays host-side (GEA1-R1 split) for the
# GEA3 admission surface.

import from "gradus:model/full_model_view" full_model_view

const int GEA3_ARTIFACT_LENGTH ← 1449071552
const string GEA3_ARTIFACT_DIGEST ← "4d10b02ea1b189cb9637b39ba1543c61f69a8766099076880888f4443754e128"
const string GEA3_ATTN_NORM_L0_DIGEST ← "f1077466ee135619bae393981be53aede4475b22d2c9c1023a1c06e09703a42a"
const string GEA3_OUTPUT_NORM_DIGEST ← "63e40617963ad8b07a0bf9125bb2e52a362cfea38a508106af0371e21ec836fd"

fn _gea3_zeros(int length) → bytes {
    var bytes out ← ||
    for range 0‥length const i {
        out.append(0 ∷ int<u8>)
    }
    return out
}

test "gea3 kernel boundary validates full-model views before device entry" {
    const _ trap_result_1 ← trap {
        const full_model_view.F32ModelView attn_norm ← full_model_view.admit_attn_norm(0, _gea3_zeros(3840), 190530752, 190534592, [960], GEA3_ARTIFACT_LENGTH, GEA3_ARTIFACT_DIGEST, GEA3_ATTN_NORM_L0_DIGEST)
        full_model_view.validate(attn_norm)
        const full_model_view.F32ModelView output_norm ← full_model_view.admit_output_norm(_gea3_zeros(3840), 1449067712, 1449071552, [960], GEA3_ARTIFACT_LENGTH, GEA3_ARTIFACT_DIGEST, GEA3_OUTPUT_NORM_DIGEST)
        full_model_view.validate(output_norm)
        assert dtype.eq(attn_norm.dtype(), dtype.f32())
        assert output_norm.layer() ≡ -1
    }
    assert trap_result_1 is void
}

# BLOCKER (B, funnel 7ec5e484): reject row needs the error outcome narrowed
# after trap — hard-blocked ("projection base", MIR repair 2d5b7789 not
# landed). Kept on do/catch. Do not convert.
test "gea3 kernel boundary rejects a drifted full-model view" {
    do {
        const full_model_view.F32ModelView drifted ← full_model_view.admit_attn_norm(0, _gea3_zeros(3840), 190530752, 190534591, [960], GEA3_ARTIFACT_LENGTH, GEA3_ARTIFACT_DIGEST, GEA3_ATTN_NORM_L0_DIGEST)
        full_model_view.validate(drifted)
        assert false
    }
    catch err {
        assert true
    }
}
