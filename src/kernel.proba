+++
locale = "en"
+++
# GEA1 source-level proof. These tests prove only typed view admission and
# the host/device boundary; they make no lowering, Metal, or device claim.

import from "gradus:dtype" dtype

import from "gradus:model/safetensors" safetensors

import from "gradus:kernel" kernel

const int N ← 320
const int K ← 960
const int BF16_LENGTH ← N * K * 2
const int F32_LENGTH ← N * K * 4

fn _bytes(list<int<u8>> values) → bytes {
    const bytes out ↤ values
    return out
}

fn _bf16_ones() → bytes {
    var list<int<u8>> out ← empty
    for range 0‥(N * K) const i {
        out.append(128 ∷ int<u8>)
        out.append(63 ∷ int<u8>)
    }
    return _bytes(out)
}

fn _f32_ones() → bytes {
    var list<int<u8>> out ← empty
    for range 0‥(N * K) const i {
        out.append(0 ∷ int<u8>)
        out.append(0 ∷ int<u8>)
        out.append(128 ∷ int<u8>)
        out.append(63 ∷ int<u8>)
    }
    return _bytes(out)
}

fn _input_ones() → list<f32> {
    var list<f32> out ← empty
    for range 0‥K const i {
        out.append(1.0)
    }
    return out
}

test "gea1 typed BF16 and F32 views keep the logical shape" {
    do {
        const kernel.Bf16View bf16 ← kernel.bf16_view(_bf16_ones(), 113454752, 114069152, [N, K])
        const kernel.F32View f32 ← kernel.f32_view(_f32_ones(), 200000000, 201228800, [N, K])
        assert dtype.name(bf16.dtype()) ≡ "bf16"
        assert dtype.name(f32.dtype()) ≡ "f32"
        assert bf16.shape().get(0) coalesce (-1) ≡ N
        assert bf16.shape().get(1) coalesce (-1) ≡ K
        assert f32.shape().get(0) coalesce (-1) ≡ N
        assert f32.shape().get(1) coalesce (-1) ≡ K
        assert bf16.byte_length() ≡ BF16_LENGTH
        assert f32.byte_length() ≡ F32_LENGTH
        assert bf16.absolute_end() - bf16.absolute_start() ≡ BF16_LENGTH
        assert f32.absolute_end() - f32.absolute_start() ≡ F32_LENGTH
    }
    catch err {
        assert false
    }
}

test "gea1 host admission validates both resident views before device entry" {
    do {
        const bytes bf16_payload ← _bf16_ones()
        const kernel.Bf16View bf16 ← kernel.bf16_view(bf16_payload, 113454752, 114069152, [N, K])
        kernel.validate_bf16_view(bf16, _input_ones())

        const bytes f32_payload ← _f32_ones()
        const kernel.F32View f32 ← kernel.f32_view(f32_payload, 200000000, 201228800, [N, K])
        kernel.validate_f32_view(f32, _input_ones())
    }
    catch err {
        assert false
    }
}

test "gea1 view constructors reject wrong typed storage geometry" {
    do {
        const kernel.Bf16View _ ← kernel.bf16_view(_bf16_ones(), 113454752, 114069150, [N, K])
        assert false
    }
    catch err {
        assert true
    }
    do {
        const kernel.F32View _ ← kernel.f32_view(_f32_ones(), 200000000, 201228800, [N, K - 1])
        assert false
    }
    catch err {
        assert true
    }
}

test "gea1 host admission rejects a non-contract input vector" {
    do {
        const bytes bf16_payload ← _bf16_ones()
        const kernel.Bf16View bf16 ← kernel.bf16_view(bf16_payload, 113454752, 114069152, [N, K])
        kernel.validate_bf16_view(bf16, [1.0])
        assert false
    }
    catch err {
        assert true
    }
    do {
        const bytes f32_payload ← _f32_ones()
        const kernel.F32View f32 ← kernel.f32_view(f32_payload, 200000000, 201228800, [N, K])
        kernel.validate_f32_view(f32, [1.0])
        assert false
    }
    catch err {
        assert true
    }
}

test "gea1 selected source range is admitted before the kernel boundary" {
    do {
        const safetensors.SelectedTensor selected ← safetensors.admit_selected(
            _bf16_ones(),
            "e6bffe7435d7ddc10fd3b9a9efd429dafbacb1cb17015fb5562664e7532bf86e",
            723674912,
            32672,
            113422080,
            114036480
        )
        assert selected.absolute_start() ≡ 113454752
        assert dtype.name(selected.dtype()) ≡ "bf16"
        assert selected.shape().get(0) coalesce (-1) ≡ N
        assert selected.shape().get(1) coalesce (-1) ≡ K
    }
    catch err {
        assert false
    }
}

test "gea1 selected source range rejects identity or byte-range drift" {
    do {
        const safetensors.SelectedTensor _ ← safetensors.admit_selected(
            _bytes([128, 63]),
            "zz",
            723674912,
            32672,
            113422080,
            114036480
        )
        assert false
    }
    catch err {
        assert true
    }
    do {
        const safetensors.SelectedTensor _ ← safetensors.admit_selected(
            _bytes([128, 63]),
            "e6bffe7435d7ddc10fd3b9a9efd429dafbacb1cb17015fb5562664e7532bf86e",
            723674912,
            32672,
            113422080,
            114036480
        )
        assert false
    }
    catch err {
        assert true
    }
}

# GEA2-U3 source-level rows. Each call forces the public entry signature to
# resolve its static F32 shapes; these rows make no lowering, Metal, or device
# execution claim. The target gate separately rejects host-shaped constructs
# in the @ kernel bodies.

test "gea2_rmsnorm_static_f32_shape" {
    do {
        var tf32[8,960] input ← empty
        var tf32[960] weight ← empty
        var tf32[8,960] output ← empty
        kernel.rmsnorm(input, weight, output)
        assert true
    }
    catch err {
        assert false
    }
}

