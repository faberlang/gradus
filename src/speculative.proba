+++
locale = "en"
+++
# Co-located package test for speculative.fab (SD0-U3 candidate-provider
# seam). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * a ProviderRequest carries tokenized prompt context, accepted
#     generation history, and a requested block size inside the policy
#     bounds; out-of-policy block sizes and malformed requests reject
#     through typed SpeculativeError.
#   * a ProviderResult is candidate ids + provenance, or a typed
#     no-draft (no-candidate); empty lookup is not an error.
#   * provenance admits only the context_lookup source; unknown source,
#     negative offset, and zero match length reject.
#   * constructors are pure in their inputs: equal requests (and equal
#     candidate bindings) compare equal. No RNG, cache, or history
#     argument exists on this surface — SD0 has no propose implementation.
#
# First-failing oracle: the out-of-policy block-size reject row.
#
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/speculative.proba` proves the suite
# type-checks. This suite remains compile-level proof; no search or
# executed lookup is claimed here.

import from "gradus:speculative" speculative

# Renders a request-construction outcome as text.
fn request_detail(list<int> prompt, list<int> history, int block_size, int min_block, int max_block) → string {
    do {
        const speculative.ProviderRequest _ ← speculative.construct_request(prompt, history, block_size, min_block, max_block)
        return "ok"
    }
    catch err {
        return speculative.message(err)
    }
}

# Renders a provenance-construction outcome as text.
fn provenance_detail(string source, int source_offset, int match_length) → string {
    do {
        const speculative.CandidateProvenance _ ← speculative.construct_provenance(source, source_offset, match_length)
        return "ok"
    }
    catch err {
        return speculative.message(err)
    }
}

# Renders a candidate-binding outcome as text.
fn candidates_detail(speculative.ProviderRequest request, list<int> ids, speculative.CandidateProvenance provenance) → string {
    do {
        const speculative.ProviderResult _ ← speculative.construct_candidates(request, ids, provenance)
        return "ok"
    }
    catch err {
        return speculative.message(err)
    }
}

# A valid in-bounds request (policy bounds 2–8, requested block 4).
fn request_p() → speculative.ProviderRequest {
    var speculative.ProviderRequest r ← speculative.default()
    do {
        r ← speculative.construct_request([10, 11, 12], [13], 4, 2, 8)
    }
    catch err {
        return r
    }
    return r
}

# A valid context_lookup provenance.
fn provenance_p() → speculative.CandidateProvenance {
    var speculative.CandidateProvenance p ← speculative.default_provenance()
    do {
        p ← speculative.construct_provenance(speculative.context_lookup_source(), 0, 2)
    }
    catch err {
        return p
    }
    return p
}

describe "SD0-U3 — candidate-provider seam" {
    test "a request with block size outside the policy bounds is a typed reject" {
        assert request_detail([10, 11, 12], [13], 16, 2, 8) ≡ "requested block size is outside the policy bounds"
        assert request_detail([10, 11, 12], [13], 1, 2, 8) ≡ "requested block size is outside the policy bounds"
        assert request_detail([10, 11, 12], [13], 0, 2, 8) ≡ "requested block size is outside the policy bounds"
        assert request_detail([10, 11, 12], [13], 9, 2, 8) ≡ "requested block size is outside the policy bounds"
    }
    test "a request at each policy bound is admitted" {
        do {
            const speculative.ProviderRequest lo ← speculative.construct_request([10], empty, 2, 2, 8)
            const speculative.ProviderRequest hi ← speculative.construct_request([10], empty, 8, 2, 8)
            assert lo.block_size() ≡ 2
            assert hi.block_size() ≡ 8
            assert request_detail([10], empty, 4, 2, 8) ≡ "ok"
        }
        catch err {
            assert false
        }
    }
    test "invalid policy bounds reject before the requested size is admitted" {
        assert request_detail([10], empty, 1, 0, 8) ≡ "policy block size must be at least one"
        assert request_detail([10], empty, 1, 1, 0) ≡ "policy block size must be at least one"
        assert request_detail([10], empty, 4, 8, 2) ≡ "policy block size minimum must not exceed the maximum"
    }
    test "negative token ids in prompt or history are a malformed request" {
        assert request_detail([10, -1], [13], 4, 2, 8) ≡ "token id must be non-negative"
        assert request_detail([10], [-2], 4, 2, 8) ≡ "token id must be non-negative"
    }
    test "a valid request stores prompt, history, and authorized block size" {
        do {
            const speculative.ProviderRequest r ← speculative.construct_request([10, 11, 12], [13, 14], 4, 2, 8)
            assert r.prompt() ≡ [10, 11, 12]
            assert r.history() ≡ [13, 14]
            assert r.block_size() ≡ 4
            assert speculative.request_equal(r, request_p()) ≡ false
        }
        catch err {
            assert false
        }
    }
    test "empty prompt and empty history are a valid request" {
        do {
            const speculative.ProviderRequest r ← speculative.construct_request(empty, empty, 1, 1, 1)
            assert r.prompt().length() ≡ 0
            assert r.history().length() ≡ 0
            assert r.block_size() ≡ 1
        }
        catch err {
            assert false
        }
    }
    test "equal requests compare equal (constructor determinism)" {
        do {
            const speculative.ProviderRequest a ← speculative.construct_request([10, 11], [12], 3, 1, 8)
            const speculative.ProviderRequest b ← speculative.construct_request([10, 11], [12], 3, 1, 8)
            assert speculative.request_equal(a, b)
        }
        catch err {
            assert false
        }
    }
    test "no_draft is a typed no-candidate result, not an error" {
        const speculative.ProviderResult r ← speculative.no_draft()
        assert speculative.is_no_draft(r)
        assert speculative.result_kind(r) ≡ "no_draft"
        assert speculative.candidate_ids(r).length() ≡ 0
        assert speculative.result_equal(r, speculative.no_draft())
    }
    test "construct_candidates binds ids and context_lookup provenance" {
        do {
            const speculative.ProviderRequest req ← request_p()
            const speculative.CandidateProvenance p ← provenance_p()
            const speculative.ProviderResult r ← speculative.construct_candidates(req, [21, 22], p)
            assert not (speculative.is_no_draft(r))
            assert speculative.result_kind(r) ≡ "candidates"
            assert speculative.candidate_ids(r) ≡ [21, 22]
            const speculative.CandidateProvenance got ← speculative.candidate_provenance(r)
            assert got.source() ≡ speculative.context_lookup_source()
            assert got.source_offset() ≡ 0
            assert got.match_length() ≡ 2
            assert speculative.provenance_equal(got, p)
        }
        catch err {
            assert false
        }
    }
    test "a shorter-than-block candidate list is admitted" {
        do {
            const speculative.ProviderRequest req ← request_p()
            const speculative.ProviderResult r ← speculative.construct_candidates(req, [21], provenance_p())
            assert speculative.candidate_ids(r).length() ≡ 1
            assert speculative.candidate_ids(r).length() ≺ req.block_size()
        }
        catch err {
            assert false
        }
    }
    test "empty or oversize candidate lists reject" {
        assert candidates_detail(request_p(), empty, provenance_p()) ≡ "candidate list must not be empty"
        assert candidates_detail(request_p(), [1, 2, 3, 4, 5], provenance_p()) ≡ "candidate count exceeds the requested block size"
    }
    test "a negative candidate token id rejects" {
        assert candidates_detail(request_p(), [21, -1], provenance_p()) ≡ "candidate token id must be non-negative"
    }
    test "unknown provenance source, negative offset, and zero match length reject" {
        assert provenance_detail("draft_model", 0, 2) ≡ "unknown candidate source"
        assert provenance_detail(speculative.context_lookup_source(), -1, 2) ≡ "source offset must be non-negative"
        assert provenance_detail(speculative.context_lookup_source(), 0, 0) ≡ "match length must be at least one"
    }
    test "candidate_provenance on a no-draft result is a typed reject" {
        do {
            const speculative.CandidateProvenance _ ← speculative.candidate_provenance(speculative.no_draft())
            assert false
        }
        catch err {
            assert speculative.message(err) ≡ "no-draft result has no provenance"
        }
    }
    test "candidates and no-draft results do not compare equal" {
        do {
            const speculative.ProviderResult drafted ← speculative.construct_candidates(request_p(), [21, 22], provenance_p())
            assert not (speculative.result_equal(drafted, speculative.no_draft()))
            assert speculative.result_equal(drafted, drafted)
        }
        catch err {
            assert false
        }
    }
}
