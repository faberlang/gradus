+++
locale = "en"
+++
# Co-located package test for shape.fab (PML1-U3 shape system).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the staged-carrier shape rules — introspection
# (valet / gradus / quantitas), broadcast (right-aligned pairwise, singleton
# 1 dims), reshape (element-count preservation, single -1 inference), expand
# (left-pad singleton dims to a target rank), and the general bounds checks
# (negative dims, element-count ceiling, rank ceiling) with distinct
# FormaError identity. The per-dimension 65536 (GI1 pinned-row) ceiling is a
# support-row/capsule admission fact, NOT general arithmetic: general shape
# math admits vocab-scale rows (128k–152k) within the element ceiling
# (CTO-2 correction, PML1 closeout).
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
import from "gradus:shape" forma

# -- introspection ---------------------------------------------------------

test "valet accepts non-negative shapes" {
    do {
        assert forma.valet([2, 3])
        assert forma.valet([])
        assert forma.valet([0, 0])
    }
    catch err {
        assert false
    }
}

test "valet rejects a negative dimension" {
    do {
        assert not forma.valet([1, -1])
    }
    catch err {
        assert false
    }
}

test "gradus reports the rank" {
    do {
        assert forma.gradus([2, 3]) ≡ 2
        assert forma.gradus([]) ≡ 0
        assert forma.gradus([2, 3, 4]) ≡ 3
    }
    catch err {
        assert false
    }
}

test "quantitas is the element product" {
    do {
        assert forma.quantitas([2, 3]) ≡ 6
        assert forma.quantitas([]) ≡ 1
        assert forma.quantitas([2, 0, 3]) ≡ 0
    }
    catch err {
        assert false
    }
}

# -- bounds and ceilings (GI1 precedent) ------------------------------------

test "quantitas rejects a negative dimension" {
    do {
        forma.quantitas([-1])
        assert false
    }
    catch err {
        assert forma.causa(err) ≡ "negative dimension"
    }
}

test "quantitas admits a vocab-scale dimension (no general per-dim cap)" {
    do {
        assert forma.quantitas([70000]) ≡ 70000
        assert forma.quantitas([152064]) ≡ 152064
        assert forma.quantitas([128000]) ≡ 128000
    }
    catch err {
        assert false
    }
}

test "quantitas rejects an element count above the ceiling" {
    do {
        forma.quantitas([1000000000, 2])
        assert false
    }
    catch err {
        assert forma.causa(err) ≡ "element count above ceiling"
    }
}

# -- broadcast --------------------------------------------------------------

test "broadcast right-aligns and pads with singletons" {
    do {
        assert forma.broadcastum([2, 3], [3]) ≡ [2, 3]
        assert forma.broadcastum([2, 3], []) ≡ [2, 3]
        const list<int> scalar ← forma.broadcastum([], [])
        assert forma.quantitas(scalar) ≡ 1
    }
    catch err {
        assert false
    }
}

test "broadcast unifies singleton dimensions" {
    do {
        assert forma.broadcastum([1, 4], [2, 1]) ≡ [2, 4]
        assert forma.broadcastum([2, 3], [1, 3]) ≡ [2, 3]
        assert forma.broadcastum([3, 1], [2, 3, 1]) ≡ [2, 3, 1]
    }
    catch err {
        assert false
    }
}

test "broadcast rejects incompatible dimensions" {
    do {
        forma.broadcastum([2, 3], [4, 3])
        assert false
    }
    catch err {
        assert forma.causa(err) ≡ "shapes not broadcastable"
    }
}

test "broadcast rejects a negative input dimension" {
    do {
        forma.broadcastum([2, -1], [3])
        assert false
    }
    catch err {
        assert forma.causa(err) ≡ "negative dimension"
    }
}

# -- reshape ----------------------------------------------------------------

test "reshape preserves the element count" {
    do {
        assert forma.reformanda([2, 3], [6]) ≡ [6]
        assert forma.reformanda([2, 3], [3, 2]) ≡ [3, 2]
        assert forma.reformanda([2, 3], [1, 2, 3]) ≡ [1, 2, 3]
    }
    catch err {
        assert false
    }
}

test "reshape infers a single -1 dimension" {
    do {
        assert forma.reformanda([2, 3], [-1]) ≡ [6]
        assert forma.reformanda([2, 3], [2, -1]) ≡ [2, 3]
        assert forma.reformanda([2, 3], [-1, 1]) ≡ [6, 1]
    }
    catch err {
        assert false
    }
}

test "reshape rejects an element-count mismatch" {
    do {
        forma.reformanda([2, 3], [4])
        assert false
    }
    catch err {
        assert forma.causa(err) ≡ "element count mismatch"
    }
}

test "reshape rejects more than one inferred dimension" {
    do {
        forma.reformanda([2, 3], [-1, -1])
        assert false
    }
    catch err {
        assert forma.causa(err) ≡ "at most one inferred dimension"
    }
}

test "reshape rejects a non-integral inferred dimension" {
    do {
        forma.reformanda([2, 3], [5, -1])
        assert false
    }
    catch err {
        assert forma.causa(err) ≡ "inferred dimension not integral"
    }
}

test "reshape rejects a negative dimension other than -1" {
    do {
        forma.reformanda([2, 3], [-2])
        assert false
    }
    catch err {
        assert forma.causa(err) ≡ "negative dimension"
    }
}

test "reshape admits an inferred vocab-scale dimension (no per-dim cap)" {
    do {
        assert forma.reformanda([152064, 2], [-1]) ≡ [304128]
        assert forma.reformanda([65536, 2], [-1]) ≡ [131072]
    }
    catch err {
        assert false
    }
}

# -- expand ----------------------------------------------------------------

test "expand pads leading singleton dimensions" {
    do {
        assert forma.expansio([2, 3], 2) ≡ [2, 3]
        assert forma.expansio([2, 3], 4) ≡ [1, 1, 2, 3]
        assert forma.expansio([], 3) ≡ [1, 1, 1]
    }
    catch err {
        assert false
    }
}

test "expand rejects a target rank below the current rank" {
    do {
        forma.expansio([2, 3], 1)
        assert false
    }
    catch err {
        assert forma.causa(err) ≡ "target rank below current rank"
    }
}

test "expand rejects a target rank above the rank ceiling" {
    do {
        forma.expansio([2], 65)
        assert false
    }
    catch err {
        assert forma.causa(err) ≡ "target rank above ceiling"
    }
}

test "expand rejects a negative input dimension" {
    do {
        forma.expansio([1, -1], 2)
        assert false
    }
    catch err {
        assert forma.causa(err) ≡ "negative dimension"
    }
}
