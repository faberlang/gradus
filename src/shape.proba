+++
locale = "en"
+++
# Co-located package test for shape.fab (PML1-U3 shape system).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the staged-carrier shape rules — introspection
# (valid / rank / numel), broadcast (right-aligned pairwise, singleton
# 1 dims), reshape (element-count preservation, single -1 inference), expand
# (left-pad singleton dims to a target rank), and the general bounds checks
# (negative dims, element-count ceiling, rank ceiling) with distinct
# ShapeError identity. The per-dimension 65536 (GI1 pinned-row) ceiling is a
# support-row/capsule admission fact, NOT general arithmetic: general shape
# math admits vocab-scale rows (128k–152k) within the element ceiling
# (CTO-2 correction, PML1 closeout).
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
import from "gradus:shape" shape

# -- introspection ---------------------------------------------------------

test "valid accepts non-negative shapes" {
    assert shape.valid([2, 3])
    assert shape.valid([])
    assert shape.valid([0, 0])

}

test "valid rejects a negative dimension" {
    assert not shape.valid([1, -1])

}

test "rank reports the rank" {
    assert shape.rank([2, 3]) ≡ 2
    assert shape.rank([]) ≡ 0
    assert shape.rank([2, 3, 4]) ≡ 3

}

test "numel is the element product" {
    const _ trap_result_1 ← trap {

        assert shape.numel([2, 3]) ≡ 6
        assert shape.numel([]) ≡ 1
        assert shape.numel([2, 0, 3]) ≡ 0
    }
    assert trap_result_1 is void
}

# -- bounds and ceilings (GI1 precedent) ------------------------------------

test "numel rejects a negative dimension" {
    const _ outcome ← trap {
        shape.numel([-1])
    }
    const shape.ShapeError err ← outcome
    assert err.message ≡ "negative dimension"
}

test "numel admits a vocab-scale dimension (no general per-dim cap)" {
    const _ trap_result_2 ← trap {

        assert shape.numel([70000]) ≡ 70000
        assert shape.numel([152064]) ≡ 152064
        assert shape.numel([128000]) ≡ 128000
    }
    assert trap_result_2 is void
}

test "numel rejects an element count above the ceiling" {
    const _ outcome ← trap {

        shape.numel([1000000000, 2])
        assert false
    }
    const shape.ShapeError err ← outcome
    assert err.message ≡ "element count above ceiling"
}

# -- broadcast --------------------------------------------------------------

test "broadcast right-aligns and pads with singletons" {
    const _ trap_result_3 ← trap {

        assert shape.broadcast([2, 3], [3]) ≡ ([2, 3] ↦ list<int>)
        assert shape.broadcast([2, 3], []) ≡ ([2, 3] ↦ list<int>)
        const list<int> scalar ← shape.broadcast([], [])
        assert shape.numel(scalar) ≡ 1
    }
    assert trap_result_3 is void
}

test "broadcast unifies singleton dimensions" {
    const _ trap_result_4 ← trap {

        assert shape.broadcast([1, 4], [2, 1]) ≡ ([2, 4] ↦ list<int>)
        assert shape.broadcast([2, 3], [1, 3]) ≡ ([2, 3] ↦ list<int>)
        assert shape.broadcast([3, 1], [2, 3, 1]) ≡ ([2, 3, 1] ↦ list<int>)
    }
    assert trap_result_4 is void
}

test "broadcast expands implicit leading 1 ([8] onto [2, 8])" {
    const _ trap_result_5 ← trap {

        assert shape.broadcast([8], [2, 8]) ≡ ([2, 8] ↦ list<int>)
        assert shape.broadcast([2, 8], [8]) ≡ ([2, 8] ↦ list<int>)
        assert shape.broadcast([1, 8], [2, 8]) ≡ ([2, 8] ↦ list<int>)
        assert shape.broadcast([2, 1], [2, 8]) ≡ ([2, 8] ↦ list<int>)
    }
    assert trap_result_5 is void
}

test "broadcast rejects incompatible dimensions" {
    const _ outcome ← trap {

        shape.broadcast([2, 3], [4, 3])
        assert false
    }
    const shape.ShapeError err ← outcome
    assert err.message ≡ "shapes not broadcastable"
}

test "broadcast rejects a negative input dimension" {
    const _ outcome ← trap {

        shape.broadcast([2, -1], [3])
        assert false
    }
    const shape.ShapeError err ← outcome
    assert err.message ≡ "negative dimension"
}

# -- reshape ----------------------------------------------------------------

test "reshape preserves the element count" {
    const _ trap_result_6 ← trap {

        assert shape.reshape([2, 3], [6]) ≡ ([6] ↦ list<int>)
        assert shape.reshape([2, 3], [3, 2]) ≡ ([3, 2] ↦ list<int>)
        assert shape.reshape([2, 3], [1, 2, 3]) ≡ ([1, 2, 3] ↦ list<int>)
    }
    assert trap_result_6 is void
}

test "reshape infers a single -1 dimension" {
    const _ trap_result_7 ← trap {

        assert shape.reshape([2, 3], [-1]) ≡ ([6] ↦ list<int>)
        assert shape.reshape([2, 3], [2, -1]) ≡ ([2, 3] ↦ list<int>)
        assert shape.reshape([2, 3], [-1, 1]) ≡ ([6, 1] ↦ list<int>)
    }
    assert trap_result_7 is void
}

test "reshape rejects an element-count mismatch" {
    const _ outcome ← trap {

        shape.reshape([2, 3], [4])
        assert false
    }
    const shape.ShapeError err ← outcome
    assert err.message ≡ "element count mismatch"
}

test "reshape rejects more than one inferred dimension" {
    const _ outcome ← trap {

        shape.reshape([2, 3], [-1, -1])
        assert false
    }
    const shape.ShapeError err ← outcome
    assert err.message ≡ "at most one inferred dimension"
}

test "reshape rejects a non-integral inferred dimension" {
    const _ outcome ← trap {

        shape.reshape([2, 3], [5, -1])
        assert false
    }
    const shape.ShapeError err ← outcome
    assert err.message ≡ "inferred dimension not integral"
}

test "reshape rejects a negative dimension other than -1" {
    const _ outcome ← trap {

        shape.reshape([2, 3], [-2])
        assert false
    }
    const shape.ShapeError err ← outcome
    assert err.message ≡ "negative dimension"
}

test "reshape admits an inferred vocab-scale dimension (no per-dim cap)" {
    const _ trap_result_8 ← trap {

        assert shape.reshape([152064, 2], [-1]) ≡ ([304128] ↦ list<int>)
        assert shape.reshape([65536, 2], [-1]) ≡ ([131072] ↦ list<int>)
    }
    assert trap_result_8 is void
}

# -- expand ----------------------------------------------------------------

test "expand pads leading singleton dimensions" {
    const _ trap_result_9 ← trap {

        assert shape.expand([2, 3], 2) ≡ ([2, 3] ↦ list<int>)
        assert shape.expand([2, 3], 4) ≡ ([1, 1, 2, 3] ↦ list<int>)
        assert shape.expand([], 3) ≡ ([1, 1, 1] ↦ list<int>)
    }
    assert trap_result_9 is void
}

test "expand rejects a target rank below the current rank" {
    const _ outcome ← trap {

        shape.expand([2, 3], 1)
        assert false
    }
    const shape.ShapeError err ← outcome
    assert err.message ≡ "target rank below current rank"
}

test "expand rejects a target rank above the rank ceiling" {
    const _ outcome ← trap {

        shape.expand([2], 65)
        assert false
    }
    const shape.ShapeError err ← outcome
    assert err.message ≡ "target rank above ceiling"
}

test "expand rejects a negative input dimension" {
    const _ outcome ← trap {

        shape.expand([1, -1], 2)
        assert false
    }
    const shape.ShapeError err ← outcome
    assert err.message ≡ "negative dimension"
}
