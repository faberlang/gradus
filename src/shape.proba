# Co-located package test for shape.fab (PML1-U3 shape system).
# Not importable; discovered only by the faber test path.
#
# Proves, at compile level: the staged-carrier shape rules — introspection
# (valet / gradus / quantitas), broadcast (right-aligned pairwise, singleton
# 1 dims), reshape (element-count preservation, single -1 inference), expand
# (left-pad singleton dims to a target rank), and the general bounds checks
# (negative dims, element-count ceiling, rank ceiling) with distinct
# FormaError identity. The per-dimension 65536 (GI1 pinned-row) ceiling is a
# support-row/capsule admission fact, NOT general arithmetic: general shape
# math admits vocab-scale rows (128k–152k) within the element ceiling
# (CTO-2 correction, PML1 closeout).
# adfirma assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check` proves the whole surface type-checks.
importa ex "gradus:shape" forma

# -- introspection ---------------------------------------------------------

probandum "shape introspection" {
    proba "valet accepts non-negative shapes" {
        fac {
            adfirma forma.valet([2, 3])
            adfirma forma.valet([])
            adfirma forma.valet([0, 0])
        }
        cape err {
            adfirma falsum
        }
    }

    proba "valet rejects a negative dimension" {
        fac {
            adfirma non forma.valet([1, -1])
        }
        cape err {
            adfirma falsum
        }
    }

    proba "gradus reports the rank" {
        fac {
            adfirma forma.gradus([2, 3]) ≡ 2
            adfirma forma.gradus([]) ≡ 0
            adfirma forma.gradus([2, 3, 4]) ≡ 3
        }
        cape err {
            adfirma falsum
        }
    }

    proba "quantitas is the element product" {
        fac {
            adfirma forma.quantitas([2, 3]) ≡ 6
            adfirma forma.quantitas([]) ≡ 1
            adfirma forma.quantitas([2, 0, 3]) ≡ 0
        }
        cape err {
            adfirma falsum
        }
    }
}

# -- bounds and ceilings (GI1 precedent) ------------------------------------

probandum "shape bounds and ceilings" {
    proba "quantitas rejects a negative dimension" {
        fac {
            forma.quantitas([-1])
            adfirma falsum
        }
        cape err {
            adfirma forma.causa(err) ≡ "negative dimension"
        }
    }

    proba "quantitas admits a vocab-scale dimension (no general per-dim cap)" {
        fac {
            adfirma forma.quantitas([70000]) ≡ 70000
            adfirma forma.quantitas([152064]) ≡ 152064
            adfirma forma.quantitas([128000]) ≡ 128000
        }
        cape err {
            adfirma falsum
        }
    }

    proba "quantitas rejects an element count above the ceiling" {
        fac {
            forma.quantitas([1000000000, 2])
            adfirma falsum
        }
        cape err {
            adfirma forma.causa(err) ≡ "element count above ceiling"
        }
    }
}

# -- broadcast --------------------------------------------------------------

probandum "shape broadcast" {
    proba "broadcast right-aligns and pads with singletons" {
        fac {
            adfirma forma.broadcastum([2, 3], [3]) ≡ [2, 3]
            adfirma forma.broadcastum([2, 3], []) ≡ [2, 3]
            fixum lista<numerus> scalar ← forma.broadcastum([], [])
            adfirma forma.quantitas(scalar) ≡ 1
        }
        cape err {
            adfirma falsum
        }
    }

    proba "broadcast unifies singleton dimensions" {
        fac {
            adfirma forma.broadcastum([1, 4], [2, 1]) ≡ [2, 4]
            adfirma forma.broadcastum([2, 3], [1, 3]) ≡ [2, 3]
            adfirma forma.broadcastum([3, 1], [2, 3, 1]) ≡ [2, 3, 1]
        }
        cape err {
            adfirma falsum
        }
    }

    proba "broadcast rejects incompatible dimensions" {
        fac {
            forma.broadcastum([2, 3], [4, 3])
            adfirma falsum
        }
        cape err {
            adfirma forma.causa(err) ≡ "shapes not broadcastable"
        }
    }

    proba "broadcast rejects a negative input dimension" {
        fac {
            forma.broadcastum([2, -1], [3])
            adfirma falsum
        }
        cape err {
            adfirma forma.causa(err) ≡ "negative dimension"
        }
    }
}

# -- reshape ----------------------------------------------------------------

probandum "shape reshape" {
    proba "reshape preserves the element count" {
        fac {
            adfirma forma.reformanda([2, 3], [6]) ≡ [6]
            adfirma forma.reformanda([2, 3], [3, 2]) ≡ [3, 2]
            adfirma forma.reformanda([2, 3], [1, 2, 3]) ≡ [1, 2, 3]
        }
        cape err {
            adfirma falsum
        }
    }

    proba "reshape infers a single -1 dimension" {
        fac {
            adfirma forma.reformanda([2, 3], [-1]) ≡ [6]
            adfirma forma.reformanda([2, 3], [2, -1]) ≡ [2, 3]
            adfirma forma.reformanda([2, 3], [-1, 1]) ≡ [6, 1]
        }
        cape err {
            adfirma falsum
        }
    }

    proba "reshape rejects an element-count mismatch" {
        fac {
            forma.reformanda([2, 3], [4])
            adfirma falsum
        }
        cape err {
            adfirma forma.causa(err) ≡ "element count mismatch"
        }
    }

    proba "reshape rejects more than one inferred dimension" {
        fac {
            forma.reformanda([2, 3], [-1, -1])
            adfirma falsum
        }
        cape err {
            adfirma forma.causa(err) ≡ "at most one inferred dimension"
        }
    }

    proba "reshape rejects a non-integral inferred dimension" {
        fac {
            forma.reformanda([2, 3], [5, -1])
            adfirma falsum
        }
        cape err {
            adfirma forma.causa(err) ≡ "inferred dimension not integral"
        }
    }

    proba "reshape rejects a negative dimension other than -1" {
        fac {
            forma.reformanda([2, 3], [-2])
            adfirma falsum
        }
        cape err {
            adfirma forma.causa(err) ≡ "negative dimension"
        }
    }

    proba "reshape admits an inferred vocab-scale dimension (no per-dim cap)" {
        fac {
            adfirma forma.reformanda([152064, 2], [-1]) ≡ [304128]
            adfirma forma.reformanda([65536, 2], [-1]) ≡ [131072]
        }
        cape err {
            adfirma falsum
        }
    }
}

# -- expand ----------------------------------------------------------------

probandum "shape expand" {
    proba "expand pads leading singleton dimensions" {
        fac {
            adfirma forma.expansio([2, 3], 2) ≡ [2, 3]
            adfirma forma.expansio([2, 3], 4) ≡ [1, 1, 2, 3]
            adfirma forma.expansio([], 3) ≡ [1, 1, 1]
        }
        cape err {
            adfirma falsum
        }
    }

    proba "expand rejects a target rank below the current rank" {
        fac {
            forma.expansio([2, 3], 1)
            adfirma falsum
        }
        cape err {
            adfirma forma.causa(err) ≡ "target rank below current rank"
        }
    }

    proba "expand rejects a target rank above the rank ceiling" {
        fac {
            forma.expansio([2], 65)
            adfirma falsum
        }
        cape err {
            adfirma forma.causa(err) ≡ "target rank above ceiling"
        }
    }

    proba "expand rejects a negative input dimension" {
        fac {
            forma.expansio([1, -1], 2)
            adfirma falsum
        }
        cape err {
            adfirma forma.causa(err) ≡ "negative dimension"
        }
    }
}
