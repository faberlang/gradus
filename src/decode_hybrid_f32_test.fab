+++ toml
locale = "en"

+++ faber test
import from "gradus:decode_hybrid" let dh
import from "gradus:decode_token" let dt
import from "gradus:cache/hybrid_arenas" let hybrid
import from "gradus:model/config" let cfg
import from "gradus:model/schedule" let model_schedule
import from "gradus:model/expert_bank" let eb

fn must_sched(string json) → model_schedule.ExecutionSchedule {
    mut list<cfg.ModelConfig> mcs ← empty
    do {
        mcs.append(cfg.parse_json(json))
    }
    catch err {
        assert false
    }
    assert mcs.length() ≡ 1
    do {
        return model_schedule.from_model_config(mcs[0], empty)
    }
    catch err {
        assert false
    }
    return model_schedule.ExecutionSchedule { layers = [], segments = [], steps = [], slots = [], residual = variant model_schedule.ResidualKind.Standard, taps = [] }
}

test "decode_hybrid_f32_test qwen36_hybrid_layer_step dispatches RecurrentSsm and FullKv over HybridSession" {
    let string q36_json ← «{"model_type": "qwen35moe", "hidden_size": 2, "num_hidden_layers": 2, "num_attention_heads": 1, "num_key_value_heads": 1, "head_dim": 2, "intermediate_size": 2, "moe_intermediate_size": 2, "shared_expert_intermediate_size": 2, "vocab_size": 32, "full_attention_interval": 2, "rope_dimension_sections": [1, 0, 0, 0], "num_local_experts": 2, "num_experts_per_tok": 2}»
    let model_schedule.ExecutionSchedule sched ← must_sched(q36_json)
    mut list<model_schedule.ExecutionStep> steps ← empty
    do {
        steps.append(model_schedule.step_at(sched, 0))
        steps.append(model_schedule.step_at(sched, 1))
    }
    catch err {
        assert false
    }
    mut list<hybrid.HybridSession<8, 1, 2, 3, 6, 2, 2>> hs_box ← empty
    do {
        hs_box.append(hybrid.from_schedule<size 8, size 1, size 2, size 3, size 6, size 2, size 2>(sched, 1, 3, false))
    }
    catch err {
        assert false
    }
    mut hybrid.HybridSession<8, 1, 2, 3, 6, 2, 2> hs ← hs_box[0]

    mut tensor<f32, [2]> hin ← tf32[2] {}
    hin[[0]] ← 1.0
    hin[[1]] ← 1.0
    mut tensor<f32, [2]> ones2 ← tf32[2] {}
    ones2[[0]] ← 1.0
    ones2[[1]] ← 1.0

    mut tensor<f32, [4, 2]> wq_2qd ← tf32[4, 2] {}
    wq_2qd[[0, 0]] ← 1.0
    wq_2qd[[1, 1]] ← 1.0
    wq_2qd[[2, 0]] ← 2.0
    mut tensor<f32, [2, 2]> eye2 ← tf32[2, 2] {}
    eye2[[0, 0]] ← 1.0
    eye2[[1, 1]] ← 1.0
    let dh.Qwen36FullAttnWeights<2, 4, 2, 2, 2, 1> faw ← dh.Qwen36FullAttnWeights<2, 4, 2, 2, 2, 1> {
        anorm = ones2, wq = wq_2qd, wk = eye2, wv = eye2, wo = eye2,
        has_qk_norm = true, q_norm = ones2, k_norm = ones2
    }
    let dh.FlintAttnParams ap ← dh.FlintAttnParams {
        dh = 2, span = 1, group = 1, rope = variant dt.RopeKind.Half,
        eps = 0.00001, lntheta = 0.0, scale = 0.70710677
    }
    mut tensor<i32, [4]> sections ← ti32[4] {}
    sections[[0]] ← 1

    mut tensor<f32, [6, 2]> wqkv ← tf32[6, 2] {}
    wqkv[[0, 0]] ← 1.0
    wqkv[[2, 0]] ← 1.0
    wqkv[[4, 0]] ← 1.0
    mut tensor<f32, [2, 2]> wgate ← tf32[2, 2] {}
    wgate[[0, 0]] ← 1.0
    mut tensor<f32, [6, 4]> conv_w ← tf32[6, 4] {}
    conv_w[[0, 3]] ← 1.0
    conv_w[[2, 3]] ← 1.0
    conv_w[[4, 3]] ← 1.0
    let tensor<f32, [1]> dt_bias ← tf32[1] {}
    mut tensor<f32, [1]> a_row ← tf32[1] {}
    a_row[[0]] ← -1.0
    let tensor<f32, [1, 2]> wba ← tf32[1, 2] {}
    mut tensor<f32, [2, 2]> wout ← tf32[2, 2] {}
    wout[[0, 0]] ← 1.0
    let dh.LinearAttnWeights<2, 6, 2, 1, 4, 2> law ← dh.LinearAttnWeights<2, 6, 2, 1, 4, 2> {
        anorm = ones2, wqkv = wqkv, wgate = wgate, conv_w = conv_w,
        dt_bias = dt_bias, a_row = a_row, wbeta = wba, walpha = wba,
        ssm_norm = ones2, wout = wout
    }
    let dh.LinearAttnParams lp ← dh.LinearAttnParams {
        group_heads = 1, key_dim = 2, eps = 0.00001, site_idx = 0, history_len = 3
    }

    let eb.BankedMatrixSpec sp ← eb.BankedMatrixSpec {
        kind = variant eb.ExpertWeightKind.DenseF32,
        expert_count = 2, out_features = 2, in_features = 2,
        bits = 0, group_size = 0, packed_cols = 0, group_cols = 0
    }
    let eb.ExpertBank bank ← eb.ExpertBank {
        expert_count = 2, hidden_size = 2, intermediate_size = 2,
        layout = variant eb.ExpertBankLayout.SplitGateUp { gate = sp, up = sp, down = sp },
        has_router_bias = false, shared_expert_count = 1
    }
    mut tensor<f32, [2, 2]> router ← tf32[2, 2] {}
    router[[1, 0]] ← 2.0
    mut tensor<f32, [4, 2]> e_wg ← tf32[4, 2] {}
    e_wg[[0, 0]] ← 1.0
    e_wg[[2, 0]] ← 1.0
    mut tensor<f32, [4, 2]> e_wu ← tf32[4, 2] {}
    e_wu[[0, 0]] ← 1.0
    e_wu[[2, 0]] ← 1.0
    mut tensor<f32, [4, 2]> e_wd ← tf32[4, 2] {}
    e_wd[[0, 0]] ← 1.0
    e_wd[[2, 0]] ← 2.0
    mut tensor<f32, [2, 2]> sw ← tf32[2, 2] {}
    sw[[0, 0]] ← 0.5
    mut tensor<f32, [1, 2]> sgw ← tf32[1, 2] {}
    sgw[[0, 0]] ← 1.0

    mut tensor<f32, [2]> h_mid ← tf32[2] {}
    mut tensor<f32, [2]> hout ← tf32[2] {}
    mut tensor<i32, [2]> top_idx ← ti32[2] {}

    do {
        dh.qwen36_hybrid_layer_step<size 8, size 1, size 2, size 2, size 6, size 2, size 1, size 4, size 2, size 3, size 4, size 2, size 2, size 1, size 2, size 4, size 4, size 2, size 2, size 2>(steps[0], hin, mut h_mid, faw, ap, sections, law, lp, bank, ones2, router, e_wg, e_wu, e_wd, true, sw, sw, sw, true, sgw, mut hs, 0, mut top_idx)
        dh.qwen36_hybrid_layer_step<size 8, size 1, size 2, size 2, size 6, size 2, size 1, size 4, size 2, size 3, size 4, size 2, size 2, size 1, size 2, size 4, size 4, size 2, size 2, size 2>(steps[1], h_mid, mut hout, faw, ap, sections, law, lp, bank, ones2, router, e_wg, e_wu, e_wd, true, sw, sw, sw, true, sgw, mut hs, 0, mut top_idx)
    }
    catch err {
        assert false
    }

    assert hs.conv.steps_written[0] ≡ 1
    assert hs.recurrent.steps_written[0] ≡ 1
    assert hs.kv.full_kv.lengths[0] ≡ 1
    assert h_mid[[0]] ≻ hin[[0]]
    assert hout[[0]] ≻ h_mid[[0]]
}
