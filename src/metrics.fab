+++
locale = "en"
+++
# Metrics facade — defined values with a deterministic contract (PML4-U5).
#
# Public import: importa ex "gradus:metrics" privata metricae
# Depends on: gradus:dtype (tags/finita), gradus:tensor (value carrier).
#
# Architectural rule: a metric is a defined VALUE over the tensor surface,
# never a training-loop concern and never a hidden-state holder. This
# module must not import from gradus:optimize, gradus:gradient, or
# gradus:train. No module owns a backend or device handle.
#
# =========================================================================
# The metric contract (pml4-delivery.md PML4-U5)
# =========================================================================
#
# --- Defined values, deterministic --------------------------------------
#   * accuratezza(prediction, target) = (1/N)·Σ_n [argmax_c pred[n,c] ==
#     target[n]] — top-1 classification accuracy over the class axis.
#     Deterministic: fixed row-major iteration, no RNG, no hidden state;
#     ties in argmax go to the LOWEST class index (documented tie-break —
#     strict greater-than keeps the first maximal class). Equal inputs
#     produce bit-identical output. Fails closed (typed MetricError) on
#     rank/dtype/shape/empty/non-finite/class-range violations — the
#     capsule rule.
#   * Metricum — the per-step metric record: loss (damnum) + accuracy
#     (accuratezza). The loss is the loss surface's value (gradus:loss —
#     mse / cross_entropy), carried as a defined value; this module does
#     not re-derive it. The record validates its fields fail-closed
#     (finite loss, accuracy in [0, 1]).
#
# --- Shared with the GPU-training lane's accepted facts -----------------
#   * the classification path's target vocabulary is the cross_entropy
#     contract (rank-1 i32 class indices, in [0, C)); prediction is rank-2
#     [N, C] f32 — the next-token / classification rows.
#   * per-step loss + accuracy are the accepted training-proof metrics
#     (the exit gate's per-step loss trace; accuracy is the classification
#     evaluation metric).
#
# --- Evidence honesty (CTO Q2, hard) ------------------------------------
# This surface is the STRUCTURAL proof: the accuracy formula (argmax +
# tie-break + deterministic iteration) and the record contract are
# compile-validated and proven by the co-located proba (f64 oracle pins).
# Executed VALUE identity is env-blocked tree-wide today (FMIR stepper /
# library-import gap — recorded residual). PML4-U5 is PARTIAL: metric
# numeric identity is deferred to a runtime-evidence gate (auditor-owned
# faber test path; oracle pins recorded in metrics.proba).
import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# MetricError — typed error vocabulary of the metric contract.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------


@ public { }
union MetricError {
    GradusMismatch {
        string message
    },
    FormaMismatch {
        string message
    },
    TypoMismatch {
        string message
    },
    ElementaMismatch {
        string message
    },
    NonFinita {
        string message
    },
    Incompatibilis {
        string message
    },
    Invalida {
        string message
    }
}

@ public { }
fn message(MetricError e) → string {
    match e {
        case GradusMismatch const message {
            return message
        }
        case FormaMismatch const message {
            return message
        }
        case TypoMismatch const message {
            return message
        }
        case ElementaMismatch const message {
            return message
        }
        case NonFinita const message {
            return message
        }
        case Incompatibilis const message {
            return message
        }
        case Invalida const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# accuratezza — top-1 classification accuracy over the class axis.
#   prediction: rank-2 [N, C] f32 logits/probabilities;
#   target:     rank-1 [N] i32 class indices (the cross_entropy contract).
# Returns the fraction of rows whose argmax class equals the target.
# Deterministic: fixed row-major iteration; ties go to the lowest class
# index (strict greater-than argmax). Fails closed on every violation.
# -------------------------------------------------------------------------

@ public { }
fn accuracy(tensor.Tensor prediction, tensor.Tensor target) → f32 ⇥ MetricError {
    const list<int> fp ← prediction.shape()
    if fp.length() ≠ 2 {
        throw variant GradusMismatch {message = "accuracy requires rank-2 predictions"}
    }
    if dtype.name(prediction.dtype()) ≠ "f32" {
        throw variant TypoMismatch {message = "unsupported dtype for metric"}
    }
    const int n ← fp.get(0) coalesce 1
    const int c ← fp.get(1) coalesce 1
    if n ≡ 0 {
        throw variant ElementaMismatch {message = "empty batch"}
    }
    if c ≡ 0 {
        throw variant ElementaMismatch {message = "empty class axis"}
    }
    const list<int> ft ← target.shape()
    if ft.length() ≠ 1 {
        throw variant GradusMismatch {message = "accuracy target must be rank-1"}
    }
    if ft.get(0) coalesce 1 ≠ n {
        throw variant FormaMismatch {message = "target length does not match predictions rows"}
    }
    if dtype.name(target.dtype()) ≠ "i32" {
        throw variant TypoMismatch {message = "accuracy target must be i32 class indices"}
    }
    for from prediction.data const v {
        if not dtype.finite(v) {
            throw variant NonFinita {message = "non-finite prediction"}
        }
    }
    var int recta ← 0
    var int row ← 0
    while row ≺ n {
        const f32 lbl ← target.data.get(row) coalesce 0.0 ∷ f32
        if not dtype.finite(lbl) {
            throw variant NonFinita {message = "non-finite target"}
        }
        const int k ← lbl.truncate()
        if not ((k ↦ f32) ≡ lbl) {
            throw variant Incompatibilis {message = "target must be integer class indices"}
        }
        if k ≺ 0 or k ≥ c {
            throw variant Incompatibilis {message = "target class out of range"}
        }
        var int best ← 0
        var f32 best_v ← prediction.data.get(row * c) coalesce 0.0 ∷ f32
        var int j ← 1
        while j ≺ c {
            const f32 z ← prediction.data.get(row * c + j) coalesce 0.0 ∷ f32
            if z ≻ best_v {
                best_v ← z
                best ← j
            }
            j ← j + 1
        }
        if best ≡ k {
            recta ← recta + 1
        }
        row ← row + 1
    }
    return (recta ↦ f32) / (n ↦ f32)
}

# -------------------------------------------------------------------------
# Metricum — the per-step metric record: loss (damnum) + accuracy.
# Defined values with a validated, deterministic contract; equal inputs
# produce equal records.
# -------------------------------------------------------------------------


@ public { }
class Metric {
    f32 loss
    f32 accuracy

    # The step's loss (the loss surface's value, carried).
    fn loss() → f32 {
        return self.loss
    }

    # The step's accuracy.
    fn accuracy() → f32 {
        return self.accuracy
    }
}

# Build a per-step metric record. Fail closed: the loss must be finite,
# the accuracy finite and in [0, 1].
@ public { }
fn metric(f32 loss, f32 accuracy) → Metric ⇥ MetricError {
    if not dtype.finite(loss) {
        throw variant Invalida {message = "loss must be finite"}
    }
    if not dtype.finite(accuracy) {
        throw variant Invalida {message = "accuracy must be finite"}
    }
    if accuracy ≺ 0.0 or accuracy ≻ 1.0 {
        throw variant Invalida {message = "accuracy must be in [0, 1]"}
    }
    return Metric {loss = loss, accuracy = accuracy}
}

# Field-wise metric equality.
@ public { }
fn metric_equal(Metric a, Metric b) → bool {
    if a.loss() ≠ b.loss() then return false
    if a.accuracy() ≠ b.accuracy() then return false
    return true
}
