# Defined metrics over the tensor value surface.
#
# Public import: import from "gradus:metrics" metrics
# Depends on: gradus:dtype (dtype names and finite checks),
#   gradus:tensor (numeric value carriers).
#
# The module owns top-1 accuracy and the per-step Metric record. Accuracy is
# deterministic: rows are visited in order and equal maxima choose the lowest
# class index. Loss is carried in from gradus:loss; this module does not
# recompute it. No training loop, hidden state, backend, or device handle
# belongs here.

import from "gradus:dtype" dtype

import from "gradus:tensor" tensor

# --- metric error vocabulary ---------------------------------------------

@ public
union MetricError {
    @ shared
    string message

    GradusMismatch,
    ShapeMismatch,
    DtypeMismatch,
    ElementMismatch,
    NonFinite,
    Incompatible,
    Invalid
}

# --- top-1 accuracy -------------------------------------------------------
# Prediction is rank-2 [N, C] f32 data. Target is rank-1 [N] i32 class data,
# matching the cross-entropy classification contract.

@ public
fn accuracy(tensor.NumericBlock prediction, tensor.NumericBlock target) → f32 ⇥ MetricError {
    const list<int> fp ← prediction.shape
    require fp.length() ≡ 2 throw variant GradusMismatch { message = "accuracy requires rank-2 predictions" }
    require dtype.name(prediction.dtype) ≡ "f32" throw variant DtypeMismatch { message = "unsupported dtype for metric" }
    const int n ← fp.get(0) coalesce 1
    const int c ← fp.get(1) coalesce 1
    require n ≠ 0 throw variant ElementMismatch { message = "empty batch" }
    require c ≠ 0 throw variant ElementMismatch { message = "empty class axis" }
    const list<int> ft ← target.shape
    require ft.length() ≡ 1 throw variant GradusMismatch { message = "accuracy target must be rank-1" }
    require ft.get(0) coalesce 1 ≡ n throw variant ShapeMismatch { message = "target length does not match predictions rows" }
    require dtype.name(target.dtype) ≡ "i32" throw variant DtypeMismatch { message = "accuracy target must be i32 class indices" }
    for from prediction.data const value {
        require dtype.finite(value) throw variant NonFinite { message = "non-finite prediction" }
    }
    var int correct ← 0
    # NumericBlock data is flat, and row drives the prediction stride.
    for range 0 ‥ n const row {
        const f32 label ← target.data.get(row) coalesce 0.0
        require dtype.finite(label) throw variant NonFinite { message = "non-finite target" }
        const int k ← label.truncate()
        require (k ↦ f32) ≡ label throw variant Incompatible { message = "target must be integer class indices" }
        reject k ≺ 0 or k ≥ c throw variant Incompatible { message = "target class out of range" }
        var list<f32> row_values ← empty
        for range 0 ‥ c const j {
            row_values.append(prediction.data.get(row * c + j) coalesce 0.0)
        }
        const int best ← row_values.argmax() coalesce 0
        if best ≡ k {
            correct ← correct + 1
        }
    }
    return (correct ↦ f32) / (n ↦ f32)
}

# --- per-step metric -----------------------------------------------------

@ public
class Metric {
    f32 loss
    f32 accuracy
}

@ public
fn metric(f32 loss, f32 accuracy) → Metric ⇥ MetricError {
    require dtype.finite(loss) throw variant Invalid { message = "loss must be finite" }
    require dtype.finite(accuracy) throw variant Invalid { message = "accuracy must be finite" }
    reject accuracy ≺ 0.0 or accuracy ≻ 1.0 throw variant Invalid { message = "accuracy must be in [0, 1]" }
    return Metric { loss = loss, accuracy = accuracy }
}

# Placeholder for mutable Metric bindings and unreachable recovery arms.
@ public
fn default() → Metric {
    return Metric { loss = 0.0, accuracy = 0.0 }
}

@ public
fn metric_equal(Metric a, Metric b) → bool {
    if a.loss ≠ b.loss then return false
    if a.accuracy ≠ b.accuracy then return false
    return true
}
