# Metrics facade — defined values with a deterministic contract (PML4-U5).
#
# Public import: importa ex "gradus:metrics" privata metricae
# Depends on: gradus:dtype (tags/finita), gradus:tensor (value carrier).
#
# Architectural rule: a metric is a defined VALUE over the tensor surface,
# never a training-loop concern and never a hidden-state holder. This
# module must not import from gradus:optimize, gradus:gradient, or
# gradus:train. No module owns a backend or device handle.
#
# =========================================================================
# The metric contract (pml4-delivery.md PML4-U5)
# =========================================================================
#
# --- Defined values, deterministic --------------------------------------
#   * accuratezza(prediction, target) = (1/N)·Σ_n [argmax_c pred[n,c] ==
#     target[n]] — top-1 classification accuracy over the class axis.
#     Deterministic: fixed row-major iteration, no RNG, no hidden state;
#     ties in argmax go to the LOWEST class index (documented tie-break —
#     strict greater-than keeps the first maximal class). Equal inputs
#     produce bit-identical output. Fails closed (typed MetricError) on
#     rank/dtype/shape/empty/non-finite/class-range violations — the
#     capsule rule.
#   * Metricum — the per-step metric record: loss (damnum) + accuracy
#     (accuratezza). The loss is the loss surface's value (gradus:loss —
#     mse / cross_entropy), carried as a defined value; this module does
#     not re-derive it. The record validates its fields fail-closed
#     (finite loss, accuracy in [0, 1]).
#
# --- Shared with the GPU-training lane's accepted facts -----------------
#   * the classification path's target vocabulary is the cross_entropy
#     contract (rank-1 i32 class indices, in [0, C)); prediction is rank-2
#     [N, C] f32 — the next-token / classification rows.
#   * per-step loss + accuracy are the accepted training-proof metrics
#     (the exit gate's per-step loss trace; accuracy is the classification
#     evaluation metric).
#
# --- Evidence honesty (CTO Q2, hard) ------------------------------------
# This surface is the STRUCTURAL proof: the accuracy formula (argmax +
# tie-break + deterministic iteration) and the record contract are
# compile-validated and proven by the co-located proba (f64 oracle pins).
# Executed VALUE identity is env-blocked tree-wide today (FMIR stepper /
# library-import gap — recorded residual). PML4-U5 is PARTIAL: metric
# numeric identity is deferred to a runtime-evidence gate (auditor-owned
# faber test path; oracle pins recorded in metrics.proba).
importa ex "gradus:dtype" dtype
importa ex "gradus:tensor" tensor

# -------------------------------------------------------------------------
# MetricError — typed error vocabulary of the metric contract.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------

discretio MetricError {
    GradusMismatch { textus causa },
    FormaMismatch { textus causa },
    TypoMismatch { textus causa },
    ElementaMismatch { textus causa },
    NonFinita { textus causa },
    Incompatibilis { textus causa },
    Invalida { textus causa }
}

functio causa(MetricError e) → textus {
    discerne e {
        casu GradusMismatch fixum causa { redde causa }
        casu FormaMismatch fixum causa { redde causa }
        casu TypoMismatch fixum causa { redde causa }
        casu ElementaMismatch fixum causa { redde causa }
        casu NonFinita fixum causa { redde causa }
        casu Incompatibilis fixum causa { redde causa }
        casu Invalida fixum causa { redde causa }
    }
}

# -------------------------------------------------------------------------
# accuratezza — top-1 classification accuracy over the class axis.
#   prediction: rank-2 [N, C] f32 logits/probabilities;
#   target:     rank-1 [N] i32 class indices (the cross_entropy contract).
# Returns the fraction of rows whose argmax class equals the target.
# Deterministic: fixed row-major iteration; ties go to the lowest class
# index (strict greater-than argmax). Fails closed on every violation.
# -------------------------------------------------------------------------

functio accuratezza(tensor.Tensor prediction, tensor.Tensor target) → f32 ⇥ MetricError {
    fixum lista<numerus> fp ← prediction.figura()
    si fp.longitudo() ≠ 2 {
        iace finge GradusMismatch { causa = "accuracy requires rank-2 predictions" }
    }
    si dtype.nomen(prediction.typus()) ≠ "f32" {
        iace finge TypoMismatch { causa = "unsupported dtype for metric" }
    }
    fixum numerus n ← fp.accipe(0) vel 1
    fixum numerus c ← fp.accipe(1) vel 1
    si n ≡ 0 {
        iace finge ElementaMismatch { causa = "empty batch" }
    }
    si c ≡ 0 {
        iace finge ElementaMismatch { causa = "empty class axis" }
    }
    fixum lista<numerus> ft ← target.figura()
    si ft.longitudo() ≠ 1 {
        iace finge GradusMismatch { causa = "accuracy target must be rank-1" }
    }
    si (ft.accipe(0) vel 1) ≠ n {
        iace finge FormaMismatch { causa = "target length does not match predictions rows" }
    }
    si dtype.nomen(target.typus()) ≠ "i32" {
        iace finge TypoMismatch { causa = "accuracy target must be i32 class indices" }
    }
    itera ex prediction.datos fixum v {
        si non (dtype.finita(v)) {
            iace finge NonFinita { causa = "non-finite prediction" }
        }
    }
    varia numerus recta ← 0
    varia numerus row ← 0
    dum row < n {
        fixum f32 lbl ← target.datos.accipe(row) vel (0.0 ∷ f32)
        si non (dtype.finita(lbl)) {
            iace finge NonFinita { causa = "non-finite target" }
        }
        fixum numerus k ← lbl.trunca()
        si non ((k ↦ f32) ≡ lbl) {
            iace finge Incompatibilis { causa = "target must be integer class indices" }
        }
        si k < 0 aut k ≥ c {
            iace finge Incompatibilis { causa = "target class out of range" }
        }
        varia numerus best ← 0
        varia f32 best_v ← prediction.datos.accipe(row * c) vel (0.0 ∷ f32)
        varia numerus j ← 1
        dum j < c {
            fixum f32 z ← prediction.datos.accipe(row * c + j) vel (0.0 ∷ f32)
            si z > best_v {
                best_v ← z
                best ← j
            }
            j ← j + 1
        }
        si best ≡ k {
            recta ← recta + 1
        }
        row ← row + 1
    }
    redde (recta ↦ f32) / (n ↦ f32)
}

# -------------------------------------------------------------------------
# Metricum — the per-step metric record: loss (damnum) + accuracy.
# Defined values with a validated, deterministic contract; equal inputs
# produce equal records.
# -------------------------------------------------------------------------

@ publica
genus Metricum {
    f32 damnum
    f32 accuratezza

    # The step's loss (the loss surface's value, carried).
    functio damnum() → f32 {
        redde ego.damnum
    }

    # The step's accuracy.
    functio accuratezza() → f32 {
        redde ego.accuratezza
    }
}

# Build a per-step metric record. Fail closed: the loss must be finite,
# the accuracy finite and in [0, 1].
@ publica
functio metricum(f32 damnum, f32 accuratezza) → Metricum ⇥ MetricError {
    si non (dtype.finita(damnum)) {
        iace finge Invalida { causa = "loss must be finite" }
    }
    si non (dtype.finita(accuratezza)) {
        iace finge Invalida { causa = "accuracy must be finite" }
    }
    si accuratezza < 0.0 aut accuratezza > 1.0 {
        iace finge Invalida { causa = "accuracy must be in [0, 1]" }
    }
    redde Metricum { damnum = damnum, accuratezza = accuratezza }
}

# Field-wise metric equality.
functio metrica_aequus(Metricum a, Metricum b) → bivalens {
    si a.damnum() ≠ b.damnum() ergo redde falsum
    si a.accuratezza() ≠ b.accuratezza() ergo redde falsum
    redde verum
}
