+++ toml
locale = "en"

+++ faber
# Slice A decode driver: end-to-end B=1 quantized decode over ModelBundle,
# TensorDirectory, ModelConfig, GroupAffine 8-bit LinearWeight,
# ExecutionSchedule, SessionState, and record-typed decode_token (issue #52).
#
# Public import: import from "gradus:decode_slice_a" slice_a
# Depends on: gradus:decode_step, gradus:decode_token, gradus:cache/session,
#   gradus:model/bundle, gradus:model/config, gradus:model/linear_weight,
#   gradus:model/schedule, gradus:model/tensor_directory.
#
# --- Contract ------------------------------------------------------------
#
# Connects Seams 1-5 without literal model dimensions or NumericBlock:
#   1. Admit ModelBundle + TensorDirectory + ModelConfig.
#   2. Bind uniform GroupAffine 8-bit (u32, group_size = 64) LinearWeight
#      operators for embed_tokens, per-layer q/k/v/o/gate/up/down, and lm_head.
#   3. Build dense ExecutionSchedule (LinearSegment) and allocate SessionState
#      (FullKvArena) from ModelConfig.num_hidden_layers and KV extents.
#   4. Execute B=1 decode steps over record-typed QuantizedLayerWeights,
#      decode_token.SlotView, decode_token.LayerParams, and
#      decode_token.Workspace using linear_weight.dispatch_group_affine_u32
#      and gather_group_affine_u32 directly on device (CPU and Metal).

import from "gradus:cache/session" let sess_mod
import from "gradus:decode_stages" let stages
import from "gradus:decode_step" let ds
import from "gradus:decode_token" let dt
import from "gradus:model/artifact" let artifact
import from "gradus:model/bundle" let bundle
import from "gradus:model/capsule" let capsule
import from "gradus:model/config" let cfg
import from "gradus:model/linear_weight" let lw
import from "gradus:model/schedule" let model_schedule
import from "gradus:model/tensor_directory" let td

@ public
union SliceAError {
    @ shared
    string message

    BadConfig {
        cfg.ConfigError inner
    },
    BadBundle {
        bundle.BundleError inner
    },
    BadDirectory {
        td.DirectoryError inner
    },
    BadLinearWeight {
        lw.LinearWeightError inner
    },
    BadSchedule {
        model_schedule.ScheduleError inner
    },
    BadSession {
        sess_mod.SessionError inner
    },
    BadShape,
    UnsupportedQuant,
    BadPosition
}

@ conversion
fn from_config_error(cfg.ConfigError err) → SliceAError {
    return variant BadConfig { message = err.message, inner = err }
}

@ conversion
fn from_bundle_error(bundle.BundleError err) → SliceAError {
    return variant BadBundle { message = err.message, inner = err }
}

@ conversion
fn from_directory_error(td.DirectoryError err) → SliceAError {
    return variant BadDirectory { message = err.message, inner = err }
}

@ conversion
fn from_linear_weight_error(lw.LinearWeightError err) → SliceAError {
    return variant BadLinearWeight { message = err.message, inner = err }
}

@ conversion
fn from_schedule_error(model_schedule.ScheduleError err) → SliceAError {
    return variant BadSchedule { message = err.message, inner = err }
}

@ conversion
fn from_session_error(sess_mod.SessionError err) → SliceAError {
    return variant BadSession { message = err.message, inner = err }
}

# -------------------------------------------------------------------------
# Admitted operator descriptors (Seams 1-3)
# -------------------------------------------------------------------------

@ public
class LayerDescriptors {
    let int layer_index
    let lw.LinearWeight q_proj
    let lw.LinearWeight k_proj
    let lw.LinearWeight v_proj
    let lw.LinearWeight o_proj
    let lw.LinearWeight gate_proj
    let lw.LinearWeight up_proj
    let lw.LinearWeight down_proj
}

@ public
class ModelDescriptors {
    let cfg.ModelConfig config
    let lw.LinearWeight embed_tokens
    let lw.LinearWeight lm_head
    let list<LayerDescriptors> layers
}

# -------------------------------------------------------------------------
# Record-typed quantized head weights for B=1 decode.

@ public
class QuantizedLayerWeights<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF> {
    let tensor<f32, [D]> anorm
    let lw.LinearWeight wq_desc
    let tensor<u32, [QD, PD]> wq_w
    let tensor<f32, [QD, GD]> wq_s
    let tensor<f32, [QD, GD]> wq_b
    let lw.LinearWeight wk_desc
    let tensor<u32, [KVD, PD]> wk_w
    let tensor<f32, [KVD, GD]> wk_s
    let tensor<f32, [KVD, GD]> wk_b
    let lw.LinearWeight wv_desc
    let tensor<u32, [KVD, PD]> wv_w
    let tensor<f32, [KVD, GD]> wv_s
    let tensor<f32, [KVD, GD]> wv_b
    let lw.LinearWeight wo_desc
    let tensor<u32, [D, PQD]> wo_w
    let tensor<f32, [D, GQD]> wo_s
    let tensor<f32, [D, GQD]> wo_b
    let tensor<f32, [D]> fnorm
    let lw.LinearWeight wg_desc
    let tensor<u32, [F, PD]> wg_w
    let tensor<f32, [F, GD]> wg_s
    let tensor<f32, [F, GD]> wg_b
    let lw.LinearWeight wu_desc
    let tensor<u32, [F, PD]> wu_w
    let tensor<f32, [F, GD]> wu_s
    let tensor<f32, [F, GD]> wu_b
    let lw.LinearWeight wd_desc
    let tensor<u32, [D, PF]> wd_w
    let tensor<f32, [D, GF]> wd_s
    let tensor<f32, [D, GF]> wd_b
    let bool qkv_bias
    let tensor<f32, [QD]> bq
    let tensor<f32, [KVD]> bk
    let tensor<f32, [KVD]> bv
}

@ public
class QuantizedHeadWeights<size V, size D, size PD, size GD> {
    let lw.LinearWeight embed_desc
    let tensor<u32, [V, PD]> embed_w
    let tensor<f32, [V, GD]> embed_s
    let tensor<f32, [V, GD]> embed_b
    let lw.LinearWeight head_desc
    let tensor<u32, [V, PD]> head_w
    let tensor<f32, [V, GD]> head_s
    let tensor<f32, [V, GD]> head_b
    let tensor<f32, [D]> onorm
}

@ public
class QuantizedLayerWeightsBf16<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF> {
    let tensor<f32, [D]> anorm
    let lw.LinearWeight wq_desc
    let tensor<u32, [QD, PD]> wq_w
    let tensor<bf16, [QD, GD]> wq_s
    let tensor<bf16, [QD, GD]> wq_b
    let lw.LinearWeight wk_desc
    let tensor<u32, [KVD, PD]> wk_w
    let tensor<bf16, [KVD, GD]> wk_s
    let tensor<bf16, [KVD, GD]> wk_b
    let lw.LinearWeight wv_desc
    let tensor<u32, [KVD, PD]> wv_w
    let tensor<bf16, [KVD, GD]> wv_s
    let tensor<bf16, [KVD, GD]> wv_b
    let lw.LinearWeight wo_desc
    let tensor<u32, [D, PQD]> wo_w
    let tensor<bf16, [D, GQD]> wo_s
    let tensor<bf16, [D, GQD]> wo_b
    let tensor<f32, [D]> fnorm
    let lw.LinearWeight wg_desc
    let tensor<u32, [F, PD]> wg_w
    let tensor<bf16, [F, GD]> wg_s
    let tensor<bf16, [F, GD]> wg_b
    let lw.LinearWeight wu_desc
    let tensor<u32, [F, PD]> wu_w
    let tensor<bf16, [F, GD]> wu_s
    let tensor<bf16, [F, GD]> wu_b
    let lw.LinearWeight wd_desc
    let tensor<u32, [D, PF]> wd_w
    let tensor<bf16, [D, GF]> wd_s
    let tensor<bf16, [D, GF]> wd_b
    let bool qkv_bias
    let tensor<f32, [QD]> bq
    let tensor<f32, [KVD]> bk
    let tensor<f32, [KVD]> bv
}

@ public
class QuantizedHeadWeightsBf16<size V, size D, size PD, size GD> {
    let lw.LinearWeight embed_desc
    let tensor<u32, [V, PD]> embed_w
    let tensor<bf16, [V, GD]> embed_s
    let tensor<bf16, [V, GD]> embed_b
    let lw.LinearWeight head_desc
    let tensor<u32, [V, PD]> head_w
    let tensor<bf16, [V, GD]> head_s
    let tensor<bf16, [V, GD]> head_b
    let tensor<f32, [D]> onorm
}

@ public
class SliceAWorkspace<size D, size QD, size KVD, size F, size H> {
    let tensor<f32, [H]> zero_sink
    mut tensor<f32, [D]> xn
    mut tensor<f32, [QD]> q
    mut tensor<f32, [QD]> qr
    mut tensor<f32, [KVD]> k
    mut tensor<f32, [KVD]> kr
    mut tensor<f32, [KVD]> v
    mut tensor<f32, [QD]> ctx
    mut tensor<f32, [D]> h1
    mut tensor<f32, [F]> gate
    mut tensor<f32, [F]> up
    mut tensor<f32, [F]> act
}

@ public
fn layer_wide_group_affine_u32<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF, size H, size C, size W>(tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, QuantizedLayerWeights<D, QD, KVD, F, PD, GD, PQD, GQD, PF, GF> qlw, mut sess_mod.SessionState<C, W, KVD> session, int slot_id, i32 tpos, dt.LayerParams lp, mut SliceAWorkspace<D, QD, KVD, F, H> ws) → void ⇥ SliceAError {
    stages.norm_rmsnorm<size D>(hin, qlw.anorm, mut ws.xn, lp.peps)

    do {
        stages.linear_project_q8<size QD, size PD, size GD, size D>(qlw.wq_desc, qlw.wq_w, qlw.wq_s, qlw.wq_b, ws.xn, mut ws.q)
        stages.linear_project_q8<size KVD, size PD, size GD, size D>(qlw.wk_desc, qlw.wk_w, qlw.wk_s, qlw.wk_b, ws.xn, mut ws.k)
        stages.linear_project_q8<size KVD, size PD, size GD, size D>(qlw.wv_desc, qlw.wv_w, qlw.wv_s, qlw.wv_b, ws.xn, mut ws.v)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }

    if qlw.qkv_bias {
        do device {
            ds.add_bias(qlw.bq, mut ws.q)
            ds.add_bias(qlw.bk, mut ws.k)
            ds.add_bias(qlw.bv, mut ws.v)
        }
    }

    let tensor<f32, [QD]> q_val ← ws.q
    let tensor<f32, [KVD]> k_val ← ws.k
    let tensor<f32, [KVD]> v_val ← ws.v
    let tensor<f32, [H]> zs ← ws.zero_sink
    mut tensor<f32, [QD]> qr_buf ← tf32[QD] {}
    mut tensor<f32, [KVD]> kr_buf ← tf32[KVD] {}
    mut tensor<f32, [QD]> ctx_buf ← tf32[QD] {}
    do {
        stages.attn_rope_and_session<size QD, size KVD, size H, size C, size W>(q_val, k_val, v_val, mut qr_buf, mut kr_buf, lp.prope, tpos, lp.pspan, lp.plntheta, lp.pgroup, lp.pdh, lp.pscale, false, zs, mut session, slot_id, mut ctx_buf)
    }
    catch err {
        throw variant BadSession { message = err.message, inner = err }
    }

    do {
        stages.linear_project_q8<size D, size PQD, size GQD, size QD>(qlw.wo_desc, qlw.wo_w, qlw.wo_s, qlw.wo_b, ctx_buf, mut ws.xn)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }

    do device {
        ds.residual_add(hin, ws.xn, mut ws.h1)
    }
    stages.norm_rmsnorm<size D>(ws.h1, qlw.fnorm, mut ws.xn, lp.peps)

    do {
        stages.linear_project_q8<size F, size PD, size GD, size D>(qlw.wg_desc, qlw.wg_w, qlw.wg_s, qlw.wg_b, ws.xn, mut ws.gate)
        stages.linear_project_q8<size F, size PD, size GD, size D>(qlw.wu_desc, qlw.wu_w, qlw.wu_s, qlw.wu_b, ws.xn, mut ws.up)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }

    do device {
        ds.swiglu(ws.gate, ws.up, mut ws.act)
    }

    do {
        stages.linear_project_q8<size D, size PF, size GF, size F>(qlw.wd_desc, qlw.wd_w, qlw.wd_s, qlw.wd_b, ws.act, mut ws.xn)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }

    do device {
        ds.residual_add(ws.h1, ws.xn, mut hout)
    }
}

@ public
fn layer_wide_group_affine_u32_bf16<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF, size H, size C, size W>(tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, QuantizedLayerWeightsBf16<D, QD, KVD, F, PD, GD, PQD, GQD, PF, GF> qlw, mut sess_mod.SessionState<C, W, KVD> session, int slot_id, i32 tpos, dt.LayerParams lp, mut SliceAWorkspace<D, QD, KVD, F, H> ws) → void ⇥ SliceAError {
    stages.norm_rmsnorm<size D>(hin, qlw.anorm, mut ws.xn, lp.peps)

    lw.dispatch_group_affine_u32_bf16<size QD, size PD, size GD, size D>(qlw.wq_desc, qlw.wq_w, qlw.wq_s, qlw.wq_b, ws.xn, mut ws.q)
    lw.dispatch_group_affine_u32_bf16<size KVD, size PD, size GD, size D>(qlw.wk_desc, qlw.wk_w, qlw.wk_s, qlw.wk_b, ws.xn, mut ws.k)
    lw.dispatch_group_affine_u32_bf16<size KVD, size PD, size GD, size D>(qlw.wv_desc, qlw.wv_w, qlw.wv_s, qlw.wv_b, ws.xn, mut ws.v)

    if qlw.qkv_bias {
        do device {
            ds.add_bias(qlw.bq, mut ws.q)
            ds.add_bias(qlw.bk, mut ws.k)
            ds.add_bias(qlw.bv, mut ws.v)
        }
    }

    let tensor<f32, [QD]> q_val ← ws.q
    let tensor<f32, [KVD]> k_val ← ws.k
    let tensor<f32, [KVD]> v_val ← ws.v
    let tensor<f32, [H]> zs ← ws.zero_sink
    mut tensor<f32, [QD]> qr_buf ← tf32[QD] {}
    mut tensor<f32, [KVD]> kr_buf ← tf32[KVD] {}
    mut tensor<f32, [QD]> ctx_buf ← tf32[QD] {}
    stages.attn_rope_and_session<size QD, size KVD, size H, size C, size W>(q_val, k_val, v_val, mut qr_buf, mut kr_buf, lp.prope, tpos, lp.pspan, lp.plntheta, lp.pgroup, lp.pdh, lp.pscale, false, zs, mut session, slot_id, mut ctx_buf)

    lw.dispatch_group_affine_u32_bf16<size D, size PQD, size GQD, size QD>(qlw.wo_desc, qlw.wo_w, qlw.wo_s, qlw.wo_b, ctx_buf, mut ws.xn)

    do device {
        ds.residual_add(hin, ws.xn, mut ws.h1)
    }
    stages.norm_rmsnorm<size D>(ws.h1, qlw.fnorm, mut ws.xn, lp.peps)

    lw.dispatch_group_affine_u32_bf16<size F, size PD, size GD, size D>(qlw.wg_desc, qlw.wg_w, qlw.wg_s, qlw.wg_b, ws.xn, mut ws.gate)
    lw.dispatch_group_affine_u32_bf16<size F, size PD, size GD, size D>(qlw.wu_desc, qlw.wu_w, qlw.wu_s, qlw.wu_b, ws.xn, mut ws.up)

    do device {
        ds.swiglu(ws.gate, ws.up, mut ws.act)
    }

    lw.dispatch_group_affine_u32_bf16<size D, size PF, size GF, size F>(qlw.wd_desc, qlw.wd_w, qlw.wd_s, qlw.wd_b, ws.act, mut ws.xn)

    do device {
        ds.residual_add(ws.h1, ws.xn, mut hout)
    }
}

# -------------------------------------------------------------------------
# Seam 1-3: Bundle + Directory + Config admission and LinearWeight binding
# -------------------------------------------------------------------------

@ public
fn quant_hint_from_config(cfg.ModelConfig mc) → lw.QuantConfigHint ⇥ SliceAError {
    let cfg.QuantConfig ∪ none maybe_qc ← mc.quantization
    if maybe_qc is cfg.QuantConfig {
        let int bits ← maybe_qc.bits coalesce 8
        let int gs ← maybe_qc.group_size coalesce 64
        require bits ≡ 8 and gs ≡ 64 throw variant UnsupportedQuant { message = "Slice A requires 8-bit group_size=64 quantization (got bits=§, group_size=§)"(bits ↦ string, gs ↦ string) }
        return lw.QuantConfigHint { mode = maybe_qc.mode, bits = bits, group_size = gs }
    }
    return lw.QuantConfigHint { mode = null, bits = 8, group_size = 64 }
}

fn require_group_affine_u32_8bit(lw.LinearWeight desc, int expected_out, int expected_in, string site) → lw.LinearWeight ⇥ SliceAError {
    match desc.kind {
        case lw.LinearWeightKind.GroupAffineU32 {}
        default {
            throw variant UnsupportedQuant { message = "§ must be GroupAffineU32"(site) }
        }
    }
    require desc.bits ≡ 8 and desc.group_size ≡ 64 throw variant UnsupportedQuant { message = "§ must be 8-bit group_size=64 (got bits=§, group_size=§)"(site, desc.bits ↦ string, desc.group_size ↦ string) }
    require desc.out_features ≡ expected_out and desc.in_features ≡ expected_in throw variant BadShape { message = "§ shape mismatch: expected [§, §], got [§, §]"(site, expected_out ↦ string, expected_in ↦ string, desc.out_features ↦ string, desc.in_features ↦ string) }
    return desc
}

fn bind_site(td.TensorDirectory dir, string prefix, lw.QuantConfigHint hint, int expected_out, int expected_in) → lw.LinearWeight ⇥ SliceAError {
    let lw.LinearWeight desc ← lw.bind_with_config(dir, variant bundle.MemberRole.Backbone, prefix, hint)
    return require_group_affine_u32_8bit(desc, expected_out, expected_in, prefix)
}

@ public
fn admit_model_descriptors(bundle.ModelBundle b, td.TensorDirectory dir, cfg.ModelConfig mc) → ModelDescriptors ⇥ SliceAError {
    require b.backbone_shards.length() ≥ 1 throw variant BadShape { message = "bundle requires at least one backbone shard" }
    require mc.num_hidden_layers ≥ 1 and mc.hidden_size ≥ 1 and mc.num_attention_heads ≥ 1 and mc.num_key_value_heads ≥ 1 and mc.head_dim ≥ 1 and mc.intermediate_size ≥ 1 and mc.vocab_size ≥ 1 throw variant BadShape { message = "ModelConfig extents must be positive" }
    require mc.num_attention_heads % mc.num_key_value_heads ≡ 0 throw variant BadShape { message = "num_attention_heads must be divisible by num_key_value_heads" }

    let lw.QuantConfigHint hint ← quant_hint_from_config(mc)
    let int d ← mc.hidden_size
    let int qd ← mc.num_attention_heads * mc.head_dim
    let int kvd ← mc.num_key_value_heads * mc.head_dim
    let int f ← mc.intermediate_size
    let int v ← mc.vocab_size

    let lw.LinearWeight embed_desc ← bind_site(dir, "model.embed_tokens", hint, v, d)
    let lw.LinearWeight head_desc ← mc.tie_word_embeddings ✓ embed_desc ✗ bind_site(dir, "lm_head", hint, v, d)

    let td.DirectoryEntry norm_entry ← td.lookup_backbone(dir, "model.norm.weight")
    require norm_entry.shape.length() ≡ 1 and (norm_entry.shape.get(0) coalesce 0) ≡ d throw variant BadShape { message = "model.norm.weight shape mismatch" }

    mut list<LayerDescriptors> layers ← empty
    for exclusive mc.num_hidden_layers let l {
        let string base ← "model.layers.§"(l ↦ string)
        let td.DirectoryEntry anorm_e ← td.lookup_backbone(dir, "§.input_layernorm.weight"(base))
        require anorm_e.shape.length() ≡ 1 and (anorm_e.shape.get(0) coalesce 0) ≡ d throw variant BadShape { message = "input_layernorm shape mismatch at layer §"(l ↦ string) }

        let td.DirectoryEntry fnorm_e ← td.lookup_backbone(dir, "§.post_attention_layernorm.weight"(base))
        require fnorm_e.shape.length() ≡ 1 and (fnorm_e.shape.get(0) coalesce 0) ≡ d throw variant BadShape { message = "post_attention_layernorm shape mismatch at layer §"(l ↦ string) }

        let lw.LinearWeight q_proj ← bind_site(dir, "§.self_attn.q_proj"(base), hint, qd, d)
        let lw.LinearWeight k_proj ← bind_site(dir, "§.self_attn.k_proj"(base), hint, kvd, d)
        let lw.LinearWeight v_proj ← bind_site(dir, "§.self_attn.v_proj"(base), hint, kvd, d)
        let lw.LinearWeight o_proj ← bind_site(dir, "§.self_attn.o_proj"(base), hint, d, qd)
        let lw.LinearWeight gate_proj ← bind_site(dir, "§.mlp.gate_proj"(base), hint, f, d)
        let lw.LinearWeight up_proj ← bind_site(dir, "§.mlp.up_proj"(base), hint, f, d)
        let lw.LinearWeight down_proj ← bind_site(dir, "§.mlp.down_proj"(base), hint, d, f)

        layers.append(LayerDescriptors { layer_index = l, q_proj = q_proj, k_proj = k_proj, v_proj = v_proj, o_proj = o_proj, gate_proj = gate_proj, up_proj = up_proj, down_proj = down_proj })
    }

    return ModelDescriptors { config = mc, embed_tokens = embed_desc, lm_head = head_desc, layers = layers }
}

# -------------------------------------------------------------------------
# Seam 4: ExecutionSchedule & SessionState allocation
# -------------------------------------------------------------------------

@ public
fn build_slice_a_schedule(cfg.ModelConfig mc) → model_schedule.ExecutionSchedule ⇥ SliceAError {
    return model_schedule.dense_schedule(mc.num_hidden_layers, variant model_schedule.RopeKind.Standard, variant model_schedule.FfnKind.Dense, empty)
}

@ public
fn allocate_slice_a_session<size C, size KVD>(cfg.ModelConfig mc, model_schedule.ExecutionSchedule es) → sess_mod.SessionState<size C, size 1, size KVD> ⇥ SliceAError {
    let int expected_kvd ← mc.num_key_value_heads * mc.head_dim
    require KVD ≡ expected_kvd throw variant BadShape { message = "SessionState KVD § does not match ModelConfig §"(KVD ↦ string, expected_kvd ↦ string) }
    require es.layers.length() ≡ mc.num_hidden_layers throw variant BadShape { message = "ExecutionSchedule layer count § does not match ModelConfig §"(es.layers.length() ↦ string, mc.num_hidden_layers ↦ string) }
    return sess_mod.from_dense_schedule<size C, size KVD>(es)
}

@ public
fn layer_params_from_config(cfg.ModelConfig mc) → dt.LayerParams {
    let i32 dh ← mc.head_dim ↦ i32 ⊥ 64
    let i32 span ← (mc.head_dim / 2) ↦ i32 ⊥ 32
    let i32 group ← (mc.num_attention_heads / mc.num_key_value_heads) ↦ i32 ⊥ 1
    let f32 scale ← (1.0 ∷ f32) / (√ (mc.head_dim ↦ f32))
    let f32 lntheta ← mc.rope_theta.ln()
    return dt.LayerParams { pdh = dh, pspan = span, pgroup = group, prope = variant dt.RopeKind.Half, peps = mc.rms_norm_eps, plntheta = lntheta, pscale = scale }
}

# -------------------------------------------------------------------------
# Seam 5: Quantized device kernels and B=1 decode driver
# -------------------------------------------------------------------------

# Quantized embedding gather: out[D] <- dequant(weight[ids[0], :], scales, biases).
# Dequantizes only the selected row on device without expanding [V, D] to F32.
@ public
kernel gather_group_affine_u32<size V, size PackedD, size GroupsD, size D>(tensor<u32, [V, PackedD]> weight, tensor<f32, [V, GroupsD]> scales, tensor<f32, [V, GroupsD]> biases, tensor<i32, [1]> ids, mut tensor<f32, [D]> out, i32 bits, i32 group_size) → void {
    for from out at [j] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 and bits ≡ 8 {
            let i32 row ← ids[0]
            if row ≥ 0 and row ≺ V {
                let i32 ji ← j ↦ i32
                let i32 g ← ji / group_size
                let f32 s ← scales[[row, g]]
                let f32 b ← biases[[row, g]]
                let i32 bit_pos ← ji * 8
                let i32 word_idx ← bit_pos / 32
                let i32 shift ← bit_pos % 32
                let u32 w0 ← weight[[row, word_idx]]
                mut u32 q ← 0 ∷ u32
                if shift ≡ 0 {
                    q ← w0 ∧ (255 ∷ u32)
                }
                elif shift ≡ 8 {
                    q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                }
                elif shift ≡ 16 {
                    q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                }
                else {
                    q ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)
                }
                out[[j]] ← (q ↦ f32) * s + b
            }
        }
    }
}

@ public
kernel gather_group_affine_u32_bf16<size V, size PackedD, size GroupsD, size D>(tensor<u32, [V, PackedD]> weight, tensor<bf16, [V, GroupsD]> scales, tensor<bf16, [V, GroupsD]> biases, tensor<i32, [1]> ids, mut tensor<f32, [D]> out, i32 bits, i32 group_size) → void {
    for from out at [j] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 and bits ≡ 8 {
            let i32 row ← ids[0]
            if row ≥ 0 and row ≺ V {
                let i32 ji ← j ↦ i32
                let i32 g ← ji / group_size
                let f32 s ← scales[[row, g]] ↦ f32
                let f32 b ← biases[[row, g]] ↦ f32
                let i32 bit_pos ← ji * 8
                let i32 word_idx ← bit_pos / 32
                let i32 shift ← bit_pos % 32
                let u32 w0 ← weight[[row, word_idx]]
                mut u32 q ← 0 ∷ u32
                if shift ≡ 0 {
                    q ← w0 ∧ (255 ∷ u32)
                }
                elif shift ≡ 8 {
                    q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                }
                elif shift ≡ 16 {
                    q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                }
                else {
                    q ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)
                }
                out[[j]] ← (q ↦ f32) * s + b
            }
        }
    }
}

@ public
kernel copy_vec<size D>(tensor<f32, [D]> src, mut tensor<f32, [D]> dst) → void {
    for from src at [j] thread lane let v {
        dst[[j]] ← v
    }
}

@ public
fn embed_wide_group_affine_u32<size V, size PD, size GD, size D>(lw.LinearWeight embed_desc, tensor<u32, [V, PD]> embed_w, tensor<f32, [V, GD]> embed_s, tensor<f32, [V, GD]> embed_b, tensor<i32, [1]> ids, mut tensor<f32, [D]> hidden) → void ⇥ SliceAError {
    require embed_desc.out_features ≡ V and embed_desc.in_features ≡ D and embed_desc.packed_cols ≡ PD and embed_desc.group_cols ≡ GD throw variant BadShape { message = "embed_wide_group_affine_u32 shape mismatch" }
    gather_group_affine_u32<size V, size PD, size GD, size D>(embed_w, embed_s, embed_b, ids, mut hidden, embed_desc.bits ↦ i32 ⊥ 8, embed_desc.group_size ↦ i32 ⊥ 64)
}

@ public
fn embed_wide_group_affine_u32_bf16<size V, size PD, size GD, size D>(lw.LinearWeight embed_desc, tensor<u32, [V, PD]> embed_w, tensor<bf16, [V, GD]> embed_s, tensor<bf16, [V, GD]> embed_b, tensor<i32, [1]> ids, mut tensor<f32, [D]> hidden) → void ⇥ SliceAError {
    require embed_desc.out_features ≡ V and embed_desc.in_features ≡ D and embed_desc.packed_cols ≡ PD and embed_desc.group_cols ≡ GD throw variant BadShape { message = "embed_wide_group_affine_u32_bf16 shape mismatch" }
    gather_group_affine_u32_bf16<size V, size PD, size GD, size D>(embed_w, embed_s, embed_b, ids, mut hidden, embed_desc.bits ↦ i32 ⊥ 8, embed_desc.group_size ↦ i32 ⊥ 64)
}

@ public
fn head_wide_group_affine_u32<size V, size PD, size GD, size D>(tensor<f32, [D]> hidden, tensor<f32, [D]> onorm, lw.LinearWeight head_desc, tensor<u32, [V, PD]> head_w, tensor<f32, [V, GD]> head_s, tensor<f32, [V, GD]> head_b, mut tensor<f32, [D]> hn, mut tensor<f32, [V]> logits, f32 peps) → void ⇥ SliceAError {
    stages.norm_rmsnorm<size D>(hidden, onorm, mut hn, peps)
    do {
        stages.linear_project_q8<size V, size PD, size GD, size D>(head_desc, head_w, head_s, head_b, hn, mut logits)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }
}

@ public
fn head_wide_group_affine_u32_bf16<size V, size PD, size GD, size D>(tensor<f32, [D]> hidden, tensor<f32, [D]> onorm, lw.LinearWeight head_desc, tensor<u32, [V, PD]> head_w, tensor<bf16, [V, GD]> head_s, tensor<bf16, [V, GD]> head_b, mut tensor<f32, [D]> hn, mut tensor<f32, [V]> logits, f32 peps) → void ⇥ SliceAError {
    stages.norm_rmsnorm<size D>(hidden, onorm, mut hn, peps)
    do {
        lw.dispatch_group_affine_u32_bf16<size V, size PD, size GD, size D>(head_desc, head_w, head_s, head_b, hn, mut logits)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }
}

fn synth_config_json(int layers) → string {
    return «{"model_type":"llama","hidden_size":64,"num_hidden_layers":§,"num_attention_heads":2,"num_key_value_heads":1,"head_dim":32,"intermediate_size":64,"vocab_size":8,"max_position_embeddings":8,"rms_norm_eps":0.00001,"rope_theta":10000.0,"tie_word_embeddings":true,"quantization":{"bits":8,"group_size":64}}»(layers ↦ string)
}

fn st_desc(string name, string dtype_name, list<int> shape, int start, int end, int elems) → capsule.SafetensorsTensorDescriptor {
    return capsule.SafetensorsTensorDescriptor { name = name, dtype = dtype_name, shape = shape, start = start, end = end, elements = elems }
}

fn append_ga_descs(mut list<capsule.SafetensorsTensorDescriptor> descs, string prefix, int out_f, int in_f, mut int off) → void {
    let int packed_in ← in_f / 4
    let int groups ← in_f / 64
    let int w_len ← out_f * packed_in * 4
    let int s_len ← out_f * groups * 4
    descs.append(st_desc("§.weight"(prefix), "U32", [out_f, packed_in], off, off + w_len, out_f * packed_in))
    off ← off + w_len
    descs.append(st_desc("§.scales"(prefix), "F32", [out_f, groups], off, off + s_len, out_f * groups))
    off ← off + s_len
    descs.append(st_desc("§.biases"(prefix), "F32", [out_f, groups], off, off + s_len, out_f * groups))
    off ← off + s_len
}

fn build_synth_descs(int layers) → list<capsule.SafetensorsTensorDescriptor> {
    mut list<capsule.SafetensorsTensorDescriptor> descs ← empty
    mut int off ← 0
    append_ga_descs(mut descs, "model.embed_tokens", 8, 64, mut off)
    descs.append(st_desc("model.norm.weight", "F32", [64], off, off + 256, 64))
    off ← off + 256

    for exclusive layers let l {
        let string base ← "model.layers.§"(l ↦ string)
        descs.append(st_desc("§.input_layernorm.weight"(base), "F32", [64], off, off + 256, 64))
        off ← off + 256
        descs.append(st_desc("§.post_attention_layernorm.weight"(base), "F32", [64], off, off + 256, 64))
        off ← off + 256
        append_ga_descs(mut descs, "§.self_attn.q_proj"(base), 64, 64, mut off)
        append_ga_descs(mut descs, "§.self_attn.k_proj"(base), 32, 64, mut off)
        append_ga_descs(mut descs, "§.self_attn.v_proj"(base), 32, 64, mut off)
        append_ga_descs(mut descs, "§.self_attn.o_proj"(base), 64, 64, mut off)
        append_ga_descs(mut descs, "§.mlp.gate_proj"(base), 64, 64, mut off)
        append_ga_descs(mut descs, "§.mlp.up_proj"(base), 64, 64, mut off)
        append_ga_descs(mut descs, "§.mlp.down_proj"(base), 64, 64, mut off)
    }
    return descs
}

fn synth_data_len(list<capsule.SafetensorsTensorDescriptor> descs) → int {
    if descs.length() ≡ 0 then return 0
    return descs[descs.length() - 1].end
}

fn fill_ga_u32<size Out, size PackedIn, size Groups>(mut tensor<u32, [Out, PackedIn]> w, mut tensor<f32, [Out, Groups]> s, mut tensor<f32, [Out, Groups]> b, int salt) → void {
    for exclusive Out let r {
        for exclusive PackedIn let p {
            let int v0 ← (r * 7 + p * 11 + salt * 3) % 13 + 1
            let int v1 ← (r * 5 + p * 13 + salt * 7) % 13 + 1
            let int v2 ← (r * 3 + p * 17 + salt * 11) % 13 + 1
            let int v3 ← (r * 11 + p * 19 + salt * 5) % 13 + 1
            let u32 u0 ← v0 ↦ u32 ⊥ (0 ∷ u32)
            let u32 u1 ← v1 ↦ u32 ⊥ (0 ∷ u32)
            let u32 u2 ← v2 ↦ u32 ⊥ (0 ∷ u32)
            let u32 u3 ← v3 ↦ u32 ⊥ (0 ∷ u32)
            let u32 word ← u0 ∨ (u1 ⇐ (8 ∷ u32)) ∨ (u2 ⇐ (16 ∷ u32)) ∨ (u3 ⇐ (24 ∷ u32))
            w[[r, p]] ← word
        }
        for exclusive Groups let g {
            s[[r, g]] ← (0.01 ∷ f32) * (((r + g + salt) % 5 + 1) ↦ f32)
            b[[r, g]] ← (-0.02 ∷ f32)
        }
    }
}

fn build_layer<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF>(LayerDescriptors ld, int salt) → QuantizedLayerWeights<D, QD, KVD, F, PD, GD, PQD, GQD, PF, GF> {
    mut tensor<f32, [D]> anorm ← tf32[D] {}
    mut tensor<f32, [D]> fnorm ← tf32[D] {}
    for exclusive D let j {
        anorm[[j]] ← 1.0 ∷ f32
        fnorm[[j]] ← 1.0 ∷ f32
    }

    mut tensor<u32, [QD, PD]> wq_w ← tensor<u32, [QD, PD]> {}
    mut tensor<f32, [QD, GD]> wq_s ← tf32[QD, GD] {}
    mut tensor<f32, [QD, GD]> wq_b ← tf32[QD, GD] {}
    fill_ga_u32(mut wq_w, mut wq_s, mut wq_b, salt + 1)

    mut tensor<u32, [KVD, PD]> wk_w ← tensor<u32, [KVD, PD]> {}
    mut tensor<f32, [KVD, GD]> wk_s ← tf32[KVD, GD] {}
    mut tensor<f32, [KVD, GD]> wk_b ← tf32[KVD, GD] {}
    fill_ga_u32(mut wk_w, mut wk_s, mut wk_b, salt + 2)

    mut tensor<u32, [KVD, PD]> wv_w ← tensor<u32, [KVD, PD]> {}
    mut tensor<f32, [KVD, GD]> wv_s ← tf32[KVD, GD] {}
    mut tensor<f32, [KVD, GD]> wv_b ← tf32[KVD, GD] {}
    fill_ga_u32(mut wv_w, mut wv_s, mut wv_b, salt + 3)

    mut tensor<u32, [D, PQD]> wo_w ← tensor<u32, [D, PQD]> {}
    mut tensor<f32, [D, GQD]> wo_s ← tf32[D, GQD] {}
    mut tensor<f32, [D, GQD]> wo_b ← tf32[D, GQD] {}
    fill_ga_u32(mut wo_w, mut wo_s, mut wo_b, salt + 4)

    mut tensor<u32, [F, PD]> wg_w ← tensor<u32, [F, PD]> {}
    mut tensor<f32, [F, GD]> wg_s ← tf32[F, GD] {}
    mut tensor<f32, [F, GD]> wg_b ← tf32[F, GD] {}
    fill_ga_u32(mut wg_w, mut wg_s, mut wg_b, salt + 5)

    mut tensor<u32, [F, PD]> wu_w ← tensor<u32, [F, PD]> {}
    mut tensor<f32, [F, GD]> wu_s ← tf32[F, GD] {}
    mut tensor<f32, [F, GD]> wu_b ← tf32[F, GD] {}
    fill_ga_u32(mut wu_w, mut wu_s, mut wu_b, salt + 6)

    mut tensor<u32, [D, PF]> wd_w ← tensor<u32, [D, PF]> {}
    mut tensor<f32, [D, GF]> wd_s ← tf32[D, GF] {}
    mut tensor<f32, [D, GF]> wd_b ← tf32[D, GF] {}
    fill_ga_u32(mut wd_w, mut wd_s, mut wd_b, salt + 7)

    let tensor<f32, [QD]> bq ← tf32[QD] {}
    let tensor<f32, [KVD]> bk ← tf32[KVD] {}
    let tensor<f32, [KVD]> bv ← tf32[KVD] {}

    return QuantizedLayerWeights<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF> {
        anorm = anorm,
        wq_desc = ld.q_proj, wq_w = wq_w, wq_s = wq_s, wq_b = wq_b,
        wk_desc = ld.k_proj, wk_w = wk_w, wk_s = wk_s, wk_b = wk_b,
        wv_desc = ld.v_proj, wv_w = wv_w, wv_s = wv_s, wv_b = wv_b,
        wo_desc = ld.o_proj, wo_w = wo_w, wo_s = wo_s, wo_b = wo_b,
        fnorm = fnorm,
        wg_desc = ld.gate_proj, wg_w = wg_w, wg_s = wg_s, wg_b = wg_b,
        wu_desc = ld.up_proj, wu_w = wu_w, wu_s = wu_s, wu_b = wu_b,
        wd_desc = ld.down_proj, wd_w = wd_w, wd_s = wd_s, wd_b = wd_b,
        qkv_bias = false, bq = bq, bk = bk, bv = bv
    }
}

fn kv_valid_count(sess_mod.SessionState<size 8, size 1, size 32> s, int slot) → int {
    do {
        return sess_mod.slot_valid_span(s, slot).valid_count
    }
    catch err {
        return -1
    }
}

@ public
fn check_slice_a_admission_code() → int {
    mut cfg.ModelConfig ∪ none maybe_mc ← null
    do {
        maybe_mc ← cfg.parse_json(synth_config_json(2))
    }
    catch err {
        return 1
    }
    if maybe_mc is none then return 1
    let cfg.ModelConfig mc ← maybe_mc

    let list<capsule.SafetensorsTensorDescriptor> descs ← build_synth_descs(mc.num_hidden_layers)
    let int data_len ← synth_data_len(descs)

    mut artifact.ContentIdentity ∪ none maybe_shard ← null
    mut artifact.ContentIdentity ∪ none maybe_cfg ← null
    do {
        maybe_shard ← artifact.identity("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", data_len + 64)
        maybe_cfg ← artifact.identity("sha-256", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", 256)
    }
    catch err {
        return 2
    }
    if maybe_shard is none or maybe_cfg is none then return 2
    let artifact.ContentIdentity shard_id ← maybe_shard
    let artifact.ContentIdentity cfg_id ← maybe_cfg

    mut bundle.ModelBundle ∪ none maybe_b ← null
    do {
        maybe_b ← bundle.safetensors_unindexed([shard_id], cfg_id, null, null, null, null)
    }
    catch err {
        return 3
    }
    if maybe_b is none then return 3
    let bundle.ModelBundle b ← maybe_b

    mut td.TensorDirectory ∪ none maybe_dir ← null
    do {
        let capsule.SafetensorsManifest m ← capsule.SafetensorsManifest { format = "safetensors", version = "1", artifact_length = data_len + 64, data_length = data_len, metadata = empty, tensors = descs }
        let list<td.ShardSource> sources ← [variant td.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = m }]
        maybe_dir ← td.build(b, sources, empty, empty)
    }
    catch err {
        return 4
    }
    if maybe_dir is none then return 4
    let td.TensorDirectory dir ← maybe_dir

    do {
        let ModelDescriptors md ← admit_model_descriptors(b, dir, mc)
        if md.layers.length() ≢ 2 then return 5
        let _ es ← build_slice_a_schedule(mc)
        mut _ session ← allocate_slice_a_session<size 8, size 32>(mc, es)
        if kv_valid_count(session, 0) ≢ 0 then return 6
        return 0
    }
    catch err {
        return 7
    }
}

@ public
fn check_slice_a_admission() → bool {
    return check_slice_a_admission_code() ≡ 0
}

@ public
fn check_slice_a_end_to_end() → bool {
    mut cfg.ModelConfig ∪ none maybe_mc ← null
    do {
        maybe_mc ← cfg.parse_json(synth_config_json(2))
    }
    catch err {
        return false
    }
    if maybe_mc is none then return false
    let cfg.ModelConfig mc ← maybe_mc

    let list<capsule.SafetensorsTensorDescriptor> descs ← build_synth_descs(mc.num_hidden_layers)
    let int data_len ← synth_data_len(descs)

    mut artifact.ContentIdentity ∪ none maybe_shard ← null
    mut artifact.ContentIdentity ∪ none maybe_cfg ← null
    do {
        maybe_shard ← artifact.identity("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", data_len + 64)
        maybe_cfg ← artifact.identity("sha-256", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", 256)
    }
    catch err {
        return false
    }
    if maybe_shard is none or maybe_cfg is none then return false
    let artifact.ContentIdentity shard_id ← maybe_shard
    let artifact.ContentIdentity cfg_id ← maybe_cfg

    mut bundle.ModelBundle ∪ none maybe_b ← null
    do {
        maybe_b ← bundle.safetensors_unindexed([shard_id], cfg_id, null, null, null, null)
    }
    catch err {
        return false
    }
    if maybe_b is none then return false
    let bundle.ModelBundle b ← maybe_b

    mut td.TensorDirectory ∪ none maybe_dir ← null
    do {
        let capsule.SafetensorsManifest m ← capsule.SafetensorsManifest { format = "safetensors", version = "1", artifact_length = data_len + 64, data_length = data_len, metadata = empty, tensors = descs }
        let list<td.ShardSource> sources ← [variant td.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = m }]
        maybe_dir ← td.build(b, sources, empty, empty)
    }
    catch err {
        return false
    }
    if maybe_dir is none then return false
    let td.TensorDirectory dir ← maybe_dir

    do {
        let ModelDescriptors md ← admit_model_descriptors(b, dir, mc)
        if md.layers.length() ≢ 2 then return false

        let _ es ← build_slice_a_schedule(mc)
        mut _ session ← allocate_slice_a_session<size 8, size 32>(mc, es)
        let dt.LayerParams lp ← layer_params_from_config(mc)

        mut tensor<u32, [8, 16]> emb_w ← tensor<u32, [8, 16]> {}
        mut tensor<f32, [8, 1]> emb_s ← tf32[8, 1] {}
        mut tensor<f32, [8, 1]> emb_b ← tf32[8, 1] {}
        fill_ga_u32(mut emb_w, mut emb_s, mut emb_b, 11)

        mut tensor<f32, [64]> onorm ← tf32[64] {}
        for exclusive 64 let j {
            onorm[[j]] ← 1.0 ∷ f32
        }

        mut list<QuantizedLayerWeights<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1>> qlayers ← empty
        for exclusive mc.num_hidden_layers let l {
            qlayers.append(build_layer<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1>(md.layers[l], (l + 1) * 10))
        }

        let tensor<f32, [2]> zero_sink ← tf32[2] {}
        mut tensor<f32, [64]> xn ← tf32[64] {}
        mut tensor<f32, [64]> q ← tf32[64] {}
        mut tensor<f32, [64]> qr ← tf32[64] {}
        mut tensor<f32, [32]> k ← tf32[32] {}
        mut tensor<f32, [32]> kr ← tf32[32] {}
        mut tensor<f32, [32]> v ← tf32[32] {}
        mut tensor<f32, [64]> ctx ← tf32[64] {}
        mut tensor<f32, [64]> h1 ← tf32[64] {}
        mut tensor<f32, [64]> gate ← tf32[64] {}
        mut tensor<f32, [64]> up ← tf32[64] {}
        mut tensor<f32, [64]> act ← tf32[64] {}
        mut SliceAWorkspace<size 64, size 64, size 32, size 64, size 2> ws ← SliceAWorkspace<size 64, size 64, size 32, size 64, size 2> {
            zero_sink = zero_sink,
            xn = xn, q = q, qr = qr, k = k, kr = kr, v = v,
            ctx = ctx, h1 = h1, gate = gate, up = up, act = act
        }

        mut tensor<i32, [1]> ids_buf ← tensor<i32, [1]> {}
        mut tensor<f32, [64]> h_cur ← tf32[64] {}
        mut tensor<f32, [64]> h_next ← tf32[64] {}
        mut tensor<f32, [8]> logits ← tf32[8] {}

        let list<int> prompt_ids ← [1, 3]
        mut list<int> gen ← empty
        mut int pos ← 0
        mut int next_tok ← 0
        for exclusive 4 let step {
            let int tok_in ← step ≺ prompt_ids.length() ✓ prompt_ids[step] ✗ next_tok
            ids_buf[0] ← tok_in ↦ i32 ⊥ 0
            embed_wide_group_affine_u32<size 8, size 16, size 1, size 64>(md.embed_tokens, emb_w, emb_s, emb_b, ids_buf, mut h_cur)
            let i32 tpos ← pos ↦ i32 ⊥ 0
            for exclusive mc.num_hidden_layers let l {
                let QuantizedLayerWeights<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> qlw ← qlayers[l]
                do {
                    if l % 2 ≡ 0 {
                        layer_wide_group_affine_u32<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1, size 2, size 8, size 1>(h_cur, mut h_next, qlw, mut session, l, tpos, lp, mut ws)
                    }
                    else {
                        layer_wide_group_affine_u32<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1, size 2, size 8, size 1>(h_next, mut h_cur, qlw, mut session, l, tpos, lp, mut ws)
                    }
                }
                catch err {
                    return false
                }
            }
            head_wide_group_affine_u32<size 8, size 16, size 1, size 64>(h_cur, onorm, md.lm_head, emb_w, emb_s, emb_b, mut h_next, mut logits, lp.peps)
            ds.argmax_token(logits, mut ids_buf)
            next_tok ← ids_buf[0] ↦ int
            if step ≥ prompt_ids.length() - 1 {
                gen.append(next_tok)
            }
            pos ↑
        }
        if gen.length() ≢ 3 then return false
        if gen[0] ≢ 2 or gen[1] ≢ 2 or gen[2] ≢ 2 then return false
        if kv_valid_count(session, 0) ≢ 4 then return false
        if kv_valid_count(session, 1) ≢ 4 then return false
        return true
    }
    catch err {
        return false
    }
}

@ public
fn check_slice_a_bf16_end_to_end() → bool {
    mut cfg.ModelConfig ∪ none maybe_mc ← null
    do {
        maybe_mc ← cfg.parse_json(synth_config_json(2))
    }
    catch err {
        return false
    }
    if maybe_mc is none then return false
    let cfg.ModelConfig mc ← maybe_mc

    let list<capsule.SafetensorsTensorDescriptor> descs ← build_synth_descs(mc.num_hidden_layers)
    let int data_len ← synth_data_len(descs)

    mut artifact.ContentIdentity ∪ none maybe_shard ← null
    mut artifact.ContentIdentity ∪ none maybe_cfg ← null
    do {
        maybe_shard ← artifact.identity("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", data_len + 64)
        maybe_cfg ← artifact.identity("sha-256", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", 256)
    }
    catch err {
        return false
    }
    if maybe_shard is none or maybe_cfg is none then return false
    let artifact.ContentIdentity shard_id ← maybe_shard
    let artifact.ContentIdentity cfg_id ← maybe_cfg

    mut bundle.ModelBundle ∪ none maybe_b ← null
    do {
        maybe_b ← bundle.safetensors_unindexed([shard_id], cfg_id, null, null, null, null)
    }
    catch err {
        return false
    }
    if maybe_b is none then return false
    let bundle.ModelBundle b ← maybe_b

    mut td.TensorDirectory ∪ none maybe_dir ← null
    do {
        let capsule.SafetensorsManifest m ← capsule.SafetensorsManifest { format = "safetensors", version = "1", artifact_length = data_len + 64, data_length = data_len, metadata = empty, tensors = descs }
        let list<td.ShardSource> sources ← [variant td.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = m }]
        maybe_dir ← td.build(b, sources, empty, empty)
    }
    catch err {
        return false
    }
    if maybe_dir is none then return false
    let td.TensorDirectory dir ← maybe_dir

    do {
        let ModelDescriptors md ← admit_model_descriptors(b, dir, mc)
        let _ es ← build_slice_a_schedule(mc)
        mut _ session ← allocate_slice_a_session<size 8, size 32>(mc, es)
        let dt.LayerParams lp ← layer_params_from_config(mc)

        mut tensor<u32, [8, 16]> emb_w ← tensor<u32, [8, 16]> {}
        mut tensor<f32, [8, 1]> emb_s_f32 ← tf32[8, 1] {}
        mut tensor<f32, [8, 1]> emb_b_f32 ← tf32[8, 1] {}
        fill_ga_u32(mut emb_w, mut emb_s_f32, mut emb_b_f32, 11)
        mut tensor<bf16, [8, 1]> emb_s ← tbf16[8, 1] {}
        mut tensor<bf16, [8, 1]> emb_b ← tbf16[8, 1] {}
        for exclusive 8 let r {
            emb_s[[r, 0]] ← emb_s_f32[[r, 0]] ↦ bf16
            emb_b[[r, 0]] ← emb_b_f32[[r, 0]] ↦ bf16
        }

        mut tensor<f32, [64]> onorm ← tf32[64] {}
        for exclusive 64 let j {
            onorm[[j]] ← 1.0 ∷ f32
        }

        let lw.LinearWeight bf16_emb_desc ← lw.LinearWeight {
            kind = md.embed_tokens.kind, out_features = md.embed_tokens.out_features, in_features = md.embed_tokens.in_features,
            bits = md.embed_tokens.bits, group_size = md.embed_tokens.group_size, packed_cols = md.embed_tokens.packed_cols,
            group_cols = md.embed_tokens.group_cols, has_bias = false, scales_dtype = "BF16"
        }

        mut tensor<i32, [1]> ids_buf ← tensor<i32, [1]> {}
        mut tensor<f32, [64]> h_cur ← tf32[64] {}
        mut tensor<f32, [64]> h_next ← tf32[64] {}
        mut tensor<f32, [8]> logits ← tf32[8] {}

        ids_buf[0] ← 1 ∷ i32
        embed_wide_group_affine_u32_bf16<size 8, size 16, size 1, size 64>(bf16_emb_desc, emb_w, emb_s, emb_b, ids_buf, mut h_cur)
        head_wide_group_affine_u32_bf16<size 8, size 16, size 1, size 64>(h_cur, onorm, bf16_emb_desc, emb_w, emb_s, emb_b, mut h_next, mut logits, lp.peps)
        ds.argmax_token(logits, mut ids_buf)
        let int tok ← ids_buf[0] ↦ int
        if tok ≺ 0 or tok ≥ 8 then return false
        if kv_valid_count(session, 0) ≢ 0 then return false
        return true
    }
    catch err {
        return false
    }
}

@ public
fn check_slice_a_rotated_kv_session() → bool {
    mut cfg.ModelConfig ∪ none maybe_mc ← null
    do {
        maybe_mc ← cfg.parse_json(synth_config_json(1))
    }
    catch err {
        return false
    }
    if maybe_mc is none then return false
    let cfg.ModelConfig mc ← maybe_mc

    let list<capsule.SafetensorsTensorDescriptor> descs ← build_synth_descs(1)
    let int data_len ← synth_data_len(descs)

    mut artifact.ContentIdentity ∪ none maybe_shard ← null
    mut artifact.ContentIdentity ∪ none maybe_cfg ← null
    do {
        maybe_shard ← artifact.identity("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", data_len + 64)
        maybe_cfg ← artifact.identity("sha-256", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", 256)
    }
    catch err {
        return false
    }
    if maybe_shard is none or maybe_cfg is none then return false
    let artifact.ContentIdentity shard_id ← maybe_shard
    let artifact.ContentIdentity cfg_id ← maybe_cfg

    mut bundle.ModelBundle ∪ none maybe_b ← null
    do {
        maybe_b ← bundle.safetensors_unindexed([shard_id], cfg_id, null, null, null, null)
    }
    catch err {
        return false
    }
    if maybe_b is none then return false
    let bundle.ModelBundle b ← maybe_b

    mut td.TensorDirectory ∪ none maybe_dir ← null
    do {
        let capsule.SafetensorsManifest m ← capsule.SafetensorsManifest { format = "safetensors", version = "1", artifact_length = data_len + 64, data_length = data_len, metadata = empty, tensors = descs }
        let list<td.ShardSource> sources ← [variant td.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = m }]
        maybe_dir ← td.build(b, sources, empty, empty)
    }
    catch err {
        return false
    }
    if maybe_dir is none then return false
    let td.TensorDirectory dir ← maybe_dir

    do {
        let ModelDescriptors md ← admit_model_descriptors(b, dir, mc)
        let _ es ← build_slice_a_schedule(mc)
        mut _ session_half ← allocate_slice_a_session<size 8, size 32>(mc, es)
        mut _ session_none ← allocate_slice_a_session<size 8, size 32>(mc, es)
        let dt.LayerParams lp_half ← layer_params_from_config(mc)
        let dt.LayerParams lp_none ← dt.LayerParams { pdh = lp_half.pdh, pspan = lp_half.pspan, pgroup = lp_half.pgroup, prope = variant dt.RopeKind.None, peps = lp_half.peps, plntheta = lp_half.plntheta, pscale = lp_half.pscale }
        let QuantizedLayerWeights<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> qlw ← build_layer<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1>(md.layers[0], 10)

        let tensor<f32, [2]> zero_sink ← tf32[2] {}
        mut tensor<f32, [64]> xn ← tf32[64] {}
        mut tensor<f32, [64]> q ← tf32[64] {}
        mut tensor<f32, [64]> qr ← tf32[64] {}
        mut tensor<f32, [32]> k ← tf32[32] {}
        mut tensor<f32, [32]> kr ← tf32[32] {}
        mut tensor<f32, [32]> v ← tf32[32] {}
        mut tensor<f32, [64]> ctx ← tf32[64] {}
        mut tensor<f32, [64]> h1 ← tf32[64] {}
        mut tensor<f32, [64]> gate ← tf32[64] {}
        mut tensor<f32, [64]> up ← tf32[64] {}
        mut tensor<f32, [64]> act ← tf32[64] {}
        mut SliceAWorkspace<size 64, size 64, size 32, size 64, size 2> ws ← SliceAWorkspace<size 64, size 64, size 32, size 64, size 2> {
            zero_sink = zero_sink, xn = xn, q = q, qr = qr, k = k, kr = kr, v = v,
            ctx = ctx, h1 = h1, gate = gate, up = up, act = act
        }

        mut tensor<f32, [64]> hin ← tf32[64] {}
        for exclusive 64 let j {
            hin[[j]] ← ((j % 7 + 1) ↦ f32) * 0.1
        }
        mut tensor<f32, [64]> hout_half ← tf32[64] {}
        mut tensor<f32, [64]> hout_none ← tf32[64] {}

        # At tpos=2 (non-zero position), RopeKind.Half rotates K before storing in SessionState,
        # so the stored K row in session_half must differ from session_none.
        layer_wide_group_affine_u32<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1, size 2, size 8, size 1>(hin, mut hout_half, qlw, mut session_half, 0, 2, lp_half, mut ws)
        layer_wide_group_affine_u32<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1, size 2, size 8, size 1>(hin, mut hout_none, qlw, mut session_none, 0, 2, lp_none, mut ws)

        if kv_valid_count(session_half, 0) ≢ 3 then return false
        if kv_valid_count(session_none, 0) ≢ 3 then return false
        let tensor<f32, [8, 32]> k_half ← session_half.full_kv.keys[0]
        let tensor<f32, [8, 32]> k_none ← session_none.full_kv.keys[0]
        mut bool diff ← false
        for exclusive 32 let j {
            if (k_half[[2, j]] - k_none[[2, j]]).abs() ≻ 0.0001 {
                diff ← true
            }
        }
        return diff
    }
    catch err {
        return false
    }
}

@ public
fn check_slice_a_rejects_non_8bit() → bool {
    let string bad_json ← «{"model_type":"llama","hidden_size":64,"num_hidden_layers":2,"num_attention_heads":2,"num_key_value_heads":1,"head_dim":32,"intermediate_size":64,"vocab_size":8,"max_position_embeddings":8,"rms_norm_eps":0.00001,"rope_theta":10000.0,"tie_word_embeddings":true,"quantization":{"bits":4,"group_size":64}}»
    mut cfg.ModelConfig ∪ none maybe_mc ← null
    do {
        maybe_mc ← cfg.parse_json(bad_json)
    }
    catch err {
        return false
    }
    if maybe_mc is none then return false
    let cfg.ModelConfig mc ← maybe_mc
    do {
        let _ hint ← quant_hint_from_config(mc)
        return false
    }
    catch err {
        return true
    }
}

+++ faber test
import from "gradus:decode_slice_a" let sa

test "decode_slice_a seam 1-4 admission and schedule" {
    assert sa.check_slice_a_admission_code() ≡ 0
}

test "decode_slice_a rejects non-8-bit quantization config" {
    assert sa.check_slice_a_rejects_non_8bit()
}

test "decode_slice_a end-to-end quantized B=1 generation over seams 1-5" {
    assert sa.check_slice_a_end_to_end()
}

test "decode_slice_a bf16 group_affine embed and head over seams 1-5" {
    assert sa.check_slice_a_bf16_end_to_end()
}

test "decode_slice_a writes rotated keys into single authoritative SessionState" {
    assert sa.check_slice_a_rotated_kv_session()
}
