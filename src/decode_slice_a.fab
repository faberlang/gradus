@ public
class SliceAWorkspace<size D, size QD, size KVD, size F, size H> {
    mut tensor<f32, [D]> xn
    mut tensor<f32, [QD]> q
    mut tensor<f32, [QD]> qr
    mut tensor<f32, [KVD]> k
    mut tensor<f32, [KVD]> kr
    mut tensor<f32, [KVD]> v
    mut tensor<f32, [QD]> ctx
    mut tensor<f32, [D]> h1
    mut tensor<f32, [F]> gate
    mut tensor<f32, [F]> up
    mut tensor<f32, [F]> act
}

fn apply_qkv_biases<size QD, size KVD>(mut tensor<f32, [QD]> q_buf, mut tensor<f32, [KVD]> k_buf, mut tensor<f32, [KVD]> v_buf, tensor<f32, [QD]> ∪ none bq, tensor<f32, [KVD]> ∪ none bk, tensor<f32, [KVD]> ∪ none bv) → void {
    if bq not is none or bk not is none or bv not is none {
        do device {
            if bq not is none {
                let tensor<f32, [QD]> bq_val ← bq
                ds.add_bias(bq_val, mut q_buf)
            }
            if bk not is none {
                let tensor<f32, [KVD]> bk_val ← bk
                ds.add_bias(bk_val, mut k_buf)
            }
            if bv not is none {
                let tensor<f32, [KVD]> bv_val ← bv
                ds.add_bias(bv_val, mut v_buf)
            }
        }
    }
}

@ public
fn layer_wide_group_affine_u32<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF, size H, size C, size W>(tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, QuantizedLayerWeights<D, QD, KVD, F, PD, GD, PQD, GQD, PF, GF> qlw, mut sess_mod.SessionState<C, W, KVD> session, int slot_id, i32 tpos, dt.LayerParams lp, mut SliceAWorkspace<D, QD, KVD, F, H> ws) → void ⇥ SliceAError {
    mut tensor<f32, [D]> xn ← tf32[D] {}
    mut tensor<f32, [QD]> q ← tf32[QD] {}
    mut tensor<f32, [KVD]> k ← tf32[KVD] {}
    mut tensor<f32, [KVD]> v ← tf32[KVD] {}
    mut tensor<f32, [QD]> qr_buf ← tf32[QD] {}
    mut tensor<f32, [KVD]> kr_buf ← tf32[KVD] {}
    mut tensor<f32, [QD]> ctx_buf ← tf32[QD] {}
    mut tensor<f32, [D]> h1 ← tf32[D] {}
    mut tensor<f32, [F]> gate ← tf32[F] {}
    mut tensor<f32, [F]> up ← tf32[F] {}
    mut tensor<f32, [F]> act ← tf32[F] {}
    let tensor<f32, [H]> no_sink ← tf32[H] {}

    stages.norm_rmsnorm<size D>(hin, qlw.anorm, mut xn, lp.peps)

    do {
        stages.linear_project_q8<size QD, size PD, size GD, size D>(qlw.wq_desc, qlw.wq_w, qlw.wq_s, qlw.wq_b, xn, mut q)
        stages.linear_project_q8<size KVD, size PD, size GD, size D>(qlw.wk_desc, qlw.wk_w, qlw.wk_s, qlw.wk_b, xn, mut k)
        stages.linear_project_q8<size KVD, size PD, size GD, size D>(qlw.wv_desc, qlw.wv_w, qlw.wv_s, qlw.wv_b, xn, mut v)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }

    apply_qkv_biases<size QD, size KVD>(mut q, mut k, mut v, qlw.bq, qlw.bk, qlw.bv)
    do {
        stages.attn_rope_and_session<size QD, size KVD, size H, size C, size W>(q, k, v, mut qr_buf, mut kr_buf, lp.prope, tpos, lp.pspan, lp.plntheta, lp.pgroup, lp.pdh, lp.pscale, false, no_sink, mut session, slot_id, mut ctx_buf)
    }
    catch err {
        throw variant BadSession { message = err.message, inner = err }
    }

    do {
        stages.linear_project_q8<size D, size PQD, size GQD, size QD>(qlw.wo_desc, qlw.wo_w, qlw.wo_s, qlw.wo_b, ctx_buf, mut xn)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }

    do device {
        ds.residual_add(hin, xn, mut h1)
    }
    stages.norm_rmsnorm<size D>(h1, qlw.fnorm, mut xn, lp.peps)

    do {
        stages.linear_project_q8<size F, size PD, size GD, size D>(qlw.wg_desc, qlw.wg_w, qlw.wg_s, qlw.wg_b, xn, mut gate)
        stages.linear_project_q8<size F, size PD, size GD, size D>(qlw.wu_desc, qlw.wu_w, qlw.wu_s, qlw.wu_b, xn, mut up)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }

    do device {
        ds.swiglu(gate, up, mut act)
    }

    do {
        stages.linear_project_q8<size D, size PF, size GF, size F>(qlw.wd_desc, qlw.wd_w, qlw.wd_s, qlw.wd_b, act, mut xn)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }

    do device {
        ds.residual_add(h1, xn, mut hout)
    }
}

@ public
fn layer_wide_group_affine_u32_bf16<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF, size H, size C, size W>(tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, QuantizedLayerWeightsBf16<D, QD, KVD, F, PD, GD, PQD, GQD, PF, GF> qlw, mut sess_mod.SessionState<C, W, KVD> session, int slot_id, i32 tpos, dt.LayerParams lp, mut SliceAWorkspace<D, QD, KVD, F, H> ws) → void ⇥ SliceAError {
    mut tensor<f32, [D]> xn ← tf32[D] {}
    mut tensor<f32, [QD]> q ← tf32[QD] {}
    mut tensor<f32, [KVD]> k ← tf32[KVD] {}
    mut tensor<f32, [KVD]> v ← tf32[KVD] {}
    mut tensor<f32, [QD]> qr_buf ← tf32[QD] {}
    mut tensor<f32, [KVD]> kr_buf ← tf32[KVD] {}
    mut tensor<f32, [QD]> ctx_buf ← tf32[QD] {}
    mut tensor<f32, [D]> h1 ← tf32[D] {}
    mut tensor<f32, [F]> gate ← tf32[F] {}
    mut tensor<f32, [F]> up ← tf32[F] {}
    mut tensor<f32, [F]> act ← tf32[F] {}
    let tensor<f32, [H]> no_sink ← tf32[H] {}

    stages.norm_rmsnorm<size D>(hin, qlw.anorm, mut xn, lp.peps)

    lw.dispatch_group_affine_u32_bf16<size QD, size PD, size GD, size D>(qlw.wq_desc, qlw.wq_w, qlw.wq_s, qlw.wq_b, xn, mut q)
    lw.dispatch_group_affine_u32_bf16<size KVD, size PD, size GD, size D>(qlw.wk_desc, qlw.wk_w, qlw.wk_s, qlw.wk_b, xn, mut k)
    lw.dispatch_group_affine_u32_bf16<size KVD, size PD, size GD, size D>(qlw.wv_desc, qlw.wv_w, qlw.wv_s, qlw.wv_b, xn, mut v)

    apply_qkv_biases<size QD, size KVD>(mut q, mut k, mut v, qlw.bq, qlw.bk, qlw.bv)
    stages.attn_rope_and_session<size QD, size KVD, size H, size C, size W>(q, k, v, mut qr_buf, mut kr_buf, lp.prope, tpos, lp.pspan, lp.plntheta, lp.pgroup, lp.pdh, lp.pscale, false, no_sink, mut session, slot_id, mut ctx_buf)

    lw.dispatch_group_affine_u32_bf16<size D, size PQD, size GQD, size QD>(qlw.wo_desc, qlw.wo_w, qlw.wo_s, qlw.wo_b, ctx_buf, mut xn)

    do device {
        ds.residual_add(hin, xn, mut h1)
    }
    stages.norm_rmsnorm<size D>(h1, qlw.fnorm, mut xn, lp.peps)

    lw.dispatch_group_affine_u32_bf16<size F, size PD, size GD, size D>(qlw.wg_desc, qlw.wg_w, qlw.wg_s, qlw.wg_b, xn, mut gate)
    lw.dispatch_group_affine_u32_bf16<size F, size PD, size GD, size D>(qlw.wu_desc, qlw.wu_w, qlw.wu_s, qlw.wu_b, xn, mut up)

    do device {
        ds.swiglu(gate, up, mut act)
    }

    lw.dispatch_group_affine_u32_bf16<size D, size PF, size GF, size F>(qlw.wd_desc, qlw.wd_w, qlw.wd_s, qlw.wd_b, act, mut xn)

    do device {
        ds.residual_add(h1, xn, mut hout)
    }
}

@ public
fn layer_wide_group_affine_u32_f16<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF, size H, size C, size W>(tensor<f32, [D]> hin, mut tensor<f32, [D]> hout, QuantizedLayerWeightsF16<D, QD, KVD, F, PD, GD, PQD, GQD, PF, GF> qlw, mut sess_mod.SessionState<C, W, KVD> session, int slot_id, i32 tpos, dt.LayerParams lp, mut SliceAWorkspace<D, QD, KVD, F, H> ws) → void ⇥ SliceAError {
    mut tensor<f32, [D]> xn ← tf32[D] {}
    mut tensor<f32, [QD]> q ← tf32[QD] {}
    mut tensor<f32, [KVD]> k ← tf32[KVD] {}
    mut tensor<f32, [KVD]> v ← tf32[KVD] {}
    mut tensor<f32, [QD]> qr_buf ← tf32[QD] {}
    mut tensor<f32, [KVD]> kr_buf ← tf32[KVD] {}
    mut tensor<f32, [QD]> ctx_buf ← tf32[QD] {}
    mut tensor<f32, [D]> h1 ← tf32[D] {}
    mut tensor<f32, [F]> gate ← tf32[F] {}
    mut tensor<f32, [F]> up ← tf32[F] {}
    mut tensor<f32, [F]> act ← tf32[F] {}
    let tensor<f32, [H]> no_sink ← tf32[H] {}

    stages.norm_rmsnorm<size D>(hin, qlw.anorm, mut xn, lp.peps)

    lw.dispatch_group_affine_u32_f16<size QD, size PD, size GD, size D>(qlw.wq_desc, qlw.wq_w, qlw.wq_s, qlw.wq_b, xn, mut q)
    lw.dispatch_group_affine_u32_f16<size KVD, size PD, size GD, size D>(qlw.wk_desc, qlw.wk_w, qlw.wk_s, qlw.wk_b, xn, mut k)
    lw.dispatch_group_affine_u32_f16<size KVD, size PD, size GD, size D>(qlw.wv_desc, qlw.wv_w, qlw.wv_s, qlw.wv_b, xn, mut v)

    apply_qkv_biases<size QD, size KVD>(mut q, mut k, mut v, qlw.bq, qlw.bk, qlw.bv)
    stages.attn_rope_and_session<size QD, size KVD, size H, size C, size W>(q, k, v, mut qr_buf, mut kr_buf, lp.prope, tpos, lp.pspan, lp.plntheta, lp.pgroup, lp.pdh, lp.pscale, false, no_sink, mut session, slot_id, mut ctx_buf)

    lw.dispatch_group_affine_u32_f16<size D, size PQD, size GQD, size QD>(qlw.wo_desc, qlw.wo_w, qlw.wo_s, qlw.wo_b, ctx_buf, mut xn)

    do device {
        ds.residual_add(hin, xn, mut h1)
    }
    stages.norm_rmsnorm<size D>(h1, qlw.fnorm, mut xn, lp.peps)

    lw.dispatch_group_affine_u32_f16<size F, size PD, size GD, size D>(qlw.wg_desc, qlw.wg_w, qlw.wg_s, qlw.wg_b, xn, mut gate)
    lw.dispatch_group_affine_u32_f16<size F, size PD, size GD, size D>(qlw.wu_desc, qlw.wu_w, qlw.wu_s, qlw.wu_b, xn, mut up)

    do device {
        ds.swiglu(gate, up, mut act)
    }

    lw.dispatch_group_affine_u32_f16<size D, size PF, size GF, size F>(qlw.wd_desc, qlw.wd_w, qlw.wd_s, qlw.wd_b, act, mut xn)

    do device {
        ds.residual_add(h1, xn, mut hout)
    }
}

# -------------------------------------------------------------------------
# Seam 1-3: Bundle + Directory + Config admission and LinearWeight binding
# -------------------------------------------------------------------------

@ public
fn quant_hint_from_config(cfg.ModelConfig mc) → lw.QuantConfigHint ⇥ SliceAError {
    let cfg.QuantConfig ∪ none maybe_qc ← mc.quantization
    if maybe_qc is cfg.QuantConfig {
        let int bits ← maybe_qc.bits coalesce 8
        let int gs ← maybe_qc.group_size coalesce 64
        require bits ≡ 8 and gs ≡ 64 throw variant UnsupportedQuant { message = "Slice A requires 8-bit group_size=64 quantization (got bits=§, group_size=§)"(bits ↦ string, gs ↦ string) }
        return lw.QuantConfigHint { mode = maybe_qc.mode, bits = bits, group_size = gs }
    }
    return lw.QuantConfigHint { mode = null, bits = 8, group_size = 64 }
}

fn require_group_affine_u32_8bit(lw.LinearWeight desc, int expected_out, int expected_in, string site) → lw.LinearWeight ⇥ SliceAError {
    match desc.kind {
        case lw.LinearWeightKind.GroupAffineU32 {}
        default {
            throw variant UnsupportedQuant { message = "§ must be GroupAffineU32"(site) }
        }
    }
    require desc.bits ≡ 8 and desc.group_size ≡ 64 throw variant UnsupportedQuant { message = "§ must be 8-bit group_size=64 (got bits=§, group_size=§)"(site, desc.bits ↦ string, desc.group_size ↦ string) }
    require desc.out_features ≡ expected_out and desc.in_features ≡ expected_in throw variant BadShape { message = "§ shape mismatch: expected [§, §], got [§, §]"(site, expected_out ↦ string, expected_in ↦ string, desc.out_features ↦ string, desc.in_features ↦ string) }
    return desc
}

fn bind_site(td.TensorDirectory dir, string prefix, lw.QuantConfigHint hint, int expected_out, int expected_in) → lw.LinearWeight ⇥ SliceAError {
    let lw.LinearWeight desc ← lw.bind_with_config(dir, variant bundle.MemberRole.Backbone, prefix, hint)
    return require_group_affine_u32_8bit(desc, expected_out, expected_in, prefix)
}

@ public
fn admit_model_descriptors(bundle.ModelBundle b, td.TensorDirectory dir, cfg.ModelConfig mc) → ModelDescriptors ⇥ SliceAError {
    require b.backbone_shards.length() ≥ 1 throw variant BadShape { message = "bundle requires at least one backbone shard" }
    require mc.num_hidden_layers ≥ 1 and mc.hidden_size ≥ 1 and mc.num_attention_heads ≥ 1 and mc.num_key_value_heads ≥ 1 and mc.head_dim ≥ 1 and mc.intermediate_size ≥ 1 and mc.vocab_size ≥ 1 throw variant BadShape { message = "ModelConfig extents must be positive" }
    require mc.num_attention_heads % mc.num_key_value_heads ≡ 0 throw variant BadShape { message = "num_attention_heads must be divisible by num_key_value_heads" }

    let lw.QuantConfigHint hint ← quant_hint_from_config(mc)
    let int d ← mc.hidden_size
    let int qd ← mc.num_attention_heads * mc.head_dim
    let int kvd ← mc.num_key_value_heads * mc.head_dim
    let int f ← mc.intermediate_size
    let int v ← mc.vocab_size

    let lw.LinearWeight embed_desc ← bind_site(dir, "model.embed_tokens", hint, v, d)
    let lw.LinearWeight head_desc ← mc.tie_word_embeddings ✓ embed_desc ✗ bind_site(dir, "lm_head", hint, v, d)

    let td.DirectoryEntry norm_entry ← td.lookup_backbone(dir, "model.norm.weight")
    require norm_entry.shape.length() ≡ 1 and (norm_entry.shape.get(0) coalesce 0) ≡ d throw variant BadShape { message = "model.norm.weight shape mismatch" }

    mut list<LayerDescriptors> layers ← empty
    for exclusive mc.num_hidden_layers let l {
        let string base ← "model.layers.§"(l ↦ string)
        let td.DirectoryEntry anorm_e ← td.lookup_backbone(dir, "§.input_layernorm.weight"(base))
        require anorm_e.shape.length() ≡ 1 and (anorm_e.shape.get(0) coalesce 0) ≡ d throw variant BadShape { message = "input_layernorm shape mismatch at layer §"(l ↦ string) }

        let td.DirectoryEntry fnorm_e ← td.lookup_backbone(dir, "§.post_attention_layernorm.weight"(base))
        require fnorm_e.shape.length() ≡ 1 and (fnorm_e.shape.get(0) coalesce 0) ≡ d throw variant BadShape { message = "post_attention_layernorm shape mismatch at layer §"(l ↦ string) }

        let lw.LinearWeight q_proj ← bind_site(dir, "§.self_attn.q_proj"(base), hint, qd, d)
        let lw.LinearWeight k_proj ← bind_site(dir, "§.self_attn.k_proj"(base), hint, kvd, d)
        let lw.LinearWeight v_proj ← bind_site(dir, "§.self_attn.v_proj"(base), hint, kvd, d)
        let lw.LinearWeight o_proj ← bind_site(dir, "§.self_attn.o_proj"(base), hint, d, qd)
        let lw.LinearWeight gate_proj ← bind_site(dir, "§.mlp.gate_proj"(base), hint, f, d)
        let lw.LinearWeight up_proj ← bind_site(dir, "§.mlp.up_proj"(base), hint, f, d)
        let lw.LinearWeight down_proj ← bind_site(dir, "§.mlp.down_proj"(base), hint, d, f)

        layers.append(LayerDescriptors { layer_index = l, q_proj = q_proj, k_proj = k_proj, v_proj = v_proj, o_proj = o_proj, gate_proj = gate_proj, up_proj = up_proj, down_proj = down_proj })
    }

    return ModelDescriptors { config = mc, embed_tokens = embed_desc, lm_head = head_desc, layers = layers }
}

# -------------------------------------------------------------------------
# Seam 4: ExecutionSchedule & SessionState allocation
# -------------------------------------------------------------------------

@ public
fn build_slice_a_schedule(cfg.ModelConfig mc) → model_schedule.ExecutionSchedule ⇥ SliceAError {
    return model_schedule.dense_schedule(mc.num_hidden_layers, variant model_schedule.RopeKind.Standard, variant model_schedule.FfnKind.Dense, empty)
}

@ public
fn allocate_slice_a_session<size C, size KVD>(cfg.ModelConfig mc, model_schedule.ExecutionSchedule es) → sess_mod.SessionState<size C, size 1, size KVD> ⇥ SliceAError {
    let int expected_kvd ← mc.num_key_value_heads * mc.head_dim
    require KVD ≡ expected_kvd throw variant BadShape { message = "SessionState KVD § does not match ModelConfig §"(KVD ↦ string, expected_kvd ↦ string) }
    require es.layers.length() ≡ mc.num_hidden_layers throw variant BadShape { message = "ExecutionSchedule layer count § does not match ModelConfig §"(es.layers.length() ↦ string, mc.num_hidden_layers ↦ string) }
    return sess_mod.from_dense_schedule<size C, size KVD>(es)
}

@ public
fn layer_params_from_config(cfg.ModelConfig mc) → dt.LayerParams {
    let i32 dh ← mc.head_dim ↦ i32 ⊥ 64
    let i32 span ← (mc.head_dim / 2) ↦ i32 ⊥ 32
    let i32 group ← (mc.num_attention_heads / mc.num_key_value_heads) ↦ i32 ⊥ 1
    let f32 scale ← (1.0 ∷ f32) / (√ (mc.head_dim ↦ f32))
    let f32 lntheta ← mc.rope_theta.ln()
    return dt.LayerParams { pdh = dh, pspan = span, pgroup = group, prope = variant dt.RopeKind.Half, peps = mc.rms_norm_eps, plntheta = lntheta, pscale = scale }
}

# -------------------------------------------------------------------------
# Seam 5: Quantized device kernels and B=1 decode driver
# -------------------------------------------------------------------------

# Quantized embedding gather: out[D] <- dequant(weight[ids[0], :], scales, biases).
# Dequantizes only the selected row on device without expanding [V, D] to F32.
@ public
kernel gather_group_affine_u32<size V, size PackedD, size GroupsD, size D>(tensor<u32, [V, PackedD]> weight, tensor<f32, [V, GroupsD]> scales, tensor<f32, [V, GroupsD]> biases, tensor<i32, [1]> ids, mut tensor<f32, [D]> out, i32 bits, i32 group_size) → void {
    for from out at [j] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 and bits ≡ 8 {
            let i32 row ← ids[0]
            if row ≥ 0 and row ≺ V {
                let i32 ji ← j ↦ i32
                let i32 g ← ji / group_size
                let f32 s ← scales[[row, g]]
                let f32 b ← biases[[row, g]]
                let i32 bit_pos ← ji * 8
                let i32 word_idx ← bit_pos / 32
                let i32 shift ← bit_pos % 32
                let u32 w0 ← weight[[row, word_idx]]
                mut u32 q ← 0 ∷ u32
                if shift ≡ 0 {
                    q ← w0 ∧ (255 ∷ u32)
                }
                elif shift ≡ 8 {
                    q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                }
                elif shift ≡ 16 {
                    q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                }
                else {
                    q ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)
                }
                out[[j]] ← (q ↦ f32) * s + b
            }
        }
    }
}

@ public
kernel gather_group_affine_u32_bf16<size V, size PackedD, size GroupsD, size D>(tensor<u32, [V, PackedD]> weight, tensor<bf16, [V, GroupsD]> scales, tensor<bf16, [V, GroupsD]> biases, tensor<i32, [1]> ids, mut tensor<f32, [D]> out, i32 bits, i32 group_size) → void {
    for from out at [j] thread lane let e {
        if group_size ≥ 1 and group_size ≤ 4096 and bits ≡ 8 {
            let i32 row ← ids[0]
            if row ≥ 0 and row ≺ V {
                let i32 ji ← j ↦ i32
                let i32 g ← ji / group_size
                let f32 s ← scales[[row, g]] ↦ f32
                let f32 b ← biases[[row, g]] ↦ f32
                let i32 bit_pos ← ji * 8
                let i32 word_idx ← bit_pos / 32
                let i32 shift ← bit_pos % 32
                let u32 w0 ← weight[[row, word_idx]]
                mut u32 q ← 0 ∷ u32
                if shift ≡ 0 {
                    q ← w0 ∧ (255 ∷ u32)
                }
                elif shift ≡ 8 {
                    q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                }
                elif shift ≡ 16 {
                    q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                }
                else {
                    q ← (w0 ⇒ (24 ∷ u32)) ∧ (255 ∷ u32)
                }
                out[[j]] ← (q ↦ f32) * s + b
            }
        }
    }
}

@ public
kernel gather_group_affine_u32_f16<size V, size PackedD, size GroupsD, size D>(tensor<u32, [V, PackedD]> weight, tensor<f16, [V, GroupsD]> scales, tensor<f16, [V, GroupsD]> biases, tensor<i32, [1]> ids, mut tensor<f32, [D]> out, i32 bits, i32 group_size) → void {
    for from out at [j] thread lane let e {
