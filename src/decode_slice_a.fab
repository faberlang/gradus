            }
        }
    }
}

@ public
kernel copy_vec<size D>(tensor<f32, [D]> src, mut tensor<f32, [D]> dst) → void {
    for from src at [j] thread lane let v {
        dst[[j]] ← v
    }
}

@ public
fn embed_wide_group_affine_u32<size V, size PD, size GD, size D>(lw.LinearWeight embed_desc, tensor<u32, [V, PD]> embed_w, tensor<f32, [V, GD]> embed_s, tensor<f32, [V, GD]> embed_b, tensor<i32, [1]> ids, mut tensor<f32, [D]> hidden) → void ⇥ SliceAError {
    require embed_desc.out_features ≡ V and embed_desc.in_features ≡ D and embed_desc.packed_cols ≡ PD and embed_desc.group_cols ≡ GD throw variant BadShape { message = "embed_wide_group_affine_u32 shape mismatch" }
    gather_group_affine_u32<size V, size PD, size GD, size D>(embed_w, embed_s, embed_b, ids, mut hidden, embed_desc.bits ↦ i32 ⊥ 8, embed_desc.group_size ↦ i32 ⊥ 64)
}

@ public
fn embed_wide_group_affine_u32_bf16<size V, size PD, size GD, size D>(lw.LinearWeight embed_desc, tensor<u32, [V, PD]> embed_w, tensor<bf16, [V, GD]> embed_s, tensor<bf16, [V, GD]> embed_b, tensor<i32, [1]> ids, mut tensor<f32, [D]> hidden) → void ⇥ SliceAError {
    require embed_desc.out_features ≡ V and embed_desc.in_features ≡ D and embed_desc.packed_cols ≡ PD and embed_desc.group_cols ≡ GD throw variant BadShape { message = "embed_wide_group_affine_u32_bf16 shape mismatch" }
    gather_group_affine_u32_bf16<size V, size PD, size GD, size D>(embed_w, embed_s, embed_b, ids, mut hidden, embed_desc.bits ↦ i32 ⊥ 8, embed_desc.group_size ↦ i32 ⊥ 64)
}

@ public
fn embed_wide_group_affine_u32_f16<size V, size PD, size GD, size D>(lw.LinearWeight embed_desc, tensor<u32, [V, PD]> embed_w, tensor<f16, [V, GD]> embed_s, tensor<f16, [V, GD]> embed_b, tensor<i32, [1]> ids, mut tensor<f32, [D]> hidden) → void ⇥ SliceAError {
    require embed_desc.out_features ≡ V and embed_desc.in_features ≡ D and embed_desc.packed_cols ≡ PD and embed_desc.group_cols ≡ GD throw variant BadShape { message = "embed_wide_group_affine_u32_f16 shape mismatch" }
    gather_group_affine_u32_f16<size V, size PD, size GD, size D>(embed_w, embed_s, embed_b, ids, mut hidden, embed_desc.bits ↦ i32 ⊥ 8, embed_desc.group_size ↦ i32 ⊥ 64)
}

@ public
fn head_wide_group_affine_u32<size V, size PD, size GD, size D>(tensor<f32, [D]> hidden, tensor<f32, [D]> onorm, lw.LinearWeight head_desc, tensor<u32, [V, PD]> head_w, tensor<f32, [V, GD]> head_s, tensor<f32, [V, GD]> head_b, mut tensor<f32, [D]> hn, mut tensor<f32, [V]> logits, f32 peps) → void ⇥ SliceAError {
    stages.norm_rmsnorm<size D>(hidden, onorm, mut hn, peps)
    do {
        stages.linear_project_q8<size V, size PD, size GD, size D>(head_desc, head_w, head_s, head_b, hn, mut logits)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }
}

@ public
fn head_wide_group_affine_u32_bf16<size V, size PD, size GD, size D>(tensor<f32, [D]> hidden, tensor<f32, [D]> onorm, lw.LinearWeight head_desc, tensor<u32, [V, PD]> head_w, tensor<bf16, [V, GD]> head_s, tensor<bf16, [V, GD]> head_b, mut tensor<f32, [D]> hn, mut tensor<f32, [V]> logits, f32 peps) → void ⇥ SliceAError {
    stages.norm_rmsnorm<size D>(hidden, onorm, mut hn, peps)
    do {
        lw.dispatch_group_affine_u32_bf16<size V, size PD, size GD, size D>(head_desc, head_w, head_s, head_b, hn, mut logits)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }
}

@ public
fn head_wide_group_affine_u32_f16<size V, size PD, size GD, size D>(tensor<f32, [D]> hidden, tensor<f32, [D]> onorm, lw.LinearWeight head_desc, tensor<u32, [V, PD]> head_w, tensor<f16, [V, GD]> head_s, tensor<f16, [V, GD]> head_b, mut tensor<f32, [D]> hn, mut tensor<f32, [V]> logits, f32 peps) → void ⇥ SliceAError {
    stages.norm_rmsnorm<size D>(hidden, onorm, mut hn, peps)
    do {
        lw.dispatch_group_affine_u32_f16<size V, size PD, size GD, size D>(head_desc, head_w, head_s, head_b, hn, mut logits)
    }
    catch err {
        throw variant BadLinearWeight { message = err.message, inner = err }
    }
}

fn synth_config_json(int layers) → string {
    return «{"model_type":"llama","hidden_size":64,"num_hidden_layers":§,"num_attention_heads":2,"num_key_value_heads":1,"head_dim":32,"intermediate_size":64,"vocab_size":8,"max_position_embeddings":8,"rms_norm_eps":0.00001,"rope_theta":10000.0,"tie_word_embeddings":true,"quantization":{"bits":8,"group_size":64}}»(layers ↦ string)
}

fn st_desc(string name, string dtype_name, list<int> shape, int start, int end, int elems) → capsule.SafetensorsTensorDescriptor {
    return capsule.SafetensorsTensorDescriptor { name = name, dtype = dtype_name, shape = shape, start = start, end = end, elements = elems }
}

fn append_ga_descs(mut list<capsule.SafetensorsTensorDescriptor> descs, string prefix, int out_f, int in_f, mut int off) → void {
    let int packed_in ← in_f / 4
    let int groups ← in_f / 64
    let int w_len ← out_f * packed_in * 4
    let int s_len ← out_f * groups * 4
    descs.append(st_desc("§.weight"(prefix), "U32", [out_f, packed_in], off, off + w_len, out_f * packed_in))
    off ← off + w_len
    descs.append(st_desc("§.scales"(prefix), "F32", [out_f, groups], off, off + s_len, out_f * groups))
    off ← off + s_len
    descs.append(st_desc("§.biases"(prefix), "F32", [out_f, groups], off, off + s_len, out_f * groups))
    off ← off + s_len
}

fn build_synth_descs(int layers) → list<capsule.SafetensorsTensorDescriptor> {
    mut list<capsule.SafetensorsTensorDescriptor> descs ← empty
    mut int off ← 0
    append_ga_descs(mut descs, "model.embed_tokens", 8, 64, mut off)
    descs.append(st_desc("model.norm.weight", "F32", [64], off, off + 256, 64))
    off ← off + 256

    for exclusive layers let l {
        let string base ← "model.layers.§"(l ↦ string)
        descs.append(st_desc("§.input_layernorm.weight"(base), "F32", [64], off, off + 256, 64))
        off ← off + 256
        descs.append(st_desc("§.post_attention_layernorm.weight"(base), "F32", [64], off, off + 256, 64))
        off ← off + 256
        append_ga_descs(mut descs, "§.self_attn.q_proj"(base), 64, 64, mut off)
        append_ga_descs(mut descs, "§.self_attn.k_proj"(base), 32, 64, mut off)
        append_ga_descs(mut descs, "§.self_attn.v_proj"(base), 32, 64, mut off)
        append_ga_descs(mut descs, "§.self_attn.o_proj"(base), 64, 64, mut off)
        append_ga_descs(mut descs, "§.mlp.gate_proj"(base), 64, 64, mut off)
        append_ga_descs(mut descs, "§.mlp.up_proj"(base), 64, 64, mut off)
        append_ga_descs(mut descs, "§.mlp.down_proj"(base), 64, 64, mut off)
    }
    return descs
}

fn synth_data_len(list<capsule.SafetensorsTensorDescriptor> descs) → int {
    if descs.length() ≡ 0 then return 0
    return descs[descs.length() - 1].end
}

fn fill_ga_u32<size Out, size PackedIn, size Groups>(mut tensor<u32, [Out, PackedIn]> w, mut tensor<f32, [Out, Groups]> s, mut tensor<f32, [Out, Groups]> b, int salt) → void {
    for exclusive Out let r {
        for exclusive PackedIn let p {
            let int v0 ← (r * 7 + p * 11 + salt * 3) % 13 + 1
            let int v1 ← (r * 5 + p * 13 + salt * 7) % 13 + 1
            let int v2 ← (r * 3 + p * 17 + salt * 11) % 13 + 1
            let int v3 ← (r * 11 + p * 19 + salt * 5) % 13 + 1
            let u32 u0 ← v0 ↦ u32 ⊥ (0 ∷ u32)
            let u32 u1 ← v1 ↦ u32 ⊥ (0 ∷ u32)
            let u32 u2 ← v2 ↦ u32 ⊥ (0 ∷ u32)
            let u32 u3 ← v3 ↦ u32 ⊥ (0 ∷ u32)
            let u32 word ← u0 ∨ (u1 ⇐ (8 ∷ u32)) ∨ (u2 ⇐ (16 ∷ u32)) ∨ (u3 ⇐ (24 ∷ u32))
            w[[r, p]] ← word
        }
        for exclusive Groups let g {
            s[[r, g]] ← (0.01 ∷ f32) * (((r + g + salt) % 5 + 1) ↦ f32)
            b[[r, g]] ← (-0.02 ∷ f32)
        }
    }
}

fn build_layer<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF>(LayerDescriptors ld, int salt) → QuantizedLayerWeights<D, QD, KVD, F, PD, GD, PQD, GQD, PF, GF> {
    mut tensor<f32, [D]> anorm ← tf32[D] {}
    mut tensor<f32, [D]> fnorm ← tf32[D] {}
    for exclusive D let j {
        anorm[[j]] ← 1.0 ∷ f32
        fnorm[[j]] ← 1.0 ∷ f32
    }

    mut tensor<u32, [QD, PD]> wq_w ← tensor<u32, [QD, PD]> {}
    mut tensor<f32, [QD, GD]> wq_s ← tf32[QD, GD] {}
    mut tensor<f32, [QD, GD]> wq_b ← tf32[QD, GD] {}
    fill_ga_u32(mut wq_w, mut wq_s, mut wq_b, salt + 1)

    mut tensor<u32, [KVD, PD]> wk_w ← tensor<u32, [KVD, PD]> {}
    mut tensor<f32, [KVD, GD]> wk_s ← tf32[KVD, GD] {}
    mut tensor<f32, [KVD, GD]> wk_b ← tf32[KVD, GD] {}
    fill_ga_u32(mut wk_w, mut wk_s, mut wk_b, salt + 2)

    mut tensor<u32, [KVD, PD]> wv_w ← tensor<u32, [KVD, PD]> {}
    mut tensor<f32, [KVD, GD]> wv_s ← tf32[KVD, GD] {}
    mut tensor<f32, [KVD, GD]> wv_b ← tf32[KVD, GD] {}
    fill_ga_u32(mut wv_w, mut wv_s, mut wv_b, salt + 3)

    mut tensor<u32, [D, PQD]> wo_w ← tensor<u32, [D, PQD]> {}
    mut tensor<f32, [D, GQD]> wo_s ← tf32[D, GQD] {}
    mut tensor<f32, [D, GQD]> wo_b ← tf32[D, GQD] {}
    fill_ga_u32(mut wo_w, mut wo_s, mut wo_b, salt + 4)

    mut tensor<u32, [F, PD]> wg_w ← tensor<u32, [F, PD]> {}
    mut tensor<f32, [F, GD]> wg_s ← tf32[F, GD] {}
    mut tensor<f32, [F, GD]> wg_b ← tf32[F, GD] {}
    fill_ga_u32(mut wg_w, mut wg_s, mut wg_b, salt + 5)

    mut tensor<u32, [F, PD]> wu_w ← tensor<u32, [F, PD]> {}
    mut tensor<f32, [F, GD]> wu_s ← tf32[F, GD] {}
    mut tensor<f32, [F, GD]> wu_b ← tf32[F, GD] {}
    fill_ga_u32(mut wu_w, mut wu_s, mut wu_b, salt + 6)

    mut tensor<u32, [D, PF]> wd_w ← tensor<u32, [D, PF]> {}
    mut tensor<f32, [D, GF]> wd_s ← tf32[D, GF] {}
    mut tensor<f32, [D, GF]> wd_b ← tf32[D, GF] {}
    fill_ga_u32(mut wd_w, mut wd_s, mut wd_b, salt + 7)

    return QuantizedLayerWeights<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF> {
        anorm = anorm,
        wq_desc = ld.q_proj, wq_w = wq_w, wq_s = wq_s, wq_b = wq_b,
        wk_desc = ld.k_proj, wk_w = wk_w, wk_s = wk_s, wk_b = wk_b,
        wv_desc = ld.v_proj, wv_w = wv_w, wv_s = wv_s, wv_b = wv_b,
        wo_desc = ld.o_proj, wo_w = wo_w, wo_s = wo_s, wo_b = wo_b,
        fnorm = fnorm,
        wg_desc = ld.gate_proj, wg_w = wg_w, wg_s = wg_s, wg_b = wg_b,
        wu_desc = ld.up_proj, wu_w = wu_w, wu_s = wu_s, wu_b = wu_b,
        wd_desc = ld.down_proj, wd_w = wd_w, wd_s = wd_s, wd_b = wd_b
    }
}

fn kv_valid_count(sess_mod.SessionState<size 8, size 1, size 32> s, int slot) → int {
    do {
        return sess_mod.slot_valid_span(s, slot).valid_count
    }
    catch err {
        return -1
    }
}

@ public
fn check_slice_a_admission_code() → int {
    mut cfg.ModelConfig ∪ none maybe_mc ← null
    do {
        maybe_mc ← cfg.parse_json(synth_config_json(2))
    }
    catch err {
        return 1
    }
    if maybe_mc is none then return 1
    let cfg.ModelConfig mc ← maybe_mc

    let list<capsule.SafetensorsTensorDescriptor> descs ← build_synth_descs(mc.num_hidden_layers)
    let int data_len ← synth_data_len(descs)

    mut artifact.ContentIdentity ∪ none maybe_shard ← null
    mut artifact.ContentIdentity ∪ none maybe_cfg ← null
    do {
        maybe_shard ← artifact.identity("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", data_len + 64)
        maybe_cfg ← artifact.identity("sha-256", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", 256)
    }
    catch err {
        return 2
    }
    if maybe_shard is none or maybe_cfg is none then return 2
    let artifact.ContentIdentity shard_id ← maybe_shard
    let artifact.ContentIdentity cfg_id ← maybe_cfg

    mut bundle.ModelBundle ∪ none maybe_b ← null
    do {
        maybe_b ← bundle.safetensors_unindexed([shard_id], cfg_id, null, null, null, null)
    }
    catch err {
        return 3
    }
    if maybe_b is none then return 3
    let bundle.ModelBundle b ← maybe_b

    mut td.TensorDirectory ∪ none maybe_dir ← null
    do {
        let capsule.SafetensorsManifest m ← capsule.SafetensorsManifest { format = "safetensors", version = "1", artifact_length = data_len + 64, data_length = data_len, metadata = empty, tensors = descs }
        let list<td.ShardSource> sources ← [variant td.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = m }]
        maybe_dir ← td.build(b, sources, empty, empty)
    }
    catch err {
        return 4
    }
    if maybe_dir is none then return 4
    let td.TensorDirectory dir ← maybe_dir

    do {
        let ModelDescriptors md ← admit_model_descriptors(b, dir, mc)
        if md.layers.length() ≢ 2 then return 5
        let _ es ← build_slice_a_schedule(mc)
        mut _ session ← allocate_slice_a_session<size 8, size 32>(mc, es)
        if kv_valid_count(session, 0) ≢ 0 then return 6
        return 0
    }
    catch err {
        return 7
    }
}

@ public
fn check_slice_a_admission() → bool {
    return check_slice_a_admission_code() ≡ 0
}

@ public
fn check_slice_a_end_to_end() → bool {
    return check_slice_a_end_to_end_layers(2)
}

# The same quantized B=1 driver over an arbitrary layer count. The count
# also decides the ping-pong handoff: after the layer loop the final
# hidden state sits in h_cur for an even count and in h_next for an odd
# one, so a one-layer run exercises the odd handoff end to end.
@ public
fn check_slice_a_end_to_end_layers(int layers) → bool {
    mut cfg.ModelConfig ∪ none maybe_mc ← null
    do {
        maybe_mc ← cfg.parse_json(synth_config_json(layers))
    }
    catch err {
        return false
    }
    if maybe_mc is none then return false
    let cfg.ModelConfig mc ← maybe_mc

    let list<capsule.SafetensorsTensorDescriptor> descs ← build_synth_descs(mc.num_hidden_layers)
    let int data_len ← synth_data_len(descs)

    mut artifact.ContentIdentity ∪ none maybe_shard ← null
    mut artifact.ContentIdentity ∪ none maybe_cfg ← null
    do {
        maybe_shard ← artifact.identity("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", data_len + 64)
        maybe_cfg ← artifact.identity("sha-256", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", 256)
    }
    catch err {
        return false
    }
    if maybe_shard is none or maybe_cfg is none then return false
    let artifact.ContentIdentity shard_id ← maybe_shard
    let artifact.ContentIdentity cfg_id ← maybe_cfg

    mut bundle.ModelBundle ∪ none maybe_b ← null
    do {
        maybe_b ← bundle.safetensors_unindexed([shard_id], cfg_id, null, null, null, null)
    }
    catch err {
        return false
    }
    if maybe_b is none then return false
    let bundle.ModelBundle b ← maybe_b

    mut td.TensorDirectory ∪ none maybe_dir ← null
    do {
        let capsule.SafetensorsManifest m ← capsule.SafetensorsManifest { format = "safetensors", version = "1", artifact_length = data_len + 64, data_length = data_len, metadata = empty, tensors = descs }
        let list<td.ShardSource> sources ← [variant td.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = m }]
        maybe_dir ← td.build(b, sources, empty, empty)
    }
    catch err {
        return false
    }
    if maybe_dir is none then return false
    let td.TensorDirectory dir ← maybe_dir

    do {
        let ModelDescriptors md ← admit_model_descriptors(b, dir, mc)
        if md.layers.length() ≢ layers then return false

        let _ es ← build_slice_a_schedule(mc)
        mut _ session ← allocate_slice_a_session<size 8, size 32>(mc, es)
        let dt.LayerParams lp ← layer_params_from_config(mc)

        mut tensor<u32, [8, 16]> emb_w ← tensor<u32, [8, 16]> {}
        mut tensor<f32, [8, 1]> emb_s ← tf32[8, 1] {}
        mut tensor<f32, [8, 1]> emb_b ← tf32[8, 1] {}
        fill_ga_u32(mut emb_w, mut emb_s, mut emb_b, 11)

        mut tensor<f32, [64]> onorm ← tf32[64] {}
        for exclusive 64 let j {
            onorm[[j]] ← 1.0 ∷ f32
        }

        mut QuantizedLayerBank<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> qbank ← QuantizedLayerBank<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> {
            anorms = empty, wq_ws = empty, wq_ss = empty, wq_bs = empty,
            wk_ws = empty, wk_ss = empty, wk_bs = empty,
            wv_ws = empty, wv_ss = empty, wv_bs = empty,
            wo_ws = empty, wo_ss = empty, wo_bs = empty,
            fnorms = empty, wg_ws = empty, wg_ss = empty, wg_bs = empty,
            wu_ws = empty, wu_ss = empty, wu_bs = empty,
            wd_ws = empty, wd_ss = empty, wd_bs = empty
        }
        for exclusive mc.num_hidden_layers let l {
            let QuantizedLayerWeights<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> built ← build_layer<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1>(md.layers[l], (l + 1) * 10)
            qbank.anorms.append(built.anorm)
            qbank.wq_ws.append(built.wq_w)
            qbank.wq_ss.append(built.wq_s)
            qbank.wq_bs.append(built.wq_b)
            qbank.wk_ws.append(built.wk_w)
            qbank.wk_ss.append(built.wk_s)
            qbank.wk_bs.append(built.wk_b)
            qbank.wv_ws.append(built.wv_w)
            qbank.wv_ss.append(built.wv_s)
            qbank.wv_bs.append(built.wv_b)
            qbank.wo_ws.append(built.wo_w)
            qbank.wo_ss.append(built.wo_s)
            qbank.wo_bs.append(built.wo_b)
            qbank.fnorms.append(built.fnorm)
            qbank.wg_ws.append(built.wg_w)
            qbank.wg_ss.append(built.wg_s)
            qbank.wg_bs.append(built.wg_b)
            qbank.wu_ws.append(built.wu_w)
            qbank.wu_ss.append(built.wu_s)
            qbank.wu_bs.append(built.wu_b)
            qbank.wd_ws.append(built.wd_w)
            qbank.wd_ss.append(built.wd_s)
            qbank.wd_bs.append(built.wd_b)
        }

        mut tensor<f32, [64]> xn ← tf32[64] {}
        mut tensor<f32, [64]> q ← tf32[64] {}
        mut tensor<f32, [64]> qr ← tf32[64] {}
        mut tensor<f32, [32]> k ← tf32[32] {}
        mut tensor<f32, [32]> kr ← tf32[32] {}
        mut tensor<f32, [32]> v ← tf32[32] {}
        mut tensor<f32, [64]> ctx ← tf32[64] {}
        mut tensor<f32, [64]> h1 ← tf32[64] {}
        mut tensor<f32, [64]> gate ← tf32[64] {}
        mut tensor<f32, [64]> up ← tf32[64] {}
        mut tensor<f32, [64]> act ← tf32[64] {}
        mut SliceAWorkspace<size 64, size 64, size 32, size 64, size 2> ws ← SliceAWorkspace<size 64, size 64, size 32, size 64, size 2> {
            xn = xn, q = q, qr = qr, k = k, kr = kr, v = v,
            ctx = ctx, h1 = h1, gate = gate, up = up, act = act
        }

        mut tensor<i32, [1]> ids_buf ← tensor<i32, [1]> {}
        mut tensor<f32, [64]> h_cur ← tf32[64] {}
        mut tensor<f32, [64]> h_next ← tf32[64] {}
        mut tensor<f32, [8]> logits ← tf32[8] {}

        let list<int> prompt_ids ← [1, 3]
        mut list<int> gen ← empty
        mut int pos ← 0
        mut int next_tok ← 0
        for exclusive 4 let step {
            let int tok_in ← step ≺ prompt_ids.length() ✓ prompt_ids[step] ✗ next_tok
            ids_buf[0] ← tok_in ↦ i32 ⊥ 0
            embed_wide_group_affine_u32<size 8, size 16, size 1, size 64>(md.embed_tokens, emb_w, emb_s, emb_b, ids_buf, mut h_cur)
            let i32 tpos ← pos ↦ i32 ⊥ 0
            for exclusive mc.num_hidden_layers let l {
                let LayerDescriptors ld ← md.layers[l]
                let QuantizedLayerWeights<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> qlw ← QuantizedLayerWeights<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> {
                    anorm = qbank.anorms[l],
                    wq_desc = ld.q_proj, wq_w = qbank.wq_ws[l], wq_s = qbank.wq_ss[l], wq_b = qbank.wq_bs[l],
                    wk_desc = ld.k_proj, wk_w = qbank.wk_ws[l], wk_s = qbank.wk_ss[l], wk_b = qbank.wk_bs[l],
                    wv_desc = ld.v_proj, wv_w = qbank.wv_ws[l], wv_s = qbank.wv_ss[l], wv_b = qbank.wv_bs[l],
                    wo_desc = ld.o_proj, wo_w = qbank.wo_ws[l], wo_s = qbank.wo_ss[l], wo_b = qbank.wo_bs[l],
                    fnorm = qbank.fnorms[l],
                    wg_desc = ld.gate_proj, wg_w = qbank.wg_ws[l], wg_s = qbank.wg_ss[l], wg_b = qbank.wg_bs[l],
                    wu_desc = ld.up_proj, wu_w = qbank.wu_ws[l], wu_s = qbank.wu_ss[l], wu_b = qbank.wu_bs[l],
                    wd_desc = ld.down_proj, wd_w = qbank.wd_ws[l], wd_s = qbank.wd_ss[l], wd_b = qbank.wd_bs[l]
                }
                do {
                    if l % 2 ≡ 0 {
                        layer_wide_group_affine_u32<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1, size 2, size 8, size 1>(h_cur, mut h_next, qlw, mut session, l, tpos, lp, mut ws)
                    }
                    else {
                        layer_wide_group_affine_u32<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1, size 2, size 8, size 1>(h_next, mut h_cur, qlw, mut session, l, tpos, lp, mut ws)
                    }
                }
                catch err {
                    return false
                }
            }
            # The ping-pong leaves the final hidden state in h_cur after an
            # even layer count and in h_next after an odd one — read the
            # buffer the last layer actually wrote.
            mut tensor<f32, [64]> h_out ← tf32[64] {}
            if mc.num_hidden_layers % 2 ≡ 0 {
                h_out ⇇ h_cur
            }
            else {
                h_out ⇇ h_next
            }
            head_wide_group_affine_u32<size 8, size 16, size 1, size 64>(h_out, onorm, md.lm_head, emb_w, emb_s, emb_b, mut h_next, mut logits, lp.peps)
            ds.argmax_token(logits, mut ids_buf)
            next_tok ← ids_buf[0] ↦ int
            if step ≥ prompt_ids.length() - 1 {
                gen.append(next_tok)
            }
            pos ↑
        }
        if gen.length() ≢ 3 then return false
        if gen[0] ≢ 2 or gen[1] ≢ 2 or gen[2] ≢ 2 then return false
        if kv_valid_count(session, 0) ≢ 4 then return false
        if layers ≥ 2 {
            if kv_valid_count(session, 1) ≢ 4 then return false
        }
        return true
    }
    catch err {
        return false
    }
}

@ public
fn check_slice_a_bf16_end_to_end() → bool {
    mut cfg.ModelConfig ∪ none maybe_mc ← null
    do {
        maybe_mc ← cfg.parse_json(synth_config_json(2))
    }
    catch err {
        return false
    }
    if maybe_mc is none then return false
    let cfg.ModelConfig mc ← maybe_mc

    let list<capsule.SafetensorsTensorDescriptor> descs ← build_synth_descs(mc.num_hidden_layers)
    let int data_len ← synth_data_len(descs)

    mut artifact.ContentIdentity ∪ none maybe_shard ← null
    mut artifact.ContentIdentity ∪ none maybe_cfg ← null
    do {
        maybe_shard ← artifact.identity("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", data_len + 64)
        maybe_cfg ← artifact.identity("sha-256", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", 256)
    }
    catch err {
        return false
    }
    if maybe_shard is none or maybe_cfg is none then return false
    let artifact.ContentIdentity shard_id ← maybe_shard
    let artifact.ContentIdentity cfg_id ← maybe_cfg

    mut bundle.ModelBundle ∪ none maybe_b ← null
    do {
        maybe_b ← bundle.safetensors_unindexed([shard_id], cfg_id, null, null, null, null)
    }
    catch err {
        return false
    }
    if maybe_b is none then return false
    let bundle.ModelBundle b ← maybe_b

    mut td.TensorDirectory ∪ none maybe_dir ← null
    do {
        let capsule.SafetensorsManifest m ← capsule.SafetensorsManifest { format = "safetensors", version = "1", artifact_length = data_len + 64, data_length = data_len, metadata = empty, tensors = descs }
        let list<td.ShardSource> sources ← [variant td.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = m }]
        maybe_dir ← td.build(b, sources, empty, empty)
    }
    catch err {
        return false
    }
    if maybe_dir is none then return false
    let td.TensorDirectory dir ← maybe_dir

    do {
        let ModelDescriptors md ← admit_model_descriptors(b, dir, mc)
        let _ es ← build_slice_a_schedule(mc)
        mut _ session ← allocate_slice_a_session<size 8, size 32>(mc, es)
        let dt.LayerParams lp ← layer_params_from_config(mc)

        mut tensor<u32, [8, 16]> emb_w ← tensor<u32, [8, 16]> {}
        mut tensor<f32, [8, 1]> emb_s_f32 ← tf32[8, 1] {}
        mut tensor<f32, [8, 1]> emb_b_f32 ← tf32[8, 1] {}
        fill_ga_u32(mut emb_w, mut emb_s_f32, mut emb_b_f32, 11)
        mut tensor<bf16, [8, 1]> emb_s ← tbf16[8, 1] {}
        mut tensor<bf16, [8, 1]> emb_b ← tbf16[8, 1] {}
        for exclusive 8 let r {
            emb_s[[r, 0]] ← emb_s_f32[[r, 0]] ↦ bf16
            emb_b[[r, 0]] ← emb_b_f32[[r, 0]] ↦ bf16
        }

        mut tensor<f32, [64]> onorm ← tf32[64] {}
        for exclusive 64 let j {
            onorm[[j]] ← 1.0 ∷ f32
        }

        let lw.LinearWeight bf16_emb_desc ← lw.LinearWeight {
            kind = md.embed_tokens.kind, out_features = md.embed_tokens.out_features, in_features = md.embed_tokens.in_features,
            bits = md.embed_tokens.bits, group_size = md.embed_tokens.group_size, packed_cols = md.embed_tokens.packed_cols,
            group_cols = md.embed_tokens.group_cols, has_bias = false, scales_dtype = "BF16"
        }

        mut tensor<i32, [1]> ids_buf ← tensor<i32, [1]> {}
        mut tensor<f32, [64]> h_cur ← tf32[64] {}
        mut tensor<f32, [64]> h_next ← tf32[64] {}
        mut tensor<f32, [8]> logits ← tf32[8] {}

        ids_buf[0] ← 1 ∷ i32
        embed_wide_group_affine_u32_bf16<size 8, size 16, size 1, size 64>(bf16_emb_desc, emb_w, emb_s, emb_b, ids_buf, mut h_cur)
        head_wide_group_affine_u32_bf16<size 8, size 16, size 1, size 64>(h_cur, onorm, bf16_emb_desc, emb_w, emb_s, emb_b, mut h_next, mut logits, lp.peps)
        ds.argmax_token(logits, mut ids_buf)
        let int tok ← ids_buf[0] ↦ int
        if tok ≺ 0 or tok ≥ 8 then return false
        if kv_valid_count(session, 0) ≢ 0 then return false
        return true
    }
    catch err {
        return false
    }
}

@ public
fn check_slice_a_rotated_kv_session() → bool {
    mut cfg.ModelConfig ∪ none maybe_mc ← null
    do {
        maybe_mc ← cfg.parse_json(synth_config_json(1))
    }
    catch err {
        return false
    }
    if maybe_mc is none then return false
    let cfg.ModelConfig mc ← maybe_mc

    let list<capsule.SafetensorsTensorDescriptor> descs ← build_synth_descs(1)
    let int data_len ← synth_data_len(descs)

    mut artifact.ContentIdentity ∪ none maybe_shard ← null
    mut artifact.ContentIdentity ∪ none maybe_cfg ← null
    do {
        maybe_shard ← artifact.identity("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", data_len + 64)
        maybe_cfg ← artifact.identity("sha-256", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", 256)
    }
    catch err {
        return false
    }
    if maybe_shard is none or maybe_cfg is none then return false
    let artifact.ContentIdentity shard_id ← maybe_shard
    let artifact.ContentIdentity cfg_id ← maybe_cfg

    mut bundle.ModelBundle ∪ none maybe_b ← null
    do {
        maybe_b ← bundle.safetensors_unindexed([shard_id], cfg_id, null, null, null, null)
    }
    catch err {
        return false
    }
    if maybe_b is none then return false
    let bundle.ModelBundle b ← maybe_b

    mut td.TensorDirectory ∪ none maybe_dir ← null
    do {
        let capsule.SafetensorsManifest m ← capsule.SafetensorsManifest { format = "safetensors", version = "1", artifact_length = data_len + 64, data_length = data_len, metadata = empty, tensors = descs }
        let list<td.ShardSource> sources ← [variant td.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = m }]
        maybe_dir ← td.build(b, sources, empty, empty)
    }
    catch err {
        return false
    }
    if maybe_dir is none then return false
    let td.TensorDirectory dir ← maybe_dir

    do {
        let ModelDescriptors md ← admit_model_descriptors(b, dir, mc)
        let _ es ← build_slice_a_schedule(mc)
        mut _ session_half ← allocate_slice_a_session<size 8, size 32>(mc, es)
        mut _ session_none ← allocate_slice_a_session<size 8, size 32>(mc, es)
        let dt.LayerParams lp_half ← layer_params_from_config(mc)
        let dt.LayerParams lp_none ← dt.LayerParams { pdh = lp_half.pdh, pspan = lp_half.pspan, pgroup = lp_half.pgroup, prope = variant dt.RopeKind.None, peps = lp_half.peps, plntheta = lp_half.plntheta, pscale = lp_half.pscale }
        let QuantizedLayerWeights<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> qlw ← build_layer<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1>(md.layers[0], 10)

        mut tensor<f32, [64]> xn ← tf32[64] {}
        mut tensor<f32, [64]> q ← tf32[64] {}
        mut tensor<f32, [64]> qr ← tf32[64] {}
        mut tensor<f32, [32]> k ← tf32[32] {}
        mut tensor<f32, [32]> kr ← tf32[32] {}
        mut tensor<f32, [32]> v ← tf32[32] {}
        mut tensor<f32, [64]> ctx ← tf32[64] {}
        mut tensor<f32, [64]> h1 ← tf32[64] {}
        mut tensor<f32, [64]> gate ← tf32[64] {}
        mut tensor<f32, [64]> up ← tf32[64] {}
        mut tensor<f32, [64]> act ← tf32[64] {}
        mut SliceAWorkspace<size 64, size 64, size 32, size 64, size 2> ws ← SliceAWorkspace<size 64, size 64, size 32, size 64, size 2> {
            xn = xn, q = q, qr = qr, k = k, kr = kr, v = v,
            ctx = ctx, h1 = h1, gate = gate, up = up, act = act
        }

        mut tensor<f32, [64]> hin ← tf32[64] {}
        for exclusive 64 let j {
            hin[[j]] ← ((j % 7 + 1) ↦ f32) * 0.1
        }
        mut tensor<f32, [64]> hout_half ← tf32[64] {}
        mut tensor<f32, [64]> hout_none ← tf32[64] {}

        # At tpos=2 (non-zero position), RopeKind.Half rotates K before storing in SessionState,
        # so the stored K row in session_half must differ from session_none.
        layer_wide_group_affine_u32<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1, size 2, size 8, size 1>(hin, mut hout_half, qlw, mut session_half, 0, 2, lp_half, mut ws)
        layer_wide_group_affine_u32<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1, size 2, size 8, size 1>(hin, mut hout_none, qlw, mut session_none, 0, 2, lp_none, mut ws)

        if kv_valid_count(session_half, 0) ≢ 3 then return false
        if kv_valid_count(session_none, 0) ≢ 3 then return false
        mut tensor<f32, [8, 32]> k_half ← tf32[8, 32] {}
        mut tensor<f32, [8, 32]> k_none ← tf32[8, 32] {}
        do {
            k_half ← sess_mod.full_kv_keys(session_half, 0)
            k_none ← sess_mod.full_kv_keys(session_none, 0)
        }
        catch err {
            return false
        }
        mut bool diff ← false
        for exclusive 32 let j {
            if (k_half[[2, j]] - k_none[[2, j]]).abs() ≻ 0.0001 {
                diff ← true
            }
        }
        return diff
    }
    catch err {
        return false
    }
}

@ public
fn check_slice_a_rejects_non_8bit() → bool {
    let string bad_json ← «{"model_type":"llama","hidden_size":64,"num_hidden_layers":2,"num_attention_heads":2,"num_key_value_heads":1,"head_dim":32,"intermediate_size":64,"vocab_size":8,"max_position_embeddings":8,"rms_norm_eps":0.00001,"rope_theta":10000.0,"tie_word_embeddings":true,"quantization":{"bits":4,"group_size":64}}»
    mut cfg.ModelConfig ∪ none maybe_mc ← null
    do {
        maybe_mc ← cfg.parse_json(bad_json)
    }
    catch err {
        return false
    }
    if maybe_mc is none then return false
    let cfg.ModelConfig mc ← maybe_mc
    do {
        let _ hint ← quant_hint_from_config(mc)
        return false
    }
    catch err {
        return true
    }
}

fn with_f16_scales_desc(lw.LinearWeight d) → lw.LinearWeight {
    return lw.LinearWeight {
        kind = d.kind, out_features = d.out_features, in_features = d.in_features,
        bits = d.bits, group_size = d.group_size, packed_cols = d.packed_cols,
        group_cols = d.group_cols, has_bias = d.has_bias, scales_dtype = "F16"
    }
}

fn fill_ga_u32_f16_exact<size Out, size PackedIn, size Groups>(mut tensor<u32, [Out, PackedIn]> w, mut tensor<f16, [Out, Groups]> s, mut tensor<f16, [Out, Groups]> b, mut tensor<f32, [Out, Groups]> s_f32, mut tensor<f32, [Out, Groups]> b_f32, int salt) → void {
    fill_ga_u32(mut w, mut s_f32, mut b_f32, salt)
    for exclusive Out let r {
        for exclusive Groups let g {
            let f16 sf16 ← (0.125 ∷ f32) * (((r + g + salt) % 4 + 1) ↦ f32) ↦ f16
            let f16 bf16 ← (-0.25 ∷ f32) ↦ f16
            s[[r, g]] ← sf16
            b[[r, g]] ← bf16
            s_f32[[r, g]] ← sf16 ↦ f32
            b_f32[[r, g]] ← bf16 ↦ f32
        }
    }
}

fn build_layer_f16_exact<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF>(LayerDescriptors ld, int salt) → QuantizedLayerWeightsF16<D, QD, KVD, F, PD, GD, PQD, GQD, PF, GF> {
    mut tensor<f32, [D]> anorm ← tf32[D] {}
    mut tensor<f32, [D]> fnorm ← tf32[D] {}
    for exclusive D let j {
        anorm[[j]] ← 1.0 ∷ f32
        fnorm[[j]] ← 1.0 ∷ f32
    }

    mut tensor<u32, [QD, PD]> wq_w ← tensor<u32, [QD, PD]> {}
    mut tensor<f16, [QD, GD]> wq_s ← tf16[QD, GD] {}
    mut tensor<f16, [QD, GD]> wq_b ← tf16[QD, GD] {}
    mut tensor<f32, [QD, GD]> wq_s32 ← tf32[QD, GD] {}
    mut tensor<f32, [QD, GD]> wq_b32 ← tf32[QD, GD] {}
    fill_ga_u32_f16_exact(mut wq_w, mut wq_s, mut wq_b, mut wq_s32, mut wq_b32, salt + 1)

    mut tensor<u32, [KVD, PD]> wk_w ← tensor<u32, [KVD, PD]> {}
    mut tensor<f16, [KVD, GD]> wk_s ← tf16[KVD, GD] {}
    mut tensor<f16, [KVD, GD]> wk_b ← tf16[KVD, GD] {}
    mut tensor<f32, [KVD, GD]> wk_s32 ← tf32[KVD, GD] {}
    mut tensor<f32, [KVD, GD]> wk_b32 ← tf32[KVD, GD] {}
    fill_ga_u32_f16_exact(mut wk_w, mut wk_s, mut wk_b, mut wk_s32, mut wk_b32, salt + 2)

    mut tensor<u32, [KVD, PD]> wv_w ← tensor<u32, [KVD, PD]> {}
    mut tensor<f16, [KVD, GD]> wv_s ← tf16[KVD, GD] {}
    mut tensor<f16, [KVD, GD]> wv_b ← tf16[KVD, GD] {}
    mut tensor<f32, [KVD, GD]> wv_s32 ← tf32[KVD, GD] {}
    mut tensor<f32, [KVD, GD]> wv_b32 ← tf32[KVD, GD] {}
    fill_ga_u32_f16_exact(mut wv_w, mut wv_s, mut wv_b, mut wv_s32, mut wv_b32, salt + 3)

    mut tensor<u32, [D, PQD]> wo_w ← tensor<u32, [D, PQD]> {}
    mut tensor<f16, [D, GQD]> wo_s ← tf16[D, GQD] {}
    mut tensor<f16, [D, GQD]> wo_b ← tf16[D, GQD] {}
    mut tensor<f32, [D, GQD]> wo_s32 ← tf32[D, GQD] {}
    mut tensor<f32, [D, GQD]> wo_b32 ← tf32[D, GQD] {}
    fill_ga_u32_f16_exact(mut wo_w, mut wo_s, mut wo_b, mut wo_s32, mut wo_b32, salt + 4)

    mut tensor<u32, [F, PD]> wg_w ← tensor<u32, [F, PD]> {}
    mut tensor<f16, [F, GD]> wg_s ← tf16[F, GD] {}
    mut tensor<f16, [F, GD]> wg_b ← tf16[F, GD] {}
    mut tensor<f32, [F, GD]> wg_s32 ← tf32[F, GD] {}
    mut tensor<f32, [F, GD]> wg_b32 ← tf32[F, GD] {}
    fill_ga_u32_f16_exact(mut wg_w, mut wg_s, mut wg_b, mut wg_s32, mut wg_b32, salt + 5)

    mut tensor<u32, [F, PD]> wu_w ← tensor<u32, [F, PD]> {}
    mut tensor<f16, [F, GD]> wu_s ← tf16[F, GD] {}
    mut tensor<f16, [F, GD]> wu_b ← tf16[F, GD] {}
    mut tensor<f32, [F, GD]> wu_s32 ← tf32[F, GD] {}
    mut tensor<f32, [F, GD]> wu_b32 ← tf32[F, GD] {}
    fill_ga_u32_f16_exact(mut wu_w, mut wu_s, mut wu_b, mut wu_s32, mut wu_b32, salt + 6)

    mut tensor<u32, [D, PF]> wd_w ← tensor<u32, [D, PF]> {}
    mut tensor<f16, [D, GF]> wd_s ← tf16[D, GF] {}
    mut tensor<f16, [D, GF]> wd_b ← tf16[D, GF] {}
    mut tensor<f32, [D, GF]> wd_s32 ← tf32[D, GF] {}
    mut tensor<f32, [D, GF]> wd_b32 ← tf32[D, GF] {}
    fill_ga_u32_f16_exact(mut wd_w, mut wd_s, mut wd_b, mut wd_s32, mut wd_b32, salt + 7)

    return QuantizedLayerWeightsF16<size D, size QD, size KVD, size F, size PD, size GD, size PQD, size GQD, size PF, size GF> {
        anorm = anorm,
        wq_desc = with_f16_scales_desc(ld.q_proj), wq_w = wq_w, wq_s = wq_s, wq_b = wq_b,
        wk_desc = with_f16_scales_desc(ld.k_proj), wk_w = wk_w, wk_s = wk_s, wk_b = wk_b,
        wv_desc = with_f16_scales_desc(ld.v_proj), wv_w = wv_w, wv_s = wv_s, wv_b = wv_b,
        wo_desc = with_f16_scales_desc(ld.o_proj), wo_w = wo_w, wo_s = wo_s, wo_b = wo_b,
        fnorm = fnorm,
        wg_desc = with_f16_scales_desc(ld.gate_proj), wg_w = wg_w, wg_s = wg_s, wg_b = wg_b,
        wu_desc = with_f16_scales_desc(ld.up_proj), wu_w = wu_w, wu_s = wu_s, wu_b = wu_b,
        wd_desc = with_f16_scales_desc(ld.down_proj), wd_w = wd_w, wd_s = wd_s, wd_b = wd_b
    }
}

@ public
fn check_slice_a_f16_end_to_end() → bool {
    mut cfg.ModelConfig ∪ none maybe_mc ← null
    do {
        maybe_mc ← cfg.parse_json(synth_config_json(2))
    }
    catch err {
        return false
    }
    if maybe_mc is none then return false
    let cfg.ModelConfig mc ← maybe_mc

    let list<capsule.SafetensorsTensorDescriptor> descs ← build_synth_descs(mc.num_hidden_layers)
    let int data_len ← synth_data_len(descs)

    mut artifact.ContentIdentity ∪ none maybe_shard ← null
    mut artifact.ContentIdentity ∪ none maybe_cfg ← null
    do {
        maybe_shard ← artifact.identity("sha-256", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", data_len + 64)
        maybe_cfg ← artifact.identity("sha-256", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", 256)
    }
    catch err {
        return false
    }
    if maybe_shard is none or maybe_cfg is none then return false
    let artifact.ContentIdentity shard_id ← maybe_shard
    let artifact.ContentIdentity cfg_id ← maybe_cfg

    mut bundle.ModelBundle ∪ none maybe_b ← null
    do {
        maybe_b ← bundle.safetensors_unindexed([shard_id], cfg_id, null, null, null, null)
    }
    catch err {
        return false
    }
    if maybe_b is none then return false
    let bundle.ModelBundle b ← maybe_b

    mut td.TensorDirectory ∪ none maybe_dir ← null
    do {
        let capsule.SafetensorsManifest m ← capsule.SafetensorsManifest { format = "safetensors", version = "1", artifact_length = data_len + 64, data_length = data_len, metadata = empty, tensors = descs }
        let list<td.ShardSource> sources ← [variant td.ShardSource.SafetensorsSource { role = variant bundle.MemberRole.Backbone, shard_index = 0, manifest = m }]
        maybe_dir ← td.build(b, sources, empty, empty)
    }
    catch err {
        return false
    }
    if maybe_dir is none then return false
    let td.TensorDirectory dir ← maybe_dir

    do {
        let ModelDescriptors md ← admit_model_descriptors(b, dir, mc)
        let _ es ← build_slice_a_schedule(mc)
        mut _ session_f16 ← allocate_slice_a_session<size 8, size 32>(mc, es)
        mut _ session_f32 ← allocate_slice_a_session<size 8, size 32>(mc, es)
        let dt.LayerParams lp ← layer_params_from_config(mc)

        mut tensor<u32, [8, 16]> emb_w ← tensor<u32, [8, 16]> {}
        mut tensor<f16, [8, 1]> emb_s ← tf16[8, 1] {}
        mut tensor<f16, [8, 1]> emb_b ← tf16[8, 1] {}
        mut tensor<f32, [8, 1]> emb_s32 ← tf32[8, 1] {}
        mut tensor<f32, [8, 1]> emb_b32 ← tf32[8, 1] {}
        fill_ga_u32_f16_exact(mut emb_w, mut emb_s, mut emb_b, mut emb_s32, mut emb_b32, 11)
        let lw.LinearWeight f16_emb_desc ← with_f16_scales_desc(md.embed_tokens)
        let lw.LinearWeight f16_head_desc ← with_f16_scales_desc(md.lm_head)

        mut tensor<f32, [64]> onorm ← tf32[64] {}
        for exclusive 64 let j {
            onorm[[j]] ← 1.0 ∷ f32
        }

        mut QuantizedLayerBankF16<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> qbank_f16 ← QuantizedLayerBankF16<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> {
            anorms = empty, wq_ws = empty, wq_ss = empty, wq_bs = empty,
            wk_ws = empty, wk_ss = empty, wk_bs = empty,
            wv_ws = empty, wv_ss = empty, wv_bs = empty,
            wo_ws = empty, wo_ss = empty, wo_bs = empty,
            fnorms = empty, wg_ws = empty, wg_ss = empty, wg_bs = empty,
            wu_ws = empty, wu_ss = empty, wu_bs = empty,
            wd_ws = empty, wd_ss = empty, wd_bs = empty
        }
        mut QuantizedLayerBank<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> qbank_f32 ← QuantizedLayerBank<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> {
            anorms = empty, wq_ws = empty, wq_ss = empty, wq_bs = empty,
            wk_ws = empty, wk_ss = empty, wk_bs = empty,
            wv_ws = empty, wv_ss = empty, wv_bs = empty,
            wo_ws = empty, wo_ss = empty, wo_bs = empty,
            fnorms = empty, wg_ws = empty, wg_ss = empty, wg_bs = empty,
            wu_ws = empty, wu_ss = empty, wu_bs = empty,
            wd_ws = empty, wd_ss = empty, wd_bs = empty
        }
        for exclusive mc.num_hidden_layers let l {
            let QuantizedLayerWeightsF16<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> lf16 ← build_layer_f16_exact<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1>(md.layers[l], (l + 1) * 10)
            qbank_f16.anorms.append(lf16.anorm)
            qbank_f16.wq_ws.append(lf16.wq_w)
            qbank_f16.wq_ss.append(lf16.wq_s)
            qbank_f16.wq_bs.append(lf16.wq_b)
            qbank_f16.wk_ws.append(lf16.wk_w)
            qbank_f16.wk_ss.append(lf16.wk_s)
            qbank_f16.wk_bs.append(lf16.wk_b)
            qbank_f16.wv_ws.append(lf16.wv_w)
            qbank_f16.wv_ss.append(lf16.wv_s)
            qbank_f16.wv_bs.append(lf16.wv_b)
            qbank_f16.wo_ws.append(lf16.wo_w)
            qbank_f16.wo_ss.append(lf16.wo_s)
            qbank_f16.wo_bs.append(lf16.wo_b)
            qbank_f16.fnorms.append(lf16.fnorm)
            qbank_f16.wg_ws.append(lf16.wg_w)
            qbank_f16.wg_ss.append(lf16.wg_s)
            qbank_f16.wg_bs.append(lf16.wg_b)
            qbank_f16.wu_ws.append(lf16.wu_w)
            qbank_f16.wu_ss.append(lf16.wu_s)
            qbank_f16.wu_bs.append(lf16.wu_b)
            qbank_f16.wd_ws.append(lf16.wd_w)
            qbank_f16.wd_ss.append(lf16.wd_s)
            qbank_f16.wd_bs.append(lf16.wd_b)
            mut tensor<f32, [64, 1]> wq_s32 ← tf32[64, 1] {}
            mut tensor<f32, [64, 1]> wq_b32 ← tf32[64, 1] {}
            mut tensor<f32, [32, 1]> wk_s32 ← tf32[32, 1] {}
            mut tensor<f32, [32, 1]> wk_b32 ← tf32[32, 1] {}
            mut tensor<f32, [32, 1]> wv_s32 ← tf32[32, 1] {}
            mut tensor<f32, [32, 1]> wv_b32 ← tf32[32, 1] {}
            mut tensor<f32, [64, 1]> wo_s32 ← tf32[64, 1] {}
            mut tensor<f32, [64, 1]> wo_b32 ← tf32[64, 1] {}
            mut tensor<f32, [64, 1]> wg_s32 ← tf32[64, 1] {}
            mut tensor<f32, [64, 1]> wg_b32 ← tf32[64, 1] {}
            mut tensor<f32, [64, 1]> wu_s32 ← tf32[64, 1] {}
            mut tensor<f32, [64, 1]> wu_b32 ← tf32[64, 1] {}
            mut tensor<f32, [64, 1]> wd_s32 ← tf32[64, 1] {}
            mut tensor<f32, [64, 1]> wd_b32 ← tf32[64, 1] {}
            for exclusive 64 let r {
                wq_s32[[r, 0]] ← lf16.wq_s[[r, 0]] ↦ f32
                wq_b32[[r, 0]] ← lf16.wq_b[[r, 0]] ↦ f32
                wo_s32[[r, 0]] ← lf16.wo_s[[r, 0]] ↦ f32
                wo_b32[[r, 0]] ← lf16.wo_b[[r, 0]] ↦ f32
                wg_s32[[r, 0]] ← lf16.wg_s[[r, 0]] ↦ f32
                wg_b32[[r, 0]] ← lf16.wg_b[[r, 0]] ↦ f32
                wu_s32[[r, 0]] ← lf16.wu_s[[r, 0]] ↦ f32
                wu_b32[[r, 0]] ← lf16.wu_b[[r, 0]] ↦ f32
                wd_s32[[r, 0]] ← lf16.wd_s[[r, 0]] ↦ f32
                wd_b32[[r, 0]] ← lf16.wd_b[[r, 0]] ↦ f32
            }
            for exclusive 32 let r {
                wk_s32[[r, 0]] ← lf16.wk_s[[r, 0]] ↦ f32
                wk_b32[[r, 0]] ← lf16.wk_b[[r, 0]] ↦ f32
                wv_s32[[r, 0]] ← lf16.wv_s[[r, 0]] ↦ f32
                wv_b32[[r, 0]] ← lf16.wv_b[[r, 0]] ↦ f32
            }
            qbank_f32.anorms.append(lf16.anorm)
            qbank_f32.wq_ws.append(lf16.wq_w)
            qbank_f32.wq_ss.append(wq_s32)
            qbank_f32.wq_bs.append(wq_b32)
            qbank_f32.wk_ws.append(lf16.wk_w)
            qbank_f32.wk_ss.append(wk_s32)
            qbank_f32.wk_bs.append(wk_b32)
            qbank_f32.wv_ws.append(lf16.wv_w)
            qbank_f32.wv_ss.append(wv_s32)
            qbank_f32.wv_bs.append(wv_b32)
            qbank_f32.wo_ws.append(lf16.wo_w)
            qbank_f32.wo_ss.append(wo_s32)
            qbank_f32.wo_bs.append(wo_b32)
            qbank_f32.fnorms.append(lf16.fnorm)
            qbank_f32.wg_ws.append(lf16.wg_w)
            qbank_f32.wg_ss.append(wg_s32)
            qbank_f32.wg_bs.append(wg_b32)
            qbank_f32.wu_ws.append(lf16.wu_w)
            qbank_f32.wu_ss.append(wu_s32)
            qbank_f32.wu_bs.append(wu_b32)
            qbank_f32.wd_ws.append(lf16.wd_w)
            qbank_f32.wd_ss.append(wd_s32)
            qbank_f32.wd_bs.append(wd_b32)
        }

        mut tensor<f32, [64]> xn ← tf32[64] {}
        mut tensor<f32, [64]> q ← tf32[64] {}
        mut tensor<f32, [64]> qr ← tf32[64] {}
        mut tensor<f32, [32]> k ← tf32[32] {}
        mut tensor<f32, [32]> kr ← tf32[32] {}
        mut tensor<f32, [32]> v ← tf32[32] {}
        mut tensor<f32, [64]> ctx ← tf32[64] {}
        mut tensor<f32, [64]> h1 ← tf32[64] {}
        mut tensor<f32, [64]> gate ← tf32[64] {}
        mut tensor<f32, [64]> up ← tf32[64] {}
        mut tensor<f32, [64]> act ← tf32[64] {}
        mut SliceAWorkspace<size 64, size 64, size 32, size 64, size 2> ws ← SliceAWorkspace<size 64, size 64, size 32, size 64, size 2> {
            xn = xn, q = q, qr = qr, k = k, kr = kr, v = v,
            ctx = ctx, h1 = h1, gate = gate, up = up, act = act
        }

        mut tensor<i32, [1]> ids_buf ← tensor<i32, [1]> {}
        mut tensor<f32, [64]> h_cur_16 ← tf32[64] {}
        mut tensor<f32, [64]> h_next_16 ← tf32[64] {}
        mut tensor<f32, [8]> logits_16 ← tf32[8] {}
        mut tensor<f32, [64]> h_cur_32 ← tf32[64] {}
        mut tensor<f32, [64]> h_next_32 ← tf32[64] {}
        mut tensor<f32, [8]> logits_32 ← tf32[8] {}

        let list<int> prompt_ids ← [1, 3]
        mut list<int> gen_16 ← empty
        mut list<int> gen_32 ← empty
        mut int next_tok_16 ← 0
        mut int next_tok_32 ← 0
        for exclusive 4 let step {
            let int tok_16 ← step ≺ prompt_ids.length() ✓ prompt_ids[step] ✗ next_tok_16
            let int tok_32 ← step ≺ prompt_ids.length() ✓ prompt_ids[step] ✗ next_tok_32
            let i32 tpos ← step ↦ i32 ⊥ 0

            ids_buf[0] ← tok_16 ↦ i32 ⊥ 0
            embed_wide_group_affine_u32_f16<size 8, size 16, size 1, size 64>(f16_emb_desc, emb_w, emb_s, emb_b, ids_buf, mut h_cur_16)
            for exclusive mc.num_hidden_layers let l {
                let LayerDescriptors ld ← md.layers[l]
                let QuantizedLayerWeightsF16<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> qlw16 ← QuantizedLayerWeightsF16<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> {
                    anorm = qbank_f16.anorms[l],
                    wq_desc = with_f16_scales_desc(ld.q_proj), wq_w = qbank_f16.wq_ws[l], wq_s = qbank_f16.wq_ss[l], wq_b = qbank_f16.wq_bs[l],
                    wk_desc = with_f16_scales_desc(ld.k_proj), wk_w = qbank_f16.wk_ws[l], wk_s = qbank_f16.wk_ss[l], wk_b = qbank_f16.wk_bs[l],
                    wv_desc = with_f16_scales_desc(ld.v_proj), wv_w = qbank_f16.wv_ws[l], wv_s = qbank_f16.wv_ss[l], wv_b = qbank_f16.wv_bs[l],
                    wo_desc = with_f16_scales_desc(ld.o_proj), wo_w = qbank_f16.wo_ws[l], wo_s = qbank_f16.wo_ss[l], wo_b = qbank_f16.wo_bs[l],
                    fnorm = qbank_f16.fnorms[l],
                    wg_desc = with_f16_scales_desc(ld.gate_proj), wg_w = qbank_f16.wg_ws[l], wg_s = qbank_f16.wg_ss[l], wg_b = qbank_f16.wg_bs[l],
                    wu_desc = with_f16_scales_desc(ld.up_proj), wu_w = qbank_f16.wu_ws[l], wu_s = qbank_f16.wu_ss[l], wu_b = qbank_f16.wu_bs[l],
                    wd_desc = with_f16_scales_desc(ld.down_proj), wd_w = qbank_f16.wd_ws[l], wd_s = qbank_f16.wd_ss[l], wd_b = qbank_f16.wd_bs[l]
                }
                if l % 2 ≡ 0 {
                    layer_wide_group_affine_u32_f16<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1, size 2, size 8, size 1>(h_cur_16, mut h_next_16, qlw16, mut session_f16, l, tpos, lp, mut ws)
                }
                else {
                    layer_wide_group_affine_u32_f16<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1, size 2, size 8, size 1>(h_next_16, mut h_cur_16, qlw16, mut session_f16, l, tpos, lp, mut ws)
                }
            }
            head_wide_group_affine_u32_f16<size 8, size 16, size 1, size 64>(h_cur_16, onorm, f16_head_desc, emb_w, emb_s, emb_b, mut h_next_16, mut logits_16, lp.peps)
            ds.argmax_token(logits_16, mut ids_buf)
            next_tok_16 ← ids_buf[0] ↦ int

            ids_buf[0] ← tok_32 ↦ i32 ⊥ 0
            embed_wide_group_affine_u32<size 8, size 16, size 1, size 64>(md.embed_tokens, emb_w, emb_s32, emb_b32, ids_buf, mut h_cur_32)
            for exclusive mc.num_hidden_layers let l {
                let LayerDescriptors ld ← md.layers[l]
                let QuantizedLayerWeights<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> qlw32 ← QuantizedLayerWeights<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1> {
                    anorm = qbank_f32.anorms[l],
                    wq_desc = ld.q_proj, wq_w = qbank_f32.wq_ws[l], wq_s = qbank_f32.wq_ss[l], wq_b = qbank_f32.wq_bs[l],
                    wk_desc = ld.k_proj, wk_w = qbank_f32.wk_ws[l], wk_s = qbank_f32.wk_ss[l], wk_b = qbank_f32.wk_bs[l],
                    wv_desc = ld.v_proj, wv_w = qbank_f32.wv_ws[l], wv_s = qbank_f32.wv_ss[l], wv_b = qbank_f32.wv_bs[l],
                    wo_desc = ld.o_proj, wo_w = qbank_f32.wo_ws[l], wo_s = qbank_f32.wo_ss[l], wo_b = qbank_f32.wo_bs[l],
                    fnorm = qbank_f32.fnorms[l],
                    wg_desc = ld.gate_proj, wg_w = qbank_f32.wg_ws[l], wg_s = qbank_f32.wg_ss[l], wg_b = qbank_f32.wg_bs[l],
                    wu_desc = ld.up_proj, wu_w = qbank_f32.wu_ws[l], wu_s = qbank_f32.wu_ss[l], wu_b = qbank_f32.wu_bs[l],
                    wd_desc = ld.down_proj, wd_w = qbank_f32.wd_ws[l], wd_s = qbank_f32.wd_ss[l], wd_b = qbank_f32.wd_bs[l]
                }
                if l % 2 ≡ 0 {
                    layer_wide_group_affine_u32<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1, size 2, size 8, size 1>(h_cur_32, mut h_next_32, qlw32, mut session_f32, l, tpos, lp, mut ws)
                }
                else {
                    layer_wide_group_affine_u32<size 64, size 64, size 32, size 64, size 16, size 1, size 16, size 1, size 16, size 1, size 2, size 8, size 1>(h_next_32, mut h_cur_32, qlw32, mut session_f32, l, tpos, lp, mut ws)
                }
            }
            head_wide_group_affine_u32<size 8, size 16, size 1, size 64>(h_cur_32, onorm, md.lm_head, emb_w, emb_s32, emb_b32, mut h_next_32, mut logits_32, lp.peps)
            ds.argmax_token(logits_32, mut ids_buf)
            next_tok_32 ← ids_buf[0] ↦ int

            if step ≥ prompt_ids.length() - 1 {
                gen_16.append(next_tok_16)
                gen_32.append(next_tok_32)
            }
        }
        if gen_16.length() ≢ 3 or gen_16 ≢ gen_32 then return false
        for exclusive 8 let v {
            if (logits_16[[v]] - logits_32[[v]]).abs() ≻ 0.0001 then return false
        }
        if kv_valid_count(session_f16, 0) ≢ 4 or kv_valid_count(session_f16, 1) ≢ 4 then return false
        return true
    }
    catch err {
        return false
    }
}

+++ faber test
import from "gradus:decode_slice_a" let sa

test "decode_slice_a seam 1-4 admission and schedule" {
    assert sa.check_slice_a_admission_code() ≡ 0
}

test "decode_slice_a rejects non-8-bit quantization config" {
    assert sa.check_slice_a_rejects_non_8bit()
}

test "decode_slice_a end-to-end quantized B=1 generation over seams 1-5" {
    assert sa.check_slice_a_end_to_end()
}

test "decode_slice_a end-to-end generation holds for an odd layer count (ping-pong handoff)" {
    assert sa.check_slice_a_end_to_end_layers(1)
}

test "decode_slice_a end-to-end generation holds for a three-layer count (ping-pong handoff)" {
    assert sa.check_slice_a_end_to_end_layers(3)
}

test "decode_slice_a bf16 group_affine embed and head over seams 1-5" {
    assert sa.check_slice_a_bf16_end_to_end()
}

test "decode_slice_a f16 group_affine B=1 generation matches f32 parity over seams 1-5" {
    assert sa.check_slice_a_f16_end_to_end()
}

test "decode_slice_a writes rotated keys into single authoritative SessionState" {
    assert sa.check_slice_a_rotated_kv_session()
}
