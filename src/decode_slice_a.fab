                    q ← (w0 ⇒ (8 ∷ u32)) ∧ (255 ∷ u32)
                }
                elif shift ≡ 16 {
                    q ← (w0 ⇒ (16 ∷ u32)) ∧ (255 ∷ u32)
                }
