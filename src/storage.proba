+++
locale = "en"
+++
# Co-located proof for the open encoded-storage contract.

import from "gradus:storage" storage

fn bytes_from(list<int> values) → bytes {
    var list<int<u8>> out ← empty
    for from values const value {
        out.append(value ↦ int<u8>)
    }
    return out ↦ bytes
}

test "unknown GGML codes retain an open identity" {
    const storage.Representation value ← storage.ggml_representation(4096)
    assert value.namespace ≡ "ggml"
    assert value.name ≡ "unknown"
    assert value.version ≡ "unspecified"
    assert value.code ≡ 4096
    assert storage.identity(value) ≡ "ggml/unspecified/unknown/4096"
}

test "arbitrary representations preserve bytes and block metadata" {
    const storage.Representation value ← storage.representation("vendor", "q3x", "2026", 7)
    const storage.BlockMetadata block ← storage.known_block(96, 17, 2, 34)
    const storage.EncodedStorage encoded ← storage.encoded(bytes_from([1, 2, 3]), value, block)
    assert encoded.payload.length() ≡ 3
    assert encoded.payload.get(0) coalesce 0 ∷ int<u8> ≡ 1 ∷ int<u8>
    assert encoded.payload.get(2) coalesce 0 ∷ int<u8> ≡ 3 ∷ int<u8>
    assert storage.identity(encoded.representation) ≡ "vendor/2026/q3x/7"
    assert encoded.representation.name ≡ "q3x"
    assert encoded.representation.code ≡ 7
    assert encoded.block.elements_per_block ≡ 96
    assert encoded.block.bytes_per_block ≡ 17
    assert encoded.block.block_count ≡ 2
    assert encoded.block.byte_length ≡ 34
    assert storage.block_valid(encoded.block)
    assert not storage.complete(encoded)
}

test "known geometry can describe an empty payload without a sentinel block" {
    const storage.BlockMetadata block ← storage.known_block(32, 18, 0, 0)
    const storage.EncodedStorage value ← storage.encoded(||, storage.representation("future", "q4", "1", 17), block)
    assert storage.block_valid(block)
    assert storage.complete(value)
}

test "unknown block geometry remains valid metadata" {
    const storage.BlockMetadata block ← storage.unknown_block(19)
    assert storage.block_valid(block)
    assert not block.known
    assert block.byte_length ≡ 19
}

test "known block geometry rejects multiplication overflow" {
    const storage.BlockMetadata block ← storage.known_block(1, 2, 9223372036854775807, 9223372036854775807)
    assert not storage.block_valid(block)
}
