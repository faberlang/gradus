+++
locale = "en"
+++
# Sampling — deterministic token sampling (PML5-U3, production inference
# computation layer).
#
# Public import: import from "gradus:sampling" sampling
# Depends on: gradus:dtype (finite — the logits/config finite gate),
# gradus:train (Seed — the explicit RNG state seam).
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own those). This module holds no device handle, no hidden state, and
# makes no performance claims.
#
# =========================================================================
# The sampling contract (pml5-delivery.md PML5-U3)
# =========================================================================
#
# --- Pure function --------------------------------------------------------
# Sampling is a PURE function of logits + config + RNG state:
#
#   max(logits) -> token id                       (greedy, exact)
#   sample(logits, Config, history, Seed) -> Sampler
#
# No hidden state: the RNG state (Seed) is an explicit argument and is
# returned advanced in the outcome; equal inputs produce equal outcomes.
# The seed enters through train.construct_seed (the xorshift64 seam); the
# same seed reproduces the same token choices.
#
# --- The pinned pipeline order (deterministic, oracle-pinned) -------------
# sample applies, in this exact order:
#   1. repetition penalty (repetition_penalty) over the history tokens:
#        logits[t] > 0  -> logits[t] / penalty
#        logits[t] <= 0 -> logits[t] * penalty        (the llama.cpp rule)
#   2. temperature scaling: logits[i] / temperature
#   3. top-k: keep the k largest logits (first-index ties; k <= 0 = off)
#   4. stabilized softmax (max-subtracted exp, base-e)
#   5. top-p (nucleus): the smallest descending-probability set whose
#        cumulative mass reaches top_p; renormalized (<=0 or >=1 = off)
#   6. min-p: keep probs >= min_p * max_prob; renormalized (<=0 = off)
#   7. draw u in [0,1) from Seed (train.next_f32) and walk the
#        cumulative distribution: first index with cum >= u.
# temperature <= 0 is the GREEDY path: sample returns the argmax token and
# the UNCHANGED Seed (no draw). The order and tie-breaks are part of the
# oracle contract (first-index ties throughout).
#
# --- Fail-closed gates ------------------------------------------------------
# Logits must be non-empty and finite (GI2 finite-gate discipline); the
# history tokens must lie in [0, logits.length()); Config knobs are
# validated by construct_config. Invalid input throws (typed error), never
# silently truncates.
#
# --- Evidence honesty (CTO Q2, hard) --------------------------------------
# This surface is the STRUCTURAL proof: the pure-function shape, the greedy
# exactness, the deterministic pipeline, and the f64 oracle pins (the
# sampling.proba pins evaluate the documented arithmetic). Executed token
# value-identity is env-blocked tree-wide today (FMIR stepper /
# library-import gap — the PML4 closeout recorded both blockers; neither is
# fixed here). PML5-U3 is PARTIAL and token value-identity is deferred to
# the auditor-owned runtime-evidence gate.
import from "gradus:dtype" dtype

import from "gradus:train" train

# -------------------------------------------------------------------------
# SamplingError — typed error vocabulary of the sampling surface.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------


@ public { }
union SamplingError {
    InvalidLogits {
        string message
    },
    InvalidConfig {
        string message
    },
    InvalidHistory {
        string message
    }
}

@ public { }
fn message(SamplingError e) → string {
    match e {
        case InvalidLogits const message {
            return message
        }
        case InvalidConfig const message {
            return message
        }
        case InvalidHistory const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# Config — the sampling knobs. The validated constructor is
# construct_config; the class itself is the plain carrier.
# -------------------------------------------------------------------------


@ public { }
class Config {
    f32 temperature
    int top_k
    f32 top_p
    f32 min_p
    f32 repetition_penalty

    # Temperature scaling; <= 0 selects the greedy path.
    fn temperature() → f32 {
        return self.temperature
    }

    # Top-k filter width; 0 disables the filter.
    fn top_k() → int {
        return self.top_k
    }

    # Top-p (nucleus) threshold; <= 0 or >= 1 disables the filter.
    fn top_p() → f32 {
        return self.top_p
    }

    # Min-p threshold; <= 0 disables the filter.
    fn min_p() → f32 {
        return self.min_p
    }

    # Repetition penalty; 1.0 = no penalty.
    fn repetition_penalty() → f32 {
        return self.repetition_penalty
    }
}

# The validated Config constructor. Temperature may be 0 (the greedy
# flag); top_k non-negative; top_p / min_p within [0, 1]; the repetition
# penalty at least 1.0.
@ public { }
fn construct_config(f32 temperature, int top_k, f32 top_p, f32 min_p, f32 repetition_penalty) → Config ⇥ SamplingError {
    if temperature ≺ 0.0 {
        throw variant InvalidConfig {message = "temperature must be non-negative"}
    }
    if top_k ≺ 0 {
        throw variant InvalidConfig {message = "top-k must be non-negative"}
    }
    if (not dtype.finite(top_p) or top_p ≺ 0.0) or top_p ≻ 1.0 {
        throw variant InvalidConfig {message = "top-p must be within [0, 1]"}
    }
    if (not dtype.finite(min_p) or min_p ≺ 0.0) or min_p ≻ 1.0 {
        throw variant InvalidConfig {message = "min-p must be within [0, 1]"}
    }
    if not dtype.finite(repetition_penalty) or repetition_penalty ≺ 1.0 {
        throw variant InvalidConfig {message = "repetition penalty must be at least 1"}
    }
    return Config {temperature = temperature, top_k = top_k, top_p = top_p, min_p = min_p, repetition_penalty = repetition_penalty}
}

# Placeholder Default for `var Config` bindings (var on structs).
# Zero knobs (not a valid config). Only a placeholder the caller
# overwrites, or returns from an unreachable cape arm.
@ public { }
fn default_config() → Config {
    return Config {temperature = 0.0, top_k = 0, top_p = 0.0, min_p = 0.0, repetition_penalty = 0.0}
}

# -------------------------------------------------------------------------
# Sampler — a sample outcome: the chosen token id + the advanced RNG state.
# -------------------------------------------------------------------------


@ public { }
class Sampler {
    int token_id
    train.Seed seed

    # The chosen token id (the draw outcome).
    fn token_id() → int {
        return self.token_id
    }

    # The advanced generator state (the explicit RNG continuation).
    fn seed() → train.Seed {
        return self.seed
    }
}

# Placeholder Default for `var Sampler` bindings (var on structs).
# Token 0 and an empty seed (not a valid draw). Only a placeholder the
# caller overwrites, or returns from an unreachable cape arm.
@ public { }
fn default() → Sampler {
    return Sampler {token_id = 0, seed = train.default()}
}

# -------------------------------------------------------------------------
# max — the GREEDY path: the index of the largest logit (first-index
# tie-break). Exact, pure, no RNG. Rejects empty or non-finite logits.
# -------------------------------------------------------------------------

@ public { }
fn max(list<f32> logits) → int ⇥ SamplingError {
    if logits.length() ≡ 0 {
        throw variant InvalidLogits {message = "logits must be non-empty"}
    }
    if not _finite(logits) {
        throw variant InvalidLogits {message = "logits must be finite"}
    }
    return _max_index(logits)
}

# -------------------------------------------------------------------------
# distribution — the PURE post-filter distribution: logits + config +
# history in, the filtered probability vector out (steps 1–6 of the pinned
# pipeline; no RNG). sample consumes it and adds the draw. Exposed so the
# oracle pins can compare the per-knob distributions.
# -------------------------------------------------------------------------

@ public { }
fn distribution(list<f32> logits, Config c, list<int> history) → list<f32> ⇥ SamplingError {
    if logits.length() ≡ 0 {
        throw variant InvalidLogits {message = "logits must be non-empty"}
    }
    if not _finite(logits) {
        throw variant InvalidLogits {message = "logits must be finite"}
    }
    for from history const t {
        if t ≺ 0 or t ≥ logits.length() {
            throw variant InvalidHistory {message = "history token out of vocabulary range"}
        }
    }
    if c.temperature() ≤ 0.0 {
        var list<f32> degenerate ← vacua
        for range 0‥logits.length() const i {
            degenerate.append(0.0)
        }
        degenerate ← _f32(degenerate, _max_index(logits), 1.0)
        return degenerate
    }
    const list<f32> penalized ← _repetition_penalty(logits, history, c.repetition_penalty())
    const list<f32> scaled ← _temperature_scale(penalized, c.temperature())
    const list<f32> k_limited ← _top_k(scaled, c.top_k())
    const list<f32> probs ← _softmax(k_limited)
    const list<f32> p_limited ← _top_p(probs, c.top_p())
    return _min_p(p_limited, c.min_p())
}

# -------------------------------------------------------------------------
# sample — the STOCHASTIC path: pure function of logits + config + history +
# RNG state. temperature <= 0 selects the greedy path (argmax, seed
# unchanged). Otherwise distribution runs and the outcome carries the
# advanced Seed.
# -------------------------------------------------------------------------

@ public { }
fn sample(list<f32> logits, Config c, list<int> history, train.Seed seed) → Sampler ⇥ SamplingError {
    if logits.length() ≡ 0 {
        throw variant InvalidLogits {message = "logits must be non-empty"}
    }
    if not _finite(logits) {
        throw variant InvalidLogits {message = "logits must be finite"}
    }
    for from history const t {
        if t ≺ 0 or t ≥ logits.length() {
            throw variant InvalidHistory {message = "history token out of vocabulary range"}
        }
    }
    if c.temperature() ≤ 0.0 {
        const int token ← max(logits)
        return Sampler {token_id = token, seed = seed}
    }
    const list<f32> probs ← distribution(logits, c, history)
    return _distribution(probs, seed)
}

# -------------------------------------------------------------------------
# Private helpers (the deterministic pipeline).
# -------------------------------------------------------------------------

# e^x via the base-e exponentiation with a sign split: power is only
# ever called with a non-negative exponent (1/e^{−x} for x < 0), matching
# the accepted loss.fab precedent — no negative-power runtime claim.
const f32 E ← 2.718281828459045 ∷ f32

@ private { }
fn _exp(f32 x) → f32 {
    if x ≥ 0.0 then return E.power(x)
    return 1.0 / E.power(0.0 - x)
}

# The index of the largest value (first-index tie-break). Non-empty input.
@ private { }
fn _max_index(list<f32> xs) → int {
    var int best ← 0
    var f32 best_val ← xs.get(0) coalesce 0.0 ∷ f32
    for range 1‥xs.length() const i {
        const f32 v ← xs.get(i) coalesce 0.0 ∷ f32
        if v ≻ best_val {
            best_val ← v
            best ← i
        }
    }
    return best
}

# The index of the largest value among positions not yet kept (the
# incremental top-k / top-p selection; first-index ties).
@ private { }
fn _max_index_pair(list<f32> xs, list<bool> keep) → int {
    var int best ← 0
    var bool init ← false
    var f32 best_val ← 0.0
    for range 0‥xs.length() const i {
        if not (keep.get(i) coalesce false) {
            const f32 v ← xs.get(i) coalesce 0.0 ∷ f32
            if not init or v ≻ best_val {
                best ← i
                best_val ← v
                init ← true
            }
        }
    }
    return best
}

# Every element is finite (the GI2 finite gate).
@ private { }
fn _finite(list<f32> xs) → bool {
    for from xs const v {
        if not dtype.finite(v) then return false
    }
    return true
}

# A false mask of length n.
@ private { }
fn _mask_false(int n) → list<bool> {
    var list<bool> m ← vacua
    for range 0‥n const _ {
        m.append(false)
    }
    return m
}

# The mask with position i replaced by v (pure rebuild).
@ private { }
fn _binary(list<bool> xs, int i, bool v) → list<bool> {
    var list<bool> out ← vacua
    for range 0‥xs.length() const j {
        if j ≡ i {
            out.append(v)
        }
        else {
            out.append(xs.get(j) coalesce false)
        }
    }
    return out
}

# The list with position i replaced by v (pure rebuild).
@ private { }
fn _f32(list<f32> xs, int i, f32 v) → list<f32> {
    var list<f32> out ← vacua
    for range 0‥xs.length() const j {
        if j ≡ i {
            out.append(v)
        }
        else {
            out.append(xs.get(j) coalesce 0.0 ∷ f32)
        }
    }
    return out
}

# Step 1 — repetition penalty over the history tokens (llama.cpp rule:
# positive logits divide by penalty, non-positive multiply by penalty).
@ private { }
fn _repetition_penalty(list<f32> logits, list<int> history, f32 penalty) → list<f32> {
    const int n ← logits.length()
    var list<f32> out ← vacua
    for range 0‥n const i {
        const f32 v ← logits.get(i) coalesce 0.0 ∷ f32
        var f32 w ← v
        for from history const t {
            if t ≡ i {
                if w ≻ 0.0 {
                    w ← w / penalty
                }
                else {
                    w ← w * penalty
                }
            }
        }
        out.append(w)
    }
    return out
}

# Step 2 — temperature scaling (pure per-element division).
@ private { }
fn _temperature_scale(list<f32> logits, f32 temperature) → list<f32> {
    var list<f32> out ← vacua
    for from logits const v {
        out.append(v / temperature)
    }
    return out
}

# Step 3 — top-k: keep the k largest logits (first-index ties, k <= 0 off).
@ private { }
fn _top_k(list<f32> xs, int k) → list<f32> {
    if k ≤ 0 then return xs
    const int n ← xs.length()
    var list<bool> keep ← _mask_false(n)
    var int count ← 0
    while count ≺ k and count ≺ n {
        const int best ← _max_index_pair(xs, keep)
        keep ← _binary(keep, best, true)
        count ← count + 1
    }
    var list<f32> out ← vacua
    for range 0‥n const i {
        if keep.get(i) coalesce false {
            out.append(xs.get(i) coalesce 0.0 ∷ f32)
        }
        else {
            out.append(0.0)
        }
    }
    return out
}

# Step 4 — stabilized softmax (max-subtracted, base-e).
@ private { }
fn _softmax(list<f32> xs) → list<f32> {
    const int n ← xs.length()
    const f32 m ← xs.get(_max_index(xs)) coalesce 0.0 ∷ f32
    var list<f32> es ← vacua
    var f32 sum ← 0.0
    for range 0‥n const i {
        const f32 e ← _exp(xs.get(i) coalesce 0.0 ∷ f32 - m)
        es.append(e)
        sum ← sum + e
    }
    var list<f32> out ← vacua
    for range 0‥n const i {
        out.append(es.get(i) coalesce 0.0 ∷ f32 / sum)
    }
    return out
}

# Renormalize the kept probabilities (kept positions keep prob/sum, others 0).
@ private { }
fn _renormalize_mask(list<f32> ps, list<bool> keep) → list<f32> {
    const int n ← ps.length()
    var f32 sum ← 0.0
    for range 0‥n const i {
        if keep.get(i) coalesce false {
            sum ← sum + ps.get(i) coalesce 0.0 ∷ f32
        }
    }
    var list<f32> out ← vacua
    for range 0‥n const i {
        if keep.get(i) coalesce false {
            out.append(ps.get(i) coalesce 0.0 ∷ f32 / sum)
        }
        else {
            out.append(0.0)
        }
    }
    return out
}

# Step 5 — top-p (nucleus): the smallest descending-probability set whose
# cumulative mass reaches p, renormalized (p <= 0 or p >= 1 off). When all
# positive mass is kept and the cumulative is still below p, the kept set
# stops growing (equivalent to keeping everything nonzero).
@ private { }
fn _top_p(list<f32> ps, f32 p) → list<f32> {
    if p ≤ 0.0 or p ≥ 1.0 then return ps
    const int n ← ps.length()
    var list<bool> keep ← _mask_false(n)
    var f32 cum ← 0.0
    var bool progress ← true
    while cum ≺ p and progress {
        const int best ← _max_index_pair(ps, keep)
        const f32 v ← ps.get(best) coalesce 0.0 ∷ f32
        if v ≻ 0.0 {
            keep ← _binary(keep, best, true)
            cum ← cum + v
        }
        else {
            progress ← false
        }
    }
    return _renormalize_mask(ps, keep)
}

# Step 6 — min-p: keep probs >= min_p * max_prob, renormalized (p <= 0 off).
@ private { }
fn _min_p(list<f32> ps, f32 p) → list<f32> {
    if p ≤ 0.0 then return ps
    const int n ← ps.length()
    const f32 mx ← ps.get(_max_index(ps)) coalesce 0.0 ∷ f32
    const f32 threshold ← mx * p
    var list<bool> keep ← vacua
    for range 0‥n const i {
        if ps.get(i) coalesce 0.0 ∷ f32 ≥ threshold {
            keep.append(true)
        }
        else {
            keep.append(false)
        }
    }
    return _renormalize_mask(ps, keep)
}

# Step 7 — the draw: u in [0,1) from the explicit Seed state (advanced),
# then the cumulative walk: the first index with cum >= u (the fallback for
# the f32 rounding edge where cum never reaches u is the last index).
@ private { }
fn _distribution(list<f32> probs, train.Seed seed) → Sampler {
    const train.DrawF32 u_f ← train.next_f32(seed)
    const f32 u ← u_f.payload()
    var f32 cum ← 0.0
    for range 0‥probs.length() const i {
        cum ← cum + probs.get(i) coalesce 0.0 ∷ f32
        if u ≺ cum then return Sampler {token_id = i, seed = u_f.seed()}
    }
    return Sampler {token_id = probs.length() - 1, seed = u_f.seed()}
}
