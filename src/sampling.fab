+++ toml
locale = "en"

+++ faber
# Sampling — deterministic token sampling (PML5-U3, production inference
# computation layer).
#
# Public import: import from "gradus:sampling" sampling
# Depends on: gradus:dtype (finite — the logits/config finite gate),
# gradus:random (Seed — the explicit RNG state seam).
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own those). This module holds no device handle, no hidden state, and
# makes no performance claims.
#
# =========================================================================
# The sampling contract (pml5-delivery.md PML5-U3)
# =========================================================================
#
# --- Pure function --------------------------------------------------------
# Sampling is a PURE function of logits + config + RNG state:
#
#   max(logits) -> token id                       (greedy, exact)
#   sample(logits, Config, history, Seed) -> Sampler
#
# No hidden state: the RNG state (Seed) is an explicit argument and is
# returned advanced in the outcome; equal inputs produce equal outcomes.
# The seed enters through random.construct_seed (the xorshift64 seam); the
# same seed reproduces the same token choices.
#
# --- The pinned pipeline order (deterministic, oracle-pinned) -------------
# sample applies, in this exact order:
#   1. repetition penalty (repetition_penalty) over the history tokens:
#        logits[t] > 0  -> logits[t] / penalty
#        logits[t] <= 0 -> logits[t] * penalty        (the llama.cpp rule)
#   2. temperature scaling: logits[i] / temperature
#   3. top-k: keep the k largest logits (first-index ties; k <= 0 = off)
#   4. stabilized softmax (max-subtracted exp, base-e)
#   5. top-p (nucleus): the smallest descending-probability set whose
#        cumulative mass reaches top_p; renormalized (<=0 or >=1 = off)
#   6. min-p: keep probs >= min_p * max_prob; renormalized (<=0 = off)
#   7. draw u in [0,1) from Seed (random.next_f32) and walk the
#        cumulative distribution: first index with cum >= u.
# temperature <= 0 is the GREEDY path: sample returns the argmax token and
# the UNCHANGED Seed (no draw). The order and tie-breaks are part of the
# oracle contract (first-index ties throughout).
#
# --- Fail-closed gates ------------------------------------------------------
# Logits must be non-empty and finite (GI2 finite-gate discipline); the
# history tokens must lie in [0, logits.length()); Config knobs are
# validated by construct_config. Invalid input throws (typed error), never
# silently truncates.
#
# --- Evidence honesty (CTO Q2, hard) --------------------------------------
# This surface is the STRUCTURAL proof: the pure-function shape, the greedy
# exactness, the deterministic pipeline, and the f64 oracle pins (the
# sampling.proba pins evaluate the documented arithmetic). Executed token
# value-identity is not claimed here. Library-to-library calls execute on
# the FMIR stepper (radix 43c0102ba; regression-locked by 2e8042ae7).
# PML5-U3 is PARTIAL and token value-identity is deferred to
# the auditor-owned runtime-evidence gate.
import from "gradus:dtype"

import from "gradus:random"

# -------------------------------------------------------------------------
# SamplingError — typed error vocabulary of the sampling surface.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------


@ public
union SamplingError {
    @ shared
    string message

    InvalidLogits,
    InvalidConfig,
    InvalidHistory
}

# -------------------------------------------------------------------------
# Config — the sampling knobs. The validated constructor is
# construct_config; the class itself is the plain carrier.
# -------------------------------------------------------------------------


@ public
class Config {
    # Temperature scaling; <= 0 selects the greedy path.
    mut f32 temperature
    # Top-k filter width; 0 disables the filter.
    mut int top_k
    # Top-p (nucleus) threshold; <= 0 or >= 1 disables the filter.
    mut f32 top_p
    # Min-p threshold; <= 0 disables the filter.
    mut f32 min_p
    # Repetition penalty; 1.0 = no penalty.
    mut f32 repetition_penalty
}

# The validated Config constructor. Temperature may be 0 (the greedy
# flag) and must be finite; top_k non-negative; top_p / min_p finite
# within [0, 1]; the repetition penalty finite and at least 1.0.
@ public
fn construct_config(f32 τ, int top_k, f32 top_p, f32 min_p, f32 repetition_penalty) → Config ⇥ SamplingError {
    require dtype.finite(τ) throw variant InvalidConfig { message = "temperature must be non-negative" }

    require τ ≥ 0.0 throw variant InvalidConfig { message = "temperature must be non-negative" }

    require top_k ≥ 0 throw variant InvalidConfig { message = "top-k must be non-negative" }

    require dtype.finite(top_p) throw variant InvalidConfig { message = "top-p must be within [0, 1]" }

    require top_p ≥ 0.0 throw variant InvalidConfig { message = "top-p must be within [0, 1]" }

    require top_p ≤ 1.0 throw variant InvalidConfig { message = "top-p must be within [0, 1]" }

    require dtype.finite(min_p) throw variant InvalidConfig { message = "min-p must be within [0, 1]" }

    require min_p ≥ 0.0 throw variant InvalidConfig { message = "min-p must be within [0, 1]" }

    require min_p ≤ 1.0 throw variant InvalidConfig { message = "min-p must be within [0, 1]" }

    require dtype.finite(repetition_penalty) throw variant InvalidConfig { message = "repetition penalty must be at least 1" }

    require repetition_penalty ≥ 1.0 throw variant InvalidConfig { message = "repetition penalty must be at least 1" }

    return Config { temperature = τ, top_k = top_k, top_p = top_p, min_p = min_p, repetition_penalty = repetition_penalty }
}

# Placeholder Default for `var Config` bindings (var on structs).
# Zero knobs (not a valid config). Only a placeholder the caller
# overwrites, or returns from an unreachable cape arm.
@ public
fn default_config() → Config {
    return Config { temperature = 0.0, top_k = 0, top_p = 0.0, min_p = 0.0, repetition_penalty = 0.0 }
}

# -------------------------------------------------------------------------
# Sampler — a sample outcome: the chosen token id + the advanced RNG state.
# -------------------------------------------------------------------------


@ public
class Sampler {
    mut int token_id
    # Advanced generator state after the draw (explicit RNG continuation).
    mut random.Seed seed
}

# Placeholder Default for `var Sampler` bindings (var on structs).
# Token 0 and an empty seed (not a valid draw). Only a placeholder the
# caller overwrites, or returns from an unreachable cape arm.
@ public
fn default() → Sampler {
    return Sampler { token_id = 0, seed = random.default() }
}

# -------------------------------------------------------------------------
# max — the GREEDY path: the index of the largest logit (first-index
# tie-break). Exact, pure, no RNG. Rejects empty or non-finite logits.
# -------------------------------------------------------------------------

@ public
fn max(list<f32> logits) → int ⇥ SamplingError {
    require_logits(logits)
    return logits.argmax() coalesce 0
}

# -------------------------------------------------------------------------
# distribution — the PURE post-filter distribution: logits + config +
# history in, the filtered probability vector out (steps 1–6 of the pinned
# pipeline; no RNG). Exposed so the oracle pins can compare the per-knob
# distributions.
# -------------------------------------------------------------------------

@ public
fn distribution(list<f32> logits, Config c, list<int> history) → list<f32> ⇥ SamplingError {
    require_logits(logits)
    require_history(logits, history)
    return filtered(logits, c, history)
}

# -------------------------------------------------------------------------
# sample — the STOCHASTIC path: pure function of logits + config + history +
# RNG state. temperature <= 0 selects the greedy path (argmax, seed
# unchanged). Otherwise the filtered distribution is drawn and the outcome
# carries the advanced Seed.
# -------------------------------------------------------------------------

@ public
fn sample(list<f32> logits, Config c, list<int> history, random.Seed seed) → Sampler ⇥ SamplingError {
    require_logits(logits)
    require_history(logits, history)

    if c.temperature ≤ 0.0 then return Sampler { token_id = logits.argmax() coalesce 0, seed = seed }

    let list<f32> penalized ← repetition_penalty(logits, history, c.repetition_penalty)
    let list<f32> scaled ← temperature_scale(penalized, c.temperature)

    if c.top_k ≻ 0 and c.top_k ≺ scaled.length() {
        let CompactTopK k_limited ← top_k_compact(scaled, c.top_k)
        let list<f32> probs ← softmax_dense(k_limited.values)
        let list<f32> p_limited ← top_p(probs, c.top_p)
        let Sampler drawn ← draw(min_p(p_limited, c.min_p), seed)
        return Sampler { token_id = k_limited.ids.get(drawn.token_id) coalesce 0, seed = drawn.seed }
    }

    let list<f32> probs ← softmax_dense(scaled)
    let list<f32> p_limited ← top_p(probs, c.top_p)
    return draw(min_p(p_limited, c.min_p), seed)
}

# -------------------------------------------------------------------------
# sample_candidates — the sparse STOCHASTIC path: the same Sampler (token id
# and advanced Seed) that sample returns for a full logits list in which every
# non-candidate position is dropped (exact 0.0 probability). values holds the
# candidate logits and ids their vocabulary ids, strictly ascending by id.
# The pipeline and its float summation order are the full-list pipeline's:
# dropped positions add exact 0.0, so walking only the candidates in id order
# adds the same terms in the same order. history holds vocabulary ids; a
# history id that is not a candidate is dropped from the penalty scatter.
# Callers that already applied the penalty before narrowing pass an empty
# history. Exact only when the candidate set contains every position the
# filters would keep. temperature <= 0 is greedy: the argmax candidate's id,
# Seed unchanged.
# -------------------------------------------------------------------------

@ public
fn sample_candidates(list<f32> values, list<int> ids, Config c, list<int> history, random.Seed seed) → Sampler ⇥ SamplingError {
    require_logits(values)
    require_candidate_ids(values, ids)

    for from history let t {
        require t ≥ 0 throw variant InvalidHistory { message = "history token out of vocabulary range" }
    }

    if c.temperature ≤ 0.0 then return Sampler { token_id = ids.get(values.argmax() coalesce 0) coalesce 0, seed = seed }

    mut list<int> positions ← empty

    if c.repetition_penalty ≇ (1.0 ∷ f32) and history.length() ≻ 0 {
        for from history let t {
            let int at ← candidate_position(ids, t)

            if at ≥ 0 {
                positions.append(at)
            }
        }
    }

    let list<f32> penalized ← repetition_penalty(values, positions, c.repetition_penalty)
    let list<f32> scaled ← temperature_scale(penalized, c.temperature)

    if c.top_k ≻ 0 and c.top_k ≺ scaled.length() {
        let CompactTopK k_limited ← top_k_compact(scaled, c.top_k)
        let list<f32> probs ← softmax_dense(k_limited.values)
        let list<f32> p_limited ← top_p(probs, c.top_p)
        let Sampler drawn ← draw(min_p(p_limited, c.min_p), seed)
        let int picked ← k_limited.ids.get(drawn.token_id) coalesce 0
        return Sampler { token_id = ids.get(picked) coalesce 0, seed = drawn.seed }
    }

    let list<f32> probs ← softmax_dense(scaled)
    let list<f32> p_limited ← top_p(probs, c.top_p)
    let Sampler drawn ← draw(min_p(p_limited, c.min_p), seed)
    return Sampler { token_id = ids.get(drawn.token_id) coalesce 0, seed = drawn.seed }
}

# -------------------------------------------------------------------------
# Private helpers (the deterministic pipeline).
# -------------------------------------------------------------------------

fn require_logits(list<f32> logits) → void ⇥ SamplingError {
    require logits.length() ≢ 0 throw variant InvalidLogits { message = "logits must be non-empty" }

    require finite(logits) throw variant InvalidLogits { message = "logits must be finite" }
}

fn require_history(list<f32> logits, list<int> history) → void ⇥ SamplingError {
    for from history let t {
        require t ≥ 0 throw variant InvalidHistory { message = "history token out of vocabulary range" }

        require t ≺ logits.length() throw variant InvalidHistory { message = "history token out of vocabulary range" }
    }
}

# One id per value, non-negative and strictly ascending.
fn require_candidate_ids(list<f32> values, list<int> ids) → void ⇥ SamplingError {
    require ids.length() ≡ values.length() throw variant InvalidLogits { message = "candidate ids must match candidate values" }

    mut int prev ← 0 - 1

    for from ids let t {
        require t ≻ prev throw variant InvalidLogits { message = "candidate ids must be strictly ascending" }

        prev ← t
    }
}

# Position of id t in the ascending ids (binary search), or -1 when absent.
fn candidate_position(list<int> ids, int t) → int {
    mut int lo ← 0
    mut int hi ← ids.length() - 1

    while lo ≤ hi {
        let int mid ← lo + (hi - lo) / 2
        let int v ← ids.get(mid) coalesce 0

        if v ≡ t then return mid

        if v ≺ t {
            lo ← mid + 1
        }
        else {
            hi ← mid - 1
        }
    }

    return 0 - 1
}

# Steps 1–6 of the pinned pipeline (caller has already gated logits/history).
fn filtered(list<f32> logits, Config c, list<int> history) → list<f32> {
    if c.temperature ≤ 0.0 {
        # Keep: constant fill of a fresh list; no covering fill construct.
        mut list<f32> degenerate ← empty

        for range 0 ‥ logits.length() {
            degenerate.append(0.0)
        }

        degenerate[logits.argmax() coalesce 0] ← 1.0
        return degenerate
    }

    let list<f32> penalized ← repetition_penalty(logits, history, c.repetition_penalty)
    let list<f32> scaled ← temperature_scale(penalized, c.temperature)

    if c.top_k ≻ 0 and c.top_k ≺ scaled.length() {
        let CompactTopK k_limited ← top_k_compact(scaled, c.top_k)
        let list<f32> probs ← softmax_dense(k_limited.values)
        let list<f32> p_limited ← top_p(probs, c.top_p)
        let list<f32> kept ← min_p(p_limited, c.min_p)
        mut list<f32> out ← empty

        for range 0 ‥ scaled.length() {
            out.append(0.0)
        }

        for range 0 ‥ k_limited.ids.length() let j {
            out[k_limited.ids.get(j) coalesce 0] ← kept.get(j) coalesce 0.0 ∷ f32
        }

        return out
    }

    let list<f32> probs ← softmax_dense(scaled)
    let list<f32> p_limited ← top_p(probs, c.top_p)
    return min_p(p_limited, c.min_p)
}

# Index a outranks b: strictly larger value, else smaller index. The
# first-index tie follows the stated-once argmax/argmin contract in the
# Wave-0 delivery §3; this pairwise comparison stays because it compares
# two heap indices, not a full-collection reduction.
fn prefers(list<f32> xs, int a, int b) → bool {
    let f32 va ← xs.get(a) coalesce 0.0 ∷ f32
    let f32 vb ← xs.get(b) coalesce 0.0 ∷ f32

    if va ≻ vb then return true

    if vb ≻ va then return false

    return a ≺ b
}

# Sift heap[i] down inside heap[0, size). The heap stores indices into xs.
fn sift_down(mut list<int> heap, list<f32> xs, int i, int size) → void {
    mut int cur ← i

    while true {
        let int child ← 2 * cur + 1

        if child ≥ size {
            return
        }

        mut int pick ← child
        let int other ← child + 1

        if other ≺ size {
            if prefers(xs, heap.get(other) coalesce 0, heap.get(pick) coalesce 0) {
                pick ← other
            }
        }

        if prefers(xs, heap.get(pick) coalesce 0, heap.get(cur) coalesce 0) {
            let int tmp ← heap.get(cur) coalesce 0
            heap[cur] ← heap.get(pick) coalesce 0
            heap[pick] ← tmp
            cur ← pick
        }
        else {
            return
        }
    }
}

# Max-heap of 0..n-1 over xs (first-index ties). Heapify is O(n).
fn index_heap(list<f32> xs) → list<int> {
    let int n ← xs.length()
    # Keep: index fill (the element IS its position); no covering construct.
    mut list<int> heap ← empty

    for range 0 ‥ n let j {
        heap.append(j)
    }

    mut int start ← n / 2

    while start ≻ 0 {
        start ← start - 1
        sift_down(mut heap, xs, start, n)
    }

    return heap
}

# Pop the current max index; restore a heap of the remaining size-1.
# Caller must pass size > 0 and then decrement its own size.
fn heap_pop(mut list<int> heap, list<f32> xs, int size) → int {
    let int best ← heap.get(0) coalesce 0
    let int last ← size - 1

    if last ≻ 0 {
        heap[0] ← heap.get(last) coalesce 0
        sift_down(mut heap, xs, 0, last)
    }

    return best
}

# Every element is finite (the GI2 finite gate).
fn finite(list<f32> xs) → bool {
    # Keep: early-exit predicate; a filter twin would scan the whole list.
    for from xs let v {
        if not dtype.finite(v) then return false
    }

    return true
}

# A false mask of length n.
fn mask_false(int n) → list<bool> {
    # Keep: constant fill; no covering fill construct.
    mut list<bool> m ← empty

    for range 0 ‥ n {
        m.append(false)
    }

    return m
}

# Step 1 — repetition penalty over the history tokens (llama.cpp rule:
# positive logits divide by penalty, non-positive multiply by penalty).
# One vocab copy, then one in-place apply per history token (O(V + history);
# a token listed twice is penalized twice, matching the nested-scan rule).
fn repetition_penalty(list<f32> logits, list<int> history, f32 penalty) → list<f32> {
    if penalty ≡ (1.0 ∷ f32) or history.length() ≡ 0 then return logits

    # Keep: identity carrier copy (no clone intrinsic) feeding an in-place
    # scatter over history indices; no covering copy/scatter construct.
    mut list<f32> out ← empty

    for from logits let v {
        out.append(v)
    }

    for from history let t {
        let f32 w ← out.get(t) coalesce 0.0 ∷ f32

        if w ≻ 0.0 {
            out[t] ← w / penalty
        }
        else {
            out[t] ← w * penalty
        }
    }

    return out
}

# Step 2 — temperature scaling (pure per-element division).
fn temperature_scale(list<f32> logits, f32 τ) → list<f32> {
    if τ ≡ (1.0 ∷ f32) then return logits

    return logits.map(f32 v ∴ v / τ)
}

# Compact top-k selection: keeps only the k selected entries sorted in
# ascending vocabulary-id order so downstream softmax, top-p, min-p, and draw
# run in O(k) while preserving exact full-list summation and tie-break order.
class CompactTopK {
    mut list<int> ids
    mut list<f32> values
}

fn sort_ids_ascending(list<int> xs) → list<int> {
    return sort via asc from xs
}

# Step 3 — top-k: keep the k largest logits (first-index ties, k <= 0 off).
# Partial selection: heapify once, extract k, sort selected ids ascending
# (O(V + k log V + k log k)); no full sort.
fn top_k_compact(list<f32> xs, int k) → CompactTopK {
    let int n ← xs.length()
    mut list<int> heap ← index_heap(xs)
    mut list<int> chosen ← empty
    mut int extent ← n
    mut int count ← 0

    while count ≺ k and extent ≻ 0 {
        let int best ← heap_pop(mut heap, xs, extent)
        extent ← extent - 1
        chosen.append(best)
        count ← count + 1
    }

    chosen ← sort_ids_ascending(chosen)
    mut list<f32> vals ← empty

    for from chosen let idx {
        vals.append(xs.get(idx) coalesce 0.0 ∷ f32)
    }

    return CompactTopK { ids = chosen, values = vals }
}

# Step 4 — stabilized softmax (max-subtracted, base-e) over compact candidates.
fn softmax_dense(list<f32> xs) → list<f32> {
    let int best ← xs.argmax() coalesce 0
    let f32 m ← xs.get(best) coalesce 0.0 ∷ f32
    let list<f32> es ← xs.map(f32 v ∴ (v - m).exp())
    let f32 sum ← es.reduce((f32 acc, f32 e) ∴ acc + e, 0.0)
    return es.map(f32 e ∴ e / sum)
}

# Renormalize the kept probabilities (kept positions keep prob/sum, others 0).
fn renormalize_mask(list<f32> ps, list<bool> keep) → list<f32> {
    # Keep: both passes are participation-masked by index; no masked-reduce
    # or index-carrying map form exists.
    let int n ← ps.length()
    mut f32 sum ← 0.0

    for range 0 ‥ n let i {
        if keep.get(i) coalesce false {
            sum ← sum + ps.get(i) coalesce 0.0 ∷ f32
        }
    }

    mut list<f32> out ← empty

    for range 0 ‥ n let i {
        if keep.get(i) coalesce false {
            out.append(ps.get(i) coalesce 0.0 ∷ f32 / sum)
        }
        else {
            out.append(0.0)
        }
    }

    return out
}

# Step 5 — top-p (nucleus): heap-extract in descending-probability
# first-index order until cumulative mass reaches p, then one renormalize
# pass (p <= 0 or p >= 1 off). Stops on a non-positive remainder (keeps
# every nonzero when the cumulative still sits below p). Avoids a full
# sort: heapify once, extract only the nucleus (O(V + k log V)).
fn top_p(list<f32> ps, f32 p) → list<f32> {
    if p ≤ 0.0 or p ≥ 1.0 then return ps

    let int n ← ps.length()
    mut list<bool> keep ← mask_false(n)
    mut list<int> heap ← index_heap(ps)
    mut int extent ← n
    mut f32 cum ← 0.0
    mut bool progress ← true

    while cum ≺ p and progress {
        if extent ≤ 0 {
            progress ← false
        }
        else {
            let int best ← heap_pop(mut heap, ps, extent)
            extent ← extent - 1
            let f32 v ← ps.get(best) coalesce 0.0 ∷ f32

            if v ≻ 0.0 {
                keep[best] ← true
                cum ← cum + v
            }
            else {
                progress ← false
            }
        }
    }

    return renormalize_mask(ps, keep)
}

# Step 6 — min-p: keep probs >= min_p * max_prob, renormalized (p <= 0 off).
fn min_p(list<f32> ps, f32 p) → list<f32> {
    if p ≤ 0.0 then return ps

    let int max_index ← ps.argmax() coalesce 0
    let f32 mx ← ps.get(max_index) coalesce 0.0 ∷ f32
    let f32 threshold ← mx * p
    let list<bool> keep ← ps.map(f32 v ∴ v ≥ threshold)
    return renormalize_mask(ps, keep)
}

# Step 7 — the draw: u in [0,1) from the explicit Seed state (advanced),
# then the cumulative walk: the first index with cum >= u (the fallback for
# the f32 rounding edge where cum never reaches u is the last index).
fn draw(list<f32> probs, random.Seed seed) → Sampler {
    let random.DrawF32 u_f ← random.next_f32(seed)
    let f32 u ← u_f.payload
    # Keep: early-exit cumulative walk (first index with cum >= u); a
    # reduction twin cannot return mid-scan.
    mut f32 cum ← 0.0

    for range 0 ‥ probs.length() let i {
        cum ← cum + probs.get(i) coalesce 0.0 ∷ f32

        if u ≺ cum then return Sampler { token_id = i, seed = u_f.seed }
    }

    return Sampler { token_id = probs.length() - 1, seed = u_f.seed }
}

+++ faber test
# Co-located package test for sampling.fab (PML5-U3 — deterministic token
# sampling). Not importable; discovered only by the faber test path.
#
# Proves, at compile level:
#   * greedy exactness — max returns the argmax (first-index ties),
#     and temperature <= 0 routes sample to the greedy path with the Seed
#     unchanged.
#   * the pinned pipeline — distribution (logits + config + history →
#     filtered probabilities) matches the f64 oracle pins per knob:
#     temperature, top-k, top-p, min-p, repetition penalty, and their
#     combination (approximate within the documented 5e-4 tolerance).
#   * deterministic draws — sample (logits + config + history + Seed)
#     returns the oracle-pinned token for each pinned seed; the outcome
#     carries the ADVANCED Seed (the RNG continuation is explicit).
#   * purity — equal inputs produce equal distributions and equal tokens
#     (no hidden state); the draw consumes the RNG state (the advanced
#     status differs from the seed).
#   * fail-closed rows — empty logits, invalid config knobs, and history
#     tokens outside the vocabulary reject with the typed message.
#
# Oracle pins: f64 evaluations of the documented pipeline (the same
# arithmetic the random.proba xorshift pins and the loss.proba exp pins
# use) for the pinned logits V=5 [2.0, 1.5, 0.0, -1.0, 3.0]:
#   temp 1.0 plain    dist [0.2217326936, 0.1344876769, 0.0300082569,
#                           0.0110394208, 0.6027319518]
#   temp 2.0 plain    dist [0.2488471128, 0.1938023263, 0.0915457368,
#                           0.0555252961, 0.410279528]
#   top-k 2           dist [0.2689414214, 0, 0, 0, 0.7310585786]
#   top-p 0.7         dist [0.2689414214, 0, 0, 0, 0.7310585786]
#   min-p 0.3         dist [0.2689414214, 0, 0, 0, 0.7310585786]
#   rep 2.0, hist [0,4] penalized [1.0, 1.5, 0.0, -1.0, 1.5];
#                     dist [0.2083048101, 0.3434365712, 0.0766310571,
#                           0.0281909905, 0.3434365712]
#   rep 2.0, hist [2,3] penalized [2.0, 1.5, 0.0, -2.0, 3.0];
#                     dist [0.2232908720, 0.1354327599, 0.0302191334,
#                           0.0040897150, 0.6069675198]
#   full (t1.5 k3 p0.8 m0.25 rep1.5 hist[2]) dist [0.3392436312,
#                   0, 0, 0, 0.6607563688] (top-k keeps {0,1,4}; softmax
#                   [0.2729060, 0.1955457, 0.5315483]; top-p 0.8 keeps
#                   {4,0} and renormalizes; min-p 0.25 keeps both)
#   greedy (temp 0)   degenerate one-hot at the argmax (index 4).
# Seed pins (first draw of the xorshift64 seam, model-independent):
#   seed 1234567890123456789  u ≈ 0.245768647  (s_a)
#   seed 5428186273191027194  u ≈ 0.618285162  (s_b)
#   seed 730019052841267308   u ≈ 0.773805557  (s_c)
# The pinned draws sit > 2e-3 from every cumulative boundary (f32/f64
# drift is ~1e-6), so the token pins are boundary-safe.
#
# EVIDENCE HONESTY (CTO Q2, hard): this suite is STRUCTURAL proof. No
# executed token value is claimed; the pins are f64 evaluations of the
# documented formulas and the documented xorshift draws. Executed
# value-identity is not claimed here. Library-to-library calls execute on
# the FMIR stepper (radix 43c0102ba; regression-locked by 2e8042ae7).
# PML5-U3 is PARTIAL and token value-identity is deferred to the
# auditor-owned runtime-evidence gate.
#
# assert assertions run under the cargo-backed `faber test` harness
# (auditor-owned); `faber check src/sampling.proba` proves the suite
# type-checks. This suite remains compile-level proof; no runtime token
# value identity is claimed here.

import from "gradus:sampling" sampling
import from "gradus:random" random
import from "gradus:generation/config" config

# ---- helpers

# The pinned logits vector (V=5).
fn logits_p() → list<f32> {
    return [2.0, 1.5, 0.0, (0.0 - 1.0) ↦ f32, 3.0]
}

# A config built through the validated constructor (swallow never-firing
# errors).
fn config_p(f32 temperature, int top_k, f32 top_p, f32 min_p, f32 penalty) → sampling.Config {
    return sampling.construct_config(temperature, top_k, top_p, min_p, penalty) ⊥ sampling.default_config()
}

# The plain temperature-1 config (no filters, no penalty).
fn config_simplex() → sampling.Config {
    return config_p(1.0, 0, 0.0, 0.0, 1.0)
}

# Element read with a default.
fn p(list<f32> xs, int i) → f32 {
    return xs.get(i) coalesce ((0.0 - 999.0) ↦ f32)
}

# A seeded Seed built through the validated constructor (swallow
# never-firing errors; the pinned seeds are non-zero).
fn seed_p(int seed) → random.Seed {
    return random.construct_seed(seed) ⊥ random.default()
}

# The greedy argmax (swallow errors -> -1).
# BLOCKER (class 3, scalar narrowing): int result narrowing is blocked
# (routed N2/N4a). Kept on do/catch. Do not convert.
fn max_value(list<f32> logits) → int {
    do {
        let int t ← sampling.max(logits)
        return t
    }
    catch err {
        return (0 - 1)
    }
}

# The filtered distribution as a list (swallow errors -> empty list).
fn distribution_p(list<f32> logits, sampling.Config c, list<int> hist) → list<f32> {
    return sampling.distribution(logits, c, hist) ⊥ empty
}

# The drawn token id (swallow errors -> -1).
# BLOCKER (class 3, scalar narrowing): int result narrowing is blocked
# (routed N2/N4a). Kept on do/catch. Do not convert.
fn sample_token(list<f32> logits, sampling.Config c, list<int> hist, random.Seed s) → int {
    do {
        let sampling.Sampler r ← sampling.sample(logits, c, hist, s)
        return r.token_id
    }
    catch err {
        return (0 - 1)
    }
}

# The advanced RNG status after a draw (swallow errors -> 0).
# BLOCKER (class 3, scalar narrowing): int result narrowing is blocked
# (routed N2/N4a). Kept on do/catch. Do not convert.
fn sample_status(list<f32> logits, sampling.Config c, list<int> hist, random.Seed s) → int {
    do {
        let sampling.Sampler r ← sampling.sample(logits, c, hist, s)
        return r.seed.status
    }
    catch err {
        return 0
    }
}

# Renders a sample outcome as text (the token or the typed message).
fn sample_detail(list<f32> logits, sampling.Config c, list<int> hist, random.Seed s) → string {
    let _ outcome ← trap {
        sampling.sample(logits, c, hist, s)
    }
    match outcome {
        case returned let value {
            return "ok"
        }
        case thrown let err {
            return err.message
        }
    }
}

# Renders a max outcome as text.
# BLOCKER (class 3, scalar narrowing): the success-arm type check is
# `outcome is int` — scalar narrowing is blocked (routed N2/N4a), so the
# trap shape cannot reach the error arm. Kept on do/catch. Do not convert.
fn max_detail(list<f32> logits) → string {
    do {
        let int ? ← sampling.max(logits)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# Renders a config-construction outcome as text.
fn config_detail(f32 temperature, int top_k, f32 top_p, f32 min_p, f32 penalty) → string {
    let _ outcome ← trap {
        sampling.construct_config(temperature, top_k, top_p, min_p, penalty)
    }
    match outcome {
        case returned let value {
            return "ok"
        }
        case thrown let err {
            return err.message
        }
    }
}

# The candidate ids covering the whole V=5 vocabulary, ascending.
fn ids_p() → list<int> {
    return [0, 1, 2, 3, 4]
}

# The drawn token id of the sparse candidate path (swallow errors -> -1).
fn cand_token(list<f32> values, list<int> ids, sampling.Config c, list<int> hist, random.Seed s) → int {
    do {
        let sampling.Sampler r ← sampling.sample_candidates(values, ids, c, hist, s)
        return r.token_id
    }
    catch err {
        return (0 - 1)
    }
}

# The advanced RNG status after a sparse candidate draw (swallow errors -> 0).
fn cand_status(list<f32> values, list<int> ids, sampling.Config c, list<int> hist, random.Seed s) → int {
    do {
        let sampling.Sampler r ← sampling.sample_candidates(values, ids, c, hist, s)
        return r.seed.status
    }
    catch err {
        return 0
    }
}

# Renders a sample_candidates outcome as text.
fn cand_detail(list<f32> values, list<int> ids, sampling.Config c, list<int> hist, random.Seed s) → string {
    let _ outcome ← trap {
        sampling.sample_candidates(values, ids, c, hist, s)
    }
    match outcome {
        case returned let value {
            return "ok"
        }
        case thrown let err {
            return err.message
        }
    }
}

# True when the full-vocabulary candidate path and sample agree on the token
# id and the advanced seed for this config, history, and seed.
fn agrees(sampling.Config c, list<int> hist, int seed) → bool {
    let random.Seed s ← seed_p(seed)
    let bool same_token ← cand_token(logits_p(), ids_p(), c, hist, s) ≡ sample_token(logits_p(), c, hist, s)
    let bool same_seed ← cand_status(logits_p(), ids_p(), c, hist, s) ≡ sample_status(logits_p(), c, hist, s)
    return same_token and same_seed
}

# ---- oracle tolerance (the decode.proba 5e-4 convention)

const f32 SAMPLING_TOLERATIO = (0.0005 ∷ f32)

# The pinned seeds (i64-safe; the first draws are model-independent).
const int SEED_A = 1234567890123456789
const int SEED_B = 5428186273191027194
const int SEED_C = 730019052841267308

# ---- greedy exactness

describe "sampling — greedy path exact" {
    test "max returns the argmax of the pinned logits" {
        assert max_value(logits_p()) ≡ 4
    }
    test "max breaks ties to the first index" {
        assert max_value([1.0, 2.0, 2.0]) ≡ 1
    }
    test "max returns index 0 when the first element is the max" {
        assert max_value([5.0, 1.0, 0.0]) ≡ 0
    }
    test "temperature 0 routes sample to the greedy path with the seed unchanged" {
        let _ trap_result_1 ← trap {
            let random.Seed s ← seed_p(SEED_A)
            let sampling.Sampler r ← sampling.sample(logits_p(), config_p(0.0, 0, 0.0, 0.0, 1.0), [], s)
            assert r.token_id ≡ 4
            assert r.seed.status ≡ SEED_A
        }
        match trap_result_1 {
            case returned let ? { }
            case thrown let ? { assert false }
        }
    }
    test "the greedy distribution is degenerate one-hot at the argmax" {
        let list<f32> d ← distribution_p(logits_p(), config_p(0.0, 0, 0.0, 0.0, 1.0), [])
        assert p(d, 0).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 1).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 2).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 3).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 4).approx(1.0, SAMPLING_TOLERATIO)
    }
}

# ---- temperature

describe "sampling — temperature knob" {
    test "temperature 1 distribution matches the f64 oracle" {
        let list<f32> d ← distribution_p(logits_p(), config_simplex(), [])
        assert p(d, 0).approx((0.2217326936 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approx((0.1344876769 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 2).approx((0.0300082569 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 3).approx((0.0110394208 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 4).approx((0.6027319518 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "temperature 2 distribution matches the f64 oracle" {
        let list<f32> d ← distribution_p(logits_p(), config_p(2.0, 0, 0.0, 0.0, 1.0), [])
        assert p(d, 0).approx((0.2488471128 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approx((0.1938023263 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 2).approx((0.0915457368 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 3).approx((0.0555252961 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 4).approx((0.410279528 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "temperature 1 draws the pinned tokens" {
        let random.Seed sa ← seed_p(SEED_A)
        let random.Seed sb ← seed_p(SEED_B)
        let random.Seed sc ← seed_p(SEED_C)
        assert sample_token(logits_p(), config_simplex(), [], sa) ≡ 1
        assert sample_token(logits_p(), config_simplex(), [], sb) ≡ 4
        assert sample_token(logits_p(), config_simplex(), [], sc) ≡ 4

    }
    test "temperature 2 draws the pinned tokens" {
        let random.Seed sa ← seed_p(SEED_A)
        let random.Seed sb ← seed_p(SEED_B)
        let random.Seed sc ← seed_p(SEED_C)
        assert sample_token(logits_p(), config_p(2.0, 0, 0.0, 0.0, 1.0), [], sa) ≡ 0
        assert sample_token(logits_p(), config_p(2.0, 0, 0.0, 0.0, 1.0), [], sb) ≡ 4
        assert sample_token(logits_p(), config_p(2.0, 0, 0.0, 0.0, 1.0), [], sc) ≡ 4

    }
}

# ---- top-k

describe "sampling — top-k knob" {
    test "top-k 2 distribution keeps only the two largest logits" {
        let list<f32> d ← distribution_p(logits_p(), config_p(1.0, 2, 0.0, 0.0, 1.0), [])
        assert p(d, 0).approx((0.2689414214 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 2).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 3).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 4).approx((0.7310585786 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "top-k keeps negative logits without admitting dropped zeroes" {
        let list<f32> d ← distribution_p([-1.0, -2.0, -3.0, -4.0], config_p(1.0, 2, 0.0, 0.0, 1.0), [])
        assert p(d, 0).approx((0.7310585786 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approx((0.2689414214 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 2).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 3).approx(0.0, SAMPLING_TOLERATIO)
    }
    test "top-k 2 draws the pinned tokens" {
        let random.Seed sa ← seed_p(SEED_A)
        let random.Seed sb ← seed_p(SEED_B)
        assert sample_token(logits_p(), config_p(1.0, 2, 0.0, 0.0, 1.0), [], sa) ≡ 0
        assert sample_token(logits_p(), config_p(1.0, 2, 0.0, 0.0, 1.0), [], sb) ≡ 4

    }
}

# ---- top-p (nucleus)

describe "sampling — top-p knob" {
    test "top-p 0.7 keeps the nucleus {0, 4} and renormalizes" {
        let list<f32> d ← distribution_p(logits_p(), config_p(1.0, 0, 0.7, 0.0, 1.0), [])
        assert p(d, 0).approx((0.2689414214 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 2).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 3).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 4).approx((0.7310585786 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "top-p 0.7 draws the pinned tokens" {
        let random.Seed sa ← seed_p(SEED_A)
        let random.Seed sb ← seed_p(SEED_B)
        assert sample_token(logits_p(), config_p(1.0, 0, 0.7, 0.0, 1.0), [], sa) ≡ 0
        assert sample_token(logits_p(), config_p(1.0, 0, 0.7, 0.0, 1.0), [], sb) ≡ 4

    }
}

# ---- min-p

describe "sampling — min-p knob" {
    test "min-p 0.3 keeps probs at least 0.3 x max and renormalizes" {
        let list<f32> d ← distribution_p(logits_p(), config_p(1.0, 0, 0.0, 0.3, 1.0), [])
        assert p(d, 0).approx((0.2689414214 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 2).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 3).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 4).approx((0.7310585786 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "min-p 0.3 draws the pinned tokens" {
        let random.Seed sa ← seed_p(SEED_A)
        let random.Seed sb ← seed_p(SEED_B)
        assert sample_token(logits_p(), config_p(1.0, 0, 0.0, 0.3, 1.0), [], sa) ≡ 0
        assert sample_token(logits_p(), config_p(1.0, 0, 0.0, 0.3, 1.0), [], sb) ≡ 4

    }
}

# ---- repetition penalty

describe "sampling — repetition penalty knob" {
    test "penalty 2.0 over history [0, 4] divides the positive logits" {
        let list<f32> d ← distribution_p(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [0, 4])
        assert p(d, 0).approx((0.2083048101 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approx((0.3434365712 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 2).approx((0.0766310571 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 3).approx((0.0281909905 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 4).approx((0.3434365712 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "penalty 2.0 over history [2, 3] multiplies the non-positive logits" {
        let list<f32> d ← distribution_p(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [2, 3])
        assert p(d, 0).approx((0.223290872 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approx((0.1354327599 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 2).approx((0.0302191334 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 3).approx((0.004089715 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 4).approx((0.6069675198 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "penalty 2.0 over history [0, 4] draws the pinned tokens" {
        let random.Seed sa ← seed_p(SEED_A)
        let random.Seed sc ← seed_p(SEED_C)
        assert sample_token(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [0, 4], sa) ≡ 1
        assert sample_token(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [0, 4], sc) ≡ 4

    }
    test "penalty 2.0 over history [2, 3] draws the pinned tokens" {
        let random.Seed sa ← seed_p(SEED_A)
        let random.Seed sb ← seed_p(SEED_B)
        assert sample_token(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [2, 3], sa) ≡ 1
        assert sample_token(logits_p(), config_p(1.0, 0, 0.0, 0.0, 2.0), [2, 3], sb) ≡ 4

    }
}

# ---- the full combination

describe "sampling — knob combination" {
    test "the full pipeline (t1.5 k3 p0.8 m0.25 rep1.5 hist[2]) matches the f64 oracle" {
        let list<f32> d ← distribution_p(logits_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2])
        assert p(d, 0).approx((0.3392436312 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 2).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 3).approx(0.0, SAMPLING_TOLERATIO)
        assert p(d, 4).approx((0.6607563688 ∷ f32), SAMPLING_TOLERATIO)
    }
    test "the full pipeline draws the pinned tokens" {
        let random.Seed sa ← seed_p(SEED_A)
        let random.Seed sb ← seed_p(SEED_B)
        let random.Seed sc ← seed_p(SEED_C)
        assert sample_token(logits_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2], sa) ≡ 0
        assert sample_token(logits_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2], sb) ≡ 4
        assert sample_token(logits_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2], sc) ≡ 4

    }
}

# ---- purity / determinism

describe "sampling — purity and determinism" {
    test "equal inputs produce equal distributions (pure — no hidden state)" {
        let list<f32> a ← distribution_p(logits_p(), config_simplex(), [])
        let list<f32> b ← distribution_p(logits_p(), config_simplex(), [])
        assert p(a, 0) ≡ p(b, 0)
        assert p(a, 1) ≡ p(b, 1)
        assert p(a, 4) ≡ p(b, 4)
    }
    test "the same seed reproduces the same token; the draw advances the RNG" {
        let random.Seed s1 ← seed_p(SEED_A)
        let random.Seed s2 ← seed_p(SEED_A)
        assert sample_token(logits_p(), config_simplex(), [], s1) ≡ sample_token(logits_p(), config_simplex(), [], s2)
        assert sample_status(logits_p(), config_simplex(), [], s1) ≢ SEED_A

    }
    test "different seeds draw different pinned tokens (the distribution is the same)" {
        let random.Seed sa ← seed_p(SEED_A)
        let random.Seed sc ← seed_p(SEED_C)
        assert sample_token(logits_p(), config_simplex(), [], sa) ≡ 1
        assert sample_token(logits_p(), config_simplex(), [], sc) ≡ 4

    }
}

# ---- small request seeds (F-1: a no-cut sample must not collapse to token 0)

# The Seed a request carries, taken through the generation config.
fn request_seed(int seed) → random.Seed {
    let config.GenerationConfig g ← config.construct_generation(1024, 1, 128, seed, (0.8 ∷ f32), 0, (1.0 ∷ f32), (0.0 ∷ f32), (1.0 ∷ f32), [0, 2]) ⊥ config.default()
    return config.seed(g) ⊥ random.default()
}

describe "sampling — small request seeds" {
    test "a no-cut sample with request seeds 7 and 8 does not return the lowest id of a tiny-probability head" {
        let list<f32> head ← [0.0, 12.0, 11.0, 10.0, 9.0]
        let sampling.Config nocut ← config_p(0.8, 0, 1.0, 0.0, 1.0)
        assert sample_token(head, nocut, [], request_seed(7)) ≢ 0
        assert sample_token(head, nocut, [], request_seed(8)) ≢ 0
    }
}

# ---- softmax range (direct exp(x−m); the reciprocal 1/e^{m−x} form
# overflows when the kept/suppressed gap is large — IgnoreEos uses −1e9)

describe "sampling — softmax numerical range" {
    test "a 100+ logit spread softmaxes without overflow" {
        let list<f32> d ← distribution_p([1.0, 0.0, (0.0 - 1000000000.0) ↦ f32], config_simplex(), [])
        assert p(d, 0).approx((0.7310585786 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 1).approx((0.2689414214 ∷ f32), SAMPLING_TOLERATIO)
        assert p(d, 2).approx(0.0, SAMPLING_TOLERATIO)
    }
}

# ---- fail-closed rows

describe "sampling — fail-closed gates" {
    test "empty logits reject" {
        assert max_detail([]) ≡ "logits must be non-empty"
        assert sample_detail([], config_simplex(), [], seed_p(SEED_A)) ≡ "logits must be non-empty"
    }
    test "a negative temperature rejects" {
        assert config_detail((0.0 - 0.1) ↦ f32, 0, 0.0, 0.0, 1.0) ≡ "temperature must be non-negative"
    }
    test "a non-finite temperature rejects" {
        assert config_detail(1.0 / 0.0 ∷ f32, 0, 0.0, 0.0, 1.0) ≡ "temperature must be non-negative"
    }
    test "a negative top-k rejects" {
        assert config_detail(1.0, 0 - 1, 0.0, 0.0, 1.0) ≡ "top-k must be non-negative"
    }
    test "a top-p above 1 rejects" {
        assert config_detail(1.0, 0, 1.5, 0.0, 1.0) ≡ "top-p must be within [0, 1]"
    }
    test "a negative min-p rejects" {
        assert config_detail(1.0, 0, 0.0, (0.0 - 0.5) ↦ f32, 1.0) ≡ "min-p must be within [0, 1]"
    }
    test "a repetition penalty below 1 rejects" {
        assert config_detail(1.0, 0, 0.0, 0.0, 0.5) ≡ "repetition penalty must be at least 1"
    }
    test "a history token outside the vocabulary rejects" {
        assert sample_detail(logits_p(), config_simplex(), [5], seed_p(SEED_A)) ≡ "history token out of vocabulary range"
        assert sample_detail(logits_p(), config_simplex(), [0 - 1], seed_p(SEED_A)) ≡ "history token out of vocabulary range"
        assert sample_detail(logits_p(), config_p(0.0, 0, 0.0, 0.0, 1.0), [5], seed_p(SEED_A)) ≡ "history token out of vocabulary range"
    }
}

# ---- sparse candidate path (bit-equal to sample)

describe "sampling — sample_candidates over a full-vocabulary candidate list" {
    test "temperature 1 and 2 agree with sample on token and seed" {
        assert agrees(config_simplex(), [], SEED_A)
        assert agrees(config_simplex(), [], SEED_B)
        assert agrees(config_simplex(), [], SEED_C)
        assert agrees(config_p(2.0, 0, 0.0, 0.0, 1.0), [], SEED_A)
        assert agrees(config_p(2.0, 0, 0.0, 0.0, 1.0), [], SEED_B)
        assert agrees(config_p(2.0, 0, 0.0, 0.0, 1.0), [], SEED_C)
    }
    test "top-k 2 agrees with sample on token and seed" {
        assert agrees(config_p(1.0, 2, 0.0, 0.0, 1.0), [], SEED_A)
        assert agrees(config_p(1.0, 2, 0.0, 0.0, 1.0), [], SEED_B)
    }
    test "top-p 0.7 agrees with sample on token and seed" {
        assert agrees(config_p(1.0, 0, 0.7, 0.0, 1.0), [], SEED_A)
        assert agrees(config_p(1.0, 0, 0.7, 0.0, 1.0), [], SEED_B)
    }
    test "min-p 0.3 agrees with sample on token and seed" {
        assert agrees(config_p(1.0, 0, 0.0, 0.3, 1.0), [], SEED_A)
        assert agrees(config_p(1.0, 0, 0.0, 0.3, 1.0), [], SEED_B)
    }
    test "repetition penalty over history [0, 4] and [2, 3] agrees with sample" {
        assert agrees(config_p(1.0, 0, 0.0, 0.0, 2.0), [0, 4], SEED_A)
        assert agrees(config_p(1.0, 0, 0.0, 0.0, 2.0), [0, 4], SEED_C)
        assert agrees(config_p(1.0, 0, 0.0, 0.0, 2.0), [2, 3], SEED_A)
        assert agrees(config_p(1.0, 0, 0.0, 0.0, 2.0), [2, 3], SEED_B)
    }
    test "a repeated history id is penalised repeatedly, as in sample" {
        assert agrees(config_p(1.0, 0, 0.0, 0.0, 2.0), [4, 4], SEED_A)
        assert agrees(config_p(1.0, 0, 0.0, 0.0, 2.0), [4, 4], SEED_C)
    }
    test "the full combination agrees with sample on token and seed" {
        assert agrees(config_p(1.5, 3, 0.8, 0.25, 1.5), [2], SEED_A)
        assert agrees(config_p(1.5, 3, 0.8, 0.25, 1.5), [2], SEED_B)
        assert agrees(config_p(1.5, 3, 0.8, 0.25, 1.5), [2], SEED_C)
    }
    test "the full combination draws the pinned tokens" {
        assert cand_token(logits_p(), ids_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2], seed_p(SEED_A)) ≡ 0
        assert cand_token(logits_p(), ids_p(), config_p(1.5, 3, 0.8, 0.25, 1.5), [2], seed_p(SEED_B)) ≡ 4
    }
    test "temperature 0 is greedy with the seed unchanged" {
        let sampling.Config g ← config_p(0.0, 0, 0.0, 0.0, 1.0)
        assert cand_token(logits_p(), ids_p(), g, [], seed_p(SEED_A)) ≡ 4
        assert cand_status(logits_p(), ids_p(), g, [], seed_p(SEED_A)) ≡ SEED_A
    }
}

describe "sampling — sample_candidates over a sparse candidate list" {
    test "candidates {0, 4} with top-k 2 match sample over the full list" {
        let sampling.Config k2 ← config_p(1.0, 2, 0.0, 0.0, 1.0)
        let list<f32> vals ← [2.0, 3.0]
        let list<int> ids ← [0, 4]
        assert cand_token(vals, ids, k2, [], seed_p(SEED_A)) ≡ sample_token(logits_p(), k2, [], seed_p(SEED_A))
        assert cand_status(vals, ids, k2, [], seed_p(SEED_A)) ≡ sample_status(logits_p(), k2, [], seed_p(SEED_A))
        assert cand_token(vals, ids, k2, [], seed_p(SEED_B)) ≡ sample_token(logits_p(), k2, [], seed_p(SEED_B))
        assert cand_status(vals, ids, k2, [], seed_p(SEED_B)) ≡ sample_status(logits_p(), k2, [], seed_p(SEED_B))
    }
    test "the winning candidate position maps to its vocabulary id" {
        let list<f32> vals ← [1.0, 1.0]
        let list<int> ids ← [7, 900]
        assert cand_token(vals, ids, config_simplex(), [], seed_p(SEED_A)) ≡ 7
        assert cand_token(vals, ids, config_simplex(), [], seed_p(SEED_B)) ≡ 900
        assert cand_token(vals, ids, config_p(0.0, 0, 0.0, 0.0, 1.0), [], seed_p(SEED_A)) ≡ 7
    }
    test "a history id that is not a candidate is ignored" {
        let list<f32> vals ← [2.0, 3.0]
        let list<int> ids ← [0, 4]
        let sampling.Config pen ← config_p(1.0, 0, 0.0, 0.0, 2.0)
        assert cand_status(vals, ids, pen, [3], seed_p(SEED_A)) ≡ cand_status(vals, ids, pen, [], seed_p(SEED_A))
        assert cand_token(vals, ids, pen, [3], seed_p(SEED_A)) ≡ cand_token(vals, ids, pen, [], seed_p(SEED_A))
    }
    test "malformed candidate input rejects" {
        assert cand_detail([], [], config_simplex(), [], seed_p(SEED_A)) ≡ "logits must be non-empty"
        assert cand_detail([1.0, 2.0], [0], config_simplex(), [], seed_p(SEED_A)) ≡ "candidate ids must match candidate values"
        assert cand_detail([1.0, 2.0], [3, 3], config_simplex(), [], seed_p(SEED_A)) ≡ "candidate ids must be strictly ascending"
        assert cand_detail([1.0, 2.0], [4, 3], config_simplex(), [], seed_p(SEED_A)) ≡ "candidate ids must be strictly ascending"
        assert cand_detail([1.0, 2.0], [0, 1], config_simplex(), [0 - 1], seed_p(SEED_A)) ≡ "history token out of vocabulary range"
    }
}

# ---- distribution check (chi-square over 200 sample_candidates draws)
#
# 200 draws at temperature 1 over six logits with distinct probabilities,
# request seeds 1..200 taken through the generation config (the same whitening
# path a request uses), candidates = the full list sorted by id, empty history.
# Expected count of id k is 200 * sampling.distribution(...)[k]; the smallest
# is about 5.4, so the chi-square approximation holds.
#
# Bound: 6 ids -> 5 degrees of freedom. The chi-square critical value at
# p = 0.001 and 5 degrees of freedom is 20.515 (upper-tail table value), so
# CHI_SQUARE_BOUND = 20.52: a correct sampler exceeds it with probability
# about 0.1% (and the seeds are fixed, so the outcome is deterministic).
#
# Observed on the fixed seeds 1..200: counts [99, 38, 32, 22, 8, 1], statistic
# 10.83 (below the bound). The stand-in wrong samplers score 171.64 (always the
# highest-probability id) and 286.53 (uniform over the six ids), both far above.

const f32 CHI_SQUARE_BOUND = (20.52 ∷ f32)
const int CHI_DRAWS = 200

fn chi_logits() → list<f32> {
    return [2.0, 1.0, 0.5, 0.0, (0.0 - 0.5) ↦ f32, (0.0 - 1.0) ↦ f32]
}

# The id drawn by sample_candidates over the full id-sorted list for request seed i.
fn chi_draw(int i) → int {
    return cand_token(chi_logits(), [0, 1, 2, 3, 4, 5], config_simplex(), [], request_seed(i))
}

# The 200 draws for request seeds 1..200.
fn chi_draws() → list<int> {
    mut list<int> out ← empty
    for range 1 ‥ (CHI_DRAWS + 1) let i {
        out.append(chi_draw(i))
    }
    return out
}

# How many of the draws equal id k.
fn chi_count(list<int> draws, int k) → int {
    mut int n ← 0
    for from draws let t {
        if t ≡ k {
            n ← n + 1
        }
    }
    return n
}

# Pearson statistic: sum over ids of (observed - expected)^2 / expected, with
# expected = 200 * distribution[k].
fn chi_square(list<int> draws) → f32 {
    let list<f32> d ← distribution_p(chi_logits(), config_simplex(), [])
    mut f32 stat ← (0.0 ∷ f32)
    for range 0 ‥ 6 let k {
        let f32 expected ← p(d, k) * (CHI_DRAWS ↦ f32)
        let f32 diff ← (chi_count(draws, k) ↦ f32) - expected
        stat ← stat + diff * diff / expected
    }
    return stat
}

# Stand-in wrong samplers: always the highest-probability id; uniform over ids.
fn chi_wrong_argmax() → list<int> {
    mut list<int> out ← empty
    for range 0 ‥ CHI_DRAWS {
        out.append(0)
    }
    return out
}

fn chi_wrong_uniform() → list<int> {
    mut list<int> out ← empty
    for range 0 ‥ CHI_DRAWS let i {
        out.append(i % 6)
    }
    return out
}

describe "sampling — sample_candidates distribution check" {
    test "200 draws over seeds 1..200 fit the distribution within the p = 0.001 chi-square bound" {
        let list<int> draws ← chi_draws()
        assert draws.length() ≡ CHI_DRAWS
        assert chi_square(draws) ≺ CHI_SQUARE_BOUND
    }
    test "the check has teeth: an always-argmax and a uniform sampler exceed the bound" {
        assert chi_square(chi_wrong_argmax()) ≻ CHI_SQUARE_BOUND
        assert chi_square(chi_wrong_uniform()) ≻ CHI_SQUARE_BOUND
    }
}
