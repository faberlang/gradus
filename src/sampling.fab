+++
locale = "en"
+++
# Sampling — deterministic token sampling (PML5-U3, production inference
# computation layer).
#
# Public import: import from "gradus:sampling" sampling
# Depends on: gradus:dtype (finite — the logits/config finite gate),
# gradus:train (Seed — the explicit RNG state seam).
#
# Architectural rule: gradus owns computation and logical state — NOT
# scheduling, batching, HTTP, or device handles (the product repo / NGAB
# own those). This module holds no device handle, no hidden state, and
# makes no performance claims.
#
# =========================================================================
# The sampling contract (pml5-delivery.md PML5-U3)
# =========================================================================
#
# --- Pure function --------------------------------------------------------
# Sampling is a PURE function of logits + config + RNG state:
#
#   max(logits) -> token id                       (greedy, exact)
#   sample(logits, Config, history, Seed) -> Sampler
#
# No hidden state: the RNG state (Seed) is an explicit argument and is
# returned advanced in the outcome; equal inputs produce equal outcomes.
# The seed enters through train.construct_seed (the xorshift64 seam); the
# same seed reproduces the same token choices.
#
# --- The pinned pipeline order (deterministic, oracle-pinned) -------------
# sample applies, in this exact order:
#   1. repetition penalty (repetition_penalty) over the history tokens:
#        logits[t] > 0  -> logits[t] / penalty
#        logits[t] <= 0 -> logits[t] * penalty        (the llama.cpp rule)
#   2. temperature scaling: logits[i] / temperature
#   3. top-k: keep the k largest logits (first-index ties; k <= 0 = off)
#   4. stabilized softmax (max-subtracted exp, base-e)
#   5. top-p (nucleus): the smallest descending-probability set whose
#        cumulative mass reaches top_p; renormalized (<=0 or >=1 = off)
#   6. min-p: keep probs >= min_p * max_prob; renormalized (<=0 = off)
#   7. draw u in [0,1) from Seed (train.next_f32) and walk the
#        cumulative distribution: first index with cum >= u.
# temperature <= 0 is the GREEDY path: sample returns the argmax token and
# the UNCHANGED Seed (no draw). The order and tie-breaks are part of the
# oracle contract (first-index ties throughout).
#
# --- Fail-closed gates ------------------------------------------------------
# Logits must be non-empty and finite (GI2 finite-gate discipline); the
# history tokens must lie in [0, logits.length()); Config knobs are
# validated by construct_config. Invalid input throws (typed error), never
# silently truncates.
#
# --- Evidence honesty (CTO Q2, hard) --------------------------------------
# This surface is the STRUCTURAL proof: the pure-function shape, the greedy
# exactness, the deterministic pipeline, and the f64 oracle pins (the
# sampling.proba pins evaluate the documented arithmetic). Executed token
# value-identity is not claimed here. Library-to-library calls execute on
# the FMIR stepper (radix 43c0102ba; regression-locked by 2e8042ae7).
# PML5-U3 is PARTIAL and token value-identity is deferred to
# the auditor-owned runtime-evidence gate.
import from "gradus:dtype" dtype

import from "gradus:train" train

# -------------------------------------------------------------------------
# SamplingError — typed error vocabulary of the sampling surface.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------


@ public
union SamplingError {
    @ shared
    string message

    InvalidLogits,
    InvalidConfig,
    InvalidHistory
}



# -------------------------------------------------------------------------
# Config — the sampling knobs. The validated constructor is
# construct_config; the class itself is the plain carrier.
# -------------------------------------------------------------------------


@ public
class Config {
    # Temperature scaling; <= 0 selects the greedy path.
    mut f32 temperature
    # Top-k filter width; 0 disables the filter.
    mut int top_k
    # Top-p (nucleus) threshold; <= 0 or >= 1 disables the filter.
    mut f32 top_p
    # Min-p threshold; <= 0 disables the filter.
    mut f32 min_p
    # Repetition penalty; 1.0 = no penalty.
    mut f32 repetition_penalty
}

# The validated Config constructor. Temperature may be 0 (the greedy
# flag) and must be finite; top_k non-negative; top_p / min_p finite
# within [0, 1]; the repetition penalty finite and at least 1.0.
@ public
fn construct_config(f32 τ, int top_k, f32 top_p, f32 min_p, f32 repetition_penalty) → Config ⇥ SamplingError {
    require dtype.finite(τ) throw variant InvalidConfig { message = "temperature must be non-negative" }
    require τ ≥ 0.0 throw variant InvalidConfig { message = "temperature must be non-negative" }
    require top_k ≥ 0 throw variant InvalidConfig { message = "top-k must be non-negative" }
    require dtype.finite(top_p) throw variant InvalidConfig { message = "top-p must be within [0, 1]" }
    require top_p ≥ 0.0 throw variant InvalidConfig { message = "top-p must be within [0, 1]" }
    require top_p ≤ 1.0 throw variant InvalidConfig { message = "top-p must be within [0, 1]" }
    require dtype.finite(min_p) throw variant InvalidConfig { message = "min-p must be within [0, 1]" }
    require min_p ≥ 0.0 throw variant InvalidConfig { message = "min-p must be within [0, 1]" }
    require min_p ≤ 1.0 throw variant InvalidConfig { message = "min-p must be within [0, 1]" }
    require dtype.finite(repetition_penalty) throw variant InvalidConfig { message = "repetition penalty must be at least 1" }
    require repetition_penalty ≥ 1.0 throw variant InvalidConfig { message = "repetition penalty must be at least 1" }
    return Config { temperature = τ, top_k = top_k, top_p = top_p, min_p = min_p, repetition_penalty = repetition_penalty }
}

# Placeholder Default for `var Config` bindings (var on structs).
# Zero knobs (not a valid config). Only a placeholder the caller
# overwrites, or returns from an unreachable cape arm.
@ public
fn default_config() → Config {
    return Config { temperature = 0.0, top_k = 0, top_p = 0.0, min_p = 0.0, repetition_penalty = 0.0 }
}

# -------------------------------------------------------------------------
# Sampler — a sample outcome: the chosen token id + the advanced RNG state.
# -------------------------------------------------------------------------


@ public
class Sampler {
    mut int token_id
    # Advanced generator state after the draw (explicit RNG continuation).
    mut train.Seed seed
}

# Placeholder Default for `var Sampler` bindings (var on structs).
# Token 0 and an empty seed (not a valid draw). Only a placeholder the
# caller overwrites, or returns from an unreachable cape arm.
@ public
fn default() → Sampler {
    return Sampler { token_id = 0, seed = train.default() }
}

# -------------------------------------------------------------------------
# max — the GREEDY path: the index of the largest logit (first-index
# tie-break). Exact, pure, no RNG. Rejects empty or non-finite logits.
# -------------------------------------------------------------------------

@ public
fn max(list<f32> logits) → int ⇥ SamplingError {
    require_logits(logits)
    return argmax_index(logits)
}

# -------------------------------------------------------------------------
# distribution — the PURE post-filter distribution: logits + config +
# history in, the filtered probability vector out (steps 1–6 of the pinned
# pipeline; no RNG). Exposed so the oracle pins can compare the per-knob
# distributions.
# -------------------------------------------------------------------------

@ public
fn distribution(list<f32> logits, Config c, list<int> history) → list<f32> ⇥ SamplingError {
    require_logits(logits)
    require_history(logits, history)
    return filtered(logits, c, history)
}

# -------------------------------------------------------------------------
# sample — the STOCHASTIC path: pure function of logits + config + history +
# RNG state. temperature <= 0 selects the greedy path (argmax, seed
# unchanged). Otherwise the filtered distribution is drawn and the outcome
# carries the advanced Seed.
# -------------------------------------------------------------------------

@ public
fn sample(list<f32> logits, Config c, list<int> history, train.Seed seed) → Sampler ⇥ SamplingError {
    require_logits(logits)
    require_history(logits, history)
    if c.temperature ≤ 0.0 then return Sampler { token_id = argmax_index(logits), seed = seed }
    return draw(filtered(logits, c, history), seed)
}

# -------------------------------------------------------------------------
# sample_candidates — the sparse STOCHASTIC path: the same Sampler (token id
# and advanced Seed) that sample returns for a full logits list in which every
# non-candidate position is dropped (exact 0.0 probability). values holds the
# candidate logits and ids their vocabulary ids, strictly ascending by id.
# The pipeline and its float summation order are the full-list pipeline's:
# dropped positions add exact 0.0, so walking only the candidates in id order
# adds the same terms in the same order. history holds vocabulary ids; a
# history id that is not a candidate is dropped from the penalty scatter.
# Callers that already applied the penalty before narrowing pass an empty
# history. Exact only when the candidate set contains every position the
# filters would keep. temperature <= 0 is greedy: the argmax candidate's id,
# Seed unchanged.
# -------------------------------------------------------------------------

@ public
fn sample_candidates(list<f32> values, list<int> ids, Config c, list<int> history, train.Seed seed) → Sampler ⇥ SamplingError {
    require_logits(values)
    require_candidate_ids(values, ids)
    for from history let t {
        require t ≥ 0 throw variant InvalidHistory { message = "history token out of vocabulary range" }
    }
    if c.temperature ≤ 0.0 {
        let int greedy ← argmax_index(values)
        return Sampler { token_id = ids[greedy], seed = seed }
    }
    mut list<int> positions ← empty
    for from history let t {
        let int ∪ none at ← candidate_position(ids, t)
        if at ≢ null {
            positions.append(at)
        }
    }
    let list<f32> penalized ← repetition_penalty(values, positions, c.repetition_penalty)
    let list<f32> scaled ← temperature_scale(penalized, c.temperature)
    let TopKResult k_limited ← top_k(scaled, c.top_k)
    let list<f32> probs ← softmax(k_limited.values, k_limited.keep)
    let list<f32> p_limited ← top_p(probs, c.top_p)
    let Sampler drawn ← draw(min_p(p_limited, c.min_p), seed)
    return Sampler { token_id = ids[drawn.token_id], seed = drawn.seed }
}

# -------------------------------------------------------------------------
# Private helpers (the deterministic pipeline).
# -------------------------------------------------------------------------

fn require_logits(list<f32> logits) → void ⇥ SamplingError {
    require logits.length() ≢ 0 throw variant InvalidLogits { message = "logits must be non-empty" }
    require finite(logits) throw variant InvalidLogits { message = "logits must be finite" }
}

fn require_history(list<f32> logits, list<int> history) → void ⇥ SamplingError {
    for from history let t {
        require t ≥ 0 throw variant InvalidHistory { message = "history token out of vocabulary range" }
        require t ≺ logits.length() throw variant InvalidHistory { message = "history token out of vocabulary range" }
    }
}

# One id per value, non-negative and strictly ascending.
fn require_candidate_ids(list<f32> values, list<int> ids) → void ⇥ SamplingError {
    require ids.length() ≡ values.length() throw variant InvalidLogits { message = "candidate ids must match candidate values" }
    let int n ← ids.length()
    if n ≡ 0 then return
    require ids[0] ≥ 0 throw variant InvalidLogits { message = "candidate ids must be strictly ascending" }
    if n ≻ 1 {
        for from ids[0 ‥ n - 1], ids[1 ‥ n] let previous, next {
            require next ≻ previous throw variant InvalidLogits { message = "candidate ids must be strictly ascending" }
        }
    }
}

# The index of the largest value (first-index ties). Callers gate non-empty
# logits; an empty list is the typed error rather than a default index.
fn argmax_index(list<f32> xs) → int ⇥ SamplingError {
    let int ∪ none best ← xs.argmax()
    if best ≡ null then throw variant InvalidLogits { message = "logits must be non-empty" }
    return best
}

# Position of id t in the ascending ids (binary search), or none when absent.
# The interval halves until the id is found or the interval is empty, so the
# number of probes depends on the data.
fn candidate_position(list<int> ids, int t) → int ∪ none {
    mut int lo ← 0
    mut int hi ← ids.length() - 1
    while lo ≤ hi {
        let int mid ← lo + (hi - lo) / 2
        let int v ← ids[mid]
        if v ≡ t then return mid
        if v ≺ t {
            lo ← mid + 1
        }
        else {
            hi ← mid - 1
        }
    }
    return null
}

# Steps 1–6 of the pinned pipeline (caller has already gated logits/history).
fn filtered(list<f32> logits, Config c, list<int> history) → list<f32> ⇥ SamplingError {
    if c.temperature ≤ 0.0 {
        let list<f32> degenerate ← logits.map(f32 v ∴ 0.0 ∷ f32)
        return replace_at(degenerate, argmax_index(logits), 1.0)
    }
    let list<f32> penalized ← repetition_penalty(logits, history, c.repetition_penalty)
    let list<f32> scaled ← temperature_scale(penalized, c.temperature)
    let TopKResult k_limited ← top_k(scaled, c.top_k)
    let list<f32> probs ← softmax(k_limited.values, k_limited.keep)
    let list<f32> p_limited ← top_p(probs, c.top_p)
    return min_p(p_limited, c.min_p)
}

# e^x via the exponentiation intrinsic (base e > 0, so the non-positive
# base guard never fires; power lowers to exp(x·ln(e)) ≈ exp(x)). Direct
# exp(x−m) in softmax is ≤ 1 and cannot overflow; the reciprocal 1/e^{m−x}
# form overflows when the logit gap is large (IgnoreEos uses −1e9).
const f32 E = 2.718281828459045 ∷ f32

fn exp(f32 x) → f32 {
    return E.power(x)
}

# Index a outranks b: strictly larger value, else smaller index. The
# first-index tie follows the stated-once argmax/argmin contract in the
# Wave-0 delivery §3; this pairwise comparison stays because it compares
# two heap indices, not a full-collection reduction.
fn prefers(list<f32> xs, int a, int b) → bool {
    let f32 va ← xs[a]
    let f32 vb ← xs[b]
    if va ≻ vb then return true
    if vb ≻ va then return false
    return a ≺ b
}

# Sift heap[i] down inside heap[0, size). The heap stores indices into xs.
# The element sinks one level per pass and stops where it outranks its
# children, so the number of passes depends on the data.
fn sift_down(mut list<int> heap, list<f32> xs, int i, int size) → void {
    mut int cur ← i
    while true {
        let int child ← 2 * cur + 1
        if child ≥ size {
            return
        }
        mut int pick ← child
        let int other ← child + 1
        if other ≺ size {
            if prefers(xs, heap[other], heap[pick]) {
                pick ← other
            }
        }
        if prefers(xs, heap[pick], heap[cur]) {
            let int tmp ← heap[cur]
            heap[cur] ← heap[pick]
            heap[pick] ← tmp
            cur ← pick
        }
        else {
            return
        }
    }
}

# Max-heap of 0..n-1 over xs (first-index ties). Heapify is O(n).
fn index_heap(list<f32> xs) → list<int> {
    let int n ← xs.length()
    # Keep: index fill (the element IS its position); no index-carrying map
    # or range-to-list form exists.
    mut list<int> heap ← empty
    for range 0 ‥ n let j {
        heap.append(j)
    }
    if n ≥ 2 {
        for range n / 2 - 1 … 0 let start {
            sift_down(mut heap, xs, start, n)
        }
    }
    return heap
}

# Pop the current max index; restore a heap of the remaining size-1.
# Caller must pass size > 0 and then decrement its own size.
fn heap_pop(mut list<int> heap, list<f32> xs, int size) → int {
    let int best ← heap[0]
    let int last ← size - 1
    if last ≻ 0 {
        heap[0] ← heap[last]
        sift_down(mut heap, xs, 0, last)
    }
    return best
}

# Every element is finite (the GI2 finite gate); stops at the first failure.
fn finite(list<f32> xs) → bool {
    return xs.all(f32 v ∴ dtype.finite(v))
}

# The list with position i replaced by v (pure rebuild).
fn replace_at(list<f32> xs, int i, f32 v) → list<f32> {
    mut list<f32> out ← copy xs
    out[i] ← v
    return out
}

# Step 1 — repetition penalty over the history tokens (llama.cpp rule:
# positive logits divide by penalty, non-positive multiply by penalty).
# One vocab copy, then one in-place apply per history token (O(V + history);
# a token listed twice is penalized twice, matching the nested-scan rule).
fn repetition_penalty(list<f32> logits, list<int> history, f32 penalty) → list<f32> {
    mut list<f32> out ← copy logits
    for from history let t {
        let f32 w ← out[t]
        if w ≻ 0.0 {
            out[t] ← w / penalty
        }
        else {
            out[t] ← w * penalty
        }
    }
    return out
}

# Step 2 — temperature scaling (pure per-element division).
fn temperature_scale(list<f32> logits, f32 τ) → list<f32> {
    return logits.map(f32 v ∴ v / τ)
}

# Top-k result keeps the original vocabulary positions while carrying an
# explicit participation mask. Dropped logits are absent from the softmax
# reduction rather than replaced by a value that can retain probability mass.
class TopKResult {
    mut list<f32> values
    mut list<bool> keep
}

# Step 3 — top-k: keep the k largest logits (first-index ties, k <= 0 off).
# Partial selection: heapify once, extract k (O(V + k log V)); no full sort.
fn top_k(list<f32> xs, int k) → TopKResult {
    let int n ← xs.length()
    let list<f32> values ← copy xs
    if k ≤ 0 or k ≥ n {
        return TopKResult { values = values, keep = xs.map(f32 v ∴ true) }
    }
    mut list<bool> keep ← xs.map(f32 v ∴ false)
    mut list<int> heap ← index_heap(xs)
    for range 0 ‥ k let removed {
        let int best ← heap_pop(mut heap, xs, n - removed)
        keep[best] ← true
    }
    return TopKResult { values = values, keep = keep }
}

# Step 4 — stabilized softmax (max-subtracted, base-e). Only positions in
# keep participate in the max and sum reductions; dropped positions scatter
# back as exact zeroes after the kept logits are normalized.
# W0 stay: this is a participation-masked max; no masked-argmax twin is
# admitted, so the found-flag scan remains the W1 seam.
fn softmax(list<f32> xs, list<bool> keep) → list<f32> {
    mut int best ← 0
    mut bool found ← false
    mut f32 best_value ← 0.0
    for from xs, keep at [i] let v, kept {
        if kept and (not found or v ≻ best_value) {
            best ← i
            best_value ← v
            found ← true
        }
    }
    let f32 m ← xs[best]
    # Participation-masked exponent build. Dropped positions carry exact 0.0,
    # so the flat reducer below reproduces the masked sum byte-exactly
    # (adding +0.0 is an exact identity for the non-negative accumulator).
    mut list<f32> es ← empty
    for from xs, keep let v, kept {
        es.append(kept ✓ exp(v - m) ✗ 0.0)
    }
    let f32 sum ← es.reduce((f32 acc, f32 e) ∴ acc + e, 0.0)
    return es.map(f32 e ∴ e / sum)
}

# Renormalize the kept probabilities (kept positions keep prob/sum, others 0).
fn renormalize_mask(list<f32> ps, list<bool> keep) → list<f32> {
    # Both passes are participation-masked; no masked-reduce form exists.
    mut f32 sum ← 0.0
    for from ps, keep let v, kept {
        if kept {
            sum ← sum + v
        }
    }
    mut list<f32> out ← empty
    for from ps, keep let v, kept {
        out.append(kept ✓ v / sum ✗ 0.0)
    }
    return out
}

# Step 5 — top-p (nucleus): heap-extract in descending-probability
# first-index order until cumulative mass reaches p, then one renormalize
# pass (p <= 0 or p >= 1 off). Stops on a non-positive remainder (keeps
# every nonzero when the cumulative still sits below p). Avoids a full
# sort: heapify once, extract only the nucleus (O(V + k log V)).
fn top_p(list<f32> ps, f32 p) → list<f32> {
    if p ≤ 0.0 or p ≥ 1.0 then return ps
    let int n ← ps.length()
    mut list<bool> keep ← ps.map(f32 v ∴ false)
    mut list<int> heap ← index_heap(ps)
    mut f32 cum ← 0.0
    for range 0 ‥ n let removed {
        if not (cum ≺ p) then break
        let int best ← heap_pop(mut heap, ps, n - removed)
        let f32 v ← ps[best]
        if not (v ≻ 0.0) then break
        keep[best] ← true
        cum ← cum + v
    }
    return renormalize_mask(ps, keep)
}

# Step 6 — min-p: keep probs >= min_p * max_prob, renormalized (p <= 0 off).
fn min_p(list<f32> ps, f32 p) → list<f32> ⇥ SamplingError {
    if p ≤ 0.0 then return ps
    let f32 mx ← ps[argmax_index(ps)]
    let f32 threshold ← mx * p
    let list<bool> keep ← ps.map(f32 v ∴ v ≥ threshold)
    return renormalize_mask(ps, keep)
}

# Step 7 — the draw: u in [0,1) from the explicit Seed state (advanced),
# then the cumulative walk: the first index with cum >= u (the fallback for
# the f32 rounding edge where cum never reaches u is the last index).
fn draw(list<f32> probs, train.Seed seed) → Sampler {
    let train.DrawF32 u_f ← train.next_f32(seed)
    let f32 u ← u_f.payload
    mut f32 cum ← 0.0
    for from probs at [i] let p {
        cum ← cum + p
        if u ≺ cum then return Sampler { token_id = i, seed = u_f.seed }
    }
    return Sampler { token_id = probs.length() - 1, seed = u_f.seed }
}
