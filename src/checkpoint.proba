+++
locale = "en"
+++
# Co-located package tests for gradus:checkpoint.
# The envelope preserves its versioned wire and carries optimizer state
# verbatim; state validation remains the optimizer owner's responsibility.

import from "gradus:checkpoint" checkpoint

import from "gradus:random" random

import from "gradus:optimize" optimize

# A two-slot U3 optimizer-state wire (the checkpoint's embedded state),
# swallowing the never-firing OptimizeError (single-error-type fac). The
# trap outcome is annotated `string ∪ OptimizeError`: flow narrowing (`is`)
# reaches the success arm only through an explicit union annotation, not a
# `_` binding (the radix trap-narrowing idiom).
fn sgd_wire_2() → string {
    let string ∪ optimize.OptimizeError r ← trap {
        let optimize.Sgd o ← optimize.empty_sgd()
        let optimize.SgdState s1 ← optimize.construct("w1", "model", 1, 0.01 ∷ f32)
        let optimize.SgdState s2 ← optimize.construct("b1", "model", 1, 0.001 ∷ f32)
        let optimize.Sgd o2 ← optimize.add(o, s1)
        let optimize.Sgd o3 ← optimize.add(o2, s2)
        optimize.serialize(o3)
    }
    return r is string ✓ r ✗ ""
}

# Resume-path state-wire deserialization outcome (the embedded wire
# validates against ITS OWN schema — optimize.deserialize).
fn deserialize_optimum(string wire) → string {
    let _ outcome ← trap {
        optimize.deserialize(wire)
    }
    if outcome is optimize.Sgd {
        return "ok"
    }
    let optimize.OptimizeError err ← outcome
    return err.message
}

# Renders a checkpoint-construction outcome as text.
fn checkpoint_detail(int age, int step, random.Seed rng, string state_wire) → string {
    let _ outcome ← trap {
        checkpoint.construct_checkpoint(age, step, rng, state_wire)
    }
    if outcome is checkpoint.Checkpoint {
        return "ok"
    }
    let checkpoint.CheckpointError err ← outcome
    return err.message
}

# Renders a checkpoint-wire deserialization outcome as text.
fn deserialize_checkpoint_detail(string wire) → string {
    let _ outcome ← trap {
        checkpoint.deserialize_checkpoint(wire)
    }
    if outcome is checkpoint.Checkpoint {
        return "ok"
    }
    let checkpoint.CheckpointError err ← outcome
    return err.message
}

# ---- the checkpoint envelope (Checkpoint)

test "construct_checkpoint builds a checkpoint with epoch, step, RNG, and state wire" {
    let _ trap_result_28 ← trap {

        let random.Seed s ← random.construct_seed(42)
        let checkpoint.Checkpoint c ← checkpoint.construct_checkpoint(2, 37, s, sgd_wire_2())
        assert c.age ≡ 2
        assert c.step ≡ 37
        assert c.rng.status ≡ 42
        assert c.state_wire.length() ≻ 0
    }
    assert trap_result_28 is void
}

test "construct_checkpoint rejects a negative epoch and a negative step" {
    let _ trap_result_29 ← trap {

        let random.Seed s ← random.construct_seed(42)
        assert checkpoint_detail(0 - 1, 0, s, sgd_wire_2()) ≡ "epoch must be non-negative"
        assert checkpoint_detail(0, 0 - 1, s, sgd_wire_2()) ≡ "step must be non-negative"
    }
    assert trap_result_29 is void
}

test "construct_checkpoint rejects an empty state wire" {
    let _ trap_result_30 ← trap {

        let random.Seed s ← random.construct_seed(42)
        assert checkpoint_detail(0, 0, s, "") ≡ "checkpoint state wire is empty"
    }
    assert trap_result_30 is void
}

test "the checkpoint wire round-trips exactly (epoch, step, RNG, embedded state verbatim)" {
    # The embedded state wire is valid at resume (optimize schema).
    let _ trap_result_31 ← trap {

        let random.Seed s ← random.construct_seed(42)
        let checkpoint.Checkpoint c ← checkpoint.construct_checkpoint(2, 37, s, sgd_wire_2())
        let checkpoint.Checkpoint t ← checkpoint.deserialize_checkpoint(checkpoint.serialize_checkpoint(c))
        assert checkpoint.checkpoint_equal(c, t)
        assert t.state_wire ≡ c.state_wire
        assert deserialize_optimum(t.state_wire) ≡ "ok"
    }
    assert trap_result_31 is void
}

test "the checkpoint wire round-trips a negative RNG state exactly" {
    let _ trap_result_32 ← trap {

        let random.Seed s0 ← random.construct_seed(1)
        let random.Draw f1 ← random.next(s0)
        let random.Draw f2 ← random.next(f1.seed)
        let random.Draw f3 ← random.next(f2.seed)
        let checkpoint.Checkpoint c ← checkpoint.construct_checkpoint(1, 3, f3.seed, sgd_wire_2())
        let checkpoint.Checkpoint t ← checkpoint.deserialize_checkpoint(checkpoint.serialize_checkpoint(c))
        assert checkpoint.checkpoint_equal(c, t)
        assert t.rng.status ≡ 0 - 7269227409276787159
    }
    assert trap_result_32 is void
}

test "an interrupted (corrupt embedded state) wire fails closed at resume — explicitly" {
    # A checkpoint whose embedded state wire was truncated mid-write:
    # the envelope carries it verbatim (the two-layer contract)...
    # ...and resume FAILS CLOSED at the state wire's own schema.
    let _ trap_result_33 ← trap {

        let random.Seed s ← random.construct_seed(42)
        let checkpoint.Checkpoint c ← checkpoint.construct_checkpoint(0, 0, s, "optimizer/sgd/1.0.0/2;optimizer/sgd-state/1.0.0/model/w1/1/1/0/0.01")
        let checkpoint.Checkpoint t ← checkpoint.deserialize_checkpoint(checkpoint.serialize_checkpoint(c))
        assert t.state_wire ≡ c.state_wire
        assert deserialize_optimum(t.state_wire) ≡ "slot count mismatch in optimizer wire"
    }
    assert trap_result_33 is void
}

test "an unknown checkpoint marker is rejected" {
    assert deserialize_checkpoint_detail("tensor/checkpoint/1.0.0/0/0/1/x") ≡ "unknown checkpoint marker"
}

test "an unknown checkpoint schema version is rejected" {
    assert deserialize_checkpoint_detail("train/checkpoint/9.9.9/0/0/1/x") ≡ "unknown checkpoint schema version"
}

test "a malformed checkpoint wire is rejected" {
    assert deserialize_checkpoint_detail("train/checkpoint/1.0.0/0") ≡ "malformed checkpoint wire"
}

test "a non-numeric epoch is rejected" {
    assert deserialize_checkpoint_detail("train/checkpoint/1.0.0/abc/0/1/x") ≡ "malformed epoch in checkpoint wire"
}

test "a zero RNG state in the checkpoint is rejected" {
    assert deserialize_checkpoint_detail("train/checkpoint/1.0.0/0/0/0/x") ≡ "seed must be non-zero"
}

