+++
locale = "en"
+++
# Co-located package test for prepared_state.fab (PP-U1 — canonical
# prepared identity). Not importable; discovered only by the faber test
# path.
#
# Proves, at compile level:
#   * field-wise equality holds per component and rejects per-component
#     on mismatch (model, model_version, config, tokenizer, content
#     prefix, position);
#   * the versioned wire round-trips exactly (identity → wire → identity
#     equal), with the documented "-" sentinel for the empty prefix and
#     the empty digest;
#   * malformed wire rejects typed, fail-closed (marker, schema version,
#     segment count, empty fields, bad token id, bad tokenizer boolean,
#     inconsistent consumed range, non-numeric positions);
#   * the lookup digest passthrough is never equality-authoritative
#     (same digest, different tokens → unequal; different digest, same
#     tokens → equal).
#
# Import surface: this suite and the leaf import gradus:tokenizer for
# the typed TokenizerIdentity only — no model/dense/generation surface
# appears anywhere in the leaf (the unit table's import ban holds by
# construction).
#
# NOTE: the tokenizer fixtures are typed record literals (the
# prepared_state boundary binds the typed value; semantic tokenizer
# admission is gradus:tokenizer's own authority and is not re-run here).

import from "gradus:prepared_state" prepared_state

import from "gradus:tokenizer" tokenizer

# ---- pinned-row fixture facts (the tokenizer.proba pattern)

const string F_SCHEMA ← "1.0.0"
const string F_KIND ← "gpt2"
const string F_PRE ← "smollm"
const string F_VOCAB ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
const string F_ALT_VOCAB ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
const string F_EOG ← "0,2"

# ---- helpers (the cache.proba pattern)

# The pinned tokenizer identity row (typed record literal).
fn tok_row() → tokenizer.TokenizerIdentity {
    return tokenizer.TokenizerIdentity {schema = F_SCHEMA, merge_kind = F_KIND, pre_tokenizer = F_PRE, vocab_digest = F_VOCAB, eog = F_EOG, bos_free = true, space_free = true}
}

# A tokenizer identity with a different vocabulary digest (a DIFFERENT
# tokenizer — the per-component mismatch row).
fn tok_alt() → tokenizer.TokenizerIdentity {
    return tokenizer.TokenizerIdentity {schema = F_SCHEMA, merge_kind = F_KIND, pre_tokenizer = F_PRE, vocab_digest = F_ALT_VOCAB, eog = F_EOG, bos_free = true, space_free = true}
}

# A structurally empty tokenizer identity (fails this leaf's structural
# admission — not tokenizer's semantic admission).
fn tok_empty() → tokenizer.TokenizerIdentity {
    return tokenizer.TokenizerIdentity {schema = "", merge_kind = F_KIND, pre_tokenizer = F_PRE, vocab_digest = F_VOCAB, eog = F_EOG, bos_free = true, space_free = true}
}

fn no_ids() → list<int> {
    var list<int> l ← empty
    return l
}

fn ids1(int a) → list<int> {
    var list<int> l ← empty
    l.append(a)
    return l
}

fn ids2(int a, int b) → list<int> {
    var list<int> l ← empty
    l.append(a)
    l.append(b)
    return l
}

# The canonical prepared identity row (model "tiny-mlp", version
# "1.0.0", config "causal-rope-d4", pinned tokenizer).
fn ident_full(string model, string model_version, string config, tokenizer.TokenizerIdentity tok, list<int> prefix, string digest, int start) → prepared_state.PreparedIdentity {
    var prepared_state.PreparedIdentity i ← prepared_state.PreparedIdentity {model = "", model_version = "", config = "", tokenizer_identity = tok_row(), prefix = no_ids(), lookup_digest = "", position_start = 0}
    do {
        i ← prepared_state.construct(model, model_version, config, tok, prefix, digest, start)
    }
    catch err {
        return i
    }
    return i
}

fn ident(list<int> prefix, string digest, int start) → prepared_state.PreparedIdentity {
    return ident_full("tiny-mlp", "1.0.0", "causal-rope-d4", tok_row(), prefix, digest, start)
}

# Renders a construction outcome as text ("ok" or the typed message).
fn construct_detail(string model, string model_version, string config, tokenizer.TokenizerIdentity tok, list<int> prefix, string digest, int start) → string {
    do {
        prepared_state.construct(model, model_version, config, tok, prefix, digest, start)
        return "ok"
    }
    catch err {
        return prepared_state.message(err)
    }
}

# Renders a deserialization outcome as text.
fn deserialize_detail(string wire) → string {
    do {
        prepared_state.deserialize_identity(wire)
        return "ok"
    }
    catch err {
        return prepared_state.message(err)
    }
}

# Renders a serialization outcome as the wire text.
fn serialize_detail(prepared_state.PreparedIdentity i) → string {
    do {
        return prepared_state.serialize_identity(i)
    }
    catch err {
        return prepared_state.message(err)
    }
}

# The exact wire round-trip predicate (identity → wire → identity).
fn roundtrip(prepared_state.PreparedIdentity i) → bool {
    do {
        const prepared_state.PreparedIdentity j ← prepared_state.deserialize_identity(prepared_state.serialize_identity(i))
        return prepared_state.prepared_identity_equal(i, j)
    }
    catch err {
        return false
    }
}

# ---- the canonical row

test "identity construct pins the canonical row (content, model, config, tokenizer, position)" {
    do {
        const prepared_state.PreparedIdentity i ← prepared_state.construct("tiny-mlp", "1.0.0", "causal-rope-d4", tok_row(), ids2(5, 2), "deadbeef", 0)
        assert i.model() ≡ "tiny-mlp"
        assert i.model_version() ≡ "1.0.0"
        assert i.config() ≡ "causal-rope-d4"
        assert i.tokenizer_identity().vocab_digest() ≡ F_VOCAB
        assert i.length() ≡ 2
        assert (i.prefix().get(0) coalesce 0) ≡ 5
        assert (i.prefix().get(1) coalesce 0) ≡ 2
        assert i.lookup_digest() ≡ "deadbeef"
        assert i.position_start() ≡ 0
        assert i.position_next() ≡ 2
        # A non-zero consumed range keeps the exact [start, next) binding.
        const prepared_state.PreparedIdentity w ← prepared_state.construct("tiny-mlp", "1.0.0", "causal-rope-d4", tok_row(), ids2(5, 2), "deadbeef", 7)
        assert w.position_start() ≡ 7
        assert w.position_next() ≡ 9
    }
    catch err {
        assert false
    }
}

# ---- fail-closed admission

test "identity construct rejects fail-closed (identity, wire, tokenizer, position)" {
    assert construct_detail("", "1.0.0", "causal-rope-d4", tok_row(), ids2(5, 2), "deadbeef", 0) ≡ "empty model name in prepared identity"
    assert construct_detail("tiny-mlp", "", "causal-rope-d4", tok_row(), ids2(5, 2), "deadbeef", 0) ≡ "empty model version in prepared identity"
    assert construct_detail("tiny-mlp", "1.0.0", "", tok_row(), ids2(5, 2), "deadbeef", 0) ≡ "empty execution config in prepared identity"
    assert construct_detail("tiny|mlp", "1.0.0", "causal-rope-d4", tok_row(), ids2(5, 2), "deadbeef", 0) ≡ "reserved wire character in prepared identity"
    assert construct_detail("tiny-mlp", "1.0.0", "causal-rope-d4", tok_row(), ids2(5, 2), "dead|beef", 0) ≡ "reserved wire character in prepared identity"
    assert construct_detail("tiny-mlp", "1.0.0", "causal-rope-d4", tok_empty(), ids2(5, 2), "deadbeef", 0) ≡ "empty tokenizer schema in prepared identity"
    assert construct_detail("tiny-mlp", "1.0.0", "causal-rope-d4", tok_row(), ids2(5, 0-1), "deadbeef", 0) ≡ "token id below zero in prepared prefix"
    assert construct_detail("tiny-mlp", "1.0.0", "causal-rope-d4", tok_row(), ids2(5, 2), "deadbeef", 0-1) ≡ "negative start position in prepared identity"
}

# ---- field-wise equality

test "identity equality is field-wise and rejects per-component mismatch" {
    const prepared_state.PreparedIdentity a ← ident(ids2(5, 2), "deadbeef", 0)
    assert prepared_state.prepared_identity_equal(a, ident(ids2(5, 2), "deadbeef", 0))
    assert not prepared_state.prepared_identity_equal(a, ident_full("other-mlp", "1.0.0", "causal-rope-d4", tok_row(), ids2(5, 2), "deadbeef", 0))
    assert not prepared_state.prepared_identity_equal(a, ident_full("tiny-mlp", "1.0.1", "causal-rope-d4", tok_row(), ids2(5, 2), "deadbeef", 0))
    assert not prepared_state.prepared_identity_equal(a, ident_full("tiny-mlp", "1.0.0", "causal-rope-d8", tok_row(), ids2(5, 2), "deadbeef", 0))
    assert not prepared_state.prepared_identity_equal(a, ident_full("tiny-mlp", "1.0.0", "causal-rope-d4", tok_alt(), ids2(5, 2), "deadbeef", 0))
    assert not prepared_state.prepared_identity_equal(a, ident(ids2(5, 3), "deadbeef", 0))
    assert not prepared_state.prepared_identity_equal(a, ident(ids1(5), "deadbeef", 0))
    assert not prepared_state.prepared_identity_equal(a, ident(ids2(5, 2), "deadbeef", 1))
}

test "identity lookup digest passthrough is never equality-authoritative" {
    const prepared_state.PreparedIdentity a ← ident(ids2(5, 2), "deadbeef", 0)
    # Same digest, different tokens → UNEQUAL (the tokens decide).
    assert not prepared_state.prepared_identity_equal(a, ident(ids2(5, 3), "deadbeef", 0))
    # Different digest, same tokens → EQUAL (the digest never decides).
    assert prepared_state.prepared_identity_equal(a, ident(ids2(5, 2), "feedface", 0))
}

# ---- the versioned wire

test "identity wire round-trips exactly" {
    do {
        const prepared_state.PreparedIdentity i ← prepared_state.construct("tiny-mlp", "1.0.0", "causal-rope-d4", tok_row(), ids2(5, 2), "deadbeef", 0)
        assert roundtrip(i)
        assert serialize_detail(i) ≡ "prepared-state/identity/1.0.0|tiny-mlp|1.0.0|causal-rope-d4|1.0.0|gpt2|smollm|" + F_VOCAB + "|0,2|true|true|5,2|deadbeef|0|2"
    }
    catch err {
        assert false
    }
}

test "identity empty-prefix wire uses the documented sentinel" {
    do {
        const prepared_state.PreparedIdentity i ← prepared_state.construct("tiny-mlp", "1.0.0", "causal-rope-d4", tok_row(), no_ids(), "", 0)
        assert roundtrip(i)
        assert serialize_detail(i) ≡ "prepared-state/identity/1.0.0|tiny-mlp|1.0.0|causal-rope-d4|1.0.0|gpt2|smollm|" + F_VOCAB + "|0,2|true|true|-|-|0|0"
        const prepared_state.PreparedIdentity j ← prepared_state.deserialize_identity(prepared_state.serialize_identity(i))
        assert j.length() ≡ 0
        assert j.lookup_digest() ≡ ""
        assert j.position_next() ≡ 0
    }
    catch err {
        assert false
    }
}

test "identity wire rejects malformed input fail-closed" {
    assert deserialize_detail("") ≡ "malformed prepared identity wire"
    assert deserialize_detail("prepared-state/identity/1.0.0|tiny-mlp|1.0.0|causal-rope-d4|1.0.0|gpt2|smollm|" + F_VOCAB + "|0,2|true|true|5,2|deadbeef|0") ≡ "malformed prepared identity wire"
    assert deserialize_detail("cache/identity/1.0.0|tiny-mlp|1.0.0|causal-rope-d4|1.0.0|gpt2|smollm|" + F_VOCAB + "|0,2|true|true|5,2|deadbeef|0|2") ≡ "unknown prepared-state marker"
    assert deserialize_detail("prepared-state/identity/9.9.9|tiny-mlp|1.0.0|causal-rope-d4|1.0.0|gpt2|smollm|" + F_VOCAB + "|0,2|true|true|5,2|deadbeef|0|2") ≡ "unknown prepared-state identity schema version"
    assert deserialize_detail("prepared-state/identity/1.0.0||1.0.0|causal-rope-d4|1.0.0|gpt2|smollm|" + F_VOCAB + "|0,2|true|true|5,2|deadbeef|0|2") ≡ "empty model name in prepared identity"
    assert deserialize_detail("prepared-state/identity/1.0.0|tiny-mlp|1.0.0|causal-rope-d4|1.0.0|gpt2|smollm|" + F_VOCAB + "|0,2|true|true|5,x|deadbeef|0|2") ≡ "malformed token id in prepared identity wire"
    assert deserialize_detail("prepared-state/identity/1.0.0|tiny-mlp|1.0.0|causal-rope-d4|1.0.0|gpt2|smollm|" + F_VOCAB + "|0,2|yes|true|5,2|deadbeef|0|2") ≡ "malformed tokenizer boolean in prepared identity wire"
    assert deserialize_detail("prepared-state/identity/1.0.0|tiny-mlp|1.0.0|causal-rope-d4|1.0.0|gpt2|smollm||0,2|true|true|5,2|deadbeef|0|2") ≡ "empty tokenizer vocabulary digest in prepared identity wire"
    assert deserialize_detail("prepared-state/identity/1.0.0|tiny-mlp|1.0.0|causal-rope-d4|1.0.0|gpt2|smollm|" + F_VOCAB + "|0,2|true|true|5,2|deadbeef|0|3") ≡ "inconsistent consumed range in prepared identity wire"
    assert deserialize_detail("prepared-state/identity/1.0.0|tiny-mlp|1.0.0|causal-rope-d4|1.0.0|gpt2|smollm|" + F_VOCAB + "|0,2|true|true|5,2|deadbeef|x|2") ≡ "malformed start position in prepared identity wire"
}
