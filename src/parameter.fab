+++
locale = "en"
+++
# Parameter identity and traversal — PML1-U5 (parameter contract).
#
# Public import: importa ex "gradus:parameter" privata parametrum
# Depends on: gradus:dtype (DType tag, U2), gradus:shape (shape rules, U3),
# gradus:tensor (value carrier, U1). DAG: parameter → tensor → dtype → math.
#
# --- Contract ------------------------------------------------------------
#
# Schema: parameter-identity-schema-1.0.0 (stamped 2026-08-08, PML1-U5).
# The FULL parameter identity contract lives in this module — campaign rule:
# no parameter identity split across units. Value bytes are U7; identity is
# owned here and its serialization round-trips here.
#
# Identity = (nomen, typo, forma, versio, possessor). Fields:
#   nomen      — parameter name, unique within an owner (the module's
#                registry enforces (possessor, nomen) uniqueness).
#   typo       — element dtype (dtype.DType tag, U2). The public constructors
#                take the canonical dtype name textus (wire/name contract,
#                dtype.nomen) because the proba file-interface cannot import
#                exports carrying cross-module nominal parameter types
#                (WARN014); the stored identity carries the typed tag.
#   forma      — runtime dimension vector (U3 staged carrier); non-negative
#                dims, validated with shape.valet at construction.
#   versio     — mutation counter: starts at 1; every successful mutation
#                bumps it by 1. Identity fields (nomen/typo/forma/possessor)
#                are stable across mutation; only versio advances. Frozen
#                parameters never mutate, so their versio never bumps.
#   possessor  — owner path (e.g. "model.block0.linear.weight").
#
# Mutation rules:
#   * mutation replaces VALUES only — the identity's shape and dtype are
#     pinned by construction; muta takes the flat value list (the tensor's
#     movable form) and rebuilds the value against the pinned identity;
#   * mutating a frozen parameter fails closed (GelidaMutatio);
#   * a successful mutation bumps versio by 1;
#   * value-domain enforcement of the flat data is the dtype casta
#     contract (U2) — this module checks count/shape, not value ranges.
#
# Traversal:
#   * statio: Trainabilis (trainable) | Gelida (frozen);
#   * Registrum.ordo() yields trainable parameters FIRST (insertion order),
#     then frozen parameters (insertion order) — the trainable/frozen
#     traversal contract; trainabiles()/gelidae() expose each class.
#
# Serialization (identity wire form, versioned):
#   "parameter/identity/1.0.0/<possessor>/<nomen>/<dtype>/<versio>/<dim>/..."
#   Scalar shape [] contributes no trailing segments. Deserialization
#   rejects unknown marker/schema, malformed fields, unknown dtype names,
#   non-numeric version or dimensions — fail closed, no best-effort reads
#   (capsule rule). deserializa(serializa(i)) ≡ i by identitas_aequus.
#
# --- Compiler boundary notes (probed 2026-08-08) --------------------------
#
#   * The proba file-interface skips exports carrying cross-module nominal
#     parameter types (WARN014) — see the textus dtype-name constructor
#     seam above; this module's internal calls (dtype.ex_nomine,
#     tensor.structa_typo) are wrapped in fac/cape and re-thrown as typed
#     ParametrumError (same pattern as tensor.fab U1).
#   * Runtime proof is compile-level via faber check until the FMIR
#     stepper supports genus construction (recorded tensor.fab residual).
#
# --- Seams ---------------------------------------------------------------
#   * value bytes serialization + version rejection policy — U7.
#   * training/optimization consume parameters through this surface — U6.

import from "gradus:dtype" dtype

import from "gradus:shape" forma

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# Schema constant — any change to identity fields, mutation rules, or the
# wire encoding is a schema bump; consumers reject unknown schema versions.
# -------------------------------------------------------------------------

const string schema_versio ← "1.0.0"

# -------------------------------------------------------------------------
# Statio — parameter status. Trainable parameters may be mutated; frozen
# parameters reject mutation. Traversal orders trainable before frozen.
# -------------------------------------------------------------------------

union Statio {
    Trainabilis,
    Gelida
}

# Canonical status name (textus surface for probes and consumers).
@ public { }
fn statio_nomen(Statio s) → string {
    match s {
        case Trainabilis {
            return "trainable"
        }
        case Gelida {
            return "frozen"
        }
    }
}

# -------------------------------------------------------------------------
# ParametrumError — typed error vocabulary of the parameter contract.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------


@ public { }
union ParametrumError {
    NomenInane {
        string causa
    },
    NomenReservatum {
        string causa
    },
    TypoIgnotum {
        string causa
    },
    FormaInvalida {
        string causa
    },
    ElementaMismatch {
        string causa
    },
    GelidaMutatio {
        string causa
    },
    NomenDuplicatum {
        string causa
    },
    NomenIgnotum {
        string causa
    },
    VersioInvalida {
        string causa
    },
    WireMala {
        string causa
    }
}

@ public { }
fn causa(ParametrumError e) → string {
    match e {
        case NomenInane const causa {
            return causa
        }
        case NomenReservatum const causa {
            return causa
        }
        case TypoIgnotum const causa {
            return causa
        }
        case FormaInvalida const causa {
            return causa
        }
        case ElementaMismatch const causa {
            return causa
        }
        case GelidaMutatio const causa {
            return causa
        }
        case NomenDuplicatum const causa {
            return causa
        }
        case NomenIgnotum const causa {
            return causa
        }
        case VersioInvalida const causa {
            return causa
        }
        case WireMala const causa {
            return causa
        }
    }
}

# -------------------------------------------------------------------------
# Identitas — explicit parameter identity. All five fields together are the
# identity contract; value mutation preserves four of them and bumps versio.
# -------------------------------------------------------------------------


@ public { }
class Identitas {
    string nomen
    dtype.DType typo
    list<int> forma
    int versio
    string possessor

    # Name. Nominal projection.
    fn nomen() → string {
        return self.nomen
    }

    # Element dtype as the canonical dtype name (textus surface — the
    # typed tag is internal to the module; the name is the dtype contract).
    fn nomen_typi() → string {
        return dtype.nomen(self.typo)
    }

    # Runtime shape (dimension vector).
    fn figura() → list<int> {
        return self.forma
    }

    # Version (mutation counter).
    fn versio() → int {
        return self.versio
    }

    # Owner path.
    fn possessor() → string {
        return self.possessor
    }
}

# Field-wise identity equality — the round-trip predicate of the identity
# serialization contract.
@ public { }
fn identitas_aequus(Identitas a, Identitas b) → bool {
    if a.nomen() ≠ b.nomen() then return false
    if a.possessor() ≠ b.possessor() then return false
    if a.versio() ≠ b.versio() then return false
    if a.nomen_typi() ≠ b.nomen_typi() then return false
    if not (a.figura() ≡ b.figura()) then return false
    return true
}

# -------------------------------------------------------------------------
# Parametrum — one parameter: identity + status + value carrier (Tensor).
# -------------------------------------------------------------------------


@ public { }
class Parametrum {
    Identitas identitas
    Statio statio
    tensor.Tensor valor

    # Identity record.
    fn identia() → Identitas {
        return self.identitas
    }

    # Status tag.
    fn statio() → Statio {
        return self.statio
    }

    # Name.
    fn nomen() → string {
        return self.identitas.nomen
    }

    # Element dtype as the canonical dtype name.
    fn nomen_typi() → string {
        return dtype.nomen(self.identitas.typo)
    }

    # Runtime shape (dimension vector).
    fn figura() → list<int> {
        return self.identitas.forma
    }

    # Version (mutation counter).
    fn versio() → int {
        return self.identitas.versio
    }

    # Owner path.
    fn possessor() → string {
        return self.identitas.possessor
    }

    # Element count (product of dimension sizes; [] → 1).
    fn quantitas() → int {
        var int product ← 1
        for from self.identitas.forma const dim {
            product ← product * dim
        }
        return product
    }

    # Value carrier (the production tensor surface, U1).
    fn valor() → tensor.Tensor {
        return self.valor
    }
}

# -------------------------------------------------------------------------
# Status predicates — textus-safe status inspection (proba-visible; enum
# variants cannot be referenced across module boundaries, SEM001 note in
# dtype.fab).
# -------------------------------------------------------------------------

@ private { }
fn _gelida(Statio s) → bool {
    match s {
        case Gelida {
            return true
        }
        case Trainabilis {
            return false
        }
    }
}

@ public { }
fn est_trainabilis(Parametrum p) → bool {
    return not _gelida(p.statio())
}

@ public { }
fn est_gelida(Parametrum p) → bool {
    return _gelida(p.statio())
}

# -------------------------------------------------------------------------
# Construction. Public constructors take the dtype as its canonical name
# (WARN014 seam — see header); the stored identity carries the typed tag.
# Both validate fail-closed and return typed ParametrumError.
# -------------------------------------------------------------------------

# Shared construction: name/owner wire-safety, shape validity (U3), dtype
# name resolution (U2), then a validated tensor value (U1). versio starts
# at 1; the caller pins the status.
@ private { }
fn _structum(string nomen, string possessor, string typo_nomen, list<int> dimensia, list<f32> datos, Statio statio) → Parametrum ⇥ ParametrumError {
    if nomen.length() ≡ 0 {
        throw variant NomenInane {causa = "empty parameter name"}
    }
    if possessor.length() ≡ 0 {
        throw variant NomenInane {causa = "empty parameter owner"}
    }
    if _habeat_solidum(nomen) or _habeat_solidum(possessor) {
        throw variant NomenReservatum {causa = "reserved wire character in name or owner"}
    }
    if not forma.valet(dimensia) {
        throw variant FormaInvalida {causa = "invalid shape"}
    }
    var dtype.DType typo ← dtype.f32()
    do {
        typo ← dtype.ex_nomine(typo_nomen)
    }
    catch err {
        throw variant TypoIgnotum {causa = dtype.causa(err)}
    }
    do {
        const tensor.Tensor tv ← tensor.structa_typo(datos, dimensia, typo)
        return Parametrum {identitas = Identitas {nomen = nomen, typo = typo, forma = dimensia, versio = 1, possessor = possessor}, statio = statio, valor = tv}
    }
    catch err {
        throw variant ElementaMismatch {causa = tensor.causa(err)}
    }
    throw variant ElementaMismatch {causa = "unreachable"}
}

# Build a trainable parameter (default status).
@ public { }
fn structa(string nomen, string possessor, string typo_nomen, list<int> forma, list<f32> datos) → Parametrum ⇥ ParametrumError {
    return _structum(nomen, possessor, typo_nomen, forma, datos, variant Trainabilis)
}

# Build a frozen parameter (traversal-ordered after all trainable ones).
@ public { }
fn structa_gelida(string nomen, string possessor, string typo_nomen, list<int> forma, list<f32> datos) → Parametrum ⇥ ParametrumError {
    return _structum(nomen, possessor, typo_nomen, forma, datos, variant Gelida)
}

# -------------------------------------------------------------------------
# Mutation rules.
#   * values only — shape and dtype are pinned by identity;
#   * frozen parameters reject mutation (GelidaMutatio);
#   * a successful mutation bumps versio by 1.
# -------------------------------------------------------------------------

@ public { }
fn muta(Parametrum p, list<f32> datos) → Parametrum ⇥ ParametrumError {
    if _gelida(p.statio()) {
        throw variant GelidaMutatio {causa = "frozen parameter cannot be mutated"}
    }
    do {
        const tensor.Tensor novus ← tensor.structa_typo(datos, p.figura(), p.identitas.typo)
        return Parametrum {identitas = Identitas {nomen = p.nomen(), typo = p.identitas.typo, forma = p.figura(), versio = p.versio() + 1, possessor = p.possessor()}, statio = p.statio(), valor = novus}
    }
    catch err {
        throw variant ElementaMismatch {causa = tensor.causa(err)}
    }
    throw variant ElementaMismatch {causa = "unreachable"}
}

# -------------------------------------------------------------------------
# Registrum — parameter collection. Enforces (possessor, nomen) uniqueness
# and owns the traversal order contract: trainable first, then frozen,
# insertion order within each class.
# -------------------------------------------------------------------------


@ public { }
class Registrum {
    list<Parametrum> parametri

    # Parameter count.
    fn numerus() → int {
        return self.parametri.length()
    }

    # Identity membership by (possessor, nomen).
    fn contineo(string possessor, string nomen) → bool {
        for from self.parametri const p {
            if p.possessor() ≡ possessor and p.nomen() ≡ nomen then return true
        }
        return false
    }

    # Identity resolution by (possessor, nomen) — fail closed on a miss.
    fn inveni(string possessor, string nomen) → Parametrum ⇥ ParametrumError {
        for from self.parametri const p {
            if p.possessor() ≡ possessor and p.nomen() ≡ nomen then return p
        }
        throw variant NomenIgnotum {causa = "no parameter with that identity"}
    }

    # Trainable parameters in insertion order.
    fn trainabiles() → list<Parametrum> {
        var list<Parametrum> out ← vacua
        for from self.parametri const p {
            if not _gelida(p.statio()) {
                out.append(p)
            }
        }
        return out
    }

    # Frozen parameters in insertion order.
    fn gelidae() → list<Parametrum> {
        var list<Parametrum> out ← vacua
        for from self.parametri const p {
            if _gelida(p.statio()) {
                out.append(p)
            }
        }
        return out
    }

    # Traversal order: every trainable parameter first (insertion order),
    # then every frozen parameter (insertion order).
    fn ordo() → list<Parametrum> {
        var list<Parametrum> out ← self.trainabiles()
        for from self.gelidae() const p {
            out.append(p)
        }
        return out
    }
}

# Empty registry.
@ public { }
fn registrum_vacuum() → Registrum {
    return Registrum {parametri = vacua}
}

# Register a parameter. Rejects a duplicate (possessor, nomen) identity
# (NomenDuplicatum) — identity must resolve uniquely within an owner.
@ public { }
fn adscisco(Registrum r, Parametrum p) → Registrum ⇥ ParametrumError {
    if r.contineo(p.possessor(), p.nomen()) {
        throw variant NomenDuplicatum {causa = "parameter identity already registered"}
    }
    var list<Parametrum> nova ← r.parametri
    nova.append(p)
    return Registrum {parametri = nova}
}

# -------------------------------------------------------------------------
# Identity serialization — versioned wire form. Round-trips identity
# (deserializa(serializa(i)) ≡ i); rejects unknown schema, malformed
# fields, unknown dtype names, and non-numeric version/dimensions.
# Value bytes are U7 — identity carries no value data.
# -------------------------------------------------------------------------

# All-digits predicate for wire integer fields. Rejects empty, non-digit
# characters, and digit runs that could overflow numerus (i64 carrier).
@ private { }
fn _digitum(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _numerica(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _digitum(s.get(i)) then return false
        i ← i + 1
    }
    return true
}

# "/" is the wire segment separator — reserved in names and owners.
@ private { }
fn _habeat_solidum(string s) → bool {
    var int i ← 0
    while i ≺ s.length() {
        if s.get(i) ≡ "/" then return true
        i ← i + 1
    }
    return false
}

@ public { }
fn serializa(Identitas i) → string {
    var string out ← (((((((("parameter/identity/" + schema_versio) + "/") + i.possessor()) + "/") + i.nomen()) + "/") + i.nomen_typi()) + "/") + (i.versio() ↦ string)
    for from i.figura() const dim {
        out ← (out + "/") + (dim ↦ string)
    }
    return out
}

@ public { }
fn deserializa(string s) → Identitas ⇥ ParametrumError {
    const list<string> partes ← s.split("/")
    if partes.length() ≺ 7 {
        throw variant WireMala {causa = "malformed parameter identity"}
    }
    if partes.get(0) coalesce "" ≠ "parameter" {
        throw variant WireMala {causa = "unknown parameter marker"}
    }
    if partes.get(1) coalesce "" ≠ "identity" {
        throw variant WireMala {causa = "unknown identity marker"}
    }
    if partes.get(2) coalesce "" ≠ schema_versio {
        throw variant WireMala {causa = "unknown parameter schema version"}
    }
    const string possessor ← partes.get(3) coalesce ""
    if possessor.length() ≡ 0 {
        throw variant WireMala {causa = "empty owner in parameter identity"}
    }
    const string nomen ← partes.get(4) coalesce ""
    if nomen.length() ≡ 0 {
        throw variant WireMala {causa = "empty name in parameter identity"}
    }
    var dtype.DType typo ← dtype.f32()
    do {
        typo ← dtype.ex_nomine(partes.get(5) coalesce "")
    }
    catch err {
        throw variant TypoIgnotum {causa = dtype.causa(err)}
    }
    const string versio_textus ← partes.get(6) coalesce ""
    if not _numerica(versio_textus) {
        throw variant VersioInvalida {causa = "malformed version in parameter identity"}
    }
    var int versio ← 0
    do {
        versio ← versio_textus ↦ int
    }
    catch err {
        throw variant VersioInvalida {causa = "malformed version in parameter identity"}
    }
    if versio ≺ 1 {
        throw variant VersioInvalida {causa = "invalid version in parameter identity"}
    }
    var list<int> forma ← vacua
    var int k ← 7
    while k ≺ partes.length() {
        const string dim_textus ← partes.get(k) coalesce ""
        if not _numerica(dim_textus) {
            throw variant WireMala {causa = "malformed dimension in parameter identity"}
        }
        do {
            const int dim ← dim_textus ↦ int
            forma.append(dim)
        }
        catch err {
            throw variant WireMala {causa = "malformed dimension in parameter identity"}
        }
        k ← k + 1
    }
    return Identitas {nomen = nomen, typo = typo, forma = forma, versio = versio, possessor = possessor}
}
