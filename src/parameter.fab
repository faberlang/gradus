}

test "find resolves identity by (owner, name) and contains confirms" {
    let _ trap_result_7 ← trap {

        let parameter.Registry r ← parameter.empty_registry()
        let parameter.Parameter a ← parameter.construct("a", "model", "f32", [1], [1.0])
        let parameter.Registry r2 ← parameter.add(r, a)
        assert r2.contains("model", "a")
        assert not r2.contains("model", "b")
        let parameter.Parameter found ← r2.find("model", "a")
        assert found.name() ≡ "a"
        assert found.owner() ≡ "model"
    }
    match trap_result_7 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "find fails closed on a miss" {
    let parameter.Registry r ← parameter.empty_registry()
    assert find_result(r, "model", "missing") ≡ "no parameter with that identity"
}

test "the same name under a different owner is a distinct identity" {
    let _ trap_result_8 ← trap {

        let parameter.Registry r ← parameter.empty_registry()
        let parameter.Parameter a ← parameter.construct("w", "m1", "f32", [1], [1.0])
        let parameter.Parameter b ← parameter.construct("w", "m2", "f32", [1], [2.0])
        let parameter.Registry r2 ← parameter.add(r, a)
        let parameter.Registry r3 ← parameter.add(r2, b)
        assert r3.count() ≡ 2
        assert r3.contains("m1", "w")
        assert r3.contains("m2", "w")
    }
    match trap_result_8 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "order yields trainable first, then frozen, preserving insertion order" {
    let _ trap_result_9 ← trap {

        let parameter.Registry r ← parameter.empty_registry()
        let parameter.Parameter a ← parameter.construct("a", "model", "f32", [1], [1.0])
        let parameter.Parameter b ← parameter.construct_frozen("b", "model", "f32", [1], [2.0])
        let parameter.Parameter c ← parameter.construct("c", "model", "f32", [1], [3.0])
        let parameter.Parameter d ← parameter.construct_frozen("d", "model", "f32", [1], [4.0])
        let parameter.Registry r1 ← parameter.add(r, a)
        let parameter.Registry r2 ← parameter.add(r1, b)
        let parameter.Registry r3 ← parameter.add(r2, c)
        let parameter.Registry r4 ← parameter.add(r3, d)
        assert r4.count() ≡ 4
        assert r4.trainable().length() ≡ 2
        assert r4.frozen().length() ≡ 2
        mut list<string> names ← empty
        for from r4.order() let p {
            names.append(p.name())
        }
        assert names ≡ (["a", "c", "b", "d"] ↦ list<string>)
        mut list<string> trainable ← empty
        for from r4.trainable() let p {
            trainable.append(p.name())
        }
        assert trainable ≡ (["a", "c"] ↦ list<string>)
        mut list<string> frozen ← empty
        for from r4.frozen() let p {
            frozen.append(p.name())
        }
        assert frozen ≡ (["b", "d"] ↦ list<string>)
    }
    match trap_result_9 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "tie gives two paths one update identity while independent copies stay independent" {
    let _ trap_result_tie ← trap {
        let parameter.Parameter shared ← parameter.construct("embedding", "model", "f32", [2], [1.0, 2.0])
        let parameter.Parameter decoder ← parameter.construct("decoder", "model", "f32", [2], [8.0, 9.0])
        let parameter.Parameter independent ← parameter.construct("copy", "model", "f32", [2], [1.0, 2.0])
        let parameter.Registry r0 ← parameter.empty_registry()
        let parameter.Registry r1 ← parameter.add(r0, shared)
        let parameter.Registry r2 ← parameter.add(r1, decoder)
        let parameter.Registry r3 ← parameter.add(r2, independent)
        let parameter.Registry tied ← r3.tie("model", "embedding", "model", "decoder")

        assert tied.count() ≡ 2
        assert tied.contains("model", "decoder")
        let parameter.Parameter through_shared ← tied.find("model", "embedding")
        let parameter.Parameter through_decoder ← tied.find("model", "decoder")
        assert through_shared.owner() ≡ "model"
        assert through_shared.name() ≡ "embedding"
        assert through_decoder.owner() ≡ "model"
        assert through_decoder.name() ≡ "embedding"
        assert through_decoder.version() ≡ through_shared.version()
        assert get_f32(through_decoder, 0) ≡ get_f32(through_shared, 0)

        let parameter.Registry changed_shared ← tied.replace("model", "decoder", [3.0, 4.0], 1)
        let parameter.Parameter alias_result ← changed_shared.find("model", "decoder")
        let parameter.Parameter canonical_result ← changed_shared.find("model", "embedding")
        assert alias_result.version() ≡ 2
        assert canonical_result.version() ≡ 2
        assert get_f32(alias_result, 0) ≡ 3.0 ∷ f32
        assert get_f32(canonical_result, 1) ≡ 4.0 ∷ f32
        assert replace_result(changed_shared, "model", "embedding", [7.0, 8.0], 1) ≡ "stale parameter version"

        let parameter.Registry changed_independent ← changed_shared.replace("model", "copy", [5.0, 6.0], 1)
        let parameter.Parameter independent_result ← changed_independent.find("model", "copy")
        let parameter.Parameter still_shared ← changed_independent.find("model", "embedding")
        assert independent_result.version() ≡ 2
        assert get_f32(independent_result, 0) ≡ 5.0 ∷ f32
        assert still_shared.version() ≡ 2
        assert get_f32(still_shared, 0) ≡ 3.0 ∷ f32
    }
    match trap_result_tie {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "tie rejects incompatible parameter shapes" {
    let _ trap_result_tie_shape ← trap {
        let parameter.Parameter a ← parameter.construct("a", "model", "f32", [2], [1.0, 2.0])
        let parameter.Parameter b ← parameter.construct("b", "model", "f32", [1], [1.0])
        let parameter.Registry r0 ← parameter.empty_registry()
        let parameter.Registry r1 ← parameter.add(r0, a)
        let parameter.Registry r2 ← parameter.add(r1, b)
        assert tie_result(r2, "model", "a", "model", "b") ≡ "tied parameters must match in dtype, shape, and trainability"
    }
    match trap_result_tie_shape {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "replace updates a registered payload and advances its version" {
    let _ trap_result_10 ← trap {
        let parameter.Registry r ← parameter.empty_registry()
        let parameter.Parameter p ← parameter.construct("weight", "model", "f32", [2], [1.0, 2.0])
        let parameter.Registry registered ← parameter.add(r, p)
        let parameter.Registry updated ← registered.replace("model", "weight", [5.0, 6.0], 1)
        let parameter.Parameter result ← updated.find("model", "weight")
        assert result.version() ≡ 2
        assert get_f32(result, 0) ≡ 5.0 ∷ f32
        assert get_f32(result, 1) ≡ 6.0 ∷ f32
        let parameter.Parameter original ← registered.find("model", "weight")
        assert original.version() ≡ 1
        assert get_f32(original, 0) ≡ 1.0 ∷ f32
    }
    match trap_result_10 {
        case returned let ? { }
        case thrown let ? { assert false }
    }
}

test "replace rejects an update based on a stale version" {
