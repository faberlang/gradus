# Parameter identity and traversal — PML1-U5 (parameter contract).
#
# Public import: importa ex "gradus:parameter" privata parametrum
# Depends on: gradus:dtype (DType tag, U2), gradus:shape (shape rules, U3),
# gradus:tensor (value carrier, U1). DAG: parameter → tensor → dtype → math.
#
# --- Contract ------------------------------------------------------------
#
# Schema: parameter-identity-schema-1.0.0 (stamped 2026-08-08, PML1-U5).
# The FULL parameter identity contract lives in this module — campaign rule:
# no parameter identity split across units. Value bytes are U7; identity is
# owned here and its serialization round-trips here.
#
# Identity = (nomen, typo, forma, versio, possessor). Fields:
#   nomen      — parameter name, unique within an owner (the module's
#                registry enforces (possessor, nomen) uniqueness).
#   typo       — element dtype (dtype.DType tag, U2). The public constructors
#                take the canonical dtype name textus (wire/name contract,
#                dtype.nomen) because the proba file-interface cannot import
#                exports carrying cross-module nominal parameter types
#                (WARN014); the stored identity carries the typed tag.
#   forma      — runtime dimension vector (U3 staged carrier); non-negative
#                dims, validated with shape.valet at construction.
#   versio     — mutation counter: starts at 1; every successful mutation
#                bumps it by 1. Identity fields (nomen/typo/forma/possessor)
#                are stable across mutation; only versio advances. Frozen
#                parameters never mutate, so their versio never bumps.
#   possessor  — owner path (e.g. "model.block0.linear.weight").
#
# Mutation rules:
#   * mutation replaces VALUES only — the identity's shape and dtype are
#     pinned by construction; muta takes the flat value list (the tensor's
#     movable form) and rebuilds the value against the pinned identity;
#   * mutating a frozen parameter fails closed (GelidaMutatio);
#   * a successful mutation bumps versio by 1;
#   * value-domain enforcement of the flat data is the dtype casta
#     contract (U2) — this module checks count/shape, not value ranges.
#
# Traversal:
#   * statio: Trainabilis (trainable) | Gelida (frozen);
#   * Registrum.ordo() yields trainable parameters FIRST (insertion order),
#     then frozen parameters (insertion order) — the trainable/frozen
#     traversal contract; trainabiles()/gelidae() expose each class.
#
# Serialization (identity wire form, versioned):
#   "parameter/identity/1.0.0/<possessor>/<nomen>/<dtype>/<versio>/<dim>/..."
#   Scalar shape [] contributes no trailing segments. Deserialization
#   rejects unknown marker/schema, malformed fields, unknown dtype names,
#   non-numeric version or dimensions — fail closed, no best-effort reads
#   (capsule rule). deserializa(serializa(i)) ≡ i by identitas_aequus.
#
# --- Compiler boundary notes (probed 2026-08-08) --------------------------
#
#   * The proba file-interface skips exports carrying cross-module nominal
#     parameter types (WARN014) — see the textus dtype-name constructor
#     seam above; this module's internal calls (dtype.ex_nomine,
#     tensor.structa_typo) are wrapped in fac/cape and re-thrown as typed
#     ParametrumError (same pattern as tensor.fab U1).
#   * Runtime proof is compile-level via faber check until the FMIR
#     stepper supports genus construction (recorded tensor.fab residual).
#
# --- Seams ---------------------------------------------------------------
#   * value bytes serialization + version rejection policy — U7.
#   * training/optimization consume parameters through this surface — U6.

importa ex "gradus:dtype" privata dtype
importa ex "gradus:shape" privata forma
importa ex "gradus:tensor" privata tensor

# -------------------------------------------------------------------------
# Schema constant — any change to identity fields, mutation rules, or the
# wire encoding is a schema bump; consumers reject unknown schema versions.
# -------------------------------------------------------------------------

fixum textus schema_versio ← "1.0.0"

# -------------------------------------------------------------------------
# Statio — parameter status. Trainable parameters may be mutated; frozen
# parameters reject mutation. Traversal orders trainable before frozen.
# -------------------------------------------------------------------------

discretio Statio {
    Trainabilis
    Gelida
}

# Canonical status name (textus surface for probes and consumers).
functio statio_nomen(Statio s) → textus {
    discerne s {
        casu Trainabilis { redde "trainable" }
        casu Gelida { redde "frozen" }
    }
}

# -------------------------------------------------------------------------
# ParametrumError — typed error vocabulary of the parameter contract.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------

discretio ParametrumError {
    NomenInane { textus causa },
    NomenReservatum { textus causa },
    TypoIgnotum { textus causa },
    FormaInvalida { textus causa },
    ElementaMismatch { textus causa },
    GelidaMutatio { textus causa },
    NomenDuplicatum { textus causa },
    NomenIgnotum { textus causa },
    VersioInvalida { textus causa },
    WireMala { textus causa }
}

functio causa(ParametrumError e) → textus {
    discerne e {
        casu NomenInane fixum causa { redde causa }
        casu NomenReservatum fixum causa { redde causa }
        casu TypoIgnotum fixum causa { redde causa }
        casu FormaInvalida fixum causa { redde causa }
        casu ElementaMismatch fixum causa { redde causa }
        casu GelidaMutatio fixum causa { redde causa }
        casu NomenDuplicatum fixum causa { redde causa }
        casu NomenIgnotum fixum causa { redde causa }
        casu VersioInvalida fixum causa { redde causa }
        casu WireMala fixum causa { redde causa }
    }
}

# -------------------------------------------------------------------------
# Identitas — explicit parameter identity. All five fields together are the
# identity contract; value mutation preserves four of them and bumps versio.
# -------------------------------------------------------------------------

genus Identitas {
    textus nomen
    dtype.DType typo
    lista<numerus> forma
    numerus versio
    textus possessor

    # Name. Nominal projection.
    functio nomen() → textus {
        redde ego.nomen
    }

    # Element dtype as the canonical dtype name (textus surface — the
    # typed tag is internal to the module; the name is the dtype contract).
    functio nomen_typi() → textus {
        redde dtype.nomen(ego.typo)
    }

    # Runtime shape (dimension vector).
    functio figura() → lista<numerus> {
        redde ego.forma
    }

    # Version (mutation counter).
    functio versio() → numerus {
        redde ego.versio
    }

    # Owner path.
    functio possessor() → textus {
        redde ego.possessor
    }
}

# Field-wise identity equality — the round-trip predicate of the identity
# serialization contract.
functio identitas_aequus(Identitas a, Identitas b) → bivalens {
    si a.nomen() ≠ b.nomen() ergo redde falsum
    si a.possessor() ≠ b.possessor() ergo redde falsum
    si a.versio() ≠ b.versio() ergo redde falsum
    si a.nomen_typi() ≠ b.nomen_typi() ergo redde falsum
    si non (a.figura() ≡ b.figura()) ergo redde falsum
    redde verum
}

# -------------------------------------------------------------------------
# Parametrum — one parameter: identity + status + value carrier (Tensor).
# -------------------------------------------------------------------------

genus Parametrum {
    Identitas identitas
    Statio statio
    tensor.Tensor valor

    # Identity record.
    functio identia() → Identitas {
        redde ego.identitas
    }

    # Status tag.
    functio statio() → Statio {
        redde ego.statio
    }

    # Name.
    functio nomen() → textus {
        redde ego.identitas.nomen
    }

    # Element dtype as the canonical dtype name.
    functio nomen_typi() → textus {
        redde dtype.nomen(ego.identitas.typo)
    }

    # Runtime shape (dimension vector).
    functio figura() → lista<numerus> {
        redde ego.identitas.forma
    }

    # Version (mutation counter).
    functio versio() → numerus {
        redde ego.identitas.versio
    }

    # Owner path.
    functio possessor() → textus {
        redde ego.identitas.possessor
    }

    # Element count (product of dimension sizes; [] → 1).
    functio quantitas() → numerus {
        varia numerus product ← 1
        itera ex ego.identitas.forma fixum dim {
            product ← product * dim
        }
        redde product
    }

    # Value carrier (the production tensor surface, U1).
    functio valor() → tensor.Tensor {
        redde ego.valor
    }
}

# -------------------------------------------------------------------------
# Status predicates — textus-safe status inspection (proba-visible; enum
# variants cannot be referenced across module boundaries, SEM001 note in
# dtype.fab).
# -------------------------------------------------------------------------

@ privata
functio _gelida(Statio s) → bivalens {
    discerne s {
        casu Gelida { redde verum }
        casu Trainabilis { redde falsum }
    }
}

functio est_trainabilis(Parametrum p) → bivalens {
    redde non (_gelida(p.statio()))
}

functio est_gelida(Parametrum p) → bivalens {
    redde _gelida(p.statio())
}

# -------------------------------------------------------------------------
# Construction. Public constructors take the dtype as its canonical name
# (WARN014 seam — see header); the stored identity carries the typed tag.
# Both validate fail-closed and return typed ParametrumError.
# -------------------------------------------------------------------------

# Shared construction: name/owner wire-safety, shape validity (U3), dtype
# name resolution (U2), then a validated tensor value (U1). versio starts
# at 1; the caller pins the status.
@ privata
functio _structum(textus nomen, textus possessor, textus typo_nomen, lista<numerus> dimensia, lista<f32> datos, Statio statio) → Parametrum ⇥ ParametrumError {
    si nomen.longitudo() ≡ 0 {
        iace finge NomenInane { causa = "empty parameter name" }
    }
    si possessor.longitudo() ≡ 0 {
        iace finge NomenInane { causa = "empty parameter owner" }
    }
    si _habeat_solidum(nomen) aut _habeat_solidum(possessor) {
        iace finge NomenReservatum { causa = "reserved wire character in name or owner" }
    }
    si non (forma.valet(dimensia)) {
        iace finge FormaInvalida { causa = "invalid shape" }
    }
    varia dtype.DType typo ← dtype.f32()
    fac {
        typo ← dtype.ex_nomine(typo_nomen)
    }
    cape err {
        iace finge TypoIgnotum { causa = dtype.causa(err) }
    }
    fac {
        fixum tensor.Tensor tv ← tensor.structa_typo(datos, dimensia, typo)
        redde Parametrum {
            identitas = Identitas { nomen = nomen, typo = typo, forma = dimensia, versio = 1, possessor = possessor },
            statio = statio,
            valor = tv
        }
    }
    cape err {
        iace finge ElementaMismatch { causa = tensor.causa(err) }
    }
    iace finge ElementaMismatch { causa = "unreachable" }
}

# Build a trainable parameter (default status).
functio structa(textus nomen, textus possessor, textus typo_nomen, lista<numerus> forma, lista<f32> datos) → Parametrum ⇥ ParametrumError {
    redde _structum(nomen, possessor, typo_nomen, forma, datos, finge Trainabilis)
}

# Build a frozen parameter (traversal-ordered after all trainable ones).
functio structa_gelida(textus nomen, textus possessor, textus typo_nomen, lista<numerus> forma, lista<f32> datos) → Parametrum ⇥ ParametrumError {
    redde _structum(nomen, possessor, typo_nomen, forma, datos, finge Gelida)
}

# -------------------------------------------------------------------------
# Mutation rules.
#   * values only — shape and dtype are pinned by identity;
#   * frozen parameters reject mutation (GelidaMutatio);
#   * a successful mutation bumps versio by 1.
# -------------------------------------------------------------------------

functio muta(Parametrum p, lista<f32> datos) → Parametrum ⇥ ParametrumError {
    si _gelida(p.statio()) {
        iace finge GelidaMutatio { causa = "frozen parameter cannot be mutated" }
    }
    fac {
        fixum tensor.Tensor novus ← tensor.structa_typo(datos, p.figura(), p.identitas.typo)
        redde Parametrum {
            identitas = Identitas {
                nomen = p.nomen(),
                typo = p.identitas.typo,
                forma = p.figura(),
                versio = p.versio() + 1,
                possessor = p.possessor()
            },
            statio = p.statio(),
            valor = novus
        }
    }
    cape err {
        iace finge ElementaMismatch { causa = tensor.causa(err) }
    }
    iace finge ElementaMismatch { causa = "unreachable" }
}

# -------------------------------------------------------------------------
# Registrum — parameter collection. Enforces (possessor, nomen) uniqueness
# and owns the traversal order contract: trainable first, then frozen,
# insertion order within each class.
# -------------------------------------------------------------------------

genus Registrum {
    lista<Parametrum> parametri

    # Parameter count.
    functio numerus() → numerus {
        redde ego.parametri.longitudo()
    }

    # Identity membership by (possessor, nomen).
    functio contineo(textus possessor, textus nomen) → bivalens {
        itera ex ego.parametri fixum p {
            si p.possessor() ≡ possessor et p.nomen() ≡ nomen ergo redde verum
        }
        redde falsum
    }

    # Identity resolution by (possessor, nomen) — fail closed on a miss.
    functio inveni(textus possessor, textus nomen) → Parametrum ⇥ ParametrumError {
        itera ex ego.parametri fixum p {
            si p.possessor() ≡ possessor et p.nomen() ≡ nomen ergo redde p
        }
        iace finge NomenIgnotum { causa = "no parameter with that identity" }
    }

    # Trainable parameters in insertion order.
    functio trainabiles() → lista<Parametrum> {
        varia lista<Parametrum> out ← vacua
        itera ex ego.parametri fixum p {
            si non (_gelida(p.statio())) {
                out.appende(p)
            }
        }
        redde out
    }

    # Frozen parameters in insertion order.
    functio gelidae() → lista<Parametrum> {
        varia lista<Parametrum> out ← vacua
        itera ex ego.parametri fixum p {
            si _gelida(p.statio()) {
                out.appende(p)
            }
        }
        redde out
    }

    # Traversal order: every trainable parameter first (insertion order),
    # then every frozen parameter (insertion order).
    functio ordo() → lista<Parametrum> {
        varia lista<Parametrum> out ← ego.trainabiles()
        itera ex ego.gelidae() fixum p {
            out.appende(p)
        }
        redde out
    }
}

# Empty registry.
functio registrum_vacuum() → Registrum {
    redde Registrum { parametri = vacua }
}

# Register a parameter. Rejects a duplicate (possessor, nomen) identity
# (NomenDuplicatum) — identity must resolve uniquely within an owner.
functio adscisco(Registrum r, Parametrum p) → Registrum ⇥ ParametrumError {
    si r.contineo(p.possessor(), p.nomen()) {
        iace finge NomenDuplicatum { causa = "parameter identity already registered" }
    }
    varia lista<Parametrum> nova ← r.parametri
    nova.appende(p)
    redde Registrum { parametri = nova }
}

# -------------------------------------------------------------------------
# Identity serialization — versioned wire form. Round-trips identity
# (deserializa(serializa(i)) ≡ i); rejects unknown schema, malformed
# fields, unknown dtype names, and non-numeric version/dimensions.
# Value bytes are U7 — identity carries no value data.
# -------------------------------------------------------------------------

# All-digits predicate for wire integer fields. Rejects empty, non-digit
# characters, and digit runs that could overflow numerus (i64 carrier).
@ privata
functio _digitum(textus c) → bivalens {
    redde c ≡ "0" aut c ≡ "1" aut c ≡ "2" aut c ≡ "3" aut c ≡ "4" aut c ≡ "5" aut c ≡ "6" aut c ≡ "7" aut c ≡ "8" aut c ≡ "9"
}

@ privata
functio _numerica(textus s) → bivalens {
    si s.longitudo() ≡ 0 ergo redde falsum
    si s.longitudo() > 18 ergo redde falsum
    varia numerus i ← 0
    dum i < s.longitudo() {
        si non (_digitum(s.accipe(i))) ergo redde falsum
        i ← i + 1
    }
    redde verum
}

# "/" is the wire segment separator — reserved in names and owners.
@ privata
functio _habeat_solidum(textus s) → bivalens {
    varia numerus i ← 0
    dum i < s.longitudo() {
        si s.accipe(i) ≡ "/" ergo redde verum
        i ← i + 1
    }
    redde falsum
}

functio serializa(Identitas i) → textus {
    varia textus out ← "parameter/identity/" + schema_versio + "/" + i.possessor() + "/" + i.nomen() + "/" + i.nomen_typi() + "/" + (i.versio() ↦ textus)
    itera ex i.figura() fixum dim {
        out ← out + "/" + (dim ↦ textus)
    }
    redde out
}

functio deserializa(textus s) → Identitas ⇥ ParametrumError {
    fixum lista<textus> partes ← s.divide("/")
    si partes.longitudo() < 7 {
        iace finge WireMala { causa = "malformed parameter identity" }
    }
    si partes.accipe(0) vel "" ≠ "parameter" {
        iace finge WireMala { causa = "unknown parameter marker" }
    }
    si partes.accipe(1) vel "" ≠ "identity" {
        iace finge WireMala { causa = "unknown identity marker" }
    }
    si partes.accipe(2) vel "" ≠ schema_versio {
        iace finge WireMala { causa = "unknown parameter schema version" }
    }
    fixum textus possessor ← partes.accipe(3) vel ""
    si possessor.longitudo() ≡ 0 {
        iace finge WireMala { causa = "empty owner in parameter identity" }
    }
    fixum textus nomen ← partes.accipe(4) vel ""
    si nomen.longitudo() ≡ 0 {
        iace finge WireMala { causa = "empty name in parameter identity" }
    }
    varia dtype.DType typo ← dtype.f32()
    fac {
        typo ← dtype.ex_nomine(partes.accipe(5) vel "")
    }
    cape err {
        iace finge TypoIgnotum { causa = dtype.causa(err) }
    }
    fixum textus versio_textus ← partes.accipe(6) vel ""
    si non (_numerica(versio_textus)) {
        iace finge VersioInvalida { causa = "malformed version in parameter identity" }
    }
    varia numerus versio ← 0
    fac {
        versio ← versio_textus ↦ numerus
    }
    cape err {
        iace finge VersioInvalida { causa = "malformed version in parameter identity" }
    }
    si versio < 1 {
        iace finge VersioInvalida { causa = "invalid version in parameter identity" }
    }
    varia lista<numerus> forma ← vacua
    varia numerus k ← 7
    dum k < partes.longitudo() {
        fixum textus dim_textus ← partes.accipe(k) vel ""
        si non (_numerica(dim_textus)) {
            iace finge WireMala { causa = "malformed dimension in parameter identity" }
        }
        fac {
            fixum numerus dim ← dim_textus ↦ numerus
            forma.appende(dim)
        }
        cape err {
            iace finge WireMala { causa = "malformed dimension in parameter identity" }
        }
        k ← k + 1
    }
    redde Identitas { nomen = nomen, typo = typo, forma = forma, versio = versio, possessor = possessor }
}
