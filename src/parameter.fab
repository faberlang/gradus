+++
locale = "en"
+++
# Parameter identity and traversal — PML1-U5 (parameter contract).
#
# Public import: importa ex "gradus:parameter" privata parametrum
# Depends on: gradus:dtype (DType tag, U2), gradus:shape (shape rules, U3),
# gradus:tensor (value carrier, U1). DAG: parameter → tensor → dtype → math.
#
# --- Contract ------------------------------------------------------------
#
# Schema: parameter-identity-schema-1.0.0 (stamped 2026-08-08, PML1-U5).
# The FULL parameter identity contract lives in this module — campaign rule:
# no parameter identity split across units. Value bytes are U7; identity is
# owned here and its serialization round-trips here.
#
# Identity = (nomen, typo, forma, versio, possessor). Fields:
#   nomen      — parameter name, unique within an owner (the module's
#                registry enforces (possessor, nomen) uniqueness).
#   typo       — element dtype (dtype.DType tag, U2). The public constructors
#                take the canonical dtype name textus (wire/name contract,
#                dtype.nomen) because the proba file-interface cannot import
#                exports carrying cross-module nominal parameter types
#                (WARN014); the stored identity carries the typed tag.
#   forma      — runtime dimension vector (U3 staged carrier); non-negative
#                dims, validated with shape.valet at construction.
#   versio     — mutation counter: starts at 1; every successful mutation
#                bumps it by 1. Identity fields (nomen/typo/forma/possessor)
#                are stable across mutation; only versio advances. Frozen
#                parameters never mutate, so their versio never bumps.
#   possessor  — owner path (e.g. "model.block0.linear.weight").
#
# Mutation rules:
#   * mutation replaces VALUES only — the identity's shape and dtype are
#     pinned by construction; muta takes the flat value list (the tensor's
#     movable form) and rebuilds the value against the pinned identity;
#   * mutating a frozen parameter fails closed (GelidaMutatio);
#   * a successful mutation bumps versio by 1;
#   * value-domain enforcement of the flat data is the dtype casta
#     contract (U2) — this module checks count/shape, not value ranges.
#
# Traversal:
#   * statio: Trainabilis (trainable) | Gelida (frozen);
#   * Registrum.ordo() yields trainable parameters FIRST (insertion order),
#     then frozen parameters (insertion order) — the trainable/frozen
#     traversal contract; trainabiles()/gelidae() expose each class.
#
# Serialization (identity wire form, versioned):
#   "parameter/identity/1.0.0/<possessor>/<nomen>/<dtype>/<versio>/<dim>/..."
#   Scalar shape [] contributes no trailing segments. Deserialization
#   rejects unknown marker/schema, malformed fields, unknown dtype names,
#   non-numeric version or dimensions — fail closed, no best-effort reads
#   (capsule rule). deserializa(serializa(i)) ≡ i by identitas_aequus.
#
# --- Compiler boundary notes (probed 2026-08-08) --------------------------
#
#   * The proba file-interface skips exports carrying cross-module nominal
#     parameter types (WARN014) — see the textus dtype-name constructor
#     seam above; this module's internal calls (dtype.ex_nomine,
#     tensor.structa_typo) are wrapped in fac/cape and re-thrown as typed
#     ParametrumError (same pattern as tensor.fab U1).
#   * Runtime proof is compile-level via faber check until the FMIR
#     stepper supports genus construction (recorded tensor.fab residual).
#
# --- Seams ---------------------------------------------------------------
#   * value bytes serialization + version rejection policy — U7.
#   * training/optimization consume parameters through this surface — U6.

import from "gradus:dtype" dtype

import from "gradus:shape" shape

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# Schema constant — any change to identity fields, mutation rules, or the
# wire encoding is a schema bump; consumers reject unknown schema versions.
# -------------------------------------------------------------------------

const string schema_versio ← "1.0.0"

# -------------------------------------------------------------------------
# Statio — parameter status. Trainable parameters may be mutated; frozen
# parameters reject mutation. Traversal orders trainable before frozen.
# -------------------------------------------------------------------------

union Station {
    Trainabilis,
    Gelida
}

# Canonical status name (textus surface for probes and consumers).
@ public { }
fn status_name(Station s) → string {
    match s {
        case Trainabilis {
            return "trainable"
        }
        case Gelida {
            return "frozen"
        }
    }
}

# -------------------------------------------------------------------------
# ParametrumError — typed error vocabulary of the parameter contract.
# Every variant carries a textus causa (render via causa).
# -------------------------------------------------------------------------



@ public { }
union ParameterError {
    NomenInane {
        string message
    },
    NomenReservatum {
        string message
    },
    TypoIgnotum {
        string message
    },
    FormaInvalida {
        string message
    },
    ElementaMismatch {
        string message
    },
    GelidaMutatio {
        string message
    },
    NomenDuplicatum {
        string message
    },
    NomenIgnotum {
        string message
    },
    VersioInvalida {
        string message
    },
    WireMala {
        string message
    }
}

@ public { }
fn message(ParameterError e) → string {
    match e {
        case NomenInane const message {
            return message
        }
        case NomenReservatum const message {
            return message
        }
        case TypoIgnotum const message {
            return message
        }
        case FormaInvalida const message {
            return message
        }
        case ElementaMismatch const message {
            return message
        }
        case GelidaMutatio const message {
            return message
        }
        case NomenDuplicatum const message {
            return message
        }
        case NomenIgnotum const message {
            return message
        }
        case VersioInvalida const message {
            return message
        }
        case WireMala const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# Identitas — explicit parameter identity. All five fields together are the
# identity contract; value mutation preserves four of them and bumps versio.
# -------------------------------------------------------------------------



@ public { }
class Identity {
    string name
    dtype.DType dtype
    list<int> shape
    int version
    string owner

    # Name. Nominal projection.
    fn name() → string {
        return self.name
    }

    # Element dtype as the canonical dtype name (textus surface — the
    # typed tag is internal to the module; the name is the dtype contract).
    fn dtype_name() → string {
        return dtype.name(self.dtype)
    }

    # Runtime shape (dimension vector).
    fn shape() → list<int> {
        return self.shape
    }

    # Version (mutation counter).
    fn version() → int {
        return self.version
    }

    # Owner path.
    fn owner() → string {
        return self.owner
    }
}

# Field-wise identity equality — the round-trip predicate of the identity
# serialization contract.
@ public { }
fn identity_equal(Identity a, Identity b) → bool {
    if a.name() ≠ b.name() then return false
    if a.owner() ≠ b.owner() then return false
    if a.version() ≠ b.version() then return false
    if a.dtype_name() ≠ b.dtype_name() then return false
    if not (a.shape() ≡ b.shape()) then return false
    return true
}

# -------------------------------------------------------------------------
# Parametrum — one parameter: identity + status + value carrier (Tensor).
# -------------------------------------------------------------------------



@ public { }
class Parameter {
    Identity identity
    Station status
    tensor.Tensor payload

    # Identity record.
    fn identity() → Identity {
        return self.identity
    }

    # Status tag.
    fn status() → Station {
        return self.status
    }

    # Name.
    fn name() → string {
        return self.identity.name
    }

    # Element dtype as the canonical dtype name.
    fn dtype_name() → string {
        return dtype.name(self.identity.dtype)
    }

    # Runtime shape (dimension vector).
    fn shape() → list<int> {
        return self.identity.shape
    }

    # Version (mutation counter).
    fn version() → int {
        return self.identity.version
    }

    # Owner path.
    fn owner() → string {
        return self.identity.owner
    }

    # Element count (product of dimension sizes; [] → 1).
    fn numel() → int {
        var int product ← 1
        for from self.identity.shape const dim {
            product ← product * dim
        }
        return product
    }

    # Value carrier (the production tensor surface, U1).
    fn payload() → tensor.Tensor {
        return self.payload
    }
}

# -------------------------------------------------------------------------
# Status predicates — textus-safe status inspection (proba-visible; enum
# variants cannot be referenced across module boundaries, SEM001 note in
# dtype.fab).
# -------------------------------------------------------------------------

@ private { }
fn _frozen(Station s) → bool {
    match s {
        case Gelida {
            return true
        }
        case Trainabilis {
            return false
        }
    }
}

@ public { }
fn is_trainable(Parameter p) → bool {
    return not _frozen(p.status())
}

@ public { }
fn is_frozen(Parameter p) → bool {
    return _frozen(p.status())
}

# -------------------------------------------------------------------------
# Construction. Public constructors take the dtype as its canonical name
# (WARN014 seam — see header); the stored identity carries the typed tag.
# Both validate fail-closed and return typed ParametrumError.
# -------------------------------------------------------------------------

# Shared construction: name/owner wire-safety, shape validity (U3), dtype
# name resolution (U2), then a validated tensor value (U1). versio starts
# at 1; the caller pins the status.
@ private { }
fn _construct(string name, string owner, string typo_nomen, list<int> dimensia, list<f32> datos, Station status) → Parameter ⇥ ParameterError {
    if name.length() ≡ 0 {
        throw variant NomenInane {message = "empty parameter name"}
    }
    if owner.length() ≡ 0 {
        throw variant NomenInane {message = "empty parameter owner"}
    }
    if _has_no_separator(name) or _has_no_separator(owner) {
        throw variant NomenReservatum {message = "reserved wire character in name or owner"}
    }
    if not shape.valid(dimensia) {
        throw variant FormaInvalida {message = "invalid shape"}
    }
    var dtype.DType typed ← dtype.f32()
    do {
        typed ← dtype.from_name(typo_nomen)
    }
    catch err {
        throw variant TypoIgnotum {message = dtype.message(err)}
    }
    do {
        const tensor.Tensor tv ← tensor.construct_dtype(datos, dimensia, typed)
        return Parameter {identity = Identity {name = name, dtype = typed, shape = dimensia, version = 1, owner = owner}, status = status, payload = tv}
    }
    catch err {
        throw variant ElementaMismatch {message = tensor.message(err)}
    }
    throw variant ElementaMismatch {message = "unreachable"}
}

# Build a trainable parameter (default status).
@ public { }
fn construct(string name, string owner, string typo_nomen, list<int> shape, list<f32> datos) → Parameter ⇥ ParameterError {
    return _construct(name, owner, typo_nomen, shape, datos, variant Trainabilis)
}

# Build a frozen parameter (traversal-ordered after all trainable ones).
@ public { }
fn construct_frozen(string name, string owner, string typo_nomen, list<int> shape, list<f32> datos) → Parameter ⇥ ParameterError {
    return _construct(name, owner, typo_nomen, shape, datos, variant Gelida)
}

# -------------------------------------------------------------------------
# Mutation rules.
#   * values only — shape and dtype are pinned by identity;
#   * frozen parameters reject mutation (GelidaMutatio);
#   * a successful mutation bumps versio by 1.
# -------------------------------------------------------------------------

@ public { }
fn mutate(Parameter p, list<f32> datos) → Parameter ⇥ ParameterError {
    if _frozen(p.status()) {
        throw variant GelidaMutatio {message = "frozen parameter cannot be mutated"}
    }
    do {
        const tensor.Tensor novus ← tensor.construct_dtype(datos, p.shape(), p.identity.dtype)
        return Parameter {identity = Identity {name = p.name(), dtype = p.identity.dtype, shape = p.shape(), version = p.version() + 1, owner = p.owner()}, status = p.status(), payload = novus}
    }
    catch err {
        throw variant ElementaMismatch {message = tensor.message(err)}
    }
    throw variant ElementaMismatch {message = "unreachable"}
}

# -------------------------------------------------------------------------
# Registrum — parameter collection. Enforces (possessor, nomen) uniqueness
# and owns the traversal order contract: trainable first, then frozen,
# insertion order within each class.
# -------------------------------------------------------------------------



@ public { }
class Registry {
    list<Parameter> parameters

    # Parameter count.
    fn count() → int {
        return self.parameters.length()
    }

    # Identity membership by (possessor, nomen).
    fn contains(string owner, string name) → bool {
        for from self.parameters const p {
            if p.owner() ≡ owner and p.name() ≡ name then return true
        }
        return false
    }

    # Identity resolution by (possessor, nomen) — fail closed on a miss.
    fn find(string owner, string name) → Parameter ⇥ ParameterError {
        for from self.parameters const p {
            if p.owner() ≡ owner and p.name() ≡ name then return p
        }
        throw variant NomenIgnotum {message = "no parameter with that identity"}
    }

    # Trainable parameters in insertion order.
    fn trainable() → list<Parameter> {
        var list<Parameter> out ← vacua
        for from self.parameters const p {
            if not _frozen(p.status()) {
                out.append(p)
            }
        }
        return out
    }

    # Frozen parameters in insertion order.
    fn frozen() → list<Parameter> {
        var list<Parameter> out ← vacua
        for from self.parameters const p {
            if _frozen(p.status()) {
                out.append(p)
            }
        }
        return out
    }

    # Traversal order: every trainable parameter first (insertion order),
    # then every frozen parameter (insertion order).
    fn order() → list<Parameter> {
        var list<Parameter> out ← self.trainable()
        for from self.frozen() const p {
            out.append(p)
        }
        return out
    }
}

# Empty registry.
@ public { }
fn empty_registry() → Registry {
    return Registry {parameters = vacua}
}

# Register a parameter. Rejects a duplicate (possessor, nomen) identity
# (NomenDuplicatum) — identity must resolve uniquely within an owner.
@ public { }
fn add(Registry r, Parameter p) → Registry ⇥ ParameterError {
    if r.contains(p.owner(), p.name()) {
        throw variant NomenDuplicatum {message = "parameter identity already registered"}
    }
    var list<Parameter> nova ← r.parameters
    nova.append(p)
    return Registry {parameters = nova}
}

# -------------------------------------------------------------------------
# Identity serialization — versioned wire form. Round-trips identity
# (deserializa(serializa(i)) ≡ i); rejects unknown schema, malformed
# fields, unknown dtype names, and non-numeric version/dimensions.
# Value bytes are U7 — identity carries no value data.
# -------------------------------------------------------------------------

# All-digits predicate for wire integer fields. Rejects empty, non-digit
# characters, and digit runs that could overflow numerus (i64 carrier).
@ private { }
fn _digit(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _digit(s.get(i)) then return false
        i ← i + 1
    }
    return true
}

# "/" is the wire segment separator — reserved in names and owners.
@ private { }
fn _has_no_separator(string s) → bool {
    var int i ← 0
    while i ≺ s.length() {
        if s.get(i) ≡ "/" then return true
        i ← i + 1
    }
    return false
}

@ public { }
fn serialize(Identity i) → string {
    var string out ← (((((((("parameter/identity/" + schema_versio) + "/") + i.owner()) + "/") + i.name()) + "/") + i.dtype_name()) + "/") + (i.version() ↦ string)
    for from i.shape() const dim {
        out ← (out + "/") + (dim ↦ string)
    }
    return out
}

@ public { }
fn deserialize(string s) → Identity ⇥ ParameterError {
    const list<string> partes ← s.split("/")
    if partes.length() ≺ 7 {
        throw variant WireMala {message = "malformed parameter identity"}
    }
    if partes.get(0) coalesce "" ≠ "parameter" {
        throw variant WireMala {message = "unknown parameter marker"}
    }
    if partes.get(1) coalesce "" ≠ "identity" {
        throw variant WireMala {message = "unknown identity marker"}
    }
    if partes.get(2) coalesce "" ≠ schema_versio {
        throw variant WireMala {message = "unknown parameter schema version"}
    }
    const string owner ← partes.get(3) coalesce ""
    if owner.length() ≡ 0 {
        throw variant WireMala {message = "empty owner in parameter identity"}
    }
    const string name ← partes.get(4) coalesce ""
    if name.length() ≡ 0 {
        throw variant WireMala {message = "empty name in parameter identity"}
    }
    var dtype.DType typed ← dtype.f32()
    do {
        typed ← dtype.from_name(partes.get(5) coalesce "")
    }
    catch err {
        throw variant TypoIgnotum {message = dtype.message(err)}
    }
    const string versio_textus ← partes.get(6) coalesce ""
    if not _numeric(versio_textus) {
        throw variant VersioInvalida {message = "malformed version in parameter identity"}
    }
    var int version ← 0
    do {
        version ← versio_textus ↦ int
    }
    catch err {
        throw variant VersioInvalida {message = "malformed version in parameter identity"}
    }
    if version ≺ 1 {
        throw variant VersioInvalida {message = "invalid version in parameter identity"}
    }
    var list<int> shape ← vacua
    var int k ← 7
    while k ≺ partes.length() {
        const string dim_textus ← partes.get(k) coalesce ""
        if not _numeric(dim_textus) {
            throw variant WireMala {message = "malformed dimension in parameter identity"}
        }
        do {
            const int dim ← dim_textus ↦ int
            shape.append(dim)
        }
        catch err {
            throw variant WireMala {message = "malformed dimension in parameter identity"}
        }
        k ← k + 1
    }
    return Identity {name = name, dtype = typed, shape = shape, version = version, owner = owner}
}
