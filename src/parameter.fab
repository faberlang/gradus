+++
locale = "en"
+++
# Parameter identity and traversal — PML1-U5 (parameter contract).
#
# Public import: import from "gradus:parameter" parameter
# Depends on: gradus:dtype (DType tag, U2), gradus:shape (shape rules, U3),
# gradus:tensor (value carrier, U1). DAG: parameter → tensor → dtype → math.
#
# --- Contract ------------------------------------------------------------
#
# Schema: parameter-identity-schema-1.0.0 (stamped 2026-08-08, PML1-U5).
# The FULL parameter identity contract lives in this module — campaign rule:
# no parameter identity split across units. Value bytes are U7; identity is
# owned here and its serialization round-trips here.
#
# Identity = (name, dtype, shape, version, owner). Fields:
#   name      — parameter name, unique within an owner (the module's
#                registry enforces (owner, name) uniqueness).
#   dtype       — element dtype (dtype.DType tag, U2). The public constructors
#                take the canonical dtype name text (wire/name contract,
#                dtype.name) because the proba file-interface cannot import
#                exports carrying cross-module nominal parameter types
#                (WARN014); the stored identity carries the typed tag.
#   shape      — runtime dimension vector (U3 staged carrier); non-negative
#                dims, validated with shape.valid at construction.
#   version     — mutation counter: starts at 1; every successful mutation
#                bumps it by 1. Identity fields (name/dtype/shape/owner)
#                are stable across mutation; only version advances. Frozen
#                parameters never mutate, so their version never bumps.
#   owner  — owner path (e.g. "model.block0.linear.weight").
#
# Mutation rules:
#   * mutation replaces VALUES only — the identity's shape and dtype are
#     pinned by construction; mutate takes the flat value list (the tensor's
#     movable form) and rebuilds the value against the pinned identity;
#   * mutating a frozen parameter fails closed (FrozenMutation);
#   * a successful mutation bumps version by 1;
#   * value-domain enforcement of the flat data is the dtype cast
#     contract (U2) — this module checks count/shape, not value ranges.
#
# Traversal:
#   * status: Trainable (trainable) | Frozen (frozen);
#   * Registrum.order() yields trainable parameters FIRST (insertion order),
#     then frozen parameters (insertion order) — the trainable/frozen
#     traversal contract; trainabiles()/frozen() expose each class.
#
# Serialization (identity wire form, versioned):
#   "parameter/identity/1.0.0/<owner>/<name>/<dtype>/<version>/<dim>/..."
#   Scalar shape [] contributes no trailing segments. Deserialization
#   rejects unknown marker/schema, malformed fields, unknown dtype names,
#   non-numeric version or dimensions — fail closed, no best-effort reads
#   (capsule rule). deserialize(serialize(i)) ≡ i by identity_equal.
#
# --- Compiler boundary notes (probed 2026-08-08) --------------------------
#
#   * The proba file-interface skips exports carrying cross-module nominal
#     parameter types (WARN014) — see the text dtype-name constructor
#     seam above; this module's internal calls (dtype.ex_nomine,
#     tensor.construct_dtype) are wrapped in fac/cape and re-thrown as typed
#     ParameterError (same pattern as tensor.fab U1).
#   * Runtime proof is compile-level via faber check until the FMIR
#     stepper supports genus construction (recorded tensor.fab residual).
#
# --- Seams ---------------------------------------------------------------
#   * value bytes serialization + version rejection policy — U7.
#   * training/optimization consume parameters through this surface — U6.

import from "gradus:dtype" dtype

import from "gradus:shape" shape

import from "gradus:tensor" tensor

# -------------------------------------------------------------------------
# Schema constant — any change to identity fields, mutation rules, or the
# wire encoding is a schema bump; consumers reject unknown schema versions.
# -------------------------------------------------------------------------

const string schema_version ← "1.0.0"

# -------------------------------------------------------------------------
# Station — parameter status. Trainable parameters may be mutated; frozen
# parameters reject mutation. Traversal orders trainable before frozen.
# -------------------------------------------------------------------------

union Station {
    Trainable,
    Frozen
}

# Canonical status name (text surface for probes and consumers).
@ public { }
fn status_name(Station s) → string {
    match s {
        case Trainable {
            return "trainable"
        }
        case Frozen {
            return "frozen"
        }
    }
}

# -------------------------------------------------------------------------
# ParameterError — typed error vocabulary of the parameter contract.
# Every variant carries a text message (render via message).
# -------------------------------------------------------------------------



@ public { }
union ParameterError {
    EmptyName {
        string message
    },
    ReservedName {
        string message
    },
    UnknownDtype {
        string message
    },
    InvalidShape {
        string message
    },
    ElementMismatch {
        string message
    },
    FrozenMutation {
        string message
    },
    DuplicateName {
        string message
    },
    UnknownName {
        string message
    },
    InvalidVersion {
        string message
    },
    BadWire {
        string message
    }
}

@ public { }
fn message(ParameterError e) → string {
    match e {
        case EmptyName const message {
            return message
        }
        case ReservedName const message {
            return message
        }
        case UnknownDtype const message {
            return message
        }
        case InvalidShape const message {
            return message
        }
        case ElementMismatch const message {
            return message
        }
        case FrozenMutation const message {
            return message
        }
        case DuplicateName const message {
            return message
        }
        case UnknownName const message {
            return message
        }
        case InvalidVersion const message {
            return message
        }
        case BadWire const message {
            return message
        }
    }
}

# -------------------------------------------------------------------------
# Identity — explicit parameter identity. All five fields together are the
# identity contract; value mutation preserves four of them and bumps version.
# -------------------------------------------------------------------------



@ public { }
class Identity {
    string name
    dtype.DType dtype
    list<int> shape
    int version
    string owner

    # Name. Nominal projection.
    fn name() → string {
        return self.name
    }

    # Element dtype as the canonical dtype name (text surface — the
    # typed tag is internal to the module; the name is the dtype contract).
    fn dtype_name() → string {
        return dtype.name(self.dtype)
    }

    # Runtime shape (dimension vector).
    fn shape() → list<int> {
        return self.shape
    }

    # Version (mutation counter).
    fn version() → int {
        return self.version
    }

    # Owner path.
    fn owner() → string {
        return self.owner
    }
}

# Field-wise identity equality — the round-trip predicate of the identity
# serialization contract.
@ public { }
fn identity_equal(Identity a, Identity b) → bool {
    if a.name() ≠ b.name() then return false
    if a.owner() ≠ b.owner() then return false
    if a.version() ≠ b.version() then return false
    if a.dtype_name() ≠ b.dtype_name() then return false
    if not (a.shape() ≡ b.shape()) then return false
    return true
}

# -------------------------------------------------------------------------
# Parameter — one parameter: identity + status + value carrier (Tensor).
# -------------------------------------------------------------------------



@ public { }
class Parameter {
    Identity identity
    Station status
    tensor.Tensor payload

    # Identity record.
    fn identity() → Identity {
        return self.identity
    }

    # Status tag.
    fn status() → Station {
        return self.status
    }

    # Name.
    fn name() → string {
        return self.identity.name
    }

    # Element dtype as the canonical dtype name.
    fn dtype_name() → string {
        return dtype.name(self.identity.dtype)
    }

    # Runtime shape (dimension vector).
    fn shape() → list<int> {
        return self.identity.shape
    }

    # Version (mutation counter).
    fn version() → int {
        return self.identity.version
    }

    # Owner path.
    fn owner() → string {
        return self.identity.owner
    }

    # Element count (product of dimension sizes; [] → 1).
    fn numel() → int {
        var int product ← 1
        for from self.identity.shape const dim {
            product ← product * dim
        }
        return product
    }

    # Value carrier (the production tensor surface, U1).
    fn payload() → tensor.Tensor {
        return self.payload
    }
}

# -------------------------------------------------------------------------
# Status predicates — text-safe status inspection (proba-visible; enum
# variants cannot be referenced across module boundaries, SEM001 note in
# dtype.fab).
# -------------------------------------------------------------------------

@ private { }
fn _frozen(Station s) → bool {
    match s {
        case Frozen {
            return true
        }
        case Trainable {
            return false
        }
    }
}

@ public { }
fn is_trainable(Parameter p) → bool {
    return not _frozen(p.status())
}

@ public { }
fn is_frozen(Parameter p) → bool {
    return _frozen(p.status())
}

# -------------------------------------------------------------------------
# Construction. Public constructors take the dtype as its canonical name
# (WARN014 seam — see header); the stored identity carries the typed tag.
# Both validate fail-closed and return typed ParameterError.
# -------------------------------------------------------------------------

# Shared construction: name/owner wire-safety, shape validity (U3), dtype
# name resolution (U2), then a validated tensor value (U1). version starts
# at 1; the caller pins the status.
@ private { }
fn _construct(string name, string owner, string dtype_name, list<int> shape, list<f32> data, Station status) → Parameter ⇥ ParameterError {
    if name.length() ≡ 0 {
        throw variant EmptyName {message = "empty parameter name"}
    }
    if owner.length() ≡ 0 {
        throw variant EmptyName {message = "empty parameter owner"}
    }
    if _has_no_separator(name) or _has_no_separator(owner) {
        throw variant ReservedName {message = "reserved wire character in name or owner"}
    }
    if not shape.valid(shape) {
        throw variant InvalidShape {message = "invalid shape"}
    }
    var dtype.DType typed ← dtype.f32()
    do {
        typed ← dtype.from_name(dtype_name)
    }
    catch err {
        throw variant UnknownDtype {message = dtype.message(err)}
    }
    do {
        const tensor.Tensor tv ← tensor.construct_dtype(data, shape, typed)
        return Parameter {identity = Identity {name = name, dtype = typed, shape = shape, version = 1, owner = owner}, status = status, payload = tv}
    }
    catch err {
        throw variant ElementMismatch {message = tensor.message(err)}
    }
    throw variant ElementMismatch {message = "unreachable"}
}

# Placeholder Default for `var Parameter` bindings (varia on structs).
# Empty identity and an empty staged payload; not a valid parameter.
@ public { }
fn default() → Parameter {
    return Parameter {identity = Identity {name = "", dtype = dtype.f32(), shape = [], version = 0, owner = ""}, status = variant Trainable, payload = tensor.default()}
}

# Build a trainable parameter (default status).
@ public { }
fn construct(string name, string owner, string dtype_name, list<int> shape, list<f32> data) → Parameter ⇥ ParameterError {
    return _construct(name, owner, dtype_name, shape, data, variant Trainable)
}

# Build a frozen parameter (traversal-ordered after all trainable ones).
@ public { }
fn construct_frozen(string name, string owner, string dtype_name, list<int> shape, list<f32> data) → Parameter ⇥ ParameterError {
    return _construct(name, owner, dtype_name, shape, data, variant Frozen)
}

# -------------------------------------------------------------------------
# Mutation rules.
#   * values only — shape and dtype are pinned by identity;
#   * frozen parameters reject mutation (FrozenMutation);
#   * a successful mutation bumps version by 1.
# -------------------------------------------------------------------------

@ public { }
fn mutate(Parameter p, list<f32> data) → Parameter ⇥ ParameterError {
    if _frozen(p.status()) {
        throw variant FrozenMutation {message = "frozen parameter cannot be mutated"}
    }
    do {
        const tensor.Tensor out ← tensor.construct_dtype(data, p.shape(), p.identity.dtype)
        return Parameter {identity = Identity {name = p.name(), dtype = p.identity.dtype, shape = p.shape(), version = p.version() + 1, owner = p.owner()}, status = p.status(), payload = out}
    }
    catch err {
        throw variant ElementMismatch {message = tensor.message(err)}
    }
    throw variant ElementMismatch {message = "unreachable"}
}

# -------------------------------------------------------------------------
# Registrum — parameter collection. Enforces (owner, name) uniqueness
# and owns the traversal order contract: trainable first, then frozen,
# insertion order within each class.
# -------------------------------------------------------------------------



@ public { }
class Registry {
    list<Parameter> parameters

    # Parameter count.
    fn count() → int {
        return self.parameters.length()
    }

    # Identity membership by (owner, name).
    fn contains(string owner, string name) → bool {
        for from self.parameters const p {
            if p.owner() ≡ owner and p.name() ≡ name then return true
        }
        return false
    }

    # Identity resolution by (owner, name) — fail closed on a miss.
    fn find(string owner, string name) → Parameter ⇥ ParameterError {
        for from self.parameters const p {
            if p.owner() ≡ owner and p.name() ≡ name then return p
        }
        throw variant UnknownName {message = "no parameter with that identity"}
    }

    # Trainable parameters in insertion order.
    fn trainable() → list<Parameter> {
        var list<Parameter> out ← empty
        for from self.parameters const p {
            if not _frozen(p.status()) {
                out.append(p)
            }
        }
        return out
    }

    # Frozen parameters in insertion order.
    fn frozen() → list<Parameter> {
        var list<Parameter> out ← empty
        for from self.parameters const p {
            if _frozen(p.status()) {
                out.append(p)
            }
        }
        return out
    }

    # Traversal order: every trainable parameter first (insertion order),
    # then every frozen parameter (insertion order).
    fn order() → list<Parameter> {
        var list<Parameter> out ← self.trainable()
        for from self.frozen() const p {
            out.append(p)
        }
        return out
    }
}

# Empty registry.
@ public { }
fn empty_registry() → Registry {
    return Registry {parameters = empty}
}

# Register a parameter. Rejects a duplicate (owner, name) identity
# (DuplicateName) — identity must resolve uniquely within an owner.
@ public { }
fn add(Registry r, Parameter p) → Registry ⇥ ParameterError {
    if r.contains(p.owner(), p.name()) {
        throw variant DuplicateName {message = "parameter identity already registered"}
    }
    var list<Parameter> next ← r.parameters
    next.append(p)
    return Registry {parameters = next}
}

# -------------------------------------------------------------------------
# Identity serialization — versioned wire form. Round-trips identity
# (deserialize(serialize(i)) ≡ i); rejects unknown schema, malformed
# fields, unknown dtype names, and non-numeric version/dimensions.
# Value bytes are U7 — identity carries no value data.
# -------------------------------------------------------------------------

# All-digits predicate for wire integer fields. Rejects empty, non-digit
# characters, and digit runs that could overflow count (i64 carrier).
@ private { }
fn _digit(string c) → bool {
    return ((((((((c ≡ "0" or c ≡ "1") or c ≡ "2") or c ≡ "3") or c ≡ "4") or c ≡ "5") or c ≡ "6") or c ≡ "7") or c ≡ "8") or c ≡ "9"
}

@ private { }
fn _numeric(string s) → bool {
    if s.length() ≡ 0 then return false
    if s.length() ≻ 18 then return false
    var int i ← 0
    while i ≺ s.length() {
        if not _digit(s.get(i)) then return false
        i ← i + 1
    }
    return true
}

# "/" is the wire segment separator — reserved in names and owners.
@ private { }
fn _has_no_separator(string s) → bool {
    var int i ← 0
    while i ≺ s.length() {
        if s.get(i) ≡ "/" then return true
        i ← i + 1
    }
    return false
}

@ public { }
fn serialize(Identity i) → string {
    var string out ← (((((((("parameter/identity/" + schema_version) + "/") + i.owner()) + "/") + i.name()) + "/") + i.dtype_name()) + "/") + (i.version() ↦ string)
    for from i.shape() const dim {
        out ← (out + "/") + (dim ↦ string)
    }
    return out
}

@ public { }
fn deserialize(string s) → Identity ⇥ ParameterError {
    const list<string> parts ← s.split("/")
    if parts.length() ≺ 7 {
        throw variant BadWire {message = "malformed parameter identity"}
    }
    if parts.get(0) coalesce "" ≠ "parameter" {
        throw variant BadWire {message = "unknown parameter marker"}
    }
    if parts.get(1) coalesce "" ≠ "identity" {
        throw variant BadWire {message = "unknown identity marker"}
    }
    if parts.get(2) coalesce "" ≠ schema_version {
        throw variant BadWire {message = "unknown parameter schema version"}
    }
    const string owner ← parts.get(3) coalesce ""
    if owner.length() ≡ 0 {
        throw variant BadWire {message = "empty owner in parameter identity"}
    }
    const string name ← parts.get(4) coalesce ""
    if name.length() ≡ 0 {
        throw variant BadWire {message = "empty name in parameter identity"}
    }
    var dtype.DType typed ← dtype.f32()
    do {
        typed ← dtype.from_name(parts.get(5) coalesce "")
    }
    catch err {
        throw variant UnknownDtype {message = dtype.message(err)}
    }
    const string version_text ← parts.get(6) coalesce ""
    if not _numeric(version_text) {
        throw variant InvalidVersion {message = "malformed version in parameter identity"}
    }
    var int version ← 0
    do {
        version ← version_text ↦ int
    }
    catch err {
        throw variant InvalidVersion {message = "malformed version in parameter identity"}
    }
    if version ≺ 1 {
        throw variant InvalidVersion {message = "invalid version in parameter identity"}
    }
    var list<int> shape ← empty
    var int k ← 7
    while k ≺ parts.length() {
        const string dim_text ← parts.get(k) coalesce ""
        if not _numeric(dim_text) {
            throw variant BadWire {message = "malformed dimension in parameter identity"}
        }
        do {
            const int dim ← dim_text ↦ int
            shape.append(dim)
        }
        catch err {
            throw variant BadWire {message = "malformed dimension in parameter identity"}
        }
        k ← k + 1
    }
    return Identity {name = name, dtype = typed, shape = shape, version = version, owner = owner}
}
