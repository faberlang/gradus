+++
locale = "en"
+++

# gradus/fixtures/safetensors/gen_fixture.fab — native-Faber generator for
# the pinned PML2-U2 Safetensors row fixture (NSM-Wave-2 G2 conversion of
# fixtures/safetensors/gen_fixture.py).
#
# Deterministic: writes smollm2-360m-scaled-row.safetensors byte-identical to
# the Python generator and to the proba reconstruction (safetensors.proba
# _contain / _header8 / _data_pattern). Byte identity is the pinned string
# constant below (EXPECTED_JSON must match safetensors.proba EXACTLY) —
# the header is never re-serialized through json.pange, whose map-key
# sorting would reorder the JSON and break the oracle hash.
#
# Execution surface: `faber run` on this file, launched through
# scripta/gen-fixture-safetensors; imports are norma:fs / norma:process (and
# norma:json where noted). Arguments: argv[0] = the gradus root (the launcher
# passes it; required, the program reads no environment), argv[1] = optional
# output directory, default <gradus-root>/fixtures/safetensors. Exit code: 0 on
# success, nonzero on any failure.

import from "norma:fs" fs
import from "norma:process" process
import from "norma:json" json

# The pinned header JSON — key order is part of the byte identity. This
# constant must match safetensors.proba/EXPECTED_JSON EXACTLY.
const string EXPECTED_JSON = «{"__metadata__":{"format.name":"safetensors","format.version":"1.0.0","model.arch":"llama","model.density":"dense","model.layers":"1","model.context":"2048","tokenizer.model":"gpt2","tokenizer.pre":"smollm","tokenizer.vocab_digest":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","tokenizer.eog":"0,2","tokenizer.bos_free":"true","tokenizer.space_prefix_free":"true"},"model.embed_tokens.weight":{"dtype":"F32","shape":[8,4],"data_offsets":[0,128]},"model.norm.weight":{"dtype":"F32","shape":[8],"data_offsets":[128,160]},"model.layers.0.self_attn.q_proj.weight":{"dtype":"F32","shape":[8,8],"data_offsets":[160,416]},"model.layers.0.self_attn.v_proj.weight":{"dtype":"F32","shape":[8,4],"data_offsets":[416,544]},"model.layers.0.mlp.down_proj.weight":{"dtype":"F32","shape":[4,8],"data_offsets":[544,672]}}»

const string FILE_NAME = "smollm2-360m-scaled-row.safetensors"
const int DATA_LENGTH = 672

# Append every byte of `piece` onto `acc` (a byte list has no concat verb).
fn append_bytes(list<b8> acc, list<b8> piece) → list<b8> {
    mut list<b8> out ← ||
    for from acc let a {
        out.append(a)
    }
    mut int i ← 0
    while i ≺ piece.length() {
        let b8 ∪ none b ← piece.get(i)
        if b not is none {
            out.append(b coalesce (0 ∷ b8))
        }
        i ← i + 1
    }
    return out
}

# 8-byte little-endian prefix. The `% 256` masks keep each shift inside the
# u8 carrier (the stepper range-checks the ↦ int<u8> cast).
fn le8(int n) → list<b8> {
    mut list<b8> out ← ||
    out.append((n ⇒ 0) % 256 ↦ b8)
    out.append((n ⇒ 8) % 256 ↦ b8)
    out.append((n ⇒ 16) % 256 ↦ b8)
    out.append((n ⇒ 24) % 256 ↦ b8)
    out.append((n ⇒ 32) % 256 ↦ b8)
    out.append((n ⇒ 40) % 256 ↦ b8)
    out.append((n ⇒ 48) % 256 ↦ b8)
    out.append((n ⇒ 56) % 256 ↦ b8)
    return out
}

# Deterministic data-byte pattern (matches the Python generator): byte i =
# (i*13 + 7) mod 256.
fn data_pattern(int n) → list<b8> {
    mut list<b8> out ← ||
    mut int i ← 0
    while i ≺ n {
        out.append(((i * 13 + 7) % 256) ↦ b8)
        i ← i + 1
    }
    return out
}

# Assemble the Safetensors container: 8-byte LE N (the JSON-only header
# length, excluding the prefix), the JSON header padded with spaces to
# 8-alignment, and the 672-byte data region (mirror of safetensors.proba
# _contain).
fn contain() → list<b8> {
    mut list<b8> padded ← EXPECTED_JSON ↦ list<b8>
    let int n ← padded.length()
    let int aligned ← ((n + 7) / 8) * 8
    mut int i ← n
    while i ≺ aligned {
        padded.append(32 ∷ b8)
        i ← i + 1
    }
    let int header ← aligned
    let list<b8> prefix ← le8(header)
    let list<b8> data ← data_pattern(DATA_LENGTH)
    let list<b8> blob ← append_bytes(prefix, padded)
    return append_bytes(blob, data)
}

main {
    # Form gate: the pinned header string must parse as JSON (faber:json
    # surface; byte identity is the string itself, never a re-serialize).
    let value v ← json.try_parse(EXPECTED_JSON) ↦ value
    if v not is none {
        print "gen-fixture-safetensors: pinned header parses as JSON"
    }
    else {
        panic "gen-fixture-safetensors: pinned header is not valid JSON"
    }
    let list<string> args ← process.argv() ↦ list<string>
    if args.length() ≺ 1 {
        panic "gen-fixture-safetensors: usage: gen_fixture.fab -- <gradus-root> [out-dir]"
    }
    let string root ← args.get(0) coalesce ""
    mut string out_dir ← ""
    if args.length() ≻ 1 {
        out_dir ← args.get(1) coalesce ""
    }
    else {
        out_dir ← fs.join([root, "fixtures", "safetensors"]) ↦ string
    }
    fs.create_dir(out_dir)
    let string target ← fs.join([out_dir, FILE_NAME]) ↦ string
    let list<b8> blob ← contain()
    fs.write_bytes(target, blob)
    print "wrote § (§ bytes)"(target, blob.length() ↦ string)
    # SHA-256 is host-computed (the language surface has no digest
    # primitive); print it when shasum is available, mirroring the Python
    # generator's output.
    let list<string> cmd ← ["shasum", "-a", "256", target]
    let map<string, value> res ← process.capture(cmd) ↦ map<string, value>
    let int status ← res["status"] ↦ int
    if status ≡ 0 {
        let string out ← res["stdout"] ↦ string
        let list<string> parts ← out.split(" ")
        print "sha256 = §"(parts.get(0) coalesce "")
    }
    let list<b8> hb ← EXPECTED_JSON ↦ list<b8>
    print "header_size = §"(((hb.length() + 7) / 8) * 8 ↦ string)
    print "header json len = §"(hb.length() ↦ string)
}
