+++
locale = "en"
+++

# gradus/fixtures/safetensors/gen_fixture.fab — native-Faber generator for
# the pinned PML2-U2 Safetensors row fixture (NSM-Wave-2 G2 conversion of
# fixtures/safetensors/gen_fixture.py).
#
# Deterministic: writes smollm2-360m-scaled-row.safetensors byte-identical to
# the Python generator and to the proba reconstruction (safetensors.proba
# _continer / _caput8 / _data_pattern). Byte identity is the pinned string
# constant below (PRAESTOLATUM_JSON must match safetensors.proba EXACTLY) —
# the header is never re-serialized through json.pange, whose map-key
# sorting would reorder the JSON and break the oracle hash.
#
# Execution surface (pinned): the released faber binary
# (faber/target/debug/faber, 1.6.0-rc.1) via `faber script`, launched through
# scripta/gen-fixture-safetensors (which stages this source outside the
# gradus package — an in-tree path routes to package mode and rejects the
# faber:* kernel imports with PKG001). The PATH `faber` (1.3.0) is never a
# valid execution surface. Optional argv[1] overrides the output directory;
# the default is <gradus-root>/fixtures/safetensors (mirrors the Python
# default of Path(__file__).parent). Exit code: 0 on success, 1 on any
# failure (same contract as the Python generator's uncaught-exception exit).

importa ex "faber:solum" privata solum
importa ex "faber:processus" privata processus
importa ex "faber:json" privata json

# The pinned header JSON — key order is part of the byte identity. This
# constant must match safetensors.proba/PRAESTOLATUM_JSON EXACTLY.
fixum textus PRAESTOLATUM_JSON ← "{\"__metadata__\":{\"format.name\":\"safetensors\",\"format.version\":\"1.0.0\",\"model.arch\":\"llama\",\"model.density\":\"dense\",\"model.layers\":\"1\",\"model.context\":\"2048\",\"tokenizer.model\":\"gpt2\",\"tokenizer.pre\":\"smollm\",\"tokenizer.vocab_digest\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"tokenizer.eog\":\"0,2\",\"tokenizer.bos_free\":\"true\",\"tokenizer.space_prefix_free\":\"true\"},\"model.embed_tokens.weight\":{\"dtype\":\"F32\",\"shape\":[8,4],\"data_offsets\":[0,128]},\"model.norm.weight\":{\"dtype\":\"F32\",\"shape\":[8],\"data_offsets\":[128,160]},\"model.layers.0.self_attn.q_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,8],\"data_offsets\":[160,416]},\"model.layers.0.self_attn.v_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,4],\"data_offsets\":[416,544]},\"model.layers.0.mlp.down_proj.weight\":{\"dtype\":\"F32\",\"shape\":[4,8],\"data_offsets\":[544,672]}}"

fixum textus NOMEN_FASCICULI ← "smollm2-360m-scaled-row.safetensors"
fixum numerus DATA_LONGITUDO ← 672

# Resolve the gradus repository root: FABER_LIBRARY_HOME when set, else the
# workspace layout probed from the current directory (the launcher cd's to
# the gradus root, so processus.sedes() lands there).
functio gradus_root() → textus {
    fixum textus home ← processus.exsequi("printf %s \"${FABER_LIBRARY_HOME:-}\"") ↦ textus
    si home.longitudo() ↦ numerus > 0 {
        fixum textus from_home ← solum.iunge([home, "gradus"]) ↦ textus
        si solum.exstat(solum.iunge([from_home, "src"]) ↦ textus) ↦ bivalens {
            redde solum.absolve(from_home) ↦ textus
        }
    }
    fixum textus cwd ← processus.sedes() ↦ textus
    si solum.exstat(solum.iunge([cwd, "gradus", "src"]) ↦ textus) ↦ bivalens {
        redde solum.absolve(solum.iunge([cwd, "gradus"]) ↦ textus) ↦ textus
    }
    si solum.exstat(solum.iunge([cwd, "src"]) ↦ textus) ↦ bivalens {
        redde solum.absolve(cwd) ↦ textus
    }
    mori "gen-fixture-safetensors: cannot resolve the gradus root (set FABER_LIBRARY_HOME or run from the faberlang workspace)"
}

# Append every byte of `piece` onto `acc` (octeti has no concat verb).
functio appende_octeti(octeti acc, octeti piece) → octeti {
    varia numerus i ← 0
    dum i < piece.longitudo() {
        fixum numerus<u8> ∪ nihil b ← piece.accipe(i)
        si b non est nihil {
            acc.appende(b vel (0 ∷ numerus<u8>))
        }
        i ← i + 1
    }
    redde acc
}

# 8-byte little-endian prefix. The `% 256` masks keep each shift inside the
# u8 carrier (the stepper range-checks the ↦ numerus<u8> cast).
functio le8(numerus n) → octeti {
    varia octeti out ← ||
    out.appende((n ⇒ 0) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 8) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 16) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 24) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 32) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 40) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 48) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 56) % 256 ↦ numerus<u8>)
    redde out
}

# Deterministic data-byte pattern (matches the Python generator): byte i =
# (i*13 + 7) mod 256.
functio data_pattern(numerus n) → octeti {
    varia octeti out ← ||
    varia numerus i ← 0
    dum i < n {
        out.appende(((i * 13 + 7) % 256) ↦ numerus<u8>)
        i ← i + 1
    }
    redde out
}

# Assemble the Safetensors container: 8-byte LE header_size (which includes
# the prefix), the JSON header padded with spaces to 8-alignment, and the
# 672-byte data region (mirror of safetensors.proba _continer).
functio continer() → octeti {
    fixum octeti hb ← PRAESTOLATUM_JSON ↦ octeti
    fixum numerus n ← hb.longitudo()
    fixum numerus aligned ← ((n + 7) / 8) * 8
    varia octeti padded ← hb
    varia numerus i ← n
    dum i < aligned {
        padded.appende(32 ↦ numerus<u8>)
        i ← i + 1
    }
    fixum numerus caput ← aligned + 8
    fixum octeti prefix ← le8(caput)
    fixum octeti data ← data_pattern(DATA_LONGITUDO)
    fixum octeti blob ← appende_octeti(prefix, padded)
    redde appende_octeti(blob, data)
}

incipit {
    # Form gate: the pinned header string must parse as JSON (faber:json
    # surface; byte identity is the string itself, never a re-serialize).
    fixum valor v ← json.tempta(PRAESTOLATUM_JSON) ↦ valor
    si v non est nihil {
        nota "gen-fixture-safetensors: pinned header parses as JSON"
    }
    secus {
        mori "gen-fixture-safetensors: pinned header is not valid JSON"
    }
    # Output directory: argv[1] override, else <gradus-root>/fixtures/safetensors.
    fixum lista<textus> args ← processus.argumenta() ↦ lista<textus>
    varia textus out_dir ← ""
    si args.longitudo() > 0 {
        out_dir ← args.accipe(0) vel ""
    }
    secus {
        out_dir ← solum.iunge([gradus_root(), "fixtures", "safetensors"]) ↦ textus
    }
    solum.crea(out_dir)
    fixum textus target ← solum.iunge([out_dir, NOMEN_FASCICULI]) ↦ textus
    fixum octeti blob ← continer()
    solum.funde(target, blob)
    nota "wrote § (§ bytes)"(target, blob.longitudo() ↦ textus)
    # SHA-256 is host-computed (the language surface has no digest
    # primitive); print it when shasum is available, mirroring the Python
    # generator's output.
    fixum lista<textus> cmd ← ["shasum", "-a", "256", target]
    fixum tabula<textus, valor> res ← processus.captura(cmd) ↦ tabula<textus, valor>
    fixum numerus status ← res["status"] ↦ numerus
    si status ≡ 0 {
        fixum textus out ← res["stdout"] ↦ textus
        fixum lista<textus> parts ← out.divide(" ")
        nota "sha256 = §"(parts.accipe(0) vel "")
    }
    fixum octeti hb ← PRAESTOLATUM_JSON ↦ octeti
    nota "header_size = §"(((hb.longitudo() + 7) / 8) * 8 + 8 ↦ textus)
    nota "header json len = §"(hb.longitudo() ↦ textus)
}
