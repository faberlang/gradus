+++
locale = "en"
+++

# gradus/fixtures/safetensors/gen_fixture.fab — native-Faber generator for
# the pinned PML2-U2 Safetensors row fixture (NSM-Wave-2 G2 conversion of
# fixtures/safetensors/gen_fixture.py).
#
# Deterministic: writes smollm2-360m-scaled-row.safetensors byte-identical to
# the Python generator and to the proba reconstruction (safetensors.proba
# _contain / _header8 / _data_pattern). Byte identity is the pinned string
# constant below (EXPECTED_JSON must match safetensors.proba EXACTLY) —
# the header is never re-serialized through json.pange, whose map-key
# sorting would reorder the JSON and break the oracle hash.
#
# Execution surface (pinned): the released faber binary
# (faber/target/debug/faber, 1.6.0-rc.1) via `faber script`, launched through
# scripta/gen-fixture-safetensors (which stages this source outside the
# gradus package — an in-tree path routes to package mode and rejects the
# faber:* kernel imports with PKG001). The PATH `faber` (1.3.0) is never a
# valid execution surface. Optional argv[1] overrides the output directory;
# the default is <gradus-root>/fixtures/safetensors (mirrors the Python
# default of Path(__file__).parent). Exit code: 0 on success, 1 on any
# failure (same contract as the Python generator's uncaught-exception exit).

import from "faber:solum" solum
import from "faber:processus" processus
import from "faber:json" json

# The pinned header JSON — key order is part of the byte identity. This
# constant must match safetensors.proba/EXPECTED_JSON EXACTLY.
const string EXPECTED_JSON ← "{\"__metadata__\":{\"format.name\":\"safetensors\",\"format.version\":\"1.0.0\",\"model.arch\":\"llama\",\"model.density\":\"dense\",\"model.layers\":\"1\",\"model.context\":\"2048\",\"tokenizer.model\":\"gpt2\",\"tokenizer.pre\":\"smollm\",\"tokenizer.vocab_digest\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"tokenizer.eog\":\"0,2\",\"tokenizer.bos_free\":\"true\",\"tokenizer.space_prefix_free\":\"true\"},\"model.embed_tokens.weight\":{\"dtype\":\"F32\",\"shape\":[8,4],\"data_offsets\":[0,128]},\"model.norm.weight\":{\"dtype\":\"F32\",\"shape\":[8],\"data_offsets\":[128,160]},\"model.layers.0.self_attn.q_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,8],\"data_offsets\":[160,416]},\"model.layers.0.self_attn.v_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,4],\"data_offsets\":[416,544]},\"model.layers.0.mlp.down_proj.weight\":{\"dtype\":\"F32\",\"shape\":[4,8],\"data_offsets\":[544,672]}}"

const string FILE_NAME ← "smollm2-360m-scaled-row.safetensors"
const int DATA_LENGTH ← 672

# Resolve the gradus repository root: FABER_LIBRARY_HOME when set, else the
# workspace layout probed from the current directory (the launcher cd's to
# the gradus root, so processus.cwd() lands there).
fn gradus_root() → string {
    const string home ← processus.exec("printf %s \"${FABER_LIBRARY_HOME:-}\"") ↦ string
    if home.length() ↦ int > 0 {
        const string from_home ← solum.join([home, "gradus"]) ↦ string
        if solum.exists(solum.join([from_home, "src"]) ↦ string) ↦ bool {
            return solum.resolve(from_home) ↦ string
        }
    }
    const string cwd ← processus.cwd() ↦ string
    if solum.exists(solum.join([cwd, "gradus", "src"]) ↦ string) ↦ bool {
        return solum.resolve(solum.join([cwd, "gradus"]) ↦ string) ↦ string
    }
    if solum.exists(solum.join([cwd, "src"]) ↦ string) ↦ bool {
        return solum.resolve(cwd) ↦ string
    }
    panic "gen-fixture-safetensors: cannot resolve the gradus root (set FABER_LIBRARY_HOME or run from the faberlang workspace)"
}

# Append every byte of `piece` onto `acc` (bytes has no concat verb).
fn append_bytes(bytes acc, bytes piece) → bytes {
    var int i ← 0
    while i < piece.length() {
        const int<u8> ∪ null b ← piece.get(i)
        if b not is null {
            acc.append(b coalesce (0 ∷ int<u8>))
        }
        i ← i + 1
    }
    return acc
}

# 8-byte little-endian prefix. The `% 256` masks keep each shift inside the
# u8 carrier (the stepper range-checks the ↦ int<u8> cast).
fn le8(int n) → bytes {
    var bytes out ← ||
    out.append((n ⇒ 0) % 256 ↦ int<u8>)
    out.append((n ⇒ 8) % 256 ↦ int<u8>)
    out.append((n ⇒ 16) % 256 ↦ int<u8>)
    out.append((n ⇒ 24) % 256 ↦ int<u8>)
    out.append((n ⇒ 32) % 256 ↦ int<u8>)
    out.append((n ⇒ 40) % 256 ↦ int<u8>)
    out.append((n ⇒ 48) % 256 ↦ int<u8>)
    out.append((n ⇒ 56) % 256 ↦ int<u8>)
    return out
}

# Deterministic data-byte pattern (matches the Python generator): byte i =
# (i*13 + 7) mod 256.
fn data_pattern(int n) → bytes {
    var bytes out ← ||
    var int i ← 0
    while i < n {
        out.append(((i * 13 + 7) % 256) ↦ int<u8>)
        i ← i + 1
    }
    return out
}

# Assemble the Safetensors container: 8-byte LE header_size (which includes
# the prefix), the JSON header padded with spaces to 8-alignment, and the
# 672-byte data region (mirror of safetensors.proba _contain).
fn contain() → bytes {
    const bytes hb ← EXPECTED_JSON ↦ bytes
    const int n ← hb.length()
    const int aligned ← ((n + 7) / 8) * 8
    var bytes padded ← hb
    var int i ← n
    while i < aligned {
        padded.append(32 ↦ int<u8>)
        i ← i + 1
    }
    const int header ← aligned + 8
    const bytes prefix ← le8(header)
    const bytes data ← data_pattern(DATA_LENGTH)
    const bytes blob ← append_bytes(prefix, padded)
    return append_bytes(blob, data)
}

main {
    # Form gate: the pinned header string must parse as JSON (faber:json
    # surface; byte identity is the string itself, never a re-serialize).
    const value v ← json.try_parse(EXPECTED_JSON) ↦ value
    if v not is null {
        print "gen-fixture-safetensors: pinned header parses as JSON"
    }
    else {
        panic "gen-fixture-safetensors: pinned header is not valid JSON"
    }
    # Output directory: argv[1] override, else <gradus-root>/fixtures/safetensors.
    const list<string> args ← processus.argv() ↦ list<string>
    var string out_dir ← ""
    if args.length() > 0 {
        out_dir ← args.get(0) coalesce ""
    }
    else {
        out_dir ← solum.join([gradus_root(), "fixtures", "safetensors"]) ↦ string
    }
    solum.create_dir(out_dir)
    const string target ← solum.join([out_dir, FILE_NAME]) ↦ string
    const bytes blob ← contain()
    solum.write_bytes(target, blob)
    print "wrote § (§ bytes)"(target, blob.length() ↦ string)
    # SHA-256 is host-computed (the language surface has no digest
    # primitive); print it when shasum is available, mirroring the Python
    # generator's output.
    const list<string> cmd ← ["shasum", "-a", "256", target]
    const map<string, value> res ← processus.captura(cmd) ↦ map<string, value>
    const int status ← res["status"] ↦ int
    if status ≡ 0 {
        const string out ← res["stdout"] ↦ string
        const list<string> parts ← out.split(" ")
        print "sha256 = §"(parts.get(0) coalesce "")
    }
    const bytes hb ← EXPECTED_JSON ↦ bytes
    print "header_size = §"(((hb.length() + 7) / 8) * 8 + 8 ↦ string)
    print "header json len = §"(hb.length() ↦ string)
}
