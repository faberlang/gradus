+++
locale = "en"
+++

# gradus/fixtures/gguf/gen_fixture.fab — native-Faber generator for the
# pinned PML2-U3 GGUF row fixture (NSM-Wave-2 G2 conversion of
# fixtures/gguf/gen_fixture.py).
#
# Deterministic: writes smollm2-360m-scaled-row.gguf byte-identical to the
# Python generator and to the proba reconstruction (gguf.proba build /
# kv_code / code_tensor / tensor_extent / magic). The GGUF v3 layout
# mirrors the pinned toolchain (llama.cpp a957b7747 / gguf-py): "GGUF" magic,
# u32 version 3, u64 tensor/kv counts, metadata KVs, tensor-info table with
# offsets relative to the data-section start, then the data section at
# align32(table end) with the deterministic (k*13 + 7) mod 256 byte pattern.
#
# Execution surface (pinned): the released faber binary
# (faber/target/debug/faber, 1.6.0-rc.1) via `faber script`, launched through
# scripta/gen-fixture-gguf (which stages this source outside the gradus
# package — an in-tree path routes to package mode and rejects the faber:*
# kernel imports with PKG001). The PATH `faber` (1.3.0) is never a valid
# execution surface. Optional argv[1] overrides the output directory; the
# default is <gradus-root>/fixtures/gguf (the Python wrote to the CWD; the
# launcher fixes the CWD at the repo root, so the fixtures dir is the
# byte-stable default that keeps the committed row in place). Exit code:
# 0 on success, 1 on any failure (same contract as the Python generator's
# uncaught-exception exit).

import from "faber:solum" solum
import from "faber:processus" processus

# KV codec: "key;type;value" (type s=string, u=u32, b=bool, as=array of
# string). Order matters — must match gguf.proba LEGAL_KVS exactly.
const list<string> LEGAL_KVS ← [
    "general.architecture;s;llama",
    "general.file_type;u;15",
    "general.quantization_version;u;2",
    "llama.block_count;u;32",
    "llama.context_length;u;8192",
    "llama.vocab_size;u;49152",
    "llama.embedding_length;u;960",
    "tokenizer.ggml.model;s;gpt2",
    "tokenizer.ggml.pre;s;smollm",
    "tokenizer.ggml.bos_token_id;u;1",
    "tokenizer.ggml.eos_token_id;u;2",
    "tokenizer.ggml.padding_token_id;u;2",
    "tokenizer.ggml.unknown_token_id;u;0",
    "tokenizer.ggml.add_bos_token;b;0",
    "tokenizer.ggml.add_space_prefix;b;0",
    "general.name;s;smollm2-fixture",
    "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM",
    "general.languages;as;en"
]

# Tensor codec: "name;type;d1,d2;offset" (offset auto = cumulative relative
# to the data-section start). Q8_0 [32,16] = 544 B; F32 [16] = 64 B;
# Q4_K [256,16] = 2304 B; total 2912 B, every size a 32-multiple.
const list<string> LEGAL_TENSORS ← [
    "token_embd.weight;8;32,16;auto",
    "blk.0.attn_norm.weight;0;16;auto",
    "blk.0.ffn_down.weight;12;256,16;auto"
]

const string FILE_NAME ← "smollm2-360m-scaled-row.gguf"

# Resolve the gradus repository root: FABER_LIBRARY_HOME when set, else the
# workspace layout probed from the current directory (the launcher cd's to
# the gradus root, so processus.cwd() lands there).
fn gradus_root() → string {
    const string home ← processus.exec("printf %s \"${FABER_LIBRARY_HOME:-}\"") ↦ string
    if home.length() ↦ int > 0 {
        const string from_home ← solum.join([home, "gradus"]) ↦ string
        if solum.exists(solum.join([from_home, "src"]) ↦ string) ↦ bool {
            return solum.resolve(from_home) ↦ string
        }
    }
    const string cwd ← processus.cwd() ↦ string
    if solum.exists(solum.join([cwd, "gradus", "src"]) ↦ string) ↦ bool {
        return solum.resolve(solum.join([cwd, "gradus"]) ↦ string) ↦ string
    }
    if solum.exists(solum.join([cwd, "src"]) ↦ string) ↦ bool {
        return solum.resolve(cwd) ↦ string
    }
    panic "gen-fixture-gguf: cannot resolve the gradus root (set FABER_LIBRARY_HOME or run from the faberlang workspace)"
}

# Append every byte of `piece` onto `acc` (bytes has no concat verb).
fn append_bytes(bytes acc, bytes piece) → bytes {
    var int i ← 0
    while i < piece.length() {
        const int<u8> ∪ null b ← piece.get(i)
        if b not is null {
            acc.append(b coalesce (0 ∷ int<u8>))
        }
        i ← i + 1
    }
    return acc
}

# 4-byte little-endian. The `% 256` masks keep each shift inside the u8
# carrier (the stepper range-checks the ↦ int<u8> cast).
fn u32_le(int n) → bytes {
    var bytes out ← ||
    out.append((n ⇒ 0) % 256 ↦ int<u8>)
    out.append((n ⇒ 8) % 256 ↦ int<u8>)
    out.append((n ⇒ 16) % 256 ↦ int<u8>)
    out.append((n ⇒ 24) % 256 ↦ int<u8>)
    return out
}

# 8-byte little-endian.
fn u64_le(int n) → bytes {
    var bytes out ← ||
    out.append((n ⇒ 0) % 256 ↦ int<u8>)
    out.append((n ⇒ 8) % 256 ↦ int<u8>)
    out.append((n ⇒ 16) % 256 ↦ int<u8>)
    out.append((n ⇒ 24) % 256 ↦ int<u8>)
    out.append((n ⇒ 32) % 256 ↦ int<u8>)
    out.append((n ⇒ 40) % 256 ↦ int<u8>)
    out.append((n ⇒ 48) % 256 ↦ int<u8>)
    out.append((n ⇒ 56) % 256 ↦ int<u8>)
    return out
}

# GGUF string: u64 byte-length + UTF-8 bytes.
fn gguf_string(string s) → bytes {
    return append_bytes(u64_le(s.length()), s ↦ bytes)
}

# string → int (well-formed fixture strings; 0 on malformed).
fn number_a(string s) → int {
    do {
        const int v ← s ↦ int
        return v
    }
    catch err {
        return 0
    }
}

# "key;type;value" → KV bytes (string | u32 | bool | array-of-string).
fn kv_code(string code) → bytes {
    const list<string> parts ← code.split(";")
    const string key ← parts.get(0) coalesce ""
    const string kind ← parts.get(1) coalesce ""
    const string payload ← parts.get(2) coalesce ""
    var bytes out ← gguf_string(key)
    if kind ≡ "s" {
        out ← append_bytes(out, u32_le(8))
        out ← append_bytes(out, gguf_string(payload))
    }
    if kind ≡ "u" {
        out ← append_bytes(out, u32_le(4))
        out ← append_bytes(out, u32_le(number_a(payload)))
    }
    if kind ≡ "b" {
        out ← append_bytes(out, u32_le(7))
        if payload ≡ "1" {
            out.append(1 ↦ int<u8>)
        }
        else {
            out.append(0 ↦ int<u8>)
        }
    }
    if kind ≡ "as" {
        out ← append_bytes(out, u32_le(9))
        out ← append_bytes(out, u32_le(8))
        const list<string> elems ← payload.split(",")
        out ← append_bytes(out, u64_le(elems.length()))
        for from elems const e {
            out ← append_bytes(out, gguf_string(e))
        }
    }
    return out
}

# Flat byte size of a tensor (GGML block layout mirror of gguf.proba
# tensor_extent: F32 1/4, Q8_0 32/34, Q4_K 256/144).
fn tensor_extent(string code) → int {
    const list<string> parts ← code.split(";")
    const int kind ← number_a(parts.get(1) coalesce "")
    const list<string> dims ← (parts.get(2) coalesce "").split(",")
    var int nelems ← 1
    for from dims const dd {
        nelems ← nelems * number_a(dd)
    }
    var int blocks ← 1
    if kind ≡ 0 { blocks ← 1 }
    if kind ≡ 8 { blocks ← 32 }
    if kind ≡ 12 { blocks ← 256 }
    var int block_bytes ← 1
    if kind ≡ 0 { block_bytes ← 4 }
    if kind ≡ 8 { block_bytes ← 34 }
    if kind ≡ 12 { block_bytes ← 144 }
    return (nelems / blocks) * block_bytes
}

# Full GGUF v3 file (mirror of gguf.proba build with extra_data = 0).
fn build() → bytes {
    var bytes f ← ||
    f ← append_bytes(f, "GGUF" ↦ bytes)
    f ← append_bytes(f, u32_le(3))
    f ← append_bytes(f, u64_le(LEGAL_TENSORS.length()))
    f ← append_bytes(f, u64_le(LEGAL_KVS.length()))
    for from LEGAL_KVS const k {
        f ← append_bytes(f, kv_code(k))
    }
    # Tensor info table (offsets cumulative relative to the data start).
    var int cursor ← 0
    for from LEGAL_TENSORS const tt {
        const list<string> parts ← tt.split(";")
        const string name ← parts.get(0) coalesce ""
        const string kind ← parts.get(1) coalesce ""
        const string shape ← parts.get(2) coalesce ""
        f ← append_bytes(f, gguf_string(name))
        const list<string> dims ← shape.split(",")
        f ← append_bytes(f, u32_le(dims.length()))
        for from dims const dd {
            f ← append_bytes(f, u64_le(number_a(dd)))
        }
        f ← append_bytes(f, u32_le(number_a(kind)))
        f ← append_bytes(f, u64_le(cursor))
        cursor ← cursor + tensor_extent(tt)
    }
    # Data section at align32(end of table): pad bytes mirror the GGUF
    # writer and gen_fixture.py.
    const int table_end ← f.length()
    var int pad ← 0
    if table_end % 32 ≠ 0 {
        pad ← 32 - table_end % 32
        var int p ← 0
        while p < pad {
            f.append(0 ↦ int<u8>)
            p ← p + 1
        }
    }
    # Deterministic data pattern over the total tensor bytes: byte k of the
    # data region = (k*13 + 7) mod 256.
    var int tot ← 0
    for from LEGAL_TENSORS const tt {
        tot ← tot + tensor_extent(tt)
    }
    var int z ← 0
    while z < tot {
        f.append(((z * 13 + 7) % 256) ↦ int<u8>)
        z ← z + 1
    }
    return f
}

main {
    # Output directory: argv[1] override, else <gradus-root>/fixtures/gguf.
    const list<string> args ← processus.argv() ↦ list<string>
    var string out_dir ← ""
    if args.length() > 0 {
        out_dir ← args.get(0) coalesce ""
    }
    else {
        out_dir ← solum.join([gradus_root(), "fixtures", "gguf"]) ↦ string
    }
    solum.create_dir(out_dir)
    const string target ← solum.join([out_dir, FILE_NAME]) ↦ string
    const bytes blob ← build()
    solum.write_bytes(target, blob)
    print "wrote §: § bytes"(target, blob.length() ↦ string)
    # SHA-256 is host-computed (the language surface has no digest
    # primitive); print it when shasum is available, mirroring the Python
    # generator's output.
    const list<string> cmd ← ["shasum", "-a", "256", target]
    const map<string, value> res ← processus.captura(cmd) ↦ map<string, value>
    const int status ← res["status"] ↦ int
    if status ≡ 0 {
        const string out ← res["stdout"] ↦ string
        const list<string> parts ← out.split(" ")
        print "sha256 §"(parts.get(0) coalesce "")
    }
}
