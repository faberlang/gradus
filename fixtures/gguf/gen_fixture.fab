+++
locale = "en"
+++

# gradus/fixtures/gguf/gen_fixture.fab — native-Faber generator for the
# pinned PML2-U3 GGUF row fixture (NSM-Wave-2 G2 conversion of
# fixtures/gguf/gen_fixture.py).
#
# Deterministic: writes smollm2-360m-scaled-row.gguf byte-identical to the
# Python generator and to the proba reconstruction (gguf.proba aedifica /
# codex_kv / codex_tensor / tensor_magnitudo / magica). The GGUF v3 layout
# mirrors the pinned toolchain (llama.cpp a957b7747 / gguf-py): "GGUF" magic,
# u32 version 3, u64 tensor/kv counts, metadata KVs, tensor-info table with
# offsets relative to the data-section start, then the data section at
# align32(table end) with the deterministic (k*13 + 7) mod 256 byte pattern.
#
# Execution surface (pinned): the released faber binary
# (faber/target/debug/faber, 1.6.0-rc.1) via `faber script`, launched through
# scripta/gen-fixture-gguf (which stages this source outside the gradus
# package — an in-tree path routes to package mode and rejects the faber:*
# kernel imports with PKG001). The PATH `faber` (1.3.0) is never a valid
# execution surface. Optional argv[1] overrides the output directory; the
# default is <gradus-root>/fixtures/gguf (the Python wrote to the CWD; the
# launcher fixes the CWD at the repo root, so the fixtures dir is the
# byte-stable default that keeps the committed row in place). Exit code:
# 0 on success, 1 on any failure (same contract as the Python generator's
# uncaught-exception exit).

importa ex "faber:solum" privata solum
importa ex "faber:processus" privata processus

# KV codec: "key;type;value" (type s=string, u=u32, b=bool, as=array of
# string). Order matters — must match gguf.proba LEGAL_KVS exactly.
fixum lista<textus> LEGAL_KVS ← [
    "general.architecture;s;llama",
    "general.file_type;u;15",
    "general.quantization_version;u;2",
    "llama.block_count;u;32",
    "llama.context_length;u;8192",
    "llama.vocab_size;u;49152",
    "llama.embedding_length;u;960",
    "tokenizer.ggml.model;s;gpt2",
    "tokenizer.ggml.pre;s;smollm",
    "tokenizer.ggml.bos_token_id;u;1",
    "tokenizer.ggml.eos_token_id;u;2",
    "tokenizer.ggml.padding_token_id;u;2",
    "tokenizer.ggml.unknown_token_id;u;0",
    "tokenizer.ggml.add_bos_token;b;0",
    "tokenizer.ggml.add_space_prefix;b;0",
    "general.name;s;smollm2-fixture",
    "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM",
    "general.languages;as;en"
]

# Tensor codec: "name;type;d1,d2;offset" (offset auto = cumulative relative
# to the data-section start). Q8_0 [32,16] = 544 B; F32 [16] = 64 B;
# Q4_K [256,16] = 2304 B; total 2912 B, every size a 32-multiple.
fixum lista<textus> LEGAL_TENSORES ← [
    "token_embd.weight;8;32,16;auto",
    "blk.0.attn_norm.weight;0;16;auto",
    "blk.0.ffn_down.weight;12;256,16;auto"
]

fixum textus NOMEN_FASCICULI ← "smollm2-360m-scaled-row.gguf"

# Resolve the gradus repository root: FABER_LIBRARY_HOME when set, else the
# workspace layout probed from the current directory (the launcher cd's to
# the gradus root, so processus.sedes() lands there).
functio gradus_root() → textus {
    fixum textus home ← processus.exsequi("printf %s \"${FABER_LIBRARY_HOME:-}\"") ↦ textus
    si home.longitudo() ↦ numerus > 0 {
        fixum textus from_home ← solum.iunge([home, "gradus"]) ↦ textus
        si solum.exstat(solum.iunge([from_home, "src"]) ↦ textus) ↦ bivalens {
            redde solum.absolve(from_home) ↦ textus
        }
    }
    fixum textus cwd ← processus.sedes() ↦ textus
    si solum.exstat(solum.iunge([cwd, "gradus", "src"]) ↦ textus) ↦ bivalens {
        redde solum.absolve(solum.iunge([cwd, "gradus"]) ↦ textus) ↦ textus
    }
    si solum.exstat(solum.iunge([cwd, "src"]) ↦ textus) ↦ bivalens {
        redde solum.absolve(cwd) ↦ textus
    }
    mori "gen-fixture-gguf: cannot resolve the gradus root (set FABER_LIBRARY_HOME or run from the faberlang workspace)"
}

# Append every byte of `piece` onto `acc` (octeti has no concat verb).
functio appende_octeti(octeti acc, octeti piece) → octeti {
    varia numerus i ← 0
    dum i < piece.longitudo() {
        fixum numerus<u8> ∪ nihil b ← piece.accipe(i)
        si b non est nihil {
            acc.appende(b vel (0 ∷ numerus<u8>))
        }
        i ← i + 1
    }
    redde acc
}

# 4-byte little-endian. The `% 256` masks keep each shift inside the u8
# carrier (the stepper range-checks the ↦ numerus<u8> cast).
functio u32_le(numerus n) → octeti {
    varia octeti out ← ||
    out.appende((n ⇒ 0) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 8) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 16) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 24) % 256 ↦ numerus<u8>)
    redde out
}

# 8-byte little-endian.
functio u64_le(numerus n) → octeti {
    varia octeti out ← ||
    out.appende((n ⇒ 0) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 8) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 16) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 24) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 32) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 40) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 48) % 256 ↦ numerus<u8>)
    out.appende((n ⇒ 56) % 256 ↦ numerus<u8>)
    redde out
}

# GGUF string: u64 byte-length + UTF-8 bytes.
functio stringa(textus s) → octeti {
    redde appende_octeti(u64_le(s.longitudo()), s ↦ octeti)
}

# textus → numerus (well-formed fixture strings; 0 on malformed).
functio numerus_a(textus s) → numerus {
    fac {
        fixum numerus v ← s ↦ numerus
        redde v
    }
    cape err {
        redde 0
    }
}

# "key;type;value" → KV bytes (string | u32 | bool | array-of-string).
functio codex_kv(textus codex) → octeti {
    fixum lista<textus> partes ← codex.divide(";")
    fixum textus clavis ← partes.accipe(0) vel ""
    fixum textus typo ← partes.accipe(1) vel ""
    fixum textus valor ← partes.accipe(2) vel ""
    varia octeti out ← stringa(clavis)
    si typo ≡ "s" {
        out ← appende_octeti(out, u32_le(8))
        out ← appende_octeti(out, stringa(valor))
    }
    si typo ≡ "u" {
        out ← appende_octeti(out, u32_le(4))
        out ← appende_octeti(out, u32_le(numerus_a(valor)))
    }
    si typo ≡ "b" {
        out ← appende_octeti(out, u32_le(7))
        si valor ≡ "1" {
            out.appende(1 ↦ numerus<u8>)
        }
        secus {
            out.appende(0 ↦ numerus<u8>)
        }
    }
    si typo ≡ "as" {
        out ← appende_octeti(out, u32_le(9))
        out ← appende_octeti(out, u32_le(8))
        fixum lista<textus> elems ← valor.divide(",")
        out ← appende_octeti(out, u64_le(elems.longitudo()))
        itera ex elems fixum e {
            out ← appende_octeti(out, stringa(e))
        }
    }
    redde out
}

# Flat byte size of a tensor (GGML block layout mirror of gguf.proba
# tensor_magnitudo: F32 1/4, Q8_0 32/34, Q4_K 256/144).
functio tensor_magnitudo(textus codex) → numerus {
    fixum lista<textus> partes ← codex.divide(";")
    fixum numerus typo ← numerus_a(partes.accipe(1) vel "")
    fixum lista<textus> dims ← (partes.accipe(2) vel "").divide(",")
    varia numerus nelems ← 1
    itera ex dims fixum dd {
        nelems ← nelems * numerus_a(dd)
    }
    varia numerus blocci ← 1
    si typo ≡ 0 { blocci ← 1 }
    si typo ≡ 8 { blocci ← 32 }
    si typo ≡ 12 { blocci ← 256 }
    varia numerus octeti_b ← 1
    si typo ≡ 0 { octeti_b ← 4 }
    si typo ≡ 8 { octeti_b ← 34 }
    si typo ≡ 12 { octeti_b ← 144 }
    redde (nelems / blocci) * octeti_b
}

# Full GGUF v3 file (mirror of gguf.proba aedifica with extra_data = 0).
functio aedifica() → octeti {
    varia octeti f ← ||
    f ← appende_octeti(f, "GGUF" ↦ octeti)
    f ← appende_octeti(f, u32_le(3))
    f ← appende_octeti(f, u64_le(LEGAL_TENSORES.longitudo()))
    f ← appende_octeti(f, u64_le(LEGAL_KVS.longitudo()))
    itera ex LEGAL_KVS fixum k {
        f ← appende_octeti(f, codex_kv(k))
    }
    # Tensor info table (offsets cumulative relative to the data start).
    varia numerus cursus ← 0
    itera ex LEGAL_TENSORES fixum tt {
        fixum lista<textus> partes ← tt.divide(";")
        fixum textus nomen ← partes.accipe(0) vel ""
        fixum textus typo ← partes.accipe(1) vel ""
        fixum textus forma ← partes.accipe(2) vel ""
        f ← appende_octeti(f, stringa(nomen))
        fixum lista<textus> dims ← forma.divide(",")
        f ← appende_octeti(f, u32_le(dims.longitudo()))
        itera ex dims fixum dd {
            f ← appende_octeti(f, u64_le(numerus_a(dd)))
        }
        f ← appende_octeti(f, u32_le(numerus_a(typo)))
        f ← appende_octeti(f, u64_le(cursus))
        cursus ← cursus + tensor_magnitudo(tt)
    }
    # Data section at align32(end of table): pad bytes mirror the GGUF
    # writer and gen_fixture.py.
    fixum numerus finis ← f.longitudo()
    varia numerus pad ← 0
    si finis % 32 ≠ 0 {
        pad ← 32 - finis % 32
        varia numerus p ← 0
        dum p < pad {
            f.appende(0 ↦ numerus<u8>)
            p ← p + 1
        }
    }
    # Deterministic data pattern over the total tensor bytes: byte k of the
    # data region = (k*13 + 7) mod 256.
    varia numerus tot ← 0
    itera ex LEGAL_TENSORES fixum tt {
        tot ← tot + tensor_magnitudo(tt)
    }
    varia numerus z ← 0
    dum z < tot {
        f.appende(((z * 13 + 7) % 256) ↦ numerus<u8>)
        z ← z + 1
    }
    redde f
}

incipit {
    # Output directory: argv[1] override, else <gradus-root>/fixtures/gguf.
    fixum lista<textus> args ← processus.argumenta() ↦ lista<textus>
    varia textus out_dir ← ""
    si args.longitudo() > 0 {
        out_dir ← args.accipe(0) vel ""
    }
    secus {
        out_dir ← solum.iunge([gradus_root(), "fixtures", "gguf"]) ↦ textus
    }
    solum.crea(out_dir)
    fixum textus target ← solum.iunge([out_dir, NOMEN_FASCICULI]) ↦ textus
    fixum octeti blob ← aedifica()
    solum.funde(target, blob)
    nota "wrote §: § bytes"(target, blob.longitudo() ↦ textus)
    # SHA-256 is host-computed (the language surface has no digest
    # primitive); print it when shasum is available, mirroring the Python
    # generator's output.
    fixum lista<textus> cmd ← ["shasum", "-a", "256", target]
    fixum tabula<textus, valor> res ← processus.captura(cmd) ↦ tabula<textus, valor>
    fixum numerus status ← res["status"] ↦ numerus
    si status ≡ 0 {
        fixum textus out ← res["stdout"] ↦ textus
        fixum lista<textus> parts ← out.divide(" ")
        nota "sha256 §"(parts.accipe(0) vel "")
    }
}
