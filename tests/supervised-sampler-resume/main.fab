+++
locale = "en"
+++
# Fresh-process supervised sampler proof fixture. The state wire is the only
# continuation state: each `step` process loads it, emits one paired tensor
# batch and persists the next state. Dataset rows contain their original
# sample index so the shell proof can pin the shuffle and target alignment.

import from "gradus:data" data
import from "gradus:tensor" tensor
import from "gradus:random" random
import from "norma:process" process

const int BATCH_SIZE = 2
const int SEED = 123

fn training_indices() → list<int> {
    return [1, 2, 4, 5, 7]
}

fn supervised_data() → data.SupervisedSet {
    mut list<list<int>> inputs ← empty
    mut list<list<int>> targets ← empty
    for range 0 ‥ 8 let i {
        inputs.append([i, i + 10])
        targets.append([i + 100, i + 200, i + 300])
    }
    return data.supervised_set(inputs, targets) ⊥ data.SupervisedSet { inputs = empty, targets = empty }
}

fn empty_state() → data.SupervisedSampler {
    return data.SupervisedSampler { corpus = "", seed = 0, epoch = 0, position = 0 }
}

fn empty_step() → data.SupervisedStep {
    return data.SupervisedStep { batch = data.Batch { x = tensor.default(), y = tensor.default() }, state = empty_state() }
}

fn render_values(list<f32> values) → string {
    mut string text ← ""
    for range 0 ‥ values.length() let i {
        if i ≻ 0 { text ← text + "," }
        text ← text + ((values.get(i) coalesce 0.0) ↦ string)
    }
    return text
}

fn render_batch(data.Batch batch) → string {
    return "§|x=§|y=§"(batch.x.shape.get(0) coalesce 0, render_values(batch.x.data), render_values(batch.y.data))
}

main {
    let list<string> args ← process.argv() ↦ list<string>
    if args.length() ≢ 2 { panic "usage: main.fab <state-path> <start|step>" }
    let string path ← args.get(0) coalesce ""
    let string mode ← args.get(1) coalesce ""
    let list<int> train_set ← training_indices()
    let data.SupervisedSet set ← supervised_data()

    if mode ≡ "start" {
        let random.Seed seed ← random.construct_seed(SEED) ⊥ random.default()
        let data.SupervisedSampler state ← data.supervised_sampler_start(train_set, seed)
        if not data.supervised_sampler_save(path, state) { panic "initial sampler state was not persisted" }
        print data.supervised_sampler_wire(state)
    }
    elif mode ≡ "step" {
        let _ loaded_value ← data.supervised_sampler_load(path)
        if loaded_value is none { panic "sampler state is absent or malformed" }
        let data.SupervisedSampler state ← loaded_value coalesce empty_state()
        let _ step_value ← data.supervised_sampler_step(set, train_set, BATCH_SIZE, state)
        if step_value is none { panic "sampler could not produce the next batch" }
        let data.SupervisedStep step ← step_value coalesce empty_step()
        print render_batch(step.batch)
        if not data.supervised_sampler_save(path, step.state) { panic "next sampler state was not persisted" }
    }
    else { panic "unknown mode: expected start or step" }
}
