# The GGUF magic, as bytes.
fn magic() → list<int<u8>> {
    return int_bytes([0x47, 0x47, 0x55, 0x46])
}

# The 15 identity-bearing required keys + 3 optional admitted keys. KV
# codec: "key;type;value" (type s=string, u=u32, b=bool, as=array[string]).
const list<string> LEGAL_KVS ← [
    "general.architecture;s;llama",
    "general.file_type;u;15",
    "general.quantization_version;u;2",
    "llama.block_count;u;32",
    "llama.context_length;u;8192",
    "llama.vocab_size;u;49152",
    "llama.embedding_length;u;960",
    "tokenizer.ggml.model;s;gpt2",
    "tokenizer.ggml.pre;s;smollm",
    "tokenizer.ggml.bos_token_id;u;1",
    "tokenizer.ggml.eos_token_id;u;2",
    "tokenizer.ggml.padding_token_id;u;2",
    "tokenizer.ggml.unknown_token_id;u;0",
    "tokenizer.ggml.add_bos_token;b;0",
    "tokenizer.ggml.add_space_prefix;b;0",
    "general.name;s;smollm2-fixture",
    "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM",
    "general.languages;as;en"
]

# Tensor codec: "name;type;d1,d2;offset" (offset auto = cumulative, or a
# literal relative offset). Q8_0 [32,16] = 512 elems = 544 B; F32 [16] =
# 64 B; Q4_K [256,16] = 4096 elems = 2304 B; total 2912 B, 32-multiples.
const list<string> LEGAL_TENSORS ← [
    "token_embd.weight;8;32,16;auto",
    "blk.0.attn_norm.weight;0;16;auto",
    "blk.0.ffn_down.weight;12;256,16;auto"
]

const int G_KV ← 18
const int G_TENSORS ← 3
const int G_ELEMENTS ← 4624
const int G_F32 ← 1
const int G_Q4K ← 1
const int G_Q5 ← 0
const int G_Q6 ← 0
const int G_Q8 ← 1

fn int_bytes(list<int> vals) → list<int<u8>> {
    var list<int<u8>> bs ← empty
    for from vals const v {
        bs.append(v ↦ int<u8>)
    }
    return bs
}

fn bytes_bytes(string s) → list<int<u8>> {
    const bytes o ← s ↦ bytes
    var list<int<u8>> out ← empty
    var int i ← 0
    while i ≺ o.length() {
        out.append(o.get(i) coalesce (0 ∷ int<u8>))
        i ← i + 1
    }
    return out
}

fn add(list<int<u8>> acc, list<int<u8>> piece) → list<int<u8>> {
    var list<int<u8>> out ← empty
    for from acc const byte {
        out.append(byte)
    }
    for from piece const byte {
        out.append(byte)
    }
    return out
}

fn u32_le(int n) → list<int<u8>> {
    var list<int<u8>> out ← empty
    out.append((n ⇒ 0) ↦ int<u8>)
    out.append((n ⇒ 8) ↦ int<u8>)
    out.append((n ⇒ 16) ↦ int<u8>)
    out.append((n ⇒ 24) ↦ int<u8>)
    return out
}

fn u64_le(int n) → list<int<u8>> {
    var list<int<u8>> out ← empty
    out.append((n ⇒ 0) ↦ int<u8>)
    out.append((n ⇒ 8) ↦ int<u8>)
    out.append((n ⇒ 16) ↦ int<u8>)
    out.append((n ⇒ 24) ↦ int<u8>)
    out.append((n ⇒ 32) ↦ int<u8>)
    out.append((n ⇒ 40) ↦ int<u8>)
    out.append((n ⇒ 48) ↦ int<u8>)
    out.append((n ⇒ 56) ↦ int<u8>)
    return out
}

fn gguf_string(string s) → list<int<u8>> {
    var list<int<u8>> out ← u64_le(s.length())
    var list<int<u8>> body ← bytes_bytes(s)
    for from body const byte {
        out.append(byte)
    }
    return out
}

# text → number (well-formed fixture strings; 0 on malformed).
fn number_a(string s) → int {
    do {
        const int v ← s ↦ int
        return v
    }
    catch err {
        return 0
    }
}

fn repeat(string s, int n) → string {
    var string out ← ""
    var int i ← 0
    while i ≺ n {
        out ← out + s
        i ← i + 1
    }
    return out
}

# "key;type;value" → KV bytes (string | u32 | bool | array-of-string).
fn kv_code(string code) → list<int<u8>> {
    const list<string> parts ← code.split(";")
    const string key ← parts.get(0) coalesce ""
    const string kind ← parts.get(1) coalesce ""
    const string value ← parts.get(2) coalesce ""
    var list<int<u8>> out ← gguf_string(key)
    if kind ≡ "s" {
        out ← add(out, u32_le(8))
        out ← add(out, gguf_string(value))
    }
    if kind ≡ "u" {
        out ← add(out, u32_le(4))
        out ← add(out, u32_le(number_a(value)))
    }
    if kind ≡ "b" {
        out ← add(out, u32_le(7))
        if value ≡ "1" {
            out.append(1 ↦ int<u8>)
        }
        else {
            out.append(0 ↦ int<u8>)
        }
    }
    if kind ≡ "as" {
        out ← add(out, u32_le(9))
        out ← add(out, u32_le(8))
        const list<string> elems ← value.split(",")
        out ← add(out, u64_le(elems.length()))
        for from elems const e {
            out ← add(out, gguf_string(e))
        }
    }
    return out
}

# "name;type;d1,d2;offset" → tensor-info bytes (offset relative to the
# data-section start; auto = running cumulative).
fn code_tensor(string code, int cursor) → list<int<u8>> {
    const list<string> parts ← code.split(";")
    const string name ← parts.get(0) coalesce ""
    const string kind ← parts.get(1) coalesce ""
    const string shape ← parts.get(2) coalesce ""
    const string offset_s ← parts.get(3) coalesce "auto"
    var list<int<u8>> out ← gguf_string(name)
    const list<string> dims ← shape.split(",")
    out ← add(out, u32_le(dims.length()))
    for from dims const dd {
        out ← add(out, u64_le(number_a(dd)))
    }
    out ← add(out, u32_le(number_a(kind)))
    var int off_val ← cursor
    if offset_s ≠ "auto" {
        off_val ← number_a(offset_s)
    }
    out ← add(out, u64_le(off_val))
    return out
}

# Flat byte size of a tensor (block layout mirrors the admitted GGML
# table: F32 1/4, Q5_0 32/22, Q8_0 32/34, Q4_K 256/144, Q6_K 256/210).
fn tensor_extent(string code) → int {
    const list<string> parts ← code.split(";")
    const int kind ← number_a(parts.get(1) coalesce "")
    const list<string> dims ← (parts.get(2) coalesce "").split(",")
    var int nelems ← 1
    for from dims const dd {
        nelems ← nelems * number_a(dd)
    }
    var int blocks ← 1
    if kind ≡ 0 { blocks ← 1 }
    if kind ≡ 6 { blocks ← 32 }
    if kind ≡ 8 { blocks ← 32 }
    if kind ≡ 12 { blocks ← 256 }
    if kind ≡ 14 { blocks ← 256 }
    var int bytes ← 1
    if kind ≡ 0 { bytes ← 4 }
    if kind ≡ 6 { bytes ← 22 }
    if kind ≡ 8 { bytes ← 34 }
    if kind ≡ 12 { bytes ← 144 }
    if kind ≡ 14 { bytes ← 210 }
    return (nelems / blocks) * bytes
}

# Full GGUF v3 file from codec lists. extra_data appends trailing bytes to
# the data region (coverage mutants). Data section starts at align32(end
# of the tensor table); tensor offsets are cumulative relative.
fn build(
    list<int<u8>> magic,
    int version,
    list<string> kvs,
    list<string> tensors,
    int extra_data
) → list<int<u8>> {
    var list<int<u8>> f ← empty
    for from magic const byte {
        f.append(byte)
    }
    f ← add(f, u32_le(version))
    f ← add(f, u64_le(tensors.length()))
    f ← add(f, u64_le(kvs.length()))
    for from kvs const k {
        f ← add(f, kv_code(k))
    }
    var int cursor ← 0
    for from tensors const tt {
        f ← add(f, code_tensor(tt, cursor))
        cursor ← cursor + tensor_extent(tt)
    }
    const int table_end ← f.length()
    var int data_start ← table_end
    if data_start % 32 ≠ 0 {
        const int pad ← 32 - data_start % 32
        var int p ← 0
        while p ≺ pad {
            f.append(0 ↦ int<u8>)
            p ← p + 1
        }
        data_start ← data_start + pad
    }
    var int tot ← 0
    for from tensors const tt {
        tot ← tot + tensor_extent(tt)
    }
    var int z ← 0
    while z ≺ tot + extra_data {
        f.append(((z * 13 + 7) % 256) ↦ int<u8>)
        z ← z + 1
    }
    return f
}

# The pinned legal fixture (scaled structural replica).
fn legal() → list<int<u8>> {
    return build(magic(), 3, LEGAL_KVS, LEGAL_TENSORS, 0)
}

# List replacement / removal for mutants.
fn replace_entry(list<string> xs, string old_item, string new_item) → list<string> {
    var list<string> out ← empty
    for from xs const x {
        if x ≡ old_item {
            out.append(new_item)
        }
        else {
            out.append(x)
        }
    }
    return out
}

fn remove(list<string> xs, string old_item) → list<string> {
    var list<string> out ← empty
    for from xs const x {
        if x ≠ old_item {
            out.append(x)
        }
    }
    return out
}

# Byte mutation / truncation.
fn mutate(list<int<u8>> b, int off, int value) → list<int<u8>> {
    var list<int<u8>> out ← empty
    var int i ← 0
    while i ≺ b.length() {
        if i ≡ off {
            out.append(value ↦ int<u8>)
        }
        else {
            out.append(b.get(i) coalesce (0 ∷ int<u8>))
        }
        i ← i + 1
    }
    return out
}

fn take_n(list<int<u8>> b, int n) → list<int<u8>> {
    var list<int<u8>> out ← empty
    var int i ← 0
    while i ≺ n {
        out.append(b.get(i) coalesce (0 ∷ int<u8>))
        i ← i + 1
    }
    return out
}

# -- GGUF admission outcome helpers ---------------------------------------

fn admission_result(
    list<int<u8>> bytes_f,
    string digest,
    int expected_kv,
    int expected_tensors,
    int expected_elements,
    int expected_f32,
    int expected_q4k,
    int expected_q5,
    int expected_q6,
    int expected_q8
) → string {
    do {
        const capsule.Capsule c ← gguf.admit(bytes_f, digest, expected_kv, expected_tensors, expected_elements, expected_f32, expected_q4k, expected_q5, expected_q6, expected_q8)
        return "ok"
    }
    catch err {
        return gguf.message(err)
    }
}

# Admission with the legal fixture's contract.
fn admit_legal(list<int<u8>> bytes_f) → string {
    return admission_result(bytes_f, GGUF_DIGEST, G_KV, G_TENSORS, G_ELEMENTS, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8)
}

# =========================================================================
# §3 U4 — Tokenizer wrappers (src/tokenizer.proba seam).
# =========================================================================

const string T_SCHEMA ← "1.0.0"
const string T_KIND ← "gpt2"
const string T_PRE ← "smollm"

# verify_probe outcome as text ("ok" or the typed error's message).
fn probe_result(string name, list<int> observed) → string {
    do {
        const bool ok ← tokenizer.verify_probe(name, observed)
        return "ok"
    }
    catch err {
        return tokenizer.message(err)
    }
}

# construct outcome as text ("ok" on success, or the typed error's message).
fn construct_result(
    string schema,
    string merge_kind,
    string pre_tokenizer,
    string vocab_digest,
    string eog,
    bool bos_free,
    bool space_free
) → string {
    do {
        const tokenizer.TokenizerIdentity t ← tokenizer.construct(schema, merge_kind, pre_tokenizer, vocab_digest, eog, bos_free, space_free)
        return "ok"
    }
    catch err {
        return tokenizer.message(err)
    }
}

# verify outcome as text.
fn verify_result(tokenizer.TokenizerIdentity t) → string {
    do {
        const bool ok ← tokenizer.verify(t)
        return "ok"
    }
    catch err {
        return tokenizer.message(err)
    }
}

# key outcome as text ("ok|key" or the typed error's message).
fn key_result(tokenizer.TokenizerIdentity t) → string {
    do {
        const string k ← tokenizer.tokenizer_key(t)
        return "ok|" + k
    }
    catch err {
        return tokenizer.message(err)
    }
}

# Wire outcome as text ("ok" or the typed error's message).
fn wire_result(string wire) → string {
    do {
        const tokenizer.TokenizerIdentity t ← tokenizer.deserialize_identity(wire)
        return "ok"
    }
    catch err {
        return tokenizer.message(err)
    }
}

