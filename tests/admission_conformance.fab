    }

    proba "rejects a vocabulary size mismatch (arch)" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.vocab_size;u;49152", "llama.vocab_size;u;32000"), LEGAL_TENSORES, 0)) ≡ "vocabulary size mismatch"
    }

    proba "rejects an embedding size mismatch (arch)" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.embedding_length;u;960", "llama.embedding_length;u;512"), LEGAL_TENSORES, 0)) ≡ "embedding size mismatch"
    }

    proba "rejects a file type mismatch (quant)" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.file_type;u;15", "general.file_type;u;14"), LEGAL_TENSORES, 0)) ≡ "file type mismatch"
    }

    proba "rejects a quantization version mismatch (quant)" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.quantization_version;u;2", "general.quantization_version;u;1"), LEGAL_TENSORES, 0)) ≡ "quantization version mismatch"
    }

    proba "rejects a wrong metadata value type (quant/arch)" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.file_type;u;15", "general.file_type;s;15"), LEGAL_TENSORES, 0)) ≡ "metadata value is not an unsigned integer"
    }

    proba "rejects a tokenizer model mismatch (tokenizer)" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.model;s;gpt2", "tokenizer.ggml.model;s;tiktoken"), LEGAL_TENSORES, 0)) ≡ "tokenizer model mismatch"
    }

    proba "rejects a pre-tokenizer mismatch (tokenizer)" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.pre;s;smollm", "tokenizer.ggml.pre;s;o200k"), LEGAL_TENSORES, 0)) ≡ "tokenizer pre-tokenizer mismatch"
    }

    proba "rejects a bos token id mismatch (tokenizer)" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.bos_token_id;u;1", "tokenizer.ggml.bos_token_id;u;0"), LEGAL_TENSORES, 0)) ≡ "bos token id mismatch"
    }

    proba "rejects an eos token id mismatch (tokenizer)" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.eos_token_id;u;2", "tokenizer.ggml.eos_token_id;u;1"), LEGAL_TENSORES, 0)) ≡ "eos token id mismatch"
    }

    proba "rejects add_bos_token set (tokenizer)" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.add_bos_token;b;0", "tokenizer.ggml.add_bos_token;b;1"), LEGAL_TENSORES, 0)) ≡ "add_bos_token mismatch"
    }

    proba "rejects add_space_prefix set (tokenizer)" {
        adfirma admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.add_space_prefix;b;0", "tokenizer.ggml.add_space_prefix;b;1"), LEGAL_TENSORES, 0)) ≡ "add_space_prefix mismatch"
    }

    proba "rejects an unknown ggml tensor type (dtype)" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "token_embd.weight;8;32,16;auto", "token_embd.weight;2;32,16;auto"), 0)) ≡ "unknown ggml tensor type"
    }

    proba "rejects a tensor whose elements are not a block multiple (quant)" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "token_embd.weight;8;32,16;auto", "token_embd.weight;8;8,7;auto"), 0)) ≡ "tensor first dimension is not a complete GGML block"
    }

    proba "rejects a tensor byte size not aligned to 32 (quant)" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "token_embd.weight;8;32,16;auto", "token_embd.weight;6;64;auto"), 0)) ≡ "tensor byte size not a multiple of the 32-byte data alignment"
    }

    proba "rejects a per-type tensor count mismatch (quant)" {
        adfirma admissio_result(legitima(), GGUF_DIGEST, G_KV, G_TENSORES, G_ELEMENTA, G_F32, G_Q4K, 1, G_Q6, G_Q8) ≡ "tensor type count mismatch"
    }

    proba "rejects an unsupported tensor rank (shape)" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;4,4,2;auto"), 0)) ≡ "unsupported tensor rank"
    }

    proba "rejects a dimension above the 65536 ceiling (shape)" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "token_embd.weight;8;32,16;auto", "token_embd.weight;8;65568,1;auto"), 0)) ≡ "invalid tensor dimension"
    }

    proba "rejects a zero dimension (shape)" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;0;auto"), 0)) ≡ "tensor dimension is outside the bounded range"
    }

    proba "rejects a total element count mismatch (shape)" {
        adfirma admissio_result(legitima(), GGUF_DIGEST, G_KV, G_TENSORES, 4625, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8) ≡ "total element count mismatch"
    }

    proba "rejects non-contiguous tensor offsets (offset)" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;16;300"), 0)) ≡ "known GGML tensor ranges overlap"
    }

    proba "rejects overlapping/duplicate tensor offsets (offset)" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;16;0"), 0)) ≡ "known GGML tensor ranges overlap"
    }

    proba "rejects a duplicate tensor name (offset/table)" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "token_embd.weight;8;32,16;auto"), 0)) ≡ "duplicate GGUF tensor name: token_embd.weight"
    }

    proba "rejects an empty tensor name (offset/table)" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", ";0;16;auto"), 0)) ≡ "empty tensor name"
    }

    proba "rejects a tensor name above the 128-byte ceiling (bounds)" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", repetitio("w", 130) + ";0;16;auto"), 0)) ≡ "tensor name exceeds the 128-byte ceiling"
    }

    proba "rejects a truncated data region (offset)" {
        adfirma admissio_legitima(excerpe(legitima(), legitima().longitudo() - 100)) ≡ "known GGML tensor range exceeds the artifact"
    }

    proba "rejects trailing bytes in the data region (offset)" {
        adfirma admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, LEGAL_TENSORES, 100)) ≡ "data region does not tile exactly"
    }
}

# =========================================================================
# U4 — Tokenizer fail-closed negative matrix (version/kind/bounds/probe
# parity/wire; every case = typed TokenizerError).
# =========================================================================

probandum "admission conformance — U4 tokenizer matrix" {
    proba "a diverging id list fails closed (probe parity)" {
        adfirma proba_result("p10", [504, 2365, 6354, 16438, 27003, 690, 260, 23790]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p10"
    }

    proba "a reordered id list fails closed (probe parity)" {
        adfirma proba_result("p11", [905, 19556]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p11"
    }

    proba "a length-mismatched id list fails closed (probe parity)" {
        adfirma proba_result("p6", [44, 108, 306, 79, 3738, 108]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p6"
    }

    proba "an unknown probe name fails closed (probe parity)" {
        adfirma proba_result("p99", [1]) ≡ "unknown pinned probe: p99"
    }

    proba "a non-digit pinned id fails closed (bounds)" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida("1,xx")
            adfirma falsum
        }
        cape err {
            adfirma tokenizator.causa(err) ≡ "non-digit token id in pinned fixture"
        }
    }

    proba "an out-of-range pinned id fails closed (bounds)" {
        fac {
            fixum lista<numerus> ids ← tokenizator.proba_ida("999999")
            adfirma falsum
        }
        cape err {
            adfirma tokenizator.causa(err) ≡ "token id out of range: 999999"
        }
    }

    proba "rejects an unknown schema version (version)" {
        adfirma structa_result("2.0.0", T_KIND, T_PRE, F_VOCAB, C_EOG, C_BOS, C_SPATIUM) ≡ "unknown tokenizer identity schema version: 2.0.0"
    }

    proba "rejects an un-admitted tokenizer kind (kind)" {
        adfirma structa_result(T_SCHEMA, "llama", T_PRE, F_VOCAB, C_EOG, C_BOS, C_SPATIUM) ≡ "un-admitted tokenizer kind: llama (pinned row is gpt2 / byte-level BPE)"
    }

    proba "rejects an un-admitted pre-tokenizer (pre)" {
        adfirma structa_result(T_SCHEMA, T_KIND, "gpt2", F_VOCAB, C_EOG, C_BOS, C_SPATIUM) ≡ "un-admitted pre-tokenizer: gpt2 (pinned row is smollm)"
    }

    proba "rejects a malformed vocabulary digest (bounds)" {
        adfirma structa_result(T_SCHEMA, T_KIND, T_PRE, "zz", C_EOG, C_BOS, C_SPATIUM) ≡ "malformed vocabulary digest"
    }

    proba "rejects a malformed EOG set (bounds)" {
        adfirma structa_result(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, "2,0", C_BOS, C_SPATIUM) ≡ "malformed EOG set"
    }

    proba "rejects a non-BOS-free row (tokenizer facts)" {
        adfirma structa_result(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, C_EOG, falsum, C_SPATIUM) ≡ "pinned row is BOS-free (add_bos_token = false)"
    }

    proba "rejects a space-prefixed row (tokenizer facts)" {
        adfirma structa_result(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, C_EOG, C_BOS, falsum) ≡ "pinned row is space-prefix-free (add_space_prefix = false)"
    }

    proba "verifica passes on an admitted identity (self-verifying contract)" {
        fac {
            fixum tokenizator.IdentitasTokenizator t ← tokenizator.structa(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, C_EOG, C_BOS, C_SPATIUM)
            adfirma verifica_result(t) ≡ "ok"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "the KV identity key component (MD-A9) is deterministic and carries the pinned facts" {
        fac {
            fixum tokenizator.IdentitasTokenizator a ← tokenizator.structa(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, C_EOG, C_BOS, C_SPATIUM)
            fixum tokenizator.IdentitasTokenizator b ← tokenizator.structa(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, C_EOG, C_BOS, C_SPATIUM)
            adfirma clavis_result(a) ≡ "ok|tokenizer/identity/1.0.0/gpt2/smollm/" + F_VOCAB + "/0,2/bos-free=true/space-prefix-free=true"
            adfirma clavis_result(a) ≡ clavis_result(b)
        }
        cape err {
            adfirma falsum
        }
    }

    proba "deserialization rejects an unknown schema version (version/wire)" {
        adfirma wire_result("tokenizer/identity/2.0.0/gpt2/smollm/" + F_VOCAB + "/0,2") ≡ "unknown tokenizer identity schema version: 2.0.0"
    }

    proba "deserialization rejects an unknown marker (format/wire)" {
        adfirma wire_result("model/identity/1.0.0/gpt2/smollm/" + F_VOCAB + "/0,2") ≡ "unknown tokenizer identity marker"
    }

    proba "deserialization rejects a malformed wire form (format/wire)" {
        adfirma wire_result("tokenizer/identity/1.0.0/gpt2") ≡ "malformed tokenizer identity wire form"
    }

    proba "deserialization rejects a malformed digest (bounds/wire)" {
        adfirma wire_result("tokenizer/identity/1.0.0/gpt2/smollm/zz/0,2") ≡ "malformed vocabulary digest"
    }
}

# =========================================================================
# U1 — Capsule identity fail-closed negative matrix (schema-2 surface:
# structa_manifestum / verifica / verifica_contra / deserializa_identitas;
# version/algorithm/digest/bytes/manifest/bounds/wire; every case = typed
# AdmissionError). Schema-1-constructor-only dimensions (quant row, capsule
# tokenizer/arch facts, Limites) are validated at the caller boundary in
# U2/U3 and asserted there; the retired stamp is rejected here (SchemaVetus).
# =========================================================================

probandum "admission conformance — U1 capsule matrix" {
    proba "rejects the retired schema-1 stamp (version)" {
        adfirma structa_result_capsulae("1.0.0", identitas_capsulae(), manifestum_capsulae()) ≡ "schema 1 is retired — capsule schema is 2.0.0"
    }

    proba "rejects an unknown capsule schema version (version)" {
        adfirma structa_result_capsulae("3.0.0", identitas_capsulae(), manifestum_capsulae()) ≡ "unknown capsule schema version: 3.0.0"
    }

    proba "rejects an un-admitted digest algorithm (algorithm)" {
        adfirma structa_result_capsulae(C_SCHEMA, identitas_capsulae_variata("md5", C_DIGEST, C_LONGITUDO), manifestum_capsulae()) ≡ "unknown digest algorithm: md5"
    }

    proba "rejects a malformed digest value (digest)" {
        adfirma structa_result_capsulae(C_SCHEMA, identitas_capsulae_variata(C_ALGO, "abc", C_LONGITUDO), manifestum_capsulae()) ≡ "malformed digest value"
    }

    proba "rejects a non-positive artifact byte length (bytes)" {
        adfirma structa_result_capsulae(C_SCHEMA, identitas_capsulae_variata(C_ALGO, C_DIGEST, 0), manifestum_capsulae()) ≡ "invalid artifact byte length"
    }

    proba "rejects a manifest whose artifact length does not match the identity (bytes)" {
        adfirma structa_result_capsulae(C_SCHEMA, identitas_capsulae(), manifestum_capsulae_variata("safetensors", "1.0.0", 2048, C_DATORUM, tensores_capsulae())) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects a data region larger than the artifact (bounds)" {
        adfirma structa_result_capsulae(C_SCHEMA, identitas_capsulae(), manifestum_capsulae_variata("safetensors", "1.0.0", C_LONGITUDO, 2048, tensores_capsulae())) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects an empty tensor shape (shape)" {
        adfirma structa_result_capsulae(C_SCHEMA, identitas_capsulae(), manifestum_capsulae_variata("safetensors", "1.0.0", C_LONGITUDO, C_DATORUM, [descriptio_capsulae("w", "F32", [], 0, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects a tensor whose element count does not match the shape (shape)" {
        adfirma structa_result_capsulae(C_SCHEMA, identitas_capsulae(), manifestum_capsulae_variata("safetensors", "1.0.0", C_LONGITUDO, C_DATORUM, [descriptio_capsulae("w", "F32", [8, 4], 0, 128, 31)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "rejects a tensor range beyond the data region (bounds/coverage)" {
        adfirma structa_result_capsulae(C_SCHEMA, identitas_capsulae(), manifestum_capsulae_variata("safetensors", "1.0.0", C_LONGITUDO, C_DATORUM, [descriptio_capsulae("w", "F32", [8, 4], 0, 161, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    proba "verifica rejects a schema-1-stamped capsule (version)" {
        fac {
            fixum capsula.Capsula vetus ← capsula.Capsula { schema = "1.0.0", identitas = identitas_capsulae(), manifestum = capsula.manifestum_safetensors(manifestum_capsulae()) }
            adfirma verifica_result_capsulae(vetus) ≡ "schema 1 is retired — capsule schema is 2.0.0"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "wire deserialization rejects an unknown schema version (version)" {
        adfirma identitas_wire_result("capsule/identity/3.0.0/sha-256/" + C_DIGEST + "/" + (C_LONGITUDO ↦ textus)) ≡ "unknown capsule schema version: 3.0.0"
    }

    proba "wire deserialization rejects the retired schema-1 wire (version)" {
        adfirma identitas_wire_result("capsule/identity/1.0.0/sha-256/" + C_DIGEST + "/" + (C_LONGITUDO ↦ textus)) ≡ "schema 1 is retired — capsule schema is 2.0.0"
    }

    proba "wire deserialization rejects an unknown marker (format)" {
        adfirma identitas_wire_result("model/identity/2.0.0/sha-256/" + C_DIGEST + "/" + (C_LONGITUDO ↦ textus)) ≡ "unknown capsule identity marker"
    }

    proba "wire deserialization rejects a malformed wire form (format)" {
        adfirma identitas_wire_result("capsule/identity/2.0.0/sha-256") ≡ "malformed capsule identity wire form"
    }

    proba "wire deserialization rejects a 9-segment non-schema-1 wire (format)" {
        adfirma identitas_wire_result("capsule/identity/3.0.0/sha-256/" + C_DIGEST + "/4/q4_k/llama/16") ≡ "malformed capsule identity wire form"
    }

    proba "wire deserialization rejects an un-admitted digest algorithm (algorithm)" {
        adfirma identitas_wire_result("capsule/identity/2.0.0/md5/" + C_DIGEST + "/" + (C_LONGITUDO ↦ textus)) ≡ "unknown digest algorithm: md5"
    }

    proba "wire deserialization rejects a malformed digest (digest)" {
        adfirma identitas_wire_result("capsule/identity/2.0.0/sha-256/zz/" + (C_LONGITUDO ↦ textus)) ≡ "malformed digest value"
    }

    proba "wire deserialization rejects a non-numeric byte length (bytes)" {
        adfirma identitas_wire_result("capsule/identity/2.0.0/sha-256/" + C_DIGEST + "/many") ≡ "malformed numeric field"
    }

    proba "wire deserialization rejects a non-positive byte length (bytes)" {
        adfirma identitas_wire_result("capsule/identity/2.0.0/sha-256/" + C_DIGEST + "/0") ≡ "invalid byte length in capsule identity"
    }
}
