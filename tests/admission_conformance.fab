# The pathless content identity of the structural capsule fixture.
fn identitas_capsulae() → artifact.ContentIdentity {
    return artifact.ContentIdentity { algorithm = C_ALGO, digest = C_DIGEST, length = C_LONGITUDO }
}

# An identity with caller-supplied fields (fail-closed cases).
fn identitas_capsulae_variata(string algorithmus, string digestio, int longitudo) → artifact.ContentIdentity {
    return artifact.ContentIdentity { algorithm = algorithmus, digest = digestio, length = longitudo }
}

# A Safetensors tensor descriptor (structural F32 fixture row).
fn descriptio_capsulae(string nomen, string typo, list<int> forma, int initium, int finis, int elementa) → capsula.SafetensorsTensorDescriptor {
    return capsula.SafetensorsTensorDescriptor { name = nomen, dtype = typo, shape = forma, start = initium, end = finis, elements = elementa }
}

# The two-descriptor F32 fixture row (ranges tile the 160-byte data region).
fn tensores_capsulae() → list<capsula.SafetensorsTensorDescriptor> {
    return [
        descriptio_capsulae("model.embed_tokens.weight", "F32", [8, 4], 0, 128, 32),
        descriptio_capsulae("model.norm.weight", "F32", [8], 128, 160, 8)
    ]
}

# The well-formed Safetensors manifest (format/version + metadata + tensors).
fn manifestum_capsulae() → capsula.SafetensorsManifest {
    return capsula.SafetensorsManifest {
        format = "safetensors",
        version = "1.0.0",
        artifact_length = C_LONGITUDO,
        data_length = C_DATORUM,
        metadata = [ capsula.SafetensorsMetadata { key = "format.name", payload = "safetensors" } ],
        tensors = tensores_capsulae()
    }
}

# A manifest with caller-supplied fields (fail-closed cases).
fn manifestum_capsulae_variata(string formatum, string versio, int longitudo_artifacti, int longitudo_datorum, list<capsula.SafetensorsTensorDescriptor> tensores) → capsula.SafetensorsManifest {
    return capsula.SafetensorsManifest {
        format = formatum,
        version = versio,
        artifact_length = longitudo_artifacti,
        data_length = longitudo_datorum,
        metadata = [],
        tensors = tensores
    }
}

# Renders an admission outcome as textus: "ok" or the typed error's causa.
# (schema-2 structa_manifestum — the retired schema-1 structa is gone).
fn structa_result_capsulae(string schema, artifact.ContentIdentity identitas, capsula.SafetensorsManifest m) → string {
    do {
        const capsula.Capsule c ← capsula.construct_manifest(schema, identitas, capsula.safetensors_manifest(m))
        return "ok"
    }
    catch err {
        return capsula.message(err)
    }
}

# Verifica outcome as textus.
fn verifica_result_capsulae(capsula.Capsule c) → string {
    do {
        const bool ok ← capsula.verify(c)
        return "ok"
    }
    catch err {
        return capsula.message(err)
    }
}

# Identity verification against an expected digest, as textus.
fn contra_result_capsulae(capsula.Capsule c, string expectatum) → string {
    do {
        const bool ok ← capsula.verify_against(c, expectatum)
        return "ok"
    }
    catch err {
        return capsula.message(err)
    }
}

# Identity wire outcome as textus ("ok" or the typed error's causa).
fn identitas_wire_result(string wire) → string {
    do {
        const capsula.Identity i ← capsula.deserialize_identity(wire)
        return "ok"
    }
    catch err {
        return capsula.message(err)
    }
}

# Identity round-trip predicate: deserializa(serializa(c)).identity() ≡
# c.identity() by identitas_aequus.
fn roundtrip(capsula.Capsule c) → bool {
    do {
        const capsula.Identity i ← capsula.deserialize_identity(capsula.serialize_identity(c))
        return capsula.identity_equal(c.identity(), i)
    }
    catch err {
        return false
    }
}

# =========================================================================
# Aggregate happy row — the four landed rows admit, and the oracle hashes
# bind the capsule identity (the conformance gate's positive anchor).
# =========================================================================

describe "admission conformance — aggregate happy row" {
    test "U2 safetensors legal fixture admits with the pinned oracle identity" {
        do {
            const capsula.Capsule c ← safetensors.admittas(fixatura(), SAFE_HASH, "")
            assert admittas_result(fixatura(), SAFE_HASH, "") ≡ "ok"
            assert fixatura().length() ≡ 1512
            assert c.schema() ≡ "2.0.0"
            assert c.algorithm() ≡ "sha-256"
            assert c.digest() ≡ SAFE_HASH
            assert c.length() ≡ 1512
            assert c.format() ≡ "safetensors"
            assert c.tensor_count() ≡ 5
            assert c.safetensors_manifest() not is null
            assert c.identity().schema() ≡ "2.0.0"
            assert contra_result_capsulae(c, SAFE_HASH) ≡ "ok"
            assert contra_result_capsulae(c, F_ALIA) ≡ "digest mismatch — capsule does not match the expected artifact"
        }
        catch err {
            assert false
        }
    }

    test "U3 gguf legal fixture admits with the pinned oracle identity" {
        do {
            const capsula.Capsule c ← gguf.admit(legitima(), GGUF_DIGEST, G_KV, G_TENSORES, G_ELEMENTA, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8)
            assert admissio_legitima(legitima()) ≡ "ok"
            assert verifica_result_capsulae(c) ≡ "ok"
            assert contra_result_capsulae(c, GGUF_DIGEST) ≡ "ok"
            assert c.schema() ≡ "2.0.0"
            assert c.algorithm() ≡ "sha-256"
            assert c.digest() ≡ GGUF_DIGEST
            assert c.length() ≡ legitima().length()
            assert c.format() ≡ "gguf"
            assert c.tensor_count() ≡ 3
            assert c.gguf_manifest() not is null
            assert c.identity().schema() ≡ "2.0.0"
        }
        catch err {
            assert false
        }
    }

    test "U4 tokenizer probe parity admits the pinned id lists" {
        assert proba_result("p10", [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767]) ≡ "ok"
        assert proba_result("p1", [19556, 905]) ≡ "ok"
        assert structa_result(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, C_EOG, C_BOS, C_SPATIUM) ≡ "ok"
    }

    test "U1 schema-2 capsule admission + identity wire round-trip" {
        do {
            const capsula.Capsule c ← capsula.construct_manifest(C_SCHEMA, identitas_capsulae(), capsula.safetensors_manifest(manifestum_capsulae()))
            assert structa_result_capsulae(C_SCHEMA, identitas_capsulae(), manifestum_capsulae()) ≡ "ok"
            assert c.schema() ≡ "2.0.0"
            assert c.algorithm() ≡ "sha-256"
            assert c.digest() ≡ C_DIGEST
            assert c.length() ≡ C_LONGITUDO
            assert c.format() ≡ "safetensors"
            assert c.tensor_count() ≡ 2
            assert c.safetensors_manifest() not is null
            assert roundtrip(c)
        }
        catch err {
            assert false
        }
    }
}

# =========================================================================
# U2 — Safetensors fail-closed negative matrix (format/version/arch/dtype/
# offset/shape/tokenizer/bounds/counts; every case = typed SafetensorError).
# =========================================================================

describe "admission conformance — U2 safetensors matrix" {
    test "rejects a truncated header prefix (format)" {
        assert admittas_result(_truncata(4), SAFE_HASH, "") ≡ "truncated safetensors header prefix"
    }

    test "rejects a header extending beyond the file (format)" {
        assert admittas_result(_truncata(500), SAFE_HASH, "") ≡ "truncated header — header size beyond file"
    }

    test "rejects a non-JSON header (format)" {
        assert admittas_result(_continer("garbage", _data_pattern(672)), SAFE_HASH, "") ≡ "unexpected character in header"
    }

    test "rejects a header that is not a JSON object (format)" {
        assert admittas_result(_continer("[1,2,3]", _data_pattern(672)), SAFE_HASH, "") ≡ "header is not a JSON object"
    }

    test "rejects trailing tokens after the top-level object (format)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON + ",\"x\":1", _data_pattern(672)), SAFE_HASH, "") ≡ "trailing tokens after the header object"
    }

    test "rejects a non-8-byte-aligned header (format)" {
        const list<int<u8>> mis ← _iunge(_caput8(841), _iunge(_textus_bytes(PRAESTOLATUM_JSON), _data_pattern(672)))
        assert admittas_result(mis, SAFE_HASH, "") ≡ "misaligned safetensors header (not 8-byte aligned)"
    }

    test "rejects an unsupported format name (version)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"format.name\":\"safetensors\"", "\"format.name\":\"gguf\""), _data_pattern(672)), SAFE_HASH, "") ≡ "unsupported safetensors format: gguf"
    }

    test "rejects an unsupported row version (version)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"format.version\":\"1.0.0\"", "\"format.version\":\"2.0.0\""), _data_pattern(672)), SAFE_HASH, "") ≡ "unsupported safetensors row version: 2.0.0"
    }

    test "rejects an architecture mismatch (arch)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"model.arch\":\"llama\"", "\"model.arch\":\"qwen2\""), _data_pattern(672)), SAFE_HASH, "") ≡ "architecture mismatch"
    }

    test "rejects a density-class mismatch (arch)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"model.density\":\"dense\"", "\"model.density\":\"sparse\""), _data_pattern(672)), SAFE_HASH, "") ≡ "architecture mismatch"
    }

    test "rejects a tensor outside the admitted row (arch)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"model.norm.weight\"", "\"output.weight\""), _data_pattern(672)), SAFE_HASH, "") ≡ "tensor not in admitted row: output.weight"
    }

    test "rejects a tensor-count mismatch (counts)" {
        const string six ← PRAESTOLATUM_JSON.replace("\"data_offsets\":[544,672]}}", "\"data_offsets\":[544,672]},\"model.layers.0.mlp.up_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,8],\"data_offsets\":[672,928]}}")
        assert admittas_result(_continer(six, _data_pattern(928)), SAFE_HASH, "") ≡ "tensor count mismatch"
    }

    test "rejects an unsupported dtype (dtype)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"dtype\":\"F32\"", "\"dtype\":\"F16\""), _data_pattern(672)), SAFE_HASH, "") ≡ "unsupported dtype: F16 for model.embed_tokens.weight"
    }

    test "rejects a duplicate tensor name (offset/table)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"model.layers.0.mlp.down_proj.weight\"", "\"model.embed_tokens.weight\""), _data_pattern(672)), SAFE_HASH, "") ≡ "duplicate tensor name: model.embed_tokens.weight"
    }

    test "rejects a misaligned tensor data offset (offset)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"data_offsets\":[0,128]", "\"data_offsets\":[4,132]"), _data_pattern(672)), SAFE_HASH, "") ≡ "misaligned tensor data offset: model.embed_tokens.weight"
    }

    test "rejects overlapping tensor data regions (offset)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"data_offsets\":[128,160]", "\"data_offsets\":[64,96]"), _data_pattern(672)), SAFE_HASH, "") ≡ "overlapping tensor data regions"
    }

    test "rejects a gapped data region — no exact tiling (offset)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON, _data_pattern(676)), SAFE_HASH, "") ≡ "data region does not tile exactly"
    }

    test "rejects a truncated data region (offset)" {
        assert admittas_result(_truncata(1000), SAFE_HASH, "") ≡ "data region truncated — tensor extends beyond file: model.layers.0.self_attn.q_proj.weight"
    }

    test "rejects a shape mismatch (shape)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"shape\":[8,4]", "\"shape\":[8,5]"), _data_pattern(672)), SAFE_HASH, "") ≡ "shape mismatch for model.embed_tokens.weight"
    }

    test "rejects a shape/offset byte-length inconsistency (shape)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"data_offsets\":[0,128]", "\"data_offsets\":[0,132]"), _data_pattern(672)), SAFE_HASH, "") ≡ "shape/offset inconsistency for model.embed_tokens.weight"
    }

    test "rejects a dimension above the ceiling (bounds)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"shape\":[8,4]", "\"shape\":[70000,4]"), _data_pattern(672)), SAFE_HASH, "") ≡ "dimension above ceiling"
    }

    test "rejects a total element count above the ceiling (bounds)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"shape\":[8,4]", "\"shape\":[65536,20000]"), _data_pattern(672)), SAFE_HASH, "") ≡ "element count above ceiling"
    }

    test "rejects a tensor name above the length ceiling (bounds)" {
        const string longe ← PRAESTOLATUM_JSON.replace("\"model.norm.weight\"", repetitio("x", 129))
        assert admittas_result(_continer(longe, _data_pattern(672)), SAFE_HASH, "") ≡ "tensor name above length ceiling"
    }

    test "rejects a tokenizer model mismatch (tokenizer)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"tokenizer.model\":\"gpt2\"", "\"tokenizer.model\":\"llama\""), _data_pattern(672)), SAFE_HASH, "") ≡ "tokenizer identity mismatch"
    }

    test "rejects a tokenizer EOG-set mismatch (tokenizer)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"tokenizer.eog\":\"0,2\"", "\"tokenizer.eog\":\"2,0\""), _data_pattern(672)), SAFE_HASH, "") ≡ "tokenizer identity mismatch"
    }

    test "rejects a tokenizer BOS-free mismatch (tokenizer)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"tokenizer.bos_free\":\"true\"", "\"tokenizer.bos_free\":\"false\""), _data_pattern(672)), SAFE_HASH, "") ≡ "tokenizer identity mismatch"
    }

    test "rejects a malformed vocabulary digest (tokenizer)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"tokenizer.vocab_digest\":\"" + F_VOCAB + "\"", "\"tokenizer.vocab_digest\":\"zz\""), _data_pattern(672)), SAFE_HASH, "") ≡ "malformed vocabulary digest"
    }

    test "rejects a malformed digest claim before the row is admitted" {
        assert admittas_result(fixatura(), "zz", "") ≡ "malformed digest value"
    }

    test "rejects a non-string metadata value (bounds/metadata)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"model.layers\":\"1\"", "\"model.layers\":1"), _data_pattern(672)), SAFE_HASH, "") ≡ "metadata value must be a string"
    }

    test "rejects a missing required metadata key (metadata)" {
        assert admittas_result(_continer(PRAESTOLATUM_JSON.replace("\"format.name\":\"safetensors\",", ""), _data_pattern(672)), SAFE_HASH, "") ≡ "missing required metadata key: format.name"
    }

    test "rejects a header with no __metadata__ — fails at the first required key (metadata)" {
        assert admittas_result(_continer("{\"model.norm.weight\":{\"dtype\":\"F32\",\"shape\":[8],\"data_offsets\":[0,32]}}", _data_pattern(32)), SAFE_HASH, "") ≡ "missing required metadata key: format.name"
    }
}

# =========================================================================
# U3 — GGUF fail-closed negative matrix (format/version/arch/dtype/quant/
# offset/shape/tokenizer/bounds/counts; every case = typed GgufError).
# =========================================================================

describe "admission conformance — U3 gguf matrix" {
    test "rejects bad magic (format)" {
        assert admissio_legitima(aedifica(int_bytes([0x47, 0x47, 0x55, 0x58]), 3, LEGAL_KVS, LEGAL_TENSORES, 0)) ≡ "not a GGUF file — bad magic"
    }

    test "rejects a truncated header (format)" {
        assert admissio_legitima(int_bytes([0x47, 0x47, 0x55, 0x46, 0, 0, 0, 3, 0, 0])) ≡ "truncated gguf header"
    }

    test "rejects an unsupported GGUF version (version)" {
        assert admissio_legitima(aedifica(magica(), 4, LEGAL_KVS, LEGAL_TENSORES, 0)) ≡ "unsupported GGUF version: 4"
    }

    test "rejects a u64 field above the integer carrier (counts)" {
        assert admissio_legitima(muta(legitima(), 15, 255)) ≡ "GGUF UINT64 value exceeds the numerus carrier"
    }

    test "rejects a metadata KV count mismatch (counts)" {
        assert admissio_result(legitima(), GGUF_DIGEST, 17, G_TENSORES, G_ELEMENTA, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8) ≡ "metadata KV count mismatch"
    }

    test "rejects a tensor count mismatch (counts)" {
        assert admissio_result(legitima(), GGUF_DIGEST, G_KV, 2, G_ELEMENTA, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8) ≡ "tensor count mismatch"
    }

    test "rejects expected kv count outside the admitted range (bounds)" {
        assert admissio_result(legitima(), GGUF_DIGEST, 0, G_TENSORES, G_ELEMENTA, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8) ≡ "expected kv count outside the admitted range"
    }

    test "rejects expected tensor count outside the admitted range (bounds)" {
        assert admissio_result(legitima(), GGUF_DIGEST, G_KV, 100000, G_ELEMENTA, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8) ≡ "expected tensor count outside the admitted range"
    }

    test "rejects expected element count above the ceiling (bounds)" {
        assert admissio_result(legitima(), GGUF_DIGEST, G_KV, G_TENSORES, 2000000000, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8) ≡ "expected element count outside the admitted range"
    }

    test "rejects per-type counts that do not sum to the tensor count (counts)" {
        assert admissio_result(legitima(), GGUF_DIGEST, G_KV, G_TENSORES, G_ELEMENTA, 2, G_Q4K, G_Q5, G_Q6, G_Q8) ≡ "expected tensor type counts do not sum to the tensor count"
    }

    test "rejects a metadata key above the 128-byte ceiling (bounds)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.name;s;smollm2-fixture", repetitio("k", 130) + ";s;x"), LEGAL_TENSORES, 0)) ≡ "metadata key exceeds the 128-byte ceiling"
    }

    test "rejects a string value above the authority text limit (bounds)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM", "tokenizer.chat_template;s;" + repetitio("v", 1048577)), LEGAL_TENSORES, 0)) ≡ "GGUF string exceeds the bounded text limit"
    }

    test "rejects an unknown metadata key (bounds/metadata)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.name;s;smollm2-fixture", "evil.key;s;x"), LEGAL_TENSORES, 0)) ≡ "unknown metadata key"
    }

    test "rejects a duplicate metadata key (bounds/metadata)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM", "general.name;s;dup"), LEGAL_TENSORES, 0)) ≡ "duplicate GGUF metadata key: general.name"
    }

    test "rejects a missing required key (arch)" {
        assert admissio_result(aedifica(magica(), 3, demptio(LEGAL_KVS, "general.architecture;s;llama"), LEGAL_TENSORES, 0), GGUF_DIGEST, 17, G_TENSORES, G_ELEMENTA, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8) ≡ "missing required metadata key: general.architecture"
    }

    test "rejects an architecture mismatch (arch)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.architecture;s;llama", "general.architecture;s;qwen2"), LEGAL_TENSORES, 0)) ≡ "architecture mismatch"
    }

    test "rejects a layer count mismatch (arch)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.block_count;u;32", "llama.block_count;u;16"), LEGAL_TENSORES, 0)) ≡ "layer count mismatch"
    }

    test "rejects a context length mismatch (arch)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.context_length;u;8192", "llama.context_length;u;4096"), LEGAL_TENSORES, 0)) ≡ "context length mismatch"
    }

    test "rejects a vocabulary size mismatch (arch)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.vocab_size;u;49152", "llama.vocab_size;u;32000"), LEGAL_TENSORES, 0)) ≡ "vocabulary size mismatch"
    }

    test "rejects an embedding size mismatch (arch)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "llama.embedding_length;u;960", "llama.embedding_length;u;512"), LEGAL_TENSORES, 0)) ≡ "embedding size mismatch"
    }

    test "rejects a file type mismatch (quant)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.file_type;u;15", "general.file_type;u;14"), LEGAL_TENSORES, 0)) ≡ "file type mismatch"
    }

    test "rejects a quantization version mismatch (quant)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.quantization_version;u;2", "general.quantization_version;u;1"), LEGAL_TENSORES, 0)) ≡ "quantization version mismatch"
    }

    test "rejects a wrong metadata value type (quant/arch)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "general.file_type;u;15", "general.file_type;s;15"), LEGAL_TENSORES, 0)) ≡ "metadata value is not an unsigned integer"
    }

    test "rejects a tokenizer model mismatch (tokenizer)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.model;s;gpt2", "tokenizer.ggml.model;s;tiktoken"), LEGAL_TENSORES, 0)) ≡ "tokenizer model mismatch"
    }

    test "rejects a pre-tokenizer mismatch (tokenizer)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.pre;s;smollm", "tokenizer.ggml.pre;s;o200k"), LEGAL_TENSORES, 0)) ≡ "tokenizer pre-tokenizer mismatch"
    }

    test "rejects a bos token id mismatch (tokenizer)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.bos_token_id;u;1", "tokenizer.ggml.bos_token_id;u;0"), LEGAL_TENSORES, 0)) ≡ "bos token id mismatch"
    }

    test "rejects an eos token id mismatch (tokenizer)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.eos_token_id;u;2", "tokenizer.ggml.eos_token_id;u;1"), LEGAL_TENSORES, 0)) ≡ "eos token id mismatch"
    }

    test "rejects add_bos_token set (tokenizer)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.add_bos_token;b;0", "tokenizer.ggml.add_bos_token;b;1"), LEGAL_TENSORES, 0)) ≡ "add_bos_token mismatch"
    }

    test "rejects add_space_prefix set (tokenizer)" {
        assert admissio_legitima(aedifica(magica(), 3, repone(LEGAL_KVS, "tokenizer.ggml.add_space_prefix;b;0", "tokenizer.ggml.add_space_prefix;b;1"), LEGAL_TENSORES, 0)) ≡ "add_space_prefix mismatch"
    }

    test "rejects an unknown ggml tensor type (dtype)" {
        assert admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "token_embd.weight;8;32,16;auto", "token_embd.weight;2;32,16;auto"), 0)) ≡ "unknown ggml tensor type"
    }

    test "rejects a tensor whose elements are not a block multiple (quant)" {
        assert admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "token_embd.weight;8;32,16;auto", "token_embd.weight;8;8,7;auto"), 0)) ≡ "tensor first dimension is not a complete GGML block"
    }

    test "rejects a tensor byte size not aligned to 32 (quant)" {
        assert admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "token_embd.weight;8;32,16;auto", "token_embd.weight;6;64;auto"), 0)) ≡ "tensor byte size not a multiple of the 32-byte data alignment"
    }

    test "rejects a per-type tensor count mismatch (quant)" {
        assert admissio_result(legitima(), GGUF_DIGEST, G_KV, G_TENSORES, G_ELEMENTA, G_F32, G_Q4K, 1, G_Q6, G_Q8) ≡ "tensor type count mismatch"
    }

    test "rejects an unsupported tensor rank (shape)" {
        assert admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;4,4,2;auto"), 0)) ≡ "unsupported tensor rank"
    }

    test "rejects a dimension above the 65536 ceiling (shape)" {
        assert admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "token_embd.weight;8;32,16;auto", "token_embd.weight;8;65568,1;auto"), 0)) ≡ "invalid tensor dimension"
    }

    test "rejects a zero dimension (shape)" {
        assert admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;0;auto"), 0)) ≡ "tensor dimension is outside the bounded range"
    }

    test "rejects a total element count mismatch (shape)" {
        assert admissio_result(legitima(), GGUF_DIGEST, G_KV, G_TENSORES, 4625, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8) ≡ "total element count mismatch"
    }

    test "rejects non-contiguous tensor offsets (offset)" {
        assert admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;16;300"), 0)) ≡ "known GGML tensor ranges overlap"
    }

    test "rejects overlapping/duplicate tensor offsets (offset)" {
        assert admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "blk.0.attn_norm.weight;0;16;0"), 0)) ≡ "known GGML tensor ranges overlap"
    }

    test "rejects a duplicate tensor name (offset/table)" {
        assert admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", "token_embd.weight;8;32,16;auto"), 0)) ≡ "duplicate GGUF tensor name: token_embd.weight"
    }

    test "rejects an empty tensor name (offset/table)" {
        assert admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", ";0;16;auto"), 0)) ≡ "empty tensor name"
    }

    test "rejects a tensor name above the 128-byte ceiling (bounds)" {
        assert admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, repone(LEGAL_TENSORES, "blk.0.attn_norm.weight;0;16;auto", repetitio("w", 130) + ";0;16;auto"), 0)) ≡ "tensor name exceeds the 128-byte ceiling"
    }

    test "rejects a truncated data region (offset)" {
        assert admissio_legitima(excerpe(legitima(), legitima().length() - 100)) ≡ "known GGML tensor range exceeds the artifact"
    }

    test "rejects trailing bytes in the data region (offset)" {
        assert admissio_legitima(aedifica(magica(), 3, LEGAL_KVS, LEGAL_TENSORES, 100)) ≡ "data region does not tile exactly"
    }
}

# =========================================================================
# U4 — Tokenizer fail-closed negative matrix (version/kind/bounds/probe
# parity/wire; every case = typed TokenizerError).
# =========================================================================

describe "admission conformance — U4 tokenizer matrix" {
    test "a diverging id list fails closed (probe parity)" {
        assert proba_result("p10", [504, 2365, 6354, 16438, 27003, 690, 260, 23790]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p10"
    }

    test "a reordered id list fails closed (probe parity)" {
        assert proba_result("p11", [905, 19556]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p11"
    }

    test "a length-mismatched id list fails closed (probe parity)" {
        assert proba_result("p6", [44, 108, 306, 79, 3738, 108]) ≡ "tokenizer ids diverge from the pinned llama.cpp probe: p6"
    }

    test "an unknown probe name fails closed (probe parity)" {
        assert proba_result("p99", [1]) ≡ "unknown pinned probe: p99"
    }

    test "a non-digit pinned id fails closed (bounds)" {
        do {
            const list<int> ids ← tokenizator.probe_id("1,xx")
            assert false
        }
        catch err {
            assert tokenizator.message(err) ≡ "non-digit token id in pinned fixture"
        }
    }

    test "an out-of-range pinned id fails closed (bounds)" {
        do {
            const list<int> ids ← tokenizator.probe_id("999999")
            assert false
        }
        catch err {
            assert tokenizator.message(err) ≡ "token id out of range: 999999"
        }
    }

    test "rejects an unknown schema version (version)" {
        assert structa_result("2.0.0", T_KIND, T_PRE, F_VOCAB, C_EOG, C_BOS, C_SPATIUM) ≡ "unknown tokenizer identity schema version: 2.0.0"
    }

    test "rejects an un-admitted tokenizer kind (kind)" {
        assert structa_result(T_SCHEMA, "llama", T_PRE, F_VOCAB, C_EOG, C_BOS, C_SPATIUM) ≡ "un-admitted tokenizer kind: llama (pinned row is gpt2 / byte-level BPE)"
    }

    test "rejects an un-admitted pre-tokenizer (pre)" {
        assert structa_result(T_SCHEMA, T_KIND, "gpt2", F_VOCAB, C_EOG, C_BOS, C_SPATIUM) ≡ "un-admitted pre-tokenizer: gpt2 (pinned row is smollm)"
    }

    test "rejects a malformed vocabulary digest (bounds)" {
        assert structa_result(T_SCHEMA, T_KIND, T_PRE, "zz", C_EOG, C_BOS, C_SPATIUM) ≡ "malformed vocabulary digest"
    }

    test "rejects a malformed EOG set (bounds)" {
        assert structa_result(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, "2,0", C_BOS, C_SPATIUM) ≡ "malformed EOG set"
    }

    test "rejects a non-BOS-free row (tokenizer facts)" {
        assert structa_result(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, C_EOG, false, C_SPATIUM) ≡ "pinned row is BOS-free (add_bos_token = false)"
    }

    test "rejects a space-prefixed row (tokenizer facts)" {
        assert structa_result(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, C_EOG, C_BOS, false) ≡ "pinned row is space-prefix-free (add_space_prefix = false)"
    }

    test "verifica passes on an admitted identity (self-verifying contract)" {
        do {
            const tokenizator.TokenizerIdentity t ← tokenizator.construct(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, C_EOG, C_BOS, C_SPATIUM)
            assert verifica_result(t) ≡ "ok"
        }
        catch err {
            assert false
        }
    }

    test "the KV identity key component (MD-A9) is deterministic and carries the pinned facts" {
        do {
            const tokenizator.TokenizerIdentity a ← tokenizator.construct(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, C_EOG, C_BOS, C_SPATIUM)
            const tokenizator.TokenizerIdentity b ← tokenizator.construct(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, C_EOG, C_BOS, C_SPATIUM)
            assert clavis_result(a) ≡ "ok|tokenizer/identity/1.0.0/gpt2/smollm/" + F_VOCAB + "/0,2/bos-free=true/space-prefix-free=true"
            assert clavis_result(a) ≡ clavis_result(b)
        }
        catch err {
            assert false
        }
    }

    test "deserialization rejects an unknown schema version (version/wire)" {
        assert wire_result("tokenizer/identity/2.0.0/gpt2/smollm/" + F_VOCAB + "/0,2") ≡ "unknown tokenizer identity schema version: 2.0.0"
    }

    test "deserialization rejects an unknown marker (format/wire)" {
        assert wire_result("model/identity/1.0.0/gpt2/smollm/" + F_VOCAB + "/0,2") ≡ "unknown tokenizer identity marker"
    }

    test "deserialization rejects a malformed wire form (format/wire)" {
        assert wire_result("tokenizer/identity/1.0.0/gpt2") ≡ "malformed tokenizer identity wire form"
    }

    test "deserialization rejects a malformed digest (bounds/wire)" {
        assert wire_result("tokenizer/identity/1.0.0/gpt2/smollm/zz/0,2") ≡ "malformed vocabulary digest"
    }
}

# =========================================================================
# U1 — Capsule identity fail-closed negative matrix (schema-2 surface:
# structa_manifestum / verifica / verifica_contra / deserializa_identitas;
# version/algorithm/digest/bytes/manifest/bounds/wire; every case = typed
# AdmissionError). Schema-1-constructor-only dimensions (quant row, capsule
# tokenizer/arch facts, Limites) are validated at the caller boundary in
# U2/U3 and asserted there; the retired stamp is rejected here (SchemaVetus).
# =========================================================================

describe "admission conformance — U1 capsule matrix" {
    test "rejects the retired schema-1 stamp (version)" {
        assert structa_result_capsulae("1.0.0", identitas_capsulae(), manifestum_capsulae()) ≡ "schema 1 is retired — capsule schema is 2.0.0"
    }

    test "rejects an unknown capsule schema version (version)" {
        assert structa_result_capsulae("3.0.0", identitas_capsulae(), manifestum_capsulae()) ≡ "unknown capsule schema version: 3.0.0"
    }

    test "rejects an un-admitted digest algorithm (algorithm)" {
        assert structa_result_capsulae(C_SCHEMA, identitas_capsulae_variata("md5", C_DIGEST, C_LONGITUDO), manifestum_capsulae()) ≡ "unknown digest algorithm: md5"
    }

    test "rejects a malformed digest value (digest)" {
        assert structa_result_capsulae(C_SCHEMA, identitas_capsulae_variata(C_ALGO, "abc", C_LONGITUDO), manifestum_capsulae()) ≡ "malformed digest value"
    }

    test "rejects a non-positive artifact byte length (bytes)" {
        assert structa_result_capsulae(C_SCHEMA, identitas_capsulae_variata(C_ALGO, C_DIGEST, 0), manifestum_capsulae()) ≡ "invalid artifact byte length"
    }

    test "rejects a manifest whose artifact length does not match the identity (bytes)" {
        assert structa_result_capsulae(C_SCHEMA, identitas_capsulae(), manifestum_capsulae_variata("safetensors", "1.0.0", 2048, C_DATORUM, tensores_capsulae())) ≡ "manifestum is inconsistent with the artifact identity"
    }

    test "rejects a data region larger than the artifact (bounds)" {
        assert structa_result_capsulae(C_SCHEMA, identitas_capsulae(), manifestum_capsulae_variata("safetensors", "1.0.0", C_LONGITUDO, 2048, tensores_capsulae())) ≡ "manifestum is inconsistent with the artifact identity"
    }

    test "rejects an empty tensor shape (shape)" {
        assert structa_result_capsulae(C_SCHEMA, identitas_capsulae(), manifestum_capsulae_variata("safetensors", "1.0.0", C_LONGITUDO, C_DATORUM, [descriptio_capsulae("w", "F32", [], 0, 128, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    test "rejects a tensor whose element count does not match the shape (shape)" {
        assert structa_result_capsulae(C_SCHEMA, identitas_capsulae(), manifestum_capsulae_variata("safetensors", "1.0.0", C_LONGITUDO, C_DATORUM, [descriptio_capsulae("w", "F32", [8, 4], 0, 128, 31)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    test "rejects a tensor range beyond the data region (bounds/coverage)" {
        assert structa_result_capsulae(C_SCHEMA, identitas_capsulae(), manifestum_capsulae_variata("safetensors", "1.0.0", C_LONGITUDO, C_DATORUM, [descriptio_capsulae("w", "F32", [8, 4], 0, 161, 32)])) ≡ "manifestum is inconsistent with the artifact identity"
    }

    test "verifica rejects a schema-1-stamped capsule (version)" {
        do {
            const capsula.Capsule vetus ← capsula.Capsule { schema = "1.0.0", identitas = identitas_capsulae(), manifestum = capsula.safetensors_manifest(manifestum_capsulae()) }
            assert verifica_result_capsulae(vetus) ≡ "schema 1 is retired — capsule schema is 2.0.0"
        }
        catch err {
            assert false
        }
    }

    test "wire deserialization rejects an unknown schema version (version)" {
        assert identitas_wire_result("capsule/identity/3.0.0/sha-256/" + C_DIGEST + "/" + (C_LONGITUDO ↦ string)) ≡ "unknown capsule schema version: 3.0.0"
    }

    test "wire deserialization rejects the retired schema-1 wire (version)" {
        assert identitas_wire_result("capsule/identity/1.0.0/sha-256/" + C_DIGEST + "/" + (C_LONGITUDO ↦ string)) ≡ "schema 1 is retired — capsule schema is 2.0.0"
    }

    test "wire deserialization rejects an unknown marker (format)" {
        assert identitas_wire_result("model/identity/2.0.0/sha-256/" + C_DIGEST + "/" + (C_LONGITUDO ↦ string)) ≡ "unknown capsule identity marker"
    }

    test "wire deserialization rejects a malformed wire form (format)" {
        assert identitas_wire_result("capsule/identity/2.0.0/sha-256") ≡ "malformed capsule identity wire form"
    }

    test "wire deserialization rejects a 9-segment non-schema-1 wire (format)" {
        assert identitas_wire_result("capsule/identity/3.0.0/sha-256/" + C_DIGEST + "/4/q4_k/llama/16") ≡ "malformed capsule identity wire form"
    }

    test "wire deserialization rejects an un-admitted digest algorithm (algorithm)" {
        assert identitas_wire_result("capsule/identity/2.0.0/md5/" + C_DIGEST + "/" + (C_LONGITUDO ↦ string)) ≡ "unknown digest algorithm: md5"
    }

    test "wire deserialization rejects a malformed digest (digest)" {
        assert identitas_wire_result("capsule/identity/2.0.0/sha-256/zz/" + (C_LONGITUDO ↦ string)) ≡ "malformed digest value"
    }

    test "wire deserialization rejects a non-numeric byte length (bytes)" {
        assert identitas_wire_result("capsule/identity/2.0.0/sha-256/" + C_DIGEST + "/many") ≡ "malformed numeric field"
    }

    test "wire deserialization rejects a non-positive byte length (bytes)" {
        assert identitas_wire_result("capsule/identity/2.0.0/sha-256/" + C_DIGEST + "/0") ≡ "invalid byte length in capsule identity"
    }
}
