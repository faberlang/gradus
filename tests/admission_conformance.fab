+++
locale = "la"
+++
# PML2-U6 — Admission conformance suite: the committed fail-closed negative
# matrix across U2/U3/U4 (aggregate admission proof, council C8).
#
# This is the AGGREGATE conformance gate for model admission. It commits
# the full negative matrix across the four landed admission rows:
#   U1  gradus:model/capsule       — the admitted-model capsule root
#                                    (capsule-schema-2.0.0, A1C-M1).
#   U2  gradus:model/safetensors   — Safetensors row admission.
#   U3  gradus:model/gguf          — GGUF row admission.
#   U4  gradus:tokenizer           — tokenizer identity contract
#                                    (tokenizer-identity-schema-1.0.0).
#
# A1C-M4: the suite composes the schema-2 admission surface only. The
# retired capsule-schema-1.0.0 constructor is gone; gguf.admit and
# safetensors.admittas return the schema-2 capsule (pathless content
# identity + per-format manifest), and the U1 capsule matrix drives
# structa_manifestum / verifica / verifica_contra / deserializa_identitas
# including the schema-1 rejection at the boundary (SchemaVetus).
# Importa (self-contained conformance file; consumed read-only from the
# landed modules — src/model/*.fab and src/tokenizer.fab are NOT touched).
importa ex "gradus:model/safetensors" safetensors
importa ex "gradus:model/gguf" gguf
importa ex "gradus:model/capsule" capsula
importa ex "gradus:model/artifact" artifact
importa ex "gradus:tokenizer" tokenizator

# --- Dimension matrix (done_when: format/version/arch/dtype/quant/offset/
# shape/tokenizer/bounds/counts — every negative case fails closed BEFORE
# any allocation or launch sized by a parsed count; a typed rejection means
# no Capsula is ever produced, so no downstream load/launch is reachable).
#
#   dimension   | U2 safetensors            | U3 gguf                 | U4 tokenizer / U1 capsule
#   ------------+---------------------------+-------------------------+------------------------------
#   format      | header/JSON form          | magic / header          | wire markers (U1/U4)
#   version     | row version, format name  | GGUF version            | schema versions (U1/U4)
#   arch        | metadata facts, tensor    | arch/layers/ctx/vocab/  | architectura facts (U1)
#               | table                     | embedding               |
#   dtype       | tensor dtype              | ggml tensor type        | — (F32-only row; U1 quant)
#   quant       | F32 row (U1 quant row)    | file_type/quant ver/    | quantization row (U1)
#               |                           | block layout/type count |
#   offset      | data_offsets, tiling      | tensor offsets, tiling  | — (bytes coverage, U1)
#   shape       | shape/offset consistency  | rank/dims/element count | — (shape via bounds, U1)
#   tokenizer   | metadata identity facts   | metadata identity facts | kind/pre/digest/EOG/parity
#   bounds      | ceilings (name/dim/elem)  | ceilings (key/string)   | Limites (U1), vocab range
#   counts      | kv/tensor count ceilings  | kv/tensor/element count | — (Limites mirrors, U1)
#
# Every negative probe below asserts the EXACT typed-error causa string the
# landed module produces for that mutation (source-derived; nothing is
# asserted that the admission code does not throw). "fail closed before
# allocation or launch" is the code's own posture (ceiling checks precede
# count-driven iteration; the capsule constructor validates every field
# group before the value is built) — this suite commits the matrix that
# exercises every one of those paths.
#
# --- Compiler boundary note (honest) -------------------------------------
# Proba proof is compile-level: `faber check tests/admission_conformance.fab`
# proves the whole surface (imports, probandum blocks, wrappers, assertions)
# type-checks. The adfirma assertions execute under the cargo-backed
# `faber test` harness, which is auditor-owned; execution is env-blocked
# tree-wide today (missing locale pack / FMIR stepper — recorded residual,
# same seam as capsule.proba / safetensors.proba / gguf.proba). No
# execution evidence is claimed here. The assertions are pinned to the
# source-traced error strings so the gate is true at first execution.

# =========================================================================
# §0 Pinned oracle facts (cited read-only from the committed fixtures)
# =========================================================================

# U2 — fixtures/safetensors/safetensors-row-oracle.md.
fixum textus SAFE_HASH ← "424442296e97c261de42fd496cc6cdb4496f3f632835479de96a7ed76c5f75d8"
# U3 — fixtures/gguf/gguf-row-oracle.md.
fixum textus GGUF_DIGEST ← "d89c9ef917158bfb5600f417020479499c6c042f728e9a29c8457a6b1a8f0974"
# Shared form-valid digest fixtures.
fixum textus F_VOCAB ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
fixum textus F_ALIA ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# =========================================================================
# §1 U2 — Safetensors byte builders (mirror of the committed generator
# fixtures/safetensors/gen_fixture.py and src/model/safetensors.proba).
# =========================================================================

fixum textus PRAESTOLATUM_JSON ← "{\"__metadata__\":{\"format.name\":\"safetensors\",\"format.version\":\"1.0.0\",\"model.arch\":\"llama\",\"model.density\":\"dense\",\"model.layers\":\"1\",\"model.context\":\"2048\",\"tokenizer.model\":\"gpt2\",\"tokenizer.pre\":\"smollm\",\"tokenizer.vocab_digest\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"tokenizer.eog\":\"0,2\",\"tokenizer.bos_free\":\"true\",\"tokenizer.space_prefix_free\":\"true\"},\"model.embed_tokens.weight\":{\"dtype\":\"F32\",\"shape\":[8,4],\"data_offsets\":[0,128]},\"model.norm.weight\":{\"dtype\":\"F32\",\"shape\":[8],\"data_offsets\":[128,160]},\"model.layers.0.self_attn.q_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,8],\"data_offsets\":[160,416]},\"model.layers.0.self_attn.v_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,4],\"data_offsets\":[416,544]},\"model.layers.0.mlp.down_proj.weight\":{\"dtype\":\"F32\",\"shape\":[4,8],\"data_offsets\":[544,672]}}"

fixum numerus PRAESTOLATUM_DATA_LONGITUDO ← 672
fixum numerus PRAESTOLATUM_LONGITUDO ← 1512

# 8-byte little-endian header-size prefix (header_size includes the prefix).
functio _caput8(numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    out.appende((n ⇒ 0) ↦ numerus<u8>)
    out.appende((n ⇒ 8) ↦ numerus<u8>)
    out.appende((n ⇒ 16) ↦ numerus<u8>)
    out.appende((n ⇒ 24) ↦ numerus<u8>)
    out.appende((n ⇒ 32) ↦ numerus<u8>)
    out.appende((n ⇒ 40) ↦ numerus<u8>)
    out.appende((n ⇒ 48) ↦ numerus<u8>)
    out.appende((n ⇒ 56) ↦ numerus<u8>)
    redde out
}

# textus -> UTF-8 byte list.
functio _textus_bytes(textus s) → lista<numerus<u8>> {
    fixum octeti o ← s ↦ octeti
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < o.longitudo() {
        out.appende(o.accipe(i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    redde out
}

# Concatenate two byte lists.
functio _iunge(lista<numerus<u8>> a, lista<numerus<u8>> b) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    itera ex a fixum x { out.appende(x) }
    itera ex b fixum x { out.appende(x) }
    redde out
}

# Deterministic data-byte pattern (matches the generator: byte k = (k*13+7)%256).
functio _data_pattern(numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < n {
        out.appende(((i * 13 + 7) % 256) ↦ numerus<u8>)
        i ← i + 1
    }
    redde out
}

# Assemble a Safetensors container: LE prefix + 8-aligned padded header +
# data region (header padded with spaces; header_size includes the prefix).
functio _continer(textus caput_json, lista<numerus<u8>> data) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> hb ← _textus_bytes(caput_json)
    fixum numerus n ← hb.longitudo()
    fixum numerus aligned ← ((n + 7) / 8) * 8
    varia lista<numerus<u8>> padded ← vacua
    itera ex hb fixum x { padded.appende(x) }
    varia numerus i ← n
    dum i < aligned {
        padded.appende(32 ↦ numerus<u8>)
        i ← i + 1
    }
    fixum numerus caput ← aligned + 8
    redde _iunge(_iunge(_caput8(caput), padded), data)
}

# The pinned legal fixture, reconstructed byte-for-byte (1512 bytes, oracle
# SHA-256 42444229…5f75d8).
functio fixatura() → lista<numerus<u8>> {
    redde _continer(PRAESTOLATUM_JSON, _data_pattern(PRAESTOLATUM_DATA_LONGITUDO))
}

# First n bytes only (truncation mutants).
functio _truncata(numerus n) → lista<numerus<u8>> {
    redde fixatura().prima(n)
}

# Admission outcome as textus: "ok" or the typed error's causa.
functio admittas_result(lista<numerus<u8>> corpus, textus digestio, textus semita) → textus {
    fac {
        fixum capsula.Capsula c ← safetensors.admittas(corpus, digestio, semita)
        redde "ok"
    }
    cape err {
        redde safetensors.causa(err)
    }
}

# =========================================================================
# §2 U3 — GGUF v3 byte builders (mirror of src/model/gguf.proba and the
# committed generator fixtures/gguf/gen_fixture.py).
# =========================================================================

# The GGUF magic, as bytes.
functio magica() → lista<numerus<u8>> {
    redde bytes([0x47, 0x47, 0x55, 0x46])
}

# The 15 identity-bearing required keys + 3 optional admitted keys. KV
# codec: "key;type;value" (type s=string, u=u32, b=bool, as=array[string]).
fixum lista<textus> LEGAL_KVS ← [
    "general.architecture;s;llama",
    "general.file_type;u;15",
    "general.quantization_version;u;2",
    "llama.block_count;u;32",
    "llama.context_length;u;8192",
    "llama.vocab_size;u;49152",
    "llama.embedding_length;u;960",
    "tokenizer.ggml.model;s;gpt2",
    "tokenizer.ggml.pre;s;smollm",
    "tokenizer.ggml.bos_token_id;u;1",
    "tokenizer.ggml.eos_token_id;u;2",
    "tokenizer.ggml.padding_token_id;u;2",
    "tokenizer.ggml.unknown_token_id;u;0",
    "tokenizer.ggml.add_bos_token;b;0",
    "tokenizer.ggml.add_space_prefix;b;0",
    "general.name;s;smollm2-fixture",
    "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM",
    "general.languages;as;en"
]

# Tensor codec: "name;type;d1,d2;offset" (offset auto = cumulative, or a
# literal relative offset). Q8_0 [32,16] = 512 elems = 544 B; F32 [16] =
# 64 B; Q4_K [256,16] = 4096 elems = 2304 B; total 2912 B, 32-multiples.
fixum lista<textus> LEGAL_TENSORES ← [
    "token_embd.weight;8;32,16;auto",
    "blk.0.attn_norm.weight;0;16;auto",
    "blk.0.ffn_down.weight;12;256,16;auto"
]

fixum numerus G_KV ← 18
fixum numerus G_TENSORES ← 3
fixum numerus G_ELEMENTA ← 4624
fixum numerus G_F32 ← 1
fixum numerus G_Q4K ← 1
fixum numerus G_Q5 ← 0
fixum numerus G_Q6 ← 0
fixum numerus G_Q8 ← 1

functio bytes(lista<numerus> vals) → lista<numerus<u8>> {
    varia lista<numerus<u8>> bs ← vacua
    itera ex vals fixum v {
        bs.appende(v ↦ numerus<u8>)
    }
    redde bs
}

functio octeti_bytes(textus s) → lista<numerus<u8>> {
    fixum octeti o ← s ↦ octeti
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < o.longitudo() {
        out.appende(o.accipe(i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    redde out
}

functio add(lista<numerus<u8>> acc, lista<numerus<u8>> piece) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    itera ex acc fixum byte {
        out.appende(byte)
    }
    itera ex piece fixum byte {
        out.appende(byte)
    }
    redde out
}

functio u32_le(numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    out.appende((n ⇒ 0) ↦ numerus<u8>)
    out.appende((n ⇒ 8) ↦ numerus<u8>)
    out.appende((n ⇒ 16) ↦ numerus<u8>)
    out.appende((n ⇒ 24) ↦ numerus<u8>)
    redde out
}

functio u64_le(numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    out.appende((n ⇒ 0) ↦ numerus<u8>)
    out.appende((n ⇒ 8) ↦ numerus<u8>)
    out.appende((n ⇒ 16) ↦ numerus<u8>)
    out.appende((n ⇒ 24) ↦ numerus<u8>)
    out.appende((n ⇒ 32) ↦ numerus<u8>)
    out.appende((n ⇒ 40) ↦ numerus<u8>)
    out.appende((n ⇒ 48) ↦ numerus<u8>)
    out.appende((n ⇒ 56) ↦ numerus<u8>)
    redde out
}

functio stringa(textus s) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← u64_le(s.longitudo())
    varia lista<numerus<u8>> body ← octeti_bytes(s)
    itera ex body fixum byte {
        out.appende(byte)
    }
    redde out
}

# textus → numerus (well-formed fixture strings; 0 on malformed).
functio numerus_a(textus s) → numerus {
    fac {
        fixum numerus v ← s ↦ numerus
        redde v
    }
    cape err {
        redde 0
    }
}

functio repetitio(textus s, numerus n) → textus {
    varia textus out ← ""
    varia numerus i ← 0
    dum i < n {
        out ← out + s
        i ← i + 1
    }
    redde out
}

# "key;type;value" → KV bytes (string | u32 | bool | array-of-string).
functio codex_kv(textus codex) → lista<numerus<u8>> {
    fixum lista<textus> partes ← codex.divide(";")
    fixum textus clavis ← partes.accipe(0) vel ""
    fixum textus typo ← partes.accipe(1) vel ""
    fixum textus valor ← partes.accipe(2) vel ""
    varia lista<numerus<u8>> out ← stringa(clavis)
    si typo ≡ "s" {
        out ← add(out, u32_le(8))
        out ← add(out, stringa(valor))
    }
    si typo ≡ "u" {
        out ← add(out, u32_le(4))
        out ← add(out, u32_le(numerus_a(valor)))
    }
    si typo ≡ "b" {
        out ← add(out, u32_le(7))
        si valor ≡ "1" {
            out.appende(1 ↦ numerus<u8>)
        }
        secus {
            out.appende(0 ↦ numerus<u8>)
        }
    }
    si typo ≡ "as" {
        out ← add(out, u32_le(9))
        out ← add(out, u32_le(8))
        fixum lista<textus> elems ← valor.divide(",")
        out ← add(out, u64_le(elems.longitudo()))
        itera ex elems fixum e {
            out ← add(out, stringa(e))
        }
    }
    redde out
}

# "name;type;d1,d2;offset" → tensor-info bytes (offset relative to the
# data-section start; auto = running cumulative).
functio codex_tensor(textus codex, numerus cursus) → lista<numerus<u8>> {
    fixum lista<textus> partes ← codex.divide(";")
    fixum textus nomen ← partes.accipe(0) vel ""
    fixum textus typo ← partes.accipe(1) vel ""
    fixum textus forma ← partes.accipe(2) vel ""
    fixum textus offset_s ← partes.accipe(3) vel "auto"
    varia lista<numerus<u8>> out ← stringa(nomen)
    fixum lista<textus> dims ← forma.divide(",")
    out ← add(out, u32_le(dims.longitudo()))
    itera ex dims fixum dd {
        out ← add(out, u64_le(numerus_a(dd)))
    }
    out ← add(out, u32_le(numerus_a(typo)))
    varia numerus off_val ← cursus
    si offset_s ≠ "auto" {
        off_val ← numerus_a(offset_s)
    }
    out ← add(out, u64_le(off_val))
    redde out
}

# Flat byte size of a tensor (block layout mirrors the admitted GGML
# table: F32 1/4, Q5_0 32/22, Q8_0 32/34, Q4_K 256/144, Q6_K 256/210).
functio tensor_magnitudo(textus codex) → numerus {
    fixum lista<textus> partes ← codex.divide(";")
    fixum numerus typo ← numerus_a(partes.accipe(1) vel "")
    fixum lista<textus> dims ← (partes.accipe(2) vel "").divide(",")
    varia numerus nelems ← 1
    itera ex dims fixum dd {
        nelems ← nelems * numerus_a(dd)
    }
    varia numerus blocci ← 1
    si typo ≡ 0 { blocci ← 1 }
    si typo ≡ 6 { blocci ← 32 }
    si typo ≡ 8 { blocci ← 32 }
    si typo ≡ 12 { blocci ← 256 }
    si typo ≡ 14 { blocci ← 256 }
    varia numerus octeti ← 1
    si typo ≡ 0 { octeti ← 4 }
    si typo ≡ 6 { octeti ← 22 }
    si typo ≡ 8 { octeti ← 34 }
    si typo ≡ 12 { octeti ← 144 }
    si typo ≡ 14 { octeti ← 210 }
    redde (nelems / blocci) * octeti
}

# Full GGUF v3 file from codec lists. extra_data appends trailing bytes to
# the data region (coverage mutants). Data section starts at align32(end
# of the tensor table); tensor offsets are cumulative relative.
functio aedifica(
    lista<numerus<u8>> magica,
    numerus versio,
    lista<textus> kvs,
    lista<textus> tensores,
    numerus extra_data
) → lista<numerus<u8>> {
    varia lista<numerus<u8>> f ← vacua
    itera ex magica fixum byte {
        f.appende(byte)
    }
    f ← add(f, u32_le(versio))
    f ← add(f, u64_le(tensores.longitudo()))
    f ← add(f, u64_le(kvs.longitudo()))
    itera ex kvs fixum k {
        f ← add(f, codex_kv(k))
    }
    varia numerus cursus ← 0
    itera ex tensores fixum tt {
        f ← add(f, codex_tensor(tt, cursus))
        cursus ← cursus + tensor_magnitudo(tt)
    }
    fixum numerus finis_mensae ← f.longitudo()
    varia numerus data_inceptum ← finis_mensae
    si data_inceptum % 32 ≠ 0 {
        fixum numerus pad ← 32 - data_inceptum % 32
        varia numerus p ← 0
        dum p < pad {
            f.appende(0 ↦ numerus<u8>)
            p ← p + 1
        }
        data_inceptum ← data_inceptum + pad
    }
    varia numerus tot ← 0
    itera ex tensores fixum tt {
        tot ← tot + tensor_magnitudo(tt)
    }
    varia numerus z ← 0
    dum z < tot + extra_data {
        f.appende(((z * 13 + 7) % 256) ↦ numerus<u8>)
        z ← z + 1
    }
    redde f
}

# The pinned legal fixture (scaled structural replica).
functio legitima() → lista<numerus<u8>> {
    redde aedifica(magica(), 3, LEGAL_KVS, LEGAL_TENSORES, 0)
}

# List replacement / removal for mutants.
functio repone(lista<textus> xs, textus veterem, textus novam) → lista<textus> {
    varia lista<textus> out ← vacua
    itera ex xs fixum x {
        si x ≡ veterem {
            out.appende(novam)
        }
        secus {
            out.appende(x)
        }
    }
    redde out
}

functio demptio(lista<textus> xs, textus veterem) → lista<textus> {
    varia lista<textus> out ← vacua
    itera ex xs fixum x {
        si x ≠ veterem {
            out.appende(x)
        }
    }
    redde out
}

# Byte mutation / truncation.
functio muta(lista<numerus<u8>> b, numerus off, numerus valor) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < b.longitudo() {
        si i ≡ off {
            out.appende(valor ↦ numerus<u8>)
        }
        secus {
            out.appende(b.accipe(i) vel (0 ∷ numerus<u8>))
        }
        i ← i + 1
    }
    redde out
}

functio excerpe(lista<numerus<u8>> b, numerus n) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    varia numerus i ← 0
    dum i < n {
        out.appende(b.accipe(i) vel (0 ∷ numerus<u8>))
        i ← i + 1
    }
    redde out
}

# -- GGUF admission outcome helpers ---------------------------------------

functio admissio_result(
    lista<numerus<u8>> bytes_f,
    textus digestio,
    numerus expectatum_kv,
    numerus expectatum_tensorum,
    numerus expectatum_elementa,
    numerus expectatum_f32,
    numerus expectatum_q4k,
    numerus expectatum_q5,
    numerus expectatum_q6,
    numerus expectatum_q8
) → textus {
    fac {
        fixum capsula.Capsula c ← gguf.admit(bytes_f, digestio, expectatum_kv, expectatum_tensorum, expectatum_elementa, expectatum_f32, expectatum_q4k, expectatum_q5, expectatum_q6, expectatum_q8)
        redde "ok"
    }
    cape err {
        redde gguf.causa(err)
    }
}

# Admission with the legal fixture's contract.
functio admissio_legitima(lista<numerus<u8>> bytes_f) → textus {
    redde admissio_result(bytes_f, GGUF_DIGEST, G_KV, G_TENSORES, G_ELEMENTA, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8)
}

# =========================================================================
# §3 U4 — Tokenizer wrappers (src/tokenizer.proba seam).
# =========================================================================

fixum textus T_SCHEMA ← "1.0.0"
fixum textus T_KIND ← "gpt2"
fixum textus T_PRE ← "smollm"

# verifica_proba outcome as textus ("ok" or the typed error's causa).
functio proba_result(textus nomen, lista<numerus> observata) → textus {
    fac {
        fixum bivalens ok ← tokenizator.verifica_proba(nomen, observata)
        redde "ok"
    }
    cape err {
        redde tokenizator.causa(err)
    }
}

# structa outcome as textus ("ok" on success, or the typed error's causa).
functio structa_result(
    textus schema,
    textus progenies,
    textus pre_tokenizator,
    textus digestio_vocabuli,
    textus eog,
    bivalens bos_vacua,
    bivalens spatium_vacua
) → textus {
    fac {
        fixum tokenizator.IdentitasTokenizator t ← tokenizator.structa(schema, progenies, pre_tokenizator, digestio_vocabuli, eog, bos_vacua, spatium_vacua)
        redde "ok"
    }
    cape err {
        redde tokenizator.causa(err)
    }
}

# verifica outcome as textus.
functio verifica_result(tokenizator.IdentitasTokenizator t) → textus {
    fac {
        fixum bivalens ok ← tokenizator.verifica(t)
        redde "ok"
    }
    cape err {
        redde tokenizator.causa(err)
    }
}

# clavis outcome as textus ("ok|key" or the typed error's causa).
functio clavis_result(tokenizator.IdentitasTokenizator t) → textus {
    fac {
        fixum textus k ← tokenizator.clavis_tokenizatoris(t)
        redde "ok|" + k
    }
    cape err {
        redde tokenizator.causa(err)
    }
}

# Wire outcome as textus ("ok" or the typed error's causa).
functio wire_result(textus wire) → textus {
    fac {
        fixum tokenizator.IdentitasTokenizator t ← tokenizator.deserializa_identitas(wire)
        redde "ok"
    }
    cape err {
        redde tokenizator.causa(err)
    }
}

# =========================================================================
# §4 U1 — Capsule wrappers (src/model/capsule.proba seam).
# =========================================================================

fixum textus C_SCHEMA ← "2.0.0"
fixum textus C_ALGO ← "sha-256"
fixum textus C_DIGEST ← "2fa3f01300000000000000000000000000000000000000000000000000bac9c2"
fixum numerus C_LONGITUDO ← 1024
fixum numerus C_DATORUM ← 160
fixum textus C_EOG ← "0,2"
fixum bivalens C_BOS ← verum
fixum bivalens C_SPATIUM ← verum

# The pathless content identity of the structural capsule fixture.
functio identitas_capsulae() → artifact.IdentitasContenuti {
    redde artifact.IdentitasContenuti { algorithmus = C_ALGO, digestio = C_DIGEST, longitudo = C_LONGITUDO }
}

# An identity with caller-supplied fields (fail-closed cases).
functio identitas_capsulae_variata(textus algorithmus, textus digestio, numerus longitudo) → artifact.IdentitasContenuti {
    redde artifact.IdentitasContenuti { algorithmus = algorithmus, digestio = digestio, longitudo = longitudo }
}

# A Safetensors tensor descriptor (structural F32 fixture row).
functio descriptio_capsulae(textus nomen, textus typo, lista<numerus> forma, numerus initium, numerus finis, numerus elementa) → capsula.DescriptioTensorisSafetensori {
    redde capsula.DescriptioTensorisSafetensori { nomen = nomen, typo = typo, forma = forma, initium = initium, finis = finis, elementa = elementa }
}

# The two-descriptor F32 fixture row (ranges tile the 160-byte data region).
functio tensores_capsulae() → lista<capsula.DescriptioTensorisSafetensori> {
    redde [
        descriptio_capsulae("model.embed_tokens.weight", "F32", [8, 4], 0, 128, 32),
        descriptio_capsulae("model.norm.weight", "F32", [8], 128, 160, 8)
    ]
}

# The well-formed Safetensors manifest (format/version + metadata + tensors).
functio manifestum_capsulae() → capsula.ManifestumSafetensors {
    redde capsula.ManifestumSafetensors {
        formatum = "safetensors",
        versio = "1.0.0",
        longitudo_artifacti = C_LONGITUDO,
        longitudo_datorum = C_DATORUM,
        metadata = [ capsula.MetadatumSafetensori { clavis = "format.name", valor = "safetensors" } ],
        tensores = tensores_capsulae()
    }
}

# A manifest with caller-supplied fields (fail-closed cases).
functio manifestum_capsulae_variata(textus formatum, textus versio, numerus longitudo_artifacti, numerus longitudo_datorum, lista<capsula.DescriptioTensorisSafetensori> tensores) → capsula.ManifestumSafetensors {
    redde capsula.ManifestumSafetensors {
        formatum = formatum,
        versio = versio,
        longitudo_artifacti = longitudo_artifacti,
        longitudo_datorum = longitudo_datorum,
        metadata = [],
        tensores = tensores
    }
}

# Renders an admission outcome as textus: "ok" or the typed error's causa.
# (schema-2 structa_manifestum — the retired schema-1 structa is gone).
functio structa_result_capsulae(textus schema, artifact.IdentitasContenuti identitas, capsula.ManifestumSafetensors m) → textus {
    fac {
        fixum capsula.Capsula c ← capsula.structa_manifestum(schema, identitas, capsula.manifestum_safetensors(m))
        redde "ok"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Verifica outcome as textus.
functio verifica_result_capsulae(capsula.Capsula c) → textus {
    fac {
        fixum bivalens ok ← capsula.verifica(c)
        redde "ok"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Identity verification against an expected digest, as textus.
functio contra_result_capsulae(capsula.Capsula c, textus expectatum) → textus {
    fac {
        fixum bivalens ok ← capsula.verifica_contra(c, expectatum)
        redde "ok"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Identity wire outcome as textus ("ok" or the typed error's causa).
functio identitas_wire_result(textus wire) → textus {
    fac {
        fixum capsula.Identitas i ← capsula.deserializa_identitas(wire)
        redde "ok"
    }
    cape err {
        redde capsula.causa(err)
    }
}

# Identity round-trip predicate: deserializa(serializa(c)).identia() ≡
# c.identia() by identitas_aequus.
functio roundtrip(capsula.Capsula c) → bivalens {
    fac {
        fixum capsula.Identitas i ← capsula.deserializa_identitas(capsula.serializa_identitas(c))
        redde capsula.identitas_aequus(c.identia(), i)
    }
    cape err {
        redde falsum
    }
}

# =========================================================================
# Aggregate happy row — the four landed rows admit, and the oracle hashes
# bind the capsule identity (the conformance gate's positive anchor).
# =========================================================================

probandum "admission conformance — aggregate happy row" {
    proba "U2 safetensors legal fixture admits with the pinned oracle identity" {
        fac {
            fixum capsula.Capsula c ← safetensors.admittas(fixatura(), SAFE_HASH, "")
            adfirma admittas_result(fixatura(), SAFE_HASH, "") ≡ "ok"
            adfirma fixatura().longitudo() ≡ 1512
            adfirma c.schematis() ≡ "2.0.0"
            adfirma c.algorithmus() ≡ "sha-256"
            adfirma c.digestio() ≡ SAFE_HASH
            adfirma c.longitudo() ≡ 1512
            adfirma c.formatum() ≡ "safetensors"
            adfirma c.tensorum_numerus() ≡ 5
            adfirma c.manifestum_safetensors() non est nihil
            adfirma c.identia().schematis() ≡ "2.0.0"
            adfirma contra_result_capsulae(c, SAFE_HASH) ≡ "ok"
            adfirma contra_result_capsulae(c, F_ALIA) ≡ "digest mismatch — capsule does not match the expected artifact"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "U3 gguf legal fixture admits with the pinned oracle identity" {
        fac {
            fixum capsula.Capsula c ← gguf.admit(legitima(), GGUF_DIGEST, G_KV, G_TENSORES, G_ELEMENTA, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8)
            adfirma admissio_legitima(legitima()) ≡ "ok"
            adfirma verifica_result_capsulae(c) ≡ "ok"
            adfirma contra_result_capsulae(c, GGUF_DIGEST) ≡ "ok"
            adfirma c.schematis() ≡ "2.0.0"
            adfirma c.algorithmus() ≡ "sha-256"
            adfirma c.digestio() ≡ GGUF_DIGEST
            adfirma c.longitudo() ≡ legitima().longitudo()
            adfirma c.formatum() ≡ "gguf"
            adfirma c.tensorum_numerus() ≡ 3
            adfirma c.manifestum_gguf() non est nihil
            adfirma c.identia().schematis() ≡ "2.0.0"
        }
        cape err {
            adfirma falsum
        }
    }

    proba "U4 tokenizer probe parity admits the pinned id lists" {
        adfirma proba_result("p10", [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767]) ≡ "ok"
        adfirma proba_result("p1", [19556, 905]) ≡ "ok"
        adfirma structa_result(T_SCHEMA, T_KIND, T_PRE, F_VOCAB, C_EOG, C_BOS, C_SPATIUM) ≡ "ok"
    }

    proba "U1 schema-2 capsule admission + identity wire round-trip" {
        fac {
            fixum capsula.Capsula c ← capsula.structa_manifestum(C_SCHEMA, identitas_capsulae(), capsula.manifestum_safetensors(manifestum_capsulae()))
            adfirma structa_result_capsulae(C_SCHEMA, identitas_capsulae(), manifestum_capsulae()) ≡ "ok"
            adfirma c.schematis() ≡ "2.0.0"
            adfirma c.algorithmus() ≡ "sha-256"
            adfirma c.digestio() ≡ C_DIGEST
            adfirma c.longitudo() ≡ C_LONGITUDO
            adfirma c.formatum() ≡ "safetensors"
            adfirma c.tensorum_numerus() ≡ 2
            adfirma c.manifestum_safetensors() non est nihil
            adfirma roundtrip(c)
        }
        cape err {
            adfirma falsum
        }
    }
}

# =========================================================================
# U2 — Safetensors fail-closed negative matrix (format/version/arch/dtype/
# offset/shape/tokenizer/bounds/counts; every case = typed SafetensorError).
# =========================================================================

probandum "admission conformance — U2 safetensors matrix" {
    proba "rejects a truncated header prefix (format)" {
        adfirma admittas_result(_truncata(4), SAFE_HASH, "") ≡ "truncated safetensors header prefix"
    }

    proba "rejects a header extending beyond the file (format)" {
        adfirma admittas_result(_truncata(500), SAFE_HASH, "") ≡ "truncated header — header size beyond file"
    }

    proba "rejects a non-JSON header (format)" {
        adfirma admittas_result(_continer("garbage", _data_pattern(672)), SAFE_HASH, "") ≡ "unexpected character in header"
    }

    proba "rejects a header that is not a JSON object (format)" {
        adfirma admittas_result(_continer("[1,2,3]", _data_pattern(672)), SAFE_HASH, "") ≡ "header is not a JSON object"
    }

    proba "rejects trailing tokens after the top-level object (format)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON + ",\"x\":1", _data_pattern(672)), SAFE_HASH, "") ≡ "trailing tokens after the header object"
    }

    proba "rejects a non-8-byte-aligned header (format)" {
        fixum lista<numerus<u8>> mis ← _iunge(_caput8(841), _iunge(_textus_bytes(PRAESTOLATUM_JSON), _data_pattern(672)))
        adfirma admittas_result(mis, SAFE_HASH, "") ≡ "misaligned safetensors header (not 8-byte aligned)"
    }

    proba "rejects an unsupported format name (version)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"format.name\":\"safetensors\"", "\"format.name\":\"gguf\""), _data_pattern(672)), SAFE_HASH, "") ≡ "unsupported safetensors format: gguf"
    }

    proba "rejects an unsupported row version (version)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"format.version\":\"1.0.0\"", "\"format.version\":\"2.0.0\""), _data_pattern(672)), SAFE_HASH, "") ≡ "unsupported safetensors row version: 2.0.0"
    }

    proba "rejects an architecture mismatch (arch)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"model.arch\":\"llama\"", "\"model.arch\":\"qwen2\""), _data_pattern(672)), SAFE_HASH, "") ≡ "architecture mismatch"
    }

    proba "rejects a density-class mismatch (arch)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"model.density\":\"dense\"", "\"model.density\":\"sparse\""), _data_pattern(672)), SAFE_HASH, "") ≡ "architecture mismatch"
    }

    proba "rejects a tensor outside the admitted row (arch)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"model.norm.weight\"", "\"output.weight\""), _data_pattern(672)), SAFE_HASH, "") ≡ "tensor not in admitted row: output.weight"
    }

    proba "rejects a tensor-count mismatch (counts)" {
        fixum textus six ← PRAESTOLATUM_JSON.muta("\"data_offsets\":[544,672]}}", "\"data_offsets\":[544,672]},\"model.layers.0.mlp.up_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,8],\"data_offsets\":[672,928]}}")
        adfirma admittas_result(_continer(six, _data_pattern(928)), SAFE_HASH, "") ≡ "tensor count mismatch"
    }

    proba "rejects an unsupported dtype (dtype)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"dtype\":\"F32\"", "\"dtype\":\"F16\""), _data_pattern(672)), SAFE_HASH, "") ≡ "unsupported dtype: F16 for model.embed_tokens.weight"
    }

    proba "rejects a duplicate tensor name (offset/table)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"model.layers.0.mlp.down_proj.weight\"", "\"model.embed_tokens.weight\""), _data_pattern(672)), SAFE_HASH, "") ≡ "duplicate tensor name: model.embed_tokens.weight"
    }

    proba "rejects a misaligned tensor data offset (offset)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"data_offsets\":[0,128]", "\"data_offsets\":[4,132]"), _data_pattern(672)), SAFE_HASH, "") ≡ "misaligned tensor data offset: model.embed_tokens.weight"
    }

    proba "rejects overlapping tensor data regions (offset)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"data_offsets\":[128,160]", "\"data_offsets\":[64,96]"), _data_pattern(672)), SAFE_HASH, "") ≡ "overlapping tensor data regions"
    }

    proba "rejects a gapped data region — no exact tiling (offset)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON, _data_pattern(676)), SAFE_HASH, "") ≡ "data region does not tile exactly"
    }

    proba "rejects a truncated data region (offset)" {
        adfirma admittas_result(_truncata(1000), SAFE_HASH, "") ≡ "data region truncated — tensor extends beyond file: model.layers.0.self_attn.q_proj.weight"
    }

    proba "rejects a shape mismatch (shape)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"shape\":[8,4]", "\"shape\":[8,5]"), _data_pattern(672)), SAFE_HASH, "") ≡ "shape mismatch for model.embed_tokens.weight"
    }

    proba "rejects a shape/offset byte-length inconsistency (shape)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"data_offsets\":[0,128]", "\"data_offsets\":[0,132]"), _data_pattern(672)), SAFE_HASH, "") ≡ "shape/offset inconsistency for model.embed_tokens.weight"
    }

    proba "rejects a dimension above the ceiling (bounds)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"shape\":[8,4]", "\"shape\":[70000,4]"), _data_pattern(672)), SAFE_HASH, "") ≡ "dimension above ceiling"
    }

    proba "rejects a total element count above the ceiling (bounds)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"shape\":[8,4]", "\"shape\":[65536,20000]"), _data_pattern(672)), SAFE_HASH, "") ≡ "element count above ceiling"
    }

    proba "rejects a tensor name above the length ceiling (bounds)" {
        fixum textus longe ← PRAESTOLATUM_JSON.muta("\"model.norm.weight\"", repetitio("x", 129))
        adfirma admittas_result(_continer(longe, _data_pattern(672)), SAFE_HASH, "") ≡ "tensor name above length ceiling"
    }

    proba "rejects a tokenizer model mismatch (tokenizer)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"tokenizer.model\":\"gpt2\"", "\"tokenizer.model\":\"llama\""), _data_pattern(672)), SAFE_HASH, "") ≡ "tokenizer identity mismatch"
    }

    proba "rejects a tokenizer EOG-set mismatch (tokenizer)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"tokenizer.eog\":\"0,2\"", "\"tokenizer.eog\":\"2,0\""), _data_pattern(672)), SAFE_HASH, "") ≡ "tokenizer identity mismatch"
    }

    proba "rejects a tokenizer BOS-free mismatch (tokenizer)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"tokenizer.bos_free\":\"true\"", "\"tokenizer.bos_free\":\"false\""), _data_pattern(672)), SAFE_HASH, "") ≡ "tokenizer identity mismatch"
    }

    proba "rejects a malformed vocabulary digest (tokenizer)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"tokenizer.vocab_digest\":\"" + F_VOCAB + "\"", "\"tokenizer.vocab_digest\":\"zz\""), _data_pattern(672)), SAFE_HASH, "") ≡ "malformed vocabulary digest"
    }

    proba "rejects a malformed digest claim before the row is admitted" {
        adfirma admittas_result(fixatura(), "zz", "") ≡ "malformed digest value"
    }

    proba "rejects a non-string metadata value (bounds/metadata)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"model.layers\":\"1\"", "\"model.layers\":1"), _data_pattern(672)), SAFE_HASH, "") ≡ "metadata value must be a string"
    }

    proba "rejects a missing required metadata key (metadata)" {
        adfirma admittas_result(_continer(PRAESTOLATUM_JSON.muta("\"format.name\":\"safetensors\",", ""), _data_pattern(672)), SAFE_HASH, "") ≡ "missing required metadata key: format.name"
    }

    proba "rejects a header with no __metadata__ — fails at the first required key (metadata)" {
        adfirma admittas_result(_continer("{\"model.norm.weight\":{\"dtype\":\"F32\",\"shape\":[8],\"data_offsets\":[0,32]}}", _data_pattern(32)), SAFE_HASH, "") ≡ "missing required metadata key: format.name"
    }
}

