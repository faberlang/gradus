const string SAFE_HASH ← "424442296e97c261de42fd496cc6cdb4496f3f632835479de96a7ed76c5f75d8"
# U3 — fixtures/gguf/gguf-row-oracle.md.
const string GGUF_DIGEST ← "d89c9ef917158bfb5600f417020479499c6c042f728e9a29c8457a6b1a8f0974"
# Shared form-valid digest fixtures.
