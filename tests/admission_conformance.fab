const string F_ALT_DIGEST ← "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

# =========================================================================
# §1 U2 — Safetensors byte builders (mirror of the committed generator
# fixtures/safetensors/gen_fixture.py and src/model/safetensors.proba).
# =========================================================================

const string EXPECTED_JSON ← "{\"__metadata__\":{\"format.name\":\"safetensors\",\"format.version\":\"1.0.0\",\"model.arch\":\"llama\",\"model.density\":\"dense\",\"model.layers\":\"1\",\"model.context\":\"2048\",\"tokenizer.model\":\"gpt2\",\"tokenizer.pre\":\"smollm\",\"tokenizer.vocab_digest\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"tokenizer.eog\":\"0,2\",\"tokenizer.bos_free\":\"true\",\"tokenizer.space_prefix_free\":\"true\"},\"model.embed_tokens.weight\":{\"dtype\":\"F32\",\"shape\":[8,4],\"data_offsets\":[0,128]},\"model.norm.weight\":{\"dtype\":\"F32\",\"shape\":[8],\"data_offsets\":[128,160]},\"model.layers.0.self_attn.q_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,8],\"data_offsets\":[160,416]},\"model.layers.0.self_attn.v_proj.weight\":{\"dtype\":\"F32\",\"shape\":[8,4],\"data_offsets\":[416,544]},\"model.layers.0.mlp.down_proj.weight\":{\"dtype\":\"F32\",\"shape\":[4,8],\"data_offsets\":[544,672]}}"

const int EXPECTED_DATA_LENGTH ← 672
const int EXPECTED_LENGTH ← 1512

# 8-byte little-endian header-length prefix (the u64 is JSON-only N).
fn _header8(int n) → list<int<u8>> {
    var list<int<u8>> out ← empty
    out.append((n ⇒ 0) ↦ int<u8>)
    out.append((n ⇒ 8) ↦ int<u8>)
    out.append((n ⇒ 16) ↦ int<u8>)
    out.append((n ⇒ 24) ↦ int<u8>)
    out.append((n ⇒ 32) ↦ int<u8>)
    out.append((n ⇒ 40) ↦ int<u8>)
    out.append((n ⇒ 48) ↦ int<u8>)
    out.append((n ⇒ 56) ↦ int<u8>)
    return out
}

# text -> UTF-8 byte list.
fn _text_bytes(string s) → list<int<u8>> {
    const bytes o ← s ↦ bytes
    var list<int<u8>> out ← empty
    var int i ← 0
    while i ≺ o.length() {
        out.append(o.get(i) coalesce (0 ∷ int<u8>))
        i ← i + 1
    }
    return out
}

# Concatenate two byte lists.
fn _join(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← empty
    for from a const x { out.append(x) }
    for from b const x { out.append(x) }
    return out
}

# Deterministic data-byte pattern (matches the generator: byte k = (k*13+7)%256).
fn _data_pattern(int n) → list<int<u8>> {
    var list<int<u8>> out ← empty
    var int i ← 0
    while i ≺ n {
        out.append(((i * 13 + 7) % 256) ↦ int<u8>)
        i ← i + 1
    }
    return out
}

# Assemble a Safetensors container: LE prefix + 8-aligned padded header +
# data region (header padded with spaces; prefix u64 is JSON-only N).
fn _contain(string header_json, list<int<u8>> data) → list<int<u8>> {
    const list<int<u8>> hb ← _text_bytes(header_json)
    const int n ← hb.length()
    const int aligned ← ((n + 7) / 8) * 8
    var list<int<u8>> padded ← empty
    for from hb const x { padded.append(x) }
    var int i ← n
    while i ≺ aligned {
        padded.append(32 ↦ int<u8>)
        i ← i + 1
    }
    const int header ← aligned
    return _join(_join(_header8(header), padded), data)
}

# The pinned legal fixture, reconstructed byte-for-byte (1512 bytes, oracle
# SHA-256 42444229…5f75d8).
fn fixture() → list<int<u8>> {
    return _contain(EXPECTED_JSON, _data_pattern(EXPECTED_DATA_LENGTH))
}

# First n bytes only (truncation mutants).
fn _truncated(int n) → list<int<u8>> {
    return fixture().take(n)
}

# Admission outcome as text: "ok" or the typed error's message.
fn admit_result(list<int<u8>> corpus, string digest, string path) → string {
    do {
        const capsule.Capsule c ← safetensors.admit(corpus, digest, path)
        return "ok"
    }
    catch err {
        return safetensors.message(err)
    }
}

