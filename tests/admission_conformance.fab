# The GGUF magic, as bytes.
fn magica() → list<int<u8>> {
    return int_bytes([0x47, 0x47, 0x55, 0x46])
}

# The 15 identity-bearing required keys + 3 optional admitted keys. KV
# codec: "key;type;value" (type s=string, u=u32, b=bool, as=array[string]).
const list<string> LEGAL_KVS ← [
    "general.architecture;s;llama",
    "general.file_type;u;15",
    "general.quantization_version;u;2",
    "llama.block_count;u;32",
    "llama.context_length;u;8192",
    "llama.vocab_size;u;49152",
    "llama.embedding_length;u;960",
    "tokenizer.ggml.model;s;gpt2",
    "tokenizer.ggml.pre;s;smollm",
    "tokenizer.ggml.bos_token_id;u;1",
    "tokenizer.ggml.eos_token_id;u;2",
    "tokenizer.ggml.padding_token_id;u;2",
    "tokenizer.ggml.unknown_token_id;u;0",
    "tokenizer.ggml.add_bos_token;b;0",
    "tokenizer.ggml.add_space_prefix;b;0",
    "general.name;s;smollm2-fixture",
    "tokenizer.chat_template;s;You are a helpful AI assistant named SmolLM",
    "general.languages;as;en"
]

# Tensor codec: "name;type;d1,d2;offset" (offset auto = cumulative, or a
# literal relative offset). Q8_0 [32,16] = 512 elems = 544 B; F32 [16] =
# 64 B; Q4_K [256,16] = 4096 elems = 2304 B; total 2912 B, 32-multiples.
const list<string> LEGAL_TENSORES ← [
    "token_embd.weight;8;32,16;auto",
    "blk.0.attn_norm.weight;0;16;auto",
    "blk.0.ffn_down.weight;12;256,16;auto"
]

const int G_KV ← 18
const int G_TENSORES ← 3
const int G_ELEMENTA ← 4624
const int G_F32 ← 1
const int G_Q4K ← 1
const int G_Q5 ← 0
const int G_Q6 ← 0
const int G_Q8 ← 1

fn int_bytes(list<int> vals) → list<int<u8>> {
    var list<int<u8>> bs ← vacua
    for from vals const v {
        bs.append(v ↦ int<u8>)
    }
    return bs
}

fn octeti_bytes(string s) → list<int<u8>> {
    const bytes o ← s ↦ bytes
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i < o.length() {
        out.append(o.get(i) coalesce (0 ∷ int<u8>))
        i ← i + 1
    }
    return out
}

fn add(list<int<u8>> acc, list<int<u8>> piece) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    for from acc const byte {
        out.append(byte)
    }
    for from piece const byte {
        out.append(byte)
    }
    return out
}

fn u32_le(int n) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    out.append((n ⇒ 0) ↦ int<u8>)
    out.append((n ⇒ 8) ↦ int<u8>)
    out.append((n ⇒ 16) ↦ int<u8>)
    out.append((n ⇒ 24) ↦ int<u8>)
    return out
}

fn u64_le(int n) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    out.append((n ⇒ 0) ↦ int<u8>)
    out.append((n ⇒ 8) ↦ int<u8>)
    out.append((n ⇒ 16) ↦ int<u8>)
    out.append((n ⇒ 24) ↦ int<u8>)
    out.append((n ⇒ 32) ↦ int<u8>)
    out.append((n ⇒ 40) ↦ int<u8>)
    out.append((n ⇒ 48) ↦ int<u8>)
    out.append((n ⇒ 56) ↦ int<u8>)
    return out
}

fn stringa(string s) → list<int<u8>> {
    var list<int<u8>> out ← u64_le(s.length())
    var list<int<u8>> body ← octeti_bytes(s)
    for from body const byte {
        out.append(byte)
    }
    return out
}

# textus → numerus (well-formed fixture strings; 0 on malformed).
fn numerus_a(string s) → int {
    do {
        const int v ← s ↦ int
        return v
    }
    catch err {
        return 0
    }
}

fn repetitio(string s, int n) → string {
    var string out ← ""
    var int i ← 0
    while i < n {
        out ← out + s
        i ← i + 1
    }
    return out
}

# "key;type;value" → KV bytes (string | u32 | bool | array-of-string).
fn codex_kv(string codex) → list<int<u8>> {
    const list<string> partes ← codex.split(";")
    const string clavis ← partes.get(0) coalesce ""
    const string typo ← partes.get(1) coalesce ""
    const string value ← partes.get(2) coalesce ""
    var list<int<u8>> out ← stringa(clavis)
    if typo ≡ "s" {
        out ← add(out, u32_le(8))
        out ← add(out, stringa(value))
    }
    if typo ≡ "u" {
        out ← add(out, u32_le(4))
        out ← add(out, u32_le(numerus_a(value)))
    }
    if typo ≡ "b" {
        out ← add(out, u32_le(7))
        if value ≡ "1" {
            out.append(1 ↦ int<u8>)
        }
        else {
            out.append(0 ↦ int<u8>)
        }
    }
    if typo ≡ "as" {
        out ← add(out, u32_le(9))
        out ← add(out, u32_le(8))
        const list<string> elems ← value.split(",")
        out ← add(out, u64_le(elems.length()))
        for from elems const e {
            out ← add(out, stringa(e))
        }
    }
    return out
}

# "name;type;d1,d2;offset" → tensor-info bytes (offset relative to the
# data-section start; auto = running cumulative).
fn codex_tensor(string codex, int cursus) → list<int<u8>> {
    const list<string> partes ← codex.split(";")
    const string nomen ← partes.get(0) coalesce ""
    const string typo ← partes.get(1) coalesce ""
    const string forma ← partes.get(2) coalesce ""
    const string offset_s ← partes.get(3) coalesce "auto"
    var list<int<u8>> out ← stringa(nomen)
    const list<string> dims ← forma.split(",")
    out ← add(out, u32_le(dims.length()))
    for from dims const dd {
        out ← add(out, u64_le(numerus_a(dd)))
    }
    out ← add(out, u32_le(numerus_a(typo)))
    var int off_val ← cursus
    if offset_s ≠ "auto" {
        off_val ← numerus_a(offset_s)
    }
    out ← add(out, u64_le(off_val))
    return out
}

# Flat byte size of a tensor (block layout mirrors the admitted GGML
# table: F32 1/4, Q5_0 32/22, Q8_0 32/34, Q4_K 256/144, Q6_K 256/210).
fn tensor_magnitudo(string codex) → int {
    const list<string> partes ← codex.split(";")
    const int typo ← numerus_a(partes.get(1) coalesce "")
    const list<string> dims ← (partes.get(2) coalesce "").split(",")
    var int nelems ← 1
    for from dims const dd {
        nelems ← nelems * numerus_a(dd)
    }
    var int blocci ← 1
    if typo ≡ 0 { blocci ← 1 }
    if typo ≡ 6 { blocci ← 32 }
    if typo ≡ 8 { blocci ← 32 }
    if typo ≡ 12 { blocci ← 256 }
    if typo ≡ 14 { blocci ← 256 }
    var int bytes ← 1
    if typo ≡ 0 { bytes ← 4 }
    if typo ≡ 6 { bytes ← 22 }
    if typo ≡ 8 { bytes ← 34 }
    if typo ≡ 12 { bytes ← 144 }
    if typo ≡ 14 { bytes ← 210 }
    return (nelems / blocci) * bytes
}

# Full GGUF v3 file from codec lists. extra_data appends trailing bytes to
# the data region (coverage mutants). Data section starts at align32(end
# of the tensor table); tensor offsets are cumulative relative.
fn aedifica(
    list<int<u8>> magica,
    int versio,
    list<string> kvs,
    list<string> tensores,
    int extra_data
) → list<int<u8>> {
    var list<int<u8>> f ← vacua
    for from magica const byte {
        f.append(byte)
    }
    f ← add(f, u32_le(versio))
    f ← add(f, u64_le(tensores.length()))
    f ← add(f, u64_le(kvs.length()))
    for from kvs const k {
        f ← add(f, codex_kv(k))
    }
    var int cursus ← 0
    for from tensores const tt {
        f ← add(f, codex_tensor(tt, cursus))
        cursus ← cursus + tensor_magnitudo(tt)
    }
    const int finis_mensae ← f.length()
    var int data_inceptum ← finis_mensae
    if data_inceptum % 32 ≠ 0 {
        const int pad ← 32 - data_inceptum % 32
        var int p ← 0
        while p < pad {
            f.append(0 ↦ int<u8>)
            p ← p + 1
        }
        data_inceptum ← data_inceptum + pad
    }
    var int tot ← 0
    for from tensores const tt {
        tot ← tot + tensor_magnitudo(tt)
    }
    var int z ← 0
    while z < tot + extra_data {
        f.append(((z * 13 + 7) % 256) ↦ int<u8>)
        z ← z + 1
    }
    return f
}

# The pinned legal fixture (scaled structural replica).
fn legitima() → list<int<u8>> {
    return aedifica(magica(), 3, LEGAL_KVS, LEGAL_TENSORES, 0)
}

# List replacement / removal for mutants.
fn repone(list<string> xs, string veterem, string novam) → list<string> {
    var list<string> out ← vacua
    for from xs const x {
        if x ≡ veterem {
            out.append(novam)
        }
        else {
            out.append(x)
        }
    }
    return out
}

fn demptio(list<string> xs, string veterem) → list<string> {
    var list<string> out ← vacua
    for from xs const x {
        if x ≠ veterem {
            out.append(x)
        }
    }
    return out
}

# Byte mutation / truncation.
fn muta(list<int<u8>> b, int off, int value) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i < b.length() {
        if i ≡ off {
            out.append(value ↦ int<u8>)
        }
        else {
            out.append(b.get(i) coalesce (0 ∷ int<u8>))
        }
        i ← i + 1
    }
    return out
}

fn excerpe(list<int<u8>> b, int n) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    var int i ← 0
    while i < n {
        out.append(b.get(i) coalesce (0 ∷ int<u8>))
        i ← i + 1
    }
    return out
}

# -- GGUF admission outcome helpers ---------------------------------------

fn admissio_result(
    list<int<u8>> bytes_f,
    string digestio,
    int expectatum_kv,
    int expectatum_tensorum,
    int expectatum_elementa,
    int expectatum_f32,
    int expectatum_q4k,
    int expectatum_q5,
    int expectatum_q6,
    int expectatum_q8
) → string {
    do {
        const capsula.Capsule c ← gguf.admit(bytes_f, digestio, expectatum_kv, expectatum_tensorum, expectatum_elementa, expectatum_f32, expectatum_q4k, expectatum_q5, expectatum_q6, expectatum_q8)
        return "ok"
    }
    catch err {
        return gguf.message(err)
    }
}

# Admission with the legal fixture's contract.
fn admissio_legitima(list<int<u8>> bytes_f) → string {
    return admissio_result(bytes_f, GGUF_DIGEST, G_KV, G_TENSORES, G_ELEMENTA, G_F32, G_Q4K, G_Q5, G_Q6, G_Q8)
}

