# §3 U4 — Tokenizer wrappers (src/tokenizer.proba seam).
# =========================================================================

const string T_SCHEMA ← "1.0.0"
const string T_KIND ← "gpt2"
const string T_PRE ← "smollm"

# verifica_proba outcome as textus ("ok" or the typed error's causa).
fn proba_result(string nomen, list<int> observata) → string {
    do {
        const bool ok ← tokenizator.verify_probe(nomen, observata)
        return "ok"
    }
    catch err {
        return tokenizator.message(err)
    }
}

# structa outcome as textus ("ok" on success, or the typed error's causa).
fn structa_result(
    string schema,
    string progenies,
    string pre_tokenizator,
    string digestio_vocabuli,
    string eog,
    bool bos_vacua,
    bool spatium_vacua
) → string {
    do {
        const tokenizator.TokenizerIdentity t ← tokenizator.construct(schema, progenies, pre_tokenizator, digestio_vocabuli, eog, bos_vacua, spatium_vacua)
        return "ok"
    }
    catch err {
        return tokenizator.message(err)
    }
}

# verifica outcome as textus.
fn verifica_result(tokenizator.TokenizerIdentity t) → string {
    do {
        const bool ok ← tokenizator.verify(t)
        return "ok"
    }
    catch err {
        return tokenizator.message(err)
    }
}

# clavis outcome as textus ("ok|key" or the typed error's causa).
fn clavis_result(tokenizator.TokenizerIdentity t) → string {
    do {
        const string k ← tokenizator.tokenizer_key(t)
        return "ok|" + k
    }
    catch err {
        return tokenizator.message(err)
    }
}

# Wire outcome as textus ("ok" or the typed error's causa).
fn wire_result(string wire) → string {
    do {
        const tokenizator.TokenizerIdentity t ← tokenizator.deserialize_identity(wire)
        return "ok"
    }
    catch err {
        return tokenizator.message(err)
    }
}

