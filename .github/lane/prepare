#!/bin/bash
# .github/lane/prepare <commit-or-branch>: put this job's lane clone ($LANE_REPO) at the commit or branch,
# clean, and print the path (design /vivi/orch/scoping/lanes-and-models.md, cold review item 5).
# The clone persists between jobs, so whatever a killed or careless job left is undone here, before the switch:
# locks, an unfinished rebase/merge/cherry-pick (rebase-merge survives `reset --hard`), changes, untracked files,
# hooks. Ignored files stay (no `git clean -x`). A clone in a state this cannot recognise is re-cloned.
# Usage in a workflow step:  REPO=$(.github/lane/prepare "$GITHUB_SHA")   (run from any directory)
set -euo pipefail
want=${1:?commit or branch}
: "${LANE_DIR:?not a lane runner (no LANE_DIR in the runner .env)}"
repo=${LANE_REPO:?no LANE_REPO in the runner .env}
say() { echo "lane-prepare: $*" >&2; }

reclone() {
  say "re-cloning ($1)"
  url=$(git -C "$repo" remote get-url origin 2>/dev/null || true)
  [ -n "$url" ] || { say "no origin to re-clone from"; exit 1; }
  cd "$LANE_DIR"          # never delete the directory this runs in
  rm -rf "$repo.new"
  git clone -q "$url" "$repo.new"
  rm -rf "$repo" && mv "$repo.new" "$repo"
  git -C "$repo" config core.hooksPath /dev/null
  cd "$repo"
}

[ -d "$repo/.git" ] || { say "no clone at $repo"; exit 1; }
cd "$repo"
rm -f .git/index.lock .git/HEAD.lock .git/refs/heads/*.lock 2>/dev/null || true
git rebase --abort >/dev/null 2>&1 || true
git merge --abort >/dev/null 2>&1 || true
git cherry-pick --abort >/dev/null 2>&1 || true
rm -rf .git/rebase-merge .git/rebase-apply
git config core.hooksPath /dev/null
git reset -q --hard 2>/dev/null || reclone "reset failed"
git clean -q -fd
git fsck --connectivity-only --no-progress >/dev/null 2>&1 || reclone "fsck failed"

# Fetch exactly what was asked: a commit (40 hex) or a branch. A branch is taken only from a fetch that just
# returned it (a stale remote ref after a branch was retired would bring back rejected commits: 11-22).
if [[ $want =~ ^[0-9a-f]{40}$ ]]; then
  git fetch -q origin "$want" 2>/dev/null || git fetch -q origin
  git checkout -q --detach "$want"
else
  git check-ref-format --branch "$want" >/dev/null || { say "not a branch name: $want"; exit 1; }
  git fetch -q origin "+refs/heads/$want:refs/remotes/origin/$want" || { say "no branch $want on origin"; exit 1; }
  git checkout -q -B "$want" "refs/remotes/origin/$want"
fi
say "$(git log -1 --format='%h %s' | cut -c1-80)"
echo "$repo"
