const f32 DENSE_BAND ← 0.000001 ∷ f32
const int GOLDEN_TOP1 ← 30
const list<int> GOLDEN_TOP5 ← [30, 28, 1270, 365, 198]
const int VOCAB ← 49152
const int SLICE_CAP ← 16777216
const f32 BAND_Q2 ← 0.0065 ∷ f32
const int EOG_0 ← 0
const int EOG_2 ← 2

union PrefillError {
    BadArguments { string message },
    BadLength { string message },
    BadManifest { string message },
    BadTokenizer { string message },
    BadAdapter { string message },
    BadBinding { string message },
    BadSlice { string message },
    BadForward { string message }
}

fn message(PrefillError e) → string {
    match e {
        case BadArguments const message { return message }
        case BadLength const message { return message }
        case BadManifest const message { return message }
        case BadTokenizer const message { return message }
        case BadAdapter const message { return message }
        case BadBinding const message { return message }
        case BadSlice const message { return message }
        case BadForward const message { return message }
    }
}

fn _range(string via, int total, int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    if start < 0 or length < 0 or start > total - length {
        throw variant BadSource {message = "range request exceeds the artifact"}
    }
    const bytes bytes ← fs.read_range(via, start, length)
    if bytes.length() ≠ length {
        throw variant BadSource {message = "short range read"}
    }
    return bytes
}

fn _prefix_range(list<int> prefix, int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    if start < 0 or length < 0 or start > prefix.length() - length {
        throw variant BadSource {message = "inspection attempted to read the tensor data region"}
    }
    const list<int> segment ← prefix.slice(start, start + length)
    const bytes bytes ← segment ↦ bytes
    return bytes
}

fn _ends(string s, string tail) → bool {
    if tail.length() ≻ s.length() then return false
    return s.slice(s.length() - tail.length(), s.length()) ≡ tail
}

fn _slot(string name) → int {
    if _ends(name, ".input_layernorm") then return 0
    if _ends(name, ".self_attn.q_proj") then return 1
    if _ends(name, ".self_attn.k_proj") then return 2
    if _ends(name, ".self_attn.v_proj") then return 3
    if _ends(name, ".self_attn.o_proj") then return 4
    if _ends(name, ".post_attention_layernorm") then return 5
    if _ends(name, ".mlp.gate_proj") then return 6
    if _ends(name, ".mlp.up_proj") then return 7
    if _ends(name, ".mlp.down_proj") then return 8
    return -1
}

fn _ids_text(list<int> ids) → string {
    var string out ← "["
    var int i ← 0
    while i ≺ ids.length() {
        if i ≻ 0 {
            out ← out + ", "
        }
        out ← out + ((ids.get(i) coalesce 0) ↦ string)
        i ← i + 1
    }
    return out + "]"
}

fn _ids_eq(list<int> a, list<int> b) → bool {
    if a.length() ≠ b.length() then return false
    var int i ← 0
    while i ≺ a.length() {
        if (a.get(i) coalesce -1) ≠ (b.get(i) coalesce -2) then return false
        i ← i + 1
    }
    return true
}

fn _block_elements(tensor_view.TensorView v) → int {
    match v.layout {
        case gguf_manifest.Known const elements_per_block, bytes_per_block, byte_length {
            return elements_per_block
        }
        case gguf_manifest.Unknown const kind {
            return 0
        }
    }
}

fn _window(int remaining, int block) → int {
    if remaining ≤ SLICE_CAP then return remaining
    const int aligned ← (SLICE_CAP / block) * block
    if aligned ≺ block then return block
    return aligned
}

fn _limits(gguf_manifest.GgufManifest m, string gguf_name) → tuple<int, int> ⇥ PrefillError {
    do {
        return gguf_manifest.payload_limit(m, gguf_name)
    }
    catch err {
        throw variant BadManifest {message = "payload range failed for " + gguf_name + ": " + err.message}
    }
}

fn _bind(gguf_manifest.GgufManifest m, tensor_payload.TensorPayload p) → tensor_view.TensorView ⇥ PrefillError {
    do {
        return tensor_view.links(m, p)
    }
    catch err {
        throw variant BadBinding {message = "view bind failed for " + p.name + ": " + err.message}
    }
}

fn _slice(
    tensor_view.TensorView v,
    int off,
    int n,
    (int, int) → bytes ⇥ gguf_manifest.GgufManifestError source
) → list<f32> ⇥ PrefillError {
    do {
        return tensor_view.materialize_slice(v, off, n, source)
    }
    catch err {
        throw variant BadSlice {message = "window materialize failed for " + v.name + ": " + err.message}
    }
}

fn _tensor(list<f32> data, list<int> shape) → tensor.NumericBlock ⇥ PrefillError {
    do {
        return tensor.construct(data, shape)
    }
    catch err {
        throw variant BadSlice {message = "tensor construct failed: " + err.message}
    }
}

fn _materialize(
    string via,
    int total,
    gguf_manifest.GgufManifest m,
    string gguf_name
) → tensor.NumericBlock ⇥ PrefillError {
    const tuple<int, int> limit ← _limits(m, gguf_name)
    const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
        name = gguf_name,
        absolute_start = limit[0],
        length = limit[1],
        bytes = ||
    }
    const tensor_view.TensorView v ← _bind(m, p)
    const int block ← _block_elements(v)
    if block ≺ 1 {
        throw variant BadSlice {message = "tensor layout has no block size: " + gguf_name}
    }
    var list<f32> data ← empty
    var int off ← 0
    while off ≺ v.elements {
        const int n ← _window(v.elements - off, block)
        const list<f32> part ← _slice(
            v,
            off,
            n,
            (int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _range(via, total, start, length)
        )
        for from part const x {
            data.append(x)
        }
        off ← off + n
    }
    return _tensor(data, v.shape)
}

fn _gguf_name(string family, int layer) → string ⇥ PrefillError {
    if family ≡ "model.embed_tokens" then return "token_embd.weight"
    if family ≡ "model.norm" then return "output_norm.weight"
    if family ≡ "lm_head" then return "token_embd.weight"
    if layer ≺ 0 or layer ≥ 32 {
        throw variant BadAdapter {message = "layer index outside the frozen llama layer range: " + (layer ↦ string)}
    }
    if family ≡ "model.layers.input_layernorm" then return ("blk." + (layer ↦ string)) + ".attn_norm.weight"
    if family ≡ "model.layers.self_attn.q_proj" then return ("blk." + (layer ↦ string)) + ".attn_q.weight"
    if family ≡ "model.layers.self_attn.k_proj" then return ("blk." + (layer ↦ string)) + ".attn_k.weight"
    if family ≡ "model.layers.self_attn.v_proj" then return ("blk." + (layer ↦ string)) + ".attn_v.weight"
    if family ≡ "model.layers.self_attn.o_proj" then return ("blk." + (layer ↦ string)) + ".attn_output.weight"
    if family ≡ "model.layers.post_attention_layernorm" then return ("blk." + (layer ↦ string)) + ".ffn_norm.weight"
    if family ≡ "model.layers.mlp.gate_proj" then return ("blk." + (layer ↦ string)) + ".ffn_gate.weight"
    if family ≡ "model.layers.mlp.up_proj" then return ("blk." + (layer ↦ string)) + ".ffn_up.weight"
    if family ≡ "model.layers.mlp.down_proj" then return ("blk." + (layer ↦ string)) + ".ffn_down.weight"
    throw variant BadAdapter {message = "unknown canonical tensor name: " + family}
}

# GGUF linear weights are K-major: stored[n * K + k] = W[k, n].
# nn.linear wants [K, N] row-major: out[k * N + n] = W[k, n].
fn _kmajor_to_linear(tensor.NumericBlock t) → tensor.NumericBlock ⇥ PrefillError {
    const list<int> f ← t.shape()
    if f.length() ≠ 2 {
        throw variant BadAdapter {message = "linear weight must be rank 2"}
    }
    const int k ← f.get(0) coalesce 1
    const int n ← f.get(1) coalesce 1
    var list<f32> out ← empty
    var int i ← 0
    while i ≺ k {
        var int j ← 0
        while j ≺ n {
            out.append(t.data.get(j * k + i) coalesce 0.0 ∷ f32)
            j ← j + 1
        }
        i ← i + 1
    }
    return _tensor(out, [k, n])
}

fn _linear_family(string family) → bool {
    if family ≡ "lm_head" then return true
    if _ends(family, ".self_attn.q_proj") then return true
    if _ends(family, ".self_attn.k_proj") then return true
    if _ends(family, ".self_attn.v_proj") then return true
    if _ends(family, ".self_attn.o_proj") then return true
    if _ends(family, ".mlp.gate_proj") then return true
    if _ends(family, ".mlp.up_proj") then return true
    if _ends(family, ".mlp.down_proj") then return true
    return false
}

fn _load_stored(
    string via,
    int total,
    gguf_manifest.GgufManifest m,
    string family,
    int layer
) → tensor.NumericBlock ⇥ PrefillError {
    const string gguf_name ← _gguf_name(family, layer)
    return _materialize(via, total, m, gguf_name)
}

fn _load_one(
    string via,
    int total,
    gguf_manifest.GgufManifest m,
    string family,
    int layer
) → tensor.NumericBlock ⇥ PrefillError {
    const tensor.NumericBlock stored ← _load_stored(via, total, m, family, layer)
    if _linear_family(family) {
        return _kmajor_to_linear(stored)
    }
    return stored
}

fn _lookup(
    string name,
    int layer,
    tensor.NumericBlock embed,
    tensor.NumericBlock norm_s,
    list<list<tensor.NumericBlock>> strata
) → tensor.NumericBlock ⇥ dense.DenseError {
    if name ≡ "model.embed_tokens" then return embed
    if name ≡ "model.norm" then return norm_s
    if layer ≺ 0 or layer ≥ strata.length() {
        throw variant MissingTensor {message = "layer out of range: " + (layer ↦ string)}
    }
    const int slot ← _slot(name)
    if slot ≺ 0 {
        throw variant MissingTensor {message = "unknown canonical tensor: " + name}
    }
    var list<tensor.NumericBlock> missing ← empty
    const list<tensor.NumericBlock> row ← strata.get(layer) coalesce missing
    if slot ≥ row.length() {
        throw variant MissingTensor {message = "layer slot missing: " + name}
    }
    const tensor.NumericBlock t ← row.get(slot) coalesce embed
    return t
}

fn _logit(tensor.NumericBlock logits, int pos, int tok) → f32 {
    do {
        return logits.get([pos, tok])
    }
    catch err {
        return 0.0 ∷ f32
    }
}

fn _top1(tensor.NumericBlock logits, int pos) → int {
    var int best ← 1
    var f32 best_v ← _logit(logits, pos, 1)
    var int i ← 3
    while i ≺ VOCAB {
        const f32 v ← _logit(logits, pos, i)
        if v ≻ best_v {
            best ← i
            best_v ← v
        }
        i ← i + 1
    }
    return best
}

fn _put_int(list<int> xs, int idx, int val) → list<int> {
    var list<int> out ← empty
    var int i ← 0
    while i ≺ xs.length() {
        if i ≡ idx {
            out.append(val)
        }
        else {
            out.append(xs.get(i) coalesce 0)
        }
        i ← i + 1
    }
    return out
}

fn _put_f32(list<f32> xs, int idx, f32 val) → list<f32> {
    var list<f32> out ← empty
    var int i ← 0
    while i ≺ xs.length() {
        if i ≡ idx {
            out.append(val)
        }
        else {
            out.append(xs.get(i) coalesce 0.0 ∷ f32)
        }
        i ← i + 1
    }
    return out
}

fn _top5(tensor.NumericBlock logits, int pos) → list<int> {
    var list<int> ids ← [0, 0, 0, 0, 0]
    var list<f32> vals ← [0.0 - 1000000.0 ∷ f32, 0.0 - 1000000.0 ∷ f32, 0.0 - 1000000.0 ∷ f32, 0.0 - 1000000.0 ∷ f32, 0.0 - 1000000.0 ∷ f32]
    var int i ← 0
    while i ≺ VOCAB {
        const f32 v ← _logit(logits, pos, i)
        if v ≻ (vals.get(4) coalesce (0.0 - 1000000.0 ∷ f32)) {
            var int j ← 4
            while j ≻ 0 {
                const f32 prev ← vals.get(j - 1) coalesce (0.0 - 1000000.0 ∷ f32)
                if v ≻ prev {
                    vals ← _put_f32(vals, j, prev)
                    ids ← _put_int(ids, j, ids.get(j - 1) coalesce 0)
                    j ← j - 1
                }
                else {
                    break
                }
            }
            vals ← _put_f32(vals, j, v)
            ids ← _put_int(ids, j, i)
        }
        i ← i + 1
    }
    return ids
}

fn _overlap5(list<int> observed, list<int> golden) → int {
    var int n ← 0
    var int i ← 0
    while i ≺ observed.length() {
        const int a ← observed.get(i) coalesce -1
        var int j ← 0
        while j ≺ golden.length() {
            if a ≡ (golden.get(j) coalesce -2) {
                n ← n + 1
                break
            }
            j ← j + 1
        }
        i ← i + 1
    }
    return n
}

fn _all_finite(tensor.NumericBlock logits, int pos) → bool {
    var int i ← 0
    while i ≺ VOCAB {
        if not dtype.finite(_logit(logits, pos, i)) then return false
        i ← i + 1
    }
    return true
}

fn _max_delta(tensor.NumericBlock logits, int pos, list<f32> golden) → f32 {
    var f32 maxd ← 0.0 ∷ f32
    var int i ← 0
    while i ≺ VOCAB {
        const f32 a ← _logit(logits, pos, i)
        const f32 b ← golden.get(i) coalesce 0.0 ∷ f32
        var f32 d ← a - b
        if d ≺ 0.0 {
            d ← 0.0 - d
        }
        if d ≻ maxd {
            maxd ← d
        }
        i ← i + 1
    }
    return maxd
}

fn _transpose_dv(tensor.NumericBlock t) → tensor.NumericBlock ⇥ PrefillError {
    const list<int> f ← t.shape()
    if f.length() ≠ 2 {
        throw variant BadAdapter {message = "trace transpose requires rank 2"}
    }
    const int rows ← f.get(0) coalesce 1
    const int cols ← f.get(1) coalesce 1
    var list<f32> out ← empty
    var int j ← 0
    while j ≺ cols {
        var int i ← 0
        while i ≺ rows {
            out.append(t.data.get(i * cols + j) coalesce 0.0 ∷ f32)
            i ← i + 1
        }
        j ← j + 1
    }
    return _tensor(out, [cols, rows])
}

fn _gather(tensor.NumericBlock embed, list<int> tokens) → tensor.NumericBlock ⇥ PrefillError {
    const list<int> fe ← embed.shape()
    const int d ← fe.get(1) coalesce 1
    const int v ← fe.get(0) coalesce 1
    var list<f32> out ← empty
    for from tokens const tok {
        if tok ≺ 0 or tok ≥ v {
            throw variant BadAdapter {message = "trace token id out of range"}
        }
        var int j ← 0
        while j ≺ d {
            out.append(embed.data.get(tok * d + j) coalesce 0.0 ∷ f32)
            j ← j + 1
        }
    }
    return _tensor(out, [tokens.length(), d])
}

# GGUF stored [D, V] is already token-major: data[token * D + d].
fn _gather_ggml(tensor.NumericBlock embed, list<int> tokens) → tensor.NumericBlock ⇥ PrefillError {
    const list<int> fe ← embed.shape()
    const int d ← fe.get(0) coalesce 1
    const int v ← fe.get(1) coalesce 1
    var list<f32> out ← empty
    for from tokens const tok {
        if tok ≺ 0 or tok ≥ v {
            throw variant BadAdapter {message = "trace token id out of range"}
        }
        var int j ← 0
        while j ≺ d {
            out.append(embed.data.get(tok * d + j) coalesce 0.0 ∷ f32)
            j ← j + 1
        }
    }
    return _tensor(out, [tokens.length(), d])
}

fn _list_max_delta(list<f32> a, list<f32> b) → f32 {
    var f32 maxd ← 0.0 ∷ f32
    var int n ← a.length()
    if b.length() ≺ n {
        n ← b.length()
    }
    var int i ← 0
    while i ≺ n {
        var f32 d ← (a.get(i) coalesce 0.0 ∷ f32) - (b.get(i) coalesce 0.0 ∷ f32)
        if d ≺ 0.0 {
            d ← 0.0 - d
        }
        if d ≻ maxd {
            maxd ← d
        }
        i ← i + 1
    }
    return maxd
}

fn _list_n_above(list<f32> a, list<f32> b, f32 band) → int {
    var int n ← a.length()
    if b.length() ≺ n {
        n ← b.length()
    }
    var int above ← 0
    var int i ← 0
    while i ≺ n {
        var f32 d ← (a.get(i) coalesce 0.0 ∷ f32) - (b.get(i) coalesce 0.0 ∷ f32)
        if d ≺ 0.0 {
            d ← 0.0 - d
        }
        if d ≻ band {
            above ← above + 1
        }
        i ← i + 1
    }
    return above
}

fn _band_row(string tagged, list<f32> observed, string via, int expected, f32 band) → string {
    do {
        const list<f32> golden ← _load_floats(via, expected)
        const f32 maxd ← _list_max_delta(observed, golden)
        const int above ← _list_n_above(observed, golden, band)
        const int n ← observed.length()
        if maxd ≺ band {
            return (((((tagged + ": PASS max_delta=") + (maxd ↦ string)) + " n_above=") + (above ↦ string)) + "/") + (n ↦ string)
        }
        return (((((tagged + ": FAIL max_delta=") + (maxd ↦ string)) + " n_above=") + (above ↦ string)) + "/") + (n ↦ string)
    }
    catch err {
        return tagged + ": FAIL " + message(err)
    }
}

fn _band_mem(string caption, list<f32> observed, list<f32> golden, f32 band) → string {
    const f32 maxd ← _list_max_delta(observed, golden)
    const int above ← _list_n_above(observed, golden, band)
    const int n ← observed.length()
    if maxd ≺ band {
        return (((((caption + ": PASS max_delta=") + (maxd ↦ string)) + " n_above=") + (above ↦ string)) + "/") + (n ↦ string)
    }
    return (((((caption + ": FAIL max_delta=") + (maxd ↦ string)) + " n_above=") + (above ↦ string)) + "/") + (n ↦ string)
}

fn _load_floats(string via, int expected) → list<f32> ⇥ PrefillError {
    var bool present ← false
    do {
        present ← fs.exists(via)
    }
    catch err {
        throw variant BadArguments {message = "float file missing: " + via}
    }
    if not present {
        throw variant BadArguments {message = "float file missing: " + via}
    }
    var list<string> lines ← empty
    do {
        lines ← fs.read_lines(via)
    }
    catch err {
        throw variant BadArguments {message = "float file unreadable: " + via}
    }
    if lines.length() ≠ expected {
        throw variant BadArguments {message = "float line count is not " + (expected ↦ string) + ": " + (lines.length() ↦ string)}
    }
    var list<f32> out ← empty
    var int i ← 0
    while i ≺ expected {
        do {
            out.append((lines.get(i) coalesce "0") ↦ f32)
        }
        catch err {
            throw variant BadArguments {message = "float parse failed at " + (i ↦ string)}
        }
        i ← i + 1
    }
    return out
}

fn _row_major(tensor.NumericBlock t, int row) → list<f32> {
    const list<int> f ← t.shape()
    const int d ← f.get(1) coalesce 0
    var list<f32> out ← empty
    var int j ← 0
    while j ≺ d {
        out.append(t.data.get(row * d + j) coalesce 0.0 ∷ f32)
        j ← j + 1
    }
    return out
}

fn _flat_slice(tensor.NumericBlock t, int off, int n) → list<f32> {
    var list<f32> out ← empty
    var int i ← 0
    while i ≺ n {
        out.append(t.data.get(off + i) coalesce 0.0 ∷ f32)
        i ← i + 1
    }
    return out
}

fn _linear_row0(tensor.NumericBlock stored, int n) → list<f32> {
    const list<int> f ← stored.shape()
    const int k ← f.get(0) coalesce 1
    var list<f32> out ← empty
    var int j ← 0
    while j ≺ n {
        out.append(stored.data.get(j * k) coalesce 0.0 ∷ f32)
        j ← j + 1
    }
    return out
}

fn _row1(list<f32> xs) → tensor.NumericBlock ⇥ PrefillError {
    return _tensor(xs, [1, xs.length()])
}

fn _q_head(list<f32> packed, int dim, int h) → list<f32> {
    var list<f32> out ← empty
    var int j ← 0
    while j ≺ dim {
        out.append(packed.get(h * dim + j) coalesce 0.0 ∷ f32)
        j ← j + 1
    }
    return out
}

fn _pad_at(list<f32> row, int tokens, int pos) → tensor.NumericBlock ⇥ PrefillError {
    const int d ← row.length()
    var list<f32> out ← empty
    var int t ← 0
    while t ≺ tokens {
        var int j ← 0
        while j ≺ d {
            if t ≡ pos {
                out.append(row.get(j) coalesce 0.0 ∷ f32)
            }
            else {
                out.append(0.0 ∷ f32)
            }
            j ← j + 1
        }
        t ← t + 1
    }
    return _tensor(out, [tokens, d])
}

fn _kv_head(list<f32> packed, int tokens, int kv_heads, int dim, int g) → tensor.NumericBlock ⇥ PrefillError {
    const int width ← kv_heads * dim
    var list<f32> out ← empty
    var int t ← 0
    while t ≺ tokens {
        var int j ← 0
        while j ≺ dim {
            out.append(packed.get((t * width + g * dim) + j) coalesce 0.0 ∷ f32)
            j ← j + 1
        }
        t ← t + 1
    }
    return _tensor(out, [tokens, dim])
}

fn _head_tensor(tensor.NumericBlock t, int start, int width) → tensor.NumericBlock ⇥ PrefillError {
    const list<int> f ← t.shape()
    const int rows ← f.get(0) coalesce 1
    const int full ← f.get(1) coalesce 1
    var list<f32> out ← empty
    var int i ← 0
    while i ≺ rows {
        var int j ← 0
        while j ≺ width {
            out.append(t.data.get((i * full + start) + j) coalesce 0.0 ∷ f32)
            j ← j + 1
        }
        i ← i + 1
    }
    return _tensor(out, [rows, width])
}

# GI2-1/GI2-2 attention: consecutive GQA (g = h / 3), causal row i keeps
# j ≤ i, then context = softmax(q·kᵀ·0.125) · v. Golden q is n_q=1 at
# pos 8; pad it into row 8 of a 9×64 query so the public causal row
# applies the same prefix (end = 8 + 1).
fn _gqa_context_pos8(list<f32> q1, list<f32> k9, list<f32> v9) → list<f32> ⇥ PrefillError {
    var list<f32> out ← empty
    var int h ← 0
    while h ≺ 15 {
        const int g ← h / 3
        const list<f32> qh ← _q_head(q1, 64, h)
        const tensor.NumericBlock qpad ← _pad_at(qh, 9, 8)
        const tensor.NumericBlock kh ← _kv_head(k9, 9, 5, 64, g)
        const tensor.NumericBlock vh ← _kv_head(v9, 9, 5, 64, g)
        var tensor.NumericBlock ctx ← tensor.default()
        do {
            ctx ← attention.scaled_dot_product_causal(qpad, kh, vh, 0.125 ∷ f32)
        }
        catch err {
            throw variant BadForward {message = "causal softmax/mask: " + err.message}
        }
        const list<f32> row ← _row_major(ctx, 8)
        var int j ← 0
        while j ≺ 64 {
            out.append(row.get(j) coalesce 0.0 ∷ f32)
            j ← j + 1
        }
        h ← h + 1
    }
    return out
}

fn _zeros2(int rows, int cols) → tensor.NumericBlock ⇥ PrefillError {
    do {
        return tensor.fill([rows, cols], 0.0 ∷ f32)
    }
    catch err {
        throw variant BadSlice {message = "zero fill failed: " + err.message}
    }
}

fn _dump_head(string tagged, list<f32> xs) {
    print "trace." + tagged + ".n=" + (xs.length() ↦ string)
    var int i ← 0
    while i ≺ xs.length() and i ≺ 8 {
        print "trace." + tagged + "." + (i ↦ string) + "=" + ((xs.get(i) coalesce 0.0 ∷ f32) ↦ string)
        i ← i + 1
    }
}

fn _write_floats(string via, list<f32> xs) {
    var string out ← ""
    var int i ← 0
    while i ≺ xs.length() {
        out ← out + ((xs.get(i) coalesce 0.0 ∷ f32) ↦ string)
        out ← out + "\n"
        i ← i + 1
    }
    do {
        fs.write_file(via, out)
    }
    catch err {
        panic "trace write failed: " + via
    }
}

fn _load_golden(string via) → list<f32> ⇥ PrefillError {
    var bool present ← false
    do {
        present ← fs.exists(via)
    }
    catch err {
        throw variant BadArguments {message = "golden file missing: " + via}
    }
    if not present {
        throw variant BadArguments {message = "golden file missing: " + via}
    }
    var list<string> lines ← empty
    do {
        lines ← fs.read_lines(via)
    }
    catch err {
        throw variant BadArguments {message = "golden file unreadable: " + via}
    }
    if lines.length() ≠ VOCAB {
        throw variant BadArguments {message = "golden line count is not 49152: " + (lines.length() ↦ string)}
    }
    var list<f32> out ← empty
    var int i ← 0
    while i ≺ VOCAB {
        do {
            out.append((lines.get(i) coalesce "0") ↦ f32)
        }
        catch err {
            throw variant BadArguments {message = "golden float parse failed at " + (i ↦ string)}
        }
        i ← i + 1
    }
    return out
}

main {
    const list<string> args ← process.argv() ↦ list<string>
    var string via ← PINNED_PATH
    var int expected_data ← PINNED_DATA
    var string digest ← PINNED_DIGEST
    var string golden_via ← ""
    var bool trace ← false
    if args.length() ≥ 3 {
        via ← args.get(0) coalesce PINNED_PATH
        do {
            expected_data ← (args.get(1) coalesce "0") ↦ int
            digest ← args.get(2) coalesce PINNED_DIGEST
        }
        catch err {
            panic "usage: dense-prefill-smollm2 <path> <data-offset> <sha256> [golden-pos0.txt|trace]"
        }
    }
    if args.length() ≥ 4 {
        const string extra ← args.get(3) coalesce ""
        if extra ≡ "trace" {
            trace ← true
        }
        else {
            golden_via ← extra
        }
    }

    print "policy: gi0-numeric-contract v1.0.0 + faber-prefill-oracle compare_gpu_logits (prompt-end / position 0)"
    print "engine: compiled rust (faber build --target rust; execute the printed binary)"
    print "backend: CPU/reference"
    print "model.path=" + via
    print "model.digest=" + digest

    const int total ← fs.byte_length(via)
    print "model.bytes=" + (total ↦ string)
    if total ≠ PINNED_BYTES {
        panic "model byte length mismatch: observed=" + (total ↦ string) + " expected=" + (PINNED_BYTES ↦ string)
    }

    const bytes prefix_bytes ← fs.read_range(via, 0, expected_data)
    if prefix_bytes.length() ≠ expected_data {
        panic "file adapter returned a short table-prefix read"
    }
    const value prefix_payload ← prefix_bytes ↦ value
    const list<int> prefix ← prefix_payload ↦ list<int>
    const artifact.ContentIdentity identity ← artifact.ContentIdentity {
        algorithm = "sha-256",
        digest = digest,
        length = total
    }

    var gguf_manifest.GgufManifest admitted ← gguf_manifest.GgufManifest {
        identity = identity,
        version = 0,
        alignment = 0,
        data_start = 0,
        artifact_length = 0,
        metadata = empty,
        tensors = empty
    }
    do {
        admitted ← gguf_manifest.inspect(
            (int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _prefix_range(prefix, start, length),
            total,
            identity
        )
    }
    catch err {
        panic "manifest admission failed: " + err.message
    }
    var string architecture ← ""
    do {
        architecture ← gguf_manifest.text(admitted, "general.architecture")
    }
    catch err {
        panic "architecture fact read failed: " + err.message
    }
    print "admit: PASS version=" + (admitted.version ↦ string)
        + " data=" + (admitted.data_start ↦ string)
        + " tensors=" + (admitted.tensors.length() ↦ string)
        + " architecture=" + architecture

    var list<int> tokens ← PINNED_TOKENS
    var string tokenizer_row ← "tokenizer: SKIPPED (using pinned fixture ids)"
    do {
        const tokenizer.Tokenizer tok ← tokenizer.build(admitted)
        const list<int> encoded ← tokenizer.encode_prompt(tok, PINNED_PROMPT)
        if _ids_eq(encoded, PINNED_TOKENS) {
            tokens ← encoded
            tokenizer_row ← "tokenizer: PASS ids=" + _ids_text(encoded)
        }
        else {
            tokenizer_row ← "tokenizer: DIVERGED observed=" + _ids_text(encoded) + " pinned=" + _ids_text(PINNED_TOKENS)
            tokens ← PINNED_TOKENS
        }
    }
    catch err {
        tokenizer_row ← "tokenizer: FAIL " + err.message
        tokens ← PINNED_TOKENS
    }
    print tokenizer_row
    print "prompt_tokens=" + _ids_text(tokens)

    print "loading stored-weight views..."
    var tensor.NumericBlock embed ← tensor.default()
    var tensor.NumericBlock norm_s ← tensor.default()
    do {
        embed ← _load_one(via, total, admitted, "model.embed_tokens", 0)
        norm_s ← _load_one(via, total, admitted, "model.norm", 0)
    }
    catch err {
        panic message(err)
    }
    print "loaded embed+norm"
    print "model_shape layers=32 heads=15 kv_heads=5 head_dim=64 hidden=960 vocab=49152"
    print "stored_embed_shape=[" + ((embed.shape().get(0) coalesce 0) ↦ string) + "," + ((embed.shape().get(1) coalesce 0) ↦ string) + "]"

    if trace {
        print "trace: layer-0 prompt-end (position 8 / token 2767) vs GI2-2 goldens"
        const list<f32> raw_token_major ← _flat_slice(embed, 2767 * 960, 960)
        _dump_head("embed_raw_token_major", raw_token_major)
        _write_floats("/tmp/hand-12-u19-embed-raw-token-major.txt", raw_token_major)

        var tensor.NumericBlock gathered ← tensor.default()
        do {
            gathered ← _gather_ggml(embed, tokens)
        }
        catch err {
            panic "trace gather failed: " + message(err)
        }
        print "gathered_shape=[" + ((gathered.shape().get(0) coalesce 0) ↦ string) + "," + ((gathered.shape().get(1) coalesce 0) ↦ string) + "]"
        const list<f32> gathered_row ← _row_major(gathered, tokens.length() - 1)
        _dump_head("embed_gathered_pos8", gathered_row)
        _write_floats("/tmp/hand-12-u19-embed-gathered-pos8.txt", gathered_row)

        const f32 vs_raw ← _list_max_delta(gathered_row, raw_token_major)
        print "gather_vs_raw max_delta=" + (vs_raw ↦ string)
        print _band_row("gather", gathered_row, GOLDEN_X_PATH, 960, GATHER_BAND)

        var tensor.NumericBlock ln1_s ← tensor.default()
        do {
            ln1_s ← _load_one(via, total, admitted, "model.layers.input_layernorm", 0)
        }
        catch err {
            panic "trace attn_norm load failed: " + message(err)
        }
        const list<f32> ln1_w ← _flat_slice(ln1_s, 0, 960)
        _dump_head("blk0_attn_norm_weight", ln1_w)
        _write_floats("/tmp/hand-12-u19-blk0-attn-norm-weight.txt", ln1_w)

        var tensor.NumericBlock ln1 ← tensor.default()
        do {
            ln1 ← nn.rmsnorm(gathered, ln1_s, 0.00001 ∷ f32)
        }
        catch err {
            panic "trace rmsnorm failed: " + err.message
        }
        const list<f32> ln1_row ← _row_major(ln1, tokens.length() - 1)
        _dump_head("layer0_rms_norm_pos8", ln1_row)
        _write_floats("/tmp/hand-14-u19-layer0-rms-norm-pos8.txt", ln1_row)
        print _band_row("rmsnorm", ln1_row, GOLDEN_RMS_Y_PATH, 960, DENSE_BAND)

        var tensor.NumericBlock wq_stored ← tensor.default()
        do {
            wq_stored ← _load_stored(via, total, admitted, "model.layers.self_attn.q_proj", 0)
        }
        catch err {
            panic "trace q_proj load failed: " + message(err)
        }
        print "stored_wq_shape=[" + ((wq_stored.shape().get(0) coalesce 0) ↦ string) + "," + ((wq_stored.shape().get(1) coalesce 0) ↦ string) + "]"
        const list<f32> wq_kmajor_head ← _flat_slice(wq_stored, 0, 32)
        _dump_head("wq_kmajor_head", wq_kmajor_head)
        print _band_row("wq_dequant_head", wq_kmajor_head, GOLDEN_WQ_HEAD_PATH, 32, DENSE_BAND)

        var tensor.NumericBlock wq ← tensor.default()
        do {
            wq ← _kmajor_to_linear(wq_stored)
        }
        catch err {
            panic "trace q_proj k-major convert failed: " + message(err)
        }
        print "linear_wq_shape=[" + ((wq.shape().get(0) coalesce 0) ↦ string) + "," + ((wq.shape().get(1) coalesce 0) ↦ string) + "]"

        var tensor.NumericBlock bq ← tensor.default()
        do {
            bq ← tensor.fill([tokens.length(), 960], 0.0 ∷ f32)
        }
        catch err {
            panic "trace q bias failed: " + err.message
        }
        var tensor.NumericBlock qb ← tensor.default()
        do {
            qb ← nn.linear_carrier(ln1, wq, bq)
        }
        catch err {
            panic "trace q linear failed: " + err.message
        }
        const list<f32> q_row ← _row_major(qb, tokens.length() - 1)
        var list<f32> q_head0 ← empty
        var int qh ← 0
        while qh ≺ 64 {
            q_head0.append(q_row.get(qh) coalesce 0.0 ∷ f32)
            qh ← qh + 1
        }
        _dump_head("layer0_q_head0_pos8", q_head0)
        _write_floats("/tmp/hand-25-u19-layer0-q-head0-pos8.txt", q_head0)
        print _band_row("q_linear", q_head0, GOLDEN_DENSE_Y_PATH, 64, DENSE_BAND)
        print _band_row("embed_dequant_head", _flat_slice(embed, 0, 32), GOLDEN_EMB_HEAD_PATH, 32, DENSE_BAND)

        var tensor.NumericBlock wk_stored ← tensor.default()
        do {
            wk_stored ← _load_stored(via, total, admitted, "model.layers.self_attn.k_proj", 0)
        }
        catch err {
            panic "trace k_proj load failed: " + message(err)
        }
        print "stored_wk_shape=[" + ((wk_stored.shape().get(0) coalesce 0) ↦ string) + "," + ((wk_stored.shape().get(1) coalesce 0) ↦ string) + "]"
        print _band_row("wk_dequant_head", _flat_slice(wk_stored, 0, 32), GOLDEN_WK_HEAD_PATH, 32, DENSE_BAND)
        print _band_row("wk_linear_row0", _linear_row0(wk_stored, 32), GOLDEN_WK_ROW0_PATH, 32, DENSE_BAND)
        var tensor.NumericBlock wk ← tensor.default()
        do {
            wk ← _kmajor_to_linear(wk_stored)
        }
        catch err {
            panic "trace k_proj k-major convert failed: " + message(err)
        }
        var tensor.NumericBlock bk ← tensor.default()
        do {
            bk ← _zeros2(tokens.length(), 320)
        }
        catch err {
            panic "trace k bias failed: " + message(err)
        }
        var tensor.NumericBlock kb ← tensor.default()
        do {
            kb ← nn.linear_carrier(ln1, wk, bk)
        }
        catch err {
            panic "trace k linear failed: " + err.message
        }
        const list<f32> k_row ← _row_major(kb, tokens.length() - 1)
        do {
            const list<f32> k_ref ← _load_floats(GOLDEN_WK_Y_PATH, 320)
            const f32 k_vs_gi21 ← _list_max_delta(k_row, k_ref)
            print "k_linear_vs_gi21_matmul max_delta=" + (k_vs_gi21 ↦ string) + " (layout is dequant+row0; no pre-rope GI2-2)"
        }
        catch err {
            print "k_linear_vs_gi21_matmul: FAIL " + message(err)
        }

        var tensor.NumericBlock wv_stored ← tensor.default()
        do {
            wv_stored ← _load_stored(via, total, admitted, "model.layers.self_attn.v_proj", 0)
        }
        catch err {
            panic "trace v_proj load failed: " + message(err)
        }
        print "stored_wv_shape=[" + ((wv_stored.shape().get(0) coalesce 0) ↦ string) + "," + ((wv_stored.shape().get(1) coalesce 0) ↦ string) + "]"
        print _band_row("wv_dequant_head", _flat_slice(wv_stored, 0, 32), GOLDEN_WV_HEAD_PATH, 32, DENSE_BAND)
        print _band_row("wv_linear_row0", _linear_row0(wv_stored, 32), GOLDEN_WV_ROW0_PATH, 32, DENSE_BAND)
        var tensor.NumericBlock wv ← tensor.default()
        do {
            wv ← _kmajor_to_linear(wv_stored)
        }
        catch err {
            panic "trace v_proj k-major convert failed: " + message(err)
        }
        var tensor.NumericBlock bv ← tensor.default()
        do {
            bv ← _zeros2(tokens.length(), 320)
        }
        catch err {
            panic "trace v bias failed: " + message(err)
        }
        var tensor.NumericBlock vb ← tensor.default()
        do {
            vb ← nn.linear_carrier(ln1, wv, bv)
        }
        catch err {
            panic "trace v linear failed: " + err.message
        }
        print _band_row("v_linear", _row_major(vb, tokens.length() - 1), GOLDEN_WV_Y_PATH, 320, DENSE_BAND)

        print "trace: attention softmax/mask family vs GI2-2 / GI2-1 causal reference"
        var list<int> attn_pos ← empty
        var int ap ← 0
        while ap ≺ tokens.length() {
            attn_pos.append(ap)
            ap ← ap + 1
        }

        # Synthetic causal-mask oracle (GI3 recipe): zero scores, v[:,0] = t+1.
        # Row i of uniform-on-prefix softmax is the prefix mean (i+2)/2.
        var list<f32> mask_q ← empty
        var list<f32> mask_v ← empty
        var int mt ← 0
        while mt ≺ 9 {
            var int md ← 0
            while md ≺ 64 {
                mask_q.append(0.0 ∷ f32)
                if md ≡ 0 {
                    mask_v.append((mt + 1) ↦ f32)
                }
                else {
                    mask_v.append(0.0 ∷ f32)
                }
                md ← md + 1
            }
            mt ← mt + 1
        }
        var tensor.NumericBlock mq ← tensor.default()
        var tensor.NumericBlock mv ← tensor.default()
        do {
            mq ← _tensor(mask_q, [9, 64])
            mv ← _tensor(mask_v, [9, 64])
        }
        catch err {
            panic "mask tensor construct failed: " + message(err)
        }
        do {
            const tensor.NumericBlock mctx ← attention.scaled_dot_product_causal(mq, mq, mv, 1.0 ∷ f32)
            const f32 r0 ← mctx.data.get(0) coalesce 0.0 ∷ f32
            const f32 r7 ← mctx.data.get(7 * 64) coalesce 0.0 ∷ f32
            const f32 r8 ← mctx.data.get(8 * 64) coalesce 0.0 ∷ f32
            print "mask.row0=" + (r0 ↦ string) + " expect=1 (only self)"
            print "mask.row7=" + (r7 ↦ string) + " expect=4.5 (prefix 1..8)"
            print "mask.row8=" + (r8 ↦ string) + " expect=5 (prefix 1..9, diagonal included)"
            var f32 d0 ← r0 - 1.0
            if d0 ≺ 0.0 {
                d0 ← 0.0 - d0
            }
            var f32 d7 ← r7 - 4.5
            if d7 ≺ 0.0 {
                d7 ← 0.0 - d7
            }
            var f32 d8 ← r8 - 5.0
            if d8 ≺ 0.0 {
                d8 ← 0.0 - d8
            }
            if d0 ≺ DENSE_BAND and d7 ≺ DENSE_BAND and d8 ≺ DENSE_BAND {
                print "mask_construction: PASS (j ≤ i, diagonal included, no off-by-one)"
            }
            else {
                print "mask_construction: FAIL d0=" + (d0 ↦ string) + " d7=" + (d7 ↦ string) + " d8=" + (d8 ↦ string)
            }
        }
        catch err {
            print "mask_construction: FAIL " + err.message
        }

        # Softmax numerics: max-subtraction keeps the valid prefix; all-zero
        # scores must produce a uniform prefix (already implied by the mask
        # row). A second pin: identity q=k at scale 0 yields the same prefix
        # means (exp domain stays at 1 after max-sub).
        print "softmax_numerics: max-subtraction present (prefix max then exp(x-max)); exp via e^x"

        # Integrative check: GI2-2 attention.json q/k/v → context (attn @ v).
        # No separate softmax golden exists; GI2-2 expected_output is context.
        do {
            const list<f32> gq ← _load_floats(GOLDEN_Q_POS8_PATH, 960)
            const list<f32> gk ← _load_floats(GOLDEN_K_FULL_PATH, 2880)
            const list<f32> gv ← _load_floats(GOLDEN_V_FULL_PATH, 2880)
            const list<f32> ctx_from_golden_qkv ← _gqa_context_pos8(gq, gk, gv)
            print _band_row("attn_context_from_gi22_qkv", ctx_from_golden_qkv, GOLDEN_CTX_PATH, 960, DENSE_BAND)
        }
        catch err {
            print "attn_context_from_gi22_qkv: FAIL " + message(err)
        }

        # Live layer-0 Q/K/V + RoPE + causal softmax × V at pos 8.
        do {
            var list<f32> live_q_pos8 ← empty
            var list<f32> live_ctx ← empty
            var int h ← 0
            while h ≺ 15 {
                const int g ← h / 3
                const tensor.NumericBlock q_hd ← _head_tensor(qb, h * 64, 64)
                const tensor.NumericBlock k_hd ← _head_tensor(kb, g * 64, 64)
                const tensor.NumericBlock v_hd ← _head_tensor(vb, g * 64, 64)
                var tensor.NumericBlock qr ← tensor.default()
                var tensor.NumericBlock kr ← tensor.default()
                do {
                    qr ← attention.rotary_position_embedding(q_hd, attn_pos, 64)
                    kr ← attention.rotary_position_embedding(k_hd, attn_pos, 64)
                }
                catch err {
                    panic "live rope: " + err.message
                }
                const list<f32> qr8 ← _row_major(qr, tokens.length() - 1)
                var int qj ← 0
                while qj ≺ 64 {
                    live_q_pos8.append(qr8.get(qj) coalesce 0.0 ∷ f32)
                    qj ← qj + 1
                }
                var tensor.NumericBlock ctxh ← tensor.default()
                do {
                    ctxh ← attention.scaled_dot_product_causal(qr, kr, v_hd, 0.125 ∷ f32)
                }
                catch err {
                    panic "live causal: " + err.message
                }
                const list<f32> c8 ← _row_major(ctxh, tokens.length() - 1)
                var int cj ← 0
                while cj ≺ 64 {
                    live_ctx.append(c8.get(cj) coalesce 0.0 ∷ f32)
                    cj ← cj + 1
                }
                h ← h + 1
            }
            print _band_row("live_rope_q_pos8", live_q_pos8, GOLDEN_Q_POS8_PATH, 960, DENSE_BAND)
            print _band_row("attn_context_live", live_ctx, GOLDEN_CTX_PATH, 960, DENSE_BAND)
        }
        catch err {
            print "attn_context_live: FAIL " + message(err)
        }

        var tensor.NumericBlock wo_stored ← tensor.default()
        do {
            wo_stored ← _load_stored(via, total, admitted, "model.layers.self_attn.o_proj", 0)
        }
        catch err {
            panic "trace o_proj load failed: " + message(err)
        }
        print "stored_wo_shape=[" + ((wo_stored.shape().get(0) coalesce 0) ↦ string) + "," + ((wo_stored.shape().get(1) coalesce 0) ↦ string) + "]"
        print _band_row("wo_dequant_head", _flat_slice(wo_stored, 0, 32), GOLDEN_WO_HEAD_PATH, 32, DENSE_BAND)
        print _band_row("wo_linear_row0", _linear_row0(wo_stored, 32), GOLDEN_WO_ROW0_PATH, 32, DENSE_BAND)
        var tensor.NumericBlock wo ← tensor.default()
        do {
            wo ← _kmajor_to_linear(wo_stored)
        }
        catch err {
            panic "trace o_proj k-major convert failed: " + message(err)
        }
        var tensor.NumericBlock ctx_t ← tensor.default()
        do {
            ctx_t ← _row1(_load_floats(GOLDEN_CTX_PATH, 960))
        }
        catch err {
            panic "trace o context load failed: " + message(err)
        }
        var tensor.NumericBlock bo ← tensor.default()
        do {
            bo ← _zeros2(1, 960)
        }
        catch err {
            panic "trace o bias failed: " + message(err)
        }
        var tensor.NumericBlock ob ← tensor.default()
        do {
            ob ← nn.linear_carrier(ctx_t, wo, bo)
        }
        catch err {
            panic "trace o linear failed: " + err.message
        }
        print _band_row("o_linear", _row_major(ob, 0), GOLDEN_WO_Y_PATH, 960, DENSE_BAND)
        var tensor.NumericBlock wot ← tensor.default()
        do {
            wot ← _transpose_dv(wo)
        }
        catch err {
            panic "trace o transpose failed: " + message(err)
        }
        do {
            const tensor.NumericBlock obt ← nn.linear_carrier(ctx_t, wot, bo)
            print _band_row("o_linear_via_wo_T", _row_major(obt, 0), GOLDEN_WO_Y_PATH, 960, DENSE_BAND)
        }
        catch err {
            print "o_linear_via_wo_T: FAIL " + err.message
        }

        var tensor.NumericBlock ffn_x ← tensor.default()
        do {
            ffn_x ← _row1(_load_floats(GOLDEN_FFN_NORMED_PATH, 960))
        }
        catch err {
            panic "trace ffn-normed input load failed: " + message(err)
        }

        var tensor.NumericBlock wg_stored ← tensor.default()
        do {
            wg_stored ← _load_stored(via, total, admitted, "model.layers.mlp.gate_proj", 0)
        }
        catch err {
            panic "trace gate_proj load failed: " + message(err)
        }
        print "stored_wg_shape=[" + ((wg_stored.shape().get(0) coalesce 0) ↦ string) + "," + ((wg_stored.shape().get(1) coalesce 0) ↦ string) + "]"
        print _band_row("wg_dequant_head", _flat_slice(wg_stored, 0, 32), GOLDEN_WG_HEAD_PATH, 32, DENSE_BAND)
        print _band_row("wg_linear_row0", _linear_row0(wg_stored, 32), GOLDEN_WG_ROW0_PATH, 32, DENSE_BAND)
        var tensor.NumericBlock wg ← tensor.default()
        do {
            wg ← _kmajor_to_linear(wg_stored)
        }
        catch err {
            panic "trace gate k-major convert failed: " + message(err)
        }
        var tensor.NumericBlock bg ← tensor.default()
        do {
            bg ← _zeros2(1, 2560)
        }
        catch err {
            panic "trace gate bias failed: " + message(err)
        }
        var tensor.NumericBlock gb ← tensor.default()
        do {
            gb ← nn.linear_carrier(ffn_x, wg, bg)
        }
        catch err {
            panic "trace gate linear failed: " + err.message
        }
        print _band_row("gate_linear", _row_major(gb, 0), GOLDEN_WG_Y_PATH, 2560, DENSE_BAND)

        var tensor.NumericBlock wu_stored ← tensor.default()
        do {
            wu_stored ← _load_stored(via, total, admitted, "model.layers.mlp.up_proj", 0)
        }
        catch err {
            panic "trace up_proj load failed: " + message(err)
        }
        print "stored_wu_shape=[" + ((wu_stored.shape().get(0) coalesce 0) ↦ string) + "," + ((wu_stored.shape().get(1) coalesce 0) ↦ string) + "]"
        print _band_row("wu_dequant_head", _flat_slice(wu_stored, 0, 32), GOLDEN_WU_HEAD_PATH, 32, DENSE_BAND)
        print _band_row("wu_linear_row0", _linear_row0(wu_stored, 32), GOLDEN_WU_ROW0_PATH, 32, DENSE_BAND)
        var tensor.NumericBlock wu ← tensor.default()
        do {
            wu ← _kmajor_to_linear(wu_stored)
        }
        catch err {
            panic "trace up k-major convert failed: " + message(err)
        }
        var tensor.NumericBlock bu ← tensor.default()
        do {
            bu ← _zeros2(1, 2560)
        }
        catch err {
            panic "trace up bias failed: " + message(err)
        }
        var tensor.NumericBlock ub ← tensor.default()
        do {
            ub ← nn.linear_carrier(ffn_x, wu, bu)
        }
        catch err {
            panic "trace up linear failed: " + err.message
        }
        print _band_row("up_linear", _row_major(ub, 0), GOLDEN_WU_Y_PATH, 2560, DENSE_BAND)

        var tensor.NumericBlock wd_stored ← tensor.default()
        do {
            wd_stored ← _load_stored(via, total, admitted, "model.layers.mlp.down_proj", 0)
        }
        catch err {
            panic "trace down_proj load failed: " + message(err)
        }
        print "stored_wd_shape=[" + ((wd_stored.shape().get(0) coalesce 0) ↦ string) + "," + ((wd_stored.shape().get(1) coalesce 0) ↦ string) + "]"
        print _band_row("wd_dequant_head", _flat_slice(wd_stored, 0, 32), GOLDEN_WD_HEAD_PATH, 32, DENSE_BAND)
        print _band_row("wd_linear_row0", _linear_row0(wd_stored, 32), GOLDEN_WD_ROW0_PATH, 32, DENSE_BAND)
        var tensor.NumericBlock wd ← tensor.default()
        do {
            wd ← _kmajor_to_linear(wd_stored)
            print "linear_wd_shape=[" + ((wd.shape().get(0) coalesce 0) ↦ string) + "," + ((wd.shape().get(1) coalesce 0) ↦ string) + "]"
        }
        catch err {
            panic "trace down k-major convert failed: " + message(err)
        }

        print "trace: post-attention families (RMSNorm / SwiGLU act / ffn_down / residual-2)"

        var tensor.NumericBlock r1_t ← tensor.default()
        do {
            r1_t ← _row1(_load_floats(GOLDEN_RES_Y_PATH, 960))
        }
        catch err {
            panic "trace residual.y load failed: " + message(err)
        }
        var tensor.NumericBlock ln2_s ← tensor.default()
        do {
            ln2_s ← _load_one(via, total, admitted, "model.layers.post_attention_layernorm", 0)
        }
        catch err {
            panic "trace ffn_norm load failed: " + message(err)
        }
        var tensor.NumericBlock ln2 ← tensor.default()
        do {
            ln2 ← nn.rmsnorm(r1_t, ln2_s, 0.00001 ∷ f32)
        }
        catch err {
            panic "trace post-attn rmsnorm failed: " + err.message
        }
        const list<f32> ln2_row ← _row_major(ln2, 0)
        _dump_head("layer0_post_attn_rmsnorm_pos8", ln2_row)
        print _band_row("post_attn_rmsnorm", ln2_row, GOLDEN_FFN_NORMED_PATH, 960, DENSE_BAND)

        var tensor.NumericBlock silu_g ← tensor.default()
        do {
            silu_g ← nn.silu(gb)
        }
        catch err {
            panic "trace silu(gate) failed: " + err.message
        }
        var list<f32> act ← empty
        var int ai ← 0
        while ai ≺ 2560 {
            const f32 sg ← silu_g.data.get(ai) coalesce 0.0 ∷ f32
            const f32 uv ← ub.data.get(ai) coalesce 0.0 ∷ f32
            act.append(sg * uv)
            ai ← ai + 1
        }
        _dump_head("layer0_swiglu_activation_pos8", act)
        print _band_row("swiglu_activation", act, GOLDEN_SWIGLU_Y_PATH, 2560, DENSE_BAND)

        var tensor.NumericBlock act_t ← tensor.default()
        do {
            act_t ← _row1(_load_floats(GOLDEN_SWIGLU_Y_PATH, 2560))
        }
        catch err {
            panic "trace swiglu.y load failed: " + message(err)
        }
        var tensor.NumericBlock bd ← tensor.default()
        do {
            bd ← _zeros2(1, 960)
        }
        catch err {
            panic "trace down bias failed: " + message(err)
        }
        var tensor.NumericBlock down_t ← tensor.default()
        do {
            down_t ← nn.linear_carrier(act_t, wd, bd)
        }
        catch err {
            panic "trace ffn_down linear failed: " + err.message
        }
        const list<f32> down_row ← _row_major(down_t, 0)
        _dump_head("layer0_ffn_down_pos8", down_row)
        print _band_row("ffn_down", down_row, GOLDEN_FFN_DOWN_Y_PATH, 960, DENSE_BAND)

        const list<f32> r1_row ← _row_major(r1_t, 0)
        var list<f32> r2_r1 ← empty
        var list<f32> r2_ln2 ← empty
        var int ri ← 0
        while ri ≺ 960 {
            const f32 a ← r1_row.get(ri) coalesce 0.0 ∷ f32
            const f32 n ← ln2_row.get(ri) coalesce 0.0 ∷ f32
            const f32 h ← down_row.get(ri) coalesce 0.0 ∷ f32
            r2_r1.append(a + h)
            r2_ln2.append(n + h)
            ri ← ri + 1
        }
        _dump_head("layer0_residual2_r1_plus_h_pos8", r2_r1)
        print _band_row("residual2_r1_plus_h", r2_r1, GOLDEN_RES2_PATH, 960, DENSE_BAND)
        const f32 r2_wiring ← _list_max_delta(r2_ln2, r2_r1)
        print "residual2_ln2_plus_h_vs_r1_plus_h max_delta=" + (r2_wiring ↦ string)
        print _band_row("residual2_ln2_plus_h", r2_ln2, GOLDEN_RES2_PATH, 960, DENSE_BAND)

        print "trace: dumps written under /tmp/hand-48-u19-*"
        print "TRACE: STOP after layer-0 post-attn RMSNorm / SwiGLU act / ffn_down / residual-2"
    }

    if not trace {

    const list<string> families ← [
        "model.layers.input_layernorm",
        "model.layers.self_attn.q_proj",
        "model.layers.self_attn.k_proj",
        "model.layers.self_attn.v_proj",
        "model.layers.self_attn.o_proj",
        "model.layers.post_attention_layernorm",
        "model.layers.mlp.gate_proj",
        "model.layers.mlp.up_proj",
        "model.layers.mlp.down_proj"
    ]
    var list<list<tensor.NumericBlock>> strata ← empty
    var int layer ← 0
    while layer ≺ 32 {
        var list<tensor.NumericBlock> row ← empty
        var int f ← 0
        while f ≺ families.length() {
            do {
                row.append(_load_one(via, total, admitted, families.get(f) coalesce "", layer))
            }
            catch err {
                panic ("layer " + (layer ↦ string)) + " " + message(err)
            }
            f ← f + 1
        }
        strata.append(row)
        print "loaded layer " + (layer ↦ string)
        layer ← layer + 1
    }

    var attention.RopeConfig rope ← attention.default()
    do {
        rope ← attention.construct_rope_config(100000.0 ∷ f32, 1.0 ∷ f32, attention.consecutive_policy())
    }
    catch err {
        panic "rope config failed: " + err.message
    }

    var list<int> positions ← empty
    var int p ← 0
    while p ≺ tokens.length() {
        positions.append(p)
        p ← p + 1
    }

    const dense.DenseConfig cfg ← dense.DenseConfig {
        layers = 32,
        heads = 15,
        kv_heads = 5,
        head_dim = 64,
        hidden_dim = 960,
        vocab = 49152,
        tied = true
    }

    print "forward start T=" + (tokens.length() ↦ string)
    var tensor.NumericBlock logits ← tensor.default()
    do {
        logits ← dense.forward(
            cfg,
            (string n, int s) → tensor.NumericBlock ⇥ dense.DenseError ∴ _lookup(n, s, embed, norm_s, strata),
            tokens,
            0.00001 ∷ f32,
            0.125 ∷ f32,
            positions,
            64,
            rope
        )
    }
    catch err {
        panic "forward failed: " + err.message
    }
    print "forward done shape=[" + ((logits.shape().get(0) coalesce 0) ↦ string) + "," + ((logits.shape().get(1) coalesce 0) ↦ string) + "]"

    const int pos ← tokens.length() - 1
    const int top1 ← _top1(logits, pos)
    const list<int> top5 ← _top5(logits, pos)
    const bool finite ← _all_finite(logits, pos)
    const bool top1_ok ← top1 ≡ GOLDEN_TOP1
    const int overlap ← _overlap5(top5, GOLDEN_TOP5)
    const bool top5_ok ← overlap ≥ 4

    print "position=0 (prompt end, last prefill row " + (pos ↦ string) + ")"
    print "observed_top1_non_eog=" + (top1 ↦ string)
    print "golden_top1_non_eog=" + (GOLDEN_TOP1 ↦ string)
    print "top1_matches=" + (top1_ok ↦ string)
    print "observed_top5=" + _ids_text(top5)
    print "golden_top5=" + _ids_text(GOLDEN_TOP5)
    print "top5_overlap=" + (overlap ↦ string) + "/5"
    print "all_finite=" + (finite ↦ string)

    var bool band_ok ← true
    var string band_row ← "band: not_compared (no golden file)"
    if golden_via.length() ≻ 0 {
        do {
            const list<f32> golden ← _load_golden(golden_via)
            const f32 maxd ← _max_delta(logits, pos, golden)
            band_ok ← maxd ≤ BAND_Q2
            band_row ← (("band max_delta=" + (maxd ↦ string)) + " envelope=") + (BAND_Q2 ↦ string) + " ok=" + (band_ok ↦ string)
        }
        catch err {
            band_ok ← false
            band_row ← "band: FAIL " + message(err)
        }
    }
    print band_row

    var string divergence ← "none"
    if not finite {
        divergence ← "position 0: finite gate failed"
    }
    else {
        if not top1_ok {
            divergence ← (("position 0: top-1 " + (top1 ↦ string)) + " vs golden ") + (GOLDEN_TOP1 ↦ string)
        }
        else {
            if not top5_ok {
                divergence ← "position 0: top-5 overlap " + (overlap ↦ string) + "/5"
            }
            else {
                if golden_via.length() ≻ 0 and not band_ok {
                    divergence ← "position 0: band"
                }
            }
        }
    }
    print "first_divergence=" + divergence

    if divergence ≡ "none" {
        print "PREFILL: PASS"
    }
    else {
        print "PREFILL: FAIL"
    }
    }
}
