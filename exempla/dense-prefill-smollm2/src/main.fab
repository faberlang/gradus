+++
locale = "en"
+++
# REF-01-U1.9 — SmolLM2 full-prefill logit receipt (compiled rust route).
#
# Application-owned adapter: admit the operator-local SmolLM2-360M
# GGUF, materialize stored-weight views through the public GGUF-A3
# windowed surface, run the U1.8 dense forward on the pinned
# correctness-fixture prompt, and print the gi0 / faber-prefill-oracle
# comparison (prompt-end / position 0). Gradus never receives the path.

import from "gradus:attention" attention
import from "gradus:dtype" dtype
import from "gradus:model/artifact" artifact
import from "gradus:model/dense" dense
import from "gradus:model/gguf_manifest" manifestum
import from "gradus:model/tensor_payload" tensor_payload
import from "gradus:model/tensor_view" tensor_view
import from "gradus:tensor" tensor
import from "gradus:tokenizer" tokenizator
import from "norma:processus" processus
import from "norma:solum" solum

const string PINNED_PATH ← "/Users/ianzepp/ai/models/SmolLM2-360M-Instruct-Q4_K_M.gguf"
const string PINNED_DIGEST ← "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2"
const int PINNED_BYTES ← 270590880
const int PINNED_DATA ← 1787040
const string PINNED_PROMPT ← "The quick brown fox jumps over the lazy dog"
const list<int> PINNED_TOKENS ← [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767]
const int GOLDEN_TOP1 ← 30
const list<int> GOLDEN_TOP5 ← [30, 28, 1270, 365, 198]
const int VOCAB ← 49152
const int SLICE_CAP ← 16777216
const f32 BAND_Q2 ← 0.0065 ∷ f32
const int EOG_0 ← 0
const int EOG_2 ← 2

union PrefillError {
    ArgumentaMala { string message }
    LongitudoMala { string message }
    ManifestumMala { string message }
    TokenizerMala { string message }
    AdapterMala { string message }
    VinculumMala { string message }
    SlicemMala { string message }
    ForwardMala { string message }
}

fn message(PrefillError e) → string {
    match e {
        case ArgumentaMala const message { return message }
        case LongitudoMala const message { return message }
        case ManifestumMala const message { return message }
        case TokenizerMala const message { return message }
        case AdapterMala const message { return message }
        case VinculumMala const message { return message }
        case SlicemMala const message { return message }
        case ForwardMala const message { return message }
    }
}

fn _range(string via, int total, int initium, int longitudo) → manifestum.SourceRead {
    if initium < 0 or longitudo < 0 or initium > total - longitudo {
        return manifestum.SourceRead {
            successus = false,
            bytes = ||,
            message = "range request exceeds the artifact"
        }
    }
    const bytes bytes ← solum.read_range(via, initium, longitudo)
    if bytes.length() ≠ longitudo {
        return manifestum.SourceRead {
            successus = false,
            bytes = ||,
            message = "short range read"
        }
    }
    return manifestum.SourceRead {successus = true, bytes = bytes, message = ""}
}

fn _prefix_range(list<int> prefix, int initium, int longitudo) → manifestum.SourceRead {
    if initium < 0 or longitudo < 0 or initium > prefix.length() - longitudo {
        return manifestum.SourceRead {
            successus = false,
            bytes = ||,
            message = "inspection attempted to read the tensor data region"
        }
    }
    const list<int> segmentum ← prefix.slice(initium, initium + longitudo)
    const bytes bytes ← segmentum ↦ bytes
    return manifestum.SourceRead {successus = true, bytes = bytes, message = ""}
}

fn _ends(string s, string tail) → bool {
    if tail.length() ≻ s.length() then return false
    return s.slice(s.length() - tail.length(), s.length()) ≡ tail
}

fn _slot(string nomen) → int {
    if _ends(nomen, ".input_layernorm") then return 0
    if _ends(nomen, ".self_attn.q_proj") then return 1
    if _ends(nomen, ".self_attn.k_proj") then return 2
    if _ends(nomen, ".self_attn.v_proj") then return 3
    if _ends(nomen, ".self_attn.o_proj") then return 4
    if _ends(nomen, ".post_attention_layernorm") then return 5
    if _ends(nomen, ".mlp.gate_proj") then return 6
    if _ends(nomen, ".mlp.up_proj") then return 7
    if _ends(nomen, ".mlp.down_proj") then return 8
    return -1
}

fn _ids_text(list<int> ids) → string {
    var string out ← "["
    var int i ← 0
    while i ≺ ids.length() {
        if i ≻ 0 {
            out ← out + ", "
        }
        out ← out + ((ids.get(i) coalesce 0) ↦ string)
        i ← i + 1
    }
    return out + "]"
}

fn _ids_eq(list<int> a, list<int> b) → bool {
    if a.length() ≠ b.length() then return false
    var int i ← 0
    while i ≺ a.length() {
        if (a.get(i) coalesce -1) ≠ (b.get(i) coalesce -2) then return false
        i ← i + 1
    }
    return true
}

fn _block_elements(tensor_view.TensorView v) → int {
    match v.layout {
        case manifestum.Cognita const elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
            return elementa_per_blockum
        }
        case manifestum.Ignota const typo {
            return 0
        }
    }
}

fn _window(int remaining, int block) → int {
    if remaining ≤ SLICE_CAP then return remaining
    const int aligned ← (SLICE_CAP / block) * block
    if aligned ≺ block then return block
    return aligned
}

fn _limits(manifestum.GgufManifest m, string gguf_name) → tuple<int, int> ⇥ PrefillError {
    do {
        return manifestum.limes_payloadis(m, gguf_name)
    }
    catch err {
        throw variant ManifestumMala {message = "payload range failed for " + gguf_name + ": " + manifestum.message(err)}
    }
}

fn _bind(manifestum.GgufManifest m, tensor_payload.TensorPayload p) → tensor_view.TensorView ⇥ PrefillError {
    do {
        return tensor_view.links(m, p)
    }
    catch err {
        throw variant VinculumMala {message = "view bind failed for " + p.name + ": " + tensor_view.message(err)}
    }
}

fn _slice(
    tensor_view.TensorView v,
    int off,
    int n,
    (int, int) → manifestum.SourceRead fons
) → list<f32> ⇥ PrefillError {
    do {
        return tensor_view.materialize_slice(v, off, n, fons)
    }
    catch err {
        throw variant SlicemMala {message = "window materialize failed for " + v.name + ": " + tensor_view.message(err)}
    }
}

fn _tensor(list<f32> datos, list<int> forma) → tensor.Tensor ⇥ PrefillError {
    do {
        return tensor.construct(datos, forma)
    }
    catch err {
        throw variant SlicemMala {message = "tensor construct failed: " + tensor.message(err)}
    }
}

fn _materialize(
    string via,
    int total,
    manifestum.GgufManifest m,
    string gguf_name
) → tensor.Tensor ⇥ PrefillError {
    const tuple<int, int> limes ← _limits(m, gguf_name)
    const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
        name = gguf_name,
        absolute_start = limes[0],
        length = limes[1],
        bytes = ||
    }
    const tensor_view.TensorView v ← _bind(m, p)
    const int block ← _block_elements(v)
    if block ≺ 1 {
        throw variant SlicemMala {message = "tensor layout has no block size: " + gguf_name}
    }
    var list<f32> datos ← vacua
    var int off ← 0
    while off ≺ v.elements {
        const int n ← _window(v.elements - off, block)
        const list<f32> part ← _slice(
            v,
            off,
            n,
            (int initium, int longitudo) → manifestum.SourceRead ∴ _range(via, total, initium, longitudo)
        )
        for from part const x {
            datos.append(x)
        }
        off ← off + n
    }
    return _tensor(datos, v.shape)
}

fn _gguf_name(string family, int stratum) → string ⇥ PrefillError {
    if family ≡ "model.embed_tokens" then return "token_embd.weight"
    if family ≡ "model.norm" then return "output_norm.weight"
    if family ≡ "lm_head" then return "token_embd.weight"
    if stratum ≺ 0 or stratum ≥ 32 {
        throw variant AdapterMala {message = "layer index outside the frozen llama layer range: " + (stratum ↦ string)}
    }
    if family ≡ "model.layers.input_layernorm" then return ("blk." + (stratum ↦ string)) + ".attn_norm.weight"
    if family ≡ "model.layers.self_attn.q_proj" then return ("blk." + (stratum ↦ string)) + ".attn_q.weight"
    if family ≡ "model.layers.self_attn.k_proj" then return ("blk." + (stratum ↦ string)) + ".attn_k.weight"
    if family ≡ "model.layers.self_attn.v_proj" then return ("blk." + (stratum ↦ string)) + ".attn_v.weight"
    if family ≡ "model.layers.self_attn.o_proj" then return ("blk." + (stratum ↦ string)) + ".attn_output.weight"
    if family ≡ "model.layers.post_attention_layernorm" then return ("blk." + (stratum ↦ string)) + ".ffn_norm.weight"
    if family ≡ "model.layers.mlp.gate_proj" then return ("blk." + (stratum ↦ string)) + ".ffn_gate.weight"
    if family ≡ "model.layers.mlp.up_proj" then return ("blk." + (stratum ↦ string)) + ".ffn_up.weight"
    if family ≡ "model.layers.mlp.down_proj" then return ("blk." + (stratum ↦ string)) + ".ffn_down.weight"
    throw variant AdapterMala {message = "unknown canonical tensor name: " + family}
}

fn _load_one(
    string via,
    int total,
    manifestum.GgufManifest m,
    string family,
    int stratum
) → tensor.Tensor ⇥ PrefillError {
    const string gguf_name ← _gguf_name(family, stratum)
    return _materialize(via, total, m, gguf_name)
}

fn _lookup(
    string nomen,
    int stratum,
    tensor.Tensor embed,
    tensor.Tensor norm_s,
    list<list<tensor.Tensor>> strata
) → dense.Lookup {
    if nomen ≡ "model.embed_tokens" then return dense.Lookup {successus = true, tensorem = embed, message = ""}
    if nomen ≡ "model.norm" then return dense.Lookup {successus = true, tensorem = norm_s, message = ""}
    if stratum ≺ 0 or stratum ≥ strata.length() {
        return dense.Lookup {successus = false, tensorem = embed, message = "layer out of range: " + (stratum ↦ string)}
    }
    const int slot ← _slot(nomen)
    if slot ≺ 0 {
        return dense.Lookup {successus = false, tensorem = embed, message = "unknown canonical tensor: " + nomen}
    }
    var list<tensor.Tensor> missing ← vacua
    const list<tensor.Tensor> row ← strata.get(stratum) coalesce missing
    if slot ≥ row.length() {
        return dense.Lookup {successus = false, tensorem = embed, message = "layer slot missing: " + nomen}
    }
    const tensor.Tensor t ← row.get(slot) coalesce embed
    return dense.Lookup {successus = true, tensorem = t, message = ""}
}

fn _logit(tensor.Tensor logits, int pos, int tok) → f32 {
    do {
        return logits.get([pos, tok])
    }
    catch err {
        return 0.0 ∷ f32
    }
}

fn _top1(tensor.Tensor logits, int pos) → int {
    var int best ← 1
    var f32 best_v ← _logit(logits, pos, 1)
    var int i ← 3
    while i ≺ VOCAB {
        const f32 v ← _logit(logits, pos, i)
        if v ≻ best_v {
            best ← i
            best_v ← v
        }
        i ← i + 1
    }
    return best
}

fn _put_int(list<int> xs, int idx, int val) → list<int> {
    var list<int> out ← vacua
    var int i ← 0
    while i ≺ xs.length() {
        if i ≡ idx {
            out.append(val)
        }
        else {
            out.append(xs.get(i) coalesce 0)
        }
        i ← i + 1
    }
    return out
}

fn _put_f32(list<f32> xs, int idx, f32 val) → list<f32> {
    var list<f32> out ← vacua
    var int i ← 0
    while i ≺ xs.length() {
        if i ≡ idx {
            out.append(val)
        }
        else {
            out.append(xs.get(i) coalesce 0.0 ∷ f32)
        }
        i ← i + 1
    }
    return out
}

fn _top5(tensor.Tensor logits, int pos) → list<int> {
    var list<int> ids ← [0, 0, 0, 0, 0]
    var list<f32> vals ← [0.0 - 1000000.0 ∷ f32, 0.0 - 1000000.0 ∷ f32, 0.0 - 1000000.0 ∷ f32, 0.0 - 1000000.0 ∷ f32, 0.0 - 1000000.0 ∷ f32]
    var int i ← 0
    while i ≺ VOCAB {
        const f32 v ← _logit(logits, pos, i)
        if v ≻ (vals.get(4) coalesce (0.0 - 1000000.0 ∷ f32)) {
            var int j ← 4
            while j ≻ 0 {
                const f32 prev ← vals.get(j - 1) coalesce (0.0 - 1000000.0 ∷ f32)
                if v ≻ prev {
                    vals ← _put_f32(vals, j, prev)
                    ids ← _put_int(ids, j, ids.get(j - 1) coalesce 0)
                    j ← j - 1
                }
                else {
                    break
                }
            }
            vals ← _put_f32(vals, j, v)
            ids ← _put_int(ids, j, i)
        }
        i ← i + 1
    }
    return ids
}

fn _overlap5(list<int> observed, list<int> golden) → int {
    var int n ← 0
    var int i ← 0
    while i ≺ observed.length() {
        const int a ← observed.get(i) coalesce -1
        var int j ← 0
        while j ≺ golden.length() {
            if a ≡ (golden.get(j) coalesce -2) {
                n ← n + 1
                break
            }
            j ← j + 1
        }
        i ← i + 1
    }
    return n
}

fn _all_finite(tensor.Tensor logits, int pos) → bool {
    var int i ← 0
    while i ≺ VOCAB {
        if not dtype.finite(_logit(logits, pos, i)) then return false
        i ← i + 1
    }
    return true
}

fn _max_delta(tensor.Tensor logits, int pos, list<f32> golden) → f32 {
    var f32 maxd ← 0.0 ∷ f32
    var int i ← 0
    while i ≺ VOCAB {
        const f32 a ← _logit(logits, pos, i)
        const f32 b ← golden.get(i) coalesce 0.0 ∷ f32
        var f32 d ← a - b
        if d ≺ 0.0 {
            d ← 0.0 - d
        }
        if d ≻ maxd {
            maxd ← d
        }
        i ← i + 1
    }
    return maxd
}

fn _load_golden(string via) → list<f32> ⇥ PrefillError {
    if not solum.exists(via) {
        throw variant ArgumentaMala {message = "golden file missing: " + via}
    }
    const list<string> lines ← solum.read_lines(via)
    if lines.length() ≠ VOCAB {
        throw variant ArgumentaMala {message = "golden line count is not 49152: " + (lines.length() ↦ string)}
    }
    var list<f32> out ← vacua
    var int i ← 0
    while i ≺ VOCAB {
        do {
            out.append((lines.get(i) coalesce "0") ↦ f32)
        }
        catch err {
            throw variant ArgumentaMala {message = "golden float parse failed at " + (i ↦ string)}
        }
        i ← i + 1
    }
    return out
}

main {
    const list<string> args ← processus.argv() ↦ list<string>
    var string via ← PINNED_PATH
    var int data_expectata ← PINNED_DATA
    var string digestio ← PINNED_DIGEST
    var string golden_via ← ""
    if args.length() ≥ 3 {
        via ← args.get(0) coalesce PINNED_PATH
        do {
            data_expectata ← (args.get(1) coalesce "0") ↦ int
            digestio ← args.get(2) coalesce PINNED_DIGEST
        }
        catch err {
            panic "usage: dense-prefill-smollm2 <path> <data-offset> <sha256> [golden-pos0.txt]"
        }
    }
    if args.length() ≥ 4 {
        golden_via ← args.get(3) coalesce ""
    }

    print "policy: gi0-numeric-contract v1.0.0 + faber-prefill-oracle compare_gpu_logits (prompt-end / position 0)"
    print "engine: compiled rust (faber build --target rust; execute the printed binary)"
    print "backend: CPU/reference"
    print "model.path=" + via
    print "model.digest=" + digestio

    const int total ← solum.byte_length(via)
    print "model.bytes=" + (total ↦ string)
    if total ≠ PINNED_BYTES {
        panic "model byte length mismatch: observed=" + (total ↦ string) + " expected=" + (PINNED_BYTES ↦ string)
    }

    const bytes prefix_bytes ← solum.read_range(via, 0, data_expectata)
    if prefix_bytes.length() ≠ data_expectata {
        panic "file adapter returned a short table-prefix read"
    }
    const value prefix_valor ← prefix_bytes ↦ value
    const list<int> prefix ← prefix_valor ↦ list<int>
    const artifact.ContentIdentity identitas ← artifact.ContentIdentity {
        algorithm = "sha-256",
        digest = digestio,
        length = total
    }

    var manifestum.GgufManifest admitted ← manifestum.GgufManifest {
        identitas = identitas,
        version = 0,
        concordatio = 0,
        data_inceptum = 0,
        artifact_length = 0,
        metadata = vacua,
        tensors = vacua
    }
    do {
        admitted ← manifestum.inspect(
            (int initium, int longitudo) → manifestum.SourceRead ∴ _prefix_range(prefix, initium, longitudo),
            total,
            identitas
        )
    }
    catch err {
        panic "manifest admission failed: " + manifestum.message(err)
    }
    var string architectura ← ""
    do {
        architectura ← manifestum.textum(admitted, "general.architecture")
    }
    catch err {
        panic "architecture fact read failed: " + manifestum.message(err)
    }
    print "admit: PASS version=" + (admitted.version ↦ string)
        + " data=" + (admitted.data_inceptum ↦ string)
        + " tensors=" + (admitted.tensors.length() ↦ string)
        + " architecture=" + architectura

    var list<int> tokens ← PINNED_TOKENS
    var string tokenizer_row ← "tokenizer: SKIPPED (using pinned fixture ids)"
    do {
        const tokenizator.Tokenizer tok ← tokenizator.build(admitted)
        const list<int> encoded ← tokenizator.encode_prompt(tok, PINNED_PROMPT)
        if _ids_eq(encoded, PINNED_TOKENS) {
            tokens ← encoded
            tokenizer_row ← "tokenizer: PASS ids=" + _ids_text(encoded)
        }
        else {
            tokenizer_row ← "tokenizer: DIVERGED observed=" + _ids_text(encoded) + " pinned=" + _ids_text(PINNED_TOKENS)
            tokens ← PINNED_TOKENS
        }
    }
    catch err {
        tokenizer_row ← "tokenizer: FAIL " + tokenizator.message(err)
        tokens ← PINNED_TOKENS
    }
    print tokenizer_row
    print "prompt_tokens=" + _ids_text(tokens)

    print "loading stored-weight views..."
    var tensor.Tensor embed ← tensor.default()
    var tensor.Tensor norm_s ← tensor.default()
    do {
        embed ← _load_one(via, total, admitted, "model.embed_tokens", 0)
        norm_s ← _load_one(via, total, admitted, "model.norm", 0)
    }
    catch err {
        panic message(err)
    }
    print "loaded embed+norm"

    const list<string> families ← [
        "model.layers.input_layernorm",
        "model.layers.self_attn.q_proj",
        "model.layers.self_attn.k_proj",
        "model.layers.self_attn.v_proj",
        "model.layers.self_attn.o_proj",
        "model.layers.post_attention_layernorm",
        "model.layers.mlp.gate_proj",
        "model.layers.mlp.up_proj",
        "model.layers.mlp.down_proj"
    ]
    var list<list<tensor.Tensor>> strata ← vacua
    var int stratum ← 0
    while stratum ≺ 32 {
        var list<tensor.Tensor> row ← vacua
        var int f ← 0
        while f ≺ families.length() {
            do {
                row.append(_load_one(via, total, admitted, families.get(f) coalesce "", stratum))
            }
            catch err {
                panic ("layer " + (stratum ↦ string)) + " " + message(err)
            }
            f ← f + 1
        }
        strata.append(row)
        print "loaded layer " + (stratum ↦ string)
        stratum ← stratum + 1
    }

    var attention.RopeConfig rope ← attention.default()
    do {
        rope ← attention.construct_rope_config(100000.0 ∷ f32, 1.0 ∷ f32, attention.consecutive_policy())
    }
    catch err {
        panic "rope config failed: " + attention.message(err)
    }

    var list<int> positions ← vacua
    var int p ← 0
    while p ≺ tokens.length() {
        positions.append(p)
        p ← p + 1
    }

    const dense.DenseConfig cfg ← dense.DenseConfig {
        layers = 32,
        heads = 15,
        kv_heads = 5,
        head_dim = 64,
        hidden_dim = 960,
        vocab = 49152,
        tied = true
    }

    print "forward start T=" + (tokens.length() ↦ string)
    var tensor.Tensor logits ← tensor.default()
    do {
        logits ← dense.forward(
            cfg,
            (string n, int s) → dense.Lookup ∴ _lookup(n, s, embed, norm_s, strata),
            tokens,
            0.00001 ∷ f32,
            0.125 ∷ f32,
            positions,
            64,
            rope
        )
    }
    catch err {
        panic "forward failed: " + dense.message(err)
    }
    print "forward done shape=[" + ((logits.shape().get(0) coalesce 0) ↦ string) + "," + ((logits.shape().get(1) coalesce 0) ↦ string) + "]"

    const int pos ← tokens.length() - 1
    const int top1 ← _top1(logits, pos)
    const list<int> top5 ← _top5(logits, pos)
    const bool finite ← _all_finite(logits, pos)
    const bool top1_ok ← top1 ≡ GOLDEN_TOP1
    const int overlap ← _overlap5(top5, GOLDEN_TOP5)
    const bool top5_ok ← overlap ≥ 4

    print "position=0 (prompt end, last prefill row " + (pos ↦ string) + ")"
    print "observed_top1_non_eog=" + (top1 ↦ string)
    print "golden_top1_non_eog=" + (GOLDEN_TOP1 ↦ string)
    print "top1_matches=" + (top1_ok ↦ string)
    print "observed_top5=" + _ids_text(top5)
    print "golden_top5=" + _ids_text(GOLDEN_TOP5)
    print "top5_overlap=" + (overlap ↦ string) + "/5"
    print "all_finite=" + (finite ↦ string)

    var bool band_ok ← true
    var string band_row ← "band: not_compared (no golden file)"
    if golden_via.length() ≻ 0 {
        do {
            const list<f32> golden ← _load_golden(golden_via)
            const f32 maxd ← _max_delta(logits, pos, golden)
            band_ok ← maxd ≤ BAND_Q2
            band_row ← (("band max_delta=" + (maxd ↦ string)) + " envelope=") + (BAND_Q2 ↦ string) + " ok=" + (band_ok ↦ string)
        }
        catch err {
            band_ok ← false
            band_row ← "band: FAIL " + message(err)
        }
    }
    print band_row

    var string divergence ← "none"
    if not finite {
        divergence ← "position 0: finite gate failed"
    }
    else {
        if not top1_ok {
            divergence ← (("position 0: top-1 " + (top1 ↦ string)) + " vs golden ") + (GOLDEN_TOP1 ↦ string)
        }
        else {
            if not top5_ok {
                divergence ← "position 0: top-5 overlap " + (overlap ↦ string) + "/5"
            }
            else {
                if golden_via.length() ≻ 0 and not band_ok {
                    divergence ← "position 0: band"
                }
            }
        }
    }
    print "first_divergence=" + divergence

    if divergence ≡ "none" {
        print "PREFILL: PASS"
    }
    else {
        print "PREFILL: FAIL"
    }
}
