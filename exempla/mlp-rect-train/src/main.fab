+++
locale = "en"
+++
import from "gradus:mlp" mlp
import from "gradus:optimize" optimize

main {
    mut tensor<f32, [2, 3]> x ← tf32[2, 3] {}
    mut tensor<f32, [2, 2]> target ← tf32[2, 2] {}
    mut tensor<f32, [3, 5]> w1 ← tf32[3, 5] {}
    mut tensor<f32, [2, 5]> b1 ← tf32[2, 5] {}
    mut tensor<f32, [5, 2]> w2 ← tf32[5, 2] {}
    mut tensor<f32, [2, 2]> b2 ← tf32[2, 2] {}
    x[[0, 0]] ← 1.0
    x[[0, 1]] ← 0.0
    x[[0, 2]] ← -1.0
    x[[1, 0]] ← 0.0
    x[[1, 1]] ← 1.0
    x[[1, 2]] ← 1.0
    target[[0, 0]] ← 1.0
    target[[0, 1]] ← -1.0
    target[[1, 0]] ← 0.5
    target[[1, 1]] ← 0.5
    w1[[0, 0]] ← 0.1
    w1[[0, 1]] ← 0.0
    w1[[0, 2]] ← -0.1
    w1[[0, 3]] ← 0.2
    w1[[0, 4]] ← 0.0
    w1[[1, 0]] ← 0.0
    w1[[1, 1]] ← 0.1
    w1[[1, 2]] ← 0.0
    w1[[1, 3]] ← -0.1
    w1[[1, 4]] ← 0.1
    w1[[2, 0]] ← -0.1
    w1[[2, 1]] ← 0.0
    w1[[2, 2]] ← 0.1
    w1[[2, 3]] ← 0.0
    w1[[2, 4]] ← 0.2
    b1[[0, 0]] ← 0.0
    b1[[0, 1]] ← 0.0
    b1[[0, 2]] ← 0.0
    b1[[0, 3]] ← 0.0
    b1[[0, 4]] ← 0.0
    b1[[1, 0]] ← 0.0
    b1[[1, 1]] ← 0.0
    b1[[1, 2]] ← 0.0
    b1[[1, 3]] ← 0.0
    b1[[1, 4]] ← 0.0
    w2[[0, 0]] ← 0.1
    w2[[0, 1]] ← -0.1
    w2[[1, 0]] ← 0.0
    w2[[1, 1]] ← 0.1
    w2[[2, 0]] ← -0.1
    w2[[2, 1]] ← 0.0
    w2[[3, 0]] ← 0.2
    w2[[3, 1]] ← 0.0
    w2[[4, 0]] ← 0.1
    w2[[4, 1]] ← -0.1
    b2[[0, 0]] ← 0.0
    b2[[0, 1]] ← 0.0
    b2[[1, 0]] ← 0.0
    b2[[1, 1]] ← 0.0
    let f32 upstream ← 1.0
    for range 0‥10 let step {
        let f32 loss ← mlp.forward_mlp_loss(x, w1, b1, w2, b2, target)
        print "mlp-rect loss[§0]=§1"(step, loss)
        let _ grads ← mlp.forward_mlp_loss_backward(x, w1, b1, w2, b2, target, mlp.nil(), upstream)
        let [_, gw1, gb1, gw2, gb2, _] ← grads
        let list<tensor<f32, [3, 5]>> u1 ← optimize.sgd_step([w1], [gw1], 0.1)
        let list<tensor<f32, [2, 5]>> ub1 ← optimize.sgd_step([b1], [gb1], 0.1)
        let list<tensor<f32, [5, 2]>> u2 ← optimize.sgd_step([w2], [gw2], 0.1)
        let list<tensor<f32, [2, 2]>> ub2 ← optimize.sgd_step([b2], [gb2], 0.1)
        w1 ← u1[0]
        b1 ← ub1[0]
        w2 ← u2[0]
        b2 ← ub2[0]
    }
    let tensor<f32, [2, 2]> inferred ← mlp.forward_mlp(x, w1, b1, w2, b2)
    let f32 loss ← mlp.forward_mlp_loss(x, w1, b1, w2, b2, target)
    let f32 recomputed ← ((inferred - target) ⊙ (inferred - target)).mean()
    print "mlp-rect agree=§0"(loss ≡ recomputed)
}
