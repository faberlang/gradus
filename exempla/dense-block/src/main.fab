+++
locale = "en"
+++
# dense-block — the REF-01-U1.5 executed proof. The generic dense
# transformer block in gradus:transformer: input RMSNorm -> GQA attention
# (causal + RoPE) -> residual -> post-attn RMSNorm -> SwiGLU MLP -> residual,
# over the staged f32 carrier, composing the U1.1 (rmsnorm), U1.2 (swiglu),
# and U1.4 (multi_head_attention) rows; no fixed-shape constants.
#
# One pinned config row: T=2, D=16, F=16 (hidden), num_heads=4, num_kv_heads=2,
# head_dim=4, positions [0,1], rope_dim 4, consecutive-pair (llama NORM)
# freq_base 100000, scale 1.0, RMSNorm epsilon 1e-5. The pinned values are the
# independent f64 evaluation of the documented block formulas (external
# Python/numpy, the PML3 transformer_block pin precedent), compared within the
# documented 5e-4 absolute tolerance. The same config and reference values live
# at compile level in src/transformer.proba.
#
# Execution: faber run --target fmir exempla/dense-block. Prints PASS for
# every pinned value (0 FAIL, exit 0). No device handle, no performance
# claim; forward-only, no autograd import.
import from "gradus:transformer" transformer

import from "gradus:attention" attention

import from "gradus:tensor" tensor

import from "gradus:dtype" dtype

# Absolute tolerance for f32-vs-f64 comparison (the proba posture).
const f32 TOLERATIO ← 0.0005 ∷ f32

# Build a staged tensor (test data is always valid; the cape fallback is
# unreachable).
fn tene(list<f32> datos, list<int> forma) → tensor.Tensor {
    var tensor.Tensor t
    do {
        t ← tensor.structa(datos, forma)
    }
    catch err {
        return t
    }
    return t
}

# Staged-result element read (swallow the never-firing access errors).
fn e2(tensor.Tensor r, int i, int j) → f32 {
    do {
        return r.accipe([i, j])
    }
    catch err {
        return 0.0 ∷ f32
    }
}

# The row result (swallow the never-firing construction errors).
fn block_p(tensor.Tensor x, tensor.Tensor ln1_s, f32 eps, tensor.Tensor wq, tensor.Tensor bq, tensor.Tensor wk, tensor.Tensor bk, tensor.Tensor wv, tensor.Tensor bv, tensor.Tensor wo, int num_heads, int num_kv_heads, f32 scale, list<int> positions, int rope_dim, attention.RopeConfigura cfg, tensor.Tensor ln2_s, tensor.Tensor wg, tensor.Tensor bg, tensor.Tensor wu, tensor.Tensor bu, tensor.Tensor wd, tensor.Tensor bd) → tensor.Tensor {
    var tensor.Tensor r
    do {
        r ← transformer.dense_block(x, ln1_s, eps, wq, bq, wk, bk, wv, bv, wo, num_heads, num_kv_heads, scale, positions, rope_dim, cfg, ln2_s, wg, bg, wu, bu, wd, bd)
        return r
    }
    catch err {
        return r
    }
    return r
}

# Validated RopeConfigura (swallow the never-firing construction errors).
fn config_p(f32 base, f32 scale, attention.RopePolitica politica) → attention.RopeConfigura {
    var attention.RopeConfigura c
    do {
        c ← attention.structa_rope_configura(base, scale, politica)
        return c
    }
    catch err {
        return c
    }
    return c
}

# One pinned element: name + observed vs the f64 reference within TOLERATIO.
# Prints "PASS" or "FAIL" (the run's executed oracle rows).
fn _pin(string name, f32 observata, f32 expectata) → string {
    if (observata - expectata).abs() ≤ TOLERATIO then return name + ": PASS"
    return (((name + ": FAIL observed=") + observata ∷ string) + " expected=") + expectata ∷ string
}

