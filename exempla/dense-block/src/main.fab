# dense-block — the REF-01-U1.5 executed proof. The generic dense transformer
# block in gradus:transformer: input RMSNorm → GQA attention (causal + RoPE) →
# residual → post-attn RMSNorm → SwiGLU MLP → residual, over the staged f32
# carrier, composing the U1.1 (rmsnorm), U1.2 (swiglu), and U1.4
# (multi_head_attention) rows; no fixed-shape constants.
#
# One pinned config row: T=2, D=16, F=16 (hidden), num_heads=4, num_kv_heads=2,
# head_dim=4, positions [0,1], rope_dim 4, consecutive-pair (llama NORM)
# freq_base 100000, scale 1.0, RMSNorm epsilon 1e-5. The pinned values are the
# independent f64 evaluation of the documented block formulas (external
# Python/numpy, the PML3 transformer_block pin precedent) with the corrected
# U1.4 O-projection (concat · wo, [K,N] row-major — do not transpose) and
# residual-2 r1 + h (not ln2 + h). No GI2-2 golden exists for this synthetic
# draw. Compared within the documented 5e-4 absolute tolerance. The same
# config and reference values live at compile level in src/transformer.proba.
#
# Execution: faber run --target fmir exempla/dense-block. Prints PASS for
# every pinned value (0 FAIL, exit 0). No device handle, no performance
# claim; forward-only, no autograd import.
import from "gradus:transformer" transformer

import from "gradus:attention/rope" rope

import from "gradus:tensor" tensor

import from "gradus:dtype" dtype

# Absolute tolerance for f32-vs-f64 comparison (the proba posture).
const f32 TOLERANCE ← 0.0005

# Build a staged tensor (test data is always valid; the cape fallback is
# unreachable).
fn staged_block(list<f32> data, list<int> shape) → tensor.NumericBlock {
    var tensor.NumericBlock t ← tensor.default()
    do {
        t ← tensor.construct(data, shape)
    }
    catch err {
        return t
    }
    return t
}

# Staged-result element read (swallow the never-firing access errors).
fn element(tensor.NumericBlock r, int i, int j) → f32 {
    do {
        return r.get([i, j])
    }
    catch err {
        return 0.0
    }
}

# The pinned block result (swallow the never-firing construction errors).
fn pinned_block(tensor.NumericBlock x, list<int> positions, transformer.DenseAttentionWeights attention_weights, transformer.DenseAttentionConfig attention_config, transformer.DenseMlpWeights mlp_weights, transformer.DenseNormConfig norm_config) → tensor.NumericBlock {
    var tensor.NumericBlock r ← tensor.default()
    do {
        r ← transformer.dense_block(x, positions, attention_weights, attention_config, mlp_weights, norm_config)
    }
    catch err {
        return r
    }
    return r
}

# Validated RopeConfig (swallow the never-firing construction errors).
fn pinned_rope_config(f32 freq_base, f32 scale, rope.RopePolicy policy) → rope.RopeConfig {
    var rope.RopeConfig c ← rope.default()
    do {
        c ← rope.construct_rope_config(freq_base, scale, policy)
    }
    catch err {
        return c
    }
    return c
}

# One pinned element: name + observed vs the f64 reference within TOLERANCE.
# Prints "PASS" or "FAIL" (the run's executed oracle rows).
fn pin_row(string name, f32 observed, f32 expected) → string {
    if (observed - expected).abs() ≤ TOLERANCE then return name + ": PASS"
    return "§: FAIL observed=§ expected=§"(name, observed, expected)
}

