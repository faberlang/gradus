+++
locale = "la"
+++
# MODEL-01-M7: guarded real-file qwen35moe admission exemplar.
#
# Application-owned adapter (GGUF-A1b range-source pattern): resolves the
# operator model path, measures the artifact, reads the independently bounded
# manifest prefix once (the first `data_expectata` bytes; never a tensor-
# payload byte), calls `gradus:model/qwen35moe` admission, and prints the
# ADMIT receipt: the frozen configuration + the 753-tensor receipt (block
# schedule + storage distribution). The adapter owns the path and I/O; Gradus
# receives only the bounded corpus, the expected digest, and the expected
# artifact length.

importa ex "gradus:model/artifact" artifact
importa ex "gradus:model/gguf_manifest" manifestum
importa ex "gradus:model/qwen35moe" qwen35moe
importa ex "norma:processus" processus
importa ex "norma:solum" solum

# Render the frozen rope sections list as `[11,11,10,0]`.
functio _sections(lista<numerus> xs) → textus {
    varia textus out ← "["
    varia numerus i ← 0
    dum i < xs.longitudo() {
        si i > 0 { out ← out + "," }
        out ← out + ((xs.accipe(i) vel 0) ↦ textus)
        i ↑
    }
    redde out + "]"
}

incipit {
    fixum lista<textus> args ← processus.argumenta() ↦ lista<textus>
    si args.longitudo() ≠ 3 {
        mori "usage: gguf-admit-qwen35moe <path> <expected-data-offset> <sha256>"
    }
    fixum textus via ← args.accipe(0) vel ""
    fixum numerus data_expectata ← (args.accipe(1) vel "0") ↦ numerus
    fixum textus digestio ← args.accipe(2) vel ""
    fixum numerus total ← solum.mensura(via)
    fixum octeti prefix_bytes ← solum.partem(via, 0, data_expectata)
    si prefix_bytes.longitudo() ≠ data_expectata {
        mori "file adapter returned a short table-prefix read"
    }
    fixum artifact.IdentitasContenuti identitas ← artifact.IdentitasContenuti {
        algorithmus = "sha-256",
        digestio = digestio,
        longitudo = total
    }
    fixum manifestum.CorpusGguf corpus ← manifestum.CorpusGguf {
        tabula = prefix_bytes,
        longitudo_artifacti = total,
        identitas = identitas
    }
    fac {
        fixum qwen35moe.AdmissioQwen35moe admissio ← qwen35moe.admitto(corpus, digestio, total)
        fixum qwen35moe.ConfiguratioQwen35moe c ← admissio.configuratio
        fixum qwen35moe.SummaTensoriorumQwen s ← admissio.summa
        nota "ADMIT qwen35moe"
        nota "CONFIG general.architecture=" + c.architectura
        nota "CONFIG general.file_type=" + (c.typus_limaturae ↦ textus)
        nota "CONFIG general.quantization_version=" + (c.versio_quantificationis ↦ textus)
        nota "CONFIG qwen35moe.block_count=" + (c.numerus_tractuum ↦ textus)
        nota "CONFIG qwen35moe.context_length=" + (c.longitudo_contextus ↦ textus)
        nota "CONFIG qwen35moe.embedding_length=" + (c.longitudo_vestimenti ↦ textus)
        nota "CONFIG qwen35moe.attention.head_count=" + (c.numerus_capita ↦ textus)
        nota "CONFIG qwen35moe.attention.head_count_kv=" + (c.numerus_capita_kv ↦ textus)
        nota "CONFIG qwen35moe.attention.key_length=" + (c.longitudo_clavis ↦ textus)
        nota "CONFIG qwen35moe.attention.value_length=" + (c.longitudo_valoris ↦ textus)
        nota "CONFIG qwen35moe.attention.layer_norm_rms_epsilon=" + (c.epsilon_normae_rms ↦ textus)
        nota "CONFIG qwen35moe.rope.freq_base=" + (c.basis_frequentiae ↦ textus)
        nota "CONFIG qwen35moe.rope.dimension_count=" + (c.numerus_dimensionum_rotae ↦ textus)
        nota "CONFIG qwen35moe.rope.dimension_sections=" + _sections(c.sectiones_rotae)
        nota "CONFIG qwen35moe.expert_count=" + (c.numerus_expertorum ↦ textus)
        nota "CONFIG qwen35moe.expert_used_count=" + (c.numerus_expertorum_activorum ↦ textus)
        nota "CONFIG qwen35moe.expert_feed_forward_length=" + (c.longitudo_ffn_experti ↦ textus)
        nota "CONFIG qwen35moe.expert_shared_feed_forward_length=" + (c.longitudo_ffn_communi ↦ textus)
        nota "CONFIG qwen35moe.ssm.conv_kernel=" + (c.nucleus_convolutus ↦ textus)
        nota "CONFIG qwen35moe.ssm.state_size=" + (c.magnitudo_status ↦ textus)
        nota "CONFIG qwen35moe.ssm.group_count=" + (c.numerus_coetuum ↦ textus)
        nota "CONFIG qwen35moe.ssm.time_step_rank=" + (c.gradus_temporis ↦ textus)
        nota "CONFIG qwen35moe.ssm.inner_size=" + (c.magnitudo_interior ↦ textus)
        nota "CONFIG qwen35moe.full_attention_interval=" + (c.intervallum_attentionis_plenae ↦ textus)
        nota "CONFIG qwen35moe.nextn_predict_layers=" + (c.numerus_strata_nextn ↦ textus)
        nota "CONFIG tokenizer.ggml.model=" + c.exemplum_tokenizoris
        nota "CONFIG tokenizer.ggml.pre=" + c.praeparatio_tokenizoris
        nota "CONFIG tokenizer.ggml.tokens=" + (c.numerus_tokenum ↦ textus)
        nota "CONFIG tokenizer.ggml.token_type=" + (c.numerus_typorum_tokenum ↦ textus)
        nota "CONFIG tokenizer.ggml.merges=" + (c.numerus_concatenationum ↦ textus)
        nota "CONFIG tokenizer.ggml.eos_token_id=" + (c.eos_token_id ↦ textus)
        nota "CONFIG tokenizer.ggml.padding_token_id=" + (c.padding_token_id ↦ textus)
        nota "CONFIG tokenizer.ggml.bos_token_id=" + (c.bos_token_id ↦ textus)
        nota "CONFIG tokenizer.ggml.add_bos_token=" + (c.add_bos_token ↦ textus)
        nota "TENSORS total=" + (s.totalis ↦ textus)
        nota "BLOCK hybrid=" + (s.hybridorum ↦ textus)
            + " full_attention=" + (s.attentionis_plenae ↦ textus)
            + " nextn=" + (s.nextn ↦ textus)
            + " global=" + (s.globalium ↦ textus)
        nota "STORAGE f32=" + (s.stipula_f32 ↦ textus)
            + " q8_0=" + (s.stipula_q8_0 ↦ textus)
            + " q4_K=" + (s.stipula_q4_k ↦ textus)
            + " q5_K=" + (s.stipula_q5_k ↦ textus)
            + " q6_K=" + (s.stipula_q6_k ↦ textus)
            + " bf16=" + (s.stipula_bf16 ↦ textus)
    }
    cape err {
        mori qwen35moe.causa_admissionis(err)
    }
}
