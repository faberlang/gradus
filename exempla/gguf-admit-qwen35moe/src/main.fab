+++
locale = "en"
+++
# MODEL-01-M7: guarded real-file qwen35moe admission exemplar.
#
# Application-owned adapter (GGUF-A1b range-source pattern): resolves the
# operator model path, measures the artifact, reads the independently bounded
# manifest prefix once (the first `data_expectata` bytes; never a tensor-
# payload byte), calls `gradus:model/qwen35moe` admission, and prints the
# ADMIT receipt: the frozen configuration + the 753-tensor receipt (block
# schedule + storage distribution). The adapter owns the path and I/O; Gradus
# receives only the bounded corpus, the expected digest, and the expected
# artifact length.

import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" manifestum
import from "gradus:model/qwen35moe" qwen35moe
import from "norma:processus" processus
import from "norma:solum" solum

# Render the frozen rope sections list as `[11,11,10,0]`.
fn _sections(list<int> xs) → string {
    var string out ← "["
    var int i ← 0
    while i < xs.length() {
        if i > 0 { out ← out + "," }
        out ← out + ((xs.get(i) coalesce 0) ↦ string)
        i ↑
    }
    return out + "]"
}

main {
    const list<string> args ← processus.argv() ↦ list<string>
    if args.length() ≠ 3 {
        panic "usage: gguf-admit-qwen35moe <path> <expected-data-offset> <sha256>"
    }
    const string via ← args.get(0) coalesce ""
    const int data_expectata ← (args.get(1) coalesce "0") ↦ int
    const string digestio ← args.get(2) coalesce ""
    const int total ← solum.byte_length(via)
    const bytes prefix_bytes ← solum.read_range(via, 0, data_expectata)
    if prefix_bytes.length() ≠ data_expectata {
        panic "file adapter returned a short table-prefix read"
    }
    const artifact.ContentIdentity identitas ← artifact.ContentIdentity {
        algorithm = "sha-256",
        digest = digestio,
        length = total
    }
    const manifestum.GgufCorpus corpus ← manifestum.GgufCorpus {
        tabula = prefix_bytes,
        artifact_length = total,
        identitas = identitas
    }
    do {
        const qwen35moe.Qwen35moeAdmission admissio ← qwen35moe.admit(corpus, digestio, total)
        const qwen35moe.Qwen35moeConfig c ← admissio.config
        const qwen35moe.QwenTensorSummary s ← admissio.summa
        print "ADMIT qwen35moe"
        print "CONFIG general.architecture=" + c.architectura
        print "CONFIG general.file_type=" + (c.typus_limaturae ↦ string)
        print "CONFIG general.quantization_version=" + (c.versio_quantificationis ↦ string)
        print "CONFIG qwen35moe.block_count=" + (c.numerus_tractuum ↦ string)
        print "CONFIG qwen35moe.context_length=" + (c.longitudo_contextus ↦ string)
        print "CONFIG qwen35moe.embedding_length=" + (c.longitudo_vestimenti ↦ string)
        print "CONFIG qwen35moe.attention.head_count=" + (c.numerus_capita ↦ string)
        print "CONFIG qwen35moe.attention.head_count_kv=" + (c.numerus_capita_kv ↦ string)
        print "CONFIG qwen35moe.attention.key_length=" + (c.longitudo_clavis ↦ string)
        print "CONFIG qwen35moe.attention.value_length=" + (c.longitudo_valoris ↦ string)
        print "CONFIG qwen35moe.attention.layer_norm_rms_epsilon=" + (c.epsilon_normae_rms ↦ string)
        print "CONFIG qwen35moe.rope.freq_base=" + (c.basis_frequentiae ↦ string)
        print "CONFIG qwen35moe.rope.dimension_count=" + (c.numerus_dimensionum_rotae ↦ string)
        print "CONFIG qwen35moe.rope.dimension_sections=" + _sections(c.sectiones_rotae)
        print "CONFIG qwen35moe.expert_count=" + (c.numerus_expertorum ↦ string)
        print "CONFIG qwen35moe.expert_used_count=" + (c.numerus_expertorum_activorum ↦ string)
        print "CONFIG qwen35moe.expert_feed_forward_length=" + (c.longitudo_ffn_experti ↦ string)
        print "CONFIG qwen35moe.expert_shared_feed_forward_length=" + (c.longitudo_ffn_communi ↦ string)
        print "CONFIG qwen35moe.ssm.conv_kernel=" + (c.nucleus_convolutus ↦ string)
        print "CONFIG qwen35moe.ssm.state_size=" + (c.magnitudo_status ↦ string)
        print "CONFIG qwen35moe.ssm.group_count=" + (c.numerus_coetuum ↦ string)
        print "CONFIG qwen35moe.ssm.time_step_rank=" + (c.gradus_temporis ↦ string)
        print "CONFIG qwen35moe.ssm.inner_size=" + (c.magnitudo_interior ↦ string)
        print "CONFIG qwen35moe.full_attention_interval=" + (c.intervallum_attentionis_plenae ↦ string)
        print "CONFIG qwen35moe.nextn_predict_layers=" + (c.numerus_strata_nextn ↦ string)
        print "CONFIG tokenizer.ggml.model=" + c.exemplum_tokenizoris
        print "CONFIG tokenizer.ggml.pre=" + c.praeparatio_tokenizoris
        print "CONFIG tokenizer.ggml.tokens=" + (c.numerus_tokenum ↦ string)
        print "CONFIG tokenizer.ggml.token_type=" + (c.numerus_typorum_tokenum ↦ string)
        print "CONFIG tokenizer.ggml.merges=" + (c.numerus_concatenationum ↦ string)
        print "CONFIG tokenizer.ggml.eos_token_id=" + (c.eos_token_id ↦ string)
        print "CONFIG tokenizer.ggml.padding_token_id=" + (c.padding_token_id ↦ string)
        print "CONFIG tokenizer.ggml.bos_token_id=" + (c.bos_token_id ↦ string)
        print "CONFIG tokenizer.ggml.add_bos_token=" + (c.add_bos_token ↦ string)
        print "TENSORS total=" + (s.totalis ↦ string)
        print "BLOCK hybrid=" + (s.hybridorum ↦ string)
            + " full_attention=" + (s.attentionis_plenae ↦ string)
            + " nextn=" + (s.nextn ↦ string)
            + " global=" + (s.globalium ↦ string)
        print "STORAGE f32=" + (s.stipula_f32 ↦ string)
            + " q8_0=" + (s.stipula_q8_0 ↦ string)
            + " q4_K=" + (s.stipula_q4_k ↦ string)
            + " q5_K=" + (s.stipula_q5_k ↦ string)
            + " q6_K=" + (s.stipula_q6_k ↦ string)
            + " bf16=" + (s.stipula_bf16 ↦ string)
    }
    catch err {
        panic qwen35moe.causa_admissionis(err)
    }
}
