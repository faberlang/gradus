+++
locale = "en"
+++
# MODEL-01-M7: guarded real-file qwen35moe admission exemplar.
#
# Application-owned adapter (GGUF-A1b range-source pattern): resolves the
# operator model path, measures the artifact, reads the independently bounded
# manifest prefix once (the first `expected_data` bytes; never a tensor-
# payload byte), calls `gradus:model/qwen35moe` admission, and prints the
# ADMIT receipt: the frozen configuration + the 753-tensor receipt (block
# schedule + storage distribution). The adapter owns the path and I/O; Gradus
# receives only the bounded corpus, the expected digest, and the expected
# artifact length.

import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" gguf_manifest
import from "gradus:model/qwen35moe" qwen35moe
import from "norma:process" process
import from "norma:fs" fs

# Render the frozen rope sections list as `[11,11,10,0]`.
fn _sections(list<int> xs) → string {
    var string out ← "["
    var int i ← 0
    while i < xs.length() {
        if i > 0 { out ← out + "," }
        out ← out + ((xs.get(i) coalesce 0) ↦ string)
        i ↑
    }
    return out + "]"
}

main {
    const list<string> args ← process.argv() ↦ list<string>
    if args.length() ≠ 3 {
        panic "usage: gguf-admit-qwen35moe <path> <expected-data-offset> <sha256>"
    }
    const string via ← args.get(0) coalesce ""
    const int expected_data ← (args.get(1) coalesce "0") ↦ int
    const string digest ← args.get(2) coalesce ""
    const int total ← fs.byte_length(via)
    const bytes prefix_bytes ← fs.read_range(via, 0, expected_data)
    if prefix_bytes.length() ≠ expected_data {
        panic "file adapter returned a short table-prefix read"
    }
    const artifact.ContentIdentity identity ← artifact.ContentIdentity {
        algorithm = "sha-256",
        digest = digest,
        length = total
    }
    const gguf_manifest.GgufCorpus corpus ← gguf_manifest.GgufCorpus {
        table = prefix_bytes,
        artifact_length = total,
        identity = identity
    }
    do {
        const qwen35moe.Qwen35moeAdmission admission ← qwen35moe.admit(corpus, digest, total)
        const qwen35moe.Qwen35moeConfig c ← admission.config
        const qwen35moe.QwenTensorSummary s ← admission.summary
        print "ADMIT qwen35moe"
        print "CONFIG general.architecture=" + c.architecture
        print "CONFIG general.file_type=" + (c.file_type ↦ string)
        print "CONFIG general.quantization_version=" + (c.quantization_version ↦ string)
        print "CONFIG qwen35moe.block_count=" + (c.block_count ↦ string)
        print "CONFIG qwen35moe.context_length=" + (c.context_length ↦ string)
        print "CONFIG qwen35moe.embedding_length=" + (c.embedding_length ↦ string)
        print "CONFIG qwen35moe.attention.head_count=" + (c.head_count ↦ string)
        print "CONFIG qwen35moe.attention.head_count_kv=" + (c.head_count_kv ↦ string)
        print "CONFIG qwen35moe.attention.key_length=" + (c.key_length ↦ string)
        print "CONFIG qwen35moe.attention.value_length=" + (c.value_length ↦ string)
        print "CONFIG qwen35moe.attention.layer_norm_rms_epsilon=" + (c.rms_norm_epsilon ↦ string)
        print "CONFIG qwen35moe.rope.freq_base=" + (c.freq_base ↦ string)
        print "CONFIG qwen35moe.rope.dimension_count=" + (c.rope_dimension_count ↦ string)
        print "CONFIG qwen35moe.rope.dimension_sections=" + _sections(c.rope_sections)
        print "CONFIG qwen35moe.expert_count=" + (c.expert_count ↦ string)
        print "CONFIG qwen35moe.expert_used_count=" + (c.expert_used_count ↦ string)
        print "CONFIG qwen35moe.expert_feed_forward_length=" + (c.expert_ffn_length ↦ string)
        print "CONFIG qwen35moe.expert_shared_feed_forward_length=" + (c.shared_ffn_length ↦ string)
        print "CONFIG qwen35moe.ssm.conv_kernel=" + (c.conv_kernel ↦ string)
        print "CONFIG qwen35moe.ssm.state_size=" + (c.state_size ↦ string)
        print "CONFIG qwen35moe.ssm.group_count=" + (c.group_count ↦ string)
        print "CONFIG qwen35moe.ssm.time_step_rank=" + (c.gradus_temporis ↦ string)
        print "CONFIG qwen35moe.ssm.inner_size=" + (c.inner_size ↦ string)
        print "CONFIG qwen35moe.full_attention_interval=" + (c.full_attention_interval ↦ string)
        print "CONFIG qwen35moe.nextn_predict_layers=" + (c.nextn_predict_layers ↦ string)
        print "CONFIG tokenizer.ggml.model=" + c.tokenizer_model
        print "CONFIG tokenizer.ggml.pre=" + c.tokenizer_pre
        print "CONFIG tokenizer.ggml.tokens=" + (c.token_count ↦ string)
        print "CONFIG tokenizer.ggml.token_type=" + (c.token_type_count ↦ string)
        print "CONFIG tokenizer.ggml.merges=" + (c.merge_count ↦ string)
        print "CONFIG tokenizer.ggml.eos_token_id=" + (c.eos_token_id ↦ string)
        print "CONFIG tokenizer.ggml.padding_token_id=" + (c.padding_token_id ↦ string)
        print "CONFIG tokenizer.ggml.bos_token_id=" + (c.bos_token_id ↦ string)
        print "CONFIG tokenizer.ggml.add_bos_token=" + (c.add_bos_token ↦ string)
        print "TENSORS total=" + (s.total ↦ string)
        print "BLOCK hybrid=" + (s.hybrid ↦ string)
            + " full_attention=" + (s.full_attention ↦ string)
            + " nextn=" + (s.nextn ↦ string)
            + " global=" + (s.globals ↦ string)
        print "STORAGE f32=" + (s.storage_f32 ↦ string)
            + " q8_0=" + (s.storage_q8_0 ↦ string)
            + " q4_K=" + (s.storage_q4_k ↦ string)
            + " q5_K=" + (s.storage_q5_k ↦ string)
            + " q6_K=" + (s.storage_q6_k ↦ string)
            + " bf16=" + (s.storage_bf16 ↦ string)
    }
    catch err {
        panic qwen35moe.admission_message(err)
    }
}
