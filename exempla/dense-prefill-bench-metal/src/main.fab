    let _ W_HEAD ← make_block([0.0166666667, 0.0208333333, 0.025, 0.0291666667, 0.0333333333, 0.0375, 0.0416666667, 0.0458333333, 0.0291666667, 0.0375, 0.0458333333, 0.0541666667, 0.0083333333, 0.0166666667, 0.025, 0.0333333333, 0.0416666667, 0.0541666667, 0.0125, 0.025, 0.0375, 0.05, 0.0083333333, 0.0208333333, 0.0541666667, 0.0166666667, 0.0333333333, 0.05, 0.0125, 0.0291666667, 0.0458333333, 0.0083333333, 0.0125, 0.0333333333, 0.0541666667, 0.0208333333, 0.0416666667, 0.0083333333, 0.0291666667, 0.05, 0.025, 0.05, 0.0208333333, 0.0458333333, 0.0166666667, 0.0416666667, 0.0125, 0.0375, 0.0375, 0.0125, 0.0416666667, 0.0166666667, 0.0458333333, 0.0208333333, 0.05, 0.025, 0.05, 0.0291666667, 0.0083333333, 0.0416666667, 0.0208333333, 0.0541666667, 0.0333333333, 0.0125, 0.0083333333, 0.0458333333, 0.0291666667, 0.0125, 0.05, 0.0333333333, 0.0166666667, 0.0541666667, 0.0208333333, 0.0083333333, 0.05, 0.0375, 0.025, 0.0125, 0.0541666667, 0.0416666667, 0.0333333333, 0.025, 0.0166666667, 0.0083333333, 0.0541666667, 0.0458333333, 0.0375, 0.0291666667, 0.0458333333, 0.0416666667, 0.0375, 0.0333333333, 0.0291666667, 0.025, 0.0208333333, 0.0166666667, 0.0041666667, 0.0041666667, 0.0041666667, 0.0041666667, 0.0041666667, 0.0041666667, 0.0041666667, 0.0041666667, 0.0166666667, 0.0208333333, 0.025, 0.0291666667, 0.0333333333, 0.0375, 0.0416666667, 0.0458333333, 0.0291666667, 0.0375, 0.0458333333, 0.0541666667, 0.0083333333, 0.0166666667, 0.025, 0.0333333333, 0.0416666667, 0.0541666667, 0.0125, 0.025, 0.0375, 0.05, 0.0083333333, 0.0208333333], [16, 8])
