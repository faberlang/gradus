                let f32 ref ← ref_row_fp4_u32(w_fp4_u32, s_fp4, lx, fp4_gs, r)
                let f32 err ← (y_fp4_u32[[r]] - ref).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_4096_fp4_u32 row0=§0 max_err=§1"(sync_fp4_u32, max_err)
