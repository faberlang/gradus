                let f32 err ← (y_fp4_u8_sk[[r]] - ref).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_4096_fp4_u8_splitk row0=§0 max_err=§1"(sync_fp4_u8_sk, max_err)
            assert max_err ≺ 0.05
        }
        print_bench("bench_4096_fp4_u8_splitk", pass_no, elapsed, bytes_4096_fp4)
    }

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            fp4.linear_matvec_u32_part(w_fp4_u32, s_fp4, lx, mut p_fp4_u32, fp4_gs, 16 ∷ i32)
            fp4.linear_matvec_combine(p_fp4_u32, mut y_fp4_u32_sk)
        }
        let f32 sync_fp4_u32_sk ← y_fp4_u32_sk[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
