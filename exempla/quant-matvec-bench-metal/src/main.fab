                if err ≻ max_err { max_err ← err }
            }
            print "verify_4096_ga4_splitk16 row0=§0 max_err=§1"(syncl4_sk16, max_err)
            assert max_err ≺ 0.005
        }
        print_bench("bench_4096_ga4_splitk16", pass_no, elapsed, bytes_4096_ga4)
    }

    mut tensor<f32, [4096, 8]> lp4_8 ← tf32[4096, 8] {}
    mut tensor<f32, [4096, 32]> lp4_32 ← tf32[4096, 32] {}
    mut tensor<f32, [4096]> ly4_sk8 ← tf32[4096] {}
    mut tensor<f32, [4096]> ly4_sk32 ← tf32[4096] {}
    ds.prime1(ly4_sk8, mut sink)
    ds.prime1(ly4_sk32, mut sink)

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            ga.linear_matvec_4bit_u32_part(lw4, lscales, lbiases, lx, mut lp4_8, 64 ∷ i32)
