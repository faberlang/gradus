        print_bench("bench_4096_fp4_u32", pass_no, elapsed, bytes_4096_fp4)
    }

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            fp4.linear_matvec_u8_part(w_fp4_u8, s_fp4, lx, mut p_fp4_u8, fp4_gs, 16 ∷ i32)
            fp4.linear_matvec_combine(p_fp4_u8, mut y_fp4_u8_sk)
        }
        let f32 sync_fp4_u8_sk ← y_fp4_u8_sk[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
