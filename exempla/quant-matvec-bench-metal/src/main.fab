    # === Part 3: BlockFp8 [4096, 4096] (block_rows=128, block_cols=128) ===
    let tensor<u8, [4096, 4096]> dfp8_u8 ← tu8[4096, 4096] {}
    mut tensor<u8, [4096, 4096]> w_fp8_u8 ← tu8[4096, 4096] {}
    synth_fp8_u8(dfp8_u8, mut w_fp8_u8, 127 ∷ i32)

    let tensor<u32, [4096, 1024]> dfp8_u32 ← tu32[4096, 1024] {}
    mut tensor<u32, [4096, 1024]> w_fp8_u32 ← tu32[4096, 1024] {}
    synth_fp8_u32(dfp8_u32, mut w_fp8_u32, 131 ∷ i32)

    let tensor<u8, [32, 32]> dfp8_s ← tu8[32, 32] {}
    mut tensor<u8, [32, 32]> s_fp8 ← tu8[32, 32] {}
    synth_e8m0_u8(dfp8_s, mut s_fp8, 137 ∷ i32)

    mut tensor<f32, [4096]> y_fp8_u8 ← tf32[4096] {}
    mut tensor<f32, [4096]> y_fp8_u32 ← tf32[4096] {}
    mut tensor<f32, [4096, 32]> p_fp8_u8 ← tf32[4096, 32] {}
    mut tensor<f32, [4096, 32]> p_fp8_u32 ← tf32[4096, 32] {}
    mut tensor<f32, [4096]> y_fp8_u8_sk ← tf32[4096] {}
    mut tensor<f32, [4096]> y_fp8_u32_sk ← tf32[4096] {}
    ds.prime1(y_fp8_u8, mut sink)
    ds.prime1(y_fp8_u32, mut sink)
    ds.prime1(y_fp8_u8_sk, mut sink)
    ds.prime1(y_fp8_u32_sk, mut sink)

    let int bytes_4096_bfp8 ← 4096 * 4096 + 32 * 32 + 4096 * 4 + 4096 * 4

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            bfp8.linear_matvec_u8(w_fp8_u8, s_fp8, lx, mut y_fp8_u8, 128 ∷ i32, 128 ∷ i32)
        }
        let f32 sync_fp8_u8 ← y_fp8_u8[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
            for range 0 ‥ 4 let r {
                let f32 ref ← ref_row_bfp8_u8(w_fp8_u8, s_fp8, lx, r)
                let f32 err ← (y_fp8_u8[[r]] - ref).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_4096_bfp8_u8 row0=§0 max_err=§1"(sync_fp8_u8, max_err)
            assert max_err ≺ 0.05
        }
        print_bench("bench_4096_bfp8_u8", pass_no, elapsed, bytes_4096_bfp8)
    }

    for exclusive PASSES let pass_no {
