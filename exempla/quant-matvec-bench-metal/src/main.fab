+++ toml
locale = "en"

+++ faber
# quant-matvec-bench-metal: timed quantized GEMV ladder on Metal
#   - GroupAffine u32-packed (4-bit, 8-bit; non-split & split-K) on [2560, 960] and [4096, 4096]
#   - BlockFp8 (u8 & u32-packed) on [4096, 4096] (block_rows=128, block_cols=128)
#   - DualScaledFp4 (u8 & u32-packed) on [4096, 4096] (group_size=16)
#
#   faber run exempla/quant-matvec-bench-metal --library-home <gradus parent> \
#       --device metal

import from "gradus:decode_step" let ds
import from "gradus:quant/group_affine" let ga
import from "gradus:quant/block_fp8" let bfp8
import from "gradus:quant/dual_scaled_fp4" let fp4
import from "gradus:quant/fp_primitives" let fp
import from "norma:time" let time

const int OUT = 2560
const int IN_DIM = 960
const int GROUP_SIZE = 64
const int GROUPS = 15

const int L_OUT = 4096
const int L_IN = 4096
const int L_GROUP_SIZE = 64
const int L_GROUPS = 64
const int FP8_BLOCK = 128
const int FP8_SCALES = 32
const int FP4_GROUP_SIZE = 16
const int FP4_GROUPS = 256

const int CALLS_PER_PASS = 32
const int PASSES = 6

@ public
kernel synth_u32<size R, size C>(tensor<u32, [R, C]> dom, mut tensor<u32, [R, C]> out, i32 seed) → void {
    for from dom at [r, c] thread lane let ? {
        let i32 rr ← r ↦ i32
        let i32 cc ← c ↦ i32
        if rr ≥ 0 and rr ≤ 65536 and cc ≥ 0 and cc ≤ 65536 and seed ≥ 0 and seed ≤ 65536 {
            let i32 v ← (rr * 131 + cc * 17 + seed) % 32767
            let i32 packed ← v * 65537
            out[[r, c]] ← packed ↦ u32 ⊥ (0 ∷ u32)
        }
    }
}

@ public
kernel synth_fp8_u32<size R, size C>(tensor<u32, [R, C]> dom, mut tensor<u32, [R, C]> out, i32 seed) → void {
    for from dom at [r, c] thread lane let ? {
        let i32 rr ← r ↦ i32
        let i32 cc ← c ↦ i32
        if rr ≥ 0 and rr ≤ 65536 and cc ≥ 0 and cc ≤ 65536 and seed ≥ 0 and seed ≤ 65536 {
            let i32 b0 ← ((rr * 31 + cc * 17 + seed) % 126)
            let i32 b1 ← ((rr * 19 + cc * 23 + seed + 3) % 126) + 128
            let i32 b2 ← ((rr * 41 + cc * 11 + seed + 7) % 126)
            let i32 b3 ← ((rr * 13 + cc * 29 + seed + 11) % 126)
            let i32 packed ← b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
            out[[r, c]] ← packed ↦ u32 ⊥ (0 ∷ u32)
        }
    }
}

@ public
kernel synth_fp8_u8<size R, size C>(tensor<u8, [R, C]> dom, mut tensor<u8, [R, C]> out, i32 seed) → void {
    for from dom at [r, c] thread lane let ? {
        let i32 rr ← r ↦ i32
        let i32 cc ← c ↦ i32
        if rr ≥ 0 and rr ≤ 65536 and cc ≥ 0 and cc ≤ 65536 and seed ≥ 0 and seed ≤ 65536 {
            let i32 mag ← (rr * 31 + cc * 17 + seed) % 126
            let i32 sgn ← ((rr + cc) % 2) * 128
            out[[r, c]] ← (mag + sgn) ↦ u8 ⊥ (0 ∷ u8)
        }
    }
}

@ public
kernel synth_e8m0_u8<size R, size C>(tensor<u8, [R, C]> dom, mut tensor<u8, [R, C]> out, i32 seed) → void {
    for from dom at [r, c] thread lane let ? {
        let i32 rr ← r ↦ i32
        let i32 cc ← c ↦ i32
        if rr ≥ 0 and rr ≤ 65536 and cc ≥ 0 and cc ≤ 65536 and seed ≥ 0 and seed ≤ 65536 {
            let i32 e ← 122 + ((rr * 7 + cc * 13 + seed) % 9)
            out[[r, c]] ← e ↦ u8 ⊥ (127 ∷ u8)
        }
    }
}

@ public
kernel synth_u8_raw<size R, size C>(tensor<u8, [R, C]> dom, mut tensor<u8, [R, C]> out, i32 seed) → void {
    for from dom at [r, c] thread lane let ? {
        let i32 rr ← r ↦ i32
        let i32 cc ← c ↦ i32
        if rr ≥ 0 and rr ≤ 65536 and cc ≥ 0 and cc ≤ 65536 and seed ≥ 0 and seed ≤ 65536 {
            let i32 v ← (rr * 53 + cc * 29 + seed) % 256
            out[[r, c]] ← v ↦ u8 ⊥ (0 ∷ u8)
        }
    }
}

@ public
kernel synth_f32_mat<size R, size C>(tensor<f32, [R, C]> dom, mut tensor<f32, [R, C]> out, i32 seed, f32 amp) → void {
    for from dom at [r, c] thread lane let ? {
        let i32 rr ← r ↦ i32
        let i32 cc ← c ↦ i32
        if rr ≥ 0 and rr ≤ 65536 and cc ≥ 0 and cc ≤ 65536 and seed ≥ 0 and seed ≤ 65536 {
            let i32 a ← (rr * 31 + cc * 17 + seed) % 65521
            let f32 h ← ((a ↦ f32) + 0.5) * 0.7123
            out[[r, c]] ← h.sin() * amp
        }
    }
}

@ public
kernel synth_f32_vec<size N>(tensor<f32, [N]> dom, mut tensor<f32, [N]> out, i32 seed, f32 amp) → void {
    for from dom at [i] thread lane let ? {
        let i32 ii ← i ↦ i32
        if ii ≥ 0 and ii ≤ 65536 and seed ≥ 0 and seed ≤ 65536 {
            let i32 a ← (ii * 19 + seed) % 65521
            let f32 h ← ((a ↦ f32) + 0.5) * 0.7123
            out[[i]] ← h.sin() * amp
        }
    }
}

fn ref_row_u32_4bit<size Out, size PackedIn, size Groups, size In>(tensor<u32, [Out, PackedIn]> w4, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [In]> x, int row, int in_dim, int group_size) → f32 {
    mut f32 acc ← 0.0
    for range 0 ‥ in_dim let j {
        let int g ← j / group_size
        let int bit_pos ← j * 4
        let int word_idx ← bit_pos / 32
        let int shift ← bit_pos % 32
        let u32 word ← w4[[row, word_idx]]
        let u32 q ← (word ⇒ (shift ↦ u32 ⊥ (0 ∷ u32))) ∧ (15 ∷ u32)
        let f32 w ← (q ↦ f32) * scales[[row, g]] + biases[[row, g]]
        acc ← acc + w * x[[j]]
    }
    return acc
}

fn ref_row_u32_8bit<size Out, size PackedIn, size Groups, size In>(tensor<u32, [Out, PackedIn]> w8, tensor<f32, [Out, Groups]> scales, tensor<f32, [Out, Groups]> biases, tensor<f32, [In]> x, int row, int in_dim, int group_size) → f32 {
    mut f32 acc ← 0.0
    for range 0 ‥ in_dim let j {
        let int g ← j / group_size
        let int bit_pos ← j * 8
        let int word_idx ← bit_pos / 32
        let int shift ← bit_pos % 32
        let u32 word ← w8[[row, word_idx]]
        let u32 q ← (word ⇒ (shift ↦ u32 ⊥ (0 ∷ u32))) ∧ (255 ∷ u32)
        let f32 w ← (q ↦ f32) * scales[[row, g]] + biases[[row, g]]
        acc ← acc + w * x[[j]]
    }
    return acc
}

fn ref_row_bfp8_u8(tensor<u8, [4096, 4096]> w8, tensor<u8, [32, 32]> scales, tensor<f32, [4096]> x, int row) → f32 {
    let int sr ← row / FP8_BLOCK
    mut f32 acc ← 0.0
    for range 0 ‥ L_IN let j {
        let int sc ← j / FP8_BLOCK
        let f32 w ← fp.fp8_e4m3(w8[[row, j]])
        let f32 s ← fp.ue8m0(scales[[sr, sc]])
        acc ← acc + (w * s) * x[[j]]
    }
    return acc
}

fn ref_row_bfp8_u32(tensor<u32, [4096, 1024]> w32, tensor<u8, [32, 32]> scales, tensor<f32, [4096]> x, int row) → f32 {
    let int sr ← row / FP8_BLOCK
    mut f32 acc ← 0.0
    for range 0 ‥ L_IN let j {
        let int sc ← j / FP8_BLOCK
        let int word_idx ← j / 4
        let int shift ← (j % 4) * 8
        let u32 word ← w32[[row, word_idx]]
        let u8 b ← ((word ⇒ (shift ↦ u32 ⊥ (0 ∷ u32))) ∧ (255 ∷ u32)) ↦ wrapping<u8>
        let f32 w ← fp.fp8_e4m3(b)
        let f32 s ← fp.ue8m0(scales[[sr, sc]])
        acc ← acc + (w * s) * x[[j]]
    }
    return acc
}

fn ref_fp4_e2m1(int nib) → f32 {
    let int sgn ← (nib ⇒ 3) ∧ 1
    let int mag ← nib ∧ 7
    mut f32 q ← 0.0
    if mag ≡ 0 { q ← 0.0 }
    elif mag ≡ 1 { q ← 0.5 }
    elif mag ≡ 2 { q ← 1.0 }
    elif mag ≡ 3 { q ← 1.5 }
    elif mag ≡ 4 { q ← 2.0 }
    elif mag ≡ 5 { q ← 3.0 }
    elif mag ≡ 6 { q ← 4.0 }
    else { q ← 6.0 }
    return sgn ≡ 1 ✓ -q ✗ q
}

fn ref_row_fp4_u8(tensor<u8, [4096, 2048]> w8, tensor<u8, [4096, 256]> scales, tensor<f32, [4096]> x, f32 global_scale, int row) → f32 {
    mut f32 acc ← 0.0
    for range 0 ‥ L_IN let j {
        let int g ← j / FP4_GROUP_SIZE
        let u8 packed ← w8[[row, j / 2]]
        let int nib ← j % 2 ≡ 0 ✓ ((packed ↦ int) ∧ 15) ✗ (((packed ↦ int) ⇒ 4) ∧ 15)
        let f32 q ← ref_fp4_e2m1(nib)
        let f32 s ← fp.fp8_e4m3(scales[[row, g]])
        acc ← acc + (q * s * global_scale) * x[[j]]
    }
    return acc
}

fn ref_row_fp4_u32(tensor<u32, [4096, 512]> w32, tensor<u8, [4096, 256]> scales, tensor<f32, [4096]> x, f32 global_scale, int row) → f32 {
    mut f32 acc ← 0.0
    for range 0 ‥ L_IN let j {
        let int g ← j / FP4_GROUP_SIZE
        let int word_idx ← j / 8
        let int shift ← (j % 8) * 4
        let u32 word ← w32[[row, word_idx]]
        let int nib ← ((word ⇒ (shift ↦ u32 ⊥ (0 ∷ u32))) ∧ (15 ∷ u32)) ↦ int
        let f32 q ← ref_fp4_e2m1(nib)
        let f32 s ← fp.fp8_e4m3(scales[[row, g]])
        acc ← acc + (q * s * global_scale) * x[[j]]
    }
    return acc
}

fn print_bench(string name, int pass_no, int elapsed_ns, int bytes_per_call) → void {
    let int us_per_call ← elapsed_ns / CALLS_PER_PASS / 1000
    let f64 gbps ← ((bytes_per_call * CALLS_PER_PASS) ↦ f64) ÷ (elapsed_ns ↦ f64)
    print "§0 pass=§1 calls=§2 ns=§3 us_per_call=§4 gbps=§5"(name, pass_no, CALLS_PER_PASS, elapsed_ns, us_per_call, gbps)
}

main {
    mut tensor<f32, [1]> sink ← tf32[1] {}

    # === Part 1: SmolLM2-360M shape [2560, 960], group_size=64 ===
    let tensor<u32, [2560, 120]> d4 ← tensor<u32, [2560, 120]> {}
    mut tensor<u32, [2560, 120]> w4 ← tensor<u32, [2560, 120]> {}
    synth_u32(d4, mut w4, 11 ∷ i32)

    let tensor<u32, [2560, 240]> d8 ← tensor<u32, [2560, 240]> {}
    mut tensor<u32, [2560, 240]> w8 ← tensor<u32, [2560, 240]> {}
    synth_u32(d8, mut w8, 23 ∷ i32)

    let tensor<f32, [2560, 15]> ds_mat ← tf32[2560, 15] {}
    mut tensor<f32, [2560, 15]> scales ← tf32[2560, 15] {}
    mut tensor<f32, [2560, 15]> biases ← tf32[2560, 15] {}
    synth_f32_mat(ds_mat, mut scales, 37 ∷ i32, 0.05 ∷ f32)
    synth_f32_mat(ds_mat, mut biases, 53 ∷ i32, 0.02 ∷ f32)

    let tensor<f32, [960]> dx ← tf32[960] {}
    mut tensor<f32, [960]> x ← tf32[960] {}
    synth_f32_vec(dx, mut x, 71 ∷ i32, 1.0 ∷ f32)

    mut tensor<f32, [2560]> y4 ← tf32[2560] {}
    mut tensor<f32, [2560]> y8 ← tf32[2560] {}
    mut tensor<f32, [2560, 15]> p4 ← tf32[2560, 15] {}
    mut tensor<f32, [2560, 15]> p8 ← tf32[2560, 15] {}
    mut tensor<f32, [2560]> y4_sk ← tf32[2560] {}
    mut tensor<f32, [2560]> y8_sk ← tf32[2560] {}
    ds.prime1(y4, mut sink)
    ds.prime1(y8, mut sink)
    ds.prime1(y4_sk, mut sink)
    ds.prime1(y8_sk, mut sink)

    let int bytes_2560_4b ← 2560 * 120 * 4 + 2560 * 15 * 8 + 960 * 4 + 2560 * 4
    let int bytes_2560_8b ← 2560 * 240 * 4 + 2560 * 15 * 8 + 960 * 4 + 2560 * 4

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            ga.linear_matvec_u32(w4, scales, biases, x, mut y4, 4 ∷ i32, 64 ∷ i32)
        }
        let f32 sync4 ← y4[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
            for range 0 ‥ 4 let r {
                let f32 err ← (y4[[r]] - ref_row_u32_4bit(w4, scales, biases, x, r, IN_DIM, GROUP_SIZE)).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_2560_4bit row0=§0 max_err=§1"(sync4, max_err)
            assert max_err ≺ 0.001
        }
        print_bench("bench_2560_4bit", pass_no, elapsed, bytes_2560_4b)
    }

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            ga.linear_matvec_u32(w8, scales, biases, x, mut y8, 8 ∷ i32, 64 ∷ i32)
        }
        let f32 sync8 ← y8[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
            for range 0 ‥ 4 let r {
                let f32 err ← (y8[[r]] - ref_row_u32_8bit(w8, scales, biases, x, r, IN_DIM, GROUP_SIZE)).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_2560_8bit row0=§0 max_err=§1"(sync8, max_err)
            assert max_err ≺ 0.001
        }
        print_bench("bench_2560_8bit", pass_no, elapsed, bytes_2560_8b)
    }

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            ga.linear_matvec_u32_part(w4, scales, biases, x, mut p4, 4 ∷ i32, 64 ∷ i32)
            ga.linear_matvec_u32_combine(p4, mut y4_sk)
        }
        let f32 sync4_sk ← y4_sk[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
            for range 0 ‥ 4 let r {
                let f32 err ← (y4_sk[[r]] - ref_row_u32_4bit(w4, scales, biases, x, r, IN_DIM, GROUP_SIZE)).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_2560_4bit_splitk row0=§0 max_err=§1"(sync4_sk, max_err)
            assert max_err ≺ 0.001
        }
        print_bench("bench_2560_4bit_splitk", pass_no, elapsed, bytes_2560_4b)
    }

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            ga.linear_matvec_u32_part(w8, scales, biases, x, mut p8, 8 ∷ i32, 64 ∷ i32)
            ga.linear_matvec_u32_combine(p8, mut y8_sk)
        }
        let f32 sync8_sk ← y8_sk[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
            for range 0 ‥ 4 let r {
                let f32 err ← (y8_sk[[r]] - ref_row_u32_8bit(w8, scales, biases, x, r, IN_DIM, GROUP_SIZE)).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_2560_8bit_splitk row0=§0 max_err=§1"(sync8_sk, max_err)
            assert max_err ≺ 0.001
        }
        print_bench("bench_2560_8bit_splitk", pass_no, elapsed, bytes_2560_8b)
    }

    # === Part 2: 7B/35B shape [4096, 4096] ===
    let tensor<u32, [4096, 512]> dl4 ← tensor<u32, [4096, 512]> {}
    mut tensor<u32, [4096, 512]> lw4 ← tensor<u32, [4096, 512]> {}
    synth_u32(dl4, mut lw4, 101 ∷ i32)

    let tensor<u32, [4096, 1024]> dl8 ← tensor<u32, [4096, 1024]> {}
    mut tensor<u32, [4096, 1024]> lw8 ← tensor<u32, [4096, 1024]> {}
    synth_u32(dl8, mut lw8, 103 ∷ i32)

    let tensor<f32, [4096, 64]> dls ← tf32[4096, 64] {}
    mut tensor<f32, [4096, 64]> lscales ← tf32[4096, 64] {}
    mut tensor<f32, [4096, 64]> lbiases ← tf32[4096, 64] {}
    synth_f32_mat(dls, mut lscales, 107 ∷ i32, 0.05 ∷ f32)
    synth_f32_mat(dls, mut lbiases, 109 ∷ i32, 0.02 ∷ f32)

    let tensor<f32, [4096]> dlx ← tf32[4096] {}
    mut tensor<f32, [4096]> lx ← tf32[4096] {}
    synth_f32_vec(dlx, mut lx, 113 ∷ i32, 1.0 ∷ f32)

    mut tensor<f32, [4096]> ly4 ← tf32[4096] {}
    mut tensor<f32, [4096]> ly8 ← tf32[4096] {}
    mut tensor<f32, [4096, 64]> lp4 ← tf32[4096, 64] {}
    mut tensor<f32, [4096, 64]> lp8 ← tf32[4096, 64] {}
    mut tensor<f32, [4096]> ly4_sk ← tf32[4096] {}
    mut tensor<f32, [4096]> ly8_sk ← tf32[4096] {}
    ds.prime1(ly4, mut sink)
    ds.prime1(ly8, mut sink)
    ds.prime1(ly4_sk, mut sink)
    ds.prime1(ly8_sk, mut sink)

    let int bytes_4096_ga4 ← 4096 * 512 * 4 + 4096 * 64 * 8 + 4096 * 4 + 4096 * 4
    let int bytes_4096_ga8 ← 4096 * 1024 * 4 + 4096 * 64 * 8 + 4096 * 4 + 4096 * 4

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            ga.linear_matvec_u32(lw4, lscales, lbiases, lx, mut ly4, 4 ∷ i32, 64 ∷ i32)
        }
        let f32 syncl4 ← ly4[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
            for range 0 ‥ 4 let r {
                let f32 err ← (ly4[[r]] - ref_row_u32_4bit(lw4, lscales, lbiases, lx, r, L_IN, L_GROUP_SIZE)).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_4096_ga4 row0=§0 max_err=§1"(syncl4, max_err)
            assert max_err ≺ 0.005
        }
        print_bench("bench_4096_ga4", pass_no, elapsed, bytes_4096_ga4)
    }

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            ga.linear_matvec_u32(lw8, lscales, lbiases, lx, mut ly8, 8 ∷ i32, 64 ∷ i32)
        }
        let f32 syncl8 ← ly8[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
            for range 0 ‥ 4 let r {
                let f32 err ← (ly8[[r]] - ref_row_u32_8bit(lw8, lscales, lbiases, lx, r, L_IN, L_GROUP_SIZE)).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_4096_ga8 row0=§0 max_err=§1"(syncl8, max_err)
            assert max_err ≺ 0.005
        }
        print_bench("bench_4096_ga8", pass_no, elapsed, bytes_4096_ga8)
    }

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            ga.linear_matvec_u32_part(lw4, lscales, lbiases, lx, mut lp4, 4 ∷ i32, 64 ∷ i32)
            ga.linear_matvec_u32_combine(lp4, mut ly4_sk)
        }
        let f32 syncl4_sk ← ly4_sk[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
            for range 0 ‥ 4 let r {
                let f32 err ← (ly4_sk[[r]] - ref_row_u32_4bit(lw4, lscales, lbiases, lx, r, L_IN, L_GROUP_SIZE)).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_4096_ga4_splitk row0=§0 max_err=§1"(syncl4_sk, max_err)
            assert max_err ≺ 0.005
        }
        print_bench("bench_4096_ga4_splitk", pass_no, elapsed, bytes_4096_ga4)
    }

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            ga.linear_matvec_u32_part(lw8, lscales, lbiases, lx, mut lp8, 8 ∷ i32, 64 ∷ i32)
            ga.linear_matvec_u32_combine(lp8, mut ly8_sk)
        }
        let f32 syncl8_sk ← ly8_sk[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
            for range 0 ‥ 4 let r {
                let f32 err ← (ly8_sk[[r]] - ref_row_u32_8bit(lw8, lscales, lbiases, lx, r, L_IN, L_GROUP_SIZE)).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_4096_ga8_splitk row0=§0 max_err=§1"(syncl8_sk, max_err)
            assert max_err ≺ 0.005
        }
        print_bench("bench_4096_ga8_splitk", pass_no, elapsed, bytes_4096_ga8)
    }

    mut tensor<f32, [4096, 16]> lp4_16 ← tf32[4096, 16] {}
    mut tensor<f32, [4096, 16]> lp8_16 ← tf32[4096, 16] {}
    mut tensor<f32, [4096]> ly4_sk16 ← tf32[4096] {}
    mut tensor<f32, [4096]> ly8_sk16 ← tf32[4096] {}
    ds.prime1(ly4_sk16, mut sink)
    ds.prime1(ly8_sk16, mut sink)

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            ga.linear_matvec_u32_part(lw4, lscales, lbiases, lx, mut lp4_16, 4 ∷ i32, 64 ∷ i32)
            ga.linear_matvec_u32_combine(lp4_16, mut ly4_sk16)
        }
        let f32 syncl4_gsk16 ← ly4_sk16[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
            for range 0 ‥ 4 let r {
                let f32 err ← (ly4_sk16[[r]] - ref_row_u32_4bit(lw4, lscales, lbiases, lx, r, L_IN, L_GROUP_SIZE)).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_4096_ga4_generic_splitk16 row0=§0 max_err=§1"(syncl4_gsk16, max_err)
            assert max_err ≺ 0.005
        }
        print_bench("bench_4096_ga4_generic_splitk16", pass_no, elapsed, bytes_4096_ga4)
    }

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            ga.linear_matvec_4bit_u32_part(lw4, lscales, lbiases, lx, mut lp4_16, 64 ∷ i32)
