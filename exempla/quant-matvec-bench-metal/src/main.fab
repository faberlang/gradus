    # === Part 4: DualScaledFp4 [4096, 4096] (group_size=16) ===
    let tensor<u8, [4096, 2048]> dfp4_u8 ← tu8[4096, 2048] {}
    mut tensor<u8, [4096, 2048]> w_fp4_u8 ← tu8[4096, 2048] {}
    synth_u8_raw(dfp4_u8, mut w_fp4_u8, 139 ∷ i32)

    let tensor<u32, [4096, 512]> dfp4_u32 ← tu32[4096, 512] {}
    mut tensor<u32, [4096, 512]> w_fp4_u32 ← tu32[4096, 512] {}
    synth_u32(dfp4_u32, mut w_fp4_u32, 149 ∷ i32)

    let tensor<u8, [4096, 256]> dfp4_s ← tu8[4096, 256] {}
    mut tensor<u8, [4096, 256]> s_fp4 ← tu8[4096, 256] {}
    synth_fp8_u8(dfp4_s, mut s_fp4, 151 ∷ i32)

    mut tensor<f32, [4096]> y_fp4_u8 ← tf32[4096] {}
    mut tensor<f32, [4096]> y_fp4_u32 ← tf32[4096] {}
    mut tensor<f32, [4096, 64]> p_fp4_u8 ← tf32[4096, 64] {}
    mut tensor<f32, [4096, 64]> p_fp4_u32 ← tf32[4096, 64] {}
    mut tensor<f32, [4096]> y_fp4_u8_sk ← tf32[4096] {}
    mut tensor<f32, [4096]> y_fp4_u32_sk ← tf32[4096] {}
    ds.prime1(y_fp4_u8, mut sink)
    ds.prime1(y_fp4_u32, mut sink)
    ds.prime1(y_fp4_u8_sk, mut sink)
    ds.prime1(y_fp4_u32_sk, mut sink)

    let f32 fp4_gs ← 0.5 ∷ f32
    let int bytes_4096_fp4 ← 4096 * 2048 + 4096 * 256 + 4096 * 4 + 4096 * 4

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            fp4.linear_matvec_u8(w_fp4_u8, s_fp4, lx, mut y_fp4_u8, fp4_gs, 16 ∷ i32)
        }
        let f32 sync_fp4_u8 ← y_fp4_u8[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
            for range 0 ‥ 4 let r {
                let f32 ref ← ref_row_fp4_u8(w_fp4_u8, s_fp4, lx, fp4_gs, r)
                let f32 err ← (y_fp4_u8[[r]] - ref).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_4096_fp4_u8 row0=§0 max_err=§1"(sync_fp4_u8, max_err)
            assert max_err ≺ 0.05
        }
        print_bench("bench_4096_fp4_u8", pass_no, elapsed, bytes_4096_fp4)
    }

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            fp4.linear_matvec_u32(w_fp4_u32, s_fp4, lx, mut y_fp4_u32, fp4_gs, 16 ∷ i32)
        }
        let f32 sync_fp4_u32 ← y_fp4_u32[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            mut f32 max_err ← 0.0
