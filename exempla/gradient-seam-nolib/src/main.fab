+++
locale = "en"
+++
# gradient-seam-nolib — U1 execution proof (self-contained).
#
# Proves @ radix backward + per-element FD pipeline executes on fmir.

fn nil() → void {
    pass
}

@ radix { lane = "air" }
@ radix backward "loss_backward"
fn simple_loss(tensor<f32, [2, 2]> x, tensor<f32, [2, 2]> w) → f32 {
    let tensor<f32, [2, 2]> product ← x ⊙ w
    return product.mean()
}

main {
    let list<f32> data_x ← [1.0, 2.0, 3.0, 4.0]
    let list<f32> data_w ← [0.5, 0.0 - 0.25, 1.0, 1.5]
    let list<int> shape_2x2 ← [2, 2]
    let tensor<f32, [2, 2]> x ← data_x ↦ tensor<f32, shape_2x2>
    let tensor<f32, [2, 2]> w ← data_w ↦ tensor<f32, shape_2x2>

    # Forward.
    let f32 loss ← simple_loss(x, w)
    print loss

    # Backward.
    let f32 upstream ← 1.0
    let tuple<tensor<f32, [2, 2]>, tensor<f32, [2, 2]>> grads ← loss_backward(x, w, nil(), upstream)
    let tensor<f32, [2, 2]> gw ← grads[1]
    let list<f32> flat_gw ← gw ↦ list<f32>

    # Per-element FD.
    let f32 eps ← 0.00001
    let f32 two_eps ← 0.00002
    let list<f32> flat_w ← w ↦ list<f32>

    # Element 0
    let list<f32> wp0 ← [flat_w[0] + eps, flat_w[1], flat_w[2], flat_w[3]]
    let list<f32> wm0 ← [flat_w[0] - eps, flat_w[1], flat_w[2], flat_w[3]]
    let tensor<f32, [2, 2]> twp0 ← wp0 ↦ tensor<f32, shape_2x2>
    let tensor<f32, [2, 2]> twm0 ← wm0 ↦ tensor<f32, shape_2x2>
    let f32 lp0 ← simple_loss(x, twp0)
    let f32 lm0 ← simple_loss(x, twm0)
    let f32 fd0 ← (lp0 - lm0) / two_eps

    # Element 1
    let list<f32> wp1 ← [flat_w[0], flat_w[1] + eps, flat_w[2], flat_w[3]]
    let list<f32> wm1 ← [flat_w[0], flat_w[1] - eps, flat_w[2], flat_w[3]]
    let tensor<f32, [2, 2]> twp1 ← wp1 ↦ tensor<f32, shape_2x2>
    let tensor<f32, [2, 2]> twm1 ← wm1 ↦ tensor<f32, shape_2x2>
    let f32 lp1 ← simple_loss(x, twp1)
    let f32 lm1 ← simple_loss(x, twm1)
    let f32 fd1 ← (lp1 - lm1) / two_eps

    # Element 2
    let list<f32> wp2 ← [flat_w[0], flat_w[1], flat_w[2] + eps, flat_w[3]]
    let list<f32> wm2 ← [flat_w[0], flat_w[1], flat_w[2] - eps, flat_w[3]]
    let tensor<f32, [2, 2]> twp2 ← wp2 ↦ tensor<f32, shape_2x2>
    let tensor<f32, [2, 2]> twm2 ← wm2 ↦ tensor<f32, shape_2x2>
    let f32 lp2 ← simple_loss(x, twp2)
    let f32 lm2 ← simple_loss(x, twm2)
    let f32 fd2 ← (lp2 - lm2) / two_eps

    # Element 3
    let list<f32> wp3 ← [flat_w[0], flat_w[1], flat_w[2], flat_w[3] + eps]
    let list<f32> wm3 ← [flat_w[0], flat_w[1], flat_w[2], flat_w[3] - eps]
    let tensor<f32, [2, 2]> twp3 ← wp3 ↦ tensor<f32, shape_2x2>
    let tensor<f32, [2, 2]> twm3 ← wm3 ↦ tensor<f32, shape_2x2>
    let f32 lp3 ← simple_loss(x, twp3)
    let f32 lm3 ← simple_loss(x, twm3)
    let f32 fd3 ← (lp3 - lm3) / two_eps

    # Compare FD vs companion gradient.
    let f32 dif0 ← fd0 - flat_gw[0]
    let f32 dif1 ← fd1 - flat_gw[1]
    let f32 dif2 ← fd2 - flat_gw[2]
    let f32 dif3 ← fd3 - flat_gw[3]
    print flat_gw
    print [fd0, fd1, fd2, fd3]
    print [dif0, dif1, dif2, dif3]
}
