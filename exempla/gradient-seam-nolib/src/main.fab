+++
locale = "en"
+++
# gradient-seam-nolib — U1 execution proof (self-contained).
#
# Proves @ radix backward + per-element FD pipeline executes on fmir.

fn nil() → void {
    pass
}

@ radix { lane = "air" }
@ radix backward "loss_backward"
fn simple_loss(tensor<f32, [2, 2]> x, tensor<f32, [2, 2]> w) → f32 {
    const tensor<f32, [2, 2]> product ← x.multiply(w)
    return product.mean()
}

main {
    const list<f32> data_x ← [1.0, 2.0, 3.0, 4.0]
    const list<f32> data_w ← [0.5, 0.0 - 0.25, 1.0, 1.5]
    const tensor<f32, []> seed ← empty
    const list<int> shape_2x2 ← [2, 2]
    const tensor<f32, [2, 2]> x ← seed.from_flat(data_x, shape_2x2)
    const tensor<f32, [2, 2]> w ← seed.from_flat(data_w, shape_2x2)

    # Forward.
    const f32 loss ← simple_loss(x, w)
    print loss

    # Backward.
    const f32 upstream ← 1.0
    const tuple<tensor<f32, [2, 2]>, tensor<f32, [2, 2]>> grads ← loss_backward(x, w, nil(), upstream)
    const tensor<f32, [2, 2]> gw ← grads[1]
    const list<f32> flat_gw ← gw ↦ list<f32>

    # Per-element FD.
    const f32 eps ← 0.00001
    const f32 two_eps ← 0.00002
    const list<f32> flat_w ← w ↦ list<f32>

    # Element 0
    const list<f32> wp0 ← [flat_w[0] + eps, flat_w[1], flat_w[2], flat_w[3]]
    const list<f32> wm0 ← [flat_w[0] - eps, flat_w[1], flat_w[2], flat_w[3]]
    const tensor<f32, [2, 2]> twp0 ← seed.from_flat(wp0, shape_2x2)
    const tensor<f32, [2, 2]> twm0 ← seed.from_flat(wm0, shape_2x2)
    const f32 lp0 ← simple_loss(x, twp0)
    const f32 lm0 ← simple_loss(x, twm0)
    const f32 fd0 ← (lp0 - lm0) / two_eps

    # Element 1
    const list<f32> wp1 ← [flat_w[0], flat_w[1] + eps, flat_w[2], flat_w[3]]
    const list<f32> wm1 ← [flat_w[0], flat_w[1] - eps, flat_w[2], flat_w[3]]
    const tensor<f32, [2, 2]> twp1 ← seed.from_flat(wp1, shape_2x2)
    const tensor<f32, [2, 2]> twm1 ← seed.from_flat(wm1, shape_2x2)
    const f32 lp1 ← simple_loss(x, twp1)
    const f32 lm1 ← simple_loss(x, twm1)
    const f32 fd1 ← (lp1 - lm1) / two_eps

    # Element 2
    const list<f32> wp2 ← [flat_w[0], flat_w[1], flat_w[2] + eps, flat_w[3]]
    const list<f32> wm2 ← [flat_w[0], flat_w[1], flat_w[2] - eps, flat_w[3]]
    const tensor<f32, [2, 2]> twp2 ← seed.from_flat(wp2, shape_2x2)
    const tensor<f32, [2, 2]> twm2 ← seed.from_flat(wm2, shape_2x2)
    const f32 lp2 ← simple_loss(x, twp2)
    const f32 lm2 ← simple_loss(x, twm2)
    const f32 fd2 ← (lp2 - lm2) / two_eps

    # Element 3
    const list<f32> wp3 ← [flat_w[0], flat_w[1], flat_w[2], flat_w[3] + eps]
    const list<f32> wm3 ← [flat_w[0], flat_w[1], flat_w[2], flat_w[3] - eps]
    const tensor<f32, [2, 2]> twp3 ← seed.from_flat(wp3, shape_2x2)
    const tensor<f32, [2, 2]> twm3 ← seed.from_flat(wm3, shape_2x2)
    const f32 lp3 ← simple_loss(x, twp3)
    const f32 lm3 ← simple_loss(x, twm3)
    const f32 fd3 ← (lp3 - lm3) / two_eps

    # Compare FD vs companion gradient.
    const f32 dif0 ← fd0 - flat_gw[0]
    const f32 dif1 ← fd1 - flat_gw[1]
    const f32 dif2 ← fd2 - flat_gw[2]
    const f32 dif3 ← fd3 - flat_gw[3]
    print flat_gw
    print [fd0, fd1, fd2, fd3]
    print [dif0, dif1, dif2, dif3]
}
