+++
locale = "la"
+++
# dense-gqa — the REF-01-U1.4 executed proof. Multi-head attention
# with GQA KV-head sharing in gradus:attention: per-head q/k/v splits
# (num_kv_heads <= num_heads), scaled causal scores, v accumulation, head
# concatenation, and the [H*D, H*D] output projection — with the U1.3
# configurable RoPE (q/k rotated by position) — over the staged f32
# carrier; no fixed-shape constants.
#
# Two pinned config rows:
#   GQA — n_h=14, n_kv=2, head_dim=4 (the qwen2 head ratio 14:2 at a
#     compact head_dim), positions [1, 2], rope_dim 4, interleaved-pair
#     theta 1000000 (the qwen2 GGUF rope_theta fact).
#   MHA — n_kv = n_h = 14, positions [0, 0], rope_dim 4,
#     consecutive-pair base 100000 (rope identity — the exact-identity
#     anchor).
# The pinned values are the independent f64 evaluation of the documented
# multi-head formula (external Python, cross-checked against numpy),
# compared within the documented 5e-4 absolute tolerance. The same
# configs and reference values live at compile level in src/attention.proba.
#
# Execution: faber run --target fmir exempla/dense-gqa. Prints PASS for
# every pinned value (0 FAIL, exit 0). No device handle, no performance
# claim; forward-only, no autograd import.
importa ex "gradus:attention" attention
importa ex "gradus:tensor" tensor
importa ex "gradus:dtype" dtype

# Absolute tolerance for f32-vs-f64 comparison (the proba posture).
fixum f32 TOLERATIO ← (0.0005 ∷ f32)

# Build a staged tensor (test data is always valid; the cape fallback is
# unreachable).
functio tene(lista<f32> datos, lista<numerus> forma) → tensor.Tensor {
    varia tensor.Tensor t
    fac {
        t ← tensor.structa(datos, forma)
    }
    cape err {
        redde t
    }
    redde t
}

# Staged-result element read (swallow the never-firing access errors).
functio e2(tensor.Tensor r, numerus i, numerus j) → f32 {
    fac {
        redde r.accipe([i, j])
    }
    cape err {
        redde (0.0 ∷ f32)
    }
}

# The row result (swallow the never-firing construction errors).
functio mha_p(
    tensor.Tensor q, tensor.Tensor k, tensor.Tensor v, tensor.Tensor wo,
    numerus num_heads, numerus num_kv_heads, f32 scale,
    lista<numerus> positions, numerus rope_dim, attention.RopeConfigura configura
) → tensor.Tensor {
    varia tensor.Tensor r
    fac {
        r ← attention.multi_head_attention(q, k, v, wo, num_heads, num_kv_heads, scale, positions, rope_dim, configura)
        redde r
    }
    cape err {
        redde r
    }
    redde r
}

# Validated RopeConfigura (swallow the never-firing construction errors).
functio config_p(f32 base, f32 scale, attention.RopePolitica politica) → attention.RopeConfigura {
    varia attention.RopeConfigura c
    fac {
        c ← attention.structa_rope_configura(base, scale, politica)
        redde c
    }
    cape err {
        redde c
    }
    redde c
}

# One pinned element: name + observed vs the f64 reference within TOLERATIO.
# Prints "PASS" or "FAIL" (the run's executed oracle rows).
functio _pin(textus name, f32 observata, f32 expectata) → textus {
    si (observata - expectata).absolutum() ≤ TOLERATIO {
        redde name + ": PASS"
    }
    redde name + ": FAIL observed=" + (observata ↦ textus) + " expected=" + (expectata ↦ textus)
}

