# FAP-1 red 3 — byte kernel params reject today.
#
# A scalar `bytes<8>` kernel param rejects at package check (bare PKG001)
# and at Metal device admission with CODEGEN001 mir_metal_text_unsupported
# ("device aggregate value type BoundedOctets"). MLC-1 (3ff912b8c) landed
# the byte DeviceView layout + Metal kernel-param admission for the
# tensor-backed shape; the scalar byte-aggregate param still rejects —
# the rejection is pinned against the pre-kernel-admission state per the
# FAP-1 row wording.

@ kernel
fn byteview(bytes<8> w, tf32[8] a, mut tf32[1] out, u32 id) → void {
    const f32 total ← a.sum()
    out[id] ← total
}
