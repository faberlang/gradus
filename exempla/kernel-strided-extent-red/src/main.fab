+++
locale = "en"
+++

# Red: a strided `for range` over generic extents inside a `@ kernel`.
#
# decode_step's `rms_part`, `gemv_part`, `qkv_part`, `gateup_part` and `head_wide`
# give lane p every P-th element of a reduction. The loop form below is the
# declarative one; the compiler refuses it:
#
#   error[SEM008:nucleum_extent_unproven]: kernel integer extent unknown is not
#   proven to fit the portable range
#
# A guard on the extents (`if D ≤ 1000000 and Q ≥ 1 …`) and a counted-chunk form
# (`for range 0 ‥ D / Q + 1`) are refused for the same reason, so decode_step keeps
# `while k ≺ D { …; k ← k + Q }` for these six loops.

@ kernel
@ public
fn strided<size Q, size D>(tensor<f32, [D]> rpx, mut tensor<f32, [Q]> rpo) → void {
    for from rpo at [p] thread lane let e {
        mut f32 acc ← 0.0
        for range p ‥ D step Q let k {
            acc ← acc + rpx[[k]] * rpx[[k]]
        }
        rpo[[p]] ← acc
    }
}

main {
    let tensor<f32, [8]> x ← tf32[8] {}
    mut tensor<f32, [4]> o ← tf32[4] {}
    strided(x, mut o)
    print o
}
