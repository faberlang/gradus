+++
locale = "en"
+++
import from "gradus:mlp" mlp
import from "gradus:optimize" optimize

main {
    let tensor<f32, [2, 3]> x ← [1.0, 0.0, 0.0, 1.0, 1.0, 1.0] ↦ tensor<f32, [2, 3]>
    let tensor<f32, [3, 2]> target ← [1.0, -1.0, 0.5, 0.5, 1.5, -0.5] ↦ tensor<f32, [3, 2]>
    mut tensor<f32, [2, 3]> w ← [0.1, 0.0, 0.0, 0.1, 0.1, -0.1] ↦ tensor<f32, [2, 3]>
    mut tensor<f32, [2]> b ← [0.0, 0.0] ↦ tensor<f32, [2]>
    let f32 upstream ← 1.0
    for range 0‥8 let step {
        let f32 loss ← mlp.forward_linear_loss(x, w, b, target)
        print "linear-channel loss[§0]=§1"(step, loss)
        let _ grads ← mlp.forward_linear_loss_backward(x, w, b, target, mlp.nil(), upstream)
        let [_, gw, gb, _] ← grads
        let list<tensor<f32, [2, 3]>> updated ← optimize.sgd_step([w], [gw], 0.1)
        w ← updated[0]
        let list<tensor<f32, [2]>> updated_b ← optimize.sgd_step([b], [gb], 0.1)
        b ← updated_b[0]
    }
    let tensor<f32, [3, 2]> inferred ← mlp.forward_linear(x, w, b)
    let f32 loss ← mlp.forward_linear_loss(x, w, b, target)
    let f32 recomputed ← ((inferred - target) ⊙ (inferred - target)).mean()
    print "linear-channel agree=§0"(loss ≡ recomputed)
}
