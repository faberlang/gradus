+++
locale = "en"
+++
import from "gradus:mlp" mlp
import from "gradus:optimize" optimize

main {
    mut tensor<f32, [2, 3]> x ← tf32[2, 3] {}
    mut tensor<f32, [2, 2]> target ← tf32[2, 2] {}
    mut tensor<f32, [3, 2]> w ← tf32[3, 2] {}
    mut tensor<f32, [2]> b ← tf32[2] {}
    x[[0, 0]] ← 1.0
    x[[0, 1]] ← 0.0
    x[[0, 2]] ← 0.0
    x[[1, 0]] ← 1.0
    x[[1, 1]] ← 1.0
    x[[1, 2]] ← 1.0
    target[[0, 0]] ← 1.0
    target[[0, 1]] ← -1.0
    target[[1, 0]] ← 0.5
    target[[1, 1]] ← 0.5
    w[[0, 0]] ← 0.1
    w[[0, 1]] ← 0.0
    w[[1, 0]] ← 0.0
    w[[1, 1]] ← 0.1
    w[[2, 0]] ← 0.1
    w[[2, 1]] ← -0.1
    b[[0]] ← 0.0
    b[[1]] ← 0.0
    let f32 upstream ← 1.0
    for range 0‥8 let step {
        let f32 loss ← mlp.forward_linear_loss(x, w, b, target)
        print "linear-channel loss[§0]=§1"(step, loss)
        let _ grads ← mlp.forward_linear_loss_backward(x, w, b, target, mlp.nil(), upstream)
        let [_, gw, gb, _] ← grads
        let list<tensor<f32, [3, 2]>> updated ← optimize.sgd_step([w], [gw], 0.1)
        w ← updated[0]
        let list<tensor<f32, [2]>> updated_b ← optimize.sgd_step([b], [gb], 0.1)
        b ← updated_b[0]
    }
    let tensor<f32, [2, 2]> inferred ← mlp.forward_linear(x, w, b)
    let f32 loss ← mlp.forward_linear_loss(x, w, b, target)
    let f32 recomputed ← ((inferred - target) ⊙ (inferred - target)).mean()
    print "linear-channel agree=§0"(loss ≡ recomputed)
}
