# REF-01-U1.7 — executable qwen2 architecture-adapter proof.
#
# Builds bounded synthetic GGUF v3 corpora in memory carrying the canonical
# tensor table of the pinned Qwen2.5-0.5B row (layer 0 full + layer 23
# boundary, tied and untied variants), parses them through
# gradus:model/gguf_manifest, runs the typed gradus:model/dense_qwen2
# adapter (config + resolve + description_render), and prints a PASS/FAIL
# line for every canonical resolution plus the fail-closed rejection rows.
# It never opens a file or retains a model payload.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" gguf_manifest

import from "gradus:model/dense_qwen2" dense_qwen2

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# --- little-endian byte fixture helpers ------------------------------------

fn u32_le(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>]
}

fn u64_le(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>, ((n ⇒ 32) % 256) ∷ int<u8>, ((n ⇒ 40) % 256) ∷ int<u8>, ((n ⇒ 48) % 256) ∷ int<u8>, ((n ⇒ 56) % 256) ∷ int<u8>]
}

fn join_bytes(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← empty
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

# Fixture byte encoding for the finite ASCII keys/values this builder uses.
fn text_bytes(string s) → list<int<u8>> {
    switch s {
        case "general.architecture" { return [103, 101, 110, 101, 114, 97, 108, 46, 97, 114, 99, 104, 105, 116, 101, 99, 116, 117, 114, 101] }
        case "qwen2" { return [113, 119, 101, 110, 50] }
        case "llama" { return [108, 108, 97, 109, 97] }
        case "qwen2.block_count" { return [113, 119, 101, 110, 50, 46, 98, 108, 111, 99, 107, 95, 99, 111, 117, 110, 116] }
        case "qwen2.attention.head_count" { return [113, 119, 101, 110, 50, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 104, 101, 97, 100, 95, 99, 111, 117, 110, 116] }
        case "qwen2.attention.head_count_kv" { return [113, 119, 101, 110, 50, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 104, 101, 97, 100, 95, 99, 111, 117, 110, 116, 95, 107, 118] }
        case "qwen2.embedding_length" { return [113, 119, 101, 110, 50, 46, 101, 109, 98, 101, 100, 100, 105, 110, 103, 95, 108, 101, 110, 103, 116, 104] }
        case "token_embd.weight" { return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116] }
        case "output_norm.weight" { return [111, 117, 116, 112, 117, 116, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116] }
        case "output.weight" { return [111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.attn_norm.weight" { return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.attn_q.weight" { return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.attn_k.weight" { return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 107, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.attn_v.weight" { return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 118, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.attn_output.weight" { return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.ffn_norm.weight" { return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.ffn_gate.weight" { return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 103, 97, 116, 101, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.ffn_up.weight" { return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 117, 112, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.ffn_down.weight" { return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 100, 111, 119, 110, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.23.attn_norm.weight" { return [98, 108, 107, 46, 50, 51, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.23.attn_q.weight" { return [98, 108, 107, 46, 50, 51, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.23.ffn_down.weight" { return [98, 108, 107, 46, 50, 51, 46, 102, 102, 110, 95, 100, 111, 119, 110, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.1.attn_norm.weight" { return [98, 108, 107, 46, 49, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116] }
        default { return empty }
    }
}

fn str_field(string s) → list<int<u8>> {
    const list<int<u8>> b ← text_bytes(s)
    return join_bytes(u64_le(b.length()), b)
}

fn kv_field(string key, int kind, list<int<u8>> value) → list<int<u8>> {
    return join_bytes(join_bytes(str_field(key), u32_le(kind)), value)
}

fn tensor_entry(string name, list<int> shape, int kind, int offset) → list<int<u8>> {
    var list<int<u8>> out ← join_bytes(str_field(name), u32_le(shape.length()))
    for from shape const dim {
        out ← join_bytes(out, u64_le(dim))
    }
    return join_bytes(join_bytes(out, u32_le(kind)), u64_le(offset))
}

fn headerto_bytes(int tensors, int metadata) → list<int<u8>> {
    return join_bytes(join_bytes([71, 71, 85, 70], u32_le(3)), join_bytes(u64_le(tensors), u64_le(metadata)))
}

fn to_bytes(list<int<u8>> b) → bytes {
    var bytes o ← ||
    for from b const x {
        o.append(x)
    }
    return o
}

fn build_corpus(list<int<u8>> table, int alignment, int payload) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    var list<int<u8>> b ← table
    for range 0‥(data_offset - b.length()) const _ {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← to_bytes(b)
    return gguf_manifest.GgufCorpus {table = o, artifact_length = data_offset + payload, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = data_offset + payload}}
}

# Known GGML payload byte length for the fixture types (mirrors the A1a
# fixture geometry; the manifest layout() facts are asserted separately).
fn payload_length(int kind, list<int> shape) → int {
    const int elements ← shape.reduce((int elements, int d) ∴ elements * d, 1)
    switch kind {
        case 0 {
            return elements * 4
        }
        case 6 {
            return (elements / 32) * 22
        }
        case 8 {
            return (elements / 32) * 34
        }
        case 12 {
            return (elements / 256) * 144
        }
        case 14 {
            return (elements / 256) * 210
        }
        default {
            return 0
        }
    }
}

# --- canonical Qwen2.5-0.5B tensor-table fixtures ---------------------------

# Canonical tensor-table entries of the pinned Qwen2.5-0.5B row (A1b inspect
# facts): layer 0 full + layer 23 boundary. Returns (tensor entries, final
# payload offset). Callers compose header + metadata + entries.
fn tensors_table() → tuple<list<int<u8>>, int> {
    var list<int<u8>> table ← empty
    var int off ← 0
    table ← join_bytes(table, tensor_entry("token_embd.weight", [896, 151936], 8, off))
    off ← off + payload_length(8, [896, 151936])
    table ← join_bytes(table, tensor_entry("output_norm.weight", [896], 0, off))
    off ← off + payload_length(0, [896])
    table ← join_bytes(table, tensor_entry("blk.0.attn_norm.weight", [896], 0, off))
    off ← off + payload_length(0, [896])
    table ← join_bytes(table, tensor_entry("blk.0.attn_q.weight", [896, 896], 6, off))
    off ← off + payload_length(6, [896, 896])
    table ← join_bytes(table, tensor_entry("blk.0.attn_k.weight", [896, 128], 6, off))
    off ← off + payload_length(6, [896, 128])
    table ← join_bytes(table, tensor_entry("blk.0.attn_v.weight", [896, 128], 8, off))
    off ← off + payload_length(8, [896, 128])
    table ← join_bytes(table, tensor_entry("blk.0.attn_output.weight", [896, 896], 6, off))
    off ← off + payload_length(6, [896, 896])
    table ← join_bytes(table, tensor_entry("blk.0.ffn_norm.weight", [896], 0, off))
    off ← off + payload_length(0, [896])
    table ← join_bytes(table, tensor_entry("blk.0.ffn_gate.weight", [896, 4864], 6, off))
    off ← off + payload_length(6, [896, 4864])
    table ← join_bytes(table, tensor_entry("blk.0.ffn_up.weight", [896, 4864], 6, off))
    off ← off + payload_length(6, [896, 4864])
    table ← join_bytes(table, tensor_entry("blk.0.ffn_down.weight", [4864, 896], 14, off))
    off ← off + payload_length(14, [4864, 896])
    table ← join_bytes(table, tensor_entry("blk.23.attn_norm.weight", [896], 0, off))
    off ← off + payload_length(0, [896])
    table ← join_bytes(table, tensor_entry("blk.23.attn_q.weight", [896, 896], 6, off))
    off ← off + payload_length(6, [896, 896])
    table ← join_bytes(table, tensor_entry("blk.23.ffn_down.weight", [4864, 896], 12, off))
    off ← off + payload_length(12, [4864, 896])
    return tuple<list<int<u8>>, int> [table, off]
}

# --- fixture corpora (tied / untied / rejection) ----------------------------

fn qwen2_tied() → gguf_manifest.GgufCorpus {
    const tuple<list<int<u8>>, int> built ← tensors_table()
    var list<int<u8>> table ← headerto_bytes(14, 5)
    table ← join_bytes(table, kv_field("general.architecture", 8, str_field("qwen2")))
    table ← join_bytes(table, kv_field("qwen2.block_count", 4, u32_le(24)))
    table ← join_bytes(table, kv_field("qwen2.attention.head_count", 4, u32_le(14)))
    table ← join_bytes(table, kv_field("qwen2.attention.head_count_kv", 4, u32_le(2)))
    table ← join_bytes(table, kv_field("qwen2.embedding_length", 4, u32_le(896)))
    table ← join_bytes(table, built[0])
    return build_corpus(table, 32, built[1])
}

fn qwen2_untied() → gguf_manifest.GgufCorpus {
    const tuple<list<int<u8>>, int> built ← tensors_table()
    var list<int<u8>> table ← headerto_bytes(15, 5)
    table ← join_bytes(table, kv_field("general.architecture", 8, str_field("qwen2")))
    table ← join_bytes(table, kv_field("qwen2.block_count", 4, u32_le(24)))
    table ← join_bytes(table, kv_field("qwen2.attention.head_count", 4, u32_le(14)))
    table ← join_bytes(table, kv_field("qwen2.attention.head_count_kv", 4, u32_le(2)))
    table ← join_bytes(table, kv_field("qwen2.embedding_length", 4, u32_le(896)))
    table ← join_bytes(table, built[0])
    table ← join_bytes(table, tensor_entry("output.weight", [896, 151936], 8, built[1]))
    return build_corpus(table, 32, built[1] + payload_length(8, [896, 151936]))
}

# Rejection corpus: architecture is llama, not qwen2.
fn llama_corpus() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← headerto_bytes(1, 1)
    table ← join_bytes(table, kv_field("general.architecture", 8, str_field("llama")))
    table ← join_bytes(table, tensor_entry("token_embd.weight", [960, 49152], 8, 0))
    return build_corpus(table, 32, payload_length(8, [960, 49152]))
}

# --- resolution oracle (PASS/FAIL rows) --------------------------------------

fn resolve_render(gguf_manifest.GgufCorpus corpus, string name) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const dense_qwen2.DenseQwen2Config cfg ← dense_qwen2.config(m)
            const gguf_manifest.GgufTensorDescriptor t ← dense_qwen2.resolve(cfg, m, name)
            return dense_qwen2.render_description(t)
        }
        catch err {
            return err.message
        }
    }
    catch err {
        return err.message
    }
}

fn config_render(gguf_manifest.GgufCorpus corpus) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const dense_qwen2.DenseQwen2Config cfg ← dense_qwen2.config(m)
            return "§/§/§/§/§/§/§/§"(cfg.layers, cfg.heads, cfg.kv_heads, cfg.head_dim, cfg.hidden_dim, cfg.vocab, cfg.theta, cfg.tied)
        }
        catch err {
            return err.message
        }
    }
    catch err {
        return err.message
    }
}

fn case_row(string name, string observed, string expected) → string {
    if observed ≡ expected then return "§: PASS observed=§"(name, observed)
    return "§: FAIL expected=§ observed=§"(name, expected, observed)
}

main {
    print case_row("qwen2-config-tied", config_render(qwen2_tied()), "24/14/2/64/896/151936/1000000/true")
    print case_row("qwen2-config-untied", config_render(qwen2_untied()), "24/14/2/64/896/151936/1000000/false")
    print case_row("qwen2-embed_tokens", resolve_render(qwen2_tied(), "model.embed_tokens"), "token_embd.weight/896,151936/known/32")
    print case_row("qwen2-l0-input_layernorm", resolve_render(qwen2_tied(), "model.layers.0.input_layernorm"), "blk.0.attn_norm.weight/896/known/1")
    print case_row("qwen2-l0-self_attn-q_proj", resolve_render(qwen2_tied(), "model.layers.0.self_attn.q_proj"), "blk.0.attn_q.weight/896,896/known/32")
    print case_row("qwen2-l0-self_attn-k_proj", resolve_render(qwen2_tied(), "model.layers.0.self_attn.k_proj"), "blk.0.attn_k.weight/896,128/known/32")
    print case_row("qwen2-l0-self_attn-v_proj", resolve_render(qwen2_tied(), "model.layers.0.self_attn.v_proj"), "blk.0.attn_v.weight/896,128/known/32")
    print case_row("qwen2-l0-self_attn-o_proj", resolve_render(qwen2_tied(), "model.layers.0.self_attn.o_proj"), "blk.0.attn_output.weight/896,896/known/32")
    print case_row("qwen2-l0-post_attention_layernorm", resolve_render(qwen2_tied(), "model.layers.0.post_attention_layernorm"), "blk.0.ffn_norm.weight/896/known/1")
    print case_row("qwen2-l0-mlp-gate_proj", resolve_render(qwen2_tied(), "model.layers.0.mlp.gate_proj"), "blk.0.ffn_gate.weight/896,4864/known/32")
    print case_row("qwen2-l0-mlp-up_proj", resolve_render(qwen2_tied(), "model.layers.0.mlp.up_proj"), "blk.0.ffn_up.weight/896,4864/known/32")
    print case_row("qwen2-l0-mlp-down_proj", resolve_render(qwen2_tied(), "model.layers.0.mlp.down_proj"), "blk.0.ffn_down.weight/4864,896/known/256")
    print case_row("qwen2-l23-input_layernorm", resolve_render(qwen2_tied(), "model.layers.23.input_layernorm"), "blk.23.attn_norm.weight/896/known/1")
    print case_row("qwen2-l23-self_attn-q_proj", resolve_render(qwen2_tied(), "model.layers.23.self_attn.q_proj"), "blk.23.attn_q.weight/896,896/known/32")
    print case_row("qwen2-l23-mlp-down_proj", resolve_render(qwen2_tied(), "model.layers.23.mlp.down_proj"), "blk.23.ffn_down.weight/4864,896/known/256")
    print case_row("qwen2-model-norm", resolve_render(qwen2_tied(), "model.norm"), "output_norm.weight/896/known/1")
    print case_row("qwen2-lm_head-tied", resolve_render(qwen2_tied(), "lm_head"), "token_embd.weight/896,151936/known/32")
    print case_row("qwen2-lm_head-untied", resolve_render(qwen2_untied(), "lm_head"), "output.weight/896,151936/known/32")
    print case_row("qwen2-reject-unknown-name", resolve_render(qwen2_tied(), "model.foo"), "unknown canonical qwen2 tensor name: model.foo")
    print case_row("qwen2-reject-unknown-suffix", resolve_render(qwen2_tied(), "model.layers.0.self_attn.x_proj"), "unknown canonical qwen2 layer tensor suffix: .self_attn.x_proj")
    print case_row("qwen2-reject-layer-range", resolve_render(qwen2_tied(), "model.layers.24.input_layernorm"), "layer index out of range for canonical tensor: model.layers.24.input_layernorm")
    print case_row("qwen2-reject-missing-tensor", resolve_render(qwen2_tied(), "model.layers.1.input_layernorm"), "canonical model.layers.1.input_layernorm missing from manifest: blk.1.attn_norm.weight")
    print case_row("qwen2-reject-architecture", config_render(llama_corpus()), "architecture is not qwen2: llama")
}
