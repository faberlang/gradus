+++
locale = "en"
+++
# REF-01-U1.7 — executable qwen2 architecture-adapter proof.
#
# Builds bounded synthetic GGUF v3 corpora in memory carrying the canonical
# tensor table of the pinned Qwen2.5-0.5B row (layer 0 full + layer 23
# boundary, tied and untied variants), parses them through
# gradus:model/gguf_manifest, runs the typed gradus:model/dense_qwen2
# adapter (configura + resolve + descriptio_render), and prints a PASS/FAIL
# line for every canonical resolution plus the fail-closed rejection rows.
# It never opens a file or retains a model payload.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" manifestum

import from "gradus:model/dense_qwen2" dense_qwen2

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn _u8(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>]
}

fn _u16(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>]
}

fn _u32(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>]
}

fn _u64(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>, ((n ⇒ 32) % 256) ∷ int<u8>, ((n ⇒ 40) % 256) ∷ int<u8>, ((n ⇒ 48) % 256) ∷ int<u8>, ((n ⇒ 56) % 256) ∷ int<u8>]
}

fn _iunge(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

# Fixture byte encoding for the finite ASCII keys/values this builder uses.
fn _textus_bytes(string s) → list<int<u8>> {
    if s ≡ "general.architecture" then return [103, 101, 110, 101, 114, 97, 108, 46, 97, 114, 99, 104, 105, 116, 101, 99, 116, 117, 114, 101]
    if s ≡ "qwen2" then return [113, 119, 101, 110, 50]
    if s ≡ "llama" then return [108, 108, 97, 109, 97]
    if s ≡ "qwen2.block_count" then return [113, 119, 101, 110, 50, 46, 98, 108, 111, 99, 107, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen2.attention.head_count" then return [113, 119, 101, 110, 50, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 104, 101, 97, 100, 95, 99, 111, 117, 110, 116]
    if s ≡ "qwen2.attention.head_count_kv" then return [113, 119, 101, 110, 50, 46, 97, 116, 116, 101, 110, 116, 105, 111, 110, 46, 104, 101, 97, 100, 95, 99, 111, 117, 110, 116, 95, 107, 118]
    if s ≡ "qwen2.embedding_length" then return [113, 119, 101, 110, 50, 46, 101, 109, 98, 101, 100, 100, 105, 110, 103, 95, 108, 101, 110, 103, 116, 104]
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "output_norm.weight" then return [111, 117, 116, 112, 117, 116, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "output.weight" then return [111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_norm.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_q.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_k.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 107, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_v.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 118, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_output.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_norm.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_gate.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 103, 97, 116, 101, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_up.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 117, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_down.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 100, 111, 119, 110, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.23.attn_norm.weight" then return [98, 108, 107, 46, 50, 51, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.23.attn_q.weight" then return [98, 108, 107, 46, 50, 51, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.23.ffn_down.weight" then return [98, 108, 107, 46, 50, 51, 46, 102, 102, 110, 95, 100, 111, 119, 110, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.1.attn_norm.weight" then return [98, 108, 107, 46, 49, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    return []
}

fn _str(string s) → list<int<u8>> {
    const list<int<u8>> b ← _textus_bytes(s)
    return _iunge(_u64(b.length()), b)
}

fn _kv(string key, int typo, list<int<u8>> value) → list<int<u8>> {
    return _iunge(_iunge(_str(key), _u32(typo)), value)
}

fn _tensor(string name, list<int> forma, int typo, int offset) → list<int<u8>> {
    var list<int<u8>> out ← _iunge(_str(name), _u32(forma.length()))
    for from forma const dim {
        out ← _iunge(out, _u64(dim))
    }
    return _iunge(_iunge(out, _u32(typo)), _u64(offset))
}

fn _caput(int tensorum, int metadata) → list<int<u8>> {
    return _iunge(_iunge([71, 71, 85, 70], _u32(3)), _iunge(_u64(tensorum), _u64(metadata)))
}

fn _octeti(list<int<u8>> b) → bytes {
    var bytes o ← ||
    for from b const x {
        o.append(x)
    }
    return o
}

fn _corpus(list<int<u8>> table, int concordatio, int payload) → manifestum.CorpusGguf {
    const int data_offset ← (((table.length() + concordatio) - 1) / concordatio) * concordatio
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← _octeti(b)
    return manifestum.CorpusGguf {tabula = o, longitudo_artifacti = data_offset + payload, identitas = artifact.IdentitasContenuti {algorithmus = "sha-256", digestio = F_DIGEST, longitudo = data_offset + payload}}
}

# Known GGML payload byte length for the fixture types (mirrors the A1a
# fixture geometry; the manifest layout() facts are asserted separately).
fn _longitudo_payloadis(int typo, list<int> forma) → int {
    var int elementa ← 1
    for from forma const d {
        elementa ← elementa * d
    }
    if typo ≡ 0 then return elementa * 4
    if typo ≡ 6 then return (elementa / 32) * 22
    if typo ≡ 8 then return (elementa / 32) * 34
    if typo ≡ 12 then return (elementa / 256) * 144
    if typo ≡ 14 then return (elementa / 256) * 210
    return 0
}

# Canonical tensor-table entries of the pinned Qwen2.5-0.5B row (A1b inspect
# facts): layer 0 full + layer 23 boundary. Returns (tensor entries, final
# payload offset). Callers compose header + metadata + entries.
fn _tensores_tabula() → tuple<list<int<u8>>, int> {
    var list<int<u8>> table ← vacua
    var int off ← 0
    table ← _iunge(table, _tensor("token_embd.weight", [896, 151936], 8, off))
    off ← off + _longitudo_payloadis(8, [896, 151936])
    table ← _iunge(table, _tensor("output_norm.weight", [896], 0, off))
    off ← off + _longitudo_payloadis(0, [896])
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [896], 0, off))
    off ← off + _longitudo_payloadis(0, [896])
    table ← _iunge(table, _tensor("blk.0.attn_q.weight", [896, 896], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 896])
    table ← _iunge(table, _tensor("blk.0.attn_k.weight", [896, 128], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 128])
    table ← _iunge(table, _tensor("blk.0.attn_v.weight", [896, 128], 8, off))
    off ← off + _longitudo_payloadis(8, [896, 128])
    table ← _iunge(table, _tensor("blk.0.attn_output.weight", [896, 896], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 896])
    table ← _iunge(table, _tensor("blk.0.ffn_norm.weight", [896], 0, off))
    off ← off + _longitudo_payloadis(0, [896])
    table ← _iunge(table, _tensor("blk.0.ffn_gate.weight", [896, 4864], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 4864])
    table ← _iunge(table, _tensor("blk.0.ffn_up.weight", [896, 4864], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 4864])
    table ← _iunge(table, _tensor("blk.0.ffn_down.weight", [4864, 896], 14, off))
    off ← off + _longitudo_payloadis(14, [4864, 896])
    table ← _iunge(table, _tensor("blk.23.attn_norm.weight", [896], 0, off))
    off ← off + _longitudo_payloadis(0, [896])
    table ← _iunge(table, _tensor("blk.23.attn_q.weight", [896, 896], 6, off))
    off ← off + _longitudo_payloadis(6, [896, 896])
    table ← _iunge(table, _tensor("blk.23.ffn_down.weight", [4864, 896], 12, off))
    off ← off + _longitudo_payloadis(12, [4864, 896])
    return tuple<list<int<u8>>, int> [table, off]
}

fn _qwen2_ligata() → manifestum.CorpusGguf {
    const tuple<list<int<u8>>, int> built ← _tensores_tabula()
    var list<int<u8>> table ← _caput(14, 5)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen2")))
    table ← _iunge(table, _kv("qwen2.block_count", 4, _u32(24)))
    table ← _iunge(table, _kv("qwen2.attention.head_count", 4, _u32(14)))
    table ← _iunge(table, _kv("qwen2.attention.head_count_kv", 4, _u32(2)))
    table ← _iunge(table, _kv("qwen2.embedding_length", 4, _u32(896)))
    table ← _iunge(table, built[0])
    return _corpus(table, 32, built[1])
}

fn _qwen2_soluta() → manifestum.CorpusGguf {
    const tuple<list<int<u8>>, int> built ← _tensores_tabula()
    var list<int<u8>> table ← _caput(15, 5)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen2")))
    table ← _iunge(table, _kv("qwen2.block_count", 4, _u32(24)))
    table ← _iunge(table, _kv("qwen2.attention.head_count", 4, _u32(14)))
    table ← _iunge(table, _kv("qwen2.attention.head_count_kv", 4, _u32(2)))
    table ← _iunge(table, _kv("qwen2.embedding_length", 4, _u32(896)))
    table ← _iunge(table, built[0])
    table ← _iunge(table, _tensor("output.weight", [896, 151936], 8, built[1]))
    return _corpus(table, 32, built[1] + _longitudo_payloadis(8, [896, 151936]))
}

# Rejection corpus: architecture is llama, not qwen2.
fn _llama() → manifestum.CorpusGguf {
    var list<int<u8>> table ← _caput(1, 1)
    table ← _iunge(table, _kv("general.architecture", 8, _str("llama")))
    table ← _iunge(table, _tensor("token_embd.weight", [960, 49152], 8, 0))
    return _corpus(table, 32, _longitudo_payloadis(8, [960, 49152]))
}

fn _resolve_render(manifestum.CorpusGguf corpus, string nomen) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const dense_qwen2.ConfiguraDensaQwen2 cfg ← dense_qwen2.configura(m)
            const manifestum.DescriptioTensorisGguf t ← dense_qwen2.resolve(cfg, m, nomen)
            return dense_qwen2.descriptio_render(t)
        }
        catch err {
            return dense_qwen2.causa(err)
        }
    }
    catch err {
        return manifestum.causa(err)
    }
}

fn _configura_render(manifestum.CorpusGguf corpus) → string {
    do {
        const manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        do {
            const dense_qwen2.ConfiguraDensaQwen2 cfg ← dense_qwen2.configura(m)
            return ((((((((((((((cfg.strata ↦ string) + "/") + (cfg.capita ↦ string)) + "/") + (cfg.capita_kv ↦ string)) + "/") + (cfg.dimensio_capitis ↦ string)) + "/") + (cfg.dimensio_occulta ↦ string)) + "/") + (cfg.vocabulum ↦ string)) + "/") + (cfg.theta ↦ string)) + "/") + (cfg.ligatum ↦ string)
        }
        catch err {
            return dense_qwen2.causa(err)
        }
    }
    catch err {
        return manifestum.causa(err)
    }
}

fn _case(string name, string observed, string expected) → string {
    if observed ≡ expected then return (name + ": PASS observed=") + observed
    return (((name + ": FAIL expected=") + expected) + " observed=") + observed
}

main {
    print _case("qwen2-config-tied", _configura_render(_qwen2_ligata()), "24/14/2/64/896/151936/1000000/true")
    print _case("qwen2-config-untied", _configura_render(_qwen2_soluta()), "24/14/2/64/896/151936/1000000/false")
    print _case("qwen2-embed_tokens", _resolve_render(_qwen2_ligata(), "model.embed_tokens"), "token_embd.weight/896,151936/known/32")
    print _case("qwen2-l0-input_layernorm", _resolve_render(_qwen2_ligata(), "model.layers.0.input_layernorm"), "blk.0.attn_norm.weight/896/known/1")
    print _case("qwen2-l0-self_attn-q_proj", _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.q_proj"), "blk.0.attn_q.weight/896,896/known/32")
    print _case("qwen2-l0-self_attn-k_proj", _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.k_proj"), "blk.0.attn_k.weight/896,128/known/32")
    print _case("qwen2-l0-self_attn-v_proj", _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.v_proj"), "blk.0.attn_v.weight/896,128/known/32")
    print _case("qwen2-l0-self_attn-o_proj", _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.o_proj"), "blk.0.attn_output.weight/896,896/known/32")
    print _case("qwen2-l0-post_attention_layernorm", _resolve_render(_qwen2_ligata(), "model.layers.0.post_attention_layernorm"), "blk.0.ffn_norm.weight/896/known/1")
    print _case("qwen2-l0-mlp-gate_proj", _resolve_render(_qwen2_ligata(), "model.layers.0.mlp.gate_proj"), "blk.0.ffn_gate.weight/896,4864/known/32")
    print _case("qwen2-l0-mlp-up_proj", _resolve_render(_qwen2_ligata(), "model.layers.0.mlp.up_proj"), "blk.0.ffn_up.weight/896,4864/known/32")
    print _case("qwen2-l0-mlp-down_proj", _resolve_render(_qwen2_ligata(), "model.layers.0.mlp.down_proj"), "blk.0.ffn_down.weight/4864,896/known/256")
    print _case("qwen2-l23-input_layernorm", _resolve_render(_qwen2_ligata(), "model.layers.23.input_layernorm"), "blk.23.attn_norm.weight/896/known/1")
    print _case("qwen2-l23-self_attn-q_proj", _resolve_render(_qwen2_ligata(), "model.layers.23.self_attn.q_proj"), "blk.23.attn_q.weight/896,896/known/32")
    print _case("qwen2-l23-mlp-down_proj", _resolve_render(_qwen2_ligata(), "model.layers.23.mlp.down_proj"), "blk.23.ffn_down.weight/4864,896/known/256")
    print _case("qwen2-model-norm", _resolve_render(_qwen2_ligata(), "model.norm"), "output_norm.weight/896/known/1")
    print _case("qwen2-lm_head-tied", _resolve_render(_qwen2_ligata(), "lm_head"), "token_embd.weight/896,151936/known/32")
    print _case("qwen2-lm_head-untied", _resolve_render(_qwen2_soluta(), "lm_head"), "output.weight/896,151936/known/32")
    print _case("qwen2-reject-unknown-name", _resolve_render(_qwen2_ligata(), "model.foo"), "unknown canonical qwen2 tensor name: model.foo")
    print _case("qwen2-reject-unknown-suffix", _resolve_render(_qwen2_ligata(), "model.layers.0.self_attn.x_proj"), "unknown canonical qwen2 layer tensor suffix: .self_attn.x_proj")
    print _case("qwen2-reject-layer-range", _resolve_render(_qwen2_ligata(), "model.layers.24.input_layernorm"), "layer index out of range for canonical tensor: model.layers.24.input_layernorm")
    print _case("qwen2-reject-missing-tensor", _resolve_render(_qwen2_ligata(), "model.layers.1.input_layernorm"), "canonical model.layers.1.input_layernorm missing from manifest: blk.1.attn_norm.weight")
    print _case("qwen2-reject-architecture", _configura_render(_llama()), "architecture is not qwen2: llama")
}
