+++
locale = "en"
+++

# Red: a generic class with tensor fields cannot be the host-side scratch type of
# `decode_token.layer_wide`.
#
# `layer_wide` takes 13 caller-owned scratch tensors. Grouping
# them in `class WideScratch<size D, ..., size R>` would shrink the signature, but
# the strict engine refuses the host half of any program that builds such a class:
#
#   ENGINE001 refused: clif-jit declined the host half of this kernel program:
#   unsupported type
#
# (A non-generic class with literal extents is accepted, as in
# exempla/decode-token-bench-metal; only the generic form is declined. Gradus is
# generic over the model's extents, so it cannot spell the literal form.)

import from "gradus:decode_step" ds

class Scratch<size D, size Q> {
    mut tensor<f32, [Q]> rp
}

main {
    let tensor<f32, [8]> x ← tf32[8] {}
    mut tensor<f32, [4]> rp ← tf32[4] {}
    mut Scratch<8, 4> s ← Scratch<8, 4> { rp = rp }
    ds.rms_part(x, mut s.rp)
    print s.rp[[0]]
}
