+++
locale = "en"
+++
# G2 public generate route on SmolLM2-360M.
#
# Same admitted weights and pinned prompt as G1 (dense-decode-smollm2).
# G1's unrestrained greedy continuation was [30, 2, 198] — it deliberately
# skipped EOG-stop. The default generate_dense path applies EOG-stop:
# SmolLM2 EOS=2 is in the admitted set {0, 2}, so the run must halt at
# [30, 2] (the EOS token is emitted, then the loop stops). First token
# remains the GATE 13 / GI2 golden 30.
#
# A second run uses generate_dense_with_stop(IgnoreEos): EOG ids are
# suppressed from sampling (llama.cpp ignore_eos) and the loop runs to
# max_tokens=16. The U5 golden is
# [30, 198, 198, 504, 808, 6330, 314, 253, 2232, 4814, 282, 1027, 28, 979, 260, 1796].

import from "gradus:attention" attention
import from "gradus:cache" kv
import from "gradus:decode" decode
import from "gradus:generation" generation
import from "gradus:model/artifact" artifact
import from "gradus:model/dense" dense
import from "gradus:model/gguf_manifest" gguf_manifest
import from "gradus:model/tensor_payload" tensor_payload
import from "gradus:model/tensor_view" tensor_view
import from "gradus:tensor" tensor
import from "gradus:tokenizer" tokenizer
import from "norma:processus" processus
import from "norma:solum" solum

const string PINNED_PATH ← "/Users/ianzepp/ai/models/SmolLM2-360M-Instruct-Q4_K_M.gguf"
const string PINNED_DIGEST ← "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2"
const int PINNED_BYTES ← 270590880
const int PINNED_DATA ← 1787040
const list<int> PINNED_TOKENS ← [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767]
const int GOLDEN_TOP1 ← 30
const list<int> GOLDEN_CONTINUE ← [30, 198, 198, 504, 808, 6330, 314, 253, 2232, 4814, 282, 1027, 28, 979, 260, 1796]
const int VOCAB ← 49152
const int SLICE_CAP ← 16777216
const int GENERATE ← 3
const int GENERATE_CONTINUE ← 16
const int EOG_SMOLLM2 ← 2

union DecodeRunError {
    BadArguments { string message },
    BadManifest { string message },
    BadAdapter { string message },
    BadBinding { string message },
    BadSlice { string message },
    BadForward { string message }
}

fn message(DecodeRunError e) → string {
    match e {
        case BadArguments const message { return message }
        case BadManifest const message { return message }
        case BadAdapter const message { return message }
        case BadBinding const message { return message }
        case BadSlice const message { return message }
        case BadForward const message { return message }
    }
}

fn _range(string via, int total, int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    if start < 0 or length < 0 or start > total - length {
        throw variant BadSource {message = "range request exceeds the artifact"}
    }
    const bytes bytes ← solum.read_range(via, start, length)
    if bytes.length() ≠ length {
        throw variant BadSource {message = "short range read"}
    }
    return bytes
}

fn _prefix_range(list<int> prefix, int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    if start < 0 or length < 0 or start > prefix.length() - length {
        throw variant BadSource {message = "inspection attempted to read the tensor data region"}
    }
    const list<int> segment ← prefix.slice(start, start + length)
    const bytes bytes ← segment ↦ bytes
    return bytes
}

fn _ends(string s, string tail) → bool {
    if tail.length() ≻ s.length() then return false
    return s.slice(s.length() - tail.length(), s.length()) ≡ tail
}

fn _slot(string name) → int {
    if _ends(name, ".input_layernorm") then return 0
    if _ends(name, ".self_attn.q_proj") then return 1
    if _ends(name, ".self_attn.k_proj") then return 2
    if _ends(name, ".self_attn.v_proj") then return 3
    if _ends(name, ".self_attn.o_proj") then return 4
    if _ends(name, ".post_attention_layernorm") then return 5
    if _ends(name, ".mlp.gate_proj") then return 6
    if _ends(name, ".mlp.up_proj") then return 7
    if _ends(name, ".mlp.down_proj") then return 8
    return -1
}

fn _first_divergence(list<int> expected, list<int> actualia) → int {
    var int i ← 0
    while i ≺ expected.length() or i ≺ actualia.length() {
        if (expected.get(i) coalesce (0 - 1)) ≠ (actualia.get(i) coalesce (0 - 1)) {
            return i
        }
        i ← i + 1
    }
    return 0 - 1
}

fn _ids_text(list<int> ids) → string {
    var string out ← "["
    var int i ← 0
    while i ≺ ids.length() {
        if i ≻ 0 {
            out ← out + ", "
        }
        out ← out + ((ids.get(i) coalesce 0) ↦ string)
        i ← i + 1
    }
    return out + "]"
}

fn _block_elements(tensor_view.TensorView v) → int {
    match v.layout {
        case gguf_manifest.Known const elements_per_block, bytes_per_block, byte_length {
            return elements_per_block
        }
        case gguf_manifest.Unknown const kind {
            return 0
        }
    }
}

fn _window(int remaining, int block) → int {
    if remaining ≤ SLICE_CAP then return remaining
    const int aligned ← (SLICE_CAP / block) * block
    if aligned ≺ block then return block
    return aligned
}

fn _limits(gguf_manifest.GgufManifest m, string gguf_name) → tuple<int, int> ⇥ DecodeRunError {
    do {
        return gguf_manifest.payload_limit(m, gguf_name)
    }
    catch err {
        throw variant BadManifest {message = "payload range failed for " + gguf_name + ": " + err.message}
    }
}

fn _bind(gguf_manifest.GgufManifest m, tensor_payload.TensorPayload p) → tensor_view.TensorView ⇥ DecodeRunError {
    do {
        return tensor_view.links(m, p)
    }
    catch err {
        throw variant BadBinding {message = "view bind failed for " + p.name + ": " + err.message}
    }
}

fn _slice(
    tensor_view.TensorView v,
    int off,
    int n,
    (int, int) → bytes ⇥ gguf_manifest.GgufManifestError source
) → list<f32> ⇥ DecodeRunError {
    do {
        return tensor_view.materialize_slice(v, off, n, source)
    }
    catch err {
        throw variant BadSlice {message = "window materialize failed for " + v.name + ": " + err.message}
    }
}

fn _tensor(list<f32> data, list<int> shape) → tensor.Tensor ⇥ DecodeRunError {
    do {
        return tensor.construct(data, shape)
    }
    catch err {
        throw variant BadSlice {message = "tensor construct failed: " + err.message}
    }
}

fn _materialize(
    string via,
    int total,
    gguf_manifest.GgufManifest m,
    string gguf_name
) → tensor.Tensor ⇥ DecodeRunError {
    const tuple<int, int> limit ← _limits(m, gguf_name)
    const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
        name = gguf_name,
        absolute_start = limit[0],
        length = limit[1],
        bytes = ||
    }
    const tensor_view.TensorView v ← _bind(m, p)
    const int block ← _block_elements(v)
    if block ≺ 1 {
        throw variant BadSlice {message = "tensor layout has no block size: " + gguf_name}
    }
    var list<f32> data ← empty
    var int off ← 0
    while off ≺ v.elements {
        const int n ← _window(v.elements - off, block)
        const list<f32> part ← _slice(
            v,
            off,
            n,
            (int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _range(via, total, start, length)
        )
        for from part const x {
            data.append(x)
        }
        off ← off + n
    }
    return _tensor(data, v.shape)
}

fn _gguf_name(string family, int layer) → string ⇥ DecodeRunError {
    if family ≡ "model.embed_tokens" then return "token_embd.weight"
    if family ≡ "model.norm" then return "output_norm.weight"
    if family ≡ "lm_head" then return "token_embd.weight"
    if layer ≺ 0 or layer ≥ 32 {
        throw variant BadAdapter {message = "layer index outside the frozen llama layer range: " + (layer ↦ string)}
    }
    if family ≡ "model.layers.input_layernorm" then return ("blk." + (layer ↦ string)) + ".attn_norm.weight"
    if family ≡ "model.layers.self_attn.q_proj" then return ("blk." + (layer ↦ string)) + ".attn_q.weight"
    if family ≡ "model.layers.self_attn.k_proj" then return ("blk." + (layer ↦ string)) + ".attn_k.weight"
    if family ≡ "model.layers.self_attn.v_proj" then return ("blk." + (layer ↦ string)) + ".attn_v.weight"
    if family ≡ "model.layers.self_attn.o_proj" then return ("blk." + (layer ↦ string)) + ".attn_output.weight"
    if family ≡ "model.layers.post_attention_layernorm" then return ("blk." + (layer ↦ string)) + ".ffn_norm.weight"
    if family ≡ "model.layers.mlp.gate_proj" then return ("blk." + (layer ↦ string)) + ".ffn_gate.weight"
    if family ≡ "model.layers.mlp.up_proj" then return ("blk." + (layer ↦ string)) + ".ffn_up.weight"
    if family ≡ "model.layers.mlp.down_proj" then return ("blk." + (layer ↦ string)) + ".ffn_down.weight"
    throw variant BadAdapter {message = "unknown canonical tensor name: " + family}
}

fn _kmajor_to_linear(tensor.Tensor t) → tensor.Tensor ⇥ DecodeRunError {
    const list<int> f ← t.shape()
    if f.length() ≠ 2 {
        throw variant BadAdapter {message = "linear weight must be rank 2"}
    }
    const int k ← f.get(0) coalesce 1
    const int n ← f.get(1) coalesce 1
    var list<f32> out ← empty
    var int i ← 0
    while i ≺ k {
        var int j ← 0
        while j ≺ n {
            out.append(t.data.get(j * k + i) coalesce 0.0 ∷ f32)
            j ← j + 1
        }
        i ← i + 1
    }
    return _tensor(out, [k, n])
}

fn _linear_family(string family) → bool {
    if family ≡ "lm_head" then return true
    if _ends(family, ".self_attn.q_proj") then return true
    if _ends(family, ".self_attn.k_proj") then return true
    if _ends(family, ".self_attn.v_proj") then return true
    if _ends(family, ".self_attn.o_proj") then return true
    if _ends(family, ".mlp.gate_proj") then return true
    if _ends(family, ".mlp.up_proj") then return true
    if _ends(family, ".mlp.down_proj") then return true
    return false
}

fn _load_one(
    string via,
    int total,
    gguf_manifest.GgufManifest m,
    string family,
    int layer
) → tensor.Tensor ⇥ DecodeRunError {
    const string gguf_name ← _gguf_name(family, layer)
    const tensor.Tensor stored ← _materialize(via, total, m, gguf_name)
    if _linear_family(family) {
        return _kmajor_to_linear(stored)
    }
    return stored
}

fn _lookup(
    string name,
    int layer,
    tensor.Tensor embed,
    tensor.Tensor norm_s,
    list<list<tensor.Tensor>> strata
) → tensor.Tensor ⇥ dense.DenseError {
    if name ≡ "model.embed_tokens" then return embed
    if name ≡ "model.norm" then return norm_s
    if layer ≺ 0 or layer ≥ strata.length() {
        throw variant MissingTensor {message = "layer out of range: " + (layer ↦ string)}
    }
    const int slot ← _slot(name)
    if slot ≺ 0 {
        throw variant MissingTensor {message = "unknown canonical tensor: " + name}
    }
    var list<tensor.Tensor> missing ← empty
    const list<tensor.Tensor> row ← strata.get(layer) coalesce missing
    if slot ≥ row.length() {
        throw variant MissingTensor {message = "layer slot missing: " + name}
    }
    const tensor.Tensor t ← row.get(slot) coalesce embed
    return t
}

fn _indices(int n) → list<int> {
    var list<int> out ← empty
    var int i ← 0
    while i ≺ n {
        out.append(i)
        i ← i + 1
    }
    return out
}

main {
    const list<string> args ← processus.argv() ↦ list<string>
    var string via ← PINNED_PATH
    var int expected_data ← PINNED_DATA
    var string digest ← PINNED_DIGEST
    if args.length() ≥ 3 {
        via ← args.get(0) coalesce PINNED_PATH
        do {
            expected_data ← (args.get(1) coalesce "0") ↦ int
            digest ← args.get(2) coalesce PINNED_DIGEST
        }
        catch err {
            panic "usage: dense-decode-smollm2 <path> <data-offset> <sha256>"
        }
    }

    print "policy: G2 generate_dense with EOG-stop {0, 2}"
    print "oracle: first greedy token == 30; EOG-stop yields [30, 2] (G1 unrestrained was [30, 2, 198]; SmolLM2 EOS=2)"
    print "engine: compiled rust (faber build --target rust; execute the printed binary)"
    print "model.path=" + via

    const int total ← solum.byte_length(via)
    print "model.bytes=" + (total ↦ string)
    if total ≠ PINNED_BYTES {
        panic "model byte length mismatch: observed=" + (total ↦ string) + " expected=" + (PINNED_BYTES ↦ string)
    }

    const bytes prefix_bytes ← solum.read_range(via, 0, expected_data)
    if prefix_bytes.length() ≠ expected_data {
        panic "file adapter returned a short table-prefix read"
    }
    const value prefix_payload ← prefix_bytes ↦ value
    const list<int> prefix ← prefix_payload ↦ list<int>
    const artifact.ContentIdentity identity ← artifact.ContentIdentity {
        algorithm = "sha-256",
        digest = digest,
        length = total
    }

    var gguf_manifest.GgufManifest admitted ← gguf_manifest.GgufManifest {
        identity = identity,
        version = 0,
        alignment = 0,
        data_start = 0,
        artifact_length = 0,
        metadata = empty,
        tensors = empty
    }
    do {
        admitted ← gguf_manifest.inspect(
            (int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _prefix_range(prefix, start, length),
            total,
            identity
        )
    }
    catch err {
        panic "manifest admission failed: " + err.message
    }

    var tensor.Tensor embed ← tensor.default()
    var tensor.Tensor norm_s ← tensor.default()
    do {
        embed ← _load_one(via, total, admitted, "model.embed_tokens", 0)
        norm_s ← _load_one(via, total, admitted, "model.norm", 0)
    }
    catch err {
        panic "embed/norm load failed: " + message(err)
    }

    const list<string> families ← [
        "model.layers.input_layernorm",
        "model.layers.self_attn.q_proj",
        "model.layers.self_attn.k_proj",
        "model.layers.self_attn.v_proj",
        "model.layers.self_attn.o_proj",
        "model.layers.post_attention_layernorm",
        "model.layers.mlp.gate_proj",
        "model.layers.mlp.up_proj",
        "model.layers.mlp.down_proj"
    ]
    var list<list<tensor.Tensor>> strata ← empty
    var int layer ← 0
    while layer ≺ 32 {
        var list<tensor.Tensor> row ← empty
        var int f ← 0
        while f ≺ families.length() {
            do {
                row.append(_load_one(via, total, admitted, families.get(f) coalesce "", layer))
            }
            catch err {
                panic ("layer " + (layer ↦ string)) + " " + message(err)
            }
            f ← f + 1
        }
        strata.append(row)
        print "loaded layer " + (layer ↦ string)
        layer ← layer + 1
    }

    var attention.RopeConfig rope ← attention.default()
    do {
        rope ← attention.construct_rope_config(100000.0 ∷ f32, 1.0 ∷ f32, attention.consecutive_policy())
    }
    catch err {
        panic "rope config failed: " + err.message
    }

    const dense.DenseConfig cfg ← dense.DenseConfig {
        layers = 32,
        heads = 15,
        kv_heads = 5,
        head_dim = 64,
        hidden_dim = 960,
        vocab = VOCAB,
        tied = true
    }

    var kv.KVStructure structure ← kv.default_kv_structure()
    do {
        const kv.LayerSet set ← kv.construct_layer_set(_indices(32), kv.dense_structure(), 5, 64)
        var list<kv.LayerSet> sets ← empty
        sets.append(set)
        structure ← kv.construct_kv_structure(
            sets,
            kv.kv_dtype_f32(),
            kv.kv_dtype_f32(),
            kv.v_layout_transposed(),
            kv.sharing_gqa(),
            kv.attention_classic(),
            15,
            8192,
            8192
        )
    }
    catch err {
        panic "kv structure failed: " + err.message
    }

    var list<kv.KVCache> layers ← empty
    do {
        layers ← dense.empty_caches(structure, "smollm2", "360m", "f32-staged", "smollm")
    }
    catch err {
        panic "empty caches failed: " + err.message
    }
    print "cache layers=" + (layers.length() ↦ string) + " dim=" + (((layers.get(0) coalesce kv.default()).dimension()) ↦ string)

    var generation.GenerationConfig gen ← generation.default()
    do {
        gen ← generation.construct_generation(8192, 1, GENERATE, 1, 0.0 ∷ f32, 0, 1.0 ∷ f32, 0.0 ∷ f32, 1.0 ∷ f32)
    }
    catch err {
        panic "generation config failed: " + err.message
    }
    const generation.DenseEngine engine ← generation.construct_dense_engine(cfg, 0.00001 ∷ f32, 0.125 ∷ f32, 64, rope)

    var list<int> generated ← empty
    do {
        generated ← generation.generate_dense(
            gen,
            PINNED_TOKENS,
            engine,
            (string n, int s) → tensor.Tensor ⇥ dense.DenseError ∴ _lookup(n, s, embed, norm_s, strata),
            layers,
            decode.fresh_cancellation()
        )
    }
    catch err {
        panic "generate_dense failed: " + err.message
    }

    const int first ← generated.get(0) coalesce (0 - 1)
    const int last_tok ← generated.get(generated.length() - 1) coalesce (0 - 1)
    print "first_sampled=" + (first ↦ string)
    print "golden_top1=" + (GOLDEN_TOP1 ↦ string)
    print "first_matches=" + ((first ≡ GOLDEN_TOP1) ↦ string)
    print "generated=" + _ids_text(generated)
    print "n=" + (generated.length() ↦ string)
    print "eog_token=" + (EOG_SMOLLM2 ↦ string)
    print "eog_stop=" + ((generated.length() ≺ GENERATE and tokenizer.is_eog(last_tok)) ↦ string)
    print "g1_unrestrained=[30, 2, 198]"
    print "policy: EOG-stop emits SmolLM2 EOS=2 then halts; max_tokens is a ceiling"

    var string divergence ← "none"
    if first ≠ GOLDEN_TOP1 {
        divergence ← (("first token " + (first ↦ string)) + " vs golden ") + (GOLDEN_TOP1 ↦ string)
    }
    else {
        if generated.length() ≠ 2 or last_tok ≠ EOG_SMOLLM2 {
            if generated.length() ≡ GENERATE {
                divergence ← "EOG did not fire; N-token path " + _ids_text(generated)
            }
            else {
                divergence ← "EOG-stop sequence " + _ids_text(generated) + " != [30, 2]"
            }
        }
    }
    print "first_divergence=" + divergence
    if divergence ≡ "none" {
        print "GENERATE: PASS"
    }
    else {
        print "GENERATE: FAIL"
    }

    var list<kv.KVCache> continue_layers ← empty
    do {
        continue_layers ← dense.empty_caches(structure, "smollm2", "360m", "f32-staged", "smollm")
    }
    catch err {
        panic "empty caches (ignore_eos) failed: " + err.message
    }
    var generation.GenerationConfig gen_continue ← generation.default()
    do {
        gen_continue ← generation.construct_generation(8192, 1, GENERATE_CONTINUE, 1, 0.0 ∷ f32, 0, 1.0 ∷ f32, 0.0 ∷ f32, 1.0 ∷ f32)
    }
    catch err {
        panic "generation config (ignore_eos) failed: " + err.message
    }
    print "policy: generate_dense_with_stop IgnoreEos (llama.cpp ignore_eos)"
    var list<int> continued ← empty
    do {
        continued ← generation.generate_dense_with_stop(
            gen_continue,
            PINNED_TOKENS,
            engine,
            (string n, int s) → tensor.Tensor ⇥ dense.DenseError ∴ _lookup(n, s, embed, norm_s, strata),
            continue_layers,
            decode.fresh_cancellation(),
            generation.ignore_eos()
        )
    }
    catch err {
        panic "generate_dense_with_stop failed: " + err.message
    }
    print "continued=" + _ids_text(continued)
    print "continued_n=" + (continued.length() ↦ string)
    print "golden_continue=" + _ids_text(GOLDEN_CONTINUE)
    const int continue_div ← _first_divergence(GOLDEN_CONTINUE, continued)
    if continue_div ≺ 0 {
        print "continue_first_divergence=none"
        print "CONTINUE: PASS"
    }
    else {
        const int got ← continued.get(continue_div) coalesce (0 - 1)
        const int want ← GOLDEN_CONTINUE.get(continue_div) coalesce (0 - 1)
        print "continue_first_divergence=position " + (continue_div ↦ string) + " got " + (got ↦ string) + " want " + (want ↦ string)
        print "CONTINUE: FAIL"
        if divergence ≡ "none" {
            divergence ← "ignore_eos diverged at position " + (continue_div ↦ string)
        }
    }
    if divergence ≡ "none" and continue_div ≺ 0 {
        print "GENERATE+CONTINUE: PASS"
    }
    else {
        print "GENERATE+CONTINUE: FAIL"
    }
}
