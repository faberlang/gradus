# gradient-seam consumer fixture — U1 discovery gate.
#
# Imports gradus:gradient (library wrapper) and gradus:math (epsilon).
# The compiler-generated companion (loss_backward) is exported through the
# importa boundary (SEM004): the consumer calls gradient.loss_backward
# directly with no mirrored @ radix backward annotation.
#
# faber check passes (proving the import seam).
# faber run -t fmir fails for library-importing packages (recorded gap;
# LIB-MIR gate). The execution proof lives in exempla/gradient-seam-nolib/.

importa ex "gradus:gradient" gradient
importa ex "gradus:math" math

# Companion ABI (from gradus:gradient):
#   loss_backward(x, w, nil(), upstream) → iuncta(_, grad_w)

incipit {
    fixum lista<f32> data_x ← [1.0, 2.0, 3.0, 4.0]
    fixum lista<f32> data_w ← [0.5, 0.0 - 0.25, 1.0, 1.5]
    fixum tensor<f32, []> seed ← vacua
    fixum lista<numerus> shape_2x2 ← [2, 2]

    fixum tensor<f32, [2,2]> x ← seed.strue(data_x, shape_2x2)
    fixum tensor<f32, [2,2]> w ← seed.strue(data_w, shape_2x2)

    # Forward via library wrapper.
    fixum f32 loss_lib ← gradient.simple_loss(x, w)
    nota loss_lib

    # Backward via local companion (file-scoped mirror of library annotation).
    fixum f32 upstream ← 1.0
    fixum _ grads ← gradient.loss_backward(x, w, gradient.nil(), upstream)
    fixum [_, gw] ← grads
    fixum lista<f32> flat_gw ← gw ↦ lista<f32>

    # Per-element FD.
    fixum f32 eps ← 0.00001
    fixum f32 two_eps ← 0.00002
    fixum lista<f32> flat_w ← w ↦ lista<f32>

    # Element 0
    fixum lista<f32> wp0 ← [flat_w[0] + eps, flat_w[1], flat_w[2], flat_w[3]]
    fixum lista<f32> wm0 ← [flat_w[0] - eps, flat_w[1], flat_w[2], flat_w[3]]
    fixum tensor<f32, [2,2]> twp0 ← seed.strue(wp0, shape_2x2)
    fixum tensor<f32, [2,2]> twm0 ← seed.strue(wm0, shape_2x2)
    fixum f32 lp0 ← gradient.simple_loss(x, twp0)
    fixum f32 lm0 ← gradient.simple_loss(x, twm0)
    fixum f32 fd0 ← (lp0 - lm0) / two_eps

    # Element 1
    fixum lista<f32> wp1 ← [flat_w[0], flat_w[1] + eps, flat_w[2], flat_w[3]]
    fixum lista<f32> wm1 ← [flat_w[0], flat_w[1] - eps, flat_w[2], flat_w[3]]
    fixum tensor<f32, [2,2]> twp1 ← seed.strue(wp1, shape_2x2)
    fixum tensor<f32, [2,2]> twm1 ← seed.strue(wm1, shape_2x2)
    fixum f32 lp1 ← gradient.simple_loss(x, twp1)
    fixum f32 lm1 ← gradient.simple_loss(x, twm1)
    fixum f32 fd1 ← (lp1 - lm1) / two_eps

    # Element 2
    fixum lista<f32> wp2 ← [flat_w[0], flat_w[1], flat_w[2] + eps, flat_w[3]]
    fixum lista<f32> wm2 ← [flat_w[0], flat_w[1], flat_w[2] - eps, flat_w[3]]
    fixum tensor<f32, [2,2]> twp2 ← seed.strue(wp2, shape_2x2)
    fixum tensor<f32, [2,2]> twm2 ← seed.strue(wm2, shape_2x2)
    fixum f32 lp2 ← gradient.simple_loss(x, twp2)
    fixum f32 lm2 ← gradient.simple_loss(x, twm2)
    fixum f32 fd2 ← (lp2 - lm2) / two_eps

    # Element 3
    fixum lista<f32> wp3 ← [flat_w[0], flat_w[1], flat_w[2], flat_w[3] + eps]
    fixum lista<f32> wm3 ← [flat_w[0], flat_w[1], flat_w[2], flat_w[3] - eps]
    fixum tensor<f32, [2,2]> twp3 ← seed.strue(wp3, shape_2x2)
    fixum tensor<f32, [2,2]> twm3 ← seed.strue(wm3, shape_2x2)
    fixum f32 lp3 ← gradient.simple_loss(x, twp3)
    fixum f32 lm3 ← gradient.simple_loss(x, twm3)
    fixum f32 fd3 ← (lp3 - lm3) / two_eps

    fixum f32 dif0 ← fd0 - flat_gw[0]
    fixum f32 dif1 ← fd1 - flat_gw[1]
    fixum f32 dif2 ← fd2 - flat_gw[2]
    fixum f32 dif3 ← fd3 - flat_gw[3]

    nota flat_gw
    nota [fd0, fd1, fd2, fd3]
    nota [dif0, dif1, dif2, dif3]
}
