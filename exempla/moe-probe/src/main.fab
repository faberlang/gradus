+++
locale = "en"
+++
# MODEL-02-U7: real-artifact MoE executed proof exemplar.
#
# Application-owned adapter (gguf-admit-qwen35moe + gguf-materialize
# patterns): resolves the operator artifact path from argv, pins identity
# (digest + length), runs `qwen35moe.admit` (ADMIT receipt line), maps the
# admitted config to `moe.MoeConfig`, binds TensorViews per canonical name,
# serves the windowed element source to `gradus:model/moe`, executes
# route/ffn_moe on layers 0/3/39/40 x 2 probes, and compares against the
# committed goldens (fixtures/gguf/gguf-moe-goldens.json, MODEL-02-U2):
# indices exact, weights and FFN outputs under Delta with a first-divergence
# record. Gradus never receives the path, a reader, or a whole-model byte
# list; every payload read is a bounded sub-window through the app-owned
# range source.
#
# Component tier only: no token, logit, full-model, or device claim.

import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" gguf_manifest
import from "gradus:model/moe" moe
import from "gradus:model/qwen35moe" qwen35moe
import from "gradus:model/tensor_payload" tensor_payload
import from "gradus:model/tensor_view" tensor_view
import from "gradus:tensor" tensor
import from "norma:process" process
import from "norma:fs" fs

# Pinned identity facts for the local Qwen3.6 artifact (operator evidence,
# never committed): the same frozen facts as gguf-materialize / the U2
# oracle header.
const string QWEN36_DIGEST ← "0b21525e972670ed59e1812e170b27c26355381f0656ecc4e25617ece7dac58b"
const int QWEN36_LENGTH ← 22663387424
const int QWEN36_DATA ← 10991392

# Band: Delta = clamp(10·R, 1e-5, 5e-4) with R = 6.37256e-08 (U2 oracle
# header). Tolerances are never widened; any mismatch is a divergence
# receipt naming the first divergent element.
const f32 DELTA ← 0.00001 ∷ f32

union ProbeError {
    BadArguments { string message },
    BadIdentity { string message },
    BadAdmission { string message },
    BadProbeWindow { string message },
    BadDivergence { string message }
}

fn message(ProbeError e) → string {
    match e {
        case BadArguments const message { return message }
        case BadIdentity const message { return message }
        case BadAdmission const message { return message }
        case BadProbeWindow const message { return message }
        case BadDivergence const message { return message }
    }
}

# Application-owned range source: one bounded read, checked against the
# artifact length (the gguf-materialize pattern).
fn _range(string via, int total, int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    if start < 0 or length < 0 or start > total - length {
        throw variant BadSource {message = "range request exceeds the artifact"}
    }
    const bytes bytes ← fs.read_range(via, start, length)
    if bytes.length() ≠ length {
        throw variant BadSource {message = "short range read"}
    }
    return bytes
}

fn _ends_with(string s, string suffix) → bool {
    if s.length() < suffix.length() {
        return false
    }
    return s.slice(s.length() - suffix.length(), s.length()) ≡ suffix
}

# Carrier shape per canonical name (delivery §3 layout contract; the module
# checks the returned shape, so this mapping is the adapter's declaration).
fn _carrier_shape(string name) → list<int> {
    if _ends_with(name, "ffn_gate_inp_shexp") {
        return [2048]
    }
    if _ends_with(name, "ffn_gate_inp") {
        return [256, 2048]
    }
    if _ends_with(name, "ffn_down_exps") or _ends_with(name, "ffn_down_shexp") {
        return [2048, 512]
    }
    # ffn_gate_exps / ffn_up_exps / ffn_gate_shexp / ffn_up_shexp
    return [512, 2048]
}

# Wrappers: each library error type maps to the single app-level ProbeError
# so every do/catch handler sees one union (the gguf-materialize pattern).
fn _identity(string digest, int length) → artifact.ContentIdentity ⇥ ProbeError {
    do {
        return artifact.identity("sha-256", digest, length)
    }
    catch err {
        throw variant BadIdentity { message = "content identity invalid: " + err.message }
    }
}

fn _plimit(gguf_manifest.GgufManifest m, string name) → tuple<int, int> ⇥ ProbeError {
    do {
        return gguf_manifest.payload_limit(m, name)
    }
    catch err {
        throw variant BadProbeWindow { message = "payload range failed for " + name + ": " + err.message }
    }
}

fn _links(gguf_manifest.GgufManifest m, tensor_payload.TensorPayload p) → tensor_view.TensorView ⇥ ProbeError {
    do {
        return tensor_view.links(m, p)
    }
    catch err {
        throw variant BadProbeWindow { message = "view bind failed for " + p.name + ": " + err.message }
    }
}

fn _slice(
    tensor_view.TensorView v,
    int start,
    int length,
    (int, int) → bytes ⇥ gguf_manifest.GgufManifestError source
) → list<f32> ⇥ ProbeError {
    do {
        return tensor_view.materialize_slice(v, start, length, source)
    }
    catch err {
        throw variant BadProbeWindow { message = "window materialize failed for " + v.name + ": " + err.message }
    }
}

fn _construct(list<f32> y, list<int> shape) → tensor.NumericBlock ⇥ ProbeError {
    do {
        return tensor.construct(y, shape)
    }
    catch err {
        throw variant BadProbeWindow { message = "carrier construction failed" }
    }
}

# The windowed element source served to gradus:model/moe: bind the named
# tensor's payload as a view, materialize the requested element window
# (bounded byte sub-reads + dequant inside tensor_view), and wrap the
# storage-order window as the declared carrier.
fn _moe_window(string via, int total, gguf_manifest.GgufManifest m, string name, int start, int length) → tensor.NumericBlock ⇥ moe.MoeError {
    const (int, int) → bytes ⇥ gguf_manifest.GgufManifestError reader ← (int begin, int span) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _range(via, total, begin, span)
    do {
        const tuple<int, int> limit ← _plimit(m, name + ".weight")
        const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
            name = name + ".weight",
            absolute_start = limit[0],
            length = limit[1],
            bytes = ||
        }
        const tensor_view.TensorView v ← _links(m, p)
        const list<f32> y ← _slice(v, start, length, reader)
        var tensor.NumericBlock carrier ← tensor.default()
        carrier ← _construct(y, _carrier_shape(name))
        return carrier
    }
    catch err {
        const string detail ← message(err)
        throw variant BadWindow { message = detail }
    }
}

fn _parse_number(string s) → int ⇥ ProbeError {
    do {
        return s ↦ int
    }
    catch err {
        throw variant BadArguments { message = "data-offset operand is not a number: " + s }
    }
}

fn _admit(gguf_manifest.GgufCorpus corpus, string digest, int total) → qwen35moe.Qwen35moeAdmission ⇥ ProbeError {
    do {
        return qwen35moe.admit(corpus, digest, total)
    }
    catch err {
        throw variant BadAdmission { message = qwen35moe.admission_message(err) }
    }
}

fn _corpus(string via, int total, string digest) → gguf_manifest.GgufCorpus ⇥ ProbeError {
    do {
        const artifact.ContentIdentity identity ← _identity(digest, total)
        const bytes prefix_bytes ← fs.read_range(via, 0, QWEN36_DATA)
        if prefix_bytes.length() ≠ QWEN36_DATA {
            throw variant BadAdmission { message = "short table-prefix read" }
        }
        return gguf_manifest.GgufCorpus {
            table = prefix_bytes,
            artifact_length = total,
            identity = identity
        }
    }
    catch err {
        throw variant BadAdmission { message = message(err) }
    }
}

fn _route(
    tensor.NumericBlock x,
    int layer,
    string via,
    int total,
    gguf_manifest.GgufManifest m,
    moe.MoeConfig cfg
) → moe.MoeSelection ⇥ ProbeError {
    do {
        return moe.route(x, layer, (string name, int start, int length) → tensor.NumericBlock ⇥ moe.MoeError ∴ _moe_window(via, total, m, name, start, length), cfg)
    }
    catch err {
        throw variant BadProbeWindow { message = err.message }
    }
}

fn _ffn_moe(
    tensor.NumericBlock x,
    int layer,
    string via,
    int total,
    gguf_manifest.GgufManifest m,
    moe.MoeConfig cfg
) → tensor.NumericBlock ⇥ ProbeError {
    do {
        return moe.ffn_moe(x, layer, (string name, int start, int length) → tensor.NumericBlock ⇥ moe.MoeError ∴ _moe_window(via, total, m, name, start, length), cfg)
    }
    catch err {
        throw variant BadProbeWindow { message = err.message }
    }
}

fn _config(qwen35moe.Qwen35moeConfig c) → moe.MoeConfig {
    return moe.MoeConfig {
        expert_count = c.expert_count,
        expert_used_count = c.expert_used_count,
        expert_ffn_length = c.expert_ffn_length,
        shared_ffn_length = c.shared_ffn_length,
        embedding_length = c.embedding_length
    }
}

fn _manifest(
    (int, int) → bytes ⇥ gguf_manifest.GgufManifestError source,
    int total,
    artifact.ContentIdentity identity
) → gguf_manifest.GgufManifest ⇥ ProbeError {
    do {
        return gguf_manifest.inspect(source, total, identity)
    }
    catch err {
        throw variant BadAdmission { message = "manifest admission failed: " + err.message }
    }
}

fn _hidden(list<f32> probe) → tensor.NumericBlock ⇥ ProbeError {
    return _construct(probe, [1, 2048])
}

fn _abs(f32 v) → f32 {
    if v < 0.0 ∷ f32 {
        return -v
    }
    return v
}

fn _int_list(list<int> xs) → string {
    var string out ← "["
    var int i ← 0
    while i < xs.length() {
        if i > 0 { out ← out + "," }
        out ← out + ((xs.get(i) coalesce 0) ↦ string)
        i ↑
    }
    return out + "]"
}

fn _f32_list(list<f32> xs) → string {
    var string out ← "["
    var int i ← 0
    while i < xs.length() {
        if i > 0 { out ← out + "," }
        out ← out + ((xs.get(i) coalesce (0.0 ∷ f32)) ↦ string)
        i ↑
    }
    return out + "]"
}

# One (layer, probe) row: route + ffn_moe on the real artifact, indices
# exact, weights and FFN output under Delta, first divergence named.
fn _probe(
    string via,
    int total,
    gguf_manifest.GgufManifest m,
    moe.MoeConfig cfg,
    int layer,
    string probe_name,
    list<f32> probe,
    list<int> golden_indices,
    list<f32> golden_weights,
    list<f32> golden_ffn
) → string ⇥ ProbeError {
    do {
        const tensor.NumericBlock x ← _hidden(probe)
        const moe.MoeSelection selection ← _route(x, layer, via, total, m, cfg)
        const tensor.NumericBlock out ← _ffn_moe(x, layer, via, total, m, cfg)

        # Router indices: exact, in selection order.
        if selection.indices.length() ≠ golden_indices.length() {
            throw variant BadDivergence { message = "index count mismatch at layer " + (layer ↦ string) + " probe " + probe_name }
        }
        var int i ← 0
        while i < golden_indices.length() {
            if (selection.indices.get(i) coalesce -1) ≠ (golden_indices.get(i) coalesce -1) {
                throw variant BadDivergence { message = "index divergence at slot " + (i ↦ string) + " of layer " + (layer ↦ string) + " probe " + probe_name + ": observed " + ((selection.indices.get(i) coalesce -1) ↦ string) + " expected " + ((golden_indices.get(i) coalesce -1) ↦ string) }
            }
            i ← i + 1
        }

        # Weights: under Delta.
        i ← 0
        while i < golden_weights.length() {
            const f32 observed ← selection.weights.get(i) coalesce (0.0 ∷ f32)
            const f32 expected ← golden_weights.get(i) coalesce (0.0 ∷ f32)
            if _abs(observed - expected) ≻ DELTA {
                throw variant BadDivergence { message = "weight divergence at slot " + (i ↦ string) + " of layer " + (layer ↦ string) + " probe " + probe_name + ": observed " + (observed ↦ string) + " expected " + (expected ↦ string) }
            }
            i ← i + 1
        }

        # FFN output: under Delta, first divergence named, max deviation kept.
        if out.data.length() ≠ golden_ffn.length() {
            throw variant BadDivergence { message = "FFN output length mismatch at layer " + (layer ↦ string) + " probe " + probe_name }
        }
        i ← 0
        var f32 max_dev ← 0.0 ∷ f32
        while i < golden_ffn.length() {
            const f32 observed ← out.data.get(i) coalesce (0.0 ∷ f32)
            const f32 expected ← golden_ffn.get(i) coalesce (0.0 ∷ f32)
            const f32 dev ← _abs(observed - expected)
            if dev ≻ max_dev {
                max_dev ← dev
            }
            if dev ≻ DELTA {
                throw variant BadDivergence { message = "FFN divergence at element " + (i ↦ string) + " of layer " + (layer ↦ string) + " probe " + probe_name + ": observed " + (observed ↦ string) + " expected " + (expected ↦ string) }
            }
            i ← i + 1
        }

        return "PASS layer=" + (layer ↦ string)
            + " probe=" + probe_name
            + " indices=" + _int_list(selection.indices)
            + " weights=" + _f32_list(selection.weights)
            + " first-divergence=none"
            + " max-dev=" + (max_dev ↦ string)
    }
    catch err {
        throw variant BadDivergence { message = message(err) }
    }
}

