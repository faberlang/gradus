main {
    do {
        const list<string> args ← process.argv() ↦ list<string>
        if args.length() ≠ 3 {
            throw variant BadArguments { message = "usage: moe-probe <path> <expected-data-offset> <sha256>" }
        }
        const string via ← args.get(0) coalesce ""
        const int expected_data ← _parse_number(args.get(1) coalesce "0")
        const string digest ← args.get(2) coalesce ""
        if digest ≠ QWEN36_DIGEST {
            throw variant BadIdentity { message = "sha256 does not match the pinned Qwen3.6 identity" }
        }
        const int total ← fs.byte_length(via)
        if total ≠ QWEN36_LENGTH {
            throw variant BadIdentity { message = "byte length mismatch: expected " + (QWEN36_LENGTH ↦ string) + ", observed " + (total ↦ string) }
        }
        const artifact.ContentIdentity identity ← _identity(digest, total)
        const gguf_manifest.GgufManifest m ← _manifest(
            (int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _range(via, total, start, length),
            total,
            identity
        )
        if m.data_start ≠ expected_data {
            throw variant BadAdmission { message = "data offset mismatch: expected " + (expected_data ↦ string) + ", observed " + (m.data_start ↦ string) }
        }
        const qwen35moe.Qwen35moeAdmission admission ← _admit(_corpus(via, total, digest), digest, total)
        print "ADMIT qwen35moe"
        const moe.MoeConfig cfg ← _config(admission.config)
        print "CONFIG moe experts=" + (cfg.expert_count ↦ string)
            + " used=" + (cfg.expert_used_count ↦ string)
            + " ffn=" + (cfg.expert_ffn_length ↦ string)
            + " shared=" + (cfg.shared_ffn_length ↦ string)
            + " embedding=" + (cfg.embedding_length ↦ string)
        print "BAND delta=" + (DELTA ↦ string)
        print _probe(via, total, m, cfg, 0, "p1", PROBE_0_P1, INDEX_0_P1, WEIGHT_0_P1, FFN_0_P1)
        print _probe(via, total, m, cfg, 0, "p2", PROBE_0_P2, INDEX_0_P2, WEIGHT_0_P2, FFN_0_P2)
        print _probe(via, total, m, cfg, 3, "p1", PROBE_3_P1, INDEX_3_P1, WEIGHT_3_P1, FFN_3_P1)
        print _probe(via, total, m, cfg, 3, "p2", PROBE_3_P2, INDEX_3_P2, WEIGHT_3_P2, FFN_3_P2)
        print _probe(via, total, m, cfg, 39, "p1", PROBE_39_P1, INDEX_39_P1, WEIGHT_39_P1, FFN_39_P1)
        print _probe(via, total, m, cfg, 39, "p2", PROBE_39_P2, INDEX_39_P2, WEIGHT_39_P2, FFN_39_P2)
        print _probe(via, total, m, cfg, 40, "p1", PROBE_40_P1, INDEX_40_P1, WEIGHT_40_P1, FFN_40_P1)
        print _probe(via, total, m, cfg, 40, "p2", PROBE_40_P2, INDEX_40_P2, WEIGHT_40_P2, FFN_40_P2)
        print "PASS real-file moe probe receipt"
    }
    catch err {
        panic "moe-probe failed: " + message(err)
    }
}
