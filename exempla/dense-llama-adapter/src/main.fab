# REF-01-U1.6 — executable proof for the typed `llama` (SmolLM2) architecture
# adapter.
#
# The source builds a synthetic GGUF v3 table corpus carrying the exact
# descriptor facts the GGUF-A1b inspect surface reports for the real
# SmolLM2-360M-Instruct-Q4_K_M.gguf file (read-only pinned facts — shapes,
# GGML type ids, and known layouts; no artifact bytes are committed), then
# resolves every canonical tensor name through the public
# `gradus:model/dense_llama` surface and prints a PASS/FAIL line per case.
# It performs no filesystem read, download, mmap, or model-payload
# allocation.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" gguf_manifest

import from "gradus:model/dense_llama" dense_llama

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# --- little-endian byte fixture helpers -------------------------------------

fn u32_le(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>]
}

fn u64_le(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>, ((n ⇒ 32) % 256) ∷ int<u8>, ((n ⇒ 40) % 256) ∷ int<u8>, ((n ⇒ 48) % 256) ∷ int<u8>, ((n ⇒ 56) % 256) ∷ int<u8>]
}

fn join_bytes(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← empty
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

fn text_bytes(string s) → list<int<u8>> {
    # Package MIR has no text→bytes extraction arm. This structural
    # builder only needs a finite ASCII corpus, so keep its encoding explicit.
    switch s {
        case "token_embd.weight" { return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.attn_norm.weight" { return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.attn_q.weight" { return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.attn_k.weight" { return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 107, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.attn_v.weight" { return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 118, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.attn_output.weight" { return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.ffn_norm.weight" { return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.ffn_gate.weight" { return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 103, 97, 116, 101, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.ffn_up.weight" { return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 117, 112, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.0.ffn_down.weight" { return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 100, 111, 119, 110, 46, 119, 101, 105, 103, 104, 116] }
        case "output_norm.weight" { return [111, 117, 116, 112, 117, 116, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116] }
        case "blk.31.attn_norm.weight" { return [98, 108, 107, 46, 51, 49, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116] }
        default { return empty }
    }
}

fn str_field(string s) → list<int<u8>> {
    const list<int<u8>> b ← text_bytes(s)
    return join_bytes(u64_le(b.length()), b)
}

fn tensor_entry(string name, list<int> shape, int kind, int offset) → list<int<u8>> {
    var list<int<u8>> out ← join_bytes(str_field(name), u32_le(shape.length()))
    for from shape const dim {
        out ← join_bytes(out, u64_le(dim))
    }
    return join_bytes(join_bytes(out, u32_le(kind)), u64_le(offset))
}

fn header_bytes(int tensors, int metadata) → list<int<u8>> {
    return join_bytes(join_bytes([71, 71, 85, 70], u32_le(3)), join_bytes(u64_le(tensors), u64_le(metadata)))
}

fn to_bytes(list<int<u8>> b) → bytes {
    var bytes o ← ||
    for from b const x {
        o.append(x)
    }
    return o
}

fn padded_corpus(list<int<u8>> table, int alignment, int total) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    var list<int<u8>> b ← table
    for range 0‥(data_offset - b.length()) const _ {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← to_bytes(b)
    return gguf_manifest.GgufCorpus {table = o, artifact_length = total, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = total}}
}

# --- fixture corpora (smollm2 / rejection rows) ------------------------------

# SmolLM2-360M scaled descriptor corpus (the A1b inspect-surface facts,
# read-only pinned; offsets/total are structural filler). `output.weight` is
# absent — the real row has tied embeddings. blk.0 and blk.31 rows carry the
# layer-boundary facts.
fn corpus_smollm2() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← header_bytes(12, 0)
    table ← join_bytes(table, tensor_entry("token_embd.weight", [960, 49152], 8, 0))
    table ← join_bytes(table, tensor_entry("blk.0.attn_norm.weight", [960], 0, 50135040))
    table ← join_bytes(table, tensor_entry("blk.0.attn_q.weight", [960, 960], 6, 50138880))
    table ← join_bytes(table, tensor_entry("blk.0.attn_k.weight", [960, 320], 6, 50772480))
    table ← join_bytes(table, tensor_entry("blk.0.attn_v.weight", [960, 320], 8, 50983680))
    table ← join_bytes(table, tensor_entry("blk.0.attn_output.weight", [960, 960], 6, 51310080))
    table ← join_bytes(table, tensor_entry("blk.0.ffn_norm.weight", [960], 0, 51943680))
    table ← join_bytes(table, tensor_entry("blk.0.ffn_gate.weight", [960, 2560], 6, 51947520))
    table ← join_bytes(table, tensor_entry("blk.0.ffn_up.weight", [960, 2560], 6, 53637120))
    table ← join_bytes(table, tensor_entry("blk.0.ffn_down.weight", [2560, 960], 14, 55326720))
    table ← join_bytes(table, tensor_entry("output_norm.weight", [960], 0, 57342720))
    table ← join_bytes(table, tensor_entry("blk.31.attn_norm.weight", [960], 0, 57346560))
    return padded_corpus(table, 32, 57351136)
}

# Same corpus minus output_norm.weight — the TensorDeest rejection row.
fn corpus_without_norm() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← header_bytes(10, 0)
    table ← join_bytes(table, tensor_entry("token_embd.weight", [960, 49152], 8, 0))
    table ← join_bytes(table, tensor_entry("blk.0.attn_norm.weight", [960], 0, 50135040))
    table ← join_bytes(table, tensor_entry("blk.0.attn_q.weight", [960, 960], 6, 50138880))
    table ← join_bytes(table, tensor_entry("blk.0.attn_k.weight", [960, 320], 6, 50772480))
    table ← join_bytes(table, tensor_entry("blk.0.attn_v.weight", [960, 320], 8, 50983680))
    table ← join_bytes(table, tensor_entry("blk.0.attn_output.weight", [960, 960], 6, 51310080))
    table ← join_bytes(table, tensor_entry("blk.0.ffn_norm.weight", [960], 0, 51943680))
    table ← join_bytes(table, tensor_entry("blk.0.ffn_gate.weight", [960, 2560], 6, 51947520))
    table ← join_bytes(table, tensor_entry("blk.0.ffn_up.weight", [960, 2560], 6, 53637120))
    table ← join_bytes(table, tensor_entry("blk.0.ffn_down.weight", [2560, 960], 14, 55326720))
    return padded_corpus(table, 32, 57343392)
}

# Unknown-layout corpus: a canonical target carrying an unlisted GGML type id
# (999) — the UnknownLayout rejection row.
fn corpus_unknown_layout() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← header_bytes(1, 0)
    table ← join_bytes(table, tensor_entry("blk.0.ffn_gate.weight", [960, 2560], 999, 0))
    return padded_corpus(table, 32, 96)
}

# --- resolution oracle (PASS/FAIL rows) ---------------------------------------

fn shape_text(list<int> f) → string {
    var string out ← "["
    var bool first ← true
    for from f const dim {
        if not first {
            out ← out + ","
        }
        out ← out + (dim ↦ string)
        first ← false
    }
    return out + "]"
}

# Render one canonical resolution as "canonical/gguf/shape/layout" or the
# typed LlamaError render.
fn render_description(gguf_manifest.GgufCorpus corpus, string canonical, int layer) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const dense_llama.CanonicalDescriptor d ← dense_llama.resolve(m, dense_llama.smollm2_arch(), canonical, layer)
            return "§/§/§/§"(d.canonical_name, d.gguf_name, shape_text(d.shape), dense_llama.layout_note(d.layout))
        }
        catch err {
            return "ERR:§"(err.message)
        }
    }
    catch err {
        return "ERR:§"(err.message)
    }
}

# Render one canonical-name mapping as the GGUF tensor name or the typed
# LlamaError render.
fn name_render(string canonical, int layer) → string {
    do {
        return dense_llama.gguf_name(dense_llama.smollm2_arch(), canonical, layer)
    }
    catch err {
        return "ERR:§"(err.message)
    }
}

# Render the frozen architecture config as a single facts line.
fn arch_facts() → string {
    const dense_llama.LlamaArch a ← dense_llama.smollm2_arch()
    return "§/§/§/§/§/§/§/§"(a.name, a.layers, a.heads, a.kv_heads, a.head_dim, a.hidden_dim, a.vocab, a.tied)
}

fn case_row(string name, string observed, string expected) → string {
    if observed ≡ expected then return "§: PASS observed=§"(name, observed)
    return "§: FAIL expected=§ observed=§"(name, expected, observed)
}

main {
    print case_row("frozen-smollm2-config", arch_facts(), "SmolLM2-360M/32/15/5/64/960/49152/true")
    print case_row("model.embed_tokens", render_description(corpus_smollm2(), "model.embed_tokens", 0), "model.embed_tokens/token_embd.weight/[960,49152]/known")
    print case_row("model.layers.0.input_layernorm", render_description(corpus_smollm2(), "model.layers.input_layernorm", 0), "model.layers.input_layernorm/blk.0.attn_norm.weight/[960]/known")
    print case_row("model.layers.0.self_attn.q_proj", render_description(corpus_smollm2(), "model.layers.self_attn.q_proj", 0), "model.layers.self_attn.q_proj/blk.0.attn_q.weight/[960,960]/known")
    print case_row("model.layers.0.self_attn.k_proj", render_description(corpus_smollm2(), "model.layers.self_attn.k_proj", 0), "model.layers.self_attn.k_proj/blk.0.attn_k.weight/[960,320]/known")
    print case_row("model.layers.0.self_attn.v_proj", render_description(corpus_smollm2(), "model.layers.self_attn.v_proj", 0), "model.layers.self_attn.v_proj/blk.0.attn_v.weight/[960,320]/known")
    print case_row("model.layers.0.self_attn.o_proj", render_description(corpus_smollm2(), "model.layers.self_attn.o_proj", 0), "model.layers.self_attn.o_proj/blk.0.attn_output.weight/[960,960]/known")
    print case_row("model.layers.0.post_attention_layernorm", render_description(corpus_smollm2(), "model.layers.post_attention_layernorm", 0), "model.layers.post_attention_layernorm/blk.0.ffn_norm.weight/[960]/known")
    print case_row("model.layers.0.mlp.gate_proj", render_description(corpus_smollm2(), "model.layers.mlp.gate_proj", 0), "model.layers.mlp.gate_proj/blk.0.ffn_gate.weight/[960,2560]/known")
    print case_row("model.layers.0.mlp.up_proj", render_description(corpus_smollm2(), "model.layers.mlp.up_proj", 0), "model.layers.mlp.up_proj/blk.0.ffn_up.weight/[960,2560]/known")
    print case_row("model.layers.0.mlp.down_proj", render_description(corpus_smollm2(), "model.layers.mlp.down_proj", 0), "model.layers.mlp.down_proj/blk.0.ffn_down.weight/[2560,960]/known")
    print case_row("model.norm", render_description(corpus_smollm2(), "model.norm", 0), "model.norm/output_norm.weight/[960]/known")
    print case_row("lm_head-tied", render_description(corpus_smollm2(), "lm_head", 0), "lm_head/token_embd.weight/[960,49152]/known")
    print case_row("model.layers.31.input_layernorm", render_description(corpus_smollm2(), "model.layers.input_layernorm", 31), "model.layers.input_layernorm/blk.31.attn_norm.weight/[960]/known")
    print case_row("unknown-canonical-rejected", name_render("model.layers.mlp.silu_proj", 0), "ERR:unknown canonical tensor name: model.layers.mlp.silu_proj")
    print case_row("out-of-range-layer-rejected", name_render("model.layers.input_layernorm", 32), "ERR:layer index outside the frozen llama layer range: 32")
    print case_row("negative-layer-rejected", name_render("model.layers.input_layernorm", -1), "ERR:layer index outside the frozen llama layer range: -1")
    print case_row("missing-tensor-rejected", render_description(corpus_without_norm(), "model.norm", 0), "ERR:canonical tensor is absent from the manifest: output_norm.weight")
    print case_row("unknown-layout-rejected", render_description(corpus_unknown_layout(), "model.layers.mlp.gate_proj", 0), "ERR:canonical tensor resolves to an unknown GGML layout: blk.0.ffn_gate.weight")
}
