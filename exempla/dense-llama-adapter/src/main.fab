+++
locale = "en"
+++
# REF-01-U1.6 — executable proof for the typed `llama` (SmolLM2) architecture
# adapter.
#
# The source builds a synthetic GGUF v3 table corpus carrying the exact
# descriptor facts the GGUF-A1b inspect surface reports for the real
# SmolLM2-360M-Instruct-Q4_K_M.gguf file (read-only pinned facts — shapes,
# GGML type ids, and known layouts; no artifact bytes are committed), then
# resolves every canonical tensor name through the public
# `gradus:model/dense_llama` surface and prints a PASS/FAIL line per case.
# It performs no filesystem read, download, mmap, or model-payload
# allocation.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" gguf_manifest

import from "gradus:model/dense_llama" dense_llama

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn _u32(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>]
}

fn _u64(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>, ((n ⇒ 32) % 256) ∷ int<u8>, ((n ⇒ 40) % 256) ∷ int<u8>, ((n ⇒ 48) % 256) ∷ int<u8>, ((n ⇒ 56) % 256) ∷ int<u8>]
}

fn _join(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← vacua
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

fn _text_bytes(string s) → list<int<u8>> {
    # Package MIR has no text→bytes extraction arm. This structural
    # builder only needs a finite ASCII corpus, so keep its encoding explicit.
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_norm.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_q.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_k.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 107, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_v.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 118, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_output.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 111, 117, 116, 112, 117, 116, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_norm.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_gate.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 103, 97, 116, 101, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_up.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 117, 112, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.ffn_down.weight" then return [98, 108, 107, 46, 48, 46, 102, 102, 110, 95, 100, 111, 119, 110, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "output_norm.weight" then return [111, 117, 116, 112, 117, 116, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.31.attn_norm.weight" then return [98, 108, 107, 46, 51, 49, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    return []
}

fn _str(string s) → list<int<u8>> {
    const list<int<u8>> b ← _text_bytes(s)
    return _join(_u64(b.length()), b)
}

fn _tensor(string name, list<int> shape, int kind, int offset) → list<int<u8>> {
    var list<int<u8>> out ← _join(_str(name), _u32(shape.length()))
    for from shape const dim {
        out ← _join(out, _u64(dim))
    }
    return _join(_join(out, _u32(kind)), _u64(offset))
}

fn _header(int tensors, int metadata) → list<int<u8>> {
    return _join(_join([71, 71, 85, 70], _u32(3)), _join(_u64(tensors), _u64(metadata)))
}

fn _bytes(list<int<u8>> b) → bytes {
    var bytes o ← ||
    for from b const x {
        o.append(x)
    }
    return o
}

fn _cum_padding(list<int<u8>> table, int alignment, int total) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← _bytes(b)
    return gguf_manifest.GgufCorpus {table = o, artifact_length = total, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = total}}
}

# SmolLM2-360M scaled descriptor corpus (the A1b inspect-surface facts,
# read-only pinned; offsets/total are structural filler). `output.weight` is
# absent — the real row has tied embeddings. blk.0 and blk.31 rows carry the
# layer-boundary facts.
fn _corpus_smollm2() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(12, 0)
    table ← _join(table, _tensor("token_embd.weight", [960, 49152], 8, 0))
    table ← _join(table, _tensor("blk.0.attn_norm.weight", [960], 0, 50135040))
    table ← _join(table, _tensor("blk.0.attn_q.weight", [960, 960], 6, 50138880))
    table ← _join(table, _tensor("blk.0.attn_k.weight", [960, 320], 6, 50772480))
    table ← _join(table, _tensor("blk.0.attn_v.weight", [960, 320], 8, 50983680))
    table ← _join(table, _tensor("blk.0.attn_output.weight", [960, 960], 6, 51310080))
    table ← _join(table, _tensor("blk.0.ffn_norm.weight", [960], 0, 51943680))
    table ← _join(table, _tensor("blk.0.ffn_gate.weight", [960, 2560], 6, 51947520))
    table ← _join(table, _tensor("blk.0.ffn_up.weight", [960, 2560], 6, 53637120))
    table ← _join(table, _tensor("blk.0.ffn_down.weight", [2560, 960], 14, 55326720))
    table ← _join(table, _tensor("output_norm.weight", [960], 0, 57342720))
    table ← _join(table, _tensor("blk.31.attn_norm.weight", [960], 0, 57346560))
    return _cum_padding(table, 32, 57351136)
}

# Same corpus minus output_norm.weight — the TensorDeest rejection row.
fn _corpus_sine_norm() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(10, 0)
    table ← _join(table, _tensor("token_embd.weight", [960, 49152], 8, 0))
    table ← _join(table, _tensor("blk.0.attn_norm.weight", [960], 0, 50135040))
    table ← _join(table, _tensor("blk.0.attn_q.weight", [960, 960], 6, 50138880))
    table ← _join(table, _tensor("blk.0.attn_k.weight", [960, 320], 6, 50772480))
    table ← _join(table, _tensor("blk.0.attn_v.weight", [960, 320], 8, 50983680))
    table ← _join(table, _tensor("blk.0.attn_output.weight", [960, 960], 6, 51310080))
    table ← _join(table, _tensor("blk.0.ffn_norm.weight", [960], 0, 51943680))
    table ← _join(table, _tensor("blk.0.ffn_gate.weight", [960, 2560], 6, 51947520))
    table ← _join(table, _tensor("blk.0.ffn_up.weight", [960, 2560], 6, 53637120))
    table ← _join(table, _tensor("blk.0.ffn_down.weight", [2560, 960], 14, 55326720))
    return _cum_padding(table, 32, 57343392)
}

# Unknown-layout corpus: a canonical target carrying an unlisted GGML type id
# (999) — the UnknownLayout rejection row.
fn _corpus_unknown_layout() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _join(table, _tensor("blk.0.ffn_gate.weight", [960, 2560], 999, 0))
    return _cum_padding(table, 32, 96)
}

fn _shape(list<int> f) → string {
    var string out ← "["
    var int i ← 0
    while i ≺ f.length() {
        out ← out + (f.get(i) coalesce 0 ↦ string)
        if i + 1 ≺ f.length() {
            out ← out + ","
        }
        i ← i + 1
    }
    return out + "]"
}

# Render one canonical resolution as "canonicum/gguf/shape/layout" or the
# typed DensumLlamaError render.
fn _description(gguf_manifest.GgufCorpus corpus, string canonicum, int layer) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        do {
            const dense_llama.CanonicalDescriptor d ← dense_llama.resolve(m, dense_llama.smollm2_arch(), canonicum, layer)
            return (((((d.canonical_name + "/") + d.gguf_name) + "/") + _shape(d.shape)) + "/") + dense_llama.layout_note(d.layout)
        }
        catch err {
            return "ERR:" + dense_llama.message(err)
        }
    }
    catch err {
        return "ERR:" + gguf_manifest.message(err)
    }
}

# Render one canonical-name mapping as the GGUF tensor name or the typed
# DensumLlamaError render.
fn _name(string canonicum, int layer) → string {
    do {
        return dense_llama.gguf_name(dense_llama.smollm2_arch(), canonicum, layer)
    }
    catch err {
        return "ERR:" + dense_llama.message(err)
    }
}

# Render the frozen architecture config as a single facts line.
fn _arch() → string {
    const dense_llama.LlamaArch a ← dense_llama.smollm2_arch()
    return (((((((((((((a.name + "/") + (a.layers ↦ string)) + "/") + (a.heads ↦ string)) + "/") + (a.kv_heads ↦ string)) + "/") + (a.head_dim ↦ string)) + "/") + (a.hidden_dim ↦ string)) + "/") + (a.vocab ↦ string)) + "/") + (a.tied ↦ string)
}

fn _case(string name, string observed, string expected) → string {
    if observed ≡ expected then return (name + ": PASS observed=") + observed
    return (((name + ": FAIL expected=") + expected) + " observed=") + observed
}

main {
    print _case("frozen-smollm2-config", _arch(), "SmolLM2-360M/32/15/5/64/960/49152/true")
    print _case("model.embed_tokens", _description(_corpus_smollm2(), "model.embed_tokens", 0), "model.embed_tokens/token_embd.weight/[960,49152]/known")
    print _case("model.layers.0.input_layernorm", _description(_corpus_smollm2(), "model.layers.input_layernorm", 0), "model.layers.input_layernorm/blk.0.attn_norm.weight/[960]/known")
    print _case("model.layers.0.self_attn.q_proj", _description(_corpus_smollm2(), "model.layers.self_attn.q_proj", 0), "model.layers.self_attn.q_proj/blk.0.attn_q.weight/[960,960]/known")
    print _case("model.layers.0.self_attn.k_proj", _description(_corpus_smollm2(), "model.layers.self_attn.k_proj", 0), "model.layers.self_attn.k_proj/blk.0.attn_k.weight/[960,320]/known")
    print _case("model.layers.0.self_attn.v_proj", _description(_corpus_smollm2(), "model.layers.self_attn.v_proj", 0), "model.layers.self_attn.v_proj/blk.0.attn_v.weight/[960,320]/known")
    print _case("model.layers.0.self_attn.o_proj", _description(_corpus_smollm2(), "model.layers.self_attn.o_proj", 0), "model.layers.self_attn.o_proj/blk.0.attn_output.weight/[960,960]/known")
    print _case("model.layers.0.post_attention_layernorm", _description(_corpus_smollm2(), "model.layers.post_attention_layernorm", 0), "model.layers.post_attention_layernorm/blk.0.ffn_norm.weight/[960]/known")
    print _case("model.layers.0.mlp.gate_proj", _description(_corpus_smollm2(), "model.layers.mlp.gate_proj", 0), "model.layers.mlp.gate_proj/blk.0.ffn_gate.weight/[960,2560]/known")
    print _case("model.layers.0.mlp.up_proj", _description(_corpus_smollm2(), "model.layers.mlp.up_proj", 0), "model.layers.mlp.up_proj/blk.0.ffn_up.weight/[960,2560]/known")
    print _case("model.layers.0.mlp.down_proj", _description(_corpus_smollm2(), "model.layers.mlp.down_proj", 0), "model.layers.mlp.down_proj/blk.0.ffn_down.weight/[2560,960]/known")
    print _case("model.norm", _description(_corpus_smollm2(), "model.norm", 0), "model.norm/output_norm.weight/[960]/known")
    print _case("lm_head-tied", _description(_corpus_smollm2(), "lm_head", 0), "lm_head/token_embd.weight/[960,49152]/known")
    print _case("model.layers.31.input_layernorm", _description(_corpus_smollm2(), "model.layers.input_layernorm", 31), "model.layers.input_layernorm/blk.31.attn_norm.weight/[960]/known")
    print _case("unknown-canonical-rejected", _name("model.layers.mlp.silu_proj", 0), "ERR:unknown canonical tensor name: model.layers.mlp.silu_proj")
    print _case("out-of-range-layer-rejected", _name("model.layers.input_layernorm", 32), "ERR:layer index outside the frozen llama layer range: 32")
    print _case("negative-layer-rejected", _name("model.layers.input_layernorm", -1), "ERR:layer index outside the frozen llama layer range: -1")
    print _case("missing-tensor-rejected", _description(_corpus_sine_norm(), "model.norm", 0), "ERR:canonical tensor is absent from the manifest: output_norm.weight")
    print _case("unknown-layout-rejected", _description(_corpus_unknown_layout(), "model.layers.mlp.gate_proj", 0), "ERR:canonical tensor resolves to an unknown GGML layout: blk.0.ffn_gate.weight")
}
