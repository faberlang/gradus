+++
locale = "la"
+++
# REF-01-U1.6 — executable proof for the typed `llama` (SmolLM2) architecture
# adapter.
#
# The source builds a synthetic GGUF v3 table corpus carrying the exact
# descriptor facts the GGUF-A1b inspect surface reports for the real
# SmolLM2-360M-Instruct-Q4_K_M.gguf file (read-only pinned facts — shapes,
# GGML type ids, and known layouts; no artifact bytes are committed), then
# resolves every canonical tensor name through the public
# `gradus:model/dense_llama` surface and prints a PASS/FAIL line per case.
# It performs no filesystem read, download, mmap, or model-payload
# allocation.

importa ex "gradus:model/artifact" artifact
importa ex "gradus:model/gguf_manifest" manifestum
importa ex "gradus:model/dense_llama" dense_llama

fixum textus F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

functio _u32(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>,
        ((n ⇒ 16) % 256) ∷ numerus<u8>,
        ((n ⇒ 24) % 256) ∷ numerus<u8>
    ]
}

functio _u64(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>,
        ((n ⇒ 16) % 256) ∷ numerus<u8>,
        ((n ⇒ 24) % 256) ∷ numerus<u8>,
        ((n ⇒ 32) % 256) ∷ numerus<u8>,
        ((n ⇒ 40) % 256) ∷ numerus<u8>,
        ((n ⇒ 48) % 256) ∷ numerus<u8>,
        ((n ⇒ 56) % 256) ∷ numerus<u8>
    ]
}

functio _iunge(lista<numerus<u8>> a, lista<numerus<u8>> b) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    itera ex a fixum x { out.appende(x) }
    itera ex b fixum x { out.appende(x) }
    redde out
}

functio _textus_bytes(textus s) → lista<numerus<u8>> {
    # Package MIR has no textus→octeti extraction arm. This structural
    # builder only needs a finite ASCII corpus, so keep its encoding explicit.
    si s ≡ "token_embd.weight" ergo redde [116,111,107,101,110,95,101,109,98,100,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_norm.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_q.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,113,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_k.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,107,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_v.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,118,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_output.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,111,117,116,112,117,116,46,119,101,105,103,104,116]
    si s ≡ "blk.0.ffn_norm.weight" ergo redde [98,108,107,46,48,46,102,102,110,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ "blk.0.ffn_gate.weight" ergo redde [98,108,107,46,48,46,102,102,110,95,103,97,116,101,46,119,101,105,103,104,116]
    si s ≡ "blk.0.ffn_up.weight" ergo redde [98,108,107,46,48,46,102,102,110,95,117,112,46,119,101,105,103,104,116]
    si s ≡ "blk.0.ffn_down.weight" ergo redde [98,108,107,46,48,46,102,102,110,95,100,111,119,110,46,119,101,105,103,104,116]
    si s ≡ "output_norm.weight" ergo redde [111,117,116,112,117,116,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ "blk.31.attn_norm.weight" ergo redde [98,108,107,46,51,49,46,97,116,116,110,95,110,111,114,109,46,119,101,105,103,104,116]
    redde []
}

functio _str(textus s) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> b ← _textus_bytes(s)
    redde _iunge(_u64(b.longitudo()), b)
}

functio _tensor(textus name, lista<numerus> forma, numerus typo, numerus offset) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← _iunge(_str(name), _u32(forma.longitudo()))
    itera ex forma fixum dim { out ← _iunge(out, _u64(dim)) }
    redde _iunge(_iunge(out, _u32(typo)), _u64(offset))
}

functio _caput(numerus tensorum, numerus metadata) → lista<numerus<u8>> {
    redde _iunge(
        _iunge([0x47, 0x47, 0x55, 0x46], _u32(3)),
        _iunge(_u64(tensorum), _u64(metadata))
    )
}

functio _octeti(lista<numerus<u8>> b) → octeti {
    varia octeti o ← ||
    itera ex b fixum x { o.appende(x) }
    redde o
}

functio _cum_padding(lista<numerus<u8>> table, numerus concordatio, numerus total) → manifestum.CorpusGguf {
    fixum numerus data_offset ← ((table.longitudo() + concordatio - 1) / concordatio) * concordatio
    varia lista<numerus<u8>> b ← table
    dum b.longitudo() < data_offset { b.appende(0 ∷ numerus<u8>) }
    fixum octeti o ← _octeti(b)
    redde manifestum.CorpusGguf {
        tabula = o,
        longitudo_artifacti = total,
        identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = total }
    }
}

# SmolLM2-360M scaled descriptor corpus (the A1b inspect-surface facts,
# read-only pinned; offsets/total are structural filler). `output.weight` is
# absent — the real row has tied embeddings. blk.0 and blk.31 rows carry the
# layer-boundary facts.
functio _corpus_smollm2() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(12, 0)
    table ← _iunge(table, _tensor("token_embd.weight", [960, 49152], 8, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [960], 0, 50135040))
    table ← _iunge(table, _tensor("blk.0.attn_q.weight", [960, 960], 6, 50138880))
    table ← _iunge(table, _tensor("blk.0.attn_k.weight", [960, 320], 6, 50772480))
    table ← _iunge(table, _tensor("blk.0.attn_v.weight", [960, 320], 8, 50983680))
    table ← _iunge(table, _tensor("blk.0.attn_output.weight", [960, 960], 6, 51310080))
    table ← _iunge(table, _tensor("blk.0.ffn_norm.weight", [960], 0, 51943680))
    table ← _iunge(table, _tensor("blk.0.ffn_gate.weight", [960, 2560], 6, 51947520))
    table ← _iunge(table, _tensor("blk.0.ffn_up.weight", [960, 2560], 6, 53637120))
    table ← _iunge(table, _tensor("blk.0.ffn_down.weight", [2560, 960], 14, 55326720))
    table ← _iunge(table, _tensor("output_norm.weight", [960], 0, 57342720))
    table ← _iunge(table, _tensor("blk.31.attn_norm.weight", [960], 0, 57346560))
    redde _cum_padding(table, 32, 57351136)
}

# Same corpus minus output_norm.weight — the TensorDeest rejection row.
functio _corpus_sine_norm() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(10, 0)
    table ← _iunge(table, _tensor("token_embd.weight", [960, 49152], 8, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [960], 0, 50135040))
    table ← _iunge(table, _tensor("blk.0.attn_q.weight", [960, 960], 6, 50138880))
    table ← _iunge(table, _tensor("blk.0.attn_k.weight", [960, 320], 6, 50772480))
    table ← _iunge(table, _tensor("blk.0.attn_v.weight", [960, 320], 8, 50983680))
    table ← _iunge(table, _tensor("blk.0.attn_output.weight", [960, 960], 6, 51310080))
    table ← _iunge(table, _tensor("blk.0.ffn_norm.weight", [960], 0, 51943680))
    table ← _iunge(table, _tensor("blk.0.ffn_gate.weight", [960, 2560], 6, 51947520))
    table ← _iunge(table, _tensor("blk.0.ffn_up.weight", [960, 2560], 6, 53637120))
    table ← _iunge(table, _tensor("blk.0.ffn_down.weight", [2560, 960], 14, 55326720))
    redde _cum_padding(table, 32, 57343392)
}

# Unknown-layout corpus: a canonical target carrying an unlisted GGML type id
# (999) — the LayoutIgnota rejection row.
functio _corpus_ignota_layout() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("blk.0.ffn_gate.weight", [960, 2560], 999, 0))
    redde _cum_padding(table, 32, 96)
}

functio _forma(lista<numerus> f) → textus {
    varia textus out ← "["
    varia numerus i ← 0
    dum i < f.longitudo() {
        out ← out + (f.accipe(i) vel 0 ↦ textus)
        si i + 1 < f.longitudo() ergo out ← out + ","
        i ← i + 1
    }
    redde out + "]"
}

# Render one canonical resolution as "canonicum/gguf/shape/layout" or the
# typed DensumLlamaError render.
functio _descriptio(manifestum.CorpusGguf corpus, textus canonicum, numerus stratum) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fac {
            fixum dense_llama.DescriptioCanonica d ← dense_llama.resolvo(m, dense_llama.ars_smollm2(), canonicum, stratum)
            redde d.nomen_canonicum + "/" + d.nomen_gguf + "/" + _forma(d.forma) + "/" + dense_llama.layout_nota(d.layout)
        }
        cape err { redde "ERR:" + dense_llama.causa(err) }
    }
    cape err { redde "ERR:" + manifestum.causa(err) }
}

# Render one canonical-name mapping as the GGUF tensor name or the typed
# DensumLlamaError render.
functio _nomen(textus canonicum, numerus stratum) → textus {
    fac {
        redde dense_llama.nomen_gguf(dense_llama.ars_smollm2(), canonicum, stratum)
    }
    cape err { redde "ERR:" + dense_llama.causa(err) }
}

# Render the frozen architecture config as a single facts line.
functio _ars() → textus {
    fixum dense_llama.ArsLlama a ← dense_llama.ars_smollm2()
    redde a.nomen + "/" + (a.strata ↦ textus) + "/" + (a.capita ↦ textus) + "/" + (a.capita_kv ↦ textus) + "/" + (a.dimensio_capitis ↦ textus) + "/" + (a.dimensio_occulta ↦ textus) + "/" + (a.vocabularia ↦ textus) + "/" + (a.nexa_immortalia ↦ textus)
}

functio _case(textus name, textus observed, textus expected) → textus {
    si observed ≡ expected {
        redde name + ": PASS observed=" + observed
    }
    redde name + ": FAIL expected=" + expected + " observed=" + observed
}

incipit {
    nota _case("frozen-smollm2-config", _ars(), "SmolLM2-360M/32/15/5/64/960/49152/true")
    nota _case("model.embed_tokens", _descriptio(_corpus_smollm2(), "model.embed_tokens", 0), "model.embed_tokens/token_embd.weight/[960,49152]/known")
    nota _case("model.layers.0.input_layernorm", _descriptio(_corpus_smollm2(), "model.layers.input_layernorm", 0), "model.layers.input_layernorm/blk.0.attn_norm.weight/[960]/known")
    nota _case("model.layers.0.self_attn.q_proj", _descriptio(_corpus_smollm2(), "model.layers.self_attn.q_proj", 0), "model.layers.self_attn.q_proj/blk.0.attn_q.weight/[960,960]/known")
    nota _case("model.layers.0.self_attn.k_proj", _descriptio(_corpus_smollm2(), "model.layers.self_attn.k_proj", 0), "model.layers.self_attn.k_proj/blk.0.attn_k.weight/[960,320]/known")
    nota _case("model.layers.0.self_attn.v_proj", _descriptio(_corpus_smollm2(), "model.layers.self_attn.v_proj", 0), "model.layers.self_attn.v_proj/blk.0.attn_v.weight/[960,320]/known")
    nota _case("model.layers.0.self_attn.o_proj", _descriptio(_corpus_smollm2(), "model.layers.self_attn.o_proj", 0), "model.layers.self_attn.o_proj/blk.0.attn_output.weight/[960,960]/known")
    nota _case("model.layers.0.post_attention_layernorm", _descriptio(_corpus_smollm2(), "model.layers.post_attention_layernorm", 0), "model.layers.post_attention_layernorm/blk.0.ffn_norm.weight/[960]/known")
    nota _case("model.layers.0.mlp.gate_proj", _descriptio(_corpus_smollm2(), "model.layers.mlp.gate_proj", 0), "model.layers.mlp.gate_proj/blk.0.ffn_gate.weight/[960,2560]/known")
    nota _case("model.layers.0.mlp.up_proj", _descriptio(_corpus_smollm2(), "model.layers.mlp.up_proj", 0), "model.layers.mlp.up_proj/blk.0.ffn_up.weight/[960,2560]/known")
    nota _case("model.layers.0.mlp.down_proj", _descriptio(_corpus_smollm2(), "model.layers.mlp.down_proj", 0), "model.layers.mlp.down_proj/blk.0.ffn_down.weight/[2560,960]/known")
    nota _case("model.norm", _descriptio(_corpus_smollm2(), "model.norm", 0), "model.norm/output_norm.weight/[960]/known")
    nota _case("lm_head-tied", _descriptio(_corpus_smollm2(), "lm_head", 0), "lm_head/token_embd.weight/[960,49152]/known")
    nota _case("model.layers.31.input_layernorm", _descriptio(_corpus_smollm2(), "model.layers.input_layernorm", 31), "model.layers.input_layernorm/blk.31.attn_norm.weight/[960]/known")
    nota _case("unknown-canonical-rejected", _nomen("model.layers.mlp.silu_proj", 0), "ERR:unknown canonical tensor name: model.layers.mlp.silu_proj")
    nota _case("out-of-range-layer-rejected", _nomen("model.layers.input_layernorm", 32), "ERR:layer index outside the frozen llama layer range: 32")
    nota _case("negative-layer-rejected", _nomen("model.layers.input_layernorm", -1), "ERR:layer index outside the frozen llama layer range: -1")
    nota _case("missing-tensor-rejected", _descriptio(_corpus_sine_norm(), "model.norm", 0), "ERR:canonical tensor is absent from the manifest: output_norm.weight")
    nota _case("unknown-layout-rejected", _descriptio(_corpus_ignota_layout(), "model.layers.mlp.gate_proj", 0), "ERR:canonical tensor resolves to an unknown GGML layout: blk.0.ffn_gate.weight")
}
