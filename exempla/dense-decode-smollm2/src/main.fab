# SmolLM2-360M dense decode and KV-cache exemplar.
#
# Public entry: the `dense-decode-smollm2` executable package.
# Depends on: Gradus attention, cache, dtype, model, sampling, and tensor
# leaves, plus Norma process and filesystem I/O.
#
# WHY: the driver makes bounded artifact loading, prompt prefill, incremental
# KV-cache updates, and greedy continuation observable without claiming the
# higher-level generation API or a performance result.

import from "gradus:attention/rope" rope
import from "gradus:cache/kv" kv
import from "gradus:cache/structure" structure
import from "gradus:dtype" dtype
import from "gradus:model/artifact" artifact
import from "gradus:model/dense" dense
import from "gradus:model/gguf_manifest" gguf_manifest
import from "gradus:model/tensor_payload" tensor_payload
import from "gradus:model/tensor_view" tensor_view
import from "gradus:sampling" sampling
import from "gradus:tensor" tensor
import from "norma:process" process
import from "norma:fs" fs

# --- pinned oracle ----------------

const string PINNED_PATH ← "/Users/ianzepp/ai/models/SmolLM2-360M-Instruct-Q4_K_M.gguf"
const string PINNED_DIGEST ← "2fa3f013dcdd7b99f9b237717fa0b12d75bbb89984cc1274be1471a465bac9c2"
const int PINNED_BYTES ← 270590880
const int PINNED_DATA ← 1787040
const list<int> PINNED_TOKENS ← [504, 2365, 6354, 16438, 27003, 690, 260, 23790, 2767]
const int GOLDEN_TOP1 ← 30
const int VOCAB ← 49152
const int SLICE_CAP ← 16777216
const int GENERATE ← 3

union DecodeRunError {
    @ shared
    string message

    BadArguments,
    BadManifest,
    BadAdapter,
    BadBinding,
    BadSlice,
    BadForward
}

# --- artifact admission ----------

fn read_range(string via, int total, int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    if start < 0 or length < 0 or start > total - length {
        throw variant BadSource {message = "range request exceeds the artifact"}
    }
    const bytes data ← fs.read_range(via, start, length)
    if data.length() ≠ length {
        throw variant BadSource {message = "short range read"}
    }
    return data
}

fn prefix_range(list<int> prefix, int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    if start < 0 or length < 0 or start > prefix.length() - length {
        throw variant BadSource {message = "inspection attempted to read the tensor data region"}
    }
    const list<int> segment ← prefix.slice(start, start + length)
    const bytes segment_bytes ↤ segment
    return segment_bytes
}

fn ends_with(string s, string tail) → bool {
    if tail.length() ≻ s.length() then return false
    return s.slice(s.length() - tail.length(), s.length()) ≡ tail
}

fn tensor_slot(string name) → int {
    if ends_with(name, ".input_layernorm") then return 0
    if ends_with(name, ".self_attn.q_proj") then return 1
    if ends_with(name, ".self_attn.k_proj") then return 2
    if ends_with(name, ".self_attn.v_proj") then return 3
    if ends_with(name, ".self_attn.o_proj") then return 4
    if ends_with(name, ".post_attention_layernorm") then return 5
    if ends_with(name, ".mlp.gate_proj") then return 6
    if ends_with(name, ".mlp.up_proj") then return 7
    if ends_with(name, ".mlp.down_proj") then return 8
    return -1
}

# --- tensor loading ---------------

fn ids_text(list<int> ids) → string {
    var string out ← "["
    var bool first ← true
    for from ids const id {
        if not first { out ← out + ", " }
        out ← "§§"(out, id ↦ string)
        first ← false
    }
    return "§]"(out)
}

fn block_elements(tensor_view.TensorView v) → int {
    match v.layout {
        case gguf_manifest.Known const elements_per_block, bytes_per_block, byte_length {
            return elements_per_block
        }
        case gguf_manifest.Unknown const kind {
            return 0
        }
    }
}

fn slice_window(int remaining, int block) → int {
    if remaining ≤ SLICE_CAP then return remaining
    const int aligned ← (SLICE_CAP / block) * block
    if aligned ≺ block then return block
    return aligned
}

fn payload_limits(gguf_manifest.GgufManifest m, string gguf_name) → tuple<int, int> ⇥ DecodeRunError {
    do {
        return gguf_manifest.payload_limit(m, gguf_name)
    }
    catch err {
        throw variant BadManifest {message = "payload range failed for §: §"(gguf_name, err.message)}
    }
}

fn bind_view(gguf_manifest.GgufManifest m, tensor_payload.TensorPayload p) → tensor_view.TensorView ⇥ DecodeRunError {
    do {
        return tensor_view.links(m, p)
    }
    catch err {
        throw variant BadBinding {message = "view bind failed for §: §"(p.name, err.message)}
    }
}

fn materialize_slice(
    tensor_view.TensorView v,
    int off,
    int n,
    (int, int) → bytes ⇥ gguf_manifest.GgufManifestError source
) → list<f32> ⇥ DecodeRunError {
    do {
        return tensor_view.materialize_slice(v, off, n, source)
    }
    catch err {
        throw variant BadSlice {message = "window materialize failed for §: §"(v.name, err.message)}
    }
}

fn stage_tensor(list<f32> data, list<int> shape) → tensor.NumericBlock ⇥ DecodeRunError {
    do {
        return tensor.construct(data, shape)
    }
    catch err {
        throw variant BadSlice {message = "tensor construct failed: §"(err.message)}
    }
}

fn materialize_tensor(
    string via,
    int total,
    gguf_manifest.GgufManifest m,
    string gguf_name
) → tensor.NumericBlock ⇥ DecodeRunError {
    const tuple<int, int> limit ← payload_limits(m, gguf_name)
    const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
        name = gguf_name,
        absolute_start = limit[0],
        length = limit[1],
        bytes = ||
    }
    const tensor_view.TensorView v ← bind_view(m, p)
    const int block ← block_elements(v)
    if block ≺ 1 {
        throw variant BadSlice {message = "tensor layout has no block size: §"(gguf_name)}
    }
    var list<f32> data ← empty
    var int off ← 0
    while off ≺ v.elements {
        const int n ← slice_window(v.elements - off, block)
        const list<f32> part ← materialize_slice(
            v,
            off,
            n,
            (int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ read_range(via, total, start, length)
        )
        for from part const x {
            data.append(x)
        }
        off ← off + n
    }
    return stage_tensor(data, v.shape)
}

fn canonical_name(string family, int layer) → string ⇥ DecodeRunError {
    switch family {
        case "model.embed_tokens" {
            return "token_embd.weight"
        }
        case "model.norm" {
            return "output_norm.weight"
        }
        case "lm_head" {
            return "token_embd.weight"
        }
        default {
        }
    }
    if layer ≺ 0 or layer ≥ 32 {
        throw variant BadAdapter {message = "layer index outside the frozen llama layer range: §"(layer ↦ string)}
    }
    const string block ← "blk.§"(layer ↦ string)
    switch family {
        case "model.layers.input_layernorm" {
            return "§.attn_norm.weight"(block)
        }
        case "model.layers.self_attn.q_proj" {
            return "§.attn_q.weight"(block)
        }
        case "model.layers.self_attn.k_proj" {
            return "§.attn_k.weight"(block)
        }
        case "model.layers.self_attn.v_proj" {
            return "§.attn_v.weight"(block)
        }
        case "model.layers.self_attn.o_proj" {
            return "§.attn_output.weight"(block)
        }
        case "model.layers.post_attention_layernorm" {
            return "§.ffn_norm.weight"(block)
        }
        case "model.layers.mlp.gate_proj" {
            return "§.ffn_gate.weight"(block)
        }
        case "model.layers.mlp.up_proj" {
            return "§.ffn_up.weight"(block)
        }
        case "model.layers.mlp.down_proj" {
            return "§.ffn_down.weight"(block)
        }
        default {
            throw variant BadAdapter {message = "unknown canonical tensor name: §"(family)}
        }
    }
}

fn kmajor_to_linear(tensor.NumericBlock t) → tensor.NumericBlock ⇥ DecodeRunError {
    const list<int> f ← t.shape
    if f.length() ≠ 2 {
        throw variant BadAdapter {message = "linear weight must be rank 2"}
    }
    const int k ← f.get(0) coalesce 1
    const int n ← f.get(1) coalesce 1
    var list<f32> out ← empty
    var int i ← 0
    while i ≺ k {
        var int j ← 0
        while j ≺ n {
            out.append(t.data.get(j * k + i) coalesce 0.0)
            j ← j + 1
        }
        i ← i + 1
    }
    return stage_tensor(out, [k, n])
}

fn linear_family(string family) → bool {
    if family ≡ "lm_head" then return true
    if ends_with(family, ".self_attn.q_proj") then return true
    if ends_with(family, ".self_attn.k_proj") then return true
    if ends_with(family, ".self_attn.v_proj") then return true
    if ends_with(family, ".self_attn.o_proj") then return true
    if ends_with(family, ".mlp.gate_proj") then return true
    if ends_with(family, ".mlp.up_proj") then return true
    if ends_with(family, ".mlp.down_proj") then return true
    return false
}

fn load_tensor(
    string via,
    int total,
    gguf_manifest.GgufManifest m,
    string family,
    int layer
) → tensor.NumericBlock ⇥ DecodeRunError {
    const string gguf_name ← canonical_name(family, layer)
    const tensor.NumericBlock stored ← materialize_tensor(via, total, m, gguf_name)
    if linear_family(family) {
        return kmajor_to_linear(stored)
    }
    return stored
}

fn lookup_tensor(
    string name,
    int layer,
    tensor.NumericBlock embed,
    tensor.NumericBlock norm_s,
    list<list<tensor.NumericBlock>> strata
) → tensor.NumericBlock ⇥ dense.DenseError {
    if name ≡ "model.embed_tokens" then return embed
    if name ≡ "model.norm" then return norm_s
    if layer ≺ 0 or layer ≥ strata.length() {
        throw variant MissingTensor {message = "layer out of range: §"(layer ↦ string)}
    }
    const int slot ← tensor_slot(name)
    if slot ≺ 0 {
        throw variant MissingTensor {message = "unknown canonical tensor: §"(name)}
    }
    const list<tensor.NumericBlock> missing ← empty
    const list<tensor.NumericBlock> row ← strata.get(layer) coalesce missing
    if slot ≥ row.length() {
        throw variant MissingTensor {message = "layer slot missing: §"(name)}
    }
    const tensor.NumericBlock t ← row.get(slot) coalesce embed
    return t
}

# --- dense decode -----------------

fn logit(tensor.NumericBlock logits, int tok) → f32 {
    do {
        return logits.get([0, tok])
    }
    catch err {
        return 0.0
    }
}

fn all_finite(tensor.NumericBlock logits) → bool {
    for range 0 ‥ VOCAB const i {
        if not dtype.finite(logit(logits, i)) then return false
    }
    return true
}

fn indices(int n) → list<int> {
    var list<int> out ← empty
    for range 0 ‥ n const i {
        out.append(i)
    }
    return out
}

# --- decode driver ----------------

main {
    const list<string> args ← process.argv() ↦ list<string>
    var string via ← PINNED_PATH
    var int expected_data ← PINNED_DATA
    var string digest ← PINNED_DIGEST
    if args.length() ≥ 3 {
        via ← args.get(0) coalesce PINNED_PATH
        do {
            expected_data ← (args.get(1) coalesce "0") ↦ int
            digest ← args.get(2) coalesce PINNED_DIGEST
        }
        catch err {
            panic "usage: dense-decode-smollm2 <path> <data-offset> <sha256>"
        }
    }

    # --- manifest admission ------------

    print "policy: GGUF-A5 first decode/KV wiring slice"
    print "oracle: first greedy token == 30 (GATE 13 / GI2 prefill continuation)"
    print "engine: compiled rust (faber build --target rust; execute the printed binary)"
    print "model.path=§"(via)

    const int total ← fs.byte_length(via)
    print "model.bytes=§"(total ↦ string)
    if total ≠ PINNED_BYTES {
        panic "model byte length mismatch: observed=§ expected=§"(total ↦ string, PINNED_BYTES ↦ string)
    }

    const bytes prefix_bytes ← fs.read_range(via, 0, expected_data)
    if prefix_bytes.length() ≠ expected_data {
        panic "file adapter returned a short table-prefix read"
    }
    const value prefix_payload ← prefix_bytes ↦ value
    const list<int> prefix ← prefix_payload ↦ list<int>
    const artifact.ContentIdentity identity ← artifact.ContentIdentity {
        algorithm = "sha-256",
        digest = digest,
        length = total
    }

    var gguf_manifest.GgufManifest admitted ← gguf_manifest.GgufManifest {
        identity = identity,
        version = 0,
        alignment = 0,
        data_start = 0,
        artifact_length = 0,
        metadata = empty,
        tensors = empty
    }
    do {
        admitted ← gguf_manifest.inspect(
            (int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ prefix_range(prefix, start, length),
            total,
            identity
        )
    }
    catch err {
        panic "manifest admission failed: §"(err.message)
    }

    var tensor.NumericBlock embed ← tensor.default()
    var tensor.NumericBlock norm_s ← tensor.default()
    do {
        embed ← load_tensor(via, total, admitted, "model.embed_tokens", 0)
        norm_s ← load_tensor(via, total, admitted, "model.norm", 0)
    }
    catch err {
        panic "embed/norm load failed: §"(err.message)
    }

    # --- tensor loading ----------------

    const list<string> families ← [
        "model.layers.input_layernorm",
        "model.layers.self_attn.q_proj",
        "model.layers.self_attn.k_proj",
        "model.layers.self_attn.v_proj",
        "model.layers.self_attn.o_proj",
        "model.layers.post_attention_layernorm",
        "model.layers.mlp.gate_proj",
        "model.layers.mlp.up_proj",
        "model.layers.mlp.down_proj"
    ]
    var list<list<tensor.NumericBlock>> strata ← empty
    for range 0 ‥ 32 const layer {
        var list<tensor.NumericBlock> row ← empty
        for from families const family {
            do {
                row.append(load_tensor(via, total, admitted, family, layer))
            }
            catch err {
                panic "layer § §"(layer ↦ string, err.message)
            }
        }
        strata.append(row)
        print "loaded layer §"(layer ↦ string)
    }

    # --- engine configuration -----------

    var rope.RopeConfig rope_cfg ← rope.default()
    do {
        rope_cfg ← rope.construct_rope_config(100000.0, 1.0, rope.consecutive_policy())
    }
    catch err {
        panic "rope config failed: §"(err.message)
    }

    const dense.DenseConfig cfg ← dense.DenseConfig {
        layers = 32,
        heads = 15,
        kv_heads = 5,
        head_dim = 64,
        hidden_dim = 960,
        vocab = VOCAB,
        tied = true
    }

    var structure.KVStructure kv_structure ← structure.default_kv_structure()
    do {
        const structure.LayerSet set ← structure.construct_layer_set(indices(32), structure.dense_structure(), 5, 64)
        var list<structure.LayerSet> sets ← empty
        sets.append(set)
        kv_structure ← structure.construct_kv_structure(
            sets,
            structure.kv_dtype_f32(),
            structure.kv_dtype_f32(),
            structure.v_layout_transposed(),
            structure.sharing_gqa(),
            structure.attention_classic(),
            15,
            8192,
            8192
        )
    }
    catch err {
        panic "kv structure failed: §"(err.message)
    }

    var list<kv.KVCache> layers ← empty
    do {
        layers ← dense.empty_caches(kv_structure, "smollm2", "360m", "f32-staged", "smollm")
    }
    catch err {
        panic "empty caches failed: §"(err.message)
    }
    print "cache layers=§{layers} dim=§{dimension}"(
        layers: layers.length() ↦ string,
        dimension: ((layers.get(0) coalesce kv.default()).dimension) ↦ string
    )

    # --- prompt prefill ----------------

    var tensor.NumericBlock last ← tensor.default()
    var int pos ← 0
    for from PINNED_TOKENS const tok {
        print "decode_step prompt pos=§ token=§"(pos ↦ string, tok ↦ string)
        do {
            const dense.DenseStep step ← dense.decode_step(
                cfg,
                (string n, int s) → tensor.NumericBlock ⇥ dense.DenseError ∴ lookup_tensor(n, s, embed, norm_s, strata),
                tok,
                pos,
                0.00001,
                0.125,
                64,
                rope_cfg,
                layers
            )
            last ← step.logits
            layers ← step.layers
        }
        catch err {
            panic "prompt decode_step failed: §"(err.message)
        }
        pos ← pos + 1
    }

    if not all_finite(last) {
        panic "prompt-end logits are not finite"
    }

    var list<f32> row ← empty
    for range 0 ‥ VOCAB const i {
        row.append(logit(last, i))
    }

    var int first ← -1
    do {
        first ← sampling.max(row)
    }
    catch err {
        panic "sample failed: §"(err.message)
    }
    print "first_sampled=§"(first ↦ string)
    print "golden_top1=§"(GOLDEN_TOP1 ↦ string)
    print "first_matches=§"((first ≡ GOLDEN_TOP1) ↦ string)

    # --- greedy continuation ------------

    var list<int> generated ← empty
    generated.append(first)
    var int next ← first
    for range 1 ‥ GENERATE const g {
        print "decode_step generate pos=§ token=§"(pos ↦ string, next ↦ string)
        do {
            const dense.DenseStep step ← dense.decode_step(
                cfg,
                (string n, int s) → tensor.NumericBlock ⇥ dense.DenseError ∴ lookup_tensor(n, s, embed, norm_s, strata),
                next,
                pos,
                0.00001,
                0.125,
                64,
                rope_cfg,
                layers
            )
            last ← step.logits
            layers ← step.layers
        }
        catch err {
            panic "generate decode_step failed: §"(err.message)
        }
        if not all_finite(last) {
            panic "generated logits are not finite"
        }
        var list<f32> grow ← empty
        for range 0 ‥ VOCAB const i {
            grow.append(logit(last, i))
        }
        do {
            next ← sampling.max(grow)
        }
        catch err {
            panic "sample failed: §"(err.message)
        }
        if next ≺ 0 or next ≥ VOCAB {
            panic "sampled token out of vocabulary: §"(next ↦ string)
        }
        generated.append(next)
        pos ← pos + 1
    }

    print "generated=§"(ids_text(generated))
    print "n=§"(generated.length() ↦ string)
    const kv.KVCache layer0 ← layers.get(0) coalesce kv.default()
    print "cache_len=§"(layer0.length() ↦ string)

    var string divergence ← "none"
    if first ≠ GOLDEN_TOP1 {
        divergence ← "first token § vs golden §"(first ↦ string, GOLDEN_TOP1 ↦ string)
    }
    print "first_divergence=§"(divergence)
    if divergence ≡ "none" {
        print "DECODE: PASS"
    }
    else {
        print "DECODE: FAIL"
    }
}
