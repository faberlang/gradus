# GGUF-A1a/A1b executable synthetic package proof.
#
# The source builds bounded synthetic GGUF header/metadata/tensor-table
# corpora in memory, exercises parse/range/fragment operations, reads returned
# fields, and prints PASS/FAIL plus the observed result for every named case.
# It never opens a file or retains a model payload. The three committed
# binary fixtures are generator/oracle artifacts; this executable proof does
# not claim to have parsed them.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" gguf_manifest

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Synthetic GGUF fixtures need explicit little-endian wire bytes. These
# encoders stay local to the fixture builder; runtime artifact parsing uses
# the library's checked range seam instead.
fn u8_bytes(int n) → list<u8> {
    return [(n % 256) ∷ int<u8>]
}

fn u16_bytes(int n) → list<u8> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>]
}

fn u32_bytes(int n) → list<u8> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>]
}

fn u64_bytes(int n) → list<u8> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>, ((n ⇒ 32) % 256) ∷ int<u8>, ((n ⇒ 40) % 256) ∷ int<u8>, ((n ⇒ 48) % 256) ∷ int<u8>, ((n ⇒ 56) % 256) ∷ int<u8>]
}

fn join_bytes(list<u8> a, list<u8> b) → list<u8> {
    var list<u8> out ← empty
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

# The package MIR target has no text→bytes extraction arm. This finite ASCII
# fixture encoder keeps the synthetic wire corpus deterministic.
fn text_bytes(string s) → list<u8> {
    switch s {
        case "general.architecture" {
            return [103, 101, 110, 101, 114, 97, 108, 46, 97, 114, 99, 104, 105, 116, 101, 99, 116, 117, 114, 101]
        }
        case "general.custom_note" {
            return [103, 101, 110, 101, 114, 97, 108, 46, 99, 117, 115, 116, 111, 109, 95, 110, 111, 116, 101]
        }
        case "tokenizer.ggml.tokens" {
            return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115]
        }
        case "<s>" {
            return [60, 115, 62]
        }
        case "hello" {
            return [104, 101, 108, 108, 111]
        }
        case "token_embd.weight" {
            return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
        }
        case "blk.0.attn_norm.weight" {
            return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
        }
        case "qwen2" {
            return [113, 119, 101, 110, 50]
        }
        case "general.alignment" {
            return [103, 101, 110, 101, 114, 97, 108, 46, 97, 108, 105, 103, 110, 109, 101, 110, 116]
        }
        case "qwen2.custom_flag" {
            return [113, 119, 101, 110, 50, 46, 99, 117, 115, 116, 111, 109, 95, 102, 108, 97, 103]
        }
        case "world" {
            return [119, 111, 114, 108, 100]
        }
        case "blk.0.attn_q.weight" {
            return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
        }
        case "qwen35moe" {
            return [113, 119, 101, 110, 51, 53, 109, 111, 101]
        }
        case "qwen35moe.custom_flag" {
            return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 99, 117, 115, 116, 111, 109, 95, 102, 108, 97, 103]
        }
        case "blk.0.experts.0.weight" {
            return [98, 108, 107, 46, 48, 46, 101, 120, 112, 101, 114, 116, 115, 46, 48, 46, 119, 101, 105, 103, 104, 116]
        }
        case "bad.value" {
            return [98, 97, 100, 46, 118, 97, 108, 117, 101]
        }
        case "llama" {
            return [108, 108, 97, 109, 97]
        }
        case "same" {
            return [115, 97, 109, 101]
        }
        case "huge" {
            return [104, 117, 103, 101]
        }
        case "too_many" {
            return [116, 111, 111, 95, 109, 97, 110, 121]
        }
        case "scalar" {
            return [115, 99, 97, 108, 97, 114]
        }
        case "bad_q4k" {
            return [98, 97, 100, 95, 113, 52, 107]
        }
        case "known" {
            return [107, 110, 111, 119, 110]
        }
        case "unknown" {
            return [117, 110, 107, 110, 111, 119, 110]
        }
        case "overflow" {
            return [111, 118, 101, 114, 102, 108, 111, 119]
        }
        case "a" {
            return [97]
        }
        case "b" {
            return [98]
        }
        case "wire.uint8" {
            return [119, 105, 114, 101, 46, 117, 105, 110, 116, 56]
        }
        case "wire.int8" {
            return [119, 105, 114, 101, 46, 105, 110, 116, 56]
        }
        case "wire.uint16" {
            return [119, 105, 114, 101, 46, 117, 105, 110, 116, 49, 54]
        }
        case "wire.int16" {
            return [119, 105, 114, 101, 46, 105, 110, 116, 49, 54]
        }
        case "wire.uint32" {
            return [119, 105, 114, 101, 46, 117, 105, 110, 116, 51, 50]
        }
        case "wire.int32" {
            return [119, 105, 114, 101, 46, 105, 110, 116, 51, 50]
        }
        case "wire.float32" {
            return [119, 105, 114, 101, 46, 102, 108, 111, 97, 116, 51, 50]
        }
        case "wire.bool" {
            return [119, 105, 114, 101, 46, 98, 111, 111, 108]
        }
        case "wire.string" {
            return [119, 105, 114, 101, 46, 115, 116, 114, 105, 110, 103]
        }
        case "wire.array" {
            return [119, 105, 114, 101, 46, 97, 114, 114, 97, 121]
        }
        case "wire.nested" {
            return [119, 105, 114, 101, 46, 110, 101, 115, 116, 101, 100]
        }
        case "wire.uint64" {
            return [119, 105, 114, 101, 46, 117, 105, 110, 116, 54, 52]
        }
        case "wire.int64" {
            return [119, 105, 114, 101, 46, 105, 110, 116, 54, 52]
        }
        case "wire.float64" {
            return [119, 105, 114, 101, 46, 102, 108, 111, 97, 116, 54, 52]
        }
        default {
            return empty
        }
    }
}
fn to_bytes(list<u8> b) → bytes {
    var bytes o ← ||
    for from b const x {
        o.append(x)
    }
    return o
}

fn wire_string(string s) → list<u8> {
    const _ b ← text_bytes(s)
    return join_bytes(u64_bytes(b.length()), b)
}

fn metadata_entry(string key, int kind, list<u8> value) → list<u8> {
    return join_bytes(join_bytes(wire_string(key), u32_bytes(kind)), value)
}

fn array_value(int kind, int count, list<u8> value) → list<u8> {
    return join_bytes(join_bytes(u32_bytes(kind), u64_bytes(count)), value)
}

fn tensor_entry(string name, list<int> shape, int kind, int offset) → list<u8> {
    var list<u8> out ← join_bytes(wire_string(name), u32_bytes(shape.length()))
    for from shape const dim {
        out ← join_bytes(out, u64_bytes(dim))
    }
    return join_bytes(join_bytes(out, u32_bytes(kind)), u64_bytes(offset))
}

fn header(int tensors, int metadata) → list<u8> {
    return join_bytes(join_bytes([71, 71, 85, 70], u32_bytes(3)), join_bytes(u64_bytes(tensors), u64_bytes(metadata)))
}

fn corpus(list<u8> table, int alignment, int total, bool extra_data) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    var list<u8> b ← table
    for range b.length()‥data_offset const _ {
        b.append(0 ∷ int<u8>)
    }
    if extra_data {
        b.append(0 ∷ int<u8>)
    }
    const _ o ← to_bytes(b)
    return gguf_manifest.GgufCorpus {table = o, artifact_length = total, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = total}}
}

fn full_corpus(list<u8> table, int alignment, int payload) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    return corpus(table, alignment, data_offset + payload, false)
}

fn wire_equal(bytes actual, list<u8> expected) → bool {
    if actual.length() ≠ expected.length() then return false
    for range 0‥expected.length() const i {
        if actual.get(i) coalesce 0 ∷ int<u8> ≠ expected.get(i) coalesce 0 ∷ int<u8> then return false
    }
    return true
}

fn metadata_corpus() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(0, 14)
    table ← join_bytes(table, metadata_entry("wire.uint8", 0, u8_bytes(127)))
    table ← join_bytes(table, metadata_entry("wire.int8", 1, u8_bytes(254)))
    table ← join_bytes(table, metadata_entry("wire.uint16", 2, u16_bytes(4660)))
    table ← join_bytes(table, metadata_entry("wire.int16", 3, u16_bytes(65534)))
    table ← join_bytes(table, metadata_entry("wire.uint32", 4, u32_bytes(305419896)))
    table ← join_bytes(table, metadata_entry("wire.int32", 5, u32_bytes(4294967294)))
    table ← join_bytes(table, metadata_entry("wire.float32", 6, [0, 0, 128, 63]))
    table ← join_bytes(table, metadata_entry("wire.bool", 7, u8_bytes(1)))
    table ← join_bytes(table, metadata_entry("wire.string", 8, wire_string("hello")))
    table ← join_bytes(table, metadata_entry("wire.array", 9, array_value(2, 2, join_bytes(u16_bytes(4660), u16_bytes(43981)))))
    table ← join_bytes(table, metadata_entry("wire.nested", 9, array_value(9, 1, array_value(0, 2, [7, 8]))))
    table ← join_bytes(table, metadata_entry("wire.uint64", 10, u64_bytes(72623859790382856)))
    table ← join_bytes(table, metadata_entry("wire.int64", 11, [254, 255, 255, 255, 255, 255, 255, 255]))
    table ← join_bytes(table, metadata_entry("wire.float64", 12, [0, 0, 0, 0, 0, 0, 240, 63]))
    return full_corpus(table, 32, 0)
}

fn number_observe(gguf_manifest.GgufManifest m, string key) → string {
    do {
        return gguf_manifest.number(m, key) ↦ string
    }
    catch err {
        return "ERR:§"(err.message)
    }
}

fn metadata_wire_result() → string {
    do {
        const _ m ← gguf_manifest.parse(metadata_corpus())
        if not wire_equal(gguf_manifest.metadata(m, "wire.uint8").payload_wire, u8_bytes(127)) then return "uint8-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.int8").payload_wire, u8_bytes(254)) then return "int8-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.uint16").payload_wire, u16_bytes(4660)) then return "uint16-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.int16").payload_wire, u16_bytes(65534)) then return "int16-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.uint32").payload_wire, u32_bytes(305419896)) then return "uint32-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.int32").payload_wire, u32_bytes(4294967294)) then return "int32-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.float32").payload_wire, [0, 0, 128, 63]) then return "float32-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.bool").payload_wire, u8_bytes(1)) then return "bool-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.string").payload_wire, wire_string("hello")) then return "string-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.array").payload_wire, array_value(2, 2, join_bytes(u16_bytes(4660), u16_bytes(43981)))) then return "array-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.nested").payload_wire, array_value(9, 1, array_value(0, 2, [7, 8]))) then return "nested-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.uint64").payload_wire, u64_bytes(72623859790382856)) then return "uint64-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.int64").payload_wire, [254, 255, 255, 255, 255, 255, 255, 255]) then return "int64-bytes"
        if not wire_equal(gguf_manifest.metadata(m, "wire.float64").payload_wire, [0, 0, 0, 0, 0, 0, 240, 63]) then return "float64-bytes"
        if number_observe(m, "wire.uint8") ≠ "127" then return "uint8-value"
        if number_observe(m, "wire.int8") ≠ "-2" then return "int8-value"
        if number_observe(m, "wire.uint16") ≠ "4660" then return "uint16-value"
        if number_observe(m, "wire.int16") ≠ "-2" then return "int16-value"
        if number_observe(m, "wire.uint32") ≠ "305419896" then return "uint32-value"
        if number_observe(m, "wire.int32") ≠ "-2" then return "int32-value"
        if number_observe(m, "wire.uint64") ≠ "72623859790382856" then return "uint64-value"
        if number_observe(m, "wire.int64") ≠ "-2" then return "int64-value"
        if gguf_manifest.text(m, "wire.string") ≠ "hello" then return "string-value"
        return "13-kinds/bytes"
    }
    catch err {
        return err.message
    }
}

fn metadata_nested_result() → string {
    do {
        const _ m ← gguf_manifest.parse(metadata_corpus())
        const _ nested ← gguf_manifest.metadata(m, "wire.nested").payload_wire
        if not wire_equal(nested, array_value(9, 1, array_value(0, 2, [7, 8]))) then return "nested-mismatch"
        return "§-bytes"(nested.length() ↦ string)
    }
    catch err {
        return err.message
    }
}

fn metadata_bool_float_result() → string {
    do {
        const _ m ← gguf_manifest.parse(metadata_corpus())
        if number_observe(m, "wire.bool") ≠ "ERR:metadata value is not an unsigned integer" then return "bool-accepted"
        if number_observe(m, "wire.float32") ≠ "ERR:metadata value is not an unsigned integer" then return "float32-accepted"
        if number_observe(m, "wire.float64") ≠ "ERR:metadata value is not an unsigned integer" then return "float64-accepted"
        return "bool-preserved/number-rejected"
    }
    catch err {
        return err.message
    }
}

fn descriptor_result(gguf_manifest.GgufCorpus corpus, string name) → string {
    do {
        const _ m ← gguf_manifest.parse(corpus)
        const _ t ← gguf_manifest.find_tensor(m, name)
        match t.layout {
            case gguf_manifest.Known const elements_per_block, bytes_per_block, byte_length {
                return "§{data}/§{offset}/§{elements}/§{length}"(data: m.data_start ↦ string, offset: t.relative_offset ↦ string, elements: t.elements ↦ string, length: byte_length ↦ string)
            }
            case gguf_manifest.Unknown const unknown_kind {
                return "unknown"
            }
        }
    }
    catch err {
        return err.message
    }
}

fn reordered_gapped() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(2, 0)
    table ← join_bytes(table, tensor_entry("b", [4, 1], 0, 160))
    table ← join_bytes(table, tensor_entry("a", [4, 1], 0, 0))
    return full_corpus(table, 32, 256)
}

fn boundary_table() → list<u8> {
    return join_bytes(header(0, 1), metadata_entry("general.architecture", 8, wire_string("llama")))
}

fn table_end() → gguf_manifest.GgufCorpus {
    const _ table ← boundary_table()
    const int data_offset ← ((table.length() + 31) / 32) * 32
    return gguf_manifest.GgufCorpus {table = to_bytes(table), artifact_length = data_offset, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = data_offset}}
}

fn padding_end() → gguf_manifest.GgufCorpus {
    const _ table ← boundary_table()
    const int data_offset ← ((table.length() + 31) / 32) * 32
    var list<u8> b ← table
    b.append(0 ∷ int<u8>)
    return gguf_manifest.GgufCorpus {table = to_bytes(b), artifact_length = data_offset, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = data_offset}}
}

fn boundary_result(gguf_manifest.GgufCorpus corpus) → string {
    do {
        const _ m ← gguf_manifest.parse(corpus)
        return "§/§"(m.data_start ↦ string, m.artifact_length ↦ string)
    }
    catch err {
        return err.message
    }
}

fn truncated() → gguf_manifest.GgufCorpus {
    const list<u8> b ← [71, 71, 85, 70]
    const _ o ← to_bytes(b)
    return gguf_manifest.GgufCorpus {table = o, artifact_length = 32, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = 32}}
}

fn llama_corpus() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(2, 3)
    table ← join_bytes(table, metadata_entry("general.architecture", 8, wire_string("llama")))
    table ← join_bytes(table, metadata_entry("general.custom_note", 8, wire_string("unknown metadata")))
    table ← join_bytes(table, metadata_entry("tokenizer.ggml.tokens", 9, join_bytes(join_bytes(u32_bytes(8), u64_bytes(2)), join_bytes(wire_string("<s>"), wire_string("hello")))))
    table ← join_bytes(table, tensor_entry("token_embd.weight", [4, 8], 0, 0))
    table ← join_bytes(table, tensor_entry("blk.0.attn_norm.weight", [8], 1, 160))
    return corpus(table, 32, 560, false)
}

fn qwen2_corpus() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(2, 4)
    table ← join_bytes(table, metadata_entry("general.architecture", 8, wire_string("qwen2")))
    table ← join_bytes(table, metadata_entry("general.alignment", 4, u32_bytes(64)))
    table ← join_bytes(table, metadata_entry("qwen2.custom_flag", 4, u32_bytes(7)))
    table ← join_bytes(table, metadata_entry("tokenizer.ggml.tokens", 9, join_bytes(join_bytes(u32_bytes(8), u64_bytes(2)), join_bytes(wire_string("hello"), wire_string("world")))))
    table ← join_bytes(table, tensor_entry("blk.0.attn_q.weight", [256, 1, 1], 12, 0))
    table ← join_bytes(table, tensor_entry("blk.0.attn_norm.weight", [2, 2], 0, 192))
    return corpus(table, 64, 656, false)
}

fn qwen35moe_corpus() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(2, 4)
    table ← join_bytes(table, metadata_entry("general.architecture", 8, wire_string("qwen35moe")))
    table ← join_bytes(table, metadata_entry("general.alignment", 4, u32_bytes(128)))
    table ← join_bytes(table, metadata_entry("qwen35moe.custom_flag", 4, u32_bytes(35)))
    table ← join_bytes(table, metadata_entry("tokenizer.ggml.tokens", 9, join_bytes(join_bytes(u32_bytes(8), u64_bytes(2)), join_bytes(wire_string("hello"), wire_string("world")))))
    table ← join_bytes(table, tensor_entry("blk.0.experts.0.weight", [2, 3, 4], 999, 0))
    table ← join_bytes(table, tensor_entry("blk.0.attn_norm.weight", [2, 2], 30, 64))
    return corpus(table, 128, 584, false)
}

fn bad_magic() → gguf_manifest.GgufCorpus {
    const list<u8> h ← header(0, 0)
    return corpus(join_bytes([0], h.take(23)), 32, 32, false)
}

fn bad_version() → gguf_manifest.GgufCorpus {
    const list<u8> h ← header(0, 0)
    return corpus(join_bytes(join_bytes(h.take(4), u32_bytes(2)), join_bytes(u64_bytes(0), u64_bytes(0))), 32, 32, false)
}

fn wrong_alignment(int kind, list<u8> value) → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(0, 1)
    table ← join_bytes(table, metadata_entry("general.alignment", kind, value))
    return corpus(table, 32, 32, false)
}

fn malformed_value(int kind, list<u8> value) → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(0, 1)
    table ← join_bytes(table, metadata_entry("bad.value", kind, value))
    return corpus(table, 32, 32, false)
}

fn duplicate_metadata() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(0, 2)
    table ← join_bytes(table, metadata_entry("general.architecture", 8, wire_string("llama")))
    table ← join_bytes(table, metadata_entry("general.architecture", 8, wire_string("qwen2")))
    return corpus(table, 32, 32, false)
}

fn duplicate_tensors() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(2, 0)
    table ← join_bytes(table, tensor_entry("same", [8], 0, 0))
    table ← join_bytes(table, tensor_entry("same", [8], 0, 32))
    return corpus(table, 32, 64, false)
}

fn dimension_ceiling() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(1, 0)
    table ← join_bytes(table, tensor_entry("huge", [1000000001], 0, 0))
    return corpus(table, 32, 64, false)
}

fn element_overflow() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(1, 0)
    table ← join_bytes(table, tensor_entry("too_many", [1000000000, 2], 0, 0))
    return corpus(table, 32, 64, false)
}

fn rank_zero() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(1, 0)
    table ← join_bytes(table, tensor_entry("scalar", [], 0, 0))
    return corpus(table, 32, 64, false)
}

fn non_block_quant() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(1, 0)
    table ← join_bytes(table, tensor_entry("bad_q4k", [1, 1, 256], 12, 0))
    return corpus(table, 32, 144, false)
}

fn known_out_of_file() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(1, 0)
    table ← join_bytes(table, tensor_entry("known", [256, 1], 12, 0))
    return corpus(table, 32, 100, false)
}

fn unknown_out_of_file() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(1, 0)
    table ← join_bytes(table, tensor_entry("unknown", [2, 3, 4], 999, 1000))
    return corpus(table, 32, 100, false)
}

fn offset_overflow() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(1, 0)
    table ← join_bytes(table, tensor_entry("overflow", [2, 3, 4], 999, 9223372036854775807))
    return corpus(table, 32, 9223372036854775807, false)
}

fn overlap() → gguf_manifest.GgufCorpus {
    var list<u8> table ← header(2, 0)
    table ← join_bytes(table, tensor_entry("a", [8], 0, 0))
    table ← join_bytes(table, tensor_entry("b", [8], 0, 16))
    return corpus(table, 32, 192, false)
}

fn extra_data_region() → gguf_manifest.GgufCorpus {
    return corpus(header(0, 0), 32, 32, true)
}

fn identity_mismatch() → gguf_manifest.GgufCorpus {
    const _ table ← header(0, 0)
    const int data_offset ← ((table.length() + 31) / 32) * 32
    var list<u8> b ← table
    for range b.length()‥data_offset const _ {
        b.append(0 ∷ int<u8>)
    }
    const _ o ← to_bytes(b)
    return gguf_manifest.GgufCorpus {table = o, artifact_length = data_offset, identity = artifact.ContentIdentity {algorithm = "md5", digest = F_DIGEST, length = data_offset}}
}

fn read_llama(int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    const _ corpus ← llama_corpus()
    const _ table ← corpus.table
    if (start ≺ 0 or length ≺ 0) or start + length ≻ corpus.artifact_length then throw variant BadSource {message = "synthetic range is outside the artifact"}
    var bytes out ← ||
    for range 0‥length const i {
        const int index ← start + i
        if index ≺ table.length() {
            out.append(table.get(index) coalesce 0 ∷ int<u8>)
        }
        else {
            out.append((index % 256) ∷ int<u8>)
        }
        i ↑
    }
    return out
}

fn read_failed(int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    throw variant BadSource {message = "synthetic read failed"}
}

fn read_short(int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    var bytes out ← ||
    for range 0‥(length - 1) const _ {
        out.append(0 ∷ int<u8>)
    }
    return out
}

fn inspect_range_result() → string {
    do {
        const _ corpus ← llama_corpus()
        const _ m ← gguf_manifest.inspect((int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ read_llama(start, length), corpus.artifact_length, corpus.identity)
        return "§/§/§"(gguf_manifest.text(m, "general.architecture"), m.tensors.length() ↦ string, m.data_start ↦ string)
    }
    catch err {
        return err.message
    }
}

fn inspect_failure_result(bool brevis) → string {
    do {
        const _ corpus ← llama_corpus()
        if brevis {
            gguf_manifest.inspect((int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ read_short(start, length), corpus.artifact_length, corpus.identity)
        }
        else {
            gguf_manifest.inspect((int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ read_failed(start, length), corpus.artifact_length, corpus.identity)
        }
        return "unexpected-success"
    }
    catch err {
        return err.message
    }
}

fn fragment_result(string name, int start, int length) → string {
    do {
        const _ m ← gguf_manifest.parse(llama_corpus())
        const _ bytes ← gguf_manifest.read_fragment(m, name, start, length, (int off, int len) → bytes ⇥ gguf_manifest.GgufManifestError ∴ read_llama(off, len))
        if wire_equal(bytes, [35, 36, 37, 38]) then return "exact-bytes"
        return "wrong-bytes"
    }
    catch err {
        return err.message
    }
}

fn fragment_unknown_layout_result() → string {
    do {
        const _ m ← gguf_manifest.parse(qwen35moe_corpus())
        gguf_manifest.read_fragment(m, "blk.0.experts.0.weight", 0, 1, (int off, int len) → bytes ⇥ gguf_manifest.GgufManifestError ∴ read_llama(off, len))
        return "unexpected-success"
    }
    catch err {
        return err.message
    }
}

fn fragment_source_failure_result(bool brevis) → string {
    do {
        const _ m ← gguf_manifest.parse(llama_corpus())
        if brevis {
            gguf_manifest.read_fragment(m, "token_embd.weight", 0, 4, (int off, int len) → bytes ⇥ gguf_manifest.GgufManifestError ∴ read_short(off, len))
        }
        else {
            gguf_manifest.read_fragment(m, "token_embd.weight", 0, 4, (int off, int len) → bytes ⇥ gguf_manifest.GgufManifestError ∴ read_failed(off, len))
        }
        return "unexpected-success"
    }
    catch err {
        return err.message
    }
}

fn parse_result(gguf_manifest.GgufCorpus corpus) → string {
    do {
        const _ m ← gguf_manifest.parse(corpus)
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn surface_result(gguf_manifest.GgufCorpus corpus, string tensor_name) → string {
    do {
        const _ m ← gguf_manifest.parse(corpus)
        const _ arch ← gguf_manifest.text(m, "general.architecture")
        const _ t ← gguf_manifest.find_tensor(m, tensor_name)
        t.layout
        return "§/§/§/§"(arch, m.alignment ↦ string, t.shape.get(0) coalesce 0 ↦ string, t.dtype_ggml ↦ string)
    }
    catch err {
        return err.message
    }
}

fn case_result(string name, string observed, string expected) → string {
    if observed ≡ expected then return "§{name}: PASS observed=§{observed}"(name: name, observed: observed)
    return "§{name}: FAIL expected=§{expected} observed=§{observed}"(name: name, expected: expected, observed: observed)
}

main {
    # --- surface and architecture dispatch --------------------------------
    print case_result("llama-default-and-unknown-metadata", surface_result(llama_corpus(), "token_embd.weight"), "llama/32/4/0")
    print case_result("qwen2-custom-alignment-rank3-q4k", surface_result(qwen2_corpus(), "blk.0.attn_q.weight"), "qwen2/64/256/12")
    print case_result("qwen35moe-mixed-unknown-layout", surface_result(qwen35moe_corpus(), "blk.0.experts.0.weight"), "qwen35moe/128/2/999")
    print case_result("unknown-layout-inspectability", parse_result(qwen35moe_corpus()), "ok")

    # --- malformed corpus rejection ---------------------------------------
    print case_result("malformed-magic", parse_result(bad_magic()), "not a GGUF file — bad magic")
    print case_result("malformed-version", parse_result(bad_version()), "unsupported GGUF version: 2")
    print case_result("truncation", parse_result(truncated()), "truncated GGUF header")
    print case_result("wrong-alignment-wire-kind", parse_result(wrong_alignment(7, [1])), "general.alignment must use GGUF UINT32 wire kind")
    print case_result("invalid-alignment-value", parse_result(wrong_alignment(4, u32_bytes(3))), "general.alignment must be a positive power of two")
    print case_result("malformed-bool", parse_result(malformed_value(7, [2])), "malformed GGUF bool value")
    print case_result("malformed-string", parse_result(malformed_value(8, join_bytes(u64_bytes(1), [255]))), "GGUF string is not valid UTF-8")
    print case_result("duplicate-metadata", parse_result(duplicate_metadata()), "duplicate GGUF metadata key: general.architecture")
    print case_result("duplicate-tensor-name", parse_result(duplicate_tensors()), "duplicate GGUF tensor name: same")
    print case_result("dimension-ceiling", parse_result(dimension_ceiling()), "tensor dimension is outside the bounded range")
    print case_result("element-overflow", parse_result(element_overflow()), "tensor element count exceeds the bounded range")
    print case_result("rank-zero", parse_result(rank_zero()), "tensor rank must be at least one")
    print case_result("first-dimension-q4k-block", parse_result(non_block_quant()), "tensor first dimension is not a complete GGML block")
    print case_result("known-offset-out-of-file", parse_result(known_out_of_file()), "known GGML tensor range exceeds the artifact")
    print case_result("unknown-offset-out-of-file", parse_result(unknown_out_of_file()), "GGML tensor offset exceeds the artifact")
    print case_result("checked-offset-overflow", parse_result(offset_overflow()), "checked offset addition overflow")
    print case_result("known-range-overlap", parse_result(overlap()), "known GGML tensor ranges overlap")
    print case_result("extra-data-region-byte", parse_result(extra_data_region()), "bounded GGUF corpus contains bytes from the data region")
    print case_result("identity-mismatch", parse_result(identity_mismatch()), "content identity does not match the supplied artifact length")

    # --- metadata and descriptor observations -----------------------------
    print case_result("metadata-13-wire-kinds", metadata_wire_result(), "13-kinds/bytes")
    print case_result("nested-array-preservation", metadata_nested_result(), "26-bytes")
    print case_result("bool-and-float-number-rejects", metadata_bool_float_result(), "bool-preserved/number-rejected")
    print case_result("descriptor-offset-elements-known-length", descriptor_result(llama_corpus(), "blk.0.attn_norm.weight"), "288/160/8/16")
    print case_result("custom-alignment-data-offset", descriptor_result(qwen2_corpus(), "blk.0.attn_norm.weight"), "384/192/4/16")
    print case_result("reordered-gapped-ranges", descriptor_result(reordered_gapped(), "b"), "128/160/4/16")

    # --- range-source and fragment receipts -------------------------------
    print case_result("corpus-table-end-accepted", boundary_result(table_end()), "96/96")
    print case_result("corpus-padding-end-accepted", boundary_result(padding_end()), "96/96")
    print case_result("range-source-inspection", inspect_range_result(), "llama/2/288")
    print case_result("range-source-failure", inspect_failure_result(false), "synthetic read failed")
    print case_result("range-source-short-read", inspect_failure_result(true), "range source returned an unexpected byte length")
    print case_result("tensor-fragment-exact", fragment_result("token_embd.weight", 3, 4), "exact-bytes")
    print case_result("tensor-fragment-negative", fragment_result("token_embd.weight", -1, 4), "tensor fragment range is negative")
    print case_result("tensor-fragment-out-of-range", fragment_result("token_embd.weight", 127, 2), "tensor fragment range exceeds the known tensor")
    print case_result("tensor-fragment-unknown-layout", fragment_unknown_layout_result(), "tensor layout is unknown; payload fragment is unavailable")
    print case_result("tensor-fragment-source-failure", fragment_source_failure_result(false), "synthetic read failed")
    print case_result("tensor-fragment-short-read", fragment_source_failure_result(true), "range source returned an unexpected byte length")
}
