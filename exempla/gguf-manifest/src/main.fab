+++
locale = "en"
+++
# GGUF-A1a/A1b executable synthetic package proof.
#
# The source builds bounded synthetic GGUF header/metadata/tensor-table
# corpora in memory, exercises parse/range/fragment operations, reads returned
# fields, and prints PASS/FAIL plus the observed result for every named case.
# It never opens a file or retains a model payload. The three committed
# binary fixtures are generator/oracle artifacts; this executable proof does
# not claim to have parsed them.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" gguf_manifest

const string F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn _u8(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>]
}

fn _u16(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>]
}

fn _u32(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>]
}

fn _u64(int n) → list<int<u8>> {
    return [(n % 256) ∷ int<u8>, ((n ⇒ 8) % 256) ∷ int<u8>, ((n ⇒ 16) % 256) ∷ int<u8>, ((n ⇒ 24) % 256) ∷ int<u8>, ((n ⇒ 32) % 256) ∷ int<u8>, ((n ⇒ 40) % 256) ∷ int<u8>, ((n ⇒ 48) % 256) ∷ int<u8>, ((n ⇒ 56) % 256) ∷ int<u8>]
}

fn _join(list<int<u8>> a, list<int<u8>> b) → list<int<u8>> {
    var list<int<u8>> out ← empty
    for from a const x {
        out.append(x)
    }
    for from b const x {
        out.append(x)
    }
    return out
}

fn _text_bytes(string s) → list<int<u8>> {
    # The package MIR target has no text→bytes extraction arm. The
    # builders use a finite ASCII corpus, so keep this fixture encoder
    # explicit and deterministic rather than claiming a general text codec.
    if s ≡ "general.architecture" then return [103, 101, 110, 101, 114, 97, 108, 46, 97, 114, 99, 104, 105, 116, 101, 99, 116, 117, 114, 101]
    if s ≡ "general.custom_note" then return [103, 101, 110, 101, 114, 97, 108, 46, 99, 117, 115, 116, 111, 109, 95, 110, 111, 116, 101]
    if s ≡ "tokenizer.ggml.tokens" then return [116, 111, 107, 101, 110, 105, 122, 101, 114, 46, 103, 103, 109, 108, 46, 116, 111, 107, 101, 110, 115]
    if s ≡ "<s>" then return [60, 115, 62]
    if s ≡ "hello" then return [104, 101, 108, 108, 111]
    if s ≡ "token_embd.weight" then return [116, 111, 107, 101, 110, 95, 101, 109, 98, 100, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "blk.0.attn_norm.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 110, 111, 114, 109, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "qwen2" then return [113, 119, 101, 110, 50]
    if s ≡ "general.alignment" then return [103, 101, 110, 101, 114, 97, 108, 46, 97, 108, 105, 103, 110, 109, 101, 110, 116]
    if s ≡ "qwen2.custom_flag" then return [113, 119, 101, 110, 50, 46, 99, 117, 115, 116, 111, 109, 95, 102, 108, 97, 103]
    if s ≡ "world" then return [119, 111, 114, 108, 100]
    if s ≡ "blk.0.attn_q.weight" then return [98, 108, 107, 46, 48, 46, 97, 116, 116, 110, 95, 113, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "qwen35moe" then return [113, 119, 101, 110, 51, 53, 109, 111, 101]
    if s ≡ "qwen35moe.custom_flag" then return [113, 119, 101, 110, 51, 53, 109, 111, 101, 46, 99, 117, 115, 116, 111, 109, 95, 102, 108, 97, 103]
    if s ≡ "blk.0.experts.0.weight" then return [98, 108, 107, 46, 48, 46, 101, 120, 112, 101, 114, 116, 115, 46, 48, 46, 119, 101, 105, 103, 104, 116]
    if s ≡ "bad.value" then return [98, 97, 100, 46, 118, 97, 108, 117, 101]
    if s ≡ "llama" then return [108, 108, 97, 109, 97]
    if s ≡ "same" then return [115, 97, 109, 101]
    if s ≡ "huge" then return [104, 117, 103, 101]
    if s ≡ "too_many" then return [116, 111, 111, 95, 109, 97, 110, 121]
    if s ≡ "scalar" then return [115, 99, 97, 108, 97, 114]
    if s ≡ "bad_q4k" then return [98, 97, 100, 95, 113, 52, 107]
    if s ≡ "known" then return [107, 110, 111, 119, 110]
    if s ≡ "unknown" then return [117, 110, 107, 110, 111, 119, 110]
    if s ≡ "overflow" then return [111, 118, 101, 114, 102, 108, 111, 119]
    if s ≡ "a" then return [97]
    if s ≡ "b" then return [98]
    if s ≡ "wire.uint8" then return [119, 105, 114, 101, 46, 117, 105, 110, 116, 56]
    if s ≡ "wire.int8" then return [119, 105, 114, 101, 46, 105, 110, 116, 56]
    if s ≡ "wire.uint16" then return [119, 105, 114, 101, 46, 117, 105, 110, 116, 49, 54]
    if s ≡ "wire.int16" then return [119, 105, 114, 101, 46, 105, 110, 116, 49, 54]
    if s ≡ "wire.uint32" then return [119, 105, 114, 101, 46, 117, 105, 110, 116, 51, 50]
    if s ≡ "wire.int32" then return [119, 105, 114, 101, 46, 105, 110, 116, 51, 50]
    if s ≡ "wire.float32" then return [119, 105, 114, 101, 46, 102, 108, 111, 97, 116, 51, 50]
    if s ≡ "wire.bool" then return [119, 105, 114, 101, 46, 98, 111, 111, 108]
    if s ≡ "wire.string" then return [119, 105, 114, 101, 46, 115, 116, 114, 105, 110, 103]
    if s ≡ "wire.array" then return [119, 105, 114, 101, 46, 97, 114, 114, 97, 121]
    if s ≡ "wire.nested" then return [119, 105, 114, 101, 46, 110, 101, 115, 116, 101, 100]
    if s ≡ "wire.uint64" then return [119, 105, 114, 101, 46, 117, 105, 110, 116, 54, 52]
    if s ≡ "wire.int64" then return [119, 105, 114, 101, 46, 105, 110, 116, 54, 52]
    if s ≡ "wire.float64" then return [119, 105, 114, 101, 46, 102, 108, 111, 97, 116, 54, 52]
    return []
}

fn _bytes(list<int<u8>> b) → bytes {
    var bytes o ← ||
    for from b const x {
        o.append(x)
    }
    return o
}

fn _str(string s) → list<int<u8>> {
    const list<int<u8>> b ← _text_bytes(s)
    return _join(_u64(b.length()), b)
}

fn _kv(string key, int kind, list<int<u8>> value) → list<int<u8>> {
    return _join(_join(_str(key), _u32(kind)), value)
}

fn _array(int kind, int count, list<int<u8>> value) → list<int<u8>> {
    return _join(_join(_u32(kind), _u64(count)), value)
}

fn _tensor(string name, list<int> shape, int kind, int offset) → list<int<u8>> {
    var list<int<u8>> out ← _join(_str(name), _u32(shape.length()))
    for from shape const dim {
        out ← _join(out, _u64(dim))
    }
    return _join(_join(out, _u32(kind)), _u64(offset))
}

fn _header(int tensors, int metadata) → list<int<u8>> {
    return _join(_join([71, 71, 85, 70], _u32(3)), _join(_u64(tensors), _u64(metadata)))
}

fn _corpus(list<int<u8>> table, int alignment, int total, bool extra_data) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    if extra_data {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← _bytes(b)
    return gguf_manifest.GgufCorpus {table = o, artifact_length = total, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = total}}
}

fn _full(list<int<u8>> table, int alignment, int payload) → gguf_manifest.GgufCorpus {
    const int data_offset ← (((table.length() + alignment) - 1) / alignment) * alignment
    return _corpus(table, alignment, data_offset + payload, false)
}

fn _wire_equal(bytes actual, list<int<u8>> expected) → bool {
    if actual.length() ≠ expected.length() then return false
    var int i ← 0
    while i ≺ expected.length() {
        if actual.get(i) coalesce 0 ∷ int<u8> ≠ expected.get(i) coalesce 0 ∷ int<u8> then return false
        i ↑
    }
    return true
}

fn _metadata_corpus() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(0, 14)
    table ← _join(table, _kv("wire.uint8", 0, _u8(127)))
    table ← _join(table, _kv("wire.int8", 1, _u8(254)))
    table ← _join(table, _kv("wire.uint16", 2, _u16(4660)))
    table ← _join(table, _kv("wire.int16", 3, _u16(65534)))
    table ← _join(table, _kv("wire.uint32", 4, _u32(305419896)))
    table ← _join(table, _kv("wire.int32", 5, _u32(4294967294)))
    table ← _join(table, _kv("wire.float32", 6, [0, 0, 128, 63]))
    table ← _join(table, _kv("wire.bool", 7, _u8(1)))
    table ← _join(table, _kv("wire.string", 8, _str("hello")))
    table ← _join(table, _kv("wire.array", 9, _array(2, 2, _join(_u16(4660), _u16(43981)))))
    table ← _join(table, _kv("wire.nested", 9, _array(9, 1, _array(0, 2, [7, 8]))))
    table ← _join(table, _kv("wire.uint64", 10, _u64(72623859790382856)))
    table ← _join(table, _kv("wire.int64", 11, [254, 255, 255, 255, 255, 255, 255, 255]))
    table ← _join(table, _kv("wire.float64", 12, [0, 0, 0, 0, 0, 0, 240, 63]))
    return _full(table, 32, 0)
}

fn _number_observe(gguf_manifest.GgufManifest m, string key) → string {
    do {
        return gguf_manifest.number(m, key) ↦ string
    }
    catch err {
        return "ERR:" + err.message
    }
}

fn _metadata_wire_result() → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(_metadata_corpus())
        if not _wire_equal(gguf_manifest.metadata(m, "wire.uint8").payload_wire, _u8(127)) then return "uint8-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.int8").payload_wire, _u8(254)) then return "int8-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.uint16").payload_wire, _u16(4660)) then return "uint16-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.int16").payload_wire, _u16(65534)) then return "int16-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.uint32").payload_wire, _u32(305419896)) then return "uint32-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.int32").payload_wire, _u32(4294967294)) then return "int32-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.float32").payload_wire, [0, 0, 128, 63]) then return "float32-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.bool").payload_wire, _u8(1)) then return "bool-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.string").payload_wire, _str("hello")) then return "string-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.array").payload_wire, _array(2, 2, _join(_u16(4660), _u16(43981)))) then return "array-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.nested").payload_wire, _array(9, 1, _array(0, 2, [7, 8]))) then return "nested-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.uint64").payload_wire, _u64(72623859790382856)) then return "uint64-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.int64").payload_wire, [254, 255, 255, 255, 255, 255, 255, 255]) then return "int64-bytes"
        if not _wire_equal(gguf_manifest.metadata(m, "wire.float64").payload_wire, [0, 0, 0, 0, 0, 0, 240, 63]) then return "float64-bytes"
        if _number_observe(m, "wire.uint8") ≠ "127" then return "uint8-value"
        if _number_observe(m, "wire.int8") ≠ "-2" then return "int8-value"
        if _number_observe(m, "wire.uint16") ≠ "4660" then return "uint16-value"
        if _number_observe(m, "wire.int16") ≠ "-2" then return "int16-value"
        if _number_observe(m, "wire.uint32") ≠ "305419896" then return "uint32-value"
        if _number_observe(m, "wire.int32") ≠ "-2" then return "int32-value"
        if _number_observe(m, "wire.uint64") ≠ "72623859790382856" then return "uint64-value"
        if _number_observe(m, "wire.int64") ≠ "-2" then return "int64-value"
        if gguf_manifest.text(m, "wire.string") ≠ "hello" then return "string-value"
        return "13-kinds/bytes"
    }
    catch err {
        return err.message
    }
}

fn _metadata_nested_result() → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(_metadata_corpus())
        const bytes nested ← gguf_manifest.metadata(m, "wire.nested").payload_wire
        if not _wire_equal(nested, _array(9, 1, _array(0, 2, [7, 8]))) then return "nested-mismatch"
        return (nested.length() ↦ string) + "-bytes"
    }
    catch err {
        return err.message
    }
}

fn _metadata_bool_float_result() → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(_metadata_corpus())
        if _number_observe(m, "wire.bool") ≠ "ERR:metadata value is not an unsigned integer" then return "bool-accepted"
        if _number_observe(m, "wire.float32") ≠ "ERR:metadata value is not an unsigned integer" then return "float32-accepted"
        if _number_observe(m, "wire.float64") ≠ "ERR:metadata value is not an unsigned integer" then return "float64-accepted"
        return "bool-preserved/number-rejected"
    }
    catch err {
        return err.message
    }
}

fn _descriptor_result(gguf_manifest.GgufCorpus corpus, string name) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        const gguf_manifest.GgufTensorDescriptor t ← gguf_manifest.find_tensor(m, name)
        match t.layout {
            case gguf_manifest.Known const elements_per_block, bytes_per_block, byte_length {
                return ((((((m.data_start ↦ string) + "/") + (t.relative_offset ↦ string)) + "/") + (t.elements ↦ string)) + "/") + (byte_length ↦ string)
            }
            case gguf_manifest.Unknown const unknown_kind {
                return "unknown"
            }
        }
    }
    catch err {
        return err.message
    }
}

fn _reordered_gapped() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(2, 0)
    table ← _join(table, _tensor("b", [4, 1], 0, 160))
    table ← _join(table, _tensor("a", [4, 1], 0, 0))
    return _full(table, 32, 256)
}

fn _boundary_table() → list<int<u8>> {
    return _join(_header(0, 1), _kv("general.architecture", 8, _str("llama")))
}

fn _table_end() → gguf_manifest.GgufCorpus {
    const list<int<u8>> table ← _boundary_table()
    const int data_offset ← ((table.length() + 31) / 32) * 32
    return gguf_manifest.GgufCorpus {table = _bytes(table), artifact_length = data_offset, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = data_offset}}
}

fn _padding_end() → gguf_manifest.GgufCorpus {
    const list<int<u8>> table ← _boundary_table()
    const int data_offset ← ((table.length() + 31) / 32) * 32
    var list<int<u8>> b ← table
    b.append(0 ∷ int<u8>)
    return gguf_manifest.GgufCorpus {table = _bytes(b), artifact_length = data_offset, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = data_offset}}
}

fn _boundary_result(gguf_manifest.GgufCorpus corpus) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        return ((m.data_start ↦ string) + "/") + (m.artifact_length ↦ string)
    }
    catch err {
        return err.message
    }
}

fn _truncata() → gguf_manifest.GgufCorpus {
    const list<int<u8>> b ← [71, 71, 85, 70]
    const bytes o ← _bytes(b)
    return gguf_manifest.GgufCorpus {table = o, artifact_length = 32, identity = artifact.ContentIdentity {algorithm = "sha-256", digest = F_DIGEST, length = 32}}
}

fn _llama() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(2, 3)
    table ← _join(table, _kv("general.architecture", 8, _str("llama")))
    table ← _join(table, _kv("general.custom_note", 8, _str("unknown metadata")))
    table ← _join(table, _kv("tokenizer.ggml.tokens", 9, _join(_join(_u32(8), _u64(2)), _join(_str("<s>"), _str("hello")))))
    table ← _join(table, _tensor("token_embd.weight", [4, 8], 0, 0))
    table ← _join(table, _tensor("blk.0.attn_norm.weight", [8], 1, 160))
    return _corpus(table, 32, 560, false)
}

fn _qwen2() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(2, 4)
    table ← _join(table, _kv("general.architecture", 8, _str("qwen2")))
    table ← _join(table, _kv("general.alignment", 4, _u32(64)))
    table ← _join(table, _kv("qwen2.custom_flag", 4, _u32(7)))
    table ← _join(table, _kv("tokenizer.ggml.tokens", 9, _join(_join(_u32(8), _u64(2)), _join(_str("hello"), _str("world")))))
    table ← _join(table, _tensor("blk.0.attn_q.weight", [256, 1, 1], 12, 0))
    table ← _join(table, _tensor("blk.0.attn_norm.weight", [2, 2], 0, 192))
    return _corpus(table, 64, 656, false)
}

fn _qwen35moe() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(2, 4)
    table ← _join(table, _kv("general.architecture", 8, _str("qwen35moe")))
    table ← _join(table, _kv("general.alignment", 4, _u32(128)))
    table ← _join(table, _kv("qwen35moe.custom_flag", 4, _u32(35)))
    table ← _join(table, _kv("tokenizer.ggml.tokens", 9, _join(_join(_u32(8), _u64(2)), _join(_str("hello"), _str("world")))))
    table ← _join(table, _tensor("blk.0.experts.0.weight", [2, 3, 4], 999, 0))
    table ← _join(table, _tensor("blk.0.attn_norm.weight", [2, 2], 30, 64))
    return _corpus(table, 128, 584, false)
}

fn _bad_magic() → gguf_manifest.GgufCorpus {
    const list<int<u8>> h ← _header(0, 0)
    return _corpus(_join([0], h.take(23)), 32, 32, false)
}

fn _bad_version() → gguf_manifest.GgufCorpus {
    const list<int<u8>> h ← _header(0, 0)
    return _corpus(_join(_join(h.take(4), _u32(2)), _join(_u64(0), _u64(0))), 32, 32, false)
}

fn _wrong_alignment(int kind, list<int<u8>> value) → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(0, 1)
    table ← _join(table, _kv("general.alignment", kind, value))
    return _corpus(table, 32, 32, false)
}

fn _malformed_value(int kind, list<int<u8>> value) → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(0, 1)
    table ← _join(table, _kv("bad.value", kind, value))
    return _corpus(table, 32, 32, false)
}

fn _duplicate_metadata() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(0, 2)
    table ← _join(table, _kv("general.architecture", 8, _str("llama")))
    table ← _join(table, _kv("general.architecture", 8, _str("qwen2")))
    return _corpus(table, 32, 32, false)
}

fn _duplicate_tensors() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(2, 0)
    table ← _join(table, _tensor("same", [8], 0, 0))
    table ← _join(table, _tensor("same", [8], 0, 32))
    return _corpus(table, 32, 64, false)
}

fn _dimension_ceiling() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _join(table, _tensor("huge", [1000000001], 0, 0))
    return _corpus(table, 32, 64, false)
}

fn _element_overflow() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _join(table, _tensor("too_many", [1000000000, 2], 0, 0))
    return _corpus(table, 32, 64, false)
}

fn _rank_zero() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _join(table, _tensor("scalar", [], 0, 0))
    return _corpus(table, 32, 64, false)
}

fn _non_block_quant() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _join(table, _tensor("bad_q4k", [1, 1, 256], 12, 0))
    return _corpus(table, 32, 144, false)
}

fn _known_out_of_file() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _join(table, _tensor("known", [256, 1], 12, 0))
    return _corpus(table, 32, 100, false)
}

fn _unknown_out_of_file() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _join(table, _tensor("unknown", [2, 3, 4], 999, 1000))
    return _corpus(table, 32, 100, false)
}

fn _offset_overflow() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(1, 0)
    table ← _join(table, _tensor("overflow", [2, 3, 4], 999, 9223372036854775807))
    return _corpus(table, 32, 9223372036854775807, false)
}

fn _overlap() → gguf_manifest.GgufCorpus {
    var list<int<u8>> table ← _header(2, 0)
    table ← _join(table, _tensor("a", [8], 0, 0))
    table ← _join(table, _tensor("b", [8], 0, 16))
    return _corpus(table, 32, 192, false)
}

fn _extra_data_region() → gguf_manifest.GgufCorpus {
    return _corpus(_header(0, 0), 32, 32, true)
}

fn _identity_mismatch() → gguf_manifest.GgufCorpus {
    const list<int<u8>> table ← _header(0, 0)
    const int data_offset ← ((table.length() + 31) / 32) * 32
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← _bytes(b)
    return gguf_manifest.GgufCorpus {table = o, artifact_length = data_offset, identity = artifact.ContentIdentity {algorithm = "md5", digest = F_DIGEST, length = data_offset}}
}

fn _read_llama(int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    const gguf_manifest.GgufCorpus corpus ← _llama()
    const bytes table ← corpus.table
    if (start ≺ 0 or length ≺ 0) or start + length ≻ corpus.artifact_length then throw variant BadSource {message = "synthetic range is outside the artifact"}
    var bytes out ← ||
    var int i ← 0
    while i ≺ length {
        const int index ← start + i
        if index ≺ table.length() {
            out.append(table.get(index) coalesce 0 ∷ int<u8>)
        }
        else {
            out.append((index % 256) ∷ int<u8>)
        }
        i ↑
    }
    return out
}

fn _read_failed(int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    throw variant BadSource {message = "synthetic read failed"}
}

fn _read_short(int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    var bytes out ← ||
    var int i ← 0
    while i ≺ length - 1 {
        out.append(0 ∷ int<u8>)
        i ↑
    }
    return out
}

fn _inspect_range_result() → string {
    do {
        const gguf_manifest.GgufCorpus corpus ← _llama()
        const gguf_manifest.GgufManifest m ← gguf_manifest.inspect((int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _read_llama(start, length), corpus.artifact_length, corpus.identity)
        return (((gguf_manifest.text(m, "general.architecture") + "/") + (m.tensors.length() ↦ string)) + "/") + (m.data_start ↦ string)
    }
    catch err {
        return err.message
    }
}

fn _inspect_failure_result(bool brevis) → string {
    do {
        const gguf_manifest.GgufCorpus corpus ← _llama()
        if brevis {
            gguf_manifest.inspect((int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _read_short(start, length), corpus.artifact_length, corpus.identity)
        }
        else {
            gguf_manifest.inspect((int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _read_failed(start, length), corpus.artifact_length, corpus.identity)
        }
        return "unexpected-success"
    }
    catch err {
        return err.message
    }
}

fn _fragment_result(string name, int start, int length) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(_llama())
        const bytes bytes ← gguf_manifest.read_fragment(m, name, start, length, (int off, int len) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _read_llama(off, len))
        if _wire_equal(bytes, [35, 36, 37, 38]) then return "exact-bytes"
        return "wrong-bytes"
    }
    catch err {
        return err.message
    }
}

fn _fragment_unknown_layout_result() → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(_qwen35moe())
        gguf_manifest.read_fragment(m, "blk.0.experts.0.weight", 0, 1, (int off, int len) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _read_llama(off, len))
        return "unexpected-success"
    }
    catch err {
        return err.message
    }
}

fn _fragment_source_failure_result(bool brevis) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(_llama())
        if brevis {
            gguf_manifest.read_fragment(m, "token_embd.weight", 0, 4, (int off, int len) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _read_short(off, len))
        }
        else {
            gguf_manifest.read_fragment(m, "token_embd.weight", 0, 4, (int off, int len) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _read_failed(off, len))
        }
        return "unexpected-success"
    }
    catch err {
        return err.message
    }
}

fn _parse_result(gguf_manifest.GgufCorpus corpus) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        return "ok"
    }
    catch err {
        return err.message
    }
}

fn _surface_result(gguf_manifest.GgufCorpus corpus, string tensor_name) → string {
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.parse(corpus)
        const string arch ← gguf_manifest.text(m, "general.architecture")
        const gguf_manifest.GgufTensorDescriptor t ← gguf_manifest.find_tensor(m, tensor_name)
        t.layout
        return (((((arch + "/") + (m.alignment ↦ string)) + "/") + (t.shape.get(0) coalesce 0 ↦ string)) + "/") + (t.dtype_ggml ↦ string)
    }
    catch err {
        return err.message
    }
}

fn _case(string name, string observed, string expected) → string {
    if observed ≡ expected then return (name + ": PASS observed=") + observed
    return (((name + ": FAIL expected=") + expected) + " observed=") + observed
}

main {
    print _case("llama-default-and-unknown-metadata", _surface_result(_llama(), "token_embd.weight"), "llama/32/4/0")
    print _case("qwen2-custom-alignment-rank3-q4k", _surface_result(_qwen2(), "blk.0.attn_q.weight"), "qwen2/64/256/12")
    print _case("qwen35moe-mixed-unknown-layout", _surface_result(_qwen35moe(), "blk.0.experts.0.weight"), "qwen35moe/128/2/999")
    print _case("unknown-layout-inspectability", _parse_result(_qwen35moe()), "ok")
    print _case("malformed-magic", _parse_result(_bad_magic()), "not a GGUF file — bad magic")
    print _case("malformed-version", _parse_result(_bad_version()), "unsupported GGUF version: 2")
    print _case("truncation", _parse_result(_truncata()), "truncated GGUF header")
    print _case("wrong-alignment-wire-kind", _parse_result(_wrong_alignment(7, [1])), "general.alignment must use GGUF UINT32 wire kind")
    print _case("invalid-alignment-value", _parse_result(_wrong_alignment(4, _u32(3))), "general.alignment must be a positive power of two")
    print _case("malformed-bool", _parse_result(_malformed_value(7, [2])), "malformed GGUF bool value")
    print _case("malformed-string", _parse_result(_malformed_value(8, _join(_u64(1), [255]))), "GGUF string is not valid UTF-8")
    print _case("duplicate-metadata", _parse_result(_duplicate_metadata()), "duplicate GGUF metadata key: general.architecture")
    print _case("duplicate-tensor-name", _parse_result(_duplicate_tensors()), "duplicate GGUF tensor name: same")
    print _case("dimension-ceiling", _parse_result(_dimension_ceiling()), "tensor dimension is outside the bounded range")
    print _case("element-overflow", _parse_result(_element_overflow()), "tensor element count exceeds the bounded range")
    print _case("rank-zero", _parse_result(_rank_zero()), "tensor rank must be at least one")
    print _case("first-dimension-q4k-block", _parse_result(_non_block_quant()), "tensor first dimension is not a complete GGML block")
    print _case("known-offset-out-of-file", _parse_result(_known_out_of_file()), "known GGML tensor range exceeds the artifact")
    print _case("unknown-offset-out-of-file", _parse_result(_unknown_out_of_file()), "GGML tensor offset exceeds the artifact")
    print _case("checked-offset-overflow", _parse_result(_offset_overflow()), "checked offset addition overflow")
    print _case("known-range-overlap", _parse_result(_overlap()), "known GGML tensor ranges overlap")
    print _case("extra-data-region-byte", _parse_result(_extra_data_region()), "bounded GGUF corpus contains bytes from the data region")
    print _case("identity-mismatch", _parse_result(_identity_mismatch()), "content identity does not match the supplied artifact length")
    print _case("metadata-13-wire-kinds", _metadata_wire_result(), "13-kinds/bytes")
    print _case("nested-array-preservation", _metadata_nested_result(), "26-bytes")
    print _case("bool-and-float-number-rejects", _metadata_bool_float_result(), "bool-preserved/number-rejected")
    print _case("descriptor-offset-elements-known-length", _descriptor_result(_llama(), "blk.0.attn_norm.weight"), "288/160/8/16")
    print _case("custom-alignment-data-offset", _descriptor_result(_qwen2(), "blk.0.attn_norm.weight"), "384/192/4/16")
    print _case("reordered-gapped-ranges", _descriptor_result(_reordered_gapped(), "b"), "128/160/4/16")
    print _case("corpus-table-end-accepted", _boundary_result(_table_end()), "96/96")
    print _case("corpus-padding-end-accepted", _boundary_result(_padding_end()), "96/96")
    print _case("range-source-inspection", _inspect_range_result(), "llama/2/288")
    print _case("range-source-failure", _inspect_failure_result(false), "synthetic read failed")
    print _case("range-source-short-read", _inspect_failure_result(true), "range source returned an unexpected byte length")
    print _case("tensor-fragment-exact", _fragment_result("token_embd.weight", 3, 4), "exact-bytes")
    print _case("tensor-fragment-negative", _fragment_result("token_embd.weight", -1, 4), "tensor fragment range is negative")
    print _case("tensor-fragment-out-of-range", _fragment_result("token_embd.weight", 127, 2), "tensor fragment range exceeds the known tensor")
    print _case("tensor-fragment-unknown-layout", _fragment_unknown_layout_result(), "tensor layout is unknown; payload fragment is unavailable")
    print _case("tensor-fragment-source-failure", _fragment_source_failure_result(false), "synthetic read failed")
    print _case("tensor-fragment-short-read", _fragment_source_failure_result(true), "range source returned an unexpected byte length")
}
