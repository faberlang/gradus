fn _overlap() → manifestum.GgufCorpus {
    var list<int<u8>> table ← _caput(2, 0)
    table ← _iunge(table, _tensor("a", [8], 0, 0))
    table ← _iunge(table, _tensor("b", [8], 0, 16))
    return _corpus(table, 32, 192, false)
}

fn _extra_data_region() → manifestum.GgufCorpus {
    return _corpus(_caput(0, 0), 32, 32, true)
}

fn _identity_mismatch() → manifestum.GgufCorpus {
    const list<int<u8>> table ← _caput(0, 0)
    const int data_offset ← ((table.length() + 31) / 32) * 32
    var list<int<u8>> b ← table
    while b.length() ≺ data_offset {
        b.append(0 ∷ int<u8>)
    }
    const bytes o ← _octeti(b)
    return manifestum.GgufCorpus {tabula = o, artifact_length = data_offset, identitas = artifact.ContentIdentity {algorithm = "md5", digest = F_DIGEST, length = data_offset}}
}

fn _lectio_llama(int initium, int longitudo) → bytes ⇥ manifestum.GgufManifestError {
    const manifestum.GgufCorpus corpus ← _llama()
    const bytes tabula ← corpus.tabula
    if (initium ≺ 0 or longitudo ≺ 0) or initium + longitudo ≻ corpus.artifact_length then throw variant FonsMala {message = "synthetic range is outside the artifact"}
    var bytes out ← ||
    var int i ← 0
    while i ≺ longitudo {
        const int index ← initium + i
        if index ≺ tabula.length() {
            out.append(tabula.get(index) coalesce 0 ∷ int<u8>)
        }
        else {
            out.append((index % 256) ∷ int<u8>)
        }
        i ↑
    }
    return out
}

fn _lectio_defecta(int initium, int longitudo) → bytes ⇥ manifestum.GgufManifestError {
    throw variant FonsMala {message = "synthetic read failed"}
}

fn _lectio_brevis(int initium, int longitudo) → bytes ⇥ manifestum.GgufManifestError {
    var bytes out ← ||
    var int i ← 0
    while i ≺ longitudo - 1 {
        out.append(0 ∷ int<u8>)
        i ↑
    }
    return out
}

fn _inspect_range_result() → string {
    do {
        const manifestum.GgufCorpus corpus ← _llama()
        const manifestum.GgufManifest m ← manifestum.inspect((int initium, int longitudo) → bytes ⇥ manifestum.GgufManifestError ∴ _lectio_llama(initium, longitudo), corpus.artifact_length, corpus.identitas)
        return (((manifestum.textum(m, "general.architecture") + "/") + (m.tensors.length() ↦ string)) + "/") + (m.data_inceptum ↦ string)
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _inspect_failure_result(bool brevis) → string {
    do {
        const manifestum.GgufCorpus corpus ← _llama()
        if brevis {
            manifestum.inspect((int initium, int longitudo) → bytes ⇥ manifestum.GgufManifestError ∴ _lectio_brevis(initium, longitudo), corpus.artifact_length, corpus.identitas)
        }
        else {
            manifestum.inspect((int initium, int longitudo) → bytes ⇥ manifestum.GgufManifestError ∴ _lectio_defecta(initium, longitudo), corpus.artifact_length, corpus.identitas)
        }
        return "unexpected-success"
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _fragment_result(string nomen, int initium, int longitudo) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(_llama())
        const bytes bytes ← manifestum.read_fragmentum(m, nomen, initium, longitudo, (int off, int len) → bytes ⇥ manifestum.GgufManifestError ∴ _lectio_llama(off, len))
        if _wire_aequa(bytes, [35, 36, 37, 38]) then return "exact-bytes"
        return "wrong-bytes"
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _fragment_unknown_layout_result() → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(_qwen35moe())
        manifestum.read_fragmentum(m, "blk.0.experts.0.weight", 0, 1, (int off, int len) → bytes ⇥ manifestum.GgufManifestError ∴ _lectio_llama(off, len))
        return "unexpected-success"
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _fragment_source_failure_result(bool brevis) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(_llama())
        if brevis {
            manifestum.read_fragmentum(m, "token_embd.weight", 0, 4, (int off, int len) → bytes ⇥ manifestum.GgufManifestError ∴ _lectio_brevis(off, len))
        }
        else {
            manifestum.read_fragmentum(m, "token_embd.weight", 0, 4, (int off, int len) → bytes ⇥ manifestum.GgufManifestError ∴ _lectio_defecta(off, len))
        }
        return "unexpected-success"
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _parse_result(manifestum.GgufCorpus corpus) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        return "ok"
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _surface_result(manifestum.GgufCorpus corpus, string tensor_name) → string {
    do {
        const manifestum.GgufManifest m ← manifestum.parse(corpus)
        const string arch ← manifestum.textum(m, "general.architecture")
        const manifestum.GgufTensorDescriptor t ← manifestum.inveni_tensorem(m, tensor_name)
        t.layout
        return (((((arch + "/") + (m.concordatio ↦ string)) + "/") + (t.shape.get(0) coalesce 0 ↦ string)) + "/") + (t.dtype_ggml ↦ string)
    }
    catch err {
        return manifestum.message(err)
    }
}

fn _case(string name, string observed, string expected) → string {
    if observed ≡ expected then return (name + ": PASS observed=") + observed
    return (((name + ": FAIL expected=") + expected) + " observed=") + observed
}

main {
    print _case("llama-default-and-unknown-metadata", _surface_result(_llama(), "token_embd.weight"), "llama/32/4/0")
    print _case("qwen2-custom-alignment-rank3-q4k", _surface_result(_qwen2(), "blk.0.attn_q.weight"), "qwen2/64/256/12")
    print _case("qwen35moe-mixed-unknown-layout", _surface_result(_qwen35moe(), "blk.0.experts.0.weight"), "qwen35moe/128/2/999")
    print _case("unknown-layout-inspectability", _parse_result(_qwen35moe()), "ok")
    print _case("malformed-magic", _parse_result(_bad_magic()), "not a GGUF file — bad magic")
    print _case("malformed-version", _parse_result(_bad_version()), "unsupported GGUF version: 2")
    print _case("truncation", _parse_result(_truncata()), "truncated GGUF header")
    print _case("wrong-alignment-wire-kind", _parse_result(_wrong_alignment(7, [1])), "general.alignment must use GGUF UINT32 wire kind")
    print _case("invalid-alignment-value", _parse_result(_wrong_alignment(4, _u32(3))), "general.alignment must be a positive power of two")
    print _case("malformed-bool", _parse_result(_malformed_value(7, [2])), "malformed GGUF bool value")
    print _case("malformed-string", _parse_result(_malformed_value(8, _iunge(_u64(1), [255]))), "GGUF string is not valid UTF-8")
    print _case("duplicate-metadata", _parse_result(_duplicate_metadata()), "duplicate GGUF metadata key: general.architecture")
    print _case("duplicate-tensor-name", _parse_result(_duplicate_tensors()), "duplicate GGUF tensor name: same")
    print _case("dimension-ceiling", _parse_result(_dimension_ceiling()), "tensor dimension is outside the bounded range")
    print _case("element-overflow", _parse_result(_element_overflow()), "tensor element count exceeds the bounded range")
    print _case("rank-zero", _parse_result(_rank_zero()), "tensor rank must be at least one")
    print _case("first-dimension-q4k-block", _parse_result(_non_block_quant()), "tensor first dimension is not a complete GGML block")
    print _case("known-offset-out-of-file", _parse_result(_known_out_of_file()), "known GGML tensor range exceeds the artifact")
    print _case("unknown-offset-out-of-file", _parse_result(_unknown_out_of_file()), "GGML tensor offset exceeds the artifact")
    print _case("checked-offset-overflow", _parse_result(_offset_overflow()), "checked offset addition overflow")
    print _case("known-range-overlap", _parse_result(_overlap()), "known GGML tensor ranges overlap")
    print _case("extra-data-region-byte", _parse_result(_extra_data_region()), "bounded GGUF corpus contains bytes from the data region")
    print _case("identity-mismatch", _parse_result(_identity_mismatch()), "content identity does not match the supplied artifact length")
    print _case("metadata-13-wire-kinds", _metadata_wire_result(), "13-kinds/bytes")
    print _case("nested-array-preservation", _metadata_nested_result(), "26-bytes")
    print _case("bool-and-float-numerum-rejects", _metadata_bool_float_result(), "bool-preserved/numerum-rejected")
    print _case("descriptor-offset-elements-known-length", _descriptor_result(_llama(), "blk.0.attn_norm.weight"), "288/160/8/16")
    print _case("custom-alignment-data-offset", _descriptor_result(_qwen2(), "blk.0.attn_norm.weight"), "384/192/4/16")
    print _case("reordered-gapped-ranges", _descriptor_result(_reordered_gapped(), "b"), "128/160/4/16")
    print _case("corpus-table-end-accepted", _boundary_result(_table_end()), "96/96")
    print _case("corpus-padding-end-accepted", _boundary_result(_padding_end()), "96/96")
    print _case("range-source-inspection", _inspect_range_result(), "llama/2/288")
    print _case("range-source-failure", _inspect_failure_result(false), "synthetic read failed")
    print _case("range-source-short-read", _inspect_failure_result(true), "range source returned an unexpected byte length")
    print _case("tensor-fragment-exact", _fragment_result("token_embd.weight", 3, 4), "exact-bytes")
    print _case("tensor-fragment-negative", _fragment_result("token_embd.weight", -1, 4), "tensor fragment range is negative")
    print _case("tensor-fragment-out-of-range", _fragment_result("token_embd.weight", 127, 2), "tensor fragment range exceeds the known tensor")
    print _case("tensor-fragment-unknown-layout", _fragment_unknown_layout_result(), "tensor layout is unknown; payload fragment is unavailable")
    print _case("tensor-fragment-source-failure", _fragment_source_failure_result(false), "synthetic read failed")
    print _case("tensor-fragment-short-read", _fragment_source_failure_result(true), "range source returned an unexpected byte length")
}
