# GGUF-A1a/A1b executable synthetic package proof.
#
# The source builds bounded synthetic GGUF header/metadata/tensor-table
# corpora in memory, exercises parse/range/fragment operations, reads returned
# fields, and prints PASS/FAIL plus the observed result for every named case.
# It never opens a file or retains a model payload. The three committed
# binary fixtures are generator/oracle artifacts; this executable proof does
# not claim to have parsed them.

importa ex "gradus:model/artifact" privata artifact
importa ex "gradus:model/gguf_manifest" privata manifestum

fixum textus F_DIGEST ← "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

functio _u8(numerus n) → lista<numerus<u8>> {
    redde [(n % 256) ∷ numerus<u8>]
}

functio _u16(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>
    ]
}

functio _u32(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>,
        ((n ⇒ 16) % 256) ∷ numerus<u8>,
        ((n ⇒ 24) % 256) ∷ numerus<u8>
    ]
}

functio _u64(numerus n) → lista<numerus<u8>> {
    redde [
        (n % 256) ∷ numerus<u8>,
        ((n ⇒ 8) % 256) ∷ numerus<u8>,
        ((n ⇒ 16) % 256) ∷ numerus<u8>,
        ((n ⇒ 24) % 256) ∷ numerus<u8>,
        ((n ⇒ 32) % 256) ∷ numerus<u8>,
        ((n ⇒ 40) % 256) ∷ numerus<u8>,
        ((n ⇒ 48) % 256) ∷ numerus<u8>,
        ((n ⇒ 56) % 256) ∷ numerus<u8>
    ]
}

functio _iunge(lista<numerus<u8>> a, lista<numerus<u8>> b) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← vacua
    itera ex a fixum x { out.appende(x) }
    itera ex b fixum x { out.appende(x) }
    redde out
}

functio _textus_bytes(textus s) → lista<numerus<u8>> {
    # The package MIR target has no textus→octeti extraction arm. The
    # builders use a finite ASCII corpus, so keep this fixture encoder
    # explicit and deterministic rather than claiming a general text codec.
    si s ≡ "general.architecture" ergo redde [103,101,110,101,114,97,108,46,97,114,99,104,105,116,101,99,116,117,114,101]
    si s ≡ "general.custom_note" ergo redde [103,101,110,101,114,97,108,46,99,117,115,116,111,109,95,110,111,116,101]
    si s ≡ "tokenizer.ggml.tokens" ergo redde [116,111,107,101,110,105,122,101,114,46,103,103,109,108,46,116,111,107,101,110,115]
    si s ≡ "<s>" ergo redde [60,115,62]
    si s ≡ "hello" ergo redde [104,101,108,108,111]
    si s ≡ "token_embd.weight" ergo redde [116,111,107,101,110,95,101,109,98,100,46,119,101,105,103,104,116]
    si s ≡ "blk.0.attn_norm.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,110,111,114,109,46,119,101,105,103,104,116]
    si s ≡ "qwen2" ergo redde [113,119,101,110,50]
    si s ≡ "general.alignment" ergo redde [103,101,110,101,114,97,108,46,97,108,105,103,110,109,101,110,116]
    si s ≡ "qwen2.custom_flag" ergo redde [113,119,101,110,50,46,99,117,115,116,111,109,95,102,108,97,103]
    si s ≡ "world" ergo redde [119,111,114,108,100]
    si s ≡ "blk.0.attn_q.weight" ergo redde [98,108,107,46,48,46,97,116,116,110,95,113,46,119,101,105,103,104,116]
    si s ≡ "qwen35moe" ergo redde [113,119,101,110,51,53,109,111,101]
    si s ≡ "qwen35moe.custom_flag" ergo redde [113,119,101,110,51,53,109,111,101,46,99,117,115,116,111,109,95,102,108,97,103]
    si s ≡ "blk.0.experts.0.weight" ergo redde [98,108,107,46,48,46,101,120,112,101,114,116,115,46,48,46,119,101,105,103,104,116]
    si s ≡ "bad.value" ergo redde [98,97,100,46,118,97,108,117,101]
    si s ≡ "llama" ergo redde [108,108,97,109,97]
    si s ≡ "same" ergo redde [115,97,109,101]
    si s ≡ "huge" ergo redde [104,117,103,101]
    si s ≡ "too_many" ergo redde [116,111,111,95,109,97,110,121]
    si s ≡ "scalar" ergo redde [115,99,97,108,97,114]
    si s ≡ "bad_q4k" ergo redde [98,97,100,95,113,52,107]
    si s ≡ "known" ergo redde [107,110,111,119,110]
    si s ≡ "unknown" ergo redde [117,110,107,110,111,119,110]
    si s ≡ "overflow" ergo redde [111,118,101,114,102,108,111,119]
    si s ≡ "a" ergo redde [97]
    si s ≡ "b" ergo redde [98]
    si s ≡ "wire.uint8" ergo redde [119,105,114,101,46,117,105,110,116,56]
    si s ≡ "wire.int8" ergo redde [119,105,114,101,46,105,110,116,56]
    si s ≡ "wire.uint16" ergo redde [119,105,114,101,46,117,105,110,116,49,54]
    si s ≡ "wire.int16" ergo redde [119,105,114,101,46,105,110,116,49,54]
    si s ≡ "wire.uint32" ergo redde [119,105,114,101,46,117,105,110,116,51,50]
    si s ≡ "wire.int32" ergo redde [119,105,114,101,46,105,110,116,51,50]
    si s ≡ "wire.float32" ergo redde [119,105,114,101,46,102,108,111,97,116,51,50]
    si s ≡ "wire.bool" ergo redde [119,105,114,101,46,98,111,111,108]
    si s ≡ "wire.string" ergo redde [119,105,114,101,46,115,116,114,105,110,103]
    si s ≡ "wire.array" ergo redde [119,105,114,101,46,97,114,114,97,121]
    si s ≡ "wire.nested" ergo redde [119,105,114,101,46,110,101,115,116,101,100]
    si s ≡ "wire.uint64" ergo redde [119,105,114,101,46,117,105,110,116,54,52]
    si s ≡ "wire.int64" ergo redde [119,105,114,101,46,105,110,116,54,52]
    si s ≡ "wire.float64" ergo redde [119,105,114,101,46,102,108,111,97,116,54,52]
    redde []
}

functio _octeti(lista<numerus<u8>> b) → octeti {
    varia octeti o ← ||
    itera ex b fixum x { o.appende(x) }
    redde o
}

functio _str(textus s) → lista<numerus<u8>> {
    fixum lista<numerus<u8>> b ← _textus_bytes(s)
    redde _iunge(_u64(b.longitudo()), b)
}

functio _kv(textus key, numerus typo, lista<numerus<u8>> value) → lista<numerus<u8>> {
    redde _iunge(_iunge(_str(key), _u32(typo)), value)
}

functio _array(numerus typo, numerus count, lista<numerus<u8>> value) → lista<numerus<u8>> {
    redde _iunge(_iunge(_u32(typo), _u64(count)), value)
}

functio _tensor(textus name, lista<numerus> forma, numerus typo, numerus offset) → lista<numerus<u8>> {
    varia lista<numerus<u8>> out ← _iunge(_str(name), _u32(forma.longitudo()))
    itera ex forma fixum dim { out ← _iunge(out, _u64(dim)) }
    redde _iunge(_iunge(out, _u32(typo)), _u64(offset))
}

functio _caput(numerus tensorum, numerus metadata) → lista<numerus<u8>> {
    redde _iunge(
        _iunge([0x47, 0x47, 0x55, 0x46], _u32(3)),
        _iunge(_u64(tensorum), _u64(metadata))
    )
}

functio _corpus(lista<numerus<u8>> table, numerus concordatio, numerus total, bivalens extra_data) → manifestum.CorpusGguf {
    fixum numerus data_offset ← ((table.longitudo() + concordatio - 1) / concordatio) * concordatio
    varia lista<numerus<u8>> b ← table
    dum b.longitudo() < data_offset { b.appende(0 ∷ numerus<u8>) }
    si extra_data { b.appende(0 ∷ numerus<u8>) }
    fixum octeti o ← _octeti(b)
    redde manifestum.CorpusGguf {
        tabula = o,
        longitudo_artifacti = total,
        identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = total }
    }
}

functio _plenum(lista<numerus<u8>> table, numerus concordatio, numerus payload) → manifestum.CorpusGguf {
    fixum numerus data_offset ← ((table.longitudo() + concordatio - 1) / concordatio) * concordatio
    redde _corpus(table, concordatio, data_offset + payload, falsum)
}

functio _wire_aequa(octeti actual, lista<numerus<u8>> expectata) → bivalens {
    si actual.longitudo() ≠ expectata.longitudo() ergo redde falsum
    varia numerus i ← 0
    dum i < expectata.longitudo() {
        si (actual.accipe(i) vel (0 ∷ numerus<u8>)) ≠ (expectata.accipe(i) vel (0 ∷ numerus<u8>)) ergo redde falsum
        i ⊕
    }
    redde verum
}

functio _metadata_corpus() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 14)
    table ← _iunge(table, _kv("wire.uint8", 0, _u8(127)))
    table ← _iunge(table, _kv("wire.int8", 1, _u8(254)))
    table ← _iunge(table, _kv("wire.uint16", 2, _u16(4660)))
    table ← _iunge(table, _kv("wire.int16", 3, _u16(65534)))
    table ← _iunge(table, _kv("wire.uint32", 4, _u32(305419896)))
    table ← _iunge(table, _kv("wire.int32", 5, _u32(4294967294)))
    table ← _iunge(table, _kv("wire.float32", 6, [0, 0, 128, 63]))
    table ← _iunge(table, _kv("wire.bool", 7, _u8(1)))
    table ← _iunge(table, _kv("wire.string", 8, _str("hello")))
    table ← _iunge(table, _kv("wire.array", 9, _array(2, 2, _iunge(_u16(4660), _u16(43981)))))
    table ← _iunge(table, _kv("wire.nested", 9, _array(9, 1, _array(0, 2, [7, 8]))))
    table ← _iunge(table, _kv("wire.uint64", 10, _u64(72623859790382856)))
    table ← _iunge(table, _kv("wire.int64", 11, [254, 255, 255, 255, 255, 255, 255, 255]))
    table ← _iunge(table, _kv("wire.float64", 12, [0, 0, 0, 0, 0, 0, 240, 63]))
    redde _plenum(table, 32, 0)
}

functio _numerum_observa(manifestum.ManifestumGguf m, textus clavis) → textus {
    fac {
        redde manifestum.numerum(m, clavis) ↦ textus
    }
    cape err { redde "ERR:" + manifestum.causa(err) }
}

functio _metadata_wire_result() → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(_metadata_corpus())
        si non _wire_aequa(manifestum.metadatum(m, "wire.uint8").valor_wire, _u8(127)) ergo redde "uint8-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.int8").valor_wire, _u8(254)) ergo redde "int8-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.uint16").valor_wire, _u16(4660)) ergo redde "uint16-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.int16").valor_wire, _u16(65534)) ergo redde "int16-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.uint32").valor_wire, _u32(305419896)) ergo redde "uint32-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.int32").valor_wire, _u32(4294967294)) ergo redde "int32-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.float32").valor_wire, [0, 0, 128, 63]) ergo redde "float32-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.bool").valor_wire, _u8(1)) ergo redde "bool-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.string").valor_wire, _str("hello")) ergo redde "string-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.array").valor_wire, _array(2, 2, _iunge(_u16(4660), _u16(43981)))) ergo redde "array-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.nested").valor_wire, _array(9, 1, _array(0, 2, [7, 8]))) ergo redde "nested-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.uint64").valor_wire, _u64(72623859790382856)) ergo redde "uint64-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.int64").valor_wire, [254, 255, 255, 255, 255, 255, 255, 255]) ergo redde "int64-bytes"
        si non _wire_aequa(manifestum.metadatum(m, "wire.float64").valor_wire, [0, 0, 0, 0, 0, 0, 240, 63]) ergo redde "float64-bytes"
        si _numerum_observa(m, "wire.uint8") ≠ "127" ergo redde "uint8-value"
        si _numerum_observa(m, "wire.int8") ≠ "-2" ergo redde "int8-value"
        si _numerum_observa(m, "wire.uint16") ≠ "4660" ergo redde "uint16-value"
        si _numerum_observa(m, "wire.int16") ≠ "-2" ergo redde "int16-value"
        si _numerum_observa(m, "wire.uint32") ≠ "305419896" ergo redde "uint32-value"
        si _numerum_observa(m, "wire.int32") ≠ "-2" ergo redde "int32-value"
        si _numerum_observa(m, "wire.uint64") ≠ "72623859790382856" ergo redde "uint64-value"
        si _numerum_observa(m, "wire.int64") ≠ "-2" ergo redde "int64-value"
        si manifestum.textum(m, "wire.string") ≠ "hello" ergo redde "string-value"
        redde "13-kinds/bytes"
    }
    cape err { redde manifestum.causa(err) }
}

functio _metadata_nested_result() → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(_metadata_corpus())
        fixum octeti nested ← manifestum.metadatum(m, "wire.nested").valor_wire
        si non _wire_aequa(nested, _array(9, 1, _array(0, 2, [7, 8]))) ergo redde "nested-mismatch"
        redde (nested.longitudo() ↦ textus) + "-bytes"
    }
    cape err { redde manifestum.causa(err) }
}

functio _metadata_bool_float_result() → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(_metadata_corpus())
        si _numerum_observa(m, "wire.bool") ≠ "ERR:metadata value is not an unsigned integer" ergo redde "bool-accepted"
        si _numerum_observa(m, "wire.float32") ≠ "ERR:metadata value is not an unsigned integer" ergo redde "float32-accepted"
        si _numerum_observa(m, "wire.float64") ≠ "ERR:metadata value is not an unsigned integer" ergo redde "float64-accepted"
        redde "bool-preserved/numerum-rejected"
    }
    cape err { redde manifestum.causa(err) }
}

functio _descriptor_result(manifestum.CorpusGguf corpus, textus nomen) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fixum manifestum.DescriptioTensorisGguf t ← manifestum.inveni_tensorem(m, nomen)
        discerne t.layout {
            casu Cognita fixum elementa_per_blockum, octeti_per_blockum, longitudo_octetorum {
                redde (m.data_inceptum ↦ textus) + "/" + (t.offset_relativum ↦ textus) + "/" + (t.elementa ↦ textus) + "/" + (longitudo_octetorum ↦ textus)
            }
            casu Ignota fixum typo_ignotum { redde "unknown" }
        }
    }
    cape err { redde manifestum.causa(err) }
}

functio _reordered_gapped() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 0)
    table ← _iunge(table, _tensor("b", [4, 1], 0, 160))
    table ← _iunge(table, _tensor("a", [4, 1], 0, 0))
    redde _plenum(table, 32, 256)
}

functio _boundary_table() → lista<numerus<u8>> {
    redde _iunge(_caput(0, 1), _kv("general.architecture", 8, _str("llama")))
}

functio _table_end() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> table ← _boundary_table()
    fixum numerus data_offset ← ((table.longitudo() + 31) / 32) * 32
    redde manifestum.CorpusGguf {
        tabula = _octeti(table),
        longitudo_artifacti = data_offset,
        identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = data_offset }
    }
}

functio _padding_end() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> table ← _boundary_table()
    fixum numerus data_offset ← ((table.longitudo() + 31) / 32) * 32
    varia lista<numerus<u8>> b ← table
    b.appende(0 ∷ numerus<u8>)
    redde manifestum.CorpusGguf {
        tabula = _octeti(b),
        longitudo_artifacti = data_offset,
        identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = data_offset }
    }
}

functio _boundary_result(manifestum.CorpusGguf corpus) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        redde (m.data_inceptum ↦ textus) + "/" + (m.longitudo_artifacti ↦ textus)
    }
    cape err { redde manifestum.causa(err) }
}

functio _truncata() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> b ← [0x47, 0x47, 0x55, 0x46]
    fixum octeti o ← _octeti(b)
    redde manifestum.CorpusGguf { tabula = o, longitudo_artifacti = 32, identitas = artifact.IdentitasContenuti { algorithmus = "sha-256", digestio = F_DIGEST, longitudo = 32 } }
}

functio _llama() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 3)
    table ← _iunge(table, _kv("general.architecture", 8, _str("llama")))
    table ← _iunge(table, _kv("general.custom_note", 8, _str("unknown metadata")))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _iunge(_iunge(_u32(8), _u64(2)), _iunge(_str("<s>"), _str("hello")))))
    table ← _iunge(table, _tensor("token_embd.weight", [4, 8], 0, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [8], 1, 160))
    redde _corpus(table, 32, 560, falsum)
}

functio _qwen2() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 4)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen2")))
    table ← _iunge(table, _kv("general.alignment", 4, _u32(64)))
    table ← _iunge(table, _kv("qwen2.custom_flag", 4, _u32(7)))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _iunge(_iunge(_u32(8), _u64(2)), _iunge(_str("hello"), _str("world")))))
    table ← _iunge(table, _tensor("blk.0.attn_q.weight", [256, 1, 1], 12, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [2, 2], 0, 192))
    redde _corpus(table, 64, 656, falsum)
}

functio _qwen35moe() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 4)
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen35moe")))
    table ← _iunge(table, _kv("general.alignment", 4, _u32(128)))
    table ← _iunge(table, _kv("qwen35moe.custom_flag", 4, _u32(35)))
    table ← _iunge(table, _kv("tokenizer.ggml.tokens", 9, _iunge(_iunge(_u32(8), _u64(2)), _iunge(_str("hello"), _str("world")))))
    table ← _iunge(table, _tensor("blk.0.experts.0.weight", [2, 3, 4], 999, 0))
    table ← _iunge(table, _tensor("blk.0.attn_norm.weight", [2, 2], 30, 64))
    redde _corpus(table, 128, 584, falsum)
}

functio _bad_magic() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> h ← _caput(0, 0)
    redde _corpus(_iunge([0], h.prima(23)), 32, 32, falsum)
}

functio _bad_version() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> h ← _caput(0, 0)
    redde _corpus(_iunge(_iunge(h.prima(4), _u32(2)), _iunge(_u64(0), _u64(0))), 32, 32, falsum)
}

functio _wrong_alignment(numerus typo, lista<numerus<u8>> value) → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 1)
    table ← _iunge(table, _kv("general.alignment", typo, value))
    redde _corpus(table, 32, 32, falsum)
}

functio _malformed_value(numerus typo, lista<numerus<u8>> value) → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 1)
    table ← _iunge(table, _kv("bad.value", typo, value))
    redde _corpus(table, 32, 32, falsum)
}

functio _duplicate_metadata() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(0, 2)
    table ← _iunge(table, _kv("general.architecture", 8, _str("llama")))
    table ← _iunge(table, _kv("general.architecture", 8, _str("qwen2")))
    redde _corpus(table, 32, 32, falsum)
}

functio _duplicate_tensors() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 0)
    table ← _iunge(table, _tensor("same", [8], 0, 0))
    table ← _iunge(table, _tensor("same", [8], 0, 32))
    redde _corpus(table, 32, 64, falsum)
}

functio _dimension_ceiling() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("huge", [1000000001], 0, 0))
    redde _corpus(table, 32, 64, falsum)
}

functio _element_overflow() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("too_many", [1000000000, 2], 0, 0))
    redde _corpus(table, 32, 64, falsum)
}

functio _rank_zero() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("scalar", [], 0, 0))
    redde _corpus(table, 32, 64, falsum)
}

functio _non_block_quant() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("bad_q4k", [1, 1, 256], 12, 0))
    redde _corpus(table, 32, 144, falsum)
}

functio _known_out_of_file() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("known", [256, 1], 12, 0))
    redde _corpus(table, 32, 100, falsum)
}

functio _unknown_out_of_file() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("unknown", [2, 3, 4], 999, 1000))
    redde _corpus(table, 32, 100, falsum)
}

functio _offset_overflow() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(1, 0)
    table ← _iunge(table, _tensor("overflow", [2, 3, 4], 999, 9223372036854775807))
    redde _corpus(table, 32, 9223372036854775807, falsum)
}

functio _overlap() → manifestum.CorpusGguf {
    varia lista<numerus<u8>> table ← _caput(2, 0)
    table ← _iunge(table, _tensor("a", [8], 0, 0))
    table ← _iunge(table, _tensor("b", [8], 0, 16))
    redde _corpus(table, 32, 192, falsum)
}

functio _extra_data_region() → manifestum.CorpusGguf {
    redde _corpus(_caput(0, 0), 32, 32, verum)
}

functio _identity_mismatch() → manifestum.CorpusGguf {
    fixum lista<numerus<u8>> table ← _caput(0, 0)
    fixum numerus data_offset ← ((table.longitudo() + 31) / 32) * 32
    varia lista<numerus<u8>> b ← table
    dum b.longitudo() < data_offset { b.appende(0 ∷ numerus<u8>) }
    fixum octeti o ← _octeti(b)
    redde manifestum.CorpusGguf { tabula = o, longitudo_artifacti = data_offset, identitas = artifact.IdentitasContenuti { algorithmus = "md5", digestio = F_DIGEST, longitudo = data_offset } }
}

functio _lectio_llama(numerus initium, numerus longitudo) → manifestum.LectioFontis {
    fixum manifestum.CorpusGguf corpus ← _llama()
    fixum octeti tabula ← corpus.tabula
    si initium < 0 aut longitudo < 0 aut initium + longitudo > corpus.longitudo_artifacti {
        redde manifestum.LectioFontis { successus = falsum, bytes = ||, causa = "synthetic range is outside the artifact" }
    }
    varia octeti out ← ||
    varia numerus i ← 0
    dum i < longitudo {
        fixum numerus index ← initium + i
        si index < tabula.longitudo() {
            out.appende(tabula.accipe(index) vel (0 ∷ numerus<u8>))
        } secus {
            out.appende((index % 256) ∷ numerus<u8>)
        }
        i ⊕
    }
    redde manifestum.LectioFontis { successus = verum, bytes = out, causa = "" }
}

functio _lectio_defecta(numerus initium, numerus longitudo) → manifestum.LectioFontis {
    redde manifestum.LectioFontis { successus = falsum, bytes = ||, causa = "synthetic read failed" }
}

functio _lectio_brevis(numerus initium, numerus longitudo) → manifestum.LectioFontis {
    varia octeti out ← ||
    varia numerus i ← 0
    dum i < longitudo - 1 {
        out.appende(0 ∷ numerus<u8>)
        i ⊕
    }
    redde manifestum.LectioFontis { successus = verum, bytes = out, causa = "" }
}

functio _inspect_range_result() → textus {
    fac {
        fixum manifestum.CorpusGguf corpus ← _llama()
        fixum manifestum.ManifestumGguf m ← manifestum.inspice(
            (numerus initium, numerus longitudo) → manifestum.LectioFontis ∴ _lectio_llama(initium, longitudo),
            corpus.longitudo_artifacti,
            corpus.identitas
        )
        redde manifestum.textum(m, "general.architecture") + "/" + (m.tensores.longitudo() ↦ textus) + "/" + (m.data_inceptum ↦ textus)
    }
    cape err { redde manifestum.causa(err) }
}

functio _inspect_failure_result(bivalens brevis) → textus {
    fac {
        fixum manifestum.CorpusGguf corpus ← _llama()
        si brevis {
            fixum manifestum.ManifestumGguf _ ← manifestum.inspice(
                (numerus initium, numerus longitudo) → manifestum.LectioFontis ∴ _lectio_brevis(initium, longitudo),
                corpus.longitudo_artifacti,
                corpus.identitas
            )
        } secus {
            fixum manifestum.ManifestumGguf _ ← manifestum.inspice(
                (numerus initium, numerus longitudo) → manifestum.LectioFontis ∴ _lectio_defecta(initium, longitudo),
                corpus.longitudo_artifacti,
                corpus.identitas
            )
        }
        redde "unexpected-success"
    }
    cape err { redde manifestum.causa(err) }
}

functio _fragment_result(textus nomen, numerus initium, numerus longitudo) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(_llama())
        fixum octeti bytes ← manifestum.lege_fragmentum(
            m,
            nomen,
            initium,
            longitudo,
            (numerus off, numerus len) → manifestum.LectioFontis ∴ _lectio_llama(off, len)
        )
        si _wire_aequa(bytes, [35, 36, 37, 38]) ergo redde "exact-bytes"
        redde "wrong-bytes"
    }
    cape err { redde manifestum.causa(err) }
}

functio _fragment_unknown_layout_result() → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(_qwen35moe())
        fixum octeti _ ← manifestum.lege_fragmentum(
            m,
            "blk.0.experts.0.weight",
            0,
            1,
            (numerus off, numerus len) → manifestum.LectioFontis ∴ _lectio_llama(off, len)
        )
        redde "unexpected-success"
    }
    cape err { redde manifestum.causa(err) }
}

functio _fragment_source_failure_result(bivalens brevis) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(_llama())
        si brevis {
            fixum octeti _ ← manifestum.lege_fragmentum(
                m, "token_embd.weight", 0, 4,
                (numerus off, numerus len) → manifestum.LectioFontis ∴ _lectio_brevis(off, len)
            )
        } secus {
            fixum octeti _ ← manifestum.lege_fragmentum(
                m, "token_embd.weight", 0, 4,
                (numerus off, numerus len) → manifestum.LectioFontis ∴ _lectio_defecta(off, len)
            )
        }
        redde "unexpected-success"
    }
    cape err { redde manifestum.causa(err) }
}

functio _parse_result(manifestum.CorpusGguf corpus) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        redde "ok"
    }
    cape err { redde manifestum.causa(err) }
}

functio _surface_result(manifestum.CorpusGguf corpus, textus tensor_name) → textus {
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.parse(corpus)
        fixum textus arch ← manifestum.textum(m, "general.architecture")
        fixum manifestum.DescriptioTensorisGguf t ← manifestum.inveni_tensorem(m, tensor_name)
        fixum manifestum.LayoutGgml _ ← t.layout
        redde arch + "/" + (m.concordatio ↦ textus) + "/" + ((t.forma.accipe(0) vel 0) ↦ textus) + "/" + (t.typo_ggml ↦ textus)
    }
    cape err { redde manifestum.causa(err) }
}

functio _case(textus name, textus observed, textus expected) → textus {
    si observed ≡ expected {
        redde name + ": PASS observed=" + observed
    }
    redde name + ": FAIL expected=" + expected + " observed=" + observed
}

incipit {
    nota _case("llama-default-and-unknown-metadata", _surface_result(_llama(), "token_embd.weight"), "llama/32/4/0")
    nota _case("qwen2-custom-alignment-rank3-q4k", _surface_result(_qwen2(), "blk.0.attn_q.weight"), "qwen2/64/256/12")
    nota _case("qwen35moe-mixed-unknown-layout", _surface_result(_qwen35moe(), "blk.0.experts.0.weight"), "qwen35moe/128/2/999")
    nota _case("unknown-layout-inspectability", _parse_result(_qwen35moe()), "ok")
    nota _case("malformed-magic", _parse_result(_bad_magic()), "not a GGUF file — bad magic")
    nota _case("malformed-version", _parse_result(_bad_version()), "unsupported GGUF version: 2")
    nota _case("truncation", _parse_result(_truncata()), "truncated GGUF header")
    nota _case("wrong-alignment-wire-kind", _parse_result(_wrong_alignment(7, [1])), "general.alignment must use GGUF UINT32 wire kind")
    nota _case("invalid-alignment-value", _parse_result(_wrong_alignment(4, _u32(3))), "general.alignment must be a positive power of two")
    nota _case("malformed-bool", _parse_result(_malformed_value(7, [2])), "malformed GGUF bool value")
    nota _case("malformed-string", _parse_result(_malformed_value(8, _iunge(_u64(1), [0xff]))), "GGUF string is not valid UTF-8")
    nota _case("duplicate-metadata", _parse_result(_duplicate_metadata()), "duplicate GGUF metadata key: general.architecture")
    nota _case("duplicate-tensor-name", _parse_result(_duplicate_tensors()), "duplicate GGUF tensor name: same")
    nota _case("dimension-ceiling", _parse_result(_dimension_ceiling()), "tensor dimension is outside the bounded range")
    nota _case("element-overflow", _parse_result(_element_overflow()), "tensor element count exceeds the bounded range")
    nota _case("rank-zero", _parse_result(_rank_zero()), "tensor rank must be at least one")
    nota _case("first-dimension-q4k-block", _parse_result(_non_block_quant()), "tensor first dimension is not a complete GGML block")
    nota _case("known-offset-out-of-file", _parse_result(_known_out_of_file()), "known GGML tensor range exceeds the artifact")
    nota _case("unknown-offset-out-of-file", _parse_result(_unknown_out_of_file()), "GGML tensor offset exceeds the artifact")
    nota _case("checked-offset-overflow", _parse_result(_offset_overflow()), "checked offset addition overflow")
    nota _case("known-range-overlap", _parse_result(_overlap()), "known GGML tensor ranges overlap")
    nota _case("extra-data-region-byte", _parse_result(_extra_data_region()), "bounded GGUF corpus contains bytes from the data region")
    nota _case("identity-mismatch", _parse_result(_identity_mismatch()), "content identity does not match the supplied artifact length")
    nota _case("metadata-13-wire-kinds", _metadata_wire_result(), "13-kinds/bytes")
    nota _case("nested-array-preservation", _metadata_nested_result(), "26-bytes")
    nota _case("bool-and-float-numerum-rejects", _metadata_bool_float_result(), "bool-preserved/numerum-rejected")
    nota _case("descriptor-offset-elements-known-length", _descriptor_result(_llama(), "blk.0.attn_norm.weight"), "288/160/8/16")
    nota _case("custom-alignment-data-offset", _descriptor_result(_qwen2(), "blk.0.attn_norm.weight"), "384/192/4/16")
    nota _case("reordered-gapped-ranges", _descriptor_result(_reordered_gapped(), "b"), "128/160/4/16")
    nota _case("corpus-table-end-accepted", _boundary_result(_table_end()), "96/96")
    nota _case("corpus-padding-end-accepted", _boundary_result(_padding_end()), "96/96")
    nota _case("range-source-inspection", _inspect_range_result(), "llama/2/288")
    nota _case("range-source-failure", _inspect_failure_result(falsum), "range source failed: synthetic read failed")
    nota _case("range-source-short-read", _inspect_failure_result(verum), "range source returned an unexpected byte length")
    nota _case("tensor-fragment-exact", _fragment_result("token_embd.weight", 3, 4), "exact-bytes")
    nota _case("tensor-fragment-negative", _fragment_result("token_embd.weight", -1, 4), "tensor fragment range is negative")
    nota _case("tensor-fragment-out-of-range", _fragment_result("token_embd.weight", 127, 2), "tensor fragment range exceeds the known tensor")
    nota _case("tensor-fragment-unknown-layout", _fragment_unknown_layout_result(), "tensor layout is unknown; payload fragment is unavailable")
    nota _case("tensor-fragment-source-failure", _fragment_source_failure_result(falsum), "range source failed: synthetic read failed")
    nota _case("tensor-fragment-short-read", _fragment_source_failure_result(verum), "range source returned an unexpected byte length")
}
