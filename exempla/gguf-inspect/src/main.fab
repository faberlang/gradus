+++
locale = "en"
+++
import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" gguf_manifest
import from "norma:processus" processus
import from "norma:solum" solum

# The executable adapter owns the path and I/O. It reads the independently
# bounded table prefix once, then gives Gradus an operation-scoped range
# function over that application-owned buffer. Gradus never receives or
# retains the path or the prefix.
fn _range(list<int> prefix, int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    if start < 0 or length < 0 or start > prefix.length() - length {
        throw variant BadSource {message = "inspection attempted to read the tensor data region"}
    }
    # `sectio` performs one bulk copy. In particular, do not rebuild this
    # range one byte at a time: the FMIR stepper's bytes carrier is owned, so
    # repeated byte appends would copy the growing buffer on every iteration.
    const list<int> segment ← prefix.slice(start, start + length)
    const bytes bytes ← segment ↦ bytes
    return bytes
}

main {
    const list<string> args ← processus.argv() ↦ list<string>
    if args.length() ≠ 3 {
        panic "usage: gguf-inspect <path> <expected-data-offset> <sha256>"
    }
    const string via ← args.get(0) coalesce ""
    const int expected_data ← (args.get(1) coalesce "0") ↦ int
    const string digest ← args.get(2) coalesce ""
    const int total ← solum.byte_length(via)
    const bytes prefix_bytes ← solum.read_range(via, 0, expected_data)
    if prefix_bytes.length() ≠ expected_data {
        panic "file adapter returned a short table-prefix read"
    }
    const value prefix_payload ← prefix_bytes ↦ value
    const list<int> prefix ← prefix_payload ↦ list<int>
    const artifact.ContentIdentity identity ← artifact.ContentIdentity {
        algorithm = "sha-256",
        digest = digest,
        length = total
    }
    do {
        const gguf_manifest.GgufManifest m ← gguf_manifest.inspect(
            (int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ _range(prefix, start, length),
            total,
            identity
        )
        if m.data_start ≠ expected_data {
            panic "Gradus data offset disagrees with the independent GGUF oracle"
        }
        print "PASS version=" + (m.version ↦ string)
            + " alignment=" + (m.alignment ↦ string)
            + " data=" + (m.data_start ↦ string)
            + " metadata=" + (m.metadata.length() ↦ string)
            + " tensors=" + (m.tensors.length() ↦ string)
            + " architecture=" + gguf_manifest.text(m, "general.architecture")
    }
    catch err { panic gguf_manifest.message(err) }
}
