+++
locale = "en"
+++
import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" manifestum
import from "norma:processus" processus
import from "norma:solum" solum

# The executable adapter owns the path and I/O. It reads the independently
# bounded table prefix once, then gives Gradus an operation-scoped range
# function over that application-owned buffer. Gradus never receives or
# retains the path or the prefix.
fn _range(list<int> prefix, int initium, int longitudo) → bytes ⇥ manifestum.GgufManifestError {
    if initium < 0 or longitudo < 0 or initium > prefix.length() - longitudo {
        throw variant FonsMala {message = "inspection attempted to read the tensor data region"}
    }
    # `sectio` performs one bulk copy. In particular, do not rebuild this
    # range one byte at a time: the FMIR stepper's octeti carrier is owned, so
    # repeated byte appends would copy the growing buffer on every iteration.
    const list<int> segmentum ← prefix.slice(initium, initium + longitudo)
    const bytes bytes ← segmentum ↦ bytes
    return bytes
}

main {
    const list<string> args ← processus.argv() ↦ list<string>
    if args.length() ≠ 3 {
        panic "usage: gguf-inspect <path> <expected-data-offset> <sha256>"
    }
    const string via ← args.get(0) coalesce ""
    const int data_expectata ← (args.get(1) coalesce "0") ↦ int
    const string digestio ← args.get(2) coalesce ""
    const int total ← solum.byte_length(via)
    const bytes prefix_bytes ← solum.read_range(via, 0, data_expectata)
    if prefix_bytes.length() ≠ data_expectata {
        panic "file adapter returned a short table-prefix read"
    }
    const value prefix_valor ← prefix_bytes ↦ value
    const list<int> prefix ← prefix_valor ↦ list<int>
    const artifact.ContentIdentity identitas ← artifact.ContentIdentity {
        algorithm = "sha-256",
        digest = digestio,
        length = total
    }
    do {
        const manifestum.GgufManifest m ← manifestum.inspect(
            (int initium, int longitudo) → bytes ⇥ manifestum.GgufManifestError ∴ _range(prefix, initium, longitudo),
            total,
            identitas
        )
        if m.data_inceptum ≠ data_expectata {
            panic "Gradus data offset disagrees with the independent GGUF oracle"
        }
        print "PASS version=" + (m.version ↦ string)
            + " alignment=" + (m.concordatio ↦ string)
            + " data=" + (m.data_inceptum ↦ string)
            + " metadata=" + (m.metadata.length() ↦ string)
            + " tensors=" + (m.tensors.length() ↦ string)
            + " architecture=" + manifestum.textum(m, "general.architecture")
    }
    catch err { panic manifestum.message(err) }
}
