importa ex "gradus:model/artifact" privata artifact
importa ex "gradus:model/gguf_manifest" privata manifestum
importa ex "norma:processus" privata processus
importa ex "norma:solum" privata solum

# The executable adapter owns the path and I/O. It reads the independently
# bounded table prefix once, then gives Gradus an operation-scoped range
# function over that application-owned buffer. Gradus never receives or
# retains the path or the prefix.
functio _range(lista<numerus> prefix, numerus initium, numerus longitudo) → manifestum.LectioFontis {
    si initium < 0 aut longitudo < 0 aut initium > prefix.longitudo() - longitudo {
        redde manifestum.LectioFontis {
            successus = falsum,
            bytes = ||,
            causa = "inspection attempted to read the tensor data region"
        }
    }
    # `sectio` performs one bulk copy. In particular, do not rebuild this
    # range one byte at a time: the FMIR stepper's octeti carrier is owned, so
    # repeated byte appends would copy the growing buffer on every iteration.
    fixum lista<numerus> segmentum ← prefix.sectio(initium, initium + longitudo)
    fixum octeti bytes ← segmentum ↦ octeti
    redde manifestum.LectioFontis { successus = verum, bytes = bytes, causa = "" }
}

incipit {
    fixum lista<textus> args ← processus.argumenta() ↦ lista<textus>
    si args.longitudo() ≠ 3 {
        mori "usage: gguf-inspect <path> <expected-data-offset> <sha256>"
    }
    fixum textus via ← args.accipe(0) vel ""
    fixum numerus data_expectata ← (args.accipe(1) vel "0") ↦ numerus
    fixum textus digestio ← args.accipe(2) vel ""
    fixum numerus total ← solum.mensura(via)
    fixum octeti prefix_bytes ← solum.partem(via, 0, data_expectata)
    si prefix_bytes.longitudo() ≠ data_expectata {
        mori "file adapter returned a short table-prefix read"
    }
    fixum valor prefix_valor ← prefix_bytes ↦ valor
    fixum lista<numerus> prefix ← prefix_valor ↦ lista<numerus>
    fixum artifact.IdentitasContenuti identitas ← artifact.IdentitasContenuti {
        algorithmus = "sha-256",
        digestio = digestio,
        longitudo = total
    }
    fac {
        fixum manifestum.ManifestumGguf m ← manifestum.inspice(
            (numerus initium, numerus longitudo) → manifestum.LectioFontis ∴ _range(prefix, initium, longitudo),
            total,
            identitas
        )
        si m.data_inceptum ≠ data_expectata {
            mori "Gradus data offset disagrees with the independent GGUF oracle"
        }
        nota "PASS version=" + (m.versio ↦ textus)
            + " alignment=" + (m.concordatio ↦ textus)
            + " data=" + (m.data_inceptum ↦ textus)
            + " metadata=" + (m.metadata.longitudo() ↦ textus)
            + " tensors=" + (m.tensores.longitudo() ↦ textus)
            + " architecture=" + manifestum.textum(m, "general.architecture")
    }
    cape err { mori manifestum.causa(err) }
}
