# MODEL-03 (GGUF-M3) executed per-layer agreement exemplar.
#
# Application-owned adapter (the gguf-admit-qwen35moe + moe-probe pattern):
# resolves the operator artifact path from argv, pins identity (digest +
# length), admits the qwen35moe manifest, derives + validates the hybrid
# layer schedule against the tensor inventory, then replays the 40 trunk
# layers' attention sub-blocks over the pinned llama.cpp probe dump —
# one prefill batch of the pinned token window plus one one-token decode
# step — comparing every named per-layer tensor (state and output) under
# the delivery band with a first-divergence record. Incremental replay and
# reset/replay determinism are executed on the same real row. Gradus never
# receives the path, a reader, or a whole-model byte list; every payload
# read is a bounded sub-window through the app-owned range source.
#
# Component tier only: no token, logit, MoE FFN, full-model, or device
# claim. The llama.cpp probe itself lives in trials evidence.

import from "gradus:model/artifact" artifact

import from "gradus:model/gguf_manifest" gguf_manifest

import from "gradus:model/qwen35moe" qwen35moe

import from "gradus:model/qwen35moe_state/schedule" schedule
import from "gradus:model/qwen35moe_state/session" session
import from "gradus:model/qwen35moe_state/linear_attn" linear_attn
import from "gradus:model/qwen35moe_state/full_attn" full_attn

import from "gradus:model/tensor_payload" tensor_payload

import from "gradus:model/tensor_view" tensor_view

import from "gradus:tensor" tensor

import from "norma:fs" fs

import from "norma:process" process

# Pinned identity facts for the local Qwen3.6 artifact (operator evidence,
# never committed): the same frozen facts as the moe-probe oracle header.
const string QWEN36_DIGEST ← "0b21525e972670ed59e1812e170b27c26355381f0656ecc4e25617ece7dac58b"
const int QWEN36_LENGTH ← 22663387424
const int QWEN36_DATA ← 10991392

# Pinned window: the probe's prefill token list and the probe build.
const int PREFILL_TOKENS ← 7

# Band: derived against the pinned comparator (trials evidence,
# m3-ssm-attention-oracle); tolerances are never widened, any mismatch is
# a divergence receipt naming the first divergent element.
const f32 DELTA ← 0.00035380

# Every variant carries the message; read it directly off the union value.
union ProbeError {
    @ shared
    string message

    ProbeArguments,
    ProbeIdentity,
    ProbeAdmission,
    ProbeWindow,
    ProbeDump,
    ProbeDivergence
}

# --- artifact admission + weight windows (moe-probe pattern) ---------------

fn checked_range(string via, int total, int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    if start < 0 or length < 0 or start > total - length {
        throw variant BadSource {message = "range request exceeds the artifact"}
    }
    const bytes bytes ← fs.read_range(via, start, length)
    if bytes.length() ≠ length {
        throw variant BadSource {message = "short range read"}
    }
    return bytes
}

# The GGUF tensor name for one canonical base name (adapter-owned suffix
# table; ssm_a has no suffix, ssm_dt carries ".bias").
fn tensor_gguf_name(string base) → string {
    if base.ends_with(".ssm_a") {
        return base
    }
    if base.ends_with(".ssm_dt") {
        return base + ".bias"
    }
    return base + ".weight"
}

# Carrier shape per canonical base name (the module checks the returned
# shape, so this mapping is the adapter's declaration).
fn carrier_shape(string base) → list<int> {
    if base.ends_with(".attn_norm") {
        return [2048]
    }
    if base.ends_with(".attn_qkv") {
        return [8192, 2048]
    }
    if base.ends_with(".attn_gate") {
        return [4096, 2048]
    }
    if base.ends_with(".ssm_conv1d") {
        return [8192, 4]
    }
    if base.ends_with(".ssm_dt") {
        return [32]
    }
    if base.ends_with(".ssm_a") {
        return [32]
    }
    if base.ends_with(".ssm_beta") {
        return [32, 2048]
    }
    if base.ends_with(".ssm_alpha") {
        return [32, 2048]
    }
    if base.ends_with(".ssm_norm") {
        return [128]
    }
    if base.ends_with(".ssm_out") {
        return [2048, 4096]
    }
    if base.ends_with(".attn_q") {
        return [8192, 2048]
    }
    if base.ends_with(".attn_k") {
        return [512, 2048]
    }
    if base.ends_with(".attn_v") {
        return [512, 2048]
    }
    if base.ends_with(".attn_q_norm") {
        return [256]
    }
    if base.ends_with(".attn_k_norm") {
        return [256]
    }
    if base.ends_with(".attn_output") {
        return [2048, 4096]
    }
    return [1]
}

fn content_identity(string digest, int length) → artifact.ContentIdentity ⇥ ProbeError {
    do {
        return artifact.identity("sha-256", digest, length)
    }
    catch err {
        throw variant ProbeIdentity {message = "content identity invalid: §"(err.message)}
    }
}

fn payload_window(gguf_manifest.GgufManifest m, string name) → tuple<start: int, span: int> ⇥ ProbeError {
    do {
        return gguf_manifest.payload_limit(m, name)
    }
    catch err {
        throw variant ProbeWindow {message = "payload range failed for §: §"(name, err.message)}
    }
}

fn bind_view(gguf_manifest.GgufManifest m, tensor_payload.TensorPayload p) → tensor_view.TensorView ⇥ ProbeError {
    do {
        return tensor_view.links(m, p)
    }
    catch err {
        throw variant ProbeWindow {message = "view bind failed for §: §"(p.name, err.message)}
    }
}

fn materialize_window(tensor_view.TensorView v, int start, int length, (int, int) → bytes ⇥ gguf_manifest.GgufManifestError source) → list<f32> ⇥ ProbeError {
    do {
        return tensor_view.materialize_slice(v, start, length, source)
    }
    catch err {
        throw variant ProbeWindow {message = "window materialize failed for §: §"(v.name, err.message)}
    }
}

fn construct_carrier(list<f32> y, list<int> shape) → tensor.NumericBlock ⇥ ProbeError {
    do {
        return tensor.construct(y, shape)
    }
    catch err {
        throw variant ProbeWindow {message = "carrier construction failed"}
    }
}

fn weight_window(string via, int total, gguf_manifest.GgufManifest m, string base) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError {
    const (int, int) → bytes ⇥ gguf_manifest.GgufManifestError reader ← (int begin, int span) → bytes ⇥ gguf_manifest.GgufManifestError ∴ checked_range(via, total, begin, span)
    do {
        const tuple<start: int, span: int> limit ← payload_window(m, tensor_gguf_name(base))
        const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
            name = tensor_gguf_name(base),
            absolute_start = limit.start,
            length = limit.span,
            bytes = ||
        }
        const tensor_view.TensorView v ← bind_view(m, p)
        const list<int> shape ← carrier_shape(base)
        const int length ← shape.reduce((int length, int d) ∴ length * d, 1)
        const list<f32> y ← materialize_window(v, 0, length, reader)
        const tensor.NumericBlock carrier ← construct_carrier(y, shape)
        return carrier
    }
    catch err {
        throw variant BadWindow {message = "weight window failed: §"(err.message)}
    }
}

fn admitinspect_manifest(gguf_manifest.GgufCorpus corpus, string digest, int total) → qwen35moe.Qwen35moeAdmission ⇥ ProbeError {
    do {
        return qwen35moe.admit(corpus, digest, total)
    }
    catch err {
        throw variant ProbeAdmission {message = qwen35moe.admission_message(err)}
    }
}

fn build_corpus(string via, int total, string digest) → gguf_manifest.GgufCorpus ⇥ ProbeError {
    do {
        const artifact.ContentIdentity identity ← content_identity(digest, total)
        const bytes prefix_bytes ← fs.read_range(via, 0, QWEN36_DATA)
        if prefix_bytes.length() ≠ QWEN36_DATA {
            throw variant ProbeAdmission {message = "short table-prefix read"}
        }
        return gguf_manifest.GgufCorpus {
            table = prefix_bytes,
            artifact_length = total,
            identity = identity
        }
    }
    catch err {
        throw variant ProbeAdmission {message = err.message}
    }
}

fn inspect_manifest((int, int) → bytes ⇥ gguf_manifest.GgufManifestError source, int total, artifact.ContentIdentity identity) → gguf_manifest.GgufManifest ⇥ ProbeError {
    do {
        return gguf_manifest.inspect(source, total, identity)
    }
    catch err {
        throw variant ProbeAdmission {message = "manifest admission failed: §"(err.message)}
    }
}


# Every state.* failure funnels into the probe window channel as-is.
@ conversion
fn from_state_error(schedule.Qwen35moeStateError err) → ProbeError {
    return variant ProbeWindow {message = err.message}
}

# --- probe dump reading (raw f32 files in the dump directory) --------------

fn read_f32_file(string path, int count) → list<f32> ⇥ ProbeError {
    const bytes raw ← fs.read_range(path, 0, count * 4)
    if raw.length() ≠ count * 4 {
        throw variant ProbeDump {message = "short dump read: §"(path)}
    }
    var list<f32> out ← empty
    for range 0‥count const i {
        out.append(raw[i * 4‥i * 4 + 4] ↦ float<f32, Le>)
    }
    return out
}

fn dump_path(string dump_dir, int phase, string name) → string {
    return "§/p§_§.f32"(dump_dir, phase, name)
}

# Layer input rows [T][2048] from the dump: layer 0 reads the input
# embedding, later layers the previous layer's post_moe output. The dump
# tensor is [2048, T] (ggml linear order, channel innermost).
fn layer_input(string dump_dir, int phase, int layer, int tokens) → list<f32> ⇥ ProbeError {
    var string name ← ""
    if layer ≡ 0 {
        name ← "model.input_embed"
    }
    else {
        name ← "l_out-§"(layer - 1)
    }
    const list<f32> raw ← read_f32_file(dump_path(dump_dir, phase, name), 2048 * tokens)
    var list<f32> rows ← empty
    for range 0‥tokens const t {
        for range 0‥2048 const d {
            rows.append(raw.get(t * 2048 + d) coalesce 0.0 ∷ f32)
        }
    }
    return rows
}

# Compare one computed row-major window [T][row_width] against a dump
# tensor laid out [width, T] (ggml order). Returns the first divergence
# text or "none" and accumulates the max deviation.
fn compare_window(string label, list<f32> mine, list<f32> dump, int tokens, int width, f32 delta, f32 worst) → tuple<verdict: string, worst: f32> {
    if mine.length() ≠ tokens * width {
        return tuple<verdict: string, worst: f32> ["count mismatch for §: computed § expected §"(label, mine.length(), tokens * width), worst]
    }
    var f32 max_dev ← worst
    for range 0‥tokens const t {
        for range 0‥width const d {
            const f32 a ← mine.get(t * width + d) coalesce 0.0 ∷ f32
            const f32 b ← dump.get(t * width + d) coalesce 0.0 ∷ f32
            const f32 dev ← (a - b).abs()
            max_dev ← max_dev ⤒ dev
            if dev ≻ delta {
                return tuple<verdict: string, worst: f32> ["layer § at token § element §: computed § dump §"(label, t, d, a, b), max_dev]
            }
        }
    }
    return tuple<verdict: string, worst: f32> ["none", max_dev]
}

# Compare a computed head-major window [T][heads][dim] against a dump
# tensor laid out [dim, heads, T].
fn compare_heads(string label, list<f32> mine, list<f32> dump, int tokens, int heads, int dim, f32 delta, f32 worst) → tuple<verdict: string, worst: f32> {
    if mine.length() ≠ tokens * heads * dim {
        return tuple<verdict: string, worst: f32> ["count mismatch for §"(label), worst]
    }
    var f32 max_dev ← worst
    for range 0‥tokens const t {
        for range 0‥heads const h {
            for range 0‥dim const d {
                const f32 a ← mine.get((t * heads + h) * dim + d) coalesce 0.0 ∷ f32
                const f32 b ← dump.get(t * heads * dim + h * dim + d) coalesce 0.0 ∷ f32
                const f32 dev ← (a - b).abs()
                max_dev ← max_dev ⤒ dev
                if dev ≻ delta {
                    return tuple<verdict: string, worst: f32> ["layer § token § head § element §: computed § dump §"(label, t, h, d, a, b), max_dev]
                }
            }
        }
    }
    return tuple<verdict: string, worst: f32> ["none", max_dev]
}

# Compare the recurrent state cells [heads][dim*dim] against the dump
# tensor [dim, dim, heads] (same linear order: head-major, row-major cells
# with the value index innermost).
fn compare_state(string label, list<f32> mine, list<f32> dump, int heads, int dim, f32 delta, f32 worst) → tuple<verdict: string, worst: f32> {
    if mine.length() ≠ heads * dim * dim {
        return tuple<verdict: string, worst: f32> ["count mismatch for §"(label), worst]
    }
    var f32 max_dev ← worst
    for range 0‥heads const h {
        for range 0‥dim const j {
            for range 0‥dim const i {
                const f32 a ← mine.get(h * dim * dim + j * dim + i) coalesce 0.0 ∷ f32
                const f32 b ← dump.get(i + j * dim + h * dim * dim) coalesce 0.0 ∷ f32
                const f32 dev ← (a - b).abs()
                max_dev ← max_dev ⤒ dev
                if dev ≻ delta {
                    return tuple<verdict: string, worst: f32> ["layer § head § cell §,§: computed § dump §"(label, h, i, j, a, b), max_dev]
                }
            }
        }
    }
    return tuple<verdict: string, worst: f32> ["none", max_dev]
}

# Compare per (token, head) scalar windows (beta_sigmoid, gate) against a
# dump tensor laid out [1, heads, T].
fn compare_scalars(string label, list<f32> mine, list<f32> dump, int tokens, int heads, f32 delta, f32 worst) → tuple<verdict: string, worst: f32> {
    var f32 max_dev ← worst
    for range 0‥tokens const t {
        for range 0‥heads const h {
            const f32 a ← mine.get(t * heads + h) coalesce 0.0 ∷ f32
            const f32 b ← dump.get(t * heads + h) coalesce 0.0 ∷ f32
            const f32 dev ← (a - b).abs()
            max_dev ← max_dev ⤒ dev
            if dev ≻ delta {
                return tuple<verdict: string, worst: f32> ["layer § token § head §: computed § dump §"(label, t, h, a, b), max_dev]
            }
        }
    }
    return tuple<verdict: string, worst: f32> ["none", max_dev]
}

# Compare per (token, head) rows where the dump carries fewer heads than the
# computed trace (the q/k head repeat happens inside the comparator's fused
# op): computed head h reads dump head h % dump_heads.
fn compare_repeated_heads(string label, list<f32> mine, list<f32> dump, int tokens, int heads, int dump_heads, int dim, f32 delta, f32 worst) → tuple<verdict: string, worst: f32> {
    var f32 max_dev ← worst
    for range 0‥tokens const t {
        for range 0‥heads const h {
            for range 0‥dim const d {
                const f32 a ← mine.get((t * heads + h) * dim + d) coalesce 0.0 ∷ f32
                const f32 b ← dump.get(t * dump_heads * dim + (h % dump_heads) * dim + d) coalesce 0.0 ∷ f32
                const f32 dev ← (a - b).abs()
                max_dev ← max_dev ⤒ dev
                if dev ≻ delta {
                    return tuple<verdict: string, worst: f32> ["layer § token § head § element §: computed § dump §"(label, t, h, d, a, b), max_dev]
                }
            }
        }
    }
    return tuple<verdict: string, worst: f32> ["none", max_dev]
}

# Compare the conv input window [(rows + T)][channels] against the dump
# tensor [rows + T, channels] (channel-major in the dump: the row index is
# the innermost dimension).
fn compare_conv(string label, list<f32> mine, list<f32> dump, int rows, f32 delta, f32 worst) → tuple<verdict: string, worst: f32> {
    const int channels ← 8192
    const int total ← rows * channels
    if mine.length() ≠ total or dump.length() ≺ total {
        return tuple<verdict: string, worst: f32> ["count mismatch for §"(label), worst]
    }
    var f32 max_dev ← worst
    for range 0‥rows const r {
        for range 0‥channels const ch {
            const f32 a ← mine.get(r * channels + ch) coalesce 0.0 ∷ f32
            const f32 b ← dump.get(ch * rows + r) coalesce 0.0 ∷ f32
            const f32 dev ← (a - b).abs()
            max_dev ← max_dev ⤒ dev
            if dev ≻ delta {
                return tuple<verdict: string, worst: f32> ["layer § row § channel §: computed § dump §"(label, r, ch, a, b), max_dev]
            }
        }
    }
    return tuple<verdict: string, worst: f32> ["none", max_dev]
}

# --- session threading across both phases + incremental replay + reset -----

# One phase's verdict plus the threaded session state it leaves behind.
# Single-variant union: nested list<list<f32>> fields do not parse in genus
# field position (PARSE030), so the variant + accessor shape stays.
union PhaseOutcome {
    Result {
        string verdict
        f32 worst
        list<session.ConvState> conv
        list<session.RecurrentState> recurrent
        list<session.KeyValueState> kv
        list<list<f32>> outputs
    }
}

fn run_phase(string via, int total, gguf_manifest.GgufManifest m, string dump_dir, int phase, int tokens, int start_pos, qwen35moe.Qwen35moeConfig cfg, schedule.Qwen35moeSchedule sched, list<session.ConvState> conv_in, list<session.RecurrentState> recurrent_in, list<session.KeyValueState> kv_in) → PhaseOutcome ⇥ ProbeError {
    var list<session.ConvState> convs ← empty
    var list<session.RecurrentState> recs ← empty
    var list<session.KeyValueState> kvs ← empty
    var list<list<f32>> outputs ← empty
    var f32 worst ← 0.0
    var int passes ← 0
    for range 0‥40 const layer {
        const list<f32> x_rows ← layer_input(dump_dir, phase, layer, tokens)
        const int kind ← sched.kinds.get(layer) coalesce -1
        if kind ≡ 0 {
            const int slot ← schedule.linear_index(sched, layer)
            const session.ConvState conv_cur ← conv_in.get(slot) coalesce session.ConvState {channels = empty, kernel = 3, channels_count = 8192}
            const session.RecurrentState rec_cur ← recurrent_in.get(slot) coalesce session.RecurrentState {cells = empty, value_heads = 32, key_dim = 128, value_dim = 128}
            const linear_attn.LinearAttentionOutcome outcome ← linear_attn.linear_attention(x_rows, layer, conv_cur, rec_cur, (string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ weight_window(via, total, m, name), cfg)
            convs.append(outcome.conv)
            recs.append(outcome.recurrent)
            outputs.append(outcome.out)
            # --- tensor comparisons for this layer ---------------------------------
            const tuple<verdict: string, worst: f32> c1 ← compare_window("§ attn_norm"(layer), outcome.trace.normed, read_f32_file(dump_path(dump_dir, phase, "attn_norm-§"(layer)), 2048 * tokens), tokens, 2048, DELTA, worst)
            const tuple<verdict: string, worst: f32> c2 ← compare_window("§ qkv_mixed"(layer), outcome.trace.qkv_mixed, read_f32_file(dump_path(dump_dir, phase, "linear_attn_qkv_mixed-§"(layer)), 8192 * tokens), tokens, 8192, DELTA, c1.worst)
            const tuple<verdict: string, worst: f32> c3 ← compare_window("§ z"(layer), outcome.trace.gate_proj, read_f32_file(dump_path(dump_dir, phase, "z-§"(layer)), 4096 * tokens), tokens, 4096, DELTA, c2.worst)
            const tuple<verdict: string, worst: f32> c4 ← compare_scalars("§ beta_sigmoid"(layer), outcome.trace.beta_sigmoid, read_f32_file(dump_path(dump_dir, phase, "beta_sigmoid-§"(layer)), 32 * tokens), tokens, 32, DELTA, c3.worst)
            const tuple<verdict: string, worst: f32> c5 ← compare_scalars("§ gate"(layer), outcome.trace.gate, read_f32_file(dump_path(dump_dir, phase, "gate-§"(layer)), 32 * tokens), tokens, 32, DELTA, c4.worst)
            const tuple<verdict: string, worst: f32> c6 ← compare_conv("§ conv_input"(layer), outcome.trace.conv_input, read_f32_file(dump_path(dump_dir, phase, "conv_input-§"(layer)), (3 + tokens) * 8192), 3 + tokens, DELTA, c5.worst)
            const tuple<verdict: string, worst: f32> c7 ← compare_window("§ conv_output"(layer), outcome.trace.conv_output, read_f32_file(dump_path(dump_dir, phase, "conv_output_silu-§"(layer)), 8192 * tokens), tokens, 8192, DELTA, c6.worst)
            const tuple<verdict: string, worst: f32> c8 ← compare_repeated_heads("§ q_conv"(layer), outcome.trace.q_conv, read_f32_file(dump_path(dump_dir, phase, "q_conv_predelta-§"(layer)), 128 * 32 * tokens), tokens, 32, 16, 128, DELTA, c7.worst)
            const tuple<verdict: string, worst: f32> c9 ← compare_repeated_heads("§ k_conv"(layer), outcome.trace.k_conv, read_f32_file(dump_path(dump_dir, phase, "k_conv_predelta-§"(layer)), 128 * 32 * tokens), tokens, 32, 16, 128, DELTA, c8.worst)
            const tuple<verdict: string, worst: f32> c10 ← compare_heads("§ v_conv"(layer), outcome.trace.v_conv, read_f32_file(dump_path(dump_dir, phase, "v_conv_predelta-§"(layer)), 128 * 32 * tokens), tokens, 32, 128, DELTA, c9.worst)
            const tuple<verdict: string, worst: f32> c11 ← compare_heads("§ core_out"(layer), outcome.trace.core_out, read_f32_file(dump_path(dump_dir, phase, "attn_output-§"(layer)), 128 * 32 * tokens), tokens, 32, 128, DELTA, c10.worst)
            const tuple<verdict: string, worst: f32> c12 ← compare_window("§ final_output"(layer), outcome.trace.final_output, read_f32_file(dump_path(dump_dir, phase, "final_output-§"(layer)), 4096 * tokens), tokens, 4096, DELTA, c11.worst)
            const tuple<verdict: string, worst: f32> c13 ← compare_window("§ attn_residual"(layer), outcome.out, read_f32_file(dump_path(dump_dir, phase, "attn_residual-§"(layer)), 2048 * tokens), tokens, 2048, DELTA, c12.worst)
            const tuple<verdict: string, worst: f32> c14 ← compare_state("§ new_state"(layer), outcome.recurrent.cells, read_f32_file(dump_path(dump_dir, phase, "new_state-§"(layer)), 128 * 128 * 32), 32, 128, DELTA, c13.worst)
            const tuple<verdict: string, worst: f32> c15 ← compare_conv("§ conv_state_last"(layer), outcome.conv.channels, read_f32_file(dump_path(dump_dir, phase, "conv_state_last-§"(layer)), 3 * 8192), 3, DELTA, c14.worst)
            worst ← c15.worst
            if (c1.verdict ≢ "none") or (c15.verdict ≢ "none") {
                var string which ← c1.verdict
                if which ≡ "none" {
                    which ← c15.verdict
                }
                return variant Result {verdict = "FAIL layer=§ first-divergence=§"(layer, which), worst = worst, conv = convs, recurrent = recs, kv = kvs, outputs = outputs}
            }
            passes ↑
            print "PASS phase=§ layer=§ kind=linear max-dev=§"(phase, layer, worst)
        }
        else {
            const int slot ← schedule.attention_index(sched, layer)
            const session.KeyValueState kv_cur ← kv_in.get(slot) coalesce session.KeyValueState {keys = empty, values = empty, kv_heads = 2, key_dim = 256, value_dim = 256, capacity = 262144, length = 0}
            const full_attn.FullAttentionOutcome outcome ← full_attn.full_attention(x_rows, layer, kv_cur, start_pos, (string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ weight_window(via, total, m, name), cfg)
            kvs.append(outcome.kv)
            outputs.append(outcome.out)
            # --- tensor comparisons for this layer ---------------------------------
            const tuple<verdict: string, worst: f32> c1 ← compare_window("§ attn_norm"(layer), outcome.trace.normed, read_f32_file(dump_path(dump_dir, phase, "attn_norm-§"(layer)), 2048 * tokens), tokens, 2048, DELTA, worst)
            const tuple<verdict: string, worst: f32> c2 ← compare_window("§ Qcur_full"(layer), outcome.trace.q_full, read_f32_file(dump_path(dump_dir, phase, "Qcur_full-§"(layer)), 8192 * tokens), tokens, 8192, DELTA, c1.worst)
            const tuple<verdict: string, worst: f32> c3 ← compare_heads("§ Qcur"(layer), outcome.trace.q_rope, read_f32_file(dump_path(dump_dir, phase, "Qcur-§"(layer)), 256 * 16 * tokens), tokens, 16, 256, DELTA, c2.worst)
            const tuple<verdict: string, worst: f32> c4 ← compare_heads("§ Kcur"(layer), outcome.trace.k_rope, read_f32_file(dump_path(dump_dir, phase, "Kcur-§"(layer)), 256 * 2 * tokens), tokens, 2, 256, DELTA, c3.worst)
            const tuple<verdict: string, worst: f32> c5 ← compare_heads("§ Vcur"(layer), outcome.trace.v, read_f32_file(dump_path(dump_dir, phase, "Vcur-§"(layer)), 256 * 2 * tokens), tokens, 2, 256, DELTA, c4.worst)
            const tuple<verdict: string, worst: f32> c6 ← compare_window("§ attn_gated"(layer), outcome.trace.gated, read_f32_file(dump_path(dump_dir, phase, "attn_gated-§"(layer)), 4096 * tokens), tokens, 4096, DELTA, c5.worst)
            const tuple<verdict: string, worst: f32> c7 ← compare_window("§ attn_residual"(layer), outcome.out, read_f32_file(dump_path(dump_dir, phase, "attn_residual-§"(layer)), 2048 * tokens), tokens, 2048, DELTA, c6.worst)
            worst ← c7.worst
            if (c1.verdict ≢ "none") or (c7.verdict ≢ "none") {
                var string which ← c1.verdict
                if which ≡ "none" {
                    which ← c7.verdict
                }
                return variant Result {verdict = "FAIL layer=§ first-divergence=§"(layer, which), worst = worst, conv = convs, recurrent = recs, kv = kvs, outputs = outputs}
            }
            passes ↑
            print "PASS phase=§ layer=§ kind=attention max-dev=§"(phase, layer, worst)
        }
    }
    return variant Result {verdict = "PASS layers=§"(passes), worst = worst, conv = convs, recurrent = recs, kv = kvs, outputs = outputs}
}

# Incremental replay: feed the prefill window one token at a time through
# the same per-layer state machinery and check exact equality of every
# per-token output row against the batched pass (F5), then verify the
# terminal states match (equality is exact: identical op order).
fn replay_prefill(string via, int total, gguf_manifest.GgufManifest m, string dump_dir, qwen35moe.Qwen35moeConfig cfg, schedule.Qwen35moeSchedule sched, list<session.ConvState> conv_in, list<session.RecurrentState> recurrent_in, list<session.KeyValueState> kv_in, list<list<f32>> batched_outputs) → string ⇥ ProbeError {
    var list<session.ConvState> convs ← empty
    for from conv_in const c {
        convs.append(c)
    }
    var list<session.RecurrentState> recs ← empty
    for from recurrent_in const r {
        recs.append(r)
    }
    var list<session.KeyValueState> kvs ← empty
    for from kv_in const k {
        kvs.append(k)
    }
    for range 0‥PREFILL_TOKENS const t {
        for range 0‥40 const layer {
            var list<f32> one_row ← empty
            const list<f32> all_rows ← layer_input(dump_dir, 0, layer, PREFILL_TOKENS)
            for range 0‥2048 const d {
                one_row.append(all_rows.get(t * 2048 + d) coalesce 0.0 ∷ f32)
            }
            const int kind ← sched.kinds.get(layer) coalesce -1
            if kind ≡ 0 {
                const int slot ← schedule.linear_index(sched, layer)
                const session.ConvState conv_cur ← convs.get(slot) coalesce session.ConvState {channels = empty, kernel = 3, channels_count = 8192}
                const session.RecurrentState rec_cur ← recs.get(slot) coalesce session.RecurrentState {cells = empty, value_heads = 32, key_dim = 128, value_dim = 128}
                const linear_attn.LinearAttentionOutcome outcome ← linear_attn.linear_attention_step(one_row, layer, conv_cur, rec_cur, (string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ weight_window(via, total, m, name), cfg)
                var list<session.ConvState> next_convs ← empty
                for range 0‥convs.length() const ci {
                    if ci ≡ slot {
                        next_convs.append(outcome.conv)
                    }
                    else {
                        next_convs.append(convs.get(ci) coalesce session.ConvState {channels = empty, kernel = 3, channels_count = 8192})
                    }
                }
                convs ← next_convs
                var list<session.RecurrentState> next_recs ← empty
                for range 0‥recs.length() const ri {
                    if ri ≡ slot {
                        next_recs.append(outcome.recurrent)
                    }
                    else {
                        next_recs.append(recs.get(ri) coalesce session.RecurrentState {cells = empty, value_heads = 32, key_dim = 128, value_dim = 128})
                    }
                }
                recs ← next_recs
                # the step output row must equal the batched row exactly
                const list<f32> batch_row ← batched_outputs.get(layer) coalesce empty_row_f32()
                for range 0‥2048 const d {
                    const f32 a ← outcome.out.get(d) coalesce 1.0 ∷ f32
                    const f32 b ← batch_row.get(t * 2048 + d) coalesce 0.0 ∷ f32
                    if a ≠ b {
                        return "replay divergence layer=§ token=§ element=§"(layer, t, d)
                    }
                }
            }
            else {
                const int slot ← schedule.attention_index(sched, layer)
                const session.KeyValueState kv_cur ← kvs.get(slot) coalesce session.KeyValueState {keys = empty, values = empty, kv_heads = 2, key_dim = 256, value_dim = 256, capacity = 262144, length = 0}
                const full_attn.FullAttentionOutcome outcome ← full_attn.full_attention_step(one_row, layer, kv_cur, t, (string name, int start, int length) → tensor.NumericBlock ⇥ schedule.Qwen35moeStateError ∴ weight_window(via, total, m, name), cfg)
                var list<session.KeyValueState> next_kvs ← empty
                for range 0‥kvs.length() const ki {
                    if ki ≡ slot {
                        next_kvs.append(outcome.kv)
                    }
                    else {
                        next_kvs.append(kvs.get(ki) coalesce session.KeyValueState {keys = empty, values = empty, kv_heads = 2, key_dim = 256, value_dim = 256, capacity = 262144, length = 0})
                    }
                }
                kvs ← next_kvs
                const list<f32> batch_row ← batched_outputs.get(layer) coalesce empty_row_f32()
                for range 0‥2048 const d {
                    const f32 a ← outcome.out.get(d) coalesce 1.0 ∷ f32
                    const f32 b ← batch_row.get(t * 2048 + d) coalesce 0.0 ∷ f32
                    if a ≠ b {
                        return "replay divergence layer=§ token=§ element=§"(layer, t, d)
                    }
                }
            }
        }
    }
    return "none"
}

main {
    const list<string> args ← process.argv()
    if args.length() ≠ 4 {
        print "usage: qwen35moe-layer-probe <artifact> <data-offset> <dump-dir>"
        process.exit_process(2)
    }
    const string via ← args.get(1) coalesce ""
    const int total ← QWEN36_LENGTH
    const string digest ← QWEN36_DIGEST
    do {
        # --- admission (identity precondition → manifest → schedule) -----------
        const gguf_manifest.GgufCorpus corpus ← build_corpus(via, total, digest)
        const qwen35moe.Qwen35moeAdmission admission ← admitinspect_manifest(corpus, digest, total)
        print "ADMIT qwen35moe tensors=§ blocks=§"(admission.summary.total, admission.config.block_count)
        const artifact.ContentIdentity identity ← content_identity(digest, total)
        const (int, int) → bytes ⇥ gguf_manifest.GgufManifestError reader ← (int begin, int span) → bytes ⇥ gguf_manifest.GgufManifestError ∴ checked_range(via, total, begin, span)
        const gguf_manifest.GgufManifest manifest ← inspect_manifest(reader, total, identity)
        const schedule.Qwen35moeSchedule sched ← build_schedule(admission.config)
        check_schedule(manifest, sched, admission.config)
        print "SCHEDULE trunk=§ linear=§ full=§ nextn=§"(sched.trunk_layers, sched.linear_layers, sched.full_layers, sched.nextn_layers)
        const string dump_dir ← args.get(3) coalesce ""

        # --- fresh session ------------------------------------------------------
        var list<session.ConvState> convs ← empty
        for range 0‥sched.linear_layers const _ {
            convs.append(fresh_conv(admission.config))
        }
        var list<session.RecurrentState> recs ← empty
        for range 0‥sched.linear_layers const _ {
            recs.append(session.fresh_recurrent_state(admission.config))
        }
        var list<session.KeyValueState> kvs ← empty
        for range 0‥sched.full_layers const _ {
            kvs.append(fresh_kv(admission.config, admission.config.context_length))
        }

        # --- phase 0: prefill batch over the pinned window ----------------------
        const PhaseOutcome phase0 ← run_phase(via, total, manifest, dump_dir, 0, PREFILL_TOKENS, 0, admission.config, sched, convs, recs, kvs)
        print "PHASE0 §"(phase_verdict(phase0))
        if not phase_verdict(phase0).starts_with("PASS") {
            process.exit_process(1)
        }
        convs ← phase_conv(phase0)
        recs ← phase_recurrent(phase0)
        kvs ← phase_kv(phase0)

        # --- reset/replay determinism (F5) ---------------------------------------
        # fresh session, one token at a time, exact equality against the batched
        # per-layer outputs
        var list<session.ConvState> reset_convs ← empty
        for range 0‥sched.linear_layers const _ {
            reset_convs.append(fresh_conv(admission.config))
        }
        var list<session.RecurrentState> reset_recs ← empty
        for range 0‥sched.linear_layers const _ {
            reset_recs.append(session.fresh_recurrent_state(admission.config))
        }
        var list<session.KeyValueState> reset_kvs ← empty
        for range 0‥sched.full_layers const _ {
            reset_kvs.append(fresh_kv(admission.config, admission.config.context_length))
        }
        const string replay ← replay_prefill(via, total, manifest, dump_dir, admission.config, sched, reset_convs, reset_recs, reset_kvs, phase_outputs(phase0))
        print "REPLAY §"(replay)
        if replay ≢ "none" {
            process.exit_process(1)
        }

        # --- phase 1: one-token incremental decode -------------------------------
        const PhaseOutcome phase1 ← run_phase(via, total, manifest, dump_dir, 1, 1, PREFILL_TOKENS, admission.config, sched, convs, recs, kvs)
        print "PHASE1 §"(phase_verdict(phase1))
        if not phase_verdict(phase1).starts_with("PASS") {
            process.exit_process(1)
        }
        print "ORACLE max-dev=§ delta=§"(phase_worst(phase1), DELTA)
        print "PREFILL+DECODE: PASS"
        process.exit_process(0)
    }
    catch err {
        print "error: §"(err.message)
        process.exit_process(1)
    }
}

fn build_schedule(qwen35moe.Qwen35moeConfig c) → schedule.Qwen35moeSchedule ⇥ ProbeError {
    do {
        return schedule.schedule(c)
    }
    catch err {
        throw variant ProbeAdmission {message = err.message}
    }
}

fn check_schedule(gguf_manifest.GgufManifest m, schedule.Qwen35moeSchedule s, qwen35moe.Qwen35moeConfig c) → void ⇥ ProbeError {
    do {
        schedule.validate_schedule(m, s, c)
    }
    catch err {
        throw variant ProbeAdmission {message = err.message}
    }
}

fn empty_row_f32() → list<f32> {
    return empty
}

# These two cross into main's untyped do/catch, where the conversion table
# does not apply — the raw state error needs the ProbeError-typed wrapper.
fn fresh_conv(qwen35moe.Qwen35moeConfig c) → session.ConvState ⇥ ProbeError {
    do {
        return session.fresh_conv_state(c)
    }
    catch err {
        throw variant ProbeWindow {message = err.message}
    }
}

fn fresh_kv(qwen35moe.Qwen35moeConfig c, int capacity) → session.KeyValueState ⇥ ProbeError {
    do {
        return session.fresh_kv_state(c, capacity)
    }
    catch err {
        throw variant ProbeWindow {message = err.message}
    }
}

fn phase_verdict(PhaseOutcome p) → string {
    match p {
        case Result const verdict, worst, conv, recurrent, kv, outputs {
            return verdict
        }
    }
}

fn phase_worst(PhaseOutcome p) → f32 {
    match p {
        case Result const verdict, worst, conv, recurrent, kv, outputs {
            return worst
        }
    }
}

fn phase_conv(PhaseOutcome p) → list<session.ConvState> {
    match p {
        case Result const verdict, worst, conv, recurrent, kv, outputs {
            return conv
        }
    }
}

fn phase_recurrent(PhaseOutcome p) → list<session.RecurrentState> {
    match p {
        case Result const verdict, worst, conv, recurrent, kv, outputs {
            return recurrent
        }
    }
}

fn phase_kv(PhaseOutcome p) → list<session.KeyValueState> {
    match p {
        case Result const verdict, worst, conv, recurrent, kv, outputs {
            return kv
        }
    }
}

fn phase_outputs(PhaseOutcome p) → list<list<f32>> {
    match p {
        case Result const verdict, worst, conv, recurrent, kv, outputs {
            return outputs
        }
    }
}

