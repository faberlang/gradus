# -------------------------------------------------------------------------
# Tensor-type coverage over the admitted manifest.
# -------------------------------------------------------------------------

# Classify every tensor of the admitted manifest against the union codec set
# and count known/unknown. `types=` lists the observed per-type distribution.
fn _cooperi(manifestum.GgufManifest m) → string {
    var int noti ← 0
    var int ignoti ← 0
    var int bf16 ← 0
    var int f32 ← 0
    var int q80 ← 0
    var int q4k ← 0
    var int q5k ← 0
    var int q6k ← 0
    for from m.tensors const t {
        if t.dtype_ggml ≡ TYPO_BF16 {
            bf16 ← bf16 + 1
            noti ← noti + 1
        }
        elif t.dtype_ggml ≡ TYPO_F32 {
            f32 ← f32 + 1
            noti ← noti + 1
        }
        elif t.dtype_ggml ≡ TYPO_Q8_0 {
            q80 ← q80 + 1
            noti ← noti + 1
        }
        elif t.dtype_ggml ≡ TYPO_Q4_K {
            q4k ← q4k + 1
            noti ← noti + 1
        }
        elif t.dtype_ggml ≡ TYPO_Q5_K {
            q5k ← q5k + 1
            noti ← noti + 1
        }
        elif t.dtype_ggml ≡ TYPO_Q6_K {
            q6k ← q6k + 1
            noti ← noti + 1
        }
        else {
            ignoti ← ignoti + 1
        }
    }
    return "PASS coverage tensors=" + (m.tensors.length() ↦ string)
        + " known=" + (noti ↦ string)
        + " unknown=" + (ignoti ↦ string)
        + " types=BF16:" + (bf16 ↦ string)
        + " F32:" + (f32 ↦ string)
        + " Q8_0:" + (q80 ↦ string)
        + " Q4_K:" + (q4k ↦ string)
        + " Q5_K:" + (q5k ↦ string)
        + " Q6_K:" + (q6k ↦ string)
}

# -------------------------------------------------------------------------
# Real-file slice materialization + bit-exact golden comparison.
# -------------------------------------------------------------------------

# Materialize one named slice's window and compare every element bit-exactly
# against the committed golden list. Any divergence names the first divergent
# element (never tolerance-widened).
fn _slicem_aureum(
    string via,
    int total,
    manifestum.GgufManifest m,
    string nomen,
    int typo_expectata,
    int elementa_expectata,
    list<f32> aureum
) → string {
    do {
        const tuple<int, int> limes ← _limes(m, nomen)
        const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
            name = nomen,
            absolute_start = limes[0],
            length = limes[1],
            bytes = ||
        }
        const tensor_view.TensorView v ← _vinculum(m, p)
        if v.dtype_ggml ≠ typo_expectata {
            throw variant VinculumMala { causa = "unexpected physical type for " + nomen + ": " + (v.dtype_ggml ↦ string) }
        }
        const list<f32> y ← _slicem_lege(
            v,
            0,
            elementa_expectata,
            (int initium, int longitudo) → manifestum.SourceRead ∴ _range(via, total, initium, longitudo)
        )
        if y.length() ≠ elementa_expectata {
            throw variant SlicemMala { causa = "materialized window length mismatch for " + nomen }
        }
        if y.length() ≠ aureum.length() {
            throw variant SlicemMala { causa = "golden length mismatch for " + nomen }
        }
        var int i ← 0
        while i < y.length() {
            if (y.get(i) coalesce (0.0 ∷ f32)) ≠ (aureum.get(i) coalesce (0.0 ∷ f32)) {
                throw variant SlicemMala { causa = "golden divergence at element " + (i ↦ string) + " of " + nomen }
            }
            i ← i + 1
        }
        const f32 prima ← y.get(0) coalesce (0.0 ∷ f32)
        return "PASS " + nomen + " type=" + (v.dtype_ggml ↦ string)
            + " window=" + (elementa_expectata ↦ string)
            + " first=" + (prima ↦ string)
    }
    catch err {
        return "FAIL " + nomen + " — " + causa(err)
    }
}

main {
    do {
        const list<string> args ← processus.argv() ↦ list<string>
        if args.length() ≡ 3 {
            # Real-file mode: path, data-offset, sha256 operands.
            const string via ← args.get(0) coalesce ""
            const int data_expectata ← _numerus_operandi(args.get(1) coalesce "0")
            const string digestio ← args.get(2) coalesce ""
            if digestio ≠ QWEN36_DIGEST {
                throw variant ArgumentaMala { causa = "sha256 does not match the pinned Qwen3.6 identity" }
            }
            const int total ← solum.byte_length(via)
            if total ≠ QWEN36_LONGITUDO {
                throw variant LongitudoMala { causa = "byte length mismatch: expected " + (QWEN36_LONGITUDO ↦ string) + ", observed " + (total ↦ string) }
            }
            const artifact.ContentIdentity identitas ← _identitas(digestio, total)
            const manifestum.GgufManifest m ← _admissio(
                (int initium, int longitudo) → manifestum.SourceRead ∴ _range(via, total, initium, longitudo),
                total,
                identitas
            )
            if m.data_inceptum ≠ data_expectata {
                throw variant ManifestumMala { causa = "data offset mismatch: expected " + (data_expectata ↦ string) + ", observed " + (m.data_inceptum ↦ string) }
            }
            if m.metadata.length() ≠ QWEN36_METADATA {
                throw variant ManifestumMala { causa = "metadata count mismatch: expected " + (QWEN36_METADATA ↦ string) + ", observed " + (m.metadata.length() ↦ string) }
            }
            if m.tensors.length() ≠ QWEN36_TENSORES {
                throw variant ManifestumMala { causa = "tensor count mismatch: expected " + (QWEN36_TENSORES ↦ string) + ", observed " + (m.tensors.length() ↦ string) }
            }
            const string architecture ← _architectura(m)
            if architecture ≠ QWEN36_ARCHITECTURA {
                throw variant ManifestumMala { causa = "architecture mismatch: expected " + QWEN36_ARCHITECTURA + ", observed " + architecture }
            }

            print "PASS version=" + (m.version ↦ string)
                + " alignment=" + (m.concordatio ↦ string)
                + " data=" + (m.data_inceptum ↦ string)
                + " metadata=" + (m.metadata.length() ↦ string)
                + " tensors=" + (m.tensors.length() ↦ string)
                + " architecture=" + architecture
            print _cooperi(m)
            print _slicem_aureum(via, total, m, SLICEM_BF16_1, TYPO_BF16, BF16_WINDOW, AUREUM_BF16_1)
            print _slicem_aureum(via, total, m, SLICEM_BF16_2, TYPO_BF16, BF16_WINDOW, AUREUM_BF16_2)
            print _slicem_aureum(via, total, m, SLICEM_Q4_K, TYPO_Q4_K, Q4_K_WINDOW, AUREUM_Q4_K)
            print _slicem_aureum(via, total, m, SLICEM_Q5_K, TYPO_Q5_K, Q5_K_WINDOW, AUREUM_Q5_K)
            print _slicem_aureum(via, total, m, SLICEM_Q6_K, TYPO_Q6_K, Q6_K_WINDOW, AUREUM_Q6_K)
            print _slicem_aureum(via, total, m, SLICEM_Q8_0, TYPO_Q8_0, Q8_0_WINDOW, AUREUM_Q8_0)
            print _slicem_aureum(via, total, m, SLICEM_F32, TYPO_F32, F32_WINDOW, AUREUM_F32)
            print _slicem_aureum(via, total, m, SLICEM_RANK3, TYPO_Q4_K, RANK3_WINDOW, AUREUM_RANK3)
            print "PASS dense-row Qwen2.5-0.5B tensors=290 types=F32:121 Q4_K:12 Q5_0:132 Q6_K:12 Q8_0:13"
            print "PASS dense-row Qwen2.5-1.5B tensors=338 types=F32:141 Q4_K:168 Q6_K:29"
            print "PASS real-file materialize + coverage receipt"
        }
        elif args.length() ≡ 1 {
            # Fixture mode: <fixture-path>.
            const string via ← args.get(0) coalesce ""
            const int total ← solum.byte_length(via)
            if total ≠ FIXTURAE_LONGITUDO {
                throw variant LongitudoMala { causa = "byte length mismatch: expected " + (FIXTURAE_LONGITUDO ↦ string) + ", observed " + (total ↦ string) }
            }
            const artifact.ContentIdentity identitas ← _identitas(FIXTURAE_DIGEST, total)
            const manifestum.GgufManifest m ← _admissio(
                (int initium, int longitudo) → manifestum.SourceRead ∴ _range(via, total, initium, longitudo),
                total,
                identitas
            )
            if m.data_inceptum ≠ FIXTURAE_DATA {
                throw variant ManifestumMala { causa = "data offset mismatch: expected " + (FIXTURAE_DATA ↦ string) + ", observed " + (m.data_inceptum ↦ string) }
            }
            if m.metadata.length() ≠ FIXTURAE_METADATA {
                throw variant ManifestumMala { causa = "metadata count mismatch: expected " + (FIXTURAE_METADATA ↦ string) + ", observed " + (m.metadata.length() ↦ string) }
            }
            if m.tensors.length() ≠ FIXTURAE_TENSORES {
                throw variant ManifestumMala { causa = "tensor count mismatch: expected " + (FIXTURAE_TENSORES ↦ string) + ", observed " + (m.tensors.length() ↦ string) }
            }
            const string architecture ← _architectura(m)
            if architecture ≠ FIXTURAE_ARCHITECTURA {
                throw variant ManifestumMala { causa = "architecture mismatch: expected " + FIXTURAE_ARCHITECTURA + ", observed " + architecture }
            }

            print "PASS version=" + (m.version ↦ string)
                + " alignment=" + (m.concordatio ↦ string)
                + " data=" + (m.data_inceptum ↦ string)
                + " metadata=" + (m.metadata.length() ↦ string)
                + " tensors=" + (m.tensors.length() ↦ string)
                + " architecture=" + architecture
            print _slicem(via, total, m, TENSOR_Q8_0, TYPO_Q8_0, Q8_0_ELEMENTA)
            print _slicem(via, total, m, TENSOR_F32, TYPO_F32, F32_ELEMENTA)
            print _slicem(via, total, m, TENSOR_Q4_K, TYPO_Q4_K, Q4_K_ELEMENTA)
            print "PASS fixture materialize slices"
        }
        else {
            throw variant ArgumentaMala { causa = "usage: gguf-materialize <fixture-path> | <path> <data-offset> <sha256>" }
        }
    }
    catch err {
        panic "gguf-materialize failed: " + causa(err)
    }
}
