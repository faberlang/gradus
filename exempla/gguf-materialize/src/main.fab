# GGUF-A3 C3-U1 — exempla/gguf-materialize fixture mode.
#
# Application-owned file adapter over the committed deterministic fixture
# `fixtures/gguf/smollm2-360m-scaled-row.gguf` (F32/Q8_0/Q4_K tensors, the
# A1b precedent tier). The app resolves one GGUF path, measures the artifact,
# admits the manifest through the public `gradus:model/gguf_manifest`
# surface, binds the named tensor payloads via `vincula`, materializes
# bounded element windows via `materializa_slicem`, and prints observed PASS
# lines. Gradus never receives the path, the reader, or a whole-model byte
# list; every payload read is a bounded sub-window through the app-owned
# range source.
#
# This proves checked packed-storage materialization of real committed
# fixture bytes (deterministic data region) at the package-MIR slice tier.
# It makes no token, model-execution, logit, or device claim.

importa ex "gradus:model/artifact" artifact
importa ex "gradus:model/gguf_manifest" manifestum
importa ex "gradus:model/tensor_payload" tensor_payload
importa ex "gradus:model/tensor_view" tensor_view
importa ex "norma:processus" processus
importa ex "norma:solum" solum

# Pinned oracle facts for the committed fixture (measured with `stat` and
# `shasum -a 256`; data offset and counts from the independent GGUF reader,
# the A1b receipt pattern). The fixture is deterministic and in-repo, so the
# fixture mode pins its identity; the real-file mode (C3-U2) takes the
# path + data-offset + sha256 operands from the CLI.
fixum textus FIXTURAE_DIGEST ← "d89c9ef917158bfb5600f417020479499c6c042f728e9a29c8457a6b1a8f0974"
fixum numerus FIXTURAE_LONGITUDO ← 3936
fixum numerus FIXTURAE_DATA ← 1024
fixum numerus FIXTURAE_METADATA ← 18
fixum numerus FIXTURAE_TENSORES ← 3
fixum textus FIXTURAE_ARCHITECTURA ← "llama"

# Named fixture slices: (tensor, expected physical type id, window start,
# window length). Every window is block-aligned and well under the slice
# cap; Q8_0/F32/Q4_K cover three of the seven admitted layouts.
fixum textus TENSOR_Q8_0 ← "token_embd.weight"
fixum textus TENSOR_F32 ← "blk.0.attn_norm.weight"
fixum textus TENSOR_Q4_K ← "blk.0.ffn_down.weight"
fixum numerus TYPO_Q8_0 ← 8
fixum numerus TYPO_F32 ← 0
fixum numerus TYPO_Q4_K ← 12
fixum numerus Q8_0_ELEMENTA ← 32
fixum numerus F32_ELEMENTA ← 16
fixum numerus Q4_K_ELEMENTA ← 256

discretio MaterializeError {
    ArgumentaMala { textus causa }
    LongitudoMala { textus causa }
    ManifestumMala { textus causa }
    VinculumMala { textus causa }
    SlicemMala { textus causa }
}

functio causa(MaterializeError e) → textus {
    discerne e {
        casu ArgumentaMala fixum causa { redde causa }
        casu LongitudoMala fixum causa { redde causa }
        casu ManifestumMala fixum causa { redde causa }
        casu VinculumMala fixum causa { redde causa }
        casu SlicemMala fixum causa { redde causa }
    }
}

# Application-owned range source: one bounded read through solum.partem,
# checked against the artifact length. Each materialize block sub-window
# goes through this function; no whole-tensor or whole-model read exists.
functio _range(textus via, numerus total, numerus initium, numerus longitudo) → manifestum.LectioFontis {
    si initium < 0 aut longitudo < 0 aut initium > total - longitudo {
        redde manifestum.LectioFontis {
            successus = falsum,
            bytes = ||,
            causa = "range request exceeds the artifact"
        }
    }
    fixum octeti bytes ← solum.partem(via, initium, longitudo)
    si bytes.longitudo() ≠ longitudo {
        redde manifestum.LectioFontis {
            successus = falsum,
            bytes = ||,
            causa = "short range read"
        }
    }
    redde manifestum.LectioFontis { successus = verum, bytes = bytes, causa = "" }
}

# Wrappers: the app maps each library error type to the single app-level
# MaterializeError so one fac/cape handler covers every stage.
functio _limes(manifestum.ManifestumGguf m, textus nomen) → iuncta<numerus, numerus> ⇥ MaterializeError {
    fac {
        redde manifestum.limes_payloadis(m, nomen)
    }
    cape err {
        iace finge ManifestumMala { causa = "payload range failed for " + nomen + ": " + manifestum.causa(err) }
    }
}

functio _vinculum(manifestum.ManifestumGguf m, tensor_payload.TensorPayload p) → tensor_view.VisumTensoris ⇥ MaterializeError {
    fac {
        redde tensor_view.vincula(m, p)
    }
    cape err {
        iace finge VinculumMala { causa = "view bind failed for " + p.nomen + ": " + tensor_view.causa(err) }
    }
}

functio _slicem_lege(
    tensor_view.VisumTensoris v,
    numerus initium_elementum,
    numerus longitudo_elementum,
    (numerus, numerus) → manifestum.LectioFontis fons
) → lista<f32> ⇥ MaterializeError {
    fac {
        redde tensor_view.materializa_slicem(v, initium_elementum, longitudo_elementum, fons)
    }
    cape err {
        iace finge SlicemMala { causa = "window materialize failed for " + v.nomen + ": " + tensor_view.causa(err) }
    }
}

# Bind one named tensor's payload and materialize a bounded element window.
# Returns the observed PASS/FAIL line.
functio _slicem(
    textus via,
    numerus total,
    manifestum.ManifestumGguf m,
    textus nomen,
    numerus typo_expectata,
    numerus elementa_expectata
) → textus {
    fac {
        # The exact stored byte range of the known-layout tensor.
        fixum iuncta<numerus, numerus> limes ← _limes(m, nomen)
        fixum octeti bytes ← solum.partem(via, limes[0], limes[1])
        si bytes.longitudo() ≠ limes[1] {
            iace finge LongitudoMala { causa = "short payload read for " + nomen }
        }
        fixum tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
            nomen = nomen,
            initium_absolutum = limes[0],
            longitudo = limes[1],
            bytes = bytes
        }
        fixum tensor_view.VisumTensoris v ← _vinculum(m, p)
        si v.typo_ggml ≠ typo_expectata {
            iace finge VinculumMala { causa = "unexpected physical type for " + nomen + ": " + (v.typo_ggml ↦ textus) }
        }
        fixum lista<f32> y ← _slicem_lege(
            v,
            0,
            elementa_expectata,
            (numerus initium, numerus longitudo) → manifestum.LectioFontis ∴ _range(via, total, initium, longitudo)
        )
        si y.longitudo() ≠ elementa_expectata {
            iace finge SlicemMala { causa = "materialized window length mismatch for " + nomen + ": " + (y.longitudo() ↦ textus) }
        }
        fixum f32 prima ← y.accipe(0) vel (0.0 ∷ f32)
        redde "PASS " + nomen + " type=" + (v.typo_ggml ↦ textus)
            + " window=" + (elementa_expectata ↦ textus)
            + " first=" + (prima ↦ textus)
    }
    cape err {
        redde "FAIL " + nomen + " — " + causa(err)
    }
}

# Admit the manifest through the public range seam; the failure is wrapped
# so the application boundary names the manifest stage.
functio _admissio(
    (numerus, numerus) → manifestum.LectioFontis fons,
    numerus longitudo_artifacti,
    artifact.IdentitasContenuti identitas
) → manifestum.ManifestumGguf ⇥ MaterializeError {
    fac {
        redde manifestum.inspice(fons, longitudo_artifacti, identitas)
    }
    cape err {
        iace finge ManifestumMala { causa = "manifest admission failed: " + manifestum.causa(err) }
    }
}

functio _architectura(manifestum.ManifestumGguf m) → textus ⇥ MaterializeError {
    fac {
        redde manifestum.textum(m, "general.architecture")
    }
    cape err {
        iace finge ManifestumMala { causa = "architecture fact read failed: " + manifestum.causa(err) }
    }
}

functio _identitas(textus digestio, numerus longitudo) → artifact.IdentitasContenuti ⇥ MaterializeError {
    fac {
        redde artifact.identitas("sha-256", digestio, longitudo)
    }
    cape err {
        iace finge ManifestumMala { causa = "content identity invalid: " + artifact.causa(err) }
    }
}

incipit {
    fac {
        fixum lista<textus> args ← processus.argumenta() ↦ lista<textus>
        si args.longitudo() ≠ 1 {
            iace finge ArgumentaMala { causa = "usage: gguf-materialize <fixture-path>" }
        }
        fixum textus via ← args.accipe(0) vel ""
        fixum numerus total ← solum.mensura(via)
        si total ≠ FIXTURAE_LONGITUDO {
            iace finge LongitudoMala { causa = "byte length mismatch: expected " + (FIXTURAE_LONGITUDO ↦ textus) + ", observed " + (total ↦ textus) }
        }
        fixum artifact.IdentitasContenuti identitas ← _identitas(FIXTURAE_DIGEST, total)
        fixum manifestum.ManifestumGguf m ← _admissio(
            (numerus initium, numerus longitudo) → manifestum.LectioFontis ∴ _range(via, total, initium, longitudo),
            total,
            identitas
        )
        si m.data_inceptum ≠ FIXTURAE_DATA {
            iace finge ManifestumMala { causa = "data offset mismatch: expected " + (FIXTURAE_DATA ↦ textus) + ", observed " + (m.data_inceptum ↦ textus) }
        }
        si m.metadata.longitudo() ≠ FIXTURAE_METADATA {
            iace finge ManifestumMala { causa = "metadata count mismatch: expected " + (FIXTURAE_METADATA ↦ textus) + ", observed " + (m.metadata.longitudo() ↦ textus) }
        }
        si m.tensores.longitudo() ≠ FIXTURAE_TENSORES {
            iace finge ManifestumMala { causa = "tensor count mismatch: expected " + (FIXTURAE_TENSORES ↦ textus) + ", observed " + (m.tensores.longitudo() ↦ textus) }
        }
        fixum textus architecture ← _architectura(m)
        si architecture ≠ FIXTURAE_ARCHITECTURA {
            iace finge ManifestumMala { causa = "architecture mismatch: expected " + FIXTURAE_ARCHITECTURA + ", observed " + architecture }
        }

        nota "PASS version=" + (m.versio ↦ textus)
            + " alignment=" + (m.concordatio ↦ textus)
            + " data=" + (m.data_inceptum ↦ textus)
            + " metadata=" + (m.metadata.longitudo() ↦ textus)
            + " tensors=" + (m.tensores.longitudo() ↦ textus)
            + " architecture=" + architecture
        nota _slicem(via, total, m, TENSOR_Q8_0, TYPO_Q8_0, Q8_0_ELEMENTA)
        nota _slicem(via, total, m, TENSOR_F32, TYPO_F32, F32_ELEMENTA)
        nota _slicem(via, total, m, TENSOR_Q4_K, TYPO_Q4_K, Q4_K_ELEMENTA)
        nota "PASS fixture materialize slices"
    }
    cape err {
        mori "gguf-materialize fixture mode failed: " + causa(err)
    }
}
