# GGUF-A3 C3-U2 — exempla/gguf-materialize real-file mode + coverage + receipt.
#
# Application-owned file adapter over (a) the committed deterministic fixture
# `fixtures/gguf/smollm2-360m-scaled-row.gguf` (F32/Q8_0/Q4_K tensors, the
# A1b precedent tier) and (b) the local Qwen3.6 artifact in real-file mode.
# The app resolves a GGUF path, measures the artifact, admits the manifest
# through the public `gradus:model/gguf_manifest` surface, binds the named
# tensor payloads via `vincula`, materializes bounded element windows via
# `materializa_slicem`, and prints observed PASS lines. Gradus never receives
# the path, the reader, or a whole-model byte list; every payload read is a
# bounded sub-window through the app-owned range source.
#
# Real-file mode (the gguf-inspect 3-arg form: path, expected data offset,
# sha-256) prints the Qwen3.6 tensor-type coverage line, materializes the
# named slice table (the two BF16 rows, one Q4_K/Q5_K/Q6_K/Q8_0/F32 slice, and
# one rank-3 expert per-expert window), and compares every slice bit-exactly
# against the committed golden expected values (derived at the unit boundary
# from the local Qwen3.6 artifact with the same reference oracle as the
# committed `fixtures/gguf/gguf-dequant-goldens.json`; observed values recorded
# in the README receipt). It also prints the two Qwen2.5 dense-row derived
# type-distribution lines (unit-boundary derivation recorded in the coverage
# record).
#
# This proves checked packed-storage materialization of real artifact bytes at
# the package-MIR slice tier. It makes no token, model-execution, logit, or
# device claim.

import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" manifestum
import from "gradus:model/tensor_payload" tensor_payload
import from "gradus:model/tensor_view" tensor_view
import from "norma:processus" processus
import from "norma:solum" solum

# Pinned oracle facts for the committed fixture (measured with `stat` and
# `shasum -a 256`; data offset and counts from the independent GGUF reader,
# the A1b receipt pattern). The fixture is deterministic and in-repo, so the
# fixture mode pins its identity; the real-file mode (C3-U2) takes the
# path + data-offset + sha256 operands from the CLI.
const string FIXTURAE_DIGEST ← "d89c9ef917158bfb5600f417020479499c6c042f728e9a29c8457a6b1a8f0974"
const int FIXTURAE_LONGITUDO ← 3936
const int FIXTURAE_DATA ← 1024
const int FIXTURAE_METADATA ← 18
const int FIXTURAE_TENSORES ← 3
const string FIXTURAE_ARCHITECTURA ← "llama"

# Named fixture slices: (tensor, expected physical type id, window start,
# window length). Every window is block-aligned and well under the slice
# cap; Q8_0/F32/Q4_K cover three of the seven admitted layouts.
const string TENSOR_Q8_0 ← "token_embd.weight"
const string TENSOR_F32 ← "blk.0.attn_norm.weight"
const string TENSOR_Q4_K ← "blk.0.ffn_down.weight"
const int TYPO_Q8_0 ← 8
const int TYPO_F32 ← 0
const int TYPO_Q4_K ← 12
const int Q8_0_ELEMENTA ← 32
const int F32_ELEMENTA ← 16
const int Q4_K_ELEMENTA ← 256

union MaterializeError {
    ArgumentaMala { string causa }
    LongitudoMala { string causa }
    ManifestumMala { string causa }
    VinculumMala { string causa }
    SlicemMala { string causa }
}

fn causa(MaterializeError e) → string {
    match e {
        case ArgumentaMala const causa { return causa }
        case LongitudoMala const causa { return causa }
        case ManifestumMala const causa { return causa }
        case VinculumMala const causa { return causa }
        case SlicemMala const causa { return causa }
    }
}

# Application-owned range source: one bounded read through solum.partem,
# checked against the artifact length. Each materialize block sub-window
# goes through this function; no whole-tensor or whole-model read exists.
fn _range(string via, int total, int initium, int longitudo) → manifestum.SourceRead {
    if initium < 0 or longitudo < 0 or initium > total - longitudo {
        return manifestum.SourceRead {
            successus = false,
            bytes = ||,
            message = "range request exceeds the artifact"
        }
    }
    const bytes bytes ← solum.read_range(via, initium, longitudo)
    if bytes.length() ≠ longitudo {
        return manifestum.SourceRead {
            successus = false,
            bytes = ||,
            message = "short range read"
        }
    }
    return manifestum.SourceRead { successus = true, bytes = bytes, message = "" }
}

# Wrappers: the app maps each library error type to the single app-level
# MaterializeError so one fac/cape handler covers every stage.
fn _limes(manifestum.GgufManifest m, string nomen) → tuple<int, int> ⇥ MaterializeError {
    do {
        return manifestum.limes_payloadis(m, nomen)
    }
    catch err {
        throw variant ManifestumMala { causa = "payload range failed for " + nomen + ": " + manifestum.message(err) }
    }
}

fn _vinculum(manifestum.GgufManifest m, tensor_payload.TensorPayload p) → tensor_view.TensorView ⇥ MaterializeError {
    do {
        return tensor_view.links(m, p)
    }
    catch err {
        throw variant VinculumMala { causa = "view bind failed for " + p.name + ": " + tensor_view.message(err) }
    }
}

fn _slicem_lege(
    tensor_view.TensorView v,
    int initium_elementum,
    int longitudo_elementum,
    (int, int) → manifestum.SourceRead fons
) → list<f32> ⇥ MaterializeError {
    do {
        return tensor_view.materialize_slice(v, initium_elementum, longitudo_elementum, fons)
    }
    catch err {
        throw variant SlicemMala { causa = "window materialize failed for " + v.name + ": " + tensor_view.message(err) }
    }
}

# Bind one named tensor's payload and materialize a bounded element window.
# Returns the observed PASS/FAIL line.
fn _slicem(
    string via,
    int total,
    manifestum.GgufManifest m,
    string nomen,
    int typo_expectata,
    int elementa_expectata
) → string {
    do {
        # The exact stored byte range of the known-layout tensor.
        const tuple<int, int> limes ← _limes(m, nomen)
        const bytes bytes ← solum.read_range(via, limes[0], limes[1])
        if bytes.length() ≠ limes[1] {
            throw variant LongitudoMala { causa = "short payload read for " + nomen }
        }
        const tensor_payload.TensorPayload p ← tensor_payload.TensorPayload {
            name = nomen,
            absolute_start = limes[0],
            length = limes[1],
            bytes = bytes
        }
        const tensor_view.TensorView v ← _vinculum(m, p)
        if v.dtype_ggml ≠ typo_expectata {
            throw variant VinculumMala { causa = "unexpected physical type for " + nomen + ": " + (v.dtype_ggml ↦ string) }
        }
        const list<f32> y ← _slicem_lege(
            v,
            0,
            elementa_expectata,
            (int initium, int longitudo) → manifestum.SourceRead ∴ _range(via, total, initium, longitudo)
        )
        if y.length() ≠ elementa_expectata {
            throw variant SlicemMala { causa = "materialized window length mismatch for " + nomen + ": " + (y.length() ↦ string) }
        }
        const f32 prima ← y.get(0) coalesce (0.0 ∷ f32)
        return "PASS " + nomen + " type=" + (v.dtype_ggml ↦ string)
            + " window=" + (elementa_expectata ↦ string)
            + " first=" + (prima ↦ string)
    }
    catch err {
        return "FAIL " + nomen + " — " + causa(err)
    }
}

# Admit the manifest through the public range seam; the failure is wrapped
# so the application boundary names the manifest stage.
fn _admissio(
    (int, int) → manifestum.SourceRead fons,
    int longitudo_artifacti,
    artifact.ContentIdentity identitas
) → manifestum.GgufManifest ⇥ MaterializeError {
    do {
        return manifestum.inspect(fons, longitudo_artifacti, identitas)
    }
    catch err {
        throw variant ManifestumMala { causa = "manifest admission failed: " + manifestum.message(err) }
    }
}

fn _architectura(manifestum.GgufManifest m) → string ⇥ MaterializeError {
    do {
        return manifestum.textum(m, "general.architecture")
    }
    catch err {
        throw variant ManifestumMala { causa = "architecture fact read failed: " + manifestum.message(err) }
    }
}

fn _identitas(string digestio, int longitudo) → artifact.ContentIdentity ⇥ MaterializeError {
    do {
        return artifact.identitas("sha-256", digestio, longitudo)
    }
    catch err {
        throw variant ManifestumMala { causa = "content identity invalid: " + artifact.message(err) }
    }
}

# The textus->numerus cast is a conversion operation with its own error type;
# wrap it so the real-file mode's single fac/cape handler stays MaterializeError.
fn _numerus_operandi(string s) → int ⇥ MaterializeError {
    do {
        return s ↦ int
    }
    catch err {
        throw variant ArgumentaMala { causa = "data-offset operand is not a number: " + s }
    }
}

