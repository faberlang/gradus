+++ toml
locale = "en"

+++ faber
# Direct-device pin of the public gradus:decode_token.layer_step composition
# over its record contract (gradus #47). The real-dimension fixture pins the
# public layer composition.
import from "gradus:decode_token" let dt

const size D = 960
const size QD = 960
const size KVD = 320
const size F = 2560
const size H = 15
const size C = 4

type RLW = dt.LayerWeights<size 960, size 960, size 320, size 2560>
type RSV = dt.SlotView<size 4, size 320>
type RLP = dt.LayerParams

fn weight(int r, int c, int salt) → f32 {
    return (((r * 7 + c * 3 + salt * 5) % 17 - 8) ↦ f32) * 0.001
}

main {
    let tensor<f32, [15, 4]> hcdom ← tf32[15, 4] {}
    mut tensor<f32, [960]> hin ← tf32[960] {}
    mut tensor<f32, [960]> hout ← tf32[960] {}
    mut tensor<f32, [960]> anorm ← tf32[960] {}
    mut tensor<f32, [960, 960]> wq ← tf32[960, 960] {}
    mut tensor<f32, [320, 960]> wk ← tf32[320, 960] {}
    mut tensor<f32, [320, 960]> wv ← tf32[320, 960] {}
    mut tensor<f32, [960, 960]> wo ← tf32[960, 960] {}
    mut tensor<f32, [960]> fnorm ← tf32[960] {}
    mut tensor<f32, [2560, 960]> wg ← tf32[2560, 960] {}
    mut tensor<f32, [2560, 960]> wu ← tf32[2560, 960] {}
    mut tensor<f32, [960, 2560]> wd ← tf32[960, 2560] {}
    mut tensor<f32, [4, 320]> kin ← tf32[4, 320] {}
    mut tensor<f32, [4, 320]> vin ← tf32[4, 320] {}

    for exclusive D let j {
        hin[[j]] ← ((j * 2 - 3) ↦ f32) * 0.2
        anorm[[j]] ← 0.8 + (j ↦ f32) * 0.1
        fnorm[[j]] ← 1.1 - (j ↦ f32) * 0.05
    }
    for exclusive QD let r {
        for exclusive D let c {
            wq[[r, c]] ← weight(r, c, 1)
        }
    }
    for exclusive KVD let r {
        for exclusive D let c {
            wk[[r, c]] ← weight(r, c, 2)
            wv[[r, c]] ← weight(r, c, 3)
        }
    }
    for exclusive D let r {
        for exclusive QD let c {
            wo[[r, c]] ← weight(r, c, 4)
        }
        for exclusive F let c {
            wd[[r, c]] ← weight(r, c, 7)
        }
    }
    for exclusive F let r {
        for exclusive D let c {
            wg[[r, c]] ← weight(r, c, 5)
            wu[[r, c]] ← weight(r, c, 6)
        }
    }
    for exclusive C let r {
        for exclusive KVD let c {
            kin[[r, c]] ← (1 + r * 3 + c ↦ f32) * 0.1
            vin[[r, c]] ← (0 - (1 + r * 2 + c) ↦ f32) * 0.07
        }
    }

    let RLW lw ← dt.LayerWeights<size 960, size 960, size 320, size 2560> { anorm = anorm, wq = wq, wk = wk, wv = wv, wo = wo, fnorm = fnorm, wg = wg, wu = wu, wd = wd }
    mut RSV sv ← dt.SlotView<size 4, size 320> { kin = kin, vin = vin, pos = 2 }
    let RLP lp ← dt.LayerParams { pdh = 64 ∷ i32, pspan = 32 ∷ i32, pgroup = 3 ∷ i32, prope = variant dt.RopeKind.Pairs, peps = 0.00001 ∷ f32, plntheta = 11.512925 ∷ f32, pscale = 0.125 }

    dt.layer_step(hcdom, hin, mut hout, lw, mut sv, lp)

    for exclusive D let j {
        print "hidden[" + (j ↦ string) + "]=" + (hout[[j]] ↦ string)
    }
    for exclusive C let r {
        for exclusive KVD let c {
            print "key[" + (r ↦ string) + "," + (c ↦ string) + "]=" + (kin[[r, c]] ↦ string)
            print "value[" + (r ↦ string) + "," + (c ↦ string) + "]=" + (vin[[r, c]] ↦ string)
        }
    }
}
