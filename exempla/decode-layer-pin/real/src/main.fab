+++
locale = "en"
+++
# Real-shape direct-device pin of the public gradus:decode_token.layer_step composition.
# The independent f64 real-shape oracle is a separate follow-up proof.
import from "gradus:decode_token" dt

const int D = 960
const int QD = 960
const int KVD = 320
const int F = 2560
const int H = 15
const int C = 8

fn weight(int r, int c, int salt) → f32 {
    return (((r * 7 + c * 3 + salt * 5) % 17 - 8) ↦ f32) * 0.025
}

main {
    mut tensor<f32, [15]> hdom ← tf32[15] {}
    mut tensor<f32, [960]> hin ← tf32[960] {}
    mut tensor<f32, [960]> hout ← tf32[960] {}
    mut tensor<f32, [960]> anorm ← tf32[960] {}
    mut tensor<f32, [960, 960]> wq ← tf32[960, 960] {}
    mut tensor<f32, [320, 960]> wk ← tf32[320, 960] {}
    mut tensor<f32, [320, 960]> wv ← tf32[320, 960] {}
    mut tensor<f32, [960, 960]> wo ← tf32[960, 960] {}
    mut tensor<f32, [960]> fnorm ← tf32[960] {}
    mut tensor<f32, [2560, 960]> wg ← tf32[2560, 960] {}
    mut tensor<f32, [2560, 960]> wu ← tf32[2560, 960] {}
    mut tensor<f32, [960, 2560]> wd ← tf32[960, 2560] {}
    mut tensor<f32, [8, 320]> kin ← tf32[8, 320] {}
    mut tensor<f32, [8, 320]> vin ← tf32[8, 320] {}

    for range 0‥D let j {
        hin[[j]] ← ((j * 2 - 3) ↦ f32) * 0.2
        anorm[[j]] ← 0.8 + (j ↦ f32) * 0.1
        fnorm[[j]] ← 1.1 - (j ↦ f32) * 0.05
    }
    for range 0‥QD let r {
        for range 0‥D let c {
            wq[[r, c]] ← weight(r, c, 1)
        }
    }
    for range 0‥KVD let r {
        for range 0‥D let c {
            wk[[r, c]] ← weight(r, c, 2)
            wv[[r, c]] ← weight(r, c, 3)
        }
    }
    for range 0‥D let r {
        for range 0‥QD let c {
            wo[[r, c]] ← weight(r, c, 4)
        }
        for range 0‥F let c {
            wd[[r, c]] ← weight(r, c, 7)
        }
    }
    for range 0‥F let r {
        for range 0‥D let c {
            wg[[r, c]] ← weight(r, c, 5)
            wu[[r, c]] ← weight(r, c, 6)
        }
    }
    for range 0‥C let r {
        for range 0‥KVD let c {
            kin[[r, c]] ← (1 + r * 3 + c ↦ f32) * 0.1
            vin[[r, c]] ← (0 - (1 + r * 2 + c) ↦ f32) * 0.07
        }
    }

    dt.layer_step(hdom, hin, mut hout, anorm, wq, wk, wv, wo, fnorm, wg, wu, wd, mut kin, mut vin, 7, D, QD, F, C, 64, 32, 3, 0.00001, 11.512925, 0.125, 1)

    for range 0‥D let j {
        print "hidden[" + (j ↦ string) + "]=" + (hout[[j]] ↦ string)
    }
    for range 0‥C let r {
        for range 0‥KVD let c {
            print "key[" + (r ↦ string) + "," + (c ↦ string) + "]=" + (kin[[r, c]] ↦ string)
            print "value[" + (r ↦ string) + "," + (c ↦ string) + "]=" + (vin[[r, c]] ↦ string)
        }
    }
}
