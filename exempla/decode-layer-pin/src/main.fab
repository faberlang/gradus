+++ toml
locale = "en"

+++ faber
# Direct-device pin of the public gradus:decode_token.layer_step composition
# over its record contract (gradus #47). This first fixture is deliberately
# small; the larger real-shape mode and its independent high-precision oracle
# are maintained alongside this executable.
import from "gradus:decode_token" let dt

const size D = 4
const size QD = 4
const size KVD = 2
const size F = 6
const size H = 2
const size C = 3

type PLW = dt.LayerWeights<size 4, size 4, size 2, size 6>
type PSV = dt.SlotView<size 3, size 2>
type PLP = dt.LayerParams

fn weight(int r, int c, int salt) → f32 {
    return (((r * 7 + c * 3 + salt * 5) % 17 - 8) ↦ f32) * 0.025
}

main {
    let tensor<f32, [H, C]> hcdom ← tf32[H, C] {}
    mut tensor<f32, [4]> hin ← tf32[4] {}
    mut tensor<f32, [4]> hout ← tf32[4] {}
    mut tensor<f32, [4]> anorm ← tf32[4] {}
    mut tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    mut tensor<f32, [2, 4]> wk ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> wv ← tf32[2, 4] {}
    mut tensor<f32, [4, 4]> wo ← tf32[4, 4] {}
    mut tensor<f32, [4]> fnorm ← tf32[4] {}
    mut tensor<f32, [6, 4]> wg ← tf32[6, 4] {}
    mut tensor<f32, [6, 4]> wu ← tf32[6, 4] {}
    mut tensor<f32, [4, 6]> wd ← tf32[4, 6] {}
    let tensor<f32, [4]> bq ← tf32[4] {}
    let tensor<f32, [2]> bk ← tf32[2] {}
    let tensor<f32, [2]> bv ← tf32[2] {}
    mut tensor<f32, [3, 2]> kin ← tf32[3, 2] {}
    mut tensor<f32, [3, 2]> vin ← tf32[3, 2] {}

    for exclusive D let j {
        hin[[j]] ← ((j * 2 - 3) ↦ f32) * 0.2
        anorm[[j]] ← 0.8 + (j ↦ f32) * 0.1
        fnorm[[j]] ← 1.1 - (j ↦ f32) * 0.05
    }
    for exclusive QD let r {
        for exclusive D let c {
            wq[[r, c]] ← weight(r, c, 1)
        }
    }
    for exclusive KVD let r {
        for exclusive D let c {
            wk[[r, c]] ← weight(r, c, 2)
            wv[[r, c]] ← weight(r, c, 3)
        }
    }
    for exclusive D let r {
        for exclusive QD let c {
            wo[[r, c]] ← weight(r, c, 4)
        }
        for exclusive F let c {
            wd[[r, c]] ← weight(r, c, 7)
        }
    }
    for exclusive F let r {
        for exclusive D let c {
            wg[[r, c]] ← weight(r, c, 5)
            wu[[r, c]] ← weight(r, c, 6)
        }
    }
    for exclusive C let r {
        for exclusive KVD let c {
            kin[[r, c]] ← (1 + r * 3 + c ↦ f32) * 0.1
            vin[[r, c]] ← (0 - (1 + r * 2 + c) ↦ f32) * 0.07
        }
    }

    let PLW lw ← dt.LayerWeights<size 4, size 4, size 2, size 6> { anorm = anorm, wq = wq, wk = wk, wv = wv, wo = wo, fnorm = fnorm, wg = wg, wu = wu, wd = wd, qkv_bias = 0 ∷ i32, bq = bq, bk = bk, bv = bv }
    mut PSV sv ← dt.SlotView<size 3, size 2> { kin = kin, vin = vin, pos = 1 }
    let PLP lp ← dt.LayerParams { pdh = 2 ∷ i32, pspan = 1 ∷ i32, pgroup = 2 ∷ i32, prope = 2 ∷ i32, peps = 0.00001 ∷ f32, plntheta = 11.512925 ∷ f32, pscale = 0.5 }

    dt.layer_step(hcdom, hin, mut hout, lw, mut sv, lp)

    for exclusive D let j {
        print "hidden[" + (j ↦ string) + "]=" + (hout[[j]] ↦ string)
    }
    for exclusive C let r {
        for exclusive KVD let c {
            print "key[" + (r ↦ string) + "," + (c ↦ string) + "]=" + (kin[[r, c]] ↦ string)
            print "value[" + (r ↦ string) + "," + (c ↦ string) + "]=" + (vin[[r, c]] ↦ string)
        }
    }
}
