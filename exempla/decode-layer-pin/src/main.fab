+++
locale = "en"
+++
# Tiny direct-device fixture for the public gradus:decode_token.layer_step composition.
# The real dimensions are a separate statically shaped package in ./real.
import from "gradus:decode_token" dt

const int D = 4
const int QD = 4
const int KVD = 2
const int F = 6
const int H = 2
const int C = 3

fn weight(int r, int c, int salt) → f32 {
    return (((r * 7 + c * 3 + salt * 5) % 17 - 8) ↦ f32) * 0.025
}

main {
    mut tensor<f32, [2]> hdom ← tf32[2] {}
    mut tensor<f32, [4]> hin ← tf32[4] {}
    mut tensor<f32, [4]> hout ← tf32[4] {}
    mut tensor<f32, [4]> anorm ← tf32[4] {}
    mut tensor<f32, [4, 4]> wq ← tf32[4, 4] {}
    mut tensor<f32, [2, 4]> wk ← tf32[2, 4] {}
    mut tensor<f32, [2, 4]> wv ← tf32[2, 4] {}
    mut tensor<f32, [4, 4]> wo ← tf32[4, 4] {}
    mut tensor<f32, [4]> fnorm ← tf32[4] {}
    mut tensor<f32, [6, 4]> wg ← tf32[6, 4] {}
    mut tensor<f32, [6, 4]> wu ← tf32[6, 4] {}
    mut tensor<f32, [4, 6]> wd ← tf32[4, 6] {}
    mut tensor<f32, [3, 2]> kin ← tf32[3, 2] {}
    mut tensor<f32, [3, 2]> vin ← tf32[3, 2] {}

    for range 0‥D let j {
        hin[[j]] ← ((j * 2 - 3) ↦ f32) * 0.2
        anorm[[j]] ← 0.8 + (j ↦ f32) * 0.1
        fnorm[[j]] ← 1.1 - (j ↦ f32) * 0.05
    }
    for range 0‥QD let r {
        for range 0‥D let c {
            wq[[r, c]] ← weight(r, c, 1)
        }
    }
    for range 0‥KVD let r {
        for range 0‥D let c {
            wk[[r, c]] ← weight(r, c, 2)
            wv[[r, c]] ← weight(r, c, 3)
        }
    }
    for range 0‥D let r {
        for range 0‥QD let c {
            wo[[r, c]] ← weight(r, c, 4)
        }
        for range 0‥F let c {
            wd[[r, c]] ← weight(r, c, 7)
        }
    }
    for range 0‥F let r {
        for range 0‥D let c {
            wg[[r, c]] ← weight(r, c, 5)
            wu[[r, c]] ← weight(r, c, 6)
        }
    }
    for range 0‥C let r {
        for range 0‥KVD let c {
            kin[[r, c]] ← (1 + r * 3 + c ↦ f32) * 0.1
            vin[[r, c]] ← (0 - (1 + r * 2 + c) ↦ f32) * 0.07
        }
    }

    dt.layer_step(hdom, hin, mut hout, anorm, wq, wk, wv, wo, fnorm, wg, wu, wd, mut kin, mut vin, 1, D, QD, F, C, 2, 1, 2, 0.00001, 11.512925, 0.5, 1)

    for range 0‥D let j {
        print "hidden[" + (j ↦ string) + "]=" + (hout[[j]] ↦ string)
    }
    for range 0‥C let r {
        for range 0‥KVD let c {
            print "key[" + (r ↦ string) + "," + (c ↦ string) + "]=" + (kin[[r, c]] ↦ string)
            print "value[" + (r ↦ string) + "," + (c ↦ string) + "]=" + (vin[[r, c]] ↦ string)
        }
    }
}
