    print _pin("tied_1_7", e2(out_t, 1, 7), 0.6161691097)

    # ---- untied row: lm_head is its own canonical tensor (ligatum = falsum)
    const dense.ConfiguraDensa cfg_u ← dense.ConfiguraDensa {strata = 2, capita = 4, capita_kv = 2, dimensio_capitis = 4, dimensio_occulta = 16, vocabulum = 8, ligatum = false}
    const tensor.Tensor out_u ← model_p(cfg_u, (string n, int s) → dense.Repertum ∴ _repertor(n, s, EMBED, NORM_S, W_HEAD, l0, l1, false), tokens, 0.00001 ∷ f32, 0.5 ∷ f32, positions, 4, rq)
