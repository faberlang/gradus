+++
locale = "en"
+++
# dense-model — the REF-01-U1.8 executed proof: the complete ordered dense
# forward graph in gradus:model/dense — embedding gather → 2 ordered U1.5
# blocks → final RMSNorm → output projection, assembled from the typed
# architecture config and materialized stored-weight views via canonical
# names, for a small synthetic dense config (T=2, D=16, F=16, H=4, K=2,
# head_dim=4, vocab 8), with TIED and UNTIED embedding rows.
#
# The pinned values are the independent f64 evaluation of the documented
# formulas (external Python/numpy, the PML3 transformer_block pin
# precedent — the block transcription is validated against the pinned
# dense-block values in src/transformer.proba first), compared within the
# documented 5e-4 absolute tolerance. The same config and reference values
# live at compile level in src/model/dense.proba.
#
# Execution: faber run --target fmir exempla/dense-model. Prints PASS for
# every pinned value (0 FAIL, exit 0), plus the fail-closed rejection rows.
# No device handle, no performance claim; forward-only, no autograd import.
import from "gradus:model/dense" dense

import from "gradus:attention" attention

import from "gradus:tensor" tensor

import from "gradus:dtype" dtype

# Absolute tolerance for f32-vs-f64 comparison (the proba posture).
const f32 TOLERATIO ← 0.0005 ∷ f32

# Build a staged tensor (test data is always valid; the cape fallback is
# unreachable).
fn tene(list<f32> datos, list<int> forma) → tensor.Tensor {
    var tensor.Tensor t
    do {
        t ← tensor.structa(datos, forma)
    }
    catch err {
        return t
    }
    return t
}

# Staged-result element read (swallow the never-firing access errors).
fn e2(tensor.Tensor r, int i, int j) → f32 {
    do {
        return r.accipe([i, j])
    }
    catch err {
        return 0.0 ∷ f32
    }
}

# Validated RopeConfigura (swallow the never-firing construction errors).
fn config_p(f32 base, f32 scale, attention.RopePolitica politica) → attention.RopeConfigura {
    var attention.RopeConfigura c
    do {
        c ← attention.structa_rope_configura(base, scale, politica)
        return c
    }
    catch err {
        return c
    }
    return c
}

# praevideo wrapper for the pin rows: returns the logits tensor (a failure
# would surface as an invalid tensor and fail every pin).
fn model_p(dense.ConfiguraDensa cfg, (string, int) → dense.Repertum fons, list<int> tokens, f32 epsilon, f32 scale, list<int> positions, int rope_dim, attention.RopeConfigura rope_cfg) → tensor.Tensor {
    var tensor.Tensor r
    do {
        r ← dense.praevideo(cfg, fons, tokens, epsilon, scale, positions, rope_dim, rope_cfg)
        return r
    }
    catch err {
        return r
    }
    return r
}

# praevideo wrapper for the rejection rows: renders the typed error's causa
# on failure, "ok" otherwise.
fn model_text(dense.ConfiguraDensa cfg, (string, int) → dense.Repertum fons, list<int> tokens, f32 epsilon, f32 scale, list<int> positions, int rope_dim, attention.RopeConfigura rope_cfg) → string {
    do {
        dense.praevideo(cfg, fons, tokens, epsilon, scale, positions, rope_dim, rope_cfg)
        return "ok"
    }
    catch err {
        return dense.causa(err)
    }
}

# First occurrence of `quid` in `ubi` at or after `ab`, or -1 when absent.
fn _inveni(string ubi, string quid, int ab) → int {
    const int n ← ubi.length()
    const int m ← quid.length()
    if m ≡ 0 or m ≻ n then return -1
    var int i ← ab
    while i + m ≤ n {
        if ubi.slice(i, i + m) ≡ quid then return i
        i ← i + 1
    }
    return -1
}

# Canonical layer suffix after "model.layers.{N}." ("" when not a layer
# name).
fn _suffixum(string nomen) → string {
    const int p ← _inveni(nomen, ".", 13)
    if p ≺ 0 then return ""
    return nomen.slice(p, nomen.length())
}

# Canonical layer suffix → slot index in the per-layer tensor list
# [ln1, wq, wk, wv, wo, ln2, wg, wu, wd]; -1 when unknown.
fn _suffixa(string suffix) → int {
    if suffix ≡ ".input_layernorm" then return 0
    if suffix ≡ ".self_attn.q_proj" then return 1
    if suffix ≡ ".self_attn.k_proj" then return 2
    if suffix ≡ ".self_attn.v_proj" then return 3
    if suffix ≡ ".self_attn.o_proj" then return 4
    if suffix ≡ ".post_attention_layernorm" then return 5
    if suffix ≡ ".mlp.gate_proj" then return 6
    if suffix ≡ ".mlp.up_proj" then return 7
    if suffix ≡ ".mlp.down_proj" then return 8
    return -1
}

# The synthetic resolver: canonical name + layer index → the materialized
# stored-weight view. lm_head always answers with the untied head; the
# assembly only resolves it for the untied row (the tied row reuses the
# embedding directly). `deficiens` makes every layer request fail closed
# (the rejection row).
fn _repertor(string nomen, int stratum, tensor.Tensor embed, tensor.Tensor norm_s, tensor.Tensor w_head, list<tensor.Tensor> l0, list<tensor.Tensor> l1, bool deficiens) → dense.Repertum {
    if nomen ≡ "model.embed_tokens" then return dense.Repertum {successus = true, tensorem = embed, causa = ""}
    if nomen ≡ "model.norm" then return dense.Repertum {successus = true, tensorem = norm_s, causa = ""}
    if nomen ≡ "lm_head" then return dense.Repertum {successus = true, tensorem = w_head, causa = ""}
    if deficiens then return dense.Repertum {successus = false, tensorem = embed, causa = "canonical tensor missing: " + nomen}
    const string suffix ← _suffixum(nomen)
    const int slot ← _suffixa(suffix)
    if slot ≺ 0 then return dense.Repertum {successus = false, tensorem = embed, causa = "unknown canonical tensor: " + nomen}
    var list<tensor.Tensor> strata_c ← l0
    if stratum ≡ 1 {
        strata_c ← l1
    }
    const tensor.Tensor t ← strata_c.get(slot) coalesce embed
    return dense.Repertum {successus = true, tensorem = t, causa = ""}
}

# |a − b| ≤ TOLERATIO — the documented absolute tolerance compare (the
# dense-swiglu precedent; no direct f32→textus cast exists in the FMIR
# image).
fn prox(f32 a, f32 b) → bool {
    const f32 d ← a - b
    if d ≺ 0.0 then return 0.0 - d ≤ TOLERATIO
    return d ≤ TOLERATIO
}

# One pinned element: name + observed vs the f64 reference within
# TOLERATIO. Prints "PASS" or "FAIL" (the run's executed oracle rows).
fn _pin(string name, f32 observata, f32 expectata) → string {
    if prox(observata, expectata) then return name + ": PASS"
    return (((name + ": FAIL observed=") + ((observata * 1000000.0 ↦ int) ↦ string)) + " expected=") + ((expectata * 1000000.0 ↦ int) ↦ string)
}

# One text row: name + observed vs the expected text.
fn _case(string name, string observata, string expectata) → string {
    if observata ≡ expectata then return name + ": PASS"
    return (((name + ": FAIL expected=") + expectata) + " observed=") + observata
}

