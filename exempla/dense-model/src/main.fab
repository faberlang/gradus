    print _pin("untied_1_7", e2(out_u, 1, 7), 0.5977640339)

    # ---- fail-closed rejection: a resolver that fails on layer tensors
    print _case("reject-missing", model_text(cfg_t, (string n, int s) → dense.Repertum ∴ _repertor(n, s, EMBED, NORM_S, W_HEAD, l0, l1, true), tokens, 0.00001 ∷ f32, 0.5 ∷ f32, positions, 4, rq), "canonical tensor missing: model.layers.0.input_layernorm")
