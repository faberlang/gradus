+++
locale = "la"
+++
# dense-model — the REF-01-U1.8 executed proof: the complete ordered dense
# forward graph in gradus:model/dense — embedding gather → 2 ordered U1.5
# blocks → final RMSNorm → output projection, assembled from the typed
# architecture config and materialized stored-weight views via canonical
# names, for a small synthetic dense config (T=2, D=16, F=16, H=4, K=2,
# head_dim=4, vocab 8), with TIED and UNTIED embedding rows.
#
# The pinned values are the independent f64 evaluation of the documented
# formulas (external Python/numpy, the PML3 transformer_block pin
# precedent — the block transcription is validated against the pinned
# dense-block values in src/transformer.proba first), compared within the
# documented 5e-4 absolute tolerance. The same config and reference values
# live at compile level in src/model/dense.proba.
#
# Execution: faber run --target fmir exempla/dense-model. Prints PASS for
# every pinned value (0 FAIL, exit 0), plus the fail-closed rejection rows.
# No device handle, no performance claim; forward-only, no autograd import.
importa ex "gradus:model/dense" dense
importa ex "gradus:attention" attention
importa ex "gradus:tensor" tensor
importa ex "gradus:dtype" dtype

# Absolute tolerance for f32-vs-f64 comparison (the proba posture).
fixum f32 TOLERATIO ← (0.0005 ∷ f32)

# Build a staged tensor (test data is always valid; the cape fallback is
# unreachable).
functio tene(lista<f32> datos, lista<numerus> forma) → tensor.Tensor {
    varia tensor.Tensor t
    fac {
        t ← tensor.structa(datos, forma)
    }
    cape err {
        redde t
    }
    redde t
}

# Staged-result element read (swallow the never-firing access errors).
functio e2(tensor.Tensor r, numerus i, numerus j) → f32 {
    fac {
        redde r.accipe([i, j])
    }
    cape err {
        redde (0.0 ∷ f32)
    }
}

# Validated RopeConfigura (swallow the never-firing construction errors).
functio config_p(f32 base, f32 scale, attention.RopePolitica politica) → attention.RopeConfigura {
    varia attention.RopeConfigura c
    fac {
        c ← attention.structa_rope_configura(base, scale, politica)
        redde c
    }
    cape err {
        redde c
    }
    redde c
}

# praevideo wrapper for the pin rows: returns the logits tensor (a failure
# would surface as an invalid tensor and fail every pin).
functio model_p(
    dense.ConfiguraDensa cfg,
    (textus, numerus) → dense.Repertum fons,
    lista<numerus> tokens,
    f32 epsilon, f32 scale,
    lista<numerus> positions, numerus rope_dim, attention.RopeConfigura rope_cfg
) → tensor.Tensor {
    varia tensor.Tensor r
    fac {
        r ← dense.praevideo(cfg, fons, tokens, epsilon, scale, positions, rope_dim, rope_cfg)
        redde r
    }
    cape err {
        redde r
    }
    redde r
}

# praevideo wrapper for the rejection rows: renders the typed error's causa
# on failure, "ok" otherwise.
functio model_text(
    dense.ConfiguraDensa cfg,
    (textus, numerus) → dense.Repertum fons,
    lista<numerus> tokens,
    f32 epsilon, f32 scale,
    lista<numerus> positions, numerus rope_dim, attention.RopeConfigura rope_cfg
) → textus {
    fac {
        fixum tensor.Tensor _ ← dense.praevideo(cfg, fons, tokens, epsilon, scale, positions, rope_dim, rope_cfg)
        redde "ok"
    }
    cape err {
        redde dense.causa(err)
    }
}

# First occurrence of `quid` in `ubi` at or after `ab`, or -1 when absent.
functio _inveni(textus ubi, textus quid, numerus ab) → numerus {
    fixum numerus n ← ubi.longitudo()
    fixum numerus m ← quid.longitudo()
    si m ≡ 0 aut m > n ergo redde -1
    varia numerus i ← ab
    dum i + m ≤ n {
        si ubi.sectio(i, i + m) ≡ quid ergo redde i
        i ← i + 1
    }
    redde -1
}

# Canonical layer suffix after "model.layers.{N}." ("" when not a layer
# name).
functio _suffixum(textus nomen) → textus {
    fixum numerus p ← _inveni(nomen, ".", 13)
    si p < 0 {
        redde ""
    }
    redde nomen.sectio(p, nomen.longitudo())
}

# Canonical layer suffix → slot index in the per-layer tensor list
# [ln1, wq, wk, wv, wo, ln2, wg, wu, wd]; -1 when unknown.
functio _suffixa(textus suffix) → numerus {
    si suffix ≡ ".input_layernorm" ergo redde 0
    si suffix ≡ ".self_attn.q_proj" ergo redde 1
    si suffix ≡ ".self_attn.k_proj" ergo redde 2
    si suffix ≡ ".self_attn.v_proj" ergo redde 3
    si suffix ≡ ".self_attn.o_proj" ergo redde 4
    si suffix ≡ ".post_attention_layernorm" ergo redde 5
    si suffix ≡ ".mlp.gate_proj" ergo redde 6
    si suffix ≡ ".mlp.up_proj" ergo redde 7
    si suffix ≡ ".mlp.down_proj" ergo redde 8
    redde -1
}

# The synthetic resolver: canonical name + layer index → the materialized
# stored-weight view. lm_head always answers with the untied head; the
# assembly only resolves it for the untied row (the tied row reuses the
# embedding directly). `deficiens` makes every layer request fail closed
# (the rejection row).
functio _repertor(
    textus nomen,
    numerus stratum,
    tensor.Tensor embed,
    tensor.Tensor norm_s,
    tensor.Tensor w_head,
    lista<tensor.Tensor> l0,
    lista<tensor.Tensor> l1,
    bivalens deficiens
) → dense.Repertum {
    si nomen ≡ "model.embed_tokens" {
        redde dense.Repertum { successus = verum, tensorem = embed, causa = "" }
    }
    si nomen ≡ "model.norm" {
        redde dense.Repertum { successus = verum, tensorem = norm_s, causa = "" }
    }
    si nomen ≡ "lm_head" {
        redde dense.Repertum { successus = verum, tensorem = w_head, causa = "" }
    }
    si deficiens {
        redde dense.Repertum { successus = falsum, tensorem = embed, causa = "canonical tensor missing: " + nomen }
    }
    fixum textus suffix ← _suffixum(nomen)
    fixum numerus slot ← _suffixa(suffix)
    si slot < 0 {
        redde dense.Repertum { successus = falsum, tensorem = embed, causa = "unknown canonical tensor: " + nomen }
    }
    varia lista<tensor.Tensor> strata_c ← l0
    si stratum ≡ 1 {
        strata_c ← l1
    }
    fixum tensor.Tensor t ← strata_c.accipe(slot) vel embed
    redde dense.Repertum { successus = verum, tensorem = t, causa = "" }
}

# |a − b| ≤ TOLERATIO — the documented absolute tolerance compare (the
# dense-swiglu precedent; no direct f32→textus cast exists in the FMIR
# image).
functio prox(f32 a, f32 b) → bivalens {
    fixum f32 d ← a - b
    si d < 0.0 {
        redde (0.0 - d) ≤ TOLERATIO
    }
    redde d ≤ TOLERATIO
}

# One pinned element: name + observed vs the f64 reference within
# TOLERATIO. Prints "PASS" or "FAIL" (the run's executed oracle rows).
functio _pin(textus name, f32 observata, f32 expectata) → textus {
    si prox(observata, expectata) {
        redde name + ": PASS"
    }
    redde name + ": FAIL observed=" + ((observata * 1000000.0) ↦ numerus ↦ textus) + " expected=" + ((expectata * 1000000.0) ↦ numerus ↦ textus)
}

# One text row: name + observed vs the expected text.
functio _case(textus name, textus observata, textus expectata) → textus {
    si observata ≡ expectata {
        redde name + ": PASS"
    }
    redde name + ": FAIL expected=" + expectata + " observed=" + observata
}

