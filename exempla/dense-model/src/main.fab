        0.0400000000, 0.0450000000, 0.0500000000, 0.0550000000, 0.0600000000, 0.0650000000, 0.0050000000, 0.0100000000,
        0.0100000000, 0.0200000000, 0.0300000000, 0.0400000000, 0.0500000000, 0.0600000000, 0.0050000000, 0.0150000000,
        0.0450000000, 0.0600000000, 0.0100000000, 0.0250000000, 0.0400000000, 0.0550000000, 0.0050000000, 0.0200000000
    ], [16, 8])
    fixum tensor.Tensor NORM_S ← tene([
        0.9000000000, 0.9500000000, 1.0000000000, 1.0500000000, 1.1000000000, 1.1500000000, 1.2000000000, 1.2500000000,
        1.3000000000, 1.3500000000, 1.4000000000, 1.4500000000, 1.5000000000, 1.5500000000, 1.6000000000, 1.6500000000
    ], [16])
    fixum tensor.Tensor W_HEAD ← tene([
        0.0166666667, 0.0208333333, 0.0250000000, 0.0291666667, 0.0333333333, 0.0375000000, 0.0416666667, 0.0458333333,
        0.0291666667, 0.0375000000, 0.0458333333, 0.0541666667, 0.0083333333, 0.0166666667, 0.0250000000, 0.0333333333,
        0.0416666667, 0.0541666667, 0.0125000000, 0.0250000000, 0.0375000000, 0.0500000000, 0.0083333333, 0.0208333333,
        0.0541666667, 0.0166666667, 0.0333333333, 0.0500000000, 0.0125000000, 0.0291666667, 0.0458333333, 0.0083333333,
        0.0125000000, 0.0333333333, 0.0541666667, 0.0208333333, 0.0416666667, 0.0083333333, 0.0291666667, 0.0500000000,
        0.0250000000, 0.0500000000, 0.0208333333, 0.0458333333, 0.0166666667, 0.0416666667, 0.0125000000, 0.0375000000,
        0.0375000000, 0.0125000000, 0.0416666667, 0.0166666667, 0.0458333333, 0.0208333333, 0.0500000000, 0.0250000000,
        0.0500000000, 0.0291666667, 0.0083333333, 0.0416666667, 0.0208333333, 0.0541666667, 0.0333333333, 0.0125000000,
        0.0083333333, 0.0458333333, 0.0291666667, 0.0125000000, 0.0500000000, 0.0333333333, 0.0166666667, 0.0541666667,
        0.0208333333, 0.0083333333, 0.0500000000, 0.0375000000, 0.0250000000, 0.0125000000, 0.0541666667, 0.0416666667,
        0.0333333333, 0.0250000000, 0.0166666667, 0.0083333333, 0.0541666667, 0.0458333333, 0.0375000000, 0.0291666667,
        0.0458333333, 0.0416666667, 0.0375000000, 0.0333333333, 0.0291666667, 0.0250000000, 0.0208333333, 0.0166666667,
        0.0041666667, 0.0041666667, 0.0041666667, 0.0041666667, 0.0041666667, 0.0041666667, 0.0041666667, 0.0041666667,
        0.0166666667, 0.0208333333, 0.0250000000, 0.0291666667, 0.0333333333, 0.0375000000, 0.0416666667, 0.0458333333,
        0.0291666667, 0.0375000000, 0.0458333333, 0.0541666667, 0.0083333333, 0.0166666667, 0.0250000000, 0.0333333333,
        0.0416666667, 0.0541666667, 0.0125000000, 0.0250000000, 0.0375000000, 0.0500000000, 0.0083333333, 0.0208333333
    ], [16, 8])

    fixum attention.RopeConfigura rq ← config_p((100000.0 ∷ f32), (1.0 ∷ f32), attention.politica_consecutiva())

    # Per-layer canonical weight lists (slot order: ln1, wq, wk, wv, wo, ln2, wg, wu, wd).
    fixum lista<tensor.Tensor> l0 ← [L0_LN1, L0_WQ, L0_WK, L0_WV, L0_WO, L0_LN2, L0_WG, L0_WU, L0_WD]
    fixum lista<tensor.Tensor> l1 ← [L1_LN1, L1_WQ, L1_WK, L1_WV, L1_WO, L1_LN2, L1_WG, L1_WU, L1_WD]
    fixum lista<numerus> tokens ← [0, 7]
    fixum lista<numerus> positions ← [0, 1]

    # ---- tied row: lm_head shares the embedding (ligatum = verum)
    fixum dense.ConfiguraDensa cfg_t ← dense.ConfiguraDensa { strata = 2, capita = 4, capita_kv = 2, dimensio_capitis = 4, dimensio_occulta = 16, vocabulum = 8, ligatum = verum }
    fixum tensor.Tensor out_t ← model_p(cfg_t, (textus n, numerus s) → dense.Repertum ∴ _repertor(n, s, EMBED, NORM_S, W_HEAD, l0, l1, falsum), tokens, (0.00001 ∷ f32), (0.5 ∷ f32), positions, 4, rq)
    si out_t.figura() ≡ [2, 8] {
        nota "tied-shape: PASS"
    }
    secus {
        nota "tied-shape: FAIL"
    }
    si dtype.nomen(out_t.typus()) ≡ "f32" {
        nota "tied-dtype: PASS"
    }
    secus {
        nota "tied-dtype: FAIL"
    }
    nota _pin("tied_0_0", e2(out_t, 0, 0), 0.6690896300)
    nota _pin("tied_0_1", e2(out_t, 0, 1), 0.7143166604)
    nota _pin("tied_0_2", e2(out_t, 0, 2), 0.6702538950)
    nota _pin("tied_0_3", e2(out_t, 0, 3), 0.7173161384)
    nota _pin("tied_0_4", e2(out_t, 0, 4), 0.7642586485)
    nota _pin("tied_0_5", e2(out_t, 0, 5), 0.7961620646)
    nota _pin("tied_0_6", e2(out_t, 0, 6), 0.1000587951)
    nota _pin("tied_0_7", e2(out_t, 0, 7), 0.6161659671)
    nota _pin("tied_1_0", e2(out_t, 1, 0), 0.6690867838)
    nota _pin("tied_1_1", e2(out_t, 1, 1), 0.7143150306)
    nota _pin("tied_1_2", e2(out_t, 1, 2), 0.6702567305)
    nota _pin("tied_1_3", e2(out_t, 1, 3), 0.7173168407)
    nota _pin("tied_1_4", e2(out_t, 1, 4), 0.7642574241)
    nota _pin("tied_1_5", e2(out_t, 1, 5), 0.7961602890)
    nota _pin("tied_1_6", e2(out_t, 1, 6), 0.1000588705)
    nota _pin("tied_1_7", e2(out_t, 1, 7), 0.6161691097)

    # ---- untied row: lm_head is its own canonical tensor (ligatum = falsum)
    fixum dense.ConfiguraDensa cfg_u ← dense.ConfiguraDensa { strata = 2, capita = 4, capita_kv = 2, dimensio_capitis = 4, dimensio_occulta = 16, vocabulum = 8, ligatum = falsum }
    fixum tensor.Tensor out_u ← model_p(cfg_u, (textus n, numerus s) → dense.Repertum ∴ _repertor(n, s, EMBED, NORM_S, W_HEAD, l0, l1, falsum), tokens, (0.00001 ∷ f32), (0.5 ∷ f32), positions, 4, rq)
    si out_u.figura() ≡ [2, 8] {
        nota "untied-shape: PASS"
    }
    secus {
        nota "untied-shape: FAIL"
    }
    si dtype.nomen(out_u.typus()) ≡ "f32" {
        nota "untied-dtype: PASS"
    }
    secus {
        nota "untied-dtype: FAIL"
    }
    nota _pin("untied_0_0", e2(out_u, 0, 0), 0.5791765777)
    nota _pin("untied_0_1", e2(out_u, 0, 1), 0.6183951138)
    nota _pin("untied_0_2", e2(out_u, 0, 2), 0.5816761427)
    nota _pin("untied_0_3", e2(out_u, 0, 3), 0.6193653347)
    nota _pin("untied_0_4", e2(out_u, 0, 4), 0.5575746916)
    nota _pin("untied_0_5", e2(out_u, 0, 5), 0.5952638837)
    nota _pin("untied_0_6", e2(out_u, 0, 6), 0.5585449125)
    nota _pin("untied_0_7", e2(out_u, 0, 7), 0.5977634487)
    nota _pin("untied_1_0", e2(out_u, 1, 0), 0.5791771317)
    nota _pin("untied_1_1", e2(out_u, 1, 1), 0.6183938902)
    nota _pin("untied_1_2", e2(out_u, 1, 2), 0.5816786401)
    nota _pin("untied_1_3", e2(out_u, 1, 3), 0.6193688458)
    nota _pin("untied_1_4", e2(out_u, 1, 4), 0.5575723198)
    nota _pin("untied_1_5", e2(out_u, 1, 5), 0.5952625255)
    nota _pin("untied_1_6", e2(out_u, 1, 6), 0.5585472754)
    nota _pin("untied_1_7", e2(out_u, 1, 7), 0.5977640339)

    # ---- fail-closed rejection: a resolver that fails on layer tensors
    nota _case("reject-missing", model_text(cfg_t, (textus n, numerus s) → dense.Repertum ∴ _repertor(n, s, EMBED, NORM_S, W_HEAD, l0, l1, verum), tokens, (0.00001 ∷ f32), (0.5 ∷ f32), positions, 4, rq), "canonical tensor missing: model.layers.0.input_layernorm")
}
