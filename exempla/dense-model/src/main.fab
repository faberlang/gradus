    const tensor.Tensor out_t ← model_p(cfg_t, (string n, int s) → dense.Repertum ∴ _repertor(n, s, EMBED, NORM_S, W_HEAD, l0, l1, false), tokens, 0.00001 ∷ f32, 0.5 ∷ f32, positions, 4, rq)
