# dense-model — the REF-01-U1.8 executed proof: the complete ordered dense
# forward graph in gradus:model/dense — embedding gather → 2 ordered U1.5
# blocks → final RMSNorm → output projection, assembled from the typed
# architecture config and materialized stored-weight views via canonical
# names, for a small synthetic dense config (T=2, D=16, F=16, H=4, K=2,
# head_dim=4, vocab 8), with TIED and UNTIED embedding rows.
#
# The pinned values are the independent f64 evaluation of the documented
# formulas (external Python/numpy, the PML3 transformer_block pin
# precedent — the block transcription is validated against the pinned
# dense-block values in src/transformer.proba first) with residual-2
# r1 + h (not ln2 + h), compared within the documented 5e-4 absolute
# tolerance. The same config and reference values live at compile level
# in src/model/dense.proba.
#
# Execution: faber run --target fmir exempla/dense-model. Prints PASS for
# every pinned value (0 FAIL, exit 0), plus the fail-closed rejection rows.
# No device handle, no performance claim; forward-only, no autograd import.
import from "gradus:model/dense" dense

import from "gradus:attention/rope" rope

import from "gradus:tensor" tensor

import from "gradus:dtype" dtype

# Absolute tolerance for f32-vs-f64 comparison (the proba posture).
const f32 TOLERATIO ← 0.0005

# Build a staged tensor (test data is always valid; the cape fallback is
# unreachable).
fn make_block(list<f32> data, list<int> shape) → tensor.NumericBlock {
    var tensor.NumericBlock t ← tensor.default()
    do {
        t ← tensor.construct(data, shape)
    }
    catch err {
        return t
    }
    return t
}

# Pack a math-order [D, V] row-major table into the GGUF/ggml stored
# layout the assembly gathers from (descriptor still [D, V], flat buffer
# token-major: data[token * D + d]).
fn pack_embedding(tensor.NumericBlock row_major) → tensor.NumericBlock {
    const _ f ← row_major.shape
    const int hidden ← f.get(0) coalesce 1
    const int vocab ← f.get(1) coalesce 1
    var list<f32> out ← empty
    for range 0‥vocab const tok {
        for range 0‥hidden const j {
            out.append(row_major.data.get(j * vocab + tok) coalesce 0.0)
        }
    }
    return make_block(out, [hidden, vocab])
}

# Staged-result element read (swallow the never-firing access errors).
fn element(tensor.NumericBlock r, int i, int j) → f32 {
    do {
        return r.get([i, j])
    }
    catch err {
        return 0.0
    }
}

# Validated RopeConfig (swallow the never-firing construction errors).
fn rope_config(f32 base, f32 scale, rope.RopePolicy policy) → rope.RopeConfig {
    var rope.RopeConfig c ← rope.default()
    do {
        c ← rope.construct_rope_config(base, scale, policy)
        return c
    }
    catch err {
        return c
    }
    return c
}

# preview wrapper for the pin rows: returns the logits tensor (a failure
# would surface as an invalid tensor and fail every pin).
fn run_model(dense.DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, list<int> tokens, f32 epsilon, f32 scale, list<int> positions, int rope_dim, rope.RopeConfig rope_cfg) → tensor.NumericBlock {
    var tensor.NumericBlock r ← tensor.default()
    do {
        r ← dense.forward(cfg, source, tokens, epsilon, scale, positions, rope_dim, rope_cfg)
        return r
    }
    catch err {
        return r
    }
    return r
}

# preview wrapper for the rejection rows: renders the typed error's message
# on failure, "ok" otherwise.
fn model_result(dense.DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, list<int> tokens, f32 epsilon, f32 scale, list<int> positions, int rope_dim, rope.RopeConfig rope_cfg) → string {
    do {
        dense.forward(cfg, source, tokens, epsilon, scale, positions, rope_dim, rope_cfg)
        return "ok"
    }
    catch err {
        return err.message
    }
}

# First occurrence of `quid` in `ubi` at or after `ab`, or -1 when absent.
fn find_substring(string ubi, string quid, int ab) → int {
    const int n ← ubi.length()
    const int m ← quid.length()
    if m ≡ 0 or m ≻ n then return -1
    for range ab‥(n - m + 1) const i {
        if ubi.slice(i, i + m) ≡ quid then return i
    }
    return -1
}

# Canonical layer suffix after "model.layers.{N}." ("" when not a layer
# name).
fn layer_suffix(string name) → string {
    const _ p ← find_substring(name, ".", 13)
    if p ≺ 0 then return ""
    return name.slice(p, name.length())
}

# Canonical layer suffix → slot index in the per-layer tensor list
# [ln1, wq, wk, wv, wo, ln2, wg, wu, wd]; -1 when unknown.
fn layer_slot(string suffix) → int {
    switch suffix {
        case ".input_layernorm" {
            return 0
        }
        case ".self_attn.q_proj" {
            return 1
        }
        case ".self_attn.k_proj" {
            return 2
        }
        case ".self_attn.v_proj" {
            return 3
        }
        case ".self_attn.o_proj" {
            return 4
        }
        case ".post_attention_layernorm" {
            return 5
        }
        case ".mlp.gate_proj" {
            return 6
        }
        case ".mlp.up_proj" {
            return 7
        }
        case ".mlp.down_proj" {
            return 8
        }
        default {
            return -1
        }
    }
}

# The synthetic resolver: canonical name + layer index → the materialized
# stored-weight view. lm_head always answers with the untied head; the
# assembly only resolves it for the untied row (the tied row reuses the
# embedding directly). `missing_layer` makes every layer request fail closed
# (the rejection row).
fn resolve_tensor(string name, int layer, tensor.NumericBlock embed, tensor.NumericBlock norm_s, tensor.NumericBlock w_head, list<tensor.NumericBlock> l0, list<tensor.NumericBlock> l1, bool missing_layer) → tensor.NumericBlock ⇥ dense.DenseError {
    if name ≡ "model.embed_tokens" then return embed
    if name ≡ "model.norm" then return norm_s
    if name ≡ "lm_head" then return w_head
    if missing_layer then throw variant MissingTensor {message = "canonical tensor missing: §"(name)}
    const _ suffix ← layer_suffix(name)
    const _ slot ← layer_slot(suffix)
    if slot ≺ 0 then throw variant MissingTensor {message = "unknown canonical tensor: §"(name)}
    var list<tensor.NumericBlock> layers ← l0
    if layer ≡ 1 {
        layers ← l1
    }
    const _ t ← layers.get(slot) coalesce embed
    return t
}

# |a − b| ≤ TOLERATIO — the documented absolute tolerance compare (the
# dense-swiglu precedent; no direct f32→text cast exists in the FMIR
# image).
fn within_tolerance(f32 a, f32 b) → bool {
    const _ d ← a - b
    if d ≺ 0.0 then return -d ≤ TOLERATIO
    return d ≤ TOLERATIO
}

# One pinned element: name + observed vs the f64 reference within
# TOLERATIO. Prints "PASS" or "FAIL" (the run's executed oracle rows).
fn pin_result(string name, f32 observed, f32 expected) → string {
    if within_tolerance(observed, expected) then return "§: PASS"(name)
    return "§{name}: FAIL observed=§{observed} expected=§{expected}"(name: name, observed: (observed * 1000000.0 ↦ int) ↦ string, expected: (expected * 1000000.0 ↦ int) ↦ string)
}

# One text row: name + observed vs the expected text.
fn case_result(string name, string observed, string expected) → string {
    if observed ≡ expected then return "§: PASS"(name)
    return "§{name}: FAIL expected=§{expected} observed=§{observed}"(name: name, expected: expected, observed: observed)
}

