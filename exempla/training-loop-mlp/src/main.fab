# 4×4 MLP training-loop exemplar.
#
# Public entry: the `training-loop-mlp` executable package.
# Depends on: gradus:mlp, gradus:gradient, gradus:optimize,
# gradus:checkpoint, gradus:random, gradus:metrics, gradus:parameter, gradus:tensor.
#
# WHY: the workload keeps the differentiable tensor update, optimizer-state
# update, per-step metric, and checkpoint round-trip visible in one driver.
# Fixed data and a constant schedule make the convergence trace reproducible;
# the builder adapters keep the executable boundary non-failable for that proof.

import from "gradus:mlp" mlp
import from "gradus:gradient" gradient
import from "gradus:optimize" optimize
import from "gradus:schedule" schedule
import from "gradus:checkpoint" checkpoint
import from "gradus:random" random
import from "gradus:metrics" metrics
import from "gradus:parameter" parameter
import from "gradus:tensor" tensor

# --- builder adapters -------------

fn stage_tensor(list<f32> data, list<int> shape) → tensor.NumericBlock {
    mut tensor.NumericBlock t ← tensor.default()
    do {
        t ← tensor.construct(data, shape)
    }
    catch err {
        return t
    }
    return t
}

fn build_parameter(string name, list<f32> data) → parameter.Parameter {
    mut parameter.Parameter p ← parameter.default()
    do {
        p ← parameter.construct(name, "model.mlp", "f32", [4, 4], data)
    }
    catch err {
        return p
    }
    return p
}

# The schedule rate is copied into each optimizer-state slot at its current
# parameter generation.
fn build_state(string name, int version, f32 rate) → optimize.SgdState {
    mut optimize.SgdState s ← optimize.default()
    do {
        s ← optimize.construct(name, "model.mlp", version, rate)
    }
    catch err {
        return s
    }
    return s
}

fn build_gradient(string name, int version, tensor.NumericBlock value) → gradient.Gradient {
    mut gradient.Gradient g ← gradient.default()
    do {
        g ← gradient.construct(name, "model.mlp", version, value)
    }
    catch err {
        return g
    }
    return g
}

fn optimizer_step(optimize.SgdState s, parameter.Parameter p, gradient.Gradient g) → optimize.StepResult {
    mut optimize.StepResult r ← optimize.default_step()
    do {
        r ← optimize.step(s, p, g)
    }
    catch err {
        return r
    }
    return r
}

# Vertex and end are equal, so every step receives the pinned learning rate.
fn build_schedule() → schedule.Schedule {
    mut schedule.Schedule s ← schedule.default_schedule()
    do {
        s ← schedule.construct_schedule(0.1, 0, 1, 0.1)
    }
    catch err {
        return s
    }
    return s
}

fn build_seed(int seed) → random.Seed {
    mut random.Seed s ← random.default()
    do {
        s ← random.construct_seed(seed)
    }
    catch err {
        return s
    }
    return s
}

fn scheduled_rate(schedule.Schedule s, int step) → f32 {
    mut f32 v ← 0.0
    do {
        v ← schedule.scheduled_rate(s, step)
    }
    catch err {
        return v
    }
    return v
}

fn build_checkpoint(int age, int step, random.Seed rng, string state_wire) → checkpoint.Checkpoint {
    mut checkpoint.Checkpoint t ← checkpoint.default_checkpoint()
    do {
        t ← checkpoint.construct_checkpoint(age, step, rng, state_wire)
    }
    catch err {
        return t
    }
    return t
}

fn restore_checkpoint(string wire) → checkpoint.Checkpoint {
    mut checkpoint.Checkpoint t ← checkpoint.default_checkpoint()
    do {
        t ← checkpoint.deserialize_checkpoint(wire)
    }
    catch err {
        return t
    }
    return t
}

fn build_sgd(optimize.SgdState a, optimize.SgdState b, optimize.SgdState c, optimize.SgdState d) → optimize.Sgd {
    mut optimize.Sgd o ← optimize.default_sgd()
    do {
        let _ o1 ← optimize.add(optimize.empty_sgd(), a)
        let _ o2 ← optimize.add(o1, b)
        let _ o3 ← optimize.add(o2, c)
        o ← optimize.add(o3, d)
    }
    catch err {
        return o
    }
    return o
}

fn build_metric(f32 loss, f32 accuracy) → metrics.Metric {
    mut metrics.Metric m ← metrics.default()
    do {
        m ← metrics.metric(loss, accuracy)
    }
    catch err {
        return m
    }
    return m
}

# Accuracy is the fraction of the 16 regression outputs within 0.1 of target.
# Reads the SAME typed tensor the shared forward `mlp.forward_mlp` produces —
# the one definition the training path (`forward_mlp_loss`) composes.
fn match_rate(tensor<f32, [4, 4]> output, tensor<f32, [4, 4]> target) → f32 {
    let list<f32> predictions ← output ↦ list<f32>
    let list<f32> targets ← target ↦ list<f32>
    mut int matches ← 0
    for from predictions and targets let predicted and expected {
        mut f32 difference ← predicted - expected
        if difference ≺ 0.0 {
            difference ← -difference
        }
        if difference ≤ 0.1 {
            matches ← matches + 1
        }
    }
    return (matches ↦ f32) / (predictions.length() ↦ f32)
}

# --- pinned workload --------------

main {
    # Fixed input and target; trainable tensors come from the seeded initializer.
    let list<f32> data_input ← [0.5, -0.3, 1.2, -0.7,
                                   -0.4, 0.8, -1.0, 0.3,
                                   0.7, -0.2, -0.6, 1.0,
                                   -0.9, 1.3, 0.1, -0.5]
    let tensor<f32, [4, 4]> input ← data_input ↦ tensor<f32, [4, 4]>
    let random.Seed seed ← build_seed(1)
    let random.Initialized initial ← random.initialize_fan_uniform(
        [[4, 4], [4, 4], [4, 4], [4, 4]], [false, true, false, true], seed)
    let list<f32> data_weight1 ← initial.tensors[0].data
    let list<f32> data_bias1 ← initial.tensors[1].data
    let list<f32> data_weight2 ← initial.tensors[2].data
    let list<f32> data_bias2 ← initial.tensors[3].data
    mut tensor<f32, [4, 4]> w1 ← data_weight1 ↦ tensor<f32, [4, 4]>
    mut tensor<f32, [4, 4]> b1 ← data_bias1 ↦ tensor<f32, [4, 4]>
    mut tensor<f32, [4, 4]> w2 ← data_weight2 ↦ tensor<f32, [4, 4]>
    mut tensor<f32, [4, 4]> b2 ← data_bias2 ↦ tensor<f32, [4, 4]>
    let list<f32> target_data ← [(1.0 ↦ f32), (1.0 ↦ f32), (1.0 ↦ f32), (1.0 ↦ f32),
                                (1.0 ↦ f32), (1.0 ↦ f32), (1.0 ↦ f32), (1.0 ↦ f32),
                                (1.0 ↦ f32), (1.0 ↦ f32), (1.0 ↦ f32), (1.0 ↦ f32),
                                (1.0 ↦ f32), (1.0 ↦ f32), (1.0 ↦ f32), (1.0 ↦ f32)]
    let tensor<f32, [4, 4]> target ← target_data ↦ tensor<f32, [4, 4]>

    # Parameter versions advance with optimizer.step while tensor values move
    # through optimize.sgd_step, so both paths remain observable.
    mut parameter.Parameter p_w1 ← build_parameter("w1", data_weight1)
    mut parameter.Parameter p_b1 ← build_parameter("b1", data_bias1)
    mut parameter.Parameter p_w2 ← build_parameter("w2", data_weight2)
    mut parameter.Parameter p_b2 ← build_parameter("b2", data_bias2)

    let schedule.Schedule lr_schedule ← build_schedule()
    let f32 upstream ← 1.0
    let int steps ← 100
    mut list<f32> loss_trace ← empty
    mut bool agree ← true

    mut optimize.StepResult r_w1 ← optimize.default_step()
    mut optimize.StepResult r_b1 ← optimize.default_step()
    mut optimize.StepResult r_w2 ← optimize.default_step()
    mut optimize.StepResult r_b2 ← optimize.default_step()

    # --- training steps --------------

    for range 0‥steps let step {
        let f32 loss ← mlp.forward_mlp_loss(input, w1, b1, w2, b2, target)
        loss_trace.append(loss)

        # Agreement proof: recompute the loss from the shared typed forward over
        # the same inputs. Same op tree, same stepper → bit-equal.
        let tensor<f32, [4, 4]> out ← mlp.forward_mlp(input, w1, b1, w2, b2)
        let f32 check ← ((out - target) ⊙ (out - target)).mean()
        if check ≢ loss {
            agree ← false
        }

        let f32 lr_k ← scheduled_rate(lr_schedule, step)
        let optimize.SgdState s_w1 ← build_state("w1", p_w1.version(), lr_k)
        let optimize.SgdState s_b1 ← build_state("b1", p_b1.version(), lr_k)
        let optimize.SgdState s_w2 ← build_state("w2", p_w2.version(), lr_k)
        let optimize.SgdState s_b2 ← build_state("b2", p_b2.version(), lr_k)

        let _ grads ← mlp.forward_mlp_loss_backward(input, w1, b1, w2, b2,
                                                         target, mlp.nil(), upstream)
        let [_, gw1, gb1, gw2, gb2, _] ← grads

        let list<tensor<f32, [4, 4]>> updated ← optimize.sgd_step(
            [w1, b1, w2, b2], [gw1, gb1, gw2, gb2], lr_k)
        w1 ← updated[0]
        b1 ← updated[1]
        w2 ← updated[2]
        b2 ← updated[3]

        let gradient.Gradient g_w1 ← build_gradient("w1", p_w1.version(), stage_tensor(gw1 ↦ list<f32>, [4, 4]))
        let gradient.Gradient g_b1 ← build_gradient("b1", p_b1.version(), stage_tensor(gb1 ↦ list<f32>, [4, 4]))
        let gradient.Gradient g_w2 ← build_gradient("w2", p_w2.version(), stage_tensor(gw2 ↦ list<f32>, [4, 4]))
        let gradient.Gradient g_b2 ← build_gradient("b2", p_b2.version(), stage_tensor(gb2 ↦ list<f32>, [4, 4]))

        r_w1 ← optimizer_step(s_w1, p_w1, g_w1)
        r_b1 ← optimizer_step(s_b1, p_b1, g_b1)
        r_w2 ← optimizer_step(s_w2, p_w2, g_w2)
        r_b2 ← optimizer_step(s_b2, p_b2, g_b2)
        p_w1 ← r_w1.fresh
        p_b1 ← r_b1.fresh
        p_w2 ← r_w2.fresh
        p_b2 ← r_b2.fresh

        let tensor<f32, [4, 4]> output ← mlp.forward_mlp(input, w1, b1, w2, b2)
        let metrics.Metric metric ← build_metric(loss, match_rate(output, target))
        print metric.loss
    }

    print agree

    # --- checkpoint round-trip --------

    let optimize.Sgd sgd ← build_sgd(r_w1.state, r_b1.state, r_w2.state, r_b2.state)
    let checkpoint.Checkpoint saved_checkpoint ← build_checkpoint(0, steps, seed, optimize.serialize(sgd))
    let string wire ← checkpoint.serialize_checkpoint(saved_checkpoint)
    let checkpoint.Checkpoint restored ← restore_checkpoint(wire)

    print checkpoint.checkpoint_equal(saved_checkpoint, restored)
    print loss_trace
}
