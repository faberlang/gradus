                                          0.6716330855523976, 0.7165027931376746, 0.6708015447439325, 0.7207290796616693, 0.7667732413494355, 0.7985804460522846, 0.10081189726978157, 0.6184397515688835,
                                          0.6716216571532039, 0.7164951200302994, 0.6707980685133372, 0.7207320401419401, 0.7667682372514002, 0.7985878288095927, 0.10081209244613032, 0.6184284131111077,
                                          0.6716192987515055, 0.7164910308514142, 0.6708124285222289, 0.7207377672699122, 0.7667746729573529, 0.7985943006454957, 0.10081156800982548, 0.6184160917255546,
                                          0.6716338308322977, 0.7165107352338906, 0.6708171229073276, 0.7207061852951362, 0.7667787457701345, 0.7985692240736788, 0.10081143357571583, 0.6184403041163409,
                                          0.6716341725147639, 0.7165114388275066, 0.6708237083179073, 0.7207039558495092, 0.7667814912047036, 0.7985713438904578, 0.10081123216668943, 0.6184345565503772,
                                          0.6716290133308376, 0.716493322331901, 0.670829264378632, 0.7207392907985957, 0.7667834566949714, 0.798595057608632, 0.10081098699199934, 0.6184106060098238,
                                          0.6716297516801205, 0.7164963294295952, 0.6708182968834583, 0.7207363611509838, 0.7667791195244144, 0.7985897567906284, 0.10081135086329647, 0.618421819550195,
                                          0.6716229867979433, 0.7164985188073391, 0.6708045245731127, 0.7207259529671017, 0.7667716555755484, 0.7985842940415611, 0.10081184389448444, 0.6184296869042158,
                                          0.6716155800177991, 0.7164880513849827, 0.6708152116686406, 0.720739563600227, 0.7667748841627577, 0.7985987516800369, 0.10081148542203702, 0.6184086510407509,
                                          0.6716270598936809, 0.7165010285898088, 0.6708209388161057, 0.7207213860247335, 0.7667795000568177, 0.7985814448750901, 0.10081126769498883, 0.6184261913373895,
                                          0.6716336423182999, 0.7165121198756593, 0.6708231565186108, 0.7207014198986766, 0.7667809919115323, 0.798569560838414, 0.10081124816559177, 0.6184359608126367,
                                          0.6716253762740602, 0.7164950332847319, 0.6708312462131418, 0.7207316634934264, 0.7667839508401373, 0.798592961339896, 0.10081090572157624, 0.6184098452546511]

# --- the device route ---------------------------------------------------------

# The device regions: every dense projection of the model is a matmul kernel,
# here over a single row. The tiny model carries no projection bias, so none is
# added. Each kernel is one launch.
@ kernel
@ public
fn proj_16(tensor<f32, [1, 16]> x, tensor<f32, [16, 16]> w) → tensor<f32, [1, 16]> {
    return x · w
}

@ kernel
@ public
fn proj_8(tensor<f32, [1, 16]> x, tensor<f32, [16, 8]> w) → tensor<f32, [1, 8]> {
    return x · w
}

# The MLP down projection fused with the second residual.
@ kernel
@ public
fn down_residual(tensor<f32, [1, 16]> hidden, tensor<f32, [16, 16]> w, tensor<f32, [1, 16]> residual) → tensor<f32, [1, 16]> {
    return (hidden · w) + residual
}

# The tied output projection: logits = hidden · head.
@ kernel
@ public
fn project(tensor<f32, [1, 16]> hidden, tensor<f32, [16, 8]> head) → tensor<f32, [1, 8]> {
    return hidden · head
}

# The model on typed tensors (device operands) and staged blocks (host
# operands). `dense.load` builds the weights from a resolver, but its
# size-generic instantiation does not link under the current compiler
# ("runtime generic shape has no stable formal carrier witness"), so the staged
# weight blocks are pinned here, one concrete shape per helper.
class Layer {
    mut tensor.NumericBlock ln1
    mut tensor<f32, [16, 16]> wq
    mut tensor<f32, [16, 8]> wk
    mut tensor<f32, [16, 8]> wv
    mut tensor.NumericBlock wo
    mut tensor.NumericBlock ln2
    mut tensor<f32, [16, 16]> wg
    mut tensor<f32, [16, 16]> wu
    mut tensor<f32, [16, 16]> wd
}

class TinyModel {
    mut tensor<f32, [8, 16]> embed_tokens
    mut tensor.NumericBlock norm
    mut tensor<f32, [16, 8]> head
    mut list<Layer> layers
}

fn pin_16_16(tensor.NumericBlock b) → tensor<f32, [16, 16]> {
    do {
        return b.data ↦ tensor<f32, [16, 16]>
    }
    catch err {
        fail("weight [16, 16] pin failed")
    }
    return tf32[16, 16] {}
}

fn pin_16_8(tensor.NumericBlock b) → tensor<f32, [16, 8]> {
    do {
        return b.data ↦ tensor<f32, [16, 8]>
    }
    catch err {
        fail("weight [16, 8] pin failed")
    }
    return tf32[16, 8] {}
}

fn pin_8_16(list<f32> data) → tensor<f32, [8, 16]> {
    do {
        return data ↦ tensor<f32, [8, 16]>
    }
    catch err {
        fail("weight [8, 16] pin failed")
    }
    return tf32[8, 16] {}
}

# The stored embedding is token-major (data[token * 16 + d]); the tied head is
# its [16, 8] transpose.
fn head_from_embed(list<f32> token_major) → tensor<f32, [16, 8]> {
    mut list<f32> out ← empty
    for range 0‥16 let d {
        for range 0‥8 let v {
            out.append(token_major[v * 16 + d])
        }
    }
    return pin_16_8(make_block(out, [16, 8]))
}

# Slot order: ln1, wq, wk, wv, wo, ln2, wg, wu, wd.
fn build_layer(list<tensor.NumericBlock> w) → Layer {
    return Layer {ln1 = w[0], wq = pin_16_16(w[1]), wk = pin_16_8(w[2]), wv = pin_16_8(w[3]), wo = w[4], ln2 = w[5], wg = pin_16_16(w[6]), wu = pin_16_16(w[7]), wd = pin_16_16(w[8])}
}

fn build_model(tensor.NumericBlock embed, tensor.NumericBlock norm_s, list<tensor.NumericBlock> l0, list<tensor.NumericBlock> l1) → TinyModel {
    mut list<Layer> layers ← empty
    layers.append(build_layer(l0))
    layers.append(build_layer(l1))
    return TinyModel {embed_tokens = pin_8_16(embed.data), norm = norm_s, head = head_from_embed(embed.data), layers = layers}
}

# --- the host pieces ----------------------------------------------------------
#
# Not device-capable today, so they run on the staged carrier, as the library's
# own decode does:
#   * RMSNorm: `x.norm_rms(...)` has no Metal launch geometry
#     (E_DEVICE_UNSUPPORTED geometry_plan_not_covered RmsNormalization);
#   * SiLU in the SwiGLU gate: not an elementwise Metal op;
#   * the embedding gather and the per-head RoPE + causal attention + KV-cache
#     write: host carrier code in the library.

fn pin_1_16(list<f32> data) → tensor<f32, [1, 16]> {
    do {
        return data ↦ tensor<f32, [1, 16]>
    }
    catch err {
        fail("row [1, 16] pin failed")
    }
    return tf32[1, 16] {}
}

fn rms_host(tensor<f32, [1, 16]> x, tensor.NumericBlock gamma) → tensor<f32, [1, 16]> {
    do {
        let tensor.NumericBlock y ← nn.rmsnorm_carrier(tensor.stage_f32([1, 16], x ↦ list<f32>), gamma, EPSILON)
        return pin_1_16(y.data)
    }
    catch err {
        fail("host rmsnorm raised " + err.message)
    }
    return tf32[1, 16] {}
}

fn silu_host(tensor.NumericBlock x) → tensor.NumericBlock {
    do {
        return nn.silu_carrier(x)
    }
    catch err {
        fail("host silu raised " + err.message)
    }
    return x
}

fn gated_host(tensor.NumericBlock gate, tensor.NumericBlock up) → tensor<f32, [1, 16]> {
    do {
        let tensor.NumericBlock h ← math.mul_carrier(silu_host(gate), up)
        return pin_1_16(h.data)
    }
    catch err {
        fail("host gate product raised " + err.message)
    }
    return tf32[1, 16] {}
}

fn gather_row(tensor<f32, [8, 16]> table, int token) → tensor<f32, [1, 16]> {
    do {
        return nn.gather<size 1, size 8, size 16>(table, [token])
    }
    catch err {
        fail("gather raised " + err.message)
    }
    return tf32[1, 16] {}
}

class Stepped {
    mut tensor<f32, [1, 8]> logits
    mut list<kv.KVCache> caches
}

class Block {
    mut tensor<f32, [1, 16]> output
    mut kv.KVCache state
}

# Cached multi-head attention on the host carrier for one new row (per-head
# RoPE at the row's absolute position, causal mask over the cache, KV write,
# output projection).
fn attention(tensor<f32, [1, 16]> q, tensor<f32, [1, 8]> k, tensor<f32, [1, 8]> v, tensor.NumericBlock wo, kv.KVCache cache, int token, int position, rope.RopeConfig rope_cfg) → gqa.CachedAttention {
    do {
        return gqa.multi_head_attention_cached(tensor.stage_f32([1, 16], q ↦ list<f32>), tensor.stage_f32([1, 8], k ↦ list<f32>), tensor.stage_f32([1, 8], v ↦ list<f32>), wo, cache, 4, 2, ATTENTION_SCALE, [position], 4, rope_cfg, [token])
    }
    catch err {
        fail("cached attention raised " + err.message)
    }
    return gqa.CachedAttention {context = tensor.default(), state = cache}
}

# One dense block over one row: host RMSNorm, device Q/K/V projections, host
# attention, device residual add, host RMSNorm, device gate and up projections,
# host gated product, device down projection fused with the second residual.
fn cached_block(tensor<f32, [1, 16]> x, Layer layer, kv.KVCache cache, int token, int position, rope.RopeConfig rope_cfg) → Block {
    let tensor<f32, [1, 16]> ln1 ← rms_host(x, layer.ln1)
    let tensor<f32, [1, 16]> q ← proj_16(ln1, layer.wq)
    let tensor<f32, [1, 8]> k ← proj_8(ln1, layer.wk)
    let tensor<f32, [1, 8]> v ← proj_8(ln1, layer.wv)
    let gqa.CachedAttention step ← attention(q, k, v, layer.wo, cache, token, position, rope_cfg)
    let tensor<f32, [1, 16]> r1 ← math.add(x, pin_1_16(step.context.data))
    let tensor<f32, [1, 16]> ln2 ← rms_host(r1, layer.ln2)
    let tensor<f32, [1, 16]> gate ← proj_16(ln2, layer.wg)
    let tensor<f32, [1, 16]> up ← proj_16(ln2, layer.wu)
    let tensor<f32, [1, 16]> act ← gated_host(tensor.stage_f32([1, 16], gate ↦ list<f32>), tensor.stage_f32([1, 16], up ↦ list<f32>))
    return Block {output = down_residual(act, layer.wd, r1), state = step.state}
}

# One decode step: the token at `position` through both layers (writing one row
# into each cache), the final RMSNorm and the tied head.
fn decode_device(TinyModel model, int token, int position, list<kv.KVCache> caches, rope.RopeConfig rope_cfg) → Stepped {
    mut tensor<f32, [1, 16]> h ← gather_row(model.embed_tokens, token)
    mut list<kv.KVCache> next ← empty
    for range 0‥2 let layer {
        let Block b ← cached_block(h, model.layers[layer], caches[layer], token, position, rope_cfg)
        h ← b.output
        next.append(b.state)
    }
    let tensor<f32, [1, 16]> hn ← rms_host(h, model.norm)
    return Stepped {logits = project(hn, model.head), caches = next}
}

# --- the library host path (prefill and step-0 parity) ------------------------

fn prefill_library(dense.DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, list<int> tokens, list<kv.KVCache> caches, rope.RopeConfig rope_cfg) → dense.DenseStep {
    do {
        return dense.prefill_cached(cfg, source, tokens, EPSILON, ATTENTION_SCALE, 4, rope_cfg, caches)
    }
    catch err {
        fail("library prefill raised " + err.message)
    }
    return dense.default_step()
}

fn decode_library(dense.DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, int token, int position, list<kv.KVCache> caches, rope.RopeConfig rope_cfg) → list<f32> {
    do {
        let dense.DenseStep step ← dense.decode_step(cfg, source, token, position, EPSILON, ATTENTION_SCALE, 4, rope_cfg, caches)
        return step.logits.data
    }
    catch err {
        fail("library decode raised " + err.message)
    }
    return empty
}

# --- checks -------------------------------------------------------------------

fn abs_diff(f64 a, f64 b) → f64 {
    mut f64 d ← a - b
    if d ≺ 0.0 {
        d ← -d
    }
    return d
}

# Index of the largest value in row `row` of a flat list of 8-wide rows (the
# first one on a tie).
fn argmax_row(list<f32> flat, int row) → int {
    mut int best ← 0
    for range 0‥8 let j {
        if flat[row * 8 + j] ≻ flat[row * 8 + best] {
            best ← j
        }
    }
    return best
}

# Every layer's cache holds exactly `rows` rows.
fn check_cache_rows(list<kv.KVCache> caches, int rows, string where) {
    if caches.length() ≢ 2 {
        fail("cache layer count §"(caches.length()))
    }
    for from caches let cache {
        if cache.length() ≢ rows {
            fail("§: cache length § expected §"(where, cache.length(), rows))
        }
    }
}

# The token sequence, every step's logits against the pins (finite, within
# tolerance), and the cache row count recorded after every step; returns the
# worst absolute pin error.
fn check_run(list<int> generated, list<f32> logits, list<int> rows_after) → f64 {
    if generated.length() ≢ STEPS {
        fail("generated token count §"(generated.length()))
    }
    if logits.length() ≢ STEPS * 8 {
        fail("logit count §"(logits.length()))
    }
    mut f64 worst ← 0.0
    for range 0‥STEPS let i {
        if generated[i] ≢ PIN_TOKENS[i] {
            fail("step § token § expected §"(i, generated[i], PIN_TOKENS[i]))
        }
        let int expected_rows ← PROMPT + i + 1
        if rows_after[i] ≢ expected_rows {
            fail("step § cache length § expected §"(i, rows_after[i], expected_rows))
        }
        for range 0‥8 let j {
            let f64 observed ← logits[i * 8 + j] ↦ f64
            if not (observed ≥ -1000000.0 and observed ≤ 1000000.0) {
                fail("step § logit § not finite: §"(i, j, observed))
            }
            let f64 error ← abs_diff(observed, PIN_LOGITS[i * 8 + j])
            if not (error ≤ PIN_TOLERANCE) {
                fail("step § logit § observed § pinned §"(i, j, observed, PIN_LOGITS[i * 8 + j]))
            }
            if error ≻ worst {
                worst ← error
            }
        }
    }
    return worst
}

fn check_parity(list<f32> flat, list<f32> library) {
    if library.length() ≢ flat.length() {
        fail("library logit count § device §"(library.length(), flat.length()))
    }
    for range 0‥flat.length() let i {
        if not (abs_diff(flat[i] ↦ f64, library[i] ↦ f64) ≤ PARITY_TOLERANCE) {
            fail("step-0 logit § device § library §"(i, flat[i], library[i]))
        }
    }
}

fn cache_layout() → structure.KVStructure {
    do {
        let structure.LayerSet set ← structure.construct_layer_set([0, 1], structure.dense_structure(), 2, 4)
        mut list<structure.LayerSet> sets ← empty
        sets.append(set)
        return structure.construct_kv_structure(sets, structure.kv_dtype_f32(), structure.kv_dtype_f32(), structure.v_layout_transposed(), structure.sharing_gqa(), structure.attention_classic(), 4, 8, CACHE_CAPACITY)
    }
    catch err {
        fail("cache layout raised " + err.message)
    }
    return structure.default_kv_structure()
}

fn fresh_caches() → list<kv.KVCache> {
    do {
        return dense.empty_caches(cache_layout(), "tiny-decode-bench", "1.0.0", "causal-rope-d4", "synthetic")
    }
    catch err {
        fail("cache construction raised " + err.message)
    }
    return empty
}

fn bench(dense.DenseConfig cfg, (string, int) → tensor.NumericBlock ⇥ dense.DenseError source, TinyModel model, rope.RopeConfig rope_cfg) ⇥ dense.DenseError {
    let list<int> prompt ← [0, 3, 7, 1, 5, 2, 6, 4]

    # --- setup, outside the clock: the host prefill, then its caches ---------
    let dense.DenseStep prefilled ← prefill_library(cfg, source, prompt, fresh_caches(), rope_cfg)
    let list<f32> prompt_logits ← prefilled.logits.data
    let int first ← argmax_row(prompt_logits, PROMPT - 1)
    if first ≢ FIRST_TOKEN {
        fail("prefill top-1 § expected §"(first, FIRST_TOKEN))
    }
    check_cache_rows(prefilled.layers, PROMPT, "prefill")

    # --- step 0: device decode vs the library's host decode_step -------------
    let Stepped probe ← decode_device(model, first, PROMPT, prefilled.layers, rope_cfg)
    check_parity(probe.logits ↦ list<f32>, decode_library(cfg, source, first, PROMPT, prefilled.layers, rope_cfg))
    check_cache_rows(probe.caches, PROMPT + 1, "step 0")

    # --- timed repetitions ---------------------------------------------------
    mut list<f64> rates ← empty
    mut list<f64> region_ms ← empty
    mut f64 worst_error ← 0.0
    for range 0‥REPEATS let repeat {
        mut list<kv.KVCache> caches ← copy prefilled.layers
        mut list<int> generated ← empty
        mut list<f32> logits ← empty
        mut list<int> rows_after ← empty
        mut int token ← first
        let int started ← time.monotonic()
        for range 0‥STEPS let i {
            let Stepped step ← decode_device(model, token, PROMPT + i, caches, rope_cfg)
            let list<f32> row ← step.logits ↦ list<f32>
            caches ← step.caches
            token ← argmax_row(row, 0)
            generated.append(token)
            for from row let value {
                logits.append(value)
            }
            rows_after.append(caches[0].length())
        }
        let int elapsed ← time.monotonic() - started

        check_cache_rows(caches, PROMPT + STEPS, "decode end")
        check_cache_rows(prefilled.layers, PROMPT, "prefilled caches after repetition")
        let f64 error ← check_run(generated, logits, rows_after)
        if error ≻ worst_error {
            worst_error ← error
        }
        rates.append((STEPS ↦ f64) ÷ ((elapsed ↦ f64) ÷ 1000000000.0))
        region_ms.append((elapsed ↦ f64) ÷ 1000000.0)
    }

    mut list<f64> sorted_rates ← copy rates
    sorted_rates.sort()
    mut list<f64> sorted_ms ← copy region_ms
    sorted_ms.sort()
    let int middle ← REPEATS / 2
    print "decode_tokens_per_s " + (sorted_rates[middle] ↦ string)
    print "decode_ms_median " + (sorted_ms[middle] ↦ string)
    print "decode_tokens " + (STEPS ↦ string)
    print "decode_repeats " + (REPEATS ↦ string)
    print "decode_max_pin_abs_error " + (worst_error ↦ string)
    print "decode_first_token " + (first ↦ string)
    print "decode_ok true"
}

