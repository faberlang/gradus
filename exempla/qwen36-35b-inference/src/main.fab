# Qwen3.6 35B admission and tokenizer-phase exemplar.
#
# Public entry: the `qwen36-35b-inference` executable package.
# Depends on: gradus:model/artifact, gradus:model/gguf_manifest,
# gradus:tokenizer, norma:process, norma:fs.
#
# The application owns the model path and file I/O. Gradus owns pathless model
# semantics. The range seam keeps manifest inspection inside one bounded table
# prefix so a parser request cannot read the tensor data region.
#
# WHY: this phase compares artifact-backed tokenizer observations with the
# pinned probes, while refusing later capstone flags instead of claiming their
# semantics before those phases exist.

import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" gguf_manifest
import from "gradus:tokenizer/bpe" tokenizer
import from "norma:process" process
import from "norma:fs" fs

# --- pinned oracle ----------------

const int ORACLE_LENGTH ← 22663387424
const int ORACLE_VERSION ← 3
const int ORACLE_ALIGNMENT ← 32
const int ORACLE_DATA_START ← 10991392
const int ORACLE_METADATA ← 55
const int ORACLE_TENSORS ← 753
const string ORACLE_ARCHITECTURE ← "qwen35moe"

const string PROBE_A ← "สวัสดีครับ ผมชื่ออเล็กซ์"
const string PROBE_B ← "你好，世界！今天是2026年8月13日 🎉"
const list<int> PINNED_PROBE_A ← [34469, 168607, 153295, 173922, 153380, 22216, 151752, 172769]
const list<int> PINNED_PROBE_B ← [109266, 3709, 96748, 6115, 113128, 17, 15, 17, 21, 95859, 23, 96212, 16, 18, 95971, 10838, 236, 231]

# --- errors ----------------------

union CapstoneError {
    @ shared
    string message

    BadArguments,
    BadDigest,
    BadLength,
    ShortPrefix,
    BadManifest,
    AdmissionRejected,
    Divergence
}

# --- artifact admission ----------

# Keep the callback over caller-owned bytes. A request outside the prefix is a
# tensor-data read and must fail before slicing.
fn range(list<int> prefix, int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError {
    if start < 0 or length < 0 or start > prefix.length() - length {
        throw variant BadSource {message = "read request exceeds the bounded table prefix — would enter the tensor data region"}
    }
    const list<int> segment ← prefix.slice(start, start + length)
    const bytes segment_bytes ↤ segment
    return segment_bytes
}

# Restrict the operator offset to ASCII decimal text before conversion so a
# malformed operand becomes a typed argument failure rather than a panic.
fn digits(string s) → bool {
    if s.length() ≡ 0 then return false
    for from s const c {
        if not ((c ↦ string) between "0123456789") then return false
    }
    return true
}

fn build_identity(string digest, int length) → artifact.ContentIdentity ⇥ CapstoneError {
    do {
        return artifact.identity("sha-256", digest, length)
    }
    catch err {
        throw variant BadDigest { message = "content identity invalid: §"(err.message) }
    }
}

fn admission(
    (int, int) → bytes ⇥ gguf_manifest.GgufManifestError source,
    int artifact_length,
    artifact.ContentIdentity identity
) → gguf_manifest.GgufManifest ⇥ CapstoneError {
    do {
        return gguf_manifest.inspect(source, artifact_length, identity)
    }
    catch err {
        throw variant BadManifest { message = "manifest admission failed: §"(err.message) }
    }
}

fn read_architecture(gguf_manifest.GgufManifest m) → string ⇥ CapstoneError {
    do {
        return gguf_manifest.text(m, "general.architecture")
    }
    catch err {
        throw variant BadManifest { message = "architecture fact read failed: §"(err.message) }
    }
}

# --- tokenizer oracle ----------

fn repr_ids(list<int> ids) → string {
    var string out ← "["
    var bool first ← true
    for from ids const id {
        if not first { out ← out + ", " }
        out ← "§§"(out, id ↦ string)
        first ← false
    }
    return "§]"(out)
}

fn explain_divergence_ids(list<int> observed, list<int> pinned, string name) → string {
    if observed.length() ≠ pinned.length() {
        return "DIVERGENCE §{name} length: expected §{expected}, observed §{observed}"(
            name: name,
            expected: pinned.length() ↦ string,
            observed: observed.length() ↦ string
        )
    }
    var int i ← 0
    for from observed, pinned const observed_id, pinned_id {
        if observed_id ≠ pinned_id {
            return "DIVERGENCE §{name} first divergent id at index §{index}: expected §{expected}, observed §{observed}"(
                name: name,
                index: i ↦ string,
                expected: pinned_id ↦ string,
                observed: observed_id ↦ string
            )
        }
        i ↑
    }
    return ""
}

fn explain_divergence_text(string observed, string pinned, string name) → string {
    if observed ≡ pinned then return ""
    var int i ← 0
    for from pinned const expected_character {
        if i ≥ observed.length() {
            return "DIVERGENCE §{name} length: expected §{expected}, observed §{observed}"(
                name: name,
                expected: pinned.length() ↦ string,
                observed: observed.length() ↦ string
            )
        }
        const string observed_character ← observed.slice(i, i + 1)
        const string expected_text ← expected_character ↦ string
        if observed_character ≠ expected_text {
            return "DIVERGENCE §{name} first divergent character at index §{index}: expected '§{expected}', observed '§{observed}'"(
                name: name,
                index: i ↦ string,
                expected: expected_text,
                observed: observed_character
            )
        }
        i ↑
    }
    return "DIVERGENCE §{name} length: expected §{expected}, observed §{observed}"(
        name: name,
        expected: pinned.length() ↦ string,
        observed: observed.length() ↦ string
    )
}

# --- executable phase -----------

main {
    do {
        const list<string> args ← process.argv() ↦ list<string>
        if args.length() < 2 {
            throw variant BadArguments { message = "usage: qwen36-35b-inference <model-path> --sha256 <digest> [--oracle-offset <n>] [--prompt <text> ...] [--max-new-tokens <n>] [--seed <n>] [--receipt <path>]" }
        }
        const string via ← args.get(0) coalesce ""
        if via.starts_with("--") {
            throw variant BadArguments { message = "missing model path" }
        }
        var string digest ← ""
        var int oracle_offset ← ORACLE_DATA_START
        var string receptum ← ""
        var int i ← 1
        while i < args.length() {
            const string arg ← args.get(i) coalesce ""
            if arg ≡ "--sha256" {
                if i + 1 ≥ args.length() {
                    throw variant BadArguments { message = "--sha256 requires a digest operand" }
                }
                digest ← args.get(i + 1) coalesce ""
                i ← i + 2
            } elif arg ≡ "--oracle-offset" {
                if i + 1 ≥ args.length() {
                    throw variant BadArguments { message = "--oracle-offset requires a numeric operand" }
                }
                const string operand ← args.get(i + 1) coalesce ""
                if not (digits(operand)) {
                    throw variant BadArguments { message = "--oracle-offset must be a non-negative integer: §"(operand) }
                }
                var int offset_lectum ← 0
                do {
                    offset_lectum ↤ operand
                }
                catch err {
                    throw variant BadArguments { message = "--oracle-offset could not be read as an integer: §"(err.message) }
                }
                oracle_offset ← offset_lectum
                i ← i + 2
            } elif arg ≡ "--receipt" {
                if i + 1 ≥ args.length() {
                    throw variant BadArguments { message = "--receipt requires a path operand" }
                }
                receptum ← args.get(i + 1) coalesce ""
                i ← i + 2
            } elif arg ≡ "--prompt" or arg ≡ "--max-new-tokens" or arg ≡ "--seed" {
                throw variant BadArguments { message = "§ is reserved for later M6 capstone units and is not implemented by the tokenizer phase"(arg) }
            } elif arg.starts_with("--") {
                throw variant BadArguments { message = "unknown flag: §"(arg) }
            } else {
                throw variant BadArguments { message = "unexpected positional argument: §"(arg) }
            }
        }
        if digest ≡ "" {
            throw variant BadArguments { message = "missing required --sha256 <digest>" }
        }

        const int total ← fs.byte_length(via)
        const artifact.ContentIdentity identity ← build_identity(digest, total)
        const bytes prefix_bytes ← fs.read_range(via, 0, oracle_offset)
        if prefix_bytes.length() ≠ oracle_offset {
            throw variant ShortPrefix { message = "short table-prefix read: expected § bytes, observed §"(oracle_offset ↦ string, prefix_bytes.length() ↦ string) }
        }
        if total ≠ ORACLE_LENGTH {
            throw variant BadLength { message = "byte length mismatch: expected §, observed §"(ORACLE_LENGTH ↦ string, total ↦ string) }
        }
        const value prefix_payload ← prefix_bytes ↦ value
        var list<int> prefix ← empty
        do {
            prefix ↤ prefix_payload
        }
        catch err {
            throw variant BadManifest { message = "table-prefix carrier conversion failed: §"(err.message) }
        }
        const gguf_manifest.GgufManifest m ← admission(
            (int start, int length) → bytes ⇥ gguf_manifest.GgufManifestError ∴ range(prefix, start, length),
            total,
            identity
        )

        if m.version ≠ ORACLE_VERSION {
            throw variant AdmissionRejected { message = "first mismatched fact: version — expected §, observed §"(ORACLE_VERSION ↦ string, m.version ↦ string) }
        }
        if m.alignment ≠ ORACLE_ALIGNMENT {
            throw variant AdmissionRejected { message = "first mismatched fact: alignment — expected §, observed §"(ORACLE_ALIGNMENT ↦ string, m.alignment ↦ string) }
        }
        if m.data_start ≠ oracle_offset {
            throw variant AdmissionRejected { message = "first mismatched fact: data offset — expected §, observed §"(oracle_offset ↦ string, m.data_start ↦ string) }
        }
        if m.metadata.length() ≠ ORACLE_METADATA {
            throw variant AdmissionRejected { message = "first mismatched fact: metadata count — expected §, observed §"(ORACLE_METADATA ↦ string, m.metadata.length() ↦ string) }
        }
        if m.tensors.length() ≠ ORACLE_TENSORS {
            throw variant AdmissionRejected { message = "first mismatched fact: tensor count — expected §, observed §"(ORACLE_TENSORS ↦ string, m.tensors.length() ↦ string) }
        }
        const string architecture ← read_architecture(m)
        if architecture ≠ ORACLE_ARCHITECTURE {
            throw variant AdmissionRejected { message = "first mismatched fact: architecture — expected §, observed §"(ORACLE_ARCHITECTURE, architecture) }
        }

        print "PASS version=§{version} alignment=§{alignment} data=§{data} metadata=§{metadata} tensors=§{tensors} architecture=§{architecture}"(
            version: m.version ↦ string,
            alignment: m.alignment ↦ string,
            data: m.data_start ↦ string,
            metadata: m.metadata.length() ↦ string,
            tensors: m.tensors.length() ↦ string,
            architecture: architecture
        )
        print "PASS bytes=§"(total ↦ string)
        print "RECORDED sha256=§ (content re-derived externally via shasum -a 256)"(digest)
        print "ADMISSION PASS"

        # --- tokenizer phase ----------------

        var tokenizer.Tokenizer t ← tokenizer.Tokenizer {words = empty, vocab = empty, concursus = empty, special_texts = empty, specialia_ids = empty, eog = empty, add_bos = false, chat_template = "", multitudo = 0}
        do {
            t ← tokenizer.build(m)
        }
        catch err {
            throw variant BadManifest { message = "tokenizer runtime build failed: §"(err.message) }
        }
        print "TOKENIZER vocab=§ (artifact-backed runtime, public gradus:tokenizer surface)"(t.multitudo ↦ string)

        var list<int> ids_a ← empty
        do {
            ids_a ← tokenizer.encode_prompt(t, PROBE_A)
        }
        catch err {
            throw variant BadManifest { message = "Probe A encode failed: §"(err.message) }
        }
        const string div_a ← explain_divergence_ids(ids_a, PINNED_PROBE_A, "Probe A encode")
        if not (div_a ≡ "") {
            throw variant Divergence { message = div_a }
        }
        print "PASS Probe A encode -> §"(repr_ids(ids_a))

        var list<int> ids_b ← empty
        do {
            ids_b ← tokenizer.encode_prompt(t, PROBE_B)
        }
        catch err {
            throw variant BadManifest { message = "Probe B encode failed: §"(err.message) }
        }
        const string div_b ← explain_divergence_ids(ids_b, PINNED_PROBE_B, "Probe B encode")
        if not (div_b ≡ "") {
            throw variant Divergence { message = div_b }
        }
        print "PASS Probe B encode -> §"(repr_ids(ids_b))

        var string dec_a ← ""
        do {
            dec_a ← tokenizer.decode(t, ids_a)
        }
        catch err {
            throw variant BadManifest { message = "Probe A decode failed: §"(err.message) }
        }
        const string div_dec_a ← explain_divergence_text(dec_a, PROBE_A, "Probe A decode")
        if not (div_dec_a ≡ "") {
            throw variant Divergence { message = div_dec_a }
        }
        print "PASS Probe A decode -> §"(dec_a)

        var string dec_b ← ""
        do {
            dec_b ← tokenizer.decode(t, ids_b)
        }
        catch err {
            throw variant BadManifest { message = "Probe B decode failed: §"(err.message) }
        }
        const string div_dec_b ← explain_divergence_text(dec_b, PROBE_B, "Probe B decode")
        if not (div_dec_b ≡ "") {
            throw variant Divergence { message = div_dec_b }
        }
        print "PASS Probe B decode -> §"(dec_b)

        print "TOKENIZER PHASE PASS"

        if not (receptum ≡ "") {
            const string contentum ← "qwen36-35b-inference tokenizer-phase receipt\nartifact: §{artifact}\nbytes: §{bytes}\nsha256: §{sha256}\nversion: §{version}\nalignment: §{alignment}\ndata offset: §{data_offset}\nmetadata: §{metadata}\ntensors: §{tensors}\narchitecture: §{architecture}\ntokenizer vocab: §{vocab}\nProbe A: §{probe_a}\nProbe B: §{probe_b}\nProbe A decode: §{decode_a}\nProbe B decode: §{decode_b}\nresult: PASS\nreserved flags (--prompt/--max-new-tokens/--seed) are not implemented by the tokenizer phase\n"(
                artifact: via,
                bytes: total ↦ string,
                sha256: digest,
                version: m.version ↦ string,
                alignment: m.alignment ↦ string,
                data_offset: m.data_start ↦ string,
                metadata: m.metadata.length() ↦ string,
                tensors: m.tensors.length() ↦ string,
                architecture: architecture,
                vocab: t.multitudo ↦ string,
                probe_a: repr_ids(ids_a),
                probe_b: repr_ids(ids_b),
                decode_a: dec_a,
                decode_b: dec_b
            )
            fs.write_file(receptum, contentum)
            print "RECEIPT §"(receptum)
        }
    }
    catch err {
        panic "capstone run failed: §"(err.message)
    }
}
