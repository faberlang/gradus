# M6-U1 capstone scaffold — real-artifact identity and manifest admission.
#
# This is the public-Gradus application surface for the Qwen3.6 campaign. The
# application owns the path and I/O: it resolves the operator-supplied model
# path, measures the artifact size, validates the operator-supplied content
# digest form and the pinned byte length, reads the independently bounded
# header/table prefix once, admits the GGUF v3 manifest through the public
# gradus:model/artifact and gradus:model/gguf_manifest surfaces, and fails
# closed on any identity mismatch, short table-prefix read, or read that
# would enter the tensor data region. Observed facts go to the optional
# --receipt path.
#
# This unit performs no tokenizer, tensor materialization, graph, inference,
# or device work. --prompt / --max-new-tokens / --seed belong to later M6
# capstone units; they are reserved in the CLI contract below and refused
# here so this unit never claims their semantics.

importa ex "gradus:model/artifact" artifact
importa ex "gradus:model/gguf_manifest" manifestum
importa ex "norma:processus" processus
importa ex "norma:solum" solum

# Campaign-pinned oracle facts for the exact artifact (independent GGUF
# reader and the GGUF-A1b receipt; byte identity measured with `stat` and
# `shasum -a 256`). The content digest arrives on the CLI because the FMIR
# surface has no sha-256 primitive; the documented command re-derives it
# with `shasum -a 256` and compares it to the pinned value.
fixum numerus ORACLE_LONGITUDO ← 22663387424
fixum numerus ORACLE_VERSIO ← 3
fixum numerus ORACLE_CONCORDATIO ← 32
fixum numerus ORACLE_DATA_INCEPTUM ← 10991392
fixum numerus ORACLE_METADATA ← 55
fixum numerus ORACLE_TENSORES ← 753
fixum textus ORACLE_ARCHITECTURA ← "qwen35moe"

discretio CapstoneError {
    ArgumentaMala { textus causa },
    DigestioMala { textus causa },
    LongitudoMala { textus causa },
    PrefixumBreve { textus causa },
    ManifestumMala { textus causa },
    AdmissioReprobata { textus causa }
}

functio causa(CapstoneError e) → textus {
    discerne e {
        casu ArgumentaMala fixum causa { redde causa }
        casu DigestioMala fixum causa { redde causa }
        casu LongitudoMala fixum causa { redde causa }
        casu PrefixumBreve fixum causa { redde causa }
        casu ManifestumMala fixum causa { redde causa }
        casu AdmissioReprobata fixum causa { redde causa }
    }
}

# Application-owned range seam over the bounded table prefix. Gradus receives
# only this function over the caller-owned buffer — never the path, the file
# handle, or the prefix itself. A request whose end exceeds the prefix is a
# tensor-data read and fails closed.
functio _range(lista<numerus> prefix, numerus initium, numerus longitudo) → manifestum.LectioFontis {
    si initium < 0 aut longitudo < 0 aut initium > prefix.longitudo() - longitudo {
        redde manifestum.LectioFontis {
            successus = falsum,
            bytes = ||,
            causa = "read request exceeds the bounded table prefix — would enter the tensor data region"
        }
    }
    fixum lista<numerus> segmentum ← prefix.sectio(initium, initium + longitudo)
    fixum octeti bytes ← segmentum ↦ octeti
    redde manifestum.LectioFontis { successus = verum, bytes = bytes, causa = "" }
}

# Only ASCII digits are accepted for the operator offset operand; a malformed
# number is a typed argument failure instead of a conversion panic.
functio _digitorum(textus s) → bivalens {
    si s.longitudo() ≡ 0 ergo redde falsum
    varia numerus i ← 0
    dum i < s.longitudo() {
        fixum textus c ← s.sectio(i, i + 1)
        si non (c ≡ "0" aut c ≡ "1" aut c ≡ "2" aut c ≡ "3" aut c ≡ "4" aut c ≡ "5" aut c ≡ "6" aut c ≡ "7" aut c ≡ "8" aut c ≡ "9") {
            redde falsum
        }
        i ↑
    }
    redde verum
}

# Map the pathless identity validator's failure into the application error
# vocabulary.
functio _identitas(textus digestio, numerus longitudo) → artifact.IdentitasContenuti ⇥ CapstoneError {
    fac {
        redde artifact.identitas("sha-256", digestio, longitudo)
    }
    cape err {
        iace finge DigestioMala { causa = "content identity invalid: " + artifact.causa(err) }
    }
}

# Admit the manifest through the public range seam. The failure is wrapped so
# the application boundary names the manifest stage with the library cause.
functio _admissio(
    (numerus, numerus) → manifestum.LectioFontis fons,
    numerus longitudo_artifacti,
    artifact.IdentitasContenuti identitas
) → manifestum.ManifestumGguf ⇥ CapstoneError {
    fac {
        redde manifestum.inspice(fons, longitudo_artifacti, identitas)
    }
    cape err {
        iace finge ManifestumMala { causa = "manifest admission failed: " + manifestum.causa(err) }
    }
}

functio _architectura(manifestum.ManifestumGguf m) → textus ⇥ CapstoneError {
    fac {
        redde manifestum.textum(m, "general.architecture")
    }
    cape err {
        iace finge ManifestumMala { causa = "architecture fact read failed: " + manifestum.causa(err) }
    }
}

incipit {
    fac {
        fixum lista<textus> args ← processus.argumenta() ↦ lista<textus>
        si args.longitudo() < 2 {
            iace finge ArgumentaMala { causa = "usage: qwen36-35b-inference <model-path> --sha256 <digest> [--oracle-offset <n>] [--prompt <text> ...] [--max-new-tokens <n>] [--seed <n>] [--receipt <path>]" }
        }
        fixum textus via ← args.accipe(0) vel ""
        si via.initium("--") {
            iace finge ArgumentaMala { causa = "missing model path" }
        }
        varia textus digest ← ""
        varia numerus oracle_offset ← ORACLE_DATA_INCEPTUM
        varia textus receptum ← ""
        varia numerus i ← 1
        dum i < args.longitudo() {
            fixum textus arg ← args.accipe(i) vel ""
            si arg ≡ "--sha256" {
                si i + 1 ≥ args.longitudo() {
                    iace finge ArgumentaMala { causa = "--sha256 requires a digest operand" }
                }
                digest ← args.accipe(i + 1) vel ""
                i ← i + 2
            } sin arg ≡ "--oracle-offset" {
                si i + 1 ≥ args.longitudo() {
                    iace finge ArgumentaMala { causa = "--oracle-offset requires a numeric operand" }
                }
                fixum textus operand ← args.accipe(i + 1) vel ""
                si non (_digitorum(operand)) {
                    iace finge ArgumentaMala { causa = "--oracle-offset must be a non-negative integer: " + operand }
                }
                varia numerus offset_lectum ← 0
                fac {
                    offset_lectum ← operand ↦ numerus
                }
                cape err {
                    iace finge ArgumentaMala { causa = "--oracle-offset could not be read as an integer: " + err }
                }
                oracle_offset ← offset_lectum
                i ← i + 2
            } sin arg ≡ "--receipt" {
                si i + 1 ≥ args.longitudo() {
                    iace finge ArgumentaMala { causa = "--receipt requires a path operand" }
                }
                receptum ← args.accipe(i + 1) vel ""
                i ← i + 2
            } sin arg ≡ "--prompt" aut arg ≡ "--max-new-tokens" aut arg ≡ "--seed" {
                iace finge ArgumentaMala { causa = arg + " is reserved for later M6 capstone units and is not implemented by M6-U1" }
            } sin arg.initium("--") {
                iace finge ArgumentaMala { causa = "unknown flag: " + arg }
            } secus {
                iace finge ArgumentaMala { causa = "unexpected positional argument: " + arg }
            }
        }
        si digest ≡ "" {
            iace finge ArgumentaMala { causa = "missing required --sha256 <digest>" }
        }

        fixum numerus total ← solum.mensura(via)
        fixum artifact.IdentitasContenuti identitas ← _identitas(digest, total)
        fixum octeti prefix_bytes ← solum.partem(via, 0, oracle_offset)
        si prefix_bytes.longitudo() ≠ oracle_offset {
            iace finge PrefixumBreve { causa = "short table-prefix read: expected " + (oracle_offset ↦ textus) + " bytes, observed " + (prefix_bytes.longitudo() ↦ textus) }
        }
        si total ≠ ORACLE_LONGITUDO {
            iace finge LongitudoMala { causa = "byte length mismatch: expected " + (ORACLE_LONGITUDO ↦ textus) + ", observed " + (total ↦ textus) }
        }
        fixum valor prefix_valor ← prefix_bytes ↦ valor
        varia lista<numerus> prefix ← vacua
        fac {
            prefix ← prefix_valor ↦ lista<numerus>
        }
        cape err {
            iace finge ManifestumMala { causa = "table-prefix carrier conversion failed: " + err }
        }
        fixum manifestum.ManifestumGguf m ← _admissio(
            (numerus initium, numerus longitudo) → manifestum.LectioFontis ∴ _range(prefix, initium, longitudo),
            total,
            identitas
        )

        si m.versio ≠ ORACLE_VERSIO {
            iace finge AdmissioReprobata { causa = "first mismatched fact: version — expected " + (ORACLE_VERSIO ↦ textus) + ", observed " + (m.versio ↦ textus) }
        }
        si m.concordatio ≠ ORACLE_CONCORDATIO {
            iace finge AdmissioReprobata { causa = "first mismatched fact: alignment — expected " + (ORACLE_CONCORDATIO ↦ textus) + ", observed " + (m.concordatio ↦ textus) }
        }
        si m.data_inceptum ≠ oracle_offset {
            iace finge AdmissioReprobata { causa = "first mismatched fact: data offset — expected " + (oracle_offset ↦ textus) + ", observed " + (m.data_inceptum ↦ textus) }
        }
        si m.metadata.longitudo() ≠ ORACLE_METADATA {
            iace finge AdmissioReprobata { causa = "first mismatched fact: metadata count — expected " + (ORACLE_METADATA ↦ textus) + ", observed " + (m.metadata.longitudo() ↦ textus) }
        }
        si m.tensores.longitudo() ≠ ORACLE_TENSORES {
            iace finge AdmissioReprobata { causa = "first mismatched fact: tensor count — expected " + (ORACLE_TENSORES ↦ textus) + ", observed " + (m.tensores.longitudo() ↦ textus) }
        }
        fixum textus architecture ← _architectura(m)
        si architecture ≠ ORACLE_ARCHITECTURA {
            iace finge AdmissioReprobata { causa = "first mismatched fact: architecture — expected " + ORACLE_ARCHITECTURA + ", observed " + architecture }
        }

        nota "PASS version=" + (m.versio ↦ textus)
            + " alignment=" + (m.concordatio ↦ textus)
            + " data=" + (m.data_inceptum ↦ textus)
            + " metadata=" + (m.metadata.longitudo() ↦ textus)
            + " tensors=" + (m.tensores.longitudo() ↦ textus)
            + " architecture=" + architecture
        nota "PASS bytes=" + (total ↦ textus)
        nota "RECORDED sha256=" + digest + " (content re-derived externally via shasum -a 256)"
        nota "ADMISSION PASS"

        si non (receptum ≡ "") {
            varia textus contentum ← "qwen36-35b-inference M6-U1 admission receipt\n"
                + "artifact: " + via + "\n"
                + "bytes: " + (total ↦ textus) + "\n"
                + "sha256: " + digest + "\n"
                + "version: " + (m.versio ↦ textus) + "\n"
                + "alignment: " + (m.concordatio ↦ textus) + "\n"
                + "data offset: " + (m.data_inceptum ↦ textus) + "\n"
                + "metadata: " + (m.metadata.longitudo() ↦ textus) + "\n"
                + "tensors: " + (m.tensores.longitudo() ↦ textus) + "\n"
                + "architecture: " + architecture + "\n"
                + "result: PASS\n"
                + "reserved flags (--prompt/--max-new-tokens/--seed) are not implemented by M6-U1\n"
            solum.scribe(receptum, contentum)
            nota "RECEIPT " + receptum
        }
    }
    cape err {
        mori "M6-U1 admission failed: " + causa(err)
    }
}
