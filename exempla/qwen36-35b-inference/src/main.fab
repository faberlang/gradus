+++
locale = "en"
+++
# M6-U1 capstone scaffold + LIB-02-U4-1 tokenizer phase.
#
# This is the public-Gradus application surface for the Qwen3.6 campaign. The
# application owns the path and I/O: it resolves the operator-supplied model
# path, measures the artifact size, validates the operator-supplied content
# digest form and the pinned byte length, reads the independently bounded
# header/table prefix once, admits the GGUF v3 manifest through the public
# gradus:model/artifact and gradus:model/gguf_manifest surfaces, and fails
# closed on any identity mismatch, short table-prefix read, or read that
# would enter the tensor data region. Observed facts go to the optional
# --receipt path.
#
# LIB-02-U4-1 adds the TOKENIZER phase: after admission, the application
# builds the artifact-backed runtime through the public `gradus:tokenizer`
# surface (fabricare), encodes the two pinned probes (raw-prompt rows, never
# through the chat template) with the scanner + BPE core, decodes both id
# lists back, and prints PASS rows when the observed rows equal the pinned
# oracle. Any divergence names the first divergent id/character and fails
# closed (campaign rule 5 divergence receipt). This unit performs no tensor
# materialization, model forward, GPU execution, or full-capstone code beyond
# the tokenizer phase. --prompt / --max-new-tokens / --seed belong to later
# M6 capstone units; they are reserved in the CLI contract below and refused
# here so this phase never claims their semantics.

import from "gradus:model/artifact" artifact
import from "gradus:model/gguf_manifest" manifestum
import from "gradus:tokenizer" tokenizator
import from "norma:processus" processus
import from "norma:solum" solum

# Campaign-pinned oracle facts for the exact artifact (independent GGUF
# reader and the GGUF-A1b receipt; byte identity measured with `stat` and
# `shasum -a 256`). The content digest arrives on the CLI because the FMIR
# surface has no sha-256 primitive; the documented command re-derives it
# with `shasum -a 256` and compares it to the pinned value.
const int ORACLE_LONGITUDO ← 22663387424
const int ORACLE_VERSIO ← 3
const int ORACLE_CONCORDATIO ← 32
const int ORACLE_DATA_INCEPTUM ← 10991392
const int ORACLE_METADATA ← 55
const int ORACLE_TENSORES ← 753
const string ORACLE_ARCHITECTURA ← "qwen35moe"

# LIB-02 pinned two-probe oracle (llama-tokenize 10150 `dee2a846b`, target
# artifact; rows deterministic — see the delivery oracle section). The probes
# are the operator text inputs; the observed id lists come from the runtime,
# never from these pinned values (the stop-condition invariant).
const string PROBE_A ← "สวัสดีครับ ผมชื่ออเล็กซ์"
const string PROBE_B ← "你好，世界！今天是2026年8月13日 🎉"
const list<int> PINNATA_PROBE_A ← [34469, 168607, 153295, 173922, 153380, 22216, 151752, 172769]
const list<int> PINNATA_PROBE_B ← [109266, 3709, 96748, 6115, 113128, 17, 15, 17, 21, 95859, 23, 96212, 16, 18, 95971, 10838, 236, 231]

union CapstoneError {
    ArgumentaMala { string causa },
    DigestioMala { string causa },
    LongitudoMala { string causa },
    PrefixumBreve { string causa },
    ManifestumMala { string causa },
    AdmissioReprobata { string causa },
    Divergentia { string causa }
}

fn causa(CapstoneError e) → string {
    match e {
        case ArgumentaMala const causa { return causa }
        case DigestioMala const causa { return causa }
        case LongitudoMala const causa { return causa }
        case PrefixumBreve const causa { return causa }
        case ManifestumMala const causa { return causa }
        case AdmissioReprobata const causa { return causa }
        case Divergentia const causa { return causa }
    }
}

# Application-owned range seam over the bounded table prefix. Gradus receives
# only this function over the caller-owned buffer — never the path, the file
# handle, or the prefix itself. A request whose end exceeds the prefix is a
# tensor-data read and fails closed.
fn _range(list<int> prefix, int initium, int longitudo) → manifestum.SourceRead {
    if initium < 0 or longitudo < 0 or initium > prefix.length() - longitudo {
        return manifestum.SourceRead {
            successus = false,
            bytes = ||,
            message = "read request exceeds the bounded table prefix — would enter the tensor data region"
        }
    }
    const list<int> segmentum ← prefix.slice(initium, initium + longitudo)
    const bytes bytes ← segmentum ↦ bytes
    return manifestum.SourceRead { successus = true, bytes = bytes, message = "" }
}

# Only ASCII digits are accepted for the operator offset operand; a malformed
# number is a typed argument failure instead of a conversion panic.
fn _digitorum(string s) → bool {
    if s.length() ≡ 0 then return false
    var int i ← 0
    while i < s.length() {
        const string c ← s.slice(i, i + 1)
        if not (c ≡ "0" or c ≡ "1" or c ≡ "2" or c ≡ "3" or c ≡ "4" or c ≡ "5" or c ≡ "6" or c ≡ "7" or c ≡ "8" or c ≡ "9") {
            return false
        }
        i ↑
    }
    return true
}

# Map the pathless identity validator's failure into the application error
# vocabulary.
fn _identitas(string digestio, int longitudo) → artifact.ContentIdentity ⇥ CapstoneError {
    do {
        return artifact.identitas("sha-256", digestio, longitudo)
    }
    catch err {
        throw variant DigestioMala { causa = "content identity invalid: " + artifact.message(err) }
    }
}

# Admit the manifest through the public range seam. The failure is wrapped so
# the application boundary names the manifest stage with the library cause.
fn _admissio(
    (int, int) → manifestum.SourceRead fons,
    int longitudo_artifacti,
    artifact.ContentIdentity identitas
) → manifestum.GgufManifest ⇥ CapstoneError {
    do {
        return manifestum.inspect(fons, longitudo_artifacti, identitas)
    }
    catch err {
        throw variant ManifestumMala { causa = "manifest admission failed: " + manifestum.message(err) }
    }
}

fn _architectura(manifestum.GgufManifest m) → string ⇥ CapstoneError {
    do {
        return manifestum.textum(m, "general.architecture")
    }
    catch err {
        throw variant ManifestumMala { causa = "architecture fact read failed: " + manifestum.message(err) }
    }
}

# Render an observed id list for the probe rows.
fn _repr_ids(list<int> ids) → string {
    var string out ← "["
    var int i ← 0
    while i < ids.length() {
        if i > 0 { out ← out + ", " }
        out ← out + (ids.get(i) coalesce 0 ↦ string)
        i ↑
    }
    return out + "]"
}

# Divergence receipt for an id-list row: the first divergent id/character
# names itself (campaign rule 5); identical rows return "" (PASS).
fn _explica_divergentia_ids(list<int> observata, list<int> pinnata, string nomen) → string {
    if observata.length() ≠ pinnata.length() {
        return "DIVERGENCE " + nomen + " length: expected " + (pinnata.length() ↦ string) + ", observed " + (observata.length() ↦ string)
    }
    var int i ← 0
    while i < observata.length() {
        if (observata.get(i) coalesce 0) ≠ (pinnata.get(i) coalesce 0) {
            return "DIVERGENCE " + nomen + " first divergent id at index " + (i ↦ string) + ": expected " + ((pinnata.get(i) coalesce 0) ↦ string) + ", observed " + ((observata.get(i) coalesce 0) ↦ string)
        }
        i ↑
    }
    return ""
}

# Divergence receipt for a decoded-text row (byte-level round-trip).
fn _explica_divergentia_textus(string observata, string pinnata, string nomen) → string {
    if observata ≡ pinnata {
        return ""
    }
    var int i ← 0
    while i < pinnata.length() and i < observata.length() {
        if observata.slice(i, i + 1) ≠ pinnata.slice(i, i + 1) {
            return "DIVERGENCE " + nomen + " first divergent character at index " + (i ↦ string) + ": expected '" + pinnata.slice(i, i + 1) + "', observed '" + observata.slice(i, i + 1) + "'"
        }
        i ↑
    }
    return "DIVERGENCE " + nomen + " length: expected " + (pinnata.length() ↦ string) + ", observed " + (observata.length() ↦ string)
}

main {
    do {
        const list<string> args ← processus.argv() ↦ list<string>
        if args.length() < 2 {
            throw variant ArgumentaMala { causa = "usage: qwen36-35b-inference <model-path> --sha256 <digest> [--oracle-offset <n>] [--prompt <text> ...] [--max-new-tokens <n>] [--seed <n>] [--receipt <path>]" }
        }
        const string via ← args.get(0) coalesce ""
        if via.starts_with("--") {
            throw variant ArgumentaMala { causa = "missing model path" }
        }
        var string digest ← ""
        var int oracle_offset ← ORACLE_DATA_INCEPTUM
        var string receptum ← ""
        var int i ← 1
        while i < args.length() {
            const string arg ← args.get(i) coalesce ""
            if arg ≡ "--sha256" {
                if i + 1 ≥ args.length() {
                    throw variant ArgumentaMala { causa = "--sha256 requires a digest operand" }
                }
                digest ← args.get(i + 1) coalesce ""
                i ← i + 2
            } elif arg ≡ "--oracle-offset" {
                if i + 1 ≥ args.length() {
                    throw variant ArgumentaMala { causa = "--oracle-offset requires a numeric operand" }
                }
                const string operand ← args.get(i + 1) coalesce ""
                if not (_digitorum(operand)) {
                    throw variant ArgumentaMala { causa = "--oracle-offset must be a non-negative integer: " + operand }
                }
                var int offset_lectum ← 0
                do {
                    offset_lectum ← operand ↦ int
                }
                catch err {
                    throw variant ArgumentaMala { causa = "--oracle-offset could not be read as an integer: " + err }
                }
                oracle_offset ← offset_lectum
                i ← i + 2
            } elif arg ≡ "--receipt" {
                if i + 1 ≥ args.length() {
                    throw variant ArgumentaMala { causa = "--receipt requires a path operand" }
                }
                receptum ← args.get(i + 1) coalesce ""
                i ← i + 2
            } elif arg ≡ "--prompt" or arg ≡ "--max-new-tokens" or arg ≡ "--seed" {
                throw variant ArgumentaMala { causa = arg + " is reserved for later M6 capstone units and is not implemented by the tokenizer phase" }
            } elif arg.starts_with("--") {
                throw variant ArgumentaMala { causa = "unknown flag: " + arg }
            } else {
                throw variant ArgumentaMala { causa = "unexpected positional argument: " + arg }
            }
        }
        if digest ≡ "" {
            throw variant ArgumentaMala { causa = "missing required --sha256 <digest>" }
        }

        const int total ← solum.byte_length(via)
        const artifact.ContentIdentity identitas ← _identitas(digest, total)
        const bytes prefix_bytes ← solum.read_range(via, 0, oracle_offset)
        if prefix_bytes.length() ≠ oracle_offset {
            throw variant PrefixumBreve { causa = "short table-prefix read: expected " + (oracle_offset ↦ string) + " bytes, observed " + (prefix_bytes.length() ↦ string) }
        }
        if total ≠ ORACLE_LONGITUDO {
            throw variant LongitudoMala { causa = "byte length mismatch: expected " + (ORACLE_LONGITUDO ↦ string) + ", observed " + (total ↦ string) }
        }
        const value prefix_valor ← prefix_bytes ↦ value
        var list<int> prefix ← vacua
        do {
            prefix ← prefix_valor ↦ list<int>
        }
        catch err {
            throw variant ManifestumMala { causa = "table-prefix carrier conversion failed: " + err }
        }
        const manifestum.GgufManifest m ← _admissio(
            (int initium, int longitudo) → manifestum.SourceRead ∴ _range(prefix, initium, longitudo),
            total,
            identitas
        )

        if m.version ≠ ORACLE_VERSIO {
            throw variant AdmissioReprobata { causa = "first mismatched fact: version — expected " + (ORACLE_VERSIO ↦ string) + ", observed " + (m.version ↦ string) }
        }
        if m.concordatio ≠ ORACLE_CONCORDATIO {
            throw variant AdmissioReprobata { causa = "first mismatched fact: alignment — expected " + (ORACLE_CONCORDATIO ↦ string) + ", observed " + (m.concordatio ↦ string) }
        }
        if m.data_inceptum ≠ oracle_offset {
            throw variant AdmissioReprobata { causa = "first mismatched fact: data offset — expected " + (oracle_offset ↦ string) + ", observed " + (m.data_inceptum ↦ string) }
        }
        if m.metadata.length() ≠ ORACLE_METADATA {
            throw variant AdmissioReprobata { causa = "first mismatched fact: metadata count — expected " + (ORACLE_METADATA ↦ string) + ", observed " + (m.metadata.length() ↦ string) }
        }
        if m.tensors.length() ≠ ORACLE_TENSORES {
            throw variant AdmissioReprobata { causa = "first mismatched fact: tensor count — expected " + (ORACLE_TENSORES ↦ string) + ", observed " + (m.tensors.length() ↦ string) }
        }
        const string architecture ← _architectura(m)
        if architecture ≠ ORACLE_ARCHITECTURA {
            throw variant AdmissioReprobata { causa = "first mismatched fact: architecture — expected " + ORACLE_ARCHITECTURA + ", observed " + architecture }
        }

        print "PASS version=" + (m.version ↦ string)
            + " alignment=" + (m.concordatio ↦ string)
            + " data=" + (m.data_inceptum ↦ string)
            + " metadata=" + (m.metadata.length() ↦ string)
            + " tensors=" + (m.tensors.length() ↦ string)
            + " architecture=" + architecture
        print "PASS bytes=" + (total ↦ string)
        print "RECORDED sha256=" + digest + " (content re-derived externally via shasum -a 256)"
        print "ADMISSION PASS"

        # --- Tokenizer phase (LIB-02-U4-1) ---
        var tokenizator.Tokenizer t
        do {
            t ← tokenizator.build(m)
        }
        catch err {
            throw variant ManifestumMala { causa = "tokenizer runtime build failed" }
        }
        print "TOKENIZER vocab=" + (t.multitudo ↦ string) + " (artifact-backed runtime, public gradus:tokenizer surface)"

        var list<int> ids_a ← vacua
        do {
            ids_a ← tokenizator.encode_prompt(t, PROBE_A)
        }
        catch err {
            throw variant ManifestumMala { causa = "Probe A encode failed" }
        }
        const string div_a ← _explica_divergentia_ids(ids_a, PINNATA_PROBE_A, "Probe A encode")
        if not (div_a ≡ "") {
            throw variant Divergentia { causa = div_a }
        }
        print "PASS Probe A encode -> " + _repr_ids(ids_a)

        var list<int> ids_b ← vacua
        do {
            ids_b ← tokenizator.encode_prompt(t, PROBE_B)
        }
        catch err {
            throw variant ManifestumMala { causa = "Probe B encode failed" }
        }
        const string div_b ← _explica_divergentia_ids(ids_b, PINNATA_PROBE_B, "Probe B encode")
        if not (div_b ≡ "") {
            throw variant Divergentia { causa = div_b }
        }
        print "PASS Probe B encode -> " + _repr_ids(ids_b)

        var string dec_a ← ""
        do {
            dec_a ← tokenizator.decode(t, ids_a)
        }
        catch err {
            throw variant ManifestumMala { causa = "Probe A decode failed" }
        }
        const string div_dec_a ← _explica_divergentia_textus(dec_a, PROBE_A, "Probe A decode")
        if not (div_dec_a ≡ "") {
            throw variant Divergentia { causa = div_dec_a }
        }
        print "PASS Probe A decode -> " + dec_a

        var string dec_b ← ""
        do {
            dec_b ← tokenizator.decode(t, ids_b)
        }
        catch err {
            throw variant ManifestumMala { causa = "Probe B decode failed" }
        }
        const string div_dec_b ← _explica_divergentia_textus(dec_b, PROBE_B, "Probe B decode")
        if not (div_dec_b ≡ "") {
            throw variant Divergentia { causa = div_dec_b }
        }
        print "PASS Probe B decode -> " + dec_b

        print "TOKENIZER PHASE PASS"

        if not (receptum ≡ "") {
            var string contentum ← "qwen36-35b-inference tokenizer-phase receipt\n"
                + "artifact: " + via + "\n"
                + "bytes: " + (total ↦ string) + "\n"
                + "sha256: " + digest + "\n"
                + "version: " + (m.version ↦ string) + "\n"
                + "alignment: " + (m.concordatio ↦ string) + "\n"
                + "data offset: " + (m.data_inceptum ↦ string) + "\n"
                + "metadata: " + (m.metadata.length() ↦ string) + "\n"
                + "tensors: " + (m.tensors.length() ↦ string) + "\n"
                + "architecture: " + architecture + "\n"
                + "tokenizer vocab: " + (t.multitudo ↦ string) + "\n"
                + "Probe A: " + _repr_ids(ids_a) + "\n"
                + "Probe B: " + _repr_ids(ids_b) + "\n"
                + "Probe A decode: " + dec_a + "\n"
                + "Probe B decode: " + dec_b + "\n"
                + "result: PASS\n"
                + "reserved flags (--prompt/--max-new-tokens/--seed) are not implemented by the tokenizer phase\n"
            solum.write_file(receptum, contentum)
            print "RECEIPT " + receptum
        }
    }
    catch err {
        panic "capstone run failed: " + causa(err)
    }
}
