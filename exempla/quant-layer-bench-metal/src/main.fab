+++ toml
locale = "en"

+++ faber
# quant-layer-bench-metal: end-to-end 4-bit GroupAffine quantized transformer layer
# decode step on Metal (D=2048, QD=2048, KVD=512, H=16, KVH=4, DH=128, F=5632,
# C=256, group_size=64, KParts=16).
#
#   faber run exempla/quant-layer-bench-metal --library-home <gradus parent> --device metal

import from "gradus:decode_step" let ds
import from "gradus:quant/group_affine" let ga
import from "norma:time" let time

const int CALLS_PER_PASS = 32
const int PASSES = 6
const int D = 2048
const int KVD = 512
const int F = 5632
const int GROUP_SIZE = 64

@ public
kernel synth_f32_vec<size N>(tensor<f32, [N]> dom, mut tensor<f32, [N]> out, i32 seed, f32 amp) → void {
    for from dom at [i] thread lane let ? {
        let i32 ii ← i ↦ i32
        if ii ≥ 0 and ii ≤ 65536 and seed ≥ 0 and seed ≤ 65536 {
            let i32 a ← (ii * 19 + seed) % 65521
            let f32 h ← ((a ↦ f32) + 0.5) * 0.7123
            out[[i]] ← h.sin() * amp
        }
    }
}

@ public
kernel synth_f32_mat<size R, size C>(tensor<f32, [R, C]> dom, mut tensor<f32, [R, C]> out, i32 seed, f32 amp) → void {
    for from dom at [r, c] thread lane let ? {
        let i32 rr ← r ↦ i32
        let i32 cc ← c ↦ i32
        if rr ≥ 0 and rr ≤ 65536 and cc ≥ 0 and cc ≤ 65536 and seed ≥ 0 and seed ≤ 65536 {
            let i32 a ← (rr * 31 + cc * 17 + seed) % 65521
            let f32 h ← ((a ↦ f32) + 0.5) * 0.7123
            out[[r, c]] ← h.sin() * amp
        }
    }
}

@ public
kernel synth_u32_mat<size R, size C>(tensor<u32, [R, C]> dom, mut tensor<u32, [R, C]> out, i32 seed) → void {
    for from dom at [r, c] thread lane let ? {
        let i32 rr ← r ↦ i32
        let i32 cc ← c ↦ i32
        if rr ≥ 0 and rr ≤ 65536 and cc ≥ 0 and cc ≤ 65536 and seed ≥ 0 and seed ≤ 65536 {
            let i32 v ← (rr * 131 + cc * 17 + seed) % 32767
            let i32 packed ← v * 65537
            out[[r, c]] ← packed ↦ u32 ⊥ (0 ∷ u32)
        }
    }
}

fn ref_row_u32_4bit<size Out, size PIn, size Grp, size In>(tensor<u32, [Out, PIn]> w, tensor<f32, [Out, Grp]> s, tensor<f32, [Out, Grp]> b, tensor<f32, [In]> x, int row, int in_dim, int gs) → f32 {
    mut f32 acc ← 0.0
    for range 0 ‥ in_dim let j {
        let int g ← j / gs
        let u32 word ← w[[row, j / 8]]
        let int shift ← (j % 8) * 4
        let u32 q ← (word ⇒ (shift ↦ u32 ⊥ (0 ∷ u32))) ∧ (15 ∷ u32)
        let f32 wv ← (q ↦ f32) * s[[row, g]] + b[[row, g]]
        acc ← acc + wv * x[[j]]
    }
    return acc
}

main {
    mut tensor<f32, [1]> sink ← tf32[1] {}

    # Inputs & norms
    let tensor<f32, [2048]> d2048 ← tf32[2048] {}
    mut tensor<f32, [2048]> hin ← tf32[2048] {}
    mut tensor<f32, [2048]> hout ← tf32[2048] {}
    mut tensor<f32, [2048]> anorm ← tf32[2048] {}
    mut tensor<f32, [2048]> fnorm ← tf32[2048] {}
    synth_f32_vec(d2048, mut hin, 11 ∷ i32, 0.25 ∷ f32)
    synth_f32_vec(d2048, mut anorm, 13 ∷ i32, 1.0 ∷ f32)
    synth_f32_vec(d2048, mut fnorm, 17 ∷ i32, 1.0 ∷ f32)

    # Scratch
    mut tensor<f32, [2048]> xn ← tf32[2048] {}
    mut tensor<f32, [2048]> q ← tf32[2048] {}
    mut tensor<f32, [2048]> qr ← tf32[2048] {}
    mut tensor<f32, [512]> k ← tf32[512] {}
    mut tensor<f32, [512]> kr ← tf32[512] {}
    mut tensor<f32, [512]> v ← tf32[512] {}
    mut tensor<f32, [2048]> ctx ← tf32[2048] {}
    mut tensor<f32, [2048]> xo ← tf32[2048] {}
    mut tensor<f32, [2048]> h1 ← tf32[2048] {}
    mut tensor<f32, [5632]> gate ← tf32[5632] {}
    mut tensor<f32, [5632]> up ← tf32[5632] {}
    mut tensor<f32, [5632]> act ← tf32[5632] {}
    let tensor<f32, [16, 256]> hcdom ← tf32[16, 256] {}
    let tensor<f32, [2048]> qdom ← tf32[2048] {}
    mut tensor<f32, [16, 256]> sc ← tf32[16, 256] {}
    mut tensor<f32, [16, 256]> pr ← tf32[16, 256] {}
    mut tensor<f32, [256, 512]> k_cache ← tf32[256, 512] {}
    mut tensor<f32, [256, 512]> v_cache ← tf32[256, 512] {}
    mut tensor<f32, [2048, 16]> p2048 ← tf32[2048, 16] {}
    mut tensor<f32, [512, 16]> p512 ← tf32[512, 16] {}
    mut tensor<f32, [5632, 16]> p5632 ← tf32[5632, 16] {}

    ds.prime1(hout, mut sink)
    ds.prime1(xn, mut sink)
    ds.prime1(q, mut sink)
    ds.prime1(qr, mut sink)
    ds.prime1(k, mut sink)
    ds.prime1(kr, mut sink)
    ds.prime1(v, mut sink)
    ds.prime1(ctx, mut sink)
    ds.prime1(xo, mut sink)
    ds.prime1(h1, mut sink)
    ds.prime1(gate, mut sink)
    ds.prime1(up, mut sink)
    ds.prime1(act, mut sink)
    ds.prime2(sc, mut sink)
    ds.prime2(pr, mut sink)
    ds.prime2(k_cache, mut sink)
    ds.prime2(v_cache, mut sink)
    ds.prime2(p2048, mut sink)
    ds.prime2(p512, mut sink)
    ds.prime2(p5632, mut sink)

    # 4-bit GroupAffine weights (group_size=64)
    let tensor<u32, [2048, 256]> du_2048 ← tu32[2048, 256] {}
    let tensor<f32, [2048, 32]> ds_2048 ← tf32[2048, 32] {}
    mut tensor<u32, [2048, 256]> wq ← tu32[2048, 256] {}
    mut tensor<f32, [2048, 32]> sq ← tf32[2048, 32] {}
    mut tensor<f32, [2048, 32]> bq ← tf32[2048, 32] {}
    mut tensor<u32, [2048, 256]> wo ← tu32[2048, 256] {}
    mut tensor<f32, [2048, 32]> so ← tf32[2048, 32] {}
    mut tensor<f32, [2048, 32]> bo ← tf32[2048, 32] {}
    synth_u32_mat(du_2048, mut wq, 19 ∷ i32)
    synth_f32_mat(ds_2048, mut sq, 23 ∷ i32, 0.01 ∷ f32)
    synth_f32_mat(ds_2048, mut bq, 29 ∷ i32, 0.005 ∷ f32)
    synth_u32_mat(du_2048, mut wo, 31 ∷ i32)
    synth_f32_mat(ds_2048, mut so, 37 ∷ i32, 0.01 ∷ f32)
    synth_f32_mat(ds_2048, mut bo, 41 ∷ i32, 0.005 ∷ f32)

    let tensor<u32, [512, 256]> du_512 ← tu32[512, 256] {}
    let tensor<f32, [512, 32]> ds_512 ← tf32[512, 32] {}
    mut tensor<u32, [512, 256]> wk ← tu32[512, 256] {}
    mut tensor<f32, [512, 32]> sk ← tf32[512, 32] {}
    mut tensor<f32, [512, 32]> bk ← tf32[512, 32] {}
    mut tensor<u32, [512, 256]> wv ← tu32[512, 256] {}
    mut tensor<f32, [512, 32]> sv ← tf32[512, 32] {}
    mut tensor<f32, [512, 32]> bv ← tf32[512, 32] {}
    synth_u32_mat(du_512, mut wk, 43 ∷ i32)
    synth_f32_mat(ds_512, mut sk, 47 ∷ i32, 0.01 ∷ f32)
    synth_f32_mat(ds_512, mut bk, 53 ∷ i32, 0.005 ∷ f32)
    synth_u32_mat(du_512, mut wv, 59 ∷ i32)
    synth_f32_mat(ds_512, mut sv, 61 ∷ i32, 0.01 ∷ f32)
    synth_f32_mat(ds_512, mut bv, 67 ∷ i32, 0.005 ∷ f32)

    let tensor<u32, [5632, 256]> du_5632 ← tu32[5632, 256] {}
    let tensor<f32, [5632, 32]> ds_5632 ← tf32[5632, 32] {}
    mut tensor<u32, [5632, 256]> wg ← tu32[5632, 256] {}
    mut tensor<f32, [5632, 32]> sg ← tf32[5632, 32] {}
    mut tensor<f32, [5632, 32]> bg ← tf32[5632, 32] {}
    mut tensor<u32, [5632, 256]> wu ← tu32[5632, 256] {}
    mut tensor<f32, [5632, 32]> su ← tf32[5632, 32] {}
    mut tensor<f32, [5632, 32]> bu ← tf32[5632, 32] {}
    synth_u32_mat(du_5632, mut wg, 71 ∷ i32)
    synth_f32_mat(ds_5632, mut sg, 73 ∷ i32, 0.01 ∷ f32)
    synth_f32_mat(ds_5632, mut bg, 79 ∷ i32, 0.005 ∷ f32)
    synth_u32_mat(du_5632, mut wu, 83 ∷ i32)
    synth_f32_mat(ds_5632, mut su, 89 ∷ i32, 0.01 ∷ f32)
    synth_f32_mat(ds_5632, mut bu, 97 ∷ i32, 0.005 ∷ f32)

    let tensor<u32, [2048, 704]> du_d ← tu32[2048, 704] {}
    let tensor<f32, [2048, 88]> ds_d ← tf32[2048, 88] {}
    mut tensor<u32, [2048, 704]> wd ← tu32[2048, 704] {}
    mut tensor<f32, [2048, 88]> sd ← tf32[2048, 88] {}
    mut tensor<f32, [2048, 88]> bd ← tf32[2048, 88] {}
    synth_u32_mat(du_d, mut wd, 101 ∷ i32)
    synth_f32_mat(ds_d, mut sd, 103 ∷ i32, 0.005 ∷ f32)
    synth_f32_mat(ds_d, mut bd, 107 ∷ i32, 0.002 ∷ f32)

    let int bytes_layer ← (2048 * 256 * 4 + 2048 * 32 * 8) * 2 + (512 * 256 * 4 + 512 * 32 * 8) * 2 + (5632 * 256 * 4 + 5632 * 32 * 8) * 2 + (2048 * 704 * 4 + 2048 * 88 * 8)

    for exclusive PASSES let pass_no {
        let int started ← time.monotonic()
        for exclusive CALLS_PER_PASS let ? {
            ds.rmsnorm(hin, anorm, mut xn, 0.00001 ∷ f32)
            ga.linear_matvec_4bit_u32_part(wq, sq, bq, xn, mut p2048, 64 ∷ i32)
            ga.linear_matvec_u32_combine(p2048, mut q)
            ga.linear_matvec_4bit_u32_part(wk, sk, bk, xn, mut p512, 64 ∷ i32)
            ga.linear_matvec_u32_combine(p512, mut k)
            ga.linear_matvec_4bit_u32_part(wv, sv, bv, xn, mut p512, 64 ∷ i32)
            ga.linear_matvec_u32_combine(p512, mut v)
            ds.rope_half(q, mut qr, 63 ∷ i32, 128 ∷ i32, 9.21034 ∷ f32)
            ds.rope_half(k, mut kr, 63 ∷ i32, 128 ∷ i32, 9.21034 ∷ f32)
            ds.kv_write_kv(kr, v, mut k_cache, mut v_cache, 63 ∷ i32)
            ds.attn_scores(hcdom, qr, k_cache, mut sc, 63 ∷ i32, 4 ∷ i32, 128 ∷ i32, 0.08838835 ∷ f32)
            ds.row_softmax(sc, mut pr)
            ds.attn_context(qdom, pr, v_cache, mut ctx, 63 ∷ i32, 4 ∷ i32, 128 ∷ i32)
            ga.linear_matvec_4bit_u32_part(wo, so, bo, ctx, mut p2048, 64 ∷ i32)
            ga.linear_matvec_u32_combine(p2048, mut xo)
            ds.residual_add(hin, xo, mut h1)
            ds.rmsnorm(h1, fnorm, mut xn, 0.00001 ∷ f32)
            ga.linear_matvec_4bit_u32_part(wg, sg, bg, xn, mut p5632, 64 ∷ i32)
            ga.linear_matvec_u32_combine(p5632, mut gate)
            ga.linear_matvec_4bit_u32_part(wu, su, bu, xn, mut p5632, 64 ∷ i32)
            ga.linear_matvec_u32_combine(p5632, mut up)
            ds.swiglu(gate, up, mut act)
            ga.linear_matvec_4bit_u32_part(wd, sd, bd, act, mut p2048, 64 ∷ i32)
            ga.linear_matvec_u32_combine(p2048, mut xo)
            ds.residual_add(h1, xo, mut hout)
        }
        let f32 sync_out ← hout[[0]]
        let int elapsed ← time.monotonic() - started
        if pass_no ≡ 1 {
            ds.rmsnorm(hin, anorm, mut xn, 0.00001 ∷ f32)
            ga.linear_matvec_4bit_u32_part(wq, sq, bq, xn, mut p2048, 64 ∷ i32)
            ga.linear_matvec_u32_combine(p2048, mut q)
            mut f32 max_err ← 0.0
            for range 0 ‥ 4 let r {
                let f32 err ← (q[[r]] - ref_row_u32_4bit(wq, sq, bq, xn, r, D, GROUP_SIZE)).abs()
                if err ≻ max_err { max_err ← err }
            }
            print "verify_quant_layer hout0=§0 q_max_err=§1"(sync_out, max_err)
            assert max_err ≺ 0.005
        }
        let int us_per_call ← elapsed / CALLS_PER_PASS / 1000
        let f64 gbps ← ((bytes_layer * CALLS_PER_PASS) ↦ f64) ÷ (elapsed ↦ f64)
        let f64 layer_tok_s ← 1000000000.0 * (CALLS_PER_PASS ↦ f64) ÷ (elapsed ↦ f64)
        let f64 model32_tok_s ← layer_tok_s ÷ 32.0
        print "bench_quant_layer_4bit pass=§0 calls=§1 ns=§2 us_per_call=§3 gbps=§4 layer_tok_s=§5 model32_tok_s=§6"(pass_no, CALLS_PER_PASS, elapsed, us_per_call, gbps, layer_tok_s, model32_tok_s)
    }
}
