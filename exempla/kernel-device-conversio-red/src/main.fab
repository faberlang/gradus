+++
locale = "en"
+++

# FAP-1 red 2 — device `↦` (conversion) rejects in kernel bodies today.
#
# The numeric cast `id ↦ f32` is host-admitted; the kernel carrying it
# passes `faber check` and rejects at Metal device admission with
# CODEGEN001 mir_metal_text_unsupported ("kernel runtime call") — no
# conversion emission arm exists in radix-mir-metal until CTFP-4.

@ kernel
fn cast(tf32[8] a, mut tf32[1] out, u32 id) → void {
    const f32 x ← id ↦ f32
    out[id] ← x
}
