+++ toml
locale = "en"

+++ faber
# Synthetic B=1 Slice A decode runner (CPU / Metal).
# Exercises ModelBundle -> TensorDirectory -> ModelConfig -> GroupAffine 8-bit
# LinearWeight -> ExecutionSchedule -> SessionState -> quantized B=1 decode
# without NumericBlock or F32 weight expansion.

import from "gradus:decode_slice_a" let sa

main {
    let int code ← sa.check_slice_a_admission_code()
    if code ≢ 0 {
        print "slice_a_synthetic: admission failed"
    }
    elif not sa.check_slice_a_rejects_non_8bit() {
        print "slice_a_synthetic: quant guard failed"
    }
    elif not sa.check_slice_a_end_to_end() {
        print "slice_a_synthetic: end_to_end failed"
    }
    else {
        print "slice_a_synthetic: layers=2 tokens=[2, 2, 2] ok"
    }
}
