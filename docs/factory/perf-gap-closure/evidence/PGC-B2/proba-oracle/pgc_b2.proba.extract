+++
locale = "en"
+++

# PGC-B2 isolated proba oracle: the named T=1 decode GEMV / score /
# context / lm_head cases only, extracted verbatim from src/kernel.proba
# (the full package stays blocked by the pre-existing SEM013 at
# src/kernel.proba:598 — the PGC-B3 isolated-package precedent).

import from "gradus:kernel" kernel

test "gea3u3a_decode_gemv_qo_static_f32_shape" {
    var tf32[1,960] input ← empty
    var tf32[960,960] weights ← empty
    var tf32[1,960] output ← empty
    kernel.decode_gemv_qo(input, weights, output)
    assert true

}

test "gea3u3a_decode_gemv_kv_static_f32_shape" {
    var tf32[1,960] input ← empty
    var tf32[960,320] weights ← empty
    var tf32[1,320] output ← empty
    kernel.decode_gemv_kv(input, weights, output)
    assert true

}

test "gea3u3a_decode_gemv_gate_up_static_f32_shape" {
    var tf32[1,960] input ← empty
    var tf32[960,2560] weights ← empty
    var tf32[1,2560] output ← empty
    kernel.decode_gemv_gate_up(input, weights, output)
    assert true

}

test "gea3u3a_decode_gemv_down_static_f32_shape" {
    var tf32[1,2560] input ← empty
    var tf32[2560,960] weights ← empty
    var tf32[1,960] output ← empty
    kernel.decode_gemv_down(input, weights, output)
    assert true

}

test "gea3u3a_decode_score_gemm_static_f32_shape" {
    var tf32[1,64] query ← empty
    var tf32[64,76] key_transposed ← empty
    var tf32[1,76] attention_scale ← empty
    var tf32[1,76] output ← empty
    kernel.decode_score_gemm(query, key_transposed, attention_scale, output)
    assert true

}

test "gea3u3a_decode_context_gemm_static_f32_shape" {
    var tf32[1,76] probabilities ← empty
    var tf32[76,64] values ← empty
    var tf32[1,64] output ← empty
    kernel.decode_context_gemm(probabilities, values, output)
    assert true

}

test "gea3u3c_lm_head_gemv_static_f32_shape" {
    var tf32[1,960] input ← empty
    var tf32[49152,960] embeddings ← empty
    var tf32[1,49152] output ← empty
    kernel.lm_head_gemv(input, embeddings, output)
    assert true

}
