#!/usr/bin/env bash
set -euo pipefail
# NSM-G1: native-Faber gate launcher. The gate logic lives entirely in
# check-factory-goal-status.fab; this entrypoint only runs it on the released
# faber binary (faber/target/debug/faber, 1.6.0-rc.1). The PATH `faber`
# (1.3.0) is never a valid execution surface. FABER_BIN overrides the binary.
#
# `faber script` interprets a single source only when the path is not covered
# by a faber.toml (package routing rejects kernel imports with PKG001), so the
# gate source is staged outside the gradus package before interpretation.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
FABER_BIN="${FABER_BIN:-$(cd "$ROOT/.." && pwd)/faber/target/debug/faber}"
export FABER_BIN
if [[ ! -x "$FABER_BIN" ]]; then
    echo "check-factory-goal-status: released faber binary not found: $FABER_BIN (set FABER_BIN)" >&2
    exit 1
fi
TMP="$(mktemp -d "${TMPDIR:-/tmp}/check-factory-goal-status.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
cp "$ROOT/scripta/check-factory-goal-status.fab" "$TMP/check-factory-goal-status.fab"
if "$FABER_BIN" script "$TMP/check-factory-goal-status.fab" -- "$@"; then
    exit 0
else
    exit $?
fi
