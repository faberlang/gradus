#!/usr/bin/env bash
# PML0-U13 (council C7): Gradus-scoped factory goal-status audit entrypoint.
#
# Thin wrapper over the shared radix audit script (the single status-parser
# source of truth). The audit is hard-bound to radix's own docs/factory by
# default; this wrapper scopes it to gradus's factory root and defaults the
# gate to --fail-on error (0 findings required by PML0 Gate C). All additional
# arguments pass through to audit-factory-goal-status.py (later --fail-on /
# --min-severity arguments win, per argparse store semantics).
#
# Selection rationale: pml0-audit-entrypoint.md (PML0-U13).

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AUDIT="$(cd "$ROOT/.." && pwd)/radix/scripta/audit-factory-goal-status.py"

if [[ ! -f "$AUDIT" ]]; then
  echo "check-factory-goal-status: shared audit script not found: $AUDIT" >&2
  echo "check-factory-goal-status: expected sibling repo checkout (../radix) matching this container layout" >&2
  exit 1
fi

exec python3 "$AUDIT" --factory-root "$ROOT/docs/factory" --fail-on error "$@"
