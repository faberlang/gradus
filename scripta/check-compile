#!/usr/bin/env bash
set -euo pipefail
# Structural compile gate for the Gradus package and its consumer exempla.
# Keep this launcher on the package-aware `faber check` route. The native-Faber
# script migration is not a supported execution surface for current Radix:
# kernel imports in a staged single-file script are rejected with PKG001.
# FABER_BIN overrides the lane-local binary; the PATH `faber` is not used.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
# The directory holding the gradus checkout (`<home>/gradus/src`); Norma is
# embedded in the binary. A stale `norma/` checkout beside `gradus/` shadows the
# embedded Norma, so point LIBRARY_HOME at a directory holding only a gradus
# link while such a checkout exists.
LIBRARY_HOME="${LIBRARY_HOME:-$(cd "$ROOT/.." && pwd)}"
FABER_BIN="${FABER_BIN:-$(cd "$ROOT/.." && pwd)/radix/target/debug/faber}"
export FABER_BIN
if [[ ! -x "$FABER_BIN" ]]; then
    echo "check-compile: faber binary not found: $FABER_BIN (set FABER_BIN)" >&2
    exit 1
fi

echo "check-compile: LIBRARY_HOME=$LIBRARY_HOME"
echo "check-compile: checking gradus library source..."
if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$ROOT" 2>&1; then
    echo "check-compile: FAILED — faber check on gradus library source" >&2
    exit 1
fi

if [[ -d "$ROOT/exempla/gradient-seam" ]]; then
    echo "check-compile: checking gradient-seam consumer fixture..."
    if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$ROOT/exempla/gradient-seam" 2>&1; then
        echo "check-compile: FAILED — faber check on gradient-seam consumer" >&2
        exit 1
    fi
fi

if [[ -d "$ROOT/exempla/training-loop-mlp" ]]; then
    echo "check-compile: checking training-loop-mlp composed-loop exemplum..."
    if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$ROOT/exempla/training-loop-mlp" 2>&1; then
        echo "check-compile: FAILED — faber check on training-loop-mlp exemplum" >&2
        exit 1
    fi
fi

if [[ -d "$ROOT/exempla/token-generation" ]]; then
    echo "check-compile: checking token-generation bounded-run exemplum..."
    if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$ROOT/exempla/token-generation" 2>&1; then
        echo "check-compile: FAILED — faber check on token-generation exemplum" >&2
        exit 1
    fi
fi

if [[ -d "$ROOT/exempla/generate-route" ]]; then
    echo "check-compile: checking generate-route public generate exemplum..."
    if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$ROOT/exempla/generate-route" 2>&1; then
        echo "check-compile: FAILED — faber check on generate-route exemplum" >&2
        exit 1
    fi
fi

if [[ -d "$ROOT/exempla/gguf-manifest" ]]; then
    echo "check-compile: checking gguf-manifest parser proof exemplum..."
    if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$ROOT/exempla/gguf-manifest" 2>&1; then
        echo "check-compile: FAILED — faber check on gguf-manifest exemplum" >&2
        exit 1
    fi
fi

if [[ -d "$ROOT/exempla/gguf-inspect" ]]; then
    echo "check-compile: checking gguf-inspect range-source exemplum..."
    if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$ROOT/exempla/gguf-inspect" 2>&1; then
        echo "check-compile: FAILED — faber check on gguf-inspect exemplum" >&2
        exit 1
    fi
fi

if [[ -d "$ROOT/exempla/gguf-materialize" ]]; then
    echo "check-compile: checking gguf-materialize packed-storage exemplum..."
    if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$ROOT/exempla/gguf-materialize" 2>&1; then
        echo "check-compile: FAILED — faber check on gguf-materialize exemplum" >&2
        exit 1
    fi
fi

if [[ -d "$ROOT/exempla/qwen36-35b-inference" ]]; then
    echo "check-compile: checking qwen36-35b-inference capstone exemplum..."
    if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$ROOT/exempla/qwen36-35b-inference" 2>&1; then
        echo "check-compile: FAILED — faber check on qwen36-35b-inference exemplum" >&2
        exit 1
    fi
fi

if [[ -d "$ROOT/exempla/gguf-admit-qwen35moe" ]]; then
    echo "check-compile: checking gguf-admit-qwen35moe admission exemplum..."
    if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$ROOT/exempla/gguf-admit-qwen35moe" 2>&1; then
        echo "check-compile: FAILED — faber check on gguf-admit-qwen35moe exemplum" >&2
        exit 1
    fi
fi

if [[ -d "$ROOT/exempla/moe-probe" ]]; then
    echo "check-compile: checking moe-probe real-file MoE exemplum..."
    if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$ROOT/exempla/moe-probe" 2>&1; then
        echo "check-compile: FAILED — faber check on moe-probe exemplum" >&2
        exit 1
    fi
fi

if [[ -d "$ROOT/exempla/qwen35moe-layer-probe" ]]; then
    echo "check-compile: checking qwen35moe-layer-probe state exemplum..."
    if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$ROOT/exempla/qwen35moe-layer-probe" 2>&1; then
        echo "check-compile: FAILED — faber check on qwen35moe-layer-probe exemplum" >&2
        exit 1
    fi
fi

for gen in gguf safetensors; do
    src="$ROOT/fixtures/$gen/gen_fixture.fab"
    echo "check-compile: checking $gen fixture generator..."
    if ! "$FABER_BIN" check --library-home "$LIBRARY_HOME" "$src" 2>&1; then
        echo "check-compile: FAILED — faber check on $gen fixture generator" >&2
        exit 1
    fi
    echo "check-compile: regenerating $gen fixture and comparing to the committed bytes..."
    gen_out="$(mktemp -d "${TMPDIR:-/tmp}/check-compile-$gen.XXXXXX")"
    if ! "$FABER_BIN" run --library-home "$LIBRARY_HOME" "$src" -- "$ROOT" "$gen_out" >/dev/null 2>&1; then
        rm -rf "$gen_out"
        echo "check-compile: FAILED — fixture generator $gen did not run" >&2
        exit 1
    fi
    for out in "$gen_out"/*; do
        if ! cmp -s "$out" "$ROOT/fixtures/$gen/$(basename "$out")"; then
            rm -rf "$gen_out"
            echo "check-compile: FAILED — regenerated $(basename "$out") differs from the committed fixture" >&2
            exit 1
        fi
    done
    rm -rf "$gen_out"
done

echo "check-compile: ok"
