#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

python3 - "$ROOT/src" "$@" <<'PY'
import re
import sys
from pathlib import Path

source_root = Path(sys.argv[1])
self_test = "--self-test" in sys.argv[2:]

# These are model-shape facts admitted by fixtures/configuration, not stable
# geometry in the device-kernel library. Decode's literal one is the one
# structural extent explicitly retained by the clean-break contract. The
# shape-generic-device-route goal owns src/kernel.fab; the older fixed-shape
# training kernels in other source files belong to their separate clean-break
# work and are intentionally outside this ratchet.
FORBIDDEN_GEOMETRY = {5, 8, 15, 32, 36, 64, 76, 320, 960, 2560, 49152}
KERNEL = re.compile(r"^\s*@\s*kernel\b")
FUNCTION = re.compile(r"^\s*fn\s+[A-Za-z_][A-Za-z0-9_]*\b")
NUMBER = re.compile(r"\b(\d+)\b")


def kernel_signatures(text: str):
    lines = text.splitlines()
    signatures = []
    pending_line = None
    index = 0
    while index < len(lines):
        raw = lines[index]
        code = raw.split("#", 1)[0]
        if KERNEL.match(code):
            pending_line = index + 1
            index += 1
            continue
        if pending_line is None:
            index += 1
            continue
        stripped = code.strip()
        if not stripped or stripped.startswith("@"):
            index += 1
            continue
        if not FUNCTION.match(code):
            pending_line = None
            index += 1
            continue

        start = pending_line
        parts = []
        while index < len(lines):
            part = lines[index].split("#", 1)[0]
            parts.append(part)
            if "{" in part:
                break
            index += 1
        signature = "\n".join(parts).split("{", 1)[0]
        signatures.append((start, signature))
        pending_line = None
        index += 1
    return signatures


def violations(path: Path):
    failures = []
    text = path.read_text(encoding="utf-8")
    for line, signature in kernel_signatures(text):
        for match in NUMBER.finditer(signature):
            value = int(match.group(1))
            if value in FORBIDDEN_GEOMETRY:
                failures.append(f"{path}:{line}: kernel signature contains model geometry {value}")
    return failures


def signature_violations(signature: str):
    return [
        int(match.group(1))
        for match in NUMBER.finditer(signature)
        if int(match.group(1)) in FORBIDDEN_GEOMETRY
    ]


if self_test:
    # The generic probe is only used to exercise parsing. The statue probe is
    # checked by the same numeric detector used for real source files.
    generic_signature = kernel_signatures(
        "@ kernel\nfn good<size D>(tensor<f32, [1, D]> input) → void {\n}\n"
    )
    if not generic_signature or any(
        signature_violations(signature) for _, signature in generic_signature
    ):
        raise AssertionError("generic probe unexpectedly failed")
    statue_signature = kernel_signatures(
        "@ kernel\nfn bad(tensor<f32, [1, 960]> input) → void {\n}\n"
    )
    if not statue_signature or not any(
        signature_violations(signature) for _, signature in statue_signature
    ):
        raise AssertionError("statue probe did not trigger")
    print("check-shape-generic-kernels: self-test ok", file=sys.stderr)

files = [source_root / "kernel.fab"]
if not files[0].is_file():
    print(f"check-shape-generic-kernels: missing {files[0]}", file=sys.stderr)
    raise SystemExit(1)
failures = [failure for path in files for failure in violations(path)]
if failures:
    print("check-shape-generic-kernels: forbidden model geometry:", file=sys.stderr)
    print("\n".join(failures), file=sys.stderr)
    raise SystemExit(1)
print(f"check-shape-generic-kernels: ok ({len(files)} Faber files)")
PY
