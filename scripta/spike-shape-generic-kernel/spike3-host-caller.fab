+++
locale = "en"
+++

# Spike 3 probe — a HOST caller instantiating the annotated size-generic
# math.add from the library tree. Red: `metal-text requires at least one
# @ nucleum function` — the imported, monomorphized instance never registers
# as a kernel entry of the compiling unit. Run with the annotation restored
# on gradus/src/math.fab `add`, then:
#   faber build -t metal-text spike3-host-caller.fab

import from "gradus:math" math

fn main() → void {
    const list<f32> flat_a ← [1.0, 2.0, 3.0, 4.0]
    const list<f32> flat_b ← [10.0, 20.0, 30.0, 40.0]
    do {
        const _ a ← flat_a ↦ tensor<f32, [2, 2]>
        const _ b ← flat_b ↦ tensor<f32, [2, 2]>
        const _ r ← math.add(a, b)
        print "ok"
    }
    catch err {
        print err
    }
}
