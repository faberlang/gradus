+++
locale = "en"
+++

# Spike 2 probe (control, GREEN) — a locally-defined size-generic @ kernel
# entry monomorphized by a host caller in the SAME unit. Emits concrete
# Metal (sizes baked at the instantiation). Proves the generic signature
# itself is admissible once an instance def exists in the compiling unit:
#   faber build -t metal-text spike2-local-generic.fab

@ kernel
@ public
fn kadd<size M, size N>(tensor<f32, [M, N]> a, tensor<f32, [M, N]> b) → tensor<f32, [M, N]> {
    return a + b
}

fn main() → void {
    const tensor<f32, []> seed ← empty
    const _ a ← seed.from_flat([1.0, 2.0, 3.0, 4.0], [2, 2])
    const _ b ← seed.from_flat([10.0, 20.0, 30.0, 40.0], [2, 2])
    const _ r ← kadd(a, b)
    print "ok"
}
