+++
locale = "en"
+++

# Spike 1 probe — a concrete @ kernel entry whose body calls the (spike-time)
# annotated size-generic math.add. Red: `kernel runtime call` (device-safe
# gate: kernel bodies may not call other functions). Run with:
#   faber build -t metal-text spike1-kernel-caller.fab

import from "gradus:math" math

@ kernel
@ public
fn probe_add(tensor<f32, [4, 8]> a, tensor<f32, [4, 8]> b) → tensor<f32, [4, 8]> {
    return math.add(a, b)
}
