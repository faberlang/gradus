+++
locale = "en"
+++

# gradus/scripta/check-factory-goal-status.fab — native-Faber gate (NSM-G1
# conversion of the former bash scripta/check-factory-goal-status).
#
# Delegates to the shared radix audit script via `captura` and propagates its
# exit code, preserving the original shell gate's argv and exit-code contract.
# All additional arguments pass through to audit-factory-goal-status.py (later
# --fail-on / --min-severity arguments win, per argparse store semantics).

importa ex "faber:solum" solum
importa ex "faber:processus" processus

# Resolve the gradus repository root: FABER_LIBRARY_HOME when set, else the
# workspace layout probed from the current directory (workspace-root or
# gradus-root invocation).
functio gradus_root() → textus {
    fixum textus home ← processus.exsequi("printf %s \"${FABER_LIBRARY_HOME:-}\"") ↦ textus
    si home.longitudo() ↦ numerus > 0 {
        fixum textus from_home ← solum.iunge([home, "gradus"]) ↦ textus
        si solum.exstat(solum.iunge([from_home, "src"]) ↦ textus) ↦ bivalens {
            redde solum.absolve(from_home) ↦ textus
        }
    }
    fixum textus cwd ← processus.sedes() ↦ textus
    si solum.exstat(solum.iunge([cwd, "gradus", "src"]) ↦ textus) ↦ bivalens {
        redde solum.absolve(solum.iunge([cwd, "gradus"]) ↦ textus) ↦ textus
    }
    si solum.exstat(solum.iunge([cwd, "src"]) ↦ textus) ↦ bivalens {
        redde solum.absolve(cwd) ↦ textus
    }
    mori "check-factory-goal-status: cannot resolve the gradus root (set FABER_LIBRARY_HOME or run from the faberlang workspace)"
}

incipit {
    fixum textus root ← gradus_root()
    fixum textus audit ← solum.iunge([solum.parens(root) ↦ textus, "radix", "scripta", "audit-factory-goal-status.py"]) ↦ textus
    si solum.exstat(audit) ↦ bivalens ≡ falsum {
        nota "check-factory-goal-status: shared audit script not found: §"(audit)
        nota "check-factory-goal-status: expected sibling repo checkout (../radix) matching this container layout"
        processus.exi(1)
    }
    fixum textus factory_root ← solum.iunge([root, "docs", "factory"]) ↦ textus
    fixum lista<textus> argv ← ["python3", audit, "--factory-root", factory_root, "--fail-on", "error"]
    fixum lista<textus> extra ← processus.argumenta() ↦ lista<textus>
    itera ex extra fixum item {
        argv.appende(item)
    }
    fixum tabula<textus, valor> result ← processus.captura(argv) ↦ tabula<textus, valor>
    fixum textus out ← result["stdout"] ↦ textus
    fixum textus err ← result["stderr"] ↦ textus
    si out.longitudo() ↦ numerus > 0 {
        nota out
    }
    si err.longitudo() ↦ numerus > 0 {
        nota err
    }
    processus.exi(result["status"] ↦ numerus)
}
