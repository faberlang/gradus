+++
locale = "en"
+++

# gradus/scripta/check-factory-goal-status.fab — native-Faber gate (NSM-G1
# conversion of the former bash scripta/check-factory-goal-status).
#
# Delegates to the shared radix audit script via `captura` and propagates its
# exit code, preserving the original shell gate's argv and exit-code contract.
# All additional arguments pass through to audit-factory-goal-status.py (later
# --fail-on / --min-severity arguments win, per argparse store semantics).

import from "faber:solum" solum
import from "faber:processus" processus

# Resolve the gradus repository root: FABER_LIBRARY_HOME when set, else the
# workspace layout probed from the current directory (workspace-root or
# gradus-root invocation).
fn gradus_root() → string {
    const string home ← processus.exec("printf %s \"${FABER_LIBRARY_HOME:-}\"") ↦ string
    if home.length() ↦ int > 0 {
        const string from_home ← solum.join([home, "gradus"]) ↦ string
        if solum.exists(solum.join([from_home, "src"]) ↦ string) ↦ bool {
            return solum.resolve(from_home) ↦ string
        }
    }
    const string cwd ← processus.cwd() ↦ string
    if solum.exists(solum.join([cwd, "gradus", "src"]) ↦ string) ↦ bool {
        return solum.resolve(solum.join([cwd, "gradus"]) ↦ string) ↦ string
    }
    if solum.exists(solum.join([cwd, "src"]) ↦ string) ↦ bool {
        return solum.resolve(cwd) ↦ string
    }
    panic "check-factory-goal-status: cannot resolve the gradus root (set FABER_LIBRARY_HOME or run from the faberlang workspace)"
}

main {
    const string root ← gradus_root()
    const string audit ← solum.join([solum.parent(root) ↦ string, "radix", "scripta", "audit-factory-goal-status.py"]) ↦ string
    if solum.exists(audit) ↦ bool is false {
        print "check-factory-goal-status: shared audit script not found: §"(audit)
        print "check-factory-goal-status: expected sibling repo checkout (../radix) matching this container layout"
        processus.exit_process(1)
    }
    const string factory_root ← solum.join([root, "docs", "factory"]) ↦ string
    const list<string> argv ← ["python3", audit, "--factory-root", factory_root, "--fail-on", "error"]
    const list<string> extra ← processus.argv() ↦ list<string>
    for from extra const item {
        argv.append(item)
    }
    const map<string, value> result ← processus.captura(argv) ↦ map<string, value>
    const string out ← result["stdout"] ↦ string
    const string err ← result["stderr"] ↦ string
    if out.length() ↦ int > 0 {
        print out
    }
    if err.length() ↦ int > 0 {
        print err
    }
    processus.exit_process(result["status"] ↦ int)
}
