#!/usr/bin/env bash
set -euo pipefail
# Bench harness launcher (bench-harness delivery GB-U1/GB-U3): pin-and-build
# driver + bench run loop. Subcommands and laws live in scripta/bench.py —
# materialize (detached worktrees of radix/hosts/gradus at pinned hashes into
# a scratch root outside all repos), build (release faber from the pinned
# radix, own target dir), run (3 warmups / 10 samples per bench-manifest
# case; checker-format JSON with environment-identity metadata; runtime caps
# as safety circuit breakers only), clean (worktree remove --force + prune
# per source repo, scratch-root removal, registration-free verified).
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec python3 "$ROOT/scripta/bench.py" "$@"
