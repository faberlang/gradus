#!/usr/bin/env bash
set -euo pipefail
# Bench harness launcher (bench-harness delivery GB-U1/GB-U3/GB-U3b/
# GB-U3c): pin-and-build driver + bench run loop + stage ladder +
# per-row power-state capture. Subcommands and laws live in
# scripta/bench.py — materialize (detached worktrees of
# radix/hosts/gradus at pinned hashes into a scratch root outside all
# repos), build (release faber from the pinned radix, own target dir),
# run (four-stage ladder, goal §Stage ladder: `--stage smoke|dev|rough|
# full` ≡ 1-4, `--full` alias, repeatable `--label` subsets at the
# selected stage's sampling; default = stage 2 dev; stage full is the
# byte-preserved 3-warmup/10-sample all-label protocol, the only
# gate-comparable shape; checker-format JSON with environment-identity
# metadata plus additive per-row `power_state` on every result row and
# the `metadata.power_class` run summary — unanimous row class else
# mixed with first/last, ruling ea4dd0a3; runtime caps as safety
# circuit breakers only), clean
# (worktree remove --force + prune per source repo, scratch-root removal,
# registration-free verified).
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec python3 "$ROOT/scripta/bench.py" "$@"
