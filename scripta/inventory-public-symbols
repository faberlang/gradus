#!/usr/bin/env bash
set -euo pipefail

# Public symbol inventory for gradus (grep-based; no cargo). Counts `fn `
# declaration lines per live src/*.fab module — scanning recursively so every
# model leaf is covered — prints the module -> fn table plus the live
# no-latin baseline:
#   * per-module counts for every live module on the final English identifier
#     surface;
#   * the tracked total == 977 (live all-module declaration count; every
#     module is asserted, so there is no untracked remainder);
#   * the committed coverage gate: every public `fn` name (non-`_` prefix —
#     `_`-prefixed names are module-internal helpers) in every module appears
#     in docs/api-reference.md under that module's section, so no shipped
#     public symbol is undocumented.
# The baseline is re-read from the live tree at U8 (U7 regenerated
# api-reference.md). It is a declaration count plus coverage gate, not a
# pre-S2 identifier map.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$ROOT/src"
AREF="$ROOT/docs/api-reference.md"

if [[ ! -d "$SRC" ]]; then
  echo "inventory-public-symbols: missing src directory: $SRC" >&2
  exit 1
fi

if [[ ! -f "$AREF" ]]; then
  echo "inventory-public-symbols: missing docs/api-reference.md: $AREF" >&2
  exit 1
fi

# Live declaration baseline. Re-baselined 2026-08-20 from the live tree
# after OE-G (350795b, 2026-08-19) deleted five private endian readers.
# The `grep -c 'fn '` count is 977. Names are checked by the committed
# API coverage gate, not inherited from the pre-S2 map.
tracked_total=977

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# Collect "module count" rows, sorted by module name. The module name is the
# path relative to src (model sub-leaves read model/artifact, model/capsule,
# model/dequant, model/gguf, model/gguf_manifest, model/safetensors), which
# keeps the recursive scan
# deterministic.
while IFS= read -r -d '' file; do
  module="${file#"$SRC"/}"
  module="${module%.fab}"
  count="$(grep -c 'fn ' "$file" || true)"
  printf '%s %s\n' "$module" "$count" >> "$tmp"
done < <(find "$SRC" -name '*.fab' -print0 | sort -z)

total="$(awk '{s += $2} END {print s + 0}' "$tmp")"

printf '%-16s %s\n' "module" "fn"
while read -r module count; do
  printf '%-16s %s\n' "$module" "$count"
done < "$tmp"
printf '%-16s %s\n' "TOTAL" "$total"

status=0

# Assert per-module baseline counts for every live module.
while read -r module count; do
  case "$module" in
    attention)         expect=47 ;;
    cache)             expect=120 ;;
    calibration)       expect=61 ;;
    data)              expect=0 ;;
    decode)            expect=53 ;;
    dtype)             expect=15 ;;
    generation)        expect=50 ;;
    gradient)          expect=16 ;;
    gradus)            expect=7 ;;
    loss)              expect=11 ;;
    # 2026-08-20: 24→25, F5 concatenate _shape_dim
    math)              expect=25 ;;
    metrics)           expect=7 ;;
    model/artifact)    expect=4 ;;
    model/capsule)     expect=45 ;;
    model/dense_llama) expect=6 ;;
    model/dense_qwen2) expect=14 ;;
    model/dense)       expect=20 ;;
    # 2026-08-20: 22→20, OE-G 350795b deleted private _le_u16/_le_u32
    model/dequant)     expect=20 ;;
    model/gguf)        expect=10 ;;
    model/gguf_manifest) expect=49 ;;
    model/qwen35moe)   expect=42 ;;
    # 2026-08-20: 23→24, F5 integer-index helper _int_at
    model/safetensors) expect=24 ;;
    model/tensor_payload) expect=1 ;;
    model/tensor_view) expect=7 ;;
    nn)                expect=27 ;;
    optimize)          expect=29 ;;
    parameter)         expect=38 ;;
    sampling)          expect=29 ;;
    # 2026-08-20: 34→32, OE-G 350795b deleted private _be4_read/_be8_read
    serialize)         expect=32 ;;
    shape)             expect=9 ;;
    tensor)            expect=12 ;;
    tokenizer)         expect=81 ;;
    # 2026-08-20: 44→45 live count (prior baseline was stale)
    train)             expect=45 ;;
    transformer)       expect=21 ;;
    *)                 echo "inventory-public-symbols: unknown module $module" >&2; status=1; continue ;;
  esac
  if [[ "$count" -ne "$expect" ]]; then
    echo "inventory-public-symbols: assertion failed — $module expected $expect, got $count" >&2
    status=1
  fi
done < "$tmp"

# Assert the tracked total (== the live all-module count; every module is
# asserted, so tracked and live are the same number).
if [[ "$total" -ne "$tracked_total" ]]; then
  echo "inventory-public-symbols: assertion failed — tracked total expected $tracked_total, got $total" >&2
  status=1
fi

# Committed coverage gate: every public fn name (no `_` prefix) in every
# module must appear in docs/api-reference.md under that module's section.
# `_`-prefixed names are private helpers and are exempt from public coverage;
# the API reference is generated from the final live declaration surface.
cov_fail=0
while IFS= read -r -d '' file; do
  module="${file#"$SRC"/}"
  module="${module%.fab}"
  # Section start: "## gradus:<module>" heading; section end is the next
  # "## gradus:" heading.
  section="$(awk -v m="## gradus:$module" '
    $0 == m { insec=1; next }
    insec && /^## gradus:/ { exit }
    insec { print }
  ' "$AREF")"
  if [[ -z "$section" ]]; then
    echo "inventory-public-symbols: coverage failed — no section for $module in docs/api-reference.md" >&2
    status=1
    cov_fail=1
    continue
  fi
  while IFS= read -r name; do
    if ! grep -qF -- "$name" <<< "$section"; then
      echo "inventory-public-symbols: coverage failed — $module.$name not documented in docs/api-reference.md" >&2
      status=1
      cov_fail=1
    fi
  done < <(grep -oE 'fn [a-z][a-z0-9_]*\(' "$file" | sed 's/fn //; s/(//' | grep -v '^_' | sort -u)
done < <(find "$SRC" -name '*.fab' -print0 | sort -z)

exit "$status"
