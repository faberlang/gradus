#!/usr/bin/env bash
set -euo pipefail

# Public symbol inventory for gradus (grep-based; no cargo). Counts `functio `
# declaration lines per src/*.fab module, prints the module -> functio table
# plus the all-module total, and asserts the PML1 re-baselined baseline:
#   * per-module counts for the seven fixed-shape proof-surface modules
#     (post-U6: optimize 0, transformer 1 — retired helpers are gone);
#   * the tracked proof-surface total == 17 (the seven per-module-asserted
#     modules sum to 17; the printed TOTAL row is the live all-module count,
#     which includes the foundation modules dtype/math/parameter/serialize/
#     shape/tensor that are versioned by their own contract docs).
# Output is deterministic so pml0-symbol-inventory.md can capture it verbatim
# and a fresh run diffs clean against the doc.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$ROOT/src"

if [[ ! -d "$SRC" ]]; then
  echo "inventory-public-symbols: missing src directory: $SRC" >&2
  exit 1
fi

# Proof-surface baseline (post-U6). Zero-count stubs/facade modules and the
# foundation modules are not asserted individually; the tracked total below
# covers the seven fixed-shape modules only.
tracked_total=17

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# Collect "module count" rows, sorted by module name.
while IFS= read -r -d '' file; do
  module="$(basename "$file" .fab)"
  count="$(grep -c 'functio ' "$file" || true)"
  printf '%s %s\n' "$module" "$count" >> "$tmp"
done < <(find "$SRC" -maxdepth 1 -name '*.fab' -print0 | sort -z)

total="$(awk '{s += $2} END {print s + 0}' "$tmp")"

printf '%-14s %s\n' "module" "functio"
while read -r module count; do
  printf '%-14s %s\n' "$module" "$count"
done < "$tmp"
printf '%-14s %s\n' "TOTAL" "$total"

status=0

# Assert per-module baseline counts (the seven fixed-shape proof-surface
# modules).
while read -r module count; do
  case "$module" in
    attention)    expect=1 ;;
    gradient)     expect=2 ;;
    loss)         expect=3 ;;
    nn)           expect=6 ;;
    optimize)     expect=0 ;;
    train)        expect=4 ;;
    transformer)  expect=1 ;;
    *)            continue ;;   # foundation/stub/facade module; tracked total covers the seven only
  esac
  if [[ "$count" -ne "$expect" ]]; then
    echo "inventory-public-symbols: assertion failed — $module expected $expect, got $count" >&2
    status=1
  fi
done < "$tmp"

# Assert the tracked proof-surface total (sum over the seven asserted
# modules). The printed TOTAL row above is the live all-module count.
tracked="$(awk '$1=="attention"||$1=="gradient"||$1=="loss"||$1=="nn"||$1=="optimize"||$1=="train"||$1=="transformer" {s += $2} END {print s + 0}' "$tmp")"
if [[ "$tracked" -ne "$tracked_total" ]]; then
  echo "inventory-public-symbols: assertion failed — tracked proof-surface total expected $tracked_total, got $tracked" >&2
  status=1
fi

exit "$status"
