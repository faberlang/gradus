#!/usr/bin/env bash
set -euo pipefail

# Public symbol inventory for gradus (grep-based; no cargo). Counts `functio `
# declaration lines per src/*.fab module — scanning recursively so the PML2
# model module (src/model/) is covered — prints the module -> functio table
# plus the all-module total, and asserts the re-baselined baseline:
#   * per-module counts for the seven fixed-shape proof-surface modules
#     (post-U6: optimize 0, transformer 1 — retired helpers are gone) and
#     for the PML2 model module's three sub-leaves
#     (model/capsule, model/gguf, model/safetensors);
#   * the tracked total == 133 (proof-surface 17 + model module 116; the
#     printed TOTAL row is the live all-module count, which includes the
#     foundation modules dtype/math/parameter/serialize/shape/tensor that are
#     versioned by their own contract docs).
# Output is deterministic so pml0-symbol-inventory.md can capture it verbatim
# and a fresh run diffs clean against the doc.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$ROOT/src"

if [[ ! -d "$SRC" ]]; then
  echo "inventory-public-symbols: missing src directory: $SRC" >&2
  exit 1
fi

# Tracked baseline (re-baselined 2026-08-09, auditor-2 fire-3 P2-3): the
# seven fixed-shape proof-surface modules (post-U6) plus the PML2 model module
# (src/model/ — capsule/gguf/safetensors sub-leaves). The in-flight tokenizer
# module (hand-5, PML2-U4) is counted in the live TOTAL row but not asserted.
tracked_total=133

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# Collect "module count" rows, sorted by module name. The module name is the
# path relative to src (model sub-leaves read model/capsule, model/gguf,
# model/safetensors), which keeps the recursive scan deterministic.
while IFS= read -r -d '' file; do
  module="${file#"$SRC"/}"
  module="${module%.fab}"
  count="$(grep -c 'functio ' "$file" || true)"
  printf '%s %s\n' "$module" "$count" >> "$tmp"
done < <(find "$SRC" -name '*.fab' -print0 | sort -z)

total="$(awk '{s += $2} END {print s + 0}' "$tmp")"

printf '%-16s %s\n' "module" "functio"
while read -r module count; do
  printf '%-16s %s\n' "$module" "$count"
done < "$tmp"
printf '%-16s %s\n' "TOTAL" "$total"

status=0

# Assert per-module baseline counts (the seven fixed-shape proof-surface
# modules and the PML2 model module's three sub-leaves).
while read -r module count; do
  case "$module" in
    attention)         expect=1 ;;
    gradient)          expect=2 ;;
    loss)              expect=3 ;;
    nn)                expect=6 ;;
    optimize)          expect=0 ;;
    train)             expect=4 ;;
    transformer)       expect=1 ;;
    model/capsule)     expect=79 ;;
    model/gguf)        expect=14 ;;
    model/safetensors) expect=23 ;;
    *)                 continue ;;   # foundation/stub/facade module; tracked total covers the asserted ones only
  esac
  if [[ "$count" -ne "$expect" ]]; then
    echo "inventory-public-symbols: assertion failed — $module expected $expect, got $count" >&2
    status=1
  fi
done < "$tmp"

# Assert the tracked total (the seven proof-surface modules + the model module
# sub-leaves). The printed TOTAL row above is the live all-module count.
tracked="$(awk '$1=="attention"||$1=="gradient"||$1=="loss"||$1=="nn"||$1=="optimize"||$1=="train"||$1=="transformer"||$1=="model/capsule"||$1=="model/gguf"||$1=="model/safetensors" {s += $2} END {print s + 0}' "$tmp")"
if [[ "$tracked" -ne "$tracked_total" ]]; then
  echo "inventory-public-symbols: assertion failed — tracked total expected $tracked_total, got $tracked" >&2
  status=1
fi

exit "$status"
