#!/usr/bin/env bash
set -euo pipefail

# PML0-U2: public symbol inventory for gradus.
# Grep-based (no cargo): counts `functio ` declaration lines per src/*.fab
# module, prints a module -> functio table plus the total, and asserts the
# PML0 baseline (total 21; per-module counts per pml0-delivery.md
# §Repo-Aware Baseline). Output is deterministic so pml0-symbol-inventory.md
# can capture it verbatim and a fresh run diffs clean against the doc.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$ROOT/src"

if [[ ! -d "$SRC" ]]; then
  echo "inventory-public-symbols: missing src directory: $SRC" >&2
  exit 1
fi

# Expected per-module counts (baseline). Zero-count stubs/facade modules
# (math, tensor, data, gradus) are not asserted individually; the total
# assertion below covers them.
expected_total=21

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# Collect "module count" rows, sorted by module name.
while IFS= read -r -d '' file; do
  module="$(basename "$file" .fab)"
  count="$(grep -c 'functio ' "$file" || true)"
  printf '%s %s\n' "$module" "$count" >> "$tmp"
done < <(find "$SRC" -maxdepth 1 -name '*.fab' -print0 | sort -z)

total="$(awk '{s += $2} END {print s + 0}' "$tmp")"

printf '%-14s %s\n' "module" "functio"
while read -r module count; do
  printf '%-14s %s\n' "$module" "$count"
done < "$tmp"
printf '%-14s %s\n' "TOTAL" "$total"

status=0

# Assert per-module baseline counts.
while read -r module count; do
  case "$module" in
    attention)    expect=1 ;;
    gradient)     expect=2 ;;
    loss)         expect=3 ;;
    nn)           expect=6 ;;
    optimize)     expect=2 ;;
    train)        expect=4 ;;
    transformer)  expect=3 ;;
    *)            continue ;;   # zero-count stub/facade module; total covers it
  esac
  if [[ "$count" -ne "$expect" ]]; then
    echo "inventory-public-symbols: assertion failed — $module expected $expect, got $count" >&2
    status=1
  fi
done < "$tmp"

# Assert total.
if [[ "$total" -ne "$expected_total" ]]; then
  echo "inventory-public-symbols: assertion failed — total expected $expected_total, got $total" >&2
  status=1
fi

exit "$status"
