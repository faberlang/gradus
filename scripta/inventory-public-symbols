#!/usr/bin/env bash
set -euo pipefail

# Public symbol inventory for gradus (grep-based; no cargo). Counts `functio `
# declaration lines per src/*.fab module — scanning recursively so the PML2
# model module (src/model/) is covered — prints the module -> functio table
# plus the all-module total, and asserts the re-baselined baseline:
#   * per-module counts for EVERY live module on the post-PML1-5 +
#     correctness-wave surface (29 modules: the PML0/PML1 foundation and
#     proof-surface modules, the PML2 model module's sub-leaves, the
#     PML4 training-layer modules, and the PML5 inference modules);
#   * the tracked total == 648 (the live all-module count; there is no
#     untracked remainder — every module is asserted);
#   * the committed coverage gate: every public `functio` name (non-`_`
#     prefix — `_`-prefixed names are `@ privata` module-internal helpers)
#     in every module appears in docs/api-reference.md under that module's
#     section, so no shipped public symbol is undocumented (zombie-doc
#     gate, PML6-U1).
# Output is deterministic so pml0-symbol-inventory.md can capture it verbatim
# and a fresh run diffs clean against the doc.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$ROOT/src"
AREF="$ROOT/docs/api-reference.md"

if [[ ! -d "$SRC" ]]; then
  echo "inventory-public-symbols: missing src directory: $SRC" >&2
  exit 1
fi

if [[ ! -f "$AREF" ]]; then
  echo "inventory-public-symbols: missing docs/api-reference.md: $AREF" >&2
  exit 1
fi

# Tracked baseline (re-baselined 2026-08-12, GGUF-A1b; re-baselined
# 2026-08-13 for the A1C capsule-schema-2.0.0 surface; re-baselined
# 2026-08-14 for LIB-02-U1; re-baselined 2026-08-14 for GGUF-A3 C2+C3:
# tensor_payload + tensor_view modules, widened dequant + gguf_manifest,
# LIB-02-U2 tokenizer surface; re-baselined 2026-08-14 for the LIB-02-U3/U4
# tokenizer surface: the qwen35 pre-tokenizer scanner + special/EOG/BOS/chat
# policy surface and the two-probe composition; re-baselined 2026-08-14 for
# the REF-01 wave batch 1: the rmsnorm/silu/swiglu nn rows, the configurable
# RoPE attention row, and the dense_llama/dense_qwen2 architecture-adapter
# modules; re-baselined 2026-08-14 for the REF-01 wave batch 2: the
# multi-head GQA attention row (attention 30 → 35) and the generic dense
# transformer-block row (transformer 9 → 13)): every live module.
tracked_total=693

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# Collect "module count" rows, sorted by module name. The module name is the
# path relative to src (model sub-leaves read model/artifact, model/capsule,
# model/dequant, model/gguf, model/gguf_manifest, model/safetensors), which
# keeps the recursive scan
# deterministic.
while IFS= read -r -d '' file; do
  module="${file#"$SRC"/}"
  module="${module%.fab}"
  count="$(grep -c 'functio ' "$file" || true)"
  printf '%s %s\n' "$module" "$count" >> "$tmp"
done < <(find "$SRC" -name '*.fab' -print0 | sort -z)

total="$(awk '{s += $2} END {print s + 0}' "$tmp")"

printf '%-16s %s\n' "module" "functio"
while read -r module count; do
  printf '%-16s %s\n' "$module" "$count"
done < "$tmp"
printf '%-16s %s\n' "TOTAL" "$total"

status=0

# Assert per-module baseline counts for every live module.
while read -r module count; do
  case "$module" in
    attention)         expect=35 ;;
    cache)             expect=37 ;;
    data)              expect=0 ;;
    decode)            expect=46 ;;
    dtype)             expect=14 ;;
    generation)        expect=27 ;;
    gradient)          expect=13 ;;
    gradus)            expect=7 ;;
    loss)              expect=11 ;;
    math)              expect=23 ;;
    metrics)           expect=6 ;;
    model/artifact)    expect=4 ;;
    model/capsule)     expect=45 ;;
    model/dense_llama) expect=6 ;;
    model/dense_qwen2) expect=14 ;;
    model/dequant)     expect=21 ;;
    model/gguf)        expect=10 ;;
    model/gguf_manifest) expect=46 ;;
    model/safetensors) expect=24 ;;
    model/tensor_payload) expect=1 ;;
    model/tensor_view) expect=7 ;;
    nn)                expect=24 ;;
    optimize)          expect=26 ;;
    parameter)         expect=37 ;;
    sampling)          expect=27 ;;
    serialize)         expect=34 ;;
    shape)             expect=9 ;;
    tensor)            expect=11 ;;
    tokenizer)         expect=74 ;;
    train)             expect=41 ;;
    transformer)       expect=13 ;;
    *)                 echo "inventory-public-symbols: unknown module $module" >&2; status=1; continue ;;
  esac
  if [[ "$count" -ne "$expect" ]]; then
    echo "inventory-public-symbols: assertion failed — $module expected $expect, got $count" >&2
    status=1
  fi
done < "$tmp"

# Assert the tracked total (== the live all-module count; every module is
# asserted, so tracked and live are the same number).
if [[ "$total" -ne "$tracked_total" ]]; then
  echo "inventory-public-symbols: assertion failed — tracked total expected $tracked_total, got $total" >&2
  status=1
fi

# Committed coverage gate (PML6-U1, zombie-doc): every public functio name
# (no `_` prefix) in every module must appear in docs/api-reference.md under
# that module's section. `_`-prefixed names are @ privata helpers and are
# exempt (private by convention; the two renamed serialize helpers
# _be4_lege/_be8_lege are additionally documented in the reference per the
# correctness-wave reconciliation).
cov_fail=0
while IFS= read -r -d '' file; do
  module="${file#"$SRC"/}"
  module="${module%.fab}"
  # Section start: "## gradus:<module>" heading; section end is the next
  # "## gradus:" heading.
  section="$(awk -v m="## gradus:$module" '
    $0 == m { insec=1; next }
    insec && /^## gradus:/ { exit }
    insec { print }
  ' "$AREF")"
  if [[ -z "$section" ]]; then
    echo "inventory-public-symbols: coverage failed — no section for $module in docs/api-reference.md" >&2
    status=1
    cov_fail=1
    continue
  fi
  while IFS= read -r name; do
    if ! grep -qF -- "$name" <<< "$section"; then
      echo "inventory-public-symbols: coverage failed — $module.$name not documented in docs/api-reference.md" >&2
      status=1
      cov_fail=1
    fi
  done < <(grep -oE 'functio [a-z][a-z0-9_]*\(' "$file" | sed 's/functio //; s/(//' | grep -v '^_' | sort -u)
done < <(find "$SRC" -name '*.fab' -print0 | sort -z)

exit "$status"
