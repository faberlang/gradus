+++
locale = "en"
+++

# gradus/scripta/check-compile.fab — native-Faber gate (NSM-G1 conversion of
# the former bash scripta/check-compile).
#
# Runs `faber check` on the gradus library and its exempla via `captura`,
# preserving the original shell gate's exit-code contract: exit 0 when every
# target is green, exit 1 (with the failing target's diagnostics) when any
# check fails.
#
# Execution surface (pinned): the released faber binary via `faber script`.
# The inner `faber check` calls are captura subprocesses targeting OTHER
# pure-logic sources (the preserved original-gate semantics); this script is
# not itself a `faber check` surface (PKG001 applies to kernel-import scripts).
#
# Binary resolution: FABER_BIN overrides; otherwise the released workspace
# binary `<workspace>/faber/target/debug/faber`. The PATH `faber` (1.3.0) is
# never a valid execution surface.

import from "faber:solum" solum
import from "faber:processus" processus

# Resolve the gradus repository root: FABER_LIBRARY_HOME when set, else the
# workspace layout probed from the current directory (workspace-root or
# gradus-root invocation).
fn gradus_root() → string {
    const string home ← processus.exec("printf %s \"${FABER_LIBRARY_HOME:-}\"") ↦ string
    if home.length() ↦ int > 0 {
        const string from_home ← solum.join([home, "gradus"]) ↦ string
        if solum.exists(solum.join([from_home, "src"]) ↦ string) ↦ bool {
            return solum.resolve(from_home) ↦ string
        }
    }
    const string cwd ← processus.cwd() ↦ string
    if solum.exists(solum.join([cwd, "gradus", "src"]) ↦ string) ↦ bool {
        return solum.resolve(solum.join([cwd, "gradus"]) ↦ string) ↦ string
    }
    if solum.exists(solum.join([cwd, "src"]) ↦ string) ↦ bool {
        return solum.resolve(cwd) ↦ string
    }
    panic "check-compile: cannot resolve the gradus root (set FABER_LIBRARY_HOME or run from the faberlang workspace)"
}

# The released faber binary that performs the inner `faber check` calls.
fn faber_bin() → string {
    const string override ← processus.exec("printf %s \"${FABER_BIN:-}\"") ↦ string
    if override.length() ↦ int > 0 {
        return override
    }
    const string bin ← solum.join([solum.parent(gradus_root()) ↦ string, "faber", "target", "debug", "faber"]) ↦ string
    if solum.exists(bin) ↦ bool is false {
        panic "check-compile: released faber binary not found (§); set FABER_BIN or build faber/target/debug/faber — the PATH faber (1.3.0) is not a valid execution surface"(bin)
    }
    return bin
}

# Run one `faber check` target; fail the gate (exit 1) on any non-zero check,
# printing the captured diagnostics first.
fn run_check(string faber, string target, string label) → void {
    const map<string, value> result ← processus.captura([faber, "check", target]) ↦ map<string, value>
    const int status ← result["status"] ↦ int
    if status ≡ 0 {
        return
    }
    const string err ← result["stderr"] ↦ string
    if err.length() ↦ int > 0 {
        print err
    }
    print "check-compile: FAILED — §"(label)
    processus.exit_process(1)
}

main {
    const string root ← gradus_root()
    const string faber ← faber_bin()
    print "check-compile: FABER_LIBRARY_HOME=§"(solum.parent(root) ↦ string)
    print "check-compile: checking gradus library source..."
    run_check(faber, root, "faber check on gradus library source")
    const string seam ← solum.join([root, "exempla", "gradient-seam"]) ↦ string
    if solum.is_directory(seam) ↦ bool {
        print "check-compile: checking gradient-seam consumer fixture..."
        run_check(faber, seam, "faber check on gradient-seam consumer")
    }
    const string mlp ← solum.join([root, "exempla", "training-loop-mlp"]) ↦ string
    if solum.is_directory(mlp) ↦ bool {
        print "check-compile: checking training-loop-mlp composed-loop exemplum..."
        run_check(faber, mlp, "faber check on training-loop-mlp exemplum")
    }
    const string gen ← solum.join([root, "exempla", "token-generation"]) ↦ string
    if solum.is_directory(gen) ↦ bool {
        print "check-compile: checking token-generation bounded-run exemplum..."
        run_check(faber, gen, "faber check on token-generation exemplum")
    }
    print "check-compile: ok"
}
