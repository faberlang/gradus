+++
locale = "en"
+++

# gradus/scripta/check-compile.fab — native-Faber gate (NSM-G1 conversion of
# the former bash scripta/check-compile).
#
# Runs `faber check` on the gradus library and its exempla via `captura`,
# preserving the original shell gate's exit-code contract: exit 0 when every
# target is green, exit 1 (with the failing target's diagnostics) when any
# check fails.
#
# Execution surface (pinned): the released faber binary via `faber script`.
# The inner `faber check` calls are captura subprocesses targeting OTHER
# pure-logic sources (the preserved original-gate semantics); this script is
# not itself a `faber check` surface (PKG001 applies to kernel-import scripts).
#
# Binary resolution: FABER_BIN overrides; otherwise the released workspace
# binary `<workspace>/faber/target/debug/faber`. The PATH `faber` (1.3.0) is
# never a valid execution surface.

importa ex "faber:solum" privata solum
importa ex "faber:processus" privata processus

# Resolve the gradus repository root: FABER_LIBRARY_HOME when set, else the
# workspace layout probed from the current directory (workspace-root or
# gradus-root invocation).
functio gradus_root() → textus {
    fixum textus home ← processus.exsequi("printf %s \"${FABER_LIBRARY_HOME:-}\"") ↦ textus
    si home.longitudo() ↦ numerus > 0 {
        fixum textus from_home ← solum.iunge([home, "gradus"]) ↦ textus
        si solum.exstat(solum.iunge([from_home, "src"]) ↦ textus) ↦ bivalens {
            redde solum.absolve(from_home) ↦ textus
        }
    }
    fixum textus cwd ← processus.sedes() ↦ textus
    si solum.exstat(solum.iunge([cwd, "gradus", "src"]) ↦ textus) ↦ bivalens {
        redde solum.absolve(solum.iunge([cwd, "gradus"]) ↦ textus) ↦ textus
    }
    si solum.exstat(solum.iunge([cwd, "src"]) ↦ textus) ↦ bivalens {
        redde solum.absolve(cwd) ↦ textus
    }
    mori "check-compile: cannot resolve the gradus root (set FABER_LIBRARY_HOME or run from the faberlang workspace)"
}

# The released faber binary that performs the inner `faber check` calls.
functio faber_bin() → textus {
    fixum textus override ← processus.exsequi("printf %s \"${FABER_BIN:-}\"") ↦ textus
    si override.longitudo() ↦ numerus > 0 {
        redde override
    }
    fixum textus bin ← solum.iunge([solum.parens(gradus_root()) ↦ textus, "faber", "target", "debug", "faber"]) ↦ textus
    si solum.exstat(bin) ↦ bivalens ≡ falsum {
        mori "check-compile: released faber binary not found (§); set FABER_BIN or build faber/target/debug/faber — the PATH faber (1.3.0) is not a valid execution surface"(bin)
    }
    redde bin
}

# Run one `faber check` target; fail the gate (exit 1) on any non-zero check,
# printing the captured diagnostics first.
functio run_check(textus faber, textus target, textus label) → vacuum {
    fixum tabula<textus, valor> result ← processus.captura([faber, "check", target]) ↦ tabula<textus, valor>
    fixum numerus status ← result["status"] ↦ numerus
    si status ≡ 0 {
        redde
    }
    fixum textus err ← result["stderr"] ↦ textus
    si err.longitudo() ↦ numerus > 0 {
        nota err
    }
    nota "check-compile: FAILED — §"(label)
    processus.exi(1)
}

incipit {
    fixum textus root ← gradus_root()
    fixum textus faber ← faber_bin()
    nota "check-compile: FABER_LIBRARY_HOME=§"(solum.parens(root) ↦ textus)
    nota "check-compile: checking gradus library source..."
    run_check(faber, root, "faber check on gradus library source")
    fixum textus seam ← solum.iunge([root, "exempla", "gradient-seam"]) ↦ textus
    si solum.directoriumne(seam) ↦ bivalens {
        nota "check-compile: checking gradient-seam consumer fixture..."
        run_check(faber, seam, "faber check on gradient-seam consumer")
    }
    fixum textus mlp ← solum.iunge([root, "exempla", "training-loop-mlp"]) ↦ textus
    si solum.directoriumne(mlp) ↦ bivalens {
        nota "check-compile: checking training-loop-mlp composed-loop exemplum..."
        run_check(faber, mlp, "faber check on training-loop-mlp exemplum")
    }
    fixum textus gen ← solum.iunge([root, "exempla", "token-generation"]) ↦ textus
    si solum.directoriumne(gen) ↦ bivalens {
        nota "check-compile: checking token-generation bounded-run exemplum..."
        run_check(faber, gen, "faber check on token-generation exemplum")
    }
    nota "check-compile: ok"
}
