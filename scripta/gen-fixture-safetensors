#!/usr/bin/env bash
set -euo pipefail
# Fixture generator launcher. The generator logic lives entirely in
# fixtures/safetensors/gen_fixture.fab (norma:fs / norma:process imports); this
# entrypoint runs it with `faber run` and rewrites
# fixtures/safetensors/ in place. Optional arguments after the launcher name are
# passed after the gradus root, which the launcher supplies (the first one
# overrides the output directory).
# FABER_BIN overrides the binary; the PATH `faber` is not used. LIBRARY_HOME
# is the directory holding the gradus checkout link (`<home>/gradus/src`),
# exactly as for scripta/check-compile.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
LIBRARY_HOME="${LIBRARY_HOME:-$(cd "$ROOT/.." && pwd)}"
FABER_BIN="${FABER_BIN:-$(cd "$ROOT/.." && pwd)/radix/target/debug/faber}"
if [[ ! -x "$FABER_BIN" ]]; then
    echo "gen-fixture-safetensors: faber binary not found: $FABER_BIN (set FABER_BIN)" >&2
    exit 1
fi
exec "$FABER_BIN" run --library-home "$LIBRARY_HOME" "$ROOT/fixtures/safetensors/gen_fixture.fab" -- "$ROOT" "$@"
