    extra_root = root / extra
    if extra_root.is_dir():
        residue_roots.append(extra_root)
seen = set(failures)
for residue_root in residue_roots:
    for path in sorted(residue_root.rglob("*")):
        if path.suffix not in {".fab", ".proba"}:
            continue
        code = code_only(path.read_text())
        for name in residue:
            hit = f"{path}: leftover {name}"
            if hit in seen or f"{path}: stale member {name}" in seen:
                continue
            if re.search(member_pat(name), code):
                failures.append(hit)
                seen.add(hit)

if failures:
    print("check-source: stale S2 member names in code positions:", file=sys.stderr)
    print("\n".join(failures), file=sys.stderr)
    sys.exit(1)
