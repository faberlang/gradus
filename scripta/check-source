def code_only(text):
    result = []
    i = 0
    quote = None
    while i < len(text):
        c = text[i]
        if quote:
            if c == quote:
                quote = None
            result.append("\n" if c == "\n" else " ")
            i += 1
            continue
        if c == "#":
            while i < len(text) and text[i] != "\n":
                i += 1
            if i < len(text):
                result.append("\n")
                i += 1
            continue
        if c in ('"', '«'):
            quote = '»' if c == '«' else c
            result.append(" ")
            i += 1
            continue
        result.append(c)
        i += 1
    return "".join(result)

def member_pat(name):
    # Tensor.accipe takes a list of indices. Compiler list-intrinsic
    # `.accipe(i)` is not a Gradus member and is left alone.
    if name == "accipe":
        return r"(?:\bfn\s+accipe\s*\(|\.accipe\s*\(\s*\[)"
    # A stale member is a declaration, call, receiver access, or object
    # field. Bare parameters/locals are intentionally not matched.
    return rf"(?:\bfn\s+{re.escape(name)}\s*\(|\.{re.escape(name)}\b|\b{re.escape(name)}\s*\(|\b{re.escape(name)}\s*=)"

failures = []
# The member guard is for the shipped module declarations. The surrounding
# source gate still checks both `.fab` and `.proba` files for retired syntax;
# proof-local helper names and compiler list intrinsics are not Gradus members.
for path in sorted(src.rglob("*.fab")):
    code = code_only(path.read_text())
    for name in sorted(old_types):
        if re.search(rf"\b{re.escape(name)}\b", code):
            failures.append(f"{path}: stale type {name}")
    for name in sorted(old_members):
        if re.search(member_pat(name), code):
            failures.append(f"{path}: stale member {name}")

# S2-FACADE residue: Tensor.accipe, math.casta, _est_sponte. The ledger
# walk above is src/**/*.fab only; these leftovers lived in proofs and
# exempla, so the extra trees are scanned for this closed set only.
