#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SRC="$ROOT/src"
status=0

if [[ ! -d "$SRC" ]]; then
  echo "check-source: missing src directory: $SRC" >&2
  exit 1
fi

while IFS= read -r -d '' file; do
  if grep -nE '^[[:space:]]*//' "$file"; then
    echo "check-source: line-start comments are not allowed in $file" >&2
    status=1
  fi

  if grep -nE '@[[:space:]]*(externa|subsidia)\b' "$file"; then
    echo "check-source: retired @ externa/@ subsidia annotation in $file" >&2
    status=1
  fi

  if grep -nE '\bcall[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\{' "$file"; then
    echo "check-source: route calls must use canonical string route syntax in $file" >&2
    status=1
  fi

  if grep -nE '∪[[:space:]]*null[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=' "$file"; then
    echo "check-source: retired optional genus field syntax in $file; use optional" >&2
    status=1
  fi
done < <(find "$SRC" \( -name '*.fab' -o -name '*.proba' \) -print0)

# No-Latin guard (U8). Replaces the closed S2 stale-name ledger. Word-tokens
# in identifiers, comments, and owned strings are checked against the U1
# retained-exception list (docs/archived/no-latin/rename-ledger.md §2).
# Compiler-owned spellings (to_textus) and U3-held tokenizer
# category wires (ledger §8; OQ3 pin still pending) are accepted; they are
# not converted Gradus-owned Latin. The en empty-collection marker is
# `empty`; `vacua` in this tree is residue and stays in LATIN_WORDS.
# Scan roots: src + exempla + tests + scripta + fixtures (the trees the S2
# residue scan covered, plus the scripta/fixtures `.fab` generators).
if ! python3 - "$ROOT" <<'PY'
import re
import sys
import tempfile
from pathlib import Path

root = Path(sys.argv[1])
# S2 residue scan covered exempla + tests in addition to src. U8
# narrowed to src-only; restore those roots here.
OWNED_ROOTS = ("src", "exempla", "tests", "scripta", "fixtures")

# Census2 lexicon (campaign detector). Stems match snake segments or camel words.
LATIN_WORDS = {
    "accipe", "admitto", "admittas", "adscisco", "aequus", "aetas", "album",
    "aliud", "aliquod", "amplitudo", "angusta", "appende", "ars", "boleanum",
    "broadcastum", "caput", "casta", "causa", "clavis", "codicilli",
    "codicillus", "collige", "congela", "consecutiva", "constitue", "contineo",
    "continet", "cursus", "damnum", "datos", "decoda", "decodere",
    "dequantizas", "descriptio", "deserializa", "digestio", "digitorum",
    "dimensio", "dimidium", "distributio", "divido", "encoda", "errorem",
    "est", "exigue", "exige", "exponens", "expansio", "expectatum",
    "fabricare", "fim", "finita", "fins", "fons", "fonte", "forma",
    "formatum", "fragmentum", "fructus", "gelida", "gelidae", "genere",
    "generatio", "glomoris", "glomulus", "gradiente", "gradientes", "gradus",
    "habeat", "historia", "identitas", "identia", "ignota", "ignotus",
    "igitur", "immersio", "impleta", "in_tabula", "initium", "inveni",
    "invenit", "iunge", "lectio", "lege", "lentus", "limes", "linea",
    "littera", "longitudo", "magna", "manifesti", "manifestum", "mappa",
    "maske", "materia", "materializa", "media", "mensa", "metadatum",
    "modus", "muta", "nihil", "nomen", "novum", "numerus", "numerum",
    "numerorum", "obsoletus", "octeti", "octetus", "ordo", "parsa", "passus",
    "perambulare", "pinnata", "poena", "politica", "pondera", "possessor",
    "positio", "potentia", "praefundere", "praevideo", "progenies", "prolata",
    "promovet", "proximus", "quaero", "quantitas", "redde", "redintegra",
    "referantia", "reformanda", "renorma", "repetitio", "repetitionis",
    "repertum", "resolvo", "scala", "scanna", "scander", "schedula",
    "schematis", "segmentum", "semen", "sessio", "signum", "silu", "siste",
    "socius", "solidum", "sortitio", "spatium", "sponte", "statium", "statio",
    "statum", "stratorum", "stratum", "structa", "structum", "structura",
    "subsidia", "summa", "surgeons", "surgens", "tabula", "tense", "tensores",
    "tensorum", "textorum", "textum", "textus", "typo", "typus", "vacua",
    "valet", "valor", "valores", "verba", "verbum", "versio", "vestigium",
    "vincula", "visum", "visio", "vocabuli", "vocabulum", "vacuum",
    "cancellata", "cancelatum", "canonici", "cognita", "configura",
    "configuratio", "observa", "observata", "observatum", "octetorum",
    "promptus", "semita", "valorem", "mala", "exspectata", "exspectatum",
    "elementa", "finis", "proba", "ida", "aequa", "licet", "imperia",
    "imperium", "admissio", "admissionis", "referentiae", "datum",
    "projectio", "eog", "staticum", "addita", "conversio",
}
LATIN_TYPE_STEMS = {
    "capsula", "identitas", "tabula", "metricum", "pondera", "sortitio",
    "decodere", "sessio", "cancelatum", "configura", "generatio", "genere",
    "tokenizator", "statum", "gradiente", "gradientes", "parametrum",
    "statio", "tensum", "repertum", "visum", "visio", "manifestum",
    "metadatum", "descriptio", "lectio", "ars", "scala", "minima",
    "structura", "stringum", "tokenum", "cursus", "ignota", "cognita",
    "mala", "diversum", "diversa",
}

# U1 §2 retained-exception list.
RETAINED = {
    "gradus",
    "eog", "silu", "signum", "fim", "fins", "bpe", "matmul",
    "llama", "qwen2", "qwen35moe", "gguf", "ggml", "smollm", "smollm2",
    "gpt2", "f32", "f16", "bf16", "i32", "u8",
}

# Compiler-owned spellings that survive in English-locale source.
COMPILER_OWNED = {
    "vacuum", "to_textus", "redde", "reddet", "appende", "accipe",
    "iunge", "sponte", "proba",
}

# U3 tokenizer category wire values (comments + owned strings only).
# Ledger §8 OQ3: five Latin category strings HELD, pin still pending.
# Exact identifiers only. `novum` and `linea` are split stems of the
# `novum_linea` wire, not independent holds — dropping them closes a
# comment/string hole (unused on the converted src tree).
PINNED_WIRES = {
    "aliud", "littera", "numerus", "spatium", "novum_linea",
}

CAMEL = re.compile(r"[A-Z]?[a-z]+|[A-Z]+(?![a-z])")
IDENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
DOTTED_KEY = re.compile(r"^[A-Za-z0-9_./\-]+$")


def latin_stems(name: str) -> set[str]:
    hits = set()
    for s in name.lower().split("_"):
        if s in LATIN_WORDS or s in LATIN_TYPE_STEMS:
            hits.add(s)
    for w in CAMEL.findall(name):
        wl = w.lower()
        if wl in LATIN_WORDS or wl in LATIN_TYPE_STEMS:
            hits.add(wl)
    return hits


def forbidden(name: str, kind: str) -> set[str]:
    if name.lower() in COMPILER_OWNED:
        return set()
    hits = latin_stems(name)
    hits -= RETAINED
    if kind in {"comment", "string"} and name.lower() in PINNED_WIRES:
        return set()
    if kind in {"comment", "string"} and latin_stems(name) <= (PINNED_WIRES | RETAINED):
        return set()
    return hits


def regions(text: str):
    i = 0
    n = len(text)
    code = []
    out = []
    while i < n:
        c = text[i]
        if c == "#":
            j = text.find("\n", i)
            if j < 0:
                j = n
            out.append(("comment", text[i:j], i))
            code.append("\n")
            i = j
            continue
        if c in ('"', "«"):
            q = "»" if c == "«" else '"'
            j = i + 1
            while j < n and text[j] != q:
                if text[j] == "\\" and j + 1 < n:
                    j += 2
                    continue
                j += 1
            if j < n:
                j += 1
            out.append(("string", text[i:j], i))
            code.append(" ")
            i = j
            continue
        code.append(c)
        i += 1
    out.append(("code", "".join(code), 0))
    return out


def line_of(text: str, index: int) -> int:
    return text.count("\n", 0, index) + 1


def scan_file(path: Path):
    text = path.read_text(encoding="utf-8")
    failures = []
    for kind, chunk, start in regions(text):
        if kind == "string":
            inner = chunk
            if inner.startswith('"') or inner.startswith("«"):
                inner = inner[1:]
            if inner.endswith('"') or inner.endswith("»"):
                inner = inner[:-1]
            if "." in inner and DOTTED_KEY.match(inner):
                continue
        scan_kind = "code" if kind == "code" else kind
        for m in IDENT.finditer(chunk):
            name = m.group(0)
            hits = forbidden(name, scan_kind)
            if not hits:
                continue
            klass = {
                "code": "identifier",
                "comment": "comment",
                "string": "string",
            }[scan_kind]
            failures.append(
                f"{path}:{line_of(text, start + m.start())}: {klass} {name} "
                f"(latin {','.join(sorted(hits))})"
            )
    return failures


def collect_owned():
    files = []
    for name in OWNED_ROOTS:
        owned = root / name
        if not owned.is_dir():
            continue
        files.extend(
            p for p in owned.rglob("*") if p.suffix in {".fab", ".proba"}
        )
    failures = []
    for path in sorted(files):
        failures.extend(scan_file(path))
    return failures


def self_test():
    probes = {
        "identifier": (
            'fn causa() {\n}\n',
            "causa",
        ),
        "comment": (
            '# causa of the failure\nfn ok() {\n}\n',
            "causa",
        ),
        "string": (
            'const x ← "manifestum is inconsistent"\n',
            "manifestum",
        ),
    }
    receipts = []
    ok = True
    with tempfile.TemporaryDirectory(prefix="gradus-no-latin-probe-") as tmp:
        tmp_path = Path(tmp)
        for klass, (body, needle) in probes.items():
            path = tmp_path / f"probe_{klass}.fab"
            path.write_text(body, encoding="utf-8")
            hits = scan_file(path)
            matched = [h for h in hits if f"{klass} {needle}" in h]
            if matched:
                receipts.append(f"  {klass} probe: FAIL (expected) {needle}")
            else:
                ok = False
                detail = "; ".join(hits) if hits else "no latin reported"
                receipts.append(
                    f"  {klass} probe: PASS (unexpected) {needle} ({detail})"
                )
    return ok, receipts


tree_fail = collect_owned()
if tree_fail:
    print("check-source: no-Latin tokens in owned positions:", file=sys.stderr)
    print("\n".join(tree_fail), file=sys.stderr)

test_ok, receipts = self_test()
print("check-source: no-Latin self-test", file=sys.stderr)
print("\n".join(receipts), file=sys.stderr)
if test_ok:
    print("check-source: no-Latin self-test ok", file=sys.stderr)
else:
    print("check-source: no-Latin self-test did not fail every guarded class", file=sys.stderr)

if tree_fail or not test_ok:
    sys.exit(1)
PY
then
  status=1
fi

exit "$status"
