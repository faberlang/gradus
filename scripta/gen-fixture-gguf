#!/usr/bin/env bash
set -euo pipefail
# NSM-Wave-2 G2: native-Faber fixture generator launcher. The generator
# logic lives entirely in fixtures/gguf/gen_fixture.fab; this entrypoint
# only runs it on the released faber binary (faber/target/debug/faber,
# 1.6.0-rc.1). The PATH `faber` (1.3.0) is never a valid execution
# surface. FABER_BIN overrides the binary.
#
# `faber script` interprets a single source only when the path is not
# covered by a faber.toml (package routing rejects kernel imports with
# PKG001), so the generator source is staged outside the gradus package
# before interpretation.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
FABER_BIN="${FABER_BIN:-$(cd "$ROOT/.." && pwd)/faber/target/debug/faber}"
export FABER_BIN
if [[ ! -x "$FABER_BIN" ]]; then
    echo "gen-fixture-gguf: released faber binary not found: $FABER_BIN (set FABER_BIN)" >&2
    exit 1
fi
TMP="$(mktemp -d "${TMPDIR:-/tmp}/gen-fixture-gguf.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT
cp "$ROOT/fixtures/gguf/gen_fixture.fab" "$TMP/gen_fixture.fab"
if "$FABER_BIN" script "$TMP/gen_fixture.fab" -- "$@"; then
    exit 0
else
    exit $?
fi
