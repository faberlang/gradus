# =============================================================================
# Inferentia — local GGUF inference server and one-shot runner
# =============================================================================
#
# `inferentia serve` binds a loopback listener, admits the pinned GGUF, loads
# the weights once and answers /health, /model and /generate (JSON, or SSE with
# `Accept: text/event-stream` or `?stream=1`). `inferentia live --model <PATH>
# [--prompt TEXT]` admits the model and generates once, printing `ids=`,
# `text=` and `finish=`.
#
# Modules, by concern:
#   cli.fab          argv → ServeConfig; every usage error exits before a
#                    listener binds (the generated CLI framework cannot carry
#                    the D5 usage-error exit)
#   pinned.fab       the one verified model row (identity, GGUF counts, fixture)
#   admission.fab    path → digest + header → gguf.admit; the digest-bound load
#   generate.fab     the resident model; encode → port decode → detokenize
#   (gradus:model/smollm2_weights, gradus:generation/smollm2_decode)
#                    the A1 port: bulk F32 weight load and the decode loop over
#                    gradus decode-token launches (K/V caches updated in place)
#   request.fab      the /generate body (norma:json) and the config it resolves to
#   response.fab     JSON response bodies and the error → status mapping
#   state.fab        the /health lifecycle: starting | ready | failed
#   serve.fab        the HTTP server and the /generate pipeline
#   live.fab         the one-shot run
#   io.fab           stdout, stderr and the exit code
#
# The kernels run on whatever device the program is started on:
# `faber run --device metal <inferentia> -- live ...` for the GPU, `--device cpu`
# (several cores) or `--device reference` (one core, the oracle) for the same
# kernels on the CPU; without `--device`, a launch is refused. Inferentia has no
# CPU backend of its own. `--backend metal` is the only accepted value and names
# the kernel route, not the device; the `/model` body reports it.
# `live --trace` prints one `trace step=...` stderr line per generated step.

import from "./serve" const serve
import from "./live" const live_run
import from "./cli" const ServeConfig, live_requested, parse_cli

main args argv {
    let ServeConfig serving ← parse_cli(argv)
    if live_requested(argv) {
        live_run(serving)
    } else {
        serve(serving)
    }
}
